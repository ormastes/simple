}

@unsafe(reason: "raw nullable bootstrap source read; nil is provider failure", capabilities: [ffi])
extern fn rt_file_read_text(path: text) -> text?
extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)
extern fn rt_env_get(key: text) -> text
extern fn rt_env_set(key: text, value: text) -> bool
extern fn rt_bytes_to_text(data: [u8]) -> text
extern fn rt_hash_text(data: text) -> i64

@always_inline
fn _pipeline_source_read_raw(path: text) -> text?:
    unsafe(capabilities: [ffi]):
        rt_file_read_text(path)

fn driver_source_owner_text_copy(value: text) -> text:
    rt_bytes_to_text(value.bytes())

fn _driver_source_has_rt_annotation(content: text) -> bool:
    # `@rt` is common in attribute documentation. Parse only a genuine
    # annotation, not a docstring or comment mention, so source-cache warming
    # cannot spend minutes parsing an unrelated attribute-definition module.
    if not content.contains("@rt"):
        return false
    var in_doc = false
    for raw_line in content.split("\n"):
        var scan_line = raw_line
        if not in_doc and scan_line.contains("#"):
            scan_line = scan_line.split("#")[0]
        var quote_count = 0
        if scan_line.contains("\"\"\""):
            quote_count = scan_line.split("\"\"\"").len() - 1
        val was_in_doc = in_doc
        if quote_count % 2 == 1:
            in_doc = not in_doc
        if was_in_doc or quote_count > 0:
            continue
        val line = scan_line.trim()
        if line.starts_with("@rt(") or line == "@rt":
            return true
    false

impl CompilerDriver:
    # --------------------------------------------------------------------------
    # Phase 1: Load sources (with optional cache-aware skipping)
    # --------------------------------------------------------------------------

    me parse_bootstrap_default_file(path: text) -> bool:
        if path == "":
            return true
        if path.ends_with("/check.spl") or path.ends_with("\\check.spl"):
            return true
        if path.ends_with("/__init__.spl") or path.ends_with("\\__init__.spl"):
            return true
        if path.contains("/test/") or path.contains("/tests/") or path.contains("/doc/") or path.contains("/verification/"):
            return true
        if path.contains("/testdata/"):
            return true
        if path.contains("/hir_lowering/async"):
            return true
        val raw_content = _pipeline_source_read_raw(path)
        if raw_content == nil:
            print "[bootstrap_parse] source read failed: {path}"
            return false
        val content = raw_content ?? ""
        if content == "":
            return true
        val module_name = _driver_module_name_from_path(path)
        print "[bootstrap_parse] {path} as {module_name}"
        self.ctx.modules[module_name] = parse_full_frontend(content, path, module_name, self.ctx.logger)
        self.ctx.sources = self.ctx.sources.push(SourceFile(path: path, content: content, module_name: module_name))
        if module_name.starts_with("compiler.10.frontend.core."):
            val core_alias = "compiler.core." + module_name.substring("compiler.10.frontend.core.".len())
            print "[bootstrap_parse] alias {core_alias}"
            self.ctx.modules[core_alias] = parse_full_frontend(content, path, core_alias, self.ctx.logger)
        true

    me parse_bootstrap_default_root(root: text) -> bool:
        if root.ends_with(".spl"):
            return self.parse_bootstrap_default_file(root)
        val cmd = "find {root} -type f -name '*.spl' 2>/dev/null"
        val (stdout, _, code) = rt_process_run("sh", ["-c", cmd])
        print "[bootstrap_parse] root {root} code {code} stdout_len {stdout.len()}"
        if code != 0 or stdout == "":
            return true
        val lines = stdout.split("\n")
        for line in lines:
            val path = line.trim()
            if path != "":
                val ok = self.parse_bootstrap_default_file(path)
                if not ok:
                    return false
        true

    me load_sources_impl() -> (CompileContext, bool):
        # Build sources list locally to avoid chained method call issue
        # (self.ctx.sources.push() doesn't persist — interpreter limitation)
        var all_sources: [SourceFile] = []
        var seen_sources = _driver_text_bucket_set_new(512)

        # Start with user-provided roots
        var i = 0
        var has_project_source = false
        var driver_inputs: [text] = []
        if self.ctx.options.bootstrap_input_count > 0 and self.ctx.options.bootstrap_input_count <= 6:
            if self.ctx.options.bootstrap_input_count > 0:
                driver_inputs = driver_inputs + [self.ctx.options.bootstrap_input_0]
            if self.ctx.options.bootstrap_input_count > 1:
                driver_inputs = driver_inputs + [self.ctx.options.bootstrap_input_1]
            if self.ctx.options.bootstrap_input_count > 2:
                driver_inputs = driver_inputs + [self.ctx.options.bootstrap_input_2]
            if self.ctx.options.bootstrap_input_count > 3:
                driver_inputs = driver_inputs + [self.ctx.options.bootstrap_input_3]
            if self.ctx.options.bootstrap_input_count > 4:
                driver_inputs = driver_inputs + [self.ctx.options.bootstrap_input_4]
            if self.ctx.options.bootstrap_input_count > 5:
                driver_inputs = driver_inputs + [self.ctx.options.bootstrap_input_5]
        else:
            driver_inputs = self.ctx.options.input_files
        val closure_source_roots = driver_inputs
        val explicit_entry_input = driver_explicit_source_entry(self.ctx)
        val native_entry_input = rt_env_get("SIMPLE_NATIVE_BUILD_ENTRY") ?? ""
        val requested_entry_input = if explicit_entry_input != "":
            explicit_entry_input
        else:
            native_entry_input
        val native_entry_closure_pre = (rt_env_get("SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE") ?? "") == "1"
        val explicit_entry_closure = explicit_entry_input != ""
        val entry_closure_walk = explicit_entry_closure or (
            native_entry_input != "" and not native_entry_closure_pre)
        val package_index_cold_init =
            (rt_env_get("SIMPLE_PACKAGE_INDEX_COLD_INIT") ?? "") == "1"
        var package_index_routed = false
        if not package_index_cold_init:
            val package_resolution_started_ns = demand_compile_phase_begin_v1()
            var changed_modules: [text] = []
            val changed_text = rt_env_get("SIMPLE_PACKAGE_INDEX_CHANGED_MODULES") ?? ""
            if changed_text != "":
                for changed_module in changed_text.split(","):
                    val normalized = changed_module.trim()
                    if normalized != "":
                        changed_modules = changed_modules.push(normalized)
            val route = package_index_route_current_v1(
                if entry_closure_walk: requested_entry_input else: "",
                rt_env_get("SIMPLE_SCV_SNAPSHOT_ROOT") ?? "",
                rt_env_get("SIMPLE_SCV_REVISION_ID") ?? "",
                rt_env_get("SIMPLE_SCV_TREE_ID") ?? "",
                rt_env_get("SIMPLE_SCV_INVENTORY_DIGEST") ?? "",
                rt_env_get("SIMPLE_PACKAGE_INDEX_PRODUCER_DIGEST") ?? "",
                rt_env_get("SIMPLE_PACKAGE_INDEX_ROOT_GENERATION") ?? "",
                rt_env_get("SIMPLE_PACKAGE_INDEX_VARIANT_DIGEST") ?? "",
                changed_modules,
                (rt_env_get("SIMPLE_PACKAGE_INDEX_PUBLIC_INTERFACE_CHANGED") ?? "") == "1")
            if not route.valid:
                self.ctx.add_error("persistent package index admission failed: {route.reason}; run explicit cold initialization with SIMPLE_PACKAGE_INDEX_COLD_INIT=1")
                driver_entry_scan_cache_release()
                return (self.ctx, false)
            val runtime_std_authority = RuntimeStdPackageAuthorityV1(
                rt_env_get("SIMPLE_COMPILER_DIGEST") ?? "",
                rt_env_get("SIMPLE_ACTION_ABI_DIGEST") ?? "",
                rt_env_get("SIMPLE_RUNTIME_ABI_DIGEST") ?? "",
                rt_env_get("SIMPLE_STDLIB_ABI_DIGEST") ?? "",
                rt_env_get("SIMPLE_PACKAGE_INDEX_VARIANT_DIGEST") ?? "",
                self.ctx.native_target,
                rt_env_get("SIMPLE_SCV_REVISION_ID") ?? "")
            val expected_runtime_action = runtime_std_action_digest_v1(
                runtime_std_authority, RUNTIME_PACKAGE_IDENTITY_V1)
            val expected_std_action = runtime_std_action_digest_v1(
                runtime_std_authority, STD_PACKAGE_IDENTITY_V1)
            if (expected_runtime_action == "" or expected_std_action == "" or
                    rt_env_get("SIMPLE_RUNTIME_ACTION_DIGEST") !=
                        expected_runtime_action or
                    rt_env_get("SIMPLE_STDLIB_ACTION_DIGEST") !=
                        expected_std_action):
                self.ctx.add_error(
                    "runtime/std SMF baseline authority mismatch; rebuild the sealed precompiled package set")
                driver_entry_scan_cache_release()
                return (self.ctx, false)
            val runtime_std_baseline = runtime_std_load_baseline_v1(
                machine_cache_root(), runtime_std_authority)
            if not runtime_std_baseline.valid:
                self.ctx.add_error(
                    "runtime/std SMF baseline admission failed: {runtime_std_baseline.reason}")
                driver_entry_scan_cache_release()
                return (self.ctx, false)
            val demand_execution = demand_compile_begin_v1(
                route,
                DemandBackendIdentityV1(
                    rt_env_get("SIMPLE_SCV_REVISION_ID") ?? "",
                    rt_env_get("SIMPLE_SCV_TREE_ID") ?? "",
                    rt_env_get("SIMPLE_SCV_INVENTORY_DIGEST") ?? "",
                    rt_env_get("SIMPLE_SCV_INVENTORY_DIGEST") ?? "",
                    self.ctx.native_target,
                    rt_env_get("SIMPLE_PACKAGE_INDEX_VARIANT_DIGEST") ?? "",
                    PrecompiledPlatformIdentityV1(
                        rt_env_get("SIMPLE_RUNTIME_ACTION_DIGEST") ?? "",
                        rt_env_get("SIMPLE_RUNTIME_ABI_DIGEST") ?? "",
                        rt_env_get("SIMPLE_STDLIB_ACTION_DIGEST") ?? "",
                        rt_env_get("SIMPLE_STDLIB_ABI_DIGEST") ?? "")),
                ForegroundBackendBudgetV1(
                    100, 512 * 1024 * 1024, 30000, false),
                true, true, false,
                (rt_env_get("SIMPLE_BUILD_ORDINAL") ?? "0").to_i64() ?? 0)
            if not demand_execution.valid:
                self.ctx.add_error(
                    "demand compile admission failed: {demand_execution.reason}")
                driver_entry_scan_cache_release()
                return (self.ctx, false)
            self.ctx.demand_compile_execution = Some(demand_execution)
            var measured_execution = self.ctx.demand_compile_execution!
            _ = demand_compile_phase_finish_v1(
                &mut measured_execution, "package-resolution",
                package_resolution_started_ns)
            self.ctx.demand_compile_execution = Some(measured_execution)
            val client_profile = rt_env_get("SIMPLE_DEMAND_COMPILE_PROFILE") ?? "compiler"
            val client_priority = match client_profile:
                "mcp": 1000
                "lsp": 1000
                "test-daemon": 800
                _: 900
            val client_pools = if client_profile == "test-daemon":
                ["io", "parse", "semantic", "mir", "cranelift", "llvm", "link", "test"]
            else:
                ["io", "parse", "semantic", "mir", "cranelift", "llvm", "link"]
            val artifact_route = demand_artifact_route_v1(
                measured_execution,
                artifact_service_profile_v1(
                    client_profile,
                    rt_env_get("SIMPLE_PACKAGE_INDEX_VARIANT_DIGEST") ?? "",
                    client_pools, client_priority, true),
                (rt_env_get("SIMPLE_COMPILER_ARTIFACT_SERVICE_AVAILABLE") ?? "") == "1",
                rt_env_get("SIMPLE_COMPILER_ARTIFACT_OWNER") ?? "local-compiler-owner",
                (rt_env_get("SIMPLE_BUILD_ORDINAL") ?? "0").to_i64() ?? 0)
            if not artifact_route.valid:
                self.ctx.add_error(
                    "artifact service admission failed: {artifact_route.reason}")
                driver_entry_scan_cache_release()
                return (self.ctx, false)
            self.ctx.demand_artifact_route = Some(artifact_route)
            driver_inputs = route.source_paths
            self.ctx.demand_dirty_modules = route.dirty_modules
            package_index_routed = true
            var archive_transaction = route_archive_install_begin_v1()
            var capability_scope = route_capability_scope_new_v1(
                512 * 1024 * 1024)
            var archive_evidence: [CombinedMirArchiveEvidenceV1] = []
            var dirty_evidence: [CombinedMirDirtyEvidenceV1] = []
            val demand_snapshot = CombinedMirScvIdentityV1(
                rt_env_get("SIMPLE_SCV_REVISION_ID") ?? "",
                rt_env_get("SIMPLE_SCV_TREE_ID") ?? "",
                rt_env_get("SIMPLE_SCV_INVENTORY_DIGEST") ?? "")
            for dirty in route.dirty_modules:
                var read_set_digests: [text] = []
                for read in dirty.read_set:
                    read_set_digests.push(read.content_digest)
                dirty_evidence.push(CombinedMirDirtyEvidenceV1(
                    dirty.package_id, dirty.module_id, [dirty.module_id],
                    dirty.direct_dependency_module_ids, read_set_digests,
                    dirty.semantic_digest, dirty.producer_compatibility_id,
                    dirty.configuration_variant, demand_snapshot))
            for admission in route.archive_admissions:
                if admission.load.receipt == nil:
                    _ = route_capability_scope_close_all_v1(&capability_scope)
                    archive_transaction = route_archive_install_rollback_owned_v1(
                        archive_transaction)
                    self.ctx.add_error(
                        "package archive receipt unavailable: {admission.package_identity}")
                    driver_entry_scan_cache_release()
                    return (self.ctx, false)
                val opened = pinned_archive_open_verified_v1(
                    machine_cache_root(), admission.archive_path,
                    admission.load.receipt!)
                if opened.is_err():
                    _ = route_capability_scope_close_all_v1(&capability_scope)
                    archive_transaction = route_archive_install_rollback_owned_v1(
                        archive_transaction)
                    self.ctx.add_error(
                        "package archive pin failed: {admission.package_identity}")
                    driver_entry_scan_cache_release()
                    return (self.ctx, false)
                val capability = opened.unwrap()
                if route_capability_scope_register_v1(
                        &capability_scope, capability).is_err():
                    _ = route_capability_scope_close_all_v1(&capability_scope)
                    archive_transaction = route_archive_install_rollback_owned_v1(
                        archive_transaction)
                    self.ctx.add_error(
                        "package archive capability ownership failed: {admission.package_identity}")
                    driver_entry_scan_cache_release()
                    return (self.ctx, false)
                val decoded = interface_action_archive_decode_v1(
                    capability, admission.load.receipt!)
                if decoded.is_err():
                    _ = route_capability_scope_close_all_v1(&capability_scope)
                    archive_transaction = route_archive_install_rollback_owned_v1(
                        archive_transaction)
                    self.ctx.add_error(
                        "package archive decode failed: {admission.package_identity}")
                    driver_entry_scan_cache_release()
                    return (self.ctx, false)
                self.ctx.demand_compile_execution = Some(
                    demand_compile_section_reads_v1(
                        self.ctx.demand_compile_execution!, 3))
                val staged = route_archive_install_stage_owned_v1(
                    archive_transaction, decoded.unwrap())
                archive_transaction = staged.transaction
                if staged.result.is_err():
                    _ = route_capability_scope_close_all_v1(&capability_scope)
                    archive_transaction = route_archive_install_rollback_owned_v1(
                        archive_transaction)
                    self.ctx.add_error(
                        "package archive install failed: {admission.package_identity}")
                    driver_entry_scan_cache_release()
                    return (self.ctx, false)
                var archive_read_sets: [text] = []
                for member in admission.load.receipt!.members:
                    archive_read_sets.push(member.payload_digest)
                for entry in admission.module_entries:
                    archive_evidence.push(CombinedMirArchiveEvidenceV1(
                        admission.package_identity, entry.module_identity,
                        [entry.module_identity], entry.direct_imports,
                        archive_read_sets,
                        entry.smf_metadata_digest,
                        admission.load.receipt!.producer_digest,
                        admission.load.receipt!.variant_digest,
                        demand_snapshot))
            val committed = route_archive_install_commit_owned_v1(
                archive_transaction, self.ctx.archive_semantic_owner,
                self.ctx.archive_action_owner)
            archive_transaction = committed.transaction
            self.ctx.archive_semantic_owner = committed.semantic_owner
            self.ctx.archive_action_owner = committed.action_owner
            if committed.result.is_err():
                _ = route_capability_scope_close_all_v1(&capability_scope)
                self.ctx.add_error("package archive route commit failed")
                driver_entry_scan_cache_release()
                return (self.ctx, false)
            for admission in route.archive_admissions:
                var artifact_route = self.ctx.demand_artifact_route!
                artifact_route.execution = self.ctx.demand_compile_execution!
                val action_id = demand_archive_action_id_v1(admission.package_identity)
                val claimed = demand_artifact_claim_owned_v1(
                    artifact_route, action_id,
                    "driver-archive-owner:{action_id}", 512 * 1024 * 1024)
                artifact_route = claimed.route
                if not claimed.claim.valid:
                    self.ctx.demand_compile_execution = Some(
                        artifact_route.execution)
                    self.ctx.demand_artifact_route = Some(artifact_route)
                    self.ctx.add_error(
                        "demand archive action commit failed: {admission.package_identity}")
                    _ = route_capability_scope_close_all_v1(&capability_scope)
                    driver_entry_scan_cache_release()
                    return (self.ctx, false)
                val artifact_commit = demand_artifact_commit_owned_v1(
                    artifact_route, BuildActionResultV1(
                        action_id,
                        rt_env_get("SIMPLE_SCV_REVISION_ID") ?? "",
                        true, false, admission.load.receipt!.archive_digest,
                        admission.load.receipt!.archive_digest, [], 0))
                artifact_route = artifact_commit.route
                if not artifact_commit.accepted:
                    self.ctx.demand_compile_execution = Some(
                        artifact_route.execution)
                    self.ctx.demand_artifact_route = Some(artifact_route)
                    self.ctx.add_error(
                        "demand archive action commit failed: {admission.package_identity}")
                    _ = route_capability_scope_close_all_v1(&capability_scope)
                    driver_entry_scan_cache_release()
                    return (self.ctx, false)
                self.ctx.demand_compile_execution = Some(artifact_route.execution)
                self.ctx.demand_artifact_route = Some(artifact_route)
            val demand_admission = combined_mir_evidence_build_v1(
                CombinedMirEvidenceBuilder(
                    demand_snapshot,
                    rt_env_get("SIMPLE_PACKAGE_INDEX_PRODUCER_DIGEST") ?? "",
                    rt_env_get("SIMPLE_PACKAGE_INDEX_VARIANT_DIGEST") ?? "",
                    archive_evidence, dirty_evidence))
            val close_result = route_capability_scope_close_all_v1(
                &capability_scope)
            if close_result.is_err():
                self.ctx.add_error("package archive capability cleanup failed")
                driver_entry_scan_cache_release()
                return (self.ctx, false)
            if demand_admission.is_err():
                self.ctx.add_error(
                    "combined dirty/archive MIR authority construction failed: {demand_admission.unwrap_err()}")
                driver_entry_scan_cache_release()
                return (self.ctx, false)
            self.ctx.demand_mir_admission = Some(demand_admission.unwrap())
        if entry_closure_walk:
            if not package_index_routed:
                driver_inputs = [requested_entry_input]
        elif driver_inputs.len() == 0:
            if requested_entry_input != "":
                driver_inputs = [requested_entry_input]
        val input_len = driver_inputs.len()
        val source_trace = (rt_env_get("SIMPLE_COMPILER_TRACE") ?? "") == "1" or (rt_env_get("SIMPLE_INTERP_TRACE") ?? "") == "1"
        if source_trace:
            print "[load_sources] inputs {input_len}"
        if input_len <= 0:
            if package_index_routed:
                if self.ctx.archive_action_owner.archive_actions.len() == 0:
                    self.ctx.add_error(
                        "persistent package index produced an empty archive-only route; refusing bootstrap source fallback")
                    driver_entry_scan_cache_release()
                    return (self.ctx, false)
                # A clean package-index route is complete after pinned archive
                # ingestion. It must never enter bootstrap source discovery.
                self.ctx.sources = []
                driver_entry_scan_cache_release()
                return (self.ctx, not self.ctx.has_errors())
            if source_trace:
                print "[load_sources] bootstrap defaults"
            self.parse_bootstrap_default_root("./src/compiler")
            self.parse_bootstrap_default_root("./src/lib/nogc_sync_mut")
            self.parse_bootstrap_default_root("./src/lib/common")
            self.parse_bootstrap_default_root("./src/app/io")
            self.parse_bootstrap_default_root("./src/app/cli/bootstrap_main.spl")
            has_project_source = false
            if source_trace:
                print "[load_sources] direct modules loaded"
            driver_entry_scan_cache_release()
            return (self.ctx, not self.ctx.has_errors())
        while i < input_len:
            val input_path = driver_inputs[i]
            log_phase(
                "phase1:load_sources:input:start index={i} path={input_path}")
            # `_driver_collect_sources` owns bulk-lane exclusions (interpreter,
            # parser, treesitter, and async lowering).  Applying those filters
            # to the explicit entry makes a real, existing file disappear when
            # its canonical path names one of those lanes; the symlink spelling
            # then works only by evading the substring filter. Native-build
            # imports retain packaging exclusions; the compiler-owned explicit
            # API admits the exact authored source graph without those filters.
            val loaded = if package_index_routed:
                _driver_collect_explicit_compiler_source(input_path)
            elif entry_closure_walk and input_path == requested_entry_input:
                if explicit_entry_closure:
                    _driver_collect_explicit_compiler_source(input_path)
                else:
                    _driver_collect_entry_import_source(input_path)
            else:
                _driver_collect_sources(input_path)
            if package_index_routed:
                var open_execution = self.ctx.demand_compile_execution!
                demand_compile_source_open_v1(&mut open_execution)
                self.ctx.demand_compile_execution = Some(open_execution)
            for s in loaded:
                val source_key = s.path + "::" + s.module_name
                if not seen_sources.contains_key(source_key):
                    seen_sources[source_key] = true
                    all_sources.append(s)
            if package_index_routed:
                var artifact_route = self.ctx.demand_artifact_route!
                artifact_route.execution = self.ctx.demand_compile_execution!
                val action_id = demand_source_action_id_v1(input_path)
                val claimed = demand_artifact_claim_owned_v1(
                    artifact_route, action_id,
                    "driver-source-owner:{action_id}", 512 * 1024 * 1024)
                artifact_route = claimed.route
                if not claimed.claim.valid:
                    self.ctx.demand_compile_execution = Some(
                        artifact_route.execution)
                    self.ctx.demand_artifact_route = Some(artifact_route)
                    self.ctx.add_error(
                        "demand frozen-source action commit failed: {input_path}")
                    driver_entry_scan_cache_release()
                    return (self.ctx, false)
                val artifact_commit = demand_artifact_commit_owned_v1(
                    artifact_route, BuildActionResultV1(
                        action_id,
                        rt_env_get("SIMPLE_SCV_REVISION_ID") ?? "",
                        loaded.len() > 0, false,
                        if loaded.len() > 0: input_path else: "",
                        "", [], 0))
                artifact_route = artifact_commit.route
                if not artifact_commit.accepted:
                    self.ctx.demand_compile_execution = Some(
                        artifact_route.execution)
                    self.ctx.demand_artifact_route = Some(artifact_route)
                    self.ctx.add_error(
                        "demand frozen-source action commit failed: {input_path}")
                    driver_entry_scan_cache_release()
                    return (self.ctx, false)
                self.ctx.demand_compile_execution = Some(artifact_route.execution)
                self.ctx.demand_artifact_route = Some(artifact_route)
            if input_path.starts_with("src/"):
                has_project_source = true
            log_phase(
                "phase1:load_sources:input:done index={i} loaded={loaded.len()} total={all_sources.len()}")
            i = i + 1
        log_phase(
            "phase1:load_sources:seeded inputs={input_len} total={all_sources.len()}")

        # FAIL-CLOSED on an empty seed set. An explicit native-build entry that
        # collects zero source files used to fall through silently: the closure
        # walk below then logged `source_closure 0/0` and the only surfaced
        # diagnostic was a much later "native entry source not found", which
        # reads like a resolution failure inside a loaded graph rather than
        # "nothing was ever loaded". Measured 2026-08-17: passing a module PATH
        # (`pkg.main`) instead of a FILE path (`.../main.spl`) to --entry lands
        # here, because `--entry` is a filesystem path and is fed straight to
        # `_driver_collect_sources`. Two separate investigations misread that
        # `0/0` as a source-discovery defect. Name the cause at its origin.
        # Gated on the exact condition that made the entry the sole seed at
        # line 116-117, so a re-entrant worker (ENTRY_CLOSURE already 1, seeds
        # taken from --source roots) keeps its old behaviour.
        if entry_closure_walk and all_sources.len() == 0:
            self.ctx.add_error("compiler entry '{requested_entry_input}' collected zero source files: the entry must be a path to a .spl file (e.g. 'dir/main.spl'), not a module path (e.g. 'dir.main'), and the path is resolved relative to the current working directory")
            driver_entry_scan_cache_release()
            return (self.ctx, false)

        # ROOT FIX (#138 Wall #1): a native-build seeded with one entry used to
        # load ONLY the entry file — never its import closure. ctx.modules then
        # lacked every imported module, resolve_import_symbols registered no
        # imported symbols, and any cross-module callee lowered to
        # HirExprKind.Error -> MIR CallIndirect(func=Copy(nil)) -> nil `.id`
        # crash / llc "use of undefined value '%l0'". Resolve and load the
        # entry's transitive import closure here (fixpoint over the growing
        # source list = depth-first with the seen_sources visited set), then
        # flip the existing --entry-closure pipeline gates so every closure
        # module is parsed, lowered, and compiled into the binary. This also
        # keeps the bootstrap Stage-4 path from parsing every explicit source
        # tree before entry-closure pruning can happen.
        if entry_closure_walk and not package_index_routed:
            # Explicit --source roots are resolver fallbacks, not closure seeds.
            # This preserves custom source layouts without parsing every file in
            # each root before the entry's transitive imports are known.
            var closure_loaded_mods = _driver_text_bucket_set_new(512)
            var closure_preidx = 0
            while closure_preidx < all_sources.len():
                val loaded_module_name = all_sources[closure_preidx].module_name
                closure_loaded_mods[loaded_module_name] = true
                closure_preidx = closure_preidx + 1
            var closure_seen_mods = _driver_text_bucket_set_new(512)
            var closure_scan_sources = _driver_unique_physical_sources(all_sources)
            var closure_queued_paths = _driver_text_bucket_set_new(512)
            for queued_source in closure_scan_sources:
                closure_queued_paths[_driver_physical_source_key(queued_source.path)] = true
            var closure_idx = 0
            # A 64-file cadence is adequate for ordinary progress, but hides
            # the exact source that starts a tail stall.  Keep the normal
            # receipt rate allocation-free and opt into an in-flight receipt
            # for every source only during a bounded closure investigation.
            val trace_closure_file =
                (rt_env_get("SIMPLE_NATIVE_BUILD_TRACE_CLOSURE_FILE") ?? "") == "1"
            log_phase(
                "phase1:load_sources:closure:start logical={all_sources.len()} physical={closure_scan_sources.len()}")
            log_build_progress("source_closure", "files", 0,
                closure_scan_sources.len(), "pending", 0, 6, 0, 0, "running")
            while closure_idx < closure_scan_sources.len():
                if closure_idx % 64 == 0:
                    log_phase(
                        "phase1:load_sources:closure:progress index={closure_idx} physical={closure_scan_sources.len()} logical={all_sources.len()}")
                val closure_src = closure_scan_sources[closure_idx]
                if trace_closure_file:
                    log_build_progress("source_closure", "files", closure_idx,
                        closure_scan_sources.len(), closure_src.path,
                        0, 6, 0, 0, "running")
                if closure_idx % 64 == 0:
                    log_build_progress("source_closure", "files", closure_idx,
                        closure_scan_sources.len(), closure_src.path,
                        0, 6, 0, 0, "running")
                val closure_dir = _driver_entry_import_dirname(closure_src.path)
                val (_, cached_closure_imports, _, _) = _driver_cached_entry_source_scan(closure_src.path)
                var closure_imports = cached_closure_imports
                # Hidden compiler ABI dependencies are admitted from a typed
                # parser result. The substring is only an allocation-saving
                # prefilter; it never decides whether a declaration is HAL.
                if _driver_source_has_rt_annotation(closure_src.content):
                    val rt_probe = parse_full_frontend(
                        closure_src.content, closure_src.path,
                        closure_src.module_name, self.ctx.logger)
                    var closure_has_rt_hal = false
                    var closure_has_rt_hal_foreign = false
                    for probe_fn in rt_probe.functions.values():
                        val probe_attr = parse_function_attrs(probe_fn.attributes)
                        if probe_attr.is_rt_hal:
                            closure_has_rt_hal = true
                            if probe_attr.rt_hal_compare_c or probe_attr.rt_hal_compare_rust:
                                closure_has_rt_hal_foreign = true
                    if closure_has_rt_hal:
                        closure_imports.push("std.nogc_sync_mut.rt_hal.boundary")
                    if closure_has_rt_hal_foreign:
                        closure_imports.push("std.nogc_sync_mut.rt_hal.process_task_arena")
                        closure_imports.push("app.io.env_access_host")
                # Dynamic MC/DC probes call the Pure-Simple capsule patchpoint
                # ABI directly. Keep that owner in entry-closure builds even
                # though the authored source does not need a synthetic import.
                val mcdc_closure_mode = self.ctx.config["mcdc_mode"] ?? "off"
                if mcdc_closure_mode == "dynamic":
                    closure_imports.push("std.nogc_sync_mut.mcdc.dynamic_probe")
                elif mcdc_closure_mode == "on":
                    closure_imports.push("std.nogc_sync_mut.mcdc.static_probe")
                log_phase(
                    "phase1:load_sources:closure:scan path={closure_src.path} imports={closure_imports.len()} content_len={closure_src.content.len()}")
                if source_trace:
                    print "[load_sources] entry-closure scan {closure_src.path} imports {closure_imports.len()}"
                for closure_mp in closure_imports:
                    if closure_seen_mods.contains_key(closure_mp):
                        continue
                    closure_seen_mods[closure_mp] = true
                    if closure_loaded_mods.contains_key(closure_mp):
                        # Already satisfied by an explicit --source root (or an
                        # earlier closure step): nothing to resolve, not an error.
                        # Traced anyway: this branch and the unresolved branch
                        # above are the only two ways a module can leave the
                        # closure, so a silent one costs a full bootstrap cycle
                        # to tell apart. Same bug record as above.
                        log_phase(
                            "phase1:load_sources:closure:already-loaded module={closure_mp} used_in={closure_src.path}")
                        continue
                    var closure_file = _driver_resolve_entry_import(closure_mp, closure_dir)
                    if closure_file == "":
                        for closure_source_root in closure_source_roots:
                            closure_file = _driver_resolve_entry_import(closure_mp, closure_source_root)
                            if closure_file != "":
                                break
                    if closure_file == "":
                        # LOUD error naming the module path. Single-segment
                        # unresolved names are skipped: they are more likely
                        # prose/scoped pseudo-imports than real module files.
                        if closure_mp.contains("."):
                            self.ctx.add_error("unresolved import '{closure_mp}' (used in {closure_src.path}): no source file found for this module path relative to the working directory, src/, src/lib/, or '{closure_dir}'")
                        # add_error alone is not observable from a staged
                        # bootstrap: the Stage-3 native-build worker does not
                        # forward phase-1 ctx errors, so a run that dropped a
                        # module here printed only `native-build failed without
                        # diagnostics` 10,000 lines later, and the drop had to be
                        # inferred. log_phase IS captured. See
                        # doc/08_tracking/bug/stage3_closure_omits_definition_owner_modules_2026-09-01.md
                        log_phase(
                            "phase1:load_sources:closure:unresolved module={closure_mp} used_in={closure_src.path} dir={closure_dir}")
                        continue
                    val closure_loaded = if explicit_entry_closure:
                        _driver_collect_explicit_compiler_source(closure_file)
                    else:
                        _driver_collect_entry_import_source(closure_file)
                    if closure_loaded.len() == 0:
                        self.ctx.add_error("import '{closure_mp}' (used in {closure_src.path}) resolved to '{closure_file}' but that file is empty or excluded from compilation")
                        # Third silent exit from this loop, and the one that hid
                        # longest: the module RESOLVES to a real file, so the
                        # unresolved trace never fires, but the collect policy
                        # returns nothing and the module leaves the closure.
                        log_phase(
                            "phase1:load_sources:closure:excluded module={closure_mp} used_in={closure_src.path} file={closure_file}")
                        continue
                    var closure_has_exact = false
                    var closure_content = ""
                    for cs in closure_loaded:
                        closure_content = cs.content
                        if cs.module_name == closure_mp:
                            closure_has_exact = true
                        val closure_key = cs.path + "::" + cs.module_name
                        if not seen_sources.contains_key(closure_key):
                            seen_sources[closure_key] = true
                            all_sources.append(cs)
                            closure_loaded_mods[cs.module_name] = true
                        val closure_physical_key = _driver_physical_source_key(cs.path)
                        if not closure_queued_paths.contains_key(closure_physical_key):
                            closure_queued_paths[closure_physical_key] = true
                            closure_scan_sources.append(cs)
                    if not closure_has_exact:
                        # The path-derived module name differs from the import
                        # path (e.g. an entry-directory-relative import). Alias
                        # the file under the import path so
                        # resolve_import_symbols finds it by name.
                        val closure_alias_key = closure_file + "::" + closure_mp
                        if not seen_sources.contains_key(closure_alias_key):
                            seen_sources[closure_alias_key] = true
                            all_sources.append(SourceFile(path: closure_file, content: closure_content, module_name: closure_mp))
                            closure_loaded_mods[closure_mp] = true
                closure_idx = closure_idx + 1
            log_phase(
                "phase1:load_sources:closure:done scanned={closure_idx} logical={all_sources.len()}")
            log_build_progress("source_closure", "files", closure_idx,
                closure_idx, "complete", 1, 6, 0, 0, "running")
            # An explicit-entry walk is a closure even when import resolution
            # reports an error. Keep that error bounded to the requested graph
            # instead of hiding it behind an unrelated whole-workspace failure.
            if not explicit_entry_closure:
                rt_env_set("SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE", "1")

        # Add core source roots only when compiling project sources (self-hosted build).
        # native-build --entry-closure suppresses this implicit whole-src bulk-load
        # so a small userland entry doesn't compile all of src/{app,lib,compiler,runtime}.
        # Interpret mode resolves imported modules lazily through the interpreter
        # module loader. Bulk-loading the four trees here defeats that contract:
        # even a one-file test or the native-build worker parses 600+ unrelated
        # modules before its entry can run, exceeding the normal CPU/RSS guard.
        val nb_entry_closure = explicit_entry_closure or (
            rt_env_get("SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE") ?? "") == "1"
        val compile_mode = self.ctx.options.mode
        val needs_bulk_project_sources = compile_mode != CompileMode.Check and compile_mode != CompileMode.Interpret
        if (has_project_source and needs_bulk_project_sources and
                not nb_entry_closure and not package_index_routed):
            val paths = ["src/app", "src/lib", "src/compiler", "src/runtime"]
            val bulk_loaded = _driver_collect_sources_via_find(paths)
            if bulk_loaded.len() > 0:
                for s in bulk_loaded:
                    val source_key = s.path + "::" + s.module_name
                    if not seen_sources.contains_key(source_key):
                        seen_sources[source_key] = true
                        all_sources.append(s)
            else:
                for p in paths:
                    val loaded = _driver_collect_sources(p)
                    for s in loaded:
                        val source_key = s.path + "::" + s.module_name
                        if not seen_sources.contains_key(source_key):
                            seen_sources[source_key] = true
                            all_sources.append(s)

        log_phase("phase1:load_sources:bulk:done logical={all_sources.len()}")
        val module_collision = _driver_module_name_collision(all_sources)
        if module_collision != "":
            self.ctx.add_error(module_collision)
            driver_entry_scan_cache_release()
            return (self.ctx, false)

        # Single assignment avoids chained push issue
        # The streaming compiler owns one canonical context. Commit source
        # inventory directly instead of reconstructing a whole CompileContext
        # value and transporting it through the phase-1 tuple boundary.
        log_phase("phase1:load_sources:collision_check:done")
        self.ctx.sources = all_sources
        var owned_paths: [text] = []
        var owned_authored_paths: [text] = []
        var owned_contents: [text] = []
        var owned_content_hashes: [i64] = []
        var owned_module_names: [text] = []
        var content_by_physical_path: Dict<text, text> = {}
        for loaded_source in all_sources:
            val owned_path = driver_source_owner_text_copy(loaded_source.path)
            val physical_key = _driver_physical_source_key(owned_path)
            var owned_content = ""
            if content_by_physical_path.contains_key(physical_key):
                owned_content = content_by_physical_path[physical_key]
            else:
                owned_content = driver_source_owner_text_copy(loaded_source.content)
                content_by_physical_path[physical_key] = owned_content
            owned_paths = owned_paths.push(owned_path)
            owned_authored_paths = owned_authored_paths.push(
                driver_source_owner_text_copy(loaded_source.authored_path))
            owned_contents = owned_contents.push(owned_content)
            val raw_content_hash = rt_hash_text(owned_content)
            owned_content_hashes = owned_content_hashes.push(
                if raw_content_hash == 0: 1 else: raw_content_hash)
            owned_module_names = owned_module_names.push(
                driver_source_owner_text_copy(loaded_source.module_name))
        log_phase("phase1:load_sources:owner_copy:done n={all_sources.len()}")
        self.ctx.source_paths_owner = owned_paths
        self.ctx.source_authored_paths_owner = owned_authored_paths
        self.ctx.source_contents_owner = owned_contents
        self.ctx.source_content_hashes_owner = owned_content_hashes
        self.ctx.source_module_names_owner = owned_module_names
        # Canonical phase-1 owners now retain the source bodies. Drop the
        # duplicate scan payloads before parsing/lowering grows compiler RSS.
        driver_entry_scan_cache_release()
        if source_trace:
            print "[load_sources] total {all_sources.len()}"

        # Keep the scalar error verdict in this aggregate's owning frame.  The
        # self-hosted Stage2 ABI cannot safely pass the freshly copied
        # CompileContext through another receiver-method boundary here.
        (self.ctx, self.ctx.error_count_value == 0)
use compiler.common.diagnostics.span.{Span}
