# Public, source-driven explanation boundary: parsing, HIR checking,
# monomorphization and actual MIR consumption, without native linking.
use compiler.common.driver_core_types.{CompileOptions, CompileMode, CompileResult}
use compiler.driver.driver.{compiler_driver_create}
use compiler.driver.driver_orchestration.*

pub fn compile_collection_plan_explanations(path: text, options: CompileOptions) -> Result<[text], text>:
    var request = options
    request.input_files = [path]
    request.mode = CompileMode.Check
    request.cli_mode_text = "check"
    # Retain source/HIR owners through the explicit MIR explanation phase.
    request.low_memory = false
    var driver = compiler_driver_create(request)
    driver.ctx.config["collection-plan-explain-mir"] = "1"
    # BSM P6: mir_modules is read after compile(); keep it out of the session.
    driver.ctx.config["build-session-retain-products"] = "1"
    val verdict = driver.compile()
    match verdict:
        case CompileResult.Success(_): ()
        case _: return Err(verdict.get_errors().join("\n"))
    var reports: [text] = []
    for module in driver.ctx.mir_modules.values():
        for report in module.collection_plan_explanations:
            reports = reports.push(report)
    Ok(reports)
