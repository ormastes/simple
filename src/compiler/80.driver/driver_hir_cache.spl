# HIR cache — one encoded HirModule per (module source, closure surfaces,
# compiler identity), under build/bootstrap/native_cache/<lane>/hir/.
#
# Sibling of the front-end parse cache (frontend_parse_cache.spl) one phase
# later: a hit hands the driver a decoded HirModule and skips lowering, which
# is the phase that costs 142 s/module interpreted on the bootstrap closure
# (doc/08_tracking/bug/native_build_phases_after_parse_single_threaded_2026-08-22.md).
# HIR shard workers (native_build_main.spl) exist only to fill this cache.
#
# KEY. What lowering reads besides the module's own source is the FROZEN
# MODULE SURFACES -- and not only its imports': module_lowering.spl builds a
# decl-owner index over EVERY surface (`surface_decl_owners`, the whole-closure
# loop at module_lowering.spl:358) and re-export materialization walks package
# siblings that are not import edges. So the key folds a digest of ALL frozen
# surfaces, not the import closure alone; a per-import key would serve a stale
# module after an edit to a non-imported sibling that adds a same-named
# declaration. The price is that any source edit invalidates every entry --
# acceptable, because the win this cache exists for is the repeated bootstrap
# stages over an IDENTICAL tree.
#   key = sha256( source-key version | sha256(normalized source path)
#                 | sha256(source file) | closure digest | is_entry
#                 | the env switches that change what lowering emits
#                 | codec header )
# The compiler identity rides in the entry HEADER and the directory (the
# front-end cache's scope, which folds the compiler SOURCE fingerprint), so a
# compiler edit is a loud version mismatch, never a silent hit.
#
# STORE is atomic (pid-unique temp + rename) because N shard workers write one
# directory concurrently. A module the codec refuses (hir_codec_support.spl)
# is simply not stored: a cache that cannot store is a slow build, not a wrong
# one.
#
# INTEGRITY (task 8a, plan ids IR-05 / RB-19A / BUG-02 of
# doc/.../simple_bug_prevention_final_plan_2026-10-09.md). The header above
# proves only that an entry was written by THIS compiler; it says nothing about
# the bytes under it. The HIR codec wrote integer 3 / bool true as nil for weeks
# (hir_codec_put_i64_three_encoded_as_nil_native_2026-10-10.md) and the cache
# reported `hits=0 misses=1163` without one diagnostic naming WHY. So:
#   entry = <header>\n C <sha256 of body>\n <body>
# where body = "W\n<n>\n<escaped warnings...><codec blob>". Load verifies the
# checksum BEFORE decoding and classifies every rejection
# (absent/header/checksum/framing/decode) into a counter that the summary line
# prints; a rejected entry is a counted MISS, never a crash and never a partial
# decode. Store can additionally decode what it just encoded
# (SIMPLE_HIR_CACHE_SELFCHECK, host-config key hir_cache_selfcheck; ON in the
# bootstrap lanes) and refuses to publish an entry that does not round-trip,
# naming the first differing line/field. A failed write (P-INFRA-3: 74 orphan
# `<key>.hir.<pid>.tmp` after a disk-full window) deletes its temp file, counts
# as io_failed and is reported once, loudly.

use std.nogc_async_mut.sosix.environment.{sosix_env_get_nullable}
use compiler.hir.hir_types.{HirModule}
use compiler.hir.hir_codec.{hir_module_encode, hir_module_encode_reason, hir_module_decode, hir_module_decode_reason, hir_module_decode_stable, hir_codec_header}
use compiler.frontend.core.flat_pool_codec.{FlatPoolReader, flat_pool_escape}
use compiler.common.cache_contract.hir_cache_envelope_reader_v1.{hir_cache_envelope_parse, hir_cache_parser_record_valid_v1}
use compiler.common.module_path_naming.{module_source_relative_path}
use compiler.hir.hir_lowering.module_surface.{ModuleSurfacesByName}
use compiler.frontend.frontend_parse_cache.{frontend_parse_cache_scope}
use compiler.driver.driver_cache_scope_policy_v1.{hir_cache_identity_scope_v1}
use std.common.crypto.sha256.{sha256_text, sha256_runtime_fallback_used}
use std.nogc_sync_mut.io.file_ops.{file_lock, file_unlock, file_write}
use std.nogc_sync_mut.io_runtime.{file_exists, file_read_nullable}
use std.nogc_sync_mut.io.process_ops.{eprint}
use compiler.driver.driver_worker_surface_closure_v1.{worker_surface_claim_allowed_v1, worker_surface_counters_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause, transient_scope_end, transient_promote}
use compiler.driver.driver_parse_shard_hash.{driver_parse_shard_hash}
use compiler.driver.driver_hir_recovery.{hir_shard_recovery_claim, hir_shard_recovery_terminal, hir_shard_recovery_complete, hir_shard_recovery_block, hir_shard_recovery_blocked}
use compiler.driver.driver_hir_recovery.{hir_shard_recovery_inventory}
use compiler.driver.driver_build.native_file_worker_v1.{native_file_worker_deps_publish_v1,
    native_file_worker_hirkey_publish_v1, mono_module_scoped_selected_v1}

extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_file_hash_sha256(path: text) -> text
extern fn rt_dir_create_all(path: text) -> bool
extern fn rt_getpid() -> i64
extern fn rt_heap_ref_wellformed<T>(value: T) -> bool
extern fn rt_file_move(src: text, dst: text) -> bool
extern fn rt_file_delete(path: text) -> bool

# v3: body checksum line after the header (see INTEGRITY above). A v2 entry
# fails the header test and is a counted `header` rejection, not a decode.
val HIR_CACHE_ENTRY_VERSION: text = "spl-hircache-v3"
val HIR_CACHE_CHECKSUM_PREFIX: text = "C "
# Rejection classes, in summary order. Every load that returns nil for an
# EXISTING key increments exactly one of them.
val HIR_CACHE_REJECT_REASONS: [text] = ["absent", "header", "checksum", "framing", "decode"]

# Diagnostic counters, same shape as the front-end cache's.
var _hir_cache_hits: i64 = 0
var _hir_cache_misses: i64 = 0
use compiler.driver.cache.cache_root.{machine_cache_root}

var _hir_cache_stores: i64 = 0
# Store-side refusals (codec refused the module, or the write-time self-check
# failed) and I/O failures (write/rename). `reason` keeps the LAST refusal so
# the summary can name it without a per-entry log line.
var _hir_cache_refused: i64 = 0
var _hir_cache_last_reason: text = "-"
# Index-aligned with HIR_CACHE_REJECT_REASONS.
var _hir_cache_rejected: [i64] = [0, 0, 0, 0, 0]
# Recovered (warning-level) lowering diagnostics of the last loaded entry, so
# a hit replays exactly what the in-process lowering would have reported.
var _hir_cache_last_warnings: [text] = []

fn hir_cache_enabled() -> bool:
    if (sosix_env_get_nullable("SIMPLE_HIR_CACHE") ?? "") == "0":
        return false
    # Requires the front-end cache scope: that is the compiler identity the
    # header is checked against. No scope, no identity, no cache.
    _hir_cache_identity_scope() != ""

# Identity the HIR header folds. Equals frontend_parse_cache_scope() whenever
# the frontend cache is on; with SIMPLE_FRONTEND_CACHE=0 it falls back to the
# published SIMPLE_FRONTEND_CACHE_SCOPE so the HIR cache keeps working.
fn _hir_cache_identity_scope() -> text:
    hir_cache_identity_scope_v1(frontend_parse_cache_scope(),
        sosix_env_get_nullable("SIMPLE_FRONTEND_CACHE_SCOPE") ?? "",
        sosix_env_get_nullable("SIMPLE_FRONTEND_CACHE") ?? "")

fn hir_cache_dir() -> text:
    val root = sosix_env_get_nullable("SIMPLE_HIR_CACHE_DIR") ?? ""
    if root != "":
        return root
    val lane = sosix_env_get_nullable("SIMPLE_CACHE_SCOPE") ?? ""
    val lane_name = if lane == "": "default" else: lane
    "{machine_cache_root()}/native-build/v1/{lane_name}/hir"

# Digest of every frozen surface, computed ONCE per build. Folds the fields
# that identify a surface's content: its canonical path and content hash plus
# the names it is registered under (an alias change moves what a sibling
# resolves to without changing any file hash).
fn hir_cache_closure_digest(surfaces: ModuleSurfacesByName) -> text:
    var parts: [text] = ["{surfaces.surfaces.len()}\n"]
    var i = 0
    while i < surfaces.surfaces.len():
        val s = surfaces.surfaces[i]
        # Repo-relative: the sharded route reads an absolute SCV snapshot, the
        # direct route the checkout; the same closure must digest equally.
        parts = parts.push(module_source_relative_path(s.canonical_path) + "|" + "{s.content_hash}" + "|" + "{s.content_length}" + "|" + s.module_name + "|" + s.logical_name + "\n")
        i = i + 1
    sha256_text(parts.join(""))

fn _hir_cache_env_switches() -> text:
    # Every environment switch module_build.spl / the driver consult when
    # deciding WHAT to lower (bootstrap constants recovery, flat rows, stub
    # HIR). Folding them keeps one directory safe across modes.
    var out = ""
    for name in ["SIMPLE_BOOTSTRAP", "SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE", "SIMPLE_BOOTSTRAP_STAGE4", "SIMPLE_STUB_HIR", "SIMPLE_STAGE3_STREAMING_SURFACES"]:
        out = out + name + "=" + (sosix_env_get_nullable(name) ?? "") + "\n"
    out

fn hir_cache_key(source_path: text, closure_digest: text, is_entry: bool) -> text:
    if closure_digest == "" or not file_exists(source_path):
        return ""
    val source_digest = rt_file_hash_sha256(source_path)
    if source_digest.len() != 64:
        return ""
    val entry_flag = if is_entry: "entry" else: "module"
    # Equal bytes at different repo paths are different owners even within the
    # same frozen closure. Hash the path separately so arbitrary path bytes
    # cannot cross field boundaries. The path is repo-relative so the sharded
    # route (absolute SCV snapshot) and the direct route (checkout) share
    # entries; hir_cache_load_parsed_v1 rebinds HirModule.path on a hit.
    # Logical aliases share the one physical surface lowering; their registry
    # identities already participate in the closure digest above.
    val source_path_digest = sha256_text(module_source_relative_path(source_path))
    sha256_text("hir-source-key-v2\n" + source_path_digest + "\n" + source_digest + "\n" + closure_digest + "\n" + entry_flag + "\n" + _hir_cache_env_switches() + hir_codec_header() + "\n")

fn hir_cache_path(key: text, parser_selected: bool = false) -> text:
    hir_cache_dir() + "/" + key + (if parser_selected: ".parser-v4.hir" else: ".hir")

fn hir_cache_header() -> text:
    HIR_CACHE_ENTRY_VERSION + " " + hir_codec_header() + " " + _hir_cache_identity_scope()

# `has` MUST apply the same validity test `hir_cache_load` does. The KEY folds
# source + closure digests, but the HEADER additionally folds
# frontend_parse_cache_scope(), which carries `frontend-exe=<sha256 of the
# compiler binary>`. So rebuilding the seed invalidates every entry WITHOUT
# moving any key: the file is still at hir_cache_path(key), and an
# existence-only `has` reports a hit for content `load` will reject.
#
# That divergence silently disabled the whole HIR shard pre-pass. The shard
# skip at driver_hir_pipeline_lowering.spl:247 reads
#   `if ... or hir_cache_has(key) or not hir_shard_owns(path): continue`
# so every shard treated all 102 modules as already cached and lowered NOTHING,
# while the real build called `hir_cache_load`, failed the header check, and
# re-lowered all 102 serially.
#
# Measured on the live MCP-server build, 2026-09-05 (seed
# src/compiler_rust/target/bootstrap/simple, sha256 c855e1e0763034f3..., rebuilt
# 06:45 between two builds of the same target):
#   [hir-shard] done shard=N/20 lowered=0 claimed=0 levels=10   (x20)
#   [hir-cache] hits=0 misses=102 stores=102                    (real build)
# Reproduced identically in the 02:03 build of the same target. On disk, 114 of
# 216 entries carried a header from a superseded compiler identity.
fn hir_cache_has(key: text, parser_binding: text = "") -> bool:
    if key == "" or not hir_cache_enabled():
        return false
    val path = hir_cache_path(key, parser_binding != "")
    if not file_exists(path):
        return false
    # Validate the whole frame, but retain neither its module nor diagnostics.
    # Preserve any earlier load's warnings before releasing this scratch scope.
    val previous_warnings = _hir_cache_last_warnings
    val previous_parser_objectless = _hir_cache_last_parser_objectless
    if not transient_scope_begin():
        return false
    val valid = hir_cache_load_in_owned_scope(key, parser_binding) != nil
    _hir_cache_last_warnings = previous_warnings
    _hir_cache_last_parser_objectless = previous_parser_objectless
    val ended = transient_scope_end()
    valid and ended

# nil for a miss, a foreign/corrupt entry, or a truncated one: every one of
# those is "lower it in process", and the caller must not need to tell them
# apart.
var _hir_cache_last_parser_objectless: bool = false
fn hir_cache_last_parser_objectless() -> bool: _hir_cache_last_parser_objectless

fn hir_cache_load_parsed_v1(key: text, parser_binding: text, source_path: text = "") -> HirModule?:
    if parser_binding.len() != 64: return nil
    val loaded = hir_cache_load(key, parser_binding)
    if source_path == "" or loaded == nil: return loaded
    # The entry may come from the other route's spelling of this file.
    var module = loaded.unwrap()
    module.path = source_path
    Some(module)

fn hir_cache_parser_binding_v1(key: text, module_name: text, path: text, source_identity: text) -> text:
    if key.len() != 64 or module_name == "" or path == "" or source_identity.len() != 64: return ""
    sha256_text("parser-classification-v1\n" + key + "\n" + module_name + "\n" + sha256_text(module_source_relative_path(path)) + "\n" + source_identity + "\n" + hir_cache_header())

fn hir_cache_load(key: text, parser_binding: text = "") -> HirModule?:
    # Initialize the persistent frontend identity before entering scratch.
    if key == "" or not hir_cache_enabled():
        return nil
    if not transient_scope_begin():
        return nil
    val decoded = hir_cache_load_in_owned_scope(key, parser_binding)
    val paused = transient_scope_pause()
    # A miss has no graph to promote: the runtime correctly rejects nil roots.
    # The owned loader only replaces the persistent warning root on a hit.
    var promoted = true
    if paused and decoded != nil:
        # Cycle-137 REVERT of the cycle-136 deep-promotion block: the
        # runtime's rt_transient_heap_promote is a RECURSIVE plan walker
        # (runtime_native.c:2776) -- RAW structs scan every word for children,
        # DICT nodes walk every occupied entry's key AND value, ARRAY nodes
        # walk elements. The module promote above is therefore already deep;
        # re-promoting the now-persistent nested dicts classifies them as
        # non-transient (class 0, not an immortal string) and FAILS, which
        # tripped the ownership panic. The cycle-134/135 shallow-promotion
        # diagnosis was wrong; the fvals element fault has another cause
        # (next: probe with the dict-index read pattern that mono uses, in
        # place of the .values() chain).
        promoted = transient_promote(decoded) and transient_promote(_hir_cache_last_warnings)
    val ended = transient_scope_end()
    if not paused or not promoted or not ended:
        panic("HIR cache decode scope ownership failed")
    decoded

# HIR shard transactions already own the decode's scratch lifetime. They retain
# only their small diagnostics/receipts, so no full HIR root is promoted here.
fn hir_cache_load_in_owned_scope(key: text, parser_binding: text = "") -> HirModule?:
    if key == "" or not hir_cache_enabled():
        return nil
    val path = hir_cache_path(key, parser_binding != "")
    if not file_exists(path):
        _hir_cache_reject("absent")
        return nil
    val raw = file_read_nullable(path) ?? ""
    val expected_header = if parser_binding != "": "spl-hircache-v4-parser " + hir_cache_header() else: hir_cache_header()
    val entry = hir_cache_entry_parse(raw, expected_header, parser_binding)
    if entry.reason != "":
        _hir_cache_reject(entry.reason)
        return nil
    # A hit decodes ONCE. The stability gate (decode + full re-encode + compare)
    # already ran on the STORE side for every published entry
    # (hir_cache_store_in_owned_scope refuses an unstable frame, or admits its
    # re-encode fixed point under SIMPLE_HIR_CACHE_ADMIT_REENCODE=1), and the
    # checksum above pins the bytes, so re-encoding here re-proved a property
    # the entry could not have lost. Measured 2026-10-19 (Phase 4 full CLI,
    # 2702 hits, 940 MB of entries): ~196 ms per hit, ~9 min serial, with the
    # main build's `[hir-cache] hits=2702 misses=0` reading as a stall.
    # SIMPLE_HIR_CACHE_SELFCHECK=1 / SIMPLE_HIR_CODEC_ROUNDTRIP=1 ("all")
    # keep the load-side roundtrip as an explicit diagnostic.
    val decoded = if hir_cache_load_reencodes_v1(hir_cache_selfcheck_mode()):
        hir_module_decode_stable(entry.blob)
    else:
        hir_module_decode(entry.blob)
    if decoded == nil:
        _hir_cache_reject("decode")
        return nil
    _hir_cache_last_parser_objectless = entry.parser_classification.starts_with("objectless:")
    _hir_cache_last_warnings = entry.warnings
    _hir_cache_hits = _hir_cache_hits + 1
    decoded

# One parsed entry. `reason` is "" when the entry is intact, else one of
# header / checksum / framing (HIR_CACHE_REJECT_REASONS); a rejected entry
# carries no warnings and no blob, so a caller can never decode a partial one.
struct HirCacheEntry:
    reason: text
    warnings: [text]
    blob: text
    parser_classification: text = ""

fn _hir_cache_entry_rejected(reason: text) -> HirCacheEntry:
    HirCacheEntry(reason: reason, warnings: [], blob: "")

# Pure: raw file content -> parsed entry. The line protocol (header, checksum
# line, "W" framing, warnings, blob) is read through the shared typed
# FlatPoolReader cursor in hir_cache_envelope_reader: native inferred text
# offsets may be tagged, so no raw index_of cursor crosses this boundary. This
# function owns the checksum VALUE gate and the rejection classification; the
# reader owns framing and byte preservation. The checksum is checked before
# the framing verdict is trusted, so a truncated or bit-flipped body is
# reported as `checksum`, never as a framing failure of garbage.
fn hir_cache_entry_parse(raw: text, expected_header: text, parser_binding: text = "") -> HirCacheEntry:
    val envelope = hir_cache_envelope_parse(raw, expected_header)
    if envelope.reason == "header":
        return _hir_cache_entry_rejected("header")
    if (envelope.checksum == "" or
            hir_cache_body_checksum(envelope.covered) != envelope.checksum):
        return _hir_cache_entry_rejected("checksum")
    if envelope.reason == "framing":
        return _hir_cache_entry_rejected("framing")
    if parser_binding != "" and (parser_binding.len() != 64 or
            (envelope.parser_classification != "objectless:" + parser_binding and
             envelope.parser_classification != "bodyful:" + parser_binding)):
        return _hir_cache_entry_rejected("framing")
    HirCacheEntry(reason: "", warnings: envelope.warnings, blob: envelope.body,
        parser_classification: envelope.parser_classification)

# Pure: the exact bytes `hir_cache_entry_parse` accepts back, for a given
# header, warning list and codec blob.
fn hir_cache_entry_encode(header: text, warnings: [text], blob: text) -> text:
    header + "\n" + hir_cache_entry_encode_body(warnings, blob)

# Everything after the header line: the checksum line, then the body it covers.
fn hir_cache_entry_encode_body(warnings: [text], blob: text, parser_classification: text = "") -> text:
    var parts: [text] = ["W\n{warnings.len()}\n"]
    for w in warnings:
        parts.push(flat_pool_escape(w) + "\n")
    val prefix = if parser_classification != "": "P\n" + parser_classification + "\n" else: ""
    val body = prefix + parts.join("") + blob
    HIR_CACHE_CHECKSUM_PREFIX + hir_cache_body_checksum(body) + "\n" + body

# sha256 rather than a pure-Simple CRC: sha256_text is runtime-backed
# (rt_tls13_sha256), so it costs microseconds per module under the
# interpreter, where a per-byte CRC loop would cost seconds.
# The one-time note lives here, not in std.common: a build that silently took
# the pure-Simple digest path looks like a ~25% parse-cost regression with
# nothing in the log to explain it.
var _hir_cache_sha_fallback_noted: bool = false

fn hir_cache_body_checksum(body: text) -> text:
    val sum = sha256_text(body)
    if not _hir_cache_sha_fallback_noted and sha256_runtime_fallback_used():
        _hir_cache_sha_fallback_noted = true
        eprint("[hir-cache] runtime sha256 unavailable on this engine; entry checksums use the pure-Simple fallback for this process")
    sum

fn _hir_cache_reject_index(reason: text) -> i64:
    var i = 0
    while i < HIR_CACHE_REJECT_REASONS.len():
        if HIR_CACHE_REJECT_REASONS[i] == reason:
            return i
        i = i + 1
    -1

# A rejection is a MISS plus one named counter. Unknown reasons are counted as
# `decode` rather than dropped: a reason the summary cannot name is still a
# miss the summary must not hide.
fn _hir_cache_reject(reason: text):
    _hir_cache_misses = _hir_cache_misses + 1
    var idx = _hir_cache_reject_index(reason)
    if idx < 0:
        idx = _hir_cache_reject_index("decode")
    _hir_cache_rejected[idx] = _hir_cache_rejected[idx] + 1

fn hir_cache_rejected(reason: text) -> i64:
    val idx = _hir_cache_reject_index(reason)
    if idx < 0: 0 else: _hir_cache_rejected[idx]

fn hir_cache_rejected_summary() -> text:
    var parts: [text] = []
    var i = 0
    while i < HIR_CACHE_REJECT_REASONS.len():
        parts.push(HIR_CACHE_REJECT_REASONS[i] + ":" + "{_hir_cache_rejected[i]}")
        i = i + 1
    parts.join(",")

# The header half of hir_cache_load's validity test, without decoding the body.
# Deliberately placed AFTER hir_cache_load so that load remains the FIRST
# existence -> read -> parse sequence in this file: hir_cache_file_exists_facade_contract_spec
# pins that ordering by source position, and it is a real contract, not an
# accident of layout.
fn _hir_cache_entry_header_valid(path: text) -> bool:
    val raw = file_read_nullable(path) ?? ""
    var reader: FlatPoolReader = FlatPoolReader.new_canonical(raw)
    reader.ok and reader.next() == hir_cache_header()

fn hir_cache_last_warnings() -> [text]:
    _hir_cache_last_warnings

fn hir_cache_clear_last_warnings():
    # Caller pauses its transient scope before replacing this retained root.
    _hir_cache_last_warnings = []

# Retain cache diagnostics for callers that own an enclosing scratch scope.
# Store refusal reasons are process-lived literals; this owner remains part
# of the archive/shard lifetime protocol alongside last_warnings.
fn hir_cache_promote_diagnostic_owner_v1() -> bool:
    transient_promote(_hir_cache_last_reason)

fn hir_cache_store(key: text, module: HirModule, warnings: [text], parser_classification: text = "") -> bool:
    if key == "" or not hir_cache_enabled():
        return false
    # Eligibility initializes the immutable frontend scope memo before scratch
    # ownership begins. Encoding and synchronous publication retain no graph:
    # only the scalar store counter escapes. Do not borrow an enclosing scope.
    if not transient_scope_begin():
        return false
    val stored = hir_cache_store_in_owned_scope(key, module, warnings, parser_classification)
    # Always close, including codec refusal and failed writes/renames. A
    # short-circuit expression here would leak precisely the failure cases.
    val ended = transient_scope_end()
    stored and ended

# Encode a module whose blob is RETAINED by the caller (the Stage-3 validation
# twin, ctx.validation_module_blobs). The encoder's working set -- every
# intermediate text of the canonical walk -- dies with this scope; only the
# finished blob is promoted. Unscoped, that working set was immortal: measured
# on the r11 Stage-2 binary (Stage-3 command, malloc in-use sampled
# synchronously at each memory-snapshot write) the window holding this encode
# kept +56 MB / +294k heap objects per module (5.14 GB after 92 modules, 288 MB
# for a single module) while the blobs themselves average 0.2 MB. Same scope
# discipline as hir_cache_store, which already encodes the same module under
# a scope. When a scope is already live (never on the driver loop), fall back
# to the old unscoped encode rather than borrow someone else's transaction.
fn hir_module_encode_retained_v1(module: HirModule) -> text:
    if not transient_scope_begin():
        return hir_module_encode(module)
    val blob = hir_module_encode(module)
    val paused = transient_scope_pause()
    val promoted = paused and transient_promote(blob)
    val ended = transient_scope_end()
    if not paused or not promoted or not ended:
        panic("HIR validation blob encode scope ownership failed")
    blob

fn hir_cache_store_in_owned_scope(key: text, module: HirModule, warnings: [text], parser_classification: text = "") -> bool:
    _hir_cache_note_store_attempt()
    if parser_classification != "" and
            not hir_cache_parser_record_valid_v1(parser_classification): return false
    var blob = hir_module_encode(module)
    if blob == "":
        _hir_cache_refuse("codec")
        # Name the refused payload once: a bare `codec` count hid that every
        # module was refused for one runtime-probe reason (2026-10-19).
        if not _hir_cache_codec_refusal_noted:
            _hir_cache_note_first_refusal("codec", module.path, hir_module_encode_reason(module))
        return false
    # Publication is an evidence gate, independent of the diagnostic env flag:
    # refuse loss or unstable ordering before creating even a temporary file.
    # This function's caller owns all temporary HIR and writer allocations.
    if _hir_cache_selfcheck_due():
        _hir_cache_selfchecked = _hir_cache_selfchecked + 1
        val verdict = hir_cache_selfcheck_blob(blob)
        if verdict != "":
            # Loud on purpose: this is the diagnostic that was missing for the
            # weeks the codec wrote 3/true as nil. Names the first differing
            # line and field so the codec bug can be found from the log alone.
            # A STORE-side refusal: counted as refused + selfcheck_failed,
            # never as a miss (misses count loads).
            eprint("[hir-cache] SELFCHECK FAILED module={module.name} path={module.path} {verdict}; entry not stored")
            _hir_cache_refuse("selfcheck")
            _hir_cache_selfcheck_failed = _hir_cache_selfcheck_failed + 1
            return false
    elif hir_module_decode_stable(blob) == nil:
        # Same fail-closed gate without the named diagnostic when the knob is
        # not due -- but the stable check collapses two distinct failures
        # (hir_codec.spl: hir_module_decode_stable): a blob the decoder
        # refuses, and a decodable blob whose re-encode differs byte-for-byte
        # (encoder non-determinism). The first can never be cached: a hit
        # could not decode. The second is admitted only under the explicit
        # opt-in SIMPLE_HIR_CACHE_ADMIT_REENCODE=1, and what is published is
        # the re-encode fixed point, so a hit decodes a self-consistent frame
        # (see _hir_cache_admit_reencode_blob_v1).
        if hir_module_decode(blob) == nil:
            _hir_cache_refuse("decode")
            if not _hir_cache_decode_refusal_noted:
                _hir_cache_note_first_refusal("decode", module.path)
            return false
        val admitted = _hir_cache_admit_reencode_blob_v1(module.path, blob)
        if admitted == "":
            _hir_cache_refuse("reencode")
            if not _hir_cache_reencode_refusal_noted:
                _hir_cache_note_first_refusal("reencode", module.path)
            return false
        blob = admitted
    val dir = hir_cache_dir()
    val _made = rt_dir_create_all(dir)
    val final_path = hir_cache_path(key, parser_classification != "")
    val tmp = final_path + ".{rt_getpid()}.tmp"
    val header = if parser_classification != "": "spl-hircache-v4-parser " + hir_cache_header() else: hir_cache_header()
    # @workaround bug=stage2_sanity_module_path_naming_probe_segv_2026_10_22 reason=name_dead_store_content_limb
    # The store write fails (rt_core_string_bytes NULL -> -1) when any limb
    # of the concatenated content is a dead transient handle. Bind each part
    # with wellformed checks so the env-gated trace names the dead limb.
    val body_text: text = hir_cache_entry_encode_body(warnings, blob, parser_classification)
    val content_text: text = header + "\n" + body_text
    if (sosix_env_get_nullable("SIMPLE_NSCOPE_HIR_TRACE") ?? "") == "1":
        eprint("[hir-cache-store] wf_content={rt_heap_ref_wellformed(content_text)} wf_header={rt_heap_ref_wellformed(header)} wf_body={rt_heap_ref_wellformed(body_text)} wf_warnings={rt_heap_ref_wellformed(warnings)} wf_blob={rt_heap_ref_wellformed(blob)}")
        if rt_heap_ref_wellformed(content_text): eprint("[hir-cache-store] content_len={content_text.len()}")
        if rt_heap_ref_wellformed(body_text): eprint("[hir-cache-store] body_len={body_text.len()}")
    if not rt_file_write_text(tmp, content_text):
        # A failed write can leave a partial temp (disk full is the measured
        # case, P-INFRA-3); it was never unlinked and never reported.
        val _partial = rt_file_delete(tmp)
        _hir_cache_note_store_failure("write", "io-write", tmp)
        return false
    if rt_file_move(tmp, final_path):
        _hir_cache_stores = _hir_cache_stores + 1
        return true
    val _cleaned = rt_file_delete(tmp)
    _hir_cache_note_store_failure("rename", "io-rename", final_path)
    false

# A cache that cannot store is a slow build, not a wrong one, so a failed store
# stays non-fatal -- but it is counted, shown in the summary (both as
# `io_failed=`, which the warm receipt parser requires to be 0, and as
# `store_failures=`), and its first occurrence is reported. A codec refusal or
# a failed self-check is not an I/O failure and is counted as `refused=`.
var _hir_cache_store_failures: i64 = 0

fn _hir_cache_note_store_failure(step: text, reason: text, path: text):
    _hir_cache_store_failures = _hir_cache_store_failures + 1
    # Both private callers pass a literal: the native literal owner persists
    # it beyond hir_cache_store's scratch scope. Concatenating here published
    # a transient string that scope_end freed before summary/classification.
    _hir_cache_last_reason = reason
    if _hir_cache_store_failures == 1:
        eprint("[hir-cache] store failed at {step}: {path}; this module will be re-lowered next run (further failures are only counted)\n")

fn hir_cache_store_failures() -> i64:
    _hir_cache_store_failures

# True when the LAST store refusal was an I/O write/rename failure (disk-full
# class: the cache genuinely cannot serve this build). Codec refusals
# (encode reject, selfcheck, decode/reencode roundtrip refusal) are fail-closed EVIDENCE
# gates, not I/O failures: the module is still correct in memory and the
# main build lowers it on the cache miss. Shard lanes use this to treat a
# codec refusal as "not stored" (UNCACHED) instead of a worker failure --
# the store's own contract is "a cache that cannot store is a slow build,
# not a wrong one" (see hir_cache_store_in_owned_scope).
fn hir_cache_last_refusal_is_io_v1() -> bool:
    val r: text = _hir_cache_last_reason
    r == "io-write" or r == "io-rename"

fn _hir_cache_refuse(reason: text):
    _hir_cache_refused = _hir_cache_refused + 1
    _hir_cache_last_reason = reason

# Store-rate visibility. The summary prints only at the END of a build, and a
# Stage 3 run that is killed in HIR never reaches it, so `codec` and
# `unstable` refusals (7 of every 8 under sampled self-check) were invisible:
# 771 lowered modules left 25 entries with 6 log lines. Each refusal class
# names its first module once, and every HIR_CACHE_STORE_RATE_EVERY-th
# attempt prints the running rate; attempts - stored - refused - io_failed
# is any remaining silent skip.
val HIR_CACHE_STORE_RATE_EVERY: i64 = 64
var _hir_cache_store_attempts: i64 = 0
var _hir_cache_codec_refusal_noted: bool = false
var _hir_cache_decode_refusal_noted: bool = false
var _hir_cache_reencode_refusal_noted: bool = false
var _hir_cache_admission_noted: bool = false

# Prints BEFORE counting the new attempt, so every printed attempt has
# finished and attempts - stored - refused - io_failed is exact.
fn _hir_cache_note_store_attempt():
    if _hir_cache_store_attempts > 0 and
            _hir_cache_store_attempts % HIR_CACHE_STORE_RATE_EVERY == 0:
        val attempts = _hir_cache_store_attempts
        val stored = _hir_cache_stores
        val refused = _hir_cache_refused
        val failures = _hir_cache_store_failures
        eprint("[hir-cache-store] rate attempts={attempts} stored={stored} refused={refused} io_failed={failures}")
    _hir_cache_store_attempts = _hir_cache_store_attempts + 1

fn _hir_cache_note_first_refusal(reason: text, path: text, detail: text = ""):
    if reason == "codec":
        if _hir_cache_codec_refusal_noted: return
        _hir_cache_codec_refusal_noted = true
    elif reason == "decode":
        if _hir_cache_decode_refusal_noted: return
        _hir_cache_decode_refusal_noted = true
    elif reason == "reencode":
        if _hir_cache_reencode_refusal_noted: return
        _hir_cache_reencode_refusal_noted = true
    val detail_part = if detail != "": " detail={detail}" else: ""
    eprint("[hir-cache-store] refused reason={reason}{detail_part} module={path}; entry not stored (further {reason} refusals are only counted)")

# Opt-in admission for a decodable-but-not-byte-stable frame (the store
# refusal formerly reported only as reason=unstable once its decode step is
# proven OK). What is published is the re-encode fixed point
# blob2 = encode(decode(blob)) with encode(decode(blob2)) == blob2 verified,
# so a cache hit decodes a self-consistent frame and every downstream
# re-encode of the hit (validation twins, shard receipts) reproduces the
# stored bytes instead of a fresh permutation. Off by default: the fixed-
# point check proves consistency, not that decode is lossless, so caching
# these frames stays an explicit operator decision
# (SIMPLE_HIR_CACHE_ADMIT_REENCODE=1). Returns "" when not admitted or when
# no fixed point exists; else the blob to publish.
fn _hir_cache_admit_reencode_blob_v1(path: text, blob: text) -> text:
    if (sosix_env_get_nullable("SIMPLE_HIR_CACHE_ADMIT_REENCODE") ?? "") != "1":
        return ""
    val decoded = hir_module_decode(blob)
    if decoded == nil:
        return ""
    val fixed = hir_module_encode(decoded.unwrap())
    if fixed == "":
        return ""
    if hir_module_decode_stable(fixed) == nil:
        return ""
    if not _hir_cache_admission_noted:
        _hir_cache_admission_noted = true
        eprint("[hir-cache-store] admitted reason=reencode module={path}; published re-encode fixed point (SIMPLE_HIR_CACHE_ADMIT_REENCODE=1; further admissions are only counted in stores=)")
    fixed

# Write-time round-trip self-check knob -> mode "all" | "sampled" | "off".
# SIMPLE_HIR_CACHE_SELFCHECK=1 checks every store, =0 never; the host-config
# key hir_cache_selfcheck is applied to that env by host-env.shs --cache-env.
# Unset: SIMPLE_HIR_CODEC_ROUNDTRIP=1 (the pre-existing build-continues-from-
# decoded probe) means "all"; a bootstrap lane (SIMPLE_BOOTSTRAP set) gets
# "sampled" -- every HIR_CACHE_SELFCHECK_SAMPLE-th store -- because a full
# decode+re-encode per module is unmeasured on the 1163-module closure and
# must not be switched on blind; anything else is "off". The lane env is NOT
# extended with this variable: the stage-2 pre-exec guard requires the exact
# canonical env name list and the producer fingerprint folds every SIMPLE_*.
val HIR_CACHE_SELFCHECK_SAMPLE: i64 = 8

fn hir_cache_selfcheck_mode() -> text:
    val explicit = sosix_env_get_nullable("SIMPLE_HIR_CACHE_SELFCHECK") ?? ""
    if explicit == "1":
        return "all"
    if explicit == "0":
        return "off"
    if (sosix_env_get_nullable("SIMPLE_HIR_CODEC_ROUNDTRIP") ?? "") == "1":
        return "all"
    if (sosix_env_get_nullable("SIMPLE_BOOTSTRAP") ?? "") != "":
        return "sampled"
    "off"

fn hir_cache_selfcheck_enabled() -> bool:
    hir_cache_selfcheck_mode() != "off"

# Pure: whether a cache LOAD re-encodes the decoded module and compares it to
# the stored blob. Only the explicit "all" mode does; "off" and the bootstrap
# default "sampled" trust the store-side gate plus the checksum.
fn hir_cache_load_reencodes_v1(selfcheck_mode: text) -> bool:
    selfcheck_mode == "all"

# Pure: the main build's adoption receipt. `adopted` is the number of modules
# whose HIR came from the shard pre-pass (cache hits), `lowered` the number
# it had to lower itself (misses). Printed under the `[hir-cache]` tag right
# BEFORE hir_cache_summary(), which must stay the last `[hir-cache]` line
# (native_build_warm_receipt reads the last tagged line's fields).
fn hir_cache_adoption_receipt_v1(adopted: i64, lowered: i64) -> text:
    "[hir-cache] adopted={adopted} lowered={lowered}"

var _hir_cache_selfcheck_seen: i64 = 0
var _hir_cache_selfchecked: i64 = 0
var _hir_cache_selfcheck_failed: i64 = 0

fn _hir_cache_selfcheck_due() -> bool:
    val mode = hir_cache_selfcheck_mode()
    if mode == "off":
        return false
    if mode == "all":
        return true
    _hir_cache_selfcheck_seen = _hir_cache_selfcheck_seen + 1
    (_hir_cache_selfcheck_seen % HIR_CACHE_SELFCHECK_SAMPLE) == 1

fn hir_cache_selfchecked() -> i64:
    _hir_cache_selfchecked

fn hir_cache_selfcheck_failed() -> i64:
    _hir_cache_selfcheck_failed

# Pure: "" when `blob` decodes and re-encodes to itself, else a diagnostic
# naming the failure: `reason=decode` for a blob the decoder refuses, or
# `reason=reencode line=<n> field=<m> expected=<tok> got=<tok>` for the first
# differing tab-separated field of the first differing line.
fn hir_cache_selfcheck_blob(blob: text) -> text:
    val decoded = hir_module_decode(blob)
    if decoded == nil:
        return "reason=decode bytes={blob.len()} cause={hir_module_decode_reason(blob)}"
    val again = hir_module_encode(decoded.unwrap())
    if again == blob:
        return ""
    "reason=reencode " + hir_cache_first_difference(blob, again)

fn hir_cache_first_difference(expected: text, got: text) -> text:
    val a = expected.split("\n")
    val b = got.split("\n")
    var line = 0
    while line < a.len() or line < b.len():
        val la = if line < a.len(): a[line] else: ""
        val lb = if line < b.len(): b[line] else: ""
        if la != lb:
            val fa = la.split("\t")
            val fb = lb.split("\t")
            var field = 0
            while field < fa.len() or field < fb.len():
                val xa = if field < fa.len(): fa[field] else: "<missing>"
                val xb = if field < fb.len(): fb[field] else: "<missing>"
                if xa != xb:
                    return "line={line + 1} field={field + 1} expected={_hir_cache_token(xa)} got={_hir_cache_token(xb)}"
                field = field + 1
            return "line={line + 1} field=? expected_fields={fa.len()} got_fields={fb.len()}"
        line = line + 1
    "line=? (equal lines, different length {expected.len()} vs {got.len()})"

fn _hir_cache_token(t: text) -> text:
    if t.len() > 48: t.substring(0, 48) + "..." else: t

fn hir_cache_hits() -> i64:
    _hir_cache_hits

fn hir_cache_misses() -> i64:
    _hir_cache_misses

fn hir_cache_stores() -> i64:
    _hir_cache_stores

fn hir_cache_refused() -> i64:
    _hir_cache_refused

fn hir_cache_io_failed() -> i64:
    _hir_cache_store_failures

# Printed at the end of EVERY build (driver_hir_pipeline_lowering), enabled or
# not, so a build log can never be silent about the cache. The field set
# `hits misses stores refused io_failed reason dir` is what
# native_build_warm_receipt.native_build_warm_output_complete parses (it
# requires refused==0 and io_failed==0, so a summary without them can never
# complete a warm receipt); `rejected=` breaks misses down by class.
fn hir_cache_summary() -> text:
    if not hir_cache_enabled():
        val why = if (sosix_env_get_nullable("SIMPLE_HIR_CACHE") ?? "") == "0": "off" else: "no-compiler-scope"
        return "[hir-cache] disabled reason={why}"
    # Counters are read into locals BEFORE any nested call: under the
    # interpreter a nested call can restore a stale global snapshot (same
    # rule spec.spl applies to its tallies), which printed io_failed=0 beside
    # a hir_cache_store_failures() of 1.
    val hits = _hir_cache_hits
    val misses = _hir_cache_misses
    val stores = _hir_cache_stores
    val refused = _hir_cache_refused
    val failures = _hir_cache_store_failures
    val reason = _hir_cache_last_reason
    val selfchecked = _hir_cache_selfchecked
    val selfcheck_failed = _hir_cache_selfcheck_failed
    val dir = hir_cache_dir()
    val rejected = hir_cache_rejected_summary()
    val selfcheck = hir_cache_selfcheck_mode()
    val base = "[hir-cache] hits={hits} misses={misses} stores={stores} refused={refused} io_failed={failures} reason={reason} dir={dir} rejected={rejected} selfcheck={selfcheck} selfchecked={selfchecked} selfcheck_failed={selfcheck_failed}"
    if failures == 0:
        return base
    base + " store_failures={failures}"

# ===== HIR sharding ==========================================================
#
# SIMPLE_HIR_SHARD="<index>/<count>" (from --hir-shard=, which only the
# orchestrator in native_build_main.spl passes). A shard child runs the real
# pipeline up to and including HIR, lowers ONLY the modules it claims, stores
# each into this cache, and exits before typecheck. The real build that
# follows hits every entry. Same mechanism as the parse shards (work queue =
# flock'd marker dir published as SIMPLE_HIR_SHARD_QUEUE; static path-hash
# split when no queue is published or the lock fails).
#
# DEPENDENCY LEVELS. Lowering reads only the FROZEN surfaces (every child
# rebuilds them from front-end cache hits), so no module's HIR is an input to
# another's and no barrier between levels is needed for correctness. The
# shards still CLAIM in topological level order of the import graph (Kahn
# over ModuleSurface.import_target_indices; a cycle's members share the level
# after everything they depend on) so the claim sequence is the one a
# level-barriered scheduler would use, and the receipt names the level count.
# Output is unchanged by construction: a claimed module is lowered by exactly
# one shard into the same content-keyed entry the sequential build would
# store, and an unclaimed one is lowered by the real build.

var _hir_shard_memo: text = "@@unset@@"
var _hir_shard_queue_memo: text = "@@unset@@"
var _hir_shard_claimed: i64 = 0

fn hir_shard_owner() -> text:
    sosix_env_get_nullable("SIMPLE_HIR_SHARD_OWNER") ?? hir_shard_spec()

fn hir_shard_begin(path: text, key: text) -> i64:
    # P5: a worker whose surfaces cover only its seeds' import closure never
    # claims a module outside it (driver_worker_surface_closure_v1.spl).
    if not worker_surface_claim_allowed_v1(path): return 0
    val queue = _hir_shard_queue_dir()
    if queue == "":
        return if hir_shard_owns(path): 1 else: 0
    if hir_shard_recovery_blocked(queue): return -1
    # File-worker HIR child (driver_build/native_file_worker_v1.spl): stop
    # claiming after SIMPLE_HIR_SHARD_CLAIM_LIMIT modules; the rest stay
    # unclaimed for the next round or another worker. Unset/<=0 = no limit.
    val claim_limit = (sosix_env_get_nullable("SIMPLE_HIR_SHARD_CLAIM_LIMIT") ?? "").to_i64() ?? 0
    if claim_limit > 0 and _hir_shard_claimed >= claim_limit: return 0
    val claimed = hir_shard_recovery_claim(queue, hir_shard_owner(), path, key)
    if claimed > 0:
        _hir_shard_claimed = _hir_shard_claimed + 1
    claimed

fn hir_shard_finish(path: text, state: text, cache_stored: bool) -> bool:
    if not hir_shard_active() or _hir_shard_queue_dir() == "": return true
    hir_shard_recovery_terminal(_hir_shard_queue_dir(), hir_shard_owner(), path, state, cache_stored)

# File-worker P4: deps records are written only when a file worker drives
# this HIR child (its hir ledger env is set), unless SIMPLE_BOOTSTRAP_WHOLE_PROGRAM=1.
fn hir_shard_deps_wanted_v1() -> bool:
    hir_shard_active() and _hir_shard_queue_dir() != "" and
        mono_module_scoped_selected_v1(sosix_env_get_nullable("SIMPLE_BOOTSTRAP_WHOLE_PROGRAM") ?? "",
            (sosix_env_get_nullable("SIMPLE_FILE_WORKER_HIR_QUEUE") ?? "") != "")

fn hir_shard_publish_deps_v1(path: text, deps: [text]) -> bool:
    native_file_worker_deps_publish_v1(_hir_shard_queue_dir(), path, deps)

# P-G5b: the module's HIR cache key, so a MIR child can load this module's
# body by content identity (template-body seam).
fn hir_shard_publish_hirkey_v1(path: text, key: text) -> bool:
    native_file_worker_hirkey_publish_v1(_hir_shard_queue_dir(), path, key)

fn hir_shard_complete() -> bool:
    if _hir_shard_queue_dir() == "": return true
    hir_shard_recovery_complete(_hir_shard_queue_dir(), hir_shard_owner())

fn hir_shard_inventory(identity: text, paths: [text]) -> bool:
    if not hir_shard_active() or _hir_shard_queue_dir() == "": return true
    hir_shard_recovery_inventory(_hir_shard_queue_dir(), identity, paths)

fn hir_shard_guard_block(reason: text):
    if hir_shard_active() and _hir_shard_queue_dir() != "":
        val _blocked = hir_shard_recovery_block(_hir_shard_queue_dir(), reason)

fn hir_shard_spec() -> text:
    if _hir_shard_memo != "@@unset@@":
        return _hir_shard_memo
    _hir_shard_memo = sosix_env_get_nullable("SIMPLE_HIR_SHARD") ?? ""
    _hir_shard_memo

fn hir_shard_active() -> bool:
    hir_shard_spec() != ""

fn hir_shard_claimed() -> i64:
    _hir_shard_claimed

fn _hir_shard_queue_dir() -> text:
    if _hir_shard_queue_memo != "@@unset@@":
        return _hir_shard_queue_memo
    _hir_shard_queue_memo = sosix_env_get_nullable("SIMPLE_HIR_SHARD_QUEUE") ?? ""
    _hir_shard_queue_memo

# A malformed spec owns EVERYTHING (same fail-closed rule as the parse shard:
# a shard that silently owns nothing looks like a fast success).
fn _hir_shard_owns_static(path: text) -> bool:
    val spec = hir_shard_spec()
    val slash = spec.index_of("/")
    if slash <= 0:
        return true
    val index = spec.substring(0, slash).to_i64() ?? -1
    val count = spec.substring(slash + 1, spec.len()).to_i64() ?? 0
    if count <= 0 or index < 0 or index >= count:
        return true
    (driver_parse_shard_hash(path) % count) == index

# _hir_shard_claimed is what the `claimed=` field of the receipt reports, so it
# must be incremented on EVERY path that takes ownership, not just the queue
# one. Before this, both static-split fallbacks returned true without counting,
# so a shard that legitimately owned modules still printed `claimed=0` — the
# receipt could not distinguish "owned nothing" from "owned but never counted",
# which is exactly the ambiguity a receipt exists to remove.
fn _hir_shard_owns_static_counted(path: text) -> bool:
    val owned = _hir_shard_owns_static(path)
    if owned:
        _hir_shard_claimed = _hir_shard_claimed + 1
    owned

fn hir_shard_owns(path: text) -> bool:
    if not hir_shard_active():
        return true
    val queue_dir = _hir_shard_queue_dir()
    if queue_dir == "":
        return _hir_shard_owns_static_counted(path)
    val marker = "{queue_dir}/{driver_parse_shard_hash(path)}-{path.len()}.claim"
    if file_exists(marker):
        return false
    val fd = file_lock("{queue_dir}/.lock", 30)
    if fd < 0:
        return _hir_shard_owns_static_counted(path)
    var claimed = false
    if not file_exists(marker):
        claimed = file_write(marker, hir_shard_spec())
    val _unlocked = file_unlock(fd)
    if claimed:
        _hir_shard_claimed = _hir_shard_claimed + 1
    claimed

# Topological level of every surface (index-aligned with surfaces.surfaces).
fn hir_shard_levels(surfaces: ModuleSurfacesByName) -> [i64]:
    val n = surfaces.surfaces.len()
    var level: [i64] = []
    var indeg: [i64] = []
    var i = 0
    while i < n:
        level.push(-1)
        var d = 0
        for t in surfaces.surfaces[i].import_target_indices:
            if t >= 0 and t < n and t != i:
                d = d + 1
        indeg.push(d)
        i = i + 1
    var current = 0
    var assigned = 0
    while assigned < n:
        var frontier: [i64] = []
        i = 0
        while i < n:
            if level[i] < 0 and indeg[i] == 0:
                frontier.push(i)
            i = i + 1
        if frontier.len() == 0:
            # Only cycles remain: they all depend on something already levelled
            # (or on each other), so they share the next level.
            i = 0
            while i < n:
                if level[i] < 0:
                    level[i] = current
                    assigned = assigned + 1
                i = i + 1
            break
        for f in frontier:
            level[f] = current
            assigned = assigned + 1
        # Release the importers of this level.
        i = 0
        while i < n:
            if level[i] < 0:
                var d = 0
                for t in surfaces.surfaces[i].import_target_indices:
                    if t >= 0 and t < n and t != i and level[t] < 0:
                        d = d + 1
                indeg[i] = d
            i = i + 1
        current = current + 1
    level

# Source indices in (level, source index) order; a source with no surface
# alias goes after every levelled one. Identity order when levels is empty.
fn hir_shard_visit_order(names: [text], surfaces: ModuleSurfacesByName, levels: [i64]) -> [i64]:
    var order: [i64] = []
    if levels.len() == 0:
        var idx = 0
        while idx < names.len():
            order.push(idx)
            idx = idx + 1
        return order
    val level_count = hir_shard_level_count(levels)
    var level = 0
    while level <= level_count:
        var idx = 0
        while idx < names.len():
            var source_level = level_count
            if surfaces.index_by_name.contains_key(names[idx]):
                val surface_idx = surfaces.index_by_name[names[idx]]
                if surface_idx >= 0 and surface_idx < levels.len():
                    source_level = levels[surface_idx]
            if source_level == level:
                order.push(idx)
            idx = idx + 1
        level = level + 1
    order

fn hir_shard_level_count(levels: [i64]) -> i64:
    var top = -1
    for l in levels:
        if l > top:
            top = l
    top + 1

fn hir_shard_summary(levels: i64, lowered: i64) -> text:
    "[hir-shard] done shard={hir_shard_spec()} lowered={lowered} claimed={_hir_shard_claimed} levels={levels} {worker_surface_counters_v1()}"

