# Project Context
#
# Project detection and context management for multi-file compilation.
# Loads configuration from simple.sdn/simple.toml, resolves modules,
# and manages features, profiles, and lint/DI/AOP settings.
#
# Port of rust/compiler/src/project.rs (521 lines)

use std.sffi.io*
use std.common.sdn.parser (parse)
use std.common.sdn.value.{SdnValue}

# HOISTED (2026-08-21): these were FUNCTION-LOCAL `use` lines. The parser
# DISCARDS function-local `use` outright (10.frontend/core/parser_stmts.spl ->
# parse_use_stmt_inline returns a bare `pass`), so the names were never bound
# and every use site depended on the HIR lowering's lazy bootstrap-global
# fallback -- the exact asymmetry documented as the `unresolved type: ByteOrder`
# case in 20.hir/hir_lowering/_Items/module_import_registration.spl. None of the
# hoisted modules imports back, so there is no cycle to avoid.
use std.nogc_sync_mut.io.file_ops.{file_read}


# ============================================================================
# SDN manifest field accessors
# ============================================================================
#
# All of these are total: a missing key, a wrong node type or a scalar that is
# not the requested type yields the caller-supplied fallback rather than an
# error, so a partially-populated manifest degrades to defaults key by key.
#
# SdnValue.get (value.spl:139) already uses contains_key + index read rather
# than Dict.get, so these are safe against the native-codegen dict defect
# (.claude/rules/code-style.md). Nothing here calls Dict.len().

# Read a scalar as text. Ints/bools are stringified so `version: 3` and
# `version: "3"` behave the same.
fn _sdn_text_at(root: SdnValue, path: text) -> text:
    match root.get_path(path):
        case Some(v):
            match v.as_str():
                case Some(s): s
                case None:
                    match v.as_i64():
                        case Some(i): i.to_text()
                        case None:
                            match v.as_bool():
                                case Some(b): if b: "true" else: "false"
                                case None: ""
        case None: ""

# First non-empty of two candidate paths (nested form wins over the flat one).
fn _sdn_first_text(root: SdnValue, primary: text, fallback: text) -> text:
    val first = _sdn_text_at(root, primary)
    if first != "":
        return first
    _sdn_text_at(root, fallback)

# Read a bool, accepting the SDN literal and the "true"/"false" spellings.
fn _sdn_flag(root: SdnValue, path: text, fallback: bool) -> bool:
    match root.get_path(path):
        case Some(v):
            match v.as_bool():
                case Some(b): b
                case None:
                    val s = v.as_str() ?? ""
                    if s == "true":
                        true
                    elif s == "false":
                        false
                    else:
                        fallback
        case None: fallback

# Read an array of scalars as [text]. A bare scalar is treated as a 1-element
# list so `features: net` and `features: [net]` agree.
fn _sdn_text_list(root: SdnValue, path: text) -> [text]:
    match root.get_path(path):
        case Some(v):
            match v.as_array():
                case Some(items):
                    var out: [text] = []
                    for item in items:
                        val s = item.as_str() ?? ""
                        if s != "":
                            out = out.push(s)
                    out
                case None:
                    val single = v.as_str() ?? ""
                    if single != "": [single] else: []
        case None: []


# ============================================================================
# Project Configuration
# ============================================================================

struct ProjectConfig:
    """Configuration loaded from simple.sdn or simple.toml."""
    name: text
    version: text
    source_root: text
    features: [text]
    profiles: {text: ProfileConfig}
    lint_overrides: {text: text}    # lint_name -> level
    di_enabled: bool
    aop_enabled: bool
    deterministic: bool
    layout_config_path: text?

struct ProfileConfig:
    attributes: [text]
    imports: [text]

impl ProjectConfig:
    static fn default(name: text) -> ProjectConfig:
        ProjectConfig(name: name, version: "0.0.0", source_root: "src",
                      features: [], profiles: {}, lint_overrides: {},
                      di_enabled: false, aop_enabled: false,
                      deterministic: false, layout_config_path: nil)

# ============================================================================
# Project Context
# ============================================================================

class ProjectContext:
    """Holds all project-level configuration for compilation."""
    root: text
    source_root: text
    name: text
    features: [text]
    profiles: {text: ProfileConfig}
    lint_overrides: {text: text}
    di_enabled: bool
    aop_enabled: bool
    deterministic: bool
    active_profile: text?

impl ProjectContext:
    static fn from_root(root: text) -> ProjectContext:
        """Create project context, loading config if available."""
        val sdn_path = "{root}/simple.sdn"
        val toml_path = "{root}/simple.toml"

        if file_exists(sdn_path):
            return ProjectContext.load_from_sdn(root, sdn_path)
        elif file_exists(toml_path):
            return ProjectContext.load_from_toml(root, toml_path)
        else:
            return ProjectContext.with_defaults(root)

    static fn with_defaults(root: text) -> ProjectContext:
        val source_root = if file_exists("{root}/src"): "{root}/src" else: root
        val root_parts = root.split("/")
        val name = if root_parts.len() > 0: root_parts[root_parts.len() - 1] else: "unnamed"

        ProjectContext(root: root, source_root: source_root, name: name,
                       features: [], profiles: {}, lint_overrides: {},
                       di_enabled: false, aop_enabled: false,
                       deterministic: false, active_profile: nil)

    static fn load_from_sdn(root: text, path: text) -> ProjectContext:
        """Load a project manifest in the canonical SDN indent/colon form.

        Recognised shape (the form documented in
        doc/06_spec/system/compiler/modules/tooling/formatting_lints.md:345,:438
        and used by real manifests such as src/lib/simple.sdn:4):

            project:
              name: my_project
              version: 0.1.0
              source_root: src
            features: [a, b]
            lints:
              profile: critical
              stub_impl: deny

        A missing key keeps the with_defaults() value for that field, so a
        manifest that pins nothing behaves exactly as no manifest at all. A
        parse error falls back to defaults wholesale.

        The TOML-ish `[lints] profile = "x"` shape is NOT accepted: it was never
        present in any manifest in the tree (aerospace hardening plan, premise
        4), so there is nothing to stay compatible with.
        """
        match parse(file_read(path)):
            case Ok(sdn_value):
                var ctx = ProjectContext.with_defaults(root)

                # --- project.* (also accepted at the top level) -------------
                val name = _sdn_first_text(sdn_value, "project.name", "name")
                if name != "":
                    ctx.name = name
                val src_rel = _sdn_first_text(sdn_value, "project.source_root", "source_root")
                if src_rel != "":
                    ctx.source_root = if src_rel.starts_with("/"): src_rel else: "{root}/{src_rel}"

                # --- features -----------------------------------------------
                ctx.features = _sdn_text_list(sdn_value, "features")

                # --- flags ---------------------------------------------------
                ctx.di_enabled = _sdn_flag(sdn_value, "di", false)
                ctx.aop_enabled = _sdn_flag(sdn_value, "aop", false)
                ctx.deterministic = _sdn_flag(sdn_value, "deterministic", false)

                # --- lints.* --------------------------------------------------
                # Every key under `lints:` other than `profile` is a lint-name
                # -> level override. The level table itself is NOT validated
                # here: profile/level name tables live in 90.tools/lint and the
                # driver must not depend upward on them (see
                # driver_safety_severity.spl:4-22). Validation is the consumer's
                # job; unifying the tables is WP-3.
                match sdn_value.get_path("lints"):
                    case Some(lints):
                        match lints.as_dict():
                            case Some(d):
                                for key in d.keys():
                                    val entry = d[key]
                                    val text_value = entry.as_str() ?? ""
                                    if key == "profile":
                                        if text_value != "":
                                            ctx.set_active_profile(text_value)
                                    elif key == "default_level":
                                        # Section-wide default, not a lint name.
                                        ()
                                    elif text_value != "":
                                        ctx.lint_overrides[key] = text_value
                            case None:
                                ()
                    case None:
                        ()
                ctx
            case Err(error):
                # Parse error - fall back to defaults
                ProjectContext.with_defaults(root)

    static fn load_from_toml(root: text, path: text) -> ProjectContext:
        # Parse TOML manifest - legacy support (Phase 1B.2 - TODO #181 ✅)
        # Use the minimal TOML parser from blocks/utils.spl
        # Import file_read from the light std module, NOT the heavy app.io hub
        # (which drags the full app graph into the compiler driver and breaks
        # `bin/simple run` of the driver — run-mode large-graph trap).

        val content = file_read(path)
        if content.len() == 0:
            return ProjectContext.with_defaults(root)

        # Basic TOML parsing - key=value pairs
        var config = {}
        val lines = content.split("\n")

        for line in lines:
            val trimmed = line.trim()
            if trimmed.len() == 0 or trimmed.starts_with("#") or trimmed.starts_with("["):
                ()  # Skip empty, comments, sections
            else:
                if trimmed.contains("="):
                    val parts = trimmed.split("=")
                    if parts.len() >= 2:
                        val key = parts[0].trim()
                        val value = parts[1].trim().replace("\"", "")
                        config[key] = value

        # Extract name if present
        val name = config.get("name") ?? root
        ProjectContext.with_defaults(root)

    fn has_feature(name: text) -> bool:
        self.features.contains(name)

    fn get_profile(name: text) -> ProfileConfig?:
        if self.profiles.has(name):
            Some(self.profiles[name])
        else:
            nil

    me set_active_profile(name: text):
        self.active_profile = Some(name)

    fn resolve_module(module_path: text) -> text?:
        """Resolve a module import path to a file path.

        Supports numbered directory prefixes (NN.name/ pattern).
        For example, compiler.frontend.X resolves through 10.frontend/.
        """
        val parts = module_path.split(".")
        val rel_path = parts.join("/")

        # Try .spl extension first (direct path)
        val spl_path = "{self.source_root}/{rel_path}.spl"
        if file_exists(spl_path):
            return Some(spl_path)

        # Try __init__.spl in directory (direct path)
        val init_path = "{self.source_root}/{rel_path}/__init__.spl"
        if file_exists(init_path):
            return Some(init_path)

        # Try numbered directory fallback
        # Walk segments, resolving each with NN. prefix stripping
        var current = self.source_root
        var i: i64 = 0
        for part in parts:
            val direct = "{current}/{part}"
            if file_exists(direct) or dir_exists(direct):
                current = direct
            else:
                # Scan for NN.part pattern
                val numbered = self._find_numbered_dir(current, part)
                if numbered.?:
                    current = numbered ?? current
                else:
                    return nil
            i = i + 1

        # Check if final resolved path is a file or directory
        if file_exists("{current}.spl"):
            return Some("{current}.spl")
        val final_init = "{current}/__init__.spl"
        if file_exists(final_init):
            return Some(final_init)
        nil

    fn _find_numbered_dir(parent: text, segment: text) -> text?:
        """Find a numbered directory matching segment in parent."""
        val entries = dir_list(parent)
        for entry in entries:
            val dot_pos = entry.index_of(".")
            if dot_pos.?:
                val idx = dot_pos ?? 0
                if idx >= 1 and idx <= 3:
                    val prefix = entry.substring(0, idx)
                    var all_digits = true
                    for ch in prefix:
                        if ch < "0" or ch > "9":
                            all_digits = false
                    if all_digits:
                        val name = entry.substring(idx + 1)
                        if name == segment:
                            val full_path = "{parent}/{entry}"
                            if dir_exists(full_path):
                                return Some(full_path)
        nil

    fn source_files() -> [text]:
        """List all source files in the project."""
        list_dir_recursive(self.source_root, ".spl")
