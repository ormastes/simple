# Convert an admitted aspect-pack SourceFile descriptor into process-local HIR
# symbol maps. The descriptor values are authority; HIR is used only to bind
# canonical manifest names to this compilation's SymbolId values.

use compiler.common.driver_core_types.{SourceFile}
use std.common.aspect_pack.{apk_facet_manifest_descriptor_digest_v1}
use compiler.hir.hir_types.{HirModule, HirType, HirTypeKind, SymbolId}
use compiler.common.diagnostics.span.{Span}
use compiler.semantics.facet_resolution.{ManifestSealAuthority}

fn facet_manifest_canonical_name(module_id: text, local_name: text) -> text:
    module_id + "." + local_name

fn facet_manifest_named_type(symbol: SymbolId) -> HirType:
    HirType(kind: HirTypeKind.Named(symbol, []), span: Span.empty())

fn facet_manifest_symbol(module: HirModule, canonical_name: text) -> SymbolId?:
    for item in module.classes.values():
        if facet_manifest_canonical_name(module.name, item.name) == canonical_name:
            return Some(item.symbol)
    for item in module.structs.values():
        if facet_manifest_canonical_name(module.name, item.name) == canonical_name:
            return Some(item.symbol)
    for item in module.enums.values():
        if facet_manifest_canonical_name(module.name, item.name) == canonical_name:
            return Some(item.symbol)
    for item in module.traits.values():
        if facet_manifest_canonical_name(module.name, item.name) == canonical_name:
            return Some(item.symbol)
    for item in module.facet_interfaces:
        if facet_manifest_canonical_name(module.name, item.name) == canonical_name:
            return Some(item.symbol)
    for item in module.facet_impls:
        if facet_manifest_canonical_name(module.name, item.name) == canonical_name:
            return Some(item.symbol)
    nil

fn facet_manifest_interface_symbol(module: HirModule,
        canonical_name: text) -> SymbolId?:
    for item in module.facet_interfaces:
        if facet_manifest_canonical_name(module.name, item.name) == canonical_name:
            return Some(item.symbol)
    nil

fn facet_manifest_impl_symbol(module: HirModule,
        canonical_name: text) -> SymbolId?:
    for item in module.facet_impls:
        if facet_manifest_canonical_name(module.name, item.name) == canonical_name:
            return Some(item.symbol)
    nil

pub fn facet_manifest_authority_from_source(source: SourceFile,
        module: HirModule) -> Result<ManifestSealAuthority, text>:
    """Bind an immutable schema-v3 descriptor to one lowered HIR module."""
    if source.module_name != module.name or source.aspect_id == "" or
            source.aspect_version <= 0 or source.descriptor_digest == "" or
            source.facet_manifest == nil:
        return Err("E-FACET004: typed facet module lacks admitted manifest authority")
    val descriptor = source.facet_manifest.unwrap()
    if descriptor.authority_id == "" or descriptor.signature_digest == "":
        return Err("E-FACET004: facet manifest authority identity is incomplete")
    val corroborated_digest = apk_facet_manifest_descriptor_digest_v1(descriptor)
    if corroborated_digest.is_err() or
            corroborated_digest.unwrap() != source.descriptor_digest:
        return Err("E-FACET004: facet manifest descriptor digest is not corroborated")

    var names: Dict<i64, text> = {}
    var types: Dict<text, HirType> = {}
    var concrete_ids: Dict<i64, text> = {}
    for row in descriptor.types:
        val symbol = facet_manifest_symbol(module, row.canonical_type_name)
        if symbol == nil:
            return Err("E-FACET004: manifest concrete type is absent from HIR: " +
                row.canonical_type_name)
        val id = symbol.unwrap().id
        if names.contains_key(id):
            return Err("E-FACET005: manifest type maps twice to one HIR symbol")
        names[id] = row.canonical_type_name
        types[row.canonical_type_name] = facet_manifest_named_type(symbol.unwrap())
        concrete_ids[id] = row.concrete_type_id

    var interface_ids: Dict<i64, text> = {}
    var interface_abis: Dict<i64, text> = {}
    var interface_symbol_by_id: Dict<text, i64> = {}
    for row in descriptor.interfaces:
        val symbol = facet_manifest_interface_symbol(module, row.canonical_type_name)
        if symbol == nil:
            return Err("E-FACET004: manifest facet interface is absent from HIR: " +
                row.canonical_type_name)
        val id = symbol.unwrap().id
        names[id] = row.canonical_type_name
        types[row.canonical_type_name] = facet_manifest_named_type(symbol.unwrap())
        interface_ids[id] = row.interface_id
        interface_abis[id] = row.interface_abi_hash
        interface_symbol_by_id[row.interface_id] = id

    var method_ids: Dict<i64, text> = {}
    var method_signatures: Dict<i64, text> = {}
    for row in descriptor.methods:
        if not interface_symbol_by_id.contains_key(row.interface_id):
            return Err("E-FACET004: manifest method names an unknown facet interface")
        val interface_symbol = interface_symbol_by_id[row.interface_id]
        var found = false
        for interface in module.facet_interfaces:
            if interface.symbol.id == interface_symbol:
                for method in interface.methods:
                    if method.name == row.method_name:
                        if found:
                            return Err("E-FACET005: manifest method maps ambiguously")
                        found = true
                        method_ids[method.symbol.id] = row.method_id
                        method_signatures[method.symbol.id] = row.signature_hash
        if not found:
            return Err("E-FACET004: manifest method is absent from HIR: " + row.method_name)

    var providers: Dict<i64, text> = {}
    var implementation_hashes: Dict<i64, text> = {}
    var base_abis: Dict<i64, text> = {}
    var base_layouts: Dict<i64, text> = {}
    var inspect_caps: Dict<i64, bool> = {}
    for row in descriptor.implementations:
        val symbol = facet_manifest_impl_symbol(module, row.canonical_type_name)
        if symbol == nil:
            return Err("E-FACET004: manifest facet implementation is absent from HIR: " +
                row.canonical_type_name)
        val id = symbol.unwrap().id
        providers[id] = row.provider_id
        implementation_hashes[id] = row.implementation_hash
        base_abis[id] = row.required_base_public_abi_hash
        base_layouts[id] = row.required_base_layout_hash
        inspect_caps[id] = row.inspect_capability

    Ok(ManifestSealAuthority(
        aspect_id: source.aspect_id, aspect_version: source.aspect_version,
        descriptor_digest: source.descriptor_digest,
        authority_id: descriptor.authority_id,
        signature_digest: descriptor.signature_digest,
        module_id: module.name, type_name_by_symbol: names,
        type_by_name: types, concrete_type_id_by_symbol: concrete_ids,
        interface_id_by_symbol: interface_ids,
        interface_abi_by_symbol: interface_abis,
        method_id_by_symbol: method_ids,
        method_signature_by_symbol: method_signatures,
        provider_by_impl_symbol: providers,
        implementation_hash_by_impl_symbol: implementation_hashes,
        base_public_abi_by_impl_symbol: base_abis,
        base_layout_by_impl_symbol: base_layouts,
        inspect_capability_by_impl_symbol: inspect_caps))
