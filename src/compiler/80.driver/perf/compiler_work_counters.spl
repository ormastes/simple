struct CompilerWorkCountersV1:
    parser_scheduled: i64
    hir_scheduled: i64
    mir_scheduled: i64
    codegen_scheduled: i64
    link_scheduled: i64

var compiler_work_counters_v1 = CompilerWorkCountersV1(0, 0, 0, 0, 0)

fn compiler_work_counters_reset_v1():
    compiler_work_counters_v1 = CompilerWorkCountersV1(0, 0, 0, 0, 0)

fn compiler_work_parser_schedule_v1(count: i64):
    if count > 0: compiler_work_counters_v1.parser_scheduled = compiler_work_counters_v1.parser_scheduled + count

fn compiler_work_hir_schedule_v1(count: i64):
    if count > 0: compiler_work_counters_v1.hir_scheduled = compiler_work_counters_v1.hir_scheduled + count

fn compiler_work_mir_schedule_v1(count: i64):
    if count > 0: compiler_work_counters_v1.mir_scheduled = compiler_work_counters_v1.mir_scheduled + count

fn compiler_work_codegen_schedule_v1(count: i64):
    if count > 0: compiler_work_counters_v1.codegen_scheduled = compiler_work_counters_v1.codegen_scheduled + count

fn compiler_work_link_schedule_v1(count: i64):
    if count > 0: compiler_work_counters_v1.link_scheduled = compiler_work_counters_v1.link_scheduled + count

fn compiler_work_counters_snapshot_v1() -> CompilerWorkCountersV1:
    compiler_work_counters_v1

fn compiler_work_counters_zero_v1(counters: CompilerWorkCountersV1) -> bool:
    counters.parser_scheduled == 0 and counters.hir_scheduled == 0 and
        counters.mir_scheduled == 0 and counters.codegen_scheduled == 0 and
        counters.link_scheduled == 0

fn compiler_work_counters_receipt_v1(counters: CompilerWorkCountersV1) -> text:
    "parser={counters.parser_scheduled} hir={counters.hir_scheduled} mir={counters.mir_scheduled} codegen={counters.codegen_scheduled} link={counters.link_scheduled}"

export CompilerWorkCountersV1
export compiler_work_counters_reset_v1, compiler_work_parser_schedule_v1
export compiler_work_hir_schedule_v1, compiler_work_mir_schedule_v1
export compiler_work_codegen_schedule_v1, compiler_work_link_schedule_v1
export compiler_work_counters_snapshot_v1, compiler_work_counters_zero_v1
export compiler_work_counters_receipt_v1
