extern fn rt_transient_array_scope_pause() -> bool
extern fn rt_exit(code: i64)
extern fn rt_heap_ref_wellformed<T>(value: T) -> bool

pub fn driver_rollback_flat_hir_row_or_abort(expected_count: i64):
    val actual_count = bootstrap_hir_module_count()
    if actual_count == expected_count:
        return
    if actual_count == expected_count + 1:
        if bootstrap_hir_modules_rollback_last(expected_count):
            return
    rt_exit(1)

fn reset_frontend_registries_after_scope():
    aspect_registry_reset()
    effect_registry_reset()
    layer_eq_registry_reset()

pub fn driver_abort_reverse_reference_parse_scope_v1(token: i64) -> bool:
    val aborted = reverse_reference_module_abort_v1(token)
    val ended = driver_end_transient_parse_scope()
    aborted and ended

# The caller has paused its own allocation scope and retained its other roots.
# Only a successfully sealed batch may be published after that scope ends.
pub fn driver_publish_reverse_reference_parse_scope_v1(token: i64) -> bool:
    if not reverse_reference_module_seal_v1(token):
        eprint("[rr-publish] node=seal ok=false token={token}\n")
        val _ended = driver_abort_reverse_reference_parse_scope_v1(token)
        return false
    if not driver_end_transient_parse_scope():
        eprint("[rr-publish] node=end ok=false token={token}\n")
        val _aborted = reverse_reference_module_abort_v1(token)
        return false
    if not reverse_reference_module_publish_v1(token):
        eprint("[rr-publish] node=publish ok=false token={token}\n")
        val _aborted = reverse_reference_module_abort_v1(token)
        return false
    true

pub fn driver_finish_failed_parse_scope(source_path: text, reverse_token: i64 = 0) -> text:
    if not rt_transient_array_scope_pause():
        val _ended = driver_abort_reverse_reference_parse_scope_v1(reverse_token)
        reset_frontend_registries_after_scope()
        return "parse error in {source_path}; transient parser scope pause failed before diagnostic capture"
    # Allocate the retained message only after pausing the scratch arena.
    # Later cleanup must not free the message returned to the driver.
    val parse_error = driver_parse_error_message(source_path)
    if not driver_promote_retained_frontend_owners_v1(true):
        val _ended = driver_abort_reverse_reference_parse_scope_v1(reverse_token)
        reset_frontend_registries_after_scope()
        rt_exit(1)
        return "{parse_error}; frontend registry promotion failed"
    if not driver_publish_reverse_reference_parse_scope_v1(reverse_token):
        reset_frontend_registries_after_scope()
        return "{parse_error}; reverse-reference parse-scope publication failed"
    parse_error

fn driver_normalized_source_path(source_path: text) -> text:
    # The surface side of every identity/content comparison below stores
    # `module_surface_canonical_path(source.path)`. Both sides MUST go through
    # the one canonical mapping: a private near-copy here diverged on Windows,
    # where `rt_path_absolute` returns extended-length `\\?\C:\...` paths that
    # the canonicalizer rewrites (`C:/...`) but the old copy left as `//?/C:/...`,
    # failing every Stage-3 surface identity check.
    module_surface_canonical_path(source_path)

pub fn driver_stage3_surface_identity_matches(
    surface_source_index: i64,
    surface_canonical_path: text,
    surface_module_name: text,
    surface_content_length: i64,
    surface_content_hash: i64,
    source_index: i64,
    source_path: text,
    source_module_name: text,
    source_content_length: i64,
    source_content_hash: i64
) -> bool:
    val normalized_source_path = driver_normalized_source_path(source_path)
    surface_source_index == source_index and
        surface_canonical_path == normalized_source_path and
        surface_module_name == source_module_name and
        surface_content_length == source_content_length and
        surface_content_hash == source_content_hash

pub fn driver_stage3_surface_identity_matches_receipt(
    surface_source_index: i64,
    surface_canonical_path: text,
    surface_module_name: text,
    surface_content_length: i64,
    surface_content_hash: i64,
    source_index: i64,
    source_path: text,
    source_module_name: text,
    source_content_length: i64,
    source_content_hash: i64,
    source_was_evicted: bool
) -> bool:
    # Phase 1 reserves zero for a missing hash. A real zero is stored as one;
    # normalize the surface side only when comparing an evicted-source receipt.
    if source_was_evicted and source_content_hash == 0:
        return false
    val compare_surface_hash = if source_was_evicted and surface_content_hash == 0:
        1
    else:
        surface_content_hash
    driver_stage3_surface_identity_matches(
        surface_source_index, surface_canonical_path, surface_module_name,
        surface_content_length, compare_surface_hash,
        source_index, source_path, source_module_name,
        source_content_length, source_content_hash)

pub fn driver_stage3_surface_content_matches(
    surface_canonical_path: text,
    surface_content_length: i64,
    surface_content_hash: i64,
    source_path: text,
    source_content_length: i64,
    source_content_hash: i64
) -> bool:
    val normalized_source_path = driver_normalized_source_path(source_path)
    surface_canonical_path == normalized_source_path and
        surface_content_length == source_content_length and
        surface_content_hash == source_content_hash

pub fn driver_stage3_surface_identity_mismatch(
    surface_source_index: i64,
    surface_canonical_path: text,
    surface_module_name: text,
    surface_content_length: i64,
    surface_content_hash: i64,
    source_index: i64,
    source_path: text,
    source_module_name: text,
    source_content_length: i64,
    source_content_hash: i64
) -> text:
    val normalized_source_path = driver_normalized_source_path(source_path)
    "surface/source identity mismatch: " +
        "index={surface_source_index}/{source_index} " +
        "path='{surface_canonical_path}'/'{normalized_source_path}' " +
        "module='{surface_module_name}'/'{source_module_name}' " +
        "length={surface_content_length}/{source_content_length} " +
        "hash={surface_content_hash}/{source_content_hash}"

pub fn driver_hir_mem_snapshot(
    boundary: text,
    source_index: i64,
    source_path: text,
    retained_modules: i64,
    validation_keys: i64,
    validation_values: i64,
    shared_traits: i64
) -> bool:
    mem_snapshot_record(
        boundary, source_index, source_path, retained_modules,
        validation_keys, validation_values, shared_traits,
        bootstrap_hir_module_names_outer_len(),
        bootstrap_hir_module_symbols_outer_len(),
        bootstrap_hir_module_functions_outer_len(),
        bootstrap_hir_module_constants_outer_len(),
        bootstrap_hir_module_enums_outer_len(),
        bootstrap_hir_module_structs_outer_len(),
        bootstrap_hir_module_classes_outer_len())

pub fn driver_hir_promotion_snapshot(
    phase: text, source_index: i64, source_path: text,
    promoted_nodes: i64, promoted_bytes: i64
) -> bool:
    mem_snapshot_record_promotion(
        phase, source_index, source_path, promoted_nodes, promoted_bytes)

fn format_hir_lowering_error(name: text, err: LoweringError) -> text:
    if err.span.file != "":
        "HIR lowering error in {name} ({err.span.file}:{err.span.line}:{err.span.col}): {err.message}"
    else:
        "HIR lowering error in {name}: {err.message}"

pub fn driver_shown_fatal_count(total: i64, unbounded: bool) -> i64:
    if unbounded:
        return total
    if total > 10:
        return 10
    total

pub fn driver_collect_hir_errors(ctx: CompileContext, name: text, errors: [LoweringError]):
    for err in errors:
        if err.kind == LoweringErrorKind.Recovered:
            ctx.add_warning(format_hir_lowering_error(name, err))
        else:
            val formatted = format_hir_lowering_error(name, err)
            eprint("[hir-fatal] {formatted}")
            ctx.add_error(formatted)

# Concrete because the native build path has no generic monomorphization.
pub fn driver_dict_entry_count(entries: Dict<SymbolId, HirFunction>) -> i64:
    val keys: [SymbolId] = entries.keys()
    keys.len()

# Keys of `hir_modules` whose stored value is not a well-formed heap
# aggregate. `validate_value_struct_layouts` was moved off this Dict because
# "native bootstrap can retain a dictionary key while dropping its aggregate
# HIR value"; the three validators and the weaver below still index it, and a
# dropped value dereferenced there is a bare SIGSEGV with no diagnostic. The
# bit test never dereferences, so the census itself cannot fault on a bad
# value.
fn driver_hir_module_dict_dropped_values(hir_modules: Dict<text, HirModule>) -> [text]:
    var dropped: [text] = []
    for key in hir_modules.keys():
        val module_value: HirModule = hir_modules[key]
        if not rt_heap_ref_wellformed(module_value):
            dropped = dropped.push(key)
    dropped

pub fn driver_rt_criticality_errors(modules: Dict<text, HirModule>,
        hir_module_array: [HirModule] = [], hir_module_blobs: [text] = [],
        hir_module_has_rt_hal: [bool] = [], hir_module_claim_counts: [i64] = []) -> [text]:
    """Route typed RT warnings to diagnostics and errors to the fatal driver result."""
    # Cycle-76/77: Dict<text, HirModule> value reads arrive erased in this
    # lane regardless of read pattern (.values rebind, keys()+[]). When the
    # caller threads the lowering-local array (never dict-read), use it
    # directly; otherwise rebuild from the dict as a fallback.
    var module_list: [HirModule] = hir_module_array
    if module_list.len() == 0:
        for mk in modules.keys():
            val mv: HirModule = modules[mk]
            module_list.push(mv)
    # Lane-entry probe (cycle-77): discriminates insert-vs-read corruption on
    # the next cycle's log without a shim.
    if (env_get("SIMPLE_ENUM_REG_TRACE") ?? "") == "1":
        eprint("[enum-reg] rt-criticality lane: dict_keys={modules.keys().len()} array={module_list.len()}")
    val report = driver_hir_gate_rt_report_v1(validate_rt_criticality_diagnostics_blobs(
            hir_module_blobs, module_list, hir_module_has_rt_hal, hir_module_claim_counts))
    driver_hir_gate_publish_warnings_v1(report.warnings)
    report.errors

pub fn driver_validate_value_struct_layouts(
    module_keys: [text],
    module_values: [HirModule],
    hir_modules: Dict<text, HirModule>
) -> [text]:
    # Compatibility caller: project declarations, never synthesize HIR bodies.
    var declarations: [ValueStructLayoutModuleV1] = []
    var index = 0
    while index < module_values.len():
        val module = module_values[index]
        val module_key = if index < module_keys.len(): module_keys[index] else: ""
        declarations.push(value_struct_layout_declarations_v1(module_key, module.path,
            module.structs, module.symbols))
        index = index + 1
    driver_validate_value_struct_layout_declarations_v1(module_keys, declarations, hir_modules)

struct DriverNogcParamEffectAdmissionV1:
    errors: [text]
    modules: [HirModule]
    fatal_errors: [text] = []

fn driver_nogc_param_effect_admission_round_v1(
    modules: Dict<text, HirModule>,
    module_array: [HirModule],
    surfaces: [ModuleSurface],
    verified_providers: [HirModule]
) -> DriverNogcParamEffectAdmissionV1:
    # Strictness belongs to the declaring source, never a registry alias or
    # a name containing "nogc". Legacy modules retain their existing policy.
    var class_names: {text: bool} = {}
    for surface in surfaces:
        for composite in surface.composite_values:
            if composite.kind == "class": class_names[composite.name] = true
    var actual_modules: [HirModule] = module_array
    if actual_modules.len() == 0:
        for name in modules.keys():
            val actual: HirModule = modules[name]
            actual_modules.push(actual)
    var errors: [text] = []
    var fatal_errors: [text] = []
    var admitted: [HirModule] = []
    for raw_actual in actual_modules:
        var actual: HirModule = raw_actual
        actual.nogc_param_effects_checked = false
        actual.nogc_param_effect_symbol_ids = []
        actual.nogc_param_effects = []
        if actual.path == "":
            errors.push("NOGC-POLICY-001: HIR module {actual.name} has no physical source identity")
            fatal_errors.push(errors[errors.len() - 1])
            continue
        val actual_path = module_surface_canonical_path(actual.path)
        var strict = false
        var matched = false
        var conflicting = false
        for surface in surfaces:
            if surface.canonical_path == actual_path:
                if matched and strict != surface.nogc_strict: conflicting = true
                strict = surface.nogc_strict
                matched = true
        if conflicting or (matched and actual.nogc_strict != strict):
            if (env_get_opt("SIMPLE_NSCOPE_HIR_TRACE") ?? "") == "1":
                eprint("[nogc-gate] refuse path={actual.path} hir_strict={actual.nogc_strict} surface_strict={strict} matched={matched} conflicting={conflicting}")
            errors.push("NOGC-POLICY-001: {actual.path}: cached HIR ownership policy disagrees with its declaring source")
            fatal_errors.push(errors[errors.len() - 1])
            continue
        if not matched and actual.nogc_strict:
            errors.push("NOGC-POLICY-001: {actual.path}: strict HIR has no declaring source ownership contract")
            fatal_errors.push(errors[errors.len() - 1])
            continue
        if not strict:
            admitted.push(actual)
            continue
        # Only resolver-bound proofs from providers admitted in an earlier
        # round can grant callback slots. V1/name-only summaries stay unknown.
        val callbacks = verified_imported_callback_slots(actual, verified_providers, surfaces)
        val report = infer_param_effects(actual, class_names, {}, callbacks)
        for diagnostic in report.diags:
            val formatted = "{diagnostic.code}: {actual.path}:{diagnostic.line}: {diagnostic.message}"
            errors.push(formatted)
            # Only a callsite-tagged missing imported proof may be retried.
            # Generic retained/local captures are fatal even if this module
            # also happens to import an unrelated callback provider.
            var missing_callback_proof = false
            val pending_symbol = diagnostic.pending_import_symbol
            if diagnostic.code == "NOGC-IMPORT-CALLBACK-PENDING" and pending_symbol >= 0 and actual.symbols.symbols.contains_key(pending_symbol):
                val resolved: HirSymbol = actual.symbols.symbols[pending_symbol]
                val owner = resolved.defining_module ?? ""
                missing_callback_proof = resolved.kind == SymbolKind.Function and not actual.functions.contains_key(resolved.id) and owner != "" and not callbacks.contains_key(pending_symbol)
            if not missing_callback_proof: fatal_errors.push(formatted)
        if report.diags.len() != 0: continue
        var symbol_ids: [i64] = []
        var rows: [[text]] = []
        var invalid = false
        for function in report.functions:
            val symbol = SymbolId(id: function.symbol_id)
            if not actual.functions.contains_key(symbol) or symbol_ids.contains(function.symbol_id):
                invalid = true
                continue
            val declaration: HirFunction = actual.functions[symbol]
            if declaration.params.len() != function.params.len():
                invalid = true
                continue
            var effects: [text] = []
            var parameter_index = 0
            for parameter in function.params:
                if parameter.name != declaration.params[parameter_index].name:
                    invalid = true
                if parameter.effect != "read-short" and parameter.effect != "mutate-short" and parameter.effect != "consume" and parameter.effect != "share-explicit":
                    invalid = true
                effects.push(parameter.effect)
                parameter_index = parameter_index + 1
            symbol_ids.push(function.symbol_id)
            rows.push(effects)
        if invalid or symbol_ids.len() != actual.functions.keys().len():
            errors.push("NOGC-CONTRACT-001: {actual.path}: ownership report does not cover exact local function identities")
            fatal_errors.push(errors[errors.len() - 1])
            continue
        actual.nogc_param_effect_symbol_ids = symbol_ids
        actual.nogc_param_effects = rows
        actual.nogc_param_effects_checked = true
        admitted.push(actual)
    DriverNogcParamEffectAdmissionV1(errors: errors, modules: admitted, fatal_errors: fatal_errors)

fn driver_nogc_param_effect_admission_v1(modules: Dict<text, HirModule>,
        module_array: [HirModule], surfaces: [ModuleSurface]) -> DriverNogcParamEffectAdmissionV1:
    var pending: [HirModule] = []
    var initial: [HirModule] = module_array
    if initial.len() == 0:
        for key in modules.keys():
            val actual: HirModule = modules[key]
            initial.push(actual)
    # Canonical physical order removes dependence on Dict iteration and
    # shard completion order. Proofs become visible only next round.
    # A full CLI contains thousands of modules. Selection-sorting this set
    # normalized each remaining path again on every round (4,241,328 path
    # allocations/resolutions for 2,912 modules). Cache the canonical keys
    # once and use a stable O(n log n) index merge with O(n) scratch space.
    var canonical_paths: [text] = []
    for actual in initial:
        canonical_paths.push(module_surface_canonical_path(actual.path))
    for index in hir_admission_path_order_v1(canonical_paths):
        pending.push(initial[index])
    var providers: [HirModule] = []
    var round = 0
    while pending.len() > 0 and round <= initial.len():
        val receipt = driver_nogc_param_effect_admission_round_v1({}, pending, surfaces, providers)
        if receipt.fatal_errors.len() > 0:
            return DriverNogcParamEffectAdmissionV1(errors: receipt.errors, modules: [])
        if receipt.modules.len() == 0:
            # No new proof can resolve the remaining dependency component.
            # Unknown providers and cycles retain their actual diagnostics.
            return DriverNogcParamEffectAdmissionV1(errors: receipt.errors, modules: [])
        var next: [HirModule] = []
        for actual in pending:
            var admitted = false
            for checked in receipt.modules:
                if actual.name == checked.name and actual.path == checked.path:
                    admitted = true
            if not admitted: next.push(actual)
        for checked in receipt.modules: providers.push(checked)
        pending = next
        round = round + 1
    if pending.len() != 0:
        return DriverNogcParamEffectAdmissionV1(errors: ["NOGC-CONTRACT-001: ownership provider admission did not converge"], modules: [])
    DriverNogcParamEffectAdmissionV1(errors: [], modules: providers)

pub fn driver_nogc_param_effect_errors_v1(modules: Dict<text, HirModule>,
        module_array: [HirModule], surfaces: [ModuleSurface]) -> [text]:
    driver_nogc_param_effect_admission_v1(modules, module_array, surfaces).errors

pub fn driver_admit_nogc_param_effects_v1(ctx: CompileContext, surfaces: [ModuleSurface]):
    log_phase("phase3:hir:ownership_admission:start")
    val admission = driver_nogc_param_effect_admission_v1(ctx.hir_modules, ctx.validation_module_array, surfaces)
    for error in admission.errors: ctx.add_error(error)
    # Admission is transactional. No stale/partial report is published after
    # one module fails, and downstream MIR never consumes error-bearing HIR.
    if admission.errors.len() != 0:
        log_phase("phase3:hir:ownership_admission:failed")
        return
    var modules: Dict<text, HirModule> = ctx.hir_modules
    for actual in admission.modules:
        for key in modules.keys():
            val previous: HirModule = modules[key]
            if previous.name == actual.name and previous.path == actual.path:
                modules[key] = actual
        if val entry = ctx.bootstrap_entry_hir:
            if entry.name == actual.name and entry.path == actual.path:
                ctx.bootstrap_entry_hir = actual
    ctx.hir_modules = modules
    ctx.validation_module_array = admission.modules
    log_phase("phase3:hir:ownership_admission:done")

# Bug native_build_hir_phase_scopes_2026_10_24: the closure-wide validators
# below walk every module with no transient scope, so their scratch stays
# immortal in the no-GC runtime. Each returns only rendered text and writes no
# global or ctx state (registry READS only), so each runs in its own scope and
# only its result is promoted; publication, the `errors` pushes and every
# log_phase stay outside. Not scoped: the RT-criticality step (already scopes
# each blob, and rt_bound_manifest_clear() writes a global) and advice weaving
# (writes rewritten modules back into hir_modules).
# SIMPLE_HIR_VALIDATE_SCOPE=0 restores the unscoped walk.
fn hir_validate_scope_enabled_v1() -> bool:
    (env_get("SIMPLE_HIR_VALIDATE_SCOPE") ?? "") != "0"

fn _hir_validate_scope_open_v1(step: text) -> bool:
    if not hir_validate_scope_enabled_v1(): return false
    if transient_array_scope_state_v1() != 0 or not transient_scope_begin():
        eprint("[hir-validate-scope] WARNING transient scope refused; running {step} UNSCOPED, arena retained")
        return false
    true

fn _hir_validate_scope_failed_v1(step: text, paused: bool, owned: bool, ended: bool):
    eprint("[hir-validate-scope] WARNING result promotion failed (paused={paused} owned={owned} ended={ended}); re-running {step} UNSCOPED")

fn _hir_validate_layout_report_scoped_v1(module_keys: [text],
        module_values: [ValueStructLayoutModuleV1], cycle_mode: text) -> DriverHirGateLayoutReportV1:
    if not _hir_validate_scope_open_v1("value_struct_layouts"):
        return driver_hir_gate_layout_report_v1(module_keys, module_values, cycle_mode)
    val report: DriverHirGateLayoutReportV1 = driver_hir_gate_layout_report_v1(module_keys, module_values, cycle_mode)
    # @workaround bug=mono_generic_field_access_arg_unspecialized_2026-10-23 reason=stage2 mono cannot infer T from a field-access argument to transient_promote<T>; typed locals carry the same handles
    val errors_v: [text] = report.errors
    val warnings_v: [text] = report.warnings
    val paused = transient_scope_pause()
    val owned = paused and transient_promote(report) and transient_promote(errors_v) and
        transient_promote(warnings_v)
    val ended = transient_scope_end()
    if paused and owned and ended: return report
    _hir_validate_scope_failed_v1("value_struct_layouts", paused, owned, ended)
    driver_hir_gate_layout_report_v1(module_keys, module_values, cycle_mode)

fn _hir_validate_layer_eq_scoped_v1(hir_modules: Dict<text, HirModule>) -> [text]:
    if not _hir_validate_scope_open_v1("layer_eq"):
        return validate_layer_eq_types(hir_modules)
    val found = validate_layer_eq_types(hir_modules)
    val paused = transient_scope_pause()
    val owned = paused and transient_promote(found)
    val ended = transient_scope_end()
    if paused and owned and ended: return found
    _hir_validate_scope_failed_v1("layer_eq", paused, owned, ended)
    validate_layer_eq_types(hir_modules)

fn _hir_validate_effects_scoped_v1(hir_modules: Dict<text, HirModule>) -> [text]:
    if not _hir_validate_scope_open_v1("effects"):
        return validate_effect_contracts(hir_modules)
    val found = validate_effect_contracts(hir_modules)
    val paused = transient_scope_pause()
    val owned = paused and transient_promote(found)
    val ended = transient_scope_end()
    if paused and owned and ended: return found
    _hir_validate_scope_failed_v1("effects", paused, owned, ended)
    validate_effect_contracts(hir_modules)

fn _hir_validate_aspects_scoped_v1(hir_modules: Dict<text, HirModule>) -> [text]:
    if not _hir_validate_scope_open_v1("aspects"):
        return validate_aspect_contracts(hir_modules)
    val found = validate_aspect_contracts(hir_modules)
    val paused = transient_scope_pause()
    val owned = paused and transient_promote(found)
    val ended = transient_scope_end()
    if paused and owned and ended: return found
    _hir_validate_scope_failed_v1("aspects", paused, owned, ended)
    validate_aspect_contracts(hir_modules)

pub fn driver_validate_value_struct_layout_declarations_v1(
    module_keys: [text],
    module_values: [ValueStructLayoutModuleV1],
    hir_modules: Dict<text, HirModule>,
    hir_module_array: [HirModule] = [],
    hir_module_blobs: [text] = [],
    hir_module_has_rt_hal: [bool] = [],
    hir_module_claim_counts: [i64] = []
) -> [text]:
    var errors: [text] = []
    # One receipt per sub-pass: the Stage-3 worker died between the last
    # hir:file:done and streaming_source_reclaim:done four times on
    # 2026-09-05 without naming a step. Gated like every other log_phase
    # (SIMPLE_COMPILER_PHASE_PROFILE=1 / SIMPLE_COMPILER_TRACE=1).
    log_phase("phase3:hir:validate:value_struct_layouts:start")
    # SIMPLE_VALUE_STRUCT_LAYOUT_CYCLE=warning prints by-value struct cycles
    # and keeps compiling, so out-of-tree code can list all of them in one
    # run instead of failing after a full HIR pass. Default is fatal; the
    # validator's internal errors are never downgraded. DIAGNOSTIC-ONLY: the
    # build then continues into layout and codegen with a struct that has no
    # finite size, so whatever it produces must not be trusted or shipped.
    val layout_report = _hir_validate_layout_report_scoped_v1(module_keys, module_values,
        env_get("SIMPLE_VALUE_STRUCT_LAYOUT_CYCLE"))
    driver_hir_gate_publish_warnings_v1(layout_report.warnings)
    for error in layout_report.errors: errors = errors.push(error)
    val skipped_struct_edges: i64 = layout_report.skipped_struct_edges
    log_phase("phase3:hir:validate:value_struct_layouts:done errors={errors.len()} skipped_struct_edges={skipped_struct_edges}")
    log_phase("phase3:hir:validate:dict_census:start")
    val dropped = driver_hir_module_dict_dropped_values(hir_modules)
    val census_total: i64 = hir_modules.keys().len()
    log_phase("phase3:hir:validate:dict_census:done dropped={dropped.len()} total={census_total}")
    val census_report = driver_hir_gate_census_report_v1(dropped, census_total)
    driver_hir_gate_publish_census_v1(census_report)
    for error in census_report.errors: errors = errors.push(error)
    if census_report.gates_skipped:
        driver_print_post_hir_validation_fatal(errors)
        return errors
    log_phase("phase3:hir:validate:layer_eq:start")
    for layer_eq_error in _hir_validate_layer_eq_scoped_v1(hir_modules):
        errors = errors.push(layer_eq_error)
    log_phase("phase3:hir:validate:layer_eq:done errors={errors.len()}")
    log_phase("phase3:hir:validate:effects:start")
    for effect_error in _hir_validate_effects_scoped_v1(hir_modules):
        errors = errors.push(effect_error)
    log_phase("phase3:hir:validate:effects:done errors={errors.len()}")
    log_phase("phase3:hir:validate:rt_criticality:start")
    for rt_error in driver_rt_criticality_errors(hir_modules, hir_module_array, hir_module_blobs,
            hir_module_has_rt_hal, hir_module_claim_counts):
        errors = errors.push(rt_error)
    log_phase("phase3:hir:validate:rt_criticality:done errors={errors.len()}")
    log_phase("phase3:hir:validate:aspects:start")
    val aspect_errors = _hir_validate_aspects_scoped_v1(hir_modules)
    for aspect_error in aspect_errors:
        errors = errors.push(aspect_error)
    log_phase("phase3:hir:validate:aspects:done errors={errors.len()}")
    if aspect_errors.len() == 0:
        log_phase("phase3:hir:validate:weave:start")
        val _woven = weave_forward_advice(hir_modules)
        log_phase("phase3:hir:validate:weave:done")
    driver_print_post_hir_validation_fatal(errors)
    errors

export driver_hir_module_dict_dropped_values
export use compiler.driver.cache.driver_hir_post_validation_gate_facts_v1.{driver_print_post_hir_validation_fatal}
