# Whole-program bootstrap MIR schedule deduplication and progress cadence helpers.
# Kept free of CompilerDriver/MirLowering imports so unit specs and callers can
# verify the schedule and cadence contracts without pulling the full compiler
# closure into interpreter sessions.

# reason: whole-program bootstrap MIR progress cadence predicate over module counts
@allow(primitive_api)
@allow(bare_bool)
pub fn driver_bootstrap_mir_build_progress_due_v1(visited: i64, total: i64) -> bool:
    if total <= 0 or visited <= 0:
        return false
    visited == 1 or visited % 64 == 0 or visited == total

pub fn driver_bootstrap_unique_module_names_v1(names: [text]) -> [text]:
    var seen: {text: bool} = {}
    var unique: [text] = []
    for name in names:
        if name != "" and not seen.contains_key(name):
            seen[name] = true
            unique = unique.push(name)
    unique
