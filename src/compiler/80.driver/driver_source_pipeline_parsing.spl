extern fn rt_exit(code: i64)
extern fn rt_stdout_flush()
extern fn rt_env_get(key: text) -> text
extern fn rt_env_set(key: text, value: text)
extern fn rt_transient_array_scope_begin() -> bool
extern fn rt_transient_array_scope_pause() -> bool
extern fn rt_transient_array_scope_end() -> bool


# The front-end cache lives in 10.frontend and must not import 80.driver, so
# the driver PUBLISHES the scope it may cache under and the frontend reads it.
# No scope published => the frontend cache is off. That is deliberate: a
# frontend that cannot see the driver's scope has no way to know what it would
# be sharing entries with, and guessing is how a stale-parser hit becomes a
# wrong module.
#
# The scope folds native_build_cache_scope_key (lane from SIMPLE_CACHE_SCOPE)
# over native_build_compiler_identity(), which itself folds the compiler SOURCE
# fingerprint -- load-bearing here, because under native-build the front end
# runs INTERPRETED from src/compiler/**, so the executable hash does not move
# when a parser edit changes what a parse produces. When the compiler identity
# is unknown that function returns "uncacheable-<pid>-<time>", which is unique
# per process and therefore reuses nothing: fail closed.

# ===== Parse sharding =======================================================
#
# SIMPLE_PARSE_SHARD="<index>/<count>" (set from --parse-shard=, which only the
# orchestrator passes). A shard child parses ONLY the modules it owns, which
# stores their front-end cache entries, and then exits 0 before HIR. The real
# build that follows hits every entry.
#
# Ownership is a pure function of the module PATH, not of its position in the
# discovered source list. That matters for determinism: the closure walk can
# legitimately yield the same set in a different order between processes, and a
# position-based split would then have two shards parse the same file and a
# third parse none. A path hash cannot drift that way, and needs no sorted
# index (which would be O(n^2) over 662 interpreted-Simple modules).
#
# The hash is spelled out here rather than reusing rt_hash_text because the
# split must agree ACROSS PROCESSES; a runtime hash that is seeded or
# implementation-defined would silently give two shards different answers.
fn _driver_parse_shard_hash(path: text) -> i64:
    var h: i64 = 5381
    var i: i64 = 0
    while i < path.len():
        h = ((h * 33) + char_code(path[i:i + 1])) % 1000000007
        i = i + 1
    h

# Shared with the HIR shards (driver_hir_cache.spl): one hash, one marker
# name, across every shard kind and process.
pub fn driver_parse_shard_hash(path: text) -> i64:
    _driver_parse_shard_hash(path)

var _driver_parse_shard_memo: text = "@@unset@@"

fn _driver_parse_shard_spec() -> text:
    if _driver_parse_shard_memo != "@@unset@@":
        return _driver_parse_shard_memo
    _driver_parse_shard_memo = rt_env_get("SIMPLE_PARSE_SHARD") ?? ""
    _driver_parse_shard_memo

pub fn driver_parse_shard_active() -> bool:
    _driver_parse_shard_spec() != ""

# A malformed spec owns EVERYTHING rather than nothing. A shard that silently
# parses no files would look like a fast success and leave the cache empty,
# which is the failure mode that is hardest to notice.
fn _driver_parse_shard_owns_static(path: text) -> bool:
    val spec = _driver_parse_shard_spec()
    if spec == "":
        return true
    val slash = spec.index_of("/")
    if slash <= 0:
        return true
    val index = spec.substring(0, slash).to_i64() ?? -1
    val count = spec.substring(slash + 1, spec.len()).to_i64() ?? 0
    if count <= 0 or index < 0 or index >= count:
        return true
    (_driver_parse_shard_hash(path) % count) == index

# ----- Shared work queue (replaces the static split when the orchestrator
# publishes SIMPLE_PARSE_SHARD_QUEUE) ------------------------------------------
#
# A static hash split has a TAIL: the 8-way stage build always ended with one
# or two shards still parsing while the other six sat idle, because the split
# is by module count and modules are not equal (fp7, 2026-08-21: shards
# finished 73..94 modules apart and the last one gated the whole phase). With
# a queue every shard walks the same source list and CLAIMS each module it
# reaches; whoever claims first parses it, everyone else skips. Work stays
# balanced to within one module.
#
# Claim = a marker file under the queue dir, created inside a single flock'd
# critical section (rt_file_lock is flock(2) and exists in both the seed and
# the C runtime; rt_dir_create returns true on EEXIST and rename(2) overwrites,
# so neither is an atomic claim on its own). The section is a stat and a tiny
# write, microseconds against a multi-second parse.
#
# Output is unchanged by construction: a claimed module is parsed by exactly
# one shard into the same content-keyed cache entry the static split would
# have produced, and any module that is never claimed (a shard died, the lock
# timed out) is simply parsed by the real build. The partition is no longer
# a pure function of the path -- WHICH shard parses a module now depends on
# timing -- but the union still is, and only the union reaches the cache.
#
# Lock failure degrades to the static split for that module rather than to
# "owns nothing" (same fail-closed reasoning as the malformed-spec case).

var _driver_parse_shard_queue_memo: text = "@@unset@@"
var _driver_parse_shard_claimed: i64 = 0

fn _driver_parse_shard_queue_dir() -> text:
    if _driver_parse_shard_queue_memo != "@@unset@@":
        return _driver_parse_shard_queue_memo
    _driver_parse_shard_queue_memo = rt_env_get("SIMPLE_PARSE_SHARD_QUEUE") ?? ""
    _driver_parse_shard_queue_memo

pub fn driver_parse_shard_claimed() -> i64:
    _driver_parse_shard_claimed

fn _driver_parse_shard_claim(queue_dir: text, path: text) -> bool:
    # Path hash + length: the marker name must agree across processes (same
    # reason the hash is spelled out above) and a collision only costs one
    # module its shard slot -- the real build still parses it.
    val marker = "{queue_dir}/{_driver_parse_shard_hash(path)}-{path.len()}.claim"
    if file_exists(marker):
        return false
    val fd = file_lock("{queue_dir}/.lock", 30)
    if fd < 0:
        return _driver_parse_shard_owns_static(path)
    var claimed = false
    if not file_exists(marker):
        claimed = file_write(marker, _driver_parse_shard_spec())
    val _unlocked = file_unlock(fd)
    if claimed:
        _driver_parse_shard_claimed = _driver_parse_shard_claimed + 1
    claimed

fn _driver_parse_shard_owns(path: text) -> bool:
    if _driver_parse_shard_spec() == "":
        return true
    val queue_dir = _driver_parse_shard_queue_dir()
    if queue_dir == "":
        return _driver_parse_shard_owns_static(path)
    _driver_parse_shard_claim(queue_dir, path)

fn _driver_publish_frontend_cache_scope():
    if (rt_env_get("SIMPLE_FRONTEND_CACHE_SCOPE") ?? "") != "":
        return
    val scope = native_build_cache_scope_key(nil, nil, [], 0, native_build_compiler_identity())
    rt_env_set("SIMPLE_FRONTEND_CACHE_SCOPE", scope)

pub fn driver_promote_frontend_registry_owners() -> bool:
    val aspect_ok = aspect_registry_promote_transient_owner()
    val effect_ok = effect_registry_promote_transient_owner()
    val layer_ok = layer_eq_registry_promote_transient_owner()
    aspect_ok and effect_ok and layer_ok

# Marks the one recoverable failure of add_streaming_module_surface: the source
# did not parse. Every other Err from it is an internal invariant break.
val _STREAM_PARSE_ERROR_PREFIX: text = "parse error in "

class ParsedEntryModuleBox:
    value: ParserModule

    static fn new(value: ParserModule) -> ParsedEntryModuleBox:
        ParsedEntryModuleBox(value: value)

# Env-gated driver trace probe. Set SIMPLE_INTERP_TRACE=1 to enable the
# [DRV]/[BOOTSTRAP-PHASE] loading/lowering probe trail.
pub fn dtrace(msg: text) -> ():
    if (rt_env_get("SIMPLE_INTERP_TRACE") ?? "") == "1":
        eprint(msg)

pub fn driver_end_transient_parse_scope() -> bool:
    lexer_release_parse_source_globals()
    # ORDER IS LOAD-BEARING. End the transient array scope BEFORE ast_reset().
    #
    # ast_reset() (re)allocates process-lifetime arena state: every
    # `if X == nil: X = []` guard in ast_reset/expr_reset/stmt_reset/_ast_slots_
    # ensure fires here in native binaries, which zero-initialise module arrays.
    # rt_core_register_scoped_immortal() stamps EVERY array born while a
    # transient array scope is active with that scope's id, and
    # rt_transient_array_scope_end() then free()s those objects and erases them
    # from the immortal pointer registry. Resetting first therefore handed the
    # NEXT file a dead arena -- rt_array_len returns 0/-1, rt_array_push is
    # silently dropped, rt_array_clear is a silent no-op -- for the rest of the
    # process. That is the `[stmt_get_tag] OOB ... arena_len=0` /
    # `[flat-bridge] missing stmt tag` flood that aborted Stage 4 phase 3.
    # Ending the scope first means the reset's allocations are born OUTSIDE any
    # scope and stay process-immortal, while the per-file parse garbage that the
    # scope actually owns is still reclaimed exactly as before.
    # See doc/08_tracking/bug/ast_arena_reset_inside_transient_scope_2026-08-01.md
    val ended = rt_transient_array_scope_end()
    # The token interner retains short strings born in the just-ended parser
    # scope. Replace the whole owner only after that scope is closed so the new
    # dictionary is process-lived; resetting inside `lex_init_with_path` would
    # allocate the next global owner inside the next transient scope and leave
    # another dangling dictionary at teardown.
    core_token_text_intern_reset()
    ast_reset()
    ended

impl CompilerDriver:
    me add_streaming_module_surface(
        builder: ModuleSurfaceBuilder,
        source_path: text,
        source_authored_path: text,
        source_content: text,
        source_module_name: text,
        source_index: i64,
        canonical_path: text
    ) -> Result<ModuleSurfaceBuilder, text>:
        if builder.frozen:
            return Err("module surface builder is frozen")
        if builder.index_by_path.contains_key(canonical_path):
            return Err("module surface already exists for physical source: {canonical_path}")
        if not rt_transient_array_scope_begin():
            return Err("transient parser scope unavailable for {source_path}")
        val source = SourceFile(
            path: source_path,
            authored_path: source_authored_path,
            content: source_content,
            module_name: source_module_name)
        log_module_surface_stage(source_path, "parse-start")
        val module = parse_full_frontend(
            source_content, source_path, source_module_name, self.ctx.logger)
        if par_had_error_get():
            if not rt_transient_array_scope_pause():
                val _ended = driver_end_transient_parse_scope()
                return Err("transient parser scope pause failed after parse error for {source_path}")
            if not driver_promote_frontend_registry_owners():
                val _ended = driver_end_transient_parse_scope()
                return Err("frontend registry promotion failed after parse error for {source_path}")
            val _ended = driver_end_transient_parse_scope()
            return Err("{_STREAM_PARSE_ERROR_PREFIX}{source_path} (see [parser_error] output above)")
        log_module_surface_stage(source_path, "parse-done")
        # Build the compact projection before pausing so all intermediate
        # arrays/dictionaries remain owned by the per-file transient scope.
        # Only the reachable surface graph is promoted below.
        # Box the rich parser aggregate while allocation tracking is active.
        # Surface extraction then crosses the module boundary by class
        # reference instead of copying every executable body by value.
        val module_owner = ModuleSurfaceParserOwner.new(module)
        val surface_result = module_surface_from_owner(
            module_owner, source, source_index)
        if surface_result.is_err():
            if not rt_transient_array_scope_pause():
                val _ended = driver_end_transient_parse_scope()
                return Err("transient parser scope pause failed after surface error for {source_path}")
            if not driver_promote_frontend_registry_owners():
                val _ended = driver_end_transient_parse_scope()
                return Err("frontend registry promotion failed after surface error for {source_path}")
            val _ended = driver_end_transient_parse_scope()
            return Err(surface_result.unwrap_err())
        val surface = surface_result.unwrap()
        log_module_surface_stage(source_path, "surface-done")
        if not rt_transient_array_scope_pause():
            val _ended = driver_end_transient_parse_scope()
            return Err("transient parser scope pause failed for {source_path}")
        if not driver_promote_frontend_registry_owners():
            val _ended = driver_end_transient_parse_scope()
            return Err("frontend registry promotion failed for {source_path}")
        if not module_surface_promote(surface):
            val _ended = driver_end_transient_parse_scope()
            return Err("module surface promotion failed for {source_path}")
        log_module_surface_stage(source_path, "promote-done")
        # Close and reclaim the parser scope before mutating the persistent
        # registry. Pausing permits promotion; it does not make allocations
        # performed by builder.add_* persistent.
        if not driver_end_transient_parse_scope():
            return Err("transient parser scope end failed for {source_path}")
        val add_result = builder.add_surface_canonical_identity(
            surface, source_module_name, canonical_path)
        if add_result.is_err():
            return Err(add_result.unwrap_err())
        log_module_surface_stage(source_path, "commit-done")
        Ok(builder)

    # The streaming surface owner is intentionally committed in place.  Do not
    # transport CompileContext through a tuple here: native tuple lowering can
    # preserve the boolean while reconstructing an older value snapshot whose
    # optional module_surfaces field is still nil.
    me parse_all_streaming_surfaces_in_place_impl() -> bool:
        self.streaming_module_surfaces_owner = nil
        self.streaming_surface_owner_ready = false
        self.streaming_entry_source_index_owner = bootstrap_entry_source_index(self.ctx)
        # Same compiler-identity scope the non-streaming parse publishes: the
        # HIR cache keys off it, and without it the streaming path had no cache.
        _driver_publish_frontend_cache_scope()
        self.ctx.modules = {}
        self.ctx.module_surfaces = nil
        # Phase 1 owns independent scalar text arrays; phase 2 never re-reads a
        # SourceFile field after the load boundary.
        val source_paths = self.ctx.source_paths_owner
        val source_authored_paths = self.ctx.source_authored_paths_owner
        val source_contents = self.ctx.source_contents_owner
        val source_module_names = self.ctx.source_module_names_owner
        var canonical_paths: [text] = []
        for source_path in source_paths:
            val frozen_path = module_surface_canonical_path(source_path)
            if frozen_path == "":
                self.ctx.add_error(
                    "Module surface extraction error: empty canonical path in retained source inventory")
                return false
            canonical_paths = canonical_paths.push(frozen_path)
        val frozen_source_count = source_paths.len()
        if source_authored_paths.len() != frozen_source_count or
           source_contents.len() != frozen_source_count or
           source_module_names.len() != frozen_source_count or
           canonical_paths.len() != frozen_source_count or
           frozen_source_count != self.ctx.sources.len():
            self.ctx.add_error(
                "Module surface extraction error: frozen source inventory length mismatch")
            return false

        var builder = ModuleSurfaceBuilder.new()
        var source_index = 0
        var release_seq: i64 = 0
        while source_index < frozen_source_count:
            val canonical_path = canonical_paths[source_index]
            if builder.has_canonical_path(canonical_path):
                val alias_result = builder.add_alias_canonical_identity(
                    source_module_names[source_index],
                    source_contents[source_index], canonical_path)
                if alias_result.is_err():
                    self.ctx.add_error(
                        "Module surface extraction error: {alias_result.unwrap_err()} source='{source_paths[source_index]}' module='{source_module_names[source_index]}' index={source_index}")
                    return false
            else:
                val parsed_result = self.add_streaming_module_surface(
                    builder,
                    source_paths[source_index],
                    source_authored_paths[source_index],
                    source_contents[source_index],
                    source_module_names[source_index],
                    source_index, canonical_path)
                if parsed_result.is_err():
                    val stream_err = parsed_result.unwrap_err()
                    # Collect-all default, same as parse_all_impl's entry-closure
                    # and plain loops. A parse error leaves no surface for THIS
                    # module, but every other file can still be parsed, so poison
                    # this one and keep going instead of abandoning the remaining
                    # sources. Only parse failures are recoverable here: a scope /
                    # promotion / builder failure is an internal invariant break
                    # and still bails immediately. `par_had_error` is reset per
                    # file in parser_init_with_path, so continuing cannot leak a
                    # stale flag. --fail-fast / SIMPLE_COMPILE_FAIL_FAST=1 restores
                    # stop-at-first via the shared poison_budget cap.
                    if stream_err.starts_with(_STREAM_PARSE_ERROR_PREFIX):
                        self.ctx.add_error(stream_err)
                        val poison_ctx: CompileContext = self.ctx
                        poison_ctx.mark_module_poisoned(source_module_names[source_index])
                        if poison_ctx.poison_budget_exhausted():
                            return false
                        source_index = source_index + 1
                        continue
                    self.ctx.add_error(
                        "Module surface extraction error: {stream_err}")
                    return false
                builder = parsed_result.unwrap()
                release_seq = release_seq + 1
                log_module_surface_released(source_paths[source_index], release_seq)
            source_index = source_index + 1

        # Rebuild the phase-3 record inventory from the retained SoA strings.
        # The original boxed SourceFile records may have been reclaimed even
        # though their promoted field owners remain valid.
        var retained_sources: [SourceFile] = []
        var retained_index = 0
        while retained_index < frozen_source_count:
            retained_sources = retained_sources.push(SourceFile(
                path: source_paths[retained_index],
                authored_path: source_authored_paths[retained_index],
                content: source_contents[retained_index],
                module_name: source_module_names[retained_index]))
            retained_index = retained_index + 1
        self.ctx.sources = retained_sources

        val origin_result = builder.resolve_export_origins()
        if origin_result.is_err():
            self.ctx.add_error(
                "Module surface extraction error: {origin_result.unwrap_err()}")
            return false
        # Build the completed owner inside one dedicated transient scope, then
        # deep-promote the whole registry graph before committing it. Promoting
        # individual surfaces is insufficient: the registry's Dict and aligned
        # name/index arrays are allocated only during finalization.
        if not rt_transient_array_scope_begin():
            self.ctx.add_error(
                "Module surface retention scope unavailable after phase 2")
            return false
        val retained_surfaces = ModuleSurfacesByName(
            surfaces: [], index_by_name: {},
            ordered_names: [], ordered_indices: [], generation: 0, frozen: false)
        val finish_error = builder.finish_into(retained_surfaces)
        if finish_error != "":
            val _paused = rt_transient_array_scope_pause()
            val _ended = rt_transient_array_scope_end()
            self.ctx.add_error(
                "Module surface alignment error: {finish_error}")
            return false
        if not rt_transient_array_scope_pause():
            val _ended = rt_transient_array_scope_end()
            self.ctx.add_error(
                "Module surface retention scope pause failed after phase 2")
            return false
        if not module_surfaces_promote(retained_surfaces):
            val _ended = rt_transient_array_scope_end()
            self.ctx.add_error(
                "Module surface registry graph promotion failed after phase 2")
            return false
        if not rt_transient_array_scope_end():
            self.ctx.add_error(
                "Module surface retention scope end failed after phase 2")
            return false
        val retained_alignment_error = module_surfaces_retained_alignment_error(
            retained_surfaces)
        if retained_alignment_error != "":
            self.ctx.add_error(
                "Module surface registry graph lost after phase 2 retention: {retained_alignment_error}; surfaces={retained_surfaces.surfaces.len()} names={retained_surfaces.ordered_names.len()} indices={retained_surfaces.ordered_indices.len()} dict={retained_surfaces.index_by_name.len()}")
            return false
        # Commit the retained surface owner directly to the mutable driver
        # context.  Assigning it through a copied `streaming_ctx` returned
        # parse_ok=true while the caller still observed module_surfaces=nil
        # under native value semantics.
        self.streaming_module_surfaces_owner = Some(retained_surfaces)
        self.streaming_surface_owner_ready = true
        self.ctx.module_surfaces = Some(retained_surfaces)
        self.ctx.modules = {}
        if driver_parse_shard_active():
            # The streaming parse has no front-end parse cache to warm, and a
            # shard child must never carry on into HIR/MIR/codegen (it did:
            # each child lowered the whole closure in process, N times over).
            print "[parse-shard] done shard={rt_env_get(\"SIMPLE_PARSE_SHARD\") ?? \"\"} parses={flat_parse_module_body_calls()} claimed={driver_parse_shard_claimed()}"
            rt_stdout_flush()
            rt_exit(0)
        # Read the authoritative scalar field directly.  Avoid both a receiver
        # method call and a phase-local boolean: the current native backend has
        # independently mis-lowered each form in this large mutable method.
        self.ctx.error_count_value == 0

    # Compatibility surface for focused driver callers.  Production
    # orchestration uses parse_all_committing_impl so the retained owner never
    # crosses the tuple carrier.
    me parse_all_streaming_surfaces_impl() -> (CompileContext, bool):
        val ok = self.parse_all_streaming_surfaces_in_place_impl()
        (self.ctx, ok)

    me parse_all_committing_impl() -> bool:
        if driver_streaming_surface_enabled(self.ctx):
            return self.parse_all_streaming_surfaces_in_place_impl()
        val (parsed_ctx, parse_ok) = self.parse_all_impl()
        self.ctx = parsed_ctx
        parse_ok

    me parse_all_impl() -> (CompileContext, bool):
        if driver_streaming_surface_enabled(self.ctx):
            return self.parse_all_streaming_surfaces_impl()
        val log = self.ctx.logger
        val sources = self.ctx.sources
        log_debug("parsing sources")
        val native_entry_closure = (
            rt_env_get("SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE") ?? "") == "1"
        val native_entry = rt_env_get("SIMPLE_NATIVE_BUILD_ENTRY") ?? ""
        if native_entry_closure or native_entry != "":
            var entry_modules: Dict<text, ParserModule> = self.ctx.modules
            var entry_sources: [SourceFile] = []
            var entry_idx = 0
            while entry_idx < sources.len():
                val source = sources[entry_idx]
                val requested_entry_match = native_entry != "" and (
                    source.path == native_entry or
                    source.path.ends_with("/" + native_entry))
                if (native_entry_closure or requested_entry_match or
                    _driver_is_bootstrap_entry_source(
                        source.path, source.module_name)):
                    # Refuse a stale substitute when one exact entry was requested.
                    if native_entry != "" and not native_entry_closure:
                        if not requested_entry_match:
                            self.ctx.add_error(
                                "native-build entry mismatch: requested entry '{native_entry}' but resolver also selected '{source.path}' (module {source.module_name}) — refusing silent substitution")
                            return (self.ctx, false)
                    entry_sources = entry_sources.push(source)
                entry_idx = entry_idx + 1
            val unique_entry_sources = _driver_unique_physical_sources(
                entry_sources)
            log_phase(
                "phase2:parse:closure:sources collected={entry_sources.len()} unique={unique_entry_sources.len()}")
            # Avoid native Dict bracket-read corruption with a scalar
            # open-addressed table. Keep ParserModule values behind class
            # handles because large staged-native value arrays also corrupt.
            val parsed_entry_index_capacity = unique_entry_sources.len() * 2 + 1
            var parsed_entry_index_keys: [text] = []
            var parsed_entry_index_values: [i64] = []
            while parsed_entry_index_keys.len() < parsed_entry_index_capacity:
                parsed_entry_index_keys = parsed_entry_index_keys.push("")
                parsed_entry_index_values = parsed_entry_index_values.push(-1)
            var parsed_entry_modules: [ParsedEntryModuleBox] = []
            # Tracked by PHYSICAL KEY, not module_name: entry_sources (the
            # second loop below) can carry alias module_names for the same
            # physical file, which would make an is_module_poisoned(name)
            # lookup miss the alias and fall through to a spurious "internal
            # cache miss" error. The physical key is the identity both loops
            # already use for the index table, so it can't alias.
            var poisoned_physical_keys: [text] = []
            var progress_parse_done = 0
            _driver_publish_frontend_cache_scope()
            log_build_progress("parse", "files", 0,
                unique_entry_sources.len(), "pending", 1, 6, 0, 0, "running")
            for source in unique_entry_sources:
                val physical_key = _driver_physical_source_key(source.path)
                if ((rt_env_get("SIMPLE_COMPILER_TRACE") ?? "") == "1" or
                    (rt_env_get("SIMPLE_INTERP_TRACE") ?? "") == "1"):
                    dtrace(
                        "[BOOTSTRAP-PHASE] phase2:parse:entry {source.path} module={source.module_name}")
                log_phase(
                    "phase2:parse:file:start {source.path} chars={source.content.len()}")
                # In-flight receipt: emitted BEFORE the file is parsed, so a
                # hang names ITS OWN file. The completion receipt below reports
                # the file that just finished, which on a stall is file N-1 and
                # misattributes the offender (2026-08-17: a stall was nearly
                # blamed on src/app/io/sqlite_sffi.spl, the COMPLETED file).
                # done is the count already finished, so `current` here is the
                # unit being worked on, not one that is done.
                log_build_progress("parse", "files", progress_parse_done,
                    unique_entry_sources.len(), source.path,
                    1, 6, 0, 0, "running")
                if not _driver_parse_shard_owns(source.path):
                    progress_parse_done = progress_parse_done + 1
                    continue
                val entry_module = parse_full_frontend(
                    source.content,
                    source.path,
                    source.module_name,
                    self.ctx.logger
                )
                log_phase("phase2:parse:file:done {source.path}")
                if par_had_error_get():
                    # Collect-all default (see driver_hir_pipeline_lowering.spl):
                    # poison this source and keep parsing the rest of the
                    # entry closure so a syntax error in one file doesn't hide
                    # every other file's diagnostics. `par_had_error` is reset
                    # per-file inside parser_init_with_path (parser.spl:254),
                    # so continuing the loop cannot leak a stale flag into the
                    # next source. `--fail-fast` / SIMPLE_COMPILE_FAIL_FAST=1
                    # reproduces the old stop-at-first behavior via the same
                    # poison_budget() cap used by HIR lowering.
                    self.ctx.add_error(
                        "parse error in {source.path} (see [parser_error] output above)")
                    val poison_ctx: CompileContext = self.ctx
                    poison_ctx.mark_module_poisoned(source.module_name)
                    poisoned_physical_keys = poisoned_physical_keys.push(physical_key)
                    if poison_ctx.poison_budget_exhausted():
                        return (self.ctx, false)
                    progress_parse_done = progress_parse_done + 1
                    continue
                if ((rt_env_get("SIMPLE_COMPILER_TRACE") ?? "") == "1" or
                    (rt_env_get("SIMPLE_INTERP_TRACE") ?? "") == "1"):
                    dtrace(
                        "[BOOTSTRAP-PHASE] phase2:parse:entry:done {source.path}")
                var parsed_slot = _driver_text_bucket_index(
                    physical_key, parsed_entry_index_capacity)
                while (parsed_entry_index_keys[parsed_slot] != "" and
                       parsed_entry_index_keys[parsed_slot] != physical_key):
                    parsed_slot = (parsed_slot + 1) % parsed_entry_index_capacity
                parsed_entry_index_keys[parsed_slot] = physical_key
                parsed_entry_index_values[parsed_slot] = parsed_entry_modules.len()
                parsed_entry_modules = parsed_entry_modules.push(
                    ParsedEntryModuleBox.new(entry_module))
                progress_parse_done = progress_parse_done + 1
                # Report EVERY file, not a 64-file cadence. The old cadence (plus
                # a bounded 120..200 window, added after the staged parser ran
                # away between the 128 and 192 receipts) made a stall inside a
                # batch indistinguishable from normal work: on 2026-08-17 stage 3
                # spent >547s on files 577..619 while every sample reported an
                # unchanged done=576, and `current` was stale by up to 63 files,
                # so the offending file could not be named at all. See
                # doc/08_tracking/bug/stage3_parse_stalls_at_tail_43_files_2026-08-17.md
                # ponytail: one receipt per file (619 total) rather than a
                # time-triggered sampler -- the cost is one append per file
                # against a multi-minute phase, and it makes the slow file name
                # itself with no profiler, which is what this host cannot do
                # (ptrace_scope=1, perf_event_paranoid=4).
                log_build_progress("parse", "files", progress_parse_done,
                    unique_entry_sources.len(), source.path,
                    1, 6, 0, 0, "running")
            # The returned context retains only unique_entry_sources below.
            # Publishing every resolver alias here copied the large
            # ParserModule value once per alias under staged-native codegen,
            # growing Stage 3 RSS by roughly 1.5 GiB every 30 seconds after
            # parse completion. Module-surface alias ownership is already
            # preserved separately; materialize only the modules whose source
            # rows survive in the returned context.
            # Receipts for the post-parse surface window. Until 2026-08-17 this
            # whole stretch -- 619 add_parsed calls, the alias pass,
            # resolve_export_origins and finish() -- emitted NOTHING, so a stall
            # here was indistinguishable from a stall in HIR lowering: the last
            # line on the log stayed `parse 619/619 step 1/6` and `phase=hir`
            # never appeared. Stage 3 sat in exactly that state for 30+ minutes
            # at 88% of one core with the main-thread stack at 132 kB (so NOT
            # recursion) and the heap growing 13.5 kB/s (so NOT allocation
            # churn), and no profiler could say which of the four sub-steps it
            # was, because attach-based profiling is blocked on this host
            # (ptrace_scope=1, perf_event_paranoid=4).
            # ponytail: same trade the per-file parse receipts already took --
            # one append per unit against a multi-minute phase, in exchange for
            # the slow sub-step naming itself.
            # doc/08_tracking/bug/stage3_post_parse_surface_window_has_no_receipts_2026-08-17.md
            # One summary per build, same shape as the object-cache summary and
            # emitted only when the cache is actually on, so a non-caching build
            # does not grow a line that always reads hits=0.
            if frontend_parse_cache_enabled():
                print "[frontend-cache] hits={frontend_parse_cache_hits()} misses={frontend_parse_cache_misses()} parses={flat_parse_module_body_calls()}"
            if driver_parse_shard_active():
                # Shard children exist only to warm the cache. Everything after
                # this point (surfaces, HIR, MIR, codegen, link) is the real
                # build's job and must not be duplicated N times.
                print "[parse-shard] done shard={rt_env_get(\"SIMPLE_PARSE_SHARD\") ?? \"\"} parses={flat_parse_module_body_calls()} claimed={driver_parse_shard_claimed()}"
                rt_stdout_flush()
                rt_exit(0)
            var entry_surface_builder = ModuleSurfaceBuilder.new()
            var entry_surface_source_index: i64 = 0
            log_build_progress("surface_build", "files", 0,
                unique_entry_sources.len(), "start", 1, 6, 0, 0, "running")
            for source in unique_entry_sources:
                val physical_key = _driver_physical_source_key(source.path)
                var parsed_idx: i64 = -1
                var parsed_slot = _driver_text_bucket_index(
                    physical_key, parsed_entry_index_capacity)
                while parsed_entry_index_keys[parsed_slot] != "":
                    if parsed_entry_index_keys[parsed_slot] == physical_key:
                        parsed_idx = parsed_entry_index_values[parsed_slot]
                        break
                    parsed_slot = (parsed_slot + 1) % parsed_entry_index_capacity
                if parsed_idx < 0:
                    var is_poisoned_key = false
                    var poisoned_key_idx = 0
                    while poisoned_key_idx < poisoned_physical_keys.len():
                        if poisoned_physical_keys[poisoned_key_idx] == physical_key:
                            is_poisoned_key = true
                            break
                        poisoned_key_idx = poisoned_key_idx + 1
                    if is_poisoned_key:
                        # Expected: this source's parse was poisoned above and
                        # deliberately never entered the index. Not a fresh
                        # internal error -- skip it and let collect-all report
                        # the parse error already recorded for it.
                        continue
                    self.ctx.add_error(
                        "internal entry-closure parse cache miss for {source.path}")
                    return (self.ctx, false)
                # NOTE: `entry_modules = entry_modules.set(k, v)` (fluent-style
                # re-assign) silently failed to insert under native codegen —
                # `entry_modules.keys().len()` and `.contains_key(k)` both read
                # back empty/false immediately after the call. This is the only
                # `.set()` call site on a builtin Dict in 80.driver; every other
                # site (e.g. module_surfaces_add_name, the SIMPLE_BOOTSTRAP
                # branch just below) uses bracket assignment, which works.
                # See doc/07_guide/language/dict_native_pitfalls.md.
                val parsed_box = parsed_entry_modules[parsed_idx]
                if parsed_box == nil:
                    self.ctx.add_error(
                        "internal entry-closure parsed module box missing for {source.path}")
                    return (self.ctx, false)
                entry_modules[source.module_name] = parsed_box.value
                val surface_result = entry_surface_builder.add_parsed(
                    parsed_box.value, source, entry_surface_source_index)
                if surface_result.is_err():
                    self.ctx.add_error(
                        "entry-closure module surface error: {surface_result.unwrap_err()}")
                    return (self.ctx, false)
                entry_surface_source_index = entry_surface_source_index + 1
                log_build_progress("surface_build", "files",
                    entry_surface_source_index, unique_entry_sources.len(),
                    source.path, 1, 6, 0, 0, "running")
            log_build_progress("surface_alias", "aliases", 0,
                entry_sources.len(), "start", 1, 6, 0, 0, "running")
            var entry_alias_done: i64 = 0
            # Keep every resolver spelling as a scalar name -> surface index.
            # ParserModule values remain physical-source unique; copying those
            # large values once per alias caused the Stage3 RSS runaway.
            for alias_source in entry_sources:
                val alias_physical_key = _driver_physical_source_key(alias_source.path)
                var alias_is_poisoned = false
                var alias_poisoned_idx = 0
                while alias_poisoned_idx < poisoned_physical_keys.len():
                    if poisoned_physical_keys[alias_poisoned_idx] == alias_physical_key:
                        alias_is_poisoned = true
                        break
                    alias_poisoned_idx = alias_poisoned_idx + 1
                if alias_is_poisoned:
                    # Preserve the collected parser diagnostic. A poisoned
                    # physical source intentionally has no surface to alias.
                    continue
                val alias_result = entry_surface_builder.add_alias(alias_source)
                if alias_result.is_err():
                    self.ctx.add_error(
                        "entry-closure module alias error: {alias_result.unwrap_err()}")
                    return (self.ctx, false)
                entry_alias_done = entry_alias_done + 1
                log_build_progress("surface_alias", "aliases", entry_alias_done,
                    entry_sources.len(), alias_source.path, 1, 6, 0, 0, "running")
            log_build_progress("export_origins", "surfaces", 0, -1,
                "start", 1, 6, 0, 0, "running")
            val entry_origins_result = entry_surface_builder.resolve_export_origins()
            if entry_origins_result.is_err():
                self.ctx.add_error(
                    "entry-closure export origin error: {entry_origins_result.unwrap_err()}")
                return (self.ctx, false)
            log_build_progress("export_origins", "surfaces", -1, -1,
                "complete", 1, 6, 0, 0, "running")
            log_build_progress("surface_freeze", "surfaces", 0, -1,
                "start", 1, 6, 0, 0, "running")
            val entry_surfaces = ModuleSurfacesByName(
                surfaces: [], index_by_name: {},
                ordered_names: [], ordered_indices: [], generation: 0, frozen: false)
            val entry_surfaces_error = entry_surface_builder.finish_into(entry_surfaces)
            if entry_surfaces_error != "":
                self.ctx.add_error(
                    "entry-closure module surface freeze error: {entry_surfaces_error}")
                return (self.ctx, false)
            log_build_progress("surface_freeze", "surfaces", -1, -1,
                "complete", 1, 6, 0, 0, "running")
            # Commit the entry-closure result IN PLACE and derive the verdict
            # from the authoritative scalar field, exactly as
            # parse_all_streaming_surfaces_in_place_impl already does. The
            # previous form staged the commit into a `var entry_ctx` local and
            # returned the verdict as a negated has_errors() receiver call;
            # under native codegen that receiver call on a freshly reassigned struct
            # local read a stale snapshot and reported errors that were never
            # recorded, so `compile`/`native-build` on a 3-line hello world
            # failed phase 2 with an EMPTY error list ("[ERROR] phase 2 FAILED"
            # and nothing else). The same defect class is already recorded on
            # the streaming path and on `errors_at` in driver_types.spl.
            # doc/08_tracking/bug/stage3_native_build_and_compile_segv_on_hello_world_2026-08-18.md
            self.ctx.modules = entry_modules
            self.ctx.sources = unique_entry_sources
            self.ctx.module_surfaces = Some(entry_surfaces)
            if entry_sources.len() == 0:
                self.ctx.add_error(
                    "native entry source not found: {native_entry}")
            if (rt_env_get("SIMPLE_TRACE_PHASE2") ?? "") != "":
                print "[phase2] entry-closure verdict error_count={self.ctx.error_count_value} errors_len={self.ctx.errors.len()}"
            return (self.ctx, self.ctx.error_count_value == 0)
        if ((rt_env_get("SIMPLE_BOOTSTRAP") ?? "") == "1" and
            (rt_env_get("SIMPLE_BOOTSTRAP_STAGE4") ?? "") != "1"):
            var bootstrap_modules: Dict<text, ParserModule> = self.ctx.modules
            var boot_idx = 0
            while boot_idx < sources.len():
                val source = sources[boot_idx]
                if _driver_is_bootstrap_entry_source(
                    source.path, source.module_name
                ):
                    val entry_module = parse_full_frontend(
                        source.content,
                        source.path,
                        source.module_name,
                        self.ctx.logger
                    )
                    if par_had_error_get():
                        # SIMPLE_BOOTSTRAP=1 (Stage 2/3) took the same
                        # silent-swallow path as the plain loop: a syntax error
                        # in a bootstrap entry source produced no ctx.errors
                        # entry, so Stage-3 failures surfaced as downstream
                        # unresolved-symbol noise instead of the parse error
                        # that caused them. Collect-all applies here too.
                        self.ctx.add_error(
                            "parse error in {source.path} (see [parser_error] output above)")
                        val poison_ctx: CompileContext = self.ctx
                        poison_ctx.mark_module_poisoned(source.module_name)
                        if poison_ctx.poison_budget_exhausted():
                            var boot_poisoned_ctx: CompileContext = self.ctx
                            boot_poisoned_ctx.modules = bootstrap_modules
                            return (boot_poisoned_ctx, false)
                    else:
                        bootstrap_modules[source.module_name] = entry_module
                boot_idx = boot_idx + 1
            boot_idx = 0
            while boot_idx < sources.len():
                val source = sources[boot_idx]
                if not _driver_is_bootstrap_entry_source(
                    source.path, source.module_name
                ):
                    bootstrap_modules[source.module_name] = parser_module_new(
                        name: source.module_name,
                        imports: [],
                        exports: [],
                        domain_blocks: [],
                        functions: {},
                        function_order: [],
                        classes: {},
                        actors: {},
                        actor_order: [],
                        structs: {},
                        enums: {},
                        bitfields: {},
                        traits: {},
                        impls: [],
                        type_aliases: {},
                        constants: {},
                        static_asserts: [],
                        aop_advices: [],
                        di_bindings: [],
                        arch_rules: [],
                        mock_decls: [],
                        tagged_layer: "",
                        layer_dag_edges: ""
                    )
                boot_idx = boot_idx + 1
            # Same defect class as the entry-closure verdict above: commit in
            # place and read the authoritative scalar, never `has_errors()` on
            # a freshly reassigned struct local.
            self.ctx.modules = bootstrap_modules
            return (self.ctx, self.ctx.error_count_value == 0)

        var parsed_modules: Dict<text, ParserModule> = self.ctx.modules
        # M1b wiring (doc/03_plan/compiler/forwarding/
        # zero_cost_layers_c0_c5_staged_implementation_plan_2026-08-07.md):
        # this loop is the one place in parse_all_impl that holds every
        # module's source text (sources[i].content) alongside its freshly
        # parsed ParserModule (tagged_layer, layer_dag_edges) at the same
        # time -- the whole-program view the per-module module_assembly.spl
        # checks structurally cannot have. Collect parallel arrays here and
        # run check_project_layer_calls once after the loop. Only the
        # "plain" parse path below is covered; the streaming-surface,
        # native-entry-closure, and SIMPLE_BOOTSTRAP branches above return
        # early and do not reach this call (see the plan doc note this
        # landing appends for the scoping gap that leaves).
        var layer_wiring_paths: [text] = []
        var layer_wiring_contents: [text] = []
        var layer_wiring_tags: [text] = []
        var layer_wiring_dags: [text] = []
        # Progress on the plain loop too. Until 2026-08-21 only the
        # entry-closure branch reported per-file progress, so a `native-build`
        # without --entry-closure went silent right after
        # `source_closure N/N step 1/6 complete` for the whole interpreted
        # parse of every module (17+ min CPU-bound, 3 GB RSS) and was read as
        # a futex stall. doc/08_tracking/bug/
        # bootstrap_main_native_build_stalls_after_source_closure_2026-08-21.md
        log_build_progress("parse", "files", 0, sources.len(),
            "pending", 1, 6, 0, 0, "running")
        var src_idx = 0
        while src_idx < sources.len():
            val source = sources[src_idx]
            log_build_progress("parse", "files", src_idx, sources.len(),
                source.path, 1, 6, 0, 0, "running")
            log_phase("phase2:parse:file:start {source.path}")
            val module = parse_full_frontend(
                source.content,
                source.path,
                source.module_name,
                self.ctx.logger
            )
            if par_had_error_get():
                # Same collect-all default as the entry-closure loop above and
                # as driver_hir_pipeline_lowering.spl. Before this check the
                # plain loop never consulted par_had_error_get() at all, so a
                # syntax error here was SILENTLY SWALLOWED: the parser flagged
                # it, the loop stored the truncated/empty module anyway, and
                # ctx.errors stayed empty -- the compile either "succeeded" or
                # died later on an unrelated-looking undefined symbol. See
                # doc/08_tracking/bug/
                # plain_parse_loop_never_checks_par_had_error_silent_swallow_2026-08-08.md
                # `par_had_error` is reset per-file in parser_init_with_path
                # (parser.spl:254), so continuing cannot leak a stale flag into
                # the next source. `--fail-fast` / SIMPLE_COMPILE_FAIL_FAST=1
                # restores stop-at-first via the shared poison_budget cap.
                self.ctx.add_error(
                    "parse error in {source.path} (see [parser_error] output above)")
                val poison_ctx: CompileContext = self.ctx
                poison_ctx.mark_module_poisoned(source.module_name)
                if poison_ctx.poison_budget_exhausted():
                    var poisoned_ctx: CompileContext = self.ctx
                    poisoned_ctx.modules = parsed_modules
                    return (poisoned_ctx, false)
                src_idx = src_idx + 1
                continue
            parsed_modules[source.module_name] = module
            layer_wiring_paths.push(source.path)
            layer_wiring_contents.push(source.content)
            layer_wiring_tags.push(module.tagged_layer)
            layer_wiring_dags.push(module.layer_dag_edges)
            src_idx = src_idx + 1

        val layer_call_violations = check_project_layer_calls(
            layer_wiring_paths, layer_wiring_contents, layer_wiring_tags, layer_wiring_dags)
        var lcv_idx = 0
        while lcv_idx < layer_call_violations.len():
            # T13 (doc/03_plan/ui/perf/render_perf_replan_parallel_teams_2026-08-07.md):
            # promoted from an eprint-only warning to a real error.
            # layer_call_wiring's call-edge extraction is still a text
            # heuristic (see that file's header) with documented gaps
            # (no re-export, no wildcard `use module.*`, no aliased import,
            # no fully-qualified inline call -- all false-NEGATIVE gaps, i.e.
            # they make a real violation invisible, not a spurious one). The
            # one known false-POSITIVE gap (a local fn sharing an imported
            # symbol's name) is now fixed at the source
            # (layer_call_scan._local_fn_names shadow check, proven by
            # layer_call_wiring_spec.spl's "M1b promotion" case: that exact
            # case would have failed here before the fix). Only the "plain"
            # parse path above reaches this call -- the streaming-surface,
            # native-entry-closure, and SIMPLE_BOOTSTRAP branches return
            # early and remain uncovered by this gate (see the note above
            # this loop). No module in this repo currently sets
            # `@layer(...)`, so this gate is a documented no-op today
            # (check_project_layer_calls' any_tagged early-out returns []
            # before scanning) and only activates once layer tagging is
            # adopted.
            self.ctx.add_error(layer_call_violations[lcv_idx])
            lcv_idx = lcv_idx + 1

        log_debug("parsing done")
        # Same defect class as the entry-closure verdict above: commit in place
        # and read the authoritative scalar, never `has_errors()` on a freshly
        # reassigned struct local.
        self.ctx.modules = parsed_modules
        (self.ctx, self.ctx.error_count_value == 0)

    fn parse_source(source: SourceFile) -> ParserModule:
        print "[parse_source] start {source.path} module {source.module_name} len {source.content.len()}"
        val module = parse_full_frontend(
            source.content,
            source.path,
            source.module_name,
            self.ctx.logger
        )
        print "[parse_source] done {source.path}"
        if par_had_error_get():
            # Single-module helper: record the diagnostic so a caller that only
            # inspects ctx.errors cannot mistake a truncated AST for a clean
            # parse. No poison_budget/continue here -- there is no loop to
            # continue, and the caller decides what to do with the module.
            self.ctx.add_error(
                "parse error in {source.path} (see [parser_error] output above)")
            self.ctx.mark_module_poisoned(source.module_name)
        module
