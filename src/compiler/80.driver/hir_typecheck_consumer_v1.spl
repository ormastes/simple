# Complete-body read-only HM/frontend/visibility consumer shared by retained
# driver and owned archive leases. No CompileContext/mono/driver orchestration.
use compiler.hir.hir_types.{HirModule}
use compiler.driver.driver_typecheck_severity.{TypecheckPassSeverity}
use compiler.types.type_infer_types.{HmInferContext}
use compiler.types.type_infer.*
use compiler.types.type_infer.format_error.{format_type_infer_error_v1}
use compiler.semantics.visibility_integration.{check_module_visibility}
use compiler.semantics.lint.hir_frontend_diagnostics.{run_hir_frontend_diagnostics, frontend_diag_enabled}

# The only values a typecheck body lease may retain. No HIR/type/symbol roots.
struct HirTypecheckReceiptV1:
    messages: [text]
    warnings: [text]
    errors: [text]

export HirTypecheckReceiptV1, collect_module_typecheck_receipt_v1

# Shared actual-body consumer. Policy is resolved by the caller outside scratch.
pub fn collect_module_typecheck_receipt_v1(
    name: text, m: HirModule, severity: TypecheckPassSeverity
) -> HirTypecheckReceiptV1:
    var warnings: [text] = []
    var errors: [text] = []
    var out: [text] = []
    # Type inference diagnostics (unification / occurs-check / mismatch),
    # including declared-vs-actual return type mismatches.
    var ictx = HmInferContext.with_builtins()
    ictx.infer_module(m)
    var e_idx = 0
    while e_idx < ictx.errors.len():
        val msg = "[typecheck] {name}: " +
            format_type_infer_error_v1(ictx.errors[e_idx])
        out = out.push(msg)
        # E-TYPE-NIL-COMPARE rides this list at the pass's own severity:
        # a non-optional-vs-nil comparison was a unification ERROR here
        # before the rule named it, so under Deny it stays an error (an
        # existing check is never loosened by naming it).
        match severity:
            case TypecheckPassSeverity.Advisory:
                val _ = 0
            case TypecheckPassSeverity.Warn:
                warnings.push(msg)
            case TypecheckPassSeverity.Deny:
                errors.push(msg)
        e_idx = e_idx + 1
    # HIR frontend rules (MEXH007/008/009, W-HIR-INFER-00x): read-only over
    # the lowered module, always warn-first -> never add_error.
    # SIMPLE_FRONTEND_DIAG=0 is the kill switch.
    if frontend_diag_enabled():
        for finding in run_hir_frontend_diagnostics(m):
            val fmsg = "[frontend {finding.code}] {name}: {finding.line}:{finding.col}: in `{finding.function_name}`: {finding.message}"
            out = out.push(fmsg)
            match severity:
                case TypecheckPassSeverity.Advisory:
                    val _ = 0
                case _:
                    warnings.push(fmsg)
    # Visibility diagnostics (cross-module private/friend/package access).
    val vwarnings = check_module_visibility(m, name)
    var v_idx = 0
    while v_idx < vwarnings.len():
        val vw = vwarnings[v_idx]
        val vmsg = "[visibility {vw.code}] {name}: {vw.message}"
        out = out.push(vmsg)
        match severity:
            case TypecheckPassSeverity.Advisory:
                val _ = 0
            case TypecheckPassSeverity.Warn:
                warnings.push(vmsg)
            case TypecheckPassSeverity.Deny:
                errors.push(vmsg)
        v_idx = v_idx + 1
    HirTypecheckReceiptV1(messages: out, warnings: warnings, errors: errors)
