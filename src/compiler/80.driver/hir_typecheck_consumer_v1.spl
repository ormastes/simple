# Complete-body read-only HM/frontend/visibility consumer shared by retained
# driver and owned archive leases. No CompileContext/driver orchestration.
use compiler.hir.hir_types.{HirModule}
use compiler.driver.driver_typecheck_severity.{TypecheckPassSeverity}
use compiler.types.type_infer_types.{HmInferContext, TypeInferError}
use compiler.hir.hir.{HirType, HirTypeKind}
use compiler.types.type_infer.*
use compiler.types.type_infer.format_error.{format_type_infer_error_v1}
use compiler.semantics.visibility_integration.{check_module_visibility}
use compiler.semantics.lint.hir_frontend_diagnostics.{run_hir_frontend_diagnostics, frontend_diag_enabled}
use compiler.types.cfg_decl_check.{cfg_decl_check_module}
use compiler.common.api_signature_facts_v1.{ApiSignatureFactsV1}
use compiler.types.type_infer.api_signature_projection_v1.{project_api_signatures_v1}

# The only values a typecheck body lease may retain. No HIR/type/symbol roots.
struct HirTypecheckReceiptV1:
    messages: [text]
    warnings: [text]
    errors: [text]
    # Retained path only; archive leases keep their existing diagnostic payload.
    # Owned flat observations, never HIR/type/symbol roots or admission evidence.
    api_signatures: ApiSignatureFactsV1? = nil

export HirTypecheckReceiptV1, collect_module_typecheck_receipt_v1

# Shared actual-body consumer. Policy is resolved by the caller outside scratch.
# E-TYPE-FN-VALUE (bug typecheck_accepts_fn_value_for_text_param_2026-11-06).
# A function value (fn name, lambda, `_1` placeholder lambda) unified against a
# plain DATA slot (scalar, text, collection, tuple) is never a representation
# the backend can carry: natively the slot receives a code pointer and the
# callee reads it as text/int (real AV: builder.build(... _1), fixed at the call
# site by 45fb9585333). The HM checker already reports the Mismatch; this makes
# that one class an error at every SIMPLE_TYPECHECK_PROFILE, like cfg-check.
# Named/TypeParam/Infer/Any-like slots stay at pass severity (an alias or a
# generic may legitimately be function-typed).
fn typecheck_type_is_fn_v1(t: HirType) -> bool:
    match t.kind:
        case HirTypeKind.Function(_, _, _): true
        case _: false

fn typecheck_type_is_plain_data_v1(t: HirType) -> bool:
    match t.kind:
        case HirTypeKind.Int(_, _): true
        case HirTypeKind.Float(_): true
        case HirTypeKind.Bool: true
        case HirTypeKind.Char: true
        case HirTypeKind.Str: true
        case HirTypeKind.Array(_, _): true
        case HirTypeKind.Slice(_): true
        case HirTypeKind.Dict(_, _): true
        case HirTypeKind.Tuple(_): true
        case HirTypeKind.Optional(inner):
            typecheck_type_is_plain_data_v1(inner)
        case _: false

pub fn typecheck_error_is_fn_value_into_data_slot_v1(ictx: HmInferContext, err: TypeInferError) -> bool:
    match err:
        case TypeInferError.Mismatch(expected, found, _):
            val e = ictx.resolve(expected)
            val f = ictx.resolve(found)
            if typecheck_type_is_fn_v1(f) and typecheck_type_is_plain_data_v1(e):
                return true
            typecheck_type_is_fn_v1(e) and typecheck_type_is_plain_data_v1(f)
        case _: false

pub fn collect_module_typecheck_receipt_v1(
    name: text, m: HirModule, severity: TypecheckPassSeverity,
    collect_api_signatures: bool = false
) -> HirTypecheckReceiptV1:
    var warnings: [text] = []
    var errors: [text] = []
    var out: [text] = []
    # Type inference diagnostics (unification / occurs-check / mismatch),
    # including declared-vs-actual return type mismatches.
    var ictx = HmInferContext.with_builtins()
    ictx.infer_module(m)
    val signature_facts = if collect_api_signatures:
        Some(project_api_signatures_v1(m, ictx))
    else: nil
    var e_idx = 0
    while e_idx < ictx.errors.len():
        val ierr = ictx.errors[e_idx]
        if typecheck_error_is_fn_value_into_data_slot_v1(ictx, ierr):
            val fmsg = "[typecheck] {name}: E-TYPE-FN-VALUE: " +
                format_type_infer_error_v1(ierr) +
                "|||HELP:a function value cannot be passed where a data value is expected; call it, or check placeholder `_1` scoping"
            out = out.push(fmsg)
            errors.push(fmsg)
            e_idx = e_idx + 1
            continue
        val msg = "[typecheck] {name}: " +
            format_type_infer_error_v1(ierr)
        out = out.push(msg)
        # E-TYPE-NIL-COMPARE rides this list at the pass's own severity:
        # a non-optional-vs-nil comparison was a unification ERROR here
        # before the rule named it, so under Deny it stays an error (an
        # existing check is never loosened by naming it).
        match severity:
            case TypecheckPassSeverity.Advisory:
                val _ = 0
            case TypecheckPassSeverity.Warn:
                warnings.push(msg)
            case TypecheckPassSeverity.Deny:
                errors.push(msg)
        e_idx = e_idx + 1
    # HIR frontend rules (MEXH007/008/009, W-HIR-INFER-00x): read-only over
    # the lowered module, always warn-first -> never add_error.
    # SIMPLE_FRONTEND_DIAG=0 is the kill switch.
    if frontend_diag_enabled():
        for finding in run_hir_frontend_diagnostics(m):
            val fmsg = "[frontend {finding.code}] {name}: {finding.line}:{finding.col}: in `{finding.function_name}`: {finding.message}"
            out = out.push(fmsg)
            match severity:
                case TypecheckPassSeverity.Advisory:
                    val _ = 0
                case _:
                    warnings.push(fmsg)
    # Visibility diagnostics (cross-module private/friend/package access).
    val vwarnings = check_module_visibility(m, name)
    var v_idx = 0
    while v_idx < vwarnings.len():
        val vw = vwarnings[v_idx]
        val vmsg = "[visibility {vw.code}] {name}: {vw.message}"
        out = out.push(vmsg)
        match severity:
            case TypecheckPassSeverity.Advisory:
                val _ = 0
            case TypecheckPassSeverity.Warn:
                warnings.push(vmsg)
            case TypecheckPassSeverity.Deny:
                errors.push(vmsg)
        v_idx = v_idx + 1
    # Decl-level @cfg coherence (E-CFG-*): real errors at every severity, since
    # an overlapping or non-exhaustive guarded declaration is ill-formed, not
    # a style finding. Returns [] immediately for a module with no guarded item.
    for cfg_msg in cfg_decl_check_module(m):
        val cmsg = "[cfg-check] {name}: {cfg_msg}"
        out = out.push(cmsg)
        errors.push(cmsg)
    HirTypecheckReceiptV1(messages: out, warnings: warnings, errors: errors,
        api_signatures: signature_facts)
