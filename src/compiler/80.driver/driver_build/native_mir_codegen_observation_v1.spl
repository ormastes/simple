# Actual native object compilation observation. Raw receipts are evidence only;
# D must bind them to its immutable launch/job ledger before counting overlap.
use compiler.driver.driver_build.native_mir_codegen_interval_admission_v1.{
    NativeMirCodegenIntervalV1, native_mir_codegen_interval_encode_v1,
    native_mir_codegen_job_identity_v1}
use compiler.driver.driver_types.{FrozenNativeModuleCapsuleV1}
use compiler.driver.driver_build.native_mir_worker_object_fragment_v1.{NativeMirWorkerObjectExpectedV1}
use compiler.driver.driver_build.native_mir_worker_object_publish_v1.{native_mir_worker_object_publish_v1}
use std.nogc_sync_mut.io.env_ops.{env_get_nullable}
use std.nogc_sync_mut.io.sysinfo_ops.{getpid_checked, process_start_identity_checked}
use std.io_runtime.{time_now_monotonic_ms}
use std.nogc_sync_mut.io.file_ops.{file_write,
    file_publish_noreplace_raw, file_read_regular_no_follow_bounded}
use std.common.crypto.sha256.{sha256_text}
use std.common.encoding.sha256_contract.{sha256_lower_hex_valid}

pub struct NativeMirCodegenObservationOwnerV1:
    frame: NativeMirCodegenIntervalV1
    path: text
    private_root: text

pub fn native_mir_codegen_observation_begin_v1(module: text
        ) -> Result<NativeMirCodegenObservationOwnerV1?, text>:
    # Legacy workers have no private-process result contract. Do not manufacture
    # receipts for them or alter their compilation behavior.
    val private_root = env_get_nullable("SIMPLE_MIR_WORKER_PRIVATE_ROOT") ?? ""
    if private_root == "": return Ok(nil)
    val queue = env_get_nullable("SIMPLE_MIR_SHARD_QUEUE") ?? ""
    val invocation = env_get_nullable("SIMPLE_MIR_WORKER_INVOCATION") ?? ""
    val source = env_get_nullable("SIMPLE_MIR_WORKER_SOURCE") ?? ""
    val context = env_get_nullable("SIMPLE_MIR_WORKER_CONTEXT") ?? ""
    val manifest = env_get_nullable("SIMPLE_MIR_WORKER_MANIFEST") ?? ""
    val producer = env_get_nullable("SIMPLE_MIR_WORKER_PRODUCER") ?? ""
    # Dynamic claims choose the actual physical module inside this process.
    # Parent admission independently derives this identity from its sealed
    # manifest and matching invocation-owned claim; no launch-wide job env is
    # accepted as evidence of which physical row actually compiled.
    val job = native_mir_codegen_job_identity_v1(manifest, module)
    val worker = env_get_nullable("SIMPLE_MIR_SHARD_OWNER") ?? ""
    for digest in [invocation, source, context, manifest, producer, job]:
        if not sha256_lower_hex_valid(digest): return Err("object codegen observation lacks admitted job identities")
    if queue == "" or queue.contains("\0") or queue.contains("\n") or
            module == "" or module.contains("\0") or module.contains("\n") or
            worker == "" or worker.len() > 1024 or worker.contains("\0") or worker.contains("\n"):
        return Err("object codegen observation lacks its process queue owner")
    val pid = getpid_checked()?
    val birth = process_start_identity_checked(pid)?
    val started = time_now_monotonic_ms()
    if started <= 0: return Err("object codegen observation monotonic start unavailable")
    val frame = NativeMirCodegenIntervalV1(invocation_identity: invocation,
        source_identity: source, context_identity: context,
        physical_manifest_identity: manifest, producer_identity: producer,
        job_identity: job, worker_owner: worker, module: module, pid: pid,
        birth_identity: birth.to_text(), started_ms: started, ended_ms: 0, status: "")
    Ok(Some(NativeMirCodegenObservationOwnerV1(frame: frame,
        path: "{queue}/{sha256_text(module)}.codegen-interval.sdn", private_root: private_root)))

pub fn native_mir_codegen_observation_end_v1(
        owner: NativeMirCodegenObservationOwnerV1?, succeeded: bool) -> Result<bool, text>:
    # Capture the end before encoding or filesystem work. This interval covers
    # selected backend compilation only, not later object/capsule admission.
    if owner == nil: return Ok(true)
    val ended = time_now_monotonic_ms()
    val observed: NativeMirCodegenObservationOwnerV1 = owner.unwrap()
    var frame = observed.frame
    if ended < frame.started_ms or ended <= 0:
        return Err("object codegen observation monotonic end unavailable")
    frame.ended_ms = ended
    frame.status = if succeeded: "PASS" else: "FAIL"
    val blob = native_mir_codegen_interval_encode_v1(frame)?
    val staged = "{observed.path}.staged-{frame.pid}"
    if not file_write(staged, blob): return Err("object codegen interval staging failed")
    val readback = file_read_regular_no_follow_bounded(staged, 16384)?
    if readback != blob: return Err("object codegen interval readback differs")
    if file_publish_noreplace_raw(staged, observed.path) != 1:
        return Err("object codegen interval publication failed or already exists")
    Ok(true)

# Called only after the capsule's actual object receipt has been published and
# read back. PASS timing alone never grants an object result or a parent link.
pub fn native_mir_codegen_observation_publish_object_v1(
        owner: NativeMirCodegenObservationOwnerV1?, capsule: FrozenNativeModuleCapsuleV1
        ) -> Result<bool, text>:
    if owner == nil: return Ok(true)
    val observed: NativeMirCodegenObservationOwnerV1 = owner.unwrap()
    val frame = observed.frame
    val expected = NativeMirWorkerObjectExpectedV1(invocation: frame.invocation_identity,
        owner: frame.worker_owner, private_root: observed.private_root,
        source: frame.source_identity, context: frame.context_identity,
        manifest: frame.physical_manifest_identity, module: frame.module,
        module_source: capsule.source_identity, backend: capsule.backend_name,
        target: capsule.target, provider: capsule.provider_receipt_hash,
        producer: frame.producer_identity, job: frame.job_identity,
        child_pid: frame.pid, child_birth: frame.birth_identity)
    val published = native_mir_worker_object_publish_v1(capsule, expected)?
    Ok(published != "")
