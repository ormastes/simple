# Preserve the admitted ordered root authority independently of closure files.
use std.io_runtime.{dir_exists, file_exists}
use compiler.common.source_root_resolution.{SourceRootResolutionV1}
use compiler.driver.driver_build.native_entry_closure_receipt.{native_entry_closure_root_valid_v1}

pub fn native_source_root_paths_v1(selectors: [text], snapshot_root: text) -> Result<[text], text>:
    if selectors.len() == 0:
        if snapshot_root != "": return Err("SOURCE_ROOT_SELECTORS_MISSING")
        return Ok([])
    if snapshot_root == "" or not dir_exists(snapshot_root):
        return Err("SOURCE_ROOT_SNAPSHOT_MISSING")
    var roots: [text] = []
    for selector in selectors:
        if not native_entry_closure_root_valid_v1(selector):
            return Err("SOURCE_ROOT_SELECTOR_INVALID: " + selector)
        val mapped = snapshot_root + "/" + selector
        if not dir_exists(mapped) and not file_exists(mapped):
            return Err("SOURCE_ROOT_MAPPING_MISSING: " + selector)
        # Do not deduplicate, reorder or normalize selectors at this boundary.
        roots = roots.push(mapped)
    Ok(roots)

pub fn native_source_root_loaded_owner_error_v1(selected: SourceRootResolutionV1, loaded_path: text) -> text:
    match selected:
        case SourceRootResolutionV1.Ambiguous(directory):
            "SOURCE_ROOT_AMBIGUOUS: competing numbered directories under '" + directory + "'"
        case SourceRootResolutionV1.Found(path):
            if loaded_path != "" and loaded_path != path:
                return "SOURCE_ROOT_OWNER_MISMATCH: selected '" + path + "', loaded '" + loaded_path + "'"
            ""
        case SourceRootResolutionV1.Missing: ""
