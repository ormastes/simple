# Incremental Compilation
#
# Hash-based change detection for avoiding unnecessary recompilation.
# Tracks file fingerprints, dependency relationships, and provides
# a build cache with integrity checking.

use std.common.sdn.parser (parse)
use std.common.sdn.value.{SdnValue}
use compiler.driver.cache.integration.shadow_mode.{
    ShadowActionInputs, shadow_enabled, shadow_on_compile_start,
    shadow_on_compile_done, shadow_report
}
use std.nogc_sync_mut.io_runtime.{dir_create_all, dir_list}
use compiler.driver.cache.action_key.{interface_digest_of_source, dependency_interface_fold}
use compiler.driver.cache.reverse_reference_receipt.{
    REVERSE_REFERENCE_FAMILIES_V1, ReverseReferenceProjectionV1,
    ReverseReferenceGenerationReceiptV1, reverse_reference_publish_generation_v1,
    reverse_reference_read_current_v1, reverse_reference_consumers_v1
}
use compiler.common.cache.reverse_reference_key.{ReverseReferenceKeyV1}
use std.common.crypto.sha256.{sha256_text}
use compiler.common.cache.reverse_reference_facts.{
    reverse_reference_owner_snapshot_v1, reverse_reference_owner_mark_known_v1,
    reverse_reference_owner_register_source_alias_v1,
    reverse_reference_owner_source_aliases_v1,
    reverse_reference_register_import_export_v1,
    reverse_reference_register_module_scc_peer_v1
}

pub fn incremental_publish_direct_import_export_v1(subject: text,
        consumer: text, evidence: text):
    reverse_reference_owner_mark_known_v1("direct-import-export")
    reverse_reference_register_import_export_v1(subject, consumer, evidence)

pub fn incremental_publish_module_scc_artifact_v1(subject: text,
        consumer: text, evidence: text):
    reverse_reference_owner_mark_known_v1("module-scc-artifact")
    reverse_reference_register_module_scc_peer_v1(subject, consumer, evidence)

# ============================================================================
# File Fingerprinting
# ============================================================================

extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_size(path: text) -> i64
extern fn rt_file_read_text(path: text) -> text?
extern fn rt_hash_text(content: text) -> i64
extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_file_hash_sha256(path: text) -> text
extern fn rt_cli_get_args() -> [text]
extern fn rt_time_now_unix_micros() -> i64
extern fn rt_getpid() -> i64
extern fn rt_dir_exists(path: text) -> bool
extern fn rt_file_delete(path: text) -> bool
extern fn rt_env_get(key: text) -> text

fn incremental_file_exists(path: text) -> bool:
    rt_file_exists(path)

fn incremental_file_size(path: text) -> i64:
    rt_file_size(path)

# nil = file missing/unreadable. Callers MUST treat nil as a cache MISS — never
# as empty content (an empty text would be hashed/parsed as real content).
fn incremental_file_read_text(path: text) -> text?:
    rt_file_read_text(path)

fn incremental_parse_file(path: text) -> Result<SdnValue, text>:
    if val content = incremental_file_read_text(path):
        return parse(content)
    Err("cache file missing or unreadable: {path}")

fn incremental_hash_text(content: text) -> i64:
    rt_hash_text(content)

var _compiler_src_fingerprint_memo: text = "@@unset@@"
var _frontend_src_fingerprint_memo: text = "@@unset@@"

fn incremental_sift_down(mut values: [text], root_index: i64, heap_len: i64):
    var root = root_index
    while true:
        val left = root * 2 + 1
        if left >= heap_len:
            return

        var largest = root
        if values[largest] < values[left]:
            largest = left
        val right = left + 1
        if right < heap_len and values[largest] < values[right]:
            largest = right
        if largest == root:
            return

        val tmp = values[root]
        values[root] = values[largest]
        values[largest] = tmp
        root = largest

fn incremental_sorted_text(values: [text]) -> [text]:
    var result = values
    if result.len() < 2:
        return result

    # Build a max heap bottom-up, then place each maximum at the shrinking
    # suffix.  This keeps the old byte-for-byte text ordering while reducing
    # every directory sort from quadratic comparisons to O(n log n), with no
    # auxiliary array allocation beyond the existing value-semantics result.
    var start = result.len() / 2
    while start > 0:
        start = start - 1
        incremental_sift_down(result, start, result.len())

    var end = result.len()
    while end > 1:
        end = end - 1
        val tmp = result[0]
        result[0] = result[end]
        result[end] = tmp
        incremental_sift_down(result, 0, end)
    result

fn native_build_compiler_source_fingerprint() -> text:
    """Fingerprint of the live-interpreted compiler sources (src/compiler/**/*.spl).

    The executable sha256 in native_build_compiler_identity() does not change
    when the compiler runs its .spl sources interpreted — editing a lowering in
    src/compiler changed codegen while the cache scope stayed identical, so
    stale objects kept getting linked. Fingerprint the compiler tree: per-file
    "path|size|sha256" lines joined into a manifest, hashed via a temp file
    (rt_hash_text and rt_hash_sha256 are unavailable/broken under the seed
    interpreter). Measured ~90ms for ~2900 files. Directory entries are sorted
    explicitly because [text].sort() is a no-op under the seed interpreter.
    Returns "" when no
    src/compiler tree is visible from the build cwd (deployed binary outside
    a repo) — identity is then unchanged.
    """
    if _compiler_src_fingerprint_memo != "@@unset@@":
        return _compiler_src_fingerprint_memo
    val root = "src/compiler"
    if not rt_dir_exists(root):
        _compiler_src_fingerprint_memo = ""
        return ""
    var lines: [text] = []
    var dirs: [text] = [root]
    var i = 0
    while i < dirs.len():
        val dir = dirs[i]
        i = i + 1
        val entries = incremental_sorted_text(dir_list(dir) ?? [])
        for entry in entries:
            val full = dir + "/" + entry
            if rt_dir_exists(full):
                dirs = dirs.push(full)
            elif entry.ends_with(".spl"):
                lines = lines.push("{full}|{rt_file_size(full)}|{rt_file_hash_sha256(full)}")
    var fp = "unfingerprintable-{rt_getpid()}-{rt_time_now_unix_micros()}"
    dir_create_all("build")
    val tmp = "build/.compiler_src_fp.{rt_getpid()}.tmp"
    if rt_file_write_text(tmp, lines.join("\n")):
        val digest = rt_file_hash_sha256(tmp)
        rt_file_delete(tmp)
        if digest.len() == 64:
            fp = "{digest.substring(0, 16)}n{lines.len()}"
    _compiler_src_fingerprint_memo = fp
    fp

fn native_build_frontend_source_fingerprint() -> text:
    """Fingerprint only parser/cache sources for front-end cache admission.

    Parsed modules are independent of HIR, MIR, and backend implementation
    edits. Binding their cache to the whole compiler tree caused every unrelated
    rendering or codegen change to force a cold multi-thousand-file parse.
    """
    if _frontend_src_fingerprint_memo != "@@unset@@":
        return _frontend_src_fingerprint_memo
    val root = "src/compiler/10.frontend"
    if not rt_dir_exists(root):
        _frontend_src_fingerprint_memo = ""
        return ""
    var lines: [text] = []
    var dirs: [text] = [root]
    var i = 0
    while i < dirs.len():
        val dir = dirs[i]
        i = i + 1
        val entries = incremental_sorted_text(dir_list(dir) ?? [])
        for entry in entries:
            val full = dir + "/" + entry
            if rt_dir_exists(full):
                dirs = dirs.push(full)
            elif entry.ends_with(".spl"):
                lines = lines.push("{full}|{rt_file_size(full)}|{rt_file_hash_sha256(full)}")
    var fp = "unfingerprintable-{rt_getpid()}-{rt_time_now_unix_micros()}"
    dir_create_all("build")
    val tmp = "build/.frontend_src_fp.{rt_getpid()}.tmp"
    if rt_file_write_text(tmp, lines.join("\n")):
        val digest = rt_file_hash_sha256(tmp)
        rt_file_delete(tmp)
        if digest.len() == 64:
            fp = "{digest.substring(0, 16)}n{lines.len()}"
    _frontend_src_fingerprint_memo = fp
    fp

fn native_build_compiler_executable_hash() -> text:
    # Under `simple run <script>` rt_cli_get_args()[0] is the SCRIPT, not the
    # compiler, so each entrypoint script hashed to a different "exe=" identity:
    # parse-shard children (parse_shard_main.spl) and HIR-shard children
    # (native_build_worker.spl) landed in disjoint front-end cache scopes and
    # every HIR child re-parsed the whole closure from source. See
    # doc/08_tracking/bug/hir_shard_children_reparse_closure_2026-08-22.md.
    # The orchestrator publishes the resolved compiler in SIMPLE_BINARY before
    # spawning anything; hash THAT when present so every process of a build
    # (and every build run by the same compiler) shares one identity.
    val simple_bin = rt_env_get("SIMPLE_BINARY") ?? ""
    if simple_bin != "" and rt_file_exists(simple_bin):
        val bin_hash = rt_file_hash_sha256(simple_bin)
        if bin_hash.len() == 64:
            return bin_hash
    val args = rt_cli_get_args()
    if args.len() > 0:
        val hash = rt_file_hash_sha256(args[0])
        if hash.len() == 64:
            return hash
    ""

fn native_build_runtime_artifact(path: text) -> bool:
    path.ends_with(".a") or path.ends_with(".o") or
        path.ends_with(".so") or path.ends_with(".dylib") or
        path.ends_with(".dll") or path.ends_with(".lib")

fn native_build_runtime_provider_fingerprint(runtime_path: text) -> text:
    """Fingerprint the runtime artifacts which can affect native code ABI.

    Runtime provider directories also contain logs, receipts, and native-build
    caches. Hashing the whole directory would make the cache key depend on its
    own outputs. Restrict the manifest to linkable runtime artifacts, while a
    direct runtime archive/object path is hashed as-is. Missing or unreadable
    configured providers return a per-process uncacheable identity.
    """
    if runtime_path == "":
        return "embedded"
    if rt_file_exists(runtime_path) and not rt_dir_exists(runtime_path):
        val direct_hash = rt_file_hash_sha256(runtime_path)
        if direct_hash.len() == 64:
            return "file-{direct_hash}"
        return "unfingerprintable-{rt_getpid()}-{rt_time_now_unix_micros()}"
    if not rt_dir_exists(runtime_path):
        return "missing-{rt_getpid()}-{rt_time_now_unix_micros()}"
    var lines: [text] = []
    # Linkers consume providers directly from SIMPLE_RUNTIME_PATH (-L/path and
    # explicit /path/archive names). Do not recurse: bootstrap cache directories
    # commonly live below this root, and binding their .o files would make the
    # cache key depend on its own outputs.
    val entries = incremental_sorted_text(dir_list(runtime_path) ?? [])
    for entry in entries:
        val full = runtime_path + "/" + entry
        if native_build_runtime_artifact(full) and not rt_dir_exists(full):
            val digest = rt_file_hash_sha256(full)
            if digest.len() != 64:
                return "unfingerprintable-{rt_getpid()}-{rt_time_now_unix_micros()}"
            lines = lines.push("{entry}|{rt_file_size(full)}|{digest}")
    if lines.len() == 0:
        return "empty-{rt_getpid()}-{rt_time_now_unix_micros()}"
    val manifest = lines.join("\n")
    val tmp = "build/.runtime_provider_fp.{rt_getpid()}.tmp"
    if rt_file_write_text(tmp, manifest):
        val digest = rt_file_hash_sha256(tmp)
        rt_file_delete(tmp)
        if digest.len() == 64:
            return "dir-{digest.substring(0, 16)}n{lines.len()}"
    "unfingerprintable-{rt_getpid()}-{rt_time_now_unix_micros()}"

extern fn rt_simple_abi_version() -> i64
extern fn rt_simple_abi_version_deferred() -> i64

fn native_build_abi_receipt_field(content: text, key: text) -> Result<text, text>:
    val prefix = key + "="
    var found = false
    var value = ""
    for raw_line in content.split("\n"):
        val line = raw_line.strip()
        if line.starts_with(prefix):
            if found:
                return Err("duplicate-field:{key}")
            found = true
            value = line.substring(prefix.len())
    if not found or value == "":
        return Err("missing-field:{key}")
    Ok(value)

fn native_build_abi_receipt_required(
    content: text, key: text, expected: text
) -> Result<bool, text>:
    match native_build_abi_receipt_field(content, key):
        case Err(reason): Err(reason)
        case Ok(actual):
            if actual != expected:
                return Err("field-mismatch:{key}:expected={expected}:actual={actual}")
            Ok(true)

fn native_build_canonical_sha256_v1(value: text) -> bool:
    if value.len() != 64:
        return false
    val alphabet = "0123456789abcdef"
    var index = 0
    while index < value.len():
        if not alphabet.contains(value.substring(index, index + 1)):
            return false
        index = index + 1
    true

fn native_build_stage2_admission_identity_v1(
    receipt_content: text
) -> Result<text, text>:
    val keys = [
        "candidate_sha256", "source_snapshot_sha256", "runtime_snapshot_sha256",
        "tool_authority_sha256", "build_args_sha256", "sanity_evidence_sha256",
        "receiver_evidence_sha256", "hosted_runtime_relative_path",
        "hosted_runtime_sha256"]
    var values: [text] = []
    for key in keys:
        match native_build_abi_receipt_field(receipt_content, key):
            case Err(reason): return Err(reason)
            case Ok(value): values.push(value)
    for index in [0, 1, 2, 3, 4, 5, 6, 8]:
        if not native_build_canonical_sha256_v1(values[index]):
            return Err("field-not-canonical-sha256:{keys[index]}")
    if not values[7].starts_with("deps/libspl_hosted_runtime-") or
            not values[7].ends_with(".rlib"):
        return Err("field-invalid:hosted_runtime_relative_path")
    val identity_input =
        "schema=simple-bootstrap-stage2-admission-identity-v1\n" +
        "artifact_sha256={values[0]}\n" +
        "source_snapshot_sha256={values[1]}\n" +
        "runtime_snapshot_sha256={values[2]}\n" +
        "tool_authority_sha256={values[3]}\n" +
        "build_args_sha256={values[4]}\n" +
        "sanity_evidence_sha256={values[5]}\n" +
        "receiver_evidence_sha256={values[6]}\n" +
        "hosted_runtime_relative_path={values[7]}\n" +
        "hosted_runtime_sha256={values[8]}\n"
    Ok(sha256_text(identity_input))

pub fn native_build_admitted_abi_identity(
    policy: text, receipt_content: text,
    runtime_version: i64, runtime_deferred: bool,
    executable_hash: text
) -> Result<text, text>:
    if policy == "":
        return Err("policy-absent")
    if policy != "v1":
        return Err("policy-unknown:{policy}")
    if runtime_version != 1 or runtime_deferred:
        return Err("policy-runtime-mismatch:{policy}:{runtime_version}:{runtime_deferred}")
    if not native_build_canonical_sha256_v1(executable_hash):
        return Err("compiler-executable-digest-not-canonical")

    val runtime_deferred_text = if runtime_deferred: "1" else: "0"
    val required = [
        ("schema", "simple-bootstrap-stage2-admission-v2"),
        ("status", "admitted"),
        ("candidate_sha256", executable_hash),
        ("simple_abi_policy", policy),
        ("simple_abi_version", runtime_version.to_text()),
        ("simple_abi_deferred", runtime_deferred_text),
        ("checks_executed_at_admission", "1"),
        ("checks_replayed_during_stage3", "0")
    ]
    for row in required:
        match native_build_abi_receipt_required(receipt_content, row[0], row[1]):
            case Err(reason): return Err(reason)
            case Ok(_): pass
    val expected_admission_identity = match native_build_stage2_admission_identity_v1(
            receipt_content):
        case Err(reason): return Err(reason)
        case Ok(identity): identity
    match native_build_abi_receipt_required(
            receipt_content, "admission_identity", expected_admission_identity):
        case Err(reason): return Err(reason)
        case Ok(_): pass
    val receipt_digest = sha256_text(receipt_content)
    Ok("policy={policy};version={runtime_version};deferred={runtime_deferred_text};receipt-sha256={receipt_digest}")

pub fn native_build_producer_identity(executable_hash: text,
        compiler_source_fingerprint: text, runtime_provider_fingerprint: text,
        runtime_bundle: text, simple_abi_version: i64,
        simple_abi_deferred: bool, simple_abi_policy: text,
        abi_admission_identity: text) -> text:
    """Canonical cache producer identity; every codegen/ABI authority is bound."""
    val abi_identity = if simple_abi_deferred:
        "deferred"
    else:
        "selected-{simple_abi_version}"
    "exe={executable_hash};compiler={compiler_source_fingerprint};runtime={runtime_provider_fingerprint};bundle={runtime_bundle};simple-abi-policy={simple_abi_policy};simple-abi={abi_identity};simple-abi-admission={abi_admission_identity}"

fn native_build_uncacheable_abi_identity(reason: text) -> text:
    val reason_digest = sha256_text(reason).substring(0, 16)
    "uncacheable-abi-admission-{reason_digest}-{rt_getpid()}-{rt_time_now_unix_micros()}"

fn native_build_compiler_identity() -> text:
    val src_fp = native_build_compiler_source_fingerprint()
    val hash = native_build_compiler_executable_hash()
    if hash != "":
        val compiler_fp = if src_fp == "": "embedded" else: src_fp
        val runtime_path = rt_env_get("SIMPLE_RUNTIME_PATH") ?? ""
        val runtime_bundle = rt_env_get("SIMPLE_NATIVE_RUNTIME_BUNDLE") ?? ""
        val runtime_fp = native_build_runtime_provider_fingerprint(runtime_path)
        val abi_policy = rt_env_get("SIMPLE_ABI_POLICY") ?? ""
        val abi_receipt_path = rt_env_get("SIMPLE_ABI_ADMISSION_RECEIPT") ?? ""
        if abi_policy == "" or abi_receipt_path == "":
            return native_build_uncacheable_abi_identity("explicit-policy-or-receipt-absent")
        val abi_receipt = incremental_file_read_text(abi_receipt_path)
        if abi_receipt == nil:
            return native_build_uncacheable_abi_identity("receipt-unreadable:{abi_receipt_path}")
        val abi_version = rt_simple_abi_version()
        val abi_deferred = rt_simple_abi_version_deferred() != 0
        match native_build_admitted_abi_identity(
            abi_policy, abi_receipt.unwrap(), abi_version, abi_deferred, hash):
            case Err(reason):
                return native_build_uncacheable_abi_identity(reason)
            case Ok(admission_identity):
                return native_build_producer_identity(hash, compiler_fp, runtime_fp,
                    runtime_bundle, abi_version, abi_deferred, abi_policy,
                    admission_identity)
    # Fail closed: an unknown compiler must not reuse another compiler's cache.
    "uncacheable-{rt_getpid()}-{rt_time_now_unix_micros()}"

pub fn native_build_frontend_identity() -> text:
    """Identity of the interpreter and front-end sources that create .fpc data."""
    val frontend_fp = native_build_frontend_source_fingerprint()
    val hash = native_build_compiler_executable_hash()
    if hash != "" and frontend_fp != "":
        return "frontend-exe={hash};sources={frontend_fp}"
    "uncacheable-{rt_getpid()}-{rt_time_now_unix_micros()}"

pub fn native_build_cache_lane() -> text:
    """Declared private-cache lane for this process.

    Concurrent bootstrap lanes (phase-1 seed, phase-2 stage, phase-3 self-host,
    phase-4 full CLI, census, tool builds) may run DIFFERENT compiler binaries
    over the SAME source tree. Compiler identity alone is not enough: two lanes
    can legitimately share a binary and still must not share cache entries, and
    a lane must be able to DECLARE its cache private rather than depend on a
    fingerprint that a mid-run redeploy changes underneath it.

    Unset means `default`, which reproduces the previous single-lane behaviour
    exactly. See doc/05_design/compiler/incremental_build/per_lane_private_caches.md
    """
    val lane = rt_env_get("SIMPLE_CACHE_SCOPE") ?? ""
    if lane == "":
        return "default"
    lane

fn native_build_cache_scope_key(
    backend: text?, target_cpu: text?, target_features: [text],
    optimization: i32, compiler_identity: text,
    provider_receipt_hash: text = "",
    optimizer_kernel_receipt_hash: text = ""
) -> text:
    val backend_text = match backend:
        case Some(name): name
        case nil: "smf"
    val cpu_text = match target_cpu:
        case Some(cpu): cpu
        case nil: "native"
    val feature_text = target_features.join(",")
    val lane = native_build_cache_lane()
    # Built-in providers remain compiler-bound until their admitted receipt is
    # wired by the AOT owner. A dynamic/versioned provider supplies its receipt
    # hash here, so changing provider version/build/ABI cannot reuse objects
    # produced under a different admitted provider.
    val provider_identity = if provider_receipt_hash == "":
        "compiler-bound-builtin:{backend_text}"
    else:
        "receipt:{provider_receipt_hash}"
    val optimizer_identity = if optimizer_kernel_receipt_hash == "":
        "compiler-bound-optimizer"
    else:
        "receipt:{optimizer_kernel_receipt_hash}"
    "lane={lane};backend={backend_text};cpu={cpu_text};features={feature_text};opt={optimization};compiler={compiler_identity};provider={provider_identity};optimizer={optimizer_identity}"

fn incremental_mkdir_p(path: text) -> bool:
    dir_create_all(path)

fn incremental_file_write_text(path: text, content: text) -> bool:
    rt_file_write_text(path, content)

fn incremental_parent_dir(path: text) -> text:
    val slash = path.last_index_of("/")
    if slash <= 0:
        return ""
    path.substring(0, slash)

fn incremental_sdn_escape(value: text) -> text:
    val slash_escaped = value.replace("\\", "\\\\")
    slash_escaped.replace("\"", "\\\"")

fn incremental_sdn_text_array(values: [text]) -> text:
    var items: [text] = []
    for value in values:
        items = items.push("\"{incremental_sdn_escape(value)}\"")
    "[" + items.join(", ") + "]"

fn incremental_reverse_reference_generation_v1(cache: BuildCache) ->
        ReverseReferenceGenerationReceiptV1:
    val sources = incremental_sorted_text(cache.entries.keys())
    var generation_facts: [text] = []
    for source in sources:
        val entry = cache.entries[source]
        generation_facts = generation_facts.push(
            "{source.len()}:{source}{entry.fingerprint.content_hash.len()}:{entry.fingerprint.content_hash}")
    val root_generation = sha256_text(generation_facts.join(""))
    val owner_generation = sha256_text(
        "build-cache-state:{root_generation}")
    val snapshot = reverse_reference_owner_snapshot_v1()
    var projections: [ReverseReferenceProjectionV1] = []
    var unresolved_families: {text: bool} = {}
    for family in REVERSE_REFERENCE_FAMILIES_V1:
        val registry_kind = if family == "aop-consumer": "aop"
            elif family == "module-scc-artifact": "native"
            elif family == "emitted-symbol-relocation": "linker"
            else: "semantic"
        var family_has_fact = false
        for fact in snapshot.facts:
            if fact.projection_kind == family:
                family_has_fact = true
        if not snapshot.known_families.contains(family):
            projections = projections.push(ReverseReferenceProjectionV1(
                key: ReverseReferenceKeyV1(
                    registry_kind: registry_kind,
                    owner_generation: owner_generation,
                    root_generation: root_generation,
                    subject_identity: "@unknown-family",
                    projection_kind: family,
                    projection_digest: sha256_text("unknown-family:{family}"),
                    schema_version: 1),
                consumer_identity: "registry-not-published:{family}"))
        elif not family_has_fact:
            projections = projections.push(ReverseReferenceProjectionV1(
                key: ReverseReferenceKeyV1(
                    registry_kind: registry_kind,
                    owner_generation: owner_generation,
                    root_generation: root_generation,
                    subject_identity: "@known-empty-family",
                    projection_kind: family,
                    projection_digest: sha256_text("known-empty-family:{family}"),
                    schema_version: 1),
                consumer_identity: "registry-published-empty:{family}"))
    for fact in snapshot.facts:
        val registry_kind = if fact.projection_kind == "aop-consumer": "aop"
            elif fact.projection_kind == "module-scc-artifact": "native"
            elif fact.projection_kind == "emitted-symbol-relocation": "linker"
            else: "semantic"
        var subjects = reverse_reference_owner_source_aliases_v1(
            fact.subject_identity)
        var consumers = reverse_reference_owner_source_aliases_v1(
            fact.consumer_identity)
        if cache.entries.contains_key(fact.subject_identity):
            subjects = [fact.subject_identity]
        if cache.entries.contains_key(fact.consumer_identity):
            consumers = [fact.consumer_identity]
        if subjects.len() == 0 or consumers.len() == 0:
            unresolved_families[fact.projection_kind] = true
            continue
        for subject_source in subjects:
            for consumer_source in consumers:
                projections = projections.push(ReverseReferenceProjectionV1(
                    key: ReverseReferenceKeyV1(
                        registry_kind: registry_kind,
                        owner_generation: owner_generation,
                        root_generation: root_generation,
                        subject_identity: subject_source,
                        projection_kind: fact.projection_kind,
                        projection_digest: fact.evidence_digest,
                        schema_version: 1),
                    consumer_identity: consumer_source))
    for family in unresolved_families.keys():
        var retained: [ReverseReferenceProjectionV1] = []
        for projection in projections:
            if projection.key.projection_kind != family:
                retained = retained.push(projection)
        val registry_kind = if family == "aop-consumer": "aop"
            elif family == "module-scc-artifact": "native"
            elif family == "emitted-symbol-relocation": "linker"
            else: "semantic"
        retained = retained.push(ReverseReferenceProjectionV1(
            key: ReverseReferenceKeyV1(
                registry_kind: registry_kind,
                owner_generation: owner_generation,
                root_generation: root_generation,
                subject_identity: "@unknown-family",
                projection_kind: family,
                projection_digest: sha256_text("unresolved-source-identity:{family}"),
                schema_version: 1),
            consumer_identity: "registry-source-identity-unresolved:{family}"))
        projections = retained
    ReverseReferenceGenerationReceiptV1(
        schema_version: 1,
        owner_generation: owner_generation,
        root_generation: root_generation,
        projections: projections)

fn incremental_reverse_reference_generation_identity_v1(
        entries: {text: DependencyEntry}) -> (text, text):
    val sources = incremental_sorted_text(entries.keys())
    var generation_facts: [text] = []
    for source in sources:
        val entry = entries[source]
        generation_facts = generation_facts.push(
            "{source.len()}:{source}{entry.fingerprint.content_hash.len()}:{entry.fingerprint.content_hash}")
    val root_generation = sha256_text(generation_facts.join(""))
    (sha256_text("build-cache-state:{root_generation}"), root_generation)

struct FileFingerprint:
    """Content hash + metadata for a source file."""
    path: text
    content_hash: text      # SHA-256 of file content
    modified_time: i64      # Unix timestamp
    size: i64               # File size in bytes

impl FileFingerprint:
    static fn from_file(path: text) -> FileFingerprint?:
        """Create fingerprint from a file on disk."""

        if not incremental_file_exists(path):
            return nil

        # Text read is nil for a missing OR non-UTF-8 file. Object files
        # (.o, fingerprinted by the native capsule receipt) are binary, so
        # fall back to a byte-level digest; only a vanished file is a miss.
        var hash = ""
        val content_opt = incremental_file_read_text(path)
        if val content = content_opt:
            hash = incremental_hash_text(content).to_text()
        else:
            hash = rt_file_hash_sha256(path)
            if hash == "":
                return nil
        val size = incremental_file_size(path)
        val mtime = 0
        Some(FileFingerprint(path: path, content_hash: hash,
                             modified_time: mtime, size: size))

    static fn quick_changed(path: text, cached: FileFingerprint) -> bool:
        """Fast check using size only — avoids read+hash when size unchanged."""
        if not incremental_file_exists(path):
            return true
        val current_size = incremental_file_size(path)
        current_size != cached.size

    fn matches(other: FileFingerprint) -> bool:
        """Check if two fingerprints match (same content)."""
        self.content_hash == other.content_hash

    fn is_stale(other: FileFingerprint) -> bool:
        """Check if the other fingerprint is newer."""
        self.content_hash != other.content_hash

# ============================================================================
# Dependency Tracking
# ============================================================================

# Fail-closed fold of the dependencies' INTERFACE digests (Phase D wiring,
# 2026-08-18). Returns nil when any dependency source is missing/unreadable —
# the caller must treat nil as "cannot validate, recompile", never as
# "unchanged". A dependency's body-only edit leaves the fold unchanged; a
# signature edit changes it.
fn incremental_dependency_interface_fold(dep_paths: [text]) -> text?:
    var entries: [text] = []
    for p in dep_paths:
        if not incremental_file_exists(p):
            return nil
        val src_opt = incremental_file_read_text(p)
        if val src = src_opt:
            if src == "":
                return nil
            entries.push("{p}={interface_digest_of_source(src)}")
        else:
            return nil
    Some(dependency_interface_fold(entries))

struct DependencyEntry:
    """Tracks what a file depends on."""
    source: text            # Source file path
    fingerprint: FileFingerprint
    dependencies: [text]    # Files this source imports/uses
    outputs: [text]         # Generated artifact paths
    deps_iface: text        # dependency_interface_fold at compile time; "" = unknown (fail closed)
    interface_digest: text  # source public interface at publication time
    # Versioned per-module semantic witness. A complete exact match is the
    # admission authority; the closure-wide fingerprint is comparison metadata.
    module_witness: text

val NATIVE_MODULE_CACHE_WITNESS_CORRUPT_V1: text =
    "native-module-cache-witness-corrupt-v1"

impl DependencyEntry:
    fn needs_recompile(current: FileFingerprint, dep_cache: {text: FileFingerprint}) -> bool:
        """Check if this entry needs recompilation."""
        # Source file changed
        val self_fp: FileFingerprint = self.fingerprint
        if self_fp.is_stale(current):
            return true
        # Any dependency changed — quick size check before full hash
        for dep in self.dependencies:
            if dep_cache.has(dep):
                val cached: FileFingerprint = dep_cache[dep]
                if FileFingerprint.quick_changed(dep, cached):
                    # Size changed — definitely stale, skip expensive hash
                    return true
                val fresh = FileFingerprint.from_file(dep)
                if val fresh_fingerprint = fresh:
                    if cached.is_stale(fresh_fingerprint):
                        return true
        false

# ============================================================================
# Change Detection
# ============================================================================

enum ChangeKind:
    Added
    Modified
    Deleted
    DependencyChanged

struct IncrChange:
    path: text
    kind: ChangeKind

struct IncrChangeSet:
    """Set of changes detected since last build."""
    changes: [IncrChange]

impl IncrChangeSet:
    static fn empty() -> IncrChangeSet:
        IncrChangeSet(changes: [])

    fn add(path: text, kind: ChangeKind) -> IncrChangeSet:
        IncrChangeSet(changes: self.changes.push(IncrChange(path: path, kind: kind)))

    fn is_empty() -> bool:
        self.changes.len() == 0

    fn changed_files() -> [text]:
        var out: [text] = []
        for item in self.changes:
            out = out.push(item.path)
        out

    fn added() -> [text]:
        var out: [text] = []
        for item in self.changes:
            if item.kind == ChangeKind.Added:
                out = out.push(item.path)
        out

    fn modified() -> [text]:
        var out: [text] = []
        for item in self.changes:
            if item.kind == ChangeKind.Modified:
                out = out.push(item.path)
        out

    fn deleted() -> [text]:
        var out: [text] = []
        for item in self.changes:
            if item.kind == ChangeKind.Deleted:
                out = out.push(item.path)
        out

# Append missing cached paths without repeatedly scanning source_files.  The
# membership index is deliberately local: it is derived from this invocation,
# so it cannot become stale when callers construct BuildCache directly or
# reuse the cache after an invalidation.
fn incremental_append_deleted_changes(changes: IncrChangeSet,
                                      source_files: [text],
                                      cached_paths: [text]) -> IncrChangeSet:
    var result = changes
    var source_paths: {text: bool} = {}
    for path in source_files:
        source_paths[path] = true

    # Keep cached_paths order exactly; only membership changes from a linear
    # source_files scan to an expected-constant-time dictionary lookup.
    for path in cached_paths:
        if not source_paths.contains_key(path):
            result = result.add(path, ChangeKind.Deleted)
    result

# Append the direct dependents of existing Added/Modified changes.  `changes`
# stays the ordering authority; changed_paths is membership-only and is
# updated at the same point as every append.  DependencyChanged entries
# deliberately do not propagate again: this retains the established one-hop
# invalidation contract independently of for-loop array snapshot semantics.
var _incremental_reverse_reference_fallback_reason_v1: text = ""

fn incremental_propagate_dependency_changes(changes: IncrChangeSet,
                                            entries: {text: DependencyEntry},
                                            cache_path: text) -> IncrChangeSet:
    var result = changes
    var changed_paths: {text: bool} = {}
    for change in result.changes:
        changed_paths[change.path] = true

    val entry_sources = incremental_sorted_text(entries.keys())
    val receipt_read = reverse_reference_read_current_v1(cache_path)
    if not receipt_read.valid:
        _incremental_reverse_reference_fallback_reason_v1 = receipt_read.reason
        for src in entry_sources:
            if not changed_paths.contains_key(src):
                changed_paths[src] = true
                result = result.add(src, ChangeKind.DependencyChanged)
        return result
    val expected_generation = incremental_reverse_reference_generation_identity_v1(entries)
    if receipt_read.receipt == nil or
            receipt_read.receipt!.owner_generation != expected_generation.0 or
            receipt_read.receipt!.root_generation != expected_generation.1:
        _incremental_reverse_reference_fallback_reason_v1 = "stale-generation"
        for src in entry_sources:
            if not changed_paths.contains_key(src):
                changed_paths[src] = true
                result = result.add(src, ChangeKind.DependencyChanged)
        return result
    _incremental_reverse_reference_fallback_reason_v1 = ""
    var change_index: i64 = 0
    while change_index < result.changes.len():
        val change = result.changes[change_index]
        match change.kind:
            case Added | Modified | DependencyChanged:
                var selected_families = REVERSE_REFERENCE_FAMILIES_V1
                if change.kind == ChangeKind.Modified and
                        entries.contains_key(change.path):
                    val recorded_interface = entries[change.path].interface_digest
                    val current_source = incremental_file_read_text(change.path)
                    if recorded_interface != "" and current_source != nil and
                            interface_digest_of_source(current_source!) == recorded_interface:
                        # A private-body edit cannot alter semantic lookup
                        # consumers. Follow only proven native/SCC and emitted
                        # relocation consumers; the edited source itself is
                        # already present in `changes`.
                        selected_families = [
                            "module-scc-artifact",
                            "emitted-symbol-relocation"
                        ]
                for family in selected_families:
                    val lookup = reverse_reference_consumers_v1(
                        receipt_read, change.path, family)
                    if not lookup.exact:
                        _incremental_reverse_reference_fallback_reason_v1 = lookup.fallback_reason
                        for src in entry_sources:
                            if not changed_paths.contains_key(src):
                                changed_paths[src] = true
                                result = result.add(src, ChangeKind.DependencyChanged)
                        return result
                    for src in lookup.consumers:
                        if entries.contains_key(src) and not changed_paths.contains_key(src):
                            changed_paths[src] = true
                            result = result.add(src, ChangeKind.DependencyChanged)
            case Deleted:
                _incremental_reverse_reference_fallback_reason_v1 = "unknown-change-kind-deleted"
                for src in entry_sources:
                    if not changed_paths.contains_key(src):
                        changed_paths[src] = true
                        result = result.add(src, ChangeKind.DependencyChanged)
                return result
        change_index = change_index + 1
    result

struct IncrementalCompileResult:
    files: [text]
    changes: IncrChangeSet

# ============================================================================
# Build Cache
# ============================================================================

class BuildCache:
    """Persistent build cache with integrity checking.

    Stores fingerprints and dependency info between builds.
    Serialized to .build_cache.sdn in project root.
    """
    entries: {text: DependencyEntry}
    fingerprints: {text: FileFingerprint}
    cache_path: text
    version: i64

impl BuildCache:
    static fn empty(cache_path: text) -> BuildCache:
        BuildCache(entries: {}, fingerprints: {}, cache_path: cache_path, version: 0)

    static fn load(cache_path: text) -> BuildCache:
        """Load cache from disk, or create empty if not found."""
        if not incremental_file_exists(cache_path):
            return BuildCache.empty(cache_path)

        # Construct the returned BuildCache OUTSIDE the match arm: values
        # born inside a match arm have broken method-receiver transport on
        # the stage4 native lane (the first self field access traps) — same
        # defect family as CodegenOutput.to_compiled_module.
        var version: i64 = 0
        var entries: {text: DependencyEntry} = {}
        var fingerprints: {text: FileFingerprint} = {}
        var parse_ok = false
        match incremental_parse_file(cache_path):
            case Ok(sdn_value):
                parse_ok = true
                val ver = sdn_value.get("version")
                if val ver_value_raw = ver:
                    val ver_value: SdnValue = ver_value_raw
                    val v = ver_value.as_i64()
                    if val parsed_version = v:
                        version = parsed_version

                val entries_val = sdn_value.get("entries")
                if val entries_value_raw = entries_val:
                    val entries_value: SdnValue = entries_value_raw
                    val arr = entries_value.as_array()
                    if val entries_array = arr:
                        for item_raw in entries_array:
                            val item: SdnValue = item_raw
                            val src = item.get("source")
                            var source_value: SdnValue = item
                            if val source_entry_raw = src:
                                val source_entry: SdnValue = source_entry_raw
                                source_value = source_entry
                            else:
                                continue
                            val source_str = source_value.as_str()
                            var source = ""
                            if val source_text = source_str:
                                source = source_text
                            else:
                                continue

                            # Parse fingerprint
                            var fp_hash = ""
                            var fp_size: i64 = 0
                            var fp_mtime: i64 = 0
                            val fp_val = item.get("fingerprint")
                            if val fp_obj_raw = fp_val:
                                val fp_obj: SdnValue = fp_obj_raw
                                val h = fp_obj.get("hash")
                                if val hash_value_raw = h:
                                    val hash_value: SdnValue = hash_value_raw
                                    val hs = hash_value.as_str()
                                    if val parsed_hash = hs:
                                        fp_hash = parsed_hash
                                val s = fp_obj.get("size")
                                if val size_value_raw = s:
                                    val size_value: SdnValue = size_value_raw
                                    val si = size_value.as_i64()
                                    if val parsed_size = si:
                                        fp_size = parsed_size
                                val m = fp_obj.get("modified_time")
                                if val mtime_value_raw = m:
                                    val mtime_value: SdnValue = mtime_value_raw
                                    val mi = mtime_value.as_i64()
                                    if val parsed_mtime = mi:
                                        fp_mtime = parsed_mtime

                            val fp = FileFingerprint(
                                path: source, content_hash: fp_hash,
                                modified_time: fp_mtime, size: fp_size)

                            # Parse dependencies
                            var deps: [text] = []
                            val deps_val = item.get("dependencies")
                            if val deps_value_raw = deps_val:
                                val deps_value: SdnValue = deps_value_raw
                                val deps_arr = deps_value.as_array()
                                if val dep_items = deps_arr:
                                    for d_raw in dep_items:
                                        val d: SdnValue = d_raw
                                        val ds = d.as_str()
                                        if val dep_text = ds:
                                            deps = deps.push(dep_text)

                            # Parse outputs
                            var outs: [text] = []
                            val outs_val = item.get("outputs")
                            if val outs_value_raw = outs_val:
                                val outs_value: SdnValue = outs_value_raw
                                val outs_arr = outs_value.as_array()
                                if val out_items = outs_arr:
                                    for o_raw in out_items:
                                        val o: SdnValue = o_raw
                                        val os = o.as_str()
                                        if val out_text = os:
                                            outs = outs.push(out_text)

                            # deps_iface: absent in pre-2026-08-18 rows -> ""
                            # -> the entry fails closed in has_cached_object.
                            var deps_iface = ""
                            val di_val = item.get("deps_iface")
                            if val di_raw = di_val:
                                val di: SdnValue = di_raw
                                val di_str = di.as_str()
                                if val di_text = di_str:
                                    deps_iface = di_text

                            # Absent on legacy rows. Shadow comparison reports
                            # this as `legacy-missing`; it never changes the
                            # authoritative closure-scoped hit decision.
                            var module_witness = ""
                            val mw_val = item.get("module_witness")
                            if val mw_raw = mw_val:
                                val mw: SdnValue = mw_raw
                                val mw_str = mw.as_str()
                                if val mw_text = mw_str:
                                    module_witness = mw_text
                                else:
                                    # Field exists but has the wrong schema
                                    # type; keep it distinct from an old row
                                    # where the optional field was absent.
                                    module_witness = NATIVE_MODULE_CACHE_WITNESS_CORRUPT_V1

                            var interface_digest = ""
                            val id_val = item.get("interface_digest")
                            if val id_raw = id_val:
                                val id_value: SdnValue = id_raw
                                val id_str = id_value.as_str()
                                if val id_text = id_str:
                                    interface_digest = id_text

                            val entry = DependencyEntry(
                                source: source, fingerprint: fp,
                                dependencies: deps, outputs: outs,
                                deps_iface: deps_iface,
                                interface_digest: interface_digest,
                                module_witness: module_witness)
                            entries[source] = entry
                            fingerprints[source] = fp

                ()
            case Err(error):
                parse_ok = false
        if not parse_ok:
            return BuildCache.empty(cache_path)
        BuildCache(entries: entries, fingerprints: fingerprints,
                   cache_path: cache_path, version: version)

    me save() -> bool:
        """Persist cache to disk."""
        build_cache_persist(self)

    me update_entry(source: text, fingerprint: FileFingerprint,
                    dependencies: [text], outputs: [text],
                    module_witness: text = ""):
        """Update or create a cache entry.

        deps_iface is computed HERE, at record time, so the entry's validity is
        pinned to the dependencies' interfaces as they were when the artifact
        was produced. If any dependency is unreadable the fold is nil and ""
        is stored — has_cached_object then fails closed on this entry."""
        build_cache_record_entry_with_fp(self, source, fingerprint,
            dependencies, outputs, module_witness)

    me remove_entry(source: text):
        self.entries.remove(source)
        self.fingerprints.remove(source)

    fn has_cached_object(source: text) -> bool:
        """Check if source has a cached entry with fresh fingerprint and existing outputs."""
        # contains_key + index read, never `.get()`: a native struct-valued
        # `Dict.get()` HIT hands back a non-nil Option whose payload is the
        # value's heap pointer shifted by 3, so `entry.fingerprint` segfaults.
        # See doc/07_guide/language/dict_native_pitfalls.md
        # The staleness check stays inlined as a direct field comparison: a
        # method call on the struct-FIELD receiver
        # (entry.fingerprint.is_stale(..)) hits the stage4 receiver-transport
        # defect.
        build_cache_entry_is_valid(self, source)

    fn get_cached_outputs(source: text) -> [text]?:
        """Return cached output paths if entry is fresh, else nil."""
        if not self.has_cached_object(source):
            return nil
        # contains_key + index read, never `.get()`.
        # See doc/07_guide/language/dict_native_pitfalls.md
        if self.entries.contains_key(source):
            return self.entries[source].outputs
        nil

    me invalidate(source: text):
        """Remove a stale entry."""
        self.remove_entry(source)

    fn get_entry(source: text) -> DependencyEntry?:
        # contains_key guards the missing case, the index read delivers the
        # present value; a native struct-valued `.get()` HIT is corrupt.
        # See doc/07_guide/language/dict_native_pitfalls.md
        if not self.entries.contains_key(source):
            return nil
        Some(self.entries[source])

    fn detect_changes(source_files: [text]) -> IncrChangeSet:
        """Detect changes since last build."""
        var changes = IncrChangeSet.empty()

        # Check for modified and added files
        for path in source_files:
            val fresh = FileFingerprint.from_file(path)
            var fresh_fingerprint = FileFingerprint(path: path, content_hash: "", size: 0, modified_time: 0)
            if val fingerprint = fresh:
                fresh_fingerprint = fingerprint
            else:
                continue
            if not self.fingerprints.has(path):
                changes = changes.add(path, ChangeKind.Added)
            else:
                val cur_fp: FileFingerprint = self.fingerprints[path]
                if cur_fp.is_stale(fresh_fingerprint):
                    changes = changes.add(path, ChangeKind.Modified)

        changes = incremental_append_deleted_changes(
            changes, source_files, self.fingerprints.keys())

        incremental_propagate_dependency_changes(changes, self.entries, self.cache_path)

    me invalidate_all():
        """Clear entire cache."""
        self.entries = {}
        self.fingerprints = {}
        self.version = self.version + 1

    fn integrity_check() -> bool:
        """Verify cache integrity."""
        # BUG-001 fix: Use keys()-based iteration (for (k,v) in dict is broken in compiled mode)
        for path in self.fingerprints.keys():
            val fp = self.fingerprints[path]
            val fresh = FileFingerprint.from_file(path)
            if not fresh.?:
                return false
        true

# ============================================================================
# Incremental Compiler
# ============================================================================

class IncrementalCompiler:
    """Orchestrates incremental compilation using build cache."""
    cache: BuildCache
    source_root: text
    symbol_hashes: {text: {text: text}}
    cached_mir_index: {text: [text]}

impl IncrementalCompiler:
    static fn create(source_root: text, cache_path: text) -> IncrementalCompiler:
        val cache = BuildCache.load(cache_path)
        IncrementalCompiler(cache: cache, source_root: source_root,
                            symbol_hashes: {}, cached_mir_index: {})

    me compile_incremental(source_files: [text]) -> IncrementalCompileResult:
        """Determine which files need recompilation.

        Returns (files_to_compile, change_set).
        """
        val changes = self.cache.detect_changes(source_files)

        if changes.is_empty():
            return IncrementalCompileResult(files: [], changes: changes)

        val to_compile = changes.changed_files()
        IncrementalCompileResult(files: to_compile, changes: changes)

    me record_compilation(source: text, dependencies: [text], outputs: [text]):
        """Record a successful compilation."""
        val fp = FileFingerprint.from_file(source)
        if val fingerprint = fp:
            self.cache.update_entry(source, fingerprint, dependencies, outputs)
        # Cache v2 strict shadow mode (opt-in, compare-only): the legacy cache
        # above stays authoritative; v2 lookup/publish/compare runs alongside
        # and never alters build output. Fully off unless
        # SIMPLE_CACHE_V2_SHADOW=1.
        if shadow_enabled():
            val lookup = shadow_on_compile_start(ShadowActionInputs(
                workspace_root: ".", source: source, dependencies: dependencies))
            shadow_on_compile_done(lookup, outputs)

    me finish():
        """Save cache after build."""
        self.cache.save()
        if shadow_enabled():
            shadow_report()

    me clean():
        """Clear build cache."""
        self.cache.invalidate_all()
        self.symbol_hashes = {}
        self.cached_mir_index = {}
        self.cache.save()

    # --- Symbol-Level Incremental MIR Cache ---

    me update_symbol_hashes(source: text, hashes: {text: text}):
        """Store symbol hashes for a source file after compilation."""
        self.symbol_hashes[source] = hashes

    fn get_changed_symbols(source: text, new_hashes: {text: text}) -> [text]:
        """Compare new symbol hashes against cached ones, return changed symbol names."""
        if not self.symbol_hashes.has(source):
            # BUG-001 fix: Use keys()-based iteration (for (k,v) in dict is broken in compiled mode)
            var all_names: [text] = []
            for name in new_hashes.keys():
                all_names = all_names.push(name)
            return all_names

        val old_hashes = self.symbol_hashes[source]
        var changed: [text] = []

        # BUG-001 fix: Use keys()-based iteration (for (k,v) in dict is broken in compiled mode)
        for name in new_hashes.keys():
            val new_hash = new_hashes[name]
            if old_hashes.has(name):
                if old_hashes[name] != new_hash:
                    changed = changed.push(name)
            else:
                changed = changed.push(name)

        for name in old_hashes.keys():
            if not new_hashes.has(name):
                changed = changed.push(name)

        changed

    fn get_cached_mir_functions(source: text) -> Dict<text, text>?:
        """Return cached MIR function SDN blobs for unchanged functions in a source file.

        Returns a dict mapping function name to serialized MIR text, or nil if no cache.
        Uses .build/mir_cache/ directory for per-function MIR storage.
        """

        if not self.cached_mir_index.has(source):
            return nil

        val func_names = self.cached_mir_index[source]
        var result: {text: text} = {}
        val cache_dir = ".build/mir_cache"

        for name in func_names:
            # Hoisted chain (stage-4 nested-call 'replace' gap, see cache_validator.spl).
            val slashless = name.replace("/", "_")
            val safe_name = slashless.replace(":", "_")
            val mir_path = "{cache_dir}/{safe_name}.sdn"
            if incremental_file_exists(mir_path):
                val content_opt = incremental_file_read_text(mir_path)
                if val content = content_opt:
                    if content != "":
                        result[name] = content

        if result.keys().len() == 0:
            return nil
        Some(result)

    me cache_mir_function(source: text, func_name: text, mir_sdn: text):
        """Cache a single function's MIR to disk."""
        val cache_dir = ".build/mir_cache"
        incremental_mkdir_p(cache_dir)

        # Hoisted chain (stage-4 nested-call 'replace' gap, see cache_validator.spl).
        val slashless2 = func_name.replace("/", "_")
        val safe_name = slashless2.replace(":", "_")
        val mir_path = "{cache_dir}/{safe_name}.sdn"
        incremental_file_write_text(mir_path, mir_sdn)

        if not self.cached_mir_index.has(source):
            self.cached_mir_index[source] = []
        val existing: [text] = self.cached_mir_index[source]
        if not existing.contains(func_name):
            self.cached_mir_index[source] = existing.push(func_name)

# ============================================================================
# MIR Merge (Symbol-Level)
# ============================================================================

fn merge_mir(cached_fns: {text: text}, new_fns: {text: text}) -> {text: text}:
    """Merge cached unchanged MIR functions with newly compiled changed functions.

    For each function, if it exists in new_fns (freshly compiled), use the new version.
    Otherwise, use the cached version. This allows symbol-level granularity:
    only changed functions are recompiled, unchanged ones reuse cached MIR.
    """
    var merged: {text: text} = {}

    # BUG-001 fix: Use keys()-based iteration (for (k,v) in dict is broken in compiled mode)
    for name in cached_fns.keys():
        merged[name] = cached_fns[name]

    for name in new_fns.keys():
        merged[name] = new_fns[name]

    merged

# ============================================================================
# Exports
# ============================================================================

export FileFingerprint, DependencyEntry, ChangeKind, IncrChangeSet
export BuildCache, IncrementalCompiler
# Free-function facade over BuildCache for cross-module callers. The current
# self-hosted child binary erases class receivers across module boundaries
# ("method not found on type `object`"), so specs and out-of-module tooling go
# through these; inside this module the receiver type is concrete.
# The interface-digest gate as plain-data functions (text in, bool out) —
# the exact pair the BuildCache paths below call, exposed separately so it
# can be exercised from specs (class values are erased across module
# boundaries by the current self-hosted child binary).
pub fn dep_iface_gate_record(dep_paths: [text]) -> text:
    """Fold to record at compile time; "" when any dep is unreadable (the
    stored "" then fails closed at validation)."""
    incremental_dependency_interface_fold(dep_paths) ?? ""

pub fn dep_iface_gate_valid(recorded: text, dep_paths: [text]) -> bool:
    """Fail-closed validation: "" recorded, or any currently unreadable
    dependency, is never valid; otherwise valid iff the recomputed fold is
    byte-identical to the recorded one."""
    if recorded == "":
        return false
    val fold = incremental_dependency_interface_fold(dep_paths)
    if val fresh_fold = fold:
        return recorded == fresh_fold
    false

pub fn build_cache_open(cache_path: text) -> BuildCache:
    BuildCache.load(cache_path)

pub fn build_cache_record_entry_with_fp(cache: BuildCache, source: text,
                                        fingerprint: FileFingerprint,
                                        dependencies: [text], outputs: [text],
                                        module_witness: text = ""):
    """Record/update one entry. deps_iface is computed HERE, at record time,
    so the entry's validity is pinned to the dependencies' interfaces as they
    were when the artifact was produced. If any dependency is unreadable the
    fold is nil and "" is stored — build_cache_entry_is_valid then fails
    closed on this entry."""
    val deps_iface = dep_iface_gate_record(dependencies)
    reverse_reference_owner_register_source_alias_v1(source, source)
    for output in outputs:
        reverse_reference_owner_register_source_alias_v1(output, source)
    for dependency in dependencies:
        reverse_reference_owner_register_source_alias_v1(
            dependency, dependency)
        incremental_publish_direct_import_export_v1(
            dependency, source, deps_iface)
        # An import proves interface consumption, not SCC membership. The
        # action-graph/SCC owner publishes module-scc-artifact peer edges.
    incremental_publish_direct_import_export_v1(
        source, source, fingerprint.content_hash)
    incremental_publish_module_scc_artifact_v1(
        source, source,
        if module_witness == "": fingerprint.content_hash else: module_witness)
    # Default/omitted witness means "caller has no new witness", not "erase a
    # witness published by the native AOT owner". This keeps generic legacy
    # record_compilation callers backward compatible.
    var effective_module_witness = module_witness
    if effective_module_witness == "" and cache.entries.contains_key(source):
        effective_module_witness = cache.entries[source].module_witness
    cache.fingerprints[source] = fingerprint
    cache.entries[source] = DependencyEntry(
        source: source, fingerprint: fingerprint,
        dependencies: dependencies, outputs: outputs,
        deps_iface: deps_iface,
        interface_digest: interface_digest_of_source(
            incremental_file_read_text(source) ?? ""),
        module_witness: effective_module_witness)

pub fn build_cache_record_entry(cache: BuildCache, source: text,
                                dependencies: [text], outputs: [text]) -> bool:
    val fp = FileFingerprint.from_file(source)
    if val fp_val = fp:
        build_cache_record_entry_with_fp(cache, source, fp_val, dependencies, outputs)
        return true
    false

pub fn build_cache_entry_is_valid(cache: BuildCache, source: text) -> bool:
    """Entry freshness: own source hash, outputs on disk, and the
    interface-digest gate (Phase D): the entry is only valid while its
    dependencies' INTERFACES are byte-identical to what they were at compile
    time. Body-only dependency edits leave the fold unchanged (still a hit);
    a signature edit changes it (miss). Fail closed: a legacy/corrupt entry
    ("" recorded) or a currently unreadable dependency (nil fold) is never a
    hit."""
    if not cache.entries.contains_key(source):
        return false
    val entry = cache.entries[source]
    val fresh = FileFingerprint.from_file(source)
    if val fingerprint = fresh:
        if entry.fingerprint.content_hash != fingerprint.content_hash:
            return false
        for out in entry.outputs:
            if not incremental_file_exists(out):
                return false
        return dep_iface_gate_valid(entry.deps_iface, entry.dependencies)
    false

pub fn build_cache_persist(cache: BuildCache) -> bool:
    """Persist cache to disk."""
    val dir = incremental_parent_dir(cache.cache_path)
    if dir != "":
        incremental_mkdir_p(dir)
    var lines: [text] = [
        "version: {cache.version + 1}",
        "entries: ["
    ]
    for source in cache.entries.keys():
        val entry = cache.entries[source]
        val fp = entry.fingerprint
        val source_text = incremental_sdn_escape(entry.source)
        val hash_text = incremental_sdn_escape(fp.content_hash)
        val deps_text = incremental_sdn_text_array(entry.dependencies)
        val outputs_text = incremental_sdn_text_array(entry.outputs)
        val deps_iface_text = incremental_sdn_escape(entry.deps_iface)
        val interface_digest_text = incremental_sdn_escape(entry.interface_digest)
        val module_witness_text = incremental_sdn_escape(entry.module_witness)
        val fp_text = "{" + " hash: \"" + hash_text + "\", size: {fp.size}, modified_time: {fp.modified_time} " + "}"
        lines = lines.push("  " + "{" + " source: \"" + source_text + "\", fingerprint: " + fp_text + ", dependencies: " + deps_text + ", outputs: " + outputs_text + ", deps_iface: \"" + deps_iface_text + "\", interface_digest: \"" + interface_digest_text + "\", module_witness: \"" + module_witness_text + "\" " + "}")
    lines = lines.push("]")
    if not incremental_file_write_text(cache.cache_path, lines.join("\n")):
        return false
    val receipt = incremental_reverse_reference_generation_v1(cache)
    reverse_reference_publish_generation_v1(cache.cache_path, receipt)



export merge_mir, native_build_cache_lane, native_build_cache_scope_key, native_build_compiler_identity, native_build_frontend_identity, native_build_compiler_executable_hash, native_build_producer_identity
# Path-based entry points: the BuildCache instance never crosses a module
# boundary (the current self-hosted child binary erases class values that do,
# losing both methods and fields). All parameters and results are plain data.
pub fn build_cache_record_entry_at(cache_path: text, source: text,
                                   dependencies: [text], outputs: [text]) -> bool:
    val cache = BuildCache.load(cache_path)
    val fp = FileFingerprint.from_file(source)
    if val fp_val = fp:
        build_cache_record_entry_with_fp(cache, source, fp_val, dependencies, outputs)
        return build_cache_persist(cache)
    false

pub fn build_cache_entry_is_valid_at(cache_path: text, source: text) -> bool:
    build_cache_entry_is_valid(BuildCache.load(cache_path), source)

pub fn incremental_detect_changes_at(cache_path: text,
                                     source_files: [text]) -> IncrementalCompileResult:
    val cache = BuildCache.load(cache_path)
    cache.detect_changes(source_files)

export build_cache_open, build_cache_record_entry, build_cache_entry_is_valid, build_cache_persist, incremental_dependency_interface_fold
export build_cache_record_entry_at, build_cache_entry_is_valid_at
export incremental_detect_changes_at
export IncrementalCompileResult, IncrChangeSet, IncrChange, ChangeKind
export dep_iface_gate_record, dep_iface_gate_valid
export incremental_reverse_reference_fallback_reason_v1
export incremental_publish_direct_import_export_v1
export incremental_publish_module_scc_artifact_v1

pub fn incremental_reverse_reference_fallback_reason_v1() -> text:
    _incremental_reverse_reference_fallback_reason_v1

pub fn native_module_cache_shadow_mismatch_v1(recorded: text, expected: text) -> text:
    if recorded == "": return "legacy-missing"
    if recorded == NATIVE_MODULE_CACHE_WITNESS_CORRUPT_V1: return "corrupt-recorded"
    if recorded == expected: return "match"
    "witness-mismatch"

pub fn build_cache_module_witness(cache: BuildCache, source: text) -> text:
    if cache.entries.contains_key(source):
        return cache.entries[source].module_witness
    ""

export native_module_cache_shadow_mismatch_v1, build_cache_module_witness
