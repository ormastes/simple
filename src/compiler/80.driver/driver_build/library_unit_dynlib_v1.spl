# Library unit shared-library (`dyn-lib`: `.dylib`/`.so`/`.dll`) build & link.
#
# Phase 3 (`--mode dynload`) default library-unit artifact lane:
#   <cache_root>/units/<unit>/<unit_key>/
#       objects/<module>.o
#       lib<unit>.dylib | lib<unit>.so | <unit>.dll
#       iface.sdn               unit interface digest + per-module body-free digests
#       iface_root/<rel>.spl    materialized body-stripped interface sources
#       receipt.sdn             write-once ownership receipt (artifact_kind: "dynlib")
#
# Why dyn-lib for Stage 3:
#   - Shared libraries preserve module initializers and registration tables
#     without static-archive `--whole-archive` dead-strip hazards.
#   - Downstream executables (`stage3` / tools) link in milliseconds against
#     cached `.dylib`/`.so` units rather than re-linking 1,500+ flat `.o` files.
#   - When a function body changes inside a dependency unit, its `iface.sdn`
#     digest is unchanged, so dependent units keep the exact same `unit_key`
#     and reuse their existing `.dylib`/`.so` untouched.

use std.common.crypto.sha256.{sha256_text, sha256_u8_hex}
use std.io_runtime.{
    file_exists, file_read, file_read_bytes, file_write, file_copy, file_delete,
    file_rename, file_size_raw, dir_create_all, dir_remove_all, list_dir, is_dir,
    is_file, process_run, env_get, host_os, host_arch, getpid
}
use std.nogc_sync_mut.io.file_ops.{file_atomic_write}
use std.nogc_sync_mut.io.env_ops.{env_set}
use std.nogc_sync_mut.io.native_tool_authority_v1.{
    native_tool_strict_requested_v1, native_tool_strict_resolve_v1
}
use compiler.common.cache.canonical_identity.{canonical_identity_sort_texts}
use compiler.common.cache.darwin_runtime_provider_manifest.{darwin_runtime_artifact_error_v1}
use compiler.backend.runtime_compiler.{find_c_compiler}
use compiler.backend.llvm_capability.{find_nm_portable, find_archive_portable}
use compiler.backend.linker.archive_response_file.{archive_command_build}
use compiler.backend.llvm_native_link.{NativeLinkOptions, link_llvm_native_with_receipt_v2}
use compiler.driver.driver_build.incremental.{build_cache_outputs_for_source_at}
use compiler.driver.driver_build.source_inventory_glob_v1.{source_inventory_glob_match_v1}
use compiler.driver.driver_build.source_inventory_scan_v1.{source_inventory_scan_resolve_v1}
