# Receipt verification only. The separately pinned qualifier owns execution.
use compiler.driver.driver_build.managed_parse_compatibility.{managed_parse_frontend_identity_decode_v2}
use std.common.build_manager.codec.{BuilderWireReaderV1, builder_wire_line_v1, builder_decode_task_v1, builder_encode_task_v1}
use std.common.build_manager.contracts.{builder_digest_valid_v1, builder_identifier_valid_v1, builder_text_valid_v1}
use std.common.build_manager.grouped_native_contract.{native_group_absolute_path_valid_v1}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.io.file_ops.{file_read_regular_no_follow_bounded, file_is_regular_no_follow}
use std.nogc_sync_mut.io_runtime.{file_hash_sha256_or_empty}

struct ManagedParseQualificationV2:
    worker_path: text
    worker_digest: text
    frontend_identity: text
    target: text
    producer_path: text
    producer_digest: text
    runtime_path: text
    runtime_digest: text
    closure_path: text
    closure_digest: text
    build_path: text
    build_digest: text
    evidence_path: text
    evidence_digest: text
    issuer_path: text
    issuer_digest: text

fn managed_parse_qualification_fields_v2(value: ManagedParseQualificationV2) -> [text]:
    [value.worker_path, value.worker_digest, value.frontend_identity, value.target,
        value.producer_path, value.producer_digest, value.runtime_path, value.runtime_digest,
        value.closure_path, value.closure_digest, value.build_path, value.build_digest,
        value.evidence_path, value.evidence_digest, value.issuer_path, value.issuer_digest]

fn managed_parse_qualification_shape_v2(value: ManagedParseQualificationV2, draft: bool) -> text:
    var paths: [text] = []
    for path in [value.worker_path, value.producer_path, value.runtime_path, value.closure_path,
            value.build_path, value.evidence_path, value.issuer_path]:
        if not native_group_absolute_path_valid_v1(path): return "invalid qualification path"
        val normalized = path.replace("\\", "/").to_lower()
        if paths.contains(normalized): return "qualification paths overlap"
        paths = paths.push(normalized)
    for digest in [value.worker_digest, value.producer_digest, value.runtime_digest,
            value.closure_digest, value.evidence_digest, value.issuer_digest]:
        if not builder_digest_valid_v1(digest): return "invalid qualification digest"
    if not draft and not builder_digest_valid_v1(value.build_digest): return "invalid build receipt digest"
    if draft and value.build_digest != "": return "build draft must omit its own digest"
    if value.frontend_identity == "" or not builder_text_valid_v1(value.frontend_identity) or not builder_identifier_valid_v1(value.target): return "invalid frontend or target identity"
    ""

fn managed_parse_qualification_wire_v2(header: text, fields: [text]) -> text:
    var out = header + "\n"
    for field in fields: out = out + builder_wire_line_v1(field)
    out

fn managed_parse_worker_build_encode_v1(draft: ManagedParseQualificationV2) -> text:
    if managed_parse_qualification_shape_v2(draft, true) != "": return ""
    # The empty self-digest occupies its fixed field; every other field binds
    # the final receipt, avoiding circular hashing and positional ambiguity.
    managed_parse_qualification_wire_v2("SIMPLE-MANAGED-PARSE-WORKER-BUILD-1", managed_parse_qualification_fields_v2(draft))

fn managed_parse_qualification_encode_v2(value: ManagedParseQualificationV2) -> text:
    if managed_parse_qualification_shape_v2(value, false) != "": return ""
    managed_parse_qualification_wire_v2("SIMPLE-MANAGED-PARSE-QUALIFICATION-2", managed_parse_qualification_fields_v2(value))

fn managed_parse_qualification_decode_v2(payload: text) -> Result<ManagedParseQualificationV2, text>:
    val reader = BuilderWireReaderV1.create(payload)
    if reader.scalar() != "SIMPLE-MANAGED-PARSE-QUALIFICATION-2": return Err("invalid qualification header")
    var fields: [text] = []
    for i in 0..16: fields = fields.push(reader.scalar())
    if reader.complete_error() != "": return Err(reader.complete_error())
    val value = ManagedParseQualificationV2(fields[0], fields[1], fields[2], fields[3],
        fields[4], fields[5], fields[6], fields[7], fields[8], fields[9], fields[10], fields[11],
        fields[12], fields[13], fields[14], fields[15])
    val reason = managed_parse_qualification_shape_v2(value, false)
    if reason != "": return Err(reason)
    if managed_parse_qualification_encode_v2(value) != payload: return Err("noncanonical qualification")
    Ok(value)

fn managed_parse_qualification_read_v2(path: text, digest: text, bound: i64) -> Result<text, text>:
    val content = file_read_regular_no_follow_bounded(path, bound)?
    if sha256_text(content) != digest: return Err("qualification artifact digest differs")
    Ok(content)

fn managed_parse_qualification_evidence_v2(value: ManagedParseQualificationV2, evidence: text) -> text:
    val base_prefix = "MANAGED_PARSE_REAL_FAILURE_COLLECTION_PASS\nMANAGED_PARSE_DURABLE_REUSE_PASS\nMANAGED_PARSE_PARENT_WORKER_PARITY_PASS\n"
    val prefix = match managed_parse_frontend_identity_decode_v2(value.frontend_identity):
        Ok(identity): base_prefix + "MANAGED_PARSE_V2_POLICY_EVIDENCE_PASS:" + identity.capture_policy + "\n\n"
        Err(_reason):
            if value.frontend_identity.trim().starts_with("[") or value.frontend_identity.contains("managed-parse-frontend-v2"):
                return "malformed reserved V2 qualification identity"
            base_prefix + "\n"
    if not evidence.starts_with(prefix): return "executed evidence framing differs"
    val task_wire = evidence.substring(prefix.len())
    val task = match builder_decode_task_v1(task_wire):
        case Ok(parsed): parsed
        case Err(_): return "evidence build request invalid"
    if builder_encode_task_v1(task) != task_wire: return "evidence build request noncanonical"
    if task.program != value.producer_path or task.producer_digest != value.producer_digest or task.source_digest != value.closure_digest: return "evidence build authority differs"
    if task.outputs.len() != 1 or task.inputs.len() == 0 or task.args.len() == 0 or task.args[0] != "native-build" or task.timeout_ms < 1 or task.timeout_ms > 3600000: return "evidence build shape differs"
    val suffix = "/" + task.outputs[0]
    if not value.worker_path.ends_with(suffix): return "worker output binding differs"
    val workspace = value.worker_path.substring(0, value.worker_path.len() - suffix.len())
    if not native_group_absolute_path_valid_v1(workspace): return "worker workspace invalid"
    var runtime_found = false
    for input in task.inputs:
        val path = workspace + "/" + input.path
        if not file_is_regular_no_follow(path) or file_hash_sha256_or_empty(path) != input.digest: return "declared build input changed"
        if path == value.runtime_path and input.digest == value.runtime_digest: runtime_found = true
    if not runtime_found: return "runtime absent from build inputs"
    var target_count = 0
    var entry_count = 0
    var output_count = 0
    var runtime_count = 0
    var closure_count = 0
    for i in 0..task.args.len():
        val arg = task.args[i]
        if arg == "--entry-closure": closure_count = closure_count + 1
        if arg == "--target" or arg == "--entry" or arg == "--output" or arg == "-o" or arg == "--runtime-path":
            if i + 1 >= task.args.len(): return "truncated worker build option"
            val next = task.args[i + 1]
            if arg == "--target":
                if next != value.target: return "worker target differs"
                target_count = target_count + 1
            elif arg == "--entry":
                if next != "src/compiler/80.driver/driver_managed_parse_group_main.spl": return "worker entry differs"
                entry_count = entry_count + 1
            elif arg == "--runtime-path":
                if not native_group_absolute_path_valid_v1(next) or not value.runtime_path.starts_with(next + "/"): return "worker runtime provider differs"
                runtime_count = runtime_count + 1
            else:
                if next != value.worker_path and next != task.outputs[0]: return "worker output differs"
                output_count = output_count + 1
    if target_count != 1 or entry_count != 1 or output_count != 1 or runtime_count != 1 or closure_count != 1: return "worker build options absent or duplicated"
    ""

fn managed_parse_qualification_admit_v1(path: text, receipt_digest: text, expected_issuer_digest: text,
        worker_path: text, worker_digest: text, frontend_identity: text, target: text) -> text:
    if not native_group_absolute_path_valid_v1(path) or not builder_digest_valid_v1(receipt_digest) or not builder_digest_valid_v1(expected_issuer_digest): return "invalid expected qualification authority"
    val payload = match managed_parse_qualification_read_v2(path, receipt_digest, 1048576):
        case Ok(value): value
        case Err(reason): return reason
    val value = match managed_parse_qualification_decode_v2(payload):
        case Ok(decoded): decoded
        case Err(reason): return reason
    if value.issuer_digest != expected_issuer_digest or value.worker_path != worker_path or value.worker_digest != worker_digest or value.frontend_identity != frontend_identity or value.target != target: return "qualification expected authority differs"
    for artifact in [(value.worker_path, value.worker_digest), (value.producer_path, value.producer_digest),
            (value.runtime_path, value.runtime_digest), (value.issuer_path, value.issuer_digest)]:
        if not file_is_regular_no_follow(artifact.0) or file_hash_sha256_or_empty(artifact.0) != artifact.1: return "qualification image changed"
    val closure = match managed_parse_qualification_read_v2(value.closure_path, value.closure_digest, 16777216):
        case Ok(content): content
        case Err(reason): return reason
    if closure == "": return "empty source closure"
    val build = match managed_parse_qualification_read_v2(value.build_path, value.build_digest, 1048576):
        case Ok(content): content
        case Err(reason): return reason
    val draft = ManagedParseQualificationV2(value.worker_path, value.worker_digest, value.frontend_identity, value.target,
        value.producer_path, value.producer_digest, value.runtime_path, value.runtime_digest,
        value.closure_path, value.closure_digest, value.build_path, "", value.evidence_path, value.evidence_digest, value.issuer_path, value.issuer_digest)
    if build != managed_parse_worker_build_encode_v1(draft): return "worker build receipt differs"
    val evidence = match managed_parse_qualification_read_v2(value.evidence_path, value.evidence_digest, 16777216):
        case Ok(content): content
        case Err(reason): return reason
    managed_parse_qualification_evidence_v2(value, evidence)

export ManagedParseQualificationV2, managed_parse_worker_build_encode_v1
export managed_parse_qualification_encode_v2, managed_parse_qualification_decode_v2, managed_parse_qualification_admit_v1
