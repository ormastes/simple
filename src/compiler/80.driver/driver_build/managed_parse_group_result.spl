use compiler.driver.driver_build.managed_parse_group_contract.*
use std.common.build_manager.codec.{BuilderWireReaderV1}
use std.common.build_manager.contracts.{builder_identifier_valid_v1, builder_digest_valid_v1, builder_text_valid_v1}

struct ManagedParseModuleResultV1:
    module_id: text
    source_digest: text
    status: text
    blob_path: text
    blob_digest: text
    diagnostics: [text]
    reused: bool

struct ManagedParseActionResultV1:
    action: ManagedParseActionV1
    modules: [ManagedParseModuleResultV1]
    error: text

fn managed_parse_module_result_validate_v1(value: ManagedParseModuleResultV1) -> text:
    if not builder_identifier_valid_v1(value.module_id) or not builder_digest_valid_v1(value.source_digest): return "invalid result source"
    if value.diagnostics.len() > 4096: return "too many diagnostics"
    for diagnostic in value.diagnostics:
        if diagnostic == "" or not builder_text_valid_v1(diagnostic): return "invalid diagnostic"
    if value.status == "OK":
        if not builder_digest_valid_v1(value.blob_digest) or value.blob_path != "artifacts/" + value.blob_digest + ".flat" or value.diagnostics.len() != 0: return "invalid successful result"
    elif value.status == "ERROR":
        if value.blob_path != "" or value.blob_digest != "" or value.diagnostics.len() == 0 or value.reused: return "invalid failed result"
    else: return "unknown module status"
    ""

fn managed_parse_module_result_encode_v1(value: ManagedParseModuleResultV1) -> text:
    if managed_parse_module_result_validate_v1(value) != "": return ""
    val out = "SIMPLE-MANAGED-PARSE-MODULE-RESULT-1\n" + managed_parse_fields_v1([
        value.module_id, value.source_digest, value.status, value.blob_path, value.blob_digest,
        if value.reused: "1" else: "0"]) + managed_parse_list_wire_v1(value.diagnostics)
    if out.len() > 65536: return ""
    out

fn managed_parse_module_result_decode_v1(payload: text) -> Result<ManagedParseModuleResultV1, text>:
    val reader = BuilderWireReaderV1.create(payload)
    if reader.scalar() != "SIMPLE-MANAGED-PARSE-MODULE-RESULT-1": return Err("invalid module result header")
    val id = reader.scalar()
    val source = reader.scalar()
    val status = reader.scalar()
    val path = reader.scalar()
    val digest = reader.scalar()
    val reused = reader.number(1, false) == 1
    val diagnostics = managed_parse_list_read_v1(reader)
    if reader.complete_error() != "": return Err(reader.complete_error())
    val value = ManagedParseModuleResultV1(id, source, status, path, digest, diagnostics, reused)
    if managed_parse_module_result_validate_v1(value) != "" or managed_parse_module_result_encode_v1(value) != payload: return Err("invalid or noncanonical module result")
    Ok(value)

fn managed_parse_action_result_shape_v1(value: ManagedParseActionResultV1) -> text:
    if managed_parse_action_shape_v1(value.action) != "": return "invalid result action"
    if value.modules.len() == 0 or value.modules.len() > 4096 or not builder_text_valid_v1(value.error): return "invalid result size"
    var failed = false
    var seen: [text] = []
    for module in value.modules:
        val reason = managed_parse_module_result_validate_v1(module)
        if reason != "": return reason
        if seen.contains(module.module_id): return "duplicate result module"
        seen = seen.push(module.module_id)
        if module.status == "ERROR": failed = true
    if failed != (value.error != ""): return "aggregate failure mismatch"
    ""

fn managed_parse_action_result_validate_v1(snapshot: ManagedParseSnapshotV1, action: ManagedParseActionV1, value: ManagedParseActionResultV1) -> text:
    val invalid = managed_parse_action_validate_v1(snapshot, action)
    if invalid != "": return invalid
    val reason = managed_parse_action_result_shape_v1(value)
    if reason != "": return reason
    if managed_parse_action_encode_v1(action) != managed_parse_action_encode_v1(value.action): return "result lease/action mismatch"
    var index = 0
    for module in snapshot.modules:
        if action.package_members.contains(module.package_id):
            if index >= value.modules.len(): return "missing result module"
            val result = value.modules[index]
            if result.module_id != module.module_id or result.source_digest != module.source_digest: return "result inventory mismatch"
            index = index + 1
    if index != value.modules.len(): return "extra result module"
    ""

fn managed_parse_action_result_encode_v1(value: ManagedParseActionResultV1) -> text:
    if managed_parse_action_result_shape_v1(value) != "": return ""
    val action = managed_parse_action_encode_v1(value.action)
    if action == "": return ""
    var out = "SIMPLE-MANAGED-PARSE-ACTION-RESULT-1\n" + managed_parse_fields_v1([
        action, value.error, "{value.modules.len()}"])
    for module in value.modules:
        val encoded = managed_parse_module_result_encode_v1(module)
        if encoded == "": return ""
        out = out + managed_parse_fields_v1([encoded])
        if out.len() > 16777216: return ""
    out

fn managed_parse_action_result_decode_v1(payload: text) -> Result<ManagedParseActionResultV1, text>:
    val reader = BuilderWireReaderV1.create(payload)
    if reader.scalar() != "SIMPLE-MANAGED-PARSE-ACTION-RESULT-1": return Err("invalid action result header")
    val action = managed_parse_action_decode_v1(reader.scalar())?
    val error = reader.scalar()
    val count = reader.number(4096, false)
    var modules: [ManagedParseModuleResultV1] = []
    for i in 0..count:
        val module = managed_parse_module_result_decode_v1(reader.scalar())?
        modules = modules.push(module)
    if reader.complete_error() != "": return Err(reader.complete_error())
    val value = ManagedParseActionResultV1(action, modules, error)
    if managed_parse_action_result_shape_v1(value) != "" or managed_parse_action_result_encode_v1(value) != payload: return Err("invalid or noncanonical action result")
    Ok(value)

export ManagedParseModuleResultV1, ManagedParseActionResultV1
export managed_parse_module_result_validate_v1, managed_parse_module_result_encode_v1, managed_parse_module_result_decode_v1
export managed_parse_action_result_validate_v1, managed_parse_action_result_encode_v1, managed_parse_action_result_decode_v1
