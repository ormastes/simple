# MIR shard export summaries (opt-in SIMPLE_MIR_SHARD_EXPORT_SUMMARIES=1).
#
# Go-style export data for MIR shard workers. One summary process runs the
# ordinary pipeline through mono, projects every scheduled module's
# post-mono HIR into the existing body-free declaration carrier
# (MirHirModuleDeclarationsV1, compiler.mir.hir_declaration_summary_v1), and
# writes one record per module plus a sealed manifest. A MIR shard worker
# admits the bundle before lowering; admission is all-or-nothing and digest
# keyed, and any refusal leaves the worker on today's full HIR load.
# Design and the cross-module read inventory:
# doc/05_design/compiler/incremental_build/mir_shard_export_summaries.md
#
# Record  <dir>/<sha256(module)>.mirexport
#   line 0  NATIVE_MIR_SHARD_EXPORT_FORMAT_V1
#   line 1  build identity (ctx.native_sources_fingerprint)
#   line 2  module name (source lookup name)
#   line 3  declaration digest (mir_hir_module_declaration_digest_v1)
#   line 4  sha256 of the payload
#   rest    payload: mir_hir_write_module_declarations_v1 bytes
# Manifest <dir>/manifest, written last (its presence is the completeness seal)
#   line 0  NATIVE_MIR_SHARD_EXPORT_MANIFEST_V1
#   line 1  build identity
#   line 2  row count
#   rows    "<module>\t<declaration digest>" in schedule order
#   last    "seal <sha256 of every preceding line>"
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.io_runtime.{env_get_nullable}
use std.io_runtime.{dir_create_all, file_exists, file_read, file_write, file_rename, getpid}
use compiler.mir.hir_declaration_types_v1.{MirHirModuleDeclarationsV1}
use compiler.mir.hir_declaration_decoder_v1.{mir_hir_decode_module_declarations_v1,
    mir_hir_encode_module_declarations_v1}

pub const NATIVE_MIR_SHARD_EXPORT_ENV_V1: text = "SIMPLE_MIR_SHARD_EXPORT_SUMMARIES"
# Set by the coordinator for the single summary process: write, then exit.
pub const NATIVE_MIR_SHARD_EXPORT_WRITE_ENV_V1: text = "SIMPLE_MIR_SHARD_EXPORT_WRITE"
# Set by the coordinator for workers once the summary process PASSed.
pub const NATIVE_MIR_SHARD_EXPORT_DIR_ENV_V1: text = "SIMPLE_MIR_SHARD_EXPORT_DIR"
pub const NATIVE_MIR_SHARD_EXPORT_FORMAT_V1: text = "simple/mir-shard-export/v1"
pub const NATIVE_MIR_SHARD_EXPORT_MANIFEST_V1: text = "simple/mir-shard-export-manifest/v1"

pub fn native_mir_shard_export_enabled_v1() -> bool:
    (env_get_nullable(NATIVE_MIR_SHARD_EXPORT_ENV_V1) ?? "") == "1"

pub fn native_mir_shard_export_write_dir_v1() -> text:
    env_get_nullable(NATIVE_MIR_SHARD_EXPORT_WRITE_ENV_V1) ?? ""

pub fn native_mir_shard_export_dir_v1() -> text:
    env_get_nullable(NATIVE_MIR_SHARD_EXPORT_DIR_ENV_V1) ?? ""

# Projection authority for the direct (non-archive) lane: bound to the build
# identity, so a summary from another source set can never be admitted.
pub fn native_mir_shard_export_authority_v1(identity: text) -> text:
    sha256_text("mir-shard-export-authority-v1\n{identity}")

pub fn native_mir_shard_export_module_key_v1(identity: text, module_name: text) -> text:
    sha256_text("mir-shard-export-module-v1\n{native_mir_shard_export_authority_v1(identity)}\n{module_name}")

pub fn native_mir_shard_export_record_path_v1(dir: text, module_name: text) -> text:
    "{dir}/{sha256_text(module_name)}.mirexport"

fn native_mir_shard_export_publish_v1(path: text, content: text) -> bool:
    val temporary = "{path}.{getpid()}.tmp"
    file_write(temporary, content) and file_rename(temporary, path)

# Write one module's record; returns its declaration digest.
pub fn native_mir_shard_export_write_module_v1(dir: text, identity: text, module_name: text,
        module: MirHirModuleDeclarationsV1) -> Result<text, text>:
    if dir == "" or identity == "" or module_name == "" or module_name.contains("\n") or
            identity.contains("\n"):
        return Err("MIR shard export record has no directory, identity or module name")
    if module.declaration_digest == "":
        return Err("MIR shard export module has no declaration digest: {module_name}")
    val payload = mir_hir_encode_module_declarations_v1(module)
    if payload == "":
        return Err("MIR shard export declarations could not be encoded: {module_name}")
    if not dir_create_all(dir) and not file_exists(dir):
        return Err("MIR shard export directory unavailable: {dir}")
    val header = "{NATIVE_MIR_SHARD_EXPORT_FORMAT_V1}\n{identity}\n{module_name}\n{module.declaration_digest}\n{sha256_text(payload)}\n"
    if not native_mir_shard_export_publish_v1(native_mir_shard_export_record_path_v1(dir, module_name),
            header + payload):
        return Err("MIR shard export record could not be published: {module_name}")
    Ok(module.declaration_digest)

fn native_mir_shard_export_manifest_body_v1(identity: text, names: [text], digests: [text]) -> text:
    var body = "{NATIVE_MIR_SHARD_EXPORT_MANIFEST_V1}\n{identity}\n{names.len()}\n"
    var index = 0
    while index < names.len():
        body = body + "{names[index]}\t{digests[index]}\n"
        index = index + 1
    body

# The seal is written after every record, so a crash mid-bundle leaves no
# manifest and every worker refuses (falls back) instead of reading a prefix.
pub fn native_mir_shard_export_write_manifest_v1(dir: text, identity: text, names: [text],
        digests: [text]) -> bool:
    if names.len() == 0 or names.len() != digests.len():
        return false
    for name in names:
        if name == "" or name.contains("\t") or name.contains("\n"):
            return false
    val body = native_mir_shard_export_manifest_body_v1(identity, names, digests)
    native_mir_shard_export_publish_v1("{dir}/manifest", body + "seal {sha256_text(body)}\n")

pub class NativeMirShardExportManifestV1:
    names: [text]
    # Index-aligned with names.
    digests: [text]

pub fn native_mir_shard_export_read_manifest_v1(dir: text, identity: text) -> Result<NativeMirShardExportManifestV1, text>:
    if dir == "" or identity == "":
        return Err("MIR shard export directory or build identity missing")
    val path = "{dir}/manifest"
    if not file_exists(path):
        return Err("MIR shard export manifest missing (summary step incomplete)")
    val lines = file_read(path).split("\n")
    if lines.len() < 5 or lines[0] != NATIVE_MIR_SHARD_EXPORT_MANIFEST_V1:
        return Err("MIR shard export manifest format refused")
    if lines[1] != identity:
        return Err("MIR shard export manifest belongs to another build identity")
    val count = lines[2].to_i64() ?? -1
    # header(3) + rows + seal + trailing "".
    if count <= 0 or lines.len() != count + 5 or lines[count + 4] != "":
        return Err("MIR shard export manifest row count mismatch")
    var manifest = NativeMirShardExportManifestV1(names: [], digests: [])
    var index = 0
    while index < count:
        val row = lines[3 + index]
        val tab = row.index_of("\t")
        if tab <= 0:
            return Err("MIR shard export manifest row malformed")
        manifest.names = manifest.names.push(row.substring(0, tab))
        manifest.digests = manifest.digests.push(row.substring(tab + 1, row.len()))
        index = index + 1
    val body = native_mir_shard_export_manifest_body_v1(identity, manifest.names, manifest.digests)
    if lines[count + 3] != "seal {sha256_text(body)}":
        return Err("MIR shard export manifest seal mismatch")
    Ok(manifest)

# Load and prove one record. Every check is a refusal, never a partial value.
pub fn native_mir_shard_export_load_module_v1(dir: text, identity: text, module_name: text,
        expected_digest: text) -> Result<MirHirModuleDeclarationsV1, text>:
    val path = native_mir_shard_export_record_path_v1(dir, module_name)
    if not file_exists(path):
        return Err("MIR shard export record missing: {module_name}")
    val raw = file_read(path)
    # Locate the end of the five header lines without splitting the payload.
    var cut = 0
    var header_lines = 0
    while header_lines < 5:
        val rest = raw.substring(cut, raw.len())
        val newline = rest.index_of("\n")
        if newline < 0:
            return Err("MIR shard export record header truncated: {module_name}")
        cut = cut + newline + 1
        header_lines = header_lines + 1
    val header = raw.substring(0, cut).split("\n")
    val payload = raw.substring(cut, raw.len())
    if header[0] != NATIVE_MIR_SHARD_EXPORT_FORMAT_V1:
        return Err("MIR shard export record format refused: {module_name}")
    if header[1] != identity or header[2] != module_name:
        return Err("MIR shard export record identity mismatch: {module_name}")
    if header[3] == "" or header[3] != expected_digest:
        return Err("MIR shard export record digest differs from manifest: {module_name}")
    if header[4] != sha256_text(payload):
        return Err("MIR shard export record payload checksum mismatch: {module_name}")
    val decoded = mir_hir_decode_module_declarations_v1(payload, expected_digest)
    if decoded.is_err():
        return Err("{decoded.unwrap_err()}: {module_name}")
    val module = decoded.unwrap()
    val authority = native_mir_shard_export_authority_v1(identity)
    if module.final_repository_authority != authority or
            module.final_archive_key != native_mir_shard_export_module_key_v1(identity, module_name):
        return Err("MIR shard export record authority mismatch: {module_name}")
    Ok(module)

# Worker admission: the manifest must cover every required module, and every
# record must load and prove. Returns the number of admitted records.
pub fn native_mir_shard_export_admit_v1(dir: text, identity: text,
        required: [text]) -> Result<i64, text>:
    val read = native_mir_shard_export_read_manifest_v1(dir, identity)
    if read.is_err():
        return Err(read.unwrap_err())
    val manifest = read.unwrap()
    var row_of: Dict<text, i64> = {}
    var index = 0
    while index < manifest.names.len():
        if row_of.has(manifest.names[index]):
            return Err("MIR shard export manifest repeats a module: {manifest.names[index]}")
        row_of[manifest.names[index]] = index
        index = index + 1
    for name in required:
        if not row_of.has(name):
            return Err("MIR shard export summary missing for scheduled module: {name}")
    var admitted = 0
    index = 0
    while index < manifest.names.len():
        val loaded = native_mir_shard_export_load_module_v1(dir, identity,
            manifest.names[index], manifest.digests[index])
        if loaded.is_err():
            return Err(loaded.unwrap_err())
        admitted = admitted + 1
        index = index + 1
    Ok(admitted)
