# Parallel Build Orchestration
#
# Dependency-aware parallel compilation using work queues.
# Respects module dependency order while maximizing parallelism.
# Uses process-based parallelism (rt_process_spawn_async) to avoid
# thread-safety issues with global compiler state.

use compiler.driver.driver_build.build_outcome.{
    BuildOutcomeKind, BuildUnitOutcome, BuildOutcomeSet,
    build_outcome_kind_label}

extern fn spl_thread_cpu_count() -> i64
extern fn rt_process_spawn_async(cmd: text, args: [text]) -> i64
extern fn rt_process_wait(pid: i64, timeout_ms: i64) -> i64
extern fn rt_process_is_running(pid: i64) -> bool
extern fn rt_process_kill(pid: i64) -> bool
extern fn rt_thread_sleep(millis: i64)
extern fn rt_env_get(key: text) -> text
extern fn rt_file_exists(path: text) -> bool
extern fn rt_time_now_monotonic_ms() -> i64

# ============================================================================
# Unstable ("separate process") mode
# ============================================================================
#
# In unstable mode every unit is compiled in its OWN CHILD PROCESS, so a
# SIGSEGV / SIGKILL(OOM) / SIGTERM in one unit costs that unit and nothing else:
# the parent survives and the build reaches the END of the source list. See R1-R3
# of doc/02_requirements/compiler/supervised_builder.md.
#
# The name is deliberate: the mode exists because the *compiler* is unstable on
# some inputs, not because the mode is.

# Env override for the unstable flag. `path_default` is what the calling front
# end wants when the human has said nothing: ON for bootstrap, OFF for ordinary
# interactive runs. SIMPLE_UNSTABLE_BUILD=1/0 forces either way.
fn parallel_unstable_enabled(path_default: bool) -> bool:
    val raw = rt_env_get("SIMPLE_UNSTABLE_BUILD")
    if raw == "1" or raw == "true" or raw == "on" or raw == "yes":
        return true
    if raw == "0" or raw == "false" or raw == "off" or raw == "no":
        return false
    path_default

# Wrap a command so that a death BY SIGNAL survives as a 128+N exit status.
#
# This is not cosmetic, and the obvious wrapper does NOT work. Measured on this
# host with `rt_process_spawn_async` + `rt_process_wait`:
#
#   argv                                      status
#   ["-c", "kill -SEGV $$"]                     -1     signal DESTROYED
#   ["-c", "kill -SEGV $$\nexit $?"]            -1     signal DESTROYED
#   ["-c", "/bin/sh -c \"$0\"\nexit $?", cmd]  139     signal PRESERVED
#
# `rt_process_wait` is implemented over Rust's `ExitStatus::code()`, which is
# `None` for a signal-killed child and is folded to `-1` by `.unwrap_or(-1)`
# (env_process.rs:990). The signal number — and with it the whole CRASHED /
# TERMINATED distinction — is destroyed before it ever reaches Simple. Appending
# `exit $?` does not help on its own: if the command dies, the shell RUNNING it
# is the process that dies, and a dead shell never reaches its next statement.
#
# The fix is to interpose a supervising shell that is NOT the thing that dies.
# The unit runs in a GRANDCHILD (`/bin/sh -c "$0"`), so the middle shell survives
# it, `wait(2)`s it, and re-reports 128+N as its own ordinary exit code — read
# straight from the kernel, not through a pipe, exactly as R2 demands. The
# command travels as a separate argv element (`$0`) rather than being spliced
# into the script text, so no quoting in a source path can break the wrapper.
#
# Verified end to end: SEGV->139, TERM->143, KILL->137, `exit 3`->3, `true`->0.
#
# Returns the argv tail for `/bin/sh`; use `parallel_supervised_cmd()` for argv[0].
fn parallel_supervised_argv(inner_cmd: text) -> [text]:
    ["-c", "/bin/sh -c \"$0\"\nexit $?", inner_cmd]

fn parallel_supervised_cmd() -> text:
    "/bin/sh"

# ============================================================================
# Configuration
# ============================================================================

struct ParallelBuildConfig:
    num_threads: i64            # 0 = use all available CPUs
    parallel_threshold: i64     # Min modules to enable parallelism
    deterministic: bool         # Sort inputs for reproducible builds
    verbose: bool
    # Compile each unit in its OWN CHILD PROCESS so a unit's death does not take
    # the parent down. Default OFF for ordinary interactive runs, ON for the
    # bootstrap path (see `bootstrap()` below); SIMPLE_UNSTABLE_BUILD=1/0 forces.
    unstable: bool
    # Per-unit wall budget in unstable mode. A unit that exceeds it is killed and
    # recorded TIMEOUT — which is UNVERIFIED, never a failure — and the build
    # continues. 0 disables the budget.
    unit_timeout_ms: i64

impl ParallelBuildConfig:
    static fn default() -> ParallelBuildConfig:
        # Ordinary / interactive default: unstable OFF unless the human forces it.
        ParallelBuildConfig(num_threads: 0, parallel_threshold: 4,
                            deterministic: true, verbose: false,
                            unstable: parallel_unstable_enabled(false),
                            unit_timeout_ms: 0)

    static fn single_threaded() -> ParallelBuildConfig:
        ParallelBuildConfig(num_threads: 1, parallel_threshold: 999,
                            deterministic: true, verbose: false,
                            unstable: parallel_unstable_enabled(false),
                            unit_timeout_ms: 0)

    # The BOOTSTRAP front end. Unstable defaults ON here and only here: this is
    # where a single SIGSEGV or an earlyoom SIGTERM has repeatedly discarded a
    # 26-minute run (R8 — one implementation, two front ends).
    static fn bootstrap() -> ParallelBuildConfig:
        ParallelBuildConfig(num_threads: 0, parallel_threshold: 4,
                            deterministic: true, verbose: false,
                            unstable: parallel_unstable_enabled(true),
                            unit_timeout_ms: 600000)

    # Explicit opt-in for an ad-hoc run that wants isolation without bootstrap's
    # other settings.
    static fn unstable_mode(unit_timeout_ms: i64) -> ParallelBuildConfig:
        ParallelBuildConfig(num_threads: 0, parallel_threshold: 4,
                            deterministic: true, verbose: false,
                            unstable: parallel_unstable_enabled(true),
                            unit_timeout_ms: unit_timeout_ms)

    fn effective_threads() -> i64:
        """Resolve num_threads: 0 means auto-detect from CPU count, capped at 8."""
        if self.num_threads > 0:
            return self.num_threads
        val cpus = spl_thread_cpu_count()
        if cpus < 1:
            return 4
        if cpus > 8:
            return 8
        cpus

# ============================================================================
# Build Units and Dependency Graph
# ============================================================================

struct BuildUnit:
    """A unit of compilation (usually one source file)."""
    id: i64
    path: text
    dependencies: [i64]     # IDs of units this depends on
    dependents: [i64]       # IDs of units that depend on this
    status: BuildUnitStatus
    output: text?           # Output artifact path

enum BuildUnitStatus:
    Pending
    Ready           # All deps satisfied
    InProgress
    Completed
    Failed(text)

class BuildGraph:
    """Dependency graph for build units."""
    units: {i64: BuildUnit}
    next_id: i64
    ready_queue: [i64]

impl BuildGraph:
    static fn empty() -> BuildGraph:
        BuildGraph(units: {}, next_id: 0, ready_queue: [])

    me add_unit(path: text, dependencies: [i64]) -> i64:
        """Add a build unit, return its ID."""
        val id = self.next_id
        self.next_id = self.next_id + 1
        val build_unit = BuildUnit(id: id, path: path, dependencies: dependencies,
                             dependents: [], status: BuildUnitStatus.Pending,
                             output: nil)
        self.units[id] = build_unit

        # Update dependents
        for dep_id in dependencies:
            if self.units.has(dep_id):
                var dep = self.units[dep_id]
                self.units[dep_id] = BuildUnit(
                    id: dep.id, path: dep.path,
                    dependencies: dep.dependencies,
                    dependents: dep.dependents.push(id),
                    status: dep.status, output: dep.output)

        # Zero-dependency units are immediately ready
        if dependencies.len() == 0:
            self.ready_queue = self.ready_queue.push(id)

        id

    me ready_units() -> [BuildUnit]:
        """Drain the ready queue and return units ready to build."""
        var ready: [BuildUnit] = []
        for id in self.ready_queue:
            if self.units.has(id):
                val build_unit = self.units[id]
                match build_unit.status:
                    case Pending:
                        ready = ready.push(build_unit)
                    case _: ()
        self.ready_queue = []
        ready

    me mark_ready(id: i64):
        if self.units.has(id):
            val u = self.units[id]
            self.units[id] = BuildUnit(id: u.id, path: u.path,
                dependencies: u.dependencies, dependents: u.dependents,
                status: BuildUnitStatus.Ready, output: u.output)

    me mark_in_progress(id: i64):
        if self.units.has(id):
            val u = self.units[id]
            self.units[id] = BuildUnit(id: u.id, path: u.path,
                dependencies: u.dependencies, dependents: u.dependents,
                status: BuildUnitStatus.InProgress, output: u.output)

    me mark_completed(id: i64, output: text?):
        if self.units.has(id):
            val u = self.units[id]
            self.units[id] = BuildUnit(id: u.id, path: u.path,
                dependencies: u.dependencies, dependents: u.dependents,
                status: BuildUnitStatus.Completed, output: output)

            # Check reverse-dependencies: enqueue newly ready units
            for dep_id in u.dependents:
                if not self.units.has(dep_id):
                    continue
                val dep_unit = self.units[dep_id]
                match dep_unit.status:
                    case Pending:
                        var all_done = true
                        for req_id in dep_unit.dependencies:
                            if self.units.has(req_id):
                                match self.units[req_id].status:
                                    case Completed: ()
                                    case _: all_done = false
                            # Missing dep treated as satisfied
                        if all_done and not self.ready_queue.contains(dep_id):
                            self.ready_queue = self.ready_queue.push(dep_id)
                    case _: ()

    me mark_failed(id: i64, error: text):
        if self.units.has(id):
            val u = self.units[id]
            self.units[id] = BuildUnit(id: u.id, path: u.path,
                dependencies: u.dependencies, dependents: u.dependents,
                status: BuildUnitStatus.Failed(error), output: u.output)

    fn is_complete() -> bool:
        """All units completed or failed."""
        # BUG-001 fix: Use keys()-based iteration (for (k,v) in dict is broken in compiled mode)
        for id in self.units.keys():
            val build_unit = self.units[id]
            match build_unit.status:
                case Completed | Failed(_): ()
                case _: return false
        true

    fn has_failures() -> bool:
        # BUG-001 fix: Use keys()-based iteration (for (k,v) in dict is broken in compiled mode)
        for id in self.units.keys():
            val build_unit = self.units[id]
            match build_unit.status:
                case Failed(_): return true
                case _: ()
        false

    fn topological_order() -> [i64]:
        """Get units in dependency order (for deterministic builds)."""
        var order: [i64] = []
        var visited: {i64: bool} = {}

        # BUG-001 fix: Use keys()-based iteration (for (k,v) in dict is broken in compiled mode)
        # Iterative DFS to avoid nested function (native backend limitation)
        for id in self.units.keys():
            if visited.has(id):
                continue
            var stack: [(i64, bool)] = [(id, false)]
            while stack.?:
                # NOTE: `val entry = if val popped = stack.pop(): popped else: break`
                # mis-evaluates to nil in the seed interpreter — an if-expression
                # whose else arm diverges (break) returns nil even when the value
                # arm is taken (only when the condition is an `if val` binding).
                # The `while stack.?:` guard already ensures the stack is non-empty,
                # so unwrap directly, matching the working sibling driver/parallel.spl.
                val (node, expanded) = stack.pop().unwrap()
                if expanded:
                    order = order.push(node)
                    continue
                if visited.has(node):
                    continue
                visited[node] = true
                stack = stack.push((node, true))
                if self.units.has(node):
                    for dep in self.units[node].dependencies:
                        if not visited.has(dep):
                            stack = stack.push((dep, false))

        order

# ============================================================================
# Build Statistics
# ============================================================================

struct BuildStats:
    total_units: i64
    completed: i64
    failed: i64
    skipped: i64
    parallel_batches: i64

impl BuildStats:
    static fn empty() -> BuildStats:
        BuildStats(total_units: 0, completed: 0, failed: 0,
                   skipped: 0, parallel_batches: 0)

# ============================================================================
# Build Result
# ============================================================================

struct BuildResult:
    success: bool
    stats: BuildStats
    errors: [(text, text)]      # (file, error_message)
    outputs: [text]             # Generated artifact paths

# ============================================================================
# Parallel Builder
# ============================================================================

class ParallelBuilder:
    """Orchestrates parallel compilation respecting dependencies."""
    config: ParallelBuildConfig
    graph: BuildGraph
    stats: BuildStats
    # Owner-thread completion hook. Compile callbacks never receive shared
    # cache authority; the orchestrator invokes this after each successful unit.
    owner_collect_fn: any

impl ParallelBuilder:
    static fn create(config: ParallelBuildConfig) -> ParallelBuilder:
        ParallelBuilder(config: config, graph: BuildGraph.empty(),
                        stats: BuildStats.empty(), owner_collect_fn: nil)

    me set_owner_collect(collect_fn: any):
        self.owner_collect_fn = collect_fn

    fn wait_for_finished_process(in_flight_pid: {i64: i64}, in_flight_count: i64) -> (i64, i64):
        """Wait for any in-flight process to finish using bounded polling.

        Returns: (pid, exit_code), or (-1, -1) if no process is available.

        `in_flight_count` is the caller-maintained entry count for
        `in_flight_pid`. Dict `.len()` must NOT be used here: it returns -1 in
        natively-compiled code, so the empty-check would never fire and this
        function would spin forever over an empty `keys()`.
        """
        if in_flight_count == 0:
            return (-1, -1)

        var poll_iteration = 0
        while true:
            # BUG-001 fix: Use keys()-based iteration (for (k,v) in dict is broken in compiled mode)
            for pid in in_flight_pid.keys():
                if not rt_process_is_running(pid):
                    val exit_code = rt_process_wait(pid, 1)
                    if exit_code != -2:
                        return (pid, exit_code)

            var sleep_ms = 10
            if poll_iteration >= 50:
                sleep_ms = 100
            elif poll_iteration >= 10:
                sleep_ms = 25

            rt_thread_sleep(sleep_ms)
            poll_iteration = poll_iteration + 1

    me add_unit(path: text, dependencies: [i64]) -> i64:
        self.graph.add_unit(path, dependencies)

    me build(compile_fn: any) -> BuildResult:
        """Execute the build using the provided compile function.

        In deterministic mode, processes units in topological order.
        Otherwise, processes ready units in parallel batches.
        """
        # `graph.units` is a Dict; Dict.len() returns -1 natively. Units are only
        # ever added (never removed), so `next_id` is the exact unit count.
        val total = self.graph.next_id
        # `build()` compiles IN-PROCESS: `compile_fn` closes over the caller's
        # in-memory frozen MIR capsules, which a child process cannot receive.
        # So this path cannot honour unstable mode however the config was set.
        # Say so instead of running a non-isolated build under a name that
        # promises isolation -- a silent downgrade here is the same defect class
        # as a crashed spec reported as a pass. `build_supervised()` is the real
        # implementation; wiring it needs a one-module compile CLI so `spawn_fn`
        # has something to launch. See doc/03_plan/infra/unstable_mode_build_side.md.
        if self.config.unstable:
            print "[build] unstable mode REQUESTED but NOT ACTIVE on this path: "
                + "build() is in-process (MIR capsules cannot cross a process "
                + "boundary). A unit that segfaults or is OOM-killed still takes "
                + "the whole build down. No per-unit isolation is in effect."
        self.stats = BuildStats(total_units: total, completed: 0, failed: 0,
                                skipped: 0, parallel_batches: 0)
        var errors: [(text, text)] = []
        var outputs: [text] = []

        if self.config.deterministic or total < self.config.parallel_threshold:
            # Sequential build in topological order
            val order = self.graph.topological_order()
            for id in order:
                if not self.graph.units.has(id):
                    continue
                val build_unit = self.graph.units[id]

                # Skip if any dependency failed
                var dep_failed = false
                for dep_id in build_unit.dependencies:
                    if self.graph.units.has(dep_id):
                        match self.graph.units[dep_id].status:
                            case Failed(_): dep_failed = true
                            case _: ()
                if dep_failed:
                    self.graph.mark_failed(id, "Dependency failed")
                    self.stats = BuildStats(total_units: self.stats.total_units,
                        completed: self.stats.completed,
                        failed: self.stats.failed + 1,
                        skipped: self.stats.skipped,
                        parallel_batches: self.stats.parallel_batches)
                    continue

                self.graph.mark_in_progress(id)
                val result = compile_fn(build_unit.path)
                match result:
                    case Ok(output):
                        var collect_error: text = ""
                        if self.owner_collect_fn != nil:
                            # Bind the closure-valued field to a local before
                            # calling it. Invoking the field directly on the
                            # receiver is resolved as a METHOD call on
                            # ParallelBuilder and fails the multi-module native
                            # build on both backends with "method
                            # `owner_collect_fn` not found on class
                            # `ParallelBuilder`". See
                            # doc/08_tracking/bug/native_build_closure_field_call_resolved_as_method_2026-08-17.md
                            val owner_collect = self.owner_collect_fn
                            collect_error = owner_collect(build_unit.path, output)
                        if collect_error != "":
                            self.graph.mark_failed(id, collect_error)
                            errors = errors.push((build_unit.path, collect_error))
                            self.stats = BuildStats(total_units: self.stats.total_units,
                                completed: self.stats.completed,
                                failed: self.stats.failed + 1,
                                skipped: self.stats.skipped,
                                parallel_batches: self.stats.parallel_batches)
                        else:
                            self.graph.mark_completed(id, Some(output))
                            outputs = outputs.push(output)
                            self.stats = BuildStats(total_units: self.stats.total_units,
                                completed: self.stats.completed + 1,
                                failed: self.stats.failed,
                                skipped: self.stats.skipped,
                                parallel_batches: self.stats.parallel_batches)
                    case Err(msg):
                        self.graph.mark_failed(id, msg)
                        errors = errors.push((build_unit.path, msg))
                        self.stats = BuildStats(total_units: self.stats.total_units,
                            completed: self.stats.completed,
                            failed: self.stats.failed + 1,
                            skipped: self.stats.skipped,
                            parallel_batches: self.stats.parallel_batches)
        else:
            # Parallel build: batch-concurrent execution
            val max_workers = self.config.effective_threads()
            if self.config.verbose:
                print "[PARALLEL] batch-concurrent mode, {max_workers} workers"

            while not self.graph.is_complete():
                val ready = self.graph.ready_units()
                if ready.len() == 0:
                    break

                self.stats = BuildStats(total_units: self.stats.total_units,
                    completed: self.stats.completed, failed: self.stats.failed,
                    skipped: self.stats.skipped,
                    parallel_batches: self.stats.parallel_batches + 1)

                # Process batch in chunks of max_workers
                var batch_idx: i64 = 0
                while batch_idx < ready.len():
                    var chunk_end = batch_idx + max_workers
                    if chunk_end > ready.len():
                        chunk_end = ready.len()

                    # Mark chunk units in-progress
                    var chunk_idx = batch_idx
                    while chunk_idx < chunk_end:
                        self.graph.mark_in_progress(ready[chunk_idx].id)
                        chunk_idx = chunk_idx + 1

                    # Execute chunk: compile each build unit
                    chunk_idx = batch_idx
                    while chunk_idx < chunk_end:
                        val build_unit = ready[chunk_idx]
                        val result = compile_fn(build_unit.path)
                        match result:
                            case Ok(output):
                                var collect_error: text = ""
                                if self.owner_collect_fn != nil:
                                    # Same closure-field-call defect as above;
                                    # bind to a local before invoking.
                                    val owner_collect = self.owner_collect_fn
                                    collect_error = owner_collect(build_unit.path, output)
                                if collect_error != "":
                                    self.graph.mark_failed(build_unit.id, collect_error)
                                    errors = errors.push((build_unit.path, collect_error))
                                    self.stats = BuildStats(total_units: self.stats.total_units,
                                        completed: self.stats.completed,
                                        failed: self.stats.failed + 1,
                                        skipped: self.stats.skipped,
                                        parallel_batches: self.stats.parallel_batches)
                                else:
                                    self.graph.mark_completed(build_unit.id, Some(output))
                                    outputs = outputs.push(output)
                                    self.stats = BuildStats(total_units: self.stats.total_units,
                                        completed: self.stats.completed + 1,
                                        failed: self.stats.failed,
                                        skipped: self.stats.skipped,
                                        parallel_batches: self.stats.parallel_batches)
                            case Err(msg):
                                self.graph.mark_failed(build_unit.id, msg)
                                errors = errors.push((build_unit.path, msg))
                                self.stats = BuildStats(total_units: self.stats.total_units,
                                    completed: self.stats.completed,
                                    failed: self.stats.failed + 1,
                                    skipped: self.stats.skipped,
                                    parallel_batches: self.stats.parallel_batches)
                        chunk_idx = chunk_idx + 1

                    batch_idx = chunk_end

        BuildResult(success: not self.graph.has_failures(),
                    stats: self.stats, errors: errors, outputs: outputs)

    me build_parallel(spawn_fn: any, collect_fn: any) -> BuildResult:
        """Execute the build using process-based parallelism.

        spawn_fn(path: text) -> i64:
            Launches a subprocess to compile the given module path.
            Returns a process ID (pid), or -1 on spawn failure.

        collect_fn(exit_code: i64, path: text) -> Result<text, text>:
            Called after the subprocess finishes. Receives exit code and
            module path. Returns Ok(output_path) or Err(error_message).
            The process is already reaped; read output files here.

        Units are spawned up to max_workers concurrently. When a process
        finishes, newly ready units are spawned immediately, keeping
        the worker pool saturated.
        """
        # `graph.units` is a Dict; Dict.len() returns -1 natively. Units are only
        # ever added (never removed), so `next_id` is the exact unit count.
        val total = self.graph.next_id
        val max_workers = self.config.effective_threads()
        self.stats = BuildStats(total_units: total, completed: 0, failed: 0,
                                skipped: 0, parallel_batches: 0)
        var errors: [(text, text)] = []
        var outputs: [text] = []

        if self.config.verbose:
            print "[PARALLEL] process-parallel mode, {max_workers} workers, {total} units"

        # pid -> unit_id mapping for in-flight processes
        var in_flight_pid: {i64: i64} = {}
        var in_flight_path: {i64: text} = {}
        # Explicit entry count for `in_flight_pid`. Dict.len() returns -1 in
        # natively-compiled code, so `in_flight_pid.len() < max_workers` was
        # `-1 < max_workers` -- always true -- and every ready unit spawned at
        # once (fork storm). keys().len() would be correct but allocates on
        # every iteration of this hot spawn loop, so we maintain a counter.
        # Invariant: incremented at the single insert site below, decremented at
        # the single remove site; the two `continue` paths above it insert
        # nothing, and the post-loop drain does not re-read the counter, so it
        # cannot drift.
        var in_flight_count = 0

        while not self.graph.is_complete():
            # Fill worker slots with ready units
            val ready = self.graph.ready_units()
            var ready_idx = 0
            while in_flight_count < max_workers and ready_idx < ready.len():
                val build_unit = ready[ready_idx]
                ready_idx = ready_idx + 1

                # Check dependency failures
                var dep_failed = false
                for dep_id in build_unit.dependencies:
                    if self.graph.units.has(dep_id):
                        match self.graph.units[dep_id].status:
                            case Failed(_): dep_failed = true
                            case _: ()
                if dep_failed:
                    self.graph.mark_failed(build_unit.id, "Dependency failed")
                    self.stats = BuildStats(total_units: self.stats.total_units,
                        completed: self.stats.completed,
                        failed: self.stats.failed + 1,
                        skipped: self.stats.skipped,
                        parallel_batches: self.stats.parallel_batches)
                    continue

                self.graph.mark_in_progress(build_unit.id)
                val pid = spawn_fn(build_unit.path)
                if pid < 0:
                    self.graph.mark_failed(build_unit.id, "Failed to spawn compilation process")
                    errors = errors.push((build_unit.path, "Failed to spawn compilation process"))
                    self.stats = BuildStats(total_units: self.stats.total_units,
                        completed: self.stats.completed,
                        failed: self.stats.failed + 1,
                        skipped: self.stats.skipped,
                        parallel_batches: self.stats.parallel_batches)
                    continue

                in_flight_pid[pid] = build_unit.id
                in_flight_path[pid] = build_unit.path
                in_flight_count = in_flight_count + 1
                if self.config.verbose:
                    print "[PARALLEL] spawned pid={pid} for {build_unit.path}"

            # If nothing in-flight and nothing ready, we're stuck
            if in_flight_count == 0:
                break

            # Wait for one process to finish before recomputing ready work.
            val (finished_pid, finished_exit_code) = self.wait_for_finished_process(in_flight_pid, in_flight_count)
            if finished_pid < 0:
                break

            # Collect result from finished process
            val unit_id = in_flight_pid[finished_pid]
            val unit_path = in_flight_path[finished_pid]
            in_flight_pid.remove(finished_pid)
            in_flight_path.remove(finished_pid)
            in_flight_count = in_flight_count - 1

            val result = collect_fn(finished_exit_code, unit_path)
            match result:
                case Ok(output):
                    self.graph.mark_completed(unit_id, Some(output))
                    outputs = outputs.push(output)
                    self.stats = BuildStats(total_units: self.stats.total_units,
                        completed: self.stats.completed + 1,
                        failed: self.stats.failed,
                        skipped: self.stats.skipped,
                        parallel_batches: self.stats.parallel_batches)
                    if self.config.verbose:
                        print "[PARALLEL] completed {unit_path}"
                case Err(msg):
                    self.graph.mark_failed(unit_id, msg)
                    errors = errors.push((unit_path, msg))
                    self.stats = BuildStats(total_units: self.stats.total_units,
                        completed: self.stats.completed,
                        failed: self.stats.failed + 1,
                        skipped: self.stats.skipped,
                        parallel_batches: self.stats.parallel_batches)
                    if self.config.verbose:
                        print "[PARALLEL] failed {unit_path}: {msg}"

            self.stats = BuildStats(total_units: self.stats.total_units,
                completed: self.stats.completed, failed: self.stats.failed,
                skipped: self.stats.skipped,
                parallel_batches: self.stats.parallel_batches + 1)

        # Drain remaining in-flight processes on early exit
        # BUG-001 fix: Use keys()-based iteration (for (k,v) in dict is broken in compiled mode)
        for pid in in_flight_pid.keys():
            val unit_id = in_flight_pid[pid]
            val unit_path = in_flight_path[pid]
            rt_process_kill(pid)
            self.graph.mark_failed(unit_id, "Build cancelled")
            errors = errors.push((unit_path, "Build cancelled"))

        BuildResult(success: not self.graph.has_failures(),
                    stats: self.stats, errors: errors, outputs: outputs)

    # ========================================================================
    # Unstable mode: one child process per unit, supervised
    # ========================================================================

    me build_supervised(spawn_fn: any, artifact_fn: any) -> BuildOutcomeSet:
        """Compile every unit in its OWN CHILD PROCESS and classify each fate.

        spawn_fn(path: text) -> i64
            Launches a child compiling `path`. Returns its pid, or < 0 on spawn
            failure. Wrap the child with `parallel_supervised_argv()` so a death
            by signal survives as a 128+N status — see that function's comment.

        artifact_fn(path: text) -> text
            The artifact the unit is declared to produce, or "" when the caller
            has none to check. A unit is OK only when its child exited 0 AND this
            file EXISTS. Nothing here ever creates it: fabricating an artifact for
            a dead unit is forbidden (R4).

        Contract, all of which the accompanying spec pins:

        * A child's death — SIGSEGV, SIGABRT, SIGKILL/OOM, SIGTERM — is observed,
          not suffered. The parent survives it and the loop keeps going, so the
          build REACHES THE END of the source list no matter how many units die.
        * The wait status is read DIRECTLY into a local (`val status = ...`),
          never through a pipe. `cmd | tail` yields tail's status, and that exact
          mistake has manufactured false greens in this repo repeatedly.
        * Classification is delegated wholesale to `BuildUnitOutcome.from_status`
          so this file cannot invent a second, drifting mapping of 128+N.
        * TERMINATED (143, earlyoom is actively SIGTERMing `simple` on this host)
          and TIMEOUT are UNVERIFIED — reported, never counted as failures.
        * A unit the build never reached is recorded NOT_RUN explicitly. Silent
          absence is forbidden (R3).
        """
        val outcomes = BuildOutcomeSet.empty()
        val max_workers = self.config.effective_threads()
        val budget = self.config.unit_timeout_ms
        val order = self.graph.topological_order()

        # Per-unit bookkeeping for the in-flight children, held as PARALLEL TYPED
        # ARRAYS rather than pid-keyed dicts. This is not a style choice: dict
        # `keys()` yields type-ERASED elements, and handing one to an extern fails
        # at runtime with "rt_process_wait: pid must be an integer" — a local
        # `val pid: i64 = ...` does not re-narrow it. Arrays of `i64` keep the
        # element type all the way to the extern call. They also make the
        # in-flight count exact without a hand-maintained counter, sidestepping
        # the `Dict.len() == -1` fork-storm hazard documented in `build_parallel`.
        var live_pid: [i64] = []
        var live_unit: [i64] = []
        var live_path: [text] = []
        var live_start: [i64] = []
        var attempted: [i64] = []
        var next_idx = 0

        if self.config.verbose:
            print "[SUPERVISED] unstable mode, {max_workers} workers, budget_ms={budget}"

        while true:
            # --- Fill worker slots (bounded concurrency, R7) ------------------
            while live_pid.len() < max_workers and next_idx < order.len():
                val id = order[next_idx]
                next_idx = next_idx + 1
                if not self.graph.units.has(id):
                    continue
                val unit_path = self.graph.units[id].path
                attempted = attempted.push(id)
                val pid = spawn_fn(unit_path)
                if pid < 0:
                    # Never spawned, so no status exists to classify. Status -1
                    # is not a 128+N encoding, so this lands in ERROR.
                    outcomes.record(BuildUnitOutcome.from_status(
                        id, unit_path, -1, false, 0, 0,
                        "failed to spawn child process"))
                    continue
                live_pid = live_pid.push(pid)
                live_unit = live_unit.push(id)
                live_path = live_path.push(unit_path)
                live_start = live_start.push(rt_time_now_monotonic_ms())
                if self.config.verbose:
                    print "[SUPERVISED] spawned pid={pid} for {unit_path}"

            if live_pid.len() == 0:
                if next_idx >= order.len():
                    break
                # Every spawn in the last pass failed; `next_idx` advanced, so
                # this cannot spin.
                continue

            # --- Reap whatever has finished ----------------------------------
            # One pass over the in-flight set. Finished units are recorded and
            # dropped; the survivors are carried into rebuilt arrays, so nothing
            # is mutated while it is being scanned.
            var kept_pid: [i64] = []
            var kept_unit: [i64] = []
            var kept_path: [text] = []
            var kept_start: [i64] = []
            var reaped = 0

            var live_idx = 0
            while live_idx < live_pid.len():
                val pid = live_pid[live_idx]
                val unit_id = live_unit[live_idx]
                val unit_path = live_path[live_idx]
                val started = live_start[live_idx]
                live_idx = live_idx + 1

                # The wait status is read DIRECTLY into this variable. There is
                # no pipeline anywhere on this path, by design.
                var status = rt_process_wait(pid, 1)
                var timed_out = false
                if status == -2:
                    # Still running. Enforce the per-unit budget ourselves.
                    var expired = false
                    if budget > 0 and (rt_time_now_monotonic_ms() - started) > budget:
                        expired = true
                    if not expired:
                        kept_pid = kept_pid.push(pid)
                        kept_unit = kept_unit.push(unit_id)
                        kept_path = kept_path.push(unit_path)
                        kept_start = kept_start.push(started)
                        continue
                    rt_process_kill(pid)
                    # 137 = 128+SIGKILL, which is what enforced the budget;
                    # `timed_out` is what decides the category.
                    status = 137
                    timed_out = true

                reaped = reaped + 1
                val wall_ms = rt_time_now_monotonic_ms() - started

                if status == 0 and not timed_out:
                    # OK requires exit 0 AND the declared artifact on disk. A
                    # clean exit that produced nothing is an ERROR, never an OK,
                    # and nothing below creates the missing file (R4).
                    val declared = artifact_fn(unit_path)
                    if declared != "" and not rt_file_exists(declared):
                        outcomes.record(BuildUnitOutcome.from_status(
                            unit_id, unit_path, 1, false, wall_ms, 0,
                            "exit 0 but declared artifact is missing: {declared}"))
                        self.graph.mark_failed(unit_id, "declared artifact missing")
                    else:
                        outcomes.record(BuildUnitOutcome.ok(unit_id, unit_path, wall_ms, 0))
                        self.graph.mark_completed(unit_id, Some(declared))
                else:
                    val record = BuildUnitOutcome.from_status(
                        unit_id, unit_path, status, timed_out, wall_ms, 0, "")
                    outcomes.record(record)
                    # The graph tracks "did not produce an artifact"; the OUTCOME
                    # set is what preserves the failed / unverified distinction.
                    self.graph.mark_failed(unit_id, build_outcome_kind_label(record.kind))
                    if self.config.verbose:
                        print record.attribution_line()

            # Survivors carry over; everything reaped above has been recorded.
            live_pid = kept_pid
            live_unit = kept_unit
            live_path = kept_path
            live_start = kept_start
            if reaped == 0:
                rt_thread_sleep(10)

        # --- Anything never attempted is NOT_RUN, stated explicitly (R3) ------
        for id in order:
            var was_attempted = false
            for done_id in attempted:
                if done_id == id:
                    was_attempted = true
            if was_attempted:
                continue
            if not self.graph.units.has(id):
                continue
            outcomes.record(BuildUnitOutcome.not_run(id, self.graph.units[id].path))

        outcomes
