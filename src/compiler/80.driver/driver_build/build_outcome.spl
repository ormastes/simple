use std.nogc_async_mut.sosix.environment.{sosix_env_get_nullable}

# Build Outcome Records
#
# The shared vocabulary for "what happened to one unit of work" during a build.
# It exists so the supervisor, the parallel builder and the AOT native output
# path all classify a unit's fate the SAME way instead of each inventing its own
# incompatible notion of failure.
#
# The six categories are deliberately DISJOINT and must never collapse into one
# another. See R2 of doc/02_requirements/compiler/supervised_builder.md.
#
# Read this before "simplifying" TERMINATED or TIMEOUT into a failure:
#
#   `earlyoom` on this host is configured `--prefer ^(simple|...) --avoid
#   ^(claude|...)` and actively SIGTERMs `simple` processes. A wait status of 143
#   is therefore INFRASTRUCTURE, not a compiler verdict: the unit is UNVERIFIED,
#   not failed. The same is true of a TIMEOUT — a unit that exceeded its budget on
#   a contended box was never given an answer to report. Conflating either with a
#   real failure manufactures phantom compiler bugs, which has already happened on
#   this repo today (see the stage-3 `exit 143` incident in that requirement doc).
#
# Fail-closed is still the rule at the LINK boundary: an UNVERIFIED unit produced
# no object, and fabricating one is forbidden (R4 — cf. the existing defect at
# linker/native_binary/stubs.rs:209-221, where fabricated zero-returning stubs
# masked missing symbols). "UNVERIFIED, not failed" governs how the outcome is
# REPORTED, never whether the build is allowed to link without the artifact.

# ============================================================================
# Categories
# ============================================================================

# | variant      | detection                                                   |
# |--------------|-------------------------------------------------------------|
# | OK           | exit 0 AND the declared artifact exists on disk             |
# | ERROR        | clean exit, non-zero, diagnostics captured                  |
# | CRASHED      | killed by signal — 139 SIGSEGV, 134 SIGABRT, 137 SIGKILL/OOM|
# | TERMINATED   | 143 SIGTERM — external; UNVERIFIED, NOT a failure           |
# | TIMEOUT      | exceeded the per-unit budget — UNVERIFIED, NOT a failure     |
# | NOT_RUN      | never started (the build ended first) — stated, never silent |
enum BuildOutcomeKind:
    OK
    ERROR
    CRASHED
    TERMINATED
    TIMEOUT
    NOT_RUN

# Stable, lowercase-free label used in summaries and in the fail-closed message.
# Kept as a free function rather than a method so it can be called on a kind read
# back out of a record without an intermediate binding.
fn build_outcome_kind_label(kind: BuildOutcomeKind) -> text:
    match kind:
        case OK: "OK"
        case ERROR: "ERROR"
        case CRASHED: "CRASHED"
        case TERMINATED: "TERMINATED"
        case TIMEOUT: "TIMEOUT"
        case NOT_RUN: "NOT_RUN"

# The fixed reporting order. Summaries iterate THIS, never a dict's key order, so
# two runs over the same inputs emit byte-identical text.
fn build_outcome_kind_order() -> [BuildOutcomeKind]:
    [BuildOutcomeKind.OK, BuildOutcomeKind.ERROR, BuildOutcomeKind.CRASHED,
     BuildOutcomeKind.TERMINATED, BuildOutcomeKind.TIMEOUT,
     BuildOutcomeKind.NOT_RUN]

# True for the categories that describe the HOST rather than the code. These are
# reported as UNVERIFIED and are NOT counted as failures — see the header.
fn build_outcome_is_unverified(kind: BuildOutcomeKind) -> bool:
    match kind:
        case TERMINATED: true
        case TIMEOUT: true
        case _: false

# True only for a category that is a genuine verdict against the source.
fn build_outcome_is_failure(kind: BuildOutcomeKind) -> bool:
    match kind:
        case ERROR: true
        case CRASHED: true
        case _: false

# ============================================================================
# Wait-status classification
# ============================================================================
#
# A child's wait status is read DIRECTLY, never through a pipe: `$?` after a
# pipeline is the pipeline's last status, which has already produced false greens
# in this repo. By the shell convention a status of 128+N means "killed by signal
# N", so 139 = SIGSEGV(11), 137 = SIGKILL(9), 134 = SIGABRT(6), 143 = SIGTERM(15).

# Signal number encoded in a 128+N (or negative -(128+N) from rt_process_wait)
# wait status, or 0 when the status is a plain exit code.
fn build_outcome_signal_of_status(status: i64) -> i64:
    if status > 128 and status < 192:
        return status - 128
    if status < -128 and status > -192:
        return -status - 128
    0

# Classify a raw wait status. `timed_out` is passed separately because a unit the
# supervisor killed on its own budget is a TIMEOUT no matter which signal did the
# killing — the budget is the fact that matters, not the SIGKILL that enforced it.
fn build_outcome_classify_status(status: i64, timed_out: bool) -> BuildOutcomeKind:
    if timed_out:
        return BuildOutcomeKind.TIMEOUT
    if status == 0:
        return BuildOutcomeKind.OK
    val signal_num = build_outcome_signal_of_status(status)
    if signal_num == 15:
        # SIGTERM: external. UNVERIFIED, not failed. See the header.
        return BuildOutcomeKind.TERMINATED
    if signal_num > 0:
        # Any other signal death — SIGSEGV(11), SIGABRT(6), SIGKILL/OOM(9) — is a
        # crash of the compiler itself.
        return BuildOutcomeKind.CRASHED
    BuildOutcomeKind.ERROR

# ============================================================================
# Per-unit record
# ============================================================================

# ============================================================================
# Bounded accumulation (R9)
# ============================================================================
#
# Collect-all must not kill the run it is reporting on. Measured 2026-08-17: at
# 124 of 619 files a stage-3 build had accumulated 2,926 errors with RSS climbing
# ~1 GB / 30s (8.0 -> 15.1 GB); linear extrapolation is ~14,500 errors and
# +25-30 GB. `earlyoom` fires at 10% free on this host and had already killed a
# bootstrap that day. Unbounded RETENTION of diagnostic text therefore converts a
# complete error census into no census at all.
#
# The rules, and why each one is not negotiable:
#
#   * Cap RETAINED text per unit, not merely DISPLAYED text. The pre-existing
#     `[hir-fatal-count] ... shown=10` cap bounded output only; the count kept
#     rising while memory kept growing, which is precisely the measurement above.
#   * NEVER cap the COUNT. `total=1948` stays exact even when 10 lines are kept.
#     A truncated count lies about the SIZE of the problem; truncated text is
#     merely less convenient.
#   * Spill to the LOG, not the heap. The discarded text is appended to a file
#     once and read later; nothing needs it in memory until the end of the build.
#   * REPORT the policy in the summary, so a reader knows whether they are seeing
#     everything (`shown=N retained=N total=M`). Silent truncation is the same
#     defect class as a silent failure.
extern fn rt_file_append_text(path: text, content: text) -> bool
extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_dir_create_all(path: text) -> bool

# Diagnostic lines kept verbatim per unit. Matches the existing display cap so
# retained and shown are the same number and the summary can say so honestly.
fn build_outcome_retained_line_cap() -> i64:
    val override = sosix_env_get_nullable("SIMPLE_BUILD_DIAG_RETAIN") ?? ""
    if override != "":
        # Hand-rolled rather than `text.to_i64()`: this tree has an open defect
        # where a chained `.to_i64()` returns garbage under JIT (see the same
        # note in 10.frontend/effect_registry.spl). A garbage cap here would
        # silently change how much evidence a failing build keeps.
        var parsed = 0
        var ok = true
        for ch in override:
            val digit = ch.to_i64() - "0".to_i64()
            if digit < 0 or digit > 9:
                ok = false
            else:
                parsed = parsed * 10 + digit
        if ok and parsed > 0:
            return parsed
    10

# Where discarded diagnostic text goes. It is DISCARDED FROM MEMORY, not lost.
fn build_outcome_spill_log_path() -> text:
    val override = sosix_env_get_nullable("SIMPLE_BUILD_DIAG_LOG") ?? ""
    if override != "":
        return override
    "build/build_diagnostics.log"

# Count the non-empty lines of a diagnostic blob. This is the EXACT total and is
# never capped by anything below.
fn build_outcome_count_diagnostic_lines(diagnostics: text) -> i64:
    if diagnostics == "":
        return 0
    var count = 0
    for line in diagnostics.split("\n"):
        if line != "":
            count = count + 1
    count

# Truncate to the retention cap, spilling the FULL text to the log first.
# Returns the text to keep in memory. The caller records the exact total
# separately, so nothing here can shrink a count.
fn build_outcome_retain_diagnostics(source_path: text, diagnostics: text) -> text:
    val cap = build_outcome_retained_line_cap()
    val total = build_outcome_count_diagnostic_lines(diagnostics)
    if total <= cap:
        return diagnostics
    # Spill BEFORE dropping. A failed append is not fatal -- losing the tail of a
    # diagnostic must never abort the build that was reporting it -- but the
    # retained text says so, so no reader mistakes a spill failure for silence.
    val log_path = build_outcome_spill_log_path()
    val spilled = rt_file_append_text(log_path,
        "===== {source_path} ({total} diagnostic line(s)) =====\n{diagnostics}\n")
    var kept = ""
    var taken = 0
    for line in diagnostics.split("\n"):
        if line == "":
            continue
        if taken >= cap:
            break
        if kept != "":
            kept = kept + "\n"
        kept = kept + line
        taken = taken + 1
    val note = if spilled:
        "(+{total - cap} more line(s) spilled to {log_path})"
    else:
        "(+{total - cap} more line(s) DISCARDED -- could not append to {log_path})"
    kept + "\n" + note

# How many lines `build_outcome_retain_diagnostics` keeps for this blob. Paired
# with `build_outcome_count_diagnostic_lines` (the EXACT total) so a caller that
# builds the record directly reports the same `shown=/total=` pair as
# `from_status`.
fn build_outcome_retained_diagnostic_count(diagnostics: text) -> i64:
    val total = build_outcome_count_diagnostic_lines(diagnostics)
    val cap = build_outcome_retained_line_cap()
    if total > cap: cap else: total

struct BuildUnitOutcome:
    unit_id: i64            # supervisor-assigned id, stable within one build
    source_path: text       # the file this unit was compiling
    kind: BuildOutcomeKind
    # Plain exit code, or 128+N when the unit died by signal N. Kept RAW so the
    # attribution log can state exactly what the supervisor saw (R5).
    status: i64
    signal_num: i64         # 0 when the unit exited rather than died
    wall_ms: i64
    peak_rss_kb: i64
    diagnostics: text       # non-empty for ERROR; the compiler's own message
    # R9. `diagnostic_total` is the EXACT number of diagnostic lines this unit
    # produced and is never capped by anything; `diagnostic_retained` is how many
    # of them `diagnostics` still holds in memory. When they differ, the rest was
    # spilled to `build_outcome_spill_log_path()` -- the summary states this.
    diagnostic_total: i64
    diagnostic_retained: i64

impl BuildUnitOutcome:
    static fn ok(unit_id: i64, source_path: text, wall_ms: i64, peak_rss_kb: i64) -> BuildUnitOutcome:
        BuildUnitOutcome(unit_id: unit_id, source_path: source_path,
                         kind: BuildOutcomeKind.OK, status: 0, signal_num: 0,
                         wall_ms: wall_ms, peak_rss_kb: peak_rss_kb,
                         diagnostics: "",
                         diagnostic_total: 0, diagnostic_retained: 0)

    # A unit the build never got to. Stated explicitly — silent absence is
    # forbidden (R3).
    static fn not_run(unit_id: i64, source_path: text) -> BuildUnitOutcome:
        BuildUnitOutcome(unit_id: unit_id, source_path: source_path,
                         kind: BuildOutcomeKind.NOT_RUN, status: 0, signal_num: 0,
                         wall_ms: 0, peak_rss_kb: 0,
                         diagnostics: "never started (build ended first)",
                         diagnostic_total: 1, diagnostic_retained: 1)

    # Build a record from what the supervisor actually observed. This is the
    # normal constructor: classification lives in one place so no caller can
    # invent its own mapping.
    static fn from_status(unit_id: i64, source_path: text, status: i64,
                          timed_out: bool, wall_ms: i64, peak_rss_kb: i64,
                          diagnostics: text) -> BuildUnitOutcome:
        # R9: the COUNT is taken from the full text and kept exact; only the TEXT
        # is bounded. Doing it in this order is the whole requirement -- capping
        # first and counting after is how a truncated census starts lying.
        val total = build_outcome_count_diagnostic_lines(diagnostics)
        val cap = build_outcome_retained_line_cap()
        val kept = build_outcome_retain_diagnostics(source_path, diagnostics)
        val retained = if total > cap: cap else: total
        BuildUnitOutcome(unit_id: unit_id, source_path: source_path,
                         kind: build_outcome_classify_status(status, timed_out),
                         status: status,
                         signal_num: build_outcome_signal_of_status(status),
                         wall_ms: wall_ms, peak_rss_kb: peak_rss_kb,
                         diagnostics: kept,
                         diagnostic_total: total, diagnostic_retained: retained)

    fn label() -> text:
        build_outcome_kind_label(self.kind)

    fn is_ok() -> bool:
        match self.kind:
            case OK: true
            case _: false

    # One line of death attribution: unit id, path, signal or exit code, wall
    # time, peak RSS. This is exactly what was missing when stage 3 was SIGTERMed
    # with 43 files left (R5), and it answers "which file is slow" on a host where
    # attach-based profiling is blocked (ptrace_scope=1, perf_event_paranoid=4).
    fn attribution_line() -> text:
        val cause = if self.signal_num > 0:
            "signal={self.signal_num}"
        else:
            "exit={self.status}"
        "[build-outcome] unit={self.unit_id} {self.label()} {cause} wall_ms={self.wall_ms} rss_kb={self.peak_rss_kb} {self.source_path}"

# ============================================================================
# Accumulator
# ============================================================================

class BuildOutcomeSet:
    """Accumulates one record per unit and answers questions about the whole set.

    The point of accumulating rather than returning early: ONE build must report
    EVERY bad unit. A phase that abandons the remaining work on the first failure
    makes each defect cost a full build to find.
    """
    records: [BuildUnitOutcome]
    paths_seen: {text: bool}

impl BuildOutcomeSet:
    static fn empty() -> BuildOutcomeSet:
        BuildOutcomeSet(records: [], paths_seen: {})

    me record(outcome: BuildUnitOutcome):
        self.records = self.records.push(outcome)
        self.paths_seen[outcome.source_path] = true

    fn len() -> i64:
        self.records.len()

    fn has_path(source_path: text) -> bool:
        if self.paths_seen.contains_key(source_path):
            return true
        if self.paths_seen.keys().len() == 0 and self.records.len() > 0:
            for outcome in self.records:
                if outcome.source_path == source_path:
                    return true
        false

    # Peak RSS (KiB) recorded for one unit, or -1 when no record exists.
    fn peak_rss_kb_of(source_path: text) -> i64:
        for outcome in self.records:
            if outcome.source_path == source_path:
                return outcome.peak_rss_kb
        -1

    fn count_of(kind: BuildOutcomeKind) -> i64:
        self.paths_in(kind).len()

    # Paths in one category, sorted. Sorting is what makes the summary
    # byte-identical across runs: units finish in whatever order the host
    # schedules them, so insertion order is NOT reproducible.
    fn paths_in(kind: BuildOutcomeKind) -> [text]:
        val want = build_outcome_kind_label(kind)
        var found: [text] = []
        for outcome in self.records:
            if build_outcome_kind_label(outcome.kind) == want:
                found = found.push(outcome.source_path)
        build_outcome_sort_text(found)

    fn ok_count() -> i64:
        self.count_of(BuildOutcomeKind.OK)

    # Genuine verdicts against the source only — UNVERIFIED categories are
    # excluded here by design.
    fn failure_count() -> i64:
        self.count_of(BuildOutcomeKind.ERROR) + self.count_of(BuildOutcomeKind.CRASHED)

    fn unverified_count() -> i64:
        self.count_of(BuildOutcomeKind.TERMINATED) + self.count_of(BuildOutcomeKind.TIMEOUT)

    fn not_run_count() -> i64:
        self.count_of(BuildOutcomeKind.NOT_RUN)

    fn all_ok() -> bool:
        for outcome in self.records:
            if not outcome.is_ok():
                return false
        true

    # The fail-closed message for the link boundary. Empty when every unit is OK.
    # Non-OK is non-OK even when UNVERIFIED: there is no artifact to link, and
    # fabricating one is forbidden. The wording keeps the distinction visible.
    fn verdict() -> text:
        if self.all_ok():
            return ""
        var parts = ""
        for kind in build_outcome_kind_order():
            if build_outcome_is_unverified(kind) or build_outcome_is_failure(kind) or build_outcome_kind_label(kind) == "NOT_RUN":
                val paths = self.paths_in(kind)
                if paths.len() > 0:
                    if parts != "":
                        parts = parts + "; "
                    parts = parts + "{build_outcome_kind_label(kind)}: {build_outcome_text_list(paths)}"
        "build failed: {self.failure_count()} failed, {self.unverified_count()} unverified, {self.not_run_count()} not run, {self.ok_count()} ok of {self.len()} unit(s) — {parts}"

    # Deterministic end-of-build summary naming EVERY non-OK unit with its
    # category. Returned as text rather than printed so a spec can compare two
    # runs byte-for-byte.
    fn summary() -> text:
        var out = "===== build outcome summary =====\n"
        for kind in build_outcome_kind_order():
            val label = build_outcome_kind_label(kind)
            out = out + "{label}={self.count_of(kind)}\n"
        for kind in build_outcome_kind_order():
            if build_outcome_kind_label(kind) == "OK":
                continue
            val paths = self.paths_in(kind)
            if paths.len() > 0:
                val tag = if build_outcome_is_unverified(kind):
                    "{build_outcome_kind_label(kind)} (UNVERIFIED — infrastructure, not a compiler verdict)"
                else:
                    build_outcome_kind_label(kind)
                out = out + "{tag}: {paths.len()} unit(s)\n"
                for path in paths:
                    out = out + "  - {path}\n"
                    # A unit reported as non-OK MUST carry its reason HERE.
                    # Until 2026-08-17 this loop printed the path alone, so an
                    # `ERROR=1` summary was structurally incapable of saying
                    # WHY -- the producer had already stored the compiler's own
                    # message in `diagnostics` (see
                    # driver_native_record_module_failure) and nothing ever
                    # read it back out. That made every native-build failure
                    # unattributable, and it was misread as stderr truncation
                    # eating the message; the message was never printed at all.
                    # See doc/08_tracking/bug/
                    # native_compile_fails_with_no_diagnostic_stderr_truncated_from_middle_2026-08-17.md
                    out = out + self.reason_block_for(path)
        out + "===== end build outcome summary =====\n"

    # The indented `reason:` block for one non-OK path. Never empty: a missing
    # diagnostic is STATED as a producer bug rather than rendered as silence,
    # because silence is indistinguishable from "no failure" to every reader.
    fn reason_block_for(source_path: text) -> text:
        for outcome in self.records:
            if outcome.source_path == source_path:
                # These two fallbacks used to emit BYTE-IDENTICAL text, so a
                # reader could not tell "the producer stored nothing" from "the
                # producer stored something that renders as nothing" -- two
                # different defects with two different fixes. That ambiguity
                # blinded four investigations on 2026-09-06. Name the site, and
                # report the LENGTH and the producer's own exact line counts, so
                # a corrupt-but-non-empty payload (the `<invalid-heap:0x…>` shape)
                # is visibly distinct from a genuinely absent one.
                if outcome.diagnostics == "" or outcome.diagnostics.len() <= 0:
                    return "      reason: (none recorded [empty-at-record] — BUG in the"
                        + " producer: a non-OK unit must carry a diagnostic;"
                        + " diagnostics-len={outcome.diagnostics.len()}"
                        + " total={outcome.diagnostic_total}"
                        + " retained={outcome.diagnostic_retained})\n"
                var block = ""
                for line in outcome.diagnostics.split("\n"):
                    if line != "":
                        block = block + "      reason: {line}\n"
                if block == "":
                    # Non-empty by both tests above, yet split/render produced no
                    # line: the stored text did not survive being read back. That
                    # is the text-crossing defect, NOT a producer that forgot a
                    # reason -- say so, and keep the measured length as evidence.
                    return "      reason: (none recorded [lost-in-render] — the stored"
                        + " diagnostic is non-empty but renders as no lines;"
                        + " diagnostics-len={outcome.diagnostics.len()}"
                        + " total={outcome.diagnostic_total}"
                        + " retained={outcome.diagnostic_retained};"
                        + " tracked in doc/08_tracking/bug/"
                        + "stage2_aot_error_message_lost_invalid_heap_2026-09-06.md)\n"
                # R9: state the retention policy whenever text was dropped, so a
                # reader can tell "10 problems" from "10 of 1948 problems". The
                # count is always exact; only the text is bounded.
                if outcome.diagnostic_total > outcome.diagnostic_retained:
                    block = block + "      reason-retention: shown={outcome.diagnostic_retained} retained={outcome.diagnostic_retained} total={outcome.diagnostic_total} (full text in {build_outcome_spill_log_path()})\n"
                return block
        "      reason: (no record found for this path — BUG in the accumulator)\n"

# ============================================================================
# Small local helpers
# ============================================================================

# Insertion sort over text. Local rather than imported to keep this module free
# of dependencies the bootstrap stages might not have loaded yet.
fn build_outcome_sort_text(items: [text]) -> [text]:
    var sorted: [text] = []
    for item in items:
        var placed: [text] = []
        var inserted = false
        for existing in sorted:
            if not inserted and item < existing:
                placed = placed.push(item)
                inserted = true
            placed = placed.push(existing)
        if not inserted:
            placed = placed.push(item)
        sorted = placed
    sorted

# `join` is a reserved word in Simple, so comma-separate by hand.
fn build_outcome_text_list(items: [text]) -> text:
    var out = ""
    for item in items:
        if out != "":
            out = out + ", "
        out = out + item
    out

# Deterministic non-PID artifact hash (no `getpid()` or timestamps) so capture
# filenames stay reproducible and comply with the PID-free artifact audit.
fn _build_outcome_diag_key_v1(seed: text) -> text:
    val alpha = "0123456789abcdef"
    var h1: i64 = 2166136261
    var h2: i64 = 33590361
    var i: i64 = 0
    while i < seed.byte_len():
        val b = seed.byte_at(i) as i64
        h1 = ((h1 * 16777619) ^ b) & 4294967295
        h2 = ((h2 * 65599) + b + i) & 4294967295
        i = i + 1
    var out = ""
    var shift = 28
    while shift >= 0:
        val n1 = (h1 >> shift) & 15
        out = out + alpha.substring(n1, n1 + 1)
        shift = shift - 4
    shift = 28
    while shift >= 0:
        val n2 = (h2 >> shift) & 15
        out = out + alpha.substring(n2, n2 + 1)
        shift = shift - 4
    out

# Decode process exit/signal status into an explicit abort label.
# Handles shell 128+N (134 SIGABRT), rt_process_wait -(128+N) (-134),
# raw negative signals (-6), and 8-bit wrapped exit 122 ((-134) & 0xff).
# reason: build exit status and timeout flag mapped to human-readable abort label
@allow(primitive_api)
pub fn build_outcome_abnormal_exit_label_v1(status: i64, timed_out: bool) -> text:
    if timed_out:
        return "TIMEOUT (killed after deadline, exit={status})"
    if status == -134 or status == 134 or status == -6:
        return "SIGABRT (signal 6, exit={status})"
    if status == 122:
        return "EXIT_122 (possible 8-bit wrapped SIGABRT signal 6)"
    if status == -139 or status == 139 or status == 117 or status == -11:
        return "SIGSEGV (signal 11, exit={status})"
    if status == -137 or status == 137 or status == 119 or status == -9:
        return "SIGKILL (signal 9, exit={status})"
    if status == -143 or status == 143 or status == 113 or status == -15:
        return "SIGTERM (signal 15, exit={status})"
    if status > 128 and status < 192:
        return "SIGNAL_{status - 128} (exit={status})"
    if status < -128 and status > -192:
        return "SIGNAL_{-status - 128} (exit={status})"
    if status == 0:
        return "EMPTY_OBJECT (exit=0)"
    "EXIT_{status}"

# Extract up to the last `max_lines` non-empty lines from captured worker output.
# reason: bounded diagnostic line slicing parameter and text output
@allow(primitive_api)
pub fn build_outcome_tail_lines_v1(raw_text: text, max_lines: i64) -> text:
    if raw_text == "" or max_lines <= 0:
        return ""
    var non_empty: [text] = []
    for line in raw_text.split("\n"):
        val trimmed = line.trim()
        if trimmed != "":
            non_empty.push(trimmed)
    if non_empty.len() == 0:
        return ""
    val start = if non_empty.len() > max_lines: non_empty.len() - max_lines else: 0
    var kept: [text] = []
    var idx = start
    while idx < non_empty.len():
        kept.push(non_empty[idx])
        idx = idx + 1
    kept.join("\n")

fn _build_outcome_is_ephemeral_stage_path_v1(path: text) -> bool:
    if path == "":
        return false
    path.contains("simple-codegen-pool") or path.starts_with("/tmp/") or
        path.starts_with("/var/tmp/") or path.contains("/Temp/") or
        path.contains("\\Temp\\") or path.contains("/AppData/Local/Temp")

pub fn build_outcome_diagnostics_dir_v1(ledger_or_root: text = "") -> text:
    val native_dir = (sosix_env_get_nullable("SIMPLE_NATIVE_BUILD_DIAG_DIR") ?? "").trim()
    if native_dir != "":
        return native_dir
    val build_dir = (sosix_env_get_nullable("SIMPLE_BUILD_DIAG_DIR") ?? "").trim()
    if build_dir != "":
        return build_dir
    val root = ledger_or_root.trim()
    if root != "" and not _build_outcome_is_ephemeral_stage_path_v1(root):
        return "{root}/diagnostics"
    val cache_dir = (sosix_env_get_nullable("SIMPLE_NATIVE_CACHE_DIR") ??
        (sosix_env_get_nullable("SIMPLE_CACHE_DIR") ?? "")).trim()
    if cache_dir != "" and not _build_outcome_is_ephemeral_stage_path_v1(cache_dir):
        return "{cache_dir}/diagnostics"
    ".simple/build/diagnostics"

# Write one bounded diagnostic artifact into `diag_dir` when a worker or
# unit compilation aborts. Filename is keyed deterministically without PIDs.
# reason: status code and timeout scalar characterize abnormal child termination
@allow(primitive_api)
pub fn build_outcome_write_diag_artifact_v1(diag_dir: text, prefix: text,
        module_name: text, slot_label: text, status: i64, timed_out: bool,
        detail_header: text, stderr_text: text) -> text:
    val target_dir = if diag_dir != "": diag_dir else: build_outcome_diagnostics_dir_v1("")
    if not rt_dir_create_all(target_dir):
        return ""
    val label = build_outcome_abnormal_exit_label_v1(status, timed_out)
    val tail = build_outcome_tail_lines_v1(stderr_text, 64)
    val mod_text = if module_name != "": module_name else: "<unknown-module>"
    val key = _build_outcome_diag_key_v1("{prefix}|{mod_text}|{slot_label}|{status}|{detail_header}|{tail}")
    val path = "{target_dir}/{prefix}-{key}.log"
    var body = "module: {mod_text}\n"
    if slot_label != "":
        body = body + "worker: {slot_label}\n"
    body = body + "abort: {label}\n"
    if detail_header != "":
        body = body + "detail: {detail_header}\n"
    if tail != "":
        body = body + "stderr_tail:\n{tail}\n"
    else:
        body = body + "stderr_tail: <empty>\n"
    if rt_file_write_text(path, body): path else: ""

# Capture unit stderr/diagnostic attribution into `diagnostics/` for parallel
# and `--threads 1` in-process lanes.
# reason: unit id, exit status, and timeout flag describe the failing unit
@allow(primitive_api)
pub fn build_outcome_capture_worker_stderr_v1(source_path: text, unit_id: i64,
        status: i64, timed_out: bool, stderr_text: text, diag_dir: text = "") -> text:
    build_outcome_write_diag_artifact_v1(
        diag_dir, "worker-abort", source_path, "unit-{unit_id}",
        status, timed_out, "", stderr_text)

# Canonical single-line attribution shared across `--threads 1` in-process,
# parallel worker pool, and MIR shard abort reporting paths.
# reason: unit id, exit status, and timeout flag format parity attribution line
@allow(primitive_api)
pub fn build_outcome_unit_attribution_v1(unit_id: i64, source_path: text,
        status: i64, timed_out: bool, diag_path: text, detail: text) -> text:
    val label = build_outcome_abnormal_exit_label_v1(status, timed_out)
    var line = "[build-diag] unit={unit_id} module={source_path} {label}"
    if diag_path != "":
        line = line + " diag={diag_path}"
    if detail != "":
        line = line + " detail={detail}"
    line
