# Generic instance-object producer and link wiring (per-file P-G7).
#
# Closes the object half of
# doc/08_tracking/bug/generic_instance_plan_has_no_consumer_pg6_2026-10-25.md.
#
# Producer: the MIR child that already holds a ConcreteTldrKey's template body
# (P-G4 decision / P-G5b HIR-cache owner load) and ran module-scoped mono for
# it lowers the placed instance to MIR as usual. When the coordinator set a
# stage directory, the child codegens that ONE COMDAT instance function into
# its own object, through the same backend, target, CPU and storage snapshot
# as the using module (so it carries the same COMDAT/weak linkage as the
# per-module copy, P-D), and stages it under the key: first writer wins (temp +
# atomic rename), so two consumers of one key stage one object. The
# coordinator's single-flight job for the key (P-G6) reads the staged object
# and publishes it into the producer-keyed, header-verified instance cache.
#
# Extractable instances only: a function that reads or writes a module global
# (LoadGlobal/StoreGlobal/GlobalAddr) is not staged -- its statics belong to
# the using object -- so that key fails closed and nothing is retired.
# Instances of generic types (methods keyed by a `Name<args>` use) have no
# symbol -> key mapping yet; their keys fail closed the same way.
#
# Retirement (P-G6 rule): only after a run in which EVERY needed key PASSED is
# the needed set recorded as retirable. A later MIR child drops its COMDAT copy
# of an instance only when its key is in that set AND its cached object still
# verifies; the link step then links exactly those cached objects (body
# extracted from the verified cache record). Linking an instance object next
# to a surviving COMDAT copy is safe: both are COMDAT/weak.

use std.common.crypto.sha256.{sha256_text}
use std.io_runtime.{file_exists, file_read, file_write, file_rename, file_delete, dir_create_all, getpid}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir_data.{MirModule, MirFunction}
use compiler.driver.cache.generic_specialization_list_v1.{RequiredSpecializationV1}
use compiler.driver.cache.generic_instance_build_plan_v1.{generic_instance_object_path_v1,
    generic_instance_object_verify_v1}

# Stage directory (coordinator -> MIR children): `<mir ledger>.instances/stage`.
pub val GENERIC_INSTANCE_STAGE_ENV_V1 = "SIMPLE_FILE_WORKER_INSTANCE_STAGE"
# Retire record (coordinator -> MIR children): keys whose COMDAT copies may go.
pub val GENERIC_INSTANCE_RETIRE_ENV_V1 = "SIMPLE_FILE_WORKER_INSTANCE_RETIRE"
# Link list (coordinator -> link step): one linkable instance object per line.
pub val GENERIC_INSTANCE_LINK_ENV_V1 = "SIMPLE_FILE_WORKER_INSTANCE_LINK"

# MIR child: mangled instance symbol -> ConcreteTldrKey, filled after mono.
var generic_instance_key_of_symbol_v1: Dict<text, text> = {}

pub fn generic_instance_key_record_v1(symbol: text, key: text):
    if symbol != "" and key != "":
        generic_instance_key_of_symbol_v1[symbol] = key

pub fn generic_instance_key_of_v1(symbol: text) -> text:
    if generic_instance_key_of_symbol_v1.contains_key(symbol):
        return generic_instance_key_of_symbol_v1[symbol]
    ""

fn _publish_v1(path: text, content: text) -> bool:
    val tmp = path + "." + "{getpid()}" + ".tmp"
    file_write(tmp, content) and file_rename(tmp, path)

pub fn generic_instance_stage_path_v1(stage: text, key: text) -> text:
    if stage == "" or key == "":
        return ""
    stage + "/" + sha256_text(key) + ".o"

# Stage one built instance object for `key`. First writer wins: an existing
# staged object is kept (same key, same producer -> same instance).
pub fn generic_instance_stage_publish_v1(stage: text, key: text, object_bytes: text) -> bool:
    val path = generic_instance_stage_path_v1(stage, key)
    if path == "" or object_bytes == "" or not dir_create_all(stage):
        return false
    if file_exists(path):
        return true
    _publish_v1(path, object_bytes)

# The coordinator's producer for a claimed key: the staged object bytes, or ""
# (the key fails closed with a FAILED receipt).
pub fn generic_instance_object_from_stage_v1(stage: text, spec: RequiredSpecializationV1) -> text:
    val path = generic_instance_stage_path_v1(stage, spec.concrete_key)
    if path == "" or not file_exists(path):
        return ""
    file_read(path)

# True when the function touches no module global, so it can live alone.
pub fn generic_instance_function_extractable_v1(f: MirFunction) -> bool:
    if not f.is_comdat:
        return false
    for b in f.blocks:
        for inst in b.instructions:
            if inst.bootstrap_load_global_symbol_id() >= 0:
                return false
            if inst.bootstrap_store_global_symbol_id() >= 0:
                return false
            if inst.bootstrap_global_addr_symbol_id() >= 0:
                return false
    true

# A module holding only the instance function `name` (types kept for layout;
# no statics, no constants, no other function). nil when not extractable.
pub fn generic_instance_mir_module_of_v1(module: MirModule, name: text) -> MirModule?:
    for sym in module.functions.keys():
        val f: MirFunction = module.functions[sym]
        if f.name != name:
            continue
        if not generic_instance_function_extractable_v1(f):
            return nil
        var only: Dict<SymbolId, MirFunction> = {}
        only[sym] = f
        var out = module
        out.functions = only
        out.statics = {}
        out.constants = {}
        return out
    nil

# COMDAT instance functions of `module` that map to a ConcreteTldrKey.
pub fn generic_instance_keyed_functions_v1(module: MirModule) -> [(text, text)]:
    var out: [(text, text)] = []
    for sym in module.functions.keys():
        val f: MirFunction = module.functions[sym]
        if not f.is_comdat:
            continue
        val key = generic_instance_key_of_v1(f.name)
        if key != "":
            out.push((f.name, key))
    out

# ---- retirement -----------------------------------------------------------

pub fn generic_instance_retire_path_v1(cache_root: text, producer: text) -> text:
    if cache_root == "" or producer == "":
        return ""
    cache_root + "/generic_instances/" + sha256_text(producer) + "/retire"

# Record (or clear, with ok=false) the retirable set after a run.
pub fn generic_instance_retire_record_v1(cache_root: text, producer: text, keys: [text], ok: bool) -> bool:
    val path = generic_instance_retire_path_v1(cache_root, producer)
    if path == "":
        return false
    if not ok or keys.len() == 0:
        if file_exists(path):
            val _gone = file_delete(path)
        return true
    val slash = path.rfind("/")
    if not dir_create_all(path.substring(0, slash)):
        return false
    _publish_v1(path, keys.join("\n") + "\n")

pub fn generic_instance_retire_keys_of_v1(path: text) -> [text]:
    var out: [text] = []
    if path == "" or not file_exists(path):
        return out
    for line in file_read(path).split("\n"):
        if line != "":
            out.push(line)
    out

# MIR child: drop the COMDAT copies whose key is in `retire` (the coordinator's
# snapshot of retirable keys whose cached object verified before the workers
# started). Returns the dropped keys; the link step links every snapshot key.
pub fn generic_instance_retire_in_module_v1(module: MirModule, retire: [text]) -> (MirModule, [text]):
    var out = module
    var dropped: [text] = []
    if retire.len() == 0:
        return (out, dropped)
    var kept: Dict<SymbolId, MirFunction> = {}
    for sym in module.functions.keys():
        val f: MirFunction = module.functions[sym]
        val key = if f.is_comdat: generic_instance_key_of_v1(f.name) else: ""
        if key != "" and retire.contains(key):
            dropped.push(key)
            continue
        kept[sym] = f
    out.functions = kept
    (out, dropped)

pub fn generic_instance_verified_v1(cache_root: text, producer: text, key: text) -> bool:
    val path = generic_instance_object_path_v1(cache_root, producer, key)
    path != "" and file_exists(path) and generic_instance_object_verify_v1(file_read(path), producer, key)

# Coordinator, before the workers start: the retirable keys whose cached
# object verifies right now. Children retire only these; the link links them.
pub fn generic_instance_retire_snapshot_v1(cache_root: text, producer: text) -> [text]:
    var out: [text] = []
    for key in generic_instance_retire_keys_of_v1(generic_instance_retire_path_v1(cache_root, producer)):
        if generic_instance_verified_v1(cache_root, producer, key):
            out.push(key)
    out

# ---- link wiring ----------------------------------------------------------

# Extract the linkable body of each verified cached object for `keys` into
# `link_dir`. Returns (paths, ok); ok is false when any key has no verified
# object -- the caller must then not link any instance object.
pub fn generic_instance_link_objects_v1(cache_root: text, producer: text, keys: [text],
        link_dir: text) -> ([text], bool):
    var paths: [text] = []
    if keys.len() == 0:
        return (paths, true)
    if link_dir == "" or not dir_create_all(link_dir):
        return ([], false)
    for key in keys:
        val src = generic_instance_object_path_v1(cache_root, producer, key)
        if src == "" or not file_exists(src):
            return ([], false)
        val content = file_read(src)
        if not generic_instance_object_verify_v1(content, producer, key):
            return ([], false)
        val body = content.substring(content.index_of("\n") + 1)
        val dst = link_dir + "/" + sha256_text(key) + ".o"
        if not _publish_v1(dst, body):
            return ([], false)
        paths.push(dst)
    (paths, true)

pub fn generic_instance_link_list_write_v1(path: text, objects: [text]) -> bool:
    if path == "":
        return false
    _publish_v1(path, objects.join("\n") + "\n")

pub fn generic_instance_link_list_read_v1(path: text) -> [text]:
    var out: [text] = []
    if path == "" or not file_exists(path):
        return out
    for line in file_read(path).split("\n"):
        if line != "":
            out.push(line)
    out

export GENERIC_INSTANCE_STAGE_ENV_V1, GENERIC_INSTANCE_RETIRE_ENV_V1, GENERIC_INSTANCE_LINK_ENV_V1
export generic_instance_key_record_v1, generic_instance_key_of_v1
export generic_instance_stage_path_v1, generic_instance_stage_publish_v1, generic_instance_object_from_stage_v1
export generic_instance_function_extractable_v1, generic_instance_mir_module_of_v1
export generic_instance_keyed_functions_v1
export generic_instance_retire_path_v1, generic_instance_retire_record_v1, generic_instance_retire_keys_of_v1
export generic_instance_retire_in_module_v1, generic_instance_verified_v1, generic_instance_retire_snapshot_v1
export generic_instance_link_objects_v1, generic_instance_link_list_write_v1, generic_instance_link_list_read_v1
