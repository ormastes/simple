# Go-to-end native-build mode (`native-build --go-to-end`).
#
# Bootstrap's goal is "go to the end and produce every object that CAN be
# produced". Without this mode one MIR failure stops the build before codegen
# (phase-3 attempt 7: 1250 modules lowered, 104 failed, 0 objects), and one HIR
# failure stops it before MIR. In go-to-end mode:
#
#   HIR      failed modules are already dropped from ctx.hir_modules (poisoned);
#            every module that imports one of them, transitively, is excluded
#            too, and MIR lowering runs over the rest.
#   MIR      a module whose lowering failed is recorded here and never stored in
#            ctx.mir_modules; the post-MIR pass chain and codegen run over the
#            modules that lowered, writing their objects to the native cache.
#   codegen  per-module failures are already collected by compile_to_native.
#   link     NEVER runs when anything failed: no partial binary, no fake
#            success. A manifest `<output>.go-to-end.sdn` names every failed
#            module per stage with its errors and the build exits non-zero.
#
# A later run (or a hand compile of the failed modules) reuses every good
# object from the cache. The env knob is excluded from the native cache
# identity by name (cache/native_build_environment_identity.spl, next to the
# staged-batch and shard knobs), so a normal run hits the objects a
# go-to-end run wrote. Until 2026-10-24 it was NOT excluded and that reuse
# never happened.
#
# Staged native codegen (SIMPLE_NATIVE_STAGED_CODEGEN_BATCH, driver_aot_pipeline
# native_staged_codegen_flush_v1): a failed module costs only itself (MIR,
# borrow) or its batch (MIR verify, which names no module); later batches
# still lower and emit.
#
# Off (the default), nothing here is consulted and behaviour is unchanged.
use std.nogc_sync_mut.io_runtime.{env_get_nullable, file_write_exact}
use std.nogc_sync_mut.io.process_ops.{eprint}

pub const GO_TO_END_ENV_V1: text = "SIMPLE_NATIVE_GO_TO_END"
pub const GO_TO_END_SCHEMA_V1: text = "simple-native-go-to-end-v1"
pub const GO_TO_END_UNATTRIBUTED_V1: text = "(unattributed)"

pub fn go_to_end_enabled_v1() -> bool:
    (env_get_nullable(GO_TO_END_ENV_V1) ?? "") == "1"

# The CLI hands the driver a private temporary output
# (`<output>.simple-native-build-<pid>-<micros>.tmp`, see
# app/io/_CliCompile/build_intermediate_policy.spl) and renames it only on
# success; the manifest belongs next to the user's output, so strip that suffix.
# rfind is compared with `> 0` (not matched as an Option): see the native
# rfind note in driver_aot_pipeline.spl `_driver_default_stem`.
pub fn go_to_end_user_output_v1(output: text) -> text:
    val marker = output.rfind(".simple-native-build-")
    if marker > 0 and output.ends_with(".tmp"): output.substring(0, marker) else: output

pub fn go_to_end_manifest_path_v1(output: text) -> text:
    go_to_end_user_output_v1(output) + ".go-to-end.sdn"

# Parallel text arrays rather than [struct] / Dict<text,[text]>: both shapes
# have open native-codegen pitfalls (doc/07_guide/language/dict_native_pitfalls.md).
pub class GoToEndLedgerV1:
    stages: [text]
    modules: [text]
    messages: [text]
    # Modules excluded from later stages (failed, or depending on a failure).
    excluded: [text]
    # True once the MIR lowering loop attempted every scheduled module (no
    # early whole-build stop); only then may go-to-end continue past MIR.
    mir_scan_complete: bool

impl GoToEndLedgerV1:
    static fn empty() -> GoToEndLedgerV1:
        GoToEndLedgerV1(stages: [], modules: [], messages: [], excluded: [],
            mir_scan_complete: false)

    me record(stage: text, module_name: text, message: text):
        # Streamed as recorded: the manifest is written only at finish, so an
        # OOM/kill before then used to lose every failure name.
        eprint("[go-to-end] failed stage={stage} module={module_name}: {message}")
        self.stages = self.stages.push(stage)
        self.modules = self.modules.push(module_name)
        self.messages = self.messages.push(message)

    me exclude(module_name: text):
        if not self.is_excluded(module_name):
            self.excluded = self.excluded.push(module_name)

    fn is_excluded(module_name: text) -> bool:
        var index = 0
        while index < self.excluded.len():
            if self.excluded[index] == module_name:
                return true
            index = index + 1
        false

    fn has_message(message: text) -> bool:
        var index = 0
        while index < self.messages.len():
            if self.messages[index] == message:
                return true
            index = index + 1
        false

    fn len() -> i64:
        self.modules.len()

    fn count_stage(stage: text) -> i64:
        var count = 0
        var index = 0
        while index < self.stages.len():
            if self.stages[index] == stage:
                count = count + 1
            index = index + 1
        count

    # Distinct module names recorded for `stage`, first-seen order.
    fn stage_modules(stage: text) -> [text]:
        var names: [text] = []
        var index = 0
        while index < self.stages.len():
            if self.stages[index] == stage:
                val name = self.modules[index]
                var seen = false
                for prior in names:
                    if prior == name:
                        seen = true
                if not seen:
                    names = names.push(name)
            index = index + 1
        names

# True when `import_path` (as written in a `use`) names module `module_name`.
# Module names are physical (`lib.common.text`, `compiler.hir.hir_types`);
# imports may be logical (`std.text`). Over-matching only excludes more
# modules, which is safe: an excluded module is reported, never linked.
pub fn go_to_end_import_names_module_v1(import_path: text, module_name: text) -> bool:
    if import_path == "" or module_name == "":
        return false
    if import_path == module_name:
        return true
    val logical = if import_path.starts_with("std."): import_path.substring(4) else: import_path
    if logical == module_name:
        return true
    module_name.ends_with("." + logical)

# Resolve a raw parser import path against the importer's module path. `.x` is
# a sibling of the importer, `..x` one package level higher (each leading dot
# drops one trailing segment, as module_relative_name_from_path does for files).
pub fn go_to_end_resolve_import_v1(importer: text, import_path: text) -> text:
    if not import_path.starts_with("."):
        return import_path
    var dots = 0
    while dots < import_path.len() and import_path.substring(dots, dots + 1) == ".":
        dots = dots + 1
    val tail = import_path.substring(dots)
    val parts = importer.split(".")
    if tail == "" or parts.len() <= dots:
        return ""
    var kept: [text] = []
    var index = 0
    while index < parts.len() - dots:
        kept = kept.push(parts[index])
        index = index + 1
    kept = kept.push(tail)
    kept.join(".")

# Modules (from `candidates`) that import a failed module, transitively.
# `edge_from[i]` imports `edge_to[i]`. Failed modules themselves are not
# returned. Fixed point; quadratic but over the import graph only.
pub fn go_to_end_blocked_modules_v1(candidates: [text], edge_from: [text],
        edge_to: [text], failed: [text]) -> [text]:
    var bad: [text] = failed
    var blocked: [text] = []
    var changed = true
    while changed:
        changed = false
        for name in candidates:
            var already = false
            for b in bad:
                if b == name:
                    already = true
            if not already:
                var hit = false
                var edge = 0
                while edge < edge_from.len() and not hit:
                    if edge_from[edge] == name:
                        val target = go_to_end_resolve_import_v1(name, edge_to[edge])
                        for b in bad:
                            if go_to_end_import_names_module_v1(target, b):
                                hit = true
                    edge = edge + 1
                if hit:
                    bad = bad.push(name)
                    blocked = blocked.push(name)
                    changed = true
    blocked

pub fn go_to_end_sdn_quote_v1(value: text) -> text:
    var out = ""
    var index = 0
    while index < value.len():
        val ch = value.substring(index, index + 1)
        if ch == "\\":
            out = out + "\\\\"
        elif ch == "\"":
            out = out + "\\\""
        elif ch == "\n":
            out = out + "\\n"
        elif ch == "\r":
            out = out + "\\r"
        elif ch == "\t":
            out = out + "\\t"
        else:
            out = out + ch
        index = index + 1
    "\"" + out + "\""

fn _go_to_end_name_list_v1(names: [text]) -> text:
    var out = "["
    var index = 0
    while index < names.len():
        if index > 0:
            out = out + ", "
        out = out + go_to_end_sdn_quote_v1(names[index])
        index = index + 1
    out + "]"

# The manifest text. Pure: same inputs, byte-identical output.
pub fn go_to_end_manifest_text_v1(output: text, ledger: GoToEndLedgerV1,
        object_count: i64, built_modules: [text]) -> text:
    var out = "go_to_end:\n"
    out = out + "  schema: {go_to_end_sdn_quote_v1(GO_TO_END_SCHEMA_V1)}\n"
    val user_output = go_to_end_user_output_v1(output)
    out = out + "  output: {go_to_end_sdn_quote_v1(user_output)}\n"
    out = out + "  linked: false\n"
    out = out + "  object_count: {object_count}\n"
    out = out + "  built_count: {built_modules.len()}\n"
    out = out + "  failed_count: {ledger.len()}\n"
    out = out + "  stages:\n"
    for stage in ["build", "hir", "hir_dependency", "mono", "mir", "borrow", "codegen"]:
        out = out + "    {stage}: {_go_to_end_name_list_v1(ledger.stage_modules(stage))}\n"
    out = out + "  built: {_go_to_end_name_list_v1(built_modules)}\n"
    out = out + "\nfailures |stage, module, message|\n"
    var index = 0
    while index < ledger.len():
        out = out + "  {ledger.stages[index]}, {go_to_end_sdn_quote_v1(ledger.modules[index])}, {go_to_end_sdn_quote_v1(ledger.messages[index])}\n"
        index = index + 1
    out

# Write the manifest and return the non-zero build verdict text. The link is
# the caller's to skip; this never reports success.
pub fn go_to_end_write_manifest_v1(output: text, ledger: GoToEndLedgerV1,
        object_count: i64, built_modules: [text]) -> text:
    val path = go_to_end_manifest_path_v1(output)
    val text_out = go_to_end_manifest_text_v1(output, ledger, object_count, built_modules)
    val wrote = file_write_exact(path, text_out)
    val where_text = if wrote: path else: "{path} (WRITE FAILED)"
    val n_hir = ledger.count_stage("hir")
    val n_dep = ledger.count_stage("hir_dependency")
    val n_mir = ledger.count_stage("mir")
    val n_mono = ledger.count_stage("mono")
    val n_borrow = ledger.count_stage("borrow")
    val n_codegen = ledger.count_stage("codegen")
    val n_total = ledger.len()
    "go-to-end: {n_total} failure(s) (hir={n_hir} hir_dependency={n_dep} mono={n_mono} mir={n_mir} borrow={n_borrow} codegen={n_codegen}); {object_count} object(s) in cache; link skipped; manifest {where_text}"
