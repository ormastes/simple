# Post-success link observations share the existing .link-receipt location.
# This version never admits cache reuse, startup completeness, or guest tests.
use compiler.backend.simpleos_native_symbols.{simpleos_user_link_arch}
use compiler.common.cache_contract.physical_tld_v1.{three_payload_contract_digest_valid_v1}
use std.common.crypto.sha256.{sha256_text}

pub fn native_link_observation_render_v3(target: text, engine_id: text, output_digest: text) -> text?:
    val arch = simpleos_user_link_arch(target)
    if arch == "": return None
    if engine_id != "internal:simpleos" and engine_id != "ld.lld": return None
    if not three_payload_contract_digest_valid_v1(output_digest): return None
    val body = "simple-link-receipt: 3\n" +
        "observation: completed-native-link\ncompleted: true\nfresh-only: true\ncache-authority: none\n" +
        "target: simpleos-" + arch + "\narch: " + arch + "\nengine-id: " + engine_id +
        "\noutput-sha256: " + output_digest + "\n"
    Some(body + "receipt-sha256: " + sha256_text(body) + "\n")
