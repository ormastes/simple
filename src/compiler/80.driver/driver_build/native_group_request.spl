# Compiler-owned, immutable grouped-native request reader. A group request is
# decoded once at each pipeline boundary; it never carries mutable compiler
# state across the process boundary.
use std.common.build_manager.grouped_native_contract.{NativeGroupManifestV1,
    native_group_manifest_decode_v1, native_group_manifest_validate_v1,
    native_group_absolute_path_valid_v1}
use std.nogc_sync_mut.io.file_ops.{file_read_regular_no_follow_bounded}
use std.nogc_sync_mut.io_runtime.{env_get_nullable}

pub fn native_group_request_path_v1() -> text:
    env_get_nullable("SIMPLE_NATIVE_GROUP_MANIFEST") ?? ""

pub fn native_group_request_v1() -> Result<NativeGroupManifestV1, text>:
    val path = native_group_request_path_v1()
    if path == "": return Err("group manifest path absent")
    # @workaround bug=stage2_try_unwrap_text_typed_as_i64_2026-11-02 reason=frozen stage2 ef0681fc0e1 decodes a `?`-unwrapped Result<text,_> payload as an i64 local (handle rendered as digits / compared as int); bind through a typed match
    val payload: text = match file_read_regular_no_follow_bounded(path, 16777216):
        case Ok(v): v
        case Err(e): return Err(e)
    val manifest = native_group_manifest_decode_v1(payload)?
    val invalid = native_group_manifest_validate_v1(manifest)
    if invalid != "": return Err(invalid)
    Ok(manifest)

pub fn native_group_source_paths_v1() -> Result<[text], text>:
    val manifest = native_group_request_v1()?
    val root = env_get_nullable("SIMPLE_NATIVE_GROUP_SOURCE_ROOT") ?? ""
    if not native_group_absolute_path_valid_v1(root):
        return Err("group source root is not an admitted absolute path")
    var paths: [text] = []
    for member in manifest.members:
        paths = paths.push(root.replace("\\", "/") + "/" +
            member.source_path)
    Ok(paths)
