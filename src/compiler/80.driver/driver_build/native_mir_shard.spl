# Process-level MIR + codegen sharding (SIMPLE_MIR_SHARDING=1).
#
# In-process staging cannot bound RSS: an evicted, promoted MirModule is never
# freed (no collector; driver_types.spl evict_mir_module). A process exit is
# the one reclaim path that always works, so the native-build coordinator
# (src/app/cli/native_build_main.spl run_mir_shards) runs K worker processes
# after HIR aggregate PASS. Each worker runs the ordinary pipeline through
# mono (parse/HIR are cache hits), lowers ONLY the modules it claims, runs the
# per-module post-lowering chain, emits their objects into the shared native
# object cache, writes one terminal record per claimed module, and exits.
# The final worker (SIMPLE_MIR_SHARD_LINK=<ledger>) lowers nothing: it admits
# the ledger's PASS objects and runs the ordinary verdict + link.
#
# The ledger is the HIR shard ledger (driver_hir_recovery.spl) in a separate
# queue directory: same claim / terminal / seal / done / inventory records,
# keyed by canonical MIR module name, with the native source fingerprint as
# the claim key and inventory identity. One sidecar per PASS module carries
# what the link needs: the object path (empty for an objectless facade) and
# the function/static counts for the lane receipt.
#
# A worker claims at most ceil(scheduled / count) modules, so a worker's MIR
# is bounded by its share however many workers run concurrently. Workers walk
# the schedule largest-first (native_mir_shard_lpt_order_v1).
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.io_runtime.{env_get_nullable}
use std.io_runtime.{file_exists, file_read, file_write, file_rename, getpid}
use compiler.driver.driver_hir_recovery.{hir_shard_recovery_claim, hir_shard_recovery_terminal}

pub const NATIVE_MIR_SHARD_ENV_V1: text = "SIMPLE_MIR_SHARD"
pub const NATIVE_MIR_SHARD_QUEUE_ENV_V1: text = "SIMPLE_MIR_SHARD_QUEUE"
pub const NATIVE_MIR_SHARD_OWNER_ENV_V1: text = "SIMPLE_MIR_SHARD_OWNER"
pub const NATIVE_MIR_SHARD_LINK_ENV_V1: text = "SIMPLE_MIR_SHARD_LINK"

pub fn native_mir_shard_spec_v1() -> text:
    env_get_nullable(NATIVE_MIR_SHARD_ENV_V1) ?? ""

pub fn native_mir_shard_queue_v1() -> text:
    env_get_nullable(NATIVE_MIR_SHARD_QUEUE_ENV_V1) ?? ""

pub fn native_mir_shard_owner_v1() -> text:
    env_get_nullable(NATIVE_MIR_SHARD_OWNER_ENV_V1) ?? native_mir_shard_spec_v1()

pub fn native_mir_shard_link_ledger_v1() -> text:
    env_get_nullable(NATIVE_MIR_SHARD_LINK_ENV_V1) ?? ""

# Shard count of an "<index>/<count>" spec; 0 for a malformed spec.
pub fn native_mir_shard_count_of_v1(spec: text) -> i64:
    val slash = spec.index_of("/")
    if slash <= 0:
        return 0
    val index = spec.substring(0, slash).to_i64() ?? -1
    val count = spec.substring(slash + 1, spec.len()).to_i64() ?? 0
    if count <= 0 or index < 0 or index >= count:
        return 0
    count

# Most modules one worker may claim. A malformed spec gets no cap of its own
# (the whole schedule) rather than silently owning nothing.
pub fn native_mir_shard_claim_cap_v1(spec: text, scheduled: i64) -> i64:
    val count = native_mir_shard_count_of_v1(spec)
    if count <= 0:
        return scheduled
    (scheduled + count - 1) / count

# Longest-processing-time-first claim order (Rust codegen-unit scheduling):
# a worker claims, then lowers, the biggest unclaimed module first, so the
# slowest modules start first instead of finishing last. `weights` is a cheap
# size proxy index-aligned with `names` (the caller passes source byte
# length). Ties break by canonical module name, then schedule position, so
# every worker walks the identical order and claims never depend on which
# worker computed it. Returns schedule positions; a length mismatch returns
# the identity order.
fn native_mir_shard_lpt_before_v1(names: [text], weights: [i64], a: i64, b: i64) -> bool:
    if weights[a] != weights[b]:
        return weights[a] > weights[b]
    if names[a] != names[b]:
        return names[a] < names[b]
    a < b

pub fn native_mir_shard_lpt_order_v1(names: [text], weights: [i64]) -> [i64]:
    var order: [i64] = []
    var pos = 0
    while pos < names.len():
        order = order.push(pos)
        pos = pos + 1
    if names.len() != weights.len():
        return order
    # Bottom-up merge sort: stable, O(n log n) over a whole-program schedule.
    var width = 1
    while width < order.len():
        var merged: [i64] = []
        var lo = 0
        while lo < order.len():
            val mid = if lo + width < order.len(): lo + width else: order.len()
            val hi = if lo + 2 * width < order.len(): lo + 2 * width else: order.len()
            var i = lo
            var j = mid
            while i < mid or j < hi:
                if j >= hi or (i < mid and native_mir_shard_lpt_before_v1(names, weights, order[i], order[j])):
                    merged = merged.push(order[i])
                    i = i + 1
                else:
                    merged = merged.push(order[j])
                    j = j + 1
            lo = hi
        order = merged
        width = width * 2
    order

# Coordinator verdict after the MIR shard pass:
#   "link"     -- aggregate PASS; the final worker links from the ledger.
#   "fallback" -- ONLY when the pass failed (code != 0) with no module
#                 verdict (failed_modules == 0), no module ever claimed
#                 (total_claims == 0), every worker reaped, and every
#                 expected owner published completion plus the typed
#                 unsupported-lane fallback receipt. The final worker then
#                 lowers MIR in process (unsharded); it can never admit a
#                 partial ledger.
#   "fail"     -- everything else, and the build stops: a module failure, a
#                 crash or timeout after claiming (a claim with no terminal),
#                 an unreaped live worker, or an unreadable ledger (-1).
pub fn native_mir_shard_outcome_v1(aggregate_code: i64, failed_modules: i64,
        total_claims: i64, all_stopped: bool, protocol_complete: bool,
        recoverable_no_claim: bool) -> text:
    if aggregate_code == 0:
        return "link"
    if failed_modules == 0 and total_claims == 0 and all_stopped and
            protocol_complete and recoverable_no_claim:
        return "fallback"
    "fail"

# Invocation/owner-bound witness for the one supported zero-claim recovery:
# a completed worker explicitly refused MIR sharding because its output lane
# is unsupported. Generic worker exits and HIR failures never write this file.
fn native_mir_shard_fallback_record_v1(queue: text, owner: text) -> text:
    "{queue}/{sha256_text(owner)}.recoverable-fallback"

pub fn native_mir_shard_publish_unsupported_fallback_v1(queue: text, owner: text) -> bool:
    if queue == "" or owner == "": return false
    val path = native_mir_shard_fallback_record_v1(queue, owner)
    val temporary = "{path}.{getpid()}.tmp"
    val record = "simple-mir-shard-recoverable-fallback-v1\n{owner}\nUNSUPPORTED_LANE\n"
    if not file_write(temporary, record): return false
    if file_rename(temporary, path): true else:
        file_exists(path) and file_read(path) == record

pub fn native_mir_shard_has_unsupported_fallback_v1(queue: text, owner: text) -> bool:
    if queue == "" or owner == "": return false
    file_read(native_mir_shard_fallback_record_v1(queue, owner)) ==
        "simple-mir-shard-recoverable-fallback-v1\n{owner}\nUNSUPPORTED_LANE\n"

fn native_mir_shard_record_base_v1(queue: text, module_name: text) -> text:
    "{queue}/{sha256_text(module_name)}"

# 1 = claimed by this worker, 0 = owned by another worker, -1 = ledger refused.
pub fn native_mir_shard_claim_v1(queue: text, module_name: text, key: text) -> i64:
    hir_shard_recovery_claim(queue, native_mir_shard_owner_v1(), module_name, key)

# Publish one claimed module's PASS: sidecar first, terminal last, so a PASS
# terminal always has its link inputs.
pub fn native_mir_shard_publish_pass_v1(queue: text, module_name: text,
        object_path: text, functions: i64, statics: i64) -> bool:
    if module_name == "" or object_path.contains("\n"):
        return false
    val sidecar = native_mir_shard_record_base_v1(queue, module_name) + ".object"
    val temporary = "{sidecar}.{getpid()}.tmp"
    if not file_write(temporary, "{object_path}\n{functions}\n{statics}\n") or
            not file_rename(temporary, sidecar):
        return false
    hir_shard_recovery_terminal(queue, native_mir_shard_owner_v1(), module_name,
        "PASS", object_path != "")

pub class NativeMirShardLinkInputsV1:
    modules: [text]
    # Index-aligned: the module that emitted each object.
    object_modules: [text]
    object_files: [text]
    functions: i64
    statics: i64
    objectless: i64

# The final worker's admission of the sealed ledger. Every inventory row must
# be a PASS terminal for this exact source fingerprint with a readable
# sidecar, and every recorded object must exist. Anything else is an error:
# a partial ledger is never linked.
pub fn native_mir_shard_link_inputs_v1(queue: text, identity: text) -> Result<NativeMirShardLinkInputsV1, text>:
    if queue == "" or identity == "":
        return Err("MIR shard ledger or source identity missing")
    if file_exists("{queue}/BLOCKED"):
        return Err("MIR shard ledger is BLOCKED: {file_read("{queue}/BLOCKED")}")
    val inventory = file_read("{queue}/inventory").split("\n")
    if inventory.len() < 2 or inventory[0] != identity:
        return Err("MIR shard ledger inventory does not match this build's sources")
    var inputs = NativeMirShardLinkInputsV1(modules: [], object_modules: [], object_files: [],
        functions: 0, statics: 0, objectless: 0)
    var index = 1
    while index < inventory.len():
        val name = inventory[index]
        index = index + 1
        if name == "":
            return Err("MIR shard ledger inventory has an empty row")
        val base = native_mir_shard_record_base_v1(queue, name)
        val terminal = file_read("{base}.terminal").split("\n")
        if terminal.len() != 6 or terminal[0] != "PASS" or terminal[2] != name or
                terminal[3] != identity:
            return Err("MIR shard module did not PASS: {name}")
        val sidecar = file_read("{base}.object").split("\n")
        if sidecar.len() != 4 or sidecar[3] != "":
            return Err("MIR shard module link record unreadable: {name}")
        val object_path = sidecar[0]
        val functions = sidecar[1].to_i64() ?? -1
        val statics = sidecar[2].to_i64() ?? -1
        if functions < 0 or statics < 0:
            return Err("MIR shard module link record malformed: {name}")
        if object_path == "":
            if terminal[4] != "UNCACHED":
                return Err("MIR shard objectless module record mismatch: {name}")
            inputs.objectless = inputs.objectless + 1
        else:
            if terminal[4] != "CACHE_STORED" or not file_exists(object_path):
                return Err("MIR shard module object missing: {name} ({object_path})")
            inputs.object_files = inputs.object_files.push(object_path)
            inputs.object_modules = inputs.object_modules.push(name)
        inputs.modules = inputs.modules.push(name)
        inputs.functions = inputs.functions + functions
        inputs.statics = inputs.statics + statics
    Ok(inputs)
