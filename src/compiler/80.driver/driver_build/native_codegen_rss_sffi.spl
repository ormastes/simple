# SFFI boundary for current process RSS (KiB) used by native_codegen_pool_v1.spl.
extern fn rt_process_rss_kib() -> i64

# reason: SFFI boundary returning current process resident set size in KiB
@allow(primitive_api)
pub fn native_codegen_self_rss_kib_sffi_v1() -> i64:
    var rss: i64 = 0
    unsafe(capabilities: [ffi]):
        rss = rt_process_rss_kib()
    if rss > 0: rss else: 0
