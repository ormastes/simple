# Library-unit source digest (Library Units remainder, plan
# doc/03_plan/release/1.0.0/robust_boundaries_library_units_sffi_backends_plan_2026-11-15.md).
#
# Pure: the caller supplies the scanned (relative path, content hash) list.
# Paths are normalized to '/' separators, sorted canonically, deduplicated,
# length-framed (so bytes cannot shift between path and hash) and hashed once.

use std.common.crypto.sha256.{sha256_text}
use compiler.common.cache.canonical_identity.{canonical_identity_sort_texts}
use compiler.driver.driver_build.incremental.{cache_key_frame}
use compiler.driver.driver_build.source_inventory_v1.{SourceInventoryFileV1}

val LIBRARY_UNIT_DIGEST_DOMAIN_V1 = "simple/library-unit-source-digest/v1"

pub fn library_unit_source_digest_v1(files: [SourceInventoryFileV1]) -> text:
    var entries: [text] = []
    for file in files:
        val path = file.path.replace("\\", "/")
        val entry = cache_key_frame(path) + cache_key_frame(file.digest)
        var dup = false
        for e in entries:
            if e == entry:
                dup = true
        if not dup:
            entries.push(entry)
    var serial = "{LIBRARY_UNIT_DIGEST_DOMAIN_V1};files="
    for entry in canonical_identity_sort_texts(entries):
        serial = serial + entry
    sha256_text(serial)
