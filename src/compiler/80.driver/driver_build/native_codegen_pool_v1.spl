# Process-parallel native codegen pool (native-build step 5).
#
# Plan: doc/03_plan/compiler/native_codegen/step5_real_parallelism_plan_2026-09-04.md (P2)
# Bug:  doc/08_tracking/bug/native_build_step5_serial_threads_ignored_2026-09-04.md
#
# The native runtime has no GC and in-process "threads" run inline under the
# interpreter, so the parallelism here is PROCESSES. The parent translates each
# uncached module's MIR to an LLVM IR file serially (MIR has no decoder, so IR
# text is the wire format) and N llc child processes turn those files into
# objects concurrently. Each child exits when its object is written, returning
# its memory to the OS. Translation and llc are pipelined: the parent reaps and
# spawns children between translations, so the first object appears as soon as
# the first module's llc finishes -- never later than the serial lane.
#
# Determinism: the IR comes from the serial lane's own prelude in the same
# module order and llc runs the serial lane's own argv
# (backend_helpers.llvm_module_ir_to_path_v1 / llvm_module_llc_argv_v1), so a
# pooled object is byte-identical to the serial object. Outcomes are recorded
# per input index; completion order never reaches the caller.
#
# Ownership (P0 race rules):
#   * claim:   every job is claimed in the shared ledger
#              (driver_hir_recovery.hir_shard_recovery_claim: lock + exclusive
#              claim record) by exactly one worker slot BEFORE its child is
#              spawned. A claim that is already held is a hard refusal: the job
#              fails closed (serial fallback), it is never run twice.
#   * publish: the terminal record and the SDN receipt are published by
#              temp-file + rename (file_atomic_write), never a torn write.
#   * failure: a job that fails in the pool is not an error; the caller
#              compiles that module through the serial lane, which produces
#              the full diagnostic.
use std.common.crypto.sha256.{sha256_text}
use std.io_runtime.{file_exists, file_read, file_size_raw, file_delete}
use std.nogc_sync_mut.io_runtime.{env_get_nullable, host_os}
use compiler.backend.llvm_diagnostic_admission.{llvm_llc_error_diagnostic}
use std.nogc_sync_mut.io.file_ops.{file_atomic_write}
use compiler.driver.driver_hir_recovery.{hir_shard_recovery_claim, hir_shard_recovery_terminal}

extern fn rt_process_spawn_async_value(cmd: text, args: [text]) -> i64
extern fn rt_process_wait(pid: i64, timeout_ms: i64) -> i64
extern fn rt_process_kill(pid: i64) -> bool
extern fn rt_thread_sleep(millis: i64)
extern fn rt_time_now_monotonic_ms() -> i64
extern fn rt_host_memory_headroom_bytes_v1() -> i64

# "0" disables the pool (serial lane, concurrency=1).
pub const NATIVE_CODEGEN_POOL_ENV_V1: text = "SIMPLE_NATIVE_CODEGEN_POOL"
# Per-worker memory estimate override (KiB).
pub const NATIVE_CODEGEN_WORKER_KIB_ENV_V1: text = "SIMPLE_NATIVE_CODEGEN_WORKER_KIB"
# Default per-llc-child estimate: 2 GiB. The 2-10 GB per-module peaks measured
# on this host are the in-process translation, which stays in the parent; an
# llc child holds one module's IR and machine code only.
pub const NATIVE_CODEGEN_WORKER_KIB_DEFAULT_V1: i64 = 2097152
# RAM/commit the pool always leaves free (24 GiB), same floor as the shard pool.
pub const NATIVE_CODEGEN_COMMIT_FLOOR_KIB_V1: i64 = 25165824
# With neither a declared budget nor a measurable headroom, never admit-all.
pub const NATIVE_CODEGEN_UNKNOWN_MEMORY_CAP_V1: i64 = 4
# Per-job wall clock cap (ms); a child past it is killed and the module
# falls back to the serial lane. SIMPLE_NATIVE_CODEGEN_JOB_TIMEOUT_MS overrides.
pub const NATIVE_CODEGEN_JOB_TIMEOUT_ENV_V1: text = "SIMPLE_NATIVE_CODEGEN_JOB_TIMEOUT_MS"
pub const NATIVE_CODEGEN_JOB_TIMEOUT_MS_DEFAULT_V1: i64 = 1800000

pub const NATIVE_CODEGEN_JOB_QUEUED_V1: i64 = 0
pub const NATIVE_CODEGEN_JOB_RUNNING_V1: i64 = 1
pub const NATIVE_CODEGEN_JOB_PASS_V1: i64 = 2
pub const NATIVE_CODEGEN_JOB_FAILED_V1: i64 = 3
pub const NATIVE_CODEGEN_JOB_SKIPPED_V1: i64 = 4

# Worker count from cores, the declared tree budget, and live headroom minus
# the commit floor. Every known bound can only lower N; the result is >= 1
# whenever there is a job (1 = serial).
pub fn native_codegen_pool_workers_v1(host_cpus: i64, requested: i64, jobs: i64,
        budget_kib: i64, headroom_kib: i64, estimate_kib: i64) -> i64:
    if jobs <= 0:
        return 0
    var n = if requested > 0: requested else: host_cpus
    if n < 1:
        n = 1
    if n > jobs:
        n = jobs
    val est = if estimate_kib > 0: estimate_kib else: NATIVE_CODEGEN_WORKER_KIB_DEFAULT_V1
    var known = false
    if budget_kib > 0:
        known = true
        val by_budget = budget_kib / est
        if by_budget < n:
            n = by_budget
    if headroom_kib > 0:
        known = true
        val spare = headroom_kib - NATIVE_CODEGEN_COMMIT_FLOOR_KIB_V1
        val by_commit = if spare > 0: spare / est else: 0
        if by_commit < n:
            n = by_commit
    if not known and n > NATIVE_CODEGEN_UNKNOWN_MEMORY_CAP_V1:
        n = NATIVE_CODEGEN_UNKNOWN_MEMORY_CAP_V1
    if n < 1: 1 else: n

pub fn native_codegen_kib_field_v1(raw: text) -> i64:
    val parsed = raw.trim().to_i64() ?? 0
    if parsed > 0: parsed else: 0

# MemAvailable from a /proc/meminfo body (KiB), 0 when absent.
pub fn native_codegen_meminfo_available_kib_v1(meminfo: text) -> i64:
    for line in meminfo.split("\n"):
        if line.starts_with("MemAvailable:"):
            val rest = line.substring(13, line.len()).trim()
            val space = rest.index_of(" ")
            val digits = if space > 0: rest.substring(0, space) else: rest
            return native_codegen_kib_field_v1(digits)
    0

# Live RAM/commit headroom in KiB; 0 = unknown. Windows answers through the
# runtime (min of free physical and free commit); elsewhere /proc/meminfo.
pub fn native_codegen_headroom_kib_v1() -> i64:
    var bytes: i64 = 0
    unsafe(capabilities: [ffi]):
        bytes = rt_host_memory_headroom_bytes_v1()
    if bytes > 0:
        return bytes / 1024
    if file_exists("/proc/meminfo"):
        return native_codegen_meminfo_available_kib_v1(file_read("/proc/meminfo"))
    0

pub fn native_codegen_job_ir_path_v1(stage_root: text, index: i64) -> text:
    "{stage_root}/job-{index}.ll"

pub fn native_codegen_job_object_path_v1(stage_root: text, index: i64) -> text:
    "{stage_root}/job-{index}.o"

pub fn native_codegen_job_log_path_v1(stage_root: text, index: i64) -> text:
    "{stage_root}/job-{index}.log"

# The serial lane runs llc as one shell command line ("{llc} {argv joined} 2>&1",
# backend_shell_tuple). The pool runs the same line through the same shell,
# with its output redirected to the job log for diagnostic admission.
pub fn native_codegen_shell_cmd_v1() -> text:
    if host_os() == "windows": "cmd.exe" else: "/bin/sh"

pub fn native_codegen_command_line_v1(tool: text, argv: [text], log_path: text) -> text:
    "{tool} " + argv.join(" ") + " > {log_path} 2>&1"

pub fn native_codegen_shell_args_v1(tool: text, argv: [text], log_path: text) -> [text]:
    val line = native_codegen_command_line_v1(tool, argv, log_path)
    if host_os() == "windows": ["/c", line] else: ["-c", line]

pub fn native_codegen_receipt_path_v1(ledger: text, module_name: text) -> text:
    "{ledger}/{sha256_text(module_name)}.codegen-receipt.sdn"

fn native_codegen_sdn_escape_v1(value: text) -> text:
    value.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n")

pub fn native_codegen_receipt_encode_v1(module_name: text, worker: i64, status: text,
        exit_code: i64, object_bytes: i64, start_ms: i64, done_ms: i64) -> text:
    "native_codegen_receipt_v1:\n" +
        "  module: \"{native_codegen_sdn_escape_v1(module_name)}\"\n" +
        "  worker: {worker}\n" +
        "  status: \"{status}\"\n" +
        "  exit_code: {exit_code}\n" +
        "  object_bytes: {object_bytes}\n" +
        "  start_ms: {start_ms}\n" +
        "  done_ms: {done_ms}\n"

# Atomic receipt publication (temp + rename). False when the write or its
# read-back verification fails.
pub fn native_codegen_receipt_publish_v1(ledger: text, module_name: text, body: text) -> bool:
    val path = native_codegen_receipt_path_v1(ledger, module_name)
    if not file_atomic_write(path, body):
        return false
    file_read(path) == body

pub fn native_codegen_worker_owner_v1(slot: i64) -> text:
    "codegen-w{slot}"

pub struct NativeCodegenPoolResultV1:
    # Per input index: staged object path on PASS, "" otherwise.
    objects: [text]
    # Per input index: NATIVE_CODEGEN_JOB_* terminal state.
    states: [i64]
    workers: i64
    peak_live: i64
    passed: i64
    failed: i64
    skipped: i64
    first_object_ms: i64
    wall_ms: i64

fn native_codegen_now_ms_v1() -> i64:
    var now: i64 = 0
    unsafe(capabilities: [ffi]):
        now = rt_time_now_monotonic_ms()
    now

# Run one job per `names` entry (ledger key = module name) on at most
# `workers` concurrent `tool` children.
#
# `emit_fn(index, ir_path, obj_path)` runs IN THIS PROCESS, in index order, and
# returns the child argv for that job, or [] to skip it (translation refused or
# failed; the caller compiles it serially). Between emissions the pool reaps
# finished children and starts queued ones, so translation overlaps codegen.
pub fn native_codegen_pool_run_v1(tool: text, names: [text], workers: i64,
        stage_root: text, ledger: text,
        emit_fn: fn(i64, text, text) -> [text]) -> NativeCodegenPoolResultV1:
    val started = native_codegen_now_ms_v1()
    val count = names.len()
    var argvs: [[text]] = []
    var objects: [text] = []
    var states: [i64] = []
    var pids: [i64] = []
    var slots: [i64] = []
    var starts: [i64] = []
    val empty_argv: [text] = []
    var index: i64 = 0
    while index < count:
        argvs.push(empty_argv)
        objects.push("")
        states.push(NATIVE_CODEGEN_JOB_SKIPPED_V1)
        pids.push(0)
        slots.push(-1)
        starts.push(0)
        index = index + 1
    val max_workers = if workers > 0: workers else: 1
    var slot_busy: [bool] = []
    var slot_index: i64 = 0
    while slot_index < max_workers:
        slot_busy.push(false)
        slot_index = slot_index + 1
    var live: i64 = 0
    var peak_live: i64 = 0
    var first_object_ms: i64 = -1
    var next_spawn: i64 = 0
    var emitted: i64 = 0
    var passed: i64 = 0
    var failed: i64 = 0
    val shell_cmd = native_codegen_shell_cmd_v1()
    val timeout_field = native_codegen_kib_field_v1(env_get_nullable(NATIVE_CODEGEN_JOB_TIMEOUT_ENV_V1) ?? "")
    val job_timeout_ms = if timeout_field > 0: timeout_field else: NATIVE_CODEGEN_JOB_TIMEOUT_MS_DEFAULT_V1
    var poll: i64 = 0
    while emitted < count or live > 0 or next_spawn < emitted:
        # 1. Reap every finished child (non-blocking).
        var reaped_any = false
        var job: i64 = 0
        while job < emitted:
            if states[job] == NATIVE_CODEGEN_JOB_RUNNING_V1:
                val pid = pids[job]
                # ONE reaping call. rt_process_is_running reaps on POSIX
                # (waitpid WNOHANG), so a following wait would see ECHILD and
                # lose the exit status. A 1 ms wait answers -2 while running.
                var code: i64 = -2
                unsafe(capabilities: [ffi]):
                    code = rt_process_wait(pid, 1)
                var timed_out = false
                if code == -2 and native_codegen_now_ms_v1() - starts[job] > job_timeout_ms:
                    unsafe(capabilities: [ffi]):
                        val _killed = rt_process_kill(pid)
                        code = rt_process_wait(pid, 5000)
                    timed_out = true
                if code != -2 or timed_out:
                    val obj = native_codegen_job_object_path_v1(stage_root, job)
                    val log_path = native_codegen_job_log_path_v1(stage_root, job)
                    val size = if file_exists(obj): file_size_raw(obj) else: -1
                    val log_text = if file_exists(log_path): file_read(log_path) else: ""
                    # Same admission as the serial compile_ir_to_object: an
                    # llc `error:` record refuses even an exit-0 object.
                    val diagnostic = llvm_llc_error_diagnostic(code, log_text, "", tool,
                        native_codegen_job_ir_path_v1(stage_root, job))
                    val ok = not timed_out and code == 0 and size > 0 and diagnostic == ""
                    if (env_get_nullable("SIMPLE_KEEP_LLVM_IR") ?? "") != "1":
                        val _ir_dropped = file_delete(native_codegen_job_ir_path_v1(stage_root, job))
                    val slot = slots[job]
                    val owner = native_codegen_worker_owner_v1(slot)
                    val done_ms = native_codegen_now_ms_v1()
                    val terminal_ok = hir_shard_recovery_terminal(ledger, owner,
                        names[job], if ok: "PASS" else: "FAILED", false)
                    val receipt_ok = native_codegen_receipt_publish_v1(ledger,
                        names[job],
                        native_codegen_receipt_encode_v1(names[job], slot,
                            if ok: "PASS" else: "FAILED", code, size,
                            starts[job] - started, done_ms - started))
                    if ok and terminal_ok and receipt_ok:
                        states[job] = NATIVE_CODEGEN_JOB_PASS_V1
                        objects[job] = obj
                        passed = passed + 1
                        if first_object_ms < 0:
                            first_object_ms = done_ms - started
                    else:
                        states[job] = NATIVE_CODEGEN_JOB_FAILED_V1
                        failed = failed + 1
                    slot_busy[slot] = false
                    live = live - 1
                    reaped_any = true
            job = job + 1
        # 2. Fill free slots from the queue, in index order.
        while live < max_workers and next_spawn < emitted:
            if states[next_spawn] == NATIVE_CODEGEN_JOB_QUEUED_V1:
                var slot: i64 = 0
                while slot < max_workers and slot_busy[slot]:
                    slot = slot + 1
                val owner = native_codegen_worker_owner_v1(slot)
                val claim = hir_shard_recovery_claim(ledger, owner,
                    names[next_spawn], sha256_text(argvs[next_spawn].join("\n")))
                var pid: i64 = -1
                if claim == 1:
                    unsafe(capabilities: [ffi]):
                        pid = rt_process_spawn_async_value(shell_cmd,
                            native_codegen_shell_args_v1(tool, argvs[next_spawn],
                                native_codegen_job_log_path_v1(stage_root, next_spawn)))
                if pid > 0:
                    pids[next_spawn] = pid
                    slots[next_spawn] = slot
                    starts[next_spawn] = native_codegen_now_ms_v1()
                    states[next_spawn] = NATIVE_CODEGEN_JOB_RUNNING_V1
                    slot_busy[slot] = true
                    live = live + 1
                    if live > peak_live:
                        peak_live = live
                else:
                    # Claimed by someone else (P0 invariant breach) or the spawn
                    # failed: fail closed to the serial lane, never run twice.
                    if claim == 1:
                        val _sealed = hir_shard_recovery_terminal(ledger, owner,
                            names[next_spawn], "FAILED", false)
                    states[next_spawn] = NATIVE_CODEGEN_JOB_FAILED_V1
                    failed = failed + 1
            next_spawn = next_spawn + 1
        # 3. Translate the next module in process while children run.
        if emitted < count:
            val ir_path = native_codegen_job_ir_path_v1(stage_root, emitted)
            val obj_path = native_codegen_job_object_path_v1(stage_root, emitted)
            val argv = emit_fn(emitted, ir_path, obj_path)
            if argv.len() > 0:
                argvs[emitted] = argv
                states[emitted] = NATIVE_CODEGEN_JOB_QUEUED_V1
            emitted = emitted + 1
            poll = 0
        elif not reaped_any and live > 0:
            # Only children left: bounded back-off polling.
            var sleep_ms: i64 = 10
            if poll >= 50:
                sleep_ms = 100
            elif poll >= 10:
                sleep_ms = 25
            unsafe(capabilities: [ffi]):
                rt_thread_sleep(sleep_ms)
            poll = poll + 1
    var skipped: i64 = 0
    for state in states:
        if state == NATIVE_CODEGEN_JOB_SKIPPED_V1:
            skipped = skipped + 1
    NativeCodegenPoolResultV1(objects: objects, states: states, workers: max_workers,
        peak_live: peak_live, passed: passed, failed: failed, skipped: skipped,
        first_object_ms: first_object_ms,
        wall_ms: native_codegen_now_ms_v1() - started)
