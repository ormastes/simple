# Bound ownership acquired ahead of parsing, so early children cannot reserve
# the entire shared queue while their peers are still loading source metadata.
pub struct ParseFiberClaimWindowV1:
    indices: [i64]
    next_index: i64

pub fn parse_fiber_claim_window_v1(paths: [text], start: i64,
        claim: fn(text) -> bool) -> ParseFiberClaimWindowV1:
    var indices: [i64] = []
    var next_index = start
    while next_index < paths.len() and indices.len() < 16:
        val i = next_index
        next_index = next_index + 1
        if claim(paths[i]): indices.push(i)
    ParseFiberClaimWindowV1(indices: indices, next_index: next_index)

# Ring-strided window over `paths`: starts at `ring_offset` (the shard's
# pre-partitioned region) and walks `steps_done .. paths.len()` modulo `paths.len()`
# so W parse-fiber children claim disjoint windows without stampeding at index 0.
# reason: source path slice and ring offsets matching parse_fiber_claim_window_v1
@allow(primitive_api)
pub fn parse_fiber_claim_ring_window_v1(paths: [text], ring_offset: i64, steps_done: i64,
        claim: fn(text) -> bool) -> ParseFiberClaimWindowV1:
    val total = paths.len()
    var indices: [i64] = []
    var next_step = steps_done
    while next_step < total and indices.len() < 16:
        val pos = (ring_offset + next_step) % total
        next_step = next_step + 1
        if claim(paths[pos]):
            indices.push(pos)
    ParseFiberClaimWindowV1(indices: indices, next_index: next_step)
