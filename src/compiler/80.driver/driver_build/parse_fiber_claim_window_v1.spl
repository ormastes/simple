# Bound ownership acquired ahead of parsing, so early children cannot reserve
# the entire shared queue while their peers are still loading source metadata.
pub struct ParseFiberClaimWindowV1:
    indices: [i64]
    next_index: i64

pub fn parse_fiber_claim_window_v1(paths: [text], start: i64,
        claim: fn(text) -> bool) -> ParseFiberClaimWindowV1:
    var indices: [i64] = []
    var next_index = start
    while next_index < paths.len() and indices.len() < 16:
        val i = next_index
        next_index = next_index + 1
        if claim(paths[i]): indices.push(i)
    ParseFiberClaimWindowV1(indices: indices, next_index: next_index)
