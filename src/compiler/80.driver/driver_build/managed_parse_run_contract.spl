use compiler.driver.driver_build.managed_parse_group_contract.*
use compiler.driver.cache.package_scc_scheduler.{PackageCompileScheduleV1, PackageSccGroupV1, PackageSccWaveV1, package_scc_identity_v1}
use compiler.driver.action_graph.persisted_graph.{PersistedBuildGraphV1, persisted_graph_encode_v1, persisted_graph_decode_v1}
use compiler.driver.action_graph.build_action_v1.{BuildActionPoolV1}
use lib.compiler_artifact_service.profile.{ArtifactServiceProfileV1, artifact_service_profile_validate_v1}
use std.common.build_manager.grouped_execution_contract.{GroupedActionBindingV1}
use std.common.build_manager.grouped_native_contract.{native_group_absolute_path_valid_v1}
use std.common.build_manager.contracts.{builder_identifier_valid_v1, builder_digest_valid_v1, builder_text_valid_v1}
use std.common.build_manager.codec.{BuilderWireReaderV1}

struct ManagedParseRunV1:
    run_id: text
    schedule: PackageCompileScheduleV1
    graph: PersistedBuildGraphV1
    profile: ArtifactServiceProfileV1
    bindings: [GroupedActionBindingV1]
    worker_slots: [text]
    snapshots: [ManagedParseSnapshotV1]
    source_root: text
    state_root: text
    worker_program: text
    worker_digest: text
    environment: [text]
    max_attempts: i64
    keep_going: bool
    poll_ms: i64
    startup_timeout_ms: i64
    shutdown_timeout_ms: i64
    broker_program: text
    broker_digest: text
    lifetime_ms: i64

fn managed_parse_schedule_validate_v1(schedule: PackageCompileScheduleV1) -> text:
    if not schedule.valid or schedule.reason != "ok" or not builder_digest_valid_v1(schedule.variant_digest): return "invalid schedule"
    if not managed_parse_unique_ids_v1(schedule.dirty_packages) or schedule.groups.len() == 0 or schedule.groups.len() > 4096: return "invalid schedule inventory"
    var groups: [text] = []
    var packages: [text] = []
    for group in schedule.groups:
        if not managed_parse_unique_ids_v1(group.members) or group.identity != package_scc_identity_v1(group.members, schedule.variant_digest) or groups.contains(group.identity): return "invalid SCC group"
        groups = groups.push(group.identity)
        for member in group.members:
            if packages.contains(member): return "overlapping SCC groups"
            packages = packages.push(member)
    if packages.sorted() != schedule.dirty_packages.sorted(): return "dirty package membership mismatch"
    for group in schedule.groups:
        var seen: [text] = []
        for dependency in group.dependencies:
            if dependency == group.identity or not groups.contains(dependency) or seen.contains(dependency): return "invalid SCC dependency"
            seen = seen.push(dependency)
    if schedule.waves.len() == 0 or schedule.waves.len() > groups.len(): return "invalid SCC waves"
    var completed: [text] = []
    var ordinal = 0
    for wave in schedule.waves:
        if wave.ordinal != ordinal or wave.groups.len() == 0: return "invalid wave order"
        var wave_ids: [text] = []
        for item in wave.groups:
            if completed.contains(item.identity) or wave_ids.contains(item.identity): return "duplicate wave group"
            var found = false
            for group in schedule.groups:
                if group.identity == item.identity:
                    if group.members != item.members or group.dependencies != item.dependencies: return "wave group differs"
                    for dependency in group.dependencies:
                        if not completed.contains(dependency): return "wave dependency not completed"
                    found = true
            if not found: return "unknown wave group"
            wave_ids = wave_ids.push(item.identity)
        completed = completed + wave_ids
        ordinal = ordinal + 1
    if completed.len() != groups.len(): return "missing wave group"
    ""

fn managed_parse_run_validate_v1(run: ManagedParseRunV1) -> text:
    if not builder_identifier_valid_v1(run.run_id): return "invalid run identity"
    for path in [run.source_root, run.state_root, run.worker_program, run.broker_program]:
        if not native_group_absolute_path_valid_v1(path): return "invalid run absolute path"
    if run.source_root == run.state_root or run.state_root.starts_with(run.source_root + "/") or run.source_root.starts_with(run.state_root + "/"): return "overlapping source/state roots"
    if not builder_digest_valid_v1(run.worker_digest) or not builder_digest_valid_v1(run.broker_digest): return "invalid executable digest"
    if run.max_attempts < 1 or run.max_attempts > 3 or run.poll_ms < 1 or run.poll_ms > 60000: return "invalid retry/poll bound"
    if run.startup_timeout_ms < run.poll_ms or run.shutdown_timeout_ms < run.poll_ms or run.lifetime_ms < run.startup_timeout_ms or run.lifetime_ms < run.shutdown_timeout_ms or run.lifetime_ms > 604800000: return "invalid process deadlines"
    if artifact_service_profile_validate_v1(run.profile) != "ok" or not run.profile.pools.contains("parse") or run.profile.max_workers > 64 or run.profile.memory_budget_bytes > 1099511627776 or run.profile.foreground_priority > 2147483647: return "invalid parser profile"
    if run.profile.pools.len() > 4096: return "profile wire bound exceeded"
    for field in [run.profile.profile_name, run.profile.compatibility_id, run.profile.cas_namespace] + run.profile.pools:
        if not builder_text_valid_v1(field): return "invalid profile wire scalar"
    if not managed_parse_unique_ids_v1(run.worker_slots) or run.worker_slots.len() > 64 or run.worker_slots.len() > run.profile.max_workers or run.profile.memory_budget_bytes < run.worker_slots.len(): return "invalid worker slots"
    if run.snapshots.len() != run.worker_slots.len(): return "snapshot slot count mismatch"
    val schedule_error = managed_parse_schedule_validate_v1(run.schedule)
    if schedule_error != "": return schedule_error
    if persisted_graph_encode_v1(run.graph) == "" or run.graph.actions.len() != run.schedule.groups.len() or run.bindings.len() != run.schedule.groups.len(): return "invalid parse graph"
    var digest = ""
    for i in 0..run.worker_slots.len():
        val snapshot = run.snapshots[i]
        val error = managed_parse_snapshot_validate_v1(snapshot)
        if error != "": return error
        if snapshot.worker_id != run.worker_slots[i] or snapshot.generation != 1 or snapshot.worker_digest != run.worker_digest or snapshot.cache_identity != run.profile.compatibility_id: return "snapshot worker/cache mismatch"
        if i == 0: digest = snapshot.snapshot_digest
        if snapshot.snapshot_digest != digest: return "worker inventories differ"
        var packages: [text] = []
        for module in snapshot.modules:
            if not packages.contains(module.package_id): packages = packages.push(module.package_id)
        if packages.sorted() != run.schedule.dirty_packages.sorted(): return "snapshot package membership mismatch"
    if run.graph.snapshot_revision != digest: return "graph snapshot mismatch"
    var bound_actions: [text] = []
    var bound_groups: [text] = []
    for binding in run.bindings:
        if binding.phase != "parse" or binding.publishes_package or binding.snapshot_digest != digest or binding.cache_identity != run.profile.compatibility_id: return "invalid parse binding"
        if bound_actions.contains(binding.action_id) or bound_groups.contains(binding.group_id): return "duplicate parse binding"
        var found_group = false
        var dependencies: [text] = []
        var source_digests: [text] = []
        for group in run.schedule.groups:
            if group.identity == binding.group_id:
                found_group = true
                for module in run.snapshots[0].modules:
                    if group.members.contains(module.package_id): source_digests = source_digests.push(module.source_digest)
                for dependency in group.dependencies:
                    var found_dependency = false
                    for peer in run.bindings:
                        if peer.group_id == dependency:
                            dependencies = dependencies.push(peer.action_id)
                            found_dependency = true
                    if not found_dependency: return "unbound SCC dependency"
        if not found_group: return "binding group absent"
        var found_action = false
        for action in run.graph.actions:
            if action.action_id == binding.action_id:
                if action.pool != BuildActionPoolV1.parse or action.snapshot_revision != digest or action.restat_identity != binding.cache_identity or action.dynamic_edges.sorted() != dependencies.sorted() or action.memory_budget_bytes > run.profile.memory_budget_bytes: return "action authority mismatch"
                if action.command_identity != "managed-reference-parse-v1:" + run.worker_digest: return "action parser producer mismatch"
                # Input multiplicity is significant: two equal source blobs
                # still represent two selected modules. Graph wire sorts rows.
                if action.inputs.sorted() != source_digests.sorted(): return "action source membership mismatch"
                found_action = true
        if not found_action: return "binding action absent"
        bound_actions = bound_actions.push(binding.action_id)
        bound_groups = bound_groups.push(binding.group_id)
    if run.environment.len() > 1024: return "environment too large"
    var names: [text] = []
    for assignment in run.environment:
        if not builder_text_valid_v1(assignment) or assignment.contains("\n") or assignment.contains("\r"): return "invalid environment assignment"
        val split = assignment.find("=")
        if split <= 0: return "invalid environment assignment"
        val name = assignment.substring(0, split)
        if not builder_identifier_valid_v1(name) or names.contains(name.to_upper()): return "duplicate or invalid environment name"
        names = names.push(name.to_upper())
    ""

fn managed_parse_run_encode_v1(run: ManagedParseRunV1) -> text:
    if managed_parse_run_validate_v1(run) != "": return ""
    val graph = persisted_graph_encode_v1(run.graph)
    if graph.len() > 65536: return ""
    var out = "SIMPLE-MANAGED-PARSE-RUN-1\n" + managed_parse_fields_v1([run.run_id, graph, run.schedule.variant_digest])
    out = out + managed_parse_list_wire_v1(run.schedule.dirty_packages) + managed_parse_fields_v1(["{run.schedule.groups.len()}"])
    for group in run.schedule.groups:
        out = out + managed_parse_fields_v1([group.identity]) + managed_parse_list_wire_v1(group.members) + managed_parse_list_wire_v1(group.dependencies)
    out = out + managed_parse_fields_v1(["{run.schedule.waves.len()}"])
    for wave in run.schedule.waves:
        var ids: [text] = []
        for group in wave.groups: ids = ids.push(group.identity)
        out = out + managed_parse_fields_v1(["{wave.ordinal}"]) + managed_parse_list_wire_v1(ids)
    val p = run.profile
    out = out + managed_parse_fields_v1([p.profile_name, p.compatibility_id, "{p.foreground_priority}", if p.daemon_optional: "1" else: "0", p.cas_namespace, "{p.max_workers}", "{p.memory_budget_bytes}", "{p.frame_budget_bytes}"]) + managed_parse_list_wire_v1(p.pools)
    out = out + managed_parse_fields_v1(["{run.bindings.len()}"])
    for binding in run.bindings:
        out = out + managed_parse_fields_v1([binding.group_id, binding.action_id, binding.phase, binding.snapshot_digest, binding.cache_identity])
    out = out + managed_parse_list_wire_v1(run.worker_slots) + managed_parse_fields_v1(["{run.snapshots.len()}"])
    for snapshot in run.snapshots:
        val encoded = managed_parse_snapshot_encode_v1(snapshot)
        if encoded == "": return ""
        out = out + managed_parse_fields_v1([encoded])
    out = out + managed_parse_fields_v1([run.source_root, run.state_root, run.worker_program, run.worker_digest,
        "{run.max_attempts}", if run.keep_going: "1" else: "0", "{run.poll_ms}", "{run.startup_timeout_ms}", "{run.shutdown_timeout_ms}", run.broker_program, run.broker_digest, "{run.lifetime_ms}"]) + managed_parse_list_wire_v1(run.environment)
    if out.len() > 16777216: return ""
    out

fn managed_parse_run_decode_v1(payload: text) -> Result<ManagedParseRunV1, text>:
    val reader = BuilderWireReaderV1.create(payload)
    if reader.scalar() != "SIMPLE-MANAGED-PARSE-RUN-1": return Err("invalid parse run header")
    val id = reader.scalar()
    val graph = persisted_graph_decode_v1(reader.scalar())?
    val variant = reader.scalar()
    val packages = managed_parse_list_read_v1(reader)
    val group_count = reader.number(4096, false)
    var groups: [PackageSccGroupV1] = []
    for i in 0..group_count:
        val identity = reader.scalar()
        val members = managed_parse_list_read_v1(reader)
        val dependencies = managed_parse_list_read_v1(reader)
        groups = groups.push(PackageSccGroupV1(identity, members, dependencies))
    val wave_count = reader.number(4096, false)
    var waves: [PackageSccWaveV1] = []
    for i in 0..wave_count:
        val ordinal = reader.number(4096, false)
        val ids = managed_parse_list_read_v1(reader)
        var members: [PackageSccGroupV1] = []
        for name in ids:
            var found = false
            for group in groups:
                if group.identity == name:
                    members = members.push(group)
                    found = true
            if not found: return Err("unknown wave group")
        waves = waves.push(PackageSccWaveV1(ordinal, members))
    val schedule = PackageCompileScheduleV1(true, "ok", variant, packages, groups, waves)
    val profile_name = reader.scalar()
    val compatibility = reader.scalar()
    val priority = reader.number(2147483647, false)
    val optional = reader.number(1, false) == 1
    val namespace = reader.scalar()
    val workers = reader.number(64, false)
    val memory = reader.number(1099511627776, false)
    val frame = reader.number(4194304, false)
    val pools = managed_parse_list_read_v1(reader)
    val profile = ArtifactServiceProfileV1(profile_name, compatibility, pools, priority, optional, namespace, workers, memory, frame)
    val binding_count = reader.number(4096, false)
    var bindings: [GroupedActionBindingV1] = []
    for i in 0..binding_count:
        bindings = bindings.push(GroupedActionBindingV1(reader.scalar(), reader.scalar(), reader.scalar(), reader.scalar(), reader.scalar(), false))
    val slots = managed_parse_list_read_v1(reader)
    val snapshot_count = reader.number(64, false)
    var snapshots: [ManagedParseSnapshotV1] = []
    for i in 0..snapshot_count:
        val snapshot = managed_parse_snapshot_decode_v1(reader.scalar())?
        snapshots = snapshots.push(snapshot)
    val source = reader.scalar()
    val state = reader.scalar()
    val worker = reader.scalar()
    val worker_digest = reader.scalar()
    val attempts = reader.number(3, false)
    val keep = reader.number(1, false) == 1
    val poll = reader.number(60000, false)
    val startup = reader.number(604800000, false)
    val shutdown = reader.number(604800000, false)
    val broker = reader.scalar()
    val broker_digest = reader.scalar()
    val lifetime = reader.number(604800000, false)
    val environment = managed_parse_list_read_v1(reader)
    if reader.complete_error() != "": return Err(reader.complete_error())
    val run = ManagedParseRunV1(id, schedule, graph, profile, bindings, slots, snapshots, source, state, worker, worker_digest, environment, attempts, keep, poll, startup, shutdown, broker, broker_digest, lifetime)
    val reason = managed_parse_run_validate_v1(run)
    if reason != "": return Err(reason)
    if managed_parse_run_encode_v1(run) != payload: return Err("noncanonical parse run")
    Ok(run)

export ManagedParseRunV1, managed_parse_run_validate_v1, managed_parse_run_encode_v1, managed_parse_run_decode_v1
