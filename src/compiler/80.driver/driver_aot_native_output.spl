# Read the object size DIRECTLY rather than through `FileFingerprint.size`.
#
# Measured 2026-09-12 on a Stage-2-compiled compiler (macOS aarch64): reading
# the `i64` field `.size` off an optional-bound `FileFingerprint` --
#
#     val object_fp = FileFingerprint.from_file(object_path)
#     if val fp = object_fp:
#         ... "{fp.size}" ...
#
# -- yields a TAGGED HEAP POINTER instead of the byte count. The capsule
# receipt for a 632-byte object recorded 54090898177 (0xc98119b01), and a
# second read of the SAME file in the SAME process produced 53657761281 where
# the first produced 53657758209 -- 0xc7e407601 vs 0xc7e406a01, two boxes 3072
# bytes apart. Because the receipt is WRITTEN from one such read and VERIFIED
# by recomputing it, the two disagreed while being the same LENGTH, which is
# the `receipt-content-mismatch:expected-bytes=1648:actual-bytes=1648` that
# blocked every macOS Stage 2.
#
# `.content_hash` through the identical binding looked correct, which is what
# made this hard to see -- but a `text` field IS a pointer, so a boxed read of
# it is indistinguishable from a correct one. Only the `i64` field exposed the
# defect.
#
# This is the same class as the `case Ok(source): source.content` misread
# already documented in `driver_native_disk_source_identity` below, and the
# same remedy: go to the runtime for the value instead of through the bound
# payload. The underlying codegen defect is NOT fixed here --
# doc/08_tracking/bug/bootstrap_stage2_native_capsule_receipt_mismatch_equal_byte_counts_2026-09-12.md
# -- and it will misread any other scalar field read the same way.
#
# The runtime returns -1 when the file cannot be stat'd; callers must treat a
# negative result as a failure, never as a size.

# 2^40. No object file this compiler emits approaches a terabyte, so a "size"
# at or above this bound is a tagged heap pointer, never a byte count -- the
# exact shape that wrote 37196932097 into the receipt for a 632-byte object.
val CAPSULE_RECEIPT_MAX_PLAUSIBLE_SIZE: i64 = 1099511627776

pub fn driver_native_capsule_receipt_size_reason_v1(runtime_size: i64) -> text:
    """"" when the object size may be written to a receipt, else the ONE
    invariant that failed.

    BLOCKING gate on the value that is actually WRITTEN to receipt line 4.
    Both receipt sites take that value from `file_size_raw` (the typed std alias
    over the runtime stat), so this is the only check standing between a bad
    number and the disk, and it is never relaxed: a negative size is the stat
    sentinel `FileFingerprint.from_file` passes through unchecked, and a value
    at or above 2^40 is a pointer.
    """
    if runtime_size < 0:
        return "receipt-size-unreadable:runtime={runtime_size}"
    if runtime_size >= CAPSULE_RECEIPT_MAX_PLAUSIBLE_SIZE:
        return "receipt-size-implausible:runtime={runtime_size}"
    ""

pub fn driver_native_capsule_receipt_size_canary_v1(
    field_size: i64, runtime_size: i64
) -> text:
    """"" when the struct-field read agrees with the runtime, else the two
    values, for an ADVISORY report.

    `FileFingerprint.from_file` sets `size = rt_file_size(path)`
    (`driver_build/incremental.spl:60,640`), so these are the same quantity and
    a disagreement can only be the optional-bound scalar-field miscompile.

    Advisory, deliberately, and measured rather than assumed: run 9 of the macOS
    Stage 2 chain (2026-09-13) ran this check in BLOCKING form and it fired --
    `field=34363944961` (a tagged heap pointer, same `0x8_…` space as live heap
    objects in that process) against `runtime=632`, the true byte count. That
    proved both halves of the diagnosis at once: `rt_file_size` is correct under
    `--mode=dynload --entry-closure`, and the field read is not. It also blocked
    the whole bootstrap over a codegen defect that this file already routes
    around -- the receipt written in that run was CORRECT on both sides, because
    neither side reads the field. So the divergence is reported unconditionally
    and never silenced, but it does not fail the build. The value that reaches
    disk is gated by `driver_native_capsule_receipt_size_reason_v1` above.

    Codegen defect:
    doc/08_tracking/bug/stage2_sanity_native_capsule_receipt_content_mismatch_2026-09-13.md
    """
    if field_size != runtime_size:
        return "field={field_size}:runtime={runtime_size}"
    ""

val NATIVE_MODULE_CACHE_SHADOW_RECEIPT_VERSION: text = "native-module-cache-shadow-receipt-v1"
val NATIVE_MODULE_CACHE_SHADOW_MISMATCH_LIMIT: i64 = 64

fn driver_native_shadow_witness_v1(
    ctx: CompileContext, module_name: text, module: MirModule,
    config: NativeModuleConfigFactV1
) -> (text, text):
    val mir_identity = native_capsule_mir_identity_v1(module)
    if module_name == "" or mir_identity == "":
        return ("", "missing-module-or-mir-identity")
    if not ctx.module_surfaces.?:
        val invalid = native_module_cache_witness_invalid_v1(
            "missing-module-surfaces")
        return ("native-module-cache-witness-v1-invalid|{module_name}|{mir_identity}|{invalid.reason}",
            invalid.reason)
    # Do not call bare `.unwrap()` here.  The bootstrap method resolver can
    # bind it to an unrelated provider (for example Poll.unwrap), returning a
    # raw null payload even after the Option presence check.  The direct
    # projection is immune to that name collision.
    val surfaces = ctx.module_surfaces ?? ModuleSurfacesByName.empty()
    val dependencies = native_direct_dependency_facts_v1(
        module_name, surfaces, ctx.sources)
    if not dependencies.valid:
        return ("native-module-cache-witness-v1-invalid|{module_name}|{mir_identity}|{dependencies.reason}",
            dependencies.reason)
    val resolutions = native_resolution_facts_v1(module_name, surfaces)
    if not resolutions.valid:
        return ("native-module-cache-witness-v1-invalid|{module_name}|{mir_identity}|{resolutions.reason}",
            resolutions.reason)
    # MIR lowering always attaches the retained trace collection, including an
    # authoritative empty collection for modules with no external layout use.
    val layouts = native_external_layout_facts_from_mir_v1(module, true)
    if not layouts.valid:
        return ("native-module-cache-witness-v1-invalid|{module_name}|{mir_identity}|{layouts.reason}",
            layouts.reason)
    val complete_facts = native_module_cache_fact_set_merge_v1(
        dependencies, resolutions, layouts)
    if not complete_facts.valid:
        return ("native-module-cache-witness-v1-invalid|{module_name}|{mir_identity}|{complete_facts.reason}",
            complete_facts.reason)
    val witness = complete_facts.witness(mir_identity, config)
    if not witness.valid:
        return ("native-module-cache-witness-v1-invalid|{module_name}|{mir_identity}|{witness.reason}",
            witness.reason)
    ("native-module-cache-witness-v1|{module_name}|{mir_identity}|{witness.dependency_fold}|{witness.resolution_fold}|{witness.cross_module_layout_fingerprint}|{witness.config_fingerprint}",
        "ok")

fn driver_native_shadow_bounded_module(module_name: text) -> text:
    if module_name.len() <= 160: return module_name
    module_name.substring(0, 160)

fn driver_native_shadow_sort(lines: [text]) -> [text]:
    var sorted: [text] = []
    for line in lines:
        var inserted = false
        var next: [text] = []
        for current in sorted:
            if not inserted and line < current:
                next.push(line)
                inserted = true
            next.push(current)
        if not inserted: next.push(line)
        sorted = next
    sorted

# `file_write_text` / `file_read_text` are NOT usable here. `std.file_system`
# exports argument-validating STUBS (`file_ops.spl:60` returns `true` without
# writing a byte), and the name additionally collides across the loaded set --
# the JIT reports `file_write_text` with 3 co-compiled definitions over 2
# signatures ((text,text)->() vs (text,text)->bool) and resolves the ambiguity
# by falling back to the LAST definition. On Windows that landed on the stub, so
# the capsule receipt was never written while the write reported success, and
# every native-build died at `native-capsule-receipt-invalid` (see
# doc/08_tracking/bug/windows_native_capsule_receipt_invalid_blocks_every_native_build_2026-09-03.md).
# `file_write_exact` / `file_read_nullable` are single-definition names backed by
# one direct `rt_file_write_text` / `rt_file_read_text` call, so they are both
# real and unambiguous.
@always_inline
fn _sffi_file_write_text(path: text, content: text) -> bool:
    # `file_write_exact` is the one-call runtime status (io_runtime.spl:250):
    # every caller below writes into `cache_scope_root`, which
    # `_sffi_dir_create(cache_scope_root, true)` has already created, so the
    # create-parent-and-retry policy of `file_write` would only mask a genuinely
    # missing directory. Callers here treat `false` as a hard build error and
    # need the honest status.
    unsafe(capabilities: [ffi]):
        file_write_exact(path, content)

@always_inline
fn _sffi_file_read_text(path: text) -> text?:
    unsafe(capabilities: [ffi]):
        file_read_nullable(path)

@always_inline
fn _sffi_file_exists(path: text) -> bool:
    unsafe(capabilities: [ffi]):
        file_exists(path)

@always_inline
fn _sffi_file_copy(src: text, dst: text) -> bool:
    unsafe(capabilities: [ffi]):
        file_copy(src, dst)

@always_inline
fn _sffi_dir_create(path: text, recursive: bool) -> bool:
    unsafe(capabilities: [ffi]):
        dir_create(path, recursive)

@always_inline
fn _sffi_dir_remove_all(path: text) -> bool:
    unsafe(capabilities: [ffi]):
        rt_dir_remove_all(path)

@always_inline
fn _sffi_path_join(a: text, b: text) -> text:
    unsafe(capabilities: [ffi]):
        rt_path_join(a, b)

@always_inline
fn _sffi_hash_text(content: text) -> i64:
    unsafe(capabilities: [ffi]):
        hash_text(content)

@always_inline
fn _sffi_stdout_flush():
    unsafe(capabilities: [ffi]):
        rt_stdout_flush()

fn driver_log_info(log: Logger, message: text):
    if log.level >= 4:
        print "[INFO] {message}"

fn driver_emit_phase2_compatibility_manifest_v1(
    build_cache: BuildCache, phase2_cache_root: text, phase3_cache_root: text,
    manifest_path: text, producer_identity: text, provider_identity: text,
    target_identity: text
) -> text:
    if manifest_path == "":
        return "ok"
    if phase3_cache_root == "":
        return "missing-phase3-cache-root"
    val canonical_phase2 = phase_compatibility_canonical_directory_io_v1(
        phase2_cache_root)
    if not canonical_phase2.valid:
        return "phase2-" + canonical_phase2.reason
    val canonical_phase3 = phase_compatibility_canonical_directory_io_v1(
        phase3_cache_root)
    if not canonical_phase3.valid:
        return "phase3-" + canonical_phase3.reason
    val m2_read = reverse_reference_read_current_admitted_v1(
        canonical_phase2.canonical_root, build_cache.cache_path)
    if not m2_read.valid or m2_read.receipt == nil:
        return "m2-receipt-" + m2_read.reason
    val m2_receipt_digest = reverse_reference_receipt_digest_v1(
        m2_read.receipt!)
    if m2_receipt_digest == "":
        return "m2-receipt-digest-invalid"
    var items: [PhaseCompatibilityItemV1] = []
    for source in build_cache.entries.keys():
        val entry = build_cache.entries[source]
        if entry.outputs.len() != 1 or entry.module_witness == "":
            continue
        val artifact_path = entry.outputs[0]
        val artifact_admission = phase_compatibility_existing_artifact_io_v1(
            canonical_phase2.canonical_root, artifact_path)
        if not artifact_admission.valid:
            return "native-" + artifact_admission.reason + ":" + source
        val artifact = phase_compatibility_read_artifact_io_v1(
            canonical_phase2.canonical_root, artifact_path)
        if not artifact.valid:
            return "native-" + artifact.reason + ":" + source
        val artifact_digest = sha256_text(artifact.content)
        if artifact_digest.len() != 64:
            return "unreadable-artifact:" + source
        val projection = reverse_reference_exact_projection_v1(
            m2_read, source, source, "module-scc-artifact")
        if projection == nil or projection!.key_frame !=
                reverse_reference_key_encode_v1(projection!.key):
            return "m2-native-key-missing-or-ambiguous:" + source
        items = items.push(phase_compatibility_item_frame_v1(
            PHASE_COMPATIBILITY_NATIVE_V1, projection!.key_frame,
            artifact_admission.canonical_path,
            artifact_digest, producer_identity, provider_identity,
            target_identity, source))
    val frontend_dir = frontend_parse_cache_dir()
    for name in dir_list(frontend_dir) ?? []:
        if not name.ends_with(".fpc"):
            continue
        val artifact_path = _sffi_path_join(frontend_dir, name)
        val artifact_admission = phase_compatibility_existing_artifact_io_v1(
            canonical_phase2.canonical_root, artifact_path)
        if not artifact_admission.valid:
            return "frontend-" + artifact_admission.reason + ":" + name
        val artifact = phase_compatibility_read_artifact_io_v1(
            canonical_phase2.canonical_root, artifact_path)
        if not artifact.valid:
            return "frontend-" + artifact.reason + ":" + name
        val artifact_digest = sha256_text(artifact.content)
        if artifact_digest.len() != 64:
            return "unreadable-frontend-artifact:" + name
        val subject = name.substring(0, name.len() - 4)
        var source_identity = ""
        for source in build_cache.entries.keys():
            if build_cache.entries[source].fingerprint.content_hash == subject:
                if source_identity != "":
                    return "m2-frontend-source-ambiguous:" + subject
                source_identity = source
        if source_identity == "":
            return "m2-frontend-source-missing:" + subject
        val projection = reverse_reference_exact_projection_v1(
            m2_read, source_identity, source_identity,
            "direct-import-export")
        if projection == nil or projection!.key_frame !=
                reverse_reference_key_encode_v1(projection!.key):
            return "m2-frontend-key-missing-or-ambiguous:" + source_identity
        items = items.push(phase_compatibility_item_frame_v1(
            "frontend", projection!.key_frame,
            artifact_admission.canonical_path, artifact_digest,
            "producer-neutral",
            FRONTEND_CACHE_ENTRY_VERSION + ":" + FLAT_POOL_CODEC_VERSION,
            "target-neutral", source_identity))
    val manifest = PhaseCompatibilityManifestV1(
        1, canonical_phase2.canonical_root, canonical_phase3.canonical_root,
        build_cache.cache_path, m2_receipt_digest,
        m2_read.receipt!.owner_generation,
        m2_read.receipt!.root_generation, items)
    val encoded = phase_compatibility_manifest_encode_v1(manifest)
    if encoded == "":
        return "invalid-manifest"
    if not file_create_excl(manifest_path, encoded):
        return "manifest-already-published"
    val published_manifest = phase_compatibility_read_manifest_io_v1(manifest_path)
    if not published_manifest.valid or
            sha256_text(published_manifest.content) != sha256_text(encoded):
        return "manifest-publish-digest-mismatch"
    "ok"

fn driver_load_phase2_compatibility_manifest_v1() -> PhaseCompatibilityManifestV1?:
    val path = env_get_nullable("SIMPLE_PHASE2_COMPATIBILITY_MANIFEST_READ") ?? ""
    if path == "":
        return nil
    val phase3_root = env_get_nullable("SIMPLE_PHASE3_COMPATIBILITY_CACHE_ROOT") ?? ""
    val admitted = driver_admit_phase2_compatibility_manifest_v1(path, phase3_root)
    if not admitted.valid or admitted.manifest == nil:
        print "[M3] reject manifest reason={admitted.reason} path={path}"
        return nil
    admitted.manifest

fn driver_materialize_phase2_native_v1(
    manifest: PhaseCompatibilityManifestV1, source: text,
    expected_witness: text, expected_capsule: FrozenNativeModuleCapsuleV1,
    config: NativeModuleConfigFactV1, cache_scope_root: text,
    build_cache: BuildCache
) -> (bool, text):
    for item in manifest.items:
        if item.kind != PHASE_COMPATIBILITY_NATIVE_V1:
            continue
        val decoded_key = reverse_reference_key_decode_v1(item.key_frame)
        if not decoded_key.valid:
            continue
        val key = decoded_key.key.unwrap()
        if key.subject_identity != source:
            continue
        if key.registry_kind != "native" or
                key.projection_kind != "module-scc-artifact" or
                key.projection_digest != reverse_reference_fact_digest_v1(
                    "module-scc-artifact", source, source,
                    expected_witness):
            print "[M3] reject native reason=wrong-key-binding path={item.artifact_path}"
            return (false, item.artifact_path)
        val artifact = phase_compatibility_read_artifact_io_v1(
            manifest.phase2_cache_root, item.artifact_path)
        if not artifact.valid:
            print "[M3] reject native reason={artifact.reason} path={item.artifact_path}"
            return (false, item.artifact_path)
        val observed = sha256_text(artifact.content)
        val expected = PhaseCompatibilityExpectationV1(
            PHASE_COMPATIBILITY_NATIVE_V1, decoded_key.digest,
            manifest.m2_receipt_digest, manifest.m2_owner_generation,
            manifest.m2_root_generation,
            config.compiler_identity, config.provider_identity,
            config.target_identity, 1)
        val decision = phase_compatibility_admit_v1(manifest, expected, observed)
        if not decision.reused:
            print "[M3] reject native reason={decision.reason} path={item.artifact_path}"
            return (false, item.artifact_path)
        val destination_admission = phase_compatibility_destination_io_v1(
            manifest.phase3_cache_root, expected_capsule.object_path)
        if not destination_admission.valid:
            print "[M3] reject native reason=phase3-destination-outside-cache path={item.artifact_path}"
            return (false, item.artifact_path)
        val object_tmp = expected_capsule.object_path + ".{getpid()}.m3.tmp"
        val stage_reason = phase_compatibility_stage_artifact_io_v1(
            manifest.phase2_cache_root, item.artifact_path,
            manifest.phase3_cache_root, object_tmp)
        if stage_reason != "ok":
            print "[M3] reject native reason={stage_reason} path={item.artifact_path}"
            return (false, item.artifact_path)
        val staged = phase_compatibility_read_artifact_io_v1(
            manifest.phase3_cache_root, object_tmp)
        if not staged.valid or sha256_text(staged.content) != item.artifact_digest:
            val _deleted = file_delete(object_tmp)
            print "[M3] reject native reason=phase3-copy-digest-mismatch path={item.artifact_path}"
            return (false, item.artifact_path)
        val publish_reason = phase_compatibility_publish_staged_io_v1(
            manifest.phase3_cache_root, object_tmp,
            expected_capsule.object_path)
        if publish_reason != "ok":
            val _deleted = file_delete(object_tmp)
            print "[M3] reject native reason={publish_reason} path={item.artifact_path}"
            return (false, item.artifact_path)
        val _tmp_deleted = file_delete(object_tmp)
        val published = phase_compatibility_read_artifact_io_v1(
            manifest.phase3_cache_root, expected_capsule.object_path)
        if not published.valid or
                sha256_text(published.content) != item.artifact_digest:
            val _published_deleted = file_delete(expected_capsule.object_path)
            print "[M3] reject native reason=phase3-published-digest-mismatch path={item.artifact_path}"
            return (false, item.artifact_path)
        # Read the two receipt values from LOCALS, never back out of a
        # FileFingerprint. The `.size` read is miscompiled under Stage-2 native
        # codegen (see the `file_size_raw` note at the top of this file), and the
        # verifier this receipt must match now composes its expected text from
        # the same two locals, so both sides agree by construction.
        val materialized_size = published.content.len()
        val materialized_hash = item.artifact_digest
        val receipt = "native-capsule-result-v1\n{expected_capsule.capsule_identity}\n{expected_capsule.object_path}\n{materialized_size}\n{materialized_hash}\n"
        val receipt_path = expected_capsule.object_path + ".capsule-receipt"
        val receipt_admission = phase_compatibility_destination_io_v1(
            manifest.phase3_cache_root, receipt_path)
        if not receipt_admission.valid or not file_create_excl(receipt_path, receipt):
            print "[M3] reject native reason=phase3-receipt-write-failed path={item.artifact_path}"
            return (false, item.artifact_path)
        val published_receipt = phase_compatibility_read_manifest_io_v1(receipt_path)
        if not published_receipt.valid or
                sha256_text(published_receipt.content) != sha256_text(receipt):
            val _receipt_deleted = file_delete(receipt_path)
            print "[M3] reject native reason=phase3-receipt-publish-failed path={item.artifact_path}"
            return (false, item.artifact_path)
        val source_fp = FileFingerprint.from_file(source)
        if not source_fp.?:
            print "[M3] reject native reason=source-fingerprint-failed path={item.artifact_path}"
            return (false, item.artifact_path)
        build_cache.update_entry(source, source_fp.unwrap(), [],
            [expected_capsule.object_path], expected_witness)
        print "[M3] reuse native reason={decision.reason} path={item.artifact_path}"
        return (true, item.artifact_path)
    (false, "")

# Outcome vocabulary lives in ONE place: driver_build/build_outcome.spl, shared
# with the supervisor and the parallel builder so the three cannot drift into
# incompatible notions of failure. This file only ADAPTS to it — it does not
# define a second set of categories.
#
# Message-based classification for the IN-PROCESS compile path. The canonical
# classifier, build_outcome_classify_status, decodes a child's wait status
# (128+N). In-process there is no child and no wait status: a failed module
# surfaces only as an error MESSAGE, so this maps that message onto the SAME
# BuildOutcomeKind vocabulary. It is a narrower fallback, not a rival scheme —
# once per-unit separate-process execution lands (driver_build/parallel.spl),
# the status-based classifier is authoritative and this covers only clean
# compiler verdicts.
#
# Read before "simplifying" TERMINATED or TIMEOUT into a failure: earlyoom on
# this host runs `--prefer ^(simple|...)` and actively SIGTERMs `simple`, so a
# 143 is INFRASTRUCTURE — the module is UNVERIFIED, not failed. Conflating them
# manufactures phantom compiler bugs. BuildOutcomeSet.failure_count() already
# excludes both; do not re-add them here.
fn driver_native_classify_module_failure_v1(detail: text) -> BuildOutcomeKind:
    val lowered = detail.to_lower()
    if lowered.contains("timed out") or lowered.contains("timeout"):
        return BuildOutcomeKind.TIMEOUT
    if (lowered.contains("sigterm") or lowered.contains("signal 15")
        or lowered.contains("exit 143") or lowered.contains("status 143")):
        return BuildOutcomeKind.TERMINATED
    if (lowered.contains("sigsegv") or lowered.contains("sigabrt")
        or lowered.contains("sigkill") or lowered.contains("segmentation fault")
        or lowered.contains("killed by signal") or lowered.contains("signal 11")
        or lowered.contains("signal 6") or lowered.contains("signal 9")
        or lowered.contains("exit 139") or lowered.contains("exit 134")
        or lowered.contains("exit 137") or lowered.contains("out of memory")
        or lowered.contains("oom")):
        return BuildOutcomeKind.CRASHED
    BuildOutcomeKind.ERROR

# Record one FAILED module and keep going. The whole point of accumulating
# rather than returning: ONE build must name EVERY bad module, instead of each
# defect costing a full ~20-minute run to discover.
# Last line of defence for the "(none recorded — BUG in the producer)" summary.
#
# `BuildOutcomeSet.reason_block_for` is right that a non-OK unit must carry a
# diagnostic, and it is right to say so loudly rather than print silence. But it
# can only print what the producer handed it, and the AOT lane's `Err` payload
# is destroyed on the compiled stage-2 crossing (see `_aot_compile_failure`), so
# the summary was accusing the producer of a bug it could not avoid. The real
# reason is already on stdout by the time this runs; what this restores is the
# INVARIANT -- every non-OK unit carries a non-empty, self-describing reason
# that names where the text was lost, so the summary is never mistaken for
# "failed for no reason".
#
# This is deliberately NOT a substitute for the payload fix: an empty detail
# here is itself evidence of the crossing defect, and says so.
# `detail != ""` alone is NOT a sufficient emptiness test on this path. The
# payload that reaches here can be a corrupt tagged word (the `<invalid-heap:0x…>`
# shape in the bug record), which compares unequal to `""` and yet renders as
# nothing downstream -- so a value that passed this guard still arrived at
# `reason_block_for` as empty, which is precisely how a "non-empty" detail became
# "(none recorded)". Test the LENGTH as well: it is a different lowering path
# from text comparison, so the two together catch both the empty and the corrupt
# case. Anything non-positive is treated as lost.
fn driver_native_nonempty_failure_detail(detail: text) -> text:
    if detail != "" and detail.len() > 0:
        return detail
    "diagnostic lost crossing the AOT Result boundary (see the 'error: AOT "
        + "compile error' line above for the real reason); tracked in "
        + "doc/08_tracking/bug/stage2_aot_error_message_lost_invalid_heap_2026-09-06.md"

fn driver_native_record_module_failure(outcomes: BuildOutcomeSet, unit_id: i64,
                                       name: text, detail: text):
    # Emit the detail HERE, at the moment it is known, in addition to storing
    # it. The stored copy is not always readable back: on a REPEAT compile of a
    # module name already built in this workspace, the end-of-build summary
    # renders `reason: (none recorded — BUG in the producer: a non-OK unit must
    # carry a diagnostic)` even though this function ran. Measured 2026-09-07;
    # the first-ever compile of a name reports its reason, a repeat does not,
    # and a fresh --cache-dir does not reset it. Streaming the text costs one
    # line per FAILED module -- the same set the summary already names -- and
    # cannot be lost by a later field read. This is what made the capsule
    # source/disk digests readable at all.
    print "[native-compile-failed] {name}: {detail}"
    _sffi_stdout_flush()
    outcomes.record(BuildUnitOutcome(
        unit_id: unit_id, source_path: name,
        kind: driver_native_classify_module_failure_v1(detail),
        status: 0, signal_num: 0, wall_ms: 0, peak_rss_kb: 0,
        # R9: bound the RETAINED text (the rest is spilled to the diagnostic log)
        # while keeping the COUNT exact. This path is the one that was measured
        # accumulating 2,926 errors at 124 of 619 files with RSS climbing ~1 GB /
        # 30s -- unbounded retention here OOMs the very run doing the reporting.
        diagnostics: build_outcome_retain_diagnostics(name, detail),
        diagnostic_total: build_outcome_count_diagnostic_lines(detail),
        diagnostic_retained: build_outcome_retained_diagnostic_count(detail)))

# Deterministic end-of-build summary naming EVERY module in EVERY non-OK
# category (R3), then the fail-closed verdict — "" when every module is OK.
# The caller MUST NOT link when this is non-empty, and must never fabricate an
# object for a module that did not build (R4; this repo already has that defect
# at linker/native_binary/stubs.rs:209-221).
fn driver_native_report_module_outcomes_v1(outcomes: BuildOutcomeSet) -> text:
    if outcomes.all_ok():
        return ""
    print outcomes.summary()
    _sffi_stdout_flush()
    outcomes.verdict()

fn driver_effective_native_opt_level(ctx: CompileContext, is_release: bool) -> i64:
    if ctx.options.opt_level.?:
        return ctx.options.opt_level ?? 0
    if is_release:
        return 3
    0

fn driver_native_build_threads() -> i64:
    val raw = env_get_nullable("SIMPLE_NATIVE_BUILD_THREADS") ?? ""
    if raw == "":
        return 0
    val parsed = raw.to_i64() ?? 0
    if parsed < 0:
        return 0
    parsed

fn driver_native_build_cache_dir() -> text:
    val dir = env_get_nullable("SIMPLE_NATIVE_BUILD_CACHE_DIR") ?? ""
    if dir == "":
        _sffi_path_join(machine_cache_root(), "native-build/v1")
    else:
        dir

fn driver_native_build_cache_path(cache_dir: text) -> text:
    _sffi_path_join(cache_dir, "build_cache.sdn")

@unsafe(reason: "raw host SIMD capability-query ABI", capabilities: [ffi])
extern fn rt_simd_has_avx2() -> bool

@always_inline
fn _sffi_simd_has_avx2() -> bool:
    unsafe(capabilities: [ffi]):
        rt_simd_has_avx2()

fn driver_native_build_cache_scope(backend: text, cache_dir: text, target: text,
                                   target_cpu: text, opt_level: i64,
                                   symbol_mode: text, storage_identity: text,
                                   provider_receipt_hash: text = "") -> (text, text):
    val raw_target = if target == "": nil else: Some(target)
    val compiler_id = native_build_compiler_identity()
        + if symbol_mode == "": "" else: "-" + symbol_mode
        + "-storage-" + sha256_text(storage_identity)
    val host_avx2 = target == "" and _sffi_simd_has_avx2()
    val capability_key = "native-avx2-policy-v1:cpu={target_cpu};host={host_avx2}"
    val scope_raw = native_build_cache_scope_key(
        Some(backend), raw_target, [capability_key], opt_level as i32,
        compiler_id, provider_receipt_hash)
    # `scope` is a SINGLE directory component, so it must satisfy every
    # filesystem's component rules at once:
    #   - POSIX NAME_MAX (255 on ext4/xfs): the old `-storage-<sha256>` growth
    #     pushed the raw key to 295 chars and every object write failed with
    #     ENAMETOOLONG ("Failed to write ELF bytes to build/native_cache/...").
    #   - Windows MAX_PATH (260 for the WHOLE path, incl. NUL): the previous
    #     scheme's 160-head + ";digest=" + 64 form was ALWAYS 232 chars at
    #     stage 3 (scope_raw measures 388 with a real compiler identity), and
    #     the worst stage-3 object path -- <abs repo>/<stage3 cache dir>/
    #     <scope>/sources-<i64 hash>n<count>/object.<module>.o with an 84-char
    #     module name -- carries ~226 chars of overhead BESIDES the scope, so
    #     the total blew far past 260 and cl.exe exits 1 with NO diagnostic at
    #     all. The scope's budget is therefore ~33 chars. See
    #     doc/08_tracking/bug/windows_bootstrap_max_path_262_2026-08-30.md.
    #   - NTFS forbids : * ? " < > | (and \ /) in a component, and the raw key
    #     ALWAYS contains ':' via "native-avx2-policy-v1:cpu=...", inside the
    #     old 160-char head -- the directory could not even be created on
    #     Windows.
    # So: ALWAYS fold the FULL raw key into a sha256 digest and name the scope
    # "s" + its first 128 bits -- fixed 33 chars, alphabet [s0-9a-f], which is
    # inherently NTFS/POSIX-component-safe (no char needs escaping) and the
    # same shape the Rust keyer uses (`scope-{:016x}`, native_project/mod.rs).
    # Identity stays SOUND: a 128-bit sha256 prefix is collision-resistant, so
    # two different raw keys cannot share a directory, and the same key always
    # maps to the same one (no time, no randomness, no iteration order).
    # NOTE: this derivation change renames every existing scope directory on
    # every platform -- a one-time safe cache miss (stale dirs are simply
    # never matched again), never a wrong reuse. Nothing parses the directory
    # NAME back apart: lane ownership rides in the `.cache_scope` marker
    # CONTENT (see check-cache-scope-ownership.shs), and cached-output
    # filtering is a plain path-prefix match. To recover WHAT a scope dir was
    # keyed on, recompute: the raw key is fully determined by the lane env,
    # backend/target/cpu/opt flags, and the compiler identity above.
    val scope = "s" + sha256_text(scope_raw).substring(0, 32)
    val cache_scope_root = _sffi_path_join(cache_dir, scope)
    (cache_scope_root, scope)

pub fn driver_native_capsule_identity_empty_v1(identity: text) -> bool:
    """True when a frozen source identity carries no content.

    Both `""` and the sha256 of the EMPTY string are rejected: the second is
    what a capture produces when it hashes source text that has already been
    reclaimed, and it is never a legitimate identity for a source file the
    compiler actually read (an empty file is not admitted as a source)."""
    identity == "" or identity == sha256_text("")

pub fn driver_native_frozen_source_lookup(
    source_paths: [text], source_identities: [text], source_module_names: [text],
    module_name: text
) -> (text, text):
    """Return the unique physical path and full-content identity retained by
    phase 1. Malformed inventories, duplicate module names, and path aliases
    fail closed instead of admitting an object under an ambiguous source.

    Takes the phase-1 IDENTITY owner, never the content owner: source text is
    freed and the content owner emptied long before native output runs, so
    hashing it here produced sha256("") for every module."""
    if source_paths.len() != source_identities.len() or
            source_paths.len() != source_module_names.len():
        return ("", "")
    var found_path = ""
    var identity = ""
    var module_count = 0
    var source_index = 0
    while source_index < source_module_names.len():
        if source_module_names[source_index] == module_name:
            found_path = source_paths[source_index]
            identity = source_identities[source_index]
            module_count = module_count + 1
        source_index = source_index + 1
    if module_count != 1 or found_path == "":
        return ("", "")
    # A single file can be loaded under multiple module aliases. BuildCache is
    # keyed by source path, so sharing that entry would let one alias reuse the
    # other alias's object. Fail closed for aliases instead of guessing.
    var path_count = 0
    for source_path in source_paths:
        if source_path == found_path:
            path_count = path_count + 1
    if path_count == 1:
        return (found_path, identity)
    ("", "")

fn driver_native_module_cache_source(ctx: CompileContext, module_name: text) -> text:
    val (path, _) = driver_native_frozen_source_lookup(
        ctx.source_paths_owner, ctx.source_identities_owner,
        ctx.source_module_names_owner, module_name)
    path

fn driver_native_module_source_identity(
    ctx: CompileContext, module_name: text
) -> text:
    val (_, identity) = driver_native_frozen_source_lookup(
        ctx.source_paths_owner, ctx.source_identities_owner,
        ctx.source_module_names_owner, module_name)
    identity

fn driver_native_disk_source_identity(source_path: text) -> text:
    """sha256 of the bytes currently on disk at `source_path`; "" when absent.

    Read the file DIRECTLY rather than through `SourceFile.load` + a
    match-bound payload field. Measured 2026-09-07 on a Stage-2-compiled
    compiler (sha256 a11d1c06…848a95): the previous form

        match SourceFile.load(source_path):
            case Ok(source): sha256_text(source.content)
            case Err(_): ""

    returned `sha256_text(source_path)` -- the digest of the PATH STRING --
    because the `case Ok(source)` payload's `.content` read yielded field 0
    (`path`) instead of `content`. Proven twice with distinct modules: for
    `build/capsule-repro/sub/hw_fresh_a.spl` it produced
    009f18fc41410f2512f4fc413689d7fa0f17b3cef6bbad4c1ab488994e1c170b, which is
    exactly `sha256` of that path text, while the correct content digest is
    2976a380c6fdfee06ca2b9452d65bc6a3514862c2a626d64e982503241ada42a; the same
    held for `hw_fresh_b.spl` (47d1543b…). Interpreted under the Rust seed the
    identical expression returns the correct content digest, so this is a
    native-codegen field-binding defect, not a source-level one. Its effect was
    that EVERY capsule verification compared a content digest against a path
    digest and reported `native-capsule-source-mutated`, which is what blocked
    Stage 2's sanity gate on a three-line hello world.

    Reading the raw bytes is also the STRICTLY CORRECT counterpart of the
    frozen side: `source_identity` is `sha256_text(source.content)` over
    content that `_driver_cached_entry_source_scan` obtained from a raw
    `rt_file_read_text`, never through `SourceFile.load`. `SourceFile.load`
    additionally strips a coverage-wrapper marker line
    (`source_file_coverage_identity`), so for `simple_cov_*` /
    `spipe_wrapped_*` inputs it would have disagreed with the frozen digest
    even with correct codegen. The `""`-on-empty behaviour matches
    `SourceFile.load`, which returns Err for an empty file.

    The underlying field-binding defect is NOT fixed here and is tracked in
    doc/08_tracking/bug/stage2_capsule_source_mutated_and_unreportable_reason_2026-09-07.md
    -- it will misread any other `case Ok(record):` field read the same way.
    """
    val content = _sffi_file_read_text(source_path) ?? ""
    if content == "": return ""
    sha256_text(content)

pub fn driver_native_capsule_result_reason_v1(
    capsule: FrozenNativeModuleCapsuleV1
) -> text:
    """"" when the capsule receipt is valid, else the ONE invariant that failed.

    Every branch here is the same fail-closed condition
    `driver_native_capsule_result_valid_v1` enforces; this function only names
    which one fired, so the verdict string is diagnosable. Nothing is relaxed.
    """
    if not capsule.identity_valid(): return "identity-invalid"
    if not _sffi_file_exists(capsule.object_path):
        return "object-missing:{capsule.object_path}"
    if capsule.cache_source != "":
        if driver_native_capsule_identity_empty_v1(capsule.source_identity):
            return "source-identity-empty:{capsule.cache_source}"
        val disk_identity = driver_native_disk_source_identity(capsule.cache_source)
        if disk_identity != capsule.source_identity:
            return "source-identity-mismatch:{capsule.cache_source}:frozen={capsule.source_identity}:disk={disk_identity}"
    val receipt_path = capsule.object_path + ".capsule-receipt"
    if not _sffi_file_exists(receipt_path):
        return "receipt-missing:{receipt_path}"
    val object_fp = FileFingerprint.from_file(capsule.object_path)
    if not object_fp.?: return "object-fingerprint-failed:{capsule.object_path}"
    # Size comes from the runtime, NOT from `fp.size` -- see the note on the
    # `file_size_raw` note at the top of this file. The hash still comes
    # from the fingerprint, because that is what the frozen side computed.
    val object_size = file_size_raw(capsule.object_path)
    if object_size < 0:
        return "object-size-unreadable:{capsule.object_path}"
    val size_reason = driver_native_capsule_receipt_size_reason_v1(object_size)
    if size_reason != "":
        return "{size_reason}:{capsule.object_path}"
    var expected = ""
    var size_canary = ""
    if val fp = object_fp:
        # `fp.size` is a canary only -- `object_size` is what composes line 4.
        size_canary = driver_native_capsule_receipt_size_canary_v1(
            fp.size, object_size)
        expected = "native-capsule-result-v1\n{capsule.capsule_identity}\n{capsule.object_path}\n{object_size}\n{fp.content_hash}\n"
    if size_canary != "":
        print "[receipt-size-canary] optional-bound scalar field read miscompiled: {size_canary} path={capsule.object_path}"
        _sffi_stdout_flush()
    val actual = _sffi_file_read_text(receipt_path) ?? ""
    if actual != expected:
        # Report LENGTHS, not the two blobs: the receipt is ~1.3 KB and the
        # difference is what matters. A length pair that is equal while the texts
        # differ localises the mismatch to content; an unequal pair localises it
        # to truncation on read.
        #
        # Lengths ALONE were not enough, and that cost a full Stage-2 lane a day.
        # Measured 2026-09-12 on macOS the verdict read
        # `receipt-content-mismatch:expected-bytes=1648:actual-bytes=1648` --
        # true, and actionable by nobody. The receipt is five fixed lines
        # (header / capsule-identity / object-path / size / content-hash), so
        # naming the first differing LINE names the failing FIELD directly,
        # which a byte offset does not. The real culprit was line 4, the size,
        # which held a heap address rather than a byte count. Values are quoted
        # so an equal-length difference is visible.
        val first_difference = _driver_receipt_first_difference_v1(expected, actual)
        return "receipt-content-mismatch:expected-bytes={expected.len()}:actual-bytes={actual.len()}:{first_difference}"
    ""

fn _driver_receipt_first_difference_v1(expected: text, actual: text) -> text:
    """Name the first receipt LINE that differs, with both values.

    The receipt's line index is its field name, so this is the diagnostic an
    operator can act on. Returns a `line-count` verdict instead when the two
    texts differ only in how many lines they carry.
    """
    val expected_lines = expected.split("\n")
    val actual_lines = actual.split("\n")
    var index = 0
    while index < expected_lines.len() and index < actual_lines.len():
        if expected_lines[index] != actual_lines[index]:
            val line_number = index + 1
            val expected_value = expected_lines[index]
            val actual_value = actual_lines[index]
            return "first-diff-line={line_number}:expected={expected_value}:actual={actual_value}"
        index = index + 1
    "first-diff-line-count:expected={expected_lines.len()}:actual={actual_lines.len()}"

pub fn driver_native_capsule_result_valid_v1(capsule: FrozenNativeModuleCapsuleV1) -> bool:
    driver_native_capsule_result_reason_v1(capsule) == ""

# The owner-only cache checkpoint is the ONE failure path in this file that never
# printed anything: `_compile_selected_module` routes its failures through
# `_aot_compile_failure` (which prints at the raising site), but a capsule that
# COMPILED fine and then failed collection returned a bare tag to a caller that
# only stored it. Measured 2026-09-06 on the rejected stage-2: the object file and
# its capsule-receipt were both produced on disk, so the compile succeeded and the
# build still failed -- with the summary saying "(none recorded)", because the
# stored tag arrived empty. Print here for the same reason `_aot_compile_failure`
# prints: a diagnostic that only travels by return value is lost exactly when it
# is needed. Literal line first (nothing can silence it), then the tag and the
# detail BARE, so a collapsed interpolation localises rather than erases.
fn _collect_failure(module_name: text, tag: text, detail: text) -> text:
    print "error: native capsule collection failed -- module, tag and detail follow"
    _sffi_stdout_flush()
    print module_name
    print tag
    print detail
    _sffi_stdout_flush()
    print "error:   tag-len={tag.len()} detail-len={detail.len()}"
    _sffi_stdout_flush()
    "{tag}:{module_name}: {detail}"

pub fn driver_native_collect_capsule_result_v1(
    batch: FrozenNativeModuleCapsuleBatchV1, build_cache: BuildCache,
    module_name: text, object_path: text
) -> text:
    """Owner-only authenticated cache checkpoint for one completed capsule."""
    val capsule = frozen_native_capsule_batch_find_v1(batch, module_name)
    if not capsule.ok or object_path != capsule.object_path:
        return _collect_failure(module_name, "native-capsule-result-mismatch",
            "capsule-ok={capsule.ok} produced={object_path}"
                + " capsule-object={capsule.object_path}")
    # The two failing sub-conditions are reported SEPARATELY and both hashes
    # are quoted. The old form collapsed "the frozen identity was never
    # recorded" and "the file on disk changed since parse" into one opaque
    # `native-capsule-source-mutated:<module>` string with no inputs, so a
    # full Stage-2 bootstrap could only report that hello world failed and
    # nothing about WHY. Naming which invariant fired, and printing the two
    # digests plus the path each was computed from, is the same fail-closed
    # rule with a diagnosable verdict -- nothing is relaxed.
    if capsule.cache_source != "":
        if capsule.source_identity == "":
            return _collect_failure(module_name, "native-capsule-source-mutated",
                "frozen-identity-absent"
                    + " cache-source={capsule.cache_source}")
        # The digest of the EMPTY string is never a legitimate source identity:
        # it means the capture hashed content that had already been reclaimed.
        # Name that separately -- reported as a mutation it sent three Stage-2
        # lanes chasing a file that was never touched.
        if driver_native_capsule_identity_empty_v1(capsule.source_identity):
            return _collect_failure(module_name, "capsule-identity-empty",
                "frozen identity is the digest of empty content"
                    + " cache-source={capsule.cache_source}")
        val disk_identity = driver_native_disk_source_identity(capsule.cache_source)
        if disk_identity != capsule.source_identity:
            return _collect_failure(module_name, "native-capsule-source-mutated",
                "cache-source={capsule.cache_source}"
                    + " capsule-identity={capsule.source_identity}"
                    + " disk-identity={disk_identity}")
    val receipt_reason = driver_native_capsule_result_reason_v1(capsule)
    if receipt_reason != "":
        return _collect_failure(module_name, "native-capsule-receipt-invalid",
            receipt_reason)
    if capsule.cache_source == "": return ""
    val source_fp = FileFingerprint.from_file(capsule.cache_source)
    if val source_fp_val = source_fp:
        build_cache.update_entry(capsule.cache_source, source_fp_val,
            [], [object_path], capsule.module_witness)
        build_cache.save()
        return ""
    _collect_failure(module_name, "native-capsule-fingerprint-failed",
        "FileFingerprint.from_file returned nil for {capsule.cache_source}")

pub fn driver_native_capsule_inputs_valid_v1(
    capsule: FrozenNativeModuleCapsuleV1, backend_name: text, target: text,
    is_release: bool, opt_level: i64, provider_receipt_hash: text = ""
) -> bool:
    capsule.identity_valid() and capsule.backend_name == backend_name
        and capsule.target == target and capsule.opt_level == opt_level
        and capsule.is_release == is_release
        and capsule.provider_receipt_hash == provider_receipt_hash

fn driver_native_leading_spaces(line: text) -> i64:
    var i: i64 = 0
    val n = line.len()
    while i < n and line.char_code_at(i) == 32:
        i = i + 1
    i

fn driver_native_count_char(s: text, code: i64) -> i64:
    var count: i64 = 0
    var i: i64 = 0
    val n = s.len()
    while i < n:
        if s.char_code_at(i) == code:
            count = count + 1
        i = i + 1
    count

fn driver_native_is_def_start(trimmed: text) -> bool:
    # Ordered so more-specific modifier prefixes are checked before the bare
    # "fn "/"me " fallback (a modifier prefix does not itself start with
    # "fn " or "me ", so order between the two groups does not matter, but
    # listing the longer forms first keeps intent obvious).
    (trimmed.starts_with("extern fn ") or trimmed.starts_with("pub async fn ") or
        trimmed.starts_with("pub static fn ") or trimmed.starts_with("pub fn ") or
        trimmed.starts_with("static fn ") or trimmed.starts_with("async fn ") or
        trimmed.starts_with("fn ") or trimmed.starts_with("pub me ") or
        trimmed.starts_with("me "))

pub fn driver_native_source_interface_text(content: text) -> text:
    """Extract the public-interface surface of a module's source: struct /
    enum / bitfield / class / trait / impl headers, field and variant lines,
    use/export/extern/const lines, and function/method SIGNATURE lines --
    with function and method BODIES dropped.

    Used to build the native-build cache-scope fingerprint so a body-only
    edit (behaviour change with no ABI-visible change) does not evict every
    OTHER module's cached object, while still failing closed: any change to
    a struct/enum layout, a function/method signature, or a use/export line
    anywhere in the loaded closure still changes this text and therefore
    still evicts the whole scope, exactly like the previous whole-file-content
    fingerprint. The module's OWN object is independently gated by
    BuildCache's per-source FileFingerprint (full file content hash, see
    incremental.spl), so a body-only edit to THIS module still forces a
    rebuild of THIS module's object -- only siblings are spared.

    A function/method signature's extent is tracked by parenthesis balance
    (not "ends with a bare fn keyword") so both single-line and wrapped
    multi-line parameter lists are captured in full: once parens rebalance,
    a trailing ":" means a block (body) follows and gets skipped up to the
    next line at or above the signature's own indent; no trailing ":" means
    a bodyless declaration (extern fn, trait method stub) and nothing is
    skipped. Any line this heuristic fails to recognize as pure body content
    is captured (over-inclusion), never dropped (under-inclusion) -- the
    failure mode is "fingerprint changes when it didn't strictly need to"
    (a safe, if coarser, cache miss), never "fingerprint stayed the same
    when the ABI changed" (unsound stale reuse).
    """
    val lines = content.split("\n")
    var out: [text] = []
    var mode_capturing_sig = false
    var sig_indent: i64 = 0
    var paren_depth: i64 = 0
    var skip_until_indent: i64 = -1
    # Perf (2026-08-21): the per-line helpers (leading_spaces / count_char)
    # are inlined here on purpose. Under the seed interpreter every
    # intra-module call rebuilds/clones the owner env (~0.3 ms in a driver
    # module with thousands of imported globals), and this function runs
    # over every line of every source in the closure (~1M lines): three
    # helper calls per line made the fingerprint phase take 543 s for 942
    # sources (measured stage-1 build). Inline loops over builtin
    # char_code_at pay no such per-call tax.
    for line in lines:
        val trimmed = line.trim()
        if mode_capturing_sig:
            out = out.push(line)
            var ci: i64 = 0
            val cn = trimmed.len()
            while ci < cn:
                val cc = trimmed.char_code_at(ci)
                if cc == 40:
                    paren_depth = paren_depth + 1
                elif cc == 41:
                    paren_depth = paren_depth - 1
                ci = ci + 1
            if paren_depth <= 0:
                mode_capturing_sig = false
                if trimmed.ends_with(":"):
                    skip_until_indent = sig_indent
            continue
        if skip_until_indent >= 0:
            if trimmed == "":
                continue
            var indent: i64 = 0
            val ln = line.len()
            while indent < ln and line.char_code_at(indent) == 32:
                indent = indent + 1
            if indent > skip_until_indent:
                continue
            skip_until_indent = -1
            # fall through: this line is at/above the signature's indent,
            # so it is the next real declaration, not part of the body.
        if trimmed == "":
            out = out.push(line)
            continue
        if driver_native_is_def_start(trimmed):
            out = out.push(line)
            var si: i64 = 0
            val sn = line.len()
            while si < sn and line.char_code_at(si) == 32:
                si = si + 1
            sig_indent = si
            paren_depth = 0
            var pi: i64 = 0
            val pn = trimmed.len()
            while pi < pn:
                val pc = trimmed.char_code_at(pi)
                if pc == 40:
                    paren_depth = paren_depth + 1
                elif pc == 41:
                    paren_depth = paren_depth - 1
                pi = pi + 1
            if paren_depth <= 0:
                if trimmed.ends_with(":"):
                    skip_until_indent = sig_indent
            else:
                mode_capturing_sig = true
            continue
        out = out.push(line)
    out.join("\n")

pub fn driver_native_sources_fingerprint(sources: [SourceFile]) -> text:
    # Interface-surface closure: hashes only the ABI-visible portion of each
    # loaded source (see driver_native_source_interface_text) rather than the
    # entire file, so a body-only edit to one module does not change this
    # fingerprint and therefore does not evict every OTHER module's cached
    # object from the scope directory named by this hash. A change to any
    # struct/enum/signature/use/export line anywhere in the closure still
    # changes the fingerprint and evicts the whole scope -- same fail-closed
    # behaviour as before, just scoped to the part that can actually affect
    # dependents. The edited module's OWN object is independently gated by
    # BuildCache's full-file-content FileFingerprint, so body-only edits to
    # THIS module still force a rebuild of THIS module's object.
    # Hash content into compact length-prefixed rows so the pass stays linear
    # and path/module boundaries are unambiguous. Source order changes only
    # cause a safe cache miss.
    var rows: [text] = []
    var fp_idx = 0
    # PERF (2026-08-28): `sources` carries one entry per LOGICAL module name,
    # and symlinked layouts (src/std -> lib, src/compiler/frontend ->
    # 10.frontend, ...) alias the same physical file under several names
    # (1012 logical / 717 physical in the bootstrap closure). The interface
    # extraction + hash depends only on `source.content`, so memoise it per
    # (path, content length) and reuse the row tail for every alias. The
    # emitted manifest is byte-identical to the unmemoised form: a hit
    # requires the same path AND the same content length, and within one
    # build a path's content is read exactly once (_driver_cached_entry_source_scan).
    # contains_key + index read, never `.get()`.
    # See doc/07_guide/language/dict_native_pitfalls.md
    var iface_memo: Dict<text, text> = {}
    for source in sources:
        if fp_idx % 32 == 0:
            log_phase("phase1:fingerprint:source idx={fp_idx} of={sources.len()} path={source.path} bytes={source.content.len()}")
        fp_idx = fp_idx + 1
        val memo_key = "{source.content.len()}:{source.path}"
        var row_tail = ""
        if iface_memo.contains_key(memo_key):
            row_tail = iface_memo[memo_key]
        else:
            val interface_text = driver_native_source_interface_text(source.content)
            val content_hash = _sffi_hash_text(interface_text)
            row_tail = "{interface_text.len()}:{content_hash}"
            iface_memo[memo_key] = row_tail
        rows = rows.push("{source.path.len()}:{source.path}{source.module_name.len()}:{source.module_name}{row_tail}")
    val manifest = rows.join("\n")
    "{_sffi_hash_text(manifest)}n{sources.len()}"

pub fn driver_native_module_is_export_facade(mir: MirModule, parsed_module: ParserModule?) -> bool:
    if mir.functions.keys().len() > 0 or mir.statics.keys().len() > 0 or mir.constants.keys().len() > 0 or mir.types.keys().len() > 0:
        return false
    if parsed_module == nil:
        return false
    val parsed = parsed_module
    # Extern-only declaration modules (e.g. std.nogc_sync_mut.env.types: only
    # `extern fn rt_env_*` + export) legitimately lower to a MIR module with
    # zero functions — the externs resolve at link time. Treat them like the
    # bodyless facades below instead of failing "MIR module has no functions".
    # A module with any NON-extern parsed function still hard-fails there:
    # HIR had bodies, so an empty MIR is a real lowering bug and must stay
    # loud (bug bootstrap_stage2_empty_mir_bodies_2026-07-05).
    var only_extern_functions = true
    for fn_name in parsed.functions.keys():
        val parsed_fn = parsed.functions[fn_name]
        if not parsed_fn.is_extern:
            only_extern_functions = false
    # `export use backend.{...}` facades produce an ParserImport record but NO
    # Export record in the flat bridge (only bare `export a, b` emits one),
    # e.g. std.nogc_async_mut.env.types — accept import-only and trait-only
    # modules too; neither has standalone code by the decl checks below.
    ((parsed.exports.len() > 0 or parsed.imports.len() > 0 or parsed.traits.len() > 0) and parsed.domain_blocks.len() == 0 and
        only_extern_functions and parsed.classes.len() == 0 and parsed.actors.len() == 0 and
        parsed.structs.len() == 0 and parsed.enums.len() == 0 and parsed.bitfields.len() == 0 and
        parsed.impls.len() == 0 and parsed.type_aliases.len() == 0 and
        parsed.constants.len() == 0 and parsed.static_asserts.len() == 0 and
        parsed.aop_advices.len() == 0 and parsed.di_bindings.len() == 0 and
        parsed.arch_rules.len() == 0 and parsed.mock_decls.len() == 0)

fn driver_native_build_filter_scoped_outputs(cached_outputs: [text], cache_scope_root: text) -> ([text], bool):
    var scoped_outputs: [text] = []
    var all_in_scope = true
    for obj in cached_outputs:
        if obj.starts_with(cache_scope_root + "/"):
            scoped_outputs = scoped_outputs.push(obj)
        else:
            all_in_scope = false
    (scoped_outputs, all_in_scope)

fn _extract_driver_ctx(driver: CompilerDriver) -> CompileContext:
    driver.ctx

fn driver_native_launch_trailer_magic() -> [u8]:
    # "SIMPLE_LAUNCH_V1" = 16 bytes.
    [83, 73, 77, 80, 76, 69, 95, 76, 65, 85, 78, 67, 72, 95, 86, 49]

fn driver_render_native_launch_metadata(ctx: CompileContext) -> text:
    val target = Target.host()
    "simple_launch_metadata:\n" +
        "  entry_kind: \"native\"\n" +
        "  target_os: \"" + target.os + "\"\n" +
        "  target_arch: \"" + target.arch + "\"\n" +
        "  target_abi: \"native\"\n" +
        "  uses_arg_parser: false\n" +
        "  mmap_hint: false\n"

fn driver_native_launch_metadata_trailer(ctx: CompileContext) -> [u8]:
    val payload = driver_render_native_launch_metadata(ctx).bytes()
    var out: [u8] = []
    out = out.concat(payload)
    out = out.concat(smf_u64_to_bytes(payload.len()))
    out = out.concat(driver_native_launch_trailer_magic())
    out

fn driver_native_success_with_launch_metadata(ctx: CompileContext, output: text) -> CompileResult:
    # Native launch metadata is optional. Keep native-build self-hostable even
    # when the byte-range file API is unavailable in the pure Simple runtime.
    CompileResult.Success(output)

# ============================================================================
# Unimplemented-extern link diagnostic
# ============================================================================
#
# An `extern fn` that nothing implements is a CORRECTNESS-clean failure on the
# native lane -- the link fails, no binary is produced, exit 1 -- but the only
# user-visible text used to be raw linker output:
#
#   error: LLVM native linking failed: Linking failed: cc linking failed:
#   ld.lld: error: undefined symbol: lane_definitely_absent_probe
#
# which names a mangled object file, not the DECLARATION the developer wrote,
# and which the native-build entry's stderr truncation can hide entirely.
# The interpreter lane already says `semantic: unknown extern function: X`;
# these helpers give the native lane an equivalent compiler-level message
# WITHOUT swallowing the raw linker output, which stays appended verbatim.
#
# Why this maps AFTER the link rather than checking before it: on this lane an
# extern's implementation may legitimately come from any of several link
# inputs that only exist at link time -- the freshly compiled C runtime
# objects, libsimple_native_all.a, or an external provider archive configured
# via llvm_configured_external_link_objects. Deciding "implemented nowhere"
# before the link would mean re-running nm over every one of those inputs and
# reimplementing archive-member resolution, i.e. redoing the linker's own job
# less accurately. The linker already computes the exact answer; this only
# translates its symbol name back to the declaration site.

fn driver_native_link_symbol_token(payload: text) -> text:
    val head = payload.split(" ")[0]
    head.replace("`", "").replace("'", "").replace("\"", "").replace(",", "").replace(";", "").trim()

pub fn driver_native_link_undefined_symbols(err: text) -> [text]:
    """Extract undefined-symbol names from linker stderr (lld and GNU ld)."""
    var names: [text] = []
    for line in err.split("\n"):
        val trimmed = line.trim()
        var payload = ""
        if trimmed.contains("undefined symbol: "):
            val parts = trimmed.split("undefined symbol: ")
            if parts.len() > 1:
                payload = parts[parts.len() - 1].trim()
        elif trimmed.contains("undefined reference to "):
            val parts = trimmed.split("undefined reference to ")
            if parts.len() > 1:
                payload = parts[parts.len() - 1].trim()
        if payload == "":
            continue
        val name = driver_native_link_symbol_token(payload)
        if name == "":
            continue
        var seen = false
        for existing in names:
            if existing == name:
                seen = true
        if not seen:
            names = names.push(name)
    names

pub fn driver_native_extern_decl_matches(rest: text, name: text) -> bool:
    """`rest` is a declaration line with the leading `extern fn ` removed."""
    if not rest.starts_with(name):
        return false
    if rest.len() == name.len():
        return true
    val tail = rest.substring(name.len(), name.len() + 1)
    tail == "(" or tail == " " or tail == ":" or tail == "<"

pub fn driver_native_extern_decl_site_in(content: text, shown_path: text, name: text) -> text:
    """Locate `extern fn <name>` inside ONE source's text; "" when not found.

    Pure: no I/O, no CompileContext. This is the whole `file:line` half of the
    diagnostic, split out so it is reachable without a native build.
    """
    if content == "" or not content.contains("extern fn " + name):
        return ""
    var line_no = 0
    for line in content.split("\n"):
        line_no = line_no + 1
        val trimmed = line.trim()
        if not trimmed.starts_with("extern fn "):
            continue
        if driver_native_extern_decl_matches(trimmed.substring(10, trimmed.len()), name):
            return "{shown_path}:{line_no}"
    ""

fn driver_native_extern_decl_site(ctx: CompileContext, name: text) -> text:
    """Locate `extern fn <name>` in the loaded sources; "" when not found.

    Source CONTENT may already be evicted (CompileContext.evict_sources keeps
    only path metadata), so re-read from disk when the in-memory copy is empty.
    """
    for source in ctx.sources:
        var content = source.content
        if content == "" and source.path != "" and _sffi_file_exists(source.path):
            content = _sffi_file_read_text(source.path) ?? ""
        val shown = if source.authored_path != "": source.authored_path else: source.path
        val site = driver_native_extern_decl_site_in(content, shown, name)
        if site != "":
            return site
    ""

fn driver_native_link_failure_result(ctx: CompileContext, kind: text, err: text) -> CompileResult:
    """Render a link failure, upgrading undefined-symbol errors that name a
    declared `extern fn` into a compiler-level diagnostic. The original linker
    text is ALWAYS preserved verbatim at the end -- never swallowed."""
    val names = driver_native_link_undefined_symbols(err)
    var sites: [text] = []
    for name in names:
        sites = sites.push(driver_native_extern_decl_site(ctx, name))
    CompileResult.CodegenError(driver_native_link_failure_message(kind, err, names, sites))

pub fn driver_native_link_failure_message(kind: text, err: text, names: [text], sites: [text]) -> text:
    """Assemble the link-failure diagnostic text. Pure.

    `names[i]` is an undefined symbol from the linker output and `sites[i]` its
    `extern fn` declaration site, or "" when the symbol is not a declared
    extern. When NO name resolves to a declaration the raw linker text is
    passed through unrewritten -- an unrelated link failure (`cannot find
    -lfoo`) must never be reported as an extern problem. Otherwise the raw text
    is still appended verbatim at the end, never swallowed."""
    var found: [text] = []
    var i = 0
    for name in names:
        val site = if i < sites.len(): sites[i] else: ""
        i = i + 1
        if site != "":
            # Keep the literal "error:" on THIS line: native_build_main's
            # eprint_bounded preserves only diagnostic-looking LINES through
            # stderr truncation, so a bare continuation line would be the
            # first thing dropped -- taking the declaration site with it.
            found = found.push("  error: extern fn {name} is declared but not implemented anywhere -- declared at {site}")
    if found.len() == 0:
        return "{kind}: {err}"
    var out = "{kind}: unimplemented extern function(s)\n"
    for entry in found:
        out = out + entry + "\n"
    out = out + "  An `extern fn` needs a definition in something the link sees: the C/Rust\n"
    out = out + "  runtime, an external provider archive, or an implementation in this program.\n"
    out = out + "  raw linker output follows (preserved for debugging):\n"
    out + err

pub fn compile_bootstrap_context_to_native(ctx: CompileContext, backend_name: text, output: text) -> CompileResult:
    """Bootstrap-stable native output path.

    Stage1-generated compilers can crash dispatching the cross-module
    `CompilerDriver.compile_to_native` extension method. Keep the bootstrap lane
    on a plain function that takes the already-available context.
    """
    val storage_identity = ctx.freeze_storage_registry()
    if storage_identity == "invalid":
        return CompileResult.CodegenError(
            "typed storage registry is malformed before bootstrap native compile")
    val is_release = ctx.options.release
    val driver_opt_level = driver_effective_native_opt_level(ctx, is_release)
    val trace = (env_get_nullable("SIMPLE_COMPILER_TRACE") ?? "") == "1"
    if trace:
        print "[NATIVE] bootstrap direct backend_name={backend_name}, is_release={is_release}"
    val effective_backend = get_effective_backend_name(backend_name, is_release)
    if trace:
        print "[NATIVE] bootstrap direct effective_backend={effective_backend}"

    val entry_module_name = bootstrap_entry_module_name(ctx)
    val capsules = ctx.freeze_native_module_capsules_v1([entry_module_name],
        output, backend_name, "", env_get_nullable("SIMPLE_NATIVE_CPU") ?? "",
        driver_opt_level, is_release)
    if not capsules.ok:
        return CompileResult.CodegenError(capsules.reason)
    val direct_result = _compile_frozen_module_capsule(capsules, backend_name,
        "", is_release, driver_opt_level, "", nil, entry_module_name)
    match direct_result:
        case Ok(obj_path):
            if effective_backend == "llvm" or effective_backend == "llvm-lib":
                val llvm_opts = NativeLinkOptions(
                    debug: ctx.options.debug_info,
                    verbose: ctx.options.verbose,
                    pie: true,
                    bare_metal: false,
                    opt_level: driver_opt_level,
                    stage4_backend: effective_backend,
                    stage4_compiler_hash: native_build_compiler_identity(),
                    target_triple: ctx.native_target
                )
                match link_llvm_native([obj_path], output, llvm_opts):
                    case Ok(_):
                        return driver_native_success_with_launch_metadata(ctx, output)
                    case Err(e):
                        return driver_native_link_failure_result(ctx, "LLVM native linking failed", e)
            val hosted_opts = NativeLinkOptions(
                debug: ctx.options.debug_info,
                strip_output: ctx.options.strip_output,
                verbose: ctx.options.verbose,
                pie: true,
                bare_metal: false,
                opt_level: driver_opt_level,
                stage4_backend: effective_backend,
                stage4_compiler_hash: native_build_compiler_identity(),
                target_triple: ctx.native_target
            )
            match link_llvm_native([obj_path], output, hosted_opts):
                case Ok(_):
                    return driver_native_success_with_launch_metadata(ctx, output)
                case Err(e):
                    return driver_native_link_failure_result(ctx, "Hosted native linking failed", e)
        case Err(e):
            return CompileResult.CodegenError(e)

impl CompilerDriver:
    me compile_to_native(output: text) -> CompileResult:
        val ctx: CompileContext = _extract_driver_ctx(self)
        val backend_name = ctx.options.backend
        val is_release = ctx.options.release
        val driver_opt_level = driver_effective_native_opt_level(ctx, is_release)
        val native_target = ctx.native_target
        val native_cpu = env_get_nullable("SIMPLE_NATIVE_CPU") ?? ""
        if driver_aot_uses_versioned_backend(backend_name):
            val request = driver_aot_backend_plugin_request_v1(
                backend_name, native_target, native_cpu, driver_opt_level,
                ctx.options.backend_plugin_path)
            match load_backend(request):
                case Err(error):
                    return CompileResult.CodegenError(
                        driver_backend_plugin_error_text(error))
                case Ok(loaded_session):
                    var session = loaded_session
                    val result = self._compile_to_native_with_backend_session(
                        output, Some(session), native_target, native_cpu)
                    if not session.close():
                        return CompileResult.CodegenError(
                            "BACKEND_PLUGIN_TEARDOWN_FAILED: backend session close failed")
                    return result
        self._compile_to_native_with_backend_session(
            output, nil, native_target, native_cpu)

    me _compile_to_native_with_backend_session(
        output: text,
        backend_session: BackendSession?,
        native_target: text,
        native_cpu: text
    ) -> CompileResult:
        val ctx: CompileContext = _extract_driver_ctx(self)
        val log = ctx.logger
        val backend_name = ctx.options.backend
        val is_release = ctx.options.release
        val driver_opt_level = driver_effective_native_opt_level(ctx, is_release)
        val stage4_requested = (env_get_nullable("SIMPLE_BOOTSTRAP_STAGE4") ?? "") == "1"
        val native_output_mode = env_get_nullable("SIMPLE_NATIVE_BUILD_EMIT_OBJECT") ?? ""
        val emit_object_requested = native_output_mode == "1"
        val emit_archive_requested = native_output_mode == "archive"
        val emit_shared_requested = native_output_mode == "shared"
        val no_mangle_requested = (env_get_nullable("SIMPLE_NATIVE_BUILD_NO_MANGLE") ?? "") == "1"
        if stage4_requested and (emit_object_requested or emit_archive_requested or emit_shared_requested):
            return CompileResult.CodegenError("Stage4 strict profile does not support object, archive, or shared output")
        val trace = (env_get_nullable("SIMPLE_COMPILER_TRACE") ?? "") == "1"
        if trace:
            print "[NATIVE] backend_name={backend_name}, is_release={is_release}"
        val effective_backend = if val session = backend_session:
            session.request.backend_name
        else:
            get_effective_backend_name(backend_name, is_release)
        val provider_receipt_hash = if val session = backend_session:
            session.receipt.hash()
        else:
            ""
        if trace:
            print "[NATIVE] effective_backend={effective_backend}"

        # Load build cache
        val cache_dir = driver_native_build_cache_dir()
        if not _sffi_dir_create(cache_dir, true):
            return CompileResult.CodegenError(
                "native-build failed to create cache directory {cache_dir}")
        val darwin_native_build = native_target.ends_with("-apple-darwin") or
            (native_target == "" and get_host_os() == "macos")
        if darwin_native_build and provider_receipt_hash == "":
            return CompileResult.CodegenError(
                "native-build Darwin provider provenance receipt is required")
        val native_provider_identity = provider_receipt_hash
        if not _sffi_file_write_text(
            _sffi_path_join(cache_dir, "native_provider_identity.receipt"),
            "simple-native-provider-identity-v1\nbackend=" + effective_backend +
                "\nprovider=" + native_provider_identity + "\n"
        ):
            return CompileResult.CodegenError(
                "native-build failed to publish provider identity receipt")
        val symbol_mode = if no_mangle_requested: "no-mangle" else: ""
        val storage_identity = ctx.freeze_storage_registry()
        if storage_identity == "invalid":
            return CompileResult.CodegenError(
                "typed storage registry is malformed before cache setup")
        val module_cache_config = NativeModuleConfigFactV1(
            compiler_identity: native_build_compiler_identity(),
            target_identity: "{native_target}|cpu={native_cpu}",
            options_identity: "backend={effective_backend}|opt={driver_opt_level}|release={is_release}|symbols={symbol_mode}|storage={sha256_text(storage_identity)}",
            provider_identity: provider_receipt_hash)
        val (base_cache_scope_root, _) = driver_native_build_cache_scope(
            effective_backend, cache_dir, native_target, native_cpu,
            driver_opt_level, symbol_mode, storage_identity,
            provider_receipt_hash)
        if ctx.native_sources_fingerprint == "":
            return CompileResult.CodegenError(
                "native build source fingerprint missing before cache setup")
        val sources_fingerprint = ctx.native_sources_fingerprint
        # Keep the object root stable across closure revisions. Cache hits below
        # are admitted only by the complete per-module witness (own parsed
        # source/MIR, dependencies, resolutions, external layouts, target,
        # options, and provider), so partitioning by the coarse closure digest
        # merely hid safe reusable objects before their witness could be read.
        # The closure digest remains comparison/diagnostic metadata.
        val cache_scope_root = base_cache_scope_root
        # --clean requested a clean build: drop this entry's cache scope so no
        # previously compiled object in this scope can be reused. Consume the
        # flag (clear the env) so it applies to this build only.
        if (env_get_nullable("SIMPLE_NATIVE_BUILD_CLEAN") ?? "") == "1":
            if not _sffi_dir_remove_all(base_cache_scope_root):
                return CompileResult.CodegenError(
                    "native-build failed to remove clean cache scope {base_cache_scope_root}")
            if not env_set("SIMPLE_NATIVE_BUILD_CLEAN", ""):
                return CompileResult.CodegenError(
                    "native-build failed to consume SIMPLE_NATIVE_BUILD_CLEAN")
        if not _sffi_dir_create(cache_scope_root, true):
            return CompileResult.CodegenError(
                "native-build failed to create cache scope {cache_scope_root}")
        # Phase marker: frontend parsing + MIR construction already completed
        # (compile_to_native is only reached after that phase finishes), so a
        # killed run that leaves this file behind proves it died in codegen,
        # not frontend. See doc/08_tracking/bug/simpleos_harness_silent_native_build_2026-07-26.md.
        if not _sffi_file_write_text(
            _sffi_path_join(cache_scope_root, "phase.marker"),
            "frontend-done, codegen-started\n"):
            return CompileResult.CodegenError(
                "native-build failed to write cache phase marker")
        # Lane ownership marker: records which private-cache lane last wrote this
        # scope so a SCRIPT can check ownership without running a compiler (see
        # scripts/check/check-cache-scope-ownership.shs). Reuse itself is already
        # partitioned by the scope DIRECTORY, which now carries `lane=`.
        if not _sffi_file_write_text(
            _sffi_path_join(base_cache_scope_root, ".cache_scope"),
            "lane={native_build_cache_lane()}\n"):
            return CompileResult.CodegenError(
                "native-build failed to write cache ownership marker")
        val cache_path = driver_native_build_cache_path(cache_dir)
        val object_base = _sffi_path_join(cache_scope_root, "object")
        var build_cache: BuildCache = BuildCache.load(cache_path)
        val phase2_compatibility_manifest =
            driver_load_phase2_compatibility_manifest_v1()
        var phase2_native_items_handled: {text: bool} = {}
        var phase2_native_reuse_hits: i64 = 0
        var phase2_native_rejections: i64 = 0
        var cache_hit_count: i64 = 0
        var cache_miss_count: i64 = 0
        var witness_shadow_match_count: i64 = 0
        var witness_shadow_mismatch_count: i64 = 0
        var witness_shadow_mismatch_lines: [text] = []

        # Compile all modules and collect object files
        var object_files: [text] = []

        # NOT `ctx.options.low_memory` on its own: under `--output-format both`
        # compile_to_smf runs after this function over the SAME ctx and
        # re-iterates ctx.mir_modules, so evicting here silently produced an
        # empty/partial .smf. See driver_mir_eviction_enabled for the full
        # reasoning (bootstrap_stage4_selfhost_parse_memory_blowup_2026-07-20,
        # hazard 3).
        val low_memory = driver_mir_eviction_enabled(ctx.options.low_memory, ctx.options.output_format)
        val module_names = ctx.mir_modules.keys()
        val total_modules = module_names.len()
        if trace:
            print "[NATIVE] compiling {total_modules} modules..."
            _sffi_stdout_flush()

        # Guard (bug #119): refuse empty mir_modules. A requested --entry that
        # produces no modules is likely a misconfiguration (isolated entry with
        # zero imports). Hard-error instead of silently falling back to bootstrap_main.
        if total_modules <= 0:
            val entry_hint = if ctx.options.input_files.len() > 0:
                " (input: {ctx.options.input_files[0]})"
            else:
                ""
            return CompileResult.CodegenError("native-build produced empty mir_modules{entry_hint} — no modules loaded. Try adding an import (use std.text) or using the standard entry point.")

        if total_modules > 1000000:
            return CompileResult.CodegenError("native-build mir_modules exceeds sanity limit (1000000 modules)")

        # Collect-all accumulator. A per-module failure records an outcome and the
        # loop moves on, so ONE build names EVERY bad module instead of dying on
        # the first — every defect used to cost a full ~20-minute bootstrap run to
        # find. The two guards above (empty mir_modules, the 1000000 sanity limit)
        # are whole-BUILD guards, not per-module failures, and stay immediate.
        # See doc/02_requirements/compiler/supervised_builder.md R2/R3/R4.
        var module_outcomes = BuildOutcomeSet.empty()
        # Stable within one build; lets the attribution line name a unit even
        # when its path is ambiguous.
        var module_unit_id: i64 = 0

        # Phase 1: Check cache, collect cached objects, identify uncached modules
        var uncached_names: [text] = []
        var progress_cache_scanned = 0
        log_build_progress("native_cache", "modules", 0, total_modules,
            "pending", 5, 6, 0, 0, "running")
        for name in module_names:
            progress_cache_scanned = progress_cache_scanned + 1
            # ParserImport/export facades contribute symbols through their imported
            # implementation modules and have no object code of their own.
            if ctx.modules.has(name) and driver_native_module_is_export_facade(ctx.mir_modules[name], ctx.modules[name]):
                continue
            val cache_source = driver_native_module_cache_source(ctx, name)
            var used_cache = false
            if cache_source != "":
                val source_identity = driver_native_module_source_identity(ctx, name)
                val source_snapshot_matches = source_identity != ""
                    and driver_native_disk_source_identity(cache_source) ==
                        source_identity
                val (expected_witness, expected_witness_reason) =
                    driver_native_shadow_witness_v1(
                        ctx, name, ctx.mir_modules[name], module_cache_config)
                if phase2_compatibility_manifest.? and source_snapshot_matches and
                        expected_witness_reason == "ok" and expected_witness != "":
                    var candidate_witnesses: {text: text} = {}
                    candidate_witnesses[name] = expected_witness
                    var candidate_witness_reasons: {text: text} = {}
                    candidate_witness_reasons[name] = expected_witness_reason
                    val candidate_capsules = ctx.freeze_native_module_capsules_v1(
                        [name], object_base, effective_backend, native_target,
                        native_cpu, driver_opt_level, is_release,
                        provider_receipt_hash, candidate_witnesses,
                        candidate_witness_reasons)
                    if candidate_capsules.ok:
                        val candidate_capsule = candidate_capsules.find(name)
                        if candidate_capsule.ok:
                            val (materialized, handled_path) =
                                driver_materialize_phase2_native_v1(
                                    phase2_compatibility_manifest.unwrap(),
                                    cache_source, expected_witness,
                                    candidate_capsule, module_cache_config,
                                    cache_scope_root, build_cache)
                            if handled_path != "":
                                phase2_native_items_handled[handled_path] = true
                                if materialized:
                                    phase2_native_reuse_hits = phase2_native_reuse_hits + 1
                                else:
                                    phase2_native_rejections = phase2_native_rejections + 1
                val recorded_witness = build_cache_module_witness(
                    build_cache, cache_source)
                val witness_reason = if not source_snapshot_matches:
                    "source-mutated-since-parse"
                elif expected_witness_reason != "ok":
                    expected_witness_reason
                elif expected_witness == "":
                    "expected-unavailable"
                else:
                    native_module_cache_shadow_mismatch_v1(
                        recorded_witness, expected_witness)
                if witness_reason == "match":
                    witness_shadow_match_count = witness_shadow_match_count + 1
                else:
                    witness_shadow_mismatch_count = witness_shadow_mismatch_count + 1
                    if witness_shadow_mismatch_lines.len() < NATIVE_MODULE_CACHE_SHADOW_MISMATCH_LIMIT:
                        witness_shadow_mismatch_lines.push(
                            "module={driver_native_shadow_bounded_module(name)} reason={witness_reason}")
                val cached_outputs = if (source_snapshot_matches and
                    witness_reason == "match"):
                    build_cache.get_cached_outputs(cache_source)
                else:
                    nil
                if cached_outputs.?:
                    val all_outputs = cached_outputs.unwrap()
                    val (scoped_outputs, all_in_scope) = driver_native_build_filter_scoped_outputs(all_outputs, cache_scope_root)
                    # A hit also requires every cached object to still exist on
                    # disk (a --clean scope wipe or manual cache deletion leaves
                    # stale build_cache.sdn entries behind).
                    var outputs_exist = true
                    for obj in scoped_outputs:
                        if not _sffi_file_exists(obj):
                            outputs_exist = false
                    # The interface-only scope witness deliberately preserves
                    # sibling hits for body-only edits. It cannot by itself
                    # admit a consumer object: generic/default bodies and
                    # lowered static initializers may change that consumer's
                    # MIR without changing either public interface. Bind the
                    # candidate to the CURRENT MIR/storage capsule receipt.
                    var capsule_matches = false
                    if all_in_scope and scoped_outputs.len() == 1 and outputs_exist:
                        val cached_capsules = ctx.freeze_native_module_capsules_v1(
                            [name], object_base, backend_name, native_target,
                            native_cpu, driver_opt_level, is_release)
                        if cached_capsules.ok:
                            val cached_capsule = cached_capsules.find(name)
                            capsule_matches = cached_capsule.ok
                                and scoped_outputs[0] == cached_capsule.object_path
                                and driver_native_capsule_result_valid_v1(cached_capsule)
                    if capsule_matches:
                        print "[NATIVE] cache hit: {name}"
                        cache_hit_count = cache_hit_count + 1
                        # A verified cache hit IS an OK outcome: the objects were
                        # confirmed present on disk just above.
                        module_unit_id = module_unit_id + 1
                        module_outcomes.record(
                            BuildUnitOutcome.ok(module_unit_id, name, 0, 0))
                        for obj in scoped_outputs:
                            object_files = object_files.push(obj)
                        if low_memory:
                            ctx.evict_mir_module(name)
                        used_cache = true
                    elif not all_in_scope or not outputs_exist or not capsule_matches:
                        build_cache.remove_entry(cache_source)
            if not used_cache:
                uncached_names = uncached_names.push(name)
            if progress_cache_scanned % 64 == 0:
                log_build_progress("native_cache", "modules",
                    progress_cache_scanned, total_modules, name,
                    5, 6, 0, cache_hit_count, "running")

        log_build_progress("native_cache", "modules", total_modules,
            total_modules, "complete", 5, 6, 0, cache_hit_count, "running")

        # Deterministic, bounded PRELOOKUP/ATTEMPT evidence. It describes the
        # decisions above, not the final post-compile cache state. This shadow
        # receipt is best-effort and can never fail the authoritative build.
        val witness_shadow_sorted = driver_native_shadow_sort(
            witness_shadow_mismatch_lines)
        val witness_shadow_truncated = witness_shadow_mismatch_count
            - witness_shadow_sorted.len()
        var witness_shadow_receipt_lines: [text] = [
            NATIVE_MODULE_CACHE_SHADOW_RECEIPT_VERSION,
            "phase=prelookup-attempt",
            "non_authoritative=false",
            "decision-authority=per-module-complete-witness",
            "closure-comparison-only={sources_fingerprint}",
            "matches={witness_shadow_match_count}",
            "mismatches={witness_shadow_mismatch_count}",
            "retained={witness_shadow_sorted.len()}",
            "truncated={witness_shadow_truncated}"
        ]
        for receipt_line in witness_shadow_sorted:
            witness_shadow_receipt_lines.push(receipt_line)
        _sffi_file_write_text(_sffi_path_join(cache_scope_root,
            "native-module-witness-shadow-v1.receipt"),
            witness_shadow_receipt_lines.join("\n") + "\n")

        if object_files.len() == 0 and uncached_names.len() == 0:
            return CompileResult.CodegenError("native-build produced no code-bearing MIR modules")

        # Phase 2: Compile uncached modules through ParallelBuilder
        val native_compile_current = if uncached_names.len() > 0:
            uncached_names[0]
        else:
            "complete"
        log_build_progress("native_compile", "modules",
            total_modules - uncached_names.len(), total_modules,
            native_compile_current, 5, 6, 0, cache_hit_count, "running")
        if uncached_names.len() > 0:
            if (env_get("SIMPLE_M4_WORK_RECEIPT") ?? "") == "1":
                for emitted_name in uncached_names:
                    print "[M4 emit] module={emitted_name} work=1"
            var frozen_module_witnesses: {text: text} = {}
            var frozen_module_witness_reasons: {text: text} = {}
            for witness_name in uncached_names:
                val (frozen_witness, frozen_witness_reason) =
                    driver_native_shadow_witness_v1(
                        ctx, witness_name, ctx.mir_modules[witness_name],
                        module_cache_config)
                frozen_module_witnesses[witness_name] = frozen_witness
                frozen_module_witness_reasons[witness_name] = frozen_witness_reason
            val capsules = ctx.freeze_native_module_capsules_v1(uncached_names,
                object_base, effective_backend, native_target, native_cpu,
                driver_opt_level, is_release, provider_receipt_hash,
                frozen_module_witnesses, frozen_module_witness_reasons)
            if not capsules.ok:
                return CompileResult.CodegenError(capsules.reason)
            if uncached_names.len() == 1:
                val name = uncached_names[0]
                val direct_result = _compile_frozen_module_capsule(capsules,
                    effective_backend, native_target, is_release,
                    driver_opt_level, provider_receipt_hash, backend_session,
                    name)
                match direct_result:
                    case Ok(obj_path):
                        val collect_error = driver_native_collect_capsule_result_v1(
                            capsules, build_cache, name, obj_path)
                        if collect_error != "":
                            module_unit_id = module_unit_id + 1
                            # Wrapped like the two Err sites below: `collect_error
                            # != ""` admitted it, but that test does not survive a
                            # corrupt payload, so an unwrapped detail could still
                            # reach the summary as "(none recorded)".
                            driver_native_record_module_failure(module_outcomes,
                                module_unit_id, name,
                                driver_native_nonempty_failure_detail(collect_error))
                        cache_miss_count = cache_miss_count + 1
                    case Err(e):
                        module_unit_id = module_unit_id + 1
                        driver_native_record_module_failure(module_outcomes,
                            module_unit_id, name,
                            driver_native_nonempty_failure_detail(e))
                        cache_miss_count = cache_miss_count + 1
            else:
                # `unstable` and `unit_timeout_ms` were omitted here. Partial
                # struct literals are legal, so this compiled while silently
                # forcing unstable OFF -- SIMPLE_UNSTABLE_BUILD=1 and the
                # bootstrap-path default could never reach the builder at all.
                # Carry the intent explicitly; build() reports whether it can
                # actually honour it.
                # An admitted BackendSession owns a stateful adapter and has no
                # reentrancy capability yet. Keep its provider lane serial even
                # though the built-in lane may request multiple workers.
                val provider_threads = if backend_session.?:
                    1
                else:
                    driver_native_build_threads()
                # Report the REAL degree of concurrency, unconditionally.
                # `build()` compiles in-process, one unit at a time
                # (parallel.spl:510-513), so concurrency on this path is 1 no
                # matter what `provider_threads` says. This print is not gated
                # on --verbose on purpose: the >1h33m silent step-5 phase in
                # doc/08_tracking/bug/native_build_step5_serial_threads_ignored_2026-09-04.md
                # was observed WITHOUT --verbose, so a verbose-only notice
                # would not have surfaced it, and the verbose notice inside
                # build() itself is likewise unreachable by default. Do not
                # weaken this into a claim of parallelism -- the route to real
                # parallelism is staged in
                # doc/03_plan/compiler/native_codegen/step5_real_parallelism_plan_2026-09-04.md
                # Every clause here must be unconditionally TRUE. `provider_threads`
                # is the RESOLVED value, not the user's --threads: it is 1 when a
                # BackendSession is admitted, and 0 when SIMPLE_NATIVE_BUILD_THREADS
                # is unset (`driver_native_build_threads`, :248-255). So it must not
                # be described as "requested", and "N is not honoured" would be false
                # at 1 and meaningless at 0. State the resolved value and the
                # invariant separately.
                val uncached_count = uncached_names.len()
                print "[NATIVE] codegen: {uncached_count} uncached module(s), "
                    + "concurrency=1 (threads resolve to {provider_threads} here, but "
                    + "build() compiles modules sequentially in this process -- no "
                    + "value above 1 takes effect; see "
                    + "step5_real_parallelism_plan_2026-09-04.md)"
                _sffi_stdout_flush()
                val parallel_cfg = ParallelBuildConfig(
                    num_threads: provider_threads,
                    parallel_threshold: 4,
                    deterministic: false,
                    verbose: ctx.options.verbose,
                    unstable: parallel_unstable_enabled(false),
                    unit_timeout_ms: 0
                )
                var builder = ParallelBuilder.create(parallel_cfg)
                builder.set_owner_collect(driver_native_collect_capsule_result_v1(
                    capsules, build_cache, _1, _2))

                for name in uncached_names:
                    builder.add_unit(name, [])

                val build_result = builder.build(_compile_frozen_module_capsule(
                    capsules, effective_backend, native_target, is_release,
                    driver_opt_level, provider_receipt_hash, backend_session,
                    _1))
                cache_miss_count = cache_miss_count + build_result.stats.completed
                    + build_result.stats.failed

                if not build_result.success:
                    # ParallelBuilder already accumulates EVERY unit's error; the
                    # old code read errors[0] and threw the rest away. Record all
                    # of them, classified, and keep going to the end of the phase.
                    for unit_err in build_result.errors:
                        module_unit_id = module_unit_id + 1
                        driver_native_record_module_failure(module_outcomes,
                            module_unit_id, unit_err[0],
                            driver_native_nonempty_failure_detail(unit_err[1]))
                    val first_err = build_result.errors[0]
                    log_build_progress("native_compile", "modules",
                        cache_hit_count + build_result.stats.completed,
                        total_modules, first_err[0], 5, 6,
                        build_result.stats.failed, cache_hit_count, "failed")

            # Post-process: update cache and collect object paths. Do not rely
            # on BuildResult.outputs here: stage1-generated compilers can lose
            # pushes into arrays that start empty. _compile_one_module writes
            # objects at this stable path, so reconstruct from uncached_names.
            var reconstructed_outputs: [text] = []
            for name in uncached_names:
                val capsule = frozen_native_capsule_batch_find_v1(capsules, name)
                val obj_path = if capsule.ok: capsule.object_path else: ""
                if capsule.ok and driver_native_capsule_result_valid_v1(capsule):
                    reconstructed_outputs = reconstructed_outputs.push(obj_path)
                    object_files = object_files.push(obj_path)
                    if ctx.demand_scc_publication != nil:
                        var publication = ctx.demand_scc_publication!
                        if not scc_publication_complete_object_v1(
                                &mut publication, name, obj_path):
                            return CompileResult.CodegenError(
                                "SCC publication output ownership mismatch: {name}")
                        ctx.demand_scc_publication = Some(publication)
                    # Record the entry on THIS build_cache, not only inside
                    # driver_native_collect_capsule_result_v1: that checkpoint
                    # receives the cache as a call argument and its update never
                    # reached the caller, so the final save() below persisted an
                    # empty `entries: []` and a second identical build reported
                    # 0 hits / N misses (cache fixture 2026-08-21, 3 modules).
                    if capsule.cache_source != "":
                        val source_unchanged = capsule.source_identity != ""
                            and driver_native_disk_source_identity(
                                capsule.cache_source) == capsule.source_identity
                        if source_unchanged:
                            if val src_fp = FileFingerprint.from_file(capsule.cache_source):
                                build_cache.update_entry(capsule.cache_source, src_fp,
                                    [], [obj_path], capsule.module_witness)
                    module_unit_id = module_unit_id + 1
                    module_outcomes.record(
                        BuildUnitOutcome.ok(module_unit_id, name, 0, 0))
                elif not module_outcomes.has_path(name):
                    # No object and no already-recorded failure: this unit was
                    # never actually attempted (a dependency skip, or the phase
                    # ended first). NOT_RUN is stated explicitly — silent absence
                    # is forbidden (R3). Nothing is pushed to object_files, so no
                    # artifact is ever fabricated for it (R4).
                    module_unit_id = module_unit_id + 1
                    module_outcomes.record(
                        BuildUnitOutcome.not_run(module_unit_id, name))
            # Evict MIR for compiled modules in low-memory mode
            if low_memory:
                for name in uncached_names:
                    ctx.evict_mir_module(name)

        # Save build cache. Done BEFORE the fail-closed check so the modules that
        # did build stay reusable on the retry (a failing build must not also
        # throw away the good work it did).
        build_cache.save()
        if phase2_compatibility_manifest.?:
            for item in phase2_compatibility_manifest.unwrap().items:
                if item.kind == PHASE_COMPATIBILITY_NATIVE_V1 and
                        not phase2_native_items_handled.contains_key(item.artifact_path):
                    print "[M3] reject native reason=key-not-requested path={item.artifact_path}"
                    phase2_native_rejections = phase2_native_rejections + 1
            print "[M3 ledger] schema=simple-phase2-phase3-reuse-ledger-v1 kind=native-object hits={phase2_native_reuse_hits} rejections={phase2_native_rejections}"
        val phase2_manifest_path = env_get_nullable(
            "SIMPLE_PHASE2_COMPATIBILITY_MANIFEST_WRITE") ?? ""
        if phase2_manifest_path != "":
            val phase3_cache_root = env_get_nullable(
                "SIMPLE_PHASE3_COMPATIBILITY_CACHE_ROOT") ?? ""
            val manifest_reason = driver_emit_phase2_compatibility_manifest_v1(
                build_cache, cache_dir, phase3_cache_root,
                phase2_manifest_path, module_cache_config.compiler_identity,
                module_cache_config.provider_identity,
                module_cache_config.target_identity)
            if manifest_reason != "ok":
                return CompileResult.CodegenError(
                    "Phase 2 compatibility manifest failed: {manifest_reason}")

        # Fail closed at the boundary, not early (R4). Every module has now been
        # attempted and the summary names them all; only now do we refuse to link.
        # A partial build is NEVER linked silently, and no object is ever
        # fabricated for a failed module — cf. the existing defect at
        # linker/native_binary/stubs.rs:209-221, where fabricated zero-returning
        # stubs masked missing symbols.
        val outcome_verdict = driver_native_report_module_outcomes_v1(module_outcomes)
        if outcome_verdict != "":
            return CompileResult.CodegenError(outcome_verdict)

        if not driver_publish_demand_scc_outputs_v1(ctx):
            return CompileResult.CodegenError(
                "demand-driven SCC publication failed closed")

        log_build_progress("native_compile", "modules", total_modules,
            total_modules, "complete", 5, 6, 0, cache_hit_count, "running")
        if trace and (cache_hit_count > 0 or cache_miss_count > 0):
            print "[NATIVE] cache: {cache_hit_count} hits, {cache_miss_count} misses"
            _sffi_stdout_flush()

        # Link object files into final executable
        # Guard (bug #119): refuse to silently fallback when no object files were produced.
        # This indicates zero modules compiled, which is a hard error — do not substitute bootstrap_main.
        if object_files.len() == 0:
            val entry_hint = if ctx.options.input_files.len() > 0:
                " (input: {ctx.options.input_files[0]})"
            else:
                ""
            return CompileResult.CodegenError("native-build produced no object files{entry_hint} — no modules compiled. Try adding an import (use std.text) or using the standard entry point.")

        if emit_object_requested:
            if object_files.len() == 0:
                return CompileResult.CodegenError("emit-object requested but no object files were produced")
            if object_files.len() == 1:
                if not _sffi_file_copy(object_files[0], output):
                    return CompileResult.CodegenError("emit-object failed to copy {object_files[0]} to {output}")
            else:
                var args: [text] = ["-r"]
                for obj in object_files:
                    args = args.push(obj)
                args = args.push("-o")
                args = args.push(output)
                val (_stdout, stderr, code) = process_run("ld.lld", args)
                if code != 0:
                    return CompileResult.CodegenError("emit-object relocatable link failed: {stderr}")
            driver_log_info(log, "Native object written to {output}")
            return driver_native_success_with_launch_metadata(ctx, output)

        if emit_archive_requested:
            val archiver = find_archive_portable()
            if archiver == "":
                return CompileResult.CodegenError("emit-archive requires llvm-ar, ar, or lib.exe")
            val host_os = get_host_os()
            val system_ar = archiver == "ar" or archiver.ends_with("/ar")
            if effective_backend == "cranelift" and host_os == "macos" and system_ar:
                return CompileResult.CodegenError("Cranelift Mach-O archives require llvm-ar")
            val msvc_lib = archiver == "lib" or archiver.ends_with("lib.exe")
            var args: [text] = []
            if msvc_lib:
                args = ["/NOLOGO", "/OUT:{output}"]
            else:
                val archive_flags = if host_os == "macos" and system_ar: "rcs" else: "rcsD"
                args = [archive_flags, output]
            for obj in object_files:
                args = args.push(obj)
            val (_stdout, stderr, code) = process_run(archiver, args)
            if code != 0:
                return CompileResult.CodegenError("emit-archive failed: {stderr}")
            driver_log_info(log, "Native archive written to {output}")
            return driver_native_success_with_launch_metadata(ctx, output)

        if emit_shared_requested:
            var shared_config = NativeLinkConfig.default()
            shared_config.pie = false
            shared_config.verbose = ctx.options.verbose
            match link_to_shared(object_files, output, shared_config):
                case Ok(_):
                    driver_log_info(log, "Native shared library written to {output}")
                    return driver_native_success_with_launch_metadata(ctx, output)
                case Err(e):
                    return CompileResult.CodegenError("shared-library link failed: {e}")

        if trace:
            print "[NATIVE] linking {object_files.len()} object files..."
        log_build_progress("link", "objects", object_files.len(),
            object_files.len(), output, 5, 6, 0, cache_hit_count, "running")
        if effective_backend == "llvm" or effective_backend == "llvm-lib":
            # LLVM path: compile C runtime and link with entry point
            if trace:
                print "[NATIVE] creating NativeLinkOptions..."
            val llvm_opts = NativeLinkOptions(
                debug: ctx.options.debug_info,
                strip_output: ctx.options.strip_output,
                verbose: ctx.options.verbose,
                pie: true,
                bare_metal: false,
                opt_level: driver_opt_level,
                stage4_backend: effective_backend,
                stage4_compiler_hash: native_build_compiler_identity(),
                target_triple: native_target,
                runtime_path: env_get_nullable("SIMPLE_RUNTIME_PATH") ?? "",
                runtime_bundle: env_get_nullable("SIMPLE_NATIVE_RUNTIME_BUNDLE") ?? ""
            )
            if trace:
                print "[NATIVE] calling link_llvm_native..."
            match link_llvm_native(object_files, output, llvm_opts):
                case Ok(_):
                    log_build_progress("link", "objects", object_files.len(),
                        object_files.len(), output, 6, 6, 0,
                        cache_hit_count, "succeeded")
                    driver_log_info(log, "Native executable written to {output} (backend: LLVM)")
                    return driver_native_success_with_launch_metadata(ctx, output)
                case Err(e):
                    driver_native_link_failure_result(ctx, "LLVM native linking failed", e)
        else:
            # Hosted native binaries need the same runtime objects and C `main`
            # entry shim regardless of which backend produced user objects.
            val hosted_opts = NativeLinkOptions(
                debug: ctx.options.debug_info,
                verbose: ctx.options.verbose,
                pie: true,
                bare_metal: false,
                opt_level: driver_opt_level,
                stage4_backend: effective_backend,
                stage4_compiler_hash: native_build_compiler_identity(),
                target_triple: native_target,
                runtime_path: env_get_nullable("SIMPLE_RUNTIME_PATH") ?? "",
                runtime_bundle: env_get_nullable("SIMPLE_NATIVE_RUNTIME_BUNDLE") ?? ""
            )
            match link_llvm_native(object_files, output, hosted_opts):
                case Ok(_):
                    log_build_progress("link", "objects", object_files.len(),
                        object_files.len(), output, 6, 6, 0,
                        cache_hit_count, "succeeded")
                    driver_log_info(log, "Native executable written to {output} (backend: {effective_backend})")
                    driver_native_success_with_launch_metadata(ctx, output)
                case Err(e):
                    driver_native_link_failure_result(ctx, "Hosted native linking failed", e)

    # --------------------------------------------------------------------------
    # Linker Helper (legacy - kept for compatibility, delegates to linker_wrapper)
    # --------------------------------------------------------------------------

    fn link_objects(objects: [text], output: text) -> Result<text, text>:
        if objects.is_empty():
            return Err("No object files to link")

        var config = NativeLinkConfig.default()
        link_to_native(objects, output, config)

# ============================================================================
# Single-ParserModule Compilation Helper (for ParallelBuilder)
# ============================================================================

# Emit an AOT failure reason at its RAISING site, then return it.
#
# The `Err` payload of this lane does not survive the return crossing on the
# compiled self-hosted (stage-2) binary. It first surfaced as
# `AOT compile error in <unit>: <invalid-heap:0x…>` -- the payload rendered as a
# misdecoded tagged word -- and, once the raising site moved behind
# `_finish_selected_module_compile`, degraded further to an EMPTY payload, which
# `BuildOutcomeSet.reason_block_for` prints as
# "(none recorded — BUG in the producer: a non-OK unit must carry a diagnostic)".
# Measured 2026-09-06: the SAME source interpreted under the seed prints the real
# text ("scalar object-path AOT is available only for builtin LLVM"), so the
# message is correct where it is raised and is destroyed only on the way out.
#
# Printing here makes the diagnostic independent of that crossing: if the payload
# is lost the operator still has the reason, and the summary's fallback below
# still names a non-empty producer site. This does NOT paper over the ABI defect
# -- it is tracked separately in
# doc/08_tracking/bug/stage2_aot_error_message_lost_invalid_heap_2026-09-06.md --
# it removes that defect's ability to blind every failure on this path.
# CORRECTED 2026-09-06 -- an earlier revision of this comment claimed as measured
# fact that this function ran 222 times and printed 222 empty lines. That claim is
# REFUTED by later evidence from the same run: the object file (1080 bytes) and
# its capsule-receipt were both present on disk, so `_compile_frozen_module_capsule`
# returned `Ok` and this function was NOT on the failing path at all. The failing
# path is the collection checkpoint below. What IS measured: the log carries one
# unexplained blank line per failure and not one `error: AOT compile error in ...`
# line; the ORIGIN of that blank line is unidentified, and this comment does not
# claim otherwise.
#
# The hardening below is kept because it is correct for the path it guards, and
# because the payload corruption it defends against is independently recorded in
# doc/08_tracking/bug/stage2_aot_error_message_lost_invalid_heap_2026-09-06.md
# (`err.to_text()` rendering as `<invalid-heap:0x…>`): a diagnostic that depends
# on interpolating a possibly-corrupt operand can be silenced together with the
# literal text around it. Three
# independent statements, ordered most-robust first, so a collapse localises the
# corruption instead of erasing the message:
#   1. a pure-literal line -- no operands, so nothing can silence it. Its
#      presence alone proves this function ran, which is the fact that was
#      unobtainable before.
#   2. `print name` / `print detail` BARE -- a bare print of a text value does
#      not build an interpolated temporary, so it survives crossings that
#      collapse `"{...}"`. This is the line that carries the real reason.
#   3. the lengths, via i64 interpolation -- a different lowering path from text
#      interpolation, so a zero/garbage length distinguishes "the payload is
#      empty" from "the payload is corrupt" without guessing.
# A blank line from (2) with a non-zero length from (3) is positive evidence of
# the text-crossing defect, not an absence of evidence.
fn _aot_compile_failure(name: text, detail: text) -> Result<text, text>:
    print "error: AOT compile error -- unit, reason and lengths follow on the next lines"
    _sffi_stdout_flush()
    print "error:   unit (bare):"
    print name
    _sffi_stdout_flush()
    print "error:   reason (bare):"
    print detail
    _sffi_stdout_flush()
    print "error:   name-len={name.len()} reason-len={detail.len()}"
    _sffi_stdout_flush()
    Err("AOT compile error in {name}: {detail}")

fn _compile_frozen_module_capsule(
    batch: FrozenNativeModuleCapsuleBatchV1, backend_name: text, target: text,
    is_release: bool, opt_level: i64, provider_receipt_hash: text,
    backend_session: BackendSession?, name: text
) -> Result<text, text>:
    compiler_work_codegen_schedule_v1(1)
    """Compile one parent-frozen module capsule without CompileContext/cache access."""
    if not batch.ok:
        return _aot_compile_failure(name, "invalid-capsule-batch")
    val capsule = frozen_native_capsule_batch_find_v1(batch, name)
    if not capsule.ok or capsule.module_name != name:
        return _aot_compile_failure(name, "capsule-not-found")
    if not driver_native_capsule_inputs_valid_v1(capsule, backend_name, target,
        is_release, opt_level, provider_receipt_hash):
        return _aot_compile_failure(name, "capsule-identity-mismatch")
    if capsule.storage_snapshot.registry_identity != batch.registry_identity:
        return _aot_compile_failure(name, "capsule-registry-mismatch")
    val trace = (env_get_nullable("SIMPLE_COMPILER_TRACE") ?? "") == "1"
    if trace:
        print "[NATIVE] compiling module: {name}"
        _sffi_stdout_flush()
    # Rebuild the error variant while its text payload is bound in this frame.
    # Returning the already-consumed composite `result` forwarded only its tag
    # through an early self-hosted bootstrap ABI, so the next caller observed
    # `Err("")` even though the object-path driver had read the llc diagnostic.
    match _compile_selected_module(backend_name, is_release, opt_level,
        capsule.output_base,
        name, capsule.mir_module, capsule.storage_snapshot,
        capsule.target_cpu, backend_session):
        case Err(error): return Err(error)
        case Ok(object_path):
            if not capsule.identity_valid():
                return _aot_compile_failure(name, "capsule-mir-lease-violated")
            if object_path != capsule.object_path:
                return _aot_compile_failure(name, "capsule-object-path-mismatch")
            val object_fp = FileFingerprint.from_file(object_path)
            if not object_fp.?:
                return _aot_compile_failure(name, "capsule-object-fingerprint-failed")
            val receipt_path = capsule.object_path + ".capsule-receipt"
            # Size comes from the runtime, NOT from `fp.size`. Reading that
            # `i64` field off an optional-bound FileFingerprint returns a
            # tagged heap pointer under Stage-2 native codegen, and a fresh one
            # per read, so the receipt written here could never match the
            # receipt recomputed by the verifier -- see the note on the
            # `file_size_raw` note at the top of this file.
            #
            # Fail closed on a value that cannot be a byte count: the runtime
            # reports a failed stat as -1, which `FileFingerprint.from_file`
            # passes through unchecked, so a vanished or unreadable object
            # would otherwise be recorded as a size of -1 and only surface far
            # away as an opaque `receipt-content-mismatch`.
            val object_size = file_size_raw(object_path)
            if object_size < 0:
                return _aot_compile_failure(name,
                    "capsule-object-size-unreadable:{object_path}")
            val size_reason = driver_native_capsule_receipt_size_reason_v1(
                object_size)
            if size_reason != "":
                return _aot_compile_failure(name,
                    "capsule-{size_reason}:{object_path}")
            var receipt = ""
            var size_canary = ""
            if val fp = object_fp:
                # `fp.size` is read here ONLY as a canary against the runtime
                # value that is actually written. A disagreement is the
                # scalar-field miscompile; it is reported unconditionally and
                # never silenced, but it does not fail the build -- nothing
                # garbage can reach the receipt, because neither side of the
                # receipt reads this field.
                size_canary = driver_native_capsule_receipt_size_canary_v1(
                    fp.size, object_size)
                receipt = "native-capsule-result-v1\n{capsule.capsule_identity}\n{capsule.object_path}\n{object_size}\n{fp.content_hash}\n"
            if size_canary != "":
                print "[receipt-size-canary] optional-bound scalar field read miscompiled: {size_canary} path={object_path}"
                _sffi_stdout_flush()
            if not _sffi_file_write_text(receipt_path, receipt):
                return _aot_compile_failure(name, "capsule-receipt-write-failed")
            # Do not trust the write's own bool. A `file_write_text` name
            # collision (a same-arity stdlib shadow returning `()`) once made
            # this call a silent no-op that still read as success, so the
            # receipt was never on disk and the failure surfaced far away as an
            # opaque `native-capsule-receipt-invalid`. Read the receipt back and
            # fail at the write site with a name that says what happened.
            if (_sffi_file_read_text(receipt_path) ?? "") != receipt:
                return _aot_compile_failure(name, "capsule-receipt-write-unverified")
            Ok(object_path)

fn _compile_selected_module(backend_name: text, is_release: bool, opt_level: i64,
                            output_base: text, name: text, mir_module: MirModule,
                            storage_snapshot: FrozenStorageModuleSnapshotV1,
                            frozen_target_cpu: text,
                            backend_session: BackendSession?) -> Result<text, text>:
    if not storage_snapshot.ok or storage_snapshot.module_name != name:
        return _aot_compile_failure(name, "storage-snapshot-module-mismatch")
    if (env_get_nullable("SIMPLE_COMPILER_TRACE") ?? "") == "1":
        print "[NATIVE] select module:done"
    if mir_module.functions.keys().len() == 0:
        return _aot_compile_failure(name, "MIR module has no functions")
    val empty_native_obj = env_get_nullable("SIMPLE_BOOTSTRAP_EMPTY_NATIVE_OBJ") ?? ""
    if empty_native_obj == "1":
        val c_path = "{output_base}.{name}.bootstrap_empty.c"
        val obj_path = "{output_base}.{name}.o"
        val c_ok = _sffi_file_write_text(c_path, "int main(int argc, char **argv) { (void)argc; (void)argv; return 0; }\n")
        if not c_ok:
            return Err("Failed to write bootstrap empty C file {c_path}")
        val (_cc_out, cc_err, cc_code) = process_run("cc", ["-c", c_path, "-o", obj_path])
        if cc_code != 0:
            return Err("Bootstrap empty object compile failed: {cc_err}")
        return Ok(obj_path)

    # Finish the Result inside the selected provider branch. A self-hosted
    # conditional composite temporary can outlive its active flat payload and
    # later render that raw word as `<invalid-heap:...>`.
    if val session = backend_session:
        val obj_path = "{output_base}.{name}.o"
        val diagnostic_dir = secure_temp_dir_raw(
            dirname(obj_path), "simple-aot-diagnostic")
        if diagnostic_dir == "":
            return _aot_compile_failure(name, "diagnostic staging unavailable")
        val diagnostic_path = diagnostic_dir + "/message"
        val status = session.compile_aot_into_path(
            mir_module, is_release, opt_level, frozen_target_cpu,
            storage_snapshot.sites, obj_path, diagnostic_path)
        if status != 0:
            # Deliver the reason from INSIDE the arm that binds it. This block
            # used to hoist the payload into a `var detail` in the enclosing
            # frame and call `_aot_compile_failure(name, detail)` afterwards;
            # the reason then arrived as `reason-len=-1` while strace showed the
            # diagnostic bytes reaching the process (`read(...) = 32`).
            #
            # nil vs NULL-data-pointer is STILL NOT PINNED, and the obvious way
            # to pin it does not work -- recorded here so nobody spends the
            # hours again. `rt_string_len` returns -1 for any word it cannot
            # decode as a heap string when that word is < 0x10000
            # (runtime_native.c), which covers BOTH nil (3) and 0, so the length
            # alone cannot separate them. `rt_core_print_value_to` COULD (its
            # RT_VALUE_SPECIAL_NIL arm writes nothing, while word 0 carries
            # RT_VALUE_TAG_INT and prints `0`) -- but the native lane never
            # reaches it: `print` lowers to `rt_println`, not `rt_println_value`
            # (llvm_lib_translate_expr.spl:600), and `rt_println` takes a
            # `const char*`, so the argument is `rt_string_data(v)`, which is
            # NULL for 3 and for 0 alike. MEASURED 2026-09-07: the bare line IS
            # empty and reason-len IS -1, which is consistent with both words
            # and therefore discriminates neither. A discriminator has to come
            # from a runtime entry point that sees the raw word.
            #
            # Both fixes below are correct for either word, which is why they do
            # not wait on that answer:
            #   1. the crossing itself -- `_aot_compile_failure` is now called
            #      inside the arm, the same rule `_finish_selected_module_compile`
            #      below already documents for `err.to_text()`.
            #   2. the guard -- `message != ""` is TRUE for a nil, so the old
            #      code overwrote a good interpolated default with the nil it had
            #      just been handed. `message.len() > 0` rejects nil (-1) and
            #      empty (0) alike, so a corrupt payload now falls through to the
            #      literal default instead of erasing it.
            # Cleanup is reported by printing, never by interpolating the reason
            # into a longer string: an operand that can be corrupt must not be
            # able to silence the text around it.
            # Why the fallback says WHICH way the diagnostic was lost: every
            # failure path in the backend writes one (see
            # compile_ir_to_object_path and llvm_object_stage_fail), so an
            # empty reason means either the write did not land or this read
            # could not see it -- and "backend object-path status 1" alone
            # cannot tell those apart. That ambiguity is what left this defect
            # opaque across sessions; naming it costs one interpolation.
            # Ask the RUNTIME how many bytes are on disk before naming the
            # failure mode. MEASURED 2026-09-13 (lane BOOT-6, `strace -y` on
            # the Stage-2 candidate `67786227817bf45f...`): the backend wrote
            # `write(...message.tmp..., "AOT object destination already
            # exists", 37) = 37` and this frame read all 37 bytes back
            # (`read = 32`, `read = 5`, `read = 0`) -- and still reported
            # `diagnostic file empty`, because the `case Ok(message):` payload
            # read loses the text under this binary's codegen (the same defect
            # the `[receipt-size-canary]` lines report for an optional-bound
            # scalar field). "Empty" was therefore a FALSE statement about the
            # file, and it hid a real, nameable backend failure for a whole
            # lane. The size is the one fact that does not travel through the
            # lost binding, and the `?? ""` read below is the same shape that
            # verifies the capsule receipt successfully on this binary.
            var diagnostic_note = "no diagnostic file"
            val diagnostic_size = file_size_raw(diagnostic_path)
            match file_read_regular_no_follow_bounded(diagnostic_path, 4096):
                case Ok(message):
                    if message.len() > 0:
                        if not dir_remove(diagnostic_dir, true):
                            print "warning: diagnostic staging cleanup failed: {diagnostic_dir}"
                            _sffi_stdout_flush()
                        return _aot_compile_failure(name, message)
                    if diagnostic_size > 0:
                        val recovered = _sffi_file_read_text(diagnostic_path) ?? ""
                        if recovered.len() > 0:
                            if not dir_remove(diagnostic_dir, true):
                                print "warning: diagnostic staging cleanup failed: {diagnostic_dir}"
                                _sffi_stdout_flush()
                            return _aot_compile_failure(name, recovered)
                        diagnostic_note = "diagnostic {diagnostic_size} bytes on disk, payload lost on read"
                    else:
                        diagnostic_note = "diagnostic file empty"
                case Err(read_error):
                    diagnostic_note = "diagnostic unreadable: {read_error}"
            if not dir_remove(diagnostic_dir, true):
                print "warning: diagnostic staging cleanup failed: {diagnostic_dir}"
                _sffi_stdout_flush()
            return _aot_compile_failure(name,
                "backend object-path status {status} ({diagnostic_note}; path {diagnostic_path})")
        match file_read_regular_no_follow_bounded(diagnostic_path, 4096):
            case Ok(message):
                # `.len() > 0`, not `!= ""`: a nil payload compares UNEQUAL to
                # "" and would print an empty warning line. -1 (nil) and 0
                # (empty) are both rejected here.
                if message.len() > 0:
                    print "warning: backend AOT: {message}"
            case Err(_): ()
        if not dir_remove(diagnostic_dir, true):
            print "warning: published object; diagnostic staging cleanup failed: {diagnostic_dir}"
        if (not file_is_regular_no_follow(obj_path)
            or file_size_raw(obj_path) <= 0):
            return _aot_compile_failure(name, "invalid object output")
        return Ok(obj_path)
    _finish_selected_module_compile(
        compile_module_with_backend_target_cpu_storage_bindings(
            backend_name, mir_module, is_release, opt_level, frozen_target_cpu,
            storage_snapshot.sites), output_base, name)

fn _finish_selected_module_compile(
    compiled: Result<CompiledModule, CompileError>,
    output_base: text, name: text
) -> Result<text, text>:
    # Keep Result and optional object-code payloads inside their binding scope.
    match compiled:
        case Err(err):
            # Render the payload to text HERE, inside the arm that binds it.
            # `_aot_compile_failure` then emits it before this frame returns,
            # so the reason survives even when the Err crossing does not.
            _aot_compile_failure(name, err.to_text())
        case Ok(module):
            if val obj_bytes = module.object_code:
                val obj_path = "{output_base}.{name}.o"
                if (env_get_nullable("SIMPLE_BOOTSTRAP") ?? "") == "1":
                    val bootstrap_obj = llvm_bootstrap_last_object_path()
                    if bootstrap_obj != "" and _sffi_file_copy(bootstrap_obj, obj_path):
                        return Ok(obj_path)
                match write_elf_bytes_to_file(obj_path, obj_bytes):
                    case Ok(_):
                        Ok(obj_path)
                    case Err(e):
                        _aot_compile_failure(name,
                            "failed to write object file {obj_path}: {e}")
            else:
                _aot_compile_failure(name, "backend produced no object code")
        case _:
            _aot_compile_failure(name, "backend result not Ok")
