fn driver_publish_demand_scc_outputs_v1(ctx: CompileContext) -> bool:
    if ctx.demand_scc_publication == nil:
        return true
    if (ctx.demand_compile_execution == nil or
            ctx.demand_mir_admission == nil or
            ctx.demand_dirty_modules.len() == 0):
        return false
    val dirty_authority = ctx.demand_dirty_modules[0]
    val authority = PackageArchiveAuthorityV1(
        dirty_authority.producer_compatibility_id,
        dirty_authority.package_index_generation,
        dirty_authority.configuration_variant,
        dirty_authority.scv_revision,
        dirty_authority.scv_tree_digest,
        dirty_authority.scv_inventory_digest)
    var ownership = ctx.demand_scc_publication!
    var scc_identities: [text] = []
    for output in ownership.modules:
        if not scc_identities.contains(output.entry.scc_identity):
            scc_identities = scc_identities.push(output.entry.scc_identity)
    var execution = ctx.demand_compile_execution!
    for scc_identity in scc_identities.sorted():
        var scheduled: [text] = []
        var modules: [SccModuleCompileOutputV1] = []
        for output in ownership.modules:
            if output.entry.scc_identity == scc_identity:
                scheduled = scheduled.push(output.entry.module_identity)
                modules = modules.push(output)
        if modules.len() == 0:
            ctx.demand_scc_publication = Some(ownership)
            ctx.demand_compile_execution = Some(execution)
            return false
        val baseline_identity = modules[0].baseline_artifact_identity
        val baseline_digest = modules[0].baseline_artifact_digest
        val completion = demand_compile_complete_scc_outputs_v1(
                execution, machine_cache_root(), authority,
                ctx.demand_mir_admission!,
                SccCompileOutputsV1(
                    scc_identity, scheduled.sorted(), modules),
                baseline_identity, baseline_digest)
        execution = completion.execution
        if not completion.accepted:
            ctx.demand_scc_publication = Some(ownership)
            ctx.demand_compile_execution = Some(execution)
            return false
    ctx.demand_scc_publication = Some(ownership)
    ctx.demand_compile_execution = Some(execution)
    true
