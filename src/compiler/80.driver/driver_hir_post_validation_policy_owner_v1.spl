use compiler.driver.driver_compiler_type.{CompilerDriver}
use compiler.driver.driver_hir_archive_schedule_owner_v1.*
use compiler.driver.cache.driver_hir_post_validation_policy_v1.{DriverHirPostValidationPolicyOwnerV1,
    driver_hir_post_validation_policy_capture_v1}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}

impl CompilerDriver:
    me capture_hir_archive_post_validation_policy_v1() -> Result<DriverHirPostValidationPolicyOwnerV1, text>:
        if transient_array_scope_state_v1() != 0 or self.hir_archive_post_validation_policy != nil:
            return Err("post-HIR policy owner already captured or foreign lease occupied")
        val actual_schedule = self.verify_hir_archive_full_publication_schedule_v1()?
        if val Some(schedule) = self.hir_archive_schedule:
            if val Some(journal) = self.hir_archive_publication_journal:
                val captured = driver_hir_post_validation_policy_capture_v1(self.ctx, schedule, journal)?
                self.hir_archive_post_validation_policy = Some(captured)
                return Ok(captured)
        Err("post-HIR policy actual driver schedule or publication owner unavailable")
