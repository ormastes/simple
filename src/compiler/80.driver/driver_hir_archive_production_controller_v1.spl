# Actual bounded phase producer and private per-compilation publication owner.
# Root orchestration selects this controller only after supported route admission.
use compiler.driver.driver_compiler_type.{CompilerDriver}
use compiler.common.driver_core_types.{SourceFile}
use compiler.driver.driver_phase_gates.{driver_streaming_surface_route}
use compiler.driver.driver_hir_archive_schedule_owner_v1.*
use compiler.driver.driver_hir_post_validation_policy_owner_v1.*
use compiler.driver.driver_hir_pipeline_lowering.*
use compiler.driver.cache.driver_hir_archive_journal_v1.*
use compiler.driver.cache.driver_hir_archive_weave_boundary_v1.*
use compiler.driver.cache.hir_mono_final_repository_v1.*
use compiler.hir.hir_lowering.types.{hirlowering_for_module}
use compiler.hir.hir_lowering.module_surface.{ModuleSurfacesByName}
use compiler.hir.hir_lowering.items.{bootstrap_hir_modules_reset}
use compiler.driver.driver_hir_cache.{hir_cache_enabled, hir_cache_last_warnings, hir_cache_clear_last_warnings, hir_cache_summary}
use compiler.driver.driver_mem_snapshot.{mem_snapshot_begin, mem_snapshot_abort, mem_snapshot_finish_with_outcome}
use compiler.driver.driver_hir_pipeline_support.{driver_hir_mem_snapshot}
use compiler.driver.driver_log_helpers.{log_phase, log_build_progress}
use compiler.driver.perf.compiler_work_counters.{compiler_work_hir_schedule_v1}
use std.nogc_sync_mut.io.process_ops.{eprint}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}

struct DriverHirArchiveProductionHoldV1:
    generation: i64
    phase: i64
    boundary: DriverHirArchiveWeaveBoundaryV1? = nil
    repository: MonoArchiveFinalRepositoryV1? = nil

var _hir_production_ready_v1: bool = false
var _hir_production_generation_v1: i64 = 0
var _hir_production_holds_v1: Dict<i64, DriverHirArchiveProductionHoldV1> = {}

fn production_fail_v1(driver: CompilerDriver, message: text) -> bool:
    driver.ctx.add_error(message)
    false

# Must run before phase 1 selects tools/runtime or parses this compilation.
pub fn driver_hir_archive_production_begin_v1(driver: CompilerDriver) -> bool:
    if transient_array_scope_state_v1() != 0: return false
    # Legacy retained cache loads leave their already-replayed warning memo.
    # A new closed compilation boundary can clear that alias without dropping
    # the actual prior ctx warnings. Never clear another active/paused lease.
    hir_cache_clear_last_warnings()
    if not _hir_production_ready_v1:
        _hir_production_holds_v1 = {}
        _hir_production_ready_v1 = true
    if not driver_hir_source_body_revoke_driver_v1(driver) or not mono_archive_final_repository_revoke_driver_v1(driver): return false
    val word = driver as i64
    if word == 0: return false
    _hir_production_generation_v1 = _hir_production_generation_v1 + 1
    _hir_production_holds_v1[word] = DriverHirArchiveProductionHoldV1(generation: _hir_production_generation_v1, phase: 0)
    driver.hir_archive_managed_runtime_selection = nil
    driver.hir_archive_publication_journal = nil
    driver.hir_archive_schedule = nil
    driver.hir_archive_post_validation_policy = nil
    driver.ctx.hir_modules = {}
    driver.ctx.hir_module_count_value = 0
    driver.ctx.bootstrap_entry_hir = nil
    true

pub fn driver_hir_archive_production_phase3_v1(driver: CompilerDriver) -> bool:
    if transient_array_scope_state_v1() != 0 or hir_cache_last_warnings().len() != 0:
        # Never append a persistent diagnostic from another owner's scratch.
        return false
    val word = driver as i64
    if not _hir_production_ready_v1 or not _hir_production_holds_v1.has(word):
        return production_fail_v1(driver, "bounded HIR producer has no actual phase-1 generation")
    var hold: DriverHirArchiveProductionHoldV1 = _hir_production_holds_v1[word]
    if hold.phase != 0: return production_fail_v1(driver, "bounded HIR producer generation already consumed")
    # A phase-1 generation marker is not a producer. Once production is
    # attempted, every failure stays an explicit broken owner, never None.
    hold.phase = -1
    _hir_production_holds_v1[word] = hold
    if driver_streaming_surface_route(driver.ctx) != 1 or not driver.streaming_surface_owner_ready or not hir_cache_enabled():
        return production_fail_v1(driver, "bounded HIR producer requires actual streaming source owner and enabled admitted cache")
    if driver.ctx.sources.len() != driver.ctx.source_paths_owner.len() or
            driver.ctx.source_contents_owner.len() != driver.ctx.source_paths_owner.len():
        return production_fail_v1(driver, "bounded HIR producer does not admit projected or incomplete phase-1 inventory")
    if driver.hir_archive_publication_journal != nil or driver.hir_archive_post_validation_policy != nil:
        return production_fail_v1(driver, "bounded HIR producer refuses externally prepublished journal or policy")
    if driver.hir_archive_managed_runtime_selection == nil:
        return production_fail_v1(driver, "bounded HIR producer requires actual selected managed runtime owner")
    # Consume the phase once before any source publication. A failed producer
    # cannot be retried against its partially published journal in this generation.
    val captured = driver.capture_hir_archive_streaming_schedule_v1()
    if captured.is_err(): return production_fail_v1(driver, captured.unwrap_err())
    val schedule = captured.unwrap()
    if schedule.shard_mode: return production_fail_v1(driver, "bounded HIR producer does not admit shard publication")
    val created = driver_hir_archive_journal_create_v1(driver.ctx, driver.hir_archive_managed_runtime_selection.unwrap())
    if created.is_err(): return production_fail_v1(driver, created.unwrap_err())
    val journal = created.unwrap()
    # Phase 2 can finalize the frontend/cache scope after the initial runtime
    # route was selected. Journal creation recaptures that live header; every
    # subsequent archive input must use the same recaptured selection.
    driver.hir_archive_managed_runtime_selection = Some(journal.selection)
    driver.hir_archive_publication_journal = Some(journal)
    # The selected transaction ignores a public lowerer and constructs its own
    # genuine frozen-source owner. This empty compatibility argument carries no
    # provider/body graph; the real lowerer is never supplied by this controller.
    val compatibility_lowerer = hirlowering_for_module("", ModuleSurfacesByName.empty())
    bootstrap_hir_modules_reset()
    compiler_work_hir_schedule_v1(schedule.layout_source_order.len())
    if mem_snapshot_begin() < 0: return production_fail_v1(driver, "bounded HIR memory evidence sink unavailable")
    var poisoned: Dict<i64, bool> = {}
    var completed: Dict<i64, bool> = {}
    var physical_done = 0
    var logical_done = 0
    var position = 0
    log_build_progress("hir", "modules", 0, schedule.layout_source_order.len(), "pending", 2, 6, 0, 0, "running")
    for source_index in schedule.visit_order:
        val first = schedule.first_source_for_visit[position]
        position = position + 1
        val name = driver.ctx.source_module_names_owner[source_index]
        val path = driver.ctx.source_paths_owner[source_index]
        if first != source_index:
            if poisoned.has(first): continue
            if not completed.has(first):
                mem_snapshot_abort()
                return production_fail_v1(driver, "bounded HIR alias precedes actual completed physical owner")
            val alias = driver_hir_archive_journal_alias_v1(journal, driver.ctx, source_index, name,
                driver.ctx.source_module_names_owner[first])
            if alias.is_err():
                mem_snapshot_abort()
                return production_fail_v1(driver, alias.unwrap_err())
            logical_done = logical_done + 1
        else:
            val source = SourceFile(path: path, authored_path: driver.ctx.source_authored_paths_owner[source_index],
                content: driver.ctx.source_contents_owner[source_index], module_name: name)
            val transaction = driver.lower_streaming_hir_selected_archived_shard_transaction_v1(
                compatibility_lowerer, source, source_index, source_index == driver.streaming_entry_source_index_owner, journal.registration)
            if transaction.is_err():
                mem_snapshot_abort()
                return production_fail_v1(driver, transaction.unwrap_err())
            val receipt = transaction.unwrap()
            if receipt.status < 0:
                mem_snapshot_abort()
                return false
            if receipt.status == 2:
                poisoned[source_index] = true
                driver.ctx.mark_module_poisoned(name)
                if driver.ctx.poison_budget_exhausted():
                    val finished = mem_snapshot_finish_with_outcome("hir-diagnostic")
                    if not finished: return production_fail_v1(driver, "bounded HIR diagnostic evidence terminal failed")
                    return false
                continue
            if receipt.archive == nil or receipt.declaration_registration == nil:
                mem_snapshot_abort()
                return production_fail_v1(driver, "bounded HIR real source transaction omitted compact publication")
            val published = driver_hir_archive_journal_publish_v1(journal, driver.ctx, source_index, name,
                receipt.declaration_registration.unwrap())
            if published.is_err():
                mem_snapshot_abort()
                return production_fail_v1(driver, published.unwrap_err())
            completed[source_index] = true
            physical_done = physical_done + 1
            logical_done = logical_done + 1
            log_phase("phase3:hir:archive:file:done {path} module={name}")
            log_build_progress("hir", "modules", physical_done, schedule.layout_source_order.len(), name, 2, 6, 0, 0, "running")
        # There are zero resident complete HIR modules/validation views here.
        # Real closed transactions reset their module-local trait counter.
        if not driver_hir_mem_snapshot("hir-archive-publication", source_index, path, 0, 0, 0, 0):
            mem_snapshot_abort()
            return production_fail_v1(driver, "bounded HIR durable memory snapshot publication failed")
    print hir_cache_summary()
    val outcome = if poisoned.len() == 0: "hir-complete" else: "hir-diagnostic"
    if not mem_snapshot_finish_with_outcome(outcome): return production_fail_v1(driver, "bounded HIR durable terminal publication failed")
    driver.ctx.hir_module_count_value = logical_done
    if poisoned.len() != 0:
        eprint("[collect-all] {poisoned.len()} module(s) poisoned across {schedule.visit_order.len()} source(s) in bounded streaming HIR; downstream passes do not run")
        return false
    if physical_done != schedule.layout_source_order.len() or logical_done != schedule.logical_publication_order.len() or
            journal.logical_order != schedule.logical_publication_order:
        return production_fail_v1(driver, "bounded HIR actual complete visit/publication coverage differs")
    val policy = driver.capture_hir_archive_post_validation_policy_v1()
    if policy.is_err(): return production_fail_v1(driver, policy.unwrap_err())
    # The genuine capture replays real complete bodies and source custody,
    # publishes actual fatal diagnostics, consumes actual RT policy once and
    # performs ordered shared-body advice. No caller report/flag is accepted.
    val boundary = driver_hir_archive_weave_boundary_capture_with_failure_v1(driver)
    match boundary:
        case Err(DriverHirArchiveWeaveFailureV1.Unpublished(message)):
            return production_fail_v1(driver, message)
        case Err(DriverHirArchiveWeaveFailureV1.AlreadyPublished(_)):
            return false
        case Ok(owner):
            hold.boundary = Some(owner)
    hold.phase = 3
    _hir_production_holds_v1[word] = hold
    true

pub fn driver_hir_archive_production_phase4_v1(driver: CompilerDriver,
        force_all_sources: bool, allow_bootstrap_shortcuts: bool,
        allow_ambient_bootstrap_policy: bool = false) -> bool:
    if transient_array_scope_state_v1() != 0 or hir_cache_last_warnings().len() != 0: return false
    val word = driver as i64
    if not _hir_production_ready_v1 or not _hir_production_holds_v1.has(word):
        return production_fail_v1(driver, "bounded mono lacks actual HIR producer")
    var hold: DriverHirArchiveProductionHoldV1 = _hir_production_holds_v1[word]
    if hold.phase != 3 or hold.boundary == nil: return production_fail_v1(driver, "bounded mono actual HIR producer incomplete")
    hold.phase = -1
    _hir_production_holds_v1[word] = hold
    val repository = mono_archive_final_repository_capture_production_v1(driver, hold.boundary.unwrap(),
        force_all_sources, allow_bootstrap_shortcuts, allow_ambient_bootstrap_policy)
    match repository:
        case Err(MonoArchiveFinalFailureV1.Unpublished(diagnostics)):
            for diagnostic in diagnostics: driver.ctx.add_error(diagnostic)
            return false
        case Err(MonoArchiveFinalFailureV1.AlreadyPublished(_)):
            return false
        case Ok(repo):
            hold.repository = Some(repo)
    hold.phase = 4
    _hir_production_holds_v1[word] = hold
    true

pub fn driver_hir_archive_production_repository_in_owned_scope_v1(driver: CompilerDriver) -> Result<MonoArchiveFinalRepositoryV1, text>:
    val selected = driver_hir_archive_production_try_repository_in_owned_scope_v1(driver)?
    if val repo = selected: return Ok(repo)
    Err("production repository has no actual producer")

pub fn driver_hir_archive_production_try_repository_in_owned_scope_v1(driver: CompilerDriver) -> Result<MonoArchiveFinalRepositoryV1?, text>:
    if transient_array_scope_state_v1() != 1: return Err("production repository requires actual borrowed lease")
    val word = driver as i64
    if not _hir_production_ready_v1 or not _hir_production_holds_v1.has(word): return Ok(nil)
    val hold: DriverHirArchiveProductionHoldV1 = _hir_production_holds_v1[word]
    # begin's untouched marker also admits ordinary retained compilations.
    # No actual producer has run; failed/staged/revoked owners below are Err.
    if hold.phase == 0: return Ok(nil)
    if hold.phase != 4 or hold.boundary == nil or hold.repository == nil: return Err("production repository producer/final transaction incomplete")
    val repo = hold.repository.unwrap()
    if not mono_archive_final_repository_matches_v1(driver, repo): return Err("production repository private final pin refused")
    Ok(Some(repo))

# Root calls this only after all declaration, provider and MIR body leases end.
pub fn driver_hir_archive_production_finish_v1(driver: CompilerDriver) -> bool:
    if transient_array_scope_state_v1() != 0: return false
    val revoked = mono_archive_final_repository_revoke_driver_v1(driver)
    if _hir_production_ready_v1 and _hir_production_holds_v1.has(driver as i64):
        val previous = _hir_production_holds_v1[driver as i64]
        _hir_production_holds_v1[driver as i64] = DriverHirArchiveProductionHoldV1(generation: previous.generation, phase: -2)
    revoked

export driver_hir_archive_production_begin_v1, driver_hir_archive_production_phase3_v1
export driver_hir_archive_production_phase4_v1, driver_hir_archive_production_repository_in_owned_scope_v1
export driver_hir_archive_production_finish_v1
export driver_hir_archive_production_try_repository_in_owned_scope_v1
