# Intake only: no provider or runtime dependency is evaluated by this gate.
# Native profile admission and emission are not implemented by a build route.
use common.plugin.aspect_params.{AspectParamsV1}
use common.trace.observer_contract_v1.{TraceFailureV1}
use common.trace.observer_aspect_config_v1.{trace_aspect_config_v1}
use common.trace.observer_build_route_v1.{TraceBuildRouteKindV1, trace_build_route_v1}

pub fn driver_observer_request_v1(params: AspectParamsV1, target: text) -> Result<bool, TraceFailureV1>:
    val requested = trace_aspect_config_v1(params)?
    if val config = requested:
        val route = trace_build_route_v1(target, config.instrumentation, config.backend)?
        if route.kind != TraceBuildRouteKindV1.Off:
            # Do not fabricate a Feature receipt from config, target or map.
            return Err(TraceFailureV1.UnsupportedProfile)
    Ok(true)
