    driver_parse_transient_scope_pause_v1, driver_promote_retained_frontend_owners_v1,
    driver_end_transient_parse_scope}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.nogc_sync_mut.sffi.transient.{transient_promote}
use std.common.base_encoding.utilities.{validated_utf8_bytes_to_text_linear}
use std.common.crypto.sha256.{sha256_u8_hex}
use compiler.driver.semantic_owner_prerequisite_types_v1.*
use compiler.frontend.frontend_target_cfg_receipt_v1.{FrontendCfgDecisionReceiptV1}
