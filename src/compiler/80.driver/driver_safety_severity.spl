# Safety-pass profile-gated severity (lane SE1, 2026-07-28).
#
# Split out of driver.spl on its own lightweight-import pattern (see the
# comment atop driver_types.spl). DELIBERATELY SELF-CONTAINED — this file
# must not import compiler.tools.lint.main:
#   1. Layering: 80.driver importing 90.tools is an upward dependency; the
#      lint CLI sits above the driver, not below it.
#   2. Interpreter contamination: executing lint-main's module graph and then
#      parse_full_frontend in one interpreter session deterministically fails
#      with "semantic: type mismatch: cannot convert dict to int" — see
#      doc/08_tracking/bug/interp_lint_main_then_frontend_dict_to_int_2026-07-28.md.
#      driver.spl parses source in the same session, so pulling lint-main into
#      its graph reproduces exactly that hazard inside the real compiler.
#
# WP-3 (2026-08-07) resolved that WITHOUT inverting the dependency: the
# profile-name table moved DOWN to `compiler.common.assurance.policy_names`,
# which 00.common owns and every layer above may import. Reason 1 is satisfied
# because 00.common is below 80.driver, not above it. Reason 2 was re-measured
# and no longer reproduces (probe:
# test/01_unit/compiler/assurance/policy_graph_contamination_probe_spec.spl);
# policy_names.spl additionally carries zero `use` lines and zero module-level
# state, which the bug record names as the likely trigger.
#
# What is left here is the DRIVER'S PROJECTION of that shared table onto
# SafetyPassSeverity. It stays here deliberately: the same four names carry
# three different meanings across the tree (lint -> level dict, driver ->
# SafetyPassSeverity, interpreter -> bool), so the names converge and the
# semantics do not.
#
# Deprecation warn-once for old spellings stays the lint CLI's job; a
# build-time env knob repeating it would only add noise.
#
# See doc/08_tracking/bug/safety_checker_pass_never_invoked_2026-07-27.md.

use compiler.common.assurance.policy_names.normalize_profile_name
use compiler.common.assurance.warning_phase.{warning_phase_enabled_for_value,
    warning_phase_env_var_name, downgrade_severity_rank,
    severity_rank_advisory, severity_rank_warn, severity_rank_deny}
use compiler.common.assurance.policy_schema.{AssuranceStrictness, ResolvedAssurancePolicyV1}

@unsafe(reason: "raw subprocess-policy environment read; empty text conflates unset input with provider failure", capabilities: [ffi])
extern fn rt_env_get(key: text) -> text

# Enforcement severity for the safety pass, independent of LintLevel (Allow/
# Warn/Deny) since the safety pass has no "allow" state — every rule always
# produces a diagnostic string for the existing SIMPLE_SAFETY_WARN log path;
# this only controls whether that diagnostic ALSO lands in the compile
# context and at what severity.
enum SafetyPassSeverity:
    Advisory  # log-only (today's behavior); never touches ctx
    Warn      # ctx.add_warning — visible, does not fail the build
    Deny      # ctx.add_error — fails the build

# Settled severity mapping (user decision, 2026-07-28): moderate/strict stay
# advisory (log-only, no build impact — current behavior, unchanged);
# robust WARNS (migration window: make the gap visible without breaking any
# currently-building program); critical DENIES (Rust-parity hard error).
# Nothing may escalate to Deny at robust — that is the entire point of the
# migration window. Unknown or empty resolves to Advisory, i.e. today's exact
# behavior is preserved unless a caller opts in explicitly.
pub fn safety_pass_severity_for_name(raw: text) -> SafetyPassSeverity:
    # Aliases (lib -> strict, reliable -> robust, mission-critical ->
    # critical) are resolved by the shared table, NOT re-listed here. That is
    # the whole point of WP-3: adding a profile name in one place now reaches
    # this projection automatically.
    val canonical = normalize_profile_name(raw)
    if canonical == "robust":
        return SafetyPassSeverity.Warn
    if canonical == "critical" or canonical == "verified":
        # `verified` is the strongest rung of the canonical ladder but has no
        # AssuranceStrictness (V1) variant -- see policy_schema.from_name(),
        # which projects it onto Critical rather than the permissive default.
        # This projection must agree, or asking for the STRICTEST profile
        # would silently downgrade the safety pass to advisory.
        return SafetyPassSeverity.Deny
    # moderate, strict, unset, and anything unrecognized: advisory.
    SafetyPassSeverity.Advisory

# TYPED-STATE projection (WP-3). This is the form the driver should use once a
# `ResolvedAssurancePolicyV1` is threaded down to it: severity becomes a
# function of an in-process value that every command resolved identically and
# can prove identical via `policy_hash()`, instead of a process-global string
# that two components can read at two different times.
pub fn safety_pass_severity_for_policy(policy: ResolvedAssurancePolicyV1) -> SafetyPassSeverity:
    safety_pass_severity_for_strictness(policy.strictness)

pub fn safety_pass_severity_for_strictness(strictness: AssuranceStrictness) -> SafetyPassSeverity:
    match strictness:
        AssuranceStrictness.Critical: SafetyPassSeverity.Deny
        AssuranceStrictness.Robust: SafetyPassSeverity.Warn
        AssuranceStrictness.Strict: SafetyPassSeverity.Advisory
        AssuranceStrictness.Moderate: SafetyPassSeverity.Advisory

# SUBPROCESS-BOUNDARY deserializer. After WP-3 the env var's only sanctioned
# job is carrying an already-resolved policy across a process boundary
# (`policy_env_value` is the writer). Kept because the driver still has no
# threaded policy parameter of its own — every in-process caller that DOES
# have one must call safety_pass_severity_for_policy instead, so the two
# cannot drift the way premise 5b describes.
#
# Dedicated env knob (SIMPLE_SAFETY_PROFILE), not engine_default_profile:
# mapping the safety pass onto --engine=interpreter|jit|native is REQ-MC-012
# plumbing, a separate lane, not implemented here.
pub fn safety_pass_severity() -> SafetyPassSeverity:
    var raw_profile = ""
    unsafe(capabilities: [ffi]):
        raw_profile = rt_env_get("SIMPLE_SAFETY_PROFILE")
    safety_pass_severity_for_name(raw_profile ?? "")

# ---------------------------------------------------------------------------
# WARNING PHASE (2026-08-23) — the driver's projection of the one-level
# severity downgrade. See compiler.common.assurance.warning_phase for why this
# is a MODIFIER with its own env knob rather than a new profile spelling (a
# suffix spelling fails OPEN at any un-updated projection; a separate knob
# fails CLOSED).
#
# The driver's ladder floor is Advisory, NOT "off": Advisory is log-only via
# the existing SIMPLE_SAFETY_WARN path, so it still REPORTS. There is no
# silent rung below it to fall into, which is exactly the property the feature
# requires — a downgraded diagnostic must never become invisible.
# ---------------------------------------------------------------------------

fn _safety_severity_rank(sev: SafetyPassSeverity) -> i64:
    match sev:
        SafetyPassSeverity.Deny: severity_rank_deny()
        SafetyPassSeverity.Warn: severity_rank_warn()
        SafetyPassSeverity.Advisory: severity_rank_advisory()

fn _safety_severity_of_rank(rank: i64) -> SafetyPassSeverity:
    if rank >= severity_rank_deny():
        return SafetyPassSeverity.Deny
    if rank == severity_rank_warn():
        return SafetyPassSeverity.Warn
    SafetyPassSeverity.Advisory

# Drop `sev` exactly one level, clamping at Advisory.
pub fn safety_pass_severity_downgraded(sev: SafetyPassSeverity) -> SafetyPassSeverity:
    _safety_severity_of_rank(downgrade_severity_rank(_safety_severity_rank(sev),
                                                     severity_rank_advisory()))

# Pure, parameterised form: the projection of `raw` under an explicit warning
# phase. `warning_phase == false` returns exactly what
# safety_pass_severity_for_name returns, so non-warning mode is unchanged by
# construction rather than by inspection.
# Non-`pub`: bare-primitive `bool` parameter, same `primitive_api` convention
# as warning_phase.spl uses; a plain `fn` is still importable cross-module.
fn safety_pass_severity_for_name_phased(raw: text, warning_phase: bool) -> SafetyPassSeverity:
    val base = safety_pass_severity_for_name(raw)
    if not warning_phase:
        return base
    safety_pass_severity_downgraded(base)

fn safety_pass_severity_for_strictness_phased(strictness: AssuranceStrictness,
                                                  warning_phase: bool) -> SafetyPassSeverity:
    val base = safety_pass_severity_for_strictness(strictness)
    if not warning_phase:
        return base
    safety_pass_severity_downgraded(base)

fn safety_pass_severity_for_policy_phased(policy: ResolvedAssurancePolicyV1,
                                              warning_phase: bool) -> SafetyPassSeverity:
    safety_pass_severity_for_strictness_phased(policy.strictness, warning_phase)

# Thin env wrapper — the ONLY process-global read on this path, deliberately
# separated from the pure functions above so specs never need to mutate the
# environment. Deserialised at the subprocess boundary exactly like
# SIMPLE_SAFETY_PROFILE is.
fn safety_pass_warning_phase() -> bool:
    var raw_phase = ""
    unsafe(capabilities: [ffi]):
        raw_phase = rt_env_get(warning_phase_env_var_name())
    warning_phase_enabled_for_value(raw_phase ?? "")

pub fn safety_pass_severity_phased() -> SafetyPassSeverity:
    var raw_profile = ""
    unsafe(capabilities: [ffi]):
        raw_profile = rt_env_get("SIMPLE_SAFETY_PROFILE")
    safety_pass_severity_for_name_phased(raw_profile ?? "", safety_pass_warning_phase())
