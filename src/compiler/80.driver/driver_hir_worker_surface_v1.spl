# Lazy restore in HIR shard workers (packed_binary_ast_v1.md step 3).
#
# On the streaming-surface route the phase-2 parse of every module exists only
# to build its ModuleSurface; HIR lowering re-parses each module it lowers from
# the full source (lower_streaming_surface_source). A HIR shard worker lowers
# only the modules it claims, so for the surface pass it parses the module's
# SURFACE SKELETON instead of its source: the same file with non-generic
# bodies blanked line for line (module_surface_skeleton_v1, the .tldr v6
# `surface` section), whose surface equals the full-parse surface. Full ASTs
# are built only for the claimed modules, at claim time.
#
# Default ON in HIR shard workers; SIMPLE_HIR_WORKER_SKELETON=0 opts out. The
# projection blind spot that kept this opt-in is fixed (doc/08_tracking/bug/
# module_surface_projection_blind_to_primitive_param_types_2026-10-24.md);
# skeleton/full equality is pinned by worker_surface_differential_spec.
use compiler.driver.cache.module_surface_skeleton_v1.{module_surface_skeleton_v1}
use compiler.driver.driver_build.native_file_worker_v1.{native_file_worker_unit_active_v1}

pub fn driver_hir_worker_skeleton_selected_v1(hir_shard_spec: text, flag: text) -> bool:
    hir_shard_spec != "" and flag != "0"

# Text the surface pass parses for one module: the skeleton in an HIR
# shard worker, the full source everywhere else -- including a per-file unit
# child, which lowers (and caches) the full HIR of any import not cached yet.
pub fn driver_surface_parse_text_v1(source_content: text, hir_shard_spec: text, flag: text) -> text:
    if driver_hir_worker_skeleton_selected_v1(hir_shard_spec, flag) and not native_file_worker_unit_active_v1():
        return module_surface_skeleton_v1(source_content)
    source_content

# Phase-2 verdict for the surface pass. A parse error poisons only its own
# module (collect-all), and each poisoned module carries exactly one parse
# diagnostic. Outside a HIR shard worker any error still fails phase 2. Inside
# one, errors that are all poisoned-module parse errors let the worker go on
# into HIR, where each poisoned module becomes a FAILED ledger row
# (driver_hir_worker_parse_failed_row_v1) and every other module is lowered.
# Run-26 compiler_cli_build: one skeleton parse error
# (feature_caps_arch32.spl 146:44) killed every worker at claimed=0.
pub fn driver_hir_worker_parse_verdict_v1(error_count: i64, poisoned_count: i64,
        hir_shard_spec: text) -> bool:
    if error_count == 0:
        return true
    hir_shard_spec != "" and poisoned_count > 0 and error_count == poisoned_count

# A source row with no surface is a FAILED row (not a missing-surface invariant
# break) exactly when a HIR shard worker poisoned its module in phase 2.
pub fn driver_hir_worker_parse_failed_row_v1(hir_shard_mode: bool, poisoned: bool) -> bool:
    hir_shard_mode and poisoned

export driver_hir_worker_skeleton_selected_v1, driver_surface_parse_text_v1
export driver_hir_worker_parse_verdict_v1, driver_hir_worker_parse_failed_row_v1
