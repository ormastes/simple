# Lazy restore in HIR shard workers (packed_binary_ast_v1.md step 3).
#
# On the streaming-surface route the phase-2 parse of every module exists only
# to build its ModuleSurface; HIR lowering re-parses each module it lowers from
# the full source (lower_streaming_surface_source). A HIR shard worker lowers
# only the modules it claims, so for the surface pass it parses the module's
# SURFACE SKELETON instead of its source: the same file with non-generic
# bodies blanked line for line (module_surface_skeleton_v1, the .tldr v6
# `surface` section), whose surface equals the full-parse surface. Full ASTs
# are built only for the claimed modules, at claim time.
#
# Default ON in HIR shard workers; SIMPLE_HIR_WORKER_SKELETON=0 opts out. The
# projection blind spot that kept this opt-in is fixed (doc/08_tracking/bug/
# module_surface_projection_blind_to_primitive_param_types_2026-10-24.md);
# skeleton/full equality is pinned by worker_surface_differential_spec.
use compiler.driver.cache.module_surface_skeleton_v1.{module_surface_skeleton_v1}

pub fn driver_hir_worker_skeleton_selected_v1(hir_shard_spec: text, flag: text) -> bool:
    hir_shard_spec != "" and flag != "0"

# Text the surface pass parses for one module: the skeleton in an HIR
# shard worker, the full source everywhere else.
pub fn driver_surface_parse_text_v1(source_content: text, hir_shard_spec: text, flag: text) -> text:
    if driver_hir_worker_skeleton_selected_v1(hir_shard_spec, flag):
        return module_surface_skeleton_v1(source_content)
    source_content

export driver_hir_worker_skeleton_selected_v1, driver_surface_parse_text_v1
