# Driver API facade.
# Keep this module lightweight so selective imports can resolve only the
# requested helper instead of parsing and evaluating the full compiler graph.

pub use compiler.driver.driver_api_types.{find_runtime_lib_dir}
pub use compiler.driver.driver_api_interpret.{try_load_smf_cached}
pub use compiler.driver.driver_public_api.{interpret_file, generate_headers}
pub use compiler.driver.driver_public_shared.{aot_shared_library}
# The six single-file compile entry points come from the IN-PROCESS driver
# (Tier 2), not from the process-delegating facade. Delegating them spawns the
# resolved `simple` CLI, which under `bin/simple test` is the CLI already
# running — the compile-delegation loop. `driver_api_compile_single` reaches
# the driver through `use lazy`, so this stays as light to IMPORT as before and
# only builds the compiler graph if one of these is actually called. Callers
# that genuinely want subprocess isolation use the explicit `external_*` names
# in driver_public_compile_process.spl.
pub use compiler.driver.driver_api_compile_single.{
    compile_file, compile_to_smf, compile_files, jit_file, check_file, parse_sdn_file
}
pub use compiler.driver.driver_public_compile.{
    aot_file, aot_c_file,
    aot_llvm_file, aot_llvm_native_file, aot_native_file_with_backend,
    aot_native_project_with_backend, aot_cuda_file, aot_opencl_file, aot_vhdl_file
}
