# Action-key wiring — bind REAL producers to ActionKeyV2 positions 16-19.
#
# Contract: doc/03_plan/compiler/cache/c0_schema_freeze_2026-08-09.md §1
#           src/compiler/80.driver/cache/schema/cache_protocol.sdn
# Design:   doc/05_design/compiler/... §14, §17.4
#
# THE RULE THIS FILE EXISTS TO ENFORCE (C0 sentinel rule):
#   A field whose producer does not exist carries the fixed sentinel. It is
#   NEVER given a fabricated or "close enough" digest, because a fabricated
#   digest makes two semantically different actions share one key — a false
#   cache hit, which is the one failure mode this whole subsystem must not have.
#
# Backing status as of this wiring (each justified against the `prerequisite:`
# recorded in cache_protocol.sdn, not against wishful thinking):
#
#   pos 16 aop_surface_root              BACKED   <- pointcut_selection_digest
#       prerequisite: "pub-pointcut / join-point publicization".
#       C4 landed JoinPointDescriptor + a read-set-projected selection digest,
#       which IS the publicized join-point surface. A root over the selection
#       digests visible to the action is a real, recomputable value.
#
#   pos 17 aop_candidate_partition_roots SENTINEL (empty set)
#       prerequisite: "candidate Merkle partitioning; today all join points are
#       global". No partitioner exists. C4's own header says so explicitly
#       (selector_reverse_index.spl: "it depends solely on the read set — not
#       on candidate partitioning (which does not exist)"). Recording one
#       implicit global partition would assert precision the tree lacks.
#
#   pos 18 aop_weave_root                SENTINEL
#       prerequisite: "per-target weave artifacts (replace in-place MIR
#       mutation)". Weaving is still in-place MIR mutation; there is no weave
#       ARTIFACT to digest. Nothing to root.
#
#   pos 19 block_manifest_roots          BACKED   <- BlockKeyMap (C5)
#       prerequisite: "stable BlockKey + BlockId->BlockKey map + a dataflow
#       framework". C5 landed all three (block_key.spl, BlockKeyMap,
#       60.mir_opt/incremental/dataflow.spl). Fail-closed on ambiguity: an
#       ambiguous BlockKeyMap yields NO root and marks the action uncacheable.

use std.common.crypto.sha256.{sha256_text}
use compiler.driver.cache.action_key.{
    ActionKey, ActionKeyV2, ActionDep, ResultKind,
    canon_field, canon_seq, canon_str,
    action_key_sort_texts,
    action_key_v2_sentinel_root_digest, action_key_v2_empty_root_set
}
use compiler.mdsoc.aop_index.pointcut_query.{PointcutQuery}
use compiler.mdsoc.aop_index.join_point_descriptor.{JoinPointDescriptor}
use compiler.mdsoc.aop_cache.pointcut_digest.{pointcut_selection_digest}
use compiler.mir.incremental.block_key.{BlockKeyMap, block_key_digest}

val AOP_SURFACE_ROOT_DOMAIN: text = "simple/aop-surface-root/v2"
val BLOCK_MANIFEST_ROOT_DOMAIN: text = "simple/block-manifest-root/v2"

# ============================================================================
# Root construction (canonical, sorted, domain-separated)
# ============================================================================

# Root of a SET of digests: sort, length-prefix, domain-separate, hash.
# Domain separation is what stops an aop root and a block root that happen to
# cover the same digest set from colliding.
fn cache_root_of_digest_set(domain: text, digests: [text]) -> text:
    val sorted = action_key_sort_texts(digests)
    var items: [text] = []
    for d in sorted:
        items.push(canon_str(d))
    sha256_text(canon_field(domain, canon_seq(items)))

# ============================================================================
# pos 16 — AOP surface root (BACKED)
# ============================================================================

# The AOP surface this action can observe: every (pointcut query, join point)
# verdict identity. Ordered inputs, set-valued output (order of enumeration is
# not semantic; the verdict set is).
#
# EMPTY INPUT => SENTINEL, deliberately. "This action sees no AOP surface" and
# "no AOP surface producer exists" are the same fact for key purposes: neither
# lets AOP influence the result. Emitting a root-of-empty-set instead would
# introduce a second value with identical meaning, splitting the cache for no
# semantic reason.
fn aop_surface_root_of(queries: [PointcutQuery], descriptors: [JoinPointDescriptor]) -> text:
    if queries.is_empty() or descriptors.is_empty():
        return action_key_v2_sentinel_root_digest()
    var digests: [text] = []
    for q in queries:
        for d in descriptors:
            digests.push(pointcut_selection_digest(q, d))
    cache_root_of_digest_set(AOP_SURFACE_ROOT_DOMAIN, digests)

# ============================================================================
# pos 19 — block manifest roots (BACKED, fail-closed)
# ============================================================================

# A block-manifest root plus whether it may be used as a cache key at all.
# `cacheable == false` means the caller MUST NOT consult or publish a cache
# entry for this action: an ambiguous BlockKeyMap means two distinct blocks
# share a key, so any block-level result identity built on it is unsound.
struct BlockManifestRoot:
    root: text
    cacheable: bool

fn block_manifest_root_uncacheable() -> BlockManifestRoot:
    BlockManifestRoot(root: "", cacheable: false)

# Merkle root over one function's BlockKey digests.
fn block_manifest_root_of(map: BlockKeyMap) -> BlockManifestRoot:
    # FAIL CLOSED. C5 sets `ambiguous` exactly when whole-function fallback is
    # required, i.e. when block identity is NOT stable. Producing a root here
    # would be the fabricated-digest failure this file exists to prevent.
    if map.ambiguous:
        return block_manifest_root_uncacheable()
    var digests: [text] = []
    for k in map.keys:
        digests.push(block_key_digest(k))
    BlockManifestRoot(root: cache_root_of_digest_set(BLOCK_MANIFEST_ROOT_DOMAIN, digests), cacheable: true)

# The set of block-manifest roots an action CONSUMES (schema §fields[19]).
# One entry per consumed function manifest. Any ambiguous map poisons the
# whole set: the action is uncacheable, and we say so rather than silently
# dropping the offending function (dropping would produce a valid-looking key
# for an action whose block identity is unknown — a false hit).
struct BlockManifestRootSet:
    roots: [text]
    cacheable: bool

fn block_manifest_roots_of(maps: [BlockKeyMap]) -> BlockManifestRootSet:
    var roots: [text] = []
    for m in maps:
        val r = block_manifest_root_of(m)
        if not r.cacheable:
            return BlockManifestRootSet(roots: [], cacheable: false)
        roots.push(r.root)
    BlockManifestRootSet(roots: action_key_sort_texts(roots), cacheable: true)

# ============================================================================
# The wired key
# ============================================================================

# Everything an action contributes to positions 16-19, plus the verdict on
# whether it may participate in the cache at all.
struct ActionRoots:
    aop_surface_root: text                       # pos 16 — backed or sentinel
    aop_candidate_partition_roots: [text]        # pos 17 — ALWAYS empty (no producer)
    aop_weave_root: text                         # pos 18 — ALWAYS sentinel (no producer)
    block_manifest_roots: [text]                 # pos 19 — backed or empty
    cacheable: bool

fn action_roots_collect(
    queries: [PointcutQuery],
    descriptors: [JoinPointDescriptor],
    block_maps: [BlockKeyMap]
) -> ActionRoots:
    val bm = block_manifest_roots_of(block_maps)
    ActionRoots(
        aop_surface_root: aop_surface_root_of(queries, descriptors),
        # pos 17: no candidate partitioner exists. Not a placeholder for a
        # value we could compute — a statement that the value does not exist.
        aop_candidate_partition_roots: action_key_v2_empty_root_set(),
        # pos 18: no per-target weave artifact exists.
        aop_weave_root: action_key_v2_sentinel_root_digest(),
        block_manifest_roots: bm.roots,
        cacheable: bm.cacheable
    )

# Build the v2 key with positions 16-19 filled from real producers where they
# exist. Compare with `action_key_v2_from_v1`, which pins ALL FOUR to the
# sentinel — that remains the correct constructor for a caller with no AOP or
# block inputs to offer.
fn action_key_v2_wired(
    v1: ActionKey,
    schema_digest: text,
    result_kind: ResultKind,
    roots: ActionRoots
) -> ActionKeyV2:
    ActionKeyV2(
        domain: v1.domain,
        compiler_exe: v1.compiler_exe,
        live_compiler_src: v1.live_compiler_src,
        schema_version: v1.schema_version,
        target_triple: v1.target_triple,
        host_arch: v1.host_arch,
        cfg_features: v1.cfg_features,
        stdlib_variant: v1.stdlib_variant,
        runtime_family: v1.runtime_family,
        source_content: v1.source_content,
        resolution_witness: v1.resolution_witness,
        deps: v1.deps,
        macro_root: v1.macro_root,
        aop_selection: v1.aop_selection,
        ct_env_inputs: v1.ct_env_inputs,
        schema_digest: schema_digest,
        aop_surface_root: roots.aop_surface_root,
        aop_candidate_partition_roots: roots.aop_candidate_partition_roots,
        aop_weave_root: roots.aop_weave_root,
        block_manifest_roots: roots.block_manifest_roots,
        result_kind: result_kind
    )

# True when a field is still riding the unbacked sentinel. Used by
# `simple cache explain` to report honestly which positions are live.
fn action_key_v2_field_is_sentinel(value: text) -> bool:
    value == action_key_v2_sentinel_root_digest()
