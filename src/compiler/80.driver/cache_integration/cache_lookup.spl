# Exact-key tier lookup + STRICT SHADOW COMPARISON.
#
# Design §14.2 (tier order), §20.2 (explain fields).
#
# EXACT-KEY ONLY. There is no prefix key, no restore key, no nearest-branch
# key, no timestamp tie-break and no filename fallback anywhere in this file
# or in the router it calls. A miss is a miss and the caller computes.
#
# DEGRADE-TO-COMPUTE INVARIANT: every failure path here — miss, uncacheable
# action, unshareable result, full cache, absent/unavailable remote, shadow
# divergence — returns "compute it yourself". None of them can change what the
# build produces; the worst outcome is lost speed.
#
# SHADOW MODE is the migration safety net and is built here, up front, not
# bolted on later: with it enabled every hit is recomputed from scratch and the
# two identities compared. A divergence means the key is missing an input, i.e.
# a live false-hit bug, and is reported with the exact field that differs.

use compiler.driver.cache.cas_store.{ResultManifest, result_manifest_digest}
use compiler.driver.cache.tier_router.tier_router.{
    TierRoots, TierLookupResult, RemoteActionIndex,
    tier_router_lookup, tier_router_publish_workspace, tier_lookup_miss
}
use compiler.driver.cache.action_index.action_index.{ActionIndexPutOutcome}
use compiler.driver.cache.action_key.{ActionKeyV2, action_key_v2_digest}
use compiler.driver.cache_integration.key_wiring.{ActionRoots}

# ============================================================================
# Cache mode (design §20.1 `--cache=`)
# ============================================================================

enum CacheMode:
    Off
    Local
    Machine
    RemoteRead
    RemoteReadWrite

fn cache_mode_name(m: CacheMode) -> text:
    match m:
        case Off: "off"
        case Local: "local"
        case Machine: "machine"
        case RemoteRead: "remote-read"
        case RemoteReadWrite: "remote-read-write"

fn cache_mode_reads(m: CacheMode) -> bool:
    match m:
        case Off: false
        case Local: true
        case Machine: true
        case RemoteRead: true
        case RemoteReadWrite: true

fn cache_mode_may_write_remote(m: CacheMode) -> bool:
    match m:
        case RemoteReadWrite: true
        case Off: false
        case Local: false
        case Machine: false
        case RemoteRead: false

# ============================================================================
# Lookup
# ============================================================================

# Why no result was served. Every value is a REASON THE CALLER COMPUTES —
# there is deliberately no "served something approximate" outcome.
enum MissReason:
    NoMiss
    CacheDisabled
    ActionUncacheable        # ambiguous block manifest etc. — key is not sound
    ExactKeyAbsent           # the honest, common case
    TierUnavailable          # remote down / cache full — degrade, never fail

fn miss_reason_text(r: MissReason) -> text:
    match r:
        case NoMiss: "hit"
        case CacheDisabled: "cache disabled (--cache=off)"
        case ActionUncacheable: "action is uncacheable (unsound key inputs)"
        case ExactKeyAbsent: "exact ActionDigest absent"
        case TierUnavailable: "tier unavailable — degraded to computation"

struct CacheLookup:
    hit: bool
    tier: text                       # "process"|"workspace"|"machine"|"remote-main"|"miss"
    action_digest: text
    result_manifest_digest: text
    manifest: ResultManifest?
    miss_reason: MissReason
    must_compute: bool               # ALWAYS true on anything but a verified hit

fn cache_lookup_compute(action_digest: text, reason: MissReason) -> CacheLookup:
    CacheLookup(
        hit: false, tier: "miss", action_digest: action_digest,
        result_manifest_digest: "", manifest: nil,
        miss_reason: reason, must_compute: true
    )

# Exact-key lookup for a fully wired v2 key.
#
# `roots.cacheable == false` short-circuits BEFORE any tier is touched: an
# action whose block identity is ambiguous must not read or write the cache at
# all, because its key does not distinguish it from a different action.
fn cache_lookup_exact(
    tier_roots: TierRoots,
    key: ActionKeyV2,
    roots: ActionRoots,
    mode: CacheMode,
    remote: RemoteActionIndex?
) -> CacheLookup:
    val digest = action_key_v2_digest(key)
    if not roots.cacheable:
        return cache_lookup_compute(digest, MissReason.ActionUncacheable)
    if not cache_mode_reads(mode):
        return cache_lookup_compute(digest, MissReason.CacheDisabled)
    val found = tier_router_lookup(tier_roots, digest, remote)
    if not found.found:
        return cache_lookup_compute(digest, MissReason.ExactKeyAbsent)
    CacheLookup(
        hit: true, tier: found.tier, action_digest: digest,
        result_manifest_digest: found.result_manifest_digest,
        manifest: found.manifest,
        miss_reason: MissReason.NoMiss, must_compute: false
    )

# Publish a freshly computed result at the workspace tier. A conflict is
# quarantined by the index (never overwritten) and reported, not swallowed.
fn cache_publish(tier_roots: TierRoots, key: ActionKeyV2, roots: ActionRoots, mode: CacheMode, manifest: ResultManifest) -> bool:
    if not roots.cacheable:
        return false
    if not cache_mode_reads(mode):
        return false
    val outcome = tier_router_publish_workspace(tier_roots, action_key_v2_digest(key), manifest)
    match outcome:
        case Stored: true
        case AlreadyPresentSame: true
        case ConflictQuarantined: false

# ============================================================================
# STRICT SHADOW COMPARISON
# ============================================================================

struct ShadowConfig:
    enabled: bool
    # true  => a divergence aborts the build (CI / migration gate)
    # false => a divergence is reported and the FROM-SCRATCH result is used
    fail_on_divergence: bool

fn shadow_disabled() -> ShadowConfig:
    ShadowConfig(enabled: false, fail_on_divergence: false)

fn shadow_strict() -> ShadowConfig:
    ShadowConfig(enabled: true, fail_on_divergence: true)

struct ShadowVerdict:
    compared: bool
    diverged: bool
    field: text          # the FIRST manifest field that differs; "" when equal
    cached: text         # cached value of that field
    recomputed: text     # recomputed value of that field
    use_cached: bool     # false whenever anything is off — the safe direction

fn shadow_not_compared() -> ShadowVerdict:
    ShadowVerdict(compared: false, diverged: false, field: "", cached: "", recomputed: "", use_cached: true)

fn shadow_divergence(field: text, cached: text, recomputed: text) -> ShadowVerdict:
    # use_cached is FALSE on divergence: when the two disagree the from-scratch
    # result is by definition the correct one, so the build output is
    # unchanged even when shadow mode is only warning.
    ShadowVerdict(compared: true, diverged: true, field: field, cached: cached, recomputed: recomputed, use_cached: false)

# Compare a served manifest against one built from a from-scratch recompute of
# the SAME action. Field-by-field, first difference wins, so the report names
# a concrete field rather than "digests differ".
fn shadow_compare(config: ShadowConfig, cached: ResultManifest, recomputed: ResultManifest) -> ShadowVerdict:
    if not config.enabled:
        return shadow_not_compared()
    if cached.action_digest != recomputed.action_digest:
        return shadow_divergence("action_digest", cached.action_digest, recomputed.action_digest)
    if cached.result_kind != recomputed.result_kind:
        return shadow_divergence("result_kind", cached.result_kind, recomputed.result_kind)
    if cached.output_fingerprint != recomputed.output_fingerprint:
        return shadow_divergence("output_fingerprint", cached.output_fingerprint, recomputed.output_fingerprint)
    if cached.dependency_manifest != recomputed.dependency_manifest:
        return shadow_divergence("dependency_manifest", cached.dependency_manifest, recomputed.dependency_manifest)
    if cached.block_manifest_root != recomputed.block_manifest_root:
        return shadow_divergence("block_manifest_root", cached.block_manifest_root, recomputed.block_manifest_root)
    if cached.diagnostics_digest != recomputed.diagnostics_digest:
        return shadow_divergence("diagnostics_digest", cached.diagnostics_digest, recomputed.diagnostics_digest)
    if cached.producer_schema != recomputed.producer_schema:
        return shadow_divergence("producer_schema", "{cached.producer_schema}", "{recomputed.producer_schema}")
    if cached.artifact_digests.len() != recomputed.artifact_digests.len():
        return shadow_divergence("artifact_digests.count", "{cached.artifact_digests.len()}", "{recomputed.artifact_digests.len()}")
    var i = 0
    while i < cached.artifact_digests.len():
        if cached.artifact_digests[i] != recomputed.artifact_digests[i]:
            return shadow_divergence("artifact_digests[{i}]", cached.artifact_digests[i], recomputed.artifact_digests[i])
        i = i + 1
    if cached.aop_group_roots.len() != recomputed.aop_group_roots.len():
        return shadow_divergence("aop_group_roots.count", "{cached.aop_group_roots.len()}", "{recomputed.aop_group_roots.len()}")
    var j = 0
    while j < cached.aop_group_roots.len():
        if cached.aop_group_roots[j] != recomputed.aop_group_roots[j]:
            return shadow_divergence("aop_group_roots[{j}]", cached.aop_group_roots[j], recomputed.aop_group_roots[j])
        j = j + 1
    # Whole-manifest digest last: catches any field added later that the
    # explicit comparisons above do not yet know about, so this never silently
    # becomes a partial check.
    val cd = result_manifest_digest(cached)
    val rd = result_manifest_digest(recomputed)
    if cd != rd:
        return shadow_divergence("result_manifest_digest", cd, rd)
    ShadowVerdict(compared: true, diverged: false, field: "", cached: cd, recomputed: rd, use_cached: true)

# True when the build must ABORT rather than continue. Only strict mode does.
fn shadow_should_abort(config: ShadowConfig, verdict: ShadowVerdict) -> bool:
    config.enabled and config.fail_on_divergence and verdict.diverged
