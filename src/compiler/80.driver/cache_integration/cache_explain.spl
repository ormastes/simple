# `simple cache explain` / `simple cache why-miss` output (design §20.2).
#
# Two jobs:
#   explain   — dump the semantic identity of an action: every key field, which
#               positions are live vs still riding the unbacked sentinel, the
#               tier lookup sequence with a per-tier reason, and the strict
#               comparison verdict.
#   why-miss  — given two keys (this build's and a recorded one), name the
#               FIRST field that differs. "The digest changed" is useless; "the
#               digest changed because sourceContent moved" is the answer.
#
# Honesty rule: a field on the unbacked sentinel is REPORTED as unbacked. It
# must never read as "no AOP surface" when the truth is "no producer exists".

use compiler.driver.cache.action_key.{
    ActionKeyV2, ActionDep, action_key_v2_digest, result_kind_to_text,
    action_key_sort_texts, action_key_sort_deps
}
use compiler.driver.cache_integration.key_wiring.{action_key_v2_field_is_sentinel}
use compiler.driver.cache_integration.cache_lookup.{
    CacheLookup, MissReason, miss_reason_text, ShadowVerdict, CacheMode, cache_mode_name
}

fn _backing_note(value: text) -> text:
    if action_key_v2_field_is_sentinel(value):
        return "  (UNBACKED — fixed sentinel, no producer in tree)"
    ""

fn _set_note(values: [text]) -> text:
    if values.is_empty():
        return "  (empty — no producer in tree)"
    ""

fn _join_lines(lines: [text]) -> text:
    lines.join("\n")

# ============================================================================
# why-miss: name the field that moved
# ============================================================================

fn _dep_line(d: ActionDep) -> text:
    d.module_id + "=" + d.iface_digest

fn _dep_lines(deps: [ActionDep]) -> [text]:
    var out: [text] = []
    for d in action_key_sort_deps(deps):
        out.push(_dep_line(d))
    out

fn _texts_differ(a: [text], b: [text]) -> bool:
    val sa = action_key_sort_texts(a)
    val sb = action_key_sort_texts(b)
    if sa.len() != sb.len():
        return true
    var i = 0
    while i < sa.len():
        if sa[i] != sb[i]:
            return true
        i = i + 1
    false

struct FieldDiff:
    differs: bool
    field: text        # frozen-schema field NAME (not tag), "" when identical
    position: i64      # frozen-schema position, -1 when identical
    mine: text
    theirs: text

fn _same() -> FieldDiff:
    FieldDiff(differs: false, field: "", position: -1, mine: "", theirs: "")

fn _diff(field: text, position: i64, mine: text, theirs: text) -> FieldDiff:
    FieldDiff(differs: true, field: field, position: position, mine: mine, theirs: theirs)

# First differing field between two v2 keys, scanned in FROZEN POSITION ORDER
# so the reported cause is the earliest/most fundamental one, not an arbitrary
# downstream consequence.
fn action_key_v2_first_difference(mine: ActionKeyV2, theirs: ActionKeyV2) -> FieldDiff:
    if mine.domain != theirs.domain:
        return _diff("domain", 0, mine.domain, theirs.domain)
    if mine.compiler_exe != theirs.compiler_exe:
        return _diff("compiler_exe", 1, mine.compiler_exe, theirs.compiler_exe)
    if mine.live_compiler_src != theirs.live_compiler_src:
        return _diff("live_compiler_src", 2, mine.live_compiler_src, theirs.live_compiler_src)
    if mine.schema_version != theirs.schema_version:
        return _diff("schema_version", 3, "{mine.schema_version}", "{theirs.schema_version}")
    if mine.target_triple != theirs.target_triple:
        return _diff("target_triple", 4, mine.target_triple, theirs.target_triple)
    if mine.host_arch != theirs.host_arch:
        return _diff("host_arch", 5, mine.host_arch, theirs.host_arch)
    if _texts_differ(mine.cfg_features, theirs.cfg_features):
        return _diff("cfg_features", 6, action_key_sort_texts(mine.cfg_features).join(","), action_key_sort_texts(theirs.cfg_features).join(","))
    if mine.stdlib_variant != theirs.stdlib_variant:
        return _diff("stdlib_variant", 7, mine.stdlib_variant, theirs.stdlib_variant)
    if mine.runtime_family != theirs.runtime_family:
        return _diff("runtime_family", 8, mine.runtime_family, theirs.runtime_family)
    if mine.source_content != theirs.source_content:
        return _diff("source_content", 9, mine.source_content, theirs.source_content)
    if mine.resolution_witness != theirs.resolution_witness:
        return _diff("resolution_witness", 10, mine.resolution_witness, theirs.resolution_witness)
    if _texts_differ(_dep_lines(mine.deps), _dep_lines(theirs.deps)):
        return _diff("deps", 11, _dep_lines(mine.deps).join(","), _dep_lines(theirs.deps).join(","))
    if mine.macro_root != theirs.macro_root:
        return _diff("macro_root", 12, mine.macro_root, theirs.macro_root)
    if mine.aop_selection != theirs.aop_selection:
        return _diff("aop_selection", 13, mine.aop_selection, theirs.aop_selection)
    if _texts_differ(mine.ct_env_inputs, theirs.ct_env_inputs):
        return _diff("ct_env_inputs", 14, action_key_sort_texts(mine.ct_env_inputs).join(","), action_key_sort_texts(theirs.ct_env_inputs).join(","))
    if mine.schema_digest != theirs.schema_digest:
        return _diff("schema_digest", 15, mine.schema_digest, theirs.schema_digest)
    if mine.aop_surface_root != theirs.aop_surface_root:
        return _diff("aop_surface_root", 16, mine.aop_surface_root, theirs.aop_surface_root)
    if _texts_differ(mine.aop_candidate_partition_roots, theirs.aop_candidate_partition_roots):
        return _diff("aop_candidate_partition_roots", 17, action_key_sort_texts(mine.aop_candidate_partition_roots).join(","), action_key_sort_texts(theirs.aop_candidate_partition_roots).join(","))
    if mine.aop_weave_root != theirs.aop_weave_root:
        return _diff("aop_weave_root", 18, mine.aop_weave_root, theirs.aop_weave_root)
    if _texts_differ(mine.block_manifest_roots, theirs.block_manifest_roots):
        return _diff("block_manifest_roots", 19, action_key_sort_texts(mine.block_manifest_roots).join(","), action_key_sort_texts(theirs.block_manifest_roots).join(","))
    if result_kind_to_text(mine.result_kind) != result_kind_to_text(theirs.result_kind):
        return _diff("result_kind", 20, result_kind_to_text(mine.result_kind), result_kind_to_text(theirs.result_kind))
    _same()

fn why_miss_render(target: text, mine: ActionKeyV2, theirs: ActionKeyV2) -> text:
    val d = action_key_v2_first_difference(mine, theirs)
    var lines: [text] = []
    lines.push("target: " + target)
    lines.push("this build key:  " + action_key_v2_digest(mine))
    lines.push("recorded key:    " + action_key_v2_digest(theirs))
    if not d.differs:
        # Same key but reported as a miss => the entry is simply absent, which
        # is NOT a field problem. Saying "no field differs" is the honest and
        # actionable answer; inventing a field would be worse than useless.
        lines.push("cause: no key field differs — the exact key is absent from every tier")
        return _join_lines(lines)
    lines.push("cause: field `" + d.field + "` (frozen position {d.position}) changed")
    lines.push("  this build: " + d.mine)
    lines.push("  recorded:   " + d.theirs)
    _join_lines(lines)

# ============================================================================
# explain
# ============================================================================

fn explain_render(target: text, key: ActionKeyV2, mode: CacheMode, lookup: CacheLookup, shadow: ShadowVerdict) -> text:
    var lines: [text] = []
    lines.push("target: " + target)
    lines.push("cache mode: " + cache_mode_name(mode))
    lines.push("action key: " + action_key_v2_digest(key))
    lines.push("")
    lines.push("semantic input fields:")
    lines.push("  [1] compiler_exe        " + key.compiler_exe)
    lines.push("  [2] live_compiler_src   " + key.live_compiler_src)
    lines.push("  [3] schema_version      {key.schema_version}")
    lines.push("  [4] target_triple       " + key.target_triple)
    lines.push("  [5] host_arch           " + key.host_arch)
    lines.push("  [6] cfg_features        " + action_key_sort_texts(key.cfg_features).join(","))
    lines.push("  [7] stdlib_variant      " + key.stdlib_variant)
    lines.push("  [8] runtime_family      " + key.runtime_family)
    lines.push("  [9] source_content      " + key.source_content)
    lines.push("  [10] resolution_witness " + key.resolution_witness)
    for d in action_key_sort_deps(key.deps):
        lines.push("  [11] dep               " + _dep_line(d))
    lines.push("  [12] macro_root         " + key.macro_root)
    lines.push("  [13] aop_selection      " + key.aop_selection)
    lines.push("  [14] ct_env_inputs      " + action_key_sort_texts(key.ct_env_inputs).join(","))
    lines.push("  [15] schema_digest      " + key.schema_digest)
    lines.push("")
    lines.push("AOP + block roots:")
    lines.push("  [16] aop_surface_root   " + key.aop_surface_root + _backing_note(key.aop_surface_root))
    lines.push("  [17] aop_candidate_partition_roots " + action_key_sort_texts(key.aop_candidate_partition_roots).join(",") + _set_note(key.aop_candidate_partition_roots))
    lines.push("  [18] aop_weave_root     " + key.aop_weave_root + _backing_note(key.aop_weave_root))
    lines.push("  [19] block_manifest_roots " + action_key_sort_texts(key.block_manifest_roots).join(",") + _set_note(key.block_manifest_roots))
    lines.push("  [20] result_kind        " + result_kind_to_text(key.result_kind))
    lines.push("")
    lines.push("tier lookup sequence: process -> workspace -> machine -> remote-main")
    # Branch results are computed into locals and pushed unconditionally: an
    # earlier `if/else`-with-push form silently dropped BOTH branches under the
    # tree-walk interpreter while working under the JIT, which would have made
    # `explain` quietly omit the very line an operator runs it for.
    var tier_line = "  all tiers: miss — " + miss_reason_text(lookup.miss_reason)
    var tier_detail = "action: computed locally (build output unaffected)"
    if lookup.hit:
        tier_line = "  " + lookup.tier + ": hit (exact key)"
        tier_detail = "provenance: result manifest " + lookup.result_manifest_digest
    lines.push(tier_line)
    lines.push(tier_detail)
    lines.push("")

    var shadow_line = "strict comparison: not run (shadow mode off)"
    if shadow.compared:
        shadow_line = "strict comparison: identical"
    if shadow.compared and shadow.diverged:
        shadow_line = "strict comparison: DIVERGED on `" + shadow.field + "`"
    lines.push(shadow_line)
    if shadow.compared and shadow.diverged:
        lines.push("  cached:     " + shadow.cached)
        lines.push("  recomputed: " + shadow.recomputed)
        lines.push("  used: recomputed (cached result discarded)")
    _join_lines(lines)
