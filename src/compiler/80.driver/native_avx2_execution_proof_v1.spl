# codex-impl
# Evidence join for the existing pure-Simple AVX2 f32x8 lowering route.
# Encoder goldens, object inspection, and execution are deliberately distinct.

use std.nogc_sync_mut.composition.environment_variants.contracts_v1.EnvironmentDigest256V1

pub enum NativeAvx2ExecutionProofErrorV1:
    InvalidEncoderGolden
    InvalidObjectInspection
    ArtifactMismatch
    InvalidExecutionEvidence
    ResultOracleMismatch

pub struct NativeAvx2EncoderGoldenV1:
    encoder_identity: EnvironmentDigest256V1
    instruction_bytes_digest: EnvironmentDigest256V1
    exact_golden_matched: bool

pub struct NativeAvx2ObjectInspectionV1:
    artifact_digest: EnvironmentDigest256V1
    inspector_identity: EnvironmentDigest256V1
    inspection_evidence_digest: EnvironmentDigest256V1
    observed_vex256_f32_instruction_count: u64

pub struct NativeAvx2ExecutionEvidenceV1:
    artifact_digest: EnvironmentDigest256V1
    execution_environment_identity: EnvironmentDigest256V1
    execution_domain_generation: u64
    avx2_os_state_usable: bool
    callable_identity: EnvironmentDigest256V1
    invocation_count: u64
    input_digest: EnvironmentDigest256V1
    output_digest: EnvironmentDigest256V1
    scalar_oracle_output_digest: EnvironmentDigest256V1
    execution_evidence_digest: EnvironmentDigest256V1

pub struct NativeAvx2ExecutionProofV1:
    artifact_digest: EnvironmentDigest256V1
    encoder_golden_proven: bool
    emitted_object_avx2_inspected: bool
    executed_callable_proven: bool
    observed_vector_instruction_count: u64
    invocation_count: u64
    inspection_evidence_digest: EnvironmentDigest256V1
    execution_evidence_digest: EnvironmentDigest256V1

fn _declared(v: EnvironmentDigest256V1) -> bool:
    v.w0 != 0u64 or v.w1 != 0u64 or v.w2 != 0u64 or v.w3 != 0u64
fn _same(a: EnvironmentDigest256V1, b: EnvironmentDigest256V1) -> bool:
    a.w0 == b.w0 and a.w1 == b.w1 and a.w2 == b.w2 and a.w3 == b.w3

pub fn native_avx2_execution_proof_v1(
    golden: NativeAvx2EncoderGoldenV1, inspection: NativeAvx2ObjectInspectionV1,
    execution: NativeAvx2ExecutionEvidenceV1
) -> Result<NativeAvx2ExecutionProofV1, NativeAvx2ExecutionProofErrorV1>:
    if not golden.exact_golden_matched or not _declared(golden.encoder_identity) or
       not _declared(golden.instruction_bytes_digest):
        return Err(NativeAvx2ExecutionProofErrorV1.InvalidEncoderGolden)
    if not _declared(inspection.artifact_digest) or not _declared(inspection.inspector_identity) or
       not _declared(inspection.inspection_evidence_digest) or
       inspection.observed_vex256_f32_instruction_count == 0u64:
        return Err(NativeAvx2ExecutionProofErrorV1.InvalidObjectInspection)
    if not _same(inspection.artifact_digest, execution.artifact_digest):
        return Err(NativeAvx2ExecutionProofErrorV1.ArtifactMismatch)
    if not execution.avx2_os_state_usable or execution.execution_domain_generation == 0u64 or
       execution.invocation_count == 0u64 or not _declared(execution.execution_environment_identity) or
       not _declared(execution.callable_identity) or not _declared(execution.input_digest) or
       not _declared(execution.output_digest) or not _declared(execution.execution_evidence_digest):
        return Err(NativeAvx2ExecutionProofErrorV1.InvalidExecutionEvidence)
    if not _same(execution.output_digest, execution.scalar_oracle_output_digest):
        return Err(NativeAvx2ExecutionProofErrorV1.ResultOracleMismatch)
    Ok(NativeAvx2ExecutionProofV1(artifact_digest: inspection.artifact_digest,
        encoder_golden_proven: true, emitted_object_avx2_inspected: true,
        executed_callable_proven: true,
        observed_vector_instruction_count: inspection.observed_vex256_f32_instruction_count,
        invocation_count: execution.invocation_count,
        inspection_evidence_digest: inspection.inspection_evidence_digest,
        execution_evidence_digest: execution.execution_evidence_digest))
