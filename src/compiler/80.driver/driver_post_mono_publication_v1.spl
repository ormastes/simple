# Shared unchanged diagnostic/policy publication. This function is not report
# admission: callers must supply the actual completed exhaustive verifier report.
# Archived callers publish only after report ownership and all prerequisite gates.
use compiler.driver.driver_types.{CompileContext}
use compiler.mono.verify.post_mono_verify.{PostMonoReport,
    post_mono_report_total, post_mono_report_diagnostics}
use compiler.common.assurance.policy_schema.{AssuranceStrictness}
use compiler.driver.driver_pass_receipt.{PassReceipt, record_pass_receipt}
use compiler.driver.driver_log_helpers.{log_debug}

fn driver_publish_post_mono_report_v1(ctx: CompileContext,
        mono_report: PostMonoReport, modules_checked: i64) -> bool:
    val mono_total = post_mono_report_total(mono_report)
    val mono_strictness = ctx.assurance_policy.strictness
    # Phase 3: enforcement now starts at `robust`, not only `critical`.
    # This RAISES the bar (robust used to warn); no gate is relaxed.
    val mono_critical = mono_strictness.at_least(AssuranceStrictness.Robust)
    var mono_errors = 0
    for d in post_mono_report_diagnostics(mono_report):
        # `d` already carries its own E-MONO-031 code (section 17.5).
        val mmsg = d
        if mono_critical:
            mono_errors = mono_errors + 1
            ctx.add_error(mmsg)
        else:
            ctx.add_warning(mmsg)
    val _mono_receipt = record_pass_receipt(PassReceipt(
        pass_name: "post_mono_verify",
        profile: mono_strictness.name(),
        executed: true,
        modules_checked: modules_checked,
        diagnostics: mono_total,
        errors_raised: mono_errors
    ))
    log_debug("monomorphization done")
    if mono_critical and mono_total > 0:
        print "error[E-MONO-031]: post-monomorphization invariants violated: {mono_total} diagnostic(s) across {modules_checked} module(s) under profile {mono_strictness.name()}; refusing to lower to MIR"
        return false
    true

export driver_publish_post_mono_report_v1
