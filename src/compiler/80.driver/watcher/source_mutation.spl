# Watcher source-mutation bridge
#
# Keeps filesystem/watch event ownership in the driver while routing resolver
# cache invalidation to the frontend owner.  A move is deliberately one event
# with both identities; adapters must not degrade it into unrelated callbacks.

use compiler.core.interpreter.module_loader_resolve.{
    module_resolve_cache_file_created,
    module_resolve_cache_file_edited,
    module_resolve_cache_file_deleted,
    module_resolve_cache_file_moved
}

fn watcher_source_created(path: text) -> i64:
    module_resolve_cache_file_created(path)

fn watcher_source_edited(path: text) -> i64:
    module_resolve_cache_file_edited(path)

fn watcher_source_deleted(path: text) -> i64:
    module_resolve_cache_file_deleted(path)

fn watcher_source_moved(old_path: text, new_path: text) -> i64:
    module_resolve_cache_file_moved(old_path, new_path)
