# SMF Manifest — Tracks compiled SMF files for interpreter cache lookup
#
# Provides a persistent index mapping source paths to compiled SMF files.
# Used by the watcher daemon (write) and interpreter (read) for
# SMF cache discovery without scanning the filesystem.
#
# Format: SDN at <smf-cache-dir>/manifest.sdn
# Concurrent access safety: atomic write via tmp+rename pattern.


extern fn rt_file_read_text(path: text) -> text
extern fn rt_file_rename(src: text, dst: text) -> bool
use compiler.driver.cache.action_key.{interface_digest_of_source, action_key_sort_texts}
use compiler.driver.driver_provider_contract_v1.{SIMPLE_COMPILER_DRIVER_V1_ABI_DIGEST}
use std.common.sdn.parser.{parse}
use std.common.sdn.value.{SdnValue}
use std.common.sdn.encode.{sdn_encode_canonical}
use std.file_system.{file_write_text}
use std.io_runtime.{dir_create_all, time_now_unix_micros, hash_text, file_exists}
use std.nogc_sync_mut.io_runtime.{env_get_opt}

# ============================================================================
# Types
# ============================================================================

struct SmfManifestEntry:
    source_path: text
    smf_path: text
    source_hash: i64
    compiled_at: i64
    backend: text       # "cranelift" or "llvm"
    opt_level: i64
    release: bool
    debug_info: bool
    gc_off: bool
    profile: text
    allowed_families: [text]
    # Canonical interface digest (action_key.interface_digest_of over the
    # textual interface parts of the source). Additive (2026-08-18): old
    # manifests parse with "" (absent); readers must treat "" as no-evidence.
    iface_digest: text
    abi_digest: text
    provided_ifaces: [text]
    required_ifaces: [text]

struct SmfManifest:
    version: i64
    entries: Dict<text, SmfManifestEntry>  # source_path -> entry
    updated_at: i64

val SMF_MANIFEST_VERSION_CURRENT: i64 = 35
val SMF_MANIFEST_VERSION_LEGACY_IDENTITY: i64 = 34

# ============================================================================
# Constructors
# ============================================================================

fn smf_manifest_new() -> SmfManifest:
    SmfManifest(
        version: SMF_MANIFEST_VERSION_CURRENT,
        entries: {},
        updated_at: time_now_unix_micros()
    )

fn smf_manifest_entry_new(
    source_path: text,
    smf_path: text,
    source_hash: i64,
    backend: text,
    opt_level: i64,
    release: bool,
    debug_info: bool,
    gc_off: bool,
    profile: text,
    allowed_families: [text]
) -> SmfManifestEntry:
    smf_manifest_entry_new_with_iface(source_path, smf_path, source_hash, backend, opt_level, release, debug_info, gc_off, profile, allowed_families, "")

fn smf_manifest_entry_new_with_iface(
    source_path: text,
    smf_path: text,
    source_hash: i64,
    backend: text,
    opt_level: i64,
    release: bool,
    debug_info: bool,
    gc_off: bool,
    profile: text,
    allowed_families: [text],
    iface_digest: text
) -> SmfManifestEntry:
    smf_manifest_entry_new_with_identity(
        source_path, smf_path, source_hash, backend, opt_level, release,
        debug_info, gc_off, profile, allowed_families, iface_digest,
        smf_manifest_host_abi_digest(), [], []
    )

fn smf_manifest_entry_new_with_identity(
    source_path: text,
    smf_path: text,
    source_hash: i64,
    backend: text,
    opt_level: i64,
    release: bool,
    debug_info: bool,
    gc_off: bool,
    profile: text,
    allowed_families: [text],
    iface_digest: text,
    abi_digest: text,
    provided_ifaces: [text],
    required_ifaces: [text]
) -> SmfManifestEntry:
    SmfManifestEntry(
        source_path: source_path,
        smf_path: smf_path,
        source_hash: source_hash,
        compiled_at: time_now_unix_micros(),
        backend: backend,
        opt_level: opt_level,
        release: release,
        debug_info: debug_info,
        gc_off: gc_off,
        profile: profile,
        allowed_families: allowed_families,
        iface_digest: iface_digest,
        abi_digest: abi_digest,
        provided_ifaces: provided_ifaces,
        required_ifaces: required_ifaces
    )

fn smf_manifest_host_abi_digest() -> text:
    "{SIMPLE_COMPILER_DRIVER_V1_ABI_DIGEST}"

enum SmfManifestGateVerdict:
    Admitted
    UnsupportedVersion
    AbiDigestMissing
    AbiDigestMismatch

fn smf_manifest_gate_code(verdict: SmfManifestGateVerdict) -> text:
    match verdict:
        case SmfManifestGateVerdict.Admitted: "SMF-OK"
        case SmfManifestGateVerdict.UnsupportedVersion: "SMF-E-VERSION"
        case SmfManifestGateVerdict.AbiDigestMissing: "SMF-E-ABI-MISSING"
        case SmfManifestGateVerdict.AbiDigestMismatch: "SMF-E-ABI-MISMATCH"

fn smf_manifest_entry_gate(manifest: SmfManifest, entry: SmfManifestEntry, expected_abi_digest: text) -> SmfManifestGateVerdict:
    if manifest.version != SMF_MANIFEST_VERSION_CURRENT:
        return SmfManifestGateVerdict.UnsupportedVersion
    if entry.abi_digest == "":
        return SmfManifestGateVerdict.AbiDigestMissing
    if entry.abi_digest != expected_abi_digest:
        return SmfManifestGateVerdict.AbiDigestMismatch
    SmfManifestGateVerdict.Admitted

# ============================================================================
# Manifest Operations
# ============================================================================

fn smf_manifest_update(manifest: SmfManifest, entry: SmfManifestEntry) -> SmfManifest:
    """Add or update an entry in the manifest."""
    var entries = manifest.entries
    entries[entry.source_path] = entry
    SmfManifest(
        version: manifest.version,
        entries: entries,
        updated_at: time_now_unix_micros()
    )

fn smf_manifest_remove(manifest: SmfManifest, source_path: text) -> SmfManifest:
    """Remove an entry from the manifest."""
    var entries = manifest.entries
    if entries.has(source_path):
        entries.remove(source_path)
    SmfManifest(
        version: manifest.version,
        entries: entries,
        updated_at: time_now_unix_micros()
    )

fn smf_manifest_find(manifest: SmfManifest, source_path: text) -> SmfManifestEntry?:
    """Look up the SMF path for a source file."""
    if manifest.entries.has(source_path):
        return Some(manifest.entries[source_path])
    nil

fn smf_manifest_count(manifest: SmfManifest) -> i64:
    manifest.entries.keys().len()

fn smf_manifest_entry_matches_source(entry: SmfManifestEntry, source_text: text) -> bool:
    """Verify a manifest entry against the live source text. FAIL CLOSED.

    Until 2026-08-17 every recorded field of an SmfManifestEntry except
    `smf_path` was parsed at load and then discarded, so the manifest itself
    was written but never verified: the only freshness evidence was the hash
    stored *inside* the .smf artifact the (possibly stale) manifest pointed at.
    A manifest row is now usable only when it carries positive evidence that it
    describes THIS source text.

    Rejected (returns false):
      - `source_hash == 0` — the sentinel both writers record when the source
        could not be read at compile time; unknown provenance, never trusted.
      - empty `source_text` — the source could not be read now.
      - any hash mismatch.
    """
    if entry.source_hash == 0:
        return false
    if source_text == "":
        return false
    entry.source_hash == hash_text(source_text)

# Typed verdict for interface-digest verification at load time.
enum IfaceDigestVerdict:
    Match       # recorded digest equals the recomputed one
    Mismatch    # recorded digest differs — interface changed since compile
    Absent      # no recorded digest (old manifest row) or unreadable source

fn iface_digest_verdict_text(v: IfaceDigestVerdict) -> text:
    match v:
        case IfaceDigestVerdict.Match: "match"
        case IfaceDigestVerdict.Mismatch: "mismatch"
        case IfaceDigestVerdict.Absent: "absent"

fn iface_digest_gate_code(v: IfaceDigestVerdict) -> text:
    match v:
        case IfaceDigestVerdict.Match: "SMF-OK"
        case IfaceDigestVerdict.Mismatch: "SMF-E-IFACE-MISMATCH"
        case IfaceDigestVerdict.Absent: "SMF-E-IFACE-MISSING"

# Compare the recorded interface digest against one recomputed from live
# source. The interpret cache uses this as a fail-closed admission verdict.
fn smf_manifest_entry_iface_verdict(entry: SmfManifestEntry, source_text: text) -> IfaceDigestVerdict:
    if entry.iface_digest == "":
        return IfaceDigestVerdict.Absent
    if source_text == "":
        return IfaceDigestVerdict.Absent
    if entry.iface_digest == interface_digest_of_source(source_text):
        return IfaceDigestVerdict.Match
    IfaceDigestVerdict.Mismatch

# Level-gated diagnostic (default OFF): set SIMPLE_IFACE_DIGEST_LOG=1 to log
# the verdict on every manifest-backed cache load.
fn smf_manifest_iface_diagnostic(entry: SmfManifestEntry, source_text: text):
    if (env_get_opt("SIMPLE_IFACE_DIGEST_LOG") ?? "") != "1":
        return
    val verdict = smf_manifest_entry_iface_verdict(entry, source_text)
    print "[iface-digest] {entry.source_path}: {iface_digest_verdict_text(verdict)}"

fn smf_manifest_entry_verifies(entry: SmfManifestEntry) -> bool:
    """Read `entry.source_path` and verify the recorded hash against it."""
    if not file_exists(entry.source_path):
        return false
    smf_manifest_entry_matches_source(entry, rt_file_read_text(entry.source_path) ?? "")

# ============================================================================
# SDN Serialization
# ============================================================================

fn smf_manifest_to_sdn(manifest: SmfManifest) -> text:
    """Serialize a canonical manifest with deterministic entry and set order."""
    var lines: [text] = [
        "smf_manifest:",
        "  version: {manifest.version}",
        "  updated_at: {manifest.updated_at}",
        ""
    ]

    if manifest.entries.keys().len() > 0:
        lines.push("entries |source_path, smf_path, source_hash, compiled_at, backend, opt_level, release, debug_info, gc_off, profile, allowed_families, iface_digest, abi_digest, provides, requires|")
        for key in action_key_sort_texts(manifest.entries.keys()):
            val e = manifest.entries[key]
            val cells: [SdnValue] = [
                SdnValue.String(e.source_path), SdnValue.String(e.smf_path),
                SdnValue.Int(e.source_hash), SdnValue.Int(e.compiled_at),
                SdnValue.String(e.backend), SdnValue.Int(e.opt_level),
                SdnValue.Bool(e.release), SdnValue.Bool(e.debug_info),
                SdnValue.Bool(e.gc_off), SdnValue.String(e.profile),
                _smf_text_array(action_key_sort_texts(e.allowed_families)),
                SdnValue.String(e.iface_digest), SdnValue.String(e.abi_digest),
                _smf_text_array(action_key_sort_texts(e.provided_ifaces)),
                _smf_text_array(action_key_sort_texts(e.required_ifaces))
            ]
            var encoded: [text] = []
            for cell in cells:
                encoded.push(sdn_encode_canonical(cell))
            lines.push("    " + encoded.join(", "))

    lines.join("\n")

fn _smf_text_array(values: [text]) -> SdnValue:
    var items: [SdnValue] = []
    for value in values:
        items.push(SdnValue.String(value))
    SdnValue.Array(items)

fn _smf_row_text(row: [SdnValue], index: i64, field: text) -> Result<text, text>:
    match row[index].as_str():
        case Some(value): Ok(value)
        case None: Err("SMF-E-MANIFEST: `" + field + "` must be text")

fn _smf_row_i64(row: [SdnValue], index: i64, field: text) -> Result<i64, text>:
    match row[index].as_i64():
        case Some(value): Ok(value)
        case None: Err("SMF-E-MANIFEST: `" + field + "` must be an integer")

fn _smf_row_bool(row: [SdnValue], index: i64, field: text) -> Result<bool, text>:
    match row[index].as_bool():
        case Some(value): Ok(value)
        case None:
            match row[index].as_i64():
                case Some(value):
                    if value == 0: Ok(false)
                    elif value == 1: Ok(true)
                    else: Err("SMF-E-MANIFEST: `" + field + "` integer must be 0 or 1")
                case None: Err("SMF-E-MANIFEST: `" + field + "` must be bool")

fn _smf_row_texts(row: [SdnValue], index: i64, field: text) -> Result<[text], text>:
    match row[index]:
        case SdnValue.Array(items):
            var out: [text] = []
            for item in items:
                match item.as_str():
                    case Some(value): out.push(value)
                    case None: return Err("SMF-E-MANIFEST: `" + field + "` entries must be text")
            Ok(out)
        case SdnValue.String(legacy):
            if legacy == "": Ok([]) else: Ok(legacy.split(";"))
        case _: Err("SMF-E-MANIFEST: `" + field + "` must be a text array")

fn _smf_manifest_entry_from_row(row: [SdnValue]) -> Result<SmfManifestEntry, text>:
    if row.len() != 15:
        return Err("SMF-E-MANIFEST: entry row must contain exactly 15 columns")
    val source_path = _smf_row_text(row, 0, "source_path")?
    if source_path == "":
        return Err("SMF-E-MANIFEST: source_path must not be empty")
    Ok(SmfManifestEntry(
        source_path: source_path,
        smf_path: _smf_row_text(row, 1, "smf_path")?,
        source_hash: _smf_row_i64(row, 2, "source_hash")?,
        compiled_at: _smf_row_i64(row, 3, "compiled_at")?,
        backend: _smf_row_text(row, 4, "backend")?,
        opt_level: _smf_row_i64(row, 5, "opt_level")?,
        release: _smf_row_bool(row, 6, "release")?,
        debug_info: _smf_row_bool(row, 7, "debug_info")?,
        gc_off: _smf_row_bool(row, 8, "gc_off")?,
        profile: _smf_row_text(row, 9, "profile")?,
        allowed_families: _smf_row_texts(row, 10, "allowed_families")?,
        iface_digest: _smf_row_text(row, 11, "iface_digest")?,
        abi_digest: _smf_row_text(row, 12, "abi_digest")?,
        provided_ifaces: _smf_row_texts(row, 13, "provides")?,
        required_ifaces: _smf_row_texts(row, 14, "requires")?
    ))

fn smf_manifest_from_sdn_checked(content: text) -> Result<SmfManifest, text>:
    val root = parse(content)?
    val metadata = match root.get("smf_manifest"):
        case Some(value): value
        case None: return Err("SMF-E-MANIFEST: smf_manifest metadata is missing")
    if not metadata.is_dict():
        return Err("SMF-E-MANIFEST: smf_manifest metadata must be a map")
    val version_value = metadata.get("version") ?? SdnValue.Null
    val version = version_value.as_i64() ?? 0
    if version != SMF_MANIFEST_VERSION_CURRENT:
        return Err("SMF-E-VERSION: unsupported manifest version `" +
            version.to_text() + "`")
    val updated_at = (metadata.get("updated_at") ?? SdnValue.Null).as_i64() ?? 0
    var entries: Dict<text, SmfManifestEntry> = {}
    match root.get("entries"):
        case None: true
        case Some(value):
            match value:
                case SdnValue.Table(headers, rows):
                    val expected = ["source_path", "smf_path", "source_hash", "compiled_at",
                        "backend", "opt_level", "release", "debug_info", "gc_off", "profile",
                        "allowed_families", "iface_digest", "abi_digest", "provides", "requires"]
                    if headers != expected:
                        return Err("SMF-E-MANIFEST: entries header is not canonical")
                    for row in rows:
                        val entry = _smf_manifest_entry_from_row(row)?
                        if entries.has(entry.source_path):
                            return Err("SMF-E-MANIFEST: duplicate source_path `" + entry.source_path + "`")
                        entries[entry.source_path] = entry
                case _: return Err("SMF-E-MANIFEST: entries must be a table")
    Ok(SmfManifest(version: version, entries: entries, updated_at: updated_at))

fn smf_manifest_from_sdn(content: text) -> SmfManifest:
    match smf_manifest_from_sdn_checked(content):
        case Ok(manifest): manifest
        case Err(_): SmfManifest(version: 0, entries: {}, updated_at: 0)

# ============================================================================
# File I/O (atomic write)
# ============================================================================

val SMF_MANIFEST_DEFAULT_PATH: text = "build/smf/manifest.sdn"

fn load_smf_manifest(path: text) -> SmfManifest:
    """Load manifest from file. Returns empty manifest if file doesn't exist."""
    if not file_exists(path):
        return smf_manifest_new()
    val content = rt_file_read_text(path) ?? ""
    if content == "":
        return smf_manifest_new()
    smf_manifest_from_sdn(content)

fn load_smf_manifest_checked(path: text) -> Result<SmfManifest, text>:
    if not file_exists(path):
        return Ok(smf_manifest_new())
    val content = rt_file_read_text(path) ?? ""
    if content == "":
        return Err("SMF-E-MANIFEST: manifest is empty")
    smf_manifest_from_sdn_checked(content)

fn save_smf_manifest(manifest: SmfManifest, path: text) -> bool:
    """Save manifest to file using atomic tmp+rename."""
    val dir = path_dir(path)
    dir_create_all(dir)

    val sdn = smf_manifest_to_sdn(manifest)
    val tmp_path = "{path}.tmp"

    if not file_write_text(tmp_path, sdn):
        return false
    rt_file_rename(tmp_path, path)

fn load_smf_manifest_default() -> SmfManifest:
    load_smf_manifest(SMF_MANIFEST_DEFAULT_PATH)

fn load_smf_manifest_default_checked() -> Result<SmfManifest, text>:
    load_smf_manifest_checked(SMF_MANIFEST_DEFAULT_PATH)

fn save_smf_manifest_default(manifest: SmfManifest) -> bool:
    save_smf_manifest(manifest, SMF_MANIFEST_DEFAULT_PATH)

fn smf_manifest_path_for_smf(smf_path: text) -> text:
    "{path_dir(smf_path)}/manifest.sdn"

# ============================================================================
# Convenience: update + save in one call
# ============================================================================

fn update_smf_manifest_entry(
    source_path: text,
    smf_path: text,
    source_hash: i64,
    backend: text,
    opt_level: i64,
    release: bool,
    debug_info: bool,
    gc_off: bool,
    profile: text,
    allowed_families: [text]
) -> bool:
    """Load manifest, update entry, save. Convenience for single-entry updates."""
    val manifest_path = smf_manifest_path_for_smf(smf_path)
    var manifest = match load_smf_manifest_checked(manifest_path):
        case Ok(existing): existing
        case Err(_): return false
    if manifest.version != SMF_MANIFEST_VERSION_CURRENT:
        return false
    # RECORD the canonical interface digest alongside the whole-source hash.
    # First real caller of action_key.interface_digest_of (2026-08-18).
    val src_text = if file_exists(source_path): rt_file_read_text(source_path) ?? "" else: ""
    val iface = if src_text == "": "" else: interface_digest_of_source(src_text)
    val entry = smf_manifest_entry_new_with_iface(
        source_path,
        smf_path,
        source_hash,
        backend,
        opt_level,
        release,
        debug_info,
        gc_off,
        profile,
        allowed_families,
        iface
    )
    manifest = smf_manifest_update(manifest, entry)
    save_smf_manifest(manifest, manifest_path)

# ============================================================================
# Helpers
# ============================================================================

fn path_dir(path: text) -> text:
    """Extract directory from file path."""
    val last_slash = path.last_index_of("/")
    if last_slash >= 0:
        return path[0:last_slash]
    "."
