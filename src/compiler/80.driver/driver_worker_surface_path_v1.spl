# Equivalent to path.ends_with("/" + suffix), without allocating the joined
# path for every inventory row. Lengths and byte_at both use UTF-8 bytes.
pub fn worker_surface_path_suffix_v1(path: text, suffix: text) -> bool:
    path.len() > suffix.len() and path.ends_with(suffix) and
        path.byte_at(path.len() - suffix.len() - 1) == 47
