use compiler.driver.driver_types.{CompileContext}
use compiler.common.driver_core_types.{CompileOptions}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_lowering.module_surface.{ModuleSurfacesByName}

pub class CompilerDriver:
    ctx: CompileContext
    # Direct retained owner for both streaming and positional entry-closure
    # parses.  Transporting this class graph only through
    # CompileContext.module_surfaces (Option<class>) can retain Some while
    # dropping the payload at the native method boundary.
    streaming_module_surfaces_owner: ModuleSurfacesByName
    streaming_surface_owner_ready: bool
    streaming_entry_source_index_owner: i64

    static fn create(options: CompileOptions) -> CompilerDriver:
        val ctx = CompileContext.create(options)
        CompilerDriver(
            ctx: ctx,
            streaming_module_surfaces_owner: ModuleSurfacesByName.empty(),
            streaming_surface_owner_ready: false,
            streaming_entry_source_index_owner: -1)
