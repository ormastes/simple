use compiler.driver.driver_types.{CompileContext}
use compiler.common.driver_core_types.{CompileOptions}
use compiler.mdsoc.feature.module_loading.app.module_resolver_discovery_port.{ModuleResolverDiscoveryPort}

pub class CompilerDriver:
    ctx: CompileContext

    static fn create(options: CompileOptions) -> CompilerDriver:
        val ctx = CompileContext.create(options)
        CompilerDriver(ctx: ctx)

    static fn create_with_module_resolver_discovery(
        options: CompileOptions,
        module_resolver_discovery: ModuleResolverDiscoveryPort
    ) -> CompilerDriver:
        val ctx = CompileContext.create_with_module_resolver_discovery(
            options, module_resolver_discovery)
        CompilerDriver(ctx: ctx)
