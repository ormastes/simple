use compiler.driver.driver_types.{CompileContext}
use compiler.common.driver_compile_options.{CompileOptions}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_lowering.module_surface.{ModuleSurfacesByName}
use compiler.semantics.perf_facts.types.{CollectionOperationRegistry}
use compiler.semantics.perf_facts.registry.{CollectionRegistryBindingV1}
use compiler.semantics.perf.collection_plan_analysis.{CollectionModuleAnalysisV1}

pub class CompilerDriver:
    ctx: CompileContext
    # Direct retained owner for both streaming and positional entry-closure
    # parses.  Transporting this class graph only through
    # CompileContext.module_surfaces (Option<class>) can retain Some while
    # dropping the payload at the native method boundary.
    streaming_module_surfaces_owner: ModuleSurfacesByName
    streaming_surface_owner_ready: bool
    streaming_entry_source_index_owner: i64
    # Direct class owner avoids Option<class> payload transport at native
    # method boundaries. Configuration is explicit and never grants rewrites.
    collection_registries: Dict<text, CollectionOperationRegistry> = {}
    collection_bindings: [CollectionRegistryBindingV1] = []
    collection_registry_version: text = "unconfigured"
    collection_registry_configured: bool = false
    collection_registry_error: text = ""
    collection_analyses: Dict<text, CollectionModuleAnalysisV1> = {}

    static fn create(options: CompileOptions) -> CompilerDriver:
        val ctx = CompileContext.create(options)
        CompilerDriver(
            ctx: ctx,
            streaming_module_surfaces_owner: ModuleSurfacesByName.empty(),
            streaming_surface_owner_ready: false,
            streaming_entry_source_index_owner: -1,
            collection_registries: {},
            collection_bindings: [],
            collection_registry_version: "unconfigured",
            collection_registry_configured: false,
            collection_registry_error: "",
            collection_analyses: {})
