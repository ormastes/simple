# The exact manager request is the authority for a runtime/std native action's
# whole-process memory ceiling. The caller hashes the same bounded, no-follow
# request.sdn bytes it decodes into BuildTaskV1 before constructing this value.

use std.common.build_manager.contracts.{
    BUILDER_MEMORY_LIMIT_MAX_V2, builder_digest_valid_v1}

struct RuntimeStdNativeActionBudgetV2:
    manager_request_digest: text
    enforced_process_limit_bytes: i64

fn runtime_std_native_action_budget_valid_v2(
    budget: RuntimeStdNativeActionBudgetV2
) -> bool:
    builder_digest_valid_v1(budget.manager_request_digest) and
        budget.enforced_process_limit_bytes >= 1 and
        budget.enforced_process_limit_bytes <= BUILDER_MEMORY_LIMIT_MAX_V2

fn runtime_std_native_action_peak_admitted_v2(
    budget: RuntimeStdNativeActionBudgetV2, observed_peak_bytes: i64
) -> bool:
    runtime_std_native_action_budget_valid_v2(budget) and
        observed_peak_bytes > 0 and
        observed_peak_bytes <= budget.enforced_process_limit_bytes

export RuntimeStdNativeActionBudgetV2
export runtime_std_native_action_budget_valid_v2
export runtime_std_native_action_peak_admitted_v2
