# Dependency-light semantic section payload and emitted file receipt types.

use compiler.driver.smf.package_image_v1.{PackageSectionKindV1}

struct RuntimeStdCompiledSectionPayloadV1:
    kind: PackageSectionKindV1
    member_name: text
    content: text

struct RuntimeStdCompiledSectionReceiptV1:
    kind: PackageSectionKindV1
    member_name: text
    path: text
    digest: text
    byte_count: i64

export RuntimeStdCompiledSectionPayloadV1, RuntimeStdCompiledSectionReceiptV1
