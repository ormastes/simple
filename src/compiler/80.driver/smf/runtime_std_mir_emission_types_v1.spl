# Compact source-scoped MIR artifact receipt shared by driver and emitter.
# This leaf intentionally does not import backend, codec, or CompileContext.

struct RuntimeStdMirFileV1:
    path: text
    digest: text
    byte_count: i64

struct RuntimeStdMirModuleEmissionV1:
    module_identity: text
    source_identity: text
    source_digest: text
    private_root: text
    mir_file: RuntimeStdMirFileV1

export RuntimeStdMirFileV1, RuntimeStdMirModuleEmissionV1
