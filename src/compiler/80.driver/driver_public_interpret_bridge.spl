use compiler.common.driver_core_types.{CompileResult}
use compiler.driver.driver_public_shared.{
    find_simple_binary,
    clean_child_output,
    check_compile_delegation_guard,
    mark_compile_delegated
}
use std.io_runtime.{process_run}


# Lightweight bridge for public `compiler.driver.{...}` imports.
# `interpret_file` shells out to keep external script calls lightweight.

pub fn interpret_file(path: text) -> CompileResult:
    val simple_bin = find_simple_binary()
    val guard_error = check_compile_delegation_guard("source interpretation", simple_bin)
    if guard_error != "":
        return CompileResult.RuntimeError(
            "{guard_error}; no compatible in-process interpreter is available in this runtime"
        )
    mark_compile_delegated()
    val (stdout, stderr, exit_code) = process_run(simple_bin, [path])
    interpret_bridge_result(simple_bin, stdout, stderr, exit_code)

pub fn interpret_bridge_result(simple_bin: text, stdout: text, stderr: text, exit_code: i64) -> CompileResult:
    val combined = _clean_child_output(stdout, stderr)
    if _looks_like_driver_failure(combined):
        return CompileResult.RuntimeError(combined)
    if exit_code == 0:
        return CompileResult.Success(combined)
    if combined == "":
        return CompileResult.RuntimeError(
            "external interpreter '{simple_bin}' failed with exit code {exit_code} and produced no diagnostic"
        )
    CompileResult.RuntimeError(
        "external interpreter '{simple_bin}' failed with exit code {exit_code}:\n{combined}"
    )

fn _clean_child_output(stdout: text, stderr: text) -> text:
    val base = clean_child_output(stdout, stderr)
    val lines = base.split("\n")
    var kept: [text] = []
    var i = 0
    while i < lines.len():
        val line = lines[i]
        if line != "__SIMPLE_DRIVER_OK__":
            kept = kept.push(line)
        i = i + 1
    kept.join("\n")

fn _looks_like_driver_failure(output: text) -> bool:
    val trimmed = output.trim()
    if trimmed == "":
        return false
    if trimmed.contains("error:"):
        return true
    if trimmed.contains("panic"):
        return true
    if trimmed.contains("ParseError"):
        return true
    if trimmed.contains("TypeError"):
        return true
    trimmed.contains("RuntimeError")
