# Logical aliases retain inventory rows; physical MIR work has one owner.
use compiler.mir._MirLowering.module_lowering.{mir_layout_canonical_module_name}
use std.common.encoding.sha256_contract.{sha256_lower_hex_valid}

pub fn driver_mir_feed_is_identity_v1(indices: [i64], inventory_owners: [text],
        feed_owners: [text]) -> bool:
    # Identity source indices alone say nothing about dictionary-values order.
    # Preserve the birth feed only when its actual owners also match in order.
    if indices.len() != feed_owners.len() or indices.len() != inventory_owners.len():
        return false
    var index = 0
    while index < indices.len():
        val physical_index = indices[index]
        if physical_index != index or physical_index < 0 or physical_index >= inventory_owners.len():
            return false
        val expected_owner = mir_layout_canonical_module_name(inventory_owners[physical_index])
        val actual_owner = mir_layout_canonical_module_name(feed_owners[index])
        if expected_owner == "" or actual_owner != expected_owner:
            return false
        index = index + 1
    true

pub fn driver_mir_physical_source_indices_v1(paths: [text], identities: [text],
        owners: [text]) -> Result<[i64], text>:
    # These paths and full-content identities belong to the admitted phase-1
    # inventory. Do not normalize guessed filesystem spellings or hash source
    # text here: source contents can already have been released.
    if paths.len() != identities.len() or paths.len() != owners.len():
        return Err("MIR physical ownership inventory shape mismatch")
    var first_by_owner: Dict<text, i64> = {}
    var owner_by_path: Dict<text, text> = {}
    var selected: [i64] = []
    var index = 0
    while index < paths.len():
        val owner = mir_layout_canonical_module_name(owners[index])
        if owner == "" or paths[index] == "" or not sha256_lower_hex_valid(identities[index]):
            return Err("MIR physical ownership lacks admitted source identity at {index}")
        if first_by_owner.has(owner):
            val first = first_by_owner[owner]
            if paths[first] != paths[index] or identities[first] != identities[index]:
                return Err("MIR physical ownership conflict for {owner}")
        else:
            if owner_by_path.has(paths[index]) and owner_by_path[paths[index]] != owner:
                return Err("MIR physical source has conflicting owners: {paths[index]}")
            first_by_owner[owner] = index
            owner_by_path[paths[index]] = owner
            selected = selected.push(index)
        index = index + 1
    # Inventory order, not dictionary iteration, selects the representative.
    Ok(selected)


pub fn driver_mir_retained_identities_by_path_v1(retained_paths: [text],
        retained_identities: [text]) -> Result<Dict<text, text>, text>:
    if retained_paths.len() != retained_identities.len():
        return Err("MIR projected ownership inventory shape mismatch")
    var identity_by_path: Dict<text, text> = {}
    var index = 0
    while index < retained_paths.len():
        val path = retained_paths[index]
        val identity = retained_identities[index]
        if path == "" or not sha256_lower_hex_valid(identity):
            return Err("MIR projected ownership lacks admitted identity at {index}")
        if identity_by_path.has(path) and identity_by_path[path] != identity:
            return Err("MIR projected ownership content conflict for {path}")
        identity_by_path[path] = identity
        index = index + 1
    Ok(identity_by_path)

pub fn driver_mir_projected_source_identities_v1(retained_paths: [text],
        retained_identities: [text], selected_paths: [text]) -> Result<[text], text>:
    """Join selected source order to retained full-content admission.
    Returned positions belong to selected_paths, never retained receipt rows.
    This does not reread released source text or infer identity from a basename.
    """
    val admission = driver_mir_retained_identities_by_path_v1(retained_paths, retained_identities)
    if admission.is_err(): return Err(admission.unwrap_err())
    val identity_by_path = admission.unwrap()
    var selected_identities: [text] = []
    for path in selected_paths:
        if path == "" or not identity_by_path.has(path):
            return Err("MIR projected ownership missing retained source: {path}")
        selected_identities = selected_identities.push(identity_by_path[path])
    Ok(selected_identities)


pub fn driver_mir_entry_alias_projection_required_v1(source_count: i64,
        retained_count: i64, entry_requested: bool,
        bootstrap_shortcuts: bool, bootstrap_enabled: bool) -> bool:
    # Streaming entry parsing can retain every logical alias, so equal source
    # and receipt counts do not prove that the provider feed is physical.
    source_count > 0 and entry_requested and
        (source_count != retained_count or (bootstrap_shortcuts and bootstrap_enabled))
