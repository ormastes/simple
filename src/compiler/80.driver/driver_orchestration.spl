use compiler.driver.driver_compiler_type.{CompilerDriver}
use compiler.driver.driver_types.{CompileContext}
use compiler.driver.driver_pipeline.*
use compiler.driver.driver_aot_pipeline.*
use compiler.driver.driver_aot_output.{driver_native_sources_fingerprint}
use compiler.driver.driver_log_helpers.{
    log_debug,
    log_trace,
    log_warn,
    log_error,
    log_phase
}
use compiler.driver.driver_evidence_identity.{driver_evidence_identity_begin}
use compiler.driver.driver_phase_profile.{
    phase_profile_begin,
    phase_profile_physical_descriptor,
    phase_profile_failed,
    phase_profile_finish_with_outcome,
    phase_profile_abort
}
use compiler.hir.hir_lowering.module_surface.{module_surface_canonical_path}
use compiler.driver.driver_mem_snapshot.{
    mem_snapshot_begin,
    mem_snapshot_failed,
    mem_snapshot_finish_with_outcome,
    mem_snapshot_abort
}
use compiler.driver.driver_evidence_identity.{driver_evidence_identity_begin}
use compiler.driver.driver_phase_profile.{
    phase_profile_begin,
    phase_profile_physical_descriptor,
    phase_profile_failed,
    phase_profile_finish_with_outcome,
    phase_profile_abort
}
use compiler.hir.hir_lowering.module_surface.{module_surface_canonical_path}
use compiler.driver.driver_mem_snapshot.{
    mem_snapshot_begin,
    mem_snapshot_failed,
    mem_snapshot_finish_with_outcome,
    mem_snapshot_abort
}
use compiler.common.driver_core_types.{CompileMode, CompileResult}
use compiler.common.attributes.{
    VhdlHardwareMetadataFlatRow,
    VhdlResetPolarity,
    VhdlResetSynchrony,
    parse_vhdl_hardware_attrs
}
use compiler.frontend.parser_types.{Module, Function}
use compiler.frontend.core.lexer.{lexer_release_parse_source_globals}
use compiler.core.ast_coverage_inventory.{compiler_coverage_inventory_reset, compiler_coverage_inventory_valid, compiler_coverage_inventory_error, compiler_coverage_inventory_emit, compiler_mcdc_obligation_manifest_emit}
use std.nogc_sync_mut.io.env_ops.{env_get}
use std.nogc_sync_mut.io.process_ops.{eprint}

pub use compiler.driver.driver_phase_gates.{driver_streaming_surface_enabled}

impl CompilerDriver:
    me capture_vhdl_metadata():
        var metadata_rows: [VhdlHardwareMetadataFlatRow] = []
        for module_name in self.ctx.modules.keys():
            val source_module: Module = self.ctx.modules[module_name]
            for function_name in source_module.functions.keys():
                val source_function: Function = source_module.functions[function_name]
                val metadata = parse_vhdl_hardware_attrs(source_function.attributes)
                if metadata.is_hardware:
                    var generic_names: [text] = []
                    var generic_type_texts: [text] = []
                    var generic_default_texts: [text] = []
                    for generic in metadata.generics:
                        generic_names = generic_names.push(generic.name)
                        generic_type_texts = generic_type_texts.push(generic.type_text)
                        generic_default_texts = generic_default_texts.push(
                            generic.default_text)
                    var return_field_labels: [text] = []
                    var return_field_type_texts: [text] = []
                    for field in metadata.return_fields:
                        return_field_labels = return_field_labels.push(field.label)
                        return_field_type_texts = return_field_type_texts.push(
                            field.type_text)
                    metadata_rows = metadata_rows.push(VhdlHardwareMetadataFlatRow(
                        module_name: module_name,
                        function_name: source_function.name,
                        generic_names: generic_names,
                        generic_type_texts: generic_type_texts,
                        generic_default_texts: generic_default_texts,
                        has_clocked: if metadata.has_clocked: 1 else: 0,
                        clock_signal: metadata.clocked.clock_signal,
                        reset_signal: metadata.clocked.reset_signal,
                        has_reset: if metadata.clocked.has_reset: 1 else: 0,
                        reset_polarity: if metadata.clocked.reset_polarity ==
                            VhdlResetPolarity.ActiveHigh: 1 else: 0,
                        reset_synchrony: if metadata.clocked.reset_synchrony ==
                            VhdlResetSynchrony.Sync: 1 else:
                            if metadata.clocked.reset_synchrony ==
                                VhdlResetSynchrony.None_: 2 else: 0,
                        domain: metadata.clocked.domain,
                        clocked_is_valid: if metadata.clocked.is_valid: 1 else: 0,
                        clocked_validation_errors: metadata.clocked.validation_errors,
                        return_field_labels: return_field_labels,
                        return_field_type_texts: return_field_type_texts,
                        flatten_struct_output: if metadata.flatten_struct_output:
                            1
                        else:
                            0
                    ))
        self.ctx.vhdl_hardware_metadata_rows = metadata_rows
        if (rt_env_get("SIMPLE_COMPILER_TRACE") ?? "") == "1":
            eprint("[vhdl-driver] captured-metadata={metadata_rows.len()}")

    me compile() -> CompileResult:
        self.compile_routed(0)

    me compile_routed(streaming_eligibility_mask: i64) -> CompileResult:
        val log = self.ctx.logger
        var compile_mode_text = self.ctx.options.mode.to_text()
        if self.ctx.options.cli_mode_text != "":
            compile_mode_text = self.ctx.options.cli_mode_text

        log_phase("compile:start")
        log_phase("phase1:load_sources:start")
        val (loaded_ctx, load_ok) = self.load_sources_impl()
        self.ctx = loaded_ctx
        if not load_ok:
            log_error("phase 1 FAILED")
            return CompileResult.ParseError(self.ctx.errors)
        if compile_mode_text == "aot":
            self.ctx.native_sources_fingerprint = driver_native_sources_fingerprint(self.ctx.sources)
        log_phase("phase1:load_sources:done n_sources={self.ctx.sources.len()}")

        # Capture the pipeline selector while the loaded CompileContext is
        # still authoritative. Streaming Phase 2 and 3 mutate that same owner
        # in place and never transport it through a large returned tuple.
        val streaming_pipeline = driver_streaming_surface_enabled(self.ctx)
        # The exact predicate above owns both the control-flow branch and the
        # immutable evidence mode. Capture run identity once before either
        # Phase-2 branch; both durable streams reuse that frozen scalar.
        val evidence_mode = if streaming_pipeline:
            "streaming"
        else:
            "nonstreaming"
        if driver_evidence_identity_begin(evidence_mode) < 0:
            self.ctx.add_error(
                "durable compiler evidence requires one valid 8..64 byte SIMPLE_EVIDENCE_RUN_ID")
            return CompileResult.ParseError(self.ctx.errors)
        val phase_profile_status = phase_profile_begin()
        if phase_profile_status < 0:
            phase_profile_abort()
            self.ctx.add_error(
                "SIMPLE_COMPILER_PHASE_PROFILE_FILE could not be established safely")
            return CompileResult.ParseError(self.ctx.errors)
        # Bind the phase stream to the exact dense physical-source set before
        # any lifecycle record. Canonical-path aliases map to the same planner
        # owner and deliberately emit no compiler descriptor or lifecycle.
        if phase_profile_status > 0:
            var descriptor_index_by_path: Dict<text, i64> = {}
            var descriptor_physical_count: i64 = 0
            var descriptor_source_index: i64 = 0
            while descriptor_source_index < self.ctx.sources.len():
                val descriptor_source = self.ctx.sources[descriptor_source_index]
                val descriptor_path = module_surface_canonical_path(
                    descriptor_source.path)
                if not descriptor_index_by_path.contains_key(descriptor_path):
                    val physical_index = descriptor_physical_count
                    descriptor_index_by_path[descriptor_path] = physical_index
                    descriptor_physical_count = descriptor_physical_count + 1
                    if not phase_profile_physical_descriptor(
                        physical_index, descriptor_path,
                        descriptor_source.module_name):
                        phase_profile_abort()
                        self.ctx.add_error(
                            "durable physical-source descriptor publication failed")
                        return CompileResult.ParseError(self.ctx.errors)
                descriptor_source_index = descriptor_source_index + 1
        log_phase("phase2:parse:start")
        log_debug("phase 2: parsing...")
        compiler_coverage_inventory_reset(self.ctx.config.contains_key("coverage"))
        var parse_ok = false
        if streaming_pipeline:
            parse_ok = self.parse_all_streaming_surfaces_impl()
        else:
            val (parsed_ctx, returned_parse_ok) = self.parse_all_impl()
            self.ctx = parsed_ctx
            parse_ok = returned_parse_ok
        if not parse_ok:
            log_error("phase 2 FAILED")
            log_build_progress("parse", "files", -1, self.ctx.sources.len(),
                "failed", 1, 6, 1, 0, "failed")
            if phase_profile_failed() or
               not phase_profile_finish_with_outcome("phase2-failed"):
                phase_profile_abort()
                self.ctx.add_error(
                    "durable phase evidence terminal publication failed after phase 2")
            return CompileResult.ParseError(self.ctx.errors)
        if self.ctx.config.contains_key("coverage") or mcdc_enabled:
            if not compiler_coverage_inventory_valid():
                self.ctx.add_error(compiler_coverage_inventory_error())
                if phase_profile_failed() or
                   not phase_profile_finish_with_outcome("phase2-failed"):
                    phase_profile_abort()
                    self.ctx.add_error(
                        "durable phase evidence terminal publication failed after coverage validation")
                return CompileResult.ParseError(self.ctx.errors)
        if self.ctx.config.contains_key("coverage"):
            compiler_coverage_inventory_emit()
        if mcdc_enabled:
            compiler_mcdc_obligation_manifest_emit()
        if self.ctx.options.backend == "vhdl":
            self.capture_vhdl_metadata()
        log_debug("phase 2 done")
        val parsed_module_count = self.ctx.modules.keys().len()
        log_phase("phase2:parse:done n_modules={parsed_module_count}")
        log_build_progress("parse", "modules", parsed_module_count,
            parsed_module_count, "complete", 2, 6, 0, 0, "running")

        if self.ctx.source_contents_reclaimable() and not streaming_pipeline:
            log_phase("phase2:source_reclaim:start low_memory=true")
            log_debug("low-memory: evicting source text")
            lexer_release_parse_source_globals()
            val reclaimed_sources = self.ctx.reclaim_source_contents()
            log_debug("low-memory: reclaimed source buffers={reclaimed_sources}")
            self.ctx.evict_sources()
            log_phase("phase2:source_reclaim:done reclaimed={reclaimed_sources}")

        if phase_profile_failed():
            phase_profile_abort()
            self.ctx.add_error("durable phase evidence write failed during phase 2")
            return CompileResult.ParseError(self.ctx.errors)
        # Memory evidence begins once, above the shared streaming/nonstreaming
        # HIR branch. Each physical HIR owner emits the same four boundaries.
        if mem_snapshot_begin() < 0:
            mem_snapshot_abort()
            val phase_terminal_ok = phase_profile_finish_with_outcome(
                "evidence-failed")
            if not phase_terminal_ok:
                phase_profile_abort()
            self.ctx.add_error(
                "SIMPLE_MEM_SNAPSHOT_FILE could not be established safely")
            return CompileResult.TypeError(self.ctx.errors)
        log_phase("phase3:hir_typecheck:start")
        log_trace("BEFORE phase 3")
        var analyze_ok = false
        if streaming_pipeline:
            analyze_ok = self.lower_and_check_streaming_surfaces_impl()
        else:
            val (analyzed_ctx, returned_analyze_ok) = self.lower_and_check_impl()
            self.ctx = analyzed_ctx
            analyze_ok = returned_analyze_ok
        log_trace("AFTER phase 3")
        if analyze_ok:
            log_debug("phase 3 done")
            log_phase("phase3:hir_typecheck:done")
        else:
            log_phase("phase3:hir_typecheck:failed")

        # Close both evidence owners exactly once after the common HIR branch.
        # Any earlier sink failure changes the surviving sink's terminal to
        # evidence-failed; the failed sink itself is never trusted to publish a
        # successful terminal.
        var evidence_outcome = if analyze_ok:
            "hir-complete"
        else:
            "hir-diagnostic"
        if phase_profile_failed() or mem_snapshot_failed():
            evidence_outcome = "evidence-failed"
        var memory_terminal_ok = false
        if mem_snapshot_failed():
            mem_snapshot_abort()
        else:
            memory_terminal_ok = mem_snapshot_finish_with_outcome(
                evidence_outcome)
            if not memory_terminal_ok:
                evidence_outcome = "evidence-failed"
                mem_snapshot_abort()
        var phase_terminal_ok = false
        if phase_profile_failed():
            phase_profile_abort()
        else:
            phase_terminal_ok = phase_profile_finish_with_outcome(
                evidence_outcome)
            if not phase_terminal_ok:
                phase_profile_abort()
        if not memory_terminal_ok or not phase_terminal_ok:
            self.ctx.add_error(
                "durable Stage-3 evidence terminal publication failed")
            analyze_ok = false

        if not analyze_ok:
            log_error("phase 3 FAILED")
            if env_get("SIMPLE_BOOTSTRAP_DEBUG") == "1":
                val phase3_error_count = self.ctx.errors.len()
                eprint("[bootstrap-phase3-errors] count={phase3_error_count}")
                var phase3_error_index = 0
                while phase3_error_index < phase3_error_count and phase3_error_index < 20:
                    val phase3_error = self.ctx.error_message_at(phase3_error_index)
                    eprint("[bootstrap-phase3-error] index={phase3_error_index} len={phase3_error.len()} text={phase3_error}")
                    phase3_error_index = phase3_error_index + 1
            log_build_progress("hir", "modules", -1, -1,
                "failed", 2, 6, 1, 0, "failed")
            if self.ctx.has_errors():
                val first_error = self.ctx.error_message_at(0)
                if first_error.contains("Method resolution"):
                    return CompileResult.ResolveError(self.ctx.errors)
            return CompileResult.TypeError(self.ctx.errors)
        log_build_progress("hir", "modules", -1, -1,
            "complete", 3, 6, 0, 0, "running")

        if self.ctx.options.low_memory:
            log_debug("low-memory: evicting AST modules")
            self.ctx.evict_ast()

        if compile_mode_text == "check":
            log_debug("check mode")
            return CompileResult.Success(nil)

        log_phase("phase4:monomorphize:start")
        log_debug("phase 4: monomorphization...")
        val mono_ok = self.monomorphize_impl()
        if not mono_ok:
            log_error("phase 4 FAILED")
            return CompileResult.TypeError(self.ctx.errors)
        log_debug("phase 4 done")
        log_phase("phase4:monomorphize:done")

        log_phase("phase5:mode_dispatch:start")
        log_debug("phase 5: mode-specific processing...")
        if compile_mode_text == "check":
            log_debug("check mode")
            return CompileResult.Success(nil)
        if compile_mode_text == "sdn":
            log_debug("sdn mode")
            return _driver_finish_destination_graph_compile(self.process_sdn())
        if compile_mode_text == "interpret":
            log_debug("interpret mode")
            return _driver_finish_destination_graph_compile(self.interpret())
        if compile_mode_text == "jit":
            log_debug("jit mode")
            return _driver_finish_destination_graph_compile(
                self.jit_compile_and_run())
        if compile_mode_text == "aot":
            log_debug("aot mode")
            return _driver_finish_destination_graph_compile(self.aot_compile())
        if compile_mode_text == "smf_exec":
            log_debug("smf_exec mode")
            return _driver_finish_destination_graph_compile(self.execute_smf())

        log_warn("no mode matched, falling through")
        _driver_finish_destination_graph_compile(CompileResult.Success(nil))

    me compile_vhdl_only() -> CompileResult:
        if self.ctx.options.backend != "vhdl" or self.ctx.options.mode != CompileMode.Aot:
            return CompileResult.CodegenError(
                "fixed VHDL runner requires AOT mode with backend=vhdl")

        val load_ok = self.load_sources_impl()
        if not load_ok:
            return CompileResult.ParseError(self.ctx.errors)

        val (parsed_ctx, parse_ok) = self.parse_all_impl()
        self.ctx = parsed_ctx
        if not parse_ok:
            return CompileResult.ParseError(self.ctx.errors)
        self.capture_vhdl_metadata()
        val analyze_ok = self.lower_and_check_impl()
        if not analyze_ok:
            if self.ctx.has_errors() and self.ctx.error_message_at(0).contains("Method resolution"):
                return CompileResult.ResolveError(self.ctx.errors)
            return CompileResult.TypeError(self.ctx.errors)
        if self.ctx.options.low_memory:
            self.ctx.evict_ast()

        if not self.monomorphize_impl():
            return CompileResult.TypeError(self.ctx.errors)
        if not self.lower_to_mir():
            # See driver_aot_pipeline.spl's aot_compile() for the full
            # writeup: builtin `Array.first()` has no MIR method symbol
            # under native codegen and lowers to a `call 0` placeholder --
            # a genuine SIGSEGV baked into stage3's own binary, confirmed
            # via gdb/objdump. Avoid it with a length-guarded index read.
            val message = if self.ctx.has_errors():
                self.ctx.error_message_at(0)
            else:
                "MIR lowering failed"
            return CompileResult.CodegenError(message)
        if not self.borrow_check():
            return CompileResult.BorrowError(self.ctx.errors)

        val _ = self.process_async()
        self.weave_aop()
        self.apply_debug_trace()
        _driver_finish_destination_graph_compile(
            self.compile_to_vhdl(self.ctx.options.output_file ?? "a.out"))
