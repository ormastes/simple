extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_file_write_text_at(path: text, offset: i64, content: text) -> bool
extern fn rt_file_copy(src: text, dst: text) -> bool
extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)
extern fn rt_env_get(key: text) -> text

pub fn bootstrap_native_opt_level(ctx: CompileContext, is_release: bool) -> i64:
    if ctx.options.opt_level.?:
        return ctx.options.opt_level ?? 0
    if is_release:
        return 3
    0

pub fn bootstrap_llvm_opt_level(opt_level_i64: i64) -> OptimizationLevel:
    if opt_level_i64 <= 0:
        OptimizationLevel.None_
    elif opt_level_i64 == 1:
        OptimizationLevel.Size
    elif opt_level_i64 == 2:
        OptimizationLevel.Speed
    else:
        OptimizationLevel.Aggressive

pub fn bootstrap_symbol_for_name(name: text) -> SymbolId:
    if name == "bootstrap_version":
        return SymbolId(id: 1)
    if name == "native_build_help":
        return SymbolId(id: 2)
    if name == "compile_result_exit":
        return SymbolId(id: 3)
    if name == "run_native_build_bootstrap":
        return SymbolId(id: 4)
    if name == "get_cli_args":
        return SymbolId(id: 5)
    if name == "main":
        return SymbolId(id: 6)
    SymbolId(id: 100)

pub fn bootstrap_function_names() -> [text]:
    ["bootstrap_version", "native_build_help", "compile_result_exit", "run_native_build_bootstrap", "get_cli_args", "main"]

pub fn bootstrap_compile_to_native_local(ctx: CompileContext, backend_name: text, output: text) -> CompileResult:
    if ctx.storage_view_site_bindings.len() > 0:
        return CompileResult.CodegenError(
            "bootstrap-local native route does not support typed storage bindings")
    """Fail closed: the old direct-IR path emitted ret-0 diagnostic stubs."""
    val _ = ctx
    val _backend = backend_name
    val _output = output
    CompileResult.CodegenError("bootstrap direct stub IR was removed; use real Simple lowering/codegen")

pub fn bootstrap_emit_seed_wrapper(output: text) -> CompileResult:
    """Fail closed: bootstrap stages must not delegate to a seed fallback."""
    val _ = output
    CompileResult.CodegenError("bootstrap seed-wrapper fallback was removed")

pub fn bootstrap_entry_module_name(ctx: CompileContext) -> text:
    val native_entry = rt_env_get("SIMPLE_NATIVE_BUILD_ENTRY") ?? ""
    if native_entry != "":
        var i = 0
        while i < ctx.sources.len():
            val source = ctx.sources[i]
            if source.path == native_entry or source.path.ends_with("/" + native_entry):
                return source.module_name
            i = i + 1
        return _driver_module_name_from_path(native_entry)
    "app.cli.bootstrap_main"


pub fn bootstrap_lower_to_mir_context(ctx: CompileContext) -> (CompileContext, bool):
    """Bootstrap MIR lowering as a free function to avoid Stage1 method dispatch instability."""
    print "[driver-mir] bootstrap free:start"
    var next_ctx = ctx
    val target_context = driver_mir_target_context(ctx.options)
    # Hand the real HIR module for the requested entry (produced by the HIR phase
    # from the freshly-parsed Module.functions) to the MIR free path so it lowers
    # real bodies instead of ret-0 stubs.
    val entry_module_name = bootstrap_entry_module_name(ctx)
    val closure_mode = (rt_env_get("SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE") ?? "") == "1"
    if closure_mode and bootstrap_hir_module_count() > 0:
        if bootstrap_trace_enabled():
            print "[driver-mir] bootstrap flat:start entry={entry_module_name} modules={bootstrap_hir_module_count()}"
        val flat_bootstrap_mir = bootstrap_lower_flat_hir_modules_to_mir_for_target(entry_module_name, target_context)
        next_ctx.mir_modules[entry_module_name] = flat_bootstrap_mir
        next_ctx.set_bootstrap_entry_mir(entry_module_name, flat_bootstrap_mir)
        return (next_ctx, not next_ctx.has_errors())
    bootstrap_clear_entry_hir_module()
    bootstrap_function_value_names_reset()
    for hir_module in ctx.hir_modules.values():
        if hir_module != nil:
            bootstrap_register_function_value_module(hir_module)
            # Pre-register Str return types for EVERY closure module before
            # the entry lowers — see bootstrap_register_fn_ret_types_module
            # (native_call_return_type_loss 2026-07-23, cross-module ordering).
            bootstrap_register_fn_ret_types_module(hir_module)
    if ctx.bootstrap_entry_hir.?:
        bootstrap_set_entry_hir_module(ctx.bootstrap_entry_hir.unwrap())
        bootstrap_register_fn_ret_types_module(ctx.bootstrap_entry_hir.unwrap())
    else:
        val mapped_entry_hir = ctx.hir_modules[entry_module_name]
        if mapped_entry_hir != nil:
            bootstrap_set_entry_hir_module(mapped_entry_hir)
            bootstrap_register_fn_ret_types_module(mapped_entry_hir)
    var bootstrap_mir = bootstrap_lower_hir_globals_to_mir_module_for_target(target_context)
    # The entry bridge has completed its only read of the promoted HIR owner.
    # Release it before the LLVM/codegen stages allocate their larger graphs.
    bootstrap_clear_entry_hir_module()
    # --entry-closure builds parse+HIR-lower EVERY module reachable from the
    # entry (see SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE handling in driver.spl and
    # flat_is_bootstrap_entry_path), but the line above only feeds the single
    # entry module into MIR lowering. The real object emitter
    # (bootstrap_emit_real_llvm_object) reads the flat
    # _bootstrap_mir_functions accumulator by index, not a per-module
    # MirModule -- so a helper module's functions, though correctly
    # HIR-lowered and resolvable by name in the entry's symbol table (see
    # resolve_import_symbols), never reached that accumulator and linked as
    # "undefined symbol: <fn>". Lower every OTHER closure module's functions
    # too, appending to the same accumulator (bug
    # bootstrap_stage2_empty_mir_bodies_2026-07-05, cross-module closure gap,
    # stage 3: object emission).
    val closure_mode = (rt_env_get("SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE") ?? "") == "1"
    if closure_mode:
        for extra_hir in ctx.hir_modules.values():
            if extra_hir != nil:
                val extra_name = _driver_module_name_from_path(extra_hir.name)
                if extra_name != entry_module_name:
                    if bootstrap_trace_enabled():
                        print "[driver-mir] bootstrap closure extra module={extra_name}"
                    val _added = bootstrap_lower_extra_hir_module_to_mir_for_target(extra_hir, target_context)
    next_ctx.mir_modules[entry_module_name] = bootstrap_mir
    next_ctx.set_bootstrap_entry_mir(entry_module_name, bootstrap_mir)
    if bootstrap_trace_enabled():
        print "[driver-mir] bootstrap free:done"
    (next_ctx, not next_ctx.has_errors())

pub fn bootstrap_empty_hir_module() -> HirModule:
    HirModule(
        name: "app.cli.bootstrap_main",
        path: "",
        imports: [],
        exports: [],
        domain_blocks: [],
        symbols: SymbolTable.new(),
        functions: {},
        classes: {},
        structs: {},
        enums: {},
        bitfields: {},
        traits: {},
        impls: [],
        constants: {},
        static_asserts: [],
        aop_advices: [],
        di_bindings: [],
        arch_rules: [],
        mock_decls: [],
        types: []
    )

pub fn bootstrap_driver_stub_mir_function(symbol: SymbolId, name: text) -> MirFunction:
    val signature = MirSignature(params: [], return_type: MirType.i64(), is_variadic: false)
    val block = MirBlock(
        id: BlockId.entry(),
        label: Some("entry"),
        instructions: [],
        terminator: MirTerminator.Ret(Some(mir_operand_const_int(0)))
    )
    MirFunction(
        symbol: symbol,
        name: name,
        signature: signature,
        locals: [],
        blocks: [block],
        entry_block: BlockId.entry(),
        span: nil,
        generic_params: [],
        is_generic_template: false,
        specialization_of: nil,
        type_bindings: {},
        layout_phase: nil,
        is_kernel: false,
        gpu_target: "",
        gpu_backend_order: "",
        is_export_c: false,
        export_name: "",
        has_driver_manifest_attr: false,
        driver_manifest_attr: nil,
        has_vhdl_metadata: false,
        vhdl_metadata: nil,
        has_fast_math: false,
        unroll_factor: 0,
        pipeline_ii: 0,
        memory_banks: 0
    )

pub fn bootstrap_lower_hir_globals_to_mir_module_driver() -> MirModule:
    """Driver-local entry point for real bootstrap MIR lowering."""
    log_phase("aot:bootstrap_driver_mir:start")
    val module = bootstrap_lower_hir_globals_to_mir_module()
    log_phase("aot:bootstrap_driver_mir:done")
    module

fn bootstrap_ssa_phi_function(fn_: MirFunction) -> MirFunction:
    val rewritten = ssa_var_transform_blocks(fn_.blocks)
    if rewritten.applied:
        return MirFunction.with_blocks(fn_, rewritten.blocks)
    fn_

fn bootstrap_is_runtime_declared_name(name: text) -> bool:
    """Names emit_runtime_declarations() (asm_constraints_helpers.spl) always
    statically pre-declares with their REAL signature but does not also add to
    `defined_func_names` (that dict only covers a subset -- see its own
    registrations). bootstrap_emit_llvm_trailer's fallback below emits a
    generic `declare {ret} @name(...)` for any call target not covered by
    EITHER check, which is a wrong-signature REDEFINITION for these -- llc
    rejects the module. This used to be a stale 6-name list that predated
    rt_interp_cstr/rt_raw_u64_to_string/rt_raw_i64_to_string's addition to the
    static block (Bug #136 string interpolation); Task #144 hit the same gap
    routing `n.to_string()` through rt_raw_i64_to_string + rt_interp_cstr.
    Keep this list in sync with the static declares that aren't also added to
    defined_func_names. Do NOT broaden this to `name.starts_with("rt_")`:
    rt_len (and other rt_* helpers with no static declare, e.g. rt_string_data,
    rt_string_starts_with) rely on the generic fallback declare below to be
    callable at all.
    """
    name == "rt_get_args" or name == "rt_env_get" or name == "rt_print" or name == "rt_println" or
    name == "rt_panic" or name == "rt_array_get" or name == "rt_interp_cstr" or
    name == "rt_raw_u64_to_string" or name == "rt_raw_i64_to_string" or name == "rt_raw_bool_to_string" or
    name == "rt_raw_f64_to_string"

fn bootstrap_unknown_decl_return_type(name: text) -> text:
    if name == "env_get":
        return "ptr"
    "i64"

fn bootstrap_emit_llvm_trailer(translator: MirToLlvm):
    if translator.unknown_func_decls.len() > 0:
        translator.builder.emit("")
        translator.builder.emit("; External call declarations")
        for unknown_name in translator.unknown_func_decls.keys():
            if not translator.defined_func_names.has(unknown_name) and not bootstrap_is_runtime_declared_name(unknown_name):
                translator.builder.emit("declare {bootstrap_unknown_decl_return_type(unknown_name)} @{unknown_name}(...)")
    val string_globals = translator.string_global_text
    if string_globals != "":
        translator.builder.emit("")
        translator.builder.emit("; String constants")
        translator.builder.emit(string_globals)

pub fn bootstrap_emit_real_llvm_object(output: text, opt_level_i64: i64) -> CompileResult:
    """Emit LLVM for bootstrap MIR functions from the local driver module instance."""
    log_phase("aot:bootstrap_real_llvm:start")
    val temp_obj = llvm_bootstrap_last_object_path()
    val temp_ir = bootstrap_llvm_ir_path_from_object_path(temp_obj)
    var translator: MirToLlvm = MirToLlvm.create("app.cli.bootstrap_main", CodegenTarget.Host, nil)
    val bootstrap_ir_handle = llvm_ir_builder_handle(translator.builder)
    translator.builder.emit_module_header()
    translator.emit_runtime_declarations()
    var flat_module = MirModule(name: "app.cli.bootstrap_main", functions: {}, statics: {}, constants: {}, types: {})
    var static_index = 0
    while static_index < bootstrap_mir_static_count():
        val static_ = bootstrap_mir_static_at(static_index)
        flat_module.statics[static_.symbol] = static_
        static_index = static_index + 1
    translator.emit_module_statics(flat_module)
    val count = bootstrap_mir_function_count()
    print "[bootstrap-real-llvm] count {count}"
    log_phase("aot:bootstrap_real_llvm:functions")
    var idx = 0
    while idx < count:
        val name = bootstrap_mir_function_name_at(idx)
        print "[bootstrap-real-llvm] function {name}"
        val fn_ = bootstrap_mir_function_at(idx)
        if bootstrap_trace_enabled():
            print "[bootstrap-real-llvm] ssa-start {name}"
        val ssa_fn = bootstrap_ssa_phi_function(fn_)
        if bootstrap_trace_enabled():
            print "[bootstrap-real-llvm] body-start {name}"
        val body = MirBody.from_function(ssa_fn)
        if bootstrap_trace_enabled():
            print "[bootstrap-real-llvm] translate-start {name}"
        translator.translate_function(if name == "main": "__simple_main" else: name, body)
        if bootstrap_trace_enabled():
            print "[bootstrap-real-llvm] translate-done {name}"
        idx = idx + 1
    val llvm_ir = translator.builder.build()
    log_phase("aot:bootstrap_real_llvm:compile")
    val compile_arch_detected = host_arch()
    val compile_os_detected = get_host_os()
    val compile_arch = if compile_arch_detected == "arm64" or compile_arch_detected == "aarch64": "aarch64" elif compile_arch_detected == "i386": "i686" else: compile_arch_detected
    val compile_os = if compile_os_detected == "macos": "darwin" else: compile_os_detected
    val compile_vendor = if compile_os_detected == "macos": "apple" elif compile_os_detected == "windows": "pc" else: "unknown"
    var compile_env: text? = nil
    if compile_os_detected == "windows":
        compile_env = Some("msvc")
    elif compile_os_detected != "macos" and compile_os_detected != "freebsd":
        compile_env = Some("gnu")
    val compile_triple = LlvmTargetTriple(arch: compile_arch, vendor: compile_vendor, os: compile_os, env: compile_env)
    val compile_cpu = if compile_arch == "aarch64": "generic" elif compile_arch == "x86_64": "x86-64" else: "generic"
    val compile_features: [text] = if compile_arch == "aarch64": ["+neon", "+fp-armv8"] else: []
    val compile_config = LlvmTargetConfig(triple: compile_triple, cpu: compile_cpu, features: compile_features, abi: nil)
    val result = compile_ir_to_object(llvm_ir, compile_config, bootstrap_llvm_opt_level(opt_level_i64))
    if result.is_err():
        val err = result.unwrap_err()
        return CompileResult.CodegenError("Bootstrap real LLVM compile failed: {err}")
    val bootstrap_obj = llvm_bootstrap_last_object_path()
    val obj_path = output + ".app.cli.bootstrap_main.o"
    if bootstrap_obj != "" and rt_file_copy(bootstrap_obj, obj_path):
        log_phase("aot:bootstrap_real_llvm:copied_obj")
        return CompileResult.Success(obj_path)
    CompileResult.CodegenError("Bootstrap real LLVM did not preserve an object file")

pub fn bootstrap_emit_real_llvm_module_object(module: MirModule, output: text, opt_level_i64: i64) -> CompileResult:
    """Emit LLVM for the bootstrap MIR module returned through CompileContext."""
    log_phase("aot:bootstrap_real_llvm_module:start")
    val config = LlvmTargetConfig.for_target_portable_numeric(CodegenTarget.Host, nil)
    val temp_obj = llvm_bootstrap_last_object_path()
    val temp_ir = bootstrap_llvm_ir_path_from_object_path(temp_obj)
    var translator: MirToLlvm = MirToLlvm.create("app.cli.bootstrap_main", CodegenTarget.Host, nil)
    translator.builder.emit_module_header()
    translator.emit_runtime_declarations()
    val fn_count = bootstrap_mir_function_count()
    print "[bootstrap-real-llvm-module] count {fn_count}"
    var idx = 0
    while idx < fn_count:
        val name = bootstrap_mir_function_name_at(idx)
        val fn_ = bootstrap_mir_function_at(idx)
        print "[bootstrap-real-llvm-module] function {name}"
        val body = MirBody.from_function(fn_)
        val name = if fn_.name == "main": "__simple_main" else: fn_.name
        val ret_ty = translator.llvm_type_text(body.return_ty)
        translator.remember_function_return_type(fn_.name, ret_ty)
        translator.remember_function_return_type(name, ret_ty)
    for fn_ in module.functions.values():
        if bootstrap_trace_enabled():
            print "[bootstrap-real-llvm-module] function {fn_.name}"
        if bootstrap_trace_enabled():
            print "[bootstrap-real-llvm-module] ssa-start {fn_.name}"
        val ssa_fn = bootstrap_ssa_phi_function(fn_)
        if bootstrap_trace_enabled():
            print "[bootstrap-real-llvm-module] body-start {fn_.name}"
        val body = MirBody.from_function(ssa_fn)
        if bootstrap_trace_enabled():
            print "[bootstrap-real-llvm-module] translate-start {fn_.name}"
        translator.translate_function(if fn_.name == "main": "__simple_main" else: fn_.name, body, fn_.span)
        if bootstrap_trace_enabled():
            print "[bootstrap-real-llvm-module] translate-done {fn_.name}"
    bootstrap_emit_llvm_trailer(translator)
    val llvm_ir = translator.builder.build()
    log_phase("aot:bootstrap_real_llvm_module:compile")
    val result = compile_ir_to_object(llvm_ir, config, bootstrap_llvm_opt_level(opt_level_i64))
    if result.is_err():
        val err = result.unwrap_err()
        return CompileResult.CodegenError("Bootstrap module LLVM compile failed: {err}")
    val bootstrap_obj = llvm_bootstrap_last_object_path()
    val obj_path = output + ".app.cli.bootstrap_main.o"
    if bootstrap_obj != "" and rt_file_copy(bootstrap_obj, obj_path):
        log_phase("aot:bootstrap_real_llvm_module:copied_obj")
        return CompileResult.Success(obj_path)
    CompileResult.CodegenError("Bootstrap module LLVM did not preserve an object file")

pub fn bootstrap_emit_driver_stub_llvm_object(output: text, opt_level_i64: i64) -> CompileResult:
    """Fail closed: bootstrap LLVM stubs are not valid compiler artifacts."""
    val _ = output
    val _opt = opt_level_i64
    CompileResult.CodegenError("bootstrap driver stub LLVM was removed")

pub fn compile_bootstrap_context_to_native(ctx: CompileContext, backend_name: text, output: text) -> CompileResult:
    if ctx.storage_view_site_bindings.len() > 0:
        return CompileResult.CodegenError(
            "bootstrap native route does not support typed storage bindings")
    """Compile the bootstrap MIR module stored on the context.

    Bootstrap stages must produce a real native compiler.  Seed-wrapper and
    ret-0 stub fallbacks are intentionally rejected.
    """
    if (rt_env_get("SIMPLE_BOOTSTRAP_DIRECT_STUB_IR") ?? "") == "1":
        return bootstrap_compile_to_native_local(ctx, backend_name, output)
    val is_release = ctx.options.release
    val opt_level = bootstrap_native_opt_level(ctx, is_release)
    val effective_backend = get_effective_backend_name(backend_name, is_release)
    val obj_path = output + ".app.cli.bootstrap_main.o"
    if ctx.bootstrap_entry_mir.?:
        val module = ctx.bootstrap_entry_mir.unwrap()
        val real_result = bootstrap_emit_real_llvm_module_object(module, output, opt_level)
        match real_result:
            case CompileResult.Success(_): ()
            case _: return real_result
    else:
        val compiled = compile_bootstrap_module_with_backend(backend_name, is_release, opt_level)
        if compiled.is_err():
            val err = compiled.unwrap_err()
            return CompileResult.CodegenError("Bootstrap native compile error: {err}")
        val bootstrap_obj = llvm_bootstrap_last_object_path()
        if bootstrap_obj != "" and rt_file_copy(bootstrap_obj, obj_path):
            log_phase("aot:bootstrap_native_context:copied_obj")
        else:
            return CompileResult.CodegenError("Bootstrap backend did not preserve an object file")
    if effective_backend == "llvm" or effective_backend == "llvm-lib":
        val llvm_opts = NativeLinkOptions(
            debug: ctx.options.debug_info,
            verbose: ctx.options.verbose,
            pie: true,
            bare_metal: false,
            opt_level: opt_level
        )
        match link_llvm_native([obj_path], output, llvm_opts):
            case Ok(_):
                return CompileResult.Success(output)
            case Err(e):
                return CompileResult.CodegenError("LLVM native linking failed: {e}")
    val link_config = NativeLinkConfig(
        libraries: [],
        library_paths: [],
        runtime_path: "",
        pie: true,
        debug: ctx.options.debug_info,
        verbose: ctx.options.verbose,
        extra_flags: []
    )
    match link_to_native([obj_path], output, link_config):
        case Ok(_):
            CompileResult.Success(output)
        case Err(e):
            CompileResult.CodegenError("Linking failed: {e}")

pub fn bootstrap_compile_context_to_native_local(ctx: CompileContext, backend_name: text, output: text) -> CompileResult:
    """Bootstrap-local real native output path; avoids cross-module driver helper dispatch."""
    log_phase("aot:bootstrap_native_local_real:start")
    if ctx.bootstrap_entry_mir.?:
        log_phase("aot:bootstrap_native_local_real:context_mir")
        return compile_bootstrap_context_to_native(ctx, backend_name, output)
    if (rt_env_get("SIMPLE_BOOTSTRAP_REAL_LLVM") ?? "") == "1":
        log_phase("aot:bootstrap_native_local_real:local_mir")
        log_phase("aot:bootstrap_native_local_real:free_mir:start")
        val bootstrap_mir = bootstrap_lower_hir_globals_to_mir_module_driver()
        log_phase("aot:bootstrap_native_local_real:free_mir:done")
        ctx.bootstrap_entry_mir = Some(bootstrap_mir)
        return compile_bootstrap_context_to_native(ctx, backend_name, output)
    val is_release = ctx.options.release
    val opt_level = bootstrap_native_opt_level(ctx, is_release)
    val effective_backend = get_effective_backend_name(backend_name, is_release)
    log_phase("aot:bootstrap_native_local_real:module")
    log_phase("aot:bootstrap_native_local_real:compile")
    val obj_path = output + ".app.cli.bootstrap_main.o"
    if (rt_env_get("SIMPLE_BOOTSTRAP_REAL_LLVM") ?? "") == "1":
        val real_result = bootstrap_emit_real_llvm_object(output, opt_level)
        match real_result:
            case CompileResult.Success(_): ()
            case _: return real_result
    else:
        val compiled = compile_bootstrap_module_with_backend(backend_name, is_release, opt_level)
        if compiled.is_err():
            val err = compiled.unwrap_err()
            return CompileResult.CodegenError("Bootstrap native compile error: {err}")
        val bootstrap_obj = llvm_bootstrap_last_object_path()
        if bootstrap_obj != "" and rt_file_copy(bootstrap_obj, obj_path):
            log_phase("aot:bootstrap_native_local_real:copied_obj")
        else:
            return CompileResult.CodegenError("Bootstrap backend did not preserve an object file")

    log_phase("aot:bootstrap_native_local_real:link")
    if effective_backend == "llvm" or effective_backend == "llvm-lib":
        val llvm_opts = NativeLinkOptions(
            debug: ctx.options.debug_info,
            verbose: ctx.options.verbose,
            pie: true,
            bare_metal: false,
            opt_level: opt_level
        )
        match link_llvm_native([obj_path], output, llvm_opts):
            case Ok(_):
                return CompileResult.Success(output)
            case Err(e):
                return CompileResult.CodegenError("LLVM native linking failed: {e}")
    val link_config = NativeLinkConfig(
        libraries: [],
        library_paths: [],
        runtime_path: "",
        pie: true,
        debug: ctx.options.debug_info,
        verbose: ctx.options.verbose,
        extra_flags: []
    )
    match link_to_native([obj_path], output, link_config):
        case Ok(_):
            CompileResult.Success(output)
        case Err(e):
            CompileResult.CodegenError("Linking failed: {e}")
