use compiler.driver.driver_compiler_type.{CompilerDriver}
use compiler.driver.driver_pipeline.*
use compiler.driver.driver_aot_output.*
# compile_to_vhdl is an optional plugin-owned CompilerDriver extension. The
# call below still needs its owning module in this compilation closure.
use plugins.backend_vhdl.driver.driver_aot_vhdl_output.*
