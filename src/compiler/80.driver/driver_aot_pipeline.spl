use compiler.driver.driver_ice_boundary.{ice_boundary_finalize}
use compiler.hir.hir_lowering.items.{bootstrap_hir_modules_reset}
# NOTE: these two MUST stay at module scope. A function-body-scoped
# `use <path>.{name}` is a silent no-op for symbol resolution, which made the
# both-format branch below die post-link with `error[E1002]: function
# 'update_smf_manifest_entry' not found`. See
# doc/08_tracking/bug/block_scoped_use_no_op_symbol_resolution_2026-08-18.md
use compiler.driver.cache.cache_validator.{source_to_cache_path}
use compiler.driver.cache.cache_root.{machine_cache_root}
use compiler.driver.watcher.smf_manifest.{update_smf_manifest_entry}
