    bootstrap_compile_to_native_local
}
use compiler.common.driver_core_types.{
    CompileResult,
    compileoptions_effective_mir_opt_level,
    driver_output_format_is_smf,
    driver_output_format_is_both,
    driver_output_format_is_self_contained
}
use std.io_runtime.{env_get_opt, file_read_result, hash_text, is_file}
use compiler.common.native_output_intent.{NativeOutputIntentV1, native_output_intent_decode_v1}
use compiler.driver.driver_build.native_group_request.{native_group_request_path_v1}
use compiler.driver.driver_build.native_staged_codegen.{NativeStagedCodegenStateV1,
    NATIVE_STAGED_CODEGEN_BATCH_ENV_V1, native_staged_codegen_batch_size_v1}
use compiler.driver.driver_build.native_mir_shard.{NATIVE_MIR_SHARD_QUEUE_ENV_V1,
    native_mir_shard_spec_v1, native_mir_shard_queue_v1, native_mir_shard_owner_v1,
    native_mir_shard_link_ledger_v1, native_mir_shard_publish_pass_v1,
    native_mir_shard_link_inputs_v1, native_mir_shard_module_passed_v1}
use compiler.driver.driver_aot_native_output.{driver_cold_hir_record_verified_object_v1, driver_cold_hir_record_objectless_v1}
use compiler.driver.driver_build.native_mir_fork_v1.{native_mir_fork_arm_v1, native_mir_fork_disarm_v1, native_mir_fork_exit_v1}
use compiler.driver.driver_build.native_mir_shard_export_v1.{
    native_mir_shard_export_enabled_v1, native_mir_shard_export_write_dir_v1}
use compiler.driver.driver_mir_shard_export_v1.{driver_mir_shard_export_write_v1,
    driver_mir_shard_export_admit_v1}
use compiler.driver.driver_mir_selective_worker_v1.{driver_mir_selective_enabled_v1}
use compiler.driver.driver_mir_selective_worker_v1.*
use compiler.driver.driver_mir_selective_eligibility_v1.{driver_mir_selective_explicit_native_eligible_v1,
    driver_mir_selective_skip_post_chain_v1}
use compiler.driver.driver_mir_selective_producer_v1.{driver_mir_selective_write_v1}
use compiler.driver.driver_hir_recovery.{hir_shard_recovery_seal,
    hir_shard_recovery_complete, hir_shard_recovery_block}
use compiler.driver.driver_build.build_outcome.{BuildUnitOutcome}
use compiler.driver.driver_build.go_to_end.{go_to_end_enabled_v1, go_to_end_write_manifest_v1,
    go_to_end_blocked_modules_v1,
    GO_TO_END_UNATTRIBUTED_V1}
use std.io_runtime.{exit}
use compiler.driver.driver_build.native_file_worker_v1.{native_file_worker_mir_done_publish_v1}
use std.io_runtime.{time_now_monotonic_ms}
use std.nogc_sync_mut.io.pipe.{stdout_flush}

fn native_build_cache_dir() -> text:
    val dir = env_get_opt("SIMPLE_NATIVE_BUILD_CACHE_DIR") ?? ""
    if dir == "":
        machine_cache_root() + "/native-build/v1"
    else:
        dir

# Stem (filename without extension) computed with rfind + `>= 0`/`> 0`
# checks, NOT std.path.stem/extension: those match rfind's raw i64 result
# against Some(idx)/nil, and under native MIR codegen a bare i64 never
# matches that Option pattern (crashes with "match expression exhausted...
# for i64 value N" -- verified live, not hypothesized).
fn _driver_default_stem(path_text: text) -> text:
    val slash = path_text.rfind("/")
    val base = if slash >= 0: path_text.substring(slash + 1) else: path_text
    val dot = base.rfind(".")
    if dot > 0:
        base.substring(0, dot)
    else:
        base

# Contained default when no output_file was requested: build/native/<stem of
# the first input file>, never a bare filename in cwd. See
# doc/03_plan/compiler/driver/default_output_dir_containment_plan.md.
fn _driver_default_output(input_files: [text]) -> text:
    if input_files.len() > 0:
        "build/native/{_driver_default_stem(input_files[0])}"
    else:
        "build/native/out"

# The SMF manifest row is keyed by the ENTRY source. native-build passes its
# `--source` DIRECTORIES before the entry (compile_targets.spl) and
# `--entry-closure` passes the BFS closure with the entry first, so in every
# producer the entry is the first input that is a regular file. Reading
# input_files[0] hashed a directory and, once the read failed closed
# (ec19563b735), turned every default native-build into a CodegenError.
fn _driver_entry_source_input(input_files: [text]) -> text:
    for path in input_files:
        if is_file(path):
            return path
    input_files[0]

impl CompilerDriver:
    me aot_compile() -> CompileResult:
        val log = self.ctx.logger
        # MIR shard export summary step (driver_build/native_mir_shard_export_v1.spl):
        # write the post-mono declaration bundle and exit before lowering.
        if native_mir_shard_export_write_dir_v1() != "":
            return self.aot_write_mir_shard_exports_v1()
        # Process-level MIR sharding (driver_build/native_mir_shard.spl).
        if native_mir_shard_spec_v1() != "":
            return self.aot_compile_mir_shard_v1()
        if native_mir_shard_link_ledger_v1() != "":
            return self.aot_link_mir_shards_v1()

        # Step 4->5 receipts. `log_phase` is env-gated and off by default, so
        # the whole post-MIR pass chain (borrow_check / process_async /
        # optimize_mir / weave_aop) was invisible in `[build]` receipts -- the
        # same mute-failure class as step 3. These are unconditional.
        log_build_progress("mir", "modules", 0, self.ctx.hir_modules.len(),
            "lower_to_mir", 4, 6, 0, 0, "running")
        log_phase("aot:lower_to_mir:start")
        val staged_batch = native_staged_codegen_batch_size_v1()
        if staged_batch < 0:
            return CompileResult.CodegenError(
                "{NATIVE_STAGED_CODEGEN_BATCH_ENV_V1} must be a non-negative decimal module count (0 disables staged native codegen)")
        # A requested batch that this lane refuses used to fall back silently
        # to whole-program MIR; name the reason so a bootstrap default that
        # did not take effect is visible in the stage log.
        val staged_reason = self.native_staged_codegen_eligible_reason_v1()
        if staged_batch > 0 and staged_reason != "" and
                (env_get_opt(NATIVE_STAGED_CODEGEN_BATCH_ENV_V1) ?? "") != "":
            print "[staged-codegen] refused batch={staged_batch} reason={staged_reason}; MIR is held whole-program"
            stdout_flush()
        self.native_staged_codegen = NativeStagedCodegenStateV1.begin(
            if staged_reason == "": staged_batch else: 0)
        val mir_ok = self.lower_to_mir()
        if not mir_ok:
            for err in self.ctx.errors:
                log_error("MIR error: {err}")
            # A staged batch ran the borrow checker before the tail finished
            # lowering; report it as the unstaged lane would.
            if self.native_staged_codegen.borrow_failed:
                return CompileResult.BorrowError(self.ctx.errors)
            # Bug (2026-08-06): builtin `Array.first()` has no MIR method
            # symbol under native codegen (same gap class as `push`/`map`/
            # `filter`/`fold` -- see Bug #149's comment a few files over in
            # method_calls_literals.spl) and lowers to an unresolved-method
            # placeholder. That placeholder's `call 0` (confirmed via gdb +
            # objdump: `call rel32` whose displacement resolves to absolute
            # 0, immediately followed by a nil-check matching this exact
            # `if X != nil` shape) is a genuine SIGSEGV baked into THIS
            # compiler's own stage3 binary at self-host build time, not just
            # a diagnostic gap -- every fatal MIR-lowering error reaching
            # this branch crashed the compiler process outright instead of
            # printing "Codegen error: ...". Avoid the broken builtin
            # entirely with a length-guarded index read (the established
            # safe substitution pattern in this codebase, see
            # doc/07_guide/language/dict_native_pitfalls.md for the sibling
            # Dict case). See
            # doc/08_tracking/bug/array_first_unresolved_native_codegen_core_dump_2026-08-06.md.
            # ICE boundary: when modules failed inside the per-module boundary the
            # result names all of them (and the receipt), not just the first error.
            val ice_summary = ice_boundary_finalize()
            if ice_summary != "":
                log_error(ice_summary)
            val msg = if ice_summary != "": ice_summary elif self.ctx.has_errors(): self.ctx.error_message_at(0) else: "MIR lowering failed"
            log_build_progress_failure("mir", "modules", "lower_to_mir", 4, 6)
            if go_to_end_enabled_v1():
                # Could not continue past MIR (early stop, verify failure, or
                # nothing lowered): still name every failure, never link.
                self.go_to_end_absorb_errors_v1("mir")
                return self.go_to_end_finish_v1(0, [])
            return CompileResult.CodegenError(msg)
        log_phase("aot:lower_to_mir:done")
        # The flat HIR store is scoped to MIR lowering: its only readers are done here.
        bootstrap_hir_modules_reset()
        log_build_progress("mir", "modules", self.ctx.mir_modules.len(),
            self.ctx.mir_modules.len(), "lower_to_mir", 4, 6, 0, 0, "running")

        # HIR is dead after MIR lowering for every AOT backend except vhdl and the
        # SIMPLE_BOOTSTRAP_DIRECT_IR dispatch (bootstrap_compile_to_native_local
        # re-reads ctx.hir_modules). Retaining it held the whole-closure HIR
        # through every MIR pass and codegen. evict_hir() saves AOP advices first.
        val hir_needed_after_mir = self.ctx.options.backend == "vhdl" or (env_get_opt("SIMPLE_BOOTSTRAP_DIRECT_IR") ?? "") == "1"
        if not hir_needed_after_mir:
            log_debug("evicting HIR modules after MIR lowering")
            self.ctx.evict_hir()

        val bootstrap_flat_aot = (env_get_opt("SIMPLE_BOOTSTRAP") ?? "") == "1" and (env_get_opt("SIMPLE_BOOTSTRAP_WHOLE_PROGRAM") ?? "") == "1" and (env_get_opt("SIMPLE_BOOTSTRAP_STAGE4") ?? "") != "1"
        if bootstrap_flat_aot:
            log_phase("aot:flat_mir_passes:skipped")
            log_bootstrap_flat_warning("aot:flat_mir_passes:skipped")
        else:
            log_phase("aot:borrow_check:start")
            log_build_progress("borrow_check", "modules", 0,
                self.ctx.mir_modules.len(), "start", 4, 6, 0, 0, "running")
            if not self.borrow_check():
                for err in self.ctx.errors:
                    log_error("Borrow error: {err}")
                log_build_progress("borrow_check", "modules", -1,
                    self.ctx.mir_modules.len(), "start", 4, 6, 1, 0, "failed")
                if go_to_end_enabled_v1():
                    self.go_to_end_absorb_errors_v1("borrow")
                    return self.go_to_end_finish_v1(0, [])
                return CompileResult.BorrowError(self.ctx.errors)
            log_phase("aot:borrow_check:done")
            log_build_progress("borrow_check", "modules",
                self.ctx.mir_modules.len(), self.ctx.mir_modules.len(),
                "done", 4, 6, 0, 0, "running")

            log_phase("aot:process_async:start")
            log_build_progress("process_async", "modules", 0,
                self.ctx.mir_modules.len(), "start", 4, 6, 0, 0, "running")
            val async_state_machines = self.process_async()
            log_phase("aot:process_async:done")
            log_build_progress("process_async", "modules",
                self.ctx.mir_modules.len(), self.ctx.mir_modules.len(),
                "done", 4, 6, 0, 0, "running")

            log_build_progress("optimize_mir", "modules", 0,
                self.ctx.mir_modules.len(), "start", 4, 6, 0, 0, "running")
            log_phase("aot:optimize_mir:start")
            val skip_mir_opt = env_get_opt("SIMPLE_BOOTSTRAP_SKIP_MIR_OPT") ?? ""
            if skip_mir_opt == "1":
                log_phase("aot:optimize_mir:skipped")
            else:
                val mir_opt_level = self.ctx.options.opt_level ?? 0
                self.optimize_mir_level(mir_opt_level)
            log_phase("aot:optimize_mir:done")
            log_build_progress("optimize_mir", "modules",
                self.ctx.mir_modules.len(), self.ctx.mir_modules.len(),
                "done", 4, 6, 0, 0, "running")

            log_phase("aot:weave_aop:start")
            log_build_progress("weave_aop", "modules", 0,
                self.ctx.mir_modules.len(), "start", 4, 6, 0, 0, "running")
            self.weave_aop()
            log_phase("aot:weave_aop:done")
            log_build_progress("weave_aop", "modules",
                self.ctx.mir_modules.len(), self.ctx.mir_modules.len(),
                "done", 4, 6, 0, 0, "running")

            log_phase("aot:debug_trace:start")
            self.apply_debug_trace()
            log_phase("aot:debug_trace:done")

        # The manager-owned full V2 index task needs the complete typed graph
        # and its emitted HIR/MIR facets, not a monolithic native binary.  It
        # must stop before backend codegen only after every SCV source has a
        # matching private artifact receipt.  The index publisher performs
        # separate archive/runtime/std readback before declaring success.
        val full_index_marker =
            (env_get_opt("SIMPLE_PACKAGE_INDEX_FULL_INVENTORY") ?? "") == "1"
        val full_index_selection =
            self.ctx.runtime_std_full_inventory_selection
        if full_index_marker or full_index_selection != nil:
            if not full_index_marker or full_index_selection == nil:
                return CompileResult.CodegenError(
                    "full inventory semantic selection differs from compiler mode")
            val expected = self.ctx.source_paths_owner.len()
            if expected == 0 or
                    self.ctx.cold_hir_typed_receipts.len() != expected or
                    self.ctx.runtime_std_hir_emissions.len() != expected or
                    self.ctx.runtime_std_mir_emissions.len() != expected:
                return CompileResult.CodegenError(
                    "full inventory typed HIR/MIR artifact count differs")
            val selected = full_index_selection!
            for receipt in self.ctx.cold_hir_typed_receipts:
                val seed = receipt.seed
                if seed.inventory_digest != selected.source_inventory_digest or
                        not self.ctx.runtime_std_hir_emissions.has(
                            seed.source_identity) or
                        not self.ctx.runtime_std_mir_emissions.has(
                            seed.source_identity):
                    return CompileResult.CodegenError(
                        "full inventory typed source artifact missing")
                val hir = self.ctx.runtime_std_hir_emissions[
                    seed.source_identity]
                val mir = self.ctx.runtime_std_mir_emissions[
                    seed.source_identity]
                if hir.module_identity != seed.module_identity or
                        hir.source_digest != seed.source_digest or
                        mir.module_identity != seed.module_identity or
                        mir.source_digest != seed.source_digest:
                    return CompileResult.CodegenError(
                        "full inventory typed source artifact differs")
            log_phase("aot:cold_full_index_semantics:done modules={expected}")
            return CompileResult.Success(None)

        log_phase("aot:output:start")
        val output = self.ctx.options.output_file ?? _driver_default_output(self.ctx.options.input_files)
        log_phase("aot:output:done")
        # go-to-end with failures recorded: only the per-module native lane can
        # emit the good objects without linking; every other dispatch would
        # turn a partial module set into an output, so it stops here.
        if go_to_end_enabled_v1() and self.go_to_end.len() > 0 and
                not self.native_staged_codegen_eligible_v1():
            return self.go_to_end_finish_v1(0, [])

        log_phase("aot:backend_name:start")
        val backend_name = self.ctx.options.backend
        log_phase("aot:backend_name:done")
        if backend_name == "c" or backend_name == "cpp" or backend_name == "ccodegen":
            return self.compile_to_c(output)
        if backend_name == "cuda" or backend_name == "ptx":
            return self.compile_to_cuda(output)
        if backend_name == "opencl" or backend_name == "opencl-c" or backend_name == "opencl-spirv" or backend_name == "cl":
            return self.compile_to_opencl(output)
        if backend_name == "vulkan" or backend_name == "spirv":
            return self.compile_to_vulkan(output)
        if backend_name == "vhdl":
            return self.compile_to_vhdl(output)
        if backend_name == "wasm" or backend_name == "wasm32":
            return self.compile_to_wasm(output)

        if (env_get_opt("SIMPLE_BOOTSTRAP_DIRECT_IR") ?? "") == "1":
            log_phase("aot:bootstrap_native_dispatch")
            return bootstrap_compile_to_native_local(self.ctx, backend_name, output)

        log_phase("aot:format:start")
        val format = self.ctx.options.output_format
        log_phase("aot:format:done")
        # This Stage-3 fixed-entry route has a validated closure in
        # `ctx.mir_modules`; use the normal per-module native output path so
        # every admitted provider is emitted and linked.
        # It is the "compile the bootstrap CLI" path, so SIMPLE_BOOTSTRAP=1 is
        # not on its own enough to route here: the Stage-2 admission probe sets
        # that variable while building hello_world.spl, and the resulting link
        # failed with `ld.lld: error: undefined symbol: __simple_main`
        # (measured 2026-09-13). Require that the bootstrap CLI really is part
        # of this compile, the same predicate and the same ctx.sources identity
        # that driver_pipeline_lowering.spl applies to the matching MIR gate.
        # Deliberately duplicated rather than shared: CompileContext lives in
        # the fenced driver_types.spl. Both sites must move together.
        var aot_bootstrap_entry_requested = false
        var aot_bootstrap_entry_idx = 0
        while aot_bootstrap_entry_idx < self.ctx.sources.len():
            if self.ctx.sources[aot_bootstrap_entry_idx].module_name == "app.cli.bootstrap_main":
                aot_bootstrap_entry_requested = true
            aot_bootstrap_entry_idx = aot_bootstrap_entry_idx + 1
        if aot_bootstrap_entry_requested and (env_get_opt("SIMPLE_BOOTSTRAP") ?? "") == "1" and (env_get_opt("SIMPLE_BOOTSTRAP_WHOLE_PROGRAM") ?? "") == "1" and (env_get_opt("SIMPLE_BOOTSTRAP_STAGE4") ?? "") != "1":
            log_phase("aot:bootstrap_native_context_dispatch")
            return self.compile_to_native(output)
        if driver_output_format_is_smf(format):
            return self.compile_to_smf(output)
        if driver_output_format_is_self_contained(format):
            return self.compile_to_self_contained(output)
        if driver_output_format_is_both(format):
            val native_result = self.compile_to_native(output)
            if not native_result.is_success():
                return native_result
            val source_path = _driver_entry_source_input(self.ctx.options.input_files)
            val smf_cache_path = source_to_cache_path(source_path, native_build_cache_dir(), ".smf")
            val smf_result = self.compile_to_smf(smf_cache_path)
            if smf_result.is_success():
                val smf_opt_level = compileoptions_effective_mir_opt_level(self.ctx.options)
                val source_result = file_read_result(source_path)
                val src = match source_result:
                    case Ok(content): content
                    case Err(read_error): return CompileResult.CodegenError(read_error)
                val src_hash = hash_text(src)
                update_smf_manifest_entry(
                    source_path,
                    smf_cache_path,
                    src_hash,
                    self.ctx.options.backend,
                    smf_opt_level,
                    self.ctx.options.release,
                    self.ctx.options.debug_info,
                    self.ctx.options.gc_off,
                    self.ctx.options.profile,
                    self.ctx.options.allowed_families
                )
            return CompileResult.Success(output)
        log_phase("aot:native_dispatch:start")
        return self.compile_to_native(output)

    me go_to_end_finish_v1(object_count: i64, built_modules: [text]) -> CompileResult:
        """go-to-end terminal: write `<output>.go-to-end.sdn` naming every
        failed module per stage, skip the link, and fail the build. Never a
        success, never a partial binary."""
        if self.go_to_end.len() == 0:
            self.go_to_end.record("build", GO_TO_END_UNATTRIBUTED_V1,
                "build failed without recorded diagnostics")
        val output = self.ctx.options.output_file ?? _driver_default_output(self.ctx.options.input_files)
        val verdict = go_to_end_write_manifest_v1(output, self.go_to_end, object_count, built_modules)
        print "[go-to-end] {verdict}"
        stdout_flush()
        CompileResult.CodegenError(verdict)

    me go_to_end_recover_hir_v1() -> bool:
        """go-to-end after a failed HIR phase. The HIR routes already DROP a
        poisoned module from ctx.hir_modules; this records each one (with the
        diagnostics that name its source path), excludes every surviving
        module that imports a failed one -- transitively -- and clears the
        phase errors so monomorphization and MIR run over the rest. False when
        the failure names no module (nothing to attribute: the caller stops)."""
        val poisoned_count = self.ctx.poisoned_module_count()
        if poisoned_count <= 0:
            return false
        var failed: [text] = []
        var poisoned_idx = 0
        while poisoned_idx < poisoned_count and poisoned_idx < self.ctx.poisoned_modules.len():
            val name = self.ctx.poisoned_modules[poisoned_idx]
            var seen = false
            for prior in failed:
                if prior == name:
                    seen = true
            if not seen:
                failed = failed.push(name)
            poisoned_idx = poisoned_idx + 1
        if failed.len() == 0:
            return false
        for failed_name in failed:
            var failed_path = ""
            for source in self.ctx.sources:
                if source.module_name == failed_name:
                    failed_path = source.path
            var attributed = 0
            var error_idx = 0
            while error_idx < self.ctx.error_count_value:
                val message = self.ctx.error_message_at(error_idx)
                if failed_path != "" and message.contains(failed_path):
                    self.go_to_end.record("hir", failed_name, message)
                    attributed = attributed + 1
                error_idx = error_idx + 1
            if attributed == 0:
                self.go_to_end.record("hir", failed_name,
                    "HIR lowering/type-check failed (diagnostics not attributable by path; see the unattributed rows)")
            self.go_to_end.exclude(failed_name)
            self.ctx.hir_modules.remove(failed_name)
        var candidates: [text] = []
        var edge_from: [text] = []
        var edge_to: [text] = []
        for hir_name in self.ctx.hir_modules.keys():
            if val hir_module = self.ctx.hir_modules[hir_name]:
                candidates = candidates.push(hir_name)
                for hir_import in hir_module.imports:
                    edge_from = edge_from.push(hir_name)
                    edge_to = edge_to.push(hir_import.module_path)
        val blocked = go_to_end_blocked_modules_v1(candidates, edge_from, edge_to, failed)
        for blocked_name in blocked:
            self.go_to_end.record("hir_dependency", blocked_name,
                "not lowered: imports (transitively) a module whose HIR failed")
            self.go_to_end.exclude(blocked_name)
            self.ctx.hir_modules.remove(blocked_name)
        self.go_to_end_absorb_errors_v1("hir")
        self.ctx.poisoned_modules = []
        self.ctx.poisoned_module_count_value = 0
        val kept = self.ctx.hir_modules.len()
        print "[go-to-end] HIR: {failed.len()} module(s) failed, {blocked.len()} dependent(s) excluded; continuing with {kept} module(s)"
        stdout_flush()
        kept > 0

    fn native_staged_codegen_eligible_reason_v1() -> text:
        """Human-readable refusal reason; empty when eligible. Staging is
        admitted only where aot_compile is known to end in the per-module
        compile_to_native lane with nothing re-reading the whole MIR set
        afterwards. Every other dispatch keeps the unstaged order."""
        val backend_name = self.ctx.options.backend
        if backend_name == "c" or backend_name == "cpp" or backend_name == "ccodegen" or
                backend_name == "cuda" or backend_name == "ptx" or
                backend_name == "opencl" or backend_name == "opencl-c" or
                backend_name == "opencl-spirv" or backend_name == "cl" or
                backend_name == "vulkan" or backend_name == "spirv" or
                backend_name == "vhdl" or backend_name == "wasm" or backend_name == "wasm32":
            return "non-native backend {backend_name}"
        if (env_get_opt("SIMPLE_BOOTSTRAP_DIRECT_IR") ?? "") == "1":
            return "SIMPLE_BOOTSTRAP_DIRECT_IR=1"
        # Bootstrap-flat skips the MIR pass chain and may dispatch to the
        # fixed-entry context compiler, which reads the entry MIR itself.
        if (env_get_opt("SIMPLE_BOOTSTRAP") ?? "") == "1" and
                (env_get_opt("SIMPLE_BOOTSTRAP_WHOLE_PROGRAM") ?? "") == "1" and
                (env_get_opt("SIMPLE_BOOTSTRAP_STAGE4") ?? "") != "1":
            return "bootstrap-flat lane (SIMPLE_BOOTSTRAP=1 without STAGE4)"
        # SMF / self-contained / both re-iterate ctx.mir_modules after codegen.
        val format = self.ctx.options.output_format
        if driver_output_format_is_smf(format) or driver_output_format_is_self_contained(format) or
                driver_output_format_is_both(format):
            return "output format re-reads MIR set"
        if (env_get_opt("SIMPLE_PACKAGE_INDEX_FULL_INVENTORY") ?? "") == "1" or
                self.ctx.runtime_std_full_inventory_selection != nil:
            return "full inventory selection active"
        # Demand routes reuse archived MIR and publish SCC ownership per run.
        if self.ctx.demand_compile_execution != nil or self.ctx.demand_dirty_modules.len() > 0:
            return "demand compile lane"
        if native_group_request_path_v1() != "":
            return "native group request lane"
        match native_output_intent_decode_v1(env_get_opt("SIMPLE_NATIVE_BUILD_EMIT_OBJECT") ?? ""):
            case Ok(intent):
                if intent == NativeOutputIntentV1.EntryObject:
                    return "entry-object emit lane"
            case Err(_):
                return "invalid SIMPLE_NATIVE_BUILD_EMIT_OBJECT"
        ""

    fn native_staged_codegen_eligible_v1() -> bool:
        self.native_staged_codegen_eligible_reason_v1() == ""

    me native_staged_codegen_flush_v1(lowering_failed: bool) -> bool:
        """Run the MIR modules currently held in ctx.mir_modules (one full
        batch) through the same per-module chain aot_compile applies --
        mir_verify, borrow_check, optimize_mir, weave_aop, debug_trace --
        emit their objects into the native cache via compile_to_native in
        flushing mode, then release their MIR. Gates keep the unstaged
        order: nothing is verified after a lowering failure, nothing is
        borrow-checked after a verify failure, and no object is emitted once
        any error is recorded (the batch is still released; the build fails).
        Returns false only for a whole-build failure (cache/session setup)."""
        var batch_names: [text] = []
        for held_name in self.ctx.mir_modules.keys():
            batch_names = batch_names.push(held_name)
        if lowering_failed:
            self.native_staged_codegen.lowering_failed = true
        val batch_index = self.native_staged_codegen.batches_flushed + 1
        log_phase("aot:staged_codegen:batch:start index={batch_index} modules={batch_names.len()}")
        val go_to_end = go_to_end_enabled_v1()
        # go-to-end: the lowering loop recorded each failed module's errors
        # against its name and kept its MIR out of ctx.mir_modules
        # (go_to_end_record_mir_failure_v1), but the context still holds the
        # error text. Absorb it (has_message skips what is already recorded)
        # or the `error_count_value == 0` gates below would withhold every
        # object of a batch that merely CONTAINS a failed module.
        if go_to_end and self.ctx.error_count_value > 0:
            self.go_to_end_absorb_errors_v1("mir")
        if not self.native_staged_codegen.lowering_failed:
            if not self.verify_lowered_mir_v1():
                self.native_staged_codegen.verify_failed = true
                if go_to_end:
                    self.go_to_end_withhold_staged_batch_v1(batch_names, batch_index)
        if not self.native_staged_codegen.lowering_failed and
                not self.native_staged_codegen.verify_failed:
            if not self.borrow_check():
                self.native_staged_codegen.borrow_failed = true
        # `verify_failed` is part of both gates: under go-to-end the verify
        # errors were absorbed above, so the error count alone no longer
        # proves the batch is valid.
        if self.ctx.error_count_value == 0 and not self.native_staged_codegen.lowering_failed and
                not self.native_staged_codegen.verify_failed:
            val _async_state_machines = self.process_async()
            if (env_get_opt("SIMPLE_BOOTSTRAP_SKIP_MIR_OPT") ?? "") != "1":
                self.optimize_mir_level(self.ctx.options.opt_level ?? 0)
            self.weave_aop()
            self.apply_debug_trace()
        if self.ctx.error_count_value == 0 and not self.native_staged_codegen.lowering_failed and
                not self.native_staged_codegen.verify_failed:
            if self.ctx.freeze_storage_registry_for_schedule(
                    self.native_staged_codegen.scheduled_names) == "invalid":
                self.ctx.add_error("staged native codegen: typed storage registry is malformed before batch {batch_index}")
                return false
            val output = self.ctx.options.output_file ?? _driver_default_output(self.ctx.options.input_files)
            self.native_staged_codegen.flushing = true
            val batch_result = self.compile_to_native(output)
            self.native_staged_codegen.flushing = false
            if not batch_result.is_success():
                val batch_error = match batch_result:
                    case CompileResult.CodegenError(message): message
                    case _: "staged native codegen batch {batch_index} failed"
                self.ctx.add_error(batch_error)
                return false
        for released_name in batch_names:
            self.ctx.evict_mir_module(released_name)
        if go_to_end:
            # The verify verdict is per batch under go-to-end (the batch was
            # recorded and withheld above); a later batch must not inherit it.
            self.native_staged_codegen.verify_failed = false
        self.native_staged_codegen.batches_flushed = batch_index
        log_build_progress("native_staged", "modules",
            self.native_staged_codegen.modules_flushed,
            self.native_staged_codegen.scheduled_names.len(),
            "batch-{batch_index}", 5, 6, 0,
            self.native_staged_codegen.cache_hit_count, "running")
        log_phase("aot:staged_codegen:batch:done index={batch_index} released={batch_names.len()}")
        true

    me go_to_end_withhold_staged_batch_v1(batch_names: [text], batch_index: i64):
        """go-to-end after a MIR verify failure inside a staged batch. The
        verifier reports fatal findings through ctx.add_error without a
        per-module channel, so the granularity here is the BATCH: every module
        of the batch is recorded (stage mir) and excluded, the verify errors
        become `(unattributed)` rows, and nothing of this batch reaches a
        backend (RB-19A: invalid MIR never reaches codegen). Later batches
        still lower and emit; the build still fails with the manifest."""
        self.go_to_end_absorb_errors_v1("mir")
        for withheld_name in batch_names:
            self.go_to_end.record("mir", withheld_name,
                "withheld: MIR verify failed in staged batch {batch_index} (see the unattributed rows)")
            self.go_to_end.exclude(withheld_name)
        print "[go-to-end] MIR verify: staged batch {batch_index} withheld ({batch_names.len()} module(s)); continuing with the next batch"
        stdout_flush()

    fn native_mir_shard_eligible_v1() -> bool:
        """Shards publish per-module objects only; lanes whose final step needs
        more than object paths (cold-HIR object persistence, collection
        receipts) or that wipe the shared cache scope stay unsharded."""
        val selective = driver_mir_selective_enabled_v1()
        val lane_ok = if selective:
            driver_mir_selective_explicit_native_eligible_v1(self)
        else:
            self.native_staged_codegen_eligible_v1()
        val no_budget = self.ctx.options.collection_memory_budget_bytes < 0
        val not_clean = (env_get_opt("SIMPLE_NATIVE_BUILD_CLEAN") ?? "") != "1"
        val eligible = lane_ok and no_budget and not_clean
        if not eligible:
            val lane_reason = if selective: "selective-explicit-native"
                else: self.native_staged_codegen_eligible_reason_v1()
            print "[mir-shard] eligibility refused lane_ok={lane_ok} lane_reason='{lane_reason}' selective={selective} receipts={self.ctx.cold_hir_typed_receipts.len()} budget_bytes={self.ctx.options.collection_memory_budget_bytes} clean_lane={not not_clean}"
            stdout_flush()
        eligible

    me aot_compile_mir_shard_v1() -> CompileResult:
        """MIR shard worker: lower only the modules this worker claims, run
        the per-module post-lowering chain, emit their objects into the shared
        native cache, and record one terminal per claimed module. Any claimed
        module without a PASS is sealed FAILED, so the coordinator blocks the
        link; this process then exits and returns all of its memory."""
        print "[mir-shard] worker source entry queue={env_get_opt(\"SIMPLE_MIR_SHARD_QUEUE\") ?? \"\"}"
        stdout_flush()
        val queue = native_mir_shard_queue_v1()
        val root_owner = native_mir_shard_owner_v1()
        if queue == "":
            return CompileResult.CodegenError("MIR shard worker has no ledger ({NATIVE_MIR_SHARD_QUEUE_ENV_V1} unset)")
        if not self.native_mir_shard_eligible_v1():
            val _blocked = hir_shard_recovery_block(queue, "MIR sharding is unsupported for this build lane")
            val _sealed = hir_shard_recovery_seal(queue, root_owner, "FAILED")
            val _completed = hir_shard_recovery_complete(queue, root_owner)
            return CompileResult.CodegenError("MIR sharding is unsupported for this build lane")
        # EXPERIMENTAL SIMPLE_MIR_FORK_WORKERS=N (driver_build/native_mir_fork_v1.spl):
        # arm the fork for this worker's lower_to_mir. The fork itself happens
        # inside lower_to_mir_with_target_context right before the per-module
        # claim loop, after the shared MIR setup and the ledger inventory
        # publication, so the root runs that setup once and N copy-on-write
        # children inherit it. A child returns from the fork with its own spec
        # and owner installed and continues as an ordinary shard worker; the
        # root only reaps, seals, re-forks and exits there. Never for selective.
        if not driver_mir_selective_enabled_v1():
            native_mir_fork_arm_v1(queue, root_owner)
        # Cold-HIR receipts stay: the worker records capsule identities for the
        # modules it claims and publishes them in the ledger; only the link child
        # persists (driver_cold_hir_persist is skipped while shard_queue is set).
        var shard_state = NativeStagedCodegenStateV1.begin(0)
        shard_state.active = true
        shard_state.shard_queue = queue
        self.native_staged_codegen = shard_state
        log_phase("aot:mir_shard:start owner={root_owner}")
        # Export summaries (opt-in): admission only. Lowering still reads the
        # full post-mono HIR; a refusal is reported and changes nothing.
        if native_mir_shard_export_enabled_v1() and not driver_mir_selective_enabled_v1():
            val export_admitted = driver_mir_shard_export_admit_v1(self)
            if export_admitted.is_ok():
                print "[mir-shard] export summaries admitted owner={root_owner} records={export_admitted.unwrap()} lowering=full-hir"
            else:
                print "[mir-shard] export summaries refused owner={root_owner} fallback=full-hir reason={export_admitted.unwrap_err()}"
        var codegen_ok = false
        var module_functions: {text: i64} = {}
        var module_statics: {text: i64} = {}
        var shard_borrow_failed = false
        val shard_lowered = if driver_mir_selective_enabled_v1():
            self.lower_selective_to_mir_v1()
        else:
            self.lower_to_mir()
        # A forked child installed its own owner inside lower_to_mir; read it
        # only now so the seal/complete below are the child's, never the root's.
        val owner = native_mir_shard_owner_v1()
        # File-worker receipts: MIR-done is observable only here (lowering and
        # object emission share this child); the worker copies the stamp.
        if shard_lowered and (env_get_opt("SIMPLE_FILE_WORKER_HIR_QUEUE") ?? "") != "":
            val _mir_done = native_file_worker_mir_done_publish_v1(queue, owner, time_now_monotonic_ms())
        if native_mir_fork_disarm_v1():
            # The fork point (the claim loop) was never reached: an early
            # return or a lowering failure. Nothing forked; this process stays
            # the ordinary 0/1 worker it was spawned as.
            print "[mir-fork] fork point not reached owner={owner} lowered={shard_lowered}; no child forked"
            stdout_flush()
        val skip_post_chain = driver_mir_selective_enabled_v1() and driver_mir_selective_skip_post_chain_v1()
        if shard_lowered and not skip_post_chain and not self.borrow_check():
            shard_borrow_failed = true
        if shard_lowered and not shard_borrow_failed:
            if not skip_post_chain:
                val _async_state_machines = self.process_async()
                if (env_get_opt("SIMPLE_BOOTSTRAP_SKIP_MIR_OPT") ?? "") != "1":
                    self.optimize_mir_level(self.ctx.options.opt_level ?? 0)
                self.weave_aop()
                self.apply_debug_trace()
            else:
                log_phase("aot:flat_mir_passes:skipped")
                log_bootstrap_flat_warning("aot:flat_mir_passes:skipped")
            if self.ctx.error_count_value == 0:
                for held_name in self.ctx.mir_modules.keys():
                    module_functions[held_name] = self.ctx.mir_modules[held_name].functions.keys().len()
                    module_statics[held_name] = self.ctx.mir_modules[held_name].statics.keys().len()
                if self.ctx.freeze_storage_registry_for_schedule(
                        self.native_staged_codegen.scheduled_names) == "invalid":
                    self.ctx.add_error("MIR shard: typed storage registry is malformed")
                else:
                    val output = self.ctx.options.output_file ?? _driver_default_output(self.ctx.options.input_files)
                    self.native_staged_codegen.flushing = true
                    val shard_result = self.compile_to_native(output)
                    self.native_staged_codegen.flushing = false
                    if shard_result.is_success():
                        codegen_ok = true
                    else:
                        val shard_error = match shard_result:
                            case CompileResult.CodegenError(message): message
                            case _: "MIR shard codegen failed"
                        self.ctx.add_error(shard_error)
        var passed = 0
        val claimed = self.native_staged_codegen.shard_claimed_names
        if codegen_ok:
            for name in claimed:
                var outcome_label = ""
                for outcome in self.native_staged_codegen.module_outcomes.records:
                    if outcome.source_path == name:
                        outcome_label = outcome.label()
                val has_object = self.native_staged_codegen.module_objects.contains_key(name)
                # No outcome at all is compile_to_native's objectless facade
                # route; an OK outcome must carry its object.
                val object_path = if outcome_label == "OK" and has_object:
                    self.native_staged_codegen.module_objects[name]
                else:
                    ""
                # A go-to-end MIR failure has no outcome and no object, the
                # same shape as an objectless facade: the ledger is the only
                # thing that tells them apart. Left unchecked it published
                # PASS and the coordinator never counted it (run-27e).
                val go_to_end_failed = go_to_end_enabled_v1() and self.go_to_end.is_excluded(name)
                if go_to_end_failed:
                    print "[mir-shard] go-to-end failed module={name} owner={owner}: sealed FAILED, not published"
                val module_passed = native_mir_shard_module_passed_v1(outcome_label, has_object, go_to_end_failed)
                val functions = if module_functions.contains_key(name): module_functions[name] else: 0
                val statics = if module_statics.contains_key(name): module_statics[name] else: 0
                val capsule_identity = if self.ctx.cold_hir_native_capsule_identities.has(name): self.ctx.cold_hir_native_capsule_identities[name] else: ""
                if module_passed and native_mir_shard_publish_pass_v1(queue, name, object_path,
                        functions, statics, capsule_identity):
                    passed = passed + 1
        val sealed = hir_shard_recovery_seal(queue, owner, "FAILED")
        val completed = hir_shard_recovery_complete(queue, owner)
        for err in self.ctx.errors:
            log_error("MIR shard error: {err}")
        print "[mir-shard] done owner={owner} claimed={claimed.len()} passed={passed} sealed_failed={sealed} borrow_failed={shard_borrow_failed}"
        val shard_failed = passed != claimed.len() or sealed != 0 or not completed or
            self.ctx.error_count_value != 0
        if shard_failed:
            val ice_summary = ice_boundary_finalize()
            if ice_summary != "":
                log_error(ice_summary)
        # Like the HIR shard child: everything after this point (verdict,
        # link, output publication) is the final worker's job, and exiting
        # here is what returns this worker's MIR to the OS.
        native_mir_fork_exit_v1(if shard_failed: 1 else: 0)
        CompileResult.Success(None)

    me aot_write_mir_shard_exports_v1() -> CompileResult:
        """Post-mono export producer: publish declaration summaries, or the
        selected complete-body/declaration bundle, then exit before MIR."""
        val written = if driver_mir_selective_enabled_v1():
            driver_mir_selective_write_v1(self, native_mir_shard_export_write_dir_v1())
        else:
            driver_mir_shard_export_write_v1(self)
        if written.is_err():
            log_error("MIR shard export: {written.unwrap_err()}")
            print "[mir-shard-export] FAIL reason={written.unwrap_err()}"
        else:
            print "[mir-shard-export] PASS modules={written.unwrap()} dir={native_mir_shard_export_write_dir_v1()}"
        stdout_flush()
        exit(if written.is_err(): 1 else: 0)
        CompileResult.Success(None)

    me aot_link_mir_shards_v1() -> CompileResult:
        """Final MIR-shard step: lower nothing, admit the sealed ledger's PASS
        objects (all-or-nothing, bound to this build's source fingerprint),
        and run the ordinary compile_to_native verdict + link over them."""
        if not self.native_mir_shard_eligible_v1():
            return CompileResult.CodegenError("MIR shard link is unsupported for this build lane")
        val admitted = if driver_mir_selective_enabled_v1():
            driver_mir_selective_admit_link_v1(self, native_mir_shard_link_ledger_v1())
        else:
            native_mir_shard_link_inputs_v1(native_mir_shard_link_ledger_v1(), self.ctx.native_sources_fingerprint)
        if admitted.is_err():
            return CompileResult.CodegenError(admitted.unwrap_err())
        val inputs = admitted.unwrap()
        var link_state = NativeStagedCodegenStateV1.begin(0)
        link_state.active = true
        link_state.object_files = inputs.object_files
        link_state.modules_flushed = inputs.modules.len()
        link_state.lane_functions = inputs.functions
        link_state.lane_statics = inputs.statics
        link_state.lane_objectless = inputs.objectless
        var outcome_unit = 0
        for object_module in inputs.object_modules:
            outcome_unit = outcome_unit + 1
            link_state.module_outcomes.record(BuildUnitOutcome.ok(outcome_unit, object_module, 0, 0))
        link_state.module_unit_id = outcome_unit
        # Replay the workers' verified objects into the cold-HIR receipt maps so the
        # ordinary persistence step publishes the package index for sharded builds.
        var replay_index = 0
        for replay_module in inputs.object_modules:
            val replay_reason = driver_cold_hir_record_verified_object_v1(
                self.ctx, replay_module, inputs.object_files[replay_index],
                inputs.capsule_identities[replay_index])
            if replay_reason != "":
                return CompileResult.CodegenError(replay_reason)
            replay_index = replay_index + 1
        for objectless_module in inputs.objectless_modules:
            val objectless_reason = driver_cold_hir_record_objectless_v1(self.ctx, objectless_module)
            if objectless_reason != "":
                return CompileResult.CodegenError(objectless_reason)
        self.native_staged_codegen = link_state
        print "[mir-shard] link modules={inputs.modules.len()} objects={inputs.object_files.len()} objectless={inputs.objectless}"
        val output = self.ctx.options.output_file ?? _driver_default_output(self.ctx.options.input_files)
        self.compile_to_native(output)
use compiler.common.diagnostics.span.{Span}
