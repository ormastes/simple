# Pure route decision shared by the driver and small native regressions.
# Explicit streaming requests are independent of SIMPLE_BOOTSTRAP: ordinary
# native-build entries need the same per-file parser ownership boundary.
pub fn driver_streaming_surface_requested_values(stage3: text, stage4: text,
    stage4_streaming: text) -> bool:
    stage3 == "1" or (stage4 == "1" and stage4_streaming == "1")

# Entry authority precedes closure discovery. CLI routes publish the request
# while the completion latch is still false so phase 1 can discover imports.
pub fn driver_streaming_entry_ready_values(entry_request: text,
    closure_ready: bool) -> bool:
    entry_request != "" or closure_ready

# 0 = ordinary route, 1 = streaming route. Negative values reject an explicit
# request before source loading; they must never select retain-all parsing.
pub fn driver_streaming_surface_route_values(requested: bool, aot: bool,
    entry_ready: bool, coverage: bool, mcdc_off: bool, vhdl: bool) -> i64:
    if not requested: return 0
    if not aot: return -1
    if not entry_ready: return -2
    if coverage: return -3
    if not mcdc_off: return -4
    if vhdl: return -5
    1

pub fn driver_streaming_surface_rejection(route: i64) -> text:
    # Negative literal match arms hit B5b in producer 908; tracked in
    # negative_integer_match_arms_native_2026-09-30.md.
    if route == -1: return "E-DRV-STREAM-AOT: explicit streaming requires AOT mode"
    if route == -2: return "E-DRV-STREAM-ENTRY: explicit streaming requires an entry closure"
    if route == -3: return "E-DRV-STREAM-COVERAGE: explicit streaming cannot retain coverage inventory"
    if route == -4: return "E-DRV-STREAM-MCDC: explicit streaming requires MC/DC off"
    if route == -5: return "E-DRV-STREAM-BACKEND: explicit streaming does not support VHDL"
    ""
