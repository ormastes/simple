# Coarse, stable compiler-driver provider contract.
#
# Only fixed-width scalars cross this boundary. Compiler-private options,
# source sets, diagnostics, AST, HIR, and MIR remain owned by the in-process
# adapter and are addressed through generation-local numeric handles.

use std.nogc_sync_mut.composition.provider_contract.{
    SimpleProviderQueryV1, SimpleProviderQueryResultV1,
    simple_provider_query_error_v1,
    SIMPLE_PROVIDER_OK, SIMPLE_PROVIDER_INTERFACE_UNKNOWN,
    SIMPLE_PROVIDER_MAJOR_UNSUPPORTED, SIMPLE_PROVIDER_MINOR_UNSUPPORTED,
    SIMPLE_PROVIDER_DESCRIPTOR_TOO_SHORT, SIMPLE_PROVIDER_QUERY_V1_SIZE
}

val SIMPLE_COMPILER_DRIVER_V1_INTERFACE: u64 = 6000009050290832461
val SIMPLE_COMPILER_DRIVER_V1_MAJOR: u32 = 1
val SIMPLE_COMPILER_DRIVER_V1_MINOR: u32 = 0
val SIMPLE_COMPILER_DRIVER_V1_DESCRIPTOR_SIZE: u32 = 32
val SIMPLE_COMPILER_DRIVER_V1_ABI_DIGEST: u64 = 6000009050290832461
val SIMPLE_COMPILER_DRIVER_V1_PROVIDER_IDENTITY: u64 = 6000009050290832462

val SIMPLE_COMPILER_PROVIDER_OK: i32 = 0
val SIMPLE_COMPILER_PROVIDER_INVALID_SESSION: i32 = 1
val SIMPLE_COMPILER_PROVIDER_INVALID_REQUEST: i32 = 2
val SIMPLE_COMPILER_PROVIDER_INVALID_RESULT: i32 = 3
val SIMPLE_COMPILER_PROVIDER_REQUEST_ALREADY_RUN: i32 = 4
val SIMPLE_COMPILER_PROVIDER_SESSION_BUSY: i32 = 5
val SIMPLE_COMPILER_PROVIDER_COMPILE_FAILED: i32 = 6

struct SimpleCompilerDriverV1:
    descriptor_size: u32
    interface_major: u32
    interface_minor: u32
    create_session_operation: u32
    create_request_operation: u32
    run_request_operation: u32
    inspect_result_operation: u32
    release_operation: u32

struct SimpleCompilerHandleResultV1:
    status: i32
    handle: u64

struct SimpleCompilerResultSummaryV1:
    status: i32
    compile_status: i32
    diagnostic_count: u32

fn simple_compiler_driver_descriptor_v1() -> SimpleCompilerDriverV1:
    SimpleCompilerDriverV1(
        descriptor_size: SIMPLE_COMPILER_DRIVER_V1_DESCRIPTOR_SIZE,
        interface_major: SIMPLE_COMPILER_DRIVER_V1_MAJOR,
        interface_minor: SIMPLE_COMPILER_DRIVER_V1_MINOR,
        create_session_operation: 1,
        create_request_operation: 2,
        run_request_operation: 3,
        inspect_result_operation: 4,
        release_operation: 5
    )

fn simple_compiler_driver_query_v1(request: SimpleProviderQueryV1) -> SimpleProviderQueryResultV1:
    if request.interface_id != SIMPLE_COMPILER_DRIVER_V1_INTERFACE:
        return simple_provider_query_error_v1(SIMPLE_PROVIDER_INTERFACE_UNKNOWN)
    if request.minimum_major != SIMPLE_COMPILER_DRIVER_V1_MAJOR:
        return simple_provider_query_error_v1(SIMPLE_PROVIDER_MAJOR_UNSUPPORTED)
    if request.minimum_minor > SIMPLE_COMPILER_DRIVER_V1_MINOR:
        return simple_provider_query_error_v1(SIMPLE_PROVIDER_MINOR_UNSUPPORTED)
    if request.descriptor_size < SIMPLE_PROVIDER_QUERY_V1_SIZE:
        return simple_provider_query_error_v1(SIMPLE_PROVIDER_DESCRIPTOR_TOO_SHORT)
    SimpleProviderQueryResultV1(
        status: SIMPLE_PROVIDER_OK,
        provided_major: SIMPLE_COMPILER_DRIVER_V1_MAJOR,
        provided_minor: SIMPLE_COMPILER_DRIVER_V1_MINOR,
        descriptor_size: SIMPLE_COMPILER_DRIVER_V1_DESCRIPTOR_SIZE,
        interface_handle: 1,
        provider_context: 1,
        provider_identity_digest: SIMPLE_COMPILER_DRIVER_V1_PROVIDER_IDENTITY,
        # The in-process adapter is not an admitted artifact generation. Its
        # build owner supplies a real implementation digest when dynamic
        # activation exists; zero prevents this discovery result from being
        # mistaken for locked artifact evidence.
        implementation_digest: 0,
        abi_digest: SIMPLE_COMPILER_DRIVER_V1_ABI_DIGEST
    )
