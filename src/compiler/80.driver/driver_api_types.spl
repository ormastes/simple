use std.io_runtime.{env_get_nullable, file_exists}
# Driver API Types [Tier 0] - Extern declarations and lightweight helpers.
#
# Dependency rules:
#   - NO compiler graph imports (no HIR, MIR, backend, linker, etc.)
#   - May import only driver_core_types for CompileResult / CompileOptions
#   - All higher tiers may import from this file
#
# Contains: the tier-local runtime-discovery facade helpers,
# find_runtime_lib_dir, and the _combine_driver_api_process_error helper.

@always_inline
fn _driver_api_runtime_file_exists_raw(path: text) -> bool:
    unsafe(capabilities: [ffi]):
        file_exists(path)

@always_inline
fn _driver_api_runtime_env_raw(name: text) -> text?:
    env_get_nullable(name)

pub fn find_runtime_lib_dir() -> text:
    val env_path = _driver_api_runtime_env_raw("SIMPLE_RUNTIME_PATH")
    if env_path != nil and env_path != "":
        return env_path

    val candidates = [
        "src/compiler_rust/target/bootstrap",
        "src/compiler_rust/target/debug",
        "src/compiler_rust/target/release",
        "rust/target/bootstrap",
        "rust/target/debug",
        "rust/target/release"
    ]

    for dir in candidates:
        if _driver_api_runtime_file_exists_raw("{dir}/libsimple_compiler.so"):
            return dir
        if _driver_api_runtime_file_exists_raw("{dir}/libsimple_compiler.dylib"):
            return dir
        if _driver_api_runtime_file_exists_raw("{dir}/simple_compiler.dll"):
            return dir

    "src/compiler_rust/target/bootstrap"

pub fn _combine_driver_api_process_error(prefix: text, stdout: text, stderr: text) -> text:
    var detail = stderr.trim()
    if detail == "":
        detail = stdout.trim()
    if detail == "":
        return prefix
    prefix + ": " + detail
