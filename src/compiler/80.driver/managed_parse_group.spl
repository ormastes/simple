# Serialized parser owner. Flat parser globals never cross a worker boundary;
# only the real captured flat payload and canonical result records do.
use compiler.driver.driver_build.managed_parse_group_contract.*
use compiler.driver.driver_build.managed_parse_group_result.*
use compiler.frontend.flat_ast_bridge.{flat_pool_capture_arm, flat_pool_capture_take, flat_pool_capture_already_captured, flat_pool_capture_record, parse_and_build_module_scoped, build_module_from_flat_pool_blob}
use compiler.core.parser.{parser_has_errors, parser_get_errors, parser_first_error_get}
use compiler.frontend.core.cfg_platform.{cfg_detect_os, cfg_detect_arch, cfg_detect_cpu}
use compiler.frontend.core.flat_pool_codec.{FLAT_POOL_CODEC_VERSION}
use compiler.frontend.frontend_shared_parse_cas_v1.{frontend_shared_parse_feature_identity_v1}
use compiler.frontend.frontend.{frontend_prepare_preprocessed_source_v1}
use compiler.frontend.frontend_advisory_preprocess_port_v1.{FrontendAdvisoryPreprocessPolicyV1}
use compiler.frontend.frontend_target_cfg_receipt_v1.{frontend_cfg_decision_digest_v1}
use compiler.core.parser_preprocessor.{_pp_preprocess_conditionals_target_receipted_v1}
use compiler.frontend.desugar.desugar_async.{desugar_module}
use compiler.common.diagnostics.diagnostic_v1.{DiagnosticV1, render_diagnostic_v1_json}
use compiler.common.diagnostics.severity.{Severity}
use std.common.crypto.sha256.{sha256_text}
use std.common.encoding.utf8.{text_byte_len}
use std.nogc_sync_mut.io.file_ops.{file_read_regular_no_follow_bounded, file_atomic_write, file_exists}
use std.nogc_sync_mut.io.dir_ops.{dir_create}
use std.nogc_sync_mut.io.env_ops.{env_get}

struct ManagedParseGroupOwnerV1:
    root: text
    snapshot: ManagedParseSnapshotV1
    feature_identity: text
    source_bytes: i64

struct ManagedParseGroupActionTransferV1:
    owner: ManagedParseGroupOwnerV1
    result: ManagedParseActionResultV1

fn managed_parse_group_feature_identity_v1() -> text:
    sha256_text(frontend_shared_parse_feature_identity_v1() + "\n" + env_get("SIMPLE_CAPTURE_WRITE_CHECK"))

fn managed_parse_group_target_v1(snapshot: ManagedParseSnapshotV1) -> bool:
    snapshot.target_os == cfg_detect_os() and snapshot.target_arch == cfg_detect_arch() and
        snapshot.target_cpu == cfg_detect_cpu()

fn managed_parse_group_source_v1(root: text, snapshot: ManagedParseSnapshotV1,
    module: ManagedParseModuleV1) -> Result<text, text>:
    val source = file_read_regular_no_follow_bounded(root + "/sources/" + module.source_path, snapshot.max_source_bytes)?
    if sha256_text(source) != module.source_digest: return Err("source bytes differ from admitted snapshot")
    Ok(source)

fn managed_parse_group_install_v1(root: text, snapshot: ManagedParseSnapshotV1) -> Result<ManagedParseGroupOwnerV1, text>:
    val invalid = managed_parse_snapshot_validate_v1(snapshot)
    if invalid != "": return Err(invalid)
    # Successful warning parses deliberately suppress flat capture. The V1
    # result requires an artifact, so refuse this unsupported mode at admission
    # rather than misreport a successful warning as a source parse failure.
    if env_get("SIMPLE_CAPTURE_WRITE_CHECK") == "warning":
        return Err("managed parser V1 does not support noncacheable warning results")
    if root == "" or root.contains("\0"): return Err("invalid parser owner root")
    if not managed_parse_group_target_v1(snapshot): return Err("parser target differs from admitted snapshot")
    var source_bytes: i64 = 0
    for module in snapshot.modules:
        val source = managed_parse_group_source_v1(root, snapshot, module)?
        source_bytes = source_bytes + text_byte_len(source)
        if source_bytes > snapshot.max_source_bytes: return Err("installed source inventory exceeds byte bound")
    for directory in ["artifacts", "cache", "requests", "receipts"]:
        if not dir_create(root + "/" + directory, true): return Err("cannot create parser owner directory")
    Ok(ManagedParseGroupOwnerV1(root, snapshot, managed_parse_group_feature_identity_v1(), source_bytes))

fn managed_parse_group_diagnostic_v1(module: ManagedParseModuleV1, code: text, detail: text) -> text:
    # Stable across parent/worker roots and attempts; preserve the parser's
    # exact located text rather than inventing a byte span from a message.
    val identity = sha256_text(managed_parse_fields_v1([code, module.source_path, module.source_digest, detail]))
    val diagnostic = DiagnosticV1(Severity.Error, code, detail, Some(module.source_path), None,
        [], ["diagnostic-id:" + identity], [], [], [], None)
    render_diagnostic_v1_json(diagnostic)

fn managed_parse_group_error_v1(module: ManagedParseModuleV1, code: text, detail: text) -> ManagedParseModuleResultV1:
    ManagedParseModuleResultV1(module.module_id, module.source_digest, "ERROR", "", "",
        [managed_parse_group_diagnostic_v1(module, code, detail)], false)

fn managed_parse_group_errors_v1(module: ManagedParseModuleV1) -> ManagedParseModuleResultV1:
    var diagnostics: [text] = []
    for detail in parser_get_errors():
        diagnostics = diagnostics.push(managed_parse_group_diagnostic_v1(module, "E-PARSE", detail))
    if diagnostics.len() == 0:
        val detail = parser_first_error_get()
        return managed_parse_group_error_v1(module, "E-PARSE", if detail == "": "parser reported failure without a diagnostic receipt" else: detail)
    ManagedParseModuleResultV1(module.module_id, module.source_digest, "ERROR", "", "", diagnostics, false)

fn managed_parse_group_authority_v1(owner: ManagedParseGroupOwnerV1, module: ManagedParseModuleV1,
    parse_source: text, decision_digest: text) -> text:
    # CACHE-2 key binds module/source/worker/target/cache compatibility, not the
    # request's batch snapshot. Feature and codec authority are independently
    # retained so a parent may copy only a validated compatible sidecar.
    "SIMPLE-MANAGED-REFERENCE-PARSE-CACHE-AUTHORITY-1\n" + managed_parse_fields_v1([
        managed_parse_module_cache_key_v1(owner.snapshot, module), FLAT_POOL_CODEC_VERSION,
        sha256_text(managed_parse_fields_v1([owner.feature_identity, sha256_text(parse_source), decision_digest]))])

fn managed_parse_group_module_v1(owner: ManagedParseGroupOwnerV1, module: ManagedParseModuleV1) -> ManagedParseModuleResultV1:
    # Hash the admitted input once, then prepare and parse these captured
    # bytes; no pathname re-open is delegated to the parser.
    val source = match managed_parse_group_source_v1(owner.root, owner.snapshot, module):
        Ok(value): value
        Err(reason): return managed_parse_group_error_v1(module, "E-PARSE-SOURCE", reason)
    # Use the canonical explicit-target evaluator. Its CPU predicate follows
    # its documented architecture alias; no ambient host decision is used.
    val selected = match _pp_preprocess_conditionals_target_receipted_v1(
            source, owner.snapshot.target_os, owner.snapshot.target_arch):
        Ok(value): value
        Err(reason): return managed_parse_group_error_v1(module, "E-PARSE-POLICY", reason)
    val prepared = match frontend_prepare_preprocessed_source_v1(selected.source,
            FrontendAdvisoryPreprocessPolicyV1.Reference, 0u64, 0u64, 0u64):
        Ok(value): value
        Err(_reason): return managed_parse_group_error_v1(module, "E-PARSE-POLICY", "reference frontend preparation unavailable")
    val parse_source = prepared[0]
    val domain_blocks = prepared[1]
    val key = managed_parse_module_cache_key_v1(owner.snapshot, module)
    val path = owner.root + "/cache/" + key + ".sdn"
    val authority_path = owner.root + "/cache/" + key + ".authority"
    val authority = managed_parse_group_authority_v1(owner, module, parse_source,
        frontend_cfg_decision_digest_v1(selected.decisions))
    if file_exists(path) and file_exists(authority_path):
        val retained_authority = match file_read_regular_no_follow_bounded(authority_path, 1024):
            Ok(value): value
            Err(reason): return managed_parse_group_error_v1(module, "E-PARSE-CACHE-IO", reason)
        if retained_authority == authority:
            val payload = match file_read_regular_no_follow_bounded(path, 65536):
                Ok(value): value
                Err(reason): return managed_parse_group_error_v1(module, "E-PARSE-CACHE-IO", reason)
            match managed_parse_module_result_decode_v1(payload):
                Ok(retained):
                    if retained.status == "OK" and retained.module_id == module.module_id and
                            retained.source_digest == module.source_digest:
                        val blob = match file_read_regular_no_follow_bounded(owner.root + "/" + retained.blob_path, 134217728):
                            Ok(value): value
                            Err(reason): return managed_parse_group_error_v1(module, "E-PARSE-CACHE-IO", reason)
                        if sha256_text(blob) == retained.blob_digest:
                            match build_module_from_flat_pool_blob(blob, parse_source, module.source_path):
                                Some(restored):
                                    if parser_has_errors(): return managed_parse_group_errors_v1(module)
                                    var restored_module = restored
                                    if domain_blocks.len() > 0: restored_module.domain_blocks = domain_blocks
                                    val _completed = desugar_module(restored_module)
                                    return ManagedParseModuleResultV1(module.module_id, module.source_digest,
                                        "OK", retained.blob_path, retained.blob_digest, [], true)
                                _: ()
                Err(_invalid): ()
    # Explicit invalid/mismatched cache authority or decode is a miss. An I/O
    # failure or parser-reported policy error above is not hidden by a reparse.
    # Capture at most once per path per process: a repeat dump of an identical
    # module re-exposes the transient-scope reclaim poison window (lane-48b
    # trace and doc stage2_mir_shard_flat_pool_text_len_minus1_2026-10-22.md).
    val _already_captured = flat_pool_capture_already_captured(module.source_path)
    if not _already_captured:
        flat_pool_capture_arm()
    var parsed = parse_and_build_module_scoped(parse_source, module.source_path, false)
    val blob = if _already_captured:
        ""
    else:
        flat_pool_capture_take()
    if not _already_captured:
        flat_pool_capture_record(module.source_path)
    if parser_has_errors(): return managed_parse_group_errors_v1(module)
    if domain_blocks.len() > 0: parsed.domain_blocks = domain_blocks
    val _completed = desugar_module(parsed)
    if blob == "" or text_byte_len(blob) > 134217728:
        return managed_parse_group_error_v1(module, "E-PARSE-CAPTURE", "parser did not produce a bounded cacheable flat artifact")
    val digest = sha256_text(blob)
    val relative = "artifacts/" + digest + ".flat"
    val result = ManagedParseModuleResultV1(module.module_id, module.source_digest, "OK", relative, digest, [], false)
    val encoded = managed_parse_module_result_encode_v1(result)
    if encoded == "" or not file_atomic_write(owner.root + "/" + relative, blob) or
            not file_atomic_write(path, encoded) or not file_atomic_write(authority_path, authority):
        return managed_parse_group_error_v1(module, "E-PARSE-CACHE-IO", "cannot persist captured parser artifact and authority")
    result

fn managed_parse_group_action_owned_v1(owner: ManagedParseGroupOwnerV1,
    action: ManagedParseActionV1) -> ManagedParseGroupActionTransferV1:
    val invalid = managed_parse_action_validate_v1(owner.snapshot, action)
    if invalid != "": return ManagedParseGroupActionTransferV1(owner, ManagedParseActionResultV1(action, [], invalid))
    var modules: [ManagedParseModuleResultV1] = []
    var failed = false
    val policy_valid = managed_parse_group_target_v1(owner.snapshot) and
        managed_parse_group_feature_identity_v1() == owner.feature_identity and
        env_get("SIMPLE_CAPTURE_WRITE_CHECK") != "warning"
    for module in owner.snapshot.modules:
        if not action.package_members.contains(module.package_id): continue
        val result = if not policy_valid:
            managed_parse_group_error_v1(module, "E-PARSE-POLICY", "parser target or feature policy changed after install")
        elif failed and not action.keep_going:
            managed_parse_group_error_v1(module, "E-PARSE-SKIPPED", "prior module failed and keep-going is disabled")
        else:
            managed_parse_group_module_v1(owner, module)
        modules = modules.push(result)
        if result.status == "ERROR": failed = true
    ManagedParseGroupActionTransferV1(owner,
        ManagedParseActionResultV1(action, modules, if failed: "one or more parser modules failed" else: ""))

export ManagedParseGroupOwnerV1, ManagedParseGroupActionTransferV1
export managed_parse_group_install_v1, managed_parse_group_action_owned_v1
