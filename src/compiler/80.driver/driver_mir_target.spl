# Driver-owned MIR target context derivation.
#
# The driver is the single boundary that may read build state. MIR lowering
# receives the resulting immutable context and never reads environment values
# or probes backend tools itself.

use compiler.common.driver_core_types.{CompileOptions}
use compiler.common.mir_target_context.{MirTargetContext, mir_target_context_from, mir_target_context_uses_host}
use compiler.common.driver_compile_options.{compileoptions_effective_mir_opt_level}
use compiler.backend.backend_helpers.{get_effective_backend_name}
use compiler.backend.mir_target_context_provider.{backend_mir_target_context}

fn driver_mir_target_context(options: CompileOptions) -> MirTargetContext:
    val effective_backend = get_effective_backend_name(options.backend, options.release)
    val host = backend_mir_target_context(effective_backend)
    driver_mir_target_context_from_host(options, host, effective_backend)

fn driver_mir_target_context_from_host(options: CompileOptions, host: MirTargetContext, effective_backend: text) -> MirTargetContext:
    var target = mir_target_context_from(options.native_target, host.arch, host.os, effective_backend, host.version)
    if mir_target_context_uses_host(options.native_target.trim().lower()):
        target = host
    driver_collection_target_options(target, options)

fn driver_collection_target_options(target: MirTargetContext, options: CompileOptions) -> MirTargetContext:
    var configured = target
    configured.build_profile = if options.release: "release" else: "debug"
    configured.collection_policy = options.collection_policy
    configured.collection_memory_budget_bytes = options.collection_memory_budget_bytes
    configured.collection_opt_level = compileoptions_effective_mir_opt_level(options)
    configured.collection_trace_active = options.debug_trace_level != ""
    configured

export driver_mir_target_context, driver_mir_target_context_from_host, driver_collection_target_options
