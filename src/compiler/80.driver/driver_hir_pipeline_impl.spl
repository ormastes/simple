# Compiler Driver - HIR lowering, method resolution, type checking, and monomorphization
#
# Extracted from driver.spl. This module owns the complete HIR/type-check block.

use compiler.driver.driver_compiler_type.{CompilerDriver}
use compiler.driver.driver_types.{CompileContext}
use compiler.common.driver_core_types.{SourceFile}
use compiler.hir.hir.*
use compiler.hir.hir_lowering.types.{HirLowering, hirlowering_for_module, hirlowering_for_module_with_diagnostics, LoweringError, LoweringErrorKind}
use compiler.hir.hir_lowering.module_surface.{ModuleSurface, ModuleSurfacesByName, module_surface_source_matches, module_surfaces_from_modules}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.core.lexer.{lexer_release_parse_source_globals}
use compiler.core.ast.{ast_reset}
use compiler.core.parser.{par_had_error_get}
use compiler.frontend.parser_types.*
use compiler.driver.driver_source_pipeline_impl.{dtrace, driver_end_transient_parse_scope}
use compiler.driver.driver_source_loading.{_driver_is_bootstrap_entry_source, _format_type_infer_error}
use compiler.driver.driver_bootstrap.{bootstrap_entry_module_name}
use compiler.driver.driver_orchestration.{driver_streaming_surface_enabled}
use compiler.driver.driver_log_helpers.{log_debug, log_trace, log_warn, log_error, log_phase}
use compiler.semantics.const_fold.{run_const_fold_pass}
use compiler.semantics.resolve.{resolve_methods}
use compiler.types.type_system.effect_pass.{run_effect_pass}
use compiler.semantics.value_struct_layout.{validate_value_struct_layouts}
use compiler.mono.monomorphize_integration.*
use compiler.driver.driver_safety_severity.{SafetyPassSeverity, safety_pass_severity}
use compiler.types.type_infer_types.{HmInferContext}
use compiler.semantics.visibility_integration.{check_module_visibility}
use compiler.semantics.safety_checker.{SafetyChecker, SafetyError, safetychecker_check_module, safetychecker_check_transfer_module}
use std.nogc_sync_mut.io.process_ops.{eprint}

extern fn rt_env_get(key: text) -> text
extern fn rt_transient_array_scope_begin() -> bool
extern fn rt_transient_array_scope_pause() -> bool
extern fn rt_transient_heap_promote(value: Any) -> bool

fn _format_hir_lowering_error(name: text, err: LoweringError) -> text:
    if err.span.file != "":
        "HIR lowering error in {name} ({err.span.file}:{err.span.line}:{err.span.col}): {err.message}"
    else:
        "HIR lowering error in {name}: {err.message}"

fn _driver_collect_hir_errors(ctx: CompileContext, name: text, errors: [LoweringError]):
    for err in errors:
        if err.kind == LoweringErrorKind.Recovered:
            ctx.add_warning(_format_hir_lowering_error(name, err))
        else:
            ctx.add_error(_format_hir_lowering_error(name, err))

fn _driver_validate_value_struct_layouts(ctx: CompileContext):
    for error in validate_value_struct_layouts(ctx.hir_modules):
        ctx.add_error(error)

impl CompilerDriver:
    me lower_streaming_surface_source(lowering: HirLowering, source: SourceFile) -> Result<HirModule, text>:
        if not rt_transient_array_scope_begin():
            return Err("transient parser scope unavailable for {source.path}")
        val module = parse_full_frontend(source.content, source.path, source.module_name, self.ctx.logger)
        if par_had_error_get():
            val _ended = driver_end_transient_parse_scope()
            return Err("parse error in {source.path} (see [parser_error] output above)")
        if not rt_transient_array_scope_pause():
            val _ended = driver_end_transient_parse_scope()
            return Err("transient parser scope pause failed for {source.path}")
        val hir_module = lowering.lower_parser_module_unstub(module)
        if not rt_transient_heap_promote(hir_module):
            val _ended = driver_end_transient_parse_scope()
            return Err("HIR ownership promotion failed for {source.path}")
        if not rt_transient_heap_promote(lowering.errors):
            val _ended = driver_end_transient_parse_scope()
            return Err("HIR diagnostic ownership promotion failed for {source.path}")
        if not driver_end_transient_parse_scope():
            return Err("transient parser scope end failed for {source.path}")
        Ok(hir_module)

    me lower_and_check_streaming_surfaces_impl() -> (CompileContext, bool):
        if not self.ctx.module_surfaces.?:
            self.ctx.add_error("Streaming module surfaces missing after phase 2")
            return (self.ctx, false)
        val surfaces = self.ctx.module_surfaces.unwrap()
        var lowering: HirLowering = hirlowering_for_module("", surfaces)
        var lowered_by_surface: Dict<i64, HirModule> = {}
        var phase_hir_modules: Dict<text, HirModule> = self.ctx.hir_modules
        var phase_entry_hir: HirModule? = self.ctx.bootstrap_entry_hir
        var source_index = 0

        while source_index < self.ctx.sources.len():
            val source = self.ctx.sources[source_index]
            if not surfaces.index_by_name.contains_key(source.module_name):
                self.ctx.add_error("Missing module surface alias for {source.module_name}")
                return (self.ctx, false)
            val surface_index = surfaces.index_by_name[source.module_name]
            val is_requested_bootstrap_entry = _driver_is_bootstrap_entry_source(source.path, source.module_name) or source.module_name == bootstrap_entry_module_name(self.ctx)

            if lowered_by_surface.contains_key(surface_index):
                val alias_hir = lowered_by_surface[surface_index]
                phase_hir_modules[source.module_name] = alias_hir
                if is_requested_bootstrap_entry:
                    phase_entry_hir = Some(alias_hir)
                source_index = source_index + 1
                continue
            if surface_index < 0 or surface_index >= surfaces.surfaces.len():
                self.ctx.add_error("Invalid module surface index for {source.module_name}: {surface_index}")
                return (self.ctx, false)
            val surface: ModuleSurface = surfaces.surfaces[surface_index]
            if not module_surface_source_matches(surface, source, source_index):
                self.ctx.add_error("Module surface/source fingerprint mismatch for {source.path}")
                return (self.ctx, false)

            lowering.begin_module(source.path)
            log_phase("phase3:hir:file:start {source.path} module={source.module_name}")
            val lower_result = self.lower_streaming_surface_source(lowering, source)
            if lower_result.is_err():
                self.ctx.add_error("Streaming HIR lowering error: {lower_result.unwrap_err()}")
                return (self.ctx, false)
            val hir_module = lower_result.unwrap()
            _driver_collect_hir_errors(self.ctx, source.module_name, lowering.errors)
            if self.ctx.errors.len() > 0:
                return (self.ctx, false)
            lowered_by_surface[surface_index] = hir_module
            phase_hir_modules[source.module_name] = hir_module
            if is_requested_bootstrap_entry:
                phase_entry_hir = Some(hir_module)
            log_phase("phase3:hir:file:done {source.path} module={source.module_name} funcs={hir_module.functions.len()}")
            source_index = source_index + 1

        var phase_ctx: CompileContext = self.ctx
        phase_ctx.hir_modules = phase_hir_modules
        phase_ctx.bootstrap_entry_hir = phase_entry_hir
        _driver_validate_value_struct_layouts(phase_ctx)
        if phase_ctx.errors.len() > 0:
            return (phase_ctx, false)
        ast_reset()
        phase_ctx.modules = {}
        lexer_release_parse_source_globals()
        val reclaimed_sources = phase_ctx.reclaim_source_contents()
        log_phase("phase3:streaming_source_reclaim:done reclaimed={reclaimed_sources}")
        phase_ctx.evict_sources()
        phase_ctx.module_surfaces = nil
        (phase_ctx, true)

    me lower_and_check_impl() -> (CompileContext, bool):
        if driver_streaming_surface_enabled(self.ctx):
            return self.lower_and_check_streaming_surfaces_impl()
        val log = self.ctx.logger

        # Build module_name -> source_path map so each module gets the right
        # filename in module_filename (required for defining_module + visibility).
        var source_path_map: Dict<text, text> = {}
        var map_src_idx = 0
        while map_src_idx < self.ctx.sources.len():
            val src = self.ctx.sources[map_src_idx]
            source_path_map[src.module_name] = src.path
            map_src_idx = map_src_idx + 1

        log_debug("lowering modules to HIR")
        dtrace("[DRV] lac-entry sources.len={self.ctx.sources.len()} modules.len={self.ctx.modules.keys().len()}")
        # Shared trait registry (task #55): each module gets a FRESH HirLowering
        # instance, but lowered_traits must survive across modules so an impl
        # module lowered AFTER its trait's defining module can still see the
        # trait's default methods (lower_impl in trait_impl_lowering.spl reads
        # self.lowered_traits). Seed each new lowering from the accumulated
        # registry and fold its result back in after lowering completes.
        var shared_lowered_traits: Dict<text, HirTrait> = {}
        # Allocate the diagnostics array before the long HIR loop and reuse its
        # registered handle for every module. In the no-GC bootstrap runtime,
        # creating a fresh array near the terminal module can fail registry
        # growth under peak AST+HIR pressure and leave `errors` invalid.
        var shared_lowering_errors: [LoweringError] = []
        var shared_lowering_diagnostic_messages: [text] = []
        var shared_lowering_diagnostic_recovered: [bool] = []
        val retained_module_surfaces: ModuleSurfacesByName = if self.ctx.sources.len() > 0:
            match module_surfaces_from_modules(self.ctx.modules, self.ctx.sources):
                case Ok(value): value
                case Err(error):
                    self.ctx.add_error("Module surface extraction error: {error}")
                    return (self.ctx, false)
        else:
            ModuleSurfacesByName(surfaces: [], index_by_name: {})
        if self.ctx.sources.len() <= 0:
            dtrace("[DRV] lac-branch=modules-loop (sources<=0)")
            var bootstrap_hir_modules: Dict<text, HirModule> = {}
            val bootstrap_entry_name = bootstrap_entry_module_name(self.ctx)
            for module in self.ctx.modules.values():
                val name = module.name
                log_trace("processing module")
                if module == nil:
                    log_error("module is nil")
                    continue
                var lowering: HirLowering = hirlowering_for_module("", retained_module_surfaces)
                lowering.lowered_traits = shared_lowered_traits
                val hir_module: HirModule = lowering.lower_module(module)
                shared_lowered_traits = lowering.lowered_traits
                _driver_collect_hir_errors(self.ctx, name, lowering.errors)
                val (resolved_module, resolve_errors) = resolve_methods(hir_module)
                var err_idx = 0
                while err_idx < resolve_errors.len():
                    val err = resolve_errors[err_idx]
                    self.ctx.add_error("Method resolution error in {name}: {err.message}")
                    err_idx = err_idx + 1
                val folded_module = run_const_fold_pass(resolved_module)
                bootstrap_hir_modules[name] = folded_module
            log_debug("running effect inference pass...")
            val (updated_hir_boot, effect_warnings_boot) = run_effect_pass(bootstrap_hir_modules)
            var bootstrap_ctx: CompileContext = self.ctx
            bootstrap_ctx.hir_modules = updated_hir_boot
            val bootstrap_entry_module = updated_hir_boot[bootstrap_entry_name]
            if bootstrap_entry_module != nil:
                bootstrap_ctx.bootstrap_entry_hir = Some(bootstrap_entry_module)
            log_debug("effect inference done")
            log_debug("HIR lowering complete")
            _driver_validate_value_struct_layouts(bootstrap_ctx)
            return (bootstrap_ctx, bootstrap_ctx.errors.len() == 0)
        var phase_hir_modules: Dict<text, HirModule> = self.ctx.hir_modules
        var phase_entry_source_index = -1
        var source_idx = 0
        while source_idx < self.ctx.sources.len():
            val src = self.ctx.sources[source_idx]
            val name = src.module_name
            log_phase("phase3:hir:file:start {src.path} module={name}")
            log_trace("processing module")

            # Set per-module filename so Symbol.defining_module is populated
            # correctly and effective_visibility() matches against the right file.
            val src_path = source_path_map[name]
            # TYPED local required: an untyped `var lowering = ...` is ANY-erased
            # on the stage4 binary, so method calls on it (lower_module /
            # lower_parser_module_unstub) mis-dispatch and the HIR lowering body
            # never runs (iteration 17; same family as the iteration 9 Dict-ANY
            # field hazard).
            var lowering: HirLowering = hirlowering_for_module_with_diagnostics(src_path ?? "", retained_module_surfaces, shared_lowering_errors, shared_lowering_diagnostic_messages, shared_lowering_diagnostic_recovered)
            if src_path != nil:
                lowering.module_filename = src_path
            lowering.lowered_traits = shared_lowered_traits

            # Step 1: Lower to HIR
            # Real single-file HIR lowering is the default; SIMPLE_STUB_HIR=1 is the
            # escape hatch forcing the empty-HIR stub (pre-2026-07-03 behavior) if a
            # stage4 lowering regression ever needs to be bypassed in the field.
            val unstub_hir = (rt_env_get("SIMPLE_STUB_HIR") ?? "") != "1"
            val native_entry_closure_hir = (rt_env_get("SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE") ?? "") == "1"
            val is_requested_bootstrap_entry = _driver_is_bootstrap_entry_source(src.path, name) or name == bootstrap_entry_module_name(self.ctx)
            val is_bootstrap_entry = native_entry_closure_hir or is_requested_bootstrap_entry
            dtrace("[DRV] lac-loop name={name} content_len={src.content.len()}")
            val hir_module: HirModule = if is_bootstrap_entry:
                dtrace("[DRV] branch=bootstrap_entry")
                val entry_module_for_hir = self.ctx.modules[name]
                if entry_module_for_hir != nil:
                    lowering.lower_parser_module_unstub(entry_module_for_hir)
                else:
                    val reparsed_entry_module = parse_full_frontend(src.content, src.path, name, self.ctx.logger)
                    lowering.lower_parser_module_unstub(reparsed_entry_module)
            elif unstub_hir and (src.content != "") and (not self.ctx.options.low_memory):
                # Opt-in real lowering via a fresh frontend re-parse (see caveat above).
                # MUST call the uniquely-named lower_parser_module_unstub: a plain
                # `lowering.lower_module(...)` mis-dispatches on the stage4 binary
                # (same-name sibling on MirLowering; iteration 17) and the real
                # HIR lowering body never runs.
                dtrace("[DRV] branch=unstub_reparse")
                val entry_module_for_hir = parse_full_frontend(src.content, src.path, name, self.ctx.logger)
                val lowered_hm: HirModule = lowering.lower_parser_module_unstub(entry_module_for_hir)
                dtrace("[DRV] lowered funcs={lowered_hm.functions.len()} name={lowered_hm.name}")
                lowered_hm
            elif unstub_hir and (self.ctx.modules[name] != nil):
                # Opt-in real lowering, low_memory fallback (source evicted).
                lowering.lower_parser_module_unstub(self.ctx.modules[name])
            else:
                # Empty-HIR stub: forced via SIMPLE_STUB_HIR=1, or fallback when the
                # phase-2 module was evicted/unavailable (re-parse would be unsafe).
                dtrace("[DRV] branch=STUB (empty HIR)")
                HirModule(
                    name: name,
                    path: src.path,
                    imports: [],
                    exports: [],
                    domain_blocks: [],
                    symbols: lowering.symbols,
                    functions: {},
                    classes: {},
                    structs: {},
                    enums: {},
                    bitfields: {},
                    traits: {},
                    impls: [],
                    constants: {},
                    static_asserts: [],
                    aop_advices: [],
                    di_bindings: [],
                    arch_rules: [],
                    mock_decls: [],
                    types: []
                )
            val focused_future_driver_diag = src.path == "src/lib/nogc_async_mut/async/future.spl"
            if focused_future_driver_diag:
                eprint("[driver-hir] returned future")
            log_trace("HIR lowered")
            if focused_future_driver_diag:
                eprint("[driver-hir] trace done")
            # Keep the aggregate LoweringError array inside HirLowering. The
            # owner methods return only scalar/text projections, avoiding the
            # stage4 array-of-struct transport failure under closure pressure.
            val module_error_count: i64 = lowering.lowering_error_count()
            var module_error_idx = 0
            while module_error_idx < module_error_count:
                val module_error_message: text = lowering.lowering_error_message_at(module_error_idx, name)
                val module_error_recovered: bool = lowering.lowering_error_is_recovered_at(module_error_idx)
                if module_error_recovered:
                    self.ctx.add_warning(module_error_message)
                else:
                    self.ctx.add_error(module_error_message)
                module_error_idx = module_error_idx + 1
            shared_lowering_errors.clear()
            shared_lowering_diagnostic_messages.clear()
            shared_lowering_diagnostic_recovered.clear()
            if focused_future_driver_diag:
                eprint("[driver-hir] errors done")

            # Fold this module's newly-lowered traits back into the shared
            # registry so later modules (which get their own fresh HirLowering
            # instance) can still resolve cross-module trait default methods.
            shared_lowered_traits = lowering.lowered_traits

            phase_hir_modules[name] = hir_module
            if focused_future_driver_diag:
                eprint("[driver-hir] stored")
            if is_requested_bootstrap_entry:
                phase_entry_source_index = source_idx
            val hir_function_count: i64 = hir_module.functions.len()
            if focused_future_driver_diag:
                eprint("[driver-hir] functions={hir_function_count}")
            log_phase("phase3:hir:file:done {src.path} module={name} funcs={hir_function_count}")
            log_trace("stored HIR module")
            source_idx = source_idx + 1

        # Step 3b: Trait coherence checking (Check mode only)
        # Trait coherence errors (orphan rules, overlapping impls, blanket conflicts)
        # are surfaced through the trait solver in the HmInferContext above.
        # A full cross-module coherence pass via CoherenceChecker requires
        # HirType formatting which is not yet available; trait solver errors
        # cover the primary use cases for now.

        # Step 2d: Effect inference pass is skipped in bootstrap empty-HIR mode.
        log_debug("effect inference done")

        log_debug("HIR lowering complete")

        val phase_entry_hir: HirModule? = if phase_entry_source_index >= 0:
            val entry_source = self.ctx.sources[phase_entry_source_index]
            phase_hir_modules[entry_source.module_name]
        else:
            self.ctx.bootstrap_entry_hir
        var phase_ctx: CompileContext = self.ctx
        phase_ctx.hir_modules = phase_hir_modules
        phase_ctx.bootstrap_entry_hir = phase_entry_hir
        _driver_validate_value_struct_layouts(phase_ctx)

        # Phase 3 (opt-in, warn-only): HM type inference + visibility diagnostics.
        # The 30.types inference engine (HmInferContext.infer_module) and the
        # 35.semantics visibility checker (check_module_visibility) are fully
        # implemented but were never wired into the pipeline — deep-recheck
        # 2026-07-05: type_check_impl no-op (this file ~613),
        # resolve_methods_with_solver stub (resolve.spl ~712),
        # check_module_visibility had zero callers. They have never run over the
        # full ~993-module set, so their true diagnostic count is unknown and
        # enabling them fatal would very likely break the build. This pass is
        # gated behind SIMPLE_TYPECHECK_WARN=1 and only LOGS warnings (it never
        # pushes ctx.errors), so the default build is unaffected. Flip the flag
        # once the stage4 wall permits a verified non-crashing build to measure
        # the real blast — see doc/03_plan/compiler/type_system/typecheck_burndown.md
        if (rt_env_get("SIMPLE_TYPECHECK_WARN") ?? "") == "1":
            val tc_warnings = run_typecheck_warn_pass(phase_hir_modules)
            log_warn("typecheck warn-only pass: {tc_warnings.len()} diagnostic(s)")
            var tcw_idx = 0
            while tcw_idx < tc_warnings.len():
                log_warn(tc_warnings[tcw_idx])
                tcw_idx = tcw_idx + 1

        # Phase 3 (opt-in, warn-only): unsafe-context safety pass.
        # SafetyChecker.check_module (35.semantics/safety_checker.spl) is fully
        # implemented for one rule (inline asm outside `unsafe:`) but was never
        # wired into the pipeline — see
        # doc/08_tracking/bug/safety_checker_pass_never_invoked_2026-07-27.md.
        # At least 23 owned files (kernel boot/trap/context-switch/syscall, etc.)
        # use inline asm with no `unsafe:` block at all, so enabling this fatally
        # would break the SimpleOS build immediately (see
        # doc/09_report/unsafe_enforcement_port_plan_2026-07-27.md). Following the
        # SIMPLE_TYPECHECK_WARN convention above, this pass is gated behind
        # SIMPLE_SAFETY_WARN=1 and only LOGS warnings (it never pushes to
        # ctx.errors), so the default build is unaffected.
        # Since 2026-07-28 (lane SE1) the pass is PROFILE-GATED, not only
        # log-opt-in: SIMPLE_SAFETY_PROFILE=robust routes each diagnostic to
        # ctx.add_warning (visible, never fails the build -- the migration
        # window); =critical routes to ctx.add_error and fails the build.
        # Default (unset) stays Advisory: log-only under SIMPLE_SAFETY_WARN=1,
        # exactly the pre-SE1 behavior, so no existing build changes.
        val safety_enforcing = match safety_pass_severity():
            case SafetyPassSeverity.Advisory: false
            case _: true
        if ((rt_env_get("SIMPLE_SAFETY_WARN") ?? "") == "1") or safety_enforcing:
            val safety_warnings = run_safety_warn_pass(phase_ctx, phase_hir_modules)
            log_warn("safety warn-only pass: {safety_warnings.len()} diagnostic(s)")
            var sw_idx = 0
            while sw_idx < safety_warnings.len():
                log_warn(safety_warnings[sw_idx])
                sw_idx = sw_idx + 1

        (phase_ctx, phase_ctx.errors.len() == 0)

    # --------------------------------------------------------------------------
    # Phase 3a: Lower to HIR (standalone, kept for compatibility)
    # --------------------------------------------------------------------------

    fn lower_to_hir_impl() -> (CompileContext, bool):
        var ctx = self.ctx
        val retained_module_surfaces: ModuleSurfacesByName = match module_surfaces_from_modules(ctx.modules, ctx.sources):
            case Ok(value): value
            case Err(error):
                ctx.add_error("Module surface extraction error: {error}")
                return (ctx, false)

        # Build module_name -> source_path map for per-module filename tracking.
        var source_path_map2: Dict<text, text> = {}
        for src in ctx.sources:
            source_path_map2[src.module_name] = src.path

        for src2 in ctx.sources:
            val name = src2.module_name
            val module = ctx.modules[name]
            val src_path2 = source_path_map2[name]
            var lowering: HirLowering = hirlowering_for_module(src_path2 ?? "", retained_module_surfaces)
            if src_path2 != nil:
                lowering.module_filename = src_path2
            val hir_module: HirModule = lowering.lower_module(module)
            _driver_collect_hir_errors(ctx, name, lowering.errors)
            ctx.hir_modules[name] = hir_module
        (ctx, ctx.errors.len() == 0)

    # --------------------------------------------------------------------------
    # Phase 3b: Method Resolution (standalone, kept for compatibility)
    # --------------------------------------------------------------------------

    fn resolve_methods_impl() -> (CompileContext, bool):
        var ctx = self.ctx

        for name in ctx.hir_modules.keys():
            val hir_module = ctx.hir_modules[name]
            val (resolved_module, resolve_errors) = resolve_methods(hir_module)

            # Update the module with resolved method calls (direct mutation)
            ctx.hir_modules[name] = resolved_module

            # Collect errors
            for err in resolve_errors:
                ctx.errors.push("Method resolution error in {name}: {err.message}")

        (ctx, ctx.errors.len() == 0)

    # --------------------------------------------------------------------------
    # Phase 3c: Type Checking (standalone, kept for compatibility)
    # --------------------------------------------------------------------------

    fn type_check_impl() -> (CompileContext, bool):
        var ctx = self.ctx
        # Type inference runs inside lower_and_check_impl() for Check mode.
        # This standalone method is kept for API compatibility but is a no-op.
        (ctx, ctx.errors.len() == 0)

    # --------------------------------------------------------------------------
    # Phase 4: Monomorphization
    # --------------------------------------------------------------------------

    me monomorphize_impl() -> bool:
        """Run monomorphization pass on all HIR modules.

        This creates specialized versions of generic functions, structs, and
        classes by substituting concrete type arguments. Call sites are
        rewritten to use the mangled names of specialized definitions.
        """
        log_debug("running monomorphization")
        val skip_mono = rt_env_get("SIMPLE_BOOTSTRAP_SKIP_MONO") ?? ""
        if skip_mono == "1":
            print "[bootstrap] skipping monomorphization"
            return self.ctx.errors.len() == 0
        val (mono_modules, mono_stats) = run_monomorphization(self.ctx.hir_modules)
        # BUG-001 diagnostic: verify module count survives monomorphization
        log_debug("monomorphization output ready")
        self.ctx.hir_modules = mono_modules
        log_debug("monomorphization done")
        self.ctx.errors.len() == 0

    # --------------------------------------------------------------------------
# Warn-only passes are owned here with the HIR pipeline.
pub fn run_typecheck_warn_pass(hir_modules: Dict<text, HirModule>) -> [text]:
    var out: [text] = []
    for name in hir_modules.keys():
        val m = hir_modules[name]
        # Type inference diagnostics (unification / occurs-check / mismatch).
        var ictx = HmInferContext.with_builtins()
        ictx.infer_module(m)
        var e_idx = 0
        while e_idx < ictx.errors.len():
            out = out.push("[typecheck] {name}: " + _format_type_infer_error(ictx.errors[e_idx]))
            e_idx = e_idx + 1
        # Visibility diagnostics (cross-module private/friend/package access).
        val vwarnings = check_module_visibility(m, name)
        var v_idx = 0
        while v_idx < vwarnings.len():
            val vw = vwarnings[v_idx]
            out = out.push("[visibility {vw.code}] {name}: {vw.message}")
            v_idx = v_idx + 1
    out

# Warn-only, opt-in unsafe-context safety pass.
#
# Runs the fully-implemented but previously-unwired SafetyChecker
# (compiler.semantics.safety_checker) over every lowered HIR module and returns
# its diagnostics as formatted text (the caller still logs that list exactly
# as before) and, since lane SE1, ALSO routes each diagnostic into ctx at the
# profile-gated severity -- Advisory: log-only; robust: warning; critical:
# build-failing error. Invoked when SIMPLE_SAFETY_WARN=1 or when the resolved
# severity is enforcing. SafetyChecker currently
# implements exactly one rule (inline asm outside `unsafe:`); the declared
# RawPointerOutsideUnsafe / UnsafeFfiOutsideUnsafe variants are never
# constructed and InlineAsmMatch has no dedicated case, so this pass only
# surfaces plain InlineAsm violations today. See
# doc/08_tracking/bug/safety_checker_pass_never_invoked_2026-07-27.md.
pub fn run_safety_warn_pass(ctx: CompileContext, hir_modules: Dict<text, HirModule>) -> [text]:
    # Lane SE1 (2026-07-28): in addition to returning the formatted list for
    # the existing log path (unchanged), each diagnostic is ALSO routed into
    # `ctx` at the severity SIMPLE_SAFETY_PROFILE resolves to: Advisory
    # touches nothing, Warn calls ctx.add_warning, Deny calls ctx.add_error
    # and therefore fails the build. CompileContext is a class (reference
    # semantics, driver_types.spl:34), so these mutations persist.
    val severity = safety_pass_severity()
    var out: [text] = []
    for name in hir_modules.keys():
        val m = hir_modules[name]
        val checker = SafetyChecker.create()
        val serrors = safetychecker_check_module(checker, m)
        # Use the same checker so the transfer walk sees class symbols collected
        # by the primary module check.
        val transfer_errors = safetychecker_check_transfer_module(checker, m)
        var s_idx = 0
        while s_idx < serrors.len():
            match serrors[s_idx]:
                case InlineAsmOutsideUnsafe(span):
                    val msg = "[safety inline-asm-outside-unsafe] {name}: inline asm used outside an `unsafe:` block at {span.line}:{span.col}"
                    out = out.push(msg)
                    match severity:
                        case SafetyPassSeverity.Advisory:
                            val _ = 0
                        case SafetyPassSeverity.Warn:
                            ctx.add_warning(msg)
                        case SafetyPassSeverity.Deny:
                            ctx.add_error(msg)
                case UnsafeFfiOutsideUnsafe(span):
                    val msg = "[safety unsafe-ffi-outside-unsafe] {name}: unsafe FFI call used outside an `unsafe:` block at {span.line}:{span.col}"
                    out = out.push(msg)
                    match severity:
                        case SafetyPassSeverity.Advisory:
                            val _ = 0
                        case SafetyPassSeverity.Warn:
                            ctx.add_warning(msg)
                        case SafetyPassSeverity.Deny:
                            ctx.add_error(msg)
                case RawPointerOutsideUnsafe(span):
                    val msg = "[safety raw-pointer-outside-unsafe] {name}: raw pointer operation used outside an `unsafe:` block at {span.line}:{span.col}"
                    out = out.push(msg)
                    match severity:
                        case SafetyPassSeverity.Advisory:
                            val _ = 0
                        case SafetyPassSeverity.Warn:
                            ctx.add_warning(msg)
                        case SafetyPassSeverity.Deny:
                            ctx.add_error(msg)
                case Other(message, span):
                    val msg = "[safety other] {name}: {message} at {span.line}:{span.col}"
                    out = out.push(msg)
                    match severity:
                        case SafetyPassSeverity.Advisory:
                            val _ = 0
                        case SafetyPassSeverity.Warn:
                            ctx.add_warning(msg)
                        case SafetyPassSeverity.Deny:
                            ctx.add_error(msg)
            s_idx = s_idx + 1
        var t_idx = 0
        while t_idx < transfer_errors.len():
            match transfer_errors[t_idx]:
                case Other(message, span):
                    val msg = "[safety other] {name}: {message} at {span.line}:{span.col}"
                    out = out.push(msg)
                    match severity:
                        case SafetyPassSeverity.Advisory:
                            val _ = 0
                        case SafetyPassSeverity.Warn:
                            ctx.add_warning(msg)
                        case SafetyPassSeverity.Deny:
                            ctx.add_error(msg)
                case _:
                    pass
            t_idx = t_idx + 1
    out
