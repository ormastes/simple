# Unit derived-op profile wiring (RB6, decision 4A follow-up).
#
# unit_ops.spl owns SPL-UNIT-004 (unit*unit / unit/unit without a declared
# derived unit) but only exposes a strict/default switch and a warning list.
# This file connects both to the driver:
#   - strict mode is chosen by the SPL-UNIT-004 row of
#     config/policy/diagnostic_policy.sdn for the active profile (no profile
#     names are hardcoded here: a `deny` baseline means strict);
#   - the active language edition (simple.sdn project: edition, via
#     resolve_edition) also promotes it once edition >= the row's
#     error_since_lang_version (owner decision 5C, plan §7);
#   - default-mode warnings are drained into typecheck diagnostics.

use compiler.common.assurance.policy_names.normalize_profile_name
use compiler.common.diagnostics.diagnostic_rule_policy.{
    DiagnosticPolicySnapshot, DiagnosticRuleLevel, PolicyResolveContext,
    load_diagnostic_policy_text, diagnostic_policy_default_path
}
use std.test_runner.test_runner_config.{resolve_edition_from_sdn}
use compiler.types.units.unit_ops.{unit_op_robust_profile, unit_op_default_profile, unit_op_take_warnings, unit_op_set_mixed_strict}
use std.nogc_sync_mut.io.file_ops.{file_read, file_exists}
use std.nogc_sync_mut.io.env_ops.{cwd}

val UNIT_PROFILE_RULE: text = "SPL-UNIT-004"
# Undeclared product/quotient of two different units: a security-category
# error in compiled code regardless of profile/edition; a warning only in
# script mode (owner decision 2026-11-17, Q1=b). Not policy-driven.
val UNIT_MIXED_RULE: text = "SPL-UNIT-002"

# Loaded at most once per process (a missing/malformed file is remembered too).
var _UNIT_POLICY_LOADED = false
var _UNIT_POLICY: [DiagnosticPolicySnapshot] = []
# Fail-closed notices (policy unavailable under an assured profile), drained
# with the SPL-UNIT-004 warnings.
var _UNIT_PROFILE_NOTICES: [text] = []

fn _unit_policy_parent(dir: text) -> text:
    val trimmed = if dir.len() > 1 and dir.ends_with("/"): dir.substring(0, dir.byte_len() - 1) else: dir
    val slash = trimmed.last_index_of("/") ?? -1
    if slash < 0:
        return ""
    if slash == 0:
        return "/"
    trimmed.substring(0, slash)

# Nearest ancestor of start_dir (inclusive) holding the policy file; "" if none.
# The relative default is cwd-only, so a build run from a subdirectory of the
# repo used to see no policy at all (Fable #9845).
pub fn unit_profile_policy_path_from(start_dir: text) -> text:
    val rel = diagnostic_policy_default_path()
    var dir = start_dir.replace("\\", "/")
    while dir != "":
        val sep = if dir.ends_with("/"): "" else: "/"
        val candidate = dir + sep + rel
        if file_exists(candidate):
            return candidate
        if dir == "/":
            return ""
        val parent = _unit_policy_parent(dir)
        if parent == dir:
            return ""
        dir = parent
    ""

# Assured profiles that must never silently fall back to warning mode.
fn _unit_profile_requires_strict(raw_profile: text) -> bool:
    val mode = normalize_profile_name(raw_profile)
    mode == "robust" or mode == "critical" or mode == "verified"

pub fn unit_profile_policy() -> DiagnosticPolicySnapshot?:
    if not _UNIT_POLICY_LOADED:
        _UNIT_POLICY_LOADED = true
        val path = unit_profile_policy_path_from(cwd())
        if path != "":
            match load_diagnostic_policy_text(file_read(path)):
                case Ok(snapshot): _UNIT_POLICY.push(snapshot)
                case Err(_): pass
    if _UNIT_POLICY.len() == 0:
        return None
    Some(_UNIT_POLICY[0])

# Unknown/empty profile resolves to the policy's `default` column.
# @allow(primitive_api) yes/no strict-mode predicate mirroring unit_ops' own bool switch; no domain type applies
pub fn unit_profile_strict_for(policy: DiagnosticPolicySnapshot?, raw_profile: text) -> bool:
    match policy:
        # Fail closed: no policy must not downgrade an assured profile (#9965).
        case None: _unit_profile_requires_strict(raw_profile)
        case Some(snapshot):
            val slot = snapshot.slot_of(UNIT_PROFILE_RULE)
            if slot < 0:
                return false
            var mode = normalize_profile_name(raw_profile)
            if mode == "":
                mode = "default"
            snapshot.baseline_level(slot, mode).rank() >= DiagnosticRuleLevel.Deny.rank()

# Profile baseline OR edition promotion (resolve() stage "edition"). The
# profile check stays separate: resolve() alone returns Allow at stage
# "schedule" for an edition below warn_since_lang_version.
# @allow(primitive_api) yes/no strict-mode predicate mirroring unit_ops' own bool switch; no domain type applies
pub fn unit_profile_strict_for_edition(policy: DiagnosticPolicySnapshot?, raw_profile: text, edition: text) -> bool:
    if unit_profile_strict_for(policy, raw_profile):
        return true
    match policy:
        case None: false
        case Some(snapshot):
            if snapshot.slot_of(UNIT_PROFILE_RULE) < 0:
                return false
            var mode = normalize_profile_name(raw_profile)
            if mode == "":
                mode = "default"
            val ctx = PolicyResolveContext.new(mode, edition, "")
            val r = snapshot.resolve(UNIT_PROFILE_RULE, ctx, DiagnosticRuleLevel.Warn)
            r.level.rank() >= DiagnosticRuleLevel.Deny.rank()

# `script_mode` is true only for interpreted script execution
# (CompileMode.Interpret); it is the single relaxation of SPL-UNIT-002.
pub fn unit_profile_apply(raw_profile: text, script_mode: bool = false):
    unit_profile_apply_for_sdn(raw_profile, "simple.sdn", script_mode)

# Same as unit_profile_apply, reading project: edition from sdn_path.
# SPL-UNIT-004 follows its policy row; SPL-UNIT-002 (mixed-unit product /
# quotient) is strict unless script_mode.
pub fn unit_profile_apply_for_sdn(raw_profile: text, sdn_path: text, script_mode: bool = false):
    val policy = unit_profile_policy()
    if not policy.? and _unit_profile_requires_strict(raw_profile):
        _UNIT_PROFILE_NOTICES.push(diagnostic_policy_default_path() + " not found; profile `" + raw_profile + "` applies SPL-UNIT-004 strictly (fail closed)")
    if unit_profile_strict_for_edition(policy, raw_profile, resolve_edition_from_sdn(sdn_path)):
        unit_op_robust_profile()
    else:
        unit_op_default_profile()
    unit_op_set_mixed_strict(not script_mode)

# Drains pending unit warnings as `[unit <code>] <module>: <msg>`; the code is
# the message's own SPL-UNIT-00N prefix.
pub fn unit_profile_drain_diagnostics(module_name: text) -> [text]:
    var out: [text] = []
    for n in _UNIT_PROFILE_NOTICES:
        out.push("[unit " + UNIT_PROFILE_RULE + "] " + module_name + ": " + n)
    _UNIT_PROFILE_NOTICES = []
    for w in unit_op_take_warnings():
        val code = if w.starts_with(UNIT_MIXED_RULE): UNIT_MIXED_RULE else: UNIT_PROFILE_RULE
        out.push("[unit " + code + "] " + module_name + ": " + w)
    out
