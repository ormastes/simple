# Dependency-light presentation of the actual MIR failure summary.
# Severity, range and count ownership remain in driver_mir_error_owner.

pub fn driver_mir_diagnostic_field_v1(value: text, cap: i64) -> text:
    # Bounded ASCII preview: no newline, terminal escape, or other control bytes.
    # The complete original Unicode message remains in MirLowering.errors.
    var result = ""
    var index = 0
    while index < value.len() and index < cap:
        val character = value.substring(index, index + 1)
        val code = character.byte_at(0) as i64
        if code >= 32 and code <= 126:
            result = result + character
        else:
            result = result + "?"
        index = index + 1
    if value.len() > cap:
        result = result + "..."
    result

pub fn driver_mir_fatal_preview_v1(module_name: text, source_path: text,
        first_message: text, fatal_count: i64) -> text:
    if fatal_count <= 0: return ""
    val module_field = driver_mir_diagnostic_field_v1(module_name, 192)
    val path_field = driver_mir_diagnostic_field_v1(source_path, 256)
    val first = driver_mir_diagnostic_field_v1(first_message, 768)
    "[mir-module-failure] module={module_field} path={path_field} fatal_count={fatal_count} first={first}"
