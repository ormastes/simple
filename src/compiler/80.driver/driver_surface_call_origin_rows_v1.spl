# Call-origin rows for imported providers held only as module SURFACES.
#
# The PM3 per-file unit lane resolves imports through TLDR summary surfaces
# and loads HIR only for its targets, so MIR's HIR prescan never registers a
# provider row and every cross-module call answered MirCallOrigin.Unknown
# (bug stage2_slim_driver_app_native_build_unproven_call_origin_2026-11-19).
# The surfaces themselves are released at the end of HIR lowering
# (lower_and_check_retained_owner_impl), BEFORE MIR setup, so the rows are
# captured here as flat scalars while the surfaces are alive and consumed by
# MIR setup afterwards. Parallel arrays: no surface aggregate crosses the
# native lifetime boundary.

use compiler.hir.hir_lowering.module_surface.{ModuleSurfacesByName}
use compiler.hir.hir_lowering.module_surface_types.{ModuleSurfaceImpl, ModuleSurfaceCallable}
use compiler.frontend.parser_types_expr.{parser_type_kind_named_name}

struct SurfaceCallOriginRowsV1:
    owners: [text]
    names: [text]
    externs: [bool]
    methods: [bool]
    statics: [bool]

fn surface_call_origin_rows_empty_v1() -> SurfaceCallOriginRowsV1:
    SurfaceCallOriginRowsV1(owners: [], names: [], externs: [], methods: [], statics: [])

fn surface_call_origin_rows_capture_v1(surfaces: ModuleSurfacesByName) -> SurfaceCallOriginRowsV1:
    var owners: [text] = []
    var names: [text] = []
    var externs: [bool] = []
    var methods: [bool] = []
    var statics: [bool] = []
    var si = 0
    while si < surfaces.surfaces.len():
        val owner: text = surfaces.surfaces[si].module_name
        if owner != "":
            val callables = surfaces.surfaces[si].callable_values
            var ci = 0
            while ci < callables.len():
                owners.push(owner)
                names.push(callables[ci].name)
                externs.push(callables[ci].is_extern)
                methods.push(callables[ci].is_method)
                statics.push(callables[ci].is_static)
                ci = ci + 1
            val impls = surfaces.surfaces[si].impls
            var ii = 0
            while ii < impls.len():
                val impl_row: ModuleSurfaceImpl = impls[ii]
                val impl_owner = parser_type_kind_named_name(impl_row.type_.kind)
                if impl_owner != "":
                    val method_names = impl_row.methods.keys()
                    var mi = 0
                    while mi < method_names.len():
                        val mname: text = method_names[mi]
                        if mname != "" and impl_row.methods.contains_key(mname):
                            val method_val: ModuleSurfaceCallable = impl_row.methods[mname]
                            owners.push(owner)
                            names.push(impl_owner + "." + mname)
                            externs.push(method_val.is_extern)
                            methods.push(method_val.is_method)
                            statics.push(method_val.is_static)
                        mi = mi + 1
                ii = ii + 1
        si = si + 1
    SurfaceCallOriginRowsV1(owners: owners, names: names, externs: externs, methods: methods, statics: statics)

export SurfaceCallOriginRowsV1, surface_call_origin_rows_empty_v1, surface_call_origin_rows_capture_v1
