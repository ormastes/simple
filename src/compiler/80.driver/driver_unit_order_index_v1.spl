# Per-file unit order index (first object in 10 s; bug
# unit_child_admission_scans_whole_closure_2026-11-15).
#
# Every unit child used to run worker_admitted_edges_v1 over the WHOLE
# inventory -- one import resolution per source -- only to derive the
# deps-first pick order, which is identical for every unit of one build.
# By default (SIMPLE_UNIT_ORDER_INDEX!=0/false/off) the first unit publishes
# that graph to `<hir_queue>/unit_order.idx` (pid-unique temp file + atomic
# rename) and every later unit decodes it instead: zero resolutions, one file
# read. The header binds the index to the exact inventory (count + sha256 of
# the path list); any mismatch or a missing/garbled file falls back to the full
# scan, never to a guessed order. Explicit 0/false/off rolls back to the full
# per-unit walk.
use compiler.driver.driver_worker_surface_closure_v1.{WorkerAdmittedGraphV1, worker_admitted_edges_v1}
use std.common.crypto.sha256.{sha256_text}
use std.io_runtime.{file_exists, file_read, file_write, file_rename, file_delete, getpid}

pub const UNIT_ORDER_INDEX_ENV_V1: text = "SIMPLE_UNIT_ORDER_INDEX"
const UNIT_ORDER_INDEX_MAGIC_V1: text = "unit-order-index/v1"

pub fn unit_order_index_enabled_v1(raw: text) -> bool:
    val trimmed = raw.trim()
    trimmed != "0" and trimmed != "false" and trimmed != "off"

pub fn unit_order_index_path_v1(queue: text) -> text:
    "{queue}/unit_order.idx"

pub fn unit_order_index_digest_v1(paths: [text]) -> text:
    sha256_text(paths.join("\n"))

# Content stamp: the edges depend on each source's imports and on the
# resolution roots/mode, not just the path list, so an import edit with an
# unchanged inventory must invalidate the index. Per-source hashes are joined
# so no separator inside a source can alias two inventories.
fn _uoi_valid_sha256_hex_v1(digest: text) -> bool:
    if digest.byte_len() != 64: return false
    var i = 0
    while i < 64:
        val b = digest.byte_at(i)
        val ok = (b >= 48 and b <= 57) or (b >= 97 and b <= 102) or (b >= 65 and b <= 70)
        if not ok: return false
        i = i + 1
    true

fn _uoi_row_sha256_v1(contents: [text], precomputed: [text], index: i64) -> text:
    if index >= 0 and index < precomputed.len() and _uoi_valid_sha256_hex_v1(precomputed[index]):
        return precomputed[index].lower()
    sha256_text(contents[index])

pub fn unit_order_index_stamp_v1(contents: [text], roots: [text], library_mode: text,
        precomputed_hashes: [text] = []) -> text:
    var parts: [text] = []
    var idx = 0
    while idx < contents.len():
        parts.push(_uoi_row_sha256_v1(contents, precomputed_hashes, idx))
        idx = idx + 1
    parts.push(sha256_text(roots.join("\n")))
    parts.push(sha256_text(library_mode))
    sha256_text(parts.join(","))

fn _uoi_header_v1(paths: [text], stamp: text) -> text:
    "{UNIT_ORDER_INDEX_MAGIC_V1} n={paths.len()} digest={unit_order_index_digest_v1(paths)} stamp={stamp}"

fn _uoi_clean_v1(s: text) -> text:
    s.replace("\n", " ").replace("\r", " ").replace("\t", " ")

# Per-source content hashes, stored as an optional third row column so phase 1
# can tell which sources are unchanged since the build that wrote the index.
pub fn unit_order_content_hashes_v1(contents: [text], precomputed_hashes: [text] = []) -> [text]:
    var out: [text] = []
    var idx = 0
    while idx < contents.len():
        out.push(_uoi_row_sha256_v1(contents, precomputed_hashes, idx))
        idx = idx + 1
    out

pub fn unit_order_index_encode_v1(paths: [text], stamp: text, graph: WorkerAdmittedGraphV1,
        hashes: [text] = []) -> text:
    var lines: [text] = [_uoi_header_v1(paths, stamp)]
    var i = 0
    while i < paths.len():
        var deps: [text] = []
        if i < graph.edges.len():
            for d in graph.edges[i]: deps.push("{d}")
        val err = if i < graph.errors.len(): _uoi_clean_v1(graph.errors[i]) else: ""
        val hash_col = if hashes.len() == paths.len(): "\t{hashes[i]}" else: ""
        lines.push("{deps.join(",")}\t{err}{hash_col}")
        i = i + 1
    lines.join("\n")

pub fn unit_order_index_decode_v1(paths: [text], stamp: text, content: text) -> Result<WorkerAdmittedGraphV1, text>:
    val lines = content.split("\n")
    if lines.len() != paths.len() + 1:
        return Err("unit order index row count mismatch")
    if lines[0] != _uoi_header_v1(paths, stamp):
        return Err("unit order index inventory mismatch")
    var edges: [[i64]] = []
    var errors: [text] = []
    var i = 1
    while i < lines.len():
        val cols = lines[i].split("\t")
        if cols.len() != 2 and cols.len() != 3:
            return Err("unit order index row {i} malformed")
        val dep_text = cols[0]
        var deps: [i64] = []
        if dep_text != "":
            for part in dep_text.split(","):
                val d = part.to_i64() ?? -1
                if d < 0 or d >= paths.len():
                    return Err("unit order index row {i} dep out of range")
                deps.push(d)
        edges.push(deps)
        errors.push(cols[1])
        i = i + 1
    Ok(WorkerAdmittedGraphV1(edges: edges, errors: errors))

pub fn unit_order_index_load_v1(queue: text, paths: [text], stamp: text) -> Result<WorkerAdmittedGraphV1, text>:
    val path = unit_order_index_path_v1(queue)
    if queue == "" or not file_exists(path):
        return Err("unit order index absent")
    unit_order_index_decode_v1(paths, stamp, file_read(path))

# Temp + atomic rename: a concurrent reader sees the old file or the whole new
# one. A lost race publishes identical bytes, so either winner is correct.
pub fn unit_order_index_publish_v1(queue: text, paths: [text], stamp: text, graph: WorkerAdmittedGraphV1,
        hashes: [text] = []) -> bool:
    if queue == "":
        return false
    val target = unit_order_index_path_v1(queue)
    val tmp = "{target}.{getpid()}.tmp"
    if not file_write(tmp, unit_order_index_encode_v1(paths, stamp, graph, hashes)):
        return false
    if file_rename(tmp, target):
        return true
    val _dropped = file_delete(tmp)
    file_exists(target)

# Unit child entry: decode the shared index when on and valid; otherwise run
# the full admitted-graph walk (and, when on, publish it for later units).
pub fn unit_admitted_graph_v1(enabled: bool, queue: text, paths: [text], contents: [text], names: [text],
        roots: [text], library_mode: text, precomputed_hashes: [text] = []) -> Result<WorkerAdmittedGraphV1, text>:
    if not enabled:
        return worker_admitted_edges_v1(paths, contents, names, roots, library_mode)
    val stamp = unit_order_index_stamp_v1(contents, roots, library_mode, precomputed_hashes)
    val hit = unit_order_index_load_v1(queue, paths, stamp)
    if hit.is_ok():
        return hit
    val computed = worker_admitted_edges_v1(paths, contents, names, roots, library_mode)
    if computed.is_ok():
        val _published = unit_order_index_publish_v1(queue, paths, stamp, computed.unwrap(),
            unit_order_content_hashes_v1(contents, precomputed_hashes))
    computed

# Phase 1 skip-fresh (SIMPLE_UNIT_ORDER_SKIP_FRESH=1, requires the index).
pub const UNIT_ORDER_SKIP_FRESH_ENV_V1: text = "SIMPLE_UNIT_ORDER_SKIP_FRESH"

pub fn unit_order_skip_fresh_enabled_v1(skip_raw: text, index_raw: text) -> bool:
    skip_raw == "1" and unit_order_index_enabled_v1(index_raw)

# The HIR artifact of `path`: its ledger terminal must be a PASS for exactly
# this path whose HIR was stored in the cache.
fn _uosf_hir_artifact_ok_v1(queue: text, path: text) -> bool:
    val terminal = "{queue}/{sha256_text(path)}.terminal"
    if not file_exists(terminal):
        return false
    val f = file_read(terminal).split("\n")
    f.len() == 6 and f[0] == "PASS" and f[2] == path and f[4] == "CACHE_STORED"

# fresh[i] is true only when the previous index (same magic, count and path
# digest; its stamp may differ because other sources changed) carries a hash
# row equal to sha256(contents[i]) and the HIR artifact exists. Must be read
# BEFORE unit_admitted_graph_v1 republishes the index. Any doubt -> false.
pub fn unit_order_fresh_flags_v1(enabled: bool, queue: text, paths: [text], contents: [text],
        precomputed_hashes: [text] = []) -> [bool]:
    var fresh: [bool] = []
    for _p in paths: fresh.push(false)
    if not enabled or queue == "" or contents.len() != paths.len():
        return fresh
    val path = unit_order_index_path_v1(queue)
    if not file_exists(path):
        return fresh
    val lines = file_read(path).split("\n")
    if lines.len() != paths.len() + 1:
        return fresh
    val want = "{UNIT_ORDER_INDEX_MAGIC_V1} n={paths.len()} digest={unit_order_index_digest_v1(paths)} stamp="
    if not lines[0].starts_with(want):
        return fresh
    var i = 0
    while i < paths.len():
        val cols = lines[i + 1].split("\t")
        if cols.len() == 3 and cols[2] == _uoi_row_sha256_v1(contents, precomputed_hashes, i) and _uosf_hir_artifact_ok_v1(queue, paths[i]):
            fresh[i] = true
        i = i + 1
    fresh

pub fn unit_order_skip_fresh_order_v1(order: [i64], fresh: [bool]) -> [i64]:
    var out: [i64] = []
    for at in order:
        if at < 0 or at >= fresh.len() or not fresh[at]:
            out.push(at)
    out

export UNIT_ORDER_SKIP_FRESH_ENV_V1, unit_order_skip_fresh_enabled_v1, unit_order_fresh_flags_v1
export unit_order_skip_fresh_order_v1, unit_order_content_hashes_v1
export unit_admitted_graph_v1
export UNIT_ORDER_INDEX_ENV_V1, unit_order_index_enabled_v1, unit_order_index_path_v1
export unit_order_index_digest_v1, unit_order_index_stamp_v1,unit_order_index_encode_v1, unit_order_index_decode_v1
export unit_order_index_load_v1, unit_order_index_publish_v1
