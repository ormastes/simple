use compiler.driver.driver_compiler_type.{CompilerDriver}
use compiler.driver.cache.driver_hir_archive_schedule_v1.{DriverHirArchiveScheduleV1,
    driver_hir_archive_schedule_from_streaming_owner_v1,
    driver_hir_archive_schedule_verify_streaming_owner_v1}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}

impl CompilerDriver:
    me capture_hir_archive_streaming_schedule_v1() -> Result<DriverHirArchiveScheduleV1, text>:
        if transient_array_scope_state_v1() != 0 or not self.streaming_surface_owner_ready:
            return Err("HIR schedule actual driver streaming owner unavailable")
        val captured = driver_hir_archive_schedule_from_streaming_owner_v1(self.ctx,
            self.streaming_module_surfaces_owner, self.streaming_entry_source_index_owner)?
        self.hir_archive_schedule = Some(captured)
        Ok(captured)

    me verify_hir_archive_streaming_schedule_v1() -> Result<bool, text>:
        if transient_array_scope_state_v1() != 0 or not self.streaming_surface_owner_ready:
            return Err("HIR schedule actual driver streaming owner unavailable")
        if val Some(captured) = self.hir_archive_schedule:
            return driver_hir_archive_schedule_verify_streaming_owner_v1(self.ctx,
                self.streaming_module_surfaces_owner, self.streaming_entry_source_index_owner, captured)
        Err("HIR schedule driver has no captured actual projection")
