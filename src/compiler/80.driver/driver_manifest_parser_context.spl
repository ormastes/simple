# Single parser entrypoint for sources that may carry admitted aspect identity.

use compiler.common.config.{Logger}
use compiler.common.driver_core_types.{SourceFile}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{ParserModule}
use compiler.frontend.core.parser_decls.{
    parser_set_aspect_context, parser_clear_aspect_context
}

fn driver_set_source_aspect_context(source: SourceFile):
    if source.aspect_id != "" and source.aspect_version > 0 and
            source.descriptor_digest.len() == 64:
        parser_set_aspect_context(source.aspect_id, source.aspect_version,
            source.descriptor_digest)
    else:
        parser_clear_aspect_context()

pub fn driver_parse_manifest_source(source: SourceFile,
        logger: Logger) -> ParserModule:
    """Parse once with immutable manifest identity installed and cleared."""
    driver_set_source_aspect_context(source)
    val module = parse_full_frontend(source.content, source.path,
        source.module_name, logger)
    parser_clear_aspect_context()
    module
