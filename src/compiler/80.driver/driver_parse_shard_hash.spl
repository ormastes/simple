# Parse/HIR shard ownership index. Ownership is a pure function of the module
# PATH, shared by the parse shards (driver_source_pipeline_parsing.spl) and the
# HIR shards (driver_hir_cache.spl): one hash, one marker name, across every
# shard kind and process.
#
# The hash is spelled out here rather than reusing rt_hash_text because the
# split must agree ACROSS PROCESSES; a runtime hash that is seeded or
# implementation-defined would silently give two shards different answers.
# XXH3-64 is a fixed, unseeded function of the bytes; the top bit is dropped so
# the result stays a non-negative i64 for `% count` and claim-marker names.
use std.common.crypto.xxh3.{xxh3_64}
use std.common.text_bytes.{text_to_utf8_bytes}

pub fn driver_parse_shard_hash(path: text) -> i64:
    val shifted = (xxh3_64(text_to_utf8_bytes(path)) >> 1u64).to_i64()
    # On the stage2 native windows-gnu build this expression still yields
    # negative values (sign bit not cleared), so about half of all paths
    # missed every shard but 0 under `% count`: an 8-way static parse
    # split cached only 795 of 1441 modules. Clearing the sign bit explicitly is
    # a no-op wherever the shift was already logical. Same values on the seed.
    if shifted < 0: (shifted + 9223372036854775807) + 1 else: shifted
