# Pure policy projection shared by the CLI parent and CompileContext.
# CLI order wins, then explicit environment, then collect-all in every host/CI context.
pub fn compile_fail_fast_requested(args: [text], env_value: text, ci_value: text = "") -> bool:
    var enabled = false
    if env_value == "1": enabled = true
    elif env_value == "0": enabled = false
    for arg in args:
        if arg == "--fail-fast":
            enabled = true
        elif arg == "--keep-going":
            enabled = false
    enabled
