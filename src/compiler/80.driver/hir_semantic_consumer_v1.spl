# Read-only actual HIR consumers. Only rendered diagnostic arrays escape.
use compiler.hir.hir_types.{HirModule}
use compiler.common.diagnostics.span.{Span}
use compiler.driver.hir_typecheck_consumer_v1.{HirTypecheckReceiptV1}
use compiler.driver.driver_safety_severity.{SafetyPassSeverity}
use compiler.common.parallel_policy.policy_schema.{ResolvedParallelPolicyV1}
use compiler.common.assurance.policy_schema.{AssuranceStrictness}
use compiler.semantics.safety_checker.{SafetyChecker, safetychecker_check_module,
    safetychecker_check_transfer_module_with_policy}
use compiler.semantics.any_escape.{AnyEscapeProfile, any_escape_check}
use compiler.semantics.enum_contract.{enum_contract_declaration_report_v1}
use compiler.semantics.representation_boundary.validation.{representation_index_build_v1, representation_manifest_diagnostics_v1, representation_diagnostics_order_v1}
use compiler.semantics.representation_boundary.unsafe_observations.{representation_missing_manifest_observations_v1}

pub fn collect_module_representation_receipt_v1(name: text, module: HirModule,
        strictness: AssuranceStrictness) -> HirTypecheckReceiptV1:
    val index = representation_index_build_v1(module.representation_declarations, strictness)
    var messages: [text] = []
    var warnings: [text] = []
    var errors: [text] = []
    var diagnostics = representation_manifest_diagnostics_v1(index)
    for observation in representation_missing_manifest_observations_v1(module, strictness):
        diagnostics.push(observation)
    for diagnostic in representation_diagnostics_order_v1(diagnostics):
        val code = diagnostic.code ?? "E-MC-REP-001"
        val span = diagnostic.span ?? Span.empty()
        val message = "[{code}] {name}: {diagnostic.message} at {span.line}:{span.col}"
        messages.push(message)
        if strictness == AssuranceStrictness.Critical:
            errors.push(message)
        else:
            warnings.push(message)
    HirTypecheckReceiptV1(messages: messages, warnings: warnings, errors: errors)

pub fn collect_module_safety_receipt_v1(name: text, m: HirModule,
        severity: SafetyPassSeverity, parallel_policy: ResolvedParallelPolicyV1) -> HirTypecheckReceiptV1:
    var out: [text] = []
    var warnings: [text] = []
    var errors: [text] = []
    val checker = SafetyChecker.create()
    val serrors = safetychecker_check_module(checker, m)
    # Use the same checker so the transfer walk sees class symbols collected
    # by the primary module check.
    val transfer_errors = safetychecker_check_transfer_module_with_policy(
        checker, m, parallel_policy)
    var s_idx = 0
    while s_idx < serrors.len():
        match serrors[s_idx]:
            case InlineAsmOutsideUnsafe(span):
                val sp: Span = span
                val msg = "[safety inline-asm-outside-unsafe] {name}: inline asm used outside an `unsafe:` block at {sp.line}:{sp.col}"
                out = out.push(msg)
                match severity:
                    case SafetyPassSeverity.Advisory:
                        val _ = 0
                    case SafetyPassSeverity.Warn:
                        warnings.push(msg)
                    case SafetyPassSeverity.Deny:
                        errors.push(msg)
            case UnsafeFfiOutsideUnsafe(span):
                val sp: Span = span
                val msg = "[safety unsafe-ffi-outside-unsafe] {name}: unsafe FFI call used outside an `unsafe:` block at {sp.line}:{sp.col}"
                out = out.push(msg)
                match severity:
                    case SafetyPassSeverity.Advisory:
                        val _ = 0
                    case SafetyPassSeverity.Warn:
                        warnings.push(msg)
                    case SafetyPassSeverity.Deny:
                        errors.push(msg)
            case RawPointerOutsideUnsafe(span):
                val sp: Span = span
                val msg = "[safety raw-pointer-outside-unsafe] {name}: raw pointer operation used outside an `unsafe:` block at {sp.line}:{sp.col}"
                out = out.push(msg)
                match severity:
                    case SafetyPassSeverity.Advisory:
                        val _ = 0
                    case SafetyPassSeverity.Warn:
                        warnings.push(msg)
                    case SafetyPassSeverity.Deny:
                        errors.push(msg)
            case StaticReferenceOutsideUnsafe(span):
                val sp: Span = span
                val msg = "[safety static-reference-outside-unsafe] {name}: reference to module static taken outside an `unsafe:` block at {sp.line}:{sp.col}; fix: wrap the reference-taking expression in the smallest valid `unsafe:` block"
                out = out.push(msg)
                match severity:
                    case SafetyPassSeverity.Advisory:
                        val _ = 0
                    case SafetyPassSeverity.Warn:
                        warnings.push(msg)
                    case SafetyPassSeverity.Deny:
                        errors.push(msg)
            case MutableReferenceToImmutableStatic(span):
                val sp: Span = span
                val msg = "[safety mutable-reference-to-immutable-static] {name}: mutable reference requested for an immutable module static at {sp.line}:{sp.col}; fix: use `&STATIC`, or declare the static mutable when shared mutation is intended"
                out = out.push(msg)
                match severity:
                    case SafetyPassSeverity.Advisory:
                        val _ = 0
                    case SafetyPassSeverity.Warn:
                        warnings.push(msg)
                    case SafetyPassSeverity.Deny:
                        errors.push(msg)
            case Other(message, span):
                val sp: Span = span
                val msg = "[safety other] {name}: {message} at {sp.line}:{sp.col}"
                out = out.push(msg)
                match severity:
                    case SafetyPassSeverity.Advisory:
                        val _ = 0
                    case SafetyPassSeverity.Warn:
                        warnings.push(msg)
                    case SafetyPassSeverity.Deny:
                        errors.push(msg)
        s_idx = s_idx + 1
    var t_idx = 0
    while t_idx < transfer_errors.len():
        match transfer_errors[t_idx]:
            case Other(message, span):
                val sp: Span = span
                val msg = "[safety other] {name}: {message} at {sp.line}:{sp.col}"
                out = out.push(msg)
                match severity:
                    case SafetyPassSeverity.Advisory:
                        val _ = 0
                    case SafetyPassSeverity.Warn:
                        warnings.push(msg)
                    case SafetyPassSeverity.Deny:
                        errors.push(msg)
            case _:
                pass
        t_idx = t_idx + 1
    HirTypecheckReceiptV1(messages: out, warnings: warnings, errors: errors)

pub fn collect_module_any_escape_receipt_v1(name: text, module: HirModule,
        strictness: AssuranceStrictness) -> HirTypecheckReceiptV1:
    val is_critical = match strictness:
        case AssuranceStrictness.Critical: true
        case _: false
    # No HIR node carries `@unsafe(capabilities: [type_erasure])` yet
    # (unsafe_capabilities_not_carried_into_hir_2026-08-21), so no function can
    # be granted the capability from here. An empty grant list is the
    # fail-CLOSED direction: it can only produce findings, never hide one.
    val profile = if is_critical:
        AnyEscapeProfile.critical([])
    else:
        AnyEscapeProfile.census([])
    var out: [text] = []
    var warnings: [text] = []
    var errors: [text] = []
    for d in any_escape_check(module, profile):
        var msg = "[{d.code}] {name}::{d.function_name}: {d.message} at {d.span.line}:{d.span.col}"
        if d.origin_note != "":
            msg = msg + " (" + d.origin_note + ")"
        out = out.push(msg)
        if is_critical:
            errors.push(msg)
        else:
            warnings.push(msg)
    HirTypecheckReceiptV1(messages: out, warnings: warnings, errors: errors)

pub fn collect_module_enum_contract_receipt_v1(name: text, module: HirModule,
        strictness: AssuranceStrictness) -> HirTypecheckReceiptV1:
    val is_critical = match strictness:
        case AssuranceStrictness.Critical: true
        case _: false
    var out: [text] = []
    var warnings: [text] = []
    var errors: [text] = []
    val report = enum_contract_declaration_report_v1(module, strictness)
    for d in report.diags:
        val msg = "[{d.code}] {name}: {d.message} ({d.enum_name}: {d.detail})"
        out = out.push(msg)
        if is_critical:
            errors.push(msg)
        else:
            warnings.push(msg)
    # MIR rejects explicit noninteger/unavailable discriminants in every profile.
    # Keep those failures fatal here too, without relabeling them as contract IDs.
    for failure in report.constant_failures:
        val msg = failure.message()
        out = out.push(msg)
        errors.push(msg)
    HirTypecheckReceiptV1(messages: out, warnings: warnings, errors: errors)

export collect_module_safety_receipt_v1, collect_module_any_escape_receipt_v1
export collect_module_enum_contract_receipt_v1
export collect_module_representation_receipt_v1
