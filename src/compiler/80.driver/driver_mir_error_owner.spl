# Preserve the module owner before shared MIR errors are collected in aggregate.
use std.nogc_async_mut.sosix.environment.{sosix_env_get_nullable}
use compiler.mir.mir_lowering_types.{MirError}
use compiler.driver.driver_log_helpers.{log_phase}

pub fn driver_trace_module_mir_errors(module_name: text, source_path: text,
        errors: [MirError], first_new_error: i64):
    if (sosix_env_get_nullable("SIMPLE_COMPILER_PHASE_PROFILE") ?? "") != "1":
        return
    if first_new_error < 0 or first_new_error >= errors.len():
        return
    val count = errors.len() - first_new_error
    log_phase("aot:mir_errors:module module={module_name} path={source_path} count={count}")
    var index = first_new_error
    while index < errors.len():
        # Error text and severity stay untouched for the normal collector.
        # Avoid projecting the optional span: ownership is already available.
        val message = errors[index].message
        log_phase("aot:mir_errors:item module={module_name} path={source_path} index={index} message={message}")
        index = index + 1
