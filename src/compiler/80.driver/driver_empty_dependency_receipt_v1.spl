# Parse-completed empty dependencies contribute no standalone object.
# Receipts are minted only at the actual frontend success boundary and bound
# to the frozen source snapshot generation. They are not an empty-MIR guess.
use compiler.frontend.parser_types.{ParserModule}
use compiler.mir.mir_data.{MirModule}
use std.common.crypto.sha256.{sha256_text}

pub fn driver_empty_dependency_comments_only_v1(source: text) -> bool:
    for line in source.split("\n"):
        var offset = 0
        while offset < line.len():
            val character = line.substring(offset, offset + 1)
            if character != " " and character != "\t" and character != "\r":
                break
            offset = offset + 1
        if offset < line.len() and line.substring(offset, offset + 1) != "#":
            return false
    true

pub fn driver_empty_dependency_parser_empty_v1(parsed_module: ParserModule?) -> bool:
    if parsed_module == nil: return false
    val parsed = parsed_module
    parsed.imports.len() == 0 and parsed.exports.len() == 0 and
        parsed.domain_blocks.len() == 0 and parsed.functions.len() == 0 and
        parsed.function_headers.len() == 0 and parsed.function_order.len() == 0 and
        parsed.classes.len() == 0 and parsed.actors.len() == 0 and
        parsed.actor_order.len() == 0 and parsed.structs.len() == 0 and
        parsed.enums.len() == 0 and parsed.bitfields.len() == 0 and
        parsed.traits.len() == 0 and parsed.impls.len() == 0 and
        parsed.type_aliases.len() == 0 and parsed.constants.len() == 0 and
        parsed.static_asserts.len() == 0 and parsed.aop_advices.len() == 0 and
        parsed.di_bindings.len() == 0 and parsed.arch_rules.len() == 0 and
        parsed.mock_decls.len() == 0 and parsed.extend_enums.len() == 0 and
        parsed.friends.len() == 0 and parsed.internal_exports.len() == 0 and
        parsed.tagged_layer == "" and parsed.layer_dag_edges == ""

pub fn driver_empty_dependency_parse_receipt_v1(
    parsed_module: ParserModule?, source: text, source_digest: text,
    generation: text, parse_succeeded: bool
) -> text:
    if not parse_succeeded or source_digest.len() != 64 or generation.len() != 64:
        return ""
    if not driver_empty_dependency_parser_empty_v1(parsed_module) or
            not driver_empty_dependency_comments_only_v1(source):
        return ""
    if sha256_text(source) != source_digest: return ""
    generation + ":" + source_digest

pub fn driver_empty_dependency_admitted_v1(
    mir: MirModule, parsed_module: ParserModule?, receipt: text,
    source_digest: text, generation: text, is_entry: bool, poisoned: bool
) -> bool:
    if is_entry or poisoned or source_digest.len() != 64 or generation.len() != 64:
        return false
    if receipt != generation + ":" + source_digest:
        return false
    if mir.functions.len() > 0 or mir.statics.len() > 0 or
            mir.constants.len() > 0 or mir.types.len() > 0:
        return false
    driver_empty_dependency_parser_empty_v1(parsed_module)

pub fn driver_empty_dependency_forget_source_v1(
    receipts: {text: text}, source_path: text
) -> {text: text}:
    var remaining = receipts
    if remaining.has(source_path): remaining.remove(source_path)
    remaining
