# Diagnostics only; these values cannot construct a semantic grant or result.
pub const FROZEN_SEMANTIC_LITERAL_PROFILE_V1: text = "frozen-scalar-literal-probe-v1"

pub struct FrozenSemanticPrerequisiteLimitsV1:
    max_source_bytes: i64
    max_functions: i64
    max_ast_nodes: i64
    max_depth: i64

pub struct FrozenSemanticPrerequisiteRequestV1:
    source_bytes: [u8]
    source_path: text
    module_name: text
    expected_source_sha256: text
    target_triple: text
    limits: FrozenSemanticPrerequisiteLimitsV1

# Scalar observations of the actual HIR terminal, not executable semantic IR.
pub struct FrozenSemanticFunctionObservationV1:
    function_name: text
    declared_type: text
    literal_kind: text
    integer_literal: i64
    boolean_literal: bool

pub struct FrozenSemanticPrerequisiteDiagnosticV1:
    status: text
    reason: text
    supported_profile_id: text
    driver_identity: i64
    source_path: text
    module_name: text
    source_sha256: text
    target_triple: text
    preprocessed_sha256: text
    target_decision_digest: text
    parsed_functions: i64
    visited_ast_nodes: i64
    lowered_functions: i64
    hm_checked_functions: i64
    observations: [FrozenSemanticFunctionObservationV1]
    errors: [text]
    warnings: [text]
    semantic_authorized: bool
    full_artifact_authorized: bool

pub fn frozen_semantic_diagnostic_v1(request: FrozenSemanticPrerequisiteRequestV1,
        driver_identity: i64, status: text, reason: text) -> FrozenSemanticPrerequisiteDiagnosticV1:
    val path = if request.source_path.len() <= 256: request.source_path else: ""
    val name = if request.module_name.len() <= 256: request.module_name else: ""
    val source_sha = if request.expected_source_sha256.len() <= 64: request.expected_source_sha256 else: ""
    val target = if request.target_triple.len() <= 256: request.target_triple else: ""
    FrozenSemanticPrerequisiteDiagnosticV1(status: status, reason: reason,
        supported_profile_id: FROZEN_SEMANTIC_LITERAL_PROFILE_V1,
        driver_identity: driver_identity, source_path: path,
        module_name: name, source_sha256: source_sha,
        target_triple: target, preprocessed_sha256: "", target_decision_digest: "",
        parsed_functions: 0, visited_ast_nodes: 0, lowered_functions: 0,
        hm_checked_functions: 0, observations: [], errors: [], warnings: [],
        semantic_authorized: false, full_artifact_authorized: false)
