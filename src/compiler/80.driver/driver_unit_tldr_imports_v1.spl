# PM3: per-file unit child resolves its imports through TLDR summaries instead of
# parsing/lowering the imports' closure (true_per_file_src_to_obj_plan.md).
#
# Switch: SIMPLE_UNIT_TLDR_IMPORTS (driver_tldr_import_route_v1.spl), default ON
# in the unit lane, "0" = the old import-HIR path unchanged.
#
# With the switch on a unit parses ONLY its picked files. Every import (and the
# imports of those imports, text-scanned, never parsed) gets a summary via
# tldr_summary_ensure_v1; its surface is built by module_surface_from_tldr_v1 and
# registered with driver_register_tldr_surfaces_v1. No import HIR is lowered. A
# summary that is missing, carries fallback rows, or yields no surface is a
# fallback: only that module's source is parsed (counted, `[tldr-fallback]`).
# Imported generic bodies are never loaded on demand: the template-body seam
# was removed (2026-10-31).
use std.io_runtime.{file_exists, file_read}
use std.nogc_sync_mut.io.env_ops.{env_get}
use compiler.driver.cache.tldr_summary_v1.{tldr_summary_ensure_v1}
use compiler.driver.driver_compiler_type.{CompilerDriver}
# Split impl provider of CompilerDriver.stage_lower_hir_check_v1 (narrow: no
# driver_orchestration -> driver_aot_pipeline -> backend_vhdl closure).
use compiler.driver.driver_stage_hir_v1.*
# @workaround bug=ctor_mir_2026-10-31 reason=import CompileResult so MIR gets its runtime enum identity
use compiler.common.driver_compile_result.{CompileResult}
use compiler.driver.driver_tldr_import_route_v1.{tldr_route_import_specs_v1, unit_tldr_imports_enabled_v1}
use compiler.driver.driver_tldr_surface_register_v1.{driver_register_tldr_surfaces_v1}
use compiler.common.module_path_naming.{module_logical_name_from_path, module_canonical_fold_name}
use compiler.hir.hir_lowering.module_surface_from_tldr_v1.{module_surface_from_tldr_v1}
use compiler.hir.hir_lowering.module_surface_types.{ModuleSurface}
use compiler.hir.hir_lowering.module_surface_source_identity.{module_surface_canonical_path,
    module_surface_content_hash, module_surface_admitted_roots_v1,
    module_surface_admitted_logical_id_v1, module_surface_logical_alias_candidates_v1,
    module_surface_same_admitted_logical_module_v1}

struct UnitTldrPlanV1:
    unit_id: text
    picked: [text]
    parse_paths: [text]
    parsed: i64
    summaries: i64
    fallbacks: i64
    fallback_modules: [text]
    surfaces: [ModuleSurface]
    import_hir_lowered: i64
    admitted_roots: [text] = []

struct UnitLowerResultV1:
    gap: text
    parsed: i64
    summaries: i64
    fallbacks: i64
    import_hir_lowered: i64
    line: text

pub fn unit_tldr_log_line_v1(unit_id: text, parsed: i64, summaries: i64, fallbacks: i64, import_hir_lowered: i64) -> text:
    "[unit-tldr] unit={unit_id} parsed={parsed} summaries={summaries} fallbacks={fallbacks} import_hir_lowered={import_hir_lowered}"

# `module_paths` maps module id -> source path (the frozen inventory).
pub fn unit_tldr_plan_v1(unit_id: text, root: text, picked: [text], module_paths: Dict<text, text>) -> UnitTldrPlanV1:
    var parse_paths: [text] = []
    var root_candidates: [text] = []
    for p in picked:
        parse_paths.push(p)
        root_candidates.push(p)
    for mp in module_paths.values():
        root_candidates.push(mp)
    val admitted_roots = module_surface_admitted_roots_v1(
        root_candidates, [], module_surface_canonical_path("."))
    var surfaces: [ModuleSurface] = []
    var fallback_modules: [text] = []
    var seen: [text] = []
    var seen_paths: [text] = []
    var frontier: [text] = []
    for p in picked:
        for spec in tldr_route_import_specs_v1(file_read(p)):
            val (module_id, _names) = spec
            if not frontier.contains(module_id):
                frontier.push(module_id)
    var pos = 0
    var summaries = 0
    while pos < frontier.len():
        val module_id = frontier[pos]
        pos = pos + 1
        if seen.contains(module_id):
            continue
        val src_path = unit_tldr_module_path_for_v1(module_paths, module_id)
        if src_path == "":
            continue
        if not file_exists(src_path):
            continue
        seen.push(module_id)
        val src_canonical = module_surface_canonical_path(src_path)
        val path_key = if src_canonical != "": src_canonical else: src_path
        if seen_paths.contains(path_key):
            continue
        seen_paths.push(path_key)
        val source = file_read(src_path)
        var built: ModuleSurface? = None
        match tldr_summary_ensure_v1(root, module_id, source):
            case Some(rows):
                summaries = summaries + 1
                built = module_surface_from_tldr_v1(module_id, rows)
            case None: pass
        match built:
            case Some(surface):
                # The summary surface is built from the module id, so its
                # canonical path is synthetic (<cwd>/<module/path>.spl). Bind
                # it to the admitted source row: the worker readiness walk keys
                # on surface.canonical_path (bug per_file_lane_unit_mir_physical_
                # ownership_missing_hir_2026-11-12, layer 2).
                var bound: ModuleSurface = surface
                bound.canonical_path = path_key
                val admitted_logical = module_surface_admitted_logical_id_v1(src_path, admitted_roots)
                val derived_logical = if admitted_logical != "":
                    admitted_logical
                else:
                    module_logical_name_from_path(src_path)
                if derived_logical != "" and not derived_logical.contains("/"):
                    bound.logical_name = derived_logical
                    bound.canonical_name = module_canonical_fold_name(derived_logical)
                # Bind the physical content identity too: a second admitted row
                # for the same file (lib.X / std.X twin) takes the registry's
                # alias lane, which rejects a surface whose length/hash differ
                # from the row's source ("conflicting physical source"). The
                # summary builder leaves both at 0.
                bound.content_length = source.byte_len()
                bound.content_hash = module_surface_content_hash(source)
                surfaces.push(bound)
            case None:
                fallback_modules.push(module_id)
                if not parse_paths.contains(src_path):
                    parse_paths.push(src_path)
                print("[tldr-fallback] module={module_id} reason=no-summary-surface source-load=1")
        for spec in tldr_route_import_specs_v1(source):
            val (next_id, _next_names) = spec
            if not frontier.contains(next_id):
                frontier.push(next_id)
    UnitTldrPlanV1(unit_id: unit_id, picked: picked, parse_paths: parse_paths, parsed: parse_paths.len(),
        summaries: summaries, fallbacks: fallback_modules.len(), fallback_modules: fallback_modules,
        surfaces: surfaces, import_hir_lowered: 0, admitted_roots: admitted_roots)

# Unit child entry for the lowering step. The driver has loaded + parsed its
# inputs. Switch on: register the summary surfaces (no import HIR lowered).
# Switch off: lower exactly as before and report how many non-picked modules
# were lowered. Returns the `[unit-tldr]` line it logged.
pub fn unit_lower_v1(driver: CompilerDriver, unit_id: text, root: text, picked: [text],
        module_paths: Dict<text, text>, unit_active: bool) -> UnitLowerResultV1:
    var parsed = picked.len()
    var summaries = 0
    var fallbacks = 0
    if unit_tldr_imports_enabled_v1(unit_active):
        val plan = unit_tldr_plan_v1(unit_id, root, picked, module_paths)
        parsed = plan.parsed
        summaries = plan.summaries
        fallbacks = plan.fallbacks
        val registered = driver_register_tldr_surfaces_v1(driver, plan.surfaces)
        if registered != "":
            val line = unit_tldr_log_line_v1(unit_id, parsed, summaries, fallbacks, 0)
            return UnitLowerResultV1(gap: "register-failed:" + registered, parsed: parsed, summaries: summaries,
                fallbacks: fallbacks, import_hir_lowered: 0, line: line)
    # @workaround bug=stage2_split_impl_modules_missing_from_entry_closure_2026-08-22 reason=frozen stage2 unverified on the driver_stage_hir_v1 provider edge
    # Fail-closed: until a stage3 built from this source proves the provider
    # edge, the release phase-3 build skips HIR lowering here and reports a
    # named gap (nothing consumes this result). SIMPLE_UNIT_TLDR_STAGE_HIR=1
    # opts into the real provider route. Delete this block once verified.
    if env_get("SIMPLE_UNIT_TLDR_STAGE_HIR") != "1":
        val gap_line = unit_tldr_log_line_v1(unit_id, parsed, summaries, fallbacks, 0)
        return UnitLowerResultV1(gap: "stage-lower-hir-gap:split-impl-provider-unverified", parsed: parsed,
            summaries: summaries, fallbacks: fallbacks, import_hir_lowered: 0, line: gap_line)
    var gap = ""
    match driver.stage_lower_hir_check_v1():
        case Some(stop):
            match stop:
                # @workaround bug=ctor_mir_2026-10-31 reason=qualified variants (CompileResult)
                case CompileResult.TypeError(errs): gap = errs.join(" | ")
                case CompileResult.ResolveError(errs): gap = errs.join(" | ")
                case _: gap = "other"
        case None: gap = "none"
    var lowered = driver.ctx.hir_modules.len() - picked.len()
    if lowered < 0:
        lowered = 0
    val line = unit_tldr_log_line_v1(unit_id, parsed, summaries, fallbacks, lowered)
    print(line)
    UnitLowerResultV1(gap: gap, parsed: parsed, summaries: summaries, fallbacks: fallbacks,
        import_hir_lowered: lowered, line: line)

# ---- production wiring helpers (parse_all_streaming_surfaces_in_place_impl) ----

pub fn unit_tldr_empty_plan_v1() -> UnitTldrPlanV1:
    UnitTldrPlanV1(unit_id: "", picked: [], parse_paths: [], parsed: 0, summaries: 0, fallbacks: 0,
        fallback_modules: [], surfaces: [], import_hir_lowered: 0, admitted_roots: [])

fn _unit_tldr_inventory_logical_from_path_v1(path: text, admitted_roots: [text]) -> text:
    val admitted_id = module_surface_admitted_logical_id_v1(path, admitted_roots)
    if admitted_id != "":
        return admitted_id
    val norm = path.replace("\\", "/")
    if norm.starts_with("src/") or norm.starts_with("examples/") or norm.starts_with("test/") or
            norm.contains("/src/") or norm.contains("/examples/") or norm.contains("/test/"):
        return module_canonical_fold_name(module_logical_name_from_path(norm))
    for anchor in ["/app/", "/lib/", "/std/", "/compiler/"]:
        val rel_anchor = anchor.substring(1)
        if norm.starts_with(rel_anchor):
            return module_canonical_fold_name(module_logical_name_from_path(norm))
        val at = norm.index_of(anchor)
        if at >= 0:
            return module_canonical_fold_name(module_logical_name_from_path(norm.substring(at + 1)))
    ""

pub fn unit_tldr_module_paths_v1(module_names: [text], paths: [text]) -> Dict<text, text>:
    var out: Dict<text, text> = {}
    val admitted_roots = module_surface_admitted_roots_v1(paths, [], module_surface_canonical_path("."))
    var i = 0
    while i < module_names.len() and i < paths.len():
        val raw_name = module_names[i]
        val src_path = paths[i]
        if raw_name != "" and not out.contains_key(raw_name):
            out[raw_name] = src_path
        for alias in module_surface_logical_alias_candidates_v1(raw_name):
            if not out.contains_key(alias):
                out[alias] = src_path
        val path_logical = _unit_tldr_inventory_logical_from_path_v1(src_path, admitted_roots)
        for alias in module_surface_logical_alias_candidates_v1(path_logical):
            if not out.contains_key(alias):
                out[alias] = src_path
        i = i + 1
    out

# Per-source "this process parses it": picked + fallback modules + extra (AOP advice).
pub fn unit_tldr_needed_flags_v1(plan: UnitTldrPlanV1, source_paths: [text], extra: [text]) -> [bool]:
    var out: [bool] = []
    for p in source_paths:
        out.push(plan.parse_paths.contains(p) or extra.contains(p))
    out

pub fn unit_tldr_surface_for_v1(plan: UnitTldrPlanV1, module_name: text) -> ModuleSurface?:
    for s in plan.surfaces:
        if s.module_name == module_name:
            return Some(s)
    None

# Inventory path of an import spelling. The closure loader admits a src/lib
# file under its canonical `lib.*` name and adds the `std.*` twin only on
# demand, so a `use std.X` import must also find the `lib.X` row. SCV snapshot
# paths and checkout paths share the same path-derived canonical logical keys.
pub fn unit_tldr_module_path_for_v1(module_paths: Dict<text, text>, module_id: text) -> text:
    if module_id == "":
        return ""
    if module_paths.contains_key(module_id):
        return module_paths[module_id]
    val lookup_id = if module_id.contains("/") or module_id.contains("\\") or module_id.ends_with(".spl"):
        module_logical_name_from_path(module_id)
    else:
        module_id
    for cand in module_surface_logical_alias_candidates_v1(lookup_id):
        if module_paths.contains_key(cand):
            return module_paths[cand]
        val init_cand = cand + ".__init__"
        if module_paths.contains_key(init_cand):
            return module_paths[init_cand]
    ""

# Summary surface for an inventory row. The plan names a surface by the import
# spelling (e.g. `std.common.string_core`) while the row the streaming loop
# meets first may carry another alias (`lib.common.string_core`); the plan
# binds every surface's canonical_path to its admitted source, so fall back to
# that key and to admitted SCV/checkout logical identity. Missing this left the
# row a placeholder -> CLOSURE-INCOMPLETE.
pub fn unit_tldr_surface_for_row_v1(plan: UnitTldrPlanV1, module_name: text, canonical_path: text) -> ModuleSurface?:
    for s in plan.surfaces:
        if s.module_name == module_name:
            return Some(s)
    for s in plan.surfaces:
        if s.canonical_path == canonical_path:
            return Some(s)
    for s in plan.surfaces:
        if module_surface_same_admitted_logical_module_v1(
            s.canonical_path, canonical_path, plan.admitted_roots):
            return Some(s)
    val row_admitted_logical = if plan.admitted_roots.len() > 0:
        module_surface_admitted_logical_id_v1(canonical_path, plan.admitted_roots)
    else:
        ""
    if row_admitted_logical != "":
        for s in plan.surfaces:
            if s.canonical_name == row_admitted_logical or s.logical_name == row_admitted_logical or s.module_name == row_admitted_logical:
                return Some(s)
    val row_cands = module_surface_logical_alias_candidates_v1(module_name)
    if row_cands.len() > 0:
        for s in plan.surfaces:
            if (s.canonical_name != "" and row_cands.contains(s.canonical_name)) or row_cands.contains(s.module_name):
                return Some(s)
    None

export UnitTldrPlanV1, UnitLowerResultV1
export unit_tldr_log_line_v1, unit_tldr_plan_v1, unit_lower_v1
export unit_tldr_empty_plan_v1, unit_tldr_module_paths_v1, unit_tldr_needed_flags_v1, unit_tldr_surface_for_v1
export unit_tldr_module_path_for_v1, unit_tldr_surface_for_row_v1
