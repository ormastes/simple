# Driver-owned consumption facts, independent of compiler/context imports.
# A copied record is not admission: consumers revalidate its bound snapshots.
struct AccessorConsumptionReceiptV1:
    epoch: i64
    module_identity: text
    source_snapshot: text
    hir_snapshot: text
    plan_digest: text
    advice_inventory_digest: text
    private_metadata_digest: text
