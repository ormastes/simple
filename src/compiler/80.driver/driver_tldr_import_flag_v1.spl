# Leaf flag owner: shared by phase routing and TLDR admission without pulling
# the summary producer or parser into the phase-gate dependency closure.
use std.nogc_sync_mut.io_runtime.{env_get_nullable}

pub fn tldr_imports_flag_on_v1(value: text) -> bool:
    value == "1"

var tldr_imports_memo_v1: i64 = -1

pub fn tldr_imports_memo_reset_v1():
    tldr_imports_memo_v1 = -1

pub fn tldr_imports_enabled_v1() -> bool:
    if tldr_imports_memo_v1 < 0:
        var on = false
        match env_get_nullable("SIMPLE_TLDR_IMPORTS"):
            case Some(v): on = tldr_imports_flag_on_v1(v)
            case nil: on = false
        tldr_imports_memo_v1 = if on: 1 else: 0
    tldr_imports_memo_v1 == 1

export tldr_imports_flag_on_v1, tldr_imports_memo_reset_v1, tldr_imports_enabled_v1
