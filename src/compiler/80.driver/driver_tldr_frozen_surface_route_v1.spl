# Policy and actual surface-parser work for the frozen TLDR production caller.
# Scheduling remains in the driver/shared TaskRunner. Actual parse counters
# live on CompilerDriver so independent contexts cannot overwrite each other.

pub fn tldr_frozen_surface_lane_error_v1(check_mode: bool, hir_worker: bool,
        parse_shard: bool, mir_scoped: bool, file_worker: bool,
        target_inventory: bool) -> text:
    if parse_shard:
        return "TLDR-IMPORTS-E-UNSUPPORTED-LANE: parse-cache shard needs full-source artifacts"
    if mir_scoped or file_worker:
        return "TLDR-IMPORTS-E-BODY-REQUIRED: native MIR/file worker needs admitted imported bodies"
    if target_inventory:
        return "TLDR-IMPORTS-E-CFG-RECEIPT: target inventory requires exact parse-source receipts"
    if not check_mode and not hir_worker:
        return "TLDR-IMPORTS-E-UNSUPPORTED-LANE: frozen Check or HIR surface worker required"
    ""

export tldr_frozen_surface_lane_error_v1
