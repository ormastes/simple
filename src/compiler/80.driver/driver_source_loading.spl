# Driver — Source Loading and Error Formatting
#
# Extracted from driver.spl. Contains:
# - Source file collection from paths/directories
# - Module name derivation from file paths
# - Structured error formatting helpers for type, borrow, coherence, and trait errors

use compiler.common.driver_core_types.{SourceFile, source_file_coverage_identity}
use compiler.common.module_path_naming.{module_logical_name_from_path}
use compiler.hir.hir_types.{Symbol}
use compiler.types.type_infer.*
use compiler.types.dim_constraints_types.{DimError}
use compiler.borrow.borrow_check.*
use compiler.borrow.borrow_check.nll.{NLLError, nllerror_format_related}
use compiler.core.interpreter.hashmap.{hm_hash_text}
use compiler.traits.trait_coherence.{CoherenceError}
use compiler.traits.trait_validation.{TraitError}

@unsafe(reason: "raw source-file read; empty text is the unreadable or empty sentinel", capabilities: [ffi])
extern fn rt_file_read_text(path: text) -> text
@unsafe(reason: "raw source-path probe; false includes absent, inaccessible, or provider failure", capabilities: [ffi])
extern fn rt_file_exists(path: text) -> bool
extern fn rt_env_get(key: text) -> text
extern fn rt_string_len(value: text) -> i64
extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)
extern fn rt_path_absolute(path: text) -> text
extern fn rt_dir_list(path: text) -> [text]

# Directories to skip during source collection
val _skip_dirs = ["test", "tests", "doc", "docs", "verification", "resources", "scripts", "build"]

fn _driver_source_trace_enabled() -> bool:
    (rt_env_get("SIMPLE_COMPILER_TRACE") ?? "") == "1"

# --- Entry-closure sub-step timing (default OFF) ------------------------------
# `[build] source_closure` is attributed to no sub-step, so a 96 s preamble in
# front of the first `[build] parse` line could only be blamed by guesswork.
# These counters split it into the three helpers the closure BFS actually calls
# per file: import extraction, import resolution, and source collection (which
# is where the file read lives). Gated by SIMPLE_NATIVE_BUILD_TRACE_CLOSURE_TIMING=1
# (the name already used by the 2026-07-31 closure investigation); with the env
# unset this costs one `rt_env_get` on the first call and two integer reads per
# call after that. A cumulative line is emitted every 64 collections so the
# trail survives a run that is killed mid-phase, which every probe of this
# phase has been.
var _g_closure_timing_enabled: bool = false
var _g_closure_timing_set: bool = false
var _g_closure_ms_imports: i64 = 0
var _g_closure_ms_resolve: i64 = 0
var _g_closure_ms_collect: i64 = 0
var _g_closure_n_imports: i64 = 0
var _g_closure_n_resolve: i64 = 0
var _g_closure_n_collect: i64 = 0

extern fn rt_time_now_monotonic_ms() -> i64

fn _driver_closure_timing_enabled() -> bool:
    if not _g_closure_timing_set:
        _g_closure_timing_enabled = (
            (rt_env_get("SIMPLE_NATIVE_BUILD_TRACE_CLOSURE_TIMING") ?? "") == "1")
        _g_closure_timing_set = true
    _g_closure_timing_enabled

pub fn driver_closure_timing_report() -> text:
    """Cumulative entry-closure sub-step costs (perf probe; empty when unused)."""
    if _g_closure_n_collect == 0 and _g_closure_n_imports == 0:
        return ""
    "[closure-timing] imports={_g_closure_ms_imports}ms/{_g_closure_n_imports} resolve={_g_closure_ms_resolve}ms/{_g_closure_n_resolve} collect={_g_closure_ms_collect}ms/{_g_closure_n_collect}"

fn _driver_text_index_of(value: text, needle: text) -> i64:
    if needle == "":
        return 0
    if not value.contains(needle):
        return -1
    rt_string_len(value.split(needle)[0])

pub fn _driver_should_skip_dir(name: text) -> bool:
    var i = 0
    while i < _skip_dirs.len():
        if name == _skip_dirs[i]:
            return true
        i = i + 1
    false

pub fn _driver_is_bootstrap_entry_source(path: text, module_name: text) -> bool:
    val native_entry = rt_env_get("SIMPLE_NATIVE_BUILD_ENTRY") ?? ""
    # Match the native-build entry by exact path or by tail segment, so a bare
    # or relative `--entry hello.spl` still matches the collected source path
    # `.../hello.spl` (and vice versa). Without this the entry module is stubbed
    # to an empty MirModule and `__simple_main` never gets emitted.
    if native_entry != "":
        # A caller-supplied --entry is authoritative: never also treat
        # bootstrap_main.spl (the historical default entry) as "an" entry
        # source. Bug #110 — with `--source src/app` (or any source root that
        # bulk-loads bootstrap_main.spl) and a distinct `--entry`, this used to
        # match BOTH files, so bootstrap_main.spl got fully parsed/lowered
        # alongside — and in some cases instead of — the requested entry,
        # silently building the wrong program. Only the exact/tail-matched
        # requested entry may qualify now.
        return path == native_entry or path.ends_with("/" + native_entry)
    path.ends_with("/app/cli/bootstrap_main.spl") or path == "./src/app/cli/bootstrap_main.spl" or module_name == "app.cli.bootstrap_main"

pub fn _driver_module_name_from_path(path: text) -> text:
    # Delegates to the single shared derivation in 00.common — see
    # module_path_naming.spl for history (this used to be one of four
    # hand-duplicated copies; a 70a29867bc2 drift between copies broke the
    # whole native-smoke-matrix 0/19).
    module_logical_name_from_path(path)

pub fn _driver_canonical_source_path(path: text) -> text:
    """Lexically normalize a source path for physical-file identity.
    Source discovery is repo-local, so resolving `.`/`..`, repeated separators,
    and Windows separators is sufficient without filesystem/symlink I/O."""
    val normalized = path.replace("\\", "/")
    val absolute = normalized.starts_with("/")
    var parts: [text] = []
    for part in normalized.split("/"):
        if part == "" or part == ".":
            continue
        if part == ".." and parts.len() > 0 and parts[parts.len() - 1] != "..":
            parts = parts[0:parts.len() - 1]
        elif part == ".." and not absolute:
            parts = parts.push(part)
        elif part != "..":
            parts = parts.push(part)
    val joined = parts.join("/")
    if absolute:
        "/" + joined
    else:
        joined

pub fn _driver_physical_source_key(path: text) -> text:
    """Return the platform-canonical source identity, with lexical fallback."""
    val physical = rt_path_absolute(path)
    _driver_canonical_source_path(if physical != "": physical else: path)

pub fn _driver_text_bucket_index(key: text, bucket_count: i64) -> i64:
    val raw = hm_hash_text(key) % bucket_count
    if raw < 0:
        raw + bucket_count
    else:
        raw

pub fn _driver_text_bucket_set_new(bucket_count: i64) -> Dict<text, bool>:
    """Create a compiled-Simple-safe exact text set.

    PERF (2026-08-21): this used to be `[text]` buckets holding newline-delimited
    keys, so `add` rebuilt a growing bucket STRING (`bucket + key + "\\n"`) and
    `has` ran `.contains()` over it. Both are O(bucket length), and the entry
    closure feeds thousands of keys through five of these sets, which is why
    `[build] source_closure` cost ~700 ms/file with no parsing in it at all.
    Measured on 4000 realistic keys (bench in the bug record): add 7644 ms ->
    84 ms, lookup 3997 ms -> 26 ms. Keys are source paths / module names, so
    exact-match Dict membership is identical in behaviour.

    `bucket_count` is kept as an accepted capacity hint so the ~30 existing call
    sites (all of which infer the type from this constructor) need no edit.
    Dict membership is tested with `contains_key`, never `.get()` — see
    doc/07_guide/language/dict_native_pitfalls.md."""
    val _ = bucket_count
    var set: Dict<text, bool> = {}
    set

pub fn _driver_text_bucket_set_has(buckets: Dict<text, bool>, key: text) -> bool:
    buckets.contains_key(key)

pub fn _driver_text_bucket_set_add(buckets: Dict<text, bool>, key: text) -> Dict<text, bool>:
    # Insert in place and hand the same Dict back; every call site is
    # `set = _driver_text_bucket_set_add(set, k)`, so the returned handle is the
    # only one that survives. Measured: this is the same cost as binding a fresh
    # `var` first (~1.0 s vs ~1.1 s over 4000 inserts) because the remaining
    # per-insert copy happens at the call boundary, not here — an inline
    # `d[k] = true` in the same benchmark is 26 ms. Collapsing these three
    # helpers into direct Dict operations at the call sites would recover that,
    # but those call sites live in driver_source_pipeline_loading.spl and
    # compile_targets.spl; left as a follow-up in the bug record.
    buckets[key] = true
    buckets

pub fn _driver_unique_physical_sources(sources: [SourceFile]) -> [SourceFile]:
    """Keep the first logical source for each normalized physical path.
    Logical aliases remain in the caller's source list for module registration;
    this list is only the phase-2 parse plan."""
    var unique: [SourceFile] = []
    var seen = _driver_text_bucket_set_new(512)
    for source in sources:
        val key = _driver_physical_source_key(source.path)
        if not _driver_text_bucket_set_has(seen, key):
            seen = _driver_text_bucket_set_add(seen, key)
            unique = unique.push(source)
    unique

pub fn _driver_module_name_collision(sources: [SourceFile]) -> text:
    """Return a deterministic diagnostic when distinct files normalize to one module."""
    var first_paths: Dict<text, text> = {}
    for source in sources:
        val path = _driver_canonical_source_path(source.path)
        # contains_key + index read, never `.get()`.
        # See doc/07_guide/language/dict_native_pitfalls.md
        if first_paths.contains_key(source.module_name):
            val first = first_paths[source.module_name]
            if first != path:
                val first_physical = _driver_canonical_source_path(rt_path_absolute(first))
                val path_physical = _driver_canonical_source_path(rt_path_absolute(path))
                if first_physical != path_physical:
                    return "native module name collision after path sanitization: '{first}' and '{path}' both map to '{source.module_name}'; rename one file or directory"
        else:
            first_paths[source.module_name] = path
    ""

fn _driver_entry_closure_mode() -> bool:
    """AMBIENT MODE FLAG — read at TWO independent sites that MUST agree.
    1. here (80.driver/driver_source_loading.spl), gating the canonical/alias
       branch of `_driver_module_aliases` for BOTH collectors
       (`_driver_collect_sources` AND `_driver_collect_entry_import_source`);
    2. `parse_all_impl` (80.driver/driver.spl, local `native_entry_closure`),
       which gates the phase-2 branch that collapses the aliases again with
       `entry_ctx.sources = _driver_unique_physical_sources(...)`.
    The extra alias spellings emitted here are kept out of Phase 3 ONLY by (2).
    Decoupling the two reads — e.g. turning this one into a call-site parameter
    without threading the same value into `parse_all_impl` — feeds every alias
    into lowering and reinstates the duplicate-HIR / duplicate-diagnostics
    regression that `driver.spl` documents at `entry_ctx.sources`. A third read
    in `driver.spl` (`nb_entry_closure`) suppresses the implicit whole-`src`
    bulk load in the same mode and must stay in agreement too."""
    (rt_env_get("SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE") ?? "") == "1"

fn _driver_module_name_segment_is_tier(seg: text) -> bool:
    """True for an all-digit dotted segment — the `10` in
    `compiler.10.frontend.core.lexer`, produced by the `src/compiler/NN.name`
    tier directories. An empty segment is NOT a tier (out-of-tree entries can
    produce a leading empty segment and must keep it)."""
    if seg.len() == 0:
        return false
    var i = 0
    while i < seg.len():
        val code = seg.char_code_at(i)
        if code < 48 or code > 57:
            return false
        i = i + 1
    true

pub fn _driver_canonical_module_name(module_name: text) -> text:
    """Fold every dotted spelling of ONE physical file onto a single name.
    Two rules, both derived from the symlink inventory in
    doc/09_report/symlink_module_spelling_sibling_audit_2026-07-27.md:
      1. drop all-digit (tier) segments — `compiler.10.frontend.core.x` and the
         `src/compiler/frontend -> 10.frontend` symlink spelling
         `compiler.frontend.core.x` both canonicalize to the latter;
      2. fold a leading `std.` to `lib.` — `src/std` is a symlink to `src/lib`.
    Verified collision-free: every physical `src/**/*.spl` canonicalizes to a
    distinct name (no two files share one canonical spelling)."""
    var segs: [text] = []
    for seg in module_name.split("."):
        if _driver_module_name_segment_is_tier(seg):
            continue
        segs = segs.push(seg)
    val canonical = segs.join(".")
    if canonical == "std":
        return "lib"
    if canonical.starts_with("std."):
        return "lib." + canonical.substring(4)
    canonical

fn _driver_module_name_from_repo_rel(rel: text) -> text:
    """Dotted module name for a path ALREADY relative to the repo root.
    `_driver_module_name_from_path` must not be used directly here: its `/src/`
    (and `/examples/`) substring search truncates everything before a NESTED
    source directory, so `examples/spostgre/src/tool/main.spl` collapses to the
    bare `tool.main` and `src/lib/gc_async_mut/src/aop.spl` to the
    single-segment `aop` — 75 files in this tree canonicalized to a
    single-segment name, which additionally trips the `self_segs.len() < 2`
    early return in `resolve_package_sibling_symbols`
    (20.hir/hir_lowering/_Items/module_lowering.spl). Only the ONE leading
    `src/` is a package root; every later `src` is an ordinary directory
    segment. Sanitization is still delegated to the four-copy
    `_driver_module_name_from_path`, but PER PATH SEGMENT, where a slash-free
    segment can never match `/src/` — so the character rules stay in one
    place."""
    var stripped = rel
    if stripped.starts_with("src/"):
        stripped = stripped.substring(4)
    var segs: [text] = []
    for seg in stripped.split("/"):
        if seg == "":
            continue
        val part = _driver_module_name_from_path(seg)
        if part == "":
            continue
        segs = segs.push(part)
    segs.join(".")

fn _driver_physical_module_name(path: text, fallback: text) -> text:
    """Module name derived from the SYMLINK-RESOLVED path.
    `_driver_module_name_from_path` is lexical, so a file reached through
    `src/compiler/frontend` and the same file reached through
    `src/compiler/10.frontend` get different names. `rt_path_absolute` is
    `realpath`, so it collapses the symlink; the result is re-relativized
    against the working directory (never by searching for `/src/`, which would
    mis-split when the checkout itself lives under a `.../src/...` directory).
    Falls back to the lexical name whenever the file cannot be proven to be a
    repo-relative `src/` or `examples/` source — out-of-tree entries keep their
    existing names."""
    val resolved = rt_path_absolute(path) ?? ""
    if resolved == "":
        return fallback
    val root = rt_path_absolute(".") ?? ""
    if root == "":
        return fallback
    if not resolved.starts_with(root + "/"):
        return fallback
    val rel = resolved.substring(root.len() + 1)
    if not rel.starts_with("src/") and not rel.starts_with("examples/"):
        return fallback
    _driver_module_name_from_repo_rel(rel)

fn _driver_push_unique_module_name(names: [text], name: text) -> [text]:
    """Append a spelling once. Alias lists are a handful of entries, so a linear
    scan is cheaper than a Dict (and `Dict.len()` returns -1 natively)."""
    if name == "":
        return names
    var i = 0
    while i < names.len():
        if names[i] == name:
            return names
        i = i + 1
    names.push(name)

pub fn _driver_module_aliases(path: text, content: text, module_name: text) -> [SourceFile]:
    """One physical file, one canonical module name, every other spelling an alias.
    ENTRY-CLOSURE ONLY. Symlinks (`src/compiler/frontend -> 10.frontend`,
    `src/std -> lib`, `src/app/lsp -> lib/nogc_sync_mut/lsp`, ...) mean the
    dotted name depends on which path the resolver walked — and that varies PER
    FILE, so two files in one directory could land under different package
    prefixes. `resolve_package_sibling_symbols`
    (20.hir/hir_lowering/_Items/module_lowering.spl) takes the *self* prefix
    from the walked path and looks siblings up by registry key, so a mismatch
    silently switches off directory-package semantics and every bare
    cross-file call in the package dies with "unresolved name" (~530 stage-4
    errors from `10.frontend/core` alone). Registering all spellings makes the
    lookup succeed whichever path either file was walked through.
    Additive only: the walked spelling is always kept, so existing `use` lines
    keep resolving; the canonical spelling is listed FIRST so
    `_driver_unique_physical_sources` (and therefore Phase 3 lowering) picks a
    name that no longer depends on discovery order.
    CORRECTION (this paragraph used to claim the opposite): the branch below is
    selected by the AMBIENT `_driver_entry_closure_mode()` flag, NOT by the call
    site, so the bulk collector `_driver_collect_sources` takes it too whenever
    the mode is on. That is safe only because the SAME flag makes
    `parse_all_impl` collapse aliases before Phase 3 — see the coupling note on
    `_driver_entry_closure_mode`. The legacy branches further down therefore
    apply only when the mode is off."""
    if _driver_entry_closure_mode():
        val physical = _driver_physical_module_name(path, module_name)
        val canonical = _driver_canonical_module_name(physical)
        var names: [text] = []
        names = _driver_push_unique_module_name(names, canonical)
        names = _driver_push_unique_module_name(names, module_name)
        names = _driver_push_unique_module_name(names, physical)
        names = _driver_push_unique_module_name(names, _driver_canonical_module_name(module_name))
        # `src/std -> lib`: a file actually walked THROUGH the symlink derives a
        # `std.*` spelling, and both twins must then exist so sibling lookup can
        # cross them. CONDITIONAL on this file really having a `std.` spelling
        # in play. Emitting the twin for every `lib.*` file instead grew the
        # whole-tree alias population 1.76x (12,795 -> 22,504 SourceFile
        # entries, 19,144 registry keys over 12,501 files) in a no-GC pipeline
        # with a documented 64 GB OOM history and a 24 GB stage-4
        # resource-monitor cap. It is not needed unconditionally: Phase 3 lowers
        # each file under its CANONICAL (`lib.`) name, so
        # `resolve_package_sibling_symbols` derives `self_name` in `lib.` space
        # and finds every sibling there; a `std.` key is only required to
        # satisfy a direct `use std....`, and the closure walk registers exactly
        # that spelling on demand. Same simulation, conditional: 15,974 entries
        # / 12,644 keys (1.25x over the pre-canonicalization 12,795).
        if canonical.starts_with("lib.") and (module_name.starts_with("std.") or physical.starts_with("std.")):
            names = _driver_push_unique_module_name(names, "std." + canonical.substring(4))
        # `compiler.core.*` is not a symlink spelling but a rewrite-table import
        # spelling (_driver_resolve_numbered_compiler_import maps it to
        # compiler/10.frontend/core), so the general rule cannot derive it.
        # This subsumes the former hand-written `compiler.10.frontend.core.*`
        # and `compiler.frontend.core.*` branches: both canonicalize here.
        if canonical.starts_with("compiler.frontend.core."):
            names = _driver_push_unique_module_name(names, "compiler.core." + canonical.substring("compiler.frontend.core.".len()))
        var closure_aliases: [SourceFile] = []
        for name in names:
            closure_aliases = closure_aliases.push(SourceFile(path: path, content: content, module_name: name))
        return closure_aliases
    # Entry-closure loading adds the requested import name after resolution.
    # Do not invent lib.* -> std.* aliases here: real src/std mirrors may own them.
    val (authored_path, source_content) = source_file_coverage_identity(path, content)
    var aliases: [SourceFile] = [SourceFile(path: path, authored_path: authored_path, content: source_content, module_name: module_name)]
    if module_name.starts_with("compiler.10.frontend.core."):
        val core_alias = "compiler.core." + module_name.substring("compiler.10.frontend.core.".len())
        aliases = aliases.push(SourceFile(path: path, authored_path: authored_path, content: source_content, module_name: core_alias))
    # Symlink spelling. src/compiler/frontend -> 10.frontend, so the SAME
    # directory can be discovered under either path, and dedup keeps whichever
    # spelling was walked first — per FILE. That left siblings with mismatched
    # package prefixes: lexer.spl registered only as compiler.frontend.core.lexer
    # while lexer_scanners.spl (same directory) registered as
    # compiler.10.frontend.core.lexer_scanners + compiler.core.lexer_scanners.
    # resolve_package_sibling_symbols matches on the package prefix, so the
    # directory-package semantics it implements silently stopped applying and
    # every bare sibling call died: lex_make_token (80 uses), lex_advance (58),
    # lex_peek (35), lex_pos_get (30) — ~530 stage-4 "unresolved name" errors.
    # Mirror the branch above so all three spellings exist for every file here.
    if module_name.starts_with("compiler.frontend.core."):
        val fc_rest = module_name.substring("compiler.frontend.core.".len())
        aliases = aliases.push(SourceFile(path: path, authored_path: authored_path, content: source_content, module_name: "compiler.10.frontend.core." + fc_rest))
        aliases = aliases.push(SourceFile(path: path, authored_path: authored_path, content: source_content, module_name: "compiler.core." + fc_rest))
    aliases

pub fn _driver_entry_import_dirname(path: text) -> text:
    """Directory part of a path ("" when the path has no directory)."""
    val parts = path.split("/")
    if parts.len() <= 1:
        return ""
    var dir = ""
    var i = 0
    while i < parts.len() - 1:
        if i > 0:
            dir = dir + "/"
        dir = dir + parts[i]
        i = i + 1
    dir

fn _driver_import_path_is_valid(path_text: text) -> bool:
    var i = 0
    while i < rt_string_len(path_text):
        val byte = path_text.char_code_at(i)
        if not ((byte >= 97 and byte <= 122) or (byte >= 65 and byte <= 90) or (byte >= 48 and byte <= 57) or byte == 95 or byte == 46):
            return false
        i = i + 1
    path_text != ""

fn _driver_entry_import_module_paths_text_fallback(content: text) -> [text]:
    # Whole-content early-out, mirroring the `mod `/`export ` gate in
    # _driver_entry_sibling_paths below: a file with no use/import keyword at all
    # cannot contribute, and one `contains` beats splitting it into lines.
    if not content.contains("use ") and not content.contains("import "):
        return []
    var result: [text] = []
    var in_doc = false
    for raw_line in content.split("\n"):
        # PERF (2026-08-21): fast reject before any comment/docstring work.
        # This body runs over every line of every file in the entry closure and
        # measured 46.7 ms per call -- 56.5 s of a 91 s `[build] source_closure`
        # phase, the single largest non-parse cost in a native build. Outside a
        # docstring the ONLY lines that can contribute are ones whose trimmed
        # form starts with a use/import keyword: comment stripping removes a
        # TRAILING part, so it can never turn a non-keyword line into one, and a
        # line that starts with `#` strips to empty. Every other line still needs
        # its triple-quote count, which is what the `contains` below preserves.
        val quick = raw_line.trim()
        if not in_doc and not quick.contains("\"\"\""):
            if not (quick.starts_with("use ") or quick.starts_with("pub use ") or
                    quick.starts_with("export use ") or quick.starts_with("import ")):
                continue
        var scan_line = raw_line
        if not in_doc:
            val comment_at = _driver_text_index_of(scan_line, "#")
            if comment_at >= 0:
                scan_line = scan_line[0:comment_at]
        var quote_count = 0
        if scan_line.contains("\"\"\""):
            quote_count = scan_line.split("\"\"\"").len() - 1
        val was_in_doc = in_doc
        if quote_count % 2 == 1:
            in_doc = not in_doc
        if was_in_doc or quote_count > 0:
            continue

        val line = scan_line.trim()
        var tail: text = ""
        if line.starts_with("pub use "):
            tail = line.substring(8)
        elif line.starts_with("export use "):
            tail = line.substring(11)
        elif line.starts_with("use "):
            tail = line.substring(4)
        elif line.starts_with("import "):
            tail = line.substring(7)
        else:
            continue

        # `lazy` modifier.
        #
        # DEFECT (fixed 2026-08-01, doc/08_tracking/bug/
        # selfhost_names_with_no_import_path_masked_by_seed_flat_resolution_2026-08-01.md
        # defect #1): this used to `continue` on ANY line starting `use lazy `.
        # That dropped the module from the entry closure entirely, so HIR
        # lowering's resolve_import_symbols found no module surface for it
        # (imported_key == "") and registered NOTHING -- every name in a
        # `use lazy M.{a, b}` came out `unresolved name`, e.g.
        # InterpreterBackendImpl from 80.driver/driver.spl:20 and
        # driver_types.spl:19. The import was present and correct; the closure
        # scan silently discarded its module.
        #
        # A NAMED lazy import (`M.{a, b}` or `M (a, b)`) states a STATIC name
        # dependency: the names must resolve, so the module has to be loaded.
        # Only the name-less forms -- `use lazy M`, `use lazy M.*`,
        # `use lazy M as alias` -- are dynamic-by-design and stay skipped. That
        # is exactly the form src/lib/nogc_async_mut/mcp/main_lazy.spl uses for
        # its 9 deferred tool modules (#LAZY-002 startup cost), so that
        # behaviour is preserved unchanged.
        #
        # The old prefix test also never matched `export use lazy `,
        # `pub use lazy ` or `import lazy `: those fell through to the plain
        # arms and collected the literal module path "lazy". Stripping the
        # modifier after the use/import prefix fixes that whole family too.
        var lazy_import = false
        if tail.starts_with("lazy "):
            lazy_import = true
            tail = tail.substring(5).trim()
        val has_named_list: bool = tail.contains("{") or tail.contains("(")
        if lazy_import and not has_named_list:
            continue

        var cut: i64 = rt_string_len(tail)
        for delimiter in [" ", "{", "(", "*", "#"]:
            val delimiter_at = _driver_text_index_of(tail, delimiter)
            if delimiter_at >= 0 and delimiter_at < cut:
                cut = delimiter_at
        var module_path = tail[0:cut]
        while module_path.ends_with("."):
            module_path = module_path[0:module_path.len() - 1]
        if _driver_import_path_is_valid(module_path):
            result = result.push(module_path)
    result

pub fn _driver_entry_import_module_paths(content: text) -> [text]:
    """Dotted module paths of the use/pub-use/export-use/import declarations in a
    source text. Name-less `use lazy` imports (`use lazy M`, `use lazy M.*`,
    `use lazy M as a`) are dynamic-by-design and skipped; NAMED lazy imports
    (`use lazy M.{a, b}`) declare static names that must resolve, so their
    module is collected like any other -- see the comment in the text fallback.
    Docstring bodies are skipped via a triple-quote toggle.
    PERF (doc/08_tracking/bug/native_build_entry_closure_slow_2026-07-31.md):
    this used to memoize by the full content string in a process-local
    Dict<text, [text]>. Every caller (the --entry-closure BFS in
    compile_targets.spl, and the phase1:load_sources closure scan in
    driver_source_pipeline_loading.spl) already dedups by file path before
    calling here, so each distinct content string is looked up at most once
    per call site -- the cache measurably never hit on the profiled BFS path
    (confirmed via SIMPLE_NATIVE_BUILD_TRACE_CLOSURE_TIMING), leaving only
    the cost of hashing the whole (up to 64 KB+) content string twice
    (contains_key + insert) on every call, scaling with file size for zero
    payoff. Dropped rather than rekeyed: the only way to key it cheaply
    (by path) would require every caller to pass a path, but
    _driver_entry_import_module_paths(content) is a fixed single-arg call
    form exercised directly (content-only, no backing file) by
    test/01_unit/compiler/bootstrap/entry_closure_physical_source_dedup_spec.spl
    and test/01_unit/compiler/driver/native_entry_closure_gate_source_spec.spl."""
    if not _driver_closure_timing_enabled():
        return _driver_entry_import_module_paths_text_fallback(content)
    val t0 = rt_time_now_monotonic_ms()
    val out = _driver_entry_import_module_paths_text_fallback(content)
    _g_closure_ms_imports = _g_closure_ms_imports + (rt_time_now_monotonic_ms() - t0)
    _g_closure_n_imports = _g_closure_n_imports + 1
    out

fn _driver_entry_sibling_path(line: text) -> text:
    if line.starts_with("mod "):
        val tail = line.substring(4).trim()
        if tail == "" or tail.contains(" ") or tail.contains(","):
            return ""
        val parts = tail.split(".")
        val last = parts[parts.len() - 1]
        if last != "":
            return "." + last
        return ""
    if line.starts_with("export ") and not line.starts_with("export use ") and line.ends_with(".*"):
        val tail = line.substring(7)
        val base = tail[0:tail.len() - 2].trim()
        if base != "" and not base.contains(" ") and not base.contains(","):
            return "." + base
    ""

pub fn _driver_entry_sibling_module_paths(content: text) -> [text]:
    """Relative sibling paths from top-level `mod` and `export member.*`
    declarations. This rare compatibility syntax uses the allocation-based
    scan only when a source can contain such a declaration."""
    if not content.contains("mod ") and not content.contains("export "):
        return []
    var result: [text] = []
    var in_doc = false
    for raw_line in content.split("\n"):
        var scan_line = raw_line
        if not in_doc:
            val comment_at = _driver_text_index_of(scan_line, "#")
            if comment_at >= 0:
                scan_line = scan_line[0:comment_at]
        var quote_count = 0
        if scan_line.contains("\"\"\""):
            quote_count = scan_line.split("\"\"\"").len() - 1
        val was_in_doc = in_doc
        if quote_count % 2 == 1:
            in_doc = not in_doc
        if was_in_doc or quote_count > 0:
            continue
        val sibling = _driver_entry_sibling_path(scan_line.trim())
        if sibling != "":
            result = result.push(sibling)
    result

fn _driver_numbered_child_dir(parent: text, segment: text) -> text:
    if parent == "":
        return ""
    var parent_exists = false
    unsafe(capabilities: [ffi]):
        parent_exists = rt_file_exists(parent)
    if not parent_exists:
        return ""
    for entry in rt_dir_list(parent):
        var prefix_len = 0
        val entry_len = entry.len()
        while prefix_len < entry_len and prefix_len < 3:
            val code = entry.char_code_at(prefix_len)
            if code < 48 or code > 57:
                break
            prefix_len = prefix_len + 1
        if prefix_len >= 1 and prefix_len <= 3 and prefix_len < entry_len and entry.char_at(prefix_len) == "." and entry.substring(prefix_len + 1) == segment:
            val candidate = parent + "/" + entry
            var candidate_exists = false
            unsafe(capabilities: [ffi]):
                candidate_exists = rt_file_exists(candidate)
            if candidate_exists:
                return candidate
    ""

fn _driver_try_numbered_entry_import_rel(root: text, rel: text) -> text:
    val parts = rel.split("/")
    if parts.len() == 0:
        return ""
    var current = root
    var i = 0
    while i + 1 < parts.len():
        val direct = if current == "": parts[i] else: current + "/" + parts[i]
        var direct_exists = false
        unsafe(capabilities: [ffi]):
            direct_exists = rt_file_exists(direct)
        if direct_exists:
            current = direct
        else:
            val numbered = _driver_numbered_child_dir(current, parts[i])
            if numbered == "":
                return ""
            current = numbered
        i = i + 1
    val base = if current == "": parts[parts.len() - 1] else: current + "/" + parts[parts.len() - 1]
    val spl_path = base + ".spl"
    var spl_exists = false
    unsafe(capabilities: [ffi]):
        spl_exists = rt_file_exists(spl_path)
    if spl_exists:
        return spl_path
    val mod_path = base + "/mod.spl"
    var mod_exists = false
    unsafe(capabilities: [ffi]):
        mod_exists = rt_file_exists(mod_path)
    if mod_exists:
        return mod_path
    val init_path = base + "/__init__.spl"
    var init_exists = false
    unsafe(capabilities: [ffi]):
        init_exists = rt_file_exists(init_path)
    if init_exists:
        return init_path
    ""

fn _driver_try_entry_import_rel(rel: text, entry_dir: text) -> text:
    var roots: [text] = ["", "src/"]
    if entry_dir != "":
        roots = roots.push(entry_dir + "/")
    for root in roots:
        val base = root + rel
        val spl_path = base + ".spl"
        var spl_exists = false
        unsafe(capabilities: [ffi]):
            spl_exists = rt_file_exists(spl_path)
        if spl_exists:
            return spl_path
        val mod_path = base + "/mod.spl"
        var mod_exists = false
        unsafe(capabilities: [ffi]):
            mod_exists = rt_file_exists(mod_path)
        if mod_exists:
            return mod_path
        val init_path = base + "/__init__.spl"
        var init_exists = false
        unsafe(capabilities: [ffi]):
            init_exists = rt_file_exists(init_path)
        if init_exists:
            return init_path
    # Resolver-transparent `NN.name` directories are a fallback only: ordinary
    # imports keep the existing fixed probes and pay no directory-list cost.
    for root in roots:
        val normalized_root = if root.ends_with("/"): root[0:root.len() - 1] else: root
        val numbered = _driver_try_numbered_entry_import_rel(normalized_root, rel)
        if numbered != "":
            return numbered
    ""

fn _driver_resolve_rewritten_import(module_path: text, prefix: text, rel_prefix: text, entry_dir: text) -> text:
    if module_path != prefix and not module_path.starts_with(prefix + "."):
        return ""
    var rel = rel_prefix
    if module_path.len() > prefix.len():
        rel = rel + "/" + module_path.substring(prefix.len() + 1).replace(".", "/")
    _driver_try_entry_import_rel(rel, entry_dir)

fn _driver_entry_import_parent(module_path: text) -> text:
    # Preserve the leading-dot relative-import marker and remove only a real
    # dotted path segment. `..backend_types.CompiledUnit` becomes
    # `..backend_types`, while `..backend_types` has no further parent.
    var leading = 0
    while leading < module_path.len() and module_path.substring(leading, leading + 1) == ".":
        leading = leading + 1
    var last = -1
    var i = leading
    while i < module_path.len():
        if module_path.substring(i, i + 1) == ".":
            last = i
        i = i + 1
    if last < 0:
        return ""
    module_path[0:last]

fn _driver_resolve_relative_entry_import(module_path: text, entry_dir: text) -> text:
    if not module_path.starts_with("."):
        return ""
    var dots = 0
    while dots < module_path.len() and module_path.substring(dots, dots + 1) == ".":
        dots = dots + 1
    if dots >= module_path.len():
        return ""
    var base_dir = entry_dir
    var up = 1
    while up < dots:
        base_dir = _driver_entry_import_dirname(base_dir)
        up = up + 1
    val rel = module_path.substring(dots).replace(".", "/")
    _driver_try_entry_import_rel(rel, base_dir)

fn _driver_resolve_numbered_compiler_import(module_path: text, entry_dir: text) -> text:
    # Compiler imports dominate Stage4's entry closure. Resolve their canonical
    # numbered layout before probing every generic stdlib family.
    # The exact compatibility facade is intentionally owned by src/lib.
    # PERF NOTE (doc/08_tracking/bug/native_build_entry_closure_slow_2026-07-31.md):
    # measured via a temporary rt_file_exists probe counter that this
    # function is a complete no-op (0 probes, `is_numbered` always false)
    # when called from the --entry-closure BFS in compile_targets.spl
    # (_native_build_entry_closure -> _nb_resolve_segs -> _driver_resolve_entry_import).
    # That caller builds module_path via `_nb_join_segments` (slash-joined,
    # e.g. "compiler/driver/foo"), never the dotted form ("compiler.driver.foo")
    # this function's `is_numbered` gate checks for -- so the up-to-18-candidate
    # cascade below never runs a single rt_file_exists on that path; the BFS's
    # numbered-directory resolution actually happens earlier, in
    # _nb_resolve_under_root via _nb_resolve_segs's own fallback loop. This
    # function is real (and does pay the full candidate-then-rt_file_exists
    # cost) only for dotted-module_path callers elsewhere in the driver, e.g.
    # the phase1:load_sources closure scan in driver_source_pipeline_loading.spl.
    # Confirmed with 31/31 sampled BFS calls at 0 probes; not the BFS bottleneck.
    if module_path == "compiler.mir_opt":
        return ""
    val is_numbered = module_path.starts_with("compiler.") or module_path == "monomorphize" or module_path.starts_with("monomorphize.") or module_path == "linker" or module_path.starts_with("linker.")
    if not is_numbered:
        return ""
    var mapped = _driver_resolve_rewritten_import(module_path, "compiler.common", "compiler/00.common", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "compiler.core", "compiler/10.frontend/core", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "compiler.frontend", "compiler/10.frontend", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "compiler.blocks", "compiler/15.blocks/blocks", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "compiler.hir", "compiler/20.hir", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "compiler.traits", "compiler/25.traits", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "compiler.types", "compiler/30.types", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "compiler.semantics", "compiler/35.semantics", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "compiler.monomorphize", "compiler/40.mono/monomorphize", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "monomorphize", "compiler/40.mono/monomorphize", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "compiler.mir", "compiler/50.mir", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "compiler.borrow", "compiler/55.borrow", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "compiler.mir_opt", "compiler/60.mir_opt/mir_opt", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "compiler.backend", "compiler/70.backend", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "compiler.driver", "compiler/80.driver", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "compiler.shb", "compiler/80.driver/shb", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "compiler.interpreter", "compiler/95.interp/interpreter", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "linker", "compiler/70.backend/linker", entry_dir)
    if mapped != "":
        return mapped
    _driver_resolve_rewritten_import(module_path, "compiler.backend", "compiler/70.backend/backend", entry_dir)

fn _driver_resolve_entry_import_exact(module_path: text, entry_dir: text) -> text:
    val relative = _driver_resolve_relative_entry_import(module_path, entry_dir)
    if relative != "":
        return relative

    val rel = module_path.replace(".", "/")
    val direct = _driver_try_entry_import_rel(rel, entry_dir)
    if direct != "":
        return direct

    val numbered_compiler = _driver_resolve_numbered_compiler_import(module_path, entry_dir)
    if numbered_compiler != "":
        return numbered_compiler

    if not module_path.starts_with("std."):
        val lib_base = "src/lib/" + rel
        val lib_spl_path = lib_base + ".spl"
        var lib_spl_exists = false
        unsafe(capabilities: [ffi]):
            lib_spl_exists = rt_file_exists(lib_spl_path)
        if lib_spl_exists:
            return lib_spl_path
        val lib_mod_path = lib_base + "/mod.spl"
        var lib_mod_exists = false
        unsafe(capabilities: [ffi]):
            lib_mod_exists = rt_file_exists(lib_mod_path)
        if lib_mod_exists:
            return lib_mod_path
        val lib_init_path = lib_base + "/__init__.spl"
        var lib_init_exists = false
        unsafe(capabilities: [ffi]):
            lib_init_exists = rt_file_exists(lib_init_path)
        if lib_init_exists:
            return lib_init_path
        for family in ["nogc_async_mut", "nogc_async_immut", "nogc_sync_immut", "nogc_sync_mut", "common", "gc_async_mut", "gc_async_immut", "gc_sync_mut", "gc_sync_immut", "nogc_async_mut_noalloc"]:
            val family_base = "src/lib/" + family + "/" + rel
            val family_spl_path = family_base + ".spl"
            var family_spl_exists = false
            unsafe(capabilities: [ffi]):
                family_spl_exists = rt_file_exists(family_spl_path)
            if family_spl_exists:
                return family_spl_path
            val family_mod_path = family_base + "/mod.spl"
            var family_mod_exists = false
            unsafe(capabilities: [ffi]):
                family_mod_exists = rt_file_exists(family_mod_path)
            if family_mod_exists:
                return family_mod_path
            val family_init_path = family_base + "/__init__.spl"
            var family_init_exists = false
            unsafe(capabilities: [ffi]):
                family_init_exists = rt_file_exists(family_init_path)
            if family_init_exists:
                return family_init_path
    if module_path.starts_with("std."):
        val lib_base = "src/lib/" + rel.substring(4)
        val lib_spl_path = lib_base + ".spl"
        var lib_spl_exists = false
        unsafe(capabilities: [ffi]):
            lib_spl_exists = rt_file_exists(lib_spl_path)
        if lib_spl_exists:
            return lib_spl_path
        val lib_mod_path = lib_base + "/mod.spl"
        var lib_mod_exists = false
        unsafe(capabilities: [ffi]):
            lib_mod_exists = rt_file_exists(lib_mod_path)
        if lib_mod_exists:
            return lib_mod_path
        val lib_init_path = lib_base + "/__init__.spl"
        var lib_init_exists = false
        unsafe(capabilities: [ffi]):
            lib_init_exists = rt_file_exists(lib_init_path)
        if lib_init_exists:
            return lib_init_path
        val lib_subpath = rel.substring(4)
        for family in ["nogc_async_mut", "nogc_async_immut", "nogc_sync_immut", "nogc_sync_mut", "common", "gc_async_mut", "gc_async_immut", "gc_sync_mut", "gc_sync_immut", "nogc_async_mut_noalloc"]:
            val family_base = "src/lib/" + family + "/" + lib_subpath
            val family_spl_path = family_base + ".spl"
            var family_spl_exists = false
            unsafe(capabilities: [ffi]):
                family_spl_exists = rt_file_exists(family_spl_path)
            if family_spl_exists:
                return family_spl_path
            val family_mod_path = family_base + "/mod.spl"
            var family_mod_exists = false
            unsafe(capabilities: [ffi]):
                family_mod_exists = rt_file_exists(family_mod_path)
            if family_mod_exists:
                return family_mod_path
            val family_init_path = family_base + "/__init__.spl"
            var family_init_exists = false
            unsafe(capabilities: [ffi]):
                family_init_exists = rt_file_exists(family_init_path)
            if family_init_exists:
                return family_init_path

    # Non-compiler application/tool rewrites retain generic library precedence.
    #
    # Every dot-named directory directly under src/app (e.g. `ui.web/`,
    # `dashboard.render/`) needs its own entry here. Without one, a dotted
    # `use app.ui.web.html.{...}` import falls through
    # _driver_resolve_entry_import's "strip trailing dotted segment" fallback
    # all the way to an ancestor package __init__.spl (e.g. src/app/ui/__init__.spl
    # or src/app/__init__.spl, both of which exist as real packages). That
    # produces a bogus SourceFile alias — same module_name as the real
    # dot-dir file, different physical path — which
    # _driver_module_name_collision then reports as
    # "native module name collision after path sanitization". See
    # doc/08_tracking/bug/dot_dir_entry_import_fallback_collision_2026-07-24.md.
    var mapped = _driver_resolve_rewritten_import(module_path, "app.ui.browser", "app/ui.browser", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "app.ui.render", "app/ui.render", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "app.ui.chromium.acid2", "app/ui.chromium.acid2", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "app.ui.chromium.devtools", "app/ui.chromium.devtools", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "app.ui.chromium", "app/ui.chromium", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "app.ui.cli", "app/ui.cli", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "app.ui.electron", "app/ui.electron", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "app.ui.ipc", "app/ui.ipc", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "app.ui.mcp", "app/ui.mcp", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "app.ui.none", "app/ui.none", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "app.ui.standalone", "app/ui.standalone", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "app.ui.tauri", "app/ui.tauri", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "app.ui.test_api", "app/ui.test_api", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "app.ui.tui_web", "app/ui.tui_web", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "app.ui.tui", "app/ui.tui", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "app.ui.vscode", "app/ui.vscode", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "app.ui.web", "app/ui.web", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "app.dashboard.render", "app/dashboard.render", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "app.dashboard.views", "app/dashboard.views", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "app.ffi_gen.specs", "app/ffi_gen.specs", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "app.ffi_gen.templates", "app/ffi_gen.templates", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "app.sffi_gen.templates", "app/sffi_gen.templates", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "app.game.breakout", "app/game.breakout", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "app.game.rollball", "app/game.rollball", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "app.package.registry", "app/package.registry", entry_dir)
    if mapped != "":
        return mapped
    mapped = _driver_resolve_rewritten_import(module_path, "cmm_lsp", "examples/10_tooling/trace32_tools/cmm_lsp", entry_dir)
    if mapped != "":
        return mapped
    ""

pub fn _driver_resolve_entry_import(module_path: text, entry_dir: text) -> text:
    """File path backing a Simple import path, or "" when none exists.
    Exact modules are preferred. Dotted terminal names are then removed one at
    a time because Simple permits `use module.function` as a glob-style import
    of the containing source module."""
    if not _driver_closure_timing_enabled():
        return _driver_resolve_entry_import_untimed(module_path, entry_dir)
    val t0 = rt_time_now_monotonic_ms()
    val out = _driver_resolve_entry_import_untimed(module_path, entry_dir)
    _g_closure_ms_resolve = _g_closure_ms_resolve + (rt_time_now_monotonic_ms() - t0)
    _g_closure_n_resolve = _g_closure_n_resolve + 1
    out

fn _driver_resolve_entry_import_untimed(module_path: text, entry_dir: text) -> text:
    var probe = module_path
    while probe != "":
        val resolved = _driver_resolve_entry_import_exact(probe, entry_dir)
        if resolved != "":
            return resolved
        probe = _driver_entry_import_parent(probe)
    ""

pub fn _driver_collect_entry_import_source(p: text) -> [SourceFile]:
    """Load one explicitly resolved closure import.
    Bulk collection exclusions must not hide a file named `check.spl` or an
    imported async lowering module. Test, fixture, doc, and verification trees
    remain excluded from production closure builds."""
    if not _driver_closure_timing_enabled():
        return _driver_collect_entry_import_source_untimed(p)
    val t0 = rt_time_now_monotonic_ms()
    val out = _driver_collect_entry_import_source_untimed(p)
    _g_closure_ms_collect = _g_closure_ms_collect + (rt_time_now_monotonic_ms() - t0)
    _g_closure_n_collect = _g_closure_n_collect + 1
    if _g_closure_n_collect % 64 == 0:
        print driver_closure_timing_report()
    out

fn _driver_collect_entry_import_source_untimed(p: text) -> [SourceFile]:
    var result: [SourceFile] = []
    if not p.ends_with(".spl"):
        return result
    val normalized = p.replace("\\", "/")
    val is_source_tree = normalized.starts_with("src/") or normalized.contains("/src/")
    # `/doc/` is not sufficient evidence of repository documentation:
    # `src/app/doc/**` is a real production namespace (for example
    # app.doc.public_check.statistics) and may be in a CLI entry closure.
    # Keep excluding the repository-level documentation tree, including when
    # the resolved path is absolute, but never classify a path below `src/` as
    # documentation merely because one of its module segments is named doc.
    val is_repository_doc = not is_source_tree and (
        normalized.starts_with("doc/") or normalized.contains("/doc/"))
    if normalized.contains("/test/") or normalized.contains("/tests/") or normalized.contains("/testdata/") or is_repository_doc or normalized.contains("/verification/"):
        return result
    var content = ""
    unsafe(capabilities: [ffi]):
        content = rt_file_read_text(p) ?? ""
    if content == "":
        return result
    _driver_module_aliases(p, content, _driver_module_name_from_path(p))

fn _driver_is_filtered_test_helper_path(path: text) -> bool:
    val normalized = path.replace("\\", "/")
    normalized.contains("/test_") and not (
        normalized == "src/app/cli/test_entry.spl" or normalized.ends_with("/src/app/cli/test_entry.spl")
    )

pub fn _driver_collect_sources(p: text) -> [SourceFile]:
    """Collect source files from a path (file or directory). Returns list of SourceFile."""
    var result: [SourceFile] = []
    if _driver_source_trace_enabled():
        print "[collect_sources] path {p}"
    if p.ends_with(".spl"):
        if _driver_source_trace_enabled():
            print "[collect_sources] file {p}"
        # It's a source file
        if p.ends_with("/check.spl") or p.ends_with("\\check.spl"):
            return result
        if p.ends_with("/20.hir/hir_lowering/__init__.spl") or p.ends_with("\\20.hir\\hir_lowering\\__init__.spl"):
            return result
        if p.contains("/test/") or p.contains("/tests/") or p.contains("/testdata/") or p.contains("/doc/") or p.contains("/verification/"):
            return result
        if p.contains("/core/interpreter/") or p.contains("/10.frontend/parser/") or p.contains("/10.frontend/treesitter") or p.contains("/hir_lowering/async"):
            return result
        if p.contains("/10.frontend/core/"):
            val core_allowed = p.contains("/lexer") or p.contains("/parser") or p.contains("/ast") or p.contains("/tokens")
            val core_allowed2 = core_allowed or p.contains("/types") or p.contains("/backend_types") or p.contains("/error") or p.contains("/frontend")
            val core_allowed3 = core_allowed2 or p.ends_with("/__init__.spl")
            if not core_allowed3:
                return result
        var content = ""
        unsafe(capabilities: [ffi]):
            content = rt_file_read_text(p) ?? ""
        if _driver_source_trace_enabled():
            print "[collect_sources] content_len {content.len()}"
        if content != "":
            val module_name = _driver_module_name_from_path(p)
            val aliases = _driver_module_aliases(p, content, module_name)
            if _driver_source_trace_enabled():
                print "[collect_sources] file_result {aliases.len()}"
            return aliases
    else:
        if _driver_source_trace_enabled():
            print "[collect_sources] dir {p}"
        # Use find for directory roots. The generated bootstrap compiler corrupts
        # some static arrays used by the old recursive walker.
        val cmd = "find {p} -type f -name '*.spl' 2>/dev/null"
        val (stdout, _, code) = rt_process_run("sh", ["-c", cmd])
        if _driver_source_trace_enabled():
            print "[collect_sources] find_code {code} stdout_len {stdout.len()}"
        if code != 0 or stdout == "":
            return result
        val lines = stdout.split("\n")
        for line in lines:
            val path = line.trim()
            if path == "":
                continue
            if path.contains("/test/") or path.contains("/tests/") or path.contains("/testdata/") or path.contains("/doc/") or path.contains("/verification/"):
                continue
            if _driver_is_filtered_test_helper_path(path) or path.contains("/core/interpreter/") or path.contains("/10.frontend/parser/") or path.contains("/10.frontend/treesitter") or path.contains("/hir_lowering/async"):
                continue
            if path.contains("/10.frontend/core/"):
                val core_allowed = path.contains("/lexer") or path.contains("/parser") or path.contains("/ast") or path.contains("/tokens")
                val core_allowed2 = core_allowed or path.contains("/types") or path.contains("/backend_types") or path.contains("/error") or path.contains("/frontend")
                val core_allowed3 = core_allowed2 or path.ends_with("/__init__.spl")
                if not core_allowed3:
                    continue
            val loaded = _driver_collect_sources(path)
            for s in loaded:
                result = result.push(s)
    result

pub fn _driver_collect_sources_via_find(paths: [text]) -> [SourceFile]:
    var result: [SourceFile] = []
    for path in paths:
        val loaded = _driver_collect_sources(path)
        for s in loaded:
            result = result.push(s)
    result

# ------------------------------------------------------------------------------
# Structured Error Formatting Helpers
# ------------------------------------------------------------------------------
# Errors are encoded as: "line:col: message" with optional related info
# appended as "|||RELATED:line:col:message" segments and optional help
# appended as "|||HELP:message".

pub fn _format_type_infer_error(err: TypeInferError) -> text:
    """Format a TypeInferError into a structured error string with related info."""
    val span = err.span()
    val msg = err.message()
    var result = "{span.line}:{span.col}: {msg}"
    # Add related information based on error variant
    match err:
        case TypeInferError.Mismatch(expected, found, s):
            if expected.span.line > 0:
                result = result + "|||RELATED:{expected.span.line}:{expected.span.col}:expected type defined here"
            if found.span.line > 0 and found.span.line != s.line:
                result = result + "|||RELATED:{found.span.line}:{found.span.col}:found type originates here"
        case TypeInferError.OccursCheck(var_id, ty, s):
            if ty.span.line > 0:
                result = result + "|||RELATED:{ty.span.line}:{ty.span.col}:recursive type reference here"
            result = result + "|||HELP:break the recursive type by using an explicit type annotation"
        case TypeInferError.TraitNotImplemented(ty, trait_name, s):
            if ty.span.line > 0:
                result = result + "|||RELATED:{ty.span.line}:{ty.span.col}:type that needs to implement '{trait_name}'"
            result = result + "|||HELP:add an impl block: impl {trait_name} for {ty.kind}"
        case TypeInferError.DimensionError(dim_err):
            val de: DimError = dim_err
            for note in de.notes:
                match note.span:
                    case Some(note_span):
                        result = result + "|||RELATED:{note_span.line}:{note_span.col}:{note.message}"
                    case nil:
                        pass
            match de.help:
                case Some(help):
                    result = result + "|||HELP:{help}"
                case nil:
                    pass
        case TypeInferError.Undefined(name, s):
            result = result + "|||HELP:check spelling or add an import for '{name}'"
        case TypeInferError.Other(message, s):
            pass_do_nothing
    result

pub fn _format_nll_error(err: NLLError) -> text:
    """Format an NLLError into a structured error string with related info."""
    val primary = if err.has_primary_span: err.primary_span else: 0
    var result = "{primary}:1: {err.message}"
    result = result + nllerror_format_related(err)
    if err.has_help:
        result = result + "|||HELP:{err.help}"
    result

pub fn _format_coherence_error(err: CoherenceError) -> text:
    """Format a CoherenceError into a structured error string."""
    val msg = err.message()
    "1:1: {msg}"

pub fn _format_trait_error(err: TraitError) -> text:
    """Format a TraitError into a structured error string with related info."""
    val span = err.span()
    val msg = err.message()
    var result = "{span.line}:{span.col}: {msg}"
    match err:
        case TraitError.MissingMethod(trait_, method, ty, s):
            result = result + "|||HELP:add method '{method}' to the impl block"
        case TraitError.UndefinedTrait(name, s):
            result = result + "|||HELP:check spelling or add an import for the trait"
        case TraitError.Unsatisfied(obligation):
            if obligation.span.line > 0:
                result = result + "|||RELATED:{obligation.span.line}:{obligation.span.col}:required by this bound"
        case TraitError.MissingAssocType(trait_, assoc_name, ty, s):
            result = result + "|||HELP:add 'type {assoc_name} = ...' to the impl block"
        case TraitError.AssocTypeMismatch(trait_, assoc_name, expected, actual, s):
            if expected.span.line > 0:
                result = result + "|||RELATED:{expected.span.line}:{expected.span.col}:expected type defined here"
            if actual.span.line > 0:
                result = result + "|||RELATED:{actual.span.line}:{actual.span.col}:actual type found here"
        case _:
            pass_do_nothing
    result
