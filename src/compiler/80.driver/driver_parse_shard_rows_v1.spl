# Parse shards warm physical files, while the retained inventory also carries
# logical alias rows. Choose authoritative rows before rotating or claiming:
# the first row for each canonical physical path owns its canonical admission.

# @allow(primitive_api) Compiler inventory boundary: rotation offsets and returned indices address the driver's original parallel source arrays using their native i64 index ABI.
pub fn driver_parse_shard_row_plan_v1(canonical_paths: [text], start: i64) -> [i64]:
    """Original inventory indices in rotated order, one first row per path.
    Alias rows stay in the inventory for ordinary surface alias admission;
    they never become fresh canonical admissions in a parse-cache shard."""
    if canonical_paths.len() == 0: return []
    var seen: Dict<text, bool> = {}
    var authoritative: [bool] = []
    for path in canonical_paths:
        val first = not seen.contains_key(path)
        authoritative.push(first)
        if first: seen[path] = true
    val first_index = if start >= 0: start % canonical_paths.len() else: 0
    var plan: [i64] = []
    var step: i64 = 0
    while step < canonical_paths.len():
        val index = (first_index + step) % canonical_paths.len()
        if authoritative[index]: plan.push(index)
        step = step + 1
    plan
