# Typed VHDL output boundary. The kernel owns dispatch; a selected composition
# installs the plugin implementation before any VHDL compilation.
use compiler.driver.driver_compiler_type.{CompilerDriver}
use compiler.common.driver_core_types.{CompileResult}

pub struct VhdlDriverOutputPortV1:
    name: text
    run_fn: fn(CompilerDriver, text) -> CompileResult

var _vhdl_driver_output_ports_v1: [VhdlDriverOutputPortV1] = []

pub fn install_vhdl_driver_output_port_v1(port: VhdlDriverOutputPortV1) -> bool:
    if port.name != "vhdl":
        return false
    if _vhdl_driver_output_ports_v1.len() != 0:
        return _vhdl_driver_output_ports_v1[0].name == port.name
    _vhdl_driver_output_ports_v1.push(port)
    true

pub fn vhdl_driver_output_dispatch_v1(
    ports: [VhdlDriverOutputPortV1], driver: CompilerDriver, output: text
) -> CompileResult:
    if ports.len() != 1 or ports[0].name != "vhdl":
        return CompileResult.CodegenError(
            "PLUG-E-NOTFOUND: VHDL output plugin is not installed")
    ports[0].run_fn(driver, output)

impl CompilerDriver:
    me compile_to_vhdl(output: text) -> CompileResult:
        vhdl_driver_output_dispatch_v1(_vhdl_driver_output_ports_v1, self, output)
