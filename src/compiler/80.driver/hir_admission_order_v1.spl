"""Stable physical-source order for post-HIR ownership admission.

The caller canonicalizes each path once. Sorting only indices retains equal
paths in their original order and never copies the HIR module payloads.
"""

pub fn hir_admission_path_order_v1(paths: [text]) -> [i64]:
    val count = paths.len()
    var order: [i64] = []
    var scratch: [i64] = []
    var index = 0
    while index < count:
        order.push(index)
        scratch.push(0)
        index = index + 1
    var width = 1
    while width < count:
        var start = 0
        while start < count:
            val middle = if width > count - start: count else: start + width
            val end = if width > count - middle: count else: middle + width
            var left = start
            var right = middle
            var output = start
            while left < middle and right < end:
                if paths[order[right]] < paths[order[left]]:
                    scratch[output] = order[right]
                    right = right + 1
                else:
                    scratch[output] = order[left]
                    left = left + 1
                output = output + 1
            while left < middle:
                scratch[output] = order[left]
                left = left + 1
                output = output + 1
            while right < end:
                scratch[output] = order[right]
                right = right + 1
                output = output + 1
            start = end
        index = 0
        while index < count:
            order[index] = scratch[index]
            index = index + 1
        if width >= count - width:
            break
        width = width * 2
    order

# Identity of one admitted HIR module: name and physical path. "\n" cannot
# occur in either, so the joined key is unambiguous.
pub fn hir_admission_identity_key_v1(name: text, path: text) -> text:
    name + "\n" + path

# Indices of `pending_keys` absent from `admitted_keys`, in pending order.
# Replaces the O(pending x admitted) membership scan per admission round.
pub fn hir_admission_unadmitted_indices_v1(pending_keys: [text], admitted_keys: [text]) -> [i64]:
    var admitted: {text: bool} = {}
    for key in admitted_keys: admitted[key] = true
    var out: [i64] = []
    var index = 0
    while index < pending_keys.len():
        if not admitted.contains_key(pending_keys[index]): out.push(index)
        index = index + 1
    out

# Groups positions by key, each group in ascending position order. Used to
# index surfaces by canonical path and dict keys by module identity once.
pub fn hir_admission_group_positions_v1(keys: [text]) -> Dict<text, [i64]>:
    var groups: Dict<text, [i64]> = {}
    var index = 0
    while index < keys.len():
        val key = keys[index]
        if groups.contains_key(key):
            var group: [i64] = groups[key]
            group.push(index)
            groups[key] = group
        else:
            groups[key] = [index]
        index = index + 1
    groups
