# Compiler entry admission, before source traversal and optional transforms.
# Returning an error value prevents callers from merely accumulating a
# diagnostic and then continuing into a backend with an unsupported request.
use common.plugin.aspect_params.{AspectParamsV1}
use common.trace.observer_contract_v1.{trace_failure_code_v1}
use compiler.common.driver_core_types.{CompileResult}
use compiler.driver.driver_observer_request_v1.{driver_observer_request_v1}

pub fn driver_observer_compile_gate_v1(params: AspectParamsV1, target: text) -> Option<CompileResult>:
    match driver_observer_request_v1(params, target):
        case Err(failure):
            val code = trace_failure_code_v1(failure)
            Some(CompileResult.CodegenError("TRACE-E-REQUEST: observer V1 request rejected (status={code})"))
        case Ok(_):
            nil
