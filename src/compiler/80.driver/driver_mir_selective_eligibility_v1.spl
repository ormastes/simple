# Shared producer/worker/link admission. Legacy staging policy is unchanged.
use compiler.driver.driver_compiler_type.{CompilerDriver}
use compiler.driver.driver_phase_gates.{driver_source_entry_request, driver_source_entry_closure_enabled}
use compiler.driver.driver_source_loading.{_driver_physical_source_key}
use compiler.driver.driver_build.native_group_request.{native_group_request_path_v1}
use compiler.backend.backend_helpers.{get_effective_backend_name}
use compiler.common.driver_core_modes.{driver_output_format_native}
use compiler.common.native_output_intent.{NativeOutputIntentV1, native_output_intent_decode_v1}
use compiler.mir._MirLowering.module_lowering.{mir_layout_canonical_module_name}
use std.io_runtime.{env_get_opt}

pub fn driver_mir_selective_bootstrap_owner_v1(name: text, path: text) -> bool:
    val normalized = _driver_physical_source_key(path)
    mir_layout_canonical_module_name(name) == "app.cli.bootstrap_main" or
        normalized == "src/app/cli/bootstrap_main.spl" or normalized.ends_with("/app/cli/bootstrap_main.spl")

pub fn driver_mir_selective_explicit_native_eligible_v1(driver: CompilerDriver) -> bool:
    val ctx = driver.ctx
    val entry = driver_source_entry_request(ctx)
    if entry == "" or not driver_source_entry_closure_enabled(ctx) or
            (env_get_opt("SIMPLE_BOOTSTRAP_DIRECT_IR") ?? "") == "1": return false
    val backend = get_effective_backend_name(ctx.options.backend, ctx.options.release)
    if backend != "llvm" and backend != "llvm-lib" and backend != "cranelift": return false
    # An explicit plugin overrides builtin resolution before backend selection.
    # Its name does not prove the inspected native nominal-handle semantics.
    if ctx.options.backend_plugin_path != "": return false
    if ctx.options.output_format != driver_output_format_native() or
            ctx.cold_hir_typed_receipts.len() != 0 or ctx.options.collection_memory_budget_bytes >= 0 or
            ctx.runtime_std_full_inventory_selection != nil or ctx.demand_compile_execution != nil or
            ctx.demand_mir_admission != nil or ctx.demand_dirty_modules.len() != 0 or
            (env_get_opt("SIMPLE_PACKAGE_INDEX_FULL_INVENTORY") ?? "") == "1" or
            (env_get_opt("SIMPLE_NATIVE_BUILD_CLEAN") ?? "") == "1" or native_group_request_path_v1() != "":
        return false
    var matched = false
    for source in ctx.sources:
        if driver_mir_selective_bootstrap_owner_v1(source.module_name, source.path): return false
        if source.path == entry or source.path.ends_with("/" + entry): matched = true
    for name in ctx.hir_modules.keys():
        if driver_mir_selective_bootstrap_owner_v1(name, ctx.hir_modules[name].path) or
                driver_mir_selective_bootstrap_owner_v1(ctx.hir_modules[name].name, ctx.hir_modules[name].path):
            return false
    if not matched: return false
    match native_output_intent_decode_v1(env_get_opt("SIMPLE_NATIVE_BUILD_EMIT_OBJECT") ?? ""):
        case Ok(intent): intent != NativeOutputIntentV1.EntryObject
        case Err(_): false

# Preserve exactly the serial AOT pass-skip condition, independently of the
# explicit non-bootstrap MIR lowering policy selected by the admitted entry.
pub fn driver_mir_selective_skip_post_chain_v1() -> bool:
    (env_get_opt("SIMPLE_BOOTSTRAP") ?? "") == "1" and
        (env_get_opt("SIMPLE_BOOTSTRAP_STAGE4") ?? "") != "1"

export driver_mir_selective_explicit_native_eligible_v1,
    driver_mir_selective_bootstrap_owner_v1, driver_mir_selective_skip_post_chain_v1
