# Compiler-owned RISC-V Gen2 VHDL product route.
#
# This deliberately bypasses the source/HIR/MIR catalog: the product is an
# elaborated HWIR graph, not a pretend user source file.  Its manifest records
# that distinction with an empty user source closure and an explicit compiler
# product identity.

use compiler.driver.driver_compiler_type.{CompilerDriver}
use compiler.driver.driver_types.{CompileContext}
use compiler.common.driver_core_types.{CompileMode, CompileResult}
use compiler.common.assurance.policy_schema.{AssuranceStrictness, ResolvedAssurancePolicyV1}
use compiler.mir.mir_aop_injection.{aop_advices_requested, aop_weave_count}
use compiler.mir.hwir.types.{CoreConfig, HwModuleDef, HwPort}
use compiler.mir.hwir.aspects.{HwAspectLock, hwir_aspect_lock_sha256}
use compiler.mir.hwir.frontend.{strict_zca_control_predecode_hwir, strict_zca_migrating_predecode_hwir, strict_zca_rv32_cjal_migrating_predecode_hwir, strict_zca_rv64_addiw_migrating_predecode_hwir}
use compiler.mir.hwir.stateful_frontend.{strict_zca_single_outstanding_frontend_hwir, strict_zca_trap_single_outstanding_frontend_hwir}
use compiler.mir.hwir.trap_frontend.{strict_zca_trap_migrating_predecode_hwir, strict_zca_target_trap_migrating_predecode_hwir}
use compiler.backend.backend.hwir_to_vhdl.{compile_strict_zca_control_predecode_product, compile_strict_zca_migrating_predecode_product, compile_strict_zca_rv32_cjal_migrating_predecode_product, compile_strict_zca_rv64_addiw_migrating_predecode_product, compile_strict_zca_single_outstanding_frontend_product, compile_strict_zca_trap_single_outstanding_frontend_product, strict_stateful_graph_sha}
use compiler.driver.driver_build.incremental.{native_build_compiler_identity, native_build_compiler_executable_hash}
use compiler.driver.driver_vhdl_artifacts.{VhdlArtifactAssurancePolicySnapshot, VhdlArtifactGeneratedItem, VhdlArtifactInput, VhdlArtifactLocation, VhdlArtifactPort, VhdlArtifactRendered, vhdl_artifact_assurance_policy_snapshot, vhdl_artifact_assurance_policy_snapshot_is_canonical, vhdl_gen2_capability_ids, vhdl_gen2_capability_sha256, vhdl_render_production_artifacts, vhdl_remove_production_artifacts, vhdl_validate_production_artifact_input}
use std.common.encoding.sha256_contract.{sha256_lower_hex_valid}

extern fn rt_file_write_text(path: text, content: text) -> bool

const RISCV_GEN2_ZCA_CONTROL_PREDECODE_PRODUCT = "riscv-gen2-zca-control-predecode-v1"
const RISCV_GEN2_PRODUCT_ENTRY_MODULE = "compiler-product:riscv-gen2-zca-control-predecode-v1"
const RISCV_GEN2_ZCA_MIGRATING_PREDECODE_PRODUCT = "riscv-gen2-zca-migrating-predecode-v1"
const RISCV_GEN2_MIGRATING_PRODUCT_ENTRY_MODULE = "compiler-product:riscv-gen2-zca-migrating-predecode-v1"
const RISCV_GEN2_ZCA_RV32_CJAL_MIGRATING_PREDECODE_PRODUCT = "riscv-gen2-zca-rv32-cjal-migrating-predecode-v1"
const RISCV_GEN2_RV32_CJAL_MIGRATING_PRODUCT_ENTRY_MODULE = "compiler-product:riscv-gen2-zca-rv32-cjal-migrating-predecode-v1"
const RISCV_GEN2_ZCA_RV64_ADDIW_MIGRATING_PREDECODE_PRODUCT = "riscv-gen2-zca-rv64-addiw-migrating-predecode-v1"
const RISCV_GEN2_RV64_ADDIW_MIGRATING_PRODUCT_ENTRY_MODULE = "compiler-product:riscv-gen2-zca-rv64-addiw-migrating-predecode-v1"
const RISCV_GEN2_ZCA_RV32_CJAL_SINGLE_OUTSTANDING_PRODUCT = "riscv-gen2-zca-rv32-cjal-single-outstanding-v2"
const RISCV_GEN2_RV32_CJAL_SINGLE_OUTSTANDING_ENTRY_MODULE = "compiler-product:riscv-gen2-zca-rv32-cjal-single-outstanding-v2"
const RISCV_GEN2_ZCA_RV64_ADDIW_SINGLE_OUTSTANDING_PRODUCT = "riscv-gen2-zca-rv64-addiw-single-outstanding-v2"
const RISCV_GEN2_RV64_ADDIW_SINGLE_OUTSTANDING_ENTRY_MODULE = "compiler-product:riscv-gen2-zca-rv64-addiw-single-outstanding-v2"
const RISCV_GEN2_ZCA_TRAP_SINGLE_OUTSTANDING_PRODUCT = "riscv-gen2-zca-trap-single-outstanding-v3"
const RISCV_GEN2_TRAP_SINGLE_OUTSTANDING_ENTRY_MODULE = "compiler-product:riscv-gen2-zca-trap-single-outstanding-v3"

# This receipt is intentionally private to the sole compiler-product route.
# Simple visibility is not yet a hard capability boundary, so this confines the
# public API surface; it does not claim language-level non-forgeability.
struct Gen2VhdlArtifactEmissionReceipt:
    output_path: text
    vhdl: text
    rendered: VhdlArtifactRendered
    hwir_graph_sha256: text
    assurance_policy: VhdlArtifactAssurancePolicySnapshot

fn gen2_is_compiler_product_route(route: text) -> bool:
    route == "hwir-gen2-product" or
        route == "hwir-gen2-stateful-product-v2" or
        route == "hwir-gen2-trap-stateful-product-v3"

fn gen2_authorize_vhdl_artifact_emission(input: VhdlArtifactInput,
    vhdl: text) -> Result<Gen2VhdlArtifactEmissionReceipt, text>:
    """Freeze an already-recomputed Gen2 product bundle for this driver only."""
    if not gen2_is_compiler_product_route(input.generation_route):
        return Err("VHDL Gen2 artifact receipt requires a compiler-owned Gen2 route")
    vhdl_validate_production_artifact_input(input)?
    if not vhdl.contains("graph=" + input.hwir_graph_sha256):
        return Err("VHDL Gen2 artifact receipt requires the canonical HWIR closure SHA-256 in emitted VHDL")
    if input.assurance_policy == nil:
        return Err("VHDL Gen2 artifact receipt requires the context assurance-policy snapshot")
    val assurance_policy = input.assurance_policy.unwrap()
    val rendered = vhdl_render_production_artifacts(input, vhdl)
    if not rendered.manifest.contains("\"graph_sha256\":\"" +
        input.hwir_graph_sha256 + "\""):
        return Err("VHDL Gen2 artifact receipt requires the canonical HWIR closure SHA-256 in its manifest")
    if not rendered.manifest.contains("\"policy_hash\":\"" +
        assurance_policy.policy_hash + "\""):
        return Err("VHDL Gen2 artifact receipt requires the context assurance-policy hash in its manifest")
    Ok(Gen2VhdlArtifactEmissionReceipt(output_path: input.output_path,
        vhdl: vhdl, rendered: rendered,
        hwir_graph_sha256: input.hwir_graph_sha256,
        assurance_policy: assurance_policy))

fn gen2_write_authorized_vhdl_artifact_emission(
    receipt: Gen2VhdlArtifactEmissionReceipt) -> Result<(), text>:
    """Persist only a bundle authorized by the private Gen2 product receipt."""
    if not sha256_lower_hex_valid(receipt.hwir_graph_sha256) or
        not vhdl_artifact_assurance_policy_snapshot_is_canonical(receipt.assurance_policy) or
        not receipt.assurance_policy.strictness.at_least(AssuranceStrictness.Critical) or
        not receipt.vhdl.contains("graph=" + receipt.hwir_graph_sha256) or
        not receipt.rendered.manifest.contains("\"graph_sha256\":\"" +
            receipt.hwir_graph_sha256 + "\"") or
        not receipt.rendered.manifest.contains("\"policy_hash\":\"" +
            receipt.assurance_policy.policy_hash + "\""):
        return Err("VHDL Gen2 artifact write requires one consistent canonical HWIR closure and assurance-policy snapshot")
    val output = receipt.output_path
    if not vhdl_remove_production_artifacts(output):
        return Err("Failed to remove stale VHDL artifacts for {output}")
    if not rt_file_write_text(output, receipt.vhdl):
        if not vhdl_remove_production_artifacts(output):
            return Err("Failed to write VHDL to {output}; partial artifact cleanup also failed")
        return Err("Failed to write VHDL to {output}")
    val map_path = output + ".map.json"
    if not rt_file_write_text(map_path, receipt.rendered.source_map):
        if not vhdl_remove_production_artifacts(output):
            return Err("Failed to write VHDL source map to {map_path}; partial artifact cleanup also failed")
        return Err("Failed to write VHDL source map to {map_path}")
    val manifest_path = output + ".gen.json"
    if not rt_file_write_text(manifest_path, receipt.rendered.manifest):
        if not vhdl_remove_production_artifacts(output):
            return Err("Failed to write VHDL manifest to {manifest_path}; partial artifact cleanup also failed")
        return Err("Failed to write VHDL manifest to {manifest_path}")
    Ok(())

fn gen2_product_config(ctx: CompileContext, product_id: text) -> Result<CoreConfig, text>:
    if ctx.options.mode != CompileMode.Aot or ctx.options.backend != "vhdl":
        return Err("HWIR-E-GEN2-PRODUCT-MODE: Gen2 product emission requires AOT VHDL mode")
    if not ctx.assurance_policy.strictness.at_least(AssuranceStrictness.Critical):
        return Err("HWIR-E-CRITICAL-POLICY: Gen2 product emission requires SIMPLE_SAFETY_PROFILE=critical")
    if product_id == RISCV_GEN2_ZCA_RV32_CJAL_MIGRATING_PREDECODE_PRODUCT or
        product_id == RISCV_GEN2_ZCA_RV32_CJAL_SINGLE_OUTSTANDING_PRODUCT:
        if ctx.options.riscv_gen2_target != "rv32-zca-cjal-critical":
            return Err("HWIR-E-GEN2-PRODUCT-TARGET: {product_id} requires rv32-zca-cjal-critical")
    elif product_id == RISCV_GEN2_ZCA_RV64_ADDIW_MIGRATING_PREDECODE_PRODUCT or
        product_id == RISCV_GEN2_ZCA_RV64_ADDIW_SINGLE_OUTSTANDING_PRODUCT:
        if ctx.options.riscv_gen2_target != "rv64-zca-addiw-critical":
            return Err("HWIR-E-GEN2-PRODUCT-TARGET: {product_id} requires rv64-zca-addiw-critical")
    elif product_id == RISCV_GEN2_ZCA_TRAP_SINGLE_OUTSTANDING_PRODUCT:
        if ctx.options.riscv_gen2_target != "rv32-zca-critical" and
            ctx.options.riscv_gen2_target != "rv64-zca-critical" and
            ctx.options.riscv_gen2_target != "rv32-zca-cjal-critical" and
            ctx.options.riscv_gen2_target != "rv64-zca-addiw-critical":
            return Err("HWIR-E-GEN2-PRODUCT-TARGET: {product_id} requires a concrete critical Zca target")
    elif ctx.options.riscv_gen2_target != "rv32-zca-critical" and
        ctx.options.riscv_gen2_target != "rv64-zca-critical":
        return Err("HWIR-E-GEN2-PRODUCT-TARGET: {product_id} requires rv32-zca-critical or rv64-zca-critical")
    if ctx.options.input_files.len() != 0:
        return Err("HWIR-E-GEN2-PRODUCT-SOURCE: compiler-owned Gen2 product emission forbids user source inputs")
    val config = CoreConfig.from_critical_target(ctx.options.riscv_gen2_target)?
    if config.compressed_decode_profile != "zca-common-critical":
        return Err("HWIR-E-GEN2-PRODUCT-CONFIG: product requires zca-common-critical elaboration")
    Ok(config)

fn gen2_product_artifact_input(output: text, module: HwModuleDef, entry_module: text,
    assurance_policy: ResolvedAssurancePolicyV1) -> Result<VhdlArtifactInput, text>:
    var ports: [VhdlArtifactPort] = []
    var index = 0
    for port in module.ports:
        ports = ports.push(VhdlArtifactPort(entity: module.summary.name,
            name: port.name, direction: port.direction, type_name: port.type_name,
            bit_width: port.bit_width as i64, index: index, location: VhdlArtifactLocation(available: false,
                module_name: "", file: "", start: 0, end: 0, line: 0, col: 0)))
        index = index + 1
    val unavailable = VhdlArtifactLocation(available: false, module_name: "",
        file: "", start: 0, end: 0, line: 0, col: 0)
    val aspect_lock_sha256 = hwir_aspect_lock_sha256(HwAspectLock(entries: []))?
    val capability_ids = vhdl_gen2_capability_ids("hwir-gen2-product", module.summary.name)?
    val capability_sha256 = vhdl_gen2_capability_sha256(capability_ids)?
    val input = VhdlArtifactInput(output_path: output,
        entry_module: entry_module,
        entry_entity: module.summary.name,
        root_modules: [entry_module], sources: [],
        compiler_identity: native_build_compiler_identity(),
        compiler_hash: native_build_compiler_executable_hash(),
        target: "riscv" + module.config.xlen.to_text(), xlen: module.config.xlen,
        profile: module.config.profile,
        catalog_name: entry_module,
        module_count: 1, entity_count: 1, type_count: 0, helper_count: 0,
        generation_route: "hwir-gen2-product",
        hwir_module_node_id: module.node_id.value,
        hwir_config_profile: module.config.profile,
        hwir_graph_sha256: module.structural_sha256(),
        riscv_isa_profile: module.config.isa_profile,
        riscv_compressed_decode_profile: module.config.compressed_decode_profile,
        riscv_capability_scope: "frontend-predecode-only",
        riscv_admitted_instruction_ids: capability_ids,
        riscv_capability_sha256: capability_sha256,
        riscv_target_evidence_complete: false,
        assurance_policy: vhdl_artifact_assurance_policy_snapshot(assurance_policy),
        hwir_aspect_lock_sha256: aspect_lock_sha256, hwir_aspects: [],
        generated_items: [VhdlArtifactGeneratedItem(kind: "compiler_product_entity",
            name: module.summary.name, location: unavailable)], ports: ports,
        aop_advices_requested: 0, aop_weave_count: 0)
    vhdl_validate_production_artifact_input(input)?
    Ok(input)

fn gen2_stateful_product_artifact_input(output: text, entity: text, node_id: text,
    config: CoreConfig, ports: [HwPort], entry_module: text, route: text,
    decoder_entity: text, hwir_graph_sha256: text,
    assurance_policy: ResolvedAssurancePolicyV1) -> Result<VhdlArtifactInput, text>:
    var artifact_ports: [VhdlArtifactPort] = []
    var index = 0
    for port in ports:
        artifact_ports.push(VhdlArtifactPort(entity: entity, name: port.name,
            direction: port.direction, type_name: port.type_name, bit_width: port.bit_width as i64, index: index,
            location: VhdlArtifactLocation(available: false, module_name: "", file: "", start: 0, end: 0, line: 0, col: 0)))
        index = index + 1
    val unavailable = VhdlArtifactLocation(available: false, module_name: "", file: "", start: 0, end: 0, line: 0, col: 0)
    val aspect_lock_sha256 = hwir_aspect_lock_sha256(HwAspectLock(entries: []))?
    val capability_ids = vhdl_gen2_capability_ids(route, entity)?
    val capability_sha256 = vhdl_gen2_capability_sha256(capability_ids)?
    val input = VhdlArtifactInput(output_path: output, entry_module: entry_module,
        entry_entity: entity, root_modules: [entry_module], sources: [],
        compiler_identity: native_build_compiler_identity(), compiler_hash: native_build_compiler_executable_hash(),
        target: "riscv" + config.xlen.to_text(), xlen: config.xlen, profile: config.profile,
        catalog_name: entry_module, module_count: 2, entity_count: 2, type_count: 0, helper_count: 0,
        generation_route: route, hwir_module_node_id: node_id, hwir_config_profile: config.profile,
        hwir_graph_sha256: hwir_graph_sha256,
        riscv_isa_profile: config.isa_profile,
        riscv_compressed_decode_profile: config.compressed_decode_profile,
        riscv_capability_scope: "frontend-predecode-only",
        riscv_admitted_instruction_ids: capability_ids,
        riscv_capability_sha256: capability_sha256,
        riscv_target_evidence_complete: false,
        assurance_policy: vhdl_artifact_assurance_policy_snapshot(assurance_policy),
        hwir_aspect_lock_sha256: aspect_lock_sha256, hwir_aspects: [],
        generated_items: [VhdlArtifactGeneratedItem(kind: "compiler_product_entity", name: entity, location: unavailable),
            VhdlArtifactGeneratedItem(kind: "compiler_product_dependency", name: decoder_entity, location: unavailable)],
        ports: artifact_ports, aop_advices_requested: 0, aop_weave_count: 0)
    vhdl_validate_production_artifact_input(input)?
    Ok(input)

fn compile_riscv_gen2_special_stateful_product(driver: CompilerDriver,
    product_id: text, entry_module: text) -> CompileResult:
    val ctx = driver.ctx
    val output = ctx.options.output_file ?? ""
    if output == "":
        return CompileResult.CodegenError("HWIR-E-GEN2-PRODUCT-OUTPUT: Gen2 product emission requires an explicit VHDL output path")
    val config = match gen2_product_config(ctx, product_id):
        case Ok(value): value
        case Err(error): return CompileResult.CodegenError(error)
    if aop_advices_requested() != 0 or aop_weave_count() != 0:
        return CompileResult.CodegenError("HWIR-E-GEN2-PRODUCT-AOP: compiler-owned Gen2 product emission forbids AOP requests and weaves")
    val emitted = compile_strict_zca_single_outstanding_frontend_product(config)
    if not emitted.is_success() or emitted.route != "hwir-gen2-stateful-product-v2" or emitted.hwir_graph_sha256.len() != 64:
        return CompileResult.CodegenError("HWIR-E-GEN2-PRODUCT-EMIT: {emitted.diagnostic}")
    val module = match strict_zca_single_outstanding_frontend_hwir(emitted.module_node_id.replace(":module", ""), config):
        case Ok(value): value
        case Err(error): return CompileResult.CodegenError("HWIR-E-GEN2-PRODUCT-LOWER: {error}")
    val decoder_module = if module.decoder_entity == "riscv_gen2_zca_rv32_cjal_migrating_predecode":
        strict_zca_rv32_cjal_migrating_predecode_hwir(module.decoder_entity, config)
    else:
        strict_zca_rv64_addiw_migrating_predecode_hwir(module.decoder_entity, config)
    if decoder_module.is_err():
        return CompileResult.CodegenError("HWIR-E-GEN2-PRODUCT-LOWER: " + decoder_module.err().unwrap())
    val expected_graph_sha = strict_stateful_graph_sha(module.node_id.value, module.config,
        module.origins, module.frontend_contract.ports(), module.decoder_entity, module.sequential,
        decoder_module.ok().unwrap().structural_sha256())
    if emitted.module_node_id != module.node_id.value or emitted.config_profile != module.config.profile or
        emitted.hwir_graph_sha256 != expected_graph_sha:
        return CompileResult.CodegenError("HWIR-E-GEN2-PRODUCT-PROVENANCE: emitted HWIR identity does not match the product graph")
    val artifact = match gen2_stateful_product_artifact_input(output, module.summary_name,
        module.node_id.value, module.config, module.frontend_contract.ports(), entry_module,
        emitted.route, module.decoder_entity, emitted.hwir_graph_sha256, ctx.assurance_policy):
        case Ok(value): value
        case Err(error): return CompileResult.CodegenError("HWIR-E-GEN2-PRODUCT-PROVENANCE: {error}")
    val receipt = match gen2_authorize_vhdl_artifact_emission(artifact, emitted.vhdl):
        case Ok(value): value
        case Err(error): return CompileResult.CodegenError("HWIR-E-GEN2-PRODUCT-PROVENANCE: {error}")
    match gen2_write_authorized_vhdl_artifact_emission(receipt):
        case Ok(_): CompileResult.Success(output)
        case Err(error): CompileResult.CodegenError(error)

impl CompilerDriver:
    me compile_riscv_gen2_zca_control_predecode_product() -> CompileResult:
        val ctx = self.ctx
        val output = ctx.options.output_file ?? ""
        if output == "":
            return CompileResult.CodegenError("HWIR-E-GEN2-PRODUCT-OUTPUT: Gen2 product emission requires an explicit VHDL output path")
        val config = match gen2_product_config(ctx, RISCV_GEN2_ZCA_CONTROL_PREDECODE_PRODUCT):
            case Ok(value): value
            case Err(error): return CompileResult.CodegenError(error)
        if aop_advices_requested() != 0 or aop_weave_count() != 0:
            return CompileResult.CodegenError("HWIR-E-GEN2-PRODUCT-AOP: compiler-owned Gen2 product emission forbids AOP requests and weaves")
        # Cleanup belongs exclusively to the authorized-write boundary. Strict
        # lowering, graph recomputation, and provenance validation must leave a
        # known-good bundle intact when they reject this requested product.
        val emitted = compile_strict_zca_control_predecode_product(config)
        if not emitted.is_success() or emitted.route != "hwir-gen2-product":
            return CompileResult.CodegenError("HWIR-E-GEN2-PRODUCT-EMIT: {emitted.diagnostic}")
        val module_name = if config.xlen == 32:
            "riscv_gen2_zca_control_predecode_rv32"
        else:
            "riscv_gen2_zca_control_predecode_rv64"
        val module = match strict_zca_control_predecode_hwir(module_name, config):
            case Ok(value): value
            case Err(error): return CompileResult.CodegenError("HWIR-E-GEN2-PRODUCT-LOWER: {error}")
        if emitted.module_node_id != module.node_id.value or emitted.config_profile != module.config.profile or
            emitted.hwir_graph_sha256 != module.structural_sha256():
            return CompileResult.CodegenError("HWIR-E-GEN2-PRODUCT-PROVENANCE: emitted HWIR identity does not match the product graph")
        val artifact = match gen2_product_artifact_input(output, module, RISCV_GEN2_PRODUCT_ENTRY_MODULE,
            ctx.assurance_policy):
            case Ok(value): value
            case Err(error): return CompileResult.CodegenError("HWIR-E-GEN2-PRODUCT-PROVENANCE: {error}")
        val receipt = match gen2_authorize_vhdl_artifact_emission(artifact, emitted.vhdl):
            case Ok(value): value
            case Err(error): return CompileResult.CodegenError("HWIR-E-GEN2-PRODUCT-PROVENANCE: {error}")
        match gen2_write_authorized_vhdl_artifact_emission(receipt):
            case Ok(_): CompileResult.Success(output)
            case Err(error): CompileResult.CodegenError(error)

pub fn compiler_driver_run_riscv_gen2_zca_control_predecode_product(driver: CompilerDriver) -> CompileResult:
    driver.compile_riscv_gen2_zca_control_predecode_product()

impl CompilerDriver:
    me compile_riscv_gen2_zca_migrating_predecode_product() -> CompileResult:
        val ctx = self.ctx
        val output = ctx.options.output_file ?? ""
        if output == "":
            return CompileResult.CodegenError("HWIR-E-GEN2-PRODUCT-OUTPUT: Gen2 product emission requires an explicit VHDL output path")
        val config = match gen2_product_config(ctx, RISCV_GEN2_ZCA_MIGRATING_PREDECODE_PRODUCT):
            case Ok(value): value
            case Err(error): return CompileResult.CodegenError(error)
        if aop_advices_requested() != 0 or aop_weave_count() != 0:
            return CompileResult.CodegenError("HWIR-E-GEN2-PRODUCT-AOP: compiler-owned Gen2 product emission forbids AOP requests and weaves")
        val emitted = compile_strict_zca_migrating_predecode_product(config)
        if not emitted.is_success() or emitted.route != "hwir-gen2-product":
            return CompileResult.CodegenError("HWIR-E-GEN2-PRODUCT-EMIT: {emitted.diagnostic}")
        val module_name = if config.xlen == 32:
            "riscv_gen2_zca_migrating_predecode_rv32"
        else:
            "riscv_gen2_zca_migrating_predecode_rv64"
        val module = match strict_zca_migrating_predecode_hwir(module_name, config):
            case Ok(value): value
            case Err(error): return CompileResult.CodegenError("HWIR-E-GEN2-PRODUCT-LOWER: {error}")
        if emitted.module_node_id != module.node_id.value or emitted.config_profile != module.config.profile or
            emitted.hwir_graph_sha256 != module.structural_sha256():
            return CompileResult.CodegenError("HWIR-E-GEN2-PRODUCT-PROVENANCE: emitted HWIR identity does not match the product graph")
        val artifact = match gen2_product_artifact_input(output, module, RISCV_GEN2_MIGRATING_PRODUCT_ENTRY_MODULE,
            ctx.assurance_policy):
            case Ok(value): value
            case Err(error): return CompileResult.CodegenError("HWIR-E-GEN2-PRODUCT-PROVENANCE: {error}")
        val receipt = match gen2_authorize_vhdl_artifact_emission(artifact, emitted.vhdl):
            case Ok(value): value
            case Err(error): return CompileResult.CodegenError("HWIR-E-GEN2-PRODUCT-PROVENANCE: {error}")
        match gen2_write_authorized_vhdl_artifact_emission(receipt):
            case Ok(_): CompileResult.Success(output)
            case Err(error): CompileResult.CodegenError(error)

pub fn compiler_driver_run_riscv_gen2_zca_migrating_predecode_product(driver: CompilerDriver) -> CompileResult:
    driver.compile_riscv_gen2_zca_migrating_predecode_product()

impl CompilerDriver:
    me compile_riscv_gen2_zca_rv32_cjal_migrating_predecode_product() -> CompileResult:
        val ctx = self.ctx
        val output = ctx.options.output_file ?? ""
        if output == "":
            return CompileResult.CodegenError("HWIR-E-GEN2-PRODUCT-OUTPUT: Gen2 product emission requires an explicit VHDL output path")
        val config = match gen2_product_config(ctx, RISCV_GEN2_ZCA_RV32_CJAL_MIGRATING_PREDECODE_PRODUCT):
            case Ok(value): value
            case Err(error): return CompileResult.CodegenError(error)
        if aop_advices_requested() != 0 or aop_weave_count() != 0:
            return CompileResult.CodegenError("HWIR-E-GEN2-PRODUCT-AOP: compiler-owned Gen2 product emission forbids AOP requests and weaves")
        val emitted = compile_strict_zca_rv32_cjal_migrating_predecode_product(config)
        if not emitted.is_success() or emitted.route != "hwir-gen2-product":
            return CompileResult.CodegenError("HWIR-E-GEN2-PRODUCT-EMIT: {emitted.diagnostic}")
        val module_name = "riscv_gen2_zca_rv32_cjal_migrating_predecode"
        val module = match strict_zca_rv32_cjal_migrating_predecode_hwir(module_name, config):
            case Ok(value): value
            case Err(error): return CompileResult.CodegenError("HWIR-E-GEN2-PRODUCT-LOWER: {error}")
        if emitted.module_node_id != module.node_id.value or emitted.config_profile != module.config.profile or
            emitted.hwir_graph_sha256 != module.structural_sha256():
            return CompileResult.CodegenError("HWIR-E-GEN2-PRODUCT-PROVENANCE: emitted HWIR identity does not match the product graph")
        val artifact = match gen2_product_artifact_input(output, module,
            RISCV_GEN2_RV32_CJAL_MIGRATING_PRODUCT_ENTRY_MODULE, ctx.assurance_policy):
            case Ok(value): value
            case Err(error): return CompileResult.CodegenError("HWIR-E-GEN2-PRODUCT-PROVENANCE: {error}")
        val receipt = match gen2_authorize_vhdl_artifact_emission(artifact, emitted.vhdl):
            case Ok(value): value
            case Err(error): return CompileResult.CodegenError("HWIR-E-GEN2-PRODUCT-PROVENANCE: {error}")
        match gen2_write_authorized_vhdl_artifact_emission(receipt):
            case Ok(_): CompileResult.Success(output)
            case Err(error): CompileResult.CodegenError(error)

