impl CompilerDriver:
    me compile_riscv_gen2_zca_trap_single_outstanding_product() -> CompileResult:
        val ctx = self.ctx
        val output = ctx.options.output_file ?? ""
        if output == "":
            return CompileResult.CodegenError("HWIR-E-GEN2-PRODUCT-OUTPUT: Gen2 product emission requires an explicit VHDL output path")
        val config = match gen2_product_config(ctx, RISCV_GEN2_ZCA_TRAP_SINGLE_OUTSTANDING_PRODUCT):
            case Ok(value): value
            case Err(error): return CompileResult.CodegenError(error)
        if aop_advices_requested() != 0 or aop_weave_count() != 0:
            return CompileResult.CodegenError("HWIR-E-GEN2-PRODUCT-AOP: compiler-owned Gen2 product emission forbids AOP requests and weaves")
        val emitted = compile_strict_zca_trap_single_outstanding_frontend_product(config)
        if not emitted.is_success() or emitted.route != "hwir-gen2-trap-stateful-product-v3" or emitted.hwir_graph_sha256.len() != 64:
            return CompileResult.CodegenError("HWIR-E-GEN2-PRODUCT-EMIT: {emitted.diagnostic}")
        val module_name = if config.profile == "riscv-gen2-rv32-zca-cjal-critical":
            "riscv_gen2_zca_rv32_cjal_trap_single_outstanding_frontend"
        elif config.profile == "riscv-gen2-rv64-zca-addiw-critical":
            "riscv_gen2_zca_rv64_addiw_trap_single_outstanding_frontend"
        elif config.xlen == 32:
            "riscv_gen2_zca_trap_single_outstanding_frontend_rv32"
        else:
            "riscv_gen2_zca_trap_single_outstanding_frontend_rv64"
        val module = match strict_zca_trap_single_outstanding_frontend_hwir(module_name, config):
            case Ok(value): value
            case Err(error): return CompileResult.CodegenError("HWIR-E-GEN2-PRODUCT-LOWER: {error}")
        val specialized = (config.profile == "riscv-gen2-rv32-zca-cjal-critical" or
            config.profile == "riscv-gen2-rv64-zca-addiw-critical")
        val decoder_name = if config.profile == "riscv-gen2-rv32-zca-cjal-critical":
            "riscv_gen2_zca_rv32_cjal_trap_migrating_predecode"
        elif config.profile == "riscv-gen2-rv64-zca-addiw-critical":
            "riscv_gen2_zca_rv64_addiw_trap_migrating_predecode"
        elif config.xlen == 32:
            "riscv_gen2_zca_trap_migrating_predecode_rv32"
        else:
            "riscv_gen2_zca_trap_migrating_predecode_rv64"
        val decoder_result = if specialized:
            strict_zca_target_trap_migrating_predecode_hwir(decoder_name, config)
        else:
            strict_zca_trap_migrating_predecode_hwir(decoder_name, config)
        val decoder_module = match decoder_result:
            case Ok(value): value
            case Err(error): return CompileResult.CodegenError("HWIR-E-GEN2-PRODUCT-LOWER: {error}")
        val expected_graph_sha = strict_stateful_graph_sha(module.node_id.value, module.config,
            module.origins, module.frontend_contract.ports(), module.decoder_entity, module.sequential,
            decoder_module.structural_sha256())
        if emitted.module_node_id != module.node_id.value or emitted.config_profile != module.config.profile or
            emitted.hwir_graph_sha256 != expected_graph_sha:
            return CompileResult.CodegenError("HWIR-E-GEN2-PRODUCT-PROVENANCE: emitted HWIR identity does not match the product graph")
        val artifact = match gen2_stateful_product_artifact_input(output, module.summary_name,
            module.node_id.value, module.config, module.frontend_contract.ports(),
            RISCV_GEN2_TRAP_SINGLE_OUTSTANDING_ENTRY_MODULE, emitted.route,
            module.decoder_entity, emitted.hwir_graph_sha256, ctx.assurance_policy):
            case Ok(value): value
            case Err(error): return CompileResult.CodegenError("HWIR-E-GEN2-PRODUCT-PROVENANCE: {error}")
        val receipt = match gen2_authorize_vhdl_artifact_emission(artifact, emitted.vhdl):
            case Ok(value): value
            case Err(error): return CompileResult.CodegenError("HWIR-E-GEN2-PRODUCT-PROVENANCE: {error}")
        match gen2_write_authorized_vhdl_artifact_emission(receipt):
            case Ok(_): CompileResult.Success(output)
            case Err(error): CompileResult.CodegenError(error)

pub fn compiler_driver_run_riscv_gen2_zca_trap_single_outstanding_product(driver: CompilerDriver) -> CompileResult:
    driver.compile_riscv_gen2_zca_trap_single_outstanding_product()
