# Actual two-phase post-mono verification over complete leased module bodies.
# This returns the existing report; the driver still owns its assurance policy.
use compiler.mono.verify.post_mono_verify.{PostMonoVerifier, PostMonoReport,
    post_mono_report_empty}
use compiler.hir.hir_codec_support.{HirCodecWriter}
use std.common.crypto.sha256.{sha256_text}
use compiler.driver.cache.hir_mono_archive_assembly_v1.{MonoArchiveAssembledModuleV1,
    mono_archive_load_assembled_module_in_owned_scope_v1, mono_archive_assembled_module_name_v1}
use compiler.driver.driver_hir_cache.{hir_cache_clear_last_warnings,
    hir_cache_promote_diagnostic_owner_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause,
    transient_scope_end, transient_promote}

struct MonoArchiveVerifierSpecRowV1:
    symbol: i64
    name: text

struct MonoArchiveVerifierSeenRowV1:
    name: text
    module_name: text

struct MonoArchiveVerifierDeltaV1:
    spec_rows: [MonoArchiveVerifierSpecRowV1]
    template_rows: [text]
    seen_rows: [MonoArchiveVerifierSeenRowV1]
    report: PostMonoReport
    symbol: text
    chain: text
    in_specialization: bool
    transport_receipts: i64

# This owner has no current module, SymbolTable, function, span or body field.
class MonoArchiveVerifierOwnerV1:
    spec_ids: Dict<i64, text>
    template_keys: Dict<text, bool>
    seen_keys: Dict<text, text>
    report: PostMonoReport
    symbol: text
    chain: text
    in_specialization: bool
    transport_receipts: i64

fn mono_archive_verifier_owner_v1() -> MonoArchiveVerifierOwnerV1:
    MonoArchiveVerifierOwnerV1(spec_ids: {}, template_keys: {}, seen_keys: {},
        report: post_mono_report_empty(), symbol: "", chain: "",
        in_specialization: false, transport_receipts: 0)

fn mono_archive_post_mono_report_digest_v1(report: PostMonoReport) -> text:
    var writer = HirCodecWriter.create()
    writer.put_i64(report.unresolved_type_param)
    writer.put_i64(report.generic_call)
    writer.put_i64(report.generic_ctor)
    writer.put_i64(report.generic_method)
    writer.put_i64(report.generic_emitted_definition)
    writer.put_i64(report.any_erasure)
    writer.put_i64(report.error_from_substitution)
    writer.put_i64(report.unknown_mangling)
    writer.put_i64(report.unresolved_projection)
    writer.put_i64(report.unreachable_variant)
    writer.put_i64(report.symbol_id_collision)
    writer.put_i64(report.unemitted_template_call)
    writer.put_i64(report.duplicate_specialization_key)
    writer.put_i64(report.archived_devirtualization)
    writer.put_i64(report.violations.len())
    for violation in report.violations:
        writer.put_text(violation.counter)
        writer.put_text(violation.symbol)
        writer.put_text(violation.detail)
        writer.put_text(violation.chain)
        writer.put_text(violation.code)
    if not writer.ok: return ""
    sha256_text("mono-post-verify-report-v1\n" + writer.finish())

fn mono_archive_verifier_module_v1(owner: MonoArchiveVerifierOwnerV1,
        descriptor: MonoArchiveAssembledModuleV1, index_phase: bool) -> Result<MonoArchiveVerifierDeltaV1, text>:
    if not transient_scope_begin(): return Err("mono verifier scope unavailable")
    var result: MonoArchiveVerifierDeltaV1? = nil
    val loaded = mono_archive_load_assembled_module_in_owned_scope_v1(descriptor)
    if loaded.is_ok():
        val verifier = PostMonoVerifier.create()
        verifier.symbol = owner.symbol
        verifier.chain = owner.chain
        verifier.in_specialization = owner.in_specialization
        verifier.transport_receipts = owner.transport_receipts
        var spec_rows: [MonoArchiveVerifierSpecRowV1] = []
        var template_rows: [text] = []
        var seen_rows: [MonoArchiveVerifierSeenRowV1] = []
        if index_phase:
            # Mutable indexes are scratch copies. Only changed scalar/text rows
            # escape, never a promoted clone of the cumulative index.
            var specs: Dict<i64, text> = {}
            for key in owner.spec_ids.keys(): specs[key] = owner.spec_ids[key]
            var templates: Dict<text, bool> = {}
            for key in owner.template_keys.keys(): templates[key] = owner.template_keys[key]
            var seen: Dict<text, text> = {}
            for key in owner.seen_keys.keys(): seen[key] = owner.seen_keys[key]
            verifier.spec_ids = specs
            verifier.template_keys = templates
            seen = verifier.index_module(loaded.unwrap(), seen)
            for key in verifier.spec_ids.keys():
                if not owner.spec_ids.has(key):
                    spec_rows = spec_rows.push(MonoArchiveVerifierSpecRowV1(symbol: key, name: verifier.spec_ids[key]))
                elif owner.spec_ids[key] != verifier.spec_ids[key]:
                    spec_rows = spec_rows.push(MonoArchiveVerifierSpecRowV1(symbol: key, name: verifier.spec_ids[key]))
            for key in verifier.template_keys.keys():
                if not owner.template_keys.has(key): template_rows = template_rows.push(key)
            for key in seen.keys():
                if not owner.seen_keys.has(key):
                    seen_rows = seen_rows.push(MonoArchiveVerifierSeenRowV1(name: key, module_name: seen[key]))
        else:
            # The exhaustive walker reads these two closure indexes. Its local
            # current symbols/template ids remain scratch and are not promoted.
            verifier.spec_ids = owner.spec_ids
            verifier.template_keys = owner.template_keys
            verifier.verify_module(loaded.unwrap())
        result = Some(MonoArchiveVerifierDeltaV1(spec_rows: spec_rows,
            template_rows: template_rows, seen_rows: seen_rows, report: verifier.r,
            symbol: verifier.symbol, chain: verifier.chain,
            in_specialization: verifier.in_specialization,
            transport_receipts: verifier.transport_receipts))
    val admitted = result != nil
    val paused = transient_scope_pause()
    val promoted = if paused and admitted: transient_promote(result) else: false
    val cache_owned = if paused: hir_cache_promote_diagnostic_owner_v1() else: false
    if paused: hir_cache_clear_last_warnings()
    val ended = transient_scope_end()
    if not paused or not ended or not cache_owned or (admitted and not promoted):
        panic("mono verifier ownership")
    if val delta = result: return Ok(delta)
    Err("mono verifier complete module refused")

fn mono_archive_verifier_apply_v1(owner: MonoArchiveVerifierOwnerV1, delta: MonoArchiveVerifierDeltaV1):
    for row in delta.spec_rows: owner.spec_ids[row.symbol] = row.name
    for key in delta.template_rows: owner.template_keys[key] = true
    for row in delta.seen_rows: owner.seen_keys[row.name] = row.module_name
    # Report is a plain struct: construct the merged value and assign it to the
    # class owner, rather than depending on scalar writeback through a copy.
    val old = owner.report
    val added = delta.report
    var violations = old.violations
    for violation in added.violations: violations = violations.push(violation)
    owner.report = PostMonoReport(
        unresolved_type_param: old.unresolved_type_param + added.unresolved_type_param,
        generic_call: old.generic_call + added.generic_call,
        generic_ctor: old.generic_ctor + added.generic_ctor,
        generic_method: old.generic_method + added.generic_method,
        generic_emitted_definition: old.generic_emitted_definition + added.generic_emitted_definition,
        any_erasure: old.any_erasure + added.any_erasure,
        error_from_substitution: old.error_from_substitution + added.error_from_substitution,
        unknown_mangling: old.unknown_mangling + added.unknown_mangling,
        unresolved_projection: old.unresolved_projection + added.unresolved_projection,
        unreachable_variant: old.unreachable_variant + added.unreachable_variant,
        symbol_id_collision: old.symbol_id_collision + added.symbol_id_collision,
        unemitted_template_call: old.unemitted_template_call + added.unemitted_template_call,
        duplicate_specialization_key: old.duplicate_specialization_key + added.duplicate_specialization_key,
        archived_devirtualization: old.archived_devirtualization + added.archived_devirtualization,
        violations: violations)
    owner.symbol = delta.symbol
    owner.chain = delta.chain
    owner.in_specialization = delta.in_specialization
    owner.transport_receipts = delta.transport_receipts

fn mono_archive_verify_assembled_modules_v1(modules: Dict<text, MonoArchiveAssembledModuleV1>,
        expected_order: [text]) -> Result<PostMonoReport, text>:
    if modules.len() == 0 or expected_order.len() != modules.len():
        return Err("mono verifier inventory refused")
    var seen: Dict<text, bool> = {}
    var closure = ""
    for name in expected_order:
        if seen.has(name) or not modules.has(name): return Err("mono verifier order refused")
        val descriptor = modules[name]
        if mono_archive_assembled_module_name_v1(descriptor) != name: return Err("mono verifier module owner refused")
        if closure == "": closure = descriptor.closure_state_digest
        if closure != descriptor.closure_state_digest: return Err("mono verifier closed state differs")
        seen[name] = true
    val owner = mono_archive_verifier_owner_v1()
    # ALL index operations and duplicate-key violations precede every walk.
    for name in expected_order:
        val delta = mono_archive_verifier_module_v1(owner, modules[name], true)
        if delta.is_err(): return Err("mono verifier closure index refused")
        mono_archive_verifier_apply_v1(owner, delta.unwrap())
    for name in expected_order:
        val delta = mono_archive_verifier_module_v1(owner, modules[name], false)
        if delta.is_err(): return Err("mono verifier exhaustive walk refused")
        mono_archive_verifier_apply_v1(owner, delta.unwrap())
    Ok(owner.report)

export mono_archive_verify_assembled_modules_v1, mono_archive_post_mono_report_digest_v1
