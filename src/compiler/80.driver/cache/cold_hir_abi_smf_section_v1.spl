# One actual typed-HIR ABI section for the cold package metadata producer.
# This does not claim to be the complete export SMF: provider, initializer,
# generated-source, and deep-reference sections have separate owners.

use compiler.hir.hir_types.{HirModule}
use compiler.hir.abi_interface.{hir_abi_interface_encoded_v1}
use compiler.driver.cache.package_tldr_metadata.{
    PackageSmfSectionV1, package_smf_sections_validate_v1
}
use std.common.crypto.sha256.{sha256_text}

struct ColdHirAbiSmfSectionV1:
    payload: text
    section: PackageSmfSectionV1
    abi_digest: text

fn cold_hir_abi_smf_section_v1(
    module: HirModule
) -> Result<ColdHirAbiSmfSectionV1, text>:
    match hir_abi_interface_encoded_v1(module):
        case Err(reason): Err("cold-abi-section-unresolved:{reason}")
        case Ok(payload):
            val digest = sha256_text(payload)
            val section = PackageSmfSectionV1(
                "abi_interface", 0, payload.len(), digest)
            if package_smf_sections_validate_v1([section]) != "ok":
                return Err("cold-abi-section-invalid")
            Ok(ColdHirAbiSmfSectionV1(payload, section, digest))

export ColdHirAbiSmfSectionV1, cold_hir_abi_smf_section_v1
