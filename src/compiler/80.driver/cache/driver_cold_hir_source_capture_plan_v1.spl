# Actual cold source/snapshot admission before any borrowed full-body lease.
# Inventory text, decoded generations and source indexes are scratch. Only the
# selected per-physical-source capture inputs escape. This does not authenticate
# a transformed HIR body, publish ctx receipts or activate an archived route.
use compiler.driver.driver_types.{CompileContext}
use compiler.driver.cache.driver_cold_hir_module_capture_v1.{DriverColdHirModuleInputV1}
use compiler.driver.cache.cold_hir_source_inventory_admission_v1.{
    cold_hir_source_inventory_admit_v1, cold_hir_source_inventory_row_v1}
use compiler.backend.backend_helpers.{get_effective_backend_name}
use std.scv.compile_source_inventory.{compile_source_inventory_read_at_pointer_v1,
    CompileSourceInventoryBindingV1, compile_source_inventory_binding_reason_v1,
    compile_source_inventory_snapshot_cache_root_v1}
use std.scv.compile_snapshot.{scv_compile_snapshot_open_v1}
use std.nogc_sync_mut.io.file_ops.{file_read_regular_no_follow_bounded}
use std.nogc_async_mut.sosix.environment.{sosix_env_get_nullable, sosix_cwd}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause,
    transient_scope_end, transient_promote}

struct DriverColdHirSourceCapturePlanV1:
    enabled: bool
    full_inventory: bool
    source_root: text
    source_inventory_digest: text
    snapshot_inventory_digest: text
    inventory_generation: i64
    source_count: i64
    inputs: [DriverColdHirModuleInputV1]

fn driver_cold_hir_disabled_source_plan_v1() -> DriverColdHirSourceCapturePlanV1:
    DriverColdHirSourceCapturePlanV1(enabled: false, full_inventory: false,
        source_root: "", source_inventory_digest: "", snapshot_inventory_digest: "",
        inventory_generation: -1, source_count: 0, inputs: [])

fn driver_cold_hir_source_capture_plan_in_owned_scope_v1(ctx: CompileContext
) -> Result<DriverColdHirSourceCapturePlanV1, text>:
    if transient_array_scope_state_v1() != 1:
        return Err("cold HIR source admission requires active unpaused ownership")
    val full = (sosix_env_get_nullable("SIMPLE_PACKAGE_INDEX_FULL_INVENTORY") ?? "") == "1"
    val compatibility_markers_present =
        (sosix_env_get_nullable("SIMPLE_PACKAGE_INDEX_PRODUCER_DIGEST") ?? "") != "" and
        (sosix_env_get_nullable("SIMPLE_PACKAGE_INDEX_ROOT_GENERATION") ?? "") != "" and
        (sosix_env_get_nullable("SIMPLE_PACKAGE_INDEX_VARIANT_DIGEST") ?? "") != ""
    val cold = full or (sosix_env_get_nullable("SIMPLE_PACKAGE_INDEX_COLD_INIT") ?? "") == "1" or
        not compatibility_markers_present
    if not cold: return Ok(driver_cold_hir_disabled_source_plan_v1())
    if full and ctx.runtime_std_full_inventory_selection == nil:
        return Err("full inventory typed HIR selection missing")
    val source_root = sosix_env_get_nullable("SIMPLE_SCV_SNAPSHOT_ROOT") ?? ""
    val binding = CompileSourceInventoryBindingV1(
        snapshot_manifest_digest: sosix_env_get_nullable("SIMPLE_SCV_INVENTORY_DIGEST") ?? "",
        source_inventory_digest: sosix_env_get_nullable("SIMPLE_SCV_SOURCE_INVENTORY_DIGEST") ?? "")
    var artifact_root = ""
    if full:
        val selection = ctx.runtime_std_full_inventory_selection!
        artifact_root = selection.artifact_root
        if artifact_root == "" or selection.snapshot_manifest_digest != binding.snapshot_manifest_digest or
                selection.source_inventory_digest != binding.source_inventory_digest:
            return Err("full inventory typed HIR selection differs from SCV binding")
    if source_root == "" and binding.snapshot_manifest_digest == "" and binding.source_inventory_digest == "":
        if full: return Err("full inventory cold HIR authority missing")
        return Ok(driver_cold_hir_disabled_source_plan_v1())
    if source_root == "" or binding.snapshot_manifest_digest == "" or binding.source_inventory_digest == "":
        return Err("cold HIR receipt authority incomplete")
    val revision = sosix_env_get_nullable("SIMPLE_SCV_REVISION_ID") ?? ""
    val cache_root = compile_source_inventory_snapshot_cache_root_v1(sosix_cwd(), source_root, revision)
    if cache_root == "": return Err("cold HIR inventory snapshot owner invalid")
    # Never reread the moving CURRENT pointer. The actual selected immutable
    # generation and the separate selected snapshot must both validate.
    val admitted = compile_source_inventory_read_at_pointer_v1(cache_root, binding.source_inventory_digest)
    if not admitted.valid: return Err("cold HIR inventory admission failed: {admitted.reason}")
    val binding_reason = compile_source_inventory_binding_reason_v1(binding, admitted.digest)
    if binding_reason != "ok": return Err("cold HIR inventory admission failed: {binding_reason}")
    val snapshot = scv_compile_snapshot_open_v1(sosix_cwd(), source_root, revision,
        sosix_env_get_nullable("SIMPLE_SCV_COMMIT_ID") ?? "",
        sosix_env_get_nullable("SIMPLE_SCV_TREE_ID") ?? "", binding.snapshot_manifest_digest)
    if not snapshot.valid: return Err("cold HIR snapshot admission failed: {snapshot.reason}")
    val snapshot_inventory = match file_read_regular_no_follow_bounded(
            "{source_root}/SCV_COMPILE_INVENTORY", 256 * 1024 * 1024):
        case Ok(content): content
        case Err(reason): return Err("cold HIR snapshot inventory read failed: {reason}")
    if admitted.inventory == nil: return Err("cold HIR inventory payload missing")
    val inventory = admitted.inventory!
    val generation_text = sosix_env_get_nullable("SIMPLE_SCV_INVENTORY_GENERATION") ?? ""
    if inventory.generation < 0 or generation_text != "{inventory.generation}":
        val bounded_generation_text = if generation_text.len() > 32: generation_text[:32] else: generation_text
        return Err("cold HIR inventory generation mismatch: raw='{bounded_generation_text}' raw_len={generation_text.len()} admitted={inventory.generation} admitted_digest={admitted.digest}")
    val sources = cold_hir_source_inventory_admit_v1(source_root, binding.source_inventory_digest,
        inventory, snapshot_inventory, binding.snapshot_manifest_digest, ctx.source_paths_owner.len(),
        ctx.source_identities_owner.len(), ctx.source_byte_lengths_owner.len(), ctx.source_module_names_owner.len())?
    var inputs: [DriverColdHirModuleInputV1] = []
    var produced: Dict<text, bool> = {}
    var source_index = 0
    val backend = get_effective_backend_name(ctx.options.backend, ctx.options.release)
    while source_index < ctx.source_paths_owner.len():
        val row = cold_hir_source_inventory_row_v1(sources, inventory, source_index,
            ctx.source_paths_owner[source_index], ctx.source_identities_owner[source_index],
            ctx.source_byte_lengths_owner[source_index], ctx.source_module_names_owner[source_index])?
        # Every alias still proves its actual bytes. Only the first physical
        # publication provides the body lookup identity and gets a capture.
        if not produced.has(row.source_identity):
            inputs.push(DriverColdHirModuleInputV1(module_identity: row.module_identity,
                source_root: sources.normalized_root, source_identity: row.source_identity,
                source_digest: row.source_digest, source_byte_count: row.source_byte_count,
                snapshot_inventory_digest: binding.snapshot_manifest_digest,
                inventory_entry: row.inventory_entry, full_inventory: full, artifact_root: artifact_root,
                target_triple: ctx.native_target, backend: backend, source_index: source_index))
            produced[row.source_identity] = true
        source_index = source_index + 1
    # The retained production owner captures every typed ABI first. Its full
    # expected-count check and per-receipt CFG/owner/emission/witness checks
    # therefore belong to the accepted woven-body consumer after ABI capture,
    # not this pre-body source plan. Do not hide an ABI failure with a CFG or
    # expected-count refusal, or emit a module before another ABI is checked.
    Ok(DriverColdHirSourceCapturePlanV1(enabled: true, full_inventory: full,
        source_root: sources.normalized_root, source_inventory_digest: binding.source_inventory_digest,
        snapshot_inventory_digest: binding.snapshot_manifest_digest, inventory_generation: inventory.generation,
        source_count: ctx.source_paths_owner.len(), inputs: inputs))

pub fn driver_cold_hir_source_capture_plan_v1(ctx: CompileContext
) -> Result<DriverColdHirSourceCapturePlanV1, text>:
    if transient_array_scope_state_v1() != 0:
        return Err("cold HIR source admission lease occupied")
    if not transient_scope_begin(): return Err("cold HIR source admission lease unavailable")
    val result = driver_cold_hir_source_capture_plan_in_owned_scope_v1(ctx)
    val paused = transient_scope_pause()
    val owned = if paused: transient_promote(result) else: false
    val ended = transient_scope_end()
    if not paused or not owned or not ended: panic("cold HIR source admission ownership failed")
    result

export DriverColdHirSourceCapturePlanV1, driver_cold_hir_source_capture_plan_v1
