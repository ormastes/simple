# Aggregate scalar graphs in scratch, retaining only the complete gate report.
# This composes real validators; it does not authenticate mutable fact inputs.
use compiler.driver.cache.driver_hir_archive_weave_facts_v1.{DriverHirArchiveWeaveFactsV1}
use compiler.driver.cache.driver_hir_post_validation_policy_v1.{DriverHirPostValidationPolicyOwnerV1,
    driver_hir_post_validation_policy_load_in_owned_scope_v1}
use compiler.driver.cache.driver_hir_post_validation_gate_facts_v1.{
    DriverHirPostValidationGateReportV1, driver_hir_post_validation_gate_facts_v1}
use compiler.driver.driver_hir_cache.{hir_cache_last_warnings,
    hir_cache_clear_last_warnings, hir_cache_promote_diagnostic_owner_v1}
use compiler.semantics.value_struct_layout.{ValueStructLayoutModuleV1}
use compiler.semantics.layer_eq_checker.{LayerEqType}
use compiler.semantics.effect_validation.{EffectFunctionFactsV1}
use compiler.semantics.rt_criticality_validation.{RtCriticalFunctionFactsV1}
use compiler.semantics.join_point_model.{JoinPoint}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause,
    transient_scope_end, transient_promote}

fn driver_hir_archive_weave_gate_borrowed_v1(policy_owner: DriverHirPostValidationPolicyOwnerV1,
        facts: DriverHirArchiveWeaveFactsV1, logical_order: [text], layout_order: [text],
        layout_names: [text], publish_intermediate: bool
) -> Result<DriverHirPostValidationGateReportV1, text>:
    if transient_array_scope_state_v1() != 1:
        return Err("weave gate requires active unpaused aggregate ownership")
    if facts.declarations.len() != logical_order.len() or facts.bodies.len() != logical_order.len() or
            layout_order.len() != layout_names.len():
        return Err("weave gate complete declaration/body/order coverage differs")
    val policy = driver_hir_post_validation_policy_load_in_owned_scope_v1(policy_owner)?
    var seen: Dict<text, bool> = {}
    var identities: [text] = []
    var identity_index: Dict<text, bool> = {}
    var layers: [LayerEqType] = []
    var effects: [EffectFunctionFactsV1] = []
    var rt: [RtCriticalFunctionFactsV1] = []
    var forwards: [JoinPoint] = []
    var dropped: [text] = []
    var physical_paths: Dict<text, bool> = {}
    var next_join_point: i64 = 1
    for name in logical_order:
        if name == "" or seen.has(name) or not facts.declarations.has(name) or not facts.bodies.has(name):
            return Err("weave gate logical publication repeats or omits an actual row")
        seen[name] = true
        val declaration = facts.declarations[name]
        val row = declaration.row
        val body = facts.bodies[name]
        if row.module_key != name or body.module_key != name or body.archive_key != row.archive_key or
                body.body_digest != row.body_digest or body.lowering_warnings != row.lowering_warnings or
                body.first_join_point_id != next_join_point:
            return Err("weave gate body/declaration/warning/join-point predecessor differs")
        val path = row.value_layout.path.replace("\\", "/")
        if path == "": return Err("weave gate declaration physical path absent")
        physical_paths[path] = true
        # Retained identity adapters publish path, canonical HIR name, then
        # logical Dict key. The declaration DTO starts with the logical key;
        # restore the actual adapter order rather than rotate its array (a
        # logical key can itself equal the path or canonical name).
        var ordered_ids: [text] = []
        if row.value_layout.path != "": ordered_ids.push(row.value_layout.path)
        for identity in row.module_identities:
            if identity != name and not ordered_ids.contains(identity): ordered_ids.push(identity)
        if not ordered_ids.contains(name): ordered_ids.push(name)
        for identity in ordered_ids:
            if not identity_index.has(identity):
                identities.push(identity)
                identity_index[identity] = true
        if declaration.dropped: dropped.push(name)
        for layer in body.layer_layouts: layers.push(layer)
        for effect in body.effect_functions: effects.push(effect)
        for function in body.rt_functions: rt.push(function)
        for point in body.forwards: forwards.push(point)
        next_join_point = next_join_point + body.forwards.len()
    if facts.next_join_point != next_join_point:
        return Err("weave gate final join-point predecessor differs")
    var layouts: [ValueStructLayoutModuleV1] = []
    var layout_seen: Dict<text, bool> = {}
    var layout_paths: Dict<text, bool> = {}
    var index = 0
    for key in layout_order:
        if not seen.has(key) or layout_seen.has(key) or layout_names[index] == "":
            return Err("weave gate physical layout representative repeats or is absent")
        layout_seen[key] = true
        val row = facts.declarations[key].row.value_layout
        val path = row.path.replace("\\", "/")
        if layout_paths.has(path): return Err("weave gate physical layout source repeats")
        layout_paths[path] = true
        # The retained producer labels physical layout rows with the actual
        # frozen surface logical_name, distinct from a source alias Dict key.
        layouts.push(ValueStructLayoutModuleV1(name: layout_names[index], path: row.path,
            structs: row.structs, struct_symbols: row.struct_symbols))
        index = index + 1
    if layout_paths.len() != physical_paths.len():
        return Err("weave gate physical layout coverage omits an actual source")
    val report = driver_hir_post_validation_gate_facts_v1(layout_names, layouts,
        identities, identity_index, facts.layer_winners.keys(), layers, effects, rt,
        forwards, policy, dropped, logical_order.len(), publish_intermediate)
    Ok(report)

pub fn driver_hir_archive_weave_gate_v1(policy_owner: DriverHirPostValidationPolicyOwnerV1,
        facts: DriverHirArchiveWeaveFactsV1, logical_order: [text], layout_order: [text],
        layout_names: [text], publish_intermediate: bool = true
) -> Result<DriverHirPostValidationGateReportV1, text>:
    if transient_array_scope_state_v1() != 0 or hir_cache_last_warnings().len() != 0:
        return Err("weave gate aggregate lease or diagnostic owner occupied")
    if not transient_scope_begin(): return Err("weave gate aggregate lease unavailable")
    val result = driver_hir_archive_weave_gate_borrowed_v1(policy_owner, facts, logical_order,
        layout_order, layout_names, publish_intermediate)
    val paused = transient_scope_pause()
    # Only fresh Result diagnostics, counters and ordered weave recipe escape.
    # Policy decode and all whole-graph aggregation arrays remain scratch.
    val owned = if paused: transient_promote(result) else: false
    val memo = if paused: hir_cache_promote_diagnostic_owner_v1() else: false
    if paused: hir_cache_clear_last_warnings()
    val ended = transient_scope_end()
    if not paused or not owned or not memo or not ended: panic("weave gate aggregate ownership failed")
    result

export driver_hir_archive_weave_gate_v1
