# PromotionReceipt — schema `promotion_receipt` (simple/promotion-receipt/v2).
#
# Schema: src/compiler/80.driver/cache/schema/cache_protocol.sdn
#   class_all: PROVENANCE
#   order: [repository_id, source_commit, source_tree, trusted_ref, trusted_ref_tip,
#           clean_tree_digest, action_digest, result_manifest_digest, builder_id,
#           workflow_digest, toolchain_digest, external_parameters_digest,
#           timestamp, signature]
#   signed_over: "all fields except signature, in the order above"
#
# HARD RULE: every field here is PROVENANCE. `action_digest` is *referenced*, not
# recomputed from these fields — the receipt says "this trusted builder produced
# this mapping", it never participates in computing the key.

use compiler.driver.cache.action_key.{canon_str, canon_nat, canon_field, canon_seq}
use compiler.driver.cache.promotion.git_provenance.{GitProvenanceFacts, git_fetch_evidence_digest}
use std.common.crypto.sha256.{sha256_text}
use std.common.crypto.hmac.{hmac_sha256}

struct PromotionReceipt:
    repository_id: text
    source_commit: text
    source_tree: text
    trusted_ref: text
    trusted_ref_tip: text
    clean_tree_digest: text
    action_digest: text
    result_manifest_digest: text
    builder_id: text
    workflow_digest: text
    toolchain_digest: text
    external_parameters_digest: text
    timestamp: i64
    signature: text
    # Freshness evidence — not in the frozen 14-field signed body, but bound into
    # it via `external_parameters_digest` by `promotion_receipt_from_facts`.
    fetch_evidence_digest: text
    fetch_epoch_seconds: i64

# Canonical encoding of the SIGNED BODY: the 13 fields before `signature`.
fn promotion_receipt_encode_body(r: PromotionReceipt) -> text:
    var inner: [text] = []
    inner.push(canon_field("repositoryId", canon_str(r.repository_id)))
    inner.push(canon_field("sourceCommit", canon_str(r.source_commit)))
    inner.push(canon_field("sourceTree", canon_str(r.source_tree)))
    inner.push(canon_field("trustedRef", canon_str(r.trusted_ref)))
    inner.push(canon_field("trustedRefTip", canon_str(r.trusted_ref_tip)))
    inner.push(canon_field("cleanTreeDigest", canon_str(r.clean_tree_digest)))
    inner.push(canon_field("actionDigest", canon_str(r.action_digest)))
    inner.push(canon_field("resultManifestDigest", canon_str(r.result_manifest_digest)))
    inner.push(canon_field("builderId", canon_str(r.builder_id)))
    inner.push(canon_field("workflowDigest", canon_str(r.workflow_digest)))
    inner.push(canon_field("toolchainDigest", canon_str(r.toolchain_digest)))
    inner.push(canon_field("externalParametersDigest", canon_str(r.external_parameters_digest)))
    inner.push(canon_field("timestamp", canon_nat(r.timestamp)))
    canon_field("simple/promotion-receipt/v2", canon_seq(inner))

# Full encoding (body + signature), for storage.
fn promotion_receipt_encode(r: PromotionReceipt) -> text:
    var outer: [text] = []
    outer.push(canon_field("body", canon_str(promotion_receipt_encode_body(r))))
    outer.push(canon_field("signature", canon_str(r.signature)))
    canon_field("simple/promotion-receipt-signed/v2", canon_seq(outer))

fn promotion_receipt_digest(r: PromotionReceipt) -> text:
    sha256_text(promotion_receipt_encode(r))

# ----------------------------------------------------------------------------
# Signing / verification
# ----------------------------------------------------------------------------
# HMAC-SHA256 over the canonical body with the builder's attestation key. The key
# is looked up BY BUILDER ID from the verifier's trusted-builder table, so a
# receipt naming an unknown builder cannot verify at all.

fn promotion_receipt_sign(r: PromotionReceipt, signing_key: text) -> PromotionReceipt:
    var signed = r
    signed.signature = hmac_sha256(signing_key, promotion_receipt_encode_body(r))
    signed

struct TrustedBuilder:
    builder_id: text
    signing_key: text
    approved_workflow_digests: [text]

fn trusted_builder_key(builders: [TrustedBuilder], builder_id: text) -> text:
    for b in builders:
        if b.builder_id == builder_id:
            return b.signing_key
    ""

fn trusted_builder_approves_workflow(builders: [TrustedBuilder], builder_id: text, workflow_digest: text) -> bool:
    for b in builders:
        if b.builder_id == builder_id:
            for w in b.approved_workflow_digests:
                if w == workflow_digest:
                    return true
            return false
    false

struct ReceiptVerification:
    valid: bool
    reason: text

fn promotion_receipt_verify(r: PromotionReceipt, builders: [TrustedBuilder]) -> ReceiptVerification:
    if r.signature == "":
        return ReceiptVerification(valid: false, reason: "receipt is unsigned")
    val key = trusted_builder_key(builders, r.builder_id)
    if key == "":
        return ReceiptVerification(valid: false, reason: "unknown builder: " + r.builder_id)
    if not trusted_builder_approves_workflow(builders: builders, builder_id: r.builder_id, workflow_digest: r.workflow_digest):
        return ReceiptVerification(valid: false, reason: "workflow not approved for builder " + r.builder_id)
    val expect = hmac_sha256(key, promotion_receipt_encode_body(r))
    if expect != r.signature:
        return ReceiptVerification(valid: false, reason: "signature mismatch for builder " + r.builder_id)
    ReceiptVerification(valid: true, reason: "")

# ----------------------------------------------------------------------------
# Construction from git facts
# ----------------------------------------------------------------------------
# `external_parameters_digest` folds in the fetch-evidence digest, so the
# signature covers WHICH fetch produced the reachability proof.

fn promotion_receipt_from_facts(facts: GitProvenanceFacts, action_digest: text, result_manifest_digest: text, toolchain_digest: text, external_parameters: text, timestamp: i64) -> PromotionReceipt:
    val fetch_ev = git_fetch_evidence_digest(facts)
    val ext = sha256_text("simple/external-parameters/v2|" + external_parameters + "|fetch=" + fetch_ev)
    PromotionReceipt(
        repository_id: facts.repository_id,
        source_commit: facts.build_commit,
        source_tree: facts.build_tree,
        trusted_ref: facts.trusted_ref,
        trusted_ref_tip: facts.origin_main_tip,
        clean_tree_digest: facts.clean_tree_digest,
        action_digest: action_digest,
        result_manifest_digest: result_manifest_digest,
        builder_id: facts.builder_id,
        workflow_digest: facts.workflow_digest,
        toolchain_digest: toolchain_digest,
        external_parameters_digest: ext,
        timestamp: timestamp,
        signature: "",
        fetch_evidence_digest: fetch_ev,
        fetch_epoch_seconds: facts.fetch_epoch_seconds
    )

# A receipt must describe the SAME facts the gate is evaluating; otherwise a
# valid signature over some other build would admit this one.
fn promotion_receipt_matches_facts(r: PromotionReceipt, facts: GitProvenanceFacts) -> ReceiptVerification:
    if r.repository_id != facts.repository_id:
        return ReceiptVerification(valid: false, reason: "receipt repository_id does not match fetched repository")
    if r.source_commit != facts.build_commit:
        return ReceiptVerification(valid: false, reason: "receipt source_commit does not match the built commit")
    if r.source_tree != facts.build_tree:
        return ReceiptVerification(valid: false, reason: "receipt source_tree does not match the built tree")
    if r.trusted_ref != facts.trusted_ref:
        return ReceiptVerification(valid: false, reason: "receipt trusted_ref does not match")
    if r.trusted_ref_tip != facts.origin_main_tip:
        return ReceiptVerification(valid: false, reason: "receipt trusted_ref_tip does not match the freshly fetched tip")
    if r.clean_tree_digest != facts.clean_tree_digest:
        return ReceiptVerification(valid: false, reason: "receipt clean_tree_digest does not match")
    if r.builder_id != facts.builder_id:
        return ReceiptVerification(valid: false, reason: "receipt builder_id does not match the attested builder")
    if r.workflow_digest != facts.workflow_digest:
        return ReceiptVerification(valid: false, reason: "receipt workflow_digest does not match the attested workflow")
    if r.fetch_evidence_digest != git_fetch_evidence_digest(facts):
        return ReceiptVerification(valid: false, reason: "receipt fetch evidence does not match this fetch")
    ReceiptVerification(valid: true, reason: "")
