# PromotionReceipt — signed provenance evidence for the trusted remote-main
# action namespace.
#
# Design: doc/05_design/compiler/semantic_incremental_build_cache_aop_formal_2026-08-09.md
# §14.5 (PromotionReceipt fields), §15 (remote-main admission and promotion).
# Schema: doc/03_plan/compiler/cache/c0_schema_freeze_2026-08-09.md — PROVENANCE
# class fields (branch_name, source_commit, source_tree, trusted_ref,
# trusted_ref_tip, builder_id, signature, timestamp, ...) never enter the
# ActionKey; they live here instead.
#
# First-milestone scope: this module only DEFINES the receipt and its
# canonical encoding/digest. Nothing in this file, or anywhere in this
# agent's ownership (remote/, promotion/), writes a receipt into a trusted
# remote namespace. See remote/remote_policy.spl for the write-gate that
# keeps that path closed.
#
# Encoding reuses action_key.spl's canonical primitives (canon_str, canon_nat,
# canon_field, canon_seq) — no second hash scheme, per contract.

use std.common.crypto.sha256.{sha256_text}
use compiler.driver.cache.action_key.{canon_str, canon_nat, canon_field, canon_seq}

# Exactly the PromotionReceipt fields from design §14.5. Field order here is
# the canonical encoding order — do not reorder without a schema bump.
struct PromotionReceipt:
    repository_id: text            # Digest of authenticated repository identity
    source_commit: text            # GitCommitId — exact immutable source commit
    source_tree: text              # GitTreeId — exact source tree
    trusted_ref: text              # e.g. "refs/remotes/origin/main"
    trusted_ref_tip: text          # GitCommitId the trusted_ref pointed to at check time
    clean_tree_digest: text        # Digest proving a clean (non-dirty) worktree
    action_digest: text            # ActionDigest this receipt attests
    result_manifest_digest: text   # ResultManifest this receipt attests
    builder_id: text                # Trusted CI builder identity
    workflow_digest: text          # Digest of the protected workflow definition
    toolchain_digest: text         # Digest of the toolchain used to produce the result
    external_parameters_digest: text  # Digest of hermetic/declared action inputs
    timestamp: i64                 # Unix seconds
    signature: text                # Signature over the canonical encoding below

# Canonical encoding of every field EXCEPT `signature` itself — the signature
# is computed over this encoding, so it cannot include itself.
fn promotion_receipt_encode_unsigned(r: PromotionReceipt) -> text:
    var inner: [text] = []
    inner.push(canon_field("repositoryId", canon_str(r.repository_id)))
    inner.push(canon_field("sourceCommit", canon_str(r.source_commit)))
    inner.push(canon_field("sourceTree", canon_str(r.source_tree)))
    inner.push(canon_field("trustedRef", canon_str(r.trusted_ref)))
    inner.push(canon_field("trustedRefTip", canon_str(r.trusted_ref_tip)))
    inner.push(canon_field("cleanTreeDigest", canon_str(r.clean_tree_digest)))
    inner.push(canon_field("actionDigest", canon_str(r.action_digest)))
    inner.push(canon_field("resultManifestDigest", canon_str(r.result_manifest_digest)))
    inner.push(canon_field("builderId", canon_str(r.builder_id)))
    inner.push(canon_field("workflowDigest", canon_str(r.workflow_digest)))
    inner.push(canon_field("toolchainDigest", canon_str(r.toolchain_digest)))
    inner.push(canon_field("externalParametersDigest", canon_str(r.external_parameters_digest)))
    inner.push(canon_field("timestamp", canon_nat(r.timestamp)))
    canon_field("simple/promotion-receipt/v1", canon_seq(inner))

# Digest of the unsigned encoding — this is what `signature` signs over.
fn promotion_receipt_signing_digest(r: PromotionReceipt) -> text:
    sha256_text(promotion_receipt_encode_unsigned(r))

# Full canonical encoding INCLUDING the signature field, for content-addressed
# storage of the receipt itself (its own digest, distinct from the signing
# digest above).
fn promotion_receipt_encode(r: PromotionReceipt) -> text:
    val unsigned = promotion_receipt_encode_unsigned(r)
    canon_field("signed", canon_seq([unsigned, canon_field("signature", canon_str(r.signature))]))

fn promotion_receipt_digest(r: PromotionReceipt) -> text:
    sha256_text(promotion_receipt_encode(r))

export PromotionReceipt
export promotion_receipt_encode_unsigned, promotion_receipt_signing_digest
export promotion_receipt_encode, promotion_receipt_digest
