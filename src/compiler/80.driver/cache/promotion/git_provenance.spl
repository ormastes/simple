# Git provenance — the admission evidence for §15.1 / §15.3.
#
# Design: doc/05_design/compiler/semantic_incremental_build_cache_aop_formal_2026-08-09.md §15
#
# HARD RULE: git identity is PROVENANCE. Nothing in this file may ever be fed
# into `action_key_encode`. A commit id changes WHO may publish a mapping; it
# never changes WHICH action a mapping answers.
#
# The facts below are collected out-of-process by
# `scripts/cache/promotion/collect-git-provenance.shs`, which runs the real
# `git fetch --prune` + `git merge-base --is-ancestor`. This module is the pure
# decision function over those facts, so it is testable without a repository.

use std.common.crypto.sha256.{sha256_text}

# ============================================================================
# Merge strategies — §15.3
# ============================================================================

val MERGE_FAST_FORWARD = "fast_forward"
val MERGE_NORMAL_MERGE = "normal_merge"
val MERGE_REBASE = "rebase"
val MERGE_SQUASH = "squash"
val MERGE_CHERRY_PICK = "cherry_pick"
val MERGE_FORCE_PUSHED_AWAY = "force_pushed_away"

# §15.3, column "Direct promotion". Rebase promotes only the REBASED commits, so
# the strategy alone is not sufficient — see `git_merge_strategy_admits`.
fn git_merge_strategy_directly_promotable(strategy: text) -> bool:
    strategy == MERGE_FAST_FORWARD or strategy == MERGE_NORMAL_MERGE

fn git_merge_strategy_needs_rebuild(strategy: text) -> bool:
    strategy == MERGE_SQUASH or strategy == MERGE_CHERRY_PICK

fn git_merge_strategy_reason(strategy: text) -> text:
    if strategy == MERGE_SQUASH:
        return "squash merge: the built commit is not the commit on main; main must rebuild/reproduce and publish its own receipt"
    if strategy == MERGE_CHERRY_PICK:
        return "cherry-pick: the original commit is not an ancestor of main; main must rebuild/reproduce"
    if strategy == MERGE_REBASE:
        return "rebase: only the rebased commits carry a promotable identity; the pre-rebase branch receipt is not promoted"
    if strategy == MERGE_FORCE_PUSHED_AWAY:
        return "force-push removed the commit from the main snapshot: an existing entry may remain as immutable historical cache but receives no new promotion"
    ""

# ============================================================================
# GitProvenanceFacts — everything the gate is allowed to look at
# ============================================================================

# `fetch_*` fields are the freshness proof. `origin_main_tip_before_fetch` is
# recorded ONLY so a stale local ref can be *detected and reported*; it is never
# used as the reachability base.
struct GitProvenanceFacts:
    repository_url: text                # authenticated remote URL actually fetched
    repository_id: text                 # digest of the authenticated repo identity
    remote_authenticated: bool          # transport proved the remote's identity
    trusted_ref: text                   # e.g. "refs/remotes/origin/main"
    origin_main_tip_before_fetch: text
    origin_main_tip: text               # tip AFTER the fetch — the reachability base
    fetch_performed: bool               # a real `git fetch --prune` ran in THIS admission
    fetch_epoch_seconds: i64
    now_epoch_seconds: i64
    build_commit: text                  # exact immutable source commit built
    build_tree: text                    # git tree id of that commit
    worktree_clean: bool
    clean_tree_digest: text
    is_ancestor_of_main_tip: bool       # `git merge-base --is-ancestor $BUILD_COMMIT <tip>`
    merge_strategy: text
    rebased_commit: text                # for MERGE_REBASE: the commit actually on main ("" otherwise)
    builder_id: text
    builder_is_trusted: bool
    workflow_digest: text
    workflow_is_approved: bool

# Maximum age of the fetch that still counts as "freshly fetched".
val GIT_FETCH_MAX_AGE_SECONDS = 300

fn git_fetch_age_seconds(facts: GitProvenanceFacts) -> i64:
    facts.now_epoch_seconds - facts.fetch_epoch_seconds

fn git_fetch_is_fresh(facts: GitProvenanceFacts) -> bool:
    if not facts.fetch_performed:
        return false
    val age = git_fetch_age_seconds(facts)
    if age < 0:
        return false
    age <= GIT_FETCH_MAX_AGE_SECONDS

# A local ref that was never re-fetched is developer-controlled state, not a
# trust proof — even when it happens to be correct.
fn git_origin_main_is_stale(facts: GitProvenanceFacts) -> bool:
    not git_fetch_is_fresh(facts)

# ============================================================================
# The ancestry + freshness proof
# ============================================================================

struct GitAdmission:
    admitted: bool
    reason: text

fn git_admission_ok() -> GitAdmission:
    GitAdmission(admitted: true, reason: "")

fn git_admission_deny(reason: text) -> GitAdmission:
    GitAdmission(admitted: false, reason: reason)

# Strategy-aware ancestry. The reachability answer is only meaningful against a
# FRESHLY FETCHED tip, so freshness is checked first and separately.
fn git_merge_strategy_admits(facts: GitProvenanceFacts) -> GitAdmission:
    val s = facts.merge_strategy
    if s == MERGE_FORCE_PUSHED_AWAY:
        return git_admission_deny(git_merge_strategy_reason(s))
    if git_merge_strategy_needs_rebuild(s):
        return git_admission_deny(git_merge_strategy_reason(s))
    if s == MERGE_REBASE:
        # Only the rebased commit is promotable, and only if it IS the commit we
        # built. A receipt naming the pre-rebase commit is refused.
        if facts.rebased_commit == "":
            return git_admission_deny(git_merge_strategy_reason(s))
        if facts.rebased_commit != facts.build_commit:
            return git_admission_deny("rebase: receipt names pre-rebase commit " + facts.build_commit + ", main carries rebased commit " + facts.rebased_commit)
        return git_admission_ok()
    if git_merge_strategy_directly_promotable(s):
        return git_admission_ok()
    git_admission_deny("unknown merge strategy: " + s)

# Full §15.1 gate over git facts alone. Receipt/signature checks live in
# promotion_gate.spl; this is the git half.
fn git_provenance_admits(facts: GitProvenanceFacts) -> GitAdmission:
    if not facts.worktree_clean:
        return git_admission_deny("dirty worktree: promotion requires a clean source tree")
    if facts.build_commit == "":
        return git_admission_deny("no exact immutable source commit recorded")
    if facts.build_tree == "":
        return git_admission_deny("no source tree id recorded")
    if not facts.remote_authenticated:
        return git_admission_deny("remote repository identity was not authenticated")
    if facts.repository_id == "" or facts.repository_url == "":
        return git_admission_deny("no authenticated repository identity recorded")
    if facts.trusted_ref == "":
        return git_admission_deny("no trusted ref recorded")
    if git_origin_main_is_stale(facts):
        return git_admission_deny("stale origin/main: a developer-controlled local ref is not a trust proof (fetch_performed=" + "{facts.fetch_performed}" + ", age=" + "{git_fetch_age_seconds(facts)}" + "s)")
    if facts.origin_main_tip == "":
        return git_admission_deny("fetched trusted-ref tip is empty")
    if not facts.builder_is_trusted:
        return git_admission_deny("builder " + facts.builder_id + " is not a trusted CI builder")
    if not facts.workflow_is_approved:
        return git_admission_deny("workflow " + facts.workflow_digest + " is not an approved protected workflow")
    val strat = git_merge_strategy_admits(facts)
    if not strat.admitted:
        return strat
    if not facts.is_ancestor_of_main_tip:
        return git_admission_deny("build commit " + facts.build_commit + " is not reachable from freshly fetched " + facts.trusted_ref + " @ " + facts.origin_main_tip)
    git_admission_ok()

# Digest over the freshness evidence, bound into the receipt so the proof cannot
# be silently swapped for a different fetch.
fn git_fetch_evidence_digest(facts: GitProvenanceFacts) -> text:
    var s = "simple/git-fetch-evidence/v2"
    s = s + "|url=" + facts.repository_url
    s = s + "|repo=" + facts.repository_id
    s = s + "|ref=" + facts.trusted_ref
    s = s + "|tip=" + facts.origin_main_tip
    s = s + "|at=" + "{facts.fetch_epoch_seconds}"
    sha256_text(s)
