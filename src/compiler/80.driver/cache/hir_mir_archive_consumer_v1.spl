    mono_archive_final_repository_matches_v1, mono_archive_load_final_module_in_owned_scope_v1,
    mono_archive_final_specialization_selections_in_owned_scope_v1}
use compiler.driver.cache.hir_owned_artifact_cache_v1.{hir_owned_artifact_context_v1}
use compiler.driver.driver_hir_cache.{hir_cache_promote_diagnostic_owner_v1,
    hir_cache_clear_last_warnings, hir_cache_last_warnings}
use compiler.hir.hir_types.{HirModule, SymbolTable}
use compiler.mir.hir_declaration_summary_v1.*
use compiler.mir.hir_declaration_types_v1.{MirHirParamDeclarationV1, MirHirFunctionDeclarationV1,
    MirHirFieldDeclarationV1, MirHirNominalDeclarationV1, MirHirVariantDeclarationV1,
    MirHirEnumDeclarationV1, MirHirTraitDeclarationV1, MirHirGlobalDeclarationV1,
    MirHirDeclarationSourceV1, MirHirModuleDeclarationsV1, MirHirDeclarationRepositoryV1,
    MirHirCallableDefaultsV1}
use compiler.mir.mir_lowering_types.{MirLowering, MirError}
use compiler.mir.mir_instructions.{MirModule, MirFunction}
use compiler.mir.mir_data.{bootstrap_fn_registries_promote,
    bootstrap_fn_param_defaults_detach_for_archive_v1}
