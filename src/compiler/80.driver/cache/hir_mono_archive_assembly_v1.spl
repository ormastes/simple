use compiler.driver.cache.hir_mono_archive_consumer_v1.{mono_archive_selected_function_v1, mono_archive_repository_input_v1, MonoArchivePublicationV1}
use compiler.driver.cache.hir_mono_replay_selection_v1.{MonoArchiveSelectedFunctionV1,
    mono_archive_reassemble_body_input_in_owned_scope_v1}
use compiler.mono.mono_archive_body_input_v1.*
use compiler.mono.mono_archive_current_body_v1.{MonoArchiveCurrentBodyLoadV1}
# Complete module assembly is explicitly unverified until aggregate post-mono
# validators and the driver's existing diagnostic policy admit it.
use compiler.hir.hir_types.{HirModule}
use compiler.hir.hir_codec.{hir_module_encode}
use compiler.hir.hir_codec_support.{HirCodecWriter}
use compiler.mono.monomorphize_integration.{mono_sym_key}
use compiler.mono.mono_archive_state_v1.{mono_archive_state_digest_v1}
use compiler.driver.cache.hir_body_typecheck_lease_v1.{HirBodyArchiveV1,
    hir_body_archive_matches_v1, hir_body_archive_warnings_digest_v1}
use compiler.driver.cache.hir_mono_archive_consumer_v1.{MonoArchivePublicationV1}
use compiler.driver.cache.hir_mono_archive_execution_v1.{MonoArchiveExecutionV1,
    mono_archive_execution_complete_v1}
use compiler.driver.driver_hir_cache.{hir_cache_load_in_owned_scope, hir_cache_store_in_owned_scope,
    hir_cache_last_warnings, hir_cache_clear_last_warnings, hir_cache_promote_diagnostic_owner_v1}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause,
    transient_scope_end, transient_promote}

struct MonoArchiveAssembledModuleV1:
    input_archive: HirBodyArchiveV1
    archive_key: text
    body_digest: text
    lowering_warnings_digest: text
    coverage_digest: text
    closure_state_digest: text
    final_symbol_counter: i64
    stage: text
    body_input: MonoArchiveBodyInputV1? = nil

fn mono_archive_assembled_key_v1(descriptor: MonoArchiveAssembledModuleV1) -> text:
    var writer = HirCodecWriter.create()
    writer.put_text(descriptor.input_archive.archive_key)
    writer.put_text(descriptor.input_archive.body_digest)
    writer.put_text(descriptor.body_digest)
    writer.put_text(descriptor.lowering_warnings_digest)
    writer.put_text(descriptor.coverage_digest)
    writer.put_text(descriptor.closure_state_digest)
    writer.put_i64(descriptor.final_symbol_counter)
    writer.put_text(descriptor.stage)
    if val input = descriptor.body_input:
        if not mono_archive_body_input_matches_v1(input) or input.original_parent.archive_key != descriptor.input_archive.archive_key: return ""
        writer.put_text(mono_archive_body_input_key_v1(input))
        writer.put_text(mono_archive_body_input_digest_v1(input))
        if val body = input.current_body:
            writer.put_text(body.parent_boundary_key)
            writer.put_text(body.parent_boundary_digest)
        else:
            return ""
        if val cache = input.current_cache:
            writer.put_text(cache.directory)
            writer.put_text(cache.producer_header)
            writer.put_bool(cache.enabled)
        else:
            return ""
        if input.logical_name != "": writer.put_text(input.logical_name)
    if not writer.ok: return ""
    if val input = descriptor.body_input:
        if input.logical_name != "": return sha256_text("mono-logical-assembled-module-key-v1\n" + writer.finish())
    sha256_text("mono-assembled-module-key-v1\n" + writer.finish())

fn mono_archive_assembled_module_name_v1(descriptor: MonoArchiveAssembledModuleV1) -> text:
    if val input = descriptor.body_input: return mono_archive_body_input_module_name_v1(input)
    descriptor.input_archive.input.module_name

# The retained pass inserts symbol rows in module order, then specialization
# publication order. Equal complete input artifacts represent the same actual
# alias-shared body owner; a name or SymbolId match alone is never sufficient.
fn mono_archive_shared_symbol_publications_v1(owner: MonoArchiveExecutionV1,
        input: MonoArchiveBodyInputV1) -> Result<[MonoArchiveSelectedFunctionV1], text>:
    var rows: [MonoArchiveSelectedFunctionV1] = []
    if input.logical_name == "": return Ok(rows)
    if not owner.admission.repository.logical_mode or input.current_body == nil:
        return Err("mono shared symbol repository mode refused")
    val current = input.current_body.unwrap()
    for root in owner.roots:
        if not owner.admission.repository.current_bodies.has(root.module_name) or
                not owner.admission.repository.modules.has(root.module_name): return Err("mono shared symbol input missing")
        # Completed-execution validation owns whole repository admission. This
        # grouping compares pinned compact identities only, avoiding corpus
        # source reads or complete body loads per alias. Selected rows are read
        # and validated against the complete input by the assembly consumer.
        val candidate = owner.admission.repository.current_bodies[root.module_name]
        if owner.admission.repository.modules[root.module_name].archive_key != input.original_parent.archive_key or
                candidate.current_artifact_key != current.current_artifact_key or
                candidate.current_body_digest != current.current_body_digest: continue
        for receipt in owner.specialization_records:
            if receipt.module_name == root.module_name: rows = rows.push(mono_archive_selected_function_v1(receipt))
    Ok(rows)

fn mono_archive_module_coverage_v1(owner: MonoArchiveExecutionV1, name: text) -> text:
    var writer = HirCodecWriter.create()
    writer.put_text(owner.admission.repository.authority)
    writer.put_text(owner.schedule_digest)
    writer.put_text(name)
    var found = false
    for module in owner.roots:
        if module.module_name != name: continue
        found = true
        writer.put_i64(module.symbols.len())
        for symbol in module.symbols:
            val key = mono_sym_key(name, symbol)
            if not owner.root_records.has(key): return ""
            val receipt: MonoArchivePublicationV1 = owner.root_records[key]
            writer.put_i64(symbol)
            writer.put_text(receipt.output_archive_key)
            writer.put_text(receipt.function_archive_key)
            writer.put_text(receipt.delta_digest)
    if not found: return ""
    var count = 0
    for receipt in owner.specialization_records:
        if receipt.module_name == name: count = count + 1
    writer.put_i64(count)
    for receipt in owner.specialization_records:
        if receipt.module_name != name: continue
        writer.put_i64(receipt.target_symbol)
        writer.put_text(receipt.target_name)
        writer.put_text(receipt.output_archive_key)
        writer.put_text(receipt.function_archive_key)
        writer.put_text(receipt.delta_digest)
    if not writer.ok: return ""
    sha256_text("mono-complete-module-coverage-v1\n" + writer.finish())

fn mono_archive_assembly_record_matches_v1(receipt: MonoArchivePublicationV1,
        archive: HirBodyArchiveV1) -> bool:
    receipt.module_name == archive.input.module_name and
        receipt.input_archive_key == archive.archive_key and receipt.input_body_digest == archive.body_digest

fn mono_archive_assemble_module_v1(owner: MonoArchiveExecutionV1,
        name: text) -> Result<MonoArchiveAssembledModuleV1, text>:
    if not mono_archive_execution_complete_v1(owner) or not owner.admission.repository.modules.has(name):
        return Err("mono assembly execution coverage refused")
    if not transient_scope_begin(): return Err("mono assembly scope unavailable")
    val archive: HirBodyArchiveV1 = owner.admission.repository.modules[name]
    val input_result = mono_archive_repository_input_v1(owner.admission.repository, name)
    val state_digest = mono_archive_state_digest_v1(owner.admission.state)
    val coverage = mono_archive_module_coverage_v1(owner, name)
    var descriptor: MonoArchiveAssembledModuleV1? = nil
    if state_digest != "" and coverage != "" and input_result.is_ok():
        val input = input_result.unwrap()
        var roots: [MonoArchiveSelectedFunctionV1] = []
        for module in owner.roots:
            if module.module_name != name: continue
            for symbol in module.symbols:
                roots = roots.push(mono_archive_selected_function_v1(owner.root_records[mono_sym_key(name, symbol)]))
        var specializations: [MonoArchiveSelectedFunctionV1] = []
        for receipt in owner.specialization_records:
            if receipt.module_name == name: specializations = specializations.push(mono_archive_selected_function_v1(receipt))
        var unresolved: [text] = []
        for template in owner.admission.state.unresolved_templates.keys(): unresolved = unresolved.push(template)
        var emitted: [text] = []
        for item in owner.admission.state.queue:
            if owner.admission.state.emitted.has(item.mangled_name): emitted = emitted.push(item.template_name)
        val shared = mono_archive_shared_symbol_publications_v1(owner, input)
        var reassembled: Result<MonoArchiveCurrentBodyLoadV1, text> = Err("mono shared symbol schedule refused")
        if shared.is_ok():
            reassembled = mono_archive_reassemble_body_input_in_owned_scope_v1(input,
                roots, specializations, unresolved, emitted, owner.admission.state.next_symbol, shared.unwrap(),
                owner.admission.state.facts.symbol_projections[name] ?? "",
                owner.admission.state.symbol_patches[name] ?? [], owner.admission.state.nominal_imports)
        if reassembled.is_ok():
            val output = reassembled.unwrap().module
            val valid = true
            if valid:
                var assembled = MonoArchiveAssembledModuleV1(input_archive: archive,
                    archive_key: "", body_digest: sha256_text(hir_module_encode(output)),
                    lowering_warnings_digest: mono_archive_body_input_warnings_digest_v1(input),
                    coverage_digest: coverage, closure_state_digest: state_digest,
                    final_symbol_counter: output.symbols.next_symbol_id, stage: "mono-assembled-unverified-v1",
                    body_input: if input.current_body != nil: Some(input) else: nil)
                assembled.archive_key = mono_archive_assembled_key_v1(assembled)
                if assembled.archive_key != "" and hir_cache_store_in_owned_scope(
                        assembled.archive_key, output, reassembled.unwrap().warnings): descriptor = Some(assembled)
    val admitted = descriptor != nil
    val paused = transient_scope_pause()
    val owned = if paused and admitted: transient_promote(descriptor) else: false
    val cache_owned = if paused: hir_cache_promote_diagnostic_owner_v1() else: false
    if paused: hir_cache_clear_last_warnings()
    val ended = transient_scope_end()
    if not paused or not ended or not cache_owned or (admitted and not owned): panic("mono assembly ownership")
    if val complete = descriptor: return Ok(complete)
    Err("mono assembly complete input, function records, or publication refused")

fn mono_archive_load_assembled_module_in_owned_scope_v1(descriptor: MonoArchiveAssembledModuleV1) -> Result<HirModule, text>:
    if transient_array_scope_state_v1() != 1 or hir_cache_last_warnings().len() != 0 or
            descriptor.stage != "mono-assembled-unverified-v1" or
            descriptor.archive_key != mono_archive_assembled_key_v1(descriptor) or
            descriptor.coverage_digest.len() != 64 or descriptor.closure_state_digest.len() != 64 or
            not hir_body_archive_matches_v1(descriptor.input_archive, descriptor.input_archive.input):
        return Err("mono assembled descriptor or owned scope refused")
    if val module = hir_cache_load_in_owned_scope(descriptor.archive_key):
        if module.name == descriptor.input_archive.input.module_name and
                module.path == descriptor.input_archive.input.source_path and
                sha256_text(hir_module_encode(module)) == descriptor.body_digest and
                module.symbols.next_symbol_id == descriptor.final_symbol_counter and
                hir_body_archive_warnings_digest_v1(hir_cache_last_warnings()) == descriptor.lowering_warnings_digest:
            return Ok(module)
    Err("mono assembled complete body refused")

export MonoArchiveAssembledModuleV1
export mono_archive_assemble_module_v1, mono_archive_load_assembled_module_in_owned_scope_v1
export mono_archive_assembled_module_name_v1, mono_archive_shared_symbol_publications_v1
export mono_archive_assembled_key_v1
