# Shared immutable package archive authority types.

use std.common.crypto.sha256.{sha256_text}
use compiler.driver.cache.cache_text_join.{cache_text_join_v1}

struct PackageArchiveMemberReceiptV1:
    name: text
    offset: u64
    extent: u64
    payload_digest: text

struct PackageActionKeyV1:
    digest: text

struct PackageArchiveReceiptV1:
    package_key: text
    action_key: text
    archive_digest: text
    normalized_metadata_digest: text
    producer_identity: text
    producer_digest: text
    variant_digest: text
    dependency_interface_digests: [text]
    members: [PackageArchiveMemberReceiptV1]
    receipt_digest: text

fn package_action_key_digest_v1(key: PackageActionKeyV1) -> text:
    key.digest

fn package_archive_receipt_canonical_fields_v1(
    receipt: PackageArchiveReceiptV1
) -> text:
    val dependencies = cache_text_join_v1(
        receipt.dependency_interface_digests, ",")
    if dependencies == nil:
        return ""
    val dependency_text = dependencies.unwrap()
    var encoded = "simple-package-archive-receipt-v1\n"
    encoded = encoded + "package={receipt.package_key}\n"
    encoded = encoded + "action={receipt.action_key}\n"
    encoded = encoded + "archive={receipt.archive_digest}\n"
    encoded = encoded + "metadata={receipt.normalized_metadata_digest}\n"
    encoded = encoded + "producer-identity={receipt.producer_identity}\n"
    encoded = encoded + "producer={receipt.producer_digest}\n"
    encoded = encoded + "variant={receipt.variant_digest}\n"
    encoded = encoded + "dependencies={dependency_text}\n"
    encoded = encoded + "members={receipt.members.len()}\n"
    for member in receipt.members:
        encoded = encoded + "member={member.name.len()}:{member.name}:"
        encoded = encoded + "{member.offset}:{member.extent}:{member.payload_digest}\n"
    encoded

fn package_archive_receipt_digest_v1(receipt: PackageArchiveReceiptV1) -> text:
    val fields = package_archive_receipt_canonical_fields_v1(receipt)
    if fields == "":
        return ""
    sha256_text(fields)

fn package_archive_receipt_action_digest_v1(
    receipt: PackageArchiveReceiptV1
) -> text:
    receipt.action_key

export PackageArchiveMemberReceiptV1, PackageActionKeyV1
export PackageArchiveReceiptV1
export package_action_key_digest_v1, package_archive_receipt_digest_v1
export package_archive_receipt_action_digest_v1
export package_archive_receipt_canonical_fields_v1
