# The one TLDR layout: {cache_dir}/tldr holds one file per module, and every
# writer publishes through tldr_publish_v1. A file's content is determined by
# its module and source, and readers verify the source digest, so writers need
# no lock or lease: the rename is atomic and the last writer wins.
use std.nogc_sync_mut.io.disk_admission.{disk_publish_admitted}
use std.nogc_sync_mut.io.file_ops.{file_atomic_write}
use std.nogc_sync_mut.io_runtime.{dir_create_all}

pub fn tldr_dir_v1(cache_dir: text) -> text:
    cache_dir + "/tldr"

pub fn tldr_publish_v1(path: text, content: text) -> bool:
    val slash = path.rfind("/")
    val dir = if slash > 0: path.substring(0, slash) else: "."
    if slash > 0 and not dir_create_all(dir):
        return false
    if not disk_publish_admitted(dir, content.len()):
        return false
    file_atomic_write(path, content)

export tldr_dir_v1, tldr_publish_v1
