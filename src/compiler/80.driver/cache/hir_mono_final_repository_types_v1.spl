use compiler.driver.cache.hir_mono_archive_assembly_v1.{MonoArchiveAssembledModuleV1}
use compiler.driver.cache.hir_mono_verification_use_v1.{MonoArchiveVerificationUseV1}
use compiler.driver.cache.driver_hir_archive_current_boundary_v1.{DriverHirArchiveCurrentBoundaryV1}
use compiler.driver.cache.driver_hir_archive_inventory_v1.{DriverHirArchiveInventoryV1}

# Failure publication provenance, never successful admission authority. Only
# the real production factory's failed publisher branches issue AlreadyPublished.
enum MonoArchiveFinalFailureV1:
    Unpublished(diagnostics: [text])
    AlreadyPublished(reason: text)

struct MonoArchiveFinalEmissionRowV1:
    source_index: i64
    logical_name: text
    hir_owner_name: text
    emission_name: text
    path: text
    is_entry: bool

# Complete bodies live in the cache, never in this issued repository.
struct MonoArchiveFinalRepositoryV1:
    authority: text
    artifact_key: text
    modules: Dict<text, MonoArchiveAssembledModuleV1>
    ordered_inventory: [text]
    declaration_order: [text]
    emission_rows: [MonoArchiveFinalEmissionRowV1]
    schedule_kind: text
    physical_inventory: DriverHirArchiveInventoryV1
    current_parent: DriverHirArchiveCurrentBoundaryV1
    verification: MonoArchiveVerificationUseV1? = nil
    zero_templates: bool
    force_all_sources: bool
    allow_bootstrap_shortcuts: bool
    bootstrap_mode: text
    report_digest: text
    collection_digest: text
    serial: i64

export MonoArchiveFinalEmissionRowV1, MonoArchiveFinalRepositoryV1
export MonoArchiveFinalFailureV1
