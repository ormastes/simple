# Strict intermediate body for weave -> cold capture -> optional quiet resolve.
# This mechanical descriptor does not authenticate the actual gate/weaver. The
# driver prerequisite owner must pin its exact original and transform boundary.
use compiler.driver.cache.hir_body_typecheck_lease_v1.{HirBodyArchiveV1,
    hir_body_archive_matches_v1, hir_body_archive_warnings_digest_v1}
use compiler.driver.cache.driver_cold_hir_module_capture_v1.{DriverColdHirModuleInputV1,
    DriverColdHirModuleCaptureV1, driver_cold_hir_capture_module_in_owned_scope_v1}
use compiler.hir.hir_types.{HirModule}
use compiler.hir.hir_codec.{hir_module_encode, hir_module_decode_stable}
use compiler.hir.hir_codec_support.{HirCodecWriter}
use compiler.hir.hir_complete_body_frame_v1.{HirCompleteBodyFrameIdentityV1,
    hir_complete_body_frame_encode_v1, hir_complete_body_frame_key_v1, hir_complete_body_frame_decode_v1}
use compiler.common.cache_contract.hir_owned_artifact_cache_v1.{HirOwnedArtifactContextV1,
    hir_owned_artifact_store_blob_v1, hir_owned_artifact_load_blob_v1}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.common.crypto.sha256.{sha256_text}

struct DriverColdHirWeaveBodyV1:
    original_parent: HirBodyArchiveV1
    artifact_key: text
    body_digest: text
    warnings_digest: text
    stage: text
    boundary_key: text
    boundary_digest: text

struct DriverColdHirWeaveBodyLoadV1:
    module: HirModule
    warnings: [text]

fn driver_cold_hir_weave_frame_identity_v1(body: DriverColdHirWeaveBodyV1) -> HirCompleteBodyFrameIdentityV1:
    HirCompleteBodyFrameIdentityV1(stage: "post-hir-weave-v1",
        module_name: body.original_parent.input.module_name, source_path: body.original_parent.input.source_path,
        original_archive_key: body.original_parent.archive_key, original_body_digest: body.original_parent.body_digest,
        original_warnings_digest: body.original_parent.lowering_warnings_digest,
        boundary_key: body.boundary_key, boundary_digest: body.boundary_digest)

pub fn driver_cold_hir_weave_body_digest_v1(body: DriverColdHirWeaveBodyV1) -> text:
    if transient_array_scope_state_v1() != 1 or body.stage != "post-hir-weave-v1" or
            body.artifact_key.len() != 64 or body.body_digest.len() != 64 or body.warnings_digest.len() != 64 or
            body.boundary_key.len() != 64 or body.boundary_digest.len() != 64 or
            body.artifact_key == body.original_parent.archive_key or
            not hir_body_archive_matches_v1(body.original_parent, body.original_parent.input): return ""
    var writer = HirCodecWriter.create()
    writer.put_text(body.original_parent.archive_key)
    writer.put_text(body.original_parent.body_digest)
    writer.put_text(body.original_parent.lowering_warnings_digest)
    writer.put_text(body.artifact_key)
    writer.put_text(body.body_digest)
    writer.put_text(body.warnings_digest)
    writer.put_text(body.stage)
    writer.put_text(body.boundary_key)
    writer.put_text(body.boundary_digest)
    if not writer.ok: return ""
    sha256_text("driver-cold-hir-weave-mechanical-v1\n" + writer.finish())

pub fn driver_cold_hir_weave_body_store_in_owned_scope_v1(context: HirOwnedArtifactContextV1,
        original: HirBodyArchiveV1, boundary_key: text, boundary_digest: text,
        module: HirModule, warnings: [text]) -> Result<DriverColdHirWeaveBodyV1, text>:
    if transient_array_scope_state_v1() != 1: return Err("cold weave body store requires active unpaused ownership")
    if not context.enabled or context.producer_header != original.input.producer_header:
        return Err("cold weave body producer differs from original")
    val blob = hir_module_encode(module)
    if blob == "" or module.name != original.input.module_name or module.path != original.input.source_path or
            boundary_key.len() != 64 or boundary_digest.len() != 64 or not hir_body_archive_matches_v1(original, original.input):
        return Err("cold weave body original parent or complete encoding refused")
    var body = DriverColdHirWeaveBodyV1(original_parent: original, artifact_key: "",
        body_digest: sha256_text(blob), warnings_digest: hir_body_archive_warnings_digest_v1(warnings),
        stage: "post-hir-weave-v1", boundary_key: boundary_key, boundary_digest: boundary_digest)
    val identity = driver_cold_hir_weave_frame_identity_v1(body)
    val frame = hir_complete_body_frame_encode_v1(identity, blob, warnings)
    if frame == "": return Err("cold weave body frame refused")
    body.artifact_key = hir_complete_body_frame_key_v1(identity, frame, "driver-cold-hir-weave-body-artifact-v1")
    if driver_cold_hir_weave_body_digest_v1(body) == "": return Err("cold weave body completed identity refused")
    val stored = hir_owned_artifact_store_blob_v1(context, body.artifact_key, frame)
    if stored.is_err(): return Err(stored.unwrap_err())
    Ok(body)

pub fn driver_cold_hir_weave_body_load_in_owned_scope_v1(context: HirOwnedArtifactContextV1,
        body: DriverColdHirWeaveBodyV1) -> Result<DriverColdHirWeaveBodyLoadV1, text>:
    if transient_array_scope_state_v1() != 1 or driver_cold_hir_weave_body_digest_v1(body) == "":
        return Err("cold weave body read scope or descriptor refused")
    if not context.enabled or context.producer_header != body.original_parent.input.producer_header:
        return Err("cold weave body read producer differs from original")
    val frame = hir_owned_artifact_load_blob_v1(context, body.artifact_key)?
    val identity = driver_cold_hir_weave_frame_identity_v1(body)
    val payload = hir_complete_body_frame_decode_v1(frame, identity)?
    if hir_complete_body_frame_key_v1(identity, frame, "driver-cold-hir-weave-body-artifact-v1") != body.artifact_key or
            sha256_text(payload.blob) != body.body_digest or
            hir_body_archive_warnings_digest_v1(payload.warnings) != body.warnings_digest:
        return Err("cold weave body stable identity refused")
    if val module = hir_module_decode_stable(payload.blob):
        if module.name == body.original_parent.input.module_name and module.path == body.original_parent.input.source_path:
            return Ok(DriverColdHirWeaveBodyLoadV1(module: module, warnings: payload.warnings))
    Err("cold weave complete module identity refused")

# The full accepted driver owner remains required before this mechanical read.
# No lifecycle is acquired and no complete body escapes into the capture DTO.
pub fn driver_cold_hir_capture_weave_body_in_owned_scope_v1(context: HirOwnedArtifactContextV1,
        body: DriverColdHirWeaveBodyV1, input: DriverColdHirModuleInputV1
) -> Result<DriverColdHirModuleCaptureV1, text>:
    val loaded = driver_cold_hir_weave_body_load_in_owned_scope_v1(context, body)?
    driver_cold_hir_capture_module_in_owned_scope_v1(loaded.module, input)

export DriverColdHirWeaveBodyV1, DriverColdHirWeaveBodyLoadV1
export driver_cold_hir_weave_body_digest_v1, driver_cold_hir_weave_body_store_in_owned_scope_v1
export driver_cold_hir_weave_body_load_in_owned_scope_v1, driver_cold_hir_capture_weave_body_in_owned_scope_v1
