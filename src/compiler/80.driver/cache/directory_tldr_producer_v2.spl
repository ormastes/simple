# REQ-DTA-A1: connect the shared directory producer to real file TLDRs.
# SourceReader owns freshness and cache/file routing. This adapter never hashes
# source text as though it were a TLDR and never invents a missing companion.
# The compile owner must freeze the source/provider snapshot across this call;
# atomic directory publication and scheduling remain separate owner work.
use std.common.crypto.sha256.{sha256_text}
use compiler.driver.cache.source_reader_v1.{SourceReader}
use compiler.common.cache_contract.package_init_tld_v1.{PackageInitTldV1,
    package_init_tld_valid_v1}
use compiler.common.cache_contract.package_init_directory_v2.{FileTldrDigestV2,
    package_init_directory_produce_v2}
use compiler.common.cache_contract.aspect_match_shard_v1.{DirectoryJoinPointFactsV1}

pub fn directory_tldr_from_reader_v2<R: SourceReader>(reader: R,
        base: PackageInitTldV1, facts: DirectoryJoinPointFactsV1,
        compiler_provider_id: text) -> Result<PackageInitTldV1, text>:
    if not package_init_tld_valid_v1(base): return Err("directory-package-invalid")
    if facts.scope_id != base.package_id or not facts.complete or
            facts.sorted_member_files != base.ordered_member_ids:
        return Err("directory-facts-mismatch")
    var members: [FileTldrDigestV2] = []
    for path in base.ordered_member_ids:
        val companion = reader.read_tldr(path)
        if companion == "": return Err("directory-file-tldr-unavailable: {path}")
        members.push(FileTldrDigestV2(member_id: path, tldr_digest: sha256_text(companion)))
    package_init_directory_produce_v2(base, members, facts, compiler_provider_id)
