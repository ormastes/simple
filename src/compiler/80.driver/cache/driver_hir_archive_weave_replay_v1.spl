# Actual replay of the entire pre-cold boundary. Source claims, cross-module
# graphs and gates are freshly collected. Advice executes in original claim
# order, and exact-parent aliases share every newly woven current body.
use compiler.driver.driver_compiler_type.{CompilerDriver}
use compiler.driver.cache.driver_hir_archive_weave_inputs_v1.{DriverHirArchiveWeaveInputsV1,
    driver_hir_weave_inputs_v1, driver_hir_weave_recollect_facts_v1}
use compiler.driver.cache.driver_hir_archive_weave_gate_v1.{driver_hir_archive_weave_gate_v1}
use compiler.driver.cache.driver_hir_post_validation_gate_facts_v1.{DriverHirPostValidationGateReportV1,
    driver_print_post_hir_validation_fatal}
use compiler.driver.cache.driver_hir_archive_weave_body_v1.{driver_hir_weave_seed_v1,
    driver_hir_weave_rewrite_v1}
use compiler.driver.cache.driver_cold_hir_weave_body_v1.{DriverColdHirWeaveBodyV1}
use compiler.driver.cache.driver_hir_archive_weave_encoding_v1.{driver_hir_weave_gate_report_bytes_v1}
use compiler.common.cache_contract.hir_owned_artifact_cache_v1.{hir_owned_artifact_store_blob_v1}
use compiler.hir.hir_codec_support.{HirCodecWriter}
use compiler.driver.driver_log_helpers.{log_phase}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause,
    transient_scope_end, transient_promote}

struct DriverHirArchiveWeaveParentV1:
    key: text
    digest: text

struct DriverHirArchiveWeaveReplayV1:
    inputs: DriverHirArchiveWeaveInputsV1
    report: DriverHirPostValidationGateReportV1
    parent: DriverHirArchiveWeaveParentV1
    logical_frames: Dict<text, DriverColdHirWeaveBodyV1>
    physical_frames: Dict<text, DriverColdHirWeaveBodyV1>
    woven_count: i64

# Publication provenance belongs to the actual replay call. Context totals
# cannot distinguish an infrastructure refusal from diagnostics already added.
enum DriverHirArchiveWeaveFailureV1:
    Unpublished(text)
    AlreadyPublished(text)

pub fn driver_hir_archive_weave_failure_message_v1(failure: DriverHirArchiveWeaveFailureV1) -> text:
    match failure:
        Unpublished(message): message
        AlreadyPublished(message): message

fn driver_hir_weave_parent_borrowed_v1(inputs: DriverHirArchiveWeaveInputsV1,
        report: DriverHirPostValidationGateReportV1) -> Result<DriverHirArchiveWeaveParentV1, text>:
    if transient_array_scope_state_v1() != 1: return Err("weave parent requires actual scratch ownership")
    var writer = HirCodecWriter.create()
    writer.put_text("driver-hir-weave-actual-gate-parent-v1")
    writer.put_text(inputs.journal.last_key)
    writer.put_text(inputs.journal.registration_digest)
    writer.put_i64(inputs.journal.registration_epoch)
    writer.put_text(inputs.policy.artifact_key)
    writer.put_text(inputs.policy.artifact_digest)
    writer.put_text(inputs.schedule.schedule_digest)
    writer.put_text(inputs.schedule.closure_digest)
    writer.put_text(inputs.inventory.inventory_digest)
    writer.put_text(inputs.config_binding)
    writer.put_text(driver_hir_weave_gate_report_bytes_v1(report))
    val bytes = writer.finish()
    val digest = sha256_text(bytes)
    val key = sha256_text("driver-hir-weave-gate-parent-artifact-v1\n" + digest + "\n" + inputs.policy.cache.producer_header)
    val stored = hir_owned_artifact_store_blob_v1(inputs.policy.cache, key, bytes)?
    if not stored: return Err("weave actual gate parent publication refused")
    Ok(DriverHirArchiveWeaveParentV1(key, digest))

fn driver_hir_weave_parent_v1(inputs: DriverHirArchiveWeaveInputsV1,
        report: DriverHirPostValidationGateReportV1) -> Result<DriverHirArchiveWeaveParentV1, text>:
    if not transient_scope_begin(): return Err("weave parent publication lease unavailable")
    val result = driver_hir_weave_parent_borrowed_v1(inputs, report)
    val paused = transient_scope_pause()
    val owned = if paused: transient_promote(result) else: false
    val ended = transient_scope_end()
    if not paused or not owned or not ended: panic("weave parent publication ownership failed")
    result

pub fn driver_hir_archive_weave_replay_with_failure_v1(driver: CompilerDriver,
        publish_intermediate: bool,
        consume_original_manifest: bool = false) -> Result<DriverHirArchiveWeaveReplayV1, DriverHirArchiveWeaveFailureV1>:
    if transient_array_scope_state_v1() != 0: return Err(DriverHirArchiveWeaveFailureV1.Unpublished("weave replay foreign lease occupied"))
    val inputs = match driver_hir_weave_inputs_v1(driver):
        Ok(value): value
        Err(message): return Err(DriverHirArchiveWeaveFailureV1.Unpublished(message))
    val facts = match driver_hir_weave_recollect_facts_v1(driver, inputs):
        Ok(value): value
        Err(message): return Err(DriverHirArchiveWeaveFailureV1.Unpublished(message))
    val report = match driver_hir_archive_weave_gate_v1(inputs.policy, facts, inputs.journal.logical_order,
        inputs.layout_keys, inputs.schedule.layout_module_order, publish_intermediate, consume_original_manifest):
        Ok(value): value
        Err(message): return Err(DriverHirArchiveWeaveFailureV1.Unpublished(message))
    # Even an earlier gate failure does not skip advice when aspects succeeded.
    # Genuine partial census failure alone skips every dereferencing gate/weave.
    val parent = match driver_hir_weave_parent_v1(inputs, report):
        Ok(value): value
        Err(message): return Err(DriverHirArchiveWeaveFailureV1.Unpublished(message))
    var by_original: Dict<text, DriverColdHirWeaveBodyV1> = {}
    var logical: Dict<text, DriverColdHirWeaveBodyV1> = {}
    var physical: Dict<text, DriverColdHirWeaveBodyV1> = {}
    var woven = 0
    if not report.gates_skipped and report.aspect_errors.len() == 0:
        if publish_intermediate: log_phase("phase3:hir:validate:weave:start")
        # Establish one complete shared current body per exact original parent.
        for archive in inputs.inventory.ordered_archives:
            val frame = match driver_hir_weave_seed_v1(inputs.policy.cache, archive, parent.key, parent.digest):
                Ok(value): value
                Err(message): return Err(DriverHirArchiveWeaveFailureV1.Unpublished(message))
            by_original[archive.archive_key] = frame
        for claim in report.weave_claims:
            for name in inputs.journal.logical_order:
                val original = inputs.journal.logical_archives[name]
                if not by_original.has(original.archive_key): return Err(DriverHirArchiveWeaveFailureV1.Unpublished("weave exact shared original body absent"))
                val result = match driver_hir_weave_rewrite_v1(inputs.policy.cache, by_original[original.archive_key],
                    name, facts.identities, claim):
                    Ok(value): value
                    Err(message): return Err(DriverHirArchiveWeaveFailureV1.Unpublished(message))
                woven = woven + result.woven
                # Sharing by the verified exact original parent models the real
                # functions Dict shared by canonical and logical alias entries.
                by_original[original.archive_key] = result.frame
        for name in inputs.journal.logical_order:
            val original = inputs.journal.logical_archives[name]
            logical[name] = by_original[original.archive_key]
        for archive in inputs.inventory.ordered_archives:
            physical[archive.input.module_name] = by_original[archive.archive_key]
        if publish_intermediate: log_phase("phase3:hir:validate:weave:done")
    if publish_intermediate: driver_print_post_hir_validation_fatal(report.errors)
    # No cold capture, quiet resolution or successful owner follows errors.
    # Capture publishes exactly the original validation errors to its context;
    # read-use replay reports a refusal without adding duplicate diagnostics.
    if report.errors.len() > 0:
        val message = "post-HIR actual validation failed after ordered weave: " + report.errors.join("\n")
        if publish_intermediate:
            for error in report.errors: driver.ctx.add_error(error)
            return Err(DriverHirArchiveWeaveFailureV1.AlreadyPublished(message))
        return Err(DriverHirArchiveWeaveFailureV1.Unpublished(message))
    if report.gates_skipped or logical.len() != inputs.journal.logical_order.len() or
            physical.len() != inputs.inventory.ordered_modules.len():
        return Err(DriverHirArchiveWeaveFailureV1.Unpublished("weave successful body coverage is incomplete"))
    Ok(DriverHirArchiveWeaveReplayV1(inputs, report, parent, logical, physical, woven))

# Preserve the existing text API for read-use and legacy capture callers.
pub fn driver_hir_archive_weave_replay_v1(driver: CompilerDriver,
        publish_intermediate: bool,
        consume_original_manifest: bool = false) -> Result<DriverHirArchiveWeaveReplayV1, text>:
    match driver_hir_archive_weave_replay_with_failure_v1(driver, publish_intermediate, consume_original_manifest):
        Ok(value): Ok(value)
        Err(failure): Err(driver_hir_archive_weave_failure_message_v1(failure))

export DriverHirArchiveWeaveParentV1, DriverHirArchiveWeaveReplayV1
export driver_hir_archive_weave_replay_v1
export DriverHirArchiveWeaveFailureV1, driver_hir_archive_weave_failure_message_v1
export driver_hir_archive_weave_replay_with_failure_v1
