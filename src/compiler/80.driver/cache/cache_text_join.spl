# Explicit text-list join for cache formats. Native method binding can confuse
# [text].join with path.join when both are present in an entry closure.

extern fn rt_string_builder_new() -> i64
extern fn rt_string_builder_push(handle: i64, part: text) -> i64
extern fn rt_string_builder_finish(handle: i64) -> text
extern fn rt_string_builder_free(handle: i64)

fn cache_text_join_v1(parts: [text], separator: text) -> text?:
    val builder = rt_string_builder_new()
    if builder == 0:
        return nil
    var first = true
    for part in parts:
        if not first and rt_string_builder_push(builder, separator) == 0:
            rt_string_builder_free(builder)
            return nil
        if rt_string_builder_push(builder, part) == 0:
            rt_string_builder_free(builder)
            return nil
        first = false
    Some(rt_string_builder_finish(builder))

export cache_text_join_v1
