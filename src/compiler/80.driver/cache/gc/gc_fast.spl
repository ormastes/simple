# Fast GC — the cheap pass run at the high watermark (design §18.4)
#
# Agent C3. Phase order is fixed and cheapest-first, so the common case never
# pays for a full mark:
#   1. expired temp files
#   2. expired quarantine entries
#   3. remote-branch action mappings past TTL
#   4. lowest-value unpinned action mappings (eviction ranking)
#   5. CAS blobs with no remaining reference (approximate refcount)
#   6. atomic rename of every candidate into trash/     [gc_storage_port]
#   7. asynchronous delete of trash                     [gc_storage_port]
#
# Phases 1-5 only PLAN. Nothing is touched until gc_storage_port executes the
# plan, and the plan is a pure function of the snapshot — so a dry run and a real
# run produce byte-identical plans.
#
# Phase 5 uses the APPROXIMATE refcount, which may over-count (never under-count
# in the direction that matters): an over-counted blob is simply not collected
# this pass, which is a wasted byte, not a dangling hit. An under-counted blob
# would be a dangling hit, so phase 5 additionally refuses any digest that the
# lease set or the root set names.

use compiler.driver.cache.metadata.gc_config.{GcLimits, GcRetention, gc_bytes_to_free, gc_should_stop}
use compiler.driver.cache.metadata.cache_metadata.{CacheMetadataTable}
use compiler.driver.cache.gc.gc_index.{GcIndex, GcRoots, gc_roots_all, gc_index_blob_size}
use compiler.driver.cache.gc.gc_eviction.{EvictionCandidate, eviction_candidate_of, gc_rank_candidates, gc_select_evictions, gc_selected_bytes}

struct GcTempEntry:
    """A file under <root>/tmp/ observed at snapshot time."""
    path: text
    created_at: i64
    size_bytes: i64

struct GcQuarantineEntry:
    path: text
    quarantined_at: i64
    size_bytes: i64

struct GcBranchMapping:
    """A branch-namespace action mapping with a TTL deadline."""
    action_digest: text
    expires_at: i64
    size_bytes: i64

struct GcFastPlan:
    """What fast GC WOULD do. Purely declarative; nothing has moved yet."""
    expired_temp: [text]
    expired_quarantine: [text]
    expired_branch_mappings: [text]
    evicted_mappings: [text]
    unreferenced_blobs: [text]
    bytes_reclaimable: i64
    reached_low_watermark: bool

fn gc_fast_plan_empty() -> GcFastPlan:
    GcFastPlan(expired_temp: [], expired_quarantine: [], expired_branch_mappings: [],
               evicted_mappings: [], unreferenced_blobs: [],
               bytes_reclaimable: 0, reached_low_watermark: true)

fn gc_expired_temp(entries: [GcTempEntry], now: i64, retention: GcRetention) -> [text]:
    var out: [text] = []
    for e in entries:
        if now - e.created_at >= retention.tmp_seconds:
            out = out.push(e.path)
    out

fn gc_expired_quarantine(entries: [GcQuarantineEntry], now: i64, retention: GcRetention) -> [text]:
    var out: [text] = []
    for e in entries:
        if now - e.quarantined_at >= retention.quarantine_seconds:
            out = out.push(e.path)
    out

fn gc_expired_branch_mappings(mappings: [GcBranchMapping], now: i64) -> [text]:
    var out: [text] = []
    for m in mappings:
        if m.expires_at > 0 and now >= m.expires_at:
            out = out.push(m.action_digest)
    out

# Phase 5. A blob is collectable only when ALL of:
#   - its approximate refcount is 0,
#   - no active lease or root names it,
#   - it is not itself already scheduled by an earlier phase.
fn gc_unreferenced_blobs(index: GcIndex, table: CacheMetadataTable,
                         roots: GcRoots, lease_refs: [text]) -> [text]:
    var out: [text] = []
    val rooted = gc_roots_all(roots)
    for b in index.blobs:
        var refcount: i64 = -1
        if table.index_of.contains_key(b.digest):
            refcount = table.entries[table.index_of[b.digest]].refcount_approx
        if refcount != 0:
            continue
        var held = false
        for d in rooted:
            if d == b.digest:
                held = true
        for d in lease_refs:
            if d == b.digest:
                held = true
        if not held:
            out = out.push(b.digest)
    out

# Build the eviction candidate set: every metadata entry that is neither a root
# nor lease-held. Roots and leased digests are not even offered to the ranker.
fn gc_fast_candidates(table: CacheMetadataTable, roots: GcRoots,
                      lease_refs: [text], now: i64) -> [EvictionCandidate]:
    var out: [EvictionCandidate] = []
    val rooted = gc_roots_all(roots)
    for m in table.entries:
        var held = false
        for d in rooted:
            if d == m.digest:
                held = true
        for d in lease_refs:
            if d == m.digest:
                held = true
        if not held:
            out = out.push(eviction_candidate_of(m, now))
    out

# The whole fast pass, as a plan.
fn gc_fast_plan(index: GcIndex, table: CacheMetadataTable, roots: GcRoots,
                lease_refs: [text], temp: [GcTempEntry], quarantine: [GcQuarantineEntry],
                branch_mappings: [GcBranchMapping], limits: GcLimits,
                retention: GcRetention, used_bytes: i64, now: i64) -> GcFastPlan:
    val tmp_gone = gc_expired_temp(temp, now, retention)
    val quar_gone = gc_expired_quarantine(quarantine, now, retention)
    val branch_gone = gc_expired_branch_mappings(branch_mappings, now)

    var freed: i64 = 0
    for e in temp:
        for p in tmp_gone:
            if p == e.path:
                freed = freed + e.size_bytes
    for e in quarantine:
        for p in quar_gone:
            if p == e.path:
                freed = freed + e.size_bytes
    for m in branch_mappings:
        for d in branch_gone:
            if d == m.action_digest:
                freed = freed + m.size_bytes

    val target = gc_bytes_to_free(limits, used_bytes)
    var remaining = target - freed
    if remaining < 0:
        remaining = 0

    val ranked = gc_rank_candidates(gc_fast_candidates(table, roots, lease_refs, now))
    val evicted = gc_select_evictions(ranked, remaining)
    freed = freed + gc_selected_bytes(ranked, evicted)

    val blobs = gc_unreferenced_blobs(index, table, roots, lease_refs)
    for d in blobs:
        freed = freed + gc_index_blob_size(index, d)

    GcFastPlan(
        expired_temp: tmp_gone,
        expired_quarantine: quar_gone,
        expired_branch_mappings: branch_gone,
        evicted_mappings: evicted,
        unreferenced_blobs: blobs,
        bytes_reclaimable: freed,
        reached_low_watermark: gc_should_stop(limits, used_bytes - freed),
    )

fn gc_fast_plan_is_empty(plan: GcFastPlan) -> bool:
    (plan.expired_temp.len() == 0 and plan.expired_quarantine.len() == 0
     and plan.expired_branch_mappings.len() == 0 and plan.evicted_mappings.len() == 0
     and plan.unreferenced_blobs.len() == 0)

# Every digest/path fast GC would move into trash/, in execution order.
fn gc_fast_trash_order(plan: GcFastPlan) -> [text]:
    var out: [text] = []
    for p in plan.expired_temp:
        out = out.push(p)
    for p in plan.expired_quarantine:
        out = out.push(p)
    for d in plan.expired_branch_mappings:
        out = out.push(d)
    for d in plan.evicted_mappings:
        out = out.push(d)
    for d in plan.unreferenced_blobs:
        out = out.push(d)
    out
