# Pre-write admission control — cache_protocol.sdn `gc.limits.machine`
# (hard_limit_ratio, min_free_ratio) and `gc.pinned_overflow_report`
# ("never delete a protected root to meet a size target").
#
# A write that would push the store over the hard limit, or that has less
# than min_free_bytes headroom, is rejected: the caller gets AdmissionSkip
# and the build continues without caching that one artifact. This is a
# storage-accounting decision only; it never touches identity/trust classes
# (see cache_protocol.sdn header note on CAS/TRUST/GC_METADATA separation).

@unsafe(reason: "raw file probe; false includes absent, inaccessible, or provider failure", capabilities: [ffi])
extern fn rt_file_exists(path: text) -> bool
@unsafe(reason: "raw pin read; empty text is valid data and also the unreadable or provider-failure sentinel", capabilities: [ffi])
extern fn rt_file_read_text(path: text) -> text
@unsafe(reason: "raw file size; nil includes absent, inaccessible, or provider failure", capabilities: [ffi])
extern fn rt_file_size(path: text) -> usize?
@unsafe(reason: "raw directory probe; false includes non-directory, inaccessible, or provider failure", capabilities: [ffi])
extern fn rt_dir_exists(path: text) -> bool
@unsafe(reason: "raw directory walk; empty data includes an empty tree or provider failure", capabilities: [ffi])
extern fn rt_dir_walk(root: text) -> [text]

use compiler.driver.cache.metadata.cache_limits.{
    CacheLimits, cache_limits_hard_limit_bytes, cache_limits_min_free_bytes,
}
use compiler.driver.cache.cas_store.{cas_blob_path}

struct AdmissionResult:
    admitted: bool
    reason: text

struct PinnedOverflowReport:
    protected_bytes: i64
    configured_max: i64
    largest_roots: [text]
    suggested_action: text

fn admission_dir_total_bytes(root: text) -> i64?:
    var exists = false
    unsafe(capabilities: [ffi]):
        exists = rt_file_exists(root)
    if not exists:
        return nil
    var total: i64 = 0
    var accounting_valid = true
    unsafe(capabilities: [ffi]):
        for path in rt_dir_walk(root):
            if not rt_dir_exists(path):
                match rt_file_size(path):
                    case Some(sz):
                        total = total + sz.to_i64()
                    case nil:
                        accounting_valid = false
    if not accounting_valid:
        return nil
    total

fn admission_cache_total_bytes(root: text) -> i64?:
    match admission_dir_total_bytes("{root}/cas"):
        case Some(cas_bytes):
            match admission_dir_total_bytes("{root}/actions"):
                case Some(action_bytes):
                    cas_bytes + action_bytes
                case nil:
                    nil
        case nil:
            nil

# Reads pins the same way mark_sweep.spl does (root/pins, one digest/line) —
# duplicated here rather than imported to keep admission a leaf module gc/
# fast_gc and gc/mark_sweep can both run without depending on each other.
fn read_pins(root: text) -> [text]:
    val path = "{root}/pins"
    var exists = false
    unsafe(capabilities: [ffi]):
        exists = rt_file_exists(path)
    if not exists:
        return []
    var content = ""
    unsafe(capabilities: [ffi]):
        content = rt_file_read_text(path) ?? ""
    var out: [text] = []
    for line in content.split("\n"):
        if line.trim() != "":
            out = out.push(line.trim())
    out

# Bytes protected by explicit pins (approximate: sums matching blob sizes).
fn pinned_bytes(root: text) -> i64?:
    val pins = read_pins(root)
    if pins.len() == 0:
        return 0
    var total: i64 = 0
    for digest in pins:
        val path = cas_blob_path(root, digest)
        unsafe(capabilities: [ffi]):
            match rt_file_size(path):
                case Some(sz):
                    total = total + sz.to_i64()
                case nil:
                    return nil
    total

# Pre-write admission check. write_bytes is the size of the write about to
# happen; pass 0 to check current headroom only (e.g. before a GC pass).
#
# min_free_ratio is scoped to the cache's own configured budget (max_bytes),
# not host filesystem free space — no rt_ runtime symbol exposes real disk
# free bytes today (checked: unresolvable-here). It reserves a slice of the
# configured quota so a burst of writes cannot fill 100% of max_bytes before
# GC gets a chance to run.
fn admission_check(root: text, limits: CacheLimits, write_bytes: i64) -> AdmissionResult:
    val hard_limit = cache_limits_hard_limit_bytes(limits)
    val current = match admission_cache_total_bytes(root):
        case Some(bytes): bytes
        case nil:
            return AdmissionResult(admitted: false, reason: "accounting_unavailable")
    val projected = current + write_bytes

    if projected > hard_limit:
        return AdmissionResult(admitted: false, reason: "over_hard_limit")

    val min_free = cache_limits_min_free_bytes(limits)
    val headroom = limits.max_bytes - projected
    if headroom < min_free:
        return AdmissionResult(admitted: false, reason: "under_min_free_reserve")

    AdmissionResult(admitted: true, reason: "ok")

# PinnedOverflow: protected (pinned) bytes alone exceed max_bytes. Per the
# schema rule, this NEVER triggers deletion of a protected root — it is a
# report only, surfaced so an operator/CI can raise the quota or unpin.
fn pinned_overflow_check(root: text, limits: CacheLimits) -> PinnedOverflowReport?:
    val protected = match pinned_bytes(root):
        case Some(bytes): bytes
        case nil: return nil
    if protected <= limits.max_bytes:
        return nil
    PinnedOverflowReport(
        protected_bytes: protected,
        configured_max: limits.max_bytes,
        largest_roots: read_pins(root),
        suggested_action: "raise max_bytes or unpin roots; protected roots are never auto-deleted",
    )
