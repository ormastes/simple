# GC index and roots — the snapshot GC reasons over (design §18.3, §18.4)
#
# Agent C3. GC never walks live storage while deciding: it takes a SNAPSHOT
# (manifest graph + blob table + roots), decides against the snapshot, and only
# then performs renames. This is what makes "a leased artifact survives a
# concurrent GC" checkable, and it is why every function in this file is pure.
#
# STORAGE INTERFACE ASSUMED FROM C1 (cas_store.spl / action_key.spl — NOT edited
# here). C3 consumes exactly this much and nothing more:
#
#   cas_root() -> text
#   cas_blob_path(root, digest) -> text
#   cas_action_path(root, digest) -> text
#   cas_has(root, digest) -> bool
#   cas_get(root, digest) -> text?            # verified read; corrupt => nil
#   cas_quarantine(root, path) -> bool
#   action_get(root, action_digest) -> <manifest>?
#   <manifest>.action_digest : text
#   <manifest>.artifact_digests : [text]
#
# and, when C1 widens ActionManifest into ResultManifest (schema §4), the
# additional closure edges:
#   .dependency_manifest : text
#   .aop_group_roots : [text]
#   .block_manifest_root : text?
#
# ASSUMPTION TO RECONCILE: C3 models those edges in `ManifestNode` NOW, populated
# by the loader in gc_storage_port.spl. Until C1 lands ResultManifest, the loader
# fills only `action_digest` + `artifact_digests` and leaves the other edge lists
# empty; the mark algorithm is unchanged either way. C3 also assumes blob sizes
# come from GC metadata, not a stat() call, since no rt_file_size extern is
# relied on here.

struct ManifestNode:
    """One result/action manifest and every digest reachable from it."""
    digest: text                     # digest of the manifest object itself
    action_digest: text
    artifact_digests: [text]
    dependency_manifests: [text]
    aop_group_roots: [text]
    block_manifest_roots: [text]

struct BlobNode:
    digest: text
    size_bytes: i64

struct GcIndex:
    """Immutable snapshot of the physical store, as GC sees it."""
    manifests: [ManifestNode]
    blobs: [BlobNode]

fn gc_index_new(manifests: [ManifestNode], blobs: [BlobNode]) -> GcIndex:
    GcIndex(manifests: manifests, blobs: blobs)

fn gc_index_find_manifest(index: GcIndex, digest: text) -> ManifestNode?:
    for m in index.manifests:
        if m.digest == digest:
            return m
    nil

fn gc_index_blob_size(index: GcIndex, digest: text) -> i64:
    for b in index.blobs:
        if b.digest == digest:
            return b.size_bytes
    0

fn gc_index_total_blob_bytes(index: GcIndex) -> i64:
    var total: i64 = 0
    for b in index.blobs:
        total = total + b.size_bytes
    total

# Every outgoing edge of a manifest, in one list.
fn gc_manifest_edges(m: ManifestNode) -> [text]:
    var out: [text] = []
    for d in m.artifact_digests:
        out = out.push(d)
    for d in m.dependency_manifests:
        out = out.push(d)
    for d in m.aop_group_roots:
        out = out.push(d)
    for d in m.block_manifest_roots:
        out = out.push(d)
    out

# ---------------------------------------------------------------------------
# Roots (schema gc.roots)
# ---------------------------------------------------------------------------

struct GcRoots:
    """Root sets, snapshotted before marking. Order matches schema gc.roots."""
    active_lease_refs: [text]
    in_flight_publications: [text]
    explicit_pins: [text]
    workspace_last_successful: [text]
    retained_main_generations: [text]
    bootstrap_catalogs: [text]
    release_tag_manifests: [text]
    retained_verification_evidence: [text]
    toolchain_and_schema_artifacts: [text]

fn gc_roots_empty() -> GcRoots:
    GcRoots(
        active_lease_refs: [],
        in_flight_publications: [],
        explicit_pins: [],
        workspace_last_successful: [],
        retained_main_generations: [],
        bootstrap_catalogs: [],
        release_tag_manifests: [],
        retained_verification_evidence: [],
        toolchain_and_schema_artifacts: [],
    )

fn gc_roots_all(roots: GcRoots) -> [text]:
    var out: [text] = []
    for d in roots.active_lease_refs:
        out = out.push(d)
    for d in roots.in_flight_publications:
        out = out.push(d)
    for d in roots.explicit_pins:
        out = out.push(d)
    for d in roots.workspace_last_successful:
        out = out.push(d)
    for d in roots.retained_main_generations:
        out = out.push(d)
    for d in roots.bootstrap_catalogs:
        out = out.push(d)
    for d in roots.release_tag_manifests:
        out = out.push(d)
    for d in roots.retained_verification_evidence:
        out = out.push(d)
    for d in roots.toolchain_and_schema_artifacts:
        out = out.push(d)
    out

fn gc_roots_contains(roots: GcRoots, digest: text) -> bool:
    for d in gc_roots_all(roots):
        if d == digest:
            return true
    false

# Roots that must never be deleted to hit a size target: pins, bootstrap,
# release tags, active leases, retained main generations.
fn gc_protected_roots(roots: GcRoots) -> [text]:
    var out: [text] = []
    for d in roots.active_lease_refs:
        out = out.push(d)
    for d in roots.explicit_pins:
        out = out.push(d)
    for d in roots.retained_main_generations:
        out = out.push(d)
    for d in roots.bootstrap_catalogs:
        out = out.push(d)
    for d in roots.release_tag_manifests:
        out = out.push(d)
    out
