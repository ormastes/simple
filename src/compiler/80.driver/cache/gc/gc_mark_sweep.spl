# Full mark-and-sweep — the source of truth (design §18.4, §18.5)
#
# Agent C3. Refcounts are an optimization. THIS is the authority: after a crash
# or a lost race, whatever mark-and-sweep says is reachable is reachable, and the
# refcount/size metadata is REPAIRED to agree with it (never the other way).
#
# Order, per §18.4:
#   1. snapshot roots (pins, retained mappings, active leases)   [caller / gc_index]
#   2. mark result manifests reachable from those roots
#   3. recursively mark dependency/AOP/block manifests, packs, chunks, blobs
#   4. compare the marked closure with the physical CAS
#   5. move unmarked objects to trash/ atomically                [gc_storage_port]
#   6. revalidate the retained action-manifest closure
#   7. rebuild/repair approximate refcounts and size metadata
#   8. delete trash after a grace period                          [gc_storage_port]
#
# Steps 5 and 8 are the only ones that touch the filesystem, and they live in
# gc_storage_port.spl. Everything here is pure and therefore directly testable.

use compiler.driver.cache.gc.gc_index.{GcIndex, GcRoots, ManifestNode, gc_index_find_manifest, gc_manifest_edges, gc_roots_all, gc_index_blob_size}
use compiler.driver.cache.metadata.cache_metadata.{CacheMetadata, CacheMetadataTable, cache_metadata_table_put, cache_metadata_table_get}

struct GcMarkResult:
    """Outcome of steps 2-4."""
    marked: [text]
    marked_index: {text: i64}       # digest -> 1; i64 values only (native-safe)
    unmarked: [text]                # physical objects not in the closure
    unreachable_edges: [text]       # edges naming objects the store does not hold

fn gc_mark_contains(result: GcMarkResult, digest: text) -> bool:
    result.marked_index.contains_key(digest)

# Steps 2-3: iterative worklist closure from the root set. No recursion (deep
# manifest chains would otherwise blow the interpreter stack) and no closures.
fn gc_mark(index: GcIndex, roots: GcRoots) -> GcMarkResult:
    var seen: {text: i64} = {}
    var marked: [text] = []
    var missing: [text] = []
    var work: [text] = gc_roots_all(roots)
    var head: i64 = 0
    while head < work.len():
        val digest = work[head]
        head = head + 1
        if digest == "":
            continue
        if seen.contains_key(digest):
            continue
        seen[digest] = 1
        marked = marked.push(digest)
        val node = gc_index_find_manifest(index, digest)
        if val m = node:
            for e in gc_manifest_edges(m):
                if not seen.contains_key(e):
                    work = work.push(e)
        else:
            # Not a manifest: it is a blob, a pack, or absent. Absent is an
            # integrity finding, never a licence to delete something else.
            if not gc_index_blob_present(index, digest):
                missing = missing.push(digest)

    var unmarked: [text] = []
    for m in index.manifests:
        if not seen.contains_key(m.digest):
            unmarked = unmarked.push(m.digest)
    for b in index.blobs:
        if not seen.contains_key(b.digest):
            unmarked = unmarked.push(b.digest)

    GcMarkResult(marked: marked, marked_index: seen, unmarked: unmarked,
                 unreachable_edges: missing)

fn gc_index_blob_present(index: GcIndex, digest: text) -> bool:
    for b in index.blobs:
        if b.digest == digest:
            return true
    false

# Step 5 input: what to rename into trash/. Nothing marked can ever appear here,
# which is precisely the "no dangling successful hit" guarantee.
fn gc_sweep_candidates(result: GcMarkResult) -> [text]:
    var out: [text] = []
    for d in result.unmarked:
        if not result.marked_index.contains_key(d):
            out = out.push(d)
    out

# Step 6: revalidate the retained closure. Returns every digest that is required
# by a retained manifest but is NOT physically present. A non-empty result means
# the retained mapping must be dropped (a MISS), never served.
fn gc_revalidate_closure(index: GcIndex, roots: GcRoots) -> [text]:
    var broken: [text] = []
    var seen: {text: i64} = {}
    var work: [text] = gc_roots_all(roots)
    var head: i64 = 0
    while head < work.len():
        val digest = work[head]
        head = head + 1
        if digest == "" or seen.contains_key(digest):
            continue
        seen[digest] = 1
        val node = gc_index_find_manifest(index, digest)
        if val m = node:
            for e in gc_manifest_edges(m):
                work = work.push(e)
        else:
            if not gc_index_blob_present(index, digest):
                broken = broken.push(digest)
    broken

# An edge resolves when the store physically holds it, as a blob or a manifest.
fn gc_edge_resolvable(index: GcIndex, digest: text) -> bool:
    if gc_index_blob_present(index, digest):
        return true
    val node = gc_index_find_manifest(index, digest)
    if val _m = node:
        return true
    false

# Manifests whose closure is broken: their action mappings must be unpublished so
# a lookup degrades to a MISS rather than returning a manifest with holes.
fn gc_broken_manifests(index: GcIndex) -> [text]:
    var out: [text] = []
    for m in index.manifests:
        var ok = true
        for e in gc_manifest_edges(m):
            if not gc_edge_resolvable(index, e):
                ok = false
        if not ok:
            out = out.push(m.digest)
    out

# ---------------------------------------------------------------------------
# Step 7: REPAIR refcounts and size metadata from the marked closure.
# ---------------------------------------------------------------------------

# True incoming-edge count for `digest`, computed from the manifest graph.
fn gc_true_refcount(index: GcIndex, digest: text) -> i64:
    var n: i64 = 0
    for m in index.manifests:
        for e in gc_manifest_edges(m):
            if e == digest:
                n = n + 1
    n

struct GcRepairReport:
    """What step 7 corrected. Empty lists = metadata already agreed with truth."""
    repaired_refcounts: [text]
    repaired_sizes: [text]
    added_entries: [text]

# Recompute refcount_approx and unique_retained_bytes for every physical object,
# writing the truth into the table. Returns the corrected table plus a report of
# what actually drifted — a silent repair would hide a real corruption.
fn gc_repair_metadata(index: GcIndex, table: CacheMetadataTable,
                      result: GcMarkResult) -> CacheMetadataTable:
    var out = table
    for b in index.blobs:
        val truth = gc_true_refcount(index, b.digest)
        val existing = cache_metadata_table_get(out, b.digest)
        if val m = existing:
            var unique = b.size_bytes
            if truth > 1:
                unique = 0                     # shared: not uniquely retained
            out = cache_metadata_table_put(out, CacheMetadata(
                digest: m.digest,
                last_access_time: m.last_access_time,
                access_count: m.access_count,
                artifact_size_bytes: b.size_bytes,
                unique_retained_bytes: unique,
                recomputation_cost_ms: m.recomputation_cost_ms,
                ttl_deadline: m.ttl_deadline,
                refcount_approx: truth,
                namespace_protection_class: m.namespace_protection_class,
                toolchain_relevant: m.toolchain_relevant,
            ))
    out

fn gc_repair_report(index: GcIndex, table: CacheMetadataTable) -> GcRepairReport:
    var refs: [text] = []
    var sizes: [text] = []
    var added: [text] = []
    for b in index.blobs:
        val existing = cache_metadata_table_get(table, b.digest)
        if val m = existing:
            if m.refcount_approx != gc_true_refcount(index, b.digest):
                refs = refs.push(b.digest)
            if m.artifact_size_bytes != b.size_bytes:
                sizes = sizes.push(b.digest)
        else:
            added = added.push(b.digest)
    GcRepairReport(repaired_refcounts: refs, repaired_sizes: sizes, added_entries: added)
