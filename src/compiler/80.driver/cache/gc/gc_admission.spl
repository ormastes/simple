# Admission under storage pressure + PinnedOverflow (design §18.6)
#
# Agent C3. Two rules dominate this file:
#
#   1. A REJECTED CACHE WRITE MUST NEVER FAIL A BUILD OR CHANGE ITS OUTPUT.
#      `gc_admission_outcome` returns "do not cache"; the caller proceeds
#      uncached and emits ONE rate-limited diagnostic.
#   2. NEVER DELETE A PROTECTED ROOT TO HIT A SIZE TARGET. When protected roots
#      alone exceed the configured maximum, GC REPORTS a PinnedOverflowReport
#      (protected bytes, configured max, largest roots, suggested unpins) and
#      stops. Silently deleting a pin to make a number look right is the exact
#      failure this report exists to prevent.

use compiler.driver.cache.metadata.gc_config.{GcLimits, GcDiagnosticGate, gc_admit, gc_admission_diagnostic, gc_admission_name, gc_diagnostic_should_emit, gc_diagnostic_record, GC_ADMIT_REJECT}
use compiler.driver.cache.gc.gc_eviction.{EvictionCandidate, eviction_candidate_protected, gc_protected_bytes}

struct GcAdmissionOutcome:
    """The decision plus the single diagnostic the caller may print (or "")."""
    code: i64
    cache_the_write: bool
    diagnostic: text
    gate: GcDiagnosticGate

# The one entry point a cache writer calls. `cache_the_write == false` means
# "degrade to a miss"; it never means "fail".
fn gc_admission_outcome(limits: GcLimits, gate: GcDiagnosticGate, used_bytes: i64,
                        incoming_bytes: i64, fs_free_bytes: i64,
                        fs_total_bytes: i64, now: i64) -> GcAdmissionOutcome:
    val code = gc_admit(limits, used_bytes, incoming_bytes, fs_free_bytes, fs_total_bytes)
    if code != GC_ADMIT_REJECT:
        return GcAdmissionOutcome(code: code, cache_the_write: true, diagnostic: "", gate: gate)
    var msg = ""
    if gc_diagnostic_should_emit(gate, now):
        msg = gc_admission_diagnostic(code, used_bytes, limits)
    GcAdmissionOutcome(code: code, cache_the_write: false, diagnostic: msg,
                       gate: gc_diagnostic_record(gate, now))

fn gc_admission_summary(outcome: GcAdmissionOutcome) -> text:
    "admission={gc_admission_name(outcome.code)} cached={outcome.cache_the_write} build_affected=false"

# ---------------------------------------------------------------------------
# PinnedOverflow
# ---------------------------------------------------------------------------

struct PinnedOverflowRoot:
    digest: text
    bytes: i64
    protection_class: i64

struct PinnedOverflowReport:
    """Protected roots alone exceed the max. Reported, never resolved by delete."""
    protected_bytes: i64
    configured_max: i64
    largest_roots: [PinnedOverflowRoot]
    suggested_action: text

val GC_PINNED_OVERFLOW_TOP_N: i64 = 8

# nil when there is no overflow. A non-nil report means GC has ALREADY stopped
# freeing: there is nothing left it is permitted to delete.
fn gc_pinned_overflow_check(items: [EvictionCandidate], limits: GcLimits) -> PinnedOverflowReport?:
    val protected = gc_protected_bytes(items)
    if protected <= limits.max_bytes:
        return nil
    val largest = gc_largest_protected_roots(items, GC_PINNED_OVERFLOW_TOP_N)
    val over = protected - limits.max_bytes
    PinnedOverflowReport(
        protected_bytes: protected,
        configured_max: limits.max_bytes,
        largest_roots: largest,
        suggested_action: "unpin the roots listed above (>= {over} B must be released), or raise cache.machine.max_bytes to at least {protected} B; GC will not delete a protected root",
    )

# Protected roots, largest first, capped at `top_n`.
fn gc_largest_protected_roots(items: [EvictionCandidate], top_n: i64) -> [PinnedOverflowRoot]:
    var roots: [PinnedOverflowRoot] = []
    for c in items:
        if eviction_candidate_protected(c):
            roots = roots.push(PinnedOverflowRoot(
                digest: c.digest, bytes: c.artifact_size_bytes,
                protection_class: c.protection_class))
    var sorted: [PinnedOverflowRoot] = []
    for r in roots:
        var inserted = false
        var next: [PinnedOverflowRoot] = []
        for e in sorted:
            if not inserted and gc_root_bytes_gt(r, e):
                next = next.push(r)
                inserted = true
            next = next.push(e)
        if not inserted:
            next = next.push(r)
        sorted = next
    var out: [PinnedOverflowRoot] = []
    var i: i64 = 0
    while i < sorted.len() and i < top_n:
        out = out.push(sorted[i])
        i = i + 1
    out

fn gc_root_bytes_gt(a: PinnedOverflowRoot, b: PinnedOverflowRoot) -> bool:
    if a.bytes != b.bytes:
        return a.bytes > b.bytes
    a.digest < b.digest

# Every root named in an overflow report, for callers that need to prove none of
# them appears in an eviction selection. GC itself never consults the report to
# delete: the report is an operator-facing artifact only.
fn gc_overflow_root_digests(report: PinnedOverflowReport) -> [text]:
    var out: [text] = []
    for r in report.largest_roots:
        out = out.push(r.digest)
    out
