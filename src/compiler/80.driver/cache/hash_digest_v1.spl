# Compute algorithm-tagged digests (registry: cache_contract/
# hash_algorithm_registry_v1.spl). Returns nil for an algorithm this build
# cannot compute (sha3-256 is registered but reserved here), so a caller can
# never mistake "not computed" for a digest.
use std.common.crypto.sha256.{sha256_text}
use std.common.crypto.blake3.{blake3_hash, blake3_hex}
use std.common.text_bytes.{text_to_bytes}
use std.nogc_sync_mut.sffi.runtime.{xxh3_128_text}
use compiler.common.cache_contract.hash_algorithm_registry_v1.{DigestV1, digest_v1_new,
    HASH_ALGO_SHA256_V1, HASH_ALGO_BLAKE3_V1, HASH_ALGO_XXH3_128_V1}

pub fn digest_v1_of_text(algo_id: i64, data: text) -> DigestV1?:
    if algo_id == HASH_ALGO_SHA256_V1:
        return digest_v1_new(algo_id, sha256_text(data))
    if algo_id == HASH_ALGO_BLAKE3_V1:
        return digest_v1_new(algo_id, blake3_hex(blake3_hash(text_to_bytes(data))))
    if algo_id == HASH_ALGO_XXH3_128_V1:
        return digest_v1_new(algo_id, xxh3_128_text(data))
    nil

# The 1..3 digests a producer writes for one identity, in `algo_ids` order;
# algorithms this build cannot compute are skipped.
pub fn digest_v1_set_of_text(algo_ids: [i64], data: text) -> [DigestV1]:
    var out: [DigestV1] = []
    for algo_id in algo_ids:
        if out.len() >= 3:
            break
        match digest_v1_of_text(algo_id, data):
            case Some(d): out.push(d)
            case nil: pass_do_nothing
    out
