# Retained mono's zero-template early return: archive complete current bodies
# without invoking root rewrite, substitution, pruning or symbol allocation.
# This is a mechanical consumer; genuine driver issuance still admits inputs.
use compiler.mono.mono_archive_registration_types_v1.{MonoArchiveCurrentRegistrationOwnerV1}
use compiler.mono.mono_archive_registration_identity_v1.{mono_archive_registration_owner_digest_v1, mono_archive_registration_schedule_digest_v1}
use compiler.driver.cache.hir_mono_archive_consumer_v1.{MonoArchiveRepositoryV1, mono_archive_repository_digest_v1}
use compiler.mono.mono_archive_state_v1.{mono_archive_state_digest_v1}
use compiler.mono.mono_archive_body_input_v1.*
use compiler.driver.cache.hir_mono_archive_assembly_v1.{MonoArchiveAssembledModuleV1, mono_archive_assembled_key_v1}
use compiler.hir.hir_codec.{hir_module_encode}
use compiler.hir.hir_codec_support.{HirCodecWriter}
use compiler.driver.driver_hir_cache.{hir_cache_last_warnings, hir_cache_store_in_owned_scope,
    hir_cache_clear_last_warnings, hir_cache_promote_diagnostic_owner_v1}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause, transient_scope_end, transient_promote}

fn mono_current_passthrough_in_owned_scope_v1(current: MonoArchiveCurrentRegistrationOwnerV1,
        name: text, order: [text]) -> Result<MonoArchiveAssembledModuleV1, text>:
    if transient_array_scope_state_v1() != 1: return Err("mono passthrough requires borrowed scope")
    val owner = current.registration
    if not owner.sealed or not owner.logical_mode or current.sealed_digest == "" or
            owner.generic_functions != 0 or owner.generic_structs != 0 or owner.generic_classes != 0 or
            owner.state.epoch != 0 or owner.state.cursor != 0 or owner.state.queue.len() != 0 or
            owner.roots.len() != order.len() or owner.archives.len() != order.len() or
            current.bodies.len() != order.len(): return Err("mono passthrough requires exact zero-template current owner")
    val registration_digest = mono_archive_registration_owner_digest_v1(owner)
    val state_digest = mono_archive_state_digest_v1(owner.state)
    if registration_digest == "" or state_digest == "": return Err("mono passthrough registration changed")
    val repository = MonoArchiveRepositoryV1(modules: owner.archives, authority: owner.state.facts.body_authority,
        current_bodies: current.bodies, current_cache: Some(current.cache), current_order: order,
        current_mode: true, logical_mode: true)
    val authority = mono_archive_repository_digest_v1(repository)
    val schedule = mono_archive_registration_schedule_digest_v1(owner.roots)
    if authority == "" or authority != owner.state.facts.body_authority or schedule != owner.sealed_schedule_digest or
            schedule != owner.published_schedule_digest or current.published_digest == "" or current.sealed_digest !=
                sha256_text("mono-current-registration-sealed-v1\n" + authority + "\n" + state_digest + "\n" +
                    schedule + "\n" + current.published_digest + "\n{owner.epoch}"):
        return Err("mono passthrough exact current sealed authority changed")
    var writer = HirCodecWriter.create()
    writer.put_text(current.sealed_digest)
    writer.put_text(registration_digest)
    var seen: Dict<text, bool> = {}
    var index = 0
    for key in order:
        if seen.has(key) or not owner.archives.has(key) or not current.bodies.has(key) or
                owner.roots[index].module_name != key: return Err("mono passthrough ordered coverage differs")
        seen[key] = true
        writer.put_text(key)
        writer.put_text(current.bodies[key].current_artifact_key)
        index = index + 1
    if not seen.has(name) or not writer.ok: return Err("mono passthrough module missing")
    val input = MonoArchiveBodyInputV1(original_parent: owner.archives[name],
        current_body: Some(current.bodies[name]), current_cache: Some(current.cache), logical_name: name)
    val complete = mono_archive_body_input_load_in_owned_scope_v1(input)?
    # Keep the original module and symbol counter exactly. No synthetic empty
    # root ledger or specializations are presented as executed mono work.
    var descriptor = MonoArchiveAssembledModuleV1(input_archive: input.original_parent,
        archive_key: "", body_digest: sha256_text(hir_module_encode(complete.module)),
        lowering_warnings_digest: mono_archive_body_input_warnings_digest_v1(input),
        coverage_digest: sha256_text("mono-zero-template-passthrough-v1\n" + writer.finish() + "\n" + name),
        closure_state_digest: state_digest, final_symbol_counter: complete.module.symbols.next_symbol_id,
        stage: "mono-assembled-unverified-v1", body_input: Some(input))
    descriptor.archive_key = mono_archive_assembled_key_v1(descriptor)
    if descriptor.archive_key == "" or not hir_cache_store_in_owned_scope(
            descriptor.archive_key, complete.module, complete.warnings): return Err("mono passthrough complete body publication refused")
    Ok(descriptor)

fn mono_archive_current_passthrough_v1(current: MonoArchiveCurrentRegistrationOwnerV1,
        order: [text]) -> Result<Dict<text, MonoArchiveAssembledModuleV1>, text>:
    if transient_array_scope_state_v1() != 0 or hir_cache_last_warnings().len() != 0 or order.len() == 0:
        return Err("mono passthrough requires closed nonempty inventory")
    var modules: Dict<text, MonoArchiveAssembledModuleV1> = {}
    for name in order:
        if not transient_scope_begin(): return Err("mono passthrough lease unavailable")
        val descriptor = mono_current_passthrough_in_owned_scope_v1(current, name, order)
        val paused = transient_scope_pause()
        val owned = if paused: transient_promote(descriptor) else: false
        val cache_owned = if paused: hir_cache_promote_diagnostic_owner_v1() else: false
        if paused: hir_cache_clear_last_warnings()
        val ended = transient_scope_end()
        if not paused or not owned or not cache_owned or not ended: panic("mono passthrough ownership")
        if descriptor.is_err(): return Err(descriptor.unwrap_err())
        modules[name] = descriptor.unwrap()
    Ok(modules)

export mono_archive_current_passthrough_v1
