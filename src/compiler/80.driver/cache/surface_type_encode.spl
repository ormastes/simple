# Lossless canonical encoding of a parser `Type`, for interface digests.
#
# WHY A NEW ENCODER (three existing candidates were read and rejected — each
# is lossy in the stale-HIT direction, i.e. two DIFFERENT interfaces encode
# EQUAL, which is the one direction that yields a wrong cached artifact):
#
#   * `ModuleSurfaceField.type_name` / `array_element_name` are deliberately
#     SCALAR projections: `Dict<text, i64>` and `Dict<text, f64>` both project
#     to `Dict`, so a generic-argument retype is invisible.
#   * `module_surface_projected_type_shape`
#     (20.hir/hir_lowering/module_surface_declarations.spl:118) answers only
#     `named` / `array` / `other`; generic arguments are dropped by construction
#     and its own docstring calls it a "scalar shape class".
#   * `type_to_text` (35.semantics/lint/semantic_api/alias_registry.spl:85) is
#     discriminant-guarded and otherwise close, but it UNWRAPS modifiers — its
#     `Reference`, `Atomic` and `Isolated` arms each `return type_to_text(inner)`
#     — so `&mut T`, `&T` and `T` render IDENTICALLY. Mutability and ownership
#     are downstream-visible. It also renders `Infer`/`Error` as `""` silently,
#     i.e. it cannot distinguish "encoded as empty" from "could not encode".
#     That behaviour is CORRECT for its own leaf-classifier purpose; it is a
#     stale-hit generator for a digest. Do not "simplify" this file into it.
#
# FAILURE SENTINEL. `""` means COULD NOT ENCODE, and every successful encoding
# is non-empty by construction (each arm emits at least a 2-char tag), so the
# sentinel is unambiguous. Callers MUST treat `""` as "fall back to the content
# hash", never as data. `Infer`, `Error`, an unknown discriminant, an
# unencodable array-size expression, and depth exhaustion all fail CLOSED.
#
# Free text is length-prefixed (`3:i64`) so no name can be confused with the
# delimiters around it; without that, `Named("a,b", [])` and `Named("a", [b])`
# could collide.
#
# Record: doc/08_tracking/bug/
# hir_closure_digest_rekey_blocked_by_incomplete_interface_digest_2026-08-23.md

use compiler.frontend.parser_types_expr.{Type, TypeKind}

extern fn rt_enum_discriminant(value: TypeKind) -> i64

# Bound on type nesting. A type deeper than this is encoded as a FAILURE
# rather than truncated: a truncated encoding would make two different deep
# types compare equal, which is the stale-hit direction.
val SURFACE_TYPE_ENCODE_MAX_DEPTH: i64 = 64

fn _ste_disc(k: TypeKind) -> i64:
    rt_enum_discriminant(k)

fn _ste_q(s: text) -> text:
    """Length-prefix free text so it cannot be confused with delimiters."""
    "{s.len()}:" + s

fn _ste_list(types: [Type], depth: i64) -> text:
    """Encode a positional type list. Order is SIGNIFICANT (generic argument
    order, tuple element order, parameter order) and is therefore NOT sorted.
    Propagates the failure sentinel from any element."""
    var out = "["
    var i = 0
    while i < types.len():
        if i > 0:
            out = out + ","
        val e = surface_type_encode_at(types[i], depth + 1)
        if e == "":
            return ""
        out = out + e
        i = i + 1
    out + "]"

fn surface_type_encode_at(t: Type, depth: i64) -> text:
    """Canonical lossless encoding of `t`, or "" if it cannot be encoded.

    `span` is deliberately EXCLUDED: a body edit shifts every later line, so
    folding spans would make the digest change on exactly the edits this
    mechanism exists to ignore. The cost is that cross-module diagnostic line
    numbers can go stale on a cache hit; that trade is recorded in the bug
    record named in this file's header."""
    if depth > SURFACE_TYPE_ENCODE_MAX_DEPTH:
        return ""
    val k = t.kind
    val disc = _ste_disc(k)

    val d_named = _ste_disc(TypeKind.Named("", []))
    if disc == d_named:
        var name = ""
        var args: [Type] = []
        match k:
            case TypeKind.Named(n, a):
                name = n
                args = a
            case _:
                return ""
        val encoded_args = _ste_list(args, depth)
        if encoded_args == "":
            return ""
        return "Nm(" + _ste_q(name) + "," + encoded_args + ")"

    val d_tuple = _ste_disc(TypeKind.Tuple([]))
    if disc == d_tuple:
        var elems: [Type] = []
        match k:
            case TypeKind.Tuple(e):
                elems = e
            case _:
                return ""
        val encoded = _ste_list(elems, depth)
        if encoded == "":
            return ""
        return "Tu(" + encoded + ")"

    val d_array = _ste_disc(TypeKind.Array(t, nil))
    if disc == d_array:
        var elem: Type = t
        var sized = false
        match k:
            case TypeKind.Array(e, sz):
                elem = e
                sized = sz != nil
            case _:
                return ""
        # A sized array `[T; N]` carries N as an arbitrary Expr. Array LENGTH is
        # layout, i.e. downstream-visible, and this encoder cannot encode an
        # expression — so fail CLOSED rather than encode a fixed-size array
        # identically to a dynamic one.
        if sized:
            return ""
        val encoded = surface_type_encode_at(elem, depth + 1)
        if encoded == "":
            return ""
        return "Ar(" + encoded + ")"

    val d_func = _ste_disc(TypeKind.Function([], t))
    if disc == d_func:
        var params: [Type] = []
        var ret: Type = t
        match k:
            case TypeKind.Function(p, r):
                params = p
                ret = r
            case _:
                return ""
        val encoded_params = _ste_list(params, depth)
        if encoded_params == "":
            return ""
        val encoded_ret = surface_type_encode_at(ret, depth + 1)
        if encoded_ret == "":
            return ""
        return "Fn(" + encoded_params + "," + encoded_ret + ")"

    val d_opt = _ste_disc(TypeKind.Optional(t))
    if disc == d_opt:
        var inner: Type = t
        match k:
            case TypeKind.Optional(i):
                inner = i
            case _:
                return ""
        val encoded = surface_type_encode_at(inner, depth + 1)
        if encoded == "":
            return ""
        return "Op(" + encoded + ")"

    val d_union = _ste_disc(TypeKind.Union([]))
    if disc == d_union:
        var members: [Type] = []
        match k:
            case TypeKind.Union(m):
                members = m
            case _:
                return ""
        # Member ORDER is preserved rather than sorted. `A | B` and `B | A` may
        # be semantically equal, so this over-invalidates on a reorder — the
        # SAFE direction. Sorting here would require proving the compiler
        # treats the two as identical everywhere downstream, which is not
        # established.
        val encoded = _ste_list(members, depth)
        if encoded == "":
            return ""
        return "Un(" + encoded + ")"

    # Reference / Pointer carry a mutability-or-constness bool that IS
    # downstream-visible. This is precisely where `type_to_text` loses
    # information (it unwraps to the inner type), so the flag is encoded.
    val d_ref = _ste_disc(TypeKind.Reference(t, false))
    if disc == d_ref:
        var inner: Type = t
        var is_mut = false
        match k:
            case TypeKind.Reference(i, m):
                inner = i
                is_mut = m
            case _:
                return ""
        val encoded = surface_type_encode_at(inner, depth + 1)
        if encoded == "":
            return ""
        return "Rf(" + encoded + "," + (if is_mut: "m" else: "c") + ")"

    val d_ptr = _ste_disc(TypeKind.Pointer(t, false))
    if disc == d_ptr:
        var inner: Type = t
        var is_const = false
        match k:
            case TypeKind.Pointer(i, c):
                inner = i
                is_const = c
            case _:
                return ""
        val encoded = surface_type_encode_at(inner, depth + 1)
        if encoded == "":
            return ""
        return "Pt(" + encoded + "," + (if is_const: "c" else: "m") + ")"

    # Atomic / Isolated / Weak are ownership sigils with distinct ABI and are
    # each given a DISTINCT tag — `type_to_text` collapses all three into their
    # inner type, which is the defect this encoder exists to avoid.
    val d_atomic = _ste_disc(TypeKind.Atomic(t))
    if disc == d_atomic:
        var inner: Type = t
        match k:
            case TypeKind.Atomic(i):
                inner = i
            case _:
                return ""
        val encoded = surface_type_encode_at(inner, depth + 1)
        if encoded == "":
            return ""
        return "At(" + encoded + ")"

    val d_isolated = _ste_disc(TypeKind.Isolated(t))
    if disc == d_isolated:
        var inner: Type = t
        match k:
            case TypeKind.Isolated(i):
                inner = i
            case _:
                return ""
        val encoded = surface_type_encode_at(inner, depth + 1)
        if encoded == "":
            return ""
        return "Is(" + encoded + ")"

    val d_weak = _ste_disc(TypeKind.Weak(t))
    if disc == d_weak:
        var inner: Type = t
        match k:
            case TypeKind.Weak(i):
                inner = i
            case _:
                return ""
        val encoded = surface_type_encode_at(inner, depth + 1)
        if encoded == "":
            return ""
        return "Wk(" + encoded + ")"

    val d_proj = _ste_disc(TypeKind.Projection(t, ""))
    if disc == d_proj:
        var base: Type = t
        var assoc = ""
        match k:
            case TypeKind.Projection(b, f):
                base = b
                assoc = f
            case _:
                return ""
        val encoded = surface_type_encode_at(base, depth + 1)
        if encoded == "":
            return ""
        return "Pj(" + encoded + "," + _ste_q(assoc) + ")"

    # Infer, Error, and any variant added after this file was written all land
    # here and fail CLOSED. A new TypeKind variant therefore degrades the cache
    # to the content hash rather than silently digesting two different types
    # to the same value.
    ""

fn surface_type_encode(t: Type) -> text:
    """Canonical lossless encoding of `t`, or "" if it cannot be encoded."""
    surface_type_encode_at(t, 0)

export surface_type_encode, surface_type_encode_at, SURFACE_TYPE_ENCODE_MAX_DEPTH
