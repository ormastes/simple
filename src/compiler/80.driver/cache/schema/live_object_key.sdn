    - { pos: 42, name: prelower_build_module_set, kind: ordered, source: src/compiler/80.driver/cache/native_prelower_object_key.spl#native_prelower_object_key_v1 }
  # Inputs that can change an object/lib/binary but are NOT in the live key
  # (doc §2.2). scope_key_unframed (an ENCODING gap, not an input: the
  # scope/producer text was joined unframed) was closed by length-framing
  # every component (cache_key_frame), so inputs_total dropped 49 -> 48 and
  # the model enc framing assumption now holds. debug_info_path_prefix (the
  # build root embedded in debug info) was closed by REMOVING the input:
  # debug_info_prefix_map_path emits root-relative paths, so inputs_total
  # dropped 48 -> 47. Link order is NOT here: compile_options_hash_compute already
  # keeps native_libraries / paths / flags in caller order (the doc's "sorted
  # away" row predates that). `row` names the §2.1/§2.2 row.
  known_gaps:
    - { id: linker_binary_version,      row: "linker binary / version (linker_sha256 only in reproduce receipt)" }
    - { id: system_library_content,     row: "system library content (libc, libm, SDK)" }
    - { id: import_lib_export_sets,     row: "external import libraries / dynlib export sets" }
    - { id: advice_body_weave_root,     row: "advice body -> weave output (aop_weave_root SPEC_FORWARD)" }
    - { id: hash_algorithm_tag,         row: "digest text carries no algorithm tag; unknown algorithm not a miss" }
