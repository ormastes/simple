# live_object_key.sdn — the LIVE native object/MIR cache key, as composed by the
# driver today, plus the counted list of inputs it does NOT yet capture.
#
# Source of truth for src/app/gen_cache_model/main.spl, which emits
# src/verification/cache_protocol/src/CacheProtocol/Generated/LiveKey.lean
# (one `<name>_live_change_visible` per component, one `<id>_gap_invisible`
# per known gap). Plan:
# doc/05_design/compiler/incremental_build/cache_invalidation_formal_verification_2026-10-24.md
# (T-K1 key soundness, T-I1 invalidation completeness, §4.2 counting rule).
#
# Gate rule (scripts/check/check-cache-protocol-formal.shs):
#   |components| + |known_gaps| == inputs_total
#   |components| == count(*_live_change_visible), |known_gaps| == count(*_gap_invisible)
#   every component `source` is pinned in src/verification/cache_protocol/source_bindings.txt
# A gap may only be REMOVED by turning it into a component (key-visible input)
# with a theorem; it may never be added or dropped silently.
#
# kind: scalar  — one text value
#       ordered — sequence; order is semantic and kept
#       set     — sequence the encoder sorts first (model value = sorted list)

live_object_key:
  inputs_total: 47
  components:
    # ---- producer identity (incremental.spl native_build_producer_identity) ----
