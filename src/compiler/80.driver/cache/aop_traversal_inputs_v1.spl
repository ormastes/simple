# Cold F1 input capture. Ordinary encoded MODULE roots deliberately invalidate
# more than function-only roots. Capture before the ordered claim loop mutates
# HIR; retain digests only, not a restoration baseline.
use compiler.hir.hir_types.{HirModule}
use compiler.hir.hir_codec.{hir_module_encode_snapshot_bounded_v1}
use compiler.hir.abi_interface.{hir_abi_function_digest_v1, HirAbiInterfaceEncoderV1}
use compiler.semantics.aspect_validation.{aspect_contract_claims_v1}
use compiler.semantics.aspect_weave.{AspectForwardWeaveClaimV1}
use compiler.common.cache.canonical_identity.{canon_str, canon_field, canon_seq, canonical_identity_sort_texts}
use compiler.common.cache_contract.aspect_match_shard_v1.{AdviceFacetsV1}
use compiler.common.cache_contract.traversal_output_cache_v1.{TraversalModuleSnapshotV1, TraversalRetentionLedgerV1}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause,
    transient_scope_end, transient_promote, transient_session_heap_id_v1}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}

pub struct AopTraversalInputsV1:
    module_roots: Dict<text, text>
    function_roots: Dict<text, text>
    advice_facets: Dict<text, AdviceFacetsV1>

pub struct AopTraversalCapturedBatchV1:
    inputs: AopTraversalInputsV1
    snapshots: [TraversalModuleSnapshotV1]
    byte_count: i64

struct AopTraversalModuleInputV1:
    root: text
    function_roots: Dict<text, text>
    byte_count: i64
    snapshot: TraversalModuleSnapshotV1?

fn _traversal_content_key_v1(domain: text, fields: [text]) -> text:
    var values: [text] = []
    for field in fields: values.push(canon_str(field))
    "sha256:" + sha256_text(canon_field(domain, canon_seq(values)))

pub fn aop_traversal_snapshot_digest_v1(module_key: text, blob: text) -> text:
    _traversal_content_key_v1("simple/aop-ordinary-module/v1", [module_key, blob])

pub fn aop_traversal_base_key_v1(inputs: AopTraversalInputsV1,
        module_key: text, symbol: text) -> Result<text, text>:
    val id = module_key + "::" + symbol
    if symbol == "" or not inputs.function_roots.contains_key(id):
        return Err("traversal-base-module-or-symbol-missing")
    Ok(inputs.function_roots[id])

fn _aop_traversal_module_capture_owned_v1(key: text, module: HirModule,
        max_bytes: i64, max_functions: i64, keep_bytes: bool) -> Result<AopTraversalModuleInputV1, text>:
    if module.functions.len() > max_functions: return Err("traversal-function-budget")
    val encoded = hir_module_encode_snapshot_bounded_v1(module, max_bytes)
    if encoded.is_err(): return Err("traversal-module-snapshot-unavailable")
    val bytes = encoded.unwrap()
    val byte_count = bytes.byte_len()
    if byte_count > max_bytes: return Err("traversal-capture-budget")
    val root = aop_traversal_snapshot_digest_v1(key, bytes)
    var functions: Dict<text, text> = {}
    for symbol in module.functions.keys():
        val function = module.functions[symbol]
        val id = key + "::" + function.name
        if function.name == "" or functions.contains_key(id):
            return Err("traversal-base-function-ambiguous")
        functions[id] = _traversal_content_key_v1("simple/aop-module-base/v1",
            [key, function.name, root])
    var snapshot: TraversalModuleSnapshotV1? = nil
    if keep_bytes:
        snapshot = Some(TraversalModuleSnapshotV1(module_key: key, module_name: module.name,
            module_path: module.path, blob: bytes, digest: root))
    Ok(AopTraversalModuleInputV1(root: root, function_roots: functions,
        byte_count: byte_count, snapshot: snapshot))

# Scope EACH module, rather than retaining every encoder's scratch until the
# batch ends. Inputs are read-only parent loans; only compact roots escape.
fn _aop_traversal_module_capture_v1(key: text, module: HirModule,
        max_bytes: i64, max_functions: i64, keep_bytes: bool,
        ledger: TraversalRetentionLedgerV1?) -> Result<AopTraversalModuleInputV1, text>:
    var admitted_bytes = max_bytes
    if keep_bytes:
        if ledger == nil or ledger.unwrap().session_id != (transient_session_heap_id_v1() as i64):
            return Err("traversal-retention-session-unavailable")
        if ledger.unwrap().blob_remaining() < admitted_bytes:
            admitted_bytes = ledger.unwrap().blob_remaining()
        if admitted_bytes <= 0: return Err("traversal-retention-blob-budget")
    if transient_array_scope_state_v1() != 0: return Err("traversal-capture-scope-occupied")
    if not transient_scope_begin(): return Err("traversal-capture-scope-unavailable")
    var result = _aop_traversal_module_capture_owned_v1(key, module, admitted_bytes, max_functions, keep_bytes)
    if keep_bytes and result.is_ok():
        if not ledger.unwrap().charge_blob(result.unwrap().byte_count):
            result = Err("traversal-retention-blob-budget")
    val paused = transient_scope_pause()
    val promoted = if paused: transient_promote(result) else: false
    # Always close, including ordinary refusal and failed promotion.
    val ended = transient_scope_end()
    if not paused or not promoted or not ended:
        panic("AOP traversal module capture scope ownership failed")
    result

fn _aop_traversal_advice_capture_owned_v1(owner: HirModule, advice_fn: text,
        body_root: text, order: i64) -> Result<AdviceFacetsV1, text>:
    var function_count: i64 = 0
    var signature = ""
    var effects = ""
    for symbol in owner.functions.keys():
        val function = owner.functions[symbol]
        if function.name != advice_fn: continue
        function_count = function_count + 1
        val abi = hir_abi_function_digest_v1(owner, function)
        if abi.is_err(): return Err("traversal-advice-abi-unavailable")
        signature = "sha256:" + abi.unwrap()
        var encoder = HirAbiInterfaceEncoderV1.new(owner)
        val effect_bytes = encoder.effects_identity(function.effects)
        if encoder.error != "": return Err("traversal-advice-effects-unavailable")
        effects = _traversal_content_key_v1("simple/aop-advice-effects/v1", [effect_bytes])
    if function_count != 1: return Err("traversal-advice-function-ambiguous")
    # This concrete HIR weaver prepends static calls; physical MIR forms are
    # independent and cannot be inferred from this contract.
    Ok(AdviceFacetsV1(advice_fn: advice_fn, mode: "before", activation: "static",
        signature_digest: signature, effects_digest: effects, body_digest: body_root, order: order))

fn _aop_traversal_advice_capture_v1(owner: HirModule, advice_fn: text,
        body_root: text, order: i64) -> Result<AdviceFacetsV1, text>:
    if transient_array_scope_state_v1() != 0: return Err("traversal-capture-scope-occupied")
    if not transient_scope_begin(): return Err("traversal-capture-scope-unavailable")
    var result = _aop_traversal_advice_capture_owned_v1(owner, advice_fn, body_root, order)
    val paused = transient_scope_pause()
    val promoted = if paused: transient_promote(result) else: false
    val ended = transient_scope_end()
    if not paused or not promoted or not ended:
        panic("AOP traversal advice capture scope ownership failed")
    result

pub fn aop_traversal_inputs_capture_v1(modules: Dict<text, HirModule>,
        claims: [AspectForwardWeaveClaimV1], max_modules: i64,
        max_snapshot_bytes: i64) -> Result<AopTraversalInputsV1, text>:
    val captured = _aop_traversal_batch_capture_v1(modules, claims, max_modules,
        max_snapshot_bytes, false, nil)?
    Ok(captured.inputs)

pub fn aop_traversal_batch_capture_v1(modules: Dict<text, HirModule>,
        claims: [AspectForwardWeaveClaimV1], max_modules: i64,
        max_snapshot_bytes: i64, ledger: TraversalRetentionLedgerV1) -> Result<AopTraversalCapturedBatchV1, text>:
    _aop_traversal_batch_capture_v1(modules, claims, max_modules, max_snapshot_bytes, true, Some(ledger))

fn _aop_traversal_batch_capture_v1(modules: Dict<text, HirModule>,
        claims: [AspectForwardWeaveClaimV1], max_modules: i64,
        max_snapshot_bytes: i64, keep_bytes: bool,
        ledger: TraversalRetentionLedgerV1?) -> Result<AopTraversalCapturedBatchV1, text>:
    if max_modules <= 0 or max_snapshot_bytes <= 0 or modules.len() > max_modules:
        return Err("traversal-capture-budget")
    if claims.len() > 1024: return Err("traversal-claim-budget")
    # Never borrow a caller's live/paused legacy scope. Fresh-source caller can
    # safely use the full weave fallback; repeated woven input remains refused.
    if transient_array_scope_state_v1() != 0: return Err("traversal-capture-scope-occupied")
    var roots: Dict<text, text> = {}
    var total: i64 = 0
    var functions: Dict<text, text> = {}
    var snapshots: [TraversalModuleSnapshotV1] = []
    for key in canonical_identity_sort_texts(modules.keys()):
        val captured = _aop_traversal_module_capture_v1(key, modules[key],
            max_snapshot_bytes - total, 65536 - functions.len(), keep_bytes, ledger)?
        total = total + captured.byte_count
        roots[key] = captured.root
        if captured.snapshot != nil: snapshots.push(captured.snapshot.unwrap())
        for id in captured.function_roots.keys():
            if functions.contains_key(id): return Err("traversal-base-function-ambiguous")
            functions[id] = captured.function_roots[id]
    var facets: Dict<text, AdviceFacetsV1> = {}
    val contracts = aspect_contract_claims_v1()
    var order: i64 = 0
    for claim in claims:
        if facets.contains_key(claim.registry_key): return Err("traversal-duplicate-claim")
        var owner_path = ""
        var contract_count: i64 = 0
        for contract in contracts:
            if contract.registry_key == claim.registry_key:
                if contract.kind != "forward" or contract.mode != "static" or
                        contract.advice_fn != claim.advice_fn or contract.selector != claim.selector:
                    return Err("traversal-advice-contract-mismatch")
                owner_path = contract.path
                contract_count = contract_count + 1
        if contract_count != 1 or owner_path == "": return Err("traversal-advice-contract-missing")
        var owner_key = ""
        var owner_count: i64 = 0
        for key in modules.keys():
            val module = modules[key]
            if key == owner_path or module.path == owner_path or module.name == owner_path:
                owner_key = key
                owner_count = owner_count + 1
        if owner_count != 1: return Err("traversal-advice-owner-ambiguous")
        facets[claim.registry_key] = _aop_traversal_advice_capture_v1(modules[owner_key],
            claim.advice_fn, roots[owner_key], order)?
        order = order + 1
    Ok(AopTraversalCapturedBatchV1(inputs: AopTraversalInputsV1(module_roots: roots,
        function_roots: functions, advice_facets: facets), snapshots: snapshots, byte_count: total))
