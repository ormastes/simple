# The retained streaming route proceeds from the real woven gate to cold
# capture without the four nonstreaming semantic passes. This private-issued
# owner records that actual route, not invented successful pass receipts.
use compiler.driver.driver_compiler_type.{CompilerDriver}
use compiler.driver.driver_phase_gates.{driver_streaming_surface_route,
    driver_source_entry_request, driver_source_entry_closure_enabled}
use compiler.driver.cache.driver_hir_archive_weave_boundary_v1.{
    DriverHirArchiveWeaveBoundaryV1, DriverHirArchiveWeaveBoundaryUseV1,
    driver_hir_archive_weave_boundary_use_v1}
use compiler.driver.cache.hir_body_semantic_lease_v1.{hir_body_semantic_policy_v1}
use compiler.common.cache_contract.hir_owned_artifact_cache_v1.{
    HirOwnedArtifactContextV1, hir_owned_artifact_store_blob_v1, hir_owned_artifact_load_blob_v1}
use compiler.hir.hir_codec_support.{HirCodecWriter}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.io.env_ops.{env_get}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause,
    transient_scope_end, transient_promote}

struct DriverHirArchiveSemanticPrerequisiteV1:
    cache: HirOwnedArtifactContextV1
    artifact_key: text
    artifact_digest: text
    boundary_key: text
    boundary_digest: text
    source_binding: text
    schedule_digest: text
    config_binding: text
    policy_key: text
    semantic_policy_key: text
    route_binding: text
    stage: text

struct DriverHirArchiveSemanticPrerequisiteUseV1:
    prerequisite: DriverHirArchiveSemanticPrerequisiteV1
    weave_use: DriverHirArchiveWeaveBoundaryUseV1

struct DriverHirArchiveSemanticPinV1:
    driver_identity: i64
    artifact_digest: text
    route_binding: text
    semantic_policy_key: text

var _driver_hir_semantic_pins_ready_v1: bool = false
var _driver_hir_semantic_pins_v1: Dict<text, DriverHirArchiveSemanticPinV1> = {}

fn driver_hir_semantic_initialize_v1() -> bool:
    if transient_array_scope_state_v1() != 0: return false
    if not _driver_hir_semantic_pins_ready_v1:
        _driver_hir_semantic_pins_v1 = {}
        _driver_hir_semantic_pins_ready_v1 = true
    true

fn driver_hir_semantic_route_binding_v1(driver: CompilerDriver) -> Result<text, text>:
    if transient_array_scope_state_v1() != 1 or driver_streaming_surface_route(driver.ctx) != 1:
        return Err("archive semantic prerequisite requires actual streaming route")
    var writer = HirCodecWriter.create()
    writer.put_text("driver-hir-streaming-semantic-route-v1")
    writer.put_bool(driver.ctx.options.low_memory)
    writer.put_text(driver.ctx.options.mode.to_text())
    writer.put_text(driver.ctx.options.cli_mode_text)
    writer.put_text(driver.ctx.options.backend)
    writer.put_text(driver_source_entry_request(driver.ctx))
    writer.put_bool(driver_source_entry_closure_enabled(driver.ctx))
    writer.put_bool(driver.ctx.config.contains_key("coverage"))
    writer.put_text(driver.ctx.config["mcdc_mode"] ?? "off")
    writer.put_text(env_get("SIMPLE_STAGE3_STREAMING_SURFACES"))
    writer.put_text(env_get("SIMPLE_BOOTSTRAP_STAGE4"))
    writer.put_text(env_get("SIMPLE_STAGE4_STREAMING_SURFACES"))
    Ok(sha256_text(writer.finish()))

fn driver_hir_semantic_bytes_v1(owner: DriverHirArchiveSemanticPrerequisiteV1) -> text:
    if transient_array_scope_state_v1() != 1 or owner.stage != "streaming-woven-semantic-prerequisite-v1":
        return ""
    var writer = HirCodecWriter.create()
    writer.put_text(owner.stage)
    writer.put_text(owner.cache.directory)
    writer.put_text(owner.cache.producer_header)
    writer.put_bool(owner.cache.enabled)
    writer.put_text(owner.boundary_key)
    writer.put_text(owner.boundary_digest)
    writer.put_text(owner.source_binding)
    writer.put_text(owner.schedule_digest)
    writer.put_text(owner.config_binding)
    writer.put_text(owner.policy_key)
    writer.put_text(owner.semantic_policy_key)
    writer.put_text(owner.route_binding)
    writer.finish()

fn driver_hir_semantic_capture_borrowed_v1(driver: CompilerDriver,
        boundary: DriverHirArchiveWeaveBoundaryV1, use: DriverHirArchiveWeaveBoundaryUseV1
) -> Result<DriverHirArchiveSemanticPrerequisiteV1, text>:
    val route = driver_hir_semantic_route_binding_v1(driver)?
    val semantic = hir_body_semantic_policy_v1(driver.ctx.assurance_policy.strictness)
    if semantic.key != boundary.policy.semantic_policy_key or
            use.boundary_key != boundary.use.boundary_key or use.boundary_digest != boundary.use.boundary_digest:
        return Err("archive semantic prerequisite changed actual woven policy parent")
    var owner = DriverHirArchiveSemanticPrerequisiteV1(cache: use.cache,
        artifact_key: "", artifact_digest: "", boundary_key: use.boundary_key,
        boundary_digest: use.boundary_digest, source_binding: use.source_binding,
        schedule_digest: use.schedule_digest, config_binding: use.config_binding,
        policy_key: use.policy_key, semantic_policy_key: semantic.key, route_binding: route,
        stage: "streaming-woven-semantic-prerequisite-v1")
    val bytes = driver_hir_semantic_bytes_v1(owner)
    if bytes == "": return Err("archive semantic prerequisite encoding refused")
    owner.artifact_digest = sha256_text(bytes)
    owner.artifact_key = sha256_text("driver-hir-semantic-prerequisite-artifact-v1\n" + owner.artifact_digest)
    if not hir_owned_artifact_store_blob_v1(owner.cache, owner.artifact_key, bytes)?:
        return Err("archive semantic prerequisite immutable publication refused")
    Ok(owner)

pub fn driver_hir_archive_semantic_prerequisite_capture_v1(driver: CompilerDriver,
        boundary: DriverHirArchiveWeaveBoundaryV1
) -> Result<DriverHirArchiveSemanticPrerequisiteV1, text>:
    if not driver_hir_semantic_initialize_v1(): return Err("archive semantic prerequisite foreign lease occupied")
    # The genuine source/schedule/private producer/gate/weave replay precedes
    # this mint. A public woven record, clean flag or fabricated pass is never
    # a semantic prerequisite producer.
    if driver_streaming_surface_route(driver.ctx) != 1:
        return Err("archive semantic prerequisite does not admit nonstreaming passes")
    val use = driver_hir_archive_weave_boundary_use_v1(driver, boundary)?
    if not transient_scope_begin(): return Err("archive semantic prerequisite capture lease unavailable")
    val result = driver_hir_semantic_capture_borrowed_v1(driver, boundary, use)
    val paused = transient_scope_pause()
    val owned = if paused: transient_promote(result) else: false
    val ended = transient_scope_end()
    if not paused or not owned or not ended: panic("archive semantic prerequisite capture ownership failed")
    if result.is_err(): return Err(result.unwrap_err())
    val owner = result.unwrap()
    val pin = DriverHirArchiveSemanticPinV1(driver.identity_id, owner.artifact_digest,
        owner.route_binding, owner.semantic_policy_key)
    val lookup = "{driver.identity_id}:" + owner.artifact_key
    _driver_hir_semantic_pins_v1[lookup] = pin
    Ok(owner)

pub fn driver_hir_archive_semantic_prerequisite_matches_in_owned_scope_v1(
        driver: CompilerDriver, owner: DriverHirArchiveSemanticPrerequisiteV1
) -> Result<bool, text>:
    if transient_array_scope_state_v1() != 1 or not _driver_hir_semantic_pins_ready_v1:
        return Err("archive semantic prerequisite requires registered borrowed owner")
    val lookup = "{driver.identity_id}:" + owner.artifact_key
    if not _driver_hir_semantic_pins_v1.has(lookup): return Err("archive semantic prerequisite lacks actual driver pin")
    val pin = _driver_hir_semantic_pins_v1[lookup]
    val route = driver_hir_semantic_route_binding_v1(driver)?
    val semantic = hir_body_semantic_policy_v1(driver.ctx.assurance_policy.strictness)
    val bytes = driver_hir_semantic_bytes_v1(owner)
    if pin.driver_identity != (driver.identity_id) or pin.artifact_digest != owner.artifact_digest or
            pin.route_binding != route or owner.route_binding != route or
            pin.semantic_policy_key != semantic.key or owner.semantic_policy_key != semantic.key or
            bytes == "" or sha256_text(bytes) != pin.artifact_digest:
        return Err("archive semantic prerequisite actual route, policy or metadata changed")
    if hir_owned_artifact_load_blob_v1(owner.cache, owner.artifact_key)? != bytes:
        return Err("archive semantic prerequisite immutable bytes changed")
    Ok(true)

pub fn driver_hir_archive_semantic_prerequisite_use_v1(driver: CompilerDriver,
        boundary: DriverHirArchiveWeaveBoundaryV1, owner: DriverHirArchiveSemanticPrerequisiteV1
) -> Result<DriverHirArchiveSemanticPrerequisiteUseV1, text>:
    if transient_array_scope_state_v1() != 0: return Err("archive semantic prerequisite replay foreign lease occupied")
    if driver_streaming_surface_route(driver.ctx) != 1:
        return Err("archive semantic prerequisite does not admit nonstreaming passes")
    val use = driver_hir_archive_weave_boundary_use_v1(driver, boundary)?
    if not transient_scope_begin(): return Err("archive semantic prerequisite replay lease unavailable")
    val result = driver_hir_semantic_use_borrowed_v1(driver, owner, use)
    val paused = transient_scope_pause()
    val owned = if paused: transient_promote(result) else: false
    val ended = transient_scope_end()
    if not paused or not owned or not ended: panic("archive semantic prerequisite replay ownership failed")
    result

fn driver_hir_semantic_use_borrowed_v1(driver: CompilerDriver,
        owner: DriverHirArchiveSemanticPrerequisiteV1, use: DriverHirArchiveWeaveBoundaryUseV1
) -> Result<DriverHirArchiveSemanticPrerequisiteUseV1, text>:
    val verified = driver_hir_archive_semantic_prerequisite_matches_in_owned_scope_v1(driver, owner)?
    if owner.boundary_key != use.boundary_key or owner.boundary_digest != use.boundary_digest or
            owner.source_binding != use.source_binding or owner.schedule_digest != use.schedule_digest or
            owner.config_binding != use.config_binding or owner.policy_key != use.policy_key or
            owner.cache.directory != use.cache.directory or
            owner.cache.producer_header != use.cache.producer_header or owner.cache.enabled != use.cache.enabled:
        return Err("archive semantic prerequisite differs from fresh actual woven use")
    Ok(DriverHirArchiveSemanticPrerequisiteUseV1(owner, use))

export DriverHirArchiveSemanticPrerequisiteV1, DriverHirArchiveSemanticPrerequisiteUseV1
export driver_hir_archive_semantic_prerequisite_capture_v1, driver_hir_archive_semantic_prerequisite_use_v1
export driver_hir_archive_semantic_prerequisite_matches_in_owned_scope_v1
