# A replay descriptor for the original collection analyzer. CollectionPlan
# contains HirExpr/HirBlock roots, so complete plans may only be borrowed.
use compiler.driver.cache.hir_body_typecheck_lease_v1.{HirBodyArchiveV1}
use compiler.semantics.perf_facts.registry.{CollectionRegistryBindingV1}

struct CollectionArchiveAnalysisV1:
    archive: HirBodyArchiveV1
    registry_source: text
    bindings: [CollectionRegistryBindingV1]
    backend: text
    input_digest: text
    plans_found: i64
    findings_found: i64
    blockers_found: i64
    functions_scanned: i64
    nodes_scanned: i64

export CollectionArchiveAnalysisV1
