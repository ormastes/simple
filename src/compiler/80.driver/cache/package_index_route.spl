# Production routing for the persistent package/module index.

use compiler.driver.cache.cache_root.{machine_cache_root}
use compiler.driver.cache.package_module_index.{
    PACKAGE_MODULE_INDEX_SCHEMA_V2, PACKAGE_MODULE_INDEX_SCHEMA_V3,
    PACKAGE_MODULE_INDEX_SCHEMA_V4,
    PackageModuleIndexEntryV1, PackageModuleIndexGenerationV1,
    PackageModuleChangeV1, PackageModuleInvalidationV1,
    package_module_index_read_current_v1,
    package_module_index_decode_v1, package_module_index_digest_v1,
    package_module_index_find_v1,
    package_module_index_invalidate_v1, package_module_index_invalidate_changes_v1
}
use compiler.driver.cache.package_index_semantic_transition.{
    package_index_transition_read_v1
}
use compiler.driver.cache.package_scc_scheduler.{
    package_scc_consume_index_schedule_v1
}
use compiler.driver.cache.package_archive_cache.{
    PackageArchiveAuthorityV1, PackageArchiveLoadV1,
    package_archive_aggregate_entry_v1, package_archive_load_v1
}
use compiler.driver.cache.dirty_module_record.{
    DirtyModuleRecordV1, dirty_module_record_admit_v1,
    dirty_module_records_sort_validate_v1
}
use compiler.common.cache.canonical_identity.{canonical_identity_sort_texts}
use std.scv.compile_source_inventory_core.{compile_source_inventory_path_valid_v1}

struct PackageArchiveAdmissionV1:
    package_identity: text
    module_identities: [text]
    module_entries: [PackageModuleIndexEntryV1]
    archive_path: text
    load: PackageArchiveLoadV1

struct PackageIndexRouteV1:
    valid: bool
    reason: text
    source_paths: [text]
    dirty_modules: [DirtyModuleRecordV1]
    package_schedule: [text]
    archive_admissions: [PackageArchiveAdmissionV1]

fn package_index_route_sorted_unique_v1(values: [text]) -> [text]:
    for value in values:
        if value == "" or value.contains("\n") or value.contains("\r"):
            return []
    # Native text `<` can compare tagged addresses; the shared sort uses
    # bytewise identity order and O(n log n) heap sorting. Deduplicate only
    # after sorting to avoid quadratic `.contains` scans on warm closures.
    val sorted = canonical_identity_sort_texts(values)
    var result: [text] = []
    for value in sorted:
        if result.len() == 0 or result[result.len() - 1] != value:
            result = result.push(value)
    result

fn package_index_route_entry_module_v1(
    generation: PackageModuleIndexGenerationV1, entry_path: text
) -> text:
    if entry_path == "":
        return ""
    for entry in generation.entries:
        if entry.source_identity == entry_path:
            return entry.module_identity
    ""

fn package_index_route_closure_v1(
    generation: PackageModuleIndexGenerationV1, root_module: text
) -> [text]:
    var pending: [text] = [root_module]
    var queued: Dict<text, bool> = {}
    queued[root_module] = true
    var modules: [text] = []
    var cursor = 0
    while cursor < pending.len():
        val module_identity = pending[cursor]
        cursor = cursor + 1
        val entry = package_module_index_find_v1(generation, module_identity)
        if entry == nil:
            return []
        modules = modules.push(module_identity)
        for imported in entry!.direct_imports:
            if not queued.has(imported):
                pending = pending.push(imported)
                queued[imported] = true
    package_index_route_sorted_unique_v1(modules)

fn package_index_route_ordered_modules_v1(
    entries: [PackageModuleIndexEntryV1],
    selected_modules: [text], selected_members: Dict<text, bool>,
    schedule: [text], package_heads: Dict<text, i64>, package_next: [i64]
) -> [text]:
    var ordered: [text] = []
    var added: Dict<text, bool> = {}
    for package_identity in schedule:
        # The route has already linked selected entries by package. Reuse
        # those links instead of scanning every entry for each scheduled SCC.
        var entry_index = package_heads[package_identity] ?? -1
        while entry_index >= 0:
            val module_identity = entries[entry_index].module_identity
            if selected_members.has(module_identity) and
                    not added.has(module_identity):
                ordered = ordered.push(module_identity)
                added[module_identity] = true
            entry_index = package_next[entry_index]
    # The invalidation schedule contains only dirty packages. Archive-backed
    # modules in the selected closure must still be admitted and routed.
    for module_identity in selected_modules:
        if not added.has(module_identity):
            ordered = ordered.push(module_identity)
    ordered

fn package_index_route_changed_modules_v1(value: text) -> Result<[text], text>:
    if value == "":
        return Ok([])
    var modules: [text] = []
    for part in value.split(","):
        val identity = part.trim()
        if identity == "" or identity.contains("\n") or identity.contains("\r"):
            return Err("changed-module-list-invalid")
        modules.push(identity)
    Ok(package_index_route_sorted_unique_v1(modules))

fn package_index_route_admitted_invalidation_v1(
    cache_root: text, generation: PackageModuleIndexGenerationV1,
    changed_modules: [text]
) -> PackageModuleInvalidationV1:
    # V4 can prove generated-output reuse, so an empty hint is a no-op.
    # Older formats cannot prove it and must conservatively migrate.
    if (changed_modules.len() == 0 and
            generation.schema_version >= PACKAGE_MODULE_INDEX_SCHEMA_V4):
        return package_module_index_invalidate_v1(generation, [], false)
    var selected: [text] = []
    for entry in generation.entries:
        selected.push(entry.module_identity)
    val transition = package_index_transition_read_v1(
        "{cache_root}/package-module-index-v1", package_module_index_digest_v1(generation))
    if transition.is_err():
        return package_module_index_invalidate_v1(generation, selected, true)
    val previous = package_module_index_decode_v1(transition.unwrap().previous_encoded)
    if not previous.valid or previous.generation == nil:
        return package_module_index_invalidate_v1(generation, selected, true)
    val old = previous.generation!
    # Topology/owner changes need cold or conservative migration. A same-name
    # module in another package or variant is not evidence for private reuse.
    if (old.schema_version != generation.schema_version or
            old.producer_digest != generation.producer_digest or
            old.root_generation != generation.root_generation or
            old.variant_digest != generation.variant_digest or
            old.scope_entry_source_identity != generation.scope_entry_source_identity or
            old.entries.len() != generation.entries.len()):
        return package_module_index_invalidate_v1(generation, selected, true)
    if (old.schema_version < PACKAGE_MODULE_INDEX_SCHEMA_V4 or
            generation.schema_version < PACKAGE_MODULE_INDEX_SCHEMA_V4):
        return package_module_index_invalidate_v1(generation, selected, true)
    var changes: [PackageModuleChangeV1] = []
    var known: Dict<text, bool> = {}
    var changed: Dict<text, bool> = {}
    var index = 0
    for entry in generation.entries:
        val prior = old.entries[index]
        index = index + 1
        if (prior.module_identity != entry.module_identity or
                prior.package_identity != entry.package_identity or
                prior.source_identity != entry.source_identity or
                prior.scc_identity != entry.scc_identity or
                prior.direct_imports != entry.direct_imports or
                prior.reverse_dependents != entry.reverse_dependents):
            return package_module_index_invalidate_v1(generation, selected, true)
        known[entry.module_identity] = true
        val content = prior.source_digest != entry.source_digest
        # SMF metadata includes body-sensitive imported sections. Do not treat
        # a stable signature alone as proof that generic/inline consumers reuse.
        val exports = prior.export_digest != entry.export_digest or
            prior.smf_metadata_digest != entry.smf_metadata_digest or
            prior.manifest_digest != entry.manifest_digest
        val abi = prior.abi_digest != entry.abi_digest
        val initializer = prior.initializer_digest != entry.initializer_digest
        val provider = prior.provider_digest != entry.provider_digest
        val generated = prior.generated_source_digest !=
            entry.generated_source_digest
        if content or exports or abi or initializer or provider or generated:
            changes.push(PackageModuleChangeV1(
                entry.module_identity, content, exports, abi, initializer,
                provider, generated))
            changed[entry.module_identity] = true
    # Hints may request extra work but cannot assert semantic equivalence or
    # omit actual graph deltas. An unproven hint remains conservatively public.
    for module_identity in changed_modules:
        if not known.has(module_identity):
            return package_module_index_invalidate_v1(generation, changed_modules, true)
        if not changed.has(module_identity):
            changes.push(PackageModuleChangeV1(module_identity, true, true, true, true, true))
            changed[module_identity] = true
    package_module_index_invalidate_changes_v1(generation, changes)

fn _package_index_route_current_v1(
    entry_path: text,
    snapshot_root: text,
    expected_revision: text,
    expected_tree: text,
    expected_inventory: text,
    expected_producer: text,
    expected_root_generation: text,
    expected_variant_digest: text,
    changed_modules: [text],
    public_interface_changed: bool,
    admitted_semantic_changes: bool
) -> PackageIndexRouteV1:
    if (snapshot_root == "" or expected_revision == "" or
            expected_tree == "" or expected_inventory == ""):
        return PackageIndexRouteV1(false, "scv-authority-missing", [], [], [], [])
    if (expected_producer == "" or expected_root_generation == "" or
            expected_variant_digest == ""):
        return PackageIndexRouteV1(false, "index-compatibility-missing", [], [], [], [])
    val cache_root = machine_cache_root()
    val admitted = package_module_index_read_current_v1(cache_root)
    if not admitted.valid or admitted.generation == nil:
        return PackageIndexRouteV1(false, "index-{admitted.reason}", [], [], [], [])
    val generation = admitted.generation!
    if (generation.schema_version != PACKAGE_MODULE_INDEX_SCHEMA_V2 and
            generation.schema_version != PACKAGE_MODULE_INDEX_SCHEMA_V3 and
            generation.schema_version != PACKAGE_MODULE_INDEX_SCHEMA_V4) or
            generation.variant_digest != expected_variant_digest:
        return PackageIndexRouteV1(false, "index-variant-mismatch", [], [], [], [])
    if (generation.schema_version == PACKAGE_MODULE_INDEX_SCHEMA_V3 or
            (generation.schema_version == PACKAGE_MODULE_INDEX_SCHEMA_V4 and
                generation.scope_entry_source_identity != "")) and
            (entry_path == "" or
                entry_path != generation.scope_entry_source_identity):
        return PackageIndexRouteV1(false, "index-scope-mismatch", [], [], [], [])
    if generation.entries.len() == 0:
        return PackageIndexRouteV1(false, "index-graph-empty", [], [], [], [])
    if generation.producer_digest != expected_producer:
        return PackageIndexRouteV1(false, "index-producer-mismatch", [], [], [], [])
    if generation.root_generation != expected_root_generation:
        return PackageIndexRouteV1(false, "index-root-generation-mismatch", [], [], [], [])
    if generation.scv_revision_id != expected_revision:
        return PackageIndexRouteV1(false, "scv-revision-mismatch", [], [], [], [])
    if generation.scv_tree_id != expected_tree:
        return PackageIndexRouteV1(false, "scv-tree-mismatch", [], [], [], [])
    if generation.inventory_digest != expected_inventory:
        return PackageIndexRouteV1(false, "scv-inventory-mismatch", [], [], [], [])

    var selected_modules: [text] = []
    if entry_path != "":
        val root_module = package_index_route_entry_module_v1(generation, entry_path)
        if root_module == "":
            return PackageIndexRouteV1(false, "entry-not-indexed", [], [], [], [])
        selected_modules = package_index_route_closure_v1(generation, root_module)
        if selected_modules.len() == 0:
            return PackageIndexRouteV1(false, "entry-closure-invalid", [], [], [], [])
    else:
        for entry in generation.entries:
            selected_modules = selected_modules.push(entry.module_identity)
        selected_modules = package_index_route_sorted_unique_v1(selected_modules)
    var selected_members: Dict<text, bool> = {}
    for module_identity in selected_modules:
        selected_members[module_identity] = true
    # Entries are stored by module identity, so members of one package need
    # not be adjacent. Link selected entry indices in that existing order.
    # The warm archive path can then visit each package without rescanning the
    # full generation or copying entry aggregates into a second map.
    var package_heads: Dict<text, i64> = {}
    var package_tails: Dict<text, i64> = {}
    var package_next: [i64] = []
    var entry_index = 0
    for selected_entry in generation.entries:
        package_next.push(-1)
        if selected_members.has(selected_entry.module_identity):
            val package_identity = selected_entry.package_identity
            if package_heads.has(package_identity):
                val tail = package_tails[package_identity]
                package_next[tail] = entry_index
            else:
                package_heads[package_identity] = entry_index
            package_tails[package_identity] = entry_index
        entry_index = entry_index + 1

    var schedule: [text] = []
    var dirty_packages: [text] = []
    if changed_modules.len() > 0:
        val invalidation = if admitted_semantic_changes:
            package_index_route_admitted_invalidation_v1(cache_root, generation, changed_modules)
        else:
            package_module_index_invalidate_v1(generation, changed_modules, public_interface_changed)
        if not invalidation.valid:
            return PackageIndexRouteV1(
                false, "invalidation-{invalidation.reason}", [], [], [], [])
        val consumed = package_scc_consume_index_schedule_v1(
            generation, invalidation.package_schedule)
        if not consumed.valid:
            return PackageIndexRouteV1(
                false, "schedule-{consumed.reason}", [], [], [], [])
        schedule = consumed.package_order
        dirty_packages = invalidation.dirty_packages
        if dirty_packages.len() == 0:
            return PackageIndexRouteV1(
                false, "invalidation-package-sources-missing", [], [], [], [])

    val ordered_modules = package_index_route_ordered_modules_v1(
        generation.entries, selected_modules, selected_members, schedule,
        package_heads, package_next)
    val authority = PackageArchiveAuthorityV1(
        generation.producer_digest, generation.root_generation,
        expected_variant_digest, generation.scv_revision_id,
        generation.scv_tree_id, generation.inventory_digest)
    # Missing archives dirty only their SCC. Corrupt or mismatched archives
    # fail closed and are never replaced by a global source scan.
    var ordered_packages: [text] = []
    var ordered_package_seen: Dict<text, bool> = {}
    var validated_loads: [PackageArchiveLoadV1] = []
    var validated_load_indices: Dict<text, i64> = {}
    for module_identity in ordered_modules:
        val module_entry = package_module_index_find_v1(generation, module_identity)
        if module_entry == nil:
            return PackageIndexRouteV1(false, "indexed-module-missing", [], [], [], [])
        if not ordered_package_seen.has(module_entry!.package_identity):
            ordered_packages.push(module_entry!.package_identity)
            ordered_package_seen[module_entry!.package_identity] = true
    for package_identity in ordered_packages:
        if dirty_packages.contains(package_identity):
            continue
        var package_entries: [PackageModuleIndexEntryV1] = []
        var dependency_digests: [text] = []
        var candidate_index = package_heads[package_identity] ?? -1
        while candidate_index >= 0:
            val candidate = generation.entries[candidate_index]
            package_entries.push(candidate)
            for imported in candidate.direct_imports:
                val dependency = package_module_index_find_v1(
                    generation, imported)
                if dependency == nil:
                    return PackageIndexRouteV1(
                        false, "archive-dependency-missing", [], [], [], [])
                if not dependency_digests.contains(
                        dependency!.smf_metadata_digest):
                    dependency_digests.push(dependency!.smf_metadata_digest)
            candidate_index = package_next[candidate_index]
        val aggregate = package_archive_aggregate_entry_v1(package_entries)
        if aggregate == nil:
            return PackageIndexRouteV1(
                false, "package-aggregate-invalid", [], [], [], [])
        val archive = package_archive_load_v1(
            cache_root, aggregate!, authority, dependency_digests)
        if not archive.valid:
            if not archive.source_required:
                return PackageIndexRouteV1(
                    false, archive.reason, [], [], [], [])
            for candidate in generation.entries:
                if candidate.scc_identity == aggregate!.scc_identity and
                        not dirty_packages.contains(candidate.package_identity):
                    dirty_packages = dirty_packages.push(candidate.package_identity)
            dirty_packages = package_index_route_sorted_unique_v1(dirty_packages)
        else:
            validated_load_indices[package_identity] = validated_loads.len()
            validated_loads.push(archive)

    var source_paths: [text] = []
    var dirty_modules: [DirtyModuleRecordV1] = []
    var archive_admissions: [PackageArchiveAdmissionV1] = []
    var routed_module_count = 0
    for module_identity in ordered_modules:
        val entry = package_module_index_find_v1(generation, module_identity)
        if entry == nil or entry!.source_identity == "":
            return PackageIndexRouteV1(false, "indexed-source-missing", [], [], [], [])
        if dirty_packages.contains(entry!.package_identity):
            # Published HIR seeds carry logical inventory paths. Project only
            # validated relative identities into the already-admitted snapshot;
            # the dirty owner then performs canonical/no-follow source checks.
            var source_entry = entry!
            if compile_source_inventory_path_valid_v1(source_entry.source_identity):
                source_entry.source_identity = "{snapshot_root}/{source_entry.source_identity}"
            val dirty = dirty_module_record_admit_v1(
                generation, source_entry, snapshot_root, expected_revision,
                expected_tree, expected_inventory, expected_producer,
                expected_root_generation, expected_variant_digest)
            if dirty.is_err():
                return PackageIndexRouteV1(
                    false, "dirty-module-admission-failed", [], [], [], [])
            dirty_modules = dirty_modules.push(dirty.unwrap())
            source_paths = source_paths.push(dirty_modules[dirty_modules.len() - 1].source_identity)
            routed_module_count = routed_module_count + 1
            continue
        var already_routed = false
        for admitted in archive_admissions:
            if admitted.package_identity == entry!.package_identity:
                already_routed = true
                break
        if already_routed:
            continue
        var package_entries: [PackageModuleIndexEntryV1] = []
        var module_identities: [text] = []
        var candidate_index = package_heads[entry!.package_identity] ?? -1
        while candidate_index >= 0:
            val candidate = generation.entries[candidate_index]
            package_entries.push(candidate)
            module_identities.push(candidate.module_identity)
            candidate_index = package_next[candidate_index]
        # Generation and selected package links are immutable for this request.
        # Later SCC dirtiness can discard a hit, but cannot change its aggregate.
        # Reuse the first validated receipt instead of hashing the archive twice.
        val load_index = validated_load_indices[entry!.package_identity] ?? -1
        if load_index < 0 or load_index >= validated_loads.len():
            return PackageIndexRouteV1(false, "archive-admission-missing", [], [], [], [])
        val archive = validated_loads[load_index]
        archive_admissions = archive_admissions.push(PackageArchiveAdmissionV1(
            entry!.package_identity,
            canonical_identity_sort_texts(module_identities), package_entries,
            archive.archive_path, archive))
        routed_module_count = routed_module_count + module_identities.len()
    if routed_module_count != selected_modules.len():
        return PackageIndexRouteV1(false, "package-route-closure-mismatch", [], [], [], [])
    val canonical_dirty = dirty_module_records_sort_validate_v1(dirty_modules)
    if canonical_dirty.is_err():
        return PackageIndexRouteV1(
            false, "dirty-module-record-set-invalid", [], [], [], [])
    PackageIndexRouteV1(
        true, "ok", source_paths, canonical_dirty.unwrap(), schedule,
        archive_admissions)

fn package_index_route_current_v1(
    entry_path: text, snapshot_root: text, expected_revision: text,
    expected_tree: text, expected_inventory: text, expected_producer: text,
    expected_root_generation: text, expected_variant_digest: text,
    changed_modules: [text], public_interface_changed: bool
) -> PackageIndexRouteV1:
    # Compatibility API for existing callers with their own classification.
    _package_index_route_current_v1(entry_path, snapshot_root, expected_revision,
        expected_tree, expected_inventory, expected_producer,
        expected_root_generation, expected_variant_digest,
        changed_modules, public_interface_changed, false)

fn package_index_route_admitted_current_v1(
    entry_path: text, snapshot_root: text, expected_revision: text,
    expected_tree: text, expected_inventory: text, expected_producer: text,
    expected_root_generation: text, expected_variant_digest: text,
    changed_modules: [text]
) -> PackageIndexRouteV1:
    _package_index_route_current_v1(entry_path, snapshot_root, expected_revision,
        expected_tree, expected_inventory, expected_producer,
        expected_root_generation, expected_variant_digest,
        changed_modules, true, true)

export PackageArchiveAdmissionV1, PackageIndexRouteV1
export package_index_route_ordered_modules_v1
export package_index_route_current_v1
export package_index_route_admitted_current_v1, package_index_route_admitted_invalidation_v1
export package_index_route_changed_modules_v1
export package_index_route_closure_v1
