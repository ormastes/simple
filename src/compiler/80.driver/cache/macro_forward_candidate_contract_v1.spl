# Primitive transport record. Kept separate from the parser-backed capture
# adapter so pure incremental manifest code does not load the frontend.
use std.common.crypto.sha256.{sha256_text}

pub struct MacroForwardCandidateV1:
    known: bool
    complete: bool  # parsed use coverage only; never compiled-generation authority
    source_digest: text
    definitions_hex: text
    uses_hex: text
    digest: text

pub struct MacroForwardModuleCandidateV1:
    path: text
    source_digest: text
    candidate: MacroForwardCandidateV1

pub struct MacroForwardInvalidationV1:
    users: [text]
    needs_full_recheck: bool
    reason: text

pub fn macro_forward_candidate_digest_v1(path: text, source_digest: text,
        complete: bool, definitions_hex: text, uses_hex: text) -> text:
    val tag = if complete: "1" else: "0"
    val domain = "macro-forward-candidate-v1"
    sha256_text("{domain.len()}:{domain}{path.len()}:{path}{tag.len()}:{tag}" +
        "{source_digest.len()}:{source_digest}{definitions_hex.len()}:{definitions_hex}" +
        "{uses_hex.len()}:{uses_hex}")

pub fn macro_forward_candidate_unknown_v1() -> MacroForwardCandidateV1:
    MacroForwardCandidateV1(known: false, complete: false, source_digest: "", definitions_hex: "",
        uses_hex: "", digest: "")

pub val MACRO_FORWARD_CANDIDATE_MAX_HEX_BYTES_V1: i64 = 16 * 1024 * 1024
pub val MACRO_FORWARD_CANDIDATE_MAX_MODULES_V1: i64 = 4096
pub val MACRO_FORWARD_CANDIDATE_MAX_TOTAL_HEX_BYTES_V1: i64 = 64 * 1024 * 1024

export MacroForwardCandidateV1, MacroForwardModuleCandidateV1, MacroForwardInvalidationV1,
    MACRO_FORWARD_CANDIDATE_MAX_HEX_BYTES_V1, MACRO_FORWARD_CANDIDATE_MAX_MODULES_V1,
    MACRO_FORWARD_CANDIDATE_MAX_TOTAL_HEX_BYTES_V1,
    macro_forward_candidate_unknown_v1, macro_forward_candidate_digest_v1
