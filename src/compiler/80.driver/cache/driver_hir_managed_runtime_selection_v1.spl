# Production managed-runtime handoff. Bundle selection remains the linker's
# existing policy; authority is projected from its real pinned snapshot owner.
use std.nogc_sync_mut.io.native_runtime_authority_v1.{
    NativeRuntimeProviderSelectionV1, native_runtime_strict_root_v1,
    native_runtime_strict_archives_v1,
    native_runtime_strict_provider_selection_v1,
    native_runtime_strict_provider_selection_revalidate_v1}
use compiler.backend.linker.linker_wrapper.{native_runtime_archive_inputs_for_platform,
    native_runtime_bundle_is_known}
use compiler.driver.driver_build.incremental.{native_build_compiler_executable_hash}
use compiler.driver.cache.hir_body_typecheck_lease_v1.{HirBodyArchiveInputV1}
use compiler.driver.cache.driver_hir_archive_authority_v1.{driver_hir_archive_source_binding_v1}
use compiler.driver.driver_hir_cache.{hir_cache_enabled, hir_cache_header,
    hir_cache_key, hir_cache_closure_digest}
use compiler.common.driver_core_types.{SourceFile}
use compiler.hir.hir_lowering.module_surface.{ModuleSurfacesByName}
use std.common.crypto.sha256.{sha256_text}
use std.io_runtime.{host_os, host_arch}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause,
    transient_scope_end, transient_promote}

struct DriverHirManagedRuntimeSelectionV1:
    provider: NativeRuntimeProviderSelectionV1
    compiler_digest: text
    backend: text
    target: text
    runtime_bundle: text
    host_os: text
    host_arch: text
    msvc: bool
    producer_header: text
    selection_digest: text

fn driver_hir_managed_runtime_selection_digest_v1(value: DriverHirManagedRuntimeSelectionV1) -> text:
    var parts: [text] = ["driver-managed-runtime-selection-v1\n",
        sha256_text(value.provider.root), "\n", sha256_text(value.provider.snapshot.path), "\n",
        value.provider.snapshot.digest, "\n", value.compiler_digest, "\n",
        sha256_text(value.backend), "\n", sha256_text(value.target), "\n",
        sha256_text(value.runtime_bundle), "\n", sha256_text(value.host_os), "\n",
        sha256_text(value.host_arch), "\n", "{value.msvc}\n", "{value.provider.pins.len()}\n"]
    for pin in value.provider.pins:
        parts.push(sha256_text(pin.relative) + "\n" + pin.digest + "\n")
    sha256_text(parts.join(""))

fn driver_hir_capture_managed_runtime_selection_v1(
    backend: text, target: text, runtime_bundle: text
) -> Result<DriverHirManagedRuntimeSelectionV1, text>:
    if transient_array_scope_state_v1() != 0:
        return Err("HIR managed runtime selection lease already occupied")
    if (backend != "llvm" and backend != "cranelift") or
            runtime_bundle == "" or runtime_bundle == "auto" or
            not native_runtime_bundle_is_known(runtime_bundle):
        return Err("HIR managed runtime explicit selection unavailable")
    # Capture provenance for the retained route even when HIR caching is off.
    # An archived consumer subsequently requires the actual nonempty header.
    val header = if hir_cache_enabled(): hir_cache_header() else: ""
    # Cold tool -> runtime snapshot -> selected file-pin owners each complete
    # their real owned admission before our borrowed projection may open.
    # No presumed warm memo and no promotion while scratch is unpaused.
    val admitted_root = native_runtime_strict_root_v1()?
    val msvc = target.contains("msvc") or (target == "" and host_os() == "windows")
    val admitted_inputs = native_runtime_archive_inputs_for_platform(admitted_root, runtime_bundle, msvc)
    val _admitted_files = native_runtime_strict_archives_v1(admitted_root, admitted_inputs)?
    if not transient_scope_begin(): return Err("HIR managed runtime selection lease unavailable")
    val result = driver_hir_capture_managed_runtime_selection_in_owned_scope_v1(
        backend, target, runtime_bundle, header)
    val paused = transient_scope_pause()
    val owned = if paused: transient_promote(result) else: false
    val ended = transient_scope_end()
    if not paused or not owned or not ended:
        panic("HIR managed runtime selection ownership failed")
    result

fn driver_hir_capture_managed_runtime_selection_in_owned_scope_v1(
    backend: text, target: text, runtime_bundle: text, header: text
) -> Result<DriverHirManagedRuntimeSelectionV1, text>:
    val compiler = native_build_compiler_executable_hash()
    if compiler.len() != 64: return Err("HIR managed runtime actual compiler identity unavailable")
    val root = native_runtime_strict_root_v1()?
    val os = host_os()
    val arch = host_arch()
    val msvc = target.contains("msvc") or (target == "" and os == "windows")
    val inputs = native_runtime_archive_inputs_for_platform(root, runtime_bundle, msvc)
    val provider = native_runtime_strict_provider_selection_v1(root, inputs)?
    var selected = DriverHirManagedRuntimeSelectionV1(provider, compiler, backend,
        target, runtime_bundle, os, arch, msvc, header, "")
    selected.selection_digest = driver_hir_managed_runtime_selection_digest_v1(selected)
    Ok(selected)

fn driver_hir_archive_input_from_managed_runtime_in_owned_scope_v1(
    selection: DriverHirManagedRuntimeSelectionV1,
    source: SourceFile, surfaces: ModuleSurfacesByName, source_index: i64, is_entry: bool,
    backend: text, target: text, runtime_bundle: text, library_mode: text = ""
) -> Result<HirBodyArchiveInputV1, text>:
    if transient_array_scope_state_v1() != 1:
        return Err("HIR managed runtime borrowed lease must be active and unpaused")
    if selection.backend != backend or selection.target != target or
            selection.runtime_bundle != runtime_bundle or
            selection.msvc != (target.contains("msvc") or (target == "" and host_os() == "windows")) or
            selection.host_os != host_os() or selection.host_arch != host_arch() or
            selection.compiler_digest != native_build_compiler_executable_hash() or
            selection.producer_header == "" or selection.producer_header != hir_cache_header() or
            selection.selection_digest != driver_hir_managed_runtime_selection_digest_v1(selection):
        return Err("HIR managed runtime selected authority changed")
    val inputs = native_runtime_archive_inputs_for_platform(
        selection.provider.root, runtime_bundle, selection.msvc)
    val _live = native_runtime_strict_provider_selection_revalidate_v1(selection.provider, inputs)?
    val source_binding = driver_hir_archive_source_binding_v1(source, surfaces, source_index)?
    val closure = hir_cache_closure_digest(surfaces)
    if closure.len() != 64 or hir_cache_key(source.path, closure, is_entry, library_mode) == "":
        return Err("HIR managed runtime source/cache identity unavailable")
    Ok(HirBodyArchiveInputV1(source_path: source.path, closure_digest: closure,
        is_entry: is_entry, module_name: source.module_name,
        runtime_provider_receipt_path: selection.provider.snapshot.path,
        runtime_provider_digest: selection.provider.snapshot.digest,
        producer_header: selection.producer_header, stage: "lowered-unresolved-v1",
        provider_selection_digest: selection.selection_digest,
        source_content_digest: source_binding.0, source_authored_path: source_binding.1, library_mode: library_mode))

fn driver_hir_archive_input_from_managed_runtime_selection_v1(
    selection: DriverHirManagedRuntimeSelectionV1,
    source: SourceFile, surfaces: ModuleSurfacesByName, source_index: i64, is_entry: bool,
    backend: text, target: text, runtime_bundle: text, library_mode: text = ""
) -> Result<HirBodyArchiveInputV1, text>:
    if transient_array_scope_state_v1() != 0:
        return Err("HIR managed runtime authority lease already occupied")
    if not transient_scope_begin(): return Err("HIR managed runtime authority lease unavailable")
    val result = driver_hir_archive_input_from_managed_runtime_in_owned_scope_v1(
        selection, source, surfaces, source_index, is_entry, backend, target, runtime_bundle, library_mode)
    val paused = transient_scope_pause()
    val owned = if paused: transient_promote(result) else: false
    val ended = transient_scope_end()
    if not paused or not owned or not ended:
        panic("HIR managed runtime authority ownership failed")
    result

export DriverHirManagedRuntimeSelectionV1
export driver_hir_capture_managed_runtime_selection_v1
export driver_hir_archive_input_from_managed_runtime_in_owned_scope_v1
export driver_hir_archive_input_from_managed_runtime_selection_v1
export driver_hir_managed_runtime_selection_digest_v1
