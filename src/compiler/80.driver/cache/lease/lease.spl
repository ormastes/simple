# Cache leases — process-scoped protection against concurrent GC
#
# Schema: cache_protocol.sdn `gc.lease` (class_all: LOCAL_STATE)
# Design: doc/05_design/compiler/semantic_incremental_build_cache_aop_formal_2026-08-09.md §18
#
# Layout: <root>/leases/<lease_id>  — one file per lease, digest-named.
# `gc.lease.reclaim_rule`: "only after proving the owning process/session is
# dead, or after a conservative timeout PLUS a generation check." This
# implementation checks liveness via rt_process_exists (kill -0 semantics);
# a dead process's lease reclaims immediately. A live process whose lease is
# merely stale (no heartbeat) is reclaimed only past LEASE_STALE_TIMEOUT_SECS
# AND a heartbeat-generation check (the recorded generation must not have
# advanced since the reclaim check started reading it).
# ponytail: LEASE_STALE_TIMEOUT_SECS is a conservative ceiling, not measured
# against a real build's longest single action; revisit if a legitimate lease
# is ever reclaimed while its process is still alive but slow.

@unsafe(reason: "raw lease read; empty text is valid data and also the unreadable or provider-failure sentinel", capabilities: [ffi])
extern fn rt_file_read_text(path: text) -> text
@unsafe(reason: "raw lease write status; false means the provider did not complete the write", capabilities: [ffi])
extern fn rt_file_write_text(path: text, content: text) -> bool
@unsafe(reason: "raw file probe; false includes absent, inaccessible, or provider failure", capabilities: [ffi])
extern fn rt_file_exists(path: text) -> bool
@unsafe(reason: "raw lease delete status; false includes absent, inaccessible, or provider failure", capabilities: [ffi])
extern fn rt_file_delete(path: text) -> bool
@unsafe(reason: "raw directory creation status; false means the provider did not establish the directory", capabilities: [ffi])
extern fn rt_dir_create_all(path: text) -> bool
@unsafe(reason: "raw directory listing; empty data includes an empty directory or provider failure", capabilities: [ffi])
extern fn rt_dir_list(path: text) -> [text]
@unsafe(reason: "raw process identity; non-positive values are the provider-failure sentinel", capabilities: [ffi])
extern fn rt_getpid() -> i64
@unsafe(reason: "raw wall clock; negative values are the provider-failure sentinel", capabilities: [ffi])
extern fn rt_time_now_unix_micros() -> i64
@unsafe(reason: "raw liveness probe; false includes dead process, permission denial, or provider failure", capabilities: [ffi])
extern fn rt_process_exists(pid: i64) -> bool

use std.crypto.sha256.{sha256_text}

val LEASE_HEADER: text = "simple-cache-lease-v1"
val LEASE_STALE_TIMEOUT_SECS: i64 = 21600   # 6h conservative ceiling

struct CacheLease:
    lease_id: text
    process_id: i64
    created_at: i64
    heartbeat_generation: i64
    referenced_manifests: [text]
    referenced_artifacts: [text]

fn lease_dir(root: text) -> text:
    "{root}/leases"

fn lease_path(root: text, lease_id: text) -> text:
    "{lease_dir(root)}/{lease_id}"

fn lease_serialize(lease: CacheLease) -> text:
    var lines: [text] = [
        LEASE_HEADER,
        lease.lease_id,
        "{lease.process_id}",
        "{lease.created_at}",
        "{lease.heartbeat_generation}",
        "manifests:{lease.referenced_manifests.join(\",\")}",
        "artifacts:{lease.referenced_artifacts.join(\",\")}",
    ]
    lines.join("\n")

fn split_csv(s: text) -> [text]:
    if s == "":
        return []
    s.split(",")

fn lease_parse(content: text) -> CacheLease?:
    val lines = content.split("\n")
    if lines.len() < 7:
        return nil
    if lines[0] != LEASE_HEADER:
        return nil
    val pid = lines[2].trim().to_i64() ?? -1
    val created = lines[3].trim().to_i64() ?? 0
    val gen = lines[4].trim().to_i64() ?? 0
    val manifests = split_csv(lines[5].replace("manifests:", ""))
    val artifacts = split_csv(lines[6].replace("artifacts:", ""))
    CacheLease(
        lease_id: lines[1],
        process_id: pid,
        created_at: created,
        heartbeat_generation: gen,
        referenced_manifests: manifests,
        referenced_artifacts: artifacts,
    )

# Acquire a new lease for the current process. lease_id is derived from
# pid + timestamp so two acquires from the same process never collide.
fn lease_acquire(root: text, referenced_manifests: [text], referenced_artifacts: [text]) -> CacheLease?:
    var dir_ready = false
    unsafe(capabilities: [ffi]):
        dir_ready = rt_dir_create_all(lease_dir(root))
    if not dir_ready:
        return nil
    var pid: i64 = -1
    var now: i64 = -1
    unsafe(capabilities: [ffi]):
        pid = rt_getpid()
    unsafe(capabilities: [ffi]):
        now = rt_time_now_unix_micros()
    if pid <= 0 or now < 0:
        return nil
    val lease_id = sha256_text("{pid}-{now}")
    val lease = CacheLease(
        lease_id: lease_id,
        process_id: pid,
        created_at: now,
        heartbeat_generation: 0,
        referenced_manifests: referenced_manifests,
        referenced_artifacts: referenced_artifacts,
    )
    var written = false
    unsafe(capabilities: [ffi]):
        written = rt_file_write_text(lease_path(root, lease_id), lease_serialize(lease))
    if written:
        return lease
    nil

fn lease_release(root: text, lease_id: text) -> bool:
    val path = lease_path(root, lease_id)
    var exists = false
    unsafe(capabilities: [ffi]):
        exists = rt_file_exists(path)
    if not exists:
        return true
    unsafe(capabilities: [ffi]):
        rt_file_delete(path)

fn lease_heartbeat(root: text, lease_id: text) -> bool:
    val path = lease_path(root, lease_id)
    var exists = false
    unsafe(capabilities: [ffi]):
        exists = rt_file_exists(path)
    if not exists:
        return false
    var content = ""
    unsafe(capabilities: [ffi]):
        content = rt_file_read_text(path) ?? ""
    match lease_parse(content):
        case Some(lease):
            val bumped = CacheLease(
                lease_id: lease.lease_id,
                process_id: lease.process_id,
                created_at: lease.created_at,
                heartbeat_generation: lease.heartbeat_generation + 1,
                referenced_manifests: lease.referenced_manifests,
                referenced_artifacts: lease.referenced_artifacts,
            )
            unsafe(capabilities: [ffi]):
                return rt_file_write_text(path, lease_serialize(bumped))
        case nil:
            return false

fn lease_read(root: text, lease_id: text) -> CacheLease?:
    val path = lease_path(root, lease_id)
    var exists = false
    unsafe(capabilities: [ffi]):
        exists = rt_file_exists(path)
    if not exists:
        return nil
    var content = ""
    unsafe(capabilities: [ffi]):
        content = rt_file_read_text(path) ?? ""
    lease_parse(content)

# A lease is reclaimable (safe to delete without violating gc_reachability_safe)
# only if the owning process is provably dead, or the heartbeat generation has
# not advanced past a conservative staleness timeout.
fn lease_is_reclaimable(lease: CacheLease, now_unix_micros: i64) -> bool:
    var alive = false
    unsafe(capabilities: [ffi]):
        alive = rt_process_exists(lease.process_id)
    if not alive:
        return true
    val age_secs = (now_unix_micros - lease.created_at) / 1000000
    age_secs >= LEASE_STALE_TIMEOUT_SECS

# All non-reclaimable leases in root, i.e. the GC roots this module contributes.
fn lease_list_active(root: text) -> [CacheLease]:
    val dir = lease_dir(root)
    var exists = false
    unsafe(capabilities: [ffi]):
        exists = rt_file_exists(dir)
    if not exists:
        return []
    var out: [CacheLease] = []
    var now: i64 = -1
    unsafe(capabilities: [ffi]):
        now = rt_time_now_unix_micros()
    unsafe(capabilities: [ffi]):
        for name in rt_dir_list(dir):
            val content = rt_file_read_text("{dir}/{name}") ?? ""
            match lease_parse(content):
                case Some(lease):
                    if not lease_is_reclaimable(lease, now):
                        out = out.push(lease)
                case nil:
                    pass_do_nothing
    out

# Reclaim (delete) every stale/dead-owner lease file. Returns count reclaimed.
fn lease_reclaim_stale(root: text) -> i64:
    val dir = lease_dir(root)
    var exists = false
    unsafe(capabilities: [ffi]):
        exists = rt_file_exists(dir)
    if not exists:
        return 0
    var count = 0
    var now: i64 = -1
    unsafe(capabilities: [ffi]):
        now = rt_time_now_unix_micros()
    unsafe(capabilities: [ffi]):
        for name in rt_dir_list(dir):
            val path = "{dir}/{name}"
            val content = rt_file_read_text(path) ?? ""
            match lease_parse(content):
                case Some(lease):
                    if lease_is_reclaimable(lease, now):
                        val deleted = rt_file_delete(path)
                        if deleted:
                            count = count + 1
                case nil:
                    pass_do_nothing
    count
