# Cache leases — process-scoped protection against concurrent GC
#
# Schema: cache_protocol.sdn `gc.lease` (class_all: LOCAL_STATE)
# Design: doc/05_design/compiler/semantic_incremental_build_cache_aop_formal_2026-08-09.md §18
#
# Layout: <root>/leases/<lease_id>  — one file per lease, digest-named.
# `gc.lease.reclaim_rule`: "only after proving the owning process/session is
# dead, or after a conservative timeout PLUS a generation check." This
# implementation checks liveness via rt_process_exists (kill -0 semantics);
# a dead process's lease reclaims immediately. A live process is always
# authoritative: elapsed wall time alone can never prove that its cache roots
# are unused. This deliberately prefers retaining bytes over deleting an
# artifact still owned by a long-running bootstrap or compiler process.

@unsafe(reason: "raw cache lease process-liveness ABI", capabilities: [ffi])
extern fn rt_process_exists(pid: i64) -> bool

use std.crypto.sha256.{sha256_text}
use std.io_runtime.{dir_create_all, dir_list, file_delete, file_exists, getpid, time_now_unix_micros}
use std.file_system.{file_write_text}
use std.nogc_sync_mut.io_runtime.{file_read_nullable}

@always_inline
fn lease_file_write_raw(path: text, content: text) -> bool:
    unsafe(capabilities: [ffi]):
        file_write_text(path, content)
@always_inline
fn lease_file_exists_raw(path: text) -> bool:
    unsafe(capabilities: [ffi]):
        file_exists(path)
@always_inline
fn lease_file_delete_raw(path: text) -> bool:
    unsafe(capabilities: [ffi]):
        file_delete(path)
@always_inline
fn lease_dir_create_all_raw(path: text) -> bool:
    unsafe(capabilities: [ffi]):
        dir_create_all(path)
@always_inline
fn lease_dir_list_raw(path: text) -> [text]:
    unsafe(capabilities: [ffi]):
        dir_list(path)
@always_inline
fn lease_process_id_raw() -> i64:
    unsafe(capabilities: [ffi]):
        getpid()
@always_inline
fn lease_time_now_unix_micros_raw() -> i64:
    unsafe(capabilities: [ffi]):
        time_now_unix_micros()
@always_inline
fn lease_process_exists_raw(pid: i64) -> bool:
    unsafe(capabilities: [ffi]):
        rt_process_exists(pid)

val LEASE_HEADER: text = "simple-cache-lease-v1"
val LEASE_STALE_TIMEOUT_SECS: i64 = 21600   # 6h conservative ceiling

struct CacheLease:
    lease_id: text
    process_id: i64
    created_at: i64
    heartbeat_generation: i64
    referenced_manifests: [text]
    referenced_artifacts: [text]

fn lease_dir(root: text) -> text:
    "{root}/leases"

fn lease_path(root: text, lease_id: text) -> text:
    "{lease_dir(root)}/{lease_id}"

fn lease_serialize(lease: CacheLease) -> text:
    var lines: [text] = [
        LEASE_HEADER,
        lease.lease_id,
        "{lease.process_id}",
        "{lease.created_at}",
        "{lease.heartbeat_generation}",
        "manifests:{lease.referenced_manifests.join(\",\")}",
        "artifacts:{lease.referenced_artifacts.join(\",\")}",
    ]
    lines.join("\n")

fn split_csv(s: text) -> [text]:
    if s == "":
        return []
    s.split(",")

fn lease_parse(content: text) -> CacheLease?:
    val lines = content.split("\n")
    if lines.len() < 7:
        return nil
    if lines[0] != LEASE_HEADER:
        return nil
    val pid = lines[2].trim().to_i64() ?? -1
    val created = lines[3].trim().to_i64() ?? 0
    val gen = lines[4].trim().to_i64() ?? 0
    val manifests = split_csv(lines[5].replace("manifests:", ""))
    val artifacts = split_csv(lines[6].replace("artifacts:", ""))
    CacheLease(
        lease_id: lines[1],
        process_id: pid,
        created_at: created,
        heartbeat_generation: gen,
        referenced_manifests: manifests,
        referenced_artifacts: artifacts,
    )

# Acquire a new lease for the current process. lease_id is derived from
# pid + timestamp so two acquires from the same process never collide.
fn lease_acquire(root: text, referenced_manifests: [text], referenced_artifacts: [text]) -> CacheLease?:
    lease_dir_create_all_raw(lease_dir(root))
    val pid = lease_process_id_raw()
    val now = lease_time_now_unix_micros_raw()
    val lease_id = sha256_text("{pid}-{now}")
    val lease = CacheLease(
        lease_id: lease_id,
        process_id: pid,
        created_at: now,
        heartbeat_generation: 0,
        referenced_manifests: referenced_manifests,
        referenced_artifacts: referenced_artifacts,
    )
    if lease_file_write_raw(lease_path(root, lease_id), lease_serialize(lease)):
        return lease
    nil

fn lease_release(root: text, lease_id: text) -> bool:
    val path = lease_path(root, lease_id)
    if not lease_file_exists_raw(path):
        return true
    lease_file_delete_raw(path)

fn lease_heartbeat(root: text, lease_id: text) -> bool:
    val path = lease_path(root, lease_id)
    if not lease_file_exists_raw(path):
        return false
    val maybe_content = file_read_nullable(path)
    if maybe_content == nil:
        panic("E-SFFI-CACHE-LEASE-READ: unreadable existing lease: {path}")
    val content = maybe_content.unwrap()
    match lease_parse(content):
        case Some(lease):
            val bumped = CacheLease(
                lease_id: lease.lease_id,
                process_id: lease.process_id,
                created_at: lease.created_at,
                heartbeat_generation: lease.heartbeat_generation + 1,
                referenced_manifests: lease.referenced_manifests,
                referenced_artifacts: lease.referenced_artifacts,
            )
            return lease_file_write_raw(path, lease_serialize(bumped))
        case nil:
            return false

fn lease_read(root: text, lease_id: text) -> CacheLease?:
    val path = lease_path(root, lease_id)
    if not lease_file_exists_raw(path):
        return nil
    val maybe_content = file_read_nullable(path)
    if maybe_content == nil:
        panic("E-SFFI-CACHE-LEASE-READ: unreadable existing lease: {path}")
    lease_parse(maybe_content.unwrap())

# A lease is reclaimable (safe to delete without violating gc_reachability_safe)
# only if the owning process is provably dead. PID reuse is conservative: a
# reused live PID retains the lease until an owner/session identity mechanism
# can prove otherwise.
fn lease_is_reclaimable(lease: CacheLease, now_unix_micros: i64) -> bool:
    not lease_process_exists_raw(lease.process_id)

# All non-reclaimable leases in root, i.e. the GC roots this module contributes.
fn lease_list_active(root: text) -> [CacheLease]:
    val dir = lease_dir(root)
    if not lease_file_exists_raw(dir):
        return []
    var out: [CacheLease] = []
    val now = lease_time_now_unix_micros_raw()
    for name in lease_dir_list_raw(dir):
        val path = "{dir}/{name}"
        val maybe_content = file_read_nullable(path)
        if maybe_content == nil:
            panic("E-SFFI-CACHE-LEASE-READ: unreadable existing lease: {path}")
        val content = maybe_content.unwrap()
        match lease_parse(content):
            case Some(lease):
                if not lease_is_reclaimable(lease, now):
                    out = out.push(lease)
            case nil:
                pass_do_nothing
    out

# Reclaim (delete) every stale/dead-owner lease file. Returns count reclaimed.
fn lease_reclaim_stale(root: text) -> i64:
    val dir = lease_dir(root)
    if not lease_file_exists_raw(dir):
        return 0
    var count = 0
    val now = lease_time_now_unix_micros_raw()
    for name in lease_dir_list_raw(dir):
        val path = "{dir}/{name}"
        val maybe_content = file_read_nullable(path)
        if maybe_content == nil:
            # An unreadable lease must remain a GC root; never reclaim it.
            continue
        val content = maybe_content.unwrap()
        match lease_parse(content):
            case Some(lease):
                if lease_is_reclaimable(lease, now):
                    lease_file_delete_raw(path)
                    count = count + 1
            case nil:
                pass_do_nothing
    count
