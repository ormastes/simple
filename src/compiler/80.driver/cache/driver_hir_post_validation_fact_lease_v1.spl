# Two borrowed, complete-body reads for the original post-HIR boundary. The
# caller merges declarations in actual logical publication order, then scans
# bodies with those exact cross-module indexes. These are fact rows, NOT final
# admission or a replacement for actual immutable publication replay.
# Caller lifecycle: pause, promote ONLY the Result DTO/refusal plus the existing
# cache diagnostic owner, clear the cache warning alias, then end the scope.
# Never promote the decoded module or any full default/function/initializer.
use compiler.driver.cache.hir_body_typecheck_lease_v1.{HirBodyArchiveV1,
    hir_body_archive_load_in_owned_scope_v1}
use compiler.driver.driver_hir_cache.{hir_cache_last_warnings}
use compiler.semantics.value_struct_layout.{ValueStructLayoutModuleV1, value_struct_layout_declarations_v1}
use compiler.semantics.layer_eq_checker.{LayerEqType}
use compiler.hir.hir_definitions.{HirStruct}
use compiler.hir.hir_types.{HirModule}
use compiler.semantics.layer_eq_validation.{layer_eq_struct_declaration_v1}
use compiler.semantics.effect_validation.{EffectFunctionFactsV1, effect_struct_sizes_for_module_v1,
    effect_fn_names_for_module_v1, effect_function_facts_v1}
use compiler.semantics.rt_criticality_validation.{RtCriticalFunctionDeclarationV1,
    RtCriticalFunctionFactsV1, rt_module_function_declarations_v1, rt_function_facts_v1,
    rt_unambiguous_declaration_names_v1}
use compiler.semantics.join_point_model.{JoinPoint, forward_join_points_for_module_v1}
use compiler.frontend.effect_registry.{effect_registry_claim_keys}
use compiler.frontend.rt_criticality_registry.{rt_criticality_claim_keys}
use compiler.frontend.aspect_registry.{aspect_registry_claim_keys}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}

struct DriverHirPostValidationDeclarationsV1:
    module_key: text
    archive_key: text
    body_digest: text
    module_identities: [text]
    value_layout: ValueStructLayoutModuleV1
    layer_names: [text]
    effect_struct_sizes: Dict<i64, i64>
    effect_fn_names: Dict<i64, text>
    rt_declarations: [RtCriticalFunctionDeclarationV1]
    lowering_warnings: [text]

struct DriverHirPostValidationBodyFactsV1:
    module_key: text
    archive_key: text
    body_digest: text
    # Exactly the required LAST-name winners selected across all declarations.
    layer_layouts: [LayerEqType]
    effect_functions: [EffectFunctionFactsV1]
    rt_functions: [RtCriticalFunctionFactsV1]
    forwards: [JoinPoint]
    first_join_point_id: i64
    lowering_warnings: [text]

# Selection is a walker input, not an admission grant. The immutable driver
# policy owner supplies its captured claim selection for replay. Compatibility
# wrappers below continue selecting from the real current parser registries.
pub fn driver_hir_post_validation_declarations_selected_in_owned_scope_v1(
        module_key: text, archive: HirBodyArchiveV1,
        effect_claims_selected: bool) -> Result<DriverHirPostValidationDeclarationsV1, text>:
    if transient_array_scope_state_v1() != 1 or module_key == "":
        return Err("post-HIR declaration lease requires actual logical module and active unpaused scope")
    val module = hir_body_archive_load_in_owned_scope_v1(archive, archive.input)?
    driver_hir_post_validation_declarations_from_module_in_owned_scope_v1(module_key, archive,
        module, effect_claims_selected)

pub fn driver_hir_post_validation_declarations_from_module_in_owned_scope_v1(
        module_key: text, archive: HirBodyArchiveV1, module: HirModule,
        effect_claims_selected: bool) -> Result<DriverHirPostValidationDeclarationsV1, text>:
    if transient_array_scope_state_v1() != 1 or module_key == "" or
            module.name != archive.input.module_name or module.path != archive.input.source_path:
        return Err("post-HIR live declaration module identity refused")
    var identities: [text] = [module_key]
    if module.path != "" and not identities.contains(module.path): identities.push(module.path)
    if module.name != "" and not identities.contains(module.name): identities.push(module.name)
    var layer_names: [text] = []
    for struct_ in module.structs.values():
        if struct_.type_params.len() == 0 and not struct_.is_generic_template: layer_names.push(struct_.name)
    # The legacy effect pass does not measure unrelated layouts when there are
    # no claims. Never broaden that selection merely to populate a DTO.
    var sizes: Dict<i64, i64> = {}
    var names: Dict<i64, text> = {}
    if effect_claims_selected:
        sizes = effect_struct_sizes_for_module_v1(module)
        names = effect_fn_names_for_module_v1(module)
    Ok(DriverHirPostValidationDeclarationsV1(module_key: module_key, archive_key: archive.archive_key,
        body_digest: archive.body_digest, module_identities: identities,
        value_layout: value_struct_layout_declarations_v1(module_key, module.path, module.structs, module.symbols),
        layer_names: layer_names, effect_struct_sizes: sizes, effect_fn_names: names,
        rt_declarations: rt_module_function_declarations_v1(module_key, module),
        lowering_warnings: hir_cache_last_warnings()))

# Shared actual walkers consume complete admitted bodies inside this borrowed
# lease. Index arguments are body-free recipes; the eventual driver owner must
# reconstruct and bind them to every original ordered declaration lease before
# publication. No typechecker, semantic validator or weave gate is skipped here
# by claiming a boolean success; this helper only produces their real inputs.
pub fn driver_hir_post_validation_body_facts_selected_in_owned_scope_v1(
        module_key: text, archive: HirBodyArchiveV1, selected_layer_names: [text],
        effect_sizes: Dict<i64, i64>, effect_names: Dict<i64, text>,
        all_rt_declarations: [RtCriticalFunctionDeclarationV1], first_join_point_id: i64,
        effect_claims_selected: bool, aspect_claims_selected: bool, rt_claims_selected: bool
) -> Result<DriverHirPostValidationBodyFactsV1, text>:
    if transient_array_scope_state_v1() != 1 or module_key == "" or first_join_point_id < 0:
        return Err("post-HIR body facts require actual logical module and active unpaused scope")
    val module = hir_body_archive_load_in_owned_scope_v1(archive, archive.input)?
    driver_hir_post_validation_body_facts_from_module_in_owned_scope_v1(module_key, archive,
        module, selected_layer_names, effect_sizes, effect_names, all_rt_declarations,
        first_join_point_id, effect_claims_selected, aspect_claims_selected, rt_claims_selected)

pub fn driver_hir_post_validation_body_facts_from_module_in_owned_scope_v1(
        module_key: text, archive: HirBodyArchiveV1, module: HirModule, selected_layer_names: [text],
        effect_sizes: Dict<i64, i64>, effect_names: Dict<i64, text>,
        all_rt_declarations: [RtCriticalFunctionDeclarationV1], first_join_point_id: i64,
        effect_claims_selected: bool, aspect_claims_selected: bool, rt_claims_selected: bool
) -> Result<DriverHirPostValidationBodyFactsV1, text>:
    if transient_array_scope_state_v1() != 1 or module_key == "" or first_join_point_id < 0 or
            module.name != archive.input.module_name or module.path != archive.input.source_path:
        return Err("post-HIR live body fact module identity refused")
    var layouts: [LayerEqType] = []
    var measured: [text] = []
    # Preserve the original last-name winner inside this module too. The
    # aggregate caller selects only winners belonging to this logical module.
    var by_name: Dict<text, HirStruct> = {}
    for struct_ in module.structs.values():
        if struct_.type_params.len() > 0 or struct_.is_generic_template: continue
        by_name[struct_.name] = struct_
    for name in selected_layer_names:
        if measured.contains(name) or not by_name.has(name): return Err("post-HIR selected layer recipe absent or duplicate")
        measured.push(name)
        layouts.push(layer_eq_struct_declaration_v1(by_name[name]))
    var effects: [EffectFunctionFactsV1] = []
    if effect_claims_selected:
        for func in module.functions.values(): effects.push(effect_function_facts_v1(func, effect_sizes, effect_names))
    var rt_functions: [RtCriticalFunctionFactsV1] = []
    var rt_enabled = rt_claims_selected
    # One HAL root anywhere activates the complete compilation graph, including
    # unannotated callees in modules that do not themselves contain HAL roots.
    for declaration in all_rt_declarations:
        if declaration.is_rt_hal: rt_enabled = true
    for func in module.functions.values():
        if func.func_attr.is_rt_hal: rt_enabled = true
    if rt_enabled:
        val rt_names = rt_unambiguous_declaration_names_v1(all_rt_declarations)
        for func in module.functions.values(): rt_functions.push(rt_function_facts_v1(module_key, module, func, rt_names))
    var forwards: [JoinPoint] = []
    if aspect_claims_selected:
        forwards = forward_join_points_for_module_v1(module, first_join_point_id)
    Ok(DriverHirPostValidationBodyFactsV1(module_key: module_key, archive_key: archive.archive_key,
        body_digest: archive.body_digest, layer_layouts: layouts, effect_functions: effects,
        rt_functions: rt_functions, forwards: forwards, first_join_point_id: first_join_point_id,
        lowering_warnings: hir_cache_last_warnings()))

# The ordinary path preserves exactly the current registry selection. Loading
# an immutable archive does not parse declarations or mutate these registries.
pub fn driver_hir_post_validation_declarations_in_owned_scope_v1(
        module_key: text, archive: HirBodyArchiveV1) -> Result<DriverHirPostValidationDeclarationsV1, text>:
    if transient_array_scope_state_v1() != 1 or module_key == "":
        return Err("post-HIR declaration lease requires actual logical module and active unpaused scope")
    driver_hir_post_validation_declarations_selected_in_owned_scope_v1(module_key, archive,
        effect_registry_claim_keys().len() > 0)

pub fn driver_hir_post_validation_body_facts_in_owned_scope_v1(
        module_key: text, archive: HirBodyArchiveV1, selected_layer_names: [text],
        effect_sizes: Dict<i64, i64>, effect_names: Dict<i64, text>,
        all_rt_declarations: [RtCriticalFunctionDeclarationV1], first_join_point_id: i64
) -> Result<DriverHirPostValidationBodyFactsV1, text>:
    if transient_array_scope_state_v1() != 1 or module_key == "" or first_join_point_id < 0:
        return Err("post-HIR body facts require actual logical module and active unpaused scope")
    driver_hir_post_validation_body_facts_selected_in_owned_scope_v1(module_key, archive,
        selected_layer_names, effect_sizes, effect_names, all_rt_declarations, first_join_point_id,
        effect_registry_claim_keys().len() > 0, aspect_registry_claim_keys().len() > 0,
        rt_criticality_claim_keys().len() > 0)

export DriverHirPostValidationDeclarationsV1, DriverHirPostValidationBodyFactsV1
export driver_hir_post_validation_declarations_selected_in_owned_scope_v1
export driver_hir_post_validation_body_facts_selected_in_owned_scope_v1
export driver_hir_post_validation_declarations_in_owned_scope_v1
export driver_hir_post_validation_body_facts_in_owned_scope_v1
export driver_hir_post_validation_declarations_from_module_in_owned_scope_v1
export driver_hir_post_validation_body_facts_from_module_in_owned_scope_v1
