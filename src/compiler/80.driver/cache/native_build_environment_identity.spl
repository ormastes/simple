val NATIVE_BUILD_NONSEMANTIC_ENVIRONMENT_FIELDS_V1: [text] = [
    # Diagnostics, profiling destinations, cache locations, and trace sinks do
    # not alter compiler decisions or artifact bytes. Present SIMPLE_* values
    # are still captured by the complete snapshot; this classification only
    # exempts their absence from explicit absent-row encoding.
    "SIMPLE_BUILD_DIAG_LOG",
    "SIMPLE_BUILD_DIAG_RETAIN",
    "SIMPLE_BUILD_ORDINAL",
    "SIMPLE_BUILD_PROGRESS_EVENTS",
    "SIMPLE_COMPILER_PHASE_PROFILE",
    "SIMPLE_COMPILER_PHASE_PROFILE_FILE",
    "SIMPLE_COMPILER_TRACE",
    "SIMPLE_DEMAND_COMPILE_PROFILE",
    "SIMPLE_EXECUTION_METRICS_FILE",
    "SIMPLE_INTERP_TRACE",
    "SIMPLE_KEEP_LLVM_IR",
    "SIMPLE_MEM_SNAPSHOT",
    "SIMPLE_NATIVE_BUILD_TRACE_CLOSURE_FILE",
    "SIMPLE_NATIVE_BUILD_TRACE_CLOSURE_TIMING",
    "SIMPLE_NATIVE_NOOP_CACHE_ROOT",
    "SIMPLE_NATIVE_NOOP_FINAL_OUTPUT",
    "SIMPLE_OS_LOG_MODE",
    "SIMPLE_TRACE_PHASE2",
    # Temporary-directory selection changes private staging placement only.
    # These non-SIMPLE runtime controls are intentionally excluded from the
    # artifact identity after publication/collision tests prove byte parity.
    "TEMP",
    "TMP",
    "TMPDIR",
]

struct NativeBuildEnvironmentFingerprintV1:
    valid: bool
    digest: text
    reason: text

fn native_build_environment_field_known_v1(name: text) -> bool:
    NATIVE_BUILD_SEMANTIC_ENVIRONMENT_FIELDS_V1.contains(name) or
        NATIVE_BUILD_NONSEMANTIC_ENVIRONMENT_FIELDS_V1.contains(name)

fn native_build_environment_frame_v1(rows: [text]) -> text:
    var framed = "{NATIVE_BUILD_ENVIRONMENT_SCHEMA_V1.len()}:{NATIVE_BUILD_ENVIRONMENT_SCHEMA_V1}{rows.len()};"
    for row in rows:
        framed = framed + "{row.len()}:{row}"
    framed

fn native_build_environment_snapshot_fingerprint_v1(
    snapshot: [(text, text)]
) -> NativeBuildEnvironmentFingerprintV1:
    var observed: {text: text} = {}
    var rows: [text] = []
    for pair in snapshot:
        val (name, value) = pair
        if observed.contains_key(name):
            return NativeBuildEnvironmentFingerprintV1(
                false, "", "environment-field-duplicate:{name}")
        observed[name] = value
        if name.starts_with("SIMPLE_"):
            rows.push("present|{name.len()}:{name}|{value.len()}:{value}")
    for name in NATIVE_BUILD_SEMANTIC_ENVIRONMENT_FIELDS_V1:
        if observed.contains_key(name):
            if not name.starts_with("SIMPLE_"):
                val value = observed[name]
                rows.push("present|{name.len()}:{name}|{value.len()}:{value}")
        else:
            rows.push("absent|{name.len()}:{name}")
    rows = rows.sorted()
    NativeBuildEnvironmentFingerprintV1(
        true, sha256_text(native_build_environment_frame_v1(rows)), "ok")

fn native_build_environment_fingerprint_rows_v1(
    names: [text], values: [text]
) -> NativeBuildEnvironmentFingerprintV1:
    if names.len() != values.len():
        return NativeBuildEnvironmentFingerprintV1(
            false, "", "environment-field-count-mismatch")
    if names.len() != NATIVE_BUILD_SEMANTIC_ENVIRONMENT_FIELDS_V1.len():
        return NativeBuildEnvironmentFingerprintV1(
            false, "", "environment-schema-incomplete")
    var rows: [text] = []
    var index: i64 = 0
    while index < names.len():
        val name = names[index]
        if name != NATIVE_BUILD_SEMANTIC_ENVIRONMENT_FIELDS_V1[index]:
            if not native_build_environment_field_known_v1(name):
                return NativeBuildEnvironmentFingerprintV1(
                    false, "", "environment-field-unknown:{name}")
            return NativeBuildEnvironmentFingerprintV1(
                false, "", "environment-schema-order-mismatch:{name}")
        rows.push("{name.len()}:{name}{values[index].len()}:{values[index]}")
        index = index + 1
    NativeBuildEnvironmentFingerprintV1(
        true, sha256_text(native_build_environment_frame_v1(rows)), "ok")

fn native_build_environment_fingerprint_v1() ->
        NativeBuildEnvironmentFingerprintV1:
    match env_list_checked():
        case Err(reason): NativeBuildEnvironmentFingerprintV1(
            false, "", "environment-snapshot-unavailable:{reason}")
        case Ok(snapshot): native_build_environment_snapshot_fingerprint_v1(snapshot)

export NativeBuildEnvironmentFingerprintV1
export NATIVE_BUILD_ENVIRONMENT_SCHEMA_V1
export NATIVE_BUILD_SEMANTIC_ENVIRONMENT_FIELDS_V1
export NATIVE_BUILD_NONSEMANTIC_ENVIRONMENT_FIELDS_V1
export native_build_environment_field_known_v1
export native_build_environment_fingerprint_rows_v1
export native_build_environment_snapshot_fingerprint_v1
export native_build_environment_fingerprint_v1
