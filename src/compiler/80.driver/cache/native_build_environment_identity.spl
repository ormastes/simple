val NATIVE_BUILD_NONSEMANTIC_ENVIRONMENT_FIELDS_V1: [text] = [
    # Diagnostics, profiling destinations, cache locations, and trace sinks do
    # not alter compiler decisions or artifact bytes. Present SIMPLE_* values
    # are still captured by the complete snapshot; this classification only
    # exempts their absence from explicit absent-row encoding.
    "SIMPLE_BUILD_DIAG_LOG",
    "SIMPLE_BUILD_DIAG_RETAIN",
    "SIMPLE_BUILD_ORDINAL",
    "SIMPLE_BUILD_PROGRESS_EVENTS",
    "SIMPLE_COMPILER_PHASE_PROFILE",
    "SIMPLE_COMPILER_PHASE_PROFILE_FILE",
    "SIMPLE_COMPILER_TRACE",
    "SIMPLE_DEMAND_COMPILE_PROFILE",
    "SIMPLE_EXECUTION_METRICS_FILE",
    "SIMPLE_INTERP_TRACE",
    "SIMPLE_KEEP_LLVM_IR",
    "SIMPLE_MEM_SNAPSHOT",
    "SIMPLE_NATIVE_BUILD_TRACE_CLOSURE_FILE",
    "SIMPLE_NATIVE_BUILD_TRACE_CLOSURE_TIMING",
    "SIMPLE_NATIVE_NOOP_CACHE_ROOT",
    "SIMPLE_NATIVE_NOOP_FINAL_OUTPUT",
    "SIMPLE_OS_LOG_MODE",
    "SIMPLE_TRACE_PHASE2",
    # Temporary-directory selection changes private staging placement only.
    # These non-SIMPLE runtime controls are intentionally excluded from the
    # artifact identity after publication/collision tests prove byte parity.
    "TEMP",
    "TMP",
    "TMPDIR",
]

struct NativeBuildEnvironmentFingerprintV1:
    valid: bool
    digest: text
    reason: text

fn native_build_environment_field_known_v1(name: text) -> bool:
    NATIVE_BUILD_SEMANTIC_ENVIRONMENT_FIELDS_V1.contains(name) or
        NATIVE_BUILD_NONSEMANTIC_ENVIRONMENT_FIELDS_V1.contains(name)

fn native_build_environment_frame_v1(rows: [text]) -> text:
    var framed = "{NATIVE_BUILD_ENVIRONMENT_SCHEMA_V1.len()}:{NATIVE_BUILD_ENVIRONMENT_SCHEMA_V1}{rows.len()};"
    for row in rows:
        framed = framed + "{row.len()}:{row}"
    framed

fn native_build_environment_snapshot_fingerprint_v1(
    snapshot: [(text, text)]
) -> NativeBuildEnvironmentFingerprintV1:
    var observed: {text: text} = {}
    var rows: [text] = []
    for pair in snapshot:
        val (name, value) = pair
        if observed.contains_key(name):
            return NativeBuildEnvironmentFingerprintV1(
                false, "", "environment-field-duplicate:{name}")
        observed[name] = value
        if name.starts_with("SIMPLE_"):
            rows.push("present|{name.len()}:{name}|{value.len()}:{value}")
    for name in NATIVE_BUILD_SEMANTIC_ENVIRONMENT_FIELDS_V1:
        if observed.contains_key(name):
            if not name.starts_with("SIMPLE_"):
                val value = observed[name]
                rows.push("present|{name.len()}:{name}|{value.len()}:{value}")
        else:
            rows.push("absent|{name.len()}:{name}")
    rows = rows.sorted()
    NativeBuildEnvironmentFingerprintV1(
        true, sha256_text(native_build_environment_frame_v1(rows)), "ok")

fn native_build_environment_fingerprint_rows_v1(
    names: [text], values: [text]
) -> NativeBuildEnvironmentFingerprintV1:
    if names.len() != values.len():
        return NativeBuildEnvironmentFingerprintV1(
            false, "", "environment-field-count-mismatch")
    if names.len() != NATIVE_BUILD_SEMANTIC_ENVIRONMENT_FIELDS_V1.len():
        return NativeBuildEnvironmentFingerprintV1(
            false, "", "environment-schema-incomplete")
    var rows: [text] = []
    var index: i64 = 0
    while index < names.len():
        val name = names[index]
        if name != NATIVE_BUILD_SEMANTIC_ENVIRONMENT_FIELDS_V1[index]:
            if not native_build_environment_field_known_v1(name):
                return NativeBuildEnvironmentFingerprintV1(
                    false, "", "environment-field-unknown:{name}")
            return NativeBuildEnvironmentFingerprintV1(
                false, "", "environment-schema-order-mismatch:{name}")
        rows.push("{name.len()}:{name}{values[index].len()}:{values[index]}")
        index = index + 1
    NativeBuildEnvironmentFingerprintV1(
        true, sha256_text(native_build_environment_frame_v1(rows)), "ok")

# Final delivery intent does not change an executable/entry module's native
# codegen. Project only this known field, after validating the complete capture.
# Every other compiler/tool/provider/config/source field remains conservative.
fn native_build_module_environment_snapshot_fingerprint_v1(
    snapshot: [(text, text)]
) -> NativeBuildEnvironmentFingerprintV1:
    val complete = native_build_environment_snapshot_fingerprint_v1(snapshot)
    if not complete.valid: return complete
    var selective_objects = false
    for pair in snapshot:
        if pair.0 == "SIMPLE_MIR_SELECTIVE" and pair.1 == "1":
            selective_objects = true
    var projected: [(text, text)] = []
    for pair in snapshot:
        # Each selective physical job gets a fresh lowering owner. Its actual
        # declaration/context witness remains below; the number of admitted
        # sibling processes cannot change its object identity.
        if selective_objects and pair.0 == "SIMPLE_NATIVE_BUILD_THREADS":
            continue
        if pair.0 == "SIMPLE_NATIVE_BUILD_EMIT_OBJECT" and
                (pair.1 == "" or pair.1 == "entry"):
            continue
        # MIR sharding / staging only choose WHICH process emits a module
        # (driver_build/native_mir_shard.spl); the per-pid ledger and per-
        # worker spec would otherwise give every worker and every build a
        # private object scope. A cached object is still admitted only by
        # its capsule's MIR identity, so this cannot reuse a different MIR.
        if pair.0 == "SIMPLE_MIR_SHARDING" or pair.0 == "SIMPLE_MIR_SHARD" or
                pair.0 == "SIMPLE_MIR_SHARD_QUEUE" or pair.0 == "SIMPLE_MIR_SHARD_OWNER" or
                pair.0 == "SIMPLE_MIR_SHARD_LINK" or pair.0 == "SIMPLE_MIR_SHARD_WORKER_KB" or
                pair.0 == "SIMPLE_MIR_SHARD_COUNT" or pair.0 == "SIMPLE_MIR_SHARD_ONLY_PATHS" or
                pair.0 == "SIMPLE_MIR_FORK_WORKERS" or
                pair.0 == "SIMPLE_SHARD_MEM_CLAMP" or
                pair.0 == "SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB" or
                pair.0 == "SIMPLE_MIR_SHARD_EXPORT_DIR" or
                pair.0 == "SIMPLE_MIR_SHARD_EXPORT_WRITE" or
                pair.0 == "SIMPLE_MIR_SHARD_EXPORT_SUMMARIES" or
                pair.0 == "SIMPLE_MIR_SELECTIVE_PARENT_KIB" or
                pair.0 == "SIMPLE_MIR_SELECTIVE_WORKER_KIB" or
                pair.0 == "SIMPLE_MIR_SELECTIVE_EXPORTER_KIB" or
                pair.0 == "SIMPLE_MIR_SELECTIVE_PHASE_KIB" or
                pair.0 == "SIMPLE_MIR_SELECTIVE_DISK_BYTES" or
                pair.0 == "SIMPLE_MIR_SELECTIVE_DISK_RESERVE_BYTES" or
                pair.0 == "SIMPLE_NATIVE_STAGED_CODEGEN_BATCH" or
                pair.0 == "SIMPLE_NATIVE_PRELOWER_CACHE":
            continue
        # go-to-end (driver_build/go_to_end.spl) only decides whether the
        # build stops at the first failing phase or emits every producible
        # object and skips the link; an object's bytes do not depend on it.
        # Folding it gave a go-to-end run a scope a plain run never hit, so
        # the "objects reused by a later run" promise in that file's header
        # was false until this exclusion.
        if pair.0 == "SIMPLE_NATIVE_GO_TO_END":
            continue
        # SIMPLE_ICE_DIR (ice_boundary_claim_run: "<pid>_<hash>") and
        # SIMPLE_NATIVE_BUILD_WARM_CLOSURE_CANDIDATE (candidate-<pid>.receipt)
        # are per-run, pid-valued evidence locations the CLI sets itself; they
        # only choose where ICE receipts / warm-closure candidates are written.
        # Folding them gave every rerun a new cache scope and 0 object hits
        # (doc/08_tracking/bug/native_cache_scope_pid_env_2026-10-24.md).
        # Observability sinks and the external RSS ceiling. The bootstrap
        # stamps the profile/snapshot paths and run id with its pid, so every
        # relaunch got a private object scope. Each is read only to choose a
        # log/evidence destination or gate diagnostic printing
        # (driver_log_helpers.spl, driver_mem_snapshot.spl, the *_trace_enabled
        # helpers); the ceiling is consumed by the bootstrap scripts' watchdog
        # and read by no compiler/runtime source. None reaches a compiler
        # decision, so object bytes cannot depend on them. The complete
        # capture above still records them for admission/no-op evidence.
        if pair.0 == "SIMPLE_COMPILER_PHASE_PROFILE" or
                pair.0 == "SIMPLE_COMPILER_PHASE_PROFILE_FILE" or
                pair.0 == "SIMPLE_MEM_SNAPSHOT_FILE" or
                pair.0 == "SIMPLE_EVIDENCE_RUN_ID" or
                pair.0 == "SIMPLE_BUILD_PROGRESS_EVENTS" or
                pair.0 == "SIMPLE_BOOTSTRAP_COMPILER_RSS_CEILING_KIB" or
                pair.0 == "SIMPLE_ICE_DIR" or
                pair.0 == "SIMPLE_NATIVE_BUILD_WARM_CLOSURE_CANDIDATE":
            continue
        projected = projected.push(pair)
    val module_capture = native_build_environment_snapshot_fingerprint_v1(projected)
    if not module_capture.valid: return module_capture
    NativeBuildEnvironmentFingerprintV1(true,
        sha256_text("simple-native-module-environment-v1\n" + module_capture.digest), "ok")

fn native_build_module_environment_fingerprint_v1() -> NativeBuildEnvironmentFingerprintV1:
    match env_list_checked():
        case Err(reason): NativeBuildEnvironmentFingerprintV1(
            false, "", "module-environment-snapshot-unavailable:" + reason)
        case Ok(snapshot): native_build_module_environment_snapshot_fingerprint_v1(snapshot)

fn native_build_environment_fingerprint_v1() ->
        NativeBuildEnvironmentFingerprintV1:
    match env_list_checked():
        case Err(reason): NativeBuildEnvironmentFingerprintV1(
            false, "", "environment-snapshot-unavailable:{reason}")
        case Ok(snapshot): native_build_environment_snapshot_fingerprint_v1(snapshot)

export NativeBuildEnvironmentFingerprintV1
export NATIVE_BUILD_ENVIRONMENT_SCHEMA_V1
export NATIVE_BUILD_SEMANTIC_ENVIRONMENT_FIELDS_V1
export NATIVE_BUILD_NONSEMANTIC_ENVIRONMENT_FIELDS_V1
export native_build_environment_field_known_v1
export native_build_environment_fingerprint_rows_v1
export native_build_environment_snapshot_fingerprint_v1
export native_build_environment_fingerprint_v1

export native_build_module_environment_snapshot_fingerprint_v1
export native_build_module_environment_fingerprint_v1
