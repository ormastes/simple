use compiler.common.cache_contract.directory_tldr_snapshot_v2.{DirectoryTldrSourceSnapshotV2}
use compiler.common.cache_contract.aspect_match_shard_v1.{directory_facts_key_v1}
use compiler.common.cache_contract.physical_tld_v1.{three_payload_contract_digest_valid_v1}
# P4/P6: drive the static forward weave through per-directory pointcut match
# shards (cache_contract/aspect_match_shard_v1) with single-flight production
# (cache/daemon/cache_single_flight_v1).
#
# doc/03_plan/compiler/cache/generic_aop_macro_semantic_cache_plan_2026-10-24.md §5.
#
# Per compile: HIR modules are grouped into DirectoryJoinPointFactsV1 by the
# directory of their path; each (selector, directory facts) shard is acquired
# from the persistent match cache, and on a miss produced once by the
# single-flight leader. Only modules that own a matched join point are visited,
# and each visit is the UNCHANGED per-claim weaver
# (aspect_weave.weave_forward_advice_claim_in_module_v1), so the live
# forwarder-shape check is never bypassed. An unsupported selector or
# incomplete facts falls back to visiting every module (the legacy result).
#
# No locks: the state is owned by the driver's single event loop, the match
# cache is a persistent value, and the single-flight table hands waiters the
# leader's result instead of producing again.
#
# Function attributes come from frontend/join_point_attr_registry (recorded
# during HIR lowering, keyed by the lowering filename == HirModule.path).

use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.semantics.join_point_model.{forward_join_points_for_module_v1}
use compiler.semantics.aspect_validation.{aspect_module_identity_index}
use compiler.semantics.aspect_weave.{AspectForwardWeaveClaimV1,
    aspect_forward_weave_claims_v1, weave_forward_advice_claim_in_module_v1}
use compiler.semantics.join_point_model.{forward_join_points}
use compiler.common.cache_contract.guard_id_v1.{GuardEvalV1, active_guard_root_v1}
use compiler.common.cache_contract.aspect_match_shard_v1.{directory_join_point_facts_guarded_v1}
use compiler.common.cache_contract.aspect_plugin_model_v1.{Pointcut, SelectorPointcutV1,
    PluginDefinitionV1, PluginConfigFieldV1, PluginFieldRoleV1, PluginConfigValueV1, PluginInstanceDescriptorV1, PluginInstancePoolV1}
use compiler.frontend.core.cfg_platform.{cfg_detect_os, cfg_detect_arch}
use compiler.driver.cache.aop_guard_eval_v1.{aop_guard_profile_v1, aop_source_guard_evals_v1,
    aop_module_guard_evals_v1}
use compiler.frontend.join_point_attr_registry.{join_point_attr_names_of}
use compiler.common.cache_contract.aspect_match_shard_v1.{JoinPointFactV1,
    DirectoryJoinPointFactsV1, PointcutSelectorV1, PointcutMatchCacheV1, PointcutMatchShardV1,
    pointcut_selector_parse_v1, pointcut_match_key_v1,
    pointcut_match_cache_new_v1, pointcut_match_cache_acquire_v1}
use std.common.string_core.{text_to_bytes}
use compiler.driver.cache.daemon.cache_single_flight_v1.{CacheSingleFlightV1,
    SINGLE_FLIGHT_LEADER_V1, cache_single_flight_key_v1}

class AopMatchDriverStateV1:
    cache: PointcutMatchCacheV1
    flights: CacheSingleFlightV1
    shard_hits: i64
    shard_misses: i64
    fallbacks: i64
    sources: Dict<text, text>
    selector_plans: Dict<text, PointcutSelectorV1>
    selector_plan_keys: [text]
    selector_plan_capacity: i64
    selector_parse_count: i64
    selector_plan_hits: i64
    selector_plan_evictions: i64
    plugin_instances: PluginInstancePoolV1

    static fn create() -> AopMatchDriverStateV1:
        AopMatchDriverStateV1.create_with_selector_capacity(256).unwrap()

    static fn create_with_selector_capacity(capacity: i64) -> Result<AopMatchDriverStateV1, text>:
        if capacity <= 0:
            return Err("selector-plan-capacity-invalid")
        Ok(AopMatchDriverStateV1(
            cache: pointcut_match_cache_new_v1(), flights: CacheSingleFlightV1.create(),
            shard_hits: 0, shard_misses: 0, fallbacks: 0, sources: {},
            selector_plans: {}, selector_plan_keys: [], selector_plan_capacity: capacity,
            selector_parse_count: 0, selector_plan_hits: 0, selector_plan_evictions: 0,
            plugin_instances: PluginInstancePoolV1.create(256).unwrap()))

fn _selector_plan_key(source: text) -> text:
    "aop-selector-runtime/v1\u0000" + source

fn _same_selector_plan(left: PointcutSelectorV1, right: PointcutSelectorV1) -> bool:
    (left.selector_digest == right.selector_digest and
    left.supported == right.supported and
    left.form == right.form and
    left.operand == right.operand and
    left.needs_universe == right.needs_universe)

fn _selector_plan_canonical(state: AopMatchDriverStateV1,
        parsed: PointcutSelectorV1) -> PointcutSelectorV1:
    for key in state.selector_plan_keys:
        val existing = state.selector_plans[key]
        if _same_selector_plan(existing, parsed):
            return existing
    parsed

fn _selector_plan_insert(state: AopMatchDriverStateV1, key: text,
        plan: PointcutSelectorV1):
    var keys = state.selector_plan_keys
    var plans = state.selector_plans
    if keys.len() >= state.selector_plan_capacity:
        var retained_keys: [text] = []
        var retained_plans: Dict<text, PointcutSelectorV1> = {}
        for index in 1..keys.len():
            val old_key = keys[index]
            retained_keys.push(old_key)
            retained_plans[old_key] = plans[old_key]
        keys = retained_keys
        plans = retained_plans
        state.selector_plan_evictions = state.selector_plan_evictions + 1
    keys.push(key)
    plans[key] = plan
    state.selector_plan_keys = keys
    state.selector_plans = plans

pub fn aop_selector_plan_acquire_v1(state: AopMatchDriverStateV1,
        source: text) -> PointcutSelectorV1:
    # The owner serializes acquisitions. Exact hits skip parsing; semantic
    # aliases keep the first spelling. This bounds aliases, not external plans.
    val key = _selector_plan_key(source)
    if state.selector_plans.contains_key(key):
        state.selector_plan_hits = state.selector_plan_hits + 1
        return state.selector_plans[key]
    val parsed = SelectorPointcutV1(source: source).compile()
    state.selector_parse_count = state.selector_parse_count + 1
    val canonical = _selector_plan_canonical(state, parsed)
    _selector_plan_insert(state, key, canonical)
    canonical

fn _dir_of(path: text) -> text:
    val i = path.rfind("/")
    if i == nil: return ""
    path.slice(0, i!)

fn module_key_path(module_key: text, module: HirModule) -> text:
    if module.path != "": return module.path
    module_key

fn _module_file(module_key: text, module: HirModule) -> text:
    if module.path != "": return module.path.replace("\\", "/")
    module_key

# Complete per-directory inventory of `forward` join points. Every module in
# `modules` is enumerated, so each directory's facts are complete for this
# compilation's module set.
# `sources` overrides the on-disk text by file (in-memory snapshots, tests);
# any other module is read from its path for guard evaluation.
pub fn aop_directory_facts_from_hir_v1(modules: Dict<text, HirModule>,
        sources: Dict<text, text>) -> [DirectoryJoinPointFactsV1]:
    var files_of: Dict<text, [text]> = {}
    var guards_of: Dict<text, [GuardEvalV1]> = {}
    var points_of: Dict<text, [JoinPointFactV1]> = {}
    for module_key in modules.keys():
        val module: HirModule = modules[module_key]
        val file = _module_file(module_key, module)
        val dir = _dir_of(file)
        if not files_of.contains_key(dir):
            files_of[dir] = []
            points_of[dir] = []
            guards_of[dir] = []
        var files = files_of[dir]
        files.push(file)
        files_of[dir] = files
        var guards = guards_of[dir]
        var evals: [GuardEvalV1] = []
        if sources.contains_key(file):
            evals = aop_source_guard_evals_v1(sources[file], cfg_detect_os(), cfg_detect_arch())
        else:
            evals = aop_module_guard_evals_v1(module_key_path(module_key, module))
        for g in evals:
            guards.push(g)
        guards_of[dir] = guards
        var points = points_of[dir]
        for jp in forward_join_points_for_module_v1(module, 1):
            points.push(JoinPointFactV1(id: "{module_key}::{jp.source_symbol}", kind: jp.kind,
                symbol: jp.source_symbol,
                attrs: join_point_attr_names_of(module_key_path(module_key, module), jp.source_symbol),
                owner_file: file, base_body_digest: ""))
        points_of[dir] = points
    var out: [DirectoryJoinPointFactsV1] = []
    for dir in files_of.keys():
        out.push(directory_join_point_facts_guarded_v1(dir, files_of[dir], points_of[dir], [], true,
            active_guard_root_v1(aop_guard_profile_v1(), guards_of[dir])))
    out

fn _encode_ids(ids: [text]) -> [u8]:
    var s = ""
    for id in ids:
        s = s + id + "\n"
    text_to_bytes(s)

# Acquire one shard: cache hit, or single-flight leader production. The
# driver loop is single-threaded, so the leader completes before any waiter
# polls; a waiter that still sees no result re-acquires from the cache.
pub fn aop_match_shard_acquire_v1(state: AopMatchDriverStateV1, selector: text,
        facts: DirectoryJoinPointFactsV1, request_id: text) -> PointcutMatchShardV1:
    val sel = aop_selector_plan_acquire_v1(state, selector)
    _aop_match_shard_from_plan_v1(state, sel, facts, request_id)

fn _aop_match_shard_from_plan_v1(state: AopMatchDriverStateV1, sel: PointcutSelectorV1,
        facts: DirectoryJoinPointFactsV1, request_id: text) -> PointcutMatchShardV1:
    val key = cache_single_flight_key_v1("aop.match", pointcut_match_key_v1(sel, facts))
    val (role, _flight) = state.flights.join(key, request_id)
    val r = pointcut_match_cache_acquire_v1(state.cache, sel, facts)
    state.cache = r.cache
    if r.hit:
        state.shard_hits = state.shard_hits + 1
    else:
        state.shard_misses = state.shard_misses + 1
    if not r.cacheable: state.fallbacks = state.fallbacks + 1
    if role == SINGLE_FLIGHT_LEADER_V1:
        # Waiters re-acquire from the cache and never read future(): release.
        val done = state.flights.complete_flight(key, request_id, _encode_ids(r.shard.sorted_matching_ids))
        state.flights.forget(done)
    r.shard

# Structural transport check only. Production obtains these values from the
# current CompileContext capture, never by accepting a persisted DTO as authority.
pub fn aop_directory_snapshot_matches_v2(snapshot: DirectoryTldrSourceSnapshotV2,
        facts: DirectoryJoinPointFactsV1) -> bool:
    snapshot.scope_id == facts.scope_id and snapshot.facts.complete and facts.complete and
        snapshot.facts.sorted_member_files == facts.sorted_member_files and
        snapshot.facts.facts_key == facts.facts_key and
        directory_facts_key_v1(snapshot.facts) == snapshot.facts.facts_key and
        three_payload_contract_digest_valid_v1(snapshot.inventory_digest) and
        three_payload_contract_digest_valid_v1(snapshot.provider_digest) and
        three_payload_contract_digest_valid_v1(snapshot.file_tldr_root_digest)
pub struct AopPluginMatchAcquireV1:
    instance: PluginInstanceDescriptorV1
    instance_hit: bool
    match_key: text
    shard: PointcutMatchShardV1

# The admitted producer supplies code identity and the closed config schema.
# This is a pure matching API, not code loading or plugin admission. Scope
# values cannot affect execution here: only the explicit selector and facts
# feed the existing matcher. The caller must bind its directory input through
# the directory-TLDR admission factory when using persisted facts.
#
# Existing legacy registry claims lack a code digest/config and keep their
# original path. Never manufacture a code identity from an advice name.
pub fn aop_plugin_match_shard_acquire_v1(state: AopMatchDriverStateV1,
        definition: PluginDefinitionV1, config: [PluginConfigValueV1], selector: text,
        facts: DirectoryJoinPointFactsV1, request_id: text) -> Result<AopPluginMatchAcquireV1, text>:
    val sel = aop_selector_plan_acquire_v1(state, selector)
    if not sel.supported or not facts.complete:
        return Err("plugin-match-incomplete")
    val instance = state.plugin_instances.acquire(definition, config)?
    val shard = _aop_match_shard_from_plan_v1(state, sel, facts, request_id)
    Ok(AopPluginMatchAcquireV1(instance: instance.instance, instance_hit: instance.hit,
        match_key: pointcut_match_key_v1(sel, facts), shard: shard))

# The snapshot owner checked this compiler provider's content digest. It names
# the builtin adapter implementation, not an advice body or a loaded plugin.
# The closed schema cannot retain the first directory when the descriptor is
# shared. Missing/invalid provider identity is rejected by the digest registry.
pub fn aop_builtin_forward_match_acquire_v1(state: AopMatchDriverStateV1,
        provider_digest: text, selector: text, facts: DirectoryJoinPointFactsV1,
        request_id: text) -> Result<AopPluginMatchAcquireV1, text>:
    val definition = PluginDefinitionV1(code_digest: "sha256:" + provider_digest,
        fields: [PluginConfigFieldV1(name: "builtin_entry", role: PluginFieldRoleV1.Instance),
            PluginConfigFieldV1(name: "directory", role: PluginFieldRoleV1.Scope)])
    val config = [PluginConfigValueV1(name: "builtin_entry", value: "simple.compiler.static-forward/v1"),
        PluginConfigValueV1(name: "directory", value: facts.scope_id)]
    aop_plugin_match_shard_acquire_v1(state, definition, config, selector, facts, request_id)

# Cached replacement for aspect_weave.weave_forward_advice: same claims, same
# per-module weaver, but module visits are driven by the matched shard ids.
pub fn aop_weave_with_match_cache_v1(state: AopMatchDriverStateV1,
        modules: Dict<text, HirModule>,
        snapshots: [DirectoryTldrSourceSnapshotV2]? = nil) -> i64:
    var woven: i64 = 0
    val module_ids = aspect_module_identity_index(modules)
    val claims = aspect_forward_weave_claims_v1(module_ids, forward_join_points(modules))
    if claims.len() == 0: return woven
    var dirs: [DirectoryJoinPointFactsV1] = []
    var snapshot_coverage_complete = true
    var snapshot_providers: Dict<text, text> = {}
    if snapshots == nil:
        dirs = aop_directory_facts_from_hir_v1(modules, state.sources)
    else:
        var covered_files: Dict<text, bool> = {}
        var covered_dirs: Dict<text, bool> = {}
        for snapshot in snapshots.unwrap():
            if covered_dirs.contains_key(snapshot.scope_id) or
                    not aop_directory_snapshot_matches_v2(snapshot, snapshot.facts):
                snapshot_coverage_complete = false
                continue
            covered_dirs[snapshot.scope_id] = true
            snapshot_providers[snapshot.scope_id] = snapshot.provider_digest
            for path in snapshot.facts.sorted_member_files:
                if covered_files.contains_key(path) or _dir_of(path) != snapshot.scope_id:
                    snapshot_coverage_complete = false
                covered_files[path] = true
            dirs.push(snapshot.facts)
        if covered_files.len() != modules.len(): snapshot_coverage_complete = false
        for key in modules.keys():
            val module: HirModule = modules[key]
            if not covered_files.contains_key(_module_file(key, module)):
                snapshot_coverage_complete = false
    for claim in claims:
        var visit: Dict<text, bool> = {}
        var fallback = not snapshot_coverage_complete
        if fallback: state.fallbacks = state.fallbacks + 1
        for facts in dirs:
            var selected_shard: PointcutMatchShardV1? = nil
            if snapshots == nil:
                selected_shard = Some(aop_match_shard_acquire_v1(state, claim.selector, facts, claim.registry_key))
            elif snapshot_providers.contains_key(facts.scope_id):
                match aop_builtin_forward_match_acquire_v1(state,
                        snapshot_providers[facts.scope_id], claim.selector, facts, claim.registry_key):
                    case Ok(acquired): selected_shard = Some(acquired.shard)
                    case Err(_):
                        fallback = true
                        state.fallbacks = state.fallbacks + 1
            if selected_shard == nil:
                fallback = true
                continue
            val shard = selected_shard.unwrap()
            if not shard.complete: fallback = true
            for id in shard.sorted_matching_ids:
                val sep = id.rfind("::")
                if sep != nil: visit[id.slice(0, sep!)] = true
        for module_key in modules.keys():
            if not fallback and not visit.contains_key(module_key): continue
            val (module, n) = weave_forward_advice_claim_in_module_v1(
                module_key, modules[module_key], module_ids, claim)
            woven = woven + n
            if n > 0: modules[module_key] = module
    woven

export AopMatchDriverStateV1, aop_directory_facts_from_hir_v1
export aop_selector_plan_acquire_v1, aop_match_shard_acquire_v1, aop_weave_with_match_cache_v1

# Driver-loop-owned state: shards survive across compiles in one process
# (daemon / LSP / watch), so a later advice-body or pointcut edit reuses every
# unaffected directory shard.
var _aop_match_driver_state_v1 = AopMatchDriverStateV1.create()

pub fn aop_weave_forward_advice_cached_v1(modules: Dict<text, HirModule>,
        snapshots: [DirectoryTldrSourceSnapshotV2]? = nil) -> i64:
    aop_weave_with_match_cache_v1(_aop_match_driver_state_v1, modules, snapshots)

export aop_weave_forward_advice_cached_v1
