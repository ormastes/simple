# Actual pre-consumption policy capture. This immutable recipe is NOT a
# completed post-HIR gate, a transformed-body capability or final admission.
# The eventual prerequisite owner must replay every actual complete body.
use compiler.driver.driver_types.{CompileContext}
use compiler.driver.cache.driver_hir_archive_schedule_v1.{DriverHirArchiveScheduleV1}
use compiler.driver.cache.driver_hir_archive_journal_v1.{DriverHirArchiveJournalV1,
    driver_hir_archive_journal_verify_v1}
use compiler.driver.cache.hir_owned_artifact_cache_v1.{hir_owned_artifact_context_v1}
use compiler.driver.cache.hir_body_semantic_lease_v1.{hir_body_semantic_policy_v1}
use compiler.common.cache_contract.hir_owned_artifact_cache_v1.{HirOwnedArtifactContextV1,
    hir_owned_artifact_store_blob_v1, hir_owned_artifact_load_blob_v1}
use compiler.semantics.layer_eq_validation.{LayerEqContractClaimV1, layer_eq_contract_claims_v1}
use compiler.semantics.effect_validation.{EffectContractClaimV1, effect_contract_claims_v1}
use compiler.semantics.aspect_validation.{AspectContractClaimV1, aspect_contract_claims_v1}
use compiler.semantics.rt_criticality_validation.{RtCriticalContractClaimV1, rt_critical_contract_claims_v1}
use compiler.semantics.rt_criticality.{RtBoundCapability, rt_bound_manifest_capabilities,
    rt_implicit_profile_is_error}
use compiler.hir.hir_codec_support.{HirCodecWriter}
use compiler.frontend.core.flat_pool_codec.{FlatPoolReader}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.io.env_ops.{env_get}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause,
    transient_scope_end, transient_promote}

struct DriverHirPostValidationPolicyOwnerV1:
    cache: HirOwnedArtifactContextV1
    artifact_key: text
    artifact_digest: text
    source_binding: text
    schedule_digest: text
    journal_key: text
    registration_digest: text
    registration_epoch: i64
    selection_digest: text
    semantic_policy_key: text

# Borrowed scratch only. Never promote the complete decoded policy on replay.
struct DriverHirPostValidationPolicyLoadV1:
    layer: [LayerEqContractClaimV1]
    effects: [EffectContractClaimV1]
    rt: [RtCriticalContractClaimV1]
    aspects: [AspectContractClaimV1]
    capabilities: [RtBoundCapability]
    layout_cycle_mode: text
    quiet_mode: text
    implicit_rt_error: bool

fn driver_hir_policy_frame_v1(owner: DriverHirPostValidationPolicyOwnerV1,
        policy: DriverHirPostValidationPolicyLoadV1) -> text:
    var w = HirCodecWriter.create()
    w.put_text("driver-hir-post-validation-policy-v1")
    w.put_text(owner.source_binding)
    w.put_text(owner.schedule_digest)
    w.put_text(owner.journal_key)
    w.put_text(owner.registration_digest)
    w.put_i64(owner.registration_epoch)
    w.put_text(owner.selection_digest)
    w.put_text(owner.semantic_policy_key)
    w.put_text(policy.layout_cycle_mode)
    w.put_text(policy.quiet_mode)
    w.put_bool(policy.implicit_rt_error)
    w.put_i64(policy.layer.len())
    for claim in policy.layer:
        w.put_text(claim.registry_key)
        w.put_text(claim.path)
        w.put_text(claim.view)
        w.put_text(claim.target)
        w.put_i64(claim.renames.len())
        for rename in claim.renames: w.put_text(rename)
    w.put_i64(policy.effects.len())
    for claim in policy.effects:
        w.put_text(claim.registry_key)
        w.put_text(claim.path)
        w.put_text(claim.fn_name)
        w.put_i64(claim.budget)
        w.put_bool(claim.bounded)
    w.put_i64(policy.rt.len())
    for claim in policy.rt:
        w.put_text(claim.registry_key)
        w.put_text(claim.path)
        w.put_text(claim.fn_name)
        w.put_text(claim.profile)
        w.put_text(claim.reason)
        w.put_text(claim.raw_bounds)
        w.put_bool(claim.is_hal)
    w.put_i64(policy.aspects.len())
    for claim in policy.aspects:
        w.put_text(claim.registry_key)
        w.put_text(claim.path)
        w.put_text(claim.advice_fn)
        w.put_text(claim.kind)
        w.put_text(claim.selector)
        w.put_text(claim.mode)
        w.put_bool(claim.readonly)
        w.put_bool(claim.noalloc)
        w.put_bool(claim.bounded_time)
    w.put_i64(policy.capabilities.len())
    for capability in policy.capabilities:
        w.put_text(capability.subject_id)
        w.put_text(capability.closure_digest)
        w.put_i64(capability.effect)
        w.put_i64(capability.max_units)
        w.put_text(capability.review_id)
    if not w.ok: return ""
    w.finish()

fn driver_hir_policy_key_v1(owner: DriverHirPostValidationPolicyOwnerV1, frame: text) -> text:
    sha256_text("driver-hir-post-validation-policy-artifact-v1\n" + sha256_text(frame) + "\n" +
        owner.schedule_digest + "\n" + owner.journal_key + "\n" + owner.cache.producer_header)

# Compare complete source-produced rows, not a supplied clean verdict. The
# replay parse owns isolated registries; no old out-of-scope row can mask a
# missing source claim. Inter-module order remains the captured actual order.
pub fn driver_hir_policy_source_claims_match_in_owned_scope_v1(
        owner: DriverHirPostValidationPolicyOwnerV1, policy: DriverHirPostValidationPolicyLoadV1,
        identities: [text]) -> bool:
    if transient_array_scope_state_v1() != 1: return false
    var layer: [LayerEqContractClaimV1] = []
    var effects: [EffectContractClaimV1] = []
    var rt: [RtCriticalContractClaimV1] = []
    var aspects: [AspectContractClaimV1] = []
    for claim in policy.layer:
        if identities.contains(claim.path): layer.push(claim)
    for claim in policy.effects:
        if identities.contains(claim.path): effects.push(claim)
    for claim in policy.rt:
        if identities.contains(claim.path): rt.push(claim)
    for claim in policy.aspects:
        if identities.contains(claim.path): aspects.push(claim)
    val expected = DriverHirPostValidationPolicyLoadV1(layer, effects, rt, aspects, [], "", "", false)
    val actual = DriverHirPostValidationPolicyLoadV1(layer_eq_contract_claims_v1(), effect_contract_claims_v1(),
        rt_critical_contract_claims_v1(), aspect_contract_claims_v1(), [], "", "", false)
    driver_hir_policy_frame_v1(owner, expected) == driver_hir_policy_frame_v1(owner, actual)

pub fn driver_hir_policy_live_capabilities_match_in_owned_scope_v1(
        owner: DriverHirPostValidationPolicyOwnerV1) -> Result<bool, text>:
    if transient_array_scope_state_v1() != 1: return Err("weave manifest comparison requires owned scratch")
    val policy = driver_hir_post_validation_policy_load_in_owned_scope_v1(owner)?
    val expected = DriverHirPostValidationPolicyLoadV1([], [], [], [], policy.capabilities, "", "", false)
    val actual = DriverHirPostValidationPolicyLoadV1([], [], [], [], rt_bound_manifest_capabilities(), "", "", false)
    if driver_hir_policy_frame_v1(owner, expected) != driver_hir_policy_frame_v1(owner, actual):
        return Err("weave original pre-consumption RT manifest changed")
    Ok(true)

fn driver_hir_policy_bool_v1(reader: FlatPoolReader) -> bool:
    val raw = reader.next_i64()
    if raw != 0 and raw != 1: reader.ok = false
    raw == 1

pub fn driver_hir_post_validation_policy_load_in_owned_scope_v1(
        owner: DriverHirPostValidationPolicyOwnerV1) -> Result<DriverHirPostValidationPolicyLoadV1, text>:
    if transient_array_scope_state_v1() != 1 or owner.artifact_key.len() != 64 or owner.artifact_digest.len() != 64:
        return Err("post-HIR policy read requires actual pinned artifact and active ownership")
    val frame = hir_owned_artifact_load_blob_v1(owner.cache, owner.artifact_key)?
    if sha256_text(frame) != owner.artifact_digest or driver_hir_policy_key_v1(owner, frame) != owner.artifact_key:
        return Err("post-HIR policy immutable artifact differs")
    var r = FlatPoolReader.new(frame)
    if r.decode_text(r.next()) != "driver-hir-post-validation-policy-v1" or
            r.decode_text(r.next()) != owner.source_binding or r.decode_text(r.next()) != owner.schedule_digest or
            r.decode_text(r.next()) != owner.journal_key or r.decode_text(r.next()) != owner.registration_digest or
            r.next_i64() != owner.registration_epoch or r.decode_text(r.next()) != owner.selection_digest or
            r.decode_text(r.next()) != owner.semantic_policy_key:
        return Err("post-HIR policy parent pins differ")
    val cycle_mode = r.decode_text(r.next())
    val quiet_mode = r.decode_text(r.next())
    val implicit_error = driver_hir_policy_bool_v1(r)
    var layer: [LayerEqContractClaimV1] = []
    val layer_count = r.next_len()
    var index = 0
    while index < layer_count:
        val key = r.decode_text(r.next())
        val path = r.decode_text(r.next())
        val view = r.decode_text(r.next())
        val target = r.decode_text(r.next())
        var renames: [text] = []
        val count = r.next_len()
        var ri = 0
        while ri < count:
            renames.push(r.decode_text(r.next()))
            ri = ri + 1
        layer.push(LayerEqContractClaimV1(key, path, view, target, renames))
        index = index + 1
    var effects: [EffectContractClaimV1] = []
    val effect_count = r.next_len()
    index = 0
    while index < effect_count:
        effects.push(EffectContractClaimV1(r.decode_text(r.next()), r.decode_text(r.next()),
            r.decode_text(r.next()), r.next_i64(), driver_hir_policy_bool_v1(r)))
        index = index + 1
    var rt: [RtCriticalContractClaimV1] = []
    val rt_count = r.next_len()
    index = 0
    while index < rt_count:
        rt.push(RtCriticalContractClaimV1(r.decode_text(r.next()), r.decode_text(r.next()), r.decode_text(r.next()),
            r.decode_text(r.next()), r.decode_text(r.next()), r.decode_text(r.next()), driver_hir_policy_bool_v1(r)))
        index = index + 1
    var aspects: [AspectContractClaimV1] = []
    val aspect_count = r.next_len()
    index = 0
    while index < aspect_count:
        aspects.push(AspectContractClaimV1(r.decode_text(r.next()), r.decode_text(r.next()), r.decode_text(r.next()),
            r.decode_text(r.next()), r.decode_text(r.next()), r.decode_text(r.next()), driver_hir_policy_bool_v1(r),
            driver_hir_policy_bool_v1(r), driver_hir_policy_bool_v1(r)))
        index = index + 1
    var capabilities: [RtBoundCapability] = []
    val capability_count = r.next_len()
    index = 0
    while index < capability_count:
        capabilities.push(RtBoundCapability(r.decode_text(r.next()), r.decode_text(r.next()),
            r.next_i64(), r.next_i64(), r.decode_text(r.next())))
        index = index + 1
    val policy = DriverHirPostValidationPolicyLoadV1(layer, effects, rt, aspects, capabilities,
        cycle_mode, quiet_mode, implicit_error)
    if not r.finish_canonical_frame() or driver_hir_policy_frame_v1(owner, policy) != frame:
        return Err("post-HIR complete policy framing refused")
    Ok(policy)

fn driver_hir_policy_capture_in_owned_scope_v1(ctx: CompileContext, schedule: DriverHirArchiveScheduleV1,
        journal: DriverHirArchiveJournalV1, cache: HirOwnedArtifactContextV1
) -> Result<DriverHirPostValidationPolicyOwnerV1, text>:
    if schedule.shard_mode or journal.logical_order != schedule.logical_publication_order or
            journal.events.len() != schedule.visit_order.len() or journal.last_key.len() != 64 or
            journal.registration_digest.len() != 64 or cache.producer_header != journal.selection.producer_header:
        return Err("post-HIR policy lacks actual complete publication schedule")
    var index = 0
    while index < schedule.visit_order.len():
        val event = journal.events[index]
        val source = schedule.visit_order[index]
        if event.source_index != source or event.logical_name != schedule.logical_publication_order[index] or
                event.alias != (schedule.first_source_for_visit[index] != source) or
                event.archive.input.closure_digest != schedule.closure_digest or
                event.archive.input.provider_selection_digest != journal.selection.selection_digest or
                event.archive.input.producer_header != cache.producer_header:
            return Err("post-HIR policy actual publisher order differs from streaming owner")
        index = index + 1
    val semantic = hir_body_semantic_policy_v1(ctx.assurance_policy.strictness)
    val policy = DriverHirPostValidationPolicyLoadV1(layer_eq_contract_claims_v1(), effect_contract_claims_v1(),
        rt_critical_contract_claims_v1(), aspect_contract_claims_v1(), rt_bound_manifest_capabilities(),
        env_get("SIMPLE_VALUE_STRUCT_LAYOUT_CYCLE"), env_get("SIMPLE_RESOLVE_METHODS"), rt_implicit_profile_is_error())
    var owner = DriverHirPostValidationPolicyOwnerV1(cache, "", "", schedule.source_binding,
        schedule.schedule_digest, journal.last_key, journal.registration_digest, journal.registration_epoch,
        journal.selection.selection_digest, semantic.key)
    val frame = driver_hir_policy_frame_v1(owner, policy)
    if frame == "": return Err("post-HIR actual policy encoding refused")
    owner.artifact_digest = sha256_text(frame)
    owner.artifact_key = driver_hir_policy_key_v1(owner, frame)
    val stored = hir_owned_artifact_store_blob_v1(cache, owner.artifact_key, frame)?
    if not stored: return Err("post-HIR actual policy storage did not publish")
    Ok(owner)

pub fn driver_hir_post_validation_policy_capture_v1(ctx: CompileContext,
        schedule: DriverHirArchiveScheduleV1, journal: DriverHirArchiveJournalV1
) -> Result<DriverHirPostValidationPolicyOwnerV1, text>:
    if transient_array_scope_state_v1() != 0 or ctx.error_count_value > 0 or ctx.poisoned_module_count_value > 0:
        return Err("post-HIR actual policy capture scope or frontend unavailable")
    val verified = driver_hir_archive_journal_verify_v1(journal, ctx)?
    val cache = hir_owned_artifact_context_v1()
    if not cache.enabled or not transient_scope_begin(): return Err("post-HIR policy capture owner unavailable")
    val result = driver_hir_policy_capture_in_owned_scope_v1(ctx, schedule, journal, cache)
    val paused = transient_scope_pause()
    val owned = if paused: transient_promote(result) else: false
    val ended = transient_scope_end()
    if not paused or not owned or not ended: panic("post-HIR policy capture ownership failed")
    result

export DriverHirPostValidationPolicyOwnerV1, DriverHirPostValidationPolicyLoadV1
export driver_hir_post_validation_policy_capture_v1, driver_hir_post_validation_policy_load_in_owned_scope_v1
export driver_hir_policy_source_claims_match_in_owned_scope_v1
export driver_hir_policy_live_capabilities_match_in_owned_scope_v1
