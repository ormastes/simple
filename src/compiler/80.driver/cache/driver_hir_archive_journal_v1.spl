# Ordered publication journal, not semantic or final-stage admission. The
# production loop remains retained until every body consumer is admitted.
# Events record the actual publisher's invocation order, not a guessed phase-1
# prefix. Production admission still needs the genuine surface/topological and
# alias insertion schedule. Mutable event/key lists plus immutable byte storage
# alone do not authenticate that schedule or grant semantic/final authority.
use compiler.driver.driver_types.{CompileContext}
use compiler.driver.driver_source_loading.{_driver_physical_source_key}
use compiler.driver.cache.driver_hir_managed_runtime_selection_v1.{DriverHirManagedRuntimeSelectionV1,
    driver_hir_capture_managed_runtime_selection_v1}
use compiler.driver.cache.hir_body_typecheck_lease_v1.{HirBodyArchiveV1}
use compiler.driver.cache.driver_hir_archive_inventory_v1.{DriverHirArchiveInventoryV1,
    driver_hir_archive_inventory_from_context_v1}
use compiler.driver.cache.hir_owned_artifact_cache_v1.{hir_owned_artifact_context_v1}
use compiler.common.cache_contract.hir_owned_artifact_cache_v1.{HirOwnedArtifactContextV1,
    hir_owned_artifact_store_blob_v1, hir_owned_artifact_load_blob_v1}
use compiler.mono.mono_archive_registration_v1.{MonoArchiveRegistrationOwnerV1,
    MonoArchiveRegistrationReceiptV1, mono_archive_registration_create_v1,
    mono_archive_registration_owner_digest_v1, mono_archive_publish_registration_v1}
use compiler.hir.hir_codec_support.{HirCodecWriter}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause,
    transient_scope_end, transient_promote}

struct DriverHirArchivePublicationEventV1:
    logical_name: text
    source_index: i64
    archive: HirBodyArchiveV1
    registration_before: text
    registration_after: text
    epoch_before: i64
    epoch_after: i64
    alias: bool
    previous_key: text
    key: text

struct DriverHirArchiveJournalStoredEventV1:
    event: DriverHirArchivePublicationEventV1
    reason: text

class DriverHirArchiveJournalV1:
    registration: MonoArchiveRegistrationOwnerV1
    selection: DriverHirManagedRuntimeSelectionV1
    source_binding: text
    artifacts: HirOwnedArtifactContextV1
    events: [DriverHirArchivePublicationEventV1]
    logical_archives: Dict<text, HirBodyArchiveV1>
    logical_order: [text]
    registration_digest: text
    initial_registration_digest: text
    registration_epoch: i64
    last_key: text
    failed_reason: text
    failed_event_key: text
    failed_event: DriverHirArchivePublicationEventV1? = nil

fn driver_hir_archive_journal_sources_v1(ctx: CompileContext) -> text:
    val count = ctx.source_module_names_owner.len()
    if count == 0 or ctx.source_paths_owner.len() != count or
            ctx.source_identities_owner.len() != count or ctx.source_authored_paths_owner.len() != count or
            ctx.source_byte_lengths_owner.len() != count: return ""
    var writer = HirCodecWriter.create()
    writer.put_i64(count)
    var seen: Dict<text, bool> = {}
    var index = 0
    while index < count:
        val name = ctx.source_module_names_owner[index]
        val path = _driver_physical_source_key(ctx.source_paths_owner[index])
        if name == "" or seen.has(name) or path == "" or ctx.source_identities_owner[index].len() != 64 or
                ctx.source_authored_paths_owner[index] == "" or ctx.source_byte_lengths_owner[index] < 0: return ""
        seen[name] = true
        writer.put_text(name)
        writer.put_text(path)
        writer.put_text(ctx.source_identities_owner[index])
        writer.put_text(ctx.source_authored_paths_owner[index])
        writer.put_i64(ctx.source_byte_lengths_owner[index])
        index = index + 1
    sha256_text("driver-hir-journal-sources-v1\n" + writer.finish())

fn driver_hir_archive_journal_event_bytes_v1(owner: DriverHirArchiveJournalV1,
        event: DriverHirArchivePublicationEventV1) -> text:
    var writer = HirCodecWriter.create()
    writer.put_text(owner.source_binding)
    writer.put_text(owner.selection.selection_digest)
    writer.put_text(event.logical_name)
    writer.put_i64(event.source_index)
    writer.put_text(event.archive.archive_key)
    writer.put_text(event.archive.source_key)
    writer.put_text(event.archive.body_digest)
    writer.put_text(event.archive.lowering_warnings_digest)
    writer.put_text(event.archive.input.module_name)
    writer.put_text(event.archive.input.stage)
    writer.put_text(event.archive.input.source_path)
    writer.put_text(event.archive.input.source_authored_path)
    writer.put_text(event.archive.input.source_content_digest)
    writer.put_text(event.archive.input.closure_digest)
    writer.put_bool(event.archive.input.is_entry)
    writer.put_text(event.archive.input.producer_header)
    writer.put_text(event.archive.input.provider_selection_digest)
    writer.put_text(event.archive.input.runtime_provider_receipt_path)
    writer.put_text(event.archive.input.runtime_provider_digest)
    writer.put_text(event.registration_before)
    writer.put_text(event.registration_after)
    writer.put_i64(event.epoch_before)
    writer.put_i64(event.epoch_after)
    writer.put_bool(event.alias)
    writer.put_text(event.previous_key)
    "driver-hir-publication-event-v1\n" + writer.finish()

fn driver_hir_archive_journal_same_archive_v1(a: HirBodyArchiveV1, b: HirBodyArchiveV1) -> bool:
    a.archive_key == b.archive_key and a.source_key == b.source_key and a.body_digest == b.body_digest and
        a.lowering_warnings_digest == b.lowering_warnings_digest and
        a.input.module_name == b.input.module_name and a.input.stage == b.input.stage and
        a.input.source_path == b.input.source_path and a.input.source_authored_path == b.input.source_authored_path and
        a.input.source_content_digest == b.input.source_content_digest and a.input.closure_digest == b.input.closure_digest and
        a.input.is_entry == b.input.is_entry and a.input.producer_header == b.input.producer_header and
        a.input.provider_selection_digest == b.input.provider_selection_digest and
        a.input.runtime_provider_receipt_path == b.input.runtime_provider_receipt_path and
        a.input.runtime_provider_digest == b.input.runtime_provider_digest

# Concrete immutable byte owner. A caller cannot supply a store callback or an
# acceptance boolean. Only the result (including dynamic refusal text) escapes.
fn driver_hir_archive_journal_bytes_v1(owner: DriverHirArchiveJournalV1,
        event: DriverHirArchivePublicationEventV1, write: bool) -> Result<bool, text>:
    if transient_array_scope_state_v1() != 1: return Err("HIR journal borrowed byte lease unavailable")
    val bytes = driver_hir_archive_journal_event_bytes_v1(owner, event)
    var result: Result<bool, text> = Err("HIR journal event key refused")
    if event.key == sha256_text(bytes):
        if write:
            result = hir_owned_artifact_store_blob_v1(owner.artifacts, event.key, bytes)
        else:
            val loaded = hir_owned_artifact_load_blob_v1(owner.artifacts, event.key)
            result = if loaded.is_err(): Err(loaded.unwrap_err()) else:
                if loaded.unwrap() == bytes: Ok(true) else: Err("HIR journal event bytes differ")
    result

fn driver_hir_archive_journal_initial_metadata_v1(ctx: CompileContext,
        registration: MonoArchiveRegistrationOwnerV1) -> Result<(text, text), text>:
    if transient_array_scope_state_v1() != 0 or not transient_scope_begin():
        return Err("HIR journal metadata lease unavailable")
    val binding = driver_hir_archive_journal_sources_v1(ctx)
    val digest = mono_archive_registration_owner_digest_v1(registration)
    val result: Result<(text, text), text> = if binding == "" or digest == "":
        Err("HIR journal retained source or registration predecessor incomplete")
    else:
        Ok((binding, digest))
    val paused = transient_scope_pause()
    val owned = if paused: transient_promote(result) else: false
    val ended = transient_scope_end()
    if not paused or not owned or not ended: panic("HIR journal metadata ownership failed")
    result

fn driver_hir_archive_journal_row_v1(owner: DriverHirArchiveJournalV1, ctx: CompileContext,
        source_index: i64, logical_name: text, archive: HirBodyArchiveV1) -> bool:
    if source_index < 0 or source_index >= ctx.source_module_names_owner.len(): return false
    val input = archive.input
    logical_name == ctx.source_module_names_owner[source_index] and
        _driver_physical_source_key(input.source_path) == _driver_physical_source_key(ctx.source_paths_owner[source_index]) and
        input.source_content_digest == ctx.source_identities_owner[source_index] and
        input.source_authored_path == ctx.source_authored_paths_owner[source_index] and
        input.provider_selection_digest == owner.selection.selection_digest and
        input.runtime_provider_receipt_path == owner.selection.provider.snapshot.path and
        input.runtime_provider_digest == owner.selection.provider.snapshot.digest and
        input.producer_header == owner.selection.producer_header and input.stage == "lowered-unresolved-v1"

# An alias keeps its own phase-1 authored spelling. Its complete canonical
# archive must already have been published by a genuine non-alias transaction.
fn driver_hir_archive_journal_alias_row_in_owned_scope_v1(owner: DriverHirArchiveJournalV1,
        ctx: CompileContext, source_index: i64, logical_name: text, archive: HirBodyArchiveV1,
        prior_events: i64) -> bool:
    if transient_array_scope_state_v1() != 1 or source_index < 0 or
            source_index >= ctx.source_module_names_owner.len() or
            logical_name != ctx.source_module_names_owner[source_index] or
            ctx.source_authored_paths_owner[source_index] == "": return false
    var index = 0
    while index < prior_events:
        val canonical = owner.events[index]
        if not canonical.alias and driver_hir_archive_journal_same_archive_v1(canonical.archive, archive) and
                driver_hir_archive_journal_row_v1(owner, ctx, canonical.source_index, canonical.logical_name, archive):
            val source = canonical.source_index
            return _driver_physical_source_key(ctx.source_paths_owner[source]) ==
                    _driver_physical_source_key(ctx.source_paths_owner[source_index]) and
                ctx.source_identities_owner[source] == ctx.source_identities_owner[source_index] and
                ctx.source_byte_lengths_owner[source] == ctx.source_byte_lengths_owner[source_index]
        index = index + 1
    false

fn driver_hir_archive_journal_alias_row_v1(owner: DriverHirArchiveJournalV1,
        ctx: CompileContext, source_index: i64, logical_name: text, archive: HirBodyArchiveV1) -> bool:
    if transient_array_scope_state_v1() != 0 or not transient_scope_begin(): return false
    val result = driver_hir_archive_journal_alias_row_in_owned_scope_v1(owner, ctx,
        source_index, logical_name, archive, owner.events.len())
    val paused = transient_scope_pause()
    val ended = transient_scope_end()
    if not paused or not ended: panic("HIR journal alias proof ownership failed")
    result

pub fn driver_hir_archive_journal_create_v1(ctx: CompileContext,
        selection: DriverHirManagedRuntimeSelectionV1) -> Result<DriverHirArchiveJournalV1, text>:
    if transient_array_scope_state_v1() != 0: return Err("HIR journal creation lease occupied")
    val actual = driver_hir_capture_managed_runtime_selection_v1(selection.backend, selection.target, selection.runtime_bundle)?
    # `selection` crosses the complete phase-2 surface build before journal
    # creation. Its nested provider aggregate is not an authority here: the
    # route is recaptured and fully revalidated above, and only that `actual`
    # value is retained by the journal. Bind the transported scalar receipt to
    # the recapture instead of re-traversing a stale nested aggregate.
    if selection.selection_digest != actual.selection_digest:
        return Err("HIR journal selected managed authority digest differs")
    if selection.producer_header != actual.producer_header:
        return Err("HIR journal selected managed authority header differs")
    val artifacts = hir_owned_artifact_context_v1()
    if not artifacts.enabled or artifacts.producer_header != actual.producer_header:
        return Err("HIR journal immutable cache owner unavailable")
    val registration = mono_archive_registration_create_v1()?
    val metadata = driver_hir_archive_journal_initial_metadata_v1(ctx, registration)?
    val binding = metadata.0
    val digest = metadata.1
    Ok(DriverHirArchiveJournalV1(registration: registration, selection: actual,
        source_binding: binding, artifacts: artifacts, events: [], logical_archives: {}, logical_order: [],
        registration_digest: digest, initial_registration_digest: digest,
        registration_epoch: 0, last_key: "", failed_reason: "", failed_event_key: ""))

pub fn driver_hir_archive_journal_verify_v1(owner: DriverHirArchiveJournalV1,
        ctx: CompileContext) -> Result<bool, text>:
    if transient_array_scope_state_v1() != 0: return Err("HIR journal verification lease occupied")
    if not transient_scope_begin(): return Err("HIR journal verification lease unavailable")
    val result = driver_hir_archive_journal_verify_in_owned_scope_v1(owner, ctx)
    val paused = transient_scope_pause()
    val owned = if paused: transient_promote(result) else: false
    val ended = transient_scope_end()
    if not paused or not owned or not ended: panic("HIR journal verification ownership failed")
    result

fn driver_hir_archive_journal_verify_in_owned_scope_v1(owner: DriverHirArchiveJournalV1,
        ctx: CompileContext) -> Result<bool, text>:
    if owner.failed_reason != "" or owner.failed_event_key != "": return Err("HIR journal poisoned: " + owner.failed_reason)
    if owner.source_binding == "" or owner.source_binding != driver_hir_archive_journal_sources_v1(ctx) or
            owner.registration.sealed or owner.registration.epoch != owner.registration_epoch or
            owner.registration_digest == "" or owner.registration_digest != mono_archive_registration_owner_digest_v1(owner.registration):
        return Err("HIR journal source or registration predecessor changed")
    var previous = ""
    var epoch = 0
    var digest = owner.initial_registration_digest
    if digest == "": return Err("HIR journal initial registration identity absent")
    var names: [text] = []
    var canonical: [text] = []
    var event_index = 0
    for event in owner.events:
        val row_valid = if event.alias:
            driver_hir_archive_journal_alias_row_in_owned_scope_v1(owner, ctx, event.source_index,
                event.logical_name, event.archive, event_index)
        else: driver_hir_archive_journal_row_v1(owner, ctx, event.source_index, event.logical_name, event.archive)
        if event.previous_key != previous or event.epoch_before != epoch or
                event.registration_before != digest or
                not row_valid:
            return Err("HIR journal event order or source binding changed")
        val name = event.archive.input.module_name
        if not owner.registration.archives.has(name) or
                not driver_hir_archive_journal_same_archive_v1(owner.registration.archives[name], event.archive):
            return Err("HIR journal event lacks exact registered archive")
        if event.alias:
            if not canonical.contains(name) or event.epoch_after != epoch or event.registration_after != event.registration_before:
                return Err("HIR journal alias predecessor differs")
        else:
            if canonical.contains(name) or event.epoch_after != epoch + 1: return Err("HIR journal declaration order differs")
            canonical.push(name)
        if not names.contains(event.logical_name): names.push(event.logical_name)
        if not owner.logical_archives.has(event.logical_name) or
                not driver_hir_archive_journal_same_archive_v1(owner.logical_archives[event.logical_name], event.archive):
            return Err("HIR journal logical publication differs")
        val _stored = driver_hir_archive_journal_bytes_v1(owner, event, false)?
        previous = event.key
        epoch = event.epoch_after
        digest = event.registration_after
        event_index = event_index + 1
    if previous != owner.last_key or epoch != owner.registration_epoch or names != owner.logical_order or
            names.len() != owner.logical_archives.len() or canonical.len() != owner.registration.roots.len() or
            digest != owner.registration_digest: return Err("HIR journal publication summary differs")
    var index = 0
    for name in canonical:
        if owner.registration.roots[index].module_name != name: return Err("HIR journal canonical registration schedule differs")
        index = index + 1
    Ok(true)

fn driver_hir_archive_journal_store_event_v1(owner: DriverHirArchiveJournalV1,
        logical_name: text, source_index: i64, archive: HirBodyArchiveV1,
        before: text, epoch_before: i64, alias: bool) -> DriverHirArchiveJournalStoredEventV1:
    if transient_array_scope_state_v1() != 0 or not transient_scope_begin():
        # This separate fallback contains only already-retained inputs/scalars.
        # Never put new scratch hash children into this older carrier.
        val pending = DriverHirArchivePublicationEventV1(logical_name: logical_name, source_index: source_index,
            archive: archive, registration_before: before, registration_after: "",
            epoch_before: epoch_before, epoch_after: owner.registration.epoch, alias: alias,
            previous_key: owner.last_key, key: "")
        return DriverHirArchiveJournalStoredEventV1(event: pending,
            reason: "HIR journal event lease unavailable after publication")
    # The successful carrier belongs to this active scope, so promotion walks
    # its newly encoded fingerprint/key children rather than skipping an older
    # aggregate that acquired scratch references after it was allocated.
    var event = DriverHirArchivePublicationEventV1(logical_name: logical_name, source_index: source_index,
        archive: archive, registration_before: before, registration_after: "",
        epoch_before: epoch_before, epoch_after: owner.registration.epoch, alias: alias,
        previous_key: owner.last_key, key: "")
    event.registration_after = mono_archive_registration_owner_digest_v1(owner.registration)
    event.key = sha256_text(driver_hir_archive_journal_event_bytes_v1(owner, event))
    val stored = driver_hir_archive_journal_bytes_v1(owner, event, true)
    val result = DriverHirArchiveJournalStoredEventV1(event: event,
        reason: if stored.is_err(): stored.unwrap_err() else: "")
    val paused = transient_scope_pause()
    val owned = if paused: transient_promote(result) else: false
    val ended = transient_scope_end()
    if not paused or not owned or not ended: panic("HIR journal event ownership failed")
    result

fn driver_hir_archive_journal_append_v1(owner: DriverHirArchiveJournalV1,
        stored: DriverHirArchiveJournalStoredEventV1) -> Result<bool, text>:
    val event = stored.event
    if stored.reason != "":
        # Registration already happened. Do not rewind its collision effects.
        # Keeping the old journal fingerprint also refuses a cleared poison.
        owner.failed_reason = stored.reason
        owner.failed_event_key = event.key
        owner.failed_event = Some(event)
        # Close the shared declaration publisher as well. This is a refusal,
        # not successful registration admission: no sealed schedule is minted.
        # It covers alias-event failure even when the epoch did not advance.
        owner.registration.sealed = true
        return Err("HIR journal poisoned after publication: " + owner.failed_reason)
    owner.events = owner.events.push(event)
    if not owner.logical_archives.has(event.logical_name): owner.logical_order = owner.logical_order.push(event.logical_name)
    owner.logical_archives[event.logical_name] = event.archive
    owner.registration_digest = event.registration_after
    owner.registration_epoch = event.epoch_after
    owner.last_key = event.key
    Ok(true)

pub fn driver_hir_archive_journal_publish_v1(owner: DriverHirArchiveJournalV1,
        ctx: CompileContext, source_index: i64, logical_name: text,
        receipt: MonoArchiveRegistrationReceiptV1) -> Result<bool, text>:
    val _verified = driver_hir_archive_journal_verify_v1(owner, ctx)?
    if not driver_hir_archive_journal_row_v1(owner, ctx, source_index, logical_name, receipt.archive):
        return Err("HIR journal transaction source binding refused")
    val before = owner.registration_digest
    val epoch = owner.registration_epoch
    # Actual publisher re-decodes full HIR and re-runs the ordered declaration
    # collector; no caller accepted flag can append an event.
    val _published = mono_archive_publish_registration_v1(owner.registration, receipt)?
    val stored = driver_hir_archive_journal_store_event_v1(owner, logical_name, source_index,
        receipt.archive, before, epoch, false)
    driver_hir_archive_journal_append_v1(owner, stored)

pub fn driver_hir_archive_journal_alias_v1(owner: DriverHirArchiveJournalV1,
        ctx: CompileContext, source_index: i64, logical_name: text,
        canonical_name: text) -> Result<bool, text>:
    val _verified = driver_hir_archive_journal_verify_v1(owner, ctx)?
    # The source label and the complete HIR's physical module name are
    # different identities. Select the caller's actual published logical row,
    # then prove it was a canonical transaction, rather than guessing a key in
    # the physical registration map or admitting an alias as a new parent.
    if not owner.logical_archives.has(canonical_name): return Err("HIR journal alias canonical owner absent")
    val archive = owner.logical_archives[canonical_name]
    var canonical_published = false
    for event in owner.events:
        if not event.alias and event.logical_name == canonical_name and
                driver_hir_archive_journal_same_archive_v1(event.archive, archive):
            canonical_published = true
    if not canonical_published: return Err("HIR journal alias canonical transaction absent")
    if not driver_hir_archive_journal_alias_row_v1(owner, ctx, source_index, logical_name, archive):
        return Err("HIR journal alias source binding refused")
    val stored = driver_hir_archive_journal_store_event_v1(owner, logical_name, source_index,
        archive, owner.registration_digest, owner.registration_epoch, true)
    driver_hir_archive_journal_append_v1(owner, stored)

pub fn driver_hir_archive_journal_inventory_v1(owner: DriverHirArchiveJournalV1,
        ctx: CompileContext) -> Result<DriverHirArchiveInventoryV1, text>:
    val _verified = driver_hir_archive_journal_verify_v1(owner, ctx)?
    driver_hir_archive_inventory_from_context_v1(ctx, owner.logical_archives)

export DriverHirArchivePublicationEventV1, DriverHirArchiveJournalV1
export driver_hir_archive_journal_create_v1, driver_hir_archive_journal_verify_v1
export driver_hir_archive_journal_publish_v1, driver_hir_archive_journal_alias_v1
export driver_hir_archive_journal_inventory_v1
