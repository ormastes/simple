# Per-module artifact producer: ONE parse of a source file yields both
#   (1) the full binary AST cache entry -- the frontend's flat-pool blob, which
#       parse_full_frontend stores into the private parse cache and, when
#       SIMPLE_SHARED_PARSE_CAS_ROOT is configured, the cross-process shared
#       parse CAS (frontend.spl frontend_parse_or_restore ->
#       frontend_shared_parse_store_v1, temp + no-replace publish); and
#   (2) the module's TLDR companion (`<root>/<logical path>.tldr`, version 4):
#       a NON-AUTHORITATIVE VIEW of the frontend PublicSummaryV1
#       (cache_artifact/public_summary_projector.spl). The producer's parsed
#       module becomes FrozenPublicFactV1 facts (module_public_summary_facts_v1),
#       the projector validates and renders them into one `summary` section,
#       and generic / inline bodies -- which a summary never carries -- follow
#       as `generic` / `inline` sections, then `sif:` and the SIF text. The one
#       freshness authority is the embedded, algorithm-tagged source digest; the companion is
#       compiler-written and never importable as source.
#
# This is the single producer contract shared by `simple tldr`
# (src/app/cli/tldr_entry.spl) and the test runner's refresh step, which
# invokes that same CLI. Per incremental_build_tldr_scv_implementation
# (Option "keep canonical .tld; adapt private .tldr companions through an
# explicit versioned producer/reader"), the companion is versioned and does
# not replace the canonical package `.tld` / PackageTldrHeaderV1.
#
# Freshness is the source CONTENT digest, never mtime. Publication is
# temp-file-in-the-same-directory + rename-over (MoveFileExW
# REPLACE_EXISTING on Windows, rename(2) elsewhere): readers always see a
# complete old or complete new file, and racing producers of the same source
# write identical bytes, so the last rename winning is harmless.
#
# Known gaps (named, not filled): facts carry no cross-symbol dependency
# edges; a declaration whose expansion has no source line of its own is not
# carried; no HIR consumer reads the companion yet (the per-file scheduler PR).
use std.nogc_sync_mut.io.disk_admission.{disk_publish_admitted}
use std.common.crypto.sha256.{sha256_text}
use compiler.common.cache_contract.hash_algorithm_registry_v1.{digest_v1_parse, digest_v1_text,
    digest_v1_equal, HASH_ALGO_SHA256_V1}
use compiler.driver.cache.hash_digest_v1.{digest_v1_of_text}
use compiler.driver.cache.module_surface_skeleton_v1.{module_surface_skeleton_v1}
use compiler.hir.hir_lowering.module_surface_canonical_digest_v1.{module_surface_canonical_digest_v1}
use std.io_runtime.{file_exists, file_read, file_write, file_rename, file_delete, getpid}
use std.nogc_sync_mut.io_runtime.{dir_create_all}
use compiler.common.config.{Logger}
use compiler.frontend.cache_artifact.macro_source_from_parse_v1.{macro_module_source_from_parse_guarded_v1}
use compiler.frontend.cache_artifact.macro_reference_projector.{project_macro_module_guarded_v1,
    MacroModuleProjectionV1, MacroDefKeyEntryV1}
use compiler.frontend.core.interpreter.module_loader_resolve.{resolve_module_path}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.driver.sif.sif.{sif_of_source, sif_validate}
use compiler.driver.cache.module_tldr_sections_v1.{module_tldr_sections_of_source_v1,
    module_tldr_sections_render_v1, module_tldr_sections_parse_v1}
use compiler.driver.cache.module_tldr_ast_sections_v1.{module_tldr_sections_of_module_v1}
use compiler.driver.cache.module_public_summary_facts_v1.{module_public_facts_of_module_v1,
    module_public_macro_facts_v1, module_generic_template_decls_of_module_v1}
use compiler.common.cache_contract.macro_reference_manifest_v1.{MacroDefinitionTableV1,
    MacroUseTableV1, macro_definition_table_encode_v1, macro_use_table_encode_v1,
    macro_reference_schema_v1, MacroUseV1, macro_definition_table_decode_v1,
    macro_use_status_tag_v1, macro_content_digest_v1}
use compiler.frontend.cache_artifact.generic_tldr_projector.{project_generic_template_v1}
use compiler.common.cache_contract.generic_tldr_view_v1.{GenericTemplateEntryV1,
    build_generic_template_section_v1, generic_template_section_encode_v1}
use compiler.driver.cache.generic_specialization_list_v1.{GenericSpecializationListV1,
    GenericSpecContextV1, GENERIC_SPEC_HOST_PROFILE_DIGEST_V1,
    generic_specializations_of_mono_v1, generic_specializations_text_fallback_v1,
    generic_templates_of_sections_v1,
    generic_specialization_section_encode_v1}
use compiler.common.cache_contract.guard_id_v1.{ActiveGuardRootV1, active_guard_root_v1}
use compiler.frontend.parser_types.{ParserModule, ParserImport, ImportItem}
use compiler.frontend.core.flat_pool_codec.{FLAT_POOL_CODEC_VERSION}
use compiler.frontend.cache_artifact.public_summary_projector.{FrozenPublicFactV1,
    PublicSummaryProjectionInputV1, project_public_summary_v1, render_public_summary_tldr_v1}
use compiler.common.cache_contract.snapshot_contract_v1.{LogicalSourcePathV1, PathSemanticsV1}
use std.nogc_sync_mut.sffi.runtime.{xxh3_128_text}

pub val MODULE_TLDR_COMPANION_HEADER_V1: text = "simple-tldr-companion: 7"
val MODULE_TLDR_LANG_V1: text = "1"


# "src/lib/common/text.spl" -> "src.lib.common.text"
pub fn module_artifact_module_id_v1(logical_path: text) -> text:
    var rel = logical_path.replace("\\", "/")
    while rel.starts_with("./"):
        rel = rel.substring(2)
    if rel.ends_with(".spl"):
        rel = rel.substring(0, rel.len() - 4)
    rel.replace("/", ".")

pub fn module_tldr_companion_path_v1(root: text, logical_path: text) -> text:
    var rel = logical_path.replace("\\", "/")
    while rel.starts_with("./"):
        rel = rel.substring(2)
    if rel.ends_with(".spl"):
        rel = rel.substring(0, rel.len() - 4)
    root + "/" + rel + ".tldr"

pub fn module_tldr_companion_render_v1(module_id: text, source: text) -> text:
    module_tldr_companion_render_sections_v1(module_id, source,
        module_tldr_sections_of_source_v1(source))

# Producer digest of the source bytes: algorithm-tagged (`sha256:<hex>`), so a
# reader on a host with another algorithm sees an unknown tag as a miss.
fn _module_source_digest_text_v1(source: text) -> text:
    match digest_v1_of_text(HASH_ALGO_SHA256_V1, source):
        case Some(d): digest_v1_text(d)
        case nil: ""

# The recorded digest matches `source` only for a known algorithm whose
# recomputed digest is byte-equal; an unknown or malformed tag is absent.
fn _module_source_digest_matches_v1(recorded: text, source: text) -> bool:
    match digest_v1_parse(recorded):
        case Some(d):
            match digest_v1_of_text(d.algo_id, source):
                case Some(actual): digest_v1_equal(d, actual)
                case nil: false
        case nil: false

# Producer path: `sections` come from the parsed module (AST-anchored).
pub fn module_tldr_companion_render_sections_v1(module_id: text, source: text, sections: [text]) -> text:
    MODULE_TLDR_COMPANION_HEADER_V1 + "\n" +
        "source-digest: " + _module_source_digest_text_v1(source) + "\n" +
        module_tldr_sections_render_v1(sections) +
        "sif:\n" + sif_of_source(module_id, MODULE_TLDR_LANG_V1, [], source)

# (sections, sif) of a valid companion for `source`; sif is "" when invalid.
fn _module_tldr_companion_split_v1(content: text, source: text) -> ([text], text):
    val prefix = MODULE_TLDR_COMPANION_HEADER_V1 + "\nsource-digest: "
    if not content.starts_with(prefix):
        return ([], "")
    val after = content.substring(prefix.len())
    val line_end = after.index_of("\n")
    if line_end < 0 or not _module_source_digest_matches_v1(after.substring(0, line_end), source):
        return ([], "")
    val rest = after.substring(line_end + 1)
    val (sections, consumed) = module_tldr_sections_parse_v1(rest)
    if consumed < 0:
        return ([], "")
    val tail = rest.substring(consumed)
    if not tail.starts_with("sif:\n"):
        return ([], "")
    val body = tail.substring(5)
    if sif_validate(body) != "":
        return ([], "")
    (sections, body)

# Returns the SIF body when `content` is a valid companion for `source`, else "".
pub fn module_tldr_companion_body_v1(content: text, source: text) -> text:
    val (_sections, body) = _module_tldr_companion_split_v1(content, source)
    body

# "<kind>|<text>" sections of a valid companion (empty when invalid).
pub fn module_tldr_companion_sections_v1(content: text, source: text) -> [text]:
    val (sections, body) = _module_tldr_companion_split_v1(content, source)
    if body == "": [] else: sections

pub fn module_tldr_companion_fresh_v1(path: text, source: text) -> bool:
    if not file_exists(path):
        return false
    module_tldr_companion_body_v1(file_read(path), source) != ""

# PublicSummaryV1 identity for a locally produced companion. The summary is a
# VIEW: its only freshness authority is the embedded source digest.
fn _module_summary_input_v1(module_id: text, source_path: text, source: text,
        facts: [FrozenPublicFactV1]) -> PublicSummaryProjectionInputV1:
    val source_digest = sha256_text(source)
    PublicSummaryProjectionInputV1(
        snapshot_id: sha256_text("simple.tldr.companion.snapshot.v1|" + source_digest),
        logical_path: LogicalSourcePathV1(
            repository_namespace_digest: sha256_text("simple.tldr.companion.local.v1"),
            module_relative_utf8: source_path.replace("\\", "/"),
            path_semantics: PathSemanticsV1.CaseSensitiveNfc),
        source_blob_digest: source_digest,
        compiler_owner_digest: sha256_text("simple.tldr.companion.producer.v1|" + module_id),
        grammar_digest: sha256_text("simple.flat-pool|" + FLAT_POOL_CODEC_VERSION),
        facts: facts)

# "summary|<rendered PublicSummaryV1>", "generic-template|<indexed template
# section>" when the module declares generic structs/classes, plus the
# generic/inline body sections.
# A projection refusal yields no summary section (named in the result).
pub fn module_tldr_companion_view_sections_v1(module: ParserModule, source_path: text,
        source: text, module_id: text) -> ([text], text):
    module_tldr_companion_view_sections_with_macros_v1(module, source_path, source, module_id,
        MacroDefinitionTableV1(schema: macro_reference_schema_v1(), module_id: module_id, entries: []),
        MacroUseTableV1(schema: macro_reference_schema_v1(), module_id: module_id, uses: []), [])


# Macro TLDR sections (plan 2026-10-24 §6.1/§6.3): the module's
# MacroDefinitionTableV1 and its OUTGOING MacroUseTableV1, each sealed by the
# contract codec. Users of a macro are never listed in the defining module's
# sections; the reverse view is the `.rr` projection.
pub fn module_tldr_macro_sections_v1(def_table: MacroDefinitionTableV1,
        use_table: MacroUseTableV1) -> [text]:
    var sections: [text] = []
    if def_table.entries.len() > 0:
        sections.push("macro-def|" + macro_definition_table_encode_v1(def_table))
    if use_table.uses.len() > 0:
        sections.push("macro-use|" + macro_use_table_encode_v1(use_table))
    sections

# View sections plus macro facts: macro MacroSignature facts join the
# PublicSummaryV1 input (so macro-generated public members change the summary
# and a body-only macro edit does not), and the macro sections follow.
# Named gap: ParserModule carries no macro facts yet, so the caller supplies
# the projection (compiler.frontend.cache_artifact.macro_reference_projector).
pub fn module_tldr_companion_view_sections_with_macros_v1(module: ParserModule,
        source_path: text, source: text, module_id: text,
        def_table: MacroDefinitionTableV1, use_table: MacroUseTableV1,
        generated_public_names: [text]) -> ([text], text):
    var sections: [text] = []
    var refusal = ""
    val facts = module_public_facts_of_module_v1(module, source, module_id) +
        module_public_macro_facts_v1(def_table, generated_public_names, module_id)
    val projected = project_public_summary_v1(_module_summary_input_v1(module_id,
        source_path, source, facts))
    match projected:
        case Ok(summary):
            sections.push("summary|" + render_public_summary_tldr_v1(summary))
        case Err(reason):
            refusal = reason
    var templates: [GenericTemplateEntryV1] = []
    for decl in module_generic_template_decls_of_module_v1(module, source, module_id):
        match project_generic_template_v1(decl):
            case Ok(entry):
                templates.push(entry)
            case Err(reason):
                if refusal == "":
                    refusal = "generic template " + decl.name + ": " + reason
    if templates.len() > 0:
        sections.push("generic-template|" +
            generic_template_section_encode_v1(build_generic_template_section_v1(templates)))
    for entry in module_tldr_sections_of_module_v1(module, source):
        if entry.starts_with("generic|") or entry.starts_with("inline|"):
            sections.push(entry)
    for entry in module_tldr_macro_sections_v1(def_table, use_table):
        sections.push(entry)
    # Surface skeleton (codec step 3): a HIR worker parses this instead of the
    # full source; its canonical surface digest equals the full parse.
    sections.push("surface|" + module_surface_skeleton_v1(source))
    sections.push("surface-digest|sha256:" + module_surface_canonical_digest_v1(module))
    (sections, refusal)


# `macro-key` section: one line per definition, `<def id>\t<name>\t<MacroDefKey>\t<0|1 uncacheable>`.
# The def table alone cannot rebuild a MacroDefKey (it folds in the transitive
# nested-read root), so importers read the producer's keys from here.
pub fn module_tldr_macro_key_section_v1(p: MacroModuleProjectionV1) -> text:
    if p.def_keys.len() == 0:
        return ""
    var lines: [text] = []
    for k in p.def_keys:
        val flag = if p.uncacheable_def_ids.contains(k.def_id): "1" else: "0"
        lines.push(k.def_id + "\t" + k.macro_name + "\t" + k.key + "\t" + flag)
    "macro-key|" + lines.join("\n")

# Rebuild an importable projection (definitions + keys only) from a fresh
# companion's sections. ok=false when a macro section is present but does not
# decode -- the caller must then treat the import as unknown.
fn _imported_macro_projection_v1(sections: [text], source_path: text) -> (bool, MacroModuleProjectionV1):
    val module_id = module_artifact_module_id_v1(source_path)
    var table = MacroDefinitionTableV1(schema: macro_reference_schema_v1(), module_id: module_id, entries: [])
    var keys: [MacroDefKeyEntryV1] = []
    var uncacheable: [text] = []
    var ok = true
    for s in sections:
        if s.starts_with("macro-def|"):
            val decoded = macro_definition_table_decode_v1(s.substring(10))
            if decoded.ok: table = decoded.value
            else: ok = false
        if s.starts_with("macro-key|"):
            for line in s.substring(10).split("\n"):
                val f = line.split("\t")
                if f.len() != 4:
                    ok = false
                    continue
                keys.push(MacroDefKeyEntryV1(def_id: f[0], macro_name: f[1], key: f[2]))
                if f[3] == "1": uncacheable.push(f[0])
    if table.entries.len() != keys.len(): ok = false
    (ok, MacroModuleProjectionV1(package: "", module: module_id, source_id: source_path,
        def_table: table, def_keys: keys,
        use_table: MacroUseTableV1(schema: macro_reference_schema_v1(), module_id: module_id, uses: []),
        generated_public_names: [], generated_public_surface_digest: "",
        diagnostics: [], uncacheable_def_ids: uncacheable))

# Macro definitions visible from the imported modules, read from their FRESH
# TLDR companions (never by reparsing them). complete=false when any import's
# companion is missing, stale or undecodable: its macros are then unknown.
pub fn module_tldr_imported_macro_projections_v1(import_source_paths: [text],
        tldr_root: text) -> ([MacroModuleProjectionV1], bool):
    var out: [MacroModuleProjectionV1] = []
    var complete = true
    for path in import_source_paths:
        if not file_exists(path):
            complete = false
            continue
        val companion = module_tldr_companion_path_v1(tldr_root, path)
        if not file_exists(companion):
            complete = false
            continue
        val content = file_read(companion)
        val src = file_read(path)
        if module_tldr_companion_body_v1(content, src) == "":
            complete = false
            continue
        val (ok, p) = _imported_macro_projection_v1(module_tldr_companion_sections_v1(content, src), path)
        if not ok:
            complete = false
            continue
        if p.def_keys.len() > 0: out.push(p)
    (out, complete)

# With an incomplete import set, a negative lookup is not proof of absence:
# every unresolved use becomes conservative (never cacheable).
pub fn macro_projection_mark_imports_incomplete_v1(p: MacroModuleProjectionV1) -> MacroModuleProjectionV1:
    var uses: [MacroUseV1] = []
    for u in p.use_table.uses:
        var v = u
        if macro_use_status_tag_v1(v.status) == "unresolved": v.coverage = "conservative"
        uses.push(v)
    MacroModuleProjectionV1(package: p.package, module: p.module, source_id: p.source_id,
        def_table: p.def_table, def_keys: p.def_keys,
        use_table: MacroUseTableV1(schema: p.use_table.schema, module_id: p.use_table.module_id, uses: uses),
        generated_public_names: p.generated_public_names,
        generated_public_surface_digest: p.generated_public_surface_digest,
        diagnostics: p.diagnostics, uncacheable_def_ids: p.uncacheable_def_ids)

# Source paths of this module's imports that resolve to a file.
fn _module_import_source_paths_v1(parsed: ParserModule, source_path: text) -> [text]:
    var out: [text] = []
    for imp in parsed.imports:
        val path = resolve_module_path(imp.module, source_path)
        if path != "" and not out.contains(path): out.push(path)
    out

# Generic view of the imports, read from their FRESH companions:
# (templates, names imported from generic-bearing modules, unknown,
# generic-bearing import source paths). unknown when an import does not
# resolve, its companion is missing/stale/undecodable, or a generic-bearing
# module is imported by wildcard or alias.
pub fn module_tldr_imported_generic_view_v1(imports: [ParserImport], source_path: text,
        tldr_root: text) -> ([GenericTemplateEntryV1], [text], bool, [text]):
    var templates: [GenericTemplateEntryV1] = []
    var names: [text] = []
    var paths: [text] = []
    var unknown = false
    for imp in imports:
        val path = resolve_module_path(imp.module, source_path)
        val (entries, bearing, ok) = _module_tldr_generic_templates_of_import_v1(path, tldr_root)
        if not ok:
            unknown = true
            continue
        if not bearing:
            continue
        for e in entries: templates.push(e)
        if not paths.contains(path): paths.push(path)
        if imp.items.len() == 0:
            unknown = true
        for item in imp.items:
            if item.name == "*" or item.has_alias:
                unknown = true
            elif not names.contains(item.name):
                names.push(item.name)
    (templates, names, unknown, paths)

# (templates, generic-bearing, ok) of one import's FRESH companion; ok=false
# when the path does not resolve or the companion is missing/stale/undecodable.
fn _module_tldr_generic_templates_of_import_v1(path: text, tldr_root: text) -> ([GenericTemplateEntryV1], bool, bool):
    var none: [GenericTemplateEntryV1] = []
    val companion = if path == "": "" else: module_tldr_companion_path_v1(tldr_root, path)
    if path == "" or not file_exists(path) or not file_exists(companion):
        return (none, false, false)
    val src = file_read(path)
    val content = file_read(companion)
    if module_tldr_companion_body_v1(content, src) == "":
        return (none, false, false)
    val sections = module_tldr_companion_sections_v1(content, src)
    var generic_bearing = false
    for s in sections:
        if s.starts_with("generic-template|") or s.starts_with("generic|"):
            generic_bearing = true
    if not generic_bearing:
        return (none, false, true)
    val (entries, ok) = generic_templates_of_sections_v1(sections)
    (entries, true, ok)

# Concrete generic type uses module-scoped mono observed for one module
# (P-G5), as parallel owner / name / argument-spelling lists. `owners` are TLDR
# module ids (module_artifact_module_id_v1 of the declaring source), "" unknown.
# Imported generic function instances are listed as uses too (P-G6).
pub struct MonoGenericUsesV1:
    owners: [text]
    names: [text]
    args: [[text]]
    complete: bool

# What the post-mono rewrite needs from the emit-time parse, recorded in the
# companion (`generic-spec-ctx` section) so the MIR child never re-parses:
# the module's ActiveGuardRoot, the names it imports from generic-bearing
# modules, whether such an import was unknown, and those imports' source paths
# (their templates are re-read from their own fresh companions).
pub struct GenericSpecInputsV1:
    guard_root: ActiveGuardRootV1
    import_names: [text]
    imports_unknown: bool
    import_paths: [text]

val _GENERIC_SPEC_CTX_MAGIC_V1 = "generic-spec-ctx/v1"

fn _ctx_field_ok_v1(values: [text]) -> bool:
    for v in values:
        if v.contains("\n") or v.contains("\u001f"): return false
    true

fn _ctx_list_v1(s: text) -> [text]:
    if s == "": [] else: s.split("\u001f")

# "" when a field cannot be framed (the rewrite then fails closed).
pub fn module_tldr_generic_spec_ctx_section_v1(i: GenericSpecInputsV1) -> text:
    val g = i.guard_root
    if not _ctx_field_ok_v1([g.profile_digest, g.root_digest]) or not _ctx_field_ok_v1(g.sorted_entries) or
            not _ctx_field_ok_v1(g.unevaluable) or not _ctx_field_ok_v1(i.import_names) or
            not _ctx_field_ok_v1(i.import_paths):
        return ""
    val complete_flag = if g.complete: "1" else: "0"
    val unknown_flag = if i.imports_unknown: "1" else: "0"
    val lines = [_GENERIC_SPEC_CTX_MAGIC_V1, g.profile_digest, complete_flag, g.root_digest,
        g.sorted_entries.join("\u001f"), g.unevaluable.join("\u001f"), i.import_names.join("\u001f"),
        unknown_flag, i.import_paths.join("\u001f")]
    "generic-spec-ctx|" + lines.join("\n")

pub fn module_tldr_generic_spec_ctx_of_sections_v1(sections: [text]) -> GenericSpecInputsV1?:
    for s in sections:
        if s.starts_with("generic-spec-ctx|"):
            val f = s.substring(17).split("\n")
            if f.len() != 9 or f[0] != _GENERIC_SPEC_CTX_MAGIC_V1:
                return nil
            return Some(GenericSpecInputsV1(
                guard_root: ActiveGuardRootV1(profile_digest: f[1], sorted_entries: _ctx_list_v1(f[4]),
                    complete: f[2] == "1", unevaluable: _ctx_list_v1(f[5]), root_digest: f[3]),
                import_names: _ctx_list_v1(f[6]), imports_unknown: f[7] == "1",
                import_paths: _ctx_list_v1(f[8])))
    nil

# `generic-spec` section: the concrete generic instances this module
# requires, over its own and its imports' templates, keyed under the host
# profile and this module's ActiveGuardRoot. "" when it provably needs none.
# With mono data (P-G5) the list is what mono actually instantiated after
# inference; without it (emit time, before mono) the text scan is a
# fallback and the list is never complete.
pub fn module_tldr_generic_spec_section_v1(source: text, module_id: text, own_sections: [text],
        imports: [ParserImport], source_path: text, tldr_root: text,
        guard_root: ActiveGuardRootV1) -> text:
    module_tldr_generic_spec_section_mono_v1(source, module_id, own_sections, imports, source_path,
        tldr_root, guard_root, nil)

pub fn module_tldr_generic_spec_section_mono_v1(source: text, module_id: text, own_sections: [text],
        imports: [ParserImport], source_path: text, tldr_root: text,
        guard_root: ActiveGuardRootV1, mono: MonoGenericUsesV1?) -> text:
    val (imported, names, unknown, _paths) = module_tldr_imported_generic_view_v1(imports, source_path, tldr_root)
    _module_tldr_generic_spec_section_of_v1(source, module_id, own_sections, imported, names, unknown,
        guard_root, mono)

fn _module_tldr_generic_spec_section_of_v1(source: text, module_id: text, own_sections: [text],
        imported: [GenericTemplateEntryV1], names: [text], unknown: bool,
        guard_root: ActiveGuardRootV1, mono: MonoGenericUsesV1?) -> text:
    val (own, own_ok) = generic_templates_of_sections_v1(own_sections)
    var templates = own
    for e in imported: templates.push(e)
    val ctx = GenericSpecContextV1(profile_digest: GENERIC_SPEC_HOST_PROFILE_DIGEST_V1,
        guard_root: guard_root, generic_import_names: names, generic_imports_unknown: unknown)
    var list = GenericSpecializationListV1(complete: false, specs: [])
    match mono:
        case Some(m):
            list = generic_specializations_of_mono_v1(m.owners, m.names, m.args, m.complete,
                module_id, templates, ctx)
        case nil:
            list = generic_specializations_text_fallback_v1(source, module_id, templates, ctx)
    if not own_ok:
        list = GenericSpecializationListV1(complete: false, specs: list.specs)
    if list.complete and list.specs.len() == 0:
        return ""
    "generic-spec|" + generic_specialization_section_encode_v1(list)

# Temp file in the destination directory, then rename over the destination.
pub fn module_artifact_publish_atomic_v1(path: text, content: text) -> bool:
    val slash = path.rfind("/")
    if slash > 0 and not dir_create_all(path.substring(0, slash)):
        return false
    if not disk_publish_admitted(if slash > 0: path.substring(0, slash) else: ".", content.len()):
        return false
    val temp = "{path}.{getpid()}.{xxh3_128_text(content)}.tmp"
    if not file_write(temp, content):
        val _w = file_delete(temp)
        return false
    if not file_rename(temp, path):
        val _r = file_delete(temp)
        return false
    true

# The shared entry. Returns "" on success (fresh or regenerated), else an
# error text. A fresh companion skips the parse entirely.
pub fn module_artifacts_emit_v1(source_path: text, tldr_root: text) -> text:
    if not file_exists(source_path):
        return "source not found: {source_path}"
    val source = file_read(source_path)
    val tldr_path = module_tldr_companion_path_v1(tldr_root, source_path)
    if module_tldr_companion_fresh_v1(tldr_path, source):
        return ""
    val module_id = module_artifact_module_id_v1(source_path)
    # The one parse: fills the full-AST caches as a side effect of the
    # ordinary frontend cache boundary.
    val parsed = parse_full_frontend(source, source_path, module_id, Logger(level: 0))
    # Macro facts are read from the parser pools of THIS parse before anything
    # else parses. Imported macros resolve against the imports' fresh TLDR
    # companions (macro-def + macro-key sections); if any import companion is
    # missing or stale, unresolved uses are kept conservative (never a false
    # negative cache hit).
    # Guards are recovered from the ORIGINAL source (the preprocessor blanks
    # inactive @when branches before the parser runs).
    val (macro_source, guard_evals) = macro_module_source_from_parse_guarded_v1("", module_id,
        source_path, source)
    val (imported_macros, imports_complete) = module_tldr_imported_macro_projections_v1(
        _module_import_source_paths_v1(parsed, source_path), tldr_root)
    var macro_projection = project_macro_module_guarded_v1(macro_source, imported_macros,
        macro_content_digest_v1("macro-profile/host"), guard_evals)
    if not imports_complete:
        macro_projection = macro_projection_mark_imports_incomplete_v1(macro_projection)
    val (view_sections, _refusal) = module_tldr_companion_view_sections_with_macros_v1(parsed,
        source_path, source, module_id, macro_projection.def_table, macro_projection.use_table,
        macro_projection.generated_public_names)
    var sections = view_sections
    val macro_key_section = module_tldr_macro_key_section_v1(macro_projection)
    if macro_key_section != "":
        sections.push(macro_key_section)
    val guard_root = active_guard_root_v1(GENERIC_SPEC_HOST_PROFILE_DIGEST_V1, guard_evals)
    val (imported, import_names, imports_unknown, import_paths) =
        module_tldr_imported_generic_view_v1(parsed.imports, source_path, tldr_root)
    # Emit-time list: text-scan fallback, never complete (mono has not run).
    val spec_section = _module_tldr_generic_spec_section_of_v1(source, module_id, sections,
        imported, import_names, imports_unknown, guard_root, nil)
    val ctx_section = module_tldr_generic_spec_ctx_section_v1(GenericSpecInputsV1(
        guard_root: guard_root, import_names: import_names, imports_unknown: imports_unknown,
        import_paths: import_paths))
    if ctx_section != "":
        sections.push(ctx_section)
    if spec_section != "":
        sections.push(spec_section)
    if not module_artifact_publish_atomic_v1(tldr_path,
            module_tldr_companion_render_sections_v1(module_id, source, sections)):
        return "tldr publish failed: {tldr_path}"
    ""

# P-G5 updateTldr after module-scoped mono: replace the companion's
# `generic-spec` section with the list mono actually instantiated, through the
# same temp + atomic rename publish. The companion must already be fresh for
# the source (emit ran); otherwise nothing is written and the error is returned.
# No parse: the guard root and generic import view come from the companion's
# `generic-spec-ctx` section, imported templates from the imports' own fresh
# companions (a missing/stale one marks the list incomplete).
# Race: emit and this rewrite can both replace the same companion; each is an
# atomic rename and emit's list is never complete, so the worst interleaving
# leaves an incomplete list (a wide rebuild), never a wrong complete one.
pub fn module_tldr_update_generic_spec_from_mono_v1(source_path: text, tldr_root: text,
        mono: MonoGenericUsesV1) -> text:
    if not file_exists(source_path):
        return "source not found: {source_path}"
    val source = file_read(source_path)
    val tldr_path = module_tldr_companion_path_v1(tldr_root, source_path)
    if not file_exists(tldr_path):
        return "tldr companion missing: {tldr_path}"
    val content = file_read(tldr_path)
    if module_tldr_companion_body_v1(content, source) == "":
        return "tldr companion stale: {tldr_path}"
    val module_id = module_artifact_module_id_v1(source_path)
    var sections: [text] = []
    for s in module_tldr_companion_sections_v1(content, source):
        if not s.starts_with("generic-spec|"):
            sections.push(s)
    val inputs = module_tldr_generic_spec_ctx_of_sections_v1(sections)
    if inputs == nil:
        return "tldr companion has no generic-spec-ctx: {tldr_path}"
    val i = inputs!
    var imported: [GenericTemplateEntryV1] = []
    var unknown = i.imports_unknown
    for p in i.import_paths:
        val (entries, _bearing, ok) = _module_tldr_generic_templates_of_import_v1(p, tldr_root)
        if not ok: unknown = true
        for e in entries: imported.push(e)
    val spec_section = _module_tldr_generic_spec_section_of_v1(source, module_id, sections,
        imported, i.import_names, unknown, i.guard_root, Some(mono))
    if spec_section != "":
        sections.push(spec_section)
    val rendered = module_tldr_companion_render_sections_v1(module_id, source, sections)
    if rendered == content:
        return ""
    if not module_artifact_publish_atomic_v1(tldr_path, rendered):
        return "tldr publish failed: {tldr_path}"
    ""

# P-G7: the ConcreteTldrKey of each mono use on its own ("" = unkeyable), keyed
# exactly like the module's generic-spec list (same templates, same context),
# so a placed instance symbol maps to the key its instance object is cached by.
pub fn module_tldr_instance_keys_from_mono_v1(source_path: text, tldr_root: text,
        mono: MonoGenericUsesV1) -> [text]:
    var out: [text] = []
    for _n in mono.names:
        out.push("")
    if not file_exists(source_path):
        return out
    val source = file_read(source_path)
    val tldr_path = module_tldr_companion_path_v1(tldr_root, source_path)
    if not file_exists(tldr_path):
        return out
    val content = file_read(tldr_path)
    if module_tldr_companion_body_v1(content, source) == "":
        return out
    val module_id = module_artifact_module_id_v1(source_path)
    var sections: [text] = []
    for s in module_tldr_companion_sections_v1(content, source):
        if not s.starts_with("generic-spec|"):
            sections.push(s)
    val inputs = module_tldr_generic_spec_ctx_of_sections_v1(sections)
    if inputs == nil:
        return out
    val i = inputs!
    var templates: [GenericTemplateEntryV1] = []
    val (own, own_ok) = generic_templates_of_sections_v1(sections)
    if not own_ok:
        return out
    for e in own: templates.push(e)
    for p in i.import_paths:
        val (entries, _bearing, ok) = _module_tldr_generic_templates_of_import_v1(p, tldr_root)
        if not ok:
            return out
        for e in entries: templates.push(e)
    val ctx = GenericSpecContextV1(profile_digest: GENERIC_SPEC_HOST_PROFILE_DIGEST_V1,
        guard_root: i.guard_root, generic_import_names: i.import_names, generic_imports_unknown: false)
    var u = 0
    while u < mono.names.len() and u < mono.owners.len() and u < mono.args.len():
        val one = generic_specializations_of_mono_v1([mono.owners[u]], [mono.names[u]], [mono.args[u]],
            true, module_id, templates, ctx)
        if one.complete and one.specs.len() == 1:
            out[u] = one.specs[0].concrete_key
        u = u + 1
    out

