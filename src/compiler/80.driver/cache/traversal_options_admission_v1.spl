use compiler.loader.traversal_plugin_selection_owner_v1.{traversal_plugin_selection_validate_v1}
# Pure composition consistency, not signature/code admission. The H5 loader
# verifies policy and provider bytes before constructing the supplied selection.
use compiler.common.driver_compile_options.{CompileOptions}
use compiler.common.cache_contract.traversal_plugin_selection_v1.{TraversalPluginSelectionV1,
    traversal_descriptor_identity_v1}

pub fn traversal_options_selection_identity_v1(options: CompileOptions,
        selection: TraversalPluginSelectionV1?) -> Result<text, text>:
    if options.traversal_plugin_request_v1 == nil:
        if selection != nil or options.traversal_plugin_resolved_identity_v1 != "":
            return Err("traversal-provider-selection-without-request")
        return Ok("")
    if selection == nil or options.traversal_plugin_resolved_identity_v1 == "":
        return Err("traversal-provider-admission-required-before-context")
    val provider = traversal_plugin_selection_validate_v1(selection.unwrap())?
    if options.traversal_plugin_request_v1.unwrap().provider_id != provider.provider_id:
        return Err("traversal-provider-request-identity-mismatch")
    val identity = traversal_descriptor_identity_v1(provider)?
    if identity != options.traversal_plugin_resolved_identity_v1:
        return Err("traversal-provider-resolved-identity-mismatch")
    Ok(identity)

# Hash derivation consumes only identity from an already admitted composition.
# It cannot load code or authenticate options. Missing/unrequested identity is
# an error rather than the ordinary builtin key; paths never enter this key.
pub fn traversal_options_hash_identity_v1(options: CompileOptions) -> Result<text, text>:
    val identity = options.traversal_plugin_resolved_identity_v1
    if options.traversal_plugin_request_v1 == nil:
        if identity != "": return Err("traversal-provider-identity-without-request")
        return Ok("")
    if identity == "" or identity.byte_len() > 131072:
        return Err("traversal-provider-admission-required-before-cache")
    Ok(identity)
