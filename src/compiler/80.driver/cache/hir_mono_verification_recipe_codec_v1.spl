use compiler.mono.mono_archive_nominal_v2.{MonoArchiveNominalDeclV2, mono_archive_nominal_rows_put_v2, mono_archive_nominal_rows_get_v2}
# Body-free, versioned replay metadata. All decoders require full consumption
# and exact stable re-encoding of the existing legacy flat-pool byte contract.
use compiler.driver.cache.hir_body_typecheck_lease_v1.{HirBodyArchiveInputV1, HirBodyArchiveV1}
use compiler.mono.mono_archive_body_input_v1.{MonoArchiveBodyInputV1, mono_archive_body_input_matches_v1}
use compiler.mono.mono_archive_current_body_v1.{MonoArchiveCurrentBodyV1}
use compiler.common.cache_contract.hir_owned_artifact_cache_v1.{HirOwnedArtifactContextV1}
use compiler.mono.mono_archive_publication_identity_v1.{MonoArchiveSelectedFunctionV1}
use compiler.hir.hir_codec_support.{HirCodecWriter}
use compiler.frontend.core.flat_pool_codec.{FlatPoolReader}

struct MonoVerificationModuleRecipeV1:
    archive: HirBodyArchiveV1
    roots: [MonoArchiveSelectedFunctionV1]
    specializations: [MonoArchiveSelectedFunctionV1]
    coverage_digest: text
    body_input: MonoArchiveBodyInputV1? = nil
    shared_symbols: [MonoArchiveSelectedFunctionV1] = []
    symbol_projection: text = ""
    symbol_patches: [text] = []

struct MonoVerificationGlobalRecipeV1:
    nominal_imports: Dict<text, MonoArchiveNominalDeclV2> = {}
    unresolved_templates: [text]
    emitted_templates: [text]
    next_symbol: i64

struct MonoVerificationModuleRowV1:
    module_name: text
    recipe_key: text
    recipe_digest: text
    input_archive_key: text
    input_body_digest: text

struct MonoVerificationManifestV1:
    input_authority: text
    schedule_digest: text
    state_digest: text
    publication_ledger_digest: text
    epoch: i64
    global_key: text
    global_digest: text
    modules: [MonoVerificationModuleRowV1]

fn mono_verification_put_selected_v1(writer: HirCodecWriter, row: MonoArchiveSelectedFunctionV1):
    writer.put_text(row.module_name)
    writer.put_text(row.input_archive_key)
    writer.put_text(row.input_body_digest)
    writer.put_text(row.output_archive_key)
    writer.put_text(row.output_body_digest)
    writer.put_text(row.output_function_digest)
    writer.put_i64(row.target_symbol)
    writer.put_text(row.target_name)
    writer.put_text(row.stage)
    writer.put_text(row.delta_digest)
    writer.put_text(row.function_archive_key)

fn mono_verification_get_selected_v1(reader: FlatPoolReader) -> MonoArchiveSelectedFunctionV1:
    MonoArchiveSelectedFunctionV1(module_name: reader.decode_text(reader.next()),
        input_archive_key: reader.decode_text(reader.next()), input_body_digest: reader.decode_text(reader.next()),
        output_archive_key: reader.decode_text(reader.next()), output_body_digest: reader.decode_text(reader.next()),
        output_function_digest: reader.decode_text(reader.next()), target_symbol: reader.next_i64(),
        target_name: reader.decode_text(reader.next()), stage: reader.decode_text(reader.next()),
        delta_digest: reader.decode_text(reader.next()), function_archive_key: reader.decode_text(reader.next()))

fn mono_verification_module_encode_v1(recipe: MonoVerificationModuleRecipeV1) -> text:
    var writer = HirCodecWriter.create()
    var logical = false
    if val body = recipe.body_input: logical = body.logical_name != ""
    if not logical and recipe.shared_symbols.len() != 0: return ""
    val nominal = recipe.symbol_projection != ""
    writer.put_text(if nominal: "mono-verification-module-recipe-v4" else: if logical: "mono-verification-module-recipe-v3" else: if recipe.body_input != nil: "mono-verification-module-recipe-v2" else: "mono-verification-module-recipe-v1")
    if nominal:
        writer.put_bool(recipe.body_input != nil)
        writer.put_bool(logical)
    val input = recipe.archive.input
    writer.put_text(input.source_path)
    writer.put_text(input.closure_digest)
    writer.put_bool(input.is_entry)
    writer.put_text(input.module_name)
    writer.put_text(input.runtime_provider_receipt_path)
    writer.put_text(input.runtime_provider_digest)
    writer.put_text(input.producer_header)
    writer.put_text(input.stage)
    writer.put_text(input.provider_selection_digest)
    writer.put_text(input.source_content_digest)
    writer.put_text(input.source_authored_path)
    writer.put_text(recipe.archive.source_key)
    writer.put_text(recipe.archive.archive_key)
    writer.put_text(recipe.archive.body_digest)
    writer.put_text(recipe.archive.lowering_warnings_digest)
    if val body_input = recipe.body_input:
        if body_input.original_parent.archive_key != recipe.archive.archive_key or not mono_archive_body_input_matches_v1(body_input): return ""
        if val current = body_input.current_body:
            writer.put_text(current.current_artifact_key)
            writer.put_text(current.current_body_digest)
            writer.put_text(current.current_warnings_digest)
            writer.put_text(current.current_stage)
            writer.put_text(current.parent_boundary_key)
            writer.put_text(current.parent_boundary_digest)
        else:
            return ""
        if logical: writer.put_text(body_input.logical_name)
        if val cache = body_input.current_cache:
            writer.put_text(cache.directory)
            writer.put_text(cache.producer_header)
            writer.put_bool(cache.enabled)
        else:
            return ""
    writer.put_text(recipe.coverage_digest)
    writer.put_i64(recipe.roots.len())
    for row in recipe.roots: mono_verification_put_selected_v1(writer, row)
    writer.put_i64(recipe.specializations.len())
    for row in recipe.specializations: mono_verification_put_selected_v1(writer, row)
    if logical:
        writer.put_i64(recipe.shared_symbols.len())
        for row in recipe.shared_symbols: mono_verification_put_selected_v1(writer, row)
    if nominal:
        writer.put_text(recipe.symbol_projection)
        writer.put_i64(recipe.symbol_patches.len())
        for patch in recipe.symbol_patches: writer.put_text(patch)
    elif recipe.symbol_patches.len() != 0: return ""
    if not writer.ok: return ""
    writer.finish()

fn mono_verification_module_decode_v1(blob: text) -> Result<MonoVerificationModuleRecipeV1, text>:
    var reader = FlatPoolReader.new(blob)
    val stage = reader.decode_text(reader.next())
    if stage != "mono-verification-module-recipe-v1" and stage != "mono-verification-module-recipe-v2" and stage != "mono-verification-module-recipe-v3" and stage != "mono-verification-module-recipe-v4": return Err("mono recipe stage differs")
    val nominal = stage == "mono-verification-module-recipe-v4"
    val current = if nominal: reader.next_i64() == 1 else: stage == "mono-verification-module-recipe-v2" or stage == "mono-verification-module-recipe-v3"
    val logical = if nominal: reader.next_i64() == 1 else: stage == "mono-verification-module-recipe-v3"
    if logical and not current: return Err("nominal logical recipe missing current parent")
    val source_path = reader.decode_text(reader.next())
    val closure = reader.decode_text(reader.next())
    val entry = reader.next_i64() == 1
    val input = HirBodyArchiveInputV1(source_path: source_path, closure_digest: closure, is_entry: entry,
        module_name: reader.decode_text(reader.next()), runtime_provider_receipt_path: reader.decode_text(reader.next()),
        runtime_provider_digest: reader.decode_text(reader.next()), producer_header: reader.decode_text(reader.next()),
        stage: reader.decode_text(reader.next()), provider_selection_digest: reader.decode_text(reader.next()),
        source_content_digest: reader.decode_text(reader.next()), source_authored_path: reader.decode_text(reader.next()))
    val archive = HirBodyArchiveV1(input: input, source_key: reader.decode_text(reader.next()),
        archive_key: reader.decode_text(reader.next()), body_digest: reader.decode_text(reader.next()),
        lowering_warnings_digest: reader.decode_text(reader.next()))
    var body_input: MonoArchiveBodyInputV1? = nil
    if current:
        val current = MonoArchiveCurrentBodyV1(original_parent: archive,
            current_artifact_key: reader.decode_text(reader.next()), current_body_digest: reader.decode_text(reader.next()),
            current_warnings_digest: reader.decode_text(reader.next()), current_stage: reader.decode_text(reader.next()),
            parent_boundary_key: reader.decode_text(reader.next()), parent_boundary_digest: reader.decode_text(reader.next()))
        val logical_name = if logical: reader.decode_text(reader.next()) else: ""
        if logical and logical_name == "": return Err("mono logical recipe name missing")
        val cache = HirOwnedArtifactContextV1(directory: reader.decode_text(reader.next()),
            producer_header: reader.decode_text(reader.next()), enabled: reader.next_i64() == 1)
        body_input = Some(MonoArchiveBodyInputV1(original_parent: archive, current_body: Some(current), current_cache: Some(cache), logical_name: logical_name))
    val coverage = reader.decode_text(reader.next())
    var roots: [MonoArchiveSelectedFunctionV1] = []
    val root_count = reader.next_len()
    var index = 0
    while index < root_count and reader.ok:
        roots = roots.push(mono_verification_get_selected_v1(reader))
        index = index + 1
    var specializations: [MonoArchiveSelectedFunctionV1] = []
    val spec_count = reader.next_len()
    index = 0
    while index < spec_count and reader.ok:
        specializations = specializations.push(mono_verification_get_selected_v1(reader))
        index = index + 1
    var shared_symbols: [MonoArchiveSelectedFunctionV1] = []
    if logical:
        val shared_count = reader.next_len()
        index = 0
        while index < shared_count and reader.ok:
            shared_symbols = shared_symbols.push(mono_verification_get_selected_v1(reader))
            index = index + 1
    val projection = if nominal: reader.decode_text(reader.next()) else: ""
    if nominal and projection == "": return Err("nominal recipe projection missing")
    var patches: [text] = []
    if nominal:
        val patch_count = reader.next_len()
        index = 0
        while index < patch_count and reader.ok:
            patches.push(reader.decode_text(reader.next()))
            index = index + 1
    val recipe = MonoVerificationModuleRecipeV1(archive: archive, roots: roots,
        specializations: specializations, coverage_digest: coverage, body_input: body_input, shared_symbols: shared_symbols, symbol_projection: projection, symbol_patches: patches)
    if not reader.ok or reader.pos != reader.lines.len() - 1: return Err("mono module recipe framing refused")
    if reader.lines[reader.pos] != "" or mono_verification_module_encode_v1(recipe) != blob:
        return Err("mono module recipe stable bytes refused")
    Ok(recipe)

fn mono_verification_global_encode_v1(recipe: MonoVerificationGlobalRecipeV1) -> text:
    var writer = HirCodecWriter.create()
    writer.put_text("mono-verification-global-recipe-v2")
    mono_archive_nominal_rows_put_v2(writer, recipe.nominal_imports)
    writer.put_i64(recipe.next_symbol)
    writer.put_i64(recipe.unresolved_templates.len())
    for name in recipe.unresolved_templates: writer.put_text(name)
    writer.put_i64(recipe.emitted_templates.len())
    for name in recipe.emitted_templates: writer.put_text(name)
    if not writer.ok: return ""
    writer.finish()

fn mono_verification_global_decode_v1(blob: text) -> Result<MonoVerificationGlobalRecipeV1, text>:
    var reader = FlatPoolReader.new(blob)
    if reader.decode_text(reader.next()) != "mono-verification-global-recipe-v2": return Err("mono global recipe stage differs")
    val imports = mono_archive_nominal_rows_get_v2(reader)
    val next_symbol = reader.next_i64()
    var unresolved: [text] = []
    var count = reader.next_len()
    var index = 0
    while index < count and reader.ok:
        unresolved = unresolved.push(reader.decode_text(reader.next()))
        index = index + 1
    var emitted: [text] = []
    count = reader.next_len()
    index = 0
    while index < count and reader.ok:
        emitted = emitted.push(reader.decode_text(reader.next()))
        index = index + 1
    val recipe = MonoVerificationGlobalRecipeV1(nominal_imports: imports, unresolved_templates: unresolved,
        emitted_templates: emitted, next_symbol: next_symbol)
    if not reader.ok or reader.pos != reader.lines.len() - 1: return Err("mono global recipe framing refused")
    if reader.lines[reader.pos] != "" or mono_verification_global_encode_v1(recipe) != blob:
        return Err("mono global recipe stable bytes refused")
    Ok(recipe)

fn mono_verification_manifest_encode_v1(manifest: MonoVerificationManifestV1) -> text:
    var writer = HirCodecWriter.create()
    writer.put_text("mono-verification-use-manifest-v1")
    writer.put_text(manifest.input_authority)
    writer.put_text(manifest.schedule_digest)
    writer.put_text(manifest.state_digest)
    writer.put_text(manifest.publication_ledger_digest)
    writer.put_i64(manifest.epoch)
    writer.put_text(manifest.global_key)
    writer.put_text(manifest.global_digest)
    writer.put_i64(manifest.modules.len())
    for row in manifest.modules:
        writer.put_text(row.module_name)
        writer.put_text(row.recipe_key)
        writer.put_text(row.recipe_digest)
        writer.put_text(row.input_archive_key)
        writer.put_text(row.input_body_digest)
    if not writer.ok: return ""
    writer.finish()

fn mono_verification_manifest_decode_v1(blob: text) -> Result<MonoVerificationManifestV1, text>:
    var reader = FlatPoolReader.new(blob)
    if reader.decode_text(reader.next()) != "mono-verification-use-manifest-v1": return Err("mono manifest stage differs")
    val authority = reader.decode_text(reader.next())
    val schedule = reader.decode_text(reader.next())
    val state = reader.decode_text(reader.next())
    val ledger = reader.decode_text(reader.next())
    val epoch = reader.next_i64()
    val global_key = reader.decode_text(reader.next())
    val global_digest = reader.decode_text(reader.next())
    var modules: [MonoVerificationModuleRowV1] = []
    val count = reader.next_len()
    var index = 0
    while index < count and reader.ok:
        modules = modules.push(MonoVerificationModuleRowV1(module_name: reader.decode_text(reader.next()),
            recipe_key: reader.decode_text(reader.next()), recipe_digest: reader.decode_text(reader.next()),
            input_archive_key: reader.decode_text(reader.next()), input_body_digest: reader.decode_text(reader.next())))
        index = index + 1
    val manifest = MonoVerificationManifestV1(input_authority: authority, schedule_digest: schedule,
        state_digest: state, publication_ledger_digest: ledger, epoch: epoch,
        global_key: global_key, global_digest: global_digest, modules: modules)
    if not reader.ok or reader.pos != reader.lines.len() - 1: return Err("mono manifest framing refused")
    if reader.lines[reader.pos] != "" or mono_verification_manifest_encode_v1(manifest) != blob:
        return Err("mono manifest stable bytes refused")
    Ok(manifest)

export MonoVerificationModuleRecipeV1, MonoVerificationGlobalRecipeV1
export MonoVerificationModuleRowV1, MonoVerificationManifestV1
export mono_verification_module_encode_v1, mono_verification_module_decode_v1
export mono_verification_global_encode_v1, mono_verification_global_decode_v1
export mono_verification_manifest_encode_v1, mono_verification_manifest_decode_v1
