# Remote client — READ-ONLY lookup against the trusted remote-main cache
# namespace. Design §14.2 "On a remote hit" verification order:
#
#   1. Fetch action mapping.
#   2. Validate namespace, schema, and exact ActionDigest.
#   3. Validate promotion/provenance policy.
#   4. Fetch the immutable result manifest.
#   5. Verify its digest.
#   6. Verify every referenced artifact digest while materializing it into
#      the machine CAS.
#   7. Validate target, compiler schema, dependency interface roots, AOP
#      roots, and block-manifest roots.
#   8. Publish a local action mapping only after the closure is complete.
#
# First-milestone scope, per contract: remote READ-ONLY. This module has no
# write/publish-to-remote entry point at all — `RemoteTransport` exposes only
# fetch operations. Step 8 above ("publish a local action mapping") writes
# to the LOCAL machine cache, not to the remote namespace, and is out of
# scope for this file (that is C1's tier_router territory); this module
# stops at "verified remote artifacts are ready to hand to a local
# publisher" and returns that as data.
#
# The network transport is an injectable interface (`RemoteTransport`) so
# tests exercise this module against a local fake — no real network in this
# milestone, per contract.

use compiler.driver.cache.remote.remote_policy.{ProducerClass, remote_read_main_allowed}
use std.common.crypto.sha256.{sha256_text}

val REMOTE_MANIFEST_MAX_BYTES_V1: i64 = 1024 * 1024
val REMOTE_MANIFEST_MAX_REFERENCES_V1: i64 = 4096
val REMOTE_ARTIFACT_MAX_BYTES_V1: i64 = 64 * 1024 * 1024
val REMOTE_CLOSURE_MAX_BYTES_V1: i64 = 256 * 1024 * 1024

# Exact-key remote lookup input. `expected_schema_version` and
# `expected_action_digest` are what step 2 validates against what comes
# back — a mismatch is a hard reject, never a "close enough" acceptance.
struct RemoteLookupRequest:
    namespace: text              # e.g. "remote/<repo-id>/main"
    action_digest: text
    expected_schema_version: i64

# What a remote fetch call returns, before any verification — untrusted
# until every check below passes.
struct RemoteActionMapping:
    namespace: text
    action_digest: text
    schema_version: i64
    result_manifest_digest: text
    receipt_digest: text?        # PromotionReceiptDigest, for trusted namespaces

struct RemoteResultManifest:
    digest: text                 # claimed digest, verified against recompute
    action_digest: text
    artifact_digests: [text]
    dependency_manifest: text
    aop_group_roots: [text]
    block_manifest_root: text?

struct RemoteArtifact:
    digest: text                 # claimed digest, verified against recompute
    bytes: text

# Injectable transport — fetch-only. There is intentionally no `put`/`push`/
# `publish` method on this trait: a transport that cannot write cannot be
# misused to write, regardless of caller bugs.
trait RemoteTransport:
    fn fetch_action_mapping(request: RemoteLookupRequest) -> RemoteActionMapping?
    fn fetch_result_manifest(digest: text) -> RemoteResultManifest?
    fn fetch_artifact(digest: text) -> RemoteArtifact?
    # Compatibility only; admission never trusts a transport-provided hash.
    fn recompute_digest(content: text) -> text

# `Verified` means content integrity only, not target/dependency/provenance
# authority. A local publisher must still admit those semantic authorities
# before publishing a LOCAL machine-cache mapping. Rejection variants name
# the §14.2 sequence failed, for diagnosability.
enum RemoteLookupResult:
    Miss
    Verified(RemoteResultManifest, [RemoteArtifact])
    RejectedPolicyDenied
    RejectedActionDigestMismatch
    RejectedSchemaVersionMismatch
    RejectedManifestDigestMismatch
    RejectedManifestActionMismatch
    RejectedArtifactDigestMismatch(text)

fn remote_digest_valid_v1(value: text) -> bool:
    if value.len() != 64: return false
    var index = 0
    while index < value.len():
        val code = value.byte_at(index) as i64
        if not ((code >= 48 and code <= 57) or (code >= 97 and code <= 102)):
            return false
        index = index + 1
    true

fn remote_frame_v1(value: text) -> text:
    "{value.len()}:{value}"

fn remote_digest_list_encode_v1(values: [text]) -> text:
    if values.len() > REMOTE_MANIFEST_MAX_REFERENCES_V1: return ""
    var seen: Dict<text, bool> = {}
    var encoded = remote_frame_v1("{values.len()}")
    for value in values:
        if not remote_digest_valid_v1(value) or seen.has(value): return ""
        seen[value] = true
        encoded = encoded + remote_frame_v1(value)
    encoded

# Canonical ordered fields, explicit optional presence, and byte-length frames
# bind every field except the manifest's own claimed digest. Dependency data
# remains bounded opaque text; its semantic authority belongs to the caller.
fn remote_result_manifest_encode_v1(manifest: RemoteResultManifest) -> text:
    if not remote_digest_valid_v1(manifest.action_digest) or
            manifest.dependency_manifest.len() > REMOTE_MANIFEST_MAX_BYTES_V1:
        return ""
    val artifacts = remote_digest_list_encode_v1(manifest.artifact_digests)
    val aop = remote_digest_list_encode_v1(manifest.aop_group_roots)
    if artifacts == "" or aop == "": return ""
    var block = "0"
    if val root = manifest.block_manifest_root:
        if not remote_digest_valid_v1(root): return ""
        block = "1" + remote_frame_v1(root)
    val encoded = "simple-remote-result-manifest-v1\n" +
        remote_frame_v1(manifest.action_digest) + remote_frame_v1(artifacts) +
        remote_frame_v1(manifest.dependency_manifest) + remote_frame_v1(aop) +
        remote_frame_v1(block)
    if encoded.len() > REMOTE_MANIFEST_MAX_BYTES_V1: return ""
    encoded

fn remote_result_manifest_digest_v1(manifest: RemoteResultManifest) -> text:
    val encoded = remote_result_manifest_encode_v1(manifest)
    if encoded == "": "" else: sha256_text(encoded)

# Exposed size policy allows boundary verification without allocating hostile
# payloads. Subtraction before addition prevents overflow of cumulative bytes.
fn remote_artifact_size_admissible_v1(size: i64, accumulated: i64) -> bool:
    size >= 0 and size <= REMOTE_ARTIFACT_MAX_BYTES_V1 and
        accumulated >= 0 and accumulated <= REMOTE_CLOSURE_MAX_BYTES_V1 and
        size <= REMOTE_CLOSURE_MAX_BYTES_V1 - accumulated

# Step-ordered verified lookup. `producer` gates step 3 (promotion/provenance
# policy) via remote_policy.spl — a producer class without read-main rights
# never even issues a fetch.
fn remote_lookup_verified(transport: RemoteTransport, request: RemoteLookupRequest, producer: ProducerClass) -> RemoteLookupResult:
    # Step 3 gate, checked before any fetch: a producer without read rights
    # gets no data at all, not merely an unused one.
    if not remote_read_main_allowed(producer):
        return RemoteLookupResult.RejectedPolicyDenied

    # Step 1: fetch action mapping.
    val mapping_opt = transport.fetch_action_mapping(request)
    val mapping = match mapping_opt:
        case Some(m): m
        case nil: return RemoteLookupResult.Miss

    # Step 2: validate namespace, schema, and exact ActionDigest.
    if mapping.namespace != request.namespace:
        return RemoteLookupResult.RejectedPolicyDenied
    if mapping.action_digest != request.action_digest:
        return RemoteLookupResult.RejectedActionDigestMismatch
    if mapping.schema_version != request.expected_schema_version:
        return RemoteLookupResult.RejectedSchemaVersionMismatch

    # Step 4: fetch the immutable result manifest.
    val manifest_opt = transport.fetch_result_manifest(mapping.result_manifest_digest)
    val manifest = match manifest_opt:
        case Some(m): m
        case nil: return RemoteLookupResult.Miss

    # Step 5: verify its digest — the manifest's OWN claimed digest must
    # equal the digest the action index pointed us at, AND the manifest's
    # internal action_digest must match the one we asked for.
    val manifest_digest = remote_result_manifest_digest_v1(manifest)
    if manifest_digest == "" or manifest.digest != mapping.result_manifest_digest or
            manifest_digest != mapping.result_manifest_digest:
        return RemoteLookupResult.RejectedManifestDigestMismatch
    if manifest.action_digest != request.action_digest:
        return RemoteLookupResult.RejectedManifestActionMismatch

    # Step 6: verify every referenced artifact digest while materializing.
    var artifacts: [RemoteArtifact] = []
    var materialized_bytes: i64 = 0
    for artifact_digest in manifest.artifact_digests:
        val artifact_opt = transport.fetch_artifact(artifact_digest)
        val artifact = match artifact_opt:
            case Some(a): a
            case nil: return RemoteLookupResult.RejectedArtifactDigestMismatch(artifact_digest)
        if not remote_artifact_size_admissible_v1(artifact.bytes.len(), materialized_bytes):
            return RemoteLookupResult.RejectedArtifactDigestMismatch(artifact_digest)
        val recomputed = sha256_text(artifact.bytes)
        if recomputed != artifact_digest:
            return RemoteLookupResult.RejectedArtifactDigestMismatch(artifact_digest)
        if artifact.digest != artifact_digest:
            return RemoteLookupResult.RejectedArtifactDigestMismatch(artifact_digest)
        artifacts.push(artifact)
        materialized_bytes = materialized_bytes + artifact.bytes.len()

    # Step 7 (target/schema/dependency/AOP/block-manifest root validation) is
    # deferred to the local publisher, which has the full local context
    # (target profile, compiler schema) to compare against — this module
    # only proves the fetched bytes are exactly what the remote index
    # claims. Step 8 (publish locally) is likewise the local publisher's
    # job, out of this agent's scope; this function returns `Verified` with
    # everything needed to do it, and performs no local or remote write
    # itself.
    RemoteLookupResult.Verified(manifest, artifacts)

export RemoteLookupRequest, RemoteActionMapping, RemoteResultManifest, RemoteArtifact
export RemoteTransport, RemoteLookupResult
export remote_lookup_verified
export remote_result_manifest_encode_v1, remote_result_manifest_digest_v1
export remote_artifact_size_admissible_v1
export REMOTE_MANIFEST_MAX_BYTES_V1, REMOTE_MANIFEST_MAX_REFERENCES_V1
export REMOTE_ARTIFACT_MAX_BYTES_V1, REMOTE_CLOSURE_MAX_BYTES_V1
