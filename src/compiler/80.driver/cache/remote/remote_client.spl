# Remote cache client — PROTOCOL + a local-filesystem FAKE.
#
# This is deliberately NOT a network backend. It defines the seam that C1's
# `cas_store.spl` stub will be wired to, plus an in-tree fake so the whole
# admission/promotion path is testable without a server.
#
# The protocol has exactly four operations, and only ONE of them writes:
#
#   remote_get_action   -> RemoteActionEntry
#   remote_has_blob     -> bool
#   remote_put_blob     -> RemoteResult   [CAS, content-addressed]
#   remote_put_action   -> RemoteResult   [MAPPING, policy-gated]
#
# PROMOTION COPIES ONLY ACTION-MAPPING REFERENCES. CAS blobs are immutable and
# already shared, so promotion never re-uploads bytes — see `remote_promote`.
#
# Best-effort rule (§15.4): a failed remote write must NOT fail the local build.
# `RemoteResult.fatal` is set only when a RELEASE lane could not persist required
# provenance evidence.

use compiler.driver.cache.remote.namespace_policy.{
    CacheNamespace, NamespacePolicy,
    cache_namespace_path, namespace_policy_may_read, namespace_policy_may_write,
    policy_requires_strict_verification,
    NS_MAIN, NS_BRANCH
}

use std.fs.{File, Dir, read_file}

# ============================================================================
# Protocol values
# ============================================================================

val REMOTE_BACKEND_LOCAL_FAKE = "local_fs_fake"
val REMOTE_BACKEND_NONE = "none"

struct RemoteResult:
    ok: bool
    fatal: bool         # true only when a release lane lost required evidence
    reason: text

fn remote_result_ok() -> RemoteResult:
    RemoteResult(ok: true, fatal: false, reason: "")

# Best-effort failure: local build stays successful.
fn remote_result_soft_fail(reason: text) -> RemoteResult:
    RemoteResult(ok: false, fatal: false, reason: reason)

fn remote_result_fatal(reason: text) -> RemoteResult:
    RemoteResult(ok: false, fatal: true, reason: reason)

# One stored action mapping. `receipt_digest` is the provenance handle; the
# mapping is meaningless to a main-namespace reader without it.
struct RemoteActionEntry:
    found: bool
    action_digest: text
    result_manifest_digest: text
    receipt_digest: text

fn remote_action_entry_missing() -> RemoteActionEntry:
    RemoteActionEntry(found: false, action_digest: "", result_manifest_digest: "", receipt_digest: "")

# ============================================================================
# Client
# ============================================================================

struct RemoteCacheClient:
    backend: text
    root: text                  # local-fs fake root; a real backend ignores it
    policy: NamespacePolicy

fn remote_client_local_fake(root: text, policy: NamespacePolicy) -> RemoteCacheClient:
    RemoteCacheClient(backend: REMOTE_BACKEND_LOCAL_FAKE, root: root, policy: policy)

fn remote_client_disabled(policy: NamespacePolicy) -> RemoteCacheClient:
    RemoteCacheClient(backend: REMOTE_BACKEND_NONE, root: "", policy: policy)

# Digests are 64 hex chars; a short one is a caller bug and gets its own shard.
fn remote_shard_head(digest: text) -> text:
    if digest.len() < 2:
        return "__"
    digest.substring(0, 2)

fn remote_shard_path(root: text, kind: text, digest: text) -> text:
    root + "/" + kind + "/sha256/" + remote_shard_head(digest) + "/" + digest

fn remote_action_path(client: RemoteCacheClient, ns: CacheNamespace, action_digest: text) -> text:
    client.root + "/" + cache_namespace_path(ns) + "/sha256/" + remote_shard_head(action_digest) + "/" + action_digest

# ----------------------------------------------------------------------------
# Reads
# ----------------------------------------------------------------------------

fn remote_get_action(client: RemoteCacheClient, ns: CacheNamespace, action_digest: text) -> RemoteActionEntry:
    if client.backend == REMOTE_BACKEND_NONE:
        return remote_action_entry_missing()
    if not namespace_policy_may_read(client.policy, ns.kind):
        return remote_action_entry_missing()
    val path = remote_action_path(client, ns, action_digest)
    if not File.exists(path):
        return remote_action_entry_missing()
    val body = read_file(path)
    val parts = body.split("|")
    if parts.len() < 3:
        return remote_action_entry_missing()
    RemoteActionEntry(found: true, action_digest: parts[0], result_manifest_digest: parts[1], receipt_digest: parts[2])

fn remote_has_blob(client: RemoteCacheClient, digest: text) -> bool:
    if client.backend == REMOTE_BACKEND_NONE:
        return false
    File.exists(remote_shard_path(root: client.root, kind: "cas", digest: digest))

# ----------------------------------------------------------------------------
# Writes
# ----------------------------------------------------------------------------

fn remote_put_blob(client: RemoteCacheClient, digest: text, content: text) -> RemoteResult:
    if client.backend == REMOTE_BACKEND_NONE:
        return remote_result_soft_fail("remote backend disabled")
    val path = remote_shard_path(root: client.root, kind: "cas", digest: digest)
    val dir = client.root + "/cas/sha256/" + remote_shard_head(digest)
    if not Dir.create_all(dir):
        return remote_result_soft_fail("cannot create cas shard dir")
    if File.exists(path):
        return remote_result_ok()
    if not File.write(path, content):
        return remote_result_soft_fail("cas write failed")
    remote_result_ok()

# The single policy-gated write. Namespace authority is checked HERE, so no
# caller can reach the main namespace by constructing a path by hand.
fn remote_put_action(client: RemoteCacheClient, ns: CacheNamespace, entry: RemoteActionEntry) -> RemoteResult:
    if client.backend == REMOTE_BACKEND_NONE:
        return remote_result_soft_fail("remote backend disabled")
    if not namespace_policy_may_write(client.policy, ns.kind):
        return remote_result_soft_fail("namespace policy forbids writing the " + ns.kind + " namespace as role " + client.policy.role)
    if ns.kind == NS_MAIN and entry.receipt_digest == "":
        return remote_result_soft_fail("main namespace mapping requires a signed promotion receipt")
    val path = remote_action_path(client, ns, entry.action_digest)
    val dir = client.root + "/" + cache_namespace_path(ns) + "/sha256/" + remote_shard_head(entry.action_digest)
    if not Dir.create_all(dir):
        return remote_result_soft_fail("cannot create action shard dir")
    val body = entry.action_digest + "|" + entry.result_manifest_digest + "|" + entry.receipt_digest
    if not File.write(path, body):
        # §15.4: ordinary cache capacity is not a correctness requirement, so a
        # lost mapping is soft — EXCEPT on a release lane, where the provenance
        # evidence itself failed to persist.
        if policy_requires_strict_verification(client.policy.role):
            return remote_result_fatal("release lane could not persist the action mapping for " + entry.action_digest)
        return remote_result_soft_fail("action mapping write failed")
    remote_result_ok()

# ----------------------------------------------------------------------------
# Promotion transport
# ----------------------------------------------------------------------------
# Copies the MAPPING only. It never touches `cas/` — the blobs the branch entry
# points at are content-addressed and already visible to main readers.
#
# NOTE: a present, digest-verified blob proves only that the bytes hash to the
# digest. It says NOTHING about which action produced them. The mapping this
# function copies is the trusted claim, and it is admitted only by
# `promotion_gate_admit`.
fn remote_promote(client: RemoteCacheClient, from_ns: CacheNamespace, to_ns: CacheNamespace, action_digest: text, receipt_digest: text) -> RemoteResult:
    if to_ns.kind != NS_MAIN and to_ns.kind != NS_BRANCH:
        return remote_result_soft_fail("promotion target must be a shared namespace")
    val src = remote_get_action(client, from_ns, action_digest)
    if not src.found:
        return remote_result_soft_fail("source mapping not found in " + from_ns.kind + " namespace")
    val promoted = RemoteActionEntry(
        found: true,
        action_digest: src.action_digest,
        result_manifest_digest: src.result_manifest_digest,
        receipt_digest: receipt_digest
    )
    remote_put_action(client, to_ns, promoted)
