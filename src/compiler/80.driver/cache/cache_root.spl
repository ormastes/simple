# Host-shared cache root resolution.
#
# The machine tier must not live below a worktree: concurrent worktrees and
# agents otherwise duplicate identical content. SIMPLE_CACHE remains the exact
# operator override. The default is user-host shared and project namespaced.

use std.crypto.sha256.{sha256_text}
use std.io_runtime.{env_get_opt}

val DEFAULT_CACHE_PROJECT: text = "simple"

fn cache_project_namespace() -> text:
    val configured = env_get_opt("SIMPLE_CACHE_PROJECT") ?? ""
    val project = if configured.trim() != "": configured.trim() else: DEFAULT_CACHE_PROJECT
    sha256_text("simple-cache-project-v1\n{project}")

fn host_cache_base() -> text:
    val storage_root = env_get_opt("SIMPLE_USER_STORAGE_ROOT") ?? ""
    if storage_root != "":
        return "{storage_root}/cache/compiler"
    val explicit = env_get_opt("SIMPLE_HOST_CACHE_ROOT") ?? ""
    if explicit != "":
        return explicit
    val xdg = env_get_opt("XDG_CACHE_HOME") ?? ""
    if xdg != "":
        return "{xdg}/simple"
    val home = env_get_opt("HOME") ?? ""
    if home != "":
        return "{home}/.cache/simple"
    "/tmp/simple-cache"

fn machine_cache_root() -> text:
    val exact = env_get_opt("SIMPLE_CACHE") ?? ""
    if exact != "":
        return exact
    "{host_cache_base()}/v1/projects/{cache_project_namespace()}"

fn machine_cache_root_receipt() -> text:
    val exact = env_get_opt("SIMPLE_CACHE") ?? ""
    if exact != "":
        return "source=legacy-explicit-override;path={exact}"
    val storage_root = env_get_opt("SIMPLE_USER_STORAGE_ROOT") ?? ""
    if storage_root != "":
        return "source=centralized-user-root;path={machine_cache_root()}"
    "source=legacy-platform-default;path={machine_cache_root()}"

export DEFAULT_CACHE_PROJECT, cache_project_namespace, host_cache_base, machine_cache_root, machine_cache_root_receipt
