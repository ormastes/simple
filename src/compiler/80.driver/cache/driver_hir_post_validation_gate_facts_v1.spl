# Shared actual post-HIR gates and diagnostic routing. Inputs are recipes,
# never admission: the driver owner must recollect them from complete bodies.
use compiler.semantics.value_struct_layout.{ValueStructLayoutModuleV1,
    value_struct_layout_declaration_report_v1, value_struct_layout_is_cycle_diagnostic,
    value_struct_layout_cycle_is_fatal_for}
use compiler.semantics.rt_criticality.{RtCriticalDiagnostic, RtCriticalDiagnosticSeverity}
use compiler.semantics.aspect_weave.{AspectForwardWeaveClaimV1}
use compiler.driver.driver_log_helpers.{log_phase}
use std.nogc_sync_mut.io.process_ops.{eprint}

struct DriverHirGateLayoutReportV1:
    errors: [text]
    warnings: [text]
    skipped_struct_edges: i64
    layout_cycles_downgraded: i64

struct DriverHirGateCensusReportV1:
    errors: [text]
    messages: [text]
    gates_skipped: bool

struct DriverHirGateRtReportV1:
    errors: [text]
    warnings: [text]

struct DriverHirPostValidationGateReportV1:
    errors: [text]
    warnings: [text]
    census_messages: [text]
    aspect_errors: [text]
    skipped_struct_edges: i64
    layout_cycles_downgraded: i64
    gates_skipped: bool
    weave_claims: [AspectForwardWeaveClaimV1]

pub fn driver_hir_gate_layout_report_v1(module_keys: [text],
        modules: [ValueStructLayoutModuleV1], cycle_mode: text) -> DriverHirGateLayoutReportV1:
    val report = value_struct_layout_declaration_report_v1(module_keys, modules)
    val fatal = value_struct_layout_cycle_is_fatal_for(cycle_mode)
    var errors: [text] = []
    var warnings: [text] = []
    var downgraded: i64 = 0
    for error in report.errors:
        if not fatal and value_struct_layout_is_cycle_diagnostic(error):
            warnings.push(error)
            downgraded = downgraded + 1
        else:
            errors.push(error)
    if downgraded > 0:
        warnings.push("{downgraded} by-value struct cycle(s) not fatal: SIMPLE_VALUE_STRUCT_LAYOUT_CYCLE=warning is diagnostic-only; do not trust or ship this build output")
    DriverHirGateLayoutReportV1(errors: errors, warnings: warnings,
        skipped_struct_edges: report.skipped_struct_edges, layout_cycles_downgraded: downgraded)

pub fn driver_hir_gate_publish_warnings_v1(warnings: [text]):
    for warning in warnings: eprint("[post-hir-validation-warning] {warning}")

pub fn driver_hir_gate_census_report_v1(dropped: [text], census_total: i64) -> DriverHirGateCensusReportV1:
    var errors: [text] = []
    var messages: [text] = []
    var skipped = false
    if dropped.len() > 0 and dropped.len() == census_total:
        messages.push("[post-hir-validation] well-formedness test rejected all {census_total} HIR module value(s); the test is unreliable for this value representation, running the Dict validators unguarded")
    elif dropped.len() > 0:
        messages.push("[post-hir-validation-fatal] {dropped.len()} module(s) in the Dict<text, HirModule> view carry no well-formed HIR aggregate; layer-eq, effect, aspect validation and advice weaving are SKIPPED rather than dereferencing them")
        var shown = 0
        for key in dropped:
            if shown < 10: messages.push("[post-hir-validation-fatal]   dropped HIR aggregate: {key}")
            shown = shown + 1
        errors.push("internal error: {dropped.len()} HIR module(s) lost their aggregate value in Dict<text, HirModule> before post-HIR validation (first: {dropped[0]})")
        skipped = true
    DriverHirGateCensusReportV1(errors: errors, messages: messages, gates_skipped: skipped)

pub fn driver_hir_gate_publish_census_v1(report: DriverHirGateCensusReportV1):
    for message in report.messages: eprint(message)

pub fn driver_hir_gate_rt_report_v1(diagnostics: [RtCriticalDiagnostic]) -> DriverHirGateRtReportV1:
    var errors: [text] = []
    var warnings: [text] = []
    for diagnostic in diagnostics:
        match diagnostic.severity:
            case RtCriticalDiagnosticSeverity.Warning: warnings.push(diagnostic.message)
            case RtCriticalDiagnosticSeverity.Error: errors.push(diagnostic.message)
    DriverHirGateRtReportV1(errors: errors, warnings: warnings)

pub fn driver_print_post_hir_validation_fatal(errors: [text]):
    var shown: i64 = 0
    for error in errors:
        if shown < 10:
            eprint("[post-hir-validation-fatal] {error}")
            shown = shown + 1
    if errors.len() > 0:
        eprint("[post-hir-validation-fatal-count] count={errors.len()} shown={shown}")

export DriverHirGateLayoutReportV1, DriverHirGateCensusReportV1, DriverHirGateRtReportV1
export DriverHirPostValidationGateReportV1
export driver_hir_gate_layout_report_v1, driver_hir_gate_census_report_v1, driver_hir_gate_rt_report_v1
export driver_hir_gate_publish_warnings_v1, driver_hir_gate_publish_census_v1
export driver_print_post_hir_validation_fatal
