# Shared actual post-HIR gates and diagnostic routing. Inputs are recipes,
# never admission: the driver owner must recollect them from complete bodies.
use compiler.semantics.value_struct_layout.{ValueStructLayoutModuleV1,
    value_struct_layout_declaration_report_v1, value_struct_layout_is_cycle_diagnostic,
    value_struct_layout_cycle_is_fatal_for}
use compiler.semantics.layer_eq_checker.{LayerEqType}
use compiler.semantics.layer_eq_validation.{validate_layer_eq_claim_declarations_v1}
use compiler.semantics.effect_validation.{EffectFunctionFactsV1, validate_effect_claim_facts_v1}
use compiler.semantics.rt_criticality_validation.{RtCriticalFunctionFactsV1,
    validate_rt_criticality_claim_facts_v1}
use compiler.semantics.rt_criticality.{RtCriticalDiagnostic, RtCriticalDiagnosticSeverity,
    RtBoundCapability, rt_bound_manifest_capabilities, rt_bound_manifest_consume_v1}
use compiler.semantics.join_point_model.{JoinPoint}
use compiler.semantics.aspect_validation.{validate_aspect_claim_join_points_v1}
use compiler.semantics.aspect_weave.{AspectForwardWeaveClaimV1,
    aspect_forward_weave_contract_claims_v1}
use compiler.driver.cache.driver_hir_post_validation_policy_v1.{DriverHirPostValidationPolicyLoadV1}
use compiler.driver.driver_log_helpers.{log_phase}
use std.nogc_sync_mut.io.process_ops.{eprint}

struct DriverHirGateLayoutReportV1:
    errors: [text]
    warnings: [text]
    skipped_struct_edges: i64
    layout_cycles_downgraded: i64

struct DriverHirGateCensusReportV1:
    errors: [text]
    messages: [text]
    gates_skipped: bool

struct DriverHirGateRtReportV1:
    errors: [text]
    warnings: [text]

struct DriverHirPostValidationGateReportV1:
    errors: [text]
    warnings: [text]
    census_messages: [text]
    aspect_errors: [text]
    skipped_struct_edges: i64
    layout_cycles_downgraded: i64
    gates_skipped: bool
    weave_claims: [AspectForwardWeaveClaimV1]

pub fn driver_hir_gate_layout_report_v1(module_keys: [text],
        modules: [ValueStructLayoutModuleV1], cycle_mode: text) -> DriverHirGateLayoutReportV1:
    val report = value_struct_layout_declaration_report_v1(module_keys, modules)
    val fatal = value_struct_layout_cycle_is_fatal_for(cycle_mode)
    var errors: [text] = []
    var warnings: [text] = []
    var downgraded: i64 = 0
    for error in report.errors:
        if not fatal and value_struct_layout_is_cycle_diagnostic(error):
            warnings.push(error)
            downgraded = downgraded + 1
        else:
            errors.push(error)
    if downgraded > 0:
        warnings.push("{downgraded} by-value struct cycle(s) not fatal: SIMPLE_VALUE_STRUCT_LAYOUT_CYCLE=warning is diagnostic-only; do not trust or ship this build output")
    DriverHirGateLayoutReportV1(errors: errors, warnings: warnings,
        skipped_struct_edges: report.skipped_struct_edges, layout_cycles_downgraded: downgraded)

pub fn driver_hir_gate_publish_warnings_v1(warnings: [text]):
    for warning in warnings: eprint("[post-hir-validation-warning] {warning}")

pub fn driver_hir_gate_census_report_v1(dropped: [text], census_total: i64) -> DriverHirGateCensusReportV1:
    var errors: [text] = []
    var messages: [text] = []
    var skipped = false
    if dropped.len() > 0 and dropped.len() == census_total:
        messages.push("[post-hir-validation] well-formedness test rejected all {census_total} HIR module value(s); the test is unreliable for this value representation, running the Dict validators unguarded")
    elif dropped.len() > 0:
        messages.push("[post-hir-validation-fatal] {dropped.len()} module(s) in the Dict<text, HirModule> view carry no well-formed HIR aggregate; layer-eq, effect, aspect validation and advice weaving are SKIPPED rather than dereferencing them")
        var shown = 0
        for key in dropped:
            if shown < 10: messages.push("[post-hir-validation-fatal]   dropped HIR aggregate: {key}")
            shown = shown + 1
        errors.push("internal error: {dropped.len()} HIR module(s) lost their aggregate value in Dict<text, HirModule> before post-HIR validation (first: {dropped[0]})")
        skipped = true
    DriverHirGateCensusReportV1(errors: errors, messages: messages, gates_skipped: skipped)

pub fn driver_hir_gate_publish_census_v1(report: DriverHirGateCensusReportV1):
    for message in report.messages: eprint(message)

pub fn driver_hir_gate_rt_report_v1(diagnostics: [RtCriticalDiagnostic]) -> DriverHirGateRtReportV1:
    var errors: [text] = []
    var warnings: [text] = []
    for diagnostic in diagnostics:
        match diagnostic.severity:
            case RtCriticalDiagnosticSeverity.Warning: warnings.push(diagnostic.message)
            case RtCriticalDiagnosticSeverity.Error: errors.push(diagnostic.message)
    DriverHirGateRtReportV1(errors: errors, warnings: warnings)

pub fn driver_print_post_hir_validation_fatal(errors: [text]):
    var shown: i64 = 0
    for error in errors:
        if shown < 10:
            eprint("[post-hir-validation-fatal] {error}")
            shown = shown + 1
    if errors.len() > 0:
        eprint("[post-hir-validation-fatal-count] count={errors.len()} shown={shown}")

# Shared actual prefix. Partial census callers need no body graph at all, and
# must invoke this before collecting or requiring any dereferencing body rows.
pub fn driver_hir_post_validation_layout_census_v1(module_keys: [text],
        layouts: [ValueStructLayoutModuleV1], policy: DriverHirPostValidationPolicyLoadV1,
        dropped: [text], census_total: i64,
        publish_intermediate: bool = true) -> DriverHirPostValidationGateReportV1:
    if publish_intermediate: log_phase("phase3:hir:validate:value_struct_layouts:start")
    val layout = driver_hir_gate_layout_report_v1(module_keys, layouts, policy.layout_cycle_mode)
    var errors = layout.errors
    if publish_intermediate: driver_hir_gate_publish_warnings_v1(layout.warnings)
    val skipped_struct_edges = layout.skipped_struct_edges
    if publish_intermediate: log_phase("phase3:hir:validate:value_struct_layouts:done errors={errors.len()} skipped_struct_edges={skipped_struct_edges}")
    if publish_intermediate: log_phase("phase3:hir:validate:dict_census:start")
    val census = driver_hir_gate_census_report_v1(dropped, census_total)
    if publish_intermediate: log_phase("phase3:hir:validate:dict_census:done dropped={dropped.len()} total={census_total}")
    if publish_intermediate: driver_hir_gate_publish_census_v1(census)
    for error in census.errors: errors.push(error)
    DriverHirPostValidationGateReportV1(errors: errors, warnings: layout.warnings,
        census_messages: census.messages, aspect_errors: [], skipped_struct_edges: skipped_struct_edges,
        layout_cycles_downgraded: layout.layout_cycles_downgraded,
        gates_skipped: census.gates_skipped, weave_claims: [])

fn driver_hir_gate_live_capabilities_equal_v1(expected: [RtBoundCapability]) -> bool:
    val actual = rt_bound_manifest_capabilities()
    if actual.len() != expected.len(): return false
    var index = 0
    while index < expected.len():
        val selected = expected[index]
        val live = actual[index]
        if live.subject_id != selected.subject_id or live.closure_digest != selected.closure_digest or
                live.effect != selected.effect or live.max_units != selected.max_units or
                live.review_id != selected.review_id: return false
        index = index + 1
    true

# publish_intermediate only controls logging. Replay leaves the ambient RT
# manifest untouched. Genuine capture explicitly selects original consumption
# after proving the full live capability rows against its captured policy.
# The engine must perform real claim-major weaving whenever aspect_errors is
# empty and gates_skipped is false, even if earlier gates produced errors.
# Fatal printing belongs AFTER that real rewrite, using the shared printer.
pub fn driver_hir_post_validation_gate_facts_v1(module_keys: [text],
        layouts: [ValueStructLayoutModuleV1], module_ids: [text], identity_index: Dict<text, bool>,
        layer_names: [text], layer_layouts: [LayerEqType], effects: [EffectFunctionFactsV1],
        rt: [RtCriticalFunctionFactsV1], forwards: [JoinPoint],
        policy: DriverHirPostValidationPolicyLoadV1, dropped: [text], census_total: i64,
        publish_intermediate: bool = true,
        consume_original_manifest: bool = false) -> DriverHirPostValidationGateReportV1:
    val prefix = driver_hir_post_validation_layout_census_v1(
        module_keys, layouts, policy, dropped, census_total, publish_intermediate)
    if prefix.gates_skipped: return prefix
    var errors = prefix.errors
    var warnings = prefix.warnings
    if publish_intermediate: log_phase("phase3:hir:validate:layer_eq:start")
    for error in validate_layer_eq_claim_declarations_v1(module_ids, layer_names, layer_layouts, policy.layer):
        errors.push(error)
    if publish_intermediate: log_phase("phase3:hir:validate:layer_eq:done errors={errors.len()}")
    if publish_intermediate: log_phase("phase3:hir:validate:effects:start")
    for error in validate_effect_claim_facts_v1(module_ids, effects, policy.effects): errors.push(error)
    if publish_intermediate: log_phase("phase3:hir:validate:effects:done errors={errors.len()}")
    if publish_intermediate: log_phase("phase3:hir:validate:rt_criticality:start")
    if consume_original_manifest:
        # This is the retained RT gate's consumption point, including the
        # no-claim/no-HAL case. A changed or future grant is never consumed.
        if driver_hir_gate_live_capabilities_equal_v1(policy.capabilities):
            rt_bound_manifest_consume_v1()
        else:
            errors.push("post-HIR original RT capability manifest differs from captured complete policy")
    val rt_report = driver_hir_gate_rt_report_v1(validate_rt_criticality_claim_facts_v1(
        module_ids, rt, policy.capabilities, policy.rt, policy.implicit_rt_error))
    if publish_intermediate: driver_hir_gate_publish_warnings_v1(rt_report.warnings)
    for warning in rt_report.warnings: warnings.push(warning)
    for error in rt_report.errors: errors.push(error)
    if publish_intermediate: log_phase("phase3:hir:validate:rt_criticality:done errors={errors.len()}")
    if publish_intermediate: log_phase("phase3:hir:validate:aspects:start")
    val aspect_errors = validate_aspect_claim_join_points_v1(identity_index, forwards, policy.aspects)
    for error in aspect_errors: errors.push(error)
    if publish_intermediate: log_phase("phase3:hir:validate:aspects:done errors={errors.len()}")
    val claims: [AspectForwardWeaveClaimV1] = if aspect_errors.len() == 0:
        aspect_forward_weave_contract_claims_v1(identity_index, forwards, policy.aspects)
    else: []
    DriverHirPostValidationGateReportV1(errors: errors, warnings: warnings,
        census_messages: prefix.census_messages, aspect_errors: aspect_errors,
        skipped_struct_edges: prefix.skipped_struct_edges, layout_cycles_downgraded: prefix.layout_cycles_downgraded,
        gates_skipped: false, weave_claims: claims)

export DriverHirGateLayoutReportV1, DriverHirGateCensusReportV1, DriverHirGateRtReportV1
export DriverHirPostValidationGateReportV1, driver_hir_post_validation_gate_facts_v1
export driver_hir_post_validation_layout_census_v1
export driver_hir_gate_layout_report_v1, driver_hir_gate_census_report_v1, driver_hir_gate_rt_report_v1
export driver_hir_gate_publish_warnings_v1, driver_hir_gate_publish_census_v1
export driver_print_post_hir_validation_fatal
