# Actual pre-mono collection analysis over complete original archived HIR.
# Persistent results are replay descriptors; no plan expression is promoted.
use compiler.driver.cache.collection_archive_analysis_types_v1.{CollectionArchiveAnalysisV1}
use compiler.driver.cache.hir_body_typecheck_lease_v1.{HirBodyArchiveV1,
    hir_body_archive_load_in_owned_scope_v1}
use compiler.driver.collection_driver_binding_v1.{collection_driver_validate_binding_v1}
use compiler.driver.driver_hir_cache.{hir_cache_enabled, hir_cache_last_warnings,
    hir_cache_promote_diagnostic_owner_v1, hir_cache_clear_last_warnings}
use compiler.semantics.perf_facts.registry.{CollectionRegistryBindingV1,
    collection_registry_parse, collection_registry_bind_modules}
use compiler.semantics.perf_facts.types.{HirPerfReceiverKind, CollectionOperationRegistry}
use compiler.semantics.perf.collection_plan_analysis.{CollectionModuleAnalysisV1,
    analyze_collection_module_v1}
use compiler.hir.hir_types.{HirModule, SymbolId}
use compiler.hir.hir_codec_support.{HirCodecWriter}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause,
    transient_scope_end, transient_promote}

fn collection_archive_receiver_key_v1(receiver: HirPerfReceiverKind) -> text:
    match receiver:
        case HirPerfReceiverKind.Array: "array"
        case HirPerfReceiverKind.Slice: "slice"
        case HirPerfReceiverKind.Dict: "dict"
        case HirPerfReceiverKind.Text: "text"
        case HirPerfReceiverKind.Tuple: "tuple"
        case HirPerfReceiverKind.Named(symbol): "named:{symbol}"
        case HirPerfReceiverKind.Unknown(reason): "unknown:{reason}"

fn collection_archive_input_digest_in_owned_scope_v1(archive: HirBodyArchiveV1,
        source: text, bindings: [CollectionRegistryBindingV1], backend: text) -> text:
    if transient_array_scope_state_v1() != 1: return ""
    var w = HirCodecWriter.create()
    w.put_text(archive.archive_key)
    w.put_text(archive.body_digest)
    w.put_text(archive.lowering_warnings_digest)
    w.put_text(sha256_text(source))
    w.put_text(backend)
    w.put_i64(bindings.len())
    # Binding order is retained exactly; registry admission owns duplicate and
    # ambiguous-symbol refusal. Every field consumed by that owner is sealed.
    for binding in bindings:
        w.put_text(binding.module_path)
        w.put_i64(binding.symbol_id)
        w.put_text(binding.stable_name)
        w.put_text(collection_archive_receiver_key_v1(binding.receiver))
        w.put_text(binding.signature_fingerprint)
        w.put_text(binding.backend)
        w.put_text(binding.evidence_receipt)
        w.put_text(binding.metadata_version)
        w.put_text(binding.source_digest)
    if not w.ok: return ""
    sha256_text("collection-archive-input-v1\n" + w.finish())

fn collection_archive_analyze_in_owned_scope_v1(archive: HirBodyArchiveV1,
        source: text, bindings: [CollectionRegistryBindingV1], backend: text
    ) -> Result<CollectionModuleAnalysisV1, text>:
    if transient_array_scope_state_v1() != 1:
        return Err("collection archive analysis requires active unpaused scope")
    val module = hir_body_archive_load_in_owned_scope_v1(archive, archive.input)?
    collection_archive_analyze_module_in_owned_scope_v1(module, source, bindings, backend)

fn collection_archive_analyze_module_in_owned_scope_v1(module: HirModule,
        source: text, bindings: [CollectionRegistryBindingV1], backend: text
    ) -> Result<CollectionModuleAnalysisV1, text>:
    if transient_array_scope_state_v1() != 1:
        return Err("collection archive analysis requires active unpaused scope")
    val snapshot = collection_registry_parse(source)?
    val registries = collection_registry_bind_modules(snapshot, bindings)?
    for binding in bindings:
        if binding.module_path != module.path: continue
        val _valid = collection_driver_validate_binding_v1(module, binding, backend)?
        if not registries.has(module.path):
            return Err("collection-binding-module-registry-missing")
        val registry = registries[module.path]
        val summary = registry.lookup(binding.symbol_id)
        if not registry.is_structurally_valid() or not summary.?:
            return Err("collection-registry-invalid-at-hir-boundary")
        if summary.unwrap().explicit_argument_count != module.functions[SymbolId(id: binding.symbol_id)].params.len() - 1:
            return Err("collection-binding-typed-arity-mismatch")
    val registry = if registries.has(module.path): registries[module.path] else: CollectionOperationRegistry.new(snapshot.metadata_version)
    Ok(analyze_collection_module_v1(module, registry))

fn collection_archive_capture_in_owned_scope_v1(archive: HirBodyArchiveV1,
        source: text, bindings: [CollectionRegistryBindingV1], backend: text
    ) -> Result<CollectionArchiveAnalysisV1, text>:
    val analysis = collection_archive_analyze_in_owned_scope_v1(archive, source, bindings, backend)?
    val digest = collection_archive_input_digest_in_owned_scope_v1(archive, source, bindings, backend)
    if digest == "": return Err("collection archive input seal unavailable")
    Ok(CollectionArchiveAnalysisV1(archive: archive, registry_source: source,
        bindings: bindings, backend: backend, input_digest: digest,
        plans_found: analysis.plans.len(), findings_found: analysis.findings.len(),
        blockers_found: analysis.blockers.len(), functions_scanned: analysis.facts.functions_scanned,
        nodes_scanned: analysis.facts.nodes_scanned))

fn collection_archive_capture_v1(archive: HirBodyArchiveV1,
        source: text, bindings: [CollectionRegistryBindingV1], backend: text
    ) -> Result<CollectionArchiveAnalysisV1, text>:
    if not hir_cache_enabled() or hir_cache_last_warnings().len() != 0:
        return Err("collection archive cache owner unavailable")
    if not transient_scope_begin(): return Err("collection archive scope unavailable")
    val result = collection_archive_capture_in_owned_scope_v1(archive, source, bindings, backend)
    val paused = transient_scope_pause()
    # The exhaustive escape set has input metadata/scalars, including an Err
    # message. Complete analysis/plans stay scratch-owned and are reclaimed.
    val owned = if paused: transient_promote(result) else: false
    val cache_owned = if paused: hir_cache_promote_diagnostic_owner_v1() else: false
    if paused: hir_cache_clear_last_warnings()
    val ended = transient_scope_end()
    if not paused or not owned or not cache_owned or not ended:
        panic("collection archive capture ownership failed")
    result

fn collection_archive_load_analysis_in_owned_scope_v1(descriptor: CollectionArchiveAnalysisV1
    ) -> Result<CollectionModuleAnalysisV1, text>:
    if transient_array_scope_state_v1() != 1:
        return Err("collection archive replay requires active unpaused scope")
    val digest = collection_archive_input_digest_in_owned_scope_v1(descriptor.archive,
        descriptor.registry_source, descriptor.bindings, descriptor.backend)
    if digest == "" or digest != descriptor.input_digest:
        return Err("collection archive replay input mismatch")
    val analysis = collection_archive_analyze_in_owned_scope_v1(descriptor.archive,
        descriptor.registry_source, descriptor.bindings, descriptor.backend)?
    if analysis.plans.len() != descriptor.plans_found or analysis.findings.len() != descriptor.findings_found or
            analysis.blockers.len() != descriptor.blockers_found or
            analysis.facts.functions_scanned != descriptor.functions_scanned or
            analysis.facts.nodes_scanned != descriptor.nodes_scanned:
        return Err("collection archive replay summary mismatch")
    # Exact original analyzer, not a plan skeleton or inferred callback proof.
    # Caller must consume before close and must never promote this body graph.
    Ok(analysis)

export collection_archive_capture_v1, collection_archive_load_analysis_in_owned_scope_v1
export collection_archive_input_digest_in_owned_scope_v1, collection_archive_analyze_module_in_owned_scope_v1
