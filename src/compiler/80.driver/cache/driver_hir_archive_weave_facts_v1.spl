# One complete HIR per lease; the aggregate keeps only the actual body-free
# declarations/graphs needed by the unchanged post-HIR proof engines. It is
# mechanical input collection, not source/policy or weave admission.
use compiler.driver.cache.hir_body_typecheck_lease_v1.{HirBodyArchiveV1, hir_body_archive_load_in_owned_scope_v1}
use compiler.driver.cache.driver_hir_post_validation_policy_v1.{DriverHirPostValidationPolicyOwnerV1,
    driver_hir_post_validation_policy_load_in_owned_scope_v1}
use compiler.driver.cache.driver_hir_post_validation_fact_lease_v1.{
    DriverHirPostValidationDeclarationsV1, DriverHirPostValidationBodyFactsV1,
    driver_hir_post_validation_declarations_from_module_in_owned_scope_v1,
    driver_hir_post_validation_body_facts_from_module_in_owned_scope_v1}
use compiler.driver.driver_hir_pipeline_support.{driver_hir_module_dict_dropped_values}
use compiler.driver.driver_hir_cache.{hir_cache_last_warnings,
    hir_cache_clear_last_warnings, hir_cache_promote_diagnostic_owner_v1}
use compiler.semantics.rt_criticality_validation.{RtCriticalFunctionDeclarationV1}
use compiler.semantics.layer_eq_validation.{layer_eq_required_claim_declaration_names_v1}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause,
    transient_scope_end, transient_promote}

struct DriverHirArchiveWeaveDeclarationV1:
    row: DriverHirPostValidationDeclarationsV1
    dropped: bool

class DriverHirArchiveWeaveFactsV1:
    declarations: Dict<text, DriverHirArchiveWeaveDeclarationV1> = {}
    bodies: Dict<text, DriverHirPostValidationBodyFactsV1> = {}
    # Mutable indexed maps avoid copying a cumulative array outside leases.
    identities: Dict<text, bool> = {}
    layer_winners: Dict<text, text> = {}
    effect_sizes: Dict<i64, i64> = {}
    effect_names: Dict<i64, text> = {}
    rt_declarations: Dict<i64, RtCriticalFunctionDeclarationV1> = {}
    next_rt_declaration: i64 = 0
    next_join_point: i64 = 1

fn driver_hir_weave_declaration_borrowed_v1(module_key: text, archive: HirBodyArchiveV1,
        policy: DriverHirPostValidationPolicyOwnerV1) -> Result<DriverHirArchiveWeaveDeclarationV1, text>:
    val selected = driver_hir_post_validation_policy_load_in_owned_scope_v1(policy)?
    val module = hir_body_archive_load_in_owned_scope_v1(archive, archive.input)?
    val row = driver_hir_post_validation_declarations_from_module_in_owned_scope_v1(module_key,
        archive, module, selected.effects.len() > 0)?
    val dropped = driver_hir_module_dict_dropped_values({module_key: module}).len() != 0
    Ok(DriverHirArchiveWeaveDeclarationV1(row, dropped))

pub fn driver_hir_weave_declaration_v1(module_key: text, archive: HirBodyArchiveV1,
        policy: DriverHirPostValidationPolicyOwnerV1) -> Result<DriverHirArchiveWeaveDeclarationV1, text>:
    if transient_array_scope_state_v1() != 0 or hir_cache_last_warnings().len() != 0:
        return Err("weave declaration lease or warning owner occupied")
    if not transient_scope_begin(): return Err("weave declaration lease unavailable")
    val result = driver_hir_weave_declaration_borrowed_v1(module_key, archive, policy)
    val paused = transient_scope_pause()
    val owned = if paused: transient_promote(result) else: false
    val memo = if paused: hir_cache_promote_diagnostic_owner_v1() else: false
    if paused: hir_cache_clear_last_warnings()
    val ended = transient_scope_end()
    if not paused or not owned or not memo or not ended: panic("weave declaration ownership failed")
    result

pub fn driver_hir_weave_append_declaration_v1(facts: DriverHirArchiveWeaveFactsV1,
        logical_name: text, declaration: DriverHirArchiveWeaveDeclarationV1) -> Result<bool, text>:
    if transient_array_scope_state_v1() != 0 or logical_name == "" or
            declaration.row.module_key != logical_name or facts.declarations.has(logical_name):
        return Err("weave declaration duplicate or module identity refused")
    facts.declarations[logical_name] = declaration
    for identity in declaration.row.module_identities: facts.identities[identity] = true
    for name in declaration.row.layer_names: facts.layer_winners[name] = logical_name
    for symbol in declaration.row.effect_struct_sizes.keys():
        facts.effect_sizes[symbol] = declaration.row.effect_struct_sizes[symbol]
    for symbol in declaration.row.effect_fn_names.keys():
        facts.effect_names[symbol] = declaration.row.effect_fn_names[symbol]
    for row in declaration.row.rt_declarations:
        facts.rt_declarations[facts.next_rt_declaration] = row
        facts.next_rt_declaration = facts.next_rt_declaration + 1
    Ok(true)

fn driver_hir_weave_body_borrowed_v1(module_key: text, archive: HirBodyArchiveV1,
        policy: DriverHirPostValidationPolicyOwnerV1, facts: DriverHirArchiveWeaveFactsV1
) -> Result<DriverHirPostValidationBodyFactsV1, text>:
    if not facts.declarations.has(module_key): return Err("weave body declaration predecessor absent")
    val selected = driver_hir_post_validation_policy_load_in_owned_scope_v1(policy)?
    val required = layer_eq_required_claim_declaration_names_v1(facts.identities.keys(),
        facts.layer_winners.keys(), selected.layer)
    var selected_names: [text] = []
    for name in required:
        if facts.layer_winners[name] == module_key: selected_names.push(name)
    # This whole-graph input array is scratch, not a new persistent copy on
    # every module. Declaration insertion order is the original logical order.
    var rt_rows: [RtCriticalFunctionDeclarationV1] = []
    var index = 0
    while index < facts.next_rt_declaration:
        rt_rows.push(facts.rt_declarations[index])
        index = index + 1
    val module = hir_body_archive_load_in_owned_scope_v1(archive, archive.input)?
    driver_hir_post_validation_body_facts_from_module_in_owned_scope_v1(module_key, archive,
        module, selected_names, facts.effect_sizes, facts.effect_names, rt_rows,
        facts.next_join_point, selected.effects.len() > 0, selected.aspects.len() > 0, selected.rt.len() > 0)

pub fn driver_hir_weave_body_v1(module_key: text, archive: HirBodyArchiveV1,
        policy: DriverHirPostValidationPolicyOwnerV1, facts: DriverHirArchiveWeaveFactsV1
) -> Result<DriverHirPostValidationBodyFactsV1, text>:
    if transient_array_scope_state_v1() != 0 or hir_cache_last_warnings().len() != 0:
        return Err("weave body lease or warning owner occupied")
    if not transient_scope_begin(): return Err("weave body lease unavailable")
    val result = driver_hir_weave_body_borrowed_v1(module_key, archive, policy, facts)
    val paused = transient_scope_pause()
    val owned = if paused: transient_promote(result) else: false
    val memo = if paused: hir_cache_promote_diagnostic_owner_v1() else: false
    if paused: hir_cache_clear_last_warnings()
    val ended = transient_scope_end()
    if not paused or not owned or not memo or not ended: panic("weave body ownership failed")
    result

pub fn driver_hir_weave_append_body_v1(facts: DriverHirArchiveWeaveFactsV1,
        logical_name: text, body: DriverHirPostValidationBodyFactsV1) -> Result<bool, text>:
    if transient_array_scope_state_v1() != 0 or not facts.declarations.has(logical_name) or
            facts.bodies.has(logical_name): return Err("weave body duplicate or predecessor absent")
    val declaration = facts.declarations[logical_name].row
    if body.module_key != logical_name or body.archive_key != declaration.archive_key or
            body.body_digest != declaration.body_digest or body.first_join_point_id != facts.next_join_point or
            body.lowering_warnings != declaration.lowering_warnings:
        return Err("weave body exact declaration or warning predecessor differs")
    facts.bodies[logical_name] = body
    facts.next_join_point = facts.next_join_point + body.forwards.len()
    Ok(true)

export DriverHirArchiveWeaveDeclarationV1, DriverHirArchiveWeaveFactsV1
export driver_hir_weave_declaration_v1, driver_hir_weave_append_declaration_v1
export driver_hir_weave_body_v1, driver_hir_weave_append_body_v1
