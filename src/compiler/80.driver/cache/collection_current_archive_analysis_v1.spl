# Actual collection analysis of complete configured current HIR, before mono.
# The replay descriptor is mechanical metadata, never final driver admission.
use compiler.driver.cache.collection_current_archive_analysis_types_v1.{CollectionCurrentArchiveAnalysisV1}
use compiler.mono.mono_archive_body_input_v1.{MonoArchiveBodyInputV1,
    mono_archive_body_input_matches_v1, mono_archive_body_input_key_v1,
    mono_archive_body_input_digest_v1, mono_archive_body_input_warnings_digest_v1,
    mono_archive_body_input_module_name_v1, mono_archive_body_input_load_in_owned_scope_v1}
use compiler.driver.cache.collection_archive_analysis_v1.{
    collection_archive_input_digest_in_owned_scope_v1,
    collection_archive_analyze_module_in_owned_scope_v1}
use compiler.driver.driver_hir_cache.{hir_cache_enabled, hir_cache_last_warnings,
    hir_cache_promote_diagnostic_owner_v1, hir_cache_clear_last_warnings}
use compiler.semantics.perf_facts.registry.{CollectionRegistryBindingV1}
use compiler.semantics.perf_facts.types.{CollectionOperationRegistry}
use compiler.driver.collection_driver_binding_v1.{collection_driver_validate_binding_v1}
use compiler.hir.hir_types.{SymbolId}
use compiler.semantics.perf.collection_plan_analysis.{CollectionModuleAnalysisV1}
use compiler.hir.hir_codec_support.{HirCodecWriter}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause,
    transient_scope_end, transient_promote}

fn collection_current_archive_input_digest_in_owned_scope_v1(input: MonoArchiveBodyInputV1,
        source: text, bindings: [CollectionRegistryBindingV1], backend: text) -> text:
    if transient_array_scope_state_v1() != 1 or not mono_archive_body_input_matches_v1(input) or
            input.current_body == nil or input.current_cache == nil: return ""
    val parent = collection_archive_input_digest_in_owned_scope_v1(input.original_parent,
        source, bindings, backend)
    if parent == "": return ""
    val cache = input.current_cache!
    var writer = HirCodecWriter.create()
    writer.put_text("collection-current-archive-input-v1")
    writer.put_text(parent)
    writer.put_text(mono_archive_body_input_module_name_v1(input))
    writer.put_text(mono_archive_body_input_key_v1(input))
    writer.put_text(mono_archive_body_input_digest_v1(input))
    writer.put_text(mono_archive_body_input_warnings_digest_v1(input))
    writer.put_text(cache.directory)
    writer.put_text(cache.producer_header)
    writer.put_bool(cache.enabled)
    if not writer.ok: return ""
    sha256_text(writer.finish())

fn collection_current_archive_analyze_in_owned_scope_v1(input: MonoArchiveBodyInputV1,
        source: text, bindings: [CollectionRegistryBindingV1], backend: text
    ) -> Result<CollectionModuleAnalysisV1, text>:
    if transient_array_scope_state_v1() != 1 or input.current_body == nil or input.current_cache == nil:
        return Err("collection current analysis requires complete current input and active scope")
    val loaded = mono_archive_body_input_load_in_owned_scope_v1(input)?
    # The same validator, registry admission, typed arity and full analyzer as
    # retained/original HIR. The logical key never renames the physical body.
    collection_archive_analyze_module_in_owned_scope_v1(loaded.module, source, bindings, backend)

fn collection_current_archive_capture_in_owned_scope_v1(input: MonoArchiveBodyInputV1,
        source: text, bindings: [CollectionRegistryBindingV1], backend: text
    ) -> Result<CollectionCurrentArchiveAnalysisV1, text>:
    val analysis = collection_current_archive_analyze_in_owned_scope_v1(input, source, bindings, backend)?
    val digest = collection_current_archive_input_digest_in_owned_scope_v1(input, source, bindings, backend)
    if digest == "": return Err("collection current input seal unavailable")
    Ok(CollectionCurrentArchiveAnalysisV1(input: input, registry_source: source,
        bindings: bindings, backend: backend, input_digest: digest,
        plans_found: analysis.plans.len(), findings_found: analysis.findings.len(),
        blockers_found: analysis.blockers.len(), functions_scanned: analysis.facts.functions_scanned,
        nodes_scanned: analysis.facts.nodes_scanned))

pub fn collection_current_archive_capture_v1(input: MonoArchiveBodyInputV1,
        source: text, bindings: [CollectionRegistryBindingV1], backend: text
    ) -> Result<CollectionCurrentArchiveAnalysisV1, text>:
    if transient_array_scope_state_v1() != 0 or not hir_cache_enabled() or hir_cache_last_warnings().len() != 0:
        return Err("collection current archive cache or lease owner unavailable")
    if not transient_scope_begin(): return Err("collection current archive scope unavailable")
    val result = collection_current_archive_capture_in_owned_scope_v1(input, source, bindings, backend)
    val paused = transient_scope_pause()
    # Only the fresh compact Result and diagnostic memo escape. Analyzer
    # expressions, complete plans, loaded warnings and HIR remain scratch.
    val owned = if paused: transient_promote(result) else: false
    val cache_owned = if paused: hir_cache_promote_diagnostic_owner_v1() else: false
    if paused: hir_cache_clear_last_warnings()
    val ended = transient_scope_end()
    if not paused or not owned or not cache_owned or not ended:
        panic("collection current archive capture ownership failed")
    result

pub fn collection_current_archive_load_analysis_in_owned_scope_v1(descriptor: CollectionCurrentArchiveAnalysisV1
    ) -> Result<CollectionModuleAnalysisV1, text>:
    if transient_array_scope_state_v1() != 1:
        return Err("collection current replay requires active unpaused scope")
    val digest = collection_current_archive_input_digest_in_owned_scope_v1(descriptor.input,
        descriptor.registry_source, descriptor.bindings, descriptor.backend)
    if digest == "" or digest != descriptor.input_digest:
        return Err("collection current replay input mismatch")
    val analysis = collection_current_archive_analyze_in_owned_scope_v1(descriptor.input,
        descriptor.registry_source, descriptor.bindings, descriptor.backend)?
    if analysis.plans.len() != descriptor.plans_found or analysis.findings.len() != descriptor.findings_found or
            analysis.blockers.len() != descriptor.blockers_found or
            analysis.facts.functions_scanned != descriptor.functions_scanned or
            analysis.facts.nodes_scanned != descriptor.nodes_scanned:
        return Err("collection current replay summary mismatch")
    # Consume this full analysis before close; never promote its plans.
    Ok(analysis)

fn collection_current_binding_borrowed_v1(input: MonoArchiveBodyInputV1,
        binding: CollectionRegistryBindingV1, registries: Dict<text, CollectionOperationRegistry>, backend: text
    ) -> Result<bool, text>:
    if transient_array_scope_state_v1() != 1 or input.current_body == nil or input.current_cache == nil:
        return Err("collection current binding requires complete current input and active scope")
    val loaded = mono_archive_body_input_load_in_owned_scope_v1(input)?
    val module = loaded.module
    val validated = collection_driver_validate_binding_v1(module, binding, backend)?
    if not registries.has(binding.module_path): return Err("collection-binding-module-registry-missing")
    val registry = registries[binding.module_path]
    val summary = registry.lookup(binding.symbol_id)
    if not registry.is_structurally_valid() or not summary.?: return Err("collection-registry-invalid-at-hir-boundary")
    if summary.unwrap().explicit_argument_count != module.functions[SymbolId(id: binding.symbol_id)].params.len() - 1:
        return Err("collection-binding-typed-arity-mismatch")
    Ok(true)

pub fn collection_current_archive_validate_binding_v1(input: MonoArchiveBodyInputV1,
        binding: CollectionRegistryBindingV1, registries: Dict<text, CollectionOperationRegistry>, backend: text
    ) -> Result<bool, text>:
    if transient_array_scope_state_v1() != 0 or not hir_cache_enabled() or hir_cache_last_warnings().len() != 0:
        return Err("collection current binding cache or lease owner unavailable")
    if not transient_scope_begin(): return Err("collection current binding scope unavailable")
    val result = collection_current_binding_borrowed_v1(input, binding, registries, backend)
    val paused = transient_scope_pause()
    val owned = if paused: transient_promote(result) else: false
    val cache_owned = if paused: hir_cache_promote_diagnostic_owner_v1() else: false
    if paused: hir_cache_clear_last_warnings()
    val ended = transient_scope_end()
    if not paused or not owned or not cache_owned or not ended: panic("collection current binding ownership failed")
    result

export CollectionCurrentArchiveAnalysisV1, collection_current_archive_capture_v1
export collection_current_archive_load_analysis_in_owned_scope_v1
export collection_current_archive_validate_binding_v1
