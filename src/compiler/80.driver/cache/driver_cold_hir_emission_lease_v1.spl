# Complete live-body SMF emission and native witness capture. The borrowed
# variant shares its caller's actual decode lease; the retained wrapper owns
# only emission scratch and never promotes the input HIR body.
use compiler.hir.hir_types.{HirModule}
use compiler.driver.smf.runtime_std_hir_emission_v1.{runtime_std_hir_emit_module_v1}
use compiler.driver.smf.runtime_std_hir_emission_types_v1.{RuntimeStdHirModuleEmissionV1}
use compiler.driver.smf.runtime_std_native_emit_witness_v1.{runtime_std_native_emit_witness_from_live_hir_v1}
use compiler.driver.driver_hir_cache.{hir_cache_promote_diagnostic_owner_v1}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause,
    transient_scope_end, transient_promote}

struct DriverColdHirEmissionFailureV1:
    kind: text
    reason: text

pub fn driver_cold_hir_emit_in_owned_scope_v1(module: HirModule, module_identity: text,
        source_identity: text, source_digest: text, artifact_root: text,
        target_triple: text, backend: text
) -> Result<RuntimeStdHirModuleEmissionV1, DriverColdHirEmissionFailureV1>:
    if transient_array_scope_state_v1() != 1:
        return Err(DriverColdHirEmissionFailureV1(kind: "ownership", reason: "cold HIR emission requires active unpaused ownership"))
    val emitted = runtime_std_hir_emit_module_v1(module, source_identity, source_digest, artifact_root)
    if emitted.is_err():
        return Err(DriverColdHirEmissionFailureV1(kind: "emission", reason: emitted.unwrap_err()))
    val value = emitted.unwrap()
    if value.module_identity != module_identity:
        return Err(DriverColdHirEmissionFailureV1(kind: "owner", reason: "cold HIR typed emission module identity changed"))
    val witness = runtime_std_native_emit_witness_from_live_hir_v1(module,
        value.semantic_payloads, source_identity, source_digest, module_identity, target_triple, backend)
    if witness.is_err():
        return Err(DriverColdHirEmissionFailureV1(kind: "witness", reason: witness.unwrap_err()))
    var witnessed = value
    witnessed.native_emit_witness = Some(witness.unwrap())
    Ok(witnessed)

pub fn driver_cold_hir_emit_v1(module: HirModule, module_identity: text,
        source_identity: text, source_digest: text, artifact_root: text,
        target_triple: text, backend: text
) -> Result<RuntimeStdHirModuleEmissionV1, DriverColdHirEmissionFailureV1>:
    if transient_array_scope_state_v1() != 0:
        return Err(DriverColdHirEmissionFailureV1(kind: "ownership", reason: "cold HIR emission lease occupied"))
    if not transient_scope_begin():
        return Err(DriverColdHirEmissionFailureV1(kind: "ownership", reason: "cold HIR emission lease unavailable"))
    val result = driver_cold_hir_emit_in_owned_scope_v1(module, module_identity,
        source_identity, source_digest, artifact_root, target_triple, backend)
    val paused = transient_scope_pause()
    val cache_owned = if paused: hir_cache_promote_diagnostic_owner_v1() else: false
    val owned = if paused: transient_promote(result) else: false
    # This emitter does not decode/load HIR cache entries. Preserve the earlier
    # retained cache-warning alias exactly; warm lowering may leave it nonempty.
    val ended = transient_scope_end()
    if not paused or not cache_owned or not owned or not ended:
        panic("cold HIR emission ownership failed")
    result

export DriverColdHirEmissionFailureV1, driver_cold_hir_emit_in_owned_scope_v1, driver_cold_hir_emit_v1
