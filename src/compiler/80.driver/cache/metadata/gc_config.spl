# GC configuration — storage limits, watermarks, retention (design §18.2, §18.6)
#
# Agent C3 (quota / metadata / leases / GC), Semantic Incremental Build v2.
# Schema:  src/compiler/80.driver/cache/schema/cache_protocol.sdn  (gc.limits, gc.retention)
# Design:  doc/05_design/compiler/semantic_incremental_build_cache_aop_formal_2026-08-09.md §18
#
# Ratios are expressed in PER MILLE as i64 (900 = 0.90), never as floats:
# watermark comparisons must be exactly reproducible across engines, and the
# interpreter/JIT/native float paths are not trustworthy enough to gate deletion
# on. All arithmetic here is integer.
#
# HYSTERESIS IS MANDATORY. GC starts at the high watermark and stops at the LOW
# watermark, not at the high one. Stopping at the high watermark makes every
# subsequent write re-trigger a micro-cleanup (thrash). `gc_limits_validate`
# rejects a config where low >= high.
#
# ADMISSION NEVER FAILS A BUILD. `gc_admit` returns a decision; a REJECT means
# "do not write to the cache", i.e. degrade to a miss. It never means "fail".

# ---------------------------------------------------------------------------
# Admission decisions (i64 codes rather than an enum: `match` on an enum has no
# native lowering today, and this value is read on the write path.)
# ---------------------------------------------------------------------------
val GC_ADMIT_ACCEPT: i64 = 0          # room available, write it
val GC_ADMIT_GC_THEN_ACCEPT: i64 = 1  # above high watermark: run fast GC, then write
val GC_ADMIT_REJECT: i64 = 2          # above hard limit or below free reserve: skip the write

fn gc_admission_name(code: i64) -> text:
    if code == GC_ADMIT_ACCEPT:
        return "accept"
    if code == GC_ADMIT_GC_THEN_ACCEPT:
        return "gc_then_accept"
    if code == GC_ADMIT_REJECT:
        return "reject"
    "unknown"

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------

struct GcLimits:
    """Storage quota for one cache tier (workspace or machine)."""
    max_bytes: i64                  # configured maximum accounted size
    high_watermark_permille: i64    # start GC at/above this fraction of max
    low_watermark_permille: i64     # stop GC at/below this fraction of max
    hard_limit_permille: i64        # reject writes at/above this fraction of max
    min_free_bytes: i64             # absolute filesystem free-space reserve
    min_free_permille: i64          # relative reserve, of filesystem TOTAL bytes

struct GcRetention:
    """Time/generation retention policy (schema gc.retention)."""
    main_generations: i64
    bootstrap_generations: i64
    branch_ttl_seconds: i64
    quarantine_seconds: i64
    tmp_seconds: i64

val GC_SECONDS_PER_HOUR: i64 = 3600
val GC_SECONDS_PER_DAY: i64 = 86400

# Schema defaults: 0.90 / 0.75 / 1.05, min_free_ratio 0.05.
fn gc_limits_default(max_bytes: i64) -> GcLimits:
    GcLimits(
        max_bytes: max_bytes,
        high_watermark_permille: 900,
        low_watermark_permille: 750,
        hard_limit_permille: 1050,
        min_free_bytes: 512 * 1024 * 1024,
        min_free_permille: 50,
    )

fn gc_retention_default() -> GcRetention:
    GcRetention(
        main_generations: 8,
        bootstrap_generations: 3,
        branch_ttl_seconds: 7 * GC_SECONDS_PER_DAY,
        quarantine_seconds: 7 * GC_SECONDS_PER_DAY,
        tmp_seconds: 24 * GC_SECONDS_PER_HOUR,
    )

# Config errors, empty when the config is usable. A config that fails this must
# be replaced by `gc_limits_default` — never silently "fixed" in place, because
# a silently-widened limit deletes more than the operator asked for.
fn gc_limits_validate(limits: GcLimits) -> [text]:
    var errs: [text] = []
    if limits.max_bytes <= 0:
        errs = errs.push("max_bytes must be positive")
    if limits.high_watermark_permille <= 0 or limits.high_watermark_permille > 1000:
        errs = errs.push("high_watermark_permille must be in 1..1000")
    if limits.low_watermark_permille <= 0:
        errs = errs.push("low_watermark_permille must be positive")
    if limits.low_watermark_permille >= limits.high_watermark_permille:
        errs = errs.push("low_watermark must be strictly below high_watermark (hysteresis)")
    if limits.hard_limit_permille < limits.high_watermark_permille:
        errs = errs.push("hard_limit must be at or above high_watermark")
    if limits.min_free_bytes < 0:
        errs = errs.push("min_free_bytes must not be negative")
    if limits.min_free_permille < 0 or limits.min_free_permille > 1000:
        errs = errs.push("min_free_permille must be in 0..1000")
    errs

fn gc_scale_permille(value: i64, permille: i64) -> i64:
    (value / 1000) * permille + ((value % 1000) * permille) / 1000

fn gc_high_watermark_bytes(limits: GcLimits) -> i64:
    gc_scale_permille(value: limits.max_bytes, permille: limits.high_watermark_permille)

fn gc_low_watermark_bytes(limits: GcLimits) -> i64:
    gc_scale_permille(value: limits.max_bytes, permille: limits.low_watermark_permille)

fn gc_hard_limit_bytes(limits: GcLimits) -> i64:
    gc_scale_permille(value: limits.max_bytes, permille: limits.hard_limit_permille)

# The free-space reserve is the LARGER of the absolute and the relative rule:
# a huge filesystem needs the ratio, a small one needs the absolute floor.
fn gc_min_free_required(limits: GcLimits, fs_total_bytes: i64) -> i64:
    val relative = gc_scale_permille(value: fs_total_bytes, permille: limits.min_free_permille)
    if relative > limits.min_free_bytes:
        return relative
    limits.min_free_bytes

# ---------------------------------------------------------------------------
# Hysteresis
# ---------------------------------------------------------------------------

fn gc_should_start(limits: GcLimits, used_bytes: i64) -> bool:
    used_bytes >= gc_high_watermark_bytes(limits)

# GC stops only once it is at/below the LOW watermark. Callers loop while this
# is false; that is the whole anti-thrash mechanism.
fn gc_should_stop(limits: GcLimits, used_bytes: i64) -> bool:
    used_bytes <= gc_low_watermark_bytes(limits)

# Bytes fast GC should aim to free to reach the low watermark from `used_bytes`.
fn gc_bytes_to_free(limits: GcLimits, used_bytes: i64) -> i64:
    val low = gc_low_watermark_bytes(limits)
    if used_bytes <= low:
        return 0
    used_bytes - low

# ---------------------------------------------------------------------------
# Admission (design §18.6)
# ---------------------------------------------------------------------------

# Decide whether `incoming_bytes` may be admitted. Emergency free-space pressure
# outranks the accounted-size rule: the cache must never fill the filesystem
# even when its own accounting says it is below max.
fn gc_admit(limits: GcLimits, used_bytes: i64, incoming_bytes: i64,
            fs_free_bytes: i64, fs_total_bytes: i64) -> i64:
    val projected = used_bytes + incoming_bytes
    val free_after = fs_free_bytes - incoming_bytes
    val reserve = gc_min_free_required(limits, fs_total_bytes)
    if free_after < reserve:
        return GC_ADMIT_REJECT
    if projected >= gc_hard_limit_bytes(limits):
        return GC_ADMIT_REJECT
    if projected >= gc_high_watermark_bytes(limits):
        return GC_ADMIT_GC_THEN_ACCEPT
    GC_ADMIT_ACCEPT

# ---------------------------------------------------------------------------
# Rate-limited diagnostic (design §18.6 step 6): ONE message per window.
# ---------------------------------------------------------------------------

struct GcDiagnosticGate:
    """State for the single rate-limited storage-pressure diagnostic."""
    last_emitted_at: i64
    window_seconds: i64
    suppressed_count: i64

fn gc_diagnostic_gate_new(window_seconds: i64) -> GcDiagnosticGate:
    GcDiagnosticGate(last_emitted_at: 0, window_seconds: window_seconds, suppressed_count: 0)

fn gc_diagnostic_should_emit(gate: GcDiagnosticGate, now: i64) -> bool:
    if gate.last_emitted_at == 0:
        return true
    now - gate.last_emitted_at >= gate.window_seconds

fn gc_diagnostic_record(gate: GcDiagnosticGate, now: i64) -> GcDiagnosticGate:
    if gc_diagnostic_should_emit(gate, now):
        return GcDiagnosticGate(last_emitted_at: now,
                                window_seconds: gate.window_seconds,
                                suppressed_count: 0)
    GcDiagnosticGate(last_emitted_at: gate.last_emitted_at,
                     window_seconds: gate.window_seconds,
                     suppressed_count: gate.suppressed_count + 1)

fn gc_admission_diagnostic(code: i64, used_bytes: i64, limits: GcLimits) -> text:
    if code != GC_ADMIT_REJECT:
        return ""
    "cache: write skipped (storage pressure) — used={used_bytes} B, max={limits.max_bytes} B, hard_limit={gc_hard_limit_bytes(limits)} B; build continues uncached"
