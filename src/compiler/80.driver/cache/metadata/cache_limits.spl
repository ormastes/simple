# Cache limits — storage quota configuration (machine-local, first milestone)
#
# Schema: src/compiler/80.driver/cache/schema/cache_protocol.sdn `gc.limits.machine`
# Design: doc/05_design/compiler/semantic_incremental_build_cache_aop_formal_2026-08-09.md §18
#
# Defaults mirror the frozen schema's starting points (`gc.limits.machine`,
# `gc.limits.retention`). Loadable from an sdn config block; any field absent
# from the block keeps its default.

extern fn rt_env_get(key: text) -> text

val DEFAULT_MAX_BYTES: i64 = 10737418240          # 10 GiB
val DEFAULT_HIGH_WATERMARK: f64 = 0.90
val DEFAULT_LOW_WATERMARK: f64 = 0.75
val DEFAULT_MIN_FREE_RATIO: f64 = 0.05
val DEFAULT_HARD_LIMIT_RATIO: f64 = 1.05
val DEFAULT_TMP_HOURS: i64 = 24
val DEFAULT_QUARANTINE_DAYS: i64 = 7

struct CacheLimits:
    max_bytes: i64
    high_watermark: f64
    low_watermark: f64
    min_free_ratio: f64
    hard_limit_ratio: f64
    tmp_hours: i64
    quarantine_days: i64

fn cache_limits_default() -> CacheLimits:
    CacheLimits(
        max_bytes: DEFAULT_MAX_BYTES,
        high_watermark: DEFAULT_HIGH_WATERMARK,
        low_watermark: DEFAULT_LOW_WATERMARK,
        min_free_ratio: DEFAULT_MIN_FREE_RATIO,
        hard_limit_ratio: DEFAULT_HARD_LIMIT_RATIO,
        tmp_hours: DEFAULT_TMP_HOURS,
        quarantine_days: DEFAULT_QUARANTINE_DAYS,
    )

# `SIMPLE_CACHE_MAX_BYTES` is the only env override in this first milestone;
# a full sdn config block loader is deferred until a caller needs it (no
# caller reads gc.limits from an sdn block today).
fn cache_limits_load() -> CacheLimits:
    var limits = cache_limits_default()
    val env_max = rt_env_get("SIMPLE_CACHE_MAX_BYTES") ?? ""
    if env_max != "":
        val parsed = env_max.trim().to_i64()
        match parsed:
            case Some(v):
                if v > 0:
                    limits = CacheLimits(
                        max_bytes: v,
                        high_watermark: limits.high_watermark,
                        low_watermark: limits.low_watermark,
                        min_free_ratio: limits.min_free_ratio,
                        hard_limit_ratio: limits.hard_limit_ratio,
                        tmp_hours: limits.tmp_hours,
                        quarantine_days: limits.quarantine_days,
                    )
            case nil:
                pass_do_nothing
    limits

fn cache_limits_high_watermark_bytes(limits: CacheLimits) -> i64:
    (limits.max_bytes.to_f64() * limits.high_watermark).to_i64()

fn cache_limits_low_watermark_bytes(limits: CacheLimits) -> i64:
    (limits.max_bytes.to_f64() * limits.low_watermark).to_i64()

fn cache_limits_hard_limit_bytes(limits: CacheLimits) -> i64:
    (limits.max_bytes.to_f64() * limits.hard_limit_ratio).to_i64()

fn cache_limits_min_free_bytes(limits: CacheLimits) -> i64:
    (limits.max_bytes.to_f64() * limits.min_free_ratio).to_i64()
