# Driver-owned M2 authority admission and M3 frontend materialization.

use std.io_runtime.{env_get_opt}
use std.common.crypto.sha256.{sha256_text}
use compiler.common.cache.frontend_parse_identity_v2.{frontend_parse_identity_valid_v2}
use compiler.common.cache.reverse_reference_key.{ReverseReferenceKeyV1, reverse_reference_key_encode_v1}
use compiler.common.cache.phase_compatibility_manifest.{PhaseCompatibilityItemV1}
use compiler.common.cache.reverse_reference_facts.{reverse_reference_fact_digest_v1}
use compiler.common.cache.reverse_reference_key.{reverse_reference_key_decode_v1}
use compiler.common.cache.phase_compatibility_manifest.{
    PHASE_COMPATIBILITY_FRONTEND_V1,
    PHASE_COMPATIBILITY_PRODUCER_NEUTRAL_V1,
    PhaseCompatibilityManifestDecodeV1,
    PhaseCompatibilityExpectationV1,
    phase_compatibility_manifest_decode_v1,
    phase_compatibility_admit_v1
}
use compiler.common.cache.phase_compatibility_path_io.{
    phase_compatibility_canonical_directory_io_v1,
    phase_compatibility_existing_artifact_io_v1,
    phase_compatibility_destination_io_v1,
    phase_compatibility_read_manifest_io_v1,
    phase_compatibility_read_artifact_io_v1
}
use compiler.driver.cache.reverse_reference_receipt.{
    reverse_reference_bind_admitted_published_keys_v1
}
use compiler.frontend.frontend_parse_cache.{
    FRONTEND_CACHE_ENTRY_VERSION,
    frontend_parse_cache_record_header_valid_v2,
    frontend_parse_cache_dir,
    frontend_parse_cache_store_phase3_immutable_v1
}
use compiler.frontend.core.flat_pool_codec.{FLAT_POOL_CODEC_VERSION}

fn driver_phase_compatibility_reject_v1(
    reason: text
) -> PhaseCompatibilityManifestDecodeV1:
    PhaseCompatibilityManifestDecodeV1(false, reason, nil)

fn driver_admit_phase2_compatibility_manifest_v1(
    manifest_path: text,
    expected_phase3_root: text
) -> PhaseCompatibilityManifestDecodeV1:
    val manifest_read = phase_compatibility_read_manifest_io_v1(manifest_path)
    if not manifest_read.valid:
        return driver_phase_compatibility_reject_v1(manifest_read.reason)
    val decoded = phase_compatibility_manifest_decode_v1(manifest_read.content)
    if not decoded.valid or decoded.manifest == nil:
        return decoded
    val manifest = decoded.manifest.unwrap()
    val phase2 = phase_compatibility_canonical_directory_io_v1(
        manifest.phase2_cache_root)
    if not phase2.valid:
        return driver_phase_compatibility_reject_v1(
            "phase2-" + phase2.reason)
    val phase3 = phase_compatibility_canonical_directory_io_v1(
        expected_phase3_root)
    if not phase3.valid or manifest.phase3_cache_root != phase3.canonical_root:
        return driver_phase_compatibility_reject_v1("wrong-phase3-cache-root")
    if phase2.canonical_root == phase3.canonical_root:
        return driver_phase_compatibility_reject_v1("shared-writable-cache")
    val cache = phase_compatibility_existing_artifact_io_v1(
        phase2.canonical_root, manifest.m2_cache_path)
    if not cache.valid:
        return driver_phase_compatibility_reject_v1(
            "m2-cache-" + cache.reason)
    var key_frames: [text] = []
    var consumers: [text] = []
    for item in manifest.items:
        key_frames = key_frames.push(item.key_frame)
        consumers = consumers.push(item.m2_consumer_identity)
    val binding = reverse_reference_bind_admitted_published_keys_v1(
        phase2.canonical_root, cache.canonical_path,
        manifest.m2_receipt_digest, manifest.m2_owner_generation,
        manifest.m2_root_generation, key_frames, consumers)
    if binding != "ok":
        return driver_phase_compatibility_reject_v1(binding)
    PhaseCompatibilityManifestDecodeV1(true, "ok", Some(manifest))

fn driver_import_phase2_frontend_v2(frozen_raw_by_path: {text: text}) -> text:
    val manifest_path = env_get_opt(
        "SIMPLE_PHASE2_COMPATIBILITY_MANIFEST_READ") ?? ""
    if manifest_path == "":
        return "disabled"
    val expected_phase3_root = env_get_opt(
        "SIMPLE_PHASE3_COMPATIBILITY_CACHE_ROOT") ?? ""
    val admitted = driver_admit_phase2_compatibility_manifest_v1(
        manifest_path, expected_phase3_root)
    if not admitted.valid or admitted.manifest == nil:
        return "manifest-rejected:" + admitted.reason
    val manifest = admitted.manifest.unwrap()
    val phase3_frontend_root = frontend_parse_cache_dir()
    val phase3_destination = phase_compatibility_destination_io_v1(
        manifest.phase3_cache_root,
        phase3_frontend_root + "/m3-admission-probe")
    if not phase3_destination.valid:
        return "manifest-rejected:phase3-frontend-cache-outside-root"
    val provider = FRONTEND_CACHE_ENTRY_VERSION + ":" + FLAT_POOL_CODEC_VERSION
    var reused: i64 = 0
    var rejected: i64 = 0
    for item in manifest.items:
        if item.kind != PHASE_COMPATIBILITY_FRONTEND_V1:
            continue
        val decoded = reverse_reference_key_decode_v1(item.key_frame)
        if not decoded.valid or decoded.key == nil:
            print "[M3] reject frontend reason=corrupt-key path={item.artifact_path}"
            rejected = rejected + 1
            continue
        val key = decoded.key.unwrap()
        val artifact_name = item.artifact_path.substring(
            item.artifact_path.last_index_of("/") + 1, item.artifact_path.len())
        if not artifact_name.ends_with(".fpc"):
            print "[M3] reject frontend reason=wrong-artifact-name path={item.artifact_path}"
            rejected = rejected + 1
            continue
        val frontend_key = artifact_name.substring(0, artifact_name.len() - 4)
        if key.registry_kind != "semantic" or
                key.owner_generation != manifest.m2_owner_generation or
                key.root_generation != manifest.m2_root_generation or
                key.subject_identity != item.m2_consumer_identity or
                key.projection_kind != "frontend-parser-input-v2" or
                frontend_key.len() != 64:
            print "[M3] reject frontend reason=wrong-key-binding path={item.artifact_path}"
            rejected = rejected + 1
            continue
        val artifact = phase_compatibility_read_artifact_io_v1(
            manifest.phase2_cache_root, item.artifact_path)
        if not artifact.valid:
            print "[M3] reject frontend reason={artifact.reason} path={item.artifact_path}"
            rejected = rejected + 1
            continue
        if not frontend_parse_cache_record_header_valid_v2(artifact.content):
            rejected = rejected + 1
            continue
        val header_end = artifact.content.index_of("\n")
        if header_end < 0 or header_end + 1 >= artifact.content.len():
            rejected = rejected + 1
            continue
        val payload = artifact.content.substring(header_end + 1, artifact.content.len())
        val identity_end = payload.index_of("\n")
        if identity_end < 0 or identity_end + 1 >= payload.len():
            rejected = rejected + 1
            continue
        val content_identity = payload.substring(0, identity_end)
        val identity = item.frontend_binding_frame_v2
        if item.schema_version != 2 or
                not frontend_parse_identity_valid_v2(content_identity, frontend_key, false) or
                not frontend_parse_identity_valid_v2(identity, frontend_key, true):
            rejected = rejected + 1
            continue
        val identity_fields = identity.split("|")
        if (frozen_raw_by_path[key.subject_identity] ?? "") != identity_fields[3] or
                key.projection_digest != reverse_reference_fact_digest_v1(
                    "frontend-parser-input-v2", key.subject_identity,
                    item.m2_consumer_identity, identity + "|" +
                        sha256_text(payload.substring(identity_end + 1, payload.len())) + "|" +
                        sha256_text(artifact.content.substring(0, header_end))):
            rejected = rejected + 1
            continue
        val expectation = PhaseCompatibilityExpectationV1(
            PHASE_COMPATIBILITY_FRONTEND_V1, decoded.digest,
            manifest.m2_receipt_digest, manifest.m2_owner_generation,
            manifest.m2_root_generation,
            PHASE_COMPATIBILITY_PRODUCER_NEUTRAL_V1,
            provider, "target-neutral", 2)
        val decision = phase_compatibility_admit_v1(
            manifest, expectation, sha256_text(artifact.content))
        if not decision.reused:
            print "[M3] reject frontend reason={decision.reason} path={item.artifact_path}"
            rejected = rejected + 1
            continue
        val nl = artifact.content.index_of("\n")
        if nl < 0 or nl + 1 >= artifact.content.len():
            print "[M3] reject frontend reason=corrupt-frontend-record path={item.artifact_path}"
            rejected = rejected + 1
            continue
        val phase3_final = phase3_frontend_root + "/" + frontend_key + ".fpc"
        val final_admission = phase_compatibility_destination_io_v1(
            manifest.phase3_cache_root, phase3_final)
        if not final_admission.valid:
            print "[M3] reject frontend reason={final_admission.reason} path={item.artifact_path}"
            rejected = rejected + 1
            continue
        if not frontend_parse_cache_store_phase3_immutable_v1(
                frontend_key,
                artifact.content.substring(nl + 1, artifact.content.len())):
            print "[M3] reject frontend reason=phase3-materialize-failed path={item.artifact_path}"
            rejected = rejected + 1
            continue
        reused = reused + 1
        print "[M3] reuse frontend reason={decision.reason} path={item.artifact_path}"
    print "[M3 ledger] schema=simple-phase2-phase3-reuse-ledger-v1 kind=frontend hits={reused} rejections={rejected}"
    "reused={reused}"

# Frozen source-identity map staged by the production parser immediately before
# it invokes driver-owned M3 admission. Phase-2/3 reuse routing stays
# driver-owned: the frontend never imports M2 material directly
# (frontend_parse_cache_import_phase2_v1 is the rejected env-driven bypass);
# it only stages the current frozen identities and asks the driver to admit and
# materialize. The no-arg v1 entrypoint is what the production parser calls, so
# the admission decision can never be re-bound to a frontend-local helper.
var _driver_phase2_frontend_frozen_raw_v1: {text: text} = {}

pub fn driver_stage_phase2_frontend_frozen_raw_v1(raw_by_path: {text: text}) -> bool:
    _driver_phase2_frontend_frozen_raw_v1 = raw_by_path
    true

fn driver_import_phase2_frontend_v1() -> text:
    driver_import_phase2_frontend_v2(_driver_phase2_frontend_frozen_raw_v1)

export driver_admit_phase2_compatibility_manifest_v1
export driver_import_phase2_frontend_v1
export driver_import_phase2_frontend_v2
export driver_stage_phase2_frontend_frozen_raw_v1

# Production manifest producers must use a published frontend projection and
# independently frozen driver binding. This constructs a schema-2 candidate;
# driver_admit_phase2_compatibility_manifest_v1 still authenticates its exact
# frame/consumer against the immutable M2 receipt before it can be imported.
pub fn driver_frontend_compatibility_item_v2(key: ReverseReferenceKeyV1,
    identity: text, artifact_path: text, artifact_content: text) -> PhaseCompatibilityItemV1?:
    if not frontend_parse_cache_record_header_valid_v2(artifact_content):
        return nil
    val header_end = artifact_content.index_of("\n")
    if header_end < 0 or header_end + 1 >= artifact_content.len():
        return nil
    val payload = artifact_content.substring(header_end + 1, artifact_content.len())
    val identity_end = payload.index_of("\n")
    if identity_end < 0 or identity_end + 1 >= payload.len():
        return nil
    val fields = identity.split("|")
    if fields.len() != 6 or not frontend_parse_identity_valid_v2(identity, fields[5], true):
        return nil
    if not frontend_parse_identity_valid_v2(payload.substring(0, identity_end), fields[5], false):
        return nil
    if key.registry_kind != "semantic" or key.projection_kind != "frontend-parser-input-v2" or
            key.projection_digest != reverse_reference_fact_digest_v1(
                "frontend-parser-input-v2", key.subject_identity, key.subject_identity,
                identity + "|" + sha256_text(payload.substring(identity_end + 1, payload.len())) + "|" +
                    sha256_text(artifact_content.substring(0, header_end))):
        return nil
    Some(PhaseCompatibilityItemV1(
        PHASE_COMPATIBILITY_FRONTEND_V1, reverse_reference_key_encode_v1(key),
        artifact_path, sha256_text(artifact_content), PHASE_COMPATIBILITY_PRODUCER_NEUTRAL_V1,
        FRONTEND_CACHE_ENTRY_VERSION + ":" + FLAT_POOL_CODEC_VERSION,
        "target-neutral", key.subject_identity, 2, identity))

export driver_frontend_compatibility_item_v2
