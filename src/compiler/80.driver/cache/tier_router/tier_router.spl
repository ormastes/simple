# Tier Router — process -> workspace -> machine -> remote-main lookup.
#
# Contract: doc/03_plan/compiler/cache/c0_schema_freeze_2026-08-09.md
# Design:   doc/05_design/compiler/semantic_incremental_build_cache_aop_formal_2026-08-09.md §14.2
#
# Lookup order (design §14.2, unchanged here):
#   process -> workspace action index -> machine action index -> remote-main
#   action index -> [matching remote-branch, when policy permits] -> execute
#
# This file implements the first three tiers plus the STUB remote interface.
# Agent C2 owns the real remote client (see `RemoteActionIndex` below); this
# file must not, and does not, implement remote fetch/publish.
#
# EXACT-KEY ONLY, everywhere. No prefix, restore-key, nearest-branch,
# timestamp, or filename fallback exists anywhere in this file. Git identity
# (branch/commit/PR/user) never enters an ActionDigest lookup key here — it is
# provenance, handled elsewhere (PromotionReceipt / CacheNamespace).
#
# Phase 1: standalone module, NOT wired into any load path.

use compiler.driver.cache.cas_store.{cas_open, cas_put, cas_get, result_manifest_get, result_manifest_put, result_manifest_parse, result_manifest_serialize, ResultManifest}
use compiler.driver.cache.action_index.action_index.{action_index_put, action_index_get, action_index_has, ActionIndexPutOutcome}

# ============================================================================
# Remote tier — STUB ONLY. Agent C2 fills a real implementation.
# ============================================================================

# A remote-main (and, later, remote-branch) action index. Exact-key only:
# a real implementation must still refuse anything but an exact ActionDigest
# match — no restore-keys, no nearest-branch fallback.
trait RemoteActionIndex:
    fn remote_lookup_action(action_digest: text) -> text?
    fn remote_fetch_result_manifest(result_manifest_digest: text) -> text?

# Always-miss stub: makes the router's fallthrough behaviour testable and
# correct today (process/workspace/machine tiers fully functional) without
# any actual network/remote-cache dependency. C2 replaces this with a real
# client; the trait above is the whole of the contract between the two.
impl RemoteActionIndex for null_remote:
    fn remote_lookup_action(action_digest: text) -> text?:
        nil
    fn remote_fetch_result_manifest(result_manifest_digest: text) -> text?:
        nil

# ============================================================================
# Process tier (L0) — in-memory, single-flight per action key.
# ============================================================================

# Module-level process cache: ActionDigest -> ResultManifestDigest. Immutable
# once written (matches design §14.2 "Immutable in-memory values").
var process_cache: {text: text} = {}

# Module-level single-flight guard: action digests currently being computed
# on THIS call stack. Since compilation in this process is single-threaded,
# "single-flight" here means: a reentrant/cyclic request for a key already
# being computed is detected and refused (never silently recomputed, never
# silently served a partial/nonexistent result) rather than raced. A future
# multi-threaded/async driver needs a real mutex/notify pair around this same
# dict; that is out of this file's scope (LOCAL_STATE runtime concern, not a
# cache-identity concern) and is not implemented here.
var in_flight: {text: bool} = {}

fn tier_router_process_get(action_digest: text) -> text?:
    if process_cache.contains_key(action_digest):
        return process_cache[action_digest]
    nil

fn tier_router_process_put(action_digest: text, result_manifest_digest: text):
    process_cache[action_digest] = result_manifest_digest

fn tier_router_is_in_flight(action_digest: text) -> bool:
    if in_flight.contains_key(action_digest):
        return in_flight[action_digest]
    false

fn tier_router_begin_single_flight(action_digest: text) -> bool:
    if tier_router_is_in_flight(action_digest):
        return false
    in_flight[action_digest] = true
    true

fn tier_router_end_single_flight(action_digest: text):
    in_flight[action_digest] = false

# ============================================================================
# Tier roots (workspace / machine)
# ============================================================================

# Namespace layout per design §14.4: `<root>/actions/workspace/<workspace-id>/`
# and `<root>/actions/machine/<repo-id>/<user-or-trust-id>/`. `workspace_id`
# is LOCAL_STATE (freeze note §1, class table) — a directory selector only,
# never encoded into any digest.
struct TierRoots:
    workspace_index_root: text   # e.g. "<workspace-cache-root>/actions/workspace/<workspace-id>"
    workspace_cas_root: text     # e.g. "<workspace-cache-root>"
    machine_index_root: text     # e.g. "$SIMPLE_CACHE/actions/machine/<repo-id>/<user-or-trust-id>"
    machine_cas_root: text       # e.g. "$SIMPLE_CACHE"

fn tier_roots_open(roots: TierRoots) -> bool:
    val a = cas_open(roots.workspace_cas_root)
    val b = cas_open(roots.machine_cas_root)
    a and b

# ============================================================================
# Backfill (read-through)
# ============================================================================

# Materialize a hit found at a lower tier into every faster tier above it, so
# the next lookup for the same exact key is served locally. Never demotes a
# result: only ever copies a verified hit UP toward process.
fn tier_router_backfill(roots: TierRoots, action_digest: text, result_manifest_digest: text, manifest_content: text, to_workspace: bool, to_machine: bool):
    if to_machine:
        cas_put(roots.machine_cas_root, manifest_content)
        action_index_put(roots.machine_index_root, action_digest, result_manifest_digest)
    if to_workspace:
        cas_put(roots.workspace_cas_root, manifest_content)
        action_index_put(roots.workspace_index_root, action_digest, result_manifest_digest)
    tier_router_process_put(action_digest, result_manifest_digest)

# ============================================================================
# Lookup — process -> workspace -> machine -> remote-main
# ============================================================================

struct TierLookupResult:
    found: bool
    result_manifest_digest: text
    manifest: ResultManifest?
    tier: text   # "process" | "workspace" | "machine" | "remote-main" | "miss"

fn tier_lookup_miss() -> TierLookupResult:
    TierLookupResult(found: false, result_manifest_digest: "", manifest: nil, tier: "miss")

# EXACT-KEY lookup across all tiers in the frozen order, with read-through
# backfill on every hit. `remote` is nilable so callers with no remote wiring
# (or running the null_remote stub) still get correct process/workspace/
# machine behaviour.
fn tier_router_lookup(roots: TierRoots, action_digest: text, remote: RemoteActionIndex?) -> TierLookupResult:
    # L0 process.
    val process_hit = tier_router_process_get(action_digest)
    match process_hit:
        case Some(rmd):
            return TierLookupResult(found: true, result_manifest_digest: rmd, manifest: nil, tier: "process")
        case nil:
            pass_do_nothing("no process-tier hit; fall through to workspace tier", "L0 miss")

    # L1 workspace action index.
    if action_index_has(roots.workspace_index_root, action_digest):
        val rmd = action_index_get(roots.workspace_index_root, action_digest)
        match rmd:
            case Some(digest):
                val manifest = result_manifest_get(roots.workspace_cas_root, digest)
                match manifest:
                    case Some(m):
                        tier_router_process_put(action_digest, digest)
                        return TierLookupResult(found: true, result_manifest_digest: digest, manifest: m, tier: "workspace")
                    case nil:
                        pass_do_nothing("workspace index pointed at a manifest that failed verification/parse; fall through to machine tier", "L1 manifest miss")
            case nil:
                pass_do_nothing("workspace index entry was quarantined (tampered/mismatched key); fall through to machine tier", "L1 index miss")

    # L2 machine action index.
    if action_index_has(roots.machine_index_root, action_digest):
        val rmd = action_index_get(roots.machine_index_root, action_digest)
        match rmd:
            case Some(digest):
                val manifest = result_manifest_get(roots.machine_cas_root, digest)
                match manifest:
                    case Some(m):
                        val content = result_manifest_serialize(m)
                        tier_router_backfill(roots, action_digest, digest, content, true, false)
                        return TierLookupResult(found: true, result_manifest_digest: digest, manifest: m, tier: "machine")
                    case nil:
                        pass_do_nothing("machine index pointed at a manifest that failed verification/parse; fall through to remote tier", "L2 manifest miss")
            case nil:
                pass_do_nothing("machine index entry was quarantined (tampered/mismatched key); fall through to remote tier", "L2 index miss")

    # L3 remote-main (stub unless C2's real client is passed in).
    match remote:
        case Some(r):
            val remote_rmd = r.remote_lookup_action(action_digest)
            match remote_rmd:
                case Some(digest):
                    val remote_content = r.remote_fetch_result_manifest(digest)
                    match remote_content:
                        case Some(content):
                            val parsed = result_manifest_parse(content)
                            match parsed:
                                case Some(m):
                                    tier_router_backfill(roots, action_digest, digest, content, true, true)
                                    return TierLookupResult(found: true, result_manifest_digest: digest, manifest: m, tier: "remote-main")
                                case nil:
                                    pass_do_nothing("remote manifest content failed to parse; treat as an overall miss", "L3 parse miss")
                        case nil:
                            pass_do_nothing("remote had an action mapping but the manifest fetch failed; treat as an overall miss", "L3 fetch miss")
                case nil:
                    pass_do_nothing("remote had no exact-key mapping for this action_digest; overall miss", "L3 exact-key miss")
        case nil:
            pass_do_nothing("no remote client supplied (null_remote/nil); process/workspace/machine already exhausted", "no remote wired")

    tier_lookup_miss()

# ============================================================================
# Publish — the "execute action" outcome path.
# ============================================================================

# Record a freshly computed result at the workspace tier (the tier every
# local build is always allowed to write) plus the process tier, and detect
# any action-digest conflict via action_index_put's quarantine behaviour
# (never silently overwrites a different prior result for the same key).
fn tier_router_publish_workspace(roots: TierRoots, action_digest: text, manifest: ResultManifest) -> ActionIndexPutOutcome:
    val digest = result_manifest_put(roots.workspace_cas_root, manifest)
    val outcome = action_index_put(roots.workspace_index_root, action_digest, digest)
    match outcome:
        case Stored:
            tier_router_process_put(action_digest, digest)
        case AlreadyPresentSame:
            tier_router_process_put(action_digest, digest)
        case ConflictQuarantined:
            pass_do_nothing("action_index_put already quarantined both the existing and attempted mappings; nothing to warm here", "conflict, no warm")
    outcome
