# Tier Router — exact-key lookup across the two local cache tiers.
#
# Plan: doc/03_plan/compiler/cache/semantic_incremental_build_v2_plan_2026-08-09.md
# (Agent C1 row) §5 first milestone. Design: tiered cache architecture,
# doc/05_design/compiler/semantic_incremental_build_cache_aop_formal_2026-08-09.md
# §14, crash safety §18.7.
#
# Tiers (first milestone — local only, no remote client):
#   L1 workspace  <workspace_root>/.simple/build-cache/
#   L2 machine    $SIMPLE_CACHE, or <workspace_root>/.simple/machine-cache/
#                 as a test-friendly fallback when the env var is unset.
#
# Lookup is EXACT ActionDigest only — no prefix or fallback matching of any
# kind, per the plan's first-milestone scope.
#
# An L2 hit is read-through: the referenced artifacts are copied into L1's
# CAS, the ResultManifest is republished into L1, and the L1 action index is
# updated — so the next lookup for the same key is an L1 hit.
#
# Single-flight: this is a per-process, non-threaded module (no actor/thread
# use here), so "single-flight" is a simple in-memory memo dict keyed by
# (namespace, action_digest) guarding duplicate concurrent lookups within one
# process from re-walking both tiers.

use compiler.driver.cache.cas_store.{
    ResultManifest, cas_open, cas_has, cas_get, cas_put,
    result_manifest_get, result_manifest_put, result_manifest_closure_complete,
    result_manifest_encode
}
use compiler.driver.cache.action_index.action_index.{
    CacheNamespace, IndexLookupResult, IndexPutResult,
    action_index_get, action_index_put
}
use std.crypto.sha256.{sha256_text}

extern fn rt_env_get(key: text) -> text

# ============================================================================
# Root resolution
# ============================================================================

fn tier_router_l1_root(workspace_root: text) -> text:
    "{workspace_root}/.simple/build-cache"

fn tier_router_l2_root(workspace_root: text) -> text:
    val env = rt_env_get("SIMPLE_CACHE") ?? ""
    if env != "":
        return env
    "{workspace_root}/.simple/machine-cache"

struct TierRouter:
    workspace_root: text
    l1_root: text
    l2_root: text
    memo: Dict<text, ResultManifest>

fn tier_router_open(workspace_root: text) -> TierRouter:
    val l1 = tier_router_l1_root(workspace_root)
    val l2 = tier_router_l2_root(workspace_root)
    cas_open(l1)
    cas_open(l2)
    TierRouter(workspace_root: workspace_root, l1_root: l1, l2_root: l2, memo: {})

fn tier_router_memo_key(ns: CacheNamespace, action_digest: text) -> text:
    "{cache_namespace_dir_for(ns)}:{action_digest}"

fn cache_namespace_dir_for(ns: CacheNamespace) -> text:
    match ns:
        case CacheNamespace.WorkspaceLocal: "workspace_local"
        case CacheNamespace.MachineLocal: "machine_local"

# ============================================================================
# Lookup result
# ============================================================================

enum TierLookupResult:
    HitL1(ResultManifest)
    HitL2Backfilled(ResultManifest)
    Miss

fn tier_lookup_result_manifest(r: TierLookupResult) -> ResultManifest?:
    match r:
        case TierLookupResult.HitL1(m): return m
        case TierLookupResult.HitL2Backfilled(m): return m
        case TierLookupResult.Miss: return nil

fn result_manifest_digest(m: ResultManifest) -> text:
    sha256_text(result_manifest_encode(m))

# ============================================================================
# Backfill: copy every referenced artifact + the manifest itself from L2 into
# L1, then record the L1 action-index entry. Only called on an L2 hit.
# ============================================================================

fn tier_router_backfill(tr: TierRouter, ns: CacheNamespace, action_digest: text, m: ResultManifest) -> bool:
    for d in m.artifact_digests:
        if not cas_has(tr.l1_root, d):
            val content = cas_get(tr.l2_root, d)
            match content:
                case Some(bytes):
                    cas_put(tr.l1_root, bytes)
                case nil:
                    # L2 artifact vanished/corrupt between the manifest hit
                    # and the copy — closure is broken, refuse the backfill.
                    return false
    if not result_manifest_closure_complete(tr.l1_root, m):
        return false
    if not result_manifest_put(tr.l1_root, action_digest, m):
        return false
    val digest = result_manifest_digest(m)
    match action_index_put(tr.l1_root, ns, action_digest, digest):
        case IndexPutResult.Ok: return true
        case IndexPutResult.Conflict(existing, attempted): return false

# ============================================================================
# Exact-key lookup with L1 -> L2 fallthrough and L2 read-through backfill.
# ============================================================================

fn tier_router_lookup(tr: TierRouter, ns: CacheNamespace, action_digest: text) -> TierLookupResult:
    val memo_key = tier_router_memo_key(ns, action_digest)
    if tr.memo.has(memo_key):
        return TierLookupResult.HitL1(tr.memo.get(memo_key))

    # L1 exact hit.
    match action_index_get(tr.l1_root, ns, action_digest):
        case IndexLookupResult.Hit(expected_digest):
            match result_manifest_get(tr.l1_root, action_digest):
                case Some(m):
                    if result_manifest_digest(m) == expected_digest:
                        tr.memo[memo_key] = m
                        return TierLookupResult.HitL1(m)
                case nil:
                    pass_do_nothing
        case IndexLookupResult.Miss:
            pass_do_nothing

    # L2 exact hit -> backfill into L1.
    match action_index_get(tr.l2_root, ns, action_digest):
        case IndexLookupResult.Hit(expected_digest):
            match result_manifest_get(tr.l2_root, action_digest):
                case Some(m):
                    if result_manifest_digest(m) == expected_digest:
                        tier_router_backfill(tr, ns, action_digest, m)
                        tr.memo[memo_key] = m
                        return TierLookupResult.HitL2Backfilled(m)
                case nil:
                    pass_do_nothing
        case IndexLookupResult.Miss:
            pass_do_nothing

    TierLookupResult.Miss

# ============================================================================
# Publish: write a ResultManifest (and its referenced artifacts, which the
# caller must already have `cas_put` into the SAME tier) into L1, with
# closure verification and action-index conflict detection.
# ============================================================================

enum TierPublishResult:
    Published
    ClosureIncomplete
    Conflict(text, text)

fn tier_router_publish(tr: TierRouter, ns: CacheNamespace, action_digest: text, m: ResultManifest) -> TierPublishResult:
    if not result_manifest_closure_complete(tr.l1_root, m):
        return TierPublishResult.ClosureIncomplete
    val digest = result_manifest_digest(m)
    match action_index_put(tr.l1_root, ns, action_digest, digest):
        case IndexPutResult.Conflict(existing, attempted):
            return TierPublishResult.Conflict(existing, attempted)
        case IndexPutResult.Ok:
            pass_do_nothing
    if not result_manifest_put(tr.l1_root, action_digest, m):
        return TierPublishResult.ClosureIncomplete
    tr.memo[tier_router_memo_key(ns, action_digest)] = m
    TierPublishResult.Published

export TierRouter, TierLookupResult, TierPublishResult
export tier_router_l1_root, tier_router_l2_root, tier_router_open
export tier_router_lookup, tier_router_publish, tier_lookup_result_manifest
export result_manifest_digest
