use compiler.mono.mono_archive_nominal_v2.{MonoArchiveNominalDeclV2, mono_archive_nominal_install_v2, mono_archive_nominal_imports_for_module_v2}
use compiler.mono.mono_archive_publication_identity_v1.{MonoArchiveSelectedFunctionV1,
    mono_archive_selected_record_key_v1, mono_archive_selected_output_key_v1}
# One real mono function consumer.
use compiler.driver.cache.hir_mono_nominal_rewrite_v1.*
use compiler.hir.hir_types.{HirModule, HirType, SymbolId, HirSymbol, SymbolKind, ScopeId, BUILTIN_METHOD_NONE}
use compiler.hir.hir_definitions.{HirFunction}
use compiler.common.dependency.visibility.{Visibility}
use compiler.hir.hir_codec.{hir_module_encode}
use compiler.hir.hir_codec_support.{HirCodecWriter}
use compiler.mono.mono_archive_current_body_v1.{MonoArchiveCurrentBodyV1, MonoArchiveCurrentBodyLoadV1, mono_archive_current_body_digest_v1}
use compiler.mono.mono_archive_body_input_v1.*
use compiler.common.cache_contract.hir_owned_artifact_cache_v1.{HirOwnedArtifactContextV1}
use compiler.driver.cache.hir_mono_function_record_v1.{mono_complete_function_digest_v1,
    mono_function_record_store_in_owned_scope_v1, mono_function_record_load_in_owned_scope_v1}
use compiler.monomorphize.engine.{specialize_function_with_types}
use compiler.mono.monomorphize_integration.{MonomorphizationPass, mono_sym_key, is_generic_function, hir_type_is_concrete}
use compiler.mono.mono_archive_types_v1.{MonoSpecializationRequestV1, MonoTemplateRecipeV1,
    mono_apply_template_recipe_v1, mono_template_signature_v1, mono_template_signature_digest_v1,
    mono_specialized_signature_v1}
use compiler.mono.mono_archive_state_v1.{MonoArchiveStateV1, MonoArchiveDeltaV1, MonoArchiveFactsV1,
    mono_archive_facts_from_collector_v1, mono_archive_state_create_v1,
    mono_archive_state_digest_v1, mono_archive_scratch_pass_v1,
    mono_archive_delta_v1, mono_archive_delta_digest_v1}
use compiler.driver.cache.hir_body_typecheck_lease_v1.{HirBodyArchiveV1,
    hir_body_archive_matches_v1, hir_body_archive_warnings_digest_v1}
use compiler.driver.driver_hir_cache.{hir_cache_enabled, hir_cache_load_in_owned_scope,
    hir_cache_store_in_owned_scope, hir_cache_last_warnings, hir_cache_clear_last_warnings,
    hir_cache_promote_diagnostic_owner_v1}
use std.io_runtime.{env_get}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause,
    transient_scope_end, transient_promote}

struct MonoArchiveRepositoryV1:
    modules: Dict<text, HirBodyArchiveV1>
    authority: text
    current_bodies: Dict<text, MonoArchiveCurrentBodyV1> = {}
    current_cache: HirOwnedArtifactContextV1? = nil
    current_order: [text] = []
    current_mode: bool = false
    logical_mode: bool = false

struct MonoArchiveAdmissionV1:
    repository: MonoArchiveRepositoryV1
    state: MonoArchiveStateV1

struct MonoArchivePublicationV1:
    module_name: text
    input_archive_key: text
    input_body_digest: text
    output_archive_key: text
    output_body_digest: text
    output_function_digest: text
    target_symbol: i64
    target_name: text
    # This container is complete, but ONLY the identified function was rewritten.
    # No driver may mistake it for a final whole-module mono artifact.
    stage: text
    delta: MonoArchiveDeltaV1
    delta_digest: text
    function_archive_key: text

fn mono_archive_repository_authority_v1(modules: Dict<text, HirBodyArchiveV1>, logical_mode: bool = false) -> text:
    if modules.len() == 0: return ""
    var w = HirCodecWriter.create()
    w.put_i64(modules.len())
    var closure = ""
    var producer = ""
    var runtime = ""
    var runtime_path = ""
    var provider_selection = ""
    for name in modules.keys().sort():
        val archive: HirBodyArchiveV1 = modules[name]
        if name == "" or (not logical_mode and name != archive.input.module_name) or
                not hir_body_archive_matches_v1(archive, archive.input): return ""
        if closure == "":
            closure = archive.input.closure_digest
            producer = archive.input.producer_header
            runtime = archive.input.runtime_provider_digest
            runtime_path = archive.input.runtime_provider_receipt_path
            provider_selection = archive.input.provider_selection_digest
        if closure != archive.input.closure_digest or producer != archive.input.producer_header or
                runtime != archive.input.runtime_provider_digest or
                runtime_path != archive.input.runtime_provider_receipt_path or
                provider_selection != archive.input.provider_selection_digest:
            return ""
        w.put_text(name)
        w.put_text(archive.archive_key)
        w.put_text(archive.body_digest)
        w.put_text(archive.lowering_warnings_digest)
        w.put_text(archive.input.stage)
        w.put_text(archive.input.provider_selection_digest)
        w.put_text(archive.input.runtime_provider_receipt_path)
        if logical_mode: w.put_text(archive.input.module_name)
    if not w.ok: return ""
    sha256_text((if logical_mode: "mono-logical-archive-repository-v1\n" else: "mono-archive-repository-v2\n") + w.finish())

fn mono_archive_repository_input_v1(repository: MonoArchiveRepositoryV1,
        name: text) -> Result<MonoArchiveBodyInputV1, text>:
    if not repository.modules.has(name): return Err("mono input module unavailable")
    if repository.current_mode:
        if not repository.current_bodies.has(name) or repository.current_cache == nil:
            return Err("mono current input missing; unresolved fallback refused")
        return Ok(MonoArchiveBodyInputV1(original_parent: repository.modules[name],
            current_body: Some(repository.current_bodies[name]), current_cache: repository.current_cache,
            logical_name: if repository.logical_mode: name else: ""))
    if repository.current_bodies.len() != 0 or repository.current_cache != nil or repository.current_order.len() != 0:
        return Err("mono unresolved repository carries ambiguous current inputs")
    Ok(MonoArchiveBodyInputV1(original_parent: repository.modules[name]))

fn mono_archive_repository_digest_v1(repository: MonoArchiveRepositoryV1) -> text:
    if repository.current_mode and transient_array_scope_state_v1() != 1: return ""
    if repository.logical_mode and not repository.current_mode: return ""
    val original = mono_archive_repository_authority_v1(repository.modules, repository.logical_mode)
    if original == "": return ""
    if not repository.current_mode:
        if repository.current_bodies.len() != 0 or repository.current_cache != nil or repository.current_order.len() != 0: return ""
        return original
    if repository.current_bodies.len() != repository.modules.len() or
            repository.current_order.len() != repository.modules.len(): return ""
    if val cache = repository.current_cache:
        var writer = HirCodecWriter.create()
        writer.put_text(original)
        writer.put_text(cache.directory)
        writer.put_text(cache.producer_header)
        writer.put_bool(cache.enabled)
        var seen: Dict<text, bool> = {}
        for name in repository.current_order:
            if seen.has(name): return ""
            seen[name] = true
            val input = mono_archive_repository_input_v1(repository, name)
            if input.is_err() or not mono_archive_body_input_matches_v1(input.unwrap()): return ""
            val body: MonoArchiveCurrentBodyV1 = repository.current_bodies[name]
            writer.put_text(name)
            writer.put_text(mono_archive_current_body_digest_v1(body))
        if not writer.ok: return ""
        return sha256_text((if repository.logical_mode: "mono-logical-current-repository-v1\n" else: "mono-current-repository-mechanical-v1\n") + writer.finish())
    ""

fn mono_archive_admit_v1(modules: Dict<text, HirBodyArchiveV1>, collector: MonomorphizationPass) -> Result<MonoArchiveAdmissionV1, text>:
    # Existing actual collector is a compatibility input, not a fake body graph.
    # A lease-aware whole-module summary producer remains a later integration.
    if not hir_cache_enabled() or hir_cache_last_warnings().len() != 0:
        return Err("mono archive cache owner unavailable")
    if modules.len() != collector.module_paths.len():
        return Err("mono archive inventory differs from actual collector")
    for name in modules.keys():
        if not collector.module_paths.has(name) or collector.module_paths[name] != modules[name].input.source_path:
            return Err("mono archive collector path mismatch")
    if not transient_scope_begin(): return Err("mono archive admission scope unavailable")
    val authority = mono_archive_repository_authority_v1(modules)
    val projected = mono_archive_facts_from_collector_v1(collector, authority)
    val admitted = authority != "" and projected.is_ok()
    val paused = transient_scope_pause()
    var owned = false
    if paused and admitted:
        # Facts contain only exact types/name ownership, not full parameter
        # defaults, functions, SymbolTables, original scopes or expression bodies.
        # @workaround bug=a174_transient_promote_inference_2026_10_16 recover=03d33d497ac6d1408683493f74ff9db434e4cfa3 reason=preserve-declared-result-owner-at-generic-promotion
        owned = transient_promote<Result<MonoArchiveFactsV1, text>>(projected)
    val ended = transient_scope_end()
    if not paused or not ended or (admitted and not owned):
        panic("mono archive admission ownership failed")
    if not admitted: return Err("mono archive admission refused")
    val facts = projected.unwrap()
    Ok(MonoArchiveAdmissionV1(repository: MonoArchiveRepositoryV1(modules: modules,
        authority: facts.body_authority), state: mono_archive_state_create_v1(facts)))

fn mono_archive_function_digest_v1(function: HirFunction) -> text:
    mono_complete_function_digest_v1(function)

fn mono_archive_find_function_v1(module: HirModule, symbol: i64) -> HirFunction?:
    for raw in module.functions.values():
        val function: HirFunction = raw
        if function.symbol.id == symbol: return Some(function)
    nil

fn mono_archive_selected_function_v1(publication: MonoArchivePublicationV1) -> MonoArchiveSelectedFunctionV1:
    MonoArchiveSelectedFunctionV1(module_name: publication.module_name,
        input_archive_key: publication.input_archive_key, input_body_digest: publication.input_body_digest,
        output_archive_key: publication.output_archive_key, output_body_digest: publication.output_body_digest,
        output_function_digest: publication.output_function_digest, target_symbol: publication.target_symbol,
        target_name: publication.target_name, stage: publication.stage,
        delta_digest: publication.delta_digest, function_archive_key: publication.function_archive_key)

fn mono_archive_output_key_v1(publication: MonoArchivePublicationV1) -> text:
    mono_archive_selected_output_key_v1(mono_archive_selected_function_v1(publication))

fn mono_archive_function_record_key_v1(publication: MonoArchivePublicationV1) -> text:
    mono_archive_selected_record_key_v1(mono_archive_selected_function_v1(publication))

fn mono_archive_load_function_in_owned_scope_v1(publication: MonoArchivePublicationV1) -> Result<HirFunction, text>:
    if publication.stage != "mono-function-rewrite-v2" or
            publication.function_archive_key != mono_archive_function_record_key_v1(publication) or
            publication.output_archive_key != mono_archive_output_key_v1(publication) or
            publication.delta_digest != mono_archive_delta_digest_v1(publication.delta):
        return Err("mono function record publication identity refused")
    mono_function_record_load_in_owned_scope_v1(publication.function_archive_key,
        publication.output_function_digest, publication.target_symbol, publication.target_name)

fn mono_archive_close_v1(paused: bool, promoted: bool, admitted: bool):
    # Dynamic cache I/O reason is the only persistent cache diagnostic owner.
    var cache_owned = false
    if paused:
        cache_owned = hir_cache_promote_diagnostic_owner_v1()
        hir_cache_clear_last_warnings()
    val ended = transient_scope_end()
    if not paused or not ended or not cache_owned or (admitted and not promoted):
        panic("mono archive consumer ownership failed")

fn mono_archive_visit_v1(admission: MonoArchiveAdmissionV1, module_name: text, root_symbol: i64, queued: bool) -> Result<MonoArchivePublicationV1, text>:
    if not hir_cache_enabled() or hir_cache_last_warnings().len() != 0:
        return Err("mono archive cache owner unavailable")
    if queued and admission.state.cursor >= admission.state.queue.len():
        return Err("mono archive FIFO empty")
    if not transient_scope_begin(): return Err("mono archive consumer scope unavailable")
    val state = admission.state
    val authority = mono_archive_repository_digest_v1(admission.repository)
    val base = mono_archive_state_digest_v1(state)
    var publication: MonoArchivePublicationV1? = nil
    var selected_module = module_name
    var selected_symbol = root_symbol
    var target_name = ""
    var request: MonoSpecializationRequestV1? = nil
    if queued:
        val item: MonoSpecializationRequestV1 = state.queue[state.cursor]
        request = Some(item)
        selected_module = item.module_name
        if state.facts.recipes.has(item.template_name):
            selected_symbol = state.facts.recipes[item.template_name].original_symbol.id
        target_name = item.mangled_name
    if authority != "" and authority == admission.repository.authority and authority == state.facts.body_authority and
            base != "" and state.facts.feature_policy == env_get("SIMPLE_MONO_LEVELS") and
            admission.repository.modules.has(selected_module):
        val archive: HirBodyArchiveV1 = admission.repository.modules[selected_module]
        val input_result = mono_archive_repository_input_v1(admission.repository, selected_module)
        val loaded: Result<MonoArchiveCurrentBodyLoadV1, text> = if input_result.is_ok():
            mono_archive_body_input_load_in_owned_scope_v1(input_result.unwrap())
        else:
            Err("mono selected input unavailable")
        if loaded.is_ok():
            val input = input_result.unwrap()
            val decoded = loaded.unwrap().module
            val warnings = loaded.unwrap().warnings
            if decoded.name == archive.input.module_name and mono_archive_body_input_module_name_v1(input) == selected_module and decoded.path == archive.input.source_path and
                    sha256_text(hir_module_encode(decoded)) == mono_archive_body_input_digest_v1(input) and
                    hir_body_archive_warnings_digest_v1(warnings) == mono_archive_body_input_warnings_digest_v1(input):
                if val original = mono_archive_find_function_v1(decoded, selected_symbol):
                    var function = original
                    var valid = not queued and not is_generic_function(function) and not function.is_generic_template
                    if val item = request:
                        if state.facts.recipes.has(item.template_name) and state.facts.templates.has(item.template_name) and
                                state.spec_symbols.has(item.mangled_name) and state.spec_symbols[item.mangled_name] == item.symbol_id and
                                not state.emitted.has(item.mangled_name):
                            val recipe: MonoTemplateRecipeV1 = state.facts.recipes[item.template_name]
                            val canonical = mono_apply_template_recipe_v1(original, recipe)
                            if recipe.module_name == selected_module and recipe.original_symbol.id == selected_symbol and
                                    mono_template_signature_digest_v1(mono_template_signature_v1(canonical)) ==
                                        mono_template_signature_digest_v1(state.facts.templates[item.template_name]):
                                function = specialize_function_with_types(canonical, item.type_args)
                                function.name = item.mangled_name
                                function.symbol = SymbolId.new(item.symbol_id)
                                valid = state.spec_signatures.has(item.mangled_name) and
                                    mono_template_signature_digest_v1(mono_template_signature_v1(function)) ==
                                        mono_template_signature_digest_v1(state.spec_signatures[item.mangled_name])
                    if valid:
                        val replayed = mono_archive_rewrite_complete_in_owned_scope_v1(state, decoded,
                            selected_module, selected_symbol, request)
                        if replayed.is_err():
                            val failure: Result<MonoArchivePublicationV1, text> = Err(replayed.unwrap_err())
                            val paused = transient_scope_pause()
                            val owned = if paused: transient_promote(failure) else: false
                            mono_archive_close_v1(paused, owned, true)
                            return failure
                        val output = replayed.unwrap().module
                        val rewritten = replayed.unwrap().function
                        val delta = replayed.unwrap().delta
                        val body_digest = sha256_text(hir_module_encode(output))
                        val function_digest = mono_archive_function_digest_v1(rewritten)
                        val delta_digest = mono_archive_delta_digest_v1(delta)
                        var receipt = MonoArchivePublicationV1(module_name: selected_module,
                            input_archive_key: mono_archive_body_input_key_v1(input), input_body_digest: mono_archive_body_input_digest_v1(input),
                            output_archive_key: "", output_body_digest: body_digest,
                            output_function_digest: function_digest, target_symbol: rewritten.symbol.id,
                            target_name: rewritten.name, stage: "mono-function-rewrite-v2", delta: delta,
                            delta_digest: delta_digest, function_archive_key: "")
                        receipt.function_archive_key = mono_archive_function_record_key_v1(receipt)
                        receipt.output_archive_key = mono_archive_output_key_v1(receipt)
                        if body_digest.len() == 64 and function_digest != "" and delta_digest != "" and
                                receipt.output_archive_key != "" and
                                mono_function_record_store_in_owned_scope_v1(receipt.function_archive_key, rewritten).is_ok() and
                                hir_cache_store_in_owned_scope(receipt.output_archive_key, output, warnings):
                            publication = Some(receipt)
    val admitted = publication != nil
    val paused = transient_scope_pause()
    val owned = if paused and admitted: transient_promote(publication) else: false
    mono_archive_close_v1(paused, owned, admitted)
    if val receipt = publication: return Ok(receipt)
    Err("mono archive body, identity, recipe, or publication refused")

fn mono_archive_rewrite_root_v1(admission: MonoArchiveAdmissionV1, module_name: text, symbol: i64) -> Result<MonoArchivePublicationV1, text>:
    mono_archive_visit_v1(admission, module_name, symbol, false)

fn mono_archive_drain_one_v1(admission: MonoArchiveAdmissionV1) -> Result<MonoArchivePublicationV1, text>:
    # One complete FIFO body per owned transaction; caller explicitly applies
    # publication before consuming the next cursor. No recursive nested scope.
    mono_archive_visit_v1(admission, "", 0, true)

fn mono_archive_publication_matches_v1(admission: MonoArchiveAdmissionV1, receipt: MonoArchivePublicationV1) -> bool:
    val state = admission.state
    val delta = receipt.delta
    if receipt.stage != "mono-function-rewrite-v2" or
            delta.base_epoch != state.epoch or delta.base_digest == "" or
            delta.base_digest != mono_archive_state_digest_v1(state) or
            delta.specializations_created != delta.requests.len() or
            delta.signatures.len() != delta.requests.len() or
            receipt.delta_digest == "" or receipt.delta_digest != mono_archive_delta_digest_v1(delta) or
            receipt.function_archive_key != mono_archive_function_record_key_v1(receipt) or
            receipt.output_archive_key != mono_archive_output_key_v1(receipt) or
            not admission.repository.modules.has(receipt.module_name): return false
    val archive: HirBodyArchiveV1 = admission.repository.modules[receipt.module_name]
    val input_result = mono_archive_repository_input_v1(admission.repository, receipt.module_name)
    if input_result.is_err(): return false
    val input = input_result.unwrap()
    if receipt.input_archive_key != mono_archive_body_input_key_v1(input) or receipt.input_body_digest != mono_archive_body_input_digest_v1(input): return false
    # Re-run the actual complete body in its real caller namespace. This
    # independently reproduces every nominal allocation, transported argument,
    # caller signature stamp, warning, diagnostic and specialization counter.
    val loaded = mono_archive_body_input_load_in_owned_scope_v1(input)
    if loaded.is_err(): return false
    var request: MonoSpecializationRequestV1? = nil
    var selected_symbol = receipt.target_symbol
    if delta.advance_cursor:
        if state.cursor >= state.queue.len(): return false
        val item = state.queue[state.cursor]
        if item.module_name != receipt.module_name or item.symbol_id != receipt.target_symbol or
                item.mangled_name != receipt.target_name or item.caller_module == "" or
                state.emitted.has(item.mangled_name): return false
        request = Some(item)
        if not state.facts.recipes.has(item.template_name): return false
        selected_symbol = state.facts.recipes[item.template_name].original_symbol.id
    val exact = mono_archive_rewrite_complete_in_owned_scope_v1(state, loaded.unwrap().module,
        receipt.module_name, selected_symbol, request)
    if exact.is_err() or mono_archive_delta_digest_v1(exact.unwrap().delta) != receipt.delta_digest or
            sha256_text(hir_module_encode(exact.unwrap().module)) != receipt.output_body_digest or
            mono_archive_function_digest_v1(exact.unwrap().function) != receipt.output_function_digest:
        return false

    if val output = hir_cache_load_in_owned_scope(receipt.output_archive_key):
        if output.name != archive.input.module_name or output.path != archive.input.source_path or
                sha256_text(hir_module_encode(output)) != receipt.output_body_digest or
                hir_body_archive_warnings_digest_v1(hir_cache_last_warnings()) != mono_archive_body_input_warnings_digest_v1(input): return false
        if val function = mono_archive_find_function_v1(output, receipt.target_symbol):
            return mono_archive_load_function_in_owned_scope_v1(receipt).is_ok() and
                function.name == receipt.target_name and
                mono_archive_function_digest_v1(function) == receipt.output_function_digest
    false

fn mono_archive_apply_v1(admission: MonoArchiveAdmissionV1, receipt: MonoArchivePublicationV1) -> Result<bool, text>:
    # Verification owns scratch; mutation happens only after it ends. Nested
    # callers cannot put newly published state rows in somebody else's scope.
    if not hir_cache_enabled() or hir_cache_last_warnings().len() != 0:
        return Err("mono archive publication cache owner unavailable")
    if not transient_scope_begin(): return Err("mono archive publication scope unavailable")
    val authority = mono_archive_repository_digest_v1(admission.repository)
    val valid = authority != "" and authority == admission.repository.authority and
        authority == admission.state.facts.body_authority and
        admission.state.facts.feature_policy == env_get("SIMPLE_MONO_LEVELS") and
        mono_archive_publication_matches_v1(admission, receipt)
    val paused = transient_scope_pause()
    mono_archive_close_v1(paused, false, false)
    if not valid: return Err("mono archive publication identity, body, delta, or cursor refused")
    val state = admission.state
    val delta = receipt.delta
    # Exhaustive publication: only already promoted new rows/types/text and
    # scalar counters enter resident state. No worker, input/output module,
    # full mutable summary clone, or cache warning alias survives the scope.
    for key in delta.nominal_imports.keys().sort():
        val row = delta.nominal_imports[key]
        val prior: [text] = state.nominal_import_keys[row.module_name] ?? []
        state.nominal_import_keys[row.module_name] = prior.push(key)
        state.nominal_imports[key] = row
    for key in delta.caller_returns.keys(): state.fn_returns[key] = delta.caller_returns[key]
    for item in delta.requests:
        state.spec_symbols[item.mangled_name] = item.symbol_id
        state.spec_signatures[item.mangled_name] = delta.signatures[item.mangled_name]
        val signature = delta.signatures[item.mangled_name]
        state.fn_returns[mono_sym_key(item.module_name, item.symbol_id)] = signature.return_type
        state.sym_names[mono_sym_key(item.module_name, item.symbol_id)] = signature.name
        state.queue = state.queue.push(item)
    for name in delta.symbol_patches.keys():
        var patches: [text] = state.symbol_patches[name] ?? []
        patches.push(delta.symbol_patches[name])
        state.symbol_patches[name] = patches
    for key in delta.fn_returns.keys(): state.fn_returns[key] = delta.fn_returns[key]
    for key in delta.spec_display.keys(): state.spec_display[key] = delta.spec_display[key]
    for key in delta.reported_once.keys(): state.reported_once[key] = delta.reported_once[key]
    for key in delta.unresolved_templates.keys(): state.unresolved_templates[key] = delta.unresolved_templates[key]
    if delta.advance_cursor:
        state.emitted[receipt.target_name] = receipt.output_function_digest
        state.cursor = state.cursor + 1
    state.next_symbol = delta.next_symbol
    state.epoch = state.epoch + 1
    Ok(true)

export MonoArchiveRepositoryV1, MonoArchiveAdmissionV1, MonoArchivePublicationV1
export mono_archive_admit_v1, mono_archive_function_digest_v1
export mono_archive_rewrite_root_v1, mono_archive_drain_one_v1
export mono_archive_apply_v1
export mono_archive_repository_input_v1, mono_archive_repository_digest_v1
export mono_archive_repository_authority_v1
export mono_archive_load_function_in_owned_scope_v1

export mono_archive_selected_function_v1
