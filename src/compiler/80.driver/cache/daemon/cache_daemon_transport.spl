"""Bounded daemon connection decision with one restart/reconnect only.

This module is pure policy.  `first_ready` and `retry_ready` must be produced
by transport code only after peer credentials and the nonce-bound readiness
receipt have both been authenticated.
"""

val CACHE_ROUTE_DAEMON: i64 = 1i64
val CACHE_ROUTE_DIRECT_SPOOL: i64 = 2i64
val CACHE_CONNECT_BUDGET_MS: i64 = 250i64

struct CacheTransportDecision:
    route: i64
    reconnect_count: i64
    elapsed_ms: i64
    reason: text

fn cache_transport_decide(first_ready: bool, retry_ready: bool, elapsed_ms: i64) -> CacheTransportDecision:
    if first_ready and elapsed_ms <= CACHE_CONNECT_BUDGET_MS:
        return CacheTransportDecision(route: CACHE_ROUTE_DAEMON, reconnect_count: 0i64, elapsed_ms: elapsed_ms, reason: "ready")
    if retry_ready and elapsed_ms <= CACHE_CONNECT_BUDGET_MS:
        return CacheTransportDecision(route: CACHE_ROUTE_DAEMON, reconnect_count: 1i64, elapsed_ms: elapsed_ms, reason: "ready_after_restart")
    CacheTransportDecision(route: CACHE_ROUTE_DIRECT_SPOOL, reconnect_count: 1i64, elapsed_ms: elapsed_ms, reason: "bounded_fallback")

fn isolated_spool_path(spool_root: text, client_instance_nonce: text) -> text:
    if spool_root == "" or not cache_spool_nonce_valid(client_instance_nonce):
        return ""
    "{spool_root}/{client_instance_nonce}"

fn cache_spool_nonce_valid(value: text) -> bool:
    if value == "" or value != value.trim() or value == "." or value == ".." or value.len() > 96i64:
        return false
    val allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-"
    for ch in value.chars():
        if not allowed.contains(ch.to_text()):
            return false
    true
