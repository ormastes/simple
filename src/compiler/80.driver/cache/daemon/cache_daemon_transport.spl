"""Bounded daemon connection decision with one restart/reconnect only.

This module is pure policy.  `first_ready` and `retry_ready` must be produced
by transport code only after peer credentials and the nonce-bound readiness
receipt have both been authenticated.
"""

val CACHE_ROUTE_DAEMON: i64 = 1i64
val CACHE_ROUTE_DIRECT_SPOOL: i64 = 2i64
val CACHE_CONNECT_BUDGET_MS: i64 = 250i64

struct CacheTransportDecision:
    route: i64
    reconnect_count: i64
    elapsed_ms: i64
    reason: text

class CacheConnectStateMachine:
    start_ms: i64
    last_ms: i64
    launch_count: i64
    connect_count: i64
    finished: bool
    invalid_clock: bool

    static fn create(start_ms: i64) -> CacheConnectStateMachine:
        CacheConnectStateMachine(
            start_ms: start_ms, last_ms: start_ms, launch_count: 0i64,
            connect_count: 0i64, finished: false, invalid_clock: start_ms < 0i64,
        )

    me connect(authenticated_ready: bool, now_ms: i64) -> CacheTransportDecision:
        if self.finished:
            return CacheTransportDecision(route: CACHE_ROUTE_DIRECT_SPOOL, reconnect_count: self.connect_count - 1i64, elapsed_ms: self.last_ms - self.start_ms, reason: "already_finished")
        if self.invalid_clock or now_ms < 0i64 or now_ms < self.last_ms:
            self.finished = true
            self.invalid_clock = true
            return CacheTransportDecision(route: CACHE_ROUTE_DIRECT_SPOOL, reconnect_count: self.connect_count, elapsed_ms: 0i64, reason: "invalid_monotonic_time")
        self.last_ms = now_ms
        self.connect_count = self.connect_count + 1i64
        val elapsed = now_ms - self.start_ms
        if elapsed > CACHE_CONNECT_BUDGET_MS:
            self.finished = true
            return CacheTransportDecision(route: CACHE_ROUTE_DIRECT_SPOOL, reconnect_count: self.connect_count - 1i64, elapsed_ms: elapsed, reason: "budget_exhausted")
        if authenticated_ready:
            self.finished = true
            return CacheTransportDecision(route: CACHE_ROUTE_DAEMON, reconnect_count: self.connect_count - 1i64, elapsed_ms: elapsed, reason: "authenticated_ready")
        if self.connect_count == 1i64:
            self.launch_count = 1i64
            return CacheTransportDecision(route: 0i64, reconnect_count: 0i64, elapsed_ms: elapsed, reason: "launch_then_reconnect")
        self.finished = true
        CacheTransportDecision(route: CACHE_ROUTE_DIRECT_SPOOL, reconnect_count: 1i64, elapsed_ms: elapsed, reason: "bounded_fallback")

fn cache_connect_state_machine_new(start_ms: i64) -> CacheConnectStateMachine:
    CacheConnectStateMachine.create(start_ms)
