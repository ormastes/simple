"""Lane-local composition of the reusable service base and cache lifecycle."""

use std.service.daemon_base
use compiler.driver.cache.daemon.cache_daemon_lifecycle

class CacheDaemonHost:
    base: DaemonBase
    lifecycle: CacheDaemonLifecycle
    writer_epoch: i64
    owner_instance_nonce: text
    peer_user_id: text

    static fn create(config: DaemonConfig, owner_instance_nonce: text, peer_user_id: text) -> CacheDaemonHost:
        CacheDaemonHost(
            base: daemon_base_new(config),
            lifecycle: cache_daemon_lifecycle_new(),
            writer_epoch: 0i64,
            owner_instance_nonce: owner_instance_nonce,
            peer_user_id: peer_user_id,
        )

    me admit(expected_user_id: text, next_writer_epoch: i64) -> bool:
        if self.owner_instance_nonce == "" or self.peer_user_id != expected_user_id or next_writer_epoch <= 0i64:
            return false
        if not daemon_base_start(self.base):
            return false
        self.writer_epoch = next_writer_epoch
        true

    me stop():
        self.lifecycle.admission_open = false
        daemon_base_stop(self.base)
        self.writer_epoch = 0i64

fn cache_daemon_host_new(config: DaemonConfig, owner_instance_nonce: text, peer_user_id: text) -> CacheDaemonHost:
    CacheDaemonHost.create(config, owner_instance_nonce, peer_user_id)
