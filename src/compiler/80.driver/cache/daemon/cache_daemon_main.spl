"""Lane-local composition of the reusable service base and cache lifecycle."""

use std.service.daemon_base
use std.nogc_sync_mut.service.daemon_base.{daemon_base_start_owned, daemon_base_stop_owned}
use compiler.driver.cache.daemon.cache_daemon_lifecycle
use compiler.driver.cache.daemon.cache_single_flight_v1.{CacheSingleFlightV1,
    cache_single_flight_key_v1, SINGLE_FLIGHT_LEADER_V1}
use std.async.future.{Future}
use compiler.driver.cache.gc.cache_eviction_plan_v1.{CacheEntryUseV1, cache_eviction_plan_v1}
use compiler.driver.cache.metadata.cache_limits.{CacheRetentionLimitsV1}
use common.cache_host_authority_v1.{CacheRootAuthorityV1}
use common.cache_daemon_host_authority_v1
use compiler.driver.cache.daemon.package_daemon_session.{
    PackageDaemonSessionV1, PackageDaemonRequestV1, package_daemon_request_denied_v1
}

struct CacheDaemonAdmission:
    admitted: bool
    peer: AuthenticatedPeerReceiptV1
    lock: ExclusiveCacheLockReceiptV1
    boot: HostBootIdentityV1
    epoch: DurableWriterEpochV1
    readiness: CacheReadinessReceiptV1

# Credential, boot identity, exclusive lock, durable epoch and readiness are
# all runtime-owned opaque receipts. Any unsupported/forged step remains
# closed because validation admits only exact status 1.
fn cache_daemon_try_host_admission(
    root: CacheRootAuthorityV1,
    transport_peer_handle: i64,
    readiness_nonce: [u8],
) -> CacheDaemonAdmission:
    val peer = cache_host_authenticate_peer_v1(root, transport_peer_handle)
    val lock = cache_host_acquire_exclusive_lock_v1(root, peer)
    val boot = cache_host_boot_identity_v1(lock)
    val epoch = cache_host_advance_writer_epoch_v1(lock, boot)
    val readiness = cache_host_publish_readiness_v1(lock, epoch, readiness_nonce)
    val status = cache_host_validate_readiness_v1(peer, readiness, readiness_nonce, epoch)
    CacheDaemonAdmission(
        admitted: status == 1i64,
        peer: peer,
        lock: lock,
        boot: boot,
        epoch: epoch,
        readiness: readiness,
    )

class CacheDaemonHost:
    base: DaemonBase
    lifecycle: CacheDaemonLifecycle
    package_sessions: [PackageDaemonSessionV1] = []
    package_admission_open: bool = false
    package_request_sequence: i64 = 0
    artifact_flights: CacheSingleFlightV1 = CacheSingleFlightV1.create()
    artifact_usage: [CacheEntryUseV1] = []
    artifact_paths: [text] = []

    static fn create(config: DaemonConfig, start_ms: i64) -> CacheDaemonHost:
        CacheDaemonHost(
            base: daemon_base_new(config),
            lifecycle: cache_daemon_lifecycle_new(start_ms),
        )

    me start_after_admission(admission: CacheDaemonAdmission) -> bool:
        if not admission.admitted:
            return false
        val started = daemon_base_start_owned(self.base)
        self.base = started.base
        if started.started:
            self.package_admission_open = true
        started.started

    me begin_package_request(
        workspace_identity: text, cache_root: text, now_ms: i64
    ) -> PackageDaemonRequestV1:
        if not self.package_admission_open or not self.lifecycle.admission_open:
            return package_daemon_request_denied_v1("daemon-not-admitted")
        if workspace_identity == "" or cache_root == "":
            return package_daemon_request_denied_v1("session-identity-missing")
        var index = 0
        while index < self.package_sessions.len():
            if self.package_sessions[index].workspace_identity == workspace_identity:
                break
            index = index + 1
        if index == self.package_sessions.len():
            if self.package_sessions.len() >= 128:
                return package_daemon_request_denied_v1("workspace-session-limit")
            self.package_sessions = self.package_sessions.push(
                PackageDaemonSessionV1.create(workspace_identity, cache_root))
        var session = self.package_sessions[index]
        if session.cache_root != cache_root:
            return package_daemon_request_denied_v1("workspace-root-mismatch")
        if not session.active:
            # Sequence values never repeat when a workspace closes/reopens.
            # A stale end-request token cannot release a new request's lease.
            session.request_sequence = self.package_request_sequence
        val request = session.begin_request(workspace_identity)
        if request.valid and not self.lifecycle.begin_request(now_ms):
            session.end_request(request.sequence)
            self.package_sessions[index] = session
            return package_daemon_request_denied_v1("daemon-draining")
        self.package_sessions[index] = session
        if request.valid:
            self.package_request_sequence = request.sequence
        request

    me end_package_request(workspace_identity: text, sequence: i64, now_ms: i64) -> bool:
        var index = 0
        while index < self.package_sessions.len():
            var session = self.package_sessions[index]
            if session.workspace_identity == workspace_identity:
                if not session.end_request(sequence):
                    return false
                self.package_sessions[index] = session
                self.lifecycle.end_request(now_ms)
                return true
            index = index + 1
        false

    me close_package_workspace(workspace_identity: text) -> bool:
        var retained: [PackageDaemonSessionV1] = []
        var found = false
        for existing in self.package_sessions:
            var session = existing
            if session.workspace_identity == workspace_identity:
                if not session.close():
                    return false
                found = true
            else:
                retained = retained.push(session)
        if found:
            self.package_sessions = retained
        found

    # Called only after the host-authority layer has closed admission, drained
    # work, checkpointed, and released its opaque exclusive-writer receipt.
    # Module artifact production (full AST / TLDR companion), single-flight.
    # The leader request is counted as one daemon request from join until
    # complete; participants only poll. Returns role -1 when not admitted.
    me join_artifact(kind: text, digest: text, request_id: text, now_ms: i64) -> (i64, i64):
        if not self.package_admission_open or not self.lifecycle.admission_open:
            return (-1, 0)
        val key = cache_single_flight_key_v1(kind, digest)
        val (role, flight) = self.artifact_flights.join(key, request_id)
        if role == SINGLE_FLIGHT_LEADER_V1:
            if not self.lifecycle.begin_request(now_ms):
                val _abandoned = self.artifact_flights.complete(key, request_id, nil)
                return (-1, 0)
        (role, flight)

    me complete_artifact(kind: text, digest: text, request_id: text, blob: [u8]?, now_ms: i64) -> bool:
        val completed = self.artifact_flights.complete(cache_single_flight_key_v1(kind, digest),
            request_id, blob)
        if completed:
            self.lifecycle.end_request(now_ms)
        completed

    me poll_artifact(flight: i64) -> Future<[u8]?>:
        self.artifact_flights.future(flight)

    # Usage ledger for eviction: one row per stored artifact version. The
    # catalog carries no usage records, so the daemon -- the only writer --
    # keeps them; eviction plans run over this ledger.
    me note_artifact_use(entry: CacheEntryUseV1, artifact_path: text):
        var i = 0
        while i < self.artifact_usage.len():
            val row = self.artifact_usage[i]
            if row.branch == entry.branch and row.source == entry.source and
                    row.version_key == entry.version_key:
                self.artifact_usage[i] = entry
                self.artifact_paths[i] = artifact_path
                return
            i = i + 1
        self.artifact_usage.push(entry)
        self.artifact_paths.push(artifact_path)

    # Apply the retention plan: drop evicted rows and return their artifact
    # paths (the caller deletes those files).
    me evict_artifacts(limits: CacheRetentionLimitsV1) -> [text]:
        val plan = cache_eviction_plan_v1(self.artifact_usage, limits)
        var removed: [text] = []
        var kept_usage: [CacheEntryUseV1] = []
        var kept_paths: [text] = []
        var i = 0
        while i < self.artifact_usage.len():
            if plan.evict.contains(i):
                removed.push(self.artifact_paths[i])
            else:
                kept_usage.push(self.artifact_usage[i])
                kept_paths.push(self.artifact_paths[i])
            i = i + 1
        self.artifact_usage = kept_usage
        self.artifact_paths = kept_paths
        removed

    me stop_after_authority_release() -> bool:
        if self.lifecycle.shutdown_state != CACHE_DAEMON_STOPPED:
            if not self.lifecycle.finish_shutdown():
                return false
        self.package_admission_open = false
        self.base = daemon_base_stop_owned(self.base)
        if self.base.running:
            return false
        self.package_sessions = []
        true

fn cache_daemon_host_new(config: DaemonConfig, start_ms: i64) -> CacheDaemonHost:
    CacheDaemonHost.create(config, start_ms)
