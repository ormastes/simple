use compiler.mono.mono_archive_nominal_v2.{MonoArchiveNominalDeclV2, mono_archive_nominal_install_v2}
# Compact identities copied only from actual applied publications. These fields
# carry byte identity; final admission additionally requires driver registration.
use compiler.driver.cache.hir_body_typecheck_lease_v1.{HirBodyArchiveV1,
    hir_body_archive_load_in_owned_scope_v1}
use compiler.mono.mono_archive_body_input_v1.*
use compiler.mono.mono_archive_current_body_v1.{MonoArchiveCurrentBodyLoadV1}
use compiler.mono.mono_archive_publication_identity_v1.{MonoArchiveSelectedFunctionV1,
    mono_archive_selected_record_key_v1, mono_archive_selected_output_key_v1}
use compiler.driver.cache.hir_mono_function_record_v1.{mono_function_record_load_in_owned_scope_v1}
use compiler.hir.hir_codec_support.{HirCodecWriter}
use compiler.hir.hir_mono_symbol_projection_v1.{hir_mono_symbol_projection_install_v1, hir_mono_symbol_projection_decode_v1, hir_mono_symbol_patch_apply_v1}
use compiler.hir.hir_types.{HirModule, SymbolId, HirSymbol, SymbolKind, ScopeId, BUILTIN_METHOD_NONE}
use compiler.hir.hir_definitions.{HirFunction}
use compiler.common.dependency.visibility.{Visibility}
use compiler.mono.monomorphize_integration.{MonomorphizationPass, is_generic_function, sorted_function_indices}
use compiler.mono.mono_archive_types_v1.{MonoTemplateBodyModeV1}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}

fn mono_archive_load_selected_function_in_owned_scope_v1(input: MonoArchiveBodyInputV1,
        selected: MonoArchiveSelectedFunctionV1) -> Result<HirFunction, text>:
    val archive = input.original_parent
    if transient_array_scope_state_v1() != 1 or selected.stage != "mono-function-rewrite-v2" or
            selected.module_name != mono_archive_body_input_module_name_v1(input) or selected.input_archive_key != mono_archive_body_input_key_v1(input) or
            selected.input_body_digest != mono_archive_body_input_digest_v1(input) or selected.delta_digest.len() != 64 or
            selected.function_archive_key != mono_archive_selected_record_key_v1(selected) or
            selected.output_archive_key != mono_archive_selected_output_key_v1(selected):
        return Err("selected mono function identity refused")
    mono_function_record_load_in_owned_scope_v1(selected.function_archive_key,
        selected.output_function_digest, selected.target_symbol, selected.target_name)

fn mono_archive_reassemble_selected_module_in_owned_scope_v1(archive: HirBodyArchiveV1,
        roots: [MonoArchiveSelectedFunctionV1], specializations: [MonoArchiveSelectedFunctionV1],
        unresolved_templates: [text], emitted_templates: [text], next_symbol: i64) -> Result<HirModule, text>:
    val assembled = mono_archive_reassemble_body_input_in_owned_scope_v1(MonoArchiveBodyInputV1(original_parent: archive),
        roots, specializations, unresolved_templates, emitted_templates, next_symbol)?
    Ok(assembled.module)

fn mono_archive_reassemble_body_input_in_owned_scope_v1(input: MonoArchiveBodyInputV1,
        roots: [MonoArchiveSelectedFunctionV1], specializations: [MonoArchiveSelectedFunctionV1],
        unresolved_templates: [text], emitted_templates: [text], next_symbol: i64,
        shared_symbols: [MonoArchiveSelectedFunctionV1] = [], symbol_projection: text = "", symbol_patches: [text] = [],
        nominal_imports: Dict<text, MonoArchiveNominalDeclV2> = {}) -> Result<MonoArchiveCurrentBodyLoadV1, text>:
    if transient_array_scope_state_v1() != 1: return Err("mono selected assembly scope refused")
    val loaded = mono_archive_body_input_load_in_owned_scope_v1(input)?
    val original = loaded.module
    val archive = input.original_parent
    var output = original
    if symbol_projection != "":
        val installed = hir_mono_symbol_projection_install_v1(output.symbols, symbol_projection)
        if installed.is_err(): return Err(installed.unwrap_err())
        val (cohort, _) = hir_mono_symbol_projection_decode_v1(symbol_projection)?
        for patch in symbol_patches:
            val applied = hir_mono_symbol_patch_apply_v1(output.symbols, cohort, patch)
            if applied.is_err(): return Err(applied.unwrap_err())
    if not mono_archive_nominal_install_v2(output.symbols, mono_archive_body_input_module_name_v1(input), nominal_imports):
        return Err("mono selected nominal declaration overlay refused")
    var functions: Dict<SymbolId, HirFunction> = {}
    val function_values: [HirFunction] = original.functions.values()
    var root_index = 0
    for function_index in sorted_function_indices(function_values):
        val function: HirFunction = function_values[function_index]
        if is_generic_function(function) or function.is_generic_template:
            functions[function.symbol] = function
            continue
        if root_index >= roots.len(): return Err("mono selected root missing")
        val selected = roots[root_index]
        if selected.target_symbol != function.symbol.id or selected.target_name != function.name:
            return Err("mono selected root order or identity differs")
        val complete = mono_archive_load_selected_function_in_owned_scope_v1(input, selected)?
        functions[complete.symbol] = complete
        root_index = root_index + 1
    if root_index != roots.len(): return Err("mono selected root coverage differs")
    for selected in specializations:
        val complete = mono_archive_load_selected_function_in_owned_scope_v1(input, selected)?
        if functions.has(complete.symbol) or not complete.name.contains("$"):
            return Err("mono selected specialization collides")
        functions[complete.symbol] = complete
        if input.logical_name == "":
            output.symbols.register_preserved_symbol(HirSymbol(id: complete.symbol,
                name: complete.name, kind: SymbolKind.Function, type_: nil, scope: ScopeId(id: 0),
                span: complete.span, visibility: Visibility.Private, is_public: false, is_mutable: false,
                defining_module: archive.input.module_name, builtin_method_tag: BUILTIN_METHOD_NONE, generic_param_count: 0))
    # Retained aliases share a SymbolTable class handle even though each output
    # has its own functions dictionary. Replay the exact shared symbol rows,
    # without placing a different alias's specialization body in this output.
    if input.logical_name == "" and shared_symbols.len() != 0:
        return Err("mono shared symbol rows require logical input")
    var own_symbols = 0
    var symbol_ids: Dict<i64, bool> = {}
    for selected in shared_symbols:
        if selected.module_name == "" or symbol_ids.has(selected.target_symbol):
            return Err("mono shared symbol identity repeats")
        symbol_ids[selected.target_symbol] = true
        var symbol_input = input
        symbol_input.logical_name = selected.module_name
        val complete = mono_archive_load_selected_function_in_owned_scope_v1(symbol_input, selected)?
        if not complete.name.contains("$"): return Err("mono shared symbol is not a specialization")
        if selected.module_name == input.logical_name:
            var matched = false
            for own in specializations:
                if own.function_archive_key == selected.function_archive_key and own.target_symbol == selected.target_symbol: matched = true
            if not matched: return Err("mono own symbol publication differs")
            own_symbols = own_symbols + 1
        output.symbols.register_preserved_symbol(HirSymbol(id: complete.symbol,
            name: complete.name, kind: SymbolKind.Function, type_: nil, scope: ScopeId(id: 0),
            span: complete.span, visibility: Visibility.Private, is_public: false, is_mutable: false,
            defining_module: selected.module_name, builtin_method_tag: BUILTIN_METHOD_NONE, generic_param_count: 0))
    if input.logical_name != "" and own_symbols != specializations.len():
        return Err("mono own shared symbol coverage differs")
    if (specializations.len() != 0 or shared_symbols.len() != 0 or output.symbols.next_symbol_id >= 1125899906842624) and output.symbols.next_symbol_id < next_symbol:
        output.symbols.next_symbol_id = next_symbol
    output.functions = functions
    val worker = MonomorphizationPass.create()
    worker.template_body_mode = MonoTemplateBodyModeV1.ArchiveRequests
    for name in unresolved_templates: worker.unresolved_templates[name] = true
    for name in emitted_templates: worker.archive_emitted_templates[name] = name
    Ok(MonoArchiveCurrentBodyLoadV1(module: worker.prune_consumed_templates(output), warnings: loaded.warnings))

export use compiler.mono.mono_archive_publication_identity_v1.{MonoArchiveSelectedFunctionV1}
export mono_archive_reassemble_selected_module_in_owned_scope_v1
export mono_archive_reassemble_body_input_in_owned_scope_v1
