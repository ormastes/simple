# Compact current collection replay metadata; no analyzer or driver controller.
use compiler.mono.mono_archive_body_input_v1.{MonoArchiveBodyInputV1}
use compiler.semantics.perf_facts.registry.{CollectionRegistryBindingV1}

struct CollectionCurrentArchiveAnalysisV1:
    input: MonoArchiveBodyInputV1
    registry_source: text
    bindings: [CollectionRegistryBindingV1]
    backend: text
    input_digest: text
    plans_found: i64
    findings_found: i64
    blockers_found: i64
    functions_scanned: i64
    nodes_scanned: i64

export CollectionCurrentArchiveAnalysisV1
