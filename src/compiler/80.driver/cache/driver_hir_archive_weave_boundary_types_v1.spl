# Complete successful weave-stage results. Public records alone are not
# capabilities: the actual factory/replayer and private registered byte pins
# in driver_hir_archive_weave_boundary_v1 govern every accepted read.
use compiler.common.cache_contract.hir_owned_artifact_cache_v1.{HirOwnedArtifactContextV1}
use compiler.driver.cache.driver_hir_archive_inventory_v1.{DriverHirArchiveInventoryV1}
use compiler.driver.cache.driver_cold_hir_weave_body_v1.{DriverColdHirWeaveBodyV1}
use compiler.driver.cache.driver_hir_post_validation_policy_v1.{DriverHirPostValidationPolicyOwnerV1}
use compiler.driver.cache.driver_hir_post_validation_gate_facts_v1.{DriverHirPostValidationGateReportV1}

struct DriverHirArchiveWeaveBoundaryUseV1:
    cache: HirOwnedArtifactContextV1
    boundary_key: text
    boundary_digest: text
    source_binding: text
    schedule_digest: text
    policy_key: text
    config_binding: text
    physical_inventory: DriverHirArchiveInventoryV1
    # Actual first physical source labels used by retained declaration/layout
    # publication. This is independent of alias-inclusive mono order.
    declaration_order: [text]
    logical_order: [text]
    logical_frames: Dict<text, DriverColdHirWeaveBodyV1>
    physical_module_keys: [text]
    physical_frames: Dict<text, DriverColdHirWeaveBodyV1>

struct DriverHirArchiveWeaveBoundaryV1:
    use: DriverHirArchiveWeaveBoundaryUseV1
    policy: DriverHirPostValidationPolicyOwnerV1
    gate_report: DriverHirPostValidationGateReportV1
    gate_parent_key: text
    gate_parent_digest: text
    woven_count: i64

export DriverHirArchiveWeaveBoundaryUseV1, DriverHirArchiveWeaveBoundaryV1
