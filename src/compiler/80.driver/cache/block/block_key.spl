# BlockKey — per-function/block cache identity (Semantic Incremental Build v2, C5 first slice).
#
# Identity is Nominal-Adapton style: a block is keyed by its DECLARED NAME PATH
# plus a disambiguator (e.g. overload signature), never by position in the file.
# An unrelated edit above a function therefore does not shift its key.
#
# Every digest routes through the ONE canonical encoder in action_key.spl
# (canon_str/canon_nat/canon_field/canon_seq). Domain-separated sub-digests
# ("simple/block/v1", "simple/block-body/v1") follow the same pattern as
# interface_digest_of / resolution_witness_digest — no second hash scheme and
# no new frozen-schema KEY field.

use std.common.crypto.sha256.{sha256_text}
use compiler.driver.cache.action_key.{
    canon_str, canon_nat, canon_field, canon_seq,
    ActionDep, action_key_sort_deps
}

# Stable identity of a block inside a module: declared name path (e.g.
# "app.core.handle") + disambiguator (overload/monomorph signature; "" if none).
struct BlockRef:
    name_path: text
    disambiguator: text

# Every input that can affect a block's compiled artifact.
struct BlockKey:
    domain: text                # "simple/block/v1"
    name_path: text
    disambiguator: text
    body_tokens_digest: text    # digest of the block's canonical body tokens (ORDERED)
    dep_ifaces: [ActionDep]     # referenced external symbols: (symbol path, interface digest); set, sorted
    options_hash: text          # compile options hash (from compile_options_hash)

fn block_domain() -> text:
    "simple/block/v1"

# Stable textual id used as the node name in the block dependency graph.
fn block_ref_id(r: BlockRef) -> text:
    if r.disambiguator == "":
        return r.name_path
    r.name_path + "#" + r.disambiguator

# Digest of the block's canonical body tokens. Token order IS semantic — the
# sequence is NOT sorted (mirrors resolution_witness ordered probes).
fn block_body_digest(tokens: [text]) -> text:
    var items: [text] = []
    for t in tokens:
        items.push(canon_str(t))
    sha256_text(canon_field("simple/block-body/v1", canon_seq(items)))

fn block_key_encode(key: BlockKey) -> text:
    val deps_sorted = action_key_sort_deps(key.dep_ifaces)
    var dep_items: [text] = []
    for d in deps_sorted:
        var fields: [text] = []
        fields.push(canon_field("moduleId", canon_str(d.module_id)))
        fields.push(canon_field("ifaceDigest", canon_str(d.iface_digest)))
        dep_items.push(canon_seq(fields))
    var inner: [text] = []
    inner.push(canon_field("namePath", canon_str(key.name_path)))
    inner.push(canon_field("disambiguator", canon_str(key.disambiguator)))
    inner.push(canon_field("bodyTokensDigest", canon_str(key.body_tokens_digest)))
    inner.push(canon_field("depIfaces", canon_seq(dep_items)))
    inner.push(canon_field("optionsHash", canon_str(key.options_hash)))
    canon_field(key.domain, canon_seq(inner))

fn block_key_digest(key: BlockKey) -> text:
    sha256_text(block_key_encode(key))

# Convenience constructor from raw inputs.
fn block_key_make(r: BlockRef, body_tokens: [text], dep_ifaces: [ActionDep], options_hash: text) -> BlockKey:
    BlockKey(domain: block_domain(),
             name_path: r.name_path,
             disambiguator: r.disambiguator,
             body_tokens_digest: block_body_digest(body_tokens),
             dep_ifaces: dep_ifaces,
             options_hash: options_hash)

export BlockRef, BlockKey
export block_domain, block_ref_id, block_body_digest
export block_key_encode, block_key_digest, block_key_make
