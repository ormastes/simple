# codex-impl
# Fail-closed structural contract for the V2 worker admission adapter.
#
# The exact `scope_owner.admit_three_payload_worker_v2(grant, files, prepared,
# policy)` port is present, but remains fail-closed until the physical broker
# returns restricted descriptor authority.  A copied projection never
# substitutes for the opaque owner-retained grant.

use compiler.common.cache_contract.three_payload_compile_v2.{
    ThreePayloadFallbackV1
}
use compiler.common.cache_contract.three_payload_worker_v1.{
    ThreePayloadWorkerPolicyV1
}
use compiler.driver.cache.closure.three_payload_closure_packer_v2.{PreparedThreePayloadV2}
use compiler.driver.cache.gateway.semantic_scope_live_owner_v2.{
    SemanticScopeLiveOwnerV2, LiveSemanticCompletenessV2,
    AdmittedThreePayloadWorkerV2
}
use compiler.driver.cache.worker.three_payload_physical_file_broker_v1.{
    ThreePayloadPhysicalFileSetV1
}

pub struct ThreePayloadWorkerAdmissionContractV2:
    schema: i64
    maximum_runs_per_grant: i64
    maximum_publications_per_grant: i64
    validation_repeatable_while_reserved: bool
    successful_publication_consumes_grant: bool
    durable_retry_relaunches_worker: bool
    reverse_reference_coordinator_only: bool
    requires_live_scope_owner: bool
    requires_restricted_physical_descriptors: bool
    sealed_physical_parse_slice_available: bool
    full_type_hir_native_available: bool
    authority_available: bool

pub fn three_payload_worker_admission_contract_v2(
) -> ThreePayloadWorkerAdmissionContractV2:
    ThreePayloadWorkerAdmissionContractV2(
        schema: 2,
        maximum_runs_per_grant: 1,
        maximum_publications_per_grant: 1,
        validation_repeatable_while_reserved: true,
        successful_publication_consumes_grant: true,
        durable_retry_relaunches_worker: false,
        reverse_reference_coordinator_only: true,
        requires_live_scope_owner: true,
        requires_restricted_physical_descriptors: true,
        sealed_physical_parse_slice_available: true,
        full_type_hir_native_available: false,
        authority_available: false)

pub fn three_payload_worker_admission_contract_valid_v2(
    contract: ThreePayloadWorkerAdmissionContractV2,
) -> bool:
    contract.schema == 2 and
        contract.maximum_runs_per_grant == 1 and
        contract.maximum_publications_per_grant == 1 and
        contract.validation_repeatable_while_reserved and
        contract.successful_publication_consumes_grant and
        not contract.durable_retry_relaunches_worker and
        contract.reverse_reference_coordinator_only and
        contract.requires_live_scope_owner and
        contract.requires_restricted_physical_descriptors and
        contract.sealed_physical_parse_slice_available and
        not contract.full_type_hir_native_available and
        not contract.authority_available

pub fn three_payload_worker_admission_available_v2() -> bool:
    false

# True means only that the owner may reserve one sealed physical snapshot for
# the bounded parser.  It does not advertise full type/HIR/native compilation,
# semantic body fetching, RR access, or generation publication.
pub fn three_payload_worker_parse_slice_available_v2() -> bool:
    true

pub fn three_payload_worker_admission_blocker_v2() -> text:
    "descriptor_identity_equality_parent_release_and_executor_authority_unavailable"

# Admission is an extension on the canonical live owner, so reserving a grant
# can only mutate the retained row selected by the opaque handle.  Physical
# preflight reads exactly source, original-prior-TLD (if any), and current
# sealed init-TLD.  It has no RR or semantic body path.  The owner then retains
# the already sealed DTO; no path/descriptor escapes this boundary.
impl SemanticScopeLiveOwnerV2:
    pub me admit_three_payload_worker_v2(
        grant: LiveSemanticCompletenessV2,
        files: ThreePayloadPhysicalFileSetV1,
        prepared: PreparedThreePayloadV2,
        policy: ThreePayloadWorkerPolicyV1,
    ) -> Result<AdmittedThreePayloadWorkerV2, ThreePayloadFallbackV1>:
        # V2 has no trusted execution identity and must never reserve a run.
        # V3 replaces this copied-policy port with one owner-only transaction.
        Err(ThreePayloadFallbackV1.AuthorityUnavailable)
