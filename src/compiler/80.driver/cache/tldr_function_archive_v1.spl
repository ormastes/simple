# Bridge the canonical cold HIR producer and admitted package archive reader.
# The existing package receipt authenticates interface.smf; the current module
# index binds source/ABI and the receipt binds compiler/configuration identity.
use compiler.hir.archive.tldr_function_header_v1.{TldrFunctionHeaderAuthorityV1, AdmittedTldrFunctionImportV1,
    tldr_function_rows_from_hir_v1, tldr_function_header_prefix_v1,
    tldr_function_header_admit_v1}
use compiler.hir.archive.interface_action_archive.{InterfaceActionArchiveV1,
    interface_action_archive_symbols_decode_v1}
use compiler.hir.hir_types.{HirModule}
use compiler.mir._MirLowering.provider_metadata.{mir_provider_function_name}
use compiler.driver.cache.package_module_index.{PackageModuleIndexEntryV1}
use compiler.driver.cache.package_archive_types.{PackageArchiveReceiptV1}
use std.common.crypto.sha256.{sha256_text}

fn tldr_function_archive_interface_v1(module: HirModule,
        module_identity: text, abi_digest: text) -> Result<text, text>:
    var linkage: Dict<text, text> = {}
    for function in module.functions.values():
        linkage[function.name] = mir_provider_function_name(
            module.name, module.symbols, function, false)
    val rows = match tldr_function_rows_from_hir_v1(module, linkage):
        case Ok(value): value
        case Err(reason): return Err(reason)
    var encoded = "symbol|{module_identity}|module|{abi_digest}|{abi_digest}"
    for row in rows:
        val fields = row.split("|")
        if fields.len() == 3 and fields[0] == "body-required":
            encoded = encoded + "\nsymbol|{module_identity}#{fields[1]}|function-body-demand-v1|{fields[2]}|{abi_digest}"
            continue
        # The typed producer constructed these five delimiter-safe fields.
        if fields.len() != 5: return Err("tldr-producer-record-invalid")
        encoded = encoded + "\nsymbol|{module_identity}#{fields[1]}|function-header-v1|{fields[2]};{fields[3]};{fields[4]}|{abi_digest}"
    Ok(encoded)

# This validation accepts the old module-only representation for ordinary
# compilation. Strict header-only imports reject it at admission below.
fn tldr_function_archive_interface_valid_v1(content: text,
        module_identity: text, abi_digest: text) -> bool:
    val decoded = interface_action_archive_symbols_decode_v1(content)
    if decoded.is_err(): return false
    val symbols = decoded.unwrap()
    if symbols.len() == 0 or symbols[0].name != module_identity or
            symbols[0].kind != "module" or symbols[0].type_identity != abi_digest or
            symbols[0].semantic_digest != abi_digest:
        return false
    for symbol in symbols:
        if symbol.name == module_identity: continue
        if symbol.kind == "function-body-demand-v1":
            if not symbol.name.starts_with(module_identity + "#") or
                    symbol.semantic_digest != abi_digest or
                    not ["unsupported", "overload"].contains(symbol.type_identity):
                return false
            continue
        if symbol.kind != "function-header-v1" or
                not symbol.name.starts_with(module_identity + "#") or
                symbol.semantic_digest != abi_digest or
                symbol.type_identity.split(";").len() != 3:
            return false
    true

# Call only with a successfully decoded, pinned archive and an entry from its
# already-admitted current index generation. No path or digest is user supplied.
fn tldr_function_archive_admit_v1(archive: InterfaceActionArchiveV1,
        receipt: PackageArchiveReceiptV1,
        entry: PackageModuleIndexEntryV1) -> Result<AdmittedTldrFunctionImportV1, text>:
    if archive.package_key != receipt.package_key or
            receipt.package_key != entry.package_identity or
            archive.producer_digest != receipt.producer_digest:
        return Err("tldr-archive-owner-mismatch")
    var authority = TldrFunctionHeaderAuthorityV1(entry.module_identity,
        entry.source_digest, receipt.producer_digest, receipt.variant_digest,
        entry.abi_digest, "")
    val prefix = match tldr_function_header_prefix_v1(authority):
        case Ok(value): value
        case Err(reason): return Err(reason)
    var rows: [text] = []
    for symbol in archive.interface_symbols:
        if not symbol.name.starts_with(entry.module_identity + "#"): continue
        if symbol.kind == "function-body-demand-v1":
            if symbol.semantic_digest != entry.abi_digest:
                return Err("tldr-archive-abi-mismatch")
            val name = symbol.name.substring(entry.module_identity.len() + 1)
            rows.push("body-required|{name}|{symbol.type_identity}")
            continue
        if symbol.kind != "function-header-v1": continue
        if symbol.semantic_digest != entry.abi_digest:
            return Err("tldr-archive-abi-mismatch")
        val fields = symbol.type_identity.split(";")
        if fields.len() != 3: return Err("tldr-archive-signature-invalid")
        val name = symbol.name.substring(entry.module_identity.len() + 1)
        rows.push("function|{name}|{fields[0]}|{fields[1]}|{fields[2]}")
    if rows.len() == 0: return Err("tldr-body-required:archive-has-no-function-headers")
    val payload = prefix + rows.join("\n") + "\n"
    # These bytes are a projection of authenticated archive rows. This digest
    # pins the in-memory projection; it does not replace archive admission.
    authority.payload_digest = sha256_text(payload)
    val admitted = tldr_function_header_admit_v1(payload, authority)
    if admitted.is_err(): return Err(admitted.unwrap_err())
    # Retain the result we just authenticated. HIR consumes this immutable
    # compile-owned value instead of hashing and parsing the same bytes again.
    Ok(AdmittedTldrFunctionImportV1(payload, authority, Some(admitted.unwrap())))

export AdmittedTldrFunctionImportV1, tldr_function_archive_interface_v1
export tldr_function_archive_interface_valid_v1, tldr_function_archive_admit_v1
