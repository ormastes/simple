# Body-free identity encoding only. No public function in this module issues
# source-body custody; issuance belongs to the actual driver lower transaction.
use compiler.driver.driver_compiler_type.{CompilerDriver}
use compiler.driver.cache.hir_body_typecheck_lease_v1.{HirBodyArchiveV1, HirBodyArchiveInputV1}
use compiler.hir.hir_codec_support.{HirCodecWriter}
use compiler.frontend.frontend_advisory_preprocess_port_v1.{FrontendAdvisoryPreprocessPolicyV1}
use compiler.frontend.frontend_target_cfg_receipt_v1.{frontend_cfg_receipt_valid_v1}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}

struct DriverHirSourceBodyCustodyV1:
    archive: HirBodyArchiveV1
    driver_word: i64
    driver_serial: i64
    source_index: i64
    context_digest: text

fn driver_hir_source_body_frontend_policy_v1(driver: CompilerDriver) -> text:
    val policy: FrontendAdvisoryPreprocessPolicyV1 = driver.ctx.frontend_advisory_policy
    match policy:
        case FrontendAdvisoryPreprocessPolicyV1.Reference: "reference"
        case FrontendAdvisoryPreprocessPolicyV1.PreferSimd: "prefer-simd"
        case FrontendAdvisoryPreprocessPolicyV1.RequireSimd: "require-simd"

fn driver_hir_source_body_lowerer_context_v1(driver: CompilerDriver,
        input: HirBodyArchiveInputV1, explicit_semantic_policy: bool, forbid_written_any: bool) -> text:
    if not driver.streaming_surface_owner_ready or input.library_mode != driver.ctx.options.library_mode: return ""
    if val Some(schedule) = driver.hir_archive_schedule:
        if input.closure_digest != schedule.closure_digest or schedule.source_binding == "" or
                schedule.schedule_digest == "": return ""
        var writer = HirCodecWriter.create()
        writer.put_text(schedule.source_binding)
        writer.put_text(schedule.schedule_digest)
        writer.put_text(input.closure_digest)
        writer.put_i64(schedule.surface_generation)
        writer.put_i64(schedule.entry_source_index)
        writer.put_bool(schedule.shard_mode)
        writer.put_text(input.producer_header)
        writer.put_text(input.provider_selection_digest)
        writer.put_text(input.runtime_provider_receipt_path)
        writer.put_text(input.runtime_provider_digest)
        writer.put_text(driver.ctx.native_target)
        writer.put_text(driver_hir_source_body_frontend_policy_v1(driver))
        writer.put_bool(driver.ctx.runtime_std_full_inventory_selection != nil)
        writer.put_text(driver.ctx.environment_variant_frontend_cache_identity)
        writer.put_text(driver.ctx.environment_variant_frontend_owner_id.to_text())
        writer.put_text(driver.ctx.environment_variant_frontend_session_id.to_text())
        writer.put_text(driver.ctx.environment_variant_frontend_generation.to_text())
        writer.put_bool(explicit_semantic_policy)
        writer.put_bool(forbid_written_any)
        if driver.ctx.options.library_mode != "":
            writer.put_text("library-mode-v1")
            writer.put_text(driver.ctx.options.library_mode)
        sha256_text("driver-private-source-lowerer-v1\n" + writer.finish())
    else:
        ""

fn driver_hir_source_body_context_in_owned_scope_v1(driver: CompilerDriver,
        archive: HirBodyArchiveV1, source_index: i64,
        explicit_semantic_policy: bool, forbid_written_any: bool) -> text:
    if transient_array_scope_state_v1() != 1 or not driver.streaming_surface_owner_ready:
        return ""
    val ctx = driver.ctx
    if source_index < 0 or source_index >= ctx.source_module_names_owner.len() or
            source_index >= ctx.source_paths_owner.len() or source_index >= ctx.source_identities_owner.len() or
            source_index >= ctx.source_authored_paths_owner.len() or source_index >= ctx.source_byte_lengths_owner.len():
        return ""
    val input = archive.input
    if input.module_name == "" or input.source_path != ctx.source_paths_owner[source_index] or
            input.source_content_digest != ctx.source_identities_owner[source_index] or
            input.source_authored_path != ctx.source_authored_paths_owner[source_index] or
            input.provider_selection_digest == "" or input.producer_header == "": return ""
    if val Some(schedule) = driver.hir_archive_schedule:
        if schedule.closure_digest != input.closure_digest or schedule.source_binding == "" or
                schedule.schedule_digest == "" or schedule.surface_generation != driver.streaming_module_surfaces_owner.generation:
            return ""
        var writer = HirCodecWriter.create()
        writer.put_text(schedule.source_binding)
        writer.put_text(schedule.schedule_digest)
        writer.put_text(schedule.closure_digest)
        writer.put_i64(schedule.surface_generation)
        writer.put_i64(schedule.entry_source_index)
        writer.put_bool(schedule.shard_mode)
        writer.put_text(ctx.source_module_names_owner[source_index])
        writer.put_i64(source_index)
        writer.put_i64(ctx.source_byte_lengths_owner[source_index])
        writer.put_text(input.source_path)
        writer.put_text(input.source_authored_path)
        writer.put_text(input.source_content_digest)
        writer.put_bool(input.is_entry)
        writer.put_text(input.module_name)
        writer.put_text(input.stage)
        writer.put_text(input.producer_header)
        writer.put_text(input.provider_selection_digest)
        writer.put_text(input.runtime_provider_receipt_path)
        writer.put_text(input.runtime_provider_digest)
        writer.put_text(ctx.native_target)
        writer.put_bool(explicit_semantic_policy)
        writer.put_bool(forbid_written_any)
        if driver.ctx.options.library_mode != "":
            writer.put_text("library-mode-v1")
            writer.put_text(driver.ctx.options.library_mode)
        writer.put_text(driver_hir_source_body_frontend_policy_v1(driver))
        writer.put_text(ctx.environment_variant_frontend_cache_identity)
        writer.put_text(ctx.environment_variant_frontend_owner_id.to_text())
        writer.put_text(ctx.environment_variant_frontend_session_id.to_text())
        writer.put_text(ctx.environment_variant_frontend_generation.to_text())
        if ctx.runtime_std_full_inventory_selection != nil:
            if not ctx.runtime_std_cfg_source_identity_by_path.has(input.source_path) or
                    not ctx.runtime_std_cfg_source_digest_by_path.has(input.source_path): return ""
            val identity = ctx.runtime_std_cfg_source_identity_by_path[input.source_path]
            val digest = ctx.runtime_std_cfg_source_digest_by_path[input.source_path]
            if not ctx.runtime_std_cfg_decisions.has(identity): return ""
            val receipt = ctx.runtime_std_cfg_decisions[identity]
            if not frontend_cfg_receipt_valid_v1(receipt, identity, digest, ctx.native_target): return ""
            writer.put_text("target-cfg")
            writer.put_text(identity)
            writer.put_text(digest)
            writer.put_text(receipt.preprocessed_digest)
            writer.put_text(receipt.decision_digest)
        else:
            writer.put_text("selected-advisory")
        sha256_text("driver-issued-source-body-context-v1\n" + writer.finish())
    else:
        ""

export DriverHirSourceBodyCustodyV1, driver_hir_source_body_context_in_owned_scope_v1
export driver_hir_source_body_frontend_policy_v1
export driver_hir_source_body_lowerer_context_v1
