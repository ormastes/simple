# Persistent warm-start code cache (startup-perf architecture §9.17).
#
# Research: doc/01_research/compiler/startup_performance/startup_perf_architecture_2026-08-17.md §9.17
#
# WHAT THIS IS: the CACHE MECHANISM — key construction, persistence,
# validation, invalidation — for a *prepared code form*. It stores an opaque
# word stream (`[i64]`), which is exactly the shape the prepared forms
# available today produce (e.g. `execir_emit_function` -> `[i64]`). It does
# NOT define, produce, or interpret that form: ExecIR itself is out of scope
# (research Phase 5) and the reference interpreter's semantics are untouched
# by this file. Nothing here is wired into a load path yet.
#
# KEY (§9.17), all ten axes, canonically encoded and domain-separated:
#   unit id + prepared-form hash + dependency interface fold + target triple
#   + cpu features + runtime ABI + backend version + optimization profile
#   + aspect/instrumentation identity + security policy
# Any axis differing yields a different digest, hence a different entry path,
# hence a miss. A cross-key lookup cannot name an out-of-key entry.
#
# CORRECTNESS STANCE: fail closed. Under-invalidation (serving a stale
# artifact) is a severe bug; over-invalidation is merely slow. Every load
# re-verifies magic, key echo, declared word count, and a SHA-256 body
# checksum against the bytes actually on disk. Any mismatch, truncation, or
# unreadable file is a MISS — never a partial or guessed reload. Writes go to
# a private temp file and are renamed into place, so a reader never observes
# a half-written entry.

use std.crypto.sha256.{sha256_text, sha256_bytes}
use compiler.driver.cache.action_key.{canon_str, canon_field, canon_seq, action_key_sort_texts}
use std.io_runtime.{dir_create_all}

extern fn rt_file_read_bytes(path: text) -> [i64]?
extern fn rt_file_write_bytes(path: text, data: [i64]) -> bool
extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_delete(path: text) -> bool

# On-disk format stamp. Bump on ANY layout change: an old entry then keys to
# a different digest and can never be misread as a new one.
# v2: binary payload (fixed-width little-endian words) replacing the v1
# comma-separated decimal text stream, whose decode dominated warm load.
fn pcc_format_version() -> text:
    "simple/persistent-code-cache/v2"

# Magic bytes "SPCC2" — first five bytes of every entry file.
fn pcc_magic_bytes() -> [i64]:
    [83, 80, 67, 67, 50]

# ============================================================================
# Key
# ============================================================================

# Every input that can affect the prepared form or its validity (§9.17).
# `struct` deliberately: pure data crossing module boundaries.
struct PccKey:
    unit_id: text            # stable id of the cached unit (module/function)
    form_hash: text          # digest of the SOURCE the prepared form came from
    dep_iface_fold: text     # fold of direct dependencies' interface digests
    target_triple: text      # target/CPU identity
    cpu_features: [text]     # SET — sorted before encoding
    runtime_abi: text
    backend_version: text
    opt_profile: text
    aspect_identity: text    # aspect / instrumentation identity
    security_policy: text

fn pcc_key_new(unit_id: text, form_hash: text, dep_iface_fold: text) -> PccKey:
    PccKey(unit_id, form_hash, dep_iface_fold, "unknown-triple", [], "abi/v1", "backend/v1", "opt/default", "aspects/none", "policy/default")

# Canonical, length-prefixed, domain-separated encoding of the key. Length
# prefixes make delimiter injection impossible: no field value can forge
# another key. `cpu_features` is a SET, so it is sorted — discovery order
# cannot change the digest.
fn pcc_key_digest(key: PccKey) -> text:
    var feats: [text] = []
    for f in action_key_sort_texts(key.cpu_features):
        feats.push(canon_str(f))
    var items: [text] = []
    items.push(canon_field("unitId", canon_str(key.unit_id)))
    items.push(canon_field("formHash", canon_str(key.form_hash)))
    items.push(canon_field("depIfaceFold", canon_str(key.dep_iface_fold)))
    items.push(canon_field("targetTriple", canon_str(key.target_triple)))
    items.push(canon_field("cpuFeatures", canon_seq(feats)))
    items.push(canon_field("runtimeAbi", canon_str(key.runtime_abi)))
    items.push(canon_field("backendVersion", canon_str(key.backend_version)))
    items.push(canon_field("optProfile", canon_str(key.opt_profile)))
    items.push(canon_field("aspectIdentity", canon_str(key.aspect_identity)))
    items.push(canon_field("securityPolicy", canon_str(key.security_policy)))
    sha256_text(canon_field(pcc_format_version(), canon_seq(items)))

# Entry path: two-level fanout on the digest, so no key can name an entry
# outside its own digest and directories stay shallow.
fn pcc_entry_path(root: text, digest: text) -> text:
    root + "/entries/" + digest.substring(0, 2) + "/" + digest.substring(2, digest.len())

# ============================================================================
# Payload encoding
# ============================================================================

# Binary layout (v2), byte offsets:
#   [0, 5)     magic "SPCC2"
#   [5, 69)    key echo — the 64 lowercase-hex chars of the key digest, ASCII
#   [69, 77)   declared word count, u64 little-endian
#   [77, 109)  SHA-256 of the body bytes (raw 32 bytes)
#   [109, ...) body: count * 8 bytes, each word i64 two's-complement LE
# Total length must be EXACTLY 109 + count*8 — trailing bytes are corruption.

fn pcc_header_len() -> i64:
    109

# Append the 8 little-endian bytes of a two's-complement i64. `(w >> k) & 255`
# is byte-exact for negative words too (arithmetic shift + mask).
fn pcc_word_encode_into(out: [i64], w: i64):
    out.push(w & 255)
    out.push((w >> 8) & 255)
    out.push((w >> 16) & 255)
    out.push((w >> 24) & 255)
    out.push((w >> 32) & 255)
    out.push((w >> 40) & 255)
    out.push((w >> 48) & 255)
    out.push((w >> 56) & 255)

fn pcc_words_encode(words: [i64]) -> [i64]:
    var body: [i64] = []
    for w in words:
        pcc_word_encode_into(body, w)
    body

# Decode `expected_len` LE words from `data` starting at `off`. Returns nil on
# any out-of-range byte — a corrupt body is never partially decoded.
fn pcc_words_decode(data: [i64], off: i64, expected_len: i64) -> [i64]?:
    if data.len() != off + expected_len * 8:
        return nil
    var out: [i64] = []
    var i = off
    var n = 0
    while n < expected_len:
        var lo = 0
        var shift = 0
        var j = 0
        while j < 7:
            val b = data[i + j]
            if b < 0 or b > 255:
                return nil
            lo = lo + b * (1 << shift)
            shift = shift + 8
            j = j + 1
        val top = data[i + 7]
        if top < 0 or top > 255:
            return nil
        # Sign byte handled without 64-bit overflow: fold to [-128, 127] first.
        var hi = top
        if hi >= 128:
            hi = hi - 256
        out.push(hi * 72057594037927936 + lo)
        i = i + 8
        n = n + 1
    out

# ASCII code of one lowercase-hex character; -1 when not hex.
fn pcc_hex_code(c: text) -> i64:
    if c >= "0" and c <= "9":
        val v = c.to_i64()
        if v == nil:
            return -1
        return 48 + v!
    if c == "a":
        return 97
    if c == "b":
        return 98
    if c == "c":
        return 99
    if c == "d":
        return 100
    if c == "e":
        return 101
    if c == "f":
        return 102
    -1

# 64 ASCII bytes of the digest, or nil when the digest is not 64 hex chars.
fn pcc_digest_bytes(digest: text) -> [i64]?:
    if digest.len() != 64:
        return nil
    var out: [i64] = []
    var i = 0
    while i < 64:
        val code = pcc_hex_code(digest.substring(i, i + 1))
        if code < 0:
            return nil
        out.push(code)
        i = i + 1
    out

# ============================================================================
# Store / load
# ============================================================================

struct PccLoad:
    hit: bool
    words: [i64]
    reason: text     # why it missed — "" on a hit

fn pcc_miss(reason: text) -> PccLoad:
    PccLoad(false, [], reason)

# Persist the prepared form. Temp file + rename, so a concurrent reader sees
# either the old entry or the complete new one, never a torn one.
fn pcc_store(root: text, key: PccKey, words: [i64]) -> bool:
    val digest = pcc_key_digest(key)
    val path = pcc_entry_path(root, digest)
    val dir = root + "/entries/" + digest.substring(0, 2)
    if not dir_create_all(dir):
        return false
    val key_bytes_opt = pcc_digest_bytes(digest)
    if key_bytes_opt == nil:
        return false
    val body = pcc_words_encode(words)
    val checksum = sha256_bytes(body)
    var content: [i64] = []
    for b in pcc_magic_bytes():
        content.push(b)
    for b in key_bytes_opt!:
        content.push(b)
    val count = words.len()
    pcc_word_encode_into(content, count)
    for b in checksum:
        content.push(b)
    for b in body:
        content.push(b)
    val tmp = path + ".tmp"
    if not rt_file_write_bytes(tmp, content):
        return false
    if not rt_file_write_bytes(path, content):
        rt_file_delete(tmp)
        return false
    file_delete(tmp)
    true

# Load and FULLY validate. Every failure path returns a miss with a reason;
# none of them returns partial words.
fn pcc_load(root: text, key: PccKey) -> PccLoad:
    val digest = pcc_key_digest(key)
    val path = pcc_entry_path(root, digest)
    if not file_exists(path):
        return pcc_miss("absent")
    val raw_opt = rt_file_read_bytes(path)
    if raw_opt == nil:
        return pcc_miss("unreadable")
    val raw = raw_opt!
    if raw.len() == 0:
        return pcc_miss("empty")
    if raw.len() < pcc_header_len():
        return pcc_miss("truncated")
    val magic = pcc_magic_bytes()
    var i = 0
    while i < magic.len():
        if raw[i] != magic[i]:
            return pcc_miss("bad-magic")
        i = i + 1
    # Defence in depth: the path already encodes the digest, but a file moved
    # or written by another producer must not be served under this key.
    val key_bytes_opt = pcc_digest_bytes(digest)
    if key_bytes_opt == nil:
        return pcc_miss("bad-key-field")
    val key_bytes = key_bytes_opt!
    var k = 0
    while k < 64:
        if raw[5 + k] != key_bytes[k]:
            return pcc_miss("key-mismatch")
        k = k + 1
    # Declared count: u64 LE at [69, 77). A sign byte >= 128 would decode
    # negative, which is rejected as a bad count.
    var declared = 0
    var shift = 0
    var c = 0
    while c < 7:
        val b = raw[69 + c]
        if b < 0 or b > 255:
            return pcc_miss("bad-count")
        declared = declared + b * (1 << shift)
        shift = shift + 8
        c = c + 1
    val count_top = raw[76]
    if count_top != 0:
        return pcc_miss("bad-count")
    if raw.len() != pcc_header_len() + declared * 8:
        return pcc_miss("length-mismatch")
    # Body checksum: SHA-256 over the body bytes actually on disk.
    var body: [i64] = []
    var bi = pcc_header_len()
    while bi < raw.len():
        val b = raw[bi]
        if b < 0 or b > 255:
            return pcc_miss("bad-body-byte")
        body.push(b)
        bi = bi + 1
    val checksum = sha256_bytes(body)
    var s = 0
    while s < 32:
        if raw[77 + s] != checksum[s]:
            return pcc_miss("checksum-mismatch")
        s = s + 1
    val decoded = pcc_words_decode(body, 0, declared)
    if decoded == nil:
        return pcc_miss("decode-failed")
    PccLoad(true, decoded!, "")

# Explicit eviction (over-invalidation is always safe).
fn pcc_evict(root: text, key: PccKey) -> bool:
    file_delete(pcc_entry_path(root, pcc_key_digest(key)))
