# Complete only the actual no-namespace-read path. Positive macro reads require
# the independent semantic access owner; absence of that owner is not empty scope.
use compiler.common.cache_contract.directory_category_projection_v2.{DirectoryCategoryProjectionV2,
    directory_category_projection_valid_v2}
use compiler.common.cache_contract.directory_macro_projection_v2.{DirectoryMacroProjectionV2}
use compiler.frontend.cache_artifact.macro_category_projection_v2.{MacroCategoryDraftV2,
    macro_category_project_all_v2}
use compiler.frontend.cache_artifact.macro_namespace_read_coverage_v2.{macro_category_complete_no_reads_v2}

pub fn directory_macro_capture_no_reads_v2(draft: MacroCategoryDraftV2,
        source: DirectoryCategoryProjectionV2) -> Result<DirectoryMacroProjectionV2, text>:
    if not directory_category_projection_valid_v2(source) or
            draft.source_identity != source.source_identity or draft.source_digest != source.source_digest or
            draft.target_triple != source.target_triple or
            draft.preprocessed_digest != source.preprocessed_digest or
            draft.cfg_decision_digest != source.cfg_decision_digest or
            draft.environment_policy_digest != source.environment_policy_digest:
        return Err("directory-macro-source-projection-mismatch")
    val completed = macro_category_complete_no_reads_v2(draft)?
    val projected = macro_category_project_all_v2([completed.input])?
    if projected.len() != 1: return Err("directory-macro-projection-cardinality")
    val result = projected[0]
    if result.input.source.source_id != draft.source.source_id or
            result.input.source.module != draft.source.module:
        return Err("directory-macro-projection-origin-mismatch")
    Ok(DirectoryMacroProjectionV2(source: source, source_epoch: draft.source_epoch,
        executing_image_digest: draft.executing_image_digest, definition_root: result.definition_root,
        input_root: result.input_root, effect_surface: result.effect_surface,
        active_guard_root: result.active_guard_root, category_root: result.category_root,
        read_coverage: "no-namespace-reads/v2"))
