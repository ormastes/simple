# Called only by the accepted native capsule owner after source revalidation.
# Inputs are observations from that owner, not an application admission API.
use compiler.driver.driver_types.{CompileContext}
use compiler.common.cache_contract.mir_initializer_plan_v1.{MirInitializerObjectReceiptV1}
use compiler.common.cache_contract.directory_category_projection_v2.{directory_category_projection_valid_v2}
use compiler.common.cache_contract.physical_tld_v1.{three_payload_contract_digest_valid_v1}
use compiler.mir.mir_initializer_receipt_v1.{mir_initializer_plan_finalize_v1}
use compiler.driver.driver_source_parse_support.{driver_parse_transient_scope_begin_v1,
    driver_parse_transient_scope_pause_v1, driver_parse_transient_scope_end_v1, rt_transient_heap_promote}
use std.common.crypto.sha256.{sha256_text}

pub fn driver_capture_initializer_object_v1(ctx: CompileContext, module_name: text,
        source_path: text, source_digest: text, object_path: text, object_digest: text, object_size: i64,
        capsule_identity: text) -> bool:
    ctx.initializer_object_receipts_v1.remove(module_name)
    if not ctx.directory_category_projections_v2.has(source_path) or
            not ctx.mir_modules.has(module_name) or object_path == "" or object_size <= 0 or capsule_identity == "" or
            not three_payload_contract_digest_valid_v1(source_digest) or
            not three_payload_contract_digest_valid_v1(object_digest): return false
    val category = ctx.directory_category_projections_v2[source_path]
    if not directory_category_projection_valid_v2(category) or
            category.canonical_path != source_path or category.source_digest != source_digest or
            category.target_triple != ctx.native_target or
            category.environment_policy_digest != ctx.environment_variant_policy_digest: return false
    val image_result = ctx.kernel_image_digest_provider()
    if image_result.is_err(): return false
    val image = image_result.unwrap()
    if not three_payload_contract_digest_valid_v1(image.sha256): return false
    # begin refuses nested/foreign ownership. Do not reset frontend globals when
    # ending this non-parser scope; only the compact receipt escapes scratch.
    if not driver_parse_transient_scope_begin_v1(): return false
    val body_result = mir_initializer_plan_finalize_v1(ctx.mir_modules[module_name])
    if body_result.is_err():
        if not driver_parse_transient_scope_end_v1():
            panic("initializer scratch scope close failed")
        return false
    val bodies = body_result.unwrap()
    if bodies.plan.module_identity != module_name:
        if not driver_parse_transient_scope_end_v1():
            panic("initializer scratch scope close failed")
        return false
    val receipt = MirInitializerObjectReceiptV1(
        module_identity: module_name, source_path: source_path, source_digest: source_digest,
        target_triple: category.target_triple, environment_policy_digest: category.environment_policy_digest,
        executing_image_digest: image.sha256, capsule_identity_digest: sha256_text(capsule_identity),
        object_path: object_path, object_digest: object_digest, object_size: object_size, category: category, bodies: bodies)
    if not driver_parse_transient_scope_pause_v1():
        if not driver_parse_transient_scope_end_v1():
            panic("initializer scratch scope close failed")
        return false
    val promoted = rt_transient_heap_promote(receipt)
    val ended = driver_parse_transient_scope_end_v1()
    if not promoted or not ended:
        panic("initializer receipt ownership failed")
    ctx.initializer_object_receipts_v1[module_name] = receipt
    true
