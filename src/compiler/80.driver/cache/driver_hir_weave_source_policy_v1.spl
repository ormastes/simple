# Genuine source-claim replay for the post-HIR boundary. Read the admitted
# physical snapshot, keep authored spelling as metadata, and run the driver's
# actual selected frontend. Complete parser bodies remain in one file lease.
use compiler.driver.driver_compiler_type.{CompilerDriver}
use compiler.driver.driver_source_pipeline_parsing.{driver_promote_retained_frontend_owners_v1,
    driver_end_transient_parse_scope}
use compiler.driver.cache.hir_body_typecheck_lease_v1.{HirBodyArchiveV1, hir_body_archive_matches_v1}
use compiler.driver.cache.driver_hir_post_validation_policy_v1.{DriverHirPostValidationPolicyOwnerV1,
    driver_hir_post_validation_policy_load_in_owned_scope_v1, driver_hir_policy_source_claims_match_in_owned_scope_v1}
use compiler.frontend.layer_eq_registry.{layer_eq_registry_owner_snapshot_v1,
    layer_eq_registry_owner_restore_v1, layer_eq_registry_reset}
use compiler.frontend.effect_registry.{effect_registry_owner_snapshot_v1,
    effect_registry_owner_restore_v1, effect_registry_reset}
use compiler.frontend.rt_criticality_registry.{rt_criticality_registry_owner_snapshot_v1,
    rt_criticality_registry_owner_restore_v1, rt_criticality_reset}
use compiler.frontend.aspect_registry.{aspect_registry_owner_snapshot_v1,
    aspect_registry_owner_restore_v1, aspect_registry_reset}
use compiler.frontend.core.parser.{parser_initialization_generation_v1, par_had_error_get}
use compiler.core.ast.{ast_prepare_persistent_owner_v1}
use compiler.common.driver_source_file.{source_file_coverage_identity}
use std.nogc_sync_mut.io.file_ops.{file_read_regular_no_follow_bounded}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause, transient_promote}

fn driver_hir_weave_source_policy_in_owned_scope_v1(driver: CompilerDriver,
        owner: DriverHirPostValidationPolicyOwnerV1, archive: HirBodyArchiveV1,
        source_index: i64, identities: [text]) -> Result<bool, text>:
    val ctx = driver.ctx
    val input = archive.input
    if transient_array_scope_state_v1() != 1 or source_index < 0 or
            source_index >= ctx.source_module_names_owner.len() or
            ctx.source_paths_owner.len() != ctx.source_module_names_owner.len() or
            ctx.source_identities_owner.len() != ctx.source_module_names_owner.len() or
            ctx.source_authored_paths_owner.len() != ctx.source_module_names_owner.len() or
            ctx.source_byte_lengths_owner.len() != ctx.source_module_names_owner.len() or
            ctx.source_paths_owner[source_index] != input.source_path or
            ctx.source_identities_owner[source_index] != input.source_content_digest or
            ctx.source_authored_paths_owner[source_index] != input.source_authored_path or
            not hir_body_archive_matches_v1(archive, input):
        return Err("post-HIR source policy differs from actual canonical snapshot row")
    val policy = driver_hir_post_validation_policy_load_in_owned_scope_v1(owner)?
    val bytes = file_read_regular_no_follow_bounded(ctx.source_paths_owner[source_index], 67108864)?
    val loaded = source_file_coverage_identity(input.source_path, bytes)
    if loaded.0 != input.source_authored_path or sha256_text(loaded.1) != input.source_content_digest or
            loaded.1.len() != ctx.source_byte_lengths_owner[source_index]:
        return Err("post-HIR source policy physical bytes or authored metadata changed")
    # Each registry reset creates a fresh owner. The caller restores the actual
    # old roots before closing this lease, including on every Err path.
    layer_eq_registry_reset()
    effect_registry_reset()
    rt_criticality_reset()
    aspect_registry_reset()
    val parsed = driver.parse_full_frontend_in_borrowed_scope_selected_uncached_v1(loaded.1,
        input.source_path, ctx.source_module_names_owner[source_index])
    if parsed.is_err(): return Err(parsed.unwrap_err())
    if par_had_error_get(): return Err("post-HIR source policy actual frontend reported parse errors")
    if not driver_hir_policy_source_claims_match_in_owned_scope_v1(owner, policy, identities):
        return Err("post-HIR captured claim rows differ from actual source producer")
    Ok(true)

pub fn driver_hir_weave_source_policy_v1(driver: CompilerDriver,
        owner: DriverHirPostValidationPolicyOwnerV1, archive: HirBodyArchiveV1,
        source_index: i64, identities: [text]) -> Result<bool, text>:
    if transient_array_scope_state_v1() != 0:
        return Err("post-HIR source policy foreign lease occupied")
    if driver.ctx.modules.len() != 0:
        return Err("post-HIR source policy cannot reclaim a retained parser owner")
    # O(1) root snapshots, taken outside scratch; no cumulative-map encoding or
    # cloning occurs here. Per-module parser resets replace before mutation.
    val layer = layer_eq_registry_owner_snapshot_v1()
    val effect = effect_registry_owner_snapshot_v1()
    val rt = rt_criticality_registry_owner_snapshot_v1()
    val aspect = aspect_registry_owner_snapshot_v1()
    ast_prepare_persistent_owner_v1()
    val generation = parser_initialization_generation_v1()
    if not transient_scope_begin(): return Err("post-HIR source policy lease unavailable")
    val result = driver_hir_weave_source_policy_in_owned_scope_v1(driver, owner, archive, source_index, identities)
    layer_eq_registry_owner_restore_v1(layer)
    effect_registry_owner_restore_v1(effect)
    rt_criticality_registry_owner_restore_v1(rt)
    aspect_registry_owner_restore_v1(aspect)
    val entered = generation != parser_initialization_generation_v1()
    var cfg_published = false
    if driver.ctx.runtime_std_full_inventory_selection != nil and
            driver.ctx.runtime_std_cfg_source_identity_by_path.has(archive.input.source_path):
        val identity = driver.ctx.runtime_std_cfg_source_identity_by_path[archive.input.source_path]
        cfg_published = driver.ctx.runtime_std_cfg_decisions.has(identity)
    val paused = transient_scope_pause()
    val owned = if paused: transient_promote(result) else: false
    val frontend = if paused: driver_promote_retained_frontend_owners_v1(entered) else: false
    val cfg = if paused and cfg_published:
        driver.promote_target_cfg_receipt_v1(archive.input.source_path)
    else: paused
    val ended = driver_end_transient_parse_scope()
    if not paused or not owned or not frontend or not cfg or not ended:
        panic("post-HIR source policy replay ownership failed")
    result

export driver_hir_weave_source_policy_v1
