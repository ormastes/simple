# ActionKey — canonical encoder for the global cache identity layer (Option C).
#
# Phase 1: compute-and-log only. NOT wired into any load path.
#
# Source of truth (this file mirrors the formally verified Lean model):
#   src/verification/cache_identity/src/CacheIdentity/Model.lean
#   doc/03_plan/compiler/cache/global_cas_interpreter_cache_option_c_plan_2026-07-24.md (§1.1)
#
# Encoding is domain-separated and length-prefixed (mirrors the Lean `Canon`
# tree, serialised):
#   field(tag, v) -> "F" + len(tag) + ":" + tag + enc(v)
#   str(s)        -> "S" + len(s) + ":" + s
#   nat(n)        -> "N" + decimal(n) + ";"
#   seq(items)    -> "Q" + count + ":" + concat(enc(item)...)
# Length prefixes make delimiter injection impossible: a value containing
# "|" or ":" cannot forge another key.
#
# Set-typed fields are sorted before encoding (mirrors Lean canonKey):
#   deps by (module_id, iface_digest) lexicographic; cfg_features and
#   ct_env_inputs lexicographic. Resolution-witness candidate probes stay
#   ORDERED — probe order is semantic there (mirrors plan §1.1).

use std.common.crypto.sha256.{sha256_text}
use std.common.crypto.types.{text_to_bytes}

# ============================================================================
# Structs (mirror Model.lean: Dep, ActionKey)
# ============================================================================

# One dependency: depended module's stable id + its *interface* digest.
struct ActionDep:
    module_id: text
    iface_digest: text

# Every input that can affect the produced interpreter-module artifact.
# EXACTLY the 15 fields of Model.lean's ActionKey, in the same order.
struct ActionKey:
    domain: text                # domain separation, e.g. "simple/interpreter-module/v1"
    compiler_exe: text          # sha of the compiler executable
    live_compiler_src: text     # sha of live interpreted compiler source
    schema_version: i64
    target_triple: text
    host_arch: text
    cfg_features: [text]        # set; canonicalised by sort
    stdlib_variant: text
    runtime_family: text
    source_content: text        # sha of module source bytes
    resolution_witness: text    # sha from resolution_witness_digest
    deps: [ActionDep]           # set; canonicalised by sort
    macro_root: text
    aop_selection: text
    ct_env_inputs: [text]       # set; canonicalised by sort

# One ordered candidate probe of the resolver (order is semantic).
# Named `found` because `exists` is a reserved keyword.
struct ResolutionProbe:
    path: text
    found: bool

# ============================================================================
# Canonical text ordering (byte-wise lexicographic, mirrors Lean String `<`)
# ============================================================================

fn action_key_text_lt(a: text, b: text) -> bool:
    val ab = text_to_bytes(a)
    val bb = text_to_bytes(b)
    val an = ab.len()
    val bn = bb.len()
    var i = 0
    while i < an and i < bn:
        val ca = ab[i] as i64
        val cb = bb[i] as i64
        if ca < cb:
            return true
        if ca > cb:
            return false
        i = i + 1
    an < bn

# Mirrors Lean strLe: a < b || a == b
fn action_key_text_le(a: text, b: text) -> bool:
    if action_key_text_lt(a, b):
        return true
    a == b

# Mirrors Lean depLe: lexicographic on (module_id, iface_digest).
fn action_dep_le(a: ActionDep, b: ActionDep) -> bool:
    if action_key_text_lt(a.module_id, b.module_id):
        return true
    if a.module_id == b.module_id:
        return action_key_text_le(a.iface_digest, b.iface_digest)
    false

# Insertion sort (mirrors Lean insStr/sortStrs).
fn action_key_sort_texts(items: [text]) -> [text]:
    var out: [text] = []
    for item in items:
        var placed = false
        var next: [text] = []
        for s in out:
            if not placed and action_key_text_le(item, s):
                next.push(item)
                placed = true
            next.push(s)
        if not placed:
            next.push(item)
        out = next
    out

# Insertion sort (mirrors Lean insDep/sortDeps).
fn action_key_sort_deps(items: [ActionDep]) -> [ActionDep]:
    var out: [ActionDep] = []
    for item in items:
        var placed = false
        var next: [ActionDep] = []
        for d in out:
            if not placed and action_dep_le(item, d):
                next.push(item)
                placed = true
            next.push(d)
        if not placed:
            next.push(item)
        out = next
    out

# ============================================================================
# Canonical encoding primitives (serialised Lean `Canon` constructors)
# ============================================================================

fn canon_str(s: text) -> text:
    "S" + "{s.len()}" + ":" + s

fn canon_nat(n: i64) -> text:
    "N" + "{n}" + ";"

fn canon_field(tag: text, encoded_value: text) -> text:
    "F" + "{tag.len()}" + ":" + tag + encoded_value

fn canon_seq(encoded_items: [text]) -> text:
    val body = encoded_items.join("")
    "Q" + "{encoded_items.len()}" + ":" + body

# Mirrors Lean encodeDep.
fn canon_dep(d: ActionDep) -> text:
    var items: [text] = []
    items.push(canon_field("moduleId", canon_str(d.module_id)))
    items.push(canon_field("ifaceDigest", canon_str(d.iface_digest)))
    canon_seq(items)

# ============================================================================
# Encoder + digest (mirror Lean encode; field order is FIXED)
# ============================================================================

fn action_key_encode(key: ActionKey) -> text:
    val cfg_sorted = action_key_sort_texts(key.cfg_features)
    val env_sorted = action_key_sort_texts(key.ct_env_inputs)
    val deps_sorted = action_key_sort_deps(key.deps)

    var cfg_items: [text] = []
    for c in cfg_sorted:
        cfg_items.push(canon_str(c))
    var env_items: [text] = []
    for e in env_sorted:
        env_items.push(canon_str(e))
    var dep_items: [text] = []
    for d in deps_sorted:
        dep_items.push(canon_dep(d))

    var inner: [text] = []
    inner.push(canon_field("compilerExe", canon_str(key.compiler_exe)))
    inner.push(canon_field("liveCompilerSrc", canon_str(key.live_compiler_src)))
    inner.push(canon_field("schemaVersion", canon_nat(key.schema_version)))
    inner.push(canon_field("targetTriple", canon_str(key.target_triple)))
    inner.push(canon_field("hostArch", canon_str(key.host_arch)))
    inner.push(canon_field("cfgFeatures", canon_seq(cfg_items)))
    inner.push(canon_field("stdlibVariant", canon_str(key.stdlib_variant)))
    inner.push(canon_field("runtimeFamily", canon_str(key.runtime_family)))
    inner.push(canon_field("sourceContent", canon_str(key.source_content)))
    inner.push(canon_field("resolutionWitness", canon_str(key.resolution_witness)))
    inner.push(canon_field("deps", canon_seq(dep_items)))
    inner.push(canon_field("macroRoot", canon_str(key.macro_root)))
    inner.push(canon_field("aopSelection", canon_str(key.aop_selection)))
    inner.push(canon_field("ctEnvInputs", canon_seq(env_items)))

    # Mirrors Lean: Canon.field k.domain (Canon.seq [...])
    canon_field(key.domain, canon_seq(inner))

fn action_key_digest(key: ActionKey) -> text:
    sha256_text(action_key_encode(key))

# ============================================================================
# Sub-digest helpers (plan §1.1)
# ============================================================================

# InterfaceDigest — downstream-visible semantics only. Parts are a SET of
# canonical interface-item texts; sorted here so callers need not pre-sort.
fn interface_digest_of(parts: [text]) -> text:
    val sorted = action_key_sort_texts(parts)
    var items: [text] = []
    for p in sorted:
        items.push(canon_str(p))
    sha256_text(canon_field("simple/interface/v1", canon_seq(items)))

# ============================================================================
# ActionKey v2 (schema_version: 2) — C0 frozen extension (Agent C1)
#
# Source of truth: doc/03_plan/compiler/cache/c0_schema_freeze_2026-08-09.md §1
# Positions 0-14 are BYTE-IDENTICAL to v1 above (same tags, same order, same
# sort rules) so the v1 proofs (Model.lean) extend rather than break. Positions
# 15-20 are APPENDED, never interleaved. A separate struct/encoder (not a
# widening of ActionKey) is used deliberately: ActionKey has zero callers but
# an existing golden-digest spec (test/01_unit/compiler/cache/action_key_spec.spl,
# owned by another agent) pins its 15-field literal construction and its v1
# golden digest string; widening that struct in place would break both without
# being this agent's file to edit. ActionKeyV2 is the v2 canonical type; v1
# stays exactly as proven.
# ============================================================================

# 10 real values (backed) — see cache_protocol.sdn `enums.result_kind`.
# Encoded by NAME (never ordinal) so future values never perturb old digests.
enum ResultKind:
    InterpreterModule
    MirModule
    ObjectFile
    InterfaceSummary
    Diagnostics
    AopWeaveArtifact
    AdviceArtifact
    AspectPack
    BlockTransferResult
    FunctionSummary
    LinkProduct

fn result_kind_to_text(k: ResultKind) -> text:
    match k:
        case InterpreterModule: "interpreter_module"
        case MirModule: "mir_module"
        case ObjectFile: "object_file"
        case InterfaceSummary: "interface_summary"
        case Diagnostics: "diagnostics"
        case AopWeaveArtifact: "aop_weave_artifact"
        case AdviceArtifact: "advice_artifact"
        case AspectPack: "aspect_pack"
        case BlockTransferResult: "block_transfer_result"
        case FunctionSummary: "function_summary"
        case LinkProduct: "link_product"

# The v2 canonical key: v1's 15 fields (0-14, unchanged names/order) plus the
# six frozen extension fields (15-20). Field count and order NEVER vary —
# unbacked fields (16-19; no producer in the tree today per freeze note §1)
# always carry the sentinel below rather than being omitted, so the C6
# `fields == theorems` coverage gate stays stable across the whole rollout.
struct ActionKeyV2:
    domain: text
    compiler_exe: text
    live_compiler_src: text
    schema_version: i64
    target_triple: text
    host_arch: text
    cfg_features: [text]        # set; canonicalised by sort
    stdlib_variant: text
    runtime_family: text
    source_content: text
    resolution_witness: text
    deps: [ActionDep]           # set; canonicalised by sort
    macro_root: text
    aop_selection: text
    ct_env_inputs: [text]       # set; canonicalised by sort
    schema_digest: text                        # pos 15 — schema_digest_of_protocol
    aop_surface_root: text                     # pos 16 — SPEC_FORWARD; sentinel until backed
    aop_candidate_partition_roots: [text]       # pos 17 — set; SPEC_FORWARD; empty until backed
    aop_weave_root: text                        # pos 18 — SPEC_FORWARD; sentinel until backed
    block_manifest_roots: [text]                # pos 19 — set; SPEC_FORWARD; empty until backed
    result_kind: ResultKind                     # pos 20

# Fixed sentinel digest for an unbacked single-digest field (positions 16, 18):
# the canonical encoding of the empty seq, domain-separated so it can never
# collide with a real artifact/root digest.
fn action_key_v2_sentinel_root_digest() -> text:
    sha256_text(canon_field("simple/cache-sentinel/empty-root/v2", canon_seq([])))

# Unbacked set fields (positions 17, 19) simply encode as the empty set — no
# separate sentinel value is needed for a set; "no roots yet" IS the empty set.
fn action_key_v2_empty_root_set() -> [text]:
    val empty: [text] = []
    empty

fn action_key_v2_encode(key: ActionKeyV2) -> text:
    val cfg_sorted = action_key_sort_texts(key.cfg_features)
    val env_sorted = action_key_sort_texts(key.ct_env_inputs)
    val deps_sorted = action_key_sort_deps(key.deps)
    val aop_candidate_sorted = action_key_sort_texts(key.aop_candidate_partition_roots)
    val block_manifest_sorted = action_key_sort_texts(key.block_manifest_roots)

    var cfg_items: [text] = []
    for c in cfg_sorted:
        cfg_items.push(canon_str(c))
    var env_items: [text] = []
    for e in env_sorted:
        env_items.push(canon_str(e))
    var dep_items: [text] = []
    for d in deps_sorted:
        dep_items.push(canon_dep(d))
    var aop_candidate_items: [text] = []
    for r in aop_candidate_sorted:
        aop_candidate_items.push(canon_str(r))
    var block_manifest_items: [text] = []
    for r in block_manifest_sorted:
        block_manifest_items.push(canon_str(r))

    var inner: [text] = []
    # Positions 1-14: byte-identical to v1 (same tags, same order).
    inner.push(canon_field("compilerExe", canon_str(key.compiler_exe)))
    inner.push(canon_field("liveCompilerSrc", canon_str(key.live_compiler_src)))
    inner.push(canon_field("schemaVersion", canon_nat(key.schema_version)))
    inner.push(canon_field("targetTriple", canon_str(key.target_triple)))
    inner.push(canon_field("hostArch", canon_str(key.host_arch)))
    inner.push(canon_field("cfgFeatures", canon_seq(cfg_items)))
    inner.push(canon_field("stdlibVariant", canon_str(key.stdlib_variant)))
    inner.push(canon_field("runtimeFamily", canon_str(key.runtime_family)))
    inner.push(canon_field("sourceContent", canon_str(key.source_content)))
    inner.push(canon_field("resolutionWitness", canon_str(key.resolution_witness)))
    inner.push(canon_field("deps", canon_seq(dep_items)))
    inner.push(canon_field("macroRoot", canon_str(key.macro_root)))
    inner.push(canon_field("aopSelection", canon_str(key.aop_selection)))
    inner.push(canon_field("ctEnvInputs", canon_seq(env_items)))
    # Positions 15-20: v2 extension, APPENDED.
    inner.push(canon_field("schemaDigest", canon_str(key.schema_digest)))
    inner.push(canon_field("aopSurfaceRoot", canon_str(key.aop_surface_root)))
    inner.push(canon_field("aopCandidatePartitionRoots", canon_seq(aop_candidate_items)))
    inner.push(canon_field("aopWeaveRoot", canon_str(key.aop_weave_root)))
    inner.push(canon_field("blockManifestRoots", canon_seq(block_manifest_items)))
    inner.push(canon_field("resultKind", canon_str(result_kind_to_text(key.result_kind))))

    canon_field(key.domain, canon_seq(inner))

fn action_key_v2_digest(key: ActionKeyV2) -> text:
    sha256_text(action_key_v2_encode(key))

# Convenience: build an ActionKeyV2 from a v1 ActionKey plus the v2-only
# fields. Passing sentinels for 16/17/18/19 and a schema_digest/result_kind
# for 15/20 reproduces the "prefix-compatibility" shape the freeze note (§3)
# describes: only the appended suffix differs from a pure v1 encoding.
fn action_key_v2_from_v1(v1: ActionKey, schema_digest: text, result_kind: ResultKind) -> ActionKeyV2:
    ActionKeyV2(
        domain: v1.domain,
        compiler_exe: v1.compiler_exe,
        live_compiler_src: v1.live_compiler_src,
        schema_version: v1.schema_version,
        target_triple: v1.target_triple,
        host_arch: v1.host_arch,
        cfg_features: v1.cfg_features,
        stdlib_variant: v1.stdlib_variant,
        runtime_family: v1.runtime_family,
        source_content: v1.source_content,
        resolution_witness: v1.resolution_witness,
        deps: v1.deps,
        macro_root: v1.macro_root,
        aop_selection: v1.aop_selection,
        ct_env_inputs: v1.ct_env_inputs,
        schema_digest: schema_digest,
        aop_surface_root: action_key_v2_sentinel_root_digest(),
        aop_candidate_partition_roots: action_key_v2_empty_root_set(),
        aop_weave_root: action_key_v2_sentinel_root_digest(),
        block_manifest_roots: action_key_v2_empty_root_set(),
        result_kind: result_kind
    )

# ResolutionWitness — records how the resolver arrived at its choice.
# Candidate probes stay ORDERED (probe order is semantic; NOT sorted).
fn resolution_witness_digest(probes: [ResolutionProbe], selected: text, dir_generation: text, resolver_version: text) -> text:
    var probe_items: [text] = []
    for p in probes:
        val found_nat = if p.found: 1 else: 0
        var fields: [text] = []
        fields.push(canon_field("path", canon_str(p.path)))
        fields.push(canon_field("found", canon_nat(found_nat)))
        probe_items.push(canon_seq(fields))
    var inner: [text] = []
    inner.push(canon_field("probes", canon_seq(probe_items)))
    inner.push(canon_field("selected", canon_str(selected)))
    inner.push(canon_field("dirGeneration", canon_str(dir_generation)))
    inner.push(canon_field("resolverVersion", canon_str(resolver_version)))
    sha256_text(canon_field("simple/resolution-witness/v1", canon_seq(inner)))
