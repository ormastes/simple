# Actual ordered root barrier and FIFO consumer. Persistent owners contain
# compact declarations and complete-body artifact descriptors, never HirModule.
use compiler.mono.mono_archive_registration_v1.{MonoArchiveRegistrationOwnerV1,
    MonoArchiveCurrentRegistrationOwnerV1, MonoArchiveRootOrderV1, mono_archive_registration_schedule_digest_v1}
use compiler.mono.mono_archive_state_v1.{mono_archive_state_digest_v1, mono_archive_delta_digest_v1}
use compiler.mono.monomorphize_integration.{mono_sym_key}
use compiler.driver.cache.hir_mono_archive_consumer_v1.{MonoArchiveAdmissionV1,
    MonoArchiveRepositoryV1, MonoArchivePublicationV1, mono_archive_repository_digest_v1,
    mono_archive_rewrite_root_v1, mono_archive_drain_one_v1, mono_archive_apply_v1,
    mono_archive_output_key_v1, mono_archive_function_record_key_v1}
use compiler.driver.driver_hir_cache.{hir_cache_enabled, hir_cache_last_warnings,
    hir_cache_promote_diagnostic_owner_v1, hir_cache_clear_last_warnings}
use std.io_runtime.{env_get}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause,
    transient_scope_end, transient_promote}

var _mono_archive_execution_expected_ready_v1: bool = false
var _mono_archive_execution_expected_states_v1: Dict<i64, text> = {}

class MonoArchiveExecutionV1:
    admission: MonoArchiveAdmissionV1
    roots: [MonoArchiveRootOrderV1]
    schedule_digest: text
    root_module_cursor: i64
    root_function_cursor: i64
    expected_epoch: i64
    root_records: Dict<text, MonoArchivePublicationV1>
    specialization_records: [MonoArchivePublicationV1]
    # Captured only when an exact produced publication is actually applied.
    publication_ledger_digest: text
    diagnostics: [text]
    warnings: [text]
    generic_functions: i64
    generic_structs: i64
    generic_classes: i64
    call_sites_found: i64
    specializations_created: i64
    unresolved_generic_calls: i64

fn mono_archive_root_schedule_digest_v1(roots: [MonoArchiveRootOrderV1]) -> text:
    mono_archive_registration_schedule_digest_v1(roots)

fn mono_archive_execution_ledger_extend_v1(previous: text, receipt: MonoArchivePublicationV1, kind: text) -> text:
    if previous.len() != 64 or (kind != "root" and kind != "fifo") or
            receipt.stage != "mono-function-rewrite-v2" or
            receipt.function_archive_key != mono_archive_function_record_key_v1(receipt) or
            receipt.output_archive_key != mono_archive_output_key_v1(receipt) or
            receipt.delta_digest != mono_archive_delta_digest_v1(receipt.delta): return ""
    sha256_text("mono-applied-publication-ledger-v1\n" + previous + "\n" + kind + "\n" + receipt.output_archive_key)

fn mono_archive_execution_ledger_digest_v1(owner: MonoArchiveExecutionV1) -> text:
    var digest = sha256_text("mono-applied-publication-ledger-empty-v1")
    var epoch = 0
    var missing = false
    for module in owner.roots:
        for symbol in module.symbols:
            val key = mono_sym_key(module.module_name, symbol)
            if not owner.root_records.has(key):
                missing = true
                continue
            val receipt = owner.root_records[key]
            if missing or receipt.delta.base_epoch != epoch or receipt.delta.advance_cursor: return ""
            digest = mono_archive_execution_ledger_extend_v1(digest, receipt, "root")
            if digest == "": return ""
            epoch = epoch + 1
    if missing and owner.specialization_records.len() != 0: return ""
    for receipt in owner.specialization_records:
        if receipt.delta.base_epoch != epoch or not receipt.delta.advance_cursor: return ""
        digest = mono_archive_execution_ledger_extend_v1(digest, receipt, "fifo")
        if digest == "": return ""
        epoch = epoch + 1
    if epoch != owner.expected_epoch: return ""
    digest

fn mono_archive_execution_append_seal_v1(owner: MonoArchiveExecutionV1,
        receipt: MonoArchivePublicationV1, kind: text) -> Result<text, text>:
    if receipt.delta.base_epoch != owner.expected_epoch: return Err("mono publication base epoch differs")
    if not transient_scope_begin(): return Err("mono publication seal scope unavailable")
    val digest = mono_archive_execution_ledger_extend_v1(owner.publication_ledger_digest, receipt, kind)
    val valid = digest != ""
    val paused = transient_scope_pause()
    val owned = if paused and valid: transient_promote(digest) else: false
    mono_archive_execution_close_v1(paused, valid, owned)
    if valid: return Ok(digest)
    Err("mono publication complete seal refused")

fn mono_archive_execution_close_v1(paused: bool, admitted: bool, owned: bool):
    val cache_owned = if paused: hir_cache_promote_diagnostic_owner_v1() else: false
    if paused: hir_cache_clear_last_warnings()
    val ended = transient_scope_end()
    if not paused or not ended or not cache_owned or (admitted and not owned):
        panic("mono execution ownership")

fn mono_archive_execution_create_v1(owner: MonoArchiveRegistrationOwnerV1,
        expected_inventory: Dict<text, text>, expected_order: [text]) -> Result<MonoArchiveExecutionV1, text>:
    if owner.logical_mode: return Err("logical current owner cannot enter unresolved execution")
    mono_archive_execution_create_repository_v1(owner,
        MonoArchiveRepositoryV1(modules: owner.archives, authority: owner.state.facts.body_authority),
        expected_inventory, expected_order, "", "")

fn mono_archive_current_execution_create_v1(current: MonoArchiveCurrentRegistrationOwnerV1,
        expected_inventory: Dict<text, text>, expected_order: [text]) -> Result<MonoArchiveExecutionV1, text>:
    val owner = current.registration
    mono_archive_execution_create_repository_v1(owner,
        MonoArchiveRepositoryV1(modules: owner.archives, authority: owner.state.facts.body_authority,
            current_bodies: current.bodies, current_cache: Some(current.cache), current_order: expected_order,
            current_mode: true, logical_mode: owner.logical_mode),
        expected_inventory, expected_order, current.published_digest, current.sealed_digest)

fn mono_archive_execution_create_repository_v1(owner: MonoArchiveRegistrationOwnerV1,
        repository: MonoArchiveRepositoryV1, expected_inventory: Dict<text, text>, expected_order: [text],
        published_current_digest: text, sealed_current_digest: text) -> Result<MonoArchiveExecutionV1, text>:
    if transient_array_scope_state_v1() != 0: return Err("mono execution factory requires closed scope")
    if not _mono_archive_execution_expected_ready_v1:
        _mono_archive_execution_expected_states_v1 = {}
        _mono_archive_execution_expected_ready_v1 = true
    # Recheck the admitted schedule at the handoff; sealing does not authorize
    # another caller to reorder the mutable root descriptor array afterwards.
    if not owner.sealed or not hir_cache_enabled() or hir_cache_last_warnings().len() != 0:
        return Err("mono execution registration owner unavailable")
    if not transient_scope_begin(): return Err("mono execution scope unavailable")
    var valid = owner.state.epoch == 0 and owner.state.cursor == 0 and
        owner.state.queue.len() == 0 and owner.state.emitted.len() == 0 and
        owner.state.spec_symbols.len() == 0 and owner.archives.len() == expected_inventory.len() and
        owner.roots.len() == expected_order.len() and expected_order.len() == expected_inventory.len() and
        owner.state.facts.feature_policy == env_get("SIMPLE_MONO_LEVELS")
    val schedule = mono_archive_root_schedule_digest_v1(owner.roots)
    var index = 0
    for name in expected_order:
        if not expected_inventory.has(name) or not owner.archives.has(name):
            valid = false
        else:
            if owner.archives[name].input.source_path != expected_inventory[name]: valid = false
        if index >= owner.roots.len():
            valid = false
        else:
            if owner.roots[index].module_name != name: valid = false
        index = index + 1
    val authority = if valid: mono_archive_repository_digest_v1(repository) else: ""
    valid = valid and schedule != "" and schedule == owner.sealed_schedule_digest and
        schedule == owner.published_schedule_digest and authority != "" and
        authority == owner.state.facts.body_authority and mono_archive_state_digest_v1(owner.state) != ""
    if repository.current_mode:
        valid = valid and sealed_current_digest != "" and published_current_digest != "" and
            repository.current_order == expected_order and sealed_current_digest ==
                sha256_text("mono-current-registration-sealed-v1\n" + authority + "\n" +
                    mono_archive_state_digest_v1(owner.state) + "\n" + schedule + "\n" + published_current_digest + "\n{owner.epoch}")
    val state_digest = mono_archive_state_digest_v1(owner.state)
    val paused = transient_scope_pause()
    # @workaround bug=a174_transient_promote_inference_2026_10_16 recover=03d33d497ac6d1408683493f74ff9db434e4cfa3 reason=retain-explicit-text-owner-at-generic-promotion
    val owned = if paused and valid: transient_promote<text>(schedule) and transient_promote<text>(state_digest) else: false
    mono_archive_execution_close_v1(paused, valid, owned)
    if not valid: return Err("mono execution admitted schedule or initial state refused")
    val execution = MonoArchiveExecutionV1(admission: MonoArchiveAdmissionV1(
        repository: repository, state: owner.state),
        roots: owner.roots, schedule_digest: schedule, root_module_cursor: 0,
        root_function_cursor: 0, expected_epoch: 0, root_records: {},
        specialization_records: [], publication_ledger_digest: sha256_text("mono-applied-publication-ledger-empty-v1"),
        diagnostics: [], warnings: [],
        generic_functions: owner.generic_functions, generic_structs: owner.generic_structs,
        generic_classes: owner.generic_classes, call_sites_found: 0,
        specializations_created: 0, unresolved_generic_calls: 0)
    _mono_archive_execution_expected_states_v1[execution as i64] = state_digest
    Ok(execution)

fn mono_archive_execution_preflight_in_owned_scope_v1(owner: MonoArchiveExecutionV1) -> bool:
    if transient_array_scope_state_v1() != 1 or not hir_cache_enabled() or hir_cache_last_warnings().len() != 0: return false
    val authority = mono_archive_repository_digest_v1(owner.admission.repository)
    if not _mono_archive_execution_expected_ready_v1: return false
    val expected_state = _mono_archive_execution_expected_states_v1[owner as i64] ?? ""
    val valid = expected_state != "" and expected_state == mono_archive_state_digest_v1(owner.admission.state) and authority != "" and authority == owner.admission.repository.authority and
        authority == owner.admission.state.facts.body_authority and
        owner.admission.state.epoch == owner.expected_epoch and
        owner.expected_epoch == owner.root_records.len() + owner.specialization_records.len() and
        owner.admission.state.facts.feature_policy == env_get("SIMPLE_MONO_LEVELS") and
        mono_archive_root_schedule_digest_v1(owner.roots) == owner.schedule_digest and
        mono_archive_execution_ledger_digest_v1(owner) == owner.publication_ledger_digest
    valid

fn mono_archive_execution_preflight_v1(owner: MonoArchiveExecutionV1) -> bool:
    if not hir_cache_enabled() or hir_cache_last_warnings().len() != 0: return false
    if not transient_scope_begin(): return false
    val valid = mono_archive_execution_preflight_in_owned_scope_v1(owner)
    val paused = transient_scope_pause()
    mono_archive_execution_close_v1(paused, false, false)
    valid

fn mono_archive_roots_complete_v1(owner: MonoArchiveExecutionV1) -> bool:
    var module_index = owner.root_module_cursor
    var function_index = owner.root_function_cursor
    while module_index < owner.roots.len():
        if function_index < owner.roots[module_index].symbols.len(): return false
        module_index = module_index + 1
        function_index = 0
    true

fn mono_archive_execution_accumulate_v1(owner: MonoArchiveExecutionV1,
        receipt: MonoArchivePublicationV1):
    owner.diagnostics = owner.diagnostics + receipt.delta.diagnostics
    owner.warnings = owner.warnings + receipt.delta.warnings
    owner.call_sites_found = owner.call_sites_found + receipt.delta.call_sites_found
    owner.specializations_created = owner.specializations_created + receipt.delta.specializations_created
    owner.unresolved_generic_calls = owner.unresolved_generic_calls + receipt.delta.unresolved_generic_calls
    owner.expected_epoch = owner.admission.state.epoch
    # Issue only after the real independently replayed publication was applied.
    # Callers cannot reseal edited compact nominal state by supplying a digest.
    if not transient_scope_begin(): panic("mono applied state pin scope")
    val state_digest = mono_archive_state_digest_v1(owner.admission.state)
    val paused = transient_scope_pause()
    val valid = state_digest != ""
    # @workaround bug=a174_transient_promote_inference_2026_10_16 recover=03d33d497ac6d1408683493f74ff9db434e4cfa3 reason=retain-explicit-text-owner-at-generic-promotion
    val owned = if paused and valid: transient_promote<text>(state_digest) else: false
    mono_archive_execution_close_v1(paused, valid, owned)
    if not valid: panic("mono applied state pin refused")
    _mono_archive_execution_expected_states_v1[owner as i64] = state_digest

fn mono_archive_execute_next_root_v1(owner: MonoArchiveExecutionV1) -> Result<MonoArchivePublicationV1, text>:
    if not mono_archive_execution_preflight_v1(owner): return Err("mono root owner changed")
    var module_index = owner.root_module_cursor
    var function_index = owner.root_function_cursor
    while module_index < owner.roots.len() and function_index >= owner.roots[module_index].symbols.len():
        module_index = module_index + 1
        function_index = 0
    if module_index >= owner.roots.len(): return Err("mono root barrier already complete")
    val root = owner.roots[module_index]
    val symbol = root.symbols[function_index]
    val key = mono_sym_key(root.module_name, symbol)
    if owner.root_records.has(key): return Err("mono root already published")
    val produced = mono_archive_rewrite_root_v1(owner.admission, root.module_name, symbol)
    if produced.is_err(): return Err("mono root complete body refused")
    val receipt = produced.unwrap()
    val captured = mono_archive_execution_append_seal_v1(owner, receipt, "root")
    if captured.is_err(): return Err("mono root publication seal refused")
    if receipt.delta.advance_cursor or mono_archive_apply_v1(owner.admission, receipt).is_err():
        return Err("mono root publication refused")
    owner.root_records[key] = receipt
    owner.publication_ledger_digest = captured.unwrap()
    owner.root_module_cursor = module_index
    owner.root_function_cursor = function_index + 1
    mono_archive_execution_accumulate_v1(owner, receipt)
    Ok(receipt)

fn mono_archive_execute_next_specialization_v1(owner: MonoArchiveExecutionV1) -> Result<MonoArchivePublicationV1, text>:
    if not mono_archive_execution_preflight_v1(owner): return Err("mono FIFO owner changed")
    if not mono_archive_roots_complete_v1(owner): return Err("mono root barrier incomplete")
    if owner.admission.state.cursor >= owner.admission.state.queue.len():
        return Err("mono FIFO already complete")
    val produced = mono_archive_drain_one_v1(owner.admission)
    if produced.is_err(): return Err("mono FIFO complete body refused")
    val receipt = produced.unwrap()
    val captured = mono_archive_execution_append_seal_v1(owner, receipt, "fifo")
    if captured.is_err(): return Err("mono FIFO publication seal refused")
    if not receipt.delta.advance_cursor or mono_archive_apply_v1(owner.admission, receipt).is_err():
        return Err("mono FIFO publication refused")
    owner.specialization_records = owner.specialization_records.push(receipt)
    owner.publication_ledger_digest = captured.unwrap()
    mono_archive_execution_accumulate_v1(owner, receipt)
    Ok(receipt)

fn mono_archive_execution_complete_in_owned_scope_v1(owner: MonoArchiveExecutionV1) -> bool:
    if not mono_archive_execution_preflight_in_owned_scope_v1(owner) or not mono_archive_roots_complete_v1(owner): return false
    val state = owner.admission.state
    if state.cursor != state.queue.len() or state.emitted.len() != state.queue.len() or
            owner.specialization_records.len() != state.queue.len(): return false
    var count = 0
    for module in owner.roots:
        for symbol in module.symbols:
            val key = mono_sym_key(module.module_name, symbol)
            if not owner.root_records.has(key): return false
            val receipt = owner.root_records[key]
            if receipt.module_name != module.module_name or receipt.target_symbol != symbol or
                    receipt.delta.advance_cursor: return false
            count = count + 1
    if count != owner.root_records.len(): return false
    var index = 0
    for item in state.queue:
        val receipt = owner.specialization_records[index]
        if not state.emitted.has(item.mangled_name) or receipt.target_name != item.mangled_name or
                receipt.target_symbol != item.symbol_id or receipt.module_name != item.module_name or
                state.emitted[item.mangled_name] != receipt.output_function_digest or not receipt.delta.advance_cursor:
            return false
        index = index + 1
    true

fn mono_archive_execution_complete_v1(owner: MonoArchiveExecutionV1) -> bool:
    if not hir_cache_enabled() or hir_cache_last_warnings().len() != 0: return false
    if not transient_scope_begin(): return false
    val valid = mono_archive_execution_complete_in_owned_scope_v1(owner)
    val paused = transient_scope_pause()
    mono_archive_execution_close_v1(paused, false, false)
    valid

export MonoArchiveExecutionV1
export mono_archive_current_execution_create_v1
export mono_archive_execution_create_v1, mono_archive_roots_complete_v1
export mono_archive_execute_next_root_v1, mono_archive_execute_next_specialization_v1
export mono_archive_execution_complete_v1

export mono_archive_execution_complete_in_owned_scope_v1
