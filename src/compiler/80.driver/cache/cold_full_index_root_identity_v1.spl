# Stable workspace owner for cold package-index generations. SCV tree and
# revision identities are bound separately and change when source bytes change.

use std.common.crypto.sha256.{sha256_text}

fn cold_full_index_workspace_root_generation_v1(source_root: text) -> text:
    val root = source_root.replace("\\", "/")
    if root == "" or root.contains("\n") or root.contains("\r"):
        return ""
    if not root.starts_with("/") and
            not (root.len() >= 3 and root.substring(1, 3) == ":/"):
        return ""
    sha256_text("simple/cold-full-index-workspace-root/v1|{root.len()}:{root}")

export cold_full_index_workspace_root_generation_v1
