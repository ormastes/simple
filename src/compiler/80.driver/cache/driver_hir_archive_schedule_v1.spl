# Actual streaming-owner schedule projection. This is a replayable prerequisite
# recipe, not a final admission token or a production-loop activation switch.
use compiler.driver.driver_types.{CompileContext}
use compiler.driver.driver_source_loading.{_driver_physical_source_key}
use compiler.hir.hir_lowering.module_surface.{ModuleSurfacesByName,
    module_surfaces_retained_alignment_error}
use compiler.driver.driver_hir_cache.{hir_cache_enabled, hir_cache_closure_digest,
    hir_shard_active, hir_shard_levels, hir_shard_visit_order}
use compiler.hir.hir_codec_support.{HirCodecWriter}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause,
    transient_scope_end, transient_promote}

struct DriverHirArchiveScheduleV1:
    source_binding: text
    closure_digest: text
    surface_generation: i64
    entry_source_index: i64
    shard_mode: bool
    visit_order: [i64]
    source_to_surface: [i64]
    # Alias decisions are computed in the actual visit order. A first visited
    # source need not be the first physical row in the phase-1 inventory.
    first_source_for_visit: [i64]
    # Prospective all-source recipe in shard mode, whose actual loop fills a
    # cache and skips context publication. Full publication must refuse it.
    logical_publication_order: [text]
    layout_source_order: [i64]
    layout_module_order: [text]
    schedule_digest: text

fn driver_hir_archive_schedule_in_owned_scope_v1(ctx: CompileContext,
        surfaces: ModuleSurfacesByName, entry: i64) -> Result<DriverHirArchiveScheduleV1, text>:
    val count = ctx.source_module_names_owner.len()
    if count == 0 or ctx.source_paths_owner.len() != count or ctx.source_authored_paths_owner.len() != count or
            ctx.source_identities_owner.len() != count or ctx.source_byte_lengths_owner.len() != count or
            ctx.source_content_hashes_owner.len() != count or entry < -1 or entry >= count:
        return Err("HIR schedule retained phase-1 owner incomplete")
    val alignment = module_surfaces_retained_alignment_error(surfaces)
    if alignment != "": return Err("HIR schedule frozen surface owner refused: " + alignment)
    if not surfaces.frozen or surfaces.generation <= 0: return Err("HIR schedule surface owner is not frozen")
    val closure = hir_cache_closure_digest(surfaces)
    if closure.len() != 64: return Err("HIR schedule current closure unavailable")
    var writer = HirCodecWriter.create()
    writer.put_i64(count)
    var source_to_surface: [i64] = []
    var seen: Dict<text, bool> = {}
    var index = 0
    while index < count:
        val name = ctx.source_module_names_owner[index]
        val path = _driver_physical_source_key(ctx.source_paths_owner[index])
        if name == "" or seen.has(name) or path == "" or not surfaces.index_by_name.has(name):
            return Err("HIR schedule logical source alias absent or duplicate")
        seen[name] = true
        val physical = surfaces.index_by_name[name]
        if physical < 0 or physical >= surfaces.surfaces.len(): return Err("HIR schedule physical surface index refused")
        val surface = surfaces.surfaces[physical]
        val canonical = surface.source_index
        val canonical_path = if canonical >= 0 and canonical < count:
            _driver_physical_source_key(ctx.source_paths_owner[canonical])
        else:
            ""
        if canonical < 0 or canonical >= count or surface.module_name != ctx.source_module_names_owner[canonical] or
                canonical_path == "" or
                _driver_physical_source_key(surface.canonical_path) != canonical_path or
                ctx.source_identities_owner[index].len() != 64 or
                ctx.source_identities_owner[index] != ctx.source_identities_owner[canonical] or
                ctx.source_authored_paths_owner[index] == "" or
                ctx.source_byte_lengths_owner[index] < 0 or
                ctx.source_byte_lengths_owner[index] != surface.content_length or
                ctx.source_content_hashes_owner[index] != (if surface.content_hash == 0: 1 else: surface.content_hash):
            return Err("HIR schedule source differs from actual frozen physical owner")
        source_to_surface.push(physical)
        writer.put_text(name)
        writer.put_text(path)
        writer.put_text(ctx.source_authored_paths_owner[index])
        writer.put_text(ctx.source_identities_owner[index])
        writer.put_i64(ctx.source_byte_lengths_owner[index])
        writer.put_i64(ctx.source_content_hashes_owner[index])
        writer.put_i64(physical)
        writer.put_text(surface.logical_name)
        writer.put_text(surface.canonical_name)
        index = index + 1
    val binding = sha256_text("driver-hir-schedule-source-v1\n" + writer.finish())
    # Exactly the original loop's cache/shard gate and shared visit producer.
    val cache_closure_available = (ctx.config["compiler_explicit_semantic_policy"] ?? "") != "1"
    val shard = hir_shard_active() and cache_closure_available
    if hir_shard_active() and not shard: return Err("HIR schedule shard cache identity unavailable")
    val levels: [i64] = if shard: hir_shard_levels(surfaces) else: []
    val visits = hir_shard_visit_order(ctx.source_module_names_owner, surfaces, levels)
    if visits.len() != count: return Err("HIR schedule visit producer lacks complete source coverage")
    var visited: Dict<i64, bool> = {}
    var first_by_surface: Dict<i64, i64> = {}
    var first_for_visit: [i64] = []
    var logical: [text] = []
    var layout_sources: [i64] = []
    var layout_modules: [text] = []
    for source in visits:
        if source < 0 or source >= count or visited.has(source): return Err("HIR schedule visit producer repeats source")
        visited[source] = true
        val physical = source_to_surface[source]
        if not first_by_surface.has(physical):
            first_by_surface[physical] = source
            layout_sources.push(source)
            layout_modules.push(surfaces.surfaces[physical].logical_name)
        first_for_visit.push(first_by_surface[physical])
        logical.push(ctx.source_module_names_owner[source])
    var digest = HirCodecWriter.create()
    digest.put_text(binding)
    digest.put_text(closure)
    digest.put_i64(surfaces.generation)
    digest.put_i64(entry)
    digest.put_bool(shard)
    digest.put_i64(visits.len())
    for source in visits: digest.put_i64(source)
    for source in first_for_visit: digest.put_i64(source)
    digest.put_i64(layout_sources.len())
    for source in layout_sources: digest.put_i64(source)
    for name in layout_modules: digest.put_text(name)
    Ok(DriverHirArchiveScheduleV1(source_binding: binding, closure_digest: closure,
        surface_generation: surfaces.generation, entry_source_index: entry, shard_mode: shard,
        visit_order: visits, source_to_surface: source_to_surface, first_source_for_visit: first_for_visit,
        logical_publication_order: logical, layout_source_order: layout_sources, layout_module_order: layout_modules,
        schedule_digest: sha256_text("driver-hir-schedule-v1\n" + digest.finish())))

pub fn driver_hir_archive_schedule_from_streaming_owner_v1(ctx: CompileContext,
        surfaces: ModuleSurfacesByName, entry: i64) -> Result<DriverHirArchiveScheduleV1, text>:
    if transient_array_scope_state_v1() != 0: return Err("HIR schedule lease occupied")
    if not hir_cache_enabled(): return Err("HIR schedule archive cache owner unavailable")
    # The actual shard owner lazily retains its environment text. Initialize
    # that process-lifetime memo before scratch ownership starts.
    val _shard_owner_ready = hir_shard_active()
    if not transient_scope_begin(): return Err("HIR schedule lease unavailable")
    val result = driver_hir_archive_schedule_in_owned_scope_v1(ctx, surfaces, entry)
    val paused = transient_scope_pause()
    val owned = if paused: transient_promote(result) else: false
    val ended = transient_scope_end()
    if not paused or not owned or not ended: panic("HIR schedule projection ownership failed")
    result

pub fn driver_hir_archive_schedule_verify_streaming_owner_v1(ctx: CompileContext,
        surfaces: ModuleSurfacesByName, entry: i64, captured: DriverHirArchiveScheduleV1) -> Result<bool, text>:
    if transient_array_scope_state_v1() != 0: return Err("HIR schedule replay lease occupied")
    if not hir_cache_enabled(): return Err("HIR schedule replay owner unavailable")
    val _shard_owner_ready = hir_shard_active()
    if not transient_scope_begin(): return Err("HIR schedule replay owner unavailable")
    val actual = driver_hir_archive_schedule_in_owned_scope_v1(ctx, surfaces, entry)
    val result: Result<bool, text> = if actual.is_err(): Err(actual.unwrap_err()) else:
        driver_hir_archive_schedule_compare_v1(actual.unwrap(), captured)
    val paused = transient_scope_pause()
    val owned = if paused: transient_promote(result) else: false
    val ended = transient_scope_end()
    if not paused or not owned or not ended: panic("HIR schedule replay ownership failed")
    result

fn driver_hir_archive_schedule_compare_v1(actual: DriverHirArchiveScheduleV1,
        captured: DriverHirArchiveScheduleV1) -> Result<bool, text>:
    if actual.source_binding != captured.source_binding or actual.closure_digest != captured.closure_digest or
            actual.surface_generation != captured.surface_generation or actual.entry_source_index != captured.entry_source_index or
            actual.shard_mode != captured.shard_mode or actual.visit_order != captured.visit_order or
            actual.source_to_surface != captured.source_to_surface or actual.first_source_for_visit != captured.first_source_for_visit or
            actual.logical_publication_order != captured.logical_publication_order or actual.layout_source_order != captured.layout_source_order or
            actual.layout_module_order != captured.layout_module_order or actual.schedule_digest != captured.schedule_digest:
        return Err("HIR schedule receipt differs from actual streaming owner replay")
    Ok(true)

export DriverHirArchiveScheduleV1, driver_hir_archive_schedule_from_streaming_owner_v1
export driver_hir_archive_schedule_verify_streaming_owner_v1
