# Actual per-module cold capture mechanics. This consumes a complete live HIR
# body, not a declaration projection. It does not admit a driver stage or SCV
# snapshot: the compilation owner must supply its admitted inventory entry and
# the correct post-validation/post-weave body at the original capture point.
use compiler.hir.hir_types.{HirModule}
use compiler.driver.cache.cold_hir_semantic_seed_v1.{ColdHirTypedReceiptV1,
    cold_hir_typed_receipt_from_admitted_digest_v1}
use compiler.driver.smf.runtime_std_hir_emission_types_v1.{RuntimeStdHirModuleEmissionV1}
use compiler.driver.cache.driver_cold_hir_emission_lease_v1.{driver_cold_hir_emit_in_owned_scope_v1}
use std.scv.compile_source_inventory_core.{CompileSourceInventoryEntryV1}
use compiler.driver.driver_hir_cache.{hir_cache_last_warnings,
    hir_cache_clear_last_warnings, hir_cache_promote_diagnostic_owner_v1}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause,
    transient_scope_end, transient_promote}

struct DriverColdHirModuleInputV1:
    module_identity: text
    source_root: text
    source_identity: text
    source_digest: text
    source_byte_count: i64
    snapshot_inventory_digest: text
    inventory_entry: CompileSourceInventoryEntryV1
    full_inventory: bool
    artifact_root: text
    target_triple: text
    backend: text
    # Exact original phase-1 row for the factory's first physical source.
    # Retained single-module mechanics do not consume this optional binding.
    source_index: i64 = -1

struct DriverColdHirModuleCaptureV1:
    typed_receipt: ColdHirTypedReceiptV1
    emission: RuntimeStdHirModuleEmissionV1?

pub fn driver_cold_hir_capture_module_in_owned_scope_v1(module: HirModule,
        input: DriverColdHirModuleInputV1) -> Result<DriverColdHirModuleCaptureV1, text>:
    if transient_array_scope_state_v1() != 1:
        return Err("cold HIR module capture requires active unpaused ownership")
    if module.name != input.module_identity:
        return Err("cold HIR module capture owner differs")
    val receipt = cold_hir_typed_receipt_from_admitted_digest_v1(module,
        input.module_identity, input.source_root, input.source_identity,
        input.source_digest, input.source_byte_count, input.snapshot_inventory_digest,
        input.inventory_entry)?
    var emission: RuntimeStdHirModuleEmissionV1? = nil
    if input.full_inventory:
        val emitted = driver_cold_hir_emit_in_owned_scope_v1(module, receipt.seed.module_identity,
            input.source_identity, input.source_digest, input.artifact_root, input.target_triple, input.backend)
        if emitted.is_err(): return Err(emitted.unwrap_err().reason)
        emission = Some(emitted.unwrap())
    Ok(DriverColdHirModuleCaptureV1(typed_receipt: receipt, emission: emission))

# Retained-body callers can use the same actual consumer while containing its
# encoding/file-publication scratch. The input HIR belongs to the caller; it is
# never promoted here. Archive callers use the borrowed helper in their own
# decode lease instead, preserving that complete body's actual stage owner.
pub fn driver_cold_hir_capture_module_v1(module: HirModule,
        input: DriverColdHirModuleInputV1) -> Result<DriverColdHirModuleCaptureV1, text>:
    if transient_array_scope_state_v1() != 0 or hir_cache_last_warnings().len() != 0:
        return Err("cold HIR capture lease or diagnostic owner occupied")
    if not transient_scope_begin(): return Err("cold HIR capture scope unavailable")
    val result = driver_cold_hir_capture_module_in_owned_scope_v1(module, input)
    val paused = transient_scope_pause()
    val cache_owned = if paused: hir_cache_promote_diagnostic_owner_v1() else: false
    val owned = if paused: transient_promote(result) else: false
    if paused: hir_cache_clear_last_warnings()
    val ended = transient_scope_end()
    if not paused or not cache_owned or not owned or not ended:
        panic("cold HIR module capture ownership failed")
    result

export DriverColdHirModuleInputV1, DriverColdHirModuleCaptureV1
export driver_cold_hir_capture_module_in_owned_scope_v1, driver_cold_hir_capture_module_v1
