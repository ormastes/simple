# Capture only after a fresh full parser invocation, before its scope ends.
# The existing registry covers logical declarations; ParserModule.aop_advices
# covers physical/MIR declarations. Neither is filtered by current matches.
use compiler.common.cache_contract.directory_aspect_draft_v2.{DirectoryAspectDeclarationV2, DirectoryAspectDraftV2}
use compiler.common.cache_contract.directory_source_epoch_v2.{DirectorySourceEpochV2, directory_source_epoch_valid_v2}
use compiler.common.cache_contract.directory_category_projection_v2.{DirectoryCategoryProjectionV2, directory_category_projection_valid_v2}
use compiler.common.cache_contract.physical_tld_v1.{three_payload_contract_max_items_v1}
use compiler.hir.hir_lowering.module_surface_declarations.{ModuleSurfaceParserOwner}
use compiler.frontend.aspect_registry.{aspect_registry_parser_inventory_v2}


pub fn directory_aspect_capture_v2(owner: ModuleSurfaceParserOwner, parser_path: text,
        source: DirectoryCategoryProjectionV2, epoch: DirectorySourceEpochV2,
        parser_before: i64, parser_after: i64) -> DirectoryAspectDraftV2?:
    if not directory_source_epoch_valid_v2(epoch) or not directory_category_projection_valid_v2(source) or
            parser_path == "" or parser_before < 0 or parser_after <= parser_before:
        return nil
    if owner.aop_advices.len() > three_payload_contract_max_items_v1(): return nil
    var rows: [DirectoryAspectDeclarationV2] = []
    for advice in owner.aop_advices:
        # Preserve invalid/unsupported descriptors for the semantic owner; never
        # erase them and thereby turn an incomplete inventory into known-empty.
        rows = rows.push(DirectoryAspectDeclarationV2(family: "mir", family_inventory_index: rows.len(),
            handler: advice.handler, form: advice.form, selector: advice.pointcut, mode: "static",
            priority: advice.priority, readonly: false, noalloc: false, bounded_time: false))
    val inventory = aspect_registry_parser_inventory_v2(parser_path)
    for declaration in inventory.rows:
        if rows.len() == three_payload_contract_max_items_v1(): return nil
        rows = rows.push(DirectoryAspectDeclarationV2(family: "logical",
            family_inventory_index: declaration.family_inventory_index,
            handler: declaration.handler, form: declaration.kind, selector: declaration.selector,
            mode: declaration.mode, priority: 0, readonly: declaration.readonly,
            noalloc: declaration.noalloc, bounded_time: declaration.bounded_time))
    Some(DirectoryAspectDraftV2(epoch: epoch, source: source,
        declarations: rows, parser_generation: parser_after, coverage_schema: "current-parser-aop/v1",
        inventory_complete: inventory.advice_family_complete,
        inventory_reason: if inventory.advice_family_complete: "" else: "advice-parser-inventory-incomplete"))
