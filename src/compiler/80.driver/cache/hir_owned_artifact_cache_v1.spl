# Compatibility entry for driver consumers. The ONE byte-storage implementation
# lives below MIR and driver; this factory selects actual current cache framing.
use compiler.common.cache_contract.hir_owned_artifact_cache_v1.{
    HirOwnedArtifactContextV1, HIR_OWNED_ARTIFACT_MAX_BYTES_V1,
    hir_owned_artifact_store_blob_v1 as common_artifact_store_v1,
    hir_owned_artifact_load_blob_v1 as common_artifact_load_v1}
use compiler.driver.driver_hir_cache.{hir_cache_enabled, hir_cache_dir, hir_cache_header}

fn hir_owned_artifact_context_v1() -> HirOwnedArtifactContextV1:
    HirOwnedArtifactContextV1(directory: hir_cache_dir(),
        producer_header: hir_cache_header(), enabled: hir_cache_enabled())

fn hir_owned_artifact_store_blob_v1(key: text, blob: text) -> Result<bool, text>:
    common_artifact_store_v1(hir_owned_artifact_context_v1(), key, blob)

fn hir_owned_artifact_load_blob_v1(key: text) -> Result<text, text>:
    common_artifact_load_v1(hir_owned_artifact_context_v1(), key)

export HirOwnedArtifactContextV1, HIR_OWNED_ARTIFACT_MAX_BYTES_V1
export hir_owned_artifact_context_v1
export hir_owned_artifact_store_blob_v1, hir_owned_artifact_load_blob_v1
