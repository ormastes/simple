# Complete generated function records; signatures never stand in for bodies.
use compiler.hir.hir_definitions.{HirFunction}
use compiler.hir.hir_codec.{hir_codec_header}
use compiler.hir.hir_codec_support.{HirCodecWriter}
use compiler.hir.generated.hir_codec.{hc_enc_hir_function, hc_dec_hir_function}
use compiler.frontend.core.flat_pool_codec.{FlatPoolReader}
use compiler.driver.cache.hir_owned_artifact_cache_v1.{
    hir_owned_artifact_store_blob_v1, hir_owned_artifact_load_blob_v1}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use compiler.hir.hir_function_record_identity_v1.{mono_complete_function_digest_v1}

fn mono_function_record_encode_v1(function: HirFunction) -> text:
    var writer = HirCodecWriter.create()
    writer.put_text("mono-complete-function-record-v1")
    writer.put_text(hir_codec_header())
    hc_enc_hir_function(writer, function)
    if not writer.ok: return ""
    writer.finish()

fn mono_function_record_store_in_owned_scope_v1(key: text,
        function: HirFunction) -> Result<bool, text>:
    if transient_array_scope_state_v1() != 1:
        return Err("complete function encoding scope refused")
    val blob = mono_function_record_encode_v1(function)
    if blob == "": return Err("complete function encoding refused")
    hir_owned_artifact_store_blob_v1(key, blob)

fn mono_function_record_load_in_owned_scope_v1(key: text, digest: text,
        symbol: i64, name: text) -> Result<HirFunction, text>:
    val loaded = hir_owned_artifact_load_blob_v1(key)
    if loaded.is_err(): return Err("complete function record read refused")
    val blob = loaded.unwrap()
    # Preserve the actual legacy generated codec contract. The separate
    # canonical generator is not admitted. Full consumption plus exact stable
    # re-encoding closes permissive legacy byte aliases at this cache boundary.
    var reader = FlatPoolReader.new(blob)
    if reader.decode_text(reader.next()) != "mono-complete-function-record-v1" or
            reader.decode_text(reader.next()) != hir_codec_header():
        return Err("complete function record header refused")
    val function = hc_dec_hir_function(reader)
    if not reader.ok or reader.pos != reader.lines.len() - 1:
        return Err("complete function record framing refused")
    if reader.lines[reader.pos] != "" or
            mono_function_record_encode_v1(function) != blob:
        return Err("complete function record stable bytes refused")
    if function.symbol.id != symbol or function.name != name or digest == "" or
            mono_complete_function_digest_v1(function) != digest:
        return Err("complete function record identity refused")
    Ok(function)

export mono_complete_function_digest_v1
export mono_function_record_encode_v1
export mono_function_record_store_in_owned_scope_v1, mono_function_record_load_in_owned_scope_v1
