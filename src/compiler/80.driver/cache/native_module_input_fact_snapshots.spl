# Compact native dependency/resolution facts survive source/surface eviction.
# The source index is a projection of the admitted phase-1 owner, not a new
# admission authority. MIR/layout/provider/config are added by native output.
use compiler.hir.hir_lowering.module_surface_types.{ModuleSurfacesByName}
use compiler.driver.cache.native_source_interface_index.{
    NativeSourceInterfaceIndexV1, native_direct_dependency_facts_from_index_v1}
use compiler.driver.cache.native_module_witness_facts.{
    NativeModuleCacheFactSetV1, native_resolution_facts_v1,
    native_module_cache_fact_set_invalid_v1}

fn native_module_input_fact_snapshots_v1(
    surfaces: ModuleSurfacesByName, index: NativeSourceInterfaceIndexV1
) -> Dict<text, NativeModuleCacheFactSetV1>:
    var snapshots: Dict<text, NativeModuleCacheFactSetV1> = {}
    if not surfaces.frozen or surfaces.generation <= 0:
        for module_name in surfaces.ordered_names:
            snapshots[module_name] = native_module_cache_fact_set_invalid_v1(
                module_name, "unfrozen-native-input-surfaces")
        return snapshots
    for module_name in surfaces.ordered_names:
        if snapshots.contains_key(module_name): continue
        val dependencies = native_direct_dependency_facts_from_index_v1(
            module_name, surfaces, index)
        if not dependencies.valid:
            snapshots[module_name] = dependencies
            continue
        val resolutions = native_resolution_facts_v1(module_name, surfaces)
        if not resolutions.valid:
            snapshots[module_name] = resolutions
            continue
        if dependencies.module_id != resolutions.module_id:
            snapshots[module_name] = native_module_cache_fact_set_invalid_v1(
                module_name, "misaligned-retained-input-module")
            continue
        snapshots[module_name] = NativeModuleCacheFactSetV1(
            module_id: module_name, dependencies: dependencies.dependencies,
            resolutions: resolutions.resolutions, layouts: [],
            valid: true, reason: "ok")
    snapshots

export native_module_input_fact_snapshots_v1
