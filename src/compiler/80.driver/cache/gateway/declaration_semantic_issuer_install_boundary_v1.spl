# codex-impl
# Declaration-derived semantic issuer installation boundary.
#
# This boundary remains deliberately closed.  It must not retain a numeric
# owner count, caller boolean, revision DTO, stream object, or digest as a
# substitute for five live capabilities.  Activation requires five distinct
# retained capability owners.  Each owner must validate its opaque handle at
# installation time, then the owner file may call semantic_canonical_begin_v1,
# semantic_canonical_write_owner_revision_set_v1, and
# semantic_canonical_finish_v1.  The stream and resulting digest remain local
# to that future owner transition.  No such transition exists in V1.

use compiler.common.cache_contract.three_payload_compile_v2.{ThreePayloadFallbackV1}

# Reserved opaque return types.  Constructors and fields remain private, and
# there is no issuance path until all five retained capability owners exist.
struct DeclarationSemanticIssuerInstallHandleV1:
    owner_instance_serial: i64
    owner_generation: i64
    authority_serial: i64

class DeclarationSemanticIssuerInstallOwnerV1:
    unavailable_marker: i64

pub fn declaration_semantic_issuer_install_available_v1() -> bool:
    false

pub fn declaration_semantic_issuer_install_owner_v1(
) -> Result<DeclarationSemanticIssuerInstallOwnerV1, ThreePayloadFallbackV1>:
    Err(ThreePayloadFallbackV1.AuthorityUnavailable)

export DeclarationSemanticIssuerInstallHandleV1,
    DeclarationSemanticIssuerInstallOwnerV1

