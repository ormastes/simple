use std.common.crypto.sha256 (sha256_text)
use compiler.common.cache_contract.cache_gateway_v1.*
use compiler.common.cache_contract.direct_read_pin_v1 (DirectReadPinV1)
use compiler.common.cache_contract.errors_v1.*
use compiler.common.cache_contract.virtual_source_store_v1 (VirtualSourceStoreV1)
use compiler.driver.cache.catalog.cache_catalog_projection (CacheCatalogProjectionV1)
use compiler.driver.cache.summary.summary_store_v1 (VirtualSourceStoreAdapterV1)

fn _gateway_error_v1(code: CacheErrorCodeV1) -> CacheErrorV1:
    CacheErrorV1(code: code, retry: RetryClassV1.Never, severity: ErrorSeverityV1.Error,
        reject: RejectTelemetryV1(telemetry_class: cache_error_telemetry_class_v1(code),
            safe_context: cache_error_safe_context_v1(code), reason_digest: sha256_text("simple.cache.gateway.reject.v1\u0000" + cache_error_safe_context_v1(code)),
            bounded_detail: cache_error_safe_context_v1(code)))

pub class CacheGatewayAdapterV1:
    catalog: CacheCatalogProjectionV1
    summaries: VirtualSourceStoreAdapterV1
    process_instance_nonce: text
    boot_identity_digest: text
    reader_admission_epoch: i64
    journal_generation: i64
    pinned_manifest_digest: text
    monotonic_now: i64
    next_pin: i64

    me _pin_valid(pin: DirectReadPinV1) -> bool:
        # Structural equality and an unkeyed digest are not authority. This
        # becomes true only when Lane 4 supplies an opaque host-owned reader
        # admission receipt and manifest handle.
        false

    me advance_monotonic(now: i64) -> bool:
        if now < self.monotonic_now: return false
        self.monotonic_now = now
        true

impl CacheGatewayV1 for CacheGatewayAdapterV1:
    fn begin_direct_read(ttl: i64) -> Result<DirectReadPinV1, CacheErrorV1>:
        # No opaque host-owned reader-admission/manifest receipt exists yet.
        # Mutable adapter fields cannot authorize a pin.
        Err(_gateway_error_v1(CacheErrorCodeV1.CacheUnavailable))

    fn lookup_verified_action(action_digest: text, pin: DirectReadPinV1) -> Result<CacheLookupV1, CacheErrorV1>:
        if not self._pin_valid(pin): return Err(_gateway_error_v1(CacheErrorCodeV1.CachePinExpired))
        val row = match self.catalog.lookup(action_digest):
            case Ok(value): value
            case Err(_): return Err(_gateway_error_v1(CacheErrorCodeV1.CacheCorrupt))
        if row.quarantined: return Err(_gateway_error_v1(CacheErrorCodeV1.CacheNondeterminism))
        # An index row is not object authority. Until the descriptor-anchored CAS
        # seam supplies verified bytes, every lookup is an explicit miss.
        Ok(CacheLookupV1(present: false, object_kind: if row.present: row.object_kind else: "",
            object_digest: if row.present: row.object_digest else: "", canonical_bytes: [], pin: Some(pin)))

    fn get_verified(kind: text, digest: text, limits: CacheLimitsV1, pin: DirectReadPinV1) -> Result<CacheLookupV1, CacheErrorV1>:
        if limits.max_bytes <= 0 or limits.max_entries <= 0:
            return Err(_gateway_error_v1(CacheErrorCodeV1.CacheBoundsExceeded))
        if not self._pin_valid(pin): return Err(_gateway_error_v1(CacheErrorCodeV1.CachePinExpired))
        Ok(CacheLookupV1(present: false, object_kind: kind, object_digest: digest,
            canonical_bytes: [], pin: Some(pin)))

    fn renew_direct_read_pin(pin: DirectReadPinV1) -> Result<DirectReadPinV1, CacheErrorV1>:
        if not self._pin_valid(pin): return Err(_gateway_error_v1(CacheErrorCodeV1.CachePinRenewalFailed))
        Ok(pin)

    fn release_direct_read_pin(pin: DirectReadPinV1) -> Result<(), CacheErrorV1>:
        if not self._pin_valid(pin): return Err(_gateway_error_v1(CacheErrorCodeV1.CachePinExpired))
        Ok(())

    fn virtual_source_store() -> VirtualSourceStoreV1:
        self.summaries

    fn status() -> Result<GatewayStatusV1, CacheErrorV1>:
        Ok(GatewayStatusV1(mode: "fail_closed_no_anchored_cas", writer_epoch_digest: "",
            journal_generation: self.journal_generation))
