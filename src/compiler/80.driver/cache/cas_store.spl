# CAS Store — Cross-process disk content-addressed store (Option-C cache, phase 1)
#
# Plan: doc/03_plan/compiler/cache/global_cas_interpreter_cache_option_c_plan_2026-07-24.md §1.2
#
# Layout (all entries addressed by SHA-256 hex digest):
#   <root>/VERSION                          # schema version stamp
#   <root>/cas/sha256/<ab>/<cdef...>        # immutable content blobs
#   <root>/actions/sha256/<ab>/<cdef...>    # action manifests -> artifact digests
#   <root>/tmp/                             # private temp files for atomic rename
#   <root>/quarantine/                      # digest-mismatched (corrupt) entries
#
# Digest paths REPLACE the legacy `/`->`_` flattening in
# cache_validator.source_to_cache_path, which collides ("a/b_c" vs "a_b/c").
#
# Write protocol: private temp file (`<root>/tmp/<digest>.<pid>.tmp`) -> atomic
# rename into digest path. A lost race with identical bytes is success. Every
# read re-verifies content against the requested digest; mismatch = corruption
# -> quarantine, never serve unverified bytes.
#
# Phase 1: standalone module only — NOT wired into any load path. No locking
# beyond atomic rename, no GC, no remote cache.

use std.crypto.sha256.{sha256_text}
use compiler.driver.cache.action_key.{canon_str, canon_nat, canon_field, canon_seq}
use std.io_runtime.{dir_create_all, env_get_opt}
use std.nogc_sync_mut.io_runtime.{file_read_nullable}

@unsafe(reason: "raw CAS file write status ABI", capabilities: [ffi])
extern fn rt_file_write_text(path: text, content: text) -> bool
@unsafe(reason: "raw CAS file existence ABI", capabilities: [ffi])
extern fn rt_file_exists(path: text) -> bool
@unsafe(reason: "raw CAS file deletion status ABI", capabilities: [ffi])
extern fn rt_file_delete(path: text) -> bool
@unsafe(reason: "raw CAS atomic move status ABI", capabilities: [ffi])
extern fn rt_file_move(old_path: text, new_path: text) -> bool
@unsafe(reason: "raw CAS process identifier ABI", capabilities: [ffi])
extern fn rt_getpid() -> i64
@unsafe(reason: "raw CAS wall-clock ABI", capabilities: [ffi])
extern fn rt_time_now_unix_micros() -> i64

# One direct call per helper after inlining. These helpers make the raw
# ownership/status boundary lexical without adding cache-path allocation,
# retries, lookups, locks, or dispatch.
@always_inline
fn cas_file_write_text_raw(path: text, content: text) -> bool:
    unsafe(capabilities: [ffi]):
        rt_file_write_text(path, content)

@always_inline
fn cas_file_exists_raw(path: text) -> bool:
    unsafe(capabilities: [ffi]):
        rt_file_exists(path)

@always_inline
fn cas_file_delete_raw(path: text) -> bool:
    unsafe(capabilities: [ffi]):
        rt_file_delete(path)

@always_inline
fn cas_file_move_raw(old_path: text, new_path: text) -> bool:
    unsafe(capabilities: [ffi]):
        rt_file_move(old_path, new_path)

@always_inline
fn cas_process_id_raw() -> i64:
    unsafe(capabilities: [ffi]):
        rt_getpid()

@always_inline
fn cas_time_now_unix_micros_raw() -> i64:
    unsafe(capabilities: [ffi]):
        rt_time_now_unix_micros()

val CAS_SCHEMA_VERSION: i64 = 1
val CAS_MANIFEST_HEADER: text = "simple-cas-manifest-v1"

# Action manifest: maps one ActionDigest to the artifact digests it produced.
struct ActionManifest:
    action_digest: text
    artifact_digests: [text]
    schema_version: i64

# ResultManifest — C1 widened record (doc/03_plan/compiler/cache/c0_schema_freeze_2026-08-09.md
# §4). Field subset per schema §14.5 / cache_protocol.sdn `result_manifest`:
# action_digest, result_kind, artifact_digests, output_fingerprint,
# dependency_manifest, producer_schema (= the old `schema_version`, renamed).
# `result_kind` is encoded by NAME (never ordinal), matching the schema rule
# for every enum in this protocol.
struct ResultManifest:
    action_digest: text
    result_kind: text
    artifact_digests: [text]
    output_fingerprint: text
    dependency_manifest: text
    producer_schema: i64

val RESULT_MANIFEST_HEADER: text = "simple-result-manifest-v2"

# ============================================================================
# Root resolution + paths
# ============================================================================

fn cas_root() -> text:
    # Keep the cache root's unset-to-default policy at the runtime facade.
    # `env_get_opt` preserves the old nullable runtime result before this
    # module deliberately normalizes it for the total `cas_root` API.
    val env = env_get_opt("SIMPLE_CACHE") ?? ""
    if env != "":
        return env
    "build/cache_cas"

fn cas_version_text() -> text:
    "{CAS_SCHEMA_VERSION}"

fn cas_blob_path(root: text, digest: text) -> text:
    "{root}/cas/sha256/{digest.substring(0, 2)}/{digest.substring(2, digest.len())}"

fn cas_action_path(root: text, digest: text) -> text:
    "{root}/actions/sha256/{digest.substring(0, 2)}/{digest.substring(2, digest.len())}"

fn cas_parent_dir(path: text) -> text:
    val slash = path.last_index_of("/") ?? -1
    if slash <= 0:
        return ""
    path.substring(0, slash)

# ============================================================================
# Store open + schema versioning
# ============================================================================

# Open (create) a store at `root`. If a VERSION stamp from a different schema
# is found, the old entries are never trusted: cas/ and actions/ are moved
# aside and the store starts empty under the current version.
fn cas_open(root: text) -> bool:
    rt_dir_create_all(root)
    val vpath = "{root}/VERSION"
    val current = cas_version_text()
    if cas_file_exists_raw(vpath):
        val stored = file_read_nullable(vpath) ?? ""
        if stored.trim() != current:
            val stamp = "{cas_process_id_raw()}-{cas_time_now_unix_micros_raw()}"
            cas_file_move_raw("{root}/cas", "{root}/stale-cas-{stamp}")
            cas_file_move_raw("{root}/actions", "{root}/stale-actions-{stamp}")
            cas_file_write_text_raw(vpath, current)
    else:
        cas_file_write_text_raw(vpath, current)
    dir_create_all("{root}/cas/sha256")
    dir_create_all("{root}/actions/sha256")
    dir_create_all("{root}/tmp")
    true

# ============================================================================
# Blob store
# ============================================================================

# Store content, return its digest. Dedup: an existing blob (including one
# that lands via a lost race with identical bytes) is success. Returns "" only
# on a hard write failure.
fn cas_put(root: text, content: text) -> text:
    val digest = sha256_text(content)
    val path = cas_blob_path(root, digest)
    if cas_file_exists_raw(path):
        return digest
    dir_create_all(cas_parent_dir(path))
    dir_create_all("{root}/tmp")
    val tmp = "{root}/tmp/{digest}.{cas_process_id_raw()}.tmp"
    if not cas_file_write_text_raw(tmp, content):
        return ""
    if not cas_file_move_raw(tmp, path):
        cas_file_delete_raw(tmp)
        if not cas_file_exists_raw(path):
            return ""
    digest

# Fetch content by digest, re-verifying the bytes hash to the requested
# digest. Corruption -> quarantined + treated as absent; unverified bytes are
# never returned.
fn cas_get(root: text, digest: text) -> text?:
    val path = cas_blob_path(root, digest)
    if not cas_file_exists_raw(path):
        return nil
    val content = file_read_nullable(path) ?? ""
    if sha256_text(content) != digest:
        cas_quarantine(root, path)
        return nil
    content

# Stamp-fast existence check (no verification — strict path is cas_get).
fn cas_has(root: text, digest: text) -> bool:
    cas_file_exists_raw(cas_blob_path(root, digest))

fn cas_quarantine(root: text, path: text) -> bool:
    dir_create_all("{root}/quarantine")
    val name = "{cas_process_id_raw()}-{cas_time_now_unix_micros_raw()}"
    if cas_file_move_raw(path, "{root}/quarantine/{name}"):
        return true
    cas_file_delete_raw(path)

# ============================================================================
# Action manifests
# ============================================================================

# Canonical serialization: fixed header line, action digest line, then one
# artifact digest per line (order preserved as given).
fn action_manifest_serialize(manifest: ActionManifest) -> text:
    var lines: [text] = [CAS_MANIFEST_HEADER, manifest.action_digest]
    for d in manifest.artifact_digests:
        lines = lines.push(d)
    lines.join("\n")

fn action_manifest_parse(content: text) -> ActionManifest?:
    val lines = content.split("\n")
    if lines.len() < 2:
        return nil
    if lines[0] != CAS_MANIFEST_HEADER:
        return nil
    var artifacts: [text] = []
    var i = 2
    while i < lines.len():
        if lines[i] != "":
            artifacts = artifacts.push(lines[i])
        i = i + 1
    ActionManifest(action_digest: lines[1], artifact_digests: artifacts, schema_version: CAS_SCHEMA_VERSION)

# Store a manifest under its action digest. Refuses a mislabeled manifest
# (key != manifest.action_digest) — a poisoned mapping must not be admitted.
fn action_put(root: text, action_digest: text, manifest: ActionManifest) -> bool:
    if manifest.action_digest != action_digest:
        return false
    val path = cas_action_path(root, action_digest)
    dir_create_all(cas_parent_dir(path))
    dir_create_all("{root}/tmp")
    val tmp = "{root}/tmp/action-{action_digest}.{cas_process_id_raw()}.tmp"
    if not cas_file_write_text_raw(tmp, action_manifest_serialize(manifest)):
        return false
    if not cas_file_move_raw(tmp, path):
        cas_file_delete_raw(tmp)
        return cas_file_exists_raw(path)
    true

# Fetch a manifest by action digest. The stored manifest's own action_digest
# field must match the requested key; a tampered or unparseable manifest is
# quarantined and treated as absent.
fn action_get(root: text, action_digest: text) -> ActionManifest?:
    val path = cas_action_path(root, action_digest)
    if not cas_file_exists_raw(path):
        return nil
    val content = file_read_nullable(path) ?? ""
    val parsed = action_manifest_parse(content)
    match parsed:
        case Some(manifest):
            if manifest.action_digest != action_digest:
                cas_quarantine(root, path)
                return nil
            return manifest
        case nil:
            cas_quarantine(root, path)
            return nil

# ============================================================================
# ResultManifest (schema_version: 2) — C0 frozen extension (Agent C1)
#
# Superset of ActionManifest above (freeze note §4):
#   kept:  action_digest, artifact_digests (schema_version -> renamed producer_schema)
#   added: result_kind, output_fingerprint, dependency_manifest, aop_group_roots,
#          block_manifest_root? (optional), diagnostics_digest? (optional)
#
# ResultManifest is content-addressed by ITS OWN digest (sha256 of its
# serialized form), stored under the generic CAS blob path — NOT under
# cas_action_path (that namespace stays ActionManifest's). The ActionDigest ->
# ResultManifestDigest mapping is a separate concern owned by action_index/.
#
# artifact_digests stays an ORDERED list (freeze note §4 decision 5: position
# is meaningful to the consumer). aop_group_roots is a SET and is sorted
# before serialization so two manifests differing only in root-listing order
# hash identically.
# ============================================================================

val RESULT_MANIFEST_HEADER: text = "simple-result-manifest-v1"

struct ResultManifest:
    action_digest: text
    result_kind: text                  # enum encoded by name (see action_key.spl ResultKind)
    artifact_digests: [text]           # ORDERED
    output_fingerprint: text
    dependency_manifest: text
    aop_group_roots: [text]            # SET; sorted at serialize time
    block_manifest_root: text          # "" means absent (optional)
    diagnostics_digest: text           # "" means absent (optional)
    producer_schema: i64

fn result_manifest_sort_texts(items: [text]) -> [text]:
    var out: [text] = []
    for item in items:
        var placed = false
        var next: [text] = []
        for s in out:
            if not placed and item <= s:
                next.push(item)
                placed = true
            next.push(s)
        if not placed:
            next.push(item)
        out = next
    out

# Line-based canonical serialization (mirrors action_manifest_serialize's
# style): a fixed header, then one field per line, then a length-prefixed
# ORDERED artifact-digest block, then a length-prefixed SORTED aop-root block.
fn result_manifest_serialize(manifest: ResultManifest) -> text:
    val roots_sorted = result_manifest_sort_texts(manifest.aop_group_roots)
    var lines: [text] = [
        RESULT_MANIFEST_HEADER,
        manifest.action_digest,
        manifest.result_kind,
        "{manifest.producer_schema}",
        manifest.output_fingerprint,
        manifest.dependency_manifest,
        manifest.block_manifest_root,
        manifest.diagnostics_digest,
        "{manifest.artifact_digests.len()}"
    ]
    for d in manifest.artifact_digests:
        lines = lines.push(d)
    lines = lines.push("{roots_sorted.len()}")
    for r in roots_sorted:
        lines = lines.push(r)
    lines.join("\n")

fn result_manifest_parse(content: text) -> ResultManifest?:
    val lines = content.split("\n")
    if lines.len() < 9:
        return nil
    if lines[0] != RESULT_MANIFEST_HEADER:
        return nil
    val artifact_count = lines[8].to_i64() ?? -1
    if artifact_count < 0:
        return nil
    var artifacts: [text] = []
    var i = 9
    val artifact_end = 9 + artifact_count
    while i < artifact_end:
        if i >= lines.len():
            return nil
        artifacts = artifacts.push(lines[i])
        i = i + 1
    if i >= lines.len():
        return nil
    val root_count = lines[i].to_i64() ?? -1
    if root_count < 0:
        return nil
    i = i + 1
    var roots: [text] = []
    val root_end = i + root_count
    while i < root_end:
        if i >= lines.len():
            return nil
        roots = roots.push(lines[i])
        i = i + 1
    val producer_schema = lines[3].to_i64() ?? -1
    if producer_schema < 0:
        return nil
    ResultManifest(
        action_digest: lines[1],
        result_kind: lines[2],
        artifact_digests: artifacts,
        output_fingerprint: lines[4],
        dependency_manifest: lines[5],
        aop_group_roots: roots,
        block_manifest_root: lines[6],
        diagnostics_digest: lines[7],
        producer_schema: producer_schema
    )

fn result_manifest_digest(manifest: ResultManifest) -> text:
    sha256_text(result_manifest_serialize(manifest))

# Publish a ResultManifest under its action digest, ONLY if every referenced
# artifact is already present in CAS (closure check). Refuses a mislabeled
# manifest the same way action_put does.
fn result_manifest_put(root: text, action_digest: text, m: ResultManifest) -> bool:
    if m.action_digest != action_digest:
        return false
    if not result_manifest_closure_complete(root, m):
        return false
    val path = cas_action_path(root, action_digest)
    dir_create_all(cas_parent_dir(path))
    dir_create_all("{root}/tmp")
    val tmp = "{root}/tmp/result-{action_digest}.{cas_process_id_raw()}.tmp"
    if not cas_file_write_text_raw(tmp, result_manifest_serialize(m)):
        return false
    if not cas_file_move_raw(tmp, path):
        cas_file_delete_raw(tmp)
        return cas_file_exists_raw(path)
    true

fn result_manifest_get(root: text, action_digest: text) -> ResultManifest?:
    val path = cas_action_path(root, action_digest)
    if not cas_file_exists_raw(path):
        return nil
    val content = file_read_nullable(path) ?? ""
    val parsed = result_manifest_parse(content)
    match parsed:
        case Some(manifest):
            if manifest.action_digest != action_digest:
                cas_quarantine(root, path)
                return nil
            return manifest
        case nil:
            return nil
