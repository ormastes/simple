# CAS Store — Cross-process disk content-addressed store (Option-C cache, phase 1)
#
# Plan: doc/03_plan/compiler/cache/global_cas_interpreter_cache_option_c_plan_2026-07-24.md §1.2
#
# Layout (all entries addressed by SHA-256 hex digest):
#   <root>/VERSION                          # schema version stamp
#   <root>/cas/sha256/<ab>/<cdef...>        # immutable content blobs
#   <root>/actions/sha256/<ab>/<cdef...>    # action manifests -> artifact digests
#   <root>/tmp/                             # private temp files for atomic rename
#   <root>/quarantine/                      # digest-mismatched (corrupt) entries
#
# Digest paths REPLACE the legacy `/`->`_` flattening in
# cache_validator.source_to_cache_path, which collides ("a/b_c" vs "a_b/c").
#
# Write protocol: private temp file (`<root>/tmp/<digest>.<pid>.tmp`) -> atomic
# rename into digest path. A lost race with identical bytes is success. Every
# read re-verifies content against the requested digest; mismatch = corruption
# -> quarantine, never serve unverified bytes.
#
# Phase 1: standalone module only — NOT wired into any load path. No locking
# beyond atomic rename, no GC, no remote cache.

use std.crypto.sha256.{sha256_text}
use compiler.driver.cache.action_key.{canon_str, canon_nat, canon_field, canon_seq}
use std.io_runtime.{
    dir_create_all, read_file_text, write_file, file_exists, file_delete,
    file_move_cross_device, env_get, getpid, time_now_unix_micros
}

val CAS_SCHEMA_VERSION: i64 = 1
val CAS_MANIFEST_HEADER: text = "simple-cas-manifest-v1"

# Action manifest: maps one ActionDigest to the artifact digests it produced.
struct ActionManifest:
    action_digest: text
    artifact_digests: [text]
    schema_version: i64

# ResultManifest — C1 widened record (doc/03_plan/compiler/cache/c0_schema_freeze_2026-08-09.md
# §4). Field subset per schema §14.5 / cache_protocol.sdn `result_manifest`:
# action_digest, result_kind, artifact_digests, output_fingerprint,
# dependency_manifest, producer_schema (= the old `schema_version`, renamed).
# `result_kind` is encoded by NAME (never ordinal), matching the schema rule
# for every enum in this protocol.
struct ResultManifest:
    action_digest: text
    result_kind: text
    artifact_digests: [text]
    output_fingerprint: text
    dependency_manifest: text
    producer_schema: i64

val RESULT_MANIFEST_HEADER: text = "simple-result-manifest-v2"

# ============================================================================
# Root resolution + paths
# ============================================================================

fn cas_root() -> text:
    val env = env_get("SIMPLE_CACHE") ?? ""
    if env != "":
        return env
    "build/cache_cas"

fn cas_version_text() -> text:
    "{CAS_SCHEMA_VERSION}"

fn cas_blob_path(root: text, digest: text) -> text:
    "{root}/cas/sha256/{digest.substring(0, 2)}/{digest.substring(2, digest.len())}"

fn cas_action_path(root: text, digest: text) -> text:
    "{root}/actions/sha256/{digest.substring(0, 2)}/{digest.substring(2, digest.len())}"

fn cas_parent_dir(path: text) -> text:
    val slash = path.last_index_of("/")
    if slash <= 0:
        return ""
    path.substring(0, slash)

# ============================================================================
# Store open + schema versioning
# ============================================================================

# Open (create) a store at `root`. If a VERSION stamp from a different schema
# is found, the old entries are never trusted: cas/ and actions/ are moved
# aside and the store starts empty under the current version.
fn cas_open(root: text) -> bool:
    dir_create_all(root)
    val vpath = "{root}/VERSION"
    val current = cas_version_text()
    if file_exists(vpath):
        val stored = read_file_text(vpath) ?? ""
        if stored.trim() != current:
            val stamp = "{getpid()}-{time_now_unix_micros()}"
            file_move_cross_device("{root}/cas", "{root}/stale-cas-{stamp}")
            file_move_cross_device("{root}/actions", "{root}/stale-actions-{stamp}")
            write_file(vpath, current)
    else:
        write_file(vpath, current)
    dir_create_all("{root}/cas/sha256")
    dir_create_all("{root}/actions/sha256")
    dir_create_all("{root}/tmp")
    true

# ============================================================================
# Blob store
# ============================================================================

# Store content, return its digest. Dedup: an existing blob (including one
# that lands via a lost race with identical bytes) is success. Returns "" only
# on a hard write failure.
fn cas_put(root: text, content: text) -> text:
    val digest = sha256_text(content)
    val path = cas_blob_path(root, digest)
    if file_exists(path):
        return digest
    dir_create_all(cas_parent_dir(path))
    dir_create_all("{root}/tmp")
    val tmp = "{root}/tmp/{digest}.{getpid()}.tmp"
    if not write_file(tmp, content):
        return ""
    if not file_move_cross_device(tmp, path):
        file_delete(tmp)
        if not file_exists(path):
            return ""
    digest

# Fetch content by digest, re-verifying the bytes hash to the requested
# digest. Corruption -> quarantined + treated as absent; unverified bytes are
# never returned.
fn cas_get(root: text, digest: text) -> text?:
    val path = cas_blob_path(root, digest)
    if not file_exists(path):
        return nil
    val content = read_file_text(path) ?? ""
    if sha256_text(content) != digest:
        cas_quarantine(root, path)
        return nil
    content

# Stamp-fast existence check (no verification — strict path is cas_get).
fn cas_has(root: text, digest: text) -> bool:
    file_exists(cas_blob_path(root, digest))

fn cas_quarantine(root: text, path: text) -> bool:
    dir_create_all("{root}/quarantine")
    val name = "{getpid()}-{time_now_unix_micros()}"
    if file_move_cross_device(path, "{root}/quarantine/{name}"):
        return true
    file_delete(path)

# ============================================================================
# Action manifests
# ============================================================================

# Canonical serialization: fixed header line, action digest line, then one
# artifact digest per line (order preserved as given).
fn action_manifest_serialize(manifest: ActionManifest) -> text:
    var lines: [text] = [CAS_MANIFEST_HEADER, manifest.action_digest]
    for d in manifest.artifact_digests:
        lines = lines.push(d)
    lines.join("\n")

fn action_manifest_parse(content: text) -> ActionManifest?:
    val lines = content.split("\n")
    if lines.len() < 2:
        return nil
    if lines[0] != CAS_MANIFEST_HEADER:
        return nil
    var artifacts: [text] = []
    var i = 2
    while i < lines.len():
        if lines[i] != "":
            artifacts = artifacts.push(lines[i])
        i = i + 1
    ActionManifest(action_digest: lines[1], artifact_digests: artifacts, schema_version: CAS_SCHEMA_VERSION)

# Store a manifest under its action digest. Refuses a mislabeled manifest
# (key != manifest.action_digest) — a poisoned mapping must not be admitted.
fn action_put(root: text, action_digest: text, manifest: ActionManifest) -> bool:
    if manifest.action_digest != action_digest:
        return false
    val path = cas_action_path(root, action_digest)
    dir_create_all(cas_parent_dir(path))
    dir_create_all("{root}/tmp")
    val tmp = "{root}/tmp/action-{action_digest}.{getpid()}.tmp"
    if not write_file(tmp, action_manifest_serialize(manifest)):
        return false
    if not file_move_cross_device(tmp, path):
        file_delete(tmp)
        return file_exists(path)
    true

# Fetch a manifest by action digest. The stored manifest's own action_digest
# field must match the requested key; a tampered or unparseable manifest is
# quarantined and treated as absent.
fn action_get(root: text, action_digest: text) -> ActionManifest?:
    val path = cas_action_path(root, action_digest)
    if not file_exists(path):
        return nil
    val content = read_file_text(path) ?? ""
    val parsed = action_manifest_parse(content)
    match parsed:
        case Some(manifest):
            if manifest.action_digest != action_digest:
                cas_quarantine(root, path)
                return nil
            return manifest
        case nil:
            cas_quarantine(root, path)
            return nil

# ============================================================================
# Result manifests (C1 — closure-checked publish over ActionManifest)
# ============================================================================

# Canonical encoding reuses action_key.spl's domain-separated, length-prefixed
# primitives so the manifest's own digest is collision-safe the same way
# ActionKey is.
fn result_manifest_encode(m: ResultManifest) -> text:
    var artifact_items: [text] = []
    for d in m.artifact_digests:
        artifact_items.push(canon_str(d))
    var fields: [text] = []
    fields.push(canon_field("actionDigest", canon_str(m.action_digest)))
    fields.push(canon_field("resultKind", canon_str(m.result_kind)))
    fields.push(canon_field("artifactDigests", canon_seq(artifact_items)))
    fields.push(canon_field("outputFingerprint", canon_str(m.output_fingerprint)))
    fields.push(canon_field("dependencyManifest", canon_str(m.dependency_manifest)))
    fields.push(canon_field("producerSchema", canon_nat(m.producer_schema)))
    canon_field(RESULT_MANIFEST_HEADER, canon_seq(fields))

fn result_manifest_serialize(m: ResultManifest) -> text:
    var lines: [text] = [RESULT_MANIFEST_HEADER, m.action_digest, m.result_kind,
        m.output_fingerprint, m.dependency_manifest, "{m.producer_schema}"]
    for d in m.artifact_digests:
        lines = lines.push(d)
    lines.join("\n")

fn result_manifest_parse(content: text) -> ResultManifest?:
    val lines = content.split("\n")
    if lines.len() < 6:
        return nil
    if lines[0] != RESULT_MANIFEST_HEADER:
        return nil
    var artifacts: [text] = []
    var i = 6
    while i < lines.len():
        if lines[i] != "":
            artifacts = artifacts.push(lines[i])
        i = i + 1
    val producer_schema = lines[5].to_i64() ?? -1
    ResultManifest(
        action_digest: lines[1],
        result_kind: lines[2],
        artifact_digests: artifacts,
        output_fingerprint: lines[3],
        dependency_manifest: lines[4],
        producer_schema: producer_schema
    )

# Closure check: every artifact digest a ResultManifest references must
# already exist in CAS before the mapping is admitted. Never publish a
# dangling reference.
fn result_manifest_closure_complete(root: text, m: ResultManifest) -> bool:
    for d in m.artifact_digests:
        if not cas_has(root, d):
            return false
    true

# Publish a ResultManifest under its action digest, ONLY if every referenced
# artifact is already present in CAS (closure check). Refuses a mislabeled
# manifest the same way action_put does.
fn result_manifest_put(root: text, action_digest: text, m: ResultManifest) -> bool:
    if m.action_digest != action_digest:
        return false
    if not result_manifest_closure_complete(root, m):
        return false
    val path = cas_action_path(root, action_digest)
    dir_create_all(cas_parent_dir(path))
    dir_create_all("{root}/tmp")
    val tmp = "{root}/tmp/result-{action_digest}.{getpid()}.tmp"
    if not write_file(tmp, result_manifest_serialize(m)):
        return false
    if not file_move_cross_device(tmp, path):
        file_delete(tmp)
        return file_exists(path)
    true

fn result_manifest_get(root: text, action_digest: text) -> ResultManifest?:
    val path = cas_action_path(root, action_digest)
    if not file_exists(path):
        return nil
    val content = read_file_text(path) ?? ""
    val parsed = result_manifest_parse(content)
    match parsed:
        case Some(manifest):
            if manifest.action_digest != action_digest:
                cas_quarantine(root, path)
                return nil
            return manifest
        case nil:
            cas_quarantine(root, path)
            return nil

export ActionManifest, ResultManifest
export cas_root, cas_open, cas_put, cas_get, cas_has, cas_quarantine
export cas_blob_path, cas_action_path, cas_parent_dir
export action_manifest_serialize, action_manifest_parse, action_put, action_get
export result_manifest_encode, result_manifest_serialize, result_manifest_parse
export result_manifest_closure_complete, result_manifest_put, result_manifest_get
