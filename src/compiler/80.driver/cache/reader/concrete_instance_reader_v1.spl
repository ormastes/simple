# Reader-driven concrete generic instances (per-file P-G1).
#
# A file job's reader (readTldr / readSrc via FileReader or CacheReader) hands
# each loaded module's generic template section to this reader. The job then
# asks for the concrete instances it uses:
#
#   reader_concrete_instance_v1(reader, module_key, generic_decl_id, type_args)
#       -> ConcreteInstanceResultV1   (found=true: instance; found=false: miss)
#
# Hit: the instance already published under its canonical ConcreteTldrKey is
# returned unchanged (source "cache"). Miss: the concrete view is instantiated
# ONCE from the generic TLDR template (single-flight in
# GenericTldrViewTableV1), published set-once and returned (source
# "instantiated"). A hit and a fresh instantiation of the same key are the
# same value; a changed type argument is a different key.
#
# Only Concrete views are instances: a Partial (open argument) or Unresolved
# view is a miss with `miss_reason`, never codegen input.
#
# Generic-use detection: `reader_detect_generic_uses_v1` keeps the importer's
# usage refs (from its `.rr` generic-specialization reads) that name a template
# in the callee's generic section with matching arity.
#
# Named gaps (P-G2/P-G3): the instance table is process-local - persisting the
# instance through CacheReader blobs and recording the specialization list in
# the producer TLDR is P-G2; HIR/MIR consuming the view in place of the global
# mono pass is P-G3.

use compiler.common.cache_contract.generic_tldr_view_v1.{GenericTemplateSectionV1,
    ConcreteTldrAstViewV1, generic_template_section_lookup_v1, GENERIC_CLOSURE_CONCRETE}
use compiler.common.cache_contract.guard_id_v1.{ActiveGuardRootV1}
use compiler.mono.model.generic_subst_model.{MType, mt_from_key}
use compiler.driver.cache.generic_tldr_view_table_v1.{GenericTldrViewTableV1,
    acquire_concrete_tldr}

pub val CONCRETE_INSTANCE_SOURCE_CACHE_V1 = "cache"
pub val CONCRETE_INSTANCE_SOURCE_INSTANTIATED_V1 = "instantiated"

pub struct ConcreteInstanceV1:
    module_key: text
    generic_decl_id: text
    instance_key: text   # canonical ConcreteTldrKey (DigestV1 text)
    view: ConcreteTldrAstViewV1
    source: text         # CONCRETE_INSTANCE_SOURCE_*_V1

pub struct ConcreteInstanceResultV1:
    found: bool
    instance: [ConcreteInstanceV1]   # exactly one when found
    miss_reason: text

# One generic use from an importer's usage refs: template symbol + positional
# structural type-argument keys (generic_subst_model.mt_key_type).
pub struct GenericUseRefV1:
    generic_decl_id: text
    type_arg_keys: [text]

class ConcreteInstanceReaderV1:
    table: GenericTldrViewTableV1
    sections: Dict<text, GenericTemplateSectionV1>
    snapshot_pin: text
    profile_digest: text
    guard_root: ActiveGuardRootV1
    hits: i64
    instantiations: i64
    misses: i64

    static fn create(table: GenericTldrViewTableV1, snapshot_pin: text, profile_digest: text,
            guard_root: ActiveGuardRootV1) -> ConcreteInstanceReaderV1:
        ConcreteInstanceReaderV1(table: table, sections: {}, snapshot_pin: snapshot_pin,
            profile_digest: profile_digest, guard_root: guard_root, hits: 0, instantiations: 0, misses: 0)

    # Called by readTldr/readSrc when a module's TLDR generic section is loaded.
    me register_module(module_key: text, section: GenericTemplateSectionV1):
        self.sections[module_key] = section

    fn has_module(module_key: text) -> bool:
        self.sections.contains_key(module_key)

    me _miss(reason: text) -> ConcreteInstanceResultV1:
        self.misses = self.misses + 1
        ConcreteInstanceResultV1(found: false, instance: [], miss_reason: reason)

    me concrete_instance(module_key: text, generic_decl_id: text, type_args: [MType]) -> ConcreteInstanceResultV1:
        if not self.sections.contains_key(module_key):
            return self._miss("module-not-loaded")
        val acq = acquire_concrete_tldr(self.table, self.sections[module_key], generic_decl_id,
            type_args, self.snapshot_pin, self.profile_digest, self.guard_root)
        val view = acq.view
        if view.closure_status != GENERIC_CLOSURE_CONCRETE:
            val reason = if view.error != "": view.error else: "not-concrete"
            return self._miss(reason)
        var source = CONCRETE_INSTANCE_SOURCE_INSTANTIATED_V1
        if acq.joined:
            source = CONCRETE_INSTANCE_SOURCE_CACHE_V1
            self.hits = self.hits + 1
        else:
            self.instantiations = self.instantiations + 1
        ConcreteInstanceResultV1(found: true, instance: [ConcreteInstanceV1(module_key: module_key,
            generic_decl_id: generic_decl_id, instance_key: view.semantic_key, view: view,
            source: source)], miss_reason: "")

pub fn concrete_instance_reader_new_v1(table: GenericTldrViewTableV1, snapshot_pin: text,
        profile_digest: text, guard_root: ActiveGuardRootV1) -> ConcreteInstanceReaderV1:
    ConcreteInstanceReaderV1.create(table, snapshot_pin, profile_digest, guard_root)

pub fn reader_concrete_instance_v1(reader: ConcreteInstanceReaderV1, module_key: text,
        generic_decl_id: text, type_args: [MType]) -> ConcreteInstanceResultV1:
    reader.concrete_instance(module_key, generic_decl_id, type_args)

# Same request from structural type-argument keys; an unparsable key is a miss.
pub fn reader_concrete_instance_by_keys_v1(reader: ConcreteInstanceReaderV1, module_key: text,
        use_ref: GenericUseRefV1) -> ConcreteInstanceResultV1:
    var args: [MType] = []
    for k in use_ref.type_arg_keys:
        val parsed = mt_from_key(k)
        if not parsed.ok:
            return reader._miss("malformed-type-arg-key")
        args = args.push(parsed.t)
    reader.concrete_instance(module_key, use_ref.generic_decl_id, args)

# Usage refs that name a template in `section` with matching arity.
pub fn reader_detect_generic_uses_v1(section: GenericTemplateSectionV1,
        refs: [GenericUseRefV1]) -> [GenericUseRefV1]:
    var out: [GenericUseRefV1] = []
    for r in refs:
        val ref: GenericUseRefV1 = r
        val at = generic_template_section_lookup_v1(section, ref.generic_decl_id)
        if at >= 0 and section.entries[at].params.len() == ref.type_arg_keys.len():
            out = out.push(ref)
    out

# Request every usage ref of `module_key`: exactly one result per ref, in
# order. A ref that cannot be served (module not loaded, unknown template,
# arity mismatch, malformed key, not Concrete) is a miss with its reason -
# never dropped, so "no generic uses" is never confused with "not served".
pub fn reader_request_generic_instances_v1(reader: ConcreteInstanceReaderV1, module_key: text,
        refs: [GenericUseRefV1]) -> [ConcreteInstanceResultV1]:
    var out: [ConcreteInstanceResultV1] = []
    for r in refs:
        val ref: GenericUseRefV1 = r
        if not reader.has_module(module_key):
            out = out.push(reader._miss("module-not-loaded"))
        else:
            out = out.push(reader_concrete_instance_by_keys_v1(reader, module_key, ref))
    out

export CONCRETE_INSTANCE_SOURCE_CACHE_V1, CONCRETE_INSTANCE_SOURCE_INSTANTIATED_V1
export ConcreteInstanceV1, ConcreteInstanceResultV1, GenericUseRefV1
export ConcreteInstanceReaderV1, concrete_instance_reader_new_v1
export reader_concrete_instance_v1, reader_concrete_instance_by_keys_v1
export reader_detect_generic_uses_v1, reader_request_generic_instances_v1
