# Template-BODY-on-demand seam (P-G4). Serves the OWNER module's HIR that
# carries the body of `template`, taken from the HIR this MIR child already
# admitted from the HIR cache (never a re-parse of the closure), so F
# instantiates it into F's own object (module-scoped mono does relocation and
# COMDAT placement) without waiting on the owner's HIR shard. Owners are
# searched only in F's transitive import closure (HirModule.imports); outside
# it or ambiguous = miss. The decision is cached per process-local
# TemplateBodyDecisionKeyV1 (NOT a ConcreteTldrKey), set-once; an owner content
# change invalidates its entries. The owner digest is hashed lazily, only on a miss.
# P-G1's reader_concrete_instance_v1 still serves TYPE views only.
# None = body unavailable (fail closed: the caller widens, then MONO-PENDING).
var driver_template_body_loader_v1: TemplateBodyLoaderV1 = template_body_loader_new_v1()

fn driver_template_decl_names_v1(module: HirModule) -> [text]:
    var names: [text] = []
    for f in module.functions.values():
        val func: HirFunction = f
        if func.is_generic_template or (func.type_params != nil and func.type_params.len() > 0):
            names = names.push(func.name)
    for s in module.structs.values():
        val st: HirStruct = s
        if st.is_generic_template or (st.type_params != nil and st.type_params.len() > 0):
            names = names.push(st.name)
    for c in module.classes.values():
        val cl: HirClass = c
        if cl.is_generic_template or (cl.type_params != nil and cl.type_params.len() > 0):
            names = names.push(cl.name)
    names

# P-G5b: owner bodies this child did NOT admit, loaded from the HIR cache by
# the content key the HIR child published (`.hirkey` record). Single-flight and
# set-once per process: a module is loaded at most once; a failed load is
# remembered and never retried (fail closed -> widen / MONO-PENDING).
var driver_template_owner_bodies_v1: Dict<text, HirModule> = {}
var driver_template_owner_load_failed_v1: Dict<text, text> = {}

fn driver_template_owner_body_v1(owner: text, owner_path: text, hir_queue: text,
        modules: Dict<text, HirModule>) -> HirModule?:
    if owner == "":
        return nil
    if modules.contains_key(owner) and modules[owner] != nil:
        return modules[owner]
    if driver_template_owner_bodies_v1.contains_key(owner):
        return driver_template_owner_bodies_v1[owner]
    if driver_template_owner_load_failed_v1.contains_key(owner):
        return nil
    var reason = ""
    if owner_path == "":
        reason = "owner-path-unknown"
    else:
        val key = native_file_worker_hirkey_read_v1(hir_queue, owner_path)
        if key.is_err():
            reason = key.unwrap_err()
        else:
            val loaded = hir_cache_load_in_owned_scope(key.unwrap())
            if loaded == nil:
                reason = "hir-cache-miss"
            else:
                driver_template_owner_bodies_v1[owner] = loaded
                print "[file-worker] template-body owner-load module={owner}"
                return loaded
    driver_template_owner_load_failed_v1[owner] = reason
    print "[file-worker] template-body owner-load-miss module={owner} reason={reason}"
    nil

# F's transitive import closure as module names, walked over the HIR ledger's
# path-keyed deps records (frozen surface import targets), never over
# HirImport.module_path spellings: a spelling that differs from the module key
# no longer stops the walk. An unreadable record or an unknown path stops that
# edge only (fail closed: a miss, never a wrong owner).
fn driver_template_import_closure_v1(path: text, hir_queue: text,
        name_of_path: Dict<text, text>) -> [text]:
    var out: [text] = []
    var frontier: [text] = [path]
    var pos = 0
    while pos < frontier.len():
        val node = frontier[pos]
        pos = pos + 1
        val deps = native_file_worker_deps_read_v1(hir_queue, node)
        if deps.is_err():
            continue
        for d in deps.unwrap():
            if d == path or frontier.contains(d):
                continue
            frontier = frontier.push(d)
            if name_of_path.contains_key(d):
                out = out.push(name_of_path[d])
    out

fn driver_reader_concrete_instance_v1(template: text, requester_path: text,
        modules: Dict<text, HirModule>, declared: Dict<text, [text]>, closure: [text],
        content_of: Dict<text, text>, path_of_name: Dict<text, text>, hir_queue: text,
        type_arg_keys: [text]) -> Option<HirModule>:
    if not native_file_worker_reader_instances_enabled_v1(
            env_get(NATIVE_FILE_WORKER_READER_INSTANCES_ENV_V1) ?? "",
            native_file_worker_reader_instances_available_v1()):
        return None
    val owner = template_body_owner_of_v1(template, declared, closure)
    val owner_path = if owner != "" and path_of_name.contains_key(owner): path_of_name[owner] else: ""
    val body = driver_template_owner_body_v1(owner, owner_path, hir_queue, modules)
    var loaded = body != nil
    if loaded and owner_path == requester_path:
        loaded = false
    # Lazy: only the resolved owner is hashed, only on an E-MONO-040 miss.
    val digest = if owner != "" and content_of.contains_key(owner): sha256_text(content_of[owner]) else: ""
    val result = driver_template_body_loader_v1.load(owner, template, type_arg_keys, digest, loaded)
    if not result.found:
        print "[file-worker] template-body miss template={template} owner={owner} reason={result.pending_reason}"
        return None
    print "[file-worker] template-body {result.source} template={template} owner={owner}"
    Some(body!)


impl CompilerDriver:
    fn resolve_methods_impl() -> (CompileContext, bool):
        var ctx = self.ctx

        for name in ctx.hir_modules.keys():
            # Cycle-120: the plain dict-value read arrives erased (the
            # cycle-76/77 class) and this lane REINSERTS the corrupted value,
            # poisoning ctx.hir_modules for every later phase. Guard-first
            # double access (the campaign's 10/10 extraction form) instead;
            # the resolved module returns in a tuple and is reinserted from
            # the tuple element without an intermediate named bind.
            if not ctx.hir_modules.has(name):
                continue
            val hir_module: HirModule = ctx.hir_modules[name]
            val resolve_result = resolve_methods(hir_module)
            # Cycle-130: persist the owner-published module, not the tuple
            # slot (the tuple's HirModule corrupts at the native value ABI).
            ctx.hir_modules[name] = resolve_methods_module_owner.?

            # Update the module with resolved method calls (direct mutation)
            val resolve_errors = resolve_result.1

            # Collect errors
            for err in resolve_errors:
                ctx.add_error(
                    "Method resolution error in {name}: {err.message}")

        (ctx, not ctx.has_errors())

    me run_resolve_methods_quiet_gated():
        """SIMPLE_RESOLVE_METHODS=1 experiment (default OFF, 2026-09-01).

        Runs the QUIET method-resolution pass over every assembled HIR module
        — the pass real multi-source builds structurally never ran (see
        doc/08_tracking/bug/resolve_methods_never_runs_on_real_compile_path_2026-09-01.md,
        Fix scoping). Called from compile orchestration AFTER phase 3
        succeeds, so it covers both the streaming and the non-streaming
        lowering branches, and runs after every hir_cache store/load — the
        cache therefore carries unresolved modules on both flag settings and
        cannot be poisoned by the flag. Quiet mode records zero errors by
        construction (MethodResolver.add_error early-returns), so a build
        with the flag on can only gain resolved calls, never new failures."""
        val quiet_module_names = self.ctx.hir_modules.keys()
        var quiet_resolved_count = 0
        for quiet_name in quiet_module_names:
            val quiet_hir_module = self.ctx.hir_modules[quiet_name]
            val (quiet_resolved_module, quiet_errors) = resolve_methods_quiet(quiet_hir_module)
            # Cycle-130: owner-published module (tuple slot corrupts).
            self.ctx.hir_modules[quiet_name] = resolve_methods_module_owner.?
            quiet_resolved_count = quiet_resolved_count + 1
            if quiet_errors.len() > 0:
                # Cannot happen (quiet add_error is a no-op); loud if it does,
                # because silent error loss is this repo's worst failure class.
                eprint("[resolve-methods-quiet] INVARIANT BREAK: {quiet_errors.len()} error(s) recorded in quiet mode for module {quiet_name}")
        print "[resolve-methods-quiet] SIMPLE_RESOLVE_METHODS=1: {quiet_resolved_count} module(s) re-resolved"

    fn type_check_impl() -> (CompileContext, bool):
        var ctx = self.ctx
        # Type inference runs inside lower_and_check_impl() for Check mode.
        # This standalone method is kept for API compatibility but is a no-op.
        (ctx, not ctx.has_errors())

    me monomorphize_impl(hir_phase_admitted: bool) -> bool:
        self.monomorphize_with_policy(hir_phase_admitted, true)

    me monomorphize_for_explicit_compilation(hir_phase_admitted: bool) -> bool:
        self.monomorphize_with_policy(hir_phase_admitted, false)

    me monomorphize_with_policy(
        hir_phase_admitted: bool,
        allow_ambient_bootstrap_policy: bool
    ) -> bool:
        """Run monomorphization pass on all HIR modules.

        This creates specialized versions of generic functions, structs, and
        classes by substituting concrete type arguments. Call sites are
        rewritten to use the mangled names of specialized definitions.
        """
        log_debug("running monomorphization")
        # Phase admission is produced only after HIR lowering and every
        # post-HIR validator succeeds. Do not reconstruct that authority by
        # rereading CompileContext.error_count_value after a 609-module
        # aggregate return boundary: the Stage-3 native value ABI can corrupt
        # that adjacent scalar even though the canonical owner completed with
        # zero errors.
        if not self.analyze_collections_before_monomorphize(hir_phase_admitted):
            return false
        val skip_mono = if allow_ambient_bootstrap_policy:
            env_get("SIMPLE_BOOTSTRAP_SKIP_MONO")
        else:
            ""
        # SIMPLE_BOOTSTRAP=1 used to skip the pass too. That was only safe while
        # HIR lowering refused every generic fn; with that gate open (#158
        # Phase B, 2026-08-22) a skipped pass would hand generic templates to
        # MIR. Only the explicit SIMPLE_BOOTSTRAP_SKIP_MONO=1 escape remains.
        if skip_mono == "1":
            print "[bootstrap] skipping monomorphization (SIMPLE_BOOTSTRAP_SKIP_MONO=1)"
            return true
        # File-worker P4/P-G3 (per-file lane + SIMPLE_MIR_SHARD_ONLY_PATHS):
        # this MIR child lowers only the admitted modules, so mono runs
        # module-scoped for exactly those instead of the global pass.
        val scoped_paths = native_file_worker_only_paths_from_env_v1()
        val whole_program = env_get(NATIVE_BOOTSTRAP_WHOLE_PROGRAM_ENV_V1) ?? ""
        if mono_module_scoped_selected_v1(whole_program, scoped_paths.len() > 0):
            return self.monomorphize_file_worker_scoped_v1(scoped_paths)
        # P-G3: the per-file lane never runs the global pass.
        val in_file_worker_lane = (env_get("SIMPLE_FILE_WORKER_HIR_QUEUE") ?? "") != ""
        if native_file_worker_global_mono_forbidden_v1(whole_program, in_file_worker_lane):
            self.ctx.add_error("per-file lane: global monomorphize pass is forbidden (no admitted target paths; set SIMPLE_BOOTSTRAP_WHOLE_PROGRAM=1 for the whole-program lane)")
            return false
        # Cycle-121: the modules dict comes back through the module-global
        # owner (mono_report_modules_owner), not the 4-tuple return -- the
        # tuple's native value ABI corrupted the dict slot (the docstring
        # above documents this boundary; cycles 117-121 traced the poisoned
        # elements to here).
        val (mono_stats, mono_diags, mono_warnings) =
            run_monomorphization_with_report(self.ctx.hir_modules)
        log_phase("phase4:monomorphize:breakdown {mono_last_phase_profile_v1}")
        driver_publish_mono_warnings_and_stats_v1(self.ctx, mono_stats, mono_warnings)
        self.ctx.hir_modules = mono_report_modules_take()
        # SIMPLE_SDN_RACE_TRACE=1 companion (see driver_hir_pipeline_lowering):
        # if a module's counts changed across monomorphization (or a module
        # vanished), the SdnValue declaration loss is in the mono pass; if
        # identical to the hir-final lines, the loss is in MIR scope build.
        if (env_get("SIMPLE_SDN_RACE_TRACE") ?? "") == "1":
            val race_trace_keys: [text] = self.ctx.hir_modules.keys()
            for race_key in race_trace_keys:
                if self.ctx.hir_modules[race_key] == nil:
                    continue
                eprint("[race-trace] mono-final module={race_key} enums={self.ctx.hir_modules[race_key].enums.len()} classes={self.ctx.hir_modules[race_key].classes.len()} functions={self.ctx.hir_modules[race_key].functions.len()}")
        if not driver_publish_mono_diagnostics_v1(self.ctx, mono_diags, self.ctx.hir_modules.len()):
            return false
        # Section 9.5 post-monomorphization invariants (E-MONO-031). Runs on
        # the MONOMORPHIZED modules -- the whole point is that nothing generic,
        # unsubstituted, or type-erased survived, so it cannot run before this
        # assignment. Under `critical` ANY non-zero counter is fatal; every
        # other profile warns, so the inventory is visible during migration.
        val mono_report = post_mono_verify_modules(self.ctx.hir_modules)
        driver_publish_post_mono_report_v1(self.ctx, mono_report, self.ctx.hir_modules.len())

    me monomorphize_file_worker_scoped_v1(target_paths: [text]) -> bool:
        """Module-scoped mono for the file-worker MIR child. Templates for F
        are the HIR (loaded from the HIR cache by this child) of F's direct
        imports, read from the HIR ledger's deps record. On E-MONO-040 the
        set is widened once to the transitive import closure; if a template is
        still missing F is marked MONO-PENDING and the child fails closed, so
        no object is ever emitted from a partial template set. Non-target
        modules are left untouched: this child neither lowers nor emits them."""
        print "[file-worker] mir-child {worker_hir_counters_v1()}"
        val hir_queue = env_get("SIMPLE_FILE_WORKER_HIR_QUEUE") ?? ""
        val mir_queue = env_get("SIMPLE_MIR_SHARD_QUEUE") ?? ""
        var name_of_path: Dict<text, text> = {}
        # Owner content for the template-body loader (P-G4); hashed lazily.
        var content_of: Dict<text, text> = {}
        var path_of_name: Dict<text, text> = {}
        for src in self.ctx.sources:
            name_of_path[src.path] = src.module_name
            path_of_name[src.module_name] = src.path
            content_of[src.module_name] = src.content
        # Template declarations of closure modules, filled lazily (set-once).
        var declared: Dict<text, [text]> = {}
        var verified: Dict<text, HirModule> = {}
        for path in target_paths:
            if not name_of_path.contains_key(path) or self.ctx.hir_modules[name_of_path[path]] == nil:
                self.ctx.add_error("file-worker mono: no HIR for admitted module {path}")
                return false
            val name = name_of_path[path]
            val direct = native_file_worker_deps_read_v1(hir_queue, path)
            if direct.is_err():
                self.ctx.add_error("file-worker mono: {direct.unwrap_err()}")
                return false
            var dep_paths: [text] = direct.unwrap()
            var widened = false
            var done = false
            # Reader-provided concrete instance sources (P-G1), keyed by the
            # carrying module name; each template is asked for at most once.
            var reader_templates: Dict<text, HirModule> = {}
            var reader_asked: [text] = []
            var import_closure: [text] = []
            var closure_built = false
            while not done:
                var templates: Dict<text, HirModule> = {}
                for dep in dep_paths:
                    if name_of_path.contains_key(dep) and self.ctx.hir_modules[name_of_path[dep]] != nil:
                        templates[name_of_path[dep]] = self.ctx.hir_modules[name_of_path[dep]]
                for reader_key in reader_templates.keys():
                    if not templates.contains_key(reader_key):
                        templates[reader_key] = reader_templates[reader_key]
                val (scoped_module, scoped_stats, scoped_diags) =
                    run_monomorphization_module_scoped_v1(self.ctx.hir_modules[name], templates)
                var reader_served: i64 = 0
                for missing in native_file_worker_missing_templates_v1(scoped_diags):
                    if reader_asked.contains(missing):
                        continue
                    reader_asked = reader_asked.push(missing)
                    if not closure_built:
                        import_closure = driver_template_import_closure_v1(path, hir_queue, name_of_path)
                        for member in import_closure:
                            if declared.contains_key(member):
                                continue
                            val member_path = if path_of_name.contains_key(member): path_of_name[member] else: ""
                            val member_body = driver_template_owner_body_v1(member, member_path,
                                hir_queue, self.ctx.hir_modules)
                            if member_body != nil:
                                declared[member] = driver_template_decl_names_v1(member_body!)
                        closure_built = true
                    val served = driver_reader_concrete_instance_v1(missing, path,
                        self.ctx.hir_modules, declared, import_closure, content_of, path_of_name,
                        hir_queue, native_file_worker_missing_template_args_v1(scoped_diags, missing))
                    if served.is_some():
                        val carrier = served.unwrap()
                        reader_templates[carrier.name] = carrier
                        reader_served = reader_served + 1
                val decision = native_file_worker_mono_fallback_reader_v1(scoped_diags, widened, reader_served)
                if decision == "reader":
                    print "[file-worker] mono reader-instances module={name} served={reader_served}"
                elif decision == "widen":
                    var edges: Dict<text, [text]> = {}
                    var frontier: [text] = [path]
                    var pos = 0
                    while pos < frontier.len():
                        val node = frontier[pos]
                        pos = pos + 1
                        val node_deps = native_file_worker_deps_read_v1(hir_queue, node)
                        if node_deps.is_ok():
                            edges[node] = node_deps.unwrap()
                            for d in node_deps.unwrap():
                                if not frontier.contains(d):
                                    frontier = frontier.push(d)
                    dep_paths = native_file_worker_transitive_deps_v1(path, edges)
                    widened = true
                    print "[file-worker] mono widen module={name} templates={dep_paths.len()}"
                elif decision == "MONO-PENDING":
                    val _marked = native_file_worker_mono_pending_publish_v1(mir_queue, path, "E-MONO-040 after transitive widening")
                    for diag in scoped_diags:
                        self.ctx.add_error(diag)
                    self.ctx.add_error("MONO-PENDING: module {name} needs a template not visible through its imports")
                    return false
                else:
                    driver_publish_mono_warnings_and_stats_v1(self.ctx, scoped_stats, [])
                    if not driver_publish_mono_diagnostics_v1(self.ctx, scoped_diags, 1):
                        return false
                    self.ctx.hir_modules[name] = scoped_module
                    verified[name] = scoped_module
                    done = true
        val scoped_report = post_mono_verify_modules(verified)
        driver_publish_post_mono_report_v1(self.ctx, scoped_report, verified.len())

export publish_module_typecheck_receipt_v1

pub fn publish_module_typecheck_receipt_v1(ctx: CompileContext, receipt: HirTypecheckReceiptV1):
    for message in receipt.warnings:
        ctx.add_warning(message)
    for message in receipt.errors:
        ctx.add_error(message)

pub fn run_typecheck_warn_pass(
    ctx: CompileContext,
    hir_modules: Dict<text, HirModule>
) -> [text]:
    """Type-inference + visibility diagnostics, profile-gated for enforcement.

    This pass is where declared return types actually get checked: the check
    itself lives at 30.types/type_infer/inference_control.spl:564-574, where an
    annotated function's body is inferred in Check mode and `subsume(body_ty,
    fn_.return_type)` compares it against the declaration. Those errors land in
    `ictx.errors` and arrive here.

    Until 2026-08-17 this function returned them as strings and the caller only
    `log_warn`ed them, so a `fn f() -> bool` returning a text literal produced a
    genuine, correct diagnostic that was then thrown away — the build stayed
    green and both engines returned different wrong values at rc=0. That is a
    FAIL-OPEN, the same shape as `[use-warning]` reporting an unresolved import
    at rc=0.

    `severity` now decides whether the diagnostic also reaches `ctx`:
    Advisory (default, unchanged) log-only; Warn -> ctx.add_warning; Deny ->
    ctx.add_error, which fails the build. The default is deliberately Advisory
    because the true violation count over the full module set has never been
    measured — see the bug doc's step 2. Promote via SIMPLE_TYPECHECK_PROFILE
    only after a census.
    """
    # Keep module iteration, severity, diagnostic order, and feature policy.
    val severity = typecheck_pass_severity()
    var out: [text] = []
    for name in hir_modules.keys():
        val receipt = collect_module_typecheck_receipt_v1(name, hir_modules[name], severity)
        for message in receipt.messages:
            out = out.push(message)
        publish_module_typecheck_receipt_v1(ctx, receipt)
    out

pub fn run_safety_warn_pass(ctx: CompileContext,
        hir_modules: Dict<text, HirModule>) -> [text]:
    # Keep the existing warning-phase downgrade and shared transfer policy.
    val severity = safety_pass_severity_phased()
    val parallel_policy = ResolvedParallelPolicyV1.for_assurance(ctx.assurance_policy.strictness)
    var out: [text] = []
    for name in hir_modules.keys():
        val receipt = collect_module_safety_receipt_v1(name, hir_modules[name], severity, parallel_policy)
        for message in receipt.messages: out.push(message)
        publish_module_typecheck_receipt_v1(ctx, receipt)
    out

# ---------------------------------------------------------------------------
# Hardening passes (integrator I0, 2026-08-21)
#
# Both follow `run_safety_warn_pass` exactly: walk `hir_modules`, turn each
# checker diagnostic into a message, and route it to ctx.add_warning /
# ctx.add_error by profile. `critical` denies; every other profile warns.
# Unlike the safety pass there is no Advisory (log-only) rung: these checkers
# exist because the corresponding defect class was shipping silently, so the
# quietest setting they have is a visible warning.
#
# Every invocation records a receipt (driver_pass_receipt.spl), including the
# zero-diagnostic case, so "the checker is advisory because it never ran" is
# distinguishable from "it ran and found nothing".
# ---------------------------------------------------------------------------

# Bug native_build_hir_phase_scopes_2026_10_24: the any-escape, enum-contract
# and representation passes walk every module with no transient scope, so
# each walk's scratch (~1.3 MB/module measured for the enum-contract window at
# 472 modules) stays immortal in the no-GC runtime. The collectors are
# read-only ("Only rendered diagnostic arrays escape",
# hir_semantic_consumer_v1.spl) and write no global or ctx state, so each one
# runs in its own scope and only its receipt is promoted. Every persistent
# write -- publish_module_typecheck_receipt_v1 (ctx.add_warning/add_error),
# the `out` push, the representation write-back into `hir_modules` -- runs
# AFTER scope end. SIMPLE_HIR_SEMANTIC_PASS_SCOPE=0 restores the unscoped walk.
fn hir_semantic_pass_scope_enabled_v1() -> bool:
    (env_get("SIMPLE_HIR_SEMANTIC_PASS_SCOPE") ?? "") != "0"

fn _hir_pass_scope_open_v1(pass_name: text, name: text) -> bool:
    if not hir_semantic_pass_scope_enabled_v1(): return false
    if transient_array_scope_state_v1() != 0 or not transient_scope_begin():
        eprint("[hir-pass-scope] WARNING transient scope refused; running {pass_name} UNSCOPED, arena retained: module={name}")
        return false
    true

# Promotion stays in the frame that owns the receipt (a struct passed by value
# could reach a helper as a copy), and the three arrays are promoted too so the
# children survive even if the struct shell is a by-value no-op promotion.
# Re-promoting an already-immortal child is a documented no-op success.
fn _hir_pass_scope_failed_v1(pass_name: text, name: text, paused: bool, owned: bool, ended: bool):
    eprint("[hir-pass-scope] WARNING receipt promotion failed (paused={paused} owned={owned} ended={ended}); re-running {pass_name} UNSCOPED: module={name}")

fn _any_escape_receipt_scoped_v1(name: text, module: HirModule,
        strictness: AssuranceStrictness) -> HirTypecheckReceiptV1:
    if not _hir_pass_scope_open_v1("any_escape", name):
        return collect_module_any_escape_receipt_v1(name, module, strictness)
    val receipt: HirTypecheckReceiptV1 = collect_module_any_escape_receipt_v1(name, module, strictness)
    # @workaround bug=mono_generic_field_access_arg_unspecialized_2026-10-23 reason=stage2 mono cannot infer T from a field-access argument to transient_promote<T>; typed locals carry the same handles
    val messages_v: [text] = receipt.messages
    val warnings_v: [text] = receipt.warnings
    val errors_v: [text] = receipt.errors
    val paused = transient_scope_pause()
    val owned = paused and transient_promote(receipt) and transient_promote(messages_v) and
        transient_promote(warnings_v) and transient_promote(errors_v)
    val ended = transient_scope_end()
    if paused and owned and ended: return receipt
    _hir_pass_scope_failed_v1("any_escape", name, paused, owned, ended)
    collect_module_any_escape_receipt_v1(name, module, strictness)

fn _enum_contract_receipt_scoped_v1(name: text, module: HirModule,
        strictness: AssuranceStrictness) -> HirTypecheckReceiptV1:
    if not _hir_pass_scope_open_v1("enum_contract", name):
        return collect_module_enum_contract_receipt_v1(name, module, strictness)
    val receipt: HirTypecheckReceiptV1 = collect_module_enum_contract_receipt_v1(name, module, strictness)
    # @workaround bug=mono_generic_field_access_arg_unspecialized_2026-10-23 reason=stage2 mono cannot infer T from a field-access argument to transient_promote<T>; typed locals carry the same handles
    val messages_v: [text] = receipt.messages
    val warnings_v: [text] = receipt.warnings
    val errors_v: [text] = receipt.errors
    val paused = transient_scope_pause()
    val owned = paused and transient_promote(receipt) and transient_promote(messages_v) and
        transient_promote(warnings_v) and transient_promote(errors_v)
    val ended = transient_scope_end()
    if paused and owned and ended: return receipt
    _hir_pass_scope_failed_v1("enum_contract", name, paused, owned, ended)
    collect_module_enum_contract_receipt_v1(name, module, strictness)

fn _representation_receipt_scoped_v1(name: text, module: HirModule,
        strictness: AssuranceStrictness) -> HirTypecheckReceiptV1:
    if not _hir_pass_scope_open_v1("representation_manifest", name):
        return collect_module_representation_receipt_v1(name, module, strictness)
    val receipt: HirTypecheckReceiptV1 = collect_module_representation_receipt_v1(name, module, strictness)
    # @workaround bug=mono_generic_field_access_arg_unspecialized_2026-10-23 reason=stage2 mono cannot infer T from a field-access argument to transient_promote<T>; typed locals carry the same handles
    val messages_v: [text] = receipt.messages
    val warnings_v: [text] = receipt.warnings
    val errors_v: [text] = receipt.errors
    val paused = transient_scope_pause()
    val owned = paused and transient_promote(receipt) and transient_promote(messages_v) and
        transient_promote(warnings_v) and transient_promote(errors_v)
    val ended = transient_scope_end()
    if paused and owned and ended: return receipt
    _hir_pass_scope_failed_v1("representation_manifest", name, paused, owned, ended)
    collect_module_representation_receipt_v1(name, module, strictness)

# The bind result is written back into the persistent `hir_modules` by the
# caller, so it is promoted here and the module is never mutated in scope.
fn _representation_bind_scoped_v1(contexts: Dict<text, RepresentationSourceContextV1>,
        name: text, module: HirModule) -> [RepresentationDeclarationV1]:
    if not _hir_pass_scope_open_v1("representation_bind", name):
        return representation_bind_module_facts_v1(contexts, name, module)
    val declarations = representation_bind_module_facts_v1(contexts, name, module)
    val paused = transient_scope_pause()
    val owned = paused and transient_promote(declarations)
    val ended = transient_scope_end()
    if paused and owned and ended: return declarations
    eprint("[hir-pass-scope] WARNING declaration promotion failed (paused={paused} owned={owned} ended={ended}); re-running representation_bind UNSCOPED: module={name}")
    representation_bind_module_facts_v1(contexts, name, module)

pub fn run_any_escape_pass(
    ctx: CompileContext,
    hir_modules: Dict<text, HirModule>
) -> [text]:
    """REQ-MC-ANY-001: `Any` origin/escape analysis over every HIR module."""
    val strictness = ctx.assurance_policy.strictness
    var out: [text] = []
    var errors_raised = 0
    var modules_checked = 0
    for name in hir_modules.keys():
        modules_checked = modules_checked + 1
        val receipt = _any_escape_receipt_scoped_v1(name, hir_modules[name], strictness)
        for message in receipt.messages: out.push(message)
        errors_raised = errors_raised + receipt.errors.len()
        publish_module_typecheck_receipt_v1(ctx, receipt)
    val _receipt = record_pass_receipt(PassReceipt(
        pass_name: "any_escape",
        profile: strictness.name(),
        executed: true,
        modules_checked: modules_checked,
        diagnostics: out.len(),
        errors_raised: errors_raised
    ))
    out

pub fn run_enum_contract_pass(
    ctx: CompileContext,
    hir_modules: Dict<text, HirModule>
) -> [text]:
    """S2/S3: `@closed` / `@evolving` enum declaration contracts.

    Match-coverage half (`enum_contract_check_matches`) is driven from MIR
    lowering, which is where ResolvedMatchCoverage records are built; this pass
    owns the DECLARATION half, which only needs HIR."""
    val strictness = ctx.assurance_policy.strictness
    var out: [text] = []
    var errors_raised = 0
    var modules_checked = 0
    for name in hir_modules.keys():
        modules_checked = modules_checked + 1
        val receipt = _enum_contract_receipt_scoped_v1(name, hir_modules[name], strictness)
        for message in receipt.messages: out.push(message)
        errors_raised = errors_raised + receipt.errors.len()
        publish_module_typecheck_receipt_v1(ctx, receipt)
    val _receipt = record_pass_receipt(PassReceipt(
        pass_name: "enum_contract",
        profile: strictness.name(),
        executed: true,
        modules_checked: modules_checked,
        diagnostics: out.len(),
        errors_raised: errors_raised
    ))
    out

pub fn representation_invocation_context_index_v1(ctx: CompileContext) -> Dict<text, RepresentationSourceContextV1>:
    if val ready = ctx.representation_context_index_v1:
        return ready
    var contexts: Dict<text, RepresentationSourceContextV1> = {}
    var conflicting: Dict<text, bool> = {}
    for context in ctx.options.representation_sources:
        if contexts.contains_key(context.module_identity):
            conflicting[context.module_identity] = true
        else:
            contexts[context.module_identity] = context
    if ctx.options.representation_sources.len() == 0:
        ctx.representation_context_index_v1 = Some(contexts)
        return contexts
    var source_identities: Dict<text, text> = {}
    var source_conflicts: Dict<text, bool> = {}
    if ctx.source_module_names_owner.len() > 0 and
            ctx.source_module_names_owner.len() == ctx.source_identities_owner.len() and
            ctx.source_module_names_owner.len() == ctx.source_paths_owner.len():
        for i in 0..ctx.source_module_names_owner.len():
            val name = ctx.source_module_names_owner[i]
            if source_identities.contains_key(name):
                source_conflicts[name] = true
            else:
                source_identities[name] = ctx.source_identities_owner[i]
    else:
        for source in ctx.sources:
            if source_identities.contains_key(source.module_name):
                source_conflicts[source.module_name] = true
            else:
                source_identities[source.module_name] = sha256_text(source.content)
    var admitted: Dict<text, RepresentationSourceContextV1> = {}
    for name in contexts.keys():
        if contexts.contains_key(name) and not conflicting.contains_key(name) and
                not source_conflicts.contains_key(name) and source_identities.contains_key(name):
            val proposed = contexts[name]
            if proposed.source_identity == source_identities[name]:
                admitted[name] = proposed
    ctx.representation_context_index_v1 = Some(admitted)
    admitted

pub fn representation_bind_module_facts_v1(contexts: Dict<text, RepresentationSourceContextV1>,
        name: text, module: HirModule) -> [RepresentationDeclarationV1]:
    val missing = RepresentationSourceContextV1(package_identity: "", module_identity: name,
        owner_kind: "project-config", owner_manifest_path: "", owner_manifest_digest: "", source_identity: "")
    val context = contexts[name] ?? missing
    representation_bind_hir_v1(module, context)

pub fn run_representation_manifest_pass(ctx: CompileContext,
        hir_modules: Dict<text, HirModule>) -> [text]:
    val strictness = ctx.assurance_policy.strictness
    val contexts = representation_invocation_context_index_v1(ctx)
    var out: [text] = []
    var errors_raised = 0
    for name in hir_modules.keys():
        var module: HirModule = hir_modules[name]
        module.representation_declarations = _representation_bind_scoped_v1(contexts, name, module)
        hir_modules[name] = module
        val receipt = _representation_receipt_scoped_v1(name, module, strictness)
        for message in receipt.messages: out.push(message)
        errors_raised = errors_raised + receipt.errors.len()
        publish_module_typecheck_receipt_v1(ctx, receipt)
    val _receipt = record_pass_receipt(PassReceipt(pass_name: "representation_manifest",
        profile: strictness.name(), executed: true, modules_checked: hir_modules.keys().len(),
        diagnostics: out.len(), errors_raised: errors_raised))
    out
