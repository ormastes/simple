            while direct_idx < self.ctx.sources.len():
                val src_direct = self.ctx.sources[direct_idx]
                val name_direct = src_direct.module_name
                var mir_direct = if native_entry_closure_mir or driver_source_matches_entry(self.ctx, src_direct.path, name_direct) or (sosix_env_get_nullable("SIMPLE_UNSTUB_HIR") ?? "") == "1":
                    log_phase("aot:lower_to_mir:module:start idx={direct_idx} module={name_direct} path={src_direct.path}")
                    val direct_hir = self.ctx.hir_modules[name_direct]
                    # ICE boundary: a module with no HIR is recorded and the loop
                    # goes on to its siblings (driver_ice_boundary.spl).
                    var ice_message = ice_boundary_module_start(name_direct, src_direct.path, "mir_lower", "")
                    var ice_arena_aborted = ice_message_arena_aborted(ice_message)
                    if ice_message == "" and direct_hir == nil:
                        ice_message = "MIR lowering missing HIR module for {name_direct} ({src_direct.path})"
                        log_phase("aot:lower_to_mir:missing_hir idx={direct_idx} module={name_direct} path={src_direct.path}")
                    var lowered_entry: MirModule = MirModule(name: name_direct, functions: {}, statics: {}, constants: {}, types: {})
                    if ice_message == "":
