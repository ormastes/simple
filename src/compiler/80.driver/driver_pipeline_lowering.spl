        # bootstrap CLI was requested but did not lower.
        var bootstrap_entry_requested = false
        var bootstrap_entry_idx = 0
        while bootstrap_entry_idx < self.ctx.sources.len():
            if self.ctx.sources[bootstrap_entry_idx].module_name == "app.cli.bootstrap_main":
                bootstrap_entry_requested = true
            bootstrap_entry_idx = bootstrap_entry_idx + 1
        if self.ctx.runtime_std_full_inventory_selection == nil and allow_bootstrap_shortcuts and bootstrap_entry_requested and (sosix_env_get_nullable("SIMPLE_BOOTSTRAP") ?? "") == "1" and (sosix_env_get_nullable("SIMPLE_BOOTSTRAP_STAGE4") ?? "") != "1":
            val bootstrap_hir = self.ctx.hir_modules["app.cli.bootstrap_main"]
