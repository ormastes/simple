                            ice_arena_aborted = true
                            ice_message = "MIR lowering transient scope failed for {name_direct}: {scoped_entry.unwrap_err()}"
                            log_phase("aot:lower_to_mir:transient_scope_failed idx={direct_idx} module={name_direct}")
