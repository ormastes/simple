fn _driver_mcdc_mir_mode(ctx: CompileContext) -> i64:
    # EXPLICIT COMPARISONS, not `match`. The default is "off" -> 0, yet the
    # bootstrap lane emitted `mcdc_static_probe_mask_range` calls -- a symbol no
    # runtime in this tree defines (grep of src/runtime finds nothing), so every
    # native link failed with "Undefined symbols for architecture arm64". That
    # means this function returned 1 while the config said "off": the `match`
    # arms mis-dispatched, selecting a value arm over the `_` catch-all. Same
    # staged-lane match hazard already worked around with explicit discriminant
    # dispatch elsewhere in the backend. Equality tests do not depend on match
    # arm binding, so the "off" default is honoured.
    val mcdc_requested = ctx.config["mcdc_mode"] ?? "off"
    if mcdc_requested == "on" or mcdc_requested == "static" or mcdc_requested == "static-on":
        return 1
    if mcdc_requested == "dynamic" or mcdc_requested == "dynamic-aspect":
        return 2
    0

fn _driver_mcdc_budget(ctx: CompileContext, key: text, fallback: i64) -> i64:
    if val raw = ctx.config[key]:
        if val parsed = try_parse_int(raw):
            if parsed > 0: return parsed
        ctx.add_error("MCDC-E-BUFFER-CAP: {key} must be a positive integer, got '{raw}'")
        return 0
    fallback

# Diagnostics-plumbing: MirLowering.errors was silently dropped on the
# native-build worker path (nothing outside 70.backend read it), so a bare
# `nosuchfn(1)` call or an unsupported construct produced broken MIR that
# only surfaced later as an llc crash / nil-callee far from the real cause.
# Format each MirError the same way jit_interpreter.spl / compiler.spl
# already report them (message, plus file:line:col when the span is known).
fn _format_mir_error(err: MirError) -> text:
    # Staged native Option payloads can be malformed. Diagnostics must still
    # report the original failure instead of crashing while formatting a span,
    # so the span is read through the `if val` Option-binding form (never a
    # direct `err.span.line` field access) and any span whose `file` is empty
    # -- the zero-value default `Span.default()`/`Span.empty()` a call site
    # passes when it has no real location -- is treated as "no span" rather
    # than printed as a misleading `:1:1`.
    if val span = err.span:
        if span.file != "":
            return "MIR lowering error: {err.message} at {span.file}:{span.line}:{span.col}"
        if span.line > 0:
            return "MIR lowering error: {err.message} at line {span.line}:{span.col}"
    if err.message.starts_with("for-in over non-array iterables"):
        return "MIR lowering error: {err.message} at <source span unavailable>"
    "MIR lowering error: {err.message}"

# MirLowering.errors mixes genuine "this MIR is broken" failures with
# recoverable/informational entries the lowering pipeline pushes through the
# same channel and then continues past (e.g. `lower_type` falling back to
# MirType.I64 for a HIR type it can't map 1:1 — commonly HirTypeKind.Infer,
# since this pipeline has no expression type-inference pass; or the asm
# target-match "note:"-prefixed advisories in asm_and_targets.spl). Treating
# every entry as fatal regresses currently-passing builds: confirmed
# empirically that native-smoke-matrix cases (8) enum_match and (13)
# dict_index both hit "unsupported MIR type kind: ..." on every
# currently-passing build and still produce correct output.
#
# So this allowlists the specific message shapes that name an actually
# unresolved symbol/construct with no fallback — the class of bug this fix
# targets (a bare `nosuchfn(1)` call, or a first-class lambda value passed
# where only a direct call is supported) — and leaves everything else as a
# non-fatal warning.
#
# silentfactory audit (2026-07-14): widened this allowlist after reading
# every self.error(...) call site in 50.mir/_MirLoweringExpr/expr_dispatch.spl
# and switch_operators_calls.spl. Added, each confirmed unreachable by any
# currently-passing native-smoke-matrix case (verified empirically, not just
# by inspection):
#   - "undefined variable" (was "undefined variable:" only — the Var(symbol)
#     case in expr_dispatch.spl pushes the bare, colon-less "undefined
#     variable" string with no name, so it fell through this prefix check
#     entirely and silently produced an i64 nil temp).
#   - "unsupported array/string slice index" — MIGRATED 2026-08-25 to
#     `error_fatal` at its only site (expr_dispatch.spl); entry removed from
#     the list below. It was the third casualty of exactly the hazard this
#     header describes: rewording it to name the range form it actually
#     reports turned a clean build failure into a silent success emitting the
#     placeholder const 0. Original note follows: a[start:end] has no native
#     lowering; was silently producing a garbage value.
#   - "B5b" — every int-literal `match` Phase-2 diagnostic in
#     lower_int_match's arm loop (non-IntLit literal/Or, Tuple/Array/Struct/
#     Range/Error pattern kinds, missing wildcard default, duplicate
#     default arms) shares this prefix; none of these pattern shapes appear
#     in the matrix's enum_match/result_try_op cases, which route through
#     lower_enum_match instead and never reach this arm loop.
#   - "match default binding has no resolved symbol" — an internal
#     invariant violation (the `if val default_symbol = default_binding`
#     bind succeeded but the value is nil), never a normal fallback.
#   - "enum match:" — bare/ambiguous/unknown variant and unsupported arm
#     pattern in lower_enum_match; the function's own comment already says
#     "emit a LOUD error instead of silently falling through", it just
#     wasn't wired to this allowlist. Matrix's enum_match/result_try_op
#     cases use fully-qualified, registered variants and never hit this.
#   - "enum construction: unregistered enum" — lower_enum_lit only runs for
#     the explicit `EnumName.Variant(...)` HIR shape with a resolved Named
#     type; Ok/Err/Option construction is gated separately (see the
#     enum_variant_index.has("Result"/"Option") checks in
#     switch_operators_calls.spl) and never reaches this function, so
#     result_try_op is unaffected.
#   - "unsupported struct field initializer" — a Lambda literal (or other
#     value lower_expr can't handle) in field-initializer position; that
#     call site's own comment says the fix's whole point is "a clean loud
#     build failure, never a crash". Matrix's struct_field case only ever
#     passes int literals.
#
# iterators lane (2026-07-14): added "for-in over non-array iterables" —
# lower_for_iterator (mir_lowering_stmts.spl, #143) already records this via
# self.error(...) AND emits a belt-and-braces rt_panic call for any `for x in
# c:` where `c` is neither a Range nor a runtime array (e.g. `for ch in
# some_string:` — bug #143 confirmed still unimplemented natively). Without
# this prefix in the allowlist, the message was downgraded to a warning, the
# build silently SUCCEEDED, and the failure only surfaced as a runtime PANIC
# when the binary ran — the exact "silent success, loud crash later" shape
# this allowlist exists to prevent for every other unsupported-construct
# message. Verified empirically against the full native-smoke-matrix (all 15
# cases still PASS): no passing case iterates a non-array/non-range
# collection, so this cannot regress currently-working native-build output.
#
# DEPRECATED (2026-07-28) — do not add new prefixes to this list.
# ---------------------------------------------------------------------------
# Fatality is now a property the *call site* declares: `MirError.fatal`, set by
# `MirLowering.error_fatal(...)` (50.mir/_MirLowering/asm_and_targets.spl).
# This list survives only as a fallback for the 50.mir sites not yet migrated
# and for any out-of-tree producer of MirError.
#
# Why it is deprecated: it makes control flow depend on diagnostic *wording*
# maintained in a different layer, so a reworded message silently changes build
# semantics — with no test, type, or compiler error to catch it. Two live
# casualties found on 2026-07-28, both silent:
#   * "unsupported Result {operation} payload type" — the entry below spells
#     "…unwrap payload type", so `.unwrap()` was fatal but `.unwrap_err()` was
#     NOT (`_err` breaks `starts_with`) and its payload lowered to const 0.
#   * "enum construction: missing runtime identity for '…'" — the entry below
#     spells "enum construction: unregistered enum", so a missing runtime enum
#     identity fell through and lowered to the sentinel enum id -1.
# Both are now fatal via `error_fatal` at the site, independent of wording.
#
# The mechanism is also structurally unable to cover asm `compile_error("…")`
# arms: those carry *user-authored* text (`arm.error_message`), which no
# allowlist in this layer can ever enumerate.
#
# New fatal sites: call `self.error_fatal(...)` in 50.mir. Nothing here.
fn _mir_error_is_fatal(message: text) -> bool:
    message.starts_with("undefined variable") or
        message.starts_with("unresolved method call:") or
        message.starts_with("unsupported MIR expression:") or
        message.starts_with("match guards (case x if cond:) are not supported") or
        message.starts_with("B5b") or
        message.starts_with("match default binding has no resolved symbol") or
        message.starts_with("enum match:") or
        message.starts_with("enum construction: unregistered enum") or
        message.starts_with("unsupported struct field initializer") or
        message.starts_with("unsupported Result unwrap payload type") or
        message.starts_with("for-in over non-array iterables")

# The logical-name memo retains only what is warmed at a scope-free point
# (00.common/module_path_naming.spl), and MIR lowers every module inside a
# transient scope. Warm the names MIR re-derives per module -- each module's
# own name and every symbol's defining module -- here, at state 0. Keys are
# persistent HIR strings; other misses stay correct, merely uncached. The flat
# bootstrap rows carry the registry spelling, which differs from `module.name`
# under SIMPLE_BOOTSTRAP=1 and is looked up per module over all modules.
# Symbol ids are dense below next_symbol_id; iterating them avoids
# materialising a keys() array on the immortal heap.
fn driver_warm_mir_logical_names_v1(modules: Dict<text, HirModule>):
    for module_key in modules.keys():
        val module: HirModule = modules[module_key]
        module_logical_name_cache_warm(module_key)
        module_logical_name_cache_warm(module.name)
        var raw_id: i64 = 0
        while raw_id < module.symbols.next_symbol_id:
            val owner = module.symbols.symbol_defining_module_scalar_raw(raw_id)
            if owner != "":
                module_logical_name_cache_warm(owner)
            raw_id = raw_id + 1
    var flat_index: i64 = 0
    while flat_index < bootstrap_hir_module_count():
        module_logical_name_cache_warm(bootstrap_hir_module_name_at(flat_index))
        flat_index = flat_index + 1

fn driver_trait_devirtualization_allowed_v1(
    whole_closure_lowered: bool, archive_producing: bool,
    demand_routed: bool) -> bool:
    """Trait-object devirtualization (MirLowering.trait_impl_closure_complete).

    Sound only when the implementor set is the closure's AND the result can
    never be reused against a different implementor set:
    - whole_closure_lowered: every source is a real HIR module lowered here;
    - not demand_routed: a demand/package-index route lowers dirty packages
      only and reuses archived MIR for the rest;
    - not archive_producing: the full-inventory cold lane publishes every
      module's MIR into package archives, and an archived consumer is not
      invalidated when another package later adds an implementor. Devirtualized
      MIR is therefore produced only in lanes that never archive it.
    (bug stage2_trait_typed_receiver_method_unresolved_2026-10-10)"""
    whole_closure_lowered and not archive_producing and not demand_routed

fn _driver_mir_ice_continue(ctx: CompileContext, name: text, path: text, message: text, arena_aborted: bool) -> bool:
    """Record a module whose MIR lowering failed. True when the lowering loop
    may go on to the remaining modules. The phase fails either way.

    `arena_aborted` is the `lower_module_transient_scoped` Err case: that Err
    is returned only after the scope machinery failed and the arena was
    aborted, so the shared lowering instance is half-reclaimed and lowering
    another module on it would be use-after-reclaim. That path never
    continues. Keep-going is for failures that left the lowering intact (a
    missing HIR module), in keep-going mode, within the poison budget (1 under
    --fail-fast). Without a run directory this is release behaviour: the
    message is added unchanged and the loop stops."""
    ctx.add_error(ice_boundary_fail(name, path, "mir_lower", "", message))
    if arena_aborted or not ice_boundary_keep_going():
        return false
    ctx.mark_module_poisoned(name)
    not ctx.poison_budget_exhausted()

fn driver_mir_error_is_fatal_v1(error: MirError) -> bool:
    error.fatal or _mir_error_is_fatal(error.message)

fn driver_mir_has_new_fatal_errors_v1(errors: [MirError], start: i64) -> bool:
    var index = start
    while index >= 0 and index < errors.len():
        val error: MirError = errors[index]
        if driver_mir_error_is_fatal_v1(error): return true
        index = index + 1
    false

fn _driver_collect_mir_errors(ctx: CompileContext, errors: [MirError]):
    # `err.fatal` is the site's own explicit declaration and takes precedence.
    # `_mir_error_is_fatal(err.message)` is the deprecated message-text fallback
    # kept so the 99 already-fatal sites behave exactly as before.
    for err in errors:
        if driver_mir_error_is_fatal_v1(err):
            ctx.add_error(_format_mir_error(err))
        else:
            ctx.add_warning(_format_mir_error(err))

fn _mir_advisory_code(message: text) -> text:
    val colon = message.index_of(":") ?? -1
    if colon <= 0:
        return "E-MIR-ADVISORY"
    message.substring(0, colon)

fn driver_collect_mir_advisories(ctx: CompileContext, advisories: [MirError]):
    """Report MIR lowering advisories (`MirLowering.mir_advisories`:
    E-MIR-TYPE-Error, E-MIR-MATCH-GUARD at their default level) as driver
    WARNINGS. They never enter `MirLowering.errors`, so they cannot fail a
    build here or on any other route. Output is capped per advisory code
    (`mir_verify_warning_cap()` lines, then one count line); the full count
    goes to the `mir_lowering_advisory` pass receipt."""
    val cap = mir_verify_warning_cap()
    log_phase("mir_advisories:scan:start")
    var codes: [text] = []
    var counts: Dict<text, i64> = {}
    for advisory in advisories:
        val code = _mir_advisory_code(advisory.message)
        val seen = counts[code] ?? 0
        if seen == 0:
            codes = codes.push(code)
        counts[code] = seen + 1
        if seen < cap:
            ctx.add_warning(_format_mir_error(advisory))
    for code in codes:
        val total = counts[code] ?? 0
        if total > cap:
            ctx.add_warning("MIR lowering advisory {code}: {total} in this build; first {cap} shown, {total - cap} more not shown (SIMPLE_MIR_VERIFY_LEVELS={code}=off silences, {code}=error makes them fatal)")
    log_phase("mir_advisories:scan:done")
    log_phase("mir_advisories:receipt:start")
    val _advisory_receipt = record_pass_receipt(PassReceipt(
        pass_name: "mir_lowering_advisory",
        profile: ctx.assurance_policy.strictness.name(),
        executed: true,
        modules_checked: 0,
        diagnostics: advisories.len(),
        errors_raised: 0
    ))
    log_phase("mir_advisories:receipt:done")

impl CompilerDriver:
    # --------------------------------------------------------------------------
    # MIR Lowering
    # --------------------------------------------------------------------------

    me lower_to_mir() -> bool:
        val lowered = self.lower_to_mir_with_target_context(
            driver_mir_target_context(self.ctx.options), false, true)
        # A failed lowering already reported its errors and nothing will be
        # handed to a backend; verifying the partial module set would only
        # stack a second error on top (e.g. a malformed level spec).
        if not lowered:
            return false
        log_phase("aot:verify_lowered_mir:start")
        self.verify_lowered_mir_v1()

    me lower_to_mir_for_explicit_target(target_context: MirTargetContext) -> bool:
        val lowered = self.lower_to_mir_with_target_context(target_context, true, false)
        if not lowered:
            return false
        log_phase("aot:verify_lowered_mir_explicit_target:start")
        self.verify_lowered_mir_v1()

    me verify_lowered_mir_v1() -> bool:
        """Mandatory MIR validity verification (RB-19A) over every lowered
        module, before any optimizer, backend, or cache publication.

        Both public lowering entry points route through here, so every lane
        (interpreter-side AOT, native-build worker, bootstrap stages 2-4,
        LLVM IR emission) gets the same gate. Fatal rules go through the same
        channel as `MirError.fatal` (`ctx.add_error`); warn-first rules and
        the one-level downgrade under SIMPLE_ASSURANCE_WARNING_PHASE go to
        `ctx.add_warning`. Returns false when at least one fatal finding was
        recorded, so nothing invalid reaches codegen.

        Levels are resolved ONCE here. A malformed SIMPLE_MIR_VERIFY_LEVELS
        is a build error (fail closed), and when every rule is `off` the
        walk itself is skipped (receipt state=skipped). Warning lines are
        capped per rule per build; errors are never capped."""
        log_phase("mir_verify:levels:start")
        val levels = mir_verify_levels_from_env()
        log_phase("mir_verify:levels:done")
        if levels.config_error != "":
            self.ctx.add_error("MIR verify: invalid SIMPLE_MIR_VERIFY_LEVELS ({levels.config_error}); refusing to guess a level. Valid: <MIRV-id|E-MIR-TYPE-Error|E-MIR-MATCH-GUARD|*>=<error|warning|off>, comma separated")
            return false
        if levels.verifier_off:
            val _mir_verify_skip_receipt = record_pass_receipt(PassReceipt(
                pass_name: "mir_verify",
                profile: self.ctx.assurance_policy.strictness.name(),
                executed: false,
                modules_checked: 0,
                diagnostics: 0,
                errors_raised: 0
            ))
            log_phase("mir_verify: skipped (every rule is off in SIMPLE_MIR_VERIFY_LEVELS)")
            return true
        val warning_cap = mir_verify_warning_cap()
        var rule_order: [text] = []
        var rule_warnings: Dict<text, i64> = {}
        val warning_phase = warning_phase_enabled_for_value(
            sosix_env_get_nullable(warning_phase_env_var_name()) ?? "")
        var modules_checked = 0
        var findings_total = 0
        var fatal_total = 0
        var suppressed_total = 0
        var functions_total = 0
        var instructions_total = 0
        var mir_module_names: [text] = []
        for mir_name in self.ctx.mir_modules.keys():
            mir_module_names = mir_module_names.push(mir_name)
        var bootstrap_only: [MirModule] = []
        if val entry_mir = self.ctx.bootstrap_entry_mir:
            if self.ctx.mir_modules[entry_mir.name] == nil:
                bootstrap_only = bootstrap_only.push(entry_mir)
        var idx = 0
        while idx < mir_module_names.len() + bootstrap_only.len():
            val module: MirModule = if idx < mir_module_names.len():
                self.ctx.mir_modules[mir_module_names[idx]]!
            else:
                bootstrap_only[idx - mir_module_names.len()]
            idx = idx + 1
            log_phase("mir_verify:module:start idx={idx} module={module.name}")
            val report = mir_verify_module(module)
            log_phase("mir_verify:module:done idx={idx} module={module.name}")
            modules_checked = modules_checked + 1
            functions_total = functions_total + report.functions_checked
            instructions_total = instructions_total + report.instructions_checked
            for finding in report.findings:
                # Per-rule level: registry default (all `warning` for the
                # warn-first landing) overridden by SIMPLE_MIR_VERIFY_LEVELS
                # ("MIRV-002=error,MIRV-005e=off,*=warning"). `off` = not
                # reported; `error` = fatal unless the global warning phase
                # downgrades it one level.
                val level = levels.level_of(finding.rule)
                if level == "off":
                    suppressed_total = suppressed_total + 1
                    continue
                findings_total = findings_total + 1
                val fatal = level == "error" and not warning_phase
                if fatal:
                    fatal_total = fatal_total + 1
                    self.ctx.add_error(finding.format())
                else:
                    val rule_seen = rule_warnings[finding.rule] ?? 0
                    if rule_seen == 0:
                        rule_order = rule_order.push(finding.rule)
                    rule_warnings[finding.rule] = rule_seen + 1
                    if rule_seen < warning_cap:
                        self.ctx.add_warning(finding.format())
        var per_rule = ""
        for capped_rule in rule_order:
            val rule_total = rule_warnings[capped_rule] ?? 0
            per_rule = per_rule + " {capped_rule}={rule_total}"
            if rule_total > warning_cap:
                self.ctx.add_warning("MIR verify [{capped_rule}]: {rule_total} warning(s) in this build; first {warning_cap} shown, {rule_total - warning_cap} more not shown (SIMPLE_MIR_VERIFY_LEVELS={capped_rule}=off silences)")
        val _mir_verify_receipt = record_pass_receipt(PassReceipt(
            pass_name: "mir_verify",
            profile: self.ctx.assurance_policy.strictness.name(),
            executed: true,
            modules_checked: modules_checked,
            diagnostics: findings_total,
            errors_raised: fatal_total
        ))
        log_phase("mir_verify: modules={modules_checked} functions={functions_total} instructions={instructions_total} findings={findings_total} fatal={fatal_total} suppressed={suppressed_total} warnings_by_rule:{per_rule}")
        if fatal_total > 0:
            print "error[MIRV]: MIR validity verification found {fatal_total} fatal finding(s) across {modules_checked} module(s); refusing to hand invalid MIR to any backend"
            return false
        true

    me publish_runtime_std_mir_emissions_v1() -> bool:
        if self.ctx.runtime_std_full_inventory_selection != nil:
            # Hoist the selection's scalars into locals BEFORE the loop and
            # never bind the unwrapped aggregate: the `!` unwrap holds an
            # Exclusive borrow on self.ctx for as long as the binding is
            # live, and every self.ctx.add_error inside the loop re-acquires
            # Exclusive on the same reference — the seed capability checker
            # rejects that with "reference N already has Exclusive
            # capability, cannot acquire Exclusive" (stage-2 self-build
            # regression from 43c3f3d979a).
            val selection_inventory_digest = self.ctx.runtime_std_full_inventory_selection.?.source_inventory_digest
            val selection_artifact_root = self.ctx.runtime_std_full_inventory_selection.?.artifact_root
            # Snapshot every self.ctx field the loop touches into locals BEFORE
            # the loop. for-in over self.ctx.sources holds an Exclusive borrow
            # on self.ctx (reference 9) for the whole iteration, so any inner
            # self.ctx access -- including the read-only dict probes and every
            # self.ctx.add_error -- re-acquires a reference the iteration still
            # owns; the seed capability checker rejects that with "reference 9
            # already has Exclusive capability, cannot acquire Exclusive".
            val sources = self.ctx.sources
            val cold_receipts = self.ctx.cold_hir_typed_receipts
            val mir_modules = self.ctx.mir_modules
            val cfg_decisions = self.ctx.runtime_std_cfg_decisions
            val native_target = self.ctx.native_target
            val hir_emissions = self.ctx.runtime_std_hir_emissions
            var emissions: Dict<text, RuntimeStdMirModuleEmissionV1> = {}
            # Index-based iteration, not for-in: the for-iterator held an
            # Exclusive borrow on the iterated value for the whole loop body,
            # so any self.ctx access inside re-acquired a live reference and
            # the seed capability checker rejected it ("reference 9 already
            # has Exclusive capability"). Indexing borrows only for the
            # expression, and the six field snapshots above keep every other
            # self.ctx field read out of the body entirely.
            var source_idx = 0
            while source_idx < sources.len():
                val source = sources[source_idx]
                val name = source.module_name
                var found_index = -1
                var receipt_index = 0
                while receipt_index < cold_receipts.len():
                    if cold_receipts[receipt_index].seed.module_identity == name:
                        if found_index >= 0:
                            self.ctx.add_error("full inventory cold MIR has duplicate typed source: {name}")
                            return false
                        found_index = receipt_index
                    receipt_index = receipt_index + 1
                if found_index < 0 or not mir_modules.contains_key(name):
                    self.ctx.add_error("full inventory cold MIR source is missing: {name}")
                    return false
                val receipt = cold_receipts[found_index]
                val seed = receipt.seed
                if not cfg_decisions.has(seed.source_identity) or
                        not frontend_cfg_receipt_valid_v1(
                            cfg_decisions[seed.source_identity],
                            seed.source_identity, seed.source_digest,
                            native_target):
                    self.ctx.add_error("full inventory target cfg MIR source receipt mismatch: {name}")
                    return false
                if seed.inventory_digest != selection_inventory_digest or
                        emissions.contains_key(seed.source_identity) or
                        not hir_emissions.contains_key(seed.source_identity):
                    self.ctx.add_error("full inventory cold MIR source authority mismatch: {name}")
                    return false
                val hir_emission = hir_emissions[seed.source_identity]
                if hir_emission.module_identity != name or
                        hir_emission.source_digest != seed.source_digest:
                    self.ctx.add_error("full inventory cold MIR typed HIR mismatch: {name}")
                    return false
                val emitted = runtime_std_mir_emit_module_v1(
                    mir_modules[name], receipt, selection_artifact_root)
                if emitted.is_err():
                    self.ctx.add_error("full inventory cold MIR emission failed for {name}: {emitted.unwrap_err()}")
                    return false
                emissions[seed.source_identity] = emitted.unwrap()
                source_idx = source_idx + 1
            if emissions.len() != sources.len():
                self.ctx.add_error("full inventory cold MIR emission count mismatch")
                return false
            self.ctx.runtime_std_mir_emissions = emissions
        true

    me lower_archived_to_mir_v1(final_repository: MonoArchiveFinalRepositoryV1,
            target_context: MirTargetContext, force_all_sources: bool,
            allow_bootstrap_shortcuts: bool) -> bool:
        # This private route is only issued by the real full0 production owner.
        # Policy mismatch is fatal and cannot fall back to the retained graph.
        if final_repository.force_all_sources != force_all_sources or
                final_repository.allow_bootstrap_shortcuts != allow_bootstrap_shortcuts or
                final_repository.bootstrap_mode == "1" or final_repository.emission_rows.len() == 0:
            self.ctx.add_error("MIR final repository policy or emission schedule differs")
            return false
        val projected = mir_archive_declaration_repository_v1(self, final_repository)
        if projected.is_err():
            self.ctx.add_error("MIR complete declaration projection failed: {projected.unwrap_err()}")
            return false
        val declarations = projected.unwrap()
        val first = final_repository.emission_rows[0]
        val seeded = mir_archive_seed_symbols_v1(self, final_repository, declarations, first.logical_name)
        if seeded.is_err():
            mir_archive_declaration_publication_revoke_v1(self)
            self.ctx.add_error("MIR declaration symbol scratch failed: {seeded.unwrap_err()}")
            return false
        var lowering = MirLowering.new_for_target(seeded.unwrap(), target_context)
        lowering.use_explicit_semantic_policy()
        lowering.configure_mcdc_mode(_driver_mcdc_mir_mode(self.ctx),
            _driver_mcdc_budget(self.ctx, "mcdc_owner_bytes", 1048576),
            _driver_mcdc_budget(self.ctx, "mcdc_global_bytes", 67108864),
            self.ctx.config["mcdc_include"] ?? "", self.ctx.config["mcdc_exclude"] ?? "")
        lowering.trait_impl_closure_complete = driver_trait_devirtualization_allowed_v1(true,
            self.ctx.runtime_std_full_inventory_selection != nil,
            self.ctx.demand_mir_admission != nil or self.ctx.demand_dirty_modules.len() > 0)
        val prepared = mir_archive_prepare_declarations_v1(self, lowering, final_repository, declarations)
        if prepared.is_err():
            mir_archive_declaration_publication_revoke_v1(self)
            self.ctx.add_error("MIR complete declaration prescan failed: {prepared.unwrap_err()}")
            return false
        var done = 0
        var failed = 0
        val total = final_repository.emission_rows.len()
        for row in final_repository.emission_rows:
            val context_errors_before = self.ctx.error_count_value
            val errors_before = lowering.errors.len()
            val devirt_before: i64 = lowering.devirtualized_calls
            val gate = ice_boundary_module_start(row.emission_name, row.path, "mir_lower", "")
            if gate != "":
                val may_continue = _driver_mir_ice_continue(self.ctx, row.emission_name, row.path,
                    gate, ice_message_arena_aborted(gate))
                done = done + 1
                failed = build_phase_record_failed_module_v1(failed, true)
                if not may_continue or done % 64 == 0 or done == total:
                    log_build_progress("mir", "modules", done, total, row.emission_name, 4, 6, failed, 0, "running")
                if not may_continue:
                    mir_archive_declaration_publication_revoke_v1(self)
                    return false
                continue
            val lowered = mir_archive_lower_final_module_v1(self, lowering,
                final_repository, declarations, row.logical_name, row.is_entry)
            if lowered.is_err():
                val failure = lowered.unwrap_err()
                _driver_collect_mir_errors(self.ctx, failure.errors)
                driver_collect_mir_advisories(self.ctx, failure.advisories)
                val _stop = _driver_mir_ice_continue(self.ctx, row.emission_name, row.path,
                    "MIR archive lowering failed: {failure.message}", failure.arena_aborted)
                done = done + 1
                failed = build_phase_record_failed_module_v1(failed, true)
                log_build_progress("mir", "modules", done, total, row.emission_name, 4, 6, failed, 0, "running")
                mir_archive_declaration_publication_revoke_v1(self)
                return false
            var output: MirModule = lowered.unwrap()
            val secondary_keys = mir_archive_secondary_keys_v1(self, final_repository, declarations, row.logical_name)
            if secondary_keys.is_err():
                self.ctx.add_error("MIR specialization schedule failed: {secondary_keys.unwrap_err()}")
                done = done + 1
                failed = build_phase_record_failed_module_v1(failed, true)
                log_build_progress("mir", "modules", done, total, row.emission_name, 4, 6, failed, 0, "running")
                mir_archive_declaration_publication_revoke_v1(self)
                return false
            var symbol_baseline_key = row.logical_name
            for secondary_key in secondary_keys.unwrap():
                val previous_symbols = lowering.symbols
                val previous_thunks = lowering.native_trait_thunks
                val additional = mir_archive_lower_final_module_v1(self, lowering,
                    final_repository, declarations, secondary_key, false, row.logical_name,
                    Some(output), Some(previous_symbols), symbol_baseline_key, previous_thunks)
                if additional.is_err():
                    val failure = additional.unwrap_err()
                    _driver_collect_mir_errors(self.ctx, failure.errors)
                    driver_collect_mir_advisories(self.ctx, failure.advisories)
                    val _stop = _driver_mir_ice_continue(self.ctx, row.emission_name, row.path,
                        "MIR archive specialization lowering failed: {failure.message}", failure.arena_aborted)
                    done = done + 1
                    failed = build_phase_record_failed_module_v1(failed, true)
                    log_build_progress("mir", "modules", done, total, row.emission_name, 4, 6, failed, 0, "running")
                    mir_archive_declaration_publication_revoke_v1(self)
                    return false
                output = additional.unwrap()
                symbol_baseline_key = secondary_key
            driver_trace_module_mir_errors(row.emission_name, row.path, lowering.errors, errors_before)
            ice_boundary_module_done(row.emission_name, "mir_lower")
            if val archived_devirt = post_mono_archive_admission_v1(row.emission_name,
                    lowering.devirtualized_calls - devirt_before,
                    self.ctx.runtime_std_full_inventory_selection != nil):
                self.ctx.add_error(archived_devirt)
                done = done + 1
                failed = build_phase_record_failed_module_v1(failed, true)
                log_build_progress("mir", "modules", done, total, row.emission_name, 4, 6, failed, 0, "running")
                mir_archive_declaration_publication_revoke_v1(self)
                return false
            output.name = row.emission_name
            self.ctx.mir_modules[row.emission_name] = output
            if row.emission_name == "app.cli.bootstrap_main":
                self.ctx.set_bootstrap_entry_mir(row.emission_name, output)
            done = done + 1
            failed = build_phase_record_failed_module_v1(failed,
                driver_mir_has_new_fatal_errors_v1(lowering.errors, errors_before) or
                self.ctx.error_count_value > context_errors_before)
            if done % 64 == 0 or done == total:
                log_build_progress("mir", "modules", done, total, row.emission_name, 4, 6, failed, 0, "running")
        _driver_collect_mir_errors(self.ctx, lowering.errors)
        driver_collect_mir_advisories(self.ctx, lowering.mir_advisories)
        mir_archive_declaration_publication_revoke_v1(self)
        if self.ctx.error_count_value != 0: return false
        if not self.publish_runtime_std_mir_emissions_v1(): return false
        true

    me lower_to_mir_with_target_context(
        target_context: MirTargetContext,
        force_all_sources: bool,
        allow_bootstrap_shortcuts: bool
    ) -> bool:
        val collection_target = driver_collection_target_options(target_context, self.ctx.options)
        # A foreign borrowed lease cannot own compiler context mutations.
        if transient_array_scope_state_v1() != 0: return false
        driver_warm_mir_logical_names_v1(self.ctx.hir_modules)
        self.ctx.runtime_std_mir_emissions = {}
        val production = mir_archive_try_production_repository_v1(self)
        if production.is_err():
            self.ctx.add_error("MIR actual production repository rejected: {production.unwrap_err()}")
            return false
        if val final_repository = production.unwrap():
            return self.lower_archived_to_mir_v1(final_repository, target_context,
                force_all_sources, allow_bootstrap_shortcuts)
        # Cycle-140: NO .values() on the module dict -- the cycle-139/140
        # evidence shows .values() returns modules whose nested handles
        # (functions dicts) are corrupt, while dict-index reads (mono's
        # proven shape) are sound. Build the feed via keys + direct bracket.
        self.ctx.mir_feed_modules = []
        val feed_keys = self.ctx.hir_modules.keys()
        for feed_key in feed_keys:
            self.ctx.mir_feed_modules = self.ctx.mir_feed_modules.push(self.ctx.hir_modules[feed_key])
        # Cycle-123 discrimination receipt (SIMPLE_SDN_RACE_TRACE=1): if this
        # expression read faults, the corruption is AT the ctx field read /
        # .values() materialization right here; if it prints, the array is
        # sound at birth and the corruption is in the LATER uses of this var
        # local across this big function (the cycle-78/105 unpromoted-capture
        # class).
        if (env_get("SIMPLE_SDN_RACE_TRACE") ?? "") == "1":
            eprint("[race-trace] mir-feed len={self.ctx.mir_feed_modules.len()} first_fn={self.ctx.mir_feed_modules[0].name}")
        var mir_physical_ownership_active = false
        var mir_source_indices: [i64] = []
        var source_index = 0
        while source_index < self.ctx.sources.len():
            mir_source_indices = mir_source_indices.push(source_index)
            source_index = source_index + 1
        # Phase 2's documented entry/closure route projects the phase-1
        # inventory to unique_entry_sources. Its parser already owns physical
        # deduplication; do not reinterpret unchanged phase-1 receipt rows.
        val mir_phase2_projected_inventory = self.ctx.sources.len() > 0 and
            self.ctx.sources.len() != self.ctx.source_paths_owner.len() and
            (driver_source_entry_closure_enabled(self.ctx) or
                driver_source_entry_request(self.ctx) != "")
        if mir_phase2_projected_inventory:
            log_phase("aot:mir_physical_owners route=phase2-entry-projection retained={self.ctx.source_paths_owner.len()} selected={self.ctx.sources.len()} existing_schedule=1")
        # Normal native entry/full-tool compilation owns physical outputs.
        # Cold archive receipts and demand publication retain their existing
        # logical-row authority; bootstrap-flat publication is also separate.
        if self.ctx.source_paths_owner.len() > 0 and not mir_phase2_projected_inventory and
                (force_all_sources or self.ctx.options.cli_mode_text == "aot" or
                    driver_source_entry_closure_enabled(self.ctx)) and
                self.ctx.runtime_std_full_inventory_selection == nil and
                self.ctx.demand_compile_execution == nil and
                not (allow_bootstrap_shortcuts and
                    (sosix_env_get_nullable("SIMPLE_BOOTSTRAP") ?? "") == "1"):
            var admitted_physical_paths: [text] = []
            for retained_path in self.ctx.source_paths_owner:
                # Use the same platform source identity as phase-1 admission.
                admitted_physical_paths = admitted_physical_paths.push(_driver_physical_source_key(retained_path))
            var physical_owners: [text] = []
            for logical_name in self.ctx.source_module_names_owner:
                if not self.ctx.hir_modules.contains_key(logical_name):
                    self.ctx.add_error("MIR physical ownership missing HIR for {logical_name}")
                    return false
                # Cycle-125: the plain dict-value read arrives erased (the
                # cycle-76/77 class) and this lane PUSHES it into the feed
                # array, poisoning every MIR reader. Guard-first double
                # access, immediately adjacent (the campaign's 10/10 form).
                if not self.ctx.hir_modules.has(logical_name):
                    self.ctx.add_error("MIR physical ownership missing HIR for {logical_name}")
                    return false
                val owner_hir_module: HirModule = self.ctx.hir_modules[logical_name]
                physical_owners = physical_owners.push(owner_hir_module.name)
            val admitted_indices = driver_mir_physical_source_indices_v1(
                admitted_physical_paths, self.ctx.source_identities_owner,
                physical_owners)
            if admitted_indices.is_err():
                self.ctx.add_error(admitted_indices.unwrap_err())
                return false
            val physical_indices = admitted_indices.unwrap()
            # Preserve the birth array only when its actual ordered owners
            # match the admitted inventory. Equal counts and identity source
            # indices cannot establish dictionary-values iteration order.
            # Read names directly from the retained owner array: no HirModule
            # value copy or dictionary re-read on the valid identity path.
            var existing_feed_owners: [text] = []
            var feed_owner_i = 0
            while feed_owner_i < self.ctx.mir_feed_modules.len():
                existing_feed_owners = existing_feed_owners.push(self.ctx.mir_feed_modules[feed_owner_i].name)
                feed_owner_i = feed_owner_i + 1
            val feed_needs_rebuild = not driver_mir_feed_is_identity_v1(
                physical_indices, physical_owners, existing_feed_owners)
            # The remote cycle-126 erased-read defect in the nonidentity
            # rebuild remains open; this predicate does not repair transport.
            if feed_needs_rebuild:
                self.ctx.mir_feed_modules = []
                for physical_index in physical_indices:
                    val logical_name = self.ctx.source_module_names_owner[physical_index]
                    # Cycle-125: guard-first double access (the erased-read
                    # class).
                    if not self.ctx.hir_modules.has(logical_name):
                        self.ctx.add_error("MIR physical ownership missing HIR for {logical_name}")
                        return false
                    val feed_hir_module: HirModule = self.ctx.hir_modules[logical_name]
                    self.ctx.mir_feed_modules = self.ctx.mir_feed_modules.push(feed_hir_module)
            if self.ctx.sources.len() > 0:
                if self.ctx.sources.len() != self.ctx.source_paths_owner.len():
                    self.ctx.add_error("MIR source scheduling differs from admitted inventory")
                    return false
                var inventory_source_index = 0
                while inventory_source_index < self.ctx.sources.len():
                    if self.ctx.sources[inventory_source_index].module_name != self.ctx.source_module_names_owner[inventory_source_index] or
                            _driver_physical_source_key(self.ctx.sources[inventory_source_index].path) != admitted_physical_paths[inventory_source_index]:
                        self.ctx.add_error("MIR source scheduling order differs from admitted inventory")
                        return false
                    inventory_source_index = inventory_source_index + 1
                mir_source_indices = physical_indices
            mir_physical_ownership_active = true
            log_phase("aot:mir_physical_owners logical={physical_owners.len()} physical={self.ctx.mir_feed_modules.len()}")
        val mir_scheduled_count = if mir_physical_ownership_active:
            self.ctx.mir_feed_modules.len()
        else:
            self.ctx.sources.len()
        compiler_work_mir_schedule_v1(mir_scheduled_count)
        if self.ctx.runtime_std_full_inventory_selection != nil and
                (self.ctx.sources.len() == 0 or
                 self.ctx.cold_hir_typed_receipts.len() != self.ctx.sources.len() or
                 self.ctx.runtime_std_hir_emissions.len() != self.ctx.sources.len()):
            self.ctx.add_error("full inventory cold MIR requires exact typed HIR source receipts")
            return false
        if self.ctx.demand_compile_execution != nil and
                self.ctx.demand_mir_input == nil and
                self.ctx.demand_mir_admission == nil:
            self.ctx.add_error(
                "MIR demand admission missing for demand compilation; legacy bypass is disabled")
            return false
        if self.ctx.demand_mir_admission != nil:
            var measured_execution = self.ctx.demand_compile_execution!
            if not demand_compile_bind_mir_admission_v1(
                    &mut measured_execution, self.ctx.demand_mir_admission!):
                self.ctx.add_error(
                    "backend demand authority rejected combined MIR admission")
                return false
            self.ctx.demand_compile_execution = Some(measured_execution)
        elif self.ctx.demand_mir_input != nil:
            # Seed capability checker: `&mut` borrows are never released at
            # branch end (only at function end / call-argument checkpoint), so
            # re-borrowing the if-arm's 'measured_execution' here would be a
            # second Exclusive acquisition on the same reference ("reference 9
            # already has Exclusive capability"). A fresh binding per arm gets
            # a distinct reference id.
            var measured_execution_input = self.ctx.demand_compile_execution!
            val demand_admission = demand_mir_integrate_measured_v1(
                self.ctx.demand_mir_input!, &mut measured_execution_input.counters,
                true)
            if demand_admission.is_err():
                self.ctx.add_error(
                    "MIR demand admission failed: {demand_admission.unwrap_err()}")
                return false
            self.ctx.demand_mir_admission = Some(
                demand_admission.?.admission)
            if not demand_compile_bind_mir_admission_v1(
                    &mut measured_execution_input, self.ctx.demand_mir_admission!):
                self.ctx.add_error(
                    "backend demand authority rejected MIR admission")
                return false
            self.ctx.demand_compile_execution = Some(measured_execution_input)
        if self.ctx.demand_mir_admission != nil and
                self.ctx.demand_dirty_modules.len() > 0:
            val indexed = package_module_index_read_current_v1(
                machine_cache_root())
            val execution = self.ctx.demand_compile_execution!
            if (not indexed.valid or indexed.generation == nil or
                    execution.backend_plan == nil):
                self.ctx.add_error(
                    "SCC publication ownership authority unavailable")
                return false
            val ownership = scc_publication_prepare_v1(
                machine_cache_root(), indexed.generation!,
                self.ctx.demand_dirty_modules,
                self.ctx.demand_mir_admission!.dependency_set_digest,
                execution.baseline_action_id,
                execution.backend_plan!.baseline_action_digest)
            if not ownership.valid:
                self.ctx.add_error(
                    "SCC publication ownership failed: {ownership.reason}")
                return false
            self.ctx.demand_scc_publication = Some(ownership)
        val skip_mir_lower = if allow_bootstrap_shortcuts:
            sosix_env_get_nullable("SIMPLE_BOOTSTRAP_SKIP_MIR_LOWER") ?? ""
        else:
            ""
        if allow_bootstrap_shortcuts and skip_mir_lower == "1":
            if self.ctx.runtime_std_full_inventory_selection != nil:
                self.ctx.add_error("full inventory cold MIR cannot skip lowering")
                return false
            print "[bootstrap] skipping MIR lowering"
            var skip_idx = 0
            while skip_idx < self.ctx.sources.len():
                val src_skip = self.ctx.sources[skip_idx]
                val name_skip = src_skip.module_name
                val mir_skip = MirModule(
                    name: name_skip,
                    functions: {},
                    statics: {},
                    constants: {},
                    types: {}
                )
                self.ctx.mir_modules[name_skip] = mir_skip
                if name_skip == "app.cli.bootstrap_main":
                    self.ctx.set_bootstrap_entry_mir(name_skip, mir_skip)
                skip_idx = skip_idx + 1
            return self.ctx.error_count_value == 0

        # The fixed-entry bootstrap path below lowers app.cli.bootstrap_main and
        # nothing else, so it must only be entered when THIS compile actually
        # asked for the bootstrap CLI. SIMPLE_BOOTSTRAP=1 alone does not say
        # that: the Stage-2 admission probe builds hello_world.spl in bootstrap
        # mode, and a POSITIONAL source routes through lower_to_mir()
        # (allow_bootstrap_shortcuts=true) while an --entry build routes through
        # lower_to_mir_for_explicit_target() (false). That is exactly why, of
        # the four candidate_frontend probes, only hello-world-positional failed
        # in the bootstrap-mode pass -- on a program that never requested the
        # bootstrap CLI. Membership is read from ctx.sources, the same identity
        # the SIMPLE_BOOTSTRAP_SKIP_MIR_LOWER branch above uses. The nil guard
        # inside is KEPT unchanged for the case it was written for: the
        # bootstrap CLI was requested but did not lower.
        var bootstrap_entry_requested = false
        var bootstrap_entry_idx = 0
        while bootstrap_entry_idx < self.ctx.sources.len():
            if self.ctx.sources[bootstrap_entry_idx].module_name == "app.cli.bootstrap_main":
                bootstrap_entry_requested = true
            bootstrap_entry_idx = bootstrap_entry_idx + 1
        if self.ctx.runtime_std_full_inventory_selection == nil and allow_bootstrap_shortcuts and bootstrap_entry_requested and (sosix_env_get_nullable("SIMPLE_BOOTSTRAP") ?? "") == "1" and (sosix_env_get_nullable("SIMPLE_BOOTSTRAP_STAGE4") ?? "") != "1":
            val bootstrap_hir = self.ctx.hir_modules["app.cli.bootstrap_main"]
            if bootstrap_hir == nil:
                self.ctx.add_error("MIR lowering missing HIR module for app.cli.bootstrap_main during bootstrap")
                log_phase("aot:lower_to_mir:missing_hir module=app.cli.bootstrap_main")
                return false
            log_bootstrap_flat_warning("mir:bootstrap_fixed")
            log_phase("aot:bootstrap_fixed:start module=app.cli.bootstrap_main functions={bootstrap_hir.functions.len()}")
            var bootstrap_lowering = MirLowering.new_for_target(bootstrap_hir.symbols, collection_target)
            bootstrap_lowering.configure_mcdc_mode(_driver_mcdc_mir_mode(self.ctx), _driver_mcdc_budget(self.ctx, "mcdc_owner_bytes", 1048576), _driver_mcdc_budget(self.ctx, "mcdc_global_bytes", 67108864), self.ctx.config["mcdc_include"] ?? "", self.ctx.config["mcdc_exclude"] ?? "")
            # Stage3 (SIMPLE_BOOTSTRAP=1, entry closure, cold package index,
            # never demand-routed) holds the whole closure's HIR here. Feed it
            # to trait-implementor registration only, so trait-object calls
            # devirtualize exactly as on the direct path; lower_module's own
            # provider registration stays empty as before.
            bootstrap_lowering.trait_impl_provider_modules = self.ctx.mir_feed_modules
            bootstrap_lowering.trait_impl_closure_complete = driver_trait_devirtualization_allowed_v1(
                driver_source_entry_closure_enabled(self.ctx),
                self.ctx.runtime_std_full_inventory_selection != nil,
                self.ctx.demand_mir_admission != nil or self.ctx.demand_dirty_modules.len() > 0)
            # lower_module's bootstrap-flat branch returns before the
            # non-bootstrap tail, so on this fresh lowering instance NO enum
            # registration exists: not the entry's own module.enums, not the
            # built-in Option/Result seeds, and (empty provider list) no
            # dependency enums. Stage3 measured the failure as "enum
            # construction: missing runtime identity for 'Option'" and
            # "unregistered declaration 'compiler.common.driver_core_modes.
            # CompileMode'" at the entry's construction sites (site-19,
            # stage3 frontier 2026-10-17); the seed seeds a global enum
            # sidecar across the whole closure before lowering. Register
            # the closure's enums + runtime ids + builtin seeds up front.
            var bootstrap_enum_modules: [HirModule] = []
            var bootstrap_enum_idx = 0
            while bootstrap_enum_idx < self.ctx.sources.len():
                val bootstrap_enum_hir = self.ctx.hir_modules[self.ctx.sources[bootstrap_enum_idx].module_name]
                if bootstrap_enum_hir != nil:
                    bootstrap_enum_modules = bootstrap_enum_modules.push(bootstrap_enum_hir)
                bootstrap_enum_idx = bootstrap_enum_idx + 1
            bootstrap_lowering.register_module_enum_bootstrap_inventory_v1(bootstrap_enum_modules)
            # Emission coverage (site-19, emission divergence 2026-10-17): this
            # lane previously lowered ONLY the entry, so the per-module
            # collection emission iterated just the replayed modules (~40
            # objects) and the link missed every callable owned by the other
            # ~1259 closure modules (measured: io_runtime.env_get,
            # driver_compile_options_default, the K1 table rows, ... undefined
            # under a scheme-homogeneous link -- not a cache or mangling
            # problem; the #3608 emitter gate proved that by eliminating every
            # foreign-scheme object and changing nothing). Lower EVERY
            # scheduled closure module through this same instance and publish
            # each MirModule into ctx.mir_modules, the exact shape the direct
            # lane's per-module loop produces for the collection emission.
            # Non-entry modules go FIRST: lower_module's bootstrap-flat branch
            # resets the flat function registry per call, and the flat entry
            # emission (bootstrap_mir_function_count > 0) reads that registry,
            # the entry must be the LAST module lowered on this instance.
            # Modules already in ctx.mir_modules (archive/mono replay) keep
            # their MIR and are skipped.
            var bootstrap_closure_idx = 0
            while bootstrap_closure_idx < self.ctx.sources.len():
                val bootstrap_closure_source = self.ctx.sources[bootstrap_closure_idx]
                val bootstrap_closure_name = bootstrap_closure_source.module_name
                if bootstrap_closure_name != "app.cli.bootstrap_main" and
                        not self.ctx.mir_modules.contains_key(bootstrap_closure_name):
                    val bootstrap_closure_hir = self.ctx.hir_modules[bootstrap_closure_name]
                    if bootstrap_closure_hir != nil:
                        val bootstrap_closure_mir = bootstrap_lowering.lower_module(
                            bootstrap_closure_hir, [], false)
                        bootstrap_closure_mir.name = bootstrap_closure_name
                        self.ctx.mir_modules[bootstrap_closure_name] = bootstrap_closure_mir
                        log_phase("aot:bootstrap_fixed:closure_module module={bootstrap_closure_name} functions={bootstrap_closure_mir.functions.len()}")
                bootstrap_closure_idx = bootstrap_closure_idx + 1
            var bootstrap_mir = bootstrap_lowering.lower_bootstrap_entry_module(bootstrap_hir)
            driver_trace_module_mir_errors("app.cli.bootstrap_main", bootstrap_hir.path,
                bootstrap_lowering.errors, 0)
            self.ctx.bootstrap_entry_mir = Some(bootstrap_mir)
            _driver_collect_mir_errors(self.ctx, bootstrap_lowering.errors)
            driver_collect_mir_advisories(self.ctx, bootstrap_lowering.mir_advisories)
            if val archived_devirt = post_mono_archive_admission_v1(
                    "app.cli.bootstrap_main", bootstrap_lowering.devirtualized_calls,
                    self.ctx.runtime_std_full_inventory_selection != nil):
                self.ctx.add_error(archived_devirt)
            log_phase("aot:bootstrap_fixed:done module=app.cli.bootstrap_main functions={bootstrap_mir.functions.len()} closure_modules={self.ctx.mir_modules.keys().len()}")
            return self.ctx.error_count_value == 0

        if self.ctx.sources.len() > 0:
            # Mirror phase-2 parse_all_impl (driver.spl): under --entry-closure
            # every source in ctx.sources is a real module reachable from the
            # entry point (parsed fully in phase 2), not just the bootstrap
            # main file. Without this flag here, every non-main module fell
            # through to the empty MirModule stub below, producing "MIR module
            # has no functions" for the first such module the AOT backend
            # tried to compile on its own (e.g. std.io_runtime).
            # Standalone `simple-compiler file.spl --aot` has no native-build
            # entry environment. Its positional sources are still real AOT
            # inputs and must not become empty MIR stubs.
            val native_entry_closure_mir = force_all_sources or
                self.ctx.runtime_std_full_inventory_selection != nil or
                self.ctx.options.cli_mode_text == "aot" or
                driver_source_entry_closure_enabled(self.ctx)
            var direct_pos = 0
            var mir_failed_modules = 0
            # Canonical constructor — do NOT hand-duplicate MirLowering(...) here.
            # A duplicated copy drifted 8 fields behind the class and the seed
            # interpreter silently nil-fills omitted struct-init fields, which
            # broke native-build on every struct construction
            # (native_build_entry_struct_construction_buildfail_2026-07-20).
            # Guard: test/03_system/native/struct_construct_native.spl.
            var direct_lowering = MirLowering.new_for_target(SymbolTable.new(), collection_target)
            # Ambient bootstrap MIR semantics (MirLowering.ambient_bootstrap_enabled
            # = allow_ambient_bootstrap_policy and SIMPLE_BOOTSTRAP == "1") send
            # every module through lower_module's bootstrap-FLAT function loop.
            # That loop reads `module.functions.keys()` and re-finds each entry
            # through `hir_module_function`, which returns an `is_extern: true`
            # placeholder on a miss -- so a module it cannot re-find contributes
            # ZERO functions and the AOT backend reports "MIR module has no
            # functions". SIMPLE_BOOTSTRAP=1 is not on its own enough to enter
            # that path: the Stage-2 admission probe sets it while building
            # hello_world.spl positionally (allow_bootstrap_shortcuts = true).
            # Measured 2026-09-13 on the Stage-2 binary carrying the two sibling
            # fixes, identical scrubbed environment, SIMPLE_BOOTSTRAP the only
            # variable changed: with 0 the trace shows `[mir-lower]
            # lower_function:start main` and the build succeeds; with 1 it shows
            # `[mir-lower] function-loaded` followed straight by
            # `lower_module:done` -- `main` skipped as extern -- and the build
            # fails. Require that the bootstrap CLI really is part of this
            # compile, the same predicate and the same ctx.sources identity the
            # fixed-entry gate above and driver_aot_pipeline.spl's AOT dispatch
            # already apply. Deliberately duplicated rather than shared:
            # CompileContext lives in the fenced driver_types.spl. All three
            # sites must move together.
            if self.ctx.runtime_std_full_inventory_selection != nil or
                    not (allow_bootstrap_shortcuts and bootstrap_entry_requested):
                direct_lowering.use_explicit_semantic_policy()
            direct_lowering.configure_mcdc_mode(_driver_mcdc_mir_mode(self.ctx), _driver_mcdc_budget(self.ctx, "mcdc_owner_bytes", 1048576), _driver_mcdc_budget(self.ctx, "mcdc_global_bytes", 67108864), self.ctx.config["mcdc_include"] ?? "", self.ctx.config["mcdc_exclude"] ?? "")
            # Trait-object devirtualization counts implementors across the
            # providers handed to lower_module. That count is only the
            # closure's when every source is a real HIR module lowered here:
            # an entry-closure/AOT build with no demand (package-index) route.
            # A demand route lowers dirty packages only and reuses archived MIR
            # for the rest, and the full-inventory cold lane archives what it
            # lowers; both stay false and trait-object calls fail closed
            # (driver_trait_devirtualization_allowed_v1).
            direct_lowering.trait_impl_closure_complete = driver_trait_devirtualization_allowed_v1(
                native_entry_closure_mir,
                self.ctx.runtime_std_full_inventory_selection != nil,
                self.ctx.demand_mir_admission != nil or self.ctx.demand_dirty_modules.len() > 0)
            # Crossmodule field-index prepass: the entry module is lowered
            # BEFORE the dependency modules it imports, so without this an
            # imported struct's field order was unknown while lowering the
            # entry and resolve_field_index silently defaulted to index 0
            # (SEGV on `state.driver.width` across modules). Register every
            # module's name-keyed struct layout before lowering any module.
            # Cycle-127 bracketing receipt #2 (SIMPLE_SDN_RACE_TRACE=1):
            # prints immediately before the prescan consumes the feed. With
            # receipt #1 (at birth) this brackets the degradation: #1 sound +
            # #2 absent/faulted -> corruption in between; both sound -> the
            # corruption is inside the prescan call chain itself.
            if (env_get("SIMPLE_SDN_RACE_TRACE") ?? "") == "1":
                # Cycle-131 deep probe: read the FIRST FUNCTION's name through
                # the all-codec chain. If this prints a real function name,
                # functions are sound at the prescan boundary and the
                # corruption is inside the prescan forwarding; garbage/nil
                # here means the functions dict was poisoned before MIR.
                eprint("[race-trace] mir-feed-pre len={self.ctx.mir_feed_modules.len()} first_fn={self.ctx.mir_feed_modules[0].name} first_scalars_fn={hir_fn_scalars_at_v1(hir_module_functions_at_v1(self.ctx.mir_feed_modules, 0).values(), 0)[1]}")
            if mir_physical_ownership_active:
                # Cycle-117: NO for-in element rebind -- the rebind copy of
                # the HirModule element corrupted the .functions handle
                # (garbage element words three calls downstream). Index loop
                # with array-index EXPRESSION reads (the hir_module_has_rt_hal
                # class) feeding the handle/scalar args directly.
                var prescan_owner_i = 0
                # Cycle-144 endgame: dict+key passing straight from
                # ctx.hir_modules -- the feed array's modules were copy-
                # corrupted at its construction (cycle-141/144), and the
                # five-handle marshalling is moot: the callee binds the
                # module itself (mono's precedent) and walks via the
                # param-only codec getters.
                val prescan_owner_keys = self.ctx.hir_modules.keys()
                while prescan_owner_i < prescan_owner_keys.len():
                    direct_lowering.prescan_module_struct_names(
                        self.ctx.hir_modules, prescan_owner_keys[prescan_owner_i])
                    prescan_owner_i = prescan_owner_i + 1
            else:
                # Cycle-118: the flagged unwrap-bind branch -- same corruptor
                # as cycle-117 (named binds of HirModule elements/values).
                # Scalar key bind only; the module value is never bound:
                # expression reads with .unwrap() feed the handle/scalar args.
                var direct_prescan_idx = 0
                while direct_prescan_idx < self.ctx.sources.len():
                    val prescan_key: text = self.ctx.sources[direct_prescan_idx].module_name
                    if self.ctx.hir_modules.has(prescan_key):
                        direct_lowering.prescan_module_struct_names(
                            self.ctx.hir_modules, prescan_key)
                    direct_prescan_idx = direct_prescan_idx + 1
            # Enum registry completeness, next to the struct-name prescan:
            # the per-module provider pass in lower_module registers only
            # OTHER modules' enums, so a scheduled module whose callables the
            # entry never demands can reach its own bare-variant match arms
            # with an empty variant registry (measured B5b,
            # compiler.common.config.CompilerProfile.to_text lowered as a
            # dependency of compiler.common.di; two-module fixture repro in
            # the register_module_enum_inventory_v1 docstring). Register every
            # scheduled source module's own enums up front, while the
            # hir_modules still carry them.
            var enum_inventory_modules: [HirModule] = []
            var enum_inventory_idx = 0
            while enum_inventory_idx < self.ctx.sources.len():
                val src_enum_inventory = self.ctx.sources[enum_inventory_idx]
                val enum_inventory_hir = self.ctx.hir_modules[src_enum_inventory.module_name]
                # Pushing the Some box into a concrete [HirModule] transports the
                # wrapper; inventory registration then reads headers as structs.
                if val present_enum_hir = enum_inventory_hir:
                    enum_inventory_modules = enum_inventory_modules.push(present_enum_hir)
                enum_inventory_idx = enum_inventory_idx + 1
            direct_lowering.register_module_enum_inventory_v1(enum_inventory_modules)
            # Struct/class NAME-keyed layout rows, same shape: the prescan
            # above covers struct field order + declared types, but the
            # struct default-value rows and every NAME-keyed class row
            # (class_type_names, struct_field_order/has_default/defaults
            # under bare, layout, and identity keys) are written only by each
            # module's own lower_module pass -- after the entry has already
            # lowered. See register_module_composite_inventory_v1.
            direct_lowering.register_module_composite_inventory_v1(enum_inventory_modules)
            # Staged native codegen (driver_build/native_staged_codegen.spl):
            # record the whole schedule's module names (the frozen storage
            # registry must know modules lowered after it freezes), then flush
            # every full batch through codegen and release its MIR instead of
            # retaining the entire closure's MIR until compile_to_native.
            var staged_pending = 0
            var staged_source_names: [text] = []
            if self.native_staged_codegen.active:
                var staged_schedule: [text] = []
                for held_name in self.ctx.mir_modules.keys():
                    staged_schedule = staged_schedule.push(held_name)
                for staged_idx in mir_source_indices:
                    val staged_lookup = self.ctx.sources[staged_idx].module_name
                    var staged_name = staged_lookup
                    if mir_physical_ownership_active and self.ctx.hir_modules.has(staged_lookup):
                        staged_name = mir_layout_canonical_module_name(self.ctx.hir_modules[staged_lookup].name)
                    staged_schedule = staged_schedule.push(staged_name)
                    staged_source_names = staged_source_names.push(staged_name)
                self.native_staged_codegen.scheduled_names = staged_schedule
                staged_pending = self.ctx.mir_modules.keys().len()
                log_phase("aot:staged_codegen:schedule modules={staged_schedule.len()} batch={self.native_staged_codegen.batch_size}")
            # MIR shard worker (driver_build/native_mir_shard.spl): publish the
            # schedule as the ledger inventory, then lower only claimed modules.
            val mir_shard_queue = self.native_staged_codegen.shard_queue
            val mir_shard_key = self.ctx.native_sources_fingerprint
            val mir_shard_cap = native_mir_shard_claim_cap_v1(
                native_mir_shard_spec_v1(), staged_source_names.len())
            if mir_shard_queue != "":
                if mir_shard_key == "" or not hir_shard_recovery_inventory(
                        mir_shard_queue, mir_shard_key, staged_source_names):
                    self.ctx.add_error("MIR shard ledger inventory refused for this worker")
                    return false
            # Shard workers walk the schedule largest-first (source byte
            # length, canonical-name tie-break) so the slowest modules start
            # first; every worker computes the same order. Unsharded builds
            # keep schedule order.
            var mir_walk_order: [i64] = []
            if mir_shard_queue != "" and staged_source_names.len() == mir_source_indices.len():
                var mir_walk_weights: [i64] = []
                for weight_idx in mir_source_indices:
                    mir_walk_weights = mir_walk_weights.push(self.ctx.sources[weight_idx].content.len())
                mir_walk_order = native_mir_shard_lpt_order_v1(staged_source_names, mir_walk_weights)
            while direct_pos < mir_source_indices.len():
                # Schedule position; the entry flag below keys on it, not on
                # the walk counter.
                val mir_schedule_pos = if mir_walk_order.len() == mir_source_indices.len(): mir_walk_order[direct_pos] else: direct_pos
                val direct_idx = mir_source_indices[mir_schedule_pos]
                val src_direct = self.ctx.sources[direct_idx]
                val source_lookup_name = src_direct.module_name
                val module_context_errors_before = self.ctx.error_count_value
                var module_new_fatal = false
                val name_direct = if mir_physical_ownership_active:
                    mir_layout_canonical_module_name(self.ctx.hir_modules[source_lookup_name].name)
                else:
                    source_lookup_name
                if mir_shard_queue != "":
                    # Another worker owns it, or this worker's share is full:
                    # not lowered here. direct_pos still advances; the entry
                    # flag (mir_schedule_pos == 0) keeps its schedule meaning.
                    var mir_shard_owned = false
                    if self.native_staged_codegen.shard_claimed_names.len() < mir_shard_cap:
                        val mir_shard_claim = native_mir_shard_claim_v1(
                            mir_shard_queue, name_direct, mir_shard_key)
                        if mir_shard_claim < 0:
                            self.ctx.add_error("MIR shard ledger refused claim for {name_direct}")
                            return false
                        mir_shard_owned = mir_shard_claim == 1
                    if not mir_shard_owned:
                        direct_pos = direct_pos + 1
                        continue
                    self.native_staged_codegen.shard_claimed_names =
                        self.native_staged_codegen.shard_claimed_names.push(name_direct)
                var mir_direct = if native_entry_closure_mir or driver_source_matches_entry(self.ctx, src_direct.path, name_direct) or (sosix_env_get_nullable("SIMPLE_UNSTUB_HIR") ?? "") == "1":
                    log_phase("aot:lower_to_mir:module:start idx={direct_idx} module={name_direct} path={src_direct.path}")
                    val direct_hir = self.ctx.hir_modules[source_lookup_name]
                    # ICE boundary: a module with no HIR is recorded and the loop
                    # goes on to its siblings (driver_ice_boundary.spl).
                    var ice_message = ice_boundary_module_start(name_direct, src_direct.path, "mir_lower", "")
                    var ice_arena_aborted = ice_message_arena_aborted(ice_message)
                    if ice_message == "" and direct_hir == nil:
                        ice_message = "MIR lowering missing HIR module for {name_direct} ({src_direct.path})"
                        log_phase("aot:lower_to_mir:missing_hir idx={direct_idx} module={name_direct} path={src_direct.path}")
                    var lowered_entry: MirModule = MirModule(name: name_direct, functions: {}, statics: {}, constants: {}, types: {})
                    if ice_message == "":
                        # ICE gate above already guarantees direct_hir is present;
                        # still bind concrete — field access on the Some box reads
                        # its enum header as the symbols pointer.
                        if val present_direct_hir = direct_hir:
                            direct_lowering.symbols = present_direct_hir.symbols
                        val devirt_before: i64 = direct_lowering.devirtualized_calls
                        val module_errors_before = direct_lowering.errors.len()
                        # Per-module transient scope. The lowering arena for one
                        # module is dead once its MirModule exists; without this
                        # every intermediate stays registered for the life of the
                        # process (the compiler's own immortal heap). See
                        # lower_module_transient_scoped for the enumerated escape
                        # set and why ambient bootstrap is excluded.
                        # Bind concrete for the concrete HirModule param; the ICE
                        # gate guarantees presence (dead Err arm mirrors it).
                        val scoped_entry = if val scoped_hir = direct_hir:
                            direct_lowering.lower_module_transient_scoped(scoped_hir, self.ctx.mir_feed_modules, mir_schedule_pos == 0)
                        else:
                            Err("MIR lowering missing HIR module for {name_direct}")
                        driver_trace_module_mir_errors(name_direct, src_direct.path,
                            direct_lowering.errors, module_errors_before)
                        if scoped_entry.is_err():
                            # Fail closed: the scope has already been ended, so the
                            # arena (including the module we would have returned) is
                            # gone. Never continue on a half-reclaimed lowering: the
                            # module is recorded and the phase returns at once.
                            ice_arena_aborted = true
                            ice_message = "MIR lowering transient scope failed for {name_direct}: {scoped_entry.unwrap_err()}"
                            log_phase("aot:lower_to_mir:transient_scope_failed idx={direct_idx} module={name_direct}")
                        else:
                            module_new_fatal = driver_mir_has_new_fatal_errors_v1(direct_lowering.errors, module_errors_before)
                            lowered_entry = scoped_entry.unwrap()
                            lowered_entry.name = name_direct
                            # The module was lowered and left in order: close its
                            # breadcrumb BEFORE the E-MONO-038 check, so that
                            # orderly `return false` never leaves a `start` open
                            # for the parent to read as a dead worker.
                            ice_boundary_module_done(name_direct, "mir_lower")
                            # Verifier-side twin of driver_trait_devirtualization_allowed_v1:
                            # a module bound for a package archive must carry NO
                            # devirtualized trait-object call (E-MONO-038).
                            if val archived_devirt = post_mono_archive_admission_v1(
                                    name_direct, direct_lowering.devirtualized_calls - devirt_before,
                                    self.ctx.runtime_std_full_inventory_selection != nil):
                                self.ctx.add_error(archived_devirt)
                                log_phase("aot:lower_to_mir:archived_devirtualization idx={direct_idx} module={name_direct}")
                                mir_failed_modules = build_phase_record_failed_module_v1(mir_failed_modules, true)
                                log_build_progress("mir", "modules", direct_pos + 1,
                                    mir_source_indices.len(), name_direct, 4, 6, mir_failed_modules, 0, "running")
                                return false
                            log_phase("aot:lower_to_mir:module:done idx={direct_idx} module={name_direct} functions={lowered_entry.functions.len()}")
                    if ice_message != "":
                        if not _driver_mir_ice_continue(self.ctx, name_direct, src_direct.path, ice_message, ice_arena_aborted):
                            mir_failed_modules = build_phase_record_failed_module_v1(mir_failed_modules, true)
                            log_build_progress("mir", "modules", direct_pos + 1,
                                mir_source_indices.len(), name_direct, 4, 6, mir_failed_modules, 0, "running")
                            return false
                    lowered_entry
                else:
                    MirModule(
                        name: name_direct,
                        functions: {},
                        statics: {},
                        constants: {},
                        types: {}
                    )
                if mir_physical_ownership_active:
                    mir_direct.name = name_direct
                self.ctx.mir_modules[name_direct] = mir_direct
                if name_direct == "app.cli.bootstrap_main":
                    self.ctx.set_bootstrap_entry_mir(name_direct, mir_direct)
                direct_pos = direct_pos + 1
                mir_failed_modules = build_phase_record_failed_module_v1(mir_failed_modules,
                    module_new_fatal or self.ctx.error_count_value > module_context_errors_before)
                if direct_pos % 64 == 0 or direct_pos == mir_source_indices.len():
                    log_build_progress("mir", "modules", direct_pos,
                        mir_source_indices.len(), name_direct,
                        4, 6, mir_failed_modules, 0, "running")
                staged_pending = staged_pending + 1
                if self.native_staged_codegen.active and native_staged_codegen_flush_due_v1(
                        staged_pending, self.native_staged_codegen.batch_size,
                        direct_pos, mir_source_indices.len()):
                    if not self.native_staged_codegen_flush_v1(mir_failed_modules > 0):
                        return false
                    staged_pending = 0
            log_phase("aot:mir_diagnostics:errors:start")
            _driver_collect_mir_errors(self.ctx, direct_lowering.errors)
            log_phase("aot:mir_diagnostics:errors:done")
            log_phase("aot:mir_diagnostics:advisories:start")
            driver_collect_mir_advisories(self.ctx, direct_lowering.mir_advisories)
            log_phase("aot:mir_diagnostics:advisories:done")
            if self.ctx.error_count_value != 0:
                return false
            if not self.publish_runtime_std_mir_emissions_v1(): return false
            return self.ctx.error_count_value == 0

        # Canonical constructor — this was a SECOND hand-duplicated
        # MirLowering(...) copy, drifted even further behind the class (same 8
        # missing fields as the --entry-closure copy fixed in
        # native_build_entry_struct_construction_buildfail_2026-07-20, so the
        # nil-fill landmine was still live on this fallback path).
        var lowering = MirLowering.new_for_target(SymbolTable.new(), collection_target)
        if not allow_bootstrap_shortcuts:
            lowering.use_explicit_semantic_policy()
        lowering.configure_mcdc_mode(_driver_mcdc_mir_mode(self.ctx), _driver_mcdc_budget(self.ctx, "mcdc_owner_bytes", 1048576), _driver_mcdc_budget(self.ctx, "mcdc_global_bytes", 67108864), self.ctx.config["mcdc_include"] ?? "", self.ctx.config["mcdc_exclude"] ?? "")

        # BUG-001 diagnostic: log module count entering MIR lowering
        log_debug("[lower_to_mir] lowering to MIR")
        var lower_trace_count = 0
        if self.ctx.sources.len() <= 0:
            # Same crossmodule struct prepass as the --entry-closure loop
            # above: register all modules' struct layouts before lowering
            # any module on the shared MirLowering instance.
            # Cycle-117: same expression-read index loop (no for-in rebind).
            var prescan_provider_i = 0
            val prescan_provider_keys = self.ctx.hir_modules.keys()
            while prescan_provider_i < prescan_provider_keys.len():
                lowering.prescan_module_struct_names(
                    self.ctx.hir_modules, prescan_provider_keys[prescan_provider_i])
                prescan_provider_i = prescan_provider_i + 1
            var fallback_done = 0
            var fallback_failed = 0
            for hir_module in self.ctx.mir_feed_modules:
                val typed_hir_module: HirModule = hir_module
                val module_context_errors_before = self.ctx.error_count_value
                val name = if mir_physical_ownership_active:
                    mir_layout_canonical_module_name(typed_hir_module.name)
                else:
                    typed_hir_module.name
                # Per-module transient scope -- same mechanism and escape-set
                # proof as the --entry-closure loop above
                # (lower_module_transient_scoped, module_lowering.spl:1213).
                # `lower_module_transient_scoped` itself checks
                # ambient_bootstrap_enabled() and falls back to plain
                # lower_module() when SIMPLE_BOOTSTRAP=1, so this call site
                # inherits that safety unconditionally: it never attempts to
                # reclaim the arena while the flat `_bootstrap_mir_*` /
                # `_bootstrap_fn_*` / `_bootstrap_hir_*` registries (whose
                # reachability from this boundary is unproven) could be live.
                val ice_gate = ice_boundary_module_start(name, typed_hir_module.path, "mir_lower", "")
                if ice_gate != "":
                    val may_continue = _driver_mir_ice_continue(self.ctx, name, typed_hir_module.path, ice_gate, ice_message_arena_aborted(ice_gate))
                    fallback_done = fallback_done + 1
                    fallback_failed = build_phase_record_failed_module_v1(fallback_failed, true)
                    if not may_continue or fallback_done % 64 == 0 or fallback_done == self.ctx.mir_feed_modules.len():
                        log_build_progress("mir", "modules", fallback_done,
                            self.ctx.mir_feed_modules.len(), name, 4, 6, fallback_failed, 0, "running")
                    if not may_continue: return false
                    continue
                val fallback_devirt_before: i64 = lowering.devirtualized_calls
                val module_errors_before = lowering.errors.len()
                val scoped_fallback = lowering.lower_module_transient_scoped(hir_module, self.ctx.mir_feed_modules)
                driver_trace_module_mir_errors(name, typed_hir_module.path,
                    lowering.errors, module_errors_before)
                if scoped_fallback.is_err():
                    # Arena already aborted: record and return, never continue.
                    log_phase("aot:lower_to_mir:transient_scope_failed module={name}")
                    val _ice_stop = _driver_mir_ice_continue(self.ctx, name, typed_hir_module.path,
                        "MIR lowering transient scope failed for {name}: {scoped_fallback.unwrap_err()}", true)
                    fallback_done = fallback_done + 1
                    fallback_failed = build_phase_record_failed_module_v1(fallback_failed, true)
                    log_build_progress("mir", "modules", fallback_done,
                        self.ctx.mir_feed_modules.len(), name, 4, 6, fallback_failed, 0, "running")
                    return false
                # Closed BEFORE the E-MONO-038 check below, so that orderly
                # `return false` leaves no open `start` breadcrumb.
                ice_boundary_module_done(name, "mir_lower")
                var mir_module: MirModule = scoped_fallback.unwrap()
                mir_module.name = name
                # This instance never sets trait_impl_closure_complete, so it
                # cannot devirtualize today; the admission check is still
                # applied so every MirLowering the driver owns is covered by
                # the same E-MONO-038 assertion (defense in depth, not a gate
                # that is expected to fire).
                if val fallback_archived_devirt = post_mono_archive_admission_v1(
                        name, lowering.devirtualized_calls - fallback_devirt_before,
                        self.ctx.runtime_std_full_inventory_selection != nil):
                    self.ctx.add_error(fallback_archived_devirt)
                    log_phase("aot:lower_to_mir:archived_devirtualization module={name}")
                    fallback_done = fallback_done + 1
                    fallback_failed = build_phase_record_failed_module_v1(fallback_failed, true)
                    log_build_progress("mir", "modules", fallback_done,
                        self.ctx.mir_feed_modules.len(), name, 4, 6, fallback_failed, 0, "running")
                    return false
                self.ctx.mir_modules[name] = mir_module
                if name == "app.cli.bootstrap_main":
                    self.ctx.set_bootstrap_entry_mir(name, mir_module)
                fallback_done = fallback_done + 1
                fallback_failed = build_phase_record_failed_module_v1(fallback_failed,
                    driver_mir_has_new_fatal_errors_v1(lowering.errors, module_errors_before) or
                    self.ctx.error_count_value > module_context_errors_before)
                if fallback_done % 64 == 0 or fallback_done == self.ctx.mir_feed_modules.len():
                    log_build_progress("mir", "modules", fallback_done,
                        self.ctx.mir_feed_modules.len(), name, 4, 6, fallback_failed, 0, "running")
            _driver_collect_mir_errors(self.ctx, lowering.errors)
            driver_collect_mir_advisories(self.ctx, lowering.mir_advisories)
            log_debug("[lower_to_mir] MIR done")
        return self.ctx.error_count_value == 0
        for src3 in self.ctx.sources:
            val name = src3.module_name
            val mir_module = MirModule(
                name: name,
                functions: {},
                statics: {},
                constants: {},
                types: {}
            )
            self.ctx.mir_modules[name] = mir_module
            if name == "app.cli.bootstrap_main":
                self.ctx.set_bootstrap_entry_mir(name, mir_module)

        log_debug("[lower_to_mir] MIR done")
        self.ctx.error_count_value == 0
use compiler.common.diagnostics.span.{Span}
