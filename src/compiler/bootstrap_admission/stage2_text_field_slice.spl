class CapturedText:
    status: i64
    stdout: text

struct TextPort:
    marker: i64
    execute_fn: fn() -> CapturedText

fn capture() -> CapturedText:
    CapturedText(status: 37, stdout: "abcdef")

fn cut(observed: CapturedText) -> text:
    var stdout = observed.stdout
    stdout = stdout.substring(0, 2)
    stdout.slice(1)

fn cut_port(port: TextPort) -> text:
    val observed = port.execute_fn()
    var stdout = observed.stdout
    stdout = stdout.substring(0, 2)
    stdout.slice(1)

fn main() -> i64:
    val sliced = cut_port(TextPort(marker: 42, execute_fn: capture))
    if sliced != "b":
        print "substring_inferred=FAIL"
        return 1
    if cut(capture()) != "b":
        return 2
    val port = TextPort(marker: 42, execute_fn: capture)
    if port.execute_fn().stdout.substring(1, 3) != "bc":
        return 3
    print "substring_inferred=PASS"
    0
