# Stage-2 admission fixture: module naming must survive native lowering.
# EXPECT stdout:
# app.cli.bootstrap_main
# compiler.driver.driver
# app.cli.main
#
# WORKAROUND (upstream p2_add cycle-149, variant H -- docs-only, no fix yet):
# a single-function file deterministically SIGSEGVs the stage2-compiled
# compiler in HirLowering.dynamic_callback_function_type (see
# stage2_mir_retention.spl for the full note). The marker call adds a second
# function to the module, which rescues the draw; stdout is unchanged (the
# three module names above). Remove the decoy once the compiler fix lands.

use compiler.common.module_path_naming.{module_logical_name_from_path}

fn naming_entry_marker() -> i64:
    1

fn main():
    val naming_marker = naming_entry_marker()
    print(module_logical_name_from_path("src/app/cli/bootstrap_main.spl"))
    print(module_logical_name_from_path("src/compiler/driver/driver.spl"))
    print(module_logical_name_from_path("/tmp/café/simple/src/app/cli/main.spl"))
