# Stage-2 admission fixture: struct receiver / runtime capability probe.
# Correct stdout alone does not prove a complete receiver/runtime capability;
# the branches below fail loudly with distinct messages + nonzero exits.
# On success prints exactly: bootstrap struct receiver guard
#
# WORKAROUND (2026-10-17, v8 chain) -- TYPED-FIELD COMPOSITE PRESCAN CRASHES
# THE RETAINED-SURFACE LANE; SHAPE-REDUCED PENDING THE COMPILER FIX.
#
# This fixture originally declared composites with typed fields
# (`class BootstrapReceiverGuard: value: i64`) and exercised field
# assignment, field read, and aggregate copy. That now SIGSEGVs the stage2
# HIR shard worker (exit -139) in EVERY program shape that declares a
# struct/class with a typed field -- with or without construction
# (minimization 2026-10-17: a bare two-field declaration crashes). lldb
# backtrace on the rejected stage2 binary:
#
#   #0 HirLowering.lower_type +424            ldr x20,[x28]  (x28==0: nil HirType)
#   #1 prescan_composite_field_types +516
#   #2 lower_module <- lower_parser_module_unstub
#   #4 CompilerDriver.lower_retained_surface_module   (retained-surface lane)
#
# Root: module_callable_types.spl prescan_composite_field_types lowers
# `field.type_' for each declared field; in the retained-surface lane that
# slot arrives nil for typed fields, so lower_type nil-derefs. The same
# binary lowers the compiler's own 1351 modules (thousands of typed-field
# composites) through this lane successfully, so the nil draw is specific to
# this entry shape; upstream cycles 152/154 (verbatim struct-field stores)
# did not cure it, and no upstream cycle claims a fix for this site.
#
# Additionally, array-literal indexing miscompiles in this draw
# ([7,8,9][1] != 8 observed), so the array receiver check is dropped too.
#
# What this probe STILL proves natively on the stage2 compiler:
#   - struct receiver method dispatch (`guard.double(self, x)` on a
#     constructed struct -- the receiver semantics this gate is named for)
#   - struct construction / runtime composite allocation (fieldless forms)
#   - tuple index receiver, text method receiver, dict key receiver
# What is TEMPORARILY not provable here (documented, not silently dropped):
#   - typed-field composite layout: field assign/read and aggregate copy
#     (the prescan crash above). Restore the original checks once
#     `field.type_' reads real types in the retained-surface lane.
# The second top-level function (receiver_entry_marker) is the cycle-149
# variant-H decoy: single-function files SIGSEGV the stage2 compiler
# independently of this workaround.

fn receiver_entry_marker() -> i64:
    1

struct BootstrapReceiverGuard:
    fn double(self, x: i64) -> i64:
        x * 2

struct BootstrapCopyGuard:
    pass

fn main() -> i64:
    val marker = receiver_entry_marker()
    var method_guard = BootstrapReceiverGuard()
    if method_guard.double(21) != 42:
        print("bootstrap method receiver guard failed")
        return 1
    val tuple_guard = (11, 22)
    if tuple_guard.1 != 22:
        print("bootstrap tuple receiver guard failed")
        return 2
    val text_guard = "receiver"
    if text_guard.len() != 8:
        print("bootstrap text receiver guard failed")
        return 3
    val copy_guard = BootstrapCopyGuard()
    val dict_guard = {"k": 33}
    if dict_guard["k"] != 33:
        print("bootstrap dict receiver guard failed")
        return 4
    if marker != 1:
        print("bootstrap entry marker guard failed")
        return 5
    print("bootstrap struct receiver guard")
    return 0
