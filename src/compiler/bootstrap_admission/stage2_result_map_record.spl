# Native semantic regression for imported Result record payloads.
# EXPECT stdout: result-map-record: assertions=8 values=37,37,37,37,37,37,37,37
use compiler.bootstrap_admission.result_map_record_provider.{ResultMapRecord, result_map_record_input, result_map_envelope_input}

fn main():
    val active_ok = result_map_record_input(true).map(\item: item.second).unwrap()
    assert active_ok == 37
    val active_err = result_map_record_input(false).map_err(\item: item.second).unwrap_err()
    assert active_err == 37
    val identity_ok = result_map_record_input(true).map(\item: item).unwrap().second
    assert identity_ok == 37
    val identity_err = result_map_record_input(false).map_err(\item: item).unwrap_err().second
    assert identity_err == 37
    val inactive_err = result_map_record_input(false).map(\item: item.first + 99).unwrap_err().second
    assert inactive_err == 37
    val inactive_ok = result_map_record_input(true).map_err(\item: item.first + 99).unwrap().second
    assert inactive_ok == 37
    val nested_ok = result_map_envelope_input(true).map(\item: item.roots).unwrap().second
    assert nested_ok == 37
    val nested_err = result_map_envelope_input(false).map(\item: item.roots).unwrap_err().second
    assert nested_err == 37
    print "result-map-record: assertions=8 values={active_ok},{active_err},{identity_ok},{identity_err},{inactive_err},{inactive_ok},{nested_ok},{nested_err}"
