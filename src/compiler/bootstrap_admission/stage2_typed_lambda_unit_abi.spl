# EXPECT stdout:
# 37
# 37
# 37
# 37
# typed-lambda-unit-abi: effects=4
# Unit callbacks must execute their bodies and return without an ABI value.
struct UnitPort:
    execute: fn(i64) -> ()

fn emit_value(value: i64) -> ():
    print value

fn invoke_unit(callback: fn(i64) -> (), value: i64) -> ():
    callback(value)

fn main():
    val raw = UnitPort(execute: emit_value)
    raw.execute(37)
    val uncaptured = UnitPort(execute: \value: print value)
    uncaptured.execute(37)
    val shift = 11
    val captured = UnitPort(execute: \value: print value + shift)
    captured.execute(26)
    invoke_unit(\value: print value + shift, 26)
    print "typed-lambda-unit-abi: effects=4"
