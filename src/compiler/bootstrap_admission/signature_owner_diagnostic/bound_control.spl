# Keep the function-field call but bind its result before matching.
use provider.{Argument as ProviderArgument, Payload as ProviderPayload, make_argument, make_port}

struct Argument:
    second: text

struct Payload:
    value: text

fn main() -> i64:
    val decoy_argument = Argument(second: "consumer")
    val decoy_payload = Payload(value: "consumer")
    print "signature-bound decoy_argument={decoy_argument.second} decoy_payload={decoy_payload.value}"
    val argument = make_argument()
    val port = make_port()
    print "signature-bound argument first={argument.first} second={argument.second}"
    val result = port.call_fn(argument)
    match result:
        case Ok(values):
            val count = values.len()
            print "signature-bound variant=Ok length={count} expected=1"
            if count != 1: return 51
            val payload = values[0]
            val prefix = payload.prefix
            val value = payload.value
            print "signature-bound prefix={prefix} expected_prefix=10 value={value} expected_value=17"
            if prefix != 10: return 52
            if value != 17: return 53
            print "signature-bound diagnostic guards=3/3 first_failure=0"
            return 0
        case Err(message):
            print "signature-bound variant=Err message={message}"
            return 54
    55
