# Direct provider-call control for the unchanged signature-owner provider.
use provider.{Argument as ProviderArgument, Payload as ProviderPayload, make_argument, execute}

struct Argument:
    second: text

struct Payload:
    value: text

fn main() -> i64:
    val decoy_argument = Argument(second: "consumer")
    val decoy_payload = Payload(value: "consumer")
    print "signature-direct decoy_argument={decoy_argument.second} decoy_payload={decoy_payload.value}"
    val argument = make_argument()
    print "signature-direct argument first={argument.first} second={argument.second}"
    match execute(argument):
        case Ok(values):
            val count = values.len()
            print "signature-direct variant=Ok length={count} expected=1"
            if count != 1: return 41
            val payload = values[0]
            val prefix = payload.prefix
            val value = payload.value
            print "signature-direct prefix={prefix} expected_prefix=10 value={value} expected_value=17"
            if prefix != 10: return 42
            if value != 17: return 43
            print "signature-direct diagnostic guards=3/3 first_failure=0"
            return 0
        case Err(message):
            print "signature-direct variant=Err message={message}"
            return 44
    45
