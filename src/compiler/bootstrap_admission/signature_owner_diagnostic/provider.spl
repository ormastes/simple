pub struct Argument:
    first: i64
    second: i64

pub struct Payload:
    prefix: i64
    value: i64

pub struct Port:
    call_fn: fn(Argument) -> Result<[Payload], text>

pub fn execute(argument: Argument) -> Result<[Payload], text>:
    Ok([Payload(prefix: 10, value: argument.second)])

pub fn make_port() -> Port:
    Port(call_fn: execute)

pub fn make_argument() -> Argument:
    Argument(first: 3, second: 17)
