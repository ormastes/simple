# Companion diagnostic only; the original four assertions remain unchanged.
use provider.{Argument as ProviderArgument, Payload as ProviderPayload, Port, make_port, make_argument}

struct Argument:
    second: text

struct Payload:
    value: text

fn main() -> i64:
    var guards: i64 = 0
    val decoy_argument = Argument(second: "consumer")
    val decoy_payload = Payload(value: "consumer")
    print "signature-owner decoy_argument={decoy_argument.second} decoy_payload={decoy_payload.value}"
    if decoy_argument.second != decoy_payload.value:
        print "signature-owner diagnostic guards={guards}/4 first_failure=21"
        return 21
    guards = guards + 1
    val port = make_port()
    val argument = make_argument()
    print "signature-owner argument first={argument.first} second={argument.second}"
    print "signature-owner begin=call"
    match port.call_fn(argument):
        case Ok(values):
            val count = values.len()
            print "signature-owner variant=Ok length={count} expected=1"
            if count != 1:
                print "signature-owner diagnostic guards={guards}/4 first_failure=22"
                return 22
            guards = guards + 1
            val payload = values[0]
            val prefix = payload.prefix
            val value = payload.value
            print "signature-owner payload prefix={prefix} expected_prefix=10 value={value} expected_value=17"
            var failure: i64 = 0
            if prefix == 10: guards = guards + 1
            else: failure = 23
            if value == 17: guards = guards + 1
            elif failure == 0: failure = 24
            print "signature-owner diagnostic guards={guards}/4 first_failure={failure}"
            return failure
        case Err(message):
            print "signature-owner variant=Err message={message}"
            print "signature-owner diagnostic guards={guards}/4 first_failure=25"
            return 25
    print "signature-owner diagnostic unmatched_result guards={guards}/4 first_failure=26"
    26
