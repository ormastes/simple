pub struct ResultMapRecord:
    first: i64
    second: i64

pub fn result_map_record_input(succeed: bool) -> Result<ResultMapRecord, ResultMapRecord>:
    val record = ResultMapRecord(first: 11, second: 37)
    if succeed: Ok(record) else: Err(record)

pub struct ResultMapEnvelope:
    roots: ResultMapRecord

pub fn result_map_envelope_input(succeed: bool) -> Result<ResultMapEnvelope, ResultMapRecord>:
    val record = ResultMapRecord(first: 11, second: 37)
    if succeed: Ok(ResultMapEnvelope(roots: record)) else: Err(record)
