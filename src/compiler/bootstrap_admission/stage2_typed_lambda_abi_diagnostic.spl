# Diagnostic companion; keep the original six-assertion fixture unchanged.
# All six cases run. Exit 11..16 identifies the first failed guard.
struct FloatPort:
    execute: fn(f64) -> f64

struct ZeroFloatPort:
    execute: fn() -> f64

fn add_quarter(value: f64) -> f64:
    value + 0.25

fn invoke_float(callback: fn(f64) -> f64, value: f64) -> f64:
    callback(value)

fn invoke_word(callback, value):
    callback(value)

fn main() -> i64:
    var guards: i64 = 0
    var failure: i64 = 0
    print "typed-lambda begin=raw"
    val raw = FloatPort(execute: add_quarter)
    val raw_value = raw.execute(2.5)
    print "typed-lambda case=raw actual={raw_value} expected=2.75"
    if raw_value == 2.75: guards = guards + 1
    else: failure = 11
    print "typed-lambda begin=noncapture"
    val uncaptured = FloatPort(execute: \value: value + 0.25)
    val uncaptured_value = uncaptured.execute(2.5)
    print "typed-lambda case=noncapture actual={uncaptured_value} expected=2.75"
    if uncaptured_value == 2.75: guards = guards + 1
    elif failure == 0: failure = 12
    print "typed-lambda begin=zero"
    val zero = ZeroFloatPort(execute: \: 2.5)
    val zero_value = zero.execute()
    print "typed-lambda case=zero actual={zero_value} expected=2.5"
    if zero_value == 2.5: guards = guards + 1
    elif failure == 0: failure = 13
    val shift = 3
    print "typed-lambda begin=capture"
    val captured = FloatPort(execute: \value: value + shift)
    val captured_value = captured.execute(2.5)
    print "typed-lambda case=capture actual={captured_value} expected=5.5"
    if captured_value == 5.5: guards = guards + 1
    elif failure == 0: failure = 14
    print "typed-lambda begin=typedparam"
    val typed_value = invoke_float(\value: value + shift, 2.5)
    print "typed-lambda case=typedparam actual={typed_value} expected=5.5"
    if typed_value == 5.5: guards = guards + 1
    elif failure == 0: failure = 15
    print "typed-lambda begin=inferredword"
    val word_value = invoke_word(\value: value + shift, 5)
    print "typed-lambda case=inferredword actual={word_value} expected=8"
    if word_value == 8: guards = guards + 1
    elif failure == 0: failure = 16
    print "typed-lambda diagnostic guards={guards}/6 first_failure={failure}"
    failure
