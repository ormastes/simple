class MutablePort:
    call_fn: fn(i64) -> i64

    me replace() -> i64:
        self.call_fn = second
        3

struct OptionalPort:
    call_fn: fn(i64?) -> i64

fn first(value: i64) -> i64:
    value + 10

fn second(value: i64) -> i64:
    value + 20

fn optional_value(value: i64?) -> i64:
    value ?? 99

fn main() -> i64:
    val port = MutablePort(call_fn: first)
    if port.call_fn(port.replace()) != 13:
        return 1
    if port.call_fn(3) != 23:
        return 2
    val optional_port = OptionalPort(call_fn: optional_value)
    if optional_port.call_fn(3) != 3:
        return 3
    if optional_port.call_fn(nil) != 99:
        return 4
    val optional_argument: i64? = Some(5)
    if port.call_fn(optional_argument) != 25:
        return 5
    print "function_field_arguments=PASS checks=5"
    0
