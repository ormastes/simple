# WORKAROUND (upstream p2_add cycle-149, variant H -- docs-only, no fix yet):
# a single-function file deterministically SIGSEGVs the stage2-compiled
# compiler in HirLowering.dynamic_callback_function_type (see
# stage2_mir_retention.spl for the full note). The marker call adds a second
# function to the module, which rescues the draw; stdout is unchanged
# ("hello"). Remove the decoy once the compiler fix lands.

fn hello_entry_marker() -> i64:
    1

fn main():
    val hello_marker = hello_entry_marker()
    print("hello")
