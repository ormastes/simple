# EXPECT stdout: typed-lambda-abi: assertions=6
# Both raw named functions and lifted closures must use the declared float ABI.
struct FloatPort:
    execute: fn(f64) -> f64

struct ZeroFloatPort:
    execute: fn() -> f64

fn add_quarter(value: f64) -> f64:
    value + 0.25

fn invoke_float(callback: fn(f64) -> f64, value: f64) -> f64:
    callback(value)

fn invoke_word(callback, value):
    callback(value)

fn main():
    val raw = FloatPort(execute: add_quarter)
    assert raw.execute(2.5) == 2.75
    val uncaptured = FloatPort(execute: \value: value + 0.25)
    assert uncaptured.execute(2.5) == 2.75
    val zero = ZeroFloatPort(execute: \: 2.5)
    assert zero.execute() == 2.5
    val shift = 3
    val captured = FloatPort(execute: \value: value + shift)
    assert captured.execute(2.5) == 5.5
    assert invoke_float(\value: value + shift, 2.5) == 5.5
    assert invoke_word(\value: value + shift, 5) == 8
    print "typed-lambda-abi: assertions=6"
