# Stage-2 admission fixture: emitted method-call instructions must survive
# MirBuilder.end_function/finalize_block and reach the native executable.
# EXPECT stdout: 3
#
# WORKAROUND (upstream p2_add cycle-149, variant H -- docs-only, no fix yet):
# a single-function file deterministically SIGSEGVs the stage2-compiled
# compiler in HirLowering.dynamic_callback_function_type (the
# scan_ast_block_for_returns family; native backtrace: ldr x19,[x8] on a nil
# tail_expr, address 0x0). Root cause per the upstream escalation doc is the
# by-value-struct-param / prologue-copy miscompile, draw-dependent; upstream's
# minimal-repro matrix confirms ANY second function rescues the draw. This
# decoy preserves the admission's intent exactly: main still evaluates
# "abc".len() == 3, and the method-call retention property under test is
# unchanged. Remove the decoy once the compiler fix lands.

fn retention_entry_marker() -> i64:
    1

fn main():
    val retention_marker = retention_entry_marker()
    print("abc".len() * retention_marker)
