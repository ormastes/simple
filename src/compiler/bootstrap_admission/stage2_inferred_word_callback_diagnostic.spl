# Old/new producer control: retain the original unannotated callback helper.
fn invoke_word(callback, value):
    callback(value)

fn add_three(value: i64) -> i64:
    value + 3

fn main() -> i64:
    val input = 5
    val shift = 3
    print "inferred-word input={input} shift={shift} expected=8"
    val direct = add_three(input)
    print "inferred-word direct={direct}"
    val callback = \value: value + shift
    val local_lambda = callback(input)
    print "inferred-word local_lambda={local_lambda}"
    print "inferred-word begin=generic_callback"
    val generic = invoke_word(\value: value + shift, input)
    print "inferred-word generic_callback={generic}"
    var guards: i64 = 0
    var failure: i64 = 0
    if direct == 8: guards = guards + 1
    else: failure = 31
    if local_lambda == 8: guards = guards + 1
    elif failure == 0: failure = 32
    if generic == 8: guards = guards + 1
    elif failure == 0: failure = 33
    print "inferred-word diagnostic guards={guards}/3 first_failure={failure}"
    failure
