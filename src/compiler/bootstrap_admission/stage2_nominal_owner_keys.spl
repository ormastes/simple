# EXPECT stdout: nominal-owner-keys: assertions=7
use compiler.mir._MirLowering.provider_metadata.{mir_nominal_owner_matches}

fn main():
    assert mir_nominal_owner_matches("Record", "compiler.bootstrap_admission.provider", "src/compiler/bootstrap_admission/provider.spl::Record")
    assert mir_nominal_owner_matches("Record", "src/compiler/bootstrap_admission/provider.spl", "compiler.bootstrap_admission.provider::Record")
    assert mir_nominal_owner_matches("Record", "src/compiler/50.mir/provider.spl", "compiler.mir.provider.Record")
    assert not mir_nominal_owner_matches("Record", "compiler.bootstrap_admission.decoy", "src/compiler/bootstrap_admission/provider.spl::Record")
    assert not mir_nominal_owner_matches("Record", "compiler.bootstrap_admission.provider", "Record")
    assert not mir_nominal_owner_matches("Record", "compiler.bootstrap_admission.provider", "compiler.bootstrap_admission.provider::OtherRecord")
    assert mir_nominal_owner_matches("Record", "", "Record")
    print "nominal-owner-keys: assertions=7"
