# Join-point patchpoints: the slot-cell table.
#
# WHY THIS EXISTS
# ---------------
# `doc/04_architecture/compiler/aspect_dynload/patchpoint_and_signing_prerequisites_2026-08-19.md`
# §A establishes that NO join-point slot table exists in the tree, while the
# primitives it needs are already proven in production: anonymous RW mappings
# (`smf_mmap_native.spl`) and indirect-call codegen
# (`70.backend/backend/llvm_ir_builder.spl:486`). Its recommendation is
# BUILD-NOW, narrowly scoped to a slot-cell indirect-call table. This module is
# exactly that scope and nothing else.
#
# THE DESIGN, IN ONE LINE
# -----------------------
# One naturally-aligned pointer-width function-pointer CELL per join point, in
# a page-aligned DATA table. A join-point call is an indirect call through its
# cell. Binding advice = atomically overwriting one cell. Nothing in the
# instruction stream is ever rewritten, and nothing in this table is ever
# executed.
#
# EXPLICITLY OUT OF SCOPE (scoping doc: DO-NOT-BUILD-YET): general inline
# instruction-stream patching / self-modifying code, and anything gated on a
# signing authority.
#
# HARDENING CONTRACT (plan "Optimized Dynamic Aspects" D15 / OBS-021,
# `doc/03_plan/compiler/aspect_dynload/optimized_observability_aspects_2026-10-28.md`)
# ------------------------------------------------------------------------
# * The table is DATA, never code. It is allocated RW with
#   `native_alloc_rw_memory` and stays RW for its whole life. There is no
#   RW->RX seal, no RX->RW->RX patch window and no icache flush: a pointer
#   table has no instructions to execute, so making it executable only widens
#   the attack surface. `protection_transitions` is retained as an observable
#   and must stay 0 -- the spec asserts it.
# * Publication is ATOMIC, not merely aligned. A cell is written with
#   `rt_par_atomic_xchg_i64` (SeqCst swap in the seed runtime and in
#   `src/runtime/runtime_native.c`), and a dispatch read goes through
#   `rt_par_atomic_load_i64` (SeqCst load). A reader therefore observes the
#   whole old pointer or the whole new pointer, never a mixture, on every
#   backend -- and the ordering is the primitive's, not an inference from the
#   ISA manual. `read_cell_raw` keeps the byte-wise read ONLY so the specs can
#   prove the value landed in the mapped page.
# * Geometry is EXPLICIT and comes from the host. `JoinpointSlotGeometry`
#   carries the pointer width and the page size; `host()` asks the host
#   (`rt_page_size()`, `TargetArch.host().pointer_bytes()`) and refuses any
#   width the atomic primitive cannot cover rather than assuming 8, and any
#   page size that is not a positive power of two rather than assuming 4096.
# * A replaced target is RETAINED until readers quiesce. `patch_cell` records
#   the previous target under the generation it was replaced in; the retired
#   list is only drained while `reader_pins` is zero. The registry transaction
#   (`registry_transaction_2026-08-22_tldr.md`) owns the real pin/lease
#   protocol; this table only guarantees that a target a pinned reader may
#   still be dispatching to is never forgotten.
#
# What this does NOT claim: a concurrent reader may still observe the old
# target for a window after the swap. Advice binding is idempotent-by-
# construction (bind installs a complete target, never a partially-built one),
# so a stale-but-whole pointer is a correctness-preserving outcome.

use .smf_mmap_native.{
    native_alloc_rw_memory,
    native_free_exec_memory,
    native_call_function_0
}
use std.common.target.{TargetArch}

# Raw-cell atomics. Same externs `nogc_sync_mut/trace/observer_native_channel_v1.spl`
# already uses on mmap'd arenas; this module introduces no new way to touch
# memory.
@unsafe(reason: "atomic swap on a caller-owned, bounds-checked cell", capabilities: [ffi, raw_ptr])
extern fn rt_par_atomic_xchg_i64(addr: i64, value: i64) -> i64
@unsafe(reason: "atomic load from a caller-owned, bounds-checked cell", capabilities: [ffi, raw_ptr])
extern fn rt_par_atomic_load_i64(addr: i64) -> i64
@unsafe(reason: "nonnull raw read; joinpoint slot allocation and bounds are caller-owned", capabilities: [ffi, raw_ptr])
extern fn rt_ptr_read_u8(addr: i64, offset: i64) -> i64
@unsafe(reason: "host page-size query", capabilities: [ffi])
extern fn rt_page_size() -> i64

"""Sentinel slot id meaning `no slot`. Never a valid index."""
val SLOT_ID_NONE: i64 = -1

"""The only cell width the atomic publication primitive covers."""
val ATOMIC_CELL_WIDTH: i64 = 8

"""Explicit table geometry: no hard-coded 8 or 4096 anywhere below."""
struct JoinpointSlotGeometry:
    pointer_width: i64
    page_size: i64

fn _is_power_of_two(v: i64) -> bool:
    v > 0 and (v & (v - 1)) == 0

impl JoinpointSlotGeometry:
    """Validate a geometry. Refuses, never defaults."""
    static fn validate(pointer_width: i64, page_size: i64) -> Result<JoinpointSlotGeometry, text>:
        if pointer_width != ATOMIC_CELL_WIDTH:
            return Err("Join-point slot cell width {pointer_width} is not covered by the atomic publication primitive (rt_par_atomic_xchg_i64 is {ATOMIC_CELL_WIDTH} bytes wide)")
        if not _is_power_of_two(page_size):
            return Err("Join-point slot page size {page_size} is not a positive power of two")
        if page_size < pointer_width:
            return Err("Join-point slot page size {page_size} is smaller than one cell")
        Ok(JoinpointSlotGeometry(pointer_width: pointer_width, page_size: page_size))

    """Ask the host. Page size via `rt_page_size()`; pointer width via the
    target description. Both go through `validate`."""
    static fn host() -> Result<JoinpointSlotGeometry, text>:
        val page = rt_page_size()
        if page <= 0:
            return Err("Host page size unavailable (rt_page_size returned {page})")
        val width = TargetArch.host().pointer_bytes().to_i64()
        JoinpointSlotGeometry.validate(pointer_width: width, page_size: page)

"""One join point's reserved cell.

`unadvised_target` is the address the join point calls when nothing is bound;
it is what `unbind` restores, so unbinding is a restore rather than a reset to
zero."""
struct JoinpointSlot:
    key: text
    slot_id: i64
    unadvised_target: i64
    bound_target: i64
    bound: bool
    bind_count: i64

"""A target that was swapped out of a cell and may still be in flight for a
pinned reader. Kept until `drain_retired` observes zero reader pins."""
struct RetiredTarget:
    slot_id: i64
    target: i64
    generation: i64

"""The slot table: one page-aligned RW region of cells plus its directory."""
struct JoinpointSlotTable:
    base: i64
    capacity: i64
    used: i64
    geometry: JoinpointSlotGeometry
    by_key: Dict<text, i64>
    slots: Dict<i64, JoinpointSlot>
    patch_count: i64
    protection_transitions: i64
    sealed: bool
    generation: i64
    reader_pins: i64
    retired: [RetiredTarget]

"""Stable slot key.

Deterministic from (owner module id, symbol, site index) so the same join point
gets the same key across builds and across processes -- the property the aspect
catalog needs to route a `joinpoint_slot_id` without carrying raw addresses."""
fn joinpoint_key(owner_id: text, symbol: text, site_index: i64) -> text:
    owner_id + "::" + symbol + "#" + site_index.to_string()

impl JoinpointSlotTable:
    """Allocate a slot table with room for `capacity` join points using the
    host's geometry."""
    static fn alloc(capacity: i64) -> Result<JoinpointSlotTable, text>:
        match JoinpointSlotGeometry.host():
            case Ok(g):
                JoinpointSlotTable.alloc_with_geometry(capacity, g)
            case Err(e):
                Err(e)

    """Allocate with an explicit, already-validated geometry. The mapping is
    RW and is never made executable."""
    static fn alloc_with_geometry(capacity: i64, geometry: JoinpointSlotGeometry) -> Result<JoinpointSlotTable, text>:
        match JoinpointSlotGeometry.validate(geometry.pointer_width, geometry.page_size):
            case Err(e):
                return Err(e)
            case Ok(_):
                pass
        if capacity <= 0:
            return Err("Join-point slot table capacity must be positive, got {capacity}")
        if capacity > 9223372036854775807 / geometry.pointer_width:
            return Err("Join-point slot table capacity overflows byte size: {capacity}")
        val size = capacity * geometry.pointer_width
        val base = native_alloc_rw_memory(size)
        if base == 0:
            return Err("Join-point slot table allocation failed ({size} bytes)")
        # Natural alignment is what makes the atomic cell access well-defined;
        # refuse rather than build a table whose cells could tear.
        if (base % geometry.pointer_width) != 0:
            _ = native_free_exec_memory(base, size)
            return Err("Join-point slot table base is not {geometry.pointer_width}-byte aligned")
        Ok(JoinpointSlotTable(
            base: base,
            capacity: capacity,
            used: 0,
            geometry: geometry,
            by_key: {},
            slots: {},
            patch_count: 0,
            protection_transitions: 0,
            sealed: false,
            generation: 0,
            reader_pins: 0,
            retired: []
        ))

    me cell_address(slot_id: i64) -> i64:
        if self.base == 0 or slot_id < 0 or slot_id >= self.used:
            return 0
        self.base + slot_id * self.geometry.pointer_width

    """Read a cell straight back out of mapped memory, little-endian, byte by
    byte.

    Deliberately NOT a read of the Simple-side `JoinpointSlot` record and NOT
    the atomic dispatch load: the specs must be able to prove the pointer
    actually landed in the mapped page, not just in bookkeeping."""
    me read_cell_raw(slot_id: i64) -> Result<i64, text>:
        if self.base == 0:
            return Err("Join-point slot table has been freed")
        if slot_id < 0 or slot_id >= self.used:
            return Err("Join-point slot id {slot_id} out of range")
        val addr = self.cell_address(slot_id)
        var value = 0i64
        var i = 0i64
        while i < self.geometry.pointer_width:
            val byte = rt_ptr_read_u8(addr, i)
            value = value | ((byte & 0xFF) << (i * 8))
            i = i + 1
        Ok(value)

    """Reserve one cell for a join point and initialise it to the unadvised
    target. Refuses a duplicate key and refuses to overflow the table."""
    me reserve(key: text, unadvised_target: i64) -> Result<i64, text>:
        if self.base == 0:
            return Err("Cannot reserve join-point slot: table has been freed")
        if self.sealed:
            return Err("Cannot reserve join-point slot '{key}': table already sealed")
        if key == "":
            return Err("Join-point slot key must not be empty")
        if self.by_key.has(key):
            return Err("Join-point slot already reserved: {key}")
        if self.used >= self.capacity:
            return Err("Join-point slot table full")
        if unadvised_target == 0:
            return Err("Join-point slot '{key}' needs a non-null unadvised target")

        val slot_id = self.used
        _ = rt_par_atomic_xchg_i64(self.base + slot_id * self.geometry.pointer_width, unadvised_target)
        self.by_key[key] = slot_id
        self.slots[slot_id] = JoinpointSlot(
            key: key,
            slot_id: slot_id,
            unadvised_target: unadvised_target,
            bound_target: unadvised_target,
            bound: false,
            bind_count: 0
        )
        self.used = self.used + 1
        Ok(slot_id)

    """Seal the directory: no further reservations. The mapping's protection
    does not change -- the table is data and stays RW."""
    me seal() -> Result<i64, text>:
        if self.base == 0:
            return Err("Cannot seal join-point slot table: table has been freed")
        if self.sealed:
            return Err("Join-point slot table already sealed")
        self.sealed = true
        Ok(self.used)

    """Look up a slot id by stable key. Unknown key is REFUSED, not
    defaulted."""
    me lookup(key: text) -> Result<i64, text>:
        if self.base == 0:
            return Err("Join-point slot table has been freed")
        if not self.by_key.has(key):
            return Err("Unknown join-point slot key: {key}")
        Ok(self.by_key[key])

    """Read the current dispatch target for a slot with an atomic load -- the
    address an indirect call through this cell would land on."""
    me dispatch_target(slot_id: i64) -> Result<i64, text>:
        if self.base == 0:
            return Err("Join-point slot table has been freed")
        if slot_id < 0 or slot_id >= self.used:
            return Err("Join-point slot id {slot_id} out of range")
        Ok(rt_par_atomic_load_i64(self.cell_address(slot_id)))

    """Publish ONE cell atomically.

    The previous target is retired under the new generation so a reader that
    pinned the old generation can still be served; see `drain_retired`. No
    protection flip happens on any path."""
    me patch_cell(slot_id: i64, target: i64) -> Result<i64, text>:
        if self.base == 0:
            return Err("Join-point slot table has been freed")
        if slot_id < 0 or slot_id >= self.used:
            return Err("Join-point slot id {slot_id} out of range")
        if target == 0:
            return Err("Refusing to patch join-point slot {slot_id} to a null target")
        val previous = rt_par_atomic_xchg_i64(self.cell_address(slot_id), target)
        self.generation = self.generation + 1
        self.patch_count = self.patch_count + 1
        if previous != 0 and previous != target:
            self.retired.push(RetiredTarget(slot_id: slot_id, target: previous, generation: self.generation))
        Ok(target)

    """A reader announces it may dispatch through the current generation.
    Returns the generation it pinned."""
    me pin_reader() -> i64:
        self.reader_pins = self.reader_pins + 1
        self.generation

    """Release a reader pin. An unbalanced release is refused."""
    me unpin_reader() -> Result<i64, text>:
        if self.reader_pins <= 0:
            return Err("Join-point slot table has no reader pin to release")
        self.reader_pins = self.reader_pins - 1
        Ok(self.reader_pins)

    me retired_count() -> i64:
        self.retired.len()

    """Forget retired targets. Refused while any reader is still pinned --
    a pinned reader may be mid-dispatch through a retired target."""
    me drain_retired() -> Result<i64, text>:
        if self.base == 0:
            return Err("Join-point slot table has been freed")
        if self.reader_pins > 0:
            return Err("Cannot drain retired join-point targets: {self.reader_pins} reader(s) still pinned")
        val drained = self.retired.len()
        self.retired = []
        Ok(drained)

    """Perform the join point's indirect call: atomically load the cell, call
    what it names. This is the ONLY dispatch path, so an unadvised join point
    and an advised one execute the identical instruction sequence and differ
    solely in the cell's contents. Out-of-range slots are refused rather than
    dispatched to garbage."""
    me call_through_0(slot_id: i64) -> Result<i64, text>:
        match self.dispatch_target(slot_id):
            case Ok(target):
                if target == 0:
                    return Err("Join-point slot {slot_id} holds a null target")
                var called: Result<i64, text> = Err("join-point call was not attempted")
                unsafe(capabilities: [raw_ptr]):
                    called = native_call_function_0(target)
                called
            case Err(e):
                Err(e)

    """Release the table's mapping."""
    me free() -> bool:
        if self.base == 0:
            return false
        val ok = native_free_exec_memory(self.base, self.capacity * self.geometry.pointer_width)
        if not ok:
            return false
        self.base = 0
        self.capacity = 0
        self.used = 0
        self.by_key = {}
        self.slots = {}
        self.sealed = false
        self.retired = []
        true
