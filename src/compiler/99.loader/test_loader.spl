# Standalone loader intent smoke executable. Run from the repository root.
# Covers source metadata, SMF rejection, and cache intent isolation.
# Relocation and the full loader suite require separate verification.
use compiler.loader.test_loader_cases.{
    loader_registers_source_metadata, loader_rejects_source_as_smf,
    loader_rejects_cross_intent_cache
}
use compiler.frontend.core.test_core_checks.{check_true}
use compiler.frontend.core.test_verdict.{test_exit_code}

fn main() -> i64:
    val path = "test/01_unit/compiler/loader/module_load_intent_spec.spl"
    var executed: i64 = 0
    var failed: i64 = 0

    executed = executed + 1
    failed = failed + check_true("source metadata registration", loader_registers_source_metadata(path))
    executed = executed + 1
    failed = failed + check_true("source bytes rejected as SMF", loader_rejects_source_as_smf(path))
    executed = executed + 1
    failed = failed + check_true("cache intent isolation", loader_rejects_cross_intent_cache(path))

    val passed = executed - failed
    print "=== Loader Intent Smoke ==="
    print "Results: {passed} passed, {failed} failed, {executed} executed"
    val result_code = test_exit_code(passed, failed)
    if result_code == 0:
        print "ALL TESTS PASSED"
    else:
        print "SOME TESTS FAILED OR NO TESTS EXECUTED"
    result_code
