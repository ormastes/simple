# Real loader intent cases shared by the direct executable and SSpec coverage.
use compiler.loader.module_loader_compat.{ModuleLoader, ModuleLoadIntent, LoadResult}

pub fn loader_registers_source_metadata(path: text) -> bool:
    var loader = ModuleLoader.with_defaults()
    match loader.load_with_intent(path, ModuleLoadIntent.SourceMetadata):
        case LoadResult.Success(module):
            module.path == path and loader.is_loaded(path)
        case LoadResult.AlreadyLoaded(module):
            false
        case LoadResult.Error(message):
            false

pub fn loader_rejects_source_as_smf(path: text) -> bool:
    var loader = ModuleLoader.with_defaults()
    match loader.load(path):
        case LoadResult.Success(module):
            false
        case LoadResult.AlreadyLoaded(module):
            false
        case LoadResult.Error(message):
            message.contains("invalid SMF artifact") and not loader.is_loaded(path)

pub fn loader_rejects_cross_intent_cache(path: text) -> bool:
    var loader = ModuleLoader.with_defaults()
    match loader.load_with_intent(path, ModuleLoadIntent.SourceMetadata):
        case LoadResult.Success(module):
            if module.path != path or not loader.is_loaded(path):
                return false
        case LoadResult.AlreadyLoaded(module):
            return false
        case LoadResult.Error(message):
            return false

    match loader.load(path):
        case LoadResult.Success(module):
            false
        case LoadResult.AlreadyLoaded(module):
            false
        case LoadResult.Error(message):
            message.contains("different intent") and loader.is_loaded(path)
