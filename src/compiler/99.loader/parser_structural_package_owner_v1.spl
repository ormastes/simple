pub const PARSER_STRUCTURAL_PACKAGE_MAX_V1: u64 = 256u64
pub const PARSER_STRUCTURAL_PACKAGE_MAX_INPUT_V1: u64 = 16777216u64
pub enum ParserStructuralPackageStepStatusV1:
    BlockExecutedMore
    BlocksCompleteTailPending
pub enum ParserStructuralPackageErrorV1:
    AdmissionStopped
    CapacityExceeded
    CounterOverflow
    UnknownOrStale
    BatchFailed
    Busy
    CleanupFailed
    AlreadyShutdown
    SimdAggregateUnavailable
    AuthenticationFailed
    MappingFailed
    ActivationFailed
    OperationState
    CapabilityUnavailable
    GuardedAuthorityRejected
    GuardedRangeRejected
    GuardedNativeCallFailed
    GuardedStaleGeneration
    AffinityUnavailable
    VerifierUnavailable
    V2SessionBusy
    ProviderPinsLive

pub struct ParserStructuralPackageSourceV1:
    handle: u64
    owner_identity: u64
pub struct ParserStructuralPackageSessionV1:
    handle: u64
    owner_identity: u64
pub struct ParserStructuralPackageBatchV1:
    handle: u64
    owner_identity: u64
pub struct ParserStructuralPackageActivationV1:
    handle: u64
    owner_identity: u64
pub struct ParserStructuralPackageV2SessionV1:
    handle: u64
    owner_identity: u64
