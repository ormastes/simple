    requested_simd: bool
    admitted_simd: bool
    executed_simd: bool
    classifier_only: bool
    scalar_lexical_resolution: bool
    reference_frontend_required: bool
    fallback: ParserLexicalPackageFallbackV1
    admitted_provider_identity: EnvironmentDigest256V1
    admitted_variant_identity: EnvironmentDigest256V1
    executed_provider_identity: EnvironmentDigest256V1
    executed_variant_identity: EnvironmentDigest256V1
    executed_provider_generation: u64
    native_mask_calls: u64
    operation_handle: u64
    operation_cleanup_terminal: bool
pub struct ParserLexicalPackageBatchV1:
