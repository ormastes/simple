    faulted: bool
struct _PackageOperationPendingV1:
    scopes: [ParserStructuralGuardedScopeV1]
    affinities: [ExecutionDomainAffinityLeaseV1]
    verifiers: [LiveSimdVerifierReceiptV1]

var _next_parser_package_owner_v1: u64 = 1u64
pub class ParserStructuralPackageOwnerV1:
    var generations: ProviderGenerationManagerV2
    var activations: ParserStructuralProviderActivationOwnerV2
    var mapper: ParserStructuralMapperOwnerV1
    var native_sources: ParserStructuralSourceBufferOwnerV1
    var batches: ParserStructuralMaskBatchOwnerV2
    var affinity: ExecutionDomainAffinityLeaseOwnerV1
    var scopes: ParserStructuralGuardedScopeOwnerV1
    var verifier: LiveSimdVerifierOwnerV1
    var leases: StructuralMaskLeaseOwnerV1
    var sources: [_PackageSourceRecordV1]
    var sessions: [_PackageSessionRecordV1]
    var pending: [_PackageBatchRecordV1]
    var active_providers: [_PackageActivationRecordV1]
    var v2_sessions: [_PackageV2SessionRecordV1]
    var operations: [_PackageOperationRecordV1]
    var pending_operations: [_PackageOperationPendingV1]
    var owner_identity: u64
    var next_handle: u64
    var admission_open: bool
    var shutting_down: bool
    var shutdown_complete: bool

    pub static fn create() -> ParserStructuralPackageOwnerV1:
        val identity = _next_parser_package_owner_v1
        if identity != 0u64 and identity != 0xffffffffffffffffu64:
            _next_parser_package_owner_v1 = identity + 1u64
        ParserStructuralPackageOwnerV1(generations: ProviderGenerationManagerV2.create(),
            activations: ParserStructuralProviderActivationOwnerV2.create(),
            mapper: ParserStructuralMapperOwnerV1.create(),
            native_sources: ParserStructuralSourceBufferOwnerV1.create(),
            batches: ParserStructuralMaskBatchOwnerV2.create(),
            affinity: ExecutionDomainAffinityLeaseOwnerV1.create(),
            scopes: ParserStructuralGuardedScopeOwnerV1.create(),
            verifier: LiveSimdVerifierOwnerV1.create(),
            leases: StructuralMaskLeaseOwnerV1.create(), sources: [], sessions: [], pending: [],
            active_providers: [], v2_sessions: [], operations: [], pending_operations: [],
            owner_identity: identity, next_handle: 1u64, admission_open: true,
            shutting_down: false, shutdown_complete: false)

fn _operation_po(o: ParserStructuralPackageOwnerV1, h: ParserStructuralPackageOperationV1) -> i64:
    var i = 0
    while i < o.operations.len():
        if o.operations[i].handle == h and h.owner_identity == o.owner_identity: return i
        i = i + 1
    -1

fn _read64_psa(raw: [i64], at: i64) -> u64:
    var v = 0u64
    for i in 0..8: v = v | ((raw[at + i] as u64) << ((i as u64) * 8u64))
    v
fn _source_digest_psa(bytes: [u8]) -> EnvironmentDigest256V1:
    val raw = sha256_bytes([v as i64 for v in bytes])
    EnvironmentDigest256V1(w0: _read64_psa(raw, 0), w1: _read64_psa(raw, 8),
        w2: _read64_psa(raw, 16), w3: _read64_psa(raw, 24))

pub fn parser_structural_package_v2_session_source_authority_v1(o: ParserStructuralPackageOwnerV1,
    session: ParserStructuralPackageV2SessionV1
) -> Result<ParserStructuralPackageSessionSourceAuthorityV1, ParserStructuralPackageErrorV1>:
    var si: i64 = -1; var i = 0
    while i < o.v2_sessions.len():
        if o.v2_sessions[i].handle == session and session.owner_identity == o.owner_identity and
           o.v2_sessions[i].live and o.v2_sessions[i].native_live and
           o.v2_sessions[i].stable_live and not o.v2_sessions[i].cleanup_pending: si = i
        i = i + 1
    if si < 0: return Err(ParserStructuralPackageErrorV1.UnknownOrStale)
    val sr = o.v2_sessions[si]; var ai: i64 = -1; i = 0
    while i < o.active_providers.len():
        if o.active_providers[i].handle == sr.activation and o.active_providers[i].live and
           o.active_providers[i].provider_live and o.active_providers[i].mapping_live and
           not o.active_providers[i].cleanup_pending: ai = i
        i = i + 1
    if ai < 0: return Err(ParserStructuralPackageErrorV1.UnknownOrStale)
    val active = o.active_providers[ai]
    if active.lexical_authorization.len() != 1 or
       not parser_lexical_mapping_authorization_valid_v1(active.lexical_authorization[0]) or
       active.lexical_authorization[0].structural != active.authorization:
        return Err(ParserStructuralPackageErrorV1.AuthenticationFailed)
    val copied = stable_source_buffer_range_copy_v1(o.leases, sr.stable, 0u64, sr.stable.byte_length)
    if copied.is_err(): return Err(ParserStructuralPackageErrorV1.GuardedRangeRejected)
    val a = active.authorization; val lexical = active.lexical_authorization[0]
    Ok(ParserStructuralPackageSessionSourceAuthorityV1(aggregate_owner_identity: o.owner_identity,
        session_handle: session.handle, source_snapshot_identity: sr.stable.snapshot_identity_digest,
        source_digest: _source_digest_psa(copied.unwrap()), source_length: sr.stable.byte_length,
        provider_identity: a.provider_identity, variant_identity: a.variant_identity,
        artifact_identity: a.artifact_digest, publication_generation: a.provider_generation,
        lexical_abi_identity: lexical.abi_identity,
        lexical_mask_schema_identity: lexical.mask_schema_identity,
        lexical_tail_policy_identity: lexical.tail_policy_identity))

fn _guarded_error_po(e: ParserStructuralGuardedScopeErrorV1) -> ParserStructuralPackageErrorV1:
    match e:
        case ParserStructuralGuardedScopeErrorV1.AuthorityRejected: ParserStructuralPackageErrorV1.GuardedAuthorityRejected
        case ParserStructuralGuardedScopeErrorV1.UnknownOrReplayed: ParserStructuralPackageErrorV1.GuardedStaleGeneration
        case ParserStructuralGuardedScopeErrorV1.RangeRejected: ParserStructuralPackageErrorV1.GuardedRangeRejected
        case ParserStructuralGuardedScopeErrorV1.NativeCallFailed: ParserStructuralPackageErrorV1.GuardedNativeCallFailed
        case ParserStructuralGuardedScopeErrorV1.ReleaseFailed: ParserStructuralPackageErrorV1.CleanupFailed
        case ParserStructuralGuardedScopeErrorV1.CapacityExceeded: ParserStructuralPackageErrorV1.CapacityExceeded

fn _pending_operation_cleanup_po(o: ParserStructuralPackageOwnerV1) -> bool:
    var kept: [_PackageOperationPendingV1] = []
    for original in o.pending_operations:
        var p = original; var failed = false
        if p.scopes.len() == 1:
            if parser_structural_guarded_scope_end_v1(o.scopes, o.mapper, o.generations,
                    o.native_sources, o.affinity, p.scopes[0]).is_err(): failed = true
            else: p.scopes = []
        if not failed and p.verifiers.len() == 1:
            if live_simd_verifier_revoke_v1(o.verifier, p.verifiers[0]).is_err(): failed = true
            else: p.verifiers = []
        if not failed and p.affinities.len() == 1:
            if execution_domain_affinity_lease_release_v1(o.affinity, p.affinities[0]).is_err(): failed = true
            else: p.affinities = []
        if failed: kept.push(p)
    o.pending_operations = kept
    kept.len() == 0

pub fn parser_structural_package_operation_prepare_v1(o: ParserStructuralPackageOwnerV1,
    session: ParserStructuralPackageV2SessionV1, snapshot: EnvironmentSnapshotV1,
    feature_words: [u64], offset: u64, count: u64
) -> Result<ParserStructuralPackageOperationV1, ParserStructuralPackageErrorV1>:
    if not _can_issue_po(o): return Err(ParserStructuralPackageErrorV1.AdmissionStopped)
    # A failed scope begin may own the affinity call window. Drain that owner
    # before retrying the aggregate's verifier/affinity acquisition record.
    if not _cleanup_scopes_po(o): return Err(ParserStructuralPackageErrorV1.CleanupFailed)
    if not _pending_operation_cleanup_po(o): return Err(ParserStructuralPackageErrorV1.CleanupFailed)
    if count < 32u64 or count > PARSER_STRUCTURAL_PACKAGE_MAX_INPUT_V1 or
       (count + 31u64) / 32u64 > (PARSER_STRUCTURAL_PACKAGE_MAX_INPUT_V1 + 31u64) / 32u64 or
       (o.operations.len() + o.pending_operations.len()) as u64 >= PARSER_STRUCTURAL_PACKAGE_MAX_V1:
        return Err(ParserStructuralPackageErrorV1.CapacityExceeded)
    var si: i64 = -1; var i = 0
    while i < o.v2_sessions.len():
        if o.v2_sessions[i].handle == session and session.owner_identity == o.owner_identity and
           o.v2_sessions[i].live and o.v2_sessions[i].native_live and
           o.v2_sessions[i].stable_live and not o.v2_sessions[i].cleanup_pending: si = i
        i = i + 1
    if si < 0: return Err(ParserStructuralPackageErrorV1.UnknownOrStale)
    val sr = o.v2_sessions[si]
    if offset > sr.stable.byte_length or count > sr.stable.byte_length - offset:
        return Err(ParserStructuralPackageErrorV1.UnknownOrStale)
    var ai: i64 = -1; i = 0
    while i < o.active_providers.len():
        if o.active_providers[i].handle == sr.activation and o.active_providers[i].live and
           o.active_providers[i].provider_live and o.active_providers[i].mapping_live and
           not o.active_providers[i].cleanup_pending: ai = i
        i = i + 1
    if ai < 0: return Err(ParserStructuralPackageErrorV1.UnknownOrStale)
    o.pending_operations.push(_PackageOperationPendingV1(scopes: [], affinities: [], verifiers: []))
    val pi = o.pending_operations.len() - 1
    val affinity = match execution_domain_affinity_lease_acquire_v1(o.affinity, snapshot):
        case Ok(v): v
        case Err(_):
            o.pending_operations = []
            return Err(ParserStructuralPackageErrorV1.AffinityUnavailable)
    o.pending_operations[pi].affinities = [affinity]
    val verifier = match live_simd_verifier_issue_v1(o.verifier, o.affinity, affinity, snapshot, feature_words):
        case Ok(v): v
        case Err(_):
            if not _pending_operation_cleanup_po(o): return Err(ParserStructuralPackageErrorV1.CleanupFailed)
            return Err(ParserStructuralPackageErrorV1.VerifierUnavailable)
    o.pending_operations[pi].verifiers = [verifier]
    val ar = o.active_providers[ai]
    val capability = match parser_simd_execution_capability_issue_verified_v1(o.verifier,
            verifier, snapshot, feature_words, ar.authorization, o.affinity, affinity):
        case Ok(v): v
        case Err(_):
            if not _pending_operation_cleanup_po(o): return Err(ParserStructuralPackageErrorV1.CleanupFailed)
            return Err(ParserStructuralPackageErrorV1.VerifierUnavailable)
    val scope = match parser_structural_guarded_scope_begin_v1(o.scopes, o.mapper, ar.mapped,
            o.generations, o.activations, ar.activation, o.native_sources, sr.native,
            o.affinity, affinity, snapshot, feature_words, ar.authorization, capability):
        case Ok(v): v
        case Err(e):
            if not _pending_operation_cleanup_po(o): return Err(ParserStructuralPackageErrorV1.CleanupFailed)
            return Err(_guarded_error_po(e))
    o.pending_operations[pi].scopes = [scope]
    val h = ParserStructuralPackageOperationV1(handle: o.next_handle, owner_identity: o.owner_identity)
    o.next_handle = o.next_handle + 1u64
    val authority = match parser_structural_guarded_scope_execution_authority_v1(o.scopes, scope):
        case Ok(v): v
        case Err(_):
            if not _pending_operation_cleanup_po(o): return Err(ParserStructuralPackageErrorV1.CleanupFailed)
            return Err(ParserStructuralPackageErrorV1.CapabilityUnavailable)
    o.operations.push(_PackageOperationRecordV1(handle: h, session: session, scope: scope,
        affinity: affinity, verifier_receipt: verifier, snapshot: snapshot,
        feature_words: feature_words, offset: offset, count: count, next_block: 0u64,
        masks: [], positions: [], tail_finished: false, live: true, authority: authority,
        scope_live: true, verifier_live: true, affinity_live: true,
        cleanup_pending: false, committed_result: [], faulted: false))
    o.pending_operations = []; Ok(h)

pub fn parser_structural_package_operation_execute_next_v1(o: ParserStructuralPackageOwnerV1,
    operation: ParserStructuralPackageOperationV1
) -> Result<ParserStructuralPackageStepStatusV1, ParserStructuralPackageErrorV1>:
    val oi = _operation_po(o, operation)
    if oi < 0 or not o.operations[oi].live or o.operations[oi].cleanup_pending or
       o.operations[oi].tail_finished: return Err(ParserStructuralPackageErrorV1.OperationState)
    var op = o.operations[oi]; val blocks = op.count / 32u64
    if op.faulted: return Err(ParserStructuralPackageErrorV1.OperationState)
    if op.next_block >= blocks: return Ok(ParserStructuralPackageStepStatusV1.BlocksCompleteTailPending)
    var si: i64 = -1; var i = 0
    while i < o.v2_sessions.len():
        if o.v2_sessions[i].handle == op.session and o.v2_sessions[i].live and
           o.v2_sessions[i].native_live and o.v2_sessions[i].stable_live and
           not o.v2_sessions[i].cleanup_pending: si = i
        i = i + 1
    if si < 0: return Err(ParserStructuralPackageErrorV1.UnknownOrStale)
    val sr = o.v2_sessions[si]
    val mask = match parser_structural_guarded_scope_call_block_v1(o.scopes, o.mapper,
            o.native_sources, op.scope, op.offset + op.next_block * 32u64, sr.first, sr.second):
        case Ok(v): v
        case Err(e):
            op.faulted = true; o.operations[oi] = op
            return Err(_guarded_error_po(e))
    val authority = match parser_structural_guarded_scope_execution_authority_v1(o.scopes, op.scope):
        case Ok(v): v
        case Err(_):
            op.faulted = true; o.operations[oi] = op
            return Err(ParserStructuralPackageErrorV1.GuardedStaleGeneration)
    if authority.provider_handle != op.authority.provider_handle or
       authority.provider_generation != op.authority.provider_generation or
       authority.provider_identity != op.authority.provider_identity or
       authority.variant_identity != op.authority.variant_identity or
       authority.artifact_identity != op.authority.artifact_identity or
       authority.plan_identity != op.authority.plan_identity or
       authority.environment_identity != op.authority.environment_identity or
       authority.environment_generation != op.authority.environment_generation or
       authority.execution_count != op.authority.execution_count + 1u64 or
       authority.last_offset != op.offset + op.next_block * 32u64 or authority.last_mask != mask:
        op.faulted = true; o.operations[oi] = op
        return Err(ParserStructuralPackageErrorV1.GuardedAuthorityRejected)
    op.authority = authority
    op.masks.push(mask); var bit = 0u64
    while bit < 32u64:
        if (mask & (1u32 << (bit as u32))) != 0u32: op.positions.push(op.offset + op.next_block * 32u64 + bit)
        bit = bit + 1u64
    op.next_block = op.next_block + 1u64; o.operations[oi] = op
    if op.next_block < blocks: Ok(ParserStructuralPackageStepStatusV1.BlockExecutedMore)
    else: Ok(ParserStructuralPackageStepStatusV1.BlocksCompleteTailPending)

pub fn parser_structural_package_operation_finish_tail_v1(o: ParserStructuralPackageOwnerV1,
    operation: ParserStructuralPackageOperationV1) -> Result<(), ParserStructuralPackageErrorV1>:
    val oi = _operation_po(o, operation)
    if oi < 0 or not o.operations[oi].live or o.operations[oi].cleanup_pending or o.operations[oi].faulted:
        return Err(ParserStructuralPackageErrorV1.OperationState)
    var op = o.operations[oi]; val blocks = op.count / 32u64
    if op.next_block != blocks or op.tail_finished: return Err(ParserStructuralPackageErrorV1.OperationState)
    val current_authority = parser_structural_guarded_scope_execution_authority_v1(o.scopes, op.scope)
    if current_authority.is_err() or current_authority.unwrap() != op.authority:
        return Err(ParserStructuralPackageErrorV1.UnknownOrStale)
    var si: i64 = -1; var i = 0
    while i < o.v2_sessions.len():
        if o.v2_sessions[i].handle == op.session and o.v2_sessions[i].live: si = i
        i = i + 1
    if si < 0: return Err(ParserStructuralPackageErrorV1.UnknownOrStale)
    val tail = op.count % 32u64
    if tail > 0u64:
        val copied = stable_source_buffer_range_copy_v1(o.leases, o.v2_sessions[si].stable,
            op.offset + blocks * 32u64, tail)
        if copied.is_err(): return Err(ParserStructuralPackageErrorV1.GuardedRangeRejected)
        val mask = match parser_structural_mask_scalar_v1(copied.unwrap(), 0, tail as i64,
                o.v2_sessions[si].first, o.v2_sessions[si].second):
            case Ok(v): v
            case Err(_): return Err(ParserStructuralPackageErrorV1.GuardedRangeRejected)
        op.masks.push(mask); var bit = 0u64
        while bit < tail:
            if (mask & (1u32 << (bit as u32))) != 0u32: op.positions.push(op.offset + blocks * 32u64 + bit)
            bit = bit + 1u64
    op.tail_finished = true; o.operations[oi] = op; Ok(())

fn _operation_cleanup_po(o: ParserStructuralPackageOwnerV1, oi: i64) -> bool:
    var op = o.operations[oi]; op.cleanup_pending = true; o.operations[oi] = op
    if op.scope_live:
        if parser_structural_guarded_scope_end_v1(o.scopes, o.mapper, o.generations,
                o.native_sources, o.affinity, op.scope).is_err(): return false
        op.scope_live = false; o.operations[oi] = op
    if op.verifier_live:
        if live_simd_verifier_revoke_v1(o.verifier, op.verifier_receipt).is_err(): return false
        op.verifier_live = false; o.operations[oi] = op
    if op.affinity_live:
        if execution_domain_affinity_lease_release_v1(o.affinity, op.affinity).is_err(): return false
        op.affinity_live = false; o.operations[oi] = op
    var kept: [_PackageOperationRecordV1] = []; var i = 0
    while i < o.operations.len():
        if i != oi: kept.push(o.operations[i])
        i = i + 1
    o.operations = kept; true

pub fn parser_structural_package_operation_commit_v1(o: ParserStructuralPackageOwnerV1,
    operation: ParserStructuralPackageOperationV1
) -> Result<ParserStructuralMaskBatchResultV2, ParserStructuralPackageErrorV1>:
    val oi = _operation_po(o, operation)
    if oi < 0 or not o.operations[oi].live or not o.operations[oi].tail_finished:
        return Err(ParserStructuralPackageErrorV1.OperationState)
    var op = o.operations[oi]
    if op.cleanup_pending:
        if op.committed_result.len() != 1: return Err(ParserStructuralPackageErrorV1.OperationState)
        val retry_result = op.committed_result[0]
        if not _operation_cleanup_po(o, oi): return Err(ParserStructuralPackageErrorV1.CleanupFailed)
        return Ok(retry_result)
    var si: i64 = -1; var i = 0
    while i < o.v2_sessions.len():
        if o.v2_sessions[i].handle == op.session and o.v2_sessions[i].live: si = i
        i = i + 1
    if si < 0: return Err(ParserStructuralPackageErrorV1.UnknownOrStale)
    val sr = o.v2_sessions[si]; var ai: i64 = -1; i = 0
    while i < o.active_providers.len():
        if o.active_providers[i].handle == sr.activation and o.active_providers[i].live and
           o.active_providers[i].provider_live and o.active_providers[i].mapping_live and
           not o.active_providers[i].cleanup_pending: ai = i
        i = i + 1
    if ai < 0: return Err(ParserStructuralPackageErrorV1.UnknownOrStale)
    val ar = o.active_providers[ai]
    val result = ParserStructuralMaskBatchResultV2(session_id: sr.handle.handle,
        offset: op.offset, count: op.count, masks: op.masks, positions: op.positions,
        executed_provider: op.authority.execution_count > 0u64,
        provider_identity: op.authority.provider_identity,
        variant_identity: op.authority.variant_identity, artifact_identity: op.authority.artifact_identity,
        plan_identity: op.authority.plan_identity, environment_identity: op.authority.environment_identity,
        environment_generation: op.authority.environment_generation,
        provider_generation: op.authority.provider_generation)
    if op.authority.execution_count != op.count / 32u64 or
       not parser_structural_mask_batch_result_valid_v2(result):
        return Err(ParserStructuralPackageErrorV1.BatchFailed)
    op.committed_result = [result]; o.operations[oi] = op
    if not _operation_cleanup_po(o, oi): return Err(ParserStructuralPackageErrorV1.CleanupFailed)
    Ok(result)

pub fn parser_structural_package_operation_cancel_v1(o: ParserStructuralPackageOwnerV1,
    operation: ParserStructuralPackageOperationV1) -> Result<(), ParserStructuralPackageErrorV1>:
    val oi = _operation_po(o, operation)
    if oi < 0: return Err(ParserStructuralPackageErrorV1.UnknownOrStale)
    if not _operation_cleanup_po(o, oi): return Err(ParserStructuralPackageErrorV1.CleanupFailed)
    Ok(())

pub fn parser_structural_package_activate_v1(o: ParserStructuralPackageOwnerV1,
    publication: EnvironmentCompositePublicationV1, lifecycle: EnvironmentVariantReceiptV1,
    artifact_bytes: [i64]
) -> Result<ParserStructuralPackageActivationV1, ParserStructuralPackageErrorV1>:
    if not _can_issue_po(o): return Err(ParserStructuralPackageErrorV1.AdmissionStopped)
    if o.active_providers.len() as u64 >= PARSER_STRUCTURAL_PACKAGE_MAX_V1: return Err(ParserStructuralPackageErrorV1.CapacityExceeded)
    val authorization = match parser_structural_mapping_authorize_v1(publication, lifecycle, artifact_bytes):
        case Ok(v): v
        case Err(_): return Err(ParserStructuralPackageErrorV1.AuthenticationFailed)
    val mapped = match parser_structural_mapper_map_v1(o.mapper, publication, lifecycle,
            authorization, artifact_bytes):
        case Ok(v): v
        case Err(_): return Err(ParserStructuralPackageErrorV1.MappingFailed)
    val activation = match parser_structural_provider_activate_v2(o.activations, o.generations,
            o.mapper, publication, authorization, mapped):
        case Ok(v): v
        case Err(_):
            if parser_structural_mapper_close_v1(o.mapper, mapped).is_err(): return Err(ParserStructuralPackageErrorV1.CleanupFailed)
            return Err(ParserStructuralPackageErrorV1.ActivationFailed)
    val h = ParserStructuralPackageActivationV1(handle: o.next_handle, owner_identity: o.owner_identity)
    o.next_handle = o.next_handle + 1u64
    o.active_providers.push(_PackageActivationRecordV1(handle: h, authorization: authorization,
        mapped: mapped, activation: activation, lexical_authorization: [], live: true, provider_live: true,
        mapping_live: true, cleanup_pending: false)); Ok(h)

pub fn parser_structural_package_lexical_activate_v1(o: ParserStructuralPackageOwnerV1,
    publication: EnvironmentCompositePublicationV1, lifecycle: EnvironmentVariantReceiptV1,
    artifact_bytes: [i64]
) -> Result<ParserStructuralPackageActivationV1, ParserStructuralPackageErrorV1>:
    if not _can_issue_po(o): return Err(ParserStructuralPackageErrorV1.AdmissionStopped)
    if o.active_providers.len() as u64 >= PARSER_STRUCTURAL_PACKAGE_MAX_V1:
        return Err(ParserStructuralPackageErrorV1.CapacityExceeded)
    val lexical = match parser_lexical_mapping_authorize_v1(publication, lifecycle, artifact_bytes):
        case Ok(v): v
        case Err(_): return Err(ParserStructuralPackageErrorV1.AuthenticationFailed)
    val mapped = match parser_lexical_mapper_map_v1(o.mapper, publication, lifecycle, lexical, artifact_bytes):
        case Ok(v): v
        case Err(_): return Err(ParserStructuralPackageErrorV1.MappingFailed)
    val activation = match parser_structural_provider_activate_v2(o.activations, o.generations,
            o.mapper, publication, lexical.structural, mapped):
        case Ok(v): v
        case Err(_):
            if parser_structural_mapper_close_v1(o.mapper, mapped).is_err():
                return Err(ParserStructuralPackageErrorV1.CleanupFailed)
            return Err(ParserStructuralPackageErrorV1.ActivationFailed)
    val h = ParserStructuralPackageActivationV1(handle: o.next_handle, owner_identity: o.owner_identity)
    o.next_handle = o.next_handle + 1u64
    o.active_providers.push(_PackageActivationRecordV1(handle: h, authorization: lexical.structural,
        mapped: mapped, activation: activation, lexical_authorization: [lexical], live: true,
        provider_live: true, mapping_live: true, cleanup_pending: false)); Ok(h)

pub fn parser_structural_package_v2_source_session_v1(o: ParserStructuralPackageOwnerV1,
    activation: ParserStructuralPackageActivationV1, snapshot_identity: u64, bytes: [u8],
    first: u8, second: u8
) -> Result<ParserStructuralPackageV2SessionV1, ParserStructuralPackageErrorV1>:
    if not _can_issue_po(o): return Err(ParserStructuralPackageErrorV1.AdmissionStopped)
    var ai: i64 = -1; var i = 0
    while i < o.active_providers.len():
        if o.active_providers[i].handle == activation and activation.owner_identity == o.owner_identity and o.active_providers[i].live: ai = i
        i = i + 1
    if ai < 0: return Err(ParserStructuralPackageErrorV1.UnknownOrStale)
    val stable = match stable_source_buffer_lease_create_v1(o.leases, snapshot_identity, bytes, 0u32):
        case Ok(v): v
        case Err(_): return Err(ParserStructuralPackageErrorV1.CleanupFailed)
    val transfer = match stable_source_buffer_transfer_issue_v1(o.leases, stable):
        case Ok(v): v
        case Err(_):
            _ = stable_source_buffer_lease_release_v1(o.leases, stable)
            return Err(ParserStructuralPackageErrorV1.CleanupFailed)
    val native = match parser_structural_source_buffer_map_v1(o.native_sources, o.leases, transfer):
        case Ok(v): v
        case Err(_):
            _ = stable_source_buffer_lease_release_v1(o.leases, stable)
            return Err(ParserStructuralPackageErrorV1.MappingFailed)
    val h = ParserStructuralPackageV2SessionV1(handle: o.next_handle, owner_identity: o.owner_identity)
    o.next_handle = o.next_handle + 1u64
    o.v2_sessions.push(_PackageV2SessionRecordV1(handle: h, activation: activation,
        stable: stable, native: native, first: first, second: second, live: true,
        native_live: true, stable_live: true, cleanup_pending: false)); Ok(h)

pub fn parser_structural_package_v2_session_close_v1(o: ParserStructuralPackageOwnerV1,
    session: ParserStructuralPackageV2SessionV1) -> Result<(), ParserStructuralPackageErrorV1>:
    var i: i64 = -1; var n = 0
    while n < o.v2_sessions.len():
        if o.v2_sessions[n].handle == session and session.owner_identity == o.owner_identity: i = n
        n = n + 1
    if i < 0 or not o.v2_sessions[i].live: return Err(ParserStructuralPackageErrorV1.UnknownOrStale)
    var r = o.v2_sessions[i]; r.cleanup_pending = true; o.v2_sessions[i] = r
    if r.native_live:
        if parser_structural_source_buffer_close_v1(o.native_sources, r.native).is_err():
            return Err(ParserStructuralPackageErrorV1.V2SessionBusy)
        r.native_live = false; o.v2_sessions[i] = r
    if r.stable_live:
        if stable_source_buffer_lease_release_v1(o.leases, r.stable) != STRUCTURAL_MASK_LEASE_OK_V1:
            return Err(ParserStructuralPackageErrorV1.CleanupFailed)
        r.stable_live = false; o.v2_sessions[i] = r
    var kept: [_PackageV2SessionRecordV1] = []; n = 0
    while n < o.v2_sessions.len():
        if n != i: kept.push(o.v2_sessions[n])
        n = n + 1
    o.v2_sessions = kept; Ok(())

pub fn parser_structural_package_activation_retire_v1(o: ParserStructuralPackageOwnerV1,
    activation: ParserStructuralPackageActivationV1) -> Result<(), ParserStructuralPackageErrorV1>:
    var i: i64 = -1; var n = 0
    while n < o.active_providers.len():
        if o.active_providers[n].handle == activation and activation.owner_identity == o.owner_identity: i = n
        n = n + 1
    if i < 0 or not o.active_providers[i].live: return Err(ParserStructuralPackageErrorV1.UnknownOrStale)
    for s in o.v2_sessions:
        if s.live and s.activation == activation: return Err(ParserStructuralPackageErrorV1.V2SessionBusy)
    var r = o.active_providers[i]; r.cleanup_pending = true; o.active_providers[i] = r
    if r.provider_live:
        if parser_structural_provider_retire_v2(o.activations, o.generations, o.mapper, r.activation).is_err():
            return Err(ParserStructuralPackageErrorV1.ProviderPinsLive)
        r.provider_live = false; o.active_providers[i] = r
    if r.mapping_live:
        if parser_structural_mapper_close_v1(o.mapper, r.mapped).is_err(): return Err(ParserStructuralPackageErrorV1.CleanupFailed)
        r.mapping_live = false; o.active_providers[i] = r
    var kept: [_PackageActivationRecordV1] = []; n = 0
    while n < o.active_providers.len():
        if n != i: kept.push(o.active_providers[n])
        n = n + 1
    o.active_providers = kept; Ok(())

fn _can_issue_po(o: ParserStructuralPackageOwnerV1) -> bool:
    o.admission_open and not o.shutting_down and not o.shutdown_complete and
    o.owner_identity != 0u64 and o.owner_identity != 0xffffffffffffffffu64 and
    o.next_handle != 0u64 and o.next_handle != 0xffffffffffffffffu64
fn _cleanup_scopes_po(o: ParserStructuralPackageOwnerV1) -> bool:
    parser_structural_guarded_scope_cleanup_pending_v1(o.scopes, o.mapper,
        o.generations, o.native_sources, o.affinity).is_ok()
fn _source_po(o: ParserStructuralPackageOwnerV1, h: ParserStructuralPackageSourceV1) -> i64:
    var i = 0
    while i < o.sources.len():
        if o.sources[i].handle == h and h.owner_identity == o.owner_identity: return i
        i = i + 1
    -1
fn _session_po(o: ParserStructuralPackageOwnerV1, h: ParserStructuralPackageSessionV1) -> i64:
    var i = 0
    while i < o.sessions.len():
        if o.sessions[i].handle == h and h.owner_identity == o.owner_identity: return i
        i = i + 1
    -1
fn _batch_po(o: ParserStructuralPackageOwnerV1, h: ParserStructuralPackageBatchV1) -> i64:
    var i = 0
    while i < o.pending.len():
        if o.pending[i].handle == h and h.owner_identity == o.owner_identity: return i
        i = i + 1
    -1

pub fn parser_structural_package_source_create_v1(o: ParserStructuralPackageOwnerV1,
    snapshot_identity: u64, bytes: [u8]) -> Result<ParserStructuralPackageSourceV1, ParserStructuralPackageErrorV1>:
    if not _can_issue_po(o): return Err(ParserStructuralPackageErrorV1.AdmissionStopped)
    if not _cleanup_scopes_po(o): return Err(ParserStructuralPackageErrorV1.CleanupFailed)
    if o.sources.len() as u64 >= PARSER_STRUCTURAL_PACKAGE_MAX_V1: return Err(ParserStructuralPackageErrorV1.CapacityExceeded)
    val lease = match stable_source_buffer_lease_create_v1(o.leases, snapshot_identity, bytes, 0u32):
        case Ok(v): v
        case Err(_): return Err(ParserStructuralPackageErrorV1.CleanupFailed)
    val h = ParserStructuralPackageSourceV1(handle: o.next_handle, owner_identity: o.owner_identity)
    o.next_handle = o.next_handle + 1u64
    o.sources.push(_PackageSourceRecordV1(handle: h, lease: lease, live: true)); Ok(h)

pub fn parser_structural_package_scalar_session_v1(o: ParserStructuralPackageOwnerV1,
    source: ParserStructuralPackageSourceV1, first: u8, second: u8
) -> Result<ParserStructuralPackageSessionV1, ParserStructuralPackageErrorV1>:
    if not _can_issue_po(o): return Err(ParserStructuralPackageErrorV1.AdmissionStopped)
    val si = _source_po(o, source)
    if si < 0 or not o.sources[si].live: return Err(ParserStructuralPackageErrorV1.UnknownOrStale)
    val session = match structural_mask_scalar_session_create_v1(o.leases, o.sources[si].lease, first, second):
        case Ok(v): v
        case Err(_): return Err(ParserStructuralPackageErrorV1.CleanupFailed)
    val h = ParserStructuralPackageSessionV1(handle: o.next_handle, owner_identity: o.owner_identity)
    o.next_handle = o.next_handle + 1u64
    o.sessions.push(_PackageSessionRecordV1(handle: h, session: session,
        source: o.sources[si].lease, live: true)); Ok(h)

pub fn parser_structural_package_scalar_batch_v1(o: ParserStructuralPackageOwnerV1,
    session: ParserStructuralPackageSessionV1, offset: u64, count: u64
) -> Result<ParserStructuralPackageBatchV1, ParserStructuralPackageErrorV1>:
    if not _can_issue_po(o): return Err(ParserStructuralPackageErrorV1.AdmissionStopped)
    val si = _session_po(o, session)
    if si < 0 or not o.sessions[si].live: return Err(ParserStructuralPackageErrorV1.UnknownOrStale)
    val token = match parser_structural_mask_batch_stage_scalar_v2(o.batches, o.leases,
            o.sessions[si].session, o.sessions[si].source, offset, count):
        case Ok(v): v
        case Err(_): return Err(ParserStructuralPackageErrorV1.BatchFailed)
    val h = ParserStructuralPackageBatchV1(handle: o.next_handle, owner_identity: o.owner_identity)
    o.next_handle = o.next_handle + 1u64
    o.pending.push(_PackageBatchRecordV1(handle: h, token: token,
        session: o.sessions[si].session, source: o.sessions[si].source, live: true)); Ok(h)

pub fn parser_structural_package_commit_v1(o: ParserStructuralPackageOwnerV1,
    batch: ParserStructuralPackageBatchV1
) -> Result<ParserStructuralMaskBatchResultV2, ParserStructuralPackageErrorV1>:
    val bi = _batch_po(o, batch)
    if bi < 0 or not o.pending[bi].live: return Err(ParserStructuralPackageErrorV1.UnknownOrStale)
    val r = match parser_structural_mask_batch_commit_v2(o.batches, o.leases,
            o.pending[bi].token, o.pending[bi].session, o.pending[bi].source):
        case Ok(v): v
        case Err(_): return Err(ParserStructuralPackageErrorV1.BatchFailed)
    var kept: [_PackageBatchRecordV1] = []; var i = 0
    while i < o.pending.len():
        if i != bi: kept.push(o.pending[i])
        i = i + 1
    o.pending = kept; Ok(r)

pub fn parser_structural_package_cancel_v1(o: ParserStructuralPackageOwnerV1,
    batch: ParserStructuralPackageBatchV1) -> Result<(), ParserStructuralPackageErrorV1>:
    val bi = _batch_po(o, batch)
    if bi < 0 or not o.pending[bi].live: return Err(ParserStructuralPackageErrorV1.UnknownOrStale)
    if not parser_structural_mask_batch_cancel_v2(o.batches, o.pending[bi].token):
        return Err(ParserStructuralPackageErrorV1.CleanupFailed)
    var kept: [_PackageBatchRecordV1] = []; var i = 0
    while i < o.pending.len():
        if i != bi: kept.push(o.pending[i])
        i = i + 1
    o.pending = kept; Ok(())

pub fn parser_structural_package_begin_shutdown_v1(o: ParserStructuralPackageOwnerV1) -> Result<(), ParserStructuralPackageErrorV1>:
    if o.shutdown_complete: return Err(ParserStructuralPackageErrorV1.AlreadyShutdown)
    o.admission_open = false; o.shutting_down = true
    if not _cleanup_scopes_po(o): return Err(ParserStructuralPackageErrorV1.CleanupFailed)
    if not _pending_operation_cleanup_po(o): return Err(ParserStructuralPackageErrorV1.CleanupFailed)
    while o.operations.len() > 0:
        if not _operation_cleanup_po(o, 0): return Err(ParserStructuralPackageErrorV1.CleanupFailed)
    var i = 0
    while i < o.pending.len():
        if o.pending[i].live:
            if not parser_structural_mask_batch_cancel_v2(o.batches, o.pending[i].token):
                return Err(ParserStructuralPackageErrorV1.CleanupFailed)
            var b = o.pending[i]; b.live = false; o.pending[i] = b
        i = i + 1
    o.pending = []
    while o.v2_sessions.len() > 0:
        val h = o.v2_sessions[0].handle
        if parser_structural_package_v2_session_close_v1(o, h).is_err():
            return Err(ParserStructuralPackageErrorV1.CleanupFailed)
    while o.active_providers.len() > 0:
        val h = o.active_providers[0].handle
        if parser_structural_package_activation_retire_v1(o, h).is_err():
            return Err(ParserStructuralPackageErrorV1.CleanupFailed)
    Ok(())

pub fn parser_structural_package_finalize_shutdown_v1(o: ParserStructuralPackageOwnerV1) -> Result<(), ParserStructuralPackageErrorV1>:
    if not o.shutting_down or o.shutdown_complete: return Err(ParserStructuralPackageErrorV1.AlreadyShutdown)
    if not _cleanup_scopes_po(o): return Err(ParserStructuralPackageErrorV1.CleanupFailed)
    # Scalar lifecycle is complete here. SIMD activations/mappings/affinity are
    # fail-closed until their aggregate creation API is admitted.
    var i = 0
    while i < o.sessions.len():
        if o.sessions[i].live:
            if structural_mask_session_release_v1(o.leases, o.sessions[i].session) != STRUCTURAL_MASK_LEASE_OK_V1:
                return Err(ParserStructuralPackageErrorV1.CleanupFailed)
            var s = o.sessions[i]; s.live = false; o.sessions[i] = s
        i = i + 1
    i = 0
    while i < o.sources.len():
        if o.sources[i].live:
            if stable_source_buffer_lease_release_v1(o.leases, o.sources[i].lease) != STRUCTURAL_MASK_LEASE_OK_V1:
                return Err(ParserStructuralPackageErrorV1.CleanupFailed)
            var s = o.sources[i]; s.live = false; o.sources[i] = s
        i = i + 1
    o.sessions = []; o.sources = []
    if o.operations.len() != 0 or o.pending_operations.len() != 0 or
       o.v2_sessions.len() != 0 or o.active_providers.len() != 0 or o.pending.len() != 0:
        return Err(ParserStructuralPackageErrorV1.CleanupFailed)
    o.shutdown_complete = true; Ok(())

fn _zero_digest_lex_po() -> EnvironmentDigest256V1:
    EnvironmentDigest256V1(w0: 0u64, w1: 0u64, w2: 0u64, w3: 0u64)

fn _same_digest_lex_po(a: EnvironmentDigest256V1, b: EnvironmentDigest256V1) -> bool:
    a.w0 == b.w0 and a.w1 == b.w1 and a.w2 == b.w2 and a.w3 == b.w3

fn _lexical_masks_equal_po(a: ParserLexicalCandidateMasksV1,
                            b: ParserLexicalCandidateMasksV1) -> bool:
    a.single_quote == b.single_quote and a.double_quote == b.double_quote and
    a.backslash == b.backslash and a.hash == b.hash and a.newline == b.newline and
    a.slash == b.slash and a.star == b.star and a.braces == b.braces and
    a.structural_delimiters == b.structural_delimiters

fn _lexical_scalar_blocks_po(o: ParserStructuralPackageOwnerV1,
    stable: StableSourceBufferLeaseV1, offset: u64, count: u64,
    input_state: LexicalBlockStateV1
) -> Result<ParserLexicalPackageBatchV1, ParserStructuralPackageErrorV1>:
    var candidates: [ParserLexicalCandidateMasksV1] = []
    var summaries: [LexicalBlockSummaryV1] = []
    var state = input_state; var at = 0u64
    while at < count:
        val copied = stable_source_buffer_range_copy_v1(o.leases, stable, offset + at, 32u64)
        if copied.is_err(): return Err(ParserStructuralPackageErrorV1.GuardedRangeRejected)
        val masks = parser_lexical_candidate_masks_scalar_v1(copied.unwrap())
        if masks.is_err(): return Err(ParserStructuralPackageErrorV1.GuardedRangeRejected)
        val summary = lexical_block_summary_scalar_v1(copied.unwrap(), state)
        if summary.is_err(): return Err(ParserStructuralPackageErrorV1.BatchFailed)
        candidates.push(masks.unwrap()); summaries.push(summary.unwrap())
        state = summary.unwrap().output_state; at = at + 32u64
    Ok(ParserLexicalPackageBatchV1(offset: offset, count: count,
        candidate_masks: candidates, summaries: summaries, output_state: state,
        receipt: ParserLexicalPackageReceiptV1(requested_simd: false,
            admitted_simd: false, executed_simd: false, classifier_only: true,
            scalar_lexical_resolution: true, reference_frontend_required: true,
            fallback: ParserLexicalPackageFallbackV1.None,
            admitted_provider_identity: _zero_digest_lex_po(),
            admitted_variant_identity: _zero_digest_lex_po(),
            executed_provider_identity: _zero_digest_lex_po(),
            executed_variant_identity: _zero_digest_lex_po(),
            executed_provider_generation: 0u64, native_mask_calls: 0u64,
            operation_handle: 0u64, operation_cleanup_terminal: false)))

# Exact-block lexical candidate batch. SIMD supplies raw byte masks only; the
# canonical scalar lexical state machine remains the sole resolver. The sealed
# owner keeps mappings, source pointers, affinity windows, and V2 pins private.
pub fn parser_structural_package_lexical_batch_v1(o: ParserStructuralPackageOwnerV1,
    session: ParserStructuralPackageV2SessionV1, snapshot: EnvironmentSnapshotV1,
    feature_words: [u64], offset: u64, count: u64, input_state: LexicalBlockStateV1,
    policy: ParserLexicalPackagePolicyV1
) -> Result<ParserLexicalPackageBatchV1, ParserStructuralPackageErrorV1>:
    if count == 0u64 or count % 32u64 != 0u64 or count > PARSER_STRUCTURAL_PACKAGE_MAX_INPUT_V1:
        return Err(ParserStructuralPackageErrorV1.GuardedRangeRejected)
    var si: i64 = -1; var i = 0
    while i < o.v2_sessions.len():
        if o.v2_sessions[i].handle == session and session.owner_identity == o.owner_identity and
           o.v2_sessions[i].live and not o.v2_sessions[i].cleanup_pending: si = i
        i = i + 1
    if si < 0: return Err(ParserStructuralPackageErrorV1.UnknownOrStale)
    val sr = o.v2_sessions[si]
    if offset > sr.stable.byte_length or count > sr.stable.byte_length - offset:
        return Err(ParserStructuralPackageErrorV1.GuardedRangeRejected)
    var ai: i64 = -1; i = 0
    while i < o.active_providers.len():
        if o.active_providers[i].handle == sr.activation and o.active_providers[i].live and
           not o.active_providers[i].cleanup_pending: ai = i
        i = i + 1
    if ai < 0: return Err(ParserStructuralPackageErrorV1.UnknownOrStale)
    val ar = o.active_providers[ai]
    val admitted = ar.lexical_authorization.len() == 1 and
        parser_lexical_mapping_authorization_valid_v1(ar.lexical_authorization[0]) and
        ar.lexical_authorization[0].structural == ar.authorization
    if policy == ParserLexicalPackagePolicyV1.Reference:
        var reference = _lexical_scalar_blocks_po(o, sr.stable, offset, count, input_state)?
        reference.receipt.admitted_simd = admitted
        if admitted:
            reference.receipt.admitted_provider_identity = ar.authorization.provider_identity
            reference.receipt.admitted_variant_identity = ar.authorization.variant_identity
        return Ok(reference)
    if not admitted:
        if policy == ParserLexicalPackagePolicyV1.RequireSimd:
            return Err(ParserStructuralPackageErrorV1.AuthenticationFailed)
        var fallback = _lexical_scalar_blocks_po(o, sr.stable, offset, count, input_state)?
        fallback.receipt.requested_simd = true
        fallback.receipt.fallback = ParserLexicalPackageFallbackV1.ProviderNotAdmitted
        return Ok(fallback)
    val prepared = parser_structural_package_operation_prepare_v1(o, session, snapshot,
        feature_words, offset, count)
    if prepared.is_err():
        if policy == ParserLexicalPackagePolicyV1.RequireSimd: return Err(prepared.unwrap_err())
        var fallback = _lexical_scalar_blocks_po(o, sr.stable, offset, count, input_state)?
        fallback.receipt.requested_simd = true; fallback.receipt.admitted_simd = true
        fallback.receipt.fallback = ParserLexicalPackageFallbackV1.CapabilityUnavailable
        fallback.receipt.admitted_provider_identity = ar.authorization.provider_identity
        fallback.receipt.admitted_variant_identity = ar.authorization.variant_identity
        return Ok(fallback)
    val op_handle = prepared.unwrap(); val oi = _operation_po(o, op_handle)
    if oi < 0: return Err(ParserStructuralPackageErrorV1.OperationState)
    var candidates: [ParserLexicalCandidateMasksV1] = []
    var summaries: [LexicalBlockSummaryV1] = []
    var state = input_state; var at = 0u64; var failed = false
    while at < count and not failed:
        val masks = parser_structural_guarded_scope_lexical_masks_v1(o.scopes, o.mapper,
            o.native_sources, o.operations[oi].scope, ar.lexical_authorization[0], offset + at)
        if masks.is_err(): failed = true
        else:
            val copied = stable_source_buffer_range_copy_v1(o.leases, sr.stable, offset + at, 32u64)
            if copied.is_err(): failed = true
            else:
                val oracle = parser_lexical_candidate_masks_scalar_v1(copied.unwrap())
                val summary = lexical_block_summary_scalar_v1(copied.unwrap(), state)
                if oracle.is_err() or summary.is_err() or not _lexical_masks_equal_po(masks.unwrap(), oracle.unwrap()):
                    failed = true
                else:
                    candidates.push(masks.unwrap()); summaries.push(summary.unwrap())
                    state = summary.unwrap().output_state
        at = at + 32u64
    val authority = parser_structural_guarded_scope_execution_authority_v1(
        o.scopes, o.operations[oi].scope)
    if authority.is_ok():
        val observed = authority.unwrap()
        val expected_calls = (count / 32u64) * 15u64
        if observed.execution_count != expected_calls or
           not _same_digest_lex_po(observed.provider_identity, ar.authorization.provider_identity) or
           not _same_digest_lex_po(observed.variant_identity, ar.authorization.variant_identity) or
           not _same_digest_lex_po(observed.artifact_identity, ar.authorization.artifact_digest) or
           observed.provider_generation != ar.authorization.provider_generation:
            failed = true
    if not _operation_cleanup_po(o, oi): return Err(ParserStructuralPackageErrorV1.CleanupFailed)
    if failed or authority.is_err():
        if policy == ParserLexicalPackagePolicyV1.RequireSimd:
            return Err(ParserStructuralPackageErrorV1.GuardedNativeCallFailed)
        var fallback = _lexical_scalar_blocks_po(o, sr.stable, offset, count, input_state)?
        fallback.receipt.requested_simd = true; fallback.receipt.admitted_simd = true
        fallback.receipt.fallback = ParserLexicalPackageFallbackV1.ExecutionFailed
        fallback.receipt.admitted_provider_identity = ar.authorization.provider_identity
        fallback.receipt.admitted_variant_identity = ar.authorization.variant_identity
        if authority.is_ok() and authority.unwrap().execution_count > 0u64:
            val partial = authority.unwrap()
            fallback.receipt.executed_simd = true
            fallback.receipt.executed_provider_identity = partial.provider_identity
            fallback.receipt.executed_variant_identity = partial.variant_identity
            fallback.receipt.executed_provider_generation = partial.provider_generation
            fallback.receipt.native_mask_calls = partial.execution_count
        fallback.receipt.operation_handle = op_handle.handle
        fallback.receipt.operation_cleanup_terminal = true
        return Ok(fallback)
    val auth = authority.unwrap()
    Ok(ParserLexicalPackageBatchV1(offset: offset, count: count,
        candidate_masks: candidates, summaries: summaries, output_state: state,
        receipt: ParserLexicalPackageReceiptV1(requested_simd: true, admitted_simd: true,
            executed_simd: true, classifier_only: true, scalar_lexical_resolution: true,
            reference_frontend_required: true, fallback: ParserLexicalPackageFallbackV1.None,
            admitted_provider_identity: ar.authorization.provider_identity,
            admitted_variant_identity: ar.authorization.variant_identity,
            executed_provider_identity: auth.provider_identity,
            executed_variant_identity: auth.variant_identity,
            executed_provider_generation: auth.provider_generation,
            native_mask_calls: auth.execution_count, operation_handle: op_handle.handle,
            operation_cleanup_terminal: true)))
