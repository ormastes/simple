# Compatibility compiler_sffi surface for interpreter/test runner.
#
# This module used to REDEFINE every symbol of
# `compiler/99.loader/loader/compiler_sffi.spl` as a stub with a different
# shape (`TypeInfo{type_name}` vs the real `TypeInfo{kind,name,...}`,
# `CompilerContext{alive}` vs the real `CompilerContext{handle}`). Both
# modules land in the same HIR symbol table, so the name bound to the compat
# stub while a real construction site was lowered -- HIR lowering then failed
# with "Cannot infer field type" and dropped the WHOLE enclosing module to the
# interpreter ("expect ~100-1000x slowdown"). That single fallback was the
# dominant fixed cost of `simple test <dir>`: ~400s of a 413s run for 7 spec
# files whose own execution was 4.2s.
#
# The compat surface is now a re-export of the one real definition, so no
# duplicate name exists to collide.
export use compiler.loader.loader.compiler_sffi.{
    TypeInfo, CompilerContext,
    make_int_type, make_float_type, make_bool_type, make_string_type, make_named_type,
    type_to_string,
    compiler_create_context, compiler_destroy_context,
    compiler_infer_types, compiler_instantiate_template, compiler_get_stats,
    serialize_types_json, parse_types_json,
    compiler_result_json_success, compiler_result_json_code, compiler_result_json_error
}

# Helpers that exist only on this compat surface (no counterpart in the real
# module), so they stay defined here.
fn type_args_is_empty(args: [TypeInfo]) -> bool:
    args.len() == 0

fn code_bytes_len(code: [u8]) -> i64:
    code.len() as i64

fn code_len(code: [u8]) -> i64:
    code.len() as i64

fn bytes_len(code: [u8]) -> i64:
    code.len() as i64

export type_args_is_empty
export code_bytes_len, code_len, bytes_len
