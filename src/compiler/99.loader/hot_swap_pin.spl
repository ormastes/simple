# Loader hot-swap pinning (RB-LOAD-01..02).
# Design: doc/05_design/compiler/hot_swap/hot_swap_identity_pin_2026-11-23.md
#
# A HotSwapSlot pins the SMF manifest row its dependents were built against.
# A replacement image is admitted only through the same authority as a cold
# cached-SMF load (smf_cached_unit_identity_admit); any iface/ABI/triple/
# policy/capability mismatch refuses the swap. A legacy image with no identity
# record is also refused: a swap has no full-interpret fallback, and there is
# no state migration across an ABI change.
# The commit point is one lockless CAS on the slot generation.
#
# Threading contract: ONE writer thread (hot_swap_try + hot_swap_reclaim),
# any number of reader threads (hot_swap_read_begin / hot_swap_read_end).
#
# Generation -> image: a fixed-capacity table of HotSwapImage entries,
# allocated once with the slot and never resized, so readers never race a
# reallocation. Generation g lives in entry g % HOT_SWAP_CAPACITY. Readers
# never scan: they load the slot generation, pin its entry with a CAS of the
# reader count c -> c+1 (only for c >= 0), and only then confirm the entry
# still holds that generation (else unpin and retry).
# Reclamation is lockless refcounting: the writer frees an old entry only by a
# CAS of its reader count 0 -> RECLAIMED, and refills an entry only while it is
# RECLAIMED, publishing it by storing the reader count back to 0. So a pinned
# image is never freed or overwritten, and a freed image is never pinned.
use std.nogc_sync_mut.atomic.{AtomicI64, MemoryOrdering, atomic_i64_try_new}
use compiler.driver.watcher.smf_manifest.{SmfManifestEntry}
use compiler.driver.driver_api_interpret.{smf_cached_unit_identity_admit}

val HOT_SWAP_RECLAIMED: i64 = -1
val HOT_SWAP_CAPACITY: i64 = 8
val HOT_SWAP_RETRIES: i64 = 1024

class HotSwapImage:
    generation: AtomicI64
    image: [u8]
    readers: AtomicI64

    fn reader_count() -> i64:
        val r = self.readers
        r.load(MemoryOrdering.SeqCst)

    fn holds_generation() -> i64:
        val g = self.generation
        g.load(MemoryOrdering.SeqCst)

    fn is_reclaimed() -> bool:
        self.reader_count() == HOT_SWAP_RECLAIMED

class HotSwapSlot:
    pinned: SmfManifestEntry
    generation: AtomicI64
    images: [HotSwapImage]

    fn current_generation() -> i64:
        val gen = self.generation
        gen.load(MemoryOrdering.SeqCst)

    fn entry_for(generation: i64) -> HotSwapImage:
        self.images[generation % HOT_SWAP_CAPACITY]

# A reader pin on one generation image; release it with hot_swap_read_end.
class HotSwapRead:
    entry: HotSwapImage
    pinned_generation: i64

    fn generation() -> i64:
        self.pinned_generation

    fn image() -> [u8]:
        self.entry.image

# An empty, reclaimed table entry.
# reason: Result carries the loader diagnostic text
@allow(primitive_api)
fn hot_swap_image_empty() -> Result<HotSwapImage, text>:
    match atomic_i64_try_new(0 - 1):
        Some(gen):
            match atomic_i64_try_new(HOT_SWAP_RECLAIMED):
                Some(readers): Ok(HotSwapImage(generation: gen, image: [], readers: readers))
                None: Err("SMF-E-HOTSWAP-ATOMIC: reader-count atomic allocation failed")
        None: Err("SMF-E-HOTSWAP-ATOMIC: entry generation atomic allocation failed")

# Fails closed when the runtime cannot allocate the slot atomics.
# reason: Result carries the loader diagnostic text
@allow(primitive_api)
fn hot_swap_slot_new(pinned: SmfManifestEntry) -> Result<HotSwapSlot, text>:
    var table: [HotSwapImage] = []
    var i = 0
    while i < HOT_SWAP_CAPACITY:
        table.push(hot_swap_image_empty()?)
        i = i + 1
    match atomic_i64_try_new(0):
        Some(gen): Ok(HotSwapSlot(pinned: pinned, generation: gen, images: table))
        None: Err("SMF-E-HOTSWAP-ATOMIC: generation atomic allocation failed")

# Writer only: fill a RECLAIMED entry and make it pinnable.
fn hot_swap_fill(entry: HotSwapImage, generation: i64, image: [u8]):
    entry.image = image
    val g = entry.generation
    g.store(generation, MemoryOrdering.SeqCst)
    val r = entry.readers
    r.store(0, MemoryOrdering.SeqCst)

# Loader entry point: a slot whose generation 0 is `image`, admitted against
# `pinned` exactly like a swap (no legacy fallback).
# reason: Result carries the loader diagnostic text
@allow(primitive_api)
fn hot_swap_slot_load(pinned: SmfManifestEntry, image: [u8]) -> Result<HotSwapSlot, text>:
    val admitted = smf_cached_unit_identity_admit(pinned, image)?
    if not admitted:
        return Err("SMF-E-UNIT-IDENTITY-MISSING: hot swap load refused, image carries no unit identity record")
    val slot = hot_swap_slot_new(pinned)?
    hot_swap_fill(slot.entry_for(0), 0, image)
    Ok(slot)

# Admit `image` against the pinned row, then publish it by advancing the
# generation from `observed` with a single CAS. Ok = new generation.
# Err = SMF-E-UNIT-* (identity refusal), SMF-E-HOTSWAP-FULL (the target entry
# still holds an unreclaimed generation; reclaim and retry), or
# SMF-E-HOTSWAP-STALE (`observed` is not current).
# On any refusal the previously published image stays the one readers pin.
# reason: Result carries the loader diagnostic text
@allow(primitive_api)
fn hot_swap_try(slot: HotSwapSlot, observed: i64, image: [u8]) -> Result<i64, text>:
    val admitted = smf_cached_unit_identity_admit(slot.pinned, image)?
    if not admitted:
        return Err("SMF-E-UNIT-IDENTITY-MISSING: hot swap refused, replacement carries no unit identity record")
    if slot.current_generation() != observed:
        return Err("SMF-E-HOTSWAP-STALE: generation {observed} is no longer current")
    val next = observed + 1
    val entry = slot.entry_for(next)
    if not entry.is_reclaimed():
        return Err("SMF-E-HOTSWAP-FULL: entry for generation {next} still holds generation {entry.holds_generation()}; reclaim first")
    hot_swap_fill(entry, next, image)
    val gen = slot.generation
    if not gen.compare_exchange(observed, next, MemoryOrdering.SeqCst, MemoryOrdering.SeqCst):
        hot_swap_retire(entry)
        return Err("SMF-E-HOTSWAP-STALE: generation {observed} is no longer current")
    Ok(next)

# Writer only: undo the swap that published `committed` because the load
# that followed it failed, so the slot never ends a generation ahead of the
# module. One CAS committed -> committed - 1; the previous image is still
# live because reclaim runs only after a successful load. The rolled-back
# entry is retired now, or by the next hot_swap_reclaim if a reader holds it.
# Ok = the restored generation; Err = SMF-E-HOTSWAP-STALE.
# reason: Result carries the loader diagnostic text
@allow(primitive_api)
fn hot_swap_rollback(slot: HotSwapSlot, committed: i64) -> Result<i64, text>:
    val prev = committed - 1
    val gen = slot.generation
    if prev < 0 or not gen.compare_exchange(committed, prev, MemoryOrdering.SeqCst, MemoryOrdering.SeqCst):
        return Err("SMF-E-HOTSWAP-STALE: generation {committed} is not current; nothing to roll back")
    val entry = slot.entry_for(committed)
    val readers = entry.readers
    if readers.compare_exchange(0, HOT_SWAP_RECLAIMED, MemoryOrdering.SeqCst, MemoryOrdering.SeqCst):
        entry.image = []
    Ok(prev)

# Writer only: take back an entry that was filled but never published. A
# reader can hold it only transiently (generation mismatch makes it unpin).
fn hot_swap_retire(entry: HotSwapImage):
    val readers = entry.readers
    var n = 0
    while n < HOT_SWAP_RETRIES:
        if readers.compare_exchange(0, HOT_SWAP_RECLAIMED, MemoryOrdering.SeqCst, MemoryOrdering.SeqCst):
            entry.image = []
            return
        n = n + 1

# Pin the current generation image for one call.
# reason: Result carries the loader diagnostic text
@allow(primitive_api)
fn hot_swap_read_begin(slot: HotSwapSlot) -> Result<HotSwapRead, text>:
    var attempts = 0
    while attempts < HOT_SWAP_RETRIES:
        val cur = slot.current_generation()
        val entry = slot.entry_for(cur)
        val readers = entry.readers
        val c = readers.load(MemoryOrdering.SeqCst)
        if c >= 0 and readers.compare_exchange(c, c + 1, MemoryOrdering.SeqCst, MemoryOrdering.SeqCst):
            if entry.holds_generation() == cur:
                return Ok(HotSwapRead(entry: entry, pinned_generation: cur))
            readers.fetch_sub(1, MemoryOrdering.SeqCst)
        attempts = attempts + 1
    Err("SMF-E-HOTSWAP-NO-IMAGE: no pinnable image for the current generation")

fn hot_swap_read_end(read: HotSwapRead):
    val readers = read.entry.readers
    readers.fetch_sub(1, MemoryOrdering.SeqCst)

# Writer only: free every entry other than the current generation (older ones,
# and ones rolled back past) that no
# reader pins. Returns the number of images freed by this call.
fn hot_swap_reclaim(slot: HotSwapSlot) -> i64:
    val cur = slot.current_generation()
    var freed = 0
    for e in slot.images:
        val g = e.holds_generation()
        if g >= 0 and g != cur:
            val readers = e.readers
            if readers.compare_exchange(0, HOT_SWAP_RECLAIMED, MemoryOrdering.SeqCst, MemoryOrdering.SeqCst):
                e.image = []
                freed = freed + 1
    freed

fn hot_swap_image_live(slot: HotSwapSlot, generation: i64) -> bool:
    val e = slot.entry_for(generation)
    e.holds_generation() == generation and not e.is_reclaimed()

export HotSwapSlot, HotSwapImage, HotSwapRead, hot_swap_slot_new, hot_swap_slot_load, hot_swap_try
export hot_swap_read_begin, hot_swap_read_end, hot_swap_reclaim, hot_swap_image_live, hot_swap_rollback
