# Manifest-text -> A4 axis enums (hardening plan §5.3).
#
# A4 owns the axis TABLES (`compiler.common.dynamic_identity.closure`) and
# deliberately exposes only `name()` in that direction. Manifests are read text,
# so the inverse mapping lives here, next to the reader that needs it, and is
# total: an unknown spelling is None, never a defaulted axis value.

use compiler.common.dynamic_identity.closure.{Closure, Linkage, Activation}

pub fn closure_from_text(s: text) -> Closure?:
    if s == "static":
        return Some(Closure.Static)
    if s == "complete":
        return Some(Closure.Complete)
    if s == "dyn":
        return Some(Closure.Dyn)
    None

pub fn linkage_from_text(s: text) -> Linkage?:
    if s == "static_link":
        return Some(Linkage.StaticLink)
    if s == "dynload":
        return Some(Linkage.Dynload)
    None

pub fn activation_from_text(s: text) -> Activation?:
    if s == "startup":
        return Some(Activation.Startup)
    if s == "first_use":
        return Some(Activation.FirstUse)
    if s == "command":
        return Some(Activation.Command)
    if s == "manual":
        return Some(Activation.Manual)
    if s == "hotspot":
        return Some(Activation.Hotspot)
    None

# §5.3: `first_use` is admitted in critical only when the module content was
# already verified and sealed. `critical_admits` cannot observe that — it says
# so in its own header and names the residual obligation through
# `critical_precondition` — so the sealer, which does know the verified set,
# discharges it here.
pub fn first_use_obligation_met(activation: Activation, verified_and_sealed: bool) -> bool:
    match activation:
        Activation.FirstUse: verified_and_sealed
        Activation.Startup: true
        Activation.Command: true
        Activation.Manual: true
        Activation.Hotspot: true
