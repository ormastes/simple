# Native non-SMF MCDP companion discovery.
#
# Native executables, relocatable objects, archives, and shared libraries use a
# platform-independent `<artifact>.mcdp` companion.  This avoids teaching every
# ELF/Mach-O/PE writer a second custom-section implementation while preserving
# an exact static-off artifact contract: no companion and no embedded payload.

use compiler.backend.linker.smf_reader_memory.{bytes_to_u64}
use compiler.loader.aspect_pack_io.{pack_file_size, pack_read_range}

val NATIVE_MCDC_MANIFEST_MAX_BYTES_V1: i64 = 67108864

fn native_mcdc_manifest_path_v1(artifact_path: text) -> text:
    artifact_path + ".mcdp"

fn native_mcdc_manifest_bytes_v1(artifact_path: text) -> Result<[u8], text>:
    val path = native_mcdc_manifest_path_v1(artifact_path)
    val byte_count = pack_file_size(path)
    if byte_count <= 0:
        return Err("native artifact has no MCDP companion")
    if byte_count < 96:
        return Err("native MCDP companion is truncated")
    if byte_count > NATIVE_MCDC_MANIFEST_MAX_BYTES_V1:
        return Err("native MCDP companion exceeds bounded V1 admission")
    # Materialize only the already-admitted byte count.  file_read_bytes would
    # allocate from the file's current unbounded size before this owner could
    # validate it; the positioned reader caps the requested allocation and
    # rejects a concurrent short/long replacement.
    val bytes = pack_read_range(path, 0, byte_count)
    if bytes.len() != byte_count:
        return Err("native MCDP companion changed during bounded read")
    if bytes[0] != 77u8 or bytes[1] != 67u8 or bytes[2] != 68u8
        or bytes[3] != 80u8 or bytes[4] != 1u8 or bytes[5] != 0u8
        or bytes[6] != 0u8 or bytes[7] != 0u8:
        return Err("native MCDP companion header is malformed")
    val row_count = bytes_to_u64(bytes, 8) as i64
    val token_count = bytes_to_u64(bytes, 16) as i64
    if row_count < 0 or token_count < 0 or row_count > 1048576
        or token_count > 8388608:
        return Err("native MCDP companion counts exceed bounded V1 admission")
    val semantic_offset = 88 + row_count * 32 + token_count * 8
    if semantic_offset < 88 or semantic_offset + 8 > bytes.len():
        return Err("native MCDP row/token ranges escape the companion")
    Ok(bytes)

export NATIVE_MCDC_MANIFEST_MAX_BYTES_V1
export native_mcdc_manifest_path_v1, native_mcdc_manifest_bytes_v1
