use compiler.backend.linker.smf_enums.{Platform, Arch, CompressionType}
# SMF File Cache with mmap
#
# Memory-mapped file cache for efficient SMF file loading.
# Uses mmap(2) for zero-copy file access and automatic caching.
#
# Features:
# - Lazy loading: Files mapped on first access
# - Zero-copy reads: Direct memory access via mmap
# - Auto-caching: Mapped regions stay in memory until cache is cleared
# - Thread-safe: Uses immutable caching strategy
#
# Architecture:
# - SmfCache: Main cache manager
# - MappedSmf: Cached SMF file with mapped memory
# - Auto-loads note.sdn metadata on demand
# - Reads template bytes directly from mapped memory

use compiler.backend.linker.smf_reader (SmfReaderImpl, SmfReaderHeader, SmfFlags)
use compiler.backend.linker.smf_header (SMF_HEADER_SIZE, SMF_PACKED_HEADER_SIZE, smf_header_from_bytes, smf_header_trailer_offset, smf_header_size_at)
use compiler.backend.linker.smf_meta.{smf_meta_find, SMF_META_SECTION_NAME, SMF_META_KIND_COMPILE_OPTIONS_V1, SMF_META_COMPILE_OPTIONS_V1_SIZE}
use .smf_mmap_native.{native_mmap_file, native_munmap, native_mmap_read_bytes, native_mmap_read_string, native_madvise}
use std.sdn.parser (parse)
use std.sdn.value (SdnValue)
use std.nogc_sync_mut.io_runtime.{file_size_signed}

fn file_size_for_mmap(path: text) -> i64:
    file_size_signed(path)

fn mmap_file(path: text, prot: i32, flags: i32, offset: i64, length: i64) -> (i64, i64):
    native_mmap_file(path, prot as i64, flags as i64, offset, length)

fn munmap(address: i64, size: i64) -> bool:
    native_munmap(address, size)

fn mmap_read_bytes(address: i64, offset: i64, length: i64) -> [u8]:
    native_mmap_read_bytes(address, offset, length)

fn mmap_read_string(address: i64, offset: i64, max_length: i64) -> text:
    native_mmap_read_string(address, offset, max_length)

fn madvise(address: i64, size: i64, advice: i32) -> bool:
    native_madvise(address, size, advice as i64)

# ============================================================================
# Constants
# ============================================================================

# Protection flags (from mmap.spl)
val PROT_READ: i32 = 0x1

# Mapping flags
val MAP_PRIVATE: i32 = 0x2

# Memory advise flags
val MADV_SEQUENTIAL: i32 = 2   # Sequential access pattern
val MADV_WILLNEED: i32 = 3     # Will need this data soon (prefetch)

# ============================================================================
# Mapped SMF File
# ============================================================================

struct MappedSmf:
    """Memory-mapped SMF file."""
    path: text
    address: i64                    # Base address of mapped memory
    size: i64                       # Size of mapped region
    header: SmfReaderHeader         # Parsed SMF header
    section_count: i32
    template_section_offset: i64    # Offset to TemplateCode section
    section_table_offset: i64       # Cached section table offset (avoid trailer re-reads)
    meta_section_offset: i64        # .simple_meta section offset (0 = none)
    meta_section_size: i64          # .simple_meta section size (0 = none)

impl MappedSmf:
    static fn open(path: text) -> Result<MappedSmf, text>:
        """Open and mmap an SMF file."""
        # Get file size
        val file_size = file_size_for_mmap(path)
        if file_size < 0:
            return Err("Failed to get file size for {path}")

        if file_size < SMF_HEADER_SIZE:
            return Err("File too small to be valid SMF: {path}")

        # Map entire file with read-only access
        val (address, mapped_size) = mmap_file(path, PROT_READ, MAP_PRIVATE, 0, 0)
        if address == 0:
            return Err("Failed to mmap file: {path}")

        # Advise kernel about sequential access
        val _ = madvise(address, mapped_size, MADV_SEQUENTIAL)

        # Read the trailer window: a v1.3 header is the last 96 bytes, a legacy
        # packed header the last 128. The shared locator picks the layout.
        val window_len = if mapped_size < SMF_PACKED_HEADER_SIZE: mapped_size else: SMF_PACKED_HEADER_SIZE
        val window = mmap_read_bytes(address, mapped_size - window_len, window_len)
        val header_start = smf_header_trailer_offset(window)
        val header_bytes = if header_start > 0: window[header_start..window.len()] else: window
        val header: SmfReaderHeader = parse_header_minimal(header_bytes)
        val parsed = smf_header_from_bytes(header_bytes)
        val full_section_table_offset = if parsed.is_ok(): parsed.unwrap().section_table_offset as i64 else: 0
        val num_sections = header.section_count

        # Walk the section table (canonical 64-byte entries: type u8 @0,
        # flags u32 @4, offset u64 @8, size u64 @16, name[16] @40).
        var template_offset = 0i64
        var meta_offset = 0i64
        var meta_size = 0i64
        val meta_name = SMF_META_SECTION_NAME.bytes()

        if full_section_table_offset > 0 and full_section_table_offset < mapped_size:
            var si = 0
            while si < num_sections:
                val entry_offset = full_section_table_offset + (si as i64 * 64)
                if entry_offset + 64 > mapped_size:
                    break
                val entry_bytes = mmap_read_bytes(address, entry_offset, 64)
                val sec_type = entry_bytes[0] as i64
                val full_sec_offset = (bytes_to_u32(entry_bytes[8..12]) as i64) | ((bytes_to_u32(entry_bytes[12..16]) as i64) << 32)
                val full_sec_size = (bytes_to_u32(entry_bytes[16..20]) as i64) | ((bytes_to_u32(entry_bytes[20..24]) as i64) << 32)
                # Type 12 = TemplateCode (legacy; no writer emits it)
                if sec_type == 12:
                    template_offset = full_sec_offset
                if mapped_section_named(entry_bytes, meta_name):
                    meta_offset = full_sec_offset
                    meta_size = full_sec_size
                si = si + 1

        Ok(MappedSmf(
            path: path,
            address: address,
            size: mapped_size,
            header: header,
            section_count: num_sections,
            template_section_offset: template_offset,
            section_table_offset: full_section_table_offset,
            meta_section_offset: meta_offset,
            meta_section_size: meta_size
        ))

    fn close() -> bool:
        """Unmap the file."""
        munmap(self.address, self.size)

    me read_semantic_fingerprint() -> Result<SmfSemanticFingerprint, text>:
        """Read public ABI/accessor/field-wrapper semantic metadata from note.sdn."""
        val search_size = if self.size > 65536: 65536 else: self.size
        val search_offset = self.size - search_size
        val sdn_text = mmap_read_string(self.address, search_offset, search_size)
        val sdn_value = parse(sdn_text)
        match sdn_value:
            case Ok(value):
                parse_smf_semantic_fingerprint(value)
            case Err(err):
                Err("SMF semantic metadata missing or malformed")

    fn read_template_bytes(symbol_name: text, template_offset: i64) -> Result<[u8], text>:
        """Read template bytecode from TemplateCode section."""
        # Locate template at offset
        if template_offset < 0 or template_offset >= self.size:
            return Err("Template offset out of bounds: {template_offset}")

        # Read template length (first 4 bytes at offset)
        val length_bytes = mmap_read_bytes(self.address, template_offset, 4)
        val template_len = bytes_to_u32(length_bytes)

        # Read template data
        val template_data_offset = template_offset + 4
        if template_data_offset + template_len as i64 > self.size:
            return Err("Template extends beyond file")

        val template_bytes = mmap_read_bytes(self.address, template_data_offset, template_len as i64)
        Ok(template_bytes)

    fn read_section(section_index: i32) -> Result<[u8], text>:
        """Read section data by index.

        Uses the cached section_table_offset (parsed once during open())
        to find the section entry, then reads the section data via mmap.
        """
        if self.section_table_offset == 0:
            return Err("No section table found in SMF file")

        val section_count = self.section_count
        if section_index < 0 or section_index >= section_count:
            return Err("Section index {section_index} out of range (0..{section_count})")

        # Each section table entry is 64 bytes
        val entry_offset = self.section_table_offset + (section_index as i64 * 64)
        if entry_offset + 64 > self.size:
            return Err("Section table entry offset out of bounds")

        val entry_bytes = mmap_read_bytes(self.address, entry_offset, 64)

        # Section data offset at entry offset 16 (8 bytes)
        val data_offset_lo = bytes_to_u32(entry_bytes[16..20]) as i64
        val data_offset_hi = bytes_to_u32(entry_bytes[20..24]) as i64
        val data_offset = data_offset_lo | (data_offset_hi << 32)

        # Section data size at entry offset 24 (8 bytes)
        val data_size_lo = bytes_to_u32(entry_bytes[24..28]) as i64
        val data_size_hi = bytes_to_u32(entry_bytes[28..32]) as i64
        val data_size = data_size_lo | (data_size_hi << 32)

        if data_offset + data_size > self.size:
            return Err("Section data extends beyond file")

        val section_data = mmap_read_bytes(self.address, data_offset, data_size)
        Ok(section_data)

# ============================================================================
# SMF Cache
# ============================================================================

struct SmfCache:
    """Cache of memory-mapped SMF files."""
    cached_files: Dict<text, MappedSmf>
    enabled: bool
    stats: CacheStats

struct CacheStats:
    """Cache statistics."""
    total_files: i32
    total_memory: i64
    cache_hits: i32
    cache_misses: i32

struct SmfSemanticFingerprint:
    """Public ABI/accessor/field-wrapper semantic fingerprint stored in SMF metadata."""
    public_abi_hash: text
    accessor_hash: text
    field_wrapper_hash: text
    dependency_fingerprints: Dict<text, text>
    combined: text

impl SmfCache:
    static fn new() -> SmfCache:
        """Create a new SMF cache."""
        SmfCache(
            cached_files: {},
            enabled: true,
            stats: CacheStats(
                total_files: 0,
                total_memory: 0,
                cache_hits: 0,
                cache_misses: 0
            )
        )

    me get(path: text) -> Result<MappedSmf, text>:
        """Get a mapped SMF file, loading it if not cached."""
        # Check cache
        if self.cached_files.has(path):
            self.stats.cache_hits = self.stats.cache_hits + 1
            return Ok(self.cached_files[path])

        # Cache miss - load file
        self.stats.cache_misses = self.stats.cache_misses + 1

        val mapped = MappedSmf.open(path)?

        # Update stats
        self.stats.total_files = self.stats.total_files + 1
        self.stats.total_memory = self.stats.total_memory + mapped.size

        # Cache it
        self.cached_files[path] = mapped

        Ok(mapped)

    me clear():
        """Unmap cached files, retaining failed releases for a later retry."""
        # BUG-001 fix: Use keys()-based iteration (for (k,v) in dict is broken in compiled mode)
        for path in self.cached_files.keys():
            val _ = self.evict(path)

    me evict(path: text) -> bool:
        """Evict a single file from the cache and unmap it.

        Returns true only after the mapping was successfully released.
        Failed releases remain owned and accounted so cleanup can retry.
        """
        if not self.cached_files.has(path):
            return false

        val mapped = self.cached_files[path]
        # A malformed/failed mapping has no releasable extent.  Keep it in
        # the cache so the owner retains accounting and a later retry can
        # observe a corrected release handle.
        if mapped.address <= 0 or mapped.size <= 0:
            return false
        if not mapped.close():
            return false

        self.stats.total_files = self.stats.total_files - 1
        self.stats.total_memory = self.stats.total_memory - mapped.size
        # `Dict.remove(k)` returns a NEW dict interpreted but the REMOVED VALUE
        # natively (rt_dict_remove); assigning it back destroys the map on the
        # compiled lane. Rebuild without the key. See doc/08_tracking/bug/
        # dict_remove_return_value_differs_native_vs_interpreter_2026-09-13.md
        var _kept_self_cached_files: Dict<text, MappedSmf> = {}
        for _k in self.cached_files.keys():
            if _k != path:
                _kept_self_cached_files[_k] = self.cached_files[_k]
        self.cached_files = _kept_self_cached_files
        true

    me prefetch(paths: [text]):
        """Prefetch multiple SMF files into cache."""
        for path in paths:
            val _ = self.get(path)
            # Advise kernel to prefetch this file
            if self.cached_files.has(path):
                val mapped = self.cached_files[path]
                val _ = madvise(mapped.address, mapped.size, MADV_WILLNEED)

    fn get_stats() -> CacheStats:
        """Get cache statistics."""
        self.stats

    fn is_cached(path: text) -> bool:
        """Check if a file is in the cache."""
        self.cached_files.has(path)

    fn cached_count() -> i32:
        """Get number of cached files."""
        self.stats.total_files

# ============================================================================
# Helper Functions
# ============================================================================

fn parse_header_minimal(bytes: [u8]) -> SmfReaderHeader:
    """Decode the SMF header in `bytes` (a whole image, or the header itself)
    through the canonical decoder (compiler.backend.linker.smf_header), which
    accepts the v1.3 96-byte layout, the Rust seed's 1.1 stamp of it, and the
    legacy packed 128-byte layout.

    ROBUSTNESS: Falls back to safe defaults when no header is present.
    """

    val parsed = smf_header_from_bytes(bytes)
    if parsed.is_err():
        # Insufficient data - return minimal defaults
        return SmfReaderHeader(
            version: (1, 1),
            platform: Platform.Linux,
            arch: Arch.X86_64,
            flags: SmfFlags(
                executable: false,
                reloadable: false,
                debug_info: false,
                pic: false,
                has_stub: false,
                aspect_pack: false
            ),
            section_count: 0,
            symbol_count: 0,
            entry_point: 0,
            has_templates: false,
            has_note_sdn: false,
            compression: CompressionType.None_
        )

    val h = parsed.unwrap()
    val flags = SmfFlags(
        executable: h.is_executable(),
        reloadable: h.is_reloadable(),
        debug_info: h.has_debug_info(),
        pic: h.is_pic(),
        has_stub: h.has_stub(),
        aspect_pack: h.is_aspect_pack()
    )
    val section_count = h.section_count as i32
    val symbol_count = h.symbol_count as i32
    val entry_point = h.entry_point as i64
    val compression = h.get_compression()

    # Determine template/note.sdn presence by checking section count
    # Templates are present if section_count > 1 (more than just code section)
    val has_templates = section_count > 1
    val has_note_sdn = section_count > 3

    SmfReaderHeader(
        version: (h.version_major, h.version_minor),
        platform: Platform.from_u8(h.platform),
        arch: Arch.from_u8(h.arch),
        flags: flags,
        section_count: section_count,
        symbol_count: symbol_count,
        entry_point: entry_point,
        has_templates: has_templates,
        has_note_sdn: has_note_sdn,
        compression: compression
    )

fn mapped_section_named(entry_bytes: [u8], want: [u8]) -> bool:
    """True when a 64-byte section entry's NUL-padded name[16] equals `want`."""
    if entry_bytes.len() < 56:
        return false
    var i = 0
    while i < 16:
        val b = if i < want.len(): want[i] else: 0
        if entry_bytes[40 + i] != b:
            return false
        i = i + 1
    true

fn mapped_smf_compile_options_bytes(mapped: MappedSmf) -> [u8]:
    """16-byte compile-options hash of a mapped SMF, or [] when absent.

    v1.3: `.simple_meta` record kind 2. Legacy packed trailer: bytes 88..104
    of the 128-byte header (read-only fallback, removed with the packed reader).
    """
    if mapped.meta_section_size > 0 and mapped.meta_section_offset >= 0 and mapped.meta_section_offset <= mapped.size - mapped.meta_section_size:
        val section = mmap_read_bytes(mapped.address, mapped.meta_section_offset, mapped.meta_section_size)
        val record = smf_meta_find(section, SMF_META_KIND_COMPILE_OPTIONS_V1)
        if record.len() == SMF_META_COMPILE_OPTIONS_V1_SIZE:
            return record
    if mapped.size < SMF_PACKED_HEADER_SIZE:
        return []
    val trailer = mmap_read_bytes(mapped.address, mapped.size - SMF_PACKED_HEADER_SIZE, SMF_PACKED_HEADER_SIZE)
    if trailer.len() != SMF_PACKED_HEADER_SIZE or smf_header_trailer_offset(trailer) != 0 or smf_header_size_at(trailer, 0) != SMF_PACKED_HEADER_SIZE:
        return []
    var legacy: [u8] = []
    var nonzero = false
    var i = 0
    while i < SMF_META_COMPILE_OPTIONS_V1_SIZE:
        if trailer[88 + i] != 0:
            nonzero = true
        legacy.push(trailer[88 + i])
        i = i + 1
    if nonzero: legacy else: []

fn bytes_to_u32(bytes: [u8]) -> u32:
    """Convert 4 bytes (little-endian) to u32."""
    if bytes.len() < 4:
        return 0

    val b0 = bytes[0] as u32
    val b1 = bytes[1] as u32
    val b2 = bytes[2] as u32
    val b3 = bytes[3] as u32

    b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)

fn get_string_from_value(value: SdnValue) -> Result<text, text>:
    """Extract string from SdnValue."""
    match value:
        case SdnValue.String(s): Ok(s)
        case _: Err("Expected string value")

fn get_bool_from_value(value: SdnValue) -> Result<bool, text>:
    """Extract boolean from SdnValue."""
    match value:
        case SdnValue.Bool(b): Ok(b)
        case SdnValue.String(s):
            match s:
                case "true": Ok(true)
                case "false": Ok(false)
                case _: Err("Invalid boolean string: {s}")
        case _: Err("Expected boolean value")

fn parse_smf_semantic_fingerprint(value: SdnValue) -> Result<SmfSemanticFingerprint, text>:
    match value:
        case SdnValue.Dict(dict):
            val public_abi_hash = get_required_text_field(dict, "public_abi_hash")?
            val accessor_hash = get_required_text_field(dict, "accessor_hash")?
            val field_wrapper_hash = get_required_text_field(dict, "field_wrapper_hash")?
            var dependency_fingerprints: Dict<text, text> = {}
            if dict.has("dependency_semantic_fingerprints"):
                match dict["dependency_semantic_fingerprints"]:
                    case SdnValue.Dict(dep_dict):
                        for dep in dep_dict.keys():
                            dependency_fingerprints[dep] = get_string_from_value(dep_dict[dep])?
                    case _:
                        return Err("dependency_semantic_fingerprints must be a dictionary")
            Ok(expected_smf_semantic_fingerprint(public_abi_hash, accessor_hash, field_wrapper_hash, dependency_fingerprints))
        case _:
            Err("Expected Dict at root of semantic note.sdn")

fn get_required_text_field(dict: Dict<text, SdnValue>, field: text) -> Result<text, text>:
    if not dict.has(field):
        return Err("SMF semantic metadata missing {field}")
    get_string_from_value(dict[field])

fn expected_smf_semantic_fingerprint(public_abi_hash: text, accessor_hash: text, field_wrapper_hash: text, dependency_fingerprints: Dict<text, text>) -> SmfSemanticFingerprint:
    var dep_parts: [text] = []
    for dep in dependency_fingerprints.keys():
        dep_parts = dep_parts.push(dep + "=" + dependency_fingerprints[dep])
    val combined = smf_semantic_text_hash("public_abi|" + public_abi_hash + "|accessor|" + accessor_hash + "|field_wrapper|" + field_wrapper_hash + "|deps|" + dep_parts.join("|"))
    SmfSemanticFingerprint(
        public_abi_hash: public_abi_hash,
        accessor_hash: accessor_hash,
        field_wrapper_hash: field_wrapper_hash,
        dependency_fingerprints: dependency_fingerprints,
        combined: combined
    )

fn smf_semantic_text_hash(input: text) -> text:
    var h1: i64 = 5381
    var h2: i64 = 52711
    var len = 0
    while len < input.byte_len():
        val code = input.char_code_at(len)
        h1 = ((h1 * 33) + code) % 2147483647
        h2 = ((h2 * 131) + code + len) % 2147483629
        len = len + 1
    "{len}:{h1}:{h2}"

# ============================================================================
# Validated SMF Loading
# ============================================================================

use compiler.driver.cache.compile_options_hash.{
    CompileOptionsHash,
    compile_options_hash_from_bytes, compile_options_hash_validate
}
use compiler.driver.cache.cache_types.{CacheCheckResult, CACHE_FRESH}
use compiler.driver.driver_api_compile_single.{smf_expected_compile_options_hash}

fn validated_smf_load(smf_path: text, source_path: text, backend: text, opt_level: i64, release: bool, debug_info: bool, gc_off: bool, profile: text, allowed_families: [text], native_target: text = "") -> Result<MappedSmf, text>:
    """Load an SMF file with backend/options validation.

    Checks that the cached SMF was compiled with matching options.
    On mismatch, prints a WARNING and returns Err so caller can recompile.
    """
    # Compute current options hash
    val current_hash = smf_expected_compile_options_hash(backend, opt_level, release, debug_info, gc_off, profile, allowed_families, native_target)?

    # Open the SMF file
    val mapped_result = MappedSmf.open(smf_path)
    val mapped = match mapped_result:
        case Ok(value):
            value
        case Err(_):
            return mapped_result

    # Read the compile-options hash: `.simple_meta` record kind 2 (legacy
    # packed headers: trailer bytes 88..104). Read only the section and the
    # trailer window from this same mapping; do not reopen a replaceable path
    # or copy the whole artifact.
    if mapped.size < SMF_HEADER_SIZE:
        val _ = mapped.close()
        return Err("SMF mapped header is truncated")
    val reserved_bytes = mapped_smf_compile_options_bytes(mapped)
    val stored_hash = compile_options_hash_from_bytes(reserved_bytes)

    # NOTE: a zero stored hash (old-format SMF) is NOT accepted — validate
    # treats it as stale so the caller rebuilds (audit P1: zero-hash acceptance)

    # Validate options match
    val validation: CacheCheckResult = compile_options_hash_validate(stored_hash, current_hash)
    if validation.status != CACHE_FRESH:
        eprint("WARNING: SMF backend mismatch for {smf_path}: {validation.detail}")
        eprint("  Stored: backend={stored_hash.backend_kind}, opt={stored_hash.opt_level}")
        eprint("  Current: backend={current_hash.backend_kind}, opt={current_hash.opt_level}")
        val _ = mapped.close()
        return Err("SMF options mismatch: {validation.detail}")

    Ok(mapped)

fn validated_smf_load_with_semantics(smf_path: text, source_path: text, backend: text, opt_level: i64, release: bool, debug_info: bool, gc_off: bool, profile: text, allowed_families: [text], expected_semantics: SmfSemanticFingerprint, native_target: text = "") -> Result<MappedSmf, text>:
    """Load an SMF and fail closed on public ABI/accessor/field-wrapper mismatch."""
    val mapped = validated_smf_load(smf_path, source_path, backend, opt_level, release, debug_info, gc_off, profile, allowed_families, native_target)?
    val stored_semantics_result = mapped.read_semantic_fingerprint()
    val stored_semantics = match stored_semantics_result:
        case Ok(value):
            value
        case Err(err):
            val _ = mapped.close()
            return Err(err)
    if stored_semantics.combined != expected_semantics.combined:
        val _ = mapped.close()
        return Err("SMF semantic fingerprint mismatch for {smf_path}")
    Ok(mapped)

# ============================================================================
# Exports
# ============================================================================
