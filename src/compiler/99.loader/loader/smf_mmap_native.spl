# Native Simple mmap Implementation for SMF Files
#
# Uses runtime SFFI wrappers around libc mmap/munmap/etc. to provide executable
# memory and file-backed mappings for the loader. Keeps a thin Simple layer for
# basic helpers and statistics.

use compiler.loader.smf_mmap_native.{
    native_alloc_exec_memory as owner_alloc_exec_memory,
    native_alloc_rw_memory as owner_alloc_rw_memory,
    native_free_exec_memory as owner_free_exec_memory,
    native_exec_memory_count as owner_exec_memory_count,
    native_exec_memory_total as owner_exec_memory_total,
    native_make_executable as owner_make_executable,
    native_make_rw as owner_make_rw,
    native_flush_icache as owner_flush_icache,
    native_mmap_file as owner_mmap_file,
    native_munmap as owner_munmap,
    native_mmap_read_bytes as owner_mmap_read_bytes,
    native_madvise as owner_madvise,
    native_msync as owner_msync,
    native_mlock as owner_mlock,
    native_munlock as owner_munlock,
    native_write_exec_memory as owner_write_exec_memory,
    native_reloc_write_i32 as owner_reloc_write_i32,
    native_reloc_write_i64 as owner_reloc_write_i64,
    native_get_function_pointer as owner_get_function_pointer,
    native_call_function_0 as owner_call_function_0,
    native_call_function_1 as owner_call_function_1,
    native_call_function_2 as owner_call_function_2,
    native_call_function_3 as owner_call_function_3
}

use std.string_core.{char_from_code}

# ============================================================================
# Constants (libc values)
# ============================================================================

val PROT_NONE: i64 = 0x0
val PROT_READ: i64 = 0x1
val PROT_WRITE: i64 = 0x2
val PROT_EXEC: i64 = 0x4

val MAP_SHARED: i64 = 0x1
val MAP_PRIVATE: i64 = 0x2
val MAP_ANONYMOUS: i64 = 0x20
val MAP_FAILED: i64 = -1
val O_RDONLY: i64 = 0x0

val MADV_NORMAL: i64 = 0
val MADV_RANDOM: i64 = 1
val MADV_SEQUENTIAL: i64 = 2
val MADV_WILLNEED: i64 = 3
val MADV_DONTNEED: i64 = 4

# ============================================================================
# Native mmap Implementation (Simple + unsafe)
# ============================================================================

fn native_mmap_file(path: text, prot: i64, flags: i64, offset: i64, length: i64) -> (i64, i64):
    """Map file using native Simple unsafe operations.

    val _tv_0 = [address, size]
    Returns: _tv_0 or (0, 0) on error
    """
    val mapped = owner_mmap_file(path, prot, flags, offset, length)
    (mapped[0], mapped[1])

@unsafe(reason: "caller owns mapped-address extent and release lifetime", capabilities: [raw_ptr])
fn native_munmap(address: i64, size: i64) -> bool:
    # Keep the loader's invalid-extent contract local to this adapter.  The
    # delegated owner is the real unmap authority, but a zero/negative extent
    # is a failed release and must remain retryable/accounted by SmfCache.
    if address <= 0 or size <= 0:
        return false
    owner_munmap(address, size)

@unsafe(reason: "caller owns mapped-address extent and read lifetime", capabilities: [raw_ptr])
fn native_mmap_read_bytes(address: i64, offset: i64, length: i64) -> [u8]:
    owner_mmap_read_bytes(address, offset, length)

@unsafe(reason: "caller owns mapped-address extent and read lifetime", capabilities: [raw_ptr])
fn native_mmap_read_string(address: i64, offset: i64, max_length: i64) -> text:
    if address == 0 or offset < 0 or max_length < 0:
        return ""
    val max_len = if max_length == 0: 4096 else: max_length
    val mapped = native_mmap_read_bytes(address, offset, max_len)
    var bounded: [u8] = []
    for byte in mapped:
        if byte == 0u8:
            break
        bounded.push(byte)
    str_from_utf8_lossy(bounded)

@unsafe(reason: "caller owns mapped-address extent and lifetime", capabilities: [raw_ptr])
fn native_madvise(address: i64, size: i64, advice: i64) -> bool:
    owner_madvise(address, size, advice)

@unsafe(reason: "caller owns mapped-address extent and lifetime", capabilities: [raw_ptr])
fn native_msync(address: i64, size: i64, is_async: bool) -> bool:
    owner_msync(address, size, is_async)

@unsafe(reason: "caller owns mapped-address extent and lifetime", capabilities: [raw_ptr])
fn native_mlock(address: i64, size: i64) -> bool:
    owner_mlock(address, size)

@unsafe(reason: "caller owns mapped-address extent and lifetime", capabilities: [raw_ptr])
fn native_munlock(address: i64, size: i64) -> bool:
    owner_munlock(address, size)

