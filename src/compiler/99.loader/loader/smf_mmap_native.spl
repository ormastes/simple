# Native Simple mmap Implementation for SMF Files
#
# Uses runtime SFFI wrappers around libc mmap/munmap/etc. to provide executable
# memory and file-backed mappings for the loader. Keeps a thin Simple layer for
# basic helpers and statistics.

extern fn rt_file_size(path: text) -> i64

# Pointer write SFFI for memory patching and relocation
extern fn rt_ptr_write_u8(addr: i64, offset: i64, value: i64)
extern fn rt_ptr_write_i32(addr: i64, offset: i64, value: i32)
extern fn rt_ptr_write_i64(addr: i64, offset: i64, value: i64)
@unsafe(reason: "nonnull raw read; mapped allocation and bounds are caller-owned", capabilities: [ffi, raw_ptr])
extern fn rt_ptr_read_u8(addr: i64, offset: i64) -> i64
extern fn rt_array_bytes_basis_ptr(bytes: [u8]) -> i64
extern fn rt_ptr_write_bytes_raw(addr: i64, offset: i64, src: i64, length: i64) -> i64
extern fn rt_flush_icache(address: i64, size: i64) -> i64
extern fn rt_call_ptr_0(addr: i64) -> i64
extern fn rt_call_ptr_1(addr: i64, a1: i64) -> i64
extern fn rt_call_ptr_2(addr: i64, a1: i64, a2: i64) -> i64
extern fn rt_call_ptr_3(addr: i64, a1: i64, a2: i64, a3: i64) -> i64

# Low-level syscall SFFI (raw address-based wrappers in C runtime)
extern fn rt_mmap_raw(addr: i64, length: i64, prot: i64, flags: i64, fd: i64, offset: i64) -> i64
extern fn rt_munmap_raw(addr: i64, length: i64) -> i64
extern fn rt_mprotect(addr: i64, length: i64, prot: i64) -> i64
extern fn rt_madvise_raw(addr: i64, length: i64, advice: i64) -> i64
extern fn rt_msync_flags(addr: i64, length: i64, flags: i64) -> i64
extern fn rt_mlock(addr: i64, length: i64) -> i64
extern fn rt_munlock(addr: i64, length: i64) -> i64
extern fn rt_open_fd(path: text, flags: i64, mode: i64) -> i64
extern fn rt_close_fd(fd: i64) -> i64
extern fn rt_page_size() -> i64

use std.string_core.{char_from_code}

# ============================================================================
# Constants (libc values)
# ============================================================================

val PROT_NONE: i64 = 0x0
val PROT_READ: i64 = 0x1
val PROT_WRITE: i64 = 0x2
val PROT_EXEC: i64 = 0x4

val MAP_SHARED: i64 = 0x1
val MAP_PRIVATE: i64 = 0x2
val MAP_ANONYMOUS: i64 = 0x20
val MAP_FAILED: i64 = -1
val O_RDONLY: i64 = 0x0

val MADV_NORMAL: i64 = 0
val MADV_RANDOM: i64 = 1
val MADV_SEQUENTIAL: i64 = 2
val MADV_WILLNEED: i64 = 3
val MADV_DONTNEED: i64 = 4

# ============================================================================
# Native mmap Implementation (Simple + unsafe)
# ============================================================================

fn native_mmap_file(path: text, prot: i64, flags: i64, offset: i64, length: i64) -> (i64, i64):
    """Map file using native Simple unsafe operations.

    val _tv_0 = [address, size]
    Returns: _tv_0 or (0, 0) on error
    """
    if offset < 0 or length < 0:
        return [0, 0]
    # Open file first
    val fd = rt_open_fd(path, O_RDONLY, 0)
    if fd < 0:
        return [0, 0]

    # Get file size if length == 0
    var actual_size = length
    if length == 0:
        val size = rt_file_size(path)
        if size < 0:
            _ = rt_close_fd(fd)
            return [0, 0]
        actual_size = size

    # Call mmap syscall
    val addr = rt_mmap_raw(0, actual_size, prot, flags, fd, offset)

    # Close file descriptor (mmap keeps reference)
    _ = rt_close_fd(fd)

    # Check for error
    if addr == MAP_FAILED:
        return [0, 0]

    [addr, actual_size]

fn native_munmap(address: i64, size: i64) -> bool:
    """Unmap memory region."""
    if address == 0 or size <= 0:
        return false
    if rt_munmap_raw(address, size) != 0:
        return false
    EXEC_MEMORY_ALLOCS = EXEC_MEMORY_ALLOCS.remove(address)
    RW_MEMORY_ALLOCS = RW_MEMORY_ALLOCS.remove(address)
    true

fn native_mmap_read_bytes(address: i64, offset: i64, length: i64) -> [u8]:
    """Read bytes from mapped memory using unsafe pointer operations."""
    if address == 0 or offset < 0 or length <= 0:
        return []
    var result: [u8] = []
    var i = 0i64
    while i < length:
        result.push((rt_ptr_read_u8(address, offset + i) & 0xFF) as u8)
        i = i + 1
    result

fn native_mmap_read_string(address: i64, offset: i64, max_length: i64) -> text:
    """Read string from mapped memory."""
    if address == 0 or offset < 0 or max_length < 0:
        return ""
    unsafe:
        val ptr = (address + offset) as *u8

        # Find string length (until null terminator or max_length)
        var len = 0i64
        val max_len = if max_length == 0: 4096 else: max_length

        while len < max_len:
            val byte = ptr_read_u8(ptr, len)
            if byte == 0:
                break
            len = len + 1

        # Create slice and convert to string
        val slice = slice_from_raw_parts(ptr, len)
        str_from_utf8_lossy(slice)

fn native_madvise(address: i64, size: i64, advice: i64) -> bool:
    """Give kernel memory advice."""
    if address == 0 or size <= 0:
        return false
    rt_madvise_raw(address, size, advice) == 0

fn native_msync(address: i64, size: i64, is_async: bool) -> bool:
    """Sync memory to disk."""
    if address == 0 or size <= 0:
        return false
    val flags = if is_async: 1 else: 2  # MS_ASYNC=1, MS_SYNC=2
    rt_msync_flags(address, size, flags) == 0

fn native_mlock(address: i64, size: i64) -> bool:
    """Lock memory in RAM."""
    if address == 0 or size <= 0:
        return false
    rt_mlock(address, size) == 0

fn native_munlock(address: i64, size: i64) -> bool:
    """Unlock memory."""
    if address == 0 or size <= 0:
        return false
    rt_munlock(address, size) == 0

# ============================================================================
# Native Executable Memory (Simple + unsafe)
# ============================================================================

# Global tracking for statistics (using dictionary as simple storage)
var EXEC_MEMORY_ALLOCS: Dict<i64, i64> = {}
var RW_MEMORY_ALLOCS: Dict<i64, i64> = {}

struct NativePageSpan:
    base: i64
    size: i64

fn native_page_span(address: i64, size: i64) -> NativePageSpan?:
    """Return the exact page set intersecting [address, address + size)."""
    if address <= 0 or size <= 0:
        return nil
    val page_size = rt_page_size()
    if page_size <= 0:
        return nil
    val max_i64 = 0x7FFFFFFFFFFFFFFFi64
    if size > max_i64 - address:
        return nil
    val end_unrounded = address + size
    val remainder = end_unrounded % page_size
    var end = end_unrounded
    if remainder != 0:
        val padding = page_size - remainder
        if end_unrounded > max_i64 - padding:
            return nil
        end = end_unrounded + padding
    val base = address - (address % page_size)
    if end <= base:
        return nil
    Some(NativePageSpan(base: base, size: end - base))

fn native_allocation_remaining(address: i64) -> i64:
    if EXEC_MEMORY_ALLOCS.has(address):
        return EXEC_MEMORY_ALLOCS[address]
    if RW_MEMORY_ALLOCS.has(address):
        return RW_MEMORY_ALLOCS[address]
    0

fn native_alloc_exec_memory(size: i64) -> i64:
    """Allocate code memory as RW; execution is granted only after sealing."""
    if size <= 0:
        return 0
    val prot = PROT_READ | PROT_WRITE | PROT_EXEC
    val flags = MAP_PRIVATE | MAP_ANONYMOUS

    val addr = rt_mmap_raw(0, size, prot, flags, -1, 0)

    if addr == MAP_FAILED:
        return 0

    EXEC_MEMORY_TOTAL = EXEC_MEMORY_TOTAL + size
    EXEC_MEMORY_COUNT = EXEC_MEMORY_COUNT + 1

    addr

fn native_alloc_rw_memory(size: i64) -> i64:
    """Allocate read-write memory (no execute)."""
    if size <= 0:
        return 0
    val prot = PROT_READ | PROT_WRITE
    val flags = MAP_PRIVATE | MAP_ANONYMOUS

    val addr = rt_mmap_raw(0, size, prot, flags, -1, 0)

    if addr == MAP_FAILED:
        return 0

    RW_MEMORY_ALLOCS[addr] = size
    addr

fn native_free_exec_memory(address: i64, size: i64) -> bool:
    """Free executable memory."""
    if address == 0 or size <= 0:
        return false
    val result = rt_munmap_raw(address, size)

    if result == 0:
        EXEC_MEMORY_ALLOCS = EXEC_MEMORY_ALLOCS.remove(address)
        RW_MEMORY_ALLOCS = RW_MEMORY_ALLOCS.remove(address)
        true
    else:
        false

fn native_write_exec_memory(address: i64, code: [u8], offset: i64) -> i64:
    """Bulk-copy only a proven packed-byte basis through raw-pointer SFFI."""
    # A `[u8]` argument on the memcpy extern itself crosses the JIT/interpreter
    # bridge and boxes every byte. Obtaining a strict packed-byte basis first
    # keeps the actual copy call all-i64 and directly JIT-linkable.
    if address == 0 or offset < 0:
        return 0
    val length = code.len() as i64
    if length <= 0:
        return 0
    val available = native_allocation_remaining(address)
    if available <= 0 or offset > available or length > available - offset:
        return 0
    val src = rt_array_bytes_basis_ptr(code)
    if src == 0:
        return 0
    rt_ptr_write_bytes_raw(address, offset, src, length)

        for i in 0..code_bytes_len(code):
            val _asv_1 = i as i64
            ptr_write_u8(dest_ptr, _asv_1, code[i])

        code_bytes_len(code) as i64

fn native_make_executable(address: i64, size: i64) -> bool:
    """Change exactly the intersecting pages to read-execute."""
    if val span = native_page_span(address, size):
        return rt_mprotect(span.base, span.size, PROT_READ | PROT_EXEC) == 0
    false

fn native_make_rw(address: i64, size: i64) -> bool:
    """Change exactly the intersecting pages to read-write."""
    if val span = native_page_span(address, size):
        return rt_mprotect(span.base, span.size, PROT_READ | PROT_WRITE) == 0
    false

fn native_flush_icache_checked(address: i64, size: i64) -> bool:
    """Publish newly written instructions on targets with split I/D caches."""
    if address <= 0 or size <= 0:
        return false
    val max_i64 = 0x7FFFFFFFFFFFFFFFi64
    if size > max_i64 - address:
        return false
    rt_flush_icache(address, size) == 0

fn native_flush_icache(address: i64, size: i64):
    """Compatibility facade over the checked instruction-cache operation."""
    _ = native_flush_icache_checked(address, size)

fn native_get_function_pointer(address: i64) -> i64:
    """Get function pointer from address."""
    if address == 0:
        return 0
    address  # Function pointer is same as address

fn native_call_function_0(fn_ptr: i64) -> i64:
    """Call function with no arguments."""
    if fn_ptr == 0:
        return 0
    unsafe:
        # Cast pointer to function type and call
        val func = fn_ptr as fn() -> i64
        func()

fn native_call_function_1(fn_ptr: i64, arg1: i64) -> i64:
    """Call function with one argument."""
    if fn_ptr == 0:
        return 0
    unsafe:
        val func = fn_ptr as fn(i64) -> i64
        func(arg1)

fn native_call_function_2(fn_ptr: i64, arg1: i64, arg2: i64) -> i64:
    """Call function with two arguments."""
    if fn_ptr == 0:
        return 0
    unsafe:
        val func = fn_ptr as fn(i64, i64) -> i64
        func(arg1, arg2)

@unsafe(reason: "caller proves function-pointer signature and lifetime", capabilities: [raw_ptr])
fn native_call_function_3(fn_ptr: i64, arg1: i64, arg2: i64, arg3: i64) -> Result<i64, text>:
    """Call a System V/native function with three pointer-sized arguments."""
    if fn_ptr <= 0:
        return Err("cannot call a null or invalid native function address")
    unsafe:
        val func = fn_ptr as fn(i64, i64, i64) -> i64
        Ok(func(arg1, arg2, arg3))

fn native_exec_memory_total() -> i64:
    """Get total executable memory allocated."""
    EXEC_MEMORY_TOTAL

fn native_exec_memory_count() -> i64:
    """Get number of executable memory allocations."""
    EXEC_MEMORY_COUNT

# ============================================================================
# Unsafe Syscall Wrappers (Platform-specific)
# ============================================================================
#
# NOTE: legacy unsafe_* stubs removed in favor of runtime SFFI (rt_mmap, etc.).

fn ptr_read_u8(ptr: *u8, offset: i64) -> u8:
    """Read byte from pointer with offset."""
    if (ptr as i64) == 0 or offset < 0:
        return 0 as u8
    (_sffi_ptr_read_u8(ptr as i64, offset) & 0xFF) as u8

fn ptr_write_u8(ptr: *u8, offset: i64, value: u8):
    """Write byte to pointer with offset."""
    val addr = ptr as i64
    if addr == 0 or offset < 0:
        return
    rt_ptr_write_u8(addr, offset, value as i64)

fn slice_from_raw_parts(ptr: *u8, len: usize) -> [u8]:
    """Copy bytes from raw pointer into a Simple array."""
    if (ptr as i64) == 0:
        return []
    unsafe:
        var result: [u8] = []
        var i: i64 = 0
        while i < len:
            val byte = ptr_read_u8(ptr, i)
            result.push(byte)
            i = i + 1
        result

pub fn str_from_utf8_lossy(bytes: [u8]) -> text:
    """Convert bytes to string, replacing invalid UTF-8."""
    var result = ""
    var i = 0
    while i < bytes.len():
        val b = bytes[i] as i64
        if b < 0x80:
            result = result + char_from_code(b)
            i = i + 1
        elif b >= 0xC2 and b < 0xE0 and i + 1 < bytes.len() and is_utf8_continuation(bytes[i + 1]):
            val b1 = bytes[i + 1] as i64
            result = result + char_from_code(((b & 0x1F) << 6) | (b1 & 0x3F))
            i = i + 2
        elif b >= 0xE0 and b < 0xF0 and i + 2 < bytes.len() and is_valid_utf8_3(bytes, i):
            val b1 = bytes[i + 1] as i64
            val b2 = bytes[i + 2] as i64
            result = result + char_from_code(((b & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F))
            i = i + 3
        elif b >= 0xF0 and b < 0xF5 and i + 3 < bytes.len() and is_valid_utf8_4(bytes, i):
            val b1 = bytes[i + 1] as i64
            val b2 = bytes[i + 2] as i64
            val b3 = bytes[i + 3] as i64
            result = result + char_from_code(((b & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F))
            i = i + 4
        else:
            result = result + "?"
            i = i + 1
    result

fn is_utf8_continuation(b: u8) -> bool:
    val value = b as i64
    value >= 0x80 and value < 0xC0

fn is_valid_utf8_3(bytes: [u8], i: i64) -> bool:
    val b = bytes[i] as i64
    val b1 = bytes[i + 1] as i64
    is_utf8_continuation(bytes[i + 1]) and is_utf8_continuation(bytes[i + 2]) and not (b == 0xE0 and b1 < 0xA0) and not (b == 0xED and b1 >= 0xA0)

fn is_valid_utf8_4(bytes: [u8], i: i64) -> bool:
    val b = bytes[i] as i64
    val b1 = bytes[i + 1] as i64
    is_utf8_continuation(bytes[i + 1]) and is_utf8_continuation(bytes[i + 2]) and is_utf8_continuation(bytes[i + 3]) and not (b == 0xF0 and b1 < 0x90) and not (b == 0xF4 and b1 >= 0x90)

# ============================================================================
# Relocation Patching Functions
# ============================================================================

fn native_reloc_write_i32(address: i64, offset: i64, value: i32):
    """Write a 32-bit value at address+offset (for Pc32/Plt32 relocations)."""
    if address == 0 or offset < 0:
        return
    rt_ptr_write_i32(address, offset, value)

fn native_reloc_write_i64(address: i64, offset: i64, value: i64):
    """Write a 64-bit value at address+offset (for Abs64 relocations)."""
    if address == 0 or offset < 0:
        return
    rt_ptr_write_i64(address, offset, value)

