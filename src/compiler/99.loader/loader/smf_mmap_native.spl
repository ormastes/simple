    owner_free_exec_memory(address, size)

@unsafe(reason: "caller owns executable mapping and write extent", capabilities: [raw_ptr])
fn native_write_exec_memory(address: i64, code: [u8], offset: i64) -> i64:
    owner_write_exec_memory(address, code, offset)

@unsafe(reason: "caller owns mapped-address extent and protection state", capabilities: [raw_ptr])
