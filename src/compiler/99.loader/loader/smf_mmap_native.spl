@unsafe(reason: "caller proves function-pointer signature and lifetime", capabilities: [raw_ptr])
fn native_call_function_2(fn_ptr: i64, arg1: i64, arg2: i64) -> Result<i64, text>:
    owner_call_function_2(fn_ptr, arg1, arg2)

@unsafe(reason: "caller proves function-pointer signature and lifetime", capabilities: [raw_ptr])
fn native_call_function_3(fn_ptr: i64, arg1: i64, arg2: i64, arg3: i64) -> Result<i64, text>:
    owner_call_function_3(fn_ptr, arg1, arg2, arg3)

# Explicit legacy adapters retain the old sentinel-returning API without
# duplicating the executable-call implementation or its ABI validation.
fn compat_native_mmap_file_tuple(path: text, prot: i64, flags: i64, offset: i64, length: i64) -> (i64, i64):
    native_mmap_file(path, prot, flags, offset, length)

@unsafe(reason: "legacy adapter preserves the native-call i64 sentinel contract", capabilities: [raw_ptr])
fn compat_native_call_function_0_i64(fn_ptr: i64) -> i64:
    match owner_call_function_0(fn_ptr):
        case Ok(value): value
        case Err(_): 0

@unsafe(reason: "legacy adapter preserves the native-call i64 sentinel contract", capabilities: [raw_ptr])
fn compat_native_call_function_1_i64(fn_ptr: i64, arg1: i64) -> i64:
    match owner_call_function_1(fn_ptr, arg1):
        case Ok(value): value
        case Err(_): 0

@unsafe(reason: "legacy adapter preserves the native-call i64 sentinel contract", capabilities: [raw_ptr])
fn compat_native_call_function_2_i64(fn_ptr: i64, arg1: i64, arg2: i64) -> i64:
    match owner_call_function_2(fn_ptr, arg1, arg2):
        case Ok(value): value
        case Err(_): 0

@unsafe(reason: "legacy adapter preserves the native-call i64 sentinel contract", capabilities: [raw_ptr])
fn compat_native_call_function_3_i64(fn_ptr: i64, arg1: i64, arg2: i64, arg3: i64) -> i64:
    match owner_call_function_3(fn_ptr, arg1, arg2, arg3):
        case Ok(value): value
        case Err(_): 0

fn native_exec_memory_total() -> i64:
    owner_exec_memory_total()

fn native_exec_memory_count() -> i64:
    owner_exec_memory_count()

# ============================================================================
# Unsafe Syscall Wrappers (Platform-specific)
# ============================================================================
#
# NOTE: legacy unsafe_* stubs removed in favor of runtime SFFI (rt_mmap, etc.).

fn str_from_utf8_lossy_legacy_nul(bytes: [u8]) -> text:
    # Exact pre-optimization decoder retained only for NUL-containing input.
    # Native text concatenation currently has engine-specific embedded-NUL
    # behavior, so this path must remain byte-for-byte unchanged until that
    # runtime contract is fixed across all engines.
    var result = ""
    var i = 0
    while i < bytes.len():
        val b = bytes[i] as i64
        if b < 0x80:
            result = result + char_from_code(b)
            i = i + 1
        elif b >= 0xC2 and b < 0xE0 and i + 1 < bytes.len() and is_utf8_continuation(bytes[i + 1]):
            val b1 = bytes[i + 1] as i64
            result = result + char_from_code(((b & 0x1F) << 6) | (b1 & 0x3F))
            i = i + 2
        elif b >= 0xE0 and b < 0xF0 and i + 2 < bytes.len() and is_valid_utf8_3(bytes, i):
            val b1 = bytes[i + 1] as i64
            val b2 = bytes[i + 2] as i64
            result = result + char_from_code(((b & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F))
            i = i + 3
        elif b >= 0xF0 and b < 0xF5 and i + 3 < bytes.len() and is_valid_utf8_4(bytes, i):
            val b1 = bytes[i + 1] as i64
            val b2 = bytes[i + 2] as i64
            val b3 = bytes[i + 3] as i64
            result = result + char_from_code(((b & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F))
            i = i + 4
        else:
            result = result + "?"
            i = i + 1
    result

pub fn str_from_utf8_lossy(bytes: [u8]) -> text:
    """Convert bytes to string, replacing invalid UTF-8."""
    # Build bounded scalar chunks, then join those chunks once. The previous
    # `result = result + scalar` loop recopied the whole growing prefix on every
    # iteration and was quadratic for long SMF strings. A fixed 64-scalar chunk
    # bounds prefix copying, while retaining only O(n / 64) builder texts.
    # Keeping char_from_code preserves the original cross-engine conversion.
    val byte_count = bytes.len()
    var scan = 0
    while scan < byte_count:
        if bytes[scan] == 0u8:
            return str_from_utf8_lossy_legacy_nul(bytes)
        scan = scan + 1

    var chunks: [text] = []
    var chunk = ""
    var chunk_scalars = 0
    var i = 0
    while i < byte_count:
        val b = bytes[i] as i64
        var scalar = "?"
        var advance = 1
        if b < 0x80:
            scalar = char_from_code(b)
        elif b >= 0xC2 and b < 0xE0 and i + 1 < byte_count and is_utf8_continuation(bytes[i + 1]):
            val b1 = bytes[i + 1] as i64
            scalar = char_from_code(((b & 0x1F) << 6) | (b1 & 0x3F))
            advance = 2
        elif b >= 0xE0 and b < 0xF0 and i + 2 < byte_count and is_valid_utf8_3(bytes, i):
            val b1 = bytes[i + 1] as i64
            val b2 = bytes[i + 2] as i64
            scalar = char_from_code(((b & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F))
            advance = 3
        elif b >= 0xF0 and b < 0xF5 and i + 3 < byte_count and is_valid_utf8_4(bytes, i):
            val b1 = bytes[i + 1] as i64
            val b2 = bytes[i + 2] as i64
            val b3 = bytes[i + 3] as i64
            scalar = char_from_code(((b & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F))
            advance = 4

        chunk = chunk + scalar
        chunk_scalars = chunk_scalars + 1
        if chunk_scalars == 64:
            chunks.push(chunk)
            chunk = ""
            chunk_scalars = 0
        i = i + advance

    if chunk_scalars > 0:
        chunks.push(chunk)
    chunks.join("")

fn is_utf8_continuation(b: u8) -> bool:
    val value = b as i64
    value >= 0x80 and value < 0xC0

fn is_valid_utf8_3(bytes: [u8], i: i64) -> bool:
    val b = bytes[i] as i64
    val b1 = bytes[i + 1] as i64
    is_utf8_continuation(bytes[i + 1]) and is_utf8_continuation(bytes[i + 2]) and not (b == 0xE0 and b1 < 0xA0) and not (b == 0xED and b1 >= 0xA0)

fn is_valid_utf8_4(bytes: [u8], i: i64) -> bool:
    val b = bytes[i] as i64
    val b1 = bytes[i + 1] as i64
    is_utf8_continuation(bytes[i + 1]) and is_utf8_continuation(bytes[i + 2]) and is_utf8_continuation(bytes[i + 3]) and not (b == 0xF0 and b1 < 0x90) and not (b == 0xF4 and b1 >= 0x90)

