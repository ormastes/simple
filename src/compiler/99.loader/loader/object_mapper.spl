# Shared executable object mapper for loader and JIT paths.
#
# Centralizes executable memory allocation and symbol ownership tracking so
# loader/module and JIT flows do not duplicate mmap/write/protect lifecycle.

use .exec_mapping.{exec_mapping_map_rx, exec_mapping_free}
use .smf_mmap_native.{native_reloc_write_i32, native_reloc_write_i64, native_alloc_rw_memory, native_free_exec_memory}
use compiler.backend.linker.smf_reader_memory.{SmfRelocEntry}
use compiler.backend.linker.gpu_smf.smf_reloc_formulas.{smf_reloc_compute_wire}

struct SharedExecMapperConfig:
    verbose: bool

impl SharedExecMapperConfig:
    static fn default() -> SharedExecMapperConfig:
        SharedExecMapperConfig(verbose: false)

struct SharedExecRecord:
    owner_id: text
    symbol: text
    address: i64
    size: i64
    generation: i32
    # Per-module GOT synthesized for this symbol's GotRel32 relocations
    # (lane A4b), if any. 0/0 when the symbol has none. Owned by this
    # record's lifetime: freed alongside `address` on replace and unmap so a
    # GOTPCREL-bearing symbol cannot leak its slot page (doc/08_tracking/bug/
    # smf_gotrel32_applied_as_symbol_value_2026-09-18.md, Fable review of
    # lane A4b commit ac8b46d8af0).
    got_base: i64
    got_size: i64

struct SharedExecMapperStats:
    mapped_symbols: i32
    owner_count: i32
    total_bytes: i64
    generation: i32

class SharedExecMapper:
    config: SharedExecMapperConfig
    records: Dict<text, SharedExecRecord>
    owner_ref_counts: Dict<text, i32>
    mapped_symbol_count: i32
    mapped_owner_count: i32
    total_bytes: i64
    generation: i32

impl SharedExecMapper:
    static fn new(config: SharedExecMapperConfig) -> SharedExecMapper:
        SharedExecMapper(
            config: config,
            records: {},
            owner_ref_counts: {},
            mapped_symbol_count: 0,
            mapped_owner_count: 0,
            total_bytes: 0,
            generation: 0
        )

    me track_owner(owner_id: text):
        if self.owner_ref_counts.has(owner_id):
            self.owner_ref_counts[owner_id] = self.owner_ref_counts[owner_id] + 1
        else:
            self.owner_ref_counts[owner_id] = 1
            self.mapped_owner_count = self.mapped_owner_count + 1

    me untrack_owner(owner_id: text):
        if not self.owner_ref_counts.has(owner_id):
            return
        val remaining = self.owner_ref_counts[owner_id] - 1
        if remaining <= 0:
            # `Dict.remove(k)` returns a NEW dict interpreted but the REMOVED VALUE
            # natively (rt_dict_remove); assigning it back destroys the map on the
            # compiled lane. Rebuild without the key. See doc/08_tracking/bug/
            # dict_remove_return_value_differs_native_vs_interpreter_2026-09-13.md
            var _kept_self_owner_ref_counts: Dict<text, i32> = {}
            for _k in self.owner_ref_counts.keys():
                if _k != owner_id:
                    _kept_self_owner_ref_counts[_k] = self.owner_ref_counts[_k]
            self.owner_ref_counts = _kept_self_owner_ref_counts
            self.mapped_owner_count = self.mapped_owner_count - 1
        else:
            self.owner_ref_counts[owner_id] = remaining

    """Frees a record's code mapping and, if present, its per-module GOT
    slot (lane A4b). Shared by the `map_symbol` replace path and
    `unmap_symbol` so a GOTPCREL-bearing symbol's slot is released
    everywhere its code mapping is -- see `SharedExecRecord.got_base`
    doc comment and Fable review of lane A4b commit ac8b46d8af0.

    `symbol` is the exact key `rec` is (or was) stored under. If the code
    mapping frees but the GOT free then fails, the record at that key is
    updated in place with `address: 0, size: 0` before returning false --
    otherwise a caller that ignores the false and retries (or a second
    caller racing on the same key) would call `exec_mapping_free` again on
    memory that is already gone (double free), per Fable review of lane
    A4b commit 939c924dc16. The GOT itself is left recorded (leaked, not
    corrupted) rather than guessed at."""
    me _free_mapped_resources(symbol: text, rec: SharedExecRecord) -> bool:
        val freed = exec_mapping_free(rec.address, rec.size)
        if not freed:
            return false
        if rec.got_base != 0:
            val got_freed = native_free_exec_memory(rec.got_base, rec.got_size)
            if not got_freed:
                if self.records.has(symbol):
                    self.records[symbol] = SharedExecRecord(
                        owner_id: rec.owner_id,
                        symbol: rec.symbol,
                        address: 0,
                        size: 0,
                        generation: rec.generation,
                        got_base: rec.got_base,
                        got_size: rec.got_size
                    )
                return false
        true

    me map_symbol(owner_id: text, symbol: text, code: [u8], allow_replace: bool) -> Result<i64, text>:
        val code_size = code.len() as i64
        if code_size <= 0:
            return Err("Cannot map empty code for symbol {symbol}")

        # Replace path is allowed for JIT re-instantiation and hot-reload flows.
        if self.records.has(symbol):
            if not allow_replace:
                return Err("Symbol already mapped: {symbol}")
            val old = self.records[symbol]
            if not self._free_mapped_resources(symbol, old):
                return Err("Failed to free existing mapping for {symbol}")
            self.total_bytes = self.total_bytes - old.size
            # `Dict.remove(k)` returns a NEW dict interpreted but the REMOVED VALUE
            # natively (rt_dict_remove); assigning it back destroys the map on the
            # compiled lane. Rebuild without the key. See doc/08_tracking/bug/
            # dict_remove_return_value_differs_native_vs_interpreter_2026-09-13.md
            var _kept_self_records: Dict<text, SharedExecRecord> = {}
            for _k in self.records.keys():
                if _k != symbol:
                    _kept_self_records[_k] = self.records[_k]
            self.records = _kept_self_records
            self.mapped_symbol_count = self.mapped_symbol_count - 1
            self.untrack_owner(old.owner_id)

        val mapped = exec_mapping_map_rx(symbol, code)
        if mapped.is_err():
            return Err(mapped.unwrap_err())
        val fn_ptr = mapped.unwrap()

        self.generation = self.generation + 1
        self.records[symbol] = SharedExecRecord(
            owner_id: owner_id,
            symbol: symbol,
            address: fn_ptr,
            size: code_size,
            generation: self.generation,
            got_base: 0,
            got_size: 0
        )
        self.mapped_symbol_count = self.mapped_symbol_count + 1
        self.track_owner(owner_id)
        self.total_bytes = self.total_bytes + code_size

        if self.config.verbose:
            print "[exec-mapper] mapped {symbol} owner={owner_id} addr=0x{fn_ptr} size={code_size}"

        Ok(fn_ptr)

    fn lookup(symbol: text) -> i64?:
        if self.records.has(symbol):
            return Some(self.records[symbol].address)
        nil

    fn get_record(symbol: text) -> SharedExecRecord?:
        if self.records.has(symbol):
            return Some(self.records[symbol])
        nil

    """Attach a GOT allocation (lane A4b) to an already-mapped symbol's
    record, so it is freed alongside the code mapping on replace/unmap
    instead of leaking.

    `key` MUST be the exact key the code was mapped under (the same key
    passed to `map_symbol`) -- NOT necessarily the plain SMF symbol name.
    Hot reload (module_loader.spl's `moduleloader_replace_live`) maps
    candidate code under a generation-scoped key
    ("{path}#gen{N}:{symbol}"), while the OLD generation's record is still
    present under the plain name until it is explicitly retired; calling
    this with the plain name during a hot reload would attach the NEW
    GOT to the OLD record, which then frees it out from under the live
    candidate on retirement (use-after-free) while the candidate's own
    record keeps `got_base == 0` (never freed) -- Fable review of lane A4b
    commit 939c924dc16.

    `addr` (the mapped code's OWN address, as returned by `map_symbol` /
    stored in the caller's `LoadedSymbol.address`) is verified against the
    record's `address` as a second, independent check: even if `key` were
    wrong, a stale or reused key pointing at a DIFFERENT record's code
    address is refused rather than silently attached. `got_base == 0` on
    the existing record is also required, so a second GOT is never
    silently overwritten (and leaked) by a later call.

    Returns false -- doing nothing -- when the key is unmapped, the address
    does not match, or the record already carries a GOT."""
    me set_got(key: text, addr: i64, got_base: i64, got_size: i64) -> bool:
        if not self.records.has(key):
            return false
        val rec = self.records[key]
        if rec.address != addr or rec.got_base != 0:
            return false
        self.records[key] = SharedExecRecord(
            owner_id: rec.owner_id,
            symbol: rec.symbol,
            address: rec.address,
            size: rec.size,
            generation: rec.generation,
            got_base: got_base,
            got_size: got_size
        )
        true

    me unmap_symbol(symbol: text) -> bool:
        if not self.records.has(symbol):
            return false

        val rec = self.records[symbol]
        if not self._free_mapped_resources(symbol, rec):
            return false

        self.total_bytes = self.total_bytes - rec.size
        # `Dict.remove(k)` returns a NEW dict interpreted but the REMOVED VALUE
        # natively (rt_dict_remove); assigning it back destroys the map on the
        # compiled lane. Rebuild without the key. See doc/08_tracking/bug/
        # dict_remove_return_value_differs_native_vs_interpreter_2026-09-13.md
        var _kept_self_records: Dict<text, SharedExecRecord> = {}
        for _k in self.records.keys():
            if _k != symbol:
                _kept_self_records[_k] = self.records[_k]
        self.records = _kept_self_records
        self.mapped_symbol_count = self.mapped_symbol_count - 1
        self.untrack_owner(rec.owner_id)
        true

    me unmap_owner(owner_id: text) -> i32:
        # BUG-001 fix: Use keys()-based iteration (for (k,v) in dict is broken in compiled mode)
        var symbols: [text] = []
        for symbol in self.records.keys():
            val rec = self.records[symbol]
            if rec.owner_id == owner_id:
                symbols.push(symbol)

        var removed = 0
        for symbol in symbols:
            if self.unmap_symbol(symbol):
                removed = removed + 1

        removed

    me clear():
        # BUG-001 fix: Use keys()-based iteration (for (k,v) in dict is broken in compiled mode)
        var symbols: [text] = []
        for symbol in self.records.keys():
            symbols.push(symbol)

        for symbol in symbols:
            _ = self.unmap_symbol(symbol)

    fn stats() -> SharedExecMapperStats:
        SharedExecMapperStats(
            mapped_symbols: self.mapped_symbol_count,
            owner_count: self.mapped_owner_count,
            total_bytes: self.total_bytes,
            generation: self.generation
        )

# ============================================================================
# Policy wrappers
# ============================================================================

struct LoaderMapperConfig:
    allow_replace_on_reload: bool

impl LoaderMapperConfig:
    static fn default() -> LoaderMapperConfig:
        LoaderMapperConfig(allow_replace_on_reload: false)

struct LoaderMapper:
    config: LoaderMapperConfig

impl LoaderMapper:
    static fn new(config: LoaderMapperConfig) -> LoaderMapper:
        LoaderMapper(config: config)

    me map(exec_mapper: SharedExecMapper, owner_id: text, symbol: text, code: [u8], allow_replace_request: bool) -> Result<i64, text>:
        if allow_replace_request and not self.config.allow_replace_on_reload:
            return Err("Loader replace is disabled for symbol {symbol}")
        exec_mapper.map_symbol(owner_id, symbol, code, allow_replace_request)

    me unmap_owner(exec_mapper: SharedExecMapper, owner_id: text) -> i32:
        exec_mapper.unmap_owner(owner_id)

struct JitMapperConfig:
    default_owner: text
    allow_replace: bool

impl JitMapperConfig:
    static fn default() -> JitMapperConfig:
        JitMapperConfig(
            default_owner: "__jit__",
            allow_replace: true
        )

struct JitMapper:
    config: JitMapperConfig

impl JitMapper:
    static fn new(config: JitMapperConfig) -> JitMapper:
        JitMapper(config: config)

    me map(exec_mapper: SharedExecMapper, owner_id: text, symbol: text, code: [u8]) -> Result<i64, text>:
        val effective_owner = if owner_id == "":
            self.config.default_owner
        else:
            owner_id
        exec_mapper.map_symbol(effective_owner, symbol, code, self.config.allow_replace)

    me unmap_owner(exec_mapper: SharedExecMapper, owner_id: text) -> i32:
        exec_mapper.unmap_owner(owner_id)

# ============================================================================
# Relocation Application
# ============================================================================

"""Resolved symbol entry for relocation."""
struct ResolvedSymbol:
    name: text
    address: i64

"""Per-module GOT allocation synthesized for a symbol's GotRel32
relocations (lane A4b). `base == 0` means no GOT was needed. The caller owns
recording this against the symbol's mapping (`SharedExecMapper.set_got`) so
it is freed alongside the code mapping instead of leaking."""
struct GotAllocation:
    base: i64
    size: i64

"""Resolve a relocation's target symbol address, falling back to the global
symbol table by name when the per-module resolution is unset (address 0)."""
fn _resolve_smf_reloc_symbol(index: i64, symbols: [ResolvedSymbol], global_symbols: Dict<text, i64>) -> i64:
    var sym_addr = 0i64
    if index < symbols.len():
        val sym = symbols[index]
        sym_addr = sym.address
        if sym_addr == 0 and global_symbols.has(sym.name):
            sym_addr = global_symbols[sym.name]
    sym_addr

"""Apply SMF relocations to code loaded at code_addr.

Args:
    code_addr: Base address where code was loaded
    code_size: Size of the code region
    relocs: List of relocation entries from SMF
    symbols: Resolved symbol addresses (index -> ResolvedSymbol)
    global_symbols: Fallback global symbol table (name -> address)

Returns:
    Ok(GotAllocation) on success -- `base == 0` when no GOT was needed;
    otherwise the caller MUST record it against the symbol's mapping (e.g.
    `SharedExecMapper.set_got`) so it is freed alongside the code mapping.
    Err with message on failure; any GOT already allocated in THIS call is
    freed before returning Err, so a failed call never leaks.

Converged (lane A4b, doc/05_design/compiler/linker/mold_mdsocpp_linker_design.md
§4) onto the shared value oracle `smf_reloc_compute_wire`
(compiler.backend.linker.gpu_smf.smf_reloc_formulas): an out-of-i32-range
Rel32/PltRel32/GotRel32/Abs32 delta now REJECTS (Err) instead of the previous
silent `as i32` truncation
(doc/08_tracking/bug/smf_gotrel32_applied_as_symbol_value_2026-09-18.md).

GotRel32 (wire 4) additionally synthesizes a per-module GOT: one 8-byte RW
slot per distinct target symbol, allocated once up front. Lifetime is NOT
owned by this function -- it has no notion of "the symbol's mapping" -- the
returned `GotAllocation` must be attached to that mapping by the caller
(Fable review of lane A4b commit ac8b46d8af0: the previous docstring's claim
of "never freed for the lifetime of the loaded code (same lifetime contract
as the exec mapping)" was false, since nothing recorded or freed it).
R_X86_64_GOTPCREL loads *through* a GOT slot, so S must be the slot's
address (S == G), never the resolved symbol's own address.
"""
fn apply_smf_relocations(
    code_addr: i64,
    code_size: i64,
    relocs: [SmfRelocEntry],
    symbols: [ResolvedSymbol],
    global_symbols: Dict<text, i64>
) -> Result<GotAllocation, text>:
    # Synthesize a per-module GOT for wire-4 sites before patching anything.
    var got_slot_addr: Dict<i64, i64> = {}
    var got_target_indices: [i64] = []
    for reloc in relocs:
        if reloc.reloc_type == 4 and not got_slot_addr.has(reloc.symbol_index):
            got_slot_addr[reloc.symbol_index] = 0
            got_target_indices.push(reloc.symbol_index)

    var got_base = 0i64
    var got_size = 0i64
    if got_target_indices.len() > 0:
        got_size = got_target_indices.len() as i64 * 8
        got_base = native_alloc_rw_memory(got_size)
        if got_base == 0:
            return Err("Failed to allocate GOT for GotRel32 relocations")
        var got_index = 0i64
        var got_fill_error = ""
        for symbol_index in got_target_indices:
            val slot_addr = got_base + got_index * 8
            val got_target_addr = _resolve_smf_reloc_symbol(symbol_index, symbols, global_symbols)
            if got_target_addr == 0:
                got_fill_error = "Unresolved GOT symbol at index {symbol_index}"
                break
            unsafe(capabilities: [raw_ptr]):
                native_reloc_write_i64(slot_addr, 0, got_target_addr)
            got_slot_addr[symbol_index] = slot_addr
            got_index = got_index + 1
        if got_fill_error != "":
            _ = native_free_exec_memory(got_base, got_size)
            return Err(got_fill_error)

    var patch_error = ""
    for reloc in relocs:
        # Validate the complete write width before deriving patch_addr. This
        # prevents both end-of-mapping overrun and address-addition overflow.
        val write_width = if reloc.reloc_type == 1: 8 else: 4
        if code_addr <= 0 or code_size < write_width or reloc.offset < 0 or reloc.offset > code_size - write_width:
            patch_error = "Relocation offset {reloc.offset} with width {write_width} out of bounds (code_size={code_size})"
            break
        if code_addr > 0x7FFFFFFFFFFFFFFF - reloc.offset:
            patch_error = "Relocation address overflow at offset {reloc.offset}"
            break
        val patch_addr = code_addr + reloc.offset

        var sym_addr = _resolve_smf_reloc_symbol(reloc.symbol_index, symbols, global_symbols)
        if sym_addr == 0:
            patch_error = "Unresolved symbol at index {reloc.symbol_index}"
            break

        var reloc_s = sym_addr
        if reloc.reloc_type == 4:
            if not got_slot_addr.has(reloc.symbol_index):
                patch_error = "GotRel32 requires GOT synthesis but no slot found for symbol index {reloc.symbol_index}"
                break
            reloc_s = got_slot_addr[reloc.symbol_index]

        # Wire values: 1=Abs64, 2=Rel32/Pc32, 3=PltRel32/Plt32, 4=GotRel32/GotPcRel, 5=Abs32
        val computed = smf_reloc_compute_wire(reloc.reloc_type as i64, reloc_s, reloc.addend, patch_addr)
        if not computed.ok:
            patch_error = "Relocation value out of range for wire type {reloc.reloc_type} (S={reloc_s}, A={reloc.addend}, P={patch_addr})"
            break
        match reloc.reloc_type:
            1:
                unsafe(capabilities: [raw_ptr]):
                    native_reloc_write_i64(code_addr, reloc.offset, computed.value)
            2:
                unsafe(capabilities: [raw_ptr]):
                    native_reloc_write_i32(code_addr, reloc.offset, computed.value as i32)
            3:
                unsafe(capabilities: [raw_ptr]):
                    native_reloc_write_i32(code_addr, reloc.offset, computed.value as i32)
            4:
                unsafe(capabilities: [raw_ptr]):
                    native_reloc_write_i32(code_addr, reloc.offset, computed.value as i32)
            5:
                unsafe(capabilities: [raw_ptr]):
                    native_reloc_write_i32(code_addr, reloc.offset, computed.value as i32)
            _:
                patch_error = "Unknown relocation type: {reloc.reloc_type}"
                break

    if patch_error != "":
        if got_base != 0:
            _ = native_free_exec_memory(got_base, got_size)
        return Err(patch_error)

    Ok(GotAllocation(base: got_base, size: got_size))

