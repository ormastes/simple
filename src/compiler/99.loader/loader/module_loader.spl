# Module Loader - Runtime SMF loading with type inference.
#
# This module provides runtime module loading capabilities:
# - Load SMF files at runtime
# - JIT instantiation of generics via ObjTaker
# - Module caching and hot-reload support
# - Symbol resolution with type inference
#
# Uses compiler SFFI (compiler_sffi module) for:
# - Type inference (compiler_ctx.infer_types)
# - Template instantiation (compiler_ctx.instantiate)
# Benefits: No circular dependency, clean separation
#
# Cohesion split (2026-08-18): lazy service machinery (ensure_*/created/exec
# allocation) lives in .module_loader_services; semantic-cache bookkeeping in
# .module_loader_semantic. Both are re-exported here so this file remains the
# public surface — zero consumer import changes.

use ..loader.compiler_sffi.*
use ..linker.obj_taker.*
use ..linker.smf_reader.*
use compiler.backend.linker.object_provider.{ObjectProvider, ObjectProviderConfig}
use compiler.backend.linker.smf_reader_memory.{SmfReaderMemory, SmfRelocEntry}
use .object_mapper.{LoaderMapper, LoaderMapperConfig, ResolvedSymbol, apply_smf_relocations}
use .smf_mmap_native.{native_alloc_rw_memory, native_free_exec_memory, native_make_executable, native_make_readonly, native_make_rw, native_flush_icache, native_write_exec_memory, native_call_function_0}
use .jit_instantiator.*
use ..metadata_symbols.{loaded_metadata_instantiation_symbol_names, loaded_metadata_remove_path}
use ..unload_ownership.{owned_global_symbol_names, global_symbols_without_names}
use .resource_lifecycle.{
    ResourceLifecycleManager, LifecycleConfig,
    lifecycle_new, lifecycle_with_defaults,
    lifecycle_on_module_load, lifecycle_on_symbol_mapped,
    lifecycle_on_jit_triggered, lifecycle_on_metadata_loaded,
    lifecycle_unload_module, lifecycle_mark_used, lifecycle_destroy
}
use .smf_cache_manager.{SmfCacheManager, smfcachemanager_with_new_cache}
use .smf_cache.{validated_smf_load}
use os.smf.smf_generation.{GenerationState, CandidateMapping, SymbolSwap, LifecycleManager}

export use .module_loader_services.{
    moduleloader_ensure_compiler_ctx, moduleloader_ensure_obj_taker,
    moduleloader_ensure_provider, moduleloader_ensure_jit,
    moduleloader_ensure_loader_mapper, moduleloader_ensure_lifecycle,
    moduleloader_compiler_ctx_created, moduleloader_obj_taker_created,
    moduleloader_provider_created, moduleloader_jit_service_created,
    moduleloader_loader_mapper_created, moduleloader_lifecycle_created,
    moduleloader_any_heavy_service_created,
    moduleloader_allocate_exec_module, moduleloader_allocate_exec_jit,
    moduleloader_unmap_internal_symbols
}
export use .module_loader_semantic.{
    moduleloader_record_semantic_export, moduleloader_record_semantic_dependency,
    moduleloader_semantic_dependents, moduleloader_record_semantic_fingerprint,
    moduleloader_record_dependency_semantic_fingerprint,
    moduleloader_semantic_cache_is_fresh, moduleloader_semantic_dependents_of,
    moduleloader_drop_semantic_cache_record,
    text_array_contains, text_array_push_unique, text_array_intersects
}
use compiler.loader.mcdc_aspect_binding.{
    McdcAspectBindingState, McdcAspectBinding
}
use compiler.loader.mcdc_aspect_pack_payload.{
    MCDC_ASPECT_VECTOR_SYMBOL_V1, MCDC_ASPECT_VECTOR_ABI_MARKER_V1,
    MCDC_ASPECT_RUNTIME_IMPORT_V1,
    mcdc_validate_aspect_module_payload_v1
}
use std.nogc_sync_mut.io.coverage_mcdc.{
    MCDC_STATUS_OK
}
@unsafe(reason: "loader registers a validated executable symbol into a bounded runtime handle table", capabilities: [ffi, raw_ptr])
extern fn rt_mcdc_dynamic_register_target_v1(target_address: u64,
                                              owner_cookie: u64) -> u64
@unsafe(reason: "loader retires its opaque target handle only after quiescence", capabilities: [ffi, raw_ptr])
extern fn rt_mcdc_dynamic_unregister_target_v1(target_handle: u64,
                                                owner_cookie: u64) -> i32
@unsafe(reason: "loader performs the final allocation-free MC/DC target publication after all metadata is staged", capabilities: [ffi, raw_ptr])
extern fn rt_mcdc_dynamic_bind_v1(target_handle: u64) -> i32
@unsafe(reason: "loader resolves the one allowlisted MC/DC aspect import without generic dlsym", capabilities: [ffi, raw_ptr])
extern fn rt_mcdc_compiled_target_address_v1() -> u64

# ============================================================================
# Loaded Module
# ============================================================================

struct LoadedModule:
    """A loaded SMF module."""
    path: text
    reader: SmfReaderImpl
    symbols: Dict<text, LoadedSymbol>
    load_time: i64
    version: i32

struct LoadedSymbol:
    """A symbol loaded into memory."""
    name: text
    address: i64
    size: i64
    ty: SymbolType
    is_jit: bool
    # Offset within the SMF (for possible reload/relocs)
    file_offset: i64


# ============================================================================
# LoadedModule Methods (was: impl LoadedModule:)
# ============================================================================

# ============================================================================
# Load Result
# ============================================================================

enum LoadResult:
    Success(module: LoadedModule)
    AlreadyLoaded(module: LoadedModule)
    Error(message: text)

enum SymbolResult:
    Found(symbol: LoadedSymbol, code: [u8])
    JitCompiled(symbol: LoadedSymbol, code: [u8])
    NotFound(name: text)
    Error(message: text)

# ============================================================================
# Module Loader Configuration
# ============================================================================

struct LazyModuleLoaderConfig:
    """Configuration for module loading."""
    enable_jit: bool
    enable_cache: bool
    max_cache_size: i32
    verbose: bool
    hot_reload: bool


# ============================================================================
# LazyModuleLoaderConfig Methods (was: impl LazyModuleLoaderConfig:)
# ============================================================================

fn lazymoduleloaderconfig_default() -> LazyModuleLoaderConfig:
        LazyModuleLoaderConfig(
            enable_jit: true,
            enable_cache: true,
            max_cache_size: 100,
            verbose: false,
            hot_reload: false
        )


# ============================================================================
# Module Loader
# ============================================================================

struct LazyModuleLoader:
    """Runtime module loader with JIT instantiation support."""
    # Lazy service cells (startup perf plan Phase D, 2026-08-17): heavy
    # services are NOT created at construction. Each lives at slot 0 of a
    # single-entry Dict cell, created on first use by its ensure_* helper
    # (see .module_loader_services). Dict cells are used (not Option fields)
    # because dict-element writes through a `self` parameter alias correctly
    # in the interpreter, while scalar/Option field writes on a struct
    # parameter are lost.
    # Shared compiler context (SFFI handle)
    compiler_ctx_cell: Dict<i64, CompilerContext>
    # ObjTaker for extraction and instantiation
    obj_taker_cell: Dict<i64, ObjTaker>
    # Shared object provider (finder + instantiator)
    provider_cell: Dict<i64, ObjectProvider>
    # JIT instantiator (also hosts the shared exec mapper)
    jit_cell: Dict<i64, JitInstantiator>
    # Loader policy wrapper over shared exec mapper
    loader_mapper_cell: Dict<i64, LoaderMapper>
    # Resource lifecycle manager cell (owns the SMF cache manager)
    lifecycle_cell: Dict<i64, ResourceLifecycleManager>
    # Loaded modules cache: path -> module
    modules: Dict<text, LoadedModule>
    # Semantic/public-ABI/accessor fingerprint for each loaded artifact.
    semantic_fingerprints: Dict<text, text>
    # Per-module dependency fingerprints: dependent path -> dependency path -> fingerprint.
    dependency_semantic_fingerprints: Dict<text, Dict<text, text>>
    # Global symbol table: name -> (module_path, symbol)
    global_symbols: Dict<text, (text, LoadedSymbol)>
    # Configuration
    config: LazyModuleLoaderConfig
    # Public ABI/accessor semantic keys exported by each loaded module.
    semantic_exports: Dict<text, [text]>
    # Public ABI/accessor semantic keys each module compiled against.
    semantic_dependencies: Dict<text, [text]>
    # Loader-owned dynamic MC/DC bindings keyed by the module whose executable
    # symbol supplies the vector target. No caller may free that module until
    # unbind has published dormancy and all prior readers have settled.
    mcdc_aspect_bindings: Dict<text, McdcAspectBinding>
    # One read-only ABI byte mapping per explicitly activated payload. Empty
    # while disarmed; marker pages are released only after reader settlement.
    mcdc_aspect_marker_pages: Dict<text, (i64, i64)>


# ============================================================================
# LazyModuleLoader Methods (was: impl LazyModuleLoader:)
# ============================================================================

fn lazymoduleloader_new(config: LazyModuleLoaderConfig) -> LazyModuleLoader:
        """Create a new module loader.

        Heavy services (compiler context, ObjTaker, object provider, JIT
        instantiator, loader mapper, lifecycle/cache manager) are created
        lazily on first use — construction only records configuration.
        The enable_jit/enable_cache flags decide whether a service is
        ALLOWED, not when it is built.
        """
        LazyModuleLoader(
            compiler_ctx_cell: {},
            obj_taker_cell: {},
            provider_cell: {},
            jit_cell: {},
            loader_mapper_cell: {},
            lifecycle_cell: {},
            modules: {},
            semantic_fingerprints: {},
            dependency_semantic_fingerprints: {},
            global_symbols: {},
            config: config,
            semantic_exports: {},
            semantic_dependencies: {},
            mcdc_aspect_bindings: {},
            mcdc_aspect_marker_pages: {}
        )

fn moduleloader_bind_mcdc_aspect(self: LazyModuleLoader, path: text,
                                 symbol_name: text,
                                 generation: i64) -> Result<(), text>:
    if symbol_name != "rt_mcdc_aspect_vector_v1":
        return Err("MCDC-ASPECT-E-ABI: expected rt_mcdc_aspect_vector_v1")
    if not self.modules.has(path):
        return Err("MCDC-ASPECT-E-MODULE: module is not loaded: {path}")
    val module = self.modules[path]
    val abi_marker = "rt_mcdc_aspect_vector_v1__abi_u64_u32_u64_u64_u64_u8_i32_v1"
    if not module.symbols.has(symbol_name):
        return Err("MCDC-ASPECT-E-SYMBOL: symbol is not loaded: {symbol_name}")
    if not module.symbols.has(abi_marker):
        return Err("MCDC-ASPECT-E-ABI: exact callable ABI marker is absent")
    val symbol = module.symbols[symbol_name]
    val marker = module.symbols[abi_marker]
    match symbol.ty:
        case SymbolType.Function: ()
        case _:
            return Err("MCDC-ASPECT-E-ABI: vector target is not a function symbol")
    match marker.ty:
        case SymbolType.Constant | SymbolType.Data: ()
        case _:
            return Err("MCDC-ASPECT-E-ABI: callable ABI marker has the wrong symbol kind")
    if symbol.address == 0:
        return Err("MCDC-ASPECT-E-SYMBOL: symbol has a null address")
    if marker.address == 0 or marker.size <= 0:
        return Err("MCDC-ASPECT-E-ABI: callable ABI marker has no mapped payload")
    val target_handle = rt_mcdc_dynamic_register_target_v1(
        symbol.address as u64, generation as u64)
    if target_handle == 0u64:
        return Err("MCDC-ASPECT-E-REGISTRY: target registry is full or rejected the address")
    var binding = self.mcdc_aspect_bindings[path] ?? McdcAspectBinding.dormant()
    val bound = binding.bind(target_handle, generation)
    if bound.is_ok():
        self.mcdc_aspect_bindings[path] = binding
    else:
        _ = rt_mcdc_dynamic_unregister_target_v1(target_handle, generation as u64)
    bound

fn moduleloader_activate_mcdc_aspect_payload_v1(
        self: LazyModuleLoader, owner_id: text, payload: [u8],
        generation: i64) -> Result<(), text>:
    """Map and publish one explicitly selected MC/DC aspect-pack payload.

    This is deliberately not called by loader construction or by a dynamic
    patchpoint.  The caller first routes/selects one outer pack module, then
    supplies its inner-SMF bytes here.  Only the vector code is mapped; the ABI
    marker is validated as data and never consumes an executable page.
    """
    if owner_id == "": return Err("MCDC-ASPECT-E-OWNER: empty payload owner")
    if generation <= 0: return Err("MCDC-ASPECT-E-GENERATION: generation must be positive")
    if self.mcdc_aspect_bindings.has(owner_id):
        return Err("MCDC-ASPECT-E-STATE: payload owner is already active or settling")
    if self.global_symbols.has(MCDC_ASPECT_VECTOR_SYMBOL_V1):
        return Err("MCDC-ASPECT-E-STATE: canonical vector export is already mapped")
    if self.global_symbols.has(MCDC_ASPECT_VECTOR_ABI_MARKER_V1):
        return Err("MCDC-ASPECT-E-STATE: canonical ABI marker is already mapped")
    val checked = mcdc_validate_aspect_module_payload_v1(payload)
    if not checked.ok: return Err(checked.error)

    # Parse and resolve every retained relocation before mapping anything.
    # The converter/validator admits exactly one import spelling and PLT32;
    # no ambient global-symbol dictionary is exposed to an aspect payload.
    val payload_reader_result = SmfReaderMemory.from_data(payload)
    if payload_reader_result.is_err():
        return Err("MCDC-ASPECT-E-SMF: " + payload_reader_result.unwrap_err())
    val payload_reader = payload_reader_result.unwrap()
    val relocs_result = payload_reader.read_relocations()
    if relocs_result.is_err():
        return Err("MCDC-ASPECT-E-RELOC: " + relocs_result.unwrap_err())
    val relocs = relocs_result.unwrap()
    if relocs.len() <= 0 or relocs.len() > 64:
        return Err("MCDC-ASPECT-E-RELOC: retained relocation count is outside 1..64")
    val ordered_result = payload_reader.symbols_in_table_order()
    if ordered_result.is_err():
        return Err("MCDC-ASPECT-E-SYMBOL: " + ordered_result.unwrap_err())
    val ordered = ordered_result.unwrap()
    if ordered.len() > 64:
        return Err("MCDC-ASPECT-E-SYMBOL: symbol table exceeds fixed capacity")
    val collector_raw = rt_mcdc_compiled_target_address_v1()
    if collector_raw == 0u64 or collector_raw > 9223372036854775807u64:
        return Err("MCDC-ASPECT-E-IMPORT: runtime collector address is unavailable")
    # x86_64 movabs r11, imm64; jmp r11. The thunk is retained in the same
    # owner mapping, so every admitted PLT32 call can reach it regardless of
    # ASLR distance to the runtime image. r11 is caller-saved by the SysV ABI.
    var mapped_code = checked.vector_code
    mapped_code.push(0x49u8)
    mapped_code.push(0xBBu8)
    var address_byte = 0
    while address_byte < 8:
        mapped_code.push(((collector_raw >> (address_byte * 8)) & 0xFFu64) as u8)
        address_byte = address_byte + 1
    mapped_code.push(0x41u8)
    mapped_code.push(0xFFu8)
    mapped_code.push(0xE3u8)
    var resolved: [ResolvedSymbol] = []
    var import_count = 0
    var symbol_index = 0
    while symbol_index < ordered.len():
        val symbol_name = ordered[symbol_index].name
        var symbol_address = 0i64
        if symbol_name == MCDC_ASPECT_RUNTIME_IMPORT_V1:
            import_count = import_count + 1
        else:
            if symbol_name != MCDC_ASPECT_VECTOR_SYMBOL_V1 and
                    symbol_name != MCDC_ASPECT_VECTOR_ABI_MARKER_V1:
                return Err("MCDC-ASPECT-E-IMPORT: unexpected inner-SMF symbol " + symbol_name)
        resolved.push(ResolvedSymbol(name: symbol_name, address: symbol_address))
        symbol_index = symbol_index + 1
    if import_count != 1:
        return Err("MCDC-ASPECT-E-IMPORT: inner SMF must name exactly one runtime collector import")
    for reloc in relocs:
        if reloc.symbol_index < 0 or reloc.symbol_index >= resolved.len() or
                resolved[reloc.symbol_index].name != MCDC_ASPECT_RUNTIME_IMPORT_V1:
            return Err("MCDC-ASPECT-E-IMPORT: relocation target is not the allowlisted runtime collector")
        if reloc.reloc_type != 3:
            return Err("MCDC-ASPECT-E-RELOC: aspect payload requires exact PLT32 relocation")
        if reloc.offset < 0 or reloc.offset > checked.vector_code.len() - 4:
            return Err("MCDC-ASPECT-E-RELOC: four-byte patch exceeds vector code")

    val marker_address = native_alloc_rw_memory(checked.marker_bytes.len())
    if marker_address == 0:
        return Err("MCDC-ASPECT-E-MAP: ABI marker mapping failed")
    if native_write_exec_memory(marker_address, checked.marker_bytes, 0) !=
            checked.marker_bytes.len():
        _ = native_free_exec_memory(marker_address, checked.marker_bytes.len())
        return Err("MCDC-ASPECT-E-MAP: ABI marker copy failed")
    if not native_make_readonly(marker_address, checked.marker_bytes.len()):
        _ = native_free_exec_memory(marker_address, checked.marker_bytes.len())
        return Err("MCDC-ASPECT-E-MAP: ABI marker permission hardening failed")

    val lifecycle = moduleloader_ensure_lifecycle(self)
    val jit = moduleloader_ensure_jit(self)
    lifecycle_on_module_load(lifecycle, owner_id, jit.exec_mapper.generation,
        current_time())
    val address = moduleloader_allocate_exec_module(
        self, owner_id, MCDC_ASPECT_VECTOR_SYMBOL_V1,
        mapped_code, false)
    if address == 0:
        _ = native_free_exec_memory(marker_address, checked.marker_bytes.len())
        lifecycle_unload_module(lifecycle, jit.exec_mapper, owner_id)
        return Err("MCDC-ASPECT-E-MAP: vector code mapping failed")

    val import_thunk_address = address + checked.vector_code.len()
    if import_thunk_address < address:
        _ = native_free_exec_memory(marker_address, checked.marker_bytes.len())
        lifecycle_unload_module(lifecycle, jit.exec_mapper, owner_id)
        return Err("MCDC-ASPECT-E-RELOC: import thunk address overflow")
    var resolved_index = 0
    while resolved_index < resolved.len():
        if resolved[resolved_index].name == MCDC_ASPECT_RUNTIME_IMPORT_V1:
            resolved[resolved_index] = ResolvedSymbol(
                name: MCDC_ASPECT_RUNTIME_IMPORT_V1,
                address: import_thunk_address)
        resolved_index = resolved_index + 1

    # Prove the signed PC-relative result before the existing resolver casts
    # it to i32. Both addresses are non-negative, so their difference cannot
    # overflow i64; the guarded addend addition cannot overflow either.
    for reloc in relocs:
        val patch_address = address + reloc.offset
        if patch_address < address:
            _ = native_free_exec_memory(marker_address, checked.marker_bytes.len())
            lifecycle_unload_module(lifecycle, jit.exec_mapper, owner_id)
            return Err("MCDC-ASPECT-E-RELOC: patch address overflow")
        val delta = import_thunk_address - patch_address
        if (reloc.addend > 0 and delta > 9223372036854775807 - reloc.addend) or
                (reloc.addend < 0 and delta < -9223372036854775807 - 1 - reloc.addend):
            _ = native_free_exec_memory(marker_address, checked.marker_bytes.len())
            lifecycle_unload_module(lifecycle, jit.exec_mapper, owner_id)
            return Err("MCDC-ASPECT-E-RELOC: displacement arithmetic overflow")
        val displacement = delta + reloc.addend
        if displacement < -2147483648 or displacement > 2147483647:
            _ = native_free_exec_memory(marker_address, checked.marker_bytes.len())
            lifecycle_unload_module(lifecycle, jit.exec_mapper, owner_id)
            return Err("MCDC-ASPECT-E-RELOC: PLT32 target is outside signed 32-bit reach")
    if not native_make_rw(address, mapped_code.len()):
        _ = native_free_exec_memory(marker_address, checked.marker_bytes.len())
        lifecycle_unload_module(lifecycle, jit.exec_mapper, owner_id)
        return Err("MCDC-ASPECT-E-WX: vector could not enter relocation-only RW state")
    val no_fallback_globals: Dict<text, i64> = {}
    val applied = apply_smf_relocations(
        address, checked.vector_code.len(), relocs, resolved, no_fallback_globals)
    if applied.is_err():
        # Restore non-writable state before unmapping even on a failed patch.
        _ = native_make_executable(address, mapped_code.len())
        _ = native_free_exec_memory(marker_address, checked.marker_bytes.len())
        lifecycle_unload_module(lifecycle, jit.exec_mapper, owner_id)
        return Err("MCDC-ASPECT-E-RELOC: " + applied.unwrap_err())
    if not native_make_executable(address, mapped_code.len()):
        _ = native_free_exec_memory(marker_address, checked.marker_bytes.len())
        lifecycle_unload_module(lifecycle, jit.exec_mapper, owner_id)
        return Err("MCDC-ASPECT-E-WX: vector RX publication failed")
    native_flush_icache(address, mapped_code.len())

    val target_handle = rt_mcdc_dynamic_register_target_v1(
        address as u64, generation as u64)
    if target_handle == 0u64:
        _ = native_free_exec_memory(marker_address, checked.marker_bytes.len())
        lifecycle_unload_module(lifecycle, jit.exec_mapper, owner_id)
        return Err("MCDC-ASPECT-E-REGISTRY: target registry rejected mapped vector")
    # Stage all allocation-capable loader metadata before the final runtime
    # publication. The successful bind is the activation boundary and the
    # function returns immediately afterward.
    self.mcdc_aspect_bindings[owner_id] = McdcAspectBinding(
        state: McdcAspectBindingState.Active,
        target: target_handle,
        generation: generation)
    self.mcdc_aspect_marker_pages[owner_id] = (
        marker_address, checked.marker_bytes.len())
    val symbol = LoadedSymbol(
        name: MCDC_ASPECT_VECTOR_SYMBOL_V1,
        address: address,
        size: checked.vector_code.len(),
        ty: SymbolType.Function,
        is_jit: false,
        file_offset: 0)
    self.global_symbols[MCDC_ASPECT_VECTOR_SYMBOL_V1] = (owner_id, symbol)
    val marker_symbol = LoadedSymbol(
        name: MCDC_ASPECT_VECTOR_ABI_MARKER_V1,
        address: marker_address,
        size: checked.marker_bytes.len(),
        ty: SymbolType.Data,
        is_jit: false,
        file_offset: 0)
    self.global_symbols[MCDC_ASPECT_VECTOR_ABI_MARKER_V1] = (
        owner_id, marker_symbol)
    lifecycle_on_symbol_mapped(lifecycle, owner_id,
        MCDC_ASPECT_VECTOR_SYMBOL_V1)
    val bind_status = rt_mcdc_dynamic_bind_v1(target_handle)
    if bind_status != MCDC_STATUS_OK:
        self.mcdc_aspect_bindings = self.mcdc_aspect_bindings.remove(owner_id)
        self.mcdc_aspect_marker_pages = self.mcdc_aspect_marker_pages.remove(owner_id)
        self.global_symbols = self.global_symbols.remove(MCDC_ASPECT_VECTOR_SYMBOL_V1)
        self.global_symbols = self.global_symbols.remove(MCDC_ASPECT_VECTOR_ABI_MARKER_V1)
        _ = rt_mcdc_dynamic_unregister_target_v1(
            target_handle, generation as u64)
        _ = native_free_exec_memory(marker_address, checked.marker_bytes.len())
        lifecycle_unload_module(lifecycle, jit.exec_mapper, owner_id)
        return Err("MCDC-ASPECT-E-BIND: runtime status {bind_status}")
    Ok(())

fn moduleloader_retire_mcdc_aspect_payload_v1(
        self: LazyModuleLoader, owner_id: text) -> Result<bool, text>:
    """Withdraw, settle, unregister, and only then unmap a pack payload."""
    if not self.mcdc_aspect_bindings.has(owner_id): return Ok(true)
    val retired = moduleloader_retire_mcdc_aspect(self, owner_id)
    if retired.is_err() or not retired.unwrap(): return retired
    if self.global_symbols.has(MCDC_ASPECT_VECTOR_SYMBOL_V1):
        val current = self.global_symbols[MCDC_ASPECT_VECTOR_SYMBOL_V1]
        if current[0] == owner_id:
            self.global_symbols = self.global_symbols.remove(
                MCDC_ASPECT_VECTOR_SYMBOL_V1)
    if self.global_symbols.has(MCDC_ASPECT_VECTOR_ABI_MARKER_V1):
        val current_marker = self.global_symbols[MCDC_ASPECT_VECTOR_ABI_MARKER_V1]
        if current_marker[0] == owner_id:
            self.global_symbols = self.global_symbols.remove(
                MCDC_ASPECT_VECTOR_ABI_MARKER_V1)
    if self.mcdc_aspect_marker_pages.has(owner_id):
        val marker_page = self.mcdc_aspect_marker_pages[owner_id]
        _ = native_free_exec_memory(marker_page[0], marker_page[1])
        self.mcdc_aspect_marker_pages = self.mcdc_aspect_marker_pages.remove(owner_id)
    val lifecycle = moduleloader_ensure_lifecycle(self)
    val jit = moduleloader_ensure_jit(self)
    lifecycle_unload_module(lifecycle, jit.exec_mapper, owner_id)
    Ok(true)


fn lazymoduleloader_with_defaults() -> LazyModuleLoader:
        """Create loader with default configuration."""
        lazymoduleloader_new(lazymoduleloaderconfig_default())


fn moduleloader_load(self: LazyModuleLoader, path: text) -> LoadResult:
        """Load an SMF module.

        If already loaded and hot_reload is disabled, returns existing module.
        If hot_reload is enabled, reloads the module.
        """
        # Check if already loaded
        if self.modules.has(path):
            if not self.config.hot_reload:
                return LoadResult.AlreadyLoaded(module: self.modules[path])
            else:
                return moduleloader_replace_live(self, path)

        if self.config.verbose:
            print "[loader] Loading: {path}"

        # Register with lifecycle manager for resource tracking.
        val lifecycle = moduleloader_ensure_lifecycle(self)
        val jit = moduleloader_ensure_jit(self)
        lifecycle_on_module_load(lifecycle, path, jit.exec_mapper.generation, current_time())

        # Prefer shared object provider so we work for .smf and .lsm inputs.
        val provider = moduleloader_ensure_provider(self)
        var reader_result = provider.get_reader(path)
        if reader_result.is_err():
            # Fallback to direct file reader (legacy path)
            reader_result = SmfReaderImpl.open(path)
            if reader_result.is_err():
                return LoadResult.Error(message: reader_result.unwrap_err())

        val reader = reader_result.unwrap()

        # Build loaded module. Prefer the regular reader, but fall back to the
        # pure Simple in-memory reader when the seed-backed reader cannot expose
        # symbols from a Simple-written SMF.
        var symbols: Dict<text, LoadedSymbol> = {}
        val memory_load_bytes_result = provider.get_module_bytes(path)
        if memory_load_bytes_result.is_ok():
            val memory_reader_result = SmfReaderMemory.from_data(memory_load_bytes_result.unwrap())
            if memory_reader_result.is_ok():
                val memory_reader = memory_reader_result.unwrap()
                for smf_sym in memory_reader.exported_symbols():
                    val code_result = memory_reader.read_code(smf_sym)
                    if code_result.is_err():
                        return LoadResult.Error(message: code_result.unwrap_err())
                    val code = code_result.unwrap()
                    val exec_addr = moduleloader_allocate_exec_module(self, owner_id: path, symbol: smf_sym.name, code: code, allow_replace: false)
                    if exec_addr == 0:
                        return LoadResult.Error(message: "Failed to allocate executable memory for {smf_sym.name}")
                    val loaded_sym = LoadedSymbol(
                        name: smf_sym.name,
                        address: exec_addr,
                        size: smf_sym.size,
                        ty: smf_sym.ty,
                        is_jit: false,
                        file_offset: smf_sym.offset as i64
                    )
                    symbols[smf_sym.name] = loaded_sym
                    self.global_symbols[smf_sym.name] = (path, loaded_sym)
                    lifecycle_on_symbol_mapped(lifecycle, path, smf_sym.name)
        val reader_exports = reader.exported_symbols()
        if symbols.keys().len() == 0 and reader_exports.len() > 0:
            for smf_sym in reader_exports:
                val code_result = reader.read_code(smf_sym)
                if code_result.is_err():
                    return LoadResult.Error(message: code_result.unwrap_err())
                val code = code_result.unwrap()
                val exec_addr = moduleloader_allocate_exec_module(self, owner_id: path, symbol: smf_sym.name, code: code, allow_replace: false)
                if exec_addr == 0:
                    return LoadResult.Error(message: "Failed to allocate executable memory for {smf_sym.name}")
                val loaded_sym = LoadedSymbol(
                    name: smf_sym.name,
                    address: exec_addr,
                    size: smf_sym.size,
                    ty: smf_sym.ty,
                    is_jit: false,
                    file_offset: smf_sym.offset as i64
                )
                symbols[smf_sym.name] = loaded_sym
                self.global_symbols[smf_sym.name] = (path, loaded_sym)
                lifecycle_on_symbol_mapped(lifecycle, path, smf_sym.name)
        if symbols.keys().len() == 0:
            val load_bytes_result = provider.get_module_bytes(path)
            if load_bytes_result.is_err():
                return LoadResult.Error(message: load_bytes_result.unwrap_err())
            val memory_reader_result = SmfReaderMemory.from_data(load_bytes_result.unwrap())
            if memory_reader_result.is_err():
                return LoadResult.Error(message: memory_reader_result.unwrap_err())
            val memory_reader = memory_reader_result.unwrap()
            for smf_sym in memory_reader.exported_symbols():
                val code_result = memory_reader.read_code(smf_sym)
                if code_result.is_err():
                    return LoadResult.Error(message: code_result.unwrap_err())
                val code = code_result.unwrap()
                val exec_addr = moduleloader_allocate_exec_module(self, owner_id: path, symbol: smf_sym.name, code: code, allow_replace: false)
                if exec_addr == 0:
                    return LoadResult.Error(message: "Failed to allocate executable memory for {smf_sym.name}")
                val loaded_sym = LoadedSymbol(
                    name: smf_sym.name,
                    address: exec_addr,
                    size: smf_sym.size,
                    ty: smf_sym.ty,
                    is_jit: false,
                    file_offset: smf_sym.offset as i64
                )
                symbols[smf_sym.name] = loaded_sym
                self.global_symbols[smf_sym.name] = (path, loaded_sym)
                lifecycle_on_symbol_mapped(lifecycle, path, smf_sym.name)

        val module = LoadedModule(
            path: path,
            reader: reader,
            symbols: symbols,
            load_time: current_time(),
            version: 1
        )

        self.modules[path] = module

        # Apply relocations after symbol addresses are installed so patching
        # sees the final module/global symbol table. Use provider-backed bytes
        # so library-resolved module loads relocate against the same SMF data
        # that produced the reader.
        var smf_data_result = provider.get_module_bytes(path)
        if smf_data_result.is_err():
            return LoadResult.Error(message: smf_data_result.unwrap_err())
        val smf_data = smf_data_result.unwrap()
        val reloc_result = moduleloader_apply_relocations(self, path, smf_data)
        if reloc_result.is_err():
            val reloc_error = reloc_result.unwrap_err()
            if self.config.verbose:
                print "[loader] relocation failed for {path}: {reloc_error}"
            moduleloader_unload(self, path)
            return LoadResult.Error(message: reloc_error)

        if symbols.has("rt_mcdc_aspect_vector_v1"):
            val mcdc_bound = moduleloader_bind_mcdc_aspect(
                self, path, "rt_mcdc_aspect_vector_v1", module.version as i64)
            if mcdc_bound.is_err():
                moduleloader_unload(self, path)
                return LoadResult.Error(message: mcdc_bound.unwrap_err())

        if self.config.verbose:
            print "[loader] Loaded {symbols.keys().len()} symbols from {path}"

        LoadResult.Success(module: module)


fn moduleloader_apply_relocations(self: LazyModuleLoader, path: text, smf_data: [u8]) -> Result<(), text>:
        """Apply SMF relocations for a loaded module.

        Reads the Reloc section from SMF data. If relocations exist, temporarily
        makes code memory writable, applies relocations, then restores RX protection.
        For old SMF files without relocations, returns Ok immediately.
        """
        val mem_reader_result = SmfReaderMemory.from_data(smf_data)
        if mem_reader_result.is_err():
            return Err(mem_reader_result.unwrap_err())

        val mem_reader = mem_reader_result.unwrap()
        val relocs_result = mem_reader.read_relocations()
        if relocs_result.is_err():
            return Err(relocs_result.unwrap_err())

        val relocs = relocs_result.unwrap()
        if relocs.len() == 0:
            return Ok(())

        if self.config.verbose:
            print "[loader] Applying {relocs.len()} relocations for {path}"

        # Build symbol resolution table in symbol-index order from the parsed
        # SMF symbol table, then map those names to the loaded module addresses.
        var resolved: [ResolvedSymbol] = []
        val ordered_symbols_result = mem_reader.symbols_in_table_order()
        if ordered_symbols_result.is_err():
            return Err(ordered_symbols_result.unwrap_err())
        for smf_sym in ordered_symbols_result.unwrap():
            val sym_name = smf_sym.name
            var addr = 0i64
            if self.modules.has(path):
                val module = self.modules[path]
                if module.symbols.has(sym_name):
                    addr = module.symbols[sym_name].address
            resolved = resolved.push(ResolvedSymbol(
                name: sym_name,
                address: addr
            ))

        var global_addrs: Dict<text, i64> = {}
        # BUG-001 fix: Use keys()-based iteration (for (k,v) in dict is broken in compiled mode)
        for sym_name in self.global_symbols.keys():
            val entry = self.global_symbols[sym_name]
            val loaded_sym = entry[1]
            global_addrs[sym_name] = loaded_sym.address

        # For each symbol in the loaded module, apply relocations
        if not self.modules.has(path):
            return Err("Module not loaded: {path}")

        val module = self.modules[path]
        # BUG-001 fix: Use keys()-based iteration (for (k,v) in dict is broken in compiled mode)
        for sym_name in module.symbols.keys():
            val loaded_sym = module.symbols[sym_name]
            # Temporarily make memory writable for relocation patching
            val addr = loaded_sym.address
            val size = loaded_sym.size
            if addr == 0 or size == 0:
                continue
            # mprotect to RW for patching
            val rw_ok = native_make_rw(addr, size)
            if not rw_ok:
                return Err("Failed to make memory writable for relocation at {sym_name}")

            # Apply relocations
            val apply_result = apply_smf_relocations(addr, size, relocs, resolved, global_addrs)
            if apply_result.is_err():
                return Err("Relocation failed for {sym_name}: {apply_result.unwrap_err()}")

            # Restore RX protection
            val rx_ok = native_make_executable(addr, size)
            if not rx_ok:
                return Err("Failed to restore RX protection for {sym_name}")
            native_flush_icache(addr, size)

        Ok(())

fn moduleloader_reload(self: LazyModuleLoader, path: text) -> LoadResult:
        """Reload a module (hot reload)."""
        if self.modules.has(path):
            return moduleloader_replace_live(self, path)
        moduleloader_load(self, path)


fn moduleloader_replace_live(self: LazyModuleLoader, path: text) -> LoadResult:
        """Replace a loaded module without removing public symbols first.

        Candidate code is mapped under generation-scoped internal symbol names.
        Public global symbols are swapped only after the candidate has been
        mapped and relocations have succeeded. This avoids the old unload/load
        window where symbols are absent during a hot reload.
        """
        if not self.modules.has(path):
            return moduleloader_load(self, path)

        val old_module = self.modules[path]
        val next_version = old_module.version + 1
        val candidate_prefix = "{path}#gen{next_version}:"

        # Phase-2 wiring: track this replacement as a generation candidate.
        val gen_candidate = GenerationState.candidate(path, next_version)
        var gen_lm = LifecycleManager.new_manager().register_candidate(path, next_version)
        var candidate_map = CandidateMapping.create(candidate_prefix)

        val provider = moduleloader_ensure_provider(self)
        var reader_result = provider.get_reader(path)
        if reader_result.is_err():
            reader_result = SmfReaderImpl.open(path)
            if reader_result.is_err():
                return LoadResult.Error(message: reader_result.unwrap_err())

        val reader = reader_result.unwrap()
        var candidate_symbols: Dict<text, LoadedSymbol> = {}
        var internal_symbols: [text] = []

        for smf_sym in reader.exported_symbols():
            val code_result = reader.read_code(smf_sym)
            if code_result.is_err():
                return LoadResult.Error(message: code_result.unwrap_err())

            val code = code_result.unwrap()
            val internal_name = candidate_prefix + smf_sym.name
            val exec_addr = moduleloader_allocate_exec_module(self, owner_id: path, symbol: internal_name, code: code, allow_replace: false)
            if exec_addr == 0:
                moduleloader_unmap_internal_symbols(self, internal_symbols)
                return LoadResult.Error(message: "Failed to allocate replacement memory for {smf_sym.name}")

            internal_symbols = internal_symbols.push(internal_name)
            candidate_symbols[smf_sym.name] = LoadedSymbol(
                name: smf_sym.name,
                address: exec_addr,
                size: smf_sym.size,
                ty: smf_sym.ty,
                is_jit: false,
                file_offset: smf_sym.offset as i64
            )

        val candidate = LoadedModule(
            path: path,
            reader: reader,
            symbols: candidate_symbols,
            load_time: current_time(),
            version: next_version
        )

        self.modules[path] = candidate

        var smf_data_result = provider.get_module_bytes(path)
        if smf_data_result.is_err():
            self.modules[path] = old_module
            moduleloader_unmap_internal_symbols(self, internal_symbols)
            return LoadResult.Error(message: smf_data_result.unwrap_err())

        val reloc_result = moduleloader_apply_relocations(self, path, smf_data_result.unwrap())
        if reloc_result.is_err():
            self.modules[path] = old_module
            moduleloader_unmap_internal_symbols(self, internal_symbols)
            return LoadResult.Error(message: reloc_result.unwrap_err())

        # Phase-2: mark relocation done, validate imports, then check readiness.
        candidate_map = candidate_map.complete_relocation().validate_imports()
        if not candidate_map.is_ready():
            self.modules[path] = old_module
            moduleloader_unmap_internal_symbols(self, internal_symbols)
            return LoadResult.Error(message: "Candidate not ready after relocation for {path}")

        # Promote candidate generation state.
        val gen_active = gen_candidate.promote()
        gen_lm = gen_lm.promote_candidate()

        # Retire a dynamic MC/DC call target before any old executable symbol
        # can be unmapped. A draining generation is retried by a later reload;
        # this call never blocks or sleeps.
        val retired_mcdc = moduleloader_retire_mcdc_aspect(self, path)
        match retired_mcdc:
            case Err(message):
                self.modules[path] = old_module
                moduleloader_unmap_internal_symbols(self, internal_symbols)
                return LoadResult.Error(message: message)
            case Ok(retired):
                if not retired:
                    self.modules[path] = old_module
                    moduleloader_unmap_internal_symbols(self, internal_symbols)
                    return LoadResult.Error(message: "MCDC-ASPECT-E-DRAINING: prior generation still has readers")

        if candidate_symbols.has("rt_mcdc_aspect_vector_v1"):
            val rebound = moduleloader_bind_mcdc_aspect(
                self, path, "rt_mcdc_aspect_vector_v1", next_version as i64)
            if rebound.is_err():
                self.modules[path] = old_module
                moduleloader_unmap_internal_symbols(self, internal_symbols)
                return LoadResult.Error(message: rebound.unwrap_err())

        # Publish candidate symbols before retiring old executable records so
        # lookups never observe a missing symbol during successful replacement.
        val lifecycle = moduleloader_ensure_lifecycle(self)
        val jit = moduleloader_ensure_jit(self)
        for sym_name in candidate_symbols.keys():
            val loaded_sym = candidate_symbols[sym_name]
            self.global_symbols[sym_name] = (path, loaded_sym)
            lifecycle_on_symbol_mapped(lifecycle, path, sym_name)

        for old_sym in old_module.symbols.keys():
            if not candidate_symbols.has(old_sym):
                self.global_symbols = self.global_symbols.remove(old_sym)
            _ = jit.exec_mapper.unmap_symbol(old_sym)

        # Phase-2: retire the old generation in the lifecycle manager.
        gen_lm = gen_lm.retire(path)
        val _old_gen_retired = GenerationState.loaded(path, old_module.version).retire()

        if self.config.verbose:
            print "[loader] Replaced {path} with generation {next_version} (gen_active={gen_active.to_text()})"

        LoadResult.Success(module: candidate)


fn moduleloader_resolve_symbol(self: LazyModuleLoader, name: text) -> SymbolResult:
        """Resolve a symbol, JIT-compiling if necessary."""
        # Mark symbol as used for generation sweep (LRU tracking).
        lifecycle_mark_used(moduleloader_ensure_lifecycle(self), name)

        # Check global symbol table
        if self.global_symbols.has(name):
            val _destruct_0 = self.global_symbols[name]
            val symbol = _destruct_0[1]

            # Return already-installed executable symbol
            return SymbolResult.Found(symbol: symbol, code: [])

        # Try JIT instantiation. The enable_jit flag gates whether the JIT
        # service may be created at all — disabled config never builds it here.
        if self.config.enable_jit:
            val jit = moduleloader_ensure_jit(self)
            val jit_result = jit.try_jit_instantiate(name)
            match jit_result:
                case Success(code, sym_name, address):
                    var owner_id = "__jit__"
                    val mapped_rec = jit.exec_mapper.get_record(sym_name)
                    if val mapped_value = mapped_rec:
                        if mapped_value != nil:
                            owner_id = mapped_value.owner_id

                    val exec_addr = if address.?:
                        address.unwrap()
                    else:
                        moduleloader_allocate_exec_jit(self, owner_id: owner_id, symbol: sym_name, code: code)
                    if exec_addr == 0:
                        return SymbolResult.Error(message: "Failed to allocate executable memory for {sym_name}")
                    val loaded_sym = LoadedSymbol(
                        name: sym_name,
                        address: exec_addr,
                        size: code_bytes_len(code) as i64,
                        ty: SymbolType.Function,
                        is_jit: true,
                        file_offset: 0
                    )
                    self.global_symbols[sym_name] = (owner_id, loaded_sym)
                    # Track JIT symbol origin for lifecycle-aware unload.
                    lifecycle_on_jit_triggered(moduleloader_ensure_lifecycle(self), owner_id, sym_name)
                    return SymbolResult.JitCompiled(symbol: loaded_sym, code: code)

                case NotFound(n):
                    return SymbolResult.NotFound(name: n)

                case CompilationError(msg):
                    return SymbolResult.Error(message: msg)

                case _("loader returned unknown SymbolResult variant -> fall through to NotFound"):

        SymbolResult.NotFound(name: name)


fn moduleloader_execute_smf(path: text) -> Result<i64, text>:
        """Load an SMF and invoke its exported no-argument main function."""
        val loader = lazymoduleloader_with_defaults()
        match moduleloader_load(loader, path):
            case Success(_):
                moduleloader_execute_loaded_main(loader, path)
            case AlreadyLoaded(_):
                moduleloader_execute_loaded_main(loader, path)
            case Error(message):
                Err("SMF load failed for {path}: {message}")


fn moduleloader_execute_loaded_main(loader: LazyModuleLoader, path: text) -> Result<i64, text>:
        match moduleloader_resolve_symbol(loader, "main"):
            case Found(symbol, _):
                Ok(native_call_function_0(symbol.address))
            case JitCompiled(symbol, _):
                Ok(native_call_function_0(symbol.address))
            case NotFound(_):
                Err("SMF entry point 'main' not found in {path}")
            case Error(message):
                Err("SMF entry point 'main' resolution failed: {message}")


fn moduleloader_resolve_generic(self: LazyModuleLoader, name: text, type_args: [TypeInfo]) -> SymbolResult:
        """Resolve a generic symbol with explicit type arguments."""
        val mangled = mangle_name(name, type_args)

        # Check if already instantiated
        if self.global_symbols.has(mangled):
            return moduleloader_resolve_symbol(self, mangled)

        # Find template in loaded modules
        for _item_1 in self.modules:
            val path = _item_1[0]
            val module = _item_1[1]
            for _item_2 in module.symbols:
                val sym_name = _item_2[0]
                val symbol = _item_2[1]
                if sym_name == name:
                    # Found template - instantiate with ObjTaker
                    val result = moduleloader_ensure_obj_taker(self).take_with_types(
                        module.reader,
                        name,
                        type_args
                    )
                    match result:
                        case Code(bytes, sym, _):
                            val exec_addr = moduleloader_allocate_exec_module(self, owner_id: path, symbol: mangled, code: bytes, allow_replace: false)
                            if exec_addr == 0:
                                return SymbolResult.Error(message: "Failed to allocate executable memory for {mangled}")
                            val loaded_sym = LoadedSymbol(
                                name: mangled,
                                address: exec_addr,
                                size: bytes_len(bytes) as i64,
                                ty: sym.ty,
                                is_jit: true,
                                file_offset: 0
                            )
                            self.global_symbols[mangled] = (path, loaded_sym)
                            # Track generic instantiation for lifecycle-aware unload.
                            val lifecycle = moduleloader_ensure_lifecycle(self)
                            lifecycle_on_symbol_mapped(lifecycle, path, mangled)
                            lifecycle_on_jit_triggered(lifecycle, path, mangled)
                            return SymbolResult.JitCompiled(symbol: loaded_sym, code: bytes)

                        case Error(msg):
                            return SymbolResult.Error(message: msg)

                        case _("instantiate returned unknown ObjTaker variant -> fall through to NotFound"):

        SymbolResult.NotFound(name: mangled)


struct LoaderStats:
    """Loader statistics."""
    module_count: i32
    symbol_count: i32
    jit_stats: JitStats
    cache_stats: CacheStats

# ============================================================================
# Helper Functions
# ============================================================================

fn mangle_name(base: text, type_args: [TypeInfo]) -> text:
    """Mangle a generic name with type arguments."""
    if type_args_is_empty(type_args):
        return base

    val args_str = type_args.map(type_to_string(_)).join("_")
    "{base}${args_str}"

extern fn rt_time_now_unix_micros() -> i64

fn current_time() -> i64:
    """Get current timestamp in microseconds."""
    rt_time_now_unix_micros()

# ============================================================================
# Semantic invalidation + unload lifecycle
# ============================================================================

fn moduleloader_invalidate_semantic_change(self: LazyModuleLoader, changed_key: text) -> [text]:
    """Unload a changed semantic artifact and every transitive dependent.

    `changed_key` may be a loaded module path or an exported semantic key such
    as a public ABI/accessor/field-wrapper fingerprint key. In both cases the
    loader must drop SMF metadata and JIT code that was compiled against the
    old meaning.
    """
    var affected: [text] = []
    affected = text_array_push_unique(affected, changed_key)

    for path in moduleloader_semantic_dependents(self, changed_key):
        affected = text_array_push_unique(affected, path)

    for path in moduleloader_semantic_dependents_of(self, changed_key):
        affected = text_array_push_unique(affected, path)

    # Only touch the JIT service if it was ever created — invalidating an
    # empty cache is a no-op, and creating a JIT just to invalidate it would
    # defeat lazy construction.
    if moduleloader_jit_service_created(self):
        _ = moduleloader_ensure_jit(self).invalidate_by_semantic_key(changed_key)
    var completed: [text] = []
    for path in affected:
        if self.modules.has(path):
            if moduleloader_unload(self, path):
                completed = text_array_push_unique(completed, path)
        else:
            moduleloader_drop_semantic_cache_record(self, path)
            completed = text_array_push_unique(completed, path)
    completed

fn moduleloader_retire_mcdc_aspect(self: LazyModuleLoader,
                                   path: text) -> Result<bool, text>:
    if not self.mcdc_aspect_bindings.has(path): return Ok(true)
    var binding = self.mcdc_aspect_bindings[path]
    match binding.state:
        case McdcAspectBindingState.Active:
            val unbound = binding.unbind()
            if unbound.is_err(): return Err(unbound.unwrap_err())
        case _: ()
    match binding.state:
        case McdcAspectBindingState.Settling:
            val retired_handle = binding.target
            val retired_generation = binding.generation
            match binding.settle():
                case Ok(done):
                    if not done:
                        self.mcdc_aspect_bindings[path] = binding
                        return Ok(false)
                    if rt_mcdc_dynamic_unregister_target_v1(
                            retired_handle,
                            retired_generation as u64) != MCDC_STATUS_OK:
                        binding.target = retired_handle
                        binding.state = McdcAspectBindingState.Settling
                        self.mcdc_aspect_bindings[path] = binding
                        return Ok(false)
                case Err(message): return Err(message)
        case _: ()
    self.mcdc_aspect_bindings = self.mcdc_aspect_bindings.remove(path)
    Ok(true)

fn moduleloader_unload(self: LazyModuleLoader, path: text) -> bool:
    """Unload module and free all associated resources.

    Delegates exec page and SMF cache cleanup to ResourceLifecycleManager,
    then cleans up higher-level bookkeeping:
    1. Exec pages (JIT + loader-mapped) — via lifecycle
    2. SMF cache ref counts — via lifecycle
    3. Global symbol table entries owned by this module
    4. JIT bookkeeping (jit_cache, symbol_table)
    5. JIT symbols mapped under '__jit__' that originated from this module
    6. Template metadata (loaded_metadata) for this module path
    7. Module cache entry
    """
    if not self.modules.has(path):
        return true

    val retired_mcdc = moduleloader_retire_mcdc_aspect(self, path)
    if retired_mcdc.is_err() or not retired_mcdc.unwrap(): return false

    # A loaded module implies the lifecycle and JIT (exec-mapper host)
    # services already exist; ensure_* here is a cheap fetch.
    val lifecycle = moduleloader_ensure_lifecycle(self)
    val jit = moduleloader_ensure_jit(self)

    # 1. Delegate exec page and SMF cache cleanup to lifecycle manager.
    #    Frees JIT-triggered symbols, loader-mapped pages, SMF ref counts.
    lifecycle_unload_module(lifecycle, jit.exec_mapper, path)

    # 2. Collect symbols owned by this module in the global table.
    val owned_symbols = owned_global_symbol_names(self.global_symbols, path)

    # 3. Collect JIT symbols triggered by this module but mapped under "__jit__".
    var jit_symbols_to_free: [text] = []
    for mangled in loaded_metadata_instantiation_symbol_names(jit.loaded_metadata, path):
        if jit.jit_cache.has(mangled):
            jit_symbols_to_free = jit_symbols_to_free.push(mangled)

    # 4. Remove global table entries and JIT bookkeeping for owned symbols.
    #    Exec pages already freed by lifecycle — drop_cached_symbol's unmap is idempotent.
    self.global_symbols = global_symbols_without_names(self.global_symbols, owned_symbols)
    for sym_name in owned_symbols:
        jit.drop_cached_symbol(sym_name)

    # 5. Free JIT symbols triggered by this module but owned by "__jit__".
    self.global_symbols = global_symbols_without_names(self.global_symbols, jit_symbols_to_free)
    for jit_sym in jit_symbols_to_free:
        jit.drop_cached_symbol(jit_sym)

    # 6. Clear template metadata for this module.
    jit.loaded_metadata = loaded_metadata_remove_path(jit.loaded_metadata, path)
    self.semantic_exports = self.semantic_exports.remove(path)
    self.semantic_dependencies = self.semantic_dependencies.remove(path)

    # 7. Remove module from cache.
    moduleloader_drop_semantic_cache_record(self, path)
    self.modules = self.modules.remove(path)
    true

# ============================================================================
# Validated Loading (checks backend/options match)
# ============================================================================

fn moduleloader_load_validated(self: LazyModuleLoader, path: text, backend: text, opt_level: i64, release: bool, debug_info: bool, gc_off: bool, profile: text, allowed_families: [text]) -> LoadResult:
    """Load an SMF module with compile options validation.

    Checks that the cached SMF was compiled with matching backend/options.
    On mismatch, attempts to recompile via watcher client, then retries.
    """
    use compiler.driver.cache.compile_options_hash.{compile_options_hash_compute}
    use compiler.driver.watcher.watcher_client.{check_smf_freshness, get_or_generate_smf}
    use compiler.driver.watcher.watcher_types.{watcher_config_default}
    use compiler.driver.cache.cache_types.{CACHE_FRESH}

    val options_hash = compile_options_hash_compute(backend, opt_level, release, debug_info, gc_off, profile, allowed_families)
    val config = watcher_config_default()

    # Check freshness
    val freshness = check_smf_freshness(path, config.smf_dir, options_hash)
    if freshness.status == CACHE_FRESH:
        return moduleloader_load(self, path)

    # Stale or missing — try to regenerate
    if self.config.verbose:
        print "[loader] SMF stale/missing for {path}: {freshness.detail}"

    val regen_result = get_or_generate_smf(path, path, backend, opt_level, release, debug_info, gc_off, profile, allowed_families)
    if regen_result.is_err():
        return LoadResult.Error(message: "Failed to regenerate SMF: {regen_result.unwrap_err()}")

    # Load the freshly generated SMF
    moduleloader_load(self, regen_result.unwrap())

# ============================================================================
# Exports
# ============================================================================
