# Loader-owned publication for build-prepared dynamic advice slots.
#
# The registry owns visibility and deterministic chain ordering only. Mapping,
# generation state, leases, drain, and unload remain with existing owners.

use compiler.loader.loader.aspect_catalog.{AspectAdviceSummary}
use compiler.common.structural_contracts.facet_artifact.{facet_artifact_text_less}
use compiler.loader.loader.module_loader.{ModuleLoader}
use compiler.loader.loader.smf_mmap_native.{native_call_function_0}
use os.smf.smf_generation.{LifecycleManager, GenerationToken}

struct AdviceBindingAdmission:
    summary: AspectAdviceSummary
    witness_owner_id: text
    resolved_witness_address: i64

struct AdviceBindingRecord:
    publication_id: text
    activation_key: text
    generation: i64
    aspect_id: text
    advice_id: text
    joinpoint_slot_id: text
    form: text
    priority: i64
    specificity: i64
    witness_symbol: text
    witness_owner_id: text
    resolved_witness_address: i64
    capabilities: [text]

struct AdviceBindingCandidate:
    activation_key: text
    generation: i64
    aspect_id: text
    records: [AdviceBindingRecord]

struct AdviceBindingCounters:
    slot_lookups: i64
    slot_hits: i64
    slot_misses: i64
    advice_publications: i64
    advice_unbinds: i64
    disabled_slot_checks: i64
    disabled_slot_branches: i64
    dispatch_attempts: i64
    dispatch_invocations: i64
    dispatch_failures: i64
    around_rejections: i64

# Stable harness descriptor; it deliberately reports a non-zero prepared-slot
# guard and makes no backend byte-size claim.
struct AdviceDisabledPathFootprint:
    dispatch_kind: text
    disabled_footprint_bytes: i64
    disabled_footprint_source: text
    prepared_slot_checks_per_call: i64
    conditional_branches_per_call: i64
    exact_zero_overhead: bool

struct AdviceBindingRegistry:
    prepared_slots: [text]
    records: [AdviceBindingRecord]
    active_publications: Dict<text, text>
    counters: AdviceBindingCounters

struct AdviceLookupResult:
    registry: AdviceBindingRegistry
    chain: [AdviceBindingRecord]

# Immutable backend projection derived from the canonical loader registry.
# Every row retains exact publication/generation and loader ownership identity;
# it cannot be independently published or mutated.
struct AdviceDispatchProjectionEntry:
    slot_id: text
    form: text
    publication_id: text
    activation_key: text
    generation: i64
    witness_symbol: text
    witness_owner_id: text
    resolved_witness_address: i64

struct AdviceDispatchProjection:
    schema_id: text
    schema_version: i64
    entries: [AdviceDispatchProjectionEntry]

struct AdviceProjectionDispatchOutcome:
    registry: AdviceBindingRegistry
    lifecycle: LifecycleManager
    status: text
    reason: text
    invoked_count: i64
    return_values: [i64]
    tokens_acquired: i64
    tokens_released: i64

struct AdviceTokenReleaseOutcome:
    lifecycle: LifecycleManager
    released: i64
    reason: text

fn advice_zero_counters() -> AdviceBindingCounters:
    AdviceBindingCounters(
        slot_lookups: 0, slot_hits: 0, slot_misses: 0,
        advice_publications: 0, advice_unbinds: 0,
        disabled_slot_checks: 0, disabled_slot_branches: 0,
        dispatch_attempts: 0, dispatch_invocations: 0,
        dispatch_failures: 0, around_rejections: 0)

fn advice_disabled_path_footprint() -> AdviceDisabledPathFootprint:
    AdviceDisabledPathFootprint(
        dispatch_kind: "prepared_slot_guard",
        disabled_footprint_bytes: 1,
        disabled_footprint_source: "contract_minimum_not_backend_measurement",
        prepared_slot_checks_per_call: 1,
        conditional_branches_per_call: 1,
        exact_zero_overhead: false)

fn advice_publication_id(activation_key: text, generation: i64) -> text:
    "{activation_key}@{generation}"

fn advice_form_valid(form: text) -> bool:
    form == "before" or form == "after_success" or form == "after_error" or form == "around"

fn advice_record_active(registry: AdviceBindingRegistry, record: AdviceBindingRecord) -> bool:
    registry.active_publications.has(record.aspect_id) and
        registry.active_publications[record.aspect_id] == record.publication_id

fn advice_record_precedes(a: AdviceBindingRecord, b: AdviceBindingRecord) -> bool:
    if a.priority != b.priority:
        return a.priority > b.priority
    if a.specificity != b.specificity:
        return a.specificity > b.specificity
    facet_artifact_text_less(a.witness_symbol, b.witness_symbol)

fn advice_sort_chain(records: [AdviceBindingRecord]) -> [AdviceBindingRecord]:
    var remaining = records
    var ordered: [AdviceBindingRecord] = []
    while remaining.len() > 0:
        var best: i64 = 0
        var i: i64 = 1
        while i < remaining.len():
            if advice_record_precedes(remaining[i], remaining[best]):
                best = i
            i = i + 1
        ordered.push(remaining[best])
        var next: [AdviceBindingRecord] = []
        var j: i64 = 0
        while j < remaining.len():
            if j != best:
                next.push(remaining[j])
            j = j + 1
        remaining = next
    ordered

fn advice_sort_slot_ids(slot_ids: [text]) -> [text]:
    var remaining = slot_ids
    var ordered: [text] = []
    while remaining.len() > 0:
        var best: i64 = 0
        var i: i64 = 1
        while i < remaining.len():
            if facet_artifact_text_less(remaining[i], remaining[best]):
                best = i
            i = i + 1
        ordered.push(remaining[best])
        var next: [text] = []
        var j: i64 = 0
        while j < remaining.len():
            if j != best:
                next.push(remaining[j])
            j = j + 1
        remaining = next
    ordered

fn advice_record_loader_valid(loader: ModuleLoader, record: AdviceBindingRecord) -> bool:
    if (record.witness_owner_id == "" or record.resolved_witness_address <= 0 or
        not loader.global_symbols.has(record.witness_symbol)):
        return false
    val resolved = loader.global_symbols[record.witness_symbol]
    resolved[0] == record.witness_owner_id and
        resolved[1].address == record.resolved_witness_address

# Typed port contract for the future native table/trampoline. Installation must
# be atomic with canonical publication and invalidation must precede drain.
fn advice_dispatch_projection_create(
    registry: AdviceBindingRegistry,
    loader: ModuleLoader
) -> Result<AdviceDispatchProjection, text>:
    var entries: [AdviceDispatchProjectionEntry] = []
    for slot_id in advice_sort_slot_ids(registry.prepared_slots):
        var chain: [AdviceBindingRecord] = []
        for record in registry.records:
            if advice_record_active(registry, record) and record.joinpoint_slot_id == slot_id:
                chain.push(record)
        chain = advice_sort_chain(chain)
        for record in chain:
            if record.form == "around":
                return Err("E-AF010 runtime around advice requires an exactly-once proceed path")
            if not advice_record_loader_valid(loader, record):
                return Err("E-AF010 dynamic advice projection witness is no longer loader-owned: {record.witness_symbol}")
            entries.push(AdviceDispatchProjectionEntry(
                slot_id: record.joinpoint_slot_id,
                form: record.form,
                publication_id: record.publication_id,
                activation_key: record.activation_key,
                generation: record.generation,
                witness_symbol: record.witness_symbol,
                witness_owner_id: record.witness_owner_id,
                resolved_witness_address: record.resolved_witness_address))
    Ok(AdviceDispatchProjection(
        schema_id: "simple.advice-dispatch-projection",
        schema_version: 1,
        entries: entries))

fn advice_dispatch_projection_empty() -> AdviceDispatchProjection:
    AdviceDispatchProjection(
        schema_id: "simple.advice-dispatch-projection",
        schema_version: 1,
        entries: [])

fn advice_dispatch_projection_invalidate(
    projection: AdviceDispatchProjection,
    activation_key: text,
    generation: i64
) -> AdviceDispatchProjection:
    var entries: [AdviceDispatchProjectionEntry] = []
    for entry in projection.entries:
        if entry.activation_key != activation_key or entry.generation != generation:
            entries.push(entry)
    AdviceDispatchProjection(
        schema_id: projection.schema_id,
        schema_version: projection.schema_version,
        entries: entries)

impl AdviceBindingRegistry:
    static fn create(prepared_slots: [text]) -> Result<AdviceBindingRegistry, text>:
        var admitted: [text] = []
        for slot in prepared_slots:
            if slot == "" or admitted.contains(slot):
                return Err("E-AF010 duplicate or empty prepared join-point slot")
            admitted.push(slot)
        Ok(AdviceBindingRegistry(
            prepared_slots: admitted,
            records: [],
            active_publications: {},
            counters: advice_zero_counters()))

fn advice_binding_candidate(
    activation_key: text,
    generation: i64,
    aspect_id: text
) -> Result<AdviceBindingCandidate, text>:
    if activation_key == "" or generation <= 0 or aspect_id == "":
        return Err("E-AF010 advice binding candidate identity is incomplete")
    Ok(AdviceBindingCandidate(
        activation_key: activation_key,
        generation: generation,
        aspect_id: aspect_id,
        records: []))

fn advice_bind_slot(
    registry: AdviceBindingRegistry,
    candidate: AdviceBindingCandidate,
    admission: AdviceBindingAdmission
) -> Result<AdviceBindingCandidate, text>:
    val summary = admission.summary
    if not registry.prepared_slots.contains(summary.joinpoint_slot_id):
        return Err("E-AF010 dynamic advice targets a function without a prepared join point")
    if (summary.advice_id == "" or summary.witness_symbol == "" or
        admission.witness_owner_id == "" or admission.resolved_witness_address <= 0 or
        not advice_form_valid(summary.form) or
        summary.specificity < 0):
        return Err("E-AF010 invalid loaded dynamic advice: {summary.advice_id}")
    if summary.form == "around":
        return Err("E-AF010 runtime around advice requires an exactly-once proceed path")
    for existing in candidate.records:
        if existing.advice_id == summary.advice_id:
            return Err("E-AF010 duplicate staged dynamic advice: {summary.advice_id}")
    var records = candidate.records
    records.push(AdviceBindingRecord(
        publication_id: advice_publication_id(candidate.activation_key, candidate.generation),
        activation_key: candidate.activation_key,
        generation: candidate.generation,
        aspect_id: candidate.aspect_id,
        advice_id: summary.advice_id,
        joinpoint_slot_id: summary.joinpoint_slot_id,
        form: summary.form,
        priority: summary.priority,
        specificity: summary.specificity,
        witness_symbol: summary.witness_symbol,
        witness_owner_id: admission.witness_owner_id,
        resolved_witness_address: admission.resolved_witness_address,
        capabilities: summary.capabilities))
    Ok(AdviceBindingCandidate(
        activation_key: candidate.activation_key,
        generation: candidate.generation,
        aspect_id: candidate.aspect_id,
        records: records))

fn advice_binding_stage_validated(
    registry: AdviceBindingRegistry,
    activation_key: text,
    generation: i64,
    aspect_id: text,
    admissions: [AdviceBindingAdmission]
) -> Result<AdviceBindingCandidate, text>:
    var candidate = advice_binding_candidate(activation_key, generation, aspect_id)?
    for admission in admissions:
        candidate = advice_bind_slot(registry, candidate, admission)?
    Ok(candidate)

# Computes the next immutable publication. The coordinator installs it only
# together with facet visibility and exact lifecycle promotion.
fn advice_publish_generation(
    registry: AdviceBindingRegistry,
    candidate: AdviceBindingCandidate,
    activation_key: text,
    generation: i64
) -> Result<AdviceBindingRegistry, text>:
    if candidate.activation_key != activation_key or candidate.generation != generation:
        return Err("E-AF010 advice publication identity does not match staged generation")
    if candidate.records.len() == 0:
        return Ok(registry)
    val publication_id = advice_publication_id(activation_key, generation)
    if (registry.active_publications.has(candidate.aspect_id) and
        registry.active_publications[candidate.aspect_id] == publication_id):
        return Ok(registry)
    var records = registry.records
    for record in candidate.records:
        records.push(record)
    var active: Dict<text, text> = {}
    for aspect_id in registry.active_publications.keys():
        active[aspect_id] = registry.active_publications[aspect_id]
    active[candidate.aspect_id] = publication_id
    var counters = registry.counters
    counters.advice_publications = counters.advice_publications + 1
    Ok(AdviceBindingRegistry(
        prepared_slots: registry.prepared_slots,
        records: records,
        active_publications: active,
        counters: counters))

# Prepared dispatch lookup. The returned chain is already in the same order as
# static AOP: priority desc, specificity desc, then witness name ascending.
fn advice_lookup_slot(registry: AdviceBindingRegistry, slot_id: text) -> Result<AdviceLookupResult, text>:
    if not registry.prepared_slots.contains(slot_id):
        return Err("E-AF010 advice lookup used an unprepared join-point slot")
    var chain: [AdviceBindingRecord] = []
    for record in registry.records:
        if advice_record_active(registry, record) and record.joinpoint_slot_id == slot_id:
            chain.push(record)
    chain = advice_sort_chain(chain)
    var counters = registry.counters
    counters.slot_lookups = counters.slot_lookups + 1
    counters.disabled_slot_checks = counters.disabled_slot_checks + 1
    counters.disabled_slot_branches = counters.disabled_slot_branches + 1
    if chain.len() == 0:
        counters.slot_misses = counters.slot_misses + 1
    else:
        counters.slot_hits = counters.slot_hits + 1
    Ok(AdviceLookupResult(
        registry: AdviceBindingRegistry(
            prepared_slots: registry.prepared_slots,
            records: registry.records,
            active_publications: registry.active_publications,
            counters: counters),
        chain: chain))

fn advice_projection_release_tokens(
    lifecycle: LifecycleManager,
    tokens: [GenerationToken]
) -> AdviceTokenReleaseOutcome:
    var next = lifecycle
    var released: i64 = 0
    var reason = ""
    var i = tokens.len()
    while i > 0:
        i = i - 1
        val release = next.release_generation_token(tokens[i])
        if release.is_err():
            if reason == "":
                reason = release.unwrap_err()
            else:
                reason = "{reason}; {release.unwrap_err()}"
        else:
            next = release.unwrap()
            released = released + 1
    AdviceTokenReleaseOutcome(
        lifecycle: next, released: released, reason: reason)

fn advice_projection_dispatch_failed(
    registry: AdviceBindingRegistry,
    lifecycle: LifecycleManager,
    tokens: [GenerationToken],
    acquired: i64,
    invoked: i64,
    reason: text,
    around_rejected: bool,
    released_before_failure: i64
) -> AdviceProjectionDispatchOutcome:
    val release = advice_projection_release_tokens(lifecycle, tokens)
    var final_reason = reason
    if release.reason != "":
        final_reason = "{reason}; exact generation token release failed: {release.reason}"
    var counters = registry.counters
    counters.dispatch_failures = counters.dispatch_failures + 1
    if around_rejected:
        counters.around_rejections = counters.around_rejections + 1
    AdviceProjectionDispatchOutcome(
        registry: AdviceBindingRegistry(
            prepared_slots: registry.prepared_slots,
            records: registry.records,
            active_publications: registry.active_publications,
            counters: counters),
        lifecycle: release.lifecycle,
        status: "failed",
        reason: final_reason,
        invoked_count: invoked,
        return_values: [],
        tokens_acquired: acquired,
        tokens_released: released_before_failure + release.released)

fn advice_native_invoke(address: i64) -> Result<i64, text>:
    if address <= 0:
        return Err("E-AF010 dynamic advice witness address is invalid")
    Ok(native_call_function_0(address))

# Exact-generation prepared dispatch. Every projected callback is pinned before
# validation or invocation, and every acquired opaque token is released on all
# success and failure paths.
fn advice_dispatch_projection_with_invoker(
    projection: AdviceDispatchProjection,
    registry: AdviceBindingRegistry,
    lifecycle: LifecycleManager,
    loader: ModuleLoader,
    slot_id: text,
    form: text,
    invoke: fn(i64) -> Result<i64, text>
) -> AdviceProjectionDispatchOutcome:
    var attempted = registry
    attempted.counters.dispatch_attempts = attempted.counters.dispatch_attempts + 1
    if form == "around":
        return advice_projection_dispatch_failed(
            attempted, lifecycle, [], 0, 0,
            "E-AF010 runtime around advice requires an exactly-once proceed path", true, 0)
    if not (form == "before" or form == "after_success" or form == "after_error"):
        return advice_projection_dispatch_failed(
            attempted, lifecycle, [], 0, 0,
            "E-AF010 invalid dynamic advice dispatch form", false, 0)
    if projection.schema_id != "simple.advice-dispatch-projection" or projection.schema_version != 1:
        return advice_projection_dispatch_failed(
            attempted, lifecycle, [], 0, 0,
            "E-AF010 dynamic advice projection schema is invalid", false, 0)

    var projected: [AdviceDispatchProjectionEntry] = []
    for entry in projection.entries:
        if entry.slot_id == slot_id and entry.form == form:
            projected.push(entry)

    var pinned = lifecycle
    var tokens: [GenerationToken] = []
    for entry in projected:
        val acquired = pinned.acquire_generation_token_for(
            entry.activation_key, entry.generation)
        if acquired.is_err():
            return advice_projection_dispatch_failed(
                attempted, pinned, tokens, tokens.len(), 0,
                "E-AF010 dynamic advice generation is stale or unpublished: {acquired.unwrap_err()}", false, 0)
        val pinned_entry = acquired.unwrap()
        pinned = pinned_entry.0
        tokens.push(pinned_entry.1)

    val lookup = advice_lookup_slot(attempted, slot_id)
    if lookup.is_err():
        return advice_projection_dispatch_failed(
            attempted, pinned, tokens, tokens.len(), 0,
            lookup.unwrap_err(), false, 0)
    val looked_up = lookup.unwrap()
    var visible = looked_up.registry
    var canonical: [AdviceBindingRecord] = []
    for record in looked_up.chain:
        if record.form == form:
            canonical.push(record)
    if canonical.len() != projected.len():
        return advice_projection_dispatch_failed(
            visible, pinned, tokens, tokens.len(), 0,
            "E-AF010 dynamic advice projection does not match canonical publication", false, 0)

    var index: i64 = 0
    while index < canonical.len():
        val record = canonical[index]
        val entry = projected[index]
        if (entry.publication_id != record.publication_id or
            entry.activation_key != record.activation_key or
            entry.generation != record.generation or
            entry.witness_symbol != record.witness_symbol or
            entry.witness_owner_id != record.witness_owner_id or
            entry.resolved_witness_address != record.resolved_witness_address):
            return advice_projection_dispatch_failed(
                visible, pinned, tokens, tokens.len(), 0,
                "E-AF010 dynamic advice projection entry is stale or forged", false, 0)
        if not advice_record_loader_valid(loader, record):
            return advice_projection_dispatch_failed(
                visible, pinned, tokens, tokens.len(), 0,
                "E-AF010 dynamic advice witness is no longer loader-owned: {record.witness_symbol}", false, 0)
        index = index + 1

    var results: [i64] = []
    var invoked: i64 = 0
    for entry in projected:
        val result = invoke(entry.resolved_witness_address)
        if result.is_err():
            return advice_projection_dispatch_failed(
                visible, pinned, tokens, tokens.len(), invoked,
                "E-AF010 dynamic advice callback failed: {result.unwrap_err()}", false, 0)
        results.push(result.unwrap())
        invoked = invoked + 1

    val release = advice_projection_release_tokens(pinned, tokens)
    if release.reason != "":
        return advice_projection_dispatch_failed(
            visible, release.lifecycle, [], tokens.len(), invoked,
            "E-AF010 exact generation token release failed: {release.reason}",
            false, release.released)
    visible.counters.dispatch_invocations = visible.counters.dispatch_invocations + invoked
    AdviceProjectionDispatchOutcome(
        registry: visible,
        lifecycle: release.lifecycle,
        status: "dispatched",
        reason: "",
        invoked_count: invoked,
        return_values: results,
        tokens_acquired: tokens.len(),
        tokens_released: release.released)

fn advice_dispatch_projection(
    projection: AdviceDispatchProjection,
    registry: AdviceBindingRegistry,
    lifecycle: LifecycleManager,
    loader: ModuleLoader,
    slot_id: text,
    form: text
) -> AdviceProjectionDispatchOutcome:
    advice_dispatch_projection_with_invoker(
        projection, registry, lifecycle, loader, slot_id, form,
        advice_native_invoke)

# Removes visibility before lifecycle drain; it never owns or waits on pins.
fn advice_unbind_generation(
    registry: AdviceBindingRegistry,
    activation_key: text,
    generation: i64
) -> AdviceBindingRegistry:
    val publication_id = advice_publication_id(activation_key, generation)
    var records: [AdviceBindingRecord] = []
    var removed = false
    for record in registry.records:
        if record.publication_id == publication_id:
            removed = true
        else:
            records.push(record)
    var active: Dict<text, text> = {}
    for aspect_id in registry.active_publications.keys():
        if registry.active_publications[aspect_id] != publication_id:
            active[aspect_id] = registry.active_publications[aspect_id]
    var counters = registry.counters
    if removed:
        counters.advice_unbinds = counters.advice_unbinds + 1
    AdviceBindingRegistry(
        prepared_slots: registry.prepared_slots,
        records: records,
        active_publications: active,
        counters: counters)

export AdviceBindingAdmission, AdviceBindingRecord, AdviceBindingCandidate
export AdviceBindingCounters, AdviceDisabledPathFootprint
export AdviceBindingRegistry, AdviceLookupResult
export AdviceDispatchProjectionEntry, AdviceDispatchProjection
export AdviceProjectionDispatchOutcome
export advice_binding_candidate, advice_bind_slot, advice_binding_stage_validated
export advice_publish_generation, advice_lookup_slot, advice_unbind_generation
export advice_dispatch_projection_create
export advice_dispatch_projection_empty, advice_dispatch_projection_invalidate
export advice_dispatch_projection, advice_dispatch_projection_with_invoker
export advice_disabled_path_footprint
