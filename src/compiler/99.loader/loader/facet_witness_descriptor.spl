# Loader resolution for inert facet witness descriptors.

use compiler.loader.loader.module_loader.{ModuleLoader}
use compiler.common.structural_contracts.facet_artifact.{
    FACET_WITNESS_DESCRIPTOR_VERSION,
    FacetWitnessMethodEntry, FacetWitnessDescriptorV1
}

fn facet_resolve_witness_descriptor(
    loader: ModuleLoader,
    owner_id: text,
    expected_abi_hash: text,
    descriptor: FacetWitnessDescriptorV1
) -> Result<FacetWitnessDescriptorV1, text>:
    if owner_id == "" or expected_abi_hash == "":
        return Err("E-AF002 facet witness resolution identity is incomplete")
    if descriptor.descriptor_version != FACET_WITNESS_DESCRIPTOR_VERSION:
        return Err("E-AF002 unsupported facet witness descriptor version")
    if descriptor.facet_contract_abi_hash != expected_abi_hash:
        return Err("E-AF002 facet witness descriptor ABI hash mismatch")
    if descriptor.descriptor_symbol == "":
        return Err("E-AF002 facet witness descriptor symbol is empty")
    if descriptor.owner_id != "":
        return Err("E-AF002 serialized facet witness descriptor contains runtime ownership")
    if descriptor.method_entries.len() == 0:
        return Err("E-AF002 facet witness descriptor has no executable methods")
    var names: [text] = []
    var symbols: [text] = []
    var resolved: [FacetWitnessMethodEntry] = []
    for method in descriptor.method_entries:
        if method.method_name == "" or method.method_symbol == "":
            return Err("E-AF002 facet witness method identity is incomplete")
        if method.resolved_address != 0:
            return Err("E-AF002 serialized facet witness method contains a runtime address")
        if names.contains(method.method_name) or symbols.contains(method.method_symbol):
            return Err("E-AF002 duplicate facet witness method entry")
        if method.method_symbol != descriptor.descriptor_symbol + "__" + method.method_name:
            return Err("E-AF002 noncanonical facet witness method symbol: {method.method_symbol}")
        if not loader.global_symbols.has(method.method_symbol):
            return Err("E-AF002 loaded facet witness method is missing: {method.method_symbol}")
        val loaded = loader.global_symbols[method.method_symbol]
        if loaded[0] != owner_id:
            return Err("E-AF002 loaded facet witness method owner mismatch: {method.method_symbol}")
        if loaded[1].address <= 0:
            return Err("E-AF002 loaded facet witness method has no executable address: {method.method_symbol}")
        names = names.push(method.method_name)
        symbols = symbols.push(method.method_symbol)
        resolved = resolved.push(FacetWitnessMethodEntry(
            method_name: method.method_name,
            method_symbol: method.method_symbol,
            resolved_address: loaded[1].address))
    Ok(FacetWitnessDescriptorV1(
        descriptor_version: descriptor.descriptor_version,
        facet_contract_abi_hash: descriptor.facet_contract_abi_hash,
        descriptor_symbol: descriptor.descriptor_symbol,
        owner_id: owner_id,
        method_entries: resolved))

export facet_resolve_witness_descriptor
