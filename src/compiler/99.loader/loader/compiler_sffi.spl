# Compiler Context - Pure Simple Implementation
#
# This module provides type inference and template instantiation functionality
# implemented entirely in Simple, without Rust SFFI dependencies.
#
# Architecture:
# - CompilerContext: Opaque handle wrapper
# - CompilerContextImpl: Manages type inference state
# - Type inference: Simplified Hindley-Milner with constraint solving
# - Template instantiation: Placeholder bytecode generation
# - All implemented in Simple for self-hosting

use common.string_builder.{StringBuilder}
use common.text_advanced.{escape_json}

# ============================================================================
# Compiler Context Handle (Public API)
# ============================================================================

struct CompilerContext:
    """Opaque handle to compiler context.

    Wrapper around i64 handle for type safety.
    """
    handle: i64


# ============================================================================
# CompilerContext Methods (was: impl CompilerContext:)
# ============================================================================

fn compilercontext_create() -> CompilerContext:
        """Create a new compiler context.

        Returns: CompilerContext with opaque handle
        """
        val handle = compiler_create_context()
        CompilerContext(handle: handle)

impl CompilerContext:
    static fn create() -> CompilerContext:
        compilercontext_create()


# ============================================================================
# Compiler Context Implementation (Internal)
# ============================================================================

val COMPILER_SFFI_CACHE_LIMIT: i64 = 4096

fn sffi_type_tag_valid(tag: u8) -> bool:
    tag == 0x00 or tag == 0x10 or tag == 0x11 or tag == 0x20 or
        tag == 0x30 or tag == 0x40 or tag == 0x50 or tag == 0x60 or
        tag == 0x70

fn sffi_value_type_tag_valid(tag: u8) -> bool:
    tag != 0x00 and sffi_type_tag_valid(tag)

fn sffi_type_encoding_valid(ty: TypeInfo) -> bool:
    if not sffi_value_type_tag_valid(_type_to_tag(ty)):
        return false
    if ty.has_bits and (ty.bits <= 0 or ty.bits > 64):
        return false
    if ty.has_lanes and (ty.lanes <= 0 or ty.lanes > 255):
        return false
    true

class CompilerContextImpl:
    """Compiler context for type inference and template instantiation.

    State:
    - type_cache: Cache of inferred types
    - instantiation_cache: Cache of compiled templates
    - stats: Statistics for cache hits/misses
    """
    type_cache: Dict<text, [TypeInfo]>
    instantiation_cache: Dict<text, [u8]>
    type_cache_keys: [text]
    instantiation_cache_keys: [text]
    type_cache_evict_index: i64
    instantiation_cache_evict_index: i64
    type_cache_count: i64
    instantiation_cache_count: i64
    stats: ContextStats
    next_type_var: i64

    me cache_inferred_types(key: text, inferred: [TypeInfo]):
        if not self.type_cache.contains(key):
            if self.type_cache_count >= COMPILER_SFFI_CACHE_LIMIT:
                val victim = self.type_cache_keys[self.type_cache_evict_index]
                self.type_cache = self.type_cache.remove(victim)
                self.type_cache_keys[self.type_cache_evict_index] = key
                self.type_cache_evict_index = (self.type_cache_evict_index + 1) % COMPILER_SFFI_CACHE_LIMIT
            else:
                self.type_cache_keys.push(key)
                self.type_cache_count = self.type_cache_count + 1
        self.type_cache[key] = inferred

    me cache_instantiation(key: text, code: [u8]):
        if not self.instantiation_cache.contains(key):
            if self.instantiation_cache_count >= COMPILER_SFFI_CACHE_LIMIT:
                val victim = self.instantiation_cache_keys[self.instantiation_cache_evict_index]
                self.instantiation_cache = self.instantiation_cache.remove(victim)
                self.instantiation_cache_keys[self.instantiation_cache_evict_index] = key
                self.instantiation_cache_evict_index = (self.instantiation_cache_evict_index + 1) % COMPILER_SFFI_CACHE_LIMIT
            else:
                self.instantiation_cache_keys.push(key)
                self.instantiation_cache_count = self.instantiation_cache_count + 1
        self.instantiation_cache[key] = code

    me infer_types(tmpl: SffiTemplate, hints: [TypeHint]) -> [TypeInfo]:
        """Infer type arguments for a generic template.

        Args:
            template: Template metadata
            hints: Type hints from call sites

        Returns:
            Inferred types for type parameters
        """
        # Check cache
        val cache_key = inference_cache_key(tmpl, hints)
        if self.type_cache.contains(cache_key):
            self.stats.cache_hits = self.stats.cache_hits + 1
            return self.type_cache[cache_key]

        self.stats.cache_misses = self.stats.cache_misses + 1
        self.stats.type_inferences = self.stats.type_inferences + 1

        # Simple inference: extract types from hints
        var inferred: [TypeInfo] = []
        var found_type: TypeInfo = nil
        var found = false

        for hint in hints:
            if hint.source == "call_site":
                found_type = hint.ty
                found = true
                break

        val inferred_type = if found:
            found_type
        else:
            TypeInfo(
                kind: "int",
                name: "i64",
                has_bits: true,
                bits: 64,
                has_signed: true,
                signed: true,
                has_lanes: false,
                lanes: 0,
                args: [],
                has_elem: false,
                elem: nil
            )

        var param_index = 0
        while param_index < tmpl.type_params.len():
            inferred = inferred.push(inferred_type)
            param_index = param_index + 1

        # Cache result
        self.cache_inferred_types(cache_key, inferred)
        inferred

    me instantiate_template(tmpl: SffiTemplate, type_args: [TypeInfo]) -> CompilationResult:
        """Instantiate a generic template with concrete type arguments.

        Args:
            template: Template metadata
            type_args: Concrete type arguments

        Returns:
            Compilation result with code or error
        """
        # Arity and indices are encoded as one byte. Reject impossible requests
        # before allocating a structural key or touching cache statistics.
        if tmpl.type_params.len() != type_args.len():
            return CompilationResult(
                success: false, code: [], has_error: true,
                error: "template type argument arity mismatch"
            )
        if type_args.len() > 255:
            return CompilationResult(
                success: false, code: [], has_error: true,
                error: "template type argument count exceeds bytecode limit"
            )
        if tmpl.has_return_type and not sffi_type_encoding_valid(tmpl.return_type):
            return CompilationResult(
                success: false, code: [], has_error: true,
                error: "unsupported template return type"
            )
        for type_arg in type_args:
            if not sffi_type_encoding_valid(type_arg):
                return CompilationResult(
                    success: false, code: [], has_error: true,
                    error: "unsupported template type argument"
                )

        # Check cache
        val cache_key = instantiation_cache_key(tmpl, type_args)
        if self.instantiation_cache.contains(cache_key):
            self.stats.cache_hits = self.stats.cache_hits + 1
            return CompilationResult(
                success: true,
                code: self.instantiation_cache[cache_key],
                error: nil
            )

        self.stats.cache_misses = self.stats.cache_misses + 1
        self.stats.template_instantiations = self.stats.template_instantiations + 1

        # Generate specialized bytecode for the instantiated template
        # Bytecode format:
        #   [0x00] FUNC_ENTRY: param_count(1) return_type_tag(1)
        #   [0x01..N] TYPED_PARAM: type_tag(1) size_bytes(1) for each param
        #   [0x10] BODY_START
        #   [0x20..] OPERATIONS: type-specialized ops
        #   [0xFE] FUNC_EXIT
        #   [0xFF] TYPE_INFO: kind(1) bits(1) - metadata section
        var code: [u8] = []

        # Function entry header
        val param_count = tmpl.type_params.len()
        code.push(0x00)  # FUNC_ENTRY opcode
        code.push(param_count as u8)

        # Encode return type if present
        if tmpl.has_return_type:
            val rt_tag = _type_to_tag(tmpl.return_type)
            code.push(rt_tag)
        else:
            code.push(0x00)  # void return

        # Encode each type parameter with its concrete type
        var ti = 0
        while ti < type_args.len():
            val ty = type_args[ti]
            code.push(0x01)  # TYPED_PARAM opcode
            val tag = _type_to_tag(ty)
            code.push(tag)
            val size_byte = _type_size_bytes(ty)
            code.push(size_byte)
            ti = ti + 1

        # Body start marker
        code.push(0x10)

        # Generate type-specialized operations
        # For each type param, emit load/store ops with correct widths
        var pi = 0
        while pi < type_args.len():
            val ty = type_args[pi]
            code.push(0x20)  # LOAD_TYPED opcode
            code.push(pi as u8)  # param index
            code.push(_type_to_tag(ty))
            pi = pi + 1

        # Function exit
        code.push(0xFE)

        # Metadata section: type info for each specialization
        for ty in type_args:
            code.push(0xFF)  # Type marker
            code.push(_type_to_tag(ty))

        # Cache result
        self.cache_instantiation(cache_key, code)

        CompilationResult(
            success: true,
            code: code,
            has_error: false,
            error: ""
        )

    fn check_types(code: [u8]) -> bool:
        """Type check bytecode.

        Validates bytecode structure and type consistency:
        1. Must start with FUNC_ENTRY (0x00)
        2. TYPED_PARAM (0x01) entries must have valid type tags
        3. Must contain BODY_START (0x10) marker
        4. LOAD_TYPED (0x20) param indices must be in range
        5. Must end with FUNC_EXIT (0xFE) before metadata

        Args:
            code: Bytecode to check

        Returns:
            true if type-correct
        """
        val code_len = code.len()
        if code_len < 4:
            return false  # Too short for valid bytecode

        # Check FUNC_ENTRY header
        if code[0] != 0x00:
            return false  # Must start with FUNC_ENTRY
        if not sffi_type_tag_valid(code[2]):
            return false  # Invalid return type tag

        val param_count = code[1] as i64

        # Walk bytecode and validate structure
        var i = 3  # Skip FUNC_ENTRY + param_count + return_type
        var found_body_start = false
        var found_func_exit = false
        var typed_params_seen = 0
        var loads_seen = 0
        var metadata_seen = 0

        while i < code_len:
            val opcode = code[i]

            if opcode == 0x01:
                # TYPED_PARAM: tag(1) size(1)
                if found_body_start or found_func_exit:
                    return false
                if i + 2 >= code_len:
                    return false
                val tag = code[i + 1]
                if not sffi_value_type_tag_valid(tag):
                    return false
                val size = code[i + 2]
                if size != 1 and size != 2 and size != 4 and size != 8:
                    return false
                if typed_params_seen >= param_count:
                    return false
                typed_params_seen = typed_params_seen + 1
                i = i + 3
            elif opcode == 0x10:
                # BODY_START
                if found_body_start or found_func_exit or typed_params_seen != param_count:
                    return false
                found_body_start = true
                i = i + 1
            elif opcode == 0x20:
                # LOAD_TYPED: param_index(1) type_tag(1)
                if not found_body_start or found_func_exit:
                    return false
                if i + 2 >= code_len:
                    return false
                val param_idx = code[i + 1] as i64
                if param_idx != loads_seen or param_idx >= param_count:
                    return false  # Loads are complete and producer-ordered.
                if not sffi_value_type_tag_valid(code[i + 2]):
                    return false
                val parameter_tag_offset = 4 + param_idx * 3
                if code[i + 2] != code[parameter_tag_offset]:
                    return false
                loads_seen = loads_seen + 1
                i = i + 3
            elif opcode == 0xFE:
                # FUNC_EXIT
                if not found_body_start or found_func_exit or loads_seen != param_count:
                    return false
                found_func_exit = true
                i = i + 1
            elif opcode == 0xFF:
                # TYPE_INFO metadata (after FUNC_EXIT)
                if not found_func_exit:
                    return false
                if i + 1 >= code_len:
                    return false
                if not sffi_value_type_tag_valid(code[i + 1]):
                    return false
                if metadata_seen >= param_count:
                    return false
                val parameter_tag_offset = 4 + metadata_seen * 3
                if code[i + 1] != code[parameter_tag_offset]:
                    return false
                metadata_seen = metadata_seen + 1
                i = i + 2  # tag follows
            else:
                return false

        # Must have BODY_START and FUNC_EXIT
        val valid_structure = found_body_start and found_func_exit
        # Param count must match
        val params_match = typed_params_seen == param_count
        val metadata_matches = metadata_seen == param_count
        valid_structure and params_match and loads_seen == param_count and metadata_matches

    fn get_stats() -> ContextStats:
        """Get statistics."""
        self.stats

# ============================================================================
# Data Structures
# ============================================================================

struct ContextStats:
    """Statistics for compiler context."""
    type_inferences: i64
    template_instantiations: i64
    cache_hits: i64
    cache_misses: i64

struct SffiTemplate:
    """SFFI template metadata (name + param/return TypeInfo), as parsed from the
    compiler-SFFI JSON wire format. Distinct from compiler.backend.linker.obj_taker
    .Template, which is the TemplateCode-section record (kind/body/constraints)."""
    name: text
    type_params: [text]
    param_types: [TypeInfo]
    # # DESUGARED: return_type: TypeInfo
    has_return_type: bool
    return_type: TypeInfo

struct TypeInfo:
    """Type information."""
    kind: text  # "int", "float", "bool", "string", "named", "array", "simd"
    name: text
    # # DESUGARED: bits: i64
    has_bits: bool
    bits: i64
    # # DESUGARED: signed: bool
    has_signed: bool
    signed: bool
    # # DESUGARED: lanes: i64
    has_lanes: bool
    lanes: i64
    args: [TypeInfo]
    # # DESUGARED: elem: TypeInfo
    has_elem: bool
    elem: TypeInfo

struct TypeHint:
    """Type hint for inference."""
    source: text  # "call_site", "return", "assignment", "constraint"
    # # DESUGARED: param_index: i64
    has_param_index: bool
    param_index: i64
    ty: TypeInfo

struct CompilationResult:
    """Result of template instantiation."""
    success: bool
    code: [u8]
    # # DESUGARED: error: text
    has_error: bool
    error: text

# ============================================================================
# Global Context Registry
# ============================================================================

var CONTEXT_REGISTRY: Dict<i64, CompilerContextImpl> = {}
var NEXT_HANDLE: i64 = 1

fn alloc_handle() -> i64:
    """Allocate a new context handle."""
    val handle = NEXT_HANDLE
    NEXT_HANDLE = NEXT_HANDLE + 1
    handle

fn context_registry_remove(handle: i64):
    CONTEXT_REGISTRY.remove(handle)

fn compiler_context_registry_count() -> i64:
    CONTEXT_REGISTRY.length()

fn compiler_context_registry_index_words() -> i64:
    CONTEXT_REGISTRY.length()

# ============================================================================
# Public API Functions
# ============================================================================

fn compiler_create_context() -> i64:
    """Create a new compiler context.

    Returns: Opaque handle (i64) to the context
    """
    val ctx = CompilerContextImpl(
        type_cache: {},
        instantiation_cache: {},
        type_cache_keys: [],
        instantiation_cache_keys: [],
        type_cache_evict_index: 0,
        instantiation_cache_evict_index: 0,
        type_cache_count: 0,
        instantiation_cache_count: 0,
        stats: ContextStats(
            type_inferences: 0,
            template_instantiations: 0,
            cache_hits: 0,
            cache_misses: 0
        ),
        next_type_var: 0
    )

    val handle = alloc_handle()
    CONTEXT_REGISTRY[handle] = ctx
    handle

fn create_compiler_context() -> i64:
    """Create a new CompilerContext handle (workaround for struct constructor limitations).

    Returns: i64 handle (wrap in CompilerContext struct at call site if needed)
    """
    compiler_create_context()

fn compiler_destroy_context(handle: i64):
    """Destroy a compiler context.

    Args:
        handle: Context handle
    """
    context_registry_remove(handle)

fn compiler_infer_types(
    handle: i64,
    template_json: text,
    hints_json: text
) -> text:
    """Infer types for a generic template.

    Args:
        handle: Context handle
        val _as_0 = Template metadata as JSON
        template_json: _as_0
        hints_json: Type hints as JSON array

    Returns: Inferred types as JSON array
    """
    # Get context
    if not CONTEXT_REGISTRY.contains(handle):
        return '{"error": "Invalid context handle"}'

    var ctx = CONTEXT_REGISTRY[handle]

    # Parse inputs
    val tmpl = parse_template_json(template_json)
    val hints = parse_hints_json(hints_json)

    # Run inference
    val inferred = ctx.infer_types(tmpl, hints)
    CONTEXT_REGISTRY[handle] = ctx

    # Serialize result
    serialize_types_json(inferred)

fn compiler_check_types(handle: i64, code: [u8]) -> bool:
    """Type check bytecode.

    Args:
        handle: Context handle
        code: Bytecode to check

    Returns: true if type-correct
    """
    if not CONTEXT_REGISTRY.contains(handle):
        return false

    val ctx = CONTEXT_REGISTRY[handle]
    ctx.check_types(code)

fn compiler_instantiate_template(
    handle: i64,
    template_json: text,
    types_json: text
) -> text:
    """Instantiate a generic template.

    Args:
        handle: Context handle
        val _as_1 = Template metadata as JSON
        template_json: _as_1
        types_json: Type arguments as JSON array

    val _as_2 = Compilation result as JSON
    Returns: _as_2
    """
    # Get context
    if not CONTEXT_REGISTRY.contains(handle):
        return '{"success": false, "error": "Invalid context handle"}'

    val ctx = CONTEXT_REGISTRY[handle]

    # Parse inputs
    val tmpl = parse_template_json(template_json)
    val types = parse_types_json(types_json)

    # Instantiate
    val result = ctx.instantiate_template(tmpl, types)
    CONTEXT_REGISTRY[handle] = ctx

    # Serialize result
    serialize_compilation_result(result)

fn compiler_instantiate_template_typed(
    handle: i64,
    template_name: text,
    type_params: [text],
    types: [TypeInfo]
) -> CompilationResult:
    """In-process typed entrypoint; avoids JSON round trips for the JIT."""
    if not CONTEXT_REGISTRY.contains(handle):
        return CompilationResult(
            success: false, code: [], has_error: true,
            error: "Invalid context handle"
        )

    val ctx = CONTEXT_REGISTRY[handle]
    val tmpl = SffiTemplate(
        name: template_name,
        type_params: type_params,
        param_types: [],
        has_return_type: false,
        return_type: default_type_info()
    )
    val result = ctx.instantiate_template(tmpl, types)
    CONTEXT_REGISTRY[handle] = ctx
    result

fn compiler_get_stats(handle: i64) -> text:
    """Get compiler context statistics.

    Args:
        handle: Context handle

    val _as_3 = Statistics as JSON
    Returns: _as_3
    """
    if not CONTEXT_REGISTRY.contains(handle):
        return '{"error": "Invalid context handle"}'

    val ctx: CompilerContextImpl = CONTEXT_REGISTRY[handle]
    val stats = ctx.get_stats()

    '{"type_inferences": ' + stats.type_inferences.to_string() +
        ', "template_instantiations": ' + stats.template_instantiations.to_string() +
        ', "cache_hits": ' + stats.cache_hits.to_string() +
        ', "cache_misses": ' + stats.cache_misses.to_string() + '}'

# ============================================================================
# JSON Parsing Helpers
# ============================================================================

fn parse_template_json(json_text: text) -> SffiTemplate:
    """Parse template metadata JSON produced by ObjTaker/JIT callers."""
    val name = sffi_json_field_text(json_text, "name")

    var type_params: [text] = []
    val type_params_body = sffi_json_field_array_body(json_text, "type_params")
    if type_params_body.len() > 0:
        for raw in type_params_body.split(","):
            val value = sffi_json_unquote(raw.trim())
            if value.len() > 0:
                type_params.push(value)

    var param_types: [TypeInfo] = []
    val param_types_body = sffi_json_field_array_body(json_text, "param_types")
    if param_types_body.len() > 0:
        param_types = parse_types_json("[" + param_types_body + "]")

    val return_type_object = sffi_json_field_object(json_text, "return_type")
    val has_return_type = return_type_object.len() > 0
    val return_type = if has_return_type:
        json_to_type_info_text(return_type_object)
    else:
        default_type_info()

    SffiTemplate(
        name: name,
        type_params: type_params,
        param_types: param_types,
        has_return_type: has_return_type,
        return_type: return_type
    )

fn parse_hints_json(json_text: text) -> [TypeHint]:
    """Parse type hints from the narrow JSON array emitted by callers."""
    var hints: [TypeHint] = []
    for elem in sffi_json_object_array_items(json_text):
        val source = sffi_json_field_text(elem, "source")
        if source.len() == 0:
            continue

        var param_idx = 0
        val param_idx_opt = sffi_json_field_i64(elem, "param_index")
        val has_param_idx = sffi_optional_i64_exists(param_idx_opt)
        if val parsed_param_idx = param_idx_opt:
            param_idx = parsed_param_idx

        var ty = default_type_info()
        val ty_obj = sffi_json_field_object(elem, "ty")
        if ty_obj.len() > 0:
            ty = json_to_type_info_text(ty_obj)

        hints.push(TypeHint(
            source: source, has_param_index: has_param_idx,
            param_index: param_idx, ty: ty
        ))

    hints

fn parse_types_json(json_text: text) -> [TypeInfo]:
    """Parse TypeInfo JSON array emitted by serialize_types_json."""
    var types: [TypeInfo] = []
    for elem in sffi_json_object_array_items(json_text):
        types.push(json_to_type_info_text(elem))
    types

fn json_to_type_info_text(jv: text) -> TypeInfo:
    """Convert a narrow TypeInfo JSON object to TypeInfo."""
    val kind_raw = sffi_json_field_text(jv, "kind")
    val kind = if kind_raw.len() > 0: kind_raw else: "int"
    val name_raw = sffi_json_field_text(jv, "name")

    var resolved_name = name_raw
    if name_raw.len() == 0:
        resolved_name = match kind:
            case "int": "i64"
            case "float": "f64"
            case "bool": "bool"
            case "string": "string"
            case _: kind

    val bits_opt = sffi_json_field_i64(jv, "bits")
    val signed_opt = sffi_json_field_bool_opt(jv, "signed")
    val lanes_opt = sffi_json_field_i64(jv, "lanes")
    # Same defect class as HirFunction.has_driver_manifest_attr: `.?` is the
    # TryOperator, has no native lowering, and under SIMPLE_BOOTSTRAP=1 yields
    # the nil sentinel (3) instead of a bool -- which reads back TRUE out of a
    # `bool` slot. Use `if val`, which lowers to a genuine bool natively.
    val has_bits_value = sffi_optional_i64_exists(bits_opt)
    val has_signed_value = sffi_optional_bool_exists(signed_opt)
    val has_lanes_value = sffi_optional_i64_exists(lanes_opt)

    var args: [TypeInfo] = []
    val args_body = sffi_json_field_array_body(jv, "args")
    if args_body.len() > 0:
        args = parse_types_json("[" + args_body + "]")

    val elem_object = sffi_json_field_object(jv, "elem")
    val has_elem_value = elem_object.len() > 0
    val elem_value = if has_elem_value:
        json_to_type_info_text(elem_object)
    else:
        default_type_info()

    TypeInfo(
        kind: kind,
        name: resolved_name,
        has_bits: has_bits_value,
        bits: bits_opt.unwrap_or(0),
        has_signed: has_signed_value,
        signed: signed_opt.unwrap_or(false),
        has_lanes: has_lanes_value,
        lanes: lanes_opt.unwrap_or(0),
        args: args,
        has_elem: has_elem_value,
        elem: elem_value
    )

fn compiler_result_json_success(json_text: text) -> bool:
    """Read the success flag from serialize_compilation_result output."""
    sffi_json_field_bool(json_text, "success", false)

fn compiler_result_json_code(json_text: text) -> [u8]:
    """Read code bytes from serialize_compilation_result output."""
    var code: [u8] = []
    val body = sffi_json_field_array_body(json_text, "code")
    if body.len() == 0:
        return code
    for raw in body.split(","):
        val n = raw.trim().to_i64() ?? -1
        if n >= 0 and n <= 255:
            code.push(n as u8)
    code

fn compiler_result_json_error(json_text: text) -> text:
    val error = sffi_json_field_text(json_text, "error")
    if error.len() > 0:
        return error
    "Unknown error"

fn default_type_info() -> TypeInfo:
    TypeInfo(
        kind: "int",
        name: "i64",
        has_bits: true,
        bits: 64,
        has_signed: true,
        signed: true,
        has_lanes: false,
        lanes: 0,
        args: [],
        has_elem: false,
        elem: nil
    )

fn sffi_json_field_tail(json_text: text, key: text) -> text:
    var object_depth = 0
    var array_depth = 0
    var index = 0
    while index < json_text.len():
        val ch = json_text[index:index + 1]
        if ch == "\"":
            val quote_start = index
            index = index + 1
            var escaped = false
            while index < json_text.len():
                val string_ch = json_text[index:index + 1]
                if escaped:
                    escaped = false
                elif string_ch == "\\":
                    escaped = true
                elif string_ch == "\"":
                    break
                index = index + 1
            if index >= json_text.len():
                return ""
            if object_depth == 1 and array_depth == 0:
                var colon_index = index + 1
                while colon_index < json_text.len() and (
                    json_text[colon_index:colon_index + 1] == " " or
                    json_text[colon_index:colon_index + 1] == "\n" or
                    json_text[colon_index:colon_index + 1] == "\r" or
                    json_text[colon_index:colon_index + 1] == "\t"):
                    colon_index = colon_index + 1
                if colon_index < json_text.len() and json_text[colon_index:colon_index + 1] == ":":
                    val decoded_key = sffi_json_unquote(json_text[quote_start:index + 1])
                    if decoded_key == key:
                        return json_text[colon_index + 1:json_text.len()].trim()
        elif ch == "{":
            object_depth = object_depth + 1
        elif ch == "}":
            object_depth = object_depth - 1
            if object_depth < 0:
                return ""
        elif ch == "[":
            array_depth = array_depth + 1
        elif ch == "]":
            array_depth = array_depth - 1
            if array_depth < 0:
                return ""
        index = index + 1
    ""

fn sffi_json_unquote(raw: text) -> text:
    val s = raw.trim()
    if s.len() < 2 or not s.starts_with("\"") or not s.ends_with("\""):
        return s
    val body = s[1:s.len() - 1]
    if body.index_of("\\") < 0:
        return body
    val builder = StringBuilder.new()
    var index = 0
    while index < body.len():
        val ch = body[index:index + 1]
        if ch != "\\":
            builder.push(ch)
            index = index + 1
        else:
            if index + 1 >= body.len():
                return ""
            val escaped = body[index + 1:index + 2]
            if escaped == "\"" or escaped == "\\" or escaped == "/":
                builder.push(escaped)
                index = index + 2
            elif escaped == "b":
                builder.push(text.from_char_code(8))
                index = index + 2
            elif escaped == "f":
                builder.push(text.from_char_code(12))
                index = index + 2
            elif escaped == "n":
                builder.push("\n")
                index = index + 2
            elif escaped == "r":
                builder.push("\r")
                index = index + 2
            elif escaped == "t":
                builder.push("\t")
                index = index + 2
            elif escaped == "u" and index + 5 < body.len():
                val code = sffi_json_hex4(body[index + 2:index + 6])
                if code < 0:
                    return ""
                builder.push(text.from_char_code(code))
                index = index + 6
            else:
                return ""
    builder.build()

fn sffi_json_hex_digit(ch: text) -> i64:
    val code = ch.char_code_at(0)
    if code >= 48 and code <= 57:
        return code - 48
    if code >= 65 and code <= 70:
        return code - 55
    if code >= 97 and code <= 102:
        return code - 87
    -1

fn sffi_json_hex4(raw: text) -> i64:
    if raw.len() != 4:
        return -1
    var value = 0i64
    var index = 0
    while index < 4:
        val digit = sffi_json_hex_digit(raw[index:index + 1])
        if digit < 0:
            return -1
        value = value * 16 + digit
        index = index + 1
    value

fn sffi_json_field_text(json_text: text, key: text) -> text:
    val tail = sffi_json_field_tail(json_text, key)
    if not tail.starts_with("\""):
        return ""
    val rest = tail[1:tail.len()]
    var end_idx = -1
    var escaped = false
    var index = 0
    while index < rest.len():
        val ch = rest[index:index + 1]
        if escaped:
            escaped = false
        elif ch == "\\":
            escaped = true
        elif ch == "\"":
            end_idx = index
            break
        index = index + 1
    if end_idx < 0:
        return ""
    sffi_json_unquote('"' + rest[0:end_idx] + '"')

# Native-safe optional presence checks. See the note at the TypeInfo
# construction site: `opt.?` must never be used to fill a `bool` field.
fn sffi_optional_i64_exists(opt: i64?) -> bool:
    if val present = opt:
        true
    else:
        false

fn sffi_optional_bool_exists(opt: bool?) -> bool:
    if val present = opt:
        true
    else:
        false

fn sffi_json_field_i64(json_text: text, key: text) -> i64?:
    val field_literal = sffi_json_field_literal(json_text, key)
    if field_literal.len() == 0:
        return nil
    val parsed = field_literal.to_i64() ?? -1
    if parsed < 0:
        return nil
    parsed

fn sffi_json_field_bool(json_text: text, key: text, default_value: bool) -> bool:
    val opt = sffi_json_field_bool_opt(json_text, key)
    if val value = opt:
        return value
    default_value

fn sffi_json_field_bool_opt(json_text: text, key: text) -> bool?:
    val field_literal = sffi_json_field_literal(json_text, key)
    if field_literal == "true":
        return true
    if field_literal == "false":
        return false
    nil

fn sffi_json_field_literal(json_text: text, key: text) -> text:
    val tail = sffi_json_field_tail(json_text, key)
    if tail.len() == 0:
        return ""
    var end_idx = tail.len()
    val comma_idx = tail.index_of(",")
    if comma_idx >= 0 and comma_idx < end_idx:
        end_idx = comma_idx
    val brace_idx = tail.index_of("}")
    if brace_idx >= 0 and brace_idx < end_idx:
        end_idx = brace_idx
    val bracket_idx = tail.index_of("]")
    if bracket_idx >= 0 and bracket_idx < end_idx:
        end_idx = bracket_idx
    tail[0:end_idx].trim()

fn sffi_json_field_array_body(json_text: text, key: text) -> text:
    val tail = sffi_json_field_tail(json_text, key)
    sffi_json_balanced_body(tail, "[", "]")

fn sffi_json_field_object(json_text: text, key: text) -> text:
    val tail = sffi_json_field_tail(json_text, key)
    val body = sffi_json_balanced_body(tail, "{", "}")
    if body.len() == 0:
        return ""
    "{" + body + "}"

fn sffi_json_balanced_body(tail: text, open_ch: text, close_ch: text) -> text:
    if not tail.starts_with(open_ch):
        return ""
    var depth = 0
    var in_string = false
    var escaped = false
    var i = 0
    while i < tail.len():
        val ch = tail[i:i + 1]
        if in_string:
            if escaped:
                escaped = false
            elif ch == "\\":
                escaped = true
            elif ch == "\"":
                in_string = false
        elif ch == "\"":
            in_string = true
        elif ch == open_ch:
            depth = depth + 1
        elif ch == close_ch:
            depth = depth - 1
            if depth == 0:
                return tail[1:i]
            if depth < 0:
                return ""
        i = i + 1
    ""

fn sffi_json_object_array_items(json_text: text) -> [text]:
    var body = json_text.trim()
    if body.starts_with("[") and body.ends_with("]"):
        body = body[1:body.len() - 1]
    var items: [text] = []
    var depth = 0
    var start = -1
    var in_string = false
    var escaped = false
    var i = 0
    while i < body.len():
        val ch = body[i:i + 1]
        if in_string:
            if escaped:
                escaped = false
            elif ch == "\\":
                escaped = true
            elif ch == "\"":
                in_string = false
        elif ch == "\"":
            in_string = true
        elif ch == "{":
            if depth == 0:
                start = i
            depth = depth + 1
        elif ch == "}":
            depth = depth - 1
            if depth < 0:
                return []
            if depth == 0 and start >= 0:
                items = items.push(body[start:i + 1])
                start = -1
        i = i + 1
    if depth != 0 or in_string:
        return []
    items

# ============================================================================
# JSON Serialization Helpers
# ============================================================================

fn serialize_types_json(types: [TypeInfo]) -> text:
    """Serialize types to JSON array.

    Output: [{"kind":"int","bits":64,"signed":true}]
    """
    var parts: [text] = []

    for ty in types:
        val ty_json = serialize_type_json(ty)
        parts = parts.push(ty_json)

    val joined = parts.join(",")
    "[" + joined + "]"

fn serialize_type_json(ty: TypeInfo) -> text:
    """Serialize single type to JSON.

    Output: {"kind":"int","bits":64,"signed":true}
    """
    var fields: [text] = []

    fields.push('"kind":"' + escape_json(ty.kind) + '"')
    fields.push('"name":"' + escape_json(ty.name) + '"')

    if ty.has_bits:
        fields.push('"bits":' + ty.bits.to_string())

    if ty.has_signed:
        var signed_str = "false"
        if ty.signed:
            signed_str = "true"
        fields.push('"signed":' + signed_str)

    if ty.has_lanes:
        fields.push('"lanes":' + ty.lanes.to_string())

    if ty.args.len() > 0:
        fields.push('"args":' + serialize_types_json(ty.args))

    if ty.has_elem:
        fields.push('"elem":' + serialize_type_json(ty.elem))

    val joined = fields.join(",")
    "{" + joined + "}"

fn serialize_compilation_result(result: CompilationResult) -> text:
    """Serialize compilation result to JSON.

    Output: {"success":true,"code":[1,2,3,4]}
    """
    if result.success:
        val code_bytes = result.code
        var code_parts: [text] = []
        for code_byte in code_bytes:
            code_parts = code_parts.push(code_byte.to_string())
        val code_str = code_parts.join(",")
        '{"success":true,"code":[' + code_str + ']}'
    else:
        val error_text = if result.has_error: result.error else: "Unknown error"
        '{"success":false,"error":"' + escape_json(error_text) + '"}'

# ============================================================================
# Helper Functions
# ============================================================================

fn hints_to_key(hints: [TypeHint]) -> text:
    """Encode ordered hint identity, including presence and structural type."""
    val builder = StringBuilder.new()
    append_hints_cache_key(builder, hints)
    builder.build()

fn append_hints_cache_key(builder: StringBuilder, hints: [TypeHint]):
    """Append ordered structural hints to a shared cache-key builder."""
    builder.push(hints.len().to_string())
    builder.push(":")
    for hint in hints:
        builder.push(sffi_cache_key_field(hint.source))
        if hint.has_param_index:
            builder.push("p1")
            builder.push(sffi_cache_key_field(hint.param_index.to_string()))
        else:
            builder.push("p0")
        append_type_cache_key(builder, hint.ty)

fn sffi_cache_key_field(value: text) -> text:
    """Frame one cache-key field so embedded delimiters cannot collide."""
    value.len().to_string() + "#" + value

fn append_type_cache_key(builder: StringBuilder, ty: TypeInfo):
    """Append structural TypeInfo identity without copying nested subtrees."""
    builder.push("t{")
    builder.push(sffi_cache_key_field(ty.kind))
    builder.push(sffi_cache_key_field(ty.name))

    if ty.has_bits:
        builder.push("b1")
        builder.push(sffi_cache_key_field(ty.bits.to_string()))
    else:
        builder.push("b0")
    if ty.has_signed:
        val signed_value = if ty.signed: "1" else: "0"
        builder.push("s1")
        builder.push(signed_value)
    else:
        builder.push("s0")
    if ty.has_lanes:
        builder.push("l1")
        builder.push(sffi_cache_key_field(ty.lanes.to_string()))
    else:
        builder.push("l0")

    builder.push("a")
    builder.push(ty.args.len().to_string())
    builder.push(":")
    for arg in ty.args:
        append_type_cache_key(builder, arg)

    if ty.has_elem:
        builder.push("e1")
        append_type_cache_key(builder, ty.elem)
    else:
        builder.push("e0")
    builder.push("}")

fn type_to_cache_key(ty: TypeInfo) -> text:
    """Encode every semantic TypeInfo field for specialization identity."""
    val builder = StringBuilder.new()
    append_type_cache_key(builder, ty)
    builder.build()

fn types_to_key(types: [TypeInfo]) -> text:
    """Convert an ordered type list to an unambiguous structural cache key."""
    val builder = StringBuilder.new()
    append_types_cache_key(builder, types)
    builder.build()

fn append_types_cache_key(builder: StringBuilder, types: [TypeInfo]):
    """Append an ordered structural type list to a shared key builder."""
    builder.push(types.len().to_string())
    builder.push(":")
    for ty in types:
        append_type_cache_key(builder, ty)

fn append_template_cache_key(builder: StringBuilder, tmpl: SffiTemplate):
    """Append every template field that can affect inference or bytecode."""
    builder.push("m{")
    builder.push(sffi_cache_key_field(tmpl.name))
    builder.push("g")
    builder.push(tmpl.type_params.len().to_string())
    builder.push(":")
    for type_param in tmpl.type_params:
        builder.push(sffi_cache_key_field(type_param))
    builder.push("p")
    append_types_cache_key(builder, tmpl.param_types)
    if tmpl.has_return_type:
        builder.push("r1")
        append_type_cache_key(builder, tmpl.return_type)
    else:
        builder.push("r0")
    builder.push("}")

fn template_to_cache_key(tmpl: SffiTemplate) -> text:
    val builder = StringBuilder.new()
    append_template_cache_key(builder, tmpl)
    builder.build()

fn inference_cache_key(tmpl: SffiTemplate, hints: [TypeHint]) -> text:
    val builder = StringBuilder.new()
    append_template_cache_key(builder, tmpl)
    builder.push("h")
    append_hints_cache_key(builder, hints)
    builder.build()

fn instantiation_cache_key(tmpl: SffiTemplate, types: [TypeInfo]) -> text:
    val builder = StringBuilder.new()
    append_template_cache_key(builder, tmpl)
    builder.push("i")
    append_types_cache_key(builder, types)
    builder.build()

fn type_to_string(ty: TypeInfo) -> text:
    """Convert TypeInfo to a string representation for name mangling.

    Args:
        ty: Type information

    Returns:
        String representation (e.g., "i64", "f64", "bool", "MyType")
    """
    ty.name

fn make_int_type(bits: i64, signed: bool) -> TypeInfo:
    """Create an integer TypeInfo.

    Args:
        bits: Bit width (8, 16, 32, 64)
        signed: true for signed (i8-i64), false for unsigned (u8-u64)
    """
    var prefix = "u"
    if signed:
        prefix = "i"
    var result = TypeInfo(kind: "int", name: "{prefix}{bits}", bits: bits, signed: signed, lanes: nil, args: [], elem: nil)
    result.has_bits = true
    result.has_signed = true
    result

fn make_float_type(bits: i64) -> TypeInfo:
    """Create a float TypeInfo."""
    var result = TypeInfo(kind: "float", name: "f{bits}", bits: bits, signed: nil, lanes: nil, args: [], elem: nil)
    result.has_bits = true
    result.has_signed = false
    result

fn make_bool_type() -> TypeInfo:
    """Create a bool TypeInfo."""
    var result = TypeInfo(kind: "bool", name: "bool", bits: 1, signed: nil, lanes: nil, args: [], elem: nil)
    result.has_bits = true
    result.bits = 1
    result

fn make_string_type() -> TypeInfo:
    """Create a string TypeInfo."""
    TypeInfo(kind: "string", name: "string", bits: nil, signed: nil, lanes: nil, args: [], elem: nil)

fn make_named_type(name: text) -> TypeInfo:
    """Create a named TypeInfo."""
    TypeInfo(kind: "named", name: name, bits: nil, signed: nil, lanes: nil, args: [], elem: nil)

# ============================================================================
# Bytecode Helper Functions
# ============================================================================

fn _type_to_tag(ty: TypeInfo) -> u8:
    """Convert TypeInfo to a bytecode type tag."""
    match ty.kind:
        case "int":
            val is_signed = ty.has_signed and ty.signed
            if is_signed:
                0x10  # SIGNED_INT
            else:
                0x11  # UNSIGNED_INT
        case "float": 0x20
        case "bool": 0x30
        case "string": 0x40
        case "named": 0x50
        case "array": 0x60
        case "simd": 0x70
        case _: 0x00

fn _type_size_bytes(ty: TypeInfo) -> u8:
    """Get size in bytes for a type."""
    if ty.has_bits:
        val bits = ty.bits
        if bits <= 8:
            return 1
        if bits <= 16:
            return 2
        if bits <= 32:
            return 4
        return 8
    # Default sizes by kind
    match ty.kind:
        case "bool": 1
        case "string": 8  # pointer size
        case _: 8  # default to 64-bit

# ============================================================================
# Exports
# ============================================================================
