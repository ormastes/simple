# WS3: Explicit re-exports — no sibling preloading needed.
# Refactored 2026-03-29 as part of Driver API Heavy Path Stabilization.
#
# This root package remains the compatibility facade for the older loader API,
# including wrapper-style `moduleloader_*` functions from `module_loader.spl`.
# Newer curated loader consumers should prefer `compiler.loader.runtime`.

# Re-exported from compiler_sffi.spl
export use compiler.loader.compiler_sffi.{
    TypeInfo, CompilerContext,
    make_int_type, make_float_type, make_bool_type, make_string_type, make_named_type,
    type_to_string, type_args_is_empty,
    code_len, bytes_len
}

# Re-exported from jit_instantiator.spl
export use compiler.loader.jit_instantiator.{
    JitInstantiatorConfig, JitStats, JitInstantiationResult,
    PossibleInstantiation, InstantiationRecord, LoadedMetadata, JitCacheRecord,
    MappedRecord, JitExecMapper, JitMapper, JitInstantiator, JitSymbolResolver,
    jitinstantiator_new, jitinstantiator_stats
}

# Re-exported from module_loader.spl (compatibility surface)
export use compiler.loader.module_loader.{
    LoaderSymbolType,
    ModuleLoader, ModuleLoaderConfig, LoadedModule, LoadedSymbol,
    LoadResult, SymbolResult, LoaderStats,
    moduleloader_load, moduleloader_reload, moduleloader_replace_live, moduleloader_unload,
    moduleloader_compat_activate_mcdc_aspect_payload_v1,
    moduleloader_compat_retire_mcdc_aspect_payload_v1,
    moduleloader_resolve_symbol, moduleloader_resolve_generic,
    moduleloader_stats, moduleloader_aspect_loader_handle,
    moduleloader_try_aspect_facet, moduleloader_aspect_facet,
    moduleloader_install_aspect_catalog, moduleloader_aspect_facet_visible,
    moduleloader_unload_aspect_facet,
    moduleloader_visible_aspect_catalog_digest,
    moduleloader_visible_aspect_catalog_generation,
    moduleloader_aspect_catalog_digest_computations,
    moduleloader_aspect_catalog_invalidations, mangle_name,
    moduleloader_mapped_symbol_bytes, moduleloader_nested_module_refcount,
    moduleloader_exec_mapping_count,
    modulefacetref_is_live, modulefacetref_release
}

# Re-exported from object_mapper.spl
export use compiler.loader.object_mapper.{
    SharedExecMapperConfig, SharedExecRecord, SharedExecMapperStats, SharedExecMapper,
    LoaderMapperConfig, LoaderMapper,
    JitMapperConfig, JitMapper
}

# Re-export the real segment-granular mapper.  This is the executable mapper
# that binds symbols to validated byte offsets inside mapped sections; the
# package facade must never substitute the historical fabricating mapper.
export use compiler.loader.segment_mapper.{
    MappedSegment, SegmentSymbol, SegmentMapperStats, SegmentMapper,
    segment_key, segment_load_plan, segment_load_receipt,
    SEGMENT_MAX_ALIGNMENT
}

# Re-exported from jit_context.spl
export use compiler.loader.jit_context.{
    TemplateBytes, JitInstantiationRecord, JitCompilationContext
}

# Re-exported from smf_cache.spl
export use compiler.loader.smf_cache.{MappedSmf, CacheStats, SmfCache, bytes_to_u32}

# Re-exported from joinpoint_slots.spl / advice_binding_registry.spl
# (join-point patchpoints, slot-cell design).
export use compiler.loader.joinpoint_slots.{
    JoinpointSlot, JoinpointSlotTable, joinpoint_key, SLOT_CELL_SIZE, SLOT_ID_NONE
}
export use compiler.loader.advice_binding_registry.{
    AdviceBinding, AdviceBindingRegistry
}
