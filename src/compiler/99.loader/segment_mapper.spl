# Segment-granular executable mapper (startup_perf_architecture_2026-08-17
# §8.4, §8.15).
#
# WHY THIS EXISTS
# ---------------
# The historical loader path mapped ONE executable region PER SYMBOL:
# `object_mapper.map_symbol` and the compat loader's SMF branch both called
# `native_alloc_exec_memory` inside a per-symbol loop. A module with N
# exported functions therefore cost N mmaps, N RW->RX protection
# transitions, and N icache flushes -- O(symbols) syscalls where the file
# format only ever described O(sections) of contiguous code.
#
# This module maps ONE region PER SEGMENT (an SMF section) and makes a
# symbol what it actually is in the object format: an OFFSET into that
# segment. Cost becomes O(segments) and is independent of symbol count.
#
# CORRECTNESS INVARIANTS (a loader that maps less but resolves wrong is
# strictly worse than a slow one):
#   * A symbol address is `segment_base + symbol.offset`, with
#     `symbol.offset` interpreted exactly as SMF defines it -- relative to
#     its section. `read_code` in the SMF reader computes symbol bytes as
#     `section_file_offset + symbol.offset`, so the same arithmetic against
#     a whole-section mapping yields byte-identical code at the symbol's
#     address.
#   * Every bind is bounds-checked: `offset >= 0` and
#     `offset + size <= segment_size`. A symbol that does not lie inside
#     its declared segment is an error, never a silent truncation.
#   * Alignment: mmap returns a page-aligned base, so a symbol keeps its
#     section-relative alignment for any section alignment <= page size.
#     `map_segment` REJECTS a stronger requested alignment rather than
#     mapping something under-aligned.
#   * W^X: a segment remains RW through copy and relocation, then is sealed
#     RX once by `end_relocation`. There is no premature RX->RW round trip.
#     Hot relocation of an already-sealed segment still uses
#     `begin_relocation` / `end_relocation`.
#   * Relocation offsets are SEGMENT-relative and applied once at the
#     segment base -- the format's own frame of reference.

use compiler.loader.loader.smf_mmap_native.{
    native_alloc_exec_memory,
    native_write_exec_memory,
    native_make_executable,
    native_make_rw,
    native_flush_icache_checked,
    native_get_function_pointer,
    native_free_exec_memory
}
use app.startup.load_plan_receipt.{
    LoadPlanV1, LoadReceiptV1, load_plan_seal, load_receipt_record
}
use std.common.structural.parallel_commit.executable_mapping_receipt.{
    EXECUTABLE_MAPPING_RECEIPT_MAX_KEY_BYTES,
    EXECUTABLE_MAPPING_RECEIPT_MAX_OWNER_BYTES,
    ExecutableMappingProducerKindV1,
    ExecutableMappingReceiptV1,
    executable_mapping_receipt_v1
}

# Page size assumed by the alignment guard. mmap bases are page-aligned on
# every supported target; a section demanding more than this cannot be
# honoured by a plain anonymous mapping and is refused.
val SEGMENT_MAX_ALIGNMENT: i64 = 4096

"""One mapped segment: a single contiguous executable region."""
struct MappedSegment:
    owner_id: text
    section_index: i32
    base: i64
    size: i64
    alignment: i64
    symbol_count: i64
    protected_executable: bool
    generation: i64

"""A symbol placed inside a mapped segment. Address is derived, not
allocated -- there is no per-symbol memory region."""
struct SegmentSymbol:
    name: text
    owner_id: text
    section_index: i32
    offset: i64
    size: i64
    address: i64
    generation: i64

"""Observed mapping facts, the input to a LoadReceiptV1."""
struct SegmentMapperStats:
    segment_count: i64
    symbol_count: i64
    bytes_mapped: i64
    mapping_calls: i64
    protection_transitions: i64
    generation: i64
    unmap_failures: i64

struct SegmentMapper:
    segments: Dict<text, MappedSegment>
    symbols: Dict<text, SegmentSymbol>
    bytes_mapped: i64
    mapping_calls: i64
    protection_transitions: i64
    generation: i64
    unmap_failures: i64
    verbose: bool

fn segment_key(owner_id: text, section_index: i32) -> text:
    owner_id + "#" + (section_index as i64).to_string()

impl SegmentMapper:
    static fn new() -> SegmentMapper:
        SegmentMapper(
            segments: {},
            symbols: {},
            bytes_mapped: 0,
            mapping_calls: 0,
            protection_transitions: 0,
            generation: 0,
            unmap_failures: 0,
            verbose: false
        )

    """Map ONE segment with ONE allocation. This is the only place in the
    segment path that allocates executable memory; symbol count never
    influences how often it is called."""
    me map_segment(owner_id: text, section_index: i32, bytes: [u8], alignment: i64) -> Result<i64, text>:
        val mapped = self.map_segment_rw(owner_id, section_index, bytes, alignment)
        val base = match mapped:
            case Err(message):
                return Err(message)
            case Ok(value):
                value
        match self.seal_segment(owner_id, section_index):
            case Ok(_):
                Ok(base)
            case Err(message):
                _ = self.unmap_segment(owner_id, section_index)
                Err(message)

    """Map and copy ONE segment as RW transaction-private staging memory.

    The live loader uses this entrypoint so relocations are applied before the
    first RX transition. `map_segment` remains the compatibility convenience
    API and seals immediately after this step.
    """
    me map_segment_rw(owner_id: text, section_index: i32, bytes: [u8], alignment: i64) -> Result<i64, text>:
        val size = bytes.len() as i64
        if size <= 0:
            return Err("Cannot map empty segment {section_index} for {owner_id}")
        if alignment <= 0 or (alignment & (alignment - 1)) != 0:
            return Err("Segment {section_index} alignment {alignment} is not a positive power of two")
        if alignment > SEGMENT_MAX_ALIGNMENT:
            return Err("Segment {section_index} alignment {alignment} exceeds page alignment {SEGMENT_MAX_ALIGNMENT}")

        val key = segment_key(owner_id, section_index)
        if self.segments.has(key):
            return Err("Segment already mapped: {key}")
        if self.generation >= 9223372036854775807:
            return Err("Segment generation exhausted; refusing handle reuse")

        val base = native_alloc_exec_memory(size)
        self.mapping_calls = self.mapping_calls + 1
        if base == 0:
            return Err("Executable allocation failed for segment {key} ({size} bytes)")

        val written = native_write_exec_memory(base, bytes, 0)
        if written != size:
            # Register ownership before cleanup. If the native free itself
            # fails, the allocation remains discoverable and retryable through
            # `unmap_owner` instead of becoming an untracked executable leak.
            self.generation = self.generation + 1
            self.segments[key] = MappedSegment(
                owner_id: owner_id,
                section_index: section_index,
                base: base,
                size: size,
                alignment: alignment,
                symbol_count: 0,
                protected_executable: false)
            self.bytes_mapped = self.bytes_mapped + size
            _ = self.unmap_segment(owner_id, section_index)
            return Err("Failed to copy segment bytes for {key}")

        val next_generation = self.generation + 1
        self.generation = next_generation
        self.segments[key] = MappedSegment(
            owner_id: owner_id,
            section_index: section_index,
            base: base,
            size: size,
            alignment: alignment,
            symbol_count: 0,
            protected_executable: false,
            generation: next_generation
        )
        self.bytes_mapped = self.bytes_mapped + size

        if self.verbose:
            print "[segment-mapper] mapped {key} base=0x{base} size={size}"

        Ok(base)

    """Seal one transaction-private RW segment as RX exactly once."""
    me seal_segment(owner_id: text, section_index: i32) -> Result<(), text>:
        val key = segment_key(owner_id, section_index)
        if not self.segments.has(key):
            return Err("Cannot seal unmapped segment {key}")
        var seg = self.segments[key]
        if seg.protected_executable:
            return Err("Segment already sealed executable: {key}")
        if not native_make_executable(seg.base, seg.size):
            return Err("Failed to switch RW->RX for segment {key}")
        self.protection_transitions = self.protection_transitions + 1
        native_flush_icache(seg.base, seg.size)
        seg.protected_executable = true
        self.segments[key] = seg
        Ok(())

    """Place a symbol inside an already-mapped segment. Allocates nothing:
    the address is `base + offset`, bounds-checked against the segment."""
    me bind_symbol(owner_id: text, section_index: i32, name: text, offset: i64, size: i64) -> Result<i64, text>:
        val key = segment_key(owner_id, section_index)
        if not self.segments.has(key):
            return Err("Cannot bind {name}: segment {key} is not mapped")
        if self.symbols.has(name):
            return Err("Symbol already bound: {name}")
        var seg = self.segments[key]
        if offset < 0:
            return Err("Symbol {name} has negative segment offset {offset}")
        if size < 0:
            return Err("Symbol {name} has negative size {size}")
        if offset > seg.size or size > seg.size - offset:
            return Err("Symbol {name} at offset {offset} size {size} exceeds segment {key} size {seg.size}")

        if seg.base <= 0 or offset > 9223372036854775807 - seg.base:
            return Err("Symbol {name} address overflows mapped address space")
        val address = native_get_function_pointer(seg.base + offset)
        if address <= 0:
            return Err("Symbol {name} resolved to an invalid mapped address")
        self.symbols[name] = SegmentSymbol(
            name: name,
            owner_id: owner_id,
            section_index: section_index,
            offset: offset,
            size: size,
            address: address,
            generation: seg.generation
        )
        seg.symbol_count = seg.symbol_count + 1
        self.segments[key] = seg
        Ok(address)

    fn lookup(name: text) -> i64?:
        if self.symbols.has(name):
            val symbol = self.symbols[name]
            if self.is_symbol_current(symbol):
                return Some(symbol.address)
        nil

    fn get_symbol(name: text) -> SegmentSymbol?:
        if self.symbols.has(name):
            val symbol = self.symbols[name]
            if self.is_symbol_current(symbol):
                return Some(symbol)
        nil

    """Validate a copied symbol handle against its exact segment lifetime."""
    fn is_symbol_current(symbol: SegmentSymbol) -> bool:
        val key = segment_key(symbol.owner_id, symbol.section_index)
        if not self.segments.has(key) or not self.symbols.has(symbol.name):
            return false
        val segment = self.segments[key]
        val current = self.symbols[symbol.name]
        (segment.generation == symbol.generation and
            current.generation == symbol.generation and
            current.owner_id == symbol.owner_id and
            current.section_index == symbol.section_index and
            current.offset == symbol.offset and
            current.size == symbol.size and
            current.address == symbol.address)

    fn segment_base(owner_id: text, section_index: i32) -> i64:
        val key = segment_key(owner_id, section_index)
        if self.segments.has(key):
            return self.segments[key].base
        0

    fn segment_size(owner_id: text, section_index: i32) -> i64:
        val key = segment_key(owner_id, section_index)
        if self.segments.has(key):
            return self.segments[key].size
        0

    fn owner_segment_count(owner_id: text) -> i32:
        var count = 0
        for key in self.segments.keys():
            if self.segments[key].owner_id == owner_id:
                count = count + 1
        count

    """RX -> RW for the whole segment, once, ahead of relocation."""
    me begin_relocation(owner_id: text, section_index: i32) -> Result<(), text>:
        val key = segment_key(owner_id, section_index)
        if not self.segments.has(key):
            return Err("Cannot relocate unmapped segment {key}")
        var seg = self.segments[key]
        if not seg.protected_executable:
            return Ok(())
        if not native_make_rw(seg.base, seg.size):
            return Err("Failed to make segment {key} writable for relocation")
        self.protection_transitions = self.protection_transitions + 1
        seg.protected_executable = false
        self.segments[key] = seg
        Ok(())

    """RW -> RX for the whole segment, once, plus a single icache flush."""
    me end_relocation(owner_id: text, section_index: i32) -> Result<(), text>:
        val key = segment_key(owner_id, section_index)
        if not self.segments.has(key):
            return Err("Cannot finish relocation of unmapped segment {key}")
        var seg = self.segments[key]
        if seg.protected_executable:
            return Ok(())
        if not native_make_executable(seg.base, seg.size):
            return Err("Failed to restore RX on segment {key}")
        self.protection_transitions = self.protection_transitions + 1
        if not native_flush_icache_checked(seg.base, seg.size):
            return Err("Failed to publish instructions for segment {key}")
        seg.protected_executable = true
        self.segments[key] = seg
        Ok(())

    """Seal every candidate segment transactionally.

    Any RX-transition or icache-publication failure unmaps all segments owned
    by the candidate so no partially executable module can escape."""
    me seal_owner(owner_id: text) -> Result<(), text>:
        var section_indices: [i32] = []
        for key in self.segments.keys():
            val seg = self.segments[key]
            if seg.owner_id == owner_id:
                section_indices.push(seg.section_index)
        for section_index in section_indices:
            match self.end_relocation(owner_id, section_index):
                case Ok(_):
                    pass
                case Err(err):
                    val removed = self.unmap_owner(owner_id)
                    if removed != section_indices.len():
                        return Err("{err}; cleanup removed {removed} of {section_indices.len()} candidate mappings")
                    return Err(err)
        Ok(())

    """One munmap attempt per segment, never per symbol.

    Metadata and symbol handles are retired even when the OS reports an unmap
    failure.  That fail-closed rule prevents a stale address from remaining
    reachable through this mapper; `unmap_failures` retains the cleanup error
    for diagnostics instead of silently claiming a successful syscall."""
    me unmap_owner(owner_id: text) -> i32:
        var keys: [text] = []
        for key in self.segments.keys():
            if self.segments[key].owner_id == owner_id:
                keys.push(key)

        var removed = 0
        var failed = false
        for key in keys:
            val seg = self.segments[key]
            if not native_free_exec_memory(seg.base, seg.size):
                self.unmap_failures = self.unmap_failures + 1
            self.bytes_mapped = self.bytes_mapped - seg.size
            self.segments = self.segments.remove(key)
            removed = removed + 1

        var dead: [text] = []
        for name in self.symbols.keys():
            val symbol = self.symbols[name]
            if symbol.owner_id == owner_id:
                # Remove every pointer whose section was successfully freed.
                # On a partial native failure only symbols backed by the still
                # mapped residual segments remain in this private mapper.
                val key = segment_key(owner_id, symbol.section_index)
                if not self.segments.has(key):
                    dead.push(name)
        for name in dead:
            self.symbols = self.symbols.remove(name)

        # A negative result is the compatibility API's fail-closed signal.
        # Callers must quarantine their public views because native unmapping
        # across several section mappings cannot itself be atomic.
        if failed:
            return -1
        removed

    me clear():
        self._clear_with(native_free_exec_memory)

    # Keep teardown ordering byte-for-byte compatible with the historical
    # `owners` + `unmap_owner` loop without rescanning every segment and symbol
    # once per owner.  Flat adjacency arrays avoid Dict<text, [text]>: storing
    # growing arrays as dictionary values would repeatedly detach/copy them
    # under Simple value semantics.
    #
    # `_clear_with` is a private test seam so failure and call ordering can be
    # checked without releasing arbitrary process addresses.
    me _clear_with(free_segment: fn(i64, i64) -> bool):
        val segment_keys = self.segments.keys()
        var owner_index: Dict<text, i64> = {}
        var owner_heads: [i64] = []
        var owner_tails: [i64] = []
        var keys: [text] = []
        var next_key: [i64] = []

        # Build first-seen owner order and per-owner key order in one pass.
        # The linked lists are indices into the flat `keys`/`next_key` arrays.
        for key in segment_keys:
            val owner = self.segments[key].owner_id
            val key_slot = keys.len()
            keys.push(key)
            next_key.push(-1)

            if owner_index.has(owner):
                val owner_slot = owner_index[owner]
                val previous_tail = owner_tails[owner_slot]
                next_key[previous_tail] = key_slot
                owner_tails[owner_slot] = key_slot
            else:
                val owner_slot = owner_heads.len()
                owner_index[owner] = owner_slot
                owner_heads.push(key_slot)
                owner_tails.push(key_slot)

        # Match the old ordering: owners by first segment occurrence, then all
        # of that owner's segment keys in the source dictionary traversal.
        var owner_slot: i64 = 0
        while owner_slot < owner_heads.len():
            var key_slot = owner_heads[owner_slot]
            while key_slot >= 0:
                val key = keys[key_slot]
                val seg = self.segments[key]
                if free_segment(seg.base, seg.size):
                    self.bytes_mapped = self.bytes_mapped - seg.size
                    self.segments = self.segments.remove(key)
                key_slot = next_key[key_slot]
            owner_slot = owner_slot + 1

        # `unmap_owner` removed symbols even when a native free failed, but it
        # never removed symbols for owners absent from `segments`.  Preserve
        # both edge cases with one symbol scan over the snapshotted names.
        val symbol_names = self.symbols.keys()
        for name in symbol_names:
            if owner_index.has(self.symbols[name].owner_id):
                self.symbols = self.symbols.remove(name)

    fn stats() -> SegmentMapperStats:
        SegmentMapperStats(
            segment_count: self.segments.keys().len() as i64,
            symbol_count: self.symbols.keys().len() as i64,
            bytes_mapped: self.bytes_mapped,
            mapping_calls: self.mapping_calls,
            protection_transitions: self.protection_transitions,
            generation: self.generation,
            unmap_failures: self.unmap_failures
        )

# ============================================================================
# Plan / receipt bridge (§8.10 / §8.11)
#
# The mapping-count claim of this module is only checkable if the loader
# STATES its intent and then RECORDS what it did. `segment_load_plan`
# builds the sealed intent; `segment_load_receipt` turns observed mapper
# stats into the evidence. `load_receipt_check_against_plan` (owned by
# app.startup.load_plan_receipt) compares them and names any deviation --
# notably a segment_count that grew with symbol count.
# ============================================================================

fn segment_load_plan(
        artifact_path: text,
        target: text,
        planned_segment_count: i64,
        planned_bytes_mapped: i64,
        planned_relocation_count: i64,
        import_count: i64,
        export_count: i64) -> LoadPlanV1:
    load_plan_seal(LoadPlanV1(
        schema: 1,
        artifact_path: artifact_path,
        artifact_kind: "smf",
        target: target,
        abi_identity: "",
        interface_identity: "",
        impl_identity: "",
        dependency_order: [],
        planned_segment_count: planned_segment_count,
        planned_bytes_mapped: planned_bytes_mapped,
        relocation_summary: "segment-relative",
        planned_relocation_count: planned_relocation_count,
        import_count: import_count,
        export_count: export_count,
        load_policy: "segment-per-mapping",
        security_policy: "wxor",
        cache_identity: ""))

fn segment_load_receipt(
        plan: LoadPlanV1,
        artifact_digest: text,
        stats: SegmentMapperStats,
        bytes_read: i64,
        relocation_count: i64,
        resolved_import_count: i64,
        result: text,
        failure_reason: text) -> LoadReceiptV1:
    load_receipt_record(
        plan,
        artifact_digest,
        "segment_mapper",
        "dynamic",
        bytes_read,
        stats.bytes_mapped,
        stats.segment_count,
        relocation_count,
        resolved_import_count,
        -1,
        stats.protection_transitions,
        "miss",
        stats.generation,
        result,
        failure_reason)
