# Canonical exact-ABI parser mask call facade. Interpreter returns -1.
extern fn rt_parser_mask_call_u8x32(function_address: i64, source_address: i64,
    first: i64, second: i64) -> i64

fn parser_mask_call_native_v1(function_address: i64, source_address: i64,
    first: u8, second: u8) -> Result<u32, text>:
    val result = rt_parser_mask_call_u8x32(function_address, source_address,
        first as i64, second as i64)
    if result < 0: return Err("parser-mask-native-call-rejected")
    Ok((result as u64 & 0xffffffffu64) as u32)
