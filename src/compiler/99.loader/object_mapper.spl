# Compatibility executable object mapper surface for interpreter/test runner.
#
# FIX (W4, 2026-08-19): this used to define its OWN SharedExecMapper that
# fabricated addresses arithmetically (`4096 + generation*256 + code.len()`)
# instead of mapping any memory at all. That fake was reachable through two
# paths: the public `compiler.loader` root facade (`__init__.spl`) AND —
# more seriously — `compiler/99.loader/loader/jit_instantiator.spl`, which
# imports `SharedExecMapper`/`JitMapper` from this exact package path
# (`use compiler.loader.object_mapper.{...}`) for real load-time JIT
# instantiation, even though it sits right next to the REAL mapper
# (`compiler/99.loader/loader/object_mapper.spl`, reachable relatively as
# `.object_mapper` and absolutely as `compiler.loader.loader.object_mapper`)
# and could have used it via a relative import instead.
#
# This file now delegates to that real implementation — which allocates RX
# memory via `native_alloc_exec_memory`, writes the code, flips it
# executable, and flushes the icache — so every consumer of the
# `compiler.loader.object_mapper` name (this package) gets genuine mapped
# addresses instead of fabricated ones. See
# `doc/08_tracking/todo/hardcoded_cli_option_census_2026-08-18.md` (W4) and
# `test/01_unit/compiler/loader/object_mapper_no_fabrication_spec.spl`.
export use compiler.loader.loader.object_mapper.{
    SharedExecMapperConfig, SharedExecRecord, SharedExecMapperStats, SharedExecMapper,
    LoaderMapperConfig, LoaderMapper,
    JitMapperConfig, JitMapper
}
