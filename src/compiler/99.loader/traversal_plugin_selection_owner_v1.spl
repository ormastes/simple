# Fixed selection surface. Authority lives with file-private host-policy minting;
# no arbitrary callback or registration function is exported here. Platform
# mapping is behind the typed fixed host facade, which refuses unsupported hosts.
# Windows dependency/build qualification remains a separate execution gate.
pub use compiler.loader.traversal_plugin_admission_v1.{
    traversal_plugin_selection_validate_v1,
    traversal_plugin_selection_validate_request_v1,
    traversal_plugin_selection_dispatch_v1}
