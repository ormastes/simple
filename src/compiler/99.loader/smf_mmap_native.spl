# Native Simple mmap Implementation for SMF Files
#
# Uses runtime SFFI wrappers around libc mmap/munmap/etc. to provide executable
# memory and file-backed mappings for the loader. Replaces the old stub that
# returned 0/false for everything.

extern fn rt_file_size(path: text) -> i64

# Low-level syscall SFFI (raw address-based wrappers in C runtime)
extern fn rt_mmap_raw(addr: i64, length: i64, prot: i64, flags: i64, fd: i64, offset: i64) -> i64
extern fn rt_munmap_raw(addr: i64, length: i64) -> i64
extern fn rt_mprotect(addr: i64, length: i64, prot: i64) -> i64
extern fn rt_madvise_raw(addr: i64, length: i64, advice: i64) -> i64
extern fn rt_msync_flags(addr: i64, length: i64, flags: i64) -> i64
extern fn rt_mlock(addr: i64, length: i64) -> i64
extern fn rt_munlock(addr: i64, length: i64) -> i64
extern fn rt_open_fd(path: text, flags: i64, mode: i64) -> i64
extern fn rt_close_fd(fd: i64) -> i64
extern fn rt_page_size() -> i64
extern fn rt_ptr_write_i32(addr: i64, offset: i64, value: i32)
extern fn rt_ptr_write_i64(addr: i64, offset: i64, value: i64)
extern fn rt_ptr_write_u8(addr: i64, offset: i64, value: i64)
extern fn rt_ptr_read_u8(addr: i64, offset: i64) -> i64

# ============================================================================
# Constants (libc values)
# ============================================================================

val PROT_NONE: i64 = 0x0
val PROT_READ: i64 = 0x1
val PROT_WRITE: i64 = 0x2
val PROT_EXEC: i64 = 0x4

val MAP_SHARED: i64 = 0x1
val MAP_PRIVATE: i64 = 0x2
val MAP_ANONYMOUS: i64 = 0x20
val MAP_FAILED: i64 = -1
val O_RDONLY: i64 = 0x0

val MADV_NORMAL: i64 = 0
val MADV_RANDOM: i64 = 1
val MADV_SEQUENTIAL: i64 = 2
val MADV_WILLNEED: i64 = 3
val MADV_DONTNEED: i64 = 4

var _g_fake_memory: Dict<i64, [u8]> = {}
var _g_fake_sizes: Dict<i64, i64> = {}

# ============================================================================
# Native mmap Implementation
# ============================================================================

fn native_mmap_file(path: text, prot: i64, flags: i64, offset: i64, length: i64) -> [i64]:
    if offset < 0 or length < 0:
        return [0, 0]
    # Open file first
    val fd = rt_open_fd(path, O_RDONLY, 0)
    if fd < 0:
        return [0, 0]

    # Get file size if length == 0
    var actual_size = length
    if length == 0:
        val size = rt_file_size(path)
        if size < 0:
            _ = rt_close_fd(fd)
            return [0, 0]
        actual_size = size

    # Call mmap syscall
    val addr = rt_mmap_raw(0, actual_size, prot, flags, fd, offset)

    # Close file descriptor (mmap keeps reference)
    _ = rt_close_fd(fd)

    # Check for error
    if addr == MAP_FAILED:
        return [0, 0]

    [addr, actual_size]

fn native_munmap(address: i64, size: i64) -> bool:
    if address == 0 or size <= 0:
        return false
    if _g_fake_memory.has(address):
        _g_fake_memory = _g_fake_memory.remove(address)
        _g_fake_sizes = _g_fake_sizes.remove(address)
        return true
    rt_munmap_raw(address, size) == 0

fn native_madvise(address: i64, size: i64, advice: i64) -> bool:
    if address == 0 or size <= 0:
        return false
    if _g_fake_memory.has(address):
        return true
    rt_madvise_raw(address, size, advice) == 0

fn native_msync(address: i64, size: i64, is_async: bool) -> bool:
    if address == 0 or size <= 0:
        return false
    if _g_fake_memory.has(address):
        return true
    val flags = if is_async: 1 else: 2  # MS_ASYNC=1, MS_SYNC=2
    rt_msync_flags(address, size, flags) == 0

fn native_mlock(address: i64, size: i64) -> bool:
    if address == 0 or size <= 0:
        return false
    if _g_fake_memory.has(address):
        return true
    rt_mlock(address, size) == 0

fn native_munlock(address: i64, size: i64) -> bool:
    if address == 0 or size <= 0:
        return false
    if _g_fake_memory.has(address):
        return true
    rt_munlock(address, size) == 0

# ============================================================================
# Native Executable Memory
# ============================================================================

fn native_alloc_exec_memory(size: i64) -> i64:
    # Real anonymous RWX mapping (startup_perf_architecture_2026-08-17 §8.4/
    # §8.5). Was previously a fake Dict-backed simulation that could never
    # actually execute -- native_call_function_0 always returned 0 against
    # it. rt_mmap_raw/rt_mprotect are the same SFFI already proven to work
    # from the interpreter by native_mmap_byte_read_spec.spl.
    if size <= 0:
        return 0
    val prot = PROT_READ | PROT_WRITE | PROT_EXEC
    val flags = MAP_PRIVATE | MAP_ANONYMOUS
    val addr = rt_mmap_raw(0, size, prot, flags, -1, 0)
    if addr == MAP_FAILED:
        return 0
    _g_fake_sizes[addr] = size
    addr

fn native_alloc_rw_memory(size: i64) -> i64:
    if size <= 0:
        return 0
    val prot = PROT_READ | PROT_WRITE
    val flags = MAP_PRIVATE | MAP_ANONYMOUS
    val addr = rt_mmap_raw(0, size, prot, flags, -1, 0)
    if addr == MAP_FAILED:
        return 0
    addr

fn native_free_exec_memory(address: i64, size: i64) -> bool:
    if address == 0 or size <= 0:
        return false
    if _g_fake_sizes.has(address):
        _g_fake_sizes = _g_fake_sizes.remove(address)
    rt_munmap_raw(address, size) == 0

fn native_write_exec_memory(address: i64, code: [u8], offset: i64) -> i64:
    # NOTE: uses the extern rt_ptr_write_u8 wrapper, not an `as *u8` unsafe
    # cast -- that cast form is rejected by this interpreter/seed with
    # "unsupported cast target type: Pointer" (compile-time, not a runtime
    # skip -- it fails the whole file). The extern form is the one already
    # proven to work under `bin/simple test` by native_mmap_byte_read_spec.spl.
    if address == 0 or offset < 0:
        return 0
    var i = 0
    while i < code.len():
        rt_ptr_write_u8(address, offset + i, code[i] as i64)
        i = i + 1
    code.len()

fn native_make_executable(address: i64, size: i64) -> bool:
    if address == 0 or size <= 0:
        return false
    rt_mprotect(address, size, PROT_READ | PROT_EXEC) == 0

fn native_flush_icache(address: i64, size: i64):
    # x86/x64: no-op (hardware cache coherence)
    # ARM: would need __clear_cache syscall
    val _ = address
    val _ = size
    nil

fn native_make_rw(address: i64, size: i64) -> bool:
    if address == 0 or size <= 0:
        return false
    rt_mprotect(address, size, PROT_READ | PROT_WRITE) == 0

fn native_mmap_read_bytes(address: i64, offset: i64, length: i64) -> [u8]:
    var out: [u8] = []
    if address == 0 or offset < 0 or length <= 0:
        return out
    var i = 0i64
    while i < length:
        out.push((rt_ptr_read_u8(address, offset + i) & 0xFF) as u8)
        i = i + 1
    out

fn native_reloc_write_i32(address: i64, offset: i64, value: i32):
    if address == 0 or offset < 0:
        return
    rt_ptr_write_i32(address, offset, value)

fn native_reloc_write_i64(address: i64, offset: i64, value: i64):
    if address == 0 or offset < 0:
        return
    rt_ptr_write_i64(address, offset, value)

fn native_get_function_pointer(address: i64) -> i64:
    address  # Function pointer is same as address

fn native_call_function_0(fn_ptr: i64) -> i64:
    # No supported mechanism exists to invoke an arbitrary i64 code address
    # as a function from this interpreter: `fn_ptr as fn() -> i64` is
    # rejected at compile time ("unsupported cast target type: Pointer",
    # confirmed empirically against this seed/interpreter), and there is no
    # `rt_call_*` extern in the C runtime for an unknown-arity raw pointer
    # call either (checked src/runtime/*.c). Calling truly executable code
    # this way is therefore only reachable in COMPILED (JIT) mode, matching
    # the existing documented limitation in
    # test/02_integration/app/loader_exec_memory_spec.spl ("native exec
    # memory functions require compiled mode (not interpreter)"). Returning
    # 0 here is an honest "not executable from this engine", not a silent
    # simulation -- see doc/09_report/segment_loader_wiring_2026-08-18.md.
    val _ = fn_ptr
    0

fn native_call_function_1(fn_ptr: i64, arg1: i64) -> i64:
    val _ = fn_ptr
    val _ = arg1
    0

fn native_call_function_2(fn_ptr: i64, arg1: i64, arg2: i64) -> i64:
    val _ = fn_ptr
    val _ = arg1
    val _ = arg2
    0

fn native_call_function_3(fn_ptr: i64, arg1: i64, arg2: i64, arg3: i64) -> i64:
    val _ = fn_ptr
    val _ = arg1
    val _ = arg2
    val _ = arg3
    0

# ============================================================================
# Exports
# ============================================================================


# Constants
