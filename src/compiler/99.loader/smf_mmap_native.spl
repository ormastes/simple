# Native Simple mmap Implementation for SMF Files
#
# Uses runtime SFFI wrappers around libc mmap/munmap/etc. to provide executable
# memory and file-backed mappings for the loader. Replaces the old stub that
# returned 0/false for everything.

@unsafe(reason: "raw file-size status ABI", capabilities: [ffi])
extern fn rt_file_size(path: text) -> i64

# Low-level syscall SFFI (raw address-based wrappers in C runtime)
@unsafe(reason: "raw nullable mmap address ABI", capabilities: [ffi, raw_ptr])
extern fn rt_mmap_raw(addr: i64, length: i64, prot: i64, flags: i64, fd: i64, offset: i64) -> i64
@unsafe(reason: "raw mapped-address release ABI", capabilities: [ffi, raw_ptr])
extern fn rt_munmap_raw(addr: i64, length: i64) -> i64
@unsafe(reason: "raw mapped-address protection ABI", capabilities: [ffi, raw_ptr])
extern fn rt_mprotect(addr: i64, length: i64, prot: i64) -> i64
@unsafe(reason: "raw mapped-address advice ABI", capabilities: [ffi, raw_ptr])
extern fn rt_madvise_raw(addr: i64, length: i64, advice: i64) -> i64
@unsafe(reason: "raw mapped-address synchronization ABI", capabilities: [ffi, raw_ptr])
extern fn rt_msync_flags(addr: i64, length: i64, flags: i64) -> i64
@unsafe(reason: "raw address/length memory-lock syscall status", capabilities: [ffi, raw_ptr])
extern fn rt_mlock(addr: i64, length: i64) -> i64
@unsafe(reason: "raw address/length memory-unlock syscall status", capabilities: [ffi, raw_ptr])
extern fn rt_munlock(addr: i64, length: i64) -> i64
@unsafe(reason: "raw file-descriptor open ABI", capabilities: [ffi])
extern fn rt_open_fd(path: text, flags: i64, mode: i64) -> i64
@unsafe(reason: "raw file-descriptor close ABI", capabilities: [ffi])
extern fn rt_close_fd(fd: i64) -> i64

@unsafe(reason: "nonnull executable function-pointer ABI; invalid address is a hard error", capabilities: [ffi, raw_ptr])
extern fn rt_call_ptr_0(addr: i64) -> i64
@unsafe(reason: "nonnull executable function-pointer ABI; invalid address is a hard error", capabilities: [ffi, raw_ptr])
extern fn rt_call_ptr_1(addr: i64, arg1: i64) -> i64
@unsafe(reason: "nonnull executable function-pointer ABI; invalid address is a hard error", capabilities: [ffi, raw_ptr])
extern fn rt_call_ptr_2(addr: i64, arg1: i64, arg2: i64) -> i64
@unsafe(reason: "nonnull executable function-pointer ABI; invalid address is a hard error", capabilities: [ffi, raw_ptr])
extern fn rt_call_ptr_3(addr: i64, arg1: i64, arg2: i64, arg3: i64) -> i64

@unsafe(reason: "nullable sentinel pointer borrows packed byte-array storage for one synchronous copy", capabilities: [ffi, raw_ptr])
extern fn rt_array_data_ptr(bytes: [u8]) -> i64
@unsafe(reason: "nonnull borrowed source; written-length status reports the copy result", capabilities: [ffi, raw_ptr])
extern fn rt_ptr_write_bytes_raw(addr: i64, offset: i64, src: i64, length: i64) -> i64
@unsafe(reason: "nonnull mapped-memory byte write with caller-owned bounds", capabilities: [ffi, raw_ptr])
extern fn rt_ptr_write_u8(addr: i64, offset: i64, value: i64)
@unsafe(reason: "nonnull mapped-memory relocation write with caller-owned bounds", capabilities: [ffi, raw_ptr])
extern fn rt_ptr_write_i32(addr: i64, offset: i64, value: i32)
@unsafe(reason: "nonnull mapped-memory relocation write with caller-owned bounds", capabilities: [ffi, raw_ptr])
extern fn rt_ptr_write_i64(addr: i64, offset: i64, value: i64)
@unsafe(reason: "nonnull borrowed source is copied into an owned byte array", capabilities: [ffi, raw_ptr])
extern fn rt_bytes_from_raw(addr: i64, length: i64) -> [u8]

@always_inline
fn _sffi_file_size(path: text) -> i64:
    unsafe(capabilities: [ffi]):
        rt_file_size(path)

@always_inline
fn _sffi_open_fd(path: text, flags: i64, mode: i64) -> i64:
    unsafe(capabilities: [ffi]):
        rt_open_fd(path, flags, mode)

@always_inline
fn _sffi_close_fd(fd: i64) -> i64:
    unsafe(capabilities: [ffi]):
        rt_close_fd(fd)

@always_inline
fn _sffi_mmap_raw(addr: i64, length: i64, prot: i64, flags: i64, fd: i64, offset: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]):
        rt_mmap_raw(addr, length, prot, flags, fd, offset)

@always_inline
fn _sffi_munmap_raw(addr: i64, length: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]):
        rt_munmap_raw(addr, length)

@always_inline
fn _sffi_mprotect(addr: i64, length: i64, prot: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]):
        rt_mprotect(addr, length, prot)

@always_inline
fn _sffi_madvise_raw(addr: i64, length: i64, advice: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]):
        rt_madvise_raw(addr, length, advice)

@always_inline
fn _sffi_msync_flags(addr: i64, length: i64, flags: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]):
        rt_msync_flags(addr, length, flags)

# ============================================================================
# Constants (libc values)
# ============================================================================

val PROT_NONE: i64 = 0x0
val PROT_READ: i64 = 0x1
val PROT_WRITE: i64 = 0x2
val PROT_EXEC: i64 = 0x4

val MAP_SHARED: i64 = 0x1
val MAP_PRIVATE: i64 = 0x2
val MAP_ANONYMOUS: i64 = 0x20
val MAP_FAILED: i64 = -1
val O_RDONLY: i64 = 0x0

val MADV_NORMAL: i64 = 0
val MADV_RANDOM: i64 = 1
val MADV_SEQUENTIAL: i64 = 2
val MADV_WILLNEED: i64 = 3
val MADV_DONTNEED: i64 = 4

# ============================================================================
# Native mmap Implementation
# ============================================================================

fn native_mmap_file(path: text, prot: i64, flags: i64, offset: i64, length: i64) -> [i64]:
    if offset < 0 or length < 0:
        return [0, 0]
    # Open file first
    val fd = _sffi_open_fd(path, O_RDONLY, 0)
    if fd < 0:
        return [0, 0]

    # Get file size if length == 0
    var actual_size = length
    if length == 0:
        val size = _sffi_file_size(path)
        if size < 0:
            _ = _sffi_close_fd(fd)
            return [0, 0]
        actual_size = size

    # Call mmap syscall
    val addr = _sffi_mmap_raw(0, actual_size, prot, flags, fd, offset)

    # Close file descriptor (mmap keeps reference)
    _ = _sffi_close_fd(fd)

    # Check for error
    if addr == MAP_FAILED:
        return [0, 0]

    [addr, actual_size]

@unsafe(reason: "caller owns mapped-address extent and release lifetime", capabilities: [raw_ptr])
fn native_munmap(address: i64, size: i64) -> bool:
    if address == 0 or size <= 0:
        return false
    _sffi_munmap_raw(address, size) == 0

@unsafe(reason: "caller owns mapped-address extent and lifetime", capabilities: [raw_ptr])
fn native_madvise(address: i64, size: i64, advice: i64) -> bool:
    if address == 0 or size <= 0:
        return false
    _sffi_madvise_raw(address, size, advice) == 0

@unsafe(reason: "caller owns mapped-address extent and lifetime", capabilities: [raw_ptr])
fn native_msync(address: i64, size: i64, is_async: bool) -> bool:
    if address == 0 or size <= 0:
        return false
    val flags = if is_async: 1 else: 2  # MS_ASYNC=1, MS_SYNC=2
    _sffi_msync_flags(address, size, flags) == 0

@unsafe(reason: "caller owns mapped-address extent and lifetime", capabilities: [raw_ptr])
fn native_mlock(address: i64, size: i64) -> bool:
    if address == 0 or size <= 0:
        return false
    val status = unsafe(capabilities: [ffi, raw_ptr]):
        rt_mlock(address, size)
    status == 0

@unsafe(reason: "caller owns mapped-address extent and lifetime", capabilities: [raw_ptr])
fn native_munlock(address: i64, size: i64) -> bool:
    if address == 0 or size <= 0:
        return false
    val status = unsafe(capabilities: [ffi, raw_ptr]):
        rt_munlock(address, size)
    status == 0

# ============================================================================
# Native Executable Memory
# ============================================================================

fn native_alloc_exec_memory(size: i64) -> i64:
    # Allocate RW and require the existing explicit RW->RX transition before
    # execution; never create a transient RWX mapping.
    if size <= 0:
        return 0
    val addr = _sffi_mmap_raw(0, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0)
    if addr == MAP_FAILED:
        return 0
    addr

fn native_alloc_rw_memory(size: i64) -> i64:
    native_alloc_exec_memory(size)

@unsafe(reason: "caller owns executable mapping and release extent", capabilities: [raw_ptr])
fn native_free_exec_memory(address: i64, size: i64) -> bool:
    if address == 0 or size <= 0:
        return false
    _sffi_munmap_raw(address, size) == 0

@unsafe(reason: "caller owns executable mapping and write extent", capabilities: [raw_ptr])
fn native_write_exec_memory(address: i64, code: [u8], offset: i64) -> i64:
    if address == 0 or offset < 0:
        return 0
    val length = code.len() as i64
    if length == 0:
        return 0
    var source: i64 = 0
    unsafe(capabilities: [ffi, raw_ptr]):
        source = rt_array_data_ptr(code)
    if source != 0:
        var written: i64 = 0
        unsafe(capabilities: [ffi, raw_ptr]):
            written = rt_ptr_write_bytes_raw(address, offset, source, length)
        return written
    var i: i64 = 0
    while i < length:
        unsafe(capabilities: [ffi, raw_ptr]):
            rt_ptr_write_u8(address, offset + i, code[i] as i64)
        i = i + 1
    length

@unsafe(reason: "caller owns mapped-address extent and protection state", capabilities: [raw_ptr])
fn native_make_executable(address: i64, size: i64) -> bool:
    if address == 0 or size <= 0:
        return false
    _sffi_mprotect(address, size, PROT_READ | PROT_EXEC) == 0

fn native_flush_icache(address: i64, size: i64):
    """Compatibility fence; the successful RX transition performs cache sync."""
    val _ = address
    val _ = size
    nil

@unsafe(reason: "caller owns mapped-address extent and protection state", capabilities: [raw_ptr])
fn native_make_rw(address: i64, size: i64) -> bool:
    if address == 0 or size <= 0:
        return false
    _sffi_mprotect(address, size, PROT_READ | PROT_WRITE) == 0

@unsafe(reason: "caller owns mapped-address extent and read lifetime", capabilities: [raw_ptr])
fn native_mmap_read_bytes(address: i64, offset: i64, length: i64) -> [u8]:
    if address == 0 or offset < 0 or length <= 0:
        return []
    var bytes: [u8] = []
    unsafe(capabilities: [ffi, raw_ptr]):
        bytes = rt_bytes_from_raw(address + offset, length)
    bytes

@unsafe(reason: "caller owns relocation target extent and write lifetime", capabilities: [raw_ptr])
fn native_reloc_write_i32(address: i64, offset: i64, value: i32):
    if address == 0 or offset < 0:
        return
    unsafe(capabilities: [ffi, raw_ptr]):
        rt_ptr_write_i32(address, offset, value)

@unsafe(reason: "caller owns relocation target extent and write lifetime", capabilities: [raw_ptr])
fn native_reloc_write_i64(address: i64, offset: i64, value: i64):
    if address == 0 or offset < 0:
        return
    unsafe(capabilities: [ffi, raw_ptr]):
        rt_ptr_write_i64(address, offset, value)

@unsafe(reason: "caller proves executable mapping and eventual function signature", capabilities: [raw_ptr])
fn native_get_function_pointer(address: i64) -> i64:
    address  # Function pointer is same as address

@unsafe(reason: "caller must provide an executable zero-argument i64 ABI address", capabilities: [raw_ptr])
fn native_call_function_0(fn_ptr: i64) -> Result<i64, text>:
    if fn_ptr <= 0:
        return Err("cannot call a null or invalid native function address")
    var result: i64 = 0
    unsafe(capabilities: [ffi, raw_ptr]):
        result = rt_call_ptr_0(fn_ptr)
    Ok(result)

@unsafe(reason: "caller must provide an executable one-argument i64 ABI address", capabilities: [raw_ptr])
fn native_call_function_1(fn_ptr: i64, arg1: i64) -> Result<i64, text>:
    if fn_ptr <= 0:
        return Err("cannot call a null or invalid native function address")
    var result: i64 = 0
    unsafe(capabilities: [ffi, raw_ptr]):
        result = rt_call_ptr_1(fn_ptr, arg1)
    Ok(result)

@unsafe(reason: "caller must provide an executable two-argument i64 ABI address", capabilities: [raw_ptr])
fn native_call_function_2(fn_ptr: i64, arg1: i64, arg2: i64) -> Result<i64, text>:
    if fn_ptr <= 0:
        return Err("cannot call a null or invalid native function address")
    var result: i64 = 0
    unsafe(capabilities: [ffi, raw_ptr]):
        result = rt_call_ptr_2(fn_ptr, arg1, arg2)
    Ok(result)

@unsafe(reason: "caller must provide an executable three-argument i64 ABI address", capabilities: [raw_ptr])
fn native_call_function_3(fn_ptr: i64, arg1: i64, arg2: i64, arg3: i64) -> Result<i64, text>:
    if fn_ptr <= 0:
        return Err("cannot call a null or invalid native function address")
    var result: i64 = 0
    unsafe(capabilities: [ffi, raw_ptr]):
        result = rt_call_ptr_3(fn_ptr, arg1, arg2, arg3)
    Ok(result)

