# Compatibility facade for the canonical loader mmap implementation.
#
# Keep this direct-file module for older imports such as
# `compiler.loader.smf_mmap_native.{native_mmap_file}`. The implementation and
# its contracts live in exactly one terminal module. In particular,
# `native_mmap_file` deliberately keeps the canonical `(i64, i64)` return type
# rather than the legacy facade's divergent `[i64]` annotation.
export use compiler.loader.loader.smf_mmap_native.{
    native_mmap_file, native_munmap, native_madvise, native_msync,
    native_mlock, native_munlock,
    native_alloc_exec_memory, native_alloc_rw_memory, native_free_exec_memory,
    native_write_exec_memory, native_make_executable, native_make_rw,
    native_flush_icache, native_mmap_read_bytes,
    native_reloc_write_i32, native_reloc_write_i64,
    native_get_function_pointer,
    native_call_function_0, native_call_function_1, native_call_function_2,
    native_call_function_3,
    PROT_NONE, PROT_READ, PROT_WRITE, PROT_EXEC,
    MAP_SHARED, MAP_PRIVATE, MAP_ANONYMOUS, MAP_FAILED, O_RDONLY,
    MADV_NORMAL, MADV_RANDOM, MADV_SEQUENTIAL, MADV_WILLNEED, MADV_DONTNEED
}
