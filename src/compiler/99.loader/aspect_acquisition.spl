# Loader-owned aspect acquisition bridge.
#
# The public boundary is deliberately handle/scalar based. The common
# aspect-pack provider still owns the catalog and facet result types; this
# module only keeps those aggregates behind an opaque loader state/result
# handle so the canonical loader never depends on copied Dict/array state.

use compiler.backend.linker.smf_reader_memory.{SmfReaderMemory}
use compiler.loader.aspect_pack_index_cache.{
    PackIndexCache, pack_index_cache_new, pack_index_get,
    pack_index_get_window, pack_index_invalidate, pack_index_evict_all,
    pack_index_cached_count
}
use compiler.loader.aspect_pack_section.{
    smf_find_section_by_wire_type, smf_aspect_pack_bytes,
    SMF_SECTION_ASPECT_PACK_DIRECTORY
}
use compiler.loader.smf_segment_load.{smf_section_extent}
use std.common.aspect_pack.{
    ApkFacetLoadV1, apk_loader_new, apk_loader_register_pack,
    apk_open_pack_v1, apk_load_facet, apk_try_facet, apk_unload_facet_v1
}

var _aspect_provider_handles: [i64] = []
var _aspect_index_caches: [PackIndexCache] = []
var _aspect_epochs: [i64] = []
var _aspect_state_active: [bool] = []

# Registered pack bytes are kept in one scalar byte pool. Rebuilding a
# provider after unload therefore does not require returning nested arrays or
# Dicts across a module boundary.
var _aspect_reg_states: [i64] = []
var _aspect_reg_paths: [text] = []
var _aspect_reg_offsets: [i64] = []
var _aspect_reg_lengths: [i64] = []
var _aspect_reg_active: [bool] = []
var _aspect_reg_pool: [u8] = []

var _aspect_results: [ApkFacetLoadV1] = []
var _aspect_result_states: [i64] = []
var _aspect_result_epochs: [i64] = []

fn _loader_aspect_state_valid(state: i64) -> bool:
    (state >= 0 and state < _aspect_provider_handles.len() and
        state < _aspect_index_caches.len() and state < _aspect_epochs.len() and
        state < _aspect_state_active.len() and _aspect_state_active[state])

fn loader_aspect_state_new() -> i64:
    val state = _aspect_provider_handles.len()
    _aspect_provider_handles.push(apk_loader_new())
    _aspect_index_caches.push(pack_index_cache_new())
    _aspect_epochs.push(0)
    _aspect_state_active.push(true)
    state

fn loader_aspect_provider_handle(state: i64) -> i64:
    if not _loader_aspect_state_valid(state):
        return -1
    _aspect_provider_handles[state]

fn _loader_aspect_registered(state: i64, path: text) -> bool:
    var i = 0
    while i < _aspect_reg_states.len():
        if (_aspect_reg_active[i] and _aspect_reg_states[i] == state and
            _aspect_reg_paths[i] == path):
            return true
        i = i + 1
    false

fn _loader_aspect_record_pack(state: i64, path: text, bytes: [u8]):
    val off = _aspect_reg_pool.len()
    var i = 0
    while i < bytes.len():
        _aspect_reg_pool.push(bytes[i])
        i = i + 1
    _aspect_reg_states.push(state)
    _aspect_reg_paths.push(path)
    _aspect_reg_offsets.push(off)
    _aspect_reg_lengths.push(bytes.len())
    _aspect_reg_active.push(true)

fn _loader_aspect_registration_valid(registration: i64) -> bool:
    if (registration < 0 or registration >= _aspect_reg_states.len() or
        registration >= _aspect_reg_paths.len() or
        registration >= _aspect_reg_offsets.len() or
        registration >= _aspect_reg_lengths.len() or
        registration >= _aspect_reg_active.len()):
        return false
    val off = _aspect_reg_offsets[registration]
    val len = _aspect_reg_lengths[registration]
    (off >= 0 and len >= 0 and off <= _aspect_reg_pool.len() and
        len <= _aspect_reg_pool.len() - off)

fn _loader_aspect_pack_bytes(registration: i64) -> [u8]:
    var out: [u8] = []
    if not _loader_aspect_registration_valid(registration):
        return out
    val off = _aspect_reg_offsets[registration]
    val len = _aspect_reg_lengths[registration]
    var i = 0
    while i < len:
        out.push(_aspect_reg_pool[off + i])
        i = i + 1
    out

fn _loader_aspect_register_validated(state: i64, path: text, bytes: [u8], module_count: i64) -> i64:
    if not _loader_aspect_state_valid(state) or module_count <= 0:
        return -1
    if _loader_aspect_registered(state, path):
        return -1
    if not apk_loader_register_pack(_aspect_provider_handles[state], path, bytes):
        return -1
    _loader_aspect_record_pack(state, path, bytes)
    module_count

fn loader_aspect_register_pack(state: i64, path: text, bytes: [u8]) -> i64:
    """Register a standalone pack after a windowed index-only admission."""
    if not _loader_aspect_state_valid(state):
        return -1
    val index = pack_index_get(_aspect_index_caches[state], path)
    if not index.ok:
        return -1
    val opened = apk_open_pack_v1(bytes)
    if not opened.ok or opened.module_count != index.module_count:
        return -1
    _loader_aspect_register_validated(state, path, bytes, opened.module_count)

fn loader_aspect_register_smf(state: i64, path: text, smf_bytes: [u8]) -> i64:
    """Register one embedded `.aspect_pack` using its exact file window."""
    if not _loader_aspect_state_valid(state):
        return -1
    val parsed = SmfReaderMemory.from_data(smf_bytes)
    if parsed.is_err():
        return -1
    val reader = parsed.unwrap()
    val section_index = smf_find_section_by_wire_type(reader, SMF_SECTION_ASPECT_PACK_DIRECTORY)
    if section_index < 0 or not reader.header.flags.aspect_pack:
        return -1
    val extent_result = smf_section_extent(reader, section_index)
    if extent_result.is_err():
        return -1
    val extent = extent_result.unwrap()
    val index = pack_index_get_window(
        _aspect_index_caches[state], path, path, extent.file_offset, extent.size)
    if not index.ok:
        return -1
    val payload_result = smf_aspect_pack_bytes(reader)
    if payload_result.is_err():
        return -1
    val payload = payload_result.unwrap()
    val opened = apk_open_pack_v1(payload)
    if not opened.ok or opened.module_count != index.module_count:
        return -1
    _loader_aspect_register_validated(state, path, payload, opened.module_count)

fn _loader_aspect_record_result(state: i64, result: ApkFacetLoadV1) -> i64:
    val handle = _aspect_results.len()
    _aspect_results.push(result)
    _aspect_result_states.push(state)
    _aspect_result_epochs.push(_aspect_epochs[state])
    handle

fn loader_aspect_acquire(state: i64, catalog: [u8], facet_key: text) -> i64:
    if not _loader_aspect_state_valid(state):
        return -1
    _loader_aspect_record_result(
        state, apk_load_facet(_aspect_provider_handles[state], catalog, facet_key))

fn loader_aspect_try_resident(state: i64, facet_key: text) -> i64:
    if not _loader_aspect_state_valid(state):
        return -1
    _loader_aspect_record_result(
        state, apk_try_facet(_aspect_provider_handles[state], facet_key))

fn _loader_aspect_result_valid(result: i64) -> bool:
    (result >= 0 and result < _aspect_results.len() and
        result < _aspect_result_states.len() and
        result < _aspect_result_epochs.len())

fn loader_aspect_result_is_current(result: i64) -> bool:
    if not _loader_aspect_result_valid(result):
        return false
    val state = _aspect_result_states[result]
    _loader_aspect_state_valid(state) and _aspect_result_epochs[result] == _aspect_epochs[state]

fn loader_aspect_result_ok(result: i64) -> bool:
    loader_aspect_result_is_current(result) and _aspect_results[result].ok

fn loader_aspect_result_found(result: i64) -> bool:
    loader_aspect_result_is_current(result) and _aspect_results[result].found

fn loader_aspect_result_error_code(result: i64) -> text:
    if not _loader_aspect_result_valid(result):
        return "APK_LOADER_BAD_RESULT_HANDLE"
    if not loader_aspect_result_is_current(result):
        return "APK_LOADER_STALE_RESULT_HANDLE"
    _aspect_results[result].error_code

fn loader_aspect_result_error_message(result: i64) -> text:
    if not _loader_aspect_result_valid(result):
        return "invalid loader aspect result handle"
    if not loader_aspect_result_is_current(result):
        return "stale loader aspect result handle"
    _aspect_results[result].error_message

fn loader_aspect_result_facet_key(result: i64) -> text:
    if not loader_aspect_result_is_current(result):
        return ""
    _aspect_results[result].facet_key

fn loader_aspect_result_pack_path(result: i64) -> text:
    if not loader_aspect_result_is_current(result):
        return ""
    _aspect_results[result].pack_path

fn loader_aspect_result_module_id(result: i64) -> text:
    if not loader_aspect_result_is_current(result):
        return ""
    _aspect_results[result].module_id

fn loader_aspect_result_aspect_id(result: i64) -> text:
    if not loader_aspect_result_is_current(result):
        return ""
    _aspect_results[result].aspect_id

fn loader_aspect_result_activation(result: i64) -> i64:
    if not loader_aspect_result_is_current(result):
        return 0
    _aspect_results[result].activation

fn loader_aspect_result_from_cache(result: i64) -> bool:
    loader_aspect_result_is_current(result) and _aspect_results[result].from_cache

fn loader_aspect_result_generation(result: i64) -> i64:
    if not loader_aspect_result_is_current(result):
        return 0
    _aspect_results[result].generation

fn loader_aspect_result_payload_len(result: i64) -> i64:
    if not loader_aspect_result_is_current(result):
        return 0
    _aspect_results[result].payload.len()

fn loader_aspect_result_payload_byte(result: i64, offset: i64) -> i64:
    if not loader_aspect_result_is_current(result):
        return -1
    val payload = _aspect_results[result].payload
    if offset < 0 or offset >= payload.len():
        return -1
    payload[offset] as i64

fn loader_aspect_index_cached_count(state: i64) -> i64:
    if not _loader_aspect_state_valid(state):
        return 0
    pack_index_cached_count(_aspect_index_caches[state])

fn loader_aspect_index_bytes_read(state: i64) -> i64:
    if not _loader_aspect_state_valid(state):
        return 0
    _aspect_index_caches[state].index_bytes_read

fn loader_aspect_invalidate(state: i64, path: text) -> bool:
    if not _loader_aspect_state_valid(state):
        return false
    pack_index_invalidate(_aspect_index_caches[state], path)

fn _loader_aspect_candidate_provider(state: i64, excluded_path: text,
        replacement_path: text, replacement_bytes: [u8]) -> i64:
    if not _loader_aspect_state_valid(state):
        return -1
    val replacement = apk_loader_new()
    if replacement < 0:
        return -1
    var i = 0
    while i < _aspect_reg_states.len():
        if (_loader_aspect_registration_valid(i) and _aspect_reg_active[i] and
            _aspect_reg_states[i] == state and
            _aspect_reg_paths[i] != excluded_path):
            val payload = _loader_aspect_pack_bytes(i)
            if not apk_loader_register_pack(replacement, _aspect_reg_paths[i], payload):
                return -1
        i = i + 1
    if replacement_path != "" and not apk_loader_register_pack(
            replacement, replacement_path, replacement_bytes):
        return -1
    replacement

fn _loader_aspect_commit_replacement(state: i64, path: text,
        replacement: i64, replacement_bytes: [u8], record_replacement: bool):
    var i = 0
    while i < _aspect_reg_states.len():
        if (_loader_aspect_registration_valid(i) and _aspect_reg_active[i] and
            _aspect_reg_states[i] == state and _aspect_reg_paths[i] == path):
            _aspect_reg_active[i] = false
        i = i + 1
    if record_replacement:
        _loader_aspect_record_pack(state, path, replacement_bytes)
    _aspect_provider_handles[state] = replacement
    _aspect_epochs[state] = _aspect_epochs[state] + 1

fn loader_aspect_unload(state: i64, path: text) -> i64:
    """Invalidate one pack and rebuild the provider without its bytes.

    Rebuilding is required because the common provider intentionally has no
    unregister operation. It also invalidates every previously issued result
    handle by advancing the loader epoch, so stale facet payloads cannot be
    mistaken for a resident binding after unload."""
    if not _loader_aspect_state_valid(state):
        return 0
    var removed = 0
    var i = 0
    while i < _aspect_reg_states.len():
        if (_loader_aspect_registration_valid(i) and _aspect_reg_active[i] and
            _aspect_reg_states[i] == state and
            _aspect_reg_paths[i] == path):
            removed = removed + 1
        i = i + 1
    if removed > 0:
        val replacement = _loader_aspect_candidate_provider(state, path, "", [])
        if replacement < 0:
            return 0
        # Ask the current provider to quiesce known bindings before replacing
        # it. The scalar return intentionally does not expose unload records.
        var r = 0
        while r < _aspect_results.len():
            if (_aspect_result_states[r] == state and
                _aspect_results[r].found and _aspect_results[r].pack_path == path):
                _ = apk_unload_facet_v1(
                    _aspect_provider_handles[state], _aspect_results[r].facet_key)
            r = r + 1
        _loader_aspect_commit_replacement(state, path, replacement, [], false)
    _ = pack_index_invalidate(_aspect_index_caches[state], path)
    removed

fn loader_aspect_replace_smf(state: i64, path: text, smf_bytes: [u8]) -> i64:
    """Transactionally replace one embedded pack registration.

    `-1` means the replacement SMF has no aspect-pack section (the prior pack
    is removed). `-2` means the candidate is malformed or conflicts with a
    retained pack; in that case the current provider and result epoch remain
    untouched so the module loader can roll back its candidate generation."""
    if not _loader_aspect_state_valid(state):
        return -2
    val parsed = SmfReaderMemory.from_data(smf_bytes)
    if parsed.is_err():
        return -2
    val reader = parsed.unwrap()
    val section_index = smf_find_section_by_wire_type(reader, SMF_SECTION_ASPECT_PACK_DIRECTORY)
    if section_index < 0 or not reader.header.flags.aspect_pack:
        if _loader_aspect_registered(state, path) and loader_aspect_unload(state, path) == 0:
            return -2
        return -1
    val extent_result = smf_section_extent(reader, section_index)
    if extent_result.is_err():
        return -2
    val extent = extent_result.unwrap()
    _ = pack_index_invalidate(_aspect_index_caches[state], path)
    val index = pack_index_get_window(
        _aspect_index_caches[state], path, path, extent.file_offset, extent.size)
    if not index.ok:
        return -2
    val payload_result = smf_aspect_pack_bytes(reader)
    if payload_result.is_err():
        return -2
    val payload = payload_result.unwrap()
    val opened = apk_open_pack_v1(payload)
    if not opened.ok or opened.module_count != index.module_count:
        return -2
    val replacement = _loader_aspect_candidate_provider(state, path, path, payload)
    if replacement < 0:
        return -2
    _loader_aspect_commit_replacement(state, path, replacement, payload, true)
    opened.module_count

fn loader_aspect_destroy(state: i64) -> i64:
    """Unload every registered pack and evict the entire windowed index."""
    if not _loader_aspect_state_valid(state):
        return 0
    val replacement = apk_loader_new()
    var removed = 0
    var i = 0
    while i < _aspect_reg_states.len():
        if _aspect_reg_active[i] and _aspect_reg_states[i] == state:
            _aspect_reg_active[i] = false
            removed = removed + 1
        i = i + 1
    _ = pack_index_evict_all(_aspect_index_caches[state])
    _aspect_provider_handles[state] = replacement
    _aspect_epochs[state] = _aspect_epochs[state] + 1
    _aspect_state_active[state] = false
    removed
