# Loader adapter for the module-loading application's discovery input port.

use compiler.common.module_resolver_port.{ModuleResolverPort}
use compiler.mdsoc.feature.module_loading.app.module_resolver_discovery_port.{ModuleResolverDiscoveryPort}
use compiler.loader.module_resolver.aspect_registry.{aspect_registry_port_for_inputs}

fn _aspect_registry_resolve_inputs(inputs: [text]) -> Result<ModuleResolverPort, text>:
    val installed = aspect_registry_port_for_inputs(inputs)
    if installed.errors.len() > 0:
        val location = if installed.manifest_path == "": "<registry>" else: installed.manifest_path
        return Err("aspect registry {installed.errors.join(",")}: {location}")
    Ok(installed.port)

fn create_aspect_registry_module_resolver_discovery() -> ModuleResolverDiscoveryPort:
    ModuleResolverDiscoveryPort(
        name: "loader-aspect-registry-discovery",
        resolve_inputs_fn: _aspect_registry_resolve_inputs
    )
