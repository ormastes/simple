# Module Path Resolution Logic
#
# This module handles resolving module paths to filesystem locations,
# including support for both absolute (crate.*) and relative paths.
#
# Port of: rust/compiler/src/module_resolver/resolution.rs (309 lines)


use compiler.frontend.ast.{Node}
use compiler.common.dependency.visibility.{Visibility}
use compiler.loader.module_resolver.types.{ModuleResolver, ResolvedModule, DirectoryManifest, ModulePath}
use compiler.common.error.{CompileError}
use std.log.{debug}

# ============================================================================
# Module Resolution
# ============================================================================

impl ModuleResolver:
    fn resolve(path: ModulePath, from_file: text) -> ResolvedModule | CompileError:
        """Resolve a module path to a filesystem path.

        Uses a resolution cache to avoid repeated filesystem probing.
        Cache key is "segments;from_file" for O(1) lookup on repeat imports.
        """
        val segments = path.segments
        debug("resolver", "Resolving module path: {segments} from {from_file}")

        self.resolve_count = self.resolve_count + 1

        if segments.is_empty():
            return CompileError.semantic("empty module path: provide at least one module path segment")

        # Check resolution cache. The active variant fingerprint is part of the
        # key so a `--var-profile` change cannot reuse a stale resolved path.
        val cache_key = "{segments.join('.')};{from_file};{self.var_fingerprint}"
        if self.resolution_cache.has(cache_key):
            self.cache_hit_count = self.cache_hit_count + 1
            val cached = self.resolution_cache[cache_key]
            if cached.?:
                val cached_path = cached ?? ""
                return Ok(ResolvedModule.file(cached_path, path.clone()))
            else:
                return CompileError.semantic("cannot resolve import: module not found (cached); module path was previously unresolvable")

        # Determine base directory
        val (base_dir, remaining) = if segments[0] == "crate":
            # Absolute path from project root
            (self.source_root.clone(), segments[1..])
        else:
            # Relative path from current file's directory
            val parent = path_parent(from_file)
            (parent, segments)

        # Try resolving from the base directory first
        match self.resolve_from_base(base_dir, remaining, path):
            Ok(resolved):
                self.resolution_cache[cache_key] = Some(resolved.path)
                return Ok(resolved)
            Err(err):
                # Variant overlay (`variants/`) roots — searched after relative
                # resolution fails, before stdlib. Stable imports only; never
                # crate.* (absolute) paths. Roots are in precedence order
                # (selected before default), each project-root-relative.
                if segments[0] != "crate":
                    for var_root in self.var_roots:
                        val abs_root = path_join(self.project_root, var_root)
                        match self.resolve_from_base(abs_root, segments, path):
                            Ok(resolved):
                                self.resolution_cache[cache_key] = Some(resolved.path)
                                return Ok(resolved)
                            Err(_):
                                pass

                # If relative resolution failed and stdlib is available, try stdlib
                if segments[0] != "crate":
                    if val Some(stdlib_root) = self.stdlib_root:
                        # If path starts with "std_lib", strip that prefix
                        val stdlib_segments = if segments.len() > 0 and segments[0] == "std_lib":
                            segments[1..]
                        else:
                            segments

                        if not stdlib_segments.is_empty():
                            match self.resolve_from_base(stdlib_root, stdlib_segments, path):
                                Ok(resolved):
                                    self.resolution_cache[cache_key] = Some(resolved.path)
                                    return Ok(resolved)
                                Err(_):
                                    pass

                # Skip stdlib lib/ subdirectory search for non-std/lib imports
                val is_std_or_lib = segments[0] == "std" or segments[0] == "lib"
                if is_std_or_lib:
                    val inner_segments = segments[1..]
                    # Try direct lib/ path first
                    var lib_segments = ["lib"]
                    lib_segments.extend(inner_segments)
                    match self.resolve_from_base(self.source_root.clone(), lib_segments, path):
                        Ok(resolved):
                            # A tier-less path that resolves HERE landed on a
                            # root `src/lib/<name>/` module, shadowing any
                            # same-named tier module deterministically. Same
                            # diagnostic, same non-fatal contract.
                            val root_lib_dir = path_join(self.source_root.clone(), "lib")
                            if rt_dir_exists(root_lib_dir):
                                self.maybe_warn_tier_ambiguity(root_lib_dir, inner_segments, from_file)
                            self.resolution_cache[cache_key] = Some(resolved.path)
                            return Ok(resolved)
                        Err(_):
                            pass
                    # Try lib/*/ subdirectory search
                    # When allowed_families is non-empty (set by target presets),
                    # only search subdirectories in the allowed list.
                    val lib_dir = path_join(self.source_root.clone(), "lib")
                    if rt_dir_exists(lib_dir):
                        # Tier-less `use std.<path>`: which tier wins used to be
                        # decided by raw readdir order, i.e. by the filesystem.
                        # That is not merely "registration order" -- it is not
                        # even stable across machines or checkouts, so the same
                        # source could bind a different module on a different
                        # box with no diagnostic. Search in a FIXED tier
                        # precedence instead. This cannot change the outcome for
                        # any path that exists in exactly one tier; it only makes
                        # the ambiguous case reproducible, and it is the ordering
                        # the non-fatal warning below already assumes. See
                        # doc/08_tracking/bug/tierless_std_import_readdir_order_2026-08-17.md
                        val subdirs = tier_ordered_subdirs(self.cached_dir_list(lib_dir))
                        for subdir in subdirs:
                            # Filter by allowed_families if restriction is active
                            if self.allowed_families.len() > 0:
                                var family_allowed = false
                                for af in self.allowed_families:
                                    if af == subdir:
                                        family_allowed = true
                                if not family_allowed:
                                    continue
                            var sub_segments = ["lib", subdir]
                            sub_segments.extend(inner_segments)
                            match self.resolve_from_base(self.source_root.clone(), sub_segments, path):
                                Ok(resolved):
                                    # Stage-1 tier-ambiguity diagnostic: a
                                    # tier-less std.<path> that also exists in
                                    # other tiers resolved by listing order.
                                    # Non-fatal; never alters resolution.
                                    self.maybe_warn_tier_ambiguity(lib_dir, inner_segments, from_file)
                                    self.resolution_cache[cache_key] = Some(resolved.path)
                                    return Ok(resolved)
                                Err(_):
                                    pass

                # Strategy: Try source_root as base for top-level module names
                # e.g., "use app.sffi_gen.parser" → source_root/app/sffi_gen/parser.spl
                # This handles cross-project imports declared in simple.sdn
                if segments[0] != "crate" and segments.len() > 1:
                    val top_dir = path_join(self.source_root.clone(), segments[0])
                    if rt_dir_exists(top_dir):
                        match self.resolve_from_base(top_dir, segments[1..], path):
                            Ok(resolved):
                                self.resolution_cache[cache_key] = Some(resolved.path)
                                return Ok(resolved)
                            Err(_):
                                pass

                # Strategy 5: Try project_root for top-level dirs not under source_root
                # e.g., "use examples.browser.*" → project_root/examples/11_advanced/browser/
                if segments[0] != "crate" and segments.len() > 1:
                    val proj_dir = path_join(self.project_root.clone(), segments[0])
                    if rt_dir_exists(proj_dir):
                        match self.resolve_from_base(proj_dir, segments[1..], path):
                            Ok(resolved):
                                self.resolution_cache[cache_key] = Some(resolved.path)
                                return Ok(resolved)
                            Err(_):
                                pass

                # Cache the miss
                self.resolution_cache[cache_key] = nil
                return Err(err)

    fn cached_dir_list(dir_path: text) -> [text]:
        """Get directory listing with caching to avoid repeated rt_dir_list calls."""
        if self.dir_cache.has(dir_path):
            return self.dir_cache[dir_path]
        self.dir_list_call_count = self.dir_list_call_count + 1
        val entries = rt_dir_list(dir_path)
        self.dir_cache[dir_path] = entries
        entries

    fn clear_cache():
        """Clear all resolution caches. Call between test runs."""
        self.resolution_cache = {}
        self.dir_cache = {}
        self.resolve_count = 0
        self.cache_hit_count = 0
        self.dir_list_call_count = 0

    fn print_resolve_stats():
        """Print resolution statistics if SIMPLE_PROFILE env var is set."""
        val profile_env = rt_env_get("SIMPLE_PROFILE")
        if profile_env.?:
            val hit_rate = if self.resolve_count > 0:
                (self.cache_hit_count * 100) / self.resolve_count
            else:
                0
            print "[resolve-stats] calls={self.resolve_count} cache_hits={self.cache_hit_count} hit_rate={hit_rate}% dir_list={self.dir_list_call_count}"

    # ------------------------------------------------------------------
    # Tier-ambiguity warning (stage 1, non-fatal)
    #
    # A tier-less `use std.<path>` whose <path> exists under 2+ of the 5
    # lib tiers (common, nogc_sync_mut, nogc_async_mut, gc_async_mut,
    # nogc_async_mut_noalloc) resolves by directory-listing order, so an
    # unrelated edit elsewhere can silently change which symbol an
    # importer gets. Stage 1 emits a default-on, NON-FATAL warning naming
    # the candidate tiers. Mirrors the file-vs-directory ambiguity error
    # below (which stays fatal); this one must NOT become fatal until the
    # ambiguous-import list is drained. See:
    # doc/08_tracking/bug/tierless_std_import_ambiguity_resolves_by_registration_order_2026-07-29.md
    #
    # Env knob SIMPLE_AMBIGUOUS_IMPORT_WARN:
    #   unset / other -> warn once per distinct ambiguous path (default)
    #   "0"           -> silence
    #   "verbose"     -> warn on every occurrence
    #
    # Perf: the tier-multiplicity map is built lazily ONCE per resolver
    # (first tier-less std resolution), never a per-import directory
    # scan. Each later occurrence costs two dict lookups.
    # ------------------------------------------------------------------

    fn tier_warn_mode() -> text:
        """Resolve SIMPLE_AMBIGUOUS_IMPORT_WARN to on|off|verbose (cached)."""
        if self.tier_warn_mode_cache != "":
            return self.tier_warn_mode_cache
        val env = rt_env_get("SIMPLE_AMBIGUOUS_IMPORT_WARN")
        var mode = "on"
        if env.?:
            val v = env ?? ""
            if v == "0":
                mode = "off"
            elif v == "verbose":
                mode = "verbose"
        self.tier_warn_mode_cache = mode
        mode

    fn record_tier_module(dotted: text, tier: text):
        """Record that module sub-path `dotted` exists under `tier`."""
        if self.tier_multiplicity.contains_key(dotted):
            var tiers = self.tier_multiplicity[dotted]
            var found = false
            for t in tiers:
                if t == tier:
                    found = true
            if not found:
                tiers.push(tier)
                self.tier_multiplicity[dotted] = tiers
        else:
            self.tier_multiplicity[dotted] = [tier]

    fn collect_tier_modules(dir: text, rel: text, tier: text):
        """Recursively record module sub-paths (.spl files and __init__.spl dirs)."""
        val entries = rt_dir_list(dir)
        for entry in entries:
            if entry == "" or entry.starts_with("."):
                continue
            val full = path_join(dir, entry)
            if rt_dir_exists(full):
                val child_rel = if rel == "": "{entry}" else: "{rel}.{entry}"
                if rt_file_exists(path_join(full, "__init__.spl")):
                    self.record_tier_module(child_rel, tier)
                self.collect_tier_modules(full, child_rel, tier)
            elif entry.ends_with(".spl"):
                val stem = entry.substring(0, entry.len() - 4)
                if stem != "" and stem != "__init__":
                    val dotted = if rel == "": "{stem}" else: "{rel}.{stem}"
                    self.record_tier_module(dotted, tier)

    fn build_tier_multiplicity(lib_dir: text):
        """One-time (per resolver) walk of the tier dirs AND the lib root.

        The five canonical tiers are not the only place a `std.<path>` can
        land: `_resolve_module_path_uncached` tries `src/lib/<path>` (step 3)
        BEFORE the tier search (step 4), so a root module directory such as
        `src/lib/js/` shadows its `common/` and `nogc_sync_mut/` namesakes
        deterministically and from every importer. Walking only the five
        tiers left that whole class unflagged. Root modules are recorded
        under the pseudo-tier `<lib-root>`.
        """
        val tier_names = ["common", "nogc_sync_mut", "nogc_async_mut", "gc_async_mut", "nogc_async_mut_noalloc"]
        for tier in tier_names:
            val tier_dir = path_join(lib_dir, tier)
            if rt_dir_exists(tier_dir):
                self.collect_tier_modules(tier_dir, "", tier)
        self.collect_lib_root_modules(lib_dir, tier_names)
        self.tier_map_built = true

    fn collect_lib_root_modules(lib_dir: text, tier_names: [text]):
        """Record modules that live directly under `src/lib/`, not in a tier."""
        val entries = rt_dir_list(lib_dir)
        for entry in entries:
            if entry == "" or entry.starts_with("."):
                continue
            var is_tier = false
            for t in tier_names:
                if t == entry:
                    is_tier = true
            if is_tier:
                continue
            val full = path_join(lib_dir, entry)
            if rt_dir_exists(full):
                if rt_file_exists(path_join(full, "__init__.spl")):
                    self.record_tier_module(entry, "<lib-root>")
                self.collect_tier_modules(full, entry, "<lib-root>")
            elif entry.ends_with(".spl"):
                val stem = entry.substring(0, entry.len() - 4)
                if stem != "" and stem != "__init__":
                    self.record_tier_module(stem, "<lib-root>")

    fn maybe_warn_tier_ambiguity(lib_dir: text, inner_segments: [text], from_file: text):
        """Warn when a tier-less std import path exists under 2+ lib tiers.

        Non-fatal by design (stage 1). Deduplicated to once per distinct
        ambiguous path per compilation unless SIMPLE_AMBIGUOUS_IMPORT_WARN
        is "verbose"; "0" silences entirely. Never alters resolution.
        """
        val mode = self.tier_warn_mode()
        if mode == "off":
            return
        if inner_segments.is_empty():
            return
        val dotted = inner_segments.join(".")
        if mode != "verbose" and self.tier_warned.contains_key(dotted):
            return
        if not self.tier_map_built:
            self.build_tier_multiplicity(lib_dir)
        if not self.tier_multiplicity.contains_key(dotted):
            return
        val tiers = self.tier_multiplicity[dotted]
        if tiers.len() < 2:
            return
        self.tier_warned[dotted] = true
        self.tier_warn_count = self.tier_warn_count + 1
        # stdout on purpose: stderr from native-built compiler binaries can
        # be dropped, and the resolver stats above already print to stdout.
        var how = "resolving by registration order"
        for t in tiers:
            if t == "<lib-root>":
                how = "the root src/lib/ module wins deterministically and shadows the tier module(s)"
        print "warning: ambiguous import: std.{dotted} exists in {tiers.join(', ')}; {how} - qualify as std.<tier>.{dotted} (importing file: {from_file}; SIMPLE_AMBIGUOUS_IMPORT_WARN=0 silences)"

    fn resolve_from_base(
        base: text,
        segments: [text],
        original_path: ModulePath
    ) -> ResolvedModule | CompileError:
        """Resolve from a base directory with remaining path segments.

        ROBUSTNESS:
        - Validates non-empty segments
        - Checks for __init__.spl in each directory
        - Tries multiple file extensions (.spl, .shs)
        - Returns detailed error messages
        """
        if segments.is_empty():
            return CompileError.semantic("empty module path segments: module path must contain at least one segment")

        debug("resolver", "Resolving from base={base} segments={segments}")
        var current = base.clone()

        # Navigate through all but the last segment
        for segment in segments[0..segments.len()-1]:
            val direct = path_join(current, segment)

            # Check direct path first
            if path_exists(direct):
                current = direct
                # Check for __init__.spl in each directory
                val init_path = path_join(current, "__init__.spl")
                if file_exists(init_path) and is_file(init_path):
                    # Directory module - continue navigation
                    pass
            else:
                # Try numbered directory fallback (NN.segment pattern)
                val numbered = find_numbered_dir(current, segment)
                if numbered.?:
                    current = numbered ?? current
                else:
                    # E1034 - Unresolved Import
                    return CompileError.semantic(
                        "cannot resolve import: module path segment `{segment}` not found; check that the module exists at {direct}"
                    ).with_note("ensure the module file or __init__.spl exists")

        # Resolve the last segment
        val last = segments[segments.len() - 1]

        val dir_path = path_join(current, last)
        val init_path = path_join(dir_path, "__init__.spl")
        val dir_exists = file_exists(init_path) and is_file(init_path)

        # Try .spl file
        val file_path = path_join(current, "{last}.spl")
        val file_exists_direct = file_exists(file_path) and is_file(file_path)

        # File and directory forms for the same module path are ambiguous.
        if dir_exists and file_exists_direct:
            return CompileError.semantic(
                "ambiguous import: module `{last}` resolves to both a file and a directory module; choose one of {file_path} or {init_path}"
            ).with_note("rename or remove one form so the module path is unambiguous")

        if dir_exists:
            return Ok(ResolvedModule.directory(
                init_path,
                original_path.clone(),
                nil  # Will be loaded on demand
            ))

        if file_exists_direct:
            return Ok(ResolvedModule.file(file_path, original_path.clone()))

        # Try .shs file (Simple shell scripts)
        val ssh_path = path_join(current, "{last}.shs")
        if file_exists(ssh_path) and is_file(ssh_path):
            return Ok(ResolvedModule.file(ssh_path, original_path.clone()))

        # Try numbered directory fallback for the last segment
        val numbered_dir = find_numbered_dir(current, last)
        if numbered_dir.?:
            val nd = numbered_dir ?? ""
            val nd_init = path_join(nd, "__init__.spl")
            if file_exists(nd_init) and is_file(nd_init):
                return Ok(ResolvedModule.directory(
                    nd_init,
                    original_path.clone(),
                    nil
                ))

        # Try numbered directory + .spl file fallback
        val numbered_parent = find_numbered_dir(current, last)
        if numbered_parent.? == false:
            # Also check if the last segment is a file inside a numbered dir
            # e.g., compiler.frontend.parser_types → 10.frontend/parser_types.spl
            pass

        # E1034 - Unresolved Import
        CompileError.semantic(
            "cannot resolve import: module `{last}` not found; create either {file_path} or {init_path}"
        ).with_note("check for typos in the import path")

    fn get_exports(resolved: ResolvedModule) -> [text] | CompileError:
        """Get all symbols exported by a module.

        Returns:
        - List of exported symbol names
        - Empty list if no manifest or non-directory module

        ROBUSTNESS:
        - Handles all ImportTarget variants (Single, Aliased, Group, Glob)
        - Returns public child modules
        - For non-directory modules, parses file and extracts export statements
        """
        if resolved.is_directory and resolved.has_manifest:
            val manifest = resolved.manifest
            var exports: [text] = []

            for child in manifest.child_modules:
                if child.visibility == Visibility.Public:
                    exports.push(child.name)

            Ok(exports)
        else:
            # Non-directory module - parse file and extract export statements
            self.extract_file_exports(resolved.path)

    fn extract_file_exports(file_path: text) -> [text] | CompileError:
        """Extract exported symbols from a non-directory module (.spl file).

        Parses the file and extracts all symbols listed in export statements.

        Arguments:
        - file_path: Path to the .spl file

        Returns:
        - List of exported symbol names
        - CompileError if file cannot be read or parsed

        ROBUSTNESS:
        - Reads and parses the source file
        - Extracts all export declarations
        - Returns empty list if no exports found
        """
        # Read the file
        val source = match file_read_opt(file_path):
            Some(content): content
            nil:
                return CompileError.io(
                    "cannot extract exports: failed to read file {file_path}"
                ).with_note("ensure the file exists and is readable")

        var exports: [text] = []
        for line in source.split("\n"):
            val trimmed = line.trim()
            if trimmed.starts_with("export "):
                val rest = trimmed.substring(7, trimmed.len())
                for part in rest.split(","):
                    val name = part.trim().split(" ")[0].trim()
                    if name != "":
                        exports.push(name)
            elif trimmed.starts_with("fn "):
                val name = trimmed.substring(3, trimmed.len()).split("(")[0].trim()
                if name != "":
                    exports.push(name)
            elif trimmed.starts_with("struct "):
                val name = trimmed.substring(7, trimmed.len()).split(":")[0].split("<")[0].trim()
                if name != "":
                    exports.push(name)
            elif trimmed.starts_with("class "):
                val name = trimmed.substring(6, trimmed.len()).split(":")[0].split("<")[0].trim()
                if name != "":
                    exports.push(name)
            elif trimmed.starts_with("enum "):
                val name = trimmed.substring(5, trimmed.len()).split(":")[0].split("<")[0].trim()
                if name != "":
                    exports.push(name)
            elif trimmed.starts_with("trait "):
                val name = trimmed.substring(6, trimmed.len()).split(":")[0].split("<")[0].trim()
                if name != "":
                    exports.push(name)
        Ok(exports)

    fn get_common_uses(file_path: text) -> [CommonUseStmt]:
        """Get common use imports that apply to a file.

        Walks up the directory tree collecting common uses from __init__.spl files.

        ROBUSTNESS:
        - Walks up to source_root
        - Collects from all parent directories
        - Returns empty list if no manifests found
        """
        var uses: [CommonUseStmt] = []

        # Walk up the directory tree collecting common uses
        var current = Some(path_parent(file_path))
        while val Some(dir) = current:
            val init_path = path_join(dir, "__init__.spl")
            # NOTE: `Dict.get()` returns the raw value or nil, NOT a
            # Some(..)-tagged Option -- `if val Some(x) = d.get(k):` silently
            # never matches (documented interpreter landmine, see
            # std.nogc_sync_mut.diag.spl's header comment).
            # Under native codegen `.get()` on a HIT also returns a corrupt
            # payload (field reads segfault); use contains_key + indexed read.
            # See doc/07_guide/language/dict_native_pitfalls.md
            if self.manifests.contains_key(init_path):
                val manifest = self.manifests[init_path]
                uses.extend(manifest.common_uses.clone())

            if dir == self.source_root:
                break

            current = Some(path_parent(dir))

        uses

# ============================================================================
# Helper Functions (SFFI Wrappers)
# ============================================================================

extern fn rt_path_join(a: text, b: text) -> text
extern fn rt_path_parent(path: text) -> text
extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_read_text(path: text) -> text
extern fn rt_dir_exists(path: text) -> bool

fn path_join(base: text, segment: text) -> text:
    """Join two path segments."""
    rt_path_join(base, segment)

fn path_parent(path: text) -> text:
    """Get parent directory of a path."""
    rt_path_parent(path)

fn path_exists(path: text) -> bool:
    """Check if a path exists."""
    rt_file_exists(path) or rt_dir_exists(path)

fn is_file(path: text) -> bool:
    """Check if a path is a file (not directory)."""
    rt_file_exists(path) and not rt_dir_exists(path)

fn file_exists(path: text) -> bool:
    rt_file_exists(path)

# Optional-returning read. Named apart from the canonical `file_read`
# (`-> text`) on purpose: the function registry is keyed on NAME ALONE, so a
# same-named `-> text?` here can be dispatched to a caller expecting `-> text`
# depending on the import closure. See
# doc/08_tracking/bug/file_read_has_23_definitions_with_two_return_types_2026-08-16.md
fn file_read_opt(path: text) -> text?:
    if not rt_file_exists(path):
        return nil
    Some(rt_file_read_text(path) ?? "")

extern fn rt_dir_list(path: text) -> [text]
extern fn rt_env_get(key: text) -> text

# Module-level directory listing cache for free functions
var _dir_listing_cache: {text: [text]} = {}

# ===== Tier Precedence for tier-less `use std.X` =====
# Canonical, least-capability-first order. `common` is pure and cannot pull a
# runtime family in, so it must be tried first; the remaining tiers follow in
# increasing capability. Anything not a canonical tier keeps its listing order
# but sorts AFTER every canonical tier, so an unrelated directory dropped into
# src/lib/ can never pre-empt a real tier.
val TIER_PRECEDENCE: [text] = [
    "common",
    "nogc_async_mut_noalloc",
    "nogc_sync_mut",
    "nogc_async_mut",
    "gc_async_mut",
]

fn tier_ordered_subdirs(subdirs: [text]) -> [text]:
    """Reorder a src/lib listing into fixed tier precedence.

    Pure and total: every input entry appears exactly once in the output, so
    this only reorders the search, never narrows it.
    """
    var ordered: [text] = []
    for tier in TIER_PRECEDENCE:
        for subdir in subdirs:
            if subdir == tier:
                ordered.push(subdir)
    for subdir in subdirs:
        var is_canonical = false
        for tier in TIER_PRECEDENCE:
            if subdir == tier:
                is_canonical = true
        if not is_canonical:
            ordered.push(subdir)
    ordered

fn cached_dir_list_global(dir_path: text) -> [text]:
    """Module-level cached dir listing for free functions."""
    if _dir_listing_cache.has(dir_path):
        return _dir_listing_cache[dir_path]
    val entries = rt_dir_list(dir_path)
    _dir_listing_cache[dir_path] = entries
    entries

fn find_numbered_dir(parent: text, segment: text) -> text?:
    """Find a numbered directory matching a segment name.

    Scans the parent directory for entries matching the pattern NN.name
    where NN is a 1-3 digit numeric prefix and name matches the segment.
    Returns the full path if found, nil otherwise.
    Uses cached directory listings to avoid repeated rt_dir_list calls.
    """
    if not rt_dir_exists(parent):
        return nil

    val entries = cached_dir_list_global(parent)
    for entry in entries:
        val dot_idx = entry.index_of(".")
        if dot_idx.?:
            val idx = dot_idx ?? 0
            if idx >= 1 and idx <= 3:
                val prefix = entry.substring(0, idx)
                # Verify prefix is all digits
                var all_digits = true
                for ch in prefix:
                    if ch < "0" or ch > "9":
                        all_digits = false
                if all_digits:
                    val name = entry.substring(idx + 1)
                    if name == segment:
                        val full_path = path_join(parent, entry)
                        if rt_dir_exists(full_path):
                            return Some(full_path)
    nil

# ============================================================================
# Usage Examples
# ============================================================================
#
# # Create a resolver
# val resolver = ModuleResolver.new("/home/user/myproject", "/home/user/myproject/src")
#
# # Resolve an absolute path
# val result = resolver.resolve(
#     ModulePath(segments: ["crate", "sys", "http"]),
#     "/home/user/myproject/src/main.spl"
# )
#
# match result:
#     Ok(resolved):
#         print "Resolved to: {resolved.path}"
#         print "Is directory: {resolved.is_directory}"
#
#     Err(error):
#         print "Error: {error.message}"
#
# # Resolve a relative path
# val result = resolver.resolve(
#     ModulePath(segments: ["utils", "strings"]),
#     "/home/user/myproject/src/main.spl"
# )
#
# # Get exports from a module
# if val Ok(resolved) = result:
#     if val Ok(exports) = resolver.get_exports(resolved):
#         print "Exports: {exports.join(', ')}"
#
# # Get common uses for a file
# val common_uses = resolver.get_common_uses("/home/user/myproject/src/sys/http.spl")
# print "Common uses: {common_uses.len()}"
#
# ============================================================================
# Resolution Algorithm
# ============================================================================
#
# 1. Parse module path into segments
#    Example: crate.sys.http -> ["crate", "sys", "http"]
#
# 2. Determine base directory:
#    - If starts with "crate": use source_root
#    - Otherwise: use parent directory of from_file
#
# 3. Navigate through all but last segment:
#    - Join segment to current path
#    - Check for __init__.spl (directory module)
#    - If directory doesn't exist, return error
#
# 4. Resolve last segment (try in order):
#    a. Directory with __init__.spl
#    b. .spl file
#    c. .shs file
#    d. Error if none found
#
# 5. If relative resolution fails:
#    - Try stdlib (if available)
#    - Strip "std_lib" prefix if present
#    - Resolve from stdlib_root
#
# 6. Return ResolvedModule with:
#    - Filesystem path
#    - Original module path
#    - Is directory flag
#    - Manifest (loaded on demand)
#
# ============================================================================
# Error Codes
# ============================================================================
#
# E1034 - Unresolved Import
#   - Module path segment not found
#   - Module file not found
#   - Includes filesystem path in error message
#
# MODULE_NOT_FOUND
#   - Empty module path
#   - No segments provided
#
# ============================================================================
# Performance Notes
# ============================================================================
#
# - resolve: O(n) where n = number of segments (filesystem lookups)
# - resolve_from_base: O(n) directory navigation + O(1) file checks
# - get_exports: O(m) where m = number of exports
# - get_common_uses: O(d) where d = directory depth
#
# Expected performance: Same as Rust (I/O bound, not CPU bound)
#
# Filesystem operations are the bottleneck:
# - file_exists: ~0.1-1ms per call (OS cache helps)
# - Multiple extension checks: ~0.3-3ms total
#
# ============================================================================
# Robustness Checklist
# ============================================================================
#
# Input Validation:
# - [x] Non-empty path segments
# - [x] Non-empty module path
# - [x] Valid filesystem paths
#
# Error Handling:
# - [x] Directory not found (E1034)
# - [x] Module not found (E1034)
# - [x] Empty path (MODULE_NOT_FOUND)
# - [x] Detailed error messages with filesystem paths
#
# Resolution Logic:
# - [x] Absolute paths (crate.*)
# - [x] Relative paths (from current file)
# - [x] Stdlib fallback
# - [x] Multiple file extensions (.spl, .shs)
# - [x] Directory modules (__init__.spl)
#
# Export Extraction:
# - [x] Single exports
# - [x] Aliased exports
# - [x] Group exports
# - [x] Glob exports (placeholder)
# - [x] Public child modules
#
# Edge Cases:
# - [x] Empty exports (returns empty list)
# - [x] Non-directory module (returns empty exports)
# - [x] No common uses (returns empty list)
# - [x] Stdlib not found (fallback fails gracefully)
#
# Remaining work:
# - [x] Implement proper file I/O SFFI (path_exists, is_file, is_directory)
# - [ ] Add glob export resolution (requires parsing target module)
# - [ ] Add import graph tracking (cycle detection)
# - [ ] Add manifest caching in resolve_from_base
#
