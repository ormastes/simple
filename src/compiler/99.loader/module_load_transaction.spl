# Read-only admission and relocation planning for the live ModuleLoader.
#
# The current relocation wire entry is:
#   offset | symbol_index | reloc_type | addend
# It has no target-section field. The canonical live producer
# `compiler.driver.smf_writer.build_smf_with_relocations` emits `.rela.text`
# beside exactly one Code section, so its offsets are unambiguously relative
# to that section. A relocation-bearing artifact with more than one mapped
# executable section is rejected here before mmap until a versioned wire
# schema carries explicit target-section ownership.

use compiler.backend.linker.smf_reader_memory.{
    SmfReaderMemory, bytes_to_u32
}
use compiler.backend.linker.obj_taker.{SmfSymbol, SymbolBinding, SymbolType}
use compiler.loader.segment_mapper.{SEGMENT_MAX_ALIGNMENT}
use compiler.loader.smf_segment_load.{smf_section_extent, smf_section_bytes}

val SMF_CODE_SECTION: i32 = 1
val SMF_SECTION_EXEC: i64 = 0x04
val SMF_RELOC_SECTION: i32 = 5
val SMF_SECTION_ENTRY_SIZE_TXN: i64 = 64
val SMF_RELOC_ENTRY_SIZE_TXN: i64 = 24
val SMF_SYMBOL_ENTRY_SIZE_TXN: i64 = 56
val I64_MAX_TXN: i64 = 0x7FFFFFFFFFFFFFFF
val I64_MIN_TXN: i64 = -9223372036854775807 - 1
val I32_MAX_TXN: i64 = 0x7FFFFFFF
val I32_MIN_TXN: i64 = -2147483647 - 1
val U32_MAX_TXN: i64 = 0xFFFFFFFF

struct ModuleSegmentCandidate:
    section_index: i32
    payload: [u8]
    alignment: i64

struct ModuleRelocationCandidate:
    target_section_index: i32
    offset: i64
    target_symbol: text
    reloc_type: i32
    addend: i64

struct ModuleLoadCandidate:
    exported_symbols: [SmfSymbol]
    segments: [ModuleSegmentCandidate]
    relocations: [ModuleRelocationCandidate]

struct ModuleRelocationPatch:
    target_section_index: i32
    offset: i64
    write_width: i64
    value: i64

fn _txn_text_in(names: [text], name: text) -> bool:
    for candidate in names:
        if candidate == name:
            return true
    false

fn _txn_section_in(sections: [i32], section_index: i32) -> bool:
    for candidate in sections:
        if candidate == section_index:
            return true
    false

# SmfWriter stores the section index in reserved bytes 41..42 of each symbol
# entry. The compatibility reader still derives it from the symbol type, which
# is only correct for the historical Code-0/Data-1 layout. Decode the existing
# wire ownership here so this live transaction binds multi-Code symbols to the
# section that actually owns them. A zero encoding retains the reader-derived
# value for legacy files that predate the reserved-byte convention.
fn _symbols_with_wire_sections(reader: SmfReaderMemory, parsed: [SmfSymbol]) -> Result<[SmfSymbol], text>:
    val table_offset = reader.header.symbol_table_offset
    val symbol_count = reader.header.symbol_count as i64
    if table_offset < 0 or table_offset > reader.data.len():
        return Err("SMF symbol table offset escapes file image")
    if symbol_count > (reader.data.len() - table_offset) / SMF_SYMBOL_ENTRY_SIZE_TXN:
        return Err("SMF symbol table escapes file image")
    if parsed.len() != symbol_count:
        return Err("SMF ordered symbol count does not match its header")

    var decoded: [SmfSymbol] = []
    var i = 0i64
    while i < symbol_count:
        val symbol = parsed[i]
        val entry_offset = table_offset + i * SMF_SYMBOL_ENTRY_SIZE_TXN
        val encoded_section = (reader.data[entry_offset + 41] as i32) |
            ((reader.data[entry_offset + 42] as i32) << 8)
        val section_index = if encoded_section == 0:
            symbol.section_index
        else:
            encoded_section
        decoded.push(SmfSymbol(
            name: symbol.name,
            section_index: section_index,
            offset: symbol.offset,
            size: symbol.size,
            ty: symbol.ty,
            binding: symbol.binding,
            is_generic_template: symbol.is_generic_template,
            template_param_count: symbol.template_param_count,
            template_offset: symbol.template_offset))
        i = i + 1
    Ok(decoded)

fn module_relocation_write_width(reloc_type: i32) -> Result<i64, text>:
    match reloc_type:
        1: Ok(8)
        2: Ok(4)
        3: Ok(4)
        4: Ok(4)
        5: Ok(4)
        _: Err("Unknown relocation type: {reloc_type}")

fn _checked_i64_add(left: i64, right: i64) -> Result<i64, text>:
    if right > 0 and left > I64_MAX_TXN - right:
        return Err("signed 64-bit addition overflow")
    if right < 0 and left < I64_MIN_TXN - right:
        return Err("signed 64-bit addition underflow")
    Ok(left + right)

fn _checked_i64_sub(left: i64, right: i64) -> Result<i64, text>:
    if right > 0 and left < I64_MIN_TXN + right:
        return Err("signed 64-bit subtraction underflow")
    if right < 0 and left > I64_MAX_TXN + right:
        return Err("signed 64-bit subtraction overflow")
    Ok(left - right)

fn module_relocation_patch(
        relocation: ModuleRelocationCandidate,
        target_address: i64,
        section_base: i64) -> Result<ModuleRelocationPatch, text>:
    if target_address <= 0 or section_base <= 0:
        return Err("relocation uses a non-positive mapped address")
    val place_address = _checked_i64_add(section_base, relocation.offset)?
    val width = module_relocation_write_width(relocation.reloc_type)?
    var value = 0i64
    match relocation.reloc_type:
        1:
            value = _checked_i64_add(target_address, relocation.addend)?
        2:
            val delta = _checked_i64_sub(target_address, place_address)?
            value = _checked_i64_add(delta, relocation.addend)?
            if value < I32_MIN_TXN or value > I32_MAX_TXN:
                return Err("relative relocation value {value} does not fit i32")
        3:
            val delta = _checked_i64_sub(target_address, place_address)?
            value = _checked_i64_add(delta, relocation.addend)?
            if value < I32_MIN_TXN or value > I32_MAX_TXN:
                return Err("PLT relocation value {value} does not fit i32")
        4:
            val delta = _checked_i64_sub(target_address, place_address)?
            value = _checked_i64_add(delta, relocation.addend)?
            if value < I32_MIN_TXN or value > I32_MAX_TXN:
                return Err("GOT relocation value {value} does not fit i32")
        5:
            value = _checked_i64_add(target_address, relocation.addend)?
            if value < I32_MIN_TXN or value > U32_MAX_TXN:
                return Err("absolute relocation value {value} does not fit 32 bits")
        _:
            return Err("Unknown relocation type: {relocation.reloc_type}")
    Ok(ModuleRelocationPatch(
        target_section_index: relocation.target_section_index,
        offset: relocation.offset,
        write_width: width,
        value: value))

fn _validate_relocation_section_shape(reader: SmfReaderMemory) -> Result<(), text>:
    var found = 0i64
    var i = 0i64
    val section_count = reader.header.section_count as i64
    if section_count < 0:
        return Err("SMF section count is negative")
    if reader.sections_offset < 0 or reader.sections_offset > reader.data.len():
        return Err("SMF section table offset escapes file image")
    if section_count > (reader.data.len() - reader.sections_offset) / SMF_SECTION_ENTRY_SIZE_TXN:
        return Err("SMF section table escapes file image")
    while i < section_count:
        val entry_offset = reader.sections_offset + i * SMF_SECTION_ENTRY_SIZE_TXN
        if reader.data[entry_offset] as i32 == SMF_RELOC_SECTION:
            found = found + 1
            val extent = smf_section_extent(reader, i as i32)?
            val size = extent.size
            if size < 0 or size % SMF_RELOC_ENTRY_SIZE_TXN != 0:
                return Err("Reloc section size {size} is not a whole number of entries")
        i = i + 1
    if found > 1:
        return Err("SMF has duplicate relocation sections")
    Ok(())

fn _executable_code_sections(reader: SmfReaderMemory) -> [i32]:
    var sections: [i32] = []
    var i = 0i64
    while i < reader.header.section_count as i64:
        val entry_offset = reader.sections_offset + i * SMF_SECTION_ENTRY_SIZE_TXN
        val section_type = reader.data[entry_offset] as i32
        val flags = bytes_to_u32(reader.data, entry_offset + 4) as i64
        if section_type == SMF_CODE_SECTION and (flags & SMF_SECTION_EXEC) != 0:
            sections.push(i as i32)
        i = i + 1
    sections

fn module_load_prevalidate(reader: SmfReaderMemory, available_globals: [text]) -> Result<ModuleLoadCandidate, text>:
    _validate_relocation_section_shape(reader)?
    val parsed_symbols = reader.symbols_in_table_order()?
    val ordered_symbols = _symbols_with_wire_sections(reader, parsed_symbols)?
    var exported_symbols: [SmfSymbol] = []
    for symbol in ordered_symbols:
        if symbol.binding == SymbolBinding.Global or symbol.binding == SymbolBinding.Weak:
            exported_symbols.push(symbol)
    if exported_symbols.len() == 0:
        for symbol in ordered_symbols:
            if symbol.name != "":
                exported_symbols.push(symbol)
    val parsed_relocations = reader.read_relocations()?

    var exported_names: [text] = []
    var section_indices: [i32] = []
    for symbol in exported_symbols:
        if symbol.name == "":
            return Err("exported symbol has an empty name")
        if _txn_text_in(exported_names, symbol.name):
            return Err("duplicate exported symbol: {symbol.name}")
        if _txn_text_in(available_globals, symbol.name):
            return Err("exported symbol collides with an existing global: {symbol.name}")
        exported_names.push(symbol.name)
        if symbol.ty != SymbolType.Function:
            return Err("exported non-function symbol {symbol.name} requires a non-executable segment mapper")
        if not _txn_section_in(section_indices, symbol.section_index):
            section_indices.push(symbol.section_index)

    var segments: [ModuleSegmentCandidate] = []
    for section_index in section_indices:
        val extent = smf_section_extent(reader, section_index)?
        if extent.section_type != SMF_CODE_SECTION or (extent.flags & SMF_SECTION_EXEC) == 0:
            return Err("exported code section {section_index} is not an executable Code section")
        if extent.size <= 0:
            return Err("executable Code section {section_index} is empty")
        if extent.alignment <= 0 or extent.alignment > SEGMENT_MAX_ALIGNMENT:
            return Err("executable Code section {section_index} alignment {extent.alignment} is unsupported")
        val payload = smf_section_bytes(reader, extent)?
        segments.push(ModuleSegmentCandidate(
            section_index: section_index,
            payload: payload,
            alignment: extent.alignment))

    for symbol in exported_symbols:
        var segment_size = -1i64
        for segment in segments:
            if segment.section_index == symbol.section_index:
                segment_size = segment.payload.len() as i64
        if segment_size < 0:
            return Err("exported symbol {symbol.name} has no executable owner section")
        if symbol.offset < 0 or symbol.size < 0:
            return Err("exported symbol {symbol.name} has a negative section range")
        if symbol.size > segment_size or symbol.offset > segment_size - symbol.size:
            return Err("exported symbol {symbol.name} escapes executable section {symbol.section_index}")

    if parsed_relocations.len() > 0:
        val executable_sections = _executable_code_sections(reader)
        if segments.len() != 1 or executable_sections.len() != 1 or segments[0].section_index != executable_sections[0]:
            return Err("relocation target section is ambiguous: current SMF wire requires exactly one executable Code section")

    var relocations: [ModuleRelocationCandidate] = []
    for relocation in parsed_relocations:
        val width = module_relocation_write_width(relocation.reloc_type)?
        val segment = segments[0]
        val segment_size = segment.payload.len() as i64
        if relocation.offset < 0 or width > segment_size:
            return Err("Relocation offset {relocation.offset} with width {width} escapes executable section {segment.section_index}")
        if relocation.offset > segment_size - width:
            return Err("Relocation offset {relocation.offset} with width {width} escapes executable section {segment.section_index}")
        if relocation.symbol_index < 0 or relocation.symbol_index >= ordered_symbols.len():
            return Err("Relocation symbol index {relocation.symbol_index} is out of range")
        val target_name = ordered_symbols[relocation.symbol_index].name
        if target_name == "" or (not _txn_text_in(exported_names, target_name) and not _txn_text_in(available_globals, target_name)):
            return Err("Unresolved relocation symbol at index {relocation.symbol_index}")
        relocations.push(ModuleRelocationCandidate(
            target_section_index: segment.section_index,
            offset: relocation.offset,
            target_symbol: target_name,
            reloc_type: relocation.reloc_type,
            addend: relocation.addend))

    Ok(ModuleLoadCandidate(
        exported_symbols: exported_symbols,
        segments: segments,
        relocations: relocations))
