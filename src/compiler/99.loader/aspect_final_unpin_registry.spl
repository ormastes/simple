# Loader-owned bridge between an aspect-pack final-unpin reservation and an
# independently owned mapper release port. This is intentionally a contract
# and registry, not an executable-memory provider: lower aspect-pack code
# cannot call back upward, and this module never receives raw addresses.

use std.common.aspect_pack.{
    ApkFinalUnpinStageV2, APK_FINAL_UNPIN_STAGE_READY_V2,
    apk_facet_final_unpin_stage_v2, apk_facet_final_unpin_commit_v2,
    apk_facet_final_unpin_rollback_v2
}

val ASPECT_FINAL_UNPIN_MAX_BINDINGS_V1: i64 = 1024
val ASPECT_FINAL_UNPIN_MAX_TOMBSTONES_V1: i64 = 1024

struct AspectMapperBindingReceiptV1:
    """Pointer-free facts issued by the exact mapper owner at mapping time."""
    loader_id: i64
    facet_key: text
    facet_generation: i64
    mapper_owner_id: text
    mapping_id: text
    mapping_generation: i64
    release_port_id: text

struct AspectOwnerReleaseRequestV1:
    """A request the named mapper owner may consume through its own port."""
    ok: bool
    error_code: text
    error_message: text
    stage: ApkFinalUnpinStageV2
    release_port_id: text

struct AspectFinalUnpinRegistryV1:
    """Bounded mutable root owned by one loader lifecycle owner.

    `bindings` contains no raw pointers or callable closures. Mapper owners
    retain their own release capabilities; this registry only authenticates a
    receipt and records deterministic commit/rollback state.
    """
    owner_id: text
    bindings: Dict<text, AspectMapperBindingReceiptV1>
    staged: Dict<text, ApkFinalUnpinStageV2>
    tombstones: Dict<text, bool>
    tombstone_order: [text]
    tombstone_head: i64
    commits: i64
    rollbacks: i64

fn _aspect_final_unpin_key_v1(loader_id: i64, facet_key: text,
        facet_generation: i64) -> text:
    "{loader_id}\0{facet_key}\0{facet_generation}"

fn _aspect_final_unpin_empty_request_v1(code: text, message: text) -> AspectOwnerReleaseRequestV1:
    AspectOwnerReleaseRequestV1(ok: false, error_code: code,
        error_message: message,
        stage: ApkFinalUnpinStageV2(ok: false, stage_state: 0,
            error_code: code, error_message: message, loader_id: -1,
            facet_key: "", facet_generation: 0, stage_id: 0,
            mapper_owner_id: "", mapping_id: "", mapping_generation: 0),
        release_port_id: "")

fn aspect_final_unpin_registry_new_v1(owner_id: text) -> AspectFinalUnpinRegistryV1:
    AspectFinalUnpinRegistryV1(owner_id: owner_id, bindings: {}, staged: {},
        tombstones: {}, tombstone_order: [], tombstone_head: 0,
        commits: 0, rollbacks: 0)

fn _aspect_final_unpin_exact_binding_v1(left: AspectMapperBindingReceiptV1,
        right: AspectMapperBindingReceiptV1) -> bool:
    left.loader_id == right.loader_id and left.facet_key == right.facet_key and
        left.facet_generation == right.facet_generation and
        left.mapper_owner_id == right.mapper_owner_id and
        left.mapping_id == right.mapping_id and
        left.mapping_generation == right.mapping_generation and
        left.release_port_id == right.release_port_id

impl AspectFinalUnpinRegistryV1:
    me register_binding_v1(caller_owner_id: text,
            receipt: AspectMapperBindingReceiptV1) -> bool:
        """Admit one exact mapper receipt before its aspect can quiesce."""
        if caller_owner_id != self.owner_id or receipt.loader_id < 0 or
                receipt.facet_key == "" or receipt.facet_generation <= 0 or
                receipt.mapper_owner_id == "" or receipt.mapping_id == "" or
                receipt.mapping_generation <= 0 or receipt.release_port_id == "":
            return false
        val key = _aspect_final_unpin_key_v1(receipt.loader_id, receipt.facet_key,
            receipt.facet_generation)
        if self.bindings.has(key):
            return _aspect_final_unpin_exact_binding_v1(self.bindings[key], receipt)
        if self.bindings.keys().len() >= ASPECT_FINAL_UNPIN_MAX_BINDINGS_V1:
            return false
        self.bindings[key] = receipt
        true

    me stage_final_unpin_v2(caller_owner_id: text, loader_id: i64,
            facet_key: text, facet_generation: i64) -> AspectOwnerReleaseRequestV1:
        """Reserve one final pin only when the registered mapper identity matches."""
        if caller_owner_id != self.owner_id:
            return _aspect_final_unpin_empty_request_v1("APK_RELEASE_OWNER_MISMATCH",
                "only the loader owner may stage final unpin")
        val key = _aspect_final_unpin_key_v1(loader_id, facet_key, facet_generation)
        if not self.bindings.has(key):
            return _aspect_final_unpin_empty_request_v1("APK_RELEASE_RECEIPT_MISSING",
                "no exact mapper receipt is registered for this aspect binding")
        if self.staged.has(key):
            return _aspect_final_unpin_empty_request_v1("APK_RELEASE_ALREADY_STAGED",
                "this aspect binding already has an in-flight release")
        val binding = self.bindings[key]
        val stage = apk_facet_final_unpin_stage_v2(loader_id, facet_key,
            facet_generation, binding.mapper_owner_id, binding.mapping_id,
            binding.mapping_generation)
        if not stage.ok or stage.stage_state != APK_FINAL_UNPIN_STAGE_READY_V2:
            return AspectOwnerReleaseRequestV1(ok: false, error_code: stage.error_code,
                error_message: stage.error_message, stage: stage,
                release_port_id: "")
        self.staged[key] = stage
        AspectOwnerReleaseRequestV1(ok: true, error_code: "", error_message: "",
            stage: stage, release_port_id: binding.release_port_id)

    me complete_owner_release_v1(caller_owner_id: text,
            request: AspectOwnerReleaseRequestV1, mapper_owner_id: text,
            release_port_id: text, mapper_release_succeeded: bool) -> bool:
        """Deterministically commit or roll back a previously staged request.

        The mapper owner invokes its own release port outside this module and
        supplies only its outcome. A mismatched owner, port, stage, or binding
        cannot cause either byte retirement or a future mapper release.
        """
        if caller_owner_id != self.owner_id or not request.ok or
                request.stage.stage_state != APK_FINAL_UNPIN_STAGE_READY_V2:
            return false
        val key = _aspect_final_unpin_key_v1(request.stage.loader_id,
            request.stage.facet_key, request.stage.facet_generation)
        if not self.bindings.has(key) or not self.staged.has(key):
            return false
        val binding = self.bindings[key]
        val stage = self.staged[key]
        if stage.stage_id != request.stage.stage_id or
                mapper_owner_id != binding.mapper_owner_id or
                release_port_id != binding.release_port_id or
                request.release_port_id != binding.release_port_id or
                stage.mapping_id != binding.mapping_id or
                stage.mapping_generation != binding.mapping_generation:
            return false
        self.staged = self.staged.remove(key)
        if not mapper_release_succeeded:
            if not apk_facet_final_unpin_rollback_v2(stage):
                return false
            self.rollbacks = self.rollbacks + 1
            return true
        if not apk_facet_final_unpin_commit_v2(stage):
            # A commit refusal leaves the lower state reserved. Restore it so
            # a later owner transaction can make a deterministic decision.
            self.staged[key] = stage
            return false
        self.bindings = self.bindings.remove(key)
        self._record_tombstone_v1(key)
        self.commits = self.commits + 1
        true

    me _record_tombstone_v1(key: text):
        if self.tombstones.has(key):
            return
        if self.tombstone_order.len() < ASPECT_FINAL_UNPIN_MAX_TOMBSTONES_V1:
            self.tombstone_order.push(key)
        else:
            val evicted = self.tombstone_order[self.tombstone_head]
            self.tombstones = self.tombstones.remove(evicted)
            self.tombstone_order[self.tombstone_head] = key
            self.tombstone_head = (self.tombstone_head + 1) %
                ASPECT_FINAL_UNPIN_MAX_TOMBSTONES_V1
        self.tombstones[key] = true

    fn binding_count_v1() -> i64:
        self.bindings.keys().len() as i64

    fn tombstone_count_v1() -> i64:
        self.tombstones.keys().len() as i64
