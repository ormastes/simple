# Loader-private exact ABI wrapper. Raw callable/source addresses must remain
# inside loader ownership and never enter parser/provider public records.
extern fn rt_parser_lexical_mask_call_u8x32(function_address: i64,
    source_address: i64, needle: i64) -> i64

fn parser_lexical_mask_call_native_v1(function_address: i64,
    source_address: i64, needle: u8) -> Result<u32, text>:
    val value = rt_parser_lexical_mask_call_u8x32(function_address, source_address, needle as i64)
    if value < 0: Err("parser_lexical_mask_native_call_failed")
    else: Ok((value as u64 & 0xffffffffu64) as u32)
