# Higher-layer binding adapter for the frontend-owned advisory function port.
# Loader authority remains private here; layer 10 sees only its stable result.
use compiler.frontend.frontend_advisory_preprocess_port_v1.*
use compiler.loader.frontend_lexical_advisory_adapter_v1.*
use compiler.driver.environment_variant_sealed_activation_owner_v1.*
use compiler.loader.parser_structural_package_owner_v1.*
use std.nogc_sync_mut.composition.environment_variants.contracts_v1.EnvironmentSnapshotV1
use std.nogc_async_mut.structural.parse.lexical_block_summary_v1.LexicalBlockStateV1

class FrontendLexicalAdvisoryBindingContextV1:
    sealed_owner: EnvironmentVariantSealedActivationOwnerV1
    activation: EnvironmentVariantSealedActivationOwnerTokenV1
    package_owner: ParserStructuralPackageOwnerV1
    session: ParserStructuralPackageV2SessionV1
    snapshot: EnvironmentSnapshotV1
    feature_words: [u64]
    input_state: LexicalBlockStateV1

var _frontend_lexical_binding_context_v1: FrontendLexicalAdvisoryBindingContextV1? = nil

fn _frontend_lexical_bound_provider_v1(source: text,
    policy: FrontendAdvisoryPreprocessPolicyV1
) -> FrontendAdvisoryPreprocessResultV1:
    val context = match _frontend_lexical_binding_context_v1:
        case Some(value): value
        case nil: return frontend_advisory_preprocess_reference_v1(source, policy)
    val executed = frontend_lexical_advisory_adapter_run_v1(source, policy,
        context.sealed_owner, context.activation, context.package_owner, context.session,
        context.snapshot, context.feature_words, context.input_state)
    if executed.is_err(): return frontend_advisory_preprocess_reference_v1(source, policy)
    val rich = executed.unwrap()
    if not frontend_lexical_advisory_adapter_result_valid_v1(rich):
        return frontend_advisory_preprocess_reference_v1(source, policy)
    val status = if rich.receipt.status == FrontendLexicalAdvisoryAdapterStatusV1.ReferenceNoOp:
        FrontendAdvisoryPreprocessStatusV1.ReferenceNoOp
    elif rich.receipt.status == FrontendLexicalAdvisoryAdapterStatusV1.SimdExecuted:
        FrontendAdvisoryPreprocessStatusV1.AdvisoryExecuted
    else:
        FrontendAdvisoryPreprocessStatusV1.ScalarFallback
    val projected = frontend_advisory_preprocess_result_issue_v1(rich.parse_source, policy,
        status, rich.receipt.admitted_simd, rich.receipt.executed_simd)
    if projected.is_err(): return frontend_advisory_preprocess_reference_v1(source, policy)
    projected.unwrap()

pub fn frontend_lexical_advisory_binding_install_v1(
    context: FrontendLexicalAdvisoryBindingContextV1, generation: u64
) -> bool:
    if not frontend_advisory_preprocess_bind_v1(_frontend_lexical_bound_provider_v1, generation):
        return false
    _frontend_lexical_binding_context_v1 = Some(context)
    true

pub fn frontend_lexical_advisory_binding_remove_v1(generation: u64) -> bool:
    if not frontend_advisory_preprocess_reset_v1(generation): return false
    _frontend_lexical_binding_context_v1 = nil
    true
