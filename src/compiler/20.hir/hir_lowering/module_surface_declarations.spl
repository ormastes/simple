# Parser declarations retained in module surfaces.

use compiler.common.driver_core_types.{SourceFile}
use compiler.frontend.parser_types.*
# Class B (stage-1 run13): this module reaches parser_types_expr through a
# TWO-HOP GLOB -- `use compiler.frontend.parser_types.*` here, and
# parser_types.spl:11 `use compiler.frontend.parser_types_expr.*` there. Neither
# hop is an `export use`, so a plain glob does NOT transit: names declared in
# parser_types_expr are invisible here and died as `unresolved name: parser_type_kind_named_name, parser_type_kind_array_element_name`.
# Import them explicitly rather than converting either hop to `export use`,
# which would widen two already-wide surfaces (and lint forbids `export use *`).
# See doc/08_tracking/bug/hir_unresolved_type_owner_missing_import_2026-08-22.md
use compiler.frontend.parser_types_expr.{parser_type_kind_named_name, parser_type_kind_array_element_name}
use compiler.hir.hir_lowering.module_surface_types.{ModuleSurface, ModuleSurfaceCallable, ModuleSurfaceComposite, ModuleSurfaceCompositeIndex, ModuleSurfaceConst, ModuleSurfaceDeclarationAuthorityIndex, ModuleSurfaceEnum, ModuleSurfaceExportOriginIndex, ModuleSurfaceField, ModuleSurfaceImpl, ModuleSurfaceParam, ModuleSurfaceTrait, ModuleSurfaceTypeAlias, module_surface_declaration_authority_index_empty, module_surface_declaration_authority_index_put, module_surface_export_origin_index_empty, module_surface_export_origin_index_put}
use compiler.hir.hir_lowering.module_surface_source_identity.{module_surface_canonical_path, module_surface_logical_name_from_path, module_surface_fold_std_alias, module_surface_package_name_from_name}
use compiler.hir.hir_lowering.module_surface_semantic_projection.{module_surface_semantic_projection, module_surface_semantic_hex_limb}

extern fn rt_hash_text(content: text) -> i64

fn module_surface_callable_from_function(function_: ParserFunction) -> ModuleSurfaceCallable:
    var params: [ModuleSurfaceParam] = []
    for raw_param in function_.params:
        # ANY-transport hazard sweep round 3: annotated rebind.
        val param: Param = raw_param
        params = params.push(ModuleSurfaceParam(
            name: param.name,
            has_type_: param.has_type_,
            type_: param.type_,
            type_name: parser_type_kind_named_name(param.type_.kind),
            array_element_name: parser_type_kind_array_element_name(param.type_.kind),
            has_default: false,
            is_mutable: param.is_mutable,
            span: param.span
        ))
    ModuleSurfaceCallable(
        name: function_.name,
        type_params: function_.type_params,
        params: params,
        has_return_type: function_.has_return_type,
        return_type: function_.return_type,
        return_type_name: parser_type_kind_named_name(function_.return_type.kind),
        return_array_element_name: parser_type_kind_array_element_name(function_.return_type.kind),
        visibility: function_.visibility,
        is_async: function_.is_async,
        is_static: function_.is_static,
        is_public: function_.is_public,
        is_method: function_.is_method,
        is_mutable: function_.is_mutable,
        is_const: function_.is_const,
        is_kernel: function_.is_kernel,
        is_extern: function_.is_extern,
        span: function_.span
    )

fn module_surface_callable_from_header(
    header: ParserFunctionHeader
) -> ModuleSurfaceCallable:
    var params: [ModuleSurfaceParam] = []
    for raw_param in header.params:
        # ParserFunctionHeader.params is [ParserParamHeader], NOT [Param] --
        # mis-annotating it here deterministically SIGSEGV'd the self-compile
        # worker inside this function (cycle-61 r4 shim backtrace).
        val param: ParserParamHeader = raw_param
        params = params.push(ModuleSurfaceParam(
            name: param.name,
            has_type_: param.has_type_,
            type_: param.type_,
            type_name: parser_type_kind_named_name(param.type_.kind),
            array_element_name: parser_type_kind_array_element_name(param.type_.kind),
            has_default: false,
            is_mutable: param.is_mutable,
            span: param.span
        ))
    ModuleSurfaceCallable(
        name: header.name,
        type_params: header.type_params,
        params: params,
        has_return_type: header.has_return_type,
        return_type: header.return_type,
        return_type_name: parser_type_kind_named_name(header.return_type.kind),
        return_array_element_name: parser_type_kind_array_element_name(header.return_type.kind),
        visibility: header.visibility,
        is_async: header.is_async,
        is_static: header.is_static,
        is_public: header.is_public,
        is_method: header.is_method,
        is_mutable: header.is_mutable,
        is_const: header.is_const,
        is_kernel: header.is_kernel,
        is_extern: header.is_extern,
        span: header.span
    )

fn module_surface_trait_from_trait(trait_: ParserTrait) -> ModuleSurfaceTrait:
    var methods: [ModuleSurfaceCallable] = []
    var default_methods: [ParserFunction] = []
    for raw_method in trait_.methods:
        # ANY-transport hazard sweep: annotated rebind (worker SIGSEGV in
        # module_surface_from_owner while self-compiling, cycle-61 r4).
        val method: ParserFunction = raw_method
        methods = methods.push(module_surface_callable_from_function(method))
        if not method.body.stmts.is_empty():
            default_methods = default_methods.push(method)
    ModuleSurfaceTrait(
        name: trait_.name,
        type_params: trait_.type_params,
        super_traits: trait_.super_traits,
        where_clause: trait_.where_clause,
        methods: methods,
        default_methods: default_methods,
        assoc_types: trait_.assoc_types,
        visibility: trait_.visibility,
        is_public: trait_.is_public,
        span: trait_.span
    )

fn module_surface_impl_from_impl(impl_: Impl) -> ModuleSurfaceImpl:
    var methods: Dict<text, ModuleSurfaceCallable> = {}
    for name in impl_.methods.keys():
        methods[name] = module_surface_callable_from_function(impl_.methods[name])
    ModuleSurfaceImpl(
        type_: impl_.type_,
        has_trait_: impl_.has_trait_,
        trait_: impl_.trait_,
        methods: methods
    )

fn module_surface_projected_type_shape(type_: Type) -> text:
    """Scalar shape class of one composite-field type for the frozen
    composite projection: ``named`` / ``array`` / ``other``.

    Mirrors the ``type_name`` / ``array_element_name`` scalar pair on
    ``ModuleSurfaceField`` so import registration can project fields from
    the scalar index without reopening the retained ``ModuleSurfaceField``
    payload (50feb3ba227 landed only the callers of this pair).
    """
    if parser_type_kind_named_name(type_.kind) != "": return "named"
    if parser_type_kind_array_element_name(type_.kind) != "": return "array"
    "other"

fn module_surface_projected_type_name(type_: Type, shape: text) -> text:
    """Scalar type name paired with ``module_surface_projected_type_shape``:
    the named type for ``named``, the element type for ``array``, else ``""``."""
    if shape == "named": return parser_type_kind_named_name(type_.kind)
    if shape == "array": return parser_type_kind_array_element_name(type_.kind)
    ""

fn module_surface_export_origin_hints(
    source: SourceFile, origins: ModuleSurfaceExportOriginIndex
) -> Result<bool, text>:
    # Most modules are not generated facades. Avoid splitting their complete
    # source into per-line text objects: the no-GC bootstrap runtime retains
    # those strings for the process lifetime even though this scanner cannot
    # produce a hint without the exact generator marker.
    if not source.content.contains("# Re-exported from "):
        return Ok(true)
    var owner_file = ""
    var facade_name = module_surface_fold_std_alias(
        module_surface_logical_name_from_path(source.path))
    if facade_name.ends_with(".__init__"):
        facade_name = facade_name[0:facade_name.len() - 9]
    for raw_line in source.content.split("\n"):
        val line = raw_line.trim()
        if line.starts_with("# Re-exported from ") and line.contains(".spl"):
            val owner_parts = line.substring(19).split(".spl")
            owner_file = owner_parts[0]
            continue
        # Explicit re-exports already carry a parsed module path. Never
        # split their import syntax as a generated plain-export name list.
        var explicit_export_tail = ""
        if owner_file != "" and line.starts_with("export "):
            explicit_export_tail = line.substring(7).trim()
        if explicit_export_tail == "use" or explicit_export_tail.starts_with("use ") or explicit_export_tail.starts_with("use\t"):
            owner_file = ""
            continue
        if owner_file != "" and line.starts_with("export "):
            val owner_module = facade_name + "." + owner_file.replace("/", ".")
            for raw_item in line.substring(7).split(","):
                val item = raw_item.trim()
                if item != "" and not item.ends_with(".*"):
                    var source_name = item
                    var local_name = item
                    if item.contains(":"):
                        val parts = item.split(":")
                        source_name = parts[0].trim()
                        if parts.len() > 1:
                            local_name = parts[1].trim()
                    val put_result = module_surface_export_origin_index_put(
                        origins, local_name, owner_module, source_name,
                        "generated-comment")
                    if put_result.is_err():
                        return Err(put_result.unwrap_err())
            owner_file = ""
        elif line != "" and not line.starts_with("#"):
            owner_file = ""
    Ok(true)

# The self-hosted candidate corrupts class fields whose type is a large
# inline struct: `value: ParserModule` (30 limbs) read back garbage
# (name.len() == -1) no matter how many typed local binds wrapped the
# store. Same family as the NLL live_aliases array-argument corruption.
# The wrapper therefore stores ONE HANDLE-SIZED SLOT PER ParserModule LIMB
# (texts/Dicts/arrays are all single handles; bools/i64s are scalars) and
# `module_surface_owner_value` reconstructs the ParserModule at the use
# site. The proper repair is the compiler's class-field layout/copy for
# large inline structs.
# @workaround bug=stage2_sanity_module_path_naming_probe_segv_2026_10_22 reason=class_inline_struct_field_corrupts
pub class ModuleSurfaceParserOwner:
    name: text
    imports: [ParserImport]
    exports: [Export]
    domain_blocks: [DomainBlock]
    functions: Dict<text, ParserFunction>
    function_headers: Dict<text, ParserFunctionHeader>
    function_order: [text]
    classes: Dict<text, ParserClass>
    actors: Dict<text, ActorDef>
    actor_order: [text]
    structs: Dict<text, ParserStruct>
    enums: Dict<text, ParserEnum>
    bitfields: Dict<text, Bitfield>
    traits: Dict<text, ParserTrait>
    impls: [Impl]
    type_aliases: Dict<text, ParserTypeAlias>
    constants: Dict<text, ParserConst>
    static_asserts: [StaticAssert]
    aop_advices: [AopAdvice]
    di_bindings: [DiBinding]
    arch_rules: [ArchRule]
    mock_decls: [MockDecl]
    tagged_layer: text
    layer_dag_edges: text
    friends: [text]
    internal_exports: [text]
    nogc_strict: bool
    extend_enums: [ParserExtendEnum]
    representation_declarations: [RepresentationDeclarationV1]

    static fn new(value: ParserModule) -> ModuleSurfaceParserOwner:
        # Annotated rebind per limb: ANY-transport hazard sweep pattern used
        # throughout this file for parser aggregates crossing call boundaries.
        # @workaround bug=stage2_sanity_module_path_naming_probe_segv_2026_10_22 reason=by_value_sweep
        val v_name: text = value.name
        val v_imports: [ParserImport] = value.imports
        val v_exports: [Export] = value.exports
        val v_domain_blocks: [DomainBlock] = value.domain_blocks
        val v_functions: Dict<text, ParserFunction> = value.functions
        val v_function_headers: Dict<text, ParserFunctionHeader> = value.function_headers
        val v_function_order: [text] = value.function_order
        val v_classes: Dict<text, ParserClass> = value.classes
        val v_actors: Dict<text, ActorDef> = value.actors
        val v_actor_order: [text] = value.actor_order
        val v_structs: Dict<text, ParserStruct> = value.structs
        val v_enums: Dict<text, ParserEnum> = value.enums
        val v_bitfields: Dict<text, Bitfield> = value.bitfields
        val v_traits: Dict<text, ParserTrait> = value.traits
        val v_impls: [Impl] = value.impls
        val v_type_aliases: Dict<text, ParserTypeAlias> = value.type_aliases
        val v_constants: Dict<text, ParserConst> = value.constants
        val v_static_asserts: [StaticAssert] = value.static_asserts
        val v_aop_advices: [AopAdvice] = value.aop_advices
        val v_di_bindings: [DiBinding] = value.di_bindings
        val v_arch_rules: [ArchRule] = value.arch_rules
        val v_mock_decls: [MockDecl] = value.mock_decls
        val v_tagged_layer: text = value.tagged_layer
        val v_layer_dag_edges: text = value.layer_dag_edges
        val v_friends: [text] = value.friends
        val v_internal_exports: [text] = value.internal_exports
        val v_nogc_strict: bool = value.nogc_strict
        val v_extend_enums: [ParserExtendEnum] = value.extend_enums
        val v_representation_declarations: [RepresentationDeclarationV1] = value.representation_declarations
        ModuleSurfaceParserOwner(
            name: v_name,
            imports: v_imports,
            exports: v_exports,
            domain_blocks: v_domain_blocks,
            functions: v_functions,
            function_headers: v_function_headers,
            function_order: v_function_order,
            classes: v_classes,
            actors: v_actors,
            actor_order: v_actor_order,
            structs: v_structs,
            enums: v_enums,
            bitfields: v_bitfields,
            traits: v_traits,
            impls: v_impls,
            type_aliases: v_type_aliases,
            constants: v_constants,
            static_asserts: v_static_asserts,
            aop_advices: v_aop_advices,
            di_bindings: v_di_bindings,
            arch_rules: v_arch_rules,
            mock_decls: v_mock_decls,
            tagged_layer: v_tagged_layer,
            layer_dag_edges: v_layer_dag_edges,
            friends: v_friends,
            internal_exports: v_internal_exports,
            nogc_strict: v_nogc_strict,
            extend_enums: v_extend_enums,
            representation_declarations: v_representation_declarations
        )

pub fn module_surface_owner_value(owner: ModuleSurfaceParserOwner) -> ParserModule:
    # Reconstruct the ParserModule from the wrapper's handle-sized limbs.
    # Named construction of a 30-field struct lowers correctly in the
    # candidate; only the class-inline-struct-field round trip was corrupt.
    ParserModule(
        name: owner.name,
        imports: owner.imports,
        exports: owner.exports,
        domain_blocks: owner.domain_blocks,
        functions: owner.functions,
        function_headers: owner.function_headers,
        function_order: owner.function_order,
        classes: owner.classes,
        actors: owner.actors,
        actor_order: owner.actor_order,
        structs: owner.structs,
        enums: owner.enums,
        bitfields: owner.bitfields,
        traits: owner.traits,
        impls: owner.impls,
        type_aliases: owner.type_aliases,
        constants: owner.constants,
        static_asserts: owner.static_asserts,
        aop_advices: owner.aop_advices,
        di_bindings: owner.di_bindings,
        arch_rules: owner.arch_rules,
        mock_decls: owner.mock_decls,
        tagged_layer: owner.tagged_layer,
        layer_dag_edges: owner.layer_dag_edges,
        friends: owner.friends,
        internal_exports: owner.internal_exports,
        nogc_strict: owner.nogc_strict,
        extend_enums: owner.extend_enums,
        representation_declarations: owner.representation_declarations
    )

pub fn module_surface_from_owner(
    owner: ModuleSurfaceParserOwner, source: SourceFile, source_index: i64
) -> Result<ModuleSurface, text>:
    # Compute while the complete ParserModule owner is alive; only four flat
    # limbs cross into persistent surface storage.
    # owner.value no longer exists: the class stores one handle-sized slot per
    # ParserModule limb (see ModuleSurfaceParserOwner) and this reconstruction
    # is the single sanctioned read path.
    # @workaround bug=stage2_sanity_module_path_naming_probe_segv_2026_10_22 reason=class_inline_struct_field_corrupts
    val module_local: ParserModule = module_surface_owner_value(owner)
    val semantic_hex = module_surface_semantic_projection(module_local)
    val semantic_cacheable = semantic_hex.len() == 64
    var callables: Dict<text, ModuleSurfaceCallable> = {}
    var callable_names: [text] = []
    for name in module_local.functions.keys():
        val callable = if module_local.function_headers.contains_key(name):
            val fn_header: ParserFunctionHeader = module_local.function_headers[name]
            module_surface_callable_from_header(fn_header)
        else:
            # Compatibility for parser producers without the compact header
            # index.
            module_surface_callable_from_function(module_local.functions[name])
        callables[name] = callable
        callable_names = callable_names.push(name)

    var composites: Dict<text, ModuleSurfaceComposite> = {}
    for name in module_local.classes.keys():
        val class_: ParserClass = module_local.classes[name]
        var fields: [ModuleSurfaceField] = []
        for raw_field in class_.fields:
            # ANY-transport hazard sweep round 3: annotated rebind.
            val field: ParserField = raw_field
            fields = fields.push(ModuleSurfaceField(
                name: field.name,
                type_: field.type_,
                type_name: parser_type_kind_named_name(field.type_.kind),
                array_element_name: parser_type_kind_array_element_name(field.type_.kind),
                visibility: field.visibility,
                declaring_module: source.module_name))
        composites[name] = ModuleSurfaceComposite(name: class_.name, kind: "class", type_params: class_.type_params, fields: fields, visibility: class_.visibility, is_public: class_.is_public, span: class_.span)
    for name in module_local.actors.keys():
        val actor: ActorDef = module_local.actors[name]
        var fields: [ModuleSurfaceField] = []
        for raw_field in actor.fields:
            val field: ParserField = raw_field
            fields = fields.push(ModuleSurfaceField(
                name: field.name,
                type_: field.type_,
                type_name: parser_type_kind_named_name(field.type_.kind),
                array_element_name: parser_type_kind_array_element_name(field.type_.kind),
                visibility: field.visibility,
                declaring_module: source.module_name))
        composites[name] = ModuleSurfaceComposite(name: actor.name, kind: "actor", type_params: actor.type_params, fields: fields, visibility: actor.visibility, is_public: actor.is_public, span: actor.span)
    for name in module_local.structs.keys():
        val struct_: ParserStruct = module_local.structs[name]
        var fields: [ModuleSurfaceField] = []
        for raw_field in struct_.fields:
            val field: ParserField = raw_field
            fields = fields.push(ModuleSurfaceField(
                name: field.name,
                type_: field.type_,
                type_name: parser_type_kind_named_name(field.type_.kind),
                array_element_name: parser_type_kind_array_element_name(field.type_.kind),
                visibility: field.visibility,
                declaring_module: source.module_name))
        composites[name] = ModuleSurfaceComposite(name: struct_.name, kind: "struct", type_params: struct_.type_params, fields: fields, visibility: struct_.visibility, is_public: struct_.is_public, span: struct_.span)

    var enums: Dict<text, ModuleSurfaceEnum> = {}
    for name in module_local.enums.keys():
        val enum_: ParserEnum = module_local.enums[name]
        enums[name] = ModuleSurfaceEnum(name: enum_.name, type_params: enum_.type_params, variants: enum_.variants, visibility: enum_.visibility, is_public: enum_.is_public, span: enum_.span)

    var traits: Dict<text, ModuleSurfaceTrait> = {}
    for name in module_local.traits.keys():
        traits[name] = module_surface_trait_from_trait(module_local.traits[name])

    var impls: [ModuleSurfaceImpl] = []
    for impl_ in module_local.impls:
        impls = impls.push(module_surface_impl_from_impl(impl_))

    var type_aliases: Dict<text, ModuleSurfaceTypeAlias> = {}
    for name in module_local.type_aliases.keys():
        val alias: ParserTypeAlias = module_local.type_aliases[name]
        type_aliases[name] = ModuleSurfaceTypeAlias(
            name: alias.name,
            type_params: alias.type_params,
            type_: alias.type_,
            visibility: alias.visibility,
            is_public: alias.is_public,
            span: alias.span
        )

    var constants: Dict<text, ModuleSurfaceConst> = {}
    for name in module_local.constants.keys():
        val constant: ParserConst = module_local.constants[name]
        constants[name] = ModuleSurfaceConst(
            name: constant.name,
            has_type_: constant.has_type_,
            type_: constant.type_,
            is_mutable: constant.is_mutable,
            visibility: constant.visibility,
            is_public: constant.is_public,
            is_volatile: constant.is_volatile,
            has_fixed_address: constant.has_fixed_address,
            fixed_address: constant.fixed_address,
            span: constant.span
        )

    # Keep the class payload caller-owned. Native generic Result payload
    # lowering is not an ownership boundary for reference-valued classes.
    val origin_hints = module_surface_export_origin_index_empty()
    val origin_hints_result = module_surface_export_origin_hints(
        source, origin_hints)
    if origin_hints_result.is_err():
        return Err(origin_hints_result.unwrap_err())
    val composite_names = composites.keys()
    val composite_index = ModuleSurfaceCompositeIndex.empty()
    for composite_name in composite_names:
        val composite: ModuleSurfaceComposite = composites[composite_name]
        composite_index.kinds = composite_index.kinds.push(composite.kind)
        composite_index.field_offsets = composite_index.field_offsets.push(
            composite_index.field_names.len())
        composite_index.field_counts = composite_index.field_counts.push(
            composite.fields.len())
        composite_index.dependency_offsets = composite_index.dependency_offsets.push(
            composite_index.dependency_names.len())
        val dependency_start = composite_index.dependency_names.len()
        for raw_field in composite.fields:
            val field: ModuleSurfaceField = raw_field
            val shape = module_surface_projected_type_shape(field.type_)
            composite_index.field_names = composite_index.field_names.push(field.name)
            composite_index.field_shapes = composite_index.field_shapes.push(shape)
            composite_index.field_type_names = composite_index.field_type_names.push(
                module_surface_projected_type_name(field.type_, shape))
            for dependency in parser_type_named_dependencies(field.type_):
                composite_index.dependency_names = composite_index.dependency_names.push(
                    dependency)
        composite_index.dependency_counts = composite_index.dependency_counts.push(
            composite_index.dependency_names.len() - dependency_start)
    val enum_names = enums.keys()
    val trait_names = traits.keys()
    val type_alias_names = type_aliases.keys()
    val constant_names = constants.keys()
    var composite_values: [ModuleSurfaceComposite] = []
    for name in composite_names:
        composite_values = composite_values.push(composites[name])
    var enum_values: [ModuleSurfaceEnum] = []
    for name in enum_names:
        enum_values = enum_values.push(enums[name])
    var trait_values: [ModuleSurfaceTrait] = []
    for name in trait_names:
        trait_values = trait_values.push(traits[name])
    var callable_values: [ModuleSurfaceCallable] = []
    for name in callable_names:
        callable_values = callable_values.push(callables[name])
    var type_alias_values: [ModuleSurfaceTypeAlias] = []
    for name in type_alias_names:
        type_alias_values = type_alias_values.push(type_aliases[name])
    var constant_values: [ModuleSurfaceConst] = []
    for name in constant_names:
        constant_values = constant_values.push(constants[name])
    val declaration_authorities = module_surface_declaration_authority_index_empty()
    for name in callable_names:
        val result = module_surface_declaration_authority_index_put(
            declaration_authorities, name, source.module_name, name,
            callables[name].visibility)
        if result.is_err(): return Err(result.unwrap_err())
    for name in composite_names:
        val result = module_surface_declaration_authority_index_put(
            declaration_authorities, name, source.module_name, name,
            composites[name].visibility)
        if result.is_err(): return Err(result.unwrap_err())
    for name in enum_names:
        val result = module_surface_declaration_authority_index_put(
            declaration_authorities, name, source.module_name, name,
            enums[name].visibility)
        if result.is_err(): return Err(result.unwrap_err())
    for name in trait_names:
        val result = module_surface_declaration_authority_index_put(
            declaration_authorities, name, source.module_name, name,
            traits[name].visibility)
        if result.is_err(): return Err(result.unwrap_err())
    for name in type_alias_names:
        val result = module_surface_declaration_authority_index_put(
            declaration_authorities, name, source.module_name, name,
            type_aliases[name].visibility)
        if result.is_err(): return Err(result.unwrap_err())
    for name in constant_names:
        val result = module_surface_declaration_authority_index_put(
            declaration_authorities, name, source.module_name, name,
            constants[name].visibility)
        if result.is_err(): return Err(result.unwrap_err())
    # Flatten nested parser import items while this file's parser payload is
    # still alive. Freeze will clone these retained scalars into its own scope;
    # it must never traverse ParserImport.items after the file scope ends.
    var import_item_offsets: [i64] = [0]
    var import_item_names: [text] = []
    var import_item_aliases: [text] = []
    var import_item_has_alias: [bool] = []
    for raw_import_decl in module_local.imports:
        val import_decl: ParserImport = raw_import_decl
        # (loop body continues below; import_item rebound inside)
        for raw_import_item in import_decl.items:
            val import_item: ImportItem = raw_import_item
            import_item_names = import_item_names.push(import_item.name)
            val import_alias = if import_item.has_alias: import_item.alias else: ""
            import_item_aliases = import_item_aliases.push(import_alias)
            import_item_has_alias = import_item_has_alias.push(import_item.has_alias)
        import_item_offsets = import_item_offsets.push(import_item_names.len())
    val logical_name = module_surface_logical_name_from_path(source.path)
    val canonical_name = module_surface_fold_std_alias(logical_name)
    Ok(ModuleSurface(
        physical_index: source_index,
        generation: 0,
        frozen: false,
        source_index: source_index,
        canonical_path: module_surface_canonical_path(source.path),
        module_name: source.module_name,
        logical_name: logical_name,
        canonical_name: canonical_name,
        package_name: module_surface_package_name_from_name(canonical_name),
        preferred_registry_name: "",
        content_length: source.content.len(),
        content_hash: rt_hash_text(source.content),
        semantic_hash0: module_surface_semantic_hex_limb(semantic_hex, 0),
        semantic_hash1: module_surface_semantic_hex_limb(semantic_hex, 1),
        semantic_hash2: module_surface_semantic_hex_limb(semantic_hex, 2),
        semantic_hash3: module_surface_semantic_hex_limb(semantic_hex, 3),
        semantic_cacheable: semantic_cacheable,
        nogc_strict: module_local.nogc_strict,
        imports: module_local.imports,
        exports: module_local.exports,
        friends: module_local.friends.copy(),
        internal_exports: module_local.internal_exports.copy(),
        import_target_indices: [],
        import_target_names: [],
        import_resolution_traces: [],
        import_item_offsets: import_item_offsets,
        import_item_names: import_item_names,
        import_item_aliases: import_item_aliases,
        import_item_has_alias: import_item_has_alias,
        export_route_sources: [],
        export_route_locals: [],
        export_route_target_indices: [],
        export_route_target_names: [],
        export_route_is_glob: [],
        composite_names: composite_names,
        composite_index: composite_index,
        enum_names: enum_names,
        trait_names: trait_names,
        callable_names: callable_names,
        type_alias_names: type_alias_names,
        constant_names: constant_names,
        callable_values: callable_values,
        composite_values: composite_values,
        enum_values: enum_values,
        trait_values: trait_values,
        type_alias_values: type_alias_values,
        constant_values: constant_values,
        callables: callables,
        composites: composites,
        enums: enums,
        traits: traits,
        impls: impls,
        type_aliases: type_aliases,
        constants: constants,
        export_origins: origin_hints.origins,
        export_origin_index: origin_hints,
        declaration_authority_index: declaration_authorities
    ))

pub(package) fn module_surface_from_module(
    module: ParserModule, source: SourceFile, source_index: i64
) -> Result<ModuleSurface, text>:
    val owner = ModuleSurfaceParserOwner.new(module)
    module_surface_from_owner(owner, source, source_index)
