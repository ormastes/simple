# Scalar module authority used by destination symbols and canonical visibility.
# It owns only SoA text/scalars; no parser/HIR aggregate crosses this boundary.
const HD_VIS_PUBLIC: i64 = 0
const HD_VIS_PEER: i64 = 1
const HD_VIS_UP: i64 = 2
const HD_VIS_INTERNAL: i64 = 3
const HD_VIS_PACKAGE: i64 = 4
const HD_VIS_PRIVATE: i64 = 5

class HirDestinationModuleAuthorityStore:
    generation: i64 = -1
    frozen: bool = false
    error: bool = false
    count: i64 = 0
    capacity: i64 = 0
    ready: [bool] = []
    row_generation: [i64] = []
    module_index: [i64] = []
    source_key: [text] = []
    peer_key: [text] = []
    layer_path: [text] = []
    parent_facade_key: [text] = []
    package_path: [text] = []
    facade_start: [i64] = []
    facade_len: [i64] = []
    friend_start: [i64] = []
    friend_len: [i64] = []
    row_by_module: Dict<i64, i64> = {}
    row_by_source: Dict<text, i64> = {}
    text_count: i64 = 0
    text_capacity: i64 = 0
    text_value: [text] = []
    range_count: i64 = 0
    range_capacity: i64 = 0
    range_start: [i64] = []
    range_len: [i64] = []
    range_ready: [bool] = []
    range_generation: [i64] = []
    text_ready: [bool] = []

    me begin(g: i64) -> bool:
        if g < 0: return false
        self.row_by_module.clear(); self.row_by_source.clear(); self.generation=g; self.frozen=false; self.error=false
        self.count=0; self.text_count=0; self.range_count=0; true
    me ensure_rows(required: i64):
        if required <= self.capacity: return
        var target=if self.capacity < 8: 8 else: self.capacity
        while target < required: target=target*2
        while self.ready.len() < target:
            self.ready.push(false); self.row_generation.push(-1); self.module_index.push(-1)
            self.source_key.push(""); self.peer_key.push(""); self.layer_path.push(""); self.parent_facade_key.push(""); self.package_path.push(""); self.facade_start.push(-1)
            self.facade_len.push(0); self.friend_start.push(-1); self.friend_len.push(0)
        self.capacity=target
    me reserve_text_range(n: i64) -> i64:
        if self.frozen or self.error or n < 0: self.error=true; return -1
        val handle=self.range_count
        if handle+1 > self.range_capacity:
            var target=if self.range_capacity < 8: 8 else: self.range_capacity
            while target < handle+1: target=target*2
            while self.range_start.len() < target:
                self.range_start.push(-1); self.range_len.push(0); self.range_ready.push(false); self.range_generation.push(-1)
            self.range_capacity=target
        val start=self.text_count; val required=start+n
        if required > self.text_capacity:
            var target=if self.text_capacity < 8: 8 else: self.text_capacity
            while target < required: target=target*2
            while self.text_value.len() < target: self.text_value.push(""); self.text_ready.push(false)
            self.text_capacity=target
        var i=start
        while i < required: self.text_value[i]=""; self.text_ready[i]=false; i=i+1
        self.range_start[handle]=start; self.range_len[handle]=n; self.range_ready[handle]=false
        self.range_generation[handle]=self.generation; self.range_count=handle+1; self.text_count=required; handle
    me set_text_range_at(handle: i64,offset: i64,value: text) -> bool:
        if self.frozen or self.error or value=="" or handle<0 or handle>=self.range_count or self.range_generation[handle]!=self.generation or self.range_ready[handle] or offset<0 or offset>=self.range_len[handle]: self.error=true; return false
        val slot=self.range_start[handle]+offset
        if self.text_ready[slot]: self.error=true; return false
        self.text_value[slot]=value; self.text_ready[slot]=true; true
    me publish_text_range(handle: i64) -> bool:
        if self.frozen or self.error or handle<0 or handle>=self.range_count or self.range_generation[handle]!=self.generation or self.range_ready[handle]: self.error=true; return false
        var i=0
        while i < self.range_len[handle]:
            if not self.text_ready[self.range_start[handle]+i]: self.error=true; return false
            i=i+1
        self.range_ready[handle]=true; true
    me range_valid(handle: i64) -> bool: handle>=0 and handle<self.range_count and self.range_generation[handle]==self.generation and self.range_ready[handle]
    me publish(module_row: i64,source: text,peer: text,layer: text,parent_facade: text,package: text,facades: i64,friends: i64) -> i64:
        if self.frozen or self.error or module_row<0 or source=="" or peer=="" or layer=="" or parent_facade=="" or not self.range_valid(facades) or not self.range_valid(friends) or self.row_by_module.contains_key(module_row) or self.row_by_source.contains_key(source): self.error=true; return -1
        val row=self.count; self.ensure_rows(row+1); self.ready[row]=false; self.row_generation[row]=self.generation
        self.module_index[row]=module_row; self.source_key[row]=source; self.peer_key[row]=peer; self.layer_path[row]=layer; self.parent_facade_key[row]=parent_facade; self.package_path[row]=package
        self.facade_start[row]=self.range_start[facades]; self.facade_len[row]=self.range_len[facades]
        self.friend_start[row]=self.range_start[friends]; self.friend_len[row]=self.range_len[friends]
        self.row_by_module[module_row]=row; self.row_by_source[source]=row; self.ready[row]=true; self.count=row+1; row
    me building_row(module_row: i64,g: i64) -> i64:
        if self.frozen or g!=self.generation or not self.row_by_module.contains_key(module_row): return -1
        val row=self.row_by_module[module_row]; if self.ready[row] and self.row_generation[row]==g: row else: -1
    me row(module_row: i64,g: i64) -> i64:
        if not self.frozen or g!=self.generation or not self.row_by_module.contains_key(module_row): return -1
        val row=self.row_by_module[module_row]; if self.ready[row] and self.row_generation[row]==g: row else: -1
    me building_module_by_source(source: text,g: i64) -> i64:
        if self.frozen or g!=self.generation or source=="" or not self.row_by_source.contains_key(source): return -1
        val row=self.row_by_source[source]; if self.ready[row] and self.row_generation[row]==g: self.module_index[row] else: -1
    me module_by_source(source: text,g: i64) -> i64:
        if not self.frozen or g!=self.generation or source=="" or not self.row_by_source.contains_key(source): return -1
        val row=self.row_by_source[source]; if self.ready[row] and self.row_generation[row]==g: self.module_index[row] else: -1
    fn can_rollback(row_target: i64,range_target: i64,text_target: i64) -> bool:
        not self.frozen and row_target>=0 and row_target<=self.count and range_target>=0 and range_target<=self.range_count and text_target>=0 and text_target<=self.text_count
    me rollback(row_target: i64,range_target: i64,text_target: i64,old_error: bool) -> bool:
        if not self.can_rollback(row_target,range_target,text_target): return false
        var i=row_target
        while i<self.count:
            if self.row_by_module.contains_key(self.module_index[i]): self.row_by_module.remove(self.module_index[i])
            if self.row_by_source.contains_key(self.source_key[i]): self.row_by_source.remove(self.source_key[i])
            self.ready[i]=false; self.row_generation[i]=-1; self.module_index[i]=-1; self.source_key[i]=""; self.peer_key[i]=""; self.layer_path[i]=""; self.parent_facade_key[i]=""; self.package_path[i]=""; self.facade_start[i]=-1; self.facade_len[i]=0; self.friend_start[i]=-1; self.friend_len[i]=0; i=i+1
        i=range_target
        while i<self.range_count: self.range_ready[i]=false; self.range_generation[i]=-1; self.range_start[i]=-1; self.range_len[i]=0; i=i+1
        i=text_target
        while i<self.text_count: self.text_ready[i]=false; self.text_value[i]=""; i=i+1
        self.count=row_target; self.range_count=range_target; self.text_count=text_target; self.error=old_error; true
    me can_freeze() -> bool:
        if self.error: return false
        var i=0
        while i<self.range_count: if not self.range_ready[i] or self.range_generation[i]!=self.generation: return false else: i=i+1
        i=0
        while i<self.count: if not self.ready[i] or self.row_generation[i]!=self.generation: return false else: i=i+1
        true
    me freeze() -> bool:
        if not self.can_freeze(): return false
        self.frozen=true; true
    me commit_freeze():
        self.frozen = true
    me text_range_contains(start: i64,n: i64,wanted: text) -> bool:
        var i=0
        while i<n: if self.text_value[start+i]==wanted: return true else: i=i+1
        false
    me visibility_allows(owner_module: i64,requester_module: i64,visibility: i64,g: i64,read_mode: bool) -> bool:
        val owner=if read_mode: self.row(owner_module,g) else: self.building_row(owner_module,g)
        val requester=if read_mode: self.row(requester_module,g) else: self.building_row(requester_module,g)
        if owner<0 or requester<0 or visibility<HD_VIS_PUBLIC or visibility>HD_VIS_PRIVATE: return false
        if self.source_key[owner]==self.source_key[requester]: return true
        if visibility==HD_VIS_PUBLIC: return true
        if visibility==HD_VIS_PEER: return self.peer_key[owner]==self.peer_key[requester] and self.layer_path[owner]!=self.layer_path[requester]
        if visibility==HD_VIS_UP: return self.parent_facade_key[owner]==self.source_key[requester]
        if visibility==HD_VIS_INTERNAL:
            return self.package_path[owner]==self.package_path[requester] or self.text_range_contains(self.friend_start[owner],self.friend_len[owner],self.package_path[requester])
        if visibility==HD_VIS_PACKAGE: return self.package_path[owner]==self.package_path[requester]
        false
    me capacity_bytes_estimate() -> i64: self.capacity*160+self.range_capacity*40+self.text_capacity*24
    me text_payload_bytes() -> i64:
        var total=0; var i=0
        while i<self.source_key.len(): total=total+self.source_key[i].len()+self.peer_key[i].len()+self.layer_path[i].len()+self.parent_facade_key[i].len()+self.package_path[i].len(); i=i+1
        i=0; while i<self.text_value.len(): total=total+self.text_value[i].len(); i=i+1
        total

export HirDestinationModuleAuthorityStore
export HD_VIS_PUBLIC, HD_VIS_PEER, HD_VIS_UP, HD_VIS_INTERNAL, HD_VIS_PACKAGE, HD_VIS_PRIVATE
