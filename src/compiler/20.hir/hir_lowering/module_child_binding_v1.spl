# Source-written import bindings only. Recursive dependency materialization
# calls the existing registration owner and cannot borrow this route context.
use compiler.common.cache.module_child_selection_receipt_v1.{ModuleChildSelectionReceiptV1}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_symbol_table_methods.*
use compiler.hir.hir_lowering._Items.module_import_registration.*
use compiler.hir.hir_lowering.module_child_selection_v1.{module_child_selection_validate_v1}

impl HirLowering:
    fn module_child_binding_key_v1(name: text) -> text:
        val binding = self.symbols.lookup_binding_v1(name)
        if binding.symbol_id < 0: return ""
        "{self.module_filename.byte_len()}:{self.module_filename}:{binding.scope_id}:{binding.symbol_id}:{binding.version}:{name}"

    me record_module_child_binding_v1(name: text, before: text,
            receipt: ModuleChildSelectionReceiptV1):
        val key = self.module_child_binding_key_v1(name)
        # A no-op bind/memo hit is not a fresh route selection. In particular a
        # later public alias cannot overwrite a preexisting private route.
        if key == "" or key == before: return
        if module_child_selection_validate_v1(self.module_surfaces, receipt) != "": return
        self.module_child_binding_keys_v1.push(key)
        self.module_child_binding_receipts_v1.push(receipt)

    fn selected_module_child_binding_v1(name: text) -> ModuleChildSelectionReceiptV1:
        val key = self.module_child_binding_key_v1(name)
        if key == "" or self.module_child_binding_keys_v1.len() != self.module_child_binding_receipts_v1.len():
            return ModuleChildSelectionReceiptV1()
        # Request-local provenance lookup; full requester authorization is not
        # wired here. The map is bounded by source-written binding mutations.
        var index = self.module_child_binding_keys_v1.len() - 1
        while index >= 0:
            if self.module_child_binding_keys_v1[index] == key:
                val receipt = self.module_child_binding_receipts_v1[index]
                if module_child_selection_validate_v1(self.module_surfaces, receipt) == "": return receipt
                return ModuleChildSelectionReceiptV1()
            index = index - 1
        ModuleChildSelectionReceiptV1()

    me register_source_import_v1(imported_index: i64, imported_mod_name: text,
            imported_name: text, local_name: text, import_span: Span, materialize_enum: bool):
        val selected_category = self.register_source_import_selected_v1(imported_index,
            imported_mod_name, imported_name, local_name, import_span, materialize_enum)

    me register_source_import_selected_v1(imported_index: i64, imported_mod_name: text,
            imported_name: text, local_name: text, import_span: Span, materialize_enum: bool) -> text:
        val before = self.module_child_binding_key_v1(local_name)
        val receipt = self.active_module_child_selection_v1
        val category = self.register_imported_symbol_selected_v1(imported_index,
            imported_mod_name, imported_name, local_name, import_span, materialize_enum)
        if receipt.target_surface == imported_index:
            self.record_module_child_binding_v1(local_name, before, receipt)
        category
