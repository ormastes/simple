# Scalar declaration authority for destination HIR.  This store owns no parser
# or HIR aggregate values: cross-store values are integer row receipts.

pub val HD_DECL_ACTOR = 1
pub val HD_DECL_BITFIELD = 2
pub val HD_DECL_CONSTANT = 3
pub val HD_DECL_ENUM = 4
pub val HD_DECL_ENUM_EXTENSION = 5
pub val HD_NOMINAL_CLASS = 1
pub val HD_NOMINAL_STRUCT = 2

pub val HD_DECORATOR_OWNER_ENUM_VARIANT = 6

pub val HD_ENUM_PAYLOAD_NONE = 0
pub val HD_ENUM_PAYLOAD_TUPLE = 1
pub val HD_ENUM_PAYLOAD_STRUCT = 2
pub val HD_SCHEDULE_SYMBOL = 1
pub val HD_SCHEDULE_FUNCTION = 2
pub val HD_SCHEDULE_DECLARATION = 3
pub val HD_SCHEDULE_IMPL = 4
pub val HD_SCHEDULE_EXTENSION = 5

class HirDestinationDeclarationStore:
    generation: i64 = -1
    frozen: bool = false
    error: bool = false

    declaration_count: i64 = 0
    declaration_capacity: i64 = 0
    declaration_ready: [bool] = []
    declaration_generation: [i64] = []
    declaration_kind: [i64] = []
    declaration_module: [i64] = []
    declaration_symbol: [i64] = []
    declaration_name: [text] = []
    declaration_visibility: [i64] = []
    declaration_is_public: [bool] = []
    declaration_has_doc: [bool] = []
    declaration_doc: [text] = []
    declaration_span: [i64] = []
    declaration_type_param_start: [i64] = []
    declaration_type_param_count: [i64] = []
    declaration_decorator_start: [i64] = []
    declaration_decorator_count: [i64] = []
    actor_message_type: [i64] = []
    actor_has_message_type: [bool] = []
    actor_mailbox_capacity: [i64] = []
    actor_has_mailbox_capacity: [bool] = []
    actor_field_start: [i64] = []
    actor_field_count: [i64] = []
    bitfield_storage_type: [i64] = []
    bitfield_bit_width: [i64] = []
    bitfield_field_start: [i64] = []
    bitfield_field_count: [i64] = []
    constant_type: [i64] = []
    constant_has_type: [bool] = []
    constant_value: [i64] = []
    constant_mutable: [bool] = []
    constant_volatile: [bool] = []
    constant_has_fixed_address: [bool] = []
    constant_fixed_address: [i64] = []
    enum_complete_open: [bool] = []
    enum_dynamic_open: [bool] = []
    enum_variant_start: [i64] = []
    enum_variant_count: [i64] = []
    # Built only while BUILDING. Frozen enum consumers use these scalar hash
    # banks and never reconstruct legacy HIR enum maps.
    declaration_by_module: [Dict<i64, i64>] = []
    enum_variant_by_name: [Dict<text, i64>] = []

    # Class/struct-only scalar detail. These rows key by destination symbol;
    # they do not duplicate nominal symbols or aggregate parser values.
    nominal_detail_count: i64 = 0
    nominal_detail_capacity: i64 = 0
    nominal_detail_ready: [bool] = []
    nominal_detail_generation: [i64] = []
    nominal_detail_kind: [i64] = []
    nominal_detail_module: [i64] = []
    nominal_detail_symbol: [i64] = []
    nominal_detail_has_base: [bool] = []
    nominal_detail_base_type: [i64] = []
    nominal_detail_trait_start: [i64] = []
    nominal_detail_trait_count: [i64] = []
    nominal_detail_field_start: [i64] = []
    nominal_detail_field_count: [i64] = []
    nominal_detail_span: [i64] = []
    # Module-qualified destination-symbol receipt -> nominal-detail row.
    # Parser symbol ids restart in every module, so each module owns a scalar
    # hash bank. Banks allocate only while BUILDING; frozen lookup is O(1) and
    # validates both authority coordinates before returning a receipt.
    nominal_detail_by_module: [Dict<i64, i64>] = []
    nominal_trait_count_total: i64 = 0
    nominal_trait_capacity: i64 = 0
    nominal_trait_owner: [i64] = []
    nominal_trait_type: [i64] = []
    nominal_field_count_total: i64 = 0
    nominal_field_capacity: i64 = 0
    nominal_field_owner: [i64] = []
    nominal_field_symbol: [i64] = []
    nominal_field_name: [text] = []
    nominal_field_type: [i64] = []
    nominal_field_visibility: [i64] = []
    nominal_field_is_public: [bool] = []
    nominal_field_volatile: [bool] = []
    nominal_field_has_bits: [bool] = []
    nominal_field_bits: [i64] = []
    nominal_field_has_address: [bool] = []
    nominal_field_address: [i64] = []
    nominal_field_has_default: [bool] = []
    nominal_field_default: [i64] = []
    nominal_field_span: [i64] = []
    nominal_active_row: i64 = -1

    type_param_count: i64 = 0
    type_param_capacity: i64 = 0
    type_param_owner: [i64] = []
    type_param_name: [text] = []
    type_param_bound_type: [i64] = []
    type_param_bound_start: [i64] = []
    type_param_bound_count: [i64] = []
    type_param_has_default: [bool] = []
    type_param_default_type: [i64] = []
    type_param_span: [i64] = []

    type_param_bound_count_total: i64 = 0
    type_param_bound_capacity: i64 = 0
    type_param_bound_owner: [i64] = []
    type_param_bound_type_row: [i64] = []

    decorator_count: i64 = 0
    decorator_capacity: i64 = 0
    decorator_owner_kind: [i64] = []
    decorator_owner_row: [i64] = []
    decorator_name: [text] = []
    decorator_argument: [text] = []
    decorator_expr_start: [i64] = []
    decorator_expr_count: [i64] = []
    decorator_span: [i64] = []

    decorator_expr_count_total: i64 = 0
    decorator_expr_capacity: i64 = 0
    decorator_expr_owner: [i64] = []
    decorator_expr_row: [i64] = []

    actor_field_count_total: i64 = 0
    actor_field_capacity: i64 = 0
    actor_field_owner: [i64] = []
    actor_field_symbol: [i64] = []
    actor_field_name: [text] = []
    actor_field_type: [i64] = []
    actor_field_visibility: [i64] = []
    actor_field_is_public: [bool] = []
    actor_field_volatile: [bool] = []
    actor_field_has_bits: [bool] = []
    actor_field_bits: [i64] = []
    actor_field_has_fixed_address: [bool] = []
    actor_field_fixed_address: [i64] = []
    actor_field_has_default: [bool] = []
    actor_field_default: [i64] = []
    actor_field_span: [i64] = []

    bitfield_field_count_total: i64 = 0
    bitfield_field_capacity: i64 = 0
    bitfield_field_owner: [i64] = []
    bitfield_field_symbol: [i64] = []
    bitfield_field_name: [text] = []
    bitfield_field_has_type: [bool] = []
    bitfield_field_type: [i64] = []
    bitfield_field_offset: [i64] = []
    bitfield_field_width: [i64] = []
    bitfield_field_reserved: [bool] = []
    bitfield_field_has_source_bits: [bool] = []
    bitfield_field_source_bits: [i64] = []
    bitfield_field_span: [i64] = []

    enum_variant_count_total: i64 = 0
    enum_variant_capacity: i64 = 0
    enum_variant_owner_kind: [i64] = []
    enum_variant_owner: [i64] = []
    enum_variant_symbol: [i64] = []
    enum_variant_name: [text] = []
    enum_variant_payload_kind: [i64] = []
    enum_variant_payload_start: [i64] = []
    enum_variant_payload_count: [i64] = []
    enum_variant_has_discriminant: [bool] = []
    enum_variant_discriminant: [i64] = []
    enum_variant_decorator_start: [i64] = []
    enum_variant_decorator_count: [i64] = []
    enum_variant_span: [i64] = []

    enum_payload_count: i64 = 0
    enum_payload_capacity: i64 = 0
    enum_payload_variant: [i64] = []
    enum_payload_ordinal: [i64] = []
    enum_payload_name: [text] = []
    enum_payload_type: [i64] = []
    enum_payload_span: [i64] = []
    enum_payload_by_name: [Dict<text, i64>] = []

    enum_extension_count: i64 = 0
    enum_extension_capacity: i64 = 0
    enum_extension_ready: [bool] = []
    enum_extension_generation: [i64] = []
    enum_extension_module: [i64] = []
    enum_extension_target_module: [i64] = []
    enum_extension_target_symbol: [i64] = []
    enum_extension_target_name: [text] = []
    enum_extension_closure_kind: [i64] = []
    enum_extension_closure: [text] = []
    enum_extension_variant_start: [i64] = []
    enum_extension_variant_count: [i64] = []
    enum_extension_constructor_start: [i64] = []
    enum_extension_constructor_count: [i64] = []
    enum_extension_decorator_start: [i64] = []
    enum_extension_decorator_count: [i64] = []
    enum_extension_span: [i64] = []
    enum_extension_source_ordinal: [i64] = []
    enum_extension_schedule_row: [i64] = []

    schedule_count: i64 = 0
    schedule_capacity: i64 = 0
    schedule_domain: [i64] = []
    schedule_receipt: [i64] = []
    schedule_source_ordinal: [i64] = []
    schedule_module: [i64] = []
    schedule_source_kind: [i64] = []
    schedule_source_local_index: [i64] = []
    schedule_seen_symbol: [i64] = []
    schedule_seen_function: [i64] = []
    schedule_seen_declaration: [i64] = []
    schedule_seen_impl: [i64] = []
    schedule_seen_extension: [i64] = []

    enum_constructor_count: i64 = 0
    enum_constructor_capacity: i64 = 0
    enum_constructor_extension: [i64] = []
    enum_constructor_variant: [i64] = []
    enum_constructor_symbol: [i64] = []
    enum_constructor_function: [i64] = []
    enum_constructor_provider: [text] = []
    enum_constructor_name: [text] = []
    enum_constructor_payload_kind: [i64] = []
    enum_constructor_has_discriminant: [bool] = []
    enum_constructor_discriminant: [i64] = []
    enum_constructor_payload_start: [i64] = []
    enum_constructor_payload_count: [i64] = []
    enum_constructor_span: [i64] = []

    enum_constructor_payload_count_total: i64 = 0
    enum_constructor_payload_capacity: i64 = 0
    enum_constructor_payload_owner: [i64] = []
    enum_constructor_payload_name: [text] = []
    enum_constructor_payload_type: [i64] = []
    enum_constructor_payload_span: [i64] = []

    active_kind: i64 = 0
    active_row: i64 = -1

    checkpoint_count: i64 = 0
    checkpoint_capacity: i64 = 0
    checkpoint_declarations: [i64] = []
    checkpoint_type_params: [i64] = []
    checkpoint_type_param_bounds: [i64] = []
    checkpoint_decorators: [i64] = []
    checkpoint_decorator_exprs: [i64] = []
    checkpoint_actor_fields: [i64] = []
    checkpoint_bitfield_fields: [i64] = []
    checkpoint_variants: [i64] = []
    checkpoint_payloads: [i64] = []
    checkpoint_extensions: [i64] = []
    checkpoint_schedule: [i64] = []
    checkpoint_constructors: [i64] = []
    checkpoint_constructor_payloads: [i64] = []
    checkpoint_active_kind: [i64] = []
    checkpoint_active_row: [i64] = []
    checkpoint_error: [bool] = []
    checkpoint_nominal_details: [i64] = []
    checkpoint_nominal_traits: [i64] = []
    checkpoint_nominal_fields: [i64] = []
    checkpoint_nominal_active: [i64] = []

    me begin(generation_value: i64) -> bool:
        if generation_value < 0: return false
        var old_schedule_row = 0
        while old_schedule_row < self.schedule_count:
            if self.schedule_domain[old_schedule_row] == HD_SCHEDULE_EXTENSION:
                val extension_row = self.schedule_receipt[old_schedule_row]
                if extension_row >= 0 and extension_row < self.enum_extension_schedule_row.len():
                    self.enum_extension_schedule_row[extension_row] = -1
            self.set_schedule_marker(self.schedule_domain[old_schedule_row],
                self.schedule_receipt[old_schedule_row], -1)
            old_schedule_row = old_schedule_row + 1
        self.nominal_detail_by_module = []
        self.declaration_by_module = []
        self.enum_variant_by_name = []
        self.enum_payload_by_name = []
        self.generation = generation_value
        self.frozen = false; self.error = false
        self.declaration_count = 0; self.type_param_count = 0; self.type_param_bound_count_total = 0
        self.decorator_count = 0; self.decorator_expr_count_total = 0
        self.actor_field_count_total = 0; self.bitfield_field_count_total = 0
        self.enum_variant_count_total = 0; self.enum_payload_count = 0
        self.enum_extension_count = 0; self.enum_constructor_count = 0
        self.nominal_detail_count = 0; self.nominal_trait_count_total = 0
        self.nominal_field_count_total = 0; self.nominal_active_row = -1
        self.schedule_count = 0
        self.enum_constructor_payload_count_total = 0
        self.active_kind = 0; self.active_row = -1; self.checkpoint_count = 0
        true

    me next_capacity(current: i64, required: i64) -> i64:
        var target = if current < 8: 8 else: current
        while target < required: target = target * 2
        target

    me ensure_declarations(required: i64):
        if required <= self.declaration_capacity: return
        val target = self.next_capacity(self.declaration_capacity, required)
        while self.declaration_ready.len() < target:
            self.declaration_ready.push(false); self.declaration_generation.push(-1)
            self.declaration_kind.push(0); self.declaration_module.push(-1); self.declaration_symbol.push(-1)
            self.declaration_name.push(""); self.declaration_visibility.push(-1)
            self.declaration_is_public.push(false); self.declaration_has_doc.push(false)
            self.declaration_doc.push(""); self.declaration_span.push(-1)
            self.declaration_type_param_start.push(-1); self.declaration_type_param_count.push(0)
            self.declaration_decorator_start.push(-1); self.declaration_decorator_count.push(0)
            self.actor_message_type.push(-1); self.actor_has_message_type.push(false)
            self.actor_mailbox_capacity.push(-1); self.actor_has_mailbox_capacity.push(false)
            self.actor_field_start.push(-1); self.actor_field_count.push(0)
            self.bitfield_storage_type.push(-1); self.bitfield_bit_width.push(0)
            self.bitfield_field_start.push(-1); self.bitfield_field_count.push(0)
            self.constant_type.push(-1); self.constant_has_type.push(false)
            self.constant_value.push(-1); self.constant_mutable.push(false); self.constant_volatile.push(false)
            self.constant_has_fixed_address.push(false); self.constant_fixed_address.push(0)
            self.enum_complete_open.push(false); self.enum_dynamic_open.push(false)
            self.enum_variant_start.push(-1); self.enum_variant_count.push(0)
        self.declaration_capacity = target

    me ensure_nominal_details(required: i64):
        if required <= self.nominal_detail_capacity: return
        val target = self.next_capacity(self.nominal_detail_capacity, required)
        while self.nominal_detail_ready.len() < target:
            self.nominal_detail_ready.push(false); self.nominal_detail_generation.push(-1)
            self.nominal_detail_kind.push(0); self.nominal_detail_module.push(-1)
            self.nominal_detail_symbol.push(-1); self.nominal_detail_has_base.push(false)
            self.nominal_detail_base_type.push(-1); self.nominal_detail_trait_start.push(-1)
            self.nominal_detail_trait_count.push(0); self.nominal_detail_field_start.push(-1)
            self.nominal_detail_field_count.push(0); self.nominal_detail_span.push(-1)
        self.nominal_detail_capacity = target

    me ensure_nominal_module_index(module_row: i64):
        while self.nominal_detail_by_module.len() <= module_row:
            val empty: Dict<i64, i64> = {}
            self.nominal_detail_by_module.push(empty)

    me ensure_declaration_module_index(module_row: i64):
        while self.declaration_by_module.len() <= module_row:
            val empty: Dict<i64, i64> = {}
            self.declaration_by_module.push(empty)

    me ensure_enum_declaration_index(required: i64):
        while self.enum_variant_by_name.len() < required:
            val empty: Dict<text, i64> = {}
            self.enum_variant_by_name.push(empty)

    me ensure_enum_variant_index(required: i64):
        while self.enum_payload_by_name.len() < required:
            val empty: Dict<text, i64> = {}
            self.enum_payload_by_name.push(empty)

    # Rollback is cold and may truncate children of a declaration created
    # before the checkpoint. Rebuilding once keeps all frozen hot lookups O(1)
    # without complicated partial-index journaling.
    me rebuild_enum_authority_indexes():
        self.declaration_by_module = []
        self.enum_variant_by_name = []
        self.enum_payload_by_name = []
        var declaration_row = 0
        while declaration_row < self.declaration_count:
            val module_row = self.declaration_module[declaration_row]
            self.ensure_declaration_module_index(module_row)
            self.ensure_enum_declaration_index(declaration_row + 1)
            self.declaration_by_module[module_row][self.declaration_symbol[declaration_row]] = declaration_row
            declaration_row = declaration_row + 1
        self.ensure_enum_variant_index(self.enum_variant_count_total)
        var variant_row = 0
        while variant_row < self.enum_variant_count_total:
            if self.enum_variant_owner_kind[variant_row] == HD_DECL_ENUM:
                val owner = self.enum_variant_owner[variant_row]
                self.enum_variant_by_name[owner][self.enum_variant_name[variant_row]] =
                    variant_row - self.enum_variant_start[owner]
            var payload_offset = 0
            while payload_offset < self.enum_variant_payload_count[variant_row]:
                val payload = self.enum_variant_payload_start[variant_row] + payload_offset
                val payload_name = self.enum_payload_name[payload]
                if payload_name != "":
                    self.enum_payload_by_name[variant_row][payload_name] = payload_offset
                payload_offset = payload_offset + 1
            variant_row = variant_row + 1

    me ensure_nominal_traits(required: i64):
        if required <= self.nominal_trait_capacity: return
        val target = self.next_capacity(self.nominal_trait_capacity, required)
        while self.nominal_trait_owner.len() < target:
            self.nominal_trait_owner.push(-1); self.nominal_trait_type.push(-1)
        self.nominal_trait_capacity = target

    me ensure_nominal_fields(required: i64):
        if required <= self.nominal_field_capacity: return
        val target = self.next_capacity(self.nominal_field_capacity, required)
        while self.nominal_field_owner.len() < target:
            self.nominal_field_owner.push(-1); self.nominal_field_symbol.push(-1)
            self.nominal_field_name.push(""); self.nominal_field_type.push(-1)
            self.nominal_field_visibility.push(-1); self.nominal_field_is_public.push(false)
            self.nominal_field_volatile.push(false); self.nominal_field_has_bits.push(false)
            self.nominal_field_bits.push(0); self.nominal_field_has_address.push(false)
            self.nominal_field_address.push(0); self.nominal_field_has_default.push(false)
            self.nominal_field_default.push(-1); self.nominal_field_span.push(-1)
        self.nominal_field_capacity = target

    me ensure_type_params(required: i64):
        if required <= self.type_param_capacity: return
        val target = self.next_capacity(self.type_param_capacity, required)
        while self.type_param_owner.len() < target:
            self.type_param_owner.push(-1); self.type_param_name.push(""); self.type_param_bound_type.push(-1)
            self.type_param_bound_start.push(-1); self.type_param_bound_count.push(0)
            self.type_param_has_default.push(false); self.type_param_default_type.push(-1); self.type_param_span.push(-1)
        self.type_param_capacity = target

    me ensure_type_param_bounds(required: i64):
        if required <= self.type_param_bound_capacity: return
        val target = self.next_capacity(self.type_param_bound_capacity, required)
        while self.type_param_bound_owner.len() < target:
            self.type_param_bound_owner.push(-1); self.type_param_bound_type_row.push(-1)
        self.type_param_bound_capacity = target

    me ensure_decorators(required: i64):
        if required <= self.decorator_capacity: return
        val target = self.next_capacity(self.decorator_capacity, required)
        while self.decorator_owner_kind.len() < target:
            self.decorator_owner_kind.push(0); self.decorator_owner_row.push(-1); self.decorator_name.push("")
            self.decorator_argument.push(""); self.decorator_expr_start.push(-1)
            self.decorator_expr_count.push(0); self.decorator_span.push(-1)
        self.decorator_capacity = target

    me ensure_decorator_exprs(required: i64):
        if required <= self.decorator_expr_capacity: return
        val target = self.next_capacity(self.decorator_expr_capacity, required)
        while self.decorator_expr_owner.len() < target:
            self.decorator_expr_owner.push(-1); self.decorator_expr_row.push(-1)
        self.decorator_expr_capacity = target

    me ensure_actor_fields(required: i64):
        if required <= self.actor_field_capacity: return
        val target = self.next_capacity(self.actor_field_capacity, required)
        while self.actor_field_owner.len() < target:
            self.actor_field_owner.push(-1); self.actor_field_symbol.push(-1); self.actor_field_name.push("")
            self.actor_field_type.push(-1); self.actor_field_visibility.push(-1); self.actor_field_is_public.push(false)
            self.actor_field_volatile.push(false); self.actor_field_has_bits.push(false); self.actor_field_bits.push(0)
            self.actor_field_has_fixed_address.push(false); self.actor_field_fixed_address.push(0)
            self.actor_field_has_default.push(false)
            self.actor_field_default.push(-1); self.actor_field_span.push(-1)
        self.actor_field_capacity = target

    me ensure_bitfield_fields(required: i64):
        if required <= self.bitfield_field_capacity: return
        val target = self.next_capacity(self.bitfield_field_capacity, required)
        while self.bitfield_field_owner.len() < target:
            self.bitfield_field_owner.push(-1); self.bitfield_field_symbol.push(-1); self.bitfield_field_name.push("")
            self.bitfield_field_has_type.push(false); self.bitfield_field_type.push(-1)
            self.bitfield_field_offset.push(-1); self.bitfield_field_width.push(0)
            self.bitfield_field_reserved.push(false); self.bitfield_field_has_source_bits.push(false)
            self.bitfield_field_source_bits.push(0); self.bitfield_field_span.push(-1)
        self.bitfield_field_capacity = target

    me ensure_variants(required: i64):
        if required <= self.enum_variant_capacity: return
        val target = self.next_capacity(self.enum_variant_capacity, required)
        while self.enum_variant_owner.len() < target:
            self.enum_variant_owner_kind.push(0); self.enum_variant_owner.push(-1); self.enum_variant_symbol.push(-1)
            self.enum_variant_name.push(""); self.enum_variant_payload_kind.push(0)
            self.enum_variant_payload_start.push(-1); self.enum_variant_payload_count.push(0)
            self.enum_variant_has_discriminant.push(false); self.enum_variant_discriminant.push(-1)
            self.enum_variant_decorator_start.push(-1); self.enum_variant_decorator_count.push(0)
            self.enum_variant_span.push(-1)
        self.enum_variant_capacity = target

    me ensure_payloads(required: i64):
        if required <= self.enum_payload_capacity: return
        val target = self.next_capacity(self.enum_payload_capacity, required)
        while self.enum_payload_variant.len() < target:
            self.enum_payload_variant.push(-1); self.enum_payload_ordinal.push(-1)
            self.enum_payload_name.push(""); self.enum_payload_type.push(-1); self.enum_payload_span.push(-1)
        self.enum_payload_capacity = target

    me ensure_extensions(required: i64):
        if required <= self.enum_extension_capacity: return
        val target = self.next_capacity(self.enum_extension_capacity, required)
        while self.enum_extension_ready.len() < target:
            self.enum_extension_ready.push(false); self.enum_extension_generation.push(-1)
            self.enum_extension_module.push(-1); self.enum_extension_target_module.push(-1)
            self.enum_extension_target_symbol.push(-1); self.enum_extension_target_name.push("")
            self.enum_extension_closure_kind.push(-1); self.enum_extension_closure.push("")
            self.enum_extension_variant_start.push(-1)
            self.enum_extension_variant_count.push(0); self.enum_extension_constructor_start.push(-1)
            self.enum_extension_constructor_count.push(0); self.enum_extension_decorator_start.push(-1)
            self.enum_extension_decorator_count.push(0); self.enum_extension_span.push(-1)
            self.enum_extension_source_ordinal.push(-1)
            self.enum_extension_schedule_row.push(-1)
        self.enum_extension_capacity = target

    me ensure_schedule(required: i64):
        if required <= self.schedule_capacity: return
        val target = self.next_capacity(self.schedule_capacity, required)
        while self.schedule_domain.len() < target:
            self.schedule_domain.push(0); self.schedule_receipt.push(-1)
            self.schedule_source_ordinal.push(-1); self.schedule_module.push(-1)
            self.schedule_source_kind.push(0); self.schedule_source_local_index.push(-1)
        self.schedule_capacity = target

    me ensure_schedule_marker(domain: i64, receipt: i64):
        if domain == HD_SCHEDULE_SYMBOL:
            while self.schedule_seen_symbol.len() <= receipt: self.schedule_seen_symbol.push(-1)
        elif domain == HD_SCHEDULE_FUNCTION:
            while self.schedule_seen_function.len() <= receipt: self.schedule_seen_function.push(-1)
        elif domain == HD_SCHEDULE_DECLARATION:
            while self.schedule_seen_declaration.len() <= receipt: self.schedule_seen_declaration.push(-1)
        elif domain == HD_SCHEDULE_IMPL:
            while self.schedule_seen_impl.len() <= receipt: self.schedule_seen_impl.push(-1)
        else:
            while self.schedule_seen_extension.len() <= receipt: self.schedule_seen_extension.push(-1)

    me schedule_marker_at(domain: i64, receipt: i64) -> i64:
        if domain == HD_SCHEDULE_SYMBOL and receipt < self.schedule_seen_symbol.len(): return self.schedule_seen_symbol[receipt]
        if domain == HD_SCHEDULE_FUNCTION and receipt < self.schedule_seen_function.len(): return self.schedule_seen_function[receipt]
        if domain == HD_SCHEDULE_DECLARATION and receipt < self.schedule_seen_declaration.len(): return self.schedule_seen_declaration[receipt]
        if domain == HD_SCHEDULE_IMPL and receipt < self.schedule_seen_impl.len(): return self.schedule_seen_impl[receipt]
        if domain == HD_SCHEDULE_EXTENSION and receipt < self.schedule_seen_extension.len(): return self.schedule_seen_extension[receipt]
        -1

    me set_schedule_marker(domain: i64, receipt: i64, row: i64):
        self.ensure_schedule_marker(domain, receipt)
        if domain == HD_SCHEDULE_SYMBOL: self.schedule_seen_symbol[receipt] = row
        elif domain == HD_SCHEDULE_FUNCTION: self.schedule_seen_function[receipt] = row
        elif domain == HD_SCHEDULE_DECLARATION: self.schedule_seen_declaration[receipt] = row
        elif domain == HD_SCHEDULE_IMPL: self.schedule_seen_impl[receipt] = row
        else: self.schedule_seen_extension[receipt] = row

    me ensure_constructors(required: i64):
        if required <= self.enum_constructor_capacity: return
        val target = self.next_capacity(self.enum_constructor_capacity, required)
        while self.enum_constructor_extension.len() < target:
            self.enum_constructor_extension.push(-1); self.enum_constructor_variant.push(-1)
            self.enum_constructor_symbol.push(-1); self.enum_constructor_function.push(-1)
            self.enum_constructor_provider.push(""); self.enum_constructor_name.push("")
            self.enum_constructor_payload_kind.push(HD_ENUM_PAYLOAD_NONE)
            self.enum_constructor_has_discriminant.push(false)
            self.enum_constructor_discriminant.push(-1)
            self.enum_constructor_payload_start.push(-1); self.enum_constructor_payload_count.push(0)
            self.enum_constructor_span.push(-1)
        self.enum_constructor_capacity = target

    me ensure_constructor_payloads(required: i64):
        if required <= self.enum_constructor_payload_capacity: return
        val target = self.next_capacity(self.enum_constructor_payload_capacity, required)
        while self.enum_constructor_payload_owner.len() < target:
            self.enum_constructor_payload_owner.push(-1); self.enum_constructor_payload_type.push(-1)
            self.enum_constructor_payload_name.push("")
            self.enum_constructor_payload_span.push(-1)
        self.enum_constructor_payload_capacity = target

    me ensure_checkpoints(required: i64):
        if required <= self.checkpoint_capacity: return
        val target = self.next_capacity(self.checkpoint_capacity, required)
        while self.checkpoint_declarations.len() < target:
            self.checkpoint_declarations.push(0); self.checkpoint_type_params.push(0)
            self.checkpoint_type_param_bounds.push(0)
            self.checkpoint_decorators.push(0); self.checkpoint_decorator_exprs.push(0)
            self.checkpoint_actor_fields.push(0)
            self.checkpoint_bitfield_fields.push(0); self.checkpoint_variants.push(0)
            self.checkpoint_payloads.push(0); self.checkpoint_extensions.push(0)
            self.checkpoint_constructors.push(0); self.checkpoint_constructor_payloads.push(0)
            self.checkpoint_schedule.push(0)
            self.checkpoint_active_kind.push(0)
            self.checkpoint_active_row.push(-1); self.checkpoint_error.push(false)
            self.checkpoint_nominal_details.push(0); self.checkpoint_nominal_traits.push(0)
            self.checkpoint_nominal_fields.push(0); self.checkpoint_nominal_active.push(-1)
        self.checkpoint_capacity = target

    me reserve_checkpoint() -> i64:
        if self.frozen: return -1
        val row = self.checkpoint_count; self.ensure_checkpoints(row + 1)
        self.checkpoint_declarations[row] = self.declaration_count
        self.checkpoint_type_params[row] = self.type_param_count
        self.checkpoint_type_param_bounds[row] = self.type_param_bound_count_total
        self.checkpoint_decorators[row] = self.decorator_count
        self.checkpoint_decorator_exprs[row] = self.decorator_expr_count_total
        self.checkpoint_actor_fields[row] = self.actor_field_count_total
        self.checkpoint_bitfield_fields[row] = self.bitfield_field_count_total
        self.checkpoint_variants[row] = self.enum_variant_count_total
        self.checkpoint_payloads[row] = self.enum_payload_count
        self.checkpoint_extensions[row] = self.enum_extension_count
        self.checkpoint_schedule[row] = self.schedule_count
        self.checkpoint_constructors[row] = self.enum_constructor_count
        self.checkpoint_constructor_payloads[row] = self.enum_constructor_payload_count_total
        self.checkpoint_nominal_details[row] = self.nominal_detail_count
        self.checkpoint_nominal_traits[row] = self.nominal_trait_count_total
        self.checkpoint_nominal_fields[row] = self.nominal_field_count_total
        self.checkpoint_nominal_active[row] = self.nominal_active_row
        self.checkpoint_active_kind[row] = self.active_kind; self.checkpoint_active_row[row] = self.active_row
        self.checkpoint_error[row] = self.error; self.checkpoint_count = row + 1; row

    me commit_checkpoint(row: i64) -> bool:
        if self.frozen or row < 0 or row + 1 != self.checkpoint_count: return false
        self.checkpoint_count = row; true

    me can_rollback_checkpoint(row: i64) -> bool:
        not self.frozen and row >= 0 and row + 1 == self.checkpoint_count

    me rollback_checkpoint(row: i64) -> bool:
        if not self.can_rollback_checkpoint(row): return false
        var schedule_row = self.checkpoint_schedule[row]
        while schedule_row < self.schedule_count:
            if self.schedule_domain[schedule_row] == HD_SCHEDULE_EXTENSION:
                val extension_row = self.schedule_receipt[schedule_row]
                if extension_row >= 0 and extension_row < self.enum_extension_schedule_row.len():
                    self.enum_extension_schedule_row[extension_row] = -1
            self.set_schedule_marker(self.schedule_domain[schedule_row],
                self.schedule_receipt[schedule_row], -1)
            schedule_row = schedule_row + 1
        var nominal_row = self.checkpoint_nominal_details[row]
        while nominal_row < self.nominal_detail_count:
            val module_row = self.nominal_detail_module[nominal_row]
            val symbol = self.nominal_detail_symbol[nominal_row]
            if (module_row >= 0 and module_row < self.nominal_detail_by_module.len() and
                    self.nominal_detail_by_module[module_row].contains_key(symbol) and
                    self.nominal_detail_by_module[module_row][symbol] == nominal_row):
                self.nominal_detail_by_module[module_row].remove(symbol)
            nominal_row = nominal_row + 1
        var declaration_row = self.checkpoint_declarations[row]
        while declaration_row < self.declaration_count:
            val module_row = self.declaration_module[declaration_row]
            val symbol = self.declaration_symbol[declaration_row]
            if (module_row >= 0 and module_row < self.declaration_by_module.len() and
                    self.declaration_by_module[module_row].contains_key(symbol) and
                    self.declaration_by_module[module_row][symbol] == declaration_row):
                self.declaration_by_module[module_row].remove(symbol)
            if declaration_row < self.enum_variant_by_name.len():
                val empty_variants: Dict<text, i64> = {}
                self.enum_variant_by_name[declaration_row] = empty_variants
            declaration_row = declaration_row + 1
        var variant_row = self.checkpoint_variants[row]
        while variant_row < self.enum_variant_count_total:
            if variant_row < self.enum_payload_by_name.len():
                val empty_payloads: Dict<text, i64> = {}
                self.enum_payload_by_name[variant_row] = empty_payloads
            variant_row = variant_row + 1
        self.declaration_count = self.checkpoint_declarations[row]
        self.type_param_count = self.checkpoint_type_params[row]
        self.type_param_bound_count_total = self.checkpoint_type_param_bounds[row]
        self.decorator_count = self.checkpoint_decorators[row]
        self.decorator_expr_count_total = self.checkpoint_decorator_exprs[row]
        self.actor_field_count_total = self.checkpoint_actor_fields[row]
        self.bitfield_field_count_total = self.checkpoint_bitfield_fields[row]
        self.enum_variant_count_total = self.checkpoint_variants[row]
        self.enum_payload_count = self.checkpoint_payloads[row]
        self.enum_extension_count = self.checkpoint_extensions[row]
        self.schedule_count = self.checkpoint_schedule[row]
        self.enum_constructor_count = self.checkpoint_constructors[row]
        self.enum_constructor_payload_count_total = self.checkpoint_constructor_payloads[row]
        self.nominal_detail_count = self.checkpoint_nominal_details[row]
        self.nominal_trait_count_total = self.checkpoint_nominal_traits[row]
        self.nominal_field_count_total = self.checkpoint_nominal_fields[row]
        self.nominal_active_row = self.checkpoint_nominal_active[row]
        self.active_kind = self.checkpoint_active_kind[row]; self.active_row = self.checkpoint_active_row[row]
        self.rebuild_enum_authority_indexes()
        self.error = self.checkpoint_error[row]; self.checkpoint_count = row; true

    me reserve_declaration(kind: i64, module_row: i64, symbol: i64, name: text,
            visibility: i64, span: i64) -> i64:
        if (self.frozen or self.error or self.active_kind != 0 or
                kind < HD_DECL_ACTOR or kind > HD_DECL_ENUM or module_row < 0 or
                symbol < 0 or name == "" or visibility < 0 or visibility > 5 or span < 0):
            self.error = true; return -1
        self.ensure_declaration_module_index(module_row)
        if self.declaration_by_module[module_row].contains_key(symbol):
            self.error = true; return -1
        val row = self.declaration_count; self.ensure_declarations(row + 1)
        self.ensure_enum_declaration_index(row + 1)
        self.declaration_ready[row] = false; self.declaration_generation[row] = self.generation
        self.declaration_kind[row] = kind; self.declaration_module[row] = module_row
        self.declaration_symbol[row] = symbol; self.declaration_name[row] = name
        self.declaration_visibility[row] = visibility; self.declaration_is_public[row] = visibility == 0
        self.declaration_has_doc[row] = false; self.declaration_doc[row] = ""; self.declaration_span[row] = span
        self.declaration_type_param_start[row] = self.type_param_count
        self.declaration_type_param_count[row] = 0
        self.declaration_decorator_start[row] = self.decorator_count
        self.declaration_decorator_count[row] = 0
        self.actor_message_type[row] = -1; self.actor_has_message_type[row] = false
        self.actor_mailbox_capacity[row] = -1; self.actor_has_mailbox_capacity[row] = false
        self.actor_field_start[row] = self.actor_field_count_total; self.actor_field_count[row] = 0
        self.bitfield_storage_type[row] = -1; self.bitfield_bit_width[row] = 0
        self.bitfield_field_start[row] = self.bitfield_field_count_total; self.bitfield_field_count[row] = 0
        self.constant_type[row] = -1; self.constant_has_type[row] = false
        self.constant_value[row] = -1; self.constant_mutable[row] = false; self.constant_volatile[row] = false
        self.constant_has_fixed_address[row] = false; self.constant_fixed_address[row] = 0
        self.enum_complete_open[row] = false; self.enum_dynamic_open[row] = false
        self.enum_variant_start[row] = self.enum_variant_count_total
        self.enum_variant_count[row] = 0
        self.declaration_count = row + 1
        self.declaration_by_module[module_row][symbol] = row
        self.active_kind = kind; self.active_row = row; row

    me append_type_param(name: text, bound_type: i64, has_default: bool,
            default_type: i64, span: i64) -> i64:
        if (self.frozen or self.error or self.active_row < 0 or name == "" or bound_type < -1 or
                (has_default and default_type < 0) or (not has_default and default_type != -1) or span < 0):
            self.error = true; return -1
        val row = self.type_param_count; self.ensure_type_params(row + 1)
        self.type_param_owner[row] = self.active_row; self.type_param_name[row] = name
        self.type_param_bound_type[row] = bound_type
        self.type_param_bound_start[row] = self.type_param_bound_count_total
        self.type_param_bound_count[row] = 0; self.type_param_has_default[row] = has_default
        self.type_param_default_type[row] = default_type; self.type_param_span[row] = span
        self.type_param_count = row + 1
        self.declaration_type_param_count[self.active_row] = self.declaration_type_param_count[self.active_row] + 1
        if bound_type >= 0:
            val bound_row = self.type_param_bound_count_total; self.ensure_type_param_bounds(bound_row + 1)
            self.type_param_bound_owner[bound_row] = row
            self.type_param_bound_type_row[bound_row] = bound_type
            self.type_param_bound_count_total = bound_row + 1
            self.type_param_bound_count[row] = 1
        row

    me append_type_param_bound(type_param_row: i64, bound_type: i64) -> i64:
        if (self.frozen or self.error or self.active_row < 0 or type_param_row < 0 or
                type_param_row >= self.type_param_count or self.type_param_owner[type_param_row] != self.active_row or
                self.type_param_bound_start[type_param_row] + self.type_param_bound_count[type_param_row] != self.type_param_bound_count_total or
                bound_type < 0):
            self.error = true; return -1
        val row = self.type_param_bound_count_total; self.ensure_type_param_bounds(row + 1)
        self.type_param_bound_owner[row] = type_param_row
        self.type_param_bound_type_row[row] = bound_type
        self.type_param_bound_count_total = row + 1
        self.type_param_bound_count[type_param_row] = self.type_param_bound_count[type_param_row] + 1
        row

    me append_decorator(name: text, argument: text, span: i64) -> i64:
        if self.frozen or self.error or self.active_row < 0 or name == "" or span < 0:
            self.error = true; return -1
        val row = self.decorator_count; self.ensure_decorators(row + 1)
        self.decorator_owner_kind[row] = self.active_kind; self.decorator_owner_row[row] = self.active_row
        self.decorator_name[row] = name; self.decorator_argument[row] = argument
        self.decorator_expr_start[row] = self.decorator_expr_count_total
        self.decorator_expr_count[row] = 0; self.decorator_span[row] = span
        self.decorator_count = row + 1
        if self.active_kind == HD_DECL_ACTOR or self.active_kind == HD_DECL_BITFIELD or self.active_kind == HD_DECL_CONSTANT or self.active_kind == HD_DECL_ENUM:
            self.declaration_decorator_count[self.active_row] = self.declaration_decorator_count[self.active_row] + 1
        else:
            self.enum_extension_decorator_count[self.active_row] = self.enum_extension_decorator_count[self.active_row] + 1
        row

    # Raw attributes are ordered and retained verbatim.  The decorator name is
    # kept as a compatibility alias for producers already using this store.
    me append_raw_attribute(name: text, argument: text, span: i64) -> i64:
        self.append_decorator(name, argument, span)

    me append_raw_attribute_expr(decorator_row: i64, expr_row: i64) -> i64:
        if (self.frozen or self.error or decorator_row < 0 or
                decorator_row >= self.decorator_count or expr_row < 0 or
                self.active_row < 0 or
                self.decorator_owner_kind[decorator_row] != self.active_kind or
                self.decorator_owner_row[decorator_row] != self.active_row or
                self.decorator_expr_start[decorator_row] +
                    self.decorator_expr_count[decorator_row] != self.decorator_expr_count_total):
            self.error = true; return -1
        val row = self.decorator_expr_count_total
        self.ensure_decorator_exprs(row + 1)
        self.decorator_expr_owner[row] = decorator_row
        self.decorator_expr_row[row] = expr_row
        self.decorator_expr_count_total = row + 1
        self.decorator_expr_count[decorator_row] = self.decorator_expr_count[decorator_row] + 1
        row

    me append_schedule(domain: i64, receipt: i64, source_ordinal: i64,
            module_row: i64, source_kind: i64, source_local_index: i64) -> i64:
        if (self.frozen or self.error or self.active_kind != 0 or
                domain < HD_SCHEDULE_SYMBOL or domain > HD_SCHEDULE_EXTENSION or
                receipt < 0 or source_ordinal < 0 or module_row < 0 or
                source_kind <= 0 or source_kind > 11 or source_local_index < 0 or
                self.schedule_marker_at(domain, receipt) >= 0):
            self.error = true; return -1
        if self.schedule_count > 0:
            val previous = self.schedule_count - 1
            val previous_module = self.schedule_module[previous]
            if (module_row < previous_module or
                    (module_row == previous_module and
                        source_ordinal < self.schedule_source_ordinal[previous])):
                self.error = true; return -1
        val row = self.schedule_count; self.ensure_schedule(row + 1)
        self.schedule_domain[row] = domain; self.schedule_receipt[row] = receipt
        self.schedule_source_ordinal[row] = source_ordinal
        self.schedule_module[row] = module_row; self.schedule_source_kind[row] = source_kind
        self.schedule_source_local_index[row] = source_local_index
        self.set_schedule_marker(domain, receipt, row)
        if domain == HD_SCHEDULE_EXTENSION:
            self.enum_extension_schedule_row[receipt] = row
        self.schedule_count = row + 1; row

    me set_declaration_surface(is_public: bool, has_doc: bool, doc: text) -> bool:
        if (self.frozen or self.error or self.active_row < 0 or
                is_public != (self.declaration_visibility[self.active_row] == 0) or
                (has_doc and doc == "") or (not has_doc and doc != "")):
            self.error = true; return false
        self.declaration_is_public[self.active_row] = is_public
        self.declaration_has_doc[self.active_row] = has_doc; self.declaration_doc[self.active_row] = doc; true

    me append_enum_variant_decorator(variant_row: i64, name: text, argument: text, span: i64) -> i64:
        if (self.frozen or self.error or variant_row < 0 or variant_row >= self.enum_variant_count_total or
                self.enum_variant_owner_kind[variant_row] != self.active_kind or
                self.enum_variant_owner[variant_row] != self.active_row or name == "" or span < 0):
            self.error = true; return -1
        if self.enum_variant_decorator_start[variant_row] + self.enum_variant_decorator_count[variant_row] != self.decorator_count:
            self.error = true; return -1
        val row = self.decorator_count; self.ensure_decorators(row + 1)
        self.decorator_owner_kind[row] = HD_DECORATOR_OWNER_ENUM_VARIANT
        self.decorator_owner_row[row] = variant_row; self.decorator_name[row] = name
        self.decorator_argument[row] = argument
        self.decorator_expr_start[row] = self.decorator_expr_count_total
        self.decorator_expr_count[row] = 0; self.decorator_span[row] = span
        self.decorator_count = row + 1
        self.enum_variant_decorator_count[variant_row] = self.enum_variant_decorator_count[variant_row] + 1; row

    me append_actor_field(symbol: i64, name: text, type_row: i64, has_default: bool,
            default_expr: i64, span: i64) -> i64:
        self.append_actor_field_full(symbol, name, type_row, has_default, default_expr,
            1, false, false, false, 0, false, 0, span)

    me append_actor_field_full(symbol: i64, name: text, type_row: i64, has_default: bool,
            default_expr: i64, visibility: i64, is_public: bool, volatile_value: bool,
            has_bits: bool, bits: i64, has_address: bool, address: i64, span: i64) -> i64:
        if (self.frozen or self.error or self.active_kind != HD_DECL_ACTOR or symbol < 0 or name == "" or
                type_row < 0 or visibility < 0 or visibility > 5 or is_public != (visibility == 0) or
                (has_default and default_expr < 0) or (not has_default and default_expr != -1) or
                (has_bits and bits <= 0) or (not has_bits and bits != 0) or
                (has_address and address < 0) or (not has_address and address != 0) or span < 0):
            self.error = true; return -1
        val row = self.actor_field_count_total; self.ensure_actor_fields(row + 1)
        self.actor_field_owner[row] = self.active_row; self.actor_field_symbol[row] = symbol
        self.actor_field_name[row] = name; self.actor_field_type[row] = type_row
        self.actor_field_visibility[row] = visibility; self.actor_field_is_public[row] = is_public
        self.actor_field_volatile[row] = volatile_value; self.actor_field_has_bits[row] = has_bits
        self.actor_field_bits[row] = bits; self.actor_field_has_fixed_address[row] = has_address
        self.actor_field_fixed_address[row] = address
        self.actor_field_has_default[row] = has_default; self.actor_field_default[row] = default_expr
        self.actor_field_span[row] = span; self.actor_field_count_total = row + 1
        self.actor_field_count[self.active_row] = self.actor_field_count[self.active_row] + 1; row

    me append_bitfield_field(symbol: i64, name: text, type_row: i64, bit_offset: i64,
            bit_width: i64, signed_value: bool, span: i64) -> i64:
        self.append_bitfield_field_full(symbol, name, true, type_row, signed_value,
            true, bit_width, bit_offset, bit_width, span)

    me append_bitfield_field_full(symbol: i64, name: text, has_type: bool, type_row: i64,
            reserved_value: bool, has_source_bits: bool, source_bits: i64,
            bit_offset: i64, bit_width: i64, span: i64) -> i64:
        if (self.frozen or self.error or self.active_kind != HD_DECL_BITFIELD or symbol < 0 or name == "" or
                (has_type and type_row < 0) or (not has_type and type_row != -1) or bit_offset < 0 or
                bit_width <= 0 or (has_source_bits and source_bits <= 0) or
                (not has_source_bits and source_bits != 0) or span < 0):
            self.error = true; return -1
        val row = self.bitfield_field_count_total; self.ensure_bitfield_fields(row + 1)
        if self.bitfield_field_count[self.active_row] > 0:
            val previous = row - 1
            if self.bitfield_field_offset[previous] + self.bitfield_field_width[previous] > bit_offset:
                self.error = true; return -1
        self.bitfield_field_owner[row] = self.active_row; self.bitfield_field_symbol[row] = symbol
        self.bitfield_field_name[row] = name; self.bitfield_field_has_type[row] = has_type
        self.bitfield_field_type[row] = type_row
        self.bitfield_field_offset[row] = bit_offset; self.bitfield_field_width[row] = bit_width
        self.bitfield_field_reserved[row] = reserved_value
        self.bitfield_field_has_source_bits[row] = has_source_bits
        self.bitfield_field_source_bits[row] = source_bits; self.bitfield_field_span[row] = span
        self.bitfield_field_count_total = row + 1
        self.bitfield_field_count[self.active_row] = self.bitfield_field_count[self.active_row] + 1; row

    me append_enum_variant(symbol: i64, name: text, payload_kind: i64,
            has_discriminant: bool, discriminant_expr: i64, span: i64) -> i64:
        if (self.frozen or self.error or (self.active_kind != HD_DECL_ENUM and self.active_kind != HD_DECL_ENUM_EXTENSION) or
                symbol < 0 or name == "" or payload_kind < HD_ENUM_PAYLOAD_NONE or
                payload_kind > HD_ENUM_PAYLOAD_STRUCT or (has_discriminant and discriminant_expr < 0) or
                (not has_discriminant and discriminant_expr != -1) or span < 0):
            self.error = true; return -1
        if self.active_kind == HD_DECL_ENUM and
                self.enum_variant_by_name[self.active_row].contains_key(name):
            self.error = true; return -1
        val row = self.enum_variant_count_total; self.ensure_variants(row + 1)
        self.ensure_enum_variant_index(row + 1)
        self.enum_variant_owner_kind[row] = self.active_kind; self.enum_variant_owner[row] = self.active_row
        self.enum_variant_symbol[row] = symbol; self.enum_variant_name[row] = name
        self.enum_variant_payload_kind[row] = payload_kind; self.enum_variant_payload_start[row] = self.enum_payload_count
        self.enum_variant_payload_count[row] = 0; self.enum_variant_has_discriminant[row] = has_discriminant
        self.enum_variant_discriminant[row] = discriminant_expr
        self.enum_variant_decorator_start[row] = self.decorator_count; self.enum_variant_decorator_count[row] = 0
        self.enum_variant_span[row] = span; self.enum_variant_count_total = row + 1
        if self.active_kind == HD_DECL_ENUM:
            self.enum_variant_count[self.active_row] = self.enum_variant_count[self.active_row] + 1
            self.enum_variant_by_name[self.active_row][name] =
                self.enum_variant_count[self.active_row] - 1
        else:
            self.enum_extension_variant_count[self.active_row] = self.enum_extension_variant_count[self.active_row] + 1
        row

    me append_enum_payload(variant_row: i64, name: text, type_row: i64, span: i64) -> i64:
        if (self.frozen or self.error or variant_row < 0 or variant_row >= self.enum_variant_count_total or
                self.enum_variant_owner_kind[variant_row] != self.active_kind or self.enum_variant_owner[variant_row] != self.active_row or
                self.enum_variant_payload_kind[variant_row] == HD_ENUM_PAYLOAD_NONE or type_row < 0 or span < 0):
            self.error = true; return -1
        if self.enum_variant_payload_kind[variant_row] == HD_ENUM_PAYLOAD_TUPLE and name != "": self.error = true; return -1
        if self.enum_variant_payload_kind[variant_row] == HD_ENUM_PAYLOAD_STRUCT and name == "": self.error = true; return -1
        if name != "" and self.enum_payload_by_name[variant_row].contains_key(name):
            self.error = true; return -1
        val row = self.enum_payload_count; self.ensure_payloads(row + 1)
        if self.enum_variant_payload_start[variant_row] + self.enum_variant_payload_count[variant_row] != row:
            self.error = true; return -1
        self.enum_payload_variant[row] = variant_row
        self.enum_payload_ordinal[row] = self.enum_variant_payload_count[variant_row]
        self.enum_payload_name[row] = name; self.enum_payload_type[row] = type_row; self.enum_payload_span[row] = span
        self.enum_payload_count = row + 1
        self.enum_variant_payload_count[variant_row] = self.enum_variant_payload_count[variant_row] + 1
        if name != "":
            self.enum_payload_by_name[variant_row][name] =
                self.enum_variant_payload_count[variant_row] - 1
        row

    me finalize_actor_full(has_message_type: bool, message_type: i64,
            has_mailbox_capacity: bool, mailbox_capacity: i64) -> bool:
        if (self.active_kind != HD_DECL_ACTOR or
            (has_message_type and message_type < 0) or
            (not has_message_type and message_type != -1) or
            (has_mailbox_capacity and mailbox_capacity < 0) or
            (not has_mailbox_capacity and mailbox_capacity != -1)):
            self.error = true; return false
        self.actor_has_message_type[self.active_row] = has_message_type
        self.actor_message_type[self.active_row] = message_type
        self.actor_has_mailbox_capacity[self.active_row] = has_mailbox_capacity
        self.actor_mailbox_capacity[self.active_row] = mailbox_capacity
        self.finalize_declaration()

    me finalize_actor(message_type: i64, mailbox_capacity: i64) -> bool:
        self.finalize_actor_full(true, message_type, true, mailbox_capacity)

    me finalize_bitfield(storage_type: i64, bit_width: i64) -> bool:
        if self.active_kind != HD_DECL_BITFIELD or storage_type < 0 or bit_width <= 0: self.error = true; return false
        var i = self.bitfield_field_start[self.active_row]
        val stop = i + self.bitfield_field_count[self.active_row]
        while i < stop:
            if self.bitfield_field_offset[i] + self.bitfield_field_width[i] > bit_width: self.error = true; return false
            i = i + 1
        self.bitfield_storage_type[self.active_row] = storage_type; self.bitfield_bit_width[self.active_row] = bit_width
        self.finalize_declaration()

    me finalize_constant(has_type: bool, type_row: i64, value_expr: i64, mutable_value: bool) -> bool:
        self.finalize_constant_full(has_type, type_row, value_expr, mutable_value, false, false, 0)

    me finalize_constant_full(has_type: bool, type_row: i64, value_expr: i64,
            mutable_value: bool, volatile_value: bool, has_address: bool, address: i64) -> bool:
        if (self.active_kind != HD_DECL_CONSTANT or (has_type and type_row < 0) or
                (not has_type and type_row != -1) or value_expr < 0 or
                (has_address and address < 0) or (not has_address and address != 0)):
            self.error = true; return false
        self.constant_has_type[self.active_row] = has_type; self.constant_type[self.active_row] = type_row
        self.constant_value[self.active_row] = value_expr
        self.constant_mutable[self.active_row] = mutable_value; self.constant_volatile[self.active_row] = volatile_value
        self.constant_has_fixed_address[self.active_row] = has_address
        self.constant_fixed_address[self.active_row] = address; self.finalize_declaration()

    me finalize_enum(complete_open: bool, dynamic_open: bool) -> bool:
        if self.active_kind != HD_DECL_ENUM: self.error = true; return false
        self.enum_complete_open[self.active_row] = complete_open
        self.enum_dynamic_open[self.active_row] = dynamic_open; self.finalize_declaration()

    me finalize_declaration() -> bool:
        if self.frozen or self.error or self.active_row < 0 or self.active_row >= self.declaration_count: return false
        self.declaration_ready[self.active_row] = true; self.active_kind = 0; self.active_row = -1; true

    me reserve_enum_extension(module_row: i64, target_module: i64, target_symbol: i64, span: i64) -> i64:
        if (self.frozen or self.error or self.active_kind != 0 or module_row < 0 or
                target_module < 0 or target_symbol < 0 or span < 0):
            self.error = true; return -1
        val row = self.enum_extension_count; self.ensure_extensions(row + 1)
        self.enum_extension_ready[row] = false; self.enum_extension_generation[row] = self.generation
        self.enum_extension_module[row] = module_row; self.enum_extension_target_module[row] = target_module
        self.enum_extension_target_symbol[row] = target_symbol; self.enum_extension_target_name[row] = ""
        self.enum_extension_source_ordinal[row] = row
        self.enum_extension_schedule_row[row] = -1
        self.enum_extension_closure_kind[row] = 0; self.enum_extension_closure[row] = ""
        self.enum_extension_variant_start[row] = self.enum_variant_count_total; self.enum_extension_variant_count[row] = 0
        self.enum_extension_constructor_start[row] = self.enum_constructor_count; self.enum_extension_constructor_count[row] = 0
        self.enum_extension_decorator_start[row] = self.decorator_count; self.enum_extension_decorator_count[row] = 0
        self.enum_extension_span[row] = span; self.enum_extension_count = row + 1
        self.active_kind = HD_DECL_ENUM_EXTENSION; self.active_row = row; row

    me reserve_enum_extension_full(module_row: i64, target_name: text, closure: text,
            source_ordinal: i64, span: i64) -> i64:
        if (self.frozen or self.error or self.active_kind != 0 or module_row < 0 or target_name == "" or
                (closure != "complete" and closure != "dyn") or
                source_ordinal < 0 or span < 0):
            self.error = true; return -1
        val row = self.enum_extension_count; self.ensure_extensions(row + 1)
        self.enum_extension_ready[row] = false; self.enum_extension_generation[row] = self.generation
        self.enum_extension_module[row] = module_row; self.enum_extension_target_module[row] = -1
        self.enum_extension_target_symbol[row] = -1; self.enum_extension_target_name[row] = target_name
        self.enum_extension_closure_kind[row] = if closure == "complete": 0 else: 1
        self.enum_extension_closure[row] = closure
        self.enum_extension_source_ordinal[row] = source_ordinal
        self.enum_extension_schedule_row[row] = -1
        self.enum_extension_variant_start[row] = self.enum_variant_count_total; self.enum_extension_variant_count[row] = 0
        self.enum_extension_constructor_start[row] = self.enum_constructor_count; self.enum_extension_constructor_count[row] = 0
        self.enum_extension_decorator_start[row] = self.decorator_count; self.enum_extension_decorator_count[row] = 0
        self.enum_extension_span[row] = span; self.enum_extension_count = row + 1
        self.active_kind = HD_DECL_ENUM_EXTENSION; self.active_row = row; row

    me set_enum_extension_closure(closure_kind: i64) -> bool:
        if self.frozen or self.error or self.active_kind != HD_DECL_ENUM_EXTENSION or closure_kind < 0:
            self.error = true; return false
        self.enum_extension_closure_kind[self.active_row] = closure_kind
        self.enum_extension_closure[self.active_row] = if closure_kind == 0: "complete" else: "dyn"; true

    me append_enum_constructor(variant_row: i64, symbol: i64, function_row: i64, span: i64) -> i64:
        if (self.frozen or self.error or self.active_kind != HD_DECL_ENUM_EXTENSION or variant_row < 0 or
                variant_row >= self.enum_variant_count_total or self.enum_variant_owner_kind[variant_row] != HD_DECL_ENUM_EXTENSION or
                self.enum_variant_owner[variant_row] != self.active_row or symbol < 0 or function_row < 0 or span < 0):
            self.error = true; return -1
        val row = self.enum_constructor_count; self.ensure_constructors(row + 1)
        self.enum_constructor_extension[row] = self.active_row; self.enum_constructor_variant[row] = variant_row
        self.enum_constructor_symbol[row] = symbol; self.enum_constructor_function[row] = function_row
        self.enum_constructor_provider[row] = ""; self.enum_constructor_name[row] = ""
        self.enum_constructor_payload_kind[row] = self.enum_variant_payload_kind[variant_row]
        self.enum_constructor_has_discriminant[row] = self.enum_variant_has_discriminant[variant_row]
        self.enum_constructor_discriminant[row] = self.enum_variant_discriminant[variant_row]
        self.enum_constructor_payload_start[row] = self.enum_constructor_payload_count_total
        self.enum_constructor_payload_count[row] = 0
        self.enum_constructor_span[row] = span; self.enum_constructor_count = row + 1
        self.enum_extension_constructor_count[self.active_row] = self.enum_extension_constructor_count[self.active_row] + 1; row

    me append_enum_constructor_full(provider: text, name: text, payload_kind: i64,
            has_discriminant: bool, discriminant_expr: i64, span: i64) -> i64:
        if (self.frozen or self.error or self.active_kind != HD_DECL_ENUM_EXTENSION or
                provider == "" or name == "" or
                payload_kind < HD_ENUM_PAYLOAD_NONE or payload_kind > HD_ENUM_PAYLOAD_STRUCT or
                (has_discriminant and discriminant_expr < 0) or
                (not has_discriminant and discriminant_expr != -1) or span < 0):
            self.error = true; return -1
        val row = self.enum_constructor_count; self.ensure_constructors(row + 1)
        self.enum_constructor_extension[row] = self.active_row; self.enum_constructor_variant[row] = -1
        self.enum_constructor_symbol[row] = -1; self.enum_constructor_function[row] = -1
        self.enum_constructor_provider[row] = provider; self.enum_constructor_name[row] = name
        self.enum_constructor_payload_kind[row] = payload_kind
        self.enum_constructor_has_discriminant[row] = has_discriminant
        self.enum_constructor_discriminant[row] = discriminant_expr
        self.enum_constructor_payload_start[row] = self.enum_constructor_payload_count_total
        self.enum_constructor_payload_count[row] = 0; self.enum_constructor_span[row] = span
        self.enum_constructor_count = row + 1
        self.enum_extension_constructor_count[self.active_row] = self.enum_extension_constructor_count[self.active_row] + 1; row

    me append_enum_constructor_payload(constructor_row: i64, name: text,
            type_row: i64, span: i64) -> i64:
        if (self.frozen or self.error or self.active_kind != HD_DECL_ENUM_EXTENSION or constructor_row < 0 or
                constructor_row >= self.enum_constructor_count or self.enum_constructor_extension[constructor_row] != self.active_row or
                self.enum_constructor_payload_start[constructor_row] + self.enum_constructor_payload_count[constructor_row] != self.enum_constructor_payload_count_total or
                self.enum_constructor_payload_kind[constructor_row] == HD_ENUM_PAYLOAD_NONE or
                type_row < 0 or span < 0):
            self.error = true; return -1
        if (self.enum_constructor_payload_kind[constructor_row] == HD_ENUM_PAYLOAD_TUPLE and
                name != ""):
            self.error = true; return -1
        if (self.enum_constructor_payload_kind[constructor_row] == HD_ENUM_PAYLOAD_STRUCT and
                name == ""):
            self.error = true; return -1
        val row = self.enum_constructor_payload_count_total; self.ensure_constructor_payloads(row + 1)
        self.enum_constructor_payload_owner[row] = constructor_row
        self.enum_constructor_payload_name[row] = name
        self.enum_constructor_payload_type[row] = type_row; self.enum_constructor_payload_span[row] = span
        self.enum_constructor_payload_count_total = row + 1
        self.enum_constructor_payload_count[constructor_row] = self.enum_constructor_payload_count[constructor_row] + 1; row

    me finalize_enum_extension() -> bool:
        if (self.frozen or self.error or self.active_kind != HD_DECL_ENUM_EXTENSION or
                self.enum_extension_closure_kind[self.active_row] < 0): return false
        self.enum_extension_ready[self.active_row] = true; self.active_kind = 0; self.active_row = -1; true

    me reserve_nominal_detail(kind: i64, module_row: i64, symbol: i64,
            has_base: bool, base_type: i64, span: i64) -> i64:
        if (self.frozen or self.error or self.nominal_active_row >= 0 or
                (kind != HD_NOMINAL_CLASS and kind != HD_NOMINAL_STRUCT) or
                module_row < 0 or symbol < 0 or
                (has_base and base_type < 0) or (not has_base and base_type != -1) or span < 0):
            self.error = true; return -1
        self.ensure_nominal_module_index(module_row)
        if self.nominal_detail_by_module[module_row].contains_key(symbol):
            self.error = true; return -1
        val row = self.nominal_detail_count; self.ensure_nominal_details(row + 1)
        self.nominal_detail_ready[row] = false
        self.nominal_detail_generation[row] = self.generation
        self.nominal_detail_kind[row] = kind; self.nominal_detail_module[row] = module_row
        self.nominal_detail_symbol[row] = symbol; self.nominal_detail_has_base[row] = has_base
        self.nominal_detail_base_type[row] = base_type
        self.nominal_detail_trait_start[row] = self.nominal_trait_count_total
        self.nominal_detail_trait_count[row] = 0
        self.nominal_detail_field_start[row] = self.nominal_field_count_total
        self.nominal_detail_field_count[row] = 0; self.nominal_detail_span[row] = span
        self.nominal_detail_count = row + 1; self.nominal_active_row = row
        self.nominal_detail_by_module[module_row][symbol] = row; row

    me append_nominal_trait(type_row: i64) -> i64:
        if self.frozen or self.error or self.nominal_active_row < 0 or type_row < 0:
            self.error = true; return -1
        val row = self.nominal_trait_count_total; self.ensure_nominal_traits(row + 1)
        self.nominal_trait_owner[row] = self.nominal_active_row
        self.nominal_trait_type[row] = type_row; self.nominal_trait_count_total = row + 1
        self.nominal_detail_trait_count[self.nominal_active_row] =
            self.nominal_detail_trait_count[self.nominal_active_row] + 1
        row

    me append_nominal_field(symbol: i64, name: text, type_row: i64,
            visibility: i64, is_public: bool, volatile_value: bool,
            has_bits: bool, bits: i64, has_address: bool, address: i64,
            has_default: bool, default_expr: i64, span: i64) -> i64:
        if (self.frozen or self.error or self.nominal_active_row < 0 or symbol < 0 or
                name == "" or type_row < 0 or visibility < 0 or visibility > 5 or
                is_public != (visibility == 0) or (has_bits and bits <= 0) or
                (not has_bits and bits != 0) or (has_address and address < 0) or
                (not has_address and address != 0) or
                (has_default and default_expr < 0) or
                (not has_default and default_expr != -1) or span < 0):
            self.error = true; return -1
        val row = self.nominal_field_count_total; self.ensure_nominal_fields(row + 1)
        self.nominal_field_owner[row] = self.nominal_active_row
        self.nominal_field_symbol[row] = symbol; self.nominal_field_name[row] = name
        self.nominal_field_type[row] = type_row; self.nominal_field_visibility[row] = visibility
        self.nominal_field_is_public[row] = is_public; self.nominal_field_volatile[row] = volatile_value
        self.nominal_field_has_bits[row] = has_bits; self.nominal_field_bits[row] = bits
        self.nominal_field_has_address[row] = has_address; self.nominal_field_address[row] = address
        self.nominal_field_has_default[row] = has_default; self.nominal_field_default[row] = default_expr
        self.nominal_field_span[row] = span; self.nominal_field_count_total = row + 1
        self.nominal_detail_field_count[self.nominal_active_row] =
            self.nominal_detail_field_count[self.nominal_active_row] + 1
        row

    me finalize_nominal_detail() -> bool:
        if self.frozen or self.error or self.nominal_active_row < 0: return false
        self.nominal_detail_ready[self.nominal_active_row] = true
        self.nominal_active_row = -1; true

    me nominal_detail_valid(row: i64, generation_value: i64) -> bool:
        (self.frozen and generation_value == self.generation and row >= 0 and
            row < self.nominal_detail_count and self.nominal_detail_ready[row] and
            self.nominal_detail_generation[row] == generation_value)

    me nominal_detail_count_at(generation_value: i64) -> i64:
        if not self.frozen or generation_value != self.generation: return -1
        self.nominal_detail_count

    me nominal_detail_lookup_at(module_row: i64, symbol: i64,
            generation_value: i64) -> i64:
        if (not self.frozen or generation_value != self.generation or
                module_row < 0 or symbol < 0 or
                module_row >= self.nominal_detail_by_module.len() or
                not self.nominal_detail_by_module[module_row].contains_key(symbol)):
            return -1
        val row = self.nominal_detail_by_module[module_row][symbol]
        if (not self.nominal_detail_valid(row, generation_value) or
                self.nominal_detail_module[row] != module_row or
                self.nominal_detail_symbol[row] != symbol):
            return -1
        row

    me nominal_detail_i64_at(row: i64, generation_value: i64, column: i64) -> i64:
        if not self.nominal_detail_valid(row, generation_value): return -1
        if column == 0: return self.nominal_detail_kind[row]
        if column == 1: return self.nominal_detail_module[row]
        if column == 2: return self.nominal_detail_symbol[row]
        if column == 3: return self.nominal_detail_base_type[row]
        if column == 4: return self.nominal_detail_span[row]
        -1

    me nominal_detail_has_base_at(row: i64, generation_value: i64) -> bool:
        self.nominal_detail_valid(row, generation_value) and self.nominal_detail_has_base[row]

    me nominal_trait_range_start_at(row: i64, generation_value: i64) -> i64:
        if not self.nominal_detail_valid(row, generation_value): return -1
        self.nominal_detail_trait_start[row]

    me nominal_trait_range_len_at(row: i64, generation_value: i64) -> i64:
        if not self.nominal_detail_valid(row, generation_value): return -1
        self.nominal_detail_trait_count[row]

    me nominal_trait_at(row: i64, generation_value: i64, ordinal: i64) -> i64:
        val start = self.nominal_trait_range_start_at(row, generation_value)
        val count = self.nominal_trait_range_len_at(row, generation_value)
        if start < 0 or ordinal < 0 or ordinal >= count: return -1
        self.nominal_trait_type[start + ordinal]

    me nominal_field_range_start_at(row: i64, generation_value: i64) -> i64:
        if not self.nominal_detail_valid(row, generation_value): return -1
        self.nominal_detail_field_start[row]

    me nominal_field_range_len_at(row: i64, generation_value: i64) -> i64:
        if not self.nominal_detail_valid(row, generation_value): return -1
        self.nominal_detail_field_count[row]

    me nominal_field_name_at(row: i64, generation_value: i64, ordinal: i64) -> text:
        val start = self.nominal_field_range_start_at(row, generation_value)
        val count = self.nominal_field_range_len_at(row, generation_value)
        if start < 0 or ordinal < 0 or ordinal >= count: return ""
        self.nominal_field_name[start + ordinal]

    me nominal_field_i64_at(row: i64, generation_value: i64, ordinal: i64,
            column: i64) -> i64:
        val start = self.nominal_field_range_start_at(row, generation_value)
        val count = self.nominal_field_range_len_at(row, generation_value)
        if start < 0 or ordinal < 0 or ordinal >= count: return -1
        val field = start + ordinal
        if column == 0: return self.nominal_field_symbol[field]
        if column == 1: return self.nominal_field_type[field]
        if column == 2: return self.nominal_field_visibility[field]
        if column == 3: return self.nominal_field_bits[field]
        if column == 4: return self.nominal_field_address[field]
        if column == 5: return self.nominal_field_default[field]
        if column == 6: return self.nominal_field_span[field]
        -1

    me nominal_field_bool_at(row: i64, generation_value: i64, ordinal: i64,
            column: i64) -> bool:
        val start = self.nominal_field_range_start_at(row, generation_value)
        val count = self.nominal_field_range_len_at(row, generation_value)
        if start < 0 or ordinal < 0 or ordinal >= count: return false
        val field = start + ordinal
        if column == 0: return self.nominal_field_is_public[field]
        if column == 1: return self.nominal_field_volatile[field]
        if column == 2: return self.nominal_field_has_bits[field]
        if column == 3: return self.nominal_field_has_address[field]
        if column == 4: return self.nominal_field_has_default[field]
        false

    me declaration_valid(row: i64, generation_value: i64) -> bool:
        self.frozen and generation_value == self.generation and row >= 0 and row < self.declaration_count and self.declaration_ready[row] and self.declaration_generation[row] == generation_value

    me declaration_count_at(generation_value: i64) -> i64:
        if not self.frozen or generation_value != self.generation: return -1
        self.declaration_count

    me declaration_i64_at(row: i64, generation_value: i64, column: i64) -> i64:
        if not self.declaration_valid(row, generation_value): return -1
        if column == 0: return self.declaration_kind[row]
        if column == 1: return self.declaration_module[row]
        if column == 2: return self.declaration_symbol[row]
        if column == 3: return self.declaration_visibility[row]
        if column == 4: return self.declaration_span[row]
        if column == 5: return self.declaration_type_param_start[row]
        if column == 6: return self.declaration_type_param_count[row]
        if column == 7 and self.declaration_kind[row] == HD_DECL_ACTOR:
            return self.actor_message_type[row]
        if column == 8 and self.declaration_kind[row] == HD_DECL_ACTOR:
            return self.actor_mailbox_capacity[row]
        -1

    me declaration_name_at(row: i64, generation_value: i64) -> text:
        if not self.declaration_valid(row, generation_value): return ""
        self.declaration_name[row]

    me declaration_bool_at(row: i64, generation_value: i64, column: i64) -> bool:
        if not self.declaration_valid(row, generation_value): return false
        if column == 0: return self.declaration_is_public[row]
        if column == 1: return self.declaration_has_doc[row]
        if column == 2 and self.declaration_kind[row] == HD_DECL_ACTOR:
            return self.actor_has_message_type[row]
        if column == 3 and self.declaration_kind[row] == HD_DECL_ACTOR:
            return self.actor_has_mailbox_capacity[row]
        false

    me actor_i64_at(row: i64, generation_value: i64, column: i64) -> i64:
        if (not self.declaration_valid(row, generation_value) or
            self.declaration_kind[row] != HD_DECL_ACTOR):
            return -1
        if column == 0: return self.actor_message_type[row]
        if column == 1: return self.actor_mailbox_capacity[row]
        -1

    me actor_bool_at(row: i64, generation_value: i64, column: i64) -> bool:
        if (not self.declaration_valid(row, generation_value) or
            self.declaration_kind[row] != HD_DECL_ACTOR):
            return false
        if column == 0: return self.actor_has_message_type[row]
        if column == 1: return self.actor_has_mailbox_capacity[row]
        false

    # Actor is the current class-like declaration carrier. Bitfields share
    # this generic field projection so consumers need no aggregate access.
    me field_range_start_at(row: i64, generation_value: i64) -> i64:
        if not self.declaration_valid(row, generation_value): return -1
        if self.declaration_kind[row] == HD_DECL_ACTOR: return self.actor_field_start[row]
        if self.declaration_kind[row] == HD_DECL_BITFIELD: return self.bitfield_field_start[row]
        -1

    me field_range_len_at(row: i64, generation_value: i64) -> i64:
        if not self.declaration_valid(row, generation_value): return -1
        if self.declaration_kind[row] == HD_DECL_ACTOR: return self.actor_field_count[row]
        if self.declaration_kind[row] == HD_DECL_BITFIELD: return self.bitfield_field_count[row]
        -1

    me field_name_at(row: i64, generation_value: i64, ordinal: i64) -> text:
        val start = self.field_range_start_at(row, generation_value)
        val count = self.field_range_len_at(row, generation_value)
        if start < 0 or ordinal < 0 or ordinal >= count: return ""
        if self.declaration_kind[row] == HD_DECL_ACTOR: return self.actor_field_name[start + ordinal]
        self.bitfield_field_name[start + ordinal]

    me field_i64_at(row: i64, generation_value: i64, ordinal: i64, column: i64) -> i64:
        val start = self.field_range_start_at(row, generation_value)
        val count = self.field_range_len_at(row, generation_value)
        if start < 0 or ordinal < 0 or ordinal >= count: return -1
        val field = start + ordinal
        if self.declaration_kind[row] == HD_DECL_ACTOR:
            if column == 0: return self.actor_field_symbol[field]
            if column == 1: return self.actor_field_type[field]
            if column == 2: return self.actor_field_visibility[field]
            if column == 3: return self.actor_field_bits[field]
            if column == 4: return self.actor_field_fixed_address[field]
            if column == 5: return self.actor_field_default[field]
            if column == 6: return self.actor_field_span[field]
        else:
            if column == 0: return self.bitfield_field_symbol[field]
            if column == 1: return self.bitfield_field_type[field]
            if column == 2: return self.bitfield_field_offset[field]
            if column == 3: return self.bitfield_field_width[field]
            if column == 4: return self.bitfield_field_source_bits[field]
            if column == 6: return self.bitfield_field_span[field]
        -1

    me field_bool_at(row: i64, generation_value: i64, ordinal: i64, column: i64) -> bool:
        val start = self.field_range_start_at(row, generation_value)
        val count = self.field_range_len_at(row, generation_value)
        if start < 0 or ordinal < 0 or ordinal >= count: return false
        val field = start + ordinal
        if self.declaration_kind[row] == HD_DECL_ACTOR:
            if column == 0: return self.actor_field_is_public[field]
            if column == 1: return self.actor_field_volatile[field]
            if column == 2: return self.actor_field_has_bits[field]
            if column == 3: return self.actor_field_has_fixed_address[field]
            if column == 4: return self.actor_field_has_default[field]
        else:
            if column == 2: return self.bitfield_field_has_source_bits[field]
            if column == 4: return self.bitfield_field_has_type[field]
            if column == 5: return self.bitfield_field_reserved[field]
        false

    # Frozen bitfield declaration scalars. column 0 is the exact storage Type
    # row and column 1 is the finalized aggregate bit width.
    me bitfield_i64_at(row: i64, generation_value: i64, column: i64) -> i64:
        if not self.declaration_valid(row, generation_value) or self.declaration_kind[row] != HD_DECL_BITFIELD: return -1
        if column == 0: return self.bitfield_storage_type[row]
        if column == 1: return self.bitfield_bit_width[row]
        -1

    # Frozen enum declaration flags. column 0 is complete-open and column 1 is
    # dynamic-open, preserving the values accepted by finalize_enum.
    me enum_bool_at(row: i64, generation_value: i64, column: i64) -> bool:
        if not self.declaration_valid(row, generation_value) or self.declaration_kind[row] != HD_DECL_ENUM: return false
        if column == 0: return self.enum_complete_open[row]
        if column == 1: return self.enum_dynamic_open[row]
        false

    # Exact frozen raw-attribute range for an ordinary enum declaration. The
    # range is stored during reserve/append, so reads are O(1) and allocate no
    # temporary attribute collection.
    me enum_raw_attribute_range_start_at(row: i64, generation_value: i64) -> i64:
        if not self.declaration_valid(row, generation_value) or self.declaration_kind[row] != HD_DECL_ENUM: return -1
        self.declaration_decorator_start[row]

    me enum_raw_attribute_range_count_at(row: i64, generation_value: i64) -> i64:
        if not self.declaration_valid(row, generation_value) or self.declaration_kind[row] != HD_DECL_ENUM: return -1
        self.declaration_decorator_count[row]

    me enum_variant_range_start_at(row: i64, generation_value: i64) -> i64:
        if not self.declaration_valid(row, generation_value) or self.declaration_kind[row] != HD_DECL_ENUM: return -1
        self.enum_variant_start[row]

    me enum_variant_range_len_at(row: i64, generation_value: i64) -> i64:
        if not self.declaration_valid(row, generation_value) or self.declaration_kind[row] != HD_DECL_ENUM: return -1
        self.enum_variant_count[row]

    me declaration_lookup_at(module_row: i64, symbol: i64,
            generation_value: i64) -> i64:
        if (not self.frozen or generation_value != self.generation or
                module_row < 0 or module_row >= self.declaration_by_module.len() or
                not self.declaration_by_module[module_row].contains_key(symbol)):
            return -1
        val row = self.declaration_by_module[module_row][symbol]
        if not self.declaration_valid(row, generation_value): return -1
        row

    me enum_variant_lookup_at(row: i64, generation_value: i64,
            name: text) -> i64:
        if (not self.declaration_valid(row, generation_value) or
                self.declaration_kind[row] != HD_DECL_ENUM or
                row >= self.enum_variant_by_name.len() or
                not self.enum_variant_by_name[row].contains_key(name)):
            return -1
        self.enum_variant_by_name[row][name]

    me enum_payload_lookup_at(row: i64, generation_value: i64,
            variant_ordinal: i64, name: text) -> i64:
        val variant_start = self.enum_variant_range_start_at(row, generation_value)
        val variant_count = self.enum_variant_range_len_at(row, generation_value)
        if variant_start < 0 or variant_ordinal < 0 or variant_ordinal >= variant_count:
            return -1
        val variant = variant_start + variant_ordinal
        if (variant >= self.enum_payload_by_name.len() or
                not self.enum_payload_by_name[variant].contains_key(name)):
            return -1
        self.enum_payload_by_name[variant][name]

    # Exact frozen raw-attribute range for a variant owned by an ordinary
    # enum. Extension variants are deliberately rejected by the parent enum
    # validation and retain their separate extension reader surface.
    me enum_variant_raw_attribute_range_start_at(row: i64,
            generation_value: i64, ordinal: i64) -> i64:
        val start = self.enum_variant_range_start_at(row, generation_value)
        val count = self.enum_variant_range_len_at(row, generation_value)
        if start < 0 or ordinal < 0 or ordinal >= count: return -1
        val variant = start + ordinal
        if (self.enum_variant_owner_kind[variant] != HD_DECL_ENUM or
                self.enum_variant_owner[variant] != row): return -1
        self.enum_variant_decorator_start[variant]

    me enum_variant_raw_attribute_range_count_at(row: i64,
            generation_value: i64, ordinal: i64) -> i64:
        val start = self.enum_variant_range_start_at(row, generation_value)
        val count = self.enum_variant_range_len_at(row, generation_value)
        if start < 0 or ordinal < 0 or ordinal >= count: return -1
        val variant = start + ordinal
        if (self.enum_variant_owner_kind[variant] != HD_DECL_ENUM or
                self.enum_variant_owner[variant] != row): return -1
        self.enum_variant_decorator_count[variant]

    me enum_variant_name_at(row: i64, generation_value: i64, ordinal: i64) -> text:
        val start = self.enum_variant_range_start_at(row, generation_value)
        val count = self.enum_variant_range_len_at(row, generation_value)
        if start < 0 or ordinal < 0 or ordinal >= count: return ""
        self.enum_variant_name[start + ordinal]

    me enum_variant_i64_at(row: i64, generation_value: i64, ordinal: i64, column: i64) -> i64:
        val start = self.enum_variant_range_start_at(row, generation_value)
        val count = self.enum_variant_range_len_at(row, generation_value)
        if start < 0 or ordinal < 0 or ordinal >= count: return -1
        val variant = start + ordinal
        if column == 0: return self.enum_variant_symbol[variant]
        if column == 1: return self.enum_variant_payload_kind[variant]
        if column == 2: return self.enum_variant_discriminant[variant]
        if column == 3: return self.enum_variant_payload_start[variant]
        if column == 4: return self.enum_variant_payload_count[variant]
        if column == 5: return self.enum_variant_span[variant]
        -1

    me enum_variant_has_discriminant_at(row: i64, generation_value: i64, ordinal: i64) -> bool:
        val start = self.enum_variant_range_start_at(row, generation_value)
        val count = self.enum_variant_range_len_at(row, generation_value)
        start >= 0 and ordinal >= 0 and ordinal < count and self.enum_variant_has_discriminant[start + ordinal]

    me enum_payload_name_at(row: i64, generation_value: i64, variant_ordinal: i64, payload_ordinal: i64) -> text:
        val variant_start = self.enum_variant_range_start_at(row, generation_value)
        val variant_count = self.enum_variant_range_len_at(row, generation_value)
        if variant_start < 0 or variant_ordinal < 0 or variant_ordinal >= variant_count: return ""
        val variant = variant_start + variant_ordinal
        if payload_ordinal < 0 or payload_ordinal >= self.enum_variant_payload_count[variant]: return ""
        self.enum_payload_name[self.enum_variant_payload_start[variant] + payload_ordinal]

    me enum_payload_i64_at(row: i64, generation_value: i64, variant_ordinal: i64, payload_ordinal: i64, column: i64) -> i64:
        val variant_start = self.enum_variant_range_start_at(row, generation_value)
        val variant_count = self.enum_variant_range_len_at(row, generation_value)
        if variant_start < 0 or variant_ordinal < 0 or variant_ordinal >= variant_count: return -1
        val variant = variant_start + variant_ordinal
        if payload_ordinal < 0 or payload_ordinal >= self.enum_variant_payload_count[variant]: return -1
        val payload = self.enum_variant_payload_start[variant] + payload_ordinal
        if column == 0: return self.enum_payload_type[payload]
        if column == 1: return self.enum_payload_span[payload]
        -1

    me constant_i64_at(row: i64, generation_value: i64, column: i64) -> i64:
        if not self.declaration_valid(row, generation_value) or self.declaration_kind[row] != HD_DECL_CONSTANT: return -1
        if column == 0: return self.constant_type[row]
        if column == 1: return self.constant_value[row]
        if column == 2: return self.constant_fixed_address[row]
        -1

    me constant_bool_at(row: i64, generation_value: i64, column: i64) -> bool:
        if not self.declaration_valid(row, generation_value) or self.declaration_kind[row] != HD_DECL_CONSTANT: return false
        if column == 0: return self.constant_has_type[row]
        if column == 1: return self.constant_mutable[row]
        if column == 2: return self.constant_volatile[row]
        if column == 3: return self.constant_has_fixed_address[row]
        false

    me enum_extension_valid(row: i64, generation_value: i64) -> bool:
        self.frozen and generation_value == self.generation and row >= 0 and row < self.enum_extension_count and self.enum_extension_ready[row] and self.enum_extension_generation[row] == generation_value

    me enum_extension_count_at(generation_value: i64) -> i64:
        if self.frozen and generation_value==self.generation:
            self.enum_extension_count
        else: -1

    me enum_extension_constructor_i64_at(row: i64,generation_value: i64,
        ordinal: i64,column: i64) -> i64:
        if not self.enum_extension_valid(row,generation_value) or ordinal<0 or
            ordinal>=self.enum_extension_constructor_count[row]: return -1
        val receipt=self.enum_extension_constructor_start[row]+ordinal
        if self.enum_constructor_extension[receipt]!=row: return -1
        if column==0: return self.enum_constructor_variant[receipt]
        if column==1: return self.enum_constructor_symbol[receipt]
        if column==2: return self.enum_constructor_function[receipt]
        if column==3: return self.enum_constructor_payload_start[receipt]
        if column==4: return self.enum_constructor_payload_count[receipt]
        if column==5: return self.enum_constructor_span[receipt]
        if column==6: return self.enum_constructor_payload_kind[receipt]
        if column==7: return self.enum_constructor_discriminant[receipt]
        -1

    me enum_extension_constructor_text_at(row: i64,generation_value: i64,
        ordinal: i64,column: i64) -> text:
        if not self.enum_extension_valid(row,generation_value) or ordinal<0 or
            ordinal>=self.enum_extension_constructor_count[row]: return ""
        val receipt=self.enum_extension_constructor_start[row]+ordinal
        if self.enum_constructor_extension[receipt]!=row: return ""
        if column==0: return self.enum_constructor_provider[receipt]
        if column==1: return self.enum_constructor_name[receipt]
        ""

    me enum_extension_constructor_has_discriminant_at(row: i64,
            generation_value: i64,ordinal: i64) -> bool:
        if not self.enum_extension_valid(row,generation_value) or ordinal<0 or
                ordinal>=self.enum_extension_constructor_count[row]: return false
        val receipt=self.enum_extension_constructor_start[row]+ordinal
        self.enum_constructor_extension[receipt]==row and
            self.enum_constructor_has_discriminant[receipt]

    me enum_extension_payload_name_at(row: i64,generation_value: i64,
            constructor_ordinal: i64,payload_ordinal: i64) -> text:
        if not self.enum_extension_valid(row,generation_value) or
                constructor_ordinal<0 or
                constructor_ordinal>=self.enum_extension_constructor_count[row]:
            return ""
        val constructor=self.enum_extension_constructor_start[row]+constructor_ordinal
        if self.enum_constructor_extension[constructor]!=row or payload_ordinal<0 or
                payload_ordinal>=self.enum_constructor_payload_count[constructor]:
            return ""
        val receipt=self.enum_constructor_payload_start[constructor]+payload_ordinal
        if self.enum_constructor_payload_owner[receipt]!=constructor: return ""
        self.enum_constructor_payload_name[receipt]

    me enum_extension_payload_i64_at(row: i64,generation_value: i64,
        constructor_ordinal: i64,payload_ordinal: i64,column: i64) -> i64:
        if not self.enum_extension_valid(row,generation_value) or
            constructor_ordinal<0 or
            constructor_ordinal>=self.enum_extension_constructor_count[row]:
            return -1
        val constructor=self.enum_extension_constructor_start[row]+constructor_ordinal
        if self.enum_constructor_extension[constructor]!=row or payload_ordinal<0 or
            payload_ordinal>=self.enum_constructor_payload_count[constructor]:
            return -1
        val receipt=self.enum_constructor_payload_start[constructor]+payload_ordinal
        if self.enum_constructor_payload_owner[receipt]!=constructor: return -1
        if column==0: return self.enum_constructor_payload_type[receipt]
        if column==1: return self.enum_constructor_payload_span[receipt]
        -1

    me enum_extension_variant_name_at(row: i64,generation_value: i64,
            ordinal: i64) -> text:
        if not self.enum_extension_valid(row,generation_value) or ordinal<0 or
                ordinal>=self.enum_extension_variant_count[row]: return ""
        val variant=self.enum_extension_variant_start[row]+ordinal
        if (self.enum_variant_owner_kind[variant]!=HD_DECL_ENUM_EXTENSION or
                self.enum_variant_owner[variant]!=row): return ""
        self.enum_variant_name[variant]

    me enum_extension_variant_i64_at(row: i64,generation_value: i64,
            ordinal: i64,column: i64) -> i64:
        if not self.enum_extension_valid(row,generation_value) or ordinal<0 or
                ordinal>=self.enum_extension_variant_count[row]: return -1
        val variant=self.enum_extension_variant_start[row]+ordinal
        if (self.enum_variant_owner_kind[variant]!=HD_DECL_ENUM_EXTENSION or
                self.enum_variant_owner[variant]!=row): return -1
        if column==0: return self.enum_variant_symbol[variant]
        if column==1: return self.enum_variant_payload_kind[variant]
        if column==2: return self.enum_variant_discriminant[variant]
        if column==3: return self.enum_variant_span[variant]
        if column==4: return self.enum_variant_payload_start[variant]
        if column==5: return self.enum_variant_payload_count[variant]
        -1

    me enum_extension_variant_has_discriminant_at(row: i64,
            generation_value: i64,ordinal: i64) -> bool:
        if not self.enum_extension_valid(row,generation_value) or ordinal<0 or
                ordinal>=self.enum_extension_variant_count[row]: return false
        val variant=self.enum_extension_variant_start[row]+ordinal
        self.enum_variant_owner_kind[variant]==HD_DECL_ENUM_EXTENSION and
            self.enum_variant_owner[variant]==row and
            self.enum_variant_has_discriminant[variant]

    me enum_extension_variant_payload_name_at(row: i64,generation_value: i64,
            variant_ordinal: i64,payload_ordinal: i64) -> text:
        val start=self.enum_extension_variant_i64_at(row,generation_value,
            variant_ordinal,4)
        val count=self.enum_extension_variant_i64_at(row,generation_value,
            variant_ordinal,5)
        if start<0 or payload_ordinal<0 or payload_ordinal>=count: return ""
        self.enum_payload_name[start+payload_ordinal]

    me enum_extension_variant_payload_i64_at(row: i64,generation_value: i64,
            variant_ordinal: i64,payload_ordinal: i64,column: i64) -> i64:
        val start=self.enum_extension_variant_i64_at(row,generation_value,
            variant_ordinal,4)
        val count=self.enum_extension_variant_i64_at(row,generation_value,
            variant_ordinal,5)
        if start<0 or payload_ordinal<0 or payload_ordinal>=count: return -1
        val payload=start+payload_ordinal
        if column==0: return self.enum_payload_type[payload]
        if column==1: return self.enum_payload_span[payload]
        -1

    me enum_extension_attribute_text_at(row: i64,generation_value: i64,
        ordinal: i64,column: i64) -> text:
        if not self.enum_extension_valid(row,generation_value) or ordinal<0 or
            ordinal>=self.enum_extension_decorator_count[row]: return ""
        val receipt=self.enum_extension_decorator_start[row]+ordinal
        if self.decorator_owner_kind[receipt]!=HD_DECL_ENUM_EXTENSION or
            self.decorator_owner_row[receipt]!=row: return ""
        if column==0: return self.decorator_name[receipt]
        if column==1: return self.decorator_argument[receipt]
        ""

    me enum_extension_attribute_span_at(row: i64,generation_value: i64,
        ordinal: i64) -> i64:
        if not self.enum_extension_valid(row,generation_value) or ordinal<0 or
            ordinal>=self.enum_extension_decorator_count[row]: return -1
        val receipt=self.enum_extension_decorator_start[row]+ordinal
        if self.decorator_owner_kind[receipt]!=HD_DECL_ENUM_EXTENSION or
            self.decorator_owner_row[receipt]!=row: return -1
        self.decorator_span[receipt]

    me enum_extension_attribute_i64_at(row: i64,generation_value: i64,
        ordinal: i64,column: i64) -> i64:
        if not self.enum_extension_valid(row,generation_value) or ordinal<0 or
            ordinal>=self.enum_extension_decorator_count[row]: return -1
        val receipt=self.enum_extension_decorator_start[row]+ordinal
        if self.decorator_owner_kind[receipt]!=HD_DECL_ENUM_EXTENSION or
            self.decorator_owner_row[receipt]!=row: return -1
        if column==0: return self.decorator_expr_start[receipt]
        if column==1: return self.decorator_expr_count[receipt]
        -1

    me enum_extension_attribute_expr_at(row: i64,generation_value: i64,
        ordinal: i64,expression_ordinal: i64) -> i64:
        val start=self.enum_extension_attribute_i64_at(row,generation_value,ordinal,0)
        val count=self.enum_extension_attribute_i64_at(row,generation_value,ordinal,1)
        if start<0 or expression_ordinal<0 or expression_ordinal>=count: return -1
        val receipt=start+expression_ordinal
        val attribute=self.enum_extension_decorator_start[row]+ordinal
        if self.decorator_expr_owner[receipt]!=attribute: return -1
        self.decorator_expr_row[receipt]

    me enum_extension_i64_at(row: i64, generation_value: i64, column: i64) -> i64:
        if not self.enum_extension_valid(row, generation_value): return -1
        if column == 0: return self.enum_extension_module[row]
        if column == 1: return self.enum_extension_target_module[row]
        if column == 2: return self.enum_extension_target_symbol[row]
        if column == 3: return self.enum_extension_closure_kind[row]
        if column == 4: return self.enum_extension_span[row]
        if column == 5: return self.enum_extension_source_ordinal[row]
        if column == 6: return self.enum_extension_schedule_row[row]
        -1

    me enum_extension_text_at(row: i64, generation_value: i64, column: i64) -> text:
        if not self.enum_extension_valid(row, generation_value): return ""
        if column == 0: return self.enum_extension_target_name[row]
        if column == 1: return self.enum_extension_closure[row]
        ""

    me enum_extension_bool_at(row: i64, generation_value: i64, column: i64) -> bool:
        if not self.enum_extension_valid(row, generation_value): return false
        if column == 0:
            return self.enum_extension_target_module[row] >= 0 and self.enum_extension_target_symbol[row] >= 0
        if column == 1: return self.enum_extension_decorator_count[row] > 0
        if column == 2: return self.enum_extension_closure_kind[row] == 0
        false

    me enum_extension_range_at(row: i64, generation_value: i64, kind: i64, length: bool) -> i64:
        if not self.enum_extension_valid(row, generation_value): return -1
        if kind == 0:
            return if length: self.enum_extension_variant_count[row] else: self.enum_extension_variant_start[row]
        if kind == 1:
            return if length: self.enum_extension_constructor_count[row] else: self.enum_extension_constructor_start[row]
        if kind == 2:
            return if length: self.enum_extension_decorator_count[row] else: self.enum_extension_decorator_start[row]
        -1

    me raw_attribute_valid(row: i64, generation_value: i64) -> bool:
        if not self.frozen or generation_value != self.generation or row < 0 or row >= self.decorator_count:
            return false
        val owner_kind = self.decorator_owner_kind[row]
        val owner_row = self.decorator_owner_row[row]
        if owner_kind == HD_DECL_ENUM_EXTENSION:
            return self.enum_extension_valid(owner_row, generation_value)
        if owner_kind == HD_DECORATOR_OWNER_ENUM_VARIANT:
            if owner_row < 0 or owner_row >= self.enum_variant_count_total: return false
            val parent_kind = self.enum_variant_owner_kind[owner_row]
            val parent_row = self.enum_variant_owner[owner_row]
            if parent_kind == HD_DECL_ENUM_EXTENSION:
                return self.enum_extension_valid(parent_row, generation_value)
            return self.declaration_valid(parent_row, generation_value)
        self.declaration_valid(owner_row, generation_value)

    me raw_attribute_bool_at(row: i64, generation_value: i64, column: i64) -> bool:
        if not self.raw_attribute_valid(row, generation_value): return false
        if column == 0: return self.decorator_expr_count[row] > 0
        false

    me raw_attribute_i64_at(row: i64, generation_value: i64, column: i64) -> i64:
        if not self.raw_attribute_valid(row, generation_value): return -1
        if column == 0: return self.decorator_owner_kind[row]
        if column == 1: return self.decorator_owner_row[row]
        if column == 2: return self.decorator_span[row]
        if column == 3: return self.decorator_expr_start[row]
        if column == 4: return self.decorator_expr_count[row]
        -1

    me raw_attribute_text_at(row: i64, generation_value: i64, column: i64) -> text:
        if not self.raw_attribute_valid(row, generation_value): return ""
        if column == 0: return self.decorator_name[row]
        if column == 1: return self.decorator_argument[row]
        ""

    me raw_attribute_expr_at(row: i64, generation_value: i64, ordinal: i64) -> i64:
        if (not self.raw_attribute_valid(row, generation_value) or ordinal < 0 or
                ordinal >= self.decorator_expr_count[row]):
            return -1
        val receipt = self.decorator_expr_start[row] + ordinal
        if self.decorator_expr_owner[receipt] != row: return -1
        self.decorator_expr_row[receipt]

    me type_param_valid(row: i64, generation_value: i64) -> bool:
        if not self.frozen or generation_value != self.generation or row < 0 or row >= self.type_param_count:
            return false
        self.declaration_valid(self.type_param_owner[row], generation_value)

    me type_param_bound_range_start_at(row: i64, generation_value: i64) -> i64:
        if not self.type_param_valid(row, generation_value): return -1
        self.type_param_bound_start[row]

    me type_param_bound_range_len_at(row: i64, generation_value: i64) -> i64:
        if not self.type_param_valid(row, generation_value): return -1
        self.type_param_bound_count[row]

    me type_param_bound_at(row: i64, generation_value: i64, ordinal: i64) -> i64:
        if not self.type_param_valid(row, generation_value) or ordinal < 0 or ordinal >= self.type_param_bound_count[row]:
            return -1
        val bound_row = self.type_param_bound_start[row] + ordinal
        if self.type_param_bound_owner[bound_row] != row: return -1
        self.type_param_bound_type_row[bound_row]

    me schedule_len(generation_value: i64) -> i64:
        if self.frozen and generation_value == self.generation: self.schedule_count else: -1

    me schedule_domain_at(row: i64, generation_value: i64) -> i64:
        if self.frozen and generation_value == self.generation and row >= 0 and row < self.schedule_count:
            self.schedule_domain[row]
        else: 0

    me schedule_receipt_at(row: i64, generation_value: i64) -> i64:
        if self.frozen and generation_value == self.generation and row >= 0 and row < self.schedule_count:
            self.schedule_receipt[row]
        else: -1

    me schedule_source_ordinal_at(row: i64, generation_value: i64) -> i64:
        if self.frozen and generation_value == self.generation and row >= 0 and row < self.schedule_count:
            self.schedule_source_ordinal[row]
        else: -1

    me schedule_module_at(row: i64, generation_value: i64) -> i64:
        if self.frozen and generation_value == self.generation and row >= 0 and row < self.schedule_count:
            self.schedule_module[row]
        else: -1

    me schedule_source_kind_at(row: i64, generation_value: i64) -> i64:
        if self.frozen and generation_value == self.generation and row >= 0 and row < self.schedule_count:
            self.schedule_source_kind[row]
        else: 0

    me schedule_source_local_index_at(row: i64, generation_value: i64) -> i64:
        if self.frozen and generation_value == self.generation and row >= 0 and row < self.schedule_count:
            self.schedule_source_local_index[row]
        else: -1

    me can_freeze() -> bool:
        if (self.frozen or self.error or self.active_kind != 0 or
                self.nominal_active_row >= 0 or self.checkpoint_count != 0): return false
        var row = 0
        while row < self.nominal_detail_count:
            if (not self.nominal_detail_ready[row] or
                    self.nominal_detail_generation[row] != self.generation): return false
            val trait_start = self.nominal_detail_trait_start[row]
            val field_start = self.nominal_detail_field_start[row]
            var ordinal = 0
            while ordinal < self.nominal_detail_trait_count[row]:
                if self.nominal_trait_owner[trait_start + ordinal] != row: return false
                ordinal = ordinal + 1
            ordinal = 0
            while ordinal < self.nominal_detail_field_count[row]:
                if self.nominal_field_owner[field_start + ordinal] != row: return false
                ordinal = ordinal + 1
            row = row + 1
        row = 0
        while row < self.declaration_count:
            if not self.declaration_ready[row] or self.declaration_generation[row] != self.generation: return false
            val declaration_module = self.declaration_module[row]
            val declaration_symbol = self.declaration_symbol[row]
            if (declaration_module < 0 or declaration_module >= self.declaration_by_module.len() or
                    not self.declaration_by_module[declaration_module].contains_key(declaration_symbol) or
                    self.declaration_by_module[declaration_module][declaration_symbol] != row):
                return false
            if self.declaration_kind[row] == HD_DECL_ACTOR:
                if (self.actor_has_message_type[row] !=
                        (self.actor_message_type[row] >= 0) or
                    self.actor_has_mailbox_capacity[row] !=
                        (self.actor_mailbox_capacity[row] >= 0)):
                    return false
            elif self.declaration_kind[row] == HD_DECL_ENUM:
                val attribute_start = self.declaration_decorator_start[row]
                val attribute_count = self.declaration_decorator_count[row]
                if (attribute_start < 0 or attribute_count < 0 or
                        attribute_start + attribute_count > self.decorator_count):
                    return false
                var attribute_ordinal = 0
                while attribute_ordinal < attribute_count:
                    val enum_attribute = attribute_start + attribute_ordinal
                    if (self.decorator_owner_kind[enum_attribute] != HD_DECL_ENUM or
                            self.decorator_owner_row[enum_attribute] != row):
                        return false
                    attribute_ordinal = attribute_ordinal + 1
                val variant_start = self.enum_variant_start[row]
                val variant_count = self.enum_variant_count[row]
                if (variant_start < 0 or variant_count < 0 or
                        variant_start + variant_count > self.enum_variant_count_total):
                    return false
                var variant_ordinal = 0
                while variant_ordinal < variant_count:
                    val variant = variant_start + variant_ordinal
                    if (self.enum_variant_owner_kind[variant] != HD_DECL_ENUM or
                            self.enum_variant_owner[variant] != row or
                            row >= self.enum_variant_by_name.len() or
                            not self.enum_variant_by_name[row].contains_key(self.enum_variant_name[variant]) or
                            self.enum_variant_by_name[row][self.enum_variant_name[variant]] != variant_ordinal):
                        return false
                    var payload_ordinal = 0
                    while payload_ordinal < self.enum_variant_payload_count[variant]:
                        val payload = self.enum_variant_payload_start[variant] + payload_ordinal
                        val payload_name = self.enum_payload_name[payload]
                        if (payload_name != "" and
                                (variant >= self.enum_payload_by_name.len() or
                                 not self.enum_payload_by_name[variant].contains_key(payload_name) or
                                 self.enum_payload_by_name[variant][payload_name] != payload_ordinal)):
                            return false
                        payload_ordinal = payload_ordinal + 1
                    val variant_attribute_start = self.enum_variant_decorator_start[variant]
                    val variant_attribute_count = self.enum_variant_decorator_count[variant]
                    if (variant_attribute_start < 0 or variant_attribute_count < 0 or
                            variant_attribute_start + variant_attribute_count > self.decorator_count):
                        return false
                    var variant_attribute_ordinal = 0
                    while variant_attribute_ordinal < variant_attribute_count:
                        val variant_attribute = variant_attribute_start + variant_attribute_ordinal
                        if (self.decorator_owner_kind[variant_attribute] != HD_DECORATOR_OWNER_ENUM_VARIANT or
                                self.decorator_owner_row[variant_attribute] != variant):
                            return false
                        variant_attribute_ordinal = variant_attribute_ordinal + 1
                    variant_ordinal = variant_ordinal + 1
            row = row + 1
        row = 0
        var expected_bound_start = 0
        while row < self.type_param_count:
            if self.type_param_bound_start[row] != expected_bound_start: return false
            var ordinal = 0
            while ordinal < self.type_param_bound_count[row]:
                val bound_row = expected_bound_start + ordinal
                if (bound_row >= self.type_param_bound_count_total or
                    self.type_param_bound_owner[bound_row] != row or
                    self.type_param_bound_type_row[bound_row] < 0):
                    return false
                ordinal = ordinal + 1
            if ((self.type_param_bound_count[row] == 0 and self.type_param_bound_type[row] != -1) or
                (self.type_param_bound_count[row] > 0 and
                    self.type_param_bound_type[row] != self.type_param_bound_type_row[expected_bound_start])):
                return false
            expected_bound_start = expected_bound_start + self.type_param_bound_count[row]
            row = row + 1
        if expected_bound_start != self.type_param_bound_count_total: return false
        row = 0
        var previous_extension_module = -1
        var previous_extension_source_ordinal = -1
        var extension_module_local_index = -1
        while row < self.enum_extension_count:
            if not self.enum_extension_ready[row] or self.enum_extension_generation[row] != self.generation: return false
            val extension_module = self.enum_extension_module[row]
            val source_ordinal = self.enum_extension_source_ordinal[row]
            val schedule_row = self.enum_extension_schedule_row[row]
            if extension_module != previous_extension_module:
                if extension_module < 0 or extension_module <= previous_extension_module:
                    return false
                previous_extension_module = extension_module
                previous_extension_source_ordinal = -1
                extension_module_local_index = 0
            else:
                extension_module_local_index = extension_module_local_index + 1
            if (source_ordinal < 0 or
                    (previous_extension_source_ordinal >= 0 and
                        source_ordinal < previous_extension_source_ordinal) or
                    schedule_row < 0 or schedule_row >= self.schedule_count or
                    self.schedule_domain[schedule_row] != HD_SCHEDULE_EXTENSION or
                    self.schedule_receipt[schedule_row] != row or
                    self.schedule_source_ordinal[schedule_row] != source_ordinal or
                    self.schedule_module[schedule_row] != extension_module or
                    self.schedule_source_local_index[schedule_row] != extension_module_local_index or
                    self.schedule_marker_at(HD_SCHEDULE_EXTENSION, row) != schedule_row):
                return false
            previous_extension_source_ordinal = source_ordinal
            val attribute_start = self.enum_extension_decorator_start[row]
            val attribute_count = self.enum_extension_decorator_count[row]
            if attribute_start < 0 or attribute_count < 0 or attribute_start + attribute_count > self.decorator_count:
                return false
            var attribute_ordinal = 0
            while attribute_ordinal < attribute_count:
                val attribute = attribute_start + attribute_ordinal
                if (self.decorator_owner_kind[attribute] != HD_DECL_ENUM_EXTENSION or
                        self.decorator_owner_row[attribute] != row):
                    return false
                attribute_ordinal = attribute_ordinal + 1
            val constructor_start = self.enum_extension_constructor_start[row]
            val constructor_count = self.enum_extension_constructor_count[row]
            if constructor_start < 0 or constructor_count < 0 or constructor_start + constructor_count > self.enum_constructor_count:
                return false
            var constructor_ordinal = 0
            while constructor_ordinal < constructor_count:
                val constructor = constructor_start + constructor_ordinal
                if self.enum_constructor_extension[constructor] != row: return false
                val payload_kind = self.enum_constructor_payload_kind[constructor]
                val has_discriminant = self.enum_constructor_has_discriminant[constructor]
                val discriminant = self.enum_constructor_discriminant[constructor]
                if (payload_kind < HD_ENUM_PAYLOAD_NONE or
                        payload_kind > HD_ENUM_PAYLOAD_STRUCT or
                        (has_discriminant and discriminant < 0) or
                        (not has_discriminant and discriminant != -1)):
                    return false
                val payload_start = self.enum_constructor_payload_start[constructor]
                val payload_count = self.enum_constructor_payload_count[constructor]
                if payload_start < 0 or payload_count < 0 or payload_start + payload_count > self.enum_constructor_payload_count_total:
                    return false
                if ((payload_kind == HD_ENUM_PAYLOAD_NONE and payload_count != 0) or
                        (payload_kind != HD_ENUM_PAYLOAD_NONE and payload_count == 0)):
                    return false
                var payload_ordinal = 0
                while payload_ordinal < payload_count:
                    val payload = payload_start + payload_ordinal
                    if self.enum_constructor_payload_owner[payload] != constructor:
                        return false
                    if ((payload_kind == HD_ENUM_PAYLOAD_TUPLE and
                            self.enum_constructor_payload_name[payload] != "") or
                            (payload_kind == HD_ENUM_PAYLOAD_STRUCT and
                                self.enum_constructor_payload_name[payload] == "")):
                        return false
                    payload_ordinal = payload_ordinal + 1
                constructor_ordinal = constructor_ordinal + 1
            row = row + 1
        row = 0
        while row < self.nominal_detail_count:
            val module_row = self.nominal_detail_module[row]
            val symbol = self.nominal_detail_symbol[row]
            if (not self.nominal_detail_ready[row] or
                    self.nominal_detail_generation[row] != self.generation or
                    module_row < 0 or module_row >= self.nominal_detail_by_module.len() or
                    symbol < 0 or
                    not self.nominal_detail_by_module[module_row].contains_key(symbol) or
                    self.nominal_detail_by_module[module_row][symbol] != row):
                return false
            row = row + 1
        row = 0
        while row < self.decorator_count:
            val start = self.decorator_expr_start[row]
            val count = self.decorator_expr_count[row]
            if start < 0 or count < 0 or start + count > self.decorator_expr_count_total:
                return false
            var argument = 0
            while argument < count:
                val receipt = start + argument
                if (self.decorator_expr_owner[receipt] != row or
                    self.decorator_expr_row[receipt] < 0):
                    return false
                argument = argument + 1
            row = row + 1
        row = 0
        var previous_schedule_module = -1
        var previous_schedule_source_ordinal = -1
        while row < self.schedule_count:
            val schedule_module = self.schedule_module[row]
            if schedule_module != previous_schedule_module:
                if schedule_module < 0 or schedule_module <= previous_schedule_module:
                    return false
                previous_schedule_module = schedule_module
                previous_schedule_source_ordinal = -1
            if (self.schedule_source_ordinal[row] < 0 or
                    (previous_schedule_source_ordinal >= 0 and
                        self.schedule_source_ordinal[row] < previous_schedule_source_ordinal) or
                    self.schedule_domain[row] < HD_SCHEDULE_SYMBOL or
                    self.schedule_domain[row] > HD_SCHEDULE_EXTENSION or
                    self.schedule_receipt[row] < 0 or self.schedule_module[row] < 0 or
                    self.schedule_source_kind[row] <= 0 or self.schedule_source_kind[row] > 11 or
                    self.schedule_source_local_index[row] < 0 or
                    self.schedule_marker_at(self.schedule_domain[row], self.schedule_receipt[row]) != row):
                return false
            previous_schedule_source_ordinal = self.schedule_source_ordinal[row]
            row = row + 1
        true

    me freeze() -> bool:
        if not self.can_freeze(): return false
        self.frozen = true; true
    me commit_freeze():
        self.frozen = true

    me structural_capacity_bytes_estimate() -> i64:
        self.declaration_capacity * 288 + self.type_param_capacity * 80 + self.type_param_bound_capacity * 16 + self.decorator_capacity * 80 +
            self.decorator_expr_capacity * 16 +
            self.actor_field_capacity * 128 + self.bitfield_field_capacity * 104 + self.enum_variant_capacity * 112 +
            self.enum_payload_capacity * 56 + self.enum_extension_capacity * 160 +
            self.schedule_capacity * 48 + self.enum_constructor_capacity * 120 +
            self.enum_constructor_payload_capacity * 48 +
            self.nominal_detail_capacity * 104 + self.nominal_trait_capacity * 16 +
            self.nominal_field_capacity * 120 +
            (self.nominal_detail_by_module.len() + self.nominal_detail_count) * 24 +
            (self.declaration_by_module.len() + self.declaration_count +
                self.enum_variant_by_name.len() + self.enum_variant_count_total +
                self.enum_payload_by_name.len() + self.enum_payload_count) * 24 +
            self.checkpoint_capacity * 152 +
            (self.schedule_seen_symbol.len() + self.schedule_seen_function.len() +
                self.schedule_seen_declaration.len() + self.schedule_seen_impl.len() +
                self.schedule_seen_extension.len()) * 8

    me text_payload_bytes() -> i64:
        var total = 0; var row = 0
        while row < self.declaration_name.len():
            total = total + self.declaration_name[row].len() + self.declaration_doc[row].len(); row = row + 1
        row = 0
        while row < self.nominal_field_count_total:
            total = total + self.nominal_field_name[row].len(); row = row + 1
        row = 0
        while row < self.type_param_name.len(): total = total + self.type_param_name[row].len(); row = row + 1
        row = 0
        while row < self.decorator_name.len():
            total = total + self.decorator_name[row].len() + self.decorator_argument[row].len(); row = row + 1
        row = 0
        while row < self.actor_field_name.len(): total = total + self.actor_field_name[row].len(); row = row + 1
        row = 0
        while row < self.bitfield_field_name.len(): total = total + self.bitfield_field_name[row].len(); row = row + 1
        row = 0
        while row < self.enum_variant_name.len(): total = total + self.enum_variant_name[row].len(); row = row + 1
        row = 0
        while row < self.enum_payload_name.len(): total = total + self.enum_payload_name[row].len(); row = row + 1
        row = 0
        while row < self.enum_constructor_name.len():
            total = total + self.enum_constructor_provider[row].len() + self.enum_constructor_name[row].len(); row = row + 1
        row = 0
        while row < self.enum_constructor_payload_name.len():
            total = total + self.enum_constructor_payload_name[row].len(); row = row + 1
        row = 0
        while row < self.enum_extension_target_name.len():
            total = total + self.enum_extension_target_name[row].len() + self.enum_extension_closure[row].len(); row = row + 1
        total

export HirDestinationDeclarationStore, HD_SCHEDULE_SYMBOL, HD_SCHEDULE_FUNCTION
export HD_SCHEDULE_DECLARATION, HD_SCHEDULE_IMPL, HD_SCHEDULE_EXTENSION
