# Importer-side row of HirModule.imported_layouts: identity only.
#
# The side table answers one question for the importer -- "is this imported
# struct symbol a known nominal owner?" (hir_frontend_type_unresolved,
# 35.semantics/lint/hir_frontend_diagnostics.spl, reads key membership only).
# The field layout itself stays with its single owner, the declaring module
# (HirModule.structs there; the frozen module surface for the importer's own
# lowering). A row therefore carries the importer's SymbolId and the declaring
# identity and NO field payload.
#
# Why not a field copy: every importer of a struct used to retain one HirField
# per declared field (name, projected type, a NilLit default expression, flags
# and span). Measured on the run-32 full CLI closure (3145 modules, 31-entry
# systematic sample of the HIR cache): 165 rows and 1200 fields per module,
# 30% of all encoded HIR fields, read by nothing after lowering. See
# doc/05_design/compiler/perf/hir_import_replica_residency_v1.md.

use compiler.hir.hir_types.{SymbolId}
use compiler.hir.hir_definitions.{HirStruct}
use compiler.hir.hir_lowering.module_surface_types.{ModuleSurfaceComposite}
use compiler.common.attributes.{parse_layout_attrs}

pub fn hir_imported_struct_row_v1(symbol: SymbolId, composite: ModuleSurfaceComposite) -> HirStruct:
    val generic_template = composite.type_params.len() > 0
    val row = HirStruct(
        symbol: symbol,
        name: composite.name,
        type_params: [],
        fields: [],
        visibility: composite.visibility,
        is_public: composite.is_public,
        has_doc_comment: false,
        doc_comment: "",
        span: composite.span,
        has_layout_attr: false,
        layout_attr: parse_layout_attrs([]),
        has_platform_attr: false,
        platform_has_error: false,
        platform_has_warning: false,
        platform_diagnostic_message: "",
        platform_diagnostic_line: 0,
        is_generic_template: generic_template,
        has_specialization_of: false,
        specialization_of: "",
        type_bindings: {}
    )
    row

export hir_imported_struct_row_v1
