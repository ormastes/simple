use compiler.common.cache.visibility_manifest_read_v1.{visibility_manifest_parent_v1}
use std.common.build_manager.contracts.{builder_digest_valid_v1}
# Explicit configured namespace-child selection. Legacy flat aliases remain
# unavailable; no path-to-public-child search is permitted here.
use compiler.common.cache.module_child_selection_receipt_v1.{ModuleChildSelectionReceiptV1}
use compiler.hir.hir_lowering.module_surface_types.{ModuleSurfacesByName}
use compiler.hir.hir_lowering.module_surface_registry_index.{module_surface_registry_index}
use compiler.hir.hir_lowering.module_surface_manifest_evidence_v1.{module_surface_manifest_ready_reason_v1, module_surface_manifest_digest_v1}

pub(package) fn module_child_select_configured_v1(registry: ModuleSurfacesByName,
        configured_name: text) -> ModuleChildSelectionReceiptV1:
    # This branch selects an exact namespace binding and then its named child.
    # It does not replay a path-derived or relative legacy lookup after the fact.
    val dot = configured_name.last_index_of(".")
    if dot <= 0 or configured_name.starts_with("."):
        return ModuleChildSelectionReceiptV1()
    val namespace = configured_name.substring(0, dot)
    val child = configured_name.substring(dot + 1)
    val parent_index = module_surface_registry_index(registry, namespace)
    val target_index = module_surface_registry_index(registry, configured_name)
    if parent_index < 0 or target_index < 0 or registry.generation <= 0:
        return ModuleChildSelectionReceiptV1()
    val parent = registry.surfaces[parent_index]
    val target = registry.surfaces[target_index]
    val evidence = parent.visibility_manifest_evidence_v1
    if module_surface_manifest_ready_reason_v1(parent.canonical_path, evidence) != "":
        return ModuleChildSelectionReceiptV1()
    # Only the policy owned by the selected parent binding can choose this row.
    # A sibling/ancestor policy with the same target cannot stand in for it.
    for policy in evidence.policies:
        if policy.source_path != parent.canonical_path: continue
        if policy.content_sha256 != parent.source_sha256_v1: return ModuleChildSelectionReceiptV1()
        for ordinal in 0..policy.child_names.len():
            if policy.child_names[ordinal] != child: continue
            if policy.child_resolution_outcomes[ordinal] != "snapshot-selected":
                return ModuleChildSelectionReceiptV1()
            # Check the selected row's target, never choose a row by target.
            if (policy.child_target_paths[ordinal] != target.canonical_path or
                    target.source_sha256_v1 != policy.child_target_sha256[ordinal] or
                    target.visibility_manifest_evidence_v1.snapshot_id != evidence.snapshot_id):
                return ModuleChildSelectionReceiptV1()
            val digest = module_surface_manifest_digest_v1(parent.canonical_path, evidence)
            if digest == "": return ModuleChildSelectionReceiptV1()
            return ModuleChildSelectionReceiptV1(selected: true, reason: "selected",
                configured_namespace: namespace, selected_name: configured_name,
                manifest_surface: parent_index, manifest_path: policy.source_path,
                child_ordinal: ordinal, child_name: child, child_modifier: policy.child_modifiers[ordinal],
                policy_digest: digest, snapshot_id: evidence.snapshot_id,
                target_surface: target_index, target_path: target.canonical_path,
                target_digest: policy.child_target_sha256[ordinal], target_kind: policy.child_target_kinds[ordinal],
                configured_route_generation: registry.configured_route_generation_v1,
                registry_generation: registry.generation)
    ModuleChildSelectionReceiptV1()

# Exact canonical source admission is selected before legacy resolution. An
# arbitrary alias with the same target cannot enter this owner branch.
pub(package) fn module_direct_folder_select_v1(registry: ModuleSurfacesByName,
        source_index: i64, configured_name: text) -> ModuleChildSelectionReceiptV1:
    if source_index < 0 or source_index >= registry.surfaces.len() or registry.generation <= 0:
        return ModuleChildSelectionReceiptV1()
    val dot = configured_name.last_index_of(".")
    if dot <= 0: return ModuleChildSelectionReceiptV1()
    # A configured parent owns its child policy, including unavailable policy.
    # Never recover a failed child selection by treating it as a direct source.
    if module_surface_registry_index(registry, configured_name.substring(0, dot)) >= 0:
        return ModuleChildSelectionReceiptV1()
    val target_index = module_surface_registry_index(registry, configured_name)
    if target_index < 0 or target_index == source_index: return ModuleChildSelectionReceiptV1()
    val source = registry.surfaces[source_index]
    val target = registry.surfaces[target_index]
    if target.admitted_direct_name_v1 != configured_name: return ModuleChildSelectionReceiptV1()
    val source_evidence = source.visibility_manifest_evidence_v1
    val target_evidence = target.visibility_manifest_evidence_v1
    if (not builder_digest_valid_v1(source_evidence.selected_source_sha256) or
            not builder_digest_valid_v1(target_evidence.selected_source_sha256) or
            source_evidence.selected_source_sha256 != source.source_sha256_v1 or
            target_evidence.selected_source_sha256 != target.source_sha256_v1 or
            source_evidence.snapshot_id != target_evidence.snapshot_id or
            module_surface_manifest_ready_reason_v1(source.canonical_path, source_evidence) != "" or
            module_surface_manifest_ready_reason_v1(target.canonical_path, target_evidence) != ""):
        return ModuleChildSelectionReceiptV1()
    # Location constrains eligibility only after exact binding selection.
    if visibility_manifest_parent_v1(source.canonical_path) != visibility_manifest_parent_v1(target.canonical_path):
        return ModuleChildSelectionReceiptV1()
    return ModuleChildSelectionReceiptV1(selected: true, reason: "selected-direct-source",
        route_kind: "direct-folder-source", configured_namespace: source.admitted_direct_name_v1,
        selected_name: configured_name, manifest_surface: source_index, manifest_path: source.canonical_path,
        direct_source_sha256: source.source_sha256_v1,
        policy_digest: module_surface_manifest_digest_v1(source.canonical_path, source_evidence),
        target_policy_digest: module_surface_manifest_digest_v1(target.canonical_path, target_evidence),
        snapshot_id: source_evidence.snapshot_id, target_surface: target_index,
        target_path: target.canonical_path, target_digest: target.source_sha256_v1, target_kind: "source-file",
        configured_route_generation: registry.configured_route_generation_v1, registry_generation: registry.generation)

fn module_direct_folder_validate_v1(registry: ModuleSurfacesByName,
        receipt: ModuleChildSelectionReceiptV1) -> text:
    val source = registry.surfaces[receipt.manifest_surface]
    val target = registry.surfaces[receipt.target_surface]
    val dot = receipt.selected_name.last_index_of(".")
    if dot <= 0: return "direct-source-name-invalid"
    if (module_surface_registry_index(registry, receipt.selected_name.substring(0, dot)) >= 0 or
            module_surface_registry_index(registry, receipt.selected_name) != receipt.target_surface or
            module_surface_registry_index(registry, receipt.configured_namespace) != receipt.manifest_surface or
            source.admitted_direct_name_v1 != receipt.configured_namespace or
            target.admitted_direct_name_v1 != receipt.selected_name):
        return "direct-source-binding-mismatch"
    val source_evidence = source.visibility_manifest_evidence_v1
    val target_evidence = target.visibility_manifest_evidence_v1
    if (receipt.manifest_path != source.canonical_path or receipt.target_path != target.canonical_path or
            receipt.target_kind != "source-file" or receipt.snapshot_id != source_evidence.snapshot_id or
            receipt.snapshot_id != target_evidence.snapshot_id or
            not builder_digest_valid_v1(receipt.direct_source_sha256) or
            not builder_digest_valid_v1(receipt.target_digest) or
            receipt.direct_source_sha256 != source.source_sha256_v1 or
            receipt.direct_source_sha256 != source_evidence.selected_source_sha256 or
            receipt.target_digest != target.source_sha256_v1 or
            receipt.target_digest != target_evidence.selected_source_sha256):
        return "direct-source-snapshot-mismatch"
    if (module_surface_manifest_ready_reason_v1(source.canonical_path, source_evidence) != "" or
            module_surface_manifest_ready_reason_v1(target.canonical_path, target_evidence) != "" or
            receipt.policy_digest == "" or receipt.target_policy_digest == "" or
            receipt.policy_digest != module_surface_manifest_digest_v1(source.canonical_path, source_evidence) or
            receipt.target_policy_digest != module_surface_manifest_digest_v1(target.canonical_path, target_evidence)):
        return "direct-source-policy-mismatch"
    if visibility_manifest_parent_v1(source.canonical_path) != visibility_manifest_parent_v1(target.canonical_path):
        return "direct-source-folder-mismatch"
    ""

pub fn module_child_selection_validate_v1(registry: ModuleSurfacesByName,
        receipt: ModuleChildSelectionReceiptV1) -> text:
    """Validate a selected receipt against its frozen owner; empty means current
    provenance only. The caller must still authorize all ancestor/export hops."""
    if not receipt.selected: return "module-child-route-unavailable"
    if (not registry.frozen or receipt.registry_generation != registry.generation or
            receipt.configured_route_generation == "" or
            receipt.configured_route_generation != registry.configured_route_generation_v1):
        return "module-child-generation-mismatch"
    if (receipt.manifest_surface < 0 or receipt.manifest_surface >= registry.surfaces.len() or
            receipt.target_surface < 0 or receipt.target_surface >= registry.surfaces.len()):
        return "module-child-owner-missing"
    if receipt.route_kind == "direct-folder-source":
        return module_direct_folder_validate_v1(registry, receipt)
    if receipt.route_kind != "namespace-child": return "module-child-route-kind-unavailable"
    if (module_surface_registry_index(registry, receipt.configured_namespace) != receipt.manifest_surface or
            module_surface_registry_index(registry, receipt.selected_name) != receipt.target_surface or
            receipt.selected_name != receipt.configured_namespace + "." + receipt.child_name):
        return "module-child-namespace-mismatch"
    val parent = registry.surfaces[receipt.manifest_surface]
    val evidence = parent.visibility_manifest_evidence_v1
    if (receipt.snapshot_id != evidence.snapshot_id or
            receipt.snapshot_id != registry.surfaces[receipt.target_surface].visibility_manifest_evidence_v1.snapshot_id):
        return "module-child-snapshot-mismatch"
    if receipt.manifest_path != parent.canonical_path: return "module-child-manifest-mismatch"
    if module_surface_manifest_ready_reason_v1(parent.canonical_path, evidence) != "":
        return "module-child-policy-unavailable"
    val digest = module_surface_manifest_digest_v1(parent.canonical_path, evidence)
    if digest == "" or digest != receipt.policy_digest: return "module-child-policy-mismatch"
    for policy in evidence.policies:
        if policy.source_path != receipt.manifest_path: continue
        if policy.content_sha256 != parent.source_sha256_v1: return "module-child-policy-source-mismatch"
        val ordinal = receipt.child_ordinal
        if ordinal < 0 or ordinal >= policy.child_names.len(): return "module-child-ordinal-invalid"
        if (policy.child_names[ordinal] != receipt.child_name or
                policy.child_modifiers[ordinal] != receipt.child_modifier or
                policy.child_resolution_outcomes[ordinal] != "snapshot-selected"):
            return "module-child-selection-mismatch"
        if (policy.child_target_paths[ordinal] != receipt.target_path or
                registry.surfaces[receipt.target_surface].canonical_path != receipt.target_path or
                policy.child_target_sha256[ordinal] != receipt.target_digest or
                registry.surfaces[receipt.target_surface].source_sha256_v1 != receipt.target_digest or
                policy.child_target_kinds[ordinal] != receipt.target_kind):
            return "module-child-target-mismatch"
        return ""
    "module-child-policy-missing"

export module_child_selection_validate_v1
