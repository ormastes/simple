use compiler.hir.hir_lowering.async_errors.{AsyncError}
use compiler.hir.hir_definitions.{HirStmt}

export async_text_concat_copy_v1, async_error_concat_copy_v1, hir_stmt_concat_copy_v1

# @workaround bug=native_array_concat_dispatch_bootstrap_2026_10_16 recover=1986eb71e4ad1d334d795a4706c2bd06e7a0722b reason=baked bootstrap producer cannot dispatch array concat
fn async_text_concat_copy_v1(left: [text], right: [text]) -> [text]:
    var out: [text] = []
    var index: i64 = 0
    while index < left.len():
        out.push(left[index])
        index = index + 1
    index = 0
    while index < right.len():
        out.push(right[index])
        index = index + 1
    out

# @workaround bug=native_array_concat_dispatch_bootstrap_2026_10_16 recover=1986eb71e4ad1d334d795a4706c2bd06e7a0722b reason=baked bootstrap producer cannot dispatch array concat
fn async_error_concat_copy_v1(left: [AsyncError], right: [AsyncError]) -> [AsyncError]:
    var out: [AsyncError] = []
    var index: i64 = 0
    while index < left.len():
        out.push(left[index])
        index = index + 1
    index = 0
    while index < right.len():
        out.push(right[index])
        index = index + 1
    out

# @workaround bug=native_array_concat_dispatch_bootstrap_2026_10_16 recover=1986eb71e4ad1d334d795a4706c2bd06e7a0722b reason=baked bootstrap producer cannot dispatch array concat
fn hir_stmt_concat_copy_v1(left: [HirStmt], right: [HirStmt]) -> [HirStmt]:
    var out: [HirStmt] = []
    var index: i64 = 0
    while index < left.len():
        out.push(left[index])
        index = index + 1
    index = 0
    while index < right.len():
        out.push(right[index])
        index = index + 1
    out
