# Hot scalar/index expression rows. f64 values live in a lazy cold bank.
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_lowering.hir_destination_graph.*
use std.common.binary_io.{f64_to_bits, f64_from_bits}

impl HirDestinationGraph:
    # WRITER-VALIDATOR-PARITY-TABLE:
    # literal/access writers -> expr_payload_valid literal/access arms
    # collection writers -> ARRAY/ARRAY_REPEAT/TUPLE/DICT/SET arms
    # call/lambda writers -> CALL/METHOD/STATIC/LAMBDA arms
    # control module writers -> IF..TRY_CATCH/HOST_GPU/transfer arms
    # construction/special writers -> STRUCT/ENUM/CAST/RANGE/COMP/ASM arms
    me ensure_expr_capacity(required: i64):
        if required <= self.expr_capacity: return
        val target = self.next_capacity(self.expr_capacity, required)
        while self.expr_ready.len() < target:
            self.expr_ready.push(false); self.expr_diagnostic.push(-1); self.expr_shape.push(0); self.expr_span.push(-1); self.expr_payload.push(-1)
            self.expr_has_type.push(false); self.expr_type.push(-1)
            self.expr_i0.push(-1); self.expr_i1.push(-1); self.expr_i2.push(-1); self.expr_i3.push(-1)
            self.expr_b0.push(false); self.expr_b1.push(false); self.expr_b2.push(false); self.expr_b3.push(false); self.expr_t0.push(""); self.expr_t1.push("")
            self.expr_r0_start.push(-1); self.expr_r0_len.push(0); self.expr_r1_start.push(-1); self.expr_r1_len.push(0)
        self.expr_capacity = target

    me ensure_float_payload_capacity(required: i64):
        if required <= self.float_payload_capacity: return
        val target = self.next_capacity(self.float_payload_capacity, required)
        while self.float_payload_value.len() < target:
            self.float_payload_owner.push(-1); self.float_payload_value.push(0.0); self.float_payload_bits.push(0)
        self.float_payload_capacity = target

    me reserve_expr(span: Span) -> i64:
        if not self.mutable(): self.fail("HIR destination expression reservation after freeze"); return -1
        val s = self.reserve_span(span); if s < 0: return -1
        val i = self.expr_count
        self.ensure_expr_capacity(i + 1)
        self.expr_ready[i] = false; self.expr_diagnostic[i] = -1; self.expr_shape[i] = 0; self.expr_span[i] = s; self.expr_payload[i] = -1
        self.expr_has_type[i] = false; self.expr_type[i] = -1
        self.expr_i0[i] = -1; self.expr_i1[i] = -1; self.expr_i2[i] = -1; self.expr_i3[i] = -1
        self.expr_b0[i] = false; self.expr_b1[i] = false; self.expr_b2[i] = false; self.expr_b3[i] = false; self.expr_t0[i] = ""; self.expr_t1[i] = ""
        self.expr_r0_start[i] = -1; self.expr_r0_len[i] = 0; self.expr_r1_start[i] = -1; self.expr_r1_len[i] = 0
        self.expr_count = i + 1
        i

    me expr_writable(i: i64) -> bool:
        self.mutable() and i >= 0 and i < self.expr_count and not self.expr_ready[i] and self.expr_diagnostic[i] < 0

    me fail_expr(i: i64, message: text) -> bool:
        if self.ready: return false
        if i < 0 or i >= self.expr_count: return self.fail("HIR destination expression index out of range")
        if self.expr_diagnostic[i] < 0: self.expr_diagnostic[i] = self.record_diagnostic(message)
        self.fail(message)

    me set_expr_type(i: i64, has_type: bool, type_index: i64) -> bool:
        if not self.expr_writable(i): return self.fail("HIR destination expression type is not writable")
        if has_type and not self.index_ready(HD_RANGE_TYPE, type_index): return self.fail_expr(i, "HIR destination expression type is not ready")
        self.expr_has_type[i] = has_type; self.expr_type[i] = if has_type: type_index else: -1
        true

    # DIRECT-CALL-INVARIANT: final publication revalidates the fixed owner shape.
    me expr_payload_valid(i: i64, shape: i64) -> bool:
        if shape == HD_EXPR_FLOAT:
            val p = self.expr_payload[i]; return p >= 0 and p < self.float_payload_count and self.float_payload_owner[p] == i
        if shape == HD_EXPR_UNIT or shape == HD_EXPR_NIL or shape == HD_EXPR_ERROR: return self.expr_i0[i] == -1 and self.expr_i1[i] == -1 and self.expr_t0[i] == ""
        if shape == HD_EXPR_INT: return self.expr_i1[i] == -1 and self.expr_i2[i] == -1 and (self.expr_b0[i] or self.expr_t0[i] == "") and self.expr_t1[i] == "" and self.expr_r0_start[i] == -1
        if shape == HD_EXPR_BOOL: return self.expr_i0[i] == -1 and self.expr_i1[i] == -1 and self.expr_t0[i] == "" and self.expr_r0_start[i] == -1
        if shape == HD_EXPR_CHAR: return self.expr_i0[i] >= 0 and self.expr_i1[i] == -1 and self.expr_t0[i] == "" and self.expr_r0_start[i] == -1
        if shape == HD_EXPR_VAR: return self.expr_i0[i] >= 0 and self.expr_i1[i] == -1 and self.expr_t0[i] == "" and self.expr_r0_start[i] == -1
        if shape == HD_EXPR_NAMED_VAR: return self.expr_i0[i] >= 0 and self.expr_t0[i] != "" and self.expr_i1[i] == -1 and self.expr_r0_start[i] == -1
        if shape == HD_EXPR_FIELD: return self.index_ready(HD_RANGE_EXPR, self.expr_i0[i]) and (if self.expr_b0[i]: self.expr_i1[i] >= 0 else: self.expr_i1[i] == -1) and self.expr_t0[i] != "" and self.expr_r0_start[i] == -1
        if shape == HD_EXPR_QUALIFIED_NAMED_VAR: return self.expr_i0[i] >= 0 and self.expr_i1[i] >= 0 and self.expr_i1[i] < self.module_count and self.module_generation[self.expr_i1[i]] == self.generation and self.expr_i2[i] == -1 and self.expr_t0[i] != "" and not self.expr_b0[i] and self.expr_r0_start[i] == -1
        if shape == HD_EXPR_RESOLVED_FIELD: return self.index_ready(HD_RANGE_EXPR, self.expr_i0[i]) and self.expr_i1[i] >= 0 and self.expr_i2[i] >= 0 and self.expr_i2[i] < self.module_count and self.module_generation[self.expr_i2[i]] == self.generation and self.expr_t0[i] != "" and self.expr_b0[i] and self.expr_r0_start[i] == -1
        if shape == HD_EXPR_TUPLE_INDEX: return self.index_ready(HD_RANGE_EXPR, self.expr_i0[i]) and self.expr_i1[i] >= 0 and self.expr_i2[i] == -1 and self.expr_t0[i] == ""
        if shape == HD_EXPR_OPTIONAL_CHAIN: return self.index_ready(HD_RANGE_EXPR, self.expr_i0[i]) and self.expr_t0[i] != "" and self.expr_i1[i] == -1
        if shape == HD_EXPR_EXISTS or shape == HD_EXPR_UNWRAP or shape == HD_EXPR_THROW or shape == HD_EXPR_TRY or shape == HD_EXPR_AWAIT or shape == HD_EXPR_SPAWN: return self.index_ready(HD_RANGE_EXPR, self.expr_i0[i]) and self.expr_i1[i] == -1 and self.expr_t0[i] == ""
        if shape == HD_EXPR_INDEX or shape == HD_EXPR_NULL_COALESCE: return self.index_ready(HD_RANGE_EXPR, self.expr_i0[i]) and self.index_ready(HD_RANGE_EXPR, self.expr_i1[i])
        if shape == HD_EXPR_UNARY: return self.expr_i0[i] >= 0 and self.expr_i0[i] <= 6 and self.index_ready(HD_RANGE_EXPR, self.expr_i1[i])
        if shape == HD_EXPR_BINARY: return self.expr_i0[i] >= 0 and self.expr_i0[i] <= 35 and self.index_ready(HD_RANGE_EXPR, self.expr_i1[i]) and self.index_ready(HD_RANGE_EXPR, self.expr_i2[i])
        if shape == HD_EXPR_ARRAY or shape == HD_EXPR_SET: return self.range_is_ready(HD_RANGE_EXPR, self.expr_r0_start[i], self.expr_r0_len[i]) and (if self.expr_b0[i]: self.index_ready(HD_RANGE_TYPE, self.expr_i0[i]) else: self.expr_i0[i] == -1)
        if shape == HD_EXPR_TUPLE: return self.range_is_ready(HD_RANGE_EXPR, self.expr_r0_start[i], self.expr_r0_len[i]) and self.expr_i0[i] == -1 and not self.expr_b0[i]
        if shape == HD_EXPR_DICT: return self.range_matches(HD_RANGE_AUX, HD_AUX_RANGE_DICT_ENTRY, self.expr_r0_start[i], self.expr_r0_len[i]) and self.index_ready(HD_RANGE_TYPE, self.expr_i0[i]) and (if self.expr_b0[i]: self.index_ready(HD_RANGE_TYPE, self.expr_i1[i]) else: self.expr_i1[i] == -1)
        if shape == HD_EXPR_ARRAY_REPEAT: return self.index_ready(HD_RANGE_EXPR, self.expr_i0[i]) and self.index_ready(HD_RANGE_EXPR, self.expr_i1[i]) and (if self.expr_b0[i]: self.index_ready(HD_RANGE_TYPE, self.expr_i2[i]) else: self.expr_i2[i] == -1)
        if shape == HD_EXPR_STRING: return if self.expr_b0[i]: self.range_matches(HD_RANGE_AUX, HD_AUX_RANGE_INTERPOLATION, self.expr_r0_start[i], self.expr_r0_len[i]) else: self.expr_r0_start[i] == -1 and self.expr_r0_len[i] == 0
        if shape == HD_EXPR_CALL: return self.index_ready(HD_RANGE_EXPR, self.expr_i0[i]) and self.range_matches(HD_RANGE_AUX, HD_AUX_RANGE_CALL_ARG, self.expr_r0_start[i], self.expr_r0_len[i]) and self.range_is_ready(HD_RANGE_TYPE, self.expr_r1_start[i], self.expr_r1_len[i])
        if shape == HD_EXPR_METHOD_CALL: return self.index_ready(HD_RANGE_EXPR, self.expr_i0[i]) and self.require_aux(self.expr_i1[i]) and self.aux_shape[self.expr_i1[i]] == HD_AUX_METHOD_RESOLUTION and self.range_matches(HD_RANGE_AUX, HD_AUX_RANGE_CALL_ARG, self.expr_r0_start[i], self.expr_r0_len[i])
        if shape == HD_EXPR_STATIC_CALL: return self.index_ready(HD_RANGE_TYPE, self.expr_i0[i]) and self.require_aux(self.expr_i1[i]) and self.aux_shape[self.expr_i1[i]] == HD_AUX_METHOD_RESOLUTION and self.range_matches(HD_RANGE_AUX, HD_AUX_RANGE_CALL_ARG, self.expr_r0_start[i], self.expr_r0_len[i])
        if shape == HD_EXPR_IF: return self.index_ready(HD_RANGE_EXPR, self.expr_i0[i]) and self.block_is_ready(self.expr_i1[i]) and (if self.expr_b0[i]: self.block_is_ready(self.expr_i2[i]) else: self.expr_i2[i] == -1)
        if shape == HD_EXPR_IF_CHAIN: return self.range_matches(HD_RANGE_AUX, HD_AUX_RANGE_IF_ARM, self.expr_r0_start[i], self.expr_r0_len[i]) and (if self.expr_b0[i]: self.block_is_ready(self.expr_i0[i]) else: self.expr_i0[i] == -1)
        if shape == HD_EXPR_MATCH: return self.index_ready(HD_RANGE_EXPR, self.expr_i0[i]) and self.range_matches(HD_RANGE_AUX, HD_AUX_RANGE_MATCH_ARM, self.expr_r0_start[i], self.expr_r0_len[i])
        if shape == HD_EXPR_LOOP: return self.block_is_ready(self.expr_i0[i]) and (if self.expr_b0[i]: self.expr_t0[i] != "" else: self.expr_t0[i] == "")
        if shape == HD_EXPR_BLOCK or shape == HD_EXPR_LOSS or shape == HD_EXPR_NOGRAD or shape == HD_EXPR_UNSAFE: return self.block_is_ready(self.expr_i0[i]) and not self.expr_b0[i] and self.expr_t0[i] == ""
        if shape == HD_EXPR_WHILE: return self.index_ready(HD_RANGE_EXPR, self.expr_i0[i]) and self.block_is_ready(self.expr_i1[i]) and (if self.expr_b0[i]: self.expr_t0[i] != "" else: self.expr_t0[i] == "")
        if shape == HD_EXPR_FOR: return self.expr_i0[i] >= 0 and self.index_ready(HD_RANGE_EXPR, self.expr_i1[i]) and self.block_is_ready(self.expr_i2[i]) and (if self.expr_b0[i]: self.expr_t0[i] != "" else: self.expr_t0[i] == "")
        if shape == HD_EXPR_WITH: return self.range_matches(HD_RANGE_AUX, HD_AUX_RANGE_WITH_ITEM, self.expr_r0_start[i], self.expr_r0_len[i]) and self.block_is_ready(self.expr_i0[i])
        if shape == HD_EXPR_LAMBDA: return self.index_ready(HD_RANGE_EXPR, self.expr_i0[i]) and self.range_matches(HD_RANGE_AUX, HD_AUX_RANGE_VALUE_PARAM, self.expr_r0_start[i], self.expr_r0_len[i]) and self.range_matches(HD_RANGE_AUX, HD_AUX_RANGE_SYMBOL_REF, self.expr_r1_start[i], self.expr_r1_len[i])
        if shape == HD_EXPR_HOST_GPU: return self.expr_i0[i] >= 0 and self.expr_i1[i] >= 0 and self.index_ready(HD_RANGE_EXPR, self.expr_i2[i]) and self.block_is_ready(self.expr_i3[i]) and not self.expr_b0[i] and self.expr_t0[i] == "" and self.expr_r0_start[i] == -1
        if shape == HD_EXPR_RETURN: return (if self.expr_b0[i]: self.index_ready(HD_RANGE_EXPR, self.expr_i0[i]) else: self.expr_i0[i] == -1) and self.expr_t0[i] == "" and (not self.expr_has_type[i] or (self.index_ready(HD_RANGE_TYPE, self.expr_type[i]) and self.type_shape[self.expr_type[i]] == HD_TYPE_UNIT))
        if shape == HD_EXPR_BREAK: return (if self.expr_b0[i]: self.index_ready(HD_RANGE_EXPR, self.expr_i0[i]) else: self.expr_i0[i] == -1)
        if shape == HD_EXPR_YIELD: return (if self.expr_b0[i]: self.index_ready(HD_RANGE_EXPR, self.expr_i0[i]) else: self.expr_i0[i] == -1) and self.expr_t0[i] == ""
        if shape == HD_EXPR_CONTINUE: return (self.expr_b0[i] or self.expr_t0[i] == "") and self.expr_i0[i] == -1
        if shape == HD_EXPR_STRUCT: return self.index_ready(HD_RANGE_TYPE, self.expr_i0[i]) and self.range_matches(HD_RANGE_AUX, HD_AUX_RANGE_NAMED_EXPR, self.expr_r0_start[i], self.expr_r0_len[i])
        if shape == HD_EXPR_ENUM: return self.index_ready(HD_RANGE_TYPE, self.expr_i0[i]) and self.expr_t0[i] != "" and (if self.expr_b0[i]: self.require_aux(self.expr_i1[i]) and (self.aux_shape[self.expr_i1[i]] == HD_AUX_ENUM_TUPLE or self.aux_shape[self.expr_i1[i]] == HD_AUX_ENUM_STRUCT) else: self.expr_i1[i] == -1)
        if shape == HD_EXPR_CAST or shape == HD_EXPR_AS: return self.index_ready(HD_RANGE_EXPR, self.expr_i0[i]) and self.index_ready(HD_RANGE_TYPE, self.expr_i1[i])
        if shape == HD_EXPR_RANGE: return (if self.expr_b2[i]: self.index_ready(HD_RANGE_EXPR, self.expr_i0[i]) else: self.expr_i0[i] == -1) and (if self.expr_b3[i]: self.index_ready(HD_RANGE_EXPR, self.expr_i1[i]) else: self.expr_i1[i] == -1) and (if self.expr_b1[i]: self.index_ready(HD_RANGE_EXPR, self.expr_i2[i]) else: self.expr_i2[i] == -1)
        if shape == HD_EXPR_COMPREHENSION: return self.expr_i0[i] >= 0 and self.expr_i0[i] <= 3 and self.index_ready(HD_RANGE_EXPR, self.expr_i1[i]) and self.range_matches(HD_RANGE_AUX, HD_AUX_RANGE_COMP_CLAUSE, self.expr_r0_start[i], self.expr_r0_len[i])
        if shape == HD_EXPR_CUSTOM_BLOCK: return self.expr_i0[i] >= 0 and self.expr_i0[i] < self.block_values.count and self.block_values.ready[self.expr_i0[i]]
        if shape == HD_EXPR_INLINE_ASM: return self.require_aux(self.expr_i0[i]) and self.aux_shape[self.expr_i0[i]] == HD_AUX_ASM
        if shape == HD_EXPR_INLINE_ASM_MATCH: return self.range_matches(HD_RANGE_AUX, HD_AUX_RANGE_ASM_ARM, self.expr_r0_start[i], self.expr_r0_len[i])
        if shape == HD_EXPR_TYPE_TEST: return self.index_ready(HD_RANGE_EXPR, self.expr_i0[i]) and self.expr_t0[i] != ""
        if shape == HD_EXPR_TRY_CATCH: return self.block_is_ready(self.expr_i0[i]) and self.range_matches(HD_RANGE_AUX, HD_AUX_RANGE_CATCH, self.expr_r0_start[i], self.expr_r0_len[i]) and (if self.expr_b0[i]: self.block_is_ready(self.expr_i1[i]) else: self.expr_i1[i] == -1)
        if shape == HD_EXPR_DICT_COMPREHENSION: return self.index_ready(HD_RANGE_EXPR, self.expr_i0[i]) and self.index_ready(HD_RANGE_EXPR, self.expr_i1[i]) and self.expr_i2[i] == -1 and self.range_matches(HD_RANGE_AUX, HD_AUX_RANGE_COMP_CLAUSE, self.expr_r0_start[i], self.expr_r0_len[i])
        if shape == HD_EXPR_ARRAY_SUFFIX: return self.require_aux(self.expr_i0[i]) and self.aux_shape[self.expr_i0[i]] == HD_AUX_TENSOR_SUFFIX and self.range_is_ready(HD_RANGE_EXPR, self.expr_r0_start[i], self.expr_r0_len[i])
        if shape == HD_EXPR_KERNEL_LAUNCH: return self.index_ready(HD_RANGE_EXPR, self.expr_i0[i]) and self.index_ready(HD_RANGE_EXPR, self.expr_i1[i]) and self.index_ready(HD_RANGE_EXPR, self.expr_i2[i]) and self.expr_i3[i] == -1 and self.range_matches(HD_RANGE_AUX, HD_AUX_RANGE_CALL_ARG, self.expr_r0_start[i], self.expr_r0_len[i])
        if shape == HD_EXPR_GPU_INTRINSIC: return self.expr_i0[i] >= 0 and self.expr_i0[i] <= 32 and (if self.expr_i0[i] <= 4: self.expr_b0[i] and self.expr_i1[i] >= 0 else: not self.expr_b0[i] and self.expr_i1[i] == -1) and self.range_is_ready(HD_RANGE_EXPR, self.expr_r0_start[i], self.expr_r0_len[i])
        false

    me finalize_expr(i: i64, shape: i64) -> bool:
        if not self.expr_writable(i): return self.fail("HIR destination expression is not writable")
        # The original compact shapes are one closed contiguous block; the
        # two module-qualified shapes were appended afterward. Keep this an
        # exact allowlist so their valid writers are accepted without also
        # treating arbitrary future wire values as expressions.
        val shape_allowed = (
            (shape >= HD_EXPR_INT and shape <= HD_EXPR_GPU_INTRINSIC) or
            shape == HD_EXPR_QUALIFIED_NAMED_VAR or
            shape == HD_EXPR_RESOLVED_FIELD)
        if not shape_allowed or not self.expr_payload_valid(i, shape): return self.fail_expr(i, "HIR destination expression shape is invalid")
        self.expr_shape[i] = shape; self.expr_ready[i] = true
        true

    me write_int(i: i64, value: i64, has_suffix: bool, suffix: text) -> bool:
        if not self.expr_writable(i): return self.fail("HIR int row is not writable")
        self.expr_i0[i] = value; self.expr_b0[i] = has_suffix; self.expr_t0[i] = if has_suffix: suffix else: ""
        self.finalize_expr(i, HD_EXPR_INT)

    me write_float(i: i64, value: f64, has_suffix: bool, suffix: text) -> bool:
        if not self.expr_writable(i): return self.fail("HIR float row is not writable")
        val payload = self.float_payload_count; self.ensure_float_payload_capacity(payload + 1)
        self.float_payload_owner[payload] = i; self.float_payload_value[payload] = value
        self.float_payload_bits[payload] = f64_to_bits(value) as i64; self.float_payload_count = payload + 1
        self.expr_payload[i] = payload; self.expr_b0[i] = has_suffix; self.expr_t0[i] = if has_suffix: suffix else: ""
        self.finalize_expr(i, HD_EXPR_FLOAT)

    me float_value_at(i: i64) -> f64:
        if i < 0 or i >= self.expr_count or not self.expr_ready[i] or self.expr_shape[i] != HD_EXPR_FLOAT: return 0.0
        val payload = self.expr_payload[i]
        if payload >= 0 and payload < self.float_payload_count and self.float_payload_owner[payload] == i: f64_from_bits(self.float_payload_bits[payload] as u64) else: 0.0

    me float_bits_at(i: i64) -> i64:
        if i < 0 or i >= self.expr_count or not self.expr_ready[i] or self.expr_shape[i] != HD_EXPR_FLOAT: return 0
        val payload = self.expr_payload[i]
        if payload >= 0 and payload < self.float_payload_count and self.float_payload_owner[payload] == i: self.float_payload_bits[payload] else: 0

    me write_string(i: i64, value: text, has_interpolations: bool, start: i64, count: i64) -> bool:
        if not self.expr_writable(i): return self.fail("HIR string row is not writable")
        if has_interpolations and not self.range_matches(HD_RANGE_AUX, HD_AUX_RANGE_INTERPOLATION, start, count): return self.fail_expr(i, "HIR interpolation range is not ready")
        self.expr_t0[i] = value; self.expr_b0[i] = has_interpolations
        self.expr_r0_start[i] = if has_interpolations: start else: -1; self.expr_r0_len[i] = if has_interpolations: count else: 0
        self.finalize_expr(i, HD_EXPR_STRING)

    me write_bool(i: i64, value: bool) -> bool:
        if not self.expr_writable(i): return self.fail("HIR bool row is not writable")
        self.expr_b0[i] = value; self.finalize_expr(i, HD_EXPR_BOOL)

    me write_char_scalar(i: i64, scalar: i64) -> bool:
        if not self.expr_writable(i): return self.fail("HIR char row is not writable")
        self.expr_i0[i] = scalar; self.finalize_expr(i, HD_EXPR_CHAR)

    me write_unit(i: i64) -> bool: self.finalize_expr(i, HD_EXPR_UNIT)
    me write_nil(i: i64) -> bool: self.finalize_expr(i, HD_EXPR_NIL)
    me write_error(i: i64) -> bool: self.finalize_expr(i, HD_EXPR_ERROR)

    me write_var(i: i64, symbol_id: i64) -> bool:
        if not self.expr_writable(i): return self.fail("HIR var row is not writable")
        self.expr_i0[i] = symbol_id; self.finalize_expr(i, HD_EXPR_VAR)

    me write_named_var(i: i64, symbol_id: i64, name: text) -> bool:
        if not self.expr_writable(i): return self.fail("HIR named-var row is not writable")
        self.expr_i0[i] = symbol_id; self.expr_t0[i] = name; self.finalize_expr(i, HD_EXPR_NAMED_VAR)

    me write_qualified_named_var(i: i64, defining_module: i64, symbol_id: i64, name: text) -> bool:
        if not self.expr_writable(i) or defining_module < 0 or defining_module >= self.module_count or self.module_generation[defining_module] != self.generation or symbol_id < 0 or name == "": return self.fail_expr(i, "HIR qualified named-var receipt is invalid")
        self.expr_i0[i] = symbol_id; self.expr_i1[i] = defining_module; self.expr_t0[i] = name
        self.finalize_expr(i, HD_EXPR_QUALIFIED_NAMED_VAR)

    me write_unary(i: i64, op_shape: i64, child: i64) -> bool:
        if not self.expr_writable(i) or not self.index_ready(HD_RANGE_EXPR, child): return self.fail_expr(i, "HIR unary child is not ready")
        if op_shape < 0 or op_shape > 6: return self.fail_expr(i, "HIR unary operator domain is invalid")
        self.expr_i0[i] = op_shape; self.expr_i1[i] = child; self.finalize_expr(i, HD_EXPR_UNARY)

    me write_binary(i: i64, op_shape: i64, left: i64, right: i64) -> bool:
        if not self.expr_writable(i) or not self.index_ready(HD_RANGE_EXPR, left) or not self.index_ready(HD_RANGE_EXPR, right): return self.fail_expr(i, "HIR binary child is not ready")
        if op_shape < 0 or op_shape > 35: return self.fail_expr(i, "HIR binary operator domain is invalid")
        self.expr_i0[i] = op_shape; self.expr_i1[i] = left; self.expr_i2[i] = right
        self.finalize_expr(i, HD_EXPR_BINARY)

    me expr_shape_at(i: i64) -> i64:
        if self.index_ready(HD_RANGE_EXPR, i): self.expr_shape[i] else: 0

export HirDestinationGraph
