# ParserModule Surface - compact cross-module declarations for staged HIR lowering.
#
# codex-impl: Stage4 module retention is reduced by keeping declaration
# surfaces.  The surface deliberately omits ordinary executable bodies,
# parameter default expressions, composite field defaults, and constant values.

use compiler.common.driver_core_types.{SourceFile}
use compiler.frontend.parser_types.*

extern fn rt_hash_text(content: text) -> i64
extern fn rt_path_absolute(path: text) -> text
extern fn rt_transient_heap_promote(value: Any) -> bool

struct ModuleSurfaceParam:
    name: text
    has_type_: bool
    type_: Type
    # Native-safe scalar projections.  A parser Type contains an enum payload;
    # copying it through a nested surface collection can corrupt that payload
    # on the staged native ABI, while text fields remain stable.
    type_name: text
    array_element_name: text
    has_default: bool
    is_mutable: bool
    span: Span

struct ModuleSurfaceCallable:
    name: text
    type_params: [ParserTypeParam]
    params: [ModuleSurfaceParam]
    has_return_type: bool
    return_type: Type
    return_type_name: text
    return_array_element_name: text
    visibility: Visibility
    is_async: bool
    is_static: bool
    is_public: bool
    is_method: bool
    is_mutable: bool
    is_const: bool
    is_kernel: bool
    is_extern: bool
    span: Span

struct ModuleSurfaceField:
    name: text
    type_: Type
    type_name: text
    array_element_name: text

struct ModuleSurfaceComposite:
    name: text
    kind: text
    type_params: [ParserTypeParam]
    fields: [ModuleSurfaceField]
    visibility: Visibility
    is_public: bool
    span: Span

struct ModuleSurfaceEnum:
    name: text
    type_params: [ParserTypeParam]
    # Variant.Struct carries its Fields, including the one permitted retained
    # expression form: an enum struct-variant field default.
    variants: [Variant]
    visibility: Visibility
    is_public: bool
    span: Span

struct ModuleSurfaceTrait:
    name: text
    type_params: [ParserTypeParam]
    super_traits: [Type]
    where_clause: [TraitBound]
    methods: [ModuleSurfaceCallable]
    # These original AST nodes are the sole executable-body exception: impl
    # lowering must inject a trait's unoverridden default methods.
    default_methods: [ParserFunction]
    assoc_types: [AssocTypeDecl]
    visibility: Visibility
    is_public: bool
    span: Span

struct ModuleSurfaceImpl:
    # Phase 3 consumes only the implemented/trait types and callable headers
    # when registering imported methods. Generic bounds, associated types, and
    # the impl span are never read from the surface and remain in the per-file
    # AST for ordinary lowering.
    type_: Type
    has_trait_: bool
    trait_: Type
    methods: Dict<text, ModuleSurfaceCallable>

struct ModuleSurfaceConst:
    name: text
    has_type_: bool
    type_: Type
    is_mutable: bool
    visibility: Visibility
    is_public: bool
    is_volatile: bool
    has_fixed_address: bool
    fixed_address: i64
    span: Span

struct ModuleSurfaceTypeAlias:
    name: text
    type_params: [ParserTypeParam]
    type_: Type
    visibility: Visibility
    is_public: bool
    span: Span

struct ModuleSurfaceExportOrigin:
    owner_module: text
    source_name: text
    resolution_kind: text

struct ModuleSurfaceExportOriginLookup:
    found: bool
    owner_module: text
    source_name: text
    resolution_kind: text

struct ModuleSurfaceOriginResolution:
    is_error: bool
    error: text
    found: bool
    owner_module: text
    source_name: text
    resolution_kind: text

class ModuleSurfaceExportOriginIndex:
    origins: Dict<text, ModuleSurfaceExportOrigin>
    index_by_name: Dict<text, i64>
    frozen: bool
    names: [text]
    owner_modules: [text]
    source_names: [text]
    resolution_kinds: [text]

# Registry construction and freeze publication are sequential. A builder must
# finish its registry before publishing it to lowering or other readers; the
# monotonic allocator therefore stays deliberately lightweight and does not
# claim to synchronize concurrent freezes.
var module_surface_freeze_generation_counter: i64 = 0

fn module_surface_allocate_generation() -> Result<i64, text>:
    if module_surface_freeze_generation_counter == 9223372036854775807:
        return Err("module surface freeze generation exhausted")
    module_surface_freeze_generation_counter =
        module_surface_freeze_generation_counter + 1
    if module_surface_freeze_generation_counter == 0:
        return Err("module surface freeze generation wrapped")
    Ok(module_surface_freeze_generation_counter)

fn module_surface_export_origin_index_empty() -> ModuleSurfaceExportOriginIndex:
    ModuleSurfaceExportOriginIndex(
        origins: {}, index_by_name: {},
        names: [], owner_modules: [], source_names: [],
        resolution_kinds: [], frozen: false)

fn module_surface_export_origin_index_put(
    origin_index: ModuleSurfaceExportOriginIndex,
    name: text,
    owner_module: text,
    source_name: text,
    resolution_kind: text
) -> Result<(), text>:
    # Keep the receiver explicit: native lowering has previously produced an
    # invalid receiver for chained class-field method calls. Validate all
    # aligned arrays before changing either representation.
    if origin_index.frozen:
        return Err("module surface export origin index is frozen")
    if origin_index.names.len() != origin_index.owner_modules.len() or
       origin_index.names.len() != origin_index.source_names.len() or
       origin_index.names.len() != origin_index.resolution_kinds.len():
        return Err("module surface export-origin index arrays are misaligned")
    origin_index.origins[name] = ModuleSurfaceExportOrigin(
        owner_module: owner_module,
        source_name: source_name,
        resolution_kind: resolution_kind)
    if origin_index.index_by_name.contains_key(name):
        val index: i64 = origin_index.index_by_name[name]
        if index < 0 or index >= origin_index.names.len():
            return Err("module surface export-origin scalar index is invalid")
        origin_index.owner_modules[index] = owner_module
        origin_index.source_names[index] = source_name
        origin_index.resolution_kinds[index] = resolution_kind
        return Ok(())
    val index = origin_index.names.len()
    origin_index.index_by_name[name] = index
    origin_index.names = origin_index.names.push(name)
    origin_index.owner_modules = origin_index.owner_modules.push(owner_module)
    origin_index.source_names = origin_index.source_names.push(source_name)
    origin_index.resolution_kinds = origin_index.resolution_kinds.push(resolution_kind)
    Ok(())

fn module_surface_export_origin_index_lookup(origin_index: ModuleSurfaceExportOriginIndex, name: text) -> ModuleSurfaceExportOriginLookup:
    if not origin_index.index_by_name.contains_key(name):
        return ModuleSurfaceExportOriginLookup(
            found: false, owner_module: "", source_name: "", resolution_kind: "")
    val position: i64 = origin_index.index_by_name[name]
    if position < 0 or position >= origin_index.names.len() or
       position >= origin_index.owner_modules.len() or
       position >= origin_index.source_names.len() or
       position >= origin_index.resolution_kinds.len():
        return ModuleSurfaceExportOriginLookup(
            found: false, owner_module: "", source_name: "", resolution_kind: "")
    return ModuleSurfaceExportOriginLookup(
        found: true,
        owner_module: origin_index.owner_modules[position],
        source_name: origin_index.source_names[position],
        resolution_kind: origin_index.resolution_kinds[position])

class ModuleSurface:
    # Stable identity of the physical source surface.  Registry aliases must
    # never become part of re-export traversal identity.
    physical_index: i64
    generation: i64
    frozen: bool
    source_index: i64
    canonical_path: text
    module_name: text
    logical_name: text
    canonical_name: text
    package_name: text
    preferred_registry_name: text
    content_length: i64
    content_hash: i64
    imports: [ParserImport]
    exports: [Export]
    # Frozen route projections.  These are deliberately parallel scalar
    # arrays: no Dict<text, aggregate> crosses the native Stage3 boundary.
    import_target_indices: [i64]
    import_target_names: [text]
    export_route_sources: [text]
    export_route_locals: [text]
    export_route_target_indices: [i64]
    export_route_target_names: [text]
    export_route_is_glob: [bool]
    # Materialize declaration keys once during surface construction. Glob
    # expansion reuses these projections instead of allocating Dict.keys()
    # arrays for every root in the no-GC bootstrap.
    composite_names: [text]
    enum_names: [text]
    trait_names: [text]
    callable_names: [text]
    type_alias_names: [text]
    constant_names: [text]
    callables: Dict<text, ModuleSurfaceCallable>
    composites: Dict<text, ModuleSurfaceComposite>
    enums: Dict<text, ModuleSurfaceEnum>
    traits: Dict<text, ModuleSurfaceTrait>
    impls: [ModuleSurfaceImpl]
    type_aliases: Dict<text, ModuleSurfaceTypeAlias>
    constants: Dict<text, ModuleSurfaceConst>
    export_origins: Dict<text, ModuleSurfaceExportOrigin>
    export_origin_index: ModuleSurfaceExportOriginIndex

    static fn empty(name: text) -> ModuleSurface:
        ModuleSurface(
            physical_index: -1, generation: 0, frozen: false,
            source_index: 0, canonical_path: name, module_name: name,
            logical_name: name, canonical_name: name, package_name: "",
            preferred_registry_name: name,
            content_length: 0, content_hash: 0,
            imports: [], exports: [],
            import_target_indices: [], import_target_names: [],
            export_route_sources: [], export_route_locals: [],
            export_route_target_indices: [], export_route_target_names: [],
            export_route_is_glob: [],
            composite_names: [], enum_names: [], trait_names: [],
            callable_names: [], type_alias_names: [], constant_names: [],
            callables: {}, composites: {}, enums: {},
            traits: {}, impls: [], type_aliases: {}, constants: {},
            export_origins: {},
            export_origin_index: module_surface_export_origin_index_empty())

# This registry owns the complete retained declaration graph. It must remain a
# reference type: passing a value struct across the Stage-3 validation boundary
# duplicates every surface and causes unbounded no-GC allocation.
class ModuleSurfacesByName:
    surfaces: [ModuleSurface]
    index_by_name: Dict<text, i64>
    # Authoritative native-safe lookup representation.  Keep these arrays
    # aligned with discovery order; index_by_name remains the compatibility
    # API for callers that need dictionary membership or iteration.
    ordered_names: [text]
    ordered_indices: [i64]
    generation: i64
    frozen: bool

impl ModuleSurfacesByName:
    static fn empty() -> ModuleSurfacesByName:
        ModuleSurfacesByName(
            surfaces: [], index_by_name: {},
            ordered_names: [], ordered_indices: [], generation: 0, frozen: false)

    static fn from_parts(
        surfaces: [ModuleSurface],
        index_by_name: Dict<text, i64>,
        ordered_names: [text],
        ordered_indices: [i64]
    ) -> Result<ModuleSurfacesByName, text>:
        module_surfaces_by_name_from_parts(
            surfaces, index_by_name, ordered_names, ordered_indices)

struct ModuleSurfaceBuilder:
    surfaces: [ModuleSurface]
    index_by_name: Dict<text, i64>
    index_by_path: Dict<text, i64>
    ordered_names: [text]
    ordered_indices: [i64]
    frozen: bool

impl ModuleSurfaceBuilder:
    static fn new() -> ModuleSurfaceBuilder:
        ModuleSurfaceBuilder(
            surfaces: [], index_by_name: {}, index_by_path: {},
            ordered_names: [], ordered_indices: [], frozen: false)

    me add_indexed_name(name: text, surface_index: i64) -> Result<(), text>:
        if self.frozen:
            return Err("module surface builder is frozen")
        # Preserve the compatibility dictionary and its existing conflict
        # behavior, while recording each newly discovered alias exactly once
        # in the stable scalar representation.
        if self.ordered_names.len() != self.ordered_indices.len():
            return Err("module surface builder name/index arrays have different lengths")
        var existing_position = 0
        while existing_position < self.ordered_names.len():
            if self.ordered_names[existing_position] == name:
                if self.ordered_indices[existing_position] != surface_index:
                    return Err("module surface name maps to conflicting indices: {name}")
            existing_position = existing_position + 1

        val name_result = module_surfaces_add_name(
            self.index_by_name, name, surface_index)
        if name_result.is_err():
            return Err(name_result.unwrap_err())
        self.index_by_name = name_result.unwrap()

        var position = 0
        while position < self.ordered_names.len():
            if self.ordered_names[position] == name:
                return Ok(())
            position = position + 1
        self.ordered_names = self.ordered_names.push(name)
        self.ordered_indices = self.ordered_indices.push(surface_index)
        Ok(())

    me has_path(path: text) -> bool:
        self.index_by_path.contains_key(module_surface_canonical_path(path))

    me has_canonical_path(canonical_path: text) -> bool:
        self.index_by_path.contains_key(canonical_path)

    me add_parsed(module: ParserModule, source: SourceFile, source_index: i64) -> Result<(), text>:
        val canonical_path = module_surface_canonical_path(source.path)
        self.add_parsed_canonical(module, source, source_index, canonical_path)

    me add_parsed_canonical(module: ParserModule, source: SourceFile, source_index: i64, canonical_path: text) -> Result<(), text>:
        if self.frozen:
            return Err("module surface builder is frozen")
        if self.index_by_path.contains_key(canonical_path):
            return Err("module surface already exists for physical source: {canonical_path}")
        val surface_index = self.surfaces.len()
        val name_result = self.add_indexed_name(source.module_name, surface_index)
        if name_result.is_err():
            return Err(name_result.unwrap_err())
        val surface_result = module_surface_from_module(module, source, source_index)
        if surface_result.is_err():
            return Err(surface_result.unwrap_err())
        self.surfaces = self.surfaces.push(surface_result.unwrap())
        self.index_by_path[canonical_path] = surface_index
        Ok(())

    me add_alias(source: SourceFile) -> Result<(), text>:
        val canonical_path = module_surface_canonical_path(source.path)
        self.add_alias_canonical(source, canonical_path)

    me add_alias_canonical(source: SourceFile, canonical_path: text) -> Result<(), text>:
        if self.frozen:
            return Err("module surface builder is frozen")
        if not self.index_by_path.contains_key(canonical_path):
            return Err("missing physical module surface for alias: {canonical_path}")
        val surface_index = self.index_by_path[canonical_path]
        if surface_index < 0 or surface_index >= self.surfaces.len():
            return Err("invalid physical module surface index for alias: path={canonical_path} index={surface_index} len={self.surfaces.len()}")
        val surface = self.surfaces[surface_index]
        if (surface.canonical_path != canonical_path or
            surface.content_length != source.content.len() or
            surface.content_hash != rt_hash_text(source.content)):
            return Err("conflicting physical source: {canonical_path}")
        val name_result = self.add_indexed_name(source.module_name, surface_index)
        if name_result.is_err():
            return Err(name_result.unwrap_err())
        Ok(())

    me finish() -> Result<ModuleSurfacesByName, text>:
        if self.frozen:
            return Err("module surface builder is frozen")
        val result = module_surfaces_by_name_from_parts(
            self.surfaces, self.index_by_name,
            self.ordered_names, self.ordered_indices)
        if result.is_ok():
            self.frozen = true
        result

    me resolve_export_origins() -> Result<(), text>:
        if self.frozen:
            return Err("module surface builder is frozen")
        # Build one package/name owner index up front. Stage4 carries thousands
        # of exports, so scanning every surface for every plain export turns
        # this boundary into O(exports * surfaces).
        var owner_by_package_name: Dict<text, i64> = {}
        # Routing and collision identity are deliberately separate. A public
        # facade remains the route used by sibling consumers, while duplicate
        # candidates are compared by their terminal declaration pair.
        var owner_source_by_package_name: Dict<text, text> = {}
        var owner_terminal_module_by_package_name: Dict<text, text> = {}
        var owner_terminal_source_by_package_name: Dict<text, text> = {}
        var owner_surface_index = 0
        while owner_surface_index < self.surfaces.len():
            val owner_surface = self.surfaces[owner_surface_index]
            val owner_package = module_surface_package_name(owner_surface)
            # Keep category order and collision handling unchanged, but visit
            # each key array directly. Building one cumulative array retained
            # every intermediate concatenation in the no-GC Stage4 process.
            for declaration_name in owner_surface.callables.keys():
                val owner_key = "{owner_package}::{declaration_name}"
                if owner_by_package_name.contains_key(owner_key):
                    val previous_index = owner_by_package_name[owner_key]
                    val previous_index_result = module_surface_validate_owner_index(
                        previous_index, self.surfaces.len())
                    if previous_index_result.is_err():
                        return Err(previous_index_result.unwrap_err())
                    if previous_index >= 0 and
                       self.surfaces[previous_index].canonical_path != owner_surface.canonical_path:
                        owner_by_package_name[owner_key] = -2
                else:
                    owner_by_package_name[owner_key] = owner_surface_index
                    owner_source_by_package_name[owner_key] = declaration_name
                    owner_terminal_module_by_package_name[owner_key] = owner_surface.module_name
                    owner_terminal_source_by_package_name[owner_key] = declaration_name
            for declaration_name in owner_surface.composites.keys():
                val owner_key = "{owner_package}::{declaration_name}"
                if owner_by_package_name.contains_key(owner_key):
                    val previous_index = owner_by_package_name[owner_key]
                    val previous_index_result = module_surface_validate_owner_index(
                        previous_index, self.surfaces.len())
                    if previous_index_result.is_err():
                        return Err(previous_index_result.unwrap_err())
                    if previous_index >= 0 and
                       self.surfaces[previous_index].canonical_path != owner_surface.canonical_path:
                        owner_by_package_name[owner_key] = -2
                else:
                    owner_by_package_name[owner_key] = owner_surface_index
                    owner_source_by_package_name[owner_key] = declaration_name
                    owner_terminal_module_by_package_name[owner_key] = owner_surface.module_name
                    owner_terminal_source_by_package_name[owner_key] = declaration_name
            for declaration_name in owner_surface.enums.keys():
                val owner_key = "{owner_package}::{declaration_name}"
                if owner_by_package_name.contains_key(owner_key):
                    val previous_index = owner_by_package_name[owner_key]
                    val previous_index_result = module_surface_validate_owner_index(
                        previous_index, self.surfaces.len())
                    if previous_index_result.is_err():
                        return Err(previous_index_result.unwrap_err())
                    if previous_index >= 0 and
                       self.surfaces[previous_index].canonical_path != owner_surface.canonical_path:
                        owner_by_package_name[owner_key] = -2
                else:
                    owner_by_package_name[owner_key] = owner_surface_index
                    owner_source_by_package_name[owner_key] = declaration_name
                    owner_terminal_module_by_package_name[owner_key] = owner_surface.module_name
                    owner_terminal_source_by_package_name[owner_key] = declaration_name
            for declaration_name in owner_surface.traits.keys():
                val owner_key = "{owner_package}::{declaration_name}"
                if owner_by_package_name.contains_key(owner_key):
                    val previous_index = owner_by_package_name[owner_key]
                    val previous_index_result = module_surface_validate_owner_index(
                        previous_index, self.surfaces.len())
                    if previous_index_result.is_err():
                        return Err(previous_index_result.unwrap_err())
                    if previous_index >= 0 and
                       self.surfaces[previous_index].canonical_path != owner_surface.canonical_path:
                        owner_by_package_name[owner_key] = -2
                else:
                    owner_by_package_name[owner_key] = owner_surface_index
                    owner_source_by_package_name[owner_key] = declaration_name
                    owner_terminal_module_by_package_name[owner_key] = owner_surface.module_name
                    owner_terminal_source_by_package_name[owner_key] = declaration_name
            for declaration_name in owner_surface.type_aliases.keys():
                val owner_key = "{owner_package}::{declaration_name}"
                if owner_by_package_name.contains_key(owner_key):
                    val previous_index = owner_by_package_name[owner_key]
                    val previous_index_result = module_surface_validate_owner_index(
                        previous_index, self.surfaces.len())
                    if previous_index_result.is_err():
                        return Err(previous_index_result.unwrap_err())
                    if previous_index >= 0 and
                       self.surfaces[previous_index].canonical_path != owner_surface.canonical_path:
                        owner_by_package_name[owner_key] = -2
                else:
                    owner_by_package_name[owner_key] = owner_surface_index
                    owner_source_by_package_name[owner_key] = declaration_name
                    owner_terminal_module_by_package_name[owner_key] = owner_surface.module_name
                    owner_terminal_source_by_package_name[owner_key] = declaration_name
            for declaration_name in owner_surface.constants.keys():
                val owner_key = "{owner_package}::{declaration_name}"
                if owner_by_package_name.contains_key(owner_key):
                    val previous_index = owner_by_package_name[owner_key]
                    val previous_index_result = module_surface_validate_owner_index(
                        previous_index, self.surfaces.len())
                    if previous_index_result.is_err():
                        return Err(previous_index_result.unwrap_err())
                    if previous_index >= 0 and
                       self.surfaces[previous_index].canonical_path != owner_surface.canonical_path:
                        owner_by_package_name[owner_key] = -2
                else:
                    owner_by_package_name[owner_key] = owner_surface_index
                    owner_source_by_package_name[owner_key] = declaration_name
                    owner_terminal_module_by_package_name[owner_key] = owner_surface.module_name
                    owner_terminal_source_by_package_name[owner_key] = declaration_name
            owner_surface_index = owner_surface_index + 1

        var surface_index = 0
        while surface_index < self.surfaces.len():
            var surface = self.surfaces[surface_index]
            for export_decl in surface.exports:
                for export_item in export_decl.items:
                    if export_item.ends_with(".*"):
                        continue
                    var source_name = export_item
                    var local_name = export_item
                    if export_item.contains(":"):
                        val parts = export_item.split(":")
                        source_name = parts[0]
                        if parts.len() > 1:
                            local_name = parts[1]

                    if module_surface_declares_item(surface, source_name):
                        val put_result = module_surface_export_origin_index_put(
                            surface.export_origin_index,
                            local_name, surface.module_name, source_name, "direct")
                        if put_result.is_err():
                            return Err(put_result.unwrap_err())
                        surface.export_origins = surface.export_origin_index.origins
                        continue

                    val imported_result = module_surface_explicit_import_origin(
                        self.surfaces, self.ordered_names, self.ordered_indices, surface,
                        source_name, local_name)
                    if imported_result.is_error:
                        return Err(imported_result.error)
                    if imported_result.found:
                        val put_result = module_surface_export_origin_index_put(
                            surface.export_origin_index,
                            local_name, imported_result.owner_module,
                            imported_result.source_name, imported_result.resolution_kind)
                        if put_result.is_err():
                            return Err(put_result.unwrap_err())
                        surface.export_origins = surface.export_origin_index.origins
                        continue

                    # Generated facade comments carry the precise source file
                    # when two sibling modules intentionally expose the same
                    # declaration. Keep that provenance ahead of inference.
                    val surface_origin_index: ModuleSurfaceExportOriginIndex = surface.export_origin_index
                    if module_surface_export_origin_index_lookup(surface_origin_index, local_name).found:
                        continue

                    # A matching named import has higher precedence than
                    # package inference even when its re-export owner is not
                    # resolved until a later fixpoint pass. A glob import is
                    # also explicit when its owner declares or exports this
                    # name; empty ParserImport.items is the parser's glob
                    # representation.
                    if module_surface_has_explicit_import_route(
                        self.surfaces, self.ordered_names, self.ordered_indices, surface,
                        source_name, local_name):
                        continue

                    val sibling_result = module_surface_unique_sibling_origin(
                        self.surfaces, owner_by_package_name,
                        owner_source_by_package_name,
                        surface, source_name)
                    if sibling_result.is_error:
                        return Err(sibling_result.error)
                    if sibling_result.found:
                        val put_result = module_surface_export_origin_index_put(
                            surface.export_origin_index,
                            local_name, sibling_result.owner_module,
                            sibling_result.source_name, sibling_result.resolution_kind)
                        if put_result.is_err():
                            return Err(put_result.unwrap_err())
                        surface.export_origins = surface.export_origin_index.origins
            self.surfaces[surface_index] = surface
            surface_index = surface_index + 1

        # Plain file-facade exports can be owned by a compatibility child
        # which itself only re-exports a concrete declaration. Those child
        # origins are not available in the direct-declaration index above and
        # may be discovered after the root facade (the Stage4 std.io graph is
        # exactly this order). Promote resolved child exports into the same
        # package/name index, then revisit only unresolved/inferred plain
        # exports until the graph reaches a fixpoint.
        #
        # Each productive pass resolves or upgrades at least one finite export
        # slot. The extra pass proves quiescence; bounding by slots rather than
        # surfaces also covers multiple delayed chains on one facade.
        var origin_pass = 0
        var max_origin_passes = 1
        for bounded_surface in self.surfaces:
            for bounded_export in bounded_surface.exports:
                for bounded_item in bounded_export.items:
                    if not bounded_item.ends_with(".*"):
                        max_origin_passes = max_origin_passes + 1
        var origin_changed = true
        while origin_changed and origin_pass < max_origin_passes:
            origin_changed = false

            var exported_owner_index = 0
            while exported_owner_index < self.surfaces.len():
                val exported_owner = self.surfaces[exported_owner_index]
                val exported_owner_name = module_surface_canonical_module_name(exported_owner.module_name)
                # A package __init__ is the facade being resolved, not one of
                # its child owners. Indexing its inferred exports beside the
                # real child makes every stable later pass manufacture an
                # ambiguity between facade and owner.
                if exported_owner_name.ends_with(".__init__"):
                    exported_owner_index = exported_owner_index + 1
                    continue
                val exported_package = module_surface_package_name(exported_owner)
                var exported_origin_index = 0
                while exported_origin_index < exported_owner.export_origin_index.names.len():
                    val exported_name = exported_owner.export_origin_index.names[exported_origin_index]
                    val exported_origin_owner = exported_owner.export_origin_index.owner_modules[exported_origin_index]
                    val exported_origin_source = exported_owner.export_origin_index.source_names[exported_origin_index]
                    val owner_key = "{exported_package}::{exported_name}"
                    if owner_by_package_name.contains_key(owner_key):
                        val previous_index = owner_by_package_name[owner_key]
                        val previous_index_result = module_surface_validate_owner_index(
                            previous_index, self.surfaces.len())
                        if previous_index_result.is_err():
                            return Err(previous_index_result.unwrap_err())
                        if previous_index >= 0:
                            val previous_terminal_module = if owner_terminal_module_by_package_name.contains_key(owner_key):
                                owner_terminal_module_by_package_name[owner_key]
                            else:
                                self.surfaces[previous_index].module_name
                            val previous_terminal_source = if owner_terminal_source_by_package_name.contains_key(owner_key):
                                owner_terminal_source_by_package_name[owner_key]
                            else:
                                owner_source_by_package_name[owner_key]
                            if (previous_terminal_module != exported_origin_owner or
                                previous_terminal_source != exported_origin_source):
                                owner_by_package_name[owner_key] = -2
                    else:
                        # Preserve the exporting surface as the semantic route;
                        # its visibility and alias name still matter to import
                        # lowering even though ambiguity is terminal-based.
                        owner_by_package_name[owner_key] = exported_owner_index
                        owner_source_by_package_name[owner_key] = exported_name
                        owner_terminal_module_by_package_name[owner_key] = exported_origin_owner
                        owner_terminal_source_by_package_name[owner_key] = exported_origin_source
                    exported_origin_index = exported_origin_index + 1
                exported_owner_index = exported_owner_index + 1

            var revisit_index = 0
            while revisit_index < self.surfaces.len():
                var revisit_surface = self.surfaces[revisit_index]
                for export_decl in revisit_surface.exports:
                    for export_item in export_decl.items:
                        if export_item.ends_with(".*"):
                            continue
                        var source_name = export_item
                        var local_name = export_item
                        if export_item.contains(":"):
                            val parts = export_item.split(":")
                            source_name = parts[0]
                            if parts.len() > 1:
                                local_name = parts[1]

                        # Direct/explicit/generated origins are final. A
                        # plain-sibling origin is rechecked so a later second
                        # child makes the graph fail closed as ambiguous.
                        if module_surface_declares_item(revisit_surface, source_name):
                            continue
                        val imported_result = module_surface_explicit_import_origin(
                            self.surfaces, self.ordered_names, self.ordered_indices, revisit_surface,
                            source_name, local_name)
                        if imported_result.is_error:
                            return Err(imported_result.error)
                        if imported_result.found:
                            val revisit_origin_index_explicit: ModuleSurfaceExportOriginIndex = revisit_surface.export_origin_index
                            val previous_origin = module_surface_export_origin_index_lookup(revisit_origin_index_explicit, local_name)
                            var needs_update = not previous_origin.found
                            if not needs_update:
                                needs_update = previous_origin.owner_module != imported_result.owner_module or
                                    previous_origin.source_name != imported_result.source_name or
                                    previous_origin.resolution_kind != imported_result.resolution_kind
                            if needs_update:
                                val put_result = module_surface_export_origin_index_put(
                                    revisit_surface.export_origin_index,
                                    local_name, imported_result.owner_module,
                                    imported_result.source_name, imported_result.resolution_kind)
                                if put_result.is_err():
                                    return Err(put_result.unwrap_err())
                                revisit_surface.export_origins = revisit_surface.export_origin_index.origins
                                origin_changed = true
                            continue
                        if module_surface_has_explicit_import_route(
                            self.surfaces, self.ordered_names, self.ordered_indices, revisit_surface,
                            source_name, local_name):
                            continue
                        val revisit_origin_index_retained: ModuleSurfaceExportOriginIndex = revisit_surface.export_origin_index
                        val retained_origin = module_surface_export_origin_index_lookup(revisit_origin_index_retained, local_name)
                        if retained_origin.found and
                           retained_origin.resolution_kind != "plain-sibling":
                            continue

                        val sibling_result = module_surface_unique_sibling_origin(
                            self.surfaces, owner_by_package_name,
                            owner_source_by_package_name,
                            revisit_surface, source_name)
                        if sibling_result.is_error:
                            return Err(sibling_result.error)
                        if sibling_result.found:
                            val revisit_origin_index_sibling: ModuleSurfaceExportOriginIndex = revisit_surface.export_origin_index
                            val previous_origin = module_surface_export_origin_index_lookup(revisit_origin_index_sibling, local_name)
                            var needs_update = not previous_origin.found
                            if not needs_update:
                                needs_update = previous_origin.owner_module != sibling_result.owner_module or
                                    previous_origin.source_name != sibling_result.source_name or
                                    previous_origin.resolution_kind != sibling_result.resolution_kind
                            if needs_update:
                                val put_result = module_surface_export_origin_index_put(
                                    revisit_surface.export_origin_index,
                                    local_name, sibling_result.owner_module,
                                    sibling_result.source_name, sibling_result.resolution_kind)
                                if put_result.is_err():
                                    return Err(put_result.unwrap_err())
                                revisit_surface.export_origins = revisit_surface.export_origin_index.origins
                                origin_changed = true
                self.surfaces[revisit_index] = revisit_surface
                revisit_index = revisit_index + 1
            origin_pass = origin_pass + 1

        if origin_changed:
            return Err("facade export origin resolution did not converge after {max_origin_passes} passes")
        Ok(())

fn module_surfaces_validate_index_alignment(
    surfaces: [ModuleSurface],
    index_by_name: Dict<text, i64>,
    ordered_names: [text],
    ordered_indices: [i64]
) -> Result<(), text>:
    if ordered_names.len() != ordered_indices.len():
        return Err("module surface name/index arrays have different lengths")

    # The compatibility dictionary is checked once at construction/finalize,
    # never from the hot lookup helpers.  keys() and values() are aligned by
    # dict_collect, so this validates both membership and scalar identity.
    val dict_names = index_by_name.keys()
    val dict_indices = index_by_name.values()
    if dict_names.len() != dict_indices.len() or
       dict_names.len() != ordered_names.len():
        return Err("module surface name/index representation is inconsistent")

    var i = 0
    while i < ordered_names.len():
        if ordered_indices[i] < 0 or ordered_indices[i] >= surfaces.len():
            return Err("module surface index out of range for {ordered_names[i]}")
        var prior = 0
        while prior < i:
            if ordered_names[prior] == ordered_names[i]:
                return Err("duplicate ordered module surface name: {ordered_names[i]}")
            prior = prior + 1
        var dict_position = 0
        var found = false
        while dict_position < dict_names.len():
            if dict_names[dict_position] == ordered_names[i]:
                if dict_indices[dict_position] != ordered_indices[i]:
                    return Err("module surface name maps to conflicting indices: {ordered_names[i]}")
                found = true
            dict_position = dict_position + 1
        if not found:
            return Err("module surface ordered name missing from compatibility index: {ordered_names[i]}")
        i = i + 1
    Ok(())

fn module_surfaces_by_name_from_parts(
    surfaces: [ModuleSurface],
    index_by_name: Dict<text, i64>,
    ordered_names: [text],
    ordered_indices: [i64]
) -> Result<ModuleSurfacesByName, text>:
    val validation = module_surfaces_validate_index_alignment(
        surfaces, index_by_name, ordered_names, ordered_indices)
    if validation.is_err():
        return Err(validation.unwrap_err())
    var registry = ModuleSurfacesByName(
        surfaces: surfaces,
        index_by_name: index_by_name,
        ordered_names: ordered_names,
        ordered_indices: ordered_indices,
        generation: 0,
        frozen: false)
    val freeze_result = module_surfaces_freeze(registry)
    if freeze_result.is_err():
        return Err(freeze_result.unwrap_err())
    Ok(freeze_result.unwrap())

fn module_surface_declares_item(surface: ModuleSurface, name: text) -> bool:
    surface.callables.contains_key(name) or
        surface.composites.contains_key(name) or
        surface.enums.contains_key(name) or
        surface.traits.contains_key(name) or
        surface.type_aliases.contains_key(name) or
        surface.constants.contains_key(name)

fn module_surface_origin_missing() -> ModuleSurfaceOriginResolution:
    ModuleSurfaceOriginResolution(
        is_error: false, error: "", found: false,
        owner_module: "", source_name: "", resolution_kind: "")

fn module_surface_origin_found(
    owner_module: text,
    source_name: text,
    resolution_kind: text
) -> ModuleSurfaceOriginResolution:
    ModuleSurfaceOriginResolution(
        is_error: false, error: "", found: true,
        owner_module: owner_module, source_name: source_name,
        resolution_kind: resolution_kind)

fn module_surface_origin_error(message: text) -> ModuleSurfaceOriginResolution:
    ModuleSurfaceOriginResolution(
        is_error: true, error: message, found: false,
        owner_module: "", source_name: "", resolution_kind: "")

fn module_surface_explicit_import_origin(
    surfaces: [ModuleSurface],
    ordered_names: [text],
    ordered_indices: [i64],
    facade: ModuleSurface,
    source_name: text,
    local_name: text
) -> ModuleSurfaceOriginResolution:
    # Named imports are the strict first tier. If a matching named route is
    # delayed, do not let a currently-resolved glob route replace it.
    var has_named_route = false
    for import_decl in facade.imports:
        if module_surface_import_owner_is_physical_self(
            surfaces, ordered_names, ordered_indices, facade, import_decl.module):
            continue
        for item in import_decl.items:
            val imported_local = if item.has_alias: item.alias else: item.name
            if imported_local == source_name or imported_local == local_name:
                has_named_route = true

    var found = false
    var selected = ModuleSurfaceExportOrigin(
        owner_module: "", source_name: "", resolution_kind: "")
    if has_named_route:
        for import_decl in facade.imports:
            val owner_index = module_surface_index_by_name(
                ordered_names, ordered_indices, import_decl.module)
            if owner_index < 0 or owner_index >= surfaces.len():
                continue
            val owner = surfaces[owner_index]
            if owner.canonical_path == facade.canonical_path:
                continue
            for item in import_decl.items:
                val imported_local = if item.has_alias: item.alias else: item.name
                if imported_local != source_name and imported_local != local_name:
                    continue
                var candidate_found = false
                var candidate = ModuleSurfaceExportOrigin(
                    owner_module: "", source_name: "", resolution_kind: "")
                if module_surface_declares_item(owner, item.name):
                    candidate = ModuleSurfaceExportOrigin(
                        owner_module: owner.module_name,
                        source_name: item.name,
                        resolution_kind: if item.has_alias: "alias" else: "explicit"
                    )
                    candidate_found = true
                else:
                    val owner_origin_index_item: ModuleSurfaceExportOriginIndex = owner.export_origin_index
                    val terminal_lookup = module_surface_export_origin_index_lookup(owner_origin_index_item, item.name)
                    if terminal_lookup.found:
                        candidate = ModuleSurfaceExportOrigin(
                            owner_module: terminal_lookup.owner_module,
                            source_name: terminal_lookup.source_name,
                            resolution_kind: if item.has_alias: "alias" else: "explicit"
                        )
                        candidate_found = true
                if not candidate_found:
                    continue
                if not found:
                    selected = candidate
                    found = true
                elif (selected.owner_module != candidate.owner_module or
                      selected.source_name != candidate.source_name):
                    return module_surface_origin_error(
                        "ambiguous explicit facade export: module={facade.module_name} item={local_name}")
        if found:
            return module_surface_origin_found(
                selected.owner_module, selected.source_name, selected.resolution_kind)
        return module_surface_origin_missing()

    # A wildcard import is encoded with no ImportItems. Resolve all matching
    # wildcard owners and deduplicate them by terminal declaration identity;
    # two distinct terminals remain a real ambiguity.
    for import_decl in facade.imports:
        if import_decl.items.len() != 0:
            continue
        val owner_index = module_surface_index_by_name(
            ordered_names, ordered_indices, import_decl.module)
        if owner_index < 0 or owner_index >= surfaces.len():
            continue
        val owner = surfaces[owner_index]
        if owner.canonical_path == facade.canonical_path:
            continue
        var candidate_found = false
        var candidate = ModuleSurfaceExportOrigin(
            owner_module: "", source_name: "", resolution_kind: "")
        if module_surface_declares_item(owner, source_name):
            candidate = ModuleSurfaceExportOrigin(
                owner_module: owner.module_name,
                source_name: source_name,
                resolution_kind: "glob"
            )
            candidate_found = true
        else:
            val owner_origin_index_source: ModuleSurfaceExportOriginIndex = owner.export_origin_index
            val terminal_lookup = module_surface_export_origin_index_lookup(owner_origin_index_source, source_name)
            if terminal_lookup.found:
                candidate = ModuleSurfaceExportOrigin(
                    owner_module: terminal_lookup.owner_module,
                    source_name: terminal_lookup.source_name,
                    resolution_kind: "glob"
                )
                candidate_found = true
        if not candidate_found:
            continue
        if not found:
            selected = candidate
            found = true
        elif (selected.owner_module != candidate.owner_module or
              selected.source_name != candidate.source_name):
            return module_surface_origin_error(
                "ambiguous explicit facade export: module={facade.module_name} item={local_name}")
    if found:
        module_surface_origin_found(
            selected.owner_module, selected.source_name, selected.resolution_kind)
    else:
        module_surface_origin_missing()

fn module_surface_has_explicit_import_route(
    surfaces: [ModuleSurface],
    ordered_names: [text],
    ordered_indices: [i64],
    facade: ModuleSurface,
    source_name: text,
    local_name: text
) -> bool:
    # A named item is unconditionally explicit, including while its owner is
    # pending. It must retain precedence over every wildcard route.
    for import_decl in facade.imports:
        if module_surface_import_owner_is_physical_self(
            surfaces, ordered_names, ordered_indices, facade, import_decl.module):
            continue
        for item in import_decl.items:
            val imported_local = if item.has_alias: item.alias else: item.name
            if imported_local == source_name or imported_local == local_name:
                return true
    # An unrelated wildcard must not block valid sibling inference. Treat it
    # as a matching route only when the owner already declares/resolves the
    # name or syntactically promises that exported spelling for a later pass.
    for import_decl in facade.imports:
        if import_decl.items.len() != 0:
            continue
        val owner_index = module_surface_index_by_name(
            ordered_names, ordered_indices, import_decl.module)
        if owner_index < 0 or owner_index >= surfaces.len():
            continue
        val owner = surfaces[owner_index]
        if owner.canonical_path == facade.canonical_path:
            continue
        if module_surface_declares_item(owner, source_name) or
           owner.export_origins.contains_key(source_name) or
           module_surface_syntactically_exports(owner, source_name):
            return true
    false

fn module_surface_import_owner_is_physical_self(
    surfaces: [ModuleSurface],
    ordered_names: [text],
    ordered_indices: [i64],
    facade: ModuleSurface,
    imported_module: text
) -> bool:
    # One parsed file may be indexed under both `lib.*` and `std.*` spellings.
    # A compatibility glob that resolves through that alias is a self-cycle,
    # not an explicit owner route. Let sibling/fixpoint resolution find the
    # concrete child instead of allowing the self facade to mask it forever.
    val owner_index = module_surface_index_by_name(
        ordered_names, ordered_indices, imported_module)
    if owner_index < 0 or owner_index >= surfaces.len():
        return false
    surfaces[owner_index].canonical_path == facade.canonical_path

fn module_surface_index_by_name(
    names: [text], indices: [i64], name: text) -> i64:
    # The arrays are built once by ModuleSurfaceBuilder and passed through the
    # resolution pass.  Never materialize Dict keys/values in this hot lookup.
    var index = 0
    while index < names.len() and index < indices.len():
        if names[index] == name:
            return indices[index]
        index = index + 1
    -1

fn module_surface_syntactically_exports(surface: ModuleSurface, name: text) -> bool:
    for export_decl in surface.exports:
        for export_item in export_decl.items:
            if export_item == "*" or export_item.ends_with(".*"):
                return true
            var local_name = export_item
            if export_item.contains(":"):
                val parts = export_item.split(":")
                if parts.len() > 1:
                    local_name = parts[1]
            if local_name == name:
                return true
    false

fn module_surface_canonical_module_name(name: text) -> text:
    var dotted = name
    if dotted.ends_with(".spl"):
        dotted = dotted[0:dotted.len() - 4]
    dotted = dotted.replace("/", ".")
    if dotted.starts_with("src."):
        dotted = dotted.substring(4)
    var result: [text] = []
    for segment in dotted.split("."):
        var digits_only = segment != ""
        var i = 0
        while i < segment.len():
            val code = segment.char_code_at(i)
            if code < 48 or code > 57:
                digits_only = false
            i = i + 1
        if not digits_only:
            result = result.push(segment)
    val canonical = result.join(".")
    if canonical == "std":
        return "lib"
    if canonical.starts_with("std."):
        return "lib." + canonical.substring(4)
    canonical

fn module_surface_logical_name_from_path(path: text) -> text:
    # Match the prior hir_module_logical_name_from_path contract: derive the
    # logical name from the physical path, strip only repository roots and
    # source extensions, then sanitize. Do not apply tier, std, or lib folds.
    var portable_path = path.replace("\\", "/")
    while portable_path.starts_with("../"):
        portable_path = portable_path.substring(3)
    if portable_path.starts_with("./"):
        portable_path = portable_path.substring(2)
    val path_parts = portable_path.split("/")
    var start = 0
    var found_src = false
    var part_index = 0
    while part_index < path_parts.len():
        if path_parts[part_index] == "src" and not found_src:
            start = part_index + 1
            found_src = true
        elif path_parts[part_index] == "examples" and not found_src and start == 0:
            start = part_index
        part_index = part_index + 1
    var relative_path = ""
    var relative_index = start
    while relative_index < path_parts.len():
        if relative_index > start:
            relative_path = relative_path + "/"
        relative_path = relative_path + path_parts[relative_index]
        relative_index = relative_index + 1
    if relative_path == "":
        relative_path = portable_path
    relative_path = relative_path.replace(".spl", "")
    relative_path = relative_path.replace(".sdn", "")
    var sanitized = ""
    var char_index = 0
    while char_index < relative_path.len():
        val code = relative_path.char_code_at(char_index)
        val allowed = (code >= 97 and code <= 122) or
            (code >= 65 and code <= 90) or
            (code >= 48 and code <= 57) or
            code == 95 or code == 46 or code == 47
        if allowed:
            sanitized = sanitized + relative_path.char_at(char_index)
        else:
            sanitized = sanitized + "_"
        char_index = char_index + 1
    sanitized.replace("/", ".")

fn module_surface_package_name(surface: ModuleSurface) -> text:
    module_surface_package_name_from_name(
        module_surface_canonical_module_name(surface.module_name))

fn module_surface_package_name_from_name(name: text) -> text:
    if name.ends_with(".__init__"):
        return name[0:name.len() - 9]
    val segments = name.split(".")
    if segments.len() <= 1:
        return ""
    segments[0:segments.len() - 1].join(".")

fn module_surface_validate_owner_index(previous_index: i64, surface_count: i64) -> Result<(), text>:
    if previous_index >= 0 and previous_index >= surface_count:
        return Err("invalid module surface owner index: index={previous_index} len={surface_count}")
    Ok(())

fn module_surface_registry_index(registry: ModuleSurfacesByName, name: text) -> i64:
    if not registry.index_by_name.contains_key(name):
        return -1
    val index = registry.index_by_name[name]
    if index < 0 or index >= registry.surfaces.len():
        return -1
    index

fn module_surface_resolve_absolute_key(
    registry: ModuleSurfacesByName,
    name: text
) -> text:
    if module_surface_registry_index(registry, name) >= 0:
        return name
    var candidates: [text] = []
    candidates = candidates.push(name + ".__init__")
    candidates = candidates.push("lib." + name)
    candidates = candidates.push("lib." + name + ".__init__")
    if name.starts_with("std."):
        val std_tail = name.substring(4)
        val lib_tail = "lib." + std_tail
        candidates = candidates.push(lib_tail)
        candidates = candidates.push(lib_tail + ".__init__")
        for tier in ["nogc_async_mut", "nogc_sync_mut", "nogc_async_immut", "common", "gc_async_mut", "nogc_async_mut_noalloc"]:
            val tier_key = "lib." + tier + "." + std_tail
            candidates = candidates.push(tier_key)
            candidates = candidates.push(tier_key + ".__init__")
            val tier_std_key = "std." + tier + "." + std_tail
            candidates = candidates.push(tier_std_key)
            candidates = candidates.push(tier_std_key + ".__init__")
    var candidate_index = 0
    while candidate_index < candidates.len():
        if module_surface_registry_index(registry, candidates[candidate_index]) >= 0:
            return candidates[candidate_index]
        candidate_index = candidate_index + 1
    ""

fn module_surface_resolve_relative_key(
    registry: ModuleSurfacesByName,
    facade: ModuleSurface,
    name: text
) -> text:
    if not name.starts_with("."):
        return module_surface_resolve_absolute_key(registry, name)
    var dots = 0
    while dots < name.len() and name.substring(dots, dots + 1) == ".":
        dots = dots + 1
    val tail = name.substring(dots)
    if tail == "":
        return ""
    var package_name = facade.canonical_name
    var package_index = 0
    while package_index < dots:
        package_name = module_surface_package_name_from_name(package_name)
        package_index = package_index + 1
    val absolute_name = if package_name == "": tail else package_name + "." + tail
    if module_surface_registry_index(registry, absolute_name) >= 0:
        return absolute_name
    module_surface_resolve_absolute_key(registry, absolute_name)

fn module_surface_resolve_import_key(
    registry: ModuleSurfacesByName,
    facade: ModuleSurface,
    name: text
) -> text:
    var resolved = module_surface_resolve_relative_key(registry, facade, name)
    if resolved == "":
        return ""
    val resolved_index = module_surface_registry_index(registry, resolved)
    if resolved_index < 0 or
       registry.surfaces[resolved_index].canonical_path != facade.canonical_path:
        return resolved
    if facade.canonical_name.ends_with(".__init__"):
        return resolved
    val package_key = module_surface_resolve_absolute_key(
        registry, facade.canonical_name + ".__init__")
    if package_key == "" or package_key == resolved:
        return resolved
    val package_index = module_surface_registry_index(registry, package_key)
    if package_index < 0 or
       registry.surfaces[package_index].canonical_path == facade.canonical_path:
        return resolved
    package_key

fn module_surface_preferred_registry_name(
    registry: ModuleSurfacesByName,
    surface: ModuleSurface
) -> Result<text, text>:
    var selected = ""
    var found = false
    var alias_index = 0
    while alias_index < registry.ordered_names.len() and
          alias_index < registry.ordered_indices.len():
        if registry.ordered_indices[alias_index] == surface.physical_index:
            val alias_name = registry.ordered_names[alias_index]
            found = true
            if selected == "" or alias_name < selected:
                selected = alias_name
            # Keep scanning so the result is independent of alias insertion
            # order and malformed data is still rejected by validation.
        alias_index = alias_index + 1
    if not found or selected == "":
        return Err("physical module surface has no ordered registry alias: {surface.physical_index}")
    if module_surface_registry_index(registry, selected) != surface.physical_index:
        return Err("preferred registry alias is not mapped to its physical surface: {selected}")
    Ok(selected)

fn module_surface_route_arrays_aligned(surface: ModuleSurface) -> bool:
    if surface.import_target_indices.len() != surface.imports.len() or
       surface.import_target_names.len() != surface.imports.len():
        return false
    if surface.export_route_sources.len() != surface.export_route_locals.len() or
       surface.export_route_sources.len() != surface.export_route_target_indices.len() or
       surface.export_route_sources.len() != surface.export_route_target_names.len() or
       surface.export_route_sources.len() != surface.export_route_is_glob.len():
        return false
    if surface.export_origin_index.names.len() != surface.export_origin_index.owner_modules.len() or
       surface.export_origin_index.names.len() != surface.export_origin_index.source_names.len() or
       surface.export_origin_index.names.len() != surface.export_origin_index.resolution_kinds.len():
        return false
    val origin_map = surface.export_origin_index.origins
    var origin_index = 0
    while origin_index < surface.export_origin_index.names.len():
        if not origin_map.contains_key(
            surface.export_origin_index.names[origin_index]):
            return false
        origin_index = origin_index + 1
    true

fn module_surfaces_frozen_alignment(registry: ModuleSurfacesByName) -> bool:
    if not registry.frozen or registry.generation == 0:
        return false
    if registry.ordered_names.len() != registry.ordered_indices.len():
        return false
    var alias_index = 0
    while alias_index < registry.ordered_indices.len():
        if registry.ordered_indices[alias_index] < 0 or
           registry.ordered_indices[alias_index] >= registry.surfaces.len():
            return false
        alias_index = alias_index + 1
    var surface_index = 0
    while surface_index < registry.surfaces.len():
        val surface = registry.surfaces[surface_index]
        if not surface.frozen or not surface.export_origin_index.frozen or
           surface.physical_index != surface_index or
           surface.generation != registry.generation or
           surface.preferred_registry_name == "" or
           module_surface_registry_index(registry, surface.preferred_registry_name) != surface_index or
           not module_surface_route_arrays_aligned(surface):
            return false
        surface_index = surface_index + 1
    true

fn module_surfaces_freeze(registry: ModuleSurfacesByName) -> Result<ModuleSurfacesByName, text>:
    if registry.frozen:
        return Err("module surface registry is already frozen")
    var existing_surface_index = 0
    while existing_surface_index < registry.surfaces.len():
        val existing_surface = registry.surfaces[existing_surface_index]
        if existing_surface.frozen or existing_surface.export_origin_index.frozen:
            return Err("module surface is already frozen: {existing_surface_index}")
        existing_surface_index = existing_surface_index + 1
    val validation = module_surfaces_validate_index_alignment(
        registry.surfaces, registry.index_by_name,
        registry.ordered_names, registry.ordered_indices)
    if validation.is_err():
        return Err(validation.unwrap_err())
    var surface_index = 0
    while surface_index < registry.surfaces.len():
        var surface = registry.surfaces[surface_index]
        surface.physical_index = surface_index
        surface.logical_name = module_surface_logical_name_from_path(surface.canonical_path)
        surface.canonical_name = surface.logical_name
        surface.package_name = module_surface_package_name_from_name(surface.logical_name)
        val preferred_result = module_surface_preferred_registry_name(registry, surface)
        if preferred_result.is_err():
            return Err(preferred_result.unwrap_err())
        surface.preferred_registry_name = preferred_result.unwrap()

        var import_target_indices: [i64] = []
        var import_target_names: [text] = []
        for import_decl in surface.imports:
            val target_name = module_surface_resolve_import_key(
                registry, surface, import_decl.module)
            var target_index = -1
            if target_name != "":
                target_index = module_surface_registry_index(registry, target_name)
            import_target_indices = import_target_indices.push(target_index)
            import_target_names = import_target_names.push(target_name)

        var export_route_sources: [text] = []
        var export_route_locals: [text] = []
        var export_route_target_indices: [i64] = []
        var export_route_target_names: [text] = []
        var export_route_is_glob: [bool] = []
        for export_decl in surface.exports:
            for export_item in export_decl.items:
                if export_item.ends_with(".*"):
                    val export_base = export_item[0:export_item.len() - 2]
                    var target_name = ""
                    if export_base.starts_with("."):
                        target_name = module_surface_resolve_relative_key(
                            registry, surface, export_base)
                    else:
                        target_name = module_surface_resolve_absolute_key(
                            registry, surface.package_name + "." + export_base)
                        if target_name == "":
                            target_name = module_surface_resolve_absolute_key(
                                registry, export_base)
                    export_route_sources = export_route_sources.push(export_base)
                    export_route_locals = export_route_locals.push("")
                    export_route_target_names = export_route_target_names.push(target_name)
                    var export_target_index = -1
                    if target_name != "":
                        export_target_index = module_surface_registry_index(registry, target_name)
                    export_route_target_indices = export_route_target_indices.push(export_target_index)
                    export_route_is_glob = export_route_is_glob.push(true)
                else:
                    var source_name = export_item
                    var local_name = export_item
                    if export_item.contains(":"):
                        val parts = export_item.split(":")
                        source_name = parts[0]
                        if parts.len() > 1:
                            local_name = parts[1]
                    export_route_sources = export_route_sources.push(source_name)
                    export_route_locals = export_route_locals.push(local_name)
                    export_route_target_indices = export_route_target_indices.push(-1)
                    export_route_target_names = export_route_target_names.push("")
                    export_route_is_glob = export_route_is_glob.push(false)

        surface.import_target_indices = import_target_indices
        surface.import_target_names = import_target_names
        surface.export_route_sources = export_route_sources
        surface.export_route_locals = export_route_locals
        surface.export_route_target_indices = export_route_target_indices
        surface.export_route_target_names = export_route_target_names
        surface.export_route_is_glob = export_route_is_glob
        registry.surfaces[surface_index] = surface
        surface_index = surface_index + 1

    surface_index = 0
    while surface_index < registry.surfaces.len():
        if not module_surface_route_arrays_aligned(registry.surfaces[surface_index]):
            return Err("frozen module surface route arrays are misaligned: {surface_index}")
        surface_index = surface_index + 1
    val generation_result = module_surface_allocate_generation()
    if generation_result.is_err():
        return Err(generation_result.unwrap_err())
    val generation = generation_result.unwrap()
    surface_index = 0
    while surface_index < registry.surfaces.len():
        var surface = registry.surfaces[surface_index]
        surface.generation = generation
        surface.frozen = true
        surface.export_origin_index.frozen = true
        registry.surfaces[surface_index] = surface
        surface_index = surface_index + 1
    registry.generation = generation
    registry.frozen = true
    Ok(registry)

fn module_surface_unique_sibling_origin(
    surfaces: [ModuleSurface],
    owner_by_package_name: Dict<text, i64>,
    owner_source_by_package_name: Dict<text, text>,
    facade: ModuleSurface,
    source_name: text
) -> ModuleSurfaceOriginResolution:
    val facade_name = module_surface_canonical_module_name(facade.module_name)
    val nested_owner_key = "{facade_name}::{source_name}"
    # A file facade can own a same-named sibling directory:
    # `lib/nogc_sync_mut/io.spl` represents declarations under `io/*.spl`.
    # Prefer that exact directory package when it has an indexed owner. An
    # `__init__` facade already names the directory explicitly and ordinary
    # modules without children retain parent-sibling semantics below.
    var facade_package = module_surface_package_name(facade)
    if not facade_name.ends_with(".__init__") and
       owner_by_package_name.contains_key(nested_owner_key):
        facade_package = facade_name
    if facade_package == "":
        return module_surface_origin_missing()
    val owner_key = "{facade_package}::{source_name}"
    if not owner_by_package_name.contains_key(owner_key):
        return module_surface_origin_missing()
    val matching_index = owner_by_package_name[owner_key]
    if matching_index == -2:
        return module_surface_origin_error(
            "ambiguous facade export: module={facade.module_name} item={source_name} package={facade_package}")
    if matching_index < 0 or matching_index >= surfaces.len():
        return module_surface_origin_missing()
    val owner = surfaces[matching_index]
    val terminal_source_name = if owner_source_by_package_name.contains_key(owner_key):
        owner_source_by_package_name[owner_key]
    else:
        source_name
    module_surface_origin_found(
        owner.module_name, terminal_source_name, "plain-sibling")

fn module_surface_callable_from_function(function_: ParserFunction) -> ModuleSurfaceCallable:
    var params: [ModuleSurfaceParam] = []
    for param in function_.params:
        params = params.push(ModuleSurfaceParam(
            name: param.name,
            has_type_: param.has_type_,
            type_: param.type_,
            type_name: parser_type_kind_named_name(param.type_.kind),
            array_element_name: parser_type_kind_array_element_name(param.type_.kind),
            has_default: false,
            is_mutable: param.is_mutable,
            span: param.span
        ))
    ModuleSurfaceCallable(
        name: function_.name,
        type_params: function_.type_params,
        params: params,
        has_return_type: function_.has_return_type,
        return_type: function_.return_type,
        return_type_name: parser_type_kind_named_name(function_.return_type.kind),
        return_array_element_name: parser_type_kind_array_element_name(function_.return_type.kind),
        visibility: function_.visibility,
        is_async: function_.is_async,
        is_static: function_.is_static,
        is_public: function_.is_public,
        is_method: function_.is_method,
        is_mutable: function_.is_mutable,
        is_const: function_.is_const,
        is_kernel: function_.is_kernel,
        is_extern: function_.is_extern,
        span: function_.span
    )

fn module_surface_trait_from_trait(trait_: ParserTrait) -> ModuleSurfaceTrait:
    var methods: [ModuleSurfaceCallable] = []
    var default_methods: [ParserFunction] = []
    for method in trait_.methods:
        methods = methods.push(module_surface_callable_from_function(method))
        if not method.body.stmts.is_empty():
            default_methods = default_methods.push(method)
    ModuleSurfaceTrait(
        name: trait_.name,
        type_params: trait_.type_params,
        super_traits: trait_.super_traits,
        where_clause: trait_.where_clause,
        methods: methods,
        default_methods: default_methods,
        assoc_types: trait_.assoc_types,
        visibility: trait_.visibility,
        is_public: trait_.is_public,
        span: trait_.span
    )

fn module_surface_impl_from_impl(impl_: Impl) -> ModuleSurfaceImpl:
    var methods: Dict<text, ModuleSurfaceCallable> = {}
    for name in impl_.methods.keys():
        methods[name] = module_surface_callable_from_function(impl_.methods[name])
    ModuleSurfaceImpl(
        type_: impl_.type_,
        has_trait_: impl_.has_trait_,
        trait_: impl_.trait_,
        methods: methods
    )

fn module_surface_export_origin_hints(
    source: SourceFile, origins: ModuleSurfaceExportOriginIndex
) -> Result<bool, text>:
    # Most modules are not generated facades. Avoid splitting their complete
    # source into per-line text objects: the no-GC bootstrap runtime retains
    # those strings for the process lifetime even though this scanner cannot
    # produce a hint without the exact generator marker.
    if not source.content.contains("# Re-exported from "):
        return Ok(true)
    var owner_file = ""
    var facade_name = module_surface_canonical_module_name(source.module_name)
    if facade_name.ends_with(".__init__"):
        facade_name = facade_name[0:facade_name.len() - 9]
    for raw_line in source.content.split("\n"):
        val line = raw_line.trim()
        if line.starts_with("# Re-exported from ") and line.contains(".spl"):
            val owner_parts = line.substring(19).split(".spl")
            owner_file = owner_parts[0]
            continue
        if owner_file != "" and line.starts_with("export "):
            val owner_module = facade_name + "." + owner_file.replace("/", ".")
            for raw_item in line.substring(7).split(","):
                val item = raw_item.trim()
                if item != "" and not item.ends_with(".*"):
                    var source_name = item
                    var local_name = item
                    if item.contains(":"):
                        val parts = item.split(":")
                        source_name = parts[0].trim()
                        if parts.len() > 1:
                            local_name = parts[1].trim()
                    val put_result = module_surface_export_origin_index_put(
                        origins, local_name, owner_module, source_name,
                        "generated-comment")
                    if put_result.is_err():
                        return Err(put_result.unwrap_err())
            owner_file = ""
        elif line != "" and not line.starts_with("#"):
            owner_file = ""
    Ok(true)

fn module_surface_from_module(
    module: ParserModule, source: SourceFile, source_index: i64
) -> Result<ModuleSurface, text>:
    var callables: Dict<text, ModuleSurfaceCallable> = {}
    for name in module.functions.keys():
        callables[name] = module_surface_callable_from_function(module.functions[name])

    var composites: Dict<text, ModuleSurfaceComposite> = {}
    for name in module.classes.keys():
        val class_ = module.classes[name]
        var fields: [ModuleSurfaceField] = []
        for field in class_.fields:
            fields = fields.push(ModuleSurfaceField(
                name: field.name,
                type_: field.type_,
                type_name: parser_type_kind_named_name(field.type_.kind),
                array_element_name: parser_type_kind_array_element_name(field.type_.kind)))
        composites[name] = ModuleSurfaceComposite(name: class_.name, kind: "class", type_params: class_.type_params, fields: fields, visibility: class_.visibility, is_public: class_.is_public, span: class_.span)
    for name in module.actors.keys():
        val actor = module.actors[name]
        var fields: [ModuleSurfaceField] = []
        for field in actor.fields:
            fields = fields.push(ModuleSurfaceField(
                name: field.name,
                type_: field.type_,
                type_name: parser_type_kind_named_name(field.type_.kind),
                array_element_name: parser_type_kind_array_element_name(field.type_.kind)))
        composites[name] = ModuleSurfaceComposite(name: actor.name, kind: "actor", type_params: actor.type_params, fields: fields, visibility: actor.visibility, is_public: actor.is_public, span: actor.span)
    for name in module.structs.keys():
        val struct_ = module.structs[name]
        var fields: [ModuleSurfaceField] = []
        for field in struct_.fields:
            fields = fields.push(ModuleSurfaceField(
                name: field.name,
                type_: field.type_,
                type_name: parser_type_kind_named_name(field.type_.kind),
                array_element_name: parser_type_kind_array_element_name(field.type_.kind)))
        composites[name] = ModuleSurfaceComposite(name: struct_.name, kind: "struct", type_params: struct_.type_params, fields: fields, visibility: struct_.visibility, is_public: struct_.is_public, span: struct_.span)

    var enums: Dict<text, ModuleSurfaceEnum> = {}
    for name in module.enums.keys():
        val enum_ = module.enums[name]
        enums[name] = ModuleSurfaceEnum(name: enum_.name, type_params: enum_.type_params, variants: enum_.variants, visibility: enum_.visibility, is_public: enum_.is_public, span: enum_.span)

    var traits: Dict<text, ModuleSurfaceTrait> = {}
    for name in module.traits.keys():
        traits[name] = module_surface_trait_from_trait(module.traits[name])

    var impls: [ModuleSurfaceImpl] = []
    for impl_ in module.impls:
        impls = impls.push(module_surface_impl_from_impl(impl_))

    var type_aliases: Dict<text, ModuleSurfaceTypeAlias> = {}
    for name in module.type_aliases.keys():
        val alias = module.type_aliases[name]
        type_aliases[name] = ModuleSurfaceTypeAlias(
            name: alias.name,
            type_params: alias.type_params,
            type_: alias.type_,
            visibility: alias.visibility,
            is_public: alias.is_public,
            span: alias.span
        )

    var constants: Dict<text, ModuleSurfaceConst> = {}
    for name in module.constants.keys():
        val constant = module.constants[name]
        constants[name] = ModuleSurfaceConst(
            name: constant.name,
            has_type_: constant.has_type_,
            type_: constant.type_,
            is_mutable: constant.is_mutable,
            visibility: constant.visibility,
            is_public: constant.is_public,
            is_volatile: constant.is_volatile,
            has_fixed_address: constant.has_fixed_address,
            fixed_address: constant.fixed_address,
            span: constant.span
        )

    # Keep the class payload caller-owned. Native generic Result payload
    # lowering is not an ownership boundary for reference-valued classes.
    val origin_hints = module_surface_export_origin_index_empty()
    val origin_hints_result = module_surface_export_origin_hints(
        source, origin_hints)
    if origin_hints_result.is_err():
        return Err(origin_hints_result.unwrap_err())
    val composite_names = composites.keys()
    val enum_names = enums.keys()
    val trait_names = traits.keys()
    val callable_names = callables.keys()
    val type_alias_names = type_aliases.keys()
    val constant_names = constants.keys()
    Ok(ModuleSurface(
        physical_index: source_index,
        generation: 0,
        frozen: false,
        source_index: source_index,
        canonical_path: module_surface_canonical_path(source.path),
        module_name: source.module_name,
        logical_name: module_surface_logical_name_from_path(source.path),
        canonical_name: module_surface_logical_name_from_path(source.path),
        package_name: module_surface_package_name_from_name(
            module_surface_logical_name_from_path(source.path)),
        preferred_registry_name: "",
        content_length: source.content.len(),
        content_hash: rt_hash_text(source.content),
        imports: module.imports,
        exports: module.exports,
        import_target_indices: [],
        import_target_names: [],
        export_route_sources: [],
        export_route_locals: [],
        export_route_target_indices: [],
        export_route_target_names: [],
        export_route_is_glob: [],
        composite_names: composite_names,
        enum_names: enum_names,
        trait_names: trait_names,
        callable_names: callable_names,
        type_alias_names: type_alias_names,
        constant_names: constant_names,
        callables: callables,
        composites: composites,
        enums: enums,
        traits: traits,
        impls: impls,
        type_aliases: type_aliases,
        constants: constants,
        export_origins: origin_hints.origins,
        export_origin_index: origin_hints
    ))

fn module_surface_source_matches(surface: ModuleSurface, source: SourceFile, index: i64) -> bool:
    surface.source_index == index and
        surface.canonical_path == module_surface_canonical_path(source.path) and
        surface.module_name == source.module_name and
        surface.content_length == source.content.len() and
        surface.content_hash == rt_hash_text(source.content)

pub fn module_surface_index_for_source(registry: ModuleSurfacesByName, source: SourceFile, source_index: i64) -> i64:
    """Resolve one physical source without copying every surface aggregate."""
    var alias_position = 0
    while alias_position < registry.ordered_names.len() and alias_position < registry.ordered_indices.len():
        if registry.ordered_names[alias_position] == source.module_name:
            val candidate_index = registry.ordered_indices[alias_position]
            if candidate_index >= 0 and candidate_index < registry.surfaces.len():
                if module_surface_source_matches(registry.surfaces[candidate_index], source, source_index):
                    return candidate_index
            break
        alias_position = alias_position + 1

    # Compatibility spellings are not guaranteed to have a scalar alias. Keep
    # the physical-identity fallback, but reject by the scalar source index
    # before crossing the large aggregate-by-value predicate boundary.
    var position = 0
    while position < registry.surfaces.len():
        if registry.surfaces[position].source_index == source_index:
            if module_surface_source_matches(registry.surfaces[position], source, source_index):
                return position
        position = position + 1
    -1

fn module_surface_trait_origin_key(surface: ModuleSurface, trait_name: text) -> text:
    "{surface.module_name}::{trait_name}"

fn module_surface_canonical_path(path: text) -> text:
    val physical = rt_path_absolute(path)
    val normalized = (if physical != "": physical else: path).replace("\\", "/")
    val absolute = normalized.starts_with("/")
    var parts: [text] = []
    for part in normalized.split("/"):
        if part == "" or part == ".":
            continue
        if part == ".." and parts.len() > 0 and parts[parts.len() - 1] != "..":
            parts = parts[0:parts.len() - 1]
        elif part == ".." and not absolute:
            parts = parts.push(part)
        elif part != "..":
            parts = parts.push(part)
    val joined = parts.join("/")
    if absolute:
        return "/" + joined
    joined

fn module_surfaces_add_name(index_by_name: Dict<text, i64>, name: text, surface_index: i64) -> Result<Dict<text, i64>, text>:
    # contains_key + index read, never `.get()`: a native `Dict.get()` HIT
    # returns a still-boxed i64 (7 reads back as 56).
    # See doc/07_guide/language/dict_native_pitfalls.md
    if index_by_name.contains_key(name) and index_by_name[name] != surface_index:
        return Err("module surface name conflict: {name}")
    index_by_name[name] = surface_index
    Ok(index_by_name)

fn module_surface_declaration_matches(surface: ModuleSurface, module: ParserModule) -> bool:
    if surface.imports.len() != module.imports.len(): return false
    if surface.exports.len() != module.exports.len(): return false
    # Native Dict.len() returns -1. Compare key-array lengths so aliases of one
    # physical source are not rejected by corrupt dictionary cardinalities.
    if surface.callables.keys().len() != module.functions.keys().len(): return false
    if surface.composites.keys().len() != module.classes.keys().len() + module.actors.keys().len() + module.structs.keys().len(): return false
    if surface.enums.keys().len() != module.enums.keys().len(): return false
    if surface.traits.keys().len() != module.traits.keys().len(): return false
    if surface.impls.len() != module.impls.len(): return false
    if surface.type_aliases.keys().len() != module.type_aliases.keys().len(): return false
    if surface.constants.keys().len() != module.constants.keys().len(): return false
    for name in module.functions.keys():
        if not surface.callables.contains_key(name): return false
    for name in module.classes.keys():
        if not surface.composites.contains_key(name): return false
    for name in module.actors.keys():
        if not surface.composites.contains_key(name): return false
    for name in module.structs.keys():
        if not surface.composites.contains_key(name): return false
    for name in module.enums.keys():
        if not surface.enums.contains_key(name): return false
    for name in module.traits.keys():
        if not surface.traits.contains_key(name): return false
    for name in module.type_aliases.keys():
        if not surface.type_aliases.contains_key(name): return false
    for name in module.constants.keys():
        if not surface.constants.contains_key(name): return false
    true

fn module_surfaces_from_modules(modules: Dict<text, ParserModule>, sources: [SourceFile]) -> Result<ModuleSurfacesByName, text>:
    if modules == nil:
        return Err("missing parsed module dictionary")
    var builder = ModuleSurfaceBuilder.new()
    if builder == nil:
        return Err("unable to allocate module surface builder")
    var source_index = 0
    while source_index < sources.len():
        val source = sources[source_index]
        # Source-map entries cross the parser/driver ownership boundary.  A
        # native nil must be reported with its stable position, never consumed
        # by the first `source.module_name` field access below.
        if source == nil:
            return Err("invalid source entry at index: {source_index}")
        if not modules.contains_key(source.module_name):
            return Err("missing parsed module for source: {source.module_name}")
        val module = modules[source.module_name]
        # A parser-map entry is transport data at this boundary.  Never let an
        # invalid entry become an anonymous native nil-receiver trap during a
        # self-hosted build: preserve the source identity for the driver error.
        if module == nil:
            return Err("invalid parsed module for source: {source.module_name}")
        val canonical_path = module_surface_canonical_path(source.path)
        if builder.has_canonical_path(canonical_path):
            val surface = builder.surfaces[builder.index_by_path[canonical_path]]
            if not module_surface_declaration_matches(surface, module):
                return Err("conflicting declaration metadata for physical source: {canonical_path}")
            val alias_result = builder.add_alias_canonical(source, canonical_path)
            if alias_result.is_err():
                return Err(alias_result.unwrap_err())
        else:
            val add_result = builder.add_parsed_canonical(
                module, source, source_index, canonical_path)
            if add_result.is_err():
                return Err(add_result.unwrap_err())
        source_index = source_index + 1
    for alias in modules.keys():
        if builder.index_by_name.contains_key(alias):
            continue
        val module = modules[alias]
        if module == nil:
            return Err("invalid parsed module alias: {alias}")
        # Parsed aliases retain the physical source path in ParserModule.name.
        # Resolve that identity before declaration-shape matching: unrelated
        # physical modules may expose the same API.
        val parsed_path = module_surface_canonical_path(module.name)
        if builder.index_by_path.contains_key(parsed_path):
            val canonical_result = builder.add_indexed_name(
                alias, builder.index_by_path[parsed_path])
            if canonical_result.is_err():
                return Err(canonical_result.unwrap_err())
            continue
        var matching_index: i64 = -1
        var surface_index = 0
        while surface_index < builder.surfaces.len():
            if module_surface_declaration_matches(builder.surfaces[surface_index], module):
                if matching_index >= 0:
                    return Err("ambiguous parsed module alias: {alias}")
                matching_index = surface_index
            surface_index = surface_index + 1
        if matching_index < 0:
            return Err("parsed module has no source surface: {alias}")
        val alias_result = builder.add_indexed_name(alias, matching_index)
        if alias_result.is_err():
            return Err(alias_result.unwrap_err())
    val origin_result = builder.resolve_export_origins()
    if origin_result.is_err():
        return Err(origin_result.unwrap_err())
    builder.finish()

fn module_surface_promote(surface: ModuleSurface) -> bool:
    rt_transient_heap_promote(surface)
