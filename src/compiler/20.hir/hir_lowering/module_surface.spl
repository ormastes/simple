# ParserModule Surface - compact cross-module declarations for staged HIR lowering.
#
# codex-impl: Stage4 module retention is reduced by keeping declaration
# surfaces.  The surface deliberately omits ordinary executable bodies,
# parameter default expressions, composite fields, and constant values.

use compiler.common.driver_core_types.{SourceFile}
use compiler.frontend.parser_types.*

extern fn rt_hash_text(content: text) -> i64
extern fn rt_path_absolute(path: text) -> text
extern fn rt_transient_heap_promote(value: Any) -> bool

struct ModuleSurfaceParam:
    name: text
    has_type_: bool
    type_: Type
    has_default: bool
    is_mutable: bool
    span: Span

struct ModuleSurfaceCallable:
    name: text
    type_params: [ParserTypeParam]
    params: [ModuleSurfaceParam]
    has_return_type: bool
    return_type: Type
    visibility: Visibility
    is_async: bool
    is_static: bool
    is_public: bool
    is_method: bool
    is_mutable: bool
    is_const: bool
    is_kernel: bool
    is_extern: bool
    span: Span

struct ModuleSurfaceComposite:
    name: text
    kind: text
    type_params: [ParserTypeParam]
    visibility: Visibility
    is_public: bool
    span: Span

struct ModuleSurfaceEnum:
    name: text
    type_params: [ParserTypeParam]
    # Variant.Struct carries its Fields, including the one permitted retained
    # expression form: an enum struct-variant field default.
    variants: [Variant]
    visibility: Visibility
    is_public: bool
    span: Span

struct ModuleSurfaceTrait:
    name: text
    type_params: [ParserTypeParam]
    super_traits: [Type]
    where_clause: [TraitBound]
    methods: [ModuleSurfaceCallable]
    # These original AST nodes are the sole executable-body exception: impl
    # lowering must inject a trait's unoverridden default methods.
    default_methods: [ParserFunction]
    assoc_types: [AssocTypeDecl]
    visibility: Visibility
    is_public: bool
    span: Span

struct ModuleSurfaceImpl:
    # Phase 3 consumes only the implemented/trait types and callable headers
    # when registering imported methods. Generic bounds, associated types, and
    # the impl span are never read from the surface and remain in the per-file
    # AST for ordinary lowering.
    type_: Type
    has_trait_: bool
    trait_: Type
    methods: Dict<text, ModuleSurfaceCallable>

struct ModuleSurfaceConst:
    name: text
    has_type_: bool
    type_: Type
    is_mutable: bool
    visibility: Visibility
    is_public: bool
    is_volatile: bool
    has_fixed_address: bool
    fixed_address: i64
    span: Span

struct ModuleSurfaceTypeAlias:
    name: text
    type_params: [ParserTypeParam]
    type_: Type
    visibility: Visibility
    is_public: bool
    span: Span

struct ModuleSurfaceExportOrigin:
    owner_module: text
    source_name: text
    resolution_kind: text

struct ModuleSurface:
    source_index: i64
    canonical_path: text
    module_name: text
    content_length: i64
    content_hash: i64
    imports: [ParserImport]
    exports: [Export]
    callables: Dict<text, ModuleSurfaceCallable>
    composites: Dict<text, ModuleSurfaceComposite>
    enums: Dict<text, ModuleSurfaceEnum>
    traits: Dict<text, ModuleSurfaceTrait>
    impls: [ModuleSurfaceImpl]
    type_aliases: Dict<text, ModuleSurfaceTypeAlias>
    constants: Dict<text, ModuleSurfaceConst>
    export_origins: Dict<text, ModuleSurfaceExportOrigin>

struct ModuleSurfacesByName:
    surfaces: [ModuleSurface]
    index_by_name: Dict<text, i64>

struct ModuleSurfaceBuilder:
    surfaces: [ModuleSurface]
    index_by_name: Dict<text, i64>
    index_by_path: Dict<text, i64>

impl ModuleSurfaceBuilder:
    static fn new() -> ModuleSurfaceBuilder:
        ModuleSurfaceBuilder(surfaces: [], index_by_name: {}, index_by_path: {})

    me has_path(path: text) -> bool:
        self.index_by_path.contains_key(module_surface_canonical_path(path))

    me has_canonical_path(canonical_path: text) -> bool:
        self.index_by_path.contains_key(canonical_path)

    me add_parsed(module: ParserModule, source: SourceFile, source_index: i64) -> Result<(), text>:
        val canonical_path = module_surface_canonical_path(source.path)
        self.add_parsed_canonical(module, source, source_index, canonical_path)

    me add_parsed_canonical(module: ParserModule, source: SourceFile, source_index: i64, canonical_path: text) -> Result<(), text>:
        if self.index_by_path.contains_key(canonical_path):
            return Err("module surface already exists for physical source: {canonical_path}")
        val surface_index = self.surfaces.len()
        val name_result = module_surfaces_add_name(self.index_by_name, source.module_name, surface_index)
        if name_result.is_err():
            return Err(name_result.unwrap_err())
        self.index_by_name = name_result.unwrap()
        self.surfaces = self.surfaces.push(module_surface_from_module(module, source, source_index))
        self.index_by_path[canonical_path] = surface_index
        Ok(())

    me add_alias(source: SourceFile) -> Result<(), text>:
        val canonical_path = module_surface_canonical_path(source.path)
        self.add_alias_canonical(source, canonical_path)

    me add_alias_canonical(source: SourceFile, canonical_path: text) -> Result<(), text>:
        if not self.index_by_path.contains_key(canonical_path):
            return Err("missing physical module surface for alias: {canonical_path}")
        val surface_index = self.index_by_path[canonical_path]
        if surface_index < 0 or surface_index >= self.surfaces.len():
            return Err("invalid physical module surface index for alias: path={canonical_path} index={surface_index} len={self.surfaces.len()}")
        val surface = self.surfaces[surface_index]
        if (surface.canonical_path != canonical_path or
            surface.content_length != source.content.len() or
            surface.content_hash != rt_hash_text(source.content)):
            return Err("conflicting physical source: {canonical_path}")
        val name_result = module_surfaces_add_name(self.index_by_name, source.module_name, surface_index)
        if name_result.is_err():
            return Err(name_result.unwrap_err())
        self.index_by_name = name_result.unwrap()
        Ok(())

    me finish() -> ModuleSurfacesByName:
        ModuleSurfacesByName(surfaces: self.surfaces, index_by_name: self.index_by_name)

    me resolve_export_origins() -> Result<(), text>:
        # Build one package/name owner index up front. Stage4 carries thousands
        # of exports, so scanning every surface for every plain export turns
        # this boundary into O(exports * surfaces).
        var owner_by_package_name: Dict<text, i64> = {}
        var owner_surface_index = 0
        while owner_surface_index < self.surfaces.len():
            val owner_surface = self.surfaces[owner_surface_index]
            val owner_package = module_surface_package_name(owner_surface)
            # Keep category order and collision handling unchanged, but visit
            # each key array directly. Building one cumulative array retained
            # every intermediate concatenation in the no-GC Stage4 process.
            for declaration_name in owner_surface.callables.keys():
                val owner_key = "{owner_package}::{declaration_name}"
                if owner_by_package_name.contains_key(owner_key):
                    val previous_index = owner_by_package_name[owner_key]
                    if previous_index >= 0 and
                       self.surfaces[previous_index].canonical_path != owner_surface.canonical_path:
                        owner_by_package_name[owner_key] = -2
                else:
                    owner_by_package_name[owner_key] = owner_surface_index
            for declaration_name in owner_surface.composites.keys():
                val owner_key = "{owner_package}::{declaration_name}"
                if owner_by_package_name.contains_key(owner_key):
                    val previous_index = owner_by_package_name[owner_key]
                    if previous_index >= 0 and
                       self.surfaces[previous_index].canonical_path != owner_surface.canonical_path:
                        owner_by_package_name[owner_key] = -2
                else:
                    owner_by_package_name[owner_key] = owner_surface_index
            for declaration_name in owner_surface.enums.keys():
                val owner_key = "{owner_package}::{declaration_name}"
                if owner_by_package_name.contains_key(owner_key):
                    val previous_index = owner_by_package_name[owner_key]
                    if previous_index >= 0 and
                       self.surfaces[previous_index].canonical_path != owner_surface.canonical_path:
                        owner_by_package_name[owner_key] = -2
                else:
                    owner_by_package_name[owner_key] = owner_surface_index
            for declaration_name in owner_surface.traits.keys():
                val owner_key = "{owner_package}::{declaration_name}"
                if owner_by_package_name.contains_key(owner_key):
                    val previous_index = owner_by_package_name[owner_key]
                    if previous_index >= 0 and
                       self.surfaces[previous_index].canonical_path != owner_surface.canonical_path:
                        owner_by_package_name[owner_key] = -2
                else:
                    owner_by_package_name[owner_key] = owner_surface_index
            for declaration_name in owner_surface.type_aliases.keys():
                val owner_key = "{owner_package}::{declaration_name}"
                if owner_by_package_name.contains_key(owner_key):
                    val previous_index = owner_by_package_name[owner_key]
                    if previous_index >= 0 and
                       self.surfaces[previous_index].canonical_path != owner_surface.canonical_path:
                        owner_by_package_name[owner_key] = -2
                else:
                    owner_by_package_name[owner_key] = owner_surface_index
            for declaration_name in owner_surface.constants.keys():
                val owner_key = "{owner_package}::{declaration_name}"
                if owner_by_package_name.contains_key(owner_key):
                    val previous_index = owner_by_package_name[owner_key]
                    if previous_index >= 0 and
                       self.surfaces[previous_index].canonical_path != owner_surface.canonical_path:
                        owner_by_package_name[owner_key] = -2
                else:
                    owner_by_package_name[owner_key] = owner_surface_index
            owner_surface_index = owner_surface_index + 1

        var surface_index = 0
        while surface_index < self.surfaces.len():
            var surface = self.surfaces[surface_index]
            var origins: Dict<text, ModuleSurfaceExportOrigin> = surface.export_origins
            for export_decl in surface.exports:
                for export_item in export_decl.items:
                    if export_item.ends_with(".*"):
                        continue
                    var source_name = export_item
                    var local_name = export_item
                    if export_item.contains(":"):
                        val parts = export_item.split(":")
                        source_name = parts[0]
                        if parts.len() > 1:
                            local_name = parts[1]

                    if module_surface_declares_item(surface, source_name):
                        origins[local_name] = ModuleSurfaceExportOrigin(
                            owner_module: surface.module_name,
                            source_name: source_name,
                            resolution_kind: "direct"
                        )
                        continue

                    val imported_origin = module_surface_explicit_import_origin(
                        self.surfaces, self.index_by_name, surface,
                        source_name, local_name)
                    if imported_origin != nil:
                        origins[local_name] = imported_origin.unwrap()
                        continue

                    # Generated facade comments carry the precise source file
                    # when two sibling modules intentionally expose the same
                    # declaration. Keep that provenance ahead of inference.
                    if origins.contains_key(local_name):
                        continue

                    val sibling_result = module_surface_unique_sibling_origin(
                        self.surfaces, owner_by_package_name,
                        surface, source_name)
                    if sibling_result.is_err():
                        return Err(sibling_result.unwrap_err())
                    val sibling_origin = sibling_result.unwrap()
                    if sibling_origin != nil:
                        origins[local_name] = sibling_origin.unwrap()
            surface.export_origins = origins
            self.surfaces[surface_index] = surface
            surface_index = surface_index + 1

        # Plain file-facade exports can be owned by a compatibility child
        # which itself only re-exports a concrete declaration. Those child
        # origins are not available in the direct-declaration index above and
        # may be discovered after the root facade (the Stage4 std.io graph is
        # exactly this order). Promote resolved child exports into the same
        # package/name index, then revisit only unresolved/inferred plain
        # exports until the graph reaches a fixpoint.
        #
        # Each productive pass adds or changes at least one surface origin;
        # an acyclic origin chain cannot be longer than the surface count. The
        # extra pass proves quiescence. This strict bound prevents a malformed
        # facade cycle from turning compiler startup into an unbounded scan.
        var origin_pass = 0
        val max_origin_passes = self.surfaces.len() + 1
        var origin_changed = true
        while origin_changed and origin_pass < max_origin_passes:
            origin_changed = false

            var exported_owner_index = 0
            while exported_owner_index < self.surfaces.len():
                val exported_owner = self.surfaces[exported_owner_index]
                val exported_owner_name = module_surface_canonical_module_name(exported_owner.module_name)
                # A package __init__ is the facade being resolved, not one of
                # its child owners. Indexing its inferred exports beside the
                # real child makes every stable later pass manufacture an
                # ambiguity between facade and owner.
                if exported_owner_name.ends_with(".__init__"):
                    exported_owner_index = exported_owner_index + 1
                    continue
                val exported_package = module_surface_package_name(exported_owner)
                for exported_name in exported_owner.export_origins.keys():
                    val owner_key = "{exported_package}::{exported_name}"
                    if owner_by_package_name.contains_key(owner_key):
                        val previous_index = owner_by_package_name[owner_key]
                        if previous_index >= 0 and
                           self.surfaces[previous_index].canonical_path != exported_owner.canonical_path:
                            owner_by_package_name[owner_key] = -2
                    else:
                        owner_by_package_name[owner_key] = exported_owner_index
                exported_owner_index = exported_owner_index + 1

            var revisit_index = 0
            while revisit_index < self.surfaces.len():
                var revisit_surface = self.surfaces[revisit_index]
                var revisit_origins = revisit_surface.export_origins
                for export_decl in revisit_surface.exports:
                    for export_item in export_decl.items:
                        if export_item.ends_with(".*"):
                            continue
                        var source_name = export_item
                        var local_name = export_item
                        if export_item.contains(":"):
                            val parts = export_item.split(":")
                            source_name = parts[0]
                            if parts.len() > 1:
                                local_name = parts[1]

                        # Direct/explicit/generated origins are final. A
                        # plain-sibling origin is rechecked so a later second
                        # child makes the graph fail closed as ambiguous.
                        if module_surface_declares_item(revisit_surface, source_name):
                            continue
                        val imported_origin = module_surface_explicit_import_origin(
                            self.surfaces, self.index_by_name, revisit_surface,
                            source_name, local_name)
                        if imported_origin != nil:
                            continue
                        if revisit_origins.contains_key(local_name) and
                           revisit_origins[local_name].resolution_kind != "plain-sibling":
                            continue

                        val sibling_result = module_surface_unique_sibling_origin(
                            self.surfaces, owner_by_package_name,
                            revisit_surface, source_name)
                        if sibling_result.is_err():
                            return Err(sibling_result.unwrap_err())
                        val sibling_origin = sibling_result.unwrap()
                        if sibling_origin != nil:
                            val next_origin = sibling_origin.unwrap()
                            var needs_update = not revisit_origins.contains_key(local_name)
                            if not needs_update:
                                val previous_origin = revisit_origins[local_name]
                                needs_update = previous_origin.owner_module != next_origin.owner_module or
                                    previous_origin.source_name != next_origin.source_name or
                                    previous_origin.resolution_kind != next_origin.resolution_kind
                            if needs_update:
                                revisit_origins[local_name] = next_origin
                                origin_changed = true
                revisit_surface.export_origins = revisit_origins
                self.surfaces[revisit_index] = revisit_surface
                revisit_index = revisit_index + 1
            origin_pass = origin_pass + 1

        if origin_changed:
            return Err("facade export origin resolution did not converge after {max_origin_passes} passes")
        Ok(())

fn module_surface_declares_item(surface: ModuleSurface, name: text) -> bool:
    surface.callables.contains_key(name) or
        surface.composites.contains_key(name) or
        surface.enums.contains_key(name) or
        surface.traits.contains_key(name) or
        surface.type_aliases.contains_key(name) or
        surface.constants.contains_key(name)

fn module_surface_explicit_import_origin(
    surfaces: [ModuleSurface],
    index_by_name: Dict<text, i64>,
    facade: ModuleSurface,
    source_name: text,
    local_name: text
) -> ModuleSurfaceExportOrigin?:
    for import_decl in facade.imports:
        if not index_by_name.contains_key(import_decl.module):
            continue
        val owner_index = index_by_name[import_decl.module]
        if owner_index < 0 or owner_index >= surfaces.len():
            continue
        val owner = surfaces[owner_index]
        for item in import_decl.items:
            val imported_local = if item.has_alias: item.alias else: item.name
            if (imported_local == source_name or imported_local == local_name) and
               module_surface_declares_item(owner, item.name):
                return Some(ModuleSurfaceExportOrigin(
                    owner_module: owner.module_name,
                    source_name: item.name,
                    resolution_kind: if item.has_alias: "alias" else: "explicit"
                ))
    nil

fn module_surface_canonical_module_name(name: text) -> text:
    var dotted = name
    if dotted.ends_with(".spl"):
        dotted = dotted[0:dotted.len() - 4]
    dotted = dotted.replace("/", ".")
    if dotted.starts_with("src."):
        dotted = dotted.substring(4)
    var result: [text] = []
    for segment in dotted.split("."):
        var digits_only = segment != ""
        var i = 0
        while i < segment.len():
            val code = segment.char_code_at(i)
            if code < 48 or code > 57:
                digits_only = false
            i = i + 1
        if not digits_only:
            result = result.push(segment)
    val canonical = result.join(".")
    if canonical == "std":
        return "lib"
    if canonical.starts_with("std."):
        return "lib." + canonical.substring(4)
    canonical

fn module_surface_package_name(surface: ModuleSurface) -> text:
    var name = module_surface_canonical_module_name(surface.module_name)
    if name.ends_with(".__init__"):
        return name[0:name.len() - 9]
    val segments = name.split(".")
    if segments.len() <= 1:
        return ""
    segments[0:segments.len() - 1].join(".")

fn module_surface_unique_sibling_origin(
    surfaces: [ModuleSurface],
    owner_by_package_name: Dict<text, i64>,
    facade: ModuleSurface,
    source_name: text
) -> Result<ModuleSurfaceExportOrigin?, text>:
    val facade_name = module_surface_canonical_module_name(facade.module_name)
    val nested_owner_key = "{facade_name}::{source_name}"
    # A file facade can own a same-named sibling directory:
    # `lib/nogc_sync_mut/io.spl` represents declarations under `io/*.spl`.
    # Prefer that exact directory package when it has an indexed owner. An
    # `__init__` facade already names the directory explicitly and ordinary
    # modules without children retain parent-sibling semantics below.
    var facade_package = module_surface_package_name(facade)
    if not facade_name.ends_with(".__init__") and
       owner_by_package_name.contains_key(nested_owner_key):
        facade_package = facade_name
    if facade_package == "":
        return Ok(nil)
    val owner_key = "{facade_package}::{source_name}"
    if not owner_by_package_name.contains_key(owner_key):
        return Ok(nil)
    val matching_index = owner_by_package_name[owner_key]
    if matching_index == -2:
        return Err(
            "ambiguous facade export: module={facade.module_name} item={source_name} package={facade_package}")
    if matching_index < 0 or matching_index >= surfaces.len():
        return Ok(nil)
    val owner = surfaces[matching_index]
    Ok(Some(ModuleSurfaceExportOrigin(
        owner_module: owner.module_name,
        source_name: source_name,
        resolution_kind: "plain-sibling"
    )))

fn module_surface_callable_from_function(function_: ParserFunction) -> ModuleSurfaceCallable:
    var params: [ModuleSurfaceParam] = []
    for param in function_.params:
        params = params.push(ModuleSurfaceParam(
            name: param.name,
            has_type_: param.has_type_,
            type_: param.type_,
            has_default: false,
            is_mutable: param.is_mutable,
            span: param.span
        ))
    ModuleSurfaceCallable(
        name: function_.name,
        type_params: function_.type_params,
        params: params,
        has_return_type: function_.has_return_type,
        return_type: function_.return_type,
        visibility: function_.visibility,
        is_async: function_.is_async,
        is_static: function_.is_static,
        is_public: function_.is_public,
        is_method: function_.is_method,
        is_mutable: function_.is_mutable,
        is_const: function_.is_const,
        is_kernel: function_.is_kernel,
        is_extern: function_.is_extern,
        span: function_.span
    )

fn module_surface_trait_from_trait(trait_: ParserTrait) -> ModuleSurfaceTrait:
    var methods: [ModuleSurfaceCallable] = []
    var default_methods: [ParserFunction] = []
    for method in trait_.methods:
        methods = methods.push(module_surface_callable_from_function(method))
        if not method.body.stmts.is_empty():
            default_methods = default_methods.push(method)
    ModuleSurfaceTrait(
        name: trait_.name,
        type_params: trait_.type_params,
        super_traits: trait_.super_traits,
        where_clause: trait_.where_clause,
        methods: methods,
        default_methods: default_methods,
        assoc_types: trait_.assoc_types,
        visibility: trait_.visibility,
        is_public: trait_.is_public,
        span: trait_.span
    )

fn module_surface_impl_from_impl(impl_: Impl) -> ModuleSurfaceImpl:
    var methods: Dict<text, ModuleSurfaceCallable> = {}
    for name in impl_.methods.keys():
        methods[name] = module_surface_callable_from_function(impl_.methods[name])
    ModuleSurfaceImpl(
        type_: impl_.type_,
        has_trait_: impl_.has_trait_,
        trait_: impl_.trait_,
        methods: methods
    )

fn module_surface_export_origin_hints(source: SourceFile) -> Dict<text, ModuleSurfaceExportOrigin>:
    var origins: Dict<text, ModuleSurfaceExportOrigin> = {}
    # Most modules are not generated facades. Avoid splitting their complete
    # source into per-line text objects: the no-GC bootstrap runtime retains
    # those strings for the process lifetime even though this scanner cannot
    # produce a hint without the exact generator marker.
    if not source.content.contains("# Re-exported from "):
        return origins
    var owner_file = ""
    var facade_name = module_surface_canonical_module_name(source.module_name)
    if facade_name.ends_with(".__init__"):
        facade_name = facade_name[0:facade_name.len() - 9]
    for raw_line in source.content.split("\n"):
        val line = raw_line.trim()
        if line.starts_with("# Re-exported from ") and line.contains(".spl"):
            val owner_parts = line.substring(19).split(".spl")
            owner_file = owner_parts[0]
            continue
        if owner_file != "" and line.starts_with("export "):
            val owner_module = facade_name + "." + owner_file.replace("/", ".")
            for raw_item in line.substring(7).split(","):
                val item = raw_item.trim()
                if item != "" and not item.ends_with(".*"):
                    var source_name = item
                    var local_name = item
                    if item.contains(":"):
                        val parts = item.split(":")
                        source_name = parts[0].trim()
                        if parts.len() > 1:
                            local_name = parts[1].trim()
                    origins[local_name] = ModuleSurfaceExportOrigin(
                        owner_module: owner_module,
                        source_name: source_name,
                        resolution_kind: "generated-comment"
                    )
            owner_file = ""
        elif line != "" and not line.starts_with("#"):
            owner_file = ""
    origins

fn module_surface_from_module(module: ParserModule, source: SourceFile, source_index: i64) -> ModuleSurface:
    var callables: Dict<text, ModuleSurfaceCallable> = {}
    for name in module.functions.keys():
        callables[name] = module_surface_callable_from_function(module.functions[name])

    var composites: Dict<text, ModuleSurfaceComposite> = {}
    for name in module.classes.keys():
        val class_ = module.classes[name]
        composites[name] = ModuleSurfaceComposite(name: class_.name, kind: "class", type_params: class_.type_params, visibility: class_.visibility, is_public: class_.is_public, span: class_.span)
    for name in module.actors.keys():
        val actor = module.actors[name]
        composites[name] = ModuleSurfaceComposite(name: actor.name, kind: "actor", type_params: actor.type_params, visibility: actor.visibility, is_public: actor.is_public, span: actor.span)
    for name in module.structs.keys():
        val struct_ = module.structs[name]
        composites[name] = ModuleSurfaceComposite(name: struct_.name, kind: "struct", type_params: struct_.type_params, visibility: struct_.visibility, is_public: struct_.is_public, span: struct_.span)

    var enums: Dict<text, ModuleSurfaceEnum> = {}
    for name in module.enums.keys():
        val enum_ = module.enums[name]
        enums[name] = ModuleSurfaceEnum(name: enum_.name, type_params: enum_.type_params, variants: enum_.variants, visibility: enum_.visibility, is_public: enum_.is_public, span: enum_.span)

    var traits: Dict<text, ModuleSurfaceTrait> = {}
    for name in module.traits.keys():
        traits[name] = module_surface_trait_from_trait(module.traits[name])

    var impls: [ModuleSurfaceImpl] = []
    for impl_ in module.impls:
        impls = impls.push(module_surface_impl_from_impl(impl_))

    var type_aliases: Dict<text, ModuleSurfaceTypeAlias> = {}
    for name in module.type_aliases.keys():
        val alias = module.type_aliases[name]
        type_aliases[name] = ModuleSurfaceTypeAlias(
            name: alias.name,
            type_params: alias.type_params,
            type_: alias.type_,
            visibility: alias.visibility,
            is_public: alias.is_public,
            span: alias.span
        )

    var constants: Dict<text, ModuleSurfaceConst> = {}
    for name in module.constants.keys():
        val constant = module.constants[name]
        constants[name] = ModuleSurfaceConst(
            name: constant.name,
            has_type_: constant.has_type_,
            type_: constant.type_,
            is_mutable: constant.is_mutable,
            visibility: constant.visibility,
            is_public: constant.is_public,
            is_volatile: constant.is_volatile,
            has_fixed_address: constant.has_fixed_address,
            fixed_address: constant.fixed_address,
            span: constant.span
        )

    ModuleSurface(
        source_index: source_index,
        canonical_path: module_surface_canonical_path(source.path),
        module_name: source.module_name,
        content_length: source.content.len(),
        content_hash: rt_hash_text(source.content),
        imports: module.imports,
        exports: module.exports,
        callables: callables,
        composites: composites,
        enums: enums,
        traits: traits,
        impls: impls,
        type_aliases: type_aliases,
        constants: constants,
        export_origins: module_surface_export_origin_hints(source)
    )

fn module_surface_source_matches(surface: ModuleSurface, source: SourceFile, index: i64) -> bool:
    surface.source_index == index and
        surface.canonical_path == module_surface_canonical_path(source.path) and
        surface.module_name == source.module_name and
        surface.content_length == source.content.len() and
        surface.content_hash == rt_hash_text(source.content)

fn module_surface_trait_origin_key(surface: ModuleSurface, trait_name: text) -> text:
    "{surface.module_name}::{trait_name}"

fn module_surface_canonical_path(path: text) -> text:
    val physical = rt_path_absolute(path)
    val normalized = (if physical != "": physical else: path).replace("\\", "/")
    val absolute = normalized.starts_with("/")
    var parts: [text] = []
    for part in normalized.split("/"):
        if part == "" or part == ".":
            continue
        if part == ".." and parts.len() > 0 and parts[parts.len() - 1] != "..":
            parts = parts[0:parts.len() - 1]
        elif part == ".." and not absolute:
            parts = parts.push(part)
        elif part != "..":
            parts = parts.push(part)
    val joined = parts.join("/")
    if absolute:
        return "/" + joined
    joined

fn module_surfaces_add_name(index_by_name: Dict<text, i64>, name: text, surface_index: i64) -> Result<Dict<text, i64>, text>:
    # contains_key + index read, never `.get()`: a native `Dict.get()` HIT
    # returns a still-boxed i64 (7 reads back as 56).
    # See doc/07_guide/language/dict_native_pitfalls.md
    if index_by_name.contains_key(name) and index_by_name[name] != surface_index:
        return Err("module surface name conflict: {name}")
    index_by_name[name] = surface_index
    Ok(index_by_name)

fn module_surface_declaration_matches(surface: ModuleSurface, module: ParserModule) -> bool:
    if surface.imports.len() != module.imports.len(): return false
    if surface.exports.len() != module.exports.len(): return false
    # Native Dict.len() returns -1. Compare key-array lengths so aliases of one
    # physical source are not rejected by corrupt dictionary cardinalities.
    if surface.callables.keys().len() != module.functions.keys().len(): return false
    if surface.composites.keys().len() != module.classes.keys().len() + module.actors.keys().len() + module.structs.keys().len(): return false
    if surface.enums.keys().len() != module.enums.keys().len(): return false
    if surface.traits.keys().len() != module.traits.keys().len(): return false
    if surface.impls.len() != module.impls.len(): return false
    if surface.type_aliases.keys().len() != module.type_aliases.keys().len(): return false
    if surface.constants.keys().len() != module.constants.keys().len(): return false
    for name in module.functions.keys():
        if not surface.callables.contains_key(name): return false
    for name in module.classes.keys():
        if not surface.composites.contains_key(name): return false
    for name in module.actors.keys():
        if not surface.composites.contains_key(name): return false
    for name in module.structs.keys():
        if not surface.composites.contains_key(name): return false
    for name in module.enums.keys():
        if not surface.enums.contains_key(name): return false
    for name in module.traits.keys():
        if not surface.traits.contains_key(name): return false
    for name in module.type_aliases.keys():
        if not surface.type_aliases.contains_key(name): return false
    for name in module.constants.keys():
        if not surface.constants.contains_key(name): return false
    true

fn module_surfaces_from_modules(modules: Dict<text, ParserModule>, sources: [SourceFile]) -> Result<ModuleSurfacesByName, text>:
    var builder = ModuleSurfaceBuilder.new()
    var source_index = 0
    while source_index < sources.len():
        val source = sources[source_index]
        if not modules.contains_key(source.module_name):
            return Err("missing parsed module for source: {source.module_name}")
        val module = modules[source.module_name]
        val canonical_path = module_surface_canonical_path(source.path)
        if builder.has_canonical_path(canonical_path):
            val surface = builder.surfaces[builder.index_by_path[canonical_path]]
            if not module_surface_declaration_matches(surface, module):
                return Err("conflicting declaration metadata for physical source: {canonical_path}")
            val alias_result = builder.add_alias_canonical(source, canonical_path)
            if alias_result.is_err():
                return Err(alias_result.unwrap_err())
        else:
            val add_result = builder.add_parsed_canonical(
                module, source, source_index, canonical_path)
            if add_result.is_err():
                return Err(add_result.unwrap_err())
        source_index = source_index + 1
    for alias in modules.keys():
        if builder.index_by_name.contains_key(alias):
            continue
        val module = modules[alias]
        # Parsed aliases retain the physical source path in ParserModule.name.
        # Resolve that identity before declaration-shape matching: unrelated
        # physical modules may expose the same API.
        val parsed_path = module_surface_canonical_path(module.name)
        if builder.index_by_path.contains_key(parsed_path):
            val canonical_result = module_surfaces_add_name(builder.index_by_name, alias, builder.index_by_path[parsed_path])
            if canonical_result.is_err():
                return Err(canonical_result.unwrap_err())
            builder.index_by_name = canonical_result.unwrap()
            continue
        var matching_index: i64 = -1
        var surface_index = 0
        while surface_index < builder.surfaces.len():
            if module_surface_declaration_matches(builder.surfaces[surface_index], module):
                if matching_index >= 0:
                    return Err("ambiguous parsed module alias: {alias}")
                matching_index = surface_index
            surface_index = surface_index + 1
        if matching_index < 0:
            return Err("parsed module has no source surface: {alias}")
        val alias_result = module_surfaces_add_name(builder.index_by_name, alias, matching_index)
        if alias_result.is_err():
            return Err(alias_result.unwrap_err())
        builder.index_by_name = alias_result.unwrap()
    val origin_result = builder.resolve_export_origins()
    if origin_result.is_err():
        return Err(origin_result.unwrap_err())
    Ok(builder.finish())

fn module_surface_promote(surface: ModuleSurface) -> bool:
    rt_transient_heap_promote(surface)
