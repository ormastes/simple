# Nominal-member SoA.  Owner identity is module-qualified because symbol ids
# restart per module.  The store never carries HirField/HirType/HirExpr values.
class HirDestinationMemberStore:
    generation: i64=-1
    frozen: bool=false
    error: bool=false
    count: i64=0
    capacity: i64=0
    ready: [bool] = []
    row_generation: [i64] = []
    module_index: [i64] = []
    owner_symbol: [i64] = []
    name: [text] = []
    ordinal: [i64] = []
    symbol: [i64] = []
    has_type: [bool] = []
    type_index: [i64] = []
    has_default: [bool] = []
    default_expr: [i64] = []
    volatile_: [bool] = []
    has_bits_attr: [bool] = []
    bits: [i64] = []
    has_fixed_address: [bool] = []
    fixed_address: [i64] = []
    span_index: [i64] = []
    owner_bank_by_module: [Dict<i64, i64>] = []
    bank_name_rows: [Dict<text, i64>] = []
    bank_range_start: [i64] = []
    bank_range_len: [i64] = []
    # BUILDING-only scalar SoA. Source declarations may revisit an owner
    # (class A, class B, impl A), so final rows are drained owner-by-owner.
    staged_count: i64=0
    staged_capacity: i64=0
    staged_module: [i64] = []
    staged_owner: [i64] = []
    staged_name: [text] = []
    staged_ordinal: [i64] = []
    staged_symbol: [i64] = []
    staged_has_type: [bool] = []
    staged_type: [i64] = []
    staged_has_default: [bool] = []
    staged_default: [i64] = []
    staged_volatile: [bool] = []
    staged_has_bits: [bool] = []
    staged_bits: [i64] = []
    staged_has_address: [bool] = []
    staged_address: [i64] = []
    staged_span: [i64] = []
    staged_next: [i64] = []
    staged_owner_by_module: [Dict<i64, i64>] = []
    staged_bank_head: [i64] = []
    staged_bank_tail: [i64] = []
    staged_bank_len: [i64] = []
    staged_bank_name_rows: [Dict<text, i64>] = []
    me clear_staged_payload_range(start: i64,finish: i64):
        # Keep the scalar SoA capacity reusable, but release every heap-backed
        # text reference and invalidate the inactive scalar payload.  Scrubbing
        # is deliberately deferred until a whole drain succeeds: a failed
        # drain must leave the exact staged rows available to checkpoint
        # rollback.
        var i=if start<0: 0 else: start
        val stop=if finish>self.staged_count: self.staged_count else: finish
        while i<stop:
            self.staged_module[i]=-1; self.staged_owner[i]=-1; self.staged_name[i]=""; self.staged_ordinal[i]=-1
            self.staged_symbol[i]=-1; self.staged_has_type[i]=false; self.staged_type[i]=-1
            self.staged_has_default[i]=false; self.staged_default[i]=-1; self.staged_volatile[i]=false
            self.staged_has_bits[i]=false; self.staged_bits[i]=0; self.staged_has_address[i]=false
            self.staged_address[i]=0; self.staged_span[i]=-1; self.staged_next[i]=-1; i=i+1
    me begin(g: i64) -> bool:
        if g<0: return false
        self.clear_staged_payload_range(0,self.staged_count)
        self.owner_bank_by_module=[]; self.bank_name_rows=[]; self.bank_range_start=[]; self.bank_range_len=[]; self.generation=g
        self.staged_owner_by_module=[]; self.staged_bank_head=[]
        self.staged_bank_tail=[]; self.staged_bank_len=[]; self.staged_bank_name_rows=[]; self.staged_count=0
        self.frozen=false; self.error=false; self.count=0; true
    me ensure_staged(required: i64):
        if required<=self.staged_capacity: return
        var target=if self.staged_capacity<8: 8 else: self.staged_capacity
        while target<required: target=target*2
        while self.staged_module.len()<target:
            self.staged_module.push(-1); self.staged_owner.push(-1); self.staged_name.push(""); self.staged_ordinal.push(-1)
            self.staged_symbol.push(-1); self.staged_has_type.push(false); self.staged_type.push(-1)
            self.staged_has_default.push(false); self.staged_default.push(-1); self.staged_volatile.push(false)
            self.staged_has_bits.push(false); self.staged_bits.push(0); self.staged_has_address.push(false)
            self.staged_address.push(0); self.staged_span.push(-1); self.staged_next.push(-1)
        self.staged_capacity=target
    me ensure_staged_bank(module_row: i64,owner: i64) -> i64:
        while self.staged_owner_by_module.len()<=module_row:
            val empty: Dict<i64, i64> = {}; self.staged_owner_by_module.push(empty)
        if self.staged_owner_by_module[module_row].contains_key(owner): return self.staged_owner_by_module[module_row][owner]
        val bank=self.staged_bank_head.len()
        self.staged_bank_head.push(-1); self.staged_bank_tail.push(-1); self.staged_bank_len.push(0)
        val names: Dict<text, i64> = {}; self.staged_bank_name_rows.push(names)
        self.staged_owner_by_module[module_row][owner]=bank; bank
    me stage(module_row: i64,owner: i64,n: text,symbol_id: i64,has_t: bool,t: i64,has_d: bool,d: i64,volatile_value: bool,has_bits: bool,bits_value: i64,has_addr: bool,addr: i64,span: i64) -> i64:
        if self.frozen or self.error or module_row<0 or owner<0 or n=="" or symbol_id<0 or (has_t and t<0) or (not has_t and t!=-1) or (has_d and d<0) or (not has_d and d!=-1) or (has_bits and bits_value<=0) or (not has_bits and bits_value!=0) or (has_addr and addr<0) or (not has_addr and addr!=0) or span<0: self.error=true; return -1
        val row=self.staged_count; self.ensure_staged(row+1)
        val bank=self.ensure_staged_bank(module_row,owner)
        self.staged_module[row]=module_row; self.staged_owner[row]=owner; self.staged_name[row]=n
        self.staged_ordinal[row]=self.staged_bank_len[bank]
        self.staged_symbol[row]=symbol_id; self.staged_has_type[row]=has_t; self.staged_type[row]=t
        self.staged_has_default[row]=has_d; self.staged_default[row]=d; self.staged_volatile[row]=volatile_value
        self.staged_has_bits[row]=has_bits; self.staged_bits[row]=bits_value
        self.staged_has_address[row]=has_addr; self.staged_address[row]=addr; self.staged_span[row]=span
        self.staged_next[row]=-1
        if self.staged_bank_tail[bank]>=0: self.staged_next[self.staged_bank_tail[bank]]=row
        else: self.staged_bank_head[bank]=row
        self.staged_bank_tail[bank]=row; self.staged_bank_len[bank]=self.staged_bank_len[bank]+1
        # The name map indexes the first overload; ordinal lookup preserves
        # every later same-name member without overwriting it.
        if not self.staged_bank_name_rows[bank].contains_key(n):
            self.staged_bank_name_rows[bank][n]=row
        self.staged_count=row+1; row
    me staged_lookup_name(module_row: i64,owner: i64,n: text,g: i64) -> i64:
        if self.frozen or g!=self.generation or module_row<0 or module_row>=self.staged_owner_by_module.len() or not self.staged_owner_by_module[module_row].contains_key(owner): return -1
        val bank=self.staged_owner_by_module[module_row][owner]
        if self.staged_bank_name_rows[bank].contains_key(n): self.staged_bank_name_rows[bank][n] else: -1
    me drain_staged() -> bool:
        if self.frozen or self.error: return false
        var bank=0
        while bank<self.staged_bank_head.len():
            var row=self.staged_bank_head[bank]; var ordinal=0
            while row>=0:
                if self.publish(self.staged_module[row],self.staged_owner[row],self.staged_name[row],ordinal,self.staged_symbol[row],self.staged_has_type[row],self.staged_type[row],self.staged_has_default[row],self.staged_default[row],self.staged_volatile[row],self.staged_has_bits[row],self.staged_bits[row],self.staged_has_address[row],self.staged_address[row],self.staged_span[row])<0: return false
                row=self.staged_next[row]; ordinal=ordinal+1
            if ordinal!=self.staged_bank_len[bank]: self.error=true; return false
            bank=bank+1
        self.clear_staged_payload_range(0,self.staged_count); self.staged_count=0
        self.staged_owner_by_module=[]; self.staged_bank_head=[]
        self.staged_bank_tail=[]; self.staged_bank_len=[]; self.staged_bank_name_rows=[]; true
    me ensure(required: i64):
        if required<=self.capacity: return
        var target=if self.capacity<8: 8 else: self.capacity
        while target<required: target=target*2
        while self.ready.len()<target:
            self.ready.push(false); self.row_generation.push(-1); self.module_index.push(-1); self.owner_symbol.push(-1)
            self.name.push(""); self.ordinal.push(-1); self.symbol.push(-1); self.has_type.push(false); self.type_index.push(-1)
            self.has_default.push(false); self.default_expr.push(-1); self.volatile_.push(false); self.has_bits_attr.push(false); self.bits.push(0)
            self.has_fixed_address.push(false); self.fixed_address.push(0); self.span_index.push(-1)
        self.capacity=target
    me ensure_owner_bank(module_row: i64,owner: i64) -> i64:
        while self.owner_bank_by_module.len()<=module_row:
            val empty: Dict<i64, i64> = {}; self.owner_bank_by_module.push(empty)
        if self.owner_bank_by_module[module_row].contains_key(owner): return self.owner_bank_by_module[module_row][owner]
        val bank=self.bank_name_rows.len(); val names: Dict<text, i64> = {}
        self.bank_name_rows.push(names); self.bank_range_start.push(-1); self.bank_range_len.push(0); self.owner_bank_by_module[module_row][owner]=bank; bank
    me publish(module_row: i64,owner: i64,n: text,o: i64,symbol_id: i64,has_t: bool,t: i64,has_d: bool,d: i64,volatile_value: bool,has_bits: bool,bits_value: i64,has_addr: bool,addr: i64,span: i64) -> i64:
        if self.frozen or self.error or module_row<0 or owner<0 or n=="" or o<0 or symbol_id<0 or (has_t and t<0) or (not has_t and t!=-1) or (has_d and d<0) or (not has_d and d!=-1) or (has_bits and bits_value<=0) or (not has_bits and bits_value!=0) or (has_addr and addr<0) or (not has_addr and addr!=0) or span<0: self.error=true; return -1
        val bank=self.ensure_owner_bank(module_row,owner)
        val row=self.count; self.ensure(row+1); self.ready[row]=false; self.row_generation[row]=self.generation
        if self.bank_range_len[bank]>0:
            if self.bank_range_start[bank]+self.bank_range_len[bank]!=row or o!=self.bank_range_len[bank]: self.error=true; return -1
            self.bank_range_len[bank]=self.bank_range_len[bank]+1
        else:
            if o!=0: self.error=true; return -1
            self.bank_range_start[bank]=row; self.bank_range_len[bank]=1
        self.module_index[row]=module_row; self.owner_symbol[row]=owner; self.name[row]=n; self.ordinal[row]=o; self.symbol[row]=symbol_id
        self.has_type[row]=has_t; self.type_index[row]=t; self.has_default[row]=has_d; self.default_expr[row]=d
        self.volatile_[row]=volatile_value; self.has_bits_attr[row]=has_bits; self.bits[row]=bits_value; self.has_fixed_address[row]=has_addr; self.fixed_address[row]=addr; self.span_index[row]=span
        if not self.bank_name_rows[bank].contains_key(n): self.bank_name_rows[bank][n]=row
        self.ready[row]=true; self.count=row+1; row
    me building_lookup_name(module_row: i64,owner: i64,n: text,g: i64) -> i64:
        self.building_lookup_name_noalloc(module_row,owner,n,g)
    me building_lookup_ordinal(module_row: i64,owner: i64,o: i64,g: i64) -> i64:
        if self.frozen or g!=self.generation or module_row<0 or module_row>=self.owner_bank_by_module.len() or not self.owner_bank_by_module[module_row].contains_key(owner): return -1
        val bank=self.owner_bank_by_module[module_row][owner]
        if o<0 or o>=self.bank_range_len[bank]: return -1
        val row=self.bank_range_start[bank]+o; if self.building_valid(row,g) and self.ordinal[row]==o: row else: -1
    me lookup_name(module_row: i64,owner: i64,n: text,g: i64) -> i64:
        if not self.frozen or g!=self.generation or module_row<0 or module_row>=self.owner_bank_by_module.len() or not self.owner_bank_by_module[module_row].contains_key(owner): return -1
        val bank=self.owner_bank_by_module[module_row][owner]
        if not self.bank_name_rows[bank].contains_key(n): return -1
        val row=self.bank_name_rows[bank][n]; if self.valid(row,g): row else: -1
    me lookup_ordinal(module_row: i64,owner: i64,o: i64,g: i64) -> i64:
        if not self.frozen or g!=self.generation or module_row<0 or module_row>=self.owner_bank_by_module.len() or not self.owner_bank_by_module[module_row].contains_key(owner): return -1
        val bank=self.owner_bank_by_module[module_row][owner]
        if o<0 or o>=self.bank_range_len[bank]: return -1
        val row=self.bank_range_start[bank]+o; if self.valid(row,g) and self.ordinal[row]==o: row else: -1
    me building_lookup_name_noalloc(module_row: i64,owner: i64,n: text,g: i64) -> i64:
        if self.frozen or g!=self.generation or module_row<0 or module_row>=self.owner_bank_by_module.len() or not self.owner_bank_by_module[module_row].contains_key(owner): return -1
        val bank=self.owner_bank_by_module[module_row][owner]
        if not self.bank_name_rows[bank].contains_key(n): return -1
        val row=self.bank_name_rows[bank][n]; if self.building_valid(row,g): row else: -1
    me owner_range_start(module_row: i64,owner: i64,g: i64,read_mode: bool) -> i64:
        if g!=self.generation or (read_mode and not self.frozen) or (not read_mode and self.frozen): return -1
        if module_row<0 or module_row>=self.owner_bank_by_module.len() or not self.owner_bank_by_module[module_row].contains_key(owner): return -1
        self.bank_range_start[self.owner_bank_by_module[module_row][owner]]
    me owner_range_len(module_row: i64,owner: i64,g: i64,read_mode: bool) -> i64:
        if g!=self.generation or (read_mode and not self.frozen) or (not read_mode and self.frozen): return -1
        if module_row<0 or module_row>=self.owner_bank_by_module.len() or not self.owner_bank_by_module[module_row].contains_key(owner): return -1
        self.bank_range_len[self.owner_bank_by_module[module_row][owner]]
    me building_valid(row: i64,g: i64) -> bool: not self.frozen and g==self.generation and row>=0 and row<self.count and self.ready[row] and self.row_generation[row]==g
    me valid(row: i64,g: i64) -> bool: self.frozen and g==self.generation and row>=0 and row<self.count and self.ready[row] and self.row_generation[row]==g
    fn can_rollback(target: i64,staged_target: i64) -> bool:
        not self.frozen and target>=0 and target<=self.count and staged_target>=0 and staged_target<=self.staged_count
    me rollback(target: i64,staged_target: i64,old_error: bool) -> bool:
        if not self.can_rollback(target,staged_target): return false
        val previous_staged_count=self.staged_count
        var i=target
        while i<self.count:
            self.ready[i]=false; self.row_generation[i]=-1; self.module_index[i]=-1; self.owner_symbol[i]=-1; self.name[i]=""; self.ordinal[i]=-1; self.symbol[i]=-1; self.has_type[i]=false; self.type_index[i]=-1; self.has_default[i]=false; self.default_expr[i]=-1; self.volatile_[i]=false; self.has_bits_attr[i]=false; self.bits[i]=0; self.has_fixed_address[i]=false; self.fixed_address[i]=0; self.span_index[i]=-1; i=i+1
        self.count=target; self.owner_bank_by_module=[]; self.bank_name_rows=[]; self.bank_range_start=[]; self.bank_range_len=[]; i=0
        while i<target:
            val bank=self.ensure_owner_bank(self.module_index[i],self.owner_symbol[i])
            if self.bank_range_len[bank]==0: self.bank_range_start[bank]=i
            self.bank_range_len[bank]=self.bank_range_len[bank]+1
            if not self.bank_name_rows[bank].contains_key(self.name[i]): self.bank_name_rows[bank][self.name[i]]=i
            i=i+1
        self.staged_owner_by_module=[]
        self.staged_bank_head=[]; self.staged_bank_tail=[]; self.staged_bank_len=[]; self.staged_bank_name_rows=[]; i=0
        while i<staged_target:
            val bank=self.ensure_staged_bank(self.staged_module[i],self.staged_owner[i])
            self.staged_ordinal[i]=self.staged_bank_len[bank]
            self.staged_next[i]=-1
            if self.staged_bank_tail[bank]>=0: self.staged_next[self.staged_bank_tail[bank]]=i
            else: self.staged_bank_head[bank]=i
            self.staged_bank_tail[bank]=i; self.staged_bank_len[bank]=self.staged_bank_len[bank]+1; i=i+1
            if not self.staged_bank_name_rows[bank].contains_key(self.staged_name[i-1]): self.staged_bank_name_rows[bank][self.staged_name[i-1]]=i-1
        self.clear_staged_payload_range(staged_target,previous_staged_count)
        self.staged_count=staged_target
        self.error=old_error; true
    me can_freeze() -> bool:
        if self.error or self.staged_count!=0: return false
        var i=0
        while i<self.count: if not self.ready[i] or self.row_generation[i]!=self.generation: return false else: i=i+1
        true
    me freeze() -> bool:
        if not self.can_freeze(): return false
        self.frozen=true; true
    me commit_freeze():
        self.frozen = true
    me capacity_bytes_estimate() -> i64: self.capacity*145+self.staged_capacity*130
    me text_payload_bytes() -> i64:
        var total=0; var i=0
        while i<self.name.len(): total=total+self.name[i].len(); i=i+1
        i=0
        # Scan reusable capacity, not only the logical count.  This keeps the
        # accounting honest if a future lifecycle path forgets to scrub an
        # inactive slot instead of hiding the retained string behind count=0.
        while i<self.staged_name.len(): total=total+self.staged_name[i].len(); i=i+1
        total

export HirDestinationMemberStore
