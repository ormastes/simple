# Destination-owned lowering for calls, closures, and control expressions.
# The registry remains the sole aggregate owner; this module transports only
# scalar indices and publishes every parent after all of its children.
use compiler.frontend.parser_types_expr.*
use compiler.hir.hir_types.{ScopeKind, SymbolKind}
use compiler.common.dependency.visibility.{Visibility}
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.hir_destination_graph.*
use compiler.hir.hir_lowering.hir_destination_registry_writer.*
use compiler.hir.hir_lowering._Expressions.destination_types_patterns.*

impl HirLowering:
    me destination_calls_control_fail(e: Expr, message: text) -> i64:
        self.error("E-HIR-DEST-CALL-CONTROL: {message}", e.span)
        -1

    me destination_cc_reserve_expr(e: Expr) -> i64:
        hdw_reserve_expr(self.destination_slot, self.destination_generation,
            e.span.start, e.span.end, e.span.line, e.span.col, e.span.file, e.span.length)

    me destination_cc_reserve_aux_at(start: i64, end: i64, line: i64, col: i64, file: text, length: i64) -> i64:
        hdw_reserve_aux(self.destination_slot, self.destination_generation,
            start, end, line, col, file, length)

    # Called only after the master dispatcher identifies one of the variants
    # below. A non-member variant is rejected; the public boundary owns rollback.
    me destination_lower_calls_control(e: Expr) -> i64:
        val parent = self.destination_cc_reserve_expr(e)
        if parent < 0:
            return self.destination_calls_control_fail(e,
                "destination call/control parent reservation failed")

        match e.kind:
            case ExprKind.Call(callee, args):
                # Preserve the legacy fixed-width numeric constructor rule
                # without materializing HirType/HirExpr aggregates.
                match callee.kind:
                    case ExprKind.Ident(name):
                        if self.constructor_access_for_name(name) == 0:
                            return self.destination_calls_control_fail(e,
                                "aggregate constructor is not visible")
                        var cast_bits = 0
                        var cast_signed = false
                        var cast_float = false
                        match name:
                            case "i8": cast_bits = 8; cast_signed = true
                            case "i16": cast_bits = 16; cast_signed = true
                            case "i32": cast_bits = 32; cast_signed = true
                            case "i64": cast_bits = 64; cast_signed = true
                            case "u8": cast_bits = 8
                            case "u16": cast_bits = 16
                            case "u32": cast_bits = 32
                            case "u64": cast_bits = 64
                            case "f32": cast_bits = 32; cast_float = true
                            case "f64": cast_bits = 64; cast_float = true
                            case "float": cast_bits = 64; cast_float = true
                            case _: ()
                        if cast_bits > 0 and args.len() == 1 and not args[0].has_name:
                            val type_index = hdw_reserve_type(self.destination_slot,
                                self.destination_generation, e.span.start, e.span.end,
                                e.span.line, e.span.col, e.span.file, e.span.length)
                            if type_index < 0: return -1
                            val type_ok = if cast_float:
                                hdw_type_float(self.destination_slot,
                                    self.destination_generation, type_index, cast_bits)
                            else:
                                hdw_type_int(self.destination_slot,
                                    self.destination_generation, type_index,
                                    cast_bits, cast_signed)
                            if not type_ok: return -1
                            val value_index = self.destination_lower_expr(args[0].value)
                            # Cast expressions carry the exact target type in
                            # both their payload and authoritative type column.
                            if (value_index < 0 or not hdw_set_expr_type(
                                    self.destination_slot, self.destination_generation,
                                    parent, true, type_index) or
                                not hdw_cast_like(self.destination_slot,
                                    self.destination_generation, parent,
                                    HD_EXPR_CAST, value_index, type_index)):
                                return -1
                            return parent
                    case ExprKind.Field(constructor_base, constructor_name):
                        var access = self.constructor_access_for_name(constructor_name)
                        match constructor_base.kind:
                            case ExprKind.Ident(qualifier):
                                access = self.qualified_constructor_access(
                                    qualifier, constructor_name)
                            case _: ()
                        if access == 0:
                            return self.destination_calls_control_fail(e,
                                "qualified aggregate constructor is not visible")
                    case _: ()
                # Parent and both fixed ranges precede recursive descent.
                val arg_range = hdw_reserve_range(self.destination_slot,
                    self.destination_generation, HD_RANGE_AUX,
                    HD_AUX_RANGE_CALL_ARG, args.len())
                val type_range = hdw_reserve_range(self.destination_slot,
                    self.destination_generation, HD_RANGE_TYPE,
                    HD_AUX_RANGE_NONE, 0)
                if arg_range < 0 or type_range < 0:
                    return self.destination_calls_control_fail(e,
                        "destination call range reservation failed")
                val callee_index = self.destination_lower_expr(callee)
                if callee_index < 0:
                    return self.destination_calls_control_fail(e,
                        "destination call callee lowering failed")
                # Keep the parser-owned argument array rooted in this variant
                # arm. Only one typed item and scalar row indices cross calls.
                var arg_offset = 0
                while arg_offset < args.len():
                    val arg: CallArg = args[arg_offset]
                    val aux = self.destination_cc_reserve_aux_at(arg.span.start,
                        arg.span.end, arg.span.line, arg.span.col,
                        arg.span.file, arg.span.length)
                    if aux < 0:
                        return self.destination_calls_control_fail(e,
                            "destination call argument reservation failed")
                    val value_index = self.destination_lower_expr(arg.value)
                    if (value_index < 0 or not hdw_call_arg(self.destination_slot,
                            self.destination_generation, aux, arg.has_name,
                            arg.name, value_index) or
                        not hdw_set_range_at(self.destination_slot,
                            self.destination_generation, arg_range,
                            HD_AUX_RANGE_CALL_ARG, arg_offset, aux)):
                        return self.destination_calls_control_fail(e,
                            "destination call argument lowering failed")
                    arg_offset = arg_offset + 1
                if not hdw_publish_range(self.destination_slot,
                        self.destination_generation, arg_range,
                        HD_RANGE_AUX, HD_AUX_RANGE_CALL_ARG):
                    return self.destination_calls_control_fail(e,
                        "destination call argument range publication failed")
                if not hdw_publish_range(self.destination_slot, self.destination_generation,
                    type_range, HD_RANGE_TYPE, HD_AUX_RANGE_NONE):
                    return self.destination_calls_control_fail(e,
                        "destination call type range publication failed")
                if not hdw_call(self.destination_slot, self.destination_generation,
                    parent, callee_index, arg_range, args.len(), type_range, 0):
                    return self.destination_calls_control_fail(e,
                        "destination call publication failed")
                return parent

            case ExprKind.MethodCall(receiver, method, args):
                # Resolve a module namespace call before reserving the mutually
                # exclusive method-resolution row.
                var module_callable_id = -1
                var module_callable_name = ""
                var module_callable_module = -1
                var instance_owner_symbol = -1
                var instance_member_symbol = -1
                var instance_member_module = -1
                var method_result_type = -1
                match receiver.kind:
                    case ExprKind.Ident(receiver_name):
                        if val receiver_symbol = self.symbols.lookup(receiver_name):
                            if val receiver_record = self.symbols.get_symbol_raw(receiver_symbol.id):
                                if val module_name = receiver_record.defining_module:
                                    if val callable = self.field_module_callable(module_name, method):
                                        module_callable_id = callable.id
                                        module_callable_name = self.symbols.symbol_display_name(callable, method)
                                        module_callable_module =
                                            self.destination_named_symbol_module(
                                                callable.id, e.span)
                                        if module_callable_module < 0: return -1
                            if module_callable_id < 0:
                                val receiver_type =
                                    self.destination_direct_symbol_type(receiver)
                                var builtin_dict_projection = false
                                if (receiver_type >= 0 and args.len() == 0 and
                                    (method == "keys" or method == "values") and
                                    hdw_destination_type_shape(
                                        self.destination_slot,
                                        self.destination_generation,
                                        receiver_type) == HD_TYPE_DICT):
                                    val element_type = if method == "keys":
                                        hdw_destination_type_child0(
                                            self.destination_slot,
                                            self.destination_generation,
                                            receiver_type)
                                    else:
                                        hdw_destination_type_child1(
                                            self.destination_slot,
                                            self.destination_generation,
                                            receiver_type)
                                    method_result_type = hdw_reserve_type(
                                        self.destination_slot,
                                        self.destination_generation,
                                        e.span.start, e.span.end, e.span.line,
                                        e.span.col, e.span.file, e.span.length)
                                    if (element_type < 0 or method_result_type < 0 or
                                        not hdw_type_array(self.destination_slot,
                                            self.destination_generation,
                                            method_result_type, element_type,
                                            false, -1)):
                                        return self.destination_calls_control_fail(e,
                                            "destination dictionary method result type failed")
                                    builtin_dict_projection = true
                                if not builtin_dict_projection:
                                    val member_row =
                                        self.resolve_current_destination_member_from_symbol(
                                            receiver_symbol.id, method)
                                    if member_row < 0:
                                        self.error(
                                            "E-HIR-DEST-METHOD-RESOLUTION: method `" +
                                            method + "` has no module-qualified destination member",
                                            e.span)
                                        return -1
                                    instance_owner_symbol =
                                        hdw_destination_member_owner(
                                            self.destination_slot,
                                            self.destination_generation,
                                            member_row)
                                    instance_member_symbol =
                                        hdw_destination_member_symbol(
                                            self.destination_slot,
                                            self.destination_generation,
                                            member_row)
                                    instance_member_module =
                                        hdw_destination_member_module(
                                            self.destination_slot,
                                            self.destination_generation,
                                            member_row)
                                    if (instance_owner_symbol < 0 or
                                        instance_member_symbol < 0 or
                                        instance_member_module < 0):
                                        return self.destination_calls_control_fail(e,
                                            "destination member receipt is incomplete")
                    case _: ()
                val arg_range = hdw_reserve_range(self.destination_slot,
                    self.destination_generation, HD_RANGE_AUX,
                    HD_AUX_RANGE_CALL_ARG, args.len())
                val resolution = if module_callable_id < 0:
                    self.destination_cc_reserve_aux_at(e.span.start, e.span.end,
                        e.span.line, e.span.col, e.span.file, e.span.length)
                else: -1
                val callee_row = if module_callable_id >= 0:
                    self.destination_cc_reserve_expr(e)
                else: -1
                val type_range = if module_callable_id >= 0:
                    hdw_reserve_range(self.destination_slot,
                        self.destination_generation, HD_RANGE_TYPE,
                        HD_AUX_RANGE_NONE, 0)
                else: -1
                if (arg_range < 0 or (module_callable_id < 0 and resolution < 0) or
                    (module_callable_id >= 0 and (callee_row < 0 or type_range < 0))):
                    return self.destination_calls_control_fail(e,
                        "destination method-call reservation failed")
                val receiver_index = if module_callable_id < 0:
                    self.destination_lower_expr(receiver)
                else: -1
                if module_callable_id < 0 and receiver_index < 0:
                    return self.destination_calls_control_fail(e,
                        "destination method-call receiver lowering failed")
                # Do not forward the wide argument array through a helper: the
                # variant arm owns it until every scalar aux receipt is written.
                var method_arg_offset = 0
                while method_arg_offset < args.len():
                    val arg: CallArg = args[method_arg_offset]
                    val aux = self.destination_cc_reserve_aux_at(arg.span.start,
                        arg.span.end, arg.span.line, arg.span.col,
                        arg.span.file, arg.span.length)
                    if aux < 0:
                        return self.destination_calls_control_fail(e,
                            "destination method-call argument reservation failed")
                    val value_index = self.destination_lower_expr(arg.value)
                    if (value_index < 0 or not hdw_call_arg(self.destination_slot,
                            self.destination_generation, aux, arg.has_name,
                            arg.name, value_index) or
                        not hdw_set_range_at(self.destination_slot,
                            self.destination_generation, arg_range,
                            HD_AUX_RANGE_CALL_ARG, method_arg_offset, aux)):
                        return self.destination_calls_control_fail(e,
                            "destination method-call argument lowering failed")
                    method_arg_offset = method_arg_offset + 1
                if not hdw_publish_range(self.destination_slot,
                        self.destination_generation, arg_range,
                        HD_RANGE_AUX, HD_AUX_RANGE_CALL_ARG):
                    return self.destination_calls_control_fail(e,
                        "destination method-call argument range publication failed")
                if module_callable_id >= 0:
                    if (not hdw_qualified_named_var(self.destination_slot,
                            self.destination_generation, callee_row,
                            module_callable_module, module_callable_id,
                            module_callable_name) or
                        not hdw_publish_range(self.destination_slot,
                            self.destination_generation, type_range,
                            HD_RANGE_TYPE, HD_AUX_RANGE_NONE) or
                        not hdw_call(self.destination_slot,
                            self.destination_generation, parent, callee_row,
                            arg_range, args.len(), type_range, 0)):
                        return self.destination_calls_control_fail(e,
                            "destination module-qualified call publication failed")
                    return parent
                val resolution_shape = if instance_member_symbol >= 0:
                    HD_RESOLUTION_QUALIFIED_INSTANCE
                else: HD_RESOLUTION_UNRESOLVED
                val resolution_ok = if instance_member_symbol >= 0:
                    hdw_qualified_method_resolution(self.destination_slot,
                        self.destination_generation, resolution,
                        resolution_shape, instance_member_module,
                        instance_owner_symbol, instance_member_symbol)
                else:
                    hdw_method_resolution(self.destination_slot,
                        self.destination_generation, resolution,
                        resolution_shape, -1, -1)
                if not resolution_ok:
                    return self.destination_calls_control_fail(e,
                        "destination method resolution publication failed")
                if not hdw_method_call(self.destination_slot, self.destination_generation,
                    parent, receiver_index, method, arg_range, args.len(), resolution):
                    return self.destination_calls_control_fail(e,
                        "destination method-call publication failed")
                if method_result_type >= 0 and not hdw_set_expr_type(
                        self.destination_slot, self.destination_generation,
                        parent, method_result_type):
                    return self.destination_calls_control_fail(e,
                        "destination method result type publication failed")
                return parent

            case ExprKind.If(cond, then_block, else_block):
                val cond_index = self.destination_lower_expr(cond)
                val then_index = self.destination_lower_block(then_block, true)
                if cond_index < 0 or then_index < 0:
                    return self.destination_calls_control_fail(e,
                        "destination if child lowering failed")
                var has_else = false
                var else_index = -1
                match else_block:
                    case Some(body):
                        has_else = true
                        else_index = self.destination_lower_block(body, true)
                    case _: ()
                if has_else and else_index < 0:
                    return self.destination_calls_control_fail(e,
                        "destination if else lowering failed")
                if not hdw_if(self.destination_slot, self.destination_generation,
                    parent, cond_index, then_index, has_else, else_index):
                    return self.destination_calls_control_fail(e,
                        "destination if publication failed")
                return parent

            case ExprKind.IfChain(arms, else_block):
                val arm_range = hdw_reserve_range(self.destination_slot,
                    self.destination_generation, HD_RANGE_AUX,
                    HD_AUX_RANGE_IF_ARM, arms.len())
                if arm_range < 0:
                    return self.destination_calls_control_fail(e,
                        "destination if-chain range reservation failed")
                var arm_offset = 0
                while arm_offset < arms.len():
                    val arm: IfArm = arms[arm_offset]
                    val aux = self.destination_cc_reserve_aux_at(arm.span.start, arm.span.end,
                        arm.span.line, arm.span.col, arm.span.file, arm.span.length)
                    if aux < 0:
                        return self.destination_calls_control_fail(e,
                            "destination if-chain arm reservation failed")
                    val cond_index = self.destination_lower_expr(arm.cond)
                    val body_index = self.destination_lower_block(arm.then_, true)
                    if (cond_index < 0 or body_index < 0 or
                        not hdw_if_arm(self.destination_slot, self.destination_generation,
                            aux, cond_index, body_index) or
                        not hdw_set_range_at(self.destination_slot,
                            self.destination_generation, arm_range,
                            HD_AUX_RANGE_IF_ARM, arm_offset, aux)):
                        return self.destination_calls_control_fail(e,
                            "destination if-chain arm lowering failed")
                    arm_offset = arm_offset + 1
                if not hdw_publish_range(self.destination_slot,
                    self.destination_generation, arm_range,
                    HD_RANGE_AUX, HD_AUX_RANGE_IF_ARM):
                    return self.destination_calls_control_fail(e,
                        "destination if-chain range publication failed")
                var has_else = false
                var else_index = -1
                match else_block:
                    case Some(body):
                        has_else = true
                        else_index = self.destination_lower_block(body, true)
                    case _: ()
                if has_else and else_index < 0:
                    return self.destination_calls_control_fail(e,
                        "destination if-chain else lowering failed")
                if not hdw_if_chain(self.destination_slot, self.destination_generation,
                    parent, arm_range, arms.len(), has_else, else_index):
                    return self.destination_calls_control_fail(e,
                        "destination if-chain publication failed")
                return parent

            case ExprKind.MatchCase(scrutinee, arms):
                val arm_range = hdw_reserve_range(self.destination_slot,
                    self.destination_generation, HD_RANGE_AUX,
                    HD_AUX_RANGE_MATCH_ARM, arms.len())
                if arm_range < 0:
                    return self.destination_calls_control_fail(e,
                        "destination match range reservation failed")
                val scrutinee_index = self.destination_lower_expr(scrutinee)
                if scrutinee_index < 0:
                    return self.destination_calls_control_fail(e,
                        "destination match scrutinee lowering failed")
                var arm_offset = 0
                while arm_offset < arms.len():
                    val arm: MatchArm = arms[arm_offset]
                    val aux = self.destination_cc_reserve_aux_at(arm.span.start, arm.span.end,
                        arm.span.line, arm.span.col, arm.span.file, arm.span.length)
                    if aux < 0:
                        return self.destination_calls_control_fail(e,
                            "destination match arm reservation failed")
                    self.symbols.push_scope(ScopeKind.Block)
                    var effective_has_guard = arm.has_guard
                    var pattern_index = -1
                    var guard_index = -1
                    match arm.pattern.kind:
                        case PatternKind.Guard(inner, condition):
                            if arm.has_guard:
                                self.error("E-HIR-DEST-NESTED-PATTERN-GUARD: match arm carries both pattern and arm guards", arm.span)
                            else:
                                effective_has_guard = true
                                pattern_index = self.destination_lower_pattern(inner)
                                if pattern_index >= 0:
                                    guard_index = self.destination_lower_expr(condition)
                        case _:
                            pattern_index = self.destination_lower_pattern(arm.pattern)
                            if arm.has_guard:
                                guard_index = self.destination_lower_expr(arm.guard)
                    val body_index = self.destination_lower_block(arm.body, true)
                    self.symbols.pop_scope()
                    if pattern_index < 0 or (effective_has_guard and guard_index < 0) or body_index < 0:
                        return self.destination_calls_control_fail(e,
                            "destination match arm child lowering failed")
                    if (not hdw_match_arm(self.destination_slot,
                        self.destination_generation, aux, pattern_index,
                        effective_has_guard, guard_index, body_index) or
                        not hdw_set_range_at(self.destination_slot,
                            self.destination_generation, arm_range,
                            HD_AUX_RANGE_MATCH_ARM, arm_offset, aux)):
                        return self.destination_calls_control_fail(e,
                            "destination match arm publication failed")
                    arm_offset = arm_offset + 1
                if (not hdw_publish_range(self.destination_slot,
                    self.destination_generation, arm_range,
                    HD_RANGE_AUX, HD_AUX_RANGE_MATCH_ARM) or
                    not hdw_match(self.destination_slot, self.destination_generation,
                        parent, scrutinee_index, arm_range, arms.len())):
                    return self.destination_calls_control_fail(e,
                        "destination match publication failed")
                return parent

            case ExprKind.Try(value):
                val child = self.destination_lower_expr(value)
                if child < 0 or not hdw_single_expr(self.destination_slot,
                    self.destination_generation, parent, HD_EXPR_TRY, child):
                    return self.destination_calls_control_fail(e,
                        "destination try publication failed")
                return parent

            case ExprKind.TryCatch(body, clauses, finally_block):
                val clause_range = hdw_reserve_range(self.destination_slot,
                    self.destination_generation, HD_RANGE_AUX,
                    HD_AUX_RANGE_CATCH, clauses.len())
                if clause_range < 0:
                    return self.destination_calls_control_fail(e,
                        "destination catch range reservation failed")
                val body_index = self.destination_lower_block(body, true)
                if body_index < 0:
                    return self.destination_calls_control_fail(e,
                        "destination try body lowering failed")
                var clause_offset = 0
                while clause_offset < clauses.len():
                    val clause: CatchClause = clauses[clause_offset]
                    val aux = self.destination_cc_reserve_aux_at(clause.span.start,
                        clause.span.end, clause.span.line, clause.span.col,
                        clause.span.file, clause.span.length)
                    if aux < 0:
                        return self.destination_calls_control_fail(e,
                            "destination catch reservation failed")
                    self.symbols.push_scope(ScopeKind.Block)
                    var pattern_index = -1
                    if clause.has_pattern:
                        pattern_index = self.destination_lower_pattern(clause.pattern)
                    var type_index = -1
                    if clause.has_type_:
                        type_index = self.destination_lower_type(clause.type_)
                    val catch_body = self.destination_lower_block(clause.body, true)
                    self.symbols.pop_scope()
                    if ((clause.has_pattern and pattern_index < 0) or
                        (clause.has_type_ and type_index < 0) or catch_body < 0):
                        return self.destination_calls_control_fail(e,
                            "destination catch child lowering failed")
                    if (not hdw_catch(self.destination_slot, self.destination_generation,
                        aux, clause.has_pattern, pattern_index, clause.has_type_,
                        type_index, catch_body) or
                        not hdw_set_range_at(self.destination_slot,
                            self.destination_generation, clause_range,
                            HD_AUX_RANGE_CATCH, clause_offset, aux)):
                        return self.destination_calls_control_fail(e,
                            "destination catch publication failed")
                    clause_offset = clause_offset + 1
                if not hdw_publish_range(self.destination_slot,
                    self.destination_generation, clause_range,
                    HD_RANGE_AUX, HD_AUX_RANGE_CATCH):
                    return self.destination_calls_control_fail(e,
                        "destination catch range publication failed")
                var has_finally = false
                var finally_index = -1
                match finally_block:
                    case Some(finally_body):
                        has_finally = true
                        finally_index = self.destination_lower_block(finally_body, false)
                    case _: ()
                if has_finally and finally_index < 0:
                    return self.destination_calls_control_fail(e,
                        "destination finally lowering failed")
                if not hdw_try_catch(self.destination_slot,
                    self.destination_generation, parent, body_index,
                    clause_range, clauses.len(), has_finally, finally_index):
                    return self.destination_calls_control_fail(e,
                        "destination try-catch publication failed")
                return parent

            case ExprKind.Lambda(params, body):
                val param_range = hdw_reserve_range(self.destination_slot,
                    self.destination_generation, HD_RANGE_AUX,
                    HD_AUX_RANGE_VALUE_PARAM, params.len())
                val capture_range = hdw_reserve_range(self.destination_slot,
                    self.destination_generation, HD_RANGE_AUX,
                    HD_AUX_RANGE_SYMBOL_REF, 0)
                if param_range < 0 or capture_range < 0:
                    return self.destination_calls_control_fail(e,
                        "destination lambda range reservation failed")
                self.symbols.push_scope(ScopeKind.Function)
                var param_offset = 0
                var params_ok = true
                while param_offset < params.len() and params_ok:
                    val param: LambdaParam = params[param_offset]
                    val aux = self.destination_cc_reserve_aux_at(param.span.start,
                        param.span.end, param.span.line, param.span.col,
                        param.span.file, param.span.length)
                    var type_index = -1
                    if param.has_type_:
                        type_index = self.destination_lower_type(param.type_)
                    else:
                        type_index = hdw_reserve_type(self.destination_slot,
                            self.destination_generation, param.span.start,
                            param.span.end, param.span.line, param.span.col,
                            param.span.file, param.span.length)
                        if type_index >= 0:
                            if not hdw_type_infer(self.destination_slot,
                                self.destination_generation, type_index, 0, 0):
                                type_index = -1
                    if aux < 0 or type_index < 0:
                        params_ok = false
                    else:
                        # The destination graph is canonical type authority.
                        # This symbol entry exists only for recursive name lookup;
                        # no aggregate HirType is materialized or copied here.
                        val symbol = self.symbols.define(param.name,
                            SymbolKind.Parameter, nil, param.span,
                            Visibility.Private, false, nil)
                        if (symbol.id < 0 or not self.destination_publish_local_symbol(
                                symbol.id, param.name, true, type_index,
                                SymbolKind.Parameter, false, param.span) or
                            not hdw_param_aux(self.destination_slot,
                            self.destination_generation, aux, symbol.id,
                            type_index, false, -1, false, param.name) or
                            not hdw_set_range_at(self.destination_slot,
                                self.destination_generation, param_range,
                                HD_AUX_RANGE_VALUE_PARAM, param_offset, aux)):
                            params_ok = false
                    param_offset = param_offset + 1
                var body_index = -1
                if params_ok:
                    body_index = self.destination_lower_expr(body)
                self.symbols.pop_scope()
                if not params_ok or body_index < 0:
                    return self.destination_calls_control_fail(e,
                        "destination lambda child lowering failed")
                if (not hdw_publish_range(self.destination_slot,
                    self.destination_generation, param_range,
                    HD_RANGE_AUX, HD_AUX_RANGE_VALUE_PARAM) or
                    not hdw_publish_range(self.destination_slot,
                        self.destination_generation, capture_range,
                        HD_RANGE_AUX, HD_AUX_RANGE_SYMBOL_REF) or
                    not hdw_lambda(self.destination_slot,
                        self.destination_generation, parent, param_range,
                        params.len(), body_index, capture_range, 0)):
                    return self.destination_calls_control_fail(e,
                        "destination lambda publication failed")
                return parent

            case ExprKind.Return(value):
                var has_value = false
                var value_index = -1
                match value:
                    case Some(return_value):
                        has_value = true
                        value_index = self.destination_lower_expr(return_value)
                    case _: ()
                if ((has_value and value_index < 0) or
                    not hdw_return_rich(self.destination_slot,
                        self.destination_generation, parent,
                        has_value, value_index)):
                    return self.destination_calls_control_fail(e,
                        "destination return publication failed")
                return parent

            case ExprKind.Break(label):
                var label_text = ""
                match label:
                    case Some(value): label_text = value
                    case _: ()
                if not hdw_break(self.destination_slot, self.destination_generation,
                    parent, label_text, false, -1):
                    return self.destination_calls_control_fail(e,
                        "destination break publication failed")
                return parent

            case ExprKind.Continue(label):
                var has_label = false
                var label_text = ""
                match label:
                    case Some(value): has_label = true; label_text = value
                    case _: ()
                if not hdw_continue(self.destination_slot,
                    self.destination_generation, parent, has_label, label_text):
                    return self.destination_calls_control_fail(e,
                        "destination continue publication failed")
                return parent

            case ExprKind.Yield(value):
                var has_value = false
                var value_index = -1
                match value:
                    case Some(yield_value):
                        has_value = true
                        value_index = self.destination_lower_expr(yield_value)
                    case _: ()
                if ((has_value and value_index < 0) or
                    not hdw_yield(self.destination_slot,
                        self.destination_generation, parent,
                        has_value, value_index)):
                    return self.destination_calls_control_fail(e,
                        "destination yield publication failed")
                return parent

            case ExprKind.Throw(value):
                val child = self.destination_lower_expr(value)
                if child < 0 or not hdw_single_expr(self.destination_slot,
                    self.destination_generation, parent, HD_EXPR_THROW, child):
                    return self.destination_calls_control_fail(e,
                        "destination throw publication failed")
                return parent

            case ExprKind.Await(value):
                val child = self.destination_lower_expr(value)
                if child < 0 or not hdw_single_expr(self.destination_slot,
                    self.destination_generation, parent, HD_EXPR_AWAIT, child):
                    return self.destination_calls_control_fail(e,
                        "destination await publication failed")
                return parent

            # Keep this colliding variant name last: the bootstrap seed can
            # otherwise miscompile `Block` as the parser struct pattern.
            case ExprKind.Block(body):
                val block_index = self.destination_lower_block(body, true)
                if block_index < 0 or not hdw_block_control(self.destination_slot,
                    self.destination_generation, parent, HD_EXPR_BLOCK, block_index):
                    return self.destination_calls_control_fail(e,
                        "destination block publication failed")
                return parent

            case _:
                self.destination_calls_control_fail(e,
                    "destination call/control dispatcher received unsupported expression")

export HirLowering
