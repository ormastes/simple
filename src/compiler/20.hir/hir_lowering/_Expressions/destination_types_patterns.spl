# Source-to-destination lowering for types, patterns, effects, and dimensions.
#
# The registry is the sole aggregate owner.  These methods retain only scalar
# slot/generation handles, reserve parent/range storage before recursion, and
# publish children before the fixed-shape parent row.
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.hir_destination_graph.*
use compiler.hir.hir_lowering.hir_destination_registry_writer.*
use compiler.frontend.parser_types.*
use compiler.frontend.parser_types_expr.*
use compiler.common.dependency.visibility.{Visibility}
use compiler.frontend.core.types.{custom_primitive_bind_symbol, custom_primitive_is_name}
use compiler.hir.hir_lowering.module_surface_registry_index.{
    module_surface_registry_index, module_surface_resolve_absolute_key,
    module_surface_resolve_import_key
}

fn destination_visibility_wire(visibility: Visibility) -> i64:
    match visibility:
        case Visibility.Public: 0
        case Visibility.Peer: 1
        case Visibility.Up: 2
        case Visibility.Internal: 3
        case Visibility.Package: 4
        case Visibility.Private: 5

fn destination_symbol_kind_wire(kind: SymbolKind) -> i64:
    match kind:
        case SymbolKind.Function: 0
        case SymbolKind.Method: 1
        case SymbolKind.Variable: 2
        case SymbolKind.Parameter: 3
        case SymbolKind.Field: 4
        case SymbolKind.Class: 5
        case SymbolKind.Struct: 6
        case SymbolKind.Enum: 7
        case SymbolKind.EnumVariant: 8
        case SymbolKind.Trait: 9
        case SymbolKind.TypeAlias: 10
        case SymbolKind.TypeParam: 11
        case SymbolKind.Const: 12
        case SymbolKind.Module: 13
        case SymbolKind.Import: 14

extern fn rt_enum_discriminant(value: TypeKind) -> i64

impl HirLowering:
    me destination_named_symbol_module(symbol: i64, span: Span) -> i64:
        if val record = self.symbols.get_symbol_raw(symbol):
            if val defining_module = record.defining_module:
                var facade_index = module_surface_registry_index(
                    self.module_surfaces, self.module_filename)
                if facade_index < 0:
                    val facade_key = module_surface_resolve_absolute_key(
                        self.module_surfaces, self.module_filename)
                    if facade_key != "":
                        facade_index = module_surface_registry_index(
                            self.module_surfaces, facade_key)
                val resolved_key = if facade_index >= 0:
                    module_surface_resolve_import_key(self.module_surfaces,
                        self.module_surfaces.surfaces[facade_index],
                        defining_module)
                else:
                    module_surface_resolve_absolute_key(
                        self.module_surfaces, defining_module)
                if resolved_key == "":
                    self.error("E-HIR-DEST-NAMED-MODULE: defining module `" +
                        defining_module + "` cannot be canonically resolved", span)
                    return -1
                val resolved_index = module_surface_registry_index(
                    self.module_surfaces, resolved_key)
                if resolved_index < 0:
                    self.error("E-HIR-DEST-NAMED-MODULE: resolved module `" +
                        resolved_key + "` has no module surface", span)
                    return -1
                val canonical_path =
                    self.module_surfaces.surfaces[resolved_index].canonical_path
                val module_index = hdw_destination_module_lookup_source(
                    self.destination_slot, self.destination_generation,
                    canonical_path)
                if module_index >= 0: return module_index
                self.error("E-HIR-DEST-NAMED-MODULE: canonical module `" +
                    canonical_path + "` has no destination authority", span)
                return -1
            if self.current_destination_module_index >= 0:
                return self.current_destination_module_index
        self.error("E-HIR-DEST-NAMED-MODULE: named symbol has no proven module authority", span)
        -1

    # Return the ready destination type row for a direct local identifier.
    # The module-qualified lookup prevents equal per-module symbol ids from
    # aliasing. Non-identifiers and untyped/unpublished symbols return -1.
    me destination_direct_symbol_type(e: Expr) -> i64:
        match e.kind:
            case ExprKind.Ident(name):
                if val symbol = self.symbols.lookup(name):
                    val symbol_row = hdw_destination_symbol_lookup_in_module(
                        self.destination_slot, self.destination_generation,
                        self.current_destination_module_index, symbol.id)
                    if (symbol_row >= 0 and hdw_destination_symbol_has_type(
                            self.destination_slot, self.destination_generation,
                            symbol_row)):
                        return hdw_destination_symbol_type(
                            self.destination_slot, self.destination_generation,
                            symbol_row)
            case _: ()
        -1

    # Publish a freshly defined lexical symbol into the module-qualified
    # destination authority. Visibility/kind use the frozen wire ordinals
    # (Visibility.Private=5, SymbolKind.Variable=2, Parameter=3); the legacy
    # SymbolTable remains the source-side name-resolution owner.
    me destination_publish_local_symbol(symbol: i64, name: text,
                                        has_type: bool, type_index: i64,
                                        kind: SymbolKind, mutable_value: bool,
                                        span: Span) -> bool:
        val span_index = hdw_reserve_span(self.destination_slot,
            self.destination_generation, span.start, span.end, span.line,
            span.col, span.file, span.length)
        if span_index < 0: return false
        self.publish_current_destination_symbol(symbol, name, has_type,
            type_index, destination_visibility_wire(Visibility.Private), -1,
            destination_symbol_kind_wire(kind), mutable_value, false, "",
            self.symbols.current_scope.id, span_index, false) >= 0

    me destination_reserve_type(t: Type) -> i64:
        hdw_reserve_type(self.destination_slot, self.destination_generation,
            t.span.start, t.span.end, t.span.line, t.span.col, t.span.file, t.span.length)

    me destination_reserve_hir_type(t: HirType) -> i64:
        hdw_reserve_type(self.destination_slot, self.destination_generation,
            t.span.start, t.span.end, t.span.line, t.span.col, t.span.file, t.span.length)

    me destination_reserve_pattern(p: Pattern) -> i64:
        hdw_reserve_pattern(self.destination_slot, self.destination_generation,
            p.span.start, p.span.end, p.span.line, p.span.col, p.span.file, p.span.length)

    me destination_reserve_effect(e: Effect) -> i64:
        hdw_reserve_effect(self.destination_slot, self.destination_generation,
            e.span.start, e.span.end, e.span.line, e.span.col, e.span.file, e.span.length)

    me destination_reserve_dim(d: DimExpr) -> i64:
        hdw_reserve_dim(self.destination_slot, self.destination_generation,
            d.span.start, d.span.end, d.span.line, d.span.col, d.span.file, d.span.length)

    me destination_type_range(types: [Type]) -> i64:
        if types.len() == 0: return -1
        val range = hdw_reserve_range(self.destination_slot, self.destination_generation,
            HD_RANGE_TYPE, HD_AUX_RANGE_NONE, types.len())
        if range < 0: return -1
        var i = 0
        while i < types.len():
            val child = self.destination_lower_type(types[i])
            if child < 0 or not hdw_set_range_at(self.destination_slot, self.destination_generation,
                range, HD_AUX_RANGE_NONE, i, child): return -1
            i = i + 1
        if not hdw_publish_range(self.destination_slot, self.destination_generation,
            range, HD_RANGE_TYPE, HD_AUX_RANGE_NONE): return -1
        range

    me destination_hir_type_range(types: [HirType]) -> i64:
        if types.len() == 0: return -1
        val range = hdw_reserve_range(self.destination_slot, self.destination_generation,
            HD_RANGE_TYPE, HD_AUX_RANGE_NONE, types.len())
        if range < 0: return -1
        var i = 0
        while i < types.len():
            val child = self.destination_lower_hir_type(types[i])
            if child < 0 or not hdw_set_range_at(self.destination_slot, self.destination_generation,
                range, HD_AUX_RANGE_NONE, i, child): return -1
            i = i + 1
        if not hdw_publish_range(self.destination_slot, self.destination_generation,
            range, HD_RANGE_TYPE, HD_AUX_RANGE_NONE): return -1
        range

    me destination_dim_range(dims: [DimExpr]) -> i64:
        if dims.len() == 0: return -1
        val range = hdw_reserve_range(self.destination_slot, self.destination_generation,
            HD_RANGE_DIM, HD_AUX_RANGE_NONE, dims.len())
        if range < 0: return -1
        var i = 0
        while i < dims.len():
            val child = self.destination_lower_dim(dims[i])
            if child < 0 or not hdw_set_range_at(self.destination_slot, self.destination_generation,
                range, HD_AUX_RANGE_NONE, i, child): return -1
            i = i + 1
        if not hdw_publish_range(self.destination_slot, self.destination_generation,
            range, HD_RANGE_DIM, HD_AUX_RANGE_NONE): return -1
        range

    me destination_effect_range(effects: [Effect]) -> i64:
        if effects.len() == 0: return -1
        val range = hdw_reserve_range(self.destination_slot, self.destination_generation,
            HD_RANGE_EFFECT, HD_AUX_RANGE_NONE, effects.len())
        if range < 0: return -1
        var i = 0
        while i < effects.len():
            val child = self.destination_lower_effect(effects[i])
            if child < 0 or not hdw_set_range_at(self.destination_slot, self.destination_generation,
                range, HD_AUX_RANGE_NONE, i, child): return -1
            i = i + 1
        if not hdw_publish_range(self.destination_slot, self.destination_generation,
            range, HD_RANGE_EFFECT, HD_AUX_RANGE_NONE): return -1
        range

    # Resolve a parser Named type without constructing a HirType aggregate.
    me destination_write_named_type(row: i64, name: text, args: [Type], span: Span) -> bool:
        if name.starts_with("has_") and name.len() > 4:
            val child = hdw_reserve_type(self.destination_slot, self.destination_generation,
                span.start, span.end, span.line, span.col, span.file, span.length)
            if child < 0 or not self.destination_write_named_type(child, name[4:], [], span): return false
            return hdw_type_unary(self.destination_slot, self.destination_generation, row, HD_TYPE_OPTIONAL, child, false)
        match name:
            case "i8": return hdw_type_int(self.destination_slot, self.destination_generation, row, 8, true)
            case "i16": return hdw_type_int(self.destination_slot, self.destination_generation, row, 16, true)
            case "i32": return hdw_type_int(self.destination_slot, self.destination_generation, row, 32, true)
            case "i64": return hdw_type_int(self.destination_slot, self.destination_generation, row, 64, true)
            case "u8": return hdw_type_int(self.destination_slot, self.destination_generation, row, 8, false)
            case "u16": return hdw_type_int(self.destination_slot, self.destination_generation, row, 16, false)
            case "u32": return hdw_type_int(self.destination_slot, self.destination_generation, row, 32, false)
            case "u64": return hdw_type_int(self.destination_slot, self.destination_generation, row, 64, false)
            case "usize": return hdw_type_int(self.destination_slot, self.destination_generation, row, 64, false)
            case "isize" | "u128" | "i128": return hdw_type_int(self.destination_slot, self.destination_generation, row, 64, true)
            case "f32": return hdw_type_float(self.destination_slot, self.destination_generation, row, 32)
            case "f64" | "float": return hdw_type_float(self.destination_slot, self.destination_generation, row, 64)
            case "bool": return hdw_type_leaf(self.destination_slot, self.destination_generation, row, HD_TYPE_BOOL)
            case "char": return hdw_type_leaf(self.destination_slot, self.destination_generation, row, HD_TYPE_CHAR)
            case "text" | "str" | "String": return hdw_type_leaf(self.destination_slot, self.destination_generation, row, HD_TYPE_STR)
            case "unit" | "void": return hdw_type_leaf(self.destination_slot, self.destination_generation, row, HD_TYPE_UNIT)
            case "Any" | "any" | "fn": return hdw_type_leaf(self.destination_slot, self.destination_generation, row, HD_TYPE_ANY)
            case "tuple": return hdw_type_tuple(self.destination_slot, self.destination_generation, row, -1, 0)
            case "list":
                val any_row = hdw_reserve_type(self.destination_slot, self.destination_generation,
                    span.start, span.end, span.line, span.col, span.file, span.length)
                if any_row < 0 or not hdw_type_leaf(self.destination_slot, self.destination_generation, any_row, HD_TYPE_ANY): return false
                return hdw_type_array(self.destination_slot, self.destination_generation, row, any_row, false, -1)
            case "Option":
                if args.len() == 1:
                    # The single child is the sole published entry of arg_range.
                    # Scalar range readers are intentionally absent on the write seam,
                    # so lower the source child directly for this fixed payload.
                    val child = self.destination_lower_type(args[0])
                    if child < 0: return false
                    return hdw_type_unary(self.destination_slot, self.destination_generation, row, HD_TYPE_OPTIONAL, child, false)
                if args.len() == 0:
                    val any_row = hdw_reserve_type(self.destination_slot, self.destination_generation,
                        span.start, span.end, span.line, span.col, span.file, span.length)
                    if any_row < 0 or not hdw_type_leaf(self.destination_slot, self.destination_generation, any_row, HD_TYPE_ANY): return false
                    return hdw_type_unary(self.destination_slot, self.destination_generation, row, HD_TYPE_OPTIONAL, any_row, false)
                self.recovered("Option type expects 1 type argument", span)
                return hdw_type_leaf(self.destination_slot, self.destination_generation, row, HD_TYPE_ERROR)
            case "Result":
                if args.len() == 2:
                    val ok = self.destination_lower_type(args[0])
                    if ok < 0: return false
                    val err = self.destination_lower_type(args[1])
                    if err < 0: return false
                    return hdw_type_result(self.destination_slot, self.destination_generation, row, ok, err)
                if args.len() == 0:
                    val ok = hdw_reserve_type(self.destination_slot, self.destination_generation, span.start, span.end, span.line, span.col, span.file, span.length)
                    val err = hdw_reserve_type(self.destination_slot, self.destination_generation, span.start, span.end, span.line, span.col, span.file, span.length)
                    if ok < 0 or err < 0: return false
                    if not hdw_type_leaf(self.destination_slot, self.destination_generation, ok, HD_TYPE_ANY): return false
                    if not hdw_type_leaf(self.destination_slot, self.destination_generation, err, HD_TYPE_ANY): return false
                    return hdw_type_result(self.destination_slot, self.destination_generation, row, ok, err)
                self.recovered("Result type expects 2 type arguments", span)
                return hdw_type_leaf(self.destination_slot, self.destination_generation, row, HD_TYPE_ERROR)
            case "Dict":
                if args.len() == 2:
                    val key = self.destination_lower_type(args[0])
                    if key < 0: return false
                    val value = self.destination_lower_type(args[1])
                    if value < 0: return false
                    return hdw_type_dict(self.destination_slot, self.destination_generation, row, key, value)
                if args.len() == 0:
                    val key = hdw_reserve_type(self.destination_slot, self.destination_generation, span.start, span.end, span.line, span.col, span.file, span.length)
                    val value = hdw_reserve_type(self.destination_slot, self.destination_generation, span.start, span.end, span.line, span.col, span.file, span.length)
                    if key < 0 or value < 0: return false
                    if not hdw_type_leaf(self.destination_slot, self.destination_generation, key, HD_TYPE_ANY): return false
                    if not hdw_type_leaf(self.destination_slot, self.destination_generation, value, HD_TYPE_ANY): return false
                    return hdw_type_dict(self.destination_slot, self.destination_generation, row, key, value)
                self.error("Dict type expects 2 type arguments", span)
                return hdw_type_leaf(self.destination_slot, self.destination_generation, row, HD_TYPE_ERROR)
            case _:
                if name == "Self":
                    if val self_type = self.current_method_self_type:
                        return self.destination_write_hir_type_at(row, self_type)
                    self.recovered("unresolved type: Self", span)
                    return hdw_type_leaf(self.destination_slot, self.destination_generation, row, HD_TYPE_ANY)
                if not self.symbols.lookup(name).?:
                    val _registered = self.try_register_bootstrap_global_symbol(name, span)
                val symbol = self.symbols.lookup_or_invalid(name)
                if symbol.is_valid():
                    if custom_primitive_is_name(name): custom_primitive_bind_symbol(name, symbol.id)
                    val arg_range = self.destination_type_range(args)
                    if args.len() > 0 and arg_range < 0: return false
                    val defining_module =
                        self.destination_named_symbol_module(symbol.id, span)
                    if defining_module < 0: return false
                    return hdw_type_named(self.destination_slot,
                        self.destination_generation, row, defining_module,
                        symbol.id, arg_range, args.len())
                if name.len() == 1:
                    val code = name.char_code_at(0)
                    if code >= 65 and code <= 90:
                        return hdw_type_leaf(self.destination_slot, self.destination_generation, row, HD_TYPE_ANY)
                if name == "Map" or name == "HashMap":
                    if args.len() == 2:
                        val key = self.destination_lower_type(args[0])
                        if key < 0: return false
                        val value = self.destination_lower_type(args[1])
                        if value < 0: return false
                        return hdw_type_dict(self.destination_slot, self.destination_generation, row, key, value)
                    return hdw_type_leaf(self.destination_slot, self.destination_generation, row, HD_TYPE_ANY)
                if name == "dict" or name == "set":
                    return hdw_type_leaf(self.destination_slot, self.destination_generation, row, HD_TYPE_ANY)
                if name == "Int":
                    return hdw_type_int(self.destination_slot, self.destination_generation, row, 64, true)
                if name == "Bool":
                    return hdw_type_leaf(self.destination_slot, self.destination_generation, row, HD_TYPE_BOOL)
                if name == "Char":
                    return hdw_type_leaf(self.destination_slot, self.destination_generation, row, HD_TYPE_CHAR)
                self.error("unresolved type: {name}", span)
                hdw_type_leaf(self.destination_slot, self.destination_generation, row, HD_TYPE_ERROR)

    me destination_lower_type(t: Type) -> i64:
        val row = self.destination_reserve_type(t)
        if row < 0: return -1
        if not self.destination_write_type_at(row, t): return -1
        row

    me destination_write_type_at(row: i64, t: Type) -> bool:
        val kind: TypeKind = t.kind
        val disc = rt_enum_discriminant(kind)
        if disc == rt_enum_discriminant(TypeKind.Named("", [])):
            return self.destination_write_named_type(row, parser_type_kind_named_name(kind), parser_type_kind_named_args(kind), t.span)
        if disc == rt_enum_discriminant(TypeKind.Tuple([])):
            val elements = parser_type_kind_tuple_elements(kind)
            if elements.len() == 0: return hdw_type_leaf(self.destination_slot, self.destination_generation, row, HD_TYPE_UNIT)
            val range = self.destination_type_range(elements)
            if range < 0: return false
            return hdw_type_tuple(self.destination_slot, self.destination_generation, row, range, elements.len())
        if parser_type_kind_is_array(kind):
            val element = parser_type_kind_array_element(kind, t)
            val child = self.destination_lower_type(element)
            if child < 0: return false
            var has_size = false
            var array_size = -1
            match kind:
                case TypeKind.Array(_, size_expr):
                    if val source_size = size_expr:
                        match source_size.kind:
                            case ExprKind.IntLit(value):
                                if value < 0:
                                    self.error("array size must be a nonnegative constant integer",
                                        source_size.span)
                                    return false
                                has_size = true
                                array_size = value
                            case ExprKind.Unary(op, operand):
                                match op:
                                    case UnaryOp.Neg:
                                        match operand.kind:
                                            case ExprKind.IntLit(_):
                                                self.error("array size must be a nonnegative constant integer",
                                                    source_size.span)
                                                return false
                                            case _: ()
                                    case _: ()
                                self.error("array size must be a constant integer",
                                    source_size.span)
                                return false
                            case _:
                                self.error("array size must be a constant integer",
                                    source_size.span)
                                return false
                case _: ()
            return hdw_type_array(self.destination_slot,
                self.destination_generation, row, child, has_size, array_size)
        if parser_type_kind_is_function(kind):
            val params = parser_type_kind_function_params(kind)
            val range = self.destination_type_range(params)
            if params.len() > 0 and range < 0: return false
            val ret = parser_type_kind_function_return(kind, t)
            val ret_row = self.destination_lower_type(ret)
            if ret_row < 0: return false
            return hdw_type_function(self.destination_slot, self.destination_generation, row, range, params.len(), ret_row, -1, 0)
        val d_optional = rt_enum_discriminant(TypeKind.Optional(t))
        if disc == d_optional:
            var inner = t
            match kind:
                case TypeKind.Optional(value): inner = value
                case _: pass
            val child = self.destination_lower_type(inner)
            if child < 0: return false
            return hdw_type_unary(self.destination_slot, self.destination_generation, row, HD_TYPE_OPTIONAL, child, false)
        val d_reference = rt_enum_discriminant(TypeKind.Reference(t, false))
        if disc == d_reference:
            var inner = t
            var mutable = false
            match kind:
                case TypeKind.Reference(value, is_mutable):
                    inner = value
                    mutable = is_mutable
                case _: pass
            val child = self.destination_lower_type(inner)
            if child < 0: return false
            return hdw_type_unary(self.destination_slot, self.destination_generation, row, HD_TYPE_REF, child, mutable)
        val d_isolated = rt_enum_discriminant(TypeKind.Isolated(t))
        if disc == d_isolated:
            var inner = t
            match kind:
                case TypeKind.Isolated(value): inner = value
                case _: pass
            val child = self.destination_lower_type(inner)
            if child < 0: return false
            return hdw_type_unary(self.destination_slot, self.destination_generation, row, HD_TYPE_ISOLATED, child, false)
        if parser_type_kind_is_pointer(kind):
            val inner = parser_type_kind_pointer_inner(kind, t)
            val child = self.destination_lower_type(inner)
            if child < 0: return false
            return hdw_type_unary(self.destination_slot, self.destination_generation, row, HD_TYPE_PTR, child, parser_type_kind_pointer_is_mutable(kind))
        val d_union = rt_enum_discriminant(TypeKind.Union([]))
        if disc == d_union:
            val members = parser_type_kind_union_members(kind)
            if members.len() == 0: return hdw_type_leaf(self.destination_slot, self.destination_generation, row, HD_TYPE_UNIT)
            if members.len() == 1: return self.destination_write_type_at(row, members[0])
            val range = self.destination_type_range(members)
            if range < 0: return false
            return hdw_type_union(self.destination_slot, self.destination_generation, row, range, members.len())
        val d_projection = rt_enum_discriminant(TypeKind.Projection(t, ""))
        if disc == d_projection:
            var base = t
            var assoc_name = ""
            match kind:
                case TypeKind.Projection(value, name):
                    base = value
                    assoc_name = name
                case _: pass
            val child = self.destination_lower_type(base)
            if child < 0: return false
            return hdw_type_projection(self.destination_slot, self.destination_generation, row, child, assoc_name)
        val d_weak = rt_enum_discriminant(TypeKind.Weak(t))
        if disc == d_weak:
            var inner = t
            match kind:
                case TypeKind.Weak(value): inner = value
                case _: pass
            val child = self.destination_lower_type(inner)
            if child < 0: return false
            return hdw_type_unary(self.destination_slot, self.destination_generation, row, HD_TYPE_WEAK, child, false)
        val d_atomic = rt_enum_discriminant(TypeKind.Atomic(t))
        if disc == d_atomic:
            var inner = t
            match kind:
                case TypeKind.Atomic(value): inner = value
                case _: pass
            val child = self.destination_lower_type(inner)
            if child < 0: return false
            return hdw_type_atomic(self.destination_slot,
                self.destination_generation, row, child)
        if disc == rt_enum_discriminant(TypeKind.Infer):
            return hdw_type_infer(self.destination_slot,
                self.destination_generation, row, 0, 0)
        if disc == rt_enum_discriminant(TypeKind.Error):
            return hdw_type_leaf(self.destination_slot,
                self.destination_generation, row, HD_TYPE_ERROR)
        self.error("E-HIR-DEST-TYPE-KIND: unknown parser type kind cannot be lowered losslessly",
            t.span)
        false

    me destination_lower_hir_type(t: HirType) -> i64:
        val row = self.destination_reserve_hir_type(t)
        if row < 0: return -1
        if self.destination_write_hir_type_index_at(row, t) < 0: return -1
        row

    me destination_write_hir_type_at(row: i64, t: HirType) -> bool:
        self.destination_write_hir_type_index_at(row, t) >= 0

    me destination_write_hir_type_index_at(row: i64, t: HirType) -> i64:
        match t.kind:
            case HirTypeKind.Int(bits, signed): if not hdw_type_int(self.destination_slot, self.destination_generation, row, bits, signed): return -1
            case HirTypeKind.Float(bits): if not hdw_type_float(self.destination_slot, self.destination_generation, row, bits): return -1
            case HirTypeKind.Bool: if not hdw_type_leaf(self.destination_slot, self.destination_generation, row, HD_TYPE_BOOL): return -1
            case HirTypeKind.Char: if not hdw_type_leaf(self.destination_slot, self.destination_generation, row, HD_TYPE_CHAR): return -1
            case HirTypeKind.Str: if not hdw_type_leaf(self.destination_slot, self.destination_generation, row, HD_TYPE_STR): return -1
            case HirTypeKind.Unit: if not hdw_type_leaf(self.destination_slot, self.destination_generation, row, HD_TYPE_UNIT): return -1
            case HirTypeKind.Error: if not hdw_type_leaf(self.destination_slot, self.destination_generation, row, HD_TYPE_ERROR): return -1
            case HirTypeKind.Never: if not hdw_type_leaf(self.destination_slot, self.destination_generation, row, HD_TYPE_NEVER): return -1
            case HirTypeKind.Any: if not hdw_type_leaf(self.destination_slot, self.destination_generation, row, HD_TYPE_ANY): return -1
            case HirTypeKind.Tuple(elements):
                val range = self.destination_hir_type_range(elements)
                if elements.len() > 0 and range < 0: return -1
                if not hdw_type_tuple(self.destination_slot, self.destination_generation, row, range, elements.len()): return -1
            case HirTypeKind.Array(element, size):
                val child = self.destination_lower_hir_type(element)
                if child < 0: return -1
                if not hdw_type_array(self.destination_slot, self.destination_generation, row, child, size.?, size ?? -1): return -1
            case HirTypeKind.Slice(element):
                val child = self.destination_lower_hir_type(element)
                if child < 0: return -1
                if not hdw_type_unary(self.destination_slot, self.destination_generation, row, HD_TYPE_SLICE, child, false): return -1
            case HirTypeKind.Dict(key, value):
                val k = self.destination_lower_hir_type(key)
                if k < 0: return -1
                val v = self.destination_lower_hir_type(value)
                if v < 0: return -1
                if not hdw_type_dict(self.destination_slot, self.destination_generation, row, k, v): return -1
            case HirTypeKind.Ref(inner, mutable):
                val child = self.destination_lower_hir_type(inner)
                if child < 0: return -1
                if not hdw_type_unary(self.destination_slot, self.destination_generation, row, HD_TYPE_REF, child, mutable): return -1
            case HirTypeKind.Ptr(inner, mutable):
                val child = self.destination_lower_hir_type(inner)
                if child < 0: return -1
                if not hdw_type_unary(self.destination_slot, self.destination_generation, row, HD_TYPE_PTR, child, mutable): return -1
            case HirTypeKind.Optional(inner):
                val child = self.destination_lower_hir_type(inner)
                if child < 0: return -1
                if not hdw_type_unary(self.destination_slot, self.destination_generation, row, HD_TYPE_OPTIONAL, child, false): return -1
            case HirTypeKind.Result(ok, error_type):
                val o = self.destination_lower_hir_type(ok)
                if o < 0: return -1
                val e = self.destination_lower_hir_type(error_type)
                if e < 0: return -1
                if not hdw_type_result(self.destination_slot, self.destination_generation, row, o, e): return -1
            case HirTypeKind.Named(symbol, args):
                val range = self.destination_hir_type_range(args)
                if args.len() > 0 and range < 0: return -1
                val defining_module =
                    self.destination_named_symbol_module(symbol.id, t.span)
                if defining_module < 0: return -1
                if not hdw_type_named(self.destination_slot,
                        self.destination_generation, row, defining_module,
                        symbol.id, range, args.len()): return -1
            case HirTypeKind.TypeParam(name, bounds):
                val range = self.destination_hir_type_range(bounds)
                if bounds.len() > 0 and range < 0: return -1
                if not hdw_type_param(self.destination_slot, self.destination_generation, row, name, range, bounds.len()): return -1
            case HirTypeKind.Union(members):
                val range = self.destination_hir_type_range(members)
                if members.len() > 0 and range < 0: return -1
                if not hdw_type_union(self.destination_slot, self.destination_generation, row, range, members.len()): return -1
            case HirTypeKind.DynTrait(symbol): if not hdw_type_dyn_trait(self.destination_slot, self.destination_generation, row, symbol.id): return -1
            case HirTypeKind.QualifiedDynTrait(defining_module, trait_):
                if not hdw_type_qualified_dyn_trait(self.destination_slot,
                        self.destination_generation, row, defining_module,
                        trait_.id): return -1
            case HirTypeKind.Function(params, ret, effects):
                val params_range = self.destination_hir_type_range(params)
                if params.len() > 0 and params_range < 0: return -1
                val ret_row = self.destination_lower_hir_type(ret)
                if ret_row < 0: return -1
                val effects_range = self.destination_effect_range(effects)
                if effects.len() > 0 and effects_range < 0: return -1
                if not hdw_type_function(self.destination_slot, self.destination_generation, row, params_range, params.len(), ret_row, effects_range, effects.len()): return -1
            case HirTypeKind.Projection(base, assoc_name):
                val child = self.destination_lower_hir_type(base)
                if child < 0: return -1
                if not hdw_type_projection(self.destination_slot, self.destination_generation, row, child, assoc_name): return -1
            case HirTypeKind.Isolated(inner):
                val child = self.destination_lower_hir_type(inner)
                if child < 0: return -1
                if not hdw_type_unary(self.destination_slot, self.destination_generation, row, HD_TYPE_ISOLATED, child, false): return -1
            case HirTypeKind.Infer(id, level): if not hdw_type_infer(self.destination_slot, self.destination_generation, row, id, level): return -1
            case HirTypeKind.Tensor(element, dims, device):
                val child = self.destination_lower_hir_type(element)
                if child < 0: return -1
                val dims_range = self.destination_dim_range(dims)
                if dims.len() > 0 and dims_range < 0: return -1
                var has_device = false
                var device_shape = -1
                var device_id = -1
                if val dev = device:
                    has_device = true
                    match dev:
                        case DeviceType.CPU: device_shape = 0
                        case DeviceType.CUDA(id):
                            device_shape = 1
                            device_id = id
                        case DeviceType.Vulkan(id):
                            device_shape = 2
                            device_id = id
                if not hdw_type_tensor(self.destination_slot, self.destination_generation, row, child, dims_range, dims.len(), has_device, device_shape, device_id): return -1
            case HirTypeKind.Layer(input, output):
                val input_range = self.destination_dim_range(input)
                if input.len() > 0 and input_range < 0: return -1
                val output_range = self.destination_dim_range(output)
                if output.len() > 0 and output_range < 0: return -1
                if not hdw_type_layer(self.destination_slot, self.destination_generation, row, input_range, input.len(), output_range, output.len()): return -1
            case HirTypeKind.Weak(inner):
                val child = self.destination_lower_hir_type(inner)
                if child < 0: return -1
                if not hdw_type_unary(self.destination_slot, self.destination_generation, row, HD_TYPE_WEAK, child, false): return -1
            case HirTypeKind.Atomic(inner):
                val child = self.destination_lower_hir_type(inner)
                if child < 0: return -1
                if not hdw_type_atomic(self.destination_slot,
                        self.destination_generation, row, child): return -1
        row

    me destination_pattern_range(patterns: [Pattern], reuse_bindings: bool) -> i64:
        if patterns.len() == 0: return -1
        val range = hdw_reserve_range(self.destination_slot, self.destination_generation,
            HD_RANGE_PATTERN, HD_AUX_RANGE_NONE, patterns.len())
        if range < 0: return -1
        var i = 0
        while i < patterns.len():
            val child = self.destination_lower_pattern_mode(patterns[i], reuse_bindings)
            if child < 0 or not hdw_set_range_at(self.destination_slot, self.destination_generation,
                range, HD_AUX_RANGE_NONE, i, child): return -1
            i = i + 1
        if not hdw_publish_range(self.destination_slot, self.destination_generation,
            range, HD_RANGE_PATTERN, HD_AUX_RANGE_NONE): return -1
        range

    me destination_empty_range(kind: i64, subtype: i64) -> i64:
        val range = hdw_reserve_range(self.destination_slot, self.destination_generation, kind, subtype, 0)
        if range < 0: return -1
        if not hdw_publish_range(self.destination_slot, self.destination_generation, range, kind, subtype): return -1
        range

    me destination_named_pattern_range(fields: [(text, Pattern)], reuse_bindings: bool) -> i64:
        if fields.len() == 0: return -1
        val range = hdw_reserve_range(self.destination_slot, self.destination_generation,
            HD_RANGE_AUX, HD_AUX_RANGE_NAMED_PATTERN, fields.len())
        if range < 0: return -1
        var i = 0
        while i < fields.len():
            val (name, source) = fields[i]
            val aux = hdw_reserve_aux(self.destination_slot, self.destination_generation,
                source.span.start, source.span.end, source.span.line, source.span.col, source.span.file, source.span.length)
            if aux < 0: return -1
            val pattern = self.destination_lower_pattern_mode(source, reuse_bindings)
            if pattern < 0: return -1
            if not hdw_named_pattern(self.destination_slot, self.destination_generation, aux, name, pattern): return -1
            if not hdw_set_range_at(self.destination_slot, self.destination_generation,
                range, HD_AUX_RANGE_NAMED_PATTERN, i, aux): return -1
            i = i + 1
        if not hdw_publish_range(self.destination_slot, self.destination_generation,
            range, HD_RANGE_AUX, HD_AUX_RANGE_NAMED_PATTERN): return -1
        range

    me destination_positional_struct_pattern_range(field_names: [text], patterns: [Pattern], reuse_bindings: bool) -> i64:
        # Every positional source pattern must map to exactly one declared
        # field. Silently taking min(fields, patterns) loses bindings from an
        # over-wide pattern and changes match semantics.
        if field_names.len() != patterns.len(): return -1
        val count = patterns.len()
        if count == 0: return -1
        val range = hdw_reserve_range(self.destination_slot, self.destination_generation,
            HD_RANGE_AUX, HD_AUX_RANGE_NAMED_PATTERN, count)
        if range < 0: return -1
        var i = 0
        while i < count:
            val source = patterns[i]
            val aux = hdw_reserve_aux(self.destination_slot, self.destination_generation,
                source.span.start, source.span.end, source.span.line, source.span.col, source.span.file, source.span.length)
            if aux < 0: return -1
            val pattern = self.destination_lower_pattern_mode(source, reuse_bindings)
            if pattern < 0: return -1
            if not hdw_named_pattern(self.destination_slot, self.destination_generation, aux, field_names[i], pattern): return -1
            if not hdw_set_range_at(self.destination_slot, self.destination_generation,
                range, HD_AUX_RANGE_NAMED_PATTERN, i, aux): return -1
            i = i + 1
        if not hdw_publish_range(self.destination_slot, self.destination_generation,
            range, HD_RANGE_AUX, HD_AUX_RANGE_NAMED_PATTERN): return -1
        range

    me destination_pattern_named_type(name: text, span: Span) -> i64:
        val row = hdw_reserve_type(self.destination_slot, self.destination_generation,
            span.start, span.end, span.line, span.col, span.file, span.length)
        if row < 0: return -1
        val symbol = self.symbols.lookup_or_invalid(name)
        val ok = if symbol.is_valid():
            val defining_module =
                self.destination_named_symbol_module(symbol.id, span)
            defining_module >= 0 and hdw_type_named(self.destination_slot,
                self.destination_generation, row, defining_module,
                symbol.id, -1, 0)
        else:
            hdw_type_leaf(self.destination_slot, self.destination_generation, row, HD_TYPE_ERROR)
        if ok: row else: -1

    me destination_lower_pattern(p: Pattern) -> i64:
        self.destination_lower_pattern_mode(p, false)

    me destination_lower_pattern_mode(p: Pattern, reuse_bindings: bool) -> i64:
        val row = self.destination_reserve_pattern(p)
        if row < 0: return -1
        match p.kind:
            case PatternKind.Wildcard:
                if not hdw_pattern_wildcard(self.destination_slot, self.destination_generation, row, false, -1): return -1
            case PatternKind.Literal(value):
                val expr = self.destination_lower_expr(value)
                if expr < 0: return -1
                if not hdw_pattern_literal(self.destination_slot, self.destination_generation, row, expr, false, -1): return -1
            case PatternKind.Binding(name, mutable):
                var symbol = SymbolId(id: -1)
                if reuse_bindings:
                    val existing = self.symbols.scopes[self.symbols.current_scope.id].symbols.get(name)
                    if existing == nil:
                        self.error("E-HIR-DEST-OR-BINDING-SET: alternative introduces binding `" + name + "`", p.span)
                        return -1
                    symbol = SymbolId(id: existing ?? -1)
                    if val current = self.symbols.get_symbol_raw(symbol.id):
                        if current.is_mutable != mutable:
                            self.error("E-HIR-DEST-OR-BINDING-MUTABILITY: binding `" + name + "` changes mutability", p.span)
                            return -1
                else:
                    symbol = self.symbols.define(name, SymbolKind.Variable, nil, p.span, Visibility.Private, mutable, nil)
                    if not self.destination_publish_local_symbol(symbol.id,
                            name, false, -1, SymbolKind.Variable, mutable,
                            p.span): return -1
                if not hdw_pattern_binding(self.destination_slot, self.destination_generation, row, symbol.id, mutable, false, -1): return -1
            case PatternKind.Tuple(elements):
                val range = self.destination_pattern_range(elements, reuse_bindings)
                if elements.len() > 0 and range < 0: return -1
                if not hdw_pattern_sequence(self.destination_slot, self.destination_generation, row, HD_PATTERN_TUPLE, range, elements.len(), false, -1, false, -1): return -1
            case PatternKind.Array(elements, rest):
                val range = self.destination_pattern_range(elements, reuse_bindings)
                if elements.len() > 0 and range < 0: return -1
                var has_rest = false
                var rest_id = -1
                if val rest_name = rest:
                    if reuse_bindings:
                        val existing = self.symbols.scopes[self.symbols.current_scope.id].symbols.get(rest_name)
                        if existing == nil:
                            self.error("E-HIR-DEST-OR-BINDING-SET: alternative introduces rest binding `" + rest_name + "`", p.span)
                            return -1
                        has_rest = true
                        rest_id = existing ?? -1
                    else:
                        val rest_symbol = self.symbols.define(rest_name, SymbolKind.Variable, nil, p.span, Visibility.Private, false, nil)
                        if not self.destination_publish_local_symbol(
                                rest_symbol.id, rest_name, false, -1,
                                SymbolKind.Variable, false, p.span): return -1
                        has_rest = true
                        rest_id = rest_symbol.id
                if not hdw_pattern_sequence(self.destination_slot, self.destination_generation, row, HD_PATTERN_ARRAY, range, elements.len(), has_rest, rest_id, false, -1): return -1
            case PatternKind.Struct(type_name, fields):
                val type_row = self.destination_pattern_named_type(type_name, p.span)
                if type_row < 0: return -1
                val range = self.destination_named_pattern_range(fields, reuse_bindings)
                if fields.len() > 0 and range < 0: return -1
                if not hdw_pattern_struct(self.destination_slot, self.destination_generation, row, type_row, range, fields.len(), false, -1): return -1
            case PatternKind.Enum(enum_name, variant, payload):
                # Preserve the established positional-struct reinterpretation.
                if enum_name == "" and rt_dict_contains(self.struct_field_order_by_name, variant) and not rt_dict_contains(self.enum_variant_names, variant):
                    val type_row = self.destination_pattern_named_type(variant, p.span)
                    if type_row < 0: return -1
                    val field_names = self.struct_field_order_by_name[variant]
                    var published = false
                    if val source_payload = payload:
                        match source_payload:
                            case EnumPatternPayload.Tuple(values):
                                if field_names.len() != values.len():
                                    self.error("E-HIR-DEST-STRUCT-PATTERN-ARITY: positional struct pattern field count does not match declaration", p.span)
                                    return -1
                                val count = values.len()
                                val range = self.destination_positional_struct_pattern_range(field_names, values, reuse_bindings)
                                if count > 0 and range < 0: return -1
                                if not hdw_pattern_struct(self.destination_slot, self.destination_generation, row, type_row, range, count, false, -1): return -1
                                published = true
                            case EnumPatternPayload.Struct(_):
                                if not hdw_pattern_struct(self.destination_slot, self.destination_generation, row, type_row, -1, 0, false, -1): return -1
                                published = true
                    if not published:
                        if not hdw_pattern_struct(self.destination_slot, self.destination_generation, row, type_row, -1, 0, false, -1): return -1
                else:
                    val type_row = self.destination_pattern_named_type(enum_name, p.span)
                    if type_row < 0: return -1
                    var has_payload = false
                    var payload_row = -1
                    if val source_payload = payload:
                        val aux = hdw_reserve_aux(self.destination_slot, self.destination_generation,
                            p.span.start, p.span.end, p.span.line, p.span.col, p.span.file, p.span.length)
                        if aux < 0: return -1
                        match source_payload:
                            case EnumPatternPayload.Tuple(patterns):
                                val range = if patterns.len() == 0:
                                    self.destination_empty_range(HD_RANGE_PATTERN, HD_AUX_RANGE_NONE)
                                else:
                                    self.destination_pattern_range(patterns, reuse_bindings)
                                if range < 0: return -1
                                if not hdw_pattern_payload_aux(self.destination_slot, self.destination_generation, aux, false, range, patterns.len()): return -1
                            case EnumPatternPayload.Struct(fields):
                                val range = if fields.len() == 0:
                                    self.destination_empty_range(HD_RANGE_AUX, HD_AUX_RANGE_NAMED_PATTERN)
                                else:
                                    self.destination_named_pattern_range(fields, reuse_bindings)
                                if range < 0: return -1
                                if not hdw_pattern_payload_aux(self.destination_slot, self.destination_generation, aux, true, range, fields.len()): return -1
                        has_payload = true
                        payload_row = aux
                    if not hdw_pattern_enum(self.destination_slot, self.destination_generation, row, type_row, variant, has_payload, payload_row, false, -1): return -1
            case PatternKind.Or(patterns):
                var range = -1
                if patterns.len() > 0:
                    range = hdw_reserve_range(self.destination_slot,
                        self.destination_generation, HD_RANGE_PATTERN,
                        HD_AUX_RANGE_NONE, patterns.len())
                    if range < 0: return -1
                    var alternative = 0
                    while alternative < patterns.len():
                        # The first alternative establishes bindings unless
                        # an enclosing Or already did so. Every later arm must
                        # reuse that same lexical symbol set.
                        val child = self.destination_lower_pattern_mode(
                            patterns[alternative],
                            reuse_bindings or alternative > 0)
                        if child < 0 or not hdw_set_range_at(
                                self.destination_slot,
                                self.destination_generation, range,
                                HD_AUX_RANGE_NONE, alternative, child): return -1
                        alternative = alternative + 1
                    if not hdw_publish_range(self.destination_slot,
                            self.destination_generation, range,
                            HD_RANGE_PATTERN, HD_AUX_RANGE_NONE): return -1
                if not hdw_pattern_sequence(self.destination_slot, self.destination_generation, row, HD_PATTERN_OR, range, patterns.len(), false, -1, false, -1): return -1
            case PatternKind.Range(start, end, inclusive):
                var has_start = false
                var start_row = -1
                if val start_source = start:
                    start_row = self.destination_lower_expr(start_source)
                    if start_row < 0: return -1
                    has_start = true
                var has_end = false
                var end_row = -1
                if val end_source = end:
                    end_row = self.destination_lower_expr(end_source)
                    if end_row < 0: return -1
                    has_end = true
                if not hdw_pattern_optional_range(self.destination_slot, self.destination_generation,
                    row, has_start, start_row, has_end, end_row, inclusive, false, -1): return -1
            case PatternKind.Error:
                if not hdw_pattern_error(self.destination_slot, self.destination_generation, row): return -1
            case PatternKind.CompleteRegion(binder):
                self.error("E-COMPLETE-UNLOWERED: `case complete " + binder + "` is parsed but not yet lowered", p.span)
                if not hdw_pattern_region(self.destination_slot, self.destination_generation, row, false, binder): return -1
            case PatternKind.DynRegion(binder):
                self.error("E-COMPLETE-UNLOWERED: `case dyn " + binder + "` is parsed but not yet lowered", p.span)
                if not hdw_pattern_region(self.destination_slot, self.destination_generation, row, true, binder): return -1
            case PatternKind.TypeTest(type_name, binder):
                if not hdw_pattern_type_test(self.destination_slot, self.destination_generation, row, type_name, binder): return -1
            case PatternKind.Guard(_, _):
                self.error("E-HIR-DEST-RAW-PATTERN-GUARD: pattern guard reached destination lowering before match-arm desugaring", p.span)
                if not hdw_pattern_error(self.destination_slot, self.destination_generation, row): return -1
            case PatternKind.As(inner, alias):
                val child = self.destination_lower_pattern_mode(inner, reuse_bindings)
                if child < 0: return -1
                var symbol = SymbolId(id: -1)
                if reuse_bindings:
                    val existing = self.symbols.scopes[self.symbols.current_scope.id].symbols.get(alias)
                    if existing == nil:
                        self.error("E-HIR-DEST-OR-BINDING-SET: alternative introduces alias `" + alias + "`", p.span)
                        return -1
                    symbol = SymbolId(id: existing ?? -1)
                else:
                    symbol = self.symbols.define(alias, SymbolKind.Variable, nil, p.span, Visibility.Private, false, nil)
                    if not self.destination_publish_local_symbol(symbol.id,
                            alias, false, -1, SymbolKind.Variable, false,
                            p.span): return -1
                if not hdw_pattern_as(self.destination_slot, self.destination_generation, row, child, symbol.id, false, -1): return -1
        row

    me destination_lower_effect(e: Effect) -> i64:
        val row = self.destination_reserve_effect(e)
        if row < 0: return -1
        match e.kind:
            case EffectKind.Pure: if not hdw_effect_pure(self.destination_slot, self.destination_generation, row): return -1
            case EffectKind.IO: if not hdw_effect_io(self.destination_slot, self.destination_generation, row): return -1
            case EffectKind.Async: if not hdw_effect_async(self.destination_slot, self.destination_generation, row): return -1
            case EffectKind.Throws(type_):
                val type_row = self.destination_lower_hir_type(type_)
                if type_row < 0: return -1
                if not hdw_effect_throws(self.destination_slot, self.destination_generation, row, type_row): return -1
            case EffectKind.Mutates: if not hdw_effect_mutates(self.destination_slot, self.destination_generation, row): return -1
            case EffectKind.Allocates: if not hdw_effect_allocates(self.destination_slot, self.destination_generation, row): return -1
            case EffectKind.Custom(name): if not hdw_effect_custom(self.destination_slot, self.destination_generation, row, name): return -1
        row

    me destination_lower_dim(d: DimExpr) -> i64:
        val row = self.destination_reserve_dim(d)
        if row < 0: return -1
        match d.kind:
            case DimExprKind.Literal(value): if not hdw_dim_literal(self.destination_slot, self.destination_generation, row, value): return -1
            case DimExprKind.Named(name, lo, hi): if not hdw_dim_named(self.destination_slot, self.destination_generation, row, name, lo.?, lo ?? -1, hi.?, hi ?? -1): return -1
            case DimExprKind.Var(id): if not hdw_dim_var(self.destination_slot, self.destination_generation, row, id): return -1
            case DimExprKind.Dynamic: if not hdw_dim_dynamic(self.destination_slot, self.destination_generation, row): return -1
            case DimExprKind.Broadcast: if not hdw_dim_broadcast(self.destination_slot, self.destination_generation, row): return -1
            case DimExprKind.ConstParam(name): if not hdw_dim_const_param(self.destination_slot, self.destination_generation, row, name): return -1
            case DimExprKind.Add(left, right):
                val l = self.destination_lower_dim(left)
                if l < 0: return -1
                val r = self.destination_lower_dim(right)
                if r < 0: return -1
                if not hdw_dim_add(self.destination_slot, self.destination_generation, row, l, r): return -1
            case DimExprKind.Mul(left, right):
                val l = self.destination_lower_dim(left)
                if l < 0: return -1
                val r = self.destination_lower_dim(right)
                if r < 0: return -1
                if not hdw_dim_mul(self.destination_slot, self.destination_generation, row, l, r): return -1
            case DimExprKind.Div(left, right):
                val l = self.destination_lower_dim(left)
                if l < 0: return -1
                val r = self.destination_lower_dim(right)
                if r < 0: return -1
                if not hdw_dim_div(self.destination_slot, self.destination_generation, row, l, r): return -1
        row

export HirLowering
