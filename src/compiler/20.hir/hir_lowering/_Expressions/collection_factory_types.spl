# Conservative concrete-type admission for attributed collection initializers.
use compiler.hir.hir_types.{HirType, HirTypeKind}

fn collection_factory_type_concrete(type_: HirType) -> bool:
    """Unknown and unhandled type forms never authorize a mismatch diagnostic."""
    match type_.kind:
        case HirTypeKind.Int(_, _) | HirTypeKind.Float(_) | HirTypeKind.Str |
                HirTypeKind.Bool | HirTypeKind.Char | HirTypeKind.Unit: true
        case HirTypeKind.Optional(inner) | HirTypeKind.Slice(inner):
            collection_factory_type_concrete(inner)
        case HirTypeKind.Array(inner, _): collection_factory_type_concrete(inner)
        case HirTypeKind.Named(_, args) | HirTypeKind.Tuple(args):
            for arg in args:
                if not collection_factory_type_concrete(arg): return false
            true
        case _: false

export collection_factory_type_concrete
