# `x as T` takes the unit-construction path only when `T` RESOLVES to a unit.
#
# Bug: doc/08_tracking/bug/unit_decl_table_name_keyed_2026-11-16.md
#
# The unit declaration table (`unit_decl_find`) is a process-global list of
# bare names, so asking it with the cast target's spelling misread a class in
# another module that shares a unit's name as that unit. The decision now goes
# through name resolution: the target's resolved symbol must be the struct a
# unit lowers to (`unit Name: T` -> `struct Name { value: T }`), and that
# resolved symbol's name must be a declared unit. A class/enum/alias/trait of
# the same name never takes the unit path.

use compiler.hir.hir_types.*
use compiler.core.types.{unit_decl_find}

pub fn unit_cast_symbol_is_unit(kind: SymbolKind, resolved_name: text) -> bool:
    if kind != SymbolKind.Struct:
        return false
    unit_decl_find(resolved_name) >= 0
