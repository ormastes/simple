use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering._Expressions.expression_support.{_hir_expr_symbol_or_invalid}

impl HirLowering:
    fn declared_enum_constructor_owner(receiver: HirExpr, resolution: MethodResolution) -> i64:
        # Capture the scalar declaration owner before lowering argument
        # expressions can advance native/interpreter enum payload storage.
        match resolution:
            case MethodResolution.Unresolved: ()
            case _: return -1
        val owner = _hir_expr_symbol_or_invalid(receiver.kind)
        if not owner.is_valid(): return -1
        # Declaration-only imports can have a symbol without a materialized
        # ParserEnum. Unknown genericity must not erase receiver type args.
        if not self.generic_enum_constructor_owners.contains_key(owner.id): return -1
        if self.generic_enum_constructor_owners.get(owner.id) ?? false:
            return -1
        if val declaration = self.symbols.get_symbol_raw(owner.id):
            match declaration.kind:
                case SymbolKind.Enum: return owner.id
                case _: ()
        -1

    fn declared_enum_constructor_expr(owner: i64, variant: text, args: [HirCallArg], span: Span) -> HirExpr?:
        if owner < 0: return nil
        # Keep the captured declaring owner for complete declaration-order
        # named payloads. A variant leaf can belong to several enum owners;
        # deferring a valid named call would discard this exact receiver.
        var has_named = false
        for raw_arg in args:
            # ANY-transport hazard sweep round 3: annotated rebind.
            val arg: HirCallArg = raw_arg
            if arg.has_name: has_named = true
        if has_named:
            if val slots = self.declared_pattern_enum_slots.get("{owner}:{variant}"):
                if not slots.is_struct or slots.field_names.len() != slots.field_types.len() or args.len() != slots.field_names.len():
                    return nil
                var index = 0
                for raw_arg in args:
                    val arg: HirCallArg = raw_arg
                    if arg.has_name and arg.name != slots.field_names[index]:
                        return nil
                    index = index + 1
            else:
                # Unknown, reordered or default bindings retain the guarded
                # original route; never silently discard an unvalidated name.
                return nil
        var values: [HirExpr] = []
        for raw_arg in args:
            val arg: HirCallArg = raw_arg
            values.push(arg.value)
        val declared = HirType(kind: HirTypeKind.Named(SymbolId(id: owner), []), span: span)
        Some(HirExpr(kind: HirExprKind.EnumLit(declared, variant,
            Some(HirEnumPayload.Tuple(values))), has_type_: true, type_: declared, span: span))

    fn declared_enum_unit_value_expr(owner: i64, variant: text, span: Span) -> HirExpr?:
        # `E.UnitVariant` is a value expression only when the receiver is an
        # enum declaration and its exact owner/variant pair was registered as
        # a zero-payload variant. In particular, do not infer enum-ness from a
        # matching leaf name, and do not instantiate a generic enum without
        # its type arguments.
        if owner < 0: return nil
        if not self.enum_unit_pattern_names.contains_key("{owner}:{variant}"): return nil
        if not self.generic_enum_constructor_owners.contains_key(owner): return nil
        if self.generic_enum_constructor_owners[owner]: return nil
        if val declaration = self.symbols.get_symbol_raw(owner):
            match declaration.kind:
                case SymbolKind.Enum: ()
                case _: return nil
        else:
            return nil
        val declared = HirType(kind: HirTypeKind.Named(SymbolId(id: owner), []), span: span)
        Some(HirExpr(kind: HirExprKind.EnumLit(declared, variant, nil),
            has_type_: true, type_: declared, span: span))
