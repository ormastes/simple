# Tuple declaration, assignment, and `for` destructuring for destination HIR.
#
# The parser deliberately retains tuple binders as joined text (`(a,b)`).
# These helpers decode that source representation directly into the process-
# owned destination graph. Only scalar slot/generation/index values cross the
# writer boundary; no materialized HIR aggregate is constructed or copied.
use compiler.common.dependency.visibility.{Visibility}
use compiler.common.diagnostics.span.{Span}
use compiler.frontend.parser_types.*
use compiler.frontend.parser_types_expr.*
use compiler.hir.hir_types.{SymbolKind, ScopeKind}
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.hir_destination_graph.*
use compiler.hir.hir_lowering.hir_destination_registry_writer.*
use compiler.hir.hir_lowering._Expressions.destination_types_patterns.*

impl HirLowering:
    # Rooted tuple accessors.  The payload array never leaves this isolated
    # extraction frame and is never retained in the recursive lowering frame.
    fn destination_tuple_literal_count(expr: Expr) -> i64:
        match expr.kind:
            case ExprKind.TupleLit(elements): return elements.len()
            case _: return -1

    fn destination_tuple_target_count(expr: Expr) -> i64:
        match expr.kind:
            case ExprKind.TupleLit(elements): return elements.len()
            case _: return -1

    fn destination_tuple_target_at(expr: Expr, index: i64) -> Expr:
        match expr.kind:
            case ExprKind.TupleLit(elements): return elements[index]
            case _: return nil

    fn destination_tuple_name_count(joined_name: text) -> i64:
        if joined_name.len() <= 2: return 0
        var count = 1
        var cursor = 1
        while cursor < joined_name.len() - 1:
            if joined_name[cursor:cursor + 1] == ",": count = count + 1
            cursor = cursor + 1
        count

    fn destination_tuple_name_at(joined_name: text, wanted: i64) -> text:
        var current = 0
        var start = 1
        var cursor = 1
        while cursor < joined_name.len() - 1:
            if joined_name[cursor:cursor + 1] == ",":
                if current == wanted: return joined_name[start:cursor]
                current = current + 1
                start = cursor + 1
            cursor = cursor + 1
        if current == wanted: joined_name[start:joined_name.len() - 1] else: ""

    fn destination_tuple_hole(expr: Expr) -> bool:
        match expr.kind:
            case ExprKind.Ident(name): name == "_"
            case _: false

    fn destination_tuple_index_expr(symbol_id: i64, index: i64, span: Span) -> i64:
        val base_row = self.destination_reserve_expr(span)
        if base_row < 0: return -1
        if not hdw_var(self.destination_slot, self.destination_generation,
            base_row, symbol_id): return -1
        val index_row = self.destination_reserve_expr(span)
        if index_row < 0: return -1
        if not hdw_int(self.destination_slot, self.destination_generation,
            index_row, index, false, ""): return -1
        val result_row = self.destination_reserve_expr(span)
        if result_row < 0: return -1
        if not hdw_index(self.destination_slot, self.destination_generation,
            result_row, base_row, index_row): return -1
        result_row

    fn destination_tuple_empty_cap_range() -> i64:
        val cap_range = hdw_reserve_range(self.destination_slot,
            self.destination_generation, HD_RANGE_AUX, HD_AUX_RANGE_TEXT, 0)
        if cap_range < 0: return -1
        if not hdw_publish_range(self.destination_slot, self.destination_generation,
            cap_range, HD_RANGE_AUX, HD_AUX_RANGE_TEXT): return -1
        cap_range

    fn destination_tuple_finish_stmt_block(stmt_row: i64, block_row: i64,
                                            stmt_range: i64, stmt_count: i64) -> i64:
        if not hdw_publish_range(self.destination_slot, self.destination_generation,
            stmt_range, HD_RANGE_STMT, HD_AUX_RANGE_NONE): return -1
        val cap_range = self.destination_tuple_empty_cap_range()
        if cap_range < 0: return -1
        if not hdw_finalize_block(self.destination_slot, self.destination_generation,
            block_row, stmt_range, stmt_count, false, -1, cap_range, 0): return -1
        if not hdw_stmt_block(self.destination_slot, self.destination_generation,
            stmt_row, block_row): return -1
        stmt_row

    # Lower `val/var (a,b) = rhs`. The rooted RHS is evaluated exactly once
    # into a hidden binding, then each visible binding reads one indexed
    # element. This also preserves side effects in literal elements discarded
    # by `_`; retaining a local `[Expr]` payload and lowering only visible
    # elements silently skipped those effects.
    me destination_lower_tuple_binding_stmt(stmt_row: i64, joined_name: text,
                                             init: Expr, is_mut: bool,
                                             span: Span) -> i64:
        val name_count = self.destination_tuple_name_count(joined_name)
        val literal_count = self.destination_tuple_literal_count(init)
        val literal = literal_count >= 0
        if literal and literal_count != name_count:
            val binding_kind = if is_mut: "var" else: "val"
            self.error("tuple destructure arity mismatch for `" + binding_kind + " " +
                joined_name + "`: " + name_count.to_text() +
                " name(s) on the left vs " + literal_count.to_text() +
                " value(s) on the right", span)
            return -1

        var visible_count = 0
        var count_i = 0
        while count_i < name_count:
            val name = self.destination_tuple_name_at(joined_name, count_i)
            if name != "_": visible_count = visible_count + 1
            count_i = count_i + 1
        val stmt_count = visible_count + 1
        val block_row = self.destination_reserve_block_row(span)
        if block_row < 0: return -1
        val stmt_range = hdw_reserve_range(self.destination_slot,
            self.destination_generation, HD_RANGE_STMT, HD_AUX_RANGE_NONE, stmt_count)
        if stmt_range < 0: return -1

        val init_row = self.destination_lower_expr(init)
        if init_row < 0: return -1
        val temp_symbol = self.symbols.define("__tuple_destr", SymbolKind.Variable,
            nil, span, Visibility.Private, false, nil)
        val temp_symbol_id = temp_symbol.id
        val temp_type = self.destination_infer_type(span)
        if temp_type < 0: return -1
        if not self.destination_publish_local_symbol(temp_symbol_id,
                "__tuple_destr", true, temp_type, SymbolKind.Variable, false,
                span): return -1
        val temp_stmt = self.destination_reserve_stmt(span)
        if temp_stmt < 0: return -1
        if not hdw_stmt_let(self.destination_slot, self.destination_generation,
            temp_stmt, temp_symbol_id, temp_type, init_row): return -1
        if not hdw_set_range_at(self.destination_slot, self.destination_generation,
            stmt_range, HD_AUX_RANGE_NONE, 0, temp_stmt): return -1
        var range_offset = 1

        var i = 0
        while i < name_count:
            val name = self.destination_tuple_name_at(joined_name, i)
            if name != "_":
                val value_row = self.destination_tuple_index_expr(temp_symbol_id, i, span)
                if value_row < 0: return -1
                val symbol = self.symbols.define(name, SymbolKind.Variable, nil,
                    span, Visibility.Private, is_mut, nil)
                val type_row = self.destination_infer_type(span)
                if type_row < 0: return -1
                if not self.destination_publish_local_symbol(symbol.id, name,
                        true, type_row, SymbolKind.Variable, is_mut,
                        span): return -1
                val child_stmt = self.destination_reserve_stmt(span)
                if child_stmt < 0: return -1
                if not hdw_stmt_let(self.destination_slot, self.destination_generation,
                    child_stmt, symbol.id, type_row, value_row): return -1
                if not hdw_set_range_at(self.destination_slot, self.destination_generation,
                    stmt_range, HD_AUX_RANGE_NONE, range_offset, child_stmt): return -1
                range_offset = range_offset + 1
            i = i + 1
        self.destination_tuple_finish_stmt_block(stmt_row, block_row, stmt_range, stmt_count)

    # Lower `(a,b) = rhs`: evaluate rhs exactly once, then assign each
    # non-hole target from the corresponding tuple element.
    me destination_lower_tuple_assign_stmt(stmt_row: i64, target_tuple: Expr,
                                            value: Expr, span: Span) -> i64:
        val target_count = self.destination_tuple_target_count(target_tuple)
        if target_count < 0: return -1
        var visible_count = 0
        var count_i = 0
        while count_i < target_count:
            if not self.destination_tuple_hole(
                self.destination_tuple_target_at(target_tuple, count_i)):
                visible_count = visible_count + 1
            count_i = count_i + 1
        val stmt_count = visible_count + 1
        val block_row = self.destination_reserve_block_row(span)
        if block_row < 0: return -1
        val stmt_range = hdw_reserve_range(self.destination_slot,
            self.destination_generation, HD_RANGE_STMT, HD_AUX_RANGE_NONE, stmt_count)
        if stmt_range < 0: return -1
        val value_row = self.destination_lower_expr(value)
        if value_row < 0: return -1
        val temp_symbol = self.symbols.define("__tuple_assign", SymbolKind.Variable,
            nil, span, Visibility.Private, false, nil)
        val temp_type = self.destination_infer_type(span)
        if temp_type < 0: return -1
        if not self.destination_publish_local_symbol(temp_symbol.id,
                "__tuple_assign", true, temp_type, SymbolKind.Variable,
                false, span): return -1
        val temp_stmt = self.destination_reserve_stmt(span)
        if temp_stmt < 0: return -1
        if not hdw_stmt_let(self.destination_slot, self.destination_generation,
            temp_stmt, temp_symbol.id, temp_type, value_row): return -1
        if not hdw_set_range_at(self.destination_slot, self.destination_generation,
            stmt_range, HD_AUX_RANGE_NONE, 0, temp_stmt): return -1
        var range_offset = 1
        var i = 0
        while i < target_count:
            val target = self.destination_tuple_target_at(target_tuple, i)
            if not self.destination_tuple_hole(target):
                val target_row = self.destination_lower_expr(target)
                if target_row < 0: return -1
                val element_row = self.destination_tuple_index_expr(temp_symbol.id, i, span)
                if element_row < 0: return -1
                val assign_stmt = self.destination_reserve_stmt(span)
                if assign_stmt < 0: return -1
                if not hdw_stmt_assign(self.destination_slot, self.destination_generation,
                    assign_stmt, target_row, 0, element_row): return -1
                if not hdw_set_range_at(self.destination_slot, self.destination_generation,
                    stmt_range, HD_AUX_RANGE_NONE, range_offset, assign_stmt): return -1
                range_offset = range_offset + 1
            i = i + 1
        self.destination_tuple_finish_stmt_block(stmt_row, block_row, stmt_range, stmt_count)

    # Lower `for (a,b) in iter`. The raw iteration element stays in one hidden
    # loop symbol; visible bindings are prepended to the body without building
    # or concatenating materialized HIR statement arrays.
    me destination_lower_for_tuple_expr(expr_row: i64, joined_name: text,
                                         iter_row: i64, body: Block,
                                         span: Span) -> i64:
        val name_count = self.destination_tuple_name_count(joined_name)
        var prefix_count = 0
        var count_i = 0
        while count_i < name_count:
            val name = self.destination_tuple_name_at(joined_name, count_i)
            if name != "_": prefix_count = prefix_count + 1
            count_i = count_i + 1
        val source_count = body.stmts.len()
        var has_value = false
        if source_count > 0:
            match body.stmts[source_count - 1].kind:
                case StmtKind.Expr(expr):
                    has_value = self.destination_expr_is_block_value(expr)
                case _: ()
        val source_stmt_count = if has_value: source_count - 1 else: source_count
        val stmt_count = prefix_count + source_stmt_count
        val block_row = self.destination_reserve_block_row(body.span)
        if block_row < 0: return -1
        val stmt_range = hdw_reserve_range(self.destination_slot,
            self.destination_generation, HD_RANGE_STMT, HD_AUX_RANGE_NONE, stmt_count)
        if stmt_range < 0: return -1
        val cap_range = self.destination_tuple_empty_cap_range()
        if cap_range < 0: return -1

        self.symbols.push_scope(ScopeKind.Loop)
        self.loop_depth = self.loop_depth + 1
        val element_symbol = self.symbols.define("__for_tuple_elem", SymbolKind.Variable,
            nil, span, Visibility.Private, false, nil)
        val element_type = self.destination_infer_type(span)
        if element_type < 0 or not self.destination_publish_local_symbol(
                element_symbol.id, "__for_tuple_elem", true, element_type,
                SymbolKind.Variable, false, span): self.loop_depth = self.loop_depth - 1; self.symbols.pop_scope(); return -1
        var range_offset = 0
        var i = 0
        while i < name_count:
            val name = self.destination_tuple_name_at(joined_name, i)
            if name != "_":
                val element_row = self.destination_tuple_index_expr(element_symbol.id, i, span)
                if element_row < 0: self.loop_depth = self.loop_depth - 1; self.symbols.pop_scope(); return -1
                val symbol = self.symbols.define(name, SymbolKind.Variable, nil,
                    span, Visibility.Private, false, nil)
                val type_row = self.destination_infer_type(span)
                if type_row < 0: self.loop_depth = self.loop_depth - 1; self.symbols.pop_scope(); return -1
                if not self.destination_publish_local_symbol(symbol.id, name,
                        true, type_row, SymbolKind.Variable, false,
                        span): self.loop_depth = self.loop_depth - 1; self.symbols.pop_scope(); return -1
                val let_stmt = self.destination_reserve_stmt(span)
                if let_stmt < 0: self.loop_depth = self.loop_depth - 1; self.symbols.pop_scope(); return -1
                if not hdw_stmt_let(self.destination_slot, self.destination_generation,
                    let_stmt, symbol.id, type_row, element_row): self.loop_depth = self.loop_depth - 1; self.symbols.pop_scope(); return -1
                if not hdw_set_range_at(self.destination_slot, self.destination_generation,
                    stmt_range, HD_AUX_RANGE_NONE, range_offset, let_stmt): self.loop_depth = self.loop_depth - 1; self.symbols.pop_scope(); return -1
                range_offset = range_offset + 1
            i = i + 1
        var si = 0
        while si < source_stmt_count:
            val source_stmt = self.destination_strip_discarded_string_interps(body.stmts[si])
            val child_stmt = self.destination_lower_stmt(source_stmt)
            if child_stmt < 0: self.loop_depth = self.loop_depth - 1; self.symbols.pop_scope(); return -1
            if not hdw_set_range_at(self.destination_slot, self.destination_generation,
                stmt_range, HD_AUX_RANGE_NONE, range_offset, child_stmt): self.loop_depth = self.loop_depth - 1; self.symbols.pop_scope(); return -1
            range_offset = range_offset + 1
            si = si + 1
        if not hdw_publish_range(self.destination_slot, self.destination_generation,
            stmt_range, HD_RANGE_STMT, HD_AUX_RANGE_NONE): self.loop_depth = self.loop_depth - 1; self.symbols.pop_scope(); return -1
        var value_row = -1
        if has_value:
            match body.stmts[source_count - 1].kind:
                case StmtKind.Expr(expr): value_row = self.destination_lower_expr(expr)
                case _: ()
            if value_row < 0: self.loop_depth = self.loop_depth - 1; self.symbols.pop_scope(); return -1
        if not hdw_finalize_block(self.destination_slot, self.destination_generation,
            block_row, stmt_range, stmt_count, has_value, value_row, cap_range, 0): self.loop_depth = self.loop_depth - 1; self.symbols.pop_scope(); return -1
        if not hdw_for(self.destination_slot, self.destination_generation,
            expr_row, element_symbol.id, iter_row, block_row, false, ""): self.loop_depth = self.loop_depth - 1; self.symbols.pop_scope(); return -1
        self.loop_depth = self.loop_depth - 1
        self.symbols.pop_scope()
        expr_row

export HirLowering
