# HIR lowering - Core expression dispatch.
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.frontend.parser_types.*
use compiler.common.dependency.visibility.{Visibility}
use compiler.frontend.parser_types_expr.*
use compiler.common.diagnostics.span.{Span}
use compiler.common.assurance.unsafe_capabilities.{unknown_unsafe_capability_names, valid_unsafe_capability_names_help}
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering._Expressions.expression_support.{hir_expr_kind_disc, is_tuple_positional_field, parse_tuple_field_index, primitive_cast_type_kind, _hir_expr_symbol_or_invalid}
use compiler.hir.hir_lowering._Expressions.type_test_operand.{binary_is_type_operand}

impl HirLowering:
    me lower_hir_expr(e: Expr) -> HirExpr:
        if e == nil:
            val missing_span = Span.empty()
            self.error("missing AST expression during HIR lowering", missing_span)
            return HirExpr(
                kind: HirExprKind.Error,
                has_type_: false,
                type_: HirType(kind: HirTypeKind.Unit, span: missing_span),
                span: missing_span
            )
        # Probes UNGATED: Trap D (iteration 17) — env-gated probes are mute in
        # hir_lowering modules. Remove before deploy.
        # DIRECT typed field read, NOT `match e: case Expr(k, _): k`: the struct
        # pattern "matches" on stage4 but destructures a GARBAGE payload (observed
        # kind_disc=823890719) — and the direct read shows the same garbage, so
        # `e` itself is corrupted upstream (bug doc iteration 17).
        val expr_kind_value: ExprKind = e.kind
        val expr_kind_discriminant: i64 = hir_expr_kind_disc(expr_kind_value)
        val host_gpu_lane = self.try_lower_host_gpu_lane_expr(e)
        if val lowered_host_gpu_lane = host_gpu_lane:
            return lowered_host_gpu_lane
        match expr_kind_value:
            case ExprKind.Call(callee, args):
                val call_callee_t: Expr = callee
                val call_args_t: [CallArg] = args
                # `i32(x)` / `f64(x)`: fixed-width primitive type name used as
                # a callee is a numeric CAST (see primitive_cast_type_kind).
                # Lower it as HirExprKind.Cast -- the callee name would
                # otherwise fail symbol lookup and become HirExprKind.Error.
                match call_callee_t.kind:
                    case ExprKind.Ident(callee_ident):
                        val callee_ident_t: text = callee_ident
                        if self.constructor_access_for_name(callee_ident_t) == 0:
                            self.error("aggregate constructor `{callee_ident_t}` is not visible from this module", e.span)
                            return HirExpr(
                                kind: HirExprKind.Error,
                                has_type_: false,
                                type_: HirType(kind: HirTypeKind.Unit, span: e.span),
                                span: e.span)
                        if call_args_t.len() == 1 and not call_args_t[0].has_name:
                            val prim_kind = primitive_cast_type_kind(callee_ident_t)
                            if prim_kind.?:
                                val cast_arg_t: CallArg = call_args_t[0]
                                val cast_target = HirType(kind: prim_kind.unwrap(), span: e.span)
                                return HirExpr(
                                    kind: HirExprKind.Cast(self.lower_hir_expr(cast_arg_t.value), cast_target),
                                    has_type_: true,
                                    type_: cast_target,
                                    span: e.span
                                )
                    case ExprKind.Field(constructor_base, constructor_name):
                        var constructor_access = self.constructor_access_for_name(constructor_name)
                        match constructor_base.kind:
                            case ExprKind.Ident(constructor_qualifier):
                                constructor_access = self.qualified_constructor_access(
                                    constructor_qualifier, constructor_name)
                            case _: ()
                        if constructor_access == 0:
                            self.error("aggregate constructor `{constructor_name}` is not visible from this module", e.span)
                            return HirExpr(
                                kind: HirExprKind.Error,
                                has_type_: false,
                                type_: HirType(kind: HirTypeKind.Unit, span: e.span),
                                span: e.span)
                    case _:
                        pass
                var hir_args: [HirCallArg] = []
                for arg in call_args_t:
                    val arg_t: CallArg = arg
                    hir_args = hir_args.push(HirCallArg(
                        has_name: arg_t.has_name,
                        name: arg_t.name,
                        value: self.lower_hir_expr(arg_t.value),
                        span: arg_t.span
                    ))
                return HirExpr(kind: HirExprKind.Call(self.lower_hir_expr(call_callee_t), hir_args, []), type_: nil, span: e.span)
            case _:
                pass
        # SEED PATTERN HAZARD (bug doc iteration 18): when a variant pattern's
        # name is ALSO a struct name in scope (`struct Field` in
        # parser_types.spl, `struct Block` in parser_types_expr.spl), the seed
        # compiles the `case ExprKind.Field(...)` TEST as a struct pattern =
        # ALWAYS TRUE (compiler_rust codegen/instr/pattern.rs struct/tuple
        # fallback is `iconst 1`), while payload bindings still extract enum
        # payloads. Such an arm swallows every value that reaches it in the big
        # match below (proven: a Call landed in the Field arm, [LHE-ARMX]
        # Field). Pre-dispatch these variants by explicit discriminant
        # (rt_enum_discriminant = DefaultHasher(variant name) truncated to u32)
        # and keep them OUT of the big match.
        val kind_disc_v: i64 = expr_kind_discriminant
        val kind_disc_dummy = Expr(kind: ExprKind.NilLit, span: e.span)
        if kind_disc_v == hir_expr_kind_disc(ExprKind.MethodCall(kind_disc_dummy, "", [])):
            match expr_kind_value:
                case ExprKind.MethodCall(receiver, method, args):
                    val method_receiver_t: Expr = receiver
                    val method_name_t: text = method
                    val method_args_t: [CallArg] = args
                    # Consume the receiver payload before recursively lowering
                    # arguments; nested lowering may advance interpreter-owned
                    # enum payload storage.
                    val mc_lowered_receiver = self.lower_hir_expr(method_receiver_t)
                    var hir_args: [HirCallArg] = []
                    for arg in method_args_t:
                        val marg_t: CallArg = arg
                        hir_args = hir_args.push(HirCallArg(
                            has_name: marg_t.has_name,
                            name: marg_t.name,
                            value: self.lower_hir_expr(marg_t.value),
                            span: marg_t.span
                        ))
                    # Module-qualified call written in method-call syntax
                    # (`provider.answer()` reached via `import provider` --
                    # the parser emits ExprKind.MethodCall for ANY
                    # `recv.name(args)` form, not just ExprKind.Call(Field(
                    # ...)); the sibling Field arm above already redirects a
                    # module-qualified BARE field access to the defining
                    # function's NamedVar, but this MethodCall arm never
                    # special-cased a module-namespace receiver at all, so a
                    # qualified call written with call-parens silently
                    # lowered to HirExprKind.MethodCall on a Module symbol --
                    # which has no runtime receiver value and no class
                    # method named `method`, so MIR method-call lowering can
                    # never resolve it. The call survives structurally (as
                    # the block's tail `.value`, so `body.stmts.len()==0` is
                    # normal tail-value desugaring, not itself a drop) but
                    # was semantically dead: no diagnostic, no callable code
                    # emitted. Mirror the Field arm's intent: if the receiver
                    # is a symbol that came from a cross-module import
                    # registration (`defining_module` set -- an ordinary
                    # local variable/parameter never has one) AND that
                    # module has a matching callable named `method`, lower
                    # to a plain qualified Call instead.
                    #
                    # Deliberately does NOT gate on `receiver symbol.kind ==
                    # SymbolKind.Module` (unlike a first version of this
                    # fix): that comparison was found to NEVER match at
                    # runtime here (see field_module_callable's doc comment
                    # for the full cross-module symbol-kind investigation),
                    # so field_module_callable's own (defining_module, name)
                    # match is the sole -- and sufficient -- gate. Falls
                    # through to the original MethodCall lowering (no error)
                    # when no match is found, so ordinary method calls
                    # (`arr.push(x)`, a struct instance method, ...) are
                    # unaffected.
                    val mc_base_sym = _hir_expr_symbol_or_invalid(mc_lowered_receiver.kind)
                    if mc_base_sym.is_valid():
                        if val mc_base_symbol = self.symbols.get_symbol_raw(mc_base_sym.id):
                            if val mc_module_name = mc_base_symbol.defining_module:
                                val mc_module_callable = self.field_module_callable(mc_module_name, method_name_t)
                                if val mc_resolved_callable = mc_module_callable:
                                    val mc_callable_name = self.symbols.symbol_display_name(mc_resolved_callable, method_name_t)
                                    return HirExpr(
                                        kind: HirExprKind.Call(
                                            HirExpr(kind: HirExprKind.NamedVar(mc_resolved_callable, mc_callable_name), type_: nil, span: e.span),
                                            hir_args,
                                            []
                                        ),
                                        type_: nil,
                                        span: e.span
                                    )
                    return HirExpr(
                        kind: HirExprKind.MethodCall(mc_lowered_receiver, method_name_t, hir_args, MethodResolution.Unresolved),
                        type_: nil,
                        span: e.span
                    )
                case _:
                    pass
        if kind_disc_v == hir_expr_kind_disc(ExprKind.IfChain([], nil)):
            match expr_kind_value:
                case ExprKind.IfChain(arms, else_):
                    var hir_arms: [HirIfArm] = []
                    var arm_idx = 0
                    while arm_idx < arms.len():
                        val arm: IfArm = arms[arm_idx]
                        hir_arms = hir_arms.push(HirIfArm(
                            cond: self.lower_hir_expr(arm.cond),
                            then_: self.lower_hir_block(arm.then_),
                            span: arm.span
                        ))
                        arm_idx = arm_idx + 1
                    if val else_block_src = else_:
                        return HirExpr(
                            kind: HirExprKind.IfChain(hir_arms, self.lower_hir_block(else_block_src)),
                            type_: nil,
                            span: e.span
                        )
                    return HirExpr(kind: HirExprKind.IfChain(hir_arms, nil), type_: nil, span: e.span)
                case _:
                    pass
        if kind_disc_v == hir_expr_kind_disc(ExprKind.If(kind_disc_dummy, Block(stmts: [], span: e.span), nil)):
            match expr_kind_value:
                case ExprKind.If(cond, then_, else_):
                    val hir_cond = self.lower_hir_expr(cond)
                    val hir_then = self.lower_hir_block(then_)
                    if val else_block_src = else_:
                        return HirExpr(
                            kind: HirExprKind.If(hir_cond, hir_then, self.lower_hir_block(else_block_src)),
                            type_: nil,
                            span: e.span
                        )
                    return HirExpr(
                        kind: HirExprKind.If(hir_cond, hir_then, nil),
                        type_: nil,
                        span: e.span
                    )
                case _:
                    pass
        if kind_disc_v == 21232742:  # hash("Field")
            match expr_kind_value:
                case ExprKind.Field(base, field):
                    val fld_base_t: Expr = base
                    val fld_name_t: text = field
                    val fld_lowered_base = self.lower_hir_expr(fld_base_t)
                    # Module imports are namespaces, not runtime values. A
                    # qualified imported function must lower to its defining
                    # function symbol before MIR call lowering.
                    #
                    # Deliberately does NOT gate on `fld_base_symbol.kind ==
                    # SymbolKind.Module` (see field_module_callable's doc
                    # comment): that comparison never matches at runtime for
                    # a symbol whose SymbolKind value crossed from a
                    # different module's import spelling of the symlinked
                    # `compiler.hir` / `compiler.20.hir` path, so this arm
                    # was silently dead code prior to this fix.
                    # field_module_callable's own (defining_module, name)
                    # match is the sole -- and sufficient -- gate.
                    val fld_base_sym = _hir_expr_symbol_or_invalid(fld_lowered_base.kind)
                    if fld_base_sym.is_valid():
                        if val fld_base_symbol = self.symbols.get_symbol_raw(fld_base_sym.id):
                            if val module_name = fld_base_symbol.defining_module:
                                val module_callable = self.field_module_callable(module_name, fld_name_t)
                                if val resolved_callable = module_callable:
                                    val callable_name = self.symbols.symbol_display_name(resolved_callable, fld_name_t)
                                    return HirExpr(kind: HirExprKind.NamedVar(resolved_callable, callable_name), type_: nil, span: e.span)
                    # Numeric tuple positional access (`t.0`, `t.1`, ...):
                    # route through HirExprKind.Index (rt_array_get at
                    # runtime) instead of the generic struct-field path
                    # below. Tuples are rt_arrays at runtime (see
                    # lower_tuple_destructure in statements.spl) and
                    # resolve_field_index (MIR function_lowering.spl) has no
                    # notion of a tuple's positional layout -- left to fall
                    # through to the struct-field path it silently defaults
                    # the field index and native codegen emits a
                    # struct-shaped GEP with the wrong (or a fixed) index,
                    # which either reads the wrong element or crashes the
                    # LLVM backend outright ("invalid getelementptr
                    # indices" -- reproduced with `val t = (3, 5);
                    # print(t.0 + t.1)` on the native `--entry` path before
                    # this fix). Index codegen is already proven correct
                    # for tuple values by the existing (non-literal-init)
                    # tuple-destructure desugar, which binds a temp tuple
                    # and reads elements via the same rt_array_get path.
                    if is_tuple_positional_field(fld_name_t):
                        val fld_tuple_idx = parse_tuple_field_index(fld_name_t)
                        # Recover the element's real type from local_tuple_types
                        # (see doc comment in types.spl) when the base is a
                        # plain variable bound to a tracked tuple literal --
                        # without this, a mixed-type tuple's non-i64 element
                        # (e.g. text) reads back as raw i64 bits downstream
                        # (MIR's Index case has no per-index element-type table
                        # for MirTypeKind.Tuple and defaults to i64).
                        val fld_tuple_elem_type = self.field_tuple_element_type(fld_lowered_base.kind, fld_tuple_idx)
                        return HirExpr(
                            kind: HirExprKind.Index(fld_lowered_base, HirExpr(kind: HirExprKind.IntLit(fld_tuple_idx, nil), type_: nil, span: e.span)),
                            has_type_: true,
                            type_: fld_tuple_elem_type,
                            span: e.span
                        )
                    # Nested-field-access support (native --entry path bug --
                    # see struct_field_types_by_name / local_struct_types doc
                    # comments in types.spl). Without this, `type_` stays nil
                    # here (no inference pass on this path) and MIR defaults
                    # the field's MirType to i64 -- silently wrong for a
                    # non-i64 field (observed: an array-typed struct field
                    # read as raw i64 -> garbage GEP instead of the runtime
                    # array accessor). Only resolves the narrow, static
                    # `val/var x = StructName(...)` local shape; anything else
                    # falls through to the pre-existing nil/i64-default
                    # behavior unchanged.
                    val fld_base_sym = _hir_expr_symbol_or_invalid(fld_lowered_base.kind)
                    if self.field_access_for_expr(fld_lowered_base, fld_name_t) == 0:
                        self.error("field `{fld_name_t}` is not visible from this module", e.span)
                        return HirExpr(
                            kind: HirExprKind.Error,
                            has_type_: false,
                            type_: HirType(kind: HirTypeKind.Unit, span: e.span),
                            span: e.span)
                    if fld_base_sym.is_valid():
                        val fld_field_type = self.field_type_for_base_raw(fld_base_sym.id, fld_name_t)
                        match fld_field_type.kind:
                            case HirTypeKind.Error: ()
                            case _:
                                # The field table owns the semantic kind, but
                                # its diagnostic Span is a rich aggregate that
                                # may have crossed HIR safepoints. Re-root the
                                # type with this live expression's span before
                                # constructing another aggregate.
                                val live_field_type = HirType(
                                    kind: fld_field_type.kind,
                                    span: e.span)
                                return HirExpr(
                                    kind: HirExprKind.Field(fld_lowered_base, fld_name_t, nil),
                                    has_type_: true,
                                    type_: live_field_type,
                                    span: e.span)
                    return HirExpr(kind: HirExprKind.Field(fld_lowered_base, fld_name_t, nil), type_: nil, span: e.span)
                case _:
                    pass
        if kind_disc_v == 1138084884:  # hash("Block")
            match expr_kind_value:
                case ExprKind.Block(block):
                    return HirExpr(kind: HirExprKind.Block(self.lower_hir_block(block)), type_: nil, span: e.span)
                case _:
                    pass
        val kind = match expr_kind_value:
            case ExprKind.IntLit(value):
                HirExprKind.IntLit(value, nil)

            case ExprKind.FloatLit(value):
                HirExprKind.FloatLit(value, nil)

            case ExprKind.StringLit(value, interps):
                # Bug bootstrap_mir_interpolation_literal_braces: same #130
                # fix as the Call/MethodCall arms above -- the former
                # SIMPLE_BOOTSTRAP branch unconditionally wiped an
                # already-parsed `interps` list to `nil`, so the MIR layer
                # never saw any interpolation parts and emitted the raw
                # `"text {n}"` literal verbatim in bootstrap-compiled
                # binaries. The parser has already built `interps` correctly
                # by this point regardless of SIMPLE_BOOTSTRAP; always lower
                # it when present.
                val hir_interps = if interps.?:
                    self.lower_interpolation_list(interps)
                else:
                    nil
                HirExprKind.StringLit(value, hir_interps)

            case ExprKind.BoolLit(value):
                HirExprKind.BoolLit(value)

            case ExprKind.ArrayLit(elements):
                val hir_elements = self.lower_expr_list(elements)
                # For empty arrays, use configured default element type
                val elem_type = if hir_elements.is_empty():
                    if self.is_strict_empty_collections():
                        self.error("empty array requires explicit type annotation", e.span)
                        nil
                    else:
                        Some(self.get_empty_array_default())
                else:
                    nil  # Type will be inferred from elements
                HirExprKind.ArrayLit(hir_elements, elem_type)

            case ExprKind.ArrayRepeat(value, count):
                # [value; count] -- repeat `value` `count` times. Element type is
                # inferred from `value` downstream, so leave it nil here.
                val hir_value = self.lower_hir_expr(value)
                val hir_count = self.lower_hir_expr(count)
                HirExprKind.ArrayRepeat(hir_value, hir_count, nil)

            case ExprKind.TupleLit(elements):
                HirExprKind.TupleLit(self.lower_expr_list(elements))

            case ExprKind.DictLit(entries):
                HirExprKind.DictLit(self.lower_dict_entries(entries), nil, nil)

            case ExprKind.SetLit(elements):
                HirExprKind.SetLit(self.lower_expr_list(elements), nil)

            case ExprKind.Ident(name):
                # Typed rebind: extracted ANY-ish payload misreads on stage4
                # when consumed directly (bug doc iteration 18).
                val ident_name_t: text = name
                val symbol = self.symbols.lookup(ident_name_t)
                if val found_symbol = symbol:
                    # NOTE: `if val found_symbol = symbol:` is not sufficient
                    # here -- same class of bug fixed in 413d121a011 for MIR
                    # `if val ... .type_:` sites: the seed interpreter's
                    # `if val` presence check can still enter this true
                    # branch with `found_symbol` bound to nil when the
                    # lookup actually failed. Downstream consumers of
                    # HirExprKind.NamedVar (e.g. MIR lowering's `symbol.id`
                    # access) assume `symbol` is never nil, so a redundant
                    # explicit nil re-check here avoids constructing a
                    # NamedVar with a nil symbol and crashing later with
                    # "undefined field 'id': cannot access field on value
                    # of type 'nil'".
                    if found_symbol == nil:
                        self.lower_unresolved_ident(ident_name_t, e.span)
                    else:
                        # Under a --entry-closure bootstrap build, a
                        # cross-module imported (or same-module,
                        # non-entry-module) function's stored symbol name may
                        # have been rewritten to a qualified `module.function`
                        # form (qualify_imported_function_symbol /
                        # bootstrap_decl_idx's rename_symbol call, both in
                        # this file's `impl HirLowering` block) so it stays
                        # distinct from a same-named function in a DIFFERENT
                        # module -- the flat MIR accumulator
                        # (bootstrap_lower_extra_hir_module_to_mir,
                        # bootstrap_globals.spl) keys/emits every closure
                        # helper module's functions the same qualified way.
                        # Bake the CURRENT stored name into this NamedVar's
                        # payload text HERE (same HIR-lowering pass as the
                        # rename, so the mutation is still visible) rather
                        # than deferring to a fresh `self.symbols` lookup at
                        # MIR-lowering time: a symbol-table rename applied
                        # during HIR lowering does not survive the trip
                        # through the bootstrap entry-HIR-module global into
                        # that later, separate pass (the interpreter's known
                        # "mutating a class held inside a value-type struct
                        # across a pass boundary" landmine) even though it IS
                        # visible to a same-pass lookup like this one (bug
                        # bootstrap_stage2_empty_mir_bodies_2026-07-05, Probe
                        # B). A name that was never rewritten (the common
                        # case: normal compiles, single-entry bootstrap
                        # builds, and the entry closure module's own
                        # same-module calls) round-trips to `ident_name_t`
                        # unchanged, so this is a no-op there.
                        val display_name = self.symbols.symbol_display_name(found_symbol, ident_name_t)
                        HirExprKind.NamedVar(found_symbol, display_name)
                else:
                    self.lower_unresolved_ident(ident_name_t, e.span)

            # NOTE: ExprKind.Field and ExprKind.Block arms are handled by the
            # discriminant pre-dispatch above (seed always-true struct-pattern
            # hazard) and MUST NOT appear in this match.
            case ExprKind.Index(base, index):
                val index_base_t: Expr = base
                val index_t: Expr = index
                val lowered_index = self.lower_hir_expr(index_t)
                match index_base_t.kind:
                    case ExprKind.ExistsCheck(exists_base):
                        val exists_base_t: Expr = exists_base
                        val indexed = HirExpr(
                            kind: HirExprKind.Index(self.lower_hir_expr(exists_base_t), lowered_index),
                            type_: nil,
                            span: e.span
                        )
                        HirExprKind.ExistsCheck(indexed)
                    case _:
                        val lowered_base = self.lower_hir_expr(index_base_t)
                        # Preserve an element type while the freshly lowered
                        # base is still local.  Reconstructing it later in the
                        # semantic pass requires extracting nested HirType enum
                        # payloads after collection transfer, which is unsafe on
                        # the staged native ABI and left `row.values[0]`
                        # untyped even though `row.values` was `[Cell]`.
                        # `has_type_` is the AUTHORITATIVE presence bit (see
                        # HirExpr's docstring). `type_ != nil` is not the same
                        # test: when `has_type_` is false the `type_` word is a
                        # placeholder — commonly a freshly allocated, zeroed
                        # HirType, which is non-nil — so testing nil alone lets
                        # a placeholder be INTERPRETED. `base_type.kind` is then
                        # read out of that placeholder and its enum payload
                        # extracted, yielding a garbage `element`/`value` that
                        # is stored back as a real `type_` with `has_type_:
                        # true`. That malformed word later reaches the 16-byte
                        # HirType clone in `lower_hir_block`'s HirBlock
                        # construction and SIGSEGVs.
                        if lowered_base.has_type_ and lowered_base.type_ != nil:
                            val base_type = lowered_base.type_ ?? HirType(kind: HirTypeKind.Error, span: e.span)
                            match base_type.kind:
                                case HirTypeKind.Array(element, _) | HirTypeKind.Slice(element):
                                    return HirExpr(
                                        kind: HirExprKind.Index(lowered_base, lowered_index),
                                        has_type_: true,
                                        type_: element,
                                        span: e.span)
                                case HirTypeKind.Dict(_, value):
                                    return HirExpr(
                                        kind: HirExprKind.Index(lowered_base, lowered_index),
                                        has_type_: true,
                                        type_: value,
                                        span: e.span)
                                case _: ()
                        HirExprKind.Index(lowered_base, lowered_index)

            case ExprKind.OptionalChain(base, field):
                HirExprKind.OptionalChain(self.lower_hir_expr(base), field)

            case ExprKind.NullCoalesce(left, right):
                HirExprKind.NullCoalesce(self.lower_hir_expr(left), self.lower_hir_expr(right))

            case ExprKind.ExistsCheck(base):
                HirExprKind.ExistsCheck(self.lower_hir_expr(base))

            case ExprKind.ForceUnwrap(base):
                HirExprKind.Unwrap(self.lower_hir_expr(base))

            case ExprKind.Cast(operand, target_type):
                HirExprKind.Cast(self.lower_hir_expr(operand), self.lower_type(target_type))

            case ExprKind.Binary(op, left, right):
                # Typed rebinds: extracted ANY-ish payloads misread on stage4
                # when consumed directly (bug doc iteration 18).
                val bin_op_t: BinOp = op
                val bin_left_t: Expr = left
                val bin_right_t: Expr = right
                val hir_op = self.lower_binop(bin_op_t, e.span)
                # `x is i64` / `x is not i64`: when the RIGHT side NAMES A
                # TYPE it is a type TEST, not a value comparison. Lowering it
                # as a value is the recorded defect (bug doc
                # union_narrowing_has_no_grammar_or_runtime_2026-08-21.md:
                # "GlobalLoad: unresolved identifier 'i64'"). Only a bare
                # identifier that looks like a type is taken; anything else
                # keeps the existing Binary lowering, so `x is y` over two
                # values is untouched.
                val is_type_name = binary_is_type_operand(bin_op_t, bin_right_t)
                if is_type_name != "":
                    val tested = HirExpr(kind: HirExprKind.TypeTest(self.lower_hir_expr(bin_left_t), is_type_name), type_: nil, span: e.span)
                    match bin_op_t:
                        case BinOp.IsNot: HirExprKind.Unary(HirUnaryOp.Not, tested)
                        case _: HirExprKind.TypeTest(self.lower_hir_expr(bin_left_t), is_type_name)
                else:
                    HirExprKind.Binary(hir_op, self.lower_hir_expr(bin_left_t), self.lower_hir_expr(bin_right_t))

            case ExprKind.Unary(op, operand):
                val un_op_t: UnaryOp = op
                val un_operand_t: Expr = operand
                val hir_op = self.lower_unaryop(un_op_t)
                HirExprKind.Unary(hir_op, self.lower_hir_expr(un_operand_t))

            case ExprKind.MethodCall(receiver, method, args):
                # Same #130 fix as the Call arm: the former SIMPLE_BOOTSTRAP branch
                # wiped method-call args to `[]`. Always run the safe loop.
                val method_receiver_t: Expr = receiver
                val method_name_t: text = method
                val method_args_t: [CallArg] = args
                # Lower the receiver while its extracted MethodCall payload is
                # still authoritative. Lowering argument expressions can
                # advance interpreter-owned enum payload storage.
                val lowered_method_receiver = self.lower_hir_expr(method_receiver_t)
                var hir_args: [HirCallArg] = []
                for arg in method_args_t:
                    val marg_t: CallArg = arg
                    # All-four-fields construction: see Call arm above.
                    hir_args = hir_args.push(HirCallArg(
                        has_name: marg_t.has_name,
                        name: marg_t.name,
                        value: self.lower_hir_expr(marg_t.value),
                        span: marg_t.span
                    ))
                HirExprKind.MethodCall(lowered_method_receiver, method_name_t, hir_args, MethodResolution.Unresolved)

            case ExprKind.MatchCase(scrutinee, arms):
                # The scrutinee is lowered FIRST and OUTSIDE every arm scope:
                # it is evaluated before any pattern matches, so it must never
                # see an arm's pattern bindings.
                val hir_scrutinee = self.lower_hir_expr(scrutinee)
                var hir_arms: [HirMatchArm] = []
                for arm in arms:
                    # Typed rebind: without it the deployed seed interpreter
                    # treats `arm` as ANY and field reads mis-decode (a list
                    # field comes back as a scalar handle, so a later `.len()`
                    # crashes with "len on i64"). Every other arm-iterating pass
                    # (40.mono, 30.types) does the same rebind. guard is a
                    # DESUGARED (has_guard, guard) pair — not an Option.
                    val typed_arm: MatchArm = arm

                    # Every arm gets its OWN scope. `lower_pattern` calls
                    # `symbols.define` for each `Binding` sub-pattern, so the
                    # arm's bindings land in THIS scope and are therefore
                    # visible to the arm's guard and body — and only to them.
                    # Without the scope the bindings leaked into (or were lost
                    # from) the enclosing function scope, and an arm body that
                    # referenced its own binding failed HIR lowering with
                    # "unresolved name: <binding>" unless a same-named
                    # parameter or outer local happened to exist. Popping the
                    # scope keeps arm N's bindings out of arm N+1.
                    self.symbols.push_scope(ScopeKind.Block)

                    # Pattern, guard and body are lowered as SEQUENCED
                    # STATEMENTS rather than as sibling named arguments of the
                    # `HirMatchArm(...)` literal. Struct-literal arguments are
                    # not a reliable sequence point here: each argument
                    # expression can be evaluated more than once, so the
                    # `define` side effects of `lower_pattern` were not
                    # dependably ordered before the body's name lookups.
                    # Lowering in explicit order makes "pattern binds, then
                    # guard and body resolve" the only possible schedule.
                    val arm_pattern = self.lower_pattern(typed_arm.pattern)
                    val arm_guard = self.lower_hir_expr(typed_arm.guard)
                    val arm_body = self.lower_hir_block(typed_arm.body)

                    self.symbols.pop_scope()

                    hir_arms = hir_arms.push(HirMatchArm(
                        pattern: arm_pattern,
                        has_guard: typed_arm.has_guard,
                        guard: arm_guard,
                        body: arm_body,
                        span: typed_arm.span
                    ))
                self.build_match_expr(hir_scrutinee, hir_arms, scrutinee.span)

            case ExprKind.Lambda(params, body):
                self.symbols.push_scope(ScopeKind.Function)
                var hir_params: [HirParam] = []
                for p in params:
                    val type_ = if p.type_.?: self.lower_type(p.type_) else: HirType(kind: HirTypeKind.Infer(0, 0), span: p.span)
                    val symbol = self.symbols.define(p.name, SymbolKind.Parameter, type_, p.span, Visibility.Private, false, nil)
                    hir_params = hir_params.push(HirParam(
                        symbol: symbol,
                        name: p.name,
                        type_: type_,
                        default: nil,
                        span: p.span,
                        is_mutable: false
                    ))
                val hir_body = self.lower_hir_expr(body)
                self.symbols.pop_scope()
                HirExprKind.Lambda(hir_params, hir_body, [])

            case ExprKind.Return(value):
                val rv = self.lower_hir_expr(value)
                HirExprKind.Return(rv)

            case ExprKind.Break(label):
                HirExprKind.Break(label, nil)

            case ExprKind.Continue(label):
                HirExprKind.Continue(label)

            case ExprKind.Yield(value):
                # if-val + bare-lift: value-if-nil and optional-in-arg are
                # miscompiled on the stage4 native lane (bug doc 2026-07-23).
                val yv: HirExpr? = match value:
                    case Some(yv_src): self.lower_hir_expr(yv_src)
                    case _: nil
                HirExprKind.Yield(yv)

            case ExprKind.Throw(value):
                HirExprKind.Throw(self.lower_hir_expr(value))

            case ExprKind.Await(expr):
                HirExprKind.Await(self.lower_hir_expr(expr))

            case ExprKind.Try(expr):
                HirExprKind.Try(self.lower_hir_expr(expr))

            case ExprKind.Range(start, end, inclusive, step):
                # if-val + bare-lift: value-if-nil and optional-in-arg are
                # miscompiled on the stage4 native lane (bug doc 2026-07-23).
                val rstart: HirExpr? = match start:
                    case Some(rstart_src): self.lower_hir_expr(rstart_src)
                    case _: nil
                # if-val + bare-lift: value-if-nil and optional-in-arg are
                # miscompiled on the stage4 native lane (bug doc 2026-07-23).
                val rend: HirExpr? = match end:
                    case Some(rend_src): self.lower_hir_expr(rend_src)
                    case _: nil
                # if-val + bare-lift: value-if-nil and optional-in-arg are
                # miscompiled on the stage4 native lane (bug doc 2026-07-23).
                val rstep: HirExpr? = match step:
                    case Some(rstep_src): self.lower_hir_expr(rstep_src)
                    case _: nil
                HirExprKind.Range(rstart, rend, inclusive, rstep)

            case ExprKind.ListComprehension(expr, clauses):
                var hir_clauses: [HirCompClause] = []
                for clause in clauses:
                    val hir_kind = match clause.kind:
                        case For(var_, iter):
                            val symbol = self.symbols.define(var_, SymbolKind.Variable, nil, clause.span, Visibility.Private, false, nil)
                            HirCompClauseKind.For(symbol, self.lower_hir_expr(iter))
                        case If(cond):
                            HirCompClauseKind.If(self.lower_hir_expr(cond))
                    hir_clauses = hir_clauses.push(HirCompClause(kind: hir_kind, span: clause.span))
                HirExprKind.Comprehension(HirComprehensionKind.List, self.lower_hir_expr(expr), hir_clauses)

            case ExprKind.StructLit(type_, fields):
                var hir_fields: [(text, HirExpr)] = []
                for (name, value) in fields:
                    hir_fields = hir_fields.push((name, self.lower_hir_expr(value)))
                val symbol = self.symbols.lookup_or_invalid(type_)
                val hir_type = if symbol.is_valid():
                    HirType(kind: HirTypeKind.Named(symbol, []), span: e.span)
                else:
                    HirType(kind: HirTypeKind.Error, span: e.span)
                HirExprKind.StructLit(hir_type, hir_fields)

            case ExprKind.EnumLit(enum_, variant, payload):
                val symbol = self.symbols.lookup_or_invalid(enum_)
                val hir_type = if symbol.is_valid():
                    HirType(kind: HirTypeKind.Named(symbol, []), span: e.span)
                else:
                    HirType(kind: HirTypeKind.Error, span: e.span)
                val hir_payload = match payload:
                    case Some(p):
                        val lowered_payload = match p:
                            case Tuple(values):
                                var hir_values: [HirExpr] = []
                                for v in values:
                                    hir_values = hir_values.push(self.lower_hir_expr(v))
                                HirEnumPayload.Tuple(hir_values)
                            case Struct(fields):
                                var hir_fields: [(text, HirExpr)] = []
                                for (fname, fvalue) in fields:
                                    hir_fields = hir_fields.push((fname, self.lower_hir_expr(fvalue)))
                                HirEnumPayload.Struct(hir_fields)
                        Some(lowered_payload)
                    case None:
                        nil
                HirExprKind.EnumLit(hir_type, variant, hir_payload)

            # Custom blocks (user-defined: sh{}, sql{}, re{}, etc.)
            case ExprKind.CustomBlock(kind, value):
                HirExprKind.CustomBlock(kind, value)

            # Math/DL blocks with special semantics
            case ExprKind.LossBlock(body):
                HirExprKind.LossBlock(self.lower_hir_block(body))

            case ExprKind.NogradBlock(body):
                HirExprKind.NogradBlock(self.lower_hir_block(body))

            # Unsafe block for raw pointer ops, SFFI, inline assembly
            # `unsafe(capabilities: [...]):` — the capability names ride on the
            # lowered body (`HirBlock.unsafe_caps`) so 35.semantics can ask
            # "does THIS region carry type_erasure?" without a source lookup.
            # Unknown names are a diagnostic here, never silently dropped.
            case ExprKind.UnsafeBlock(body, caps):
                val unknown_caps = unknown_unsafe_capability_names(caps)
                if unknown_caps.len() > 0:
                    self.error("unknown unsafe capability `" + unknown_caps[0] + "`; " + valid_unsafe_capability_names_help(), e.span)
                var unsafe_hir_body = self.lower_hir_block(body)
                unsafe_hir_body.unsafe_caps = caps
                HirExprKind.UnsafeBlock(unsafe_hir_body)

            # Inline assembly
            case ExprKind.AsmBlock(asm_node):
                HirExprKind.InlineAsm(self.lower_asm(asm_node))

            # Target-qualified inline assembly
            case ExprKind.AsmMatch(arms):
                val hir_arms = self.lower_asm_match_arms(arms)
                HirExprKind.InlineAsmMatch(hir_arms)

            # Keep this seed-irrefutable no-payload pattern after every real arm.
            case ExprKind.NilLit:
                HirExprKind.NilLit

            case ExprKind.Error:
                HirExprKind.Error

            case _:
                self.error("unsupported expression kind", e.span)
                HirExprKind.Error

        HirExpr(kind: kind, type_: nil, span: e.span)
