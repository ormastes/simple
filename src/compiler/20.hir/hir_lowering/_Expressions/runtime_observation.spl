# Internal HIR expression enum observation; one raw declaration owner.
use compiler.frontend.parser_types_expr.{ExprKind}
use compiler.hir.hir_definitions.{HirPatternKind}

@unsafe(reason: "reads the discriminant of the runtime boxed enum representation", capabilities: [ffi])
extern fn rt_enum_discriminant<T>(value: T) -> i64

# Concrete exports provide linkable bodies for each supported representation.
# A generic Simple wrapper alone left unspecialized cross-module references.
pub fn hir_ast_expr_runtime_discriminant(value: ExprKind) -> i64:
    unsafe(capabilities: [ffi]):
        rt_enum_discriminant<ExprKind>(value)

pub fn hir_pattern_runtime_discriminant(value: HirPatternKind) -> i64:
    unsafe(capabilities: [ffi]):
        rt_enum_discriminant<HirPatternKind>(value)
