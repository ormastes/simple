# Internal HIR expression enum observation; one raw declaration owner.
@unsafe(reason: "reads the discriminant of the runtime boxed enum representation", capabilities: [ffi])
extern fn rt_enum_discriminant<T>(value: T) -> i64

fn hir_expr_runtime_discriminant<T>(value: T) -> i64:
    unsafe(capabilities: [ffi]):
        rt_enum_discriminant<T>(value)
