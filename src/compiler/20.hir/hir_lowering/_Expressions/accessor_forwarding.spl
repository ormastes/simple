# Accessor forwarding for field reads (REQ-SELFHOST-ACCESSOR-001).
# `recv.x` with no real field `x` lowers to `get_x()`, `is_x()` or `x()` on a
# fully-known owner type (seed parity). The undefined-field hard error is
# opt-in via SIMPLE_STRICT_FIELD_FORWARDING=1, read once.

use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.hir.hir_lowering.types.{HirLowering}
use std.nogc_sync_mut.io_runtime.{env_get_opt}

var _strict_field_forwarding_state: i64 = 0

fn strict_field_forwarding_enabled() -> bool:
    if _strict_field_forwarding_state == 0:
        _strict_field_forwarding_state = if (env_get_opt("SIMPLE_STRICT_FIELD_FORWARDING") ?? "") == "1": 1 else: 2
    _strict_field_forwarding_state == 1

# Test hook: forget the cached flag so the next read re-queries the environment.
fn strict_field_forwarding_reset():
    _strict_field_forwarding_state = 0

impl HirLowering:
    me owner_field_table_lacks(owner_id: i64, name: text) -> bool:
        # True only when the owner's field table exists and has no entry for
        # `name`. A real field whose annotation failed to lower is still present
        # (typed Error), so it is NOT lacking and must not be forwarded.
        unsafe(capabilities: [ffi]):
            if val owner_symbol = self.symbols.get_symbol_raw(owner_id):
                var found_table = false
                if val owner_module = owner_symbol.defining_module:
                    val canonical_name = owner_module + "." + owner_symbol.name
                    if rt_dict_contains(self.struct_field_types_by_name, canonical_name):
                        found_table = true
                        if rt_dict_contains(self.struct_field_types_by_name[canonical_name], name):
                            return false
                if rt_dict_contains(self.struct_field_types_by_name, owner_symbol.name):
                    found_table = true
                    if rt_dict_contains(self.struct_field_types_by_name[owner_symbol.name], name):
                        return false
                return found_table
        false

    me lower_accessor_read(base: HirExpr, name: text, owner_id: i64, span: Span) -> HirExpr?:
        # `_`-prefixed members are never forwarded (seed parity), nor an error.
        if owner_id < 0 or name.starts_with("_"):
            return nil
        if not self.owner_field_table_lacks(owner_id, name):
            return nil
        val candidates = ["get_" + name, "is_" + name, name]
        for candidate in candidates:
            if val method_id = self.symbols.lookup_method_in_type_raw(owner_id, candidate):
                if val method_symbol = self.symbols.get_symbol_raw(method_id.id):
                    # Instance methods only; static methods are Function symbols.
                    var is_instance = false
                    match method_symbol.kind:
                        case SymbolKind.Method: is_instance = true
                        case _: ()
                    if is_instance:
                        var returned: HirType? = nil
                        if val method_type = method_symbol.type_:
                            match method_type.kind:
                                case HirTypeKind.Function(_, ret, _): returned = Some(ret)
                                case _: ()
                        return HirExpr(
                            kind: HirExprKind.MethodCall(base, candidate, [], MethodResolution.Unresolved),
                            has_type_: returned != nil,
                            type_: returned,
                            span: span)
        if strict_field_forwarding_enabled():
            self.error("no field `{name}` on type and no get_/is_ accessor", span)
        nil
