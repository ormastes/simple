# Call-site arity check for direct calls to this module's free/extern functions.
#
# Bug call_site_arity_never_checked_2026-08-04: `f3(7, 8)` against a 3-param
# `fn f3` compiled silently and read a garbage third argument at run time.
# The resolve-pass check (35.semantics fill_call_defaults) only matched `Var`
# callees and that pass does not run on the real compile path; HIR lowering
# always runs and its errors fail the build, so the check lives here.
#
# Scope: a callee that lowers to `NamedVar`/`Var` whose symbol id is a function
# declared in THIS module. Locals that shadow a function name resolve to a
# different symbol id and are not checked. Cross-module callees, closures and
# fn values have no row here and stay unchecked.

use compiler.frontend.parser_types.{ParserFunction, Param}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId}
use compiler.hir.hir_definitions.{HirExpr, HirExprKind, HirCallArg}
use compiler.hir.hir_lowering.types.HirLowering

impl HirLowering:
    me record_call_arity_rows(functions: Dict<text, ParserFunction>):
        var ids: [i64] = []
        var rows: [text] = []
        val keys = functions.keys()
        var key_index = 0
        while key_index < keys.len():
            val fn_: ParserFunction = functions[keys[key_index]]
            # @workaround bug=stage2_symbol_display_name_option_transport_2026-11-03 reason=frozen stage2 mis-tests SymbolId? != nil / .?; resolve through lookup_or_invalid and test the raw id
            val symbol_raw: i64 = self.symbols.lookup_or_invalid(fn_.name).id
            if symbol_raw >= 0:
                val found_symbol: SymbolId = SymbolId(id: symbol_raw)
                var row = fn_.name + "|"
                var param_index = 0
                while param_index < fn_.params.len():
                    val param: Param = fn_.params[param_index]
                    if param_index > 0:
                        row = row + ","
                    if param.has_default:
                        row = row + "?"
                    row = row + param.name
                    param_index = param_index + 1
                ids.push(found_symbol.id)
                rows.push(row)
            key_index = key_index + 1
        self.call_arity_symbol_ids = ids
        self.call_arity_rows = rows

    me check_call_arity(callee: HirExpr, args: [HirCallArg], span: Span):
        val callee_kind: HirExprKind = callee.kind
        var symbol_id = -1
        match callee_kind:
            case HirExprKind.NamedVar(sym, _): symbol_id = sym.id
            case HirExprKind.Var(sym): symbol_id = sym.id
            case _: return
        if symbol_id < 0:
            return
        var row_index = -1
        var scan = 0
        while scan < self.call_arity_symbol_ids.len():
            if self.call_arity_symbol_ids[scan] == symbol_id:
                row_index = scan
                break
            scan = scan + 1
        if row_index < 0:
            return
        val row: text = self.call_arity_rows[row_index]
        val bar = row.index_of("|")
        if bar < 0:
            return
        val fn_name = row.substring(0, bar)
        val param_text = row.substring(bar + 1, row.len())
        val param_specs: [text] = if param_text == "": [] else: param_text.split(",")
        val total = param_specs.len()
        if args.len() > total:
            self.error("function '{fn_name}' accepts at most {total} argument(s), but {args.len()} were provided", span)
            return
        var positional = 0
        var named: [text] = []
        for raw_arg in args:
            val arg: HirCallArg = raw_arg
            if arg.has_name:
                named.push(arg.name)
            else:
                positional = positional + 1
        # Positional args fill the params NOT bound by name, in order. MIR
        # call lowering passes free-call arguments in SOURCE order (it does
        # not reorder by name), so a positional whose bound param differs
        # from its source slot would silently misbind: reject it.
        var misbind = ""
        var next_param = 0
        var source_index = 0
        for raw_arg in args:
            val arg: HirCallArg = raw_arg
            if not arg.has_name:
                while next_param < total and named.contains(param_specs[next_param].replace("?", "")):
                    next_param = next_param + 1
                if next_param < total and next_param != source_index:
                    val bound_spec: text = param_specs[next_param]
                    misbind = "function '{fn_name}': positional argument {source_index + 1} would bind parameter {bound_spec.replace("?", "")} but is passed in slot {source_index + 1}; name it or reorder the call"
                    break
                next_param = next_param + 1
            source_index = source_index + 1
        var missing: [text] = []
        var positional_left = positional
        var param_index = 0
        while param_index < total:
            val spec: text = param_specs[param_index]
            val optional = spec.starts_with("?")
            val param_name: text = if optional: spec.substring(1, spec.len()) else: spec
            if not named.contains(param_name):
                if positional_left > 0:
                    positional_left = positional_left - 1
                elif not optional:
                    missing.push(spec)
            param_index = param_index + 1
        if missing.len() > 0:
            self.error("function '{fn_name}' requires argument(s) {missing.join(", ")}, but {args.len()} were provided", span)
            return
        if misbind != "":
            self.error(misbind, span)
