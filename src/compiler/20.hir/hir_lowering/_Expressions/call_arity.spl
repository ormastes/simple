# Call-site arity check for direct calls to this module's free/extern functions.
#
# Bug call_site_arity_never_checked_2026-08-04: `f3(7, 8)` against a 3-param
# `fn f3` compiled silently and read a garbage third argument at run time.
# The resolve-pass check (35.semantics fill_call_defaults) only matched `Var`
# callees and that pass does not run on the real compile path; HIR lowering
# always runs and its errors fail the build, so the check lives here.
#
# Scope: a callee that lowers to `NamedVar`/`Var` whose symbol id is a function
# declared in THIS module. Locals that shadow a function name resolve to a
# different symbol id and are not checked. Cross-module callees, closures and
# fn values have no row here and stay unchecked.

use compiler.frontend.parser_types.{ParserFunction, Param, ParserTypeParam}
use compiler.frontend.parser_types_expr.{Type, parser_type_kind_named_name, parser_type_kind_is_optional}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId}
use compiler.hir.hir_definitions.{HirExpr, HirExprKind, HirCallArg}
use compiler.hir.hir_lowering.module_surface_types.{ModuleSurfaceCallable, ModuleSurfaceParam}
use compiler.hir.hir_lowering.types.HirLowering

# Row spec per parameter: `?` prefix = has a default; `!` suffix = declared
# with a non-Option, non-erased type (safe code may not pass `None` there).
fn call_arity_spec_name(spec: text) -> text:
    spec.replace("?", "").replace("!", "")

# True when a parameter's declared type can never hold `None` in safe code:
# explicit, not `T?`, not `any`, not one of the function's type parameters.
fn call_arity_type_is_non_option(has_type_: bool, type_: Type, type_name_fallback: text, type_params: [ParserTypeParam]) -> bool:
    if not has_type_:
        return false
    # Discriminant probe, not `case TypeKind.Optional(_)`: see the SEED PATTERN
    # HAZARD note in expression_core.spl (variant-vs-struct name collision).
    if parser_type_kind_is_optional(type_.kind) or parser_type_kind_named_name(type_.kind) == "Option" or type_name_fallback == "Option":
        return false
    val parsed_named = parser_type_kind_named_name(type_.kind)
    val named = if parsed_named != "": parsed_named else: type_name_fallback
    if named == "any":
        return false
    for tp in type_params:
        val tp_t: ParserTypeParam = tp
        if tp_t.name == named:
            return false
    true

fn call_arity_param_non_option(param: Param, type_params: [ParserTypeParam]) -> bool:
    call_arity_type_is_non_option(param.has_type_, param.type_, "", type_params)

fn call_arity_build_row(fn_name: text, names: [text], defaults: [bool], non_opts: [bool], is_instance_method: bool) -> text:
    var start_index = 0
    if is_instance_method and names.len() > 0:
        val first_name: text = names[0]
        if first_name == "self" or first_name == "me":
            start_index = 1
    var row = fn_name + "|"
    var param_index = start_index
    var emitted = 0
    while param_index < names.len():
        if emitted > 0:
            row = row + ","
        if defaults[param_index]:
            row = row + "?"
        row = row + names[param_index]
        if non_opts[param_index]:
            row = row + "!"
        emitted = emitted + 1
        param_index = param_index + 1
    row

fn call_arity_row_for_function(fn_: ParserFunction, is_instance_method: bool) -> text:
    var names: [text] = []
    var defaults: [bool] = []
    var non_opts: [bool] = []
    var param_index = 0
    while param_index < fn_.params.len():
        val param: Param = fn_.params[param_index]
        names.push(param.name)
        defaults.push(param.has_default)
        non_opts.push(call_arity_type_is_non_option(param.has_type_, param.type_, "", fn_.type_params))
        param_index = param_index + 1
    call_arity_build_row(fn_.name, names, defaults, non_opts, is_instance_method)

fn call_arity_row_for_surface_callable(callable: ModuleSurfaceCallable, is_instance_method: bool) -> text:
    var names: [text] = []
    var defaults: [bool] = []
    var non_opts: [bool] = []
    var param_index = 0
    while param_index < callable.params.len():
        val param: ModuleSurfaceParam = callable.params[param_index]
        names.push(param.name)
        defaults.push(param.has_default)
        non_opts.push(call_arity_type_is_non_option(param.has_type_, param.type_, param.type_name, callable.type_params))
        param_index = param_index + 1
    call_arity_build_row(callable.name, names, defaults, non_opts, is_instance_method)

fn hir_arg_is_none_literal(value: HirExpr) -> bool:
    match value.kind:
        case HirExprKind.NamedVar(_, n): n == "None"
        case _: false

impl HirLowering:
    me upsert_call_arity_row(symbol_id: i64, row: text):
        if symbol_id < 0 or row == "":
            return
        var scan = 0
        while scan < self.call_arity_symbol_ids.len():
            if self.call_arity_symbol_ids[scan] == symbol_id:
                self.call_arity_rows[scan] = row
                return
            scan = scan + 1
        self.call_arity_symbol_ids.push(symbol_id)
        self.call_arity_rows.push(row)

    me record_call_arity_row(symbol_id: i64, fn_: ParserFunction, is_instance_method: bool):
        if symbol_id < 0:
            return
        self.upsert_call_arity_row(symbol_id, call_arity_row_for_function(fn_, is_instance_method))

    me record_surface_call_arity_row(symbol_id: i64, callable: ModuleSurfaceCallable, is_instance_method: bool):
        if symbol_id < 0:
            return
        self.upsert_call_arity_row(symbol_id, call_arity_row_for_surface_callable(callable, is_instance_method))

    me copy_call_arity_row(source_symbol_id: i64, target_symbol_id: i64):
        if source_symbol_id < 0 or target_symbol_id < 0:
            return
        var scan = 0
        while scan < self.call_arity_symbol_ids.len():
            if self.call_arity_symbol_ids[scan] == source_symbol_id:
                self.upsert_call_arity_row(target_symbol_id, self.call_arity_rows[scan])
                return
            scan = scan + 1

    me record_call_arity_rows(functions: Dict<text, ParserFunction>):
        val keys = functions.keys()
        var key_index = 0
        while key_index < keys.len():
            val fn_: ParserFunction = functions[keys[key_index]]
            if val found_symbol = self.symbols.lookup(fn_.name):
                if found_symbol.is_valid():
                    self.upsert_call_arity_row(found_symbol.id, call_arity_row_for_function(fn_, false))
            key_index = key_index + 1

    me check_call_arity(callee: HirExpr, args: [HirCallArg], span: Span):
        val callee_kind: HirExprKind = callee.kind
        var symbol_id = -1
        match callee_kind:
            case HirExprKind.NamedVar(sym, _): symbol_id = sym.id
            case HirExprKind.Var(sym): symbol_id = sym.id
            case _: return
        self.check_call_arity_by_symbol_id(symbol_id, args, span)

    me check_call_arity_by_symbol_id(symbol_id: i64, args: [HirCallArg], span: Span):
        if symbol_id < 0:
            return
        var row_index = -1
        var scan = 0
        while scan < self.call_arity_symbol_ids.len():
            if self.call_arity_symbol_ids[scan] == symbol_id:
                row_index = scan
                break
            scan = scan + 1
        if row_index < 0:
            return
        val row: text = self.call_arity_rows[row_index]
        val bar = row.index_of("|")
        if bar < 0:
            return
        val fn_name = row.substring(0, bar)
        val param_text = row.substring(bar + 1, row.byte_len())
        val param_specs: [text] = if param_text == "": [] else: param_text.split(",")
        val total = param_specs.len()
        if args.len() > total:
            self.error("function '{fn_name}' accepts at most {total} argument(s), but {args.len()} were provided", span)
            return
        var positional = 0
        var named: [text] = []
        for raw_arg in args:
            val arg: HirCallArg = raw_arg
            if arg.has_name:
                named.push(arg.name)
            else:
                positional = positional + 1
        # Positional args fill the params NOT bound by name, in order. MIR
        # call lowering passes free-call arguments in SOURCE order (it does
        # not reorder by name), so a positional whose bound param differs
        # from its source slot would silently misbind: reject it.
        var misbind = ""
        var next_param = 0
        var source_index = 0
        for raw_arg in args:
            val arg: HirCallArg = raw_arg
            if not arg.has_name:
                while next_param < total and named.contains(call_arity_spec_name(param_specs[next_param])):
                    next_param = next_param + 1
                if next_param < total and next_param != source_index:
                    val bound_spec: text = param_specs[next_param]
                    misbind = "function '{fn_name}': positional argument {source_index + 1} would bind parameter {call_arity_spec_name(bound_spec)} but is passed in slot {source_index + 1}; name it or reorder the call"
                    break
                next_param = next_param + 1
            source_index = source_index + 1
        # Safe code never passes a literal `None` to a parameter that is not
        # declared `T?` (nil only inside unsafe; the empty value is an Option).
        # Same binding walk as above; `!`-marked specs are the non-Option slots.
        if self.unsafe_block_depth == 0:
            var bind_param = 0
            var arg_pos = 0
            for raw_arg in args:
                val arg: HirCallArg = raw_arg
                var bound = -1
                if arg.has_name:
                    var k = 0
                    while k < total:
                        if call_arity_spec_name(param_specs[k]) == arg.name:
                            bound = k
                            break
                        k = k + 1
                else:
                    while bind_param < total and named.contains(call_arity_spec_name(param_specs[bind_param])):
                        bind_param = bind_param + 1
                    if bind_param < total:
                        bound = bind_param
                    bind_param = bind_param + 1
                if bound >= 0 and param_specs[bound].ends_with("!") and hir_arg_is_none_literal(arg.value):
                    self.error("function '{fn_name}': argument {arg_pos + 1} passes None to parameter {call_arity_spec_name(param_specs[bound])}, which is not declared optional (`T?`); nil/None only inside unsafe", span)
                    return
                arg_pos = arg_pos + 1
        var missing: [text] = []
        var positional_left = positional
        var param_index = 0
        while param_index < total:
            val spec: text = param_specs[param_index]
            val optional = spec.starts_with("?")
            val param_name: text = call_arity_spec_name(spec)
            if not named.contains(param_name):
                if positional_left > 0:
                    positional_left = positional_left - 1
                elif not optional:
                    missing.push(param_name)
            param_index = param_index + 1
        if missing.len() > 0:
            self.error("function '{fn_name}' requires argument(s) {missing.join(", ")}, but {args.len()} were provided", span)
            return
        if misbind != "":
            self.error(misbind, span)
