# HIR lowering - Expression collections, operators, and pattern conversion.
use compiler.common.dependency.visibility.{Visibility}
use compiler.hir.hir_types.*
use compiler.hir.hir_lowering._Expressions.expression_support.{hir_expr_env_get}
use compiler.hir.hir_definitions.*
use compiler.frontend.parser_types.*
use compiler.frontend.parser_types_expr.*
use compiler.frontend.parser_types_expr.{EnumPatternPayload}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_lowering.types.{HirLowering, HirDeclaredPatternEnumSlots}

fn declared_pattern_slot_type_is_concrete(type_: HirType) -> bool:
    if type_ == nil:
        return false
    match type_.kind:
        case HirTypeKind.Infer(_, _) | HirTypeKind.Error | HirTypeKind.TypeParam(_, _) | HirTypeKind.Any: false
        case HirTypeKind.Array(element, _) | HirTypeKind.Slice(element) | HirTypeKind.Optional(element) | HirTypeKind.Isolated(element):
            declared_pattern_slot_type_is_concrete(element)
        case HirTypeKind.Ref(element, _) | HirTypeKind.Ptr(element, _):
            declared_pattern_slot_type_is_concrete(element)
        case HirTypeKind.Dict(left, right) | HirTypeKind.Result(left, right):
            declared_pattern_slot_type_is_concrete(left) and declared_pattern_slot_type_is_concrete(right)
        case HirTypeKind.Tuple(elements) | HirTypeKind.Union(elements):
            declared_pattern_slot_types_are_concrete(elements)
        case HirTypeKind.Named(owner, args):
            owner.is_valid() and declared_pattern_slot_types_are_concrete(args)
        case HirTypeKind.Function(params, result, _):
            declared_pattern_slot_types_are_concrete(params) and declared_pattern_slot_type_is_concrete(result)
        case HirTypeKind.Projection(_, _): false
        case HirTypeKind.Tensor(element, _, _): declared_pattern_slot_type_is_concrete(element)
        case _: true

fn declared_pattern_slot_types_are_concrete(types: [HirType]) -> bool:
    for untyped_type in types:
        val type_: HirType = untyped_type
        if not declared_pattern_slot_type_is_concrete(type_):
            return false
    true

fn or_bare_name_is_variant_reference(name: text) -> bool:
    """Bare Capitalized pattern name: a constructor, never a variable."""
    val first = name.char_at(0)
    first >= "A" and first <= "Z"

impl HirLowering:
    me lower_expr_list(exprs: [Expr]) -> [HirExpr]:
        var result: [HirExpr] = []
        for e in exprs:
            result = result.push(self.lower_hir_expr(e))
        result

    me lower_interpolation_list(interps: [Interpolation]) -> [HirInterpolation]:
        var result: [HirInterpolation] = []
        for i in interps:
            result = result.push(HirInterpolation(
                expr: self.lower_hir_expr(i.expr),
                format: i.format,
                span: i.span
            ))
        result

    me lower_dict_entry(entry: (Expr, Expr)) -> (HirExpr, HirExpr):
        val (key, value) = entry
        (self.lower_hir_expr(key), self.lower_hir_expr(value))

    me lower_dict_entries(entries: [(Expr, Expr)]) -> [(HirExpr, HirExpr)]:
        var result: [(HirExpr, HirExpr)] = []
        for entry in entries:
            result = result.push(self.lower_dict_entry(entry))
        result

    me lower_struct_field(field: (text, Expr)) -> (text, HirExpr):
        val (name, value) = field
        (name, self.lower_hir_expr(value))

    me lower_struct_fields(fields: [(text, Expr)]) -> [(text, HirExpr)]:
        var result: [(text, HirExpr)] = []
        for field in fields:
            result = result.push(self.lower_struct_field(field))
        result

    me lower_binop(op: BinOp, span: Span) -> HirBinOp:
        match op:
            case BinOp.Add: HirBinOp.Add
            case BinOp.Sub: HirBinOp.Sub
            case BinOp.Mul: HirBinOp.Mul
            case BinOp.Div: HirBinOp.Div
            case BinOp.Mod: HirBinOp.Mod
            case BinOp.Pow: HirBinOp.Pow
            case BinOp.MatMul: HirBinOp.MatMul
            case BinOp.Eq: HirBinOp.Eq
            case BinOp.NotEq: HirBinOp.NotEq
            case BinOp.Lt: HirBinOp.Lt
            case BinOp.LtEq: HirBinOp.LtEq
            case BinOp.Gt: HirBinOp.Gt
            case BinOp.GtEq: HirBinOp.GtEq
            case BinOp.And: HirBinOp.And
            case BinOp.Or: HirBinOp.Or
            case BinOp.BitAnd: HirBinOp.BitAnd
            case BinOp.BitOr: HirBinOp.BitOr
            case BinOp.BitXor: HirBinOp.BitXor
            case BinOp.Shl: HirBinOp.Shl
            case BinOp.Shr: HirBinOp.Shr
            case BinOp.BroadcastAdd: HirBinOp.BroadcastAdd
            case BinOp.BroadcastSub: HirBinOp.BroadcastSub
            case BinOp.BroadcastMul: HirBinOp.BroadcastMul
            case BinOp.BroadcastDiv: HirBinOp.BroadcastDiv
            case BinOp.BroadcastPow: HirBinOp.BroadcastPow
            case BinOp.PipeForward: HirBinOp.PipeForward
            case BinOp.Compose: HirBinOp.Compose
            case BinOp.ComposeBack: HirBinOp.ComposeBack
            case BinOp.Parallel: HirBinOp.Parallel
            case BinOp.LayerConnect: HirBinOp.LayerConnect
            case BinOp.In: HirBinOp.In
            case BinOp.NotIn: HirBinOp.NotIn
            case BinOp.Is: HirBinOp.Is
            case BinOp.IsNot: HirBinOp.IsNot
            case _:
                self.error("invalid binary operator", span)
                # Type-required recovery value; the fatal diagnostic prevents
                # this HIR from reaching a backend.
                HirBinOp.Add

    me lower_unaryop(op: UnaryOp) -> HirUnaryOp:
        val disc = rt_enum_discriminant(op)
        if disc == rt_enum_discriminant(UnaryOp.Not):
            return HirUnaryOp.Not
        if disc == rt_enum_discriminant(UnaryOp.BitNot):
            return HirUnaryOp.BitNot
        if disc == rt_enum_discriminant(UnaryOp.Ref):
            return HirUnaryOp.Ref
        if disc == rt_enum_discriminant(UnaryOp.RefMut):
            return HirUnaryOp.RefMut
        if disc == rt_enum_discriminant(UnaryOp.Deref):
            return HirUnaryOp.Deref
        if disc == rt_enum_discriminant(UnaryOp.Transpose):
            return HirUnaryOp.Transpose
        HirUnaryOp.Neg

    me register_enum_unit_patterns(enum_: ParserEnum, local_name: text):
        val owner = self.symbols.lookup_or_invalid(local_name)
        if not owner.is_valid():
            return
        # A field type can retain the provider-qualified identity while an
        # explicit import has a distinct consumer-local alias. Register both
        # only when their enum symbols prove the same declaration origin.
        var canonical_owner = -1
        if val local_symbol = self.symbols.get_symbol_raw(owner.id):
            if local_symbol.kind != SymbolKind.Enum:
                return
            if self.imported_enum_owners.contains_key(local_name):
                val origin = self.imported_enum_owners[local_name]
                if origin != "" and (local_symbol.defining_module ?? "") == origin:
                    val candidate = self.symbols.lookup_qualified_type_raw(origin, local_symbol.name)
                    if candidate >= 0:
                        if val canonical_symbol = self.symbols.get_symbol_raw(candidate):
                            if canonical_symbol.kind == SymbolKind.Enum and canonical_symbol.name == local_symbol.name and (canonical_symbol.defining_module ?? "") == origin:
                                canonical_owner = candidate
        self.generic_enum_constructor_owners[owner.id] = enum_.type_params.len() > 0
        if canonical_owner >= 0:
            self.generic_enum_constructor_owners[canonical_owner] = enum_.type_params.len() > 0
        for untyped_variant in enum_.variants:
            # The flat-AST bridge builds EVERY payload-less variant as
            # `VariantKind.Tuple([])` (module_assembly.spl), never
            # `VariantKind.Unit`, so a Unit-only test registered nothing and
            # every bare variant arm (`case Pass:`, `case Native | Host:`)
            # lowered as a binding. Typed rebind + qualified arms as in
            # lower_variant (seed mis-decodes the untyped/bare forms).
            val variant: Variant = untyped_variant
            var is_unit = false
            match variant.kind:
                case VariantKind.Unit:
                    is_unit = true
                case VariantKind.Tuple(payload_types):
                    is_unit = payload_types.len() == 0
                    # Slot rows: which enum each payload slot is declared as,
                    # for patterns whose OUTER enum HIR cannot name (an
                    # untyped subject, a generic enum, non-concrete slots);
                    # declared_pattern_enum_slots covers every other case.
                    var slot_idx = 0
                    for untyped_slot_type in payload_types:
                        val slot_type: Type = untyped_slot_type
                        self.register_enum_payload_slot(owner.id, variant.name, slot_idx, slot_type, "")
                        slot_idx = slot_idx + 1
                case VariantKind.Struct(payload_fields):
                    # A named payload (`BinOp(dest: LocalId, op: MirBinOp, ..)`)
                    # arrives as Struct; positional patterns index its fields.
                    var field_idx = 0
                    for untyped_payload_field in payload_fields:
                        val payload_field: ParserField = untyped_payload_field
                        self.register_enum_payload_slot(owner.id, variant.name, field_idx, payload_field.type_, "")
                        field_idx = field_idx + 1
                case _: ()
            if is_unit:
                val unit_row_known = self.enum_unit_pattern_names.contains_key("{owner.id}:{variant.name}")
                self.enum_unit_pattern_names["{owner.id}:{variant.name}"] = true
                if canonical_owner >= 0:
                    self.enum_unit_pattern_names["{canonical_owner}:{variant.name}"] = true
                # Name-only row: answers "is this bare name a unit variant of
                # SOME visible enum" when the subject's enum is unknown.
                # `**:` marks a name that a SECOND enum also declares: the
                # name alone then identifies no enum.
                if self.enum_unit_pattern_names.contains_key("*:{variant.name}") and not unit_row_known:
                    self.enum_unit_pattern_names["**:{variant.name}"] = true
                self.enum_unit_pattern_names["*:{variant.name}"] = true

    me bare_name_may_be_unit_variant(name: text) -> bool:
        """The name-only rule's precondition: a Capitalized name that is a
        unit variant of some visible enum. Lowercase names are excluded on
        purpose -- the closure has enums with lowercase unit variants
        (`body`, `mir`, `module`, ...) and a lowercase bare name in a
        pattern is an ordinary binding the arm body reads."""
        if name.len() == 0 or not "ABCDEFGHIJKLMNOPQRSTUVWXYZ".contains(name[0:1]):
            return false
        self.enum_unit_pattern_names.contains_key("*:{name}")

    me warn_bare_variant(name: text, message: text):
        """Advisory on stderr, once per (module, name); lowering is unchanged.
        `SIMPLE_BARE_VARIANT_WARN=0` silences it."""
        if (hir_expr_env_get("SIMPLE_BARE_VARIANT_WARN") ?? "") == "0":
            return
        if self.enum_unit_pattern_names.contains_key("warned:{name}"):
            return
        self.enum_unit_pattern_names["warned:{name}"] = true
        eprint("[hir-lower] WARNING: bare `{name}` {message} ({self.module_filename}; SIMPLE_BARE_VARIANT_WARN=0 silences)")

    me register_enum_payload_slot(outer_owner: i64, variant_name: text, slot: i64, slot_type: Type, path: text):
        """Row `slot:{variant}:{slot}:{path}:{outer enum id}:{slot enum name}`.
        `path` is the chain of Option/Result wrappers between the slot and the enum
        (`op: Op?` -> "/Some", `r: Result<i64, Op>` -> "/Err"), so
        `case W(Some(Eq))` resolves `Eq` through the generic instantiation.
        The outer enum is part of the key: two enums may declare the same
        variant name with differently typed slots."""
        val slot_type_name = parser_type_kind_named_name(slot_type.kind)
        if slot_type_name != "":
            val slot_type_args = parser_type_kind_named_args(slot_type.kind)
            if slot_type_name == "Option" and slot_type_args.len() == 1:
                val option_arg: Type = slot_type_args[0]
                self.register_enum_payload_slot(outer_owner, variant_name, slot, option_arg, path + "/Some")
                return
            if slot_type_name == "Result" and slot_type_args.len() == 2:
                val ok_arg: Type = slot_type_args[0]
                val err_arg: Type = slot_type_args[1]
                self.register_enum_payload_slot(outer_owner, variant_name, slot, ok_arg, path + "/Ok")
                self.register_enum_payload_slot(outer_owner, variant_name, slot, err_arg, path + "/Err")
                return
            val slot_owner = self.symbols.lookup_or_invalid(slot_type_name)
            if slot_owner.is_valid():
                self.enum_unit_pattern_names["slot:{variant_name}:{slot}:{path}:{outer_owner}:{slot_type_name}"] = true
            return
        if parser_type_kind_is_optional(slot_type.kind):
            val optional_inner: Type = parser_type_kind_optional_inner(slot_type.kind, slot_type)
            self.register_enum_payload_slot(outer_owner, variant_name, slot, optional_inner, path + "/Some")

    me payload_slot_enum_owner(outer_owner: i64, outer_variant: text, slot: i64, path: text, name: text) -> i64:
        """Symbol id of the one enum that payload slot `slot` (through `path`)
        of `outer_variant` is declared as AND that owns the unit variant
        `name`. `outer_owner` < 0 = outer enum unknown: every enum declaring
        `outer_variant` is considered. -1 = none, -2 = several.

        Walks the table's TEXT keys and re-resolves the slot enum by name:
        the keys of an `{i64: bool}` dict come back as text on the seed, so
        an id taken from such a key is not usable as a SymbolId there."""
        var slot_prefix = "slot:{outer_variant}:{slot}:{path}:"
        if outer_owner >= 0:
            slot_prefix = "slot:{outer_variant}:{slot}:{path}:{outer_owner}:"
        var found: i64 = -1
        for row_key in self.enum_unit_pattern_names.keys():
            val row: text = row_key
            if row.starts_with(slot_prefix):
                val row_parts = row.split(":")
                val slot_type_name: text = row_parts[row_parts.len() - 1]
                val slot_owner = self.symbols.lookup_or_invalid(slot_type_name)
                if slot_owner.is_valid() and self.enum_unit_pattern_names.contains_key("{slot_owner.id}:{name}"):
                    if found >= 0 and found != slot_owner.id:
                        return -2
                    found = slot_owner.id
        found

    me lower_payload_slot_pattern(p: Pattern, outer_owner: i64, outer_variant: text, slot: i64, path: text) -> HirPattern:
        """Sub-pattern in payload slot `slot` of `outer_variant` (of enum
        `outer_owner`, < 0 when unknown), `path` wrappers deep. A bare name
        that is a unit variant of the slot's declared enum
        (`case BinOp(_, Eq, _, _) | BinOp(_, Ne, _, _):`,
        `case W(Some(Eq)):`) is a variant test, typed with that enum so a
        name several enums share (`Eq`) needs no owner search. Exactly one
        slot enum must own the name; otherwise it stays a binding (the seed
        binds when the slot's type is not an enum owning the name)."""
        match p.kind:
            case PatternKind.Binding(name, mutable):
                if not mutable and self.enum_unit_pattern_names.contains_key("*:{name}"):
                    val slot_owner_id = self.payload_slot_enum_owner(outer_owner, outer_variant, slot, path, name)
                    if slot_owner_id >= 0:
                        val slot_enum_type = HirType(kind: HirTypeKind.Named(SymbolId(id: slot_owner_id), []), span: p.span)
                        return HirPattern(kind: HirPatternKind.Enum(slot_enum_type, name, nil), has_type_: true, type_: slot_enum_type, span: p.span)
            case PatternKind.Enum(wrapper_enum, wrapper, wrapper_payload):
                if wrapper_enum == "" and (wrapper == "Some" or wrapper == "Ok" or wrapper == "Err"):
                    if val wrapped = wrapper_payload:
                        match wrapped:
                            case Tuple(wrapped_patterns):
                                if wrapped_patterns.len() == 1:
                                    val inner = self.lower_payload_slot_pattern(wrapped_patterns[0], outer_owner, outer_variant, slot, path + "/" + wrapper)
                                    return self.wrapper_pattern(wrapper, inner, p.span)
                            case _: ()
            case PatternKind.Or(alternatives):
                var slot_alts: [HirPattern] = []
                for alt in alternatives:
                    slot_alts = slot_alts.push(self.lower_payload_slot_pattern(alt, outer_owner, outer_variant, slot, path))
                return HirPattern(kind: HirPatternKind.Or(self.unify_or_pattern_bindings(slot_alts, p.span)), type_: nil, span: p.span)
            case _: ()
        self.lower_pattern(p)

    me wrapper_pattern(wrapper: text, inner: HirPattern, span: Span) -> HirPattern:
        """`Some(inner)` / `Ok(inner)` / `Err(inner)` exactly as lower_pattern
        builds a bare one-slot enum pattern (unqualified -> Error type; the
        payload wrapped in an explicit Some, see the landmine note there)."""
        var wrapper_payload: HirPatternPayload? = nil
        wrapper_payload = Some(HirPatternPayload.Tuple([inner]))
        HirPattern(kind: HirPatternKind.Enum(HirType(kind: HirTypeKind.Error, span: span), wrapper, wrapper_payload), type_: nil, span: span)

    me pattern_names_unit_variant(p: Pattern) -> bool:
        """True when `p` contains a bare immutable name that is a unit
        variant of some visible enum (directly, in an or-alternative, or
        inside a positional payload)."""
        match p.kind:
            case PatternKind.Binding(name, mutable):
                return not mutable and self.enum_unit_pattern_names.contains_key("*:{name}")
            case PatternKind.Or(alternatives):
                for alt in alternatives:
                    if self.pattern_names_unit_variant(alt):
                        return true
            case PatternKind.Enum(_, _, nested_payload):
                if val nested_pl = nested_payload:
                    match nested_pl:
                        case Tuple(nested_patterns):
                            for nested in nested_patterns:
                                if self.pattern_names_unit_variant(nested):
                                    return true
                        case _: ()
            case _: ()
        false

    me pattern_enum_same_owner(left: SymbolId, right: SymbolId) -> bool:
        if left.id == right.id:
            return true
        if val left_symbol = self.symbols.get_symbol_raw(left.id):
            if val right_symbol = self.symbols.get_symbol_raw(right.id):
                val origin = left_symbol.defining_module ?? ""
                return left_symbol.kind == SymbolKind.Enum and right_symbol.kind == SymbolKind.Enum and origin != "" and origin == (right_symbol.defining_module ?? "") and left_symbol.name == right_symbol.name
        false

    me register_declared_pattern_enum_slots(declaration: ParserEnum, owner: SymbolId, owner_module: text, project_imported_payloads: bool):
        if not owner.is_valid() or declaration.type_params.len() != 0:
            return
        var canonical = -1
        var owner_is_enum = false
        if val symbol = self.symbols.get_symbol_raw(owner.id):
            if symbol.kind != SymbolKind.Enum:
                return
            owner_is_enum = true
            val origin = symbol.defining_module ?? ""
            if origin != "":
                val candidate = self.symbols.lookup_qualified_type_raw(origin, symbol.name)
                if candidate >= 0 and self.pattern_enum_same_owner(owner, SymbolId(id: candidate)):
                    canonical = candidate
        if not owner_is_enum:
            return
        for untyped_variant in declaration.variants:
            val variant: Variant = untyped_variant
            var tuple_types: [HirType] = []
            var field_names: [text] = []
            var field_types: [HirType] = []
            var is_struct = false
            match variant.kind:
                case VariantKind.Tuple(types):
                    for type_ in types:
                        tuple_types = tuple_types.push(self.lower_variant_declared_type(type_, owner_module, project_imported_payloads))
                case VariantKind.Struct(fields):
                    is_struct = true
                    for untyped_field in fields:
                        val field: ParserField = untyped_field
                        field_names = field_names.push(field.name)
                        field_types = field_types.push(self.lower_variant_declared_type(field.type_, owner_module, project_imported_payloads))
                case VariantKind.Unit: ()
            if not declared_pattern_slot_types_are_concrete(tuple_types) or not declared_pattern_slot_types_are_concrete(field_types):
                continue
            val slots = HirDeclaredPatternEnumSlots(tuple_types: tuple_types, field_names: field_names, field_types: field_types, is_struct: is_struct)
            self.declared_pattern_enum_slots["{owner.id}:{variant.name}"] = slots
            if canonical >= 0:
                self.declared_pattern_enum_slots["{canonical}:{variant.name}"] = slots

    me lower_declared_enum_pattern(p: Pattern, enum_name: text, variant_name: text, payload: EnumPatternPayload?, subject_type: HirType?) -> HirPattern?:
        var owner = self.symbols.lookup_or_invalid(enum_name)
        var subject_owner = SymbolId(id: -1)
        if val subject = subject_type:
            match subject.kind:
                case HirTypeKind.Named(named_owner, _):
                    subject_owner = named_owner
                case _: ()
        if enum_name == "":
            owner = subject_owner
        val key = "{owner.id}:{variant_name}"
        if not owner.is_valid() or not self.declared_pattern_enum_slots.contains_key(key):
            return nil
        if enum_name != "" and subject_owner.is_valid() and not self.pattern_enum_same_owner(owner, subject_owner):
            # Only a proven enum slot participates; struct patterns retain
            # their existing lowering and are not compared as enum owners.
            self.error("qualified enum pattern owner differs from subject owner", p.span)
            return nil
        val slots: HirDeclaredPatternEnumSlots = self.declared_pattern_enum_slots[key]
        val enum_type = HirType(kind: HirTypeKind.Named(owner, []), span: p.span)
        var hir_payload: HirPatternPayload? = nil
        if not payload.? and (slots.tuple_types.len() > 0 or slots.field_names.len() > 0):
            self.error("enum pattern is missing its declared payload", p.span)
            return nil
        if val input_payload = payload:
            match input_payload:
                case EnumPatternPayload.Tuple(patterns):
                    # Named declaration slots also support positional matching
                    # in declaration order (e.g. Composite(spec: text) with
                    # case Composite(value)). Retain their declared types.
                    var positional_types = slots.tuple_types
                    if slots.is_struct:
                        positional_types = slots.field_types
                    if patterns.len() != positional_types.len():
                        self.error("enum pattern payload arity differs from declared variant", p.span)
                        return nil
                    var children: [HirPattern] = []
                    var index = 0
                    while index < patterns.len():
                        children = children.push(self.lower_match_pattern(patterns[index], Some(positional_types[index])))
                        index = index + 1
                    hir_payload = Some(HirPatternPayload.Tuple(children))
                case EnumPatternPayload.Struct(fields):
                    if not slots.is_struct:
                        self.error("enum pattern payload shape differs from declared variant", p.span)
                        return nil
                    var children: [(text, HirPattern)] = []
                    for (field_name, field_pattern) in fields:
                        var found = false
                        var index = 0
                        while index < slots.field_names.len():
                            if slots.field_names[index] == field_name:
                                children = children.push((field_name, self.lower_match_pattern(field_pattern, Some(slots.field_types[index]))))
                                found = true
                            index = index + 1
                        if not found:
                            self.error("enum pattern field is absent from declared variant: " + field_name, p.span)
                            return nil
                    hir_payload = Some(HirPatternPayload.Struct(children))
        return Some(HirPattern(kind: HirPatternKind.Enum(enum_type, variant_name, hir_payload), has_type_: true, type_: enum_type, span: p.span))

    me lower_match_pattern(p: Pattern, subject_type: HirType?) -> HirPattern:
        # A bare name is a variant only when the subject's enum owns it.
        # Unrelated enums, mutable bindings and unknown names remain bindings.
        match p.kind:
            case PatternKind.Binding(name, mutable):
                if not mutable:
                    # subject_unknown: HIR has NO static type for the subject
                    # (nil / Infer / Error / Any). A known primitive, struct or
                    # enum subject never takes the name-only rule below: there
                    # the seed binds (`fn h(x: i64): match x: case Var:`).
                    var subject_unknown = true
                    if val type_ = subject_type:
                        match type_.kind:
                            case HirTypeKind.Named(owner, _):
                                if self.enum_unit_pattern_names.contains_key("{owner.id}:{name}"):
                                    return HirPattern(kind: HirPatternKind.Enum(type_, name, nil), has_type_: true, type_: type_, span: p.span)
                                subject_unknown = false
                                # Subject is a registered enum that does not
                                # own `name`, yet `name` is a unit variant of
                                # another visible enum (`op: Op`, `case Return:`
                                # with Return only in Kind). The seed rejects
                                # this; here it still BINDS (a catch-all, as
                                # before) and is reported on stderr only.
                                # Warn-first on purpose: the closure has not
                                # been measured for such arms, and an error
                                # here would fail the bootstrap.
                                if self.generic_enum_constructor_owners.contains_key(owner.id) and self.bare_name_may_be_unit_variant(name):
                                    val subject_enum_name = self.symbols.symbol_name_scalar_raw(owner.id)
                                    self.warn_bare_variant(name, "in a match over `{subject_enum_name}` is not one of its variants (it is a unit variant of another visible enum); it binds as a catch-all -- qualify it or rename the binding")
                            case HirTypeKind.Infer(_, _):
                                subject_unknown = true
                            case HirTypeKind.Error:
                                subject_unknown = true
                            case HirTypeKind.Any:
                                subject_unknown = true
                            case _:
                                subject_unknown = false
                    # Subject enum not statically known (a genuinely untyped
                    # subject: `fn f(x): match x: case Eq:`). The seed decides by
                    # the runtime value's enum; statically, a bare name that is a
                    # unit variant of a visible enum (glob-facade imports
                    # included) is the same unqualified variant pattern
                    # `case BinOp(..)` lowers to: MIR resolves it against the
                    # scrutinee's enum (so a name shared by several enums
                    # needs no choice here) and rejects an unknown variant.
                    # Capitalized names only (bare_name_may_be_unit_variant). A
                    # name two enums share identifies no enum on an untyped
                    # subject: it binds, as on release, with a warning.
                    if subject_unknown and self.bare_name_may_be_unit_variant(name):
                        if self.enum_unit_pattern_names.contains_key("**:{name}"):
                            self.warn_bare_variant(name, "over an untyped subject is a unit variant of several visible enums; it binds as a catch-all -- annotate the subject or qualify the variant")
                        else:
                            return HirPattern(kind: HirPatternKind.Enum(HirType(kind: HirTypeKind.Error, span: p.span), name, nil), type_: nil, span: p.span)
                if val binding_type = subject_type:
                    if declared_pattern_slot_type_is_concrete(binding_type):
                        val symbol = self.symbols.define(name, SymbolKind.Variable, Some(binding_type), p.span, Visibility.Private, mutable, nil)
                        return HirPattern(kind: HirPatternKind.Binding(symbol, mutable), has_type_: true, type_: binding_type, span: p.span)
            case PatternKind.Enum(enum_name, variant_name, payload):
                val errors_before = self.errors.len()
                if val declared_pattern = self.lower_declared_enum_pattern(p, enum_name, variant_name, payload, subject_type):
                    return declared_pattern
                if self.errors.len() != errors_before:
                    # Preserve the fatal; do not run old lowering and create
                    # extra bindings after owner/arity/shape validation failed.
                    return HirPattern(kind: HirPatternKind.Error, has_type_: false, type_: nil, span: p.span)
                if enum_name == "" and (variant_name == "Some" or variant_name == "Ok" or variant_name == "Err"):
                    # `case Some(PriorModuleTld):` over a `Role?` subject. The
                    # declared-slot path above only knows user enums; the
                    # wrapped slot's type comes from the subject's generic
                    # instantiation instead, so the bare name is resolved
                    # exactly like a top-level arm over a `Role` subject (the
                    # seed tests the variant; binding it made every later
                    # `Some(..)` arm dead).
                    if val wrapper_pl = payload:
                        match wrapper_pl:
                            case Tuple(wrapper_patterns):
                                # Only when the wrapped pattern names a possible
                                # unit variant: a plain `Some(x)` keeps its
                                # existing lowering untouched.
                                if wrapper_patterns.len() == 1 and self.pattern_names_unit_variant(wrapper_patterns[0]):
                                    var wrapper_applies = false
                                    var slot_subject: HirType? = nil
                                    if val wrapper_subject = subject_type:
                                        match wrapper_subject.kind:
                                            case HirTypeKind.Optional(optional_inner):
                                                if variant_name == "Some":
                                                    slot_subject = Some(optional_inner)
                                                    wrapper_applies = true
                                            case HirTypeKind.Result(result_ok, result_err):
                                                if variant_name == "Ok":
                                                    slot_subject = Some(result_ok)
                                                    wrapper_applies = true
                                                if variant_name == "Err":
                                                    slot_subject = Some(result_err)
                                                    wrapper_applies = true
                                            case HirTypeKind.Named(wrapper_symbol, wrapper_args):
                                                val wrapper_type_name = self.symbols.symbol_name_scalar_raw(wrapper_symbol.id)
                                                if wrapper_type_name == "Option" and wrapper_args.len() == 1 and variant_name == "Some":
                                                    slot_subject = Some(wrapper_args[0])
                                                    wrapper_applies = true
                                                if wrapper_type_name == "Result" and wrapper_args.len() == 2:
                                                    if variant_name == "Ok":
                                                        slot_subject = Some(wrapper_args[0])
                                                        wrapper_applies = true
                                                    if variant_name == "Err":
                                                        slot_subject = Some(wrapper_args[1])
                                                        wrapper_applies = true
                                            case HirTypeKind.Infer(_, _):
                                                wrapper_applies = true
                                            case HirTypeKind.Error:
                                                wrapper_applies = true
                                            case HirTypeKind.Any:
                                                wrapper_applies = true
                                            case _: ()
                                    else:
                                        wrapper_applies = true
                                    if wrapper_applies:
                                        val wrapped_inner = self.lower_match_pattern(wrapper_patterns[0], slot_subject)
                                        return self.wrapper_pattern(variant_name, wrapped_inner, p.span)
                            case _: ()
            case PatternKind.Tuple(elements):
                if val tuple_type = subject_type:
                    match tuple_type.kind:
                        case HirTypeKind.Tuple(slot_types):
                            if elements.len() == slot_types.len():
                                var children: [HirPattern] = []
                                var index = 0
                                while index < elements.len():
                                    children = children.push(self.lower_match_pattern(elements[index], Some(slot_types[index])))
                                    index = index + 1
                                return HirPattern(kind: HirPatternKind.Tuple(children), has_type_: true, type_: tuple_type, span: p.span)
                        case _: ()
            case PatternKind.Or(alternatives):
                # Every alternative matches the same subject, so a bare name
                # in `case Native | Host:` is resolved against the subject's
                # enum exactly like a top-level bare arm (seed:
                # collect_pattern_bindings recurses with the same expected
                # type). Lowering the alternatives without the subject type
                # turned imported-enum variants into bindings and failed
                # unify_or_pattern_bindings with "[Native] vs [Host]".
                var hir_alts: [HirPattern] = []
                for alt in alternatives:
                    hir_alts = hir_alts.push(self.lower_match_pattern(alt, subject_type))
                return HirPattern(kind: HirPatternKind.Or(self.unify_or_pattern_bindings(hir_alts, p.span)), type_: nil, span: p.span)
            case _: ()
        self.lower_pattern(p)

    me lower_pattern(p: Pattern) -> HirPattern:
        val kind = match p.kind:
            case PatternKind.Wildcard:
                HirPatternKind.Wildcard

            case Literal(value):
                HirPatternKind.Literal(self.lower_hir_expr(value))

            case Binding(name, mutable):
                val symbol = self.symbols.define(name, SymbolKind.Variable, nil, p.span, Visibility.Private, mutable, nil)
                # Level-gated (default off): traces every pattern binding that
                # is actually entered into the current scope. A binding that
                # the arm body cannot resolve but that never appears here was
                # dropped by the FRONTEND pattern conversion, not by this pass.
                if (hir_expr_env_get("SIMPLE_DEBUG_MATCH_PAT") ?? "") == "1":
                    eprint("[match-pat] define binding: {name}")
                HirPatternKind.Binding(symbol, mutable)

            case Tuple(elements):
                var hir_elements: [HirPattern] = []
                for elem in elements:
                    hir_elements = hir_elements.push(self.lower_pattern(elem))
                HirPatternKind.Tuple(hir_elements)

            case Array(elements, rest):
                var hir_elements: [HirPattern] = []
                for elem in elements:
                    hir_elements = hir_elements.push(self.lower_pattern(elem))
                val rest_symbol: SymbolId? = match rest:
                    case Some(rest_name): self.symbols.define(rest_name, SymbolKind.Variable, nil, p.span, Visibility.Private, false, nil)
                    case _: nil
                HirPatternKind.Array(hir_elements, rest_symbol)

            case Struct(type_, fields):
                val symbol = self.symbols.lookup_or_invalid(type_)
                val hir_type = if symbol.is_valid():
                    HirType(kind: HirTypeKind.Named(symbol, []), span: p.span)
                else:
                    HirType(kind: HirTypeKind.Error, span: p.span)
                var hir_fields: [(text, HirPattern)] = []
                for (fname, fpat) in fields:
                    hir_fields = hir_fields.push((fname, self.lower_pattern(fpat)))
                HirPatternKind.Struct(hir_type, hir_fields)

            case Enum(enum_, variant, payload):
                # nestedmatch lane: bare positional struct-pattern
                # reinterpretation. `case Point(x, y):` and a nested payload
                # sub-pattern like `case Circle(Point(x, y)):` both parse
                # IDENTICALLY to a bare (unqualified) enum-variant pattern --
                # convert_flat_pattern (frontend, _FlatAstBridge/
                # convert_nodes.spl) has no dedicated struct-positional-
                # pattern grammar and none is invented here (brace `Point{x,
                # y}` pattern syntax does not parse either -- matchpat lane
                # finding). When the unqualified `variant` name is a
                # REGISTERED STRUCT (struct_field_order_by_name is populated
                # in the up-front declarations pass before any function body
                # is lowered -- see try_register_local_struct_type's
                # identical read of this same map in statements.spl),
                # reinterpret this pattern as a genuine Struct pattern,
                # reusing the SAME positional-field-order convention already
                # established for struct CONSTRUCTION call sites (`Point(3,
                # 4)`) -- not new grammar, just an existing convention
                # applied symmetrically to pattern position. A bare pattern
                # whose name matches neither a struct nor any registered enum
                # variant still falls through unchanged to the plain Enum
                # path below, which the MIR enum-match lowering already
                # rejects with a genuine "unknown variant" compile error
                # (verified empirically: build fails loudly, no binary --
                # never silently wrong), so this branch is purely additive.
                if enum_ == "" and rt_dict_contains(self.struct_field_order_by_name, variant) and not rt_dict_contains(self.enum_variant_names, variant):
                    val field_order = self.struct_field_order_by_name[variant]
                    var sub_patterns: [Pattern] = []
                    if val pl_s = payload:
                        match pl_s:
                            case Tuple(patterns_s):
                                sub_patterns = patterns_s
                            case Struct(_):
                                ()
                    val struct_symbol = self.symbols.lookup_or_invalid(variant)
                    val struct_hir_type = if struct_symbol.is_valid():
                        HirType(kind: HirTypeKind.Named(struct_symbol, []), span: p.span)
                    else:
                        HirType(kind: HirTypeKind.Error, span: p.span)
                    var struct_hir_fields: [(text, HirPattern)] = []
                    var sfi = 0
                    while sfi < sub_patterns.len() and sfi < field_order.len():
                        struct_hir_fields = struct_hir_fields.push((field_order[sfi], self.lower_pattern(sub_patterns[sfi])))
                        sfi = sfi + 1
                    HirPatternKind.Struct(struct_hir_type, struct_hir_fields)
                else:
                    # Level-gated (default off): traces the enum-pattern path,
                    # including whether a payload was seen at all. An arm whose
                    # payload bindings never reach the Binding case above will
                    # show no `payload-tuple` line here.
                    val dbg_on = (hir_expr_env_get("SIMPLE_DEBUG_MATCH_PAT") ?? "") == "1"
                    if dbg_on:
                        eprint("[match-pat] enum pattern: {enum_}.{variant}")
                        if val dbg_pl = payload:
                            eprint("[match-pat]   payload present")
                            match dbg_pl:
                                case Tuple(dbg_pats):
                                    val dbg_n: i64 = dbg_pats.len()
                                    eprint("[match-pat]   payload-tuple n={dbg_n}")
                                case Struct(dbg_flds):
                                    val dbg_m: i64 = dbg_flds.len()
                                    eprint("[match-pat]   payload-struct n={dbg_m}")
                        else:
                            eprint("[match-pat]   payload absent")
                    val symbol = self.symbols.lookup_or_invalid(enum_)
                    val hir_type = if symbol.is_valid():
                        HirType(kind: HirTypeKind.Named(symbol, []), span: p.span)
                    else:
                        HirType(kind: HirTypeKind.Error, span: p.span)
                    # No `.map(\pl: ...)` lambda here: the seed interpreter does not
                    # bind `self` inside a lambda body, so `self.lower_pattern` in a
                    # closure fails native-build with "variable `self` not found".
                    #
                    # The payload is destructured with the `if val` idiom, NOT
                    # with `match payload: case Some(pl): ...`. On this lane a
                    # `case Some(binding)` arm over an OPTIONAL (`T?`, which is
                    # a nullable -- not the `Option` enum) does not run its
                    # body, so the whole payload sub-pattern walk below was
                    # skipped silently: `lower_pattern` was never called on the
                    # payload's sub-patterns, so none of their `Binding` names
                    # were ever entered into scope via `symbols.define`, and
                    # every arm body that used one failed HIR lowering with
                    # "unresolved name: <binding>" -- unless a same-named
                    # parameter or outer local happened to exist and absorb the
                    # lookup. The sibling `if val pl_s = payload:` read in the
                    # struct-positional branch above already uses this idiom;
                    # this makes the two consistent.
                    #
                    # The sub-pattern lists are built with explicit
                    # reassignment (`xs = xs.push(..)`) rather than a bare
                    # `xs.push(..)` whose result is discarded, so the result
                    # does not depend on `.push` happening to mutate in place.
                    # Bare-to-Option assignment landmine (seed interpreter,
                    # SIMPLE_EXECUTION_MODE=interpret -- the engine
                    # native-build's own MIR lowering runs under): assigning a
                    # BARE enum-variant value (`HirPatternPayload.Tuple(...)`)
                    # directly into a `var x: HirPatternPayload? = nil` slot
                    # relies on implicit bare->Some coercion, which the seed
                    # silently drops for an enum payload carrying an array
                    # field -- `hir_payload.?` reads false/nil immediately
                    # after the assignment, and that stale "absent" state
                    # then propagates into every downstream consumer (MIR's
                    # `enum_pat_binding_syms`/`enum_pat_arity` in
                    # switch_operators_calls.spl silently return empty/0 for
                    # a payload that is `.?`-false, so `case Ok(h): h` compiled
                    # under native-build with `undefined variable: h` even
                    # though HIR genuinely built the Tuple([Binding(h)])
                    # payload one statement earlier -- see bug doc
                    # native_build_filehandle_instance_method_unresolved_2026-08-09.md).
                    # Fully isolated with a standalone, compiler-free repro:
                    # `val x: T? = EnumVariant(...)` reads `.?` false;
                    # `val x: T? = Some(EnumVariant(...))` reads it true.
                    # Explicit `Some(...)` is the fix -- never leave the
                    # bare-value coercion to do the wrapping for an
                    # array-payload enum assigned into an Option slot.
                    var hir_payload: HirPatternPayload? = nil
                    if val pl = payload:
                        match pl:
                            case Tuple(patterns):
                                var hir_patterns: [HirPattern] = []
                                # Reached only when lower_declared_enum_pattern
                                # could not type the slots. A qualified pattern
                                # still names its outer enum.
                                var payload_outer_owner: i64 = -1
                                if symbol.is_valid():
                                    payload_outer_owner = symbol.id
                                var payload_slot = 0
                                for pat in patterns:
                                    hir_patterns = hir_patterns.push(self.lower_payload_slot_pattern(pat, payload_outer_owner, variant, payload_slot, ""))
                                    payload_slot = payload_slot + 1
                                hir_payload = Some(HirPatternPayload.Tuple(hir_patterns))
                            case Struct(fields):
                                var hir_fields: [(text, HirPattern)] = []
                                for (fname, fpat) in fields:
                                    hir_fields = hir_fields.push((fname, self.lower_pattern(fpat)))
                                hir_payload = Some(HirPatternPayload.Struct(hir_fields))
                    HirPatternKind.Enum(hir_type, variant, hir_payload)

            case Or(patterns):
                var hir_patterns: [HirPattern] = []
                for pat in patterns:
                    hir_patterns = hir_patterns.push(self.lower_pattern(pat))
                HirPatternKind.Or(self.unify_or_pattern_bindings(hir_patterns, p.span))

            case Range(start, end, inclusive):
                # if-val + bare-lift: value-if-nil and optional-in-arg are
                # miscompiled on the stage4 native lane (bug doc 2026-07-23).
                val pstart: HirExpr? = match start:
                    case Some(pstart_src): self.lower_hir_expr(pstart_src)
                    case _: nil
                # if-val + bare-lift: value-if-nil and optional-in-arg are
                # miscompiled on the stage4 native lane (bug doc 2026-07-23).
                val pend: HirExpr? = match end:
                    case Some(pend_src): self.lower_hir_expr(pend_src)
                    case _: nil
                HirPatternKind.Range(pstart, pend, inclusive)

            case Error:
                HirPatternKind.Error

            # `case complete b:` / `case dyn b:` region arms. Their downstream
            # lowering (region dispatch, interface requirement, seal check) is
            # NOT implemented yet -- §11.6 of
            # doc/05_design/compiler/hardening/critical_completeness_design_2026-08-21.md
            # requires that an unlowered construct raise a NAMED diagnostic
            # rather than silently degrade. Falling into the `case _:` arm below
            # would produce a generic "unsupported pattern kind" and an
            # HirPatternKind.Error that later passes read as an ordinary
            # malformed pattern, which is exactly the silent-drop this rule
            # forbids. The pattern kind is still carried into HIR so a later
            # pass can lower it without re-parsing.
            case CompleteRegion(complete_binder):
                self.error("E-COMPLETE-UNLOWERED: `case complete " + complete_binder + "` is parsed but not yet lowered", p.span)
                HirPatternKind.CompleteRegion(complete_binder)

            case DynRegion(dyn_binder):
                self.error("E-COMPLETE-UNLOWERED: `case dyn " + dyn_binder + "` is parsed but not yet lowered", p.span)
                HirPatternKind.DynRegion(dyn_binder)

            # `case i64 v:` type-pattern arm. Carried into HIR verbatim; the
            # union rewrite (compiler.semantics.union_normalize.narrow) turns
            # it into an Enum pattern of the synthesized `__Union_` enum once
            # the scrutinee type is known, and reports E-NARROW-001 when the
            # scrutinee is not a union.
            case TypeTest(tt_type, tt_binder):
                HirPatternKind.TypeTest(tt_type, tt_binder)

            case _:
                self.error("unsupported pattern kind", p.span)
                HirPatternKind.Error

        HirPattern(kind: kind, type_: nil, span: p.span)

    # ========================================================================
    # matchpat lane: match-pattern forms beyond basic enum-match.
    #
    # The MIR-level match lowering ("B5b", 50.mir/_MirLoweringExpr/
    # expr_dispatch.spl::lower_match_case) only natively supports Wildcard |
    # Binding | Literal(IntLit) | Or(all IntLit) for plain value matches, and
    # Enum patterns whose payload sub-patterns are themselves plain
    # Binding/Wildcard. Every other pattern kind hits a `self.error(...)`
    # there and returns a bare unit temp -- but native-build's lower_to_mir
    # never checks MirLowering.errors, so the build "succeeds" and the
    # resulting binary silently returns a garbage value instead of the
    # correct one or a clean build failure (matchpat lane root-cause; that
    # MIR file is owned by a different lane this round and is not touched
    # here). The HIR-only fix below closes this gap without ever touching
    # the fenced MIR files:
    #
    # Enum-pattern arms keep routing through HirExprKind.MatchCase, via
    # build_match_expr's has_enum branch, which now normalizes the nested
    # payload sub-pattern kinds first (match_desugaring.spl):
    #   * Tuple/Struct  -- flattened to a fresh binding + Field/Index prelude
    #                      statements (flatten_enum_match_arm),
    #   * Enum/Literal  -- passed through to MIR's emit_enum_payload_deep,
    #                      which emits the real runtime test + nested binds
    #                      with fallthrough to the next arm,
    #   * Or            -- expanded into sibling arms of the same variant
    #                      (expand_or_payload_arms), which is exactly
    #                      or-pattern semantics under that fallthrough,
    #   * Range         -- replaced by a fresh binding whose test moves into
    #                      the arm body, with the else branch re-dispatching
    #                      the remaining arms over a scrutinee temp
    #                      (lower_range_payload_arms).
    # Nested enum-payload destructure therefore WORKS (pinned by
    # test/fixtures/compiler/nested_payload_subpattern_matrix.spl); only
    # Array/Error sub-patterns are still a loud compile error.
    #
    # No arm has an Enum pattern, but some arm needs a pattern kind the MIR
    # fast path can't test (Literal(non-IntLit) e.g. text/bool, Range, Or,
    # Tuple, Struct): desugar the WHOLE match into an ordinary if/else-if
    # chain over a single scrutinee temp, entirely bypassing
    # HirExprKind.MatchCase. The LAST arm in source order always becomes the
    # unconditional terminal branch (mirroring a compiler that only ever
    # lowers programs an earlier front-end stage already accepted), so no
    # synthetic panic/dummy-value fallback is needed for any of the
    # exhaustive forms this lane covers (wildcard/binding default, bool
    # true/false, irrefutable tuple/struct destructure). A match that is
    # genuinely non-exhaustive with no default arm is a pre-existing gap
    # (this compiler does not check pattern exhaustiveness anywhere yet) and
    # is unchanged by this fix.
    # ========================================================================

    fn or_binding_ids(p: HirPattern) -> [i64]:
        """Symbol ids of every variable binding in `p` (any depth). Bare
        names that are enum variants (`case Red | Green:`) are unit-variant
        references, not bindings, and are skipped; so are `_` wildcards (a
        payload `_` may arrive as a Binding named "_").

        A bare Capitalized name is a variant reference even when this module
        cannot resolve its enum: `enum_variant_names` only holds the module's
        own and explicitly registered imported enums, so `case NilLit | UnitLit`
        over an enum reached another way arrived here as two "bindings" and
        failed Stage 3 with `[NilLit] vs [UnitLit]`. Such names are resolved
        by variant name later, exactly as a single bare arm is."""
        var out: [i64] = []
        match p.kind:
            case Binding(sym, _):
                val bname = self.symbols.symbol_name_scalar_raw(sym.id)
                if bname != "_" and bname != "" and not self.enum_variant_names.contains_key(bname) and not or_bare_name_is_variant_reference(bname):
                    out.push(sym.id)
            case Tuple(elems):
                for e in elems:
                    for id in self.or_binding_ids(e):
                        out.push(id)
            case Array(elems, rest):
                for e in elems:
                    for id in self.or_binding_ids(e):
                        out.push(id)
                if val rest_sym = rest:
                    out.push(rest_sym.id)
            case Struct(_, fields):
                for (_, fp) in fields:
                    for id in self.or_binding_ids(fp):
                        out.push(id)
            case Enum(_, _, payload):
                if val pl = payload:
                    match pl:
                        case Tuple(pats):
                            for e in pats:
                                for id in self.or_binding_ids(e):
                                    out.push(id)
                        case Struct(sfields):
                            for (_, sp) in sfields:
                                for id in self.or_binding_ids(sp):
                                    out.push(id)
            case Or(alts):
                # Nested Or was already unified; its first alternative
                # carries the shared ids.
                if alts.len() > 0:
                    for id in self.or_binding_ids(alts[0]):
                        out.push(id)
            case _: ()
        out

    fn remap_or_bindings(p: HirPattern, names: [text], ids: [i64]) -> HirPattern:
        """Rebuild `p` with every binding named names[k] using symbol ids[k]."""
        val kind = match p.kind:
            case Binding(sym, mutable):
                val bname = self.symbols.symbol_name_scalar_raw(sym.id)
                var mapped = sym.id
                var k = 0
                while k < names.len():
                    if names[k] == bname:
                        mapped = ids[k]
                    k = k + 1
                HirPatternKind.Binding(SymbolId(id: mapped), mutable)
            case Tuple(elems):
                var ne: [HirPattern] = []
                for e in elems:
                    ne.push(self.remap_or_bindings(e, names, ids))
                HirPatternKind.Tuple(ne)
            case Array(elems, rest):
                var na: [HirPattern] = []
                for e in elems:
                    na.push(self.remap_or_bindings(e, names, ids))
                var new_rest: SymbolId? = nil
                if val rest_sym = rest:
                    val rname = self.symbols.symbol_name_scalar_raw(rest_sym.id)
                    var rmapped = rest_sym.id
                    var rk = 0
                    while rk < names.len():
                        if names[rk] == rname:
                            rmapped = ids[rk]
                        rk = rk + 1
                    new_rest = Some(SymbolId(id: rmapped))
                HirPatternKind.Array(na, new_rest)
            case Struct(stype, fields):
                var nf: [(text, HirPattern)] = []
                for (fname, fp) in fields:
                    nf.push((fname, self.remap_or_bindings(fp, names, ids)))
                HirPatternKind.Struct(stype, nf)
            case Enum(etype, variant, payload):
                var new_payload: HirPatternPayload? = nil
                if val pl = payload:
                    match pl:
                        case Tuple(pats):
                            var np: [HirPattern] = []
                            for e in pats:
                                np.push(self.remap_or_bindings(e, names, ids))
                            new_payload = Some(HirPatternPayload.Tuple(np))
                        case Struct(sfields):
                            var nsf: [(text, HirPattern)] = []
                            for (sname, sp) in sfields:
                                nsf.push((sname, self.remap_or_bindings(sp, names, ids)))
                            new_payload = Some(HirPatternPayload.Struct(nsf))
                HirPatternKind.Enum(etype, variant, new_payload)
            case Or(alts):
                var no: [HirPattern] = []
                for e in alts:
                    no.push(self.remap_or_bindings(e, names, ids))
                HirPatternKind.Or(no)
            case _:
                p.kind
        HirPattern(kind: kind, has_type_: p.has_type_, type_: p.type_, span: p.span)

    me unify_or_pattern_bindings(alts: [HirPattern], span: Span) -> [HirPattern]:
        """`case S.A(x) | S.B(x):` -- every alternative must bind the same set
        of names, and they must all bind the SAME symbol per name: the arm
        body was resolved against one symbol, and native lowering binds each
        alternative separately. Each alternative defined its own symbols, and
        lexical lookup resolves the body to the LAST definition, so every
        alternative is remapped to the last alternative's symbols. Slot-type
        agreement is checked where payload types are known (MIR
        lower_enum_match_flat)."""
        if alts.len() < 2:
            return alts
        val last_ids = self.or_binding_ids(alts[alts.len() - 1])
        var last_names: [text] = []
        for lid in last_ids:
            last_names.push(self.symbols.symbol_name_scalar_raw(lid))
        var out: [HirPattern] = []
        var ai = 0
        while ai < alts.len():
            val alt = alts[ai]
            var alt_names: [text] = []
            for aid in self.or_binding_ids(alt):
                alt_names.push(self.symbols.symbol_name_scalar_raw(aid))
            # Compare name SETS: the same name may legitimately occur at
            # different positions/arity in each alternative.
            var same = true
            for an in alt_names:
                if not last_names.contains(an):
                    same = false
            for ln in last_names:
                if not alt_names.contains(ln):
                    same = false
            if not same:
                self.error("or-pattern alternatives must bind the same variables: [" + alt_names.join(", ") + "] vs [" + last_names.join(", ") + "]", span)
            out.push(self.remap_or_bindings(alt, last_names, last_ids))
            ai = ai + 1
        out

    me pattern_is_mir_native(kind: HirPatternKind) -> bool:
        """True iff the MIR B5b fast path already handles this pattern kind
        correctly on its own (see lower_match_case in the fenced
        expr_dispatch.spl)."""
        match kind:
            case HirPatternKind.Wildcard:
                true
            case Binding(_, _):
                true
            case Literal(lit_expr):
                match lit_expr.kind:
                    case IntLit(_, _):
                        true
                    case _:
                        false
            case Or(patterns):
                var ok = true
                for p in patterns:
                    match p.kind:
                        case Literal(lit2):
                            match lit2.kind:
                                case IntLit(_, _):
                                    ()
                                case _:
                                    ok = false
                        case _:
                            ok = false
                ok
            case Enum(_, _, _):
                # Enum arms always route through the pre-existing, tested
                # MatchCase enum-match lowering unchanged (see
                # build_match_expr's `has_enum` branch below) regardless of
                # this function's answer, so this is never actually
                # consulted for them -- true is the conservative "don't
                # touch it" answer. (Nested payload sub-patterns are
                # normalized there before MIR ever sees them: Tuple/Struct
                # flattened, Enum/Literal passed to emit_enum_payload_deep,
                # Or expanded into sibling arms, Range turned into an
                # in-body test with arm fallthrough -- see the block comment
                # above.)
                true
            case _:
                # Tuple, Array, Struct, Range, Error
                false
