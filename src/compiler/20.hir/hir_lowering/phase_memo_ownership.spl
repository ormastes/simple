# Dependency-free carrier for the exact retained phase-memo owner types.
# The native walker follows array slots and enum payloads without copying
# dictionaries or arrays. This mirrors module_surface_promote_roots.
enum HirPhaseMemoRoot:
    IndexMap({text: i64})
    TextMap({text: text})
    IndexLists({text: [i64]})
    TextLists({text: [text]})
    FlagMap({text: bool})
    Texts([text])
    Ints([i64])

@unsafe(reason: "raw transient-owner promotion; false is provider failure", capabilities: [ffi])
extern fn rt_transient_heap_promote<T>(value: T) -> bool
extern fn rt_array_free<T>(array: [T])

@always_inline
fn hir_phase_memo_promote_raw(roots: [HirPhaseMemoRoot]) -> bool:
    unsafe(capabilities: [ffi]):
        rt_transient_heap_promote(roots)

fn hir_phase_memo_promote_roots(roots: [HirPhaseMemoRoot]) -> bool:
    val promoted = hir_phase_memo_promote_raw(roots)
    # Shallow free: the retained payload owners remain with the caller on
    # either result. Enum wrappers are retained, as in the surface pattern.
    rt_array_free(roots)
    promoted
