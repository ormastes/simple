# Stable destination-owned statement row shapes.
#
# These are compact wire discriminants, not runtime enum hashes. New shapes are
# appended so frozen readers retain the meaning of every existing row.
const HD_STMT_EXPR: i64 = 2001
const HD_STMT_LET: i64 = 2002
const HD_STMT_ASSIGN: i64 = 2003
const HD_STMT_BLOCK: i64 = 2004
const HD_STMT_ASM_ASSERT: i64 = 2005
const HD_STMT_SHARED_VAL: i64 = 2006
const HD_STMT_SHARED_VAR: i64 = 2007
const HD_STMT_GPU_LAUNCH: i64 = 2008

export HD_STMT_EXPR, HD_STMT_LET, HD_STMT_ASSIGN, HD_STMT_BLOCK
export HD_STMT_ASM_ASSERT, HD_STMT_SHARED_VAL, HD_STMT_SHARED_VAR
export HD_STMT_GPU_LAUNCH
