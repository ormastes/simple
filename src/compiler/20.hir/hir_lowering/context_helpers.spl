# HIR Lowering - Context Lifecycle and Diagnostics
#
# Context initialization remains in types.spl; this sibling extension owns
# transient reset, configuration accessors, and diagnostic projections.

use compiler.hir.hir_types.*
use compiler.hir.hir_lowering.types.*
use compiler.common.config.{TypeInferenceConfig, TypeDefault}
use compiler.common.diagnostics.span.{Span}
use compiler.common.visibility.{effective_visibility}
use compiler.common.dependency.visibility.{Visibility}
use std.nogc_sync_mut.io.process_ops.{eprint}

extern fn rt_transient_heap_promote(value: Any) -> bool
extern fn rt_array_free(array: [Any])

impl HirLowering:
    me promote_resolution_caches_transient_owner() -> bool:
        """Retain frozen-registry facts across a streaming module scope.

        The lowerer is constructed before the per-file transient scope, but
        cache rows and replacement arrays are allocated during lowering.
        begin_module deliberately retains these caches. Promote their roots
        while the scope is paused, before its allocations are reclaimed.
        Keep importer symbol tables and lowering scratch out of this graph.
        """
        # A glob miss is qualified by this importer. The next module cannot
        # reuse it, so leave its old rows in the dying scope instead of making
        # every importer's negative queries process-lifetime allocations.
        self.clear_importer_glob_resolution_cache()
        var roots: [Any] = []
        roots.push(self.field_package_dep_memo)
        roots.push(self.surface_package_name_memo)
        roots.push(self.surface_package_name_memo_keys)
        roots.push(self.surface_package_name_memo_values)
        roots.push(self.surface_package_name_memo_hash_buckets)
        roots.push(self.surface_package_name_memo_hash_next)
        roots.push(self.surface_decl_owners)
        roots.push(self.surface_decl_pair_names)
        roots.push(self.surface_decl_pair_surfaces)
        roots.push(self.surface_decl_pair_hash_buckets)
        roots.push(self.surface_decl_pair_hash_next)
        roots.push(self.package_sibling_names)
        roots.push(self.package_sibling_canons)
        roots.push(self.surface_index_by_name)
        roots.push(self.explicit_dep_target_memo)
        roots.push(self.explicit_dep_item_memo)
        roots.push(self.explicit_dep_target_memo_keys)
        roots.push(self.explicit_dep_target_memo_target_values)
        roots.push(self.explicit_dep_target_memo_item_values)
        roots.push(self.explicit_dep_target_memo_hash_buckets)
        roots.push(self.explicit_dep_target_memo_hash_next)
        roots.push(self.payload_origin_miss_memo)
        roots.push(self.payload_origin_miss_memo_keys)
        roots.push(self.payload_origin_miss_memo_hash_buckets)
        roots.push(self.payload_origin_miss_memo_hash_next)
        roots.push(self.impl_index_built)
        roots.push(self.impl_index_positions)
        roots.push(self.impl_method_name_index)
        roots.push(self.impl_trait_name_index)
        roots.push(self.name_index_built)
        roots.push(self.name_index_positions)
        roots.push(self.name_index_keys)
        roots.push(self.name_index_positions_values)
        roots.push(self.name_index_hash_buckets)
        roots.push(self.name_index_hash_next)
        roots.push(self.name_index_built_keys)
        roots.push(self.name_index_built_buckets)
        roots.push(self.name_index_built_next)
        roots.push(self.reexport_root_memo_index)
        roots.push(self.reexport_root_memo_item)
        roots.push(self.reexport_root_memo_keys)
        roots.push(self.reexport_root_memo_index_values)
        roots.push(self.reexport_root_memo_item_values)
        roots.push(self.reexport_root_memo_hash_buckets)
        roots.push(self.reexport_root_memo_hash_next)
        val promoted = rt_transient_heap_promote(roots)
        rt_array_free(roots)
        promoted

    me clear_importer_glob_resolution_cache():
        self.glob_reachable_miss_memo = {}
        self.glob_reachable_miss_memo_keys = []
        self.glob_reachable_miss_memo_hash_buckets = []
        self.glob_reachable_miss_memo_hash_next = []
        self.glob_reachable_miss_memo_hash_mask = 0
        self.glob_reachable_importer_owner = ""
        self.glob_reachable_importer_index = -1

    # Re-entrancy stack accessors for `imported_type_methods_in_progress`.
    #
    # These keep the guard's push/peek/pop behind the HirLowering extension
    # boundary. Reading that field directly from `_Items/module_lowering.spl`
    # made native-build's semantic pass abort the whole worker with
    # "class `HirLowering` has no field named
    # `imported_type_methods_in_progress`", even though the field is declared
    # here and the seed interpreter resolved it fine — the same bare-name
    # class-surface divergence recorded at 10.frontend/ast.spl:65 and
    # _Items/module_lowering.spl:2029. Every other cross-module field on this
    # class predates that surface, so only a newly added one trips it.
    # Divergence filed: doc/08_tracking/bug/native_build_class_surface_misses_newly_added_field_2026-08-17.md
    # Do NOT inline these back into module_lowering.spl.
    me imported_type_methods_in_progress_has(key: text) -> bool:
        for in_progress in self.imported_type_methods_in_progress:
            if in_progress == key:
                return true
        false

    me imported_type_methods_in_progress_push(key: text):
        self.imported_type_methods_in_progress = self.imported_type_methods_in_progress.push(key)

    me imported_type_methods_in_progress_pop(key: text):
        var unwound: [text] = []
        for in_progress in self.imported_type_methods_in_progress:
            if in_progress != key:
                unwound = unwound.push(in_progress)
        self.imported_type_methods_in_progress = unwound

    # Re-entrancy stack accessors for `materialized_payload_in_progress`.
    #
    # Declared and reached exactly like the three above, and for the same
    # reason: a newly added field on this class must not be read bare from
    # `_Items/*.spl` or native-build's semantic pass aborts the worker with
    # "class `HirLowering` has no field named ...". Do NOT inline these.
    #
    # This guards the enum-payload closure cycle, which the Dict memo
    # `materialized_payload_origins` fails to break -- see the essay on the
    # field declaration in types.spl for the 13,415-vs-2,546 measurement.
    me materialized_payload_in_progress_has(key: text) -> bool:
        for in_progress in self.materialized_payload_in_progress:
            if in_progress == key:
                return true
        false

    me materialized_payload_in_progress_push(key: text):
        self.materialized_payload_in_progress = self.materialized_payload_in_progress.push(key)

    me materialized_payload_in_progress_pop(key: text):
        var unwound: [text] = []
        for in_progress in self.materialized_payload_in_progress:
            if in_progress != key:
                unwound = unwound.push(in_progress)
        self.materialized_payload_in_progress = unwound

    me begin_module(filename: text):
        """Reset transient module state without replacing retained owners."""
        # Diagnostics are stable no-GC owners. Clear them in place.
        self.errors = []
        self.diagnostic_messages = []
        self.diagnostic_recovered = []
        self.symbols.reset_module()
        self.current_function = nil
        self.loop_depth = 0
        self.module_filename = filename
        self.module_resolver = nil
        self.loaded_modules = []
        self.current_method_self_type = nil
        self.current_method_self_symbol_id = -1
        self.lowered_impl_functions = {}
        # Trait defaults are consumed only by impls in the module currently
        # being lowered. Retaining full HirTrait values here kept every prior
        # module graph alive across the streaming phase.
        self.lowered_traits = {}
        # module_surfaces, type_inference_config, re-export root caches,
        # generation, and counters are retained reference-bound state.
        self.imported_traits = {}
        self.imported_enums = {}
        self.imported_enum_owners = {}
        self.imported_enum_owner_rows = []
        self.clear_importer_glob_resolution_cache()
        self.materialized_payload_origins = {}
        self.materialized_payload_bindings = {}
        # Must already be empty here (the guard pops what it pushes, and the
        # cycle cannot span a module boundary), so this is belt-and-braces: a
        # stale entry would silently SKIP a needed method registration rather
        # than recurse, which is the quieter and more dangerous failure.
        self.imported_type_methods_in_progress = []
        # Same belt-and-braces for the enum-payload closure breaker, for the
        # same reason and with the same danger profile: a key leaked across a
        # module boundary would silently SKIP a needed payload registration
        # rather than recurse.
        self.materialized_payload_in_progress = []
        # RISDONE (2026-08-21): the completed-registration memo describes ONE
        # importer's symbol table -- the table `reset_module` above just wiped
        # -- so it must not outlive the module it was built for. (The wrapper
        # in `register_imported_symbol` also drops it whenever
        # `module_filename` changes; this is the explicit half of that pair.)
        self.registered_import_memo = {}
        self.registered_import_memo_owner = filename
        # Scalar read authority resets with the Dict (BOOT-20 2026-09-18):
        # begin_module pre-seeds the owner above, so the lazy owner-change
        # check in register_imported_symbol alone would carry these chains
        # across the importer boundary.
        self.registered_import_memo_keys = []
        self.registered_import_memo_hash_buckets = []
        self.registered_import_memo_hash_next = []
        self.registered_import_memo_hash_mask = 0
        # DEPTAIL (2026-08-24): the dependency-tail memo describes the same
        # just-wiped importer table, for the same reason.
        self.dep_tail_memo = {}
        self.dep_tail_memo_owner = filename
        # BOOT-20 (2026-09-18): scalar read authority resets with the Dict,
        # for the same begin_module-pre-seeds-the-owner reason as RISDONE
        # (the lazy owner-change check alone would carry the chains across
        # the importer boundary).
        self.dep_tail_memo_keys = []
        self.dep_tail_memo_hash_buckets = []
        self.dep_tail_memo_hash_next = []
        self.dep_tail_memo_hash_mask = 0
        self.struct_field_types_by_name = {}
        self.local_struct_types = {}
        self.struct_field_order_by_name = {}
        self.local_tuple_types = {}
        self.enum_variant_names = {}
        self.registering_import_symbols = false
        self.fn_tuple_returns = {}
        self.glob_expand_memo = {}
        # BOOT-20 (2026-09-18): scalar read authority resets with the Dict;
        # begin_module is one of the three glob_expand_memo reset sites.
        self.glob_expand_memo_keys = []
        self.glob_expand_memo_values = []
        self.glob_expand_memo_hash_buckets = []
        self.glob_expand_memo_hash_next = []
        self.glob_expand_memo_hash_mask = 0
        self.reexport_visit_surface_indices = []
        self.reexport_visit_wanted = []
        self.reexport_visit_depths = []
        self.reexport_walk_complete = true
        self.reexport_walk_valid = true

    static fn with_resolver(resolver: ModuleResolverPort, filename: text) -> HirLowering:
        var lowering: HirLowering = hirlowering_new()
        lowering.module_filename = filename
        lowering.module_resolver = resolver
        lowering

    me set_type_inference_config(config: TypeInferenceConfig):
        self.type_inference_config = Some(config)

    me get_empty_array_default() -> HirType:
        val default_type = if self.type_inference_config.?:
            self.type_inference_config.unwrap().empty_array_default
        else:
            TypeDefault.I32

        # Convert TypeDefault to HirType
        val span = Span.empty()
        match default_type:
            case TypeDefault.Void: HirType(kind: HirTypeKind.Unit, span: span)
            case TypeDefault.Bool: HirType(kind: HirTypeKind.Bool, span: span)
            case TypeDefault.I8: HirType(kind: HirTypeKind.Int(8, true), span: span)
            case TypeDefault.I16: HirType(kind: HirTypeKind.Int(16, true), span: span)
            case TypeDefault.I32: HirType(kind: HirTypeKind.Int(32, true), span: span)
            case TypeDefault.I64: HirType(kind: HirTypeKind.Int(64, true), span: span)
            case TypeDefault.U8: HirType(kind: HirTypeKind.Int(8, false), span: span)
            case TypeDefault.U16: HirType(kind: HirTypeKind.Int(16, false), span: span)
            case TypeDefault.U32: HirType(kind: HirTypeKind.Int(32, false), span: span)
            case TypeDefault.U64: HirType(kind: HirTypeKind.Int(64, false), span: span)
            case TypeDefault.F32: HirType(kind: HirTypeKind.Float(32), span: span)
            case TypeDefault.F64: HirType(kind: HirTypeKind.Float(64), span: span)
            case TypeDefault.String: HirType(kind: HirTypeKind.Str, span: span)
            case TypeDefault.Nil: HirType(kind: HirTypeKind.Unit, span: span)
            case TypeDefault.Any: HirType(kind: HirTypeKind.Any, span: span)
            case _: HirType(kind: HirTypeKind.Int(32, true), span: span)  # Default to i32

    me is_strict_empty_collections() -> bool:
        if self.type_inference_config.?:
            self.type_inference_config.unwrap().strict_empty_collections
        else:
            false

    # Keep the aggregate LoweringError array inside its HIR owner. Stage4 can
    # Any-erase an array-of-struct field when it is read through a class field
    # in another module under full-closure allocation pressure. Expose only
    # scalar/text projections across that boundary.
    me lowering_error_count() -> i64:
        val focused_future_errors = self.module_filename == "src/lib/nogc_async_mut/async/future.spl"
        if focused_future_errors:
            eprint("[hir-errors] receiver valid")
        val count: i64 = self.diagnostic_messages.len()
        if focused_future_errors:
            eprint("[hir-errors] array valid count={count}")
        count

    me lowering_error_is_recovered_at(index: i64) -> bool:
        self.diagnostic_recovered[index]

    me lowering_error_message_at(index: i64, module_name: text) -> text:
        self.diagnostic_messages[index]

    me compute_visibility(type_name: text, declared_visibility: Visibility) -> Visibility:
        if self.ambient_bootstrap_enabled():
            return Visibility.Public
        if declared_visibility != Visibility.Private:
            return declared_visibility
        if effective_visibility(type_name, self.module_filename, false):
            return Visibility.Public
        Visibility.Private
