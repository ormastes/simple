# Build a ModuleSurface from TLDR summary rows (PR2d).
#
# TLDR rows produced by tldr_summary_v1.spl:
#   use|<statement>                     every top-level use / import / export statement
#   export|<name>                       exported names
#   decl|<kind> <name> id=<stable> cfg=<attrs> sig=<header>   declarations
#   fallback|<reason>                   unsupported constructs
# Plus the companion section rows (layout, trait, const, impl, generic) that
# carry the full struct fields / enum variants / trait members / impl headers.
#
# The rows hold the module's interface as source text, so the builder
# reassembles an interface STUB (headers + layouts, executable bodies replaced
# by `pass`) and parses only that stub -- never the module's source. The
# resulting ModuleSurface is built by the same module_surface_from_module the
# full-source path uses, so params, return types, struct fields, visibility,
# cfg attributes and the semantic hash limbs come from one code path.
#
# Returns nil (fail closed) if ANY fallback| row exists, if a function sig has
# no return type, or if the stub does not parse.
#
# Known limits: a `extern`/bodyless header is kept as written.

use compiler.frontend.flat_ast_bridge.{parse_and_build_module}
use compiler.frontend.parser_types.{ParserModule}
use compiler.hir.hir_lowering.module_surface_types.{ModuleSurface}
use compiler.hir.hir_lowering.module_surface_declarations.{module_surface_from_module}
use compiler.common.driver_core_types.{SourceFile}

fn _tldr_first_line(block: text) -> text:
    val nl = block.index_of("\n")
    if nl < 0: block else: block.substring(0, nl)

# Extract impl block headers in source order from the impls| row.
fn _tldr_impls_source_order_v1(rows: [text]) -> [text]:
    for row in rows:
        if row.starts_with("impls|"):
            val specs = row.substring(6).split("\n")
            return specs
    []

# Indented member headers of an impl / trait row get a `pass` body so the stub parses.
fn _tldr_impl_with_bodies(block: text) -> text:
    var out: [text] = []
    for line in block.split("\n"):
        out.push(line)
        val t = line.trim()
        val is_member = t.starts_with("fn ") or t.starts_with("me ") or t.starts_with("static fn ")
        if is_member and t.ends_with(":") and line.starts_with(" "):
            out.push("        pass")
    out.join("\n")

# The interface stub source of a summary, or nil when it must fail closed.
pub fn module_surface_tldr_stub_source_v1(rows: [text]) -> text?:
    for row in rows:
        if row.starts_with("fallback|"):
            return nil
    var parts: [text] = []
    for row in rows:
        if row.starts_with("use|"):
            parts.push(row.substring(4))
    for row in rows:
        if not row.starts_with("decl|"):
            continue
        # Format: decl|<kind> <name> id=<stable> cfg=<attrs> sig=<header>
        val body = row.substring(5)
        val kind_end = body.index_of(" ")
        if kind_end < 0:
            return nil
        val kind = body.substring(0, kind_end)
        val cfg_at = body.index_of(" cfg=")
        val sig_at = body.index_of(" sig=")
        if cfg_at < 0 or sig_at < cfg_at:
            return nil
        val cfg = body.substring(cfg_at + 5, sig_at)
        val sig = body.substring(sig_at + 5)
        if kind == "fn" and not sig.contains("->"):
            return nil
        if cfg != "":
            for attr in cfg.split(";"):
                parts.push(attr)
        var section = ""
        if kind == "type":
            section = "layout|"
        elif kind == "trait":
            section = "trait|"
        elif kind == "fn":
            section = "generic|"
        var block = ""
        if section != "":
            for candidate in rows:
                if candidate.starts_with(section) and _tldr_first_line(candidate.substring(section.len())) == sig:
                    block = candidate.substring(section.len())
        if block != "":
            parts.push(block)
        elif kind == "fn" and sig.ends_with(":"):
            parts.push(sig + "\n    pass")
        else:
            parts.push(sig)
    val impl_order = _tldr_impls_source_order_v1(rows)
    if impl_order.len() > 0:
        for header in impl_order:
            for row in rows:
                if row.starts_with("impl|") and _tldr_first_line(row.substring(5)) == header:
                    parts.push(_tldr_impl_with_bodies(row.substring(5)))
    else:
        for row in rows:
            if row.starts_with("impl|"):
                parts.push(_tldr_impl_with_bodies(row.substring(5)))
    Some(parts.join("\n") + "\n")

pub fn module_surface_tldr_stub_module_v1(module_id: text, rows: [text]) -> ParserModule?:
    val stub = module_surface_tldr_stub_source_v1(rows)
    if stub == nil:
        return nil
    val module_path = module_id.replace(".", "/") + ".spl"
    val parsed = parse_and_build_module(stub.unwrap(), module_path)
    if parsed.name == "":
        return nil
    Some(parsed)

# Build ModuleSurface from TLDR entries.
pub fn module_surface_from_tldr_v1(module_id: text, rows: [text]) -> ModuleSurface?:
    val stub = module_surface_tldr_stub_source_v1(rows)
    if stub == nil:
        return nil
    val module_path = module_id.replace(".", "/") + ".spl"
    val parsed = parse_and_build_module(stub.unwrap(), module_path)
    if parsed.name == "":
        return nil
    val source = SourceFile(path: module_path, module_name: module_id, content: stub.unwrap())
    val built = module_surface_from_module(parsed, source, 0)
    if built.is_err():
        return nil
    Some(built.unwrap())

export module_surface_tldr_stub_source_v1, module_surface_tldr_stub_module_v1, module_surface_from_tldr_v1
