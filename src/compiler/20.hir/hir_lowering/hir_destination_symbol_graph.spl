# Graph-owned validation for scalar symbol/type publication.
use compiler.hir.hir_lowering.hir_destination_graph.*
use compiler.hir.hir_lowering.hir_destination_symbols_modules.*
use compiler.hir.hir_lowering.hir_destination_symbols.{HD_SYMBOL_KIND_CLASS,HD_SYMBOL_KIND_STRUCT,HD_SYMBOL_KIND_ENUM,HD_SYMBOL_KIND_TRAIT}
const HD_STAGED_MEMBER_HANDLE_BASE: i64 = 1000000000000000

impl HirDestinationGraph:
    fn destination_nominal_owner_kind(kind: i64) -> bool: kind==HD_SYMBOL_KIND_CLASS or kind==HD_SYMBOL_KIND_STRUCT or kind==HD_SYMBOL_KIND_ENUM or kind==HD_SYMBOL_KIND_TRAIT
    me publish_destination_symbol(symbol: i64,name: text,has_type: bool,type_index: i64,visibility: i64,owner_symbol: i64,module_symbol: i64,module_index: i64,kind: i64,mutable_value: bool,has_defining: bool,defining: text,scope: i64,span: i64,is_public: bool) -> i64:
        if not self.mutable() or (has_type and not self.index_ready(HD_RANGE_TYPE,type_index)) or (not has_type and type_index != -1) or not self.span_valid(span,self.generation) or module_index < 0 or module_index >= self.module_count or module_symbol != self.module_identity[module_index]:
            self.destination_symbols.error = true; self.fail("HIR destination symbol authority rejected"); return -1
        val row = self.destination_symbols.publish(symbol,name,has_type,type_index,visibility,owner_symbol,module_symbol,module_index,kind,mutable_value,has_defining,defining,scope,span,is_public)
        if row < 0: self.fail("HIR destination symbol publication conflict")
        row
    me destination_symbols_valid() -> bool:
        if self.destination_symbols.error or self.destination_members.error or self.destination_module_authority.error: return false
        if self.destination_module_authority.count != self.module_count: return false
        var module_cursor=0
        while module_cursor<self.module_count:
            val authority=self.destination_module_authority.building_row(module_cursor,self.generation)
            if authority<0 or not self.module_ready[module_cursor]: return false
            module_cursor=module_cursor+1
        var i = 0
        while i < self.destination_symbols.count:
            val module_index = self.destination_symbols.module_index[i]
            if not self.destination_symbols.ready[i] or (self.destination_symbols.has_type[i] and not self.index_ready(HD_RANGE_TYPE,self.destination_symbols.type_index[i])) or (not self.destination_symbols.has_type[i] and self.destination_symbols.type_index[i] != -1) or not self.span_valid(self.destination_symbols.span_index[i],self.generation) or module_index < 0 or module_index >= self.module_count or not self.module_ready[module_index]: return false
            if self.destination_symbols.module_symbol[i] >= 0 and self.destination_symbols.module_symbol[i] != self.module_identity[module_index]: return false
            val owner = self.destination_symbols.owner_symbol[i]
            if owner >= 0 and self.destination_symbols.building_lookup(module_index,owner,self.generation)<0: return false
            i = i + 1
        i=0
        while i<self.type_count:
            if self.type_ready[i] and self.type_shape[i]==HD_TYPE_NAMED:
                val nominal_symbol=self.type_i0[i]; val nominal_module=self.type_i1[i]
                val nominal_row=self.destination_symbols.building_lookup(nominal_module,nominal_symbol,self.generation)
                if nominal_row<0 or not self.destination_nominal_owner_kind(self.destination_symbols.kind[nominal_row]): return false
            i=i+1
        i=0
        while i<self.destination_members.count:
            if not self.destination_members.ready[i]: return false
            val module_index=self.destination_members.module_index[i]
            val member_symbol_row=self.destination_symbols.building_lookup(module_index,self.destination_members.symbol[i],self.generation)
            val owner_row=self.destination_symbols.building_lookup(module_index,self.destination_members.owner_symbol[i],self.generation)
            if module_index<0 or module_index>=self.module_count or owner_row<0 or not self.destination_nominal_owner_kind(self.destination_symbols.kind[owner_row]) or member_symbol_row<0: return false
            if self.destination_symbols.module_index[member_symbol_row]!=module_index or self.destination_symbols.owner_symbol[member_symbol_row]!=self.destination_members.owner_symbol[i] or self.destination_symbols.name[member_symbol_row]!=self.destination_members.name[i] or self.destination_symbols.has_type[member_symbol_row]!=self.destination_members.has_type[i] or self.destination_symbols.type_index[member_symbol_row]!=self.destination_members.type_index[i]: return false
            val owner_start=self.destination_members.owner_range_start(module_index,self.destination_members.owner_symbol[i],self.generation,false)
            if owner_start<0 or self.destination_members.ordinal[i]!=i-owner_start: return false
            if self.destination_members.has_type[i] and not self.index_ready(HD_RANGE_TYPE,self.destination_members.type_index[i]): return false
            if self.destination_members.has_default[i] and not self.index_ready(HD_RANGE_EXPR,self.destination_members.default_expr[i]): return false
            if self.destination_members.has_bits_attr[i] != (self.destination_members.bits[i]>0): return false
            if not self.span_valid(self.destination_members.span_index[i],self.generation): return false
            i=i+1
        true
    me update_destination_symbol_type(symbol: i64,type_index: i64,visibility: i64,owner_symbol: i64,module_symbol: i64,module_index: i64,kind: i64,mutable_value: bool) -> i64:
        if not self.mutable() or self.checkpoint_count != 0 or not self.index_ready(HD_RANGE_TYPE,type_index): self.destination_symbols.error = true; self.fail("HIR destination symbol type update rejected during checkpoint or invalid type"); return -1
        val row = self.destination_symbols.update_type_same_authority(symbol,type_index,visibility,owner_symbol,module_symbol,module_index,kind,mutable_value)
        if row < 0: self.fail("HIR destination symbol update authority conflict")
        row

    me reserve_destination_module_text_range(count: i64) -> i64:
        if not self.mutable(): return -1
        self.destination_module_authority.reserve_text_range(count)
    me set_destination_module_text_range_at(handle: i64,offset: i64,value: text) -> bool:
        self.mutable() and self.destination_module_authority.set_text_range_at(handle,offset,value)
    me publish_destination_module_text_range(handle: i64) -> bool:
        self.mutable() and self.destination_module_authority.publish_text_range(handle)
    me publish_destination_module_authority(module_index: i64,source_key: text,peer_key: text,layer_path: text,parent_facade_key: text,package_path: text,facades: i64,friends: i64) -> i64:
        if not self.mutable() or module_index<0 or module_index>=self.module_count or self.module_ready[module_index]: self.destination_module_authority.error=true; self.fail("HIR destination module authority rejected"); return -1
        val row=self.destination_module_authority.publish(module_index,source_key,peer_key,layer_path,parent_facade_key,package_path,facades,friends)
        if row<0: self.fail("HIR destination module authority conflict")
        row
    me publish_destination_member(module_index: i64,owner: i64,name: text,ordinal: i64,symbol: i64,has_type: bool,type_index: i64,has_default: bool,default_expr: i64,volatile_value: bool,has_bits: bool,bits: i64,has_address: bool,address: i64,span: i64) -> i64:
        val member_symbol_row=self.destination_symbols.building_lookup(module_index,symbol,self.generation)
        val owner_row=self.destination_symbols.building_lookup(module_index,owner,self.generation)
        if not self.mutable() or module_index<0 or module_index>=self.module_count or owner_row<0 or not self.destination_nominal_owner_kind(self.destination_symbols.kind[owner_row]) or member_symbol_row<0 or self.destination_symbols.module_index[member_symbol_row]!=module_index or self.destination_symbols.owner_symbol[member_symbol_row]!=owner or self.destination_symbols.name[member_symbol_row]!=name or self.destination_symbols.has_type[member_symbol_row]!=has_type or self.destination_symbols.type_index[member_symbol_row]!=type_index or (has_type and not self.index_ready(HD_RANGE_TYPE,type_index)) or (not has_type and type_index!=-1) or (has_default and not self.index_ready(HD_RANGE_EXPR,default_expr)) or (not has_default and default_expr!=-1) or not self.span_valid(span,self.generation): self.destination_members.error=true; self.fail("HIR destination member authority rejected"); return -1
        val row=self.destination_members.publish(module_index,owner,name,ordinal,symbol,has_type,type_index,has_default,default_expr,volatile_value,has_bits,bits,has_address,address,span)
        if row<0: self.fail("HIR destination member publication conflict")
        row
    me stage_destination_member(module_index: i64,owner: i64,name: text,symbol: i64,has_type: bool,type_index: i64,has_default: bool,default_expr: i64,volatile_value: bool,has_bits: bool,bits: i64,has_address: bool,address: i64,span: i64) -> i64:
        val member_symbol_row=self.destination_symbols.building_lookup(module_index,symbol,self.generation)
        val owner_row=self.destination_symbols.building_lookup(module_index,owner,self.generation)
        if not self.mutable() or module_index<0 or module_index>=self.module_count or owner_row<0 or not self.destination_nominal_owner_kind(self.destination_symbols.kind[owner_row]) or member_symbol_row<0 or self.destination_symbols.module_index[member_symbol_row]!=module_index or self.destination_symbols.owner_symbol[member_symbol_row]!=owner or self.destination_symbols.name[member_symbol_row]!=name or self.destination_symbols.has_type[member_symbol_row]!=has_type or self.destination_symbols.type_index[member_symbol_row]!=type_index or (has_type and not self.index_ready(HD_RANGE_TYPE,type_index)) or (not has_type and type_index!=-1) or (has_default and not self.index_ready(HD_RANGE_EXPR,default_expr)) or (not has_default and default_expr!=-1) or not self.span_valid(span,self.generation): self.destination_members.error=true; self.fail("HIR destination staged member authority rejected"); return -1
        val row=self.destination_members.stage(module_index,owner,name,symbol,has_type,type_index,has_default,default_expr,volatile_value,has_bits,bits,has_address,address,span)
        if row<0: self.fail("HIR destination member staging conflict")
        row
    me drain_destination_members() -> bool:
        if not self.mutable(): return false
        if not self.destination_members.drain_staged(): self.fail("HIR destination grouped member drain failed"); return false
        true
    me destination_visibility_allows_building(owner_module: i64,requester_module: i64,visibility: i64) -> bool:
        self.mutable() and self.destination_module_authority.visibility_allows(owner_module,requester_module,visibility,self.generation,false)
    me resolve_destination_member_from_symbol(module_index: i64,base_symbol: i64,name: text) -> i64:
        if not self.mutable() or name=="": return -1
        val base_row=self.destination_symbols.building_lookup(module_index,base_symbol,self.generation)
        if base_row<0 or not self.destination_symbols.has_type[base_row]: return -1
        val type_row=self.destination_symbols.type_index[base_row]
        if not self.index_ready(HD_RANGE_TYPE,type_row) or self.type_shape[type_row]!=HD_TYPE_NAMED: return -1
        val nominal_owner=self.type_i0[type_row]
        val defining_module=self.type_i1[type_row]
        val owner_row=self.destination_symbols.building_lookup(defining_module,nominal_owner,self.generation)
        if nominal_owner<0 or owner_row<0 or not self.destination_nominal_owner_kind(self.destination_symbols.kind[owner_row]): return -1
        val published=self.destination_members.building_lookup_name_noalloc(defining_module,nominal_owner,name,self.generation)
        if published>=0: return published
        val staged=self.destination_members.staged_lookup_name(defining_module,nominal_owner,name,self.generation)
        if staged>=0: HD_STAGED_MEMBER_HANDLE_BASE+staged else: -1

export HirDestinationGraph, HD_STAGED_MEMBER_HANDLE_BASE
