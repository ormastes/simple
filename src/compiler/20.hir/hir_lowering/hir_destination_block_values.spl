# Closed, compile-owned BlockValue projection tables.
#
# No BlockValue aggregate, Any, runtime regex handle, callback, or pointer is
# retained. Legacy Custom(type_name, Any) must keep Any rooted at its boundary,
# obtain a scalar codec receipt, and project synchronously with these writers.
# A missing/mismatched codec receipt fails closed.

const HD_BV_EXPR: i64 = 1
const HD_BV_LOSS: i64 = 2
const HD_BV_NOGRAD: i64 = 3
const HD_BV_RAW: i64 = 4
const HD_BV_SHELL: i64 = 5
const HD_BV_SHELL_COMMAND: i64 = 6
const HD_BV_REDIRECT: i64 = 7
const HD_BV_SQL: i64 = 8
const HD_BV_SQL_PARAM: i64 = 9
const HD_BV_REGEX: i64 = 10
const HD_BV_JSON_NULL: i64 = 11
const HD_BV_JSON_BOOL: i64 = 12
const HD_BV_JSON_NUMBER: i64 = 13
const HD_BV_JSON_STRING: i64 = 14
const HD_BV_JSON_ARRAY: i64 = 15
const HD_BV_JSON_OBJECT: i64 = 16
const HD_BV_JSON_FIELD: i64 = 17
const HD_BV_MARKDOWN: i64 = 18
const HD_BV_MD_HEADING: i64 = 19
const HD_BV_MD_PARAGRAPH: i64 = 20
const HD_BV_MD_CODE: i64 = 21
const HD_BV_MD_LIST: i64 = 22
const HD_BV_MD_QUOTE: i64 = 23
const HD_BV_MD_RULE: i64 = 24
const HD_BV_MD_TABLE: i64 = 25
const HD_BV_MD_TABLE_ROW: i64 = 26
const HD_BV_TEXT: i64 = 27
const HD_BV_GRAPH: i64 = 28
const HD_BV_GRAPH_NODE: i64 = 29
const HD_BV_GRAPH_EDGE: i64 = 30
const HD_BV_CUSTOM: i64 = 31
const HD_BV_ERROR: i64 = 32

class HirDestinationBlockValueStore:
    generation: i64 = -1
    frozen: bool = false
    error: bool = false
    count: i64 = 0
    capacity: i64 = 0
    ready: [bool] = []
    shape: [i64] = []
    i0: [i64] = []
    i1: [i64] = []
    i2: [i64] = []
    i3: [i64] = []
    b0: [bool] = []
    b1: [bool] = []
    t0: [text] = []
    t1: [text] = []
    f0: [f64] = []
    r0_start: [i64] = []
    r0_len: [i64] = []
    r1_start: [i64] = []
    r1_len: [i64] = []
    row_projection: [i64] = []
    codec_count: i64 = 0
    codec_type: [text] = []
    codec_generation: [i64] = []
    codec_ready: [bool] = []
    projection_count: i64 = 0
    projection_type: [text] = []
    projection_codec: [i64] = []
    projection_nonce: [i64] = []
    projection_source_generation: [i64] = []
    projection_active: [bool] = []
    projection_consumed: [bool] = []
    projection_row_floor: [i64] = []
    active_projection: i64 = -1

    me begin(g: i64) -> bool:
        # Only HirDestinationGraph.begin_compile calls this after its published
        # function-token lifetime gate permits generation reuse.
        if g < 0: return false
        var i = 0
        while i < self.t0.len(): self.t0[i] = ""; self.t1[i] = ""; i = i + 1
        i = 0; while i < self.codec_type.len(): self.codec_type[i] = ""; self.codec_ready[i] = false; self.codec_generation[i] = -1; i = i + 1
        i = 0; while i < self.projection_type.len(): self.projection_type[i] = ""; self.projection_active[i] = false; self.projection_consumed[i] = true; i = i + 1
        self.generation = g; self.frozen = false; self.error = false; self.count = 0; self.codec_count = 0; self.projection_count = 0; self.active_projection = -1; true

    me protocol_fail() -> bool:
        self.error = true
        false
    me protocol_fail_index() -> i64:
        self.error = true
        -1

    fn can_rollback(rows: i64, codecs: i64, projections: i64) -> bool:
        not self.frozen and rows >= 0 and rows <= self.count and codecs >= 0 and codecs <= self.codec_count and projections >= 0 and projections <= self.projection_count

    me rollback(rows: i64, codecs: i64, projections: i64, old_error: bool) -> bool:
        if not self.can_rollback(rows, codecs, projections): return false
        var i = rows
        while i < self.count:
            self.ready[i] = false; self.shape[i] = 0; self.i0[i] = -1; self.i1[i] = -1; self.i2[i] = -1; self.i3[i] = -1
            self.b0[i] = false; self.b1[i] = false; self.t0[i] = ""; self.t1[i] = ""; self.f0[i] = 0.0
            self.r0_start[i] = -1; self.r0_len[i] = 0; self.r1_start[i] = -1; self.r1_len[i] = 0; self.row_projection[i] = -1; i = i + 1
        i = codecs; while i < self.codec_count: self.codec_ready[i] = false; self.codec_type[i] = ""; self.codec_generation[i] = -1; i = i + 1
        i = projections; while i < self.projection_count: self.projection_active[i] = false; self.projection_consumed[i] = true; i = i + 1
        self.count = rows; self.codec_count = codecs; self.projection_count = projections; self.error = old_error; self.active_projection = -1
        i = 0
        while i < projections:
            if self.projection_active[i] and not self.projection_consumed[i]: self.active_projection = i
            i = i + 1
        true

    me ensure(required: i64):
        if required <= self.capacity: return
        var target = if self.capacity < 8: 8 else: self.capacity
        while target < required: target = target * 2
        while self.ready.len() < target:
            self.ready.push(false); self.shape.push(0)
            self.i0.push(-1); self.i1.push(-1); self.i2.push(-1); self.i3.push(-1)
            self.b0.push(false); self.b1.push(false); self.t0.push(""); self.t1.push(""); self.f0.push(0.0)
            self.r0_start.push(-1); self.r0_len.push(0); self.r1_start.push(-1); self.r1_len.push(0)
            self.row_projection.push(-1)
        self.capacity = target

    me reserve() -> i64:
        if self.frozen or self.generation < 0: return -1
        val row = self.count; self.ensure(row + 1)
        self.ready[row] = false; self.shape[row] = 0
        self.i0[row] = -1; self.i1[row] = -1; self.i2[row] = -1; self.i3[row] = -1
        self.b0[row] = false; self.b1[row] = false; self.t0[row] = ""; self.t1[row] = ""; self.f0[row] = 0.0
        self.r0_start[row] = -1; self.r0_len[row] = 0; self.r1_start[row] = -1; self.r1_len[row] = 0
        self.row_projection[row] = self.active_projection
        self.count = row + 1; row

    me range_ready(start: i64, len: i64, expected: i64) -> bool:
        if len == 0: return start == -1
        if start < 0 or len < 0 or start + len > self.count: return false
        var o = 0
        while o < len:
            if not self.ready[start + o] or (expected != 0 and self.shape[start + o] != expected): return false
            o = o + 1
        true

    me writable(row: i64) -> bool: not self.frozen and row >= 0 and row < self.count and not self.ready[row]
    me publish(row: i64, s: i64) -> bool:
        if not self.writable(row) or s < HD_BV_EXPR or s > HD_BV_ERROR: return false
        self.shape[row] = s; self.ready[row] = true; true

    me write_expr(row: i64, expr: i64) -> bool:
        if not self.writable(row) or expr < 0: return false
        self.i0[row] = expr; self.publish(row, HD_BV_EXPR)
    me write_loss(row: i64, block: i64) -> bool:
        if not self.writable(row) or block < 0: return false
        self.i0[row] = block; self.publish(row, HD_BV_LOSS)
    me write_nograd(row: i64, block: i64) -> bool:
        if not self.writable(row) or block < 0: return false
        self.i0[row] = block; self.publish(row, HD_BV_NOGRAD)
    me write_raw(row: i64, raw: text) -> bool:
        if not self.writable(row):
            return false
        self.t0[row] = raw
        self.publish(row, HD_BV_RAW)
    me write_text(row: i64, value: text) -> bool:
        if not self.writable(row):
            return false
        self.t0[row] = value
        self.publish(row, HD_BV_TEXT)

    # Shell command ranges contain command rows; pipe_to is an explicit optional
    # command index, so pipelines are lossless without recursive aggregates.
    me write_shell(row: i64, raw: text, commands: i64, count_: i64) -> bool:
        if not self.writable(row) or not self.range_ready(commands, count_, HD_BV_SHELL_COMMAND): return false
        self.t0[row] = raw; self.r0_start[row] = commands; self.r0_len[row] = count_; self.publish(row, HD_BV_SHELL)
    me write_shell_command(row: i64, program: text, args: i64, arg_count: i64, redirects: i64, redirect_count: i64, has_pipe: bool, pipe_to: i64) -> bool:
        if not self.writable(row) or program == "" or not self.range_ready(args, arg_count, HD_BV_TEXT) or not self.range_ready(redirects, redirect_count, HD_BV_REDIRECT): return false
        if has_pipe and (pipe_to < 0 or pipe_to >= self.count or not self.ready[pipe_to] or self.shape[pipe_to] != HD_BV_SHELL_COMMAND): return false
        if not has_pipe and pipe_to != -1: return false
        self.t0[row] = program; self.r0_start[row] = args; self.r0_len[row] = arg_count
        self.r1_start[row] = redirects; self.r1_len[row] = redirect_count; self.b0[row] = has_pipe; self.i0[row] = pipe_to
        self.publish(row, HD_BV_SHELL_COMMAND)
    me write_redirect(row: i64, kind: i64, target: text) -> bool:
        if not self.writable(row) or kind < 0 or kind > 4 or target == "": return false
        self.i0[row] = kind; self.t0[row] = target; self.publish(row, HD_BV_REDIRECT)

    me write_sql(row: i64, raw: text, kind: i64, tables: i64, table_count: i64, columns: i64, column_count: i64, params: i64, param_count: i64) -> bool:
        if not self.writable(row) or kind < 0 or kind > 7 or not self.range_ready(tables, table_count, HD_BV_TEXT) or not self.range_ready(columns, column_count, HD_BV_TEXT) or not self.range_ready(params, param_count, HD_BV_SQL_PARAM): return false
        self.t0[row] = raw; self.i0[row] = kind; self.r0_start[row] = tables; self.r0_len[row] = table_count
        self.r1_start[row] = columns; self.r1_len[row] = column_count; self.i1[row] = params; self.i2[row] = param_count; self.publish(row, HD_BV_SQL)
    me write_sql_param(row: i64, name: text, position: i64) -> bool:
        if not self.writable(row) or name == "" or position < 0: return false
        self.t0[row] = name; self.i0[row] = position; self.publish(row, HD_BV_SQL_PARAM)
    me write_regex(row: i64, raw: text) -> bool:
        if not self.writable(row): return false
        self.t0[row] = raw; self.publish(row, HD_BV_REGEX)

    me write_json_scalar(row: i64, kind: i64, boolean: bool, number: f64, string: text) -> bool:
        if not self.writable(row) or kind < HD_BV_JSON_NULL or kind > HD_BV_JSON_STRING: return false
        self.b0[row] = if kind == HD_BV_JSON_BOOL: boolean else: false
        self.f0[row] = if kind == HD_BV_JSON_NUMBER: number else: 0.0
        self.t0[row] = if kind == HD_BV_JSON_STRING: string else: ""; self.publish(row, kind)
    me write_json_array(row: i64, values: i64, count_: i64) -> bool:
        if not self.writable(row) or not self.range_ready(values, count_, 0): return false
        var o = 0; while o < count_: if self.shape[values + o] < HD_BV_JSON_NULL or self.shape[values + o] > HD_BV_JSON_OBJECT: return false else: o = o + 1
        self.r0_start[row] = values; self.r0_len[row] = count_; self.publish(row, HD_BV_JSON_ARRAY)
    me write_json_field(row: i64, name: text, value: i64) -> bool:
        if not self.writable(row) or value < 0 or value >= self.count or not self.ready[value] or self.shape[value] < HD_BV_JSON_NULL or self.shape[value] > HD_BV_JSON_OBJECT: return false
        self.t0[row] = name; self.i0[row] = value; self.publish(row, HD_BV_JSON_FIELD)
    me write_json_object(row: i64, fields: i64, count_: i64) -> bool:
        if not self.writable(row) or not self.range_ready(fields, count_, HD_BV_JSON_FIELD): return false
        self.r0_start[row] = fields; self.r0_len[row] = count_; self.publish(row, HD_BV_JSON_OBJECT)

    me write_markdown(row: i64, raw: text, blocks: i64, count_: i64) -> bool:
        if not self.writable(row) or not self.range_ready(blocks, count_, 0): return false
        var o = 0; while o < count_: if self.shape[blocks + o] < HD_BV_MD_HEADING or self.shape[blocks + o] > HD_BV_MD_TABLE: return false else: o = o + 1
        self.t0[row] = raw; self.r0_start[row] = blocks; self.r0_len[row] = count_; self.publish(row, HD_BV_MARKDOWN)
    me write_markdown_block(row: i64, kind: i64, level: i64, ordered: bool, text0: text, text1: text, values: i64, count_: i64, rows: i64, row_count: i64) -> bool:
        if not self.writable(row) or kind < HD_BV_MD_HEADING or kind > HD_BV_MD_TABLE: return false
        if (kind == HD_BV_MD_LIST or kind == HD_BV_MD_TABLE) and not self.range_ready(values, count_, HD_BV_TEXT): return false
        if kind == HD_BV_MD_TABLE and not self.range_ready(rows, row_count, HD_BV_MD_TABLE_ROW): return false
        if kind == HD_BV_MD_HEADING and level < 1: return false
        self.i0[row] = level; self.b0[row] = ordered; self.t0[row] = text0; self.t1[row] = text1
        self.r0_start[row] = values; self.r0_len[row] = count_; self.r1_start[row] = rows; self.r1_len[row] = row_count; self.publish(row, kind)
    me write_markdown_table_row(row: i64, cells: i64, count_: i64) -> bool:
        if not self.writable(row) or not self.range_ready(cells, count_, HD_BV_TEXT): return false
        self.r0_start[row] = cells; self.r0_len[row] = count_; self.publish(row, HD_BV_MD_TABLE_ROW)

    me write_graph(row: i64, raw: text, kind: i64, nodes: i64, node_count: i64, edges: i64, edge_count: i64) -> bool:
        if not self.writable(row) or kind < 0 or kind > 6 or not self.range_ready(nodes, node_count, HD_BV_GRAPH_NODE) or not self.range_ready(edges, edge_count, HD_BV_GRAPH_EDGE): return false
        self.t0[row] = raw; self.i0[row] = kind; self.r0_start[row] = nodes; self.r0_len[row] = node_count
        self.r1_start[row] = edges; self.r1_len[row] = edge_count; self.publish(row, HD_BV_GRAPH)
    me write_graph_node(row: i64, id: text, has_label: bool, label: text, has_shape: bool, shape_text_row: i64) -> bool:
        if not self.writable(row) or id == "" or (not has_label and label != ""): return false
        if has_shape and (shape_text_row < 0 or shape_text_row >= self.count or not self.ready[shape_text_row] or self.shape[shape_text_row] != HD_BV_TEXT): return false
        if not has_shape and shape_text_row != -1: return false
        self.t0[row] = id; self.t1[row] = label; self.b0[row] = has_label; self.b1[row] = has_shape; self.i0[row] = shape_text_row
        self.publish(row, HD_BV_GRAPH_NODE)
    me write_graph_edge(row: i64, source: text, target: text, has_label: bool, label_row: i64, has_style: bool, style_row: i64) -> bool:
        if not self.writable(row) or source == "" or target == "": return false
        if has_label and (label_row < 0 or label_row >= self.count or not self.ready[label_row] or self.shape[label_row] != HD_BV_TEXT): return false
        if has_style and (style_row < 0 or style_row >= self.count or not self.ready[style_row] or self.shape[style_row] != HD_BV_TEXT): return false
        if (not has_label and label_row != -1) or (not has_style and style_row != -1): return false
        self.t0[row] = source; self.t1[row] = target; self.b0[row] = has_label; self.b1[row] = has_style; self.i0[row] = label_row; self.i1[row] = style_row
        self.publish(row, HD_BV_GRAPH_EDGE)

    me register_codec(type_name: text) -> i64:
        if self.frozen or type_name == "": return self.protocol_fail_index()
        var i = 0; while i < self.codec_count: if self.codec_type[i] == type_name: return self.protocol_fail_index() else: i = i + 1
        if self.codec_count == self.codec_type.len(): self.codec_type.push(""); self.codec_generation.push(-1); self.codec_ready.push(false)
        val receipt = self.codec_count; self.codec_type[receipt] = type_name; self.codec_generation[receipt] = self.generation; self.codec_ready[receipt] = true
        self.codec_count = receipt + 1; receipt
    me begin_projection(codec: i64, type_name: text, nonce: i64, source_generation: i64) -> i64:
        if self.frozen or self.active_projection != -1 or nonce < 0 or source_generation < 0 or codec < 0 or codec >= self.codec_count or not self.codec_ready[codec] or self.codec_type[codec] != type_name: return self.protocol_fail_index()
        val token = self.projection_count
        if token == self.projection_type.len():
            self.projection_type.push(""); self.projection_codec.push(-1); self.projection_nonce.push(-1); self.projection_source_generation.push(-1)
            self.projection_active.push(false); self.projection_consumed.push(false); self.projection_row_floor.push(-1)
        self.projection_type[token] = type_name; self.projection_codec[token] = codec; self.projection_nonce[token] = nonce
        self.projection_source_generation[token] = source_generation; self.projection_active[token] = true; self.projection_consumed[token] = false; self.projection_row_floor[token] = self.count
        self.projection_count = token + 1; self.active_projection = token; token
    me commit_custom(row: i64, token: i64, nonce: i64, source_generation: i64, projection_root: i64) -> bool:
        if not self.writable(row) or token < 0 or token >= self.projection_count or not self.projection_active[token] or self.projection_consumed[token]: return self.protocol_fail()
        if self.projection_nonce[token] != nonce or self.projection_source_generation[token] != source_generation or projection_root < self.projection_row_floor[token] or projection_root >= self.count or not self.ready[projection_root] or self.row_projection[projection_root] != token: return self.protocol_fail()
        self.t0[row] = self.projection_type[token]; self.i0[row] = self.projection_codec[token]; self.i1[row] = projection_root
        self.projection_active[token] = false; self.projection_consumed[token] = true; self.active_projection = -1; self.publish(row, HD_BV_CUSTOM)
    me abort_projection(token: i64, nonce: i64, source_generation: i64) -> bool:
        if token < 0 or token >= self.projection_count or not self.projection_active[token] or self.projection_consumed[token] or self.projection_nonce[token] != nonce or self.projection_source_generation[token] != source_generation: return self.protocol_fail()
        self.projection_active[token] = false; self.projection_consumed[token] = true; self.active_projection = -1; true
    me write_error(row: i64, message: text) -> bool:
        if not self.writable(row) or message == "": return false
        self.t0[row] = message; self.publish(row, HD_BV_ERROR)
    me can_freeze() -> bool:
        if self.error: return false
        var p = 0; while p < self.projection_count: if self.projection_active[p]: return false else: p = p + 1
        var i = 0; while i < self.count: if not self.ready[i]: return false else: i = i + 1
        true
    me freeze() -> bool:
        if not self.can_freeze(): return false
        self.frozen = true; true
    me commit_freeze():
        self.frozen = true

    me shape_at(row: i64, g: i64) -> i64: if self.frozen and g == self.generation and row >= 0 and row < self.count and self.ready[row]: self.shape[row] else: 0
    me i64_at(row: i64, g: i64, col: i64) -> i64: if self.shape_at(row,g) == 0: -1 else if col == 0: self.i0[row] else if col == 1: self.i1[row] else if col == 2: self.i2[row] else if col == 3: self.i3[row] else: -1
    me bool_at(row: i64, g: i64, col: i64) -> bool: self.shape_at(row,g) != 0 and (if col == 0: self.b0[row] else if col == 1: self.b1[row] else: false)
    me text_at(row: i64, g: i64, col: i64) -> text: if self.shape_at(row,g) == 0: "" else if col == 0: self.t0[row] else if col == 1: self.t1[row] else: ""
    me f64_at(row: i64, g: i64) -> f64: if self.shape_at(row,g) == HD_BV_JSON_NUMBER: self.f0[row] else: 0.0
    me range_at(row: i64, g: i64, second: bool) -> i64: if self.shape_at(row,g) == 0: -1 else if second: self.r1_start[row] else: self.r0_start[row]
    me range_len_at(row: i64, g: i64, second: bool) -> i64: if self.shape_at(row,g) == 0: -1 else if second: self.r1_len[row] else: self.r0_len[row]
    me capacity_bytes_estimate() -> i64: self.capacity * 144 + self.codec_type.len() * 32 + self.projection_type.len() * 72
    me text_payload_bytes() -> i64:
        var total = 0; var i = 0
        while i < self.t0.len(): total = total + self.t0[i].len() + self.t1[i].len(); i = i + 1
        i = 0; while i < self.codec_type.len(): total = total + self.codec_type[i].len(); i = i + 1
        i = 0; while i < self.projection_type.len(): total = total + self.projection_type[i].len(); i = i + 1
        total

export HirDestinationBlockValueStore
export HD_BV_EXPR, HD_BV_LOSS, HD_BV_NOGRAD, HD_BV_RAW, HD_BV_SHELL, HD_BV_SHELL_COMMAND, HD_BV_REDIRECT
export HD_BV_SQL, HD_BV_SQL_PARAM, HD_BV_REGEX, HD_BV_JSON_NULL, HD_BV_JSON_BOOL, HD_BV_JSON_NUMBER, HD_BV_JSON_STRING
export HD_BV_JSON_ARRAY, HD_BV_JSON_OBJECT, HD_BV_JSON_FIELD, HD_BV_MARKDOWN, HD_BV_MD_HEADING, HD_BV_MD_PARAGRAPH
export HD_BV_MD_CODE, HD_BV_MD_LIST, HD_BV_MD_QUOTE, HD_BV_MD_RULE, HD_BV_MD_TABLE, HD_BV_MD_TABLE_ROW, HD_BV_TEXT
export HD_BV_GRAPH, HD_BV_GRAPH_NODE, HD_BV_GRAPH_EDGE, HD_BV_CUSTOM, HD_BV_ERROR
