use compiler.hir.sffi_identity.{sffi_raw_callable_effects}

impl HirLowering:
    me prescan_composite_field_types(name: text, fields: [ParserField], type_params: [ParserTypeParam]):
        """Register parser struct/class fields before function lowering."""
        # Field annotations use the declaration's generic scope even during
        # this early pass. Do not leak its binders into sibling declarations.
        val saved_parameters = self.prescan_type_parameters
        self.prescan_type_parameters = {}
        self.symbols.push_scope(ScopeKind.Class)
        for tp in type_params:
            val parameter = self.lower_type_param(tp)
            self.prescan_type_parameters[parameter.symbol.id] = HirType(
                kind: HirTypeKind.TypeParam(parameter.name, parameter.bounds),
                span: parameter.span)
        var field_types: Dict<text, HirType> = {}
        var field_order: [text] = []
        for raw_field in fields:
            val field: HirField = raw_field
            field_types[field.name] = self.lower_type(field.type_)
            field_order = field_order.push(field.name)
        self.symbols.pop_scope()
        self.prescan_type_parameters = saved_parameters
        self.struct_field_types_by_name[name] = field_types
        self.struct_field_order_by_name[name] = field_order
        # MODULE-QUALIFIED KEY (2026-08-24). The bare name is NOT a unique key:
        # two modules may declare the same composite name, and the second
        # registration silently overwrites the first, so every field read
        # against the loser resolves through the winner's field set and the
        # WHOLE field set reads as invisible. Measured in the stage-3 self-host
        # run: `JitInstantiator` is declared by both
        # `src/compiler/99.loader/jit_instantiator.spl` and
        # `src/compiler/99.loader/loader/jit_instantiator.spl` (drifted copies,
        # same field NAMES, different field TYPES), producing 83 of the 405 HIR
        # lowering fatals.
        #
        # The consumer side already prefers a module-qualified key --
        # `field_type_for_owner_raw` (expression_support.spl) builds
        # `defining_module + "." + name` and only falls back to the bare name
        # when that key is absent -- and the IMPORT path already registers one
        # (`module_import_registration.spl`, `canonical_composite_name`). Local
        # declarations were the only writer that never registered it, so the
        # lookup always fell back to the colliding bare key.
        #
        # `declare_module_symbols` passes `self.module_filename` as the symbol's
        # `defining_module`, so that is the spelling the reader reconstructs;
        # it must be used verbatim here or the key will not be found.
        # Purely ADDITIVE: the bare key above is still written, so any consumer
        # that has no owner symbol (and therefore cannot build the qualified
        # key) keeps resolving exactly as before.
        if self.module_filename != "":
            self.struct_field_types_by_name[self.module_filename + "." + name] = field_types
            self.struct_field_order_by_name[self.module_filename + "." + name] = field_order

    # Nested-field-access support (native --entry path bug, see
    # struct_field_types_by_name doc comment in types.spl): record this
    # struct's field NAME -> declared HirType, purely from the static
    # declaration (`struct S: arr: [i64]`), independent of any inference.
    # Used later by Field-expr lowering to give a chained/array/struct-typed
    # field access its real MIR type instead of the untyped-path's i64
    # default (which silently reads garbage for a non-i64 field, e.g. an
    # array field indexed on the native path).
    me register_struct_field_types(hir_struct: HirStruct):
        var field_types: Dict<text, HirType> = {}
        for raw_f in hir_struct.fields:
            # ANY-transport hazard sweep round 3: annotated rebind.
            val f: HirField = raw_f
            field_types[f.name] = f.type_
        self.struct_field_types_by_name[hir_struct.name] = field_types
        # Module-qualified key -- see the rationale on the twin write in
        # `prescan_composite_field_types` above. Same reason, same spelling,
        # same additive stance: the bare key is still written.
        if self.module_filename != "":
            self.struct_field_types_by_name[self.module_filename + "." + hir_struct.name] = field_types

    # Untyped-return inference (native --entry path) -- see the `ReturnScan`
    # doc comment in lowering_helpers.spl for the full rationale. Runs over
    # the raw parser AST (`ParserFunction.body`), NOT the HIR, because it has to
    # happen during this module's up-front signature-declaration pass --
    # before ANY function body is lowered -- so a caller elsewhere in the
    # module sees the promoted return type too, not just the callee's own
    # generated `ret` instruction.
    me infer_untyped_return_type(fn_decl: ParserFunction) -> HirType:
        val fn_body: Block = fn_decl.body
        val fn_params: [Param] = fn_decl.params
        val scan = self.scan_ast_block_for_returns(fn_body, fn_params)
        if not scan.found_value_return:
            if val dynamic_tail = self.dynamic_callback_tail_type(fn_decl):
                return dynamic_tail
            return HirType(kind: HirTypeKind.Unit, span: fn_decl.span)
        if scan.ambiguous or not scan.resolved_name.?:
            if self.ambient_bootstrap_enabled():
                # The bootstrap route has no whole-program inference pass.
                # Preserve the value dynamically; Unit would discard it.
                return HirType(kind: HirTypeKind.Any, span: fn_decl.span)
            if not self.registering_import_symbols:
                self.error("untyped function returns a value: function '{fn_decl.name}' returns a value but declares no return type; add '-> T'", fn_decl.span)
            return HirType(kind: HirTypeKind.Unit, span: fn_decl.span)
        # if-val: .unwrap() is box-assuming and breaks flat optionals on the
        # stage4 native lane (bug doc 2026-07-23).
        if val rn = scan.resolved_name:
            return HirType(kind: hir_type_kind_from_simple_name(rn), span: fn_decl.span)
        return HirType(kind: HirTypeKind.Unit, span: fn_decl.span)

    me declared_callable_type(fn_decl: ParserFunction, owner_symbol: SymbolId?) -> HirType?:
        # Generic callables keep the existing untyped-symbol behavior until
        # monomorphization supplies a concrete signature.
        if fn_decl.type_params.len() > 0:
            return nil
        # ParserImport/sibling registration is fail-soft: signature diagnostics
        # (untyped returns, param types unlowerable in the importer's
        # context) belong to the defining module's own pass. Register the
        # symbol untyped instead of erroring the importing module.
        if self.registering_import_symbols:
            return nil

        var param_types: [HirType] = []
        val raw_params = fn_decl.params
        var first_raw_param = 0
        match owner_symbol:
            case Some(owner_id):
                if not fn_decl.is_static:
                    param_types.push(HirType(
                        kind: HirTypeKind.Named(owner_id, []),
                        span: fn_decl.span
                    ))
                    if raw_params.len() > 0:
                        val receiver_param: Param = raw_params[0]
                        if receiver_param.name == "self" or receiver_param.name == "me":
                            first_raw_param = 1
            case None:
                ()
        while first_raw_param < raw_params.len():
            val raw_param: Param = raw_params[first_raw_param]
            # `Param.type_` is a DESUGARED optional paired with `has_type_`: an
            # untyped parameter leaves it nil, and `lower_type(nil)` traps in
            # types.spl (`val lt_kind: TypeKind = lt.kind` -> "undefined field
            # 'kind' ... type 'nil'", with no span). An untyped param means we
            # cannot form a complete DECLARED signature, so bail to nil exactly
            # like the generic/import cases above and the sibling
            # `declared_surface_callable_type` below.
            if not raw_param.has_type_:
                # Only publish the dynamic signature when the body proves an
                # Any callback tail. Other undeclared signatures retain their
                # existing inference path.
                if self.dynamic_callback_function_type(fn_decl) == nil:
                    return nil
                val callback_type = self.dynamic_callback_param_type(fn_decl, raw_param)
                param_types.push(callback_type ?? HirType(kind: HirTypeKind.Any, span: raw_param.span))
            else:
                val raw_param_type: Type = raw_param.type_
                param_types.push(self.lower_type(raw_param_type))
            first_raw_param = first_raw_param + 1

        val return_type = if fn_decl.has_return_type:
            val declared_return_type: Type = fn_decl.return_type
            self.lower_type(declared_return_type)
        else:
            self.infer_untyped_return_type(fn_decl)
        val callable_type = HirType(
            kind: HirTypeKind.Function(
                param_types,
                return_type,
                sffi_raw_callable_effects(fn_decl.is_extern, fn_decl.span)),
            span: fn_decl.span
        )
        # Bare-lift: an explicit `Some(...)` tail in a `-> HirType?` function
        # allocates a heap Option BOX on the native lane instead of lifting the
        # bare value into the optional slot (same defect the 2026-07-23
        # bare-lift notes describe in module_declarations_bootstrap.spl:433).
        # The box then lands in `HirSymbol.type_`, and every consumer that
        # reads it AS a HirType -- notably the generated HIR-cache encoder
        # `hc_enc_hir_type` -- reads the box header as `.kind` and the box's
        # second word as `.span`, untags that non-pointer and dereferences it:
        # deterministic SIGSEGV on `native-build` of any program (bug
        # hir_cache_encode_segv_some_box_in_symbol_type_2026-08-23).
        # The sibling `declared_surface_callable_type` below already returns the
        # bare value from its `-> HirType?` tail; match it.
        callable_type

    me declared_surface_callable_type(callable: ModuleSurfaceCallable, owner_symbol: SymbolId?) -> HirType?:
        if callable.type_params.len() > 0:
            return nil
        # A bodyless extern with no arrow has a complete Unit return contract;
        # retaining its callable type is required for imported alias authority.
        # Ordinary untyped functions keep the existing inference path.
        if not callable.has_return_type and not callable.is_extern:
            return nil
        if self.registering_import_symbols:
            return nil
        var param_types: [HirType] = []
        var param_idx = 0
        match owner_symbol:
            case Some(owner_id):
                if not callable.is_static:
                    param_types = param_types.push(HirType(kind: HirTypeKind.Named(owner_id, []), span: callable.span))
                    if callable.params.len() > 0:
                        val receiver = callable.params[0]
                        if receiver.name == "self" or receiver.name == "me":
                            param_idx = 1
            case None:
                ()
        while param_idx < callable.params.len():
            if not callable.params[param_idx].has_type_:
                return nil
            param_types = param_types.push(self.lower_type(callable.params[param_idx].type_))
            param_idx = param_idx + 1
        val return_type = if callable.has_return_type:
            self.lower_type(callable.return_type)
        else:
            HirType(kind: HirTypeKind.Unit, span: callable.span)
        HirType(
            kind: HirTypeKind.Function(
                param_types,
                return_type,
                sffi_raw_callable_effects(callable.is_extern, callable.span)),
            span: callable.span)

    me imported_surface_type(type_: Type, imported_module_name: text) -> HirType:
        val source_name = parser_type_kind_named_name(type_.kind)
        if source_name != "":
            val instance_errors_before = self.errors.len()
            var arguments: [HirType] = []
            for argument in parser_type_kind_named_args(type_.kind):
                arguments = arguments.push(self.imported_surface_type(argument, imported_module_name))
            # Owner binders shadow same-spelled module declarations.
            val parameter_symbol = self.symbols.lookup_or_invalid(source_name)
            if parameter_symbol.is_valid() and self.prescan_type_parameters.contains_key(parameter_symbol.id):
                return HirType(kind: self.lower_named_symbol_kind(parameter_symbol, arguments, type_.span), span: type_.span)
            val raw_symbol_id = self.symbols.lookup_qualified_type_raw(
                imported_module_name, source_name)
            if raw_symbol_id >= 0:
                return HirType(kind: self.lower_named_symbol_kind(SymbolId(id: raw_symbol_id), arguments, type_.span), span: type_.span)
            # SINGLETON-DECLARER REPAIR (cycle-37 endgame, doc
            # compiler_cli_unresolved_mirtype_chase_nondeterminism_2026-10-13,
            # outcome c): the qualified lookup in the callable owner's scope
            # missed, but the frozen registry knows EXACTLY ONE surface that
            # declares this name (probe evidence: `[strict-gate] name=...
            # decl_count=1 decl_first=<owner>` immediately before a hard
            # `unresolved type`). The declaring surface was present and
            # declaring, yet it was never materialized into THIS importer's
            # symbol table. Do that lazily, exactly as
            # materialize_imported_callable_declared_dependency does:
            # qualified local `{owner}::{name}`, register, qualified bind,
            # then retry the raw lookup under the same qualifier. Deliberately
            # conservative: only when the initial lookup failed AND the
            # declarer is unique; anything else falls through to the
            # historical behavior below, unchanged.
            val singleton_owners = self.surface_decl_owner_indices(source_name)
            if singleton_owners.len() == 1:
                val singleton_surface = self.module_surfaces.surfaces[singleton_owners[0]]
                val singleton_local = "{singleton_surface.module_name}::{source_name}"
                self.register_imported_symbol(
                    singleton_surface.physical_index, singleton_surface.module_name,
                    source_name, singleton_local, type_.span, false)
                val singleton_symbol = self.symbols.lookup_or_invalid(singleton_local)
                if singleton_symbol.is_valid():
                    self.symbols.bind_qualified_type(
                        singleton_surface.module_name, source_name, singleton_symbol)
                    val retry_symbol_id = self.symbols.lookup_qualified_type_raw(
                        singleton_surface.module_name, source_name)
                    if retry_symbol_id >= 0:
                        return HirType(kind: self.lower_named_symbol_kind(SymbolId(id: retry_symbol_id), arguments, type_.span), span: type_.span)
            # Level-gated OWNER probe (default off). This fall-through hands the
            # type to `lower_type`, which resolves in the IMPORTER's scope; the
            # resulting `unresolved type: X` carries a SYNTHESIZED span
            # (span_file empty, line 0) and is attributed to the importer, so
            # nothing in the diagnostic names the owner whose surface asked for
            # it. `[ist-proj-miss]` does not cover this path -- it fires only in
            # `imported_surface_type_projected` -- which is why HirModule and
            # LocalId produced zero probe lines of any kind.
            if hir_type_env_get("SIMPLE_HIR_UNRESOLVED_TYPE_TRACE") == "1":
                eprint("[ist-scalar-fallthrough] name={source_name} owner={imported_module_name} lowering={self.module_filename}")
            return HirType(kind: self.named_instance_kind_or_any(source_name, arguments, type_.span, instance_errors_before), span: type_.span)
        # COMPOSITE shapes must be projected ELEMENTWISE.
        #
        # Only a TOP-LEVEL Named type used to be projected through the
        # declaring module's qualified scope; every composite shape fell
        # straight to `lower_type`, which resolves names in the IMPORTER's
        # scope. Cross-module signature dependencies are materialized under
        # the QUALIFIED local name `{module}::{name}` (see
        # `materialize_imported_callable_declared_dependency`), never the bare
        # one, so the importer's scope does not have them -- and the fallback
        # landed on the hard, non-recovered `unresolved type: {name}`,
        # attributed to whichever module was being lowered rather than to the
        # type's owner.
        #
        # Stage 1 hit this as `unresolved type: ResolveError` against
        # src/compiler/80.driver/driver.spl, which never names ResolveError:
        # `resolve_methods` (src/compiler/35.semantics/resolve.spl:775) returns
        # the TUPLE `(HirModule, [ResolveError])`. Because it is a tuple,
        # neither `return_type_name` nor `return_array_element_name` is
        # populated, so both scalar projections in
        # `imported_surface_type_projected` were skipped. The same signature
        # written as a bare `[ResolveError]` always worked, which is why the
        # defect looked type-specific rather than SHAPE-specific.
        # See doc/08_tracking/bug/hir_tuple_signature_dependency_unprojected_2026-08-21.md
        val tuple_elements = parser_type_kind_tuple_elements(type_.kind)
        if tuple_elements.len() > 0:
            var lowered_elements: [HirType] = []
            for element in tuple_elements:
                lowered_elements = lowered_elements.push(
                    self.imported_surface_type(element, imported_module_name))
            return HirType(kind: HirTypeKind.Tuple(lowered_elements), span: type_.span)
        # Pointer / Union / Function are composite shapes the MATERIALIZATION
        # walk (`parser_type_named_dependencies`, 10.frontend/parser_types_expr.spl)
        # binds dependencies for and this projection walk used to drop. Each
        # dropped shape fell through to `lower_type`, which resolves in the
        # IMPORTER's scope, and died as a hard `unresolved type: X` blamed on an
        # innocent importer. The arms landed once and were lost with the
        # src/compiler restore in fcbec1c3b62; restored elementwise here, next
        # to the current name-based Array arm rather than replacing it.
        # Ratcheted by scripts/check/check-type-walk-constructor-parity.shs.
        # Optional payloads also belong to the declaring module. Never reuse
        # the outer node as the accessor fallback: that would recurse forever.
        if parser_type_kind_is_optional(type_.kind):
            val invalid_inner = Type(kind: TypeKind.Error, span: type_.span)
            val inner = parser_type_kind_optional_inner(type_.kind, invalid_inner)
            match inner.kind:
                case TypeKind.Error:
                    self.error("invalid imported Optional payload type", type_.span)
                    return HirType(kind: HirTypeKind.Error, span: type_.span)
                case _: pass
            return HirType(
                kind: HirTypeKind.Optional(self.imported_surface_type(inner, imported_module_name)),
                span: type_.span)
        # A borrowed parameter's inner type belongs to the declaring module,
        # just like a pointer's pointee. Falling through to lower_type would
        # instead look up that name in the importing module's scope.
        if parser_type_kind_is_reference(type_.kind):
            val referent = parser_type_kind_reference_inner(type_.kind, type_)
            return HirType(
                kind: HirTypeKind.Ref(
                    self.imported_surface_type(referent, imported_module_name),
                    parser_type_kind_reference_is_mutable(type_.kind)),
                span: type_.span)
        if parser_type_kind_is_pointer(type_.kind):
            val pointee = parser_type_kind_pointer_inner(type_.kind, type_)
            return HirType(
                kind: HirTypeKind.Ptr(
                    self.imported_surface_type(pointee, imported_module_name),
                    parser_type_kind_pointer_is_mutable(type_.kind)),
                span: type_.span)
        val union_members = parser_type_kind_union_members(type_.kind)
        if union_members.len() > 0:
            var projected_members: [HirType] = []
            for member in union_members:
                projected_members = projected_members.push(
                    self.imported_surface_type(member, imported_module_name))
            return HirType(kind: HirTypeKind.Union(projected_members), span: type_.span)
        val array_element_name = parser_type_kind_array_element_name(type_.kind)
        if array_element_name != "":
            val source_element = parser_type_kind_array_element(type_.kind, type_)
            val element = self.imported_surface_type(source_element, imported_module_name)
            return HirType(kind: HirTypeKind.Array(element, nil), span: type_.span)
        # ARRAY WHOSE ELEMENT IS NOT A PLAIN NAMED TYPE must still be projected
        # ELEMENTWISE. The branch above is keyed on
        # `parser_type_kind_array_element_name`, which answers "" for BOTH "not
        # an array" and "an array of something that is not a bare Named" --
        # `[(text, MirType)]`, `[[T]]`, `[T?]`. So an array-of-TUPLE fell past
        # it to `lower_type`, which resolves names in the IMPORTER's scope,
        # where a cross-module signature dependency is bound only as
        # `{owner}::{name}`.
        # See doc/08_tracking/bug/hir_unresolved_type_owner_missing_import_2026-08-22.md
        if parser_type_kind_is_array(type_.kind):
            val nested_element = parser_type_kind_array_element(type_.kind, type_)
            return HirType(
                kind: HirTypeKind.Array(
                    self.imported_surface_type(nested_element, imported_module_name),
                    nil),
                span: type_.span)
        if parser_type_kind_is_function(type_.kind):
            var projected_params: [HirType] = []
            for fn_param in parser_type_kind_function_params(type_.kind):
                projected_params = projected_params.push(
                    self.imported_surface_type(fn_param, imported_module_name))
            return HirType(
                kind: HirTypeKind.Function(
                    projected_params,
                    self.imported_surface_type(
                        parser_type_kind_function_return(type_.kind, type_),
                        imported_module_name),
                    []),
                span: type_.span)
        # Level-gated OWNER probe (default off) on the CATCH-ALL fall-through --
        # the shape that matched none of the projected constructors. Same
        # rationale as the scalar probe above: without it the importer-scope
        # failure is anonymous.
        if hir_type_env_get("SIMPLE_HIR_UNRESOLVED_TYPE_TRACE") == "1":
            eprint("[ist-catchall-fallthrough] owner={imported_module_name} lowering={self.module_filename}")
        self.lower_type(type_)

    me imported_surface_type_projected(type_: Type, type_name: text, array_element_name: text, imported_module_name: text) -> HirType:
        # Prefer scalar projections captured before the parser Type crossed a
        # nested Dict/array boundary.  The retained Type remains the complete
        # fallback for shapes not yet affected by the staged-native ABI bug.
        if type_name != "":
            val instance_errors_before = self.errors.len()
            var arguments: [HirType] = []
            for argument in parser_type_kind_named_args(type_.kind):
                arguments = arguments.push(self.imported_surface_type(argument, imported_module_name))
            # Owner binders shadow same-spelled module declarations.
            val parameter_symbol = self.symbols.lookup_or_invalid(type_name)
            if parameter_symbol.is_valid() and self.prescan_type_parameters.contains_key(parameter_symbol.id):
                return HirType(kind: self.lower_named_symbol_kind(parameter_symbol, arguments, type_.span), span: type_.span)
            val raw_symbol_id = self.symbols.lookup_qualified_type_raw(
                imported_module_name, type_name)
            if raw_symbol_id >= 0:
                return HirType(kind: self.lower_named_symbol_kind(SymbolId(id: raw_symbol_id), arguments, type_.span), span: type_.span)
            # `has_X` is the optional sugar for `X?`; the surface records it
            # verbatim. Project the BASE through the owner's qualified scope
            # before falling back, otherwise lower_named_kind strips the
            # prefix and looks `X` up unqualified in the consumer, where the
            # materialized dependency is not bound (stage-1 run9:
            # `unresolved type: GpuIntrinsicKind` blamed on zero-import
            # package siblings of gpu_intrinsics.spl).
            if type_name.starts_with("has_") and type_name.len() > 4:
                val optional_parameter = self.symbols.lookup_or_invalid(type_name[4:])
                if optional_parameter.is_valid() and self.prescan_type_parameters.contains_key(optional_parameter.id):
                    val parameter_type = HirType(kind: self.lower_named_symbol_kind(optional_parameter, [], type_.span), span: type_.span)
                    return HirType(kind: HirTypeKind.Optional(parameter_type), span: type_.span)
                val has_symbol_id = self.symbols.lookup_qualified_type_raw(
                    imported_module_name, type_name[4:])
                if has_symbol_id >= 0:
                    return HirType(kind: HirTypeKind.Optional(HirType(kind: self.lower_named_symbol_kind(SymbolId(id: has_symbol_id), [], type_.span), span: type_.span)), span: type_.span)
            if hir_type_env_get("SIMPLE_HIR_UNRESOLVED_TYPE_TRACE") == "1":
                eprint("[ist-proj-miss] name={type_name} owner={imported_module_name} lowering={self.module_filename}")
            return HirType(kind: self.named_instance_kind_or_any(type_name, arguments, type_.span, instance_errors_before), span: type_.span)
        if array_element_name != "":
            val source_element = parser_type_kind_array_element(type_.kind, type_)
            val element = self.imported_surface_type(source_element, imported_module_name)
            return HirType(kind: HirTypeKind.Array(element, nil), span: type_.span)
        self.imported_surface_type(type_, imported_module_name)

    me declared_imported_owner_callable_type(callable: ModuleSurfaceCallable, imported_module_name: text, owner_symbol: SymbolId, owner_type_params: [ParserTypeParam]) -> HirType?:
        # Owner binders belong to the imported declaration, not the importer.
        # Restore the scope before its method symbol is defined, so that symbol
        # remains visible after this temporary binder scope is popped.
        if owner_type_params.len() == 0:
            return self.declared_imported_surface_callable_type(
                callable, imported_module_name, Some(owner_symbol))
        val saved_parameters = self.prescan_type_parameters
        self.prescan_type_parameters = {}
        self.symbols.push_scope(ScopeKind.Class)
        self.project_imported_owner_type_parameters(owner_type_params, imported_module_name)
        val callable_type = self.declared_imported_surface_callable_type(
            callable, imported_module_name, Some(owner_symbol))
        self.symbols.pop_scope()
        self.prescan_type_parameters = saved_parameters
        callable_type

    # Caller owns the temporary Class scope and has materialized dependencies.
    # Shared by imported composite fields and imported method signatures.
    me project_imported_owner_type_parameters(owner_type_params: [ParserTypeParam], imported_module_name: text) -> [HirTypeParam]:
        var owner_symbols: [SymbolId] = []
        # Reserve EVERY binder before projecting any constraint/default. Self
        # and forward references must be TypeParam, never importer Named rows.
        for raw_tp in owner_type_params:
            # ANY-transport hazard sweep round 3: annotated rebind.
            val tp: ParserTypeParam = raw_tp
            val symbol = self.symbols.define(tp.name, SymbolKind.TypeParam, nil,
                tp.span, Visibility.Private, false, nil)
            owner_symbols = owner_symbols.push(symbol)
            self.prescan_type_parameters[symbol.id] = HirType(
                kind: HirTypeKind.TypeParam(tp.name, []), span: tp.span)
        var parameters: [HirTypeParam] = []
        var parameter_index = 0
        for raw_tp in owner_type_params:
            val tp: ParserTypeParam = raw_tp
            var bounds: [HirType] = []
            for bound in tp.bounds:
                bounds = bounds.push(self.imported_surface_type(bound, imported_module_name))
            val default_ = if tp.has_default:
                self.imported_surface_type(tp.default, imported_module_name)
            else:
                HirType(kind: HirTypeKind.Unit, span: tp.span)
            parameters = parameters.push(HirTypeParam(symbol: owner_symbols[parameter_index],
                name: tp.name, bounds: bounds, has_default: tp.has_default,
                default: default_, span: tp.span))
            parameter_index = parameter_index + 1
        # Publish together: constraint references remain finite binder leaves,
        # independent of declaration order, including mutually recursive bounds.
        for raw_parameter in parameters:
            # ANY-transport hazard sweep round 3: annotated rebind.
            val parameter: HirTypeParam = raw_parameter
            self.prescan_type_parameters[parameter.symbol.id] = HirType(
                kind: HirTypeKind.TypeParam(parameter.name, parameter.bounds),
                span: parameter.span)
        parameters

    me declared_imported_surface_callable_type(callable: ModuleSurfaceCallable, imported_module_name: text, owner_symbol: SymbolId?) -> HirType?:
        if callable.type_params.len() > 0:
            return nil
        # A bodyless extern with no arrow has a complete Unit return contract;
        # retaining its callable type is required for imported alias authority.
        if not callable.has_return_type and not callable.is_extern:
            return nil
        var param_types: [HirType] = []
        var param_idx = 0
        if val owner_id = owner_symbol:
            if not callable.is_static:
                param_types = param_types.push(HirType(kind: HirTypeKind.Named(owner_id, []), span: callable.span))
                if callable.params.len() > 0:
                    val receiver = callable.params[0]
                    if receiver.name == "self" or receiver.name == "me":
                        param_idx = 1
        while param_idx < callable.params.len():
            if not callable.params[param_idx].has_type_:
                return nil
            val param: ModuleSurfaceParam = callable.params[param_idx]
            param_types = param_types.push(self.imported_surface_type_projected(
                param.type_, param.type_name, param.array_element_name, imported_module_name))
            param_idx = param_idx + 1
        val return_type = if callable.has_return_type:
            self.imported_surface_type_projected(
                callable.return_type,
                callable.return_type_name,
                callable.return_array_element_name,
                imported_module_name)
        else:
            HirType(kind: HirTypeKind.Unit, span: callable.span)
        HirType(
            kind: HirTypeKind.Function(
                param_types,
                return_type,
                sffi_raw_callable_effects(callable.is_extern, callable.span)),
            span: callable.span)

    me imported_surface_projected_name_type(shape: text, type_name: text, imported_module_name: text, span: Span) -> HirType?:
        if shape != "named" and shape != "named_array":
            return nil
        val raw_symbol_id = self.symbols.lookup_qualified_type_raw(
            imported_module_name, type_name)
        var element: HirType = HirType(kind: HirTypeKind.Error, span: span)
        if raw_symbol_id >= 0:
            element = HirType(
                kind: HirTypeKind.Named(SymbolId(id: raw_symbol_id), []),
                span: span)
        else:
            element = HirType(
                kind: self.lower_named_kind(type_name, [], span), span: span)
        var projected: HirType = element
        if shape == "named_array":
            projected = HirType(
                kind: HirTypeKind.Array(element, nil), span: span)
        Some(projected)

    me dynamic_callback_tail_type(fn_decl: ParserFunction) -> HirType?:
        if fn_decl.has_return_type:
            return nil
        if self.dynamic_callback_function_type(fn_decl) != nil:
            return HirType(kind: HirTypeKind.Any, span: fn_decl.span)
        nil

    me dynamic_callback_param_type(fn_decl: ParserFunction, param: Param) -> HirType?:
        if param.has_type_ or param.has_default:
            return nil
        if val callback_type = self.dynamic_callback_function_type(fn_decl):
            val tail_expr: Expr = rt_enum_payload(fn_decl.body.stmts[0].kind)
            match tail_expr.kind:
                case ExprKind.Call(callee, _):
                    match callee.kind:
                        case ExprKind.Ident(name):
                            if name == param.name: return callback_type
                        case _: ()
                case _: ()
        nil

    me dynamic_callback_function_type(fn_decl: ParserFunction) -> HirType?:
        # A default-Any parameter used as a callee has a dynamic Any result.
        # Do not guess the result of named/typed callees, or override explicit
        # returns with a tail-only decision.
        if self.ambient_bootstrap_enabled() or fn_decl.body.stmts.len() != 1:
            return nil
        for raw_param in fn_decl.params:
            val param: Param = raw_param
            if not param.has_type_ and param.has_default:
                return nil
        if fn_decl.has_return_type:
            if self.lower_type(fn_decl.return_type).kind == HirTypeKind.Unit:
                return nil
        val scan = self.scan_ast_block_for_returns(fn_decl.body, fn_decl.params)
        if scan.found_value_return:
            return nil
        val tail = fn_decl.body.stmts[fn_decl.body.stmts.len() - 1]
        val probe = Expr(kind: ExprKind.NilLit, span: tail.span)
        if rt_enum_discriminant(tail.kind) != rt_enum_discriminant(StmtKind.Expr(probe)):
            return nil
        val tail_expr: Expr = rt_enum_payload(tail.kind)
        match tail_expr.kind:
            case ExprKind.Call(callee, args):
                match callee.kind:
                    case ExprKind.Ident(name):
                        for raw_param in fn_decl.params:
                            val param: Param = raw_param
                            if param.name == name and not param.has_type_ and not param.has_default:
                                var argument_types: [HirType] = []
                                for raw_arg in args:
                                    val arg: HirCallArg = raw_arg
                                    if arg.has_name: return nil
                                    argument_types = argument_types.push(HirType(kind: HirTypeKind.Any, span: arg.span))
                                return HirType(kind: HirTypeKind.Function(argument_types, HirType(kind: HirTypeKind.Any, span: tail.span), []), span: tail.span)
                    case _: ()
            case _: ()
        nil

    me infer_simple_type_name_ast(e: Expr, params: [Param]) -> text?:
        match e.kind:
            case ExprKind.IntLit(_):
                Some("i64")
            case ExprKind.FloatLit(_):
                Some("f64")
            case ExprKind.FloatLexeme(_):
                Some("f64")
            case ExprKind.StringLit(_, _):
                Some("text")
            case ExprKind.BoolLit(_):
                Some("bool")
            case ExprKind.Ident(name):
                var i = 0
                var found: HirType? = nil
                while i < params.len():
                    val param: Param = params[i]
                    if param.name == name:
                        found = self.lower_type(param.type_)
                    i = i + 1
                var found_name: text? = nil
                if val found_t = found:
                    found_name = hir_type_simple_name(found_t)
                found_name
            case ExprKind.Unary(op, operand):
                match op:
                    case UnaryOp.Not:
                        Some("bool")
                    case UnaryOp.Neg:
                        self.infer_simple_type_name_ast(operand, params)
                    case _:
                        nil
            case ExprKind.Binary(op, left, right):
                if ast_binop_is_comparison(op):
                    Some("bool")
                elif ast_binop_is_arith(op):
                    val lt = self.infer_simple_type_name_ast(left, params)
                    val rt = self.infer_simple_type_name_ast(right, params)
                    var arith_name: text? = nil
                    if val lt_v = lt:
                        if val rt_v = rt:
                            if lt_v == rt_v and hir_simple_type_name_is_known(lt_v):
                                arith_name = lt
                    arith_name
                else:
                    nil
            case ExprKind.Cast(_, target):
                hir_type_simple_name(self.lower_type(target))
            case _:
                # Anything else (a call, index, field access, struct/enum
                # literal, ...) is deliberately left un-inferred here rather
                # than guessed at -- this also conservatively covers a
                # self-recursive call: `return f(...)` (whether or not `f`
                # is the function being scanned) always resolves to `nil`,
                # which `merge_return_scan` turns into `ambiguous`, which
                # `infer_untyped_return_type` turns into the fatal route-(b)
                # error instead of a silently-wrong return type.
                nil

    me scan_ast_block_for_returns(b: Block, params: [Param]) -> ReturnScan:
        var acc = return_scan_empty()
        for raw_stmt in b.stmts:
            # ANY-transport hazard sweep round 3: annotated rebind. Unannotated,
            # the stage2-compiled compiler read erased Stmt words here and the
            # p2_add smoke SEGV'd inside scan_ast_expr_for_returns (cycle-60
            # stage2 sanity, minimal repro).
            val stmt: Stmt = raw_stmt
            acc = merge_return_scan(acc, self.scan_ast_stmt_for_returns(stmt, params))
        acc

    me scan_ast_stmt_for_returns(s: Stmt, params: [Param]) -> ReturnScan:
        # `Expr` is also a struct name. On the pure-Simple stage4 path a broad
        # match can treat this arm as irrefutable and pass the enum's raw tuple
        # payload to scan_ast_expr_for_returns. Dispatch by discriminant first.
        val nil_expr = Expr(kind: ExprKind.NilLit, span: s.span)
        val expr_stmt_disc = rt_enum_discriminant(StmtKind.Expr(nil_expr))
        val stmt_kind = s.kind
        val stmt_disc = rt_enum_discriminant(stmt_kind)
        if stmt_disc >= 0 and stmt_disc == expr_stmt_disc:
            val expr: Expr = rt_enum_payload(stmt_kind)
            return self.scan_ast_expr_for_returns(expr, params)
        match s.kind:
            case StmtKind.Val(_, _, init):
                self.scan_ast_expr_for_returns(init, params)
            case StmtKind.Var(_, _, init):
                var var_scan = return_scan_empty()
                if val init_e = init:
                    var_scan = self.scan_ast_expr_for_returns(init_e, params)
                var_scan
            case StmtKind.Assign(target, _, value):
                merge_return_scan(self.scan_ast_expr_for_returns(target, params), self.scan_ast_expr_for_returns(value, params))
            case StmtKind.Return(value):
                var ret_scan = return_scan_empty()
                if val v = value:
                    ret_scan = ReturnScan(found_value_return: true, resolved_name: self.infer_simple_type_name_ast(v, params), ambiguous: false)
                ret_scan
            case StmtKind.For(_, iter, body):
                merge_return_scan(self.scan_ast_expr_for_returns(iter, params), self.scan_ast_block_for_returns(body, params))
            case StmtKind.While(cond, body):
                merge_return_scan(self.scan_ast_expr_for_returns(cond, params), self.scan_ast_block_for_returns(body, params))
            case StmtKind.Loop(body):
                self.scan_ast_block_for_returns(body, params)
            case StmtKind.Yield(value):
                var yield_scan = return_scan_empty()
                if val yv = value:
                    yield_scan = self.scan_ast_expr_for_returns(yv, params)
                yield_scan
            case StmtKind.Throw(value):
                self.scan_ast_expr_for_returns(value, params)
            case StmtKind.With(_, body):
                self.scan_ast_block_for_returns(body, params)
            case _:
                return_scan_empty()

    # Walks reachable sub-expressions looking for `return <value>` sites,
    # EXCEPT inside a nested `Lambda` body (its own function scope -- a
    # `return` inside one belongs to the closure, not this function). Rare
    # shapes fall through to `case _` (no descent): under-covering here is
    # conservative, not unsound -- a `return` hidden in an unhandled shape is
    # exactly as broken as it already was before this change (the
    # pre-existing Unit-return default is unchanged), so it cannot regress a
    # working case.
    me scan_ast_expr_for_returns(e: Expr, params: [Param]) -> ReturnScan:
        # The signature-declaration pass runs before expression lowering and
        # must not turn a parser's absent expression payload into a native
        # receiver fault.  Treat it like every other unhandled expression:
        # no return is inferred.  This guard is deliberately local to the
        # conservative scanner; the actual HIR lowering still reports a
        # missing expression at its normal diagnostic boundary.
        if e == nil:
            return return_scan_empty()
        match e.kind:
            case ExprKind.Return(value):
                var ret_scan = return_scan_empty()
                if val v = value:
                    ret_scan = ReturnScan(found_value_return: true, resolved_name: self.infer_simple_type_name_ast(v, params), ambiguous: false)
                ret_scan
            case ExprKind.If(cond, then_, else_):
                var acc = merge_return_scan(self.scan_ast_expr_for_returns(cond, params), self.scan_ast_block_for_returns(then_, params))
                if val else_b = else_:
                    acc = merge_return_scan(acc, self.scan_ast_block_for_returns(else_b, params))
                acc
            case ExprKind.IfChain(arms, else_):
                var acc = return_scan_empty()
                for raw_arm in arms:
                    val arm: IfArm = raw_arm
                    acc = merge_return_scan(acc, self.scan_ast_expr_for_returns(arm.cond, params))
                    acc = merge_return_scan(acc, self.scan_ast_block_for_returns(arm.then_, params))
                if val else_b = else_:
                    acc = merge_return_scan(acc, self.scan_ast_block_for_returns(else_b, params))
                acc
            case ExprKind.MatchCase(scrutinee, arms):
                var acc = self.scan_ast_expr_for_returns(scrutinee, params)
                for raw_arm in arms:
                    val arm: MatchArm = raw_arm
                    acc = merge_return_scan(acc, self.scan_ast_block_for_returns(arm.body, params))
                    if arm.has_guard:
                        acc = merge_return_scan(acc, self.scan_ast_expr_for_returns(arm.guard, params))
                acc
            case ExprKind.TryCatch(body, clauses, finally_):
                var acc = self.scan_ast_block_for_returns(body, params)
                for raw_clause in clauses:
                    val clause: CatchClause = raw_clause
                    acc = merge_return_scan(acc, self.scan_ast_block_for_returns(clause.body, params))
                if val fin_b = finally_:
                    acc = merge_return_scan(acc, self.scan_ast_block_for_returns(fin_b, params))
                acc
            case ExprKind.Block(block):
                self.scan_ast_block_for_returns(block, params)
            case ExprKind.LossBlock(body):
                self.scan_ast_block_for_returns(body, params)
            case ExprKind.NogradBlock(body):
                self.scan_ast_block_for_returns(body, params)
            case ExprKind.UnsafeBlock(body, _):
                self.scan_ast_block_for_returns(body, params)
            case ExprKind.Lambda(_, _):
                return_scan_empty()
            case ExprKind.Binary(_, left, right):
                merge_return_scan(self.scan_ast_expr_for_returns(left, params), self.scan_ast_expr_for_returns(right, params))
            case ExprKind.Unary(_, operand):
                self.scan_ast_expr_for_returns(operand, params)
            case ExprKind.Call(callee, args):
                var acc = self.scan_ast_expr_for_returns(callee, params)
                for raw_a in args:
                    val a: HirCallArg = raw_a
                    acc = merge_return_scan(acc, self.scan_ast_expr_for_returns(a.value, params))
                acc
            case ExprKind.MethodCall(receiver, _, args):
                var acc = self.scan_ast_expr_for_returns(receiver, params)
                for raw_a in args:
                    val a: HirCallArg = raw_a
                    acc = merge_return_scan(acc, self.scan_ast_expr_for_returns(a.value, params))
                acc
            case ExprKind.Cast(expr, _):
                self.scan_ast_expr_for_returns(expr, params)
            case ExprKind.Index(base, index):
                merge_return_scan(self.scan_ast_expr_for_returns(base, params), self.scan_ast_expr_for_returns(index, params))
            case ExprKind.Field(base, _):
                self.scan_ast_expr_for_returns(base, params)
            case ExprKind.OptionalChain(base, _):
                self.scan_ast_expr_for_returns(base, params)
            case ExprKind.NullCoalesce(left, right):
                merge_return_scan(self.scan_ast_expr_for_returns(left, params), self.scan_ast_expr_for_returns(right, params))
            case ExprKind.ExistsCheck(base):
                self.scan_ast_expr_for_returns(base, params)
            case ExprKind.ForceUnwrap(base):
                self.scan_ast_expr_for_returns(base, params)
            case ExprKind.Range(start, end, _, step):
                var acc = return_scan_empty()
                if val start_e = start:
                    acc = merge_return_scan(acc, self.scan_ast_expr_for_returns(start_e, params))
                if val end_e = end:
                    acc = merge_return_scan(acc, self.scan_ast_expr_for_returns(end_e, params))
                if val step_e = step:
                    acc = merge_return_scan(acc, self.scan_ast_expr_for_returns(step_e, params))
                acc
            case ExprKind.Await(expr):
                self.scan_ast_expr_for_returns(expr, params)
            case ExprKind.Yield(value):
                var yield_scan = return_scan_empty()
                if val yv = value:
                    yield_scan = self.scan_ast_expr_for_returns(yv, params)
                yield_scan
            case ExprKind.Throw(value):
                self.scan_ast_expr_for_returns(value, params)
            case ExprKind.Try(expr):
                self.scan_ast_expr_for_returns(expr, params)
            case ExprKind.ArrayLit(elements):
                var acc = return_scan_empty()
                for el in elements:
                    acc = merge_return_scan(acc, self.scan_ast_expr_for_returns(el, params))
                acc
            case ExprKind.TupleLit(elements):
                var acc = return_scan_empty()
                for el in elements:
                    acc = merge_return_scan(acc, self.scan_ast_expr_for_returns(el, params))
                acc
            case ExprKind.SetLit(elements):
                var acc = return_scan_empty()
                for el in elements:
                    acc = merge_return_scan(acc, self.scan_ast_expr_for_returns(el, params))
                acc
            case ExprKind.ArrayRepeat(value, count):
                merge_return_scan(self.scan_ast_expr_for_returns(value, params), self.scan_ast_expr_for_returns(count, params))
            case ExprKind.Break(_):
                return_scan_empty()
            case _:
                return_scan_empty()
