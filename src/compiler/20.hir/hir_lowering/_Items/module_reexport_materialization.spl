# HIR item lowering - module, import, and bootstrap-flat lowering.
use compiler.hir.hir_lowering.hir_phase_profile.{hir_phase_profile_now, hir_phase_profile_add, hir_phase_profile_count_qtype, hir_phase_profile_count_explicit_scan, HIR_PROF_RIS_SIGTYPE, HIR_PROF_RIS_CALLABLE_DEPS, HIR_PROF_RIS_DECLARED_DEP, HIR_PROF_RIS_EXPLICIT_DEP, HIR_PROF_RIS_PAYLOAD, HIR_PROF_RIS_METHODS}
use compiler.hir.hir_lowering._Items.module_lowering.*
# HIR Lowering - Item Lowering
#
# This module handles lowering of top-level items (functions, classes, structs, enums, traits, impls) from AST to HIR.

use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.frontend.parser_types.*
use compiler.frontend.parser_types.{ParserFunction, ImportItem, Param}
use compiler.frontend.parser_types_expr.*
use compiler.frontend.flat_ast_bridge.{flat_bootstrap_function_count, flat_bootstrap_function_at, flat_bootstrap_function_decl_at}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.context_helpers.*
use compiler.hir.hir_lowering.module_surface.*
use compiler.hir.hir_lowering.module_surface_source_identity.{module_surface_package_name_from_name}
use compiler.hir.hir_lowering.expressions.*
use compiler.common.attributes.{parse_layout_attrs, parse_function_attrs, parse_export_attrs, parse_driver_manifest_attrs, parse_platform_attrs, parse_vhdl_hardware_attrs, vhdl_hardware_metadata_default, FunctionAttr, ExportAttr, DriverManifestAttr, DriverManifestAttrKind, VhdlHardwareMetadata}
use compiler.types.type_layout.{LayoutAttr, TypeLayoutKind, PlatformParseResult, PlatformDiagnosticLevel, PlatformLayoutDiagnostic}
use compiler.common.dependency.visibility.{Visibility}
use compiler.common.module_path_naming.{module_logical_name_from_path}
use compiler.core.ast.{decl_get_body, decl_get_name, decl_get_param_names, decl_get_param_types, decl_get_ret_type, STMT_EXPR, STMT_VAL_DECL, STMT_VAR_DECL, STMT_RETURN}
use compiler.core.ast_stmt.{stmt_get_tag, stmt_get_expr, stmt_get_name, stmt_get_type}

extern fn rt_enum_discriminant(value: Any) -> i64
extern fn rt_enum_payload(value: StmtKind) -> Expr
use compiler.core.ast.{EXPR_INT_LIT, EXPR_STRING_LIT, EXPR_INTERPOLATED_STRING, EXPR_BOOL_LIT, EXPR_NIL_LIT, EXPR_IDENT, EXPR_BINARY, EXPR_CALL, EXPR_FIELD_ACCESS, EXPR_METHOD_CALL, EXPR_BLOCK, EXPR_RETURN}
use compiler.core.ast_expr.{expr_get_tag, expr_get_int, expr_get_str, expr_get_left, expr_get_right, expr_get_args, expr_get_arg_names, expr_get_stmts}
use compiler.frontend.core._AstExpr.accessors.{expr_get_arg_names}
use compiler.core.tokens.{TOK_MINUS, TOK_STAR, TOK_SLASH, TOK_PERCENT, TOK_EQ, TOK_NOT_EQ, TOK_LT, TOK_LT_EQ, TOK_GT, TOK_GT_EQ}
use compiler.frontend.core.types.{TYPE_VOID, TYPE_BOOL, TYPE_I64, TYPE_TEXT, TYPE_DICT, custom_primitive_bind_symbol, custom_primitive_is_name}
use compiler.frontend.core.types.{is_dict_tag, dict_tag_to_id, dict_type_get_key, dict_type_get_value}
use compiler.frontend.core.types.{primitive_integer_bit_width_from_name, custom_primitive_integer_bit_width_by_name}
use compiler.core.types.{int_to_str}
use std.nogc_sync_mut.io.process_ops.{eprint}

impl HirLowering:
    me find_reexport_source_walk(
        facade_index: i64, wanted: text, depth: i64,
        state: HirReexportWalkState
    ) -> HirReexportSource:
        """Walk frozen physical routes without path normalization or splits."""
        if depth > 8:
            state.complete = false
            return HirReexportSource(found: false, module_index: -1, module_name: "", item_name: "")
        if facade_index < 0 or facade_index >= self.module_surfaces.surfaces.len():
            state.valid = false
            return HirReexportSource(found: false, module_index: -1, module_name: "", item_name: "")
        if not module_surface_route_arrays_aligned(self.module_surfaces.surfaces[facade_index]):
            state.valid = false
            return HirReexportSource(found: false, module_index: -1, module_name: "", item_name: "")
        if (state.surface_indices.len() != state.wanted_names.len() or
            state.surface_indices.len() != state.depths.len()):
            state.valid = false
            return HirReexportSource(found: false, module_index: -1, module_name: "", item_name: "")

        val visit_entry = hir_reexport_parallel_find(
            state.surface_indices, state.wanted_names,
            facade_index, wanted)
        if visit_entry >= 0:
            val seen_depth = state.depths[visit_entry]
            if seen_depth <= depth:
                return HirReexportSource(found: false, module_index: -1, module_name: "", item_name: "")
            state.depths[visit_entry] = depth
        else:
            state.surface_indices = state.surface_indices.push(facade_index)
            state.wanted_names = state.wanted_names.push(wanted)
            state.depths = state.depths.push(depth)

        self.reexport_chase_calls = self.reexport_chase_calls + 1
        self.report_reexport_chase_stats()
        val facade_mod = self.module_surfaces.surfaces[facade_index]
        val origin_index: ModuleSurfaceExportOriginIndex = facade_mod.export_origin_index
        val origin_lookup = module_surface_export_origin_index_lookup(origin_index, wanted)
        if origin_lookup.found:
            val origin_index_value = hir_module_surface_index(
                self.module_surfaces, origin_lookup.owner_module)
            if origin_index_value < 0 or
               origin_index_value >= self.module_surfaces.surfaces.len():
                state.valid = false
                return HirReexportSource(found: false, module_index: -1, module_name: "", item_name: "")
            return HirReexportSource(
                found: true,
                module_index: origin_index_value,
                module_name: self.module_surfaces.surfaces[origin_index_value].preferred_registry_name,
                item_name: origin_lookup.source_name)

        var import_idx = 0
        while import_idx < facade_mod.imports.len():
            val item_start = facade_mod.import_item_offsets[import_idx]
            val item_end = facade_mod.import_item_offsets[import_idx + 1]
            var matches = item_start == item_end
            var source_item = wanted
            var item_idx = item_start
            while item_idx < item_end:
                val item_name = facade_mod.import_item_names[item_idx]
                val local = if facade_mod.import_item_has_alias[item_idx]:
                    facade_mod.import_item_aliases[item_idx]
                else: item_name
                if local == wanted or item_name == wanted:
                    matches = true
                    source_item = item_name
                item_idx = item_idx + 1
            if matches and import_idx < facade_mod.import_target_indices.len():
                val next_index = facade_mod.import_target_indices[import_idx]
                if next_index >= 0 and next_index < self.module_surfaces.surfaces.len():
                    val next_mod = self.module_surfaces.surfaces[next_index]
                    if (rt_env_get("SIMPLE_BOOTSTRAP_DIAG") ?? "") == "1":
                        val next_declares = hir_module_declares_item(
                            next_mod, source_item)
                        eprint("[reexport-hop] facade={facade_mod.preferred_registry_name} wanted={wanted} import={import_idx} item_start={item_start} item_end={item_end} source_item={source_item} target={next_index} target_name={next_mod.preferred_registry_name} declares={next_declares} composites={next_mod.composite_names.len()} enums={next_mod.enum_names.len()} traits={next_mod.trait_names.len()} callables={next_mod.callable_names.len()} aliases={next_mod.type_alias_names.len()} constants={next_mod.constant_names.len()}")
                    if hir_module_declares_item(next_mod, source_item):
                        return HirReexportSource(
                            found: true,
                            module_index: next_index,
                            module_name: next_mod.preferred_registry_name,
                            item_name: source_item)
                    val deeper = self.find_reexport_source_walk(
                        next_index, source_item, depth + 1, state)
                    if deeper.found:
                        return deeper
            import_idx = import_idx + 1

        var route_index = 0
        while route_index < facade_mod.export_route_sources.len():
            val exp_source = facade_mod.export_route_sources[route_index]
            val exp_local = facade_mod.export_route_locals[route_index]
            if facade_mod.export_route_is_glob[route_index]:
                val sibling_index = facade_mod.export_route_target_indices[route_index]
                if sibling_index >= 0 and sibling_index < self.module_surfaces.surfaces.len():
                    val sibling = self.module_surfaces.surfaces[sibling_index]
                    if hir_module_declares_item(sibling, wanted):
                        return HirReexportSource(
                            found: true,
                            module_index: sibling_index,
                            module_name: sibling.preferred_registry_name,
                            item_name: wanted)
                    val deeper = self.find_reexport_source_walk(
                        sibling_index, wanted, depth + 1, state)
                    if deeper.found:
                        return deeper
            elif exp_local == wanted:
                # A QUALIFIED bare export (`export module.Name`) now records the
                # module its qualifier names as the route target
                # (module_surface_registry_index.spl). Follow that first: it is
                # an explicit route, so it needs neither the facade's own
                # declaration nor package-sibling inference.
                val route_target_index = facade_mod.export_route_target_indices[route_index]
                if route_target_index >= 0 and route_target_index < self.module_surfaces.surfaces.len() and route_target_index != facade_index:
                    val route_target = self.module_surfaces.surfaces[route_target_index]
                    if hir_module_declares_item(route_target, exp_source):
                        return HirReexportSource(
                            found: true,
                            module_index: route_target_index,
                            module_name: route_target.preferred_registry_name,
                            item_name: exp_source)
                    val routed = self.find_reexport_source_walk(
                        route_target_index, exp_source, depth + 1, state)
                    if routed.found:
                        return routed
                if hir_module_declares_item(facade_mod, exp_source):
                    return HirReexportSource(
                        found: true,
                        module_index: facade_index,
                        module_name: facade_mod.preferred_registry_name,
                        item_name: exp_source)
                if exp_source != wanted:
                    val alias_source = self.find_reexport_source_walk(
                        facade_index, exp_source, depth + 1, state)
                    if alias_source.found:
                        return alias_source
                else:
                    # BARE `export Name` -- no `use`, no `from`, no alias.
                    # module_surface_registry_index.spl:288-291 pushes target
                    # index -1 and target name "" for EVERY non-glob export
                    # item, so this form records no source module at all. The
                    # two attempts above cover only a facade that DECLARES the
                    # name itself and an aliased `export src:local`, which
                    # leaves the bare form resolving to nothing -- and the
                    # silent not-found resurfaced much later as a hard
                    # `unresolved type: {wanted}` (hir_lowering/types.spl)
                    # attributed to whichever module was being lowered, an
                    # innocent importer that never names the type.
                    #
                    # Stage 1 hit this as `unresolved type: CodegenTarget`
                    # against src/compiler/80.driver/driver_public_api.spl (a
                    # three-line `pub use` facade whose whole import closure has
                    # ZERO occurrences of the name): the route runs through
                    # src/compiler/70.backend/backend/__init__.spl:7, which
                    # spells the re-export as
                    # `export BackendKind, CodegenTarget, OptimizationLevel,
                    # BuildMode`. The same type re-exported as `export use
                    # ...backend_types.{CodegenTarget}` always resolved, which
                    # is why the defect looked type-specific rather than
                    # SHAPE-specific.
                    #
                    # Resolve it the only way the form can mean: the package
                    # sibling that physically DECLARES the name. Package
                    # siblings already see each other without an import edge
                    # (`resolve_package_sibling_symbols`), so this adds no new
                    # visibility -- it only follows a route the surface builder
                    # could not record. AMBIGUITY STAYS UNRESOLVED: if two
                    # siblings declare the same short name, return not-found
                    # rather than guess, matching the payload path's stance on
                    # package inference (`resolve_materialized_enum_payload_*`).
                    val facade_package = self.cached_surface_package_name(facade_mod.module_name)
                    if facade_package != "":
                        val sibling_names = self.package_sibling_registry_names(facade_package)
                        var sibling_match_index = -1
                        var sibling_match_count = 0
                        var sibling_idx = 0
                        while sibling_idx < sibling_names.len():
                            val sibling_index = hir_module_surface_index(
                                self.module_surfaces, sibling_names[sibling_idx])
                            if sibling_index >= 0 and
                               sibling_index < self.module_surfaces.surfaces.len() and
                               sibling_index != facade_index:
                                val sibling = self.module_surfaces.surfaces[sibling_index]
                                if hir_module_declares_item(sibling, wanted):
                                    if sibling_match_index != sibling_index:
                                        sibling_match_count = sibling_match_count + 1
                                        sibling_match_index = sibling_index
                                else:
                                    # A sibling that RE-EXPORTS the name (`export
                                    # use other.{Name}`) is an owner too: follow
                                    # it to its terminal and count that terminal
                                    # under the same uniqueness rule. Without
                                    # this the shape was only rescued by the
                                    # SIMPLE_BOOTSTRAP=1 unique-owner fallback.
                                    val via_sibling = self.find_reexport_source_walk(
                                        sibling_index, wanted, depth + 1, state)
                                    if via_sibling.found and
                                       sibling_match_index != via_sibling.module_index:
                                        sibling_match_count = sibling_match_count + 1
                                        sibling_match_index = via_sibling.module_index
                            sibling_idx = sibling_idx + 1
                        if sibling_match_count == 1 and sibling_match_index >= 0:
                            val terminal = self.module_surfaces.surfaces[sibling_match_index]
                            return HirReexportSource(
                                found: true,
                                module_index: sibling_match_index,
                                module_name: terminal.preferred_registry_name,
                                item_name: wanted)
            route_index = route_index + 1

        HirReexportSource(found: false, module_index: -1, module_name: "", item_name: "")

    me resolve_materialized_enum_payload_origin(imported_mod: ModuleSurface, imported_mod_name: text, dependency: text) -> HirMaterializedPayloadOrigin:
        """Resolve a payload spelling to its physical terminal declaration."""
        if hir_module_declares_item(imported_mod, dependency):
            val kind = hir_module_item_terminal_kind(imported_mod, dependency)
            return HirMaterializedPayloadOrigin(
                found: kind != "",
                module_name: hir_pkg_canonical_module_name(imported_mod.module_name),
                item_name: dependency,
                item_kind: kind,
                module_key: imported_mod_name)
        val hop = self.find_reexport_source(
            imported_mod.physical_index, dependency)
        if hop.found:
            val source_index = hop.module_index
            if source_index >= 0:
                val terminal = self.module_surfaces.surfaces[source_index]
                val kind = hir_module_item_terminal_kind(terminal, hop.item_name)
                if kind != "":
                    return HirMaterializedPayloadOrigin(
                        found: true,
                        module_name: hir_pkg_canonical_module_name(terminal.module_name),
                        item_name: hop.item_name,
                        item_kind: kind,
                        module_key: terminal.preferred_registry_name)
        # Step 3: an explicit named `use other.mod.{Dep}` written by the enum's
        # OWNER. The two steps above only cover a declaration in the owner
        # itself and a single `export use` re-export hop, so an owner that
        # reaches its payload type by a plain (non-exporting) `use` resolved to
        # nothing at all -- and the silent `return` in
        # `register_materialized_payload_named_dependency` turned that into a
        # later `unresolved type: {name}` attributed to whichever module
        # imported the ENUM, never to the owner. This mirrors the twin step in
        # `materialize_imported_callable_explicit_dependency`. Glob imports
        # stay excluded here: resolving them while recursively materializing
        # enum payloads corrupts staged native HIR state. Owners that expose a
        # payload dependency must name it explicitly; package inference also
        # stays excluded because the same short name can live in several
        # sibling modules and picking one would silently rewrite the payload
        # type.
        # See doc/08_tracking/bug/hir_enum_payload_blockvalue_unresolved_2026-08-21.md
        val explicit = self.resolve_materialized_enum_payload_explicit_import(
            imported_mod, dependency)
        if explicit.found:
            return explicit
        HirMaterializedPayloadOrigin(found: false, module_name: "", item_name: "", item_kind: "", module_key: "")

    me resolve_materialized_enum_payload_explicit_import(imported_mod: ModuleSurface, dependency: text) -> HirMaterializedPayloadOrigin:
        """Resolve `dependency` through an explicit named import of `imported_mod`."""
        var import_index: i64 = 0
        while import_index < imported_mod.imports.len() and
              import_index < imported_mod.import_target_indices.len():
            val target_index = imported_mod.import_target_indices[import_index]
            val item_start = imported_mod.import_item_offsets[import_index]
            val item_end = imported_mod.import_item_offsets[import_index + 1]
            var item_index: i64 = item_start
            while item_index < item_end:
                val item_name = imported_mod.import_item_names[item_index]
                val local_name = if imported_mod.import_item_has_alias[item_index]:
                    imported_mod.import_item_aliases[item_index]
                else: item_name
                if local_name == dependency and target_index >= 0 and
                   target_index < self.module_surfaces.surfaces.len():
                    val target = self.module_surfaces.surfaces[target_index]
                    if hir_module_declares_item(target, item_name):
                        val kind = hir_module_item_terminal_kind(target, item_name)
                        if kind != "":
                            return HirMaterializedPayloadOrigin(
                                found: true,
                                module_name: hir_pkg_canonical_module_name(target.module_name),
                                item_name: item_name,
                                item_kind: kind,
                                module_key: target.preferred_registry_name)
                    val hop = self.find_reexport_source(
                        target.physical_index, item_name)
                    if hop.found and hop.module_index >= 0:
                        val terminal = self.module_surfaces.surfaces[hop.module_index]
                        val hop_kind = hir_module_item_terminal_kind(terminal, hop.item_name)
                        if hop_kind != "":
                            return HirMaterializedPayloadOrigin(
                                found: true,
                                module_name: hir_pkg_canonical_module_name(terminal.module_name),
                                item_name: hop.item_name,
                                item_kind: hop_kind,
                                module_key: terminal.preferred_registry_name)
                item_index = item_index + 1
            import_index = import_index + 1
        HirMaterializedPayloadOrigin(found: false, module_name: "", item_name: "", item_kind: "", module_key: "")

    me claim_materialized_payload_binding(local_name: text, origin: HirMaterializedPayloadOrigin, import_span: Span) -> bool:
        val wanted = hir_payload_terminal_identity(origin.module_name, origin.item_name, origin.item_kind)
        if self.materialized_payload_bindings.contains_key(local_name):
            val existing = self.materialized_payload_bindings[local_name]
            if existing != wanted:
                # NOT an error. Two distinct declarations may legitimately
                # share one short name (aop::AdviceForm vs
                # weaving.advice_form::AdviceForm), and this table is keyed on
                # the short name, so the second claimant always loses the
                # unqualified slot. Report false and let the caller re-register
                # under the module-qualified local name; hard-failing here
                # poisoned whichever module happened to reach both owners.
                if (hir_module_env_get("SIMPLE_HIR_PAYLOAD_LOOKUP_TRACE") ?? "") == "1":
                    eprint("[hir-payload-shortname-taken] name={local_name} existing={existing} wanted={wanted}")
                return false
            return true
        val existing_id = self.symbols.lookup_or_invalid(local_name)
        if existing_id.is_valid():
            # Avoid constructing or unwrapping Option<SymbolId> on the staged
            # native ABI. lookup_or_invalid keeps the whole path scalar-safe.
            val existing_raw = existing_id.id
            # SymbolTable's typed owner predicate plus bracket read avoids the
            # equally fragile Option<Symbol> return ABI of get_symbol_raw.
            if self.symbols.symbols.has(existing_raw):
                val symbol: HirSymbol = self.symbols.symbols[existing_raw]
                val existing_kind = hir_symbol_terminal_kind(symbol.kind)
                val existing_owner = symbol.defining_module ?? ""
                val existing = hir_payload_terminal_identity(existing_owner, symbol.name, existing_kind)
                # Only a TYPE symbol can contest ownership of a payload type
                # name. Keying this on `existing_kind == ""` was the wrong
                # test: `hir_symbol_terminal_kind` returns a NON-empty string
                # for functions and methods ("callable") and for constants
                # ("const"), so that check could never fire for exactly the
                # symbols that reach here in practice, and control fell
                # through to the conflict below. That misreported a function
                # as a competing type owner -- all 78 unique "enum payload
                # dependency conflicts" in the Stage 3 log were of this
                # shape, and in 0 of the 78 did the two sides even share a
                # name (73 `callable`, 3 `struct`, 2 `class`).
                if not hir_payload_kind_is_type(existing_kind):
                    # Level-gated probe (SIMPLE_HIR_PAYLOAD_LOOKUP_TRACE=1, default
                    # OFF) that decides which of two layers is at fault, because
                    # the reported symbol shares NO NAME with the requested one:
                    #   (a) resolver defect here -- lookup_or_invalid returned an
                    #       id for a DIFFERENT name (key != symbol.name and the id
                    #       is genuinely that other symbol's), or
                    #   (b) native-codegen Dict bracket-read defect -- the id is
                    #       right, but `self.symbols.symbols[id]`, a class-field
                    #       Dict<i64, HirSymbol> reached through two chained field
                    #       hops, returns a foreign/garbage record.
                    # Discriminator: compare `key` against `sym_name` for the same
                    # `id`. Cross-reference the id against the symbol table dump to
                    # see whether the id itself is wrong (a) or only the fetch (b).
                    if (hir_module_env_get("SIMPLE_HIR_PAYLOAD_LOOKUP_TRACE") ?? "") == "1":
                        eprint("[HIR-PAYLOAD-LOOKUP] key=" + local_name + " id=" + int_to_str(existing_raw) + " sym_name=" + symbol.name + " kind=" + existing_kind + " owner=" + existing_owner)
                    self.error("enum payload dependency `{local_name}` resolved to non-type binding `{symbol.name}` (kind `{existing_kind}`) in `{existing_owner}`; expected the type `{wanted}`", import_span)
                    return false
                if existing != wanted:
                    # Same reasoning as the binding-table branch above: a
                    # different TYPE already owns this short name. That is a
                    # name collision, not a defect -- fall back to the
                    # qualified registration in the caller.
                    if (hir_module_env_get("SIMPLE_HIR_PAYLOAD_LOOKUP_TRACE") ?? "") == "1":
                        eprint("[hir-payload-shortname-taken] name={local_name} existing={existing} wanted={wanted}")
                    return false
        self.materialized_payload_bindings[local_name] = wanted
        true

    me register_materialized_payload_named_dependency(imported_mod: ModuleSurface, imported_mod_name: text, dependency: text, skipped: {text: bool}, import_span: Span):
        """Profile wrapper (SIMPLE_HIR_PHASE_PROFILE=1, default off)."""
        val started = hir_phase_profile_now()
        self.register_materialized_payload_named_dependency_inner(imported_mod, imported_mod_name, dependency, skipped, import_span)
        hir_phase_profile_add(HIR_PROF_RIS_PAYLOAD, started)

    me register_materialized_payload_named_dependency_inner(imported_mod: ModuleSurface, imported_mod_name: text, dependency: text, skipped: {text: bool}, import_span: Span):
        if dependency == "" or skipped.contains_key(dependency): return
        val origin = self.resolve_materialized_enum_payload_origin(imported_mod, imported_mod_name, dependency)
        if not origin.found:
            # NEVER silent. An unresolved payload origin used to return with no
            # trace at all, and the failure resurfaced much later as a hard
            # `unresolved type: {name}` (hir_lowering/types.spl) attributed to
            # whichever module imported the ENUM -- an innocent third party that
            # never names the payload type. Name the real owner and the payload
            # here so the class can never land on an innocent importer again.
            # Advisory (eprint, not self.error) on purpose: a payload the
            # consumer already has in scope is still lowerable, so failing the
            # build here would be a regression, not a fix.
            # See doc/08_tracking/bug/hir_enum_payload_blockvalue_unresolved_2026-08-21.md
            eprint("[hir-payload-origin-unresolved] owner={imported_mod.module_name} owner_key={imported_mod_name} payload={dependency}: no declaration, re-export hop, or explicit import of this name in the owner; a later `unresolved type: {dependency}` will be reported against an importing module instead")
            return
        val claimed_short_name = self.claim_materialized_payload_binding(dependency, origin, import_span)
        val identity = hir_payload_terminal_identity(origin.module_name, origin.item_name, origin.item_kind)
        val expanded = self.materialized_payload_origins.contains_key(identity)
        val source_index = self.surface_index_for_name(origin.module_key)
        if source_index < 0: return
        val terminal = self.module_surfaces.surfaces[source_index]
        # Binding and expansion are deliberately distinct: aliases in a cycle
        # still need their local symbol even when the physical origin was seen.
        # When the unqualified name is already owned by a DIFFERENT terminal
        # type, register this one under `{owner}::{name}` instead of dropping
        # it. `register_imported_symbol` binds the qualified type for us, so
        # the payload stays resolvable from the owner's own signatures.
        val payload_local_name = if claimed_short_name: dependency
            else: "{origin.module_name}::{origin.item_name}"
        self.register_imported_symbol(terminal.physical_index, origin.module_key, origin.item_name, payload_local_name, import_span, true)
        if expanded: return
        if origin.item_kind != "type_alias":
            self.materialized_payload_origins[identity] = true
            return
        self.materialized_payload_origins[identity] = true
        val alias_position = module_surface_name_position(
            terminal.type_alias_names, origin.item_name)
        if alias_position < 0: return
        val alias = terminal.type_alias_values[alias_position]
        var alias_skipped: {text: bool} = {}
        for param in alias.type_params:
            alias_skipped[param.name] = true
        var nested_names = parser_type_named_dependencies(alias.type_)
        for param in alias.type_params:
            for bound in param.bounds:
                for nested in parser_type_named_dependencies(bound):
                    nested_names = nested_names.push(nested)
            if param.has_default:
                for nested in parser_type_named_dependencies(param.default):
                    nested_names = nested_names.push(nested)
        var seen: {text: bool} = {}
        for nested in nested_names:
            if not seen.contains_key(nested):
                seen[nested] = true
                self.register_materialized_payload_named_dependency(terminal, origin.module_key, nested, alias_skipped, import_span)

    me register_materialized_enum_payload_dependencies(imported_mod: ModuleSurface, imported_mod_name: text, enum_: ModuleSurfaceEnum, import_span: Span):
        """Materialize the complete named dependency closure of one enum."""
        val identity = hir_payload_terminal_identity(imported_mod.module_name, enum_.name, "enum")
        if self.materialized_payload_origins.contains_key(identity): return
        self.materialized_payload_origins[identity] = true
        var skipped: {text: bool} = {}
        var names: [text] = []
        for param in enum_.type_params:
            skipped[param.name] = true
            for bound in param.bounds:
                for nested in parser_type_named_dependencies(bound):
                    names = names.push(nested)
            if param.has_default:
                for nested in parser_type_named_dependencies(param.default):
                    names = names.push(nested)
        for variant in enum_.variants:
            for nested in parser_variant_named_dependencies(variant):
                names = names.push(nested)
        var seen: {text: bool} = {}
        for name in names:
            if not seen.contains_key(name):
                seen[name] = true
                self.register_materialized_payload_named_dependency(imported_mod, imported_mod_name, name, skipped, import_span)

    me materialize_imported_callable_declared_dependency(
        imported_mod: ModuleSurface,
        imported_mod_name: text,
        dependency: text,
        import_span: Span,
        materialize_enum: bool
    ):
        """Profile wrapper (SIMPLE_HIR_PHASE_PROFILE=1, default off)."""
        val started = hir_phase_profile_now()
        self.materialize_imported_callable_declared_dependency_inner(
            imported_mod, imported_mod_name, hir_dependency_type_name(dependency), import_span, materialize_enum)
        hir_phase_profile_add(HIR_PROF_RIS_DECLARED_DEP, started)

    me materialize_imported_callable_declared_dependency_inner(
        imported_mod: ModuleSurface,
        imported_mod_name: text,
        dependency: text,
        import_span: Span,
        materialize_enum: bool
    ):
        val local_name = "{imported_mod.module_name}::{dependency}"
        self.register_imported_symbol(
            imported_mod.physical_index, imported_mod_name, dependency, local_name,
            import_span, materialize_enum)
        val symbol = self.symbols.lookup_or_invalid(local_name)
        if symbol.is_valid():
            self.symbols.bind_qualified_type(
                imported_mod.module_name, dependency, symbol)

    me materialize_imported_callable_explicit_dependency(
        imported_mod: ModuleSurface,
        dependency: text,
        import_span: Span,
        materialize_enum: bool
    ):
        """Profile wrapper (SIMPLE_HIR_PHASE_PROFILE=1, default off)."""
        val started = hir_phase_profile_now()
        self.materialize_imported_callable_explicit_dependency_inner(
            imported_mod, hir_dependency_type_name(dependency), import_span, materialize_enum)
        hir_phase_profile_add(HIR_PROF_RIS_EXPLICIT_DEP, started)

    me materialize_imported_callable_explicit_dependency_inner(
        imported_mod: ModuleSurface,
        dependency: text,
        import_span: Span,
        materialize_enum: bool
    ):
        # RISFACT (2026-08-21): the SWEEP below is a pure function of the
        # frozen registry and the DECLARING surface, so it is memoized on
        # (declaring module, dependency); see the field comment in
        # hir_lowering/types.spl for why the cached value is deliberately a
        # registry index plus an item NAME and never a SymbolId. Everything
        # after the memo -- register_imported_symbol and the two
        # bind_qualified_type calls -- still runs per importer, against that
        # importer's own symbol table.
        val memo_key = imported_mod.module_name + " " + dependency
        var selected_target: i64 = -1
        var selected_item: text = ""
        if self.explicit_dep_target_memo.contains_key(memo_key):
            selected_target = self.explicit_dep_target_memo[memo_key]
            selected_item = self.explicit_dep_item_memo[memo_key]
        else:
            self.explicit_dep_scan_count = self.explicit_dep_scan_count + 1
            hir_phase_profile_count_explicit_scan(imported_mod.imports.len())
            # Resolve only an explicit named import written by the callable
            # owner. Glob/package inference is intentionally excluded here: the
            # same short name may be present in multiple sibling modules (Span,
            # TraitBound, TraitDef), and choosing one would silently rewrite the
            # signature.
            var import_index: i64 = 0
            var ambiguous = false
            while import_index < imported_mod.imports.len() and
                  import_index < imported_mod.import_target_indices.len():
                val target_index = imported_mod.import_target_indices[import_index]
                val item_start = imported_mod.import_item_offsets[import_index]
                val item_end = imported_mod.import_item_offsets[import_index + 1]
                var item_index: i64 = item_start
                while item_index < item_end:
                    val item_name = imported_mod.import_item_names[item_index]
                    val local_name = if imported_mod.import_item_has_alias[item_index]:
                        imported_mod.import_item_aliases[item_index]
                    else: item_name
                    if local_name == dependency and target_index >= 0 and
                       target_index < self.module_surfaces.surfaces.len():
                        val target = self.module_surfaces.surfaces[target_index]
                        var candidate_target = target_index
                        var candidate_item = item_name
                        var candidate_found = hir_module_declares_item(
                            target, item_name)
                        if not candidate_found:
                            val hop = self.find_reexport_source(
                                target.physical_index, item_name)
                            if hop.found and hop.module_index >= 0:
                                candidate_target = hop.module_index
                                candidate_item = hop.item_name
                                candidate_found = true
                        if candidate_found:
                            if selected_target >= 0 and
                               (selected_target != candidate_target or
                                selected_item != candidate_item):
                                ambiguous = true
                            selected_target = candidate_target
                            selected_item = candidate_item
                    item_index = item_index + 1
                # A wildcard import has no flattened item rows. Resolve the
                # requested dependency against its target, but accept it only
                # when every matching named/glob route reaches one terminal.
                if item_start == item_end and target_index >= 0 and
                   target_index < self.module_surfaces.surfaces.len():
                    val target = self.module_surfaces.surfaces[target_index]
                    var candidate_target = target_index
                    var candidate_item = dependency
                    var candidate_found = hir_module_declares_item(
                        target, dependency)
                    if not candidate_found:
                        val hop = self.find_reexport_source(
                            target.physical_index, dependency)
                        if hop.found and hop.module_index >= 0:
                            candidate_target = hop.module_index
                            candidate_item = hop.item_name
                            candidate_found = true
                    if candidate_found:
                        if selected_target >= 0 and
                           (selected_target != candidate_target or
                            selected_item != candidate_item):
                            ambiguous = true
                        selected_target = candidate_target
                        selected_item = candidate_item
                import_index = import_index + 1
            if ambiguous:
                # -2 is the ambiguity sentinel, cached like any other fact so a
                # later importer does not re-sweep to rediscover it. The
                # DIAGNOSTIC is still emitted below, per importer, exactly as
                # the pre-memo code did.
                selected_target = -2
                selected_item = ""
            self.explicit_dep_target_memo[memo_key] = selected_target
            self.explicit_dep_item_memo[memo_key] = selected_item
        if selected_target == -2:
            self.error(
                "ambiguous explicit callable dependency `{dependency}` in `{imported_mod.module_name}`",
                import_span)
            return
        if selected_target < 0:
            return
        val terminal = self.module_surfaces.surfaces[selected_target]
        val terminal_local_name = "{terminal.module_name}::{selected_item}"
        self.register_imported_symbol(
            selected_target, terminal.preferred_registry_name, selected_item,
            terminal_local_name, import_span,
            materialize_enum)
        # The enum/composite registration branches historically use an
        # Option-based local `already_bound` test to decide whether to publish
        # their qualified alias.  That Option is not reliable under the staged
        # native ABI.  The exact internal key above is scalar-safe, so recover
        # the newly defined symbol from it and publish both qualified aliases
        # explicitly.
        val terminal_symbol = self.symbols.lookup_or_invalid(
            terminal_local_name)
        if terminal_symbol.is_valid():
            self.symbols.bind_qualified_type(
                terminal.module_name, selected_item, terminal_symbol)
            # Signature projection queries names in the callable owner's
            # qualified scope. Preserve the explicit import alias there while
            # retaining the terminal symbol as the single declaration owner.
            self.symbols.bind_qualified_type(
                imported_mod.module_name, dependency,
                terminal_symbol)

    me cached_surface_package_name(module_name: text) -> text:
        """Package name of `surface`, memoized by module name.

        module_surface_package_name canonicalizes and then split/joins the
        dotted name, allocating on every call. The full-registry scan in
        materialize_imported_field_package_dependency called it once per
        candidate per query; the registry is frozen for the whole HIR phase,
        so one computation per surface is enough."""
        if self.surface_package_name_memo.contains_key(module_name):
            return self.surface_package_name_memo[module_name]
        val computed = module_surface_package_name_from_name(module_name)
        self.surface_package_name_memo[module_name] = computed
        computed

    me materialize_imported_field_package_dependency(
        imported_index: i64,
        dependency: text,
        import_span: Span,
        materialize_enum: bool
    ):
        """Last-resort materialization for a composite FIELD type that the
        declaring module names but does not itself declare or import.

        `register_imported_symbol`'s field loop recursively registers a field
        type against the DECLARING module's surface, and
        `materialize_imported_callable_explicit_dependency` (above) chases that
        module's explicit `use` items. Neither covers the PACKAGE-SIBLING case:
        two files in the same directory see each other's declarations without
        an import edge (`resolve_package_sibling_symbols`), and a cycle can make
        the import edge impossible to write at all.

        Stage 1/3 hit this as `unresolved type: HirImpl` plus HirStaticAssert,
        HirAopAdvice, HirDiBinding, HirArchRule and HirMockDecl, 6x per
        importer, in every module that imports `HirModule`: `HirModule` is
        declared in `20.hir/hir_types.spl` with fields typed `[HirImpl]` etc.,
        but those six structs are declared in the SIBLING file
        `20.hir/hir_definitions.spl`, which hir_types.spl structurally cannot
        import (hir_definitions.spl:9 already does `use
        compiler.hir.hir_types.*`, so the reverse edge is a cycle). The
        `Dict<SymbolId, HirConst>`-typed fields on the SAME struct never failed,
        because only `[T]`/scalar field shapes reach the dependency walk -- the
        error therefore depended on the field's CONTAINER, not on anything the
        code does. The previous remedy (70.backend/bitfield.spl, 2026-08-08) was
        to drop an UNUSED `HirModule` import; that does not generalize to the
        importers which genuinely use it.

        Only a UNIQUE declaring sibling in the same package is followed. An
        ambiguous short name (Span, TraitBound) leaves the dependency alone
        rather than silently choosing, exactly as the explicit-import chase
        does."""
        if imported_index < 0 or imported_index >= self.module_surfaces.surfaces.len():
            self.error("invalid imported module surface index {imported_index} for package dependency `{dependency}`", import_span)
            return
        val imported_mod = self.module_surfaces.surfaces[imported_index]
        if imported_mod.physical_index != imported_index or
           imported_mod.generation != self.module_surfaces.generation:
            self.error("stale imported module surface index {imported_index} for package dependency `{dependency}`", import_span)
            return
        val package_name = self.cached_surface_package_name(imported_mod.module_name)
        if package_name == "":
            return
        # PKGDEP (2026-08-21): the registry is frozen for the whole HIR phase,
        # so "which unique sibling in <package> declares <dependency>" is a
        # constant. Without this memo the full-registry scan below re-ran for
        # every importing module: O(modules x registry x field-deps), with a
        # split/join allocation per candidate. See types.spl field_package_dep_memo.
        val memo_key = imported_mod.module_name + " " + package_name + " " + dependency
        var selected: i64 = -1
        if self.field_package_dep_memo.contains_key(memo_key):
            selected = self.field_package_dep_memo[memo_key]
        else:
            self.field_package_dep_scan_count = self.field_package_dep_scan_count + 1
            # PKGIDX (2026-08-21): candidates now come from the declaration
            # index, so the loop is over the (usually one or two) surfaces that
            # declare `dependency` at all, not over the whole registry. The
            # package and self-exclusion filters are unchanged.
            val owner_indices: [i64] = self.surface_decl_owner_indices(dependency)
            var index: i64 = 0
            var ambiguous = false
            while index < owner_indices.len():
                val candidate_index: i64 = owner_indices[index]
                val candidate = self.module_surfaces.surfaces[candidate_index]
                if candidate.module_name != imported_mod.module_name and
                   self.cached_surface_package_name(candidate.module_name) == package_name:
                    if selected >= 0:
                        ambiguous = true
                        break
                    selected = candidate_index
                index = index + 1
            if ambiguous:
                selected = -1
            self.field_package_dep_memo[memo_key] = selected
        if selected < 0:
            return
        val terminal = self.module_surfaces.surfaces[selected]
        val terminal_local_name = "{terminal.module_name}::{dependency}"
        self.register_imported_symbol(
            selected, terminal.preferred_registry_name, dependency,
            terminal_local_name, import_span, materialize_enum)
        val terminal_symbol = self.symbols.lookup_or_invalid(terminal_local_name)
        if terminal_symbol.is_valid():
            self.symbols.bind_qualified_type(
                terminal.module_name, dependency, terminal_symbol)
            # Field-type projection queries the DECLARING module's qualified
            # scope, so publish the alias there too.
            self.symbols.bind_qualified_type(
                imported_mod.module_name, dependency, terminal_symbol)

    me materialize_imported_callable_type_dependencies(imported_mod: ModuleSurface, imported_mod_name: text, callable: ModuleSurfaceCallable, import_span: Span, materialize_enum: bool):
        """Profile wrapper (SIMPLE_HIR_PHASE_PROFILE=1, default off)."""
        val started = hir_phase_profile_now()
        self.materialize_imported_callable_type_dependencies_inner(
            imported_mod, imported_mod_name, callable, import_span, materialize_enum)
        hir_phase_profile_add(HIR_PROF_RIS_CALLABLE_DEPS, started)

    me qtype_raw_counted(module_name: text, name: text) -> i64:
        """`lookup_qualified_type_raw` with miss counting for the RIS profile."""
        val found = self.symbols.lookup_qualified_type_raw(module_name, name)
        hir_phase_profile_count_qtype(found < 0)
        found

    me materialize_imported_callable_type_dependencies_inner(imported_mod: ModuleSurface, imported_mod_name: text, callable: ModuleSurfaceCallable, import_span: Span, materialize_enum: bool):
        """Pre-register every named type a cross-module method SIGNATURE
        depends on, before that signature is eagerly lowered.

        Mirrors the scalar composite-field dependency materialization in
        `register_imported_symbol`:
        a public field naming a sibling type from the same defining module is
        recursively registered so field-type lowering never races module
        load order. `register_imported_type_methods` (below) is the METHOD
        twin of that same registration pass, but had no equivalent step --
        a param/return type declared in the SAME defining module as the
        method's owner (e.g. `fn seek(pos: SeekFrom)` on `FileHandle`, both
        in `io/file.spl`) that was never independently named in the
        IMPORTER's own `use` line stayed unbound. `declared_imported_surface_
        callable_type` -> `imported_surface_type_projected` then took the
        scalar `type_name` branch, missed the qualified lookup, and called
        `lower_named_kind` directly (bypassing `imported_surface_type`'s own
        fallback) -- landing on the hard, non-recovered "unresolved type:
        {name}" error and poisoning the ENTRY module (attribution is
        allocated to whichever module is currently being lowered, not the
        type's actual defining module). Root-caused via a minimal 1-file
        repro: a class with one field and one never-called method whose sole
        param type is a struct declared in the SAME file reproduces this
        with no cross-module import at all -- see
        doc/08_tracking/bug/native_build_cross_module_result_payload_struct_name_collision_2026-08-09.md
        (5th layer)."""
        for param in callable.params:
            if param.type_name != "":
                self.materialize_imported_callable_dependency(
                    imported_mod, imported_mod_name, param.type_name,
                    import_span, materialize_enum)
            elif param.array_element_name != "":
                self.materialize_imported_callable_dependency(
                    imported_mod, imported_mod_name, param.array_element_name,
                    import_span, materialize_enum)
            else:
                for dependency in parser_type_named_dependencies(param.type_):
                    self.materialize_imported_callable_dependency(
                        imported_mod, imported_mod_name, dependency,
                        import_span, materialize_enum)
        if callable.has_return_type:
            if callable.return_type_name != "":
                self.materialize_imported_callable_dependency(
                    imported_mod, imported_mod_name, callable.return_type_name,
                    import_span, materialize_enum)
            elif callable.return_array_element_name != "":
                self.materialize_imported_callable_dependency(
                    imported_mod, imported_mod_name,
                    callable.return_array_element_name, import_span,
                    materialize_enum)
            else:
                val composite_deps = parser_type_named_dependencies(callable.return_type)
                if (hir_module_env_get("SIMPLE_HIR_PAYLOAD_LOOKUP_TRACE") ?? "") == "1":
                    eprint("[hir-callable-composite-return] owner={imported_mod.module_name} fn={callable.name} deps={composite_deps.len()}")
                for dependency in composite_deps:
                    self.materialize_imported_callable_dependency(
                        imported_mod, imported_mod_name, dependency,
                        import_span, materialize_enum)

    me materialize_imported_callable_dependency(imported_mod: ModuleSurface, imported_mod_name: text, dependency: text, import_span: Span, materialize_enum: bool):
        """Resolve ONE named type a cross-module callable signature depends on,
        in the declaring module's qualified scope: the declaring module's own
        declarations, then its explicit `use` items, then a unique package
        sibling -- the same three steps as the composite-FIELD twin
        (`materialize_imported_field_dependency_inner`). Step three was
        missing here: `15.blocks/blocks/builtin_blocks_data.spl` declares
        `fn completions(...) -> [Completion]` and reaches `Completion` only by
        directory-sibling visibility (definition.spl). Whenever the registry
        lists the impl owner BEFORE the type owner, package-sibling
        registration of a zero-import member (sugar_registry.spl, context.spl,
        modes.spl, value.spl) lowered that signature first and died with
        `unresolved type: Completion` blamed on the member being lowered."""
        if self.qtype_raw_counted(imported_mod.module_name, dependency) >= 0:
            return
        self.materialize_imported_callable_declared_dependency(
            imported_mod, imported_mod_name, dependency, import_span, materialize_enum)
        if self.qtype_raw_counted(imported_mod.module_name, dependency) >= 0:
            return
        self.materialize_imported_callable_explicit_dependency(
            imported_mod, dependency, import_span, materialize_enum)
        if self.qtype_raw_counted(imported_mod.module_name, dependency) >= 0:
            return
        self.materialize_imported_field_package_dependency(
            imported_mod.physical_index, hir_dependency_type_name(dependency), import_span, materialize_enum)

    me register_imported_type_methods(imported_mod: ModuleSurface, imported_mod_name: text, imported_name: text, local_owner: SymbolId, import_span: Span, materialize_enum: bool):
        # RE-ENTRANCY BREAKER. This method sits in a three-node cycle:
        #   register_imported_type_methods
        #     -> materialize_imported_callable_type_dependencies
        #     -> register_imported_symbol
        #     -> register_imported_type_methods   (composite and enum branches)
        # Every guard on that path is "check, then recurse" against the symbol
        # table (`lookup_qualified_type_raw(...) < 0`,
        # `lookup_or_invalid(...).is_valid()`), which only terminates when the
        # callee is fully registered BEFORE the recursive descent. That holds
        # on the composite path -- it defines and binds the type, then returns
        # early when it was `already_bound`. It does NOT hold on the ENUM path,
        # which calls this method unconditionally with no `already_bound` early
        # return (deliberately -- gating it broke imported `DbValue.to_text()`).
        # So two types in one module whose method SIGNATURES mention each other
        # descend forever and exhaust the stack.
        #
        # Observed 2026-08-17: Stage 3 SIGSEGV (exit 139) with `rsp` on the
        # guard page 0x7fffff7ff000 and these three frames repeating for the
        # entire backtrace. Fixing it by gating the enum call site would
        # reintroduce the to_text() bug, so the cycle is broken here instead --
        # registering a type's methods is idempotent, so declining a re-entrant
        # call loses nothing: the in-flight outer call completes the same work.
        # doc/08_tracking/bug/stage3_register_imported_type_methods_infinite_recursion_2026-08-17.md
        #
        # Deliberately a plain `[text]` used as a stack, NOT a Dict: every other
        # breaker in this cycle memoizes on a Dict/symbol-table membership test,
        # and `rt_dict_contains` under-reporting is exactly what silently
        # disabled them once before (see the essay at 20.hir/hir_types.spl and
        # stage3_native_build_segv_generic_codegen_link_path_2026-08-06.md).
        val reentry_key = "{imported_mod.module_name}::{imported_name}"
        # Field is touched ONLY through the accessors declared next to the
        # class in hir_lowering/types.spl. A direct `self.<field>` read here
        # aborted native-build's semantic pass with "class `HirLowering` has
        # no field named `imported_type_methods_in_progress`" — see the
        # comment on those accessors.
        if self.imported_type_methods_in_progress_has(reentry_key):
            return
        self.imported_type_methods_in_progress_push(reentry_key)
        val started = hir_phase_profile_now()
        self.register_imported_type_methods_inner(
            imported_mod, imported_mod_name, imported_name, local_owner, import_span, materialize_enum)
        hir_phase_profile_add(HIR_PROF_RIS_METHODS, started)
        self.imported_type_methods_in_progress_pop(reentry_key)

    me imported_impl_positions(imported_mod: ModuleSurface, imported_name: text) -> [i64]:
        """IMPLIDX: positions in `imported_mod.impls` whose implemented type is
        `imported_name`, in declaration order. Built once per frozen surface
        (`generation physical_index`) by a single sweep; every later query is
        a Dict probe. Keyed on the frozen registry only, so the answer is the
        same for every importer and is never cleared per module."""
        val surface_key = "{self.module_surfaces.generation} {imported_mod.physical_index}"
        if not self.impl_index_built.contains_key(surface_key):
            self.impl_index_build_count = self.impl_index_build_count + 1
            var position = 0
            while position < imported_mod.impls.len():
                val implemented = parser_type_kind_named_name(imported_mod.impls[position].type_.kind)
                val rows_key = surface_key + " " + implemented
                if self.impl_index_positions.contains_key(rows_key):
                    # One-time build over a few rows per type: the temporary
                    # copy here is bounded by impls-per-type, not by the table.
                    var rows: [i64] = self.impl_index_positions[rows_key]
                    rows = rows.push(position)
                    self.impl_index_positions[rows_key] = rows
                else:
                    val first_rows: [i64] = [position]
                    self.impl_index_positions[rows_key] = first_rows
                position = position + 1
            self.impl_index_built[surface_key] = true
        val wanted_key = surface_key + " " + imported_name
        if self.impl_index_positions.contains_key(wanted_key):
            return self.impl_index_positions[wanted_key]
        val none: [i64] = []
        none

    me register_imported_type_methods_inner(imported_mod: ModuleSurface, imported_mod_name: text, imported_name: text, local_owner: SymbolId, import_span: Span, materialize_enum: bool):
        var local_owner_module: text = imported_mod_name
        var local_owner_defining_module: text? = nil
        if val owner_symbol = self.symbols.get_symbol(local_owner):
            if val module_name = owner_symbol.defining_module:
                local_owner_module = module_name
                local_owner_defining_module = Some(module_name)
        val owner_module = hir_module_logical_name_from_path(local_owner_module)
        # IMPLIDX: visit only the impls that implement `imported_name`, in
        # declaration order, instead of sweeping (and copying) every impl row
        # of the declaring module per registration.
        val impl_positions = self.imported_impl_positions(imported_mod, imported_name)
        var impl_cursor = 0
        while impl_cursor < impl_positions.len():
            val impl_ = imported_mod.impls[impl_positions[impl_cursor]]
            impl_cursor = impl_cursor + 1
            self.impl_rows_visited = self.impl_rows_visited + 1
            for method_name in impl_.methods.keys():
                val method = impl_.methods[method_name]
                val symbol_name = "{owner_module}.{imported_name}::{method_name}"
                if not self.symbols.lookup_or_invalid(symbol_name).is_valid():
                    val kind = if method.is_static: SymbolKind.Function else: SymbolKind.Method
                    self.materialize_imported_callable_type_dependencies(imported_mod, imported_mod_name, method, import_span, materialize_enum)
                    val sig_started = hir_phase_profile_now()
                    val method_type = self.declared_imported_surface_callable_type(
                        method, imported_mod.module_name, Some(local_owner))
                    hir_phase_profile_add(HIR_PROF_RIS_SIGTYPE, sig_started)
                    self.symbols.define(symbol_name, kind, method_type, import_span, Visibility.Public, false, local_owner_defining_module)
            if impl_.has_trait_:
                val trait_name = parser_type_kind_named_name(impl_.trait_.kind)
                var trait_module = imported_mod
                var trait_module_found = true
                var trait_source_name = trait_name
                if module_surface_name_position(imported_mod.trait_names, trait_source_name) < 0:
                    val trait_source = self.find_reexport_source(
                        imported_mod.physical_index, trait_name)
                    if trait_source.found:
                        val trait_module_index = trait_source.module_index
                        trait_module_found = trait_module_index >= 0
                        if trait_module_found:
                            trait_module = self.module_surfaces.surfaces[trait_module_index]
                        trait_source_name = trait_source.item_name
                    val trait_position = module_surface_name_position(
                        trait_module.trait_names, trait_source_name)
                    if trait_module_found and trait_position >= 0:
                        val trait_ = trait_module.trait_values[trait_position]
                        for trait_method in trait_.methods:
                            val symbol_name = "{owner_module}.{imported_name}::{trait_method.name}"
                            if not self.symbols.lookup_or_invalid(symbol_name).is_valid():
                                val kind = if trait_method.is_static: SymbolKind.Function else: SymbolKind.Method
                                # The signature belongs to the trait's physical
                                # declaration, not the implementing type's
                                # module. Resolve its dependencies through that
                                # owner so imported names such as ContractMode
                                # cannot be looked up in an unrelated impl file.
                                self.materialize_imported_callable_type_dependencies(
                                    trait_module, trait_module.preferred_registry_name,
                                    trait_method, import_span, materialize_enum)
                                val method_type = self.declared_imported_surface_callable_type(
                                    trait_method, trait_module.module_name,
                                    Some(local_owner))
                                self.symbols.define(symbol_name, kind, method_type, import_span, Visibility.Public, false, local_owner_defining_module)

fn hir_dependency_type_name(dependency: text) -> text:
    """The declared type a signature dependency names. `has_X` is the optional
    sugar for `X?` (lower_named_kind strips it at lowering time), but the
    surface records the spelling verbatim, so a sibling callable returning
    `has_GpuIntrinsicKind` materialized nothing and its importer later died
    with `unresolved type: GpuIntrinsicKind` (stage-1 run9,
    backend/feature_caps_types.spl via gpu_intrinsics.spl)."""
    if dependency.starts_with("has_") and dependency.len() > 4:
        return dependency[4:]
    dependency
