extern fn rt_env_get(key: text) -> text
extern fn rt_string_len(value: text) -> i64

fn hir_module_env_get(key: text) -> text:
    rt_env_get(key)

fn hir_module_phase_probe(msg: text):
    if hir_module_diag_enabled():
        eprint("[BOOTSTRAP-PHASE] " + msg)

fn hir_module_diag_enabled() -> bool:
    val phase = hir_module_env_get("SIMPLE_COMPILER_PHASE_PROFILE") ?? ""
    val trace = hir_module_env_get("SIMPLE_COMPILER_TRACE") ?? ""
    val diag = hir_module_env_get("SIMPLE_BOOTSTRAP_DIAG") ?? ""
    if phase == "1":
        return true
    if trace == "1":
        return true
    diag == "1"

fn hir_module_verbose_diag_enabled() -> bool:
    val trace = hir_module_env_get("SIMPLE_COMPILER_TRACE") ?? ""
    val diag = hir_module_env_get("SIMPLE_BOOTSTRAP_DIAG") ?? ""
    trace == "1" or diag == "1"

fn hir_module_sibling_trace_enabled() -> bool:
    """Dedicated, default-OFF switch for directory-package (sibling) symbol
    registration. Kept in tree: `resolve_package_sibling_symbols` silently
    registering NOTHING is indistinguishable from it running and finding no
    siblings, and that ambiguity is exactly what hid the package-prefix
    spelling mismatch behind ~260 stage-3 "unresolved name" errors."""
    (hir_module_env_get("SIMPLE_HIR_SIBLING_TRACE") ?? "") == "1"

fn hir_pkg_segment_is_tier(seg: text) -> bool:
    """True for an all-digit layer segment ("70" in compiler.70.backend.*).
    Mirrors `_driver_module_name_segment_is_tier` in
    80.driver/driver_source_loading.spl; duplicated instead of imported
    because 20.hir must not depend on 80.driver."""
    if seg == "":
        return false
    val seg_len = rt_string_len(seg)
    var i = 0
    while i < seg_len:
        val code = seg.char_code_at(i)
        if code < 48 or code > 57:
            return false
        i = i + 1
    true

fn hir_pkg_canonical_module_name(name: text) -> text:
    """Fold every spelling of ONE physical module onto a single dotted name.
    Accepts both spellings that reach HIR lowering: a repo-relative PATH
    (`src/compiler/70.backend/backend/vulkan_backend.spl`, what the
    bare-positional native-build lane uses for `SourceFile.module_name`) and a
    dotted import name (`compiler.backend.backend.vulkan_backend`). Applies the
    same two rules as `_driver_canonical_module_name`: drop all-digit tier
    segments (`src/compiler/frontend -> 10.frontend` and friends) and fold a
    leading `std.` to `lib.` (`src/std -> src/lib`)."""
    var dotted = name
    if dotted.ends_with(".spl"):
        dotted = dotted[0:dotted.len() - 4]
    dotted = dotted.replace("/", ".")
    if dotted.starts_with("src."):
        dotted = dotted.substring(4)
    var segs: [text] = []
    for seg in dotted.split("."):
        if hir_pkg_segment_is_tier(seg):
            continue
        segs = segs.push(seg)
    val canonical = segs.join(".")
    if canonical == "std":
        return "lib"
    if canonical.starts_with("std."):
        return "lib." + canonical.substring(4)
    canonical

struct HirReexportSource:
    """Result of chasing a re-export facade chain (find_reexport_source).
    A struct (not an anonymous tuple) on purpose: multi-value tuple returns
    are unreliable on the seed interpreter."""
    found: bool
    module_name: text
    item_name: text

fn hir_module_surface_get(surfaces: ModuleSurfacesByName, name: text) -> ModuleSurface?:
    if not surfaces.index_by_name.contains_key(name):
        return nil
    val index = surfaces.index_by_name[name]
    if index < 0 or index >= surfaces.surfaces.len():
        return nil
    Some(surfaces.surfaces[index])

fn hir_module_declares_item(m: ModuleSurface, name: text) -> bool:
    """True when module `m` itself declares `name` as any importable decl
    kind register_imported_symbol knows how to register (functions covers
    `extern fn` too — the parser stores externs in ParserModule.functions with
    is_extern=true)."""
    if m.callables.contains_key(name):
        return true
    if m.composites.contains_key(name):
        return true
    if m.enums.contains_key(name):
        return true
    if m.traits.contains_key(name):
        return true
    if m.type_aliases.contains_key(name):
        return true
    m.constants.contains_key(name)

fn hir_surface_param_to_param(param: ModuleSurfaceParam) -> Param:
    Param(name: param.name, has_type_: param.has_type_, type_: param.type_,
        has_default: false, default: Expr(kind: ExprKind.NilLit, span: param.span),
        span: param.span, is_mutable: param.is_mutable)

fn hir_surface_callable_to_header(callable: ModuleSurfaceCallable) -> ParserFunction:
    var params: [Param] = []
    for param in callable.params:
        params = params.push(hir_surface_param_to_param(param))
    ParserFunction(
        name: callable.name, type_params: callable.type_params, params: params,
        has_return_type: callable.has_return_type, return_type: callable.return_type,
        body: Block(stmts: [], span: callable.span), visibility: callable.visibility,
        is_async: callable.is_async, is_static: callable.is_static,
        is_public: callable.is_public, is_method: callable.is_method,
        is_mutable: callable.is_mutable, is_const: callable.is_const,
        is_kernel: callable.is_kernel, is_extern: callable.is_extern,
        attributes: [], has_doc_comment: false, doc_comment: "", span: callable.span)

fn hir_surface_trait_to_trait(surface_trait: ModuleSurfaceTrait, local_name: text) -> ParserTrait:
    var methods: [ParserFunction] = []
    for callable in surface_trait.methods:
        var method = hir_surface_callable_to_header(callable)
        for default_method in surface_trait.default_methods:
            if default_method.span.start == callable.span.start and default_method.span.end == callable.span.end and default_method.span.file == callable.span.file:
                method = default_method
        methods = methods.push(method)
    ParserTrait(name: local_name, type_params: surface_trait.type_params,
        super_traits: surface_trait.super_traits, where_clause: surface_trait.where_clause,
        methods: methods, assoc_types: surface_trait.assoc_types,
        visibility: surface_trait.visibility, is_public: surface_trait.is_public,
        has_doc_comment: false, doc_comment: "", span: surface_trait.span)

fn hir_surface_enum_to_enum(surface_enum: ModuleSurfaceEnum, local_name: text) -> ParserEnum:
    ParserEnum(name: local_name, type_params: surface_enum.type_params,
        variants: surface_enum.variants, visibility: surface_enum.visibility,
        is_public: surface_enum.is_public, has_doc_comment: false,
        doc_comment: "", span: surface_enum.span)

fn _hir_text_index_of(value: text, needle: text) -> i64:
    if needle == "":
        return 0
    if not value.contains(needle):
        return -1
    rt_string_len(value.split(needle)[0])

fn hir_module_logical_name_from_path(path: text) -> text:
    """Derive the dotted logical module name (e.g. `_wallB_mod_a`) from a
    source path (e.g. `src/_wallB_mod_a.spl`), matching
    `_driver_module_name_from_path` (80.driver/driver_source_loading.spl) --
    reimplemented locally rather than imported to avoid a 20.hir ->
    80.driver layering violation. Under `SIMPLE_BOOTSTRAP=1`,
    `ParserModule.name`/`HirModule.name` is the raw parsed PATH
    (`flat_ast_to_module`, `_FlatAstBridge/module_assembly.spl`, `name:
    path`), not the logical name an `use module.{..}` import statement
    references -- qualifying a function's accumulator/symbol name by the
    RAW path instead of this normalized form would mismatch the plain
    `imp.module` text used at cross-module call sites and produce an
    unparseable `/`- and `.`-laden LLVM identifier (bug
    bootstrap_stage2_empty_mir_bodies_2026-07-05, Probe B)."""
    var mod_path = path.replace("\\", "/")
    while mod_path.starts_with("../"):
        mod_path = mod_path.substring(3)
    if mod_path.starts_with("./"):
        mod_path = mod_path.substring(2)
    val absolute_src = _hir_text_index_of(mod_path, "/src/")
    if absolute_src >= 0:
        mod_path = mod_path.substring(absolute_src + 5)
    else:
        val absolute_examples = _hir_text_index_of(mod_path, "/examples/")
        if absolute_examples >= 0:
            mod_path = mod_path.substring(absolute_examples + 1)
    if mod_path.starts_with("src/"):
        mod_path = mod_path.substring(4)
    mod_path = mod_path.replace(".spl", "")
    mod_path = mod_path.replace(".sdn", "")
    var portable = ""
    # WORKAROUND (keep byte-identical in all four copies): `for ch in <text>`
    # yields a corrupted loop element in the seed interpreter and in
    # pure-Simple-compiled native code, classifying every char unkeepable ->
    # all-underscore module names -> spurious stage4 collision. Explicit
    # char_code_at indexing decodes correctly (see
    # doc/08_tracking/bug/for_loop_over_text_char_code_at_zero_len_crash_2026-07-19.md).
    var _san_i = 0
    val _san_n = mod_path.len()
    while _san_i < _san_n:
        val _san_code = mod_path.char_code_at(_san_i)
        val keep = (_san_code >= 97 and _san_code <= 122) or (_san_code >= 65 and _san_code <= 90) or (_san_code >= 48 and _san_code <= 57) or _san_code == 95 or _san_code == 46 or _san_code == 47
        if keep:
            portable = portable + mod_path.char_at(_san_i)
        else:
            portable = portable + "_"
        _san_i = _san_i + 1
    mod_path = portable
    mod_path.replace("/", ".")

fn hir_module_package_name(module_name: text) -> text:
    val logical_name = hir_module_logical_name_from_path(module_name)
    if logical_name.ends_with(".__init__"):
        return logical_name[0:logical_name.len() - 9]
    val last_dot = logical_name.last_index_of(".")
    if last_dot >= 0:
        return logical_name[0:last_dot]
    ""

fn hir_module_is_bootstrap_entry(module_name: text) -> bool:
    """Whether `module_name` (a raw parsed-module path, e.g.
    `src/_wallB_entry.spl`) is the --entry-closure entry module. Used to
    keep the entry module's own same-module function-name qualification OFF
    (bootstrap_lower_hir_globals_to_mir_module, the entry's flat MIR
    accumulator, never qualifies names -- see bootstrap_globals.spl) while
    turning it ON for closure helper modules (whose flat accumulator,
    bootstrap_lower_extra_hir_module_to_mir, always qualifies by
    module.function to avoid same-name collisions across modules, bug
    bootstrap_stage2_empty_mir_bodies_2026-07-05, Probe B)."""
    val entry_path = hir_module_env_get("SIMPLE_NATIVE_BUILD_ENTRY") ?? ""
    if entry_path == "":
        return false
    hir_module_logical_name_from_path(entry_path) == hir_module_logical_name_from_path(module_name)

impl HirLowering:
    me prescan_composite_field_types(name: text, fields: [ParserField]):
        """Register parser struct/class fields before function lowering."""
        var field_types: Dict<text, HirType> = {}
        var field_order: [text] = []
        for field in fields:
            field_types[field.name] = self.lower_type(field.type_)
            field_order = field_order.push(field.name)
        self.struct_field_types_by_name[name] = field_types
        self.struct_field_order_by_name[name] = field_order

    # Nested-field-access support (native --entry path bug, see
    # struct_field_types_by_name doc comment in types.spl): record this
    # struct's field NAME -> declared HirType, purely from the static
    # declaration (`struct S: arr: [i64]`), independent of any inference.
    # Used later by Field-expr lowering to give a chained/array/struct-typed
    # field access its real MIR type instead of the untyped-path's i64
    # default (which silently reads garbage for a non-i64 field, e.g. an
    # array field indexed on the native path).
    me register_struct_field_types(hir_struct: HirStruct):
        var field_types: Dict<text, HirType> = {}
        for f in hir_struct.fields:
            field_types[f.name] = f.type_
        self.struct_field_types_by_name[hir_struct.name] = field_types

    # Untyped-return inference (native --entry path) -- see the `ReturnScan`
    # doc comment in lowering_helpers.spl for the full rationale. Runs over
    # the raw parser AST (`ParserFunction.body`), NOT the HIR, because it has to
    # happen during this module's up-front signature-declaration pass --
    # before ANY function body is lowered -- so a caller elsewhere in the
    # module sees the promoted return type too, not just the callee's own
    # generated `ret` instruction.
    me infer_untyped_return_type(fn_decl: ParserFunction) -> HirType:
        val fn_body: Block = fn_decl.body
        val fn_params: [Param] = fn_decl.params
        val scan = self.scan_ast_block_for_returns(fn_body, fn_params)
        if not scan.found_value_return:
            return HirType(kind: HirTypeKind.Unit, span: fn_decl.span)
        if scan.ambiguous or not scan.resolved_name.?:
            if (hir_module_env_get("SIMPLE_BOOTSTRAP") ?? "") == "1":
                # The bootstrap route has no whole-program inference pass.
                # Preserve the value dynamically; Unit would discard it.
                return HirType(kind: HirTypeKind.Any, span: fn_decl.span)
            if not self.registering_import_symbols:
                self.error("untyped function returns a value: function '{fn_decl.name}' returns a value but declares no return type; add '-> T'", fn_decl.span)
            return HirType(kind: HirTypeKind.Unit, span: fn_decl.span)
        # if-val: .unwrap() is box-assuming and breaks flat optionals on the
        # stage4 native lane (bug doc 2026-07-23).
        if val rn = scan.resolved_name:
            return HirType(kind: hir_type_kind_from_simple_name(rn), span: fn_decl.span)
        return HirType(kind: HirTypeKind.Unit, span: fn_decl.span)

    me declared_callable_type(fn_decl: ParserFunction, owner_symbol: SymbolId?) -> HirType?:
        # Generic callables keep the existing untyped-symbol behavior until
        # monomorphization supplies a concrete signature.
        if fn_decl.type_params.len() > 0:
            return nil
        # ParserImport/sibling registration is fail-soft: signature diagnostics
        # (untyped returns, param types unlowerable in the importer's
        # context) belong to the defining module's own pass. Register the
        # symbol untyped instead of erroring the importing module.
        if self.registering_import_symbols:
            return nil

        var param_types: [HirType] = []
        val raw_params = fn_decl.params
        var first_raw_param = 0
        match owner_symbol:
            case Some(owner_id):
                if not fn_decl.is_static:
                    param_types.push(HirType(
                        kind: HirTypeKind.Named(owner_id, []),
                        span: fn_decl.span
                    ))
                    if raw_params.len() > 0:
                        val receiver_param: Param = raw_params[0]
                        if receiver_param.name == "self" or receiver_param.name == "me":
                            first_raw_param = 1
            case None:
                ()
        while first_raw_param < raw_params.len():
            val raw_param: Param = raw_params[first_raw_param]
            val raw_param_type: Type = raw_param.type_
            param_types.push(self.lower_type(raw_param_type))
            first_raw_param = first_raw_param + 1

        val return_type = if fn_decl.has_return_type:
            val declared_return_type: Type = fn_decl.return_type
            self.lower_type(declared_return_type)
        else:
            self.infer_untyped_return_type(fn_decl)
        val callable_type = HirType(
            kind: HirTypeKind.Function(param_types, return_type, []),
            span: fn_decl.span
        )
        Some(callable_type)

    me declared_surface_callable_type(callable: ModuleSurfaceCallable, owner_symbol: SymbolId?) -> HirType?:
        if callable.type_params.len() > 0 or not callable.has_return_type:
            return nil
        if self.registering_import_symbols:
            return nil
        var param_types: [HirType] = []
        var param_idx = 0
        match owner_symbol:
            case Some(owner_id):
                if not callable.is_static:
                    param_types = param_types.push(HirType(kind: HirTypeKind.Named(owner_id, []), span: callable.span))
                    if callable.params.len() > 0:
                        val receiver = callable.params[0]
                        if receiver.name == "self" or receiver.name == "me":
                            param_idx = 1
            case None:
                ()
        while param_idx < callable.params.len():
            if not callable.params[param_idx].has_type_:
                return nil
            param_types = param_types.push(self.lower_type(callable.params[param_idx].type_))
            param_idx = param_idx + 1
        Some(HirType(kind: HirTypeKind.Function(param_types, self.lower_type(callable.return_type), []), span: callable.span))

    me infer_simple_type_name_ast(e: Expr, params: [Param]) -> text?:
        match e.kind:
            case ExprKind.IntLit(_):
                Some("i64")
            case ExprKind.FloatLit(_):
                Some("f64")
            case ExprKind.StringLit(_, _):
                Some("text")
            case ExprKind.BoolLit(_):
                Some("bool")
            case ExprKind.Ident(name):
                var i = 0
                var found: HirType? = nil
                while i < params.len():
                    val param: Param = params[i]
                    if param.name == name:
                        found = self.lower_type(param.type_)
                    i = i + 1
                var found_name: text? = nil
                if val found_t = found:
                    found_name = hir_type_simple_name(found_t)
                found_name
            case ExprKind.Unary(op, operand):
                match op:
                    case UnaryOp.Not:
                        Some("bool")
                    case UnaryOp.Neg:
                        self.infer_simple_type_name_ast(operand, params)
                    case _:
                        nil
            case ExprKind.Binary(op, left, right):
                if ast_binop_is_comparison(op):
                    Some("bool")
                elif ast_binop_is_arith(op):
                    val lt = self.infer_simple_type_name_ast(left, params)
                    val rt = self.infer_simple_type_name_ast(right, params)
                    var arith_name: text? = nil
                    if val lt_v = lt:
                        if val rt_v = rt:
                            if lt_v == rt_v and hir_simple_type_name_is_known(lt_v):
                                arith_name = lt
                    arith_name
                else:
                    nil
            case ExprKind.Cast(_, target):
                hir_type_simple_name(self.lower_type(target))
            case _:
                # Anything else (a call, index, field access, struct/enum
                # literal, ...) is deliberately left un-inferred here rather
                # than guessed at -- this also conservatively covers a
                # self-recursive call: `return f(...)` (whether or not `f`
                # is the function being scanned) always resolves to `nil`,
                # which `merge_return_scan` turns into `ambiguous`, which
                # `infer_untyped_return_type` turns into the fatal route-(b)
                # error instead of a silently-wrong return type.
                nil

    me scan_ast_block_for_returns(b: Block, params: [Param]) -> ReturnScan:
        var acc = return_scan_empty()
        for stmt in b.stmts:
            acc = merge_return_scan(acc, self.scan_ast_stmt_for_returns(stmt, params))
        acc

    me scan_ast_stmt_for_returns(s: Stmt, params: [Param]) -> ReturnScan:
        # `Expr` is also a struct name. On the pure-Simple stage4 path a broad
        # match can treat this arm as irrefutable and pass the enum's raw tuple
        # payload to scan_ast_expr_for_returns. Dispatch by discriminant first.
        val nil_expr = Expr(kind: ExprKind.NilLit, span: s.span)
        val expr_stmt_disc = rt_enum_discriminant(StmtKind.Expr(nil_expr))
        val stmt_kind = s.kind
        val stmt_disc = rt_enum_discriminant(stmt_kind)
        if stmt_disc >= 0 and stmt_disc == expr_stmt_disc:
            val expr: Expr = rt_enum_payload(stmt_kind)
            return self.scan_ast_expr_for_returns(expr, params)
        match s.kind:
            case StmtKind.Val(_, _, init):
                self.scan_ast_expr_for_returns(init, params)
            case StmtKind.Var(_, _, init):
                var var_scan = return_scan_empty()
                if val init_e = init:
                    var_scan = self.scan_ast_expr_for_returns(init_e, params)
                var_scan
            case StmtKind.Assign(target, _, value):
                merge_return_scan(self.scan_ast_expr_for_returns(target, params), self.scan_ast_expr_for_returns(value, params))
            case StmtKind.Return(value):
                var ret_scan = return_scan_empty()
                if val v = value:
                    ret_scan = ReturnScan(found_value_return: true, resolved_name: self.infer_simple_type_name_ast(v, params), ambiguous: false)
                ret_scan
            case StmtKind.For(_, iter, body):
                merge_return_scan(self.scan_ast_expr_for_returns(iter, params), self.scan_ast_block_for_returns(body, params))
            case StmtKind.While(cond, body):
                merge_return_scan(self.scan_ast_expr_for_returns(cond, params), self.scan_ast_block_for_returns(body, params))
            case StmtKind.Loop(body):
                self.scan_ast_block_for_returns(body, params)
            case StmtKind.Yield(value):
                var yield_scan = return_scan_empty()
                if val yv = value:
                    yield_scan = self.scan_ast_expr_for_returns(yv, params)
                yield_scan
            case StmtKind.Throw(value):
                self.scan_ast_expr_for_returns(value, params)
            case StmtKind.With(_, body):
                self.scan_ast_block_for_returns(body, params)
            case _:
                return_scan_empty()

    # Walks reachable sub-expressions looking for `return <value>` sites,
    # EXCEPT inside a nested `Lambda` body (its own function scope -- a
    # `return` inside one belongs to the closure, not this function). Rare
    # shapes fall through to `case _` (no descent): under-covering here is
    # conservative, not unsound -- a `return` hidden in an unhandled shape is
    # exactly as broken as it already was before this change (the
    # pre-existing Unit-return default is unchanged), so it cannot regress a
    # working case.
    me scan_ast_expr_for_returns(e: Expr, params: [Param]) -> ReturnScan:
        match e.kind:
            case ExprKind.Return(value):
                var ret_scan = return_scan_empty()
                if val v = value:
                    ret_scan = ReturnScan(found_value_return: true, resolved_name: self.infer_simple_type_name_ast(v, params), ambiguous: false)
                ret_scan
            case ExprKind.If(cond, then_, else_):
                var acc = merge_return_scan(self.scan_ast_expr_for_returns(cond, params), self.scan_ast_block_for_returns(then_, params))
                if val else_b = else_:
                    acc = merge_return_scan(acc, self.scan_ast_block_for_returns(else_b, params))
                acc
            case ExprKind.MatchCase(scrutinee, arms):
                var acc = self.scan_ast_expr_for_returns(scrutinee, params)
                for arm in arms:
                    acc = merge_return_scan(acc, self.scan_ast_block_for_returns(arm.body, params))
                    if arm.has_guard:
                        acc = merge_return_scan(acc, self.scan_ast_expr_for_returns(arm.guard, params))
                acc
            case ExprKind.TryCatch(body, clauses, finally_):
                var acc = self.scan_ast_block_for_returns(body, params)
                for clause in clauses:
                    acc = merge_return_scan(acc, self.scan_ast_block_for_returns(clause.body, params))
                if val fin_b = finally_:
                    acc = merge_return_scan(acc, self.scan_ast_block_for_returns(fin_b, params))
                acc
            case ExprKind.Block(block):
                self.scan_ast_block_for_returns(block, params)
            case ExprKind.LossBlock(body):
                self.scan_ast_block_for_returns(body, params)
            case ExprKind.NogradBlock(body):
                self.scan_ast_block_for_returns(body, params)
            case ExprKind.UnsafeBlock(body):
                self.scan_ast_block_for_returns(body, params)
            case ExprKind.Lambda(_, _):
                return_scan_empty()
            case ExprKind.Binary(_, left, right):
                merge_return_scan(self.scan_ast_expr_for_returns(left, params), self.scan_ast_expr_for_returns(right, params))
            case ExprKind.Unary(_, operand):
                self.scan_ast_expr_for_returns(operand, params)
            case ExprKind.Call(callee, args):
                var acc = self.scan_ast_expr_for_returns(callee, params)
                for a in args:
                    acc = merge_return_scan(acc, self.scan_ast_expr_for_returns(a.value, params))
                acc
            case ExprKind.MethodCall(receiver, _, args):
                var acc = self.scan_ast_expr_for_returns(receiver, params)
                for a in args:
                    acc = merge_return_scan(acc, self.scan_ast_expr_for_returns(a.value, params))
                acc
            case ExprKind.Cast(expr, _):
                self.scan_ast_expr_for_returns(expr, params)
            case ExprKind.Index(base, index):
                merge_return_scan(self.scan_ast_expr_for_returns(base, params), self.scan_ast_expr_for_returns(index, params))
            case ExprKind.Field(base, _):
                self.scan_ast_expr_for_returns(base, params)
            case ExprKind.OptionalChain(base, _):
                self.scan_ast_expr_for_returns(base, params)
            case ExprKind.NullCoalesce(left, right):
                merge_return_scan(self.scan_ast_expr_for_returns(left, params), self.scan_ast_expr_for_returns(right, params))
            case ExprKind.ExistsCheck(base):
                self.scan_ast_expr_for_returns(base, params)
            case ExprKind.ForceUnwrap(base):
                self.scan_ast_expr_for_returns(base, params)
            case ExprKind.Range(start, end, _, step):
                var acc = return_scan_empty()
                if val start_e = start:
                    acc = merge_return_scan(acc, self.scan_ast_expr_for_returns(start_e, params))
                if val end_e = end:
                    acc = merge_return_scan(acc, self.scan_ast_expr_for_returns(end_e, params))
                if val step_e = step:
                    acc = merge_return_scan(acc, self.scan_ast_expr_for_returns(step_e, params))
                acc
            case ExprKind.Await(expr):
                self.scan_ast_expr_for_returns(expr, params)
            case ExprKind.Yield(value):
                var yield_scan = return_scan_empty()
                if val yv = value:
                    yield_scan = self.scan_ast_expr_for_returns(yv, params)
                yield_scan
            case ExprKind.Throw(value):
                self.scan_ast_expr_for_returns(value, params)
            case ExprKind.Try(expr):
                self.scan_ast_expr_for_returns(expr, params)
            case ExprKind.ArrayLit(elements):
                var acc = return_scan_empty()
                for el in elements:
                    acc = merge_return_scan(acc, self.scan_ast_expr_for_returns(el, params))
                acc
            case ExprKind.TupleLit(elements):
                var acc = return_scan_empty()
                for el in elements:
                    acc = merge_return_scan(acc, self.scan_ast_expr_for_returns(el, params))
                acc
            case ExprKind.SetLit(elements):
                var acc = return_scan_empty()
                for el in elements:
                    acc = merge_return_scan(acc, self.scan_ast_expr_for_returns(el, params))
                acc
            case ExprKind.ArrayRepeat(value, count):
                merge_return_scan(self.scan_ast_expr_for_returns(value, params), self.scan_ast_expr_for_returns(count, params))
            case ExprKind.Break(_):
                return_scan_empty()
            case _:
                return_scan_empty()

    me register_imported_symbol(imported_mod: ModuleSurface, imported_mod_name: text, imported_name: text, local_name: text, import_span: Span):
        if imported_mod.composites.contains_key(imported_name):
            val composite = imported_mod.composites[imported_name]
            val already_bound = self.symbols.lookup(local_name).?
            val kind = match composite.kind:
                case "class": SymbolKind.Class
                case "struct": SymbolKind.Struct
                case "actor":
                    self.error("imported actor `{imported_name}` has no HIR SymbolKind surface mapping", import_span)
                    return
                case other:
                    self.error("unknown imported composite kind `{other}` for `{imported_name}`", import_span)
                    return
            val imported_type = self.symbols.define(local_name, kind, nil, import_span, Visibility.Public, false, Some(imported_mod.module_name))
            if not already_bound:
                self.symbols.rename_symbol(imported_type, imported_name)
                self.register_imported_type_methods(imported_mod, imported_mod_name, imported_name, imported_type, import_span)
        elif imported_mod.enums.contains_key(imported_name):
            val already_bound = self.symbols.lookup(local_name).?
            val imported_type = self.symbols.define(local_name, SymbolKind.Enum, nil, import_span, Visibility.Public, false, Some(imported_mod.module_name))
            if not already_bound:
                self.symbols.rename_symbol(imported_type, imported_name)
                self.imported_enums[local_name] = hir_surface_enum_to_enum(imported_mod.enums[imported_name], local_name)
                self.imported_enum_owners[local_name] = imported_mod.module_name
                self.register_imported_type_methods(imported_mod, imported_mod_name, imported_name, imported_type, import_span)
        elif imported_mod.traits.contains_key(imported_name):
            self.symbols.define(local_name, SymbolKind.Trait, nil, import_span, Visibility.Public, false, Some(imported_mod.module_name))
            if not self.imported_traits.contains_key(local_name):
                self.imported_traits[local_name] = hir_surface_trait_to_trait(imported_mod.traits[imported_name], local_name)
            # lower_impl materializes defaults only when this trait is used.
        elif imported_mod.type_aliases.contains_key(imported_name):
            self.symbols.define(local_name, SymbolKind.TypeAlias, nil, import_span, Visibility.Public, false, Some(imported_mod.module_name))
        elif imported_mod.callables.contains_key(imported_name):
            val fn_type = self.declared_surface_callable_type(imported_mod.callables[imported_name], nil)
            val imported_fn_sym = self.symbols.define(local_name, SymbolKind.Function, fn_type, import_span, Visibility.Public, false, Some(imported_mod.module_name))
            self.qualify_imported_function_symbol(imported_fn_sym, imported_mod.module_name, imported_name)
        elif imported_mod.constants.contains_key(imported_name):
            self.symbols.define(local_name, SymbolKind.Const, nil, import_span, Visibility.Public, false, Some(imported_mod.module_name))
        else:
            # Re-export facade chase: the imported module does not declare
            # `imported_name` itself — it may re-export it (`export use
            # backend.{name}`), e.g. std.env.types forwarding the rt_env_*
            # externs from std.nogc_sync_mut.env.types. Without this, the
            # import silently registered NOTHING and every use site died
            # later with "unresolved name: rt_env_get" (native-build
            # entry-closure path; parity case dynload_tagged_text).
            val hop = self.find_reexport_source(imported_mod, imported_mod_name, imported_name, 0)
            if (rt_env_get("SIMPLE_BOOTSTRAP_DIAG") ?? "") == "1":
                eprint("[reexport-chase] mod={imported_mod_name} wanted={imported_name} imports={imported_mod.imports.len()} exports={imported_mod.exports.len()} found={hop.found} mname={imported_mod.module_name} fns={imported_mod.callables.keys().len()}")
            if hop.found:
                val source_mod = hir_module_surface_get(self.module_surfaces, hop.module_name)
                if source_mod != nil:
                    self.register_imported_symbol(source_mod.unwrap(), hop.module_name, hop.item_name, local_name, import_span)

    me try_register_bootstrap_global_symbol(name: text, span: Span) -> bool:
        """Resolve one uniquely owned flat-global bootstrap declaration."""
        if (hir_module_env_get("SIMPLE_BOOTSTRAP") ?? "") != "1":
            return false
        if self.symbols.lookup(name).?:
            return true
        var matching_index: i64 = -1
        var surface_index: i64 = 0
        while surface_index < self.module_surfaces.surfaces.len():
            val surface = self.module_surfaces.surfaces[surface_index]
            if hir_module_declares_item(surface, name):
                if matching_index >= 0:
                    return false
                matching_index = surface_index
            surface_index = surface_index + 1
        if matching_index < 0:
            return false
        val owner = self.module_surfaces.surfaces[matching_index]
        self.register_imported_symbol(owner, owner.module_name, name, name, span)
        self.symbols.lookup(name).?

    me resolve_module_key(name: text) -> text:
        """Canonical modules_by_name key for an import path, or "".
        Closure files register ONLY under path-derived names
        (src/lib/nogc_sync_mut/io_runtime.spl -> lib.nogc_sync_mut.io_runtime;
        a package __init__.spl carries a .__init__ suffix), while import lines
        say std.io_runtime / nogc_sync_mut.io_runtime / std.common.json.
        Try the literal key, then the package facade, the lib.-prefix mirror,
        and the std.->lib. swap (each with .__init__)."""
        if self.module_surfaces.index_by_name.contains_key(name):
            return name
        var cands: [text] = []
        cands = cands.push(name + ".__init__")
        cands = cands.push("lib." + name)
        cands = cands.push("lib." + name + ".__init__")
        if name.starts_with("std."):
            val std_tail = name.substring(4)
            val lib_tail = "lib." + std_tail
            cands = cands.push(lib_tail)
            cands = cands.push(lib_tail + ".__init__")
            # std.X also flattens the concurrency-tier dirs (seed interpreter
            # family-fallback order): std.mcp_sdk.server.method_detect
            # registers as lib.nogc_sync_mut.mcp_sdk.server.method_detect.
            for tier in ["nogc_async_mut", "nogc_sync_mut", "nogc_async_immut", "common", "gc_async_mut", "nogc_async_mut_noalloc"]:
                val tier_key = "lib." + tier + "." + std_tail
                cands = cands.push(tier_key)
                cands = cands.push(tier_key + ".__init__")
                # Files reached via the src/std -> lib symlink derive their
                # module name with the std. prefix (src/std/nogc_sync_mut/
                # simd.spl -> std.nogc_sync_mut.simd) — try that spelling too.
                val tier_std_key = "std." + tier + "." + std_tail
                cands = cands.push(tier_std_key)
                cands = cands.push(tier_std_key + ".__init__")
        var ci = 0
        while ci < cands.len():
            if self.module_surfaces.index_by_name.contains_key(cands[ci]):
                return cands[ci]
            ci = ci + 1
        ""

    me resolve_module_key_relative(name: text, ctx_name: text) -> text:
        """resolve_module_key, but first normalizes a RELATIVE module path
        (".types", "..pkg.mod") against `ctx_name` — the canonical registered
        key of the module the path appears IN.

        resolve_module_key only knows absolute spellings (literal key, the
        .__init__ facade, the lib.-prefix mirrors, the std.->lib. swap), so a
        leading dot always misses there: the registry is keyed by path-derived
        dotted names. Relative paths reach the re-export chase from two places
        — `export use .types.{X}` written by hand, and `export X from types`,
        which the parser emits as ".types" (e599a617d6ef).

        Normalization matches resolve_import_symbols' relative branch: drop one
        trailing segment per leading dot, then splice the tail on.
        hir_module_package_name drops exactly one segment per call and treats a
        package facade's ".__init__" as that segment, which is the behaviour a
        single dot needs — lib.a.easy_fix.__init__ + ".types" resolves to
        lib.a.easy_fix.types, so a facade needs no special case."""
        if not name.starts_with("."):
            return self.resolve_module_key(name)
        var rel_dots = 0
        while rel_dots < name.len() and name.substring(rel_dots, rel_dots + 1) == ".":
            rel_dots = rel_dots + 1
        val rel_tail = name.substring(rel_dots)
        if rel_tail == "":
            return ""
        var rel_pkg = hir_module_logical_name_from_path(ctx_name)
        var rel_i = 0
        while rel_i < rel_dots:
            rel_pkg = hir_module_package_name(rel_pkg)
            rel_i = rel_i + 1
        val rel_abs = if rel_pkg == "": rel_tail else: rel_pkg + "." + rel_tail
        if self.module_surfaces.index_by_name.contains_key(rel_abs):
            return rel_abs
        # The spliced path can still need the canonical-key fallbacks: a
        # relative hop landing on a package directory resolves via .__init__.
        self.resolve_module_key(rel_abs)

    me find_reexport_source(facade_mod: ModuleSurface, facade_name: text, wanted: text, depth: i64) -> HirReexportSource:
        """Resolve which transitive module actually DECLARES `wanted` when
        `facade_mod` only re-exports it. Follows the facade's own imports
        (explicit items, alias-aware; glob imports too) up to a small depth
        bound so import cycles terminate. Only returns a module that declares
        the item directly, so the caller's re-entry into
        register_imported_symbol cannot recurse back in here for that hit."""
        if depth > 8:
            return HirReexportSource(found: false, module_name: "", item_name: "")
        if facade_mod.export_origins.contains_key(wanted):
            val origin = facade_mod.export_origins[wanted]
            return HirReexportSource(
                found: true,
                module_name: origin.owner_module,
                item_name: origin.source_name
            )
        var import_idx = 0
        while import_idx < facade_mod.imports.len():
            val imp = facade_mod.imports[import_idx]
            var matches = imp.items.len() == 0
            var source_item = wanted
            var item_idx = 0
            while item_idx < imp.items.len():
                val item = imp.items[item_idx]
                val local = if item.has_alias: item.alias else: item.name
                # An ALIASED item must be chaseable from BOTH ends. The
                # consumer route asks for the LOCAL (alias) spelling — `use
                # facade.{T32BridgeResult}`. The export-surface route asks for
                # the SOURCE spelling: `export use M.{AccessResult as
                # T32BridgeResult}` is recorded as the export item
                # "AccessResult:T32BridgeResult", and
                # register_glob_imported_symbols_depth hands its export_source
                # ("AccessResult") back here as `wanted`. Matching only `local`
                # dead-ended that second route, so the facade's own re-export
                # surface could never resolve an aliased name and the
                # directory-package sibling registration that rescues every
                # other name in the package could not rescue this one.
                if local == wanted or item.name == wanted:
                    matches = true
                    source_item = item.name
                item_idx = item_idx + 1
            if matches:
                # Canonical-key fallback: `export use nogc_sync_mut.io_runtime`
                # inside src/lib/io_runtime.spl names a module registered as
                # lib.nogc_sync_mut.io_runtime — the literal key always misses.
                # A RELATIVE hop (`export use .types.{X}`, or the ".types" the
                # parser emits for `export X from types`) normalizes against
                # the facade's own key, or the chase dead-ends on every
                # package facade that re-exports its members that way.
                val next_key = self.resolve_module_key_relative(imp.module, facade_name)
                val next_mod = if next_key != "": hir_module_surface_get(self.module_surfaces, next_key) else: nil
                if next_mod != nil:
                    if hir_module_declares_item(next_mod.unwrap(), source_item):
                        return HirReexportSource(found: true, module_name: next_key, item_name: source_item)
                    val deeper = self.find_reexport_source(next_mod.unwrap(), next_key, source_item, depth + 1)
                    if deeper.found:
                        return deeper
            import_idx = import_idx + 1
        # Package-facade star exports: an __init__.spl re-exports member
        # files via `export member.*` (std.common.json's `export
        # array_ops.*`). Those are EXPORT items, not imports, so the import
        # walk above never sees them — chase them as siblings of the facade.
        var exp_idx = 0
        while exp_idx < facade_mod.exports.len():
            val exp = facade_mod.exports[exp_idx]
            var exp_item_idx = 0
            while exp_item_idx < exp.items.len():
                val exp_item = exp.items[exp_item_idx]
                if exp_item.ends_with(".*"):
                    val exp_base = exp_item[0:exp_item.len() - 2]
                    # facade_name is the canonical registered key, which for
                    # a package facade ends in .__init__; full dotted export
                    # paths remain relative to that package.
                    val facade_pkg = hir_module_package_name(facade_name)
                    var exp_sib_name = ""
                    if exp_base.starts_with("."):
                        exp_sib_name = self.resolve_module_key_relative(exp_base, facade_name)
                    else:
                        exp_sib_name = self.resolve_module_key(facade_pkg + "." + exp_base)
                        if exp_sib_name == "":
                            exp_sib_name = self.resolve_module_key(exp_base)
                    val exp_sib = if exp_sib_name != "": hir_module_surface_get(self.module_surfaces, exp_sib_name) else: nil
                    if exp_sib != nil:
                        if hir_module_declares_item(exp_sib.unwrap(), wanted):
                            return HirReexportSource(found: true, module_name: exp_sib_name, item_name: wanted)
                        val exp_deeper = self.find_reexport_source(exp_sib.unwrap(), exp_sib_name, wanted, depth + 1)
                        if exp_deeper.found:
                            return exp_deeper
                else:
                    # `split(":")` allocates an array per visit, and this loop
                    # runs once per export item PER wanted name -- O(E^2) on a
                    # package facade. Only the aliased form ("src:local")
                    # needs the split.
                    var exp_source = exp_item
                    var exp_local = exp_item
                    if exp_item.contains(":"):
                        val exp_parts = exp_item.split(":")
                        exp_source = exp_parts[0]
                        if exp_parts.len() > 1:
                            exp_local = exp_parts[1]
                        else:
                            exp_local = exp_source
                    if exp_local == wanted:
                        if hir_module_declares_item(facade_mod, exp_source):
                            return HirReexportSource(found: true, module_name: facade_name, item_name: exp_source)
                        # A plain `export foo` (no alias) has exp_source ==
                        # wanted, so this chase would re-enter with IDENTICAL
                        # (facade_mod, facade_name, wanted) and only a smaller
                        # depth budget -- it re-scans the whole export list to
                        # rediscover THIS item and recurse again, all the way to
                        # the depth bound. A deeper budget explores a strict
                        # subset of what this invocation already explores, so
                        # the self-hop can never contribute a hit; it only
                        # multiplies the O(E^2) scan by the depth bound.
                        # Measured on compiler.10.frontend.core.__init__ (1,367
                        # export items): 26.0 M allocations / 162 s for ONE
                        # importing file. Chase only a REAL alias hop.
                        if exp_source != wanted:
                            val alias_source = self.find_reexport_source(facade_mod, facade_name, exp_source, depth + 1)
                            if alias_source.found:
                                return alias_source
                exp_item_idx = exp_item_idx + 1
            exp_idx = exp_idx + 1
        HirReexportSource(found: false, module_name: "", item_name: "")

    me register_imported_type_methods(imported_mod: ModuleSurface, imported_mod_name: text, imported_name: text, local_owner: SymbolId, import_span: Span):
        val owner_module = hir_module_logical_name_from_path(imported_mod_name)
        for impl_ in imported_mod.impls:
            if parser_type_kind_named_name(impl_.type_.kind) != imported_name:
                continue
            for method_name in impl_.methods.keys():
                val method = impl_.methods[method_name]
                val symbol_name = "{owner_module}.{imported_name}::{method_name}"
                if not self.symbols.lookup_or_invalid(symbol_name).is_valid():
                    val kind = if method.is_static: SymbolKind.Function else: SymbolKind.Method
                    val method_type = self.declared_surface_callable_type(method, Some(local_owner))
                    self.symbols.define(symbol_name, kind, method_type, import_span, Visibility.Public, false, Some(imported_mod_name))
            if impl_.has_trait_:
                val trait_name = parser_type_kind_named_name(impl_.trait_.kind)
                var trait_module: ModuleSurface? = Some(imported_mod)
                var trait_source_name = trait_name
                if not imported_mod.traits.contains_key(trait_source_name):
                    val trait_source = self.find_reexport_source(imported_mod, imported_mod_name, trait_name, 0)
                    if trait_source.found:
                        trait_module = hir_module_surface_get(self.module_surfaces, trait_source.module_name)
                        trait_source_name = trait_source.item_name
                if trait_module != nil and trait_module.unwrap().traits.contains_key(trait_source_name):
                    val trait_ = trait_module.unwrap().traits[trait_source_name]
                    for trait_method in trait_.methods:
                        val symbol_name = "{owner_module}.{imported_name}::{trait_method.name}"
                        if not self.symbols.lookup_or_invalid(symbol_name).is_valid():
                            val kind = if trait_method.is_static: SymbolKind.Function else: SymbolKind.Method
                            val method_type = self.declared_surface_callable_type(trait_method, Some(local_owner))
                            self.symbols.define(symbol_name, kind, method_type, import_span, Visibility.Public, false, Some(imported_mod_name))

    me qualify_imported_function_symbol(sym_id: SymbolId, imported_mod_name: text, imported_name: text):
        """Under a --entry-closure bootstrap build, rename a cross-module
        imported function's stored symbol name to `<module>.<original name>`
        so it stays distinct from a same-named function imported (under
        whatever local alias) from a DIFFERENT module. `resolve_import_symbols`
        registers the symbol under the LOCAL alias (`local_name`, e.g.
        `compute_a`) for scope lookup, but the flat bootstrap MIR accumulator
        (`bootstrap_lower_extra_hir_module_to_mir`,
        `_MirLowering/bootstrap_globals.spl`) keys/emits each closure module's
        functions the same qualified way -- without this, MIR call-site
        emission (which resolves the call name from this symbol) and the
        accumulator's emitted definitions can name the SAME symbol two
        different ways, or two DIFFERENT modules' same-named functions the
        SAME way (bug bootstrap_stage2_empty_mir_bodies_2026-07-05, Probe B).
        A plain (non-closure) bootstrap_main.spl build has no cross-module
        imports to qualify, and a normal (non-bootstrap) compile keeps the
        local alias name -- both are unaffected by this rename."""
        val bootstrap_mode = (hir_module_env_get("SIMPLE_BOOTSTRAP") ?? "") == "1"
        val bootstrap_closure = bootstrap_mode and (hir_module_env_get("SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE") ?? "") == "1"
        if bootstrap_closure:
            self.symbols.rename_symbol(sym_id, "{imported_mod_name}.{imported_name}")

    me register_glob_imported_symbols(imported_mod: ModuleSurface, imported_mod_name: text, import_span: Span):
        # GLB2: the memo is scoped to ONE root expansion. Resetting it here (not
        # once per module being lowered) keeps the deviation from the
        # un-memoized walk minimal: only within-root repeat expansions are
        # elided, and every root still expands its own closure from scratch.
        val fresh_memo: {text: i64} = {}
        self.glob_expand_memo = fresh_memo
        self.register_glob_imported_symbols_depth(imported_mod, imported_mod_name, import_span, 0)

    me register_glob_imported_symbols_depth(imported_mod: ModuleSurface, imported_mod_name: text, import_span: Span, depth: i64):
        if depth > 8:
            return
        # GLB2 (2026-08-01): cycle/re-entry memo -- see glob_expand_memo in
        # hir_lowering/types.spl. Skip only when this key was ALREADY expanded
        # at the same or a shallower depth; a shallower arrival re-expands
        # because it can reach further before the depth cap bites.
        # Bracket-index read after contains_key: Dict.get() on the self-hosted
        # native path corrupts/mis-reports present values.
        if self.glob_expand_memo.contains_key(imported_mod_name):
            val seen_depth: i64 = self.glob_expand_memo[imported_mod_name]
            if seen_depth <= depth:
                return
        self.glob_expand_memo[imported_mod_name] = depth
        var keys = imported_mod.composites.keys()
        var idx = 0
        while idx < keys.len():
            self.register_imported_symbol(imported_mod, imported_mod_name, keys[idx], keys[idx], import_span)
            idx = idx + 1

        keys = imported_mod.enums.keys()
        idx = 0
        while idx < keys.len():
            self.register_imported_symbol(imported_mod, imported_mod_name, keys[idx], keys[idx], import_span)
            idx = idx + 1

        keys = imported_mod.traits.keys()
        idx = 0
        while idx < keys.len():
            self.register_imported_symbol(imported_mod, imported_mod_name, keys[idx], keys[idx], import_span)
            idx = idx + 1

        keys = imported_mod.callables.keys()
        idx = 0
        while idx < keys.len():
            self.register_imported_symbol(imported_mod, imported_mod_name, keys[idx], keys[idx], import_span)
            idx = idx + 1

        keys = imported_mod.type_aliases.keys()
        idx = 0
        while idx < keys.len():
            self.register_imported_symbol(imported_mod, imported_mod_name, keys[idx], keys[idx], import_span)
            idx = idx + 1

        keys = imported_mod.constants.keys()
        idx = 0
        while idx < keys.len():
            self.register_imported_symbol(imported_mod, imported_mod_name, keys[idx], keys[idx], import_span)
            idx = idx + 1

        # A split module can explicitly re-export names it imports. Register
        # those names through the facade so find_reexport_source resolves the
        # actual defining module without expanding unrelated imports.
        var export_idx = 0
        while export_idx < imported_mod.exports.len():
            val export_decl = imported_mod.exports[export_idx]
            var export_item_idx = 0
            while export_item_idx < export_decl.items.len():
                val export_item = export_decl.items[export_item_idx]
                if export_item.ends_with(".*"):
                    val export_base = export_item[0:export_item.len() - 2]
                    val facade_pkg = hir_module_package_name(imported_mod_name)
                    var export_key = ""
                    if export_base.starts_with("."):
                        export_key = self.resolve_module_key_relative(export_base, imported_mod_name)
                    else:
                        export_key = self.resolve_module_key(facade_pkg + "." + export_base)
                        if export_key == "":
                            export_key = self.resolve_module_key(export_base)
                    val export_surface = if export_key != "": hir_module_surface_get(self.module_surfaces, export_key) else: nil
                    if export_surface != nil and export_key != imported_mod_name:
                        self.register_glob_imported_symbols_depth(export_surface.unwrap(), export_key, import_span, depth + 1)
                else:
                    val export_parts = export_item.split(":")
                    val export_source = export_parts[0]
                    val export_local = if export_parts.len() > 1: export_parts[1] else: export_source
                    if export_local != export_source or not hir_module_declares_item(imported_mod, export_source):
                        self.register_imported_symbol(imported_mod, imported_mod_name, export_source, export_local, import_span)
                export_item_idx = export_item_idx + 1
            export_idx = export_idx + 1

        # Facade globs: `use std.simd.*` can resolve to a tier FACADE (e.g.
        # lib/nogc_async_mut/simd.spl) whose own decl dicts are empty — it
        # only `export use`-re-exports items from the owning tier module.
        # Register each of the facade's import items too; the ones the facade
        # doesn't declare route through find_reexport_source inside
        # register_imported_symbol and land on the defining module's
        # canonical name.
        # GLB1 (2026-08-01): this whole loop used to be skipped for any module that
        # declared its own symbols or carried `export` decls. That gate is what made
        # `use compiler.mir.mir_data.*` leak nothing but mir_data's own declarations:
        # mir_data both declares items AND does
        # `use compiler.hir.hir_types.{SymbolId, HirType}`, and it has `export` decls
        # -- so the gate fired and the named-import re-registration below never ran.
        # Importers relying on the glob for those names (mir_text_codegen.spl,
        # vhdl_design_catalog.spl and ~57 more) died with "unresolved type: SymbolId".
        # The Rust seed resolves these flat over the loaded closure, which is why the
        # same sources compile clean through it.
        # Minimal repro (probe case E): leaf does `use probe.mid.*`; mid declares its
        # own struct AND does `use probe.defs.{MyTypeX}`; the leaf cannot see MyTypeX.
        #
        # The NAMED-item half is unconditional: it is one bounded hop per named item
        # (register_imported_symbol routes through find_reexport_source, itself
        # depth-capped) and does not recurse.
        #
        # GLB2 (2026-08-01): the NESTED-GLOB recursion STAYS gated on the
        # pure-facade shape (no own symbols AND no `export` decls). Ungating it
        # was measured on 2026-08-01: stage3 HIR lowering ran >13 min of CPU with
        # RSS climbing past 8.5 GB without finishing, versus ~6 min / ~2 GB gated,
        # because each glob re-expands every transitively globbed module up to the
        # depth-8 cap. The residual cost of leaving it gated is that names a module
        # reaches only through its OWN `use x.*` (MirOperand, MirType via
        # mir_data's `use compiler.mir.mir_types.*`) still do not leak through a
        # second-level glob; that is tracked separately rather than paid for here.
        #
        # GLB3 (2026-08-01) -- the gate was briefly DELETED in 3226faaf9eb and is
        # restored here. glob_expand_memo (below / in types.spl) is KEPT: the two
        # changes are separable and only the memo was ever justified.
        #   * memo, gate ON:  0 import-winner swaps vs the un-memoized walk, and
        #     27,445 -> 9,133 module expansions over 3,553 roots (3.0x cheaper).
        #     Free and measurably identical, so it is KEPT. Precisely: with the
        #     gate ON the depth-8 cap alone already terminates (0 roots hit the
        #     cap un-memoized), so the memo is a 3x saving and a margin against
        #     the CYCLIC glob graph (168 directed 2-cycles over 3,026 `use x.*`
        #     edges), not the terminator. Un-GATED it is the difference between
        #     9,133 and 2,618,812 expansions, so if the gate is ever lifted again
        #     the memo must go with it.
        #   * ungate: 345 of 356 winner swaps, 33 of which move TYPE identity
        #     (BlockId, CompiledModule inside compiler.backend), and under
        #     SIMPLE_BOOTSTRAP=1 + SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE=1 the
        #     qualify_imported_function_symbol rename above makes the winner the
        #     EMITTED callee (239 divergent rows over 52 roots, including
        #     driver.driver and loader.module_loader). Its stated justification --
        #     closing MirOperand/MirType -- did not hold: neither was an observed
        #     failure at that tip and MirType stayed unresolved x77 in the patched
        #     arm. So it bought nothing measurable and is reverted.
        # See doc/08_tracking/bug/glob_ungate_swaps_import_winners_2026-08-01.md.
        val has_own_symbols = imported_mod.composites.keys().len() > 0 or imported_mod.enums.keys().len() > 0 or imported_mod.traits.keys().len() > 0 or imported_mod.callables.keys().len() > 0 or imported_mod.constants.keys().len() > 0
        val facade_shape = not has_own_symbols and imported_mod.exports.len() == 0
        var glob_imp_idx = 0
        while glob_imp_idx < imported_mod.imports.len():
            val glob_imp = imported_mod.imports[glob_imp_idx]
            if glob_imp.items.len() == 0 and facade_shape:
                val nested_key = self.resolve_module_key_relative(glob_imp.module, imported_mod_name)
                val nested_surface = if nested_key != "": hir_module_surface_get(self.module_surfaces, nested_key) else: nil
                if nested_surface != nil and nested_key != imported_mod_name:
                    self.register_glob_imported_symbols_depth(nested_surface.unwrap(), nested_key, import_span, depth + 1)
            var glob_it = 0
            while glob_it < glob_imp.items.len():
                val glob_item = glob_imp.items[glob_it]
                val glob_local = if glob_item.has_alias: glob_item.alias else: glob_item.name
                self.register_imported_symbol(imported_mod, imported_mod_name, glob_local, glob_local, import_span)
                glob_it = glob_it + 1
            glob_imp_idx = glob_imp_idx + 1

    me resolve_import_symbols(module: ParserModule):
        var import_idx = 0
        while import_idx < module.imports.len():
            val imp = module.imports[import_idx]
            # ParserStruct-valued Dict.get() corrupts native hit payloads. Track the
            # winning key and read the value only with bracket indexing.
            var imported_key = if self.module_surfaces.index_by_name.contains_key(imp.module): imp.module else: ""
            if (rt_env_get("SIMPLE_BOOTSTRAP_DIAG") ?? "") == "1":
                eprint("[imp] importer={module.name} module={imp.module} items={imp.items.len()} found={imported_key != ""}")
            # Symbols must register under the DEFINING module's canonical name:
            # a relative alias like ".helper" would otherwise be baked into the
            # call symbol (@.helper.helper_val) while the definition object
            # mangles under the path-derived name -> lld undefined symbol.
            var resolved_module_name = imp.module
            if imported_key == "" and imp.module.starts_with("."):
                # Relative import (`.sibling` / `..pkg.mod`): the module map is
                # keyed by path-derived dotted names (app.mcp.main_lazy_json),
                # so a raw leading-dot key always misses. Normalize against the
                # importing module's own name. The entry module's name can be a
                # FILE PATH (src/app/mcp/main.spl) — canonicalize to dotted.
                var rel_base = module.name
                if rel_base.ends_with(".spl"):
                    rel_base = rel_base[0:rel_base.len() - 4]
                rel_base = rel_base.replace("/", ".")
                if rel_base.starts_with("src."):
                    rel_base = rel_base.substring(4)
                var rel_dots = 0
                while rel_dots < imp.module.len() and imp.module.substring(rel_dots, rel_dots + 1) == ".":
                    rel_dots = rel_dots + 1
                val rel_tail = imp.module.substring(rel_dots)
                # Drop the module's own last segment, plus one more per extra dot.
                var rel_segs = rel_base.split(".")
                var rel_keep = rel_segs.len() - rel_dots
                if rel_keep < 0:
                    rel_keep = 0
                var rel_pkg = ""
                var rel_si = 0
                while rel_si < rel_keep:
                    if rel_si > 0:
                        rel_pkg = rel_pkg + "."
                    rel_pkg = rel_pkg + rel_segs[rel_si]
                    rel_si = rel_si + 1
                val rel_abs = if rel_pkg == "": rel_tail else: rel_pkg + "." + rel_tail
                if self.module_surfaces.index_by_name.contains_key(rel_abs):
                    imported_key = rel_abs
                    resolved_module_name = rel_abs
            if imported_key == "":
                # Canonical-key fallbacks (see resolve_module_key): closure
                # files register ONLY under path-derived names, keeping
                # resolved_module_name canonical so call symbols match the
                # definition's mangled name.
                val fb_key = self.resolve_module_key(imp.module)
                if fb_key != "" and self.module_surfaces.index_by_name.contains_key(fb_key):
                    imported_key = fb_key
                    resolved_module_name = fb_key
            if imported_key == "" and (rt_env_get("SIMPLE_BOOTSTRAP_DIAG") ?? "") == "1":
                eprint("[import-miss] importer={module.name} module={imp.module}")
            if imported_key != "":
                val imported_mod = hir_module_surface_get(self.module_surfaces, imported_key)
                if imported_mod == nil:
                    self.error("missing module surface for {imported_key}", imp.span)
                    import_idx = import_idx + 1
                    continue
                if imp.items.len() == 0:
                    self.register_glob_imported_symbols(imported_mod.unwrap(), resolved_module_name, imp.span)
                    # A module-only import also provides a namespace for
                    # qualified calls such as `module.function()`.
                    val import_path_parts = imp.module.split(".")
                    if import_path_parts.len() > 0:
                        val module_alias = import_path_parts[import_path_parts.len() - 1]
                        if module_alias != "" and self.symbols.lookup(module_alias) == nil:
                            self.symbols.define(module_alias, SymbolKind.Module, nil, imp.span, Visibility.Private, false, Some(resolved_module_name))
                else:
                    var item_idx = 0
                    while item_idx < imp.items.len():
                        val item = imp.items[item_idx]
                        val local_name = if item.has_alias: item.alias else: item.name
                        self.register_imported_symbol(imported_mod.unwrap(), resolved_module_name, item.name, local_name, imp.span)
                        item_idx = item_idx + 1
            import_idx = import_idx + 1

    me resolve_package_sibling_symbols(module: ParserModule):
        """Directory-package semantics: files in one source directory share a
        namespace — e.g. std.common.json.array_ops calls json_array from
        types.spl with NO import line. The seed's flat global registry gives
        this for free; the entry-closure HIR path must register each sibling
        module's public symbols explicitly, or every bare cross-file call in a
        package dies with "unresolved name" (fatal since HIR lowering errors
        became build errors)."""
        var self_name = module.name
        if self_name.ends_with(".spl"):
            self_name = self_name[0:self_name.len() - 4]
            self_name = self_name.replace("/", ".")
            if self_name.starts_with("src."):
                self_name = self_name.substring(4)
        val self_segs = self_name.split(".")
        if self_segs.len() < 2:
            return
        var pkg = ""
        var pkg_si = 0
        while pkg_si < self_segs.len() - 1:
            if pkg_si > 0:
                pkg = pkg + "."
            pkg = pkg + self_segs[pkg_si]
            pkg_si = pkg_si + 1
        val pkg_prefix = pkg + "."
        val self_canon = hir_pkg_canonical_module_name(module.name)
        val canon_segs = self_canon.split(".")
        var canon_pkg = ""
        var canon_si = 0
        while canon_si < canon_segs.len() - 1:
            if canon_si > 0:
                canon_pkg = canon_pkg + "."
            canon_pkg = canon_pkg + canon_segs[canon_si]
            canon_si = canon_si + 1
        val canon_prefix = canon_pkg + "."
        # Cheap pre-filter: a real sibling's key must mention the package's own
        # last segment in SOME spelling. Canonicalizing every registry key for
        # every module is O(modules x keys) with a split/join per key; this
        # substring test drops ~all non-siblings before that cost is paid.
        val canon_pkg_last = if canon_segs.len() >= 2: canon_segs[canon_segs.len() - 2] else: ""
        val sibling_span = Span(start: 0, end: 0, line: 0, col: 0, file: "", length: 0)
        val trace = hir_module_sibling_trace_enabled()
        # One physical sibling can hold SEVERAL registry keys (path spelling,
        # tier-numbered dotted spelling, symlink dotted spelling). Register each
        # physical sibling once: re-globbing the same surface is wasted work and
        # would re-enter register_imported_symbol for names already bound.
        var seen_siblings: Dict<text, bool> = {}
        var literal_matched = 0
        var canon_matched = 0
        for sibling_name in self.module_surfaces.index_by_name.keys():
            if sibling_name == self_name or sibling_name == module.name:
                continue
            if sibling_name.starts_with(pkg_prefix) and not sibling_name.substring(pkg_prefix.len()).contains("."):
                literal_matched = literal_matched + 1
            if canon_pkg_last != "" and not sibling_name.contains(canon_pkg_last):
                continue
            val sibling_canon = hir_pkg_canonical_module_name(sibling_name)
            if sibling_canon == self_canon:
                continue
            if not sibling_canon.starts_with(canon_prefix):
                continue
            # DIRECT siblings only: exactly one segment past the package.
            if sibling_canon.substring(canon_prefix.len()).contains("."):
                continue
            if seen_siblings.contains_key(sibling_canon):
                continue
            seen_siblings[sibling_canon] = true
            canon_matched = canon_matched + 1
            val sibling_surface = hir_module_surface_get(self.module_surfaces, sibling_name)
            if sibling_surface != nil:
                self.register_glob_imported_symbols(sibling_surface.unwrap(), sibling_name, sibling_span)
        if trace:
            eprint("[hir-siblings] module={module.name} self={self_name} pkg={pkg_prefix} canon_self={self_canon} canon_pkg={canon_prefix} literal_matched={literal_matched} canon_matched={canon_matched}")

    # Uniquely-named entry point for the driver's unstub `-c`/`run` path.
    # `lowering.lower_module(...)` from the driver never enters this impl's body
    # on the stage4 binary: `lower_module` is also defined on MirLowering with
    # the same arity, and the seed's method-name dispatch can resolve the call
    # to the wrong same-named sibling (the process_module hazard of iteration
    # 14, recurring here — bug doc iteration 17). The unique name forces
    # dispatch to the real HIR lowering body.
    me lower_parser_module_unstub(module: ParserModule) -> HirModule:
        # Trap D (iteration 17): env-GATED eprint probes are mute in the
        # hir_lowering modules — `(hir_*_env_get("X") ?? "") == "1"` evaluates
        # false on stage4 even when X=1 — while UNGATED eprint works fine.
        # Probe builds must use ungated eprint here.
        val bootstrap_mode = (hir_module_env_get("SIMPLE_BOOTSTRAP") ?? "") == "1"
        val bootstrap_flat_mode = bootstrap_mode and (hir_module_env_get("SIMPLE_BOOTSTRAP_STAGE4") ?? "") != "1"
        val bootstrap_closure = bootstrap_mode and (hir_module_env_get("SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE") ?? "") == "1"
        if bootstrap_flat_mode and (not bootstrap_closure or hir_module_is_bootstrap_entry(module.name)):
            bootstrap_hir_modules_reset()
        val parser_constants = module.constants.values()
        # Keep the aggregate out of the stage4 Any-erasure path. HirModule
        # contains several dictionaries, and the first field access below can
        # otherwise dispatch through a nil Any receiver in bootstrap builds.
        var lowered_module: HirModule = self.lower_module(module)
        val focused_future_diag = bootstrap_mode and module.name == "src/lib/nogc_async_mut/async/future.spl"
        if focused_future_diag:
            eprint("[hir-finalize] returned future")
        if bootstrap_mode and parser_constants.len() > 0:
            var recovered_constants: Dict<SymbolId, HirConst> = {}
            var const_idx = 0
            while const_idx < parser_constants.len():
                val hir_const = self.lower_hir_const_decl(parser_constants[const_idx])
                recovered_constants[SymbolId(id: const_idx)] = hir_const
                const_idx = const_idx + 1
            lowered_module.constants = recovered_constants
        elif lowered_module.constants.keys().len() == 0 and parser_constants.len() > 0:
            var recovered_constants: Dict<SymbolId, HirConst> = {}
            var const_idx = 0
            while const_idx < parser_constants.len():
                val hir_const = self.lower_hir_const_decl(parser_constants[const_idx])
                recovered_constants[SymbolId(id: const_idx)] = hir_const
                const_idx = const_idx + 1
            lowered_module.constants = recovered_constants
        if focused_future_diag:
            eprint("[hir-finalize] constants done")
        if bootstrap_flat_mode:
            var flat_functions: [HirFunction] = []
            var flat_fn_idx = 0
            while flat_fn_idx < bootstrap_hir_function_count():
                flat_functions = flat_functions.push(bootstrap_hir_function_at(flat_fn_idx))
                flat_fn_idx = flat_fn_idx + 1
            # Materialize and type each aggregate separately. Passing several
            # Dict.values() aggregates in one mixed call can erase one through
            # Any in the stage4 bootstrap ABI and later produce a nil receiver.
            val flat_symbols: [HirSymbol] = self.symbols.symbols.values()
            val flat_constants: [HirConst] = lowered_module.constants.values()
            val flat_enums: [HirEnum] = lowered_module.enums.values()
            val flat_structs: [HirStruct] = lowered_module.structs.values()
            val flat_classes: [HirClass] = lowered_module.classes.values()
            if focused_future_diag:
                eprint("[hir-finalize] aggregates done")
            bootstrap_hir_modules_add(module.name, flat_symbols, flat_functions, flat_constants, flat_enums, flat_structs, flat_classes)
            if focused_future_diag:
                eprint("[hir-finalize] cache done")
        lowered_module

    me lower_module_enum_definitions(module: ParserModule) -> Dict<SymbolId, HirEnum>:
        var lowered: Dict<SymbolId, HirEnum> = {}
        val imported_names = self.imported_enums.keys()
        var enum_idx = 0
        while enum_idx < imported_names.len():
            val local_name = imported_names[enum_idx]
            val hir_enum = self.lower_enum_with_symbol(self.imported_enums[local_name], self.imported_enum_owners[local_name], local_name)
            lowered[hir_enum.symbol] = hir_enum
            enum_idx = enum_idx + 1

        val local_names = module.enums.keys()
        enum_idx = 0
        while enum_idx < local_names.len():
            val local_name = local_names[enum_idx]
            if not self.imported_enums.contains_key(local_name):
                val hir_enum = self.lower_enum(module.enums[local_name], hir_module_logical_name_from_path(module.name))
                lowered[hir_enum.symbol] = hir_enum
            enum_idx = enum_idx + 1
        lowered

    me lower_module(module: ParserModule) -> HirModule:
        # Probe MUST be eprint AND ungated (Traps A/C/D, bug doc iters 13-17).
        val bootstrap_mode = (hir_module_env_get("SIMPLE_BOOTSTRAP") ?? "") == "1"
        # Phase profiling records bounded phase boundaries. Per-item logging
        # allocates one formatted string per expression in the no-GC compiler,
        # so reserve it for explicitly requested verbose diagnostics.
        val bootstrap_diag = bootstrap_mode and hir_module_verbose_diag_enabled()
        # A multi-module --entry-closure build under SIMPLE_BOOTSTRAP=1 parses
        # EVERY module in the closure for real (see flat_is_bootstrap_entry_path
        # in the flat-AST bridge), not just the single bootstrap_main.spl entry.
        # The bootstrap branch below only pre-declares SAME-module function
        # names (bootstrap_decl_idx loop); it never ran resolve_import_symbols,
        # so a helper module's functions never entered the importing module's
        # symbol table and every cross-module call HIR-failed with "unresolved
        # name: <fn>" even though the helper module itself lowered fine (bug
        # bootstrap_stage2_empty_mir_bodies_2026-07-05, cross-module closure
        # gap). Single-entry bootstrap_main.spl builds (no closure flag) never
        # had real cross-module imports to resolve, so this only widens
        # behavior for the closure path.
        val bootstrap_closure = bootstrap_mode and (hir_module_env_get("SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE") ?? "") == "1"
        if bootstrap_diag:
            # NOTE: parser ParserModule has no `path` field (parser_types.spl) — a
            # `{module.path}` interpolation here aborted the whole worker under
            # SIMPLE_COMPILER_TRACE=1 ("class `ParserModule` has no field named `path`").
            eprint("[hir-lower] lower_module:start module={module.name}")
        self.lowered_impl_functions = {}
        self.imported_traits = {}
        self.imported_enums = {}
        self.imported_enum_owners = {}
        # NOTE (moved): the struct field-type pre-scan that used to run HERE
        # now runs AFTER Pass 0 (imports) and the declare pass below — see the
        # "Pass -1 (relocated)" block. Running it first meant every
        # struct-typed field (`inner: Inner`, `driver: FramebufferDriver`)
        # hit lower_named_kind before ANY type symbol was defined and emitted
        # "unresolved type" — historically swallowed, but fatal since HIR
        # lowering errors became build errors (type lowering diagnostic
        # recovery). The consumers of struct_field_types_by_name /
        # struct_field_order_by_name are all in FUNCTION-BODY lowering, which
        # still runs after the relocated pre-scan, so the "registry is
        # populated before any function body" guarantee is unchanged — with
        # strictly better fidelity, since module-local and imported type
        # names now resolve to real Named kinds instead of decaying to Error.
        # Pre-scan every enum-variant short name (needs no symbol resolution,
        # so it keeps running first) so lower_pattern can give a subject-owned enum
        # variant precedence over an unrelated same-named struct/class. Keeps
        # `case Const(a, b, c):` a refutable enum-variant pattern instead of
        # an irrefutable struct-positional pattern
        # (native_const_pattern_lowers_irrefutably bug).
        val prescan_enum_names = module.enums.keys()
        var prescan_enum_idx = 0
        while prescan_enum_idx < prescan_enum_names.len():
            val prescan_enum: ParserEnum = module.enums[prescan_enum_names[prescan_enum_idx]]
            for prescan_variant in prescan_enum.variants:
                self.enum_variant_names[prescan_variant.name] = true
            prescan_enum_idx = prescan_enum_idx + 1
        # Pass 0: pre-register imported type names so explicit `use` paths win
        # over module load order when two modules export the same short name.
        if not bootstrap_mode or bootstrap_closure:
            hir_module_phase_probe("phase3:hir:imports:start {module.name}")
            if bootstrap_diag:
                eprint("[hir-lower] resolve_import_symbols:start module={module.name}")
            self.registering_import_symbols = true
            self.resolve_import_symbols(module)
            self.resolve_package_sibling_symbols(module)
            self.registering_import_symbols = false
            if bootstrap_diag:
                eprint("[hir-lower] resolve_import_symbols:done module={module.name}")
            hir_module_phase_probe("phase3:hir:imports:done {module.name}")

        # First pass: declare all top-level symbols
        if bootstrap_diag:
            eprint("[hir-lower] declare:start module={module.name}")
        if not bootstrap_mode or bootstrap_closure:
            hir_module_phase_probe("phase3:hir:declare:start {module.name}")
            # Under a closure build, a module's own struct/enum/class/trait
            # names must be pre-declared before its functions are lowered --
            # a constructor referencing its own module's struct (e.g.
            # `Point(x: a, y: b)` inside `make_point`) otherwise hits
            # lower_unresolved_ident -> "unresolved name: Point" (bug
            # bootstrap_stage2_empty_mir_bodies_2026-07-05, Probe A). Bootstrap
            # mode already pre-declares its own function names via the
            # bootstrap_decl_idx loop below, so this only widens declaration
            # coverage to types/consts for the closure path.
            self.declare_module_symbols(module)
            hir_module_phase_probe("phase3:hir:declare:done {module.name}")
        if bootstrap_diag:
            eprint("[hir-lower] declare:done module={module.name}")

        # Pass -1 (relocated): pre-scan struct/class field TYPES (name-keyed) before
        # ANY function body is lowered. Nested-field-access support (see
        # struct_field_types_by_name doc comment in types.spl) needs this
        # available while lowering `val s = S(...)` higher up in a function
        # body, but this module's main struct-lowering pass (which fully
        # resolves each HirStruct, further down in lower_module) runs AFTER
        # functions are lowered -- too late for that Let-statement lowering to
        # see it. This pre-scan is deliberately separate from (and superseded
        # by) that later full pass. It MUST run after resolve_import_symbols
        # (Pass 0) and declare_module_symbols above: lowering an aggregate-typed
        # field (`driver: FramebufferDriver`) resolves the field type through
        # lower_named_kind, and before those passes no type symbol exists yet,
        # so every such field emitted "unresolved type" -- historically
        # swallowed, but a fatal build error since HIR lowering errors became
        # fatal (crossmodule_field_index_collision parity case: the provider
        # module's own sibling struct failed to resolve and the whole
        # native-build aborted).
        # NOTE: aggregate field type ANNOTATIONS are unreliable on this path
        # (`arr: [i64]` parses to TypeKind.Infer, both parser- and HIR-level --
        # a documented pre-existing limitation, see bug #156's
        # method_calls_literals.spl comment). This pre-scan is still worth
        # doing (cheap, and correct for any field shape the parser DOES
        # preserve); the construction-site inference in
        # try_register_local_struct_type (statements.spl) is what actually
        # recovers array-typed fields in practice, and it MERGES into
        # (overwrites) whatever this pass records.
        val prescan_struct_names = module.structs.keys()
        var prescan_idx = 0
        while prescan_idx < prescan_struct_names.len():
            val prescan_name = prescan_struct_names[prescan_idx]
            val prescan_struct: ParserStruct = module.structs[prescan_name]
            self.prescan_composite_field_types(prescan_name, prescan_struct.fields)
            prescan_idx = prescan_idx + 1
        val prescan_class_names = module.classes.keys()
        prescan_idx = 0
        while prescan_idx < prescan_class_names.len():
            val prescan_name = prescan_class_names[prescan_idx]
            val prescan_class: ParserClass = module.classes[prescan_name]
            self.prescan_composite_field_types(prescan_name, prescan_class.fields)
            prescan_idx = prescan_idx + 1

        # Second pass: lower definitions
        if bootstrap_diag:
            eprint("[hir-lower] locals:functions:init module={module.name}")
        var functions: Dict<SymbolId, HirFunction> = {}
        var gpu_function_targets: Dict<text, text> = {}
        var gpu_function_backend_orders: Dict<text, text> = {}
        if bootstrap_diag:
            eprint("[hir-lower] locals:classes:init module={module.name}")
        var classes: Dict<SymbolId, HirClass> = {}
        if bootstrap_diag:
            eprint("[hir-lower] locals:structs:init module={module.name}")
        var structs: Dict<SymbolId, HirStruct> = {}
        if bootstrap_diag:
            eprint("[hir-lower] locals:enums:init module={module.name}")
        var enums: Dict<SymbolId, HirEnum> = {}
        if bootstrap_diag:
            eprint("[hir-lower] locals:bitfields:init module={module.name}")
        var bitfields: Dict<SymbolId, HirBitfield> = {}
        if bootstrap_diag:
            eprint("[hir-lower] locals:traits:init module={module.name}")
        var traits: Dict<SymbolId, HirTrait> = {}
        if bootstrap_diag:
            eprint("[hir-lower] locals:impls:init module={module.name}")
        var impls: [HirImpl] = []
        if bootstrap_diag:
            eprint("[hir-lower] locals:constants:init module={module.name}")
        var constants: Dict<SymbolId, HirConst> = {}

        var lower_idx = 0
        if bootstrap_mode:
            bootstrap_hir_functions_reset()
            # Lower the REAL parsed functions of the entry module. They are held
            # in `module.functions` (populated by the flat-AST bridge at parse
            # time — see parse_and_build_module). The prior implementation re-read
            # the fragile SIMPLE_BOOTSTRAP_DECL_TAG_* environment (overwritten by
            # every later module parse, so at this point it reflected some other
            # module) and, unless SIMPLE_BOOTSTRAP_REAL_HIR=1, deferred to ZERO
            # functions — which produced an all-stub bootstrap binary that linked
            # cleanly but did nothing (bug
            # bootstrap_stage2_empty_mir_bodies_2026-07-05).
            val bootstrap_module_functions = module.functions
            val bootstrap_function_keys = bootstrap_module_functions.keys()
            if bootstrap_diag:
                eprint("[hir-lower] functions:count module={module.name} count={bootstrap_function_keys.len()}")
            # Pre-declare every module-level function name BEFORE lowering any
            # body. declare_module_symbols is skipped under bootstrap, so
            # without this a same-module callee (`check(...)`) hits
            # lower_unresolved_ident -> HirExprKind.Error, and MIR lower_call's
            # indirect arm then emits `call i64 %lN(...)` through whatever
            # garbage local the Error expr lowered to (#135-class SIGSEGV).
            # A closure HELPER module's (non-entry) own functions are keyed
            # in the flat MIR accumulator by `module.function`
            # (bootstrap_lower_extra_hir_module_to_mir,
            # bootstrap_globals.spl) so a same-named function from a
            # DIFFERENT module doesn't collide/drop it (bug
            # bootstrap_stage2_empty_mir_bodies_2026-07-05, Probe B). A
            # same-module call between two of THIS module's own functions
            # must resolve through that same qualified name, so pre-declare
            # under the qualified name here too -- but only for a non-entry
            # module: the ENTRY's own accumulator
            # (bootstrap_lower_hir_globals_to_mir_module) never qualifies,
            # so qualifying its pre-declared names would break every
            # same-module call in bootstrap_main.spl itself.
            val bootstrap_decl_qualify = bootstrap_closure and not hir_module_is_bootstrap_entry(module.name)
            val bootstrap_decl_module_name = hir_module_logical_name_from_path(module.name)
            var bootstrap_decl_idx = 0
            while bootstrap_decl_idx < bootstrap_function_keys.len():
                val bootstrap_decl_fn: ParserFunction = bootstrap_module_functions[bootstrap_function_keys[bootstrap_decl_idx]]
                val bootstrap_decl_sym = self.symbols.define(bootstrap_decl_fn.name, SymbolKind.Function, nil, Span.empty(), false, false, nil)
                # Extern fns must keep their BARE runtime symbol: qualifying
                # them ("std.nogc_sync_mut.simd.rt_simd_has_avx2") makes every
                # same-module call emit an undefined module-prefixed symbol at
                # link time — the definition side (bootstrap_globals.spl)
                # already skips externs, so nothing ever defines the qualified
                # spelling.
                if bootstrap_decl_qualify and not bootstrap_decl_fn.is_extern:
                    self.symbols.rename_symbol(bootstrap_decl_sym, "{bootstrap_decl_module_name}.{bootstrap_decl_fn.name}")
                bootstrap_decl_idx = bootstrap_decl_idx + 1
            while lower_idx < bootstrap_function_keys.len():
                val bootstrap_fn: ParserFunction = bootstrap_module_functions[bootstrap_function_keys[lower_idx]]
                if bootstrap_diag:
                    eprint("[hir-lower] function:start module={module.name} name={bootstrap_fn.name} idx={lower_idx}")
                val hir_fn = self.lower_function(bootstrap_fn)
                if hir_fn.is_gpu_kernel:
                    gpu_function_targets[hir_fn.name] = hir_fn.gpu_target
                    gpu_function_backend_orders[hir_fn.name] = hir_fn.gpu_backend_order
                    self.symbols.register_gpu_function_metadata(hir_fn.name, hir_fn.gpu_target, hir_fn.gpu_backend_order)
                val fn_key: SymbolId = SymbolId(id: lower_idx)
                functions[fn_key] = hir_fn
                bootstrap_hir_functions_add(hir_fn)
                if bootstrap_diag:
                    eprint("[hir-lower] function:done module={module.name} name={bootstrap_fn.name} idx={lower_idx}")
                lower_idx = lower_idx + 1
        else:
            val lower_module_functions = module.functions
            val lower_function_keys = lower_module_functions.keys()
            while lower_idx < lower_function_keys.len():
                val name = lower_function_keys[lower_idx]
                hir_module_phase_probe("phase3:hir:function:start {module.name}.{name}")
                val fn_: ParserFunction = lower_module_functions[name]
                val hir_fn = self.lower_function(fn_)
                if hir_fn.is_gpu_kernel:
                    gpu_function_targets[hir_fn.name] = hir_fn.gpu_target
                    gpu_function_backend_orders[hir_fn.name] = hir_fn.gpu_backend_order
                    self.symbols.register_gpu_function_metadata(hir_fn.name, hir_fn.gpu_target, hir_fn.gpu_backend_order)
                # Key the HIR functions Dict by the function's REAL SymbolId
                # (the same id `declare_module_symbols` registered it under, and
                # the same id `hir.symbols.lookup(name)` returns) so tooling that
                # resolves a name via the symbol table can then index straight
                # into `hir.functions` -- see
                # doc/08_tracking/bug/hir_symbol_table_only_records_first_function_2026-07-28.md.
                # A prior version of this line keyed by the loop index instead
                # (`SymbolId(id: lower_idx)`), citing a stage4-seed struct-value
                # corruption in `SymbolTable.lookup` (bug
                # stage4_unstub_multifn_silent_noop_2026-07-03). That corruption
                # was in the OLD `Dict<text, SymbolId>`-keyed lookup; `lookup`
                # now stores raw `i64` ids in `scope.symbols` and rebuilds a
                # fresh `SymbolId` struct per call (hir_types.spl), so it no
                # longer shares/corrupts a struct across names. Loop-index keys
                # silently diverged from the real symbol ids in any module that
                # declares a struct/class/enum/trait/const/impl ALONGSIDE
                # functions (the common case): those declarations consume ids
                # from the SAME global counter before functions do, so
                # `hir.functions` ended up keyed 0,1,2,... while
                # `hir.symbols.lookup(name)` returned the true, larger ids --
                # `hir.functions.contains_key(hir.symbols.lookup(name))` was
                # false for every such module. Fall back to the old
                # loop-index synthetic key only if `lookup` can't find the name
                # (defensive; should not happen since `declare_module_symbols`
                # always pre-declares every function first). Every HIR-functions
                # consumer iterates `.keys()`/`.values()` (monomorphize_integration,
                # backend translate, interpreter main-by-name scan) and
                # re-indexes with the yielded key, so any distinct key preserves
                # all entries and all consumers -- using the real symbol id is a
                # strict improvement, not just a distinct one.
                val real_id = self.symbols.lookup_or_invalid(name)
                val fn_key = if real_id.is_valid(): real_id else: SymbolId(id: lower_idx)
                functions[fn_key] = hir_fn
                hir_module_phase_probe("phase3:hir:function:done {module.name}.{name}")
                lower_idx = lower_idx + 1

        if bootstrap_mode:
            # Closure builds need real struct/enum/class/bitfield/trait
            # definitions in the returned HirModule, not just their names in
            # the symbol table (declare_module_symbols above only defines
            # names). Without this, MIR lowering's `struct_field_order` (built
            # by walking `HirModule.structs`) never learns about a module's
            # own struct, so `Point(x: a, y: b)` falls through lower_call's
            # generic-function-call path and the backend emits `call @Point`
            # -> link failure `undefined symbol: Point` instead of a real
            # struct construction (bug
            # bootstrap_stage2_empty_mir_bodies_2026-07-05, Probe A). A plain
            # (non-closure) bootstrap_main.spl build never declares its own
            # struct/enum/class types, so these dicts stay empty there and
            # this is additive only.
            if bootstrap_closure:
                val bootstrap_module_classes = module.classes
                val bootstrap_class_keys = bootstrap_module_classes.keys()
                var bootstrap_class_idx = 0
                while bootstrap_class_idx < bootstrap_class_keys.len():
                    val bootstrap_class_: ParserClass = bootstrap_module_classes[bootstrap_class_keys[bootstrap_class_idx]]
                    val bootstrap_hir_class = self.lower_class(bootstrap_class_)
                    classes[bootstrap_hir_class.symbol] = bootstrap_hir_class
                    bootstrap_class_idx = bootstrap_class_idx + 1

                val bootstrap_module_structs = module.structs
                val bootstrap_struct_keys = bootstrap_module_structs.keys()
                var bootstrap_struct_idx = 0
                while bootstrap_struct_idx < bootstrap_struct_keys.len():
                    val bootstrap_struct_: ParserStruct = bootstrap_module_structs[bootstrap_struct_keys[bootstrap_struct_idx]]
                    val bootstrap_hir_struct = self.lower_struct(bootstrap_struct_)
                    structs[bootstrap_hir_struct.symbol] = bootstrap_hir_struct
                    self.register_struct_field_types(bootstrap_hir_struct)
                    bootstrap_struct_idx = bootstrap_struct_idx + 1

                enums = self.lower_module_enum_definitions(module)

                val bootstrap_module_bitfields = module.bitfields
                val bootstrap_bitfield_keys = bootstrap_module_bitfields.keys()
                var bootstrap_bitfield_idx = 0
                while bootstrap_bitfield_idx < bootstrap_bitfield_keys.len():
                    val bootstrap_bf_: Bitfield = bootstrap_module_bitfields[bootstrap_bitfield_keys[bootstrap_bitfield_idx]]
                    val bootstrap_hir_bf = self.lower_bitfield(bootstrap_bf_)
                    bitfields[bootstrap_hir_bf.symbol] = bootstrap_hir_bf
                    bootstrap_bitfield_idx = bootstrap_bitfield_idx + 1

                val bootstrap_module_traits = module.traits
                val bootstrap_trait_keys = bootstrap_module_traits.keys()
                var bootstrap_trait_idx = 0
                while bootstrap_trait_idx < bootstrap_trait_keys.len():
                    val bootstrap_trait_: ParserTrait = bootstrap_module_traits[bootstrap_trait_keys[bootstrap_trait_idx]]
                    val bootstrap_hir_trait = self.lower_trait(bootstrap_trait_)
                    traits[bootstrap_hir_trait.symbol] = bootstrap_hir_trait
                    bootstrap_trait_idx = bootstrap_trait_idx + 1

                var bootstrap_impl_idx = 0
                while bootstrap_impl_idx < module.impls.len():
                    impls = impls.push(self.lower_impl(module.impls[bootstrap_impl_idx]))
                    bootstrap_impl_idx = bootstrap_impl_idx + 1
                # Native `Dict.len()` always returns -1, which would seed the
                # synthetic keys at -1 and collide with the real SymbolIds.
                # See doc/07_guide/language/dict_native_pitfalls.md
                var bootstrap_impl_fn_key = functions.keys().len()
                for bootstrap_impl_sym in self.lowered_impl_functions.keys():
                    functions[SymbolId(id: bootstrap_impl_fn_key)] = self.lowered_impl_functions[bootstrap_impl_sym]
                    bootstrap_impl_fn_key = bootstrap_impl_fn_key + 1
            # ParserModule-level `val` constants: this bootstrap early-return used to
            # hard-code `constants: {}`, so module globals never reached HIR ->
            # MIR and every reference lowered to an uninitialized alloca (stack
            # garbage; LSP server startup SIGSEGV,
            # native_module_val_globals 2026-07-23). Lower them here exactly
            # like the non-bootstrap path below (line ~1284).
            var bootstrap_constants: Dict<SymbolId, HirConst> = {}
            val bootstrap_const_names = module.constants.keys()
            if bootstrap_diag and bootstrap_const_names.len() > 0:
                eprint("[hir-lower] bootstrap-constants:count module={module.name} count={bootstrap_const_names.len()}")
            var bootstrap_const_idx = 0
            while bootstrap_const_idx < bootstrap_const_names.len():
                val bootstrap_const_src: ParserConst = module.constants[bootstrap_const_names[bootstrap_const_idx]]
                val bootstrap_hir_const = self.lower_hir_const_decl(bootstrap_const_src)
                bootstrap_constants[bootstrap_hir_const.symbol] = bootstrap_hir_const
                bootstrap_const_idx = bootstrap_const_idx + 1
            if bootstrap_diag:
                eprint("[hir-lower] bootstrap-functions:count module={module.name} count={_bootstrap_hir_functions.len()}")
            # Avoid passing untyped empty aggregate literals through the
            # stage4 constructor ABI. The normal path below materializes these
            # collections with their concrete element types before building
            # HirModule; bootstrap must preserve the same type information.
            val bootstrap_imports: [HirImport] = []
            val bootstrap_exports: [text] = []
            val bootstrap_domain_blocks: [HirDomainBlock] = []
            val bootstrap_static_asserts: [HirStaticAssert] = []
            val bootstrap_aop_advices: [HirAopAdvice] = []
            val bootstrap_di_bindings: [HirDiBinding] = []
            val bootstrap_arch_rules: [HirArchRule] = []
            val bootstrap_mock_decls: [HirMockDecl] = []
            val bootstrap_types: [text] = []
            return HirModule(
                name: module.name,
                path: self.module_filename,
                imports: bootstrap_imports,
                exports: bootstrap_exports,
                domain_blocks: bootstrap_domain_blocks,
                symbols: self.symbols,
                functions: functions,
                gpu_function_targets: gpu_function_targets,
                gpu_function_backend_orders: gpu_function_backend_orders,
                classes: classes,
                structs: structs,
                enums: enums,
                bitfields: bitfields,
                traits: traits,
                impls: impls,
                constants: bootstrap_constants,
                static_asserts: bootstrap_static_asserts,
                aop_advices: bootstrap_aop_advices,
                di_bindings: bootstrap_di_bindings,
                arch_rules: bootstrap_arch_rules,
                mock_decls: bootstrap_mock_decls,
                types: bootstrap_types
            )

        val lower_module_classes = module.classes
        val lower_class_keys = lower_module_classes.keys()
        lower_idx = 0
        while lower_idx < lower_class_keys.len():
            val name = lower_class_keys[lower_idx]
            val class_: ParserClass = lower_module_classes[name]
            val hir_class = self.lower_class(class_)
            classes[hir_class.symbol] = hir_class
            lower_idx = lower_idx + 1

        val lower_module_structs = module.structs
        val lower_struct_keys = lower_module_structs.keys()
        lower_idx = 0
        while lower_idx < lower_struct_keys.len():
            val name = lower_struct_keys[lower_idx]
            val struct_: ParserStruct = lower_module_structs[name]
            val hir_struct = self.lower_struct(struct_)
            structs[hir_struct.symbol] = hir_struct
            self.register_struct_field_types(hir_struct)
            lower_idx = lower_idx + 1

        enums = self.lower_module_enum_definitions(module)

        val lower_module_bitfields = module.bitfields
        val lower_bitfield_keys = lower_module_bitfields.keys()
        lower_idx = 0
        while lower_idx < lower_bitfield_keys.len():
            val name = lower_bitfield_keys[lower_idx]
            val bf: Bitfield = lower_module_bitfields[name]
            val hir_bf = self.lower_bitfield(bf)
            bitfields[hir_bf.symbol] = hir_bf
            lower_idx = lower_idx + 1

        val lower_module_traits = module.traits
        val lower_trait_keys = lower_module_traits.keys()
        lower_idx = 0
        while lower_idx < lower_trait_keys.len():
            val name = lower_trait_keys[lower_idx]
            val trait_: ParserTrait = lower_module_traits[name]
            val hir_trait = self.lower_trait(trait_)
            traits[hir_trait.symbol] = hir_trait
            lower_idx = lower_idx + 1

        lower_idx = 0
        while lower_idx < module.impls.len():
            val impl_ = module.impls[lower_idx]
            impls = impls.push(self.lower_impl(impl_))
            lower_idx = lower_idx + 1
        val lowered_impl_function_keys = self.lowered_impl_functions.keys()
        lower_idx = 0
        while lower_idx < lowered_impl_function_keys.len():
            val sym = lowered_impl_function_keys[lower_idx]
            functions[sym] = self.lowered_impl_functions[sym]
            lower_idx = lower_idx + 1

        val lower_const_values = module.constants.values()
        lower_idx = 0
        while lower_idx < lower_const_values.len():
            val const_: ParserConst = lower_const_values[lower_idx]
            val hir_const = self.lower_hir_const_decl(const_)
            constants[SymbolId(id: lower_idx)] = hir_const
            lower_idx = lower_idx + 1

        # Lower static assertions
        var static_asserts: [HirStaticAssert] = []
        for assert_ in module.static_asserts:
            static_asserts = static_asserts.push(self.lower_static_assert(assert_))

        # Lower AOP advices
        var aop_advices: [HirAopAdvice] = []
        for advice in module.aop_advices:
            aop_advices = aop_advices.push(self.lower_aop_advice(advice))

        # Lower DI bindings
        var di_bindings: [HirDiBinding] = []
        for binding in module.di_bindings:
            di_bindings = di_bindings.push(self.lower_di_binding(binding))

        # Lower architecture rules
        var arch_rules: [HirArchRule] = []
        for rule in module.arch_rules:
            arch_rules = arch_rules.push(self.lower_arch_rule(rule))

        # Lower mock declarations
        var mock_decls: [HirMockDecl] = []
        for mock_decl in module.mock_decls:
            mock_decls = mock_decls.push(self.lower_mock_decl(mock_decl))

        # Lower imports
        var imports: [HirImport] = []
        for imp in module.imports:
            imports = imports.push(self.lower_import(imp))

        var domain_blocks: [HirDomainBlock] = []
        for block in module.domain_blocks:
            domain_blocks = domain_blocks.push(self.lower_domain_block(block))

        # Collect exports
        var exports: [text] = []
        for exp in module.exports:
            for item in exp.items:
                exports = exports.push(item)

        HirModule(
            name: module.name,
            path: self.module_filename,
            imports: imports,
            exports: exports,
            domain_blocks: domain_blocks,
            symbols: self.symbols,
            functions: functions,
            gpu_function_targets: gpu_function_targets,
            gpu_function_backend_orders: gpu_function_backend_orders,
            classes: classes,
            structs: structs,
            enums: enums,
            bitfields: bitfields,
            traits: traits,
            impls: impls,
            constants: constants,
            static_asserts: static_asserts,
            aop_advices: aop_advices,
            di_bindings: di_bindings,
            arch_rules: arch_rules,
            mock_decls: mock_decls,
            types: []
        )

    me declare_module_symbols(module: ParserModule):
        # Closure builds need this pass even under SIMPLE_BOOTSTRAP=1 (see the
        # call site in lower_module) so a module's own struct/enum/class/
        # trait names resolve inside its own function bodies.
        val declare_bootstrap_closure = (hir_module_env_get("SIMPLE_BOOTSTRAP") ?? "") == "1" and (hir_module_env_get("SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE") ?? "") == "1"
        if (hir_module_env_get("SIMPLE_BOOTSTRAP") ?? "") == "1" and not declare_bootstrap_closure:
            return
        # Pass module filename for visibility tracking
        val mod_name = if self.module_filename != "": Some(self.module_filename) else: nil
        val decl_span = Span.empty()
        val decl_visibility = Visibility.Public

        # Use while loops instead of for-in (for-in doesn't work in compiled native code)
        val module_classes = module.classes
        val cls_keys = module_classes.keys()
        var idx = 0
        while idx < cls_keys.len():
            val name = cls_keys[idx]
            self.symbols.define(name, SymbolKind.Class, nil, decl_span, decl_visibility, false, mod_name)
            idx = idx + 1

        val module_structs = module.structs
        val str_keys = module_structs.keys()
        idx = 0
        while idx < str_keys.len():
            val name = str_keys[idx]
            self.symbols.define(name, SymbolKind.Struct, nil, decl_span, decl_visibility, false, mod_name)
            idx = idx + 1

        val module_enums = module.enums
        val enum_keys = module_enums.keys()
        idx = 0
        while idx < enum_keys.len():
            val name = enum_keys[idx]
            self.symbols.define(name, SymbolKind.Enum, nil, decl_span, decl_visibility, false, mod_name)
            idx = idx + 1

        val module_bitfields = module.bitfields
        val bf_keys = module_bitfields.keys()
        idx = 0
        while idx < bf_keys.len():
            val name = bf_keys[idx]
            self.symbols.define(name, SymbolKind.Struct, nil, decl_span, decl_visibility, false, mod_name)
            idx = idx + 1

        val module_traits = module.traits
        val trait_keys = module_traits.keys()
        idx = 0
        while idx < trait_keys.len():
            val name = trait_keys[idx]
            self.symbols.define(name, SymbolKind.Trait, nil, decl_span, decl_visibility, false, mod_name)
            idx = idx + 1

        # TAL2 (2026-08-01): a module's OWN `type X = Y` aliases were never entered
        # into its symbol table, while an alias IMPORTED from another module WAS
        # (register_imported_symbol defines SymbolKind.TypeAlias). That asymmetry
        # made every use of a locally declared alias inside its own declaring module
        # die with "unresolved type: X" in lower_named_kind. The parse does capture
        # the alias (module.type_aliases is populated and module_surface.spl mirrors
        # it), so only this registration was missing. This is the mechanism behind
        # the `Symbol` failures -- `type Symbol = HirSymbol` in 20.hir/hir_types.spl
        # and `type Symbol = text` in several 30.types/* files are each used inside
        # their own declaring module.
        # Minimal repro (probe case D): a module declaring `type MyAliasA = i64` and
        # using it in its own `fn alias_user(v: MyAliasA)` signature.
        # Must run BEFORE the function-signature loop below, which lowers param and
        # return annotations and would otherwise still miss the alias.
        val module_type_aliases = module.type_aliases
        val alias_keys = module_type_aliases.keys()
        idx = 0
        while idx < alias_keys.len():
            val name = alias_keys[idx]
            self.symbols.define(name, SymbolKind.TypeAlias, nil, decl_span, decl_visibility, false, mod_name)
            idx = idx + 1

        # ParserFunction signatures are lowered after type symbols so named returns
        # and recursive calls are typed before any function body is lowered.
        val module_functions = module.functions
        val fn_keys = module_functions.keys()
        idx = 0
        while idx < fn_keys.len():
            val name = fn_keys[idx]
            val fn_decl: ParserFunction = module_functions[name]
            val fn_return_type: Type = fn_decl.return_type
            if (hir_module_env_get("SIMPLEOS_FOCUSED_HIR_DIAG") ?? "") == "1":
                val return_name: text = parser_type_kind_named_name(fn_return_type.kind)
                eprint("[flat-function-roundtrip] phase=hir name={fn_decl.name} return={return_name}")
            val fn_type = self.declared_callable_type(fn_decl, nil)
            # Capture tuple-return element types by NAME while a freshly
            # lower_type'd HirType is same-pass (see fn_tuple_returns in
            # types.spl: reading the Tuple payload back out of the stored
            # symbol type at destructure time yields garbage on the seed
            # interpreter). Explicit annotations only; generics skipped.
            if fn_decl.type_params.len() == 0 and fn_decl.has_return_type:
                val parser_tuple_elems = parser_type_kind_tuple_elements(fn_return_type.kind)
                if parser_tuple_elems.len() > 0:
                    var fn_ret_tuple_elems: [HirType] = []
                    for parser_tuple_elem in parser_tuple_elems:
                        fn_ret_tuple_elems.push(self.lower_type(parser_tuple_elem))
                    self.fn_tuple_returns[name] = fn_ret_tuple_elems
            self.symbols.define(name, SymbolKind.Function, fn_type, decl_span, decl_visibility, false, mod_name)
            idx = idx + 1

        val module_constants = module.constants
        val const_keys = module_constants.keys()
        idx = 0
        while idx < const_keys.len():
            val name = const_keys[idx]
            self.symbols.define(name, SymbolKind.Const, nil, decl_span, decl_visibility, false, mod_name)
            idx = idx + 1

        # Declare impl methods
        var impl_idx = 0
        while impl_idx < module.impls.len():
            val impl_ = module.impls[impl_idx]
            val owner_name = parser_type_kind_named_name(impl_.type_.kind)
            val meth_keys = impl_.methods.keys()
            # SEED-PARITY (2026-08-01): make `Self` resolvable in an impl
            # method's SIGNATURE, not just in its body.
            #
            # This up-front signature-declaration pass runs at MODULE scope,
            # where `current_method_self_type` is still nil, so a `-> Self`
            # return annotation reached lower_named_kind with no enclosing type
            # and died as "unresolved type: Self". The class-body scope set at
            # declaration_lowering.spl:528 and the impl scope at
            # trait_impl_lowering.spl:199 both come LATER and so could not help.
            #
            # The trigger is not limited to hand-written `impl` blocks: the
            # parser desugars a method-carrying `class C:` into a class with an
            # EMPTY method dict plus a synthetic impl block (verified by
            # dumping the parsed module -- classes["Widget"].methods was empty
            # while module.impls.len() was 1), so ordinary class methods land
            # here too. That is why `Self` failed even for a plain class.
            #
            # The owner symbol this needs was already being computed a few
            # lines down for `method_symbol_name`; it is simply hoisted so the
            # self-type can be published for the duration of the method loop.
            # Saved and restored around the loop exactly like the two existing
            # scopes do, so nothing leaks into sibling declarations.
            val impl_owner_symbol = self.symbols.lookup_or_invalid(owner_name)
            val previous_impl_self_type = self.current_method_self_type
            if impl_owner_symbol.is_valid():
                self.current_method_self_type = Some(HirType(kind: HirTypeKind.Named(impl_owner_symbol, []), span: decl_span))
            var mi = 0
            while mi < meth_keys.len():
                val name = meth_keys[mi]
                val method = impl_.methods[name]
                val owner_symbol = impl_owner_symbol
                val symbol_name = if owner_symbol.is_valid(): self.symbols.method_symbol_name(owner_symbol, name) else: name
                val symbol_kind = if method.is_static: SymbolKind.Function else: SymbolKind.Method
                val owner_context: SymbolId? = if owner_symbol.is_valid(): Some(owner_symbol) else: nil
                val method_type = self.declared_callable_type(method, owner_context)
                self.symbols.define(symbol_name, symbol_kind, method_type, decl_span, decl_visibility, false, mod_name)
                mi = mi + 1
            self.current_method_self_type = previous_impl_self_type
            impl_idx = impl_idx + 1

    me lower_import(imp: ParserImport) -> HirImport:
        var items: [HirImportItem] = []
        for item in imp.items:
            match item:
                case ImportItem(name, true, alias):
                    items = items.push(HirImportItem(
                        name: name,
                        alias: Some(alias),
                        resolved: nil
                    ))
                case ImportItem(name, false, _):
                    items = items.push(HirImportItem(
                        name: name,
                        alias: nil,
                        resolved: nil
                    ))

        HirImport(
            module_path: imp.module,
            items: items,
            is_lazy: imp.is_lazy,
            span: imp.span
        )

    fn lower_domain_block(block: DomainBlock) -> HirDomainBlock:
        HirDomainBlock(block.kind, block.payload, block.context, block.span)

    fn bootstrap_hir_type_from_tag(tag: i64) -> HirType:
        val span = Span.empty()
        if tag == TYPE_DICT:
            val any_type = HirType(kind: HirTypeKind.Any, span: span)
            return HirType(kind: HirTypeKind.Dict(any_type, any_type), span: span)
        if is_dict_tag(tag):
            val dict_id = dict_tag_to_id(tag)
            return HirType(kind: HirTypeKind.Dict(
                self.bootstrap_hir_type_from_tag(dict_type_get_key(dict_id)),
                self.bootstrap_hir_type_from_tag(dict_type_get_value(dict_id))
            ), span: span)
        if tag == TYPE_TEXT:
            return HirType(kind: HirTypeKind.Str, span: span)
        if tag == TYPE_I64:
            return HirType(kind: HirTypeKind.Int(64, true), span: span)
        if tag == TYPE_BOOL:
            return HirType(kind: HirTypeKind.Bool, span: span)
        if tag == TYPE_VOID:
            return HirType(kind: HirTypeKind.Unit, span: span)
        HirType(kind: HirTypeKind.Infer(0, 0), span: span)

    fn bootstrap_hir_bin_op(op: i64) -> HirBinOp:
        if op == TOK_MINUS:
            return HirBinOp.Sub
        if op == TOK_STAR:
            return HirBinOp.Mul
        if op == TOK_SLASH:
            return HirBinOp.Div
        if op == TOK_PERCENT:
            return HirBinOp.Mod
        if op == TOK_EQ:
            return HirBinOp.Eq
        if op == TOK_NOT_EQ:
            return HirBinOp.NotEq
        if op == TOK_LT:
            return HirBinOp.Lt
        if op == TOK_LT_EQ:
            return HirBinOp.LtEq
        if op == TOK_GT:
            return HirBinOp.Gt
        if op == TOK_GT_EQ:
            return HirBinOp.GtEq
        HirBinOp.Add

    me lower_bootstrap_flat_expr(expr_idx: i64) -> HirExpr:
        val span = Span.empty()
        if expr_idx < 0:
            return HirExpr(kind: HirExprKind.NilLit, has_type_: true, type_: HirType(kind: HirTypeKind.Unit, span: span), span: span)
        val tag = expr_get_tag(expr_idx)
        if tag == EXPR_STRING_LIT:
            val raw_str_value = expr_get_str(expr_idx)
            if expr_get_int(expr_idx) != 0:
                return HirExpr(kind: HirExprKind.StringLit(raw_str_value, nil), has_type_: true, type_: HirType(kind: HirTypeKind.Str, span: span), span: span)
            # Bug #136: the bootstrap flat parser stores the raw string value
            # with any `{expr}` interpolations copied VERBATIM (e.g.
            # "simple-bootstrap {bootstrap_version()}") but never parses the
            # inner sub-expressions -- it passed `nil` for the parts list, so
            # the MIR interpolation lowering had nothing to substitute and the
            # `{...}` printed literally. Parse the raw value for top-level
            # `{...}` regions here and build a real [HirInterpolation] list so
            # the downstream lower_string_interpolation + rt_interp_cstr chain
            # can evaluate and splice each part.
            val interp_parts = self.build_bootstrap_interpolations(raw_str_value, span)
            val str_interps = if interp_parts.len() > 0: Some(interp_parts) else: nil
            return HirExpr(kind: HirExprKind.StringLit(raw_str_value, str_interps), has_type_: true, type_: HirType(kind: HirTypeKind.Str, span: span), span: span)
        if tag == EXPR_INTERPOLATED_STRING:
            var interp_parts: [HirInterpolation] = []
            for part_idx in expr_get_args(expr_idx):
                interp_parts.push(HirInterpolation(
                    expr: self.lower_bootstrap_flat_expr(part_idx),
                    has_format: false,
                    format: "",
                    span: span
                ))
            return HirExpr(
                kind: HirExprKind.StringLit(
                    expr_get_str(expr_idx), Some(interp_parts)
                ),
                has_type_: true,
                type_: HirType(kind: HirTypeKind.Str, span: span),
                span: span
            )
        if tag == EXPR_INT_LIT:
            return HirExpr(kind: HirExprKind.IntLit(expr_get_int(expr_idx), nil), has_type_: true, type_: HirType(kind: HirTypeKind.Int(64, true), span: span), span: span)
        if tag == EXPR_BOOL_LIT:
            return HirExpr(kind: HirExprKind.BoolLit(expr_get_int(expr_idx) != 0), has_type_: true, type_: HirType(kind: HirTypeKind.Bool, span: span), span: span)
        if tag == EXPR_NIL_LIT:
            return HirExpr(kind: HirExprKind.NilLit, has_type_: true, type_: HirType(kind: HirTypeKind.Unit, span: span), span: span)
        if tag == EXPR_IDENT:
            val name = expr_get_str(expr_idx)
            var sym = bootstrap_hir_symbol_for_name(name)
            val found = self.symbols.lookup(name)
            if val found_symbol = found:
                sym = found_symbol
            return HirExpr(kind: HirExprKind.Var(sym), has_type_: false, type_: HirType(kind: HirTypeKind.Infer(0, 0), span: span), span: span)
        if tag == EXPR_BINARY:
            return HirExpr(kind: HirExprKind.Binary(self.bootstrap_hir_bin_op(expr_get_int(expr_idx)), self.lower_bootstrap_flat_expr(expr_get_left(expr_idx)), self.lower_bootstrap_flat_expr(expr_get_right(expr_idx))), has_type_: false, type_: HirType(kind: HirTypeKind.Infer(0, 0), span: span), span: span)
        if tag == EXPR_CALL:
            val callee = self.lower_bootstrap_flat_expr(expr_get_left(expr_idx))
            val arg_ids = expr_get_args(expr_idx)
            val arg_names = expr_get_arg_names(expr_idx)
            var args: [HirCallArg] = []
            var ai = 0
            while ai < arg_ids.len():
                val arg_name = if ai < arg_names.len(): arg_names[ai] else: ""
                args.push(HirCallArg(has_name: arg_name != "", name: arg_name, value: self.lower_bootstrap_flat_expr(arg_ids[ai]), span: span))
                ai = ai + 1
            return HirExpr(kind: HirExprKind.Call(callee, args, []), has_type_: false, type_: HirType(kind: HirTypeKind.Infer(0, 0), span: span), span: span)
        if tag == EXPR_FIELD_ACCESS:
            return HirExpr(kind: HirExprKind.Field(self.lower_bootstrap_flat_expr(expr_get_left(expr_idx)), expr_get_str(expr_idx), nil), has_type_: false, type_: HirType(kind: HirTypeKind.Infer(0, 0), span: span), span: span)
        if tag == EXPR_METHOD_CALL:
            return HirExpr(kind: HirExprKind.MethodCall(self.lower_bootstrap_flat_expr(expr_get_left(expr_idx)), expr_get_str(expr_idx), [], MethodResolution.Unresolved), has_type_: false, type_: HirType(kind: HirTypeKind.Infer(0, 0), span: span), span: span)
        if tag == EXPR_RETURN:
            # Bare-lift — see bug doc 2026-07-23 (Some-box vs flat optional).
            var flat_ret_val: HirExpr? = nil
            flat_ret_val = self.lower_bootstrap_flat_expr(expr_get_left(expr_idx))
            return HirExpr(kind: HirExprKind.Return(flat_ret_val), has_type_: true, type_: HirType(kind: HirTypeKind.Unit, span: span), span: span)
        if tag == EXPR_BLOCK:
            return HirExpr(kind: HirExprKind.Block(self.lower_bootstrap_flat_block(expr_get_stmts(expr_idx))), has_type_: false, type_: HirType(kind: HirTypeKind.Infer(0, 0), span: span), span: span)
        HirExpr(kind: HirExprKind.NilLit, has_type_: true, type_: HirType(kind: HirTypeKind.Unit, span: span), span: span)

    me bootstrap_flat_var_expr(name: text, span: Span) -> HirExpr:
        """Build a bootstrap-flat HIR Var expr for `name`, mirroring the
        EXPR_IDENT case (bootstrap symbol, overridden by a scope lookup hit)."""
        var sym = bootstrap_hir_symbol_for_name(name)
        val found = self.symbols.lookup(name)
        if val found_symbol = found:
            sym = found_symbol
        HirExpr(kind: HirExprKind.Var(sym), has_type_: false, type_: HirType(kind: HirTypeKind.Infer(0, 0), span: span), span: span)

    me bootstrap_interp_expr_from_source(inner: text, span: Span) -> HirExpr:
        """Build an HIR expr for a single `{...}` interpolation inner source.

        Bootstrap uses only two forms: a zero-arg call `name()` and a bare
        identifier `name`. `name()` -> Call(Var(name), []); anything else ->
        Var(inner)."""
        if inner.ends_with("()"):
            val fn_name = inner[0:inner.len() - 2]
            val callee = self.bootstrap_flat_var_expr(fn_name, span)
            HirExpr(kind: HirExprKind.Call(callee, [], []), has_type_: false, type_: HirType(kind: HirTypeKind.Infer(0, 0), span: span), span: span)
        else:
            self.bootstrap_flat_var_expr(inner, span)

    me build_bootstrap_interpolations(value: text, span: Span) -> [HirInterpolation]:
        """Bug #136: scan a raw bootstrap string value for top-level `{...}`
        regions and build the interpolation parts list. Brace depth is tracked
        so nested braces inside an expr stay in one region; the inner source of
        each top-level region is parsed into an HIR expr. The literal text
        outside braces is ignored here (the MIR side re-splits `value` on the
        same top-level brace logic to recover the surrounding segments)."""
        var parts: [HirInterpolation] = []
        var depth = 0
        var inner = ""
        var i = 0
        val n = value.len()
        while i < n:
            val ch = value[i:i + 1]
            if depth == 0 and ch == "{":
                depth = 1
                inner = ""
            elif depth > 0 and ch == "{":
                depth = depth + 1
                inner = inner + ch
            elif depth > 0 and ch == "}":
                depth = depth - 1
                if depth == 0:
                    val part_expr = self.bootstrap_interp_expr_from_source(inner, span)
                    parts = parts.push(HirInterpolation(expr: part_expr, has_format: false, format: "", span: span))
                else:
                    inner = inner + ch
            elif depth > 0:
                inner = inner + ch
            i = i + 1
        parts

    me lower_bootstrap_flat_stmt(stmt_idx: i64) -> HirStmt:
        val span = Span.empty()
        eprint("[hir-lower] flat_stmt:start {stmt_idx}")
        val tag = stmt_get_tag(stmt_idx)
        eprint("[hir-lower] flat_stmt:tag {stmt_idx} {tag}")
        if tag == STMT_EXPR:
            return HirStmt(kind: HirStmtKind.Expr(self.lower_bootstrap_flat_expr(stmt_get_expr(stmt_idx))), span: span)
        if tag == STMT_RETURN:
            val expr_idx = stmt_get_expr(stmt_idx)
            # Bare-lift: explicit Some(...) builds a heap Option box on the
            # stage4 native lane; MIR lower_expr then sees the box header
            # (<value:0x100000004>) — bug doc 2026-07-23.
            var value: HirExpr? = nil
            if expr_idx >= 0:
                value = self.lower_bootstrap_flat_expr(expr_idx)
            return HirStmt(kind: HirStmtKind.Expr(HirExpr(kind: HirExprKind.Return(value), has_type_: true, type_: HirType(kind: HirTypeKind.Unit, span: span), span: span)), span: span)
        if tag == STMT_VAL_DECL or tag == STMT_VAR_DECL:
            return HirStmt(kind: HirStmtKind.Expr(HirExpr(kind: HirExprKind.NilLit, has_type_: true, type_: HirType(kind: HirTypeKind.Unit, span: span), span: span)), span: span)
        HirStmt(kind: HirStmtKind.Expr(HirExpr(kind: HirExprKind.NilLit, has_type_: true, type_: HirType(kind: HirTypeKind.Unit, span: span), span: span)), span: span)

    me lower_bootstrap_flat_block(stmt_ids: [i64]) -> HirBlock:
        val span = Span.empty()
        var stmts: [HirStmt] = []
        var has_value = false
        var value_expr = HirExpr(kind: HirExprKind.NilLit, has_type_: true, type_: HirType(kind: HirTypeKind.Unit, span: span), span: span)
        val expr_stmt_disc = rt_enum_discriminant(HirStmtKind.Expr(value_expr))
        val return_expr_disc = rt_enum_discriminant(HirExprKind.Return(nil))
        var i = 0
        while i < stmt_ids.len():
            eprint("[hir-lower] flat_block:stmt {i}")
            val stmt = self.lower_bootstrap_flat_stmt(stmt_ids[i])
            eprint("[hir-lower] flat_block:stmt:done {i}")
            if i == stmt_ids.len() - 1:
                if rt_enum_discriminant(stmt.kind) == expr_stmt_disc:
                    match stmt.kind:
                        case HirStmtKind.Expr(expr):
                            if rt_enum_discriminant(expr.kind) == return_expr_disc:
                                stmts.push(stmt)
                            else:
                                has_value = true
                                value_expr = expr
                        case _:
                            stmts.push(stmt)
                else:
                    stmts.push(stmt)
            else:
                stmts.push(stmt)
            i = i + 1
        HirBlock(stmts: stmts, has: has_value, value: value_expr, span: span)
