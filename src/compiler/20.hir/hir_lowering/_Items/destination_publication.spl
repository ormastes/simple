# Serialized parser-to-destination publication. No graph aggregate crosses
# this module: the registry receives only slot/generation and scalar row ids.
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.hir_destination_graph.*
use compiler.hir.hir_lowering.hir_destination_registry_writer.*
use compiler.hir.hir_lowering._Items.lowering_helpers.{
    bootstrap_hir_modules_add_graph,
    bootstrap_hir_modules_cancel_pending_graph, function_params}
use compiler.frontend.parser_types.*
use compiler.frontend.parser_types_expr.*
use compiler.common.attributes.{parse_function_attrs, parse_export_attrs,
    parse_driver_manifest_attrs, parse_vhdl_hardware_attrs,
    DriverManifestAttrKind, FunctionAttr}
use compiler.common.dependency.visibility.{Visibility}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolKind, ScopeKind, HirTypeKind}

extern fn rt_enum_discriminant(value: Any) -> i64

var _hd_module_active: bool = false
var _hd_module_slot: i64 = -1
var _hd_module_generation: i64 = -1
var _hd_module_row: i64 = -1
var _hd_module_function_start: i64 = -1
var _hd_module_checkpoint: i64 = -1
var _hd_members_drained: bool = false
var _hd_parent_generic: bool = false
var _hd_last_function_params: i64 = -1
var _hd_last_function_return_type: i64 = -1
var _hd_last_function_span: i64 = -1
# Module-local source-order overload ordinals. This producer-owned map never
# enters the destination graph and is cleared at every module boundary.
var _hd_overload_counts: Dict<text, i64> = {}

fn hd_visibility_wire(visibility: Visibility) -> i64:
    match visibility:
        case Visibility.Public: 0
        case Visibility.Peer: 1
        case Visibility.Up: 2
        case Visibility.Internal: 3
        case Visibility.Package: 4
        case Visibility.Private: 5

fn hd_attr_flags(fn_: ParserFunction, attr: FunctionAttr) -> i64:
    (if attr.is_entry: HD_ATTR_ENTRY else: 0) +
        (if attr.is_naked: HD_ATTR_NAKED else: 0) +
        (if attr.is_noreturn: HD_ATTR_NORETURN else: 0) +
        (if attr.is_interrupt: HD_ATTR_INTERRUPT else: 0) +
        (if attr.is_boot: HD_ATTR_BOOT else: 0) +
        (if attr.is_alloc: HD_ATTR_ALLOC else: 0) +
        (if attr.is_no_alloc: HD_ATTR_NO_ALLOC else: 0) +
        (if attr.is_gpu_kernel or fn_.is_kernel: HD_ATTR_GPU_KERNEL else: 0) +
        (if attr.is_simd: HD_ATTR_SIMD else: 0) +
        (if attr.has_fast_math: HD_ATTR_FAST_MATH else: 0) +
        (if attr.simd_enable: HD_ATTR_SIMD_ENABLE else: 0) +
        (if attr.simd_disable: HD_ATTR_SIMD_DISABLE else: 0) +
        (if attr.simd_prefer_scalable: HD_ATTR_SIMD_SCALABLE else: 0) +
        (if attr.is_rt_hal: HD_ATTR_RT_HAL else: 0) +
        (if attr.rt_hal_compare_c: HD_ATTR_RT_COMPARE_C else: 0) +
        (if attr.rt_hal_compare_rust: HD_ATTR_RT_COMPARE_RUST else: 0)

fn hd_function_flags(fn_: ParserFunction, generic_template: bool,
                     has_export: bool, has_driver: bool,
                     has_vhdl: bool, has_contract: bool,
                     effective_public: bool) -> i64:
    (if fn_.is_async: HD_FUNC_ASYNC else: 0) +
        (if fn_.is_static: HD_FUNC_STATIC else: 0) +
        (if effective_public: HD_FUNC_PUBLIC else: 0) +
        (if fn_.is_method: HD_FUNC_METHOD else: 0) +
        (if fn_.is_mutable: HD_FUNC_MUTABLE else: 0) +
        (if fn_.is_const: HD_FUNC_CONST else: 0) +
        (if fn_.is_extern: HD_FUNC_EXTERN else: 0) +
        (if fn_.is_kernel: HD_FUNC_GPU_KERNEL else: 0) +
        (if generic_template: HD_FUNC_GENERIC_TEMPLATE else: 0) +
        (if has_export: HD_FUNC_HAS_EXPORT else: 0) +
        (if has_driver: HD_FUNC_HAS_DRIVER else: 0) +
        (if has_vhdl: HD_FUNC_HAS_VHDL else: 0) +
        (if fn_.has_doc_comment: HD_FUNC_HAS_DOC else: 0) +
        (if has_contract: HD_FUNC_HAS_CONTRACT else: 0)

fn hd_contract_present(contract: ContractBlock) -> bool:
    var has_decreases = false
    if val _measure = contract.decrease_measure: has_decreases = true
    (contract.preconditions.len() > 0 or contract.invariants.len() > 0 or
        contract.postconditions.len() > 0 or
        contract.error_postconditions.len() > 0 or
        contract.proof_uses != "" or has_decreases)

fn hd_destination_param_count(fn_: ParserFunction) -> i64:
    val params = function_params(fn_)
    var implicit_self = false
    if (fn_.is_method and not fn_.is_static and
        (params.len() == 0 or
         (params[0].name != "self" and params[0].name != "me"))):
        implicit_self = true
    params.len() + (if implicit_self: 1 else: 0)

fn hd_function_result_outcome(fn_: ParserFunction) -> bool:
    if not fn_.has_return_type: return false
    match fn_.return_type.kind:
        case TypeKind.Named(name, _): name == "Result"
        case _: false

impl HirLowering:
    me destination_next_overload_ordinal(owner_symbol: i64, name: text) -> i64:
        if not _hd_module_active or name == "": return -1
        val key = "{_hd_module_row}:{owner_symbol}:{name}"
        val ordinal = if _hd_overload_counts.contains_key(key):
            _hd_overload_counts[key]
        else:
            0
        _hd_overload_counts[key] = ordinal + 1
        ordinal

    me destination_parent_generic_set(enabled: bool):
        if self.destination_graph_active(): _hd_parent_generic = enabled

    fn destination_last_function_params() -> i64:
        _hd_last_function_params

    fn destination_last_function_return_type() -> i64:
        _hd_last_function_return_type

    fn destination_last_function_span() -> i64:
        _hd_last_function_span

    me destination_begin_module_publication() -> bool:
        if (not self.destination_graph_active() or _hd_module_active or
            self.current_destination_module_index < 0):
            return false
        val start = hdw_function_count_building(
            self.destination_slot, self.destination_generation)
        val checkpoint = hdw_checkpoint(
            self.destination_slot, self.destination_generation)
        if (start < 0 or checkpoint < 0 or
                not hdw_begin_module_declarations(self.destination_slot,
                    self.destination_generation,
                    self.current_destination_module_index)):
            if checkpoint >= 0:
                hdw_rollback(self.destination_slot,
                    self.destination_generation, checkpoint)
            return false
        _hd_module_active = true
        _hd_module_slot = self.destination_slot
        _hd_module_generation = self.destination_generation
        _hd_module_row = self.current_destination_module_index
        _hd_module_function_start = start
        _hd_module_checkpoint = checkpoint
        _hd_members_drained = false
        _hd_parent_generic = false
        _hd_last_function_params = -1
        _hd_last_function_return_type = -1
        _hd_last_function_span = -1
        _hd_overload_counts = {}
        true

    me destination_abort_module_publication(message: text) -> bool:
        if not _hd_module_active: return false
        val rolled_back = hdw_rollback(_hd_module_slot,
            _hd_module_generation, _hd_module_checkpoint)
        if _hd_module_row >= 0:
            hdw_fail_module(_hd_module_slot, _hd_module_generation,
                _hd_module_row, message)
        _hd_module_active = false; _hd_module_slot = -1
        _hd_module_generation = -1; _hd_module_row = -1
        _hd_module_function_start = -1; _hd_module_checkpoint = -1
        _hd_members_drained = false
        _hd_parent_generic = false
        _hd_last_function_params = -1
        _hd_last_function_return_type = -1
        _hd_last_function_span = -1
        _hd_overload_counts = {}
        rolled_back

    # Drain producer-staged members exactly once while the outer module
    # checkpoint still owns every affected row.  Declaration metadata consumes
    # the finalized owner ranges, so the direct route calls this before its
    # metadata pass; legacy callers may leave the guarded call to finalization.
    me destination_drain_module_members() -> bool:
        if (not self.destination_graph_active() or not _hd_module_active or
            _hd_module_slot != self.destination_slot or
            _hd_module_generation != self.destination_generation or
            _hd_module_row != self.current_destination_module_index):
            return false
        if _hd_members_drained: return true
        if not hdw_drain_destination_members(self.destination_slot,
                self.destination_generation):
            return false
        _hd_members_drained = true
        true

    me destination_reserve_type_range(types: [Type]) -> i64:
        val range = hdw_reserve_range(self.destination_slot,
            self.destination_generation, HD_RANGE_TYPE, HD_AUX_RANGE_NONE,
            types.len())
        if range < 0: return -1
        var i = 0
        while i < types.len():
            val row = self.destination_lower_type(types[i])
            if row < 0 or not hdw_set_range_at(self.destination_slot,
                    self.destination_generation, range, HD_AUX_RANGE_NONE,
                    i, row):
                return -1
            i = i + 1
        if not hdw_publish_range(self.destination_slot,
                self.destination_generation, range, HD_RANGE_TYPE,
                HD_AUX_RANGE_NONE):
            return -1
        range

    me destination_publish_type_params(fn_: ParserFunction) -> i64:
        val count = fn_.type_params.len()
        val range = hdw_reserve_range(self.destination_slot,
            self.destination_generation, HD_RANGE_AUX,
            HD_AUX_RANGE_TYPE_PARAM, count)
        if range < 0: return -1
        var i = 0
        while i < count:
            val source = fn_.type_params[i]
            val bounds = self.destination_reserve_type_range(source.bounds)
            val default_type = if source.has_default:
                self.destination_lower_type(source.default)
            else: -1
            val symbol = self.symbols.lookup_or_invalid(source.name).id
            val aux = hdw_reserve_aux(self.destination_slot,
                self.destination_generation, source.span.start,
                source.span.end, source.span.line, source.span.col,
                source.span.file, source.span.length)
            if (bounds < 0 or symbol < 0 or aux < 0 or
               (source.has_default and default_type < 0) or
               not hdw_type_param_metadata(self.destination_slot,
                    self.destination_generation, aux, symbol, source.name,
                    bounds, source.bounds.len(), source.has_default,
                    default_type) or
               not hdw_set_range_at(self.destination_slot,
                    self.destination_generation, range,
                    HD_AUX_RANGE_TYPE_PARAM, i, aux)):
                return -1
            i = i + 1
        if not hdw_publish_range(self.destination_slot,
                self.destination_generation, range, HD_RANGE_AUX,
                HD_AUX_RANGE_TYPE_PARAM): return -1
        range

    me destination_publish_params(fn_: ParserFunction) -> i64:
        val params = function_params(fn_)
        var implicit_self = false
        if (fn_.is_method and not fn_.is_static and
            (params.len() == 0 or
             (params[0].name != "self" and params[0].name != "me"))):
            implicit_self = true
        val total_count = params.len() + (if implicit_self: 1 else: 0)
        val range = hdw_reserve_range(self.destination_slot,
            self.destination_generation, HD_RANGE_AUX,
            HD_AUX_RANGE_VALUE_PARAM, total_count)
        if range < 0: return -1
        var i = 0
        if implicit_self:
            val span = fn_.span
            val type_row = hdw_reserve_type(self.destination_slot,
                self.destination_generation, span.start, span.end, span.line,
                span.col, span.file, span.length)
            val arg_range = hdw_reserve_range(self.destination_slot,
                self.destination_generation, HD_RANGE_TYPE,
                HD_AUX_RANGE_NONE, 0)
            if arg_range < 0 or not hdw_publish_range(self.destination_slot,
                    self.destination_generation, arg_range, HD_RANGE_TYPE,
                    HD_AUX_RANGE_NONE): return -1
            # Direct graph lowering carries nominal ownership as a scalar id;
            # legacy aggregate lowering may additionally provide HirType.
            var owner_symbol = self.current_method_self_symbol_id
            if val owner_type = self.current_method_self_type:
                match owner_type.kind:
                    case HirTypeKind.Named(symbol, _): owner_symbol = symbol.id
                    case _: ()
            val self_symbol = self.symbols.lookup_or_invalid("self").id
            val aux = hdw_reserve_aux(self.destination_slot,
                self.destination_generation, span.start, span.end, span.line,
                span.col, span.file, span.length)
            if (owner_symbol < 0 or self_symbol < 0 or type_row < 0 or aux < 0 or
               not hdw_type_named(self.destination_slot,
                    self.destination_generation, type_row,
                    self.current_destination_module_index, owner_symbol,
                    arg_range, 0) or
               not hdw_param_aux(self.destination_slot,
                    self.destination_generation, aux, self_symbol, type_row,
                    false, -1, false, "self") or
               not hdw_set_range_at(self.destination_slot,
                    self.destination_generation, range,
                    HD_AUX_RANGE_VALUE_PARAM, 0, aux)):
                return -1
        while i < params.len():
            val source = params[i]
            val type_row = if source.has_type_:
                self.destination_lower_type(source.type_)
            else:
                val inferred = hdw_reserve_type(self.destination_slot,
                    self.destination_generation, source.span.start,
                    source.span.end, source.span.line, source.span.col,
                    source.span.file, source.span.length)
                if inferred >= 0:
                    hdw_type_leaf(self.destination_slot,
                        self.destination_generation, inferred, HD_TYPE_ANY)
                inferred
            val default_row = if source.has_default:
                self.lower_hir_expr_into_destination(source.default)
            else: -1
            val symbol = self.symbols.lookup_or_invalid(source.name).id
            val aux = hdw_reserve_aux(self.destination_slot,
                self.destination_generation, source.span.start,
                source.span.end, source.span.line, source.span.col,
                source.span.file, source.span.length)
            if (type_row < 0 or symbol < 0 or aux < 0 or
               (source.has_default and default_row < 0) or
               not hdw_param_aux(self.destination_slot,
                    self.destination_generation, aux, symbol, type_row,
                    source.has_default, default_row, source.is_mutable,
                    source.name) or
               not hdw_set_range_at(self.destination_slot,
                    self.destination_generation, range,
                    HD_AUX_RANGE_VALUE_PARAM,
                    i + (if implicit_self: 1 else: 0), aux)):
                return -1
            i = i + 1
        if not hdw_publish_range(self.destination_slot,
                self.destination_generation, range, HD_RANGE_AUX,
                HD_AUX_RANGE_VALUE_PARAM): return -1
        range

    me destination_publish_contract(
        contract: ContractBlock, result_outcome: bool
    ) -> i64:
        var decreases_count = 0
        if val _measure = contract.decrease_measure: decreases_count = 1
        val count = contract.preconditions.len() + contract.invariants.len() +
            contract.postconditions.len() +
            contract.error_postconditions.len() +
            decreases_count
        val clause_range = hdw_reserve_range(self.destination_slot,
            self.destination_generation, HD_RANGE_AUX,
            HD_AUX_RANGE_CONTRACT_CLAUSE, count)
        if clause_range < 0: return -1
        var offset = 0
        var kind = 0
        while kind < 4:
            val clauses: [ContractClause] = if kind == 0:
                contract.preconditions
            elif kind == 1:
                contract.invariants
            elif kind == 2:
                contract.postconditions
            else:
                contract.error_postconditions
            var i = 0
            while i < clauses.len():
                val predicate = self.lower_hir_expr_into_destination(clauses[i].expr)
                val aux = hdw_reserve_aux(self.destination_slot,
                    self.destination_generation, clauses[i].span.start,
                    clauses[i].span.end, clauses[i].span.line,
                    clauses[i].span.col, clauses[i].span.file,
                    clauses[i].span.length)
                val binding = if kind == 2: contract.postcondition_binding
                    elif kind == 3: contract.error_binding else: ""
                if (predicate < 0 or aux < 0 or
                   not hdw_contract_clause_metadata(self.destination_slot,
                        self.destination_generation, aux, kind, predicate,
                        binding) or
                   not hdw_set_range_at(self.destination_slot,
                        self.destination_generation, clause_range,
                        HD_AUX_RANGE_CONTRACT_CLAUSE, offset, aux)):
                    return -1
                offset = offset + 1; i = i + 1
            kind = kind + 1
        if val measure = contract.decrease_measure:
            val predicate = self.lower_hir_expr_into_destination(measure.expr)
            val aux = hdw_reserve_aux(self.destination_slot,
                self.destination_generation, measure.span.start,
                measure.span.end, measure.span.line, measure.span.col,
                measure.span.file, measure.span.length)
            if (predicate < 0 or aux < 0 or
                not hdw_contract_clause_metadata(self.destination_slot,
                    self.destination_generation, aux, 4, predicate, "") or
                not hdw_set_range_at(self.destination_slot,
                    self.destination_generation, clause_range,
                    HD_AUX_RANGE_CONTRACT_CLAUSE, offset, aux)):
                return -1
        if not hdw_publish_range(self.destination_slot,
                self.destination_generation, clause_range, HD_RANGE_AUX,
                HD_AUX_RANGE_CONTRACT_CLAUSE): return -1
        val metadata = hdw_reserve_aux(self.destination_slot,
            self.destination_generation, 0, 0, 0, 0, "", 0)
        if metadata < 0 or not hdw_contract_metadata(self.destination_slot,
                self.destination_generation, metadata, clause_range, count,
                contract.proof_uses,
                if result_outcome: 1 else: 0):
            return -1
        metadata

    me destination_publish_metadata(fn_: ParserFunction,
        generic_template: bool) -> (i64, i64, i64):
        val export_attr = parse_export_attrs(fn_.attributes)
        val driver_attr = parse_driver_manifest_attrs(fn_.attributes)
        val vhdl = parse_vhdl_hardware_attrs(fn_.attributes)
        val fa = parse_function_attrs(fn_.attributes)
        var has_export = false; if val _e = export_attr: has_export = true
        var has_driver = false; if val _d = driver_attr: has_driver = true
        val has_contract = hd_contract_present(fn_.contract)
        val metadata_count = 1 + (if has_export: 1 else: 0) +
            (if has_driver: 1 else: 0) + (if vhdl.is_hardware: 1 else: 0) +
            (if fn_.has_doc_comment: 1 else: 0) +
            (if fn_.is_kernel or fa.is_gpu_kernel: 1 else: 0) +
            (if has_contract: 1 else: 0) + (if generic_template: 1 else: 0)
        val range = hdw_reserve_range(self.destination_slot,
            self.destination_generation, HD_RANGE_AUX,
            HD_AUX_RANGE_FUNCTION_METADATA, metadata_count)
        if range < 0: return (-1, -1, -1)
        var offset = 0
        var has_section = false; var section = ""
        if val present_section = fa.section:
            has_section = true; section = present_section
        var aux = hdw_reserve_aux(self.destination_slot,
            self.destination_generation, fn_.span.start, fn_.span.end,
            fn_.span.line, fn_.span.col, fn_.span.file, fn_.span.length)
        if aux < 0 or not hdw_function_attr_metadata(self.destination_slot,
                self.destination_generation, aux, hd_attr_flags(fn_, fa),
                has_section, section,
                rt_enum_discriminant(fa.optimization_req.level),
                rt_enum_discriminant(fa.optimization_req.backend),
                fa.unroll_factor, fa.pipeline_ii, fa.memory_banks,
                fa.rt_hal_error) or
           not hdw_set_range_at(self.destination_slot,
                self.destination_generation, range,
                HD_AUX_RANGE_FUNCTION_METADATA, offset, aux):
            return (-1, -1, -1)
        offset = offset + 1
        if val export_value = export_attr:
            aux = hdw_reserve_aux(self.destination_slot,
                self.destination_generation, fn_.span.start, fn_.span.end,
                fn_.span.line, fn_.span.col, fn_.span.file, fn_.span.length)
            if aux < 0 or not hdw_export_metadata(self.destination_slot,
                    self.destination_generation, aux,
                    export_value.is_export_c, export_value.export_name) or
               not hdw_set_range_at(self.destination_slot,
                    self.destination_generation, range,
                    HD_AUX_RANGE_FUNCTION_METADATA, offset, aux):
                return (-1, -1, -1)
            offset = offset + 1
        if val driver = driver_attr:
            val devices = hdw_reserve_range(self.destination_slot,
                self.destination_generation, HD_RANGE_AUX,
                HD_AUX_RANGE_SYMBOL_REF, driver.device_ids.len())
            var di = 0
            while di < driver.device_ids.len():
                val device = hdw_reserve_aux(self.destination_slot,
                    self.destination_generation, 0, 0, 0, 0, "", 0)
                if device < 0 or not hdw_symbol_aux(self.destination_slot,
                        self.destination_generation, device,
                        driver.device_ids[di]) or
                   not hdw_set_range_at(self.destination_slot,
                        self.destination_generation, devices,
                        HD_AUX_RANGE_SYMBOL_REF, di, device):
                    return (-1, -1, -1)
                di = di + 1
            if not hdw_publish_range(self.destination_slot,
                    self.destination_generation, devices, HD_RANGE_AUX,
                    HD_AUX_RANGE_SYMBOL_REF): return (-1, -1, -1)
            aux = hdw_reserve_aux(self.destination_slot,
                self.destination_generation, fn_.span.start, fn_.span.end,
                fn_.span.line, fn_.span.col, fn_.span.file, fn_.span.length)
            if aux < 0 or not hdw_driver_metadata(self.destination_slot,
                    self.destination_generation, aux,
                    if driver.kind == DriverManifestAttrKind.Driver: 0 else: 1,
                    driver.driver_class, driver.vendor, devices,
                    driver.device_ids.len(), driver.version, driver.abi) or
               not hdw_set_range_at(self.destination_slot,
                    self.destination_generation, range,
                    HD_AUX_RANGE_FUNCTION_METADATA, offset, aux):
                return (-1, -1, -1)
            offset = offset + 1
        # VHDL metadata is impossible on the admitted streaming graph route
        # (the route gate excludes the VHDL backend). Fail closed instead of
        # silently truncating nested VHDL records if one appears in source.
        if vhdl.is_hardware: return (-1, -1, -1)
        if fn_.has_doc_comment:
            aux = hdw_reserve_aux(self.destination_slot,
                self.destination_generation, fn_.span.start, fn_.span.end,
                fn_.span.line, fn_.span.col, fn_.span.file, fn_.span.length)
            if aux < 0 or not hdw_doc_metadata(self.destination_slot,
                    self.destination_generation, aux, fn_.doc_comment) or
               not hdw_set_range_at(self.destination_slot,
                    self.destination_generation, range,
                    HD_AUX_RANGE_FUNCTION_METADATA, offset, aux):
                return (-1, -1, -1)
            offset = offset + 1
        if fn_.is_kernel or fa.is_gpu_kernel:
            aux = hdw_reserve_aux(self.destination_slot,
                self.destination_generation, fn_.span.start, fn_.span.end,
                fn_.span.line, fn_.span.col, fn_.span.file, fn_.span.length)
            if aux < 0 or not hdw_gpu_metadata(self.destination_slot,
                    self.destination_generation, aux, fa.gpu_target,
                    fa.gpu_backends) or
               not hdw_set_range_at(self.destination_slot,
                    self.destination_generation, range,
                    HD_AUX_RANGE_FUNCTION_METADATA, offset, aux):
                return (-1, -1, -1)
            offset = offset + 1
        if has_contract:
            aux = self.destination_publish_contract(
                fn_.contract, hd_function_result_outcome(fn_))
            if aux < 0 or not hdw_set_range_at(self.destination_slot,
                    self.destination_generation, range,
                    HD_AUX_RANGE_FUNCTION_METADATA, offset, aux):
                return (-1, -1, -1)
            offset = offset + 1
        if generic_template:
            aux = hdw_reserve_aux(self.destination_slot,
                self.destination_generation, fn_.span.start, fn_.span.end,
                fn_.span.line, fn_.span.col, fn_.span.file, fn_.span.length)
            if aux < 0 or not hdw_generic_template_metadata(
                    self.destination_slot, self.destination_generation,
                    aux, true) or
               not hdw_set_range_at(self.destination_slot,
                    self.destination_generation, range,
                    HD_AUX_RANGE_FUNCTION_METADATA, offset, aux):
                return (-1, -1, -1)
        if not hdw_publish_range(self.destination_slot,
                self.destination_generation, range, HD_RANGE_AUX,
                HD_AUX_RANGE_FUNCTION_METADATA): return (-1, -1, -1)
        (range, metadata_count,
            hd_function_flags(fn_, generic_template, has_export, has_driver,
                vhdl.is_hardware, has_contract,
                effective_visibility == Visibility.Public))

    # Called while the function scope and parameter symbols are live. A
    # checkpoint owns every signature/body row and is committed only after the
    # function receipt has been finalized.
    me destination_publish_function(fn_: ParserFunction, symbol: i64,
        effective_visibility: Visibility, generic_template: bool,
        overload_ordinal: i64 = 0) -> i64:
        _hd_last_function_params = -1
        _hd_last_function_return_type = -1
        _hd_last_function_span = -1
        if not self.destination_graph_active(): return -1
        val effective_generic_template = generic_template or _hd_parent_generic
        val checkpoint = hdw_checkpoint(self.destination_slot,
            self.destination_generation)
        if checkpoint < 0: return -1
        val span = hdw_reserve_span(self.destination_slot,
            self.destination_generation, fn_.span.start, fn_.span.end,
            fn_.span.line, fn_.span.col, fn_.span.file, fn_.span.length)
        val owner_symbol = if fn_.is_method or fn_.is_static:
            self.current_method_self_symbol_id
        else: -1
        val symbol_kind = if fn_.is_method and not fn_.is_static: 1 else: 0
        val symbol_row = if span >= 0:
            self.publish_current_destination_symbol(
                symbol, fn_.name, false, -1,
                hd_visibility_wire(effective_visibility), owner_symbol,
                symbol_kind, fn_.is_mutable, self.module_filename != "",
                self.module_filename, self.symbols.current_scope.id, span,
                effective_visibility == Visibility.Public)
        else: -1
        val type_params = self.destination_publish_type_params(fn_)
        val params = self.destination_publish_params(fn_)
        # The parser owns an Infer placeholder for an omitted annotation.
        # Preserve that unresolved signature in the destination graph; Unit is
        # a later semantic result only when inference proves it.
        val return_type = self.destination_lower_type(fn_.return_type)
        val effects = hdw_reserve_range(self.destination_slot,
            self.destination_generation, HD_RANGE_EFFECT,
            HD_AUX_RANGE_NONE, if fn_.is_async: 1 else: 0)
        if fn_.is_async and effects >= 0:
            val effect = hdw_reserve_effect(self.destination_slot,
                self.destination_generation, fn_.span.start, fn_.span.end,
                fn_.span.line, fn_.span.col, fn_.span.file, fn_.span.length)
            if effect < 0 or not hdw_effect_async(self.destination_slot,
                    self.destination_generation, effect) or
               not hdw_set_range_at(self.destination_slot,
                    self.destination_generation, effects,
                    HD_AUX_RANGE_NONE, 0, effect):
                hdw_rollback(self.destination_slot,
                    self.destination_generation, checkpoint)
                return -1
        if effects < 0 or not hdw_publish_range(self.destination_slot,
                self.destination_generation, effects, HD_RANGE_EFFECT,
                HD_AUX_RANGE_NONE):
            hdw_rollback(self.destination_slot,
                self.destination_generation, checkpoint); return -1
        val body = self.destination_lower_block(fn_.body, fn_.has_return_type)
        val metadata = self.destination_publish_metadata(
            fn_, effective_generic_template)
        if (span < 0 or symbol_row < 0 or type_params < 0 or params < 0 or
            return_type < 0 or body < 0 or metadata.0 < 0):
            hdw_rollback(self.destination_slot,
                self.destination_generation, checkpoint); return -1
        val row = hdw_reserve_function(self.destination_slot,
            self.destination_generation, self.current_destination_module_index,
            body, symbol, fn_.name, span, overload_ordinal)
        if row < 0 or not hdw_finalize_function(self.destination_slot,
                self.destination_generation, row, type_params,
                fn_.type_params.len(), params, hd_destination_param_count(fn_),
                return_type, effects, if fn_.is_async: 1 else: 0,
                metadata.0, metadata.1,
                hd_visibility_wire(effective_visibility), metadata.2):
            hdw_rollback(self.destination_slot,
                self.destination_generation, checkpoint); return -1
        if owner_symbol >= 0:
            var ordinal = hdw_destination_member_range_len(
                self.destination_slot, self.destination_generation,
                self.current_destination_module_index, owner_symbol)
            if ordinal < 0: ordinal = 0
            if self.publish_current_destination_member(
                    owner_symbol, fn_.name, ordinal, symbol, false, -1,
                    false, -1, false, false, -1, false, -1, span) < 0:
                hdw_rollback(self.destination_slot,
                    self.destination_generation, checkpoint)
                return -1
        if not hdw_commit_checkpoint(self.destination_slot,
                self.destination_generation, checkpoint):
            hdw_rollback(self.destination_slot,
                self.destination_generation, checkpoint)
            return -1
        _hd_last_function_params = params
        _hd_last_function_return_type = return_type
        _hd_last_function_span = span
        row

    me destination_finalize_module_publication(
        module_name: text, is_entry: bool
    ) -> bool:
        if (not self.destination_graph_active() or not _hd_module_active or
           _hd_module_slot != self.destination_slot or
           _hd_module_generation != self.destination_generation or
           _hd_module_row != self.current_destination_module_index):
            return false
        val function_end = hdw_function_count_building(
            self.destination_slot, self.destination_generation)
        val function_count = function_end - _hd_module_function_start
        if function_count < 0: return false
        val roots = hdw_reserve_range(self.destination_slot,
            self.destination_generation, HD_RANGE_BLOCK,
            HD_AUX_RANGE_NONE, function_count)
        val tokens = hdw_reserve_range(self.destination_slot,
            self.destination_generation, HD_RANGE_TOKEN,
            HD_AUX_RANGE_NONE, function_count)
        if roots < 0 or tokens < 0: return false
        var i = 0
        while i < function_count:
            val row = _hd_module_function_start + i
            val root = hdw_function_root_building(self.destination_slot,
                self.destination_generation, row)
            val token = hdw_function_token_building(self.destination_slot,
                self.destination_generation, row)
            if (root < 0 or token < 0 or
               not hdw_set_range_at(self.destination_slot,
                    self.destination_generation, roots,
                    HD_AUX_RANGE_NONE, i, root) or
               not hdw_set_range_at(self.destination_slot,
                    self.destination_generation, tokens,
                    HD_AUX_RANGE_NONE, i, token)):
                return false
            i = i + 1
        if not hdw_publish_range(self.destination_slot,
                self.destination_generation, roots, HD_RANGE_BLOCK,
                HD_AUX_RANGE_NONE) or
           not hdw_publish_range(self.destination_slot,
                self.destination_generation, tokens, HD_RANGE_TOKEN,
                HD_AUX_RANGE_NONE): return false
        val imports = self.destination_publish_import_routes()
        val exports = self.destination_publish_export_routes()
        var surface_refs: [i64] = [self.module_surfaces.surfaces[
            self.current_destination_module_index].physical_index]
        for target in self.module_surfaces.surfaces[
                self.current_destination_module_index].import_target_indices:
            # Unresolved imports remain first-class import route rows, but are
            # not valid resolved surface identities.
            if target >= 0: surface_refs.push(target)
        for target in self.module_surfaces.surfaces[
                self.current_destination_module_index].export_route_target_indices:
            # Export-only dependencies are part of module authority too.
            # Preserve route order in one linear pass; downstream authority
            # ranges permit repeated refs and therefore need no dedup map.
            if target >= 0: surface_refs.push(target)
        val surfaces = self.destination_publish_symbol_range(
            surface_refs, HD_AUX_RANGE_MODULE_SURFACE)
        if (imports < 0 or exports < 0 or surfaces < 0 or
           not self.destination_drain_module_members() or
           not hdw_finalize_module(self.destination_slot,
                self.destination_generation,
                self.current_destination_module_index,
                roots, function_count, tokens, function_count,
                imports, self.destination_import_route_count(),
                exports, self.module_surfaces.surfaces[
                    self.current_destination_module_index].export_route_sources.len(),
                surfaces, surface_refs.len())):
            return false
        val stored = bootstrap_hir_modules_add_graph(module_name, is_entry,
            self.destination_slot, self.destination_generation,
            self.current_destination_module_index,
            _hd_module_function_start, function_count)
        if not stored: return false
        if not hdw_commit_checkpoint(self.destination_slot,
                self.destination_generation, _hd_module_checkpoint):
            bootstrap_hir_modules_cancel_pending_graph(
                self.destination_slot, self.destination_generation,
                self.current_destination_module_index)
            return false
        _hd_module_active = false; _hd_module_slot = -1
        _hd_module_generation = -1; _hd_module_row = -1
        _hd_module_function_start = -1; _hd_module_checkpoint = -1
        _hd_members_drained = false
        _hd_parent_generic = false
        _hd_overload_counts = {}
        true

    me destination_import_route_count() -> i64:
        val surface = self.module_surfaces.surfaces[
            self.current_destination_module_index]
        var count = 0; var declaration = 0
        while declaration < surface.imports.len():
            val start = surface.import_item_offsets[declaration]
            val finish = surface.import_item_offsets[declaration + 1]
            count = count + (if finish == start: 1 else: finish - start)
            declaration = declaration + 1
        count

    me destination_publish_import_routes() -> i64:
        val surface = self.module_surfaces.surfaces[
            self.current_destination_module_index]
        val count = self.destination_import_route_count()
        val range = hdw_reserve_range(self.destination_slot,
            self.destination_generation, HD_RANGE_AUX,
            HD_AUX_RANGE_MODULE_IMPORT, count)
        if range < 0: return -1
        var declaration = 0; var output = 0
        while declaration < surface.imports.len():
            val item_start = surface.import_item_offsets[declaration]
            val item_finish = surface.import_item_offsets[declaration + 1]
            val target = surface.import_target_indices[declaration]
            val target_name = surface.import_target_names[declaration]
            if item_start == item_finish:
                val aux = hdw_reserve_aux(self.destination_slot,
                    self.destination_generation, surface.imports[declaration].span.start,
                    surface.imports[declaration].span.end,
                    surface.imports[declaration].span.line,
                    surface.imports[declaration].span.col,
                    surface.imports[declaration].span.file,
                    surface.imports[declaration].span.length)
                if (aux < 0 or not hdw_module_import_aux(
                        self.destination_slot, self.destination_generation, aux,
                        target, declaration, -1, target_name, "", -1, true,
                        false, surface.imports[declaration].is_lazy) or
                    not hdw_set_range_at(self.destination_slot,
                        self.destination_generation, range,
                        HD_AUX_RANGE_MODULE_IMPORT, output, aux)):
                    return -1
                output = output + 1
            else:
                var item = item_start
                while item < item_finish:
                    val has_alias = surface.import_item_has_alias[item]
                    val source_name = surface.import_item_names[item]
                    val local_name = if has_alias:
                        surface.import_item_aliases[item]
                    else:
                        source_name
                    val aux = hdw_reserve_aux(self.destination_slot,
                        self.destination_generation, surface.imports[declaration].span.start,
                        surface.imports[declaration].span.end,
                        surface.imports[declaration].span.line,
                        surface.imports[declaration].span.col,
                        surface.imports[declaration].span.file,
                        surface.imports[declaration].span.length)
                    val local_aux = hdw_reserve_aux(self.destination_slot,
                        self.destination_generation, 0, 0, 0, 0,
                        surface.canonical_path, 0)
                    if (aux < 0 or local_aux < 0 or
                        not hdw_text_aux(self.destination_slot,
                            self.destination_generation, local_aux, local_name) or
                        not hdw_module_import_aux(
                            self.destination_slot, self.destination_generation,
                            aux, target, declaration, item - item_start,
                            target_name, source_name, local_aux, false,
                            has_alias, surface.imports[declaration].is_lazy) or
                        not hdw_set_range_at(self.destination_slot,
                            self.destination_generation, range,
                            HD_AUX_RANGE_MODULE_IMPORT, output, aux)):
                        return -1
                    output = output + 1; item = item + 1
            declaration = declaration + 1
        if output != count or not hdw_publish_range(self.destination_slot,
                self.destination_generation, range, HD_RANGE_AUX,
                HD_AUX_RANGE_MODULE_IMPORT):
            return -1
        range

    me destination_publish_export_routes() -> i64:
        val surface = self.module_surfaces.surfaces[
            self.current_destination_module_index]
        val count = surface.export_route_sources.len()
        val range = hdw_reserve_range(self.destination_slot,
            self.destination_generation, HD_RANGE_AUX,
            HD_AUX_RANGE_MODULE_EXPORT, count)
        if range < 0: return -1
        var route = 0
        while route < count:
            val aux = hdw_reserve_aux(self.destination_slot,
                self.destination_generation, 0, 0, 0, 0,
                surface.canonical_path, 0)
            var local_aux = -1
            val has_alias = (not surface.export_route_is_glob[route] and
                surface.export_route_locals[route] !=
                    surface.export_route_sources[route])
            if not surface.export_route_is_glob[route]:
                local_aux = hdw_reserve_aux(self.destination_slot,
                    self.destination_generation, 0, 0, 0, 0,
                    surface.canonical_path, 0)
                if (local_aux < 0 or not hdw_text_aux(self.destination_slot,
                        self.destination_generation, local_aux,
                        surface.export_route_locals[route])):
                    return -1
            if (aux < 0 or not hdw_module_export_aux(
                    self.destination_slot, self.destination_generation, aux,
                    surface.export_route_target_indices[route], route,
                    surface.export_route_target_names[route],
                    surface.export_route_sources[route],
                    local_aux,
                    surface.export_route_is_glob[route], has_alias) or
                not hdw_set_range_at(self.destination_slot,
                    self.destination_generation, range,
                    HD_AUX_RANGE_MODULE_EXPORT, route, aux)):
                return -1
            route = route + 1
        if not hdw_publish_range(self.destination_slot,
                self.destination_generation, range, HD_RANGE_AUX,
                HD_AUX_RANGE_MODULE_EXPORT):
            return -1
        range

    me destination_publish_symbol_range(values: [i64], subtype: i64) -> i64:
        val range = hdw_reserve_range(self.destination_slot,
            self.destination_generation, HD_RANGE_AUX, subtype, values.len())
        if range < 0: return -1
        var i = 0
        while i < values.len():
            val aux = hdw_reserve_aux(self.destination_slot,
                self.destination_generation, 0, 0, 0, 0, "", 0)
            if (values[i] < 0 or aux < 0 or
               not hdw_symbol_aux(self.destination_slot,
                    self.destination_generation, aux, values[i]) or
               not hdw_set_range_at(self.destination_slot,
                    self.destination_generation, range, subtype, i, aux)):
                return -1
            i = i + 1
        if not hdw_publish_range(self.destination_slot,
                self.destination_generation, range, HD_RANGE_AUX, subtype):
            return -1
        range

export HirLowering
