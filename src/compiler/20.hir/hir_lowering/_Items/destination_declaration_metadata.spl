# Lossless ParserModule declaration-metadata publication.  The caller owns the
# metadata store and supplies already-published function receipts as aligned
# scalar columns; no parser/HIR aggregate is retained by the destination graph.
use compiler.frontend.parser_types.*
use compiler.frontend.parser_types_expr.{TypeKind}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering._Expressions.destination_types_patterns.*
use compiler.hir.hir_lowering._Expressions.destination_expr_dispatch.*
use compiler.hir.hir_lowering._Expressions.destination_statements.*
use compiler.hir.hir_lowering.hir_destination_registry_writer.*
use compiler.hir.hir_destination_declaration_metadata.*

impl HirLowering:
    fn destination_metadata_span(span: Span) -> i64:
        hdw_reserve_span(self.destination_slot, self.destination_generation,
            span.start, span.end, span.line, span.col, span.file, span.length)

    fn destination_metadata_named_owner(kind: TypeKind) -> i64:
        match kind:
            case TypeKind.Named(name, _):
                val symbol = self.symbols.lookup_or_invalid(name)
                if symbol.is_valid(): symbol.id else: -1
            case _: -1

    fn destination_metadata_count() -> i64:
        hdw_declaration_metadata_count_building(
            self.destination_slot, self.destination_generation)

    fn destination_metadata_child_range(
        kind_id: i64, start: i64, len: i64
    ) -> i64:
        hdw_declaration_metadata_child_range(self.destination_slot,
            self.destination_generation, kind_id, start, len)

    fn destination_metadata_module_range(
        module_index: i64, kind_id: i64, start: i64, len: i64
    ) -> i64:
        hdw_declaration_metadata_module_range(self.destination_slot,
            self.destination_generation, module_index, kind_id, start, len)

    fn destination_metadata_append(kind_id: i64, module_index: i64,
        owner: i64, name: text, text0: text, text1: text,
        flag0: bool, flag1: bool, flag2: bool, value0: i64, value1: i64,
        value2: i64, value3: i64, value4: i64, value5: i64,
        span: i64) -> i64:
        hdw_declaration_metadata(self.destination_slot,
            self.destination_generation, kind_id, module_index, owner, name,
            text0, text1, flag0, flag1, flag2, value0, value1, value2,
            value3, value4, value5, span)

    me destination_metadata_nominal_type_params(
        module_index: i64, owner_symbol: i64, values: [ParserTypeParam]
    ) -> i64:
        val start=self.destination_metadata_count()
        var i=0
        while i<values.len():
            val source=values[i]
            val bounds=self.destination_type_range(source.bounds)
            var default_type=-1
            if source.has_default: default_type=self.destination_lower_type(source.default)
            val span=self.destination_metadata_span(source.span)
            if ((source.bounds.len()>0 and bounds<0) or
                (source.bounds.len()==0 and bounds!=-1) or span<0 or
                (source.has_default and default_type<0) or
                self.destination_metadata_append(HDDM_TYPE_PARAM,module_index,
                    owner_symbol,source.name,"","",source.has_default,false,
                    false,bounds,default_type,-1,-1,-1,-1,span)<0):
                return -1
            i=i+1
        self.destination_metadata_child_range(HDDM_TYPE_PARAM,start,
            self.destination_metadata_count()-start)

    # method_parent_kind is 1 for a trait and 2 for an impl;
    # method_parent_index is the source declaration index in that collection.
    # Rows must be grouped by (kind,index), which permits one O(N) publication
    # pass and exact child ranges without a lookup table or repeated scan.
    me destination_publish_parser_metadata(
        owner: ParserModuleOwner, actor_names: Dict<text, bool>,
        method_parent_kind: [i64], method_parent_index: [i64],
        method_owner: [i64], method_name: [text], method_row: [i64],
        method_token: [i64], method_root: [i64], method_params: [i64],
        method_return_type: [i64], method_is_static: [bool],
        method_span: [i64]
    ) -> bool:
        val method_count = method_row.len()
        if (method_parent_kind.len() != method_count or
            method_parent_index.len() != method_count or
            method_owner.len() != method_count or
            method_name.len() != method_count or
            method_token.len() != method_count or
            method_root.len() != method_count or
            method_params.len() != method_count or
            method_return_type.len() != method_count or
            method_is_static.len() != method_count or
            method_span.len() != method_count):
            return false

        val module_index = self.current_destination_module_index
        if module_index < 0: return false

        # Graph publication has one source-order authority: the parser's
        # parallel declaration schedule.  Never materialize Dict.keys() here;
        # dictionary iteration is neither a semantic ordering contract nor a
        # zero-copy projection.  The direct producer validates the complete
        # schedule before entering this metadata pass.
        var trait_names: [text] = []
        var alias_names: [text] = []
        var class_names: [text] = []
        var struct_names: [text] = []
        var schedule_index = 0
        while schedule_index < owner.value.declaration_kinds.len():
            val declaration_kind = owner.value.declaration_kinds[schedule_index]
            val declaration_name = owner.value.declaration_names[schedule_index]
            if declaration_kind == PARSER_DECL_TRAIT:
                trait_names.push(declaration_name)
            elif declaration_kind == PARSER_DECL_ALIAS:
                alias_names.push(declaration_name)
            elif declaration_kind == PARSER_DECL_CLASS:
                # A class row carrying actor provenance is an invalid source
                # collision, not the legacy synthetic actor class.  Synthetic
                # classes have no canonical class schedule row and stay out of
                # graph metadata entirely.
                if actor_names.contains_key(declaration_name): return false
                class_names.push(declaration_name)
            elif declaration_kind == PARSER_DECL_STRUCT:
                struct_names.push(declaration_name)
            schedule_index = schedule_index + 1
        if (trait_names.len() != owner.value.traits.len() or
            alias_names.len() != owner.value.type_aliases.len() or
            class_names.len() + actor_names.len() != owner.value.classes.len() or
            struct_names.len() != owner.value.structs.len()):
            return false
        var trait_symbols: [i64] = []
        var trait_type_params: [i64] = []
        var trait_where: [i64] = []
        var trait_assoc: [i64] = []
        var trait_methods: [i64] = []
        var impl_type_params: [i64] = []
        var impl_where: [i64] = []
        var impl_assoc: [i64] = []
        var impl_methods: [i64] = []
        var alias_symbols: [i64] = []
        var alias_type_params: [i64] = []
        var class_symbols: [i64] = []
        var class_type_params: [i64] = []
        var struct_symbols: [i64] = []
        var struct_type_params: [i64] = []

        var i = 0
        while i < trait_names.len():
            val symbol = self.symbols.lookup_or_invalid(trait_names[i])
            if not symbol.is_valid(): return false
            trait_symbols.push(symbol.id)
            trait_type_params.push(-1); trait_where.push(-1)
            trait_assoc.push(-1); trait_methods.push(-1)
            i = i + 1
        i = 0
        while i < owner.value.impls.len():
            impl_type_params.push(-1); impl_where.push(-1)
            impl_assoc.push(-1); impl_methods.push(-1)
            i = i + 1
        i = 0
        while i < alias_names.len():
            val symbol = self.symbols.lookup_or_invalid(alias_names[i])
            if not symbol.is_valid(): return false
            alias_symbols.push(symbol.id); alias_type_params.push(-1)
            i = i + 1
        i=0
        while i<class_names.len():
            val symbol=self.symbols.lookup_or_invalid(class_names[i])
            if not symbol.is_valid(): return false
            class_symbols.push(symbol.id); class_type_params.push(-1); i=i+1
        i=0
        while i<struct_names.len():
            val symbol=self.symbols.lookup_or_invalid(struct_names[i])
            if not symbol.is_valid(): return false
            struct_symbols.push(symbol.id); struct_type_params.push(-1); i=i+1

        # Type parameters are one homogeneous module segment.  Each owner also
        # receives its own generation-bound exact child-range receipt.
        var kind_start = self.destination_metadata_count()
        i = 0
        while i < trait_names.len():
            val source = owner.value.traits[trait_names[i]]
            val child_start = self.destination_metadata_count()
            var j = 0
            while j < source.type_params.len():
                val parameter = source.type_params[j]
                val bounds = self.destination_type_range(parameter.bounds)
                var default_type = -1
                if parameter.has_default: default_type = self.destination_lower_type(parameter.default)
                val span = self.destination_metadata_span(parameter.span)
                if ((parameter.bounds.len() > 0 and bounds < 0) or
                    (parameter.bounds.len() == 0 and bounds != -1) or span < 0 or
                    (parameter.has_default and default_type < 0) or
                    self.destination_metadata_append(HDDM_TYPE_PARAM,
                        module_index, trait_symbols[i], parameter.name, "", "",
                        parameter.has_default, false, false, bounds,
                        default_type, -1, -1, -1, -1, span) < 0):
                    return false
                j = j + 1
            trait_type_params[i] = self.destination_metadata_child_range(HDDM_TYPE_PARAM, child_start, self.destination_metadata_count() - child_start)
            if trait_type_params[i] < 0: return false
            i = i + 1
        i = 0
        while i < owner.value.impls.len():
            val source = owner.value.impls[i]
            val impl_owner = self.destination_metadata_named_owner(source.type_.kind)
            if impl_owner < 0: return false
            val child_start = self.destination_metadata_count()
            var j = 0
            while j < source.type_params.len():
                val parameter = source.type_params[j]
                val bounds = self.destination_type_range(parameter.bounds)
                var default_type = -1
                if parameter.has_default: default_type = self.destination_lower_type(parameter.default)
                val span = self.destination_metadata_span(parameter.span)
                if ((parameter.bounds.len() > 0 and bounds < 0) or
                    (parameter.bounds.len() == 0 and bounds != -1) or span < 0 or
                    (parameter.has_default and default_type < 0) or
                    self.destination_metadata_append(HDDM_TYPE_PARAM,
                        module_index, impl_owner, parameter.name, "", "",
                        parameter.has_default, false, false, bounds,
                        default_type, -1, -1, -1, -1, span) < 0):
                    return false
                j = j + 1
            impl_type_params[i] = self.destination_metadata_child_range(HDDM_TYPE_PARAM, child_start, self.destination_metadata_count() - child_start)
            if impl_type_params[i] < 0: return false
            i = i + 1
        i = 0
        while i < alias_names.len():
            val source = owner.value.type_aliases[alias_names[i]]
            val child_start = self.destination_metadata_count()
            var j = 0
            while j < source.type_params.len():
                val parameter = source.type_params[j]
                val bounds = self.destination_type_range(parameter.bounds)
                var default_type = -1
                if parameter.has_default: default_type = self.destination_lower_type(parameter.default)
                val span = self.destination_metadata_span(parameter.span)
                if ((parameter.bounds.len() > 0 and bounds < 0) or
                    (parameter.bounds.len() == 0 and bounds != -1) or span < 0 or
                    (parameter.has_default and default_type < 0) or
                    self.destination_metadata_append(HDDM_TYPE_PARAM,
                        module_index, alias_symbols[i], parameter.name, "", "",
                        parameter.has_default, false, false, bounds,
                        default_type, -1, -1, -1, -1, span) < 0):
                    return false
                j = j + 1
            alias_type_params[i] = self.destination_metadata_child_range(HDDM_TYPE_PARAM, child_start, self.destination_metadata_count() - child_start)
            if alias_type_params[i] < 0: return false
            i = i + 1
        i=0
        while i<class_names.len():
            class_type_params[i]=self.destination_metadata_nominal_type_params(
                module_index,class_symbols[i],owner.value.classes[class_names[i]].type_params)
            if class_type_params[i]<0: return false
            i=i+1
        i=0
        while i<struct_names.len():
            struct_type_params[i]=self.destination_metadata_nominal_type_params(
                module_index,struct_symbols[i],owner.value.structs[struct_names[i]].type_params)
            if struct_type_params[i]<0: return false
            i=i+1
        if self.destination_metadata_module_range(module_index, HDDM_TYPE_PARAM,
                kind_start, self.destination_metadata_count() - kind_start) < 0:
            return false

        kind_start = self.destination_metadata_count()
        i = 0
        while i < trait_names.len():
            val source = owner.value.traits[trait_names[i]]
            val child_start = self.destination_metadata_count()
            var j = 0
            while j < source.where_clause.len():
                val bound = source.where_clause[j]
                val trait_type = self.destination_lower_type(bound.trait_)
                val span = self.destination_metadata_span(bound.span)
                if (trait_type < 0 or span < 0 or
                    self.destination_metadata_append(HDDM_TRAIT_BOUND,
                        module_index, trait_symbols[i], bound.type_param, "", "",
                        false, false, false, trait_type, -1, -1, -1, -1,
                        -1, span) < 0):
                    return false
                j = j + 1
            trait_where[i] = self.destination_metadata_child_range(HDDM_TRAIT_BOUND, child_start, self.destination_metadata_count() - child_start)
            if trait_where[i] < 0: return false
            i = i + 1
        i = 0
        while i < owner.value.impls.len():
            val source = owner.value.impls[i]
            val impl_owner = self.destination_metadata_named_owner(source.type_.kind)
            val child_start = self.destination_metadata_count()
            var j = 0
            while j < source.where_clause.len():
                val bound = source.where_clause[j]
                val trait_type = self.destination_lower_type(bound.trait_)
                val span = self.destination_metadata_span(bound.span)
                if (impl_owner < 0 or trait_type < 0 or span < 0 or
                    self.destination_metadata_append(HDDM_TRAIT_BOUND,
                        module_index, impl_owner, bound.type_param, "", "",
                        false, false, false, trait_type, -1, -1, -1, -1,
                        -1, span) < 0):
                    return false
                j = j + 1
            impl_where[i] = self.destination_metadata_child_range(HDDM_TRAIT_BOUND, child_start, self.destination_metadata_count() - child_start)
            if impl_where[i] < 0: return false
            i = i + 1
        if self.destination_metadata_module_range(module_index, HDDM_TRAIT_BOUND,
                kind_start, self.destination_metadata_count() - kind_start) < 0:
            return false

        kind_start = self.destination_metadata_count()
        i = 0
        while i < trait_names.len():
            val source = owner.value.traits[trait_names[i]]
            val child_start = self.destination_metadata_count()
            var j = 0
            while j < source.assoc_types.len():
                val assoc = source.assoc_types[j]
                val bounds = self.destination_type_range(assoc.bounds)
                var default_type = -1
                if assoc.has_default: default_type = self.destination_lower_type(assoc.default)
                val span = self.destination_metadata_span(assoc.span)
                if ((assoc.bounds.len() > 0 and bounds < 0) or
                    (assoc.bounds.len() == 0 and bounds != -1) or span < 0 or
                    (assoc.has_default and default_type < 0) or
                    self.destination_metadata_append(HDDM_ASSOC_DECL,
                        module_index, trait_symbols[i], assoc.name, "", "",
                        assoc.has_default, false, false, bounds, default_type,
                        -1, -1, -1, -1, span) < 0):
                    return false
                j = j + 1
            trait_assoc[i] = self.destination_metadata_child_range(HDDM_ASSOC_DECL, child_start, self.destination_metadata_count() - child_start)
            if trait_assoc[i] < 0: return false
            i = i + 1
        if self.destination_metadata_module_range(module_index, HDDM_ASSOC_DECL,
                kind_start, self.destination_metadata_count() - kind_start) < 0:
            return false

        kind_start = self.destination_metadata_count()
        i = 0
        while i < owner.value.impls.len():
            val source = owner.value.impls[i]
            val impl_owner = self.destination_metadata_named_owner(source.type_.kind)
            val child_start = self.destination_metadata_count()
            var j = 0
            while j < source.assoc_types.len():
                val assoc = source.assoc_types[j]
                val bounds = self.destination_type_range(assoc.bounds)
                var default_type = -1
                if assoc.has_default: default_type = self.destination_lower_type(assoc.default)
                val span = self.destination_metadata_span(assoc.span)
                if (impl_owner < 0 or
                    (assoc.bounds.len() > 0 and bounds < 0) or
                    (assoc.bounds.len() == 0 and bounds != -1) or span < 0 or
                    (assoc.has_default and default_type < 0) or
                    self.destination_metadata_append(HDDM_ASSOC_IMPL,
                        module_index, impl_owner, assoc.name, "", "",
                        assoc.has_default, false, false, bounds, default_type,
                        -1, -1, -1, -1, span) < 0):
                    return false
                j = j + 1
            impl_assoc[i] = self.destination_metadata_child_range(HDDM_ASSOC_IMPL, child_start, self.destination_metadata_count() - child_start)
            if impl_assoc[i] < 0: return false
            i = i + 1
        if self.destination_metadata_module_range(module_index, HDDM_ASSOC_IMPL,
                kind_start, self.destination_metadata_count() - kind_start) < 0:
            return false

        kind_start = self.destination_metadata_count()
        if kind_start < 0: return false
        val parent_count = trait_names.len() + owner.value.impls.len()
        var method_counts: [i64] = []
        var method_offsets: [i64] = []
        var method_cursors: [i64] = []
        var method_order: [i64] = []
        i = 0
        while i < parent_count:
            method_counts.push(0); method_offsets.push(0)
            method_cursors.push(0)
            i = i + 1
        i = 0
        while i < method_count:
            if (method_parent_kind[i] != 1 and method_parent_kind[i] != 2):
                return false
            val limit = if method_parent_kind[i] == 1:
                trait_names.len()
            else:
                owner.value.impls.len()
            if method_parent_index[i] < 0 or method_parent_index[i] >= limit:
                return false
            val key = if method_parent_kind[i] == 1:
                method_parent_index[i]
            else:
                trait_names.len() + method_parent_index[i]
            method_counts[key] = method_counts[key] + 1
            method_order.push(-1)
            i = i + 1
        var running = 0
        i = 0
        while i < parent_count:
            method_offsets[i] = running; method_cursors[i] = running
            running = running + method_counts[i]
            i = i + 1
        i = 0
        while i < method_count:
            val key = if method_parent_kind[i] == 1:
                method_parent_index[i]
            else:
                trait_names.len() + method_parent_index[i]
            method_order[method_cursors[key]] = i
            method_cursors[key] = method_cursors[key] + 1
            i = i + 1
        var previous_key = -1
        var child_start = self.destination_metadata_count()
        i = 0
        while i <= method_count:
            val receipt_index = if i < method_count: method_order[i] else: -1
            val key = if receipt_index >= 0:
                if method_parent_kind[receipt_index] == 1:
                    method_parent_index[receipt_index]
                else:
                    trait_names.len() + method_parent_index[receipt_index]
            else:
                -2
            if i > 0 and key != previous_key:
                val range = self.destination_metadata_child_range(HDDM_FUNCTION_REF, child_start, self.destination_metadata_count() - child_start)
                if range < 0: return false
                if previous_key < trait_names.len(): trait_methods[previous_key] = range
                else: impl_methods[previous_key - trait_names.len()] = range
                child_start = self.destination_metadata_count()
            if i == method_count: break
            if (key < previous_key or method_owner[receipt_index] < 0 or
                method_name[receipt_index] == "" or
                method_row[receipt_index] < 0 or method_token[receipt_index] < 0 or
                method_root[receipt_index] < 0 or
                method_params[receipt_index] < 0 or
                method_return_type[receipt_index] < 0 or
                method_span[receipt_index] < 0 or
                self.destination_metadata_append(HDDM_FUNCTION_REF,
                    module_index, method_owner[receipt_index],
                    method_name[receipt_index], "", "", true,
                    method_is_static[receipt_index], false,
                    method_row[receipt_index], method_token[receipt_index],
                    method_root[receipt_index], method_params[receipt_index],
                    method_return_type[receipt_index], -1,
                    method_span[receipt_index]) < 0):
                return false
            previous_key = key
            i = i + 1
        i = 0
        while i < trait_methods.len():
            if trait_methods[i] < 0:
                trait_methods[i] = self.destination_metadata_child_range(HDDM_FUNCTION_REF, self.destination_metadata_count(), 0)
            i = i + 1
        i = 0
        while i < impl_methods.len():
            if impl_methods[i] < 0:
                impl_methods[i] = self.destination_metadata_child_range(HDDM_FUNCTION_REF, self.destination_metadata_count(), 0)
            i = i + 1
        if self.destination_metadata_module_range(module_index, HDDM_FUNCTION_REF,
                kind_start, self.destination_metadata_count() - kind_start) < 0:
            return false

        kind_start = self.destination_metadata_count()
        i = 0
        while i < trait_names.len():
            val source = owner.value.traits[trait_names[i]]
            val super_traits = self.destination_type_range(source.super_traits)
            val span = self.destination_metadata_span(source.span)
            if ((source.super_traits.len() > 0 and super_traits < 0) or
                (source.super_traits.len() == 0 and super_traits != -1) or
                span < 0 or
                self.destination_metadata_append(HDDM_TRAIT_DECL,
                    module_index, trait_symbols[i], source.name,
                    source.doc_comment, "", source.is_public,
                    source.has_doc_comment, false,
                    destination_visibility_wire(source.visibility),
                    trait_type_params[i], super_traits, trait_where[i],
                    trait_methods[i], trait_assoc[i], span) < 0):
                return false
            i = i + 1
        if self.destination_metadata_module_range(module_index, HDDM_TRAIT_DECL,
                kind_start, self.destination_metadata_count() - kind_start) < 0:
            return false

        kind_start = self.destination_metadata_count()
        i = 0
        while i < owner.value.impls.len():
            val source = owner.value.impls[i]
            val impl_owner = self.destination_metadata_named_owner(source.type_.kind)
            val target_type = self.destination_lower_type(source.type_)
            var trait_type = -1
            if source.has_trait_: trait_type = self.destination_lower_type(source.trait_)
            val span = self.destination_metadata_span(source.span)
            if (impl_owner < 0 or target_type < 0 or span < 0 or
                (source.has_trait_ and trait_type < 0) or
                self.destination_metadata_append(HDDM_TRAIT_IMPL,
                    module_index, impl_owner, "", "", "", source.has_trait_,
                    false, false, target_type, trait_type, impl_type_params[i],
                    impl_where[i], impl_methods[i], impl_assoc[i], span) < 0):
                return false
            i = i + 1
        if self.destination_metadata_module_range(module_index, HDDM_TRAIT_IMPL,
                kind_start, self.destination_metadata_count() - kind_start) < 0:
            return false

        kind_start = self.destination_metadata_count()
        i = 0
        while i < alias_names.len():
            val source = owner.value.type_aliases[alias_names[i]]
            val target_type = self.destination_lower_type(source.type_)
            val span = self.destination_metadata_span(source.span)
            if (target_type < 0 or span < 0 or
                self.destination_metadata_append(HDDM_TYPE_ALIAS,
                    module_index, alias_symbols[i], source.name, "", "",
                    source.is_public, false, false, target_type,
                    alias_type_params[i],
                    destination_visibility_wire(source.visibility), -1, -1,
                    -1, span) < 0):
                return false
            i = i + 1
        if self.destination_metadata_module_range(module_index, HDDM_TYPE_ALIAS,
                kind_start, self.destination_metadata_count() - kind_start) < 0:
            return false

        # Raw nominal attributes retain source spans and expression receipts
        # in one homogeneous segment; owner_symbol is the provenance key.
        kind_start=self.destination_metadata_count()
        i=0
        while i<class_names.len():
            val source=owner.value.classes[class_names[i]]
            var j=0
            while j<source.attributes.len():
                val attribute=source.attributes[j]
                val arguments=self.destination_expr_range(attribute.args)
                val span=self.destination_metadata_span(attribute.span)
                if arguments<0 or span<0 or
                    self.destination_metadata_append(HDDM_NOMINAL_ATTRIBUTE,
                        module_index,class_symbols[i],attribute.name,"","",
                        false,false,false,arguments,attribute.args.len(),-1,-1,
                        -1,-1,span)<0: return false
                j=j+1
            i=i+1
        i=0
        while i<struct_names.len():
            val source=owner.value.structs[struct_names[i]]
            var j=0
            while j<source.attributes.len():
                val attribute=source.attributes[j]
                val arguments=self.destination_expr_range(attribute.args)
                val span=self.destination_metadata_span(attribute.span)
                if arguments<0 or span<0 or
                    self.destination_metadata_append(HDDM_NOMINAL_ATTRIBUTE,
                        module_index,struct_symbols[i],attribute.name,"","",
                        false,false,false,arguments,attribute.args.len(),-1,-1,
                        -1,-1,span)<0: return false
                j=j+1
            i=i+1
        if self.destination_metadata_module_range(module_index,
                HDDM_NOMINAL_ATTRIBUTE,kind_start,
                self.destination_metadata_count()-kind_start)<0: return false

        # Class and struct schema is published after trait impl rows, so the
        # module-level HDDM_TRAIT_IMPL range is already authoritative for
        # base/trait provenance. Simple forbids class inheritance; consumers
        # match those impl rows by owner_symbol without a synthetic base row.
        kind_start = self.destination_metadata_count()
        i = 0
        while i < class_names.len():
            val source = owner.value.classes[class_names[i]]
            val symbol = self.symbols.lookup_or_invalid(source.name)
            if not symbol.is_valid(): return false
            val member_start = hdw_destination_member_range_start(
                self.destination_slot, self.destination_generation,
                module_index, symbol.id)
            val member_count = hdw_destination_member_range_len(
                self.destination_slot, self.destination_generation,
                module_index, symbol.id)
            val exact_member_count = if member_start == -1 and member_count == -1:
                0
            else:
                member_count
            val span = self.destination_metadata_span(source.span)
            var base_type=-1
            if val base=source.base_type:
                base_type=self.destination_lower_type(base)
            val traits=self.destination_type_range(source.implemented_traits)
            if (class_type_params[i] < 0 or exact_member_count < 0 or
                (exact_member_count > 0 and member_start < 0) or
                (source.base_type.? and base_type<0) or
                (source.implemented_traits.len()>0 and traits<0) or
                span < 0 or self.destination_metadata_append(HDDM_CLASS_DECL,
                    module_index, symbol.id, source.name, source.doc_comment,
                    "", source.is_public, source.has_doc_comment,
                    source.type_params.len() > 0,
                    destination_visibility_wire(source.visibility),
                    class_type_params[i], member_start, exact_member_count,
                    base_type, traits,
                    span) < 0):
                return false
            i = i + 1
        if self.destination_metadata_module_range(module_index, HDDM_CLASS_DECL,
                kind_start, self.destination_metadata_count() - kind_start) < 0:
            return false

        kind_start = self.destination_metadata_count()
        i = 0
        while i < struct_names.len():
            val source = owner.value.structs[struct_names[i]]
            val symbol = self.symbols.lookup_or_invalid(source.name)
            if not symbol.is_valid(): return false
            val member_start = hdw_destination_member_range_start(
                self.destination_slot, self.destination_generation,
                module_index, symbol.id)
            val member_count = hdw_destination_member_range_len(
                self.destination_slot, self.destination_generation,
                module_index, symbol.id)
            val exact_member_count = if member_start == -1 and member_count == -1:
                0
            else:
                member_count
            val span = self.destination_metadata_span(source.span)
            var base_type=-1
            if val base=source.base_type:
                base_type=self.destination_lower_type(base)
            val traits=self.destination_type_range(source.implemented_traits)
            if (struct_type_params[i] < 0 or exact_member_count < 0 or
                (exact_member_count > 0 and member_start < 0) or
                (source.base_type.? and base_type<0) or
                (source.implemented_traits.len()>0 and traits<0) or
                span < 0 or self.destination_metadata_append(HDDM_STRUCT_DECL,
                    module_index, symbol.id, source.name, source.doc_comment,
                    "", source.is_public, source.has_doc_comment,
                    source.type_params.len() > 0,
                    destination_visibility_wire(source.visibility),
                    struct_type_params[i], member_start, exact_member_count,
                    base_type, traits,
                    span) < 0):
                return false
            i = i + 1
        if self.destination_metadata_module_range(module_index, HDDM_STRUCT_DECL,
                kind_start, self.destination_metadata_count() - kind_start) < 0:
            return false

        kind_start = self.destination_metadata_count()
        for source in owner.value.domain_blocks:
            val span = self.destination_metadata_span(source.span)
            if span < 0 or self.destination_metadata_append(HDDM_DOMAIN,
                module_index, -1, source.context, source.kind, source.payload,
                false, false, false, -1, -1, -1, -1, -1, -1, span) < 0:
                return false
        if self.destination_metadata_module_range(module_index, HDDM_DOMAIN,
                kind_start, self.destination_metadata_count() - kind_start) < 0:
            return false

        kind_start = self.destination_metadata_count()
        for source in owner.value.static_asserts:
            val condition = self.destination_lower_expr(source.condition)
            val span = self.destination_metadata_span(source.span)
            if condition < 0 or span < 0 or
                self.destination_metadata_append(HDDM_STATIC_ASSERT,
                    module_index, -1, "", source.message, "",
                    source.has_message, false, false, condition, -1, -1, -1,
                    -1, -1, span) < 0:
                return false
        if self.destination_metadata_module_range(module_index, HDDM_STATIC_ASSERT,
                kind_start, self.destination_metadata_count() - kind_start) < 0:
            return false

        kind_start = self.destination_metadata_count()
        for source in owner.value.aop_advices:
            val span = self.destination_metadata_span(source.span)
            if span < 0 or self.destination_metadata_append(HDDM_AOP,
                module_index, -1, source.handler, source.pointcut, source.form,
                false, false, false, source.priority, -1, -1, -1, -1, -1,
                span) < 0:
                return false
        if self.destination_metadata_module_range(module_index, HDDM_AOP,
                kind_start, self.destination_metadata_count() - kind_start) < 0:
            return false

        kind_start = self.destination_metadata_count()
        for source in owner.value.di_bindings:
            val span = self.destination_metadata_span(source.span)
            if span < 0 or self.destination_metadata_append(HDDM_DI,
                module_index, -1, "", source.pointcut, source.implementation,
                false, false, false, -1, -1, -1, -1, -1, -1, span) < 0:
                return false
        if self.destination_metadata_module_range(module_index, HDDM_DI,
                kind_start, self.destination_metadata_count() - kind_start) < 0:
            return false

        kind_start = self.destination_metadata_count()
        for source in owner.value.arch_rules:
            val span = self.destination_metadata_span(source.span)
            if span < 0 or self.destination_metadata_append(HDDM_ARCH,
                module_index, -1, source.message, source.kind, source.pointcut,
                false, false, false, -1, -1, -1, -1, -1, -1, span) < 0:
                return false
        if self.destination_metadata_module_range(module_index, HDDM_ARCH,
                kind_start, self.destination_metadata_count() - kind_start) < 0:
            return false

        kind_start = self.destination_metadata_count()
        for source in owner.value.mock_decls:
            val target = self.symbols.lookup_or_invalid(source.trait_name)
            val has_target = target.is_valid()
            val target_id = if has_target: target.id else: -1
            val span = self.destination_metadata_span(source.span)
            if span < 0 or self.destination_metadata_append(HDDM_MOCK,
                module_index, -1, source.name, source.trait_name, "",
                has_target, false, false, target_id, -1, -1, -1, -1, -1,
                span) < 0:
                return false
        if self.destination_metadata_module_range(module_index, HDDM_MOCK,
                kind_start, self.destination_metadata_count() - kind_start) < 0:
            return false

        # This parser shape has no standalone type-binding declarations.
        if self.destination_metadata_module_range(module_index, HDDM_TYPE_BINDING,
                self.destination_metadata_count(), 0) < 0:
            return false
        true

export HirLowering
