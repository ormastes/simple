# Direct declaration publication for parser-owned shapes which have no legacy
# aggregate on the graph route.  All retained values are scalar destination
# receipts; parser values remain scoped to this producer call.
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.hir_destination_declarations.{
    HD_DECL_ACTOR, HD_DECL_BITFIELD, HD_DECL_CONSTANT, HD_DECL_ENUM,
    HD_ENUM_PAYLOAD_NONE, HD_ENUM_PAYLOAD_TUPLE, HD_ENUM_PAYLOAD_STRUCT
}
use compiler.hir.hir_lowering.hir_destination_registry_writer.*
use compiler.hir.hir_lowering._Expressions.destination_types_patterns.*
use compiler.frontend.parser_types.*
use compiler.frontend.parser_types_expr.{ExprKind, TypeKind}
use compiler.common.dependency.visibility.{Visibility}
use compiler.common.dynamic_identity.closure.{Closure}
use compiler.common.attributes.{parse_layout_attrs}
use compiler.hir.hir_types.{SymbolKind, ScopeKind}
use compiler.common.diagnostics.span.{Span}

impl HirLowering:
    fn destination_declaration_visibility(value: Visibility) -> i64:
        match value:
            case Visibility.Public: 0
            case Visibility.Peer: 1
            case Visibility.Up: 2
            case Visibility.Internal: 3
            case Visibility.Package: 4
            case Visibility.Private: 5

    me destination_declaration_span(value: Span) -> i64:
        hdw_reserve_span(self.destination_slot, self.destination_generation,
            value.start, value.end, value.line, value.col, value.file, value.length)

    me destination_publish_type_params_direct(values: [ParserTypeParam]) -> bool:
        var index = 0
        while index < values.len():
            val value = values[index]
            var bound_row = -1
            if value.bounds.len() > 0:
                bound_row = self.destination_lower_type(value.bounds[0])
                if bound_row < 0: return false
            var default_row = -1
            if value.has_default:
                default_row = self.destination_lower_type(value.default)
                if default_row < 0: return false
            val span_row = self.destination_declaration_span(value.span)
            val type_param_row = if span_row >= 0:
                hdw_decl_type_param(self.destination_slot,
                    self.destination_generation, value.name, bound_row,
                    value.has_default, default_row, span_row)
            else:
                -1
            if type_param_row < 0: return false
            # append_type_param retains the first bound for compatibility;
            # append only the remaining ordered children here.
            var bound_index = 1
            while bound_index < value.bounds.len():
                val child_bound_row = self.destination_lower_type(value.bounds[bound_index])
                if (child_bound_row < 0 or
                    hdw_decl_type_param_bound(self.destination_slot,
                        self.destination_generation, type_param_row,
                        child_bound_row) < 0):
                    return false
                bound_index = bound_index + 1
            index = index + 1
        true

    me destination_publish_raw_enum_decorator_direct(raw: text, span: Span) -> bool:
        val span_row = self.destination_declaration_span(span)
        span_row >= 0 and hdw_decl_raw_attribute(self.destination_slot,
            self.destination_generation, raw, "", span_row) >= 0

    # ActorDef is the typed producer authority. actor_order supplies its exact
    # source schedule; the legacy synthetic ParserClass is never graph input.
    me destination_publish_actor_direct(source: ActorDef) -> bool:
        val symbol = self.symbols.lookup_or_invalid(source.name)
        if not symbol.is_valid(): return false
        val visibility = self.compute_visibility(source.name, source.visibility)
        val span_row = self.destination_declaration_span(source.span)
        if (span_row < 0 or not self.destination_publish_nominal_declaration(
                symbol.id, source.name, SymbolKind.Class, visibility, source.span)):
            return false
        if hdw_decl_reserve(self.destination_slot, self.destination_generation,
                HD_DECL_ACTOR, self.current_destination_module_index, symbol.id,
                source.name, self.destination_declaration_visibility(visibility),
                span_row) < 0:
            return false
        if not hdw_decl_surface(self.destination_slot, self.destination_generation,
                visibility == Visibility.Public, source.has_doc_comment,
                if source.has_doc_comment: source.doc_comment else: ""):
            return false
        if not self.destination_publish_type_params_direct(source.type_params):
            return false
        var index = 0
        while index < source.attributes.len():
            val attribute = source.attributes[index]
            if source.attribute_raw_spellings.len() != source.attributes.len():
                return false
            val attribute_span = self.destination_declaration_span(attribute.span)
            val attribute_row = if attribute_span >= 0:
                hdw_decl_raw_attribute(
                    self.destination_slot, self.destination_generation,
                    attribute.name, source.attribute_raw_spellings[index],
                    attribute_span)
            else:
                -1
            if attribute_row < 0:
                return false
            var argument_index = 0
            while argument_index < attribute.args.len():
                val expression_row = self.destination_lower_expr(
                    attribute.args[argument_index])
                if (expression_row < 0 or
                    hdw_decl_raw_attribute_expr(self.destination_slot,
                        self.destination_generation, attribute_row,
                        expression_row) < 0):
                    return false
                argument_index = argument_index + 1
            index = index + 1
        self.symbols.push_scope(ScopeKind.Class)
        index = 0
        while index < source.fields.len():
            val field = source.fields[index]
            val type_row = self.destination_lower_type(field.type_)
            var default_row = -1
            if field.has_default:
                default_row = self.destination_lower_expr(field.default)
            val field_symbol = self.symbols.define(field.name, SymbolKind.Field,
                nil, field.span, field.visibility, false, nil)
            val field_span = self.destination_declaration_span(field.span)
            val field_visibility = self.compute_visibility(field.name, field.visibility)
            if (type_row < 0 or (field.has_default and default_row < 0) or
                not field_symbol.is_valid() or field_span < 0 or
                hdw_decl_actor_field_full(self.destination_slot,
                    self.destination_generation, field_symbol.id, field.name,
                    type_row, field.has_default, default_row,
                    self.destination_declaration_visibility(field_visibility),
                    field_visibility == Visibility.Public, field.is_volatile,
                    field.has_bits, if field.has_bits: field.bits else: 0,
                    field.has_fixed_address,
                    if field.has_fixed_address: field.fixed_address else: 0,
                    field_span) < 0):
                self.symbols.pop_scope(); return false
            index = index + 1
        if source.methods.len() != source.ordered_methods.len():
            self.symbols.pop_scope(); return false
        val methods_ok = self.destination_publish_parser_method_list_direct(
            symbol.id, source.ordered_methods, source.type_params.len() > 0)
        self.symbols.pop_scope()
        if not methods_ok: return false
        # The current grammar has no typed message/mailbox scalar. Preserve
        # decorators and typed children without inventing Any/0 semantics.
        hdw_decl_finalize_actor_full(self.destination_slot,
            self.destination_generation, false, -1, false, -1)

    me destination_publish_enum_direct(source: ParserEnum) -> bool:
        val symbol = self.symbols.lookup_or_invalid(source.name)
        if not symbol.is_valid(): return false
        val visibility = self.compute_visibility(source.name, source.visibility)
        val span_row = self.destination_declaration_span(source.span)
        if span_row < 0: return false
        val declaration = hdw_decl_reserve(self.destination_slot,
            self.destination_generation, HD_DECL_ENUM,
            self.current_destination_module_index, symbol.id, source.name,
            self.destination_declaration_visibility(visibility), span_row)
        if declaration < 0: return false
        if not hdw_decl_surface(self.destination_slot, self.destination_generation,
                visibility == Visibility.Public, source.doc_comment != "",
                source.doc_comment):
            return false
        if not self.destination_publish_type_params_direct(source.type_params): return false
        var attr_index = 0
        while attr_index < source.attributes.len():
            if not self.destination_publish_raw_enum_decorator_direct(
                    source.attributes[attr_index], source.span): return false
            attr_index = attr_index + 1

        self.symbols.push_scope(ScopeKind.Class)
        var variant_index = 0
        while variant_index < source.variants.len():
            val variant = source.variants[variant_index]
            val variant_symbol = self.symbols.define(variant.name,
                SymbolKind.EnumVariant, nil, variant.span, Visibility.Public,
                false, nil)
            if not variant_symbol.is_valid(): self.symbols.pop_scope(); return false
            var payload_kind = HD_ENUM_PAYLOAD_NONE
            match variant.kind:
                case VariantKind.Tuple(_): payload_kind = HD_ENUM_PAYLOAD_TUPLE
                case VariantKind.Struct(_): payload_kind = HD_ENUM_PAYLOAD_STRUCT
                case VariantKind.Unit: ()
            var discriminant_row = -1
            if variant.has_discriminant:
                discriminant_row = self.destination_lower_expr(variant.discriminant)
                if discriminant_row < 0: self.symbols.pop_scope(); return false
            val variant_span = self.destination_declaration_span(variant.span)
            val variant_row = if variant_span >= 0:
                hdw_decl_enum_variant(self.destination_slot,
                    self.destination_generation, variant_symbol.id, variant.name,
                    payload_kind, variant.has_discriminant, discriminant_row,
                    variant_span)
            else:
                -1
            if variant_row < 0: self.symbols.pop_scope(); return false
            match variant.kind:
                case VariantKind.Tuple(types):
                    var payload_index = 0
                    while payload_index < types.len():
                        val type_row = self.destination_lower_type(types[payload_index])
                        val payload_span = self.destination_declaration_span(types[payload_index].span)
                        if (type_row < 0 or payload_span < 0 or
                            hdw_decl_enum_payload(self.destination_slot,
                                self.destination_generation, variant_row, "",
                                type_row, payload_span) < 0):
                            self.symbols.pop_scope(); return false
                        payload_index = payload_index + 1
                case VariantKind.Struct(fields):
                    var payload_index = 0
                    while payload_index < fields.len():
                        val field = fields[payload_index]
                        val type_row = self.destination_lower_type(field.type_)
                        val payload_span = self.destination_declaration_span(field.span)
                        if (type_row < 0 or payload_span < 0 or
                            hdw_decl_enum_payload(self.destination_slot,
                                self.destination_generation, variant_row,
                                field.name, type_row, payload_span) < 0):
                            self.symbols.pop_scope(); return false
                        payload_index = payload_index + 1
                case VariantKind.Unit: ()
            variant_index = variant_index + 1
        self.symbols.pop_scope()
        hdw_decl_finalize_enum(self.destination_slot,
            self.destination_generation, source.complete_open, source.dyn_open)

    me destination_publish_bitfield_direct(source: Bitfield) -> bool:
        val symbol = self.symbols.lookup_or_invalid(source.name)
        if not symbol.is_valid(): return false
        val storage_type = self.destination_lower_type(source.backing_type)
        val total_width = self.infer_bit_width(Some(source.backing_type))
        val span_row = self.destination_declaration_span(source.span)
        val visibility = self.compute_visibility(source.name, source.visibility)
        if storage_type < 0 or total_width <= 0 or span_row < 0: return false
        if not self.destination_publish_nominal_declaration(symbol.id,
                source.name, SymbolKind.Struct, visibility, source.span):
            return false
        if hdw_decl_reserve(self.destination_slot, self.destination_generation,
                HD_DECL_BITFIELD, self.current_destination_module_index,
                symbol.id, source.name,
                self.destination_declaration_visibility(visibility), span_row) < 0:
            return false
        if not hdw_decl_surface(self.destination_slot, self.destination_generation,
                visibility == Visibility.Public, source.doc_comment != "",
                source.doc_comment):
            return false
        var attribute_index = 0
        while attribute_index < source.attributes.len():
            val attribute = source.attributes[attribute_index]
            val attribute_span = self.destination_declaration_span(attribute.span)
            val attribute_row = if attribute_span >= 0:
                hdw_decl_raw_attribute(self.destination_slot,
                    self.destination_generation, attribute.name, "",
                    attribute_span)
            else:
                -1
            if attribute_row < 0:
                return false
            var argument_index = 0
            while argument_index < attribute.args.len():
                val expression_row = self.destination_lower_expr(
                    attribute.args[argument_index])
                if (expression_row < 0 or
                    hdw_decl_raw_attribute_expr(self.destination_slot,
                        self.destination_generation, attribute_row,
                        expression_row) < 0):
                    return false
                argument_index = argument_index + 1
            attribute_index = attribute_index + 1

        val layout = parse_layout_attrs(source.attributes)
        var widths: [i64] = []
        var order: [i64] = []
        var index = 0
        while index < source.fields.len():
            val field = source.fields[index]
            val width = if field.has_bits: field.bits else: self.infer_bit_width(
                if field.has_type_: Some(field.type_) else: nil)
            if width <= 0: return false
            widths.push(width); order.push(index); index = index + 1
        if not layout.is_preserve_order:
            # Stable bottom-up merge sort preserves source order for equal
            # widths and avoids the legacy insertion sort's O(field_count^2)
            # behavior.  One reusable index buffer is the only added storage.
            var scratch: [i64] = []
            index = 0
            while index < order.len(): scratch.push(0); index = index + 1
            var run = 1
            while run < order.len():
                var start = 0
                while start < order.len():
                    val middle = if start + run < order.len(): start + run else: order.len()
                    val stop = if start + run + run < order.len(): start + run + run else: order.len()
                    var left = start
                    var right = middle
                    var output = start
                    while output < stop:
                        if (right >= stop or (left < middle and
                            widths[order[left]] >= widths[order[right]])):
                            scratch[output] = order[left]; left = left + 1
                        else:
                            scratch[output] = order[right]; right = right + 1
                        output = output + 1
                    start = stop
                index = 0
                while index < order.len():
                    order[index] = scratch[index]; index = index + 1
                run = run * 2
        var offset = 0
        index = 0
        while index < order.len():
            val source_index = order[index]
            val field = source.fields[source_index]
            val width = widths[source_index]
            if not layout.is_compactq and width < 32:
                val word_end = ((offset / 32) + 1) * 32
                if offset + width > word_end: offset = word_end
            var type_row = -1
            if field.has_type_:
                type_row = self.destination_lower_type(field.type_)
                if type_row < 0: return false
            val field_symbol = self.symbols.define(field.name, SymbolKind.Field,
                nil, field.span, Visibility.Private, false, nil)
            val field_span = self.destination_declaration_span(field.span)
            if (not field_symbol.is_valid() or field_span < 0 or
                hdw_decl_bitfield_field_full(self.destination_slot,
                    self.destination_generation, field_symbol.id, field.name,
                    field.has_type_, type_row, field.is_reserved, field.has_bits,
                    if field.has_bits: field.bits else: 0, offset, width,
                    field_span) < 0):
                return false
            offset = offset + width; index = index + 1
        if offset > total_width: return false
        hdw_decl_finalize_bitfield(self.destination_slot,
            self.destination_generation, storage_type, total_width)

    me destination_publish_constant_direct(source: ParserConst) -> bool:
        val symbol = self.symbols.lookup_or_invalid(source.name)
        if not symbol.is_valid(): return false
        val span_row = self.destination_declaration_span(source.span)
        val visibility = self.compute_visibility(source.name, source.visibility)
        if span_row < 0 or hdw_decl_reserve(self.destination_slot,
                self.destination_generation, HD_DECL_CONSTANT,
                self.current_destination_module_index, symbol.id, source.name,
                self.destination_declaration_visibility(visibility), span_row) < 0:
            return false
        if not hdw_decl_surface(self.destination_slot, self.destination_generation,
                visibility == Visibility.Public, false, ""): return false
        var type_row = -1
        if source.has_type_:
            type_row = self.destination_lower_type(source.type_)
            if type_row < 0: return false
        val value_row = self.destination_lower_expr(source.value)
        if value_row < 0: return false
        hdw_decl_finalize_constant_full(self.destination_slot,
            self.destination_generation, source.has_type_, type_row, value_row,
            source.is_mutable, source.is_volatile, source.has_fixed_address,
            if source.has_fixed_address: source.fixed_address else: 0)

    fn destination_extension_closure_name(value: Closure) -> text:
        match value:
            case Closure.Static: ""
            case Closure.Complete: "complete"
            case Closure.Dyn: "dyn"

    me destination_publish_enum_extension_direct(
        source: ParserExtendEnum, source_ordinal: i64
    ) -> bool:
        val span_row = self.destination_declaration_span(source.span)
        val closure = self.destination_extension_closure_name(source.closure)
        if span_row < 0 or closure == "": return false
        val exact_source_ordinal = if source.source_ordinal >= 0:
            source.source_ordinal
        else:
            source_ordinal
        if hdw_decl_extension_reserve_full(self.destination_slot,
                self.destination_generation, self.current_destination_module_index,
                source.target, closure, exact_source_ordinal, span_row) < 0:
            return false
        var attribute_index = 0
        while attribute_index < source.attributes.len():
            val attribute = source.attributes[attribute_index]
            val attribute_span = self.destination_declaration_span(attribute.span)
            val raw_args = if attribute_index < source.attribute_raw_args.len():
                source.attribute_raw_args[attribute_index]
            else:
                ""
            val attribute_row = if attribute_span >= 0:
                hdw_decl_raw_attribute(self.destination_slot,
                    self.destination_generation, attribute.name, raw_args,
                    attribute_span)
            else:
                -1
            if attribute_row < 0: return false
            var argument_index = 0
            while argument_index < attribute.args.len():
                val expression_row = self.destination_lower_expr(
                    attribute.args[argument_index])
                if (expression_row < 0 or
                    hdw_decl_raw_attribute_expr(self.destination_slot,
                        self.destination_generation, attribute_row,
                        expression_row) < 0):
                    return false
                argument_index = argument_index + 1
            attribute_index = attribute_index + 1
        var index = 0
        while index < source.constructors.len():
            val constructor = source.constructors[index]
            val constructor_span = self.destination_declaration_span(constructor.span)
            var discriminant_row = -1
            if constructor.has_discriminant:
                discriminant_row = self.destination_lower_expr(constructor.discriminant)
                if discriminant_row < 0: return false
            if constructor_span < 0: return false
            val constructor_row = hdw_decl_enum_constructor_full(
                self.destination_slot, self.destination_generation,
                constructor.provider, constructor.name, constructor.payload_kind,
                constructor.has_discriminant, discriminant_row, constructor_span)
            if constructor_row < 0: return false
            if constructor.payload_names.len() != constructor.payload_types.len():
                return false
            var payload_index = 0
            while payload_index < constructor.payload_types.len():
                val payload = constructor.payload_types[payload_index]
                val type_row = self.destination_lower_type(payload)
                val payload_span = self.destination_declaration_span(payload.span)
                val payload_name = if constructor.payload_kind == HD_ENUM_PAYLOAD_STRUCT:
                    constructor.payload_names[payload_index]
                else:
                    ""
                if (type_row < 0 or payload_span < 0 or
                    hdw_decl_enum_constructor_payload(self.destination_slot,
                        self.destination_generation, constructor_row, payload_name, type_row,
                        payload_span) < 0):
                    return false
                payload_index = payload_index + 1
            index = index + 1
        hdw_decl_finalize_extension(self.destination_slot,
            self.destination_generation)

export HirLowering
