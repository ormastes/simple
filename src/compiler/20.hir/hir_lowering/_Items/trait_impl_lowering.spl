# HIR item lowering - trait, impl, assoc-type, const, and AOP/DI/arch/mock lowering.
# HIR Lowering - Item Lowering
#
# This module handles lowering of top-level items (functions, classes, structs, enums, traits, impls) from AST to HIR.

use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.frontend.parser_types.*
use compiler.frontend.parser_types.{ParserFunction, ImportItem, Param}
use compiler.frontend.flat_ast_bridge.{flat_bootstrap_function_count, flat_bootstrap_function_at, flat_bootstrap_function_decl_at}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.type_equality.{hir_types_equal}
use compiler.hir.hir_lowering.context_helpers.*
use compiler.hir.hir_lowering.expressions.*
use compiler.common.attributes.{parse_layout_attrs, parse_function_attrs, parse_export_attrs, parse_driver_manifest_attrs, parse_platform_attrs, parse_vhdl_hardware_attrs, vhdl_hardware_metadata_default, FunctionAttr, ExportAttr, DriverManifestAttr, DriverManifestAttrKind, VhdlHardwareMetadata}
use compiler.types.type_layout.{LayoutAttr, TypeLayoutKind, PlatformParseResult, PlatformDiagnosticLevel, PlatformLayoutDiagnostic}
use compiler.common.dependency.visibility.{Visibility}
use compiler.core.ast.{decl_get_body, decl_get_name, decl_get_param_names, decl_get_param_types, decl_get_ret_type}
use compiler.core.ast_stmt.{STMT_EXPR, STMT_VAL_DECL, STMT_VAR_DECL, STMT_RETURN, stmt_get_tag, stmt_get_expr, stmt_get_name, stmt_get_type}
use compiler.core.ast_expr.{EXPR_INT_LIT, EXPR_STRING_LIT, EXPR_BOOL_LIT, EXPR_NIL_LIT, EXPR_IDENT, EXPR_BINARY, EXPR_CALL, EXPR_FIELD_ACCESS, EXPR_METHOD_CALL, EXPR_BLOCK, EXPR_RETURN, expr_get_tag, expr_get_int, expr_get_str, expr_get_left, expr_get_right, expr_get_args, expr_get_stmts}
use compiler.core.tokens.{TOK_MINUS, TOK_STAR, TOK_SLASH, TOK_PERCENT, TOK_EQ, TOK_NOT_EQ, TOK_LT, TOK_LT_EQ, TOK_GT, TOK_GT_EQ}
use compiler.frontend.core.types.{TYPE_VOID, TYPE_BOOL, TYPE_I64, TYPE_TEXT, custom_primitive_bind_symbol, custom_primitive_is_name}
use compiler.frontend.core.types.{primitive_integer_bit_width_from_name, custom_primitive_integer_bit_width_by_name}
use compiler.core.types.{int_to_str}
use std.nogc_sync_mut.io.process_ops.{eprint}

impl HirLowering:
    me concrete_default_method_type(default_fn: HirFunction, impl_type: HirType) -> HirType?:
        if val default_symbol = self.symbols.get_symbol(default_fn.symbol):
            if val symbol_type = default_symbol.type_:
                if not default_fn.is_static:
                    match symbol_type.kind:
                        case Function(default_params, default_return, default_effects):
                            if default_params.len() > 0:
                                var concrete_params: [HirType] = [impl_type]
                                var index = 1
                                while index < default_params.len():
                                    concrete_params.push(default_params[index])
                                    index = index + 1
                                return HirType(
                                    kind: HirTypeKind.Function(concrete_params, default_return, default_effects),
                                    span: default_fn.span
                                )
                        case _: ()
                return symbol_type
        nil

    me lower_bitfield_field(f: BitfieldField, offset: i64) -> HirBitfieldField:
        val symbol = self.symbols.define(f.name, SymbolKind.Field, nil, f.span, Visibility.Private, false, nil)

        # Determine bit width:
        # 1. Explicit @bits(N) takes precedence
        # 2. For reserved fields, use explicit bits
        # 3. For typed fields, infer from type
        val bit_width = if f.bits.?:
            f.bits.unwrap()
        elif f.is_reserved:
            0  # Reserved without explicit bits = 0
        else:
            # Infer from type (use default primitive widths)
            self.infer_bit_width(f.type_)

        # `HirBitfieldField.type_` is a DESUGARED optional slot (has_type_/
        # type_ pair). Declare `ftype` with its type annotation on the SAME
        # line as the `nil` literal (rather than a ternary whose `else`
        # branch is a bare `nil`) so the seed's local inference sees the
        # real `HirType?` union from the point of declaration, matching the
        # `HirSymbol.type_: HirType?` precedent used elsewhere in this file.
        var ftype: HirType? = nil
        if f.type_.?:
            ftype = self.lower_type(f.type_)
        HirBitfieldField(
            symbol: symbol,
            name: f.name,
            type_: ftype,
            bit_width: bit_width,
            bit_offset: offset,
            is_reserved: f.is_reserved,
            span: f.span
        )

    fn infer_bit_width(type_: Type?) -> i64:
        # Unwrap via `if val` (the plan's Nil-subclass idiom) rather than a
        # `.?` pre-check plus `.unwrap()` -- the bare `.unwrap()` result was
        # an untyped receiver feeding `.kind` below.
        if val t = type_:
            match t.kind:
                case Named(name, _):
                    if name == "bool":
                        return 1
                    val primitive_bits = primitive_integer_bit_width_from_name(name)
                    if primitive_bits > 0:
                        return primitive_bits
                    custom_primitive_integer_bit_width_by_name(name)
                case _: 0  # Complex types require explicit @bits
        else:
            0

    me lower_trait(trait_: ParserTrait) -> HirTrait:
        val symbol = self.symbols.lookup_or_invalid(trait_.name)

        self.symbols.push_scope(ScopeKind.Class)

        var type_params: [HirTypeParam] = []
        for tp in trait_.type_params:
            type_params = type_params.push(self.lower_type_param(tp))

        # Lower supertraits
        var supertraits: [HirType] = []
        for st in trait_.super_traits:
            supertraits = supertraits.push(self.lower_type(st))

        # Lower where clause
        var where_clause: [HirTraitBound] = []
        for bound in trait_.where_clause:
            where_clause = where_clause.push(self.lower_trait_bound(bound))

        # Lower associated type declarations
        var assoc_types: [HirAssocTypeDecl] = []
        for at in trait_.assoc_types:
            assoc_types = assoc_types.push(self.lower_assoc_type_decl(at))

        # Separate methods into abstract (no body) and defaults (with body)
        var abstract_methods: [HirFunction] = []
        var defaults: [HirFunction] = []
        for method in trait_.methods:
            val method_kind = if method.is_static: SymbolKind.Function else: SymbolKind.Method
            val method_type = self.declared_callable_type(method, Some(symbol))
            val method_name = self.symbols.method_symbol_name(symbol, method.name)
            self.symbols.define(method_name, method_kind, method_type, method.span, method.visibility, false, self.module_filename)
        # Trait signatures carry the same explicit receiver slot as concrete
        # methods. Retain its declared owner; dynamic lowering must not infer
        # a receiver or its ABI from the first user argument.
        val previous_method_self_type = self.current_method_self_type
        self.current_method_self_type = Some(HirType(kind: HirTypeKind.Named(symbol, []), span: trait_.span))
        for m in trait_.methods:
            var hir_fn = self.lower_function(m)
            # #158 Phase B: a method of a GENERIC trait is an unmonomorphized
            # template even when the method itself declares no type params.
            # lower_function only sees the method's own type params, so the
            # trait-level ones are folded in here.
            if type_params.len() > 0:
                hir_fn.is_generic_template = true
            # Check if method has a body (default implementation)
            # ParserFunction.body is a Block, check if it has statements
            if m.body.stmts.is_empty():
                abstract_methods = abstract_methods.push(hir_fn)
            else:
                defaults = defaults.push(hir_fn)

        self.current_method_self_type = previous_method_self_type
        self.symbols.pop_scope()

        # Compute effective visibility using filename matching
        val effective_visibility = self.compute_visibility(trait_.name, trait_.visibility)

        val hir_trait = HirTrait(
            symbol: symbol,
            name: trait_.name,
            type_params: type_params,
            methods: abstract_methods,
            supertraits: supertraits,
            defaults: defaults,
            where_clause: where_clause,
            assoc_types: assoc_types,
            visibility: effective_visibility,
            is_public: trait_.is_public,
            doc_comment: trait_.doc_comment,
            span: trait_.span,
            is_generic_template: false,
            specialization_of: nil,
            type_bindings: {}
        )

        # Stash by name so lower_impl (run later in the same lower_module pass)
        # can inject un-overridden default methods into the impl's method table.
        if not self.lowered_traits.contains_key(trait_.name):
            self.lowered_trait_count_value = self.lowered_trait_count_value + 1
        self.lowered_traits[trait_.name] = hir_trait
        hir_trait

    me lower_impl(impl_: Impl) -> HirImpl:
        self.symbols.push_scope(ScopeKind.Impl)

        # Lower generic type parameters
        var type_params: [HirTypeParam] = []
        for tp in impl_.type_params:
            type_params = type_params.push(self.lower_type_param(tp))

        # Lower where clause
        var where_clause: [HirTraitBound] = []
        for bound in impl_.where_clause:
            where_clause = where_clause.push(self.lower_trait_bound(bound))

        # A module-local impl must retain its local canonical owner even when
        # an earlier import owns the same bare spelling in the lexical scope.
        val impl_owner_name = parser_type_kind_named_name(impl_.type_.kind)
        val local_impl_owner = self.symbols.lookup_qualified_type_raw(
            self.module_filename, impl_owner_name)
        if local_impl_owner >= 0:
            self.symbols.bind_local_type_if_free(impl_owner_name, SymbolId(id: local_impl_owner))
        val lowered_impl_type = self.lower_type(impl_.type_)
        val type_: HirType = if local_impl_owner >= 0:
            # Keep specialization arguments from the parsed/lowered type;
            # only replace its owner identity.
            match lowered_impl_type.kind:
                case HirTypeKind.Named(_, args):
                    HirType(kind: HirTypeKind.Named(
                        SymbolId(id: local_impl_owner), args),
                        span: impl_.type_.span)
                case _:
                    lowered_impl_type
        else:
            lowered_impl_type
        # `HirImpl.trait_` is a DESUGARED optional slot (has_trait_/trait_
        # pair) -- same pattern as `ftype` in `lower_bitfield_field` above.
        # Declare with the type annotation on the same line as the `nil`
        # literal rather than a ternary with a bare `nil` else-branch.
        var trait_: HirType? = nil
        if impl_.has_trait_:
            trait_ = self.lower_type(impl_.trait_)

        # #158 generics sweep: an impl block for a generic struct/class (e.g.
        # methods nested inside `struct Box<T>: ... fn get(self) -> T: ...`,
        # desugared by the parser into a synthetic impl -- see
        # fn_struct_decls.spl) has no monomorphization support on the native
        # build path, same as bare generic functions (#158 Phase A). Before
        # `impl_.type_params` was threaded through (this sweep), this was
        # silently unreachable dead code (always `[]`) and the method's use of
        # the struct's own `T` fell through to an unrelated
        # bareword-forward-declared-type path, producing an opaque zero-field
        # struct that crashed `llc` downstream with a cryptic, wrong-layer
        # diagnostic instead of identifying the unsupported generic use.
        # #158 Phase C: the impl-tier declaration fatal is replaced by
        # non-emittable templating (hardening plan 9.3 step 12). Every method
        # below is flagged `is_generic_template` and MIR skips flagged
        # functions. Unrewritten calls remain errors in 40.mono (E-MONO-030/032).
        # Postmono invariants still reject retained templates under robust/
        # critical profiles. HWIR-E-GENERIC applies to hardware lowering.

        var methods: Dict<text, SymbolId> = {}
        # Method name -> declared return type's struct NAME (methchain lane;
        # see HirImpl.method_return_struct_names doc comment). Computed here,
        # not at MIR time, because HIR lowering has already resolved the
        # method's `-> Pt` return annotation via self.symbols regardless of
        # whether the eventual backend path runs expression type-inference.
        var method_return_struct_names: Dict<text, text> = {}
        var method_return_is_array: Dict<text, bool> = {}
        var method_return_is_optional: Dict<text, bool> = {}
        val previous_self_type = self.current_method_self_type
        val previous_self_symbol_id = self.current_method_self_symbol_id
        self.current_method_self_type = Some(type_)
        self.current_method_self_symbol_id = match type_.kind:
            case Named(owner_symbol, _): owner_symbol.id
            case _: -1
        for name in impl_.methods.keys():
            val fn_ = impl_.methods[name]
            var hir_fn = self.lower_function(fn_)
            # #158 Phase B: same rule as the trait tier above -- an impl for a
            # type with type parameter(s) makes every method a template.
            if type_params.len() > 0:
                hir_fn.is_generic_template = true
            methods[name] = hir_fn.symbol
            self.lowered_impl_functions[hir_fn.symbol.id] = hir_fn
            var ret_struct_name = ""
            var ret_is_array = false
            var ret_is_optional = false
            match hir_fn.return_type.kind:
                case Named(ret_type_symbol, _):
                    # Keep owner resolution scalar.  HirSymbol is a value record
                    # stored in SymbolTable's Dict; carrying the optional record
                    # out of get_symbol and then projecting `.name` is a fragile
                    # native bootstrap path (and does not need the whole owner).
                    ret_struct_name = self.symbols.symbol_display_name(ret_type_symbol, "")
                case Array(_, _):
                    ret_is_array = true
                case Slice(_):
                    ret_is_array = true
                case Optional(_):
                    ret_is_optional = true
                case _: ()
            method_return_struct_names[name] = ret_struct_name
            method_return_is_array[name] = ret_is_array
            method_return_is_optional[name] = ret_is_optional
        self.current_method_self_type = previous_self_type
        self.current_method_self_symbol_id = previous_self_symbol_id

        # Inject trait default methods that this impl does NOT override.
        # Without this, HirImpl.methods only contains textually-present methods,
        # so positional dispatch against the trait's full method list aliases the
        # wrong body (or SIGSEGVs). See task #55.
        if impl_.has_trait_:
            # `Impl.trait_` is declared `Type` (non-optional); its one real
            # construction site (`_FlatAstBridge/module_assembly.spl`)
            # always supplies a concrete `Type` (falling back to
            # `TypeKind.Infer` rather than `nil` when there is no trait), so
            # this bind is always safe under the `has_trait_` guard. Bind it
            # to its declared type explicitly rather than matching on
            # `impl_.trait_.kind` directly -- the bare field access left the
            # receiver an untyped/ANY receiver for the seed's field-type
            # inference.
            val impl_trait_type: Type = impl_.trait_
            match impl_trait_type.kind:
                case Named(trait_name, _):
                    if self.imported_traits.contains_key(trait_name):
                        # Materialize the Dict-held value before mutating the
                        # registry.  The lower call consumes a value snapshot;
                        # removal remains an explicit owner-side commit.
                        val imported_trait = self.imported_traits[trait_name]
                        self.lower_trait(imported_trait)
                        # `Dict.remove(k)` returns a NEW dict interpreted but the REMOVED VALUE
                        # natively (rt_dict_remove); assigning it back destroys the map on the
                        # compiled lane. Rebuild without the key. See doc/08_tracking/bug/
                        # dict_remove_return_value_differs_native_vs_interpreter_2026-09-13.md
                        var _kept_self_imported_traits: {text: ParserTrait} = {}
                        for _k in self.imported_traits.keys():
                            if _k != trait_name:
                                _kept_self_imported_traits[_k] = self.imported_traits[_k]
                        self.imported_traits = _kept_self_imported_traits
                    if self.lowered_traits.contains_key(trait_name):
                        val trait_hir: HirTrait = self.lowered_traits[trait_name]
                        for default_fn in trait_hir.defaults:
                            if not methods.contains_key(default_fn.name):
                                var concrete_default = default_fn
                                val concrete_symbol_type = self.concrete_default_method_type(default_fn, type_)
                                val concrete_symbol_name = match type_.kind:
                                    case Named(owner_symbol, _): self.symbols.method_symbol_name(owner_symbol, default_fn.name)
                                    case _: default_fn.name
                                val concrete_symbol = self.symbols.define(
                                    concrete_symbol_name,
                                    if default_fn.is_static: SymbolKind.Function else: SymbolKind.Method,
                                    concrete_symbol_type,
                                    default_fn.span,
                                    default_fn.visibility,
                                    false,
                                    self.module_filename
                                )
                                # #157 body half: the default body was lowered in
                                # the trait scope where `self` is the trait's Self
                                # type, so MIR's function_lowering would not
                                # register the self local as the concrete struct
                                # (`self.name()` inside the body then fails
                                # "unresolved method call"). Retype the self param
                                # to the concrete impl type so struct_value_syms
                                # picks up the receiver's real name and inner
                                # required/default calls resolve. HirFunction and
                                # HirParam are value structs, so rebuilding params
                                # here does not alias the shared trait default
                                # (safe for two impls of one trait).
                                if not default_fn.is_static and concrete_default.params.len() > 0:
                                    var retyped_params: [HirParam] = []
                                    var retyped_i = 0
                                    while retyped_i < concrete_default.params.len():
                                        var retyped_param = concrete_default.params[retyped_i]
                                        if retyped_i == 0:
                                            retyped_param.type_ = type_
                                        retyped_params.push(retyped_param)
                                        retyped_i = retyped_i + 1
                                    concrete_default.params = retyped_params
                                concrete_default.symbol = concrete_symbol
                                methods[default_fn.name] = concrete_symbol
                                self.lowered_impl_functions[concrete_symbol.id] = concrete_default
                                var default_ret_struct_name = ""
                                var default_ret_is_array = false
                                var default_ret_is_optional = false
                                match default_fn.return_type.kind:
                                    case Named(ret_type_symbol, _):
                                        default_ret_struct_name = self.symbols.symbol_display_name(ret_type_symbol, "")
                                    case Array(_, _):
                                        default_ret_is_array = true
                                    case Slice(_):
                                        default_ret_is_array = true
                                    case Optional(_):
                                        default_ret_is_optional = true
                                    case _: ()
                                method_return_struct_names[default_fn.name] = default_ret_struct_name
                                method_return_is_array[default_fn.name] = default_ret_is_array
                                method_return_is_optional[default_fn.name] = default_ret_is_optional
                case _:
                    pass_dn

        # Lower associated type implementations
        var assoc_type_impls: [HirAssocTypeImpl] = []
        for at in impl_.assoc_types:
            assoc_type_impls = assoc_type_impls.push(self.lower_assoc_type_impl(at))

        self.symbols.pop_scope()

        HirImpl(
            type_: type_,
            # This is an explicit desugared pair, not an optional field whose
            # presence flag the constructor can infer from its payload.
            has_trait_: impl_.has_trait_,
            trait_: trait_,
            type_params: type_params,
            where_clause: where_clause,
            methods: methods,
            method_return_struct_names: method_return_struct_names,
            method_return_is_array: method_return_is_array,
            method_return_is_optional: method_return_is_optional,
            assoc_type_impls: assoc_type_impls,
            span: impl_.span
        )

    me lower_assoc_type_decl(at: AssocTypeDecl) -> HirAssocTypeDecl:
        var bounds: [HirType] = []
        for b in at.bounds:
            bounds = bounds.push(self.lower_type(b))

        # Lower default type if present
        val default_type = if at.has_default:
            Some(self.lower_type(at.default))
        else:
            nil

        HirAssocTypeDecl(
            name: at.name,
            bounds: bounds,
            default: default_type,
            span: at.span
        )

    me lower_assoc_type_impl(at: AssocTypeDecl) -> HirAssocTypeImpl:
        val concrete = if at.has_default:
            self.lower_type(at.default)
        else:
            # Missing concrete type -- report error
            self.error("associated type '{at.name}' in impl block must have a concrete type", at.span)
            HirType(kind: HirTypeKind.Error, span: at.span)

        HirAssocTypeImpl(
            name: at.name,
            concrete_type: concrete,
            span: at.span
        )

    me unannotated_const_type(value: Expr, span: Span) -> HirType:
        """Type of an unannotated module constant, settled from its
        initializer shape alone.

        A signed or bit-inverted numeric literal (`val NEG = -1`,
        `val MASK = ~0`) and integer arithmetic over such literals
        (`val CAP = 1024 * 1024`) are still constants of a known scalar type.
        Leaving them as `HirTypeKind.Infer` is not harmless: the IMPORTING
        module's MIR lowering reads a global's HIR type as its storage ABI
        and fails closed on `Infer` (`[infer-arm]`), which is how 326
        `= -N` and 47 arithmetic stdlib globals blocked every native target
        that imported them. Anything the shape cannot settle stays `Infer`
        for the folded-value path in MIR."""
        match value.kind:
            case ExprKind.IntLit(_): HirType(kind: HirTypeKind.Int(64, true), span: span)
            case ExprKind.FloatLit(_): HirType(kind: HirTypeKind.Float(64), span: span)
            case ExprKind.FloatLexeme(_): HirType(kind: HirTypeKind.Float(64), span: span)
            case ExprKind.StringLit(_, _): HirType(kind: HirTypeKind.Str, span: span)
            case ExprKind.BoolLit(_): HirType(kind: HirTypeKind.Bool, span: span)
            case ExprKind.Unary(op, operand):
                val un_op: UnaryOp = op
                val un_operand: Expr = operand
                val operand_type = self.unannotated_const_type(un_operand, span)
                match un_op:
                    case UnaryOp.Neg:
                        match operand_type.kind:
                            case HirTypeKind.Int(_, _): operand_type
                            case HirTypeKind.Float(_): operand_type
                            case _: HirType(kind: HirTypeKind.Infer(0, 0), span: span)
                    case UnaryOp.BitNot:
                        match operand_type.kind:
                            case HirTypeKind.Int(_, _): operand_type
                            case _: HirType(kind: HirTypeKind.Infer(0, 0), span: span)
                    case _: HirType(kind: HirTypeKind.Infer(0, 0), span: span)
            case ExprKind.Binary(op, left, right):
                # Exactly the integer operators `lower_const_expr` folds; a
                # comparison or logical operator yields bool and stays Infer.
                val bin_op: BinOp = op
                val folds_to_int = match bin_op:
                    case BinOp.Add | BinOp.Sub | BinOp.Mul | BinOp.Div | BinOp.Mod: true
                    case BinOp.Shl | BinOp.Shr | BinOp.BitAnd | BinOp.BitOr | BinOp.BitXor: true
                    case _: false
                val bin_left: Expr = left
                val bin_right: Expr = right
                val left_type = self.unannotated_const_type(bin_left, span)
                val right_type = self.unannotated_const_type(bin_right, span)
                val left_is_int = match left_type.kind:
                    case HirTypeKind.Int(_, _): true
                    case _: false
                val right_is_int = match right_type.kind:
                    case HirTypeKind.Int(_, _): true
                    case _: false
                if folds_to_int and left_is_int and right_is_int:
                    HirType(kind: HirTypeKind.Int(64, true), span: span)
                else:
                    HirType(kind: HirTypeKind.Infer(0, 0), span: span)
            case _: HirType(kind: HirTypeKind.Infer(0, 0), span: span)

    me lowered_const_value_type(value: HirExpr, span: Span) -> HirType:
        """Type of an unannotated module global, settled from its LOWERED
        initializer when the shape alone (`unannotated_const_type`) cannot.

        Only signature and declaration evidence is used -- what an explicit
        annotation would have said:
          - a call to a function/extern -> the callee signature's return
            type (declared, or what `infer_untyped_return_type` recorded for
            a callee without `->`: Unit or the scanned tail type)
          - a constructor call or struct literal of a record declared in
            this module without type parameters -> that record
          - an array literal -> `[E]`, when every element settles to the
            same `E`
          - any expression HIR already typed (`has_type_`, e.g. a cast)
        The HIR const type is the storage ABI for BOTH the owner's static
        (`lower_static`) and every importer's external declaration
        (`register_provider_global_bindings`), so settling it here keeps the
        two sides on one type. Anything else -- a generic callee or record,
        a callee type without a settled return, an empty array, mixed
        element types -- stays
        `Infer`, and MIR fails closed with the declaration span rather
        than guessing an i64 storage slot."""
        val infer = HirType(kind: HirTypeKind.Infer(0, 0), span: span)
        if value.has_type_ and hir_const_type_settled(value.type_):
            return value.type_
        match value.kind:
            case HirExprKind.IntLit(_, suffix):
                if suffix.?: infer else: HirType(kind: HirTypeKind.Int(64, true), span: span)
            case HirExprKind.FloatLit(_, suffix):
                if suffix.?: infer else: HirType(kind: HirTypeKind.Float(64), span: span)
            case HirExprKind.FloatLexeme(_, suffix):
                if suffix.?: infer else: HirType(kind: HirTypeKind.Float(64), span: span)
            case HirExprKind.StringLit(_, _): HirType(kind: HirTypeKind.Str, span: span)
            case HirExprKind.BoolLit(_): HirType(kind: HirTypeKind.Bool, span: span)
            case HirExprKind.CharLit(_): HirType(kind: HirTypeKind.Char, span: span)
            case HirExprKind.Unary(un_op, un_operand):
                # `[-1, 2]`: a signed numeric element keeps its scalar type.
                val lowered_un_op: HirUnaryOp = un_op
                val lowered_un_operand: HirExpr = un_operand
                val operand_type = self.lowered_const_value_type(lowered_un_operand, span)
                match lowered_un_op:
                    case HirUnaryOp.Neg:
                        match operand_type.kind:
                            case HirTypeKind.Int(_, _) | HirTypeKind.Float(_): operand_type
                            case _: infer
                    case HirUnaryOp.BitNot:
                        match operand_type.kind:
                            case HirTypeKind.Int(_, _): operand_type
                            case _: infer
                    case _: infer
            case HirExprKind.StructLit(struct_type, _):
                val struct_lit_type: HirType = struct_type
                match struct_lit_type.kind:
                    case HirTypeKind.Named(struct_sym, _):
                        if self.nongeneric_record_owners.has(struct_sym.id): struct_lit_type else: infer
                    case _: infer
            case HirExprKind.Call(callee, _, type_args):
                val call_callee: HirExpr = callee
                val call_type_args: [HirType] = type_args
                val callee_raw = match call_callee.kind:
                    case HirExprKind.Var(callee_sym): callee_sym.id
                    case HirExprKind.NamedVar(callee_sym, _): callee_sym.id
                    case _: -1
                if callee_raw < 0:
                    return infer
                val callee_info = self.symbols.get_symbol_raw(callee_raw)
                if not callee_info.?:
                    return infer
                val callee_symbol: HirSymbol = callee_info.unwrap()
                match callee_symbol.kind:
                    case SymbolKind.Struct | SymbolKind.Class:
                        # Only a record declared here without type parameters:
                        # `Box(value: 1)` on a generic `Box<T>` has no settled
                        # type until inference, and an imported record's
                        # genericity is not known at this point.
                        if call_type_args.len() == 0 and self.nongeneric_record_owners.has(callee_symbol.id.id):
                            HirType(kind: HirTypeKind.Named(callee_symbol.id, []), span: span)
                        else:
                            infer
                    case SymbolKind.Function:
                        # Explicit type arguments mean a generic callee whose
                        # return type is only known after monomorphization.
                        if call_type_args.len() > 0:
                            return infer
                        val callee_type_opt = callee_symbol.type_
                        if not callee_type_opt.?:
                            return infer
                        val callee_type: HirType = callee_type_opt.unwrap()
                        match callee_type.kind:
                            case HirTypeKind.Function(_, ret, _):
                                val ret_t: HirType = ret
                                if hir_const_type_settled(ret_t): ret_t else: infer
                            case _: infer
                    case _: infer
            case HirExprKind.ArrayLit(elements, _):
                # An empty literal has no element evidence; the configured
                # empty-array default is a guess, not a declaration.
                val array_elements: [HirExpr] = elements
                if array_elements.len() == 0:
                    return infer
                val first_elem = self.lowered_const_value_type(array_elements[0], span)
                if not hir_const_type_settled(first_elem):
                    return infer
                var elem_idx = 1
                while elem_idx < array_elements.len():
                    val elem_type = self.lowered_const_value_type(array_elements[elem_idx], span)
                    if not hir_types_equal(first_elem, elem_type):
                        return infer
                    elem_idx = elem_idx + 1
                HirType(kind: HirTypeKind.Array(first_elem, nil), span: span)
            case _: infer

    me lower_hir_const_decl(const_: ParserConst) -> HirConst:
        val symbol = self.symbols.lookup_or_invalid(const_.name)
        val shape_type = if const_.has_type_:
            self.lower_type(const_.type_)
        else:
            self.unannotated_const_type(const_.value, const_.span)
        val value = self.lower_hir_expr(const_.value)
        val type_ = match shape_type.kind:
            case HirTypeKind.Infer(_, _):
                if const_.has_type_: shape_type else: self.lowered_const_value_type(value, const_.span)
            case _: shape_type

        # Compute effective visibility using filename matching
        val effective_visibility = self.compute_visibility(const_.name, const_.visibility)

        HirConst(
            symbol: symbol,
            name: const_.name,
            type_: type_,
            value: value,
            is_mutable: const_.is_mutable,
            visibility: effective_visibility,
            is_public: const_.is_public,
            is_volatile: const_.is_volatile,
            fixed_address: const_.fixed_address,
            span: const_.span
        )

    me lower_static_assert(assert_: StaticAssert) -> HirStaticAssert:
        val condition = self.lower_hir_expr(assert_.condition)

        HirStaticAssert(
            condition: condition,
            message: assert_.message,
            span: assert_.span
        )

    fn lower_aop_advice(advice: AopAdvice) -> HirAopAdvice:
        HirAopAdvice(
            predicate_text: advice.pointcut,
            advice_function: advice.handler,
            form: advice.form,
            priority: advice.priority,
            span: advice.span
        )

    fn lower_di_binding(binding: DiBinding) -> HirDiBinding:
        HirDiBinding(
            predicate_text: binding.pointcut,
            implementation: binding.implementation,
            span: binding.span
        )

    fn lower_arch_rule(rule: ArchRule) -> HirArchRule:
        HirArchRule(
            kind: rule.kind,
            predicate_text: rule.pointcut,
            message: rule.message,
            span: rule.span
        )

    fn lower_mock_decl(mock_decl: MockDecl) -> HirMockDecl:
        HirMockDecl(
            name: mock_decl.name,
            trait_name: mock_decl.trait_name,
            span: mock_decl.span
        )

fn hir_const_type_settled(type_: HirType) -> bool:
    """True when `type_` is a concrete storage type for a module global:
    no `Infer`/`Error`/`Any`/`Never`/type parameter/unresolved projection
    at the top or inside any component (generic arguments, elements,
    pointees, result arms, callable signature, union members)."""
    match type_.kind:
        case HirTypeKind.Infer(_, _) | HirTypeKind.Error | HirTypeKind.Any | HirTypeKind.Never: false
        case HirTypeKind.TypeParam(_, _) | HirTypeKind.Projection(_, _): false
        case HirTypeKind.Named(_, args):
            val named_args: [HirType] = args
            hir_const_types_settled(named_args)
        case HirTypeKind.Union(members):
            val union_members: [HirType] = members
            hir_const_types_settled(union_members)
        case HirTypeKind.Function(params, ret, _):
            val fn_params: [HirType] = params
            val fn_ret: HirType = ret
            hir_const_types_settled(fn_params) and hir_const_type_settled(fn_ret)
        case HirTypeKind.Result(ok, err):
            val result_ok: HirType = ok
            val result_err: HirType = err
            hir_const_type_settled(result_ok) and hir_const_type_settled(result_err)
        case HirTypeKind.Slice(elem):
            val slice_elem: HirType = elem
            hir_const_type_settled(slice_elem)
        case HirTypeKind.Ref(inner, _) | HirTypeKind.Ptr(inner, _) | HirTypeKind.Isolated(inner):
            val pointee: HirType = inner
            hir_const_type_settled(pointee)
        case HirTypeKind.Array(elem, _):
            val array_elem: HirType = elem
            hir_const_type_settled(array_elem)
        case HirTypeKind.Optional(inner):
            val optional_inner: HirType = inner
            hir_const_type_settled(optional_inner)
        case HirTypeKind.Dict(key, value):
            val dict_key: HirType = key
            val dict_value: HirType = value
            hir_const_type_settled(dict_key) and hir_const_type_settled(dict_value)
        case HirTypeKind.Tuple(elements):
            val tuple_elements: [HirType] = elements
            hir_const_types_settled(tuple_elements)
        case _: true

fn hir_const_types_settled(types: [HirType]) -> bool:
    for component in types:
        if not hir_const_type_settled(component):
            return false
    true
