# HIR item lowering - function, class, struct, enum, and field lowering.
# HIR Lowering - Item Lowering
#
# This module handles lowering of top-level items (functions, classes, structs, enums, traits, impls) from AST to HIR.

use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.frontend.parser_types.*
use compiler.frontend.parser_types.{ParserFunction, ImportItem}
use compiler.frontend.flat_ast_bridge.{flat_bootstrap_function_count, flat_bootstrap_function_at, flat_bootstrap_function_decl_at}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.context_helpers.*
use compiler.hir.hir_lowering.expressions.*
use compiler.common.attributes.{parse_layout_attrs, parse_function_attrs, parse_export_attrs, parse_driver_manifest_attrs, parse_platform_attrs, parse_vhdl_hardware_attrs, vhdl_hardware_metadata_default, FunctionAttr, ExportAttr, DriverManifestAttr, DriverManifestAttrKind, VhdlHardwareMetadata}
use compiler.types.type_layout.{LayoutAttr, TypeLayoutKind, PlatformParseResult, PlatformDiagnosticLevel, PlatformLayoutDiagnostic}
use compiler.common.dependency.visibility.{Visibility}
use compiler.core.{decl_get_body, decl_get_name, decl_get_param_names, decl_get_param_types, decl_get_ret_type}
use compiler.core.{decl_get_span, span_is_valid, span_start, span_end, span_line, span_col}
use compiler.core.{decl_is_gpu_kernel, decl_get_gpu_target_text, decl_get_gpu_backends_text}
use compiler.core.{STMT_EXPR, STMT_VAL_DECL, STMT_VAR_DECL, STMT_RETURN, stmt_get_tag, stmt_get_expr, stmt_get_name, stmt_get_type}
use compiler.core.{EXPR_INT_LIT, EXPR_STRING_LIT, EXPR_BOOL_LIT, EXPR_NIL_LIT, EXPR_IDENT, EXPR_BINARY, EXPR_CALL, EXPR_FIELD_ACCESS, EXPR_METHOD_CALL, EXPR_BLOCK, EXPR_RETURN, expr_get_tag, expr_get_int, expr_get_str, expr_get_left, expr_get_right, expr_get_args, expr_get_stmts}
use compiler.core.{TOK_MINUS, TOK_STAR, TOK_SLASH, TOK_PERCENT, TOK_EQ, TOK_NOT_EQ, TOK_LT, TOK_LT_EQ, TOK_GT, TOK_GT_EQ}
use compiler.frontend.core.types.{TYPE_VOID, TYPE_BOOL, TYPE_I64, TYPE_TEXT, custom_primitive_bind_symbol, custom_primitive_is_name}
use compiler.frontend.core.types.{primitive_integer_bit_width_from_name, custom_primitive_integer_bit_width_by_name}
use compiler.core.{int_to_str}
use std.nogc_sync_mut.io.process_ops.{eprint}

extern fn rt_env_get(key: text) -> text?
extern fn rt_enum_discriminant(value: Any) -> i64

# `rt_env_get` yields nil for an UNSET variable, so both the extern and this
# wrapper are OPTIONAL — every call site below already uses the optional-safe
# `?? ""` / `== "1"` form, which distinguishes unset from explicitly-empty.
# Same fix as flat_bridge_env_get (7825f01def2) and compiler/00.common/config.
fn hir_lower_env_get(key: text) -> text?:
    rt_env_get(key)

# Native-safe presence checks for the desugared `has_*` / value field pairs on
# HirFunction. `opt.?` MUST NOT be used for these: it is the TryOperator, it has
# no native lowering, and under SIMPLE_BOOTSTRAP=1 it silently yields the nil
# sentinel (3) rather than a bool -- see the comment at the lower_function
# construction site. `if val` lowers to a genuine bool on the native path.
fn hir_optional_export_attr_exists(opt: ExportAttr?) -> bool:
    if val present = opt:
        true
    else:
        false

fn hir_optional_driver_manifest_exists(opt: DriverManifestAttr?) -> bool:
    if val present = opt:
        true
    else:
        false

fn hir_lower_diag_enabled() -> bool:
    val trace = hir_lower_env_get("SIMPLE_COMPILER_TRACE") ?? ""
    val diag = hir_lower_env_get("SIMPLE_BOOTSTRAP_DIAG") ?? ""
    if trace == "1":
        return true
    diag == "1"

# Single source of truth for "this generic FUNCTION is an unmonomorphized
# TEMPLATE" (#158 Phase B). Currently the Phase A loud gate below is its only
# caller; it exists as a named predicate because the sibling struct/class
# tiers RECORD template-ness on the HIR node
# (`HirStruct/HirClass.is_generic_template`, see lower_struct), and the
# function tier now does too: `HirFunction.is_generic_template`
# (hir_definitions.spl) is set from this predicate at both lowering sites
# below, so all four tiers agree. Tracked in
# doc/08_tracking/bug/hir_generic_templates_unconsumed_by_mono_pass_2026-08-21.md.
# Keeping the gate condition behind this predicate means the marking, when it
# is added, cannot drift from the refusal: a declaration that is refused is
# exactly a declaration that is a template. (The former SIMPLE_BOOTSTRAP=1-only
# allowlist of three `<T>` array-len helpers was retired 2026-08-22: the
# helpers were rewritten to plain `.len()` at every call site, because an
# env-gated exemption fatals on any stage build that does not export the env
# var -- see eprint_builtin_native_path_spec.spl for the sibling defect.)
fn hir_generic_fn_is_template(name: text, type_param_count: i64) -> bool:
    if type_param_count == 0:
        return false
    true

# Reads the parser-recorded span for a declaration index. Falls back to an
# empty span only when the id is invalid, so a missing location stays visibly
# empty rather than pointing at a wrong line.
fn declaration_span_for(decl_idx: i64) -> Span:
    val span_id = decl_get_span(decl_idx)
    if not span_is_valid(span_id):
        return Span.empty()
    val s = span_start(span_id)
    val e = span_end(span_id)
    Span(start: s, end: e, line: span_line(span_id), col: span_col(span_id), file: "", length: e - s)

impl HirLowering:
    me lower_bootstrap_flat_function(decl_idx: i64) -> HirFunction:
        # Was Span.empty(), which made every bootstrap-path function report
        # line 0 downstream (DWARF decl_line, MIR instruction spans,
        # diagnostics). The parser does record a real span per declaration;
        # read it. Mirrors decl_span_for in _FlatAstBridge/convert_nodes.spl,
        # which fixes the same hole on the non-bootstrap path.
        val span = declaration_span_for(decl_idx)
        val name = decl_get_name(decl_idx)
        val symbol = bootstrap_hir_symbol_for_name(name)
        self.current_function = Some(symbol)
        self.symbols.push_scope(ScopeKind.Function)
        val param_names = decl_get_param_names(decl_idx)
        val param_types = decl_get_param_types(decl_idx)
        val param_count = param_names.len()
        var params: [HirParam] = []
        var pi = 0
        while pi < param_count:
            val p_name = param_names[pi]
            val p_type = if pi < param_types.len():
                self.bootstrap_hir_type_from_tag(param_types[pi])
            else:
                HirType(kind: HirTypeKind.Infer(0, 0), span: span)
            val p_sym = self.symbols.define(p_name, SymbolKind.Parameter, Some(p_type), span, Visibility.Private, false, nil)
            params.push(HirParam(symbol: p_sym, name: p_name, type_: p_type, has_default: false, default: HirExpr(kind: HirExprKind.NilLit, has_type_: true, type_: HirType(kind: HirTypeKind.Unit, span: span), span: span), span: span, is_mutable: false))
            pi = pi + 1
        val body_ids = decl_get_body(decl_idx)
        val body = self.lower_bootstrap_flat_block(body_ids)
        self.symbols.pop_scope()
        self.current_function = nil
        var func_attr = FunctionAttr.default()
        if decl_is_gpu_kernel[decl_idx] != 0:
            var fa = func_attr
            fa.is_gpu_kernel = true
            fa.gpu_target = decl_get_gpu_target_text(decl_idx)
            fa.gpu_backends = decl_get_gpu_backends_text(decl_idx)
            func_attr = fa
        HirFunction(
            symbol: symbol,
            name: name,
            type_params: [],
            params: params,
            return_type: self.bootstrap_hir_type_from_tag(decl_get_ret_type(decl_idx)),
            body: body,
            effects: [],
            visibility: Visibility.Public,
            is_async: false,
            is_static: false,
            is_public: true,
            is_method: false,
            is_mutable: false,
            is_const: false,
            is_extern: false,
            func_attr: func_attr,
            has_export_attr: false,
            export_attr: nil,
            has_driver_manifest_attr: false,
            driver_manifest_attr: DriverManifestAttr(kind: DriverManifestAttrKind.Driver, driver_class: 0, vendor: 0, device_ids: [], version: "", abi: ""),
            has_suspension: false,
            has_vhdl_metadata: false,
            vhdl_metadata: vhdl_hardware_metadata_default(),
            has_doc_comment: false,
            doc_comment: "",
            span: span,
            is_gpu_kernel: func_attr.is_gpu_kernel,
            gpu_target: func_attr.gpu_target,
            gpu_backend_order: func_attr.gpu_backends,
            verification_contract: nil,
            # Flat bootstrap functions carry no type params (type_params: []
            # above), so this tier is never a template. Named explicitly so
            # the construction stays fully named.
            is_generic_template: false
        )

    me lower_function(fn_: ParserFunction) -> HirFunction:
        if fn_.name == "__simple_rt_string_char_code_at":
            val owns_alias = self.module_filename.replace("\\", "/") == "src/runtime/simple_core/core_string.spl"
            if not owns_alias:
                self.error("function name '__simple_rt_string_char_code_at' is reserved for compiler-generated text calls", fn_.span)
        if fn_.name == "__simple_rt_string_byte_at":
            val owns_byte_at_alias = self.module_filename.replace("\\", "/") == "src/runtime/simple_core/core_string.spl"
            if not owns_byte_at_alias:
                self.error("function name '__simple_rt_string_byte_at' is reserved for compiler-generated text calls", fn_.span)
        val bootstrap_diag = (hir_lower_env_get("SIMPLE_BOOTSTRAP") ?? "") == "1" and hir_lower_diag_enabled()
        if bootstrap_diag:
            eprint("[hir-lower] lower_function:start {fn_.name}")
        var fn_symbol_id = SymbolId(id: -1)
        var fn_symbol_name = fn_.name
        # Statics too (`static fn` has is_method=false, is_static=true): two
        # impls each declaring `static fn code()` otherwise collide on the bare
        # symbol name — one shared symbol id AND a duplicate bare `code` symbol
        # in the emitted LLVM IR ("invalid redefinition of function").
        if fn_.is_method or fn_.is_static:
            if val owner_type = self.current_method_self_type:
                match owner_type.kind:
                    case Named(owner_symbol, _):
                        fn_symbol_name = self.symbols.method_symbol_name(owner_symbol, fn_.name)
                    case _: ()
        val fn_symbol_kind = if fn_.is_method and not fn_.is_static: SymbolKind.Method else: SymbolKind.Function
        # Static impl/class methods arrive with is_method=false, so the
        # qualification above never applies to them: the lookup below misses
        # the owner-qualified symbol that module_lowering's impl-method
        # declaration pass predeclared WITH its full signature
        # (declared_callable_type), and a fresh plain-name symbol is defined
        # instead. That fresh symbol is what HirImpl.methods -- and therefore
        # MIR's "static::{Owner}::{method}" dispatch in struct_method_syms --
        # carries, so resolved_call_return_type fell back to its untyped i64
        # default and a text-returning static's print rendered the raw tagged
        # string handle as a decimal integer (bug
        # native_method_text_return_prints_handle_2026-07-16). Renaming the
        # symbol to the qualified form is NOT an option: the module ALSO
        # lowers the same static as a plain top-level function (module
        # .functions carries impl methods), and that copy emits the DEFINITION
        # under the plain name -- a qualified call site then fails to link
        # (verified empirically: ld.lld undefined symbol Widget.category).
        # Instead, give the fallback-defined symbol its real declared
        # signature so call-result typing works exactly like the predeclared
        # instance-method path. Statics have no receiver param, so no owner
        # context is needed.
        var fn_fallback_type: HirType? = nil
        if fn_.is_static:
            if val owner_type = self.current_method_self_type:
                fn_fallback_type = Some(self.declared_callable_type(fn_, nil))
        # The bare-name bootstrap fast path below owns ONLY the compiler's own
        # fixed set of top-level CLI entry functions (bootstrap_version,
        # main, ...) -- bootstrap_hir_symbol_known_name is that same fixed
        # list. Any OTHER non-method function (a class `static fn`, which
        # carries is_method=false too, but ALSO an ordinary top-level
        # function like `fn build() -> Reg: ...` in a real compiled program)
        # used to fall through bootstrap_hir_symbol_for_name's catch-all to a
        # hardcoded SymbolId(100) that is NEVER inserted into self.symbols
        # (no `define()` call), so it is absent from the flat symbol table
        # the --entry-closure MIR path builds from
        # `self.symbols.symbols.values()`. For a static method call site that
        # resolves the same id via struct_method_syms["static::Type::method"]
        # and looks it up, this produced `unknown_100` -> ld.lld "undefined
        # symbol: unknown_100" (bug native_flat_static_method_call_unknown_100).
        # For a plain function returning a class/struct, the callee NAME still
        # linked fine (bootstrap_flat_function_symbol_name emits a non-method
        # function under its bare name regardless of func.symbol validity),
        # but resolved_call_hir_return_type(id=100) always found nothing, so
        # remember_call_hir_return never threaded the declared return type
        # onto the call result -- struct_value_syms was never populated for
        # `val r = build()`, and every method call / field read on `r`
        # afterward silently misresolved (bug
        # native_flat_free_fn_struct_return_symbol_100). Routing any
        # unrecognized name through the qualified lookup-or-define branch
        # instead reuses the SAME symbol the declare loop (module_lowering.spl
        # signature-declaration pre-pass) already defined for it -- present in
        # the flat table, carrying the real declared type -- so both the
        # call site and the emitted body agree on one real, linkable symbol.
        if (hir_lower_env_get("SIMPLE_BOOTSTRAP") ?? "") == "1" and not fn_.is_method and bootstrap_hir_symbol_known_name(fn_.name):
            fn_symbol_id = bootstrap_hir_symbol_for_name(fn_.name)
        else:
            val fn_symbol_lookup = self.symbols.lookup(fn_symbol_name)
            if val found_symbol = fn_symbol_lookup:
                # `if val` can still bind nil on the seed interpreter when the
                # lookup fails. Guard the payload explicitly so we never stash
                # `Some(nil)` in current_function or emit a nil symbol id into
                # downstream `.id` consumers.
                if found_symbol == nil:
                    fn_symbol_id = self.symbols.define(fn_symbol_name, fn_symbol_kind, fn_fallback_type, fn_.span, fn_.visibility, false, nil)
                else:
                    fn_symbol_id = found_symbol
            else:
                fn_symbol_id = self.symbols.define(fn_symbol_name, fn_symbol_kind, fn_fallback_type, fn_.span, fn_.visibility, false, nil)
        self.current_function = Some(fn_symbol_id)
        # NOTE(#133): push the function scope unconditionally, including under
        # SIMPLE_BOOTSTRAP. Bug #133: params were never lowered under bootstrap
        # (see below), so the `define` emitted zero params while callers passed
        # real args (`call ... (nil, nil)`) and the body's own identifier
        # references (e.g. `args`, `i`) resolved to `i64 undef` because no
        # scope/symbol existed for them. Body identifiers resolve through
        # `self.symbols.lookup(name)` (expressions.spl Ident arm) regardless of
        # bootstrap mode -- only the function's OWN symbol uses the name-based
        # `bootstrap_hir_symbol_for_name` scheme. Pushing the scope here and
        # lowering params below (via the existing `lower_param`, which calls
        # `self.symbols.define`) makes `args`/`i` resolve to real param locals
        # under bootstrap too.
        self.symbols.push_scope(ScopeKind.Function)
        if bootstrap_diag:
            eprint("[hir-lower] lower_function:scope {fn_.name}")

        # Lower type parameters
        var type_params: [HirTypeParam] = []
        var tpi = 0
        while tpi < fn_.type_params.len():
            type_params = type_params.push(self.lower_type_param(fn_.type_params[tpi]))
            tpi = tpi + 1
        if bootstrap_diag:
            eprint("[hir-lower] lower_function:type_params {fn_.name}")

        # Phase A gate (#158): generic functions (`fn id<T>(x: T) -> T`) are
        # NOT monomorphized on the native --entry build path -- the erased
        # `T` parameter/return type silently degrades to `Infer`/ANY, which
        # previously made calls to generic functions return 0 instead of the
        # real argument (silent-wrong, no diagnostic). Now that
        # `ParserFunction.type_params` is threaded through from the frontend
        # (convert_decl_fn in the flat-AST bridge), fail loudly here instead
        # of proceeding into codegen with an unmonomorphized generic. Real
        # monomorphization is tracked separately (#158 Phase B) -- this is a
        # deliberate hard stop, not a workaround.
        # Phase B (2026-08-22): the gate is OPEN. A generic fn now lowers to a
        # HirFunction marked `is_generic_template` (below), and the 40.mono
        # pass specializes it per call-site type args, repoints the calls and
        # drops the template (monomorphize_integration.spl). Any call site the
        # pass cannot rewrite is a hard E-MONO-033 error in the driver, so an
        # unmonomorphized generic still never reaches MIR.

        # Lower parameters
        # NOTE(#133): lowered unconditionally, including under SIMPLE_BOOTSTRAP.
        # Previously this whole block was skipped under bootstrap, so `params`
        # stayed empty for every bootstrap entry function -- the MIR `define`
        # emitted zero params while callers passed real args (mismatched arity,
        # `call ... (nil, nil)`), and the body's references to those params
        # (e.g. `args`, `i` in bootstrap_output_from_args) resolved to `i64
        # undef` since no symbol/local existed for them. `lower_param` (below)
        # calls `self.symbols.define`, and the body's Ident lowering resolves
        # names via `self.symbols.lookup` (scope-based, not bootstrap's
        # name-based function-symbol scheme) -- so lowering params the same way
        # as non-bootstrap, now that the function scope above is always pushed,
        # makes the body's param references bind correctly under bootstrap too.
        var params: [HirParam] = []
        val fn_params = function_params(fn_)
        # Compute the implicit-`self` condition with nested checks + an
        # intermediate bool rather than one compound `A and B and C and
        # (D or E)` expression: the cranelift backend mis-lowered the fused
        # form, nil-checking the boolean result of the `(len()==0 or
        # [0].name != ...)` sub-expression as if it were a heap pointer,
        # trapping with "field access on nil receiver" (SIGILL) even for a
        # plain non-method `fn main()`. Short-circuiting via nested ifs keeps
        # the array-indexing operand out of the fused boolean entirely.
        # `me` is Simple's explicit MUTABLE receiver written in the parameter
        # list (`fn selfset(me): me.x = 41`) -- the by-reference counterpart of
        # `self`. The frontend (parser_decls_use.spl parse_class_body_method)
        # already recognizes a leading `me` as the receiver: it backfills its
        # struct type and marks the method mutable, so it arrives here as
        # fn_params[0] named "me" and typed. Treating it like a plain param
        # (name != "self") wrongly SYNTHESIZED a second implicit `self`,
        # demoting the real `me` to slot 1 where it received no call argument --
        # `c.getx()` read `me` as undef (garbage pointer) and `me.x = 41` stored
        # into nothing (Bug native_me_receiver_no_mutate). Exclude "me" here so
        # it stays the sole receiver, exactly like an explicit `self`.
        var needs_implicit_self = false
        var implicit_self_type = HirType(kind: HirTypeKind.Unit, span: fn_.span)
        if fn_.is_method and not fn_.is_static:
            if val bound_self_type = self.current_method_self_type:
                implicit_self_type = bound_self_type
                if fn_params.len() == 0:
                    needs_implicit_self = true
                elif fn_params[0].name != "self" and fn_params[0].name != "me":
                    needs_implicit_self = true
        if needs_implicit_self:
            val self_type = implicit_self_type
            val self_symbol = self.symbols.define("self", SymbolKind.Parameter, Some(self_type), fn_.span, Visibility.Private, false, nil)
            params = params.push(HirParam(
                symbol: self_symbol,
                name: "self",
                type_: self_type,
                has_default: false,
                default: HirExpr(kind: HirExprKind.NilLit, has_type_: false, type_: HirType(kind: HirTypeKind.Unit, span: fn_.span), span: fn_.span),
                span: fn_.span,
                is_mutable: false
            ))
        var pi = 0
        while pi < fn_params.len():
            params = params.push(self.lower_param(fn_params[pi]))
            pi = pi + 1
        if bootstrap_diag:
            eprint("[hir-lower] lower_function:params {fn_.name}")

        # Lower return type — use explicit check instead of .map() ?? default
        # to avoid crash with null coalescing on Option.map result
        var return_type = HirType(kind: HirTypeKind.Unit, span: fn_.span)
        # Gate on has_return_type, not `return_type.?`: return_type is a
        # non-optional Type whose placeholder for an omitted annotation is a
        # bare `Infer` node, so `.?` is always true and we would lower that
        # Infer placeholder — which segfaults in lower_type_list. A function
        # without an explicit return type keeps the default Unit result.
        #
        # DECLARED type takes priority in BOTH modes. The bootstrap arm used
        # to unconditionally consult bootstrap_builtin_return_type(name) —
        # a workaround from when the flat bridge discarded declared returns
        # (see convert_nodes.spl `inferred_ret`). After the bridge fix that
        # inversion silently retyped EVERY declared `-> text` (etc.) to the
        # table's i64 default, so call results lost their static type and
        # interpolation/concat rendered text handles as raw integers
        # (native_call_return_type_loss 2026-07-23). The table remains the
        # fallback for bootstrap functions with no declaration.
        if fn_.has_return_type:
            val declared_ret = self.lower_type(fn_.return_type)
            if (hir_lower_env_get("SIMPLE_BOOTSTRAP") ?? "") == "1":
                # NARROW (deliberate): in bootstrap mode only Str declared
                # returns take priority for now. Widening every declared type
                # (arrays/structs/dicts) immediately broke consumers tuned to
                # the uniform-i64 convention (`get_args()` -> Array-typed local
                # made `a.len()` lower to the raw receiver -> strlen SIGSEGV,
                # W92). Widen type-by-type with repro coverage; ceiling noted
                # in native_call_return_type_loss 2026-07-23.
                match declared_ret.kind:
                    case HirTypeKind.Str:
                        return_type = declared_ret
                    case _:
                        return_type = bootstrap_builtin_return_type(fn_.name, fn_.span)
            else:
                return_type = declared_ret
        elif (hir_lower_env_get("SIMPLE_BOOTSTRAP") ?? "") == "1":
            return_type = bootstrap_builtin_return_type(fn_.name, fn_.span)
        if bootstrap_diag:
            eprint("[hir-lower] lower_function:return_type {fn_.name}")

        # Lower body. A function WITHOUT an explicit return type returns Unit, so
        # its body is not in value position — use `lower_hir_block_unit`, which
        # keeps a trailing expression-statement (`fn main(): print(...)`) IN
        # `stmts` and never extracts a trailing value. This sidesteps the seed's
        # ANY-erased `case Expr(expr)` mis-extraction that stored a garbage
        # HirExpr as `block.value` (iteration 14), which made the interpreter's
        # trailing-value eval silently no-op (or SIGSEGV on a typed rebind). A
        # value IS needed only when the function returns a real type, so the
        # value-extracting path is kept for `has_return_type`.
        val body = if fn_.has_return_type:
            self.lower_hir_block(fn_.body)
        else:
            self.lower_hir_block_unit(fn_.body)
        if bootstrap_diag:
            eprint("[hir-lower] lower_function:body {fn_.name}")

        # Untyped-return inference (native --entry path). A function with NO
        # declared return type defaults to Unit above -- but if its body has
        # an explicit `return <value>`, that default is wrong: the backend
        # still emits `void`, yet MIR carries a real value out of the
        # `return`, producing invalid LLVM IR (`ret void %t0` after a bogus
        # bitcast) that llc rejects with a cryptic, far-from-the-cause error.
        # The actual inference (and, when it can't agree on one simple type,
        # the fatal route-(b) error) already ran BEFORE this function's body
        # was lowered, in the module's up-front signature-declaration pass
        # (`infer_untyped_return_type` in module_lowering.spl) -- it has to
        # run that early so CALLERS of this function see the right type too,
        # not just this function's own `ret` instruction. Here we just pick
        # up whatever that pass decided, by reading it back off this
        # function's own symbol. Gated out of SIMPLE_BOOTSTRAP: that path
        # computes return_type via `bootstrap_builtin_return_type` above and
        # is owned by the parallel bootstrap-redeploy lane (module_lowering's
        # inference pass is itself skipped entirely under plain bootstrap).
        # `and fn_.name != "main"`: the synthesized entry `main` (bare-statement
        # program) is not registered like a normal function, so `lookup("main")`
        # binds a nil `fn_symbol_id` that no `== nil`/`.?` check rejects (seed
        # nil-representation limit); passing it to get_symbol_type destructures the
        # nil and traps "field access on nil receiver", dropping the in-guest
        # interpreter's main. main's untyped body returns Unit (defaulted above),
        # so it needs none of this user-function return inference.
        if (not fn_.has_return_type) and (hir_lower_env_get("SIMPLE_BOOTSTRAP") ?? "") != "1" and fn_.name != "main":
            val fn_sym_type = self.symbols.get_symbol_type(fn_symbol_id)
            if fn_sym_type.?:
                match fn_sym_type.unwrap().kind:
                    case HirTypeKind.Function(_, ret, _):
                        return_type = ret
                    case _:
                        pass

        # Contract predicates are lowered after return inference but while the
        # function parameter scope is still active. Outcome bindings receive
        # their exact normal/error type and never enter the executable body.
        val verification_contract = self.lower_verification_contract(fn_.contract, return_type)

        # NOTE(#133): pop unconditionally, matching the unconditional push above.
        self.symbols.pop_scope()
        self.current_function = nil

        # Compute effective visibility using filename matching
        val effective_visibility = self.compute_visibility(fn_.name, fn_.visibility)

        # Parse function attributes (@entry, @naked, @noreturn, @section, @interrupt)
        var fa: FunctionAttr = parse_function_attrs(fn_.attributes)
        if fn_.is_kernel:
            fa.is_gpu_kernel = true
        # Parse export attributes (@export("C"))
        val parsed_export_attr: ExportAttr? = parse_export_attrs(fn_.attributes)
        val driver_manifest: DriverManifestAttr? = parse_driver_manifest_attrs(fn_.attributes)
        val vhdl_metadata: VhdlHardwareMetadata = parse_vhdl_hardware_attrs(fn_.attributes)
        # NEVER compute a desugared `has_*` bool with `.?` here. `.?` is the
        # TryOperator and has NO native lowering: on the normal path the seed
        # rejects it outright ("constructs that require the interpreter:
        # [TryOperator]"), and under SIMPLE_BOOTSTRAP=1 -- which is exactly how
        # this compiler is built -- that hard error is downgraded to a warning
        # and `opt.?` yields the NIL SENTINEL (3) instead of a bool. Storing 3
        # into a `bool` slot reads back TRUE, so every function looked like it
        # carried an @export/@driver manifest while the paired value field was
        # nil -- and `fn_.driver_manifest_attr.kind` then trapped on a nil
        # receiver (SIGILL, exit 132) for EVERY function of EVERY program,
        # which is why the deployed pure-Simple compiler could not compile
        # anything at all. Verified 2026-08-01 by gdb on the deployed stage3:
        # the has_driver_manifest_attr byte at [fn_+0x90] held 0x03.
        # `if val` lowers to a real bool on the native path (measured).
        val has_parsed_export_attr = hir_optional_export_attr_exists(parsed_export_attr)
        val has_parsed_driver_manifest = hir_optional_driver_manifest_exists(driver_manifest)

        # Seed effects from is_async annotation. This is the FINAL value, not a
        # seed to be refined: effect_pass.spl was deleted on 2026-08-02 as
        # unreachable dead code, so nothing refines HirFunction.effects later.
        var initial_effects: [Effect] = []
        if fn_.is_async:
            initial_effects = initial_effects.push(Effect(kind: EffectKind.Async, span: fn_.span))

        val hir_func = HirFunction(
            symbol: fn_symbol_id,
            name: fn_.name,
            type_params: type_params,
            params: params,
            return_type: return_type,
            body: body,
            effects: initial_effects,
            visibility: effective_visibility,
            is_async: fn_.is_async,
            is_static: fn_.is_static,
            is_public: fn_.is_public,
            is_method: fn_.is_method,
            is_mutable: fn_.is_mutable,
            is_const: fn_.is_const,
            is_extern: fn_.is_extern,
            func_attr: fa,
            # ALL desugared has_* flags passed explicitly, in declaration
            # order: the seed fills partial named constructions POSITIONALLY,
            # shifting every later field one slot (same bug class as
            # HirCallArg.value — bug doc iteration 18).
            has_export_attr: has_parsed_export_attr,
            export_attr: parsed_export_attr,
            has_driver_manifest_attr: has_parsed_driver_manifest,
            driver_manifest_attr: driver_manifest,
            has_suspension: false,
            has_vhdl_metadata: vhdl_metadata.is_hardware,
            vhdl_metadata: vhdl_metadata,
            has_doc_comment: fn_.has_doc_comment,
            doc_comment: fn_.doc_comment,
            span: fn_.span,
            is_gpu_kernel: fa.is_gpu_kernel,
            gpu_target: fa.gpu_target,
            gpu_backend_order: fa.gpu_backends,
            verification_contract: verification_contract,
            is_generic_template: hir_generic_fn_is_template(fn_.name, type_params.len())
        )

        # Validate async functions
        if fn_.is_async:
            self.validate_async_fn(hir_func)

        hir_func

    me lower_struct(struct_: ParserStruct) -> HirStruct:
        # DIRECT field access, NOT `match struct_: case Struct(...)`: the struct
        # destructure yields GARBAGE positional fields on stage4 (struct-pattern
        # destructure hazard, bug doc iteration 17/20 #86). The garbage `fields`
        # array then flows into lower_field -> lower_type where the corrupt
        # field-type Type pointer crashes the TypeKind match (SIGSEGV on any
        # struct/class run file). A typed receiver's direct field access
        # resolves correct offsets.
        val struct_name: text = struct_.name
        val struct_type_params: [ParserTypeParam] = struct_.type_params
        val struct_fields: [ParserField] = struct_.fields
        val struct_visibility: Visibility = struct_.visibility
        val struct_is_public: bool = struct_.is_public
        val struct_attributes: [Attribute] = struct_.attributes
        val struct_doc_comment: text = struct_.doc_comment
        val struct_span: Span = struct_.span

        val symbol = self.symbols.lookup_or_invalid(struct_name)
        if custom_primitive_is_name(struct_name):
            custom_primitive_bind_symbol(struct_name, symbol.id)

        var type_params: [HirTypeParam] = []
        for tp in struct_type_params:
            type_params = type_params.push(self.lower_type_param(tp))

        # #158 Phase C (extended to structs 2026-08-23): a generic struct is a
        # non-emittable TEMPLATE, not an error at its declaration site
        # (hardening plan 9.3 step 12) -- exactly the rule already applied to a
        # generic CLASS in class_declaration_lowering.spl and to a generic
        # IMPL in trait_impl_lowering. It is recorded as `is_generic_template`
        # below and never emitted.
        #
        # The old Phase A fatal's reasoning (a `T`-typed field degrades to an
        # opaque pointer-width slot at MIR, truncating a fat value) is about
        # EMITTING an unmonomorphized template. That risk is unchanged and is
        # still fenced -- but at the USE site, where it belongs: a reachable
        # instantiation fails loudly as an unrewritten generic call in 40.mono
        # (E-MONO-030/032, then E-MONO-033 refuses MIR lowering) and as
        # HWIR-E-GENERIC in strict MIR. Declaring a template nobody
        # instantiates is not a defect; emitting one is.
        #
        # Enumerated, not assumed (the 43ead88be55 precedent): `grep -rn
        # '^struct <Name><'` over src/compiler, src/runtime and src/app/cli
        # returns ZERO generic structs, and none of the 28 that exist under
        # src/lib (ecs, ndarray, db, storage, tooling/ds_utils, async,
        # common/search) is imported by anything in the stage1 closure. So no
        # stage1 instantiation exists to be silently mislowered by this change.

        var fields: [HirField] = []
        for f in struct_fields:
            val sf: ParserField = f
            val lowered_field: HirField = self.lower_field(sf)
            if (struct_name == "BackendError" and lowered_field.name == "span") or (struct_name == "CompiledUnit" and lowered_field.name == "entry_point"):
                val actual_disc = rt_enum_discriminant(lowered_field.type_.kind)
                eprint("[hir-field-type] struct={struct_name} field={lowered_field.name} actual={actual_disc}\n")
            fields = fields.push(lowered_field)

        # Compute effective visibility using filename matching
        val effective_visibility = self.compute_visibility(struct_name, struct_visibility)

        # Parse layout attributes (@repr, @packed, @align)
        val layout: LayoutAttr = parse_layout_attrs(struct_attributes)
        val has_layout = layout.layout_kind != TypeLayoutKind.Simple or layout.has_explicit_align or layout.is_packed
        val platform: PlatformParseResult = parse_platform_attrs(struct_attributes)
        val platform_fields = platform_attr_fields_for(platform)

        HirStruct(
            symbol: symbol,
            name: struct_name,
            type_params: type_params,
            fields: fields,
            visibility: effective_visibility,
            is_public: struct_is_public,
            doc_comment: struct_doc_comment,
            span: struct_span,
            has_layout_attr: has_layout,
            layout_attr: layout,
            has_platform_attr: platform_fields.has_platform,
            platform_has_error: platform_fields.has_error,
            platform_has_warning: platform_fields.has_warning,
            platform_diagnostic_message: platform_fields.message,
            platform_diagnostic_line: platform_fields.line,
            # #158 Phase B (HIR half): recorded truthfully instead of the
            # hardcoded `false` this used to carry. See lower_class in
            # class_declaration_lowering.spl for the full rationale.
            is_generic_template: struct_type_params.len() > 0,
            specialization_of: nil,
            type_bindings: {}
        )

    me lower_field(f: ParserField) -> HirField:
        # Typed rebind before any field access. On the stage4 unstub path the
        # `f` param arrives ANY-erased (callers iterate `for f in struct_fields`
        # / `class_fields` on an ANY-typed [ParserField]); reading `f.type_`/`f.name`
        # off an ANY receiver hits the seed's most-fields-wins field resolver ->
        # WRONG field index -> nil -> SIGSEGV inside lower_type. Binding to a
        # `ParserField`-typed local restores correct field-index resolution (same
        # idiom as interpreter process_module; bug: struct/class run file
        # SIGSEGVs on the unstub path, iteration 19).
        val fld: ParserField = f
        val fld_type: Type = fld.type_
        val type_ = self.lower_type(fld_type)
        val symbol = self.symbols.define(fld.name, SymbolKind.Field, Some(type_), fld.span, fld.visibility, false, nil)

        # Lower default without closures to avoid bootstrap SSA issues.
        # `ParserField.default` is a DESUGARED plain Expr field gated by `has_default`
        # (NOT an Optional): the old `fld.default.?` / `.unwrap()` applied Option
        # semantics to a plain field, which on stage4 mis-evaluates to true and
        # unwraps a nil Expr -> lower_hir_expr(nil) -> "field access on nil
        # receiver" SIGILL (bug doc iteration 20 #86; same class as the iter14
        # eval_block trailing-value fix). Gate on has_default + use default
        # directly.
        # `HirField.default` is likewise a DESUGARED plain HirExpr gated by
        # its own `has_default` (hir_definitions.spl:151), NOT an Optional:
        # the old code wrapped the lowered expr in Some(...) (type mismatch,
        # silently erased) and — decisively — OMITTED `has_default:` in the
        # ctor below, so it defaulted false downstream and MIR's
        # omitted-field default fill (switch_operators_calls.spl) never
        # fired (jit-0x890 defaulted-field bug chain).
        val fld_has_default = fld.has_default
        val lowered_default = if fld_has_default:
            self.lower_hir_expr(fld.default)
        else:
            HirExpr(kind: HirExprKind.NilLit, has_type_: true, type_: HirType(kind: HirTypeKind.Unit, span: fld.span), span: fld.span)

        HirField(
            symbol: symbol,
            name: fld.name,
            type_: type_,
            has_default: fld_has_default,
            default: lowered_default,
            visibility: fld.visibility,
            is_public: fld.is_public,
            is_volatile: fld.is_volatile,
            has_bits_attr: fld.has_bits,
            bits_width: fld.bits,
            fixed_address: fld.fixed_address,
            span: fld.span
        )

    me lower_enum(enum_: ParserEnum, owner_module: text) -> HirEnum:
        self.lower_enum_with_symbol(enum_, owner_module, enum_.name)

    me lower_enum_with_symbol(enum_: ParserEnum, owner_module: text, lookup_name: text) -> HirEnum:
        # Field access, NOT a positional `case ParserEnum(...)` destructure: that
        # arm was written for an 8-field ParserEnum and stopped matching once
        # `attributes` (and later fields) were appended, so every enum lowered
        # to nil (doc/08_tracking/bug/enum_decorators_dropped_before_hir_2026-08-21.md).
        val name = enum_.name
        val type_params = enum_.type_params
        val variants = enum_.variants
        val visibility = enum_.visibility
        val is_public = enum_.is_public
        val doc_comment = enum_.doc_comment
        val span = enum_.span
        val symbol = self.symbols.lookup_or_invalid(lookup_name)
        var hir_type_params: [HirTypeParam] = []
        for tp in type_params:
            hir_type_params = hir_type_params.push(self.lower_type_param(tp))
        var hir_variants: [HirVariant] = []
        for v in variants:
            hir_variants = hir_variants.push(self.lower_variant(v))
        var hir_attrs: [HirAttribute] = []
        for raw_attr in enum_.attributes:
            hir_attrs = hir_attrs.push(hir_attribute_from_raw(raw_attr))
        # Every field is named explicitly, in declaration order: the
        # Rust seed fills PARTIAL named constructions positionally, so
        # the previously-omitted has_doc_comment / has_specialization_of
        # slots silently absorbed the new trailing `attributes` field
        # and produced a nil HirEnum.
        HirEnum(
            symbol: symbol,
            name: name,
            runtime_name: if owner_module != "": "{owner_module}.{name}" else: name,
            type_params: hir_type_params,
            variants: hir_variants,
            visibility: self.compute_visibility(name, visibility),
            is_public: is_public,
            has_doc_comment: doc_comment != "",
            doc_comment: doc_comment,
            span: span,
            is_generic_template: false,
            has_specialization_of: false,
            specialization_of: "",
            type_bindings: {},
            attributes: hir_attrs,
            # D1 extension axis: a trailing `complete:` / `dyn:` section in the
            # enum body declares that region OPEN. Neither section = closed, so
            # an enum written without the new syntax keeps both flags false and
            # behaves exactly as before.
            complete_open: enum_.complete_open,
            dyn_open: enum_.dyn_open
        )

    me lower_variant(v: Variant) -> HirVariant:
        val symbol = self.symbols.define(v.name, SymbolKind.EnumVariant, nil, v.span, Visibility.Public, false, nil)

        # QUALIFIED patterns in a statement match, not `val kind = match` over
        # bare `Tuple(types)` arms: on the seed the bare arm bound `types` to a
        # 620-element garbage list, so every variant lowered as
        # Tuple(620 junk types) and any reader of a HirVariantKind.Tuple
        # payload (enum_contract's variant_shape) died on it.
        var kind = HirVariantKind.Unit
        match v.kind:
            case VariantKind.Unit:
                kind = HirVariantKind.Unit
            case VariantKind.Tuple(types):
                var hir_types: [HirType] = []
                for t in types:
                    hir_types = hir_types.push(self.lower_type(t))
                kind = HirVariantKind.Tuple(hir_types)
            case VariantKind.Struct(fields):
                var hir_fields: [HirField] = []
                for f in fields:
                    hir_fields = hir_fields.push(self.lower_field(f))
                kind = HirVariantKind.Struct(hir_fields)

        var discriminant = HirExpr(kind: HirExprKind.NilLit, type_: nil, span: v.span)
        if v.has_discriminant:
            discriminant = self.lower_hir_expr(v.discriminant)

        HirVariant(
            symbol: symbol,
            name: v.name,
            kind: kind,
            has_discriminant: v.has_discriminant,
            discriminant: discriminant,
            span: v.span
        )

    me lower_bitfield(bf: Bitfield) -> HirBitfield:
        # NOTE: previously destructured via `val x: T` pre-declarations
        # assigned inside a `match bf: case Bitfield(...)` arm -- the same
        # interpreter defect documented for MirLowering.lower_stmt (values
        # bind to unresolved placeholders; see doc/08_tracking/bug/
        # vhdl_backend_spec_remaining_failures_2026-07-02.md, "Interpreter
        # defects" #2). Bitfield is a plain struct: read fields directly.
        val bitfield_name = bf.name
        val bitfield_backing_type = bf.backing_type
        val bitfield_fields = bf.fields
        val bitfield_visibility = bf.visibility
        val bitfield_is_public = bf.is_public
        val bitfield_attributes = bf.attributes
        val bitfield_doc_comment = bf.doc_comment
        val bitfield_span = bf.span

        val symbol = self.symbols.lookup_or_invalid(bitfield_name)

        val backing = self.lower_type(bitfield_backing_type)
        val layout_attr = parse_layout_attrs(bitfield_attributes)

        # Pre-compute bit widths for all fields
        var widths: [i64] = []
        for f in bitfield_fields:
            val w = if f.bits.?:
                f.bits.unwrap()
            elif f.is_reserved:
                0
            else:
                self.infer_bit_width(f.type_)
            widths.push(w)

        # Build index array for field ordering
        var indices: [i64] = []
        var idx: i64 = 0
        while idx < bitfield_fields.len():
            indices.push(idx)
            idx = idx + 1

        # Sort by bit width descending unless @preserve_order
        if not layout_attr.is_preserve_order:
            var i: i64 = 1
            while i < indices.len():
                var j = i
                while j > 0 and widths[indices[j - 1]] < widths[indices[j]]:
                    val tmp = indices[j]
                    indices[j] = indices[j - 1]
                    indices[j - 1] = tmp
                    j = j - 1
                i = i + 1

        # Lower fields in sorted order with word-straddle avoidance
        var fields: [HirBitfieldField] = []
        var bit_offset: i64 = 0
        val word_bits: i64 = 32
        for sorted_idx in indices:
            val f = bitfield_fields[sorted_idx]
            val w = widths[sorted_idx]

            if not layout_attr.is_compactq and w > 0 and w < word_bits:
                val word_end = ((bit_offset / word_bits) + 1) * word_bits
                if (bit_offset + w) > word_end:
                    bit_offset = word_end

            val hir_field = self.lower_bitfield_field(f, bit_offset)
            fields = fields.push(hir_field)
            bit_offset = bit_offset + w

        # Compute effective visibility using filename matching
        val effective_visibility = self.compute_visibility(bitfield_name, bitfield_visibility)

        HirBitfield(
            symbol: symbol,
            name: bitfield_name,
            backing_type: backing,
            fields: fields,
            total_bits: bit_offset,
            visibility: effective_visibility,
            is_public: bitfield_is_public,
            doc_comment: bitfield_doc_comment,
            span: bitfield_span
        )
