# HIR parameter and class declaration lowering.
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.frontend.parser_types.*
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.expressions.*
use compiler.common.attributes.{parse_layout_attrs, parse_export_attrs, parse_platform_attrs, ExportAttr}
use compiler.types.type_layout.{LayoutAttr, TypeLayoutKind, PlatformParseResult}
use compiler.common.dependency.visibility.{Visibility}
use compiler.common.diagnostics.span.{Span}

impl HirLowering:
    me lower_param(p: Param) -> HirParam:
        val type_ = self.lower_type(p.type_)
        val symbol = self.symbols.define(p.name, SymbolKind.Parameter, Some(type_), p.span, Visibility.Private, false, nil)
        val default_ = if p.has_default:
            self.lower_hir_expr(p.default)
        else:
            HirExpr(
                kind: HirExprKind.NilLit,
                has_type_: true,
                type_: HirType(kind: HirTypeKind.Unit, span: p.span),
                span: p.span
            )

        HirParam(
            symbol: symbol,
            name: p.name,
            type_: type_,
            has_default: p.has_default,
            default: default_,
            span: p.span,
            is_mutable: p.is_mutable
        )

    me lower_class(class_: ParserClass) -> HirClass:
        # DIRECT field access, NOT `match class_: case Class(...)` — struct
        # destructure yields garbage positional fields on stage4 (same hazard as
        # lower_struct; bug doc iteration 17/20 #86).
        val class_name: text = class_.name
        val class_type_params: [ParserTypeParam] = class_.type_params
        val class_fields: [ParserField] = class_.fields
        val class_methods: Dict<text, ParserFunction> = class_.methods
        val class_visibility: Visibility = class_.visibility
        val class_is_public: bool = class_.is_public
        val class_attributes: [Attribute] = class_.attributes
        val class_doc_comment: text = class_.doc_comment
        val class_span: Span = class_.span

        val symbol = self.symbols.lookup_or_invalid(class_name)
        self.symbols.push_scope(ScopeKind.Class)

        var type_params: [HirTypeParam] = []
        for tp in class_type_params:
            type_params = type_params.push(self.lower_type_param(tp))

        if class_type_params.len() > 0:
            self.error("generic classes are not supported on the native build path yet: class '{class_name}' declares type parameter(s); monomorphization is not implemented (#158 Phase B)", class_span)

        var fields: [HirField] = []
        for f in class_fields:
            val cf: ParserField = f
            fields = fields.push(self.lower_field(cf))

        var methods: Dict<text, SymbolId> = {}
        val previous_self_type = self.current_method_self_type
        val previous_self_symbol_id = self.current_method_self_symbol_id
        self.current_method_self_type = Some(HirType(kind: HirTypeKind.Named(symbol, []), span: class_span))
        self.current_method_self_symbol_id = symbol.id
        for name in class_methods.keys():
            val fn_: ParserFunction = class_methods[name]
            val hir_fn = self.lower_function(fn_)
            methods[name] = hir_fn.symbol
            self.lowered_impl_functions[hir_fn.symbol] = hir_fn
        self.current_method_self_type = previous_self_type
        self.current_method_self_symbol_id = previous_self_symbol_id

        self.symbols.pop_scope()

        val effective_visibility = self.compute_visibility(class_name, class_visibility)
        val layout: LayoutAttr = parse_layout_attrs(class_attributes)
        val has_layout = layout.layout_kind != TypeLayoutKind.Simple or layout.has_explicit_align or layout.is_packed
        val parsed_export_attr: ExportAttr? = parse_export_attrs(class_attributes)
        val platform: PlatformParseResult = parse_platform_attrs(class_attributes)
        val platform_fields = platform_attr_fields_for(platform)

        HirClass(
            symbol: symbol,
            name: class_name,
            type_params: type_params,
            fields: fields,
            methods: methods,
            visibility: effective_visibility,
            is_public: class_is_public,
            doc_comment: class_doc_comment,
            span: class_span,
            has_layout_attr: has_layout,
            layout_attr: layout,
            export_attr: parsed_export_attr,
            has_platform_attr: platform_fields.has_platform,
            platform_has_error: platform_fields.has_error,
            platform_has_warning: platform_fields.has_warning,
            platform_diagnostic_message: platform_fields.message,
            platform_diagnostic_line: platform_fields.line,
            # #158 Phase B (HIR half): a generic class is an unmonomorphized
            # TEMPLATE and HIR is the layer that knows it. This was hardcoded
            # `false` at every lowering site, so the flag was a constant lie
            # and every DOWNSTREAM template check was dead code that could
            # never fire -- 50.mir/hwir/mir_to_hwir.spl's HWIR-E-GENERIC
            # reject, the VHDL backend's equivalent, and the .smf generic
            # template partitioning in 80.driver/smf_serialization.spl all
            # branch on `is_generic_template`. Recording it is the
            # prerequisite for 40.mono consuming the template, and restores
            # defence in depth meanwhile.
            is_generic_template: class_type_params.len() > 0,
            specialization_of: nil,
            type_bindings: {}
        )
