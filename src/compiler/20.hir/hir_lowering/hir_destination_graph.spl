impl HirDestinationGraph:
    me next_capacity(current: i64, required: i64) -> i64:
        var capacity = if current < 8: 8 else: current
        while capacity < required: capacity = capacity * 2
        capacity

    me record_diagnostic(message: text) -> i64:
        val required = self.diagnostic_count + 1
        if required > self.diagnostic_capacity:
            val target = self.next_capacity(self.diagnostic_capacity, required)
            while self.diagnostic_text.len() < target: self.diagnostic_text.push("")
            self.diagnostic_capacity = target
        val i = self.diagnostic_count; self.diagnostic_text[i] = message; self.diagnostic_count = required; i

    me fail(message: text) -> bool:
        if self.ready: return false
        if self.error_diagnostic < 0: self.error_diagnostic = self.record_diagnostic(message)
        false

    me mutable() -> bool: self.generation >= 0 and not self.ready and self.error_diagnostic < 0

    me begin_compile_mode(generation: i64, mode: i64) -> bool:
        if self.active_function_count != 0: return self.fail("HIR destination generation still has active functions")
        if self.generation >= 0 and not self.ready: return false
        if mode != HD_MODE_GRAPH: return self.fail("HIR destination graph factory is disabled for flat route")
        if generation < 0 or generation <= self.generation: return self.fail("HIR destination generation is not monotonic")
        self.route_mode = mode; self.generation = generation; self.ready = false; self.diagnostic_count = 0; self.error_diagnostic = -1; self.owned_text_payload_bytes = 0
        if not self.block_values.begin(generation): return self.fail("HIR BlockValue store cannot begin generation")
        if not self.destination_symbols.begin(generation): return self.fail("HIR destination symbol bridge cannot begin generation")
        if not self.destination_members.begin(generation): return self.fail("HIR destination member bridge cannot begin generation")
        if not self.destination_module_authority.begin(generation): return self.fail("HIR destination module authority cannot begin generation")
        if not self.destination_declarations.begin(generation): return self.fail("HIR destination declaration store cannot begin generation")
        if not self.declaration_metadata.begin(generation): return self.fail("HIR destination declaration metadata cannot begin generation")
        self.module_count = 0; self.module_validation_epoch = 0; self.span_count = 0; self.expr_count = 0; self.block_count = 0; self.stmt_count = 0
        self.type_count = 0; self.pattern_count = 0; self.effect_count = 0; self.dim_count = 0
        self.aux_count = 0; self.range_count = 0; self.range_slot_count = 0; self.pending_count = 0; self.function_count = 0; self.checkpoint_count = 0; self.float_payload_count = 0
        true

    me begin_compile(generation: i64) -> bool: self.begin_compile_mode(generation, HD_MODE_GRAPH)

    me ensure_span_capacity(required: i64):
        if required <= self.span_capacity: return
        val target = self.next_capacity(self.span_capacity, required)
        while self.span_start.len() < target:
            self.span_start.push(0); self.span_end.push(0); self.span_line.push(0)
            self.span_col.push(0); self.span_file.push(""); self.span_length.push(0)
        self.span_capacity = target

    me reserve_span(span: Span) -> i64:
        if not self.mutable(): self.fail("HIR destination span reservation after freeze"); return -1
        val i = self.span_count
        self.ensure_span_capacity(i + 1)
        self.span_start[i] = span.start; self.span_end[i] = span.end; self.span_line[i] = span.line
        self.span_col[i] = span.col; self.span_file[i] = span.file; self.span_length[i] = span.length
        self.span_count = i + 1
        i

    me reserve_range(kind: i64, subtype: i64, count: i64) -> i64:
        if not self.mutable() or kind < HD_RANGE_EXPR or kind > HD_RANGE_BLOCK or count < 0 or (kind != HD_RANGE_AUX and subtype != HD_AUX_RANGE_NONE):
            self.fail("HIR destination range reservation rejected"); return -1
        if kind == HD_RANGE_AUX and (subtype < HD_AUX_RANGE_INTERPOLATION or subtype > HD_AUX_RANGE_MODULE_SURFACE): self.fail("HIR destination auxiliary range subtype rejected"); return -1
        val handle = self.range_count; val descriptor_required = handle + 1
        if descriptor_required > self.range_capacity:
            val target = self.next_capacity(self.range_capacity, descriptor_required)
            while self.range_kind.len() < target:
                self.range_kind.push(0); self.range_subtype.push(0); self.range_generation.push(-1)
                self.range_start.push(0); self.range_len.push(0); self.range_published.push(false)
            self.range_capacity = target
