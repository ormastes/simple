        while slot < slot_required: self.range_value[slot] = -1; self.range_ready[slot] = false; slot = slot + 1
        self.range_kind[handle] = kind; self.range_subtype[handle] = subtype; self.range_generation[handle] = self.generation
        self.range_start[handle] = start; self.range_len[handle] = count; self.range_published[handle] = false
        self.range_count = descriptor_required; self.range_slot_count = slot_required
        handle

    me index_ready(kind: i64, value: i64) -> bool:
        if kind == HD_RANGE_EXPR: return value >= 0 and value < self.expr_count and self.expr_ready[value]
        if kind == HD_RANGE_STMT: return value >= 0 and value < self.stmt_count and self.stmt_ready[value]
        if kind == HD_RANGE_TYPE: return value >= 0 and value < self.type_count and self.type_ready[value]
        if kind == HD_RANGE_PATTERN: return value >= 0 and value < self.pattern_count and self.pattern_ready[value]
        if kind == HD_RANGE_EFFECT: return value >= 0 and value < self.effect_count and self.effect_ready[value]
        if kind == HD_RANGE_DIM: return value >= 0 and value < self.dim_count and self.dim_ready[value]
        if kind == HD_RANGE_AUX: return value >= 0 and value < self.aux_count and self.aux_ready[value]
        if kind == HD_RANGE_TOKEN: return value >= 0 and value < self.pending_count and self.pending_ready[value]
        if kind == HD_RANGE_BLOCK: return value >= 0 and value < self.block_count and self.block_ready[value]
        false

    me aux_shape_matches_subtype(subtype: i64, value: i64) -> bool:
        if not self.index_ready(HD_RANGE_AUX, value): return false
        val shape = self.aux_shape[value]
        if subtype == HD_AUX_RANGE_INTERPOLATION: return shape == HD_AUX_INTERPOLATION
        if subtype == HD_AUX_RANGE_CALL_ARG: return shape == HD_AUX_CALL_ARG
        if subtype == HD_AUX_RANGE_NAMED_EXPR: return shape == HD_AUX_NAMED_EXPR
        if subtype == HD_AUX_RANGE_DICT_ENTRY: return shape == HD_AUX_DICT_ENTRY
        if subtype == HD_AUX_RANGE_IF_ARM: return shape == HD_AUX_IF_ARM
        if subtype == HD_AUX_RANGE_MATCH_ARM: return shape == HD_AUX_MATCH_ARM
        if subtype == HD_AUX_RANGE_CATCH: return shape == HD_AUX_CATCH
        if subtype == HD_AUX_RANGE_WITH_ITEM: return shape == HD_AUX_WITH_ITEM
        if subtype == HD_AUX_RANGE_COMP_CLAUSE: return shape == HD_AUX_COMP_FOR or shape == HD_AUX_COMP_IF
        if subtype == HD_AUX_RANGE_ASM_CONSTRAINT: return shape == HD_AUX_ASM_CONSTRAINT
        if subtype == HD_AUX_RANGE_ASM_ARM: return shape == HD_AUX_ASM_ARM
        if subtype == HD_AUX_RANGE_TEXT: return shape == HD_AUX_TEXT
        if subtype == HD_AUX_RANGE_SYMBOL_REF: return shape == HD_AUX_SYMBOL_REF
        if subtype == HD_AUX_RANGE_CUSTOM: return shape == HD_AUX_CUSTOM_VALUE
        if subtype == HD_AUX_RANGE_FUNCTION_METADATA: return shape == HD_AUX_FUNCTION_ATTR or shape == HD_AUX_EXPORT_ATTR or shape == HD_AUX_DRIVER_MANIFEST or shape == HD_AUX_VHDL_METADATA or shape == HD_AUX_DOC or shape == HD_AUX_GPU or shape == HD_AUX_CONTRACT or shape == HD_AUX_GENERIC_TEMPLATE
        if subtype == HD_AUX_RANGE_NAMED_PATTERN: return shape == HD_AUX_NAMED_PATTERN
        if subtype == HD_AUX_RANGE_VHDL_GENERIC: return shape == HD_AUX_VHDL_GENERIC
        if subtype == HD_AUX_RANGE_VHDL_RETURN: return shape == HD_AUX_VHDL_RETURN
        if subtype == HD_AUX_RANGE_CONTRACT_CLAUSE: return shape == HD_AUX_CONTRACT_CLAUSE
        if subtype == HD_AUX_RANGE_TYPE_PARAM: return shape == HD_AUX_TYPE_PARAM
        if subtype == HD_AUX_RANGE_VALUE_PARAM: return shape == HD_AUX_PARAM
        if subtype == HD_AUX_RANGE_ASM_VERSION: return shape == HD_AUX_ASM_VERSION
        if subtype == HD_AUX_RANGE_MODULE_IMPORT: return shape == HD_AUX_MODULE_IMPORT
        if subtype == HD_AUX_RANGE_MODULE_EXPORT: return shape == HD_AUX_MODULE_EXPORT
        if subtype == HD_AUX_RANGE_MODULE_SURFACE: return shape == HD_AUX_SYMBOL_REF
        false

    me set_range_at(handle: i64, subtype: i64, offset: i64, value: i64) -> bool:
        if not self.mutable() or handle < 0 or handle >= self.range_count or self.range_generation[handle] != self.generation or self.range_published[handle] or self.range_subtype[handle] != subtype or offset < 0 or offset >= self.range_len[handle]:
            return self.fail("HIR destination range slot is not writable")
        val slot = self.range_start[handle] + offset
        if self.range_ready[slot] or not self.index_ready(self.range_kind[handle], value): return self.fail("HIR destination range value is not ready")
        if self.range_kind[handle] == HD_RANGE_AUX and not self.aux_shape_matches_subtype(subtype, value): return self.fail("HIR destination auxiliary range shape mismatch")
        self.range_value[slot] = value; self.range_ready[slot] = true
        true

    me publish_range(handle: i64, kind: i64, subtype: i64) -> bool:
        if not self.mutable() or handle < 0 or handle >= self.range_count or self.range_generation[handle] != self.generation or self.range_kind[handle] != kind or self.range_subtype[handle] != subtype or self.range_published[handle]: return self.fail("HIR destination range publication rejected")
        var offset = 0
        while offset < self.range_len[handle]:
            if not self.range_ready[self.range_start[handle] + offset]: return self.fail("HIR destination range has unpublished slot")
            offset = offset + 1
        self.range_published[handle] = true
        true

    me range_is_ready_as(kind: i64, subtype: i64, handle: i64) -> bool:
        handle >= 0 and handle < self.range_count and self.range_generation[handle] == self.generation and self.range_kind[handle] == kind and self.range_subtype[handle] == subtype and self.range_published[handle]

    me range_matches(kind: i64, subtype: i64, handle: i64, count: i64) -> bool:
        self.range_is_ready_as(kind, subtype, handle) and self.range_len[handle] == count

    me range_is_ready(kind: i64, handle: i64, count: i64) -> bool:
        if handle < 0 or handle >= self.range_count: return false
        self.range_is_ready_as(kind, if kind == HD_RANGE_AUX: self.range_subtype[handle] else: HD_AUX_RANGE_NONE, handle) and self.range_len[handle] == count

    me range_value_at(handle: i64, subtype: i64, offset: i64) -> i64:
        if handle < 0 or handle >= self.range_count: return -1
        if not self.range_is_ready_as(self.range_kind[handle], subtype, handle) or offset < 0 or offset >= self.range_len[handle]: return -1
        val slot = self.range_start[handle] + offset
        if self.range_ready[slot]: self.range_value[slot] else: -1

    me reserve_pending_function(root_block: i64) -> i64:
        if not self.mutable() or root_block < 0 or root_block >= self.block_count or not self.block_ready[root_block]:
            self.fail("HIR destination pending function root is not ready"); return -1
        val i = self.pending_count
        if i + 1 > self.pending_capacity:
            val target = self.next_capacity(self.pending_capacity, i + 1)
            while self.pending_ready.len() < target:
                self.pending_ready.push(false); self.pending_active.push(false); self.pending_released.push(false)
                self.pending_generation.push(-1); self.pending_root.push(-1); self.pending_function.push(-1)
            self.pending_capacity = target
        self.pending_active[i] = false; self.pending_released[i] = false
        self.pending_generation[i] = self.generation; self.pending_root[i] = root_block; self.pending_function[i] = -1
        self.pending_ready[i] = true; self.pending_count = i + 1
        i

    me release_function(token: i64, generation: i64) -> bool:
        if token < 0 or token >= self.pending_count or not self.pending_ready[token]: return false
        if not self.pending_active[token] or self.pending_released[token]: return false
        if generation != self.generation or self.pending_generation[token] != generation: return false
        self.pending_released[token] = true; self.active_function_count = self.active_function_count - 1
        true

    # Terminal compile commit. Validate the complete token/function bijection
    # before changing a bit, then apply an infallible O(F) state transition.
    # This keeps later compiler failure diagnostic-safe: callers either retain
    # every active receipt or consume the complete generation, never a prefix.
    me release_all_functions_terminal(generation: i64,
            expected_function_count: i64) -> bool:
        if (not self.ready or generation != self.generation or
            expected_function_count < 0 or
            self.pending_count != expected_function_count or
            self.function_count != expected_function_count or
            self.active_function_count != expected_function_count):
            return false
        var token = 0
        while token < self.pending_count:
            if (not self.pending_ready[token] or
                not self.pending_active[token] or self.pending_released[token] or
                self.pending_generation[token] != generation):
                return false
            val function_index = self.pending_function[token]
            if (function_index < 0 or function_index >= self.function_count or
                self.function_token[function_index] != token or
                not self.function_module_published[function_index]):
                return false
            token = token + 1
        token = 0
        while token < self.pending_count:
            self.pending_released[token] = true
            token = token + 1
        self.active_function_count = 0
        true

    me reserve_checkpoint() -> i64:
        if not self.mutable() or self.block_values.active_projection != -1: self.fail("HIR checkpoint rejected during BlockValue projection"); return -1
        val i = self.checkpoint_count
        if i + 1 > self.checkpoint_capacity:
            val target = self.next_capacity(self.checkpoint_capacity, i + 1)
            while self.checkpoint_span.len() < target:
                self.checkpoint_span.push(0); self.checkpoint_expr.push(0); self.checkpoint_block.push(0); self.checkpoint_stmt.push(0)
                self.checkpoint_type.push(0); self.checkpoint_pattern.push(0); self.checkpoint_effect.push(0); self.checkpoint_dim.push(0)
                self.checkpoint_aux.push(0); self.checkpoint_range.push(0); self.checkpoint_range_slot.push(0)
                self.checkpoint_pending.push(0); self.checkpoint_function.push(0); self.checkpoint_module.push(0)
                self.checkpoint_module_validation_epoch.push(0)
                self.checkpoint_finalized_module.push(-1); self.checkpoint_module_ready.push(false)
                self.checkpoint_module_function_roots.push(-1); self.checkpoint_module_function_tokens.push(-1)
                self.checkpoint_module_imports.push(-1); self.checkpoint_module_exports.push(-1)
                self.checkpoint_module_surface_refs.push(-1)
                self.checkpoint_module_declaration_count.push(0)
                self.checkpoint_module_extension_count.push(0)
                self.checkpoint_diagnostic.push(0); self.checkpoint_float_payload.push(0)
                self.checkpoint_bv.push(0); self.checkpoint_bv_codec.push(0); self.checkpoint_bv_projection.push(0); self.checkpoint_bv_error.push(false)
                self.checkpoint_symbol.push(0); self.checkpoint_symbol_error.push(false)
                self.checkpoint_member.push(0); self.checkpoint_staged_member.push(0); self.checkpoint_member_error.push(false)
                self.checkpoint_module_authority.push(0); self.checkpoint_module_text_range.push(0)
                self.checkpoint_module_text.push(0); self.checkpoint_module_authority_error.push(false)
                self.checkpoint_error_diagnostic.push(-1); self.checkpoint_generation.push(-1)
                self.checkpoint_declaration.push(-1)
                self.checkpoint_declaration_metadata.push(-1); self.checkpoint_declaration_metadata_error.push(false)
            self.checkpoint_capacity = target
        self.checkpoint_span[i] = self.span_count; self.checkpoint_expr[i] = self.expr_count
        self.checkpoint_block[i] = self.block_count; self.checkpoint_stmt[i] = self.stmt_count
        self.checkpoint_type[i] = self.type_count; self.checkpoint_pattern[i] = self.pattern_count
        self.checkpoint_effect[i] = self.effect_count; self.checkpoint_dim[i] = self.dim_count
        self.checkpoint_aux[i] = self.aux_count; self.checkpoint_range[i] = self.range_count
        self.checkpoint_range_slot[i] = self.range_slot_count; self.checkpoint_pending[i] = self.pending_count
        self.checkpoint_function[i] = self.function_count; self.checkpoint_module[i] = self.module_count
        self.checkpoint_module_validation_epoch[i] = self.module_validation_epoch
        self.checkpoint_finalized_module[i] = -1
        self.checkpoint_diagnostic[i] = self.diagnostic_count; self.checkpoint_float_payload[i] = self.float_payload_count
        self.checkpoint_bv[i] = self.block_values.count; self.checkpoint_bv_codec[i] = self.block_values.codec_count
        self.checkpoint_bv_projection[i] = self.block_values.projection_count; self.checkpoint_bv_error[i] = self.block_values.error
        self.checkpoint_symbol[i] = self.destination_symbols.count; self.checkpoint_symbol_error[i] = self.destination_symbols.error
        self.checkpoint_member[i]=self.destination_members.count
        self.checkpoint_staged_member[i]=self.destination_members.staged_count
        self.checkpoint_member_error[i]=self.destination_members.error
        self.checkpoint_module_authority[i]=self.destination_module_authority.count
        self.checkpoint_module_text_range[i]=self.destination_module_authority.range_count
        self.checkpoint_module_text[i]=self.destination_module_authority.text_count
        self.checkpoint_module_authority_error[i]=self.destination_module_authority.error
        self.checkpoint_declaration[i]=self.destination_declarations.reserve_checkpoint()
        if self.checkpoint_declaration[i] < 0: return self.fail("HIR destination declaration checkpoint rejected")
        self.checkpoint_declaration_metadata[i]=self.declaration_metadata.checkpoint_count_snapshot()
        self.checkpoint_declaration_metadata_error[i]=self.declaration_metadata.checkpoint_error_snapshot()
        if self.checkpoint_declaration_metadata[i] < 0: return self.fail("HIR destination declaration metadata checkpoint rejected")
        self.checkpoint_error_diagnostic[i] = self.error_diagnostic; self.checkpoint_generation[i] = self.generation
        self.checkpoint_count = i + 1; i

    # Publish a successful checkpoint suffix. Checkpoint rows are reusable
    # scratch metadata; committing changes only the active LIFO depth.
    me commit_checkpoint(i: i64) -> bool:
        if not self.mutable() or i < 0 or i != self.checkpoint_count - 1: return false
        if self.checkpoint_generation[i] != self.generation: return false
        if not self.destination_declarations.commit_checkpoint(self.checkpoint_declaration[i]): return false
        self.checkpoint_count = i
        true

    me rollback_checkpoint(i: i64) -> bool:
        if self.ready or i < 0 or i != self.checkpoint_count - 1: return false
        if self.block_values.active_projection != -1: return false
        if self.checkpoint_generation[i] != self.generation: return false
        # Validate every independently-owned store before changing any owner.
        # The subsequent rollback calls are infallible while this serialized
        # graph owner retains the lease and no store state can interleave.
        if not self.block_values.can_rollback(self.checkpoint_bv[i], self.checkpoint_bv_codec[i], self.checkpoint_bv_projection[i]): return false
        if not self.destination_symbols.can_rollback(self.checkpoint_symbol[i]): return false
        if not self.destination_members.can_rollback(self.checkpoint_member[i], self.checkpoint_staged_member[i]): return false
        if not self.destination_module_authority.can_rollback(self.checkpoint_module_authority[i], self.checkpoint_module_text_range[i], self.checkpoint_module_text[i]): return false
        if not self.destination_declarations.can_rollback_checkpoint(self.checkpoint_declaration[i]): return false
        if self.declaration_metadata.frozen or self.checkpoint_declaration_metadata[i] < 0 or self.checkpoint_declaration_metadata[i] > self.declaration_metadata.log_count: return false
        var function_index = self.checkpoint_function[i]
        while function_index < self.function_count:
            val module_index = self.function_module[function_index]
            if module_index >= 0 and module_index < self.checkpoint_module[i] and self.module_reserved_function_count[module_index] > 0:
                self.module_reserved_function_count[module_index] = self.module_reserved_function_count[module_index] - 1
            self.function_module_published[function_index] = false
            self.function_module_validation_epoch[function_index] = -1
            function_index = function_index + 1
        self.span_count = self.checkpoint_span[i]; self.expr_count = self.checkpoint_expr[i]
        self.block_count = self.checkpoint_block[i]; self.stmt_count = self.checkpoint_stmt[i]
        self.type_count = self.checkpoint_type[i]; self.pattern_count = self.checkpoint_pattern[i]
        self.effect_count = self.checkpoint_effect[i]; self.dim_count = self.checkpoint_dim[i]
        self.aux_count = self.checkpoint_aux[i]; self.range_count = self.checkpoint_range[i]
        self.range_slot_count = self.checkpoint_range_slot[i]; self.pending_count = self.checkpoint_pending[i]
        self.function_count = self.checkpoint_function[i]; self.module_count = self.checkpoint_module[i]; self.diagnostic_count = self.checkpoint_diagnostic[i]
        self.float_payload_count = self.checkpoint_float_payload[i]; self.error_diagnostic = self.checkpoint_error_diagnostic[i]
        self.module_validation_epoch = self.checkpoint_module_validation_epoch[i]
        val finalized_module = self.checkpoint_finalized_module[i]
        if finalized_module >= 0 and finalized_module < self.checkpoint_module[i]:
            self.module_ready[finalized_module] = self.checkpoint_module_ready[i]
            self.module_function_roots[finalized_module] = self.checkpoint_module_function_roots[i]
            self.module_function_tokens[finalized_module] = self.checkpoint_module_function_tokens[i]
            self.module_imports[finalized_module] = self.checkpoint_module_imports[i]
            self.module_exports[finalized_module] = self.checkpoint_module_exports[i]
            self.module_surface_refs[finalized_module] = self.checkpoint_module_surface_refs[i]
            self.module_declaration_count[finalized_module] = self.checkpoint_module_declaration_count[i]
            self.module_extension_count[finalized_module] = self.checkpoint_module_extension_count[i]
        if not self.block_values.rollback(self.checkpoint_bv[i], self.checkpoint_bv_codec[i], self.checkpoint_bv_projection[i], self.checkpoint_bv_error[i]): return false
        if not self.destination_symbols.rollback(self.checkpoint_symbol[i], self.checkpoint_symbol_error[i]): return false
        if not self.destination_members.rollback(self.checkpoint_member[i],self.checkpoint_staged_member[i],self.checkpoint_member_error[i]): return false
        if not self.destination_module_authority.rollback(self.checkpoint_module_authority[i],self.checkpoint_module_text_range[i],self.checkpoint_module_text[i],self.checkpoint_module_authority_error[i]): return false
        if not self.destination_declarations.rollback_checkpoint(self.checkpoint_declaration[i]): return false
        if not self.declaration_metadata.rollback(self.checkpoint_declaration_metadata[i],self.checkpoint_declaration_metadata_error[i]): return false
        self.checkpoint_count = i; true

    me recover_unpublished_or_poison(i: i64, message: text) -> bool:
        # ROLLBACK-DIAGNOSTIC-CONTRACT: successful suffix recovery deliberately
        # returns false without retaining `message`; the outer lowering owner
        # must attach that stable diagnostic to its caller-visible result.
        if i >= 0 and i == self.checkpoint_count - 1 and self.rollback_checkpoint(i): return false
        self.fail(message)

    # Guarded scalar consumer surface. Raw columns are owner-private by source
    # contract; downstream indexed consumers use these generation receipts.
    me span_valid(i: i64, generation: i64) -> bool: generation == self.generation and i >= 0 and i < self.span_count
    me span_start_at(i: i64, generation: i64) -> i64: if self.span_valid(i, generation): self.span_start[i] else: -1
    me span_end_at(i: i64, generation: i64) -> i64: if self.span_valid(i, generation): self.span_end[i] else: -1
    me span_line_at(i: i64, generation: i64) -> i64: if self.span_valid(i, generation): self.span_line[i] else: -1
    me span_col_at(i: i64, generation: i64) -> i64: if self.span_valid(i, generation): self.span_col[i] else: -1
    me span_file_at(i: i64, generation: i64) -> text: if self.span_valid(i, generation): self.span_file[i] else: ""
    me span_length_at(i: i64, generation: i64) -> i64: if self.span_valid(i, generation): self.span_length[i] else: -1
    me expr_i64_at(i: i64, column: i64) -> i64:
        if not self.index_ready(HD_RANGE_EXPR, i): return -1
        if column == 0: self.expr_i0[i] else if column == 1: self.expr_i1[i] else if column == 2: self.expr_i2[i] else if column == 3: self.expr_i3[i] else: -1
    me expr_bool_at(i: i64, column: i64) -> bool: self.index_ready(HD_RANGE_EXPR, i) and (if column == 0: self.expr_b0[i] else if column == 1: self.expr_b1[i] else if column == 2: self.expr_b2[i] else if column == 3: self.expr_b3[i] else: false)
    me expr_range_has_start_at(i: i64) -> bool: self.index_ready(HD_RANGE_EXPR,i) and self.expr_shape[i] == HD_EXPR_RANGE and self.expr_b2[i]
    me expr_range_has_end_at(i: i64) -> bool: self.index_ready(HD_RANGE_EXPR,i) and self.expr_shape[i] == HD_EXPR_RANGE and self.expr_b3[i]
    me expr_text_at(i: i64, column: i64) -> text: if not self.index_ready(HD_RANGE_EXPR, i): "" else if column == 0: self.expr_t0[i] else if column == 1: self.expr_t1[i] else: ""
    me expr_span_at(i: i64) -> i64: if self.index_ready(HD_RANGE_EXPR, i): self.expr_span[i] else: -1
    me expr_diagnostic_at(i: i64) -> i64: if i >= 0 and i < self.expr_count: self.expr_diagnostic[i] else: -1
    me expr_payload_at(i: i64) -> i64: if self.index_ready(HD_RANGE_EXPR, i): self.expr_payload[i] else: -1
    me expr_type_at(i: i64) -> i64: if self.index_ready(HD_RANGE_EXPR, i) and self.expr_has_type[i]: self.expr_type[i] else: -1
    me expr_range_at(i: i64, secondary: bool) -> i64: if not self.index_ready(HD_RANGE_EXPR, i): -1 else if secondary: self.expr_r1_start[i] else: self.expr_r0_start[i]
    me aux_shape_at(i: i64) -> i64: if self.index_ready(HD_RANGE_AUX, i): self.aux_shape[i] else: 0
    me aux_i64_at(i: i64, column: i64) -> i64:
        if not self.index_ready(HD_RANGE_AUX, i): return -1
        if column == 0: self.aux_i0[i] else if column == 1: self.aux_i1[i] else if column == 2: self.aux_i2[i] else if column == 3: self.aux_i3[i] else if column == 4: self.aux_i4[i] else if column == 5: self.aux_i5[i] else: -1
    me aux_bool_at(i: i64, column: i64) -> bool: self.index_ready(HD_RANGE_AUX, i) and (if column == 0: self.aux_b0[i] else if column == 1: self.aux_b1[i] else: false)
    me aux_text_at(i: i64, column: i64) -> text: if not self.index_ready(HD_RANGE_AUX, i): "" else if column == 0: self.aux_t0[i] else if column == 1: self.aux_t1[i] else: ""
    me aux_range_at(i: i64) -> i64: if self.index_ready(HD_RANGE_AUX, i): self.aux_r0_start[i] else: -1
    me aux_span_at(i: i64) -> i64: if self.index_ready(HD_RANGE_AUX, i): self.aux_span[i] else: -1
    me range_valid(handle: i64, generation: i64) -> bool: generation == self.generation and handle >= 0 and handle < self.range_count and self.range_generation[handle] == generation
    me range_kind_at(handle: i64, generation: i64) -> i64: if self.range_valid(handle, generation): self.range_kind[handle] else: 0
    me range_subtype_at(handle: i64, generation: i64) -> i64: if self.range_valid(handle, generation): self.range_subtype[handle] else: 0
    me range_length_at(handle: i64, generation: i64) -> i64: if self.range_valid(handle, generation): self.range_len[handle] else: -1
    me range_published_at(handle: i64, generation: i64) -> bool: self.range_valid(handle, generation) and self.range_published[handle]
    me token_active_at(token: i64, generation: i64) -> bool: token >= 0 and token < self.pending_count and generation == self.generation and self.pending_generation[token] == generation and self.pending_ready[token] and self.pending_active[token] and not self.pending_released[token]
    me token_root_at(token: i64, generation: i64) -> i64: if self.token_active_at(token, generation): self.pending_root[token] else: -1
    me token_released_at(token: i64, generation: i64) -> bool: token >= 0 and token < self.pending_count and generation == self.generation and self.pending_generation[token] == generation and self.pending_released[token]
    me diagnostic_at(i: i64) -> text: if i >= 0 and i < self.diagnostic_count: self.diagnostic_text[i] else: ""
    me graph_error() -> text: self.diagnostic_at(self.error_diagnostic)

