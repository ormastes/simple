# Type aliases retain parser templates until their arguments are known. Their
# expansion produces the underlying HIR shape, never a nominal alias symbol.
use compiler.hir.hir_lowering.types.{HirLowering, HirNominalTypeTemplate}
use compiler.hir.hir_types.*
use compiler.frontend.parser_types.{ParserTypeParam}
use compiler.frontend.parser_types_expr.{Type, TypeKind, parser_type_written_any_spans_v1, parser_type_named_dependencies}
use compiler.common.diagnostics.span.{Span}

# Inspect the declaration template, before substituting caller-owned arguments.
# A legacy identity alias may forward a checked actual argument safely; a
# legacy template must not manufacture checked ownership from its own sigils.
fn alias_template_has_ownership(type_: Type) -> bool:
    match type_.kind:
        case TypeKind.Unique(_): return true
        case TypeKind.Shared(_): return true
        case TypeKind.Weak(_): return true
        case TypeKind.Named(_, arguments):
            for argument in arguments:
                if alias_template_has_ownership(argument): return true
        case TypeKind.Tuple(elements):
            for element in elements:
                if alias_template_has_ownership(element): return true
        case TypeKind.Union(elements):
            for element in elements:
                if alias_template_has_ownership(element): return true
        case TypeKind.Function(parameters, result):
            for parameter in parameters:
                if alias_template_has_ownership(parameter): return true
            return alias_template_has_ownership(result)
        case TypeKind.Array(inner, _): return alias_template_has_ownership(inner)
        case TypeKind.Optional(inner): return alias_template_has_ownership(inner)
        case TypeKind.Reference(inner, _): return alias_template_has_ownership(inner)
        case TypeKind.Pointer(inner, _): return alias_template_has_ownership(inner)
        case TypeKind.Atomic(inner): return alias_template_has_ownership(inner)
        case TypeKind.Isolated(inner): return alias_template_has_ownership(inner)
        case TypeKind.Projection(inner, _): return alias_template_has_ownership(inner)
        case _: pass
    false

fn unavailable_default_parameter(type_: Type, parameters: [ParserTypeParam], bound_count: i64) -> text:
    # A current/later formal shadows a same-named module declaration too.
    # Reject its use before name resolution can capture that declaration or
    # turn an unbound single-letter name into the legacy Any fallback.
    for dependency in parser_type_named_dependencies(type_):
        for index in bound_count..parameters.len():
            val name = parameters[index].name
            if dependency == name or dependency == "has_{name}" or dependency.starts_with("{name}."):
                return name
    ""

impl HirLowering:
    me register_nominal_type_template(symbol_id: SymbolId, parameters: [ParserTypeParam], owner: text):
        if self.nominal_type_templates.contains_key(symbol_id.id):
            return
        self.nominal_type_templates[symbol_id.id] = HirNominalTypeTemplate(
            parameters: parameters, owner: owner, scope: self.symbols.current_scope)

    me lower_alias_template_type(target: Type) -> HirType:
        val owner = self.type_alias_current_owner
        if self.nogc_strict and owner != "" and owner != self.module_filename and alias_template_has_ownership(target):
            val owner_index = if self.module_surfaces.index_by_name.contains_key(owner): self.module_surfaces.index_by_name[owner] else: -1
            if owner_index < 0 or owner_index >= self.module_surfaces.surfaces.len():
                self.error("NOGC-FOREIGN-001: ownership contract unavailable for imported alias module `{owner}`", target.span)
                return HirType(kind: HirTypeKind.Error, span: target.span)
            if not self.module_surfaces.surfaces[owner_index].nogc_strict:
                self.error("NOGC-FOREIGN-001: unchecked ownership sigil from legacy alias module `{owner}`; use an explicit checked boundary", target.span)
                return HirType(kind: HirTypeKind.Error, span: target.span)
        self.lower_type(target)

    fn type_alias_position(symbol_id: SymbolId) -> i64:
        if symbol_id.id < 0 or symbol_id.id >= self.type_alias_positions.len():
            return -1
        self.type_alias_positions[symbol_id.id]

    me register_type_alias_template(symbol_id: SymbolId, target: Type, parameters: [ParserTypeParam], owner: text):
        if self.type_alias_position(symbol_id) >= 0:
            return
        if symbol_id.id < 0 or symbol_id.id >= self.symbols.next_symbol_id:
            self.error("invalid type alias symbol", target.span)
            return
        # Type aliases are declarations, not use-site annotations. Never let
        # an enclosing expression's type_erasure grant hide Any in a template.
        val alias_name = self.symbols.symbols[symbol_id.id].name
        var written_any_spans = parser_type_written_any_spans_v1(target)
        for parameter in parameters:
            if parameter.has_default:
                for default_span in parser_type_written_any_spans_v1(parameter.default):
                    written_any_spans = written_any_spans.push(default_span)
        for written_any_span in written_any_spans:
            if self.forbid_written_any:
                self.error("[E-ANY-COMPILE-001] type alias `{alias_name}` declared by `{owner}` uses Any outside `unsafe(capabilities: [type_erasure])`; use a generic `<T>`, a concrete type, or a closed enum", written_any_span)
            else:
                self.warning("[W-ANY-COMPILE-001] type alias `{alias_name}` declared by `{owner}` uses Any in safe code; use a generic `<T>`, a concrete type, or an explicit `unsafe(capabilities: [type_erasure])` boundary", written_any_span)
        while self.type_alias_positions.len() <= symbol_id.id:
            self.type_alias_positions = self.type_alias_positions.push(-1)
        self.type_alias_positions[symbol_id.id] = self.type_alias_symbol_ids.len()
        self.type_alias_symbol_ids = self.type_alias_symbol_ids.push(symbol_id.id)
        self.type_alias_targets = self.type_alias_targets.push(target)
        self.type_alias_parameters = self.type_alias_parameters.push(parameters)
        self.type_alias_owners = self.type_alias_owners.push(owner)
        self.type_alias_scopes = self.type_alias_scopes.push(self.symbols.current_scope)

    me lower_named_symbol_kind(symbol_id: SymbolId, arguments: [HirType], span: Span) -> HirTypeKind:
        if self.prescan_type_parameters.contains_key(symbol_id.id):
            if arguments.len() > 0:
                self.error("type parameter cannot take type arguments", span)
                return HirTypeKind.Error
            return self.prescan_type_parameters[symbol_id.id].kind
        val position = self.type_alias_position(symbol_id)
        val is_alias = position >= 0
        if not is_alias and not self.nominal_type_templates.contains_key(symbol_id.id):
            return HirTypeKind.Named(symbol_id, arguments)
        var parameters: [ParserTypeParam] = []
        var owner = ""
        var declaration_scope = self.symbols.current_scope
        if is_alias:
            parameters = self.type_alias_parameters[position]
            owner = self.type_alias_owners[position]
            declaration_scope = self.type_alias_scopes[position]
        else:
            val template: HirNominalTypeTemplate = self.nominal_type_templates[symbol_id.id]
            parameters = template.parameters
            owner = template.owner
            declaration_scope = template.scope
        for active_id in self.type_alias_active_ids:
            if active_id == symbol_id.id and (is_alias or arguments.len() < parameters.len()):
                val label = if is_alias: "type alias" else: "generic defaults for"
                self.error("cyclic {label} `{self.symbols.symbols[symbol_id.id].name}`", span)
                return HirTypeKind.Error
        val declaration_label = if is_alias: "type alias" else: "type `{self.symbols.symbols[symbol_id.id].name}`"
        if arguments.len() > parameters.len():
            self.error("{declaration_label} expects {parameters.len()} type arguments, got {arguments.len()}", span)
            return HirTypeKind.Error
        var required_index = arguments.len()
        while required_index < parameters.len():
            if not parameters[required_index].has_default:
                self.error("{declaration_label} expects {parameters.len()} type arguments, got {arguments.len()}", span)
                return HirTypeKind.Error
            val unavailable = unavailable_default_parameter(parameters[required_index].default, parameters, required_index)
            if unavailable != "":
                self.error("default for type parameter `{parameters[required_index].name}` refers to unavailable type parameter `{unavailable}`; defaults may refer only to earlier parameters", span)
                return HirTypeKind.Error
            required_index = required_index + 1
        if not is_alias and arguments.len() == parameters.len():
            return HirTypeKind.Named(symbol_id, arguments)

        # Each expansion owns its frame. A nested alias cannot accidentally
        # capture a formal from the caller; defaults can use earlier formals.
        val saved_names = self.type_alias_argument_names
        val saved_types = self.type_alias_argument_types
        val saved_owner = self.type_alias_current_owner
        val saved_scope = self.symbols.current_scope
        val saved_active = self.type_alias_active_ids
        self.type_alias_argument_names = []
        self.type_alias_argument_types = []
        self.type_alias_current_owner = owner
        self.symbols.current_scope = declaration_scope
        var active_frame: [i64] = []
        for active_id in saved_active:
            active_frame = active_frame.push(active_id)
        self.type_alias_active_ids = active_frame.push(symbol_id.id)
        var index = 0
        while index < parameters.len():
            val argument = if index < arguments.len(): arguments[index] else: self.lower_alias_template_type(parameters[index].default)
            self.type_alias_argument_names = self.type_alias_argument_names.push(parameters[index].name)
            self.type_alias_argument_types = self.type_alias_argument_types.push(argument)
            index = index + 1
        val expanded = if is_alias:
            self.lower_alias_template_type(self.type_alias_targets[position])
        else:
            HirType(kind: HirTypeKind.Named(symbol_id, self.type_alias_argument_types), span: span)
        self.type_alias_argument_names = saved_names
        self.type_alias_argument_types = saved_types
        self.type_alias_current_owner = saved_owner
        self.symbols.current_scope = saved_scope
        self.type_alias_active_ids = saved_active
        expanded.kind
