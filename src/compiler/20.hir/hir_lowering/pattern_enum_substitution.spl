"""Declaration-scoped substitution for enum pattern payload ownership.

The caller proves declaration/subject owner identity and formal/actual arity.
Unknown binders and unresolved types produce Error; no nominal name guessing.
"""
use compiler.hir.hir_types.{HirType, HirTypeKind}
use compiler.hir.hir_lowering.types.{HirDeclaredPatternEnumSlots}
use compiler.frontend.parser_types_expr.{EnumPatternPayload, Pattern, PatternKind}
use compiler.common.diagnostics.span.{Span}

pub fn declared_pattern_slot_type_is_concrete(type_: HirType) -> bool:
    if type_ == nil:
        return false
    match type_.kind:
        case HirTypeKind.Infer(_, _) | HirTypeKind.Error | HirTypeKind.TypeParam(_, _) | HirTypeKind.Any | HirTypeKind.Projection(_, _): false
        case HirTypeKind.Array(inner, _) | HirTypeKind.Slice(inner) | HirTypeKind.Optional(inner) | HirTypeKind.Isolated(inner) | HirTypeKind.Unique(inner) | HirTypeKind.Shared(inner) | HirTypeKind.Weak(inner):
            declared_pattern_slot_type_is_concrete(inner)
        case HirTypeKind.Ref(inner, _) | HirTypeKind.Ptr(inner, _): declared_pattern_slot_type_is_concrete(inner)
        case HirTypeKind.Dict(left, right) | HirTypeKind.Result(left, right):
            declared_pattern_slot_type_is_concrete(left) and declared_pattern_slot_type_is_concrete(right)
        case HirTypeKind.Tuple(elements) | HirTypeKind.Union(elements): declared_pattern_slot_types_are_concrete(elements)
        case HirTypeKind.Named(owner, args): owner.is_valid() and declared_pattern_slot_types_are_concrete(args)
        case HirTypeKind.Function(params, result, _): declared_pattern_slot_types_are_concrete(params) and declared_pattern_slot_type_is_concrete(result)
        case HirTypeKind.Tensor(inner, _, _): declared_pattern_slot_type_is_concrete(inner)
        case HirTypeKind.DynTrait(owner): owner.is_valid()
        case _: true

pub fn declared_pattern_slot_types_are_concrete(types: [HirType]) -> bool:
    for raw in types:
        val type_: HirType = raw
        if not declared_pattern_slot_type_is_concrete(type_):
            return false
    true

# A payload sub-pattern that binds nothing. The flat AST bridge lowers `_`
# inside an enum payload (`case P.Ready(_)`) to `Binding("_", false)`, not
# `Wildcard` (convert_nodes.spl, enum-call payload branch), so both spellings
# must count or the real frontend never reaches the untyped-subject admission.
pub fn declared_pattern_is_discard(pattern: Pattern) -> bool:
    match pattern.kind:
        case PatternKind.Wildcard: true
        case PatternKind.Binding(name, _): name == "_"
        case _: false

pub fn declared_pattern_payload_avoids_type_parameters(slots: HirDeclaredPatternEnumSlots, payload: EnumPatternPayload?) -> bool:
    """True when no payload binder would read a type-parameter slot.

    Wildcards bind nothing, so they pass over any slot. Anything else must
    land on a concrete declared slot. Used only for untyped match subjects.
    """
    if val input_payload = payload:
        match input_payload:
            case EnumPatternPayload.Tuple(patterns):
                var positional = slots.tuple_types
                if slots.is_struct:
                    positional = slots.field_types
                if patterns.len() != positional.len():
                    return false
                var index = 0
                while index < patterns.len():
                    if not declared_pattern_is_discard(patterns[index]) and not declared_pattern_slot_type_is_concrete(positional[index]):
                        return false
                    index = index + 1
                return true
            case EnumPatternPayload.Struct(fields):
                if not slots.is_struct:
                    return false
                for (field_name, field_pattern) in fields:
                    var found = false
                    var field_concrete = false
                    var index = 0
                    while index < slots.field_names.len():
                        if slots.field_names[index] == field_name:
                            found = true
                            field_concrete = declared_pattern_slot_type_is_concrete(slots.field_types[index])
                        index = index + 1
                    if not found:
                        return false
                    if not declared_pattern_is_discard(field_pattern) and not field_concrete:
                        return false
                return true
    true

pub fn substitute_declared_pattern_types(templates: [HirType], names: [text], actuals: [HirType]) -> [HirType]:
    var results: [HirType] = []
    for raw in templates:
        val template: HirType = raw
        results = results.push(substitute_declared_pattern_type(template, names, actuals))
    results

pub fn substitute_declared_pattern_type(template: HirType, names: [text], actuals: [HirType]) -> HirType:
    if template == nil:
        return HirType(kind: HirTypeKind.Error, span: Span.empty())
    val invalid = HirType(kind: HirTypeKind.Error, span: template.span)
    if names.len() != actuals.len() or not declared_pattern_slot_types_are_concrete(actuals):
        return invalid
    var name_index = 0
    while name_index < names.len():
        var earlier_index = 0
        while earlier_index < name_index:
            if names[earlier_index] == names[name_index]:
                return invalid
            earlier_index = earlier_index + 1
        name_index = name_index + 1
    val kind: HirTypeKind = match template.kind:
        case HirTypeKind.TypeParam(name, _):
            var index = 0
            while index < names.len():
                if names[index] == name:
                    if not declared_pattern_slot_type_is_concrete(actuals[index]):
                        return invalid
                    return actuals[index]
                index = index + 1
            return invalid
        case HirTypeKind.Unique(inner): HirTypeKind.Unique(substitute_declared_pattern_type(inner, names, actuals))
        case HirTypeKind.Shared(inner): HirTypeKind.Shared(substitute_declared_pattern_type(inner, names, actuals))
        case HirTypeKind.Weak(inner): HirTypeKind.Weak(substitute_declared_pattern_type(inner, names, actuals))
        case HirTypeKind.Ref(inner, mutable): HirTypeKind.Ref(substitute_declared_pattern_type(inner, names, actuals), mutable)
        case HirTypeKind.Ptr(inner, mutable): HirTypeKind.Ptr(substitute_declared_pattern_type(inner, names, actuals), mutable)
        case HirTypeKind.Isolated(inner): HirTypeKind.Isolated(substitute_declared_pattern_type(inner, names, actuals))
        case HirTypeKind.Optional(inner): HirTypeKind.Optional(substitute_declared_pattern_type(inner, names, actuals))
        case HirTypeKind.Array(inner, size): HirTypeKind.Array(substitute_declared_pattern_type(inner, names, actuals), size)
        case HirTypeKind.Slice(inner): HirTypeKind.Slice(substitute_declared_pattern_type(inner, names, actuals))
        case HirTypeKind.Dict(left, right): HirTypeKind.Dict(substitute_declared_pattern_type(left, names, actuals), substitute_declared_pattern_type(right, names, actuals))
        case HirTypeKind.Result(left, right): HirTypeKind.Result(substitute_declared_pattern_type(left, names, actuals), substitute_declared_pattern_type(right, names, actuals))
        case HirTypeKind.Tuple(elements): HirTypeKind.Tuple(substitute_declared_pattern_types(elements, names, actuals))
        case HirTypeKind.Union(elements): HirTypeKind.Union(substitute_declared_pattern_types(elements, names, actuals))
        case HirTypeKind.Named(owner, args): HirTypeKind.Named(owner, substitute_declared_pattern_types(args, names, actuals))
        case HirTypeKind.Function(params, result, effects): HirTypeKind.Function(substitute_declared_pattern_types(params, names, actuals), substitute_declared_pattern_type(result, names, actuals), effects)
        case HirTypeKind.Tensor(inner, dims, device): HirTypeKind.Tensor(substitute_declared_pattern_type(inner, names, actuals), dims, device)
        case HirTypeKind.Infer(_, _) | HirTypeKind.Error | HirTypeKind.Any | HirTypeKind.Projection(_, _): return invalid
        case _: template.kind
    HirType(kind: kind, span: template.span)
