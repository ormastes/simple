pub fn hdr_destination_member_i64(s: i64, g: i64, r: i64, c: i64) -> i64:
    if not hir_destination_registry_readable(s,g) or not _hir_destination_graphs[s].destination_members.valid(r,g): return -1
    if c==0: return _hir_destination_graphs[s].destination_members.module_index[r]
    if c==1: return _hir_destination_graphs[s].destination_members.owner_symbol[r]
    if c==2: return _hir_destination_graphs[s].destination_members.ordinal[r]
    if c==3: return _hir_destination_graphs[s].destination_members.symbol[r]
    if c==4: return _hir_destination_graphs[s].destination_members.type_index[r]
    if c==5: return _hir_destination_graphs[s].destination_members.default_expr[r]
    if c==6: return _hir_destination_graphs[s].destination_members.bits[r]
    if c==7: return _hir_destination_graphs[s].destination_members.fixed_address[r]
    if c==8: return _hir_destination_graphs[s].destination_members.span_index[r]
    -1
pub fn hdr_destination_member_name(s: i64, g: i64, r: i64) -> text: if hir_destination_registry_readable(s,g) and _hir_destination_graphs[s].destination_members.valid(r,g): _hir_destination_graphs[s].destination_members.name[r] else: ""
pub fn hdr_destination_member_bool(s: i64, g: i64, r: i64, c: i64) -> bool:
    if not hir_destination_registry_readable(s,g) or not _hir_destination_graphs[s].destination_members.valid(r,g): return false
    if c==0: return _hir_destination_graphs[s].destination_members.has_type[r]
    if c==1: return _hir_destination_graphs[s].destination_members.has_default[r]
    if c==2: return _hir_destination_graphs[s].destination_members.volatile_[r]
    if c==3: return _hir_destination_graphs[s].destination_members.has_fixed_address[r]
    if c==4: return _hir_destination_graphs[s].destination_members.has_bits_attr[r]
    false
