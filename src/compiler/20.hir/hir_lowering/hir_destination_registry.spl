    if not hir_destination_registry_building(s,g): return -1
    val row=_hir_destination_graphs[s].destination_module_authority.building_row(m,g); if row>=0: _hir_destination_graphs[s].destination_module_authority.facade_len[row] else: -1
pub fn hdw_destination_module_facade_at(s: i64, g: i64, m: i64, o: i64) -> text:
    if not hir_destination_registry_building(s,g): return ""
    val row=_hir_destination_graphs[s].destination_module_authority.building_row(m,g)
    if row<0 or o<0 or o>=_hir_destination_graphs[s].destination_module_authority.facade_len[row]: return ""
    _hir_destination_graphs[s].destination_module_authority.text_value[_hir_destination_graphs[s].destination_module_authority.facade_start[row]+o]
