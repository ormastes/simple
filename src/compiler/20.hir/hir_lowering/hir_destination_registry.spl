# Process-owned destination-graph lease registry.
#
# This registry is intentionally process-serialized. It is not a thread-safe
# container: upstream must route every BUILDING call through one HirLowering
# owner. Acquire rejects every second compile/acquire, while stale state/generation
# pairs fail closed. Scalar leases remain copyable and are not a synchronization
# primitive; a future parallel route must place a lock outside this module.
#
# The populated HirDestinationGraph value never leaves `_hir_destination_graphs`,
# is never rebound to a local, and is never assigned. Only scalar leases cross
# this boundary.
use compiler.hir.hir_lowering.hir_destination_graph.*
use compiler.hir.hir_lowering.hir_destination_expr_hot.*
use compiler.hir.hir_lowering.hir_destination_expr_payloads.*
use compiler.hir.hir_lowering.hir_destination_control.*
use compiler.hir.hir_lowering.hir_destination_blocks.*
use compiler.hir.hir_lowering.hir_destination_types_patterns.*
use compiler.hir.hir_lowering.hir_destination_function.*
use compiler.hir.hir_lowering.hir_destination_modules.*
use compiler.hir.hir_lowering.hir_destination_symbol_graph.*
use compiler.common.diagnostics.span.{Span}

const HD_REGISTRY_UNINITIALIZED: i64 = 0
const HD_REGISTRY_BUILDING: i64 = 1
const HD_REGISTRY_READ: i64 = 2
const HD_REGISTRY_CONSUMED: i64 = 3
const HD_REGISTRY_FAILED: i64 = 4

var _hir_destination_graphs: [HirDestinationGraph] = []
var _hir_destination_slot_generations: [i64] = []
var _hir_destination_slot_states: [i64] = []
var _hir_destination_acquired: bool = false

fn hir_destination_registry_slot_exists(slot: i64) -> bool:
    slot >= 0 and slot < _hir_destination_graphs.len() and
        slot < _hir_destination_slot_generations.len() and
        slot < _hir_destination_slot_states.len()

fn hir_destination_registry_state_matches(slot: i64, generation: i64, state: i64) -> bool:
    hir_destination_registry_slot_exists(slot) and generation >= 0 and
        _hir_destination_slot_generations[slot] == generation and
        _hir_destination_slot_states[slot] == state

fn hir_destination_registry_building(slot: i64, generation: i64) -> bool:
    hir_destination_registry_state_matches(slot, generation, HD_REGISTRY_BUILDING)

fn hir_destination_registry_readable(slot: i64, generation: i64) -> bool:
    hir_destination_registry_state_matches(slot, generation, HD_REGISTRY_READ)

fn hir_destination_registry_failed(slot: i64, generation: i64) -> bool:
    hir_destination_registry_state_matches(slot, generation, HD_REGISTRY_FAILED)

fn hir_destination_registry_accounting_visible(slot: i64, generation: i64) -> bool:
    hir_destination_registry_building(slot, generation) or
        hir_destination_registry_readable(slot, generation) or
        hir_destination_registry_failed(slot, generation)

# Stage3 no-GC ownership is process-lifetime. Acquire lazily creates exactly
# one graph and succeeds exactly once. The graph is never recycled, freed,
# replaced, or assigned; all storage remains rooted until process exit.
pub fn hir_destination_registry_acquire(generation: i64) -> i64:
    if generation < 0 or _hir_destination_acquired: return -1
    _hir_destination_graphs.push(HirDestinationGraph())
    _hir_destination_slot_generations.push(generation)
    _hir_destination_slot_states.push(HD_REGISTRY_UNINITIALIZED)
    if not _hir_destination_graphs[0].begin_compile(generation):
        _hir_destination_slot_states[0] = HD_REGISTRY_FAILED
        _hir_destination_acquired = true
        return -1
    _hir_destination_slot_states[0] = HD_REGISTRY_BUILDING
    _hir_destination_acquired = true
    0

pub fn hir_destination_registry_freeze(slot: i64, generation: i64) -> bool:
    if not hir_destination_registry_building(slot, generation): return false
    if not _hir_destination_graphs[slot].freeze_compile(): return false
    _hir_destination_slot_states[slot] = HD_REGISTRY_READ
    true

pub fn hir_destination_registry_release(slot: i64, generation: i64) -> bool:
    if not hir_destination_registry_readable(slot, generation): return false
    if _hir_destination_graphs[slot].active_function_count != 0: return false
    _hir_destination_slot_states[slot] = HD_REGISTRY_CONSUMED
    true

# Empty graph publication has no module receipt from which MIR could recover
# the READ lease. BUILDING receipt preflight already proves zero modules and
# zero functions before freeze, so its post-freeze terminal transition is an
# infallible scalar commit under this process-serialized owner.
pub fn hir_destination_registry_release_empty_frozen_preflighted():
    _hir_destination_slot_states[0] = HD_REGISTRY_CONSUMED

# Atomic terminal token/state commit under the process-serialized registry
# owner. The graph validates its complete token/function bijection before any
# mutation, so false retains every receipt and true consumes the generation.
pub fn hir_destination_registry_release_terminal(slot: i64, generation: i64,
        expected_function_count: i64) -> bool:
    if not hir_destination_registry_readable(slot, generation): return false
    if not _hir_destination_graphs[slot].release_all_functions_terminal(
            generation, expected_function_count):
        return false
    _hir_destination_slot_states[slot] = HD_REGISTRY_CONSUMED
    true

# Abandon is terminal. The failed graph and every capacity/text payload remain
# process-rooted for diagnostics and no-GC safety; nothing is reclaimed.
pub fn hir_destination_registry_abandon(slot: i64, generation: i64) -> bool:
    if not hir_destination_registry_building(slot, generation): return false
    if _hir_destination_graphs[slot].active_function_count != 0: return false
    _hir_destination_graphs[slot].measure_owned_text_payload_bytes()
    _hir_destination_slot_states[slot] = HD_REGISTRY_FAILED
    true

pub fn hir_destination_registry_state(slot: i64, generation: i64) -> i64:
    if not hir_destination_registry_slot_exists(slot): return HD_REGISTRY_UNINITIALIZED
    if _hir_destination_slot_generations[slot] != generation: return HD_REGISTRY_UNINITIALIZED
    _hir_destination_slot_states[slot]

pub fn hir_destination_registry_structural_capacity_bytes_estimate(slot: i64, generation: i64) -> i64:
    if not hir_destination_registry_accounting_visible(slot, generation): return -1
    _hir_destination_graphs[slot].structural_capacity_bytes_estimate()

pub fn hir_destination_registry_owned_text_payload_bytes(slot: i64, generation: i64) -> i64:
    if not hir_destination_registry_accounting_visible(slot, generation): return -1
    _hir_destination_graphs[slot].owned_text_payload_bytes

pub fn hir_destination_registry_owned_text_payload_high_water(slot: i64, generation: i64) -> i64:
    if not hir_destination_registry_accounting_visible(slot, generation): return -1
    _hir_destination_graphs[slot].owned_text_payload_high_water

