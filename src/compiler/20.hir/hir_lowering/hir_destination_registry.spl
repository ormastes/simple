pub fn hdr_count(s: i64, g: i64, k: i64) -> i64:
    if not hir_destination_registry_readable(s,g): return -1
    if k == HD_RANGE_EXPR: return _hir_destination_graphs[s].expr_count
    if k == HD_RANGE_STMT: return _hir_destination_graphs[s].stmt_count
    if k == HD_RANGE_TYPE: return _hir_destination_graphs[s].type_count
    if k == HD_RANGE_PATTERN: return _hir_destination_graphs[s].pattern_count
    if k == HD_RANGE_EFFECT: return _hir_destination_graphs[s].effect_count
    if k == HD_RANGE_DIM: return _hir_destination_graphs[s].dim_count
    if k == HD_RANGE_AUX: return _hir_destination_graphs[s].aux_count
    if k == HD_RANGE_BLOCK: return _hir_destination_graphs[s].block_count
    if k == HD_RANGE_TOKEN: return _hir_destination_graphs[s].pending_count
    if k == 10: return _hir_destination_graphs[s].function_count
    if k == 11: return _hir_destination_graphs[s].span_count
    if k == 12: return _hir_destination_graphs[s].module_count
    if k == 13: return _hir_destination_graphs[s].destination_symbols.count
    if k == 14: return _hir_destination_graphs[s].destination_members.count
    if k == 15: return _hir_destination_graphs[s].destination_module_authority.count
    if k == 16: return _hir_destination_graphs[s].destination_module_authority.text_count
    if k == 17: return _hir_destination_graphs[s].declaration_metadata.count
    if k == 18: return _hir_destination_graphs[s].declaration_metadata.range_count
    if k == 19: return _hir_destination_graphs[s].declaration_metadata.child_range_count
    if k == 20: return _hir_destination_graphs[s].block_values.count
    -1
pub fn hdr_capacity_count(s: i64, g: i64, k: i64) -> i64:
    if not hir_destination_registry_readable(s,g): return -1
    if k == HD_RANGE_EXPR: return _hir_destination_graphs[s].expr_capacity_count()
    if k == HD_RANGE_STMT: return _hir_destination_graphs[s].stmt_capacity_count()
    if k == HD_RANGE_TYPE: return _hir_destination_graphs[s].type_capacity_count()
    if k == HD_RANGE_PATTERN: return _hir_destination_graphs[s].pattern_capacity_count()
    if k == HD_RANGE_EFFECT: return _hir_destination_graphs[s].effect_capacity_count()
    if k == HD_RANGE_DIM: return _hir_destination_graphs[s].dim_capacity_count()
    if k == HD_RANGE_AUX: return _hir_destination_graphs[s].aux_capacity_count()
    if k == HD_RANGE_BLOCK: return _hir_destination_graphs[s].block_capacity_count()
    if k == HD_RANGE_TOKEN: return _hir_destination_graphs[s].token_capacity_count()
    if k == 10: return _hir_destination_graphs[s].function_capacity_count()
    if k == 11: return _hir_destination_graphs[s].span_capacity
    if k == 12: return _hir_destination_graphs[s].module_capacity_count()
    if k == 13: return _hir_destination_graphs[s].destination_symbols.capacity
    if k == 14: return _hir_destination_graphs[s].destination_members.capacity
    if k == 15: return _hir_destination_graphs[s].destination_module_authority.capacity
    if k == 16: return _hir_destination_graphs[s].destination_module_authority.text_capacity
    if k == 17: return _hir_destination_graphs[s].declaration_metadata.capacity
    if k == 18: return _hir_destination_graphs[s].declaration_metadata.range_capacity
    if k == 19: return _hir_destination_graphs[s].declaration_metadata.child_range_capacity
    if k == 20: return _hir_destination_graphs[s].block_values.ready.len()
    -1

