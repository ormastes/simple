pub fn hdr_module_route_target(s: i64, g: i64, i: i64) -> i64: hdr_aux_i64(s,g,i,0)
pub fn hdr_module_route_offset(s: i64, g: i64, i: i64) -> i64: hdr_aux_i64(s,g,i,1)
pub fn hdr_module_import_item_offset(s: i64, g: i64, i: i64) -> i64: hdr_aux_i64(s,g,i,2)
pub fn hdr_module_route_target_name(s: i64, g: i64, i: i64) -> text: hdr_aux_text(s,g,i,0)
pub fn hdr_module_route_source_name(s: i64, g: i64, i: i64) -> text: hdr_aux_text(s,g,i,1)
pub fn hdr_module_route_local_name(s: i64, g: i64, i: i64) -> text:
    val local=hdr_aux_i64(s,g,i,4)
    if local>=0: hdr_aux_text(s,g,local,0) else: ""
pub fn hdr_module_route_is_glob(s: i64, g: i64, i: i64) -> bool: hdr_aux_bool(s,g,i,0)
pub fn hdr_module_import_has_alias(s: i64, g: i64, i: i64) -> bool: hdr_aux_bool(s,g,i,1)
