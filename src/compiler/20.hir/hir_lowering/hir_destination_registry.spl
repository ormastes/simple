# Frozen scalar reader dispatch. No row, range, graph, array, or optional owner
# crosses the registry seam.
pub fn hdr_release_function(s: i64, g: i64, t: i64) -> bool: hir_destination_registry_readable(s,g) and _hir_destination_graphs[s].release_function(t,g)
pub fn hdr_span_start(s: i64, g: i64, i: i64) -> i64: if hir_destination_registry_readable(s,g): _hir_destination_graphs[s].span_start_at(i,g) else: -1
