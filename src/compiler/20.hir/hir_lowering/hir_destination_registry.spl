pub fn hdr_method_resolution_defining_module(s: i64, g: i64, i: i64) -> i64:
    if not hir_destination_registry_readable(s,g) or _hir_destination_graphs[s].aux_shape_at(i)!=HD_AUX_METHOD_RESOLUTION: return -1
    _hir_destination_graphs[s].aux_i64_at(i,3)
pub fn hdr_aux_bool(s: i64, g: i64, i: i64, c: i64) -> bool: hir_destination_registry_readable(s,g) and _hir_destination_graphs[s].aux_bool_at(i,c)
