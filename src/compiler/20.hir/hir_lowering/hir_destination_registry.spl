# Typed declaration writers. No parser/HIR aggregate crosses this boundary.
pub fn hdw_decl_reserve(s: i64, g: i64, k: i64, m: i64, y: i64, n: text, v: i64, p: i64) -> i64:
    if not hir_destination_registry_building(s,g): return -1
    _hir_destination_graphs[s].destination_declarations.reserve_declaration(k,m,y,n,v,p)
