pub fn hdr_expr_defining_module(s: i64, g: i64, i: i64) -> i64:
    if not hir_destination_registry_readable(s,g): return -1
    val shape=_hir_destination_graphs[s].expr_shape_at(i)
    if shape==HD_EXPR_QUALIFIED_NAMED_VAR: _hir_destination_graphs[s].expr_i64_at(i,1) else if shape==HD_EXPR_RESOLVED_FIELD: _hir_destination_graphs[s].expr_i64_at(i,2) else: -1
pub fn hdr_expr_resolved_symbol(s: i64, g: i64, i: i64) -> i64:
    if not hir_destination_registry_readable(s,g): return -1
    val shape=_hir_destination_graphs[s].expr_shape_at(i)
    if shape==HD_EXPR_QUALIFIED_NAMED_VAR: _hir_destination_graphs[s].expr_i64_at(i,0) else if shape==HD_EXPR_RESOLVED_FIELD: _hir_destination_graphs[s].expr_i64_at(i,1) else: -1
