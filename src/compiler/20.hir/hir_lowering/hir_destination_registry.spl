# Declaration metadata is a distinct graph-owned scalar arena. Producers pass
# only typed scalar columns; parser/HIR aggregate values never cross registry.
pub fn hdw_declaration_metadata(s: i64, g: i64, k: i64, m: i64, o: i64, n: text, t0: text, t1: text, f0: bool, f1: bool, f2: bool, v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64, p: i64) -> i64:
    if not hir_destination_registry_building(s,g): return -1
    _hir_destination_graphs[s].declaration_metadata.append_scalar(k,m,o,n,t0,t1,f0,f1,f2,v0,v1,v2,v3,v4,v5,p)
pub fn hdw_declaration_metadata_count_building(s: i64, g: i64) -> i64:
    if hir_destination_registry_building(s,g): _hir_destination_graphs[s].declaration_metadata.count else: -1
pub fn hdw_declaration_metadata_module_range(s: i64, g: i64, m: i64, k: i64, a: i64, n: i64) -> i64:
    if not hir_destination_registry_building(s,g): return -1
    _hir_destination_graphs[s].declaration_metadata.publish_module_range(m,k,a,n)
pub fn hdw_declaration_metadata_child_range(s: i64, g: i64, k: i64, a: i64, n: i64) -> i64:
    if not hir_destination_registry_building(s,g): return -1
    _hir_destination_graphs[s].declaration_metadata.publish_child_range(k,a,n)

export HD_REGISTRY_UNINITIALIZED, HD_REGISTRY_BUILDING, HD_REGISTRY_READ, HD_REGISTRY_CONSUMED, HD_REGISTRY_FAILED
export hir_destination_registry_building, hir_destination_registry_readable, hir_destination_registry_failed

# Writer dispatch. These are intentionally thin: validation is O(1), and the
# call is issued directly on the registry element so value semantics cannot
# synthesize a local aggregate copy.
pub fn hdw_reserve_span(s: i64, g: i64, a: i64, b: i64, l: i64, c: i64, f: text, n: i64) -> i64:
    if not hir_destination_registry_building(s,g): return -1
    _hir_destination_graphs[s].reserve_span(Span(start: a, end: b, line: l, col: c, file: f, length: n))
pub fn hdw_reserve_expr(s: i64, g: i64, a: i64, b: i64, l: i64, c: i64, f: text, n: i64) -> i64:
    if not hir_destination_registry_building(s,g): return -1
    _hir_destination_graphs[s].reserve_expr(Span(start: a, end: b, line: l, col: c, file: f, length: n))
