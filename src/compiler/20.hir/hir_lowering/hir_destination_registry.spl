fn hdw_staged_member_index(s: i64, g: i64, r: i64) -> i64:
    if not hir_destination_registry_building(s,g) or r<HD_STAGED_MEMBER_HANDLE_BASE: return -1
    val row=r-HD_STAGED_MEMBER_HANDLE_BASE
    if row>=0 and row<_hir_destination_graphs[s].destination_members.staged_count: row else: -1
pub fn hdw_destination_member_symbol(s: i64, g: i64, r: i64) -> i64:
    val staged=hdw_staged_member_index(s,g,r)
