pub fn hdw_decl_raw_attribute_expr(s: i64, g: i64, d: i64, e: i64) -> i64:
    if not hir_destination_registry_building(s,g): return -1
    if not _hir_destination_graphs[s].index_ready(HD_RANGE_EXPR,e): return -1
    _hir_destination_graphs[s].destination_declarations.append_raw_attribute_expr(d,e)
pub fn hdw_decl_schedule(s: i64, g: i64, d: i64, r: i64, o: i64, m: i64, k: i64, l: i64) -> i64:
    if not hir_destination_registry_building(s,g): return -1
    var valid = false
    if d == HD_SCHEDULE_SYMBOL:
        valid = _hir_destination_graphs[s].destination_symbols.building_valid(r,g)
    elif d == HD_SCHEDULE_FUNCTION:
        valid = _hir_destination_graphs[s].function_building_matches(r,g)
    elif d == HD_SCHEDULE_DECLARATION:
        valid = (r >= 0 and r < _hir_destination_graphs[s].destination_declarations.declaration_count and
            _hir_destination_graphs[s].destination_declarations.declaration_ready[r])
    elif d == HD_SCHEDULE_IMPL:
        valid = r >= 0
    elif d == HD_SCHEDULE_EXTENSION:
        valid = (r >= 0 and r < _hir_destination_graphs[s].destination_declarations.enum_extension_count and
            _hir_destination_graphs[s].destination_declarations.enum_extension_ready[r])
    if not valid: return -1
    _hir_destination_graphs[s].destination_declarations.append_schedule(d,r,o,m,k,l)
