    me write_comprehension(i: i64, kind_shape: i64, value: i64, clause_start: i64, clause_count: i64) -> bool:
        if not self.expr_writable(i) or not self.require_expr(value) or not self.range_matches(HD_RANGE_AUX, HD_AUX_RANGE_COMP_CLAUSE, clause_start, clause_count): return self.fail_expr(i, "HIR comprehension payload is not ready")
        if kind_shape < 0 or kind_shape > 3: return self.fail_expr(i, "HIR comprehension kind is invalid")
        self.expr_i0[i] = kind_shape; self.expr_i1[i] = value; self.expr_r0_start[i] = clause_start; self.expr_r0_len[i] = clause_count
        self.finalize_expr(i, HD_EXPR_COMPREHENSION)

