        self.expr_b2[i] = has_start; self.expr_i0[i] = if has_start: start_expr else: -1
        self.expr_b3[i] = has_end; self.expr_i1[i] = if has_end: end_expr else: -1
        self.expr_b0[i] = inclusive; self.expr_b1[i] = has_step; self.expr_i2[i] = if has_step: step else: -1
