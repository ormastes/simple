    me write_field(i: i64, base: i64, field: text, has_resolved: bool, resolved_symbol: i64) -> bool:
        if not self.expr_writable(i) or not self.require_expr(base): return self.fail_expr(i, "HIR field base is not ready")
        if has_resolved and resolved_symbol < 0: return self.fail_expr(i, "HIR resolved field symbol is invalid")
