        self.finalize_expr(i, HD_EXPR_ENUM)

    me write_cast_like(i: i64, shape: i64, value: i64, target: i64) -> bool:
        if not self.expr_writable(i) or not self.require_expr(value) or not self.require_type(target): return self.fail_expr(i, "HIR cast payload is not ready")
