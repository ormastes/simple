        self.finalize_expr(i, HD_EXPR_FIELD)

    me write_resolved_field(i: i64, base: i64, field: text, defining_module: i64, resolved_symbol: i64) -> bool:
        if not self.expr_writable(i) or not self.require_expr(base): return self.fail_expr(i, "HIR resolved field base is not ready")
        if field == "" or defining_module < 0 or defining_module >= self.module_count or self.module_generation[defining_module] != self.generation or resolved_symbol < 0: return self.fail_expr(i, "HIR resolved field receipt is invalid")
        self.expr_i0[i] = base; self.expr_i1[i] = resolved_symbol; self.expr_i2[i] = defining_module
        self.expr_t0[i] = field; self.expr_b0[i] = true
