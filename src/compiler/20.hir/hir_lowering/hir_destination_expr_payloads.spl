        self.expr_i0[i] = suffix_aux; self.expr_r0_start[i] = elements; self.expr_r0_len[i] = count
        self.finalize_expr(i, HD_EXPR_ARRAY_SUFFIX)

    me write_kernel_launch(i: i64, kernel: i64, grid: i64, block: i64, args: i64, arg_count: i64) -> bool:
        if not self.expr_writable(i) or not self.require_expr(kernel) or not self.require_expr(grid) or not self.require_expr(block) or not self.range_matches(HD_RANGE_AUX, HD_AUX_RANGE_CALL_ARG, args, arg_count): return self.fail_expr(i, "HIR kernel launch payload is not ready")
        self.expr_i0[i] = kernel; self.expr_i1[i] = grid; self.expr_i2[i] = block; self.expr_r0_start[i] = args; self.expr_r0_len[i] = arg_count
        self.finalize_expr(i, HD_EXPR_KERNEL_LAUNCH)

    me write_gpu_intrinsic(i: i64, kind: i64, has_dimension: bool, dimension: i64, args: i64, arg_count: i64) -> bool:
        if not self.expr_writable(i) or kind < 0 or kind > 32 or not self.range_is_ready(HD_RANGE_EXPR, args, arg_count): return self.fail_expr(i, "HIR GPU intrinsic payload is invalid")
        if kind <= 4 and (not has_dimension or dimension < 0): return self.fail_expr(i, "HIR GPU dimension is required")
        if kind > 4 and (has_dimension or dimension != -1): return self.fail_expr(i, "HIR GPU dimension is not inert")
        self.expr_i0[i] = kind; self.expr_b0[i] = has_dimension; self.expr_i1[i] = if has_dimension: dimension else: -1
        self.expr_r0_start[i] = args; self.expr_r0_len[i] = arg_count; self.finalize_expr(i, HD_EXPR_GPU_INTRINSIC)

    me write_custom_block(i: i64, kind: text, block_value_row: i64) -> bool:
        if not self.expr_writable(i) or block_value_row < 0 or block_value_row >= self.block_values.count or not self.block_values.ready[block_value_row]: return self.fail_expr(i, "HIR typed BlockValue payload is not ready")
        self.expr_t0[i] = kind; self.expr_i0[i] = block_value_row; self.finalize_expr(i, HD_EXPR_CUSTOM_BLOCK)

    me write_inline_asm(i: i64, asm_aux: i64) -> bool:
        if not self.expr_writable(i) or not self.require_aux(asm_aux) or self.aux_shape[asm_aux] != HD_AUX_ASM: return self.fail_expr(i, "HIR inline asm payload is not ready")
        self.expr_i0[i] = asm_aux; self.finalize_expr(i, HD_EXPR_INLINE_ASM)

    me write_inline_asm_match(i: i64, start: i64, count: i64) -> bool:
        if not self.expr_writable(i) or not self.range_matches(HD_RANGE_AUX, HD_AUX_RANGE_ASM_ARM, start, count): return self.fail_expr(i, "HIR asm-match arms are not ready")
        self.expr_r0_start[i] = start; self.expr_r0_len[i] = count; self.finalize_expr(i, HD_EXPR_INLINE_ASM_MATCH)

    me write_type_test(i: i64, value: i64, type_name: text) -> bool:
        if not self.expr_writable(i) or not self.require_expr(value): return self.fail_expr(i, "HIR type-test value is not ready")
        self.expr_i0[i] = value; self.expr_t0[i] = type_name; self.finalize_expr(i, HD_EXPR_TYPE_TEST)

