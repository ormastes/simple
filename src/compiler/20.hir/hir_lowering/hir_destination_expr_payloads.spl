        self.expr_b0[i] = has_value; self.expr_i0[i] = if has_value: value else: -1; self.expr_t0[i] = label; self.finalize_expr(i, HD_EXPR_BREAK)

    me write_yield(i: i64, has_value: bool, value: i64) -> bool:
        if not self.expr_writable(i) or (has_value and not self.require_expr(value)): return self.fail_expr(i, "HIR yield value is not ready")
        self.expr_b0[i] = has_value; self.expr_i0[i] = if has_value: value else: -1; self.expr_t0[i] = ""; self.finalize_expr(i, HD_EXPR_YIELD)

    me write_continue(i: i64, has_label: bool, label: text) -> bool:
        if not self.expr_writable(i): return self.fail("HIR continue row is not writable")
