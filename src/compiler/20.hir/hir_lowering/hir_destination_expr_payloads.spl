    me write_optional_range(i: i64, has_start: bool, start_expr: i64, has_end: bool, end_expr: i64, inclusive: bool, has_step: bool, step: i64) -> bool:
        if not self.expr_writable(i): return self.fail_expr(i, "HIR optional range row is not writable")
        if has_start and not self.require_expr(start_expr): return self.fail_expr(i, "HIR optional range start is not ready")
        if not has_start and start_expr != -1: return self.fail_expr(i, "HIR absent range start is not inert")
        if has_end and not self.require_expr(end_expr): return self.fail_expr(i, "HIR optional range end is not ready")
        if not has_end and end_expr != -1: return self.fail_expr(i, "HIR absent range end is not inert")
