    me write_index(i: i64, base: i64, index: i64) -> bool:
        if not self.expr_writable(i) or not self.require_expr(base) or not self.require_expr(index): return self.fail_expr(i, "HIR index child is not ready")
        self.expr_i0[i] = base; self.expr_i1[i] = index; self.finalize_expr(i, HD_EXPR_INDEX)

    me write_tuple_index(i: i64, base: i64, index: i64) -> bool:
