    me write_call(i: i64, callee: i64, arg_start: i64, arg_count: i64, type_start: i64, type_count: i64) -> bool:
        if not self.expr_writable(i) or not self.require_expr(callee): return self.fail_expr(i, "HIR call callee is not ready")
        if not self.range_matches(HD_RANGE_AUX, HD_AUX_RANGE_CALL_ARG, arg_start, arg_count) or not self.range_is_ready(HD_RANGE_TYPE, type_start, type_count): return self.fail_expr(i, "HIR call range is not ready")
        self.expr_i0[i] = callee; self.expr_r0_start[i] = arg_start; self.expr_r0_len[i] = arg_count
        self.expr_r1_start[i] = type_start; self.expr_r1_len[i] = type_count
        self.finalize_expr(i, HD_EXPR_CALL)

    me write_method_call(i: i64, receiver: i64, method: text, arg_start: i64, arg_count: i64, resolution_aux: i64) -> bool:
        if not self.expr_writable(i) or not self.require_expr(receiver) or not self.range_matches(HD_RANGE_AUX, HD_AUX_RANGE_CALL_ARG, arg_start, arg_count): return self.fail_expr(i, "HIR method-call payload is not ready")
        if not self.require_aux(resolution_aux) or self.aux_shape[resolution_aux] != HD_AUX_METHOD_RESOLUTION: return self.fail_expr(i, "HIR method resolution is not ready")
        self.expr_i0[i] = receiver; self.expr_i1[i] = resolution_aux; self.expr_t0[i] = method
        self.expr_r0_start[i] = arg_start; self.expr_r0_len[i] = arg_count
        self.finalize_expr(i, HD_EXPR_METHOD_CALL)

    me write_static_call(i: i64, type_index: i64, method: text, arg_start: i64, arg_count: i64, resolution_aux: i64) -> bool:
        if not self.expr_writable(i) or not self.require_type(type_index) or not self.range_matches(HD_RANGE_AUX, HD_AUX_RANGE_CALL_ARG, arg_start, arg_count): return self.fail_expr(i, "HIR static-call payload is not ready")
        if not self.require_aux(resolution_aux) or self.aux_shape[resolution_aux] != HD_AUX_METHOD_RESOLUTION: return self.fail_expr(i, "HIR static resolution is not ready")
        self.expr_i0[i] = type_index; self.expr_i1[i] = resolution_aux; self.expr_t0[i] = method
        self.expr_r0_start[i] = arg_start; self.expr_r0_len[i] = arg_count
        self.finalize_expr(i, HD_EXPR_STATIC_CALL)

    me write_lambda(i: i64, param_start: i64, param_count: i64, body: i64, capture_start: i64, capture_count: i64) -> bool:
        if not self.expr_writable(i) or not self.require_expr(body): return self.fail_expr(i, "HIR lambda body is not ready")
        if not self.range_matches(HD_RANGE_AUX, HD_AUX_RANGE_VALUE_PARAM, param_start, param_count) or not self.range_matches(HD_RANGE_AUX, HD_AUX_RANGE_SYMBOL_REF, capture_start, capture_count): return self.fail_expr(i, "HIR lambda range is not ready")
        self.expr_i0[i] = body; self.expr_r0_start[i] = param_start; self.expr_r0_len[i] = param_count
        self.expr_r1_start[i] = capture_start; self.expr_r1_len[i] = capture_count
        self.finalize_expr(i, HD_EXPR_LAMBDA)

    me write_host_gpu(i: i64, lane_code: i64, payload_size: i64, marker: i64, block: i64) -> bool:
        if not self.expr_writable(i) or lane_code < 0 or payload_size < 0 or not self.require_expr(marker) or block < 0 or block >= self.block_count or not self.block_ready[block]: return self.fail_expr(i, "HIR host-GPU payload is not ready")
        self.expr_i0[i] = lane_code; self.expr_i1[i] = payload_size; self.expr_i2[i] = marker; self.expr_i3[i] = block
        self.finalize_expr(i, HD_EXPR_HOST_GPU)

    me write_return_rich(i: i64, has_value: bool, value: i64) -> bool:
        if not self.expr_writable(i) or (has_value and not self.require_expr(value)): return self.fail_expr(i, "HIR rich return value is not ready")
        self.expr_has_type[i] = false; self.expr_type[i] = -1
        self.expr_b0[i] = has_value; self.expr_i0[i] = if has_value: value else: -1; self.expr_t0[i] = ""
        self.finalize_expr(i, HD_EXPR_RETURN)

    me write_return_bootstrap_unit(i: i64, has_value: bool, value: i64, unit_type: i64) -> bool:
        if not self.expr_writable(i) or not self.require_type(unit_type) or self.type_shape[unit_type] != HD_TYPE_UNIT: return self.fail_expr(i, "HIR bootstrap return Unit type is not ready")
        if has_value and not self.require_expr(value): return self.fail_expr(i, "HIR bootstrap return value is not ready")
        self.expr_has_type[i] = true; self.expr_type[i] = unit_type
        self.expr_b0[i] = has_value; self.expr_i0[i] = if has_value: value else: -1; self.expr_t0[i] = ""
        self.finalize_expr(i, HD_EXPR_RETURN)

