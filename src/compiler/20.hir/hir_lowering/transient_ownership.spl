# Canonical compiler boundary for transient allocation ownership.

@unsafe(reason: "raw transient scope begin ABI", capabilities: [ffi])
extern fn rt_transient_array_scope_begin() -> bool
@unsafe(reason: "raw transient scope pause ABI", capabilities: [ffi])
extern fn rt_transient_array_scope_pause() -> bool
@unsafe(reason: "raw transient scope end ABI", capabilities: [ffi])
extern fn rt_transient_array_scope_end() -> bool
@unsafe(reason: "raw transient ownership promotion ABI", capabilities: [ffi])
extern fn rt_transient_heap_promote(value: Any) -> bool
@unsafe(reason: "raw temporary array release ABI", capabilities: [ffi])
extern fn rt_array_free(array: [Any])

pub fn transient_scope_begin() -> bool:
    unsafe(capabilities: [ffi]):
        rt_transient_array_scope_begin()

pub fn transient_scope_pause() -> bool:
    unsafe(capabilities: [ffi]):
        rt_transient_array_scope_pause()

pub fn transient_scope_end() -> bool:
    unsafe(capabilities: [ffi]):
        rt_transient_array_scope_end()

pub fn transient_promote(value: Any) -> bool:
    unsafe(capabilities: [ffi]):
        rt_transient_heap_promote(value)

pub fn transient_promote_roots(roots: [Any]) -> bool:
    unsafe(capabilities: [ffi]):
        val promoted = rt_transient_heap_promote(roots)
        rt_array_free(roots)
        promoted
