# Canonical, span-free digest of a module's frozen surface: exactly what
# module_surface_declaration_matches compares (module_surface_source_identity.spl)
# -- the semantic declaration projection plus imports, exports, friends,
# internal exports and the module-level nogc contract. Two parses that yield
# the same value build interchangeable frozen surfaces, so it is the equality
# rule between a surface rebuilt from a TLDR companion and one from the full
# source (packed_binary_ast / src_based_tldr_build design, codec step 3).
use std.common.crypto.sha256.{sha256_text}
use compiler.frontend.parser_types.{ParserModule}
use compiler.hir.hir_lowering.module_surface_semantic_projection.{module_surface_semantic_projection}

pub fn module_surface_canonical_digest_v1(module: ParserModule) -> text:
    var parts: [text] = ["simple.module-surface.canonical.v1", "semantic=" + module_surface_semantic_projection(module)]
    for imp in module.imports:
        var items: [text] = []
        for item in imp.items:
            items.push(if item.has_alias: item.name + " as " + item.alias else: item.name)
        parts.push("import={imp.module}|lazy={imp.is_lazy}|" + items.join(","))
    for exp in module.exports:
        parts.push("export=" + exp.items.join(","))
    parts.push("friends=" + module.friends.join(","))
    parts.push("internal=" + module.internal_exports.join(","))
    parts.push("nogc_strict={module.nogc_strict}")
    sha256_text(parts.join("\n"))
