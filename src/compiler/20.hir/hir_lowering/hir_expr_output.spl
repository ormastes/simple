# Compatibility facade for the destination-owner HIR graph.
#
# `HirExprOutput` names the single compile-owner arena spanning all modules;
# production must never use it as a function argument/return or store a copy.
# `HirBlockOutput` is only a scalar block index receipt.
export use compiler.hir.hir_lowering.hir_destination_graph.*
export use compiler.hir.hir_lowering.hir_destination_block_values.*
export use compiler.hir.hir_lowering.hir_destination_block_value_graph.*
export use compiler.hir.hir_lowering.hir_destination_symbols.*
export use compiler.hir.hir_lowering.hir_destination_symbol_graph.*
export use compiler.hir.hir_lowering.hir_destination_expr_hot.*
export use compiler.hir.hir_lowering.hir_destination_expr_payloads.*
export use compiler.hir.hir_lowering.hir_destination_blocks.*
export use compiler.hir.hir_lowering.hir_destination_control.*
export use compiler.hir.hir_lowering.hir_destination_types_patterns.*
export use compiler.hir.hir_lowering.hir_destination_function.*
export use compiler.hir.hir_lowering.hir_destination_modules.*

type HirExprOutput = HirDestinationGraph
type HirBlockOutput = i64
type BootstrapHirFunctionOutput = i64

export HirExprOutput, HirBlockOutput, BootstrapHirFunctionOutput
