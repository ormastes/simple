# Graph-only scalar semantic symbol/type bridge. The flat route never constructs
# HirDestinationGraph, so this retained Dict/SoA bank has zero flat-mode cost.
const HD_SYMBOL_KIND_MIN: i64 = 0
const HD_SYMBOL_KIND_MAX: i64 = 14
const HD_SYMBOL_KIND_CLASS: i64=5; const HD_SYMBOL_KIND_STRUCT: i64=6
const HD_SYMBOL_KIND_ENUM: i64=7; const HD_SYMBOL_KIND_TRAIT: i64=9

class HirDestinationSymbolStore:
    generation: i64 = -1
    frozen: bool = false
    error: bool = false
    count: i64 = 0
    capacity: i64 = 0
    # Parser/HIR symbol ids restart for each source module.  The module-qualified
    # per-module scalar Dict keeps lookup collision-free, O(1), and allocation-
    # free on the hot read path.
    rows_by_module: [Dict<i64, i64>] = []
    ready: [bool] = []
    row_generation: [i64] = []
    symbol: [i64] = []
    name: [text] = []
    has_type: [bool] = []
    type_index: [i64] = []
    visibility: [i64] = []
    owner_symbol: [i64] = []
    module_symbol: [i64] = []
    module_index: [i64] = []
    kind: [i64] = []
    mutable_: [bool] = []
    has_defining_module: [bool] = []
    defining_module: [text] = []
    scope: [i64] = []
    span_index: [i64] = []
    is_public: [bool] = []

    me begin(g: i64) -> bool:
        if g < 0: return false
        self.rows_by_module=[]; self.generation = g; self.frozen = false; self.error = false; self.count = 0; true
    me ensure_module_index(module_row: i64):
        while self.rows_by_module.len()<=module_row:
            val empty: Dict<i64, i64> = {}; self.rows_by_module.push(empty)
    me ensure(required: i64):
        if required <= self.capacity: return
        var target = if self.capacity < 8: 8 else: self.capacity
        while target < required: target = target * 2
        while self.ready.len() < target:
            self.ready.push(false); self.row_generation.push(-1); self.symbol.push(-1); self.name.push(""); self.has_type.push(false); self.type_index.push(-1)
            self.visibility.push(-1); self.owner_symbol.push(-1); self.module_symbol.push(-1); self.module_index.push(-1)
            self.kind.push(-1); self.mutable_.push(false); self.has_defining_module.push(false); self.defining_module.push(""); self.scope.push(-1); self.span_index.push(-1); self.is_public.push(false)
        self.capacity = target
    me publish(symbol_id: i64,name_: text,has_type_: bool,destination_type: i64,visibility_: i64,owner: i64,module_sym: i64,module_row: i64,kind_: i64,mutable_value: bool,has_defining: bool,defining: text,scope_: i64,span: i64,public_: bool) -> i64:
        if self.frozen or self.error or symbol_id < 0 or name_ == "" or (has_type_ and destination_type < 0) or (not has_type_ and destination_type != -1) or visibility_ < 0 or visibility_ > 5 or public_ != (visibility_ == 0) or owner < -1 or module_sym < -1 or module_row < 0 or kind_ < HD_SYMBOL_KIND_MIN or kind_ > HD_SYMBOL_KIND_MAX or (has_defining and defining == "") or (not has_defining and defining != "") or scope_ < 0 or span < 0: self.error = true; return -1
        self.ensure_module_index(module_row)
        if self.rows_by_module[module_row].contains_key(symbol_id):
            val old = self.rows_by_module[module_row][symbol_id]
            if self.ready[old] and self.row_generation[old] == self.generation and self.name[old] == name_ and self.has_type[old] == has_type_ and self.type_index[old] == destination_type and self.visibility[old] == visibility_ and self.owner_symbol[old] == owner and self.module_symbol[old] == module_sym and self.module_index[old] == module_row and self.kind[old] == kind_ and self.mutable_[old] == mutable_value and self.has_defining_module[old] == has_defining and self.defining_module[old] == defining and self.scope[old] == scope_ and self.span_index[old] == span and self.is_public[old] == public_: return old
            self.error = true; return -1
        val row = self.count; self.ensure(row + 1)
        self.ready[row] = false; self.row_generation[row] = self.generation; self.symbol[row] = symbol_id; self.name[row] = name_; self.has_type[row] = has_type_
        self.type_index[row] = destination_type; self.visibility[row] = visibility_; self.owner_symbol[row] = owner
        self.module_symbol[row] = module_sym; self.module_index[row] = module_row; self.kind[row] = kind_; self.mutable_[row] = mutable_value
        self.has_defining_module[row] = has_defining; self.defining_module[row] = defining; self.scope[row] = scope_; self.span_index[row] = span; self.is_public[row] = public_
        self.rows_by_module[module_row][symbol_id] = row; self.ready[row] = true; self.count = row + 1; row
    me update_type_same_authority(symbol_id: i64,destination_type: i64,visibility_: i64,owner: i64,module_sym: i64,module_row: i64,kind_: i64,mutable_value: bool) -> i64:
        if self.frozen or self.error or destination_type < 0 or module_row<0 or module_row>=self.rows_by_module.len() or not self.rows_by_module[module_row].contains_key(symbol_id): self.error = true; return -1
        val row = self.rows_by_module[module_row][symbol_id]
        if not self.ready[row] or self.row_generation[row] != self.generation or self.has_type[row] or self.type_index[row] != -1 or self.visibility[row] != visibility_ or self.owner_symbol[row] != owner or self.module_symbol[row] != module_sym or self.module_index[row] != module_row or self.kind[row] != kind_ or self.mutable_[row] != mutable_value: self.error = true; return -1
        self.has_type[row] = true; self.type_index[row] = destination_type; row
    fn can_rollback(target: i64) -> bool: not self.frozen and target >= 0 and target <= self.count
    me rollback(target: i64, old_error: bool) -> bool:
        if not self.can_rollback(target): return false
        var i = target
        while i < self.count:
            val module_row=self.module_index[i]
            if module_row>=0 and module_row<self.rows_by_module.len() and self.rows_by_module[module_row].contains_key(self.symbol[i]): self.rows_by_module[module_row].remove(self.symbol[i])
            self.ready[i] = false; self.row_generation[i] = -1; self.symbol[i] = -1; self.name[i] = ""; self.has_type[i] = false; self.type_index[i] = -1
            self.visibility[i] = -1; self.owner_symbol[i] = -1; self.module_symbol[i] = -1; self.module_index[i] = -1; self.kind[i] = -1; self.mutable_[i] = false; self.has_defining_module[i] = false; self.defining_module[i] = ""; self.scope[i] = -1; self.span_index[i] = -1; self.is_public[i] = false; i = i + 1
        self.count = target; self.error = old_error; true
    me can_freeze() -> bool:
        if self.error: return false
        var i = 0; while i < self.count: if not self.ready[i] or self.row_generation[i] != self.generation: return false else: i = i + 1
        true
    me freeze() -> bool:
        if not self.can_freeze(): return false
        self.frozen = true; true
    me commit_freeze():
        self.frozen = true
    me lookup(module_row: i64,symbol_id: i64,g: i64) -> i64:
        if not self.frozen or g != self.generation or module_row<0 or module_row>=self.rows_by_module.len() or not self.rows_by_module[module_row].contains_key(symbol_id): return -1
        val row = self.rows_by_module[module_row][symbol_id]; if self.ready[row]: row else: -1
    me building_lookup(module_row: i64,symbol_id: i64,g: i64) -> i64:
        if self.frozen or g != self.generation or module_row<0 or module_row>=self.rows_by_module.len() or not self.rows_by_module[module_row].contains_key(symbol_id): return -1
        val row = self.rows_by_module[module_row][symbol_id]; if self.ready[row] and self.row_generation[row] == g: row else: -1
    me building_valid(row: i64,g: i64) -> bool: not self.frozen and g == self.generation and row >= 0 and row < self.count and self.ready[row] and self.row_generation[row] == g
    me valid(row: i64, g: i64) -> bool: self.frozen and g == self.generation and row >= 0 and row < self.count and self.ready[row] and self.row_generation[row] == g
    me symbol_at(row: i64,g: i64) -> i64: if self.valid(row,g): self.symbol[row] else: -1
    me name_at(row: i64,g: i64) -> text: if self.valid(row,g): self.name[row] else: ""
    me has_type_at(row: i64,g: i64) -> bool: self.valid(row,g) and self.has_type[row]
    me type_at(row: i64,g: i64) -> i64: if self.valid(row,g): self.type_index[row] else: -1
    me visibility_at(row: i64,g: i64) -> i64: if self.valid(row,g): self.visibility[row] else: -1
    me owner_at(row: i64,g: i64) -> i64: if self.valid(row,g): self.owner_symbol[row] else: -1
    me module_symbol_at(row: i64,g: i64) -> i64: if self.valid(row,g): self.module_symbol[row] else: -1
    me module_at(row: i64,g: i64) -> i64: if self.valid(row,g): self.module_index[row] else: -1
    me kind_at(row: i64,g: i64) -> i64: if self.valid(row,g): self.kind[row] else: -1
    me mutable_at(row: i64,g: i64) -> bool: self.valid(row,g) and self.mutable_[row]
    me has_defining_module_at(row: i64,g: i64) -> bool: self.valid(row,g) and self.has_defining_module[row]
    me defining_module_at(row: i64,g: i64) -> text: if self.valid(row,g): self.defining_module[row] else: ""
    me scope_at(row: i64,g: i64) -> i64: if self.valid(row,g): self.scope[row] else: -1
    me span_at(row: i64,g: i64) -> i64: if self.valid(row,g): self.span_index[row] else: -1
    me is_public_at(row: i64,g: i64) -> bool: self.valid(row,g) and self.is_public[row]
    me capacity_bytes_estimate() -> i64: self.capacity * 160
    me text_payload_bytes() -> i64:
        var total = 0; var i = 0
        while i < self.name.len(): total = total + self.name[i].len() + self.defining_module[i].len(); i = i + 1
        total

# Peer/Up/Internal depend on canonical logical paths, facade ancestry, and
# friend declarations unavailable in this scalar bridge. Guarded owner/module
# fields are exposed so the existing visibility owner remains authoritative.
export HirDestinationSymbolStore, HD_SYMBOL_KIND_MIN, HD_SYMBOL_KIND_MAX
export HD_SYMBOL_KIND_CLASS, HD_SYMBOL_KIND_STRUCT, HD_SYMBOL_KIND_ENUM, HD_SYMBOL_KIND_TRAIT
