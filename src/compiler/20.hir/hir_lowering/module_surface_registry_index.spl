# Frozen registry indexes and import/export route projections.

use compiler.hir.hir_lowering.module_surface_types.{ModuleSurface, ModuleSurfacesByName, module_surface_allocate_generation}
use compiler.hir.hir_lowering.module_surface_source_identity.{module_surface_canonical_module_name, module_surface_logical_name_from_path, module_surface_package_name_from_name}

pub(package) fn module_surfaces_validate_index_alignment(
    surfaces: [ModuleSurface],
    index_by_name: Dict<text, i64>,
    ordered_names: [text],
    ordered_indices: [i64]
) -> Result<(), text>:
    if ordered_names.len() != ordered_indices.len():
        return Err("module surface name/index arrays have different lengths")

    # The compatibility dictionary is checked once at construction/finalize,
    # never from the hot lookup helpers.  keys() and values() are aligned by
    # dict_collect, so this validates both membership and scalar identity.
    val dict_names = index_by_name.keys()
    val dict_indices = index_by_name.values()
    if dict_names.len() != dict_indices.len() or
       dict_names.len() != ordered_names.len():
        return Err("module surface name/index representation is inconsistent")

    var i = 0
    while i < ordered_names.len():
        if ordered_indices[i] < 0 or ordered_indices[i] >= surfaces.len():
            return Err("module surface index out of range for {ordered_names[i]}")
        var prior = 0
        while prior < i:
            if ordered_names[prior] == ordered_names[i]:
                return Err("duplicate ordered module surface name: {ordered_names[i]}")
            prior = prior + 1
        var dict_position = 0
        var found = false
        while dict_position < dict_names.len():
            if dict_names[dict_position] == ordered_names[i]:
                if dict_indices[dict_position] != ordered_indices[i]:
                    return Err("module surface name maps to conflicting indices: {ordered_names[i]}")
                found = true
            dict_position = dict_position + 1
        if not found:
            return Err("module surface ordered name missing from compatibility index: {ordered_names[i]}")
        i = i + 1
    Ok(())


pub(package) fn module_surface_registry_index(registry: ModuleSurfacesByName, name: text) -> i64:
    if not registry.index_by_name.contains_key(name):
        return -1
    val index = registry.index_by_name[name]
    if index < 0 or index >= registry.surfaces.len():
        return -1
    index

pub(package) fn module_surface_resolve_absolute_key(
    registry: ModuleSurfacesByName,
    name: text
) -> text:
    if module_surface_registry_index(registry, name) >= 0:
        return name
    var candidates: [text] = []
    candidates = candidates.push(name + ".__init__")
    candidates = candidates.push("lib." + name)
    candidates = candidates.push("lib." + name + ".__init__")
    if name.starts_with("std."):
        val std_tail = name.substring(4)
        val lib_tail = "lib." + std_tail
        candidates = candidates.push(lib_tail)
        candidates = candidates.push(lib_tail + ".__init__")
        for tier in ["nogc_async_mut", "nogc_sync_mut", "nogc_async_immut", "common", "gc_async_mut", "nogc_async_mut_noalloc"]:
            val tier_key = "lib." + tier + "." + std_tail
            candidates = candidates.push(tier_key)
            candidates = candidates.push(tier_key + ".__init__")
            val tier_std_key = "std." + tier + "." + std_tail
            candidates = candidates.push(tier_std_key)
            candidates = candidates.push(tier_std_key + ".__init__")
    var candidate_index = 0
    while candidate_index < candidates.len():
        if module_surface_registry_index(registry, candidates[candidate_index]) >= 0:
            return candidates[candidate_index]
        candidate_index = candidate_index + 1
    ""

pub(package) fn module_surface_resolve_relative_key(
    registry: ModuleSurfacesByName,
    facade: ModuleSurface,
    name: text
) -> text:
    if not name.starts_with("."):
        return module_surface_resolve_absolute_key(registry, name)
    var dots = 0
    while dots < name.len() and name.substring(dots, dots + 1) == ".":
        dots = dots + 1
    val tail = name.substring(dots)
    if tail == "":
        return ""
    var package_name = facade.canonical_name
    var package_index = 0
    while package_index < dots:
        package_name = module_surface_package_name_from_name(package_name)
        package_index = package_index + 1
    val absolute_name = if package_name == "": tail else package_name + "." + tail
    if module_surface_registry_index(registry, absolute_name) >= 0:
        return absolute_name
    module_surface_resolve_absolute_key(registry, absolute_name)

pub(package) fn module_surface_resolve_import_key(
    registry: ModuleSurfacesByName,
    facade: ModuleSurface,
    name: text
) -> text:
    var resolved = module_surface_resolve_relative_key(registry, facade, name)
    if resolved == "":
        return ""
    val resolved_index = module_surface_registry_index(registry, resolved)
    if resolved_index < 0 or
       registry.surfaces[resolved_index].canonical_path != facade.canonical_path:
        return resolved
    if facade.canonical_name.ends_with(".__init__"):
        return resolved
    val package_key = module_surface_resolve_absolute_key(
        registry, facade.canonical_name + ".__init__")
    if package_key == "" or package_key == resolved:
        return resolved
    val package_index = module_surface_registry_index(registry, package_key)
    if package_index < 0 or
       registry.surfaces[package_index].canonical_path == facade.canonical_path:
        return resolved
    package_key

pub(package) fn module_surface_preferred_registry_name(
    registry: ModuleSurfacesByName,
    surface: ModuleSurface
) -> Result<text, text>:
    var selected = ""
    var found = false
    var alias_index = 0
    while alias_index < registry.ordered_names.len() and
          alias_index < registry.ordered_indices.len():
        if registry.ordered_indices[alias_index] == surface.physical_index:
            val alias_name = registry.ordered_names[alias_index]
            found = true
            if selected == "" or alias_name < selected:
                selected = alias_name
            # Keep scanning so the result is independent of alias insertion
            # order and malformed data is still rejected by validation.
        alias_index = alias_index + 1
    if not found or selected == "":
        return Err("physical module surface has no ordered registry alias: {surface.physical_index}")
    if module_surface_registry_index(registry, selected) != surface.physical_index:
        return Err("preferred registry alias is not mapped to its physical surface: {selected}")
    Ok(selected)

pub(package) fn module_surface_signature_index(
    surface: ModuleSurface,
    owner_kind: text,
    owner_name: text,
    callable_name: text
) -> i64:
    val signature_count = surface.signature_names.len()
    if surface.signature_owner_kinds.len() != signature_count or
       surface.signature_owner_names.len() != signature_count:
        return -1
    var index = 0
    while index < signature_count:
        if surface.signature_owner_kinds[index] == owner_kind and
           surface.signature_owner_names[index] == owner_name and
           surface.signature_names[index] == callable_name:
            return index
        index = index + 1
    -1

pub(package) fn module_surface_composite_index(
    surface: ModuleSurface, composite_name: text
) -> i64:
    var index = 0
    while index < surface.composite_names.len():
        if surface.composite_names[index] == composite_name:
            return index
        index = index + 1
    -1

pub(package) fn module_surface_composite_arrays_aligned(
    surface: ModuleSurface
) -> bool:
    val composite_count = surface.composite_names.len()
    val index = surface.composite_index
    if index.kinds.len() != composite_count or
       index.field_offsets.len() != composite_count or
       index.field_counts.len() != composite_count or
       index.dependency_offsets.len() != composite_count or
       index.dependency_counts.len() != composite_count or
       index.field_names.len() != index.field_shapes.len() or
       index.field_names.len() != index.field_type_names.len():
        return false
    var expected_field_offset = 0
    var expected_dependency_offset = 0
    var composite_index = 0
    while composite_index < composite_count:
        val field_offset = index.field_offsets[composite_index]
        val field_count = index.field_counts[composite_index]
        val dependency_offset = index.dependency_offsets[composite_index]
        val dependency_count = index.dependency_counts[composite_index]
        if field_offset != expected_field_offset or field_count < 0 or
           field_offset + field_count > index.field_names.len() or
           dependency_offset != expected_dependency_offset or
           dependency_count < 0 or dependency_offset + dependency_count >
               index.dependency_names.len():
            return false
        val kind = index.kinds[composite_index]
        if kind != "class" and kind != "struct" and kind != "actor":
            return false
        expected_field_offset = field_offset + field_count
        expected_dependency_offset = dependency_offset + dependency_count
        composite_index = composite_index + 1
    if expected_field_offset != index.field_names.len() or
       expected_dependency_offset != index.dependency_names.len():
        return false
    var field_index = 0
    while field_index < index.field_names.len():
        val shape = index.field_shapes[field_index]
        val type_name = index.field_type_names[field_index]
        if shape != "named" and shape != "named_array" and
           shape != "unsupported":
            return false
        if (shape == "unsupported" and type_name != "") or
           (shape != "unsupported" and type_name == ""):
            return false
        field_index = field_index + 1
    true

pub(package) fn module_surface_signature_arrays_aligned(
    surface: ModuleSurface
) -> bool:
    val signature_count = surface.signature_names.len()
    if surface.signature_owner_kinds.len() != signature_count or
       surface.signature_owner_names.len() != signature_count or
       surface.signature_type_param_counts.len() != signature_count or
       surface.signature_has_return_types.len() != signature_count or
       surface.signature_is_static.len() != signature_count or
       surface.signature_param_offsets.len() != signature_count or
       surface.signature_param_counts.len() != signature_count or
       surface.signature_return_shapes.len() != signature_count or
       surface.signature_return_type_names.len() != signature_count or
       surface.signature_dependency_offsets.len() != signature_count or
       surface.signature_dependency_counts.len() != signature_count:
        return false
    if surface.signature_param_names.len() != surface.signature_param_has_types.len() or
       surface.signature_param_names.len() != surface.signature_param_shapes.len() or
       surface.signature_param_names.len() != surface.signature_param_type_names.len():
        return false
    if surface.impl_owner_names.len() != surface.impl_has_traits.len() or
       surface.impl_owner_names.len() != surface.impl_trait_names.len():
        return false
    var expected_param_offset = 0
    var expected_dependency_offset = 0
    var signature_index = 0
    while signature_index < signature_count:
        val owner_kind = surface.signature_owner_kinds[signature_index]
        val owner_name = surface.signature_owner_names[signature_index]
        if owner_kind != "free" and owner_kind != "impl" and
           owner_kind != "trait":
            return false
        if (owner_kind == "free" and owner_name != "") or
           (owner_kind != "free" and owner_name == ""):
            return false
        val param_offset = surface.signature_param_offsets[signature_index]
        val param_count = surface.signature_param_counts[signature_index]
        if param_offset != expected_param_offset or param_count < 0 or
           param_offset + param_count > surface.signature_param_names.len():
            return false
        expected_param_offset = param_offset + param_count
        val dependency_offset =
            surface.signature_dependency_offsets[signature_index]
        val dependency_count =
            surface.signature_dependency_counts[signature_index]
        if dependency_offset != expected_dependency_offset or
           dependency_count < 0 or
           dependency_offset + dependency_count >
               surface.signature_dependency_names.len():
            return false
        expected_dependency_offset = dependency_offset + dependency_count
        val return_shape = surface.signature_return_shapes[signature_index]
        val return_name = surface.signature_return_type_names[signature_index]
        if return_shape != "named" and return_shape != "named_array" and
           return_shape != "unsupported":
            return false
        if (return_shape == "unsupported" and return_name != "") or
           (return_shape != "unsupported" and return_name == ""):
            return false
        signature_index = signature_index + 1
    if expected_param_offset != surface.signature_param_names.len() or
       expected_dependency_offset != surface.signature_dependency_names.len():
        return false
    var param_index = 0
    while param_index < surface.signature_param_names.len():
        val shape = surface.signature_param_shapes[param_index]
        val type_name = surface.signature_param_type_names[param_index]
        if shape != "named" and shape != "named_array" and
           shape != "unsupported":
            return false
        if (shape == "unsupported" and type_name != "") or
           (shape != "unsupported" and type_name == ""):
            return false
        param_index = param_index + 1
    true

pub(package) fn module_surface_route_arrays_aligned(surface: ModuleSurface) -> bool:
    if not module_surface_composite_arrays_aligned(surface):
        return false
    if not module_surface_signature_arrays_aligned(surface):
        return false
    if surface.import_target_indices.len() != surface.import_target_names.len() or
       surface.import_target_indices.len() != surface.import_route_module_names.len() or
       surface.import_target_indices.len() != surface.import_route_item_offsets.len() or
       surface.import_target_indices.len() != surface.import_route_item_counts.len() or
       surface.import_route_item_names.len() != surface.import_route_item_local_names.len():
        return false
    var import_index = 0
    var expected_item_offset = 0
    while import_index < surface.import_route_item_offsets.len():
        val item_offset = surface.import_route_item_offsets[import_index]
        val item_count = surface.import_route_item_counts[import_index]
        if item_offset != expected_item_offset or item_count < 0 or
           item_offset + item_count > surface.import_route_item_names.len():
            return false
        expected_item_offset = item_offset + item_count
        import_index = import_index + 1
    if expected_item_offset != surface.import_route_item_names.len():
        return false
    if surface.export_route_sources.len() != surface.export_route_locals.len() or
       surface.export_route_sources.len() != surface.export_route_target_indices.len() or
       surface.export_route_sources.len() != surface.export_route_target_names.len() or
       surface.export_route_sources.len() != surface.export_route_is_glob.len():
        return false
    if surface.export_origin_index.names.len() != surface.export_origin_index.owner_modules.len() or
       surface.export_origin_index.names.len() != surface.export_origin_index.source_names.len() or
       surface.export_origin_index.names.len() != surface.export_origin_index.resolution_kinds.len():
        return false
    val origin_map = surface.export_origin_index.origins
    var origin_index = 0
    while origin_index < surface.export_origin_index.names.len():
        if not origin_map.contains_key(
            surface.export_origin_index.names[origin_index]):
            return false
        origin_index = origin_index + 1
    true

pub(package) fn module_surfaces_frozen_alignment(registry: ModuleSurfacesByName) -> bool:
    if not registry.frozen or registry.generation == 0:
        return false
    if registry.ordered_names.len() != registry.ordered_indices.len():
        return false
    var alias_index = 0
    while alias_index < registry.ordered_indices.len():
        if registry.ordered_indices[alias_index] < 0 or
           registry.ordered_indices[alias_index] >= registry.surfaces.len():
            return false
        alias_index = alias_index + 1
    var surface_index = 0
    while surface_index < registry.surfaces.len():
        val surface = registry.surfaces[surface_index]
        if not surface.frozen or not surface.export_origin_index.frozen or
           surface.physical_index != surface_index or
           surface.generation != registry.generation or
           surface.preferred_registry_name == "" or
           module_surface_registry_index(registry, surface.preferred_registry_name) != surface_index or
           not module_surface_route_arrays_aligned(surface):
            return false
        surface_index = surface_index + 1
    true

pub(package) fn module_surfaces_freeze(registry: ModuleSurfacesByName) -> Result<ModuleSurfacesByName, text>:
    if registry.frozen:
        return Err("module surface registry is already frozen")
    var existing_surface_index = 0
    while existing_surface_index < registry.surfaces.len():
        val existing_surface = registry.surfaces[existing_surface_index]
        if existing_surface.frozen or existing_surface.export_origin_index.frozen:
            return Err("module surface is already frozen: {existing_surface_index}")
        existing_surface_index = existing_surface_index + 1
    val validation = module_surfaces_validate_index_alignment(
        registry.surfaces, registry.index_by_name,
        registry.ordered_names, registry.ordered_indices)
    if validation.is_err():
        return Err(validation.unwrap_err())
    var surface_index = 0
    while surface_index < registry.surfaces.len():
        var surface = registry.surfaces[surface_index]
        surface.physical_index = surface_index
        surface.logical_name = module_surface_logical_name_from_path(surface.canonical_path)
        surface.canonical_name = surface.logical_name
        surface.package_name = module_surface_package_name_from_name(surface.logical_name)
        val preferred_result = module_surface_preferred_registry_name(registry, surface)
        if preferred_result.is_err():
            return Err(preferred_result.unwrap_err())
        surface.preferred_registry_name = preferred_result.unwrap()

        var import_target_indices: [i64] = []
        var import_target_names: [text] = []
        var import_route_module_names: [text] = []
        var import_route_item_offsets: [i64] = []
        var import_route_item_counts: [i64] = []
        var import_route_item_names: [text] = []
        var import_route_item_local_names: [text] = []
        for import_decl in surface.imports:
            val target_name = module_surface_resolve_import_key(
                registry, surface, import_decl.module)
            var target_index = -1
            if target_name != "":
                target_index = module_surface_registry_index(registry, target_name)
            import_target_indices = import_target_indices.push(target_index)
            import_target_names = import_target_names.push(target_name)
            import_route_module_names = import_route_module_names.push(
                import_decl.module)
            import_route_item_offsets = import_route_item_offsets.push(
                import_route_item_names.len())
            import_route_item_counts = import_route_item_counts.push(
                import_decl.items.len())
            for import_item in import_decl.items:
                import_route_item_names = import_route_item_names.push(
                    import_item.name)
                val local_name = if import_item.has_alias:
                    import_item.alias
                else:
                    import_item.name
                import_route_item_local_names = import_route_item_local_names.push(
                    local_name)

        var export_route_sources: [text] = []
        var export_route_locals: [text] = []
        var export_route_target_indices: [i64] = []
        var export_route_target_names: [text] = []
        var export_route_is_glob: [bool] = []
        for export_decl in surface.exports:
            for export_item in export_decl.items:
                if export_item.ends_with(".*"):
                    val export_base = export_item[0:export_item.len() - 2]
                    var target_name = ""
                    if export_base.starts_with("."):
                        target_name = module_surface_resolve_relative_key(
                            registry, surface, export_base)
                    else:
                        target_name = module_surface_resolve_absolute_key(
                            registry, surface.package_name + "." + export_base)
                        if target_name == "":
                            target_name = module_surface_resolve_absolute_key(
                                registry, export_base)
                    export_route_sources = export_route_sources.push(export_base)
                    export_route_locals = export_route_locals.push("")
                    export_route_target_names = export_route_target_names.push(target_name)
                    var export_target_index = -1
                    if target_name != "":
                        export_target_index = module_surface_registry_index(registry, target_name)
                    export_route_target_indices = export_route_target_indices.push(export_target_index)
                    export_route_is_glob = export_route_is_glob.push(true)
                else:
                    var source_name = export_item
                    var local_name = export_item
                    if export_item.contains(":"):
                        val parts = export_item.split(":")
                        source_name = parts[0]
                        if parts.len() > 1:
                            local_name = parts[1]
                    export_route_sources = export_route_sources.push(source_name)
                    export_route_locals = export_route_locals.push(local_name)
                    export_route_target_indices = export_route_target_indices.push(-1)
                    export_route_target_names = export_route_target_names.push("")
                    export_route_is_glob = export_route_is_glob.push(false)

        surface.import_target_indices = import_target_indices
        surface.import_target_names = import_target_names
        surface.import_route_module_names = import_route_module_names
        surface.import_route_item_offsets = import_route_item_offsets
        surface.import_route_item_counts = import_route_item_counts
        surface.import_route_item_names = import_route_item_names
        surface.import_route_item_local_names = import_route_item_local_names
        surface.export_route_sources = export_route_sources
        surface.export_route_locals = export_route_locals
        surface.export_route_target_indices = export_route_target_indices
        surface.export_route_target_names = export_route_target_names
        surface.export_route_is_glob = export_route_is_glob
        registry.surfaces[surface_index] = surface
        surface_index = surface_index + 1

    surface_index = 0
    while surface_index < registry.surfaces.len():
        if not module_surface_route_arrays_aligned(registry.surfaces[surface_index]):
            return Err("frozen module surface route arrays are misaligned: {surface_index}")
        surface_index = surface_index + 1
    val generation_result = module_surface_allocate_generation()
    if generation_result.is_err():
        return Err(generation_result.unwrap_err())
    val generation = generation_result.unwrap()
    surface_index = 0
    while surface_index < registry.surfaces.len():
        var surface = registry.surfaces[surface_index]
        surface.generation = generation
        surface.frozen = true
        surface.export_origin_index.frozen = true
        registry.surfaces[surface_index] = surface
        surface_index = surface_index + 1
    registry.generation = generation
    registry.frozen = true
    Ok(registry)
