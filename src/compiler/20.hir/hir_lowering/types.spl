# HIR Lowering - Types and Error Handling
#
# This module contains type definitions and error handling for HIR lowering.

use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.frontend.parser_types.*
use compiler.frontend.parser_types_expr.*
use compiler.frontend.parser_types.{TypeParam}
use compiler.common.diagnostics.span.{Span}
use compiler.common.config.{TypeInferenceConfig, TypeDefault}
use compiler.common.visibility.{effective_visibility}
use compiler.common.dependency.visibility.{Visibility}
use compiler.core.types.{custom_primitive_bind_symbol, custom_primitive_is_name}

extern fn rt_env_get(key: text) -> text?
extern fn rt_enum_discriminant(value: TypeKind) -> i64

fn hir_type_env_get(key: text) -> text:
    rt_env_get(key)

fn hir_type_kind_disc(k: TypeKind) -> i64:
    rt_enum_discriminant(k)

# Local placeholder for the module resolver port used in FR-COMPILER-003 A2.
# The actual 85.mdsoc implementation will be wired by the A2 agent at call sites.
# Kept here (layer 20) to avoid a layer violation (20 must not import 85).
struct ModuleResolverPort:
    name: text
    resolve_fn: any

type HirModulesByName = {text: Module}
type HirImplFunctions = {SymbolId: HirFunction}
type HirTraitsByName = {text: HirTrait}
type HirFieldTypesByName = {text: {text: HirType}}
type HirLocalStructTypes = {i64: text}
type HirFieldOrderByName = {text: [text]}
type HirLocalTupleTypes = {i64: [HirType]}

class HirLowering:
    symbols: SymbolTable
    errors: [LoweringError]
    current_function: SymbolId?
    loop_depth: i64
    type_inference_config: TypeInferenceConfig?
    module_filename: text          # Filename/path for visibility matching and defining_module population
    module_resolver: ModuleResolverPort?   # Optional resolver for 2-pass import resolution (FR-COMPILER-003)
    loaded_modules: [text]         # Paths of modules already loaded (for cycle detection in A2 resolve pass)
    modules_by_name: Dict<text, Module>       # All parsed modules keyed by module name (for resolve_import_symbols)
    current_method_self_type: HirType?
    current_method_self_symbol_id: i64
    lowered_impl_functions: HirImplFunctions
    lowered_traits: HirTraitsByName   # Traits lowered in this module (by name), for injecting defaults into impls
    lowered_trait_count_value: i64    # Scalar mirror; diagnostic probes must not materialize Dict.keys().
    imported_traits: HirImportedTraitsByName
    imported_enums: HirImportedEnumsByName
    imported_enum_owners: HirImportedEnumOwners
    # Canonical terminal declaration identities already traversed while
    # materializing enum payload closure. Unlike imported_enums (keyed by a
    # consumer-local alias), this terminates alias-renamed enum/type-alias
    # cycles by physical module + source item + declaration kind.
    materialized_payload_origins: HirMaterializedPayloadOrigins
    # Consumer-local spelling -> canonical terminal declaration identity.
    # This is intentionally separate from the traversal set above: two
    # different terminal items must never silently compete for one spelling.
    materialized_payload_bindings: HirMaterializedPayloadBindings
    # Re-entrancy breaker for the imported-type METHOD registration cycle
    # `register_imported_type_methods` ->
    # `materialize_imported_callable_type_dependencies` ->
    # `register_imported_symbol` -> `register_imported_type_methods`.
    # Two types in one module whose method signatures mention each other
    # re-enter that cycle forever and SIGSEGV Stage 3 on stack exhaustion --
    # doc/08_tracking/bug/stage3_register_imported_type_methods_infinite_recursion_2026-08-17.md
    # Deliberately a plain `[text]` used as a stack, NOT a Dict: every existing
    # breaker in this cycle memoizes on a Dict/symbol-table membership test, and
    # `rt_dict_contains` under-reporting is what silently disabled them once
    # before (see the essay in 20.hir/hir_types.spl). A linear scan over an
    # append-only array has no such fail-open mode, and the depth guarded is
    # type-reference nesting depth, which is small.
    imported_type_methods_in_progress: [text]
    # Exact registration tuples currently expanding. A list is intentional:
    # this is the outer field/method/payload recursion breaker, and a Dict
    # membership false negative would turn a finite type graph into unbounded
    # recursive materialization. Depth is bounded by type-reference nesting.
    registered_import_in_progress: [text]
    # Nested-field-access support (native-build --entry path has no type
    # inference pass, so a `s.arr` Field expr otherwise gets `type_: nil` and
    # MIR defaults its result to i64 -- silently wrong for an array/struct
    # field). struct_field_types_by_name is STATIC (built once from each
    # struct's own declaration: struct name -> field name -> declared HirType)
    # so it needs no inference. local_struct_types is the DYNAMIC half (local
    # variable symbol id -> struct name), populated only for the simple,
    # common `val/var x = StructName(...)` binding shape -- mirrors the MIR
    # layer's struct_value_syms/struct_field_type_name propagation, one layer
    # up, since the actual Field-expr type_ consumer lives in a file this lane
    # may not edit (see doc/... nestedfield lane notes).
    struct_field_types_by_name: HirFieldTypesByName
    local_struct_types: HirLocalStructTypes
    # Declared field NAME order per struct (parallels MIR's own
    # struct_field_order). CallArg.has_name/.name are not reliably populated
    # on this path (observed false/empty for every arg regardless of whether
    # the source used `field: value` named-arg syntax), so both this layer
    # and MIR fall back to positional-order matching against the struct's
    # OWN declared field order to learn which arg feeds which field.
    struct_field_order_by_name: HirFieldOrderByName
    # Tuple analogue of local_struct_types: local variable symbol id ->
    # per-element declared/inferred HirType, populated only for the simple
    # `val/var t = (lit0, lit1, ...)` binding shape (element types are
    # inferred straight from each literal's own AAST kind -- IntLit/
    # FloatLit/StringLit/BoolLit -- since there is no general inference pass
    # on this path). Lets a later `t.0`/`t.1` positional field access or a
    # non-literal tuple destructure (`val (a, b) = t`) recover each element's
    # REAL type instead of defaulting to i64: without this, a tuple element
    # read through a variable (as opposed to a fresh literal) always decoded
    # as i64 downstream, silently printing garbage for any non-i64 element
    # (e.g. a text field) of a mixed-type tuple -- see is_tuple_positional_field
    # in expressions.spl and lower_tuple_destructure below.
    local_tuple_types: HirLocalTupleTypes
    # Set of every enum-variant short name declared in this compilation
    # (populated up-front in module_lowering pre-scan, parallel to
    # struct_field_order_by_name). Used by lower_pattern to keep a bare
    # positional pattern like `case Const(a, b, c):` a REFUTABLE enum-variant
    # pattern when the subject enum owns a `Const` variant, even though an
    # unrelated `class Const` is also registered -- without this guard the
    # struct-positional reinterpretation (irrefutable) silently wins and the
    # arm is always taken (native_const_pattern_lowers_irrefutably bug).
    enum_variant_names: {text: bool}
    # True while registering IMPORTED/sibling symbols: signature diagnostics
    # (untyped returns, unlowerable param types) belong to the DEFINING
    # module's own lowering pass, not the importer's — errors here are
    # suppressed and the symbol registers untyped (nil type) instead.
    registering_import_symbols: bool
    # Function name -> tuple element types of its DECLARED tuple return type
    # (`fn f(...) -> (text, text, i32)`), captured in module_lowering's
    # signature-registration pass straight off the freshly lower_type'd
    # return HirType. Lets lower_tuple_destructure type each element of
    # `val (a, b, c) = f(...)` (a CALL init has no local_tuple_types entry).
    # A by-NAME side registry is used deliberately instead of reading the
    # Function symbol's stored type_ back out of the symbol table at
    # destructure time: extracting the Tuple payload from a symbol-table-
    # stored HirTypeKind.Function later yields garbage on the seed
    # interpreter (cross-pass enum-payload landmine, observed disc
    # 2735847868), while a fresh same-pass extraction is reliable.
    fn_tuple_returns: {text: [HirType]}
    # GLB2 (2026-08-01): per-ROOT memo for register_glob_imported_symbols_depth.
    # Maps a canonical module KEY -> the shallowest depth at which that key has
    # already been glob-expanded during the CURRENT root expansion. The glob
    # graph is cyclic (168 directed 2-cycles over 3,026 `use x.*` edges), so
    # before this the depth-8 cap was the only terminator and a single root
    # re-expanded the same modules exponentially. Keyed on the resolution KEY
    # (not surface.module_name) because relative sub-paths resolve against it.
    # Shallowest-depth (not a plain visited set) so a module first reached at
    # depth 8 can still be re-expanded from a shallower arrival, which is what
    # keeps the depth cap's reachable set intact.
    glob_expand_memo: {text: i64}
    # PKGDEP (2026-08-21): package-sibling FIELD-dependency resolution memo.
    # `materialize_imported_field_package_dependency` scans every surface in
    # the frozen registry (662 in a full bootstrap) for each unresolved field
    # dependency, calling module_surface_package_name (split/join alloc) and
    # hir_module_declares_item per candidate. The registry is frozen for the
    # whole HIR phase, so the answer for a (package, dependency) pair never
    # changes; without this memo the same scan is repeated once per importing
    # module, making the pass O(modules x registry x deps). Value is the
    # selected surface index, or -1 for "no unique declaring sibling" (which
    # covers both the not-found and the ambiguous case -- both are no-ops).
    field_package_dep_memo: {text: i64}
    # Per-surface package name cache for the same scan (keyed by module_name).
    surface_package_name_memo: {text: text}
    # Full-registry scans actually performed by the package-dependency
    # fallback. Observable mechanism counter for the memo above; a spec
    # pins that repeated identical queries do not raise it.
    field_package_dep_scan_count: i64
    # PKGIDX (2026-08-21): inverted index over the FROZEN registry, declaration
    # name -> owning surface indices. Replaces the per-item full sweeps in
    # try_register_bootstrap_global_symbol (called lazily from BODY lowering for
    # every unbound name -- see BGS1 in _Items/module_import_registration.spl)
    # and in materialize_imported_field_package_dependency. Built once per
    # lowerer; the registry cannot change while it is frozen.
    surface_decl_owners: {text: [i64]}
    surface_decl_index_built: bool
    # Times the index above was actually built. A spec pins this at 1 across
    # many queries, which is the mechanism the wall clock only hints at.
    surface_decl_index_build_count: i64
    # PKGIDX: canonical package name -> member modules, for
    # resolve_package_sibling_symbols, which swept every registry KEY (with a
    # canonicalization per key) once per module lowered.
    package_sibling_names: {text: [text]}
    package_sibling_canons: {text: [text]}
    package_sibling_index_built: bool
    package_sibling_index_build_count: i64
    # PKGIDX: registry KEY -> surface index. hir_module_surface_index compared
    # every key linearly and is called per import / per sibling / per re-export
    # hop; this is the same answer as a dict probe.
    surface_index_by_name: {text: i64}
    surface_index_by_name_built: bool
    surface_index_by_name_build_count: i64
    # RISFACT (2026-08-21): phase-invariant facts about a DECLARING module's
    # own `use` items, reused across every importer.
    # `materialize_imported_callable_explicit_dependency` swept
    # `imported_mod.imports` x `import.items` for ONE dependency name, and it is
    # reached on every qualified-type MISS -- per param, per callable, per
    # importing module. The answer ("which surface, under which item name, does
    # the DECLARING module explicitly import `dep` from") depends only on the
    # frozen registry and the declaring surface, never on the importer, so the
    # miss is recomputed identically 662 times in the bootstrap closure.
    # Deliberately SymbolId-free: the value is a registry INDEX plus the item
    # NAME. Registry indices are stable for the phase, whereas SymbolIds are
    # allocated per module and restart at 0 on `symbols.reset_module()`
    # (hir_types.spl), which is why the two previously proposed memos in
    # hir_phase_per_module_cost_2026-08-21.md were rejected. Each importer
    # re-runs the actual `register_imported_symbol` / `bind_qualified_type`
    # against its OWN table using these facts; only the RESOLUTION is shared.
    # Negative and ambiguous results are cached too -- they are the repeated
    # cost, since a name that never resolves is re-swept by every importer.
    # -1 = no explicit import declares it, -2 = ambiguous (the error is
    # re-emitted per importer so diagnostics are unchanged).
    explicit_dep_target_memo: {text: i64}
    explicit_dep_item_memo: {text: text}
    # RISDONE (2026-08-21): completed-registration memo for
    # `register_imported_symbol`, keyed on
    # `{declaring module} {imported name} {local name} {materialize_enum}`.
    # Unlike `explicit_dep_target_memo` this is NOT phase-invariant: the body
    # writes into the IMPORTING module's symbol table, so the memo is owned by
    # one importer and is cleared the moment `module_filename` names a
    # different module (see `registered_import_memo_owner`). Within one
    # importer the registration is idempotent -- every branch re-checks
    # `already_bound` / `contains_key` before it writes -- so a repeat of the
    # same key can only redo the six surface name scans and re-descend the
    # same field/method subtree. driver.spl issued 8,284 registrations for a
    # far smaller distinct set; that re-descent is what made field_dep cost
    # 377 s of a 427 s module (hir_phase_per_module_cost_2026-08-21.md).
    registered_import_memo: {text: bool}
    # Importer that `registered_import_memo` describes ("" = none yet).
    registered_import_memo_owner: text
    # Registrations skipped by the memo. Observable mechanism counter: a spec
    # pins that repeating one (module, name, local, enum) query registers once.
    registered_import_skip_count: i64
    # IMPLIDX (2026-08-22): impl positions per (frozen surface, implemented
    # type name). `register_imported_type_methods_inner` swept EVERY impl of
    # the declaring module per imported composite/enum, copying each impl row
    # (and its methods Dict) under value semantics -- 93 ms of a 120 ms
    # registration on a 100-impl module, O(impls) per symbol and O(impls^2)
    # per module. The index is a pure function of the frozen registry
    # (`{generation} {physical_index}` -> built; `... {type name}` -> rows),
    # so it is phase-invariant and shared across importers, like
    # `explicit_dep_target_memo`. `impl_index_build_count` counts surfaces
    # indexed (one sweep each); `impl_rows_visited` counts impl rows read by
    # method registration after indexing, so a spec can pin both bounds.
    impl_index_built: {text: bool}
    impl_index_positions: {text: [i64]}
    impl_index_build_count: i64
    impl_rows_visited: i64
    # NAMEIDX (2026-08-22): name -> position per frozen surface, per
    # declaration kind (`{generation} {physical_index} {C|E|T|A|F|K} {name}`).
    # `register_imported_symbol_inner` used to run six linear
    # `module_surface_name_position` sweeps per FIRST-TIME registration
    # (~0.75 ms at 100 names per surface on the interpreted seed); the index is
    # built by one sweep per surface and every later probe is a Dict read.
    # Pure function of the frozen registry, so shared across importers like
    # `impl_index_positions`. First occurrence wins, exactly like the scan.
    name_index_built: {text: bool}
    name_index_positions: {text: i64}
    name_index_build_count: i64
    # Sweeps actually performed. Observable mechanism counter for the memo
    # above; a spec pins that N importers of one surface cause exactly one
    # sweep per (surface, dependency) pair.
    explicit_dep_scan_count: i64
    # REXMEMO (2026-08-21): root re-export memo, "{physical surface index}
    # {wanted}" -> terminal surface index (-1 = complete, valid MISS) plus the
    # terminal item name. Registry aliases share one entry because the key is
    # the PHYSICAL index. The answer depends only on the frozen registry, so
    # the memo is registry-pure: it survives `begin_module` and is dropped
    # only when `module_surfaces.generation` changes (find_reexport_source).
    # A depth-truncated or invalid walk is never recorded. Replaces the five
    # parallel arrays d757f7d70d0 deleted: those were scanned linearly per
    # query and capped at 512 rows; a Dict probe is O(1) and uncapped.
    reexport_root_memo_index: {text: i64}
    reexport_root_memo_item: {text: text}
    reexport_visit_surface_indices: [i64]
    reexport_visit_wanted: [text]
    reexport_visit_depths: [i64]
    reexport_generation: i64
    reexport_registry_valid: bool
    reexport_walk_complete: bool
    reexport_walk_valid: bool
    # Work counters for the blowup measurement; reported only when
    # SIMPLE_HIR_REEXPORT_STATS=1 (level-gated, default off).
    reexport_chase_calls: i64
    reexport_chase_memo_hits: i64

struct LoweringError:
    message: text
    span: Span
    kind: LoweringErrorKind

enum LoweringErrorKind:
    UnresolvedName
    DuplicateDefinition
    TypeMismatch
    InvalidPattern
    InvalidExpression
    Other

fn hirlowering_new() -> HirLowering:
    val empty_errors: [LoweringError] = []
    val empty_loaded_modules: [text] = []
    val empty_modules_by_name: HirModulesByName = {}
    val empty_impl_functions: HirImplFunctions = {}
    val empty_traits: HirTraitsByName = {}
    val empty_struct_field_types: HirFieldTypesByName = {}
    val empty_local_struct_types: HirLocalStructTypes = {}
    val empty_struct_field_order: HirFieldOrderByName = {}
    val empty_local_tuple_types: HirLocalTupleTypes = {}
    val empty_enum_variant_names: {text: bool} = {}
    val empty_fn_tuple_returns: {text: [HirType]} = {}
    val empty_glob_expand_memo: {text: i64} = {}
    val empty_field_package_dep_memo: {text: i64} = {}
    val empty_surface_package_name_memo: {text: text} = {}
    val empty_surface_decl_owners: {text: [i64]} = {}
    val empty_package_sibling_names: {text: [text]} = {}
    val empty_package_sibling_canons: {text: [text]} = {}
    val empty_surface_index_by_name: {text: i64} = {}
    val empty_explicit_dep_target_memo: {text: i64} = {}
    val empty_explicit_dep_item_memo: {text: text} = {}
    val empty_registered_import_memo: {text: bool} = {}
    val empty_impl_index_built: {text: bool} = {}
    val empty_impl_index_positions: {text: [i64]} = {}
    val empty_name_index_built: {text: bool} = {}
    val empty_name_index_positions: {text: i64} = {}
    val empty_reexport_root_memo_index: {text: i64} = {}
    val empty_reexport_root_memo_item: {text: text} = {}
    val empty_imported_type_methods_in_progress: [text] = []
    val empty_registered_import_in_progress: [text] = []
    val empty_reexport_visit_surface_indices: [i64] = []
    val empty_reexport_visit_wanted: [text] = []
    val empty_reexport_visit_depths: [i64] = []
    HirLowering(
        symbols: SymbolTable.new(),
        errors: [],
        current_function: nil,
        loop_depth: 0,
        type_inference_config: nil,
        module_filename: "",
        module_resolver: nil,
        loaded_modules: [],
        modules_by_name: {},
        current_method_self_type: nil,
        current_method_self_symbol_id: -1,
        lowered_impl_functions: empty_impl_functions,
        lowered_traits: empty_traits,
        lowered_trait_count_value: 0,
        imported_traits: empty_imported_traits,
        imported_enums: empty_imported_enums,
        imported_enum_owners: empty_imported_enum_owners,
        materialized_payload_origins: empty_materialized_payload_origins,
        materialized_payload_bindings: empty_materialized_payload_bindings,
        imported_type_methods_in_progress: empty_imported_type_methods_in_progress,
        registered_import_in_progress: empty_registered_import_in_progress,
        struct_field_types_by_name: empty_struct_field_types,
        local_struct_types: empty_local_struct_types,
        struct_field_order_by_name: empty_struct_field_order,
        local_tuple_types: empty_local_tuple_types,
        enum_variant_names: empty_enum_variant_names,
        registering_import_symbols: false,
        fn_tuple_returns: empty_fn_tuple_returns,
        glob_expand_memo: empty_glob_expand_memo,
        field_package_dep_memo: empty_field_package_dep_memo,
        surface_package_name_memo: empty_surface_package_name_memo,
        field_package_dep_scan_count: 0,
        surface_decl_owners: empty_surface_decl_owners,
        surface_decl_index_built: false,
        surface_decl_index_build_count: 0,
        package_sibling_names: empty_package_sibling_names,
        package_sibling_canons: empty_package_sibling_canons,
        package_sibling_index_built: false,
        package_sibling_index_build_count: 0,
        surface_index_by_name: empty_surface_index_by_name,
        surface_index_by_name_built: false,
        surface_index_by_name_build_count: 0,
        explicit_dep_target_memo: empty_explicit_dep_target_memo,
        explicit_dep_item_memo: empty_explicit_dep_item_memo,
        explicit_dep_scan_count: 0,
        registered_import_memo: empty_registered_import_memo,
        registered_import_memo_owner: "",
        registered_import_skip_count: 0,
        impl_index_built: empty_impl_index_built,
        impl_index_positions: empty_impl_index_positions,
        impl_index_build_count: 0,
        impl_rows_visited: 0,
        name_index_built: empty_name_index_built,
        name_index_positions: empty_name_index_positions,
        name_index_build_count: 0,
        reexport_root_memo_index: empty_reexport_root_memo_index,
        reexport_root_memo_item: empty_reexport_root_memo_item,
        reexport_visit_surface_indices: empty_reexport_visit_surface_indices,
        reexport_visit_wanted: empty_reexport_visit_wanted,
        reexport_visit_depths: empty_reexport_visit_depths,
        reexport_generation: 0,
        reexport_registry_valid: false,
        reexport_walk_complete: true,
        reexport_walk_valid: true,
        reexport_chase_calls: 0,
        reexport_chase_memo_hits: 0
    )

fn hirlowering_for_module(filename: text, modules_by_name: Dict<text, Module>) -> HirLowering:
    var lowering = hirlowering_new()
    lowering.module_filename = filename
    lowering.modules_by_name = modules_by_name
    lowering

impl HirLowering:
    # Re-entrancy stack accessors for `imported_type_methods_in_progress`.
    #
    # These exist ONLY so the guard's push/peek/pop stay in the module that
    # DECLARES the class. Reading that field directly from the sibling
    # `_Items/module_lowering.spl` (an `impl HirLowering:` in a DIFFERENT
    # module) made native-build's semantic pass abort the whole worker with
    # "class `HirLowering` has no field named
    # `imported_type_methods_in_progress`", even though the field is declared
    # here and the seed interpreter resolved it fine — the same bare-name
    # class-surface divergence recorded at 10.frontend/ast.spl:65 and
    # _Items/module_lowering.spl:2029. Every other cross-module field on this
    # class predates that surface, so only a newly added one trips it.
    # Divergence filed: doc/08_tracking/bug/native_build_class_surface_misses_newly_added_field_2026-08-17.md
    # Do NOT inline these back into module_lowering.spl.
    me imported_type_methods_in_progress_has(key: text) -> bool:
        for in_progress in self.imported_type_methods_in_progress:
            if in_progress == key:
                return true
        false

    me imported_type_methods_in_progress_push(key: text):
        self.imported_type_methods_in_progress = self.imported_type_methods_in_progress.push(key)

    me imported_type_methods_in_progress_pop(key: text):
        var unwound: [text] = []
        for in_progress in self.imported_type_methods_in_progress:
            if in_progress != key:
                unwound = unwound.push(in_progress)
        self.imported_type_methods_in_progress = unwound

    me begin_module(filename: text):
        """Reset transient module state without replacing retained owners."""
        # Diagnostics are stable no-GC owners. Clear them in place.
        self.errors.clear()
        self.diagnostic_messages.clear()
        self.diagnostic_recovered.clear()
        val fresh = hirlowering_new()

        self.symbols = fresh.symbols
        self.current_function = fresh.current_function
        self.loop_depth = fresh.loop_depth
        self.type_inference_config = preserved_inference_config
        self.module_filename = filename
        self.module_resolver = nil
        self.loaded_modules.clear()
        self.current_method_self_type = nil
        self.current_method_self_symbol_id = -1
        # A Dict-typed class-field receiver loses its HIR type on the native
        # self-host path, so `.clear()` can fall through to the string arm and
        # leave stale module names behind. Fresh field stores are unambiguous;
        # this is the same owner-safe reset used by SymbolTable.reset_module.
        self.lowered_impl_functions = {}
        # lowered_traits, module_surfaces, type_inference_config, re-export root
        # caches, generation, and counters are retained reference-bound state.
        self.imported_traits = {}
        self.imported_enums = {}
        self.imported_enum_owners = {}
        self.materialized_payload_origins = {}
        self.materialized_payload_bindings = {}
        # Must already be empty here (the guard pops what it pushes, and the
        # cycle cannot span a module boundary), so this is belt-and-braces: a
        # stale entry would silently SKIP a needed method registration rather
        # than recurse, which is the quieter and more dangerous failure.
        self.imported_type_methods_in_progress = []
        self.struct_field_types_by_name = {}
        self.local_struct_types = {}
        self.struct_field_order_by_name = {}
        self.local_tuple_types = {}
        self.enum_variant_names = {}
        self.registering_import_symbols = false
        self.fn_tuple_returns = {}
        self.glob_expand_memo = {}
        self.reexport_visit_surface_indices.clear()
        self.reexport_visit_wanted.clear()
        self.reexport_visit_depths.clear()
        self.reexport_walk_complete = true
        self.reexport_walk_valid = true

    me promote_transient_compilation_roots() -> bool:
        """Retain only HIR state that intentionally crosses module scopes.

        The streaming Stage-3 driver calls this after lowering has completed
        and after the transient scope is paused.  Never promote `self`: most
        fields below the retained roots are per-module symbol/import/type
        scratch and retaining that graph costs tens of MiB per source.
        """
        var promoted = true
        # Diagnostics are consumed by the driver after the scope closes.
        if not rt_transient_heap_promote(self.errors):
            promoted = false
        if not rt_transient_heap_promote(self.diagnostic_messages):
            promoted = false
        if not rt_transient_heap_promote(self.diagnostic_recovered):
            promoted = false
        # These are the only lowering-owned graphs used by later modules.
        if not rt_transient_heap_promote(self.lowered_traits):
            promoted = false
        if not rt_transient_heap_promote(self.reexport_root_surface_indices):
            promoted = false
        if not rt_transient_heap_promote(self.reexport_root_wanted):
            promoted = false
        if not rt_transient_heap_promote(self.reexport_root_found):
            promoted = false
        if not rt_transient_heap_promote(self.reexport_root_terminal_indices):
            promoted = false
        if not rt_transient_heap_promote(self.reexport_root_items):
            promoted = false
        promoted

    me detach_transient_module_scratch():
        """Detach every non-retained module graph before transient scope end.

        This runs while the scope is paused, so the fresh empty owner shells
        are durable (scope 0) while the old parse/lowering scratch remains
        tagged to the just-finished scope and is reclaimed by scope_end.
        The final HirModule has already promoted the old SymbolTable graph.
        """
        self.symbols = SymbolTable.new()
        self.current_function = nil
        self.loop_depth = 0
        self.module_resolver = nil
        self.loaded_modules = []
        self.current_method_self_type = nil
        self.current_method_self_symbol_id = -1
        self.lowered_impl_functions = {}
        self.imported_traits = {}
        self.imported_enums = {}
        self.imported_enum_owners = {}
        self.materialized_payload_origins = {}
        self.materialized_payload_bindings = {}
        self.imported_type_methods_in_progress = []
        self.struct_field_types_by_name = {}
        self.local_struct_types = {}
        self.struct_field_order_by_name = {}
        self.local_tuple_types = {}
        self.enum_variant_names = {}
        self.registering_import_symbols = false
        self.fn_tuple_returns = {}
        self.glob_expand_memo = {}
        self.reexport_visit_surface_indices = []
        self.reexport_visit_wanted = []
        self.reexport_visit_depths = []
        self.reexport_walk_complete = true
        self.reexport_walk_valid = true

    me retained_reexport_root_count() -> i64:
        self.reexport_root_surface_indices.len()

    static fn new() -> HirLowering:
        hirlowering_new()

    static fn with_filename(filename: text) -> HirLowering:
        HirLowering(
            symbols: SymbolTable.new(),
            errors: [],
            current_function: nil,
            loop_depth: 0,
            type_inference_config: nil,
            module_filename: filename,
            module_resolver: nil,
            loaded_modules: [],
            modules_by_name: {},
            current_method_self_type: nil,
            lowered_impl_functions: {}
        )

    static fn with_config(config: TypeInferenceConfig) -> HirLowering:
        var lowering = hirlowering_new()
        lowering.type_inference_config = Some(config)
        lowering

    me error(message: text, span: Span):
        self.errors = self.errors.push(LoweringError(
            message: message,
            span: span,
            kind: LoweringErrorKind.Other
        ))

    me recovered(message: text, span: Span):
        self.errors = self.errors.push(LoweringError(
            message: message,
            span: span,
            kind: LoweringErrorKind.Recovered
        ))

    me promote_diagnostics_transient_owner() -> bool:
        # These parallel owners form one diagnostic record stream. Promote all
        # three or fail closed; promoting only errors leaves scalar projections
        # dangling after the per-file lowering scope ends.
        val errors_ok = rt_transient_heap_promote(self.errors)
        val messages_ok = rt_transient_heap_promote(self.diagnostic_messages)
        val recovered_ok = rt_transient_heap_promote(self.diagnostic_recovered)
        errors_ok and messages_ok and recovered_ok

    me lower_type(t: Type) -> HirType:
        val kind = match t.kind:
            case Named(name, args):
                val hir_args = self.lower_type_list(args)

                # Check for builtin types
                match name:
                    case "i8": HirTypeKind.Int(8, true)
                    case "i16": HirTypeKind.Int(16, true)
                    case "i32": HirTypeKind.Int(32, true)
                    case "i64": HirTypeKind.Int(64, true)
                    case "u8": HirTypeKind.Int(8, false)
                    case "u16": HirTypeKind.Int(16, false)
                    case "u32": HirTypeKind.Int(32, false)
                    case "u64": HirTypeKind.Int(64, false)
                    case "f32": HirTypeKind.Float(32)
                    case "f64": HirTypeKind.Float(64)
                    case "bool": HirTypeKind.Bool
                    case "char": HirTypeKind.Char
                    case "text" | "str" | "String": HirTypeKind.Str
                    case "Result":
                        if hir_args.len() == 2:
                            HirTypeKind.Result(hir_args[0], hir_args[1])
                        else:
                            self.error("Result type expects 2 type arguments", t.span)
                            HirTypeKind.Error
                    case _:
                        val symbol = self.symbols.lookup(name)
                        if symbol.?:
                            val symbol_id = symbol.unwrap()
                            if custom_primitive_is_name(name):
                                custom_primitive_bind_symbol(name, symbol_id.id)
                            HirTypeKind.Named(symbol_id, hir_args)
                        else:
                            self.error("unresolved type: {name}", t.span)
                            HirTypeKind.Error

        # Extract in the frontend owner module, where HirTypeKind.Named is not
        # in scope and cannot collide with TypeKind.Named on stage4.
        if kind_disc_v == d_named:
            val nm: text = parser_type_kind_named_name(lt_kind)
            val nargs: [Type] = parser_type_kind_named_args(lt_kind)
            if hir_type_env_get("SIMPLEOS_FOCUSED_HIR_DIAG") == "1":
                eprint("[hir-type-named] {nm}")
            if nm == "":
                self.error("internal: failed to extract named type", lt.span)
                return HirType(kind: HirTypeKind.Error, span: lt.span)
            val named_kind = self.lower_named_kind(nm, self.lower_type_list(nargs), lt.span)
            return HirType(kind: named_kind, span: lt.span)

        val d_tuple: i64 = hir_type_kind_disc(TypeKind.Tuple([]))
        val d_array: i64 = hir_type_kind_disc(TypeKind.Array(lt, nil))
        val d_func: i64 = hir_type_kind_disc(TypeKind.Function([], lt))
        val d_opt: i64 = hir_type_kind_disc(TypeKind.Optional(lt))
        val d_ref: i64 = hir_type_kind_disc(TypeKind.Reference(lt, false))
        val d_union: i64 = hir_type_kind_disc(TypeKind.Union([]))
        val d_proj: i64 = hir_type_kind_disc(TypeKind.Projection(lt, ""))

        var kind: HirTypeKind = HirTypeKind.Infer(0, 0)
        if kind_disc_v == d_tuple:
            var elems: [Type] = []
            match lt_kind:
                case TypeKind.Tuple(elements):
                    elems = elements
                case _:
                    pass
            if elems.is_empty():
                kind = HirTypeKind.Unit
            else:
                kind = HirTypeKind.Tuple(self.lower_type_list(elems))
        elif kind_disc_v == d_array:
            var elem: Type = lt
            match lt_kind:
                case TypeKind.Array(element, size):
                    elem = element
                case _:
                    pass
            kind = HirTypeKind.Array(self.lower_type(elem), nil)
        elif kind_disc_v == d_func:
            var fparams: [Type] = []
            var fret: Type = lt
            match lt_kind:
                case TypeKind.Function(params, ret):
                    fparams = params
                    fret = ret
                case _:
                    pass
            kind = HirTypeKind.Function(self.lower_type_list(fparams), self.lower_type(fret), [])
        elif kind_disc_v == d_opt:
            var oinner: Type = lt
            match lt_kind:
                case TypeKind.Optional(inner):
                    oinner = inner
                case _:
                    pass
            kind = HirTypeKind.Optional(self.lower_type(oinner))
        elif kind_disc_v == d_ref:
            var rinner: Type = lt
            var rmut: bool = false
            match lt_kind:
                case TypeKind.Reference(inner, mutable):
                    rinner = inner
                    rmut = mutable
                case _:
                    pass
            kind = HirTypeKind.Ref(self.lower_type(rinner), rmut)
        elif kind_disc_v == d_union:
            var umembers: [Type] = []
            match lt_kind:
                case TypeKind.Union(members):
                    umembers = members
                case _:
                    pass
            val hir_members = self.lower_type_list(umembers)
            if hir_members.len() == 0:
                kind = HirTypeKind.Unit
            elif hir_members.len() == 1:
                kind = hir_members[0].kind
            else:
                kind = HirTypeKind.Union(hir_members)
        elif kind_disc_v == d_proj:
            var pbase: Type = lt
            var passoc: text = ""
            match lt_kind:
                case TypeKind.Projection(base, assoc_name):
                    pbase = base
                    passoc = assoc_name
                case _:
                    pass
            kind = HirTypeKind.Projection(self.lower_type(pbase), passoc)
        else:
            # Infer / Atomic / Isolated / Error and any unrecognized disc.
            kind = HirTypeKind.Infer(0, 0)

        HirType(kind: kind, span: lt.span)

    me lower_named_kind(name: text, hir_args: [HirType], span: Span) -> HirTypeKind:
        # bug: native_result_unwrap silent-wrong tail -- `T?` optional
        # annotations arrive from the flat-AST bridge as Named("Option", [T])
        # (convert_nodes.spl TYPE_OPTION_I64/F64/TEXT/BOOL tags), NOT as
        # TypeKind.Optional (that parser kind is not what the flat path
        # emits). Without this mapping every such annotation fell through to
        # the unresolved-symbol branch below (no `Option` symbol exists) and
        # collapsed to HirTypeKind.Error, so MIR's option_inner_hir_type saw
        # no Optional, typed `x.unwrap_or(default)` results as I64, and
        # print() rendered the raw char* of a text default as a decimal
        # pointer (e.g. `absent_text.unwrap_or("fallback")` printed
        # `101808922192363`). Mirror the Result/Dict special cases in the
        # match: build the real HirTypeKind.Optional. A bare argless
        # `Option` (the parser only threads i64/f64/text/bool inners through
        # dedicated tags; every other `T?` collapses to plain TYPE_OPTION)
        # deliberately keeps the pre-existing fall-through behavior.
        if name == "Option":
            if hir_args.len() == 1:
                return HirTypeKind.Optional(hir_args[0])
            if hir_args.len() == 0:
                return HirTypeKind.Optional(HirType(
                    kind: HirTypeKind.Any, span: span))
        if name == "FacetRef":
            if hir_args.len() == 1:
                match hir_args[0].kind:
                    case HirTypeKind.Named(facet_symbol, _):
                        if val facet_def = self.symbols.get_symbol_raw(facet_symbol.id):
                            val owner = facet_def.defining_module ?? self.module_filename
                            val facet_key = facet_static_key(owner, facet_def.name)
                            if not facet_static_interface_declared_key(facet_key):
                                self.error("FacetRef type argument must name a declared facet interface", span)
                                return HirTypeKind.Error
                            match facet_def.kind:
                                case SymbolKind.Trait:
                                    return HirTypeKind.FacetRef(hir_args[0], "")
                                case _:
                                    self.error("FacetRef type argument must have trait/interface kind", span)
                                    return HirTypeKind.Error
                    case _:
                        self.error("FacetRef type argument must be a named facet interface", span)
                        return HirTypeKind.Error
            self.error("FacetRef type expects exactly one facet interface argument", span)
            return HirTypeKind.Error
        # SEED-PARITY (2026-08-01): `has_X` spells an optional X.
        # The seed (type_resolver.rs:128) strips a `has_` prefix and re-resolves
        # the base as `Type::Optional(base)`. Legacy compiler sources use this
        # spelling; without the rule every `has_*` annotation reached the strict
        # gate below and hard-errored.
        #
        # Placed BEFORE the symbol lookup to match the seed's order exactly.
        # That ordering is only safe because NO type in this tree is declared
        # `has_*` (verified by declaration grep over src/**/*.spl), so the rule
        # cannot shadow a real user type here.
        if name.starts_with("has_") and name.len() > 4:
            val has_base = name[4:]
            return HirTypeKind.Optional(HirType(kind: self.lower_named_kind(has_base, [], span), span: span))
        # SEED-PARITY (2026-08-01): `Self` resolves to the enclosing class /
        # trait-impl type. The seed (type_resolver.rs:8 resolve_self_type)
        # returns `current_class_type`, falling back to ANY under lenient_types.
        # This layer already tracks the identical context in
        # `current_method_self_type` (set by _Items/declaration_lowering.spl:528
        # for a class body and _Items/trait_impl_lowering.spl:199 for an impl
        # block), so this is real self-type resolution, not a scalar table entry.
        #
        # Outside any class/impl `Self` is genuinely meaningless; recover to Any
        # (mirroring the seed's lenient branch, which is the mode the
        # bootstrap/native-build path runs in) rather than hard-erroring.
        if name == "Self":
            if val self_ty = self.current_method_self_type:
                return self_ty.kind
            self.recovered("unresolved type: Self", span)
            return HirTypeKind.Any
        match name:
            case "i8": HirTypeKind.Int(8, true)
            case "i16": HirTypeKind.Int(16, true)
            case "i32": HirTypeKind.Int(32, true)
            case "i64" | "Int" | "int": HirTypeKind.Int(64, true)
            case "u8": HirTypeKind.Int(8, false)
            case "u16": HirTypeKind.Int(16, false)
            case "u32": HirTypeKind.Int(32, false)
            case "u64": HirTypeKind.Int(64, false)
            case "f32": HirTypeKind.Float(32)
            case "f64": HirTypeKind.Float(64)
            case "bool": HirTypeKind.Bool
            # Seed parity: `"unit" => TypeId::VOID`. Bare `unit` annotations
            # come from inference / cross-module signatures.
            case "unit": HirTypeKind.Unit
            case "char": HirTypeKind.Char
            case "text" | "str" | "String": HirTypeKind.Str
            # `fn(T,...) -> R` param annotations reach here as Named("fn")
            # (the flat bridge carries the callable shape as tag TYPE_FN with
            # no first-class fn-type in the bootstrap registry). Callables are
            # dynamically dispatched — lower like `any` instead of erroring.
            case "fn": HirTypeKind.Any
            case "Result":
                if hir_args.len() == 2:
                    HirTypeKind.Result(hir_args[0], hir_args[1])
                elif hir_args.len() == 0:
                    # Bare `Result` annotations (TYPE_RESULT tag with no T/E
                    # registration) reach here argless from the flat bridge,
                    # mirroring the identical Dict gap fixed above -- erroring
                    # collapsed the whole decl. Dynamic result -- lower as
                    # Result<any, any>.
                    HirTypeKind.Result(HirType(kind: HirTypeKind.Any, span: span), HirType(kind: HirTypeKind.Any, span: span))
                else:
                    HirTypeKind.Tuple(self.lower_type_list(elements))

            case Array(element, size):
                val hir_element = self.lower_type(element)
                HirTypeKind.Array(hir_element, nil)

            case Function(params, ret):
                val hir_params = self.lower_type_list(params)
                val hir_ret = self.lower_type(ret)
                HirTypeKind.Function(hir_params, hir_ret, [])

            case Optional(inner):
                HirTypeKind.Optional(self.lower_type(inner))

            case Reference(inner, mutable):
                HirTypeKind.Ref(self.lower_type(inner), mutable)

            case Union(members):
                val hir_members = self.lower_type_list(members)
                if hir_members.len() == 0:
                    HirTypeKind.Unit
                elif hir_members.len() == 1:
                    hir_members[0].kind
                else:
                    self.error("Dict type expects 2 type arguments", span)
                    HirTypeKind.Error
            case _:
                val qualified_dot = name.last_index_of(".")
                if qualified_dot > 0 and qualified_dot + 1 < name.len():
                    val qualified_module = name[0:qualified_dot]
                    val qualified_member = name[qualified_dot + 1:]
                    val qualified_raw = self.symbols.lookup_qualified_type_raw(qualified_module, qualified_member)
                    if qualified_raw >= 0:
                        return HirTypeKind.Named(SymbolId(id: qualified_raw), hir_args)
                if not self.symbols.lookup(name).?:
                    val _registered_global = self.try_register_bootstrap_global_symbol(name, span)
                val symbol_id = self.symbols.lookup_or_invalid(name)
                if symbol_id.is_valid():
                    if custom_primitive_is_name(name):
                        custom_primitive_bind_symbol(name, symbol_id.id)
                    HirTypeKind.Named(symbol_id, hir_args)
                else:
                    if name == "Any" or (name == "Option" and hir_args.len() == 0):
                        self.recovered("unresolved type: {name}", span)
                    else:
                        self.error("unresolved type: {name}", span)
                    HirTypeKind.Error

    me lower_type_list(types: [Type]) -> [HirType]:
        var result: [HirType] = []
        for t in types:
            result = result.push(self.lower_type(t))
        result

    me lower_type_param(tp: TypeParam) -> HirTypeParam:
        val symbol = self.symbols.define(tp.name, SymbolKind.TypeParam, nil, tp.span, false, false, nil)

        var bounds: [HirType] = []
        for b in tp.bounds:
            bounds = bounds.push(self.lower_type(b))

        val default_ = if tp.default.?: self.lower_type(tp.default) else: nil
        HirTypeParam(
            symbol: symbol,
            name: tp.name,
            bounds: bounds,
            default: default_,
            span: tp.span
        )

    me lower_trait_bound(bound: TraitBound) -> HirTraitBound:
        # Lookup the type parameter symbol
        val type_param_symbol = self.symbols.lookup(bound.type_param).unwrap()

        # Lower the trait type
        val trait_type = self.lower_type(bound.trait_)

        HirTraitBound(
            type_param: type_param_symbol,
            trait_: trait_type,
            span: bound.span
        )

    me lower_trait_bounds(bounds: [TraitBound]) -> [HirTraitBound]:
        var result: [HirTraitBound] = []
        for b in bounds:
            result = result.push(self.lower_trait_bound(b))
        result


# ============================================================================
# Exports
# ============================================================================
