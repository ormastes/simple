"""Concrete type payloads for inferred HIR bindings.

HirStmtKind.Let has a non-optional HirType slot. Absence of an AST annotation
must not become a nil record in that slot. Preserve known initializer types,
including ownership kinds, and otherwise use the lowerer's existing Infer
marker. This does not infer an owner from an untyped expression.
"""

use compiler.hir.hir_definitions.{HirExpr}
use compiler.hir.hir_types.{HirType, HirTypeKind}

pub fn hir_binding_type_or_infer(initializer: HirExpr, bind_optional_payload: bool = false) -> HirType:
    if initializer.has_type_ and initializer.type_ != nil:
        val source_type: HirType = initializer.type_
        if bind_optional_payload:
            match source_type.kind:
                case HirTypeKind.Optional(inner):
                    val payload_type: HirType = inner
                    return payload_type
                case _:
                    pass
        return source_type
    HirType(kind: HirTypeKind.Infer(0, 0), span: initializer.span)
