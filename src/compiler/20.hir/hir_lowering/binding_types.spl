"""Concrete type payloads for inferred HIR bindings.

HirStmtKind.Let has a non-optional HirType slot. Absence of an AST annotation
must not become a nil record in that slot. Preserve known initializer types,
including ownership kinds, and otherwise use the lowerer's existing Infer
marker. This does not infer an owner from an untyped expression.
"""

use compiler.hir.hir_definitions.{HirExpr, HirExprKind}
use compiler.hir.hir_types.{HirType, HirTypeKind, SymbolTable, SymbolKind}
use compiler.hir.hir_symbol_table_methods.*

pub fn hir_binding_type_or_infer(initializer: HirExpr, bind_optional_payload: bool = false) -> HirType:
    if initializer.has_type_ and initializer.type_ != nil:
        val source_type: HirType = initializer.type_
        if bind_optional_payload:
            match source_type.kind:
                case HirTypeKind.Optional(inner):
                    val payload_type: HirType = inner
                    return payload_type
                case _:
                    pass
        return source_type
    HirType(kind: HirTypeKind.Infer(0, 0), span: initializer.span)

# A direct call carries its declaration's return type in the caller symbol
# table even when the expression itself is not yet attributed. This is type
# transport, not generic inference or a leaf-name callable search.
pub fn hir_binding_direct_call_return(source: HirExpr, symbols: SymbolTable) -> HirType?:
    match source.kind:
        case HirExprKind.Call(callee, _, type_args):
            if type_args.len() != 0: return nil
            var callee_id: i64 = -1
            match callee.kind:
                case HirExprKind.Var(symbol) | HirExprKind.NamedVar(symbol, _): callee_id = symbol.id
                case _: return nil
            if val declaration = symbols.get_symbol_raw(callee_id):
                if declaration.kind != SymbolKind.Function or declaration.generic_param_count != 0: return nil
                if val signature = declaration.type_:
                    match signature.kind:
                        case HirTypeKind.Function(_, result, _):
                            if hir_const_type_settled(result): return result
                        case _: ()
        case _: ()
    nil

pub fn hir_const_type_settled(type_: HirType) -> bool:
    """True when `type_` is a concrete storage type for a module global:
    no `Infer`/`Error`/`Any`/`Never`/type parameter/unresolved projection
    at the top or inside any component (generic arguments, elements,
    pointees, result arms, callable signature, union members)."""
    match type_.kind:
        case HirTypeKind.Infer(_, _) | HirTypeKind.Error | HirTypeKind.Any | HirTypeKind.Never: false
        case HirTypeKind.TypeParam(_, _) | HirTypeKind.Projection(_, _): false
        case HirTypeKind.Named(_, args):
            val named_args: [HirType] = args
            hir_const_types_settled(named_args)
        case HirTypeKind.Union(members):
            val union_members: [HirType] = members
            hir_const_types_settled(union_members)
        case HirTypeKind.Function(params, ret, _):
            val fn_params: [HirType] = params
            val fn_ret: HirType = ret
            hir_const_types_settled(fn_params) and hir_const_type_settled(fn_ret)
        case HirTypeKind.Result(ok, err):
            val result_ok: HirType = ok
            val result_err: HirType = err
            hir_const_type_settled(result_ok) and hir_const_type_settled(result_err)
        case HirTypeKind.Slice(elem):
            val slice_elem: HirType = elem
            hir_const_type_settled(slice_elem)
        case HirTypeKind.Ref(inner, _) | HirTypeKind.Ptr(inner, _) | HirTypeKind.Isolated(inner):
            val pointee: HirType = inner
            hir_const_type_settled(pointee)
        case HirTypeKind.Unique(inner) | HirTypeKind.Shared(inner) | HirTypeKind.Weak(inner):
            val owned_pointee: HirType = inner
            hir_const_type_settled(owned_pointee)
        case HirTypeKind.Array(elem, _):
            val array_elem: HirType = elem
            hir_const_type_settled(array_elem)
        case HirTypeKind.Optional(inner):
            val optional_inner: HirType = inner
            hir_const_type_settled(optional_inner)
        case HirTypeKind.Dict(key, value):
            val dict_key: HirType = key
            val dict_value: HirType = value
            hir_const_type_settled(dict_key) and hir_const_type_settled(dict_value)
        case HirTypeKind.Tuple(elements):
            val tuple_elements: [HirType] = elements
            hir_const_types_settled(tuple_elements)
        case _: true

fn hir_const_types_settled(types: [HirType]) -> bool:
    for component in types:
        if not hir_const_type_settled(component):
            return false
    true
