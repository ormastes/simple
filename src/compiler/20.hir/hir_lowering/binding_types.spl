"""Concrete type payloads for inferred HIR bindings.

HirStmtKind.Let has a non-optional HirType slot. Absence of an AST annotation
must not become a nil record in that slot. Preserve known initializer types,
including ownership kinds, and otherwise use the lowerer's existing Infer
marker. This does not infer an owner from an untyped expression.
"""

use compiler.hir.hir_definitions.{HirExpr, HirExprKind, MethodResolution}
use compiler.hir.hir_types.{HirType, HirTypeKind, SymbolTable, SymbolKind}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_symbol_table_methods.*

pub fn hir_binding_type_or_infer(initializer: HirExpr, bind_optional_payload: bool = false) -> HirType:
    if initializer.has_type_:
        val source_type: HirType = initializer.type_
        if bind_optional_payload:
            match source_type.kind:
                case HirTypeKind.Optional(inner):
                    val payload_type: HirType = inner
                    return payload_type
                case _:
                    pass
        return source_type
    HirType(kind: HirTypeKind.Infer(0, 0), span: initializer.span)

# `unsafe(capabilities: [...]):` and `nograd:` are value-transparent wrappers:
# the block's value IS its tail expression. Binding-type transport must look
# through them, or `val x = unsafe(...): maybe()` registers `x` with no type
# while `val x = maybe()` registers `text?`, and a later `if val p = x` binds
# its payload with the wrong (unit) slot type -- E-BACKEND-LLVM-CONST-TYPE
# "integer constant cannot define void" at native codegen.
pub fn hir_binding_transparent_kind(kind: HirExprKind) -> HirExprKind:
    match kind:
        case HirExprKind.UnsafeBlock(body):
            if body.has:
                return hir_binding_transparent_kind(body.value.kind)
            kind
        case HirExprKind.NogradBlock(body):
            if body.has:
                return hir_binding_transparent_kind(body.value.kind)
            kind
        case _: kind

# Payload type bound by `expr?`: Ok of a Result, Some of an Optional.
pub fn hir_binding_try_payload(operand: HirType) -> HirType?:
    match operand.kind:
        case HirTypeKind.Result(ok, _): ok
        case HirTypeKind.Optional(inner): inner
        case _: None

# Element type read by `base[i]`: the element of an array/slice, the value of
# a dict. Only a settled element is returned, so a generic `[T]` element (or an
# unknown/Any one) stays untyped instead of being guessed.
pub fn hir_binding_index_element(base: HirType) -> HirType?:
    match base.kind:
        case HirTypeKind.Array(element, _) | HirTypeKind.Slice(element):
            # ANY-transport hazard: annotated rebind (see hir_const_type_settled).
            val array_element: HirType = element
            if hir_const_type_settled(array_element): return array_element
            None
        case HirTypeKind.Dict(_, value):
            val dict_value: HirType = value
            if hir_const_type_settled(dict_value): return dict_value
            None
        case _: None

# Element types of a non-literal tuple destructure (`val (a, b) = f()?`) read
# off the initializer's own resolved type. Only a tuple whose elements are all
# settled counts (callers also require the arity to match); anything else
# returns [] (elements stay untyped, the pre-existing behavior). Each element
# is re-rooted at `span`.
pub fn hir_binding_tuple_elements(value_type: HirType, span: Span) -> [HirType]:
    var out: [HirType] = []
    match value_type.kind:
        case HirTypeKind.Tuple(elements):
            val tuple_elements: [HirType] = elements
            for element in tuple_elements:
                if not hir_const_type_settled(element): return []
                out = out.push(HirType(kind: element.kind, span: span))
        case _: ()
    out

# A direct call carries its declaration's return type in the caller symbol
# table even when the expression itself is not yet attributed. This is type
# transport, not generic inference or a leaf-name callable search.
pub fn hir_binding_direct_call_return_kind(kind: HirExprKind, symbols: SymbolTable) -> HirType?:
    match kind:
        case HirExprKind.Call(callee, _, type_args):
            if type_args.len() != 0: return None
            var callee_id: i64 = -1
            match callee.kind:
                case HirExprKind.Var(symbol) | HirExprKind.NamedVar(symbol, _): callee_id = symbol.id
                case _: return None
            if val declaration = symbols.get_symbol_raw(callee_id):
                if declaration.kind != SymbolKind.Function or declaration.generic_param_count != 0: return None
                if val signature = declaration.type_:
                    match signature.kind:
                        case HirTypeKind.Function(_, result, _):
                            if hir_const_type_settled(result): return result
                        case _: ()
        case _: ()
    None

# Instance-method transport (layout_symbol_function_pattern_owner_2026_10_11):
# `val sym = self.get_symbol(id)` is an Unresolved MethodCall at lowering time,
# so the binding was typed Infer, `if val found = sym` lost the HirSymbol
# payload, and `match found.kind` had no SymbolKind owner -- a bare `Function`
# arm then resolved against parser TypeKind/HirTypeKind.Function instead.
# When the receiver's declared type names a non-generic owner that declares
# the method, carry that method's declared (settled) return type.
fn _hir_method_return_if_settled(symbols: SymbolTable, method_raw_id: i64) -> HirType?:
    if method_raw_id < 0:
        return None
    if val declaration = symbols.get_symbol_raw(method_raw_id):
        if declaration.generic_param_count != 0:
            return None
        if val signature = declaration.type_:
            match signature.kind:
                case HirTypeKind.Function(_, result, _):
                    if hir_const_type_settled(result):
                        return result
                case _: ()
    None

pub fn hir_binding_method_call_return_kind(kind: HirExprKind, symbols: SymbolTable) -> HirType?:
    match kind:
        case HirExprKind.MethodCall(receiver, method, _, resolution):
            var resolved_method_id: i64 = -1
            var is_unresolved = false
            match resolution:
                case MethodResolution.StaticMethod(_, method_id): resolved_method_id = method_id.id
                case MethodResolution.InstanceMethod(_, method_id): resolved_method_id = method_id.id
                case MethodResolution.Unresolved: is_unresolved = true
                case _: ()
            if val resolved_return = _hir_method_return_if_settled(symbols, resolved_method_id):
                return resolved_return
            var receiver_id: i64 = -1
            match receiver.kind:
                case HirExprKind.Var(symbol) | HirExprKind.NamedVar(symbol, _): receiver_id = symbol.id
                case _: ()
            var receiver_type: HirType? = None
            if receiver.has_type_:
                receiver_type = receiver.type_
            elif receiver_id >= 0:
                if val receiver_decl = symbols.get_symbol_raw(receiver_id):
                    receiver_type = receiver_decl.type_
            if val owner_type = receiver_type:
                match owner_type.kind:
                    # `opt.unwrap()` on a declared `T?` binding is `T`. Without
                    # this, `val xs = parsed.unwrap()` stayed untyped: element
                    # reads `xs[i].f` lowered as raw words (wrong value) or,
                    # inside loops, as unit slots ("unsupported LLVM value
                    # conversion from i64 to void", test_runner_mcdc_report).
                    case HirTypeKind.Optional(payload):
                        if method == "unwrap" and hir_const_type_settled(payload): return payload
                    case HirTypeKind.Str:
                        if is_unresolved:
                            if method == "split" or method == "lines" or method == "partition" or method == "rpartition":
                                return HirType(kind: HirTypeKind.Array(HirType(kind: HirTypeKind.Str, span: owner_type.span), None), span: owner_type.span)
                            if method == "trim" or method == "strip" or method == "trim_start" or method == "trim_left" or method == "trim_end" or method == "lower" or method == "to_lower" or method == "upper" or method == "to_upper" or method == "replace" or method == "substring":
                                return HirType(kind: HirTypeKind.Str, span: owner_type.span)
                            if method == "byte_len" or method == "char_count" or method == "index_of" or method == "last_index_of" or method == "byte_at" or method == "char_code_at":
                                return HirType(kind: HirTypeKind.Int(64, true), span: owner_type.span)
                            if method == "starts_with" or method == "ends_with" or method == "contains" or method == "is_empty":
                                return HirType(kind: HirTypeKind.Bool, span: owner_type.span)
                    case HirTypeKind.Array(_, _):
                        if is_unresolved:
                            if method == "join":
                                return HirType(kind: HirTypeKind.Str, span: owner_type.span)
                            if method == "len":
                                return HirType(kind: HirTypeKind.Int(64, true), span: owner_type.span)
                            if method == "is_empty" or method == "contains":
                                return HirType(kind: HirTypeKind.Bool, span: owner_type.span)
                    case HirTypeKind.Named(owner, owner_args):
                        val applied: [HirType] = owner_args
                        if applied.len() != 0: return None
                        if val method_id = symbols.lookup_method_in_type_raw(owner.id, method):
                            if val method_return = _hir_method_return_if_settled(symbols, method_id.id):
                                return method_return
                    case _: ()
        case _: ()
    None

pub fn hir_const_type_settled(type_: HirType) -> bool:
    """True when `type_` is a concrete storage type for a module global:
    no `Infer`/`Error`/`Any`/`Never`/type parameter/unresolved projection
    at the top or inside any component (generic arguments, elements,
    pointees, result arms, callable signature, union members)."""
    match type_.kind:
        case HirTypeKind.Infer(_, _) | HirTypeKind.Error | HirTypeKind.Any | HirTypeKind.Never: false
        case HirTypeKind.TypeParam(_, _) | HirTypeKind.Projection(_, _): false
        case HirTypeKind.Named(_, args):
            val named_args: [HirType] = args
            hir_const_types_settled(named_args)
        case HirTypeKind.Union(members):
            val union_members: [HirType] = members
            hir_const_types_settled(union_members)
        case HirTypeKind.Function(params, ret, _):
            val fn_params: [HirType] = params
            val fn_ret: HirType = ret
            hir_const_types_settled(fn_params) and hir_const_type_settled(fn_ret)
        case HirTypeKind.Result(ok, err):
            val result_ok: HirType = ok
            val result_err: HirType = err
            hir_const_type_settled(result_ok) and hir_const_type_settled(result_err)
        case HirTypeKind.Slice(elem):
            val slice_elem: HirType = elem
            hir_const_type_settled(slice_elem)
        case HirTypeKind.Ref(inner, _) | HirTypeKind.Ptr(inner, _) | HirTypeKind.Isolated(inner):
            val pointee: HirType = inner
            hir_const_type_settled(pointee)
        case HirTypeKind.Unique(inner) | HirTypeKind.Shared(inner) | HirTypeKind.Weak(inner):
            val owned_pointee: HirType = inner
            hir_const_type_settled(owned_pointee)
        case HirTypeKind.Array(elem, _):
            val array_elem: HirType = elem
            hir_const_type_settled(array_elem)
        case HirTypeKind.Optional(inner):
            val optional_inner: HirType = inner
            hir_const_type_settled(optional_inner)
        case HirTypeKind.Dict(key, value):
            val dict_key: HirType = key
            val dict_value: HirType = value
            hir_const_type_settled(dict_key) and hir_const_type_settled(dict_value)
        case HirTypeKind.Tuple(elements):
            val tuple_elements: [HirType] = elements
            hir_const_types_settled(tuple_elements)
        case _: true

fn hir_const_types_settled(types: [HirType]) -> bool:
    for component in types:
        if not hir_const_type_settled(component):
            return false
    true
