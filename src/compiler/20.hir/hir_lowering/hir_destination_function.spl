# Scalar-only function rows and atomic module publication.
# All metadata is retained in module-owned columns/ranges. A receipt is only
# function row plus generation; no per-function aggregate owner exists.
use compiler.hir.hir_lowering.hir_destination_graph.*
use compiler.hir.hir_destination_declaration_metadata.*

impl HirDestinationGraph:
    me function_flag_set(flags: i64, bit: i64) -> bool: flags % (bit * 2) >= bit

    me function_metadata_valid(handle: i64, count: i64, flags: i64) -> bool:
        if not self.range_matches(HD_RANGE_AUX, HD_AUX_RANGE_FUNCTION_METADATA, handle, count): return false
        var function_attr_count = 0
        var export_count = 0
        var driver_count = 0
        var vhdl_count = 0
        var doc_count = 0
        var gpu_count = 0
        var contract_count = 0
        var generic_count = 0
        var attr_flags = 0
        var generic_enabled = false
        var last_shape = HD_AUX_FUNCTION_ATTR - 1
        var offset = 0
        while offset < count:
            val aux = self.range_value_at(handle, HD_AUX_RANGE_FUNCTION_METADATA, offset)
            if aux < 0: return false
            val shape = self.aux_shape[aux]
            if shape < last_shape: return false
            last_shape = shape
            if shape == HD_AUX_FUNCTION_ATTR:
                function_attr_count = function_attr_count + 1
                attr_flags = self.aux_i0[aux]
            elif shape == HD_AUX_EXPORT_ATTR:
                export_count = export_count + 1
            elif shape == HD_AUX_DRIVER_MANIFEST:
                driver_count = driver_count + 1
            elif shape == HD_AUX_VHDL_METADATA:
                vhdl_count = vhdl_count + 1
            elif shape == HD_AUX_DOC:
                doc_count = doc_count + 1
            elif shape == HD_AUX_GPU:
                gpu_count = gpu_count + 1
            elif shape == HD_AUX_CONTRACT:
                contract_count = contract_count + 1
            elif shape == HD_AUX_GENERIC_TEMPLATE:
                generic_count = generic_count + 1
                generic_enabled = self.aux_b0[aux]
            else:
                return false
            offset = offset + 1
        if function_attr_count != 1 or export_count > 1 or driver_count > 1 or vhdl_count > 1 or doc_count > 1 or gpu_count > 1 or contract_count > 1 or generic_count > 1: return false
        if self.function_flag_set(flags, HD_FUNC_HAS_EXPORT) != (export_count == 1): return false
        if self.function_flag_set(flags, HD_FUNC_HAS_DRIVER) != (driver_count == 1): return false
        if self.function_flag_set(flags, HD_FUNC_HAS_VHDL) != (vhdl_count == 1): return false
        if self.function_flag_set(flags, HD_FUNC_HAS_DOC) != (doc_count == 1): return false
        if self.function_flag_set(flags, HD_FUNC_GPU_KERNEL) != (gpu_count == 1): return false
        if self.function_flag_set(flags, HD_FUNC_HAS_CONTRACT) != (contract_count == 1): return false
        if self.function_flag_set(flags, HD_FUNC_GENERIC_TEMPLATE) != (generic_count == 1): return false
        if self.function_flag_set(attr_flags, HD_ATTR_GPU_KERNEL) != self.function_flag_set(flags, HD_FUNC_GPU_KERNEL): return false
        if generic_count == 1 and not generic_enabled: return false
        true
    me ensure_function_capacity(required: i64):
        if required <= self.function_capacity: return
        val target = self.next_capacity(self.function_capacity, required)
        while self.function_ready.len() < target:
            self.function_ready.push(false)
            self.function_module_published.push(false)
            self.function_module_validation_epoch.push(-1)
            self.function_generation.push(-1)
            self.function_module.push(-1)
            self.function_root.push(-1)
            self.function_token.push(-1)
            self.function_symbol.push(-1)
            self.function_name.push("")
            self.function_overload_ordinal.push(-1)
            self.function_type_params.push(-1)
            self.function_params.push(-1)
            self.function_return_type.push(-1)
            self.function_effects.push(-1)
            self.function_metadata.push(-1)
            self.function_visibility.push(0)
            self.function_flags.push(0)
            self.function_span.push(-1)
        self.function_capacity = target

    me reserve_function(module_index: i64, root: i64, symbol: i64, name: text, span_index: i64, overload_ordinal: i64) -> i64:
        if not self.mutable() or module_index < 0 or module_index >= self.module_count or self.module_ready[module_index] or self.module_generation[module_index] != self.generation or symbol < 0 or overload_ordinal < 0 or not self.block_is_ready(root) or span_index < 0 or span_index >= self.span_count:
            self.fail("HIR function reservation payload is not ready")
            return -1
        val i = self.function_count
        self.ensure_function_capacity(i + 1)
        self.function_ready[i] = false
        self.function_module_published[i] = false
        self.function_module_validation_epoch[i] = -1
        self.function_generation[i] = self.generation
        self.function_module[i] = module_index
        self.function_root[i] = root
        self.function_token[i] = -1
        self.function_symbol[i] = symbol
        self.function_name[i] = name
        self.function_overload_ordinal[i] = overload_ordinal
        self.function_type_params[i] = -1
        self.function_params[i] = -1
        self.function_return_type[i] = -1
        self.function_effects[i] = -1
        self.function_metadata[i] = -1
        self.function_visibility[i] = 0
        self.function_flags[i] = 0
        self.function_span[i] = span_index
        self.function_count = i + 1
        self.module_reserved_function_count[module_index] = self.module_reserved_function_count[module_index] + 1
        i

    me finalize_function(i: i64, type_params: i64, type_param_count: i64, params: i64, param_count: i64, return_type: i64, effects: i64, effect_count: i64, metadata: i64, metadata_count: i64, visibility: i64, flags: i64) -> bool:
        if not self.mutable() or i < 0 or i >= self.function_count or self.function_ready[i]: return self.fail("HIR function row is not writable")
        if flags < 0 or flags > HD_FUNC_FLAGS_ALL or visibility < 0 or visibility > 5: return self.fail("HIR function flags or visibility are invalid")
        if not self.range_matches(HD_RANGE_AUX, HD_AUX_RANGE_TYPE_PARAM, type_params, type_param_count) or not self.range_matches(HD_RANGE_AUX, HD_AUX_RANGE_VALUE_PARAM, params, param_count): return self.fail("HIR function parameter ranges are not ready")
        if not self.index_ready(HD_RANGE_TYPE, return_type) or not self.range_is_ready(HD_RANGE_EFFECT, effects, effect_count): return self.fail("HIR function signature is not ready")
        if not self.function_metadata_valid(metadata, metadata_count, flags): return self.fail("HIR function metadata is not canonical")
        val token = self.reserve_pending_function(self.function_root[i])
        if token < 0: return false
        self.function_type_params[i] = type_params
        self.function_params[i] = params
        self.function_return_type[i] = return_type
        self.function_effects[i] = effects
        self.function_metadata[i] = metadata
        self.function_visibility[i] = visibility
        self.function_flags[i] = flags
        self.function_token[i] = token
        self.pending_function[token] = i
        self.function_ready[i] = true
        true

    me all_rows_ready(kind: i64, count: i64) -> bool:
        var i = 0
        while i < count:
            val row_ready = if kind == 1: self.expr_ready[i]
                elif kind == 2: self.block_ready[i]
                elif kind == 3: self.stmt_ready[i]
                elif kind == 4: self.type_ready[i]
                elif kind == 5: self.pattern_ready[i]
                elif kind == 6: self.effect_ready[i]
                elif kind == 7: self.dim_ready[i]
                elif kind == 8: self.aux_ready[i]
                elif kind == 9: self.range_published[i]
                elif kind == 10: self.pending_ready[i]
                else: self.function_ready[i]
            if not row_ready: return false
            i = i + 1
        true

    # Declaration metadata stores graph Type-range handles as scalar foreign
    # keys, not as HDDM child-range receipts.  The exact empty list is -1;
    # every nonempty handle must resolve to a published Type range here while
    # both stores are still BUILDING under the same graph owner.
    me declaration_metadata_type_ranges_valid() -> bool:
        var row = 0
        while row < self.declaration_metadata.count:
            val kind_id = self.declaration_metadata.row_kind[row]
            var handle = -1
            if kind_id == HDDM_TRAIT_DECL:
                handle = self.declaration_metadata.value2[row]
            elif (kind_id == HDDM_TYPE_PARAM or kind_id == HDDM_ASSOC_DECL or
                kind_id == HDDM_ASSOC_IMPL):
                handle = self.declaration_metadata.value0[row]
            if handle >= 0:
                if (not self.range_is_ready_as(HD_RANGE_TYPE,
                    HD_AUX_RANGE_NONE, handle) or self.range_len[handle] <= 0):
                    return false
            row = row + 1
        true

    me freeze_compile() -> bool:
        if not self.mutable() or self.checkpoint_count != 0: return self.fail("HIR destination freeze has active checkpoint")
        if self.block_values.error: return self.fail("HIR BlockValue protocol is poisoned")
        if not self.destination_symbols_valid(): return self.fail("HIR destination symbol bridge is invalid")
        if not self.bv_cross_refs_valid(): return self.fail("HIR destination has invalid BlockValue cross-arena references")
        if not self.all_rows_ready(1, self.expr_count): return self.fail("HIR destination has unpublished expression rows")
        if not self.all_rows_ready(2, self.block_count): return self.fail("HIR destination has unpublished block rows")
        if not self.all_rows_ready(3, self.stmt_count): return self.fail("HIR destination has unpublished statement rows")
        if not self.all_rows_ready(4, self.type_count): return self.fail("HIR destination has unpublished type rows")
        if not self.all_rows_ready(5, self.pattern_count): return self.fail("HIR destination has unpublished pattern rows")
        if not self.all_rows_ready(6, self.effect_count): return self.fail("HIR destination has unpublished effect rows")
        if not self.all_rows_ready(7, self.dim_count): return self.fail("HIR destination has unpublished dimension rows")
        if not self.all_rows_ready(8, self.aux_count): return self.fail("HIR destination has unpublished auxiliary rows")
        if not self.all_rows_ready(9, self.range_count): return self.fail("HIR destination has unpublished ranges")
        if not self.all_rows_ready(10, self.pending_count) or not self.all_rows_ready(11, self.function_count): return self.fail("HIR destination has unpublished functions")
        var module_index = 0
        while module_index < self.module_count:
            if not self.module_ready[module_index] or self.module_generation[module_index] != self.generation: return self.fail("HIR destination has unpublished module rows")
            module_index = module_index + 1
        if not self.module_declaration_ranges_valid(): return self.fail("HIR destination module declaration ranges are invalid")
        var i = 0
        while i < self.function_count:
            val token = self.function_token[i]
            if self.function_generation[i] != self.generation or self.function_module[i] < 0 or self.function_module[i] >= self.module_count or not self.module_ready[self.function_module[i]] or not self.block_is_ready(self.function_root[i]) or token < 0 or token >= self.pending_count or self.pending_root[token] != self.function_root[i]: return self.fail("HIR destination function authority is stale")
            if not self.function_module_published[i]: return self.fail("HIR destination function is absent from module receipt")
            i = i + 1
        # Validate every subordinate owner before changing any frozen bit. The
        # registry serializes this transition, so the following commits cannot
        # observe intervening mutation and are deliberately validation-free.
        if not self.block_values.can_freeze(): return self.fail("HIR destination has unpublished BlockValue rows or projection transaction")
        if not self.destination_symbols.can_freeze(): return self.fail("HIR destination symbols cannot freeze")
        if not self.destination_members.can_freeze(): return self.fail("HIR destination members cannot freeze")
        if not self.destination_module_authority.can_freeze(): return self.fail("HIR destination module authority cannot freeze")
        if not self.destination_declarations.can_freeze(): return self.fail("HIR destination declarations cannot freeze")
        if not self.declaration_metadata_type_ranges_valid(): return self.fail("HIR destination declaration metadata has an invalid type range")
        if not self.declaration_metadata.can_freeze(): return self.fail("HIR destination declaration metadata cannot freeze")
        self.block_values.commit_freeze()
        self.destination_symbols.commit_freeze()
        self.destination_members.commit_freeze()
        self.destination_module_authority.commit_freeze()
        self.destination_declarations.commit_freeze()
        self.declaration_metadata.commit_freeze()
        i = 0
        while i < self.pending_count:
            self.pending_active[i] = true
            i = i + 1
        self.measure_owned_text_payload_bytes()
        self.active_function_count = self.pending_count
        self.ready = true
        true

    me function_receipt_matches(row: i64, generation: i64) -> bool:
        if row < 0 or row >= self.function_count or not self.ready or not self.function_ready[row] or self.function_generation[row] != generation or generation != self.generation: return false
        self.active_receipt_matches(self.function_token[row], generation, self.function_root[row])

    me function_root_at(row: i64, generation: i64) -> i64: if self.function_receipt_matches(row, generation): self.function_root[row] else: -1
    me function_token_at(row: i64, generation: i64) -> i64: if self.function_receipt_matches(row, generation): self.function_token[row] else: -1
    me function_building_matches(row: i64, generation: i64) -> bool:
        self.mutable() and row >= 0 and row < self.function_count and self.function_ready[row] and self.function_generation[row] == generation and generation == self.generation
    me function_root_building_at(row: i64, generation: i64) -> i64: if self.function_building_matches(row, generation): self.function_root[row] else: -1
    me function_token_building_at(row: i64, generation: i64) -> i64: if self.function_building_matches(row, generation): self.function_token[row] else: -1
    me function_module_building_at(row: i64, generation: i64) -> i64: if self.function_building_matches(row, generation): self.function_module[row] else: -1
    me function_symbol_at(row: i64, generation: i64) -> i64: if self.function_receipt_matches(row, generation): self.function_symbol[row] else: -1
    me function_module_at(row: i64, generation: i64) -> i64: if self.function_receipt_matches(row, generation): self.function_module[row] else: -1
    me function_name_at(row: i64, generation: i64) -> text: if self.function_receipt_matches(row, generation): self.function_name[row] else: ""
    me function_overload_ordinal_at(row: i64, generation: i64) -> i64: if self.function_receipt_matches(row, generation): self.function_overload_ordinal[row] else: -1
    me function_flags_at(row: i64, generation: i64) -> i64: if self.function_receipt_matches(row, generation): self.function_flags[row] else: 0
    me function_visibility_at(row: i64, generation: i64) -> i64: if self.function_receipt_matches(row, generation): self.function_visibility[row] else: -1
    me function_span_at(row: i64, generation: i64) -> i64: if self.function_receipt_matches(row, generation): self.function_span[row] else: -1
    me function_type_params_at(row: i64, generation: i64) -> i64: if self.function_receipt_matches(row, generation): self.function_type_params[row] else: -1
    me function_params_at(row: i64, generation: i64) -> i64: if self.function_receipt_matches(row, generation): self.function_params[row] else: -1
    me function_return_type_at(row: i64, generation: i64) -> i64: if self.function_receipt_matches(row, generation): self.function_return_type[row] else: -1
    me function_effects_at(row: i64, generation: i64) -> i64: if self.function_receipt_matches(row, generation): self.function_effects[row] else: -1
    me function_metadata_at(row: i64, generation: i64) -> i64: if self.function_receipt_matches(row, generation): self.function_metadata[row] else: -1
    me function_type_param_at(row: i64, generation: i64, offset: i64) -> i64:
        if not self.function_receipt_matches(row, generation): return -1
        self.range_value_at(self.function_type_params[row], HD_AUX_RANGE_TYPE_PARAM, offset)
    me function_param_at(row: i64, generation: i64, offset: i64) -> i64:
        if not self.function_receipt_matches(row, generation): return -1
        self.range_value_at(self.function_params[row], HD_AUX_RANGE_VALUE_PARAM, offset)
    me function_effect_at(row: i64, generation: i64, offset: i64) -> i64:
        if not self.function_receipt_matches(row, generation): return -1
        self.range_value_at(self.function_effects[row], HD_AUX_RANGE_NONE, offset)
    me function_metadata_row_at(row: i64, generation: i64, offset: i64) -> i64:
        if not self.function_receipt_matches(row, generation): return -1
        self.range_value_at(self.function_metadata[row], HD_AUX_RANGE_FUNCTION_METADATA, offset)

export HirDestinationGraph
