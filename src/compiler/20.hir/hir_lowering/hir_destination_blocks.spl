# Statement and block rows. All references are ready owner indices.
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_lowering.hir_destination_graph.*

impl HirDestinationGraph:
    me ensure_stmt_capacity(required: i64):
        if required <= self.stmt_capacity: return
        val target = self.next_capacity(self.stmt_capacity, required)
        while self.stmt_ready.len() < target:
            self.stmt_ready.push(false); self.stmt_shape.push(0); self.stmt_span.push(-1)
            self.stmt_i0.push(-1); self.stmt_i1.push(-1); self.stmt_i2.push(-1); self.stmt_i3.push(-1)
            self.stmt_i4.push(-1); self.stmt_i5.push(-1)
            self.stmt_b0.push(false); self.stmt_t0.push("")
        self.stmt_capacity = target

    me ensure_block_capacity(required: i64):
        if required <= self.block_capacity: return
        val target = self.next_capacity(self.block_capacity, required)
        while self.block_ready.len() < target:
            self.block_ready.push(false); self.block_diagnostic.push(-1); self.block_span.push(-1)
            self.block_stmt_start.push(-1); self.block_stmt_len.push(0); self.block_has_value.push(false)
            self.block_value.push(-1); self.block_cap_start.push(-1); self.block_cap_len.push(0)
        self.block_capacity = target

    me reserve_stmt(span: Span) -> i64:
        if not self.mutable(): self.fail("HIR statement reservation after freeze"); return -1
        val s = self.reserve_span(span); if s < 0: return -1
        val i = self.stmt_count
        self.ensure_stmt_capacity(i + 1)
        self.stmt_ready[i] = false; self.stmt_shape[i] = 0; self.stmt_span[i] = s
        self.stmt_i0[i] = -1; self.stmt_i1[i] = -1; self.stmt_i2[i] = -1; self.stmt_i3[i] = -1
        self.stmt_i4[i] = -1; self.stmt_i5[i] = -1
        self.stmt_b0[i] = false; self.stmt_t0[i] = ""; self.stmt_count = i + 1
        i

    me stmt_writable(i: i64) -> bool: self.mutable() and i >= 0 and i < self.stmt_count and not self.stmt_ready[i]

    me stmt_payload_valid(i: i64, shape: i64) -> bool:
        if shape == HD_STMT_EXPR: return self.index_ready(HD_RANGE_EXPR, self.stmt_i0[i]) and self.stmt_i1[i] == -1 and self.stmt_i2[i] == -1
        if shape == HD_STMT_LET: return self.stmt_i0[i] >= 0 and self.index_ready(HD_RANGE_TYPE, self.stmt_i1[i]) and self.index_ready(HD_RANGE_EXPR, self.stmt_i2[i])
        if shape == HD_STMT_ASSIGN: return self.index_ready(HD_RANGE_EXPR, self.stmt_i0[i]) and self.stmt_i1[i] >= 0 and self.stmt_i1[i] <= 9 and self.index_ready(HD_RANGE_EXPR, self.stmt_i2[i])
        if shape == HD_STMT_BLOCK: return self.block_is_ready(self.stmt_i0[i])
        if shape == HD_STMT_ASM_ASSERT: return self.index_ready(HD_RANGE_AUX, self.stmt_i0[i]) and self.aux_shape[self.stmt_i0[i]] == HD_AUX_ASM_SPEC
        if shape == HD_STMT_SHARED_VAL or shape == HD_STMT_SHARED_VAR:
            return self.stmt_i0[i] >= 0 and self.index_ready(HD_RANGE_TYPE, self.stmt_i1[i]) and
                (if self.stmt_b0[i]: self.index_ready(HD_RANGE_EXPR, self.stmt_i2[i]) else: self.stmt_i2[i] == -1)
        if shape == HD_STMT_GPU_LAUNCH:
            return self.range_is_ready(HD_RANGE_EXPR, self.stmt_i0[i], self.stmt_i1[i]) and
                self.range_is_ready(HD_RANGE_EXPR, self.stmt_i2[i], self.stmt_i3[i]) and
                self.stmt_i1[i] >= 1 and self.stmt_i1[i] <= 3 and
                self.stmt_i3[i] >= 1 and self.stmt_i3[i] <= 3 and
                self.block_is_ready(self.stmt_i4[i]) and
                self.stmt_i5[i] >= 0 and self.stmt_i5[i] < self.span_count
        false

    me publish_stmt(i: i64, shape: i64) -> bool:
        if not self.stmt_writable(i) or shape < HD_STMT_EXPR or shape > HD_STMT_GPU_LAUNCH or not self.stmt_payload_valid(i, shape): return self.fail("HIR statement shape publication rejected")
        self.stmt_shape[i] = shape; self.stmt_ready[i] = true
        true

    me write_stmt_expr(i: i64, expr: i64) -> bool:
        if not self.stmt_writable(i) or not self.index_ready(HD_RANGE_EXPR, expr): return self.fail("HIR expression statement payload is not ready")
        self.stmt_i0[i] = expr; self.publish_stmt(i, HD_STMT_EXPR)

    me write_stmt_let(i: i64, symbol: i64, type_index: i64, init: i64) -> bool:
        if not self.stmt_writable(i) or not self.index_ready(HD_RANGE_TYPE, type_index) or not self.index_ready(HD_RANGE_EXPR, init): return self.fail("HIR let payload is not ready")
        self.stmt_i0[i] = symbol; self.stmt_i1[i] = type_index; self.stmt_i2[i] = init
        self.publish_stmt(i, HD_STMT_LET)

    me write_stmt_assign(i: i64, target: i64, op_shape: i64, value: i64) -> bool:
        if not self.stmt_writable(i) or not self.index_ready(HD_RANGE_EXPR, target) or not self.index_ready(HD_RANGE_EXPR, value): return self.fail("HIR assignment payload is not ready")
        if op_shape < 0 or op_shape > 9: return self.fail("HIR assignment operator domain is invalid")
        self.stmt_i0[i] = target; self.stmt_i1[i] = op_shape; self.stmt_i2[i] = value
        self.publish_stmt(i, HD_STMT_ASSIGN)

    me write_stmt_block(i: i64, block: i64) -> bool:
        if not self.stmt_writable(i) or block < 0 or block >= self.block_count or not self.block_ready[block]: return self.fail("HIR block statement payload is not ready")
        self.stmt_i0[i] = block; self.publish_stmt(i, HD_STMT_BLOCK)

    me write_stmt_asm_assert(i: i64, spec_aux: i64) -> bool:
        if not self.stmt_writable(i) or not self.index_ready(HD_RANGE_AUX, spec_aux) or self.aux_shape[spec_aux] != HD_AUX_ASM_SPEC: return self.fail("HIR asm-assert payload is not ready")
        self.stmt_i0[i] = spec_aux; self.publish_stmt(i, HD_STMT_ASM_ASSERT)

    me write_stmt_shared(i: i64, mutable: bool, symbol: i64, type_index: i64, has_init: bool, init: i64) -> bool:
        if not self.stmt_writable(i) or symbol < 0 or not self.index_ready(HD_RANGE_TYPE, type_index): return self.fail("HIR shared binding declaration is not ready")
        if has_init and not self.index_ready(HD_RANGE_EXPR, init): return self.fail("HIR shared binding initializer is not ready")
        if not has_init and init != -1: return self.fail("HIR shared binding absence has a payload")
        self.stmt_i0[i] = symbol; self.stmt_i1[i] = type_index
        self.stmt_i2[i] = if has_init: init else: -1; self.stmt_b0[i] = has_init
        self.publish_stmt(i, if mutable: HD_STMT_SHARED_VAR else: HD_STMT_SHARED_VAL)

    me write_stmt_gpu_launch(i: i64, grid: i64, grid_count: i64, block: i64, block_count: i64, body: i64, config_span: i64) -> bool:
        if not self.stmt_writable(i): return self.fail("HIR GPU launch statement is not writable")
        self.stmt_i0[i] = grid; self.stmt_i1[i] = grid_count
        self.stmt_i2[i] = block; self.stmt_i3[i] = block_count
        self.stmt_i4[i] = body; self.stmt_i5[i] = config_span
        self.publish_stmt(i, HD_STMT_GPU_LAUNCH)

    me reserve_block(span: Span) -> i64:
        if not self.mutable(): self.fail("HIR block reservation after freeze"); return -1
        val s = self.reserve_span(span); if s < 0: return -1
        val i = self.block_count
        self.ensure_block_capacity(i + 1)
        self.block_ready[i] = false; self.block_diagnostic[i] = -1; self.block_span[i] = s
        self.block_stmt_start[i] = -1; self.block_stmt_len[i] = 0; self.block_has_value[i] = false
        self.block_value[i] = -1; self.block_cap_start[i] = -1; self.block_cap_len[i] = 0
        self.block_count = i + 1
        i

    me fail_block(i: i64, message: text) -> bool:
        if self.ready: return false
        if i < 0 or i >= self.block_count: return self.fail("HIR block index out of range")
        if self.block_diagnostic[i] < 0: self.block_diagnostic[i] = self.record_diagnostic(message)
        self.fail(message)

    me finalize_block(i: i64, stmt_start: i64, stmt_len: i64, has_value: bool, value: i64, cap_start: i64, cap_len: i64) -> bool:
        if not self.mutable() or i < 0 or i >= self.block_count or self.block_ready[i]: return self.fail("HIR block is not writable")
        if not self.range_is_ready(HD_RANGE_STMT, stmt_start, stmt_len): return self.fail_block(i, "HIR block statement range is not ready")
        if not self.range_matches(HD_RANGE_AUX, HD_AUX_RANGE_TEXT, cap_start, cap_len): return self.fail_block(i, "HIR block capability range is not ready")
        if has_value and not self.index_ready(HD_RANGE_EXPR, value): return self.fail_block(i, "HIR block value is not ready")
        self.block_stmt_start[i] = stmt_start; self.block_stmt_len[i] = stmt_len
        self.block_has_value[i] = has_value; self.block_value[i] = if has_value: value else: -1
        self.block_cap_start[i] = cap_start; self.block_cap_len[i] = cap_len
        self.block_ready[i] = true
        true

    me block_is_ready(i: i64) -> bool: i >= 0 and i < self.block_count and self.block_ready[i]
    me block_stmt_range_at(i: i64) -> i64: if self.block_is_ready(i): self.block_stmt_start[i] else: -1
    me block_cap_range_at(i: i64) -> i64: if self.block_is_ready(i): self.block_cap_start[i] else: -1
    me block_value_at(i: i64) -> i64: if self.block_is_ready(i) and self.block_has_value[i]: self.block_value[i] else: -1
    me block_span_at(i: i64) -> i64: if self.block_is_ready(i): self.block_span[i] else: -1
    me stmt_shape_at(i: i64) -> i64: if self.index_ready(HD_RANGE_STMT, i): self.stmt_shape[i] else: 0
    me stmt_i64_at(i: i64, column: i64) -> i64: if not self.index_ready(HD_RANGE_STMT, i): -1 else if column == 0: self.stmt_i0[i] else if column == 1: self.stmt_i1[i] else if column == 2: self.stmt_i2[i] else if column == 3: self.stmt_i3[i] else if column == 4: self.stmt_i4[i] else if column == 5: self.stmt_i5[i] else: -1
    me stmt_bool_at(i: i64, column: i64) -> bool: self.index_ready(HD_RANGE_STMT, i) and column == 0 and self.stmt_b0[i]
    me stmt_span_at(i: i64) -> i64: if self.index_ready(HD_RANGE_STMT, i): self.stmt_span[i] else: -1

export HirDestinationGraph
