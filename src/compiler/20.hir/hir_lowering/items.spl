# HIR Lowering - Item Lowering
#
# This module handles lowering of top-level items (functions, classes, structs, enums, traits, impls) from AST to HIR.

# Split from src/compiler/20.hir/hir_lowering/items.spl to keep module cohesion under the 800-line source limit.
use compiler.hir.hir_lowering.module_surface_types.{ModuleSurfaceEnum}
export use compiler.hir.hir_lowering._Items.lowering_helpers.*
export use compiler.hir.hir_lowering._Items.module_lowering.*
export use compiler.hir.hir_lowering._Items.module_callable_types.*
export use compiler.hir.hir_lowering._Items.module_import_registration.*
export use compiler.hir.hir_lowering._Items.module_reexport_materialization.*
export use compiler.hir.hir_lowering._Items.module_import_resolution.*
export use compiler.hir.hir_lowering._Items.module_build.*
export use compiler.hir.hir_lowering._Items.module_declarations_bootstrap.*
export use compiler.hir.hir_lowering._Items.declaration_lowering.*
export use compiler.hir.hir_lowering._Items.class_declaration_lowering.*
export use compiler.hir.hir_lowering._Items.verification_contract_lowering.*
export use compiler.hir.hir_lowering._Items.trait_impl_lowering.*

# `_Expressions/block_and_asm_lowering.spl` -- reached through the
# `compiler.hir.hir_lowering.expressions.*` import every `_Items` module makes --
# calls `self.lower_hir_stmt_multi(...)`, so the item surface genuinely depends on
# the statement-lowering impl block. Without this re-export a consumer importing
# only `items.*` got `method lower_hir_stmt_multi not found on type HirLowering`.
export use compiler.hir.hir_lowering.statements.*
