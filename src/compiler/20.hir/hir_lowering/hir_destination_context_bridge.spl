# Scalar lease methods are kept outside the already-large HirLowering schema.
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.hir_destination_graph.{HD_MODE_FLAT,HD_MODE_GRAPH}
use compiler.hir.hir_lowering.hir_destination_registry.{hir_destination_registry_acquire,hir_destination_registry_freeze,hir_destination_registry_release,hir_destination_registry_release_empty_frozen_preflighted,hir_destination_registry_abandon,hir_destination_registry_building,hdw_module_identity_building,hdw_stage_destination_member,hdw_publish_destination_module_authority,hdw_destination_module_text_range,hdw_destination_module_text_set,hdw_destination_module_text_publish,hdw_destination_member_resolve_from_symbol}
use compiler.hir.hir_lowering._Items.lowering_helpers.{bootstrap_hir_modules_abandon_pending_graph}

impl HirLowering:
    me enable_destination_graph(generation: i64) -> bool:
        if self.destination_mode!=HD_MODE_FLAT or self.destination_slot>=0 or generation<0: return false
        val slot=hir_destination_registry_acquire(generation)
        if slot<0: return false
        self.destination_slot=slot; self.destination_generation=generation; self.destination_mode=HD_MODE_GRAPH; true
    me set_current_destination_module(module_index: i64,module_symbol: i64) -> bool:
        if self.destination_mode!=HD_MODE_GRAPH or not hir_destination_registry_building(self.destination_slot,self.destination_generation): return false
        if module_index<0 or module_symbol<0 or hdw_module_identity_building(self.destination_slot,self.destination_generation,module_index)!=module_symbol: return false
        self.current_destination_module_index=module_index; self.current_destination_module_symbol=module_symbol; true
    me clear_current_destination_module():
        self.current_destination_module_index = -1
        self.current_destination_module_symbol = -1
    me publish_current_destination_member(owner: i64,name: text,ordinal: i64,symbol: i64,has_type: bool,type_index: i64,has_default: bool,default_expr: i64,volatile_value: bool,has_bits: bool,bits: i64,has_address: bool,address: i64,span: i64) -> i64:
        if self.current_destination_module_index<0 or self.current_destination_module_symbol<0: return -1
        if ordinal<0: return -1
        hdw_stage_destination_member(self.destination_slot,self.destination_generation,self.current_destination_module_index,owner,name,symbol,has_type,type_index,has_default,default_expr,volatile_value,has_bits,bits,has_address,address,span)
    me resolve_current_destination_member_from_symbol(base_symbol: i64,name: text) -> i64:
        if self.current_destination_module_index<0: return -1
        hdw_destination_member_resolve_from_symbol(self.destination_slot,self.destination_generation,self.current_destination_module_index,base_symbol,name)
    me publish_current_destination_module_authority(source_key: text,peer_key: text,layer_path: text,parent_facade_key: text,package_path: text,facades: i64,friends: i64) -> i64:
        if self.current_destination_module_index<0 or self.current_destination_module_symbol<0: return -1
        hdw_publish_destination_module_authority(self.destination_slot,self.destination_generation,self.current_destination_module_index,source_key,peer_key,layer_path,parent_facade_key,package_path,facades,friends)
    me reserve_destination_module_text_range(count: i64) -> i64: hdw_destination_module_text_range(self.destination_slot,self.destination_generation,count)
    me set_destination_module_text_range_at(handle: i64,offset: i64,value: text) -> bool: hdw_destination_module_text_set(self.destination_slot,self.destination_generation,handle,offset,value)
    me publish_destination_module_text_range(handle: i64) -> bool: hdw_destination_module_text_publish(self.destination_slot,self.destination_generation,handle)
    me freeze_destination_compile() -> bool: self.destination_mode==HD_MODE_GRAPH and hir_destination_registry_freeze(self.destination_slot,self.destination_generation)
    me freeze_destination_graph() -> bool: self.freeze_destination_compile()
    me release_destination_compile() -> bool:
        if self.destination_mode!=HD_MODE_GRAPH or not hir_destination_registry_release(self.destination_slot,self.destination_generation): return false
        self.destination_slot=-1; self.destination_generation=-1; self.destination_mode=HD_MODE_FLAT; self.clear_current_destination_module(); true
    me release_destination_graph() -> bool: self.release_destination_compile()
    me release_empty_destination_compile_after_preflight():
        hir_destination_registry_release_empty_frozen_preflighted()
        self.destination_slot=-1; self.destination_generation=-1
        self.destination_mode=HD_MODE_FLAT; self.clear_current_destination_module()
    me abandon_destination_compile() -> bool:
        if self.destination_mode!=HD_MODE_GRAPH: return false
        val abandoned_slot = self.destination_slot
        val abandoned_generation = self.destination_generation
        if not hir_destination_registry_abandon(abandoned_slot,abandoned_generation): return false
        bootstrap_hir_modules_abandon_pending_graph(abandoned_slot,abandoned_generation)
        self.failed_destination_slot=self.destination_slot; self.failed_destination_generation=self.destination_generation
        self.destination_slot=-1; self.destination_generation=-1; self.destination_mode=HD_MODE_FLAT; self.clear_current_destination_module(); true
    me abandon_destination_graph() -> bool: self.abandon_destination_compile()

export HirLowering
