# Canonical HIR dictionary key ordering.
#
# This module is deliberately typed instead of exposing a generic comparator.
# The schema generator dispatches every dictionary key type to exactly one of
# these helpers and refuses unknown key types.  Each helper sorts scalar source
# indices with a stable bottom-up merge, then projects the original keys once.
# Source dictionaries and their key snapshots are never mutated.

use compiler.hir.hir_types.{SymbolId}

# An i64 slot must not be tested with `== nil`: staged-native codegen compares
# the raw integer with nil's immediate (3), so key 3 sorted as nil. The rendered
# text is the engine-independent discriminator, as in HirCodecWriter.put_i64.
# doc/08_tracking/bug/hir_codec_put_i64_three_encoded_as_nil_native_2026-10-10.md
fn _hc_i64_is_nil_v1(value: i64) -> bool:
    "{value}" == "nil"

fn _hc_i64_index_before_v1(values: [i64], left_index: i64,
                            right_index: i64) -> bool:
    # ANY-transport: values is [i64] -- the SymbolId annotation this carried
    # was a silently-mistyped rebind (wrong layout on every read).
    val left: i64 = values[left_index]
    val right: i64 = values[right_index]
    val left_nil = _hc_i64_is_nil_v1(left)
    val right_nil = _hc_i64_is_nil_v1(right)
    if left_nil:
        return not right_nil
    if right_nil:
        return false
    left < right

fn _hc_symbol_id_index_before_v1(values: [SymbolId], left_index: i64,
                                  right_index: i64) -> bool:
    val left: SymbolId = values[left_index]
    val right: SymbolId = values[right_index]
    if left == nil:
        return right != nil
    if right == nil:
        return false
    left.id < right.id

fn _hc_utf8_bytes_before_v1(bytes: [[u8]], present: [bool],
                             left_index: i64, right_index: i64) -> bool:
    if not present[left_index]:
        return present[right_index]
    if not present[right_index]:
        return false
    val left: [u8] = bytes[left_index]
    val right: [u8] = bytes[right_index]
    var offset: i64 = 0
    while offset < left.len() and offset < right.len():
        if left[offset] != right[offset]:
            # u8 comparison is the frozen unsigned UTF-8 byte order.
            return left[offset] < right[offset]
        offset = offset + 1
    left.len() < right.len()

pub fn hc_i64_key_before_v1(left: i64, right: i64) -> bool:
    val left_nil = _hc_i64_is_nil_v1(left)
    val right_nil = _hc_i64_is_nil_v1(right)
    if left_nil:
        return not right_nil
    if right_nil:
        return false
    left < right

# @workaround bug=a174_struct_nil_comparison_dispatch_2026_10_16 recover=e458621e87670403385147dd4380acb0b925153d reason=old-producer-record-presence-dispatch
pub fn hc_symbol_id_key_before_v1(left: SymbolId, right: SymbolId) -> bool:
    if not left.?:
        return right.?
    if not right.?:
        return false
    left.id < right.id

pub fn hc_text_key_before_v1(left: text, right: text) -> bool:
    if left == nil:
        return right != nil
    if right == nil:
        return false
    var bytes: [[u8]] = []
    bytes.push(left.bytes())
    bytes.push(right.bytes())
    _hc_utf8_bytes_before_v1(bytes, [true, true], 0, 1)

fn _hc_initial_indices_v1(count: i64) -> [i64]:
    var indices: [i64] = []
    var index: i64 = 0
    while index < count:
        indices.push(index)
        index = index + 1
    indices

fn _hc_order_i64_indices_v1(values: [i64]) -> [i64]:
    var current = _hc_initial_indices_v1(values.len())
    if current.len() <= 1:
        return current
    var scratch = _hc_initial_indices_v1(values.len())
    var width: i64 = 1
    while width < current.len():
        var run_start: i64 = 0
        while run_start < current.len():
            var middle = run_start + width
            if middle > current.len(): middle = current.len()
            var run_end = middle + width
            if run_end > current.len(): run_end = current.len()
            var left = run_start
            var right = middle
            var output = run_start
            while output < run_end:
                # ANY-transport: annotated element extractions BEFORE the
                # comparator call and the array-slot writes (cycle-69
                # cache-encode SIGSEGV). Same merge semantics: right wins only
                # on a strict before(); exact ties keep left (source order).
                var take_right = false
                var take_value: i64 = 0
                if right < run_end and left < middle:
                    val right_value: i64 = current[right]
                    val left_value: i64 = current[left]
                    if _hc_i64_index_before_v1(values, right_value, left_value):
                        take_value = right_value
                        take_right = true
                if take_right:
                    scratch[output] = take_value
                    right = right + 1
                else:
                    if left < middle:
                        val left_value: i64 = current[left]
                        scratch[output] = left_value
                        left = left + 1
                    else:
                        val right_value: i64 = current[right]
                        scratch[output] = right_value
                        right = right + 1
                output = output + 1
            run_start = run_end
        var copy_index: i64 = 0
        while copy_index < current.len():
            val copied: i64 = scratch[copy_index]
            current[copy_index] = copied
            copy_index = copy_index + 1
        if width > current.len() / 2: width = current.len()
        else: width = width * 2
    current

fn _hc_order_symbol_id_indices_v1(values: [SymbolId]) -> [i64]:
    var current = _hc_initial_indices_v1(values.len())
    if current.len() <= 1:
        return current
    var scratch = _hc_initial_indices_v1(values.len())
    var width: i64 = 1
    while width < current.len():
        var run_start: i64 = 0
        while run_start < current.len():
            var middle = run_start + width
            if middle > current.len(): middle = current.len()
            var run_end = middle + width
            if run_end > current.len(): run_end = current.len()
            var left = run_start
            var right = middle
            var output = run_start
            while output < run_end:
                # ANY-transport: annotated element extractions BEFORE the
                # comparator call and the array-slot writes (cycle-69
                # cache-encode SIGSEGV). Same merge semantics: right wins only
                # on a strict before(); exact ties keep left (source order).
                var take_right = false
                var take_value: i64 = 0
                if right < run_end and left < middle:
                    val right_value: i64 = current[right]
                    val left_value: i64 = current[left]
                    if _hc_symbol_id_index_before_v1(values, right_value, left_value):
                        take_value = right_value
                        take_right = true
                if take_right:
                    scratch[output] = take_value
                    right = right + 1
                else:
                    if left < middle:
                        val left_value: i64 = current[left]
                        scratch[output] = left_value
                        left = left + 1
                    else:
                        val right_value: i64 = current[right]
                        scratch[output] = right_value
                        right = right + 1
                output = output + 1
            run_start = run_end
        var copy_index: i64 = 0
        while copy_index < current.len():
            val copied: i64 = scratch[copy_index]
            current[copy_index] = copied
            copy_index = copy_index + 1
        if width > current.len() / 2: width = current.len()
        else: width = width * 2
    current

fn _hc_order_text_indices_v1(values: [text]) -> [i64]:
    # Materialize each UTF-8 image exactly once. Comparisons address this arena
    # by scalar index, so merge passes never re-encode or copy text keys.
    var bytes: [[u8]] = []
    var present: [bool] = []
    for value in values:
        if value == nil:
            bytes.push([])
            present.push(false)
        else:
            bytes.push(value.bytes())
            present.push(true)
    var current = _hc_initial_indices_v1(values.len())
    if current.len() <= 1:
        return current
    var scratch = _hc_initial_indices_v1(values.len())
    var width: i64 = 1
    while width < current.len():
        var run_start: i64 = 0
        while run_start < current.len():
            var middle = run_start + width
            if middle > current.len(): middle = current.len()
            var run_end = middle + width
            if run_end > current.len(): run_end = current.len()
            var left = run_start
            var right = middle
            var output = run_start
            while output < run_end:
                # ANY-transport: annotated element extractions BEFORE the
                # comparator call and the array-slot writes (cycle-69
                # cache-encode SIGSEGV). Same merge semantics: right wins only
                # on a strict before(); exact ties keep left (source order).
                var take_right = false
                var take_value: i64 = 0
                if right < run_end and left < middle:
                    val right_value: i64 = current[right]
                    val left_value: i64 = current[left]
                    if _hc_utf8_bytes_before_v1(bytes, present, right_value, left_value):
                        take_value = right_value
                        take_right = true
                if take_right:
                    scratch[output] = take_value
                    right = right + 1
                else:
                    if left < middle:
                        val left_value: i64 = current[left]
                        scratch[output] = left_value
                        left = left + 1
                    else:
                        val right_value: i64 = current[right]
                        scratch[output] = right_value
                        right = right + 1
                output = output + 1
            run_start = run_end
        var copy_index: i64 = 0
        while copy_index < current.len():
            val copied: i64 = scratch[copy_index]
            current[copy_index] = copied
            copy_index = copy_index + 1
        if width > current.len() / 2: width = current.len()
        else: width = width * 2
    current

pub fn hc_order_i64_keys_v1(values: [i64]) -> [i64]:
    var ordered: [i64] = []
    for raw_index in _hc_order_i64_indices_v1(values):
        # ANY-transport: annotated rebind of both the index element and the
        # keyed element before use (cycle-69: unbox of an erased i64 word).
        val index: i64 = raw_index
        val key: i64 = values[index]
        ordered.push(key)
    ordered

pub fn hc_order_text_keys_v1(values: [text]) -> [text]:
    var ordered: [text] = []
    for raw_index in _hc_order_text_indices_v1(values):
        val index: i64 = raw_index
        val key: text = values[index]
        ordered.push(key)
    ordered

pub fn hc_order_symbol_id_keys_v1(values: [SymbolId]) -> [SymbolId]:
    var ordered: [SymbolId] = []
    for raw_index in _hc_order_symbol_id_indices_v1(values):
        val index: i64 = raw_index
        val key: SymbolId = values[index]
        ordered.push(key)
    ordered

export hc_order_i64_keys_v1, hc_order_text_keys_v1
export hc_order_symbol_id_keys_v1
export hc_i64_key_before_v1, hc_text_key_before_v1
export hc_symbol_id_key_before_v1
