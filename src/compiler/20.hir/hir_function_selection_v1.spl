use compiler.hir.hir_types.{HirModule, SymbolId}
use compiler.hir.hir_definitions.{HirFunction, HirTypeParam}

fn sorted_function_indices(functions: [HirFunction]) -> [i64]:
    """Value-array indices in ascending symbol-id order (deterministic roots).

    Native erased dictionaries compare aggregate SymbolId keys by identity.
    Sorting copied keys and looking them up loses the function payload. Keep
    the values directly; sort only scalar indices so swaps never copy bodies.
    """
    var indices: [i64] = []
    var symbol_ids: [i64] = []
    var function_index = 0
    while function_index < functions.len():
        val function: HirFunction = functions[function_index]
        val symbol: SymbolId = function.symbol
        indices.push(function_index)
        symbol_ids.push(symbol.id)
        function_index = function_index + 1
    # Preserve the existing stable insertion sort and ascending numeric order.
    var i = 1
    while i < indices.len():
        val cur: i64 = indices[i]
        var j = i - 1
        while j >= 0:
            val prev: i64 = indices[j]
            if symbol_ids[prev] <= symbol_ids[cur]:
                break
            indices[j + 1] = prev
            j = j - 1
        indices[j + 1] = cur
        i = i + 1
    indices

fn is_generic_function(func: HirFunction) -> bool:
    """Check if a function has type parameters.

    `.?` on the plain (non-optional) [HirTypeParam] field is TRUE for an
    empty list, which classified EVERY function (incl. -c main) as generic
    and dragged the whole mono machinery in (bug doc iteration 18). Check
    emptiness, nil-guarded.
    """
    val tps: [HirTypeParam] = func.type_params
    if tps == nil:
        return false
    tps.len() > 0

fn hir_prune_published_templates_v1(module: HirModule, emitted_templates: [text],
        unresolved_templates: [text]) -> HirModule:
    """Remove only generic definitions published as specializations.

    Unresolved roots take precedence over emitted metadata, as they do in the
    monomorphization pass. A generic template with no publication remains in
    HIR, and non-generic functions and specialization bodies are retained.
    """
    if module == nil:
        return module
    if emitted_templates.len() == 0:
        return module
    var emitted: Dict<text, bool> = {}
    for name in emitted_templates:
        emitted[name] = true
    var unresolved: Dict<text, bool> = {}
    for name in unresolved_templates:
        unresolved[name] = true
    var out = module
    var kept: Dict<SymbolId, HirFunction> = {}
    val function_keys: [SymbolId] = module.functions.keys()
    for symbol in function_keys:
        if module.functions[symbol] == nil:
            continue
        val function: HirFunction = module.functions[symbol]
        val is_template = is_generic_function(function) or function.is_generic_template
        if is_template and not unresolved.has(function.name) and emitted.has(function.name):
            continue
        kept[symbol] = function
    out.functions = kept
    out

export sorted_function_indices, is_generic_function, hir_prune_published_templates_v1
