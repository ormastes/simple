"""Allocation-safe policy for optional HIR re-export diagnostics."""

pub fn hir_reexport_chase_unresolved_receipt(
    diagnostic_enabled: bool,
    facade: text,
    item: text,
    local: text,
    importer: text
) -> text:
    """Render the detailed miss receipt only when bootstrap diagnostics are on."""
    if not diagnostic_enabled:
        return ""
    "[hir-reexport-chase-unresolved] facade={facade} item={item} local={local} importer={importer}: the facade neither declares this name nor routes it through a resolvable re-export; nothing was registered and a later `unresolved type`/`unresolved name: {item}` will be reported against an importing module instead"
