# HIR Types - Core Types and Symbol Table
#
# This module contains:
# - HIR module structure and imports
# - Symbol table with name resolution and UFCS support
# - HIR type system (primitives, composites, references, user-defined)
# - Dimension types for compile-time tensor checking
# - Effect system

use compiler.frontend.parser_types.*
use compiler.frontend.parser_types_expr.*
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.common.dynamic_identity.closure.{Closure}
use compiler.hir.hir_symbol_table_methods.*
# `HirModule` (below) types 13 of its fields with declarations that physically
# live in hir_definitions.spl, and this module carried NO import of that module
# at all -- the names were only ever reachable because hir_definitions globs
# this file back, which is not a route the dependency-materialization walk
# accepts. The walk therefore reported
# `[hir-callable-dep-origin-unresolved] owner=compiler.hir.hir_types
# dependency=HirClass` (and 12 siblings) and each one resurfaced as a hard
# `unresolved type: HirClass` against ~90 innocent importers -- the single
# largest HIR-semantic error population in the Stage 3 log of 2026-08-24
# (~1,170 of ~1,360 fatal errors). See the twin explicit-import comment in
# hir_definitions.spl for the mechanism.
use compiler.hir.hir_definitions.{HirFunction, HirClass, HirStruct, HirEnum, HirBitfield, HirTrait, HirImpl, HirConst, HirStaticAssert, HirAopAdvice, HirDiBinding, HirArchRule, HirMockDecl}

# ============================================================================
# HIR Module Structure
# ============================================================================

struct HirModule:
    """Complete HIR module."""
    name: text
    path: text
    imports: [HirImport]
    exports: [text]
    domain_blocks: [HirDomainBlock]
    symbols: SymbolTable
    functions: Dict<SymbolId, HirFunction>
    gpu_function_targets: Dict<text, text>
    gpu_function_backend_orders: Dict<text, text>
    classes: Dict<SymbolId, HirClass>
    structs: Dict<SymbolId, HirStruct>
    enums: Dict<SymbolId, HirEnum>
    bitfields: Dict<SymbolId, HirBitfield>
    traits: Dict<SymbolId, HirTrait>
    impls: [HirImpl]
    constants: Dict<SymbolId, HirConst>
    static_asserts: [HirStaticAssert]   # Static assertions evaluated at compile time
    aop_advices: [HirAopAdvice]
    di_bindings: [HirDiBinding]
    arch_rules: [HirArchRule]
    mock_decls: [HirMockDecl]
    types: [text]
    # `extend <Enum>:` sections carried from the frontend (design §2). MUST
    # stay the LAST field -- partial named constructions are filled
    # POSITIONALLY by the Rust seed -- and carries a default so existing
    # `HirModule(...)` sites are untouched.
    extend_enums: [HirExtendEnum] = []

struct HirExtendEnum:
    """One `complete:`/`dyn:` section of an `extend <Enum>:` declaration."""
    target: text
    closure: Closure
    constructors: [HirExtendConstructor]
    span: Span

struct HirExtendConstructor:
    """`provider.Name(payload, ...)` inside an `extend` section."""
    provider: text
    name: text
    payload_types: [Type]
    span: Span

struct HirImport:
    """Import declaration."""
    module_path: text
    items: [HirImportItem]
    is_lazy: bool
    span: Span

struct HirImportItem:
    """Single imported item."""
    name: text
    alias: text?
    resolved: SymbolId?     # Resolved after linking

struct HirDomainBlock:
    """Raw top-level domain block carried into HIR metadata."""
    kind: text
    payload: text
    context: text
    span: Span

# ============================================================================
# Symbol Table
# ============================================================================

struct SymbolId:
    """Unique identifier for a symbol."""
    id: i64

impl SymbolId:
    static fn new(id: i64) -> SymbolId:
        SymbolId(id: id)

    fn is_valid() -> bool:
        self.id >= 0

struct HirSymbol:
    """Symbol table entry."""
    id: SymbolId
    name: text
    kind: SymbolKind
    type_: HirType?
    scope: ScopeId
    span: Span
    visibility: Visibility
    is_public: bool
    is_mutable: bool
    defining_module: text?   # Which module defined this symbol (for visibility checking)

"""Kind of symbol."""
enum SymbolKind:
    Function
    Method
    Variable
    Parameter
    Field
    Class
    Struct
    Enum
    EnumVariant
    Trait
    TypeAlias
    TypeParam
    Const
    Module
    Import

# ============================================================================
# Method Resolution (UFCS Support)
# ============================================================================

"""How a method call was resolved.

Supports UFCS (Uniform Function Call Syntax) where `x.method()` can resolve to:
1. Instance method on x's type (highest priority)
2. Trait method implemented by x's type
3. Free function `method(x)` where first param matches x's type (UFCS)

Examples:
    x.map()  ->  InstanceMethod if x's class has map()
    x.map()  ->  TraitMethod if x implements trait with map()
    x.map()  ->  FreeFunction(map) if map(x) exists and first param matches
"""
enum MethodResolution:
    # Direct method on the receiver's type
    InstanceMethod(type_id: SymbolId, method_id: SymbolId)

    # Method from an implemented trait
    TraitMethod(trait_id: SymbolId, method_id: SymbolId)

    # UFCS: Free function where receiver becomes first argument
    # x.method(a, b) -> method(x, a, b)
    FreeFunction(func_id: SymbolId)

    # Static method on a type (no receiver)
    # Type.method(a, b) - no self parameter
    StaticMethod(type_id: SymbolId, method_id: SymbolId)

    # Not yet resolved (before resolution pass)
    Unresolved

impl MethodResolution:
    fn is_resolved() -> bool:
        """Check if method has been resolved."""
        match self:
            case Unresolved: false
            case _: true

    fn is_ufcs() -> bool:
        """Check if this is a UFCS resolution (free function)."""
        match self:
            case FreeFunction(_): true
            case _: false

    fn get_symbol_id() -> SymbolId?:
        """Get the resolved symbol ID if available.

        Bare-lift accumulator: explicit Some(...) builds a heap Option box on
        the stage4 native lane and if-val at the caller binds the BOX
        un-unwrapped (bug doc 2026-07-23 family)."""
        match self:
            case InstanceMethod(_, method_id): method_id
            case TraitMethod(_, method_id): method_id
            case FreeFunction(func_id): func_id
            case StaticMethod(_, method_id): method_id
            case Unresolved: nil

struct ScopeId:
    """Unique identifier for a scope."""
    id: i64

struct Scope:
    """Lexical scope."""
    id: ScopeId
    parent: ScopeId?
    kind: ScopeKind
    symbols: Dict<text, i64>

"""Kind of scope."""
enum ScopeKind:
    Module
    Function
    Block
    Loop
    Match
    Class
    Impl

fn qualified_symbol_key(module_name: text, member_name: text) -> text:
    """QTYPEIDX (2026-08-22): injective index key for a (module, member) pair.

    `#` cannot occur in a module path or a member name, so unlike the `.`
    join this cannot alias ("a.b", "c") onto ("a", "b.c")."""
    module_name + "#" + member_name

class SymbolTable:
    """Symbol table for name resolution."""
    symbols: Dict<i64, HirSymbol>
    scopes: Dict<i64, Scope>
    current_scope: ScopeId
    next_symbol_id: i64
    next_scope_id: i64
    gpu_function_targets: Dict<text, text>
    gpu_function_backend_orders: Dict<text, text>
    qualified_functions: Dict<text, i64>
    qualified_types: Dict<text, i64>
    exact_symbols: Dict<text, i64>
    # MODCALLIDX (2026-08-21): "{defining_module}#{name}" -> raw symbol id for
    # every symbol that carries a defining_module, plus the same row under the
    # name's last dotted segment. Answers field_module_callable in O(1); the
    # sweep it replaces materialized Dict.keys() over the WHOLE symbol table
    # per module-qualified expression, so the real 662-module closure paid
    # O(bodies x exprs x symbols). Last write wins, matching the old
    # reverse-order scan (latest registration answered).
    module_callables: Dict<text, i64>
    # Persistent root owner reused by reset_module. The Scope row is a small
    # routing value; its symbol backing never crosses reset by value.
    root_scope_symbols: Dict<text, i64>

impl SymbolTable:
    static fn new() -> SymbolTable:
        var root_scope_symbols: Dict<text, i64> = {}
        var table = SymbolTable(
            symbols: {},
            scopes: {},
            current_scope: ScopeId(id: 0),
            next_symbol_id: 0,
            next_scope_id: 1,
            gpu_function_targets: {},
            gpu_function_backend_orders: {},
            qualified_functions: {},
            qualified_types: {},
            exact_symbols: {},
            module_callables: {},
            root_scope_symbols: root_scope_symbols
        )
        # Create root scope (direct mutation avoids copy-modify-reassign bug)
        table.scopes[0] = Scope(
            id: ScopeId(id: 0),
            parent: nil,
            kind: ScopeKind.Module,
            symbols: root_scope_symbols
        )
        table

    me reset_module():
        """Reset module-local symbol state without replacing this table."""
        # Do not call clear() through a Dict-typed class field here. On the
        # staged native path that receiver can lose its Dict type and dispatch
        # as a string operation, leaving stale names alive while the scalar id
        # counters below restart at zero. Fresh field stores are unambiguous.
        self.root_scope_symbols = {}
        self.symbols = {}
        self.scopes = {}
        self.gpu_function_targets = {}
        self.gpu_function_backend_orders = {}
        self.qualified_functions = {}
        self.qualified_types = {}
        self.exact_symbols = {}
        self.module_callables = {}
        self.current_scope = ScopeId(id: 0)
        self.next_symbol_id = 0
        self.next_scope_id = 1
        self.scopes[0] = Scope(
            id: ScopeId(id: 0), parent: nil,
            kind: ScopeKind.Module, symbols: self.root_scope_symbols)

    me register_gpu_function_metadata(name: text, target: text, backend_order: text):
        self.gpu_function_targets[name] = target
        self.gpu_function_backend_orders[name] = backend_order

    fn has_gpu_function_metadata(name: text) -> bool:
        self.gpu_function_targets.has(name)

    fn gpu_function_target(name: text) -> text:
        if self.gpu_function_targets.has(name): self.gpu_function_targets[name] else: ""

    fn gpu_function_backend_order(name: text) -> text:
        if self.gpu_function_backend_orders.has(name): self.gpu_function_backend_orders[name] else: ""

    me define(name: text, kind: SymbolKind, type_: HirType?, span: Span, visibility: Visibility, is_mutable: bool, defining_module: text?) -> SymbolId:
        """Define a new symbol in current scope.

        For type-level symbols (Class, Struct, Enum, Trait): first-write-wins.
        If the name is already bound in the current scope and the existing entry's
        defining_module matches, return the existing id (idempotent re-register).
        If a different module already registered the name, the first registration
        wins and this call is a no-op (returns the existing id).
        For non-type symbols (Variable, Parameter, Field, etc.) always create a
        new entry so shadowing and overloading work as before.
        """
        # First-write-wins for type-level symbols
        val is_type_symbol = match kind:
            case SymbolKind.Class: true
            case SymbolKind.Struct: true
            case SymbolKind.Enum: true
            case SymbolKind.Trait: true
            case _: false

        # Same Dict-free `next_scope_id` range check `lookup()` uses (see its
        # long comment): `self.scopes` is append-only with scope 0 always
        # present (both `new()` and `reset_module()` insert it), so an
        # out-of-range `current_scope` can only come from a corrupted/stale
        # read of this scalar field. Without this, the bracket reads below
        # trap ud2 "field access on nil receiver" exactly like `lookup()` did
        # -- the guard landed there covered only 2 of the 5 bracket reads of
        # `self.scopes` in this file. Recovering to the root scope is the
        # behaviour-preserving repair: in every correct execution the guard
        # is a no-op, and scope 0 is the scope a flat/bootstrap symbol table
        # is supposed to be in anyway.
        # doc/08_tracking/bug/stage3_symboltable_lookup_ud2_field_access_nil_receiver_2026-08-06.md
        if self.current_scope.id < 0 or self.current_scope.id >= self.next_scope_id:
            self.current_scope = ScopeId(id: 0)

        if is_type_symbol:
            # SCOPEROW (2026-08-22): probe the scope row IN PLACE. `val scope =
            # self.scopes[id]` copied the Scope value (VT_OBJECT_FIELD_CLONES
            # exactly 1 per define on the seed) on every type-symbol define.
            val existing = self.scopes[self.current_scope.id].symbols.get(name)
            if existing != nil:
                # Already registered — return the existing id (first-write-wins).
                # Bracket-index read: same stage4 lane hardening as `lookup`.
                return SymbolId(id: self.scopes[self.current_scope.id].symbols[name])

        val raw_id = self.next_symbol_id
        val id = SymbolId(id: raw_id)
        self.next_symbol_id = raw_id + 1

        val symbol = HirSymbol(
            id: id,
            name: name,
            kind: kind,
            type_: type_,
            scope: self.current_scope,
            span: span,
            visibility: visibility,
            is_public: visibility == Visibility.Public,
            is_mutable: is_mutable,
            defining_module: defining_module
        )

        self.symbols[raw_id] = symbol
        if not self.exact_symbols.has(name):
            self.exact_symbols[name] = raw_id
        if val defining_module_name = defining_module:
            self.index_module_callable(defining_module_name, name, raw_id)

        # SCOPEIP (2026-08-21): write the scope's symbol dict IN PLACE. The
        # read-modify-write round trip this replaces was mandatory because
        # a nested assignment target was unsupported; it is supported now
        # (344f277cc45), and the round trip copied the whole scope row on
        # every define -- 1,529 defines for one module in the real closure.
        self.scopes[self.current_scope.id].symbols[name] = raw_id

        id

    me bind_qualified_function(module_name: text, member_name: text, id: SymbolId):
        # QTYPEIDX (2026-08-22): first binding wins, same as the append-only
        # scan this replaces. See lookup_qualified_type_raw for the key shape.
        val key = qualified_symbol_key(module_name, member_name)
        if self.qualified_functions.contains_key(key):
            return
        self.qualified_functions[key] = id.id

    fn lookup_qualified_function(module_name: text, member_name: text) -> SymbolId?:
        val raw_id = self.lookup_qualified_function_raw(module_name, member_name)
        if raw_id >= 0:
            return SymbolId(id: raw_id)
        nil

    fn lookup_qualified_function_raw(module_name: text, member_name: text) -> i64:
        """Native-safe scalar qualified-function lookup, including id zero."""
        val key = qualified_symbol_key(module_name, member_name)
        if self.qualified_functions.contains_key(key):
            return self.qualified_functions[key]
        -1

    me bind_qualified_type(module_name: text, member_name: text, id: SymbolId):
        # QTYPEIDX (2026-08-22): first binding wins, matching the append-only
        # parallel-array scan this replaces (which returned early on a hit and
        # therefore never overwrote an existing row).
        val key = qualified_symbol_key(module_name, member_name)
        if self.qualified_types.contains_key(key):
            return
        self.qualified_types[key] = id.id

    fn lookup_qualified_type(module_name: text, member_name: text) -> SymbolId?:
        val raw_id = self.lookup_qualified_type_raw(module_name, member_name)
        if raw_id >= 0:
            return SymbolId(id: raw_id)
        nil

    fn lookup_qualified_type_raw(module_name: text, member_name: text) -> i64:
        """Native-safe qualified type lookup.

        Keep the hot lowering boundary scalar: staged native code can corrupt
        a value-type ``SymbolId`` carried inside ``Optional`` even though the
        exact dictionary entry is valid. The return stays a raw ``i64``; only
        the CONTAINER changed.

        QTYPEIDX (2026-08-22): O(1) Dict probe. This used to linear-scan three
        parallel arrays with two text comparisons per row, so every query cost
        O(qualified bindings) -- and 65% of queries are MISSES, which always
        pay the full length. `materialize_imported_callable_dependency` issues
        up to three of these per named type per imported callable per importing
        module, so HIR import lowering paid O(modules x callables x deps x
        bindings): 1,496,719 queries / 1,251,806 misses across one stage-1
        build, and `callable_deps` alone (5,241,657ms) was the single largest
        exclusive term in the whole HIR phase profile, ~3.4ms per query.

        The Dict was already maintained in lockstep by `bind_qualified_type`
        (its only writer) and is the ONLY form the HIR codec serializes -- the
        arrays were dropped on every round trip -- so the Dict was already the
        more authoritative store. The `#` separator makes the key injective:
        `.` allowed ("a.b", "c") and ("a", "b.c") to collide.
        doc/08_tracking/bug/hir_qualified_type_lookup_linear_scan_2026-08-22.md
        """
        val key = qualified_symbol_key(module_name, member_name)
        if self.qualified_types.contains_key(key):
            return self.qualified_types[key]
        -1

    me push_scope(kind: ScopeKind) -> ScopeId:
        """Push a new scope."""
        val raw_id = self.next_scope_id
        val id = ScopeId(id: raw_id)

        # Insert BEFORE advancing `next_scope_id`. The range guards in
        # `lookup`/`lookup_or_invalid`/`declare`/`pop_scope` treat
        # `0 <= id < next_scope_id` as an EXACT substitute for
        # `id in self.scopes`, and that identity only holds if the counter
        # never leads the dict. (This used to advance first, which made the
        # guards' own comments false and left a window where `next_scope_id`
        # admitted a key `self.scopes` did not yet have.)
        self.scopes[raw_id] = Scope(
            id: id,
            parent: Some(self.current_scope),
            kind: kind,
            symbols: {}
        )
        self.next_scope_id = raw_id + 1

        self.current_scope = id
        id

    me pop_scope():
        """Pop current scope."""
        # Same Dict-free range check as `lookup()`/`declare()`. An
        # out-of-range `current_scope` here would trap ud2 "field access on
        # nil receiver" on the bracket read below; there is no parent to walk
        # to in that state, so reset to the always-present root scope.
        if self.current_scope.id < 0 or self.current_scope.id >= self.next_scope_id:
            self.current_scope = ScopeId(id: 0)
            return
        val scope = self.scopes[self.current_scope.id]
        match scope.parent:
            case Some(parent):
                self.current_scope = parent
            case nil:
                pass

# ============================================================================
# HIR Types
# ============================================================================

struct HirType:
    """Type in HIR."""
    kind: HirTypeKind
    span: Span

"""Type kind."""
enum HirTypeKind:
    # Primitive types
    Int(bits: i64, signed: bool)    # i8, i16, i32, i64, u8, u16, u32, u64
    Float(bits: i64)                 # f32, f64
    Bool
    Char
    Str
    Unit                             # ()

    # Composite types
    Tuple(elements: [HirType])
    Array(element: HirType, size: i64?)
    Slice(element: HirType)
    Dict(key: HirType, value: HirType)

    # Reference types
    Ref(inner: HirType, mutable: bool)
    Ptr(inner: HirType, mutable: bool)
    Optional(inner: HirType)
    Result(ok: HirType, err: HirType)

    # User-defined types
    Named(symbol: SymbolId, args: [HirType])
    TypeParam(name: text, bounds: [HirType])

    # Union types
    Union(members: [HirType])        # A | B | C

    # Trait types
    DynTrait(trait_: SymbolId)       # dyn Trait (trait object for dynamic dispatch)

    # Function types
    Function(params: [HirType], ret: HirType, effects: [Effect])

    # Associated type projection: T.Item where T: Iterator
    Projection(base: HirType, assoc_name: text)

    # Isolated (move-only) capability: `iso T` / bitwise_not(T) surface syntax.
    # LANE ISO1 (2026-07-29): previously erased to Infer at lowering (see
    # hir_lowering/types.spl); now carried through so MIR lowering can emit a
    # real Move at iso-typed variable-to-variable binding sites and the NLL
    # borrow checker can report use-after-move for it. Wraps the inner type
    # so every existing consumer that does not special-case Isolated still
    # sees a well-formed HirType via the wildcard match arm (transparent
    # fallback), matching the pre-existing behavior for any code path that
    # has not yet been taught about the capability.
    Isolated(inner: HirType)

    # Special
    # Type inference variable with level for HM generalization
    # - id: unique identifier for the variable
    # - level: scope level at which the variable was created
    #   Higher level = more recently introduced, can be generalized
    Infer(id: i64, level: i64)
    Error
    Never                            # ! type (never returns)
    Any                              # Any type (top type, type erasure)

    # Tensor and Layer types (for dimension checking)
    Tensor(element: HirType, dims: [DimExpr], device: DeviceType?)
    Layer(input: [DimExpr], output: [DimExpr])

impl HirType:
    static fn named(name: text) -> HirType:
        """Build a primitive HirType from its canonical name (i64, u32, f64, bool, unit, usize).
        Used by backends to convert MIR types to HirType for layout computation."""
        val kind = match name:
            case "i64": HirTypeKind.Int(bits: 64, signed: true)
            case "i32": HirTypeKind.Int(bits: 32, signed: true)
            case "i16": HirTypeKind.Int(bits: 16, signed: true)
            case "i8": HirTypeKind.Int(bits: 8, signed: true)
            case "u64": HirTypeKind.Int(bits: 64, signed: false)
            case "u32": HirTypeKind.Int(bits: 32, signed: false)
            case "u16": HirTypeKind.Int(bits: 16, signed: false)
            case "u8": HirTypeKind.Int(bits: 8, signed: false)
            case "usize": HirTypeKind.Int(bits: 64, signed: false)
            case "isize": HirTypeKind.Int(bits: 64, signed: true)
            case "f64": HirTypeKind.Float(bits: 64)
            case "f32": HirTypeKind.Float(bits: 32)
            case "bool": HirTypeKind.Bool
            case "unit": HirTypeKind.Unit
            case _: HirTypeKind.Int(bits: 64, signed: true)
        HirType(kind: kind, span: Span.empty())

# ============================================================================
# Dimension Types (for compile-time dimension checking)
# ============================================================================

struct DimExpr:
    """Dimension expression for tensor shape checking."""
    kind: DimExprKind
    span: Span

"""Dimension expression kind."""
enum DimExprKind:
    Literal(value: i64)                     # 784
    Named(name: text, lo: i64?, hi: i64?)   # batch: 1..128
    Var(id: i64)                            # Inference variable
    Dynamic                                  # Runtime only
    Broadcast                                # Broadcasting dimension
    ConstParam(name: text)                  # Reference to const generic
    # Arithmetic operations
    Add(left: DimExpr, right: DimExpr)
    Mul(left: DimExpr, right: DimExpr)
    Div(left: DimExpr, right: DimExpr)

impl DimExpr:
    static fn literal(value: i64, span: Span) -> DimExpr:
        DimExpr(kind: DimExprKind.Literal(value), span: span)

    static fn named(name: text, span: Span) -> DimExpr:
        DimExpr(kind: DimExprKind.Named(name, nil, nil), span: span)

    static fn named_range(name: text, lo: i64, hi: i64, span: Span) -> DimExpr:
        DimExpr(kind: DimExprKind.Named(name, Some(lo), Some(hi)), span: span)

    static fn var(id: i64, span: Span) -> DimExpr:
        DimExpr(kind: DimExprKind.Var(id), span: span)

    static fn dynamic(span: Span) -> DimExpr:
        DimExpr(kind: DimExprKind.Dynamic, span: span)

    fn is_literal() -> bool:
        match self.kind:
            case Literal(_): true
            case _: false

    fn get_literal() -> i64?:
        match self.kind:
            case Literal(v): Some(v)
            case _: nil

"""Device type for tensors."""
enum DeviceType:
    CPU
    CUDA(id: i64)
    Vulkan(id: i64)

"""Memory space for GPU memory allocation."""
enum MemorySpace:
    Global      # Device global memory (accessible from host)
    Shared      # Workgroup shared memory (fast, limited size)
    Local       # Thread-local memory (registers/private)
    Constant    # Read-only constant memory (cached)
    Uniform     # Vulkan uniform buffer (read-only, broadcast)

struct LayerType:
    """Type for neural network layers with input/output shapes."""
    input_shape: [DimExpr]
    output_shape: [DimExpr]
    params: [ParamShape]
    device: DeviceType?

struct ParamShape:
    """Shape of a trainable parameter in a layer."""
    name: text
    shape: [DimExpr]
    trainable: bool

impl LayerType:
    static fn new(input: [DimExpr], output: [DimExpr]) -> LayerType:
        LayerType(
            input_shape: input,
            output_shape: output,
            params: [],
            device: nil
        )

    static fn with_device_of(layer: LayerType, device: DeviceType) -> LayerType:
        LayerType(
            input_shape: layer.input_shape,
            output_shape: layer.output_shape,
            params: layer.params,
            device: Some(device)
        )

struct Effect:
    """Effect annotation."""
    kind: EffectKind
    span: Span

"""Effect kind."""
enum EffectKind:
    Pure            # No side effects
    IO              # I/O operations
    Async           # Async operations
    Throws(type_: HirType)  # Can throw error
    Mutates         # Mutates state
    Allocates       # Heap allocation
    Custom(name: text)

# ============================================================================
# Exports
# ============================================================================

export HirModule, HirImport, HirImportItem, HirDomainBlock
export SymbolId, HirSymbol, SymbolKind, MethodResolution
export ScopeId, Scope, ScopeKind, SymbolTable
export HirType, HirTypeKind
export DimExpr, DimExprKind
export DeviceType, MemorySpace, LayerType, ParamShape

# ============================================================================
# Optional payload accessor
# ============================================================================

@unsafe(reason: "raw enum discriminant probe; -1 is the not-an-enum sentinel", capabilities: [ffi])
extern fn rt_enum_discriminant(value: HirTypeKind) -> i64

# Payload of an `Optional` whose inner type is a CONTAINER (Dict/Array/Slice),
# else nil.
#
# Discriminant-guarded before the `match`, the same idiom every
# `parser_type_kind_*` accessor uses: a qualified-arm match against an enum
# value built through a different import spelling of the same module silently
# falls to the wildcard on some lanes, and both callers of this helper also
# import `TypeKind`, which has colliding variant names.
#
# CONTAINER-only on purpose. Typing an unannotated `val x = f()` as the bare
# payload when `f` returns `T?` is what a human writes by hand (see the
# `val map: Dict<text, any> = json_to_object(obj)` bindings in
# src/lib/common/json/object_ops.spl), but doing it for EVERY optional return
# would change what `.?` and `unwrap()` see on hundreds of bindings, and there
# is no test lane that native-builds, so no suite would catch a regression.
# Containers are the case where the loss is fatal rather than merely
# imprecise: it surfaces as "#143 for-in over non-array iterables".
# doc/08_tracking/bug/for_in_optional_initialized_local_loses_collection_type_2026-08-24.md
fn _hir_optional_container_payload(t: HirType) -> HirType?:
    val tk: HirTypeKind = t.kind
    if rt_enum_discriminant(tk) != rt_enum_discriminant(HirTypeKind.Optional(t)):
        return nil
    val inner: HirType? = match tk:
        case HirTypeKind.Optional(payload): payload
        case _: nil
    if not inner.?:
        return nil
    val inner_t: HirType = inner ?? t
    val ik: HirTypeKind = inner_t.kind
    val ik_disc = rt_enum_discriminant(ik)
    if ik_disc == rt_enum_discriminant(HirTypeKind.Dict(inner_t, inner_t)):
        return inner_t
    if ik_disc == rt_enum_discriminant(HirTypeKind.Array(inner_t, nil)):
        return inner_t
    if ik_disc == rt_enum_discriminant(HirTypeKind.Slice(inner_t)):
        return inner_t
    nil

export Effect, EffectKind
export _hir_optional_container_payload
# ============================================================================
