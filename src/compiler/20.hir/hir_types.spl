# HIR Types - Core Types and Symbol Table
#
# This module contains:
# - HIR module structure and imports
# - Symbol table with name resolution and UFCS support
# - HIR type system (primitives, composites, references, user-defined)
# - Dimension types for compile-time tensor checking
# - Effect system

use compiler.frontend.parser_types.*
use compiler.frontend.parser_types_expr.*
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
# `std.alloc.sffi` exists only in the seed library tree.  The self-hosted
# Stage 3 closure must bind the runtime symbol directly.
extern fn rt_dict_contains(dict: i64, key: Any) -> bool

# ============================================================================
# HIR Module Structure
# ============================================================================

struct HirModule:
    """Complete HIR module."""
    name: text
    path: text
    imports: [HirImport]
    exports: [text]
    domain_blocks: [HirDomainBlock]
    symbols: SymbolTable
    functions: Dict<SymbolId, HirFunction>
    gpu_function_targets: Dict<text, text>
    gpu_function_backend_orders: Dict<text, text>
    classes: Dict<SymbolId, HirClass>
    structs: Dict<SymbolId, HirStruct>
    enums: Dict<SymbolId, HirEnum>
    bitfields: Dict<SymbolId, HirBitfield>
    traits: Dict<SymbolId, HirTrait>
    impls: [HirImpl]
    constants: Dict<SymbolId, HirConst>
    static_asserts: [HirStaticAssert]   # Static assertions evaluated at compile time
    aop_advices: [HirAopAdvice]
    di_bindings: [HirDiBinding]
    arch_rules: [HirArchRule]
    mock_decls: [HirMockDecl]
    types: [text]

struct HirImport:
    """Import declaration."""
    module_path: text
    items: [HirImportItem]
    is_lazy: bool
    span: Span

struct HirImportItem:
    """Single imported item."""
    name: text
    alias: text?
    resolved: SymbolId?     # Resolved after linking

struct HirDomainBlock:
    """Raw top-level domain block carried into HIR metadata."""
    kind: text
    payload: text
    context: text
    span: Span

# ============================================================================
# Symbol Table
# ============================================================================

struct SymbolId:
    """Unique identifier for a symbol."""
    id: i64

impl SymbolId:
    static fn new(id: i64) -> SymbolId:
        SymbolId(id: id)

    fn is_valid() -> bool:
        self.id >= 0

struct HirSymbol:
    """Symbol table entry."""
    id: SymbolId
    name: text
    kind: SymbolKind
    type_: HirType?
    scope: ScopeId
    span: Span
    visibility: Visibility
    is_public: bool
    is_mutable: bool
    defining_module: text?   # Which module defined this symbol (for visibility checking)

"""Kind of symbol."""
enum SymbolKind:
    Function
    Method
    Variable
    Parameter
    Field
    Class
    Struct
    Enum
    EnumVariant
    Trait
    TypeAlias
    TypeParam
    Const
    Module
    Import

# ============================================================================
# Method Resolution (UFCS Support)
# ============================================================================

"""How a method call was resolved.

Supports UFCS (Uniform Function Call Syntax) where `x.method()` can resolve to:
1. Instance method on x's type (highest priority)
2. Trait method implemented by x's type
3. Free function `method(x)` where first param matches x's type (UFCS)

Examples:
    x.map()  ->  InstanceMethod if x's class has map()
    x.map()  ->  TraitMethod if x implements trait with map()
    x.map()  ->  FreeFunction(map) if map(x) exists and first param matches
"""
enum MethodResolution:
    # Direct method on the receiver's type
    InstanceMethod(type_id: SymbolId, method_id: SymbolId)

    # Method from an implemented trait
    TraitMethod(trait_id: SymbolId, method_id: SymbolId)

    # UFCS: Free function where receiver becomes first argument
    # x.method(a, b) -> method(x, a, b)
    FreeFunction(func_id: SymbolId)

    # Static method on a type (no receiver)
    # Type.method(a, b) - no self parameter
    StaticMethod(type_id: SymbolId, method_id: SymbolId)

    # Not yet resolved (before resolution pass)
    Unresolved

impl MethodResolution:
    fn is_resolved() -> bool:
        """Check if method has been resolved."""
        match self:
            case Unresolved: false
            case _: true

    fn is_ufcs() -> bool:
        """Check if this is a UFCS resolution (free function)."""
        match self:
            case FreeFunction(_): true
            case _: false

    fn get_symbol_id() -> SymbolId?:
        """Get the resolved symbol ID if available.

        Bare-lift accumulator: explicit Some(...) builds a heap Option box on
        the stage4 native lane and if-val at the caller binds the BOX
        un-unwrapped (bug doc 2026-07-23 family)."""
        match self:
            case InstanceMethod(_, method_id): method_id
            case TraitMethod(_, method_id): method_id
            case FreeFunction(func_id): func_id
            case StaticMethod(_, method_id): method_id
            case Unresolved: nil

struct ScopeId:
    """Unique identifier for a scope."""
    id: i64

struct Scope:
    """Lexical scope."""
    id: ScopeId
    parent: ScopeId?
    kind: ScopeKind
    symbols: Dict<text, i64>

"""Kind of scope."""
enum ScopeKind:
    Module
    Function
    Block
    Loop
    Match
    Class
    Impl

class SymbolTable:
    """Symbol table for name resolution."""
    symbols: Dict<i64, HirSymbol>
    scopes: Dict<i64, Scope>
    current_scope: ScopeId
    next_symbol_id: i64
    next_scope_id: i64
    gpu_function_targets: Dict<text, text>
    gpu_function_backend_orders: Dict<text, text>
    qualified_functions: Dict<text, i64>
    qualified_types: Dict<text, i64>
    exact_symbols: Dict<text, i64>
    # Persistent root owner reused by reset_module. The Scope row is a small
    # routing value; its symbol backing never crosses reset by value.
    root_scope_symbols: Dict<text, i64>

fn _hir_symbol_owner_module(path: text) -> text:
    if path.starts_with("../"):
        return _hir_symbol_owner_module(path.substring(3))
    val relative = if path.starts_with("./"): path.substring(2) else: path
    val source_relative = if relative.starts_with("src/"): relative.substring(4) else: relative
    source_relative.replace(".spl", "").replace(".sdn", "").replace("/", ".")

impl SymbolTable:
    static fn new() -> SymbolTable:
        var root_scope_symbols: Dict<text, i64> = {}
        var table = SymbolTable(
            symbols: {},
            scopes: {},
            current_scope: ScopeId(id: 0),
            next_symbol_id: 0,
            next_scope_id: 1,
            gpu_function_targets: {},
            gpu_function_backend_orders: {},
            qualified_functions: {},
            qualified_types: {},
            exact_symbols: {},
            root_scope_symbols: root_scope_symbols
        )
        # Create root scope (direct mutation avoids copy-modify-reassign bug)
        table.scopes[0] = Scope(
            id: ScopeId(id: 0),
            parent: nil,
            kind: ScopeKind.Module,
            symbols: root_scope_symbols
        )
        table

    me reset_module():
        """Reset module-local symbol state without replacing this table."""
        self.root_scope_symbols.clear()
        self.symbols.clear()
        self.scopes.clear()
        self.gpu_function_targets.clear()
        self.gpu_function_backend_orders.clear()
        self.qualified_functions.clear()
        self.qualified_types.clear()
        self.exact_symbols.clear()
        self.current_scope = ScopeId(id: 0)
        self.next_symbol_id = 0
        self.next_scope_id = 1
        self.scopes[0] = Scope(
            id: ScopeId(id: 0), parent: nil,
            kind: ScopeKind.Module, symbols: self.root_scope_symbols)

    me register_gpu_function_metadata(name: text, target: text, backend_order: text):
        self.gpu_function_targets[name] = target
        self.gpu_function_backend_orders[name] = backend_order

    fn has_gpu_function_metadata(name: text) -> bool:
        self.gpu_function_targets.has(name)

    fn gpu_function_target(name: text) -> text:
        if self.gpu_function_targets.has(name): self.gpu_function_targets[name] else: ""

    fn gpu_function_backend_order(name: text) -> text:
        if self.gpu_function_backend_orders.has(name): self.gpu_function_backend_orders[name] else: ""

    me define(name: text, kind: SymbolKind, type_: HirType?, span: Span, visibility: Visibility, is_mutable: bool, defining_module: text?) -> SymbolId:
        """Define a new symbol in current scope.

        For type-level symbols (Class, Struct, Enum, Trait): first-write-wins.
        If the name is already bound in the current scope and the existing entry's
        defining_module matches, return the existing id (idempotent re-register).
        If a different module already registered the name, the first registration
        wins and this call is a no-op (returns the existing id).
        For non-type symbols (Variable, Parameter, Field, etc.) always create a
        new entry so shadowing and overloading work as before.
        """
        # First-write-wins for type-level symbols
        val is_type_symbol = match kind:
            case SymbolKind.Class: true
            case SymbolKind.Struct: true
            case SymbolKind.Enum: true
            case SymbolKind.Trait: true
            case _: false

        # Same Dict-free `next_scope_id` range check `lookup()` uses (see its
        # long comment): `self.scopes` is append-only with scope 0 always
        # present (both `new()` and `reset_module()` insert it), so an
        # out-of-range `current_scope` can only come from a corrupted/stale
        # read of this scalar field. Without this, the bracket reads below
        # trap ud2 "field access on nil receiver" exactly like `lookup()` did
        # -- the guard landed there covered only 2 of the 5 bracket reads of
        # `self.scopes` in this file. Recovering to the root scope is the
        # behaviour-preserving repair: in every correct execution the guard
        # is a no-op, and scope 0 is the scope a flat/bootstrap symbol table
        # is supposed to be in anyway.
        # doc/08_tracking/bug/stage3_symboltable_lookup_ud2_field_access_nil_receiver_2026-08-06.md
        if self.current_scope.id < 0 or self.current_scope.id >= self.next_scope_id:
            self.current_scope = ScopeId(id: 0)

        if is_type_symbol:
            val scope = self.scopes[self.current_scope.id]
            val existing = scope.symbols.get(name)
            if existing != nil:
                # Already registered — return the existing id (first-write-wins).
                # Bracket-index read: same stage4 lane hardening as `lookup`.
                return SymbolId(id: scope.symbols[name])

        val raw_id = self.next_symbol_id
        val id = SymbolId(id: raw_id)
        self.next_symbol_id = raw_id + 1

        val symbol = HirSymbol(
            id: id,
            name: name,
            kind: kind,
            type_: type_,
            scope: self.current_scope,
            span: span,
            visibility: visibility,
            is_public: visibility == Visibility.Public,
            is_mutable: is_mutable,
            defining_module: defining_module
        )

        self.symbols[raw_id] = symbol
        if not self.exact_symbols.has(name):
            self.exact_symbols[name] = raw_id

        # Copy-modify-reassign for interpreter compatibility
        var scope = self.scopes[self.current_scope.id]
        var scope_syms = scope.symbols
        scope_syms[name] = raw_id
        scope.symbols = scope_syms
        self.scopes[self.current_scope.id] = scope

        id

    me bind_qualified_function(module_name: text, member_name: text, id: SymbolId):
        val key = module_name + "." + member_name
        if not self.qualified_functions.has(key):
            self.qualified_functions[key] = id.id

    fn lookup_qualified_function(module_name: text, member_name: text) -> SymbolId?:
        val raw_id = self.lookup_qualified_function_raw(module_name, member_name)
        if raw_id >= 0:
            return SymbolId(id: raw_id)
        nil

    fn lookup_qualified_function_raw(module_name: text, member_name: text) -> i64:
        """Native-safe scalar qualified-function lookup, including id zero."""
        val key = module_name + "." + member_name
        if self.qualified_functions.has(key):
            return self.qualified_functions[key]
        -1

    me bind_qualified_type(module_name: text, member_name: text, id: SymbolId):
        val key = module_name + "." + member_name
        if not self.qualified_types.has(key):
            self.qualified_types[key] = id.id

    fn lookup_qualified_type(module_name: text, member_name: text) -> SymbolId?:
        val raw_id = self.lookup_qualified_type_raw(module_name, member_name)
        if raw_id >= 0:
            return SymbolId(id: raw_id)
        nil

    fn lookup_qualified_type_raw(module_name: text, member_name: text) -> i64:
        """Native-safe qualified type lookup.

        Keep the hot lowering boundary scalar: staged native code can corrupt
        a value-type ``SymbolId`` carried inside ``Optional`` even though the
        exact dictionary entry is valid.
        """
        val key = module_name + "." + member_name
        if self.qualified_types.has(key):
            return self.qualified_types[key]
        -1

    me register_preserved_symbol(symbol: HirSymbol):
        """Register a pre-numbered flat/bootstrap symbol without losing the
        exact-name index used by lowering hot paths."""
        val raw_id = symbol.id.id
        self.symbols[raw_id] = symbol
        if not self.exact_symbols.has(symbol.name):
            self.exact_symbols[symbol.name] = raw_id
        if raw_id >= self.next_symbol_id:
            self.next_symbol_id = raw_id + 1

    fn lookup_exact_type(name: text) -> SymbolId?:
        """Look up an exact class/struct/enum/trait name in O(1)."""
        if self.exact_symbols.has(name):
            val raw_id = self.exact_symbols[name]
            if val symbol = self.get_symbol_raw(raw_id):
                match symbol.kind:
                    case Class | Struct | Enum | Trait:
                        return Some(symbol.id)
                    case _: pass
        nil
    fn lookup(name: text) -> SymbolId?:
        """Look up a symbol by name, searching up scope chain."""
        var scope_id = self.current_scope

        loop:
            # DO NOT re-add an `if not rt_dict_contains(self.scopes,
            # scope_id.id): break` guard here. It was added as
            # "defense-in-depth" by 1ea6599e8fb and it broke the Stage 3
            # self-host outright: `new()` DOES insert the id-0 root scope
            # (`table.scopes[0] = Scope(...)` above) and `declare()` writes
            # symbols into it, but `rt_dict_contains` under-reports
            # membership on this struct-valued `Dict<i64, Scope>` (the
            # documented native struct-valued-Dict pitfall,
            # doc/07_guide/language/dict_native_pitfalls.md). The guard
            # therefore ended the chain immediately and made lookup() a
            # constant nil, which silently disabled the ONLY re-entrancy
            # breakers in the HIR bootstrap-global cycle -- both
            # try_register_bootstrap_global_symbol and
            # register_imported_symbol memoize on `self.symbols.lookup(...)`
            # -- producing unbounded mutual recursion (lower_type ->
            # lower_named_kind -> try_register_bootstrap_global_symbol ->
            # register_imported_symbol -> register_imported_type_methods ->
            # declared_surface_callable_type -> lower_type) that overflowed
            # the stack and SIGSEGVed Stage 3 with zero diagnostic output.
            # See doc/08_tracking/bug/
            # stage3_native_build_segv_generic_codegen_link_path_2026-08-06.md.
            #
            # Instead: `self.scopes` is append-only and `next_scope_id` is
            # its exact cardinality counter -- `push_scope` is the ONLY
            # writer, always inserting `self.scopes[raw_id]` before
            # advancing `next_scope_id = raw_id + 1`, and nothing anywhere
            # in this file ever removes a key from `self.scopes`. So
            # `scope_id.id in self.scopes` is EXACTLY
            # `0 <= scope_id.id < self.next_scope_id` -- a plain scalar i64
            # comparison, not a Dict operation, so it cannot exhibit the
            # `rt_dict_contains` false-negative bug (that bug is specific to
            # Dict membership calls on this struct-valued dict; a bare `<`
            # on two `i64` fields is untouched by it). This also guards
            # against the ud2 "field access on nil receiver" trap from an
            # out-of-range `scope_id` reaching the bracket read below (see
            # doc/08_tracking/bug/
            # stage3_symboltable_lookup_ud2_field_access_nil_receiver_2026-08-06.md).
            if scope_id.id < 0 or scope_id.id >= self.next_scope_id:
                break
            val scope = self.scopes[scope_id.id]
            # Dict.get can falsely report nil for a present tagged integer on
            # the self-hosted native path. The runtime-owner predicate plus a
            # bracket read keeps the value type-directed and untagged.
            if rt_dict_contains(scope.symbols, name):
                val found: i64 = scope.symbols[name]
                return SymbolId(id: found)

            match scope.parent:
                case Some(parent):
                    scope_id = parent
                case nil:
                    break

        nil

    fn lookup_or_invalid(name: text) -> SymbolId:
        """Look up a symbol by name, returning an invalid id when missing."""
        var scope_id = self.current_scope

        loop:
            # See lookup()'s matching comment: do NOT re-add an
            # `rt_dict_contains(self.scopes, scope_id.id)` guard here -- it
            # under-reports membership on this struct-valued dict and breaks
            # the Stage 3 self-host via unbounded HIR recursion. Use the same
            # Dict-free `next_scope_id` range check instead (exact substitute
            # for membership -- see lookup()'s full comment).
            if scope_id.id < 0 or scope_id.id >= self.next_scope_id:
                break
            val scope = self.scopes[scope_id.id]
            if rt_dict_contains(scope.symbols, name):
                val found: i64 = scope.symbols[name]
                return SymbolId(id: found)

            match scope.parent:
                case Some(parent):
                    scope_id = parent
                case nil:
                    break

        SymbolId(id: -1)

    fn get_symbol(id: SymbolId?) -> HirSymbol?:
        """Get symbol by ID.

        Renamed from `get` to `get_symbol`: the compiled method resolver
        mis-dispatched `scope.symbols.get(name)` (a Dict.get with a text key,
        inside `lookup`) to this same-named SymbolTable method, passing a text
        where a SymbolId? was expected -> garbage id -> nil-deref
        ("field access on nil receiver"). Eliminating the `get` name collision
        lets Dict.get resolve correctly. See driver.spl lower_and_check_impl.

        Bug 2026-07-29 (hir_get_symbol_id_zero_returns_nil): a naked
        `case SymbolId(raw):` pattern matched directly against the `SymbolId?`
        (Option-wrapped) parameter ALWAYS falls through to the wildcard arm on
        this interpreter -- for every id, not just 0 -- because a struct
        constructor pattern cannot destructure through the implicit Option
        layer in one step; only `case Some(SymbolId(raw)):` reliably unwraps
        it (proven by isolated probe: `case PId(raw):` against a `PId?`
        returned from a helper fell to wildcard for raw=0 AND raw=1, while
        `case Some(PId(raw)):` matched both correctly). id 0 is a completely
        ordinary, validly-allocated id (`is_valid()` already treats it as
        such) -- the fix is this match shape, not the id allocator."""
        match id:
            case Some(SymbolId(raw)):
                val found: HirSymbol? = self.symbols[raw]
                found
            case _:
                nil

    fn get_symbol_raw(raw: i64) -> HirSymbol?:
        """Raw-i64 form of get_symbol: passing a flat optional OR a struct
        value as a function argument is miscompiled on the stage4 native lane
        (bug doc bootstrap_stage4_optional_arg_and_mixed_tail_miscompile_2026-07-23) —
        callers extract `.id` at the call site and pass the plain i64."""
        # has()+bracket: Dict.get returns a TAGGED value on the stage4 native
        # lane; bracket-index takes the untag path (bug doc 2026-07-23 family).
        if self.symbols.has(raw):
            return self.symbols[raw]
        nil

    fn exact_local_value_binding_raw(raw: i64, payload_name: text) -> bool:
        """Whether `raw` names the exact local value authored by a Var or
        NamedVar payload. Keep the record inspection inside SymbolTable so a
        staged-native HirSymbol? payload never crosses the method boundary."""
        if raw < 0 or payload_name == "" or not self.symbols.has(raw):
            return false
        val symbol = self.symbols[raw]
        if symbol.name != payload_name:
            return false
        match symbol.kind:
            case SymbolKind.Variable | SymbolKind.Parameter:
                return true
            case _:
                return false

    me symbol_display_name(id: SymbolId, fallback: text) -> text:
        """Return the CURRENT stored `.name` for `id` (reflecting any
        `rename_symbol` call), or `fallback` if the id isn't found.

        Uniquely named to avoid the same seed method-resolver name+arity
        collision `get_symbol` was itself renamed to dodge (see its
        docstring): `LoadedModule.get_symbol(name: text)`
        (99.loader/module_loader.spl) has the SAME name and arity (1 param)
        as `SymbolTable.get_symbol(id: SymbolId?)`, and empirically the
        compiled resolver dispatches a HIR-layer `self.symbols.get_symbol(id)`
        call to the WRONG (loader) sibling here -- `id` (a SymbolId) gets
        passed where `name: text` is expected, `self.symbols.has(name)`
        silently returns false for the garbage-typed key, and every call
        returns nil regardless of whether the id is actually present (bug
        bootstrap_stage2_empty_mir_bodies_2026-07-05, Probe B)."""
        match id:
            case SymbolId(raw):
                val found: HirSymbol? = self.symbols[raw]
                if val sym = found:
                    return sym.name
                fallback
            case _:
                fallback

    me rename_symbol(id: SymbolId, new_name: text):
        """Overwrite a symbol's stored `.name` in place, WITHOUT touching its
        scope lookup key. Used to give a --entry-closure cross-module
        function import a qualified `module.function` display/emission name
        (distinct across modules, unlike its possibly-shared bare or
        alias-local name) while `compute_a`/`compute_b` etc. still resolve
        via the original scope entry created by `define()` (bug
        bootstrap_stage2_empty_mir_bodies_2026-07-05, Probe B)."""
        match id:
            case SymbolId(raw):
                val found: HirSymbol? = self.symbols[raw]
                if val sym = found:
                    val renamed = HirSymbol(
                        id: sym.id,
                        name: new_name,
                        kind: sym.kind,
                        type_: sym.type_,
                        scope: sym.scope,
                        span: sym.span,
                        visibility: sym.visibility,
                        is_public: sym.is_public,
                        is_mutable: sym.is_mutable,
                        defining_module: sym.defining_module
                    )
                    self.symbols[raw] = renamed
                    if not self.exact_symbols.has(new_name):
                        self.exact_symbols[new_name] = raw
            case _:
                pass

    me push_scope(kind: ScopeKind) -> ScopeId:
        """Push a new scope."""
        val raw_id = self.next_scope_id
        val id = ScopeId(id: raw_id)

        # Insert BEFORE advancing `next_scope_id`. The range guards in
        # `lookup`/`lookup_or_invalid`/`declare`/`pop_scope` treat
        # `0 <= id < next_scope_id` as an EXACT substitute for
        # `id in self.scopes`, and that identity only holds if the counter
        # never leads the dict. (This used to advance first, which made the
        # guards' own comments false and left a window where `next_scope_id`
        # admitted a key `self.scopes` did not yet have.)
        self.scopes[raw_id] = Scope(
            id: id,
            parent: Some(self.current_scope),
            kind: kind,
            symbols: {}
        )
        self.next_scope_id = raw_id + 1

        self.current_scope = id
        id

    me pop_scope():
        """Pop current scope."""
        # Same Dict-free range check as `lookup()`/`declare()`. An
        # out-of-range `current_scope` here would trap ud2 "field access on
        # nil receiver" on the bracket read below; there is no parent to walk
        # to in that state, so reset to the always-present root scope.
        if self.current_scope.id < 0 or self.current_scope.id >= self.next_scope_id:
            self.current_scope = ScopeId(id: 0)
            return
        val scope = self.scopes[self.current_scope.id]
        match scope.parent:
            case Some(parent):
                self.current_scope = parent
            case nil:
                pass

    # ========================================================================
    # Method Resolution Helpers (for UFCS support)
    # ========================================================================

    fn lookup_function(name: text) -> SymbolId?:
        """Look up a free function by name."""
        val found_id = self.lookup_or_invalid(name)
        if found_id.is_valid():
            val sym: HirSymbol? = self.get_symbol(found_id)
            if val found = sym:
                match found.kind:
                    case SymbolKind.Function: return found_id
                    case _: pass
        nil

    fn method_symbol_name(type_id: SymbolId, method_name: text) -> text:
        self.method_symbol_name_raw(type_id.id, method_name)

    fn method_symbol_name_raw(raw_type_id: i64, method_name: text) -> text:
        if val type_symbol = self.get_symbol_raw(raw_type_id):
            val owner_module = _hir_symbol_owner_module(type_symbol.defining_module ?? "")
            val owner = if owner_module != "": "{owner_module}.{type_symbol.name}" else: type_symbol.name
            return "{owner}::{method_name}"
        method_name

    fn lookup_method_in_type(type_id: SymbolId, method_name: text) -> SymbolId?:
        self.lookup_method_in_type_raw(type_id.id, method_name)

    fn lookup_method_in_type_raw(raw_type_id: i64, method_name: text) -> SymbolId?:
        """Look up a method in a class/struct type.

        Searches for a method named `method_name` defined in the type
        identified by `type_id`.
        """
        # Get the type's scope (class or struct body)
        if self.get_symbol_raw(raw_type_id) == nil:
            return nil

        # Look for a Method symbol with matching name in the type's members
        # This requires traversing impl blocks associated with the type
        # For now, use a naming convention: Type::method
        val qualified_name = self.method_symbol_name_raw(raw_type_id, method_name)
        if self.exact_symbols.has(qualified_name):
            val raw_id = self.exact_symbols[qualified_name]
            if val sym = self.get_symbol_raw(raw_id):
                match sym.kind:
                    case Method:
                        return sym.id
                    case Function:
                        return sym.id  # Static methods
                    case _: pass

        nil

    fn lookup_trait_method(trait_id: SymbolId, method_name: text) -> SymbolId?:
        self.lookup_trait_method_raw(trait_id.id, method_name)

    fn lookup_trait_method_raw(raw_trait_id: i64, method_name: text) -> SymbolId?:
        """Look up a method in a trait.

        Searches for a method named `method_name` defined in the trait
        identified by `trait_id`.
        """
        if self.get_symbol_raw(raw_trait_id) == nil:
            return nil

        # Look for trait method using qualified name
        val qualified_name = self.method_symbol_name_raw(raw_trait_id, method_name)
        if self.exact_symbols.has(qualified_name):
            val raw_id = self.exact_symbols[qualified_name]
            if val sym = self.get_symbol_raw(raw_id):
                match sym.kind:
                    case Method:
                        return sym.id
                    case _: pass

        nil

    fn lookup_static_method(type_id: SymbolId, method_name: text) -> SymbolId?:
        self.lookup_static_method_raw(type_id.id, method_name)

    fn lookup_static_method_raw(raw_type_id: i64, method_name: text) -> SymbolId?:
        """Look up a static method in a class/struct/enum.

        Static methods are defined with `static fn` and don't have a `self` parameter.
        """
        if self.get_symbol_raw(raw_type_id) == nil:
            return nil

        # Static methods are stored as Function symbols with qualified names
        val qualified_name = self.method_symbol_name_raw(raw_type_id, method_name)
        if self.exact_symbols.has(qualified_name):
            val raw_id = self.exact_symbols[qualified_name]
            if val sym = self.get_symbol_raw(raw_id):
                match sym.kind:
                    case Function:
                        return sym.id  # Static methods
                    case _: pass

        nil

    fn lookup_unique_static_method(method_name: text) -> SymbolId?:
        """Recover an unambiguous owner-qualified static method by leaf name.

        Native bootstrap lowering can lose the aggregate HirExpr payload for a
        type-valued receiver while retaining the scalar method name. Exact
        symbols encode static impl functions as `owner::method`; accepting a
        candidate only when every matching key names the same Function keeps
        this fallback fail-closed when two owners expose the same leaf.
        """
        val suffix = "::" + method_name
        var candidate: SymbolId? = nil
        for qualified_name in self.exact_symbols.keys():
            if qualified_name.ends_with(suffix):
                val raw_id = self.exact_symbols[qualified_name]
                if val symbol = self.get_symbol_raw(raw_id):
                    match symbol.kind:
                        case Function:
                            if val prior = candidate:
                                if prior.id != symbol.id.id:
                                    return nil
                            else:
                                candidate = Some(symbol.id)
                        case _: ()
        candidate

    fn get_symbol_type(id: SymbolId) -> HirType?:
        """Get the type of a symbol."""
        return self.get_symbol_type_raw(id.id)

    fn get_symbol_type_raw(raw: i64) -> HirType?:
        """Raw-i64 form of get_symbol_type. Passing a struct value (SymbolId)
        as a function argument is miscompiled on the stage4 native lane (bug
        bootstrap_stage4_optional_arg_and_mixed_tail_miscompile_2026-07-23) ->
        garbage id -> get_symbol returns a present-but-nil Option -> `found.type_`
        SIGILLs "field access on nil receiver" for EVERY struct field access
        during AOT lowering. Mirror get_symbol_raw: take the plain i64."""
        val sym = self.get_symbol_raw(raw)
        if val found = sym:
            if found != nil:
                found.type_
            else:
                nil
        else:
            nil

    fn get_symbol_named_type_raw(raw: i64) -> i64:
        """Return the raw named-type owner of a value symbol, or -1.

        This keeps both ``HirType?`` and ``SymbolId?`` inside SymbolTable;
        neither value-type optional is safe across the staged-native method
        boundary used by nested field lowering.
        """
        if val symbol = self.get_symbol_raw(raw):
            if symbol.type_ != nil:
                val symbol_type = symbol.type_ ?? HirType(
                    kind: HirTypeKind.Error, span: symbol.span)
                match symbol_type.kind:
                    case HirTypeKind.Named(owner, _): return owner.id
                    case _: ()
        -1

    fn is_function(id: SymbolId) -> bool:
        """Check if symbol is a function."""
        val sym = self.get_symbol(id)
        if val found = sym:
            match found.kind:
                case Function: true
                case _: false
        else:
            false

    fn is_method(id: SymbolId) -> bool:
        """Check if symbol is a method."""
        val sym = self.get_symbol(id)
        if val found = sym:
            match found.kind:
                case Method: true
                case _: false
        else:
            false

    fn get_methods_for_type(type_id: SymbolId) -> [text]:
        """Get all method names for a type (for error suggestions)."""
        var methods: [text] = []
        val type_sym = self.get_symbol(type_id)
        if not type_sym.?:
            return methods
        var type_symbol: HirSymbol = HirSymbol(id: type_id, name: "", kind: SymbolKind.Struct, type_: nil, scope: ScopeId(id: 0), span: Span.empty(), visibility: Visibility.Private, is_public: false, is_mutable: false, defining_module: nil)
        if val found_type_symbol = type_sym:
            type_symbol = found_type_symbol
        else:
            return methods

        val type_name = type_symbol.name
        val prefix = "{type_name}::"

        for sym in self.symbols.values():
            if not sym.?:
                pass
            elif not sym.name.?:
                pass
            elif sym.name.starts_with(prefix):
                match sym.kind:
                    case Method:
                        # Extract method name from qualified name
                        val method_name = sym.name[prefix.len():]
                        methods = methods.push(method_name)
                    case _: pass

        methods

    fn get_all_functions() -> [text]:
        """Get all function names (for error suggestions)."""
        var functions: [text] = []

        for sym in self.symbols.values():
            match sym.kind:
                case Function:
                    # Only include non-qualified names (free functions)
                    if not sym.name.contains("::"):
                        functions = functions.push(sym.name)
                case _: pass

        functions

# ============================================================================
# HIR Types
# ============================================================================

struct HirType:
    """Type in HIR."""
    kind: HirTypeKind
    span: Span

"""Type kind."""
enum HirTypeKind:
    # Primitive types
    Int(bits: i64, signed: bool)    # i8, i16, i32, i64, u8, u16, u32, u64
    Float(bits: i64)                 # f32, f64
    Bool
    Char
    Str
    Unit                             # ()

    # Composite types
    Tuple(elements: [HirType])
    Array(element: HirType, size: i64?)
    Slice(element: HirType)
    Dict(key: HirType, value: HirType)

    # Reference types
    Ref(inner: HirType, mutable: bool)
    Ptr(inner: HirType, mutable: bool)
    Optional(inner: HirType)
    Result(ok: HirType, err: HirType)

    # User-defined types
    Named(symbol: SymbolId, args: [HirType])
    TypeParam(name: text, bounds: [HirType])

    # Union types
    Union(members: [HirType])        # A | B | C

    # Trait types
    DynTrait(trait_: SymbolId)       # dyn Trait (trait object for dynamic dispatch)

    # Function types
    Function(params: [HirType], ret: HirType, effects: [Effect])

    # Associated type projection: T.Item where T: Iterator
    Projection(base: HirType, assoc_name: text)

    # Isolated (move-only) capability: `iso T` / bitwise_not(T) surface syntax.
    # LANE ISO1 (2026-07-29): previously erased to Infer at lowering (see
    # hir_lowering/types.spl); now carried through so MIR lowering can emit a
    # real Move at iso-typed variable-to-variable binding sites and the NLL
    # borrow checker can report use-after-move for it. Wraps the inner type
    # so every existing consumer that does not special-case Isolated still
    # sees a well-formed HirType via the wildcard match arm (transparent
    # fallback), matching the pre-existing behavior for any code path that
    # has not yet been taught about the capability.
    Isolated(inner: HirType)

    # Special
    # Type inference variable with level for HM generalization
    # - id: unique identifier for the variable
    # - level: scope level at which the variable was created
    #   Higher level = more recently introduced, can be generalized
    Infer(id: i64, level: i64)
    Error
    Never                            # ! type (never returns)
    Any                              # Any type (top type, type erasure)

    # Tensor and Layer types (for dimension checking)
    Tensor(element: HirType, dims: [DimExpr], device: DeviceType?)
    Layer(input: [DimExpr], output: [DimExpr])

impl HirType:
    static fn named(name: text) -> HirType:
        """Build a primitive HirType from its canonical name (i64, u32, f64, bool, unit, usize).
        Used by backends to convert MIR types to HirType for layout computation."""
        val kind = match name:
            case "i64": HirTypeKind.Int(bits: 64, signed: true)
            case "i32": HirTypeKind.Int(bits: 32, signed: true)
            case "i16": HirTypeKind.Int(bits: 16, signed: true)
            case "i8": HirTypeKind.Int(bits: 8, signed: true)
            case "u64": HirTypeKind.Int(bits: 64, signed: false)
            case "u32": HirTypeKind.Int(bits: 32, signed: false)
            case "u16": HirTypeKind.Int(bits: 16, signed: false)
            case "u8": HirTypeKind.Int(bits: 8, signed: false)
            case "usize": HirTypeKind.Int(bits: 64, signed: false)
            case "isize": HirTypeKind.Int(bits: 64, signed: true)
            case "f64": HirTypeKind.Float(bits: 64)
            case "f32": HirTypeKind.Float(bits: 32)
            case "bool": HirTypeKind.Bool
            case "unit": HirTypeKind.Unit
            case _: HirTypeKind.Int(bits: 64, signed: true)
        HirType(kind: kind, span: Span.empty())

# ============================================================================
# Dimension Types (for compile-time dimension checking)
# ============================================================================

struct DimExpr:
    """Dimension expression for tensor shape checking."""
    kind: DimExprKind
    span: Span

"""Dimension expression kind."""
enum DimExprKind:
    Literal(value: i64)                     # 784
    Named(name: text, lo: i64?, hi: i64?)   # batch: 1..128
    Var(id: i64)                            # Inference variable
    Dynamic                                  # Runtime only
    Broadcast                                # Broadcasting dimension
    ConstParam(name: text)                  # Reference to const generic
    # Arithmetic operations
    Add(left: DimExpr, right: DimExpr)
    Mul(left: DimExpr, right: DimExpr)
    Div(left: DimExpr, right: DimExpr)

impl DimExpr:
    static fn literal(value: i64, span: Span) -> DimExpr:
        DimExpr(kind: DimExprKind.Literal(value), span: span)

    static fn named(name: text, span: Span) -> DimExpr:
        DimExpr(kind: DimExprKind.Named(name, nil, nil), span: span)

    static fn named_range(name: text, lo: i64, hi: i64, span: Span) -> DimExpr:
        DimExpr(kind: DimExprKind.Named(name, Some(lo), Some(hi)), span: span)

    static fn var(id: i64, span: Span) -> DimExpr:
        DimExpr(kind: DimExprKind.Var(id), span: span)

    static fn dynamic(span: Span) -> DimExpr:
        DimExpr(kind: DimExprKind.Dynamic, span: span)

    fn is_literal() -> bool:
        match self.kind:
            case Literal(_): true
            case _: false

    fn get_literal() -> i64?:
        match self.kind:
            case Literal(v): Some(v)
            case _: nil

"""Device type for tensors."""
enum DeviceType:
    CPU
    CUDA(id: i64)
    Vulkan(id: i64)

"""Memory space for GPU memory allocation."""
enum MemorySpace:
    Global      # Device global memory (accessible from host)
    Shared      # Workgroup shared memory (fast, limited size)
    Local       # Thread-local memory (registers/private)
    Constant    # Read-only constant memory (cached)
    Uniform     # Vulkan uniform buffer (read-only, broadcast)

struct LayerType:
    """Type for neural network layers with input/output shapes."""
    input_shape: [DimExpr]
    output_shape: [DimExpr]
    params: [ParamShape]
    device: DeviceType?

struct ParamShape:
    """Shape of a trainable parameter in a layer."""
    name: text
    shape: [DimExpr]
    trainable: bool

impl LayerType:
    static fn new(input: [DimExpr], output: [DimExpr]) -> LayerType:
        LayerType(
            input_shape: input,
            output_shape: output,
            params: [],
            device: nil
        )

    static fn with_device_of(layer: LayerType, device: DeviceType) -> LayerType:
        LayerType(
            input_shape: layer.input_shape,
            output_shape: layer.output_shape,
            params: layer.params,
            device: Some(device)
        )

struct Effect:
    """Effect annotation."""
    kind: EffectKind
    span: Span

"""Effect kind."""
enum EffectKind:
    Pure            # No side effects
    IO              # I/O operations
    Async           # Async operations
    Throws(type_: HirType)  # Can throw error
    Mutates         # Mutates state
    Allocates       # Heap allocation
    Custom(name: text)

# ============================================================================
# Exports
# ============================================================================

export HirModule, HirImport, HirImportItem, HirDomainBlock
export SymbolId, HirSymbol, SymbolKind, MethodResolution
export ScopeId, Scope, ScopeKind, SymbolTable
export HirType, HirTypeKind
export DimExpr, DimExprKind
export DeviceType, MemorySpace, LayerType, ParamShape
export Effect, EffectKind
# ============================================================================
