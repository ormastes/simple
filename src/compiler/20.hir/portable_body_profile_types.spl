# Portable Base embedded-body semantic types.  These are copied facts and
# bounded refusal data, never cache, pin, attempt, or publication authority.

use compiler.common.cache_contract.portable_object_ref_v1.{
    PortableObjectStageV1, PortablePortabilityV1
}

pub enum PortableEmbeddedBodyKindV1:
    ConcreteFunction
    MacroExpansion
    GenericBody
    TraitDefaultBody
    AroundAdvice

pub enum PortableBodyErrorV1:
    InvalidProfileIdentity
    UnsupportedBodyKind
    UnsupportedSemantics(detail: text)
    BoundsExceeded(detail: text)
    EncodeRefused
    DecodeRefused(detail: text)
    AuthorityUnavailable(detail: text)

pub class PortableBodyLimitsV1:
    max_body_objects: i64
    max_functions: i64
    max_symbols: i64
    max_scopes: i64
    max_exports: i64
    max_parameters: i64
    max_nodes: i64
    max_graph_nodes: i64
    max_dependency_edges: i64
    max_call_occurrences: i64
    max_call_chain_depth: i64
    max_semantic_depth: i64
    max_text_bytes: i64
    max_encoded_bytes: i64
    max_retained_bytes: i64
    max_work_units: i64

    pub static fn standard() -> PortableBodyLimitsV1:
        PortableBodyLimitsV1(max_body_objects: 1024, max_functions: 1024,
            max_symbols: 65536, max_scopes: 65536, max_exports: 1024,
            max_parameters: 65536, max_nodes: 65536, max_graph_nodes: 1024,
            max_dependency_edges: 65536, max_call_occurrences: 65536,
            max_call_chain_depth: 128, max_semantic_depth: 128,
            max_text_bytes: 8 * 1024 * 1024,
            max_encoded_bytes: 8 * 1024 * 1024,
            max_retained_bytes: 128 * 1024 * 1024,
            max_work_units: 1000000)

pub struct PortableBodyBudgetCountersV1:
    body_objects: i64
    functions: i64
    symbols: i64
    scopes: i64
    exports: i64
    parameters: i64
    nodes: i64
    graph_nodes: i64
    dependency_edges: i64
    call_occurrences: i64
    text_bytes: i64
    encoded_bytes: i64
    retained_bytes: i64
    work_units: i64

pub struct PortableBodyDependencyEdgeV1:
    caller_symbol_id: i64
    caller_name: text
    callee_symbol_id: i64
    callee_name: text

pub struct PortableBodyEntryFactV1:
    symbol_id: i64
    name: text
    signature_digest: text
    normalized_effect_digest: text

pub struct PortableBodyGraphFactsV1:
    dependency_edges: [PortableBodyDependencyEdgeV1]
    dependency_digest: text
    call_occurrences: i64
    longest_call_chain: i64

pub struct PortableBodySemanticFactsV1:
    rules_identity: text
    semantic_profile_digest: text
    module_name: text
    module_path: text
    exported_entries: [PortableBodyEntryFactV1]
    transitive_effect_digest: text
    graph: PortableBodyGraphFactsV1
    budget: PortableBodyBudgetCountersV1

pub struct PortableBodyDescriptorV1:
    object_kind: text
    object_schema: i64
    codec_identity: text
    verifier_identity: text
    rules_identity: text
    semantic_profile_digest: text
    stage: PortableObjectStageV1
    portability: PortablePortabilityV1
    target_contract_digest: text?
    raw_content_digest: text
    module_name: text
    module_path: text
    exported_entries: [PortableBodyEntryFactV1]
    transitive_effect_digest: text
    dependency_edges: [PortableBodyDependencyEdgeV1]
    dependency_digest: text
    call_occurrences: i64
    longest_call_chain: i64
    budget: PortableBodyBudgetCountersV1

pub fn portable_embedded_body_kind_available_v1(
    kind: PortableEmbeddedBodyKindV1,
) -> bool:
    match kind:
        case ConcreteFunction: true
        case MacroExpansion | GenericBody | TraitDefaultBody | AroundAdvice: false
