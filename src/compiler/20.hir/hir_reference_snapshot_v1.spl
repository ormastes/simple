# Exact owned compiler facts for the explicitly supported v1 envelope.
# This is not a stable-ID producer or rename transaction.
use compiler.common.diagnostics.span.{Span}
use compiler.frontend.parser_types.{ParserModule}
use compiler.frontend.parser_types_expr.{Type, TypeKind}
use compiler.frontend.core.lexer_struct.{core_reference_tokens_v1}
use compiler.hir.hir_types.{HirModule, HirImport, HirSymbol, SymbolTable, SymbolKind}
use compiler.hir.hir_definitions.{HirExpr, HirExprKind, HirStmt, HirStmtKind, HirBlock}
use compiler.hir.hir_reference_origins_v1.{HirReferenceOriginSinkV1}

struct HirReferenceTokenV1:
    codepoint_start: i64
    codepoint_end: i64
    byte_start: i64
    byte_end: i64
    line: i64
    column: i64
    kind: i64
    spelling: text

class HirReferenceSourceIndexV1:
    file: text
    revision_sha256: text
    source: text
    tokens: [HirReferenceTokenV1]
    token_by_start: Dict<i64, i64>

    static fn build(source: text, file: text, revision_sha256: text, max_tokens: i64) -> Result<HirReferenceSourceIndexV1, text>:
        if max_tokens <= 0:
            return Err("capacity: nonpositive token budget")
        # The lexer declaration owner scans and maps the original source once.
        # Only owned primitive receipts cross this boundary; no CoreLexer
        # value or source-character array crosses a per-token call here.
        val rows = core_reference_tokens_v1(source, max_tokens)?
        var index = HirReferenceSourceIndexV1(file: file,
            revision_sha256: revision_sha256, source: source, tokens: [], token_by_start: {})
        var previous_codepoint_end = -1
        var previous_byte_end = -1
        for row in rows:
            if (row.codepoint_start < 0 or row.codepoint_end <= row.codepoint_start or
                row.byte_start < 0 or row.byte_end <= row.byte_start or row.byte_end > source.len() or
                row.line < 1 or row.column < 1):
                return Err("invalid_span: lexer receipt has invalid original-source bounds")
            if (row.codepoint_start < previous_codepoint_end or row.byte_start < previous_byte_end or
                index.token_by_start.contains_key(row.codepoint_start)):
                return Err("invalid_span: overlapping original-source token starts")
            if row.spelling == "" or source[row.byte_start:row.byte_end] != row.spelling:
                return Err("invalid_span: lexer receipt disagrees with original bytes")
            if row.kind <= 0 or row.kind == 180 or row.kind == 181 or row.kind == 182 or row.kind == 190 or row.kind == 191:
                return Err("invalid_span: lexer receipt contains a synthetic or invalid token")
            index.token_by_start[row.codepoint_start] = index.tokens.len()
            index.tokens.push(HirReferenceTokenV1(codepoint_start: row.codepoint_start,
                codepoint_end: row.codepoint_end, byte_start: row.byte_start, byte_end: row.byte_end,
                line: row.line, column: row.column, kind: row.kind, spelling: row.spelling))
            previous_codepoint_end = row.codepoint_end
            previous_byte_end = row.byte_end
        Ok(index)

    fn token_at(codepoint_start: i64) -> Result<HirReferenceTokenV1, text>:
        if not self.token_by_start.contains_key(codepoint_start):
            return Err("invalid_span: no original token at exact parser offset")
        Ok(self.tokens[self.token_by_start[codepoint_start]])

    fn token_position(codepoint_start: i64) -> Result<i64, text>:
        if not self.token_by_start.contains_key(codepoint_start):
            return Err("invalid_span: no original token at exact parser offset")
        Ok(self.token_by_start[codepoint_start])

    fn require_token(position: i64, spelling: text, end: i64) -> Result<HirReferenceTokenV1, text>:
        if position < 0 or position >= self.tokens.len():
            return Err("invalid_span: grammar token absent from original source")
        val token = self.tokens[position]
        if token.codepoint_end > end or token.spelling != spelling:
            return Err("unsupported_syntax: original token grammar disagrees with parsed declaration")
        Ok(token)

struct HirReferenceDeclarationV1:
    module_ordinal: i64
    module_name: text
    declaration_ordinal: i64
    name: text
    origin_key: text
    token: HirReferenceTokenV1

struct HirResolvedReferenceV1:
    module_ordinal: i64
    local_symbol_id: i64
    origin_key: text
    role: text
    file: text
    revision_sha256: text
    byte_start: i64
    byte_end: i64
    spelling: text
    line: i64
    column: i64

struct HirReferenceModuleFactsV1:
    declarations: [HirReferenceDeclarationV1]
    references: [HirResolvedReferenceV1]
    visited_nodes: i64

fn reference_primitive_name_v1(name: text) -> bool:
    ["i8", "i16", "i32", "i64", "i128", "u8", "u16", "u32", "u64", "u128", "f32", "f64", "bool", "text", "char", "unit", "void"].contains(name)

fn reference_primitive_type_v1(type_: Type) -> Result<text, text>:
    match type_.kind:
        case TypeKind.Named(name, arguments):
            if arguments.len() == 0 and reference_primitive_name_v1(name):
                return Ok(name)
        case _: ()
    Err("unsupported_syntax: signature is not an explicit primitive type")

fn reference_terminal_key_v1(module_name: text, name: text) -> text:
    "{module_name.len()}:{module_name}{name.len()}:{name}"

fn hir_reference_declarations_v1(module: ParserModule, index: HirReferenceSourceIndexV1, module_ordinal: i64, module_name: text) -> Result<[HirReferenceDeclarationV1], text>:
    if module_ordinal < 0 or module_name == "":
        return Err("unresolved_origin: missing configured module identity")
    if (module.classes.len() != 0 or module.actors.len() != 0 or module.structs.len() != 0 or
        module.enums.len() != 0 or module.bitfields.len() != 0 or module.traits.len() != 0 or
        module.impls.len() != 0 or module.type_aliases.len() != 0 or module.constants.len() != 0 or
        module.static_asserts.len() != 0 or module.domain_blocks.len() != 0 or module.aop_advices.len() != 0 or
        module.di_bindings.len() != 0 or module.arch_rules.len() != 0 or module.mock_decls.len() != 0 or
        module.extend_enums.len() != 0 or module.exports.len() != 0 or module.tagged_layer != "" or
        module.layer_dag_edges != "" or module.nogc_strict):
        return Err("unsupported_syntax: module declaration outside primitive top-level envelope")
    if module.function_order.len() != module.functions.len():
        return Err("unresolved_origin: declaration order does not cover parsed functions")
    var declarations: [HirReferenceDeclarationV1] = []
    var seen: Dict<text, bool> = {}
    var range_ends: Dict<i64, i64> = {}
    var function_starts: Dict<i64, bool> = {}
    var ordinal = 0
    for name in module.function_order:
        if seen.contains_key(name) or not module.functions.contains_key(name):
            return Err("unresolved_origin: duplicate or missing parsed function ordinal")
        seen[name] = true
        val function_ = module.functions[name]
        if (function_.name != name or function_.type_params.len() != 0 or function_.is_async or
            function_.is_static or function_.is_method or function_.is_mutable or function_.is_const or
            function_.is_kernel or function_.is_extern or function_.attributes.len() != 0 or
            function_.contract.preconditions.len() != 0 or function_.contract.invariants.len() != 0 or
            function_.contract.postconditions.len() != 0 or function_.contract.error_postconditions.len() != 0 or
            function_.contract.decrease_measure != nil or function_.contract.proof_uses != ""):
            return Err("unsupported_syntax: function declaration outside primitive envelope")
        val span = function_.span
        if span.start < 0 or span.end <= span.start or span.line < 1:
            return Err("invalid_span: function declaration has synthetic provenance")
        if range_ends.contains_key(span.start):
            return Err("invalid_span: duplicate top-level declaration boundary")
        range_ends[span.start] = span.end
        function_starts[span.start] = true
        var position = index.token_position(span.start)?
        index.require_token(position, "fn", span.end)?
        position = position + 1
        val name_token = index.require_token(position, name, span.end)?
        if name_token.kind != 6:
            return Err("unsupported_syntax: function declaration name is not an identifier")
        position = position + 1
        index.require_token(position, "(", span.end)?
        position = position + 1
        var param_position = 0
        for param in function_.params:
            if param_position > 0:
                index.require_token(position, ",", span.end)?
                position = position + 1
            if not param.has_type_ or param.has_default or param.is_mutable:
                return Err("unsupported_syntax: parameter is not explicit primitive scalar")
            index.require_token(position, param.name, span.end)?
            index.require_token(position + 1, ":", span.end)?
            index.require_token(position + 2, reference_primitive_type_v1(param.type_)?, span.end)?
            position = position + 3
            param_position = param_position + 1
        index.require_token(position, ")", span.end)?
        if not function_.has_return_type:
            return Err("unsupported_syntax: function needs an explicit primitive return type")
        index.require_token(position + 1, "->", span.end)?
        index.require_token(position + 2, reference_primitive_type_v1(function_.return_type)?, span.end)?
        index.require_token(position + 3, ":", span.end)?
        declarations.push(HirReferenceDeclarationV1(module_ordinal: module_ordinal,
            module_name: module_name, declaration_ordinal: ordinal, name: name,
            origin_key: "{module_name.len()}:{module_name}:{ordinal}", token: name_token))
        ordinal = ordinal + 1
    for import_ in module.imports:
        val span = import_.span
        if span.start < 0 or span.end <= span.start or span.line < 1:
            return Err("invalid_span: import declaration has synthetic provenance")
        val first_token = index.token_at(span.start)?
        if first_token.spelling != "use" or first_token.kind != 27:
            return Err("invalid_span: parsed import does not begin at its original use token")
        if range_ends.contains_key(span.start):
            return Err("invalid_span: duplicate top-level declaration boundary")
        range_ends[span.start] = span.end
    # A composed frontend can consume metadata into a sidechannel while
    # leaving ParserFunction.attributes empty. Account for every original
    # significant token using only actual parsed declaration provenance.
    # Tokens are already in lexer order: one pass, no declaration-per-token
    # scan or source-name search. Any nested/overlapping parsed range refuses.
    var covered_until = -1
    var covered_ranges = 0
    var token_position = 0
    while token_position < index.tokens.len():
        val token = index.tokens[token_position]
        if token.codepoint_start < covered_until:
            if range_ends.contains_key(token.codepoint_start):
                return Err("invalid_span: overlapping top-level declaration provenance")
            if token.codepoint_end > covered_until:
                return Err("invalid_span: original token crosses a declaration boundary")
        elif range_ends.contains_key(token.codepoint_start):
            covered_until = range_ends[token.codepoint_start]
            if token.codepoint_end > covered_until:
                return Err("invalid_span: original token crosses a declaration boundary")
            covered_ranges = covered_ranges + 1
        else:
            # parse_fn_decl's genuine span begins at fn, after visibility.
            # Admit one same-line pub immediately preceding that actual fn;
            # all other prefixes, decorations and uncovered tokens refuse.
            if token.spelling != "pub" or token.kind != 29 or token_position + 1 >= index.tokens.len():
                return Err("unsupported_syntax: original token outside admitted top-level declaration ranges")
            val following = index.tokens[token_position + 1]
            if (following.line != token.line or following.spelling != "fn" or following.kind != 20 or
                not function_starts.contains_key(following.codepoint_start)):
                return Err("unsupported_syntax: visibility token lacks an immediate same-line admitted function")
        token_position = token_position + 1
    if covered_ranges != range_ends.len():
        return Err("invalid_span: parsed declaration boundary lacks original token coverage")
    Ok(declarations)

enum HirReferenceWalkItemV1:
    Expression(value: HirExpr, role: text)
    Statement(value: HirStmt)
    Body(value: HirBlock)

class HirReferenceCollectorV1:
    max_nodes: i64
    max_references: i64
    visited_nodes: i64
    references: [HirResolvedReferenceV1]
    symbol_origins: Dict<i64, HirReferenceDeclarationV1>
    symbol_spellings: Dict<i64, text>
    symbol_aliases: Dict<i64, bool>
    terminal_declarations: Dict<text, HirReferenceDeclarationV1>
    seen_facts: Dict<text, i64>
    worklist: [HirReferenceWalkItemV1]
    symbols: SymbolTable?
    source_index: HirReferenceSourceIndexV1?
    declarations_prepared: bool

    static fn new(max_nodes: i64, max_references: i64) -> HirReferenceCollectorV1:
        HirReferenceCollectorV1(max_nodes: max_nodes, max_references: max_references,
            visited_nodes: 0, references: [], symbol_origins: {}, symbol_spellings: {},
            symbol_aliases: {}, terminal_declarations: {}, seen_facts: {}, worklist: [],
            symbols: nil, source_index: nil, declarations_prepared: false)

    fn source_token_at(codepoint_start: i64) -> Result<HirReferenceTokenV1, text>:
        if self.source_index == nil:
            return Err("invalid_span: no active original-source index")
        self.source_index.?.token_at(codepoint_start)

    fn symbol_at(raw_id: i64) -> Result<HirSymbol, text>:
        if self.symbols == nil or raw_id < 0:
            return Err("unresolved_origin: no active module symbol owner")
        if not self.symbols.?.symbols.contains_key(raw_id):
            return Err("unresolved_origin: HIR reference has no actual module SymbolId")
        val symbol: HirSymbol = self.symbols.?.symbols[raw_id]
        if symbol.id.id != raw_id:
            return Err("unresolved_origin: symbol table identity mismatch")
        Ok(symbol)

    me prepare_declarations(all_declarations: [HirReferenceDeclarationV1]) -> Result<bool, text>:
        if self.declarations_prepared:
            return Err("unresolved_origin: declaration inventory already prepared for this request")
        for declaration in all_declarations:
            val key = reference_terminal_key_v1(declaration.module_name, declaration.name)
            if self.terminal_declarations.contains_key(key):
                return Err("unresolved_origin: duplicate terminal declaration identity")
            if (declaration.module_ordinal < 0 or declaration.declaration_ordinal < 0 or
                declaration.module_name == "" or declaration.name == "" or
                declaration.origin_key != "{declaration.module_name.len()}:{declaration.module_name}:{declaration.declaration_ordinal}"):
                return Err("unresolved_origin: invalid terminal declaration identity")
            self.terminal_declarations[key] = declaration
        self.declarations_prepared = true
        Ok(true)

    me push(item: HirReferenceWalkItemV1) -> Result<bool, text>:
        # Include pending nodes: a broad body cannot allocate an unbounded
        # worklist before the first node is visited.
        if self.visited_nodes + self.worklist.len() >= self.max_nodes:
            return Err("capacity: HIR node budget exhausted")
        self.worklist.push(item)
        Ok(true)

    me emit(module_ordinal: i64, symbol: i64, declaration: HirReferenceDeclarationV1, role: text, token: HirReferenceTokenV1) -> Result<bool, text>:
        if self.source_index == nil:
            return Err("invalid_span: no active original-source index")
        if token.byte_start < 0 or token.byte_end <= token.byte_start or token.byte_end > self.source_index.?.source.len():
            return Err("invalid_span: reference token outside original source")
        if self.source_index.?.source[token.byte_start:token.byte_end] != token.spelling:
            return Err("invalid_span: reference token no longer matches original bytes")
        val key = "{token.byte_start}:{token.byte_end}:{role}"
        if self.seen_facts.contains_key(key):
            val previous = self.references[self.seen_facts[key]]
            if previous.origin_key != declaration.origin_key or previous.local_symbol_id != symbol:
                return Err("unresolved_origin: incompatible facts for the same original token")
            return Ok(true)
        if self.references.len() >= self.max_references:
            return Err("capacity: reference budget exhausted")
        self.seen_facts[key] = self.references.len()
        self.references.push(HirResolvedReferenceV1(module_ordinal: module_ordinal,
            local_symbol_id: symbol, origin_key: declaration.origin_key, role: role,
            file: self.source_index.?.file, revision_sha256: self.source_index.?.revision_sha256,
            byte_start: token.byte_start, byte_end: token.byte_end,
            spelling: token.spelling, line: token.line, column: token.column))
        Ok(true)

    me bind_imports(imports: [HirImport], module_ordinal: i64, origins: HirReferenceOriginSinkV1) -> Result<bool, text>:
        # One scalar provenance lookup per imported item, never a table copy
        # per reference. Binding includes its actual original import span.
        var events: Dict<text, i64> = {}
        for raw_id in origins.rows.keys():
            val event = origins.rows[raw_id]
            if event.module_ordinal != module_ordinal:
                return Err("unresolved_origin: imported event belongs to another module/symbol table")
            val symbol = self.symbol_at(raw_id)?
            if symbol.id.id != raw_id or symbol.kind != SymbolKind.Function:
                return Err("unresolved_origin: imported event is not a real callable SymbolId")
            val key = "{event.import_span.start}:{event.import_span.end}:{event.local_alias.len()}:{event.local_alias}"
            if events.contains_key(key):
                return Err("unresolved_origin: competing import events for one source item")
            events[key] = raw_id
        var admitted: Dict<i64, bool> = {}
        for import_ in imports:
            if import_.is_lazy or import_.items.len() == 0:
                return Err("unsupported_syntax: only eager explicit named imports are admitted")
            val span = import_.span
            if span.start < 0 or span.end <= span.start or span.line < 1:
                return Err("invalid_span: import declaration has synthetic provenance")
            var position = self.source_index.?.token_position(span.start)?
            self.source_index.?.require_token(position, "use", span.end)?
            position = position + 1
            # Only absolute identifier paths and an explicit import list.
            var path = ""
            while position < self.source_index.?.tokens.len():
                val segment = self.source_index.?.tokens[position]
                if segment.kind != 6 or segment.codepoint_end > span.end:
                    return Err("unsupported_syntax: import module path is not an absolute identifier path")
                path = path + segment.spelling
                position = position + 1
                self.source_index.?.require_token(position, ".", span.end)?
                position = position + 1
                if position >= self.source_index.?.tokens.len():
                    return Err("invalid_span: incomplete import token provenance")
                if self.source_index.?.tokens[position].spelling == "\{" or self.source_index.?.tokens[position].spelling == "(":
                    break
                path = path + "."
            if path != import_.module_path:
                return Err("unsupported_syntax: import path disagrees with parsed module path")
            if position >= self.source_index.?.tokens.len():
                return Err("invalid_span: missing import list delimiter")
            val opener = self.source_index.?.tokens[position].spelling
            val closer = if opener == "\{": "\}" else: ")"
            self.source_index.?.require_token(position, opener, span.end)?
            position = position + 1
            var item_position = 0
            for item in import_.items:
                if item_position > 0:
                    self.source_index.?.require_token(position, ",", span.end)?
                    position = position + 1
                val source_token = self.source_index.?.require_token(position, item.name, span.end)?
                if source_token.kind != 6:
                    return Err("unsupported_syntax: imported name is not a scalar identifier")
                position = position + 1
                var local_alias = item.name
                var alias_token = source_token
                var has_alias = false
                if val alias = item.alias:
                    has_alias = true
                    local_alias = alias
                    self.source_index.?.require_token(position, "as", span.end)?
                    alias_token = self.source_index.?.require_token(position + 1, alias, span.end)?
                    if alias_token.kind != 6:
                        return Err("unsupported_syntax: local import alias is not an identifier")
                    position = position + 2
                val event_key = "{span.start}:{span.end}:{local_alias.len()}:{local_alias}"
                if not events.contains_key(event_key):
                    return Err("unresolved_origin: parsed import has no successful callable registration event")
                val raw_id = events[event_key]
                val event = origins.rows[raw_id]
                val terminal_key = reference_terminal_key_v1(event.terminal_module, event.terminal_name)
                if not self.terminal_declarations.contains_key(terminal_key):
                    return Err("unresolved_origin: terminal imported declaration absent from admitted inventory")
                # Direct imports are admitted here. Re-export syntax is an
                # explicit refusal in declaration admission, never guessed.
                if event.terminal_module != path or event.terminal_name != item.name:
                    return Err("unsupported_syntax: imported terminal needs unsupported reexport provenance")
                val declaration = self.terminal_declarations[terminal_key]
                if self.symbol_origins.contains_key(raw_id):
                    return Err("unresolved_origin: imported and local declaration SymbolIds conflict")
                self.symbol_origins[raw_id] = declaration
                self.symbol_spellings[raw_id] = local_alias
                self.symbol_aliases[raw_id] = has_alias
                admitted[raw_id] = true
                self.emit(module_ordinal, raw_id, declaration, "import-source", source_token)?
                if has_alias:
                    self.emit(module_ordinal, raw_id, declaration, "alias-declaration", alias_token)?
                item_position = item_position + 1
            val closing_token = self.source_index.?.require_token(position, closer, span.end)?
            if closing_token.codepoint_end != span.end:
                return Err("invalid_span: import boundary does not end at its consumed closing token")
            if position + 1 < self.source_index.?.tokens.len() and self.source_index.?.tokens[position + 1].codepoint_start < span.end:
                return Err("unsupported_syntax: unconsumed token within parsed import boundary")
        if admitted.len() != origins.rows.len():
            return Err("unresolved_origin: imported callable event lacks an admitted source import")
        Ok(true)

    me reference_use(module_ordinal: i64, raw_id: i64, span: Span, role: text) -> Result<bool, text>:
        val symbol = self.symbol_at(raw_id)?
        if span.start < 0 or span.end <= span.start or span.line < 1:
            return Err("invalid_span: HIR variable use has synthetic source provenance")
        val token = self.source_token_at(span.start)?
        if token.kind != 6 or token.codepoint_end != span.end:
            return Err("invalid_span: HIR variable range is not exactly one original identifier")
        if self.symbol_origins.contains_key(raw_id):
            if token.spelling != self.symbol_spellings[raw_id]:
                return Err("invalid_span: HIR resolved binding and original source token disagree")
            val actual_role = if self.symbol_aliases[raw_id]: "alias-use" else: role
            return self.emit(module_ordinal, raw_id, self.symbol_origins[raw_id], actual_role, token)
        if role == "call":
            return Err("unsupported_syntax: dynamic or unsupported callable binding")
        if symbol.kind != SymbolKind.Variable and symbol.kind != SymbolKind.Parameter:
            return Err("unresolved_origin: nonlocal HIR binding lacks declaration provenance")
        if token.spelling != symbol.name:
            return Err("invalid_span: local value binding disagrees with original token")
        Ok(true)

    me collect(module: HirModule, index: HirReferenceSourceIndexV1, module_ordinal: i64, module_name: text, declarations: [HirReferenceDeclarationV1], origins: HirReferenceOriginSinkV1) -> Result<HirReferenceModuleFactsV1, text>:
        self.visited_nodes = 0
        self.references = []
        self.symbol_origins = {}
        self.symbol_spellings = {}
        self.symbol_aliases = {}
        self.seen_facts = {}
        self.worklist = []
        self.symbols = module.symbols
        self.source_index = index
        if self.max_nodes <= 0 or self.max_references <= 0:
            return Err("capacity: nonpositive HIR resource budget")
        # The request-wide index is prepared once by the driver. Neither its
        # complete inventory nor the source index crosses per-reference calls.
        if not self.declarations_prepared:
            return Err("unresolved_origin: declaration inventory has not been prepared")
        if not origins.enabled or origins.module_ordinal != module_ordinal:
            return Err("unresolved_origin: collector needs this module's enabled provenance sink")
        if origins.invalid_reason != "":
            return Err(origins.invalid_reason)
        if (module.classes.len() != 0 or module.structs.len() != 0 or module.enums.len() != 0 or
            module.bitfields.len() != 0 or module.traits.len() != 0 or module.impls.len() != 0 or
            module.constants.len() != 0 or module.static_asserts.len() != 0 or module.domain_blocks.len() != 0 or
            module.aop_advices.len() != 0 or module.di_bindings.len() != 0 or module.arch_rules.len() != 0 or
            module.mock_decls.len() != 0 or module.extend_enums.len() != 0):
            return Err("unsupported_syntax: HIR module outside admitted top-level envelope")
        var declaration_tokens: Dict<i64, HirReferenceDeclarationV1> = {}
        for declaration in declarations:
            if declaration.module_ordinal != module_ordinal or declaration.module_name != module_name:
                return Err("unresolved_origin: declarations do not belong to configured module")
            if declaration_tokens.contains_key(declaration.token.codepoint_start):
                return Err("unresolved_origin: duplicate local declaration provenance")
            declaration_tokens[declaration.token.codepoint_start] = declaration
        if module.functions.len() != declarations.len():
            return Err("unresolved_origin: lowered functions do not exactly cover parsed declarations")
        for symbol_id in module.functions.keys():
            val function_ = module.functions[symbol_id]
            if (function_.symbol.id != symbol_id.id or function_.is_method or function_.is_extern or
                function_.is_async or function_.is_const or function_.is_static or function_.is_mutable or
                function_.is_gpu_kernel or function_.is_generic_template or function_.type_params.len() != 0 or
                function_.verification_contract != nil):
                return Err("unsupported_syntax: lowered function outside primitive envelope")
            val symbol = self.symbol_at(symbol_id.id)?
            # Ordinary preregistration currently uses Span.empty() on the
            # symbol row. HirFunction.symbol and its real declaration span
            # are authoritative; never synthesize a token from that empty row.
            if symbol.id.id != symbol_id.id or symbol.kind != SymbolKind.Function:
                return Err("unresolved_origin: actual declaration symbol provenance disagrees")
            val position = index.token_position(function_.span.start)?
            index.require_token(position, "fn", function_.span.end)?
            val token = index.require_token(position + 1, function_.name, function_.span.end)?
            if not declaration_tokens.contains_key(token.codepoint_start):
                return Err("unresolved_origin: real function has no exact parsed declaration token")
            val declaration = declaration_tokens[token.codepoint_start]
            if declaration.name != function_.name or self.symbol_origins.contains_key(symbol_id.id):
                return Err("unresolved_origin: conflicting local callable identity")
            self.symbol_origins[symbol_id.id] = declaration
            self.symbol_spellings[symbol_id.id] = declaration.name
            self.symbol_aliases[symbol_id.id] = false
            self.emit(module_ordinal, symbol_id.id, declaration, "declaration", token)?
            for parameter in function_.params:
                if parameter.has_default:
                    return Err("unsupported_syntax: lowered default parameter")
                self.symbol_at(parameter.symbol.id)?
            self.push(HirReferenceWalkItemV1.Body(function_.body))?
        self.bind_imports(module.imports, module_ordinal, origins)?
        while self.worklist.len() > 0:
            val item = self.worklist[self.worklist.len() - 1]
            self.worklist.pop()
            self.visited_nodes = self.visited_nodes + 1
            match item:
                case HirReferenceWalkItemV1.Body(block):
                    if block.unsafe_caps.len() != 0:
                        return Err("unsupported_syntax: unsafe capability block")
                    if block.has:
                        self.push(HirReferenceWalkItemV1.Expression(block.value, "value-use"))?
                    for statement in block.stmts:
                        self.push(HirReferenceWalkItemV1.Statement(statement))?
                case HirReferenceWalkItemV1.Statement(statement):
                    match statement.kind:
                        case HirStmtKind.Expr(expression):
                            self.push(HirReferenceWalkItemV1.Expression(expression, "value-use"))?
                        case HirStmtKind.Let(symbol, _, init):
                            val binding = self.symbol_at(symbol.id)?
                            if binding.kind != SymbolKind.Variable:
                                return Err("unsupported_syntax: non-scalar local binding")
                            self.push(HirReferenceWalkItemV1.Expression(init, "value-use"))?
                        case HirStmtKind.Assign(target, _, value):
                            match target.kind:
                                case HirExprKind.Var(symbol) | HirExprKind.NamedVar(symbol, _):
                                    val binding = self.symbol_at(symbol.id)?
                                    if binding.kind != SymbolKind.Variable:
                                        return Err("unsupported_syntax: assignment target is not a local scalar value")
                                case _: return Err("unsupported_syntax: non-scalar assignment target")
                            self.push(HirReferenceWalkItemV1.Expression(target, "value-use"))?
                            self.push(HirReferenceWalkItemV1.Expression(value, "value-use"))?
                        case HirStmtKind.Block(block):
                            self.push(HirReferenceWalkItemV1.Body(block))?
                        case _: return Err("unsupported_syntax: unsupported HIR statement")
                case HirReferenceWalkItemV1.Expression(expression, role):
                    match expression.kind:
                        case HirExprKind.IntLit(_, _) | HirExprKind.FloatLit(_, _) | HirExprKind.FloatLexeme(_, _): ()
                        case HirExprKind.BoolLit(_) | HirExprKind.CharLit(_) | HirExprKind.UnitLit | HirExprKind.NilLit: ()
                        case HirExprKind.StringLit(_, interpolations):
                            if val values = interpolations:
                                if values.len() != 0:
                                    return Err("unsupported_syntax: interpolated string reference provenance")
                        case HirExprKind.Var(symbol) | HirExprKind.NamedVar(symbol, _):
                            self.reference_use(module_ordinal, symbol.id, expression.span, role)?
                        case HirExprKind.Call(callee, arguments, type_arguments):
                            if type_arguments.len() != 0:
                                return Err("unsupported_syntax: generic call")
                            match callee.kind:
                                case HirExprKind.Var(_) | HirExprKind.NamedVar(_, _): ()
                                case _: return Err("unsupported_syntax: callee is not a directly resolved callable")
                            self.push(HirReferenceWalkItemV1.Expression(callee, "call"))?
                            for argument in arguments:
                                if argument.has_name:
                                    return Err("unsupported_syntax: named call arguments")
                                self.push(HirReferenceWalkItemV1.Expression(argument.value, "value-use"))?
                        case HirExprKind.Binary(_, left, right):
                            self.push(HirReferenceWalkItemV1.Expression(left, "value-use"))?
                            self.push(HirReferenceWalkItemV1.Expression(right, "value-use"))?
                        case HirExprKind.Unary(_, operand):
                            self.push(HirReferenceWalkItemV1.Expression(operand, "value-use"))?
                        case HirExprKind.Return(value):
                            if val returned = value:
                                self.push(HirReferenceWalkItemV1.Expression(returned, "value-use"))?
                        case HirExprKind.Block(block):
                            self.push(HirReferenceWalkItemV1.Body(block))?
                        case HirExprKind.If(condition, then_, else_):
                            self.push(HirReferenceWalkItemV1.Expression(condition, "value-use"))?
                            self.push(HirReferenceWalkItemV1.Body(then_))?
                            if val alternative = else_:
                                self.push(HirReferenceWalkItemV1.Body(alternative))?
                        case HirExprKind.IfChain(arms, else_):
                            for arm in arms:
                                self.push(HirReferenceWalkItemV1.Expression(arm.cond, "value-use"))?
                                self.push(HirReferenceWalkItemV1.Body(arm.then_))?
                            if val alternative = else_:
                                self.push(HirReferenceWalkItemV1.Body(alternative))?
                        case _: return Err("unsupported_syntax: unsupported HIR expression")
        self.symbols = nil
        self.source_index = nil
        Ok(HirReferenceModuleFactsV1(declarations: declarations,
            references: self.references, visited_nodes: self.visited_nodes))
