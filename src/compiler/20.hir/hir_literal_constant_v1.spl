# Stateless literal constant subset shared by HIR declaration checks and MIR.
# Mechanically extracted from MirLowering.lower_const_expr; no symbol/module lookup.
use compiler.hir.hir_definitions.{HirExpr, HirExprKind, HirUnaryOp}

enum HirLiteralConstantV1:
    Int(value: i64)
    Float(value: f64)
    FloatLexeme(value: text)
    Bool(value: bool)
    Str(value: text)

fn hir_fold_literal_constant_v1(expr: HirExpr) -> HirLiteralConstantV1?:
    """Fold MIR's literal-only subset, preserving noninteger kinds and lexemes.

    Unavailable expressions return nil. This is not the general ConstEvaluator:
    no variables, calls, casts, comparisons or module context are admitted.
    Existing arithmetic overflow and invalid shift behavior is unchanged."""
    match expr.kind:
        case IntLit(value, _):
            Some(HirLiteralConstantV1.Int(value))
        case FloatLit(value, _):
            Some(HirLiteralConstantV1.Float(value))
        case FloatLexeme(value, _):
            Some(HirLiteralConstantV1.FloatLexeme(value))
        case BoolLit(value):
            Some(HirLiteralConstantV1.Bool(value))
        case StringLit(value, interps):
            if val parts = interps:
                if parts.len() > 0:
                    return nil
            Some(HirLiteralConstantV1.Str(value))
        case Binary(bin_op, bin_left, bin_right):
            # Preserve operand evaluation order and the integer-only operator set.
            val fold_l = hir_fold_literal_constant_v1(bin_left)
            val fold_r = hir_fold_literal_constant_v1(bin_right)
            if fold_l == nil or fold_r == nil:
                return nil
            var li: i64 = 0
            var ri: i64 = 0
            var fold_ints = true
            match fold_l.unwrap():
                case Int(lv): li = lv
                case _: fold_ints = false
            match fold_r.unwrap():
                case Int(rv): ri = rv
                case _: fold_ints = false
            if not fold_ints:
                return nil
            match bin_op:
                case Add: Some(HirLiteralConstantV1.Int(li + ri))
                case Sub: Some(HirLiteralConstantV1.Int(li - ri))
                case Mul: Some(HirLiteralConstantV1.Int(li * ri))
                case Div:
                    if ri == 0: return nil
                    Some(HirLiteralConstantV1.Int(li / ri))
                case Mod:
                    if ri == 0: return nil
                    Some(HirLiteralConstantV1.Int(li % ri))
                case Shl: Some(HirLiteralConstantV1.Int(li << ri))
                case Shr: Some(HirLiteralConstantV1.Int(li >> ri))
                case BitAnd: Some(HirLiteralConstantV1.Int(li & ri))
                case BitOr: Some(HirLiteralConstantV1.Int(li | ri))
                case BitXor: Some(HirLiteralConstantV1.Int(li ^ ri))
                case _: nil
        case Unary(un_op, un_operand):
            val un_operand_t: HirExpr = un_operand
            val folded_operand = hir_fold_literal_constant_v1(un_operand_t)
            if val inner = folded_operand:
                match un_op:
                    case HirUnaryOp.Neg:
                        match inner:
                            case Int(iv): Some(HirLiteralConstantV1.Int(0 - iv))
                            # Real negation retains the sign bit of zero.
                            case Float(fv):
                                val negated: f64 = -fv
                                Some(HirLiteralConstantV1.Float(negated))
                            case FloatLexeme(lexeme):
                                Some(HirLiteralConstantV1.FloatLexeme(hir_negate_float_lexeme_v1(lexeme)))
                            case _: nil
                    case HirUnaryOp.BitNot:
                        match inner:
                            case Int(iv): Some(HirLiteralConstantV1.Int(~iv))
                            case _: nil
                    case _: nil
            else:
                nil
        case _:
            nil

fn hir_negate_float_lexeme_v1(lexeme: text) -> text:
    """Textual negation: toggle one leading sign without parsing the number."""
    if lexeme.starts_with("-"):
        return lexeme.substring(1)
    if lexeme.starts_with("+"):
        return "-" + lexeme.substring(1)
    "-" + lexeme

export HirLiteralConstantV1, hir_fold_literal_constant_v1
