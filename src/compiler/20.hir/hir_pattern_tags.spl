# Stable scalar discriminants for HirPatternKind.
#
# Runtime enums use Rust DefaultHasher over the variant name, truncated to
# u32 (src/compiler_rust/runtime/src/value/objects.rs).  Keep these typed i64
# constants in one owner so staged lowering can classify a retained pattern
# without allocating probe payloads or projecting a nested aggregate first.
use compiler.hir.hir_definitions.{HirPatternKind}

extern fn rt_enum_discriminant(value: HirPatternKind) -> i64

const HIR_PATTERN_WILDCARD_TAG: i64 = 3721716106
const HIR_PATTERN_LITERAL_TAG: i64 = 558957156
const HIR_PATTERN_BINDING_TAG: i64 = 1662985507
const HIR_PATTERN_TUPLE_TAG: i64 = 4090216459
const HIR_PATTERN_ARRAY_TAG: i64 = 1984125491
const HIR_PATTERN_STRUCT_TAG: i64 = 1218483285
const HIR_PATTERN_ENUM_TAG: i64 = 1346025362
const HIR_PATTERN_OR_TAG: i64 = 4240457139
const HIR_PATTERN_RANGE_TAG: i64 = 829654643
const HIR_PATTERN_ERROR_TAG: i64 = 2735847868
const HIR_PATTERN_COMPLETE_REGION_TAG: i64 = 2835747446
const HIR_PATTERN_DYN_REGION_TAG: i64 = 1895825722
const HIR_PATTERN_TYPE_TEST_TAG: i64 = 2646178886

fn hir_pattern_kind_tag(kind: HirPatternKind) -> i64:
    """Read only the runtime enum header; do not inspect or allocate payload."""
    rt_enum_discriminant(kind)

export HIR_PATTERN_WILDCARD_TAG, HIR_PATTERN_LITERAL_TAG, HIR_PATTERN_BINDING_TAG
export HIR_PATTERN_TUPLE_TAG, HIR_PATTERN_ARRAY_TAG, HIR_PATTERN_STRUCT_TAG
export HIR_PATTERN_ENUM_TAG, HIR_PATTERN_OR_TAG, HIR_PATTERN_RANGE_TAG
export HIR_PATTERN_ERROR_TAG, HIR_PATTERN_COMPLETE_REGION_TAG
export HIR_PATTERN_DYN_REGION_TAG, HIR_PATTERN_TYPE_TEST_TAG
export hir_pattern_kind_tag
