# Preserve aggregate function payloads while ordering scalar identities.
use compiler.hir.hir_definitions.{HirFunction}
use compiler.hir.hir_types.{SymbolId}

pub fn hir_function_symbol_order(functions: [HirFunction]) -> [i64]:
    """Indices of original function values in stable ascending SymbolId order.

    Native dictionaries can compare aggregate keys by identity. Sorting copied
    SymbolId keys and re-indexing the dictionary can lose the function body.
    This follows monomorphization's scalar-index ordering without copying keys.
    """
    var indices: [i64] = []
    var symbol_ids: [i64] = []
    var function_index = 0
    while function_index < functions.len():
        val function: HirFunction = functions[function_index]
        val symbol: SymbolId = function.symbol
        indices = indices.push(function_index)
        symbol_ids = symbol_ids.push(symbol.id)
        function_index = function_index + 1
    var i = 1
    while i < indices.len():
        val current: i64 = indices[i]
        var j = i - 1
        while j >= 0:
            val previous: i64 = indices[j]
            if symbol_ids[previous] <= symbol_ids[current]:
                break
            indices[j + 1] = previous
            j = j - 1
        indices[j + 1] = current
        i = i + 1
    indices
