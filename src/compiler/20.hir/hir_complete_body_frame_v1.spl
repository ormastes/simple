# Shared complete-body byte grammar. Scalar parent/stage labels are mechanical
# identities only; typed callers must admit the original and transformed owner.
# Encoding and decoding are borrowed scratch, with no lifecycle or promotion.
use compiler.hir.hir_codec_support.{HirCodecWriter}
use compiler.frontend.core.flat_pool_codec.{FlatPoolReader}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}

struct HirCompleteBodyFrameIdentityV1:
    stage: text
    module_name: text
    source_path: text
    original_archive_key: text
    original_body_digest: text
    original_warnings_digest: text
    boundary_key: text
    boundary_digest: text

struct HirCompleteBodyFramePayloadV1:
    blob: text
    warnings: [text]

fn hir_complete_body_frame_encode_v1(identity: HirCompleteBodyFrameIdentityV1,
        blob: text, warnings: [text]) -> text:
    if transient_array_scope_state_v1() != 1: return ""
    var writer = HirCodecWriter.create()
    writer.put_text(identity.stage)
    writer.put_text(identity.module_name)
    writer.put_text(identity.source_path)
    writer.put_text(identity.original_archive_key)
    writer.put_text(identity.original_body_digest)
    writer.put_text(identity.original_warnings_digest)
    writer.put_text(identity.boundary_key)
    writer.put_text(identity.boundary_digest)
    writer.put_text(blob)
    writer.put_i64(warnings.len())
    for warning in warnings: writer.put_text(warning)
    if not writer.ok: return ""
    writer.finish()

fn hir_complete_body_frame_key_v1(identity: HirCompleteBodyFrameIdentityV1,
        frame: text, domain: text) -> text:
    if transient_array_scope_state_v1() != 1: return ""
    sha256_text(domain + "\n" + sha256_text(frame) + "\n" +
        identity.original_archive_key + "\n" + identity.boundary_key + "\n" + identity.boundary_digest)

# Failure codes let each strict typed caller preserve its existing diagnostics.
fn hir_complete_body_frame_decode_v1(frame: text, identity: HirCompleteBodyFrameIdentityV1
) -> Result<HirCompleteBodyFramePayloadV1, text>:
    if transient_array_scope_state_v1() != 1: return Err("scope")
    var reader = FlatPoolReader.new(frame)
    if reader.decode_text(reader.next()) != identity.stage or
            reader.decode_text(reader.next()) != identity.module_name or
            reader.decode_text(reader.next()) != identity.source_path or
            reader.decode_text(reader.next()) != identity.original_archive_key or
            reader.decode_text(reader.next()) != identity.original_body_digest or
            reader.decode_text(reader.next()) != identity.original_warnings_digest or
            reader.decode_text(reader.next()) != identity.boundary_key or
            reader.decode_text(reader.next()) != identity.boundary_digest:
        return Err("parent")
    val blob = reader.decode_text(reader.next())
    val count = reader.next_len()
    if count > reader.lines.len() - reader.pos: return Err("count")
    var warnings: [text] = []
    var index = 0
    while index < count and reader.ok:
        warnings = warnings.push(reader.decode_text(reader.next()))
        index = index + 1
    if not reader.ok or reader.pos != reader.lines.len() - 1: return Err("exhaustion")
    if reader.lines[reader.pos] != "" or hir_complete_body_frame_encode_v1(identity, blob, warnings) != frame:
        return Err("stable")
    Ok(HirCompleteBodyFramePayloadV1(blob: blob, warnings: warnings))

export HirCompleteBodyFrameIdentityV1, HirCompleteBodyFramePayloadV1
export hir_complete_body_frame_encode_v1, hir_complete_body_frame_key_v1, hir_complete_body_frame_decode_v1
