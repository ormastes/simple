# Fold-style HIR visitor (hardening plan §11.5; lanes C3/C4).
#
# walk_hir_<kind>(node, ctx, f) -> ctx threads `ctx` through every node in
# the subtree, calling `f(node, ctx)` on entry. There is one explicit match
# arm per registry variant, each setting `handled`; the trailing `case _`
# leaves it false and the post-match check raises E-HIR-VISIT-UNHANDLED.
# That flag is the ONLY fallback: a new variant cannot be walked silently.

use compiler.hir.hir_definitions.*
use compiler.hir.hir_types.*

enum HirWalkNode:
    """Any node the fold callback can be handed."""
    Expr(node: HirExpr)
    Stmt(node: HirStmt)
    Type_(node: HirType)
    Pattern(node: HirPattern)

fn hir_walk_unhandled(kind: text, where_: text, variant: text) -> text:
    """A variant no generated arm names. Loud, never silent."""
    print "E-HIR-VISIT-UNHANDLED: {kind} variant {variant} unhandled at {where_}"
    raise "E-HIR-VISIT-UNHANDLED: {kind} variant {variant} unhandled at {where_}; regenerate src/compiler/20.hir/generated"

