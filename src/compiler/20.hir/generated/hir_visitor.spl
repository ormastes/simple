fn walk_hir_comp_clause_kind<C>(node: HirCompClauseKind, ctx: C, f: fn(HirWalkNode, C) -> C) -> C:
    if node == nil:
        return ctx
    var acc = ctx
    var handled = false
    match node:
        case For(_, b_iter):
