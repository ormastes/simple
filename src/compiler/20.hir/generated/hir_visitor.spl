fn walk_hir_block<C>(node: HirBlock, ctx: C, f: fn(HirWalkNode, C) -> C) -> C:
    if node == nil:
        return ctx
    var acc = ctx
    if node.stmts != nil:
        for it0 in node.stmts:
            acc = walk_hir_stmt(it0, acc, f)
    if node.has:
        acc = walk_hir_expr(node.value, acc, f)
    acc

fn walk_hir_call_arg<C>(node: HirCallArg, ctx: C, f: fn(HirWalkNode, C) -> C) -> C:
