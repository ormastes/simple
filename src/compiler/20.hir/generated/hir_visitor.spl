    var acc = ctx
    acc

fn walk_hir_dim_expr_kind<C>(node: DimExprKind, ctx: C, f: fn(HirWalkNode, C) -> C) -> C:
    if node == nil:
        return ctx
    var acc = ctx
    var handled = false
    match node:
        case Literal(_):
            handled = true
        case Named(_, _, _):
            handled = true
        case Var(_):
            handled = true
        case Dynamic:
            handled = true
        case Broadcast:
            handled = true
        case ConstParam(_):
            handled = true
        case Add(b_left, b_right):
            handled = true
            acc = walk_hir_dim_expr(b_left, acc, f)
            acc = walk_hir_dim_expr(b_right, acc, f)
        case Mul(b_left, b_right):
            handled = true
            acc = walk_hir_dim_expr(b_left, acc, f)
            acc = walk_hir_dim_expr(b_right, acc, f)
        case Div(b_left, b_right):
            handled = true
            acc = walk_hir_dim_expr(b_left, acc, f)
            acc = walk_hir_dim_expr(b_right, acc, f)
        case _:
            handled = false
    if not handled:
        hir_walk_unhandled("DimExprKind", "walk_hir_dim_expr_kind", "<unnamed>")
    acc

