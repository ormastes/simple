                    acc = walk_hir_dim_expr(it1, acc, f)
        case _:
            handled = false
    if not handled:
        hir_walk_unhandled("HirTypeKind", "walk_hir_type", hir_walk_type_kind_name(node))
    acc

fn walk_hir_pattern<C>(node: HirPattern, ctx: C, f: fn(HirWalkNode, C) -> C) -> C:
    if node == nil:
        return ctx
    var acc = f(HirWalkNode.Pattern(node), ctx)
    var handled = false
    if node.has_type_:
        acc = walk_hir_type(node.type_, acc, f)
    match node.kind:
        case Wildcard:
            handled = true
        case Literal(b_value):
            handled = true
            acc = walk_hir_expr(b_value, acc, f)
        case Binding(_, _):
            handled = true
        case Tuple(b_elements):
            handled = true
            if b_elements != nil:
                for it0 in b_elements:
                    acc = walk_hir_pattern(it0, acc, f)
        case Array(b_elements, _):
            handled = true
            if b_elements != nil:
                for it0 in b_elements:
                    acc = walk_hir_pattern(it0, acc, f)
        case Struct(b_type_, b_fields):
            handled = true
            acc = walk_hir_type(b_type_, acc, f)
            if b_fields != nil:
                for (ka1, kb1) in b_fields:
                    acc = walk_hir_pattern(kb1, acc, f)
        case Enum(b_type_, _, b_payload):
            handled = true
            acc = walk_hir_type(b_type_, acc, f)
            acc = walk_hir_pattern_payload(b_payload, acc, f)
        case Or(b_patterns):
            handled = true
            if b_patterns != nil:
                for it0 in b_patterns:
                    acc = walk_hir_pattern(it0, acc, f)
        case Range(b_start, b_end, _):
            handled = true
            acc = walk_hir_expr(b_start, acc, f)
            acc = walk_hir_expr(b_end, acc, f)
        case Error:
            handled = true
        case CompleteRegion(_):
            handled = true
        case DynRegion(_):
            handled = true
        case _:
            handled = false
    if not handled:
        hir_walk_unhandled("HirPatternKind", "walk_hir_pattern", hir_walk_pattern_kind_name(node))
    acc

