fn walk_hir_stmt<C>(node: HirStmt, ctx: C, f: fn(HirWalkNode, C) -> C) -> C:
    if node == nil:
        return ctx
    var acc = f(HirWalkNode.Stmt(node), ctx)
    var handled = false
    match node.kind:
        case Expr(b_expr):
            handled = true
            acc = walk_hir_expr(b_expr, acc, f)
        case Let(_, b_type_, b_init):
            handled = true
            acc = walk_hir_type(b_type_, acc, f)
            acc = walk_hir_expr(b_init, acc, f)
        case Assign(b_target, _, b_value):
            handled = true
            acc = walk_hir_expr(b_target, acc, f)
            acc = walk_hir_expr(b_value, acc, f)
        case Block(b_block):
            handled = true
            acc = walk_hir_block(b_block, acc, f)
        case AsmAssert(_):
            handled = true
        case _:
            handled = false
    if not handled:
        hir_walk_unhandled("HirStmtKind", "walk_hir_stmt", hir_walk_stmt_kind_name(node))
    acc

fn walk_hir_type<C>(node: HirType, ctx: C, f: fn(HirWalkNode, C) -> C) -> C:
    if node == nil:
        return ctx
    var acc = f(HirWalkNode.Type_(node), ctx)
    var handled = false
    match node.kind:
        case Int(_, _):
            handled = true
        case Float(_):
            handled = true
        case Bool:
            handled = true
        case Char:
            handled = true
        case Str:
            handled = true
        case Unit:
            handled = true
        case Tuple(b_elements):
            handled = true
            if b_elements != nil:
                for it0 in b_elements:
                    acc = walk_hir_type(it0, acc, f)
        case Array(b_element, _):
            handled = true
            acc = walk_hir_type(b_element, acc, f)
        case Slice(b_element):
            handled = true
            acc = walk_hir_type(b_element, acc, f)
        case Dict(b_key, b_value):
            handled = true
            acc = walk_hir_type(b_key, acc, f)
            acc = walk_hir_type(b_value, acc, f)
        case Ref(b_inner, _):
            handled = true
            acc = walk_hir_type(b_inner, acc, f)
        case Ptr(b_inner, _):
            handled = true
            acc = walk_hir_type(b_inner, acc, f)
        case Optional(b_inner):
            handled = true
            acc = walk_hir_type(b_inner, acc, f)
        case Result(b_ok, b_err):
            handled = true
            acc = walk_hir_type(b_ok, acc, f)
            acc = walk_hir_type(b_err, acc, f)
        case Named(_, b_args):
            handled = true
            if b_args != nil:
                for it1 in b_args:
                    acc = walk_hir_type(it1, acc, f)
        case TypeParam(_, b_bounds):
            handled = true
            if b_bounds != nil:
                for it1 in b_bounds:
                    acc = walk_hir_type(it1, acc, f)
        case Union(b_members):
            handled = true
            if b_members != nil:
                for it0 in b_members:
                    acc = walk_hir_type(it0, acc, f)
        case DynTrait(_):
            handled = true
        case Function(b_params, b_ret, b_effects):
            handled = true
            if b_params != nil:
                for it0 in b_params:
                    acc = walk_hir_type(it0, acc, f)
            acc = walk_hir_type(b_ret, acc, f)
            if b_effects != nil:
                for it2 in b_effects:
                    acc = walk_hir_effect(it2, acc, f)
        case Projection(b_base, _):
            handled = true
            acc = walk_hir_type(b_base, acc, f)
        case Isolated(b_inner):
            handled = true
            acc = walk_hir_type(b_inner, acc, f)
        case Infer(_, _):
            handled = true
        case Error:
            handled = true
        case Never:
            handled = true
        case Any:
            handled = true
        case Tensor(b_element, b_dims, _):
            handled = true
            acc = walk_hir_type(b_element, acc, f)
