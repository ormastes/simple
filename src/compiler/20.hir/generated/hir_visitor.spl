fn walk_hir_if_arm<C>(node: HirIfArm, ctx: C, f: fn(HirWalkNode, C) -> C) -> C:
    if node == nil:
        return ctx
    var acc = ctx
    acc = walk_hir_expr(node.cond, acc, f)
    acc = walk_hir_block(node.then_, acc, f)
