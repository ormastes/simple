    if node == nil:
        return ctx
    var acc = ctx
    var handled = false
    match node:
        case Tuple(b_values):
            handled = true
            if b_values != nil:
                for it0 in b_values:
                    acc = walk_hir_expr(it0, acc, f)
        case Struct(b_fields):
            handled = true
            if b_fields != nil:
                for (ka0, kb0) in b_fields:
