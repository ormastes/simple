    if node == nil:
        return ctx
    var acc = ctx
    var handled = false
    match node:
        case Pure:
            handled = true
        case IO:
            handled = true
        case Async:
            handled = true
        case Throws(b_type_):
            handled = true
            acc = walk_hir_type(b_type_, acc, f)
        case Mutates:
            handled = true
        case Allocates:
            handled = true
        case Custom(_):
            handled = true
        case _:
            handled = false
    if not handled:
        hir_walk_unhandled("EffectKind", "walk_hir_effect_kind", "<unnamed>")
    acc

fn walk_hir_asm<C>(node: HirAsm, ctx: C, f: fn(HirWalkNode, C) -> C) -> C:
    if node == nil:
        return ctx
    var acc = ctx
    if node.constraints != nil:
        for it0 in node.constraints:
            acc = walk_hir_asm_constraint(it0, acc, f)
    acc

fn walk_hir_asm_constraint<C>(node: HirAsmConstraint, ctx: C, f: fn(HirWalkNode, C) -> C) -> C:
    if node == nil:
        return ctx
    var acc = ctx
    acc = walk_hir_expr(node.value, acc, f)
    acc = walk_hir_expr(node.output_value, acc, f)
    acc

fn walk_hir_asm_match_arm<C>(node: HirAsmMatchArm, ctx: C, f: fn(HirWalkNode, C) -> C) -> C:
    if node == nil:
