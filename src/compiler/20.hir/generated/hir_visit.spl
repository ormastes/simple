        HirVisitCounter(exprs: 0, stmts: 0, types: 0, patterns: 0, kinds: [])

    me on_expr(node: HirExpr):
        self.exprs = self.exprs + 1
        self.kinds = self.kinds.push(hir_expr_kind_name(node))

    me on_stmt(node: HirStmt):
        self.stmts = self.stmts + 1
        self.kinds = self.kinds.push(hir_stmt_kind_name(node))

    me on_type(node: HirType):
        self.types = self.types + 1
        self.kinds = self.kinds.push(hir_gen_type_kind_name(node))

    me on_pattern(node: HirPattern):
        self.patterns = self.patterns + 1
        self.kinds = self.kinds.push(hir_pattern_kind_name(node))

