fn hir_visit_stmt(node: HirStmt, visitor: HirVisitor):
    if node == nil:
        return
    visitor.on_stmt(node)
    match node.kind:
        case Expr(b_expr):
            hir_visit_expr(b_expr, visitor)
        case Let(_, b_type_, b_init):
            hir_visit_type(b_type_, visitor)
            hir_visit_expr(b_init, visitor)
        case Assign(b_target, _, b_value):
            hir_visit_expr(b_target, visitor)
            hir_visit_expr(b_value, visitor)
        case Block(b_block):
            hir_visit_block(b_block, visitor)
        case AsmAssert(_):
            hir_visit_nothing()
        case _: unreachable_hir_variant("HirStmtKind", "hir_visit_stmt")

fn hir_visit_type(node: HirType, visitor: HirVisitor):
    if node == nil:
        return
    visitor.on_type(node)
    match node.kind:
        case Int(_, _):
            hir_visit_nothing()
        case Float(_):
            hir_visit_nothing()
        case Bool:
            hir_visit_nothing()
        case Char:
            hir_visit_nothing()
        case Str:
            hir_visit_nothing()
        case Unit:
            hir_visit_nothing()
        case Tuple(b_elements):
            for it0 in b_elements:
                hir_visit_type(it0, visitor)
        case Array(b_element, _):
            hir_visit_type(b_element, visitor)
        case Slice(b_element):
            hir_visit_type(b_element, visitor)
        case Dict(b_key, b_value):
            hir_visit_type(b_key, visitor)
            hir_visit_type(b_value, visitor)
        case Ref(b_inner, _):
            hir_visit_type(b_inner, visitor)
        case Ptr(b_inner, _):
            hir_visit_type(b_inner, visitor)
        case Optional(b_inner):
            hir_visit_type(b_inner, visitor)
        case Result(b_ok, b_err):
            hir_visit_type(b_ok, visitor)
            hir_visit_type(b_err, visitor)
        case Named(_, b_args):
            for it1 in b_args:
                hir_visit_type(it1, visitor)
        case TypeParam(_, b_bounds):
            for it1 in b_bounds:
                hir_visit_type(it1, visitor)
        case Union(b_members):
            for it0 in b_members:
                hir_visit_type(it0, visitor)
        case DynTrait(_):
            hir_visit_nothing()
        case Function(b_params, b_ret, b_effects):
            for it0 in b_params:
                hir_visit_type(it0, visitor)
            hir_visit_type(b_ret, visitor)
            for it2 in b_effects:
                hir_visit_effect(it2, visitor)
        case Projection(b_base, _):
            hir_visit_type(b_base, visitor)
        case Isolated(b_inner):
            hir_visit_type(b_inner, visitor)
        case Infer(_, _):
            hir_visit_nothing()
        case Error:
            hir_visit_nothing()
        case Never:
            hir_visit_nothing()
        case Any:
            hir_visit_nothing()
        case Tensor(b_element, b_dims, _):
            hir_visit_type(b_element, visitor)
            for it1 in b_dims:
                hir_visit_dim_expr(it1, visitor)
        case Layer(b_input, b_output):
            for it0 in b_input:
                hir_visit_dim_expr(it0, visitor)
            for it1 in b_output:
                hir_visit_dim_expr(it1, visitor)
        case _: unreachable_hir_variant("HirTypeKind", "hir_visit_type")

fn hir_visit_pattern(node: HirPattern, visitor: HirVisitor):
    if node == nil:
        return
    visitor.on_pattern(node)
    if node.has_type_:
        hir_visit_type(node.type_, visitor)
    match node.kind:
        case Wildcard:
            hir_visit_nothing()
        case Literal(b_value):
            hir_visit_expr(b_value, visitor)
        case Binding(_, _):
            hir_visit_nothing()
        case Tuple(b_elements):
            for it0 in b_elements:
                hir_visit_pattern(it0, visitor)
        case Array(b_elements, _):
            for it0 in b_elements:
                hir_visit_pattern(it0, visitor)
        case Struct(b_type_, b_fields):
            hir_visit_type(b_type_, visitor)
            for (ka1, kb1) in b_fields:
                hir_visit_pattern(kb1, visitor)
        case Enum(b_type_, _, b_payload):
            hir_visit_type(b_type_, visitor)
            hir_visit_pattern_payload(b_payload, visitor)
        case Or(b_patterns):
            for it0 in b_patterns:
                hir_visit_pattern(it0, visitor)
        case Range(b_start, b_end, _):
            hir_visit_expr(b_start, visitor)
            hir_visit_expr(b_end, visitor)
        case Error:
            hir_visit_nothing()
        case CompleteRegion(_):
            hir_visit_nothing()
        case DynRegion(_):
            hir_visit_nothing()
        case _: unreachable_hir_variant("HirPatternKind", "hir_visit_pattern")

fn hir_visit_dim_expr(node: DimExpr, visitor: HirVisitor):
    if node == nil:
        return
    hir_visit_nothing()

fn hir_visit_dim_expr_kind(node: DimExprKind, visitor: HirVisitor):
    if node == nil:
        return
    match node:
        case Literal(_):
            hir_visit_nothing()
        case Named(_, _, _):
            hir_visit_nothing()
        case Var(_):
            hir_visit_nothing()
        case Dynamic:
            hir_visit_nothing()
        case Broadcast:
            hir_visit_nothing()
        case ConstParam(_):
            hir_visit_nothing()
        case Add(b_left, b_right):
            hir_visit_dim_expr(b_left, visitor)
            hir_visit_dim_expr(b_right, visitor)
        case Mul(b_left, b_right):
            hir_visit_dim_expr(b_left, visitor)
            hir_visit_dim_expr(b_right, visitor)
        case Div(b_left, b_right):
            hir_visit_dim_expr(b_left, visitor)
            hir_visit_dim_expr(b_right, visitor)
        case _: unreachable_hir_variant("DimExprKind", "hir_visit_dim_expr_kind")

fn hir_visit_effect(node: Effect, visitor: HirVisitor):
    if node == nil:
        return
    hir_visit_nothing()

fn hir_visit_effect_kind(node: EffectKind, visitor: HirVisitor):
    if node == nil:
        return
    match node:
        case Pure:
            hir_visit_nothing()
        case IO:
            hir_visit_nothing()
        case Async:
            hir_visit_nothing()
        case Throws(b_type_):
            hir_visit_type(b_type_, visitor)
        case Mutates:
            hir_visit_nothing()
        case Allocates:
            hir_visit_nothing()
        case Custom(_):
            hir_visit_nothing()
        case _: unreachable_hir_variant("EffectKind", "hir_visit_effect_kind")

fn hir_visit_asm(node: HirAsm, visitor: HirVisitor):
    if node == nil:
        return
    for it0 in node.constraints:
        hir_visit_asm_constraint(it0, visitor)

fn hir_visit_asm_constraint(node: HirAsmConstraint, visitor: HirVisitor):
    if node == nil:
        return
    hir_visit_expr(node.value, visitor)
    hir_visit_expr(node.output_value, visitor)

fn hir_visit_asm_match_arm(node: HirAsmMatchArm, visitor: HirVisitor):
    if node == nil:
        return
    if node.has_asm_body:
        hir_visit_asm(node.asm_body, visitor)

fn hir_visit_block(node: HirBlock, visitor: HirVisitor):
    if node == nil:
        return
    for it0 in node.stmts:
        hir_visit_stmt(it0, visitor)
    if node.has:
        hir_visit_expr(node.value, visitor)

fn hir_visit_call_arg(node: HirCallArg, visitor: HirVisitor):
    if node == nil:
        return
    hir_visit_expr(node.value, visitor)

fn hir_visit_comp_clause(node: HirCompClause, visitor: HirVisitor):
    if node == nil:
        return
    hir_visit_nothing()

fn hir_visit_comp_clause_kind(node: HirCompClauseKind, visitor: HirVisitor):
    if node == nil:
        return
    match node:
        case For(_, b_iter):
            hir_visit_expr(b_iter, visitor)
        case If(b_cond):
            hir_visit_expr(b_cond, visitor)
        case _: unreachable_hir_variant("HirCompClauseKind", "hir_visit_comp_clause_kind")

fn hir_visit_comprehension_kind(node: HirComprehensionKind, visitor: HirVisitor):
    if node == nil:
        return
    match node:
        case List:
            hir_visit_nothing()
        case Dict:
            hir_visit_nothing()
        case Set:
            hir_visit_nothing()
        case Generator:
            hir_visit_nothing()
        case _: unreachable_hir_variant("HirComprehensionKind", "hir_visit_comprehension_kind")

fn hir_visit_enum_payload(node: HirEnumPayload, visitor: HirVisitor):
    if node == nil:
        return
    match node:
        case Tuple(b_values):
            for it0 in b_values:
                hir_visit_expr(it0, visitor)
        case Struct(b_fields):
            for (ka0, kb0) in b_fields:
                hir_visit_expr(kb0, visitor)
        case _: unreachable_hir_variant("HirEnumPayload", "hir_visit_enum_payload")

fn hir_visit_if_arm(node: HirIfArm, visitor: HirVisitor):
    if node == nil:
        return
    hir_visit_expr(node.cond, visitor)
    hir_visit_block(node.then_, visitor)

fn hir_visit_interpolation(node: HirInterpolation, visitor: HirVisitor):
    if node == nil:
        return
    hir_visit_expr(node.expr, visitor)

fn hir_visit_match_arm(node: HirMatchArm, visitor: HirVisitor):
    if node == nil:
        return
    hir_visit_pattern(node.pattern, visitor)
    if node.has_guard:
        hir_visit_expr(node.guard, visitor)
    hir_visit_block(node.body, visitor)

fn hir_visit_param(node: HirParam, visitor: HirVisitor):
    if node == nil:
        return
    hir_visit_type(node.type_, visitor)
    if node.has_default:
        hir_visit_expr(node.default, visitor)

fn hir_visit_pattern_payload(node: HirPatternPayload, visitor: HirVisitor):
    if node == nil:
        return
    match node:
        case Tuple(b_patterns):
            for it0 in b_patterns:
                hir_visit_pattern(it0, visitor)
        case Struct(b_fields):
            for (ka0, kb0) in b_fields:
                hir_visit_pattern(kb0, visitor)
        case _: unreachable_hir_variant("HirPatternPayload", "hir_visit_pattern_payload")

fn hir_visit_with_item(node: HirWithItem, visitor: HirVisitor):
    if node == nil:
        return
    hir_visit_expr(node.context_expr, visitor)

export HirVisitor, HirVisitCounter, unreachable_hir_variant, hir_visit_nothing
export hir_expr_kind_name, hir_stmt_kind_name, hir_gen_type_kind_name, hir_pattern_kind_name
export hir_visit_expr, hir_visit_stmt, hir_visit_type, hir_visit_pattern, hir_visit_dim_expr, hir_visit_dim_expr_kind, hir_visit_effect, hir_visit_effect_kind, hir_visit_asm, hir_visit_asm_constraint, hir_visit_asm_match_arm, hir_visit_block, hir_visit_call_arg, hir_visit_comp_clause, hir_visit_comp_clause_kind, hir_visit_comprehension_kind, hir_visit_enum_payload, hir_visit_if_arm, hir_visit_interpolation, hir_visit_match_arm, hir_visit_param, hir_visit_pattern_payload, hir_visit_with_item
