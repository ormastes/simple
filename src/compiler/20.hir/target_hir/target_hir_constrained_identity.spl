# TargetHIR identity extended with the constraints digest captured from the
# module's static-guard reads, so two views whose guards could evaluate
# differently (THIR-04) never share an identity. Base identity is unchanged.

use compiler.hir.target_hir.target_hir.{TargetHIR, target_hir_identity}

fn target_hir_identity_with_constraints(view: TargetHIR, digest: text) -> Result<text, text>:
    val d = digest.trim()
    if d == "":
        return Err("target_hir_constraints_digest_required")
    Ok(target_hir_identity(view) + "|constraints:" + d)
