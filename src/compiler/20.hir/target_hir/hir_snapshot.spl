# Nominal identity of an admitted, target-neutral HIR snapshot.
# PR-A of doc/03_plan/compiler/hir/immutable_hir_targethir_mir_refactor_plan_2026-11-03.md:
# identity only, no freezing and no behavior change. Ids are scoped by module,
# content digest and generation; they are never treated as global hashes.

struct HirSnapshotId:
    module_name: text
    content_digest: text
    generation: i64

fn hir_snapshot_id_new(module_name: text, content_digest: text, generation: i64) -> Result<HirSnapshotId, text>:
    val name = module_name.trim()
    val digest = content_digest.trim()
    if name == "":
        return Err("hir_snapshot_module_required")
    if digest == "":
        return Err("hir_snapshot_digest_required")
    if generation < 0:
        return Err("hir_snapshot_generation_negative: " + generation.to_string())
    Ok(HirSnapshotId(module_name: name, content_digest: digest, generation: generation))

fn hir_snapshot_id_equals(a: HirSnapshotId, b: HirSnapshotId) -> bool:
    a.module_name == b.module_name and a.content_digest == b.content_digest and a.generation == b.generation

fn hir_snapshot_id_text(id: HirSnapshotId) -> text:
    "hir:" + id.module_name + "@" + id.content_digest + "#" + id.generation.to_string()
