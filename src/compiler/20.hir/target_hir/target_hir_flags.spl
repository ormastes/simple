# TargetHIR flags — the SINGLE owner of every TargetHIR environment knob.
# Every other module (P4 live wiring, cache identity, bench, units U1..U7)
# imports from here; nobody else reads SIMPLE_TARGET_HIR_* or
# SIMPLE_STAGE3_COMPILER directly.
#
#   SIMPLE_TARGET_HIR_MODE     legacy | shadow | typed   (default legacy)
#   SIMPLE_TARGET_HIR_VERIFY   1/true/yes/on -> true     (default false)
#   SIMPLE_TARGET_HIR_STORAGE  auto | dense | sparse     (default auto)
#   SIMPLE_STAGE3_COMPILER     path to an admitted Stage 3 compiler, or unset
#
# The *_parse functions are pure (no env access) so they are unit-testable.
# target_hir_mode() is lenient (invalid -> legacy, the release default);
# callers that must refuse a typo use target_hir_mode_strict().

use std.nogc_sync_mut.io_runtime.{env_get_opt}

val TARGET_HIR_MODE_ENV = "SIMPLE_TARGET_HIR_MODE"
val TARGET_HIR_VERIFY_ENV = "SIMPLE_TARGET_HIR_VERIFY"
val TARGET_HIR_STORAGE_ENV = "SIMPLE_TARGET_HIR_STORAGE"
val STAGE3_COMPILER_ENV = "SIMPLE_STAGE3_COMPILER"

# Strict: unset/empty/"legacy" -> legacy; shadow|typed; anything else -> Err.
fn target_hir_mode_parse_strict(raw: text?) -> Result<text, text>:
    val v = (raw ?? "").trim().lower()
    if v == "" or v == "legacy":
        return Ok("legacy")
    if v == "shadow" or v == "typed":
        return Ok(v)
    Err("target_hir_mode_unknown: " + (raw ?? ""))

fn target_hir_mode_parse(raw: text?) -> text:
    val r = target_hir_mode_parse_strict(raw)
    if r.is_err():
        return "legacy"
    r.unwrap()

fn target_hir_verify_parse(raw: text?) -> bool:
    val v = (raw ?? "").trim().lower()
    v == "1" or v == "true" or v == "yes" or v == "on"

fn target_hir_storage_parse(raw: text?) -> text:
    val v = (raw ?? "").trim().lower()
    if v == "dense" or v == "sparse":
        return v
    "auto"

fn stage3_compiler_path_parse(raw: text?) -> text?:
    val v = (raw ?? "").trim()
    if v == "":
        return nil
    v

fn target_hir_mode() -> text:
    target_hir_mode_parse(env_get_opt(TARGET_HIR_MODE_ENV))

fn target_hir_mode_strict() -> Result<text, text>:
    target_hir_mode_parse_strict(env_get_opt(TARGET_HIR_MODE_ENV))

fn target_hir_verify() -> bool:
    target_hir_verify_parse(env_get_opt(TARGET_HIR_VERIFY_ENV))

fn target_hir_storage() -> text:
    target_hir_storage_parse(env_get_opt(TARGET_HIR_STORAGE_ENV))

fn stage3_compiler_path() -> text?:
    stage3_compiler_path_parse(env_get_opt(STAGE3_COMPILER_ENV))
