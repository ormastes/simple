# Read-only TargetHIR facade: a HIR snapshot bound to one explicit, normalized
# target. PR-A carries identity only; layout/ABI resolution arrives in PR-C.
# The target is built solely through mir_target_context_from_explicit, so an
# implicit host or lossy triple can never bind a TargetHIR.

use compiler.common.mir_target_context.{MirTargetContext, mir_target_context_from_explicit}
use compiler.hir.target_hir.hir_snapshot.{HirSnapshotId, hir_snapshot_id_text}

struct TargetHIR:
    snapshot: HirSnapshotId
    target: MirTargetContext
    region: text

fn target_hir_for_explicit(snapshot: HirSnapshotId, target_triple: text, backend: text, version: i64, region: text) -> Result<TargetHIR, text>:
    val region_name = region.trim()
    if region_name == "":
        return Err("target_hir_region_required")
    val target = mir_target_context_from_explicit(target_triple, backend, version)
    if target.is_err():
        return Err(target.unwrap_err())
    Ok(TargetHIR(snapshot: snapshot, target: target.unwrap(), region: region_name))

fn target_hir_snapshot(view: TargetHIR) -> HirSnapshotId:
    view.snapshot

fn target_hir_target(view: TargetHIR) -> MirTargetContext:
    view.target

fn target_hir_target_id(view: TargetHIR) -> text:
    val t = view.target
    var id = t.arch
    if t.subarch != "":
        id = id + "(" + t.subarch + ")"
    id + "-" + t.os + "-" + t.abi + "/" + t.backend + "@" + t.version.to_string()

fn target_hir_identity(view: TargetHIR) -> text:
    hir_snapshot_id_text(view.snapshot) + "|" + target_hir_target_id(view) + "|region:" + view.region
