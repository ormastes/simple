# Read-only TargetHIR facade: a HIR snapshot bound to one explicit, normalized
# target. PR-A carries identity only; layout/ABI resolution arrives in PR-C.
# The target is built solely through mir_target_context_from_explicit, so an
# implicit host or lossy triple can never bind a TargetHIR.

use compiler.common.mir_target_context.{MirTargetContext, mir_target_context_from_explicit}
use compiler.hir.target_hir.hir_snapshot.{HirSnapshotId, hir_snapshot_id_text}

struct TargetHIR:
    snapshot: HirSnapshotId
    target: MirTargetContext
    region: text

fn target_hir_for_explicit(snapshot: HirSnapshotId, target_triple: text, backend: text, version: i64, region: text) -> Result<TargetHIR, text>:
    val region_name = region.trim()
    if region_name == "":
        return Err("target_hir_region_required")
    val target = mir_target_context_from_explicit(target_triple, backend, version)
    if target.is_err():
        return Err(target.unwrap_err())
    Ok(TargetHIR(snapshot: snapshot, target: target.unwrap(), region: region_name))

fn target_hir_snapshot(view: TargetHIR) -> HirSnapshotId:
    view.snapshot

fn target_hir_target(view: TargetHIR) -> MirTargetContext:
    view.target

fn target_hir_target_id(view: TargetHIR) -> text:
    val t = view.target
    # Version 2 binds every target-context input read by MIR. Profile and tier
    # change guard/SIMD selection; collection controls change lowering policy.
    # Length framing preserves field boundaries even for delimiter-bearing
    # caller contexts. Older target ids intentionally cannot hit this identity.
    val fields = [t.arch, t.os, t.abi, t.backend, t.version.to_string(),
        t.build_profile, t.subarch, t.cpu_tier, t.collection_policy,
        t.collection_memory_budget_bytes.to_string(), t.collection_opt_level.to_string(),
        if t.collection_trace_active: "1" else: "0",
        if t.collection_target_admitted: "1" else: "0"]
    var framed: [text] = []
    for field in fields:
        framed.push(field.len().to_string() + ":" + field)
    "target-hir-context-v2|" + framed.join("|")

fn target_hir_identity(view: TargetHIR) -> text:
    hir_snapshot_id_text(view.snapshot) + "|" + target_hir_target_id(view) + "|region:" + view.region

# P4 live-lowering adapter: binds an already-normalized MirTargetContext (the
# one MirLowering carries). MirTargetContext does not retain its source triple,
# so a round trip through target_hir_for_explicit is not possible here; this
# guard instead refuses a context missing arch/os/backend.
fn target_hir_for_context(snapshot: HirSnapshotId, target: MirTargetContext, region: text) -> Result<TargetHIR, text>:
    val region_name = region.trim()
    if region_name == "":
        return Err("target_hir_region_required")
    if target.arch == "" or target.os == "" or target.backend == "":
        return Err("target_hir_context_not_explicit: " + target.arch + "-" + target.os + "/" + target.backend)
    Ok(TargetHIR(snapshot: snapshot, target: target, region: region_name))
