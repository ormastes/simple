# Value ownership classification shared by HIR consumers and MIR lowering.
use compiler.hir.hir_types.{HirType, HirTypeKind}

pub fn hir_type_ownership_is_known(type_: HirType) -> bool:
    """Whether stored value ownership can be classified without guessing.

    Handle and signature barriers have known ownership independent of their
    pointees. A projection's base and a type parameter's bounds do not define
    the actual value's ownership, so these require resolution first.
    """
    if type_ == nil: return false
    match type_.kind:
        case HirTypeKind.Infer(_, _) | HirTypeKind.Error | HirTypeKind.Any: return false
        case HirTypeKind.TypeParam(_, _) | HirTypeKind.Projection(_, _): return false
        case HirTypeKind.Tuple(elements) | HirTypeKind.Union(elements):
            for element in elements:
                if not hir_type_ownership_is_known(element): return false
        case HirTypeKind.Named(_, arguments):
            for argument in arguments:
                if not hir_type_ownership_is_known(argument): return false
        case HirTypeKind.Array(inner, _) | HirTypeKind.Optional(inner):
            return hir_type_ownership_is_known(inner)
        case HirTypeKind.Dict(key, value) | HirTypeKind.Result(key, value):
            return hir_type_ownership_is_known(key) and hir_type_ownership_is_known(value)
        case HirTypeKind.Tensor(inner, _, _): return hir_type_ownership_is_known(inner)
        case _: pass
    true

pub fn hir_type_contains_unique(type_: HirType) -> bool:
    """Whether a value stores a unique owner, without crossing handle barriers.

    Pointees, function signatures, bounds and unresolved projections are not
    stored payloads. Unknown types return false; this is not proof of Copy.
    """
    if type_ == nil: return false
    match type_.kind:
        case HirTypeKind.Unique(_) | HirTypeKind.Isolated(_): return true
        case HirTypeKind.Tuple(elements) | HirTypeKind.Union(elements):
            for element in elements:
                if hir_type_contains_unique(element): return true
        case HirTypeKind.Named(_, arguments):
            for argument in arguments:
                if hir_type_contains_unique(argument): return true
        case HirTypeKind.Array(inner, _) | HirTypeKind.Optional(inner):
            return hir_type_contains_unique(inner)
        case HirTypeKind.Dict(key, value):
            return hir_type_contains_unique(key) or hir_type_contains_unique(value)
        case HirTypeKind.Result(ok, err):
            return hir_type_contains_unique(ok) or hir_type_contains_unique(err)
        case HirTypeKind.Tensor(inner, _, _): return hir_type_contains_unique(inner)
        case _: pass
    false

pub fn hir_type_requires_move(type_: HirType, nogc_strict: bool) -> bool:
    """Whether transferring this value requires an owning move.

    Strict allocated containers own their storage even with scalar elements.
    Shared/Weak and Ref/Ptr never consume their pointees. Slice is a view.
    Infer/Error/Any/TypeParam/Projection require independent validation; false
    must not be used to authorize a copy of an unresolved strict transfer.
    """
    if type_ == nil: return false
    match type_.kind:
        case HirTypeKind.Unique(_) | HirTypeKind.Isolated(_): return true
        case HirTypeKind.Named(_, arguments):
            if nogc_strict: return true
            for argument in arguments:
                if hir_type_requires_move(argument, false): return true
        case HirTypeKind.Tuple(elements) | HirTypeKind.Union(elements):
            for element in elements:
                if hir_type_requires_move(element, nogc_strict): return true
        case HirTypeKind.Array(inner, _):
            return nogc_strict or hir_type_requires_move(inner, false)
        case HirTypeKind.Dict(key, value):
            return nogc_strict or hir_type_requires_move(key, false) or hir_type_requires_move(value, false)
        case HirTypeKind.Tensor(inner, _, _):
            return nogc_strict or hir_type_requires_move(inner, false)
        case HirTypeKind.Optional(inner): return hir_type_requires_move(inner, nogc_strict)
        case HirTypeKind.Result(ok, err):
            return hir_type_requires_move(ok, nogc_strict) or hir_type_requires_move(err, nogc_strict)
        case HirTypeKind.DynTrait(_) | HirTypeKind.Layer(_, _): return nogc_strict
        case _: pass
    false

pub fn hir_type_is_short_candidate(type_: HirType) -> bool:
    """Whether a parameter value can denote a bare short view, not a handle.

    Parameter lending is distinct from value transfer: a bare aggregate can
    lend its stored unique payload without transferring that payload. Only
    an outer explicit owner/handle changes the parameter's declared effect.
    This classifies shape only; a checked non-retaining contract is required.
    """
    if type_ == nil: return false
    match type_.kind:
        case HirTypeKind.Ref(_, _) | HirTypeKind.Slice(_): return true
        case HirTypeKind.Named(_, _) | HirTypeKind.Array(_, _) | HirTypeKind.Dict(_, _): return true
        case HirTypeKind.Tensor(_, _, _) | HirTypeKind.Layer(_, _) | HirTypeKind.DynTrait(_): return true
        case HirTypeKind.Optional(inner):
            return hir_type_requires_move(inner, true) or hir_type_is_short_candidate(inner)
        case HirTypeKind.Result(ok, err):
            return hir_type_requires_move(ok, true) or hir_type_requires_move(err, true) or hir_type_is_short_candidate(ok) or hir_type_is_short_candidate(err)
        case HirTypeKind.Tuple(elements) | HirTypeKind.Union(elements):
            for element in elements:
                if hir_type_requires_move(element, true) or hir_type_is_short_candidate(element): return true
        case _: pass
    false
