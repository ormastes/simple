# Compiler-owned SFFI declaration identity shared by lowering, safety, and
# explicit audit tooling. The reserved marker is metadata, not a user-facing
# effect contract.

use compiler.hir.hir_types.{Effect, EffectKind, HirType, HirTypeKind}
use compiler.common.diagnostics.span.{Span}

fn sffi_raw_callable_effects(is_extern: bool, span: Span) -> [Effect]:
    if is_extern:
        return [Effect(
            kind: EffectKind.Custom("__compiler_sffi_raw_v2"),
            span: span)]
    []

fn hir_type_is_sffi_raw_callable(type_: HirType?) -> bool:
    if val callable_type = type_:
        match callable_type.kind:
            case Function(_, _, effects):
                for effect in effects:
                    match effect.kind:
                        case Custom(name):
                            if name == "__compiler_sffi_raw_v2":
                                return true
                        case _:
                            pass
            case _:
                pass
    false

fn sffi_raw_name_has_reserved_prefix(name: text) -> bool:
    name.starts_with("rt_") or name.starts_with("spl_")

export sffi_raw_callable_effects, hir_type_is_sffi_raw_callable
export sffi_raw_name_has_reserved_prefix
