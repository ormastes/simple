# Request-local opt-in imported-callable provenance. Primitive/Span only:
# the lowerer imports this owner, so importing HIR here would form a cycle.
use compiler.common.diagnostics.span.{Span}

struct HirImportedReferenceOriginV1:
    local_symbol_id: i64
    module_ordinal: i64
    terminal_module: text
    terminal_name: text
    local_alias: text
    import_span: Span

class HirReferenceOriginSinkV1:
    enabled: bool
    module_ordinal: i64
    invalid_reason: text
    rows: Dict<i64, HirImportedReferenceOriginV1>

    static fn disabled() -> HirReferenceOriginSinkV1:
        HirReferenceOriginSinkV1(enabled: false, module_ordinal: -1,
            invalid_reason: "", rows: {})

    me begin_module(module_ordinal: i64):
        self.enabled = true
        self.module_ordinal = module_ordinal
        self.invalid_reason = ""
        self.rows = {}
        if module_ordinal < 0:
            self.invalid_reason = "unresolved_origin: invalid module ordinal"

    me record_imported_callable(local_symbol_id: i64, terminal_module: text, terminal_name: text, local_alias: text, import_span: Span):
        if not self.enabled or self.invalid_reason != "":
            return
        if local_symbol_id < 0 or terminal_module == "" or terminal_name == "" or local_alias == "":
            self.invalid_reason = "unresolved_origin: incomplete imported callable event"
            return
        if import_span.start < 0 or import_span.end <= import_span.start or import_span.line < 1:
            self.invalid_reason = "invalid_span: imported callable lacks original import provenance"
            return
        if self.rows.contains_key(local_symbol_id):
            val previous: HirImportedReferenceOriginV1 = self.rows[local_symbol_id]
            if (previous.module_ordinal != self.module_ordinal or
                previous.terminal_module != terminal_module or previous.terminal_name != terminal_name or
                previous.local_alias != local_alias or previous.import_span.start != import_span.start or
                previous.import_span.end != import_span.end or previous.import_span.line != import_span.line or
                previous.import_span.col != import_span.col or previous.import_span.file != import_span.file):
                self.invalid_reason = "unresolved_origin: conflicting imported callable events"
            return
        self.rows[local_symbol_id] = HirImportedReferenceOriginV1(
            local_symbol_id: local_symbol_id, module_ordinal: self.module_ordinal,
            terminal_module: terminal_module, terminal_name: terminal_name,
            local_alias: local_alias, import_span: import_span)

    fn lookup(local_symbol_id: i64) -> HirImportedReferenceOriginV1?:
        if not self.enabled or self.invalid_reason != "" or not self.rows.contains_key(local_symbol_id):
            return nil
        Some(self.rows[local_symbol_id])
