# Typed HIR verification-contract helpers.

use compiler.hir.hir_definitions.{HirContractClause}
use compiler.hir.hir_types.{HirType, HirTypeKind}

pub fn hir_verification_decreases_type_valid(type_: HirType) -> bool:
    match type_.kind:
        case HirTypeKind.Int(8, false) | HirTypeKind.Int(16, false) |
             HirTypeKind.Int(32, false) | HirTypeKind.Int(64, false) |
             HirTypeKind.Int(128, false):
            true
        case _: false

pub fn hir_verification_append_clause(
    clauses: [HirContractClause], clause: HirContractClause
) -> [HirContractClause]:
    clauses.push(clause)
