# Body-free symbol projection for actual mono nominal transport.
# Serialized rows contain types/spans/identity only, never scopes or HIR bodies.
use compiler.hir.hir_types.*
use compiler.hir.hir_codec_support.{HirCodecWriter}
use compiler.hir.generated.hir_codec.{hc_enc_hir_symbol, hc_dec_hir_symbol}
use compiler.frontend.core.flat_pool_codec.{FlatPoolReader}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}

fn hir_mono_symbol_projection_encode_v1(table: SymbolTable, cohort: text) -> text:
    if transient_array_scope_state_v1() != 1 or cohort == "": return ""
    var w = HirCodecWriter.create()
    w.put_text("hir-mono-symbol-projection-v1")
    w.put_text(cohort)
    w.put_i64(table.current_scope.id)
    w.put_i64(table.next_symbol_id)
    w.put_i64(table.symbols.len())
    for id in table.symbols.keys().sort():
        val row: HirSymbol = table.symbols[id]
        if row.id.id != id: return ""
        hc_enc_hir_symbol(w, row)
    w.put_i64(table.qualified_types.len())
    for key in table.qualified_types.keys().sort():
        w.put_text(key)
        w.put_i64(table.qualified_types[key])
    w.put_i64(table.structural_union_owners.len())
    for id in table.structural_union_owners.keys().sort():
        w.put_i64(id)
        w.put_text(table.structural_union_owners[id])
    if not w.ok: return ""
    w.finish()

# The returned table is caller-owned scratch, not a persistent projection.
fn hir_mono_symbol_projection_decode_v1(blob: text) -> Result<(text, SymbolTable), text>:
    if transient_array_scope_state_v1() != 1: return Err("nominal projection requires borrowed active scope")
    var reader = FlatPoolReader.new(blob)
    if reader.decode_text(reader.next()) != "hir-mono-symbol-projection-v1": return Err("nominal projection stage")
    val cohort = reader.decode_text(reader.next())
    var table = SymbolTable.new()
    table.current_scope = ScopeId(id: reader.next_i64())
    table.next_symbol_id = reader.next_i64()
    var count = reader.next_len()
    var index = 0
    while index < count and reader.ok:
        val row = hc_dec_hir_symbol(reader)
        if row.id.id < 0 or table.symbols.has(row.id.id): return Err("nominal projection duplicate declaration")
        table.symbols[row.id.id] = row
        index = index + 1
    count = reader.next_len()
    index = 0
    while index < count and reader.ok:
        val key = reader.decode_text(reader.next())
        val id = reader.next_i64()
        if table.qualified_types.has(key): return Err("nominal projection qualified index")
        table.qualified_types[key] = id
        index = index + 1
    count = reader.next_len()
    index = 0
    while index < count and reader.ok:
        val id = reader.next_i64()
        val owner = reader.decode_text(reader.next())
        if table.structural_union_owners.has(id): return Err("nominal projection duplicate union reservation")
        table.structural_union_owners[id] = owner
        index = index + 1
    if not reader.ok or reader.pos != reader.lines.len() - 1 or reader.lines[reader.pos] != "" or
            hir_mono_symbol_projection_encode_v1(table, cohort) != blob:
        return Err("nominal projection stable framing")
    Ok((cohort, table))

# Install only independently replayed final rows into the genuine complete
# body. Preserve its lexical scopes/function indexes and all executable data.
fn hir_mono_symbol_projection_install_v1(table: SymbolTable, blob: text) -> Result<bool, text>:
    val decoded = hir_mono_symbol_projection_decode_v1(blob)?
    val (_, projected) = decoded
    for id in projected.symbols.keys():
        val row: HirSymbol = projected.symbols[id]
        if table.symbols.has(id):
            var old_writer = HirCodecWriter.create()
            var new_writer = HirCodecWriter.create()
            hc_enc_hir_symbol(old_writer, table.symbols[id])
            hc_enc_hir_symbol(new_writer, row)
            if old_writer.finish() != new_writer.finish(): return Err("nominal projection existing row changed")
        else:
            match row.kind:
                case SymbolKind.Struct | SymbolKind.Class | SymbolKind.Enum | SymbolKind.Trait: ()
                case _: return Err("nominal projection added non-type row")
            table.symbols[id] = row
    for key in projected.qualified_types.keys():
        val id = projected.qualified_types[key]
        if table.qualified_types.has(key) and table.qualified_types[key] != id: return Err("nominal projection changed qualified owner")
        table.qualified_types[key] = id
    if projected.next_symbol_id < table.next_symbol_id: return Err("nominal projection counter decreased")
    table.next_symbol_id = projected.next_symbol_id
    Ok(true)

export hir_mono_symbol_projection_encode_v1, hir_mono_symbol_projection_decode_v1
export hir_mono_symbol_projection_install_v1

# Only genuinely new nominal rows/index entries and a counter escape per
# publication. Never retain another complete declaration snapshot in a ledger.
fn hir_mono_symbol_patch_encode_v1(before: SymbolTable, after: SymbolTable, cohort: text) -> Result<text, text>:
    if transient_array_scope_state_v1() != 1: return Err("nominal patch requires active scope")
    var rows: [HirSymbol] = []
    for id in after.symbols.keys().sort():
        val row: HirSymbol = after.symbols[id]
        if before.symbols.has(id):
            var old = HirCodecWriter.create()
            var current = HirCodecWriter.create()
            hc_enc_hir_symbol(old, before.symbols[id])
            hc_enc_hir_symbol(current, row)
            if not old.ok or not current.ok or old.finish() != current.finish(): return Err("nominal patch changed existing row")
        else:
            match row.kind:
                case SymbolKind.Struct | SymbolKind.Class | SymbolKind.Enum | SymbolKind.Trait: ()
                case _: return Err("nominal patch introduced non-type row")
            rows.push(row)
    if before.symbols.len() + rows.len() != after.symbols.len() or after.next_symbol_id < before.next_symbol_id:
        return Err("nominal patch dropped row/counter")
    var added: [text] = []
    for key in after.qualified_types.keys().sort():
        if before.qualified_types.has(key):
            if before.qualified_types[key] != after.qualified_types[key]: return Err("nominal patch changed qualified binding")
        else: added.push(key)
    if before.qualified_types.len() + added.len() != after.qualified_types.len(): return Err("nominal patch dropped binding")
    if rows.len() == 0 and added.len() == 0 and before.next_symbol_id == after.next_symbol_id: return Ok("")
    val base = hir_mono_symbol_projection_encode_v1(before, cohort)
    if base == "": return Err("nominal patch predecessor")
    var writer = HirCodecWriter.create()
    writer.put_text("hir-mono-symbol-patch-v1")
    writer.put_text(cohort)
    writer.put_text(sha256_text(base))
    writer.put_i64(after.next_symbol_id)
    writer.put_i64(rows.len())
    for row in rows: hc_enc_hir_symbol(writer, row)
    writer.put_i64(added.len())
    for key in added:
        writer.put_text(key)
        writer.put_i64(after.qualified_types[key])
    if not writer.ok: return Err("nominal patch encoding")
    Ok(writer.finish())

fn hir_mono_symbol_patch_apply_v1(table: SymbolTable, cohort: text, blob: text) -> Result<bool, text>:
    if transient_array_scope_state_v1() != 1: return Err("nominal patch requires active scope")
    var reader = FlatPoolReader.new(blob)
    if reader.decode_text(reader.next()) != "hir-mono-symbol-patch-v1" or reader.decode_text(reader.next()) != cohort or
            reader.decode_text(reader.next()) != sha256_text(hir_mono_symbol_projection_encode_v1(table, cohort)):
        return Err("nominal patch predecessor identity")
    val next = reader.next_i64()
    if next < table.next_symbol_id: return Err("nominal patch counter decreased")
    var rows: [HirSymbol] = []
    var ids: Dict<i64, bool> = {}
    var count = reader.next_len()
    var index = 0
    while index < count and reader.ok:
        val row = hc_dec_hir_symbol(reader)
        if row.id.id < 0 or row.id.id >= next or ids.has(row.id.id) or table.symbols.has(row.id.id) or
                table.structural_union_owners.has(row.id.id): return Err("nominal patch allocation collided")
        match row.kind:
            case SymbolKind.Struct | SymbolKind.Class | SymbolKind.Enum | SymbolKind.Trait: ()
            case _: return Err("nominal patch row is not a declaration")
        ids[row.id.id] = true
        rows.push(row)
        index = index + 1
    var qualified: Dict<text, i64> = {}
    count = reader.next_len()
    index = 0
    while index < count and reader.ok:
        val key = reader.decode_text(reader.next())
        val id = reader.next_i64()
        if table.qualified_types.has(key) or qualified.has(key) or (not ids.has(id) and not table.symbols.has(id)):
            return Err("nominal patch qualified binding collided")
        qualified[key] = id
        index = index + 1
    if not reader.ok or reader.pos != reader.lines.len() - 1 or reader.lines[reader.pos] != "":
        return Err("nominal patch framing")
    # Re-encode the complete proposed row delta before mutating the caller.
    # This preserves the existing legacy writer byte grammar exactly.
    val base = hir_mono_symbol_projection_encode_v1(table, cohort)
    val (_, proposed) = hir_mono_symbol_projection_decode_v1(base)?
    for row in rows: proposed.symbols[row.id.id] = row
    for key in qualified.keys(): proposed.qualified_types[key] = qualified[key]
    proposed.next_symbol_id = next
    val encoded = hir_mono_symbol_patch_encode_v1(table, proposed, cohort)
    if encoded.is_err() or encoded.unwrap() != blob: return Err("nominal patch stable bytes")
    for row in rows: table.symbols[row.id.id] = row
    for key in qualified.keys(): table.qualified_types[key] = qualified[key]
    table.next_symbol_id = next
    Ok(true)

export hir_mono_symbol_patch_encode_v1, hir_mono_symbol_patch_apply_v1
