# Stable scalar discriminants for HIR statements and the Return expression.
#
# Runtime enums use Rust DefaultHasher over the variant name, truncated to
# u32 (`src/compiler_rust/runtime/src/value/objects.rs::
# hash_variant_discriminant`). Production classification uses these constants
# so it never allocates a payload-bearing exemplar merely to discover a tag.
const HIR_STMT_EXPR_TAG: i64 = 4119164143
const HIR_STMT_LET_TAG: i64 = 2163764024
const HIR_STMT_ASSIGN_TAG: i64 = 3431341068
const HIR_STMT_BLOCK_TAG: i64 = 1138084884
const HIR_STMT_ASM_ASSERT_TAG: i64 = 4280943961
const HIR_STMT_SHARED_VAL_TAG: i64 = 1045008618
const HIR_STMT_SHARED_VAR_TAG: i64 = 3801833487
const HIR_STMT_GPU_LAUNCH_TAG: i64 = 3636881138
const HIR_EXPR_RETURN_TAG: i64 = 2311302677

export HIR_STMT_EXPR_TAG, HIR_STMT_LET_TAG, HIR_STMT_ASSIGN_TAG
export HIR_STMT_BLOCK_TAG, HIR_STMT_ASM_ASSERT_TAG, HIR_EXPR_RETURN_TAG
export HIR_STMT_SHARED_VAL_TAG, HIR_STMT_SHARED_VAR_TAG, HIR_STMT_GPU_LAUNCH_TAG
