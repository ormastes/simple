use compiler.hir.hir_types.{HirTypeKind, SymbolKind}

@unsafe(reason: "reads a concrete runtime enum discriminant for corrupt-carrier diagnostics", capabilities: [ffi])
extern fn rt_enum_discriminant<T>(value: T) -> i64
@unsafe(reason: "checks the runtime enum family before interpreting SymbolKind tags", capabilities: [ffi])
extern fn rt_enum_id<T>(value: T) -> i64

pub fn hir_type_kind_discriminant(value: HirTypeKind) -> i64:
    unsafe(capabilities: [ffi]):
        rt_enum_discriminant(value)

pub fn symbol_kind_discriminant(value: SymbolKind) -> i64:
    unsafe(capabilities: [ffi]):
        rt_enum_discriminant(value)

pub fn symbol_kind_has_carrier_owner(value: SymbolKind) -> bool:
    val expected = unsafe(capabilities: [ffi]):
        rt_enum_id(SymbolKind.Function)
    val actual = unsafe(capabilities: [ffi]):
        rt_enum_id(value)
    expected > 0 and actual == expected
