# W-CHAR-INT-CONTEXT: a `char` used where an integer is expected (ADR-005)
#
# `text[i]` yields a `char`. `c + 1`, `h * 31 + s[i]` and the integer-parse
# conversions (`s[i].to_i64()`) are the silent-zero family: a char has no
# implicit integer value, the code point is `c.ord()` / `c as i64` and the
# digit value is `c.to_digit()`. Staged like W-CHAR-CONDITION: mode `warn`
# (default) | `error`. Precedence: SIMPLE_SAFETY_PROFILE=critical|verified >
# env SIMPLE_CHAR_INT_CONTEXT=error > default warn. Flip tracked by bug row
# text_index_char_int_context_warning_to_error_2026-11-03.

pub fn ci_code() -> text:
    "W-CHAR-INT-CONTEXT"

pub fn ci_error_code() -> text:
    "E-CHAR-INT-CONTEXT"

pub fn ci_code_for(mode: text) -> text:
    if mode == "error":
        return ci_error_code()
    ci_code()

# ADR-005 promotion gate: the ONE switch point for the default mode.
# Flip to "error" only when Windows, macOS and Linux each have an admitted
# self-hosted Simple binary (bug text_index_char_int_context_warning_to_error_2026-11-03).
pub fn ci_default_mode() -> text:
    "warn"

pub fn ci_message(mode: text, line: i64, col: i64, what: text) -> text:
    "{ci_code_for(mode)}: a char has no integer value (`{what}`) at {line}:{col}; help: use `.ord()` or `as i64` for the code point, `.to_digit()` for the digit value"

pub fn ci_env_name() -> text:
    "SIMPLE_CHAR_INT_CONTEXT"

pub fn ci_mode_resolve(env: text, profile: text) -> text:
    """Pure precedence: critical/verified profile > env (warn|error) > ci_default_mode()."""
    val p = profile.trim().lower()
    if p == "critical" or p == "verified":
        return "error"
    val e = env.trim().lower()
    if e == "error" or e == "warn":
        return e
    ci_default_mode()

pub fn ci_is_int_conversion_method(name: text) -> bool:
    """Integer-parse conversions that `char` does not have (ADR-005 item 4)."""
    name == "to_i64" or name == "to_int" or name == "to_i32" or name == "to_u8" or name == "to_u32" or name == "to_u64" or name == "to_f64"
