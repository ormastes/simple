# W-CHAR-CONDITION: a `char` used as a condition (ADR-005)
#
# `if c:`, `elif c:`, `while c:`, `not c`, `c and x`, `x or c` are type errors:
# a char has no truthiness (the runtimes fail closed). Staged like
# E-MATCH-NONEXHAUSTIVE-VALUE: mode `warn` (default) | `error`. Precedence:
# SIMPLE_SAFETY_PROFILE=critical|verified > env SIMPLE_CHAR_CONDITION=error >
# default warn. Flip tracked by bug row char_condition_type_check_staged_2026-11-03.
# (The inference-time bool unification in 30.types already rejects a char
# condition when inference runs; this HIR check covers the lowering path.)

use compiler.hir.hir_types.{HirType, HirTypeKind}

pub fn cc_code() -> text:
    "W-CHAR-CONDITION"

pub fn cc_error_code() -> text:
    "E-CHAR-CONDITION"

pub fn cc_code_for(mode: text) -> text:
    if mode == "error":
        return cc_error_code()
    cc_code()

# ADR-005 promotion gate: the ONE switch point for the default mode.
# Flip to "error" only when Windows, macOS and Linux each have an admitted
# self-hosted Simple binary (bug char_condition_type_check_staged_2026-11-03).
pub fn cc_default_mode() -> text:
    "warn"

pub fn cc_message(mode: text, line: i64, col: i64) -> text:
    "{cc_code_for(mode)}: a char has no truthiness at {line}:{col}; help: compare explicitly, e.g. `c != '\\0'` or `c == 'a'`"

pub fn cc_env_name() -> text:
    "SIMPLE_CHAR_CONDITION"

pub fn cc_mode_resolve(env: text, profile: text) -> text:
    """Pure precedence: critical/verified profile > env (warn|error) > cc_default_mode()."""
    val p = profile.trim().lower()
    if p == "critical" or p == "verified":
        return "error"
    val e = env.trim().lower()
    if e == "error" or e == "warn":
        return e
    cc_default_mode()

pub fn cc_is_char_type(t: HirType) -> bool:
    match t.kind:
        case HirTypeKind.Char: true
        case _: false
