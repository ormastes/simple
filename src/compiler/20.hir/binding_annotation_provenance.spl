# Exact local declaration provenance. Absence is unknown, never inferred.
use compiler.hir.hir_types.{HirModule, SymbolId}

# 1 = written annotation, 0 = inferred declaration, -1 = unknown producer.
pub fn hir_local_annotation_state(module: HirModule, symbol: SymbolId) -> i64:
    if not module.local_annotation_provenance.contains_key(symbol.id): return -1
    if module.local_annotation_provenance[symbol.id]: 1 else: 0

pub fn hir_local_annotation_copy(source: Dict<i64, bool>) -> Dict<i64, bool>:
    var copied: Dict<i64, bool> = {}
    for key in source.keys():
        copied[key] = source[key]
    copied
