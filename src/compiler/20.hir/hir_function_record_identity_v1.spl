# One identity owner for complete actual generated HIR function records.
# Existing mono record consumers and MIR projections use the same byte domain.
use compiler.hir.hir_definitions.{HirFunction}
use compiler.hir.hir_codec_support.{HirCodecWriter}
use compiler.hir.generated.hir_codec.{hc_enc_hir_function}
use std.common.crypto.sha256.{sha256_text}

fn mono_complete_function_digest_v1(function: HirFunction) -> text:
    var writer = HirCodecWriter.create()
    hc_enc_hir_function(writer, function)
    if not writer.ok: return ""
    sha256_text("mono-complete-function-v1\n" + writer.finish())

export mono_complete_function_digest_v1
