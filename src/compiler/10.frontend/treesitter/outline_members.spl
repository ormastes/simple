# TreeSitter Outline Members - Enum/Bitfield/Trait/Impl/TypeAlias/Const Parsers
#
# Handles parsing of:
# - enum outlines and variants
# - bitfield outlines and fields
# - trait outlines
# - impl block outlines
# - type alias outlines
# - constant/variable outlines
# - static assert outlines
# - integer literal helper
#
# Split from outline_decls.spl for modularity.

use compiler.frontend.core.lexer.*
use compiler.frontend.lexer_types.{TokenKind}
use compiler.frontend.treesitter_types.*
use compiler.common.dependency.visibility.{Visibility}
use compiler.frontend.block_types.{span_empty, span_new}
use compiler.frontend.treesitter.outline_lexer.{TreeSitter}
use compiler.frontend.treesitter.outline_types.{merge_spans}

fn methods_push(methods: [FunctionOutline], item: FunctionOutline) -> [FunctionOutline]:
        methods.push(item)

fn fields_push(fields: [FieldOutline], item: FieldOutline) -> [FieldOutline]:
        fields.push(item)

fn variants_push(vars: [VariantOutline], item: VariantOutline) -> [VariantOutline]:
        vars.push(item)

fn variantpayload_Tuple(types: [TypeOutline]) -> VariantPayload:
        VariantPayload.Tuple(types)

fn variantpayload_Struct(fields: [FieldOutline]) -> VariantPayload:
        VariantPayload.Struct(fields)

fn types_push(types: [TypeOutline], item: TypeOutline) -> [TypeOutline]:
        types.push(item)

fn is_none(v: Any) -> bool:
        v == nil
use compiler.frontend.treesitter.outline_types.*
use compiler.frontend.treesitter.outline_decls.*

# ============================================================================
# Enum Parsing
# ============================================================================

me treesitter_parse_enum_outline(self: TreeSitter, visibility: Visibility, doc: text?) -> EnumOutline:
        """Parse enum outline."""
        val start = self.current.span
        self.treesitter_advance()  # Consume 'enum'

        val name = self.treesitter_parse_identifier()
        val type_params = self.treesitter_parse_optional_type_params()

        self.treesitter_expect(TokenKind.Colon, "expected ':' after enum name")
        self.treesitter_skip_newlines()
        self.treesitter_expect(TokenKind.Indent, "expected indented enum body")

        # Try to parse body docstring (triple-quoted string after indent)
        val body_doc = self.treesitter_try_parse_body_docstring()
        val final_doc = body_doc ?? doc

        var variants: [VariantOutline] = []

        while not self.treesitter_check(TokenKind.Dedent) and not self.treesitter_is_at_end():
            self.treesitter_skip_newlines()
            if self.treesitter_check(TokenKind.Dedent):
                break

            if self.treesitter_check(TokenKind.Ident):
                variants = variants_push(variants, self.treesitter_parse_variant_outline())
            else:
                self.treesitter_error("expected variant in enum")
                self.treesitter_synchronize()
        self.treesitter_match_token(TokenKind.Dedent)

        EnumOutline(
            name: name,
            type_params: type_params,
            variants: variants,
            visibility: visibility,
            is_public: visibility == Visibility.Public,
            doc_comment: final_doc,
            span: merge_spans(start, self.previous.span)
        )


me treesitter_parse_variant_outline(self: TreeSitter) -> VariantOutline:
        """Parse enum variant."""
        val start = self.current.span
        val name = self.treesitter_parse_identifier()

        var payload: VariantPayload = nil

        if self.treesitter_match_token(TokenKind.LParen):
            # Tuple variant
            var types: [TypeOutline] = []
            if not self.treesitter_check(TokenKind.RParen):
                types = types_push(types, self.treesitter_parse_type_outline())
                while self.treesitter_match_token(TokenKind.Comma):
                    if self.treesitter_check(TokenKind.RParen):
                        break
                    types = types_push(types, self.treesitter_parse_type_outline())
            self.treesitter_expect(TokenKind.RParen, "expected ')' after variant types")
            payload = variantpayload_Tuple(types)
        elif self.treesitter_match_token(TokenKind.LBrace):
            # Struct variant
            var fields: [FieldOutline] = []
            if not self.treesitter_check(TokenKind.RBrace):
                fields = fields_push(fields, self.treesitter_parse_field_outline(Visibility.Private))
                while self.treesitter_match_token(TokenKind.Comma):
                    if self.treesitter_check(TokenKind.RBrace):
                        break
                    fields = fields_push(fields, self.treesitter_parse_field_outline(Visibility.Private))
            self.treesitter_expect(TokenKind.RBrace, "expected '}' after variant fields")
            payload = variantpayload_Struct(fields)

        # Outline parsing does not retain expressions, but it must consume an
        # explicit discriminant so the next variant stays synchronized.
        if self.treesitter_match_token(TokenKind.Assign):
            self.treesitter_skip_expression()

        self.treesitter_skip_newlines()

        VariantOutline(
            name: name,
            payload: payload,
            span: merge_spans(start, self.previous.span)
        )


# ============================================================================
# Bitfield Parsing
# ============================================================================

me treesitter_parse_bitfield_outline(self: TreeSitter, visibility: Visibility, doc: text, attrs: [AttributeOutline]) -> BitfieldOutline:
        """Parse bitfield outline.

        Syntax: bitfield Name(BackingType):
            field1: Type
            field2: Type @bits(N)
            _reserved: N
        """
        val start = self.current.span
        self.treesitter_advance()  # Consume 'bitfield'

        val name = self.treesitter_parse_identifier()

        # Parse backing type: bitfield Name(u32):
        self.treesitter_expect(TokenKind.LParen, "expected '(' after bitfield name")
        val backing_type = self.treesitter_parse_type_outline()
        self.treesitter_expect(TokenKind.RParen, "expected ')' after backing type")

        self.treesitter_expect(TokenKind.Colon, "expected ':' after bitfield declaration")
        self.treesitter_skip_newlines()
        self.treesitter_expect(TokenKind.Indent, "expected indented bitfield body")

        # Try to parse body docstring
        val body_doc = self.treesitter_try_parse_body_docstring()
        val final_doc = body_doc ?? doc

        var fields: [BitfieldFieldOutline] = []

        while not self.treesitter_check(TokenKind.Dedent) and not self.treesitter_is_at_end():
            self.treesitter_skip_newlines()
            if self.treesitter_check(TokenKind.Dedent):
                break

            if self.treesitter_check(TokenKind.Ident):
                fields = fields_push(fields, self.treesitter_parse_bitfield_field_outline())
            else:
                self.treesitter_error("expected field in bitfield")
                self.treesitter_synchronize()

        self.treesitter_match_token(TokenKind.Dedent)

        BitfieldOutline(
            name: name,
            backing_type: backing_type,
            fields: fields,
            visibility: visibility,
            is_public: visibility == Visibility.Public,
            doc_comment: final_doc,
            attributes: attrs,
            span: merge_spans(start, self.previous.span)
        )


me treesitter_parse_bitfield_field_outline(self: TreeSitter) -> BitfieldFieldOutline:
        """Parse bitfield field.

        Formats:
        - name: Type              -> regular field (bits inferred)
        - name: Type @bits(N)     -> field with explicit bit width
        - _reserved: N            -> reserved bits (no type)
        """
        val start = self.current.span
        val name = self.treesitter_parse_identifier()

        # Check for reserved field pattern: _reserved: 8
        val is_reserved = name.starts_with("_")

        self.treesitter_expect(TokenKind.Colon, "expected ':' after field name")

        var type_: TypeOutline = nil
        var bits: i64 = nil

        if is_reserved:
            # Reserved field: expect just a number
            if self.treesitter_check(TokenKind.IntLit):
                bits = self.treesitter_parse_int_literal()
            else:
                # Allow type for reserved fields too
                type_ = self.treesitter_parse_type_outline()
        else:
            # Regular field: parse type
            type_ = self.treesitter_parse_type_outline()

            # Check for @bits(N) attribute
            if self.treesitter_check(TokenKind.At):
                self.treesitter_advance()  # consume '@'
                if self.treesitter_check(TokenKind.Ident):
                    if self.current.text == "bits":
                        self.treesitter_advance()  # consume 'bits'
                        self.treesitter_expect(TokenKind.LParen, "expected '(' after @bits")
                        if self.treesitter_check(TokenKind.IntLit):
                            bits = self.treesitter_parse_int_literal()
                        self.treesitter_expect(TokenKind.RParen, "expected ')' after bit count")

        self.treesitter_skip_newlines()

        BitfieldFieldOutline(
            name: name,
            type_: type_,
            bits: bits,
            is_reserved: is_reserved,
            span: merge_spans(start, self.previous.span)
        )


me treesitter_parse_int_literal(self: TreeSitter) -> i64:
        """Parse integer literal and return its value."""
        val text = self.current.text
        self.treesitter_advance()
        # Simple integer parsing - handle both decimal and hex
        if text.starts_with("0x") or text.starts_with("0X"):
            text[2:].parse_int_radix(16) ?? 0
        else:
            text.parse_int() ?? 0


# ============================================================================
# Trait / Impl Parsing
# ============================================================================

me treesitter_parse_trait_outline(self: TreeSitter, visibility: Visibility, doc: text?) -> TraitOutline:
        """Parse trait outline."""
        val start = self.current.span
        self.treesitter_advance()  # Consume 'trait'

        val name = self.treesitter_parse_identifier()
        val type_params = self.treesitter_parse_optional_type_params()

        self.treesitter_expect(TokenKind.Colon, "expected ':' after trait name")
        self.treesitter_skip_newlines()
        self.treesitter_expect(TokenKind.Indent, "expected indented trait body")

        # Try to parse body docstring (triple-quoted string after indent)
        val body_doc = self.treesitter_try_parse_body_docstring()
        val final_doc = body_doc ?? doc

        var methods: [FunctionOutline] = []
        var assoc_types: [AssocTypeDeclOutline] = []

        while not self.treesitter_check(TokenKind.Dedent) and not self.treesitter_is_at_end():
            self.treesitter_skip_newlines()
            if self.treesitter_check(TokenKind.Dedent):
                break

            val method_doc = self.treesitter_take_doc_comment()
            val method_visibility = self.treesitter_parse_visibility()

            match self.treesitter_peek():
                case KwFn:
                    methods = methods_push(methods, self.treesitter_parse_function_outline(method_visibility, false, method_doc))
                case KwMe:
                    methods = methods_push(methods, self.treesitter_parse_function_outline(method_visibility, true, method_doc))
                case KwVar:
                    # Check for deprecated 'var fn' syntax
                    self.treesitter_advance()  # consume 'var'
                    if self.treesitter_check(TokenKind.KwFn):
                        self.treesitter_warning("Deprecated: Replace `var fn method()` with `me method()`")
                        methods = methods_push(methods, self.treesitter_parse_function_outline(method_visibility, true, method_doc))
                    else:
                        self.treesitter_error("expected method or type in trait")
                        self.treesitter_synchronize()
                case KwType:
                    assoc_types = assoc_types.push(self.treesitter_parse_assoc_type_outline())
                case _:
                    self.treesitter_error("expected method or type in trait")
                    self.treesitter_synchronize()

        self.treesitter_match_token(TokenKind.Dedent)

        TraitOutline(
            name: name,
            type_params: type_params,
            methods: methods,
            assoc_types: assoc_types,
            visibility: visibility,
            is_public: visibility == Visibility.Public,
            doc_comment: final_doc,
            span: merge_spans(start, self.previous.span)
        )


me treesitter_parse_impl_outline(self: TreeSitter) -> ImplOutline:
        """Parse impl block outline."""
        val start = self.current.span
        self.treesitter_advance()  # Consume 'impl'

        val type_ = self.treesitter_parse_type_outline()

        var trait_: TypeOutline = nil
        if self.treesitter_match_token(TokenKind.Colon):
            # impl Type: Trait
            if not self.treesitter_check(TokenKind.Indent):
                if not self.treesitter_check(TokenKind.Newline):
                    trait_ = self.treesitter_parse_type_outline()

        if trait_ == nil:
            self.treesitter_expect(TokenKind.Colon, "expected ':' after impl type")
        self.treesitter_skip_newlines()
        self.treesitter_expect(TokenKind.Indent, "expected indented impl body")

        # Skip optional body docstring (triple-quoted string after indent)
        # Note: impl blocks don't store doc comments, so we discard it
        self.treesitter_try_parse_body_docstring()

        var methods: [FunctionOutline] = []
        var assoc_types: [AssocTypeDeclOutline] = []

        while not self.treesitter_check(TokenKind.Dedent) and not self.treesitter_is_at_end():
            self.treesitter_skip_newlines()
            if self.treesitter_check(TokenKind.Dedent):
                break

            val method_doc = self.treesitter_take_doc_comment()
            val method_visibility = self.treesitter_parse_visibility()

            match self.treesitter_peek():
                case KwFn:
                    val m = self.treesitter_parse_function_outline(method_visibility, false, method_doc)
                    methods = methods_push(methods, functionoutline_as_method(m))
                case KwMe:
                    val m = self.treesitter_parse_function_outline(method_visibility, true, method_doc)
                    methods = methods_push(methods, functionoutline_as_method(m))
                case KwVar:
                    # Check for deprecated 'var fn' syntax
                    self.treesitter_advance()  # consume 'var'
                    if self.treesitter_check(TokenKind.KwFn):
                        self.treesitter_warning("Deprecated: Replace `var fn method()` with `me method()`")
                        val m = self.treesitter_parse_function_outline(method_visibility, true, method_doc)
                        methods = methods_push(methods, functionoutline_as_method(m))
                    else:
                        self.treesitter_error("expected method or type in impl")
                        self.treesitter_synchronize()
                case KwStatic:
                    self.treesitter_advance()
                    val m = self.treesitter_parse_function_outline(method_visibility, false, method_doc)
                    methods = methods_push(methods, functionoutline_as_static(m))
                case KwType:
                    assoc_types = assoc_types.push(self.treesitter_parse_assoc_type_outline())
                case _:
                    self.treesitter_error("expected method or type in impl")
                    self.treesitter_synchronize()

        self.treesitter_match_token(TokenKind.Dedent)

        ImplOutline(
            type_: type_,
            trait_: trait_,
            methods: methods,
            assoc_types: assoc_types,
            span: merge_spans(start, self.previous.span)
        )


# ============================================================================
# Associated Type Declarations (in traits/impls)
# ============================================================================

me treesitter_parse_assoc_type_outline(self: TreeSitter) -> AssocTypeDeclOutline:
        """Parse associated type declaration in trait or impl body.

        Syntax:
            type Item                   # No bounds, no default
            type Output: Display        # With bound
            type Index = i64            # With default / concrete type
        """
        val start = self.current.span
        self.treesitter_advance()  # Consume 'type'

        val name = self.treesitter_parse_identifier()

        # Parse optional bounds (: Trait1 + Trait2)
        # Distinguish `type Item: Display` (bound) from just `type Item` followed by newline
        var bounds: [TypeOutline] = []
        if self.treesitter_match_token(TokenKind.Colon):
            if self.treesitter_check(TokenKind.Ident):
                bounds = bounds.push(self.treesitter_parse_type_outline())
                while self.treesitter_match_token(TokenKind.Plus):
                    bounds = bounds.push(self.treesitter_parse_type_outline())
            else:
                self.treesitter_error("expected type bound after ':'")

        # Parse optional default/concrete type (= Type)
        var default_type: TypeOutline = nil
        if self.treesitter_match_token(TokenKind.Assign):
            default_type = self.treesitter_parse_type_outline()

        self.treesitter_skip_newlines()

        AssocTypeDeclOutline(
            name: name,
            bounds: bounds,
            default: default_type,
            span: merge_spans(start, self.previous.span)
        )

# ============================================================================
# Type Alias / Const / Static Assert
# ============================================================================

me treesitter_parse_type_alias_outline(self: TreeSitter, visibility: Visibility) -> TypeAliasOutline:
        """Parse type alias."""
        val start = self.current.span
        self.treesitter_advance()  # Consume 'type'

        val name = self.treesitter_parse_identifier()
        val type_params = self.treesitter_parse_optional_type_params()

        self.treesitter_expect(TokenKind.Assign, "expected '=' after type alias name")
        val type_ = self.treesitter_parse_type_outline()
        self.treesitter_skip_newlines()

        TypeAliasOutline(
            name: name,
            type_params: type_params,
            type_: type_,
            visibility: visibility,
            is_public: visibility == Visibility.Public,
            span: merge_spans(start, self.previous.span)
        )


me treesitter_parse_const_outline(self: TreeSitter, visibility: Visibility, attrs: [AttributeOutline]) -> ConstOutline:
        """Parse module-level constant.

        Supports:
        - val name: Type = value
        - @volatile val name: Type @ 0x40020000
        """
        val start = self.current.span
        val is_mutable = self.treesitter_check(TokenKind.KwVar)
        self.treesitter_advance()  # Consume 'val' or 'var'

        val name = self.treesitter_parse_identifier()

        var type_: TypeOutline = nil
        if self.treesitter_match_token(TokenKind.Colon):
            type_ = self.treesitter_parse_type_outline()

        # Check for @volatile in attributes
        var is_volatile = false
        for attr in attrs:
            if attr.name == "volatile":
                is_volatile = true
                break

        # Check for @ address syntax (memory-mapped variable)
        var address_span: LexSpan = nil
        if self.treesitter_check(TokenKind.At):
            self.treesitter_advance()  # consume '@'
            val addr_start = self.current.span.start
            self.treesitter_skip_expression()
            address_span = lex_span_new(addr_start, self.previous.span.end_pos, 0, 0)
            # Memory-mapped variables are implicitly volatile
            is_volatile = true

        # Value is optional for memory-mapped variables
        var value_span = span_empty()
        if self.treesitter_match_token(TokenKind.Assign):
            val value_start = self.current.span.start
            self.treesitter_skip_expression()
            value_span = lex_span_new(value_start, self.previous.span.end_pos, 0, 0)

        self.treesitter_skip_newlines()

        ConstOutline(
            name: name,
            type_: type_,
            is_mutable: is_mutable,
            visibility: visibility,
            is_public: visibility == Visibility.Public,
            is_volatile: is_volatile,
            address_span: address_span,
            value_span: value_span,
            span: merge_spans(start, self.previous.span)
        )


me treesitter_parse_static_assert_outline(self: TreeSitter) -> StaticAssertOutline:
        """Parse static assertion outline.

        Syntax:
            static assert <condition>
            static assert <condition>  # message
        """
        val start = self.current.span  # Current token is 'assert'
        self.treesitter_advance()  # Consume 'assert'

        # Parse condition expression
        val condition_start = self.current.span.start
        self.treesitter_skip_expression()
        val condition_span = lex_span_new(condition_start, self.previous.span.end_pos, 0, 0)

        # Optional error message after comma
        var message: text = nil
        if self.treesitter_match_token(TokenKind.Comma):
            if self.treesitter_check(TokenKind.StringLit):
                message = self.current.text
                self.treesitter_advance()

        self.treesitter_skip_newlines()

        StaticAssertOutline(
            condition_span: condition_span,
            message: message,
            span: merge_spans(start, self.previous.span)
        )


# ============================================================================
# Exports
# ============================================================================
