# TreeSitter Outline Types - Type Outline Parsing
#
# Handles parsing of type expressions:
# named types, tuple types, array types, function types,
# reference types, atomic types, isolated types, optional types.
#
# Split from outline.spl for modularity.

use compiler.frontend.core.lexer.*
use compiler.frontend.lexer_types.{TokenKind}
use compiler.frontend.treesitter_types.*
use compiler.frontend.treesitter.outline_lexer.{TreeSitter}

fn typeoutlinekind_Optional(inner: TypeOutline) -> TypeOutlineKind:
        TypeOutlineKind.Optional(inner)

fn typeoutlinekind_Named(name: text, args: [TypeOutline]) -> TypeOutlineKind:
        TypeOutlineKind.Named(name, args)

fn typeoutlinekind_Tuple(elements: [TypeOutline]) -> TypeOutlineKind:
        TypeOutlineKind.Tuple(elements)

fn typeoutlinekind_Array(element: TypeOutline) -> TypeOutlineKind:
        TypeOutlineKind.Array(element)

fn typeoutlinekind_Function(params: [TypeOutline], ret: TypeOutline) -> TypeOutlineKind:
        TypeOutlineKind.Function(params, ret)

fn typeoutlinekind_Reference(inner: TypeOutline, mutable: bool) -> TypeOutlineKind:
        TypeOutlineKind.Reference(inner, mutable)

fn typeoutlinekind_Atomic(inner: TypeOutline) -> TypeOutlineKind:
        TypeOutlineKind.Atomic(inner)

fn typeoutlinekind_Isolated(inner: TypeOutline) -> TypeOutlineKind:
        TypeOutlineKind.Isolated(inner)

fn merge_spans(a: LexSpan, b: LexSpan) -> LexSpan:
        val start = if a.start < b.start: a.start else: b.start
        val end_ = if a.end_pos > b.end_pos: a.end_pos else: b.end_pos
        LexSpan(start: start, end_pos: end_, line: a.line, col: a.col)

fn args_push(args: [TypeOutline], item: TypeOutline) -> [TypeOutline]:
        args.push(item)

fn elements_push(elems: [TypeOutline], item: TypeOutline) -> [TypeOutline]:
        elems.push(item)

fn params_push(params: [TypeOutline], item: TypeOutline) -> [TypeOutline]:
        params.push(item)

# ============================================================================
# Type Outline Parsing
# ============================================================================

me treesitter_parse_type_outline(self: TreeSitter) -> TypeOutline:
        """Parse a type expression."""
        val start = self.current.span
        var type_ = self.treesitter_parse_primary_type()

        # Optional suffix
        if self.treesitter_match_token(TokenKind.Question):
            type_ = TypeOutline(
                kind: typeoutlinekind_Optional(type_),
                span: merge_spans(start, self.previous.span)
            )

        type_


me treesitter_parse_primary_type(self: TreeSitter) -> TypeOutline:
        """Parse primary type expression."""
        val start = self.current.span

        match self.treesitter_peek():
            case Ident:
                self.treesitter_parse_named_type()
            case LParen:
                self.treesitter_parse_tuple_type()
            case LBracket:
                self.treesitter_parse_array_type()
            case KwFn:
                self.treesitter_parse_function_type()
            case Ampersand:
                self.treesitter_parse_reference_type()
            case At:
                self.treesitter_parse_atomic_type()
            case Tilde:
                self.treesitter_parse_isolated_type()
            case Underscore:
                self.treesitter_advance()
                TypeOutline(kind: TypeOutlineKind.Infer, span: start)
            case _:
                self.treesitter_error("expected type")
                TypeOutline(kind: TypeOutlineKind.Infer, span: start)


me treesitter_parse_named_type(self: TreeSitter) -> TypeOutline:
        """Parse named type with optional type arguments."""
        val start = self.current.span
        val name = self.treesitter_parse_identifier()

        var args: [TypeOutline] = []
        if self.treesitter_match_token(TokenKind.Lt):
            if not self.treesitter_check(TokenKind.Gt):
                args = args_push(args, self.treesitter_parse_type_outline())
                while self.treesitter_match_token(TokenKind.Comma):
                    if self.treesitter_check(TokenKind.Gt):
                        break
                    args = args_push(args, self.treesitter_parse_type_outline())
            self.treesitter_expect(TokenKind.Gt, "expected '>' after type arguments")

        TypeOutline(
            kind: typeoutlinekind_Named(name, args),
            span: merge_spans(start, self.previous.span)
        )


me treesitter_parse_tuple_type(self: TreeSitter) -> TypeOutline:
        """Parse tuple type (A, B, C)."""
        val start = self.current.span
        self.treesitter_advance()  # Consume '('

        var elements: [TypeOutline] = []
        if not self.treesitter_check(TokenKind.RParen):
            elements = elements_push(elements, self.treesitter_parse_type_outline())
            while self.treesitter_match_token(TokenKind.Comma):
                if self.treesitter_check(TokenKind.RParen):
                    break
                elements = elements_push(elements, self.treesitter_parse_type_outline())

        self.treesitter_expect(TokenKind.RParen, "expected ')' after tuple type")

        TypeOutline(
            kind: typeoutlinekind_Tuple(elements),
            span: merge_spans(start, self.previous.span)
        )


me treesitter_parse_array_type(self: TreeSitter) -> TypeOutline:
        """Parse array type [T]."""
        val start = self.current.span
        self.treesitter_advance()  # Consume '['

        val element = self.treesitter_parse_type_outline()
        self.treesitter_expect(TokenKind.RBracket, "expected ']' after array element type")

        TypeOutline(
            kind: typeoutlinekind_Array(element),
            span: merge_spans(start, self.previous.span)
        )


me treesitter_parse_function_type(self: TreeSitter) -> TypeOutline:
        """Parse function type fn(A, B) -> C."""
        val start = self.current.span
        self.treesitter_advance()  # Consume 'fn'

        self.treesitter_expect(TokenKind.LParen, "expected '(' after 'fn'")
        var params: [TypeOutline] = []
        if not self.treesitter_check(TokenKind.RParen):
            params = params_push(params, self.treesitter_parse_type_outline())
            while self.treesitter_match_token(TokenKind.Comma):
                if self.treesitter_check(TokenKind.RParen):
                    break
                params = params_push(params, self.treesitter_parse_type_outline())
        self.treesitter_expect(TokenKind.RParen, "expected ')' after function parameters")

        var ret = TypeOutline(kind: TypeOutlineKind.Named("()", []), span: start)
        if self.treesitter_match_token(TokenKind.Arrow):
            ret = self.treesitter_parse_type_outline()

        TypeOutline(
            kind: typeoutlinekind_Function(params, ret),
            span: merge_spans(start, self.previous.span)
        )


me treesitter_parse_reference_type(self: TreeSitter) -> TypeOutline:
        """Parse reference type &T or &mut T."""
        val start = self.current.span
        self.treesitter_advance()  # Consume '&'

        var mutable = false
        if self.treesitter_check(TokenKind.Ident):
            if self.current.text == "mut":
                self.treesitter_advance()
                mutable = true

        val inner = self.treesitter_parse_type_outline()

        TypeOutline(
            kind: typeoutlinekind_Reference(inner, mutable),
            span: merge_spans(start, self.previous.span)
        )


me treesitter_parse_atomic_type(self: TreeSitter) -> TypeOutline:
        """Parse atomic type @T (Arc - atomic ref-counted)."""
        val start = self.current.span
        self.treesitter_advance()  # Consume '@'
        val inner = self.treesitter_parse_type_outline()
        TypeOutline(
            kind: typeoutlinekind_Atomic(inner),
            span: merge_spans(start, self.previous.span)
        )


me treesitter_parse_isolated_type(self: TreeSitter) -> TypeOutline:
        """Parse isolated type bitwise_not(T) (iso - isolated capability)."""
        val start = self.current.span
        self.treesitter_advance()  # Consume '~'
        val inner = self.treesitter_parse_type_outline()
        TypeOutline(
            kind: typeoutlinekind_Isolated(inner),
            span: merge_spans(start, self.previous.span)
        )


# ============================================================================
# Exports
# ============================================================================
