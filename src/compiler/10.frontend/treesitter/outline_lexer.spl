# TreeSitter Outline Lexer - TreeSitter Struct & Token Handling
#
# Defines the TreeSitter struct and core token-level operations:
# constructors, advance, peek, check, match, expect, is_at_end.
#
# Split from outline.spl for modularity.

use compiler.frontend.core.lexer.*
use compiler.frontend.lexer_types.{TokenKind}
use compiler.frontend.core.lexer_types.{lex_token_eof}
use compiler.frontend.treesitter_types.*
use compiler.frontend.block_types.{PreLexInfo, BlockSkipPolicy, BlockOutlineInfo}
use compiler.blocks.blocks.registry.{BlockRegistry, block_registry}

# ============================================================================
# TreeSitter Parser
# ============================================================================

struct TreeSitter:
    """Outline parser for Simple source code."""
    lexer: Lexer
    current: Token
    previous: Token
    errors: [ParseError]
    source: text
    # # DESUGARED: doc_comment: text
    has_doc_comment: bool
    doc_comment: text
    inline_blocks: [BlockOutline]  # Blocks found while skipping expressions
    asm_blocks: [AsmBlockOutline]  # Inline asm found while skipping function bodies
    # # DESUGARED: current_context: text
    has_current_context: bool
    current_context: text
    fast_mode: bool         # If true, skip Skippable blocks and only outline OutlineRequired
    heuristic_mode: bool    # If true, use line-based error-tolerant parsing instead of lexer
    # # DESUGARED: registry: BlockRegistry
    has_registry: bool
    registry: BlockRegistry


# ============================================================================
# TreeSitter Methods (was: impl TreeSitter:)
# ============================================================================

fn treesitter_new(source: text) -> TreeSitter:
        val lexer = lexer_new(source)
        var ts = TreeSitter(
            lexer: lexer,
            current: lex_token_eof(1),
            previous: lex_token_eof(1),
            errors: [],
            source: source,
            doc_comment: nil,
            inline_blocks: [],
            asm_blocks: [],
            current_context: nil,
            fast_mode: false,
            heuristic_mode: false,
            registry: nil
        )
        ts_advance(ts)  # Prime the parser
        ts


fn treesitter_with_fast_mode(fast_mode: bool) -> TreeSitter:
        """Create a TreeSitter with fast_mode setting.

        In fast mode, Skippable blocks are stored as opaque outlines,
        and only OutlineRequired blocks get treesitter_outline called.
        """
        val lexer = Lexer.new("")
        TreeSitter(
            lexer: lexer,
            current: lex_token_eof(1),
            previous: lex_token_eof(1),
            errors: [],
            source: "",
            #  # DESUGARED: doc_comment: nil
            inline_blocks: [],
            asm_blocks: [],
            #  # DESUGARED: current_context: nil
            fast_mode: fast_mode,
            heuristic_mode: false,
            # # DESUGARED: registry: Some(block_registry())
            registry: block_registry()
        )


fn treesitter_with_heuristic_mode(enabled: bool) -> TreeSitter:
        """Create TreeSitter with heuristic mode for error-tolerant parsing.

        Heuristic mode uses line-based scanning instead of full lexer tokenization.
        Always produces results, even with syntax errors.
        Ideal for LSP/IDE use where speed and tolerance matter more than accuracy.
        """
        val lexer = Lexer.new("")
        TreeSitter(
            lexer: lexer,
            current: lex_token_eof(1),
            previous: lex_token_eof(1),
            errors: [],
            source: "",
            #  # DESUGARED: doc_comment: nil
            inline_blocks: [],
            asm_blocks: [],
            #  # DESUGARED: current_context: nil
            fast_mode: false,
            heuristic_mode: enabled,
            registry: nil
        )


fn treesitter_with_source(self: TreeSitter, source: text) -> TreeSitter:
        var next = self
        next.lexer = lexer_new(source)
        next.source = source
        next.advance()
        next


me treesitter_advance(self: TreeSitter) -> Token:
        """Advance to next token."""
        self.previous = self.current

        # Copy-modify-reassign: nested field mutations don't propagate in interpreter
        var lexer = self.lexer
        self.current = lexer_next_token(lexer)

        # Accumulate doc comments
        # Guard against EOF and nil tokens before checking text
        while self.current.kind == TokenKind.Ident:
            if not self.current.text.starts_with("##"):
                break
            val comment = self.current.text[2:].trim()
            if self.has_doc_comment:
                self.doc_comment = self.doc_comment + "\n" + comment
            else:
                self.has_doc_comment = true
                self.doc_comment = comment
            self.current = lexer_next_token(lexer)

        self.lexer = lexer
        self.previous

fn ts_advance(ts: TreeSitter) -> Token:
        treesitter_advance(ts)


fn treesitter_peek(self: TreeSitter) -> TokenKind:
        """Peek at current token kind."""
        self.current.kind


fn treesitter_check(self: TreeSitter, kind: TokenKind) -> bool:
        """Check if current token matches kind."""
        self.current.kind == kind


me treesitter_match_token(self: TreeSitter, kind: TokenKind) -> bool:
        """Match and consume token if it matches."""
        if self.treesitter_check(kind):
            self.treesitter_advance()
            true
        else:
            false


me treesitter_expect(self: TreeSitter, kind: TokenKind, message: text) -> bool:
        """Expect a token, report error if not found."""
        if self.current.kind == kind:
            self.treesitter_advance()
            true
        else:
            self.treesitter_error(message)
            false


fn treesitter_is_at_end(self: TreeSitter) -> bool:
        """Check if at end of input (Eof or nil token)."""
        # `Token.kind` carries the RAW CoreLexer numeric kind, NOT a TokenKind
        # ordinal. That numeric space is fixed by lexer_types.spl: lex_token_eof
        # builds `lex_token_new(190, ...)`, lex_token_error uses 191, and
        # token_is_keyword tests `kind >= 20 and kind <= 59`. lex_next() also
        # returns 190 when it fails closed on a dead lexer.
        #
        # TokenKind, by contrast, is a bare positional enum: 142 variants, so
        # its ordinals only span 0..141 and Eof's is 133. The raw Eof value 190
        # is therefore unreachable by ANY TokenKind ordinal, and the original
        # `kind == TokenKind.Eof` could never be true for a token produced by
        # lexer_next_token. The outline parser's top-level loop in outline.spl
        # (`while not self.treesitter_is_at_end()`) consequently had an exit
        # condition that could never be reached: it spun forever, burning CPU
        # at flat RSS with zero I/O, on every file that takes the
        # outline-authority path. See
        # doc/08_tracking/bug/outline_authority_parse_spin_treesitter_2026-08-23.md.
        #
        # Testing the raw value is what makes the loop terminable. The
        # TokenKind comparison is kept alongside it so a Token that does carry
        # an ordinal is still recognised: this is strictly additive, so it can
        # neither make a previously-terminating parse spin nor cause a token to
        # be skipped.
        val kind = self.current.kind
        kind == 190 or kind == TokenKind.Eof


me treesitter_error(self: TreeSitter, message: text):
        self.errors = self.errors.push(ParseError(
            message: message,
            span: self.current.span,
            severity: ErrorSeverity.Error
        ))


me treesitter_warning(self: TreeSitter, message: text):
        self.errors = self.errors.push(ParseError(
            message: message,
            span: self.current.span,
            severity: ErrorSeverity.Warning
        ))


me treesitter_skip_newlines(self: TreeSitter):
        while self.treesitter_check(TokenKind.Newline):
            self.treesitter_advance()


me treesitter_take_doc_comment(self: TreeSitter) -> text?:
        val doc = self.doc_comment
        self.doc_comment = nil
        doc


me treesitter_try_parse_body_docstring(self: TreeSitter) -> text?:
        if self.treesitter_check(TokenKind.StringLit):
            val doc = self.current.text
            self.treesitter_advance()
            self.treesitter_skip_newlines()
            return doc
        nil


me treesitter_skip_expression(self: TreeSitter):
        var paren_depth = 0
        var bracket_depth = 0
        var brace_depth = 0

        while not self.treesitter_is_at_end():
            if paren_depth == 0 and bracket_depth == 0 and brace_depth == 0:
                if self.treesitter_check(TokenKind.Newline) or self.treesitter_check(TokenKind.Dedent) or self.treesitter_check(TokenKind.Comma):
                    break

            match self.treesitter_peek():
                case LParen:
                    paren_depth = paren_depth + 1
                case RParen:
                    if paren_depth == 0 and bracket_depth == 0 and brace_depth == 0:
                        break
                    paren_depth = paren_depth - 1
                case LBracket:
                    bracket_depth = bracket_depth + 1
                case RBracket:
                    if bracket_depth == 0 and paren_depth == 0 and brace_depth == 0:
                        break
                    bracket_depth = bracket_depth - 1
                case LBrace:
                    brace_depth = brace_depth + 1
                case RBrace:
                    if brace_depth == 0 and paren_depth == 0 and bracket_depth == 0:
                        break
                    brace_depth = brace_depth - 1
                case _:
                    pass
            self.treesitter_advance()


me treesitter_synchronize(self: TreeSitter):
        while not self.treesitter_is_at_end():
            if self.treesitter_check(TokenKind.Newline):
                self.treesitter_advance()
                return
            if self.treesitter_check(TokenKind.Dedent):
                return
            self.treesitter_advance()


# ============================================================================
# Exports
# ============================================================================
