# TreeSitter Outline Lexer - TreeSitter Struct & Token Handling
#
# Defines the TreeSitter struct and core token-level operations:
# constructors, advance, peek, check, match, expect, is_at_end.
#
# Split from outline.spl for modularity.

use compiler.frontend.core.lexer.*
use compiler.frontend.core.lexer_struct.{CoreLexer, make_core_lexer, core_lexer_next_token, core_lexer_token_text, core_lexer_token_line, core_lexer_token_col, core_lexer_token_start, core_lexer_token_end, core_lexer_char_slice}
use compiler.frontend.core.lexer_types.{Token, TokenKind, LexSpan, lex_token_eof, lex_span_new, span_merge, token_kind_from_code}
use compiler.frontend.treesitter_types.*
use compiler.frontend.block_types.{PreLexInfo, BlockSkipPolicy, BlockOutlineInfo}
use compiler.blocks.registry.{BlockRegistry, block_registry}

fn ts_is_canonical_custom_block_kind(kind: text) -> bool:
    (kind == "m" or kind == "sh" or kind == "sql" or kind == "re" or
        kind == "md" or kind == "html" or kind == "graph" or kind == "img" or
        kind == "schema" or kind == "style" or kind == "ui" or kind == "music" or
        kind == "bim" or kind == "cad" or kind == "city" or kind == "rtl" or
        kind == "loss" or kind == "lean" or kind == "nograd")

fn ts_core_char_to_byte(core: CoreLexer, char_off: i64) -> i64:
    val char_count = core.source_chars.len()
    var target = char_off
    if target < 0:
        target = 0
    if target > char_count:
        target = char_count
    if core.source.byte_len() == char_count:
        return target
    var acc: i64 = 0
    var i: i64 = 0
    while i < target:
        acc = acc + core.source_chars[i].byte_len()
        i = i + 1
    acc

# ============================================================================
# TreeSitter Parser
# ============================================================================

struct TreeSitter:
    """Outline parser for Simple source code."""
    lexer: Lexer
    current: Token
    previous: Token
    errors: [ParseError]
    source: text
    # # DESUGARED: doc_comment: text
    has_doc_comment: bool
    doc_comment: text
    inline_blocks: [BlockOutline]  # Blocks found while skipping expressions
    asm_blocks: [AsmBlockOutline]  # Inline asm found while skipping function bodies
    # # DESUGARED: current_context: text
    has_current_context: bool
    current_context: text
    fast_mode: bool         # If true, skip Skippable blocks and only outline OutlineRequired
    heuristic_mode: bool    # If true, use line-based error-tolerant parsing instead of lexer
    # # DESUGARED: registry: BlockRegistry
    has_registry: bool
    registry: BlockRegistry
    core_lexer: CoreLexer = make_core_lexer("")
    use_core_lexer: bool = false


# ============================================================================
# TreeSitter Methods (was: impl TreeSitter:)
# ============================================================================

fn treesitter_new(source: text) -> TreeSitter:
        val lexer = Lexer(dummy: 0)
        var ts = TreeSitter(
            lexer: lexer,
            current: lex_token_eof(1),
            previous: lex_token_eof(1),
            errors: [],
            source: source,
            has_doc_comment: false,
            doc_comment: "",
            inline_blocks: [],
            asm_blocks: [],
            has_current_context: false,
            current_context: "",
            fast_mode: false,
            heuristic_mode: false,
            has_registry: false,
            registry: BlockRegistry.new(),
            core_lexer: make_core_lexer(source),
            use_core_lexer: true
        )
        ts.advance()  # Prime this actual mutable parser, not a by-value helper copy
        ts


fn treesitter_with_fast_mode(fast_mode: bool) -> TreeSitter:
        """Create a TreeSitter with fast_mode setting.

        In fast mode, Skippable blocks are stored as opaque outlines,
        and only OutlineRequired blocks get treesitter_outline called.
        """
        val lexer = lexer_new("")
        TreeSitter(
            lexer: lexer,
            current: lex_token_eof(1),
            previous: lex_token_eof(1),
            errors: [],
            source: "",
            has_doc_comment: false,
            doc_comment: "",
            inline_blocks: [],
            asm_blocks: [],
            has_current_context: false,
            current_context: "",
            fast_mode: fast_mode,
            heuristic_mode: false,
            has_registry: true,
            registry: block_registry(),
            core_lexer: make_core_lexer(""),
            use_core_lexer: true
        )


fn treesitter_with_heuristic_mode(enabled: bool) -> TreeSitter:
        """Create TreeSitter with heuristic mode for error-tolerant parsing.

        Heuristic mode uses line-based scanning instead of full lexer tokenization.
        Always produces results, even with syntax errors.
        Ideal for LSP/IDE use where speed and tolerance matter more than accuracy.
        """
        val lexer = lexer_new("")
        TreeSitter(
            lexer: lexer,
            current: lex_token_eof(1),
            previous: lex_token_eof(1),
            errors: [],
            source: "",
            has_doc_comment: false,
            doc_comment: "",
            inline_blocks: [],
            asm_blocks: [],
            has_current_context: false,
            current_context: "",
            fast_mode: false,
            heuristic_mode: enabled,
            has_registry: false,
            registry: BlockRegistry.new(),
            core_lexer: make_core_lexer(""),
            use_core_lexer: false
        )


fn treesitter_with_source(self: TreeSitter, source: text) -> TreeSitter:
        self.with_source(source)

me treesitter_advance(self: TreeSitter) -> Token:
        self.advance()

fn ts_advance(ts: TreeSitter) -> Token:
        treesitter_advance(ts)


fn treesitter_peek(self: TreeSitter) -> TokenKind:
        self.peek()

fn treesitter_check(self: TreeSitter, kind: TokenKind) -> bool:
        self.check(kind)

me treesitter_match_token(self: TreeSitter, kind: TokenKind) -> bool:
        self.match_token(kind)

me treesitter_expect(self: TreeSitter, kind: TokenKind, message: text) -> bool:
        self.expect(kind, message)

fn treesitter_is_at_end(self: TreeSitter) -> bool:
        self.is_at_end()

me treesitter_error(self: TreeSitter, message: text):
        self.error(message)

me treesitter_warning(self: TreeSitter, message: text):
        self.warning(message)

me treesitter_skip_newlines(self: TreeSitter):
        self.skip_newlines()

me treesitter_take_doc_comment(self: TreeSitter) -> text?:
        self.take_doc_comment()

me treesitter_try_parse_body_docstring(self: TreeSitter) -> text?:
        self.try_parse_body_docstring()

me treesitter_skip_expression(self: TreeSitter):
        self.skip_expression()

me treesitter_synchronize(self: TreeSitter):
        self.synchronize()

# ============================================================================
# Exports
# ============================================================================

# Canonical receiver bodies; free entry points above preserve compatibility.
impl TreeSitter:
    static fn new(source: text) -> TreeSitter:
        treesitter_new(source)

    static fn with_fast_mode(fast_mode: bool) -> TreeSitter:
        treesitter_with_fast_mode(fast_mode)

    static fn with_heuristic_mode(enabled: bool) -> TreeSitter:
        treesitter_with_heuristic_mode(enabled)

    fn with_source(source: text) -> TreeSitter:
        var next = self
        next.core_lexer = make_core_lexer(source)
        next.use_core_lexer = true
        next.source = source
        next.advance()
        next


    me next_token_from_source() -> Token:
        if self.use_core_lexer:
            val scan_result = core_lexer_next_token(self.core_lexer)
            self.core_lexer = scan_result[0]
            var kind_code: i64 = scan_result[1]
            if kind_code == 0:
                kind_code = 190
            val tok_text = core_lexer_token_text(self.core_lexer)
            val line = core_lexer_token_line(self.core_lexer)
            val col = core_lexer_token_col(self.core_lexer)
            val end_char = core_lexer_token_end(self.core_lexer)
            val start_char = if kind_code == 182 or kind_code == 190: end_char else: core_lexer_token_start(self.core_lexer)
            val start_byte = ts_core_char_to_byte(self.core_lexer, start_char)
            val end_byte = ts_core_char_to_byte(self.core_lexer, end_char)
            if kind_code == 6 and ts_is_canonical_custom_block_kind(tok_text):
                val chars_len = self.core_lexer.source_chars.len()
                if end_char < chars_len and self.core_lexer.source_chars[end_char] == "{{":
                    kind_code = 240
            return Token(
                kind: token_kind_from_code(kind_code),
                span: lex_span_new(start_byte, end_byte, line, col),
                text: tok_text
            )
        var lexer = self.lexer
        val tok = lexer_next_token(lexer)
        self.lexer = lexer
        tok


    me advance() -> Token:
        """Advance to next token."""
        self.previous = self.current
        self.current = self.next_token_from_source()

        # Accumulate doc comments
        # Guard against EOF and nil tokens before checking text
        while self.current.kind == TokenKind.Ident:
            if not self.current.text.starts_with("##"):
                break
            val comment = self.current.text[2:].trim()
            if self.has_doc_comment:
                self.doc_comment = self.doc_comment + "\n" + comment
            else:
                self.has_doc_comment = true
                self.doc_comment = comment
            self.current = self.next_token_from_source()

        self.previous

    me scan_raw_asm_braced_outline(start: LexSpan, is_volatile: bool, open_span: LexSpan) -> AsmBlockOutline:
        """Scan `asm { ... }` payload raw from source so `#` immediates and braces stay intact."""
        val content_start_char = core_lexer_token_end(self.core_lexer)
        val chars = self.core_lexer.source_chars
        val total = chars.len()
        var pos = content_start_char
        var line = open_span.line
        var col = open_span.col + 1
        var depth = 1
        var in_string = false
        var string_quote = ""
        var escaped = false
        var found_close = false
        var close_char = total
        var close_line = line
        var close_col = col
        while pos < total:
            val ch = chars[pos]
            if in_string:
                if escaped:
                    escaped = false
                elif ch == "\\":
                    escaped = true
                elif ch == string_quote:
                    in_string = false
            else:
                if ch == "\"" or ch == "'":
                    in_string = true
                    string_quote = ch
                elif ch == "{{":
                    depth = depth + 1
                elif ch == "}}":
                    depth = depth - 1
                    if depth == 0:
                        found_close = true
                        close_char = pos
                        close_line = line
                        close_col = col
                        break
            if ch == "\n":
                line = line + 1
                col = 1
            else:
                col = col + 1
            pos = pos + 1

        val raw_payload = if found_close:
            core_lexer_char_slice(self.core_lexer, content_start_char, close_char)
        else:
            core_lexer_char_slice(self.core_lexer, content_start_char, total)
        val close_start_byte = ts_core_char_to_byte(self.core_lexer, close_char)
        val close_end_byte = if found_close:
            ts_core_char_to_byte(self.core_lexer, close_char + 1)
        else:
            close_start_byte
        val close_span = lex_span_new(close_start_byte, close_end_byte, close_line, close_col)

        var lx = self.core_lexer
        if lx.paren_depth > 0:
            lx.paren_depth = lx.paren_depth - 1
        if found_close:
            lx.pos = close_char + 1
            lx.line = close_line
            lx.col = close_col + 1
            lx.at_line_start = false
            self.previous = Token(kind: TokenKind.RBrace, span: close_span, text: "}}")
        else:
            lx.pos = total
            lx.line = line
            lx.col = col
            lx.at_line_start = false
            self.previous = Token(kind: TokenKind.Eof, span: close_span, text: "")
        self.core_lexer = lx
        self.current = self.next_token_from_source()

        AsmBlockOutline(
            payload: raw_payload.trim(),
            payload_span: lex_span_new(open_span.end_pos, close_start_byte, open_span.line, open_span.col),
            span: span_merge(start, close_span),
            is_volatile: is_volatile,
            syntax_form: "braced",
            is_legacy: false
        )


    fn peek() -> TokenKind:
        """Peek at current token kind."""
        self.current.kind


    fn check(kind: TokenKind) -> bool:
        """Check if current token matches kind."""
        self.current.kind == kind


    me match_token(kind: TokenKind) -> bool:
        """Match and consume token if it matches."""
        if self.check(kind):
            self.advance()
            true
        else:
            false


    me expect(kind: TokenKind, message: text) -> bool:
        """Expect a token, report error if not found."""
        if self.current.kind == kind:
            self.advance()
            true
        else:
            self.error(message)
            false


    fn is_at_end() -> bool:
        """Check if at end of input (Eof or nil token)."""
        val kind = self.current.kind
        kind == TokenKind.Eof


    me error(message: text):
        self.errors = self.errors.push(ParseError(
            message: message,
            span: self.current.span,
            severity: ErrorSeverity.Error
        ))


    me warning(message: text):
        self.errors = self.errors.push(ParseError(
            message: message,
            span: self.current.span,
            severity: ErrorSeverity.Warning
        ))


    me skip_newlines():
        while self.check(TokenKind.Newline):
            self.advance()


    me take_doc_comment() -> text?:
        if not self.has_doc_comment:
            return None
        val doc = self.doc_comment
        self.has_doc_comment = false
        self.doc_comment = ""
        Some(doc)


    me try_parse_body_docstring() -> text?:
        if self.check(TokenKind.StringLit):
            val doc = self.current.text
            self.advance()
            self.skip_newlines()
            return doc
        None


    me skip_expression():
        var paren_depth = 0
        var bracket_depth = 0
        var brace_depth = 0

        while not self.is_at_end():
            if paren_depth == 0 and bracket_depth == 0 and brace_depth == 0:
                if self.check(TokenKind.Newline) or self.check(TokenKind.Dedent) or self.check(TokenKind.Comma):
                    break

            match self.peek():
                case TokenKind.LParen:
                    paren_depth = paren_depth + 1
                case TokenKind.RParen:
                    if paren_depth == 0 and bracket_depth == 0 and brace_depth == 0:
                        break
                    paren_depth = paren_depth - 1
                case TokenKind.LBracket:
                    bracket_depth = bracket_depth + 1
                case TokenKind.RBracket:
                    if bracket_depth == 0 and paren_depth == 0 and brace_depth == 0:
                        break
                    bracket_depth = bracket_depth - 1
                case TokenKind.LBrace:
                    brace_depth = brace_depth + 1
                case TokenKind.RBrace:
                    if brace_depth == 0 and paren_depth == 0 and bracket_depth == 0:
                        break
                    brace_depth = brace_depth - 1
                case _:
                    pass
            self.advance()


    me synchronize():
        while not self.is_at_end():
            if self.check(TokenKind.Newline):
                self.advance()
                return
            if self.check(TokenKind.Dedent):
                return
            self.advance()
