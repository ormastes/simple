# Parse-cache payloads own lexical names, never a prior loader context.
use compiler.frontend.parser_types.{AopAdvice}

pub fn frontend_aop_bind_module_owner(advices: [AopAdvice], module_name: text) -> [AopAdvice]:
    var bound: [AopAdvice] = []
    for advice in advices:
        bound.push(AopAdvice(pointcut: advice.pointcut, form: advice.form,
            handler: advice.handler, priority: advice.priority, span: advice.span,
            aspect_name: advice.aspect_name, aspect_module: module_name))
    bound
