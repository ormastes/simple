# Placeholder Lambda Transform
#
# Transforms placeholder expressions using `_` into lambda expressions.
# `_.method()` → `\__p0: __p0.method()`
# `_ * 2`      → `\__p0: __p0 * 2`
# `_ + _`      → `\__p0, __p1: __p0 + __p1`
#
# Also supports numbered placeholders `_1`, `_2`:
# `_1 + _2`    → `\__p0, __p1: __p0 + __p1`
# `_2 - _1`    → `\__p0, __p1: __p1 - __p0`
#
# Mixing numbered and unnumbered is an error.
#
# Nested scoping: call/method-call arguments are independent transform
# boundaries. `_.items.any(_ > 3)` transforms to:
#   outer: `\__p0: __p0.items.any(INNER)`
#   inner: `\__p0: __p0 > 3`
#
# Operates on the compiler's arena-based AST (expr_tag[], expr_left[], etc.).
# Applied to each call argument after parsing.

use compiler.core.ast_expr.{
    EXPR_IDENT, EXPR_BINARY, EXPR_UNARY, EXPR_CALL, EXPR_METHOD_CALL,
    EXPR_FIELD_ACCESS, EXPR_INDEX, EXPR_IF, EXPR_ARRAY_LIT, EXPR_DICT_LIT,
    EXPR_NULL_COALESCE, EXPR_CAST, EXPR_SPREAD, EXPR_LAMBDA, EXPR_TUPLE,
    EXPR_SLICE, EXPR_MATCH, EXPR_INTERPOLATED_STRING,
    expr_tag, expr_s_val, expr_left, expr_right, expr_extra, expr_args, expr_stmts, expr_i_val,
    expr_ident, expr_binary, expr_unary, expr_call, expr_method_call,
    expr_field_access, expr_index, expr_if_expr, expr_array_lit, expr_dict_lit,
    expr_null_coalesce, expr_cast, expr_spread, expr_lambda, expr_tuple, expr_slice,
    expr_match_expr, expr_get_arg_names, expr_call_args_set, expr_get_span, expr_set_span
}
use compiler.frontend.core._AstExpr.accessors.{expr_interpolated_string, expr_interpolated_string_with_text}
use compiler.core.ast.{expr_count, expr_get_arg_names, expr_call_args_set, arm_pattern}

# ===== Placeholder Counter (module-level for mutation in recursive walk) =====

var _ph_counter: i64 = 0

fn placeholder_retain_span(original: i64, rebuilt: i64) -> i64:
    expr_set_span(rebuilt, expr_get_span(original))
    rebuilt

# Post-interpolation rewriting runs after the complete module has been parsed,
# so it must retain the parser's distinction between real call arguments and
# match-pattern syntax. This array is rebuilt for each pass from arm_pattern.
var _ph_pattern_node_marks: [bool] = []

# ===== Interpolation-region suppression =====
#
# Bug (2026-07-30, wildcard_import_c_backend_stubs_function_to_int bonus-find):
# a string-template interpolation region (`{...}`) is sub-parsed standalone via
# a fresh parse_expr() call -- see
# _FlatAstBridge/convert_nodes.spl: flat_bridge_parse_interp_inner. Within such
# a region, a bare `_` already has a fixed meaning: the value bound by the
# enclosing call (e.g. `.map("{_.0}: {self.map_type(_.1)}")` -- `_` is the
# current tuple element). But parse_call_arg() unconditionally applies the
# `_`-placeholder-shorthand transform to EVERY call/method-call argument
# anywhere in the language, including a nested call parsed while sub-parsing an
# interpolation region (e.g. `self.map_type(_.1)`'s argument `_.1`, reached
# because flat_bridge_parse_interp_inner's parse_expr() descends into
# parse_postfix -> parse_call_arg for that nested call). That turned `_.1`
# into an unapplied `\__p0: __p0.1` closure instead of leaving it as a plain
# field access on the template's already-bound `_`, so the nested call
# received a function value instead of the intended field value (surfacing as
# "cannot access field on value of type 'function'" or "cannot convert
# function to int").
#
# Suppress the transform while such interpolation-region mini-parses are in
# flight; the caller sets this around its parse_expr() call and restores the
# previous value afterward (so interpolation-in-interpolation, however
# unlikely, still nests correctly).
var _ph_suppress_transform: bool = false

fn placeholder_transform_suppressed() -> bool:
    """Whether transform_placeholder_lambda is currently suppressed (no-op)."""
    _ph_suppress_transform

fn set_placeholder_transform_suppressed(value: bool) -> bool:
    """Set suppression on/off. Returns the PREVIOUS value so callers can
    restore it (supports nested suppression scopes).
    """
    val prev = _ph_suppress_transform
    _ph_suppress_transform = value
    prev

# ===== Helper: Check if identifier is a numbered placeholder =====

fn is_numbered_placeholder(name: text) -> bool:
    """Check if name matches `_N` pattern (e.g. `_1`, `_2`, `_10`)."""
    if name.len() < 2:
        return false
    if name[0:1] != "_":
        return false
    var i = 1
    while i < name.len():
        val ch = name[i:i + 1]
        if (ch < "0" or ch > "9"):
            return false
        i = i + 1
    true

fn parse_placeholder_number(name: text) -> i64:
    """Extract N from `_N` identifier. Returns -1 if not a numbered placeholder."""
    if not is_numbered_placeholder(name):
        return -1
    val num_text = name[1:]
    var result = 0
    var i = 0
    while i < num_text.len():
        val ch = num_text[i:i + 1]
        val digit = ch[0:1]
        if digit == "0":
            result = result * 10
        elif digit == "1":
            result = result * 10 + 1
        elif digit == "2":
            result = result * 10 + 2
        elif digit == "3":
            result = result * 10 + 3
        elif digit == "4":
            result = result * 10 + 4
        elif digit == "5":
            result = result * 10 + 5
        elif digit == "6":
            result = result * 10 + 6
        elif digit == "7":
            result = result * 10 + 7
        elif digit == "8":
            result = result * 10 + 8
        elif digit == "9":
            result = result * 10 + 9
        i = i + 1
    result

# ===== Detect placeholder mode =====

var _ph_has_unnumbered: bool = false
var _ph_has_numbered: bool = false
var _ph_max_number: i64 = 0

fn detect_placeholder_mode(eid: i64):
    """Scan expression to detect unnumbered `_` vs numbered `_N` usage."""
    if eid < 0 or eid >= expr_tag.len():
        return
    val tag = expr_tag[eid]

    if tag == EXPR_IDENT:
        val name = expr_s_val[eid]
        if name == "_":
            _ph_has_unnumbered = true
        elif is_numbered_placeholder(name):
            _ph_has_numbered = true
            val num = parse_placeholder_number(name)
            if num > _ph_max_number:
                _ph_max_number = num
        return

    if tag == EXPR_BINARY:
        detect_placeholder_mode(expr_left[eid])
        detect_placeholder_mode(expr_right[eid])
        return

    if tag == EXPR_UNARY:
        detect_placeholder_mode(expr_left[eid])
        return

    if tag == EXPR_CALL:
        detect_placeholder_mode(expr_left[eid])
        return

    if tag == EXPR_METHOD_CALL:
        detect_placeholder_mode(expr_left[eid])
        return

    if tag == EXPR_FIELD_ACCESS:
        detect_placeholder_mode(expr_left[eid])
        return

    if tag == EXPR_INDEX:
        detect_placeholder_mode(expr_left[eid])
        detect_placeholder_mode(expr_right[eid])
        return

    if tag == EXPR_SLICE:
        detect_placeholder_mode(expr_left[eid])
        detect_placeholder_mode(expr_right[eid])
        detect_placeholder_mode(expr_extra[eid])
        return

    if tag == EXPR_IF:
        detect_placeholder_mode(expr_left[eid])
        detect_placeholder_mode(expr_right[eid])
        detect_placeholder_mode(expr_extra[eid])
        return

    if tag == EXPR_ARRAY_LIT:
        val items = expr_args[eid]
        var i = 0
        while i < items.len():
            detect_placeholder_mode(items[i])
            i = i + 1
        return

    if tag == EXPR_TUPLE:
        val items = expr_args[eid]
        var i = 0
        while i < items.len():
            detect_placeholder_mode(items[i])
            i = i + 1
        return

    if tag == EXPR_DICT_LIT:
        val keys = expr_args[eid]
        val vals = expr_stmts[eid]
        var i = 0
        while i < keys.len():
            detect_placeholder_mode(keys[i])
            detect_placeholder_mode(vals[i])
            i = i + 1
        return

    if tag == EXPR_NULL_COALESCE:
        detect_placeholder_mode(expr_left[eid])
        detect_placeholder_mode(expr_right[eid])
        return

    if tag == EXPR_CAST:
        detect_placeholder_mode(expr_left[eid])
        return

    if tag == EXPR_SPREAD:
        detect_placeholder_mode(expr_left[eid])
        return

    if tag == EXPR_INTERPOLATED_STRING:
        val parts = expr_args[eid]
        var i = 0
        while i < parts.len():
            detect_placeholder_mode(parts[i])
            i = i + 1
        return

    if tag == EXPR_MATCH:
        # Only scan the scrutinee for placeholders.
        # Arms are a scoping boundary: case _: uses `_` as a wildcard
        # pattern, not a placeholder — recursing into arm bodies would
        # miscount them. The placeholder is in the scrutinee only.
        detect_placeholder_mode(expr_left[eid])
        return

# ===== Main Transform Entry Point =====

fn transform_placeholder_lambda(eid: i64) -> i64:
    """Transform an expression containing `_` or `_N` placeholders into a lambda.

    Supports two modes:
    - Unnumbered: each `_` gets a sequential parameter `__p0`, `__p1`, ...
    - Numbered: `_1` → `__p0`, `_2` → `__p1` (1-indexed to 0-indexed)
    Mixing numbered and unnumbered is treated as unnumbered (numbered ignored).

    Returns the original expression unchanged if no placeholders are found.
    """
    if _ph_suppress_transform:
        return eid

    # Detect mode
    _ph_has_unnumbered = false
    _ph_has_numbered = false
    _ph_max_number = 0
    detect_placeholder_mode(eid)

    if not _ph_has_unnumbered and not _ph_has_numbered:
        # The outer expression may have no placeholder while one of a nested
        # call's arguments does (`items.map(render(_))`). Walk/rebuild it so
        # each call argument gets its own transform instead of leaking `_`
        # into HIR as an unresolved identifier.
        return replace_placeholders(eid)

    # Error on mixing numbered and unnumbered
    if _ph_has_numbered and _ph_has_unnumbered:
        eprint("warning: mixing numbered (_1) and unnumbered (_) placeholders; treating all as unnumbered")

    # Determine param count
    var param_count = 0
    if _ph_has_numbered and not _ph_has_unnumbered:
        # Numbered mode: param count = max number (1-indexed)
        param_count = _ph_max_number
    else:
        # Unnumbered mode (or mixed — treat as unnumbered)
        param_count = count_placeholders(eid)

    _ph_counter = 0
    val body = replace_placeholders(eid)

    var param_names: [i64] = []
    var i = 0
    while i < param_count:
        param_names.push(expr_ident("__p{i}", 0))
        i = i + 1

    var body_stmts: [i64] = []
    body_stmts.push(body)
    expr_lambda(param_names, body_stmts, 0)

# ===== Post-interpolation call-argument transform =====

fn mark_placeholder_pattern_tree(eid: i64, expr_limit: i64):
    """Mark one match-pattern expression tree, including nested payloads.

    Pattern constructors use the normal flat expression arena (`Ok((x, _))`
    is a call containing a tuple), so a whole-arena call scan cannot infer
    context from the call tag alone. The match-arm arena is the authoritative
    source of pattern roots.
    """
    if eid < 0 or eid >= expr_limit:
        return
    if _ph_pattern_node_marks[eid]:
        return
    _ph_pattern_node_marks[eid] = true

    val left = expr_left[eid]
    if left >= 0:
        mark_placeholder_pattern_tree(left, expr_limit)
    val right = expr_right[eid]
    if right >= 0:
        mark_placeholder_pattern_tree(right, expr_limit)
    val extra = expr_extra[eid]
    if extra >= 0:
        mark_placeholder_pattern_tree(extra, expr_limit)

    # EXPR_MATCH stores arm arena IDs in ARGS, not expression IDs. A match is
    # not a valid pattern subtree, so never interpret those IDs as children.
    if expr_tag[eid] == EXPR_MATCH:
        return
    val children = expr_args[eid]
    var child_index = 0
    while child_index < children.len():
        mark_placeholder_pattern_tree(children[child_index], expr_limit)
        child_index = child_index + 1

fn transform_placeholder_call_args_after_interpolation():
    """Apply placeholder shorthand after string interpolation promotion.

    The parser applies the normal transform while parsing each call argument,
    before a string token's `{...}` fragments have become AST expressions.
    This bounded second pass runs after promotion so `_` and `_N` inside an
    interpolated string receive the same enclosing lambda as ordinary
    placeholder arguments. Snapshot the arena size: wrapping an argument
    allocates new nodes, which must not be walked again by this pass.
    """
    val initial_expr_count = expr_tag.len()
    # Build the marks array in a LOCAL and assign the module-global ONCE. Under
    # the Rust-seed interpreter, `.push()` on a module-global array lands in a
    # per-call copy while `.len()` in a while condition (and later indexed
    # reads) see the stale global, so the previous
    # `while _ph_pattern_node_marks.len() < n: _ph_pattern_node_marks.push(false)`
    # fill loop never terminated and doubled the vec until a 2^34-byte realloc
    # aborted the native-build worker. Whole-array assignment and `g[i] = x`
    # index stores DO propagate (verified), so only method-call mutation of the
    # global is avoided here. See
    # doc/08_tracking/bug/native_build_worker_oom_global_array_len_stale_in_while_2026-08-18.md
    var fresh_marks: [bool] = []
    var mark_fill = 0
    while mark_fill < initial_expr_count:
        fresh_marks.push(false)
        mark_fill = mark_fill + 1
    _ph_pattern_node_marks = fresh_marks
    var arm_index = 0
    while arm_index < arm_pattern.len():
        mark_placeholder_pattern_tree(arm_pattern[arm_index], initial_expr_count)
        arm_index = arm_index + 1

    var eid = 0
    while eid < initial_expr_count:
        val tag = expr_tag[eid]
        if not _ph_pattern_node_marks[eid] and (tag == EXPR_CALL or tag == EXPR_METHOD_CALL):
            val old_args = expr_args[eid]
            val old_names = expr_get_arg_names(eid)
            var new_args: [i64] = []
            var changed = false
            var arg_index = 0
            while arg_index < old_args.len():
                val old_arg = old_args[arg_index]
                var new_arg = old_arg
                if old_arg >= 0 and old_arg < initial_expr_count:
                    # Existing shorthand already produced a lambda during
                    # parsing. Do not traverse or wrap it a second time.
                    if expr_tag[old_arg] != EXPR_LAMBDA:
                        new_arg = transform_placeholder_lambda(old_arg)
                new_args.push(new_arg)
                if new_arg != old_arg:
                    changed = true
                arg_index = arg_index + 1
            if changed:
                expr_call_args_set(eid, new_args, old_names)
        eid = eid + 1

# ===== Count Placeholders (unnumbered mode) =====

fn count_placeholders(eid: i64) -> i64:
    """Count the number of `_` placeholder identifiers in an expression.

    Does NOT recurse into nested call/method-call arguments (they get their
    own independent transform).
    """
    if eid < 0 or eid >= expr_tag.len():
        return 0
    val tag = expr_tag[eid]

    if tag == EXPR_IDENT:
        val name = expr_s_val[eid]
        if name == "_":
            return 1
        return 0

    if tag == EXPR_BINARY:
        val l = count_placeholders(expr_left[eid])
        val r = count_placeholders(expr_right[eid])
        return l + r

    if tag == EXPR_UNARY:
        return count_placeholders(expr_left[eid])

    if tag == EXPR_CALL:
        # Count in callee only, NOT in nested call arguments (scoping boundary)
        return count_placeholders(expr_left[eid])

    if tag == EXPR_METHOD_CALL:
        # Count in receiver only, NOT in nested call arguments (scoping boundary)
        return count_placeholders(expr_left[eid])

    if tag == EXPR_FIELD_ACCESS:
        return count_placeholders(expr_left[eid])

    if tag == EXPR_INDEX:
        val l = count_placeholders(expr_left[eid])
        val r = count_placeholders(expr_right[eid])
        return l + r

    if tag == EXPR_SLICE:
        val l = count_placeholders(expr_left[eid])
        val r = count_placeholders(expr_right[eid])
        val e = count_placeholders(expr_extra[eid])
        return l + r + e

    if tag == EXPR_IF:
        val c = count_placeholders(expr_left[eid])
        val t = count_placeholders(expr_right[eid])
        val e = count_placeholders(expr_extra[eid])
        return c + t + e

    if tag == EXPR_ARRAY_LIT:
        var total = 0
        val items = expr_args[eid]
        var i = 0
        while i < items.len():
            total = total + count_placeholders(items[i])
            i = i + 1
        return total

    if tag == EXPR_TUPLE:
        var total = 0
        val items = expr_args[eid]
        var i = 0
        while i < items.len():
            total = total + count_placeholders(items[i])
            i = i + 1
        return total

    if tag == EXPR_DICT_LIT:
        var total = 0
        val keys = expr_args[eid]
        val vals = expr_stmts[eid]
        var i = 0
        while i < keys.len():
            total = total + count_placeholders(keys[i])
            total = total + count_placeholders(vals[i])
            i = i + 1
        return total

    if tag == EXPR_NULL_COALESCE:
        val l = count_placeholders(expr_left[eid])
        val r = count_placeholders(expr_right[eid])
        return l + r

    if tag == EXPR_CAST:
        return count_placeholders(expr_left[eid])

    if tag == EXPR_SPREAD:
        return count_placeholders(expr_left[eid])

    if tag == EXPR_INTERPOLATED_STRING:
        # Bug (2026-07-30, string_template_multi_placeholder_slot_not_found):
        # a bare (unnumbered) `_` used more than once across an interpolated
        # string's `{...}` regions always refers to the SAME implicit bound
        # value -- the one argument a higher-order callback such as
        # `.map("{_.0}: {_.1}")` receives per call -- unlike an ordinary
        # expression like `_ + _`, where each `_` is legitimately a distinct
        # positional lambda parameter. Summing per-occurrence (as the
        # branches above do) over-counts and makes
        # transform_placeholder_lambda synthesize a lambda with more
        # parameters than `.map` ever supplies, leaving the extra `__pN`
        # unbound ("variable `__pN` not found"). Collapse to presence
        # (0 or 1) so the whole template shares one slot; see the matching
        # note in replace_placeholders's EXPR_INTERPOLATED_STRING arm.
        val parts = expr_args[eid]
        var i = 0
        while i < parts.len():
            if count_placeholders(parts[i]) > 0:
                return 1
            i = i + 1
        return 0

    if tag == EXPR_MATCH:
        # Count placeholders in scrutinee only; arms are a scoping boundary.
        return count_placeholders(expr_left[eid])

    0

# ===== Replace Placeholders =====

fn replace_placeholders(eid: i64) -> i64:
    """Replace `_` or `_N` identifiers with `__pN` parameter references.

    In unnumbered mode: each `_` gets sequential `__p0`, `__p1`, ...
    In numbered mode: `_1` → `__p0`, `_2` → `__p1` (1-indexed to 0-indexed)

    Does NOT recurse into nested call/method-call arguments — those get their
    own independent transform via the call-arg parsing path.
    """
    if eid < 0 or eid >= expr_tag.len():
        return eid
    val tag = expr_tag[eid]

    if tag == EXPR_IDENT:
        val name = expr_s_val[eid]
        if name == "_":
            val new_name = "__p{_ph_counter}"
            _ph_counter = _ph_counter + 1
            return placeholder_retain_span(eid, expr_ident(new_name, 0))
        if _ph_has_numbered and not _ph_has_unnumbered:
            if is_numbered_placeholder(name):
                val num = parse_placeholder_number(name)
                # _1 → __p0 (1-indexed to 0-indexed)
                val param_idx = num - 1
                return placeholder_retain_span(eid, expr_ident("__p{param_idx}", 0))
        return eid

    if tag == EXPR_BINARY:
        val new_left = replace_placeholders(expr_left[eid])
        val new_right = replace_placeholders(expr_right[eid])
        return placeholder_retain_span(eid, expr_binary(expr_i_val[eid], new_left, new_right, 0))

    if tag == EXPR_UNARY:
        val new_operand = replace_placeholders(expr_left[eid])
        return placeholder_retain_span(eid, expr_unary(expr_i_val[eid], new_operand, 0))

    if tag == EXPR_CALL:
        # Replace in callee, but transform nested args independently
        val new_callee = replace_placeholders(expr_left[eid])
        val old_args = expr_args[eid]
        var new_args: [i64] = []
        var i = 0
        while i < old_args.len():
            new_args.push(transform_placeholder_lambda(old_args[i]))
            i = i + 1
        return placeholder_retain_span(eid, expr_call(new_callee, new_args, 0))

    if tag == EXPR_METHOD_CALL:
        # Replace in receiver, but transform nested args independently
        val new_receiver = replace_placeholders(expr_left[eid])
        val old_args = expr_args[eid]
        var new_args: [i64] = []
        var i = 0
        while i < old_args.len():
            new_args.push(transform_placeholder_lambda(old_args[i]))
            i = i + 1
        return placeholder_retain_span(eid, expr_method_call(new_receiver, expr_s_val[eid], new_args, 0))

    if tag == EXPR_FIELD_ACCESS:
        val new_base = replace_placeholders(expr_left[eid])
        return placeholder_retain_span(eid, expr_field_access(new_base, expr_s_val[eid], 0))

    if tag == EXPR_INDEX:
        val new_base = replace_placeholders(expr_left[eid])
        val new_index = replace_placeholders(expr_right[eid])
        return placeholder_retain_span(eid, expr_index(new_base, new_index, 0))

    if tag == EXPR_SLICE:
        val new_base = replace_placeholders(expr_left[eid])
        val new_start = replace_placeholders(expr_right[eid])
        val new_end = replace_placeholders(expr_extra[eid])
        return placeholder_retain_span(eid, expr_slice(new_base, new_start, new_end, 0))

    if tag == EXPR_IF:
        val new_cond = replace_placeholders(expr_left[eid])
        val new_then = replace_placeholders(expr_right[eid])
        val new_else = replace_placeholders(expr_extra[eid])
        return placeholder_retain_span(eid, expr_if_expr(new_cond, new_then, new_else, 0))

    if tag == EXPR_ARRAY_LIT:
        val old_items = expr_args[eid]
        var new_items: [i64] = []
        var i = 0
        while i < old_items.len():
            new_items.push(replace_placeholders(old_items[i]))
            i = i + 1
        return placeholder_retain_span(eid, expr_array_lit(new_items, 0))

    if tag == EXPR_TUPLE:
        val old_items = expr_args[eid]
        var new_items: [i64] = []
        var i = 0
        while i < old_items.len():
            new_items.push(replace_placeholders(old_items[i]))
            i = i + 1
        return placeholder_retain_span(eid, expr_tuple(new_items, 0))

    if tag == EXPR_DICT_LIT:
        val old_keys = expr_args[eid]
        val old_vals = expr_stmts[eid]
        var new_keys: [i64] = []
        var new_vals: [i64] = []
        var i = 0
        while i < old_keys.len():
            new_keys.push(replace_placeholders(old_keys[i]))
            new_vals.push(replace_placeholders(old_vals[i]))
            i = i + 1
        return placeholder_retain_span(eid, expr_dict_lit(new_keys, new_vals, 0))

    if tag == EXPR_NULL_COALESCE:
        val new_left = replace_placeholders(expr_left[eid])
        val new_right = replace_placeholders(expr_right[eid])
        return placeholder_retain_span(eid, expr_null_coalesce(new_left, new_right, 0))

    if tag == EXPR_CAST:
        val new_val = replace_placeholders(expr_left[eid])
        return placeholder_retain_span(eid, expr_cast(new_val, expr_i_val[eid], 0))

    if tag == EXPR_SPREAD:
        val new_inner = replace_placeholders(expr_left[eid])
        return placeholder_retain_span(eid, expr_spread(new_inner, 0))

    if tag == EXPR_INTERPOLATED_STRING:
        # See the matching note in count_placeholders's
        # EXPR_INTERPOLATED_STRING arm: every bare `_` inside one
        # interpolated string shares a SINGLE slot (reserved once from
        # _ph_counter), instead of each occurrence grabbing its own
        # incrementing slot.
        val old_parts = expr_args[eid]
        var has_bare = false
        var i = 0
        while i < old_parts.len():
            if count_placeholders(old_parts[i]) > 0:
                has_bare = true
            i = i + 1
        var new_parts: [i64] = []
        if has_bare:
            val slot = _ph_counter
            _ph_counter = _ph_counter + 1
            i = 0
            while i < old_parts.len():
                new_parts.push(replace_placeholders_fixed_slot(old_parts[i], slot))
                i = i + 1
        else:
            i = 0
            while i < old_parts.len():
                new_parts.push(replace_placeholders(old_parts[i]))
                i = i + 1
        # Carry the verbatim template text across the rebuild -- see
        # expr_interpolated_string_with_text's doc comment: dropping it makes
        # MIR lower the whole literal, placeholders and all, to "".
        return placeholder_retain_span(eid, expr_interpolated_string_with_text(expr_s_val[eid], new_parts, 0))

    if tag == EXPR_MATCH:
        # Replace placeholders in the scrutinee only.
        # Arms are a scoping boundary: arm bodies and patterns are left
        # unchanged so that `case _:` wildcards are not mis-replaced.
        val new_scrutinee = replace_placeholders(expr_left[eid])
        val arms = expr_args[eid]
        return placeholder_retain_span(eid, expr_match_expr(new_scrutinee, arms, 0))

    # For any other expression type, return as-is
    eid

# ===== Replace Placeholders (shared fixed slot, for interpolated strings) =====

fn replace_placeholders_fixed_slot(eid: i64, slot: i64) -> i64:
    """Like replace_placeholders, but every bare `_` maps to the SAME fixed
    `slot` instead of the incrementing `_ph_counter`. Used only when
    replacing the parts of ONE interpolated string that contains a bare
    placeholder (see the shared-slot note in replace_placeholders's
    EXPR_INTERPOLATED_STRING arm) -- all bare `_` occurrences inside one
    template denote the SAME bound value, not independent positional lambda
    parameters.
    """
    if eid < 0 or eid >= expr_tag.len():
        return eid
    val tag = expr_tag[eid]

    if tag == EXPR_IDENT:
        val name = expr_s_val[eid]
        if name == "_":
            return placeholder_retain_span(eid, expr_ident("__p{slot}", 0))
        if _ph_has_numbered and not _ph_has_unnumbered:
            if is_numbered_placeholder(name):
                val num = parse_placeholder_number(name)
                val param_idx = num - 1
                return placeholder_retain_span(eid, expr_ident("__p{param_idx}", 0))
        return eid

    if tag == EXPR_BINARY:
        val new_left = replace_placeholders_fixed_slot(expr_left[eid], slot)
        val new_right = replace_placeholders_fixed_slot(expr_right[eid], slot)
        return placeholder_retain_span(eid, expr_binary(expr_i_val[eid], new_left, new_right, 0))

    if tag == EXPR_UNARY:
        val new_operand = replace_placeholders_fixed_slot(expr_left[eid], slot)
        return placeholder_retain_span(eid, expr_unary(expr_i_val[eid], new_operand, 0))

    if tag == EXPR_CALL:
        # Replace in callee, but transform nested args independently
        val new_callee = replace_placeholders_fixed_slot(expr_left[eid], slot)
        val old_args = expr_args[eid]
        var new_args: [i64] = []
        var i = 0
        while i < old_args.len():
            new_args.push(transform_placeholder_lambda(old_args[i]))
            i = i + 1
        return placeholder_retain_span(eid, expr_call(new_callee, new_args, 0))

    if tag == EXPR_METHOD_CALL:
        # Replace in receiver, but transform nested args independently
        val new_receiver = replace_placeholders_fixed_slot(expr_left[eid], slot)
        val old_args = expr_args[eid]
        var new_args: [i64] = []
        var i = 0
        while i < old_args.len():
            new_args.push(transform_placeholder_lambda(old_args[i]))
            i = i + 1
        return placeholder_retain_span(eid, expr_method_call(new_receiver, expr_s_val[eid], new_args, 0))

    if tag == EXPR_FIELD_ACCESS:
        val new_base = replace_placeholders_fixed_slot(expr_left[eid], slot)
        return placeholder_retain_span(eid, expr_field_access(new_base, expr_s_val[eid], 0))

    if tag == EXPR_INDEX:
        val new_base = replace_placeholders_fixed_slot(expr_left[eid], slot)
        val new_index = replace_placeholders_fixed_slot(expr_right[eid], slot)
        return placeholder_retain_span(eid, expr_index(new_base, new_index, 0))

    if tag == EXPR_SLICE:
        val new_base = replace_placeholders_fixed_slot(expr_left[eid], slot)
        val new_start = replace_placeholders_fixed_slot(expr_right[eid], slot)
        val new_end = replace_placeholders_fixed_slot(expr_extra[eid], slot)
        return placeholder_retain_span(eid, expr_slice(new_base, new_start, new_end, 0))

    if tag == EXPR_IF:
        val new_cond = replace_placeholders_fixed_slot(expr_left[eid], slot)
        val new_then = replace_placeholders_fixed_slot(expr_right[eid], slot)
        val new_else = replace_placeholders_fixed_slot(expr_extra[eid], slot)
        return placeholder_retain_span(eid, expr_if_expr(new_cond, new_then, new_else, 0))

    if tag == EXPR_ARRAY_LIT:
        val old_items = expr_args[eid]
        var new_items: [i64] = []
        var i = 0
        while i < old_items.len():
            new_items.push(replace_placeholders_fixed_slot(old_items[i], slot))
            i = i + 1
        return placeholder_retain_span(eid, expr_array_lit(new_items, 0))

    if tag == EXPR_TUPLE:
        val old_items = expr_args[eid]
        var new_items: [i64] = []
        var i = 0
        while i < old_items.len():
            new_items.push(replace_placeholders_fixed_slot(old_items[i], slot))
            i = i + 1
        return placeholder_retain_span(eid, expr_tuple(new_items, 0))

    if tag == EXPR_DICT_LIT:
        val old_keys = expr_args[eid]
        val old_vals = expr_stmts[eid]
        var new_keys: [i64] = []
        var new_vals: [i64] = []
        var i = 0
        while i < old_keys.len():
            new_keys.push(replace_placeholders_fixed_slot(old_keys[i], slot))
            new_vals.push(replace_placeholders_fixed_slot(old_vals[i], slot))
            i = i + 1
        return placeholder_retain_span(eid, expr_dict_lit(new_keys, new_vals, 0))

    if tag == EXPR_NULL_COALESCE:
        val new_left = replace_placeholders_fixed_slot(expr_left[eid], slot)
        val new_right = replace_placeholders_fixed_slot(expr_right[eid], slot)
        return placeholder_retain_span(eid, expr_null_coalesce(new_left, new_right, 0))

    if tag == EXPR_CAST:
        val new_val = replace_placeholders_fixed_slot(expr_left[eid], slot)
        return placeholder_retain_span(eid, expr_cast(new_val, expr_i_val[eid], 0))

    if tag == EXPR_SPREAD:
        val new_inner = replace_placeholders_fixed_slot(expr_left[eid], slot)
        return placeholder_retain_span(eid, expr_spread(new_inner, 0))

    if tag == EXPR_INTERPOLATED_STRING:
        val old_parts = expr_args[eid]
        var new_parts: [i64] = []
        var i = 0
        while i < old_parts.len():
            new_parts.push(replace_placeholders_fixed_slot(old_parts[i], slot))
            i = i + 1
        # Carry the verbatim template text across the rebuild -- see
        # expr_interpolated_string_with_text's doc comment: dropping it makes
        # MIR lower the whole literal, placeholders and all, to "".
        return placeholder_retain_span(eid, expr_interpolated_string_with_text(expr_s_val[eid], new_parts, 0))

    if tag == EXPR_MATCH:
        val new_scrutinee = replace_placeholders_fixed_slot(expr_left[eid], slot)
        val arms = expr_args[eid]
        return placeholder_retain_span(eid, expr_match_expr(new_scrutinee, arms, 0))

    # For any other expression type, return as-is
    eid

# ===== Second pass: interpolated-string call arguments =====
#
# Bug (2026-08-09, Stage-3 self-host blocker 9): a string-template argument such
# as `params.map("({_.0} : {_.1})")` reaches parse_call_arg() as a still-opaque
# EXPR_STRING_LIT. Interpolation regions are only sub-parsed AFTER the whole
# module parse, in string_interpolation_expand.expand_string_interpolations(),
# which promotes the literal to EXPR_INTERPOLATED_STRING. So the first-pass
# transform in parse_call_arg() sees no `_` at all and emits no lambda, and the
# `_` / `_1` identifiers minted by the later sub-parse leak into HIR as
# "unresolved name: _". The Rust seed does not hit this because its parser
# builds the FString parts inline, before its own transform runs.
#
# This second pass restores parity: run immediately after interpolation
# expansion and transform exactly those call/method-call arguments that are
# EXPR_INTERPOLATED_STRING and do contain placeholders. Arguments of calls
# nested INSIDE an interpolation region (e.g. `self.map_type(_1.1)`) are not
# interpolated strings, so they are left alone -- preserving the deliberate
# suppression documented at the top of this file.

fn expr_has_placeholder(eid: i64) -> bool:
    """True when `eid`'s subtree contains an unnumbered `_` or numbered `_N`
    placeholder identifier.

    Exported so the driver/native-build parse path can decide, BEFORE promoting
    a plain string literal into an interpolated one, whether that literal is
    actually a placeholder lambda. Keeps the `_ph_*` detection globals private
    to this module.
    """
    _ph_has_unnumbered = false
    _ph_has_numbered = false
    _ph_max_number = 0
    detect_placeholder_mode(eid)
    _ph_has_unnumbered or _ph_has_numbered

fn transform_interpolated_placeholder_args(start_expr: i64):
    """Apply the placeholder-lambda transform to interpolated-string call args.

    Must run after expand_string_interpolations(), which is the only point at
    which such an argument stops being an opaque string literal.
    """
    val prev = set_placeholder_transform_suppressed(false)
    val limit = expr_count()
    var idx = start_expr
    while idx < limit:
        val tag = expr_tag[idx]
        if (tag == EXPR_CALL or tag == EXPR_METHOD_CALL):
            val args = expr_args[idx]
            var new_args: [i64] = []
            var changed = false
            var i = 0
            while i < args.len():
                val a = args[i]
                var out = a
                if (a >= 0 and a < expr_tag.len() and
                        expr_tag[a] == EXPR_INTERPOLATED_STRING):
                    _ph_has_unnumbered = false
                    _ph_has_numbered = false
                    _ph_max_number = 0
                    detect_placeholder_mode(a)
                    if (_ph_has_unnumbered or _ph_has_numbered):
                        out = transform_placeholder_lambda(a)
                        if out != a:
                            changed = true
                new_args.push(out)
                i = i + 1
            if changed:
                expr_call_args_set(idx, new_args, expr_get_arg_names(idx))
        idx = idx + 1
    set_placeholder_transform_suppressed(prev)
