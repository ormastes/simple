# ParseContext: one value holding every per-parse frontend owner.
# Stage 1 of doc/05_design/compiler/frontend/parse_context_per_context_state.md.
# The module globals remain the active context; take moves the active state
# out (leaving fresh initial owners) and install makes a taken context active.
# A cooperative fiber swaps contexts at park/resume. Not thread-safe.

use compiler.core.types.{FlatPoolState, flat_pool_state_take, flat_pool_state_install}
use compiler.frontend.core.lexer.{LexerState, lexer_state_take, lexer_state_install}
use compiler.frontend.core.parser.{ParserState, parser_state_take, parser_state_install}
use compiler.frontend.core._Ast.module_state.{AstLexerSlotState, ast_lexer_slot_state_take, ast_lexer_slot_state_install}
use compiler.core.ast_stmt.{StmtStoreState, stmt_store_state_take, stmt_store_state_install}
use compiler.frontend.core._ParserDecls.enum_module_body.{PendingDeclAttrState, pending_decl_attr_state_take, pending_decl_attr_state_install}
use compiler.frontend.core._AstExpr.nodes.{ExprStoreState, expr_store_state_take, expr_store_state_install}
use compiler.frontend.core._Ast.decl_nodes.{DeclStoreState, decl_store_state_take, decl_store_state_install}
use compiler.frontend._FlatAstBridge.module_assembly.{FabCaptureState, fab_capture_state_take, fab_capture_state_install}
use compiler.frontend.parse_env_state.{ParseEnvState, parse_env_state_take, parse_env_state_install}

pub struct ParseContext:
    pools: FlatPoolState
    lexer: LexerState
    parser: ParserState
    lexer_slots: AstLexerSlotState
    stmts: StmtStoreState
    pending_attrs: PendingDeclAttrState
    exprs: ExprStoreState
    decls: DeclStoreState
    capture: FabCaptureState
    env: ParseEnvState

pub fn parse_context_take() -> ParseContext:
    ParseContext(
        pools: flat_pool_state_take(),
        lexer: lexer_state_take(),
        parser: parser_state_take(),
        lexer_slots: ast_lexer_slot_state_take(),
        stmts: stmt_store_state_take(),
        pending_attrs: pending_decl_attr_state_take(),
        exprs: expr_store_state_take(),
        decls: decl_store_state_take(),
        capture: fab_capture_state_take(),
        env: parse_env_state_take()
    )

pub fn parse_context_install(ctx: ParseContext):
    flat_pool_state_install(ctx.pools)
    lexer_state_install(ctx.lexer)
    parser_state_install(ctx.parser)
    ast_lexer_slot_state_install(ctx.lexer_slots)
    stmt_store_state_install(ctx.stmts)
    pending_decl_attr_state_install(ctx.pending_attrs)
    expr_store_state_install(ctx.exprs)
    decl_store_state_install(ctx.decls)
    fab_capture_state_install(ctx.capture)
    parse_env_state_install(ctx.env)

export ParseContext, parse_context_take, parse_context_install
