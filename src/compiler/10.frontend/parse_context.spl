# ParseContext: one value holding every per-parse frontend owner.
# Stage 1 of doc/05_design/compiler/frontend/parse_context_per_context_state.md.
# The module globals remain the active context; take moves the active state
# out (leaving fresh initial owners) and install makes a taken context active.
# A cooperative fiber swaps contexts at park/resume. Not thread-safe.

use compiler.core.types.{FlatPoolState, flat_pool_state_take, flat_pool_state_install}
use compiler.frontend.core.lexer.{LexerState, lexer_state_take, lexer_state_install}
use compiler.frontend.core.parser.{ParserState, parser_state_take, parser_state_install}
use compiler.frontend.core._Ast.module_state.{AstLexerSlotState, ast_lexer_slot_state_take, ast_lexer_slot_state_install}
use compiler.core.ast_stmt.{StmtStoreState, stmt_store_state_take, stmt_store_state_install}
use compiler.frontend.core._ParserDecls.enum_module_body.{PendingDeclAttrState, pending_decl_attr_state_take, pending_decl_attr_state_install}
use compiler.frontend.core._AstExpr.nodes.{ExprStoreState, expr_store_state_take, expr_store_state_install}
use compiler.frontend.core._Ast.decl_nodes.{DeclStoreState, decl_store_state_take, decl_store_state_install}
use compiler.frontend._FlatAstBridge.module_assembly.{FabCaptureState, fab_capture_state_take, fab_capture_state_install}
use compiler.frontend.parse_env_state.{ParseEnvState, parse_env_state_take, parse_env_state_install}
use compiler.frontend.core.parser_decls_use.{ImplTargetState, impl_target_state_take, impl_target_state_install}
use compiler.frontend.core.parser_expr.{ExprNestState, expr_nest_state_take, expr_nest_state_install}
use compiler.frontend.core.parser_preprocessor.{PreprocessorState, preprocessor_state_take, preprocessor_state_install}
use compiler.frontend.core.representation_declarations_v1.{RepresentationParseState, representation_parse_state_take, representation_parse_state_install}
use compiler.frontend.core._ParserDecls.extend_decls.{ExtendDeclState, extend_decl_state_take, extend_decl_state_install}
use compiler.frontend.core.parser_decls_fn.{FileGenericConstraintState, file_generic_constraint_state_take, file_generic_constraint_state_install}
use compiler.frontend.core._ParserDecls.fn_struct_decls.{FnStructGenericConstraintState, fn_struct_generic_constraint_state_take, fn_struct_generic_constraint_state_install}
use compiler.frontend.core.lexer_struct.{CoreTokenSlotState, core_token_slot_state_take, core_token_slot_state_install}
use compiler.frontend.desugar.placeholder_lambda.{PlaceholderLambdaState, placeholder_lambda_state_take, placeholder_lambda_state_install}
use compiler.frontend._FlatAstBridge.convert_nodes.{PendingDeferState, pending_defer_state_take, pending_defer_state_install}
use compiler.frontend.core.collection_feedback.{CollectionFeedbackState, collection_feedback_state_take, collection_feedback_state_install}
use compiler.frontend.core.capture_write_check.{CaptureWriteCheckState, capture_write_check_state_take, capture_write_check_state_install}

pub struct ParseContext:
    pools: FlatPoolState
    lexer: LexerState
    parser: ParserState
    lexer_slots: AstLexerSlotState
    stmts: StmtStoreState
    pending_attrs: PendingDeclAttrState
    exprs: ExprStoreState
    decls: DeclStoreState
    capture: FabCaptureState
    env: ParseEnvState
    impl_target: ImplTargetState
    expr_nest: ExprNestState
    preprocessor: PreprocessorState
    representation: RepresentationParseState
    extend_decls: ExtendDeclState
    file_generic_constraints: FileGenericConstraintState
    fn_struct_generic_constraints: FnStructGenericConstraintState
    core_token_slots: CoreTokenSlotState
    placeholder_lambda: PlaceholderLambdaState
    pending_defers: PendingDeferState
    collection_feedback: CollectionFeedbackState
    capture_write_check: CaptureWriteCheckState

pub fn parse_context_take() -> ParseContext:
    ParseContext(
        pools: flat_pool_state_take(),
        lexer: lexer_state_take(),
        parser: parser_state_take(),
        lexer_slots: ast_lexer_slot_state_take(),
        stmts: stmt_store_state_take(),
        pending_attrs: pending_decl_attr_state_take(),
        exprs: expr_store_state_take(),
        decls: decl_store_state_take(),
        capture: fab_capture_state_take(),
        env: parse_env_state_take(),
        impl_target: impl_target_state_take(),
        expr_nest: expr_nest_state_take(),
        preprocessor: preprocessor_state_take(),
        representation: representation_parse_state_take(),
        extend_decls: extend_decl_state_take(),
        file_generic_constraints: file_generic_constraint_state_take(),
        fn_struct_generic_constraints: fn_struct_generic_constraint_state_take(),
        core_token_slots: core_token_slot_state_take(),
        placeholder_lambda: placeholder_lambda_state_take(),
        pending_defers: pending_defer_state_take(),
        collection_feedback: collection_feedback_state_take(),
        capture_write_check: capture_write_check_state_take()
    )

pub fn parse_context_install(ctx: ParseContext):
    flat_pool_state_install(ctx.pools)
    lexer_state_install(ctx.lexer)
    parser_state_install(ctx.parser)
    ast_lexer_slot_state_install(ctx.lexer_slots)
    stmt_store_state_install(ctx.stmts)
    pending_decl_attr_state_install(ctx.pending_attrs)
    expr_store_state_install(ctx.exprs)
    decl_store_state_install(ctx.decls)
    fab_capture_state_install(ctx.capture)
    parse_env_state_install(ctx.env)
    impl_target_state_install(ctx.impl_target)
    expr_nest_state_install(ctx.expr_nest)
    preprocessor_state_install(ctx.preprocessor)
    representation_parse_state_install(ctx.representation)
    extend_decl_state_install(ctx.extend_decls)
    file_generic_constraint_state_install(ctx.file_generic_constraints)
    fn_struct_generic_constraint_state_install(ctx.fn_struct_generic_constraints)
    core_token_slot_state_install(ctx.core_token_slots)
    placeholder_lambda_state_install(ctx.placeholder_lambda)
    pending_defer_state_install(ctx.pending_defers)
    collection_feedback_state_install(ctx.collection_feedback)
    capture_write_check_state_install(ctx.capture_write_check)

export ParseContext, parse_context_take, parse_context_install
