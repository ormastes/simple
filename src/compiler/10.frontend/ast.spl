
struct FunctionDef:
    name: text
    generic_params: [text]
    params: [text]
    # # DESUGARED: return_type: text
    has_return_type: bool
    return_type: text
    body: [text]
    is_generic_template: bool
    # # DESUGARED: specialization_of: text
    has_specialization_of: bool
    specialization_of: text
    type_bindings: {text: text}

struct StructDef:
    name: text
    generic_params: [text]
    fields: [text]
    is_generic_template: bool
    # # DESUGARED: specialization_of: text
    has_specialization_of: bool
    specialization_of: text
    type_bindings: {text: text}

struct ClassDef:
    name: text
    generic_params: [text]
    fields: [text]
    methods: [text]
    is_generic_template: bool
    # # DESUGARED: specialization_of: text
    has_specialization_of: bool
    specialization_of: text
    type_bindings: {text: text}

struct EnumDef:
    name: text
    generic_params: [text]
    variants: [text]
    is_generic_template: bool
    # # DESUGARED: specialization_of: text
    has_specialization_of: bool
    specialization_of: text
    type_bindings: {text: text}
    # Enum payload / attribute metadata (SMF enum record v2, bug
    # smf_enum_def_serializes_variant_names_only_2026-08-21). All `variant_*`
    # lists are parallel to `variants`; the two `*_type_names` / `*_field_names`
    # lists are FLAT across variants in source order, element-for-element
    # parallel to each other ("" field name = positional slot). MUST stay the
    # LAST fields and MUST carry defaults: the Rust seed fills partial named
    # constructions POSITIONALLY.
    variant_payload_counts: [i64] = []
    variant_payload_kinds: [u8] = []        # 0 = unit, 1 = tuple, 2 = struct (named)
    variant_payload_type_names: [text] = []
    variant_payload_field_names: [text] = []
    variant_discriminants: [i64] = []
    has_explicit_discriminant: [bool] = []
    attribute_names: [text] = []            # decorator spelling without `@` ("closed", "evolving")
    attribute_args: [text] = []             # parallel to attribute_names, "" when none
    complete_open: bool = false             # trailing `complete:` section present
    dyn_open: bool = false                  # trailing `dyn:` section present

struct TraitDef:
    name: text
    generic_params: [text]
    methods: [text]
    is_generic_template: bool

enum Node:
    Function(FunctionDef)
    Struct(StructDef)
    Class(ClassDef)
    Enum(EnumDef)
    Trait(TraitDef)
    Other(text)

# Flat AST module ({name, items}) — distinct from the rich
# parser_types.Module ({name, imports, exports, functions, ...}). They were both
# named `Module` and collided in the interpreter's global struct registry
# (bare-name, last-write-wins), making parser_module_new build the wrong shape
# ("class Module has no field named imports"). Renamed the flat one to AstModule.
struct AstModule:
    name: text
    items: [Node]

export FunctionDef, StructDef, ClassDef, EnumDef, TraitDef
export Node, AstModule
