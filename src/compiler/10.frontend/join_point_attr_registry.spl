# Function attribute names per (module file, function), recorded during HIR
# lowering so AOP `attr(...)` selectors can be evaluated over lowered modules.
#
# HirFunction carries no general attribute list (adding one changes the
# generated HIR codec), so this side table sits next to aspect_registry with
# the same ownership: written on the single compile loop, read by
# 80.driver/cache/aop_match_cache_driver_v1 when it builds directory join-point
# facts. Re-lowering a function overwrites (or clears) its entry, so a removed
# attribute is never stale.

var join_point_attr_names: Dict<text, [text]> = {}
var join_point_attr_epochs_v2: Dict<text, i64> = {}
var join_point_attr_epoch_v2: i64 = 0

# Serialized compile-loop owner. Exhaustion disables proof; never reuse an epoch.
pub fn join_point_attr_begin_epoch_v2() -> i64:
    # Legacy getters retain their existing cache behavior. Only proof rows reset;
    # restored HIR must not gain a fresh registration by retaining old attributes.
    join_point_attr_epochs_v2 = {}
    if join_point_attr_epoch_v2 == 9223372036854775807: return 0
    join_point_attr_epoch_v2 = join_point_attr_epoch_v2 + 1
    join_point_attr_epoch_v2

pub fn join_point_attr_epoch_matches_v2(path: text, fn_name: text, epoch: i64) -> bool:
    if epoch <= 0: return false
    val key = _join_point_attr_key(path, fn_name)
    join_point_attr_epochs_v2.contains_key(key) and join_point_attr_epochs_v2[key] == epoch

fn _join_point_attr_key(path: text, fn_name: text) -> text:
    path.replace("\\", "/") + "|" + fn_name

pub fn join_point_attr_record(path: text, fn_name: text, names: [text]):
    val key = _join_point_attr_key(path, fn_name)
    # Known-empty is distinct from absent/restored HIR without a fresh row.
    join_point_attr_names[key] = names
    join_point_attr_epochs_v2[key] = join_point_attr_epoch_v2

pub fn join_point_attr_names_of(path: text, fn_name: text) -> [text]:
    val key = _join_point_attr_key(path, fn_name)
    if join_point_attr_names.contains_key(key):
        return join_point_attr_names[key]
    []

export join_point_attr_record, join_point_attr_names_of
