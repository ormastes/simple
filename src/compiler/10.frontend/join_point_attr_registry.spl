# Function attribute names per (module file, function), recorded during HIR
# lowering so AOP `attr(...)` selectors can be evaluated over lowered modules.
#
# HirFunction carries no general attribute list (adding one changes the
# generated HIR codec), so this side table sits next to aspect_registry with
# the same ownership: written on the single compile loop, read by
# 80.driver/cache/aop_match_cache_driver_v1 when it builds directory join-point
# facts. Re-lowering a function overwrites (or clears) its entry, so a removed
# attribute is never stale.

@unsafe(reason: "raw transient-owner promotion; false is provider failure", capabilities: [ffi])
extern fn rt_transient_heap_promote<T>(value: T) -> bool

fn _join_point_attr_promote_raw<T>(value: T) -> bool:
    unsafe(capabilities: [ffi]):
        rt_transient_heap_promote(value)

var join_point_attr_names: Dict<text, Dict<text, [text]>> = {}
var join_point_attr_epochs_v2: Dict<text, Dict<text, i64>> = {}
var join_point_attr_epoch_v2: i64 = 0
var join_point_attr_dirty_paths: Dict<text, bool> = {}
var join_point_attr_dirty_fn_names: [text] = []
var join_point_attr_dirty_name_lists: [[text]] = []

fn _join_point_attr_norm_path(path: text) -> text:
    path.replace("\\", "/")

fn _join_point_attr_clear_dirty():
    join_point_attr_dirty_paths = {}
    join_point_attr_dirty_fn_names = []
    join_point_attr_dirty_name_lists = []

pub fn join_point_attr_reset():
    join_point_attr_names = {}
    join_point_attr_epochs_v2 = {}
    _join_point_attr_clear_dirty()

# Serialized compile-loop owner. Exhaustion disables proof; never reuse an epoch.
# @allow(primitive_api) cache-contract predicate/scalar: bool validity verdicts and i64 epochs/limits/pids match the sibling v1 cache API surface
pub fn join_point_attr_begin_epoch_v2() -> i64:
    # Legacy getters retain their existing cache behavior. Only proof rows and
    # per-scope dirty tracking reset; restored HIR must not gain a fresh
    # registration by retaining old attributes.
    join_point_attr_epochs_v2 = {}
    _join_point_attr_clear_dirty()
    if join_point_attr_epoch_v2 == 9223372036854775807: return 0
    join_point_attr_epoch_v2 = join_point_attr_epoch_v2 + 1
    join_point_attr_epoch_v2

# @allow(primitive_api) cache-contract predicate/scalar: bool validity verdicts and i64 epochs/limits/pids match the sibling v1 cache API surface
pub fn join_point_attr_epoch_matches_v2(path: text, fn_name: text, epoch: i64) -> bool:
    if epoch <= 0: return false
    val norm_path = _join_point_attr_norm_path(path)
    if not join_point_attr_epochs_v2.contains_key(norm_path): return false
    val path_epochs: Dict<text, i64> = join_point_attr_epochs_v2[norm_path]
    path_epochs.contains_key(fn_name) and path_epochs[fn_name] == epoch

fn _join_point_attr_record_epoch(norm_path: text, fn_name: text):
    if not join_point_attr_epochs_v2.contains_key(norm_path):
        var path_epochs: Dict<text, i64> = {}
        path_epochs[fn_name] = join_point_attr_epoch_v2
        join_point_attr_epochs_v2[norm_path] = path_epochs
    else:
        var path_epochs: Dict<text, i64> = join_point_attr_epochs_v2[norm_path]
        path_epochs[fn_name] = join_point_attr_epoch_v2
        join_point_attr_epochs_v2[norm_path] = path_epochs
    join_point_attr_dirty_paths[norm_path] = true
    join_point_attr_dirty_fn_names.push(fn_name)

fn _join_point_attr_remove_name(norm_path: text, fn_name: text):
    if join_point_attr_names.contains_key(norm_path):
        var path_names: Dict<text, [text]> = join_point_attr_names[norm_path]
        if path_names.contains_key(fn_name):
            path_names.remove(fn_name)
            if path_names.len() == 0:
                join_point_attr_names.remove(norm_path)
            else:
                join_point_attr_names[norm_path] = path_names

pub fn join_point_attr_record_empty(path: text, fn_name: text):
    val norm_path = _join_point_attr_norm_path(path)
    _join_point_attr_remove_name(norm_path, fn_name)
    _join_point_attr_record_epoch(norm_path, fn_name)

pub fn join_point_attr_record(path: text, fn_name: text, names: [text]):
    val norm_path = _join_point_attr_norm_path(path)
    # Known-empty is distinct from absent/restored HIR without a fresh row;
    # avoid storing empty lists and evict stale entries on overwrite.
    if names.len() == 0:
        _join_point_attr_remove_name(norm_path, fn_name)
        _join_point_attr_record_epoch(norm_path, fn_name)
        return
    if not join_point_attr_names.contains_key(norm_path):
        var path_names: Dict<text, [text]> = {}
        path_names[fn_name] = names
        join_point_attr_names[norm_path] = path_names
    else:
        var path_names: Dict<text, [text]> = join_point_attr_names[norm_path]
        path_names[fn_name] = names
        join_point_attr_names[norm_path] = path_names
    join_point_attr_dirty_name_lists.push(names)
    _join_point_attr_record_epoch(norm_path, fn_name)

pub fn join_point_attr_names_of(path: text, fn_name: text) -> [text]:
    val norm_path = _join_point_attr_norm_path(path)
    if not join_point_attr_names.contains_key(norm_path):
        return []
    val path_names: Dict<text, [text]> = join_point_attr_names[norm_path]
    if path_names.contains_key(fn_name):
        return path_names[fn_name]
    []

# @allow(primitive_api) frontend parse registry owner promotion returns status bool like sibling registries
pub fn join_point_attr_promote_transient_owner() -> bool:
    if join_point_attr_dirty_paths.len() == 0:
        return true
    var ok = _join_point_attr_promote_raw(join_point_attr_names) and
        _join_point_attr_promote_raw(join_point_attr_epochs_v2)
    if ok:
        for norm_path in join_point_attr_dirty_paths.keys():
            if not _join_point_attr_promote_raw(norm_path):
                ok = false
                break
            if join_point_attr_names.contains_key(norm_path):
                val path_names: Dict<text, [text]> = join_point_attr_names[norm_path]
                if not _join_point_attr_promote_raw(path_names):
                    ok = false
                    break
            if join_point_attr_epochs_v2.contains_key(norm_path):
                val path_epochs: Dict<text, i64> = join_point_attr_epochs_v2[norm_path]
                if not _join_point_attr_promote_raw(path_epochs):
                    ok = false
                    break
    if ok:
        for dirty_fn in join_point_attr_dirty_fn_names:
            if not _join_point_attr_promote_raw(dirty_fn):
                ok = false
                break
    if ok:
        for dirty_names in join_point_attr_dirty_name_lists:
            if not _join_point_attr_promote_raw(dirty_names):
                ok = false
                break
    if ok:
        _join_point_attr_clear_dirty()
    ok

export join_point_attr_begin_epoch_v2, join_point_attr_epoch_matches_v2, join_point_attr_record, join_point_attr_record_empty, join_point_attr_names_of, join_point_attr_reset, join_point_attr_promote_transient_owner
