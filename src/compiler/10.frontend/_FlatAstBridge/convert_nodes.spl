# Iteration 17 probe plumbing (UNGATED, Trap D): trace ExprKind discs at
# construction time to find where the stage4 flat-bridge Expr goes bad.

use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use std.nogc_sync_mut.io.process_ops.{eprint}
# `rt_env_get` returns nil for an UNSET variable, so its return type must be
# declared optional. Declaring it `-> text` made the wrapper below propagate
# that nil out of a non-optional return, which the SFFI return-contract
# validator (wired 2026-08-21) correctly rejects with
# `nil is forbidden by the non-optional return contract of 'flat_bridge_env_get'`
# — every parse that consulted an unset env var then died. The wrapper stays
# total by collapsing an unset variable to the empty string, which is exactly
# what all of its `?? ""` call sites already assumed.
extern fn rt_env_get(key: text) -> text?

fn flat_bridge_env_get(key: text) -> text:
    rt_env_get(key) ?? ""

fn flat_bridge_trace_enabled() -> bool:
    (flat_bridge_env_get("SIMPLE_COMPILER_TRACE") ?? "") == "1"

fn flat_is_bootstrap_entry_path(path: text) -> bool:
    # Match the bootstrap entry regardless of how the path is spelled by the
    # caller. The native-build driver passes it as `src/app/cli/bootstrap_main.spl`
    # (no leading `/` or `./`), which the previous `/src/...` / `./src/...`
    # patterns missed — so flat_ast_to_module returned an empty module and the
    # entry's real functions never reached HIR/MIR lowering (bug
    # bootstrap_stage2_empty_mir_bodies_2026-07-05).
    #
    # SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE=1 means the driver (driver.spl
    # parse_all_impl / lower_and_check_impl) is treating EVERY source in the
    # resolved --entry-closure import closure as needing real HIR lowering,
    # not just the single --entry file. Without this check, every non-entry
    # module in the closure (e.g. a plain helper imported by the entry) still
    # got routed to flat_empty_module() here at the parse layer, so its
    # functions never reached HIR — cross-module calls into it then failed
    # HIR name resolution ("unresolved name: <fn>") even though the driver
    # believed it had lowered the whole closure (bug
    # bootstrap_stage2_empty_mir_bodies_2026-07-05, cross-module closure gap).
    if flat_bridge_env_get("SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE") == "1":
        return true
    val native_entry = flat_bridge_env_get("SIMPLE_NATIVE_BUILD_ENTRY") ?? ""
    if native_entry != "":
        return path == native_entry or path.ends_with("/" + native_entry)
    path.ends_with("bootstrap_main.spl")

fn flat_bootstrap_function_count() -> i64:
    if (flat_bridge_env_get("SIMPLE_BOOTSTRAP") ?? "") == "1" and flat_bridge_trace_enabled():
        eprint("[flat-bridge] fn-count:start")
    var count = 0
    var i = 0
    val decl_count = module_decl_count_get()
    while i < decl_count:  # leaked 64-decl guard removed — see module_assembly.spl cap note
        val decl_idx = module_decl_at(i)
        if decl_get_tag(decl_idx) == 1:
            count = count + 1
        i = i + 1
    if (flat_bridge_env_get("SIMPLE_BOOTSTRAP") ?? "") == "1" and flat_bridge_trace_enabled():
        eprint("[flat-bridge] fn-count:done {count}")
    count

fn flat_bootstrap_function_at(index: i64) -> ParserFunction:
    if (flat_bridge_env_get("SIMPLE_BOOTSTRAP") ?? "") == "1" and flat_bridge_trace_enabled():
        eprint("[flat-bridge] fn-at:start {index}")
    var seen = 0
    var i = 0
    val decl_count = module_decl_count_get()
    while i < decl_count:  # leaked 64-decl guard removed — see module_assembly.spl cap note
        val decl_idx = module_decl_at(i)
        if decl_get_tag(decl_idx) == 1:
            if seen == index:
                if (flat_bridge_env_get("SIMPLE_BOOTSTRAP") ?? "") == "1" and flat_bridge_trace_enabled():
                    eprint("[flat-bridge] fn-at:decl {decl_idx}")
                val fn_: ParserFunction = convert_decl_fn(decl_idx)
                if (flat_bridge_env_get("SIMPLE_BOOTSTRAP") ?? "") == "1" and flat_bridge_trace_enabled():
                    eprint("[flat-bridge] fn-at:done")
                return fn_
            seen = seen + 1
        i = i + 1
    parser_function_new(
        "",
        [],
        [],
        false,
        Type(kind: TypeKind.Infer, span: make_span()),
        Block(stmts: [], span: make_span()),
        Visibility.Private,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        [],
        false,
        "",
        contract_block_empty(),
        make_span()
    )

fn flat_bootstrap_function_decl_at(index: i64) -> i64:
    var seen = 0
    var i = 0
    val decl_count = module_decl_count_get()
    while i < decl_count:  # leaked 64-decl guard removed — see module_assembly.spl cap note
        val decl_idx = module_decl_at(i)
        if decl_get_tag(decl_idx) == 1:
            if seen == index:
                return decl_idx
            seen = seen + 1
        i = i + 1
    -1

fn flat_bootstrap_body_at(index: i64) -> Block:
    Block(stmts: [], span: make_span())

fn make_span() -> Span:
    Span(start: 0, end: 0, line: 0, col: 0, file: "", length: 0)

fn flat_expr_span(idx: i64) -> Span:
    val span_id = expr_get_span(idx)
    if not span_is_valid(span_id):
        return make_span()
    val start = span_start(span_id)
    val end = span_end(span_id)
    Span(start: start, end: end, line: span_line(span_id), col: span_col(span_id),
        file: module_get_path(), length: end - start)

# Lane NIL1 (convert-nodes-loud-fallback, doc/08_tracking/bug/
# spawn_call_expr_silently_becomes_nillit_2026-07-29.md): convert_flat_expr and
# convert_flat_stmt each end in a generic "unhandled/unmapped node kind ->
# fall through to a bare NilLit/no-op" catch-all. Every prior instance of this
# EXACT fallback firing on a real node kind (slice-index, cast, assign,
# compound-assign, range, spread, dict-lit, block-bodied lambda -- see the
# comment trail on each of those cases above) was independently rediscovered
# via a silent-wrong-answer user report, because the fallback itself recorded
# no diagnostic. `spawn(...)` call expressions are one more, previously
# unpatched instance of the same class (EXPR_SPAWN has no dispatch arm above).
# Route the *fallback itself* through the parser's real error channel
# (`parser_error`, the same fn `[parser_error] ...`-prefixed diagnostics used
# throughout core/parser.spl use) so `parser_has_errors()` -- what
# parse_full_frontend/driver.spl actually gate on -- goes true and every FUTURE
# unmapped node kind surfaces at parse time instead of requiring a fresh
# user-visible repro. Still returns the NilLit/no-op shape afterward (error
# recovery, not a hard stop) so downstream lowering doesn't crash on the
# missing value.
#
# NOTE: `span` here is always the zeroed `make_span()` sentinel (see the
# `decl_span_for` comment above) -- no real per-node source location survives
# into this bridge below the per-declaration granularity, so the message can
# only name the tag, not a line/col. That is a pre-existing bridge limitation,
# not something reintroduced by this lane.
fn flat_bridge_report_unhandled_node(kind_label: text, tag: i64):
    parser_error("flat AST bridge: unhandled " + kind_label + " node kind (tag=" + int_to_str(tag) + ") silently converted to nil/no-op -- add a case to convert_nodes.spl's convert_flat_" + kind_label + " (see doc/08_tracking/bug/spawn_call_expr_silently_becomes_nillit_2026-07-29.md)")

# Bug hir_lowering_never_populates_function_spans: the flat AST DOES record a
# real (start, end, line, col) for every declaration (parse_fn_decl captures
# decl_line/decl_col before parsing the body and stores them via
# flat_span_new -> decl_span[idx], see fn_struct_decls.spl:387-388,476-477).
# `make_span()` above discards that and hands every converted node a
# Span(0,0,0,0) -- this is the actual data available for a declaration's own
# span. Falls back to make_span() only if the span id is out of range (should
# not happen for a real decl, but a wrong line is worse than a missing one).
fn decl_span_for(idx: i64) -> Span:
    val span_id = decl_get_span(idx)
    if not span_is_valid(span_id):
        return make_span()
    val s = span_start(span_id)
    val e = span_end(span_id)
    Span(start: s, end: e, line: span_line(span_id), col: span_col(span_id), file: "", length: e - s)

fn flat_empty_module(path: text) -> ParserModule:
    parser_module_new(
        name: path,
        imports: [],
        exports: [],
        domain_blocks: [],
        functions: {},
        function_order: [],
        classes: {},
        actors: {},
        actor_order: [],
        structs: {},
        enums: {},
        bitfields: {},
        traits: {},
        impls: [],
        type_aliases: {},
        constants: {},
        static_asserts: [],
        aop_advices: [],
        di_bindings: [],
        arch_rules: [],
        mock_decls: [],
        tagged_layer: "",
        layer_dag_edges: "",
        # Passed EXPLICITLY, never left to the trailing defaults declared on
        # parser_module_new. The native trailing-default pad
        # (50.mir/_MirLoweringExpr/switch_operators_calls.spl
        # pad_trailing_default_args) did NOT fire for this cross-module callee
        # in the stage-2 self-hosted compiler, so both slots arrived as nil
        # instead of []. That nil reached module_surface_promote, whose
        # rt_transient_heap_promote(nil) returns false, and Stage 3 aborted at
        # driver_source_pipeline_parsing.spl on the very first source file.
        # See doc/08_tracking/bug/stage3_module_surface_promote_nil_authority_arrays_2026-08-23.md
        friends: [],
        internal_exports: []
    )

fn convert_decl_visibility(idx: i64) -> Visibility:
    val vis_text = decl_get_visibility_text(idx)
    if vis_text == "public":
        return Visibility.Public
    if vis_text == "peer":
        return Visibility.Peer
    if vis_text == "up":
        return Visibility.Up
    if vis_text == "internal":
        return Visibility.Internal
    if vis_text == "package":
        return Visibility.Package
    Visibility.Private

fn convert_decl_is_public(idx: i64) -> bool:
    decl_get_visibility_text(idx) == "public"

fn convert_flat_type(type_expr_idx: i64) -> Type:
    if type_expr_idx <= 0:
        return Type(kind: TypeKind.Infer, span: make_span())
    # STAGE-3 IMPORTED-MODULE-`val` MISREAD -- root fix for the whole family
    # (blocker #7, cd81ef3d85df, plus the two earlier pinning rounds).
    #
    # Every `type_expr_idx == TYPE_<X>` that used to live here read TYPE_<X> as
    # an IMPORTED module-level `val` (declared in compiler/core/types.spl).
    # Under the stage-3/4 self-hosted build those cross-module reads come back
    # wrong, so the comparison silently took the WRONG branch and emitted no
    # diagnostic. `any` (TYPE_ANY = 12) was the case that stopped the stage-3
    # self-host: it fell through the entire == chain to the TypeKind.Infer
    # catch-all at the bottom, HIR carried HirTypeKind.Infer into MIR
    # lower_type -- whose Infer arm is error_fatal -- and
    # `struct BackendPort { run_fn: any, ... }` aborted the build with
    # "bootstrap flat MIR type registration failed: unsupported MIR type kind".
    # Earlier rounds hit the same thing on TYPE_I64 and TYPE_TEXT.
    #
    # The previous workaround was hand-written ordered literal bounds
    # (`type_expr_idx > 4 and type_expr_idx < 6`) placed ahead of each ==. That
    # works -- a literal needs no imported read -- but it DUPLICATED
    # compiler/core/types.spl's tag numbering here with nothing tying the two
    # copies together (renumber a tag there and these literals would silently
    # disagree, and because the pins ran first the STALE meaning would win),
    # and it only ever covered the tags someone had already been bitten by:
    # 1..9, 11, 12, 14..18, 27..33. Tags 0, 10, 13 and 19..26 stayed exposed.
    #
    # Fix the family instead of adding a 34th pin: do the comparison in the
    # module that DECLARES the constants. `fixed_type_tag_name`
    # (compiler/core/types.spl) compares against the TYPE_* vals INTRA-module
    # -- the same reason is_dict_tag/is_result_tag/is_tuple_type_tag below have
    # always worked on this path -- and returns a canonical name; this file
    # dispatches on a text literal, exactly as convert_decl_visibility above
    # already does. Result: no imported-`val` comparison anywhere in this
    # function, one copy of the numbering, and all of 0..33 covered.
    #
    # Per-tag behaviour is deliberately IDENTICAL to before, including for the
    # tags that map to nothing useful. "struct" (10) and the
    # Union/Intersection/Refinement markers (24..26) had no arm before and
    # still resolve to Infer. "nil" (13) and Result/Future/Poll/Task/Generic
    # (19..23) keep their existing Named(...) mapping even though the HIR name
    # resolver (20.hir/hir_lowering/types.spl) does not accept those names --
    # making them loud is a separate decision, not this lane's.
    val fixed_tag_name = fixed_type_tag_name(type_expr_idx)
    if fixed_tag_name != "":
        if fixed_tag_name == "void":
            return Type(kind: TypeKind.Named("void", []), span: make_span())
        if fixed_tag_name == "bool":
            return Type(kind: TypeKind.Named("bool", []), span: make_span())
        if fixed_tag_name == "i64":
            return Type(kind: TypeKind.Named("i64", []), span: make_span())
        if fixed_tag_name == "f64":
            return Type(kind: TypeKind.Named("f64", []), span: make_span())
        if fixed_tag_name == "text":
            return Type(kind: TypeKind.Named("text", []), span: make_span())
        if fixed_tag_name == "u8":
            return Type(kind: TypeKind.Named("u8", []), span: make_span())
        if fixed_tag_name == "u16":
            return Type(kind: TypeKind.Named("u16", []), span: make_span())
        if fixed_tag_name == "u32":
            return Type(kind: TypeKind.Named("u32", []), span: make_span())
        if fixed_tag_name == "u64":
            return Type(kind: TypeKind.Named("u64", []), span: make_span())
        if fixed_tag_name == "i8":
            return Type(kind: TypeKind.Named("i8", []), span: make_span())
        if fixed_tag_name == "i16":
            return Type(kind: TypeKind.Named("i16", []), span: make_span())
        if fixed_tag_name == "i32":
            return Type(kind: TypeKind.Named("i32", []), span: make_span())
        if fixed_tag_name == "[i64]":
            return Type(kind: TypeKind.Array(Type(kind: TypeKind.Named("i64", []), span: make_span()), nil), span: make_span())
        if fixed_tag_name == "[text]":
            return Type(kind: TypeKind.Array(Type(kind: TypeKind.Named("text", []), span: make_span()), nil), span: make_span())
        if fixed_tag_name == "[bool]":
            return Type(kind: TypeKind.Array(Type(kind: TypeKind.Named("bool", []), span: make_span()), nil), span: make_span())
        if fixed_tag_name == "[any]":
            return Type(kind: TypeKind.Array(Type(kind: TypeKind.Named("Any", []), span: make_span()), nil), span: make_span())
        if fixed_tag_name == "dict":
            return Type(kind: TypeKind.Named("Dict", []), span: make_span())
        if fixed_tag_name == "fn":
            return Type(kind: TypeKind.Named("fn", []), span: make_span())
        if fixed_tag_name == "any":
            return Type(kind: TypeKind.Named("Any", []), span: make_span())
        if fixed_tag_name == "nil":
            return Type(kind: TypeKind.Named("nil", []), span: make_span())
        if fixed_tag_name == "Option":
            return Type(kind: TypeKind.Named("Option", []), span: make_span())
        if fixed_tag_name == "Option<i64>":
            return Type(kind: TypeKind.Named("Option", [Type(kind: TypeKind.Named("i64", []), span: make_span())]), span: make_span())
        if fixed_tag_name == "Option<f64>":
            return Type(kind: TypeKind.Named("Option", [Type(kind: TypeKind.Named("f64", []), span: make_span())]), span: make_span())
        if fixed_tag_name == "Option<text>":
            return Type(kind: TypeKind.Named("Option", [Type(kind: TypeKind.Named("text", []), span: make_span())]), span: make_span())
        if fixed_tag_name == "Option<bool>":
            return Type(kind: TypeKind.Named("Option", [Type(kind: TypeKind.Named("bool", []), span: make_span())]), span: make_span())
        if fixed_tag_name == "Result":
            return Type(kind: TypeKind.Named("Result", []), span: make_span())
        if fixed_tag_name == "Future":
            return Type(kind: TypeKind.Named("Future", []), span: make_span())
        if fixed_tag_name == "Poll":
            return Type(kind: TypeKind.Named("Poll", []), span: make_span())
        if fixed_tag_name == "Task":
            return Type(kind: TypeKind.Named("Task", []), span: make_span())
        if fixed_tag_name == "Generic":
            return Type(kind: TypeKind.Named("Generic", []), span: make_span())
        # "struct" (10) and "Union"/"Intersection"/"Refinement" (24..26) had no
        # arm in the old == chain and reached the Infer catch-all; preserved.
        return Type(kind: TypeKind.Infer, span: make_span())
    # Dict<K,V> specialization (bug: dicttype): the parser registers each
    # distinct Dict<K,V> annotation's key/value tags and encodes the result
    # as TYPE_DICT_BASE + id (see core.types.dict_type_register). Recover the
    # real key/value Type args here instead of silently collapsing to the
    # bare, argless Dict above -- this check must precede the generic
    # `>= TYPE_UNION_BASE` catch-all below since is_dict_tag's range also
    # satisfies that comparison.
    if is_dict_tag(type_expr_idx):
        val did = dict_tag_to_id(type_expr_idx)
        val key_tag = dict_type_get_key(did)
        val value_tag = dict_type_get_value(did)
        return Type(kind: TypeKind.Named("Dict", [convert_flat_type(key_tag), convert_flat_type(value_tag)]), span: make_span())
    if is_result_tag(type_expr_idx):
        val rid = result_tag_to_id(type_expr_idx)
        return Type(kind: TypeKind.Named("Result", [convert_flat_type(result_type_get_ok(rid)), convert_flat_type(result_type_get_err(rid))]), span: make_span())
    # Tuple type annotation `(A, B, C)` (e.g. an extern fn's declared tuple
    # return): the parser registers the element tags (types.spl
    # TYPE_TUPLE_BASE registry, mirroring Dict<K,V>/Result above) instead of
    # collapsing to TYPE_ANY. Rebuild the real TypeKind.Tuple here so HIR
    # lower_type produces HirTypeKind.Tuple and a destructure of a
    # tuple-returning call types each element correctly (parity case
    # process_run_timeout). Must precede the `>= TYPE_UNION_BASE` catch-all
    # below, same as the dict/result checks.
    if is_tuple_type_tag(type_expr_idx):
        val tuple_tag_id = tuple_type_tag_to_id(type_expr_idx)
        val tuple_elem_type_tags = tuple_type_get_elems(tuple_tag_id)
        var tuple_elem_types: [Type] = []
        var tt_i = 0
        while tt_i < tuple_elem_type_tags.len():
            tuple_elem_types.push(convert_flat_type(tuple_elem_type_tags[tt_i]))
            tt_i = tt_i + 1
        return Type(kind: TypeKind.Tuple(tuple_elem_types), span: make_span())
    # Array element-type specialization (bug: array-class-param-sigsegv): the
    # array-type parser (parser.spl's `[T]` branch) only has dedicated flat
    # tags for i64/text/bool/Any element types; a named class/struct/enum
    # element (e.g. `[Counter]`) registers its element tag here instead of
    # silently collapsing to bare TYPE_ARRAY_I64 -- see
    # TYPE_ARRAY_GENERIC_BASE. Must precede the generic `>= TYPE_UNION_BASE`
    # catch-all below, same as the dict/result/tuple checks.
    # Option inner-type specialization (bug:
    # native_option_unwrap_receiver_unresolved_2026-08-09): the type parser has
    # dedicated flat tags only for Option<i64/f64/text/bool>; a named
    # class/struct/enum inner (`Option<Drv2>`, `Drv2?`) registers its inner tag
    # here instead of collapsing to the bare, argless `Named("Option", [])`
    # above -- which erased the payload identity and left MIR's static
    # devirtualization with no owner name for `opt.unwrap().method()`. Must
    # precede the generic `>= TYPE_UNION_BASE` catch-all below, same as the
    # dict/result/tuple/array checks.
    if is_option_generic_tag(type_expr_idx):
        val option_generic_id = option_generic_tag_to_id(type_expr_idx)
        val option_inner_tag = option_generic_type_get_inner(option_generic_id)
        return Type(kind: TypeKind.Named("Option", [convert_flat_type(option_inner_tag)]), span: make_span())
    if is_array_generic_tag(type_expr_idx):
        val arr_generic_id = array_generic_tag_to_id(type_expr_idx)
        val arr_elem_tag = array_generic_type_get_elem(arr_generic_id)
        return Type(kind: TypeKind.Array(convert_flat_type(arr_elem_tag), nil), span: make_span())
    # Isolated capability-prefixed type `iso T` (LANE ISO2, doc/08_tracking/
    # bug/iso_mut_capability_prefix_not_parsed_2026-07-29.md): the parser
    # registers the inner type tag (core.types.isolated_type_register,
    # mirrors the Dict/Result/Tuple/array-element registries above) and
    # encodes TYPE_ISOLATED_BASE + id. Rebuild the real TypeKind.Isolated(T)
    # here instead of falling into the TYPE_UNION_BASE+ catch-all below (that
    # catch-all would stringify the raw tag via type_tag_name and produce a
    # bogus Named(...) type). Must precede that catch-all, same as the dict/
    # result/tuple/array checks above.
    if is_isolated_tag(type_expr_idx):
        val iso_id = isolated_tag_to_id(type_expr_idx)
        val iso_inner_tag = isolated_type_get_inner(iso_id)
        return Type(kind: TypeKind.Isolated(convert_flat_type(iso_inner_tag)), span: make_span())
    # Exclusive capability-prefixed type `mut T` retains its inner type and
    # mutability instead of collapsing to a plain/inferred annotation.
    if is_exclusive_tag(type_expr_idx):
        val exclusive_id = exclusive_tag_to_id(type_expr_idx)
        val exclusive_inner_tag = exclusive_type_get_inner(exclusive_id)
        return Type(kind: TypeKind.Reference(convert_flat_type(exclusive_inner_tag), true), span: make_span())
    if is_reference_tag(type_expr_idx):
        val reference_id = reference_tag_to_id(type_expr_idx)
        val reference_inner_tag = reference_type_get_inner(reference_id)
        val reference_mutable = reference_type_is_mutable(reference_id)
        return Type(kind: TypeKind.Reference(convert_flat_type(reference_inner_tag), reference_mutable), span: make_span())
    if is_pointer_tag(type_expr_idx):
        val pointer_id = pointer_tag_to_id(type_expr_idx)
        val pointer_inner_tag = pointer_type_get_inner(pointer_id)
        val pointer_mutable = pointer_type_is_mutable(pointer_id)
        val pointer_inner_type = convert_flat_type(pointer_inner_tag)
        # `*R` on a declared resource is the "shared RC" ownership sigil
        # (WP-B design §3/§7); on any other type it stays a plain raw
        # pointer. Recorded here, not in the parser -- see the note on the
        # `@T`/`-T` parser branches in `core/parser.spl` for why bridge time
        # is the earliest point `resource_is_declared` can read true.
        val pointer_resource_name = parser_type_kind_named_name(pointer_inner_type.kind)
        if pointer_resource_name != "" and resource_is_declared(pointer_resource_name):
            resource_registry_note_ownership(pointer_resource_name, "shared")
        return Type(kind: TypeKind.Pointer(pointer_inner_type, pointer_mutable), span: make_span())
    # Resource-ownership sigil `@T` -- atomic ref-counted sharing (WP-B).
    # Gated on the resource's own `thread_safe: true` metadata (design §3/§7
    # invariant 8): an atomic-shared resource whose extern retain/release
    # pair is not documented thread-safe is a silent-corruption trap, not a
    # style choice, so this is a hard diagnostic, not a warning.
    if is_atomic_tag(type_expr_idx):
        val atomic_id = atomic_tag_to_id(type_expr_idx)
        val atomic_inner_tag = atomic_type_get_inner(atomic_id)
        val atomic_inner_type = convert_flat_type(atomic_inner_tag)
        val atomic_resource_name = parser_type_kind_named_name(atomic_inner_type.kind)
        if atomic_resource_name != "" and resource_is_declared(atomic_resource_name):
            if resource_meta_thread_safe(atomic_resource_name) != "true":
                parser_error("'@" + atomic_resource_name + "' (atomic RC sharing) requires resource '" + atomic_resource_name + "' to declare thread_safe: true")
            else:
                resource_registry_note_ownership(atomic_resource_name, "atomic")
        return Type(kind: TypeKind.Atomic(atomic_inner_type), span: make_span())
    # Resource-ownership sigil `-T` -- weak reference (WP-B). No legality
    # gate: a weak reference to a resource is always representable regardless
    # of that resource's sharing/thread-safety metadata.
    if is_weak_tag(type_expr_idx):
        val weak_id = weak_tag_to_id(type_expr_idx)
        val weak_inner_tag = weak_type_get_inner(weak_id)
        val weak_inner_type = convert_flat_type(weak_inner_tag)
        val weak_resource_name = parser_type_kind_named_name(weak_inner_type.kind)
        if weak_resource_name != "" and resource_is_declared(weak_resource_name):
            resource_registry_note_ownership(weak_resource_name, "weak")
        return Type(kind: TypeKind.Weak(weak_inner_type), span: make_span())
    # Lane S4 (union normalization, hardening plan §10.3): a structural union
    # `A | B | C` is registered by the parser in the TYPE_UNION_BASE registry
    # exactly the way Dict<K,V>/Result<T,E>/(A,B) are. Before this arm the tag
    # fell through to the `is_union_base_or_above` catch-all below and became
    # an opaque `Named("<tag>")` that the HIR name resolver does not accept --
    # i.e. the union erased to Infer/Any, which is precisely what §8.4 forbids
    # (closed sum > Any). Rebuild the real member list so HIR lowering produces
    # HirTypeKind.Union and union_normalize can synthesize its @closed enum.
    # Must precede the catch-all: is_union_tag's range also satisfies it.
    if is_union_tag(type_expr_idx):
        val uid = union_tag_to_id(type_expr_idx)
        var union_members: [Type] = []
        for member_tag in union_type_get_members(uid):
            union_members = union_members.push(convert_flat_type(member_tag))
        if union_members.len() > 0:
            return Type(kind: TypeKind.Union(union_members), span: make_span())
    if is_union_base_or_above(type_expr_idx):
        return Type(kind: TypeKind.Named(type_tag_name(type_expr_idx), []), span: make_span())
    # type_expr_idx falls in the tag-space hole (34..TYPE_UNION_BASE-1) here, so
    # it must be a real expr-arena index. It can go stale when it was captured
    # (e.g. an extern fn's `-> T` return type, threaded through by #146) before
    # an interleaved ast_reset() cleared/refilled the shared flat AST arena --
    # observed OOB (index 48, length 13) crashing the seed interpreter on
    # src/app/io/process_ops.spl. Bounds-check against the live arena length and
    # fall back to Infer (pre-#146 behavior) rather than reading out of range;
    # note this does not catch a stale-but-in-bounds index from a *smaller*
    # reset that still covers type_expr_idx.
    if type_expr_idx < 34 or type_expr_idx >= 500 or type_expr_idx >= expr_count():
        return Type(kind: TypeKind.Infer, span: make_span())
    val tag = expr_get_tag(type_expr_idx)
    if tag == EXPR_IDENT:
        Type(kind: TypeKind.Named(expr_get_str(type_expr_idx), []), span: make_span())
    elif tag == EXPR_INDEX:
        val base_name = expr_get_str(expr_get_left(type_expr_idx))
        var type_args: [Type] = []
        val arg_idx = expr_get_right(type_expr_idx)
        if arg_idx >= 0:
            type_args.push(convert_flat_type(arg_idx))
        Type(kind: TypeKind.Named(base_name, type_args), span: make_span())
    elif tag == EXPR_TUPLE:
        # Tuple TYPE annotation, e.g. an extern fn's `-> (text, text, i32)`
        # return (threaded through as an expr-arena index by #146, same as
        # `-> T`): the flat tag space has no TYPE_TUPLE, so the parser stores
        # the parenthesized element list as an EXPR_TUPLE node. Previously
        # this fell into the Infer catch-all below, erasing the element types
        # -- HIR lower_type then produced Error/i64 defaults and a tuple
        # destructure of the call result printed text handles as decimal
        # integers (parity case process_run_timeout).
        val tuple_type_args = expr_get_args(type_expr_idx)
        var tuple_type_elems: [Type] = []
        var tt_i = 0
        while tt_i < tuple_type_args.len():
            tuple_type_elems.push(convert_flat_type(tuple_type_args[tt_i]))
            tt_i = tt_i + 1
        Type(kind: TypeKind.Tuple(tuple_type_elems), span: make_span())
    else:
        Type(kind: TypeKind.Infer, span: make_span())

pub fn op_kind_to_binop(kind: i64) -> BinOp:
    if kind == 55: return BinOp.And
    if kind == 56: return BinOp.Or
    if kind == 60: return BinOp.Add
    if kind == 61: return BinOp.Sub
    if kind == 62: return BinOp.Mul
    if kind == 63: return BinOp.Div
    if kind == 64: return BinOp.Mod
    if kind == 65: return BinOp.Pow
    if kind == 66: return BinOp.Shl
    if kind == 67: return BinOp.Shr
    if kind == 80: return BinOp.Eq
    if kind == 81: return BinOp.NotEq
    if kind == 82: return BinOp.Lt
    if kind == 83: return BinOp.Gt
    if kind == 84: return BinOp.LtEq
    if kind == 85: return BinOp.GtEq
    if kind == 120: return BinOp.BitAnd
    if kind == 121: return BinOp.BitOr
    if kind == 122: return BinOp.BitXor
    if kind == 39: return BinOp.Is
    BinOp.Invalid

fn flat_compound_assign_op(kind: i64) -> AssignOp:
    # Op codes match parse_assignment()'s expr_compound_assign() calls in
    # core/parser_expr.spl (60=+=, 61=-=, 62=*=, 63=/=, 64=%=) -- the same
    # additive/multiplicative binary-op numbering used by op_kind_to_binop
    # above.
    if kind == 60: return AssignOp.Add
    if kind == 61: return AssignOp.Sub
    if kind == 62: return AssignOp.Mul
    if kind == 63: return AssignOp.Div
    if kind == 64: return AssignOp.Mod
    AssignOp.Add

# #148: op-kind decode for EXPR_UNARY (see parse_unary in parser_expr.spl for
# the token-kind -> expr_unary(kind, ...) mapping). kind == TOK_MINUS (61) is
# `-x` (Neg), kind == TOK_NOT (57) is `not x` (Not), kind 120 is `&x`
# (Ref), kind -120 is `&mut x` (RefMut), and kind == TOK_TILDE (123) is
# `~x` (BitNot). Mirrors op_kind_to_binop above.
fn op_kind_to_unaryop(kind: i64) -> UnaryOp:
    if kind == 57: return UnaryOp.Not
    if kind == 120: return UnaryOp.Ref
    if kind == -120: return UnaryOp.RefMut
    if kind == 123: return UnaryOp.BitNot
    if kind == 62: return UnaryOp.Deref
    UnaryOp.Neg

# Convert an expression-form if/else branch (stored as an EXPR id) into a Block.
# Block-form branches are EXPR_BLOCK (tag 18) carrying STMTS; ternary/inline
# branches are a bare expr wrapped as a single expression statement. Used by the
# EXPR_IF bridge so expression-if then/else bodies are not dropped.
fn flat_if_branch_block(branch_idx: i64, span: Span) -> Block:
    if branch_idx < 0:
        return Block(stmts: [], span: span)
    if expr_get_tag(branch_idx) == 18:
        val b_stmts = expr_get_stmts(branch_idx)
        var b_body: [Stmt] = []
        var bi = 0
        while bi < b_stmts.len():
            val expanded = convert_flat_stmt_in_list(b_stmts[bi], false)
            var bj = 0
            while bj < expanded.len():
                b_body.push(expanded[bj])
                bj = bj + 1
            bi = bi + 1
        val tail_idx = expr_get_left(branch_idx)
        if tail_idx >= 0:
            b_body.push(Stmt(
                kind: StmtKind.Expr(convert_flat_expr(tail_idx)),
                span: span
            ))
        return Block(stmts: b_body, span: span)
    var single: [Stmt] = []
    single.push(Stmt(kind: StmtKind.Expr(convert_flat_expr(branch_idx)), span: span))
    return Block(stmts: single, span: span)

fn flat_copy_text_list(values: [text]) -> [text]:
    var out: [text] = []
    for value in values:
        out.push(value)
    out

fn flat_asm_expr(asm_template_text: text, span: Span) -> AsmExpr:
    AsmExpr(
        asm_template: asm_template_text,
        is_volatile: true,
        constraints: [],
        clobbers: [],
        clobber_abis: [],
        options: [],
        span: span
    )

fn flat_asm_expr_with_operands(idx: i64, span: Span) -> AsmExpr:
    val values = expr_get_args(idx)
    val names = expr_get_arg_names(idx)
    val kinds = expr_get_asm_kinds(idx)
    val locations = expr_get_asm_locations(idx)
    val clobbers = expr_get_asm_clobbers(idx)
    val outputs = expr_get_asm_outputs(idx)
    var plain_clobbers: [text] = []
    var clobber_abis: [text] = []
    var asm_options: [text] = []
    for item in clobbers:
        if item.starts_with("clobber_abi:"):
            clobber_abis.push(item[12..])
        elif item.starts_with("options:"):
            for option in item[8..].split(","):
                val normalized_option = option.trim()
                if normalized_option != "":
                    asm_options.push(normalized_option)
        elif item.starts_with("clobber:"):
            plain_clobbers.push(item[8..])
    var constraints: [AsmConstraint] = []
    var operand_index = 0
    while operand_index < values.len():
        val kind_text = if operand_index < kinds.len(): kinds[operand_index] else: "in"
        val location_text = if operand_index < locations.len(): locations[operand_index] else: "reg"
        val kind = match kind_text:
            case "out": AsmConstraintKind.Out
            case "inout": AsmConstraintKind.InOut
            case "lateout": AsmConstraintKind.LateOut
            case _: AsmConstraintKind.In
        val location = match location_text:
            case "reg": AsmLocation.Reg
            case "mem": AsmLocation.Mem
            case "imm": AsmLocation.Imm
            case _: AsmLocation.RegSpec(location_text)
        val name = if operand_index < names.len(): names[operand_index] else: ""
        constraints.push(AsmConstraint(
            name: name,
            kind: kind,
            location: location,
            value: convert_flat_expr(values[operand_index]),
            output_value: if operand_index < outputs.len() and outputs[operand_index] >= 0: convert_flat_expr(outputs[operand_index]) else: nil,
            span: span
        ))
        operand_index = operand_index + 1
    AsmExpr(
        asm_template: expr_get_str(idx),
        is_volatile: true,
        constraints: constraints,
        clobbers: plain_clobbers,
        clobber_abis: clobber_abis,
        options: asm_options,
        span: span
    )

fn flat_asm_spec_from_arm(arm_idx: i64, span: Span) -> AsmTargetSpec:
    var versions: [AsmVersionConstraint] = []
    val ops = asm_arm_ver_ops[arm_idx]
    val vals = asm_arm_ver_vals[arm_idx]
    var vi = 0
    while vi < ops.len() and vi < vals.len():
        versions.push(AsmVersionConstraint(op: ops[vi], version: vals[vi]))
        vi = vi + 1
    AsmTargetSpec(
        archs: flat_copy_text_list(asm_arm_archs[arm_idx]),
        has_os: asm_arm_os[arm_idx] != "",
        os: asm_arm_os[arm_idx],
        has_abi: asm_arm_abi[arm_idx] != "",
        abi: asm_arm_abi[arm_idx],
        has_backend: asm_arm_backend[arm_idx] != "",
        backend: asm_arm_backend[arm_idx],
        version_constraints: versions,
        span: span
    )

fn flat_asm_match_arm(arm_idx: i64, span: Span) -> AsmMatchArm:
    val is_compile_error = asm_arm_is_compile_error[arm_idx]
    val wildcard = asm_arm_is_wildcard[arm_idx]
    AsmMatchArm(
        has_spec: not wildcard,
        spec: flat_asm_spec_from_arm(arm_idx, span),
        is_wildcard: wildcard,
        has_asm_body: not is_compile_error,
        asm_body: flat_asm_expr(asm_arm_asm_text[arm_idx], span),
        is_compile_error: is_compile_error,
        error_message: asm_arm_error_msg[arm_idx],
        span: span
    )

fn flat_bridge_build_string_interps(value: text, span: Span) -> [Interpolation]:
    # Bug #136 (normal native path): the core lexer copies each `{expr}`
    # interpolation region VERBATIM into the string token and never parses the
    # inner expression, so the bridge previously emitted StringLit(value, nil)
    # and the MIR interpolation lowering (lower_string_interpolation) had no
    # parts to splice -- `{expr}` printed literally. Scan top-level `{...}`
    # regions here (brace-depth tracked so nested braces stay in one region,
    # mirroring the MIR split logic) and sub-parse each inner into a real Expr
    # so the HIR/MIR interpolation chain can evaluate and splice it. If any
    # region is not a clean single expression, return [] so the string is
    # treated as a plain literal (preserves brace-bearing non-interp strings
    # like CSS/JSON).
    var interps: [Interpolation] = []
    var depth = 0
    var inner = ""
    var i = 0
    val n = value.len()
    while i < n:
        val ch = value[i:i + 1]
        val ch_next = if i + 1 < n: value[i + 1:i + 2] else: ""
        if depth == 0 and ch == "{" and ch_next == "{":
            # `{{` escape (Python f-string / Rust format! parity; doc
            # interp_brace_literal_collides_with_string_interpolation): a
            # literal `{` written doubled so it is never mistaken for the
            # start of an interpolation region. Do not open a region --
            # split_interpolation_segments (MIR layer) applies the same
            # doubled-brace skip so the literal-segment positions stay
            # aligned with this function's interps list.
            i = i + 1
        elif depth == 0 and ch == "}" and ch_next == "}":
            # `}}` escape, mirror of `{{` above.
            i = i + 1
        elif depth == 0 and ch == "{":
            depth = 1
            inner = ""
        elif depth > 0 and ch == "{":
            depth = depth + 1
            inner = inner + ch
        elif depth > 0 and ch == "}":
            depth = depth - 1
            if depth == 0:
                val part_idx = parse_interpolation_fragment(inner)
                if part_idx < 0:
                    return []
                interps.push(Interpolation(
                    expr: convert_flat_expr(part_idx),
                    has_format: false,
                    format: "",
                    span: span
                ))
            else:
                inner = inner + ch
        elif depth > 0:
            inner = inner + ch
        i = i + 1
    if depth != 0:
        return []
    interps

fn flat_bridge_decode_brace_escapes(value: text) -> text:
    """Bug interp_brace_literal_collides_with_string_interpolation: a string
    made up ENTIRELY of `{{`/`}}` escapes (no real `{expr}` placeholder) skips
    the MIR interpolation-lowering path entirely (has_interps stays false, see
    expr_dispatch.spl), so nothing downstream ever decodes the doubled braces
    -- decode them to single literal ones here, directly on the plain-literal
    text. (When a real placeholder IS also present, str_val is left untouched
    and split_interpolation_segments -- 50.mir -- does this same decode while
    splitting segments, since that path needs positional alignment with the
    interps list instead of a standalone text rewrite.)

    NOTE: does not use an Option-based "still needs processing" signal here
    on purpose -- this runtime's `[T]?` representation cannot distinguish
    `Some([])` from `nil` (an empty list and an absent value both come back
    as an empty/false `.?` check), so signaling through the interps field
    silently degrades an intended `Some([])` into `nil`.
    """
    var result = ""
    var i = 0
    val n = value.len()
    while i < n:
        val ch = value[i:i + 1]
        val ch_next = if i + 1 < n: value[i + 1:i + 2] else: ""
        if ch == "{" and ch_next == "{":
            result = result + "{"
            i = i + 2
        elif ch == "}" and ch_next == "}":
            result = result + "}"
            i = i + 2
        else:
            result = result + ch
            i = i + 1
    result

fn convert_flat_expr(idx: i64) -> Expr:
    if idx < 0:
        return Expr(kind: ExprKind.NilLit, span: make_span())
    val tag = expr_get_tag(idx)
    val span = flat_expr_span(idx)
    if tag <= 0:
        print "[flat-bridge] missing expr tag idx={idx} tag={tag}"
        return Expr(kind: ExprKind.NilLit, span: span)
    if tag == EXPR_INT_LIT:
        return Expr(kind: ExprKind.IntLit(expr_get_int(idx)), span: span)
    if tag == EXPR_FLOAT_LIT:
        return Expr(kind: ExprKind.FloatLit(expr_get_float(idx).to_float()), span: span)
    if tag == EXPR_STRING_LIT:
        val str_val = expr_get_str(idx)
        if expr_get_int(idx) != 0:
            return Expr(kind: ExprKind.StringLit(str_val, nil), span: span)
        val str_interps = flat_bridge_build_string_interps(str_val, span)
        if str_interps.len() > 0:
            return Expr(kind: ExprKind.StringLit(str_val, str_interps), span: span)
        else:
            # No real `{expr}` placeholder (str_interps is empty). Decode any
            # `{{`/`}}` escapes directly since nothing downstream will (see
            # flat_bridge_decode_brace_escapes).
            return Expr(kind: ExprKind.StringLit(flat_bridge_decode_brace_escapes(str_val), nil), span: span)
    if tag == EXPR_BOOL_LIT:
        return Expr(kind: ExprKind.BoolLit(expr_get_int(idx) != 0), span: span)
    if tag == EXPR_NIL_LIT:
        return Expr(kind: ExprKind.NilLit, span: span)
    if tag == EXPR_BLOCK:
        # Blocks are general expression nodes, not only if/lambda helpers.
        # Route every standalone block through the same statement-preserving
        # conversion so a declaration-level initializer cannot fall into the
        # loud unsupported-node guard.
        return Expr(kind: ExprKind.Block(flat_if_branch_block(idx, span)), span: span)
    if tag == EXPR_IDENT:
        return Expr(kind: ExprKind.Ident(expr_get_str(idx)), span: span)
    if tag == EXPR_CALL:
        val callee = convert_flat_expr(expr_get_left(idx))
        val arg_indices = expr_get_args(idx)
        val arg_names = expr_get_arg_names(idx)
        var args: [CallArg] = []
        var ai = 0
        while ai < arg_indices.len():
            val arg_name = if ai < arg_names.len(): arg_names[ai] else: ""
            args = args.push(CallArg(
                has_name: arg_name != "",
                name: arg_name,
                value: convert_flat_expr(arg_indices[ai]),
                span: span
            ))
            ai = ai + 1
        val call_kind: ExprKind = ExprKind.Call(callee, args)
        return Expr(kind: call_kind, span: span)
    if tag == EXPR_BINARY:
        val left = convert_flat_expr(expr_get_left(idx))
        val right = convert_flat_expr(expr_get_right(idx))
        val op = op_kind_to_binop(expr_get_int(idx))
        return Expr(kind: ExprKind.Binary(op, left, right), span: span)
    if tag == EXPR_UNARY:
        # #148: this used to hardcode UnaryOp.Neg for EVERY unary expression,
        # discarding the actual operator code (expr_get_int) entirely -- so
        # `not x` silently compiled as `-x`. For a 0/1 boolean operand, `-x`
        # negated ARITHMETICALLY happens to preserve the SAME truthiness as
        # `x` itself (`-1 != 0` iff `1 != 0`, and `-0 == 0`), so `not <bool>`
        # behaved as an identity no-op instead of a logical inversion -- e.g.
        # `if not a.starts_with(...)` took the SAME branch `if
        # a.starts_with(...)` would have. Decode the real operator via
        # op_kind_to_unaryop (mirrors op_kind_to_binop just above for Binary).
        val operand = convert_flat_expr(expr_get_left(idx))
        val unary_op = op_kind_to_unaryop(expr_get_int(idx))
        return Expr(kind: ExprKind.Unary(unary_op, operand), span: span)
    if tag == EXPR_FIELD_ACCESS:
        val obj = convert_flat_expr(expr_get_left(idx))
        val field_name = expr_get_str(idx)
        return Expr(kind: ExprKind.Field(obj, field_name), span: span)
    if tag == EXPR_METHOD_CALL:
        val obj = convert_flat_expr(expr_get_left(idx))
        val method_name = expr_get_str(idx)
        val m_arg_indices = expr_get_args(idx)
        val m_arg_names = expr_get_arg_names(idx)
        var m_args: [CallArg] = []
        var mai = 0
        while mai < m_arg_indices.len():
            val m_arg_name = if mai < m_arg_names.len(): m_arg_names[mai] else: ""
            m_args = m_args.push(CallArg(
                has_name: m_arg_name != "",
                name: m_arg_name,
                value: convert_flat_expr(m_arg_indices[mai]),
                span: span
            ))
            mai = mai + 1
        return Expr(kind: ExprKind.MethodCall(obj, method_name, m_args), span: span)
    if tag == EXPR_INDEX:
        val obj = convert_flat_expr(expr_get_left(idx))
        val index = convert_flat_expr(expr_get_right(idx))
        return Expr(kind: ExprKind.Index(obj, index), span: span)
    if tag == EXPR_SLICE:
        # Bug (array/string slice-index silently -> NilLit -> SIGSEGV): a
        # bracket-colon slice `a[1:3]` parses as a DEDICATED EXPR_SLICE flat
        # node (LEFT=base, RIGHT=start, EXTRA=end) -- NOT an EXPR_INDEX over
        # an EXPR_RANGE, and NOT any node handled by this if/elif chain at
        # all. It fell all the way to the final `else: return
        # Expr(kind: ExprKind.NilLit, ...)` fallback below, silently
        # producing a bare nil/0 value in place of the sliced result. On the
        # ARRAY-index read path (expr_dispatch.spl's `case Index`) that nil
        # then got inttoptr'd and GEP/load'd as if it were a real array
        # pointer -- a NULL-pointer dereference (SIGSEGV) instead of a clean
        # build error, the worst form of "silent wrong" this lane must catch.
        # `ExprKind` (parser_types_expr.spl) has no dedicated Slice variant
        # of its own to preserve the 3-operand shape, but `lower_method_call`
        # (method_calls_literals.spl) already has a real, tested `"slice"`/
        # `"substring"` implementation for STRING receivers (spl_str_slice) --
        # reusing that MethodCall shape here both (a) makes `s[1:3]` on a
        # string receiver actually WORK for the first time (previously it hit
        # this same NilLit fallback), and (b) makes an ARRAY receiver (which
        # that method-call arm does not special-case) fall through cleanly to
        # the existing generic `case Unresolved:` "unresolved method call:
        # slice" LOUD build failure -- matching the established loud-fail
        # convention for other genuinely-unsupported array operations
        # (.pop()/.first()/.last()) instead of crashing at runtime.
        val slice_obj = convert_flat_expr(expr_get_left(idx))
        val slice_start = convert_flat_expr(expr_get_right(idx))
        val slice_end = convert_flat_expr(expr_get_extra(idx))
        val slice_call_args: [CallArg] = [
            CallArg(has_name: false, name: "", value: slice_start, span: span),
            CallArg(has_name: false, name: "", value: slice_end, span: span)
        ]
        return Expr(kind: ExprKind.MethodCall(slice_obj, "slice", slice_call_args), span: span)
    if tag == EXPR_ARRAY_LIT:
        val elem_indices = expr_get_args(idx)
        var elems: [Expr] = []
        var ei = 0
        while ei < elem_indices.len():
            elems.push(convert_flat_expr(elem_indices[ei]))
            ei = ei + 1
        return Expr(kind: ExprKind.ArrayLit(elems), span: span)
    if tag == EXPR_ARRAY_REPEAT:
        val rep_value = convert_flat_expr(expr_get_left(idx))
        val rep_count = convert_flat_expr(expr_get_right(idx))
        return Expr(kind: ExprKind.ArrayRepeat(rep_value, rep_count), span: span)
    if tag == EXPR_INTERPOLATED_STRING:
        val parts = expr_get_args(idx)
        var interpolations: [Interpolation] = []
        var ii = 0
        while ii < parts.len():
            interpolations.push(Interpolation(
                expr: convert_flat_expr(parts[ii]),
                has_format: false,
                format: "",
                span: span
            ))
            ii = ii + 1
        return Expr(kind: ExprKind.StringLit(expr_get_str(idx), interpolations), span: span)
    if tag == EXPR_IF:
        # Keep expression-form elif chains flat as well. Reconstructing nested
        # value-semantic ExprKind.If payloads copies the growing tail in no-GC
        # bootstrap builds even when the source walk itself is iterative.
        var arms: [IfArm] = []
        var current = idx
        var terminal_else_idx = -1
        var walking = true
        val live_expr_count = expr_count()
        var walked_arms = 0
        while walking:
            # Expression elif nodes are allocated tail-first just like the
            # statement form below: each next arm is an older, smaller arena
            # index. Bound and validate the scalar walk before recursively
            # converting either branch. This keeps corrupt/cyclic flat input
            # from repeatedly copying a growing ExprKind.IfChain payload in
            # the no-GC Stage-3 compiler.
            if current < 0 or current >= live_expr_count or walked_arms >= live_expr_count:
                flat_bridge_report_unhandled_node("if-expr-chain", current)
                return Expr(kind: ExprKind.NilLit, span: span)
            walked_arms = walked_arms + 1
            val arm_span = make_span()
            arms.push(IfArm(
                cond: convert_flat_expr(expr_get_left(current)),
                then_: flat_if_branch_block(expr_get_right(current), arm_span),
                span: arm_span
            ))
            val next_idx = expr_get_extra(current)
            if next_idx >= 0 and expr_get_tag(next_idx) == EXPR_IF:
                if next_idx >= current:
                    flat_bridge_report_unhandled_node("if-expr-chain-order", next_idx)
                    return Expr(kind: ExprKind.NilLit, span: span)
                current = next_idx
            else:
                terminal_else_idx = next_idx
                walking = false
        if terminal_else_idx >= 0 and expr_get_tag(terminal_else_idx) != 33:
            return Expr(kind: ExprKind.IfChain(arms, flat_if_branch_block(terminal_else_idx, span)), span: span)
        return Expr(kind: ExprKind.IfChain(arms, nil), span: span)
    if tag == EXPR_MATCH:
        # `match` used as a VALUE, e.g. `val r = match n: case 1: 10 case _:
        # 99`. Mirrors the STMT_MATCH conversion below (same arm-id/pattern/
        # guard/body accessors -- expr_match_expr's parser constructor stores
        # scrutinee in LEFT and arms in ARGS, exactly like stmt_match_stmt
        # stores them in EXPR/BODY) but returns a real ExprKind.MatchCase
        # directly instead of wrapping a statement, so match-as-a-value
        # reaches HIR/MIR lowering as a genuine value-producing expression
        # instead of being silently dropped by the fallback NilLit case below.
        val em_scrut = convert_flat_expr(expr_get_left(idx))
        val em_arm_ids = expr_get_args(idx)
        var em_arms: [MatchArm] = []
        var emi = 0
        while emi < em_arm_ids.len():
            val em_arm_id = em_arm_ids[emi]
            val em_pat = convert_flat_pattern(arm_get_pattern(em_arm_id))
            val em_body_ids: [i64] = arm_get_body(em_arm_id)
            var em_arm_body: [Stmt] = []
            var embi = 0
            while embi < em_body_ids.len():
                val em_expanded = convert_flat_stmt_in_list(em_body_ids[embi], false)
                var emk = 0
                while emk < em_expanded.len():
                    em_arm_body.push(em_expanded[emk])
                    emk = emk + 1
                embi = embi + 1
            val em_guard_eid = arm_get_guard(em_arm_id)
            var em_g_has = false
            var em_g_expr = Expr(kind: ExprKind.NilLit, span: span)
            if em_guard_eid >= 0:
                em_g_has = true
                em_g_expr = convert_flat_expr(em_guard_eid)
            em_arms.push(MatchArm(
                pattern: em_pat,
                has_guard: em_g_has,
                guard: em_g_expr,
                body: Block(stmts: em_arm_body, span: span),
                span: span
            ))
            emi = emi + 1
        return Expr(kind: ExprKind.MatchCase(em_scrut, em_arms), span: span)
    if tag == EXPR_RETURN:
        val ret_expr = convert_flat_expr(expr_get_left(idx))
        return Expr(kind: ExprKind.Return(ret_expr), span: span)
    if tag == EXPR_LAMBDA:
        val lambda_body_exprs = expr_get_stmts(idx)
        # A block-bodied lambda (`\x:` followed by an indented multi-statement
        # body) is parsed by wrapping the WHOLE statement list in a single
        # EXPR_BLOCK node (tag 18; see _ParserPrimary/primary_expr.spl's
        # backslash-lambda case: `lam_stmts.push(expr_block(blk_stmts, -1, 0))`)
        # -- lambda_body_exprs is always a 1-element list, holding either that
        # EXPR_BLOCK node or a bare expression (single-expression body).
        # convert_flat_expr has NO case for EXPR_BLOCK (only flat_if_branch_block,
        # used by if/else expression branches, knows how to unwrap it), so
        # calling convert_flat_expr directly on an EXPR_BLOCK silently fell
        # through to the generic fallback (NilLit), discarding every statement
        # AND the tail value -- every block-bodied lambda call returned the
        # same garbage constant regardless of input. Reuse the same EXPR_BLOCK
        # -> Block conversion the if-expression bridge already uses, then wrap
        # it as ExprKind.Block so HIR/MIR thread the tail value through
        # lower_hir_block / lower_block exactly like if/match arm bodies do.
        val body_expr = if lambda_body_exprs.len() > 0:
            val lam_body0 = lambda_body_exprs[0]
            if expr_get_tag(lam_body0) == EXPR_BLOCK:
                Expr(kind: ExprKind.Block(flat_if_branch_block(lam_body0, span)), span: span)
            else:
                convert_flat_expr(lam_body0)
        else:
            Expr(kind: ExprKind.NilLit, span: span)
        var lambda_params: [LambdaParam] = []
        val lp_names = expr_get_args(idx)
        var lpi = 0
        while lpi < lp_names.len():
            val lp_idx = lp_names[lpi]
            lambda_params.push(LambdaParam(
                name: expr_get_str(lp_idx),
                has_type_: false,
                type_: Type(kind: TypeKind.Infer, span: span),
                span: span
            ))
            lpi = lpi + 1
        return Expr(kind: ExprKind.Lambda(lambda_params, body_expr), span: span)
    if tag == EXPR_NULL_COALESCE:
        val lhs = convert_flat_expr(expr_get_left(idx))
        val rhs = convert_flat_expr(expr_get_right(idx))
        return Expr(kind: ExprKind.NullCoalesce(lhs, rhs), span: span)
    if tag == EXPR_OPTIONAL_CHAIN:
        val obj = convert_flat_expr(expr_get_left(idx))
        return Expr(kind: ExprKind.OptionalChain(obj, expr_get_str(idx)), span: span)
    if tag == EXPR_STRUCT_LIT:
        val struct_name = expr_get_str(idx)
        val field_exprs = expr_get_args(idx)
        var fields: [(text, Expr)] = []
        var fi = 0
        while fi < field_exprs.len():
            val field_idx = field_exprs[fi]
            fields.push((expr_get_str(field_idx), convert_flat_expr(expr_get_left(field_idx))))
            fi = fi + 1
        return Expr(kind: ExprKind.StructLit(struct_name, fields), span: span)
    if tag == EXPR_TUPLE:
        val tuple_args = expr_get_args(idx)
        var tuple_elems: [Expr] = []
        var tui = 0
        while tui < tuple_args.len():
            tuple_elems.push(convert_flat_expr(tuple_args[tui]))
            tui = tui + 1
        return Expr(kind: ExprKind.TupleLit(tuple_elems), span: span)
    if tag == EXPR_DICT_LIT:
        # Dict literal `{k: v, ...}`: the parser stores key node indices in the
        # ARGS slot and value node indices in the STMTS slot (see
        # expr_dict_lit(keys, vals, ...) / placeholder_lambda EXPR_DICT_LIT). The
        # bridge previously dropped both and emitted an empty DictLit, so every
        # `{...}` compiled to an empty dict (native path: rt_dict_new with no
        # rt_dict_set). Rebuild the (key, value) entries here.
        val dict_key_indices = expr_get_args(idx)
        val dict_val_indices = expr_get_stmts(idx)
        var dict_entries: [(Expr, Expr)] = []
        var dict_ei = 0
        while dict_ei < dict_key_indices.len() and dict_ei < dict_val_indices.len():
            val dict_key = convert_flat_expr(dict_key_indices[dict_ei])
            val dict_val = convert_flat_expr(dict_val_indices[dict_ei])
            dict_entries.push((dict_key, dict_val))
            dict_ei = dict_ei + 1
        return Expr(kind: ExprKind.DictLit(dict_entries), span: span)
    if tag == EXPR_UNIT:
        return Expr(kind: ExprKind.NilLit, span: span)
    if tag == EXPR_PASS or tag == EXPR_PASS_DO_NOTHING or tag == EXPR_PASS_DN or tag == EXPR_PASS_TODO:
        return Expr(kind: ExprKind.NilLit, span: span)
    if tag == EXPR_EXISTS_CHECK:
        val inner = convert_flat_expr(expr_get_left(idx))
        return Expr(kind: ExprKind.ExistsCheck(inner), span: span)
    if tag == EXPR_FORCE_UNWRAP:
        val fu_inner = convert_flat_expr(expr_get_left(idx))
        return Expr(kind: ExprKind.ForceUnwrap(fu_inner), span: span)
    if tag == EXPR_TRY:
        val try_inner = convert_flat_expr(expr_get_left(idx))
        return Expr(kind: ExprKind.Try(try_inner), span: span)
    if tag == EXPR_CAST:
        # `expr as Type` -- expr_cast() stores the operand in LEFT and the
        # already-resolved target type tag (from parser_parse_type()) in the
        # I slot. Without this case, casts fell through to the final `else`
        # below and silently became NilLit -- e.g. a bitfield read's tail
        # expression `inst.opcode as u32` turned into a no-op, which surfaced
        # downstream as a bogus Unit-typed MIR local.
        val cast_operand = convert_flat_expr(expr_get_left(idx))
        val cast_type = convert_flat_type(expr_get_int(idx))
        return Expr(kind: ExprKind.Cast(cast_operand, cast_type), span: span)
    if tag == EXPR_SUFFIXED_LIT:
        # `5i32` / `2.5f32` -- typed-suffix literal. Without this arm the
        # node fell through to the final `else` and became NilLit, so EVERY
        # suffixed literal compiled as the tagged-nil constant 3 (NVMe rv32
        # fw mask-361 failures, 2026-07-24). Lower exactly like the
        # equivalent `<lit> as <suffix>` cast, which the pipeline handles.
        val suf_type = Type(kind: TypeKind.Named(expr_get_str(idx), []), span: span)
        val suf_float_text = expr_get_float(idx)
        if suf_float_text != "":
            return Expr(kind: ExprKind.Cast(Expr(kind: ExprKind.FloatLit(suf_float_text.to_float()), span: span), suf_type), span: span)
        return Expr(kind: ExprKind.Cast(Expr(kind: ExprKind.IntLit(expr_get_int(idx)), span: span), suf_type), span: span)
    if tag == EXPR_ASM:
        return Expr(kind: ExprKind.AsmBlock(flat_asm_expr_with_operands(idx, span)), span: span)
    if tag == EXPR_ASM_MATCH:
        var arms: [AsmMatchArm] = []
        val arm_indices = expr_get_args(idx)
        var ai = 0
        while ai < arm_indices.len():
            arms.push(flat_asm_match_arm(arm_indices[ai], span))
            ai = ai + 1
        return Expr(kind: ExprKind.AsmMatch(arms), span: span)
    if tag == EXPR_UNSAFE_BLOCK:
        # unsafe: / danger: block — same AST node the seed parser produces
        # (ExprKind.UnsafeBlock, parser_types_expr.spl), so HIR lowering and
        # the safety checker see one shape regardless of the parsing lane.
        val u_stmts = expr_get_stmts(idx)
        var u_body: [Stmt] = []
        var ui = 0
        while ui < u_stmts.len():
            u_body.push(convert_flat_stmt(u_stmts[ui]))
            ui = ui + 1
        val u_caps_raw = expr_get_str(idx)
        var u_caps: [text] = []
        if u_caps_raw != "":
            u_caps = u_caps_raw.split(",")
        return Expr(kind: ExprKind.UnsafeBlock(Block(stmts: u_body, span: span), u_caps), span: span)
    if tag == EXPR_CUSTOM_BLOCK:
        val custom_kind = expr_get_str(idx)
        val payload_expr = expr_get_left(idx)
        val custom_payload = if payload_expr >= 0: expr_get_str(payload_expr) else: ""
        return Expr(kind: ExprKind.CustomBlock(custom_kind, BlockValue.Raw(custom_payload)), span: span)
    if tag == EXPR_ASSIGN:
        # `target = value` -- the flat parser emits assignment as an
        # EXPRESSION statement (stmt_expr_stmt(expr_assign(...))), never
        # STMT_ASSIGN. Without this case, assignments fell through to the
        # final `else` and silently became NilLit -- e.g. a bitfield field
        # write `inst.opcode = next_opcode` vanished from MIR entirely
        # (same drop pattern as EXPR_CAST above).
        val assign_target = convert_flat_expr(expr_get_left(idx))
        val assign_value = convert_flat_expr(expr_get_right(idx))
        return Expr(kind: ExprKind.Assign(assign_target, nil, assign_value), span: span)
    if tag == EXPR_COMPOUND_ASSIGN:
        # `target += value` (and -=, *=, /=, %=) -- the parser already builds
        # a dedicated EXPR_COMPOUND_ASSIGN node (op code in the I slot, target
        # in LEFT, value in RIGHT; see expr_compound_assign() in
        # core/_AstExpr/nodes.spl). This bridge had NO case for it, so every
        # compound-assign fell through to the final `else` below and silently
        # became NilLit -- e.g. `x += 5` compiled to a no-op that left `x`
        # unchanged on the native --entry build path (same silent-drop
        # pattern as EXPR_CAST/EXPR_ASSIGN/EXPR_RANGE above). Mirrors the
        # plain EXPR_ASSIGN case just above; HIR lowering
        # (hir_lowering/statements.spl's lower_hir_assign_op_opt) already
        # fully supports the AssignOp slot, it just never received one.
        val compound_target = convert_flat_expr(expr_get_left(idx))
        val compound_value = convert_flat_expr(expr_get_right(idx))
        val compound_op = flat_compound_assign_op(expr_get_int(idx))
        return Expr(kind: ExprKind.Assign(compound_target, Some(compound_op), compound_value), span: span)
    if tag == EXPR_LIST_COMP:
        val comp_body = convert_flat_expr(expr_get_right(idx))
        val comp_iterable = convert_flat_expr(expr_get_left(idx))
        val comp_iter_name = expr_get_str(idx)
        var comp_clauses: [ComprehensionClause] = []
        comp_clauses.push(ComprehensionClause(
            kind: ComprehensionKind.For(comp_iter_name, comp_iterable),
            span: span
        ))
        val comp_cond_idx = expr_get_extra(idx)
        if comp_cond_idx >= 0:
            val comp_cond_expr = convert_flat_expr(comp_cond_idx)
            comp_clauses.push(ComprehensionClause(
                kind: ComprehensionKind.If(comp_cond_expr),
                span: span
            ))
        return Expr(kind: ExprKind.ListComprehension(comp_body, comp_clauses), span: span)
    if tag == EXPR_RANGE:
        # Root cause for the native `--entry` build path: this bridge is the
        # sole translator from the flat/tree-sitter-style AST (expr_alloc
        # nodes) into the tree-shaped Expr used by the rest of the pipeline
        # (resolve -> hir_lowering -> mir lowering). EXPR_RANGE had NO case
        # here, so every `for i in start..end:` iterable silently fell to
        # the `else:` catch-all at the bottom of this function and came out
        # as `ExprKind.NilLit` instead of `ExprKind.Range(...)`. Downstream,
        # mir_lowering_stmts.spl's `lower_for` never saw a Range `iter.kind`,
        # so it ALWAYS took the generic iterator-protocol fallback
        # (lower_for_iterator), which panics with "for-in over non-array
        # iterables is not supported" for anything that isn't a runtime
        # array -- i.e. every native-build range-based `for` loop crashed at
        # runtime. Mirrors the accessor calls already used for the exact
        # same EXPR_RANGE node shape by the other backends in this
        # directory (see cg_stmt.spl / cg_expr.spl / eval.spl): LEFT=start,
        # RIGHT=end, I=inclusive flag. This flat node has no step slot
        # (expr_range() takes no step argument), so step is always nil here.
        val range_start_idx = expr_get_left(idx)
        val range_end_idx = expr_get_right(idx)
        val range_start: Expr? = if range_start_idx >= 0: convert_flat_expr(range_start_idx) else: nil
        val range_end: Expr? = if range_end_idx >= 0: convert_flat_expr(range_end_idx) else: nil
        val range_inclusive = expr_get_int(idx) != 0
        return Expr(kind: ExprKind.Range(range_start, range_end, range_inclusive, nil), span: span)
    if tag == EXPR_SPREAD:
        # ParserStruct-update/construct spread (`Ctor(..base, field: val)`) parses
        # to a dedicated flat EXPR_SPREAD node (core/_AstExpr/nodes.spl's
        # expr_spread, tag 46) via parser_expr.spl's parse_call_arg_raw --
        # but this bridge had NO case for it, so every spread argument fell
        # through to the `else:` catch-all below and became `ExprKind.NilLit`
        # (same silent-drop pattern as the EXPR_RANGE fix just above). The
        # rest of the pipeline (lower_struct_construct in
        # 50.mir/_MirLoweringExpr/switch_operators_calls.spl, mirroring the
        # interpreter-side fix in interpreter_call/core/class_instantiation.rs)
        # already expects the established "unlabeled Range{start: None, end:
        # Some(base)}" encoding for a paren-form spread argument -- emit that
        # exact shape here instead of NilLit. Before this fix, `Point(..base,
        # y: 99)` silently miscompiled: the NilLit argument consumed the
        # first positional field slot (evaluating to the ABI's raw
        # nil-sentinel payload, 3) and every other unclaimed field was
        # zero-filled, instead of inheriting from `base` (see bug doc
        # native_build_fresh_seed_optionwrap_landmine_2026-07-18.md, "SCOPE
        # CORRECTION" section).
        val spread_inner_idx = expr_get_left(idx)
        val spread_inner: Expr? = if spread_inner_idx >= 0: convert_flat_expr(spread_inner_idx) else: nil
        return Expr(kind: ExprKind.Range(nil, spread_inner, false, nil), span: span)
    if tag == EXPR_SPAWN:
        # `spawn <expr>` (EXPR_SPAWN, tag 39) -- built unconditionally by
        # core/_ParserPrimary/primary_expr.spl:477-479 from ordinary source
        # text, because `spawn` lexes as the reserved KwSpawn token (kind 197),
        # never TOK_IDENT. This bridge had NO arm for it, so every real
        # `spawn(w)` fell into the generic catch-all below and came out as a
        # bare `ExprKind.NilLit` -- callee AND every argument discarded, the
        # call's side effects silently never happening. Bug doc:
        # doc/08_tracking/bug/spawn_call_expr_silently_becomes_nillit_2026-07-29.md
        #
        # Emit an ordinary Call, NOT `ExprKind.Spawn`. Two independent reasons,
        # both verified against current source rather than assumed:
        #   1. `20.hir/hir_lowering/expressions.spl`'s `lower_hir_expr` match has
        #      no `case ExprKind.Spawn` arm -- it would fall to
        #      `case _: self.error("unsupported expression kind", ...)`, i.e.
        #      trading a silent drop for a hard lowering error.
        #   2. Every LIVE consumer of a spawn site in this compiler matches the
        #      callee NAME on a plain Call: `30.types/type_system/checker.spl`,
        #      `30.types/type_system/builtin_registry.spl`,
        #      `50.mir/mir_effects.spl`, and rule E1049 in
        #      `35.semantics/safety_checker.spl:907`. Rebuilding the plain-call
        #      shape is what makes those fire on real source for the first time.
        #
        # The flat node stores the operand in LEFT. For `spawn(w)` the keyword
        # is consumed first and `parse_expr()` then yields the PARENTHESIZED
        # operand (`w`), not a call node -- so the argument list is exactly
        # [operand]. For `spawn f(a, b)` the operand is itself an EXPR_CALL and
        # becomes the single argument, matching how a `spawn(f(a, b))` source
        # form already reads.
        val spawn_inner_idx = expr_get_left(idx)
        if spawn_inner_idx < 0:
            flat_bridge_report_unhandled_node("expr", tag)
            return Expr(kind: ExprKind.NilLit, span: span)
        val spawn_callee = Expr(kind: ExprKind.Ident("spawn"), span: span)
        val spawn_arg = CallArg(
            has_name: false,
            name: "",
            value: convert_flat_expr(spawn_inner_idx),
            span: span
        )
        return Expr(kind: ExprKind.Call(spawn_callee, [spawn_arg]), span: span)
    if tag == EXPR_AWAIT:
        # Same family as EXPR_SPAWN above: `await <expr>` (tag 37) is built by
        # primary_expr.spl:436-439 from real source and had no arm here either,
        # so it silently became NilLit. Unlike Spawn, `ExprKind.Await` IS
        # handled downstream (`20.hir/hir_lowering/expressions.spl:965-966`
        # lowers it to `HirExprKind.Await`), so emit the real node.
        val await_inner_idx = expr_get_left(idx)
        if await_inner_idx < 0:
            flat_bridge_report_unhandled_node("expr", tag)
            return Expr(kind: ExprKind.NilLit, span: span)
        return Expr(kind: ExprKind.Await(convert_flat_expr(await_inner_idx)), span: span)
    if tag == EXPR_YIELD:
        # `yield <expr>` (tag 38), primary_expr.spl:441-444. Same silent-NilLit
        # collapse; `ExprKind.Yield(Expr?)` is handled by
        # `20.hir/hir_lowering/expressions.spl:954-960`. The operand slot is
        # optional here to match the enum's `Expr?` payload.
        val yield_inner_idx = expr_get_left(idx)
        val yield_inner: Expr? = if yield_inner_idx >= 0: convert_flat_expr(yield_inner_idx) else: nil
        return Expr(kind: ExprKind.Yield(yield_inner), span: span)
    if tag == EXPR_DICT_COMP:
        val dc_args = expr_get_args(idx)
        if dc_args.len() < 2:
            return Expr(kind: ExprKind.NilLit, span: span)
        val dc_key = convert_flat_expr(dc_args[0])
        val dc_val = convert_flat_expr(dc_args[1])
        val dc_iterable = convert_flat_expr(expr_get_left(idx))
        val dc_iter_name = expr_get_str(idx)
        var dc_clauses: [ComprehensionClause] = []
        dc_clauses.push(ComprehensionClause(
            kind: ComprehensionKind.For(dc_iter_name, dc_iterable),
            span: span
        ))
        val dc_cond_idx = expr_get_extra(idx)
        if dc_cond_idx >= 0:
            val dc_cond_expr = convert_flat_expr(dc_cond_idx)
            dc_clauses.push(ComprehensionClause(
                kind: ComprehensionKind.If(dc_cond_expr),
                span: span
            ))
        return Expr(kind: ExprKind.DictComprehension(dc_key, dc_val, dc_clauses), span: span)
    else:
        # Generic "we don't know what this expr node kind is" fallback -- see
        # flat_bridge_report_unhandled_node's doc comment. Every tag with a
        # dedicated arm above returns before reaching here; this is reached
        # only for a tag with NO arm at all (e.g. EXPR_SPAWN today).
        flat_bridge_report_unhandled_node("expr", tag)
        return Expr(kind: ExprKind.NilLit, span: span)

fn convert_flat_pattern(pat_eid: i64) -> Pattern:
    """Convert a match-arm 'pattern' (parsed as an EXPRESSION in the flat AST)
    into a structured Pattern. `Shape.Circle(x)` is EXPR_CALL over an
    EXPR_FIELD_ACCESS -> ParserEnum(Shape, Circle, Tuple([Binding x])); bare
    `Shape.Red` -> unit ParserEnum; `_` -> Wildcard; other ident -> Binding;
    literal -> Literal."""
    val pspan = make_span()
    if pat_eid < 0:
        return Pattern(kind: PatternKind.Wildcard, span: pspan)
    val ptag = expr_get_tag(pat_eid)
    if ptag == EXPR_METHOD_CALL:
        # `Shape.Circle(x)` parses as a METHOD_CALL: receiver=Shape (obj),
        # method=Circle (variant), args=[x] (payload bindings) -- same form as
        # enum construction.
        val mc_obj = expr_get_left(pat_eid)
        val mc_enum = if expr_get_tag(mc_obj) == EXPR_IDENT: expr_get_str(mc_obj) else: ""
        val mc_variant = expr_get_str(pat_eid)
        var mc_sub: [Pattern] = []
        for a_eid in expr_get_args(pat_eid):
            if expr_get_tag(a_eid) == EXPR_IDENT:
                mc_sub.push(Pattern(kind: PatternKind.Binding(expr_get_str(a_eid), false), span: pspan))
            else:
                mc_sub.push(convert_flat_pattern(a_eid))
        if mc_sub.len() == 0:
            return Pattern(kind: PatternKind.Enum(mc_enum, mc_variant, nil), span: pspan)
        return Pattern(kind: PatternKind.Enum(mc_enum, mc_variant, EnumPatternPayload.Tuple(mc_sub)), span: pspan)
    elif ptag == EXPR_CALL:
        val callee = expr_get_left(pat_eid)
        if expr_get_tag(callee) == EXPR_FIELD_ACCESS:
            val base = expr_get_left(callee)
            val enum_name = if expr_get_tag(base) == EXPR_IDENT: expr_get_str(base) else: ""
            val variant = expr_get_str(callee)
            var sub: [Pattern] = []
            for a_eid in expr_get_args(pat_eid):
                if expr_get_tag(a_eid) == EXPR_IDENT:
                    sub.push(Pattern(kind: PatternKind.Binding(expr_get_str(a_eid), false), span: pspan))
                else:
                    sub.push(convert_flat_pattern(a_eid))
            return Pattern(kind: PatternKind.Enum(enum_name, variant, EnumPatternPayload.Tuple(sub)), span: pspan)
        if expr_get_tag(callee) == EXPR_IDENT:
            # Bare variant pattern `Circle(r)` (no enum qualifier). Keep the
            # variant name and an empty enum name; MIR lowering resolves it
            # against the registered enums (never silently a Wildcard, which
            # made these arms fall through).
            val bare_variant = expr_get_str(callee)
            # `case complete b:` / `case dyn b:` region arms arrive as the
            # marker calls parse_match_region_marker() synthesizes (§2 of
            # doc/05_design/compiler/hardening/critical_completeness_design_2026-08-21.md).
            # They are NOT enum variants and must never degrade to a Binding or
            # a Wildcard: `complete` covers only the frozen complete region and
            # `dyn` only the open region, so treating either as a catch-all
            # would silently close a match over a missing STATIC constructor --
            # the exact defect §3's E-COMPLETE-001 exists to stop.
            # `case i64 v:` type-pattern arm -- the marker call
            # parse_match_type_pattern() synthesizes. Like the region markers
            # it is NOT an enum variant and must never degrade to a Binding
            # (which would make the arm an unconditional catch-all).
            if bare_variant == "__type_test":
                var tt_type = ""
                var tt_binder = ""
                for t_eid in expr_get_args(pat_eid):
                    if expr_get_tag(t_eid) == EXPR_IDENT:
                        if tt_type == "":
                            tt_type = expr_get_str(t_eid)
                        else:
                            tt_binder = expr_get_str(t_eid)
                return Pattern(kind: PatternKind.TypeTest(tt_type, tt_binder), span: pspan)
            if bare_variant == "__complete_region" or bare_variant == "__dyn_region":
                var region_binder = ""
                for r_eid in expr_get_args(pat_eid):
                    if expr_get_tag(r_eid) == EXPR_IDENT:
                        region_binder = expr_get_str(r_eid)
                if bare_variant == "__complete_region":
                    return Pattern(kind: PatternKind.CompleteRegion(region_binder), span: pspan)
                return Pattern(kind: PatternKind.DynRegion(region_binder), span: pspan)
            var bsub: [Pattern] = []
            for b_eid in expr_get_args(pat_eid):
                if expr_get_tag(b_eid) == EXPR_IDENT:
                    bsub.push(Pattern(kind: PatternKind.Binding(expr_get_str(b_eid), false), span: pspan))
                else:
                    bsub.push(convert_flat_pattern(b_eid))
            return Pattern(kind: PatternKind.Enum("", bare_variant, EnumPatternPayload.Tuple(bsub)), span: pspan)
        return Pattern(kind: PatternKind.Wildcard, span: pspan)
    elif ptag == EXPR_FIELD_ACCESS:
        val fbase = expr_get_left(pat_eid)
        val f_enum = if expr_get_tag(fbase) == EXPR_IDENT: expr_get_str(fbase) else: ""
        return Pattern(kind: PatternKind.Enum(f_enum, expr_get_str(pat_eid), nil), span: pspan)
    elif ptag == EXPR_IDENT:
        val nm = expr_get_str(pat_eid)
        if nm == "_":
            return Pattern(kind: PatternKind.Wildcard, span: pspan)
        return Pattern(kind: PatternKind.Binding(nm, false), span: pspan)
    elif ptag == EXPR_INT_LIT or ptag == EXPR_STRING_LIT or ptag == EXPR_BOOL_LIT or ptag == EXPR_NIL_LIT:
        # EXPR_NIL_LIT was NOT in this list and fell through to the Wildcard
        # catch-all below, so `case nil:` silently became an UNCONDITIONAL arm
        # matching every scrutinee -- the same class of defect the EXPR_BINARY
        # and EXPR_TUPLE cases below were added to fix. It is a genuine
        # literal test (`v == nil`), and over a union carrying a `nil` member
        # it is the arm that names that member (bug doc
        # union_narrowing_has_no_grammar_or_runtime_2026-08-21.md).
        return Pattern(kind: PatternKind.Literal(convert_flat_expr(pat_eid)), span: pspan)
    elif ptag == EXPR_BINARY:
        # `1 | 2 | 3` (or-pattern) parses as a chain of EXPR_BINARY(BitOr)
        # nodes -- patterns are parsed via the general expression parser
        # (see this function's docstring), and `|` has no dedicated
        # pattern-level token. Before this case existed, EXPR_BINARY had NO
        # match-pattern handling at all and fell through to the Wildcard
        # catch-all below -- so `case 1 | 2 | 3:` silently became an
        # UNCONDITIONAL Wildcard arm (matching every scrutinee value, not
        # just 1/2/3), and a genuine trailing `case _:` then tripped MIR's
        # "match has multiple wildcard arms" diagnostic -- which native-build
        # does not gate on, so the build "succeeded" and ran with a garbage
        # return value (matchpat lane finding). Only BitOr is a genuine
        # or-pattern; any other binary operator in pattern position has no
        # pattern meaning and still falls through to Wildcard unchanged
        # (pre-existing behavior, not tightened here).
        val pat_bin_op = op_kind_to_binop(expr_get_int(pat_eid))
        if pat_bin_op == BinOp.BitOr:
            val pat_bin_left = convert_flat_pattern(expr_get_left(pat_eid))
            val pat_bin_right = convert_flat_pattern(expr_get_right(pat_eid))
            var or_alts: [Pattern] = [pat_bin_left]
            match pat_bin_right.kind:
                case PatternKind.Or(more_alts):
                    for m_alt in more_alts:
                        or_alts.push(m_alt)
                case _:
                    or_alts.push(pat_bin_right)
            return Pattern(kind: PatternKind.Or(or_alts), span: pspan)
        return Pattern(kind: PatternKind.Wildcard, span: pspan)
    elif ptag == EXPR_TUPLE:
        # `(a, b, ...)` tuple-destructure pattern. Before this case existed,
        # EXPR_TUPLE fell through to the Wildcard catch-all below, so
        # `case (a, b): return a + b` silently matched anything WITHOUT
        # binding a/b -- the arm body's `a`/`b` references then resolved to
        # nothing, which happened to loud-fail downstream as "unresolved
        # name" (lucky side effect, not by design). Build the real Tuple
        # pattern so the a/b bindings actually exist.
        val tup_pat_indices = expr_get_args(pat_eid)
        var tup_pat_elems: [Pattern] = []
        var tpi = 0
        while tpi < tup_pat_indices.len():
            tup_pat_elems.push(convert_flat_pattern(tup_pat_indices[tpi]))
            tpi = tpi + 1
        return Pattern(kind: PatternKind.Tuple(tup_pat_elems), span: pspan)
    elif ptag == EXPR_RANGE:
        # `1..5` / `1..=5` range pattern -- mirrors the EXPR_RANGE gap fixed
        # elsewhere in this file for `for i in start..end:` iterables.
        # Before this case existed, EXPR_RANGE fell through to Wildcard.
        val rp_start_idx = expr_get_left(pat_eid)
        val rp_end_idx = expr_get_right(pat_eid)
        val rp_start: Expr? = if rp_start_idx >= 0: convert_flat_expr(rp_start_idx) else: nil
        val rp_end: Expr? = if rp_end_idx >= 0: convert_flat_expr(rp_end_idx) else: nil
        val rp_inclusive = expr_get_int(pat_eid) != 0
        return Pattern(kind: PatternKind.Range(rp_start, rp_end, rp_inclusive), span: pspan)
    # Level-gated (default off): every pattern shape that reaches this
    # catch-all is silently degraded to an UNCONDITIONAL wildcard -- it
    # matches everything and binds nothing, so an arm body that reads one of
    # its bindings fails HIR lowering with "unresolved name: <binding>".
    # SIMPLE_DEBUG_MATCH_PAT=1 names the dropped expression tag.
    if (flat_bridge_env_get("SIMPLE_DEBUG_MATCH_PAT") ?? "") == "1":
        eprint("[match-pat] convert_flat_pattern DROPPED to wildcard: tag={ptag}")
    return Pattern(kind: PatternKind.Wildcard, span: pspan)

# ============================================================================
# defer / errdefer support (native flat-AST-bridge path)
#
# ROOT CAUSE (bug #172): `StmtKind` (parser_types_expr.spl) has no Defer /
# ErrDefer variant, and `convert_flat_stmt`'s final `else:` branch silently
# turned any unrecognized raw tag (including STMT_DEFER=14 / STMT_ERRDEFER)
# into a no-op `NilLit` expression statement — the deferred statement's effect
# was discarded with zero diagnostics, while the rest of the function compiled
# and ran normally (silent wrong answer).
#
# Scope shipped here (task option 2, not full function-scope defer): a `defer`
# registered directly at the TOP LEVEL of a function body runs, in LIFO order,
# before every `return` in that function (including early returns nested in
# if/while/for) and at fall-off-the-end -- including when ordinary statements
# follow the `defer` (e.g. `fn work(): defer f(); g(); h()`, no explicit
# `return`), as long as the function has no declared `-> T` return type (see
# the `has_ret` fall-off-the-end block in `convert_decl_fn` below for why that
# guard exists: a declared return type gives the body's last statement an
# implicit-tail-value role that an appended defer-replay would silently
# steal, so that shape stays refused). Any OTHER placement — nested inside
# if/while/for/match, or `errdefer` anywhere — is refused with a LOUD build
# failure instead of a silent drop: it lowers to a reference to a
# deliberately-nonexistent identifier, which HIR name resolution rejects with
# "unresolved name: ..." (HIR lowering errors are fatal by default) and, as a
# second layer of insurance, MIR expression lowering independently rejects the same
# unresolved reference with "undefined variable: ..." (an existing fatal
# prefix in `_mir_error_is_fatal`, 80.driver/driver_pipeline.spl). No new
# classification entry is needed, so the build stops with a non-zero exit and
# no binary is produced.
#
# Block-form `defer:` (bug #172 follow-up, 2026-07-17): the pure-Simple
# parser (parser_stmts.spl) previously had no grammar for `defer:` /
# `errdefer:` followed by an indented body at all -- every such program
# failed to PARSE, before this bridge ever ran. `stmt_defer_block_stmt` /
# `stmt_errdefer_block_stmt` (ast_stmt.spl) now parse it, storing the body
# via `stmt_body` (EXPR left at the -1 "no expr" sentinel). This bridge
# extends the SAME top-level-only scope to the block form: a top-level
# `defer:` registers its whole body as one group in `g_pending_defers`
# (see the type's doc comment below) so it still replays as a single LIFO
# unit relative to other defers. Nested placement and `errdefer:` (block or
# single-line) remain refused exactly as before -- this only widens WHERE a
# `defer`'s own body can come from, not WHERE a `defer` may be written.
fn defer_unsupported_marker(span: Span) -> Stmt:
    Stmt(kind: StmtKind.Expr(Expr(kind: ExprKind.Ident("__defer_unsupported_placement__"), span: span)), span: span)

# Per-function stack of pending top-level `defer` replay statements, in
# encounter (registration) order. Reset/saved-and-restored around each
# `convert_decl_fn` call so nested function-like conversions (if any reuse
# this bridge) can't cross-contaminate an enclosing function's defer list.
#
# Each entry is a GROUP: the 1+ statements that make up ONE `defer`
# registration's replay body. A single-line `defer expr` group always has
# exactly one statement; a block-form `defer:` group (bug #172 follow-up) can
# have several. LIFO ordering applies BETWEEN groups (last-registered defer
# replays first); a group's OWN statements always replay in their original
# top-to-bottom order, since only one defer body is unwinding at a time.
var g_pending_defers: [[Stmt]] = []

# Convert one raw statement for inclusion in a statement LIST (function body,
# if/while/for/match body, ...). Unlike `convert_flat_stmt` (one raw stmt ->
# exactly one `Stmt`), this can expand to zero statements (a top-level defer
# registers itself and contributes nothing at its own position) or more than
# one (a `return` — at any nesting depth in this function — gets the current
# pending defers spliced in LIFO order immediately before it).
fn convert_flat_stmt_in_list(idx: i64, is_top_level: bool) -> [Stmt]:
    val tag = stmt_get_tag(idx)
    if tag == STMT_DEFER:
        if is_top_level:
            val d_span = make_span()
            val d_body = stmt_get_body(idx)
            if d_body.len() > 0:
                # Block-form `defer:` -- convert each body statement (in its
                # own written order) and register the whole group as one
                # pending-defer entry.
                var d_group: [Stmt] = []
                var dbi = 0
                while dbi < d_body.len():
                    val d_expanded = convert_flat_stmt_in_list(d_body[dbi], false)
                    var dbk = 0
                    while dbk < d_expanded.len():
                        d_group.push(d_expanded[dbk])
                        dbk = dbk + 1
                    dbi = dbi + 1
                g_pending_defers.push(d_group)
            else:
                val d_expr = convert_flat_expr(stmt_get_expr(idx))
                g_pending_defers.push([Stmt(kind: StmtKind.Expr(d_expr), span: d_span)])
            return []
        else:
            return [defer_unsupported_marker(make_span())]
    elif tag == STMT_ERRDEFER:
        # errdefer (run-only-on-error) semantics are not implemented on the
        # native path at all yet — refuse loudly everywhere, top-level or not.
        return [defer_unsupported_marker(make_span())]
    elif tag == STMT_RETURN:
        var out: [Stmt] = []
        var di = g_pending_defers.len() - 1
        while di >= 0:
            val d_replay_group = g_pending_defers[di]
            var dgi = 0
            while dgi < d_replay_group.len():
                out.push(d_replay_group[dgi])
                dgi = dgi + 1
            di = di - 1
        out.push(convert_flat_stmt(idx))
        return out
    else:
        return [convert_flat_stmt(idx)]

fn convert_flat_if_stmt(root_idx: i64) -> Stmt:
    # Flat `elif`/`else if` chains are represented as a singleton STMT_IF in
    # the preceding arm's else list.  Walk that representation instead of
    # recursively alternating through convert_flat_stmt(_in_list): long
    # compiler dispatch chains otherwise retain one native frame and its
    # temporaries per arm in no-GC bootstrap builds.
    var arms: [IfArm] = []
    var current = root_idx
    var terminal_else: [i64] = []
    var walking = true
    val live_stmt_count = stmt_count()
    var walked_arms = 0
    while walking:
        # The parser constructs an elif chain from its tail, so every nested
        # STMT_IF is an older, strictly smaller statement index.  Enforce that
        # ownership/order invariant and a live-arena bound before touching the
        # arenas.  A corrupt/cyclic chain must fail loudly instead of spinning
        # forever in the no-GC Stage-3 compiler.
        if current < 0 or current >= live_stmt_count or walked_arms >= live_stmt_count:
            flat_bridge_report_unhandled_node("if-chain", current)
            return defer_unsupported_marker(make_span())
        walked_arms = walked_arms + 1
        val arm_span = make_span()
        val condition = convert_flat_expr(stmt_get_expr(current))
        val then_stmts = stmt_get_body(current)
        var then_body: [Stmt] = []
        var ti = 0
        while ti < then_stmts.len():
            val expanded = convert_flat_stmt_in_list(then_stmts[ti], false)
            var tk = 0
            while tk < expanded.len():
                then_body.push(expanded[tk])
                tk = tk + 1
            ti = ti + 1
        arms.push(IfArm(cond: condition, then_: Block(stmts: then_body, span: arm_span), span: arm_span))

        val elif_idx = stmt_get_type(current)
        # Ask the elif arena owner for the canonical singleton projection.
        # Pulling the nested array across the module boundary merely to inspect
        # len() causes the Stage-3 value-copy path to classify real arms as
        # terminal and recursively copy the rest of the chain.
        var next_if = -1
        val candidate = stmt_get_if_single_else(current)
        if candidate >= 0:
            if stmt_get_tag(candidate) == 6:
                next_if = candidate
        if next_if >= 0:
            if next_if >= current:
                flat_bridge_report_unhandled_node("if-chain-order", next_if)
                return defer_unsupported_marker(arm_span)
            current = next_if
        else:
            terminal_else = elif_get_else(elif_idx)
            walking = false

    if terminal_else.len() > 0:
        var converted_else: [Stmt] = []
        var ei = 0
        while ei < terminal_else.len():
            val expanded = convert_flat_stmt_in_list(terminal_else[ei], false)
            var ek = 0
            while ek < expanded.len():
                converted_else.push(expanded[ek])
                ek = ek + 1
            ei = ei + 1
        val else_block = Block(stmts: converted_else, span: arms[arms.len() - 1].span)
        val chain_expr = Expr(kind: ExprKind.IfChain(arms, else_block), span: arms[0].span)
        return Stmt(kind: StmtKind.Expr(chain_expr), span: arms[0].span)
    val chain_expr = Expr(kind: ExprKind.IfChain(arms, nil), span: arms[0].span)
    Stmt(kind: StmtKind.Expr(chain_expr), span: arms[0].span)

fn convert_flat_stmt(idx: i64) -> Stmt:
    if idx < 0:
        val nil_span = make_span()
        return Stmt(kind: StmtKind.Expr(Expr(kind: ExprKind.NilLit, span: nil_span)), span: nil_span)
    val tag = stmt_get_tag(idx)
    val span = make_span()
    if tag <= 0:
        print "[flat-bridge] missing stmt tag idx={idx} tag={tag}"
        return Stmt(kind: StmtKind.Expr(Expr(kind: ExprKind.NilLit, span: span)), span: span)
    if tag == STMT_EXPR:
        val e = convert_flat_expr(stmt_get_expr(idx))
        return Stmt(kind: StmtKind.Expr(e), span: span)
    elif tag == STMT_RETURN:
        val ret_idx = stmt_get_expr(idx)
        if ret_idx >= 0:
            val e = convert_flat_expr(ret_idx)
            return Stmt(kind: StmtKind.Return(e), span: span)
        else:
            return Stmt(kind: StmtKind.Return(nil), span: span)
    elif tag == STMT_VAL_DECL:
        val name = stmt_get_name(idx)
        val type_idx = stmt_get_type(idx)
        val init_idx = stmt_get_expr(idx)
        val type_ = convert_flat_type(type_idx)
        val init_expr = convert_flat_expr(init_idx)
        return Stmt(kind: StmtKind.Val(name, type_, init_expr), span: span)
    elif tag == STMT_VAR_DECL:
        val name = stmt_get_name(idx)
        val type_idx = stmt_get_type(idx)
        val init_idx = stmt_get_expr(idx)
        val type_ = convert_flat_type(type_idx)
        if init_idx >= 0:
            val init_expr = convert_flat_expr(init_idx)
            return Stmt(kind: StmtKind.Var(name, type_, init_expr), span: span)
        else:
            return Stmt(kind: StmtKind.Var(name, type_, nil), span: span)
    elif tag == STMT_ASSIGN:
        val target = convert_flat_expr(stmt_get_expr(idx))
        val body = stmt_get_body(idx)
        if body.len() < 1:
            return Stmt(kind: StmtKind.Expr(Expr(kind: ExprKind.NilLit, span: span)), span: span)
        val value = convert_flat_expr(body[0])
        return Stmt(kind: StmtKind.Assign(target, nil, value), span: span)
    # Inline the frozen STMT_IF wire value for the same Stage-3 reason as the
    # nested-arm test in convert_flat_if_stmt.
    elif tag == 6:
        return convert_flat_if_stmt(idx)
    elif tag == STMT_WHILE:
        val cond = convert_flat_expr(stmt_get_expr(idx))
        val body_stmts = stmt_get_body(idx)
        var body: [Stmt] = []
        var wi = 0
        while wi < body_stmts.len():
            val w_expanded = convert_flat_stmt_in_list(body_stmts[wi], false)
            var wk = 0
            while wk < w_expanded.len():
                body.push(w_expanded[wk])
                wk = wk + 1
            wi = wi + 1
        val block = Block(stmts: body, span: span)
        return Stmt(kind: StmtKind.While(cond, block), span: span)
    elif tag == STMT_FOR:
        val iter_name = stmt_get_name(idx)
        val iterable = convert_flat_expr(stmt_get_expr(idx))
        val body_stmts = stmt_get_body(idx)
        var body: [Stmt] = []
        var fi = 0
        while fi < body_stmts.len():
            val f_expanded = convert_flat_stmt_in_list(body_stmts[fi], false)
            var fk = 0
            while fk < f_expanded.len():
                body.push(f_expanded[fk])
                fk = fk + 1
            fi = fi + 1
        val block = Block(stmts: body, span: span)
        return Stmt(kind: StmtKind.For(iter_name, iterable, block), span: span)
    elif tag == STMT_BREAK:
        return Stmt(kind: StmtKind.Break(nil), span: span)
    elif tag == STMT_CONTINUE:
        return Stmt(kind: StmtKind.Continue(nil), span: span)
    elif tag == STMT_BLOCK:
        val body_stmts = stmt_get_body(idx)
        var body: [Stmt] = []
        var bi = 0
        while bi < body_stmts.len():
            val b_expanded = convert_flat_stmt_in_list(body_stmts[bi], false)
            var bk = 0
            while bk < b_expanded.len():
                body.push(b_expanded[bk])
                bk = bk + 1
            bi = bi + 1
        return Stmt(kind: StmtKind.Expr(Expr(kind: ExprKind.Block(Block(stmts: body, span: span)), span: span)), span: span)
    elif tag == STMT_GPU_LAUNCH:
        # Lane C2: this arm EXISTS but is a silent no-op -- it discards the
        # launch config and the kernel call and returns a bare NilLit, i.e. the
        # generic catch-all's behaviour wearing a dedicated arm's clothes, so
        # the loud fallback below never sees it. (module_assembly.spl has the
        # real GPU-launch conversion; a launch statement reaching THIS function
        # means it did not route through that path.) Report it through the same
        # channel as every other unhandled kind rather than dropping it mutely.
        flat_bridge_report_unhandled_node("stmt", tag)
        return Stmt(kind: StmtKind.Expr(Expr(kind: ExprKind.NilLit, span: span)), span: span)
    elif tag == STMT_MATCH:
        # Ordinary `match s: Pat => body` was previously dropped to NilLit here,
        # so match never reached HIR lowering on the native path. Build a real
        # MatchCase: scrutinee from EXPR, arms from BODY. Each arm's "pattern"
        # is an expression eid (convert_flat_pattern reclassifies enum variants).
        val m_scrut = convert_flat_expr(stmt_get_expr(idx))
        val m_arm_ids = stmt_get_body(idx)
        var m_arms: [MatchArm] = []
        var mi = 0
        while mi < m_arm_ids.len():
            val arm_id = m_arm_ids[mi]
            val m_pat = convert_flat_pattern(arm_get_pattern(arm_id))
            # Explicit type: arm_get_body returns [i64] but the deployed seed
            # erases the nested-[[i64]] element to a boxed i64 handle on a bare
            # `val`, so `.len()` fails with "len on i64". The annotation forces
            # the list decode (same ANY-field landmine as the MatchArm rebind).
            val m_body_ids: [i64] = arm_get_body(arm_id)
            var m_arm_body: [Stmt] = []
            var mbi = 0
            while mbi < m_body_ids.len():
                val m_expanded = convert_flat_stmt_in_list(m_body_ids[mbi], false)
                var mk = 0
                while mk < m_expanded.len():
                    m_arm_body.push(m_expanded[mk])
                    mk = mk + 1
                mbi = mbi + 1

            val m_guard_eid = arm_get_guard(arm_id)
            var m_g_has = false
            var m_g_expr = Expr(kind: ExprKind.NilLit, span: span)
            if m_guard_eid >= 0:
                m_g_has = true
                m_g_expr = convert_flat_expr(m_guard_eid)
            m_arms.push(MatchArm(
                pattern: m_pat,
                has_guard: m_g_has,
                guard: m_g_expr,
                body: Block(stmts: m_arm_body, span: span),
                span: span
            ))
            mi = mi + 1
        return Stmt(kind: StmtKind.Expr(Expr(kind: ExprKind.MatchCase(m_scrut, m_arms), span: span)), span: span)
    elif tag == STMT_DEFER or tag == STMT_ERRDEFER:
        # Defensive catch-all: any call site that didn't route through
        # `convert_flat_stmt_in_list` (see above) — e.g. a future/unaudited
        # nested-body loop — must never silently drop a defer. Refuse loudly
        # instead of falling through to the generic NilLit no-op below.
        return defer_unsupported_marker(span)
    else:
        # Generic "we don't know what this stmt node kind is" fallback --
        # mirrors the convert_flat_expr fallback above; see
        # flat_bridge_report_unhandled_node's doc comment.
        flat_bridge_report_unhandled_node("stmt", tag)
        return Stmt(kind: StmtKind.Expr(Expr(kind: ExprKind.NilLit, span: span)), span: span)

fn convert_decl_fn(idx: i64) -> ParserFunction:
    val name = decl_get_name(idx)
    if (flat_bridge_env_get("SIMPLE_BOOTSTRAP") ?? "") == "1" and flat_bridge_trace_enabled():
        eprint("[flat-bridge] fn:start {name}")
    val p_names = decl_get_param_names(idx)
    val p_types = decl_get_param_types(idx)
    # Per-parameter `mut` marker (native_freefn_mut_param_no_mutate fix),
    # parallel to p_names/p_types; parser_skip_mut_if_present's PARAM_MUTS
    # side table (fn_struct_decls.spl) is the only surviving record that a
    # free-function param was declared `mut name: T` -- thread it onto Param
    # here so it reaches HirParam (declaration_lowering.spl's lower_param)
    # and, from there, MIR function_lowering.spl's by-reference bind.
    val p_muts = decl_get_param_muts(idx)
    # Per-parameter default-value expr indices (-1 = no default). This bridge
    # used to hardcode `has_default: false` for EVERY parameter, so resolve.spl's
    # default-argument fill pass never fired on the flat-AST path. A call that
    # omitted a trailing default then reached MIR/LLVM with fewer arguments than
    # the callee has parameters, and the callee read an UNINITIALIZED register or
    # stack slot for each missing one -- silently yielding garbage (frequently
    # `true` for a trailing `bool = false`). The interpreter was unaffected
    # because it binds defaults directly from HirFunction.params, which is why
    # this only ever showed up under native codegen.
    val p_defaults = decl_get_param_defaults(idx)
    val span = decl_span_for(idx)
    var params: [Param] = []
    var pi = 0
    while pi < p_names.len():
        val p_type = if pi < p_types.len(): p_types[pi] else: 0
        val has_t = p_type > 0
        val p_is_mut = pi < p_muts.len() and p_muts[pi] != 0
        val p_default_idx = if pi < p_defaults.len(): p_defaults[pi] else: -1
        val p_has_default = p_default_idx >= 0
        # Do not select rich value aggregates inline inside another aggregate
        # constructor. The staged native bridge lowered that conditional as a
        # pointer-selected 48-byte copy; the selected Type pointer could be
        # invalid and faulted while converting typed extern/function params.
        var param_type: Type = Type(kind: TypeKind.Infer, span: span)
        if has_t:
            param_type = convert_flat_type(p_type)
        var param_default: Expr = Expr(kind: ExprKind.NilLit, span: span)
        if p_has_default:
            param_default = convert_flat_expr(p_default_idx)
        params.push(Param(
            name: p_names[pi],
            has_type_: has_t,
            type_: param_type,
            has_default: p_has_default,
            default: param_default,
            span: span,
            is_mutable: p_is_mut
        ))
        pi = pi + 1

    val ret = decl_get_ret_type(idx)
    # Computed here (before the body/defer conversion below) rather than at its
    # original call site further down, because the fall-off-the-end defer
    # replay logic needs to know, per function, whether a `-> T` return type
    # was declared. See the `has_ret` usage inside the `g_pending_defers`
    # fall-off-the-end block for why this matters.
    val has_ret = ret > 0
    if flat_bridge_env_get("SIMPLEOS_FOCUSED_HIR_DIAG") == "1":
        eprint("[simpleos-flat-ret] name={name} tag={ret}")
    val body = decl_get_body(idx)
    val trace_reset = (rt_env_get("SIMPLE_TRACE_AST_RESET") ?? "") == "1"
    if trace_reset and body.len() > 0 and body[body.len() - 1] >= stmt_count():
        print "[convert_decl_fn] STALE-BODY-SUSPECT name={name} body_len={body.len()} body_first={body[0]} body_last={body[body.len() - 1]} live_stmt_count={stmt_count()} reset_seq={ast_reset_seq_get()}"
    var stmts: [Stmt] = []
    # Save/restore the pending-defer stack around this function's own body so
    # a re-entrant conversion (if any future caller nests one) can't leak
    # defers across function boundaries. See convert_flat_stmt_in_list above.
    val saved_pending_defers: [[Stmt]] = g_pending_defers
    g_pending_defers = []
    var contract_preconditions: [ContractClause] = []
    var contract_invariants: [ContractClause] = []
    var contract_postconditions: [ContractClause] = []
    var contract_error_postconditions: [ContractClause] = []
    var contract_decreases: ContractClause? = nil
    var contract_post_binding = ""
    var contract_error_binding = ""
    var contract_proof_uses = ""
    var si = 0
    val body_len = body.len()
    while si < body_len:
        if trace_reset and body[si] >= stmt_count():
            print "[convert_decl_fn] OOB-ABOUT-TO-HIT name={name} si={si} stmt_idx={body[si]} live_stmt_count={stmt_count()}"
        val raw_tag = stmt_get_tag(body[si])
        val is_contract = raw_tag == STMT_CONTRACT_IN or raw_tag == STMT_CONTRACT_INVARIANT or
            raw_tag == STMT_CONTRACT_OUT or raw_tag == STMT_CONTRACT_OUT_ERR or
            raw_tag == STMT_CONTRACT_DECREASES or raw_tag == STMT_CONTRACT_PROOF_USES
        if is_contract:
            if raw_tag == STMT_CONTRACT_PROOF_USES:
                contract_proof_uses = stmt_get_name(body[si])
            else:
                val clause_nodes = stmt_get_body(body[si])
                var ci = 0
                while ci < clause_nodes.len():
                    val clause_node = clause_nodes[ci]
                    if stmt_get_tag(clause_node) != STMT_EXPR:
                        flat_bridge_report_unhandled_node("contract-clause-stmt", stmt_get_tag(clause_node))
                    else:
                        val clause_expr = convert_flat_expr(stmt_get_expr(clause_node))
                        val clause = ContractClause(expr: clause_expr, span: clause_expr.span)
                        if raw_tag == STMT_CONTRACT_IN:
                            contract_preconditions.push(clause)
                        elif raw_tag == STMT_CONTRACT_INVARIANT:
                            contract_invariants.push(clause)
                        elif raw_tag == STMT_CONTRACT_OUT:
                            contract_postconditions.push(clause)
                        elif raw_tag == STMT_CONTRACT_OUT_ERR:
                            contract_error_postconditions.push(clause)
                        elif raw_tag == STMT_CONTRACT_DECREASES:
                            contract_decreases = clause
                    ci = ci + 1
                if raw_tag == STMT_CONTRACT_OUT:
                    contract_post_binding = stmt_get_name(body[si])
                elif raw_tag == STMT_CONTRACT_OUT_ERR:
                    contract_error_binding = stmt_get_name(body[si])
        else:
            val expanded = convert_flat_stmt_in_list(body[si], true)
            var k = 0
            while k < expanded.len():
                stmts.push(expanded[k])
                k = k + 1
        si = si + 1

    if g_pending_defers.len() > 0:
        # Fall-off-the-end replay. Already safe to append when the function's
        # last raw top-level statement was `defer` itself (nothing trails it,
        # so the append is truly the new last statement with nothing to
        # disturb) -- see the STMT_DEFER arm below. If the last raw statement
        # was already an explicit `return`, `convert_flat_stmt_in_list`'s
        # STMT_RETURN case already spliced the defers before it -- appending
        # again here would be dead code AFTER that return, so it is skipped,
        # not duplicated (see the `last_raw_tag != STMT_RETURN` guard below).
        #
        # The remaining shape -- the body falls off the end with ordinary
        # statements AFTER the last `defer` (bug #172 follow-up, the MOST
        # COMMON defer pattern: `fn work(): defer f(); g(); h()`, no explicit
        # `return`) -- is handled here too, but ONLY when the function has NO
        # declared `-> T` return type (`has_ret == false`). That guard exists
        # because of how HIR lowering picks a lowering path for the body
        # (`_Items/declaration_lowering.spl`, gated on `fn_.has_return_type`):
        #   - has_ret == false -> `lower_hir_block_unit`: every statement,
        #     INCLUDING a trailing expression-statement, stays a plain
        #     statement; no tail value is ever extracted. Appending the
        #     defer-replay statements after the real last statement is
        #     unconditionally safe here -- there is no implicit return value
        #     for the append to clobber.
        #   - has_ret == true -> `lower_hir_block`: the LAST statement (if an
        #     expression-statement) is lifted out of `stmts` and used as the
        #     block's implicit tail-value / return value. Appending a
        #     defer-replay statement after it would silently steal that slot
        #     (the defer's own expression, not the function's real value,
        #     would become the return value) -- so that shape is intentionally
        #     left OUT OF SCOPE and still refused loudly rather than risking a
        #     silently wrong return value.
        val last_raw_tag = if body_len > 0: stmt_get_tag(body[body_len - 1]) else: -1
        if last_raw_tag == STMT_DEFER:
            var dj = g_pending_defers.len() - 1
            while dj >= 0:
                val dj_group = g_pending_defers[dj]
                var dji = 0
                while dji < dj_group.len():
                    stmts.push(dj_group[dji])
                    dji = dji + 1
                dj = dj - 1
        elif last_raw_tag != STMT_RETURN:
            if has_ret:
                stmts.push(defer_unsupported_marker(make_span()))
            else:
                var ej = g_pending_defers.len() - 1
                while ej >= 0:
                    val ej_group = g_pending_defers[ej]
                    var eji = 0
                    while eji < ej_group.len():
                        stmts.push(ej_group[eji])
                        eji = eji + 1
                    ej = ej - 1
    g_pending_defers = saved_pending_defers

    val visibility = convert_decl_visibility(idx)
    val fn_params: [Param] = params
    # decl_get_type_params returns the `<T, U, ...>` names captured by
    # parse_type_params() at parse time. This bridge previously discarded
    # them entirely -- `parser_function_new` below was always called with a
    # hardcoded `[]`, so `ParserFunction.type_params` was empty by the time HIR
    # (and every downstream check gated on it) ever saw the function, turning
    # `fn id<T>(x: T) -> T` into a silent-wrong native build (bug: generic
    # functions on the native --entry path return 0 instead of the argument).
    # Thread the real names through as `[ParserTypeParam]` so HIR lowering can see
    # (and reject) generic functions instead of erasing them.
    val tp_names = decl_get_type_params(idx)
    var fn_type_params: [ParserTypeParam] = []
    var tpi = 0
    while tpi < tp_names.len():
        fn_type_params.push(ParserTypeParam(
            name: tp_names[tpi],
            bounds: [],
            has_default: false,
            default: Type(kind: TypeKind.Infer, span: span),
            span: span
        ))
        tpi = tpi + 1
    # decl_get_ret_type returns a type tag (>0 when a `-> T` return type was
    # declared). This was previously fetched into `ret` and then discarded --
    # the function was always constructed with has_return_type=false and an
    # Infer return type, silently dropping every declared return type through
    # the flat-AST bridge. Thread the real return type through instead.
    # (`has_ret` itself is computed earlier, right after `ret` -- see the
    # fall-off-the-end defer replay block above for why.)
    var inferred_ret: Type = Type(kind: TypeKind.Infer, span: span)
    if has_ret:
        inferred_ret = convert_flat_type(ret)
    val body_block = Block(stmts: stmts, span: span)
    val function_contract = ContractBlock(
        preconditions: contract_preconditions,
        invariants: contract_invariants,
        postconditions: contract_postconditions,
        error_postconditions: contract_error_postconditions,
        decrease_measure: contract_decreases,
        postcondition_binding: contract_post_binding,
        error_binding: contract_error_binding,
        proof_uses: contract_proof_uses
    )
    var fn_attributes: [Attribute] = []
    if decl_get_is_gpu_kernel(idx) != 0:
        var gpu_args: [Expr] = []
        val gpu_target = decl_get_gpu_target_text(idx)
        val gpu_target_arg_name = decl_get_gpu_target_arg_name_text(idx)
        val gpu_backends = decl_get_gpu_backends_text(idx)
        if gpu_target.len() > 0:
            if gpu_target_arg_name.len() > 0:
                val left = Expr(kind: ExprKind.Ident(gpu_target_arg_name), span: span)
                val right = Expr(kind: ExprKind.StringLit(gpu_target, nil), span: span)
                gpu_args.push(Expr(kind: ExprKind.Assign(left, nil, right), span: span))
            else:
                gpu_args.push(Expr(kind: ExprKind.StringLit(gpu_target, nil), span: span))
        if gpu_backends.len() > 0:
            val left = Expr(kind: ExprKind.Ident("backends"), span: span)
            val right = Expr(kind: ExprKind.StringLit(gpu_backends, nil), span: span)
            gpu_args.push(Expr(kind: ExprKind.Assign(left, nil, right), span: span))
        fn_attributes.push(Attribute(name: "gpu", args: gpu_args, span: span))
    if decl_get_is_hardware(idx) != 0:
        fn_attributes.push(Attribute(name: "hardware", args: [], span: span))
        if decl_get_flatten_struct_output(idx) != 0:
            fn_attributes.push(Attribute(name: "flatten_struct_output", args: [], span: span))
        val generic_exprs = decl_get_vhdl_generic_args(idx)
        if generic_exprs.len() > 0:
            var generic_args: [Expr] = []
            for generic_expr in generic_exprs:
                generic_args.push(convert_flat_expr(generic_expr))
            fn_attributes.push(Attribute(name: "generic", args: generic_args, span: span))
        val clocked_names = decl_get_clocked_args(idx)
        if clocked_names.len() > 0:
            var clocked_args: [Expr] = []
            for clocked_name in clocked_names:
                clocked_args.push(Expr(kind: ExprKind.Ident(clocked_name), span: span))
            fn_attributes.push(Attribute(name: "clocked", args: clocked_args, span: span))
    val converted: ParserFunction = parser_function_new(
        name,
        fn_type_params,
        fn_params,
        has_ret,
        inferred_ret,
        body_block,
        visibility,
        decl_get_is_async(idx) != 0,
        false,
        convert_decl_is_public(idx),
        false,
        false,
        decl_get_is_comptime(idx),
        decl_get_is_gpu_kernel(idx) != 0,
        false,
        fn_attributes,
        false,
        "",
        function_contract,
        span
    )
    if (flat_bridge_env_get("SIMPLE_BOOTSTRAP") ?? "") == "1" and flat_bridge_trace_enabled():
        eprint("[flat-bridge] fn:done {name}")
    converted

fn convert_decl_method_fn(idx: i64, target_name: text) -> ParserFunction:
    # NOTE: must use field access, not a positional `case Function(...)`
    # destructure — wide positional class matches silently fail to match in
    # the interpreter and SIGSEGV in cranelift-compiled binaries (see
    # doc/08_tracking/bug/positional_class_match_wide_destructure_2026-06-11.md).
    val base: ParserFunction = convert_decl_fn(idx)
    val method_mode = decl_get_is_async(idx)
    val prefix = target_name + "__"
    val method_name = if base.name.starts_with(prefix):
        base.name.substring(prefix.len(), base.name.len())
    else:
        base.name
    parser_function_new(
        method_name,
        base.type_params,
        base.params,
        base.has_return_type,
        base.return_type,
        base.body,
        base.visibility,
        false,
        method_mode == 1,
        base.is_public,
        method_mode != 1,
        method_mode == 2,
        base.is_const,
        base.is_kernel,
        base.is_extern,
        base.attributes,
        base.has_doc_comment,
        base.doc_comment,
        base.contract,
        base.span
    )

fn convert_decl_extern_fn(idx: i64) -> ParserFunction:
    val name = decl_get_name(idx)
    val p_names = decl_get_param_names(idx)
    val p_types = decl_get_param_types(idx)
    val span = decl_span_for(idx)
    var params: [Param] = []
    var pi = 0
    while pi < p_names.len():
        val p_type = if pi < p_types.len(): p_types[pi] else: 0
        val has_t = p_type > 0
        var param_type: Type = Type(kind: TypeKind.Infer, span: span)
        if has_t:
            param_type = convert_flat_type(p_type)
        params.push(Param(
            name: p_names[pi],
            has_type_: has_t,
            type_: param_type,
            has_default: false,
            default: Expr(kind: ExprKind.NilLit, span: span),
            span: span,
            is_mutable: false
        ))
        pi = pi + 1

    # decl_get_ret_type returns a type tag (>0 when a `-> T` return type was
    # declared). This was previously fetched into `ret` and then discarded --
    # every extern function was constructed with has_return_type=false and an
    # Infer return type, silently dropping the declared return type. Downstream,
    # the symbol's ParserFunction type then carried a Unit return (module_lowering),
    # so MIR lowered any extern call in value position as void (dest=None),
    # emitting `call void @f()` plus an orphaned `bitcast void %l to T` that
    # llc rejects ("void type only allowed for function results"). Mirror the
    # convert_decl_fn fix: thread the real return type through. (#146)
    val ret = decl_get_ret_type(idx)
    val extern_params: [Param] = params
    val extern_has_ret = ret > 0
    var extern_inferred_ret: Type = Type(kind: TypeKind.Infer, span: span)
    if extern_has_ret:
        extern_inferred_ret = convert_flat_type(ret)
    parser_function_new(
        name,
        [],
        extern_params,
        extern_has_ret,
        extern_inferred_ret,
        Block(stmts: [], span: span),
        Visibility.Private,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        true,
        [],
        false,
        "",
        contract_block_empty(),
        span
    )

fn text_parse_int_simple(s: text) -> i64:
    var result: i64 = 0
    var i = 0
    while i < s.len():
        result = result * 10
        val ch = s[i]
        if ch == "1":
            result = result + 1
        elif ch == "2":
            result = result + 2
        elif ch == "3":
            result = result + 3
        elif ch == "4":
            result = result + 4
        elif ch == "5":
            result = result + 5
        elif ch == "6":
            result = result + 6
        elif ch == "7":
            result = result + 7
        elif ch == "8":
            result = result + 8
        elif ch == "9":
            result = result + 9
        i = i + 1
    result
