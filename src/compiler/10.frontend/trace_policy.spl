# Frontend trace-output policy
#
# Parser and AST instrumentation spans modules below and beside the parser, so
# diagnostic suppression alone cannot silence it. Keep one cycle-free scalar
# owner that machine-output scopes can nest without rewriting process env vars.

var _frontend_trace_suppression_slot: [i64] = [0]

fn _frontend_trace_slot_ensure():
    if (_frontend_trace_suppression_slot == nil or
        _frontend_trace_suppression_slot.len() == 0):
        _frontend_trace_suppression_slot = [0]

fn frontend_trace_suppressed() -> bool:
    _frontend_trace_slot_ensure()
    _frontend_trace_suppression_slot[0] != 0

fn frontend_trace_suppression_set(suppressed: bool) -> bool:
    _frontend_trace_slot_ensure()
    val previous = _frontend_trace_suppression_slot[0] != 0
    _frontend_trace_suppression_slot[0] = if suppressed: 1 else: 0
    previous

export frontend_trace_suppressed, frontend_trace_suppression_set
