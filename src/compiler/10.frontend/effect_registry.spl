# `@copy_budget(N)` / `@bounded_loop` declaration registry (C4, doc/03_plan/
# compiler/forwarding/zero_cost_layers_c0_c5_staged_implementation_plan_2026-08-07.md;
# closes the C4 gap of doc/03_plan/ui/perf/
# render_perf_redesign_plan_2026-08-06.md §3, line 203).
#
# BEFORE this file existed, `35.semantics/effect_verifier.spl` implemented all
# four violation classes (copy-over-budget, implicit-copy, unbounded-loop,
# growth-in-loop) and passed 16/16 -- but there was NO way to spell
# `@copy_budget` or `@bounded_loop` in source, so the verifier only ever ran
# against hand-built `CopySite`/`LoopSite` fixtures and its own header said so
# ("Deferred -- 1. Driver wiring. Nothing populates an EffectManifest").
# A checker fed fixtures proves nothing about the tree.
#
# This registry is the missing producer end, and it is a DELIBERATE MIRROR of
# `layer_eq_registry.spl` (C1) rather than a second mechanism: same
# "<module path>|<name>" claim keys, same module-scoped reset, same
# `__..._decl(...)` inert-marker handoff through `_FlatAstBridge/
# module_assembly.spl`, same drain-after-HIR consumer
# (`35.semantics/effect_validation.spl`). Sibling implementations that drift
# are this tree's highest-yield defect class; there is exactly one shape here.
#
# Why a side-registry and not a `HirFunction` field: identical reasoning to
# `layer_eq_registry.spl` and `resource_registry.spl` -- a new struct field
# would force edits across 10.frontend, 20.hir, 35.semantics, 70.backend and
# 80.driver, several of which are owned by other in-flight sessions on this
# shared working copy.
#
# Reset: `parser_init_with_path` (10.frontend/core/parser.spl) calls
# `effect_registry_reset_module(path)` on every fresh parse, right beside
# `layer_eq_registry_reset_module(path)`.

# `@copy_budget` absent. Mirrors `COPY_BUDGET_UNSET` in
# `35.semantics/effect_verifier.spl` -- -1, NOT 0, because 0 is the STRICTEST
# budget and conflating "unannotated" with "zero" would invert the check.
# Duplicated as a literal rather than imported: 10.frontend must not depend on
# 35.semantics (the dependency runs the other way), exactly as
# `layer_eq_registry.spl` duplicates no checker constants.
val EFFECT_REGISTRY_BUDGET_UNSET: i64 = 0 - 1

extern fn rt_transient_heap_promote(value: Any) -> bool

var effect_registry_fns: [text] = []
var effect_registry_budgets: Dict<text, i64> = {}
var effect_registry_bounded: Dict<text, bool> = {}

fn effect_registry_reset():
    effect_registry_fns = []
    effect_registry_budgets = {}
    effect_registry_bounded = {}

# Per-parse scoped reset: drop only the claims recorded for `path`, keeping
# every OTHER module's claims alive.
#
# A whole-registry wipe would be WRONG here and silently fail open, for the
# reason spelled out in `layer_eq_registry.spl`: a multi-module compile parses
# every module before any HIR-stage validation runs, so a blanket reset would
# leave only the LAST-parsed module's annotations to check and every earlier
# module's obligations would go unproven while still reporting green.
fn effect_registry_reset_module(path: text):
    val prefix = path + "|"
    var kept: [text] = []
    var kept_budgets: Dict<text, i64> = {}
    var kept_bounded: Dict<text, bool> = {}
    for key in effect_registry_fns:
        if key.starts_with(prefix):
            continue
        kept.push(key)
        if effect_registry_budgets.contains_key(key):
            kept_budgets[key] = effect_registry_budgets[key]
        if effect_registry_bounded.contains_key(key):
            kept_bounded[key] = effect_registry_bounded[key]
    effect_registry_fns = kept
    effect_registry_budgets = kept_budgets
    effect_registry_bounded = kept_bounded

fn effect_registry_promote_transient_owner() -> bool:
    val fns_ok = rt_transient_heap_promote(effect_registry_fns)
    val budgets_ok = rt_transient_heap_promote(effect_registry_budgets)
    val bounded_ok = rt_transient_heap_promote(effect_registry_bounded)
    fns_ok and budgets_ok and bounded_ok

fn effect_claim_key(path: text, fn_name: text) -> text:
    path + "|" + fn_name

fn effect_claim_path(key: text) -> text:
    val parts = key.split("|")
    if parts.len() == 0:
        return ""
    parts[0]

fn effect_claim_fn(key: text) -> text:
    val parts = key.split("|")
    if parts.len() < 2:
        return ""
    parts[1]

# Decimal text -> i64, with a sentinel for "not a number".
#
# Hand-rolled rather than `text.to_i64()`: this tree has an open defect where a
# chained `.to_i64()` returns garbage under JIT
# (reference_jit_chained_method_to_i64_returns_garbage), and a budget that
# silently decodes to garbage is a fail-open -- a huge decoded budget would
# make every real over-budget function pass.
fn effect_parse_budget(raw: text) -> i64:
    if raw == "":
        return EFFECT_REGISTRY_BUDGET_UNSET
    var acc: i64 = 0
    var seen = false
    for i in 0..raw.len():
        val ch = raw[i]
        val is_digit: bool = ch >= "0" and ch <= "9"
        if not is_digit:
            # Any non-digit makes the whole payload untrustworthy. Returning
            # UNSET (= "not annotated") is the fail-CLOSED direction here: the
            # function is simply not checked, rather than checked against a
            # budget nobody wrote.
            return EFFECT_REGISTRY_BUDGET_UNSET
        acc = acc * 10 + (ch.ord() - 48)
        seen = true
    if not seen:
        return EFFECT_REGISTRY_BUDGET_UNSET
    acc

# Record one `@copy_budget(N)` and/or `@bounded_loop` function annotation.
#
# `budget_text` is the decimal payload of `@copy_budget(N)`, or "" when the
# function carried only `@bounded_loop`. Re-declaring the same (path, fn)
# overwrites rather than duplicates, so a re-parse of one module cannot make
# the validator report the same obligation twice.
fn effect_registry_declare(path: text, fn_name: text, budget_text: text, bounded: bool):
    if fn_name == "":
        return
    val key = effect_claim_key(path, fn_name)
    if not effect_registry_fns.contains(key):
        effect_registry_fns.push(key)
    effect_registry_budgets[key] = effect_parse_budget(budget_text)
    effect_registry_bounded[key] = bounded

fn effect_registry_claim_keys() -> [text]:
    effect_registry_fns

fn effect_is_declared(path: text, fn_name: text) -> bool:
    effect_registry_fns.contains(effect_claim_key(path, fn_name))

fn effect_registry_budget_of_key(key: text) -> i64:
    if effect_registry_budgets.contains_key(key):
        return effect_registry_budgets[key]
    EFFECT_REGISTRY_BUDGET_UNSET

fn effect_registry_budget_of(path: text, fn_name: text) -> i64:
    effect_registry_budget_of_key(effect_claim_key(path, fn_name))

fn effect_registry_bounded_of_key(key: text) -> bool:
    if effect_registry_bounded.contains_key(key):
        return effect_registry_bounded[key]
    false

fn effect_registry_bounded_of(path: text, fn_name: text) -> bool:
    effect_registry_bounded_of_key(effect_claim_key(path, fn_name))

# ===== Parse-time scratch for stacked `@copy_budget` / `@bounded_loop` =====
#
# The two attributes stack on one function:
#
#     @copy_budget(0)
#     @bounded_loop
#     fn commit(): ...
#
# and `parse_module_body`'s decorator arm consumes ONE `@` per loop iteration,
# so the first attribute must survive to the iteration that finally sees the
# `fn` token. These vars carry it. Kept here rather than as `PENDING_*` globals
# in `enum_module_body.spl` so producer and consumer read one definition
# instead of two drifting copies -- the same call `layer_field_pending_*`
# makes just below its own producer.

var effect_pending_budget_text: text = ""
var effect_pending_bounded: bool = false

fn effect_pending_reset():
    effect_pending_budget_text = ""
    effect_pending_bounded = false

fn effect_pending_set_budget(raw: text):
    effect_pending_budget_text = raw

fn effect_pending_set_bounded():
    effect_pending_bounded = true

fn effect_pending_budget() -> text:
    effect_pending_budget_text

fn effect_pending_bounded_flag() -> bool:
    effect_pending_bounded

export EFFECT_REGISTRY_BUDGET_UNSET
export effect_registry_reset, effect_registry_reset_module, effect_registry_declare
export effect_registry_claim_keys, effect_claim_key, effect_claim_path, effect_claim_fn
export effect_registry_promote_transient_owner
export effect_is_declared, effect_parse_budget
export effect_registry_budget_of, effect_registry_budget_of_key
export effect_registry_bounded_of, effect_registry_bounded_of_key
export effect_pending_reset, effect_pending_set_budget, effect_pending_set_bounded
export effect_pending_budget, effect_pending_bounded_flag
