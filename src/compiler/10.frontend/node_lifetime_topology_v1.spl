# Compatibility entry for checked child-edge validation. Complete DAG validation
# and parent reachability share one bounded walk over canonical AST children.
use compiler.frontend.node_lifetime_dag_v1.{node_lifetime_dag_error_v1}

pub fn node_lifetime_child_edge_error_v1(parent: i64, child: i64,
    budget: i64 = 1000000) -> text:
    node_lifetime_dag_error_v1(child, budget, parent)
