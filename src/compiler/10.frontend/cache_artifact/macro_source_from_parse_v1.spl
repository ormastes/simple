# Real-parse input for the macro reference projector (plan 2026-10-24 §6, P5).
#
# The core parser records `macro NAME(...)` declarations and `name!(...)`
# invocations in the macro fact pools (_Ast/decl_nodes.spl); this adapter turns
# the CURRENT module's pools into a MacroModuleSourceV1. Call it right after
# the module's parse (or cache restore): the pools are per-parse state and the
# next parse resets them.
#
# The region id and stable invocation id are `<name>#<ordinal among same-name
# invocations>` (active and guard-inactive invocations counted together, in
# source order), so an unrelated edit or a guard flip keeps them; line/col stay
# in the pools for navigation only.
#
# @when guards and CTFE effects are recovered from the macro SOURCE:
# - guards: the line preprocessor blanks inactive @when branches before the
#   parser runs, so branches are re-read from the ORIGINAL source. Each branch
#   is GuardIdV1("when", <chain>) where the chain folds in the enclosing
#   branches and the negation of earlier siblings; it is evaluated with the
#   preprocessor's own condition evaluator. Invocations inside an inactive
#   branch are kept as inactive records (so a guard flip re-resolves them);
#   macro definitions inside an inactive branch are read from the source too
#   (single-line headers) and kept as non-resolving def-table entries.
# - effects: there is no effect-declaration syntax for macros. A `const`
#   parameter declares compile-time evaluation (ctfe:const-eval, admitted); a
#   body calling an ambient host API declares that ambient effect, which
#   macro_effect_admitted_v1 rejects, making the macro uncacheable.

use compiler.frontend.parser.macro_registry.{MacroDef, MacroIntroDecl}
use compiler.frontend.cache_artifact.macro_reference_projector.{MacroSourceDefV1,
    MacroSourceInvocationV1, MacroModuleSourceV1}
use compiler.frontend.core._Ast.decl_nodes.{macro_fact_def_count, macro_fact_def_name_at,
    macro_fact_def_params_at, macro_fact_def_contract_at, macro_fact_def_body_at,
    macro_fact_def_nested_at, macro_fact_use_count, macro_fact_use_name_at,
    macro_fact_use_args_at, macro_fact_def_line_at, macro_fact_use_line_at}
use compiler.common.cache_contract.guard_id_v1.{GuardIdV1, GuardEvalV1, guard_id_v1}
use compiler.frontend.core.parser_preprocessor.{_pp_eval_condition}

fn _split_csv(value: text) -> [text]:
    if value == "": return []
    var out: [text] = []
    for part in value.split(","):
        val p = part.trim()
        if p != "": out.push(p)
    out

fn _intro_kinds() -> [text]:
    ["fn", "class", "type", "field", "var", "const"]

# `intro LABEL: <target>.<kind> "PATTERN"...` entries of a raw contract. The
# introduced public name is the first string literal after `intro`; its kind is
# the last `.<kind>` word before that literal.
pub fn macro_contract_intros_v1(contract: text) -> [MacroIntroDecl]:
    var out: [MacroIntroDecl] = []
    var rest = contract
    var at = rest.find("intro ")
    while at >= 0:
        rest = rest.substring(at + 6, rest.len())
        val q = rest.find("\"")
        if q < 0: break
        val head = rest.substring(0, q)
        val tail = rest.substring(q + 1, rest.len())
        val q2 = tail.find("\"")
        if q2 < 0: break
        var kind = "fn"
        for k in _intro_kinds():
            if head.find("." + k) >= 0: kind = k
        out.push(MacroIntroDecl(kind: kind, name_pattern: tail.substring(0, q2), type_pattern: nil))
        rest = tail.substring(q2 + 1, tail.len())
        at = rest.find("intro ")
    out

# ---------------------------------------------------------------------------
# CTFE effects
# ---------------------------------------------------------------------------

# "<call prefix>=<effect>"
fn _ambient_effects_table() -> [text]:
    ["env_get=env:read", "env_set=env:write", "file_read=fs:read", "file_write=fs:write",
     "file_exists=fs:read", "time_now=clock:now", "clock_now=clock:now", "random=random",
     "getpid=process:id", "rt_=runtime:extern"]

pub fn macro_effects_of_source_v1(params: [text], body: text) -> [text]:
    var out: [text] = []
    for p in params:
        if p.ends_with("=const") and not out.contains("ctfe:const-eval"):
            out.push("ctfe:const-eval")
    for entry in _ambient_effects_table():
        val eq = entry.find("=")
        val call = entry.substring(0, eq)
        val effect = entry.substring(eq + 1, entry.len())
        if _has_call(body, call) and not out.contains(effect):
            out.push(effect)
    out

# `prefix` at an identifier start (not inside a longer word such as `start_`).
fn _has_call(body: text, prefix: text) -> bool:
    var i = 0
    while i < body.len():
        val rel = body.substring(i, body.len()).find(prefix)
        if rel < 0: return false
        val at = i + rel
        if at == 0 or not _is_word_char(body.substring(at - 1, at)): return true
        i = at + 1
    false

fn _param_names(params: [text]) -> [text]:
    var out: [text] = []
    for p in params:
        if p.ends_with("=const"):
            out.push(p.substring(0, p.len() - 6))
        else:
            out.push(p)
    out

# ---------------------------------------------------------------------------
# @when guards
# ---------------------------------------------------------------------------

pub struct MacroGuardScanV1:
    line_guard: [text]            # per 0-based line: innermost branch guard digest ("" = unguarded)
    evals: [GuardEvalV1]
    inactive_use_names: [text]
    inactive_use_args: [text]
    inactive_use_lines: [i64]     # 1-based
    inactive_defs: _InactiveDefsV1

fn _paren_cond(line: text) -> text:
    val open = line.find("(")
    val close = line.rfind(")")
    if open < 0 or close <= open: return ""
    line.substring(open + 1, close).trim()

fn _is_word_char(ch: text) -> bool:
    (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or (ch >= "0" and ch <= "9") or ch == "_"

fn _scan_bang_calls(line: text, names: [text], args: [text], lines: [i64], line_no: i64):
    var i = 0
    while i < line.len():
        val rel = line.substring(i, line.len()).find("!(")
        if rel < 0: break
        val at = i + rel
        var start = at
        while start > 0 and _is_word_char(line.substring(start - 1, start)):
            start = start - 1
        if start < at:
            var depth = 0
            var j = at + 1
            var close = -1
            while j < line.len():
                val c = line.substring(j, j + 1)
                if c == "(": depth = depth + 1
                if c == ")":
                    depth = depth - 1
                    if depth == 0:
                        close = j
                        break
                j = j + 1
            names.push(line.substring(start, at))
            args.push(if close > at + 1: line.substring(at + 2, close) else: "")
            lines.push(line_no)
        i = at + 2

fn _eval(cond: text) -> bool:
    cond != "" and _pp_eval_condition(cond)

fn _indent_of(line: text) -> i64:
    var i = 0
    while i < line.len():
        val ch = line.substring(i, i + 1)
        if ch != " " and ch != "\t": return i
        i = i + 1
    i

# `n: Int const, x: Int` -> ["n=const", "x"] (top-level commas only).
fn _header_params(inner: text) -> [text]:
    var out: [text] = []
    var depth = 0
    var cur = ""
    var i = 0
    while i <= inner.len():
        val ch = if i < inner.len(): inner.substring(i, i + 1) else: ","
        if ch == "(" or ch == "[" or ch == "{": depth = depth + 1
        if ch == ")" or ch == "]" or ch == "}": depth = depth - 1
        if ch == "," and depth == 0:
            val seg = cur.trim()
            if seg != "":
                val colon = seg.find(":")
                val name = if colon > 0: seg.substring(0, colon).trim() else: seg
                out.push(if seg.ends_with(" const"): name + "=const" else: name)
            cur = ""
        else:
            cur = cur + ch
        i = i + 1
    out

# Macro definitions found in INACTIVE @when branches, read from the original
# source (the parser never sees them). Single-line headers only
# (`macro NAME(params) -> (contract):`); the body is the following lines
# indented deeper than the header.
class _InactiveDefsV1:
    names: [text]
    params: [text]       # comma-joined, `n=const` for CTFE params
    contracts: [text]
    bodies: [text]
    nested: [text]       # comma-joined `n!(` names in the body
    lines: [i64]
    open: bool
    indent: i64

    static fn create() -> _InactiveDefsV1:
        _InactiveDefsV1(names: [], params: [], contracts: [], bodies: [], nested: [],
            lines: [], open: false, indent: 0)

    me close():
        self.open = false

    # true when the line belongs to an inactive macro (header or body).
    me take_line(line: text, line_no: i64) -> bool:
        val t = line.trim()
        val ind = _indent_of(line)
        if self.open and (t == "" or ind > self.indent):
            val i = self.bodies.len() - 1
            self.bodies[i] = self.bodies[i] + line + "\n"
            var ns: [text] = []
            var as_: [text] = []
            var ls: [i64] = []
            _scan_bang_calls(line, ns, as_, ls, line_no)
            for n in ns:
                val cur = self.nested[i]
                if not ("," + cur + ",").contains("," + n + ","):
                    self.nested[i] = if cur == "": n else: cur + "," + n
            return true
        self.open = false
        if not t.starts_with("macro "): return false
        val open = t.find("(")
        if open < 0: return false
        val name = t.substring(6, open).trim()
        var depth = 0
        var close = -1
        var i = open
        while i < t.len():
            val ch = t.substring(i, i + 1)
            if ch == "(": depth = depth + 1
            if ch == ")":
                depth = depth - 1
                if depth == 0:
                    close = i
                    break
            i = i + 1
        if close < 0 or name == "": return false
        val rest = t.substring(close + 1, t.len()).trim()
        var contract = ""
        if rest.starts_with("->"):
            contract = rest.substring(2, rest.len()).trim()
            if contract.ends_with(":"): contract = contract.substring(0, contract.len() - 1).trim()
        self.names.push(name)
        self.params.push(_header_params(t.substring(open + 1, close)).join(","))
        self.contracts.push(contract)
        self.bodies.push("")
        self.nested.push("")
        self.lines.push(line_no)
        self.open = true
        self.indent = ind
        true

pub fn macro_guard_scan_v1(source: text) -> MacroGuardScanV1:
    val lines = source.replace("\r\n", "\n").split("\n")
    var line_guard: [text] = []
    var evals: [GuardEvalV1] = []
    var seen: [text] = []
    var chain: [text] = []          # per depth: current branch's chain expr
    var prior: [text] = []          # per depth: negated earlier siblings
    var parent_chain: [text] = []
    var parent_active: [bool] = []
    var taken: [bool] = []          # per depth: an earlier sibling was taken
    var active: [bool] = []         # per depth: current branch active
    var names: [text] = []
    var args: [text] = []
    var use_lines: [i64] = []
    var cap = _InactiveDefsV1.create()
    var line_no = 0
    for line in lines:
        line_no = line_no + 1
        val t = line.trim()
        val is_when = t.starts_with("@when(")
        val is_elif = t.starts_with("@elif(") and chain.len() > 0
        val is_else = t == "@else" and chain.len() > 0
        val is_end = t == "@end"
        if is_when:
            val c = _paren_cond(t)
            val parent = if chain.len() > 0: chain[chain.len() - 1] else: ""
            val pa = if active.len() > 0: active[active.len() - 1] else: true
            val on = pa and _eval(c)
            parent_chain.push(parent)
            parent_active.push(pa)
            chain.push(if parent == "": c else: parent + " && " + c)
            prior.push("!(" + c + ")")
            taken.push(on)
            active.push(on)
        elif is_elif:
            val d = chain.len() - 1
            val c = _paren_cond(t)
            val base = if parent_chain[d] == "": prior[d] else: parent_chain[d] + " && " + prior[d]
            chain[d] = base + " && " + c
            val on = parent_active[d] and not taken[d] and _eval(c)
            active[d] = on
            taken[d] = taken[d] or on
            prior[d] = prior[d] + " && !(" + c + ")"
        elif is_else:
            val d = chain.len() - 1
            chain[d] = if parent_chain[d] == "": prior[d] else: parent_chain[d] + " && " + prior[d]
            val on = parent_active[d] and not taken[d]
            active[d] = on
            taken[d] = true
        elif is_end and chain.len() > 0:
            chain.pop()
            prior.pop()
            parent_chain.pop()
            parent_active.pop()
            taken.pop()
            active.pop()
        if (is_when or is_elif or is_else) and chain.len() > 0:
            val g = guard_id_v1("when", chain[chain.len() - 1])
            if not seen.contains(g.digest):
                seen.push(g.digest)
                evals.push(GuardEvalV1(guard: g, evaluable: g.canonical_expr != "",
                    active: active[active.len() - 1]))
        if chain.len() > 0 and not (is_when or is_elif or is_else or is_end):
            line_guard.push(guard_id_v1("when", chain[chain.len() - 1]).digest)
            if not active[active.len() - 1] and not t.starts_with("#"):
                if not cap.take_line(line, line_no):
                    _scan_bang_calls(line, names, args, use_lines, line_no)
            else:
                cap.close()
        else:
            cap.close()
            line_guard.push("")
    cap.close()
    MacroGuardScanV1(line_guard: line_guard, evals: evals, inactive_use_names: names,
        inactive_use_args: args, inactive_use_lines: use_lines, inactive_defs: cap)

fn _line_guard(scan: MacroGuardScanV1, line: i64) -> text:
    if line < 1 or line > scan.line_guard.len(): return ""
    scan.line_guard[line - 1]

fn _guard_of(scan: MacroGuardScanV1, digest: text) -> GuardIdV1:
    for e in scan.evals:
        if e.guard.digest == digest: return e.guard
    GuardIdV1(kind: "when", canonical_expr: "", digest: digest)

# ---------------------------------------------------------------------------

pub fn macro_module_source_from_parse_v1(package: text, module: text,
        source_id: text) -> MacroModuleSourceV1:
    val (src, _evals) = macro_module_source_from_parse_guarded_v1(package, module, source_id, "")
    src

# As above, plus @when guard ids/evaluations from the ORIGINAL (pre-
# preprocessor) `source`; "" means no guard information (all unguarded).
pub fn macro_module_source_from_parse_guarded_v1(package: text, module: text,
        source_id: text, source: text) -> (MacroModuleSourceV1, [GuardEvalV1]):
    val scan = macro_guard_scan_v1(source)
    var defs: [MacroSourceDefV1] = []
    var i = 0
    while i < macro_fact_def_count():
        val contract = macro_fact_def_contract_at(i)
        val raw_params = _split_csv(macro_fact_def_params_at(i))
        val body = macro_fact_def_body_at(i)
        val def = MacroDef(name: macro_fact_def_name_at(i), params: _param_names(raw_params),
            contract_intros: macro_contract_intros_v1(contract), contract_injects: [])
        var guards: [GuardIdV1] = []
        val g = _line_guard(scan, macro_fact_def_line_at(i))
        if g != "":
            guards.push(_guard_of(scan, g))
        defs.push(MacroSourceDefV1(def: def, namespace: "macro",
            body_text: contract + "\n" + body,
            nested_macro_names: _split_csv(macro_fact_def_nested_at(i)),
            declared_effects: macro_effects_of_source_v1(raw_params, body),
            guard_ids: guards, is_public: true))
        i = i + 1
    # Definitions inside inactive @when branches: recorded with their guard so
    # the projector retains them (non-resolving) and a guard flip is visible.
    val cap = scan.inactive_defs
    var x = 0
    while x < cap.names.len():
        val raw_params = _split_csv(cap.params[x])
        var guards: [GuardIdV1] = []
        val g = _line_guard(scan, cap.lines[x])
        if g != "":
            guards.push(_guard_of(scan, g))
        val def = MacroDef(name: cap.names[x], params: _param_names(raw_params),
            contract_intros: macro_contract_intros_v1(cap.contracts[x]), contract_injects: [])
        defs.push(MacroSourceDefV1(def: def, namespace: "macro",
            body_text: cap.contracts[x] + "\n" + cap.bodies[x],
            nested_macro_names: _split_csv(cap.nested[x]),
            declared_effects: macro_effects_of_source_v1(raw_params, cap.bodies[x]),
            guard_ids: guards, is_public: true))
        x = x + 1
    var u_names: [text] = []
    var u_args: [text] = []
    var u_lines: [i64] = []
    var u_active: [bool] = []
    var j = 0
    while j < macro_fact_use_count():
        u_names.push(macro_fact_use_name_at(j))
        u_args.push(macro_fact_use_args_at(j))
        u_lines.push(macro_fact_use_line_at(j))
        u_active.push(true)
        j = j + 1
    var k = 0
    while k < scan.inactive_use_names.len():
        var at = u_lines.len()
        var m = 0
        while m < u_lines.len():
            if u_lines[m] > scan.inactive_use_lines[k]:
                at = m
                break
            m = m + 1
        # Grow and shift the typed arrays together: inactive invocations at
        # the same line follow existing records, preserving stable ordinals.
        var tail = u_lines.len()
        u_names.push(scan.inactive_use_names[k])
        u_args.push(scan.inactive_use_args[k])
        u_lines.push(scan.inactive_use_lines[k])
        u_active.push(false)
        while tail > at:
            u_names[tail] = u_names[tail - 1]
            u_args[tail] = u_args[tail - 1]
            u_lines[tail] = u_lines[tail - 1]
            u_active[tail] = u_active[tail - 1]
            tail = tail - 1
        u_names[at] = scan.inactive_use_names[k]
        u_args[at] = scan.inactive_use_args[k]
        u_lines[at] = scan.inactive_use_lines[k]
        u_active[at] = false
        k = k + 1
    var invs: [MacroSourceInvocationV1] = []
    var seen: [text] = []
    var n = 0
    while n < u_names.len():
        val name = u_names[n]
        var ordinal = 0
        for s in seen:
            if s == name: ordinal = ordinal + 1
        seen.push(name)
        val region = "{name}#{ordinal}"
        invs.push(MacroSourceInvocationV1(region_id: region,
            stable_invocation_id: region, requested_name: name,
            invocation_text: name + "!(" + u_args[n] + ")", args_text: u_args[n],
            hygiene_scope_id: region, active_guard_id: _line_guard(scan, u_lines[n]),
            active: u_active[n]))
        n = n + 1
    (MacroModuleSourceV1(package: package, module: module, source_id: source_id,
        defs: defs, invocations: invs), scan.evals)

export macro_contract_intros_v1, macro_module_source_from_parse_v1
export macro_module_source_from_parse_guarded_v1, macro_guard_scan_v1, MacroGuardScanV1
export macro_effects_of_source_v1
