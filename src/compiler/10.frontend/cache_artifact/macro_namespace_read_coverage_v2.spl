# Namespace observation coverage, not an imported-name absence certificate.
# Call only with the current successful full-parse draft retained by its owner.
use compiler.frontend.cache_artifact.macro_category_projection_v2.{MacroCategoryDraftV2,
    MacroCategoryInputV2, macro_category_complete_v2}

pub enum MacroNamespaceReadCoverageV2:
    NoReads
    ResolvedReads

# Provenance is retained in the completed input (source/cfg/epoch/target/image).
# A constructible record is not an authentication token. ResolvedReads may be
# issued only by the future real import/access owner, not by this factory.
pub struct MacroNamespaceCompletedInputV2:
    input: MacroCategoryInputV2
    coverage: MacroNamespaceReadCoverageV2

# NoReads means the imported namespace is unobserved, not empty. Ordinary
# unrelated imports can remain unresolved without inventing a macro lookup.
# Both inactive invocations and nested reads of unused/exported definitions
# prevent this route: a future guard/caller must not inherit false absence.
pub fn macro_category_complete_no_reads_v2(draft: MacroCategoryDraftV2) -> Result<MacroNamespaceCompletedInputV2, text>:
    if draft.source.invocations.len() != 0:
        return Err("macro-namespace-access-receipts-required")
    if draft.source.defs.len() > 256:
        return Err("macro-namespace-definition-limit")
    for definition in draft.source.defs:
        if definition.nested_macro_names.len() != 0:
            return Err("macro-namespace-access-receipts-required")
    val completed = macro_category_complete_v2(draft, [])
    if completed.is_err(): return Err(completed.unwrap_err())
    Ok(MacroNamespaceCompletedInputV2(input: completed.unwrap(), coverage: MacroNamespaceReadCoverageV2.NoReads))
