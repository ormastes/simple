# Parser Types - Expression, Type, Pattern, Statement, and Operator AST
#
# Split from parser_types.spl.
# Contains all mutually-recursive expression-level AST types:
# - Type system (Type, TypeKind)
# - Tensor suffix types (DType, Device, Backend, TensorSuffix)
# - Expressions (Expr, ExprKind) and helper structs
# - Patterns (Pattern, PatternKind)
# - Statements (Stmt, StmtKind, Block)
# - Operators (BinOp, UnaryOp)
# - Inline assembly types

use compiler.common.diagnostics.span.{Span}

extern fn rt_enum_payload(value: TypeKind) -> i64
extern fn rt_enum_discriminant(value: TypeKind) -> i64
extern fn rt_tuple_get(tuple: i64, index: i64) -> i64
extern fn rt_println(msg: text)
extern fn rt_env_get(key: text) -> text

fn parser_types_trace_enabled() -> bool:
    """Level gate for TypeKind payload-decode tracing (default off).

    Set ``SIMPLE_TRACE_TYPEKIND=1`` to report every payload decode that is
    asked for an ``Array`` element but handed a different variant.  This is
    the probe that located the Stage-3 ``field access on nil receiver`` trap.
    """
    (rt_env_get("SIMPLE_TRACE_TYPEKIND") ?? "") == "1"

# ============================================================================
# Type AST
# ============================================================================

struct Type:
    """Type expression."""
    kind: TypeKind
    span: Span

"""Type expression kind."""
enum TypeKind:
    Named(text, [Type])
    Tuple([Type])
    Array(Type, Expr?)
    Function([Type], Type)
    Optional(Type)
    Reference(Type, bool)
    Atomic(Type)                # @T (Arc - atomic ref-counted)
    Isolated(Type)              # bitwise_not(T) (iso - isolated capability)
    Union([Type])               # A | B | C — union type
    Projection(Type, text)      # T.Item — associated type projection
    Infer
    Error
    # Appended to preserve all existing enum discriminants.
    Pointer(Type, bool)         # *T / *const T, *mut T
    Weak(Type)                  # -T (weak reference, resource-ownership sigil)

# Keep multi-field TypeKind extraction beside its owner.  Consumers that also
# import HirTypeKind have a colliding Named variant on stage4.
fn parser_type_kind_named_name(kind: TypeKind) -> text:
    if rt_enum_discriminant(kind) != rt_enum_discriminant(TypeKind.Named("", [])):
        return ""
    val payload = rt_enum_payload(kind)
    if payload == nil:
        return ""
    val name: text = rt_tuple_get(payload, 0)
    name

fn parser_type_kind_named_args(kind: TypeKind) -> [Type]:
    if rt_enum_discriminant(kind) != rt_enum_discriminant(TypeKind.Named("", [])):
        return []
    val payload = rt_enum_payload(kind)
    if payload == nil:
        return []
    val args: [Type] = rt_tuple_get(payload, 1)
    args

fn parser_type_kind_array_discriminant() -> i64:
    """Discriminant of `TypeKind.Array`, derived from a sample value.

    Derived from a sample rather than written as a literal so the guard keeps
    tracking the variant if the enum is ever reordered, matching how the
    `Named`/`Tuple` decoders above build their own comparison values.
    """
    val placeholder = Type(kind: TypeKind.Infer, span: Span(0, 0, 0, 0, "", 0))
    rt_enum_discriminant(TypeKind.Array(placeholder, nil))

fn parser_type_kind_array_element(kind: TypeKind, fallback: Type) -> Type:
    # Decode slot 0 ONLY for a real `Array` payload.  Every other variant
    # lays out slot 0 differently (`Named` puts `text` there, `Tuple`/`Union`
    # an array, `Infer`/`Error` nothing at all), so an unguarded decode
    # reinterprets a foreign value as a `Type`.  Same discriminant guard the
    # `Named`/`Tuple` decoders above already carry.
    if rt_enum_discriminant(kind) != parser_type_kind_array_discriminant():
        return fallback
    val payload = rt_enum_payload(kind)
    if payload == nil:
        return fallback
    val element: Type = rt_tuple_get(payload, 0)
    if element == nil:
        return fallback
    element

fn parser_type_kind_array_element_name(kind: TypeKind) -> text:
    """Name of an `Array` element type, or "" for any non-array kind.

    Callers (`module_surface`) invoke this on EVERY parameter and return
    type, not just array-typed ones, so a non-`Array` kind is the common
    case and must return "" rather than decode a foreign payload slot.
    """
    val disc = rt_enum_discriminant(kind)
    if disc != parser_type_kind_array_discriminant():
        if parser_types_trace_enabled():
            rt_println("[typekind] array-element-name on non-array disc={disc}")
        return ""
    val payload = rt_enum_payload(kind)
    if payload == nil:
        return ""
    val element: Type = rt_tuple_get(payload, 0)
    if element == nil:
        if parser_types_trace_enabled():
            rt_println("[typekind] array payload slot0 nil disc={disc}")
        return ""
    parser_type_kind_named_name(element.kind)

fn parser_type_kind_tuple_elements(kind: TypeKind) -> [Type]:
    if rt_enum_discriminant(kind) != rt_enum_discriminant(TypeKind.Tuple([])):
        return []
    match kind:
        case TypeKind.Tuple(elements): elements
        case _: []

fn parser_type_named_dependencies(type_: Type) -> [text]:
    """Collect every named type recursively from one parser-owned type.

    Multi-field ``TypeKind`` values are decoded only in this owner module via
    their typed discriminant/payload ABI. This avoids colliding staged-native
    matches in HIR scopes that also import ``HirTypeKind``.
    """
    val kind = type_.kind
    val disc = rt_enum_discriminant(kind)
    if disc == rt_enum_discriminant(TypeKind.Named("", [])):
        val name = parser_type_kind_named_name(kind)
        var names: [text] = []
        if name != "": names = names.push(name)
        for arg in parser_type_kind_named_args(kind):
            for nested in parser_type_named_dependencies(arg):
                names = names.push(nested)
        return names
    if disc == rt_enum_discriminant(TypeKind.Tuple([])):
        var names: [text] = []
        for element in parser_type_kind_tuple_elements(kind):
            for nested in parser_type_named_dependencies(element):
                names = names.push(nested)
        return names

    val placeholder = Type(kind: TypeKind.Infer, span: type_.span)
    if disc == rt_enum_discriminant(TypeKind.Array(placeholder, nil)):
        return parser_type_named_dependencies(
            parser_type_kind_array_element(kind, placeholder))
    val payload = rt_enum_payload(kind)
    if payload == nil: return []
    if disc == rt_enum_discriminant(TypeKind.Function([], placeholder)):
        val params: [Type] = rt_tuple_get(payload, 0)
        val return_type: Type = rt_tuple_get(payload, 1)
        var names: [text] = []
        for param in params:
            for nested in parser_type_named_dependencies(param):
                names = names.push(nested)
        for nested in parser_type_named_dependencies(return_type):
            names = names.push(nested)
        return names
    if disc == rt_enum_discriminant(TypeKind.Optional(placeholder)):
        val inner: Type = payload
        return parser_type_named_dependencies(inner)
    if disc == rt_enum_discriminant(TypeKind.Reference(placeholder, false)):
        val inner: Type = rt_tuple_get(payload, 0)
        return parser_type_named_dependencies(inner)
    if disc == rt_enum_discriminant(TypeKind.Atomic(placeholder)):
        val inner: Type = payload
        return parser_type_named_dependencies(inner)
    if disc == rt_enum_discriminant(TypeKind.Isolated(placeholder)):
        val inner: Type = payload
        return parser_type_named_dependencies(inner)
    if disc == rt_enum_discriminant(TypeKind.Union([])):
        val members: [Type] = payload
        var names: [text] = []
        for member in members:
            for nested in parser_type_named_dependencies(member):
                names = names.push(nested)
        return names
    if disc == rt_enum_discriminant(TypeKind.Projection(placeholder, "")):
        val base: Type = rt_tuple_get(payload, 0)
        return parser_type_named_dependencies(base)
    if disc == rt_enum_discriminant(TypeKind.Pointer(placeholder, false)):
        val inner: Type = rt_tuple_get(payload, 0)
        return parser_type_named_dependencies(inner)
    []

# ============================================================================
# Tensor Suffix
# ============================================================================

"""Data type for tensors."""
enum DType:
    F16
    F32
    F64
    BF16
    I8
    I16
    I32
    I64
    U8
    U16
    U32
    U64

"""Device for tensor computation."""
enum Device:
    CPU
    CUDA(i32)   # CUDA device (0=1st GPU, 1=2nd GPU, etc.)

"""Tensor backend."""
enum Backend:
    Native
    PyTorch

struct TensorSuffix:
    """Suffix for array/tensor literals specifying dtype, device, etc.

    Examples:
    - f32        -> dtype=F32
    - _f32_gpu   -> dtype=F32, device=CUDA(0)  (gpu = default GPU)
    - f32_tr_cuda -> dtype=F32, trainable=true, device=CUDA(0)
    """
    # # DESUGARED: dtype: DType
    has_dtype: bool
    dtype: DType
    # # DESUGARED: device: Device
    has_device: bool
    device: Device
    trainable: bool
    pinned: bool
    # # DESUGARED: backend: Backend
    has_backend: bool
    backend: Backend
    raw: text       # Original suffix string


# ============================================================================
# TensorSuffix Methods (was: impl TensorSuffix:)
# ============================================================================

fn tensorsuffix_from_string(text: text) -> TensorSuffix:
        """Parse a suffix string into TensorSuffix."""
        var suffix = TensorSuffix(nil, nil, false, false, nil, text)

        # Split by underscore and parse each part
        var parts = text.split("_")
        for part in parts:
            if part == "":
                continue

            # Check dtype
            match part:
                case "f16": suffix.dtype = DType.F16
                case "f32": suffix.dtype = DType.F32
                case "f64": suffix.dtype = DType.F64
                case "bf16": suffix.dtype = DType.BF16
                case "i8": suffix.dtype = DType.I8
                case "i16": suffix.dtype = DType.I16
                case "i32": suffix.dtype = DType.I32
                case "i64": suffix.dtype = DType.I64
                case "u8": suffix.dtype = DType.U8
                case "u16": suffix.dtype = DType.U16
                case "u32": suffix.dtype = DType.U32
                case "u64": suffix.dtype = DType.U64
                # Check device
                case "cpu": suffix.device = Device.CPU
                case "gpu": suffix.device = Device.CUDA(0)  # gpu = default GPU (1st GPU)
                case "cuda": suffix.device = Device.CUDA(0)
                case "cuda0": suffix.device = Device.CUDA(0)
                case "cuda1": suffix.device = Device.CUDA(1)
                case "cuda2": suffix.device = Device.CUDA(2)
                case "cuda3": suffix.device = Device.CUDA(3)
                # Check modifiers
                case "tr": suffix.trainable = true
                case "pin": suffix.pinned = true
                # Check backend
                case "native": suffix.backend = Backend.Native
                case "torch": suffix.backend = Backend.PyTorch
                case _:
                    # Unknown part - could be cudaN for N > 3
                    if part.starts_with("cuda"):
                        val id_str = part[4:]
                        if id_str.len() > 0:
                            # Parse the numeric ID
                            val id = tensorsuffix_parse_int(id_str)
                            # Map "cudaN" suffix to CUDA device N
                            suffix.device = Device.CUDA(id)

        suffix

fn tensorsuffix_parse_int(value: text) -> i64:
        var result = 0
        var i = 0
        while i < value.len():
            val code = value[i].ord()
            if code >= 48 and code <= 57:
                result = result * 10 + (code - 48)
            i = i + 1
        result


# ============================================================================
# Expression AST
# ============================================================================

struct Expr:
    """Expression."""
    kind: ExprKind
    span: Span

"""Expression kind."""
enum ExprKind:
    # Literals
    IntLit(i64)
    FloatLit(f64)
    StringLit(text, [Interpolation]?)
    BoolLit(bool)
    NilLit
    ArrayLit([Expr])
    ArrayRepeat(Expr, Expr)     # [value; count] — repeat value count times
    TupleLit([Expr])
    DictLit([(Expr, Expr)])
    SetLit([Expr])              # Set literal: s{1, 2, 3}

    # Identifiers and access
    Ident(text)
    Field(Expr, text)
    Index(Expr, Expr)
    OptionalChain(Expr, text)  # ?.
    NullCoalesce(Expr, Expr)    # ??
    ExistsCheck(Expr)                   # .? — value if present, nil if absent
    ForceUnwrap(Expr)                   # ! — value if present, panic if nil
    Cast(Expr, Type)                    # expr as Type

    # Operators
    Binary(BinOp, Expr, Expr)
    Unary(UnaryOp, Expr)
    Assign(Expr, AssignOp?, Expr)
    Range(Expr?, Expr?, bool, Expr?)

    # Function calls
    Call(Expr, [CallArg])
    MethodCall(Expr, text, [CallArg])

    # Control flow expressions
    If(Expr, Block, Block?)
    IfChain([IfArm], Block?)
    MatchCase(Expr, [MatchArm])
    Try(Expr)                           # expr
    TryCatch(Block, [CatchClause], Block?)

    # Closures
    Lambda([LambdaParam], Expr)
    Block(Block)

    # Comprehensions
    ListComprehension(Expr, [ComprehensionClause])
    DictComprehension(Expr, Expr, [ComprehensionClause])

    # Special
    Await(Expr)
    Spawn(Expr)                     # spawn expr - actor creation
    Yield(Expr?)
    Return(Expr?)
    Break(text?)
    Continue(text?)
    Throw(Expr)

    # Object construction
    StructLit(text, [(text, Expr)])
    EnumLit(text, text, EnumPayload?)

    # Math/DL blocks
    LossBlock(Block)            # loss{ ... } - enables autograd, auto-backward
    NogradBlock(Block)          # nograd{ ... } - disables gradient tracking

    # Unsafe block - allows raw pointer ops, SFFI, inline assembly
    UnsafeBlock(Block, [text])  # unsafe: ... - unsafe operations; capability names from `unsafe(capabilities: [...])`

    # Inline assembly - must be within unsafe block
    AsmBlock(AsmExpr)            # asm { mov eax, ebx } or legacy asm volatile(...)

    # Target-qualified inline assembly - multi-target dispatch
    AsmMatch([AsmMatchArm])      # asm match: case [spec]: ...

    # Generic custom block (user-defined blocks like sh{}, sql{}, re{})
    CustomBlock(text, BlockValue)

    # Tensor literals with suffix
    ArrayLitSuffix([Expr], TensorSuffix)

    # GPU kernel launch: kernel<<<grid, block>>>(args)
    KernelLaunch(Expr, Expr, Expr, [CallArg])

    # GPU intrinsic functions
    GpuIntrinsic(GpuIntrinsicKind, [Expr])

    # Error recovery
    Error

"""GPU intrinsic function kinds."""
enum GpuIntrinsicKind:
    # Thread ID accessors
    GlobalId(i64)      # gpu_global_id(dim)
    LocalId(i64)       # gpu_local_id(dim)
    BlockId(i64)       # gpu_block_id(dim)
    BlockDim(i64)      # gpu_block_dim(dim)
    GridDim(i64)       # gpu_grid_dim(dim)

    # Synchronization
    Sync                    # gpu_sync()
    Barrier                 # gpu_barrier()
    MemFence                # gpu_mem_fence()

    # Atomic operations
    AtomicAdd               # gpu_atomic_add(ptr, val)
    AtomicSub               # gpu_atomic_sub(ptr, val)
    AtomicMin               # gpu_atomic_min(ptr, val)
    AtomicMax               # gpu_atomic_max(ptr, val)
    AtomicAnd               # gpu_atomic_and(ptr, val)
    AtomicOr                # gpu_atomic_or(ptr, val)
    AtomicXor               # gpu_atomic_xor(ptr, val)
    AtomicExchange          # gpu_atomic_exchange(ptr, val)
    AtomicCas               # gpu_atomic_cas(ptr, expected, desired)

    # Sub-group / warp intrinsics
    LaneId                  # gpu_lane_id()
    WarpId                  # gpu_warp_id()
    WarpSize                # gpu_warp_size()
    WarpShuffle             # gpu_warp_shuffle(value, src_lane)
    WarpShuffleDown         # gpu_warp_shuffle_down(value, delta)
    WarpShuffleUp           # gpu_warp_shuffle_up(value, delta)
    WarpShuffleXor          # gpu_warp_shuffle_xor(value, mask)
    WarpBallot              # gpu_warp_ballot(pred)
    WarpReduceAdd           # gpu_warp_reduce_add(value) — warp-level tree reduction
    WarpBroadcast           # gpu_warp_broadcast(value, src_lane) — broadcast from lane
    WarpScanAdd             # gpu_warp_scan_add(value) — inclusive prefix sum within warp

    # Specialization constants (W2.5)
    SpecConst               # gpu_spec_const_i64(name, default) — late-bound constant folded at emit time

    # Vector load/store (W2.6)
    Vec4LoadF32             # gpu_vec4_load_f32(ptr, index) — vectorized 4-wide f32 load
    Vec4StoreF32            # gpu_vec4_store_f32(ptr, index, v0, v1, v2, v3) — vectorized 4-wide f32 store
    Vec2LoadF32             # gpu_vec2_load_f32(ptr, index) — vectorized 2-wide f32 load
    Vec2StoreF32            # gpu_vec2_store_f32(ptr, index, v0, v1) — vectorized 2-wide f32 store

struct Interpolation:
    """String interpolation."""
    expr: Expr
    # # DESUGARED: format: text
    has_format: bool
    format: text
    span: Span

struct CallArg:
    """Function call argument."""
    # # DESUGARED: name: text
    has_name: bool
    name: text
    value: Expr
    span: Span

struct MatchArm:
    """Match arm."""
    pattern: Pattern
    # # DESUGARED: guard: Expr
    has_guard: bool
    guard: Expr
    body: Block
    span: Span

struct CatchClause:
    """Catch clause in try-catch."""
    # # DESUGARED: pattern: Pattern
    has_pattern: bool
    pattern: Pattern
    # # DESUGARED: type_: Type
    has_type_: bool
    type_: Type
    body: Block
    span: Span

struct LambdaParam:
    """Lambda parameter."""
    name: text
    # # DESUGARED: type_: Type
    has_type_: bool
    type_: Type
    span: Span

struct ComprehensionClause:
    """Comprehension clause."""
    kind: ComprehensionKind
    span: Span

enum ComprehensionKind:
    For(text, Expr)
    If(Expr)

enum EnumPayload:
    Tuple([Expr])
    Struct([(text, Expr)])

# ============================================================================
# Pattern AST
# ============================================================================

struct Pattern:
    """Pattern for matching."""
    kind: PatternKind
    span: Span

"""Pattern kind."""
enum PatternKind:
    Wildcard                                  # _
    Literal(Expr)                      # 42, "hello", true
    Binding(text, bool)        # x, var x
    Tuple([Pattern])                # (a, b, c)
    Array([Pattern], text?)   # [a, b, ..rest]
    Struct(text, [(text, Pattern)]) # Point { x, y }
    Enum(text, text, EnumPatternPayload?)
    Or([Pattern])                   # a | b | c
    Guard(Pattern, Expr)      # p if cond
    As(Pattern, text)          # p as name
    Range(Expr?, Expr?, bool) # 1..10, 1..=10
    Error
    # §2 of doc/05_design/compiler/hardening/critical_completeness_design_2026-08-21.md.
    # `case complete ext:` / `case dyn ext:` -- region arms, NOT wildcards:
    # `complete` covers only the frozen complete region and `dyn` only the open
    # region, so neither closes a missing STATIC constructor. The payload is
    # the binder name. Added LAST on purpose: variant ORDINALS are ABI here
    # (the Rust seed and the discriminant-based helpers read them positionally),
    # so inserting anywhere else renumbers every existing pattern kind.
    CompleteRegion(text)
    DynRegion(text)

enum EnumPatternPayload:
    Tuple([Pattern])
    Struct([(text, Pattern)])

# ============================================================================
# Statement AST
# ============================================================================

struct Stmt:
    """Statement."""
    kind: StmtKind
    span: Span

fn expr_kind(expr: Expr) -> ExprKind:
    expr.kind

fn stmt_kind(stmt: Stmt) -> StmtKind:
    stmt.kind

"""Statement kind."""
enum StmtKind:
    Expr(Expr)
    Val(text, Type?, Expr)
    Var(text, Type?, Expr?)
    SharedVal(text, Type, Expr?)    # GPU shared memory (immutable)
    SharedVar(text, Type, Expr?)    # GPU shared memory (mutable)
    Assign(Expr, AssignOp?, Expr)
    For(text, Expr, Block)
    While(Expr, Block)
    Loop(Block)
    Break(text?)
    Continue(text?)
    Return(Expr?)
    Yield(Expr?)
    Throw(Expr)
    With([WithItem], Block)         # with statement - context managers
    AsmAssert(AsmTargetSpec)        # asm assert [spec] - compile-time target guard
    GpuLaunch(GpuLaunchConfig, Block)  # gpu_launch(grid: (...), block: (...)): body

"""Assignment operator."""
enum AssignOp:
    Add     # +=
    Sub     # -=
    Mul     # *=
    Div     # /=
    Mod     # %=

struct Block:
    """Block of statements."""
    stmts: [Stmt]
    span: Span

struct IfArm:
    """One ordered arm in a flattened if/elif expression."""
    cond: Expr
    then_: Block
    span: Span

struct WithItem:
    """Context manager item in with statement."""
    context_expr: Expr      # Expression that produces context manager
    # # DESUGARED: target: text
    has_target: bool
    target: text
    span: Span

struct GpuLaunchConfig:
    """GPU kernel launch configuration.

    Syntax:
        gpu_launch(grid: (256,), block: (256,)):
            kernel_fn(args...)

    The grid and block tuples specify the CUDA/GPU execution dimensions.
    Each can be 1D (x,), 2D (x, y), or 3D (x, y, z).
    """
    grid: [Expr]    # Grid dimensions (1-3 expressions)
    block: [Expr]   # Block dimensions (1-3 expressions)
    span: Span

# ============================================================================
# Operators
# ============================================================================

"""Binary operator."""
enum BinOp:
    Invalid
    # Arithmetic
    Add
    Sub
    Mul
    Div
    Mod
    Pow

    # Matrix operations
    MatMul              # @

    # Comparison
    Eq
    NotEq
    Lt
    LtEq
    Gt
    GtEq

    # Logical
    And
    Or

    # Bitwise
    BitAnd
    BitOr
    BitXor
    Shl
    Shr

    # Broadcast operations (dotted operators)
    BroadcastAdd        # .+
    BroadcastSub        # .-
    BroadcastMul        # .*
    BroadcastDiv        # ./
    BroadcastPow        # .^

    # Pipeline/Composition operators
    PipeForward         # |>
    Compose             # >>
    ComposeBack         # <<
    Parallel            # //
    LayerConnect        # ~>

    # Other
    In
    NotIn
    Is
    IsNot

"""Unary operator."""
enum UnaryOp:
    Neg         # -
    Not         # not, !
    BitNot      # ~
    Ref         # &
    RefMut      # &mut
    Deref       # *
    Transpose   # ' (postfix, m{} only)

# ============================================================================
# Inline Assembly
# ============================================================================

struct AsmExpr:
    """Inline assembly expression.

    Supports two syntaxes:
    1. Simple: asm { mov eax, ebx }
    2. Full legacy: asm volatile("mov r0, {op}", op = in(reg) value, clobber_abi("C"))
    """
    asm_template: text              # Assembly asm_template string
    is_volatile: bool           # volatile flag (prevent optimization)
    constraints: [AsmConstraint]  # Register/memory constraints
    clobbers: [text]            # Clobbered registers
    clobber_abis: [text]        # ABI clobber sets
    options: [text]             # Backend inline-asm options
    span: Span

struct AsmConstraint:
    """Assembly operand constraint.

    Examples:
    - op = in(reg) value        # Input register
    - result = out(reg) var     # Output register
    - ptr = inout(reg) addr     # Input/output register
    """
    name: text                  # Operand name (e.g., "op", "result")
    kind: AsmConstraintKind     # in, out, inout
    location: AsmLocation       # reg, mem, etc.
    value: Expr                 # Expression for operand
    output_value: Expr?         # Distinct inout destination, when present
    span: Span

enum AsmConstraintKind:
    In          # Input operand
    Out         # Output operand
    InOut       # Input/output operand
    LateOut     # Late output (clobbers after inputs read)

enum AsmLocation:
    Reg         # General register
    RegSpec(text)  # Specific register (e.g., "eax", "r0")
    Mem         # Memory location
    Imm         # Immediate value

# ============================================================================
# Target-Qualified ASM Types
# ============================================================================

struct AsmTargetSpec:
    """Target specifier for asm match/assert.

    Format: [arch, os, abi, backend version_constraint]
    All fields after arch are optional (nil = wildcard).
    """
    archs: [text]                          # ["x86_64"] or ["x86_64", "x86"]
    # # DESUGARED: os: text
    has_os: bool
    os: text                               # "linux" or nil (wildcard)
    # # DESUGARED: abi: text
    has_abi: bool
    abi: text                              # "gnu" or nil (wildcard)
    # # DESUGARED: backend: text
    has_backend: bool
    backend: text                          # "llvm" or nil (wildcard)
    version_constraints: [AsmVersionConstraint]
    span: Span

struct AsmVersionConstraint:
    """Version constraint for backend in asm target spec.

    Examples: >= 15, == 17, < 18, ~= 17
    """
    op: text                               # ">=", "==", "<", "~="
    version: i64

struct AsmMatchArm:
    """Single arm in an asm match expression.

    Either a target-qualified asm body or a compile_error.
    """
    # # DESUGARED: spec: AsmTargetSpec
    has_spec: bool
    spec: AsmTargetSpec                    # nil = wildcard (_)
    is_wildcard: bool
    # # DESUGARED: asm_body: AsmExpr
    has_asm_body: bool
    asm_body: AsmExpr                      # nil if compile_error
    is_compile_error: bool
    error_message: text
    span: Span

