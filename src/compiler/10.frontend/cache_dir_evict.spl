# Size-capped LRU eviction for the FLAT entry caches (`*.fpc` front-end parse
# entries, `*.hir` HIR entries). Each entry is one self-contained file whose
# name is a content hash, so eviction is a plain unlink: there is no index to
# keep consistent and no partially-deleted state a later run could mistake for
# a hit. That is the whole reason this is separate from the CAS store's GC
# (80.driver/cache/gc/) — that machinery exists for a multi-file store with
# leases and trash, and none of it is needed here.
#
# CRASH SAFETY / CONCURRENCY.
#   * `*.tmp` files are never touched: they are in-flight stores by other pids.
#   * Files modified within GRACE_SECS are never evicted, so an entry a live
#     build just wrote or just read past cannot be pulled out from under it.
#     A reader that loses the race sees a missing file, which every caller
#     already treats as a miss — the caches are designed so a miss is slow,
#     never wrong.
#   * LRU order is mtime. `rt_file_stat` is seconds-resolution and store is
#     write-then-rename, so ties are broken arbitrarily; that only affects
#     WHICH cold entry goes, never correctness.
#
# Selection uses a stable min-heap keyed by (mtime, discovery index): one O(n)
# directory scan, O(e) heap construction for e grace-eligible entries, then
# O(log e) per deletion attempt. If an entry dir ever exceeds ~100k files it
# needs an index file instead of a scan — at that point adopt
# 80.driver/cache/gc/ rather than growing this.

@unsafe(reason: "raw nullable environment read; nil signals missing input or provider failure", capabilities: [ffi])
extern fn rt_env_get(key: text) -> text?
@unsafe(reason: "raw directory listing; nil signals provider failure", capabilities: [ffi])
extern fn rt_dir_list(path: text) -> [text]?
@unsafe(reason: "raw directory predicate; false conflates absence with provider failure", capabilities: [ffi])
extern fn rt_dir_exists(path: text) -> bool
@unsafe(reason: "raw file-size probe; non-positive sentinels conflate empty files with provider failure", capabilities: [ffi])
extern fn rt_file_size(path: text) -> i64
@unsafe(reason: "raw file timestamp probe; zero conflates the epoch with provider failure", capabilities: [ffi])
extern fn rt_file_stat(path: text) -> i64
@unsafe(reason: "raw cache-file deletion; false conflates absence with provider failure", capabilities: [ffi])
extern fn rt_file_delete(path: text) -> bool
@unsafe(reason: "raw wall-clock read; provider validity is not cryptographically admitted", capabilities: [ffi])
extern fn rt_time_now_unix_micros() -> i64

# 512 MiB. Big enough that a full bootstrap front-end parse closure stays warm
# without thrashing, small enough that stale scopes cannot accumulate multi-GiB
# parse caches on disk.
val CACHE_DEFAULT_MAX_BYTES: i64 = 536870912

# Entries touched this recently are assumed live and are never evicted.
val CACHE_EVICT_GRACE_SECS: i64 = 300

# Sweep every N stores rather than on every store, so the scan cost amortises
# while still firing inside sharded front-end workers.
val CACHE_EVICT_SWEEP_INTERVAL: i64 = 64

@representation_boundary(kind: "ffi", reason: "Explicit unsafe ffi boundary in cache_dir_max_bytes", reviewers: ["ormastes", "opus-review"], capabilities: ["ffi"])
pub fn cache_dir_max_bytes() -> i64:
    var raw = ""
    unsafe(capabilities: [ffi]):
        raw = rt_env_get("SIMPLE_CACHE_MAX_BYTES") ?? ""
    if raw == "":
        return CACHE_DEFAULT_MAX_BYTES
    val parsed = raw.to_i64() ?? -1
    if parsed < 0:
        return CACHE_DEFAULT_MAX_BYTES
    parsed

pub fn cache_dir_evict_due(store_count: i64) -> bool:
    if store_count <= 0:
        return false
    store_count % CACHE_EVICT_SWEEP_INTERVAL == 0

# Internal eviction state, public only so the ordering/accounting contract can
# be covered without sleeping for the filesystem grace period. Candidate
# indexes are their discovery order, which makes equal-mtime eviction stable.
pub class _CacheDirEvictPlan:
    paths: [text]
    sizes: [i64]
    mtimes: [i64]
    heap: [i64]
    total: i64
    removed: i64

    static fn empty() -> _CacheDirEvictPlan:
        _CacheDirEvictPlan(
            paths: [], sizes: [], mtimes: [], heap: [], total: 0, removed: 0
        )

    fn _precedes(left: i64, right: i64) -> bool:
        if self.mtimes[left] != self.mtimes[right]:
            return self.mtimes[left] < self.mtimes[right]
        left < right

    me _heap_swap(left: i64, right: i64):
        val candidate = self.heap[left]
        self.heap[left] = self.heap[right]
        self.heap[right] = candidate

    me _sift_down(start: i64):
        var index = start
        while true:
            val left = index * 2 + 1
            if left >= self.heap.len():
                return
            val right = left + 1
            var first = left
            if (
                right < self.heap.len() and
                self._precedes(self.heap[right], self.heap[left])
            ):
                first = right
            if not self._precedes(self.heap[first], self.heap[index]):
                return
            self._heap_swap(index, first)
            index = first

    # Account all matching bytes, including grace-protected entries. Only
    # eligible entries enter the eviction heap.
    me account_entry(path: text, size: i64, mtime: i64, now_secs: i64):
        self.total = self.total + size
        if now_secs - mtime < CACHE_EVICT_GRACE_SECS:
            return
        val candidate = self.paths.len()
        self.paths.push(path)
        self.sizes.push(size)
        self.mtimes.push(mtime)
        self.heap.push(candidate)

    # Bottom-up construction is linear and is delayed until the cap is
    # exceeded, so the common under-cap path performs no heap comparisons.
    me prepare():
        if self.heap.len() < 2:
            return
        var start = (self.heap.len() - 2) / 2
        while true:
            self._sift_down(start)
            if start == 0:
                return
            start = start - 1

    fn total_bytes() -> i64:
        self.total

    fn removed_count() -> i64:
        self.removed

    fn candidate_count() -> i64:
        self.heap.len()

    fn over_cap(max_bytes: i64) -> bool:
        self.total > max_bytes

    fn has_candidate() -> bool:
        self.heap.len() > 0

    fn oldest_path() -> text:
        if self.heap.len() == 0:
            return ""
        self.paths[self.heap[0]]

    fn oldest_size() -> i64:
        if self.heap.len() == 0:
            return 0
        self.sizes[self.heap[0]]

    # A candidate is attempted at most once even when deletion fails, matching
    # the previous selection loop's path-emptying behavior.
    me pop_oldest():
        if self.heap.len() == 0:
            return
        val last = self.heap.len() - 1
        if last > 0:
            self.heap[0] = self.heap[last]
        val _ = self.heap.pop()
        if self.heap.len() > 0:
            self._sift_down(0)

    # Failed deletion preserves both byte accounting and the removed count.
    me record_delete(size: i64, deleted: bool):
        if not deleted:
            return
        self.total = self.total - size
        self.removed = self.removed + 1

fn _cache_evict_join(dir: text, name: text) -> text:
    if dir == "":
        return name
    if dir.ends_with("/") or dir.ends_with("\\"):
        return dir + name
    dir + "/" + name

# Reap stale orphan `*.tmp` files older than `CACHE_EVICT_TMP_GRACE_SECS` (1 hour)
# without touching active in-flight writes. Kept separate from
# `_cache_dir_evict_to_cap_at` and synthetic-clock tree sweeps so byte-cap
# sweeps with synthetic `now_override_secs` never disturb `.tmp` files directly.
pub const CACHE_EVICT_TMP_GRACE_SECS: i64 = 3600

# reason: directory path and epoch-second timestamp scalars matching _cache_dir_evict_to_cap_at
@representation_boundary(kind: "ffi", reason: "Explicit unsafe ffi boundary in cache_dir_reap_stale_tmp_v1", reviewers: ["ormastes", "opus-review"], capabilities: ["ffi"])
@allow(primitive_api)
pub fn cache_dir_reap_stale_tmp_v1(dir: text, now_secs: i64 = 0) -> i64:
    var dir_ok = false
    unsafe(capabilities: [ffi]):
        dir_ok = rt_dir_exists(dir)
    if not dir_ok:
        return 0
    var now_micros: i64 = 0
    unsafe(capabilities: [ffi]):
        now_micros = rt_time_now_unix_micros()
    val now = if now_secs > 0: now_secs else: now_micros / 1000000
    var removed: i64 = 0
    var pending_dirs: [text] = [dir]
    var dir_idx: i64 = 0
    while dir_idx < pending_dirs.len():
        val cur_dir = pending_dirs[dir_idx]
        dir_idx = dir_idx + 1
        var entries: [text] = []
        unsafe(capabilities: [ffi]):
            entries = rt_dir_list(cur_dir) ?? []
        for name in entries:
            if name == "" or name == "." or name == "..":
                continue
            val path = _cache_evict_join(cur_dir, name)
            if name.ends_with(".tmp"):
                var tmp_mtime: i64 = 0
                unsafe(capabilities: [ffi]):
                    tmp_mtime = rt_file_stat(path)
                if tmp_mtime > 0 and now - tmp_mtime >= CACHE_EVICT_TMP_GRACE_SECS:
                    var deleted = false
                    unsafe(capabilities: [ffi]):
                        deleted = rt_file_delete(path)
                    if deleted:
                        removed = removed + 1
            else:
                var sub_present = false
                unsafe(capabilities: [ffi]):
                    sub_present = rt_dir_exists(path)
                if sub_present:
                    pending_dirs.push(path)
    removed

@representation_boundary(kind: "ffi", reason: "Explicit unsafe ffi boundary in _cache_evict_maybe_reap_orphan_seal", reviewers: ["ormastes", "opus-review"], capabilities: ["ffi"])
fn _cache_evict_maybe_reap_orphan_seal(dir: text, name: text, suffix: text, now_secs: i64):
    if not name.ends_with(".seal") or name.byte_len() <= 5:
        return
    val primary_name = name.substring(0, name.byte_len() - 5)
    if not primary_name.ends_with(suffix):
        return
    val seal_path = _cache_evict_join(dir, name)
    val primary_path = _cache_evict_join(dir, primary_name)
    var primary_size: i64 = 0
    var seal_mtime: i64 = 0
    unsafe(capabilities: [ffi]):
        primary_size = rt_file_size(primary_path)
        seal_mtime = rt_file_stat(seal_path)
    if primary_size <= 0 and seal_mtime > 0 and now_secs - seal_mtime >= CACHE_EVICT_GRACE_SECS:
        unsafe(capabilities: [ffi]):
            val _orphan_seal = rt_file_delete(seal_path)

@representation_boundary(kind: "ffi", reason: "Explicit unsafe ffi boundary in _cache_evict_maybe_reap_orphan_u006", reviewers: ["ormastes", "opus-review"], capabilities: ["ffi"])
fn _cache_evict_maybe_reap_orphan_u006(dir: text, name: text, now_secs: i64):
    if not name.ends_with(".u006") or name.byte_len() <= 5:
        return
    val stem = name.substring(0, name.byte_len() - 5)
    val u006_path = _cache_evict_join(dir, name)
    val primary_path = _cache_evict_join(dir, stem + ".fpc")
    var primary_size: i64 = 0
    var sidecar_mtime: i64 = 0
    unsafe(capabilities: [ffi]):
        primary_size = rt_file_size(primary_path)
        sidecar_mtime = rt_file_stat(u006_path)
    if primary_size <= 0 and sidecar_mtime > 0 and now_secs - sidecar_mtime >= CACHE_EVICT_GRACE_SECS:
        unsafe(capabilities: [ffi]):
            val _orphan_u006 = rt_file_delete(u006_path)

@representation_boundary(kind: "ffi", reason: "Explicit unsafe ffi boundary in _cache_evict_account_file", reviewers: ["ormastes", "opus-review"], capabilities: ["ffi"])
fn _cache_evict_account_file(plan: _CacheDirEvictPlan, path: text, name: text, now_secs: i64):
    var size: i64 = 0
    unsafe(capabilities: [ffi]):
        size = rt_file_size(path)
    if size <= 0:
        return
    if name.ends_with(".spab"):
        var seal_size: i64 = 0
        unsafe(capabilities: [ffi]):
            seal_size = rt_file_size(path + ".seal")
        if seal_size > 0:
            size = size + seal_size
    var mtime: i64 = 0
    unsafe(capabilities: [ffi]):
        mtime = rt_file_stat(path)
    plan.account_entry(path, size, mtime, now_secs)

@representation_boundary(kind: "ffi", reason: "Explicit unsafe ffi boundary in _cache_evict_drain_plan", reviewers: ["ormastes", "opus-review"], capabilities: ["ffi"])
fn _cache_evict_drain_plan(plan: _CacheDirEvictPlan, max_bytes: i64, cleanup_u006: bool):
    if not plan.over_cap(max_bytes):
        return
    plan.prepare()
    while plan.over_cap(max_bytes) and plan.has_candidate():
        val victim = plan.oldest_path()
        val victim_size = plan.oldest_size()
        plan.pop_oldest()
        var deleted = false
        unsafe(capabilities: [ffi]):
            deleted = rt_file_delete(victim)
            if deleted:
                val _seal = rt_file_delete(victim + ".seal")
                if cleanup_u006 and victim.ends_with(".fpc") and victim.byte_len() > 4:
                    val u006_path = victim.substring(0, victim.byte_len() - 4) + ".u006"
                    val _u006 = rt_file_delete(u006_path)
        plan.record_delete(victim_size, deleted)

# Evicts least-recently-modified entries with the given suffix until the
# directory's total entry bytes are at or below `max_bytes`. Returns the number
# of entries deleted. A `max_bytes` of 0 disables eviction entirely.
@representation_boundary(kind: "ffi", reason: "Explicit unsafe ffi boundary in cache_dir_evict_to_cap", reviewers: ["ormastes", "opus-review"], capabilities: ["ffi"])
pub fn cache_dir_evict_to_cap(dir: text, suffix: text, max_bytes: i64) -> i64:
    var now_micros: i64 = 0
    unsafe(capabilities: [ffi]):
        now_micros = rt_time_now_unix_micros()
    val now_secs = now_micros / 1000000
    val _reaped_tmp = cache_dir_reap_stale_tmp_v1(dir, now_secs)
    _cache_dir_evict_to_cap_at(dir, suffix, max_bytes, now_secs)

@representation_boundary(kind: "ffi", reason: "Explicit unsafe ffi boundary in _cache_dir_evict_to_cap_at", reviewers: ["ormastes", "opus-review"], capabilities: ["ffi"])
fn _cache_dir_evict_to_cap_at(dir: text, suffix: text, max_bytes: i64, now_secs: i64) -> i64:
    if max_bytes <= 0 or dir == "":
        return 0
    var dir_present = false
    var spab_tree_present = false
    unsafe(capabilities: [ffi]):
        dir_present = rt_dir_exists(dir)
        spab_tree_present = rt_dir_exists(_cache_evict_join(dir, "artifacts/v1"))
    if not dir_present:
        return 0
    val plan = _CacheDirEvictPlan.empty()
    var entries: [text] = []
    unsafe(capabilities: [ffi]):
        entries = rt_dir_list(dir) ?? []
    val cleanup_u006 = suffix == ".fpc" and not spab_tree_present
    for name in entries:
        if name == "" or name == "." or name == "..":
            continue
        if name.ends_with(".seal"):
            _cache_evict_maybe_reap_orphan_seal(dir, name, suffix, now_secs)
            continue
        if cleanup_u006 and name.ends_with(".u006"):
            _cache_evict_maybe_reap_orphan_u006(dir, name, now_secs)
            continue
        if name.ends_with(".tmp"):
            continue
        if not name.ends_with(suffix):
            continue
        _cache_evict_account_file(plan, _cache_evict_join(dir, name), name, now_secs)
    _cache_evict_drain_plan(plan, max_bytes, cleanup_u006)
    plan.removed_count()

pub struct CacheTreeEvictRequestV1:
    root_dir: text
    suffix: text
    max_bytes: i64
    now_override_secs: i64 = -1

pub struct CacheTreeEvictSummaryV1:
    removed: i64
    remaining_bytes: i64

@representation_boundary(kind: "ffi", reason: "Explicit unsafe ffi boundary in _cache_evict_walk_tree_into_plan", reviewers: ["ormastes", "opus-review"], capabilities: ["ffi"])
fn _cache_evict_walk_tree_into_plan(root_dir: text, suffix: text, now_secs: i64, plan: _CacheDirEvictPlan):
    var pending_dirs: [text] = [root_dir]
    var dir_idx: i64 = 0
    while dir_idx < pending_dirs.len():
        val cur_dir = pending_dirs[dir_idx]
        dir_idx = dir_idx + 1
        var entries: [text] = []
        unsafe(capabilities: [ffi]):
            entries = rt_dir_list(cur_dir) ?? []
        for name in entries:
            if name == "" or name == "." or name == "..":
                continue
            if name.ends_with(".tmp"):
                continue
            if name.ends_with(".seal"):
                _cache_evict_maybe_reap_orphan_seal(cur_dir, name, suffix, now_secs)
                continue
            val path = _cache_evict_join(cur_dir, name)
            if name.ends_with(suffix):
                _cache_evict_account_file(plan, path, name, now_secs)
            else:
                var sub_present = false
                unsafe(capabilities: [ffi]):
                    sub_present = rt_dir_exists(path)
                if sub_present:
                    pending_dirs.push(path)

# Iterative subdirectory-walking LRU eviction for sharded caches such as
# `<cache_dir>/artifacts/v1/<algo>/<2hex>/*.spab`. Skips `*.tmp` in-flight
# writes and `.seal` sidecars during discovery, preserves `CACHE_EVICT_GRACE_SECS`,
# reaps stale `*.tmp` when using wall clock (`now_override_secs < 0`), and
# deletes each primary `.spab` victim before its `.spab.seal` sidecar.
@representation_boundary(kind: "ffi", reason: "Explicit unsafe ffi boundary in cache_dir_evict_tree_to_cap_v1", reviewers: ["ormastes", "opus-review"], capabilities: ["ffi"])
pub fn cache_dir_evict_tree_to_cap_v1(req: CacheTreeEvictRequestV1) -> CacheTreeEvictSummaryV1:
    if req.max_bytes <= 0 or req.root_dir == "" or req.suffix == "":
        return CacheTreeEvictSummaryV1(removed: 0, remaining_bytes: 0)
    var root_present = false
    unsafe(capabilities: [ffi]):
        root_present = rt_dir_exists(req.root_dir)
    if not root_present:
        return CacheTreeEvictSummaryV1(removed: 0, remaining_bytes: 0)
    var now_micros: i64 = 0
    unsafe(capabilities: [ffi]):
        now_micros = rt_time_now_unix_micros()
    val now_secs = if req.now_override_secs >= 0: req.now_override_secs else: now_micros / 1000000
    if req.now_override_secs < 0:
        val _reaped_tmp = cache_dir_reap_stale_tmp_v1(req.root_dir, now_secs)
    val plan = _CacheDirEvictPlan.empty()
    _cache_evict_walk_tree_into_plan(req.root_dir, req.suffix, now_secs, plan)
    _cache_evict_drain_plan(plan, req.max_bytes, false)
    CacheTreeEvictSummaryV1(removed: plan.removed_count(), remaining_bytes: plan.total_bytes())

# Combined LRU eviction across a front-end cache directory (`<dir>/*.fpc` AND
# `<dir>/artifacts/v1/**/*.spab` + `.spab.seal`) under a single shared byte cap.
# Reaps stale `*.tmp` files across the entire tree using real wall clock.
# reason: cache directory path, byte cap, and removed count match cache_dir_evict_to_cap
@representation_boundary(kind: "ffi", reason: "Explicit unsafe ffi boundary in cache_dir_evict_frontend_to_cap_v1", reviewers: ["ormastes", "opus-review"], capabilities: ["ffi"])
@allow(primitive_api)
pub fn cache_dir_evict_frontend_to_cap_v1(dir: text, max_bytes: i64) -> i64:
    var now_micros: i64 = 0
    unsafe(capabilities: [ffi]):
        now_micros = rt_time_now_unix_micros()
    val now_secs = now_micros / 1000000
    val _reaped_tmp = cache_dir_reap_stale_tmp_v1(dir, now_secs)
    _cache_dir_evict_frontend_to_cap_at(dir, max_bytes, now_secs)

@representation_boundary(kind: "ffi", reason: "Explicit unsafe ffi boundary in _cache_dir_evict_frontend_to_cap_at", reviewers: ["ormastes", "opus-review"], capabilities: ["ffi"])
@allow(primitive_api)
pub fn _cache_dir_evict_frontend_to_cap_at(dir: text, max_bytes: i64, now_secs: i64) -> i64:
    if max_bytes <= 0 or dir == "":
        return 0
    var dir_present = false
    val artifacts_v1 = _cache_evict_join(dir, "artifacts/v1")
    var spab_tree_present = false
    unsafe(capabilities: [ffi]):
        dir_present = rt_dir_exists(dir)
        spab_tree_present = rt_dir_exists(artifacts_v1)
    if not dir_present:
        return 0
    val plan = _CacheDirEvictPlan.empty()
    var entries: [text] = []
    unsafe(capabilities: [ffi]):
        entries = rt_dir_list(dir) ?? []
    val cleanup_u006 = not spab_tree_present
    for name in entries:
        if name == "" or name == "." or name == "..":
            continue
        if name.ends_with(".seal"):
            _cache_evict_maybe_reap_orphan_seal(dir, name, ".fpc", now_secs)
            continue
        if cleanup_u006 and name.ends_with(".u006"):
            _cache_evict_maybe_reap_orphan_u006(dir, name, now_secs)
            continue
        if name.ends_with(".tmp") or not name.ends_with(".fpc"):
            continue
        _cache_evict_account_file(plan, _cache_evict_join(dir, name), name, now_secs)
    if spab_tree_present:
        _cache_evict_walk_tree_into_plan(artifacts_v1, ".spab", now_secs, plan)
    _cache_evict_drain_plan(plan, max_bytes, cleanup_u006)
    plan.removed_count()

export CACHE_DEFAULT_MAX_BYTES, CACHE_EVICT_GRACE_SECS, CACHE_EVICT_SWEEP_INTERVAL, CACHE_EVICT_TMP_GRACE_SECS
export CacheTreeEvictRequestV1, CacheTreeEvictSummaryV1
export cache_dir_max_bytes, cache_dir_evict_due, cache_dir_evict_to_cap, cache_dir_evict_tree_to_cap_v1
export cache_dir_reap_stale_tmp_v1, cache_dir_evict_frontend_to_cap_v1
export _cache_dir_evict_to_cap_at, _cache_dir_evict_frontend_to_cap_at
