# Size-capped LRU eviction for the FLAT entry caches (`*.fpc` front-end parse
# entries, `*.hir` HIR entries). Each entry is one self-contained file whose
# name is a content hash, so eviction is a plain unlink: there is no index to
# keep consistent and no partially-deleted state a later run could mistake for
# a hit. That is the whole reason this is separate from the CAS store's GC
# (80.driver/cache/gc/) — that machinery exists for a multi-file store with
# leases and trash, and none of it is needed here.
#
# CRASH SAFETY / CONCURRENCY.
#   * `*.tmp` files are never touched: they are in-flight stores by other pids.
#   * Files modified within GRACE_SECS are never evicted, so an entry a live
#     build just wrote or just read past cannot be pulled out from under it.
#     A reader that loses the race sees a missing file, which every caller
#     already treats as a miss — the caches are designed so a miss is slow,
#     never wrong.
#   * LRU order is mtime. `rt_file_stat` is seconds-resolution and store is
#     write-then-rename, so ties are broken arbitrarily; that only affects
#     WHICH cold entry goes, never correctness.
#
# Selection uses a stable min-heap keyed by (mtime, discovery index): one O(n)
# directory scan, O(e) heap construction for e grace-eligible entries, then
# O(log e) per deletion attempt. If an entry dir ever exceeds ~100k files it
# needs an index file instead of a scan — at that point adopt
# 80.driver/cache/gc/ rather than growing this.

@unsafe(reason: "raw environment read; empty text conflates unset input with provider failure", capabilities: [ffi])
extern fn rt_env_get(key: text) -> text
@unsafe(reason: "raw directory listing; empty array conflates an empty directory with provider failure", capabilities: [ffi])
extern fn rt_dir_list(path: text) -> [text]
@unsafe(reason: "raw directory predicate; false conflates absence with provider failure", capabilities: [ffi])
extern fn rt_dir_exists(path: text) -> bool
@unsafe(reason: "raw file-size probe; non-positive sentinels conflate empty files with provider failure", capabilities: [ffi])
extern fn rt_file_size(path: text) -> i64
@unsafe(reason: "raw file timestamp probe; zero conflates the epoch with provider failure", capabilities: [ffi])
extern fn rt_file_stat(path: text) -> i64
@unsafe(reason: "raw cache-file deletion; false conflates absence with provider failure", capabilities: [ffi])
extern fn rt_file_delete(path: text) -> bool
@unsafe(reason: "raw wall-clock read; provider validity is not cryptographically admitted", capabilities: [ffi])
extern fn rt_time_now_unix_micros() -> i64

# 4 GiB. Big enough that a full bootstrap closure never evicts (a 688-module
# HIR cache measures well under 1 GiB), small enough that an unattended box
# cannot fill a disk with stale scopes.
val CACHE_DEFAULT_MAX_BYTES: i64 = 4294967296

# Entries touched this recently are assumed live and are never evicted.
val CACHE_EVICT_GRACE_SECS: i64 = 300

# Sweep every N stores rather than on every store, so the scan cost amortises.
val CACHE_EVICT_SWEEP_INTERVAL: i64 = 512

pub fn cache_dir_max_bytes() -> i64:
    var raw = ""
    unsafe(capabilities: [ffi]):
        raw = rt_env_get("SIMPLE_CACHE_MAX_BYTES") ?? ""
    if raw == "":
        return CACHE_DEFAULT_MAX_BYTES
    val parsed = raw.to_i64() ?? -1
    if parsed < 0:
        return CACHE_DEFAULT_MAX_BYTES
    parsed

pub fn cache_dir_evict_due(store_count: i64) -> bool:
    if store_count <= 0:
        return false
    store_count % CACHE_EVICT_SWEEP_INTERVAL == 0

# Internal eviction state, public only so the ordering/accounting contract can
# be covered without sleeping for the filesystem grace period. Candidate
# indexes are their discovery order, which makes equal-mtime eviction stable.
pub class _CacheDirEvictPlan:
    paths: [text]
    sizes: [i64]
    mtimes: [i64]
    heap: [i64]
    total: i64
    removed: i64

    static fn empty() -> _CacheDirEvictPlan:
        _CacheDirEvictPlan(
            paths: [], sizes: [], mtimes: [], heap: [], total: 0, removed: 0
        )

    fn _precedes(left: i64, right: i64) -> bool:
        if self.mtimes[left] != self.mtimes[right]:
            return self.mtimes[left] < self.mtimes[right]
        left < right

    me _heap_swap(left: i64, right: i64):
        val candidate = self.heap[left]
        self.heap[left] = self.heap[right]
        self.heap[right] = candidate

    me _sift_down(start: i64):
        var index = start
        while true:
            val left = index * 2 + 1
            if left >= self.heap.len():
                return
            val right = left + 1
            var first = left
            if (
                right < self.heap.len() and
                self._precedes(self.heap[right], self.heap[left])
            ):
                first = right
            if not self._precedes(self.heap[first], self.heap[index]):
                return
            self._heap_swap(index, first)
            index = first

    # Account all matching bytes, including grace-protected entries. Only
    # eligible entries enter the eviction heap.
    me account_entry(path: text, size: i64, mtime: i64, now_secs: i64):
        self.total = self.total + size
        if now_secs - mtime < CACHE_EVICT_GRACE_SECS:
            return
        val candidate = self.paths.len()
        self.paths.push(path)
        self.sizes.push(size)
        self.mtimes.push(mtime)
        self.heap.push(candidate)

    # Bottom-up construction is linear and is delayed until the cap is
    # exceeded, so the common under-cap path performs no heap comparisons.
    me prepare():
        if self.heap.len() < 2:
            return
        var start = (self.heap.len() - 2) / 2
        while true:
            self._sift_down(start)
            if start == 0:
                return
            start = start - 1

    fn total_bytes() -> i64:
        self.total

    fn removed_count() -> i64:
        self.removed

    fn candidate_count() -> i64:
        self.heap.len()

    fn over_cap(max_bytes: i64) -> bool:
        self.total > max_bytes

    fn has_candidate() -> bool:
        self.heap.len() > 0

    fn oldest_path() -> text:
        if self.heap.len() == 0:
            return ""
        self.paths[self.heap[0]]

    fn oldest_size() -> i64:
        if self.heap.len() == 0:
            return 0
        self.sizes[self.heap[0]]

    # A candidate is attempted at most once even when deletion fails, matching
    # the previous selection loop's path-emptying behavior.
    me pop_oldest():
        if self.heap.len() == 0:
            return
        val last = self.heap.len() - 1
        if last > 0:
            self.heap[0] = self.heap[last]
        val _ = self.heap.pop()
        if self.heap.len() > 0:
            self._sift_down(0)

    # Failed deletion preserves both byte accounting and the removed count.
    me record_delete(size: i64, deleted: bool):
        if not deleted:
            return
        self.total = self.total - size
        self.removed = self.removed + 1

# Evicts least-recently-modified entries with the given suffix until the
# directory's total entry bytes are at or below `max_bytes`. Returns the number
# of entries deleted. A `max_bytes` of 0 disables eviction entirely.
pub fn cache_dir_evict_to_cap(dir: text, suffix: text, max_bytes: i64) -> i64:
    if max_bytes <= 0 or dir == "":
        return 0
    var dir_present = false
    unsafe(capabilities: [ffi]):
        dir_present = rt_dir_exists(dir)
    if not dir_present:
        return 0
    var now_micros: i64 = 0
    unsafe(capabilities: [ffi]):
        now_micros = rt_time_now_unix_micros()
    val now_secs = now_micros / 1000000
    val plan = _CacheDirEvictPlan.empty()
    var entries: [text] = []
    unsafe(capabilities: [ffi]):
        entries = rt_dir_list(dir)
    for name in entries:
        if not name.ends_with(suffix):
            continue
        val path = dir + "/" + name
        var size: i64 = 0
        unsafe(capabilities: [ffi]):
            size = rt_file_size(path)
        if size <= 0:
            continue
        var mtime: i64 = 0
        unsafe(capabilities: [ffi]):
            mtime = rt_file_stat(path)
        plan.account_entry(path, size, mtime, now_secs)
    if not plan.over_cap(max_bytes):
        return 0
    plan.prepare()
    while plan.over_cap(max_bytes) and plan.has_candidate():
        val victim = plan.oldest_path()
        val victim_size = plan.oldest_size()
        plan.pop_oldest()
        var deleted = false
        unsafe(capabilities: [ffi]):
            deleted = rt_file_delete(victim)
        plan.record_delete(victim_size, deleted)
    plan.removed_count()

export CACHE_DEFAULT_MAX_BYTES, CACHE_EVICT_GRACE_SECS, CACHE_EVICT_SWEEP_INTERVAL
export cache_dir_max_bytes, cache_dir_evict_due, cache_dir_evict_to_cap
