# Parser-owned evidence for contextual `new` indexing.
# Unknown means unresolved, never proof that a module/import name is absent.
class ParserLexicalBindings:
    authority: i64                 # 0 = unknown outer, 1 = value, 2 = unknown shadow
    scope_authorities: [i64]

    me enter_scope():
        self.scope_authorities.push(self.authority)

    me leave_scope():
        if self.scope_authorities.len() == 0:
            self.authority = 0
            return
        self.authority = self.scope_authorities[self.scope_authorities.len() - 1]
        self.scope_authorities.pop()

    me bind_value(name: text):
        if name == "new":
            self.authority = 1

    me unknown_shadow():
        self.authority = 2

    # `me` borrows the owner; the query must not copy its scope stack.
    me has_new_value() -> bool:
        self.authority == 1
