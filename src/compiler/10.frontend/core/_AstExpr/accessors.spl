# Special-form constructors and field accessors for ast_expr nodes.
use compiler.frontend.core.ast_expr.*
# Core Simple — AST Expression Nodes
#
# Expression kind tags, arena pools, constructors, and accessors.
# Split from ast.spl for maintainability.
#
# See ast.spl for the full AST module documentation.

use std.string_core.{char_code}

# ===== Expression Kind Tags =====
fn expr_unit(span_id: i64) -> i64:
    expr_alloc(33, span_id)

fn expr_interpolated_string(parts: [i64], span_id: i64) -> i64:
    val idx = expr_alloc(EXPR_INTERPOLATED_STRING, span_id)
    expr_owner_args_set(idx, parts)
    idx

fn expr_promote_interpolated_string(idx: i64, value: text, parts: [i64]):
    expr_owner_tag_set(idx, EXPR_INTERPOLATED_STRING)
    expr_owner_str_set(idx, value)
    expr_owner_args_set(idx, parts)

fn expr_mark_string_processed(idx: i64, value: text):
    expr_owner_str_set(idx, value)
    expr_owner_int_set(idx, 2)

fn expr_pass(span_id: i64) -> i64:
    expr_alloc(35, span_id)

fn expr_pass_with_msg(msg: text, span_id: i64) -> i64:
    val idx = expr_alloc(35, span_id)
    expr_owner_str_set(idx, msg)
    idx

fn expr_pass_todo(msg: text, span_id: i64) -> i64:
    val idx = expr_alloc(40, span_id)
    expr_owner_str_set(idx, msg)
    idx

fn expr_pass_do_nothing(msg: text, span_id: i64) -> i64:
    val idx = expr_alloc(41, span_id)
    expr_owner_str_set(idx, msg)
    idx

fn expr_pass_dn(msg: text, span_id: i64) -> i64:
    val idx = expr_alloc(43, span_id)
    expr_owner_str_set(idx, msg)
    idx

fn expr_suffixed_int(value: i64, suffix: text, span_id: i64) -> i64:
    val idx = expr_alloc(EXPR_SUFFIXED_LIT, span_id)
    expr_owner_int_set(idx, value)
    expr_owner_str_set(idx, suffix)
    idx

fn expr_suffixed_float(value: text, suffix: text, span_id: i64) -> i64:
    val idx = expr_alloc(EXPR_SUFFIXED_LIT, span_id)
    expr_owner_float_set(idx, value)
    expr_owner_str_set(idx, suffix)
    idx

fn expr_suffixed_bool(value: i64, suffix: text, span_id: i64) -> i64:
    val idx = expr_alloc(EXPR_SUFFIXED_LIT, span_id)
    expr_owner_int_set(idx, value)
    expr_owner_extra_set(idx, 1)
    expr_owner_str_set(idx, suffix)
    idx

# ===== Expression Accessors =====

fn expr_get_tag(idx: i64) -> i64:
    # Bounds guard: a stale expr index (captured before an interleaved
    # ast_reset/expr_reset cleared the shared arena) can exceed the live arena
    # length — observed as "index is 48 but length is 13" killing the stage-4
    # build. Return -1 (no-tag sentinel, mirrors module_decl_at) so tag
    # dispatchers fall through to their safe default instead of crashing. See
    # doc/08_tracking/bug/flat_bridge_type_index_across_ast_reset_2026-07-12.md
    if idx < 0 or idx >= expr_owner_len():
        # L6: include the live arena generation so a stale index (minted before
        # an ast_reset) is diagnosable from ONE line instead of an OOB flood.
        print "[expr_get_tag] OOB idx={idx} arena_len={expr_owner_len()} arena_gen={ast_generation()} -> -1"
        return -1
    val fallback = expr_owner_tag(idx)
    if expr_trace_tags_enabled() and (idx < 8 or fallback <= 0):
        print "[expr_get_tag] idx={idx} arena={fallback}"
    fallback

# Sibling bounds guards for the rest of the expression accessor family.
#
# `expr_get_tag` above has been guarded since the stage-4 work; its siblings
# were not. Guarding only the dispatcher does not prevent the crash: a walker
# reads the tag (gets -1 plus a loud OOB line), takes its default branch, and
# then still reads `expr_get_span/int/.../stmts` with the SAME stale index,
# and that unguarded read is what kills the process.
#
# The statement half of this family is the measured reproducer — see the
# matching comment in `core/ast_stmt.spl` and
# doc/08_tracking/bug/lint_parse_failure_silently_skips_file_2026-08-01.md.
# The expression half is the identical shape, reached by the same walks over
# the same stale subtrees, and is closed here rather than left as the next
# sibling to be discovered by a crash: a sweep that does not enumerate the
# whole family just relocates the defect.
#
# Neutral returns match the established precedent in this arena family
# (`decl_get`, `expr_contains_yield`, `stmt_contains_yield`, `expr_get_tag`);
# -1 is already the "no expr" sentinel these fields carry. This is containment,
# not a root-cause fix — why a stale index reaches an accessor at all is still
# open in that bug file.
#
# The loud, always-on report stays on `expr_get_tag`; the per-accessor line is
# gated behind SIMPLE_TRACE_AST_OOB (default off) so a stale subtree cannot
# flood the output with one line per field read.
fn expr_oob_trace(accessor: text, idx: i64, arena_len: i64):
    val trace_ast_oob = rt_env_get("SIMPLE_TRACE_AST_OOB") ?? ""
    if trace_ast_oob != "":
        print "[{accessor}] OOB idx={idx} arena_len={arena_len} arena_gen={ast_generation()}"

fn expr_idx_is_live(idx: i64) -> bool:
    idx >= 0 and idx < expr_owner_len()

fn expr_get_span(idx: i64) -> i64:
    if not expr_idx_is_live(idx):
        expr_oob_trace("expr_get_span", idx, expr_owner_len())
        return -1
    expr_owner_span(idx)

fn expr_get_int(idx: i64) -> i64:
    if not expr_idx_is_live(idx):
        expr_oob_trace("expr_get_int", idx, expr_owner_len())
        return 0
    expr_owner_int(idx)

fn expr_get_float(idx: i64) -> text:
    if not expr_idx_is_live(idx):
        expr_oob_trace("expr_get_float", idx, expr_owner_len())
        return ""
    expr_owner_float(idx)

fn expr_get_str(idx: i64) -> text:
    if not expr_idx_is_live(idx):
        expr_oob_trace("expr_get_str", idx, expr_owner_len())
        return ""
    expr_owner_str(idx)

fn expr_get_left(idx: i64) -> i64:
    if not expr_idx_is_live(idx):
        expr_oob_trace("expr_get_left", idx, expr_owner_len())
        return -1
    expr_owner_left(idx)

fn expr_get_right(idx: i64) -> i64:
    if not expr_idx_is_live(idx):
        expr_oob_trace("expr_get_right", idx, expr_owner_len())
        return -1
    expr_owner_right(idx)

fn expr_get_extra(idx: i64) -> i64:
    if not expr_idx_is_live(idx):
        expr_oob_trace("expr_get_extra", idx, expr_owner_len())
        return -1
    expr_owner_extra(idx)

fn expr_get_args(idx: i64) -> [i64]:
    if not expr_idx_is_live(idx):
        expr_oob_trace("expr_get_args", idx, expr_owner_len())
        return []
    expr_owner_args(idx)

fn expr_get_arg_names(idx: i64) -> [text]:
    if not expr_idx_is_live(idx):
        expr_oob_trace("expr_get_arg_names", idx, expr_owner_len())
        return []
    expr_owner_arg_names(idx)

fn expr_get_stmts(idx: i64) -> [i64]:
    if not expr_idx_is_live(idx):
        expr_oob_trace("expr_get_stmts", idx, expr_owner_len())
        return []
    expr_owner_stmts(idx)

# ===== Expression Kind Names (for debugging) =====

fn expr_kind_name(tag: i64) -> text:
    if tag == EXPR_INT_LIT: return "IntLit"
    if tag == EXPR_FLOAT_LIT: return "FloatLit"
    if tag == EXPR_STRING_LIT: return "StringLit"
    if tag == EXPR_BOOL_LIT: return "BoolLit"
    if tag == EXPR_NIL_LIT: return "NilLit"
    if tag == EXPR_IDENT: return "Ident"
    if tag == EXPR_BINARY: return "Binary"
    if tag == EXPR_UNARY: return "Unary"
    if tag == EXPR_CALL: return "Call"
    if tag == EXPR_INDEX: return "Index"
    if tag == EXPR_FIELD_ACCESS: return "FieldAccess"
    if tag == EXPR_METHOD_CALL: return "MethodCall"
    if tag == EXPR_ARRAY_LIT: return "ArrayLit"
    if tag == EXPR_IF: return "If"
    if tag == EXPR_MATCH: return "Match"
    if tag == EXPR_FOR: return "For"
    if tag == EXPR_WHILE: return "While"
    if tag == EXPR_BLOCK: return "Block"
    if tag == EXPR_RETURN: return "Return"
    if tag == EXPR_BREAK: return "Break"
    if tag == EXPR_CONTINUE: return "Continue"
    if tag == EXPR_RANGE: return "Range"
    if tag == EXPR_ASSIGN: return "Assign"
    if tag == EXPR_COMPOUND_ASSIGN: return "CompoundAssign"
    if tag == EXPR_DICT_LIT: return "DictLit"
    if tag == EXPR_LAMBDA: return "Lambda"
    if tag == EXPR_STRUCT_LIT: return "StructLit"
    if tag == EXPR_TUPLE: return "Tuple"
    if tag == EXPR_SLICE: return "Slice"
    if tag == EXPR_NULL_COALESCE: return "NullCoalesce"
    if tag == EXPR_OPTIONAL_CHAIN: return "OptionalChain"
    if tag == EXPR_CAST: return "Cast"
    if tag == EXPR_UNIT: return "Unit"
    if tag == EXPR_INTERPOLATED_STRING: return "InterpolatedString"
    if tag == EXPR_PASS: return "Pass"
    if tag == EXPR_PASS_TODO: return "PassTodo"
    if tag == EXPR_PASS_DO_NOTHING: return "PassDoNothing"
    if tag == EXPR_PASS_DN: return "PassDn"
    if tag == EXPR_SUFFIXED_LIT: return "SuffixedLit"
    if tag == EXPR_DO_BLOCK: return "DoBlock"
    if tag == EXPR_UNSAFE_BLOCK: return "UnsafeBlock"
    if tag == EXPR_CUSTOM_BLOCK: return "CustomBlock"
    if tag == EXPR_ATOM: return "Atom"
    if tag == EXPR_SPREAD: return "Spread"
    if tag == EXPR_ASM: return "Asm"
    if tag == EXPR_ASM_MATCH: return "AsmMatch"
    if tag == EXPR_EXISTS_CHECK: return "ExistsCheck"
    if tag == EXPR_TRY: return "Try"
    if tag == EXPR_NEW: return "New"
    if tag == EXPR_LIST_COMP: return "ListComp"
    if tag == EXPR_DICT_COMP: return "DictComp"
    "Unknown({tag})"
