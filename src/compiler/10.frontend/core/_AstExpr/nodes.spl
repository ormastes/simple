# Expression kind tags, arena pools, and node constructors for ast_expr.
use compiler.frontend.core.ast_expr.*
# Core Simple — AST Expression Nodes
#
# Expression kind tags, arena pools, constructors, and accessors.
# Split from ast.spl for maintainability.
#
# See ast.spl for the full AST module documentation.

use std.string_core.{char_code}
use compiler.frontend.trace_policy.{frontend_trace_suppressed}
use std.nogc_sync_mut.io.process_ops.{eprint}
use compiler.core.types.{int_to_str}
use compiler.frontend.core.flat_pool_codec.*

# ===== Expression Kind Tags =====
const EXPR_INT_LIT = 1
const EXPR_FLOAT_LIT = 2
const EXPR_STRING_LIT = 3
const EXPR_BOOL_LIT = 4
const EXPR_NIL_LIT = 5
const EXPR_IDENT = 6
const EXPR_BINARY = 7
const EXPR_UNARY = 8
const EXPR_CALL = 9
const EXPR_INDEX = 10
const EXPR_FIELD_ACCESS = 11
const EXPR_METHOD_CALL = 12
const EXPR_ARRAY_LIT = 13
const EXPR_IF = 14
const EXPR_MATCH = 15
const EXPR_FOR = 16
const EXPR_WHILE = 17
const EXPR_BLOCK = 18
const EXPR_RETURN = 19
const EXPR_BREAK = 20
const EXPR_CONTINUE = 21
const EXPR_RANGE = 22
const EXPR_ASSIGN = 23
const EXPR_COMPOUND_ASSIGN = 24
const EXPR_DICT_LIT = 25
const EXPR_LAMBDA = 26
const EXPR_STRUCT_LIT = 27
const EXPR_TUPLE = 28
const EXPR_SLICE = 29
const EXPR_NULL_COALESCE = 30
const EXPR_OPTIONAL_CHAIN = 31
const EXPR_CAST = 32
const EXPR_UNIT = 33
const EXPR_INTERPOLATED_STRING = 34
const EXPR_PASS = 35
const EXPR_PASS_TODO = 40
const EXPR_PASS_DO_NOTHING = 41
const EXPR_PASS_DN = 43
const EXPR_SUFFIXED_LIT = 36
const EXPR_AWAIT = 37       # await future_expr
const EXPR_YIELD = 38       # yield value
const EXPR_SPAWN = 39       # spawn fn_call
const EXPR_DO_BLOCK = 44   # do: block expression (returns last value)
const EXPR_ATOM = 45       # `symbol atom literal (interned text, identity comparison)
const EXPR_SPREAD = 46     # ..expr spread in struct update syntax
const EXPR_ASM = 47        # asm text block/string (lowered by backend)
const EXPR_ASM_MATCH = 48  # asm match: multi-target dispatch
const EXPR_EXISTS_CHECK = 49  # .? existence check (returns T? — value if present, nil if absent)
const EXPR_FORCE_UNWRAP = 53  # expr! force-unwrap (panic on nil); distinct from EXPR_EXISTS_CHECK .?
const EXPR_TRY = 54           # expr? try/propagate: unwrap Ok/Some or early-return Err/None/nil
const EXPR_NEW = 50            # new allocation: new expr, new() expr, new(alloc) expr
const EXPR_LIST_COMP = 51      # [for x in items if cond: expr]
const EXPR_DICT_COMP = 52      # {for k in items if cond: (k_expr, v_expr)}
const EXPR_ARRAY_REPEAT = 55  # [value; count] array-repeat literal (count may be non-literal)
const EXPR_UNSAFE_BLOCK = 56  # unsafe: / danger: block expression
const EXPR_CUSTOM_BLOCK = 57  # kind{raw payload}, canonical CustomBlock bridge

# ===== Expression Arena Pools =====
# Each expression has:
#   - tag:    EXPR_* kind
#   - span:   span pool index
#   - i_val:  integer value (for int/bool literals, operator kind)
#   - f_val:  float value (stored as text to avoid precision issues)
#   - s_val:  string value (for string literals, identifiers, field names)
#   - left:   left child expression index (-1 = none)
#   - right:  right child expression index (-1 = none)
#   - extra:  extra expression index (else branch, etc.) (-1 = none)
#   - args:   argument list (indices into expr pool)
#   - stmts:  statement list (indices into stmt pool)

var expr_tag: [i64] = []
var expr_span: [i64] = []
var expr_i_val: [i64] = []
var expr_f_val: [text] = []
var expr_s_val: [text] = []
var expr_left: [i64] = []
var expr_right: [i64] = []
var expr_extra: [i64] = []
var expr_args: [[i64]] = []
var expr_arg_names: [[text]] = []
var expr_stmts: [[i64]] = []
var expr_asm_kinds: [[text]] = []
var expr_asm_locations: [[text]] = []
var expr_asm_clobbers: [[text]] = []
var expr_asm_outputs: [[i64]] = []
var expr_empty_i64: [i64] = []
var expr_empty_text: [text] = []
var expr_count_slot: [i64] = [0]
var expr_mode_slots_ready: bool = false
var expr_env_mirror_cached: bool = false
var expr_trace_tags_cached: bool = false

# ===== Arena Generation Diagnostics (lane L6, 2026-07-29) =====
# Monotonic generation counter shared by the expr/stmt/decl parallel-array
# arenas. ast_reset() bumps it BEFORE clearing so an index minted before the
# reset is detectably stale and reports ONE precise "stale generation" error
# instead of thousands of secondary OOB / missing-tag diagnostics.
# Diagnosis only — node ids stay plain i64, no representation change.
# See doc/03_plan/compiler/bootstrap/stage4_memory_parallel_agent_plan_2026-07-29.md
var ast_gen_slot: [i64] = [0]
var ast_gen_last_report_slot: [i64] = [-1]

extern fn rt_env_get(key: text) -> text
extern fn rt_env_set(key: text, value: text) -> bool
extern fn rt_env_remove(key: text) -> bool

# High-water mark of the largest expr index ever mirrored into the environment
# since the last expr_reset().  expr_count_set(0) inside expr_reset() would
# otherwise erase the only record of how far the mirror reaches, and a SMALLER
# file parsed after a bigger one would leave the big file's tail entries alive.
# See expr_env_mirror_clear below.
var expr_env_mirror_high_slot: [i64] = [0]

fn expr_parse_i64(raw: text) -> i64:
    if raw == "":
        return 0
    var value: i64 = 0
    var i: i64 = 0
    var neg: bool = false
    if raw.len() > 0 and raw[0:1] == "-":
        neg = true
        i = 1
    while i < raw.len():
        val ch = raw[i:i + 1]
        value = value * 10
        if ch == "1":
            value = value + 1
        elif ch == "2":
            value = value + 2
        elif ch == "3":
            value = value + 3
        elif ch == "4":
            value = value + 4
        elif ch == "5":
            value = value + 5
        elif ch == "6":
            value = value + 6
        elif ch == "7":
            value = value + 7
        elif ch == "8":
            value = value + 8
        elif ch == "9":
            value = value + 9
        elif ch == "0":
            pass_dn
        else:
            break
        i = i + 1
    if neg: return 0 - value
    value

fn expr_i64_list_join(values: [i64]) -> text:
    var parts: [text] = []
    for value in values:
        parts.push(int_to_str(value))
    parts.join(",")

fn expr_i64_list_split(raw: text) -> [i64]:
    if raw == "":
        return []
    var result: [i64] = []
    for part in raw.split(","):
        if part != "":
            result.push(expr_parse_i64(part))
    result

fn expr_env_mirror_enabled() -> bool:
    if expr_mode_slots_ready:
        return expr_env_mirror_cached
    # Interpreter module variables may not persist between calls. Preserve its
    # compatibility mirror while compiled Stage4 uses the cached fast path.
    (rt_env_get("SIMPLE_BOOTSTRAP") ?? "") == "1" and (rt_env_get("SIMPLE_NATIVE_ARENA_DECLS") ?? "") != "1"

fn expr_trace_tags_enabled() -> bool:
    if expr_mode_slots_ready:
        if not expr_trace_tags_cached:
            return false
        return not frontend_trace_suppressed()
    ((rt_env_get("SIMPLE_TRACE_EXPR_TAGS") ?? "") != "" and
     not frontend_trace_suppressed())

fn expr_env_read(idx: i64, field: text) -> text:
    if not expr_env_mirror_enabled():
        return ""
    rt_env_get(expr_key(idx, field)) ?? ""

fn expr_mode_slots_refresh():
    val native_arena = (rt_env_get("SIMPLE_NATIVE_ARENA_DECLS") ?? "") == "1"
    expr_env_mirror_cached = (rt_env_get("SIMPLE_BOOTSTRAP") ?? "") == "1" and not native_arena
    expr_trace_tags_cached = (rt_env_get("SIMPLE_TRACE_EXPR_TAGS") ?? "") != ""
    expr_mode_slots_ready = true

fn expr_count_slot_ensure():
    if expr_count_slot == nil or expr_count_slot.len() == 0:
        expr_count_slot = [0]

fn expr_count_env() -> i64:
    expr_count_slot_ensure()
    if not expr_env_mirror_enabled():
        return expr_count_slot[0]
    val env_count = expr_parse_i64(rt_env_get("SIMPLE_BOOTSTRAP_EXPR_COUNT") ?? "")
    if env_count > 0:
        return env_count
    expr_count_slot[0]

fn expr_env_mirror_high_ensure():
    if expr_env_mirror_high_slot == nil or expr_env_mirror_high_slot.len() == 0:
        expr_env_mirror_high_slot = [0]

fn expr_count_set(value: i64):
    expr_count_slot_ensure()
    expr_count_slot[0] = value
    if expr_env_mirror_enabled():
        expr_env_mirror_high_ensure()
        if value > expr_env_mirror_high_slot[0]:
            expr_env_mirror_high_slot[0] = value
        rt_env_set("SIMPLE_BOOTSTRAP_EXPR_COUNT", int_to_str(value))

# Fields mirrored per expr index. Keep in sync with the expr_*_set writers
# below; a field missing here leaks its entry and can be read back stale.
#
# Built per call rather than held in a module-level `val`: module-level globals
# are zero/nil-initialized in native builds and are order-dependent at module
# init, so a global list here could read back nil and silently clear NOTHING --
# a fix that is present but inert.
fn expr_mirror_fields() -> [text]:
    ["TAG", "SPAN", "I", "F", "S", "LEFT", "RIGHT", "EXTRA", "ARGS", "ARG_NAMES", "STMTS"]

fn expr_env_mirror_clear():
    """Unset every per-index expr env-mirror entry minted since the last reset.

    Reset-under-live-state defect (family member: "expr_reset never unsets the
    env mirror"). expr_reset() clears the backing arrays but the mirror is read
    ENV-FIRST (expr_env_read), so an entry written while parsing file A is
    returned for an index file B never allocated: the verdict then depends on
    the order the files were parsed. It also BYPASSES the arena generation guard
    -- ast_gen_check_index only sees indices that carry a minted generation, and
    an env read carries none -- so the guard matches and binds while the stale
    value flows through unchecked. Finally the entries never die, so environ
    grows by ~11 entries per expr node for the whole run (the 8.9 GB RSS at
    4,363 files).

    Cost is the same O(nodes x fields) order the writes already pay, and because
    environ now stays bounded by ONE file instead of the cumulative run, each
    libc setenv/getenv linear scan gets cheaper rather than more expensive.
    """
    if not expr_env_mirror_enabled():
        return
    expr_env_mirror_high_ensure()
    val upto = expr_env_mirror_high_slot[0]
    if upto <= 0:
        return
    val fields = expr_mirror_fields()
    var i: i64 = 0
    while i < upto:
        for field in fields:
            rt_env_remove(expr_key(i, field))
        i = i + 1
    expr_env_mirror_high_slot[0] = 0

fn expr_key(idx: i64, field: text) -> text:
    "SIMPLE_BOOTSTRAP_EXPR_" + int_to_str(idx) + "_" + field

# Perf: gate the per-index SIMPLE_BOOTSTRAP_EXPR_<idx>_<field> env mirror behind
# bootstrap mode — it accumulates ~10 environ entries per expr node and libc
# setenv/getenv linear-scan environ => O(N^2). The expr_* module-var arrays
# (written unconditionally by expr_alloc + constructors) are the real store in
# compiled stage4; expr_get_* readers are env-first/array-fallback, so skipping
# the env write makes them fall back to the (correct) arrays. See bug
# ast_env_var_quadratic_parse_2026-06-13.
fn expr_i64_set(idx: i64, field: text, value: i64):
    if expr_env_mirror_enabled():
        rt_env_set(expr_key(idx, field), int_to_str(value))

fn expr_i64_get(idx: i64, field: text) -> i64:
    expr_parse_i64(expr_env_read(idx, field))

# True if `value` holds no embedded NUL byte. rt_env_set (Rust env::set_var)
# panics on an interior NUL (CString::new failure); this is the load-bearing
# store, so a poisoned value must SKIP the env write rather than abort — the
# expr_* module-var arrays are the real store (see bug
# ast_env_var_quadratic_parse_2026-06-13 comment above), so skipping is
# semantics-preserving. Char-by-char via char_code(), not `.contains()`: a
# NUL-bearing haystack breaks `.contains()` (C-string truncation) — proven by
# rt_env_set panics on "\033" files (see lexer_struct.spl scan_string).
fn env_value_nul_free(value: text) -> bool:
    var i: i64 = 0
    val n: i64 = value.len()
    while i < n:
        if char_code(value[i:i + 1]) == 0:
            return false
        i = i + 1
    true

fn expr_text_set(idx: i64, field: text, value: text):
    if expr_env_mirror_enabled() and env_value_nul_free(value):
        rt_env_set(expr_key(idx, field), value)

fn expr_text_get(idx: i64, field: text) -> text:
    expr_env_read(idx, field)

fn expr_list_set(idx: i64, field: text, values: [i64]):
    if expr_env_mirror_enabled():
        rt_env_set(expr_key(idx, field), expr_i64_list_join(values))

fn expr_list_get(idx: i64, field: text) -> [i64]:
    expr_i64_list_split(expr_env_read(idx, field))

fn expr_text_list_set(idx: i64, field: text, values: [text]):
    if expr_env_mirror_enabled():
        val joined: text = values.join("\n")
        if env_value_nul_free(joined):
            rt_env_set(expr_key(idx, field), joined)

fn expr_call_args_set(idx: i64, call_args: [i64], arg_names: [text]):
    expr_args[idx] = call_args
    expr_arg_names[idx] = arg_names
    expr_list_set(idx, "ARGS", call_args)
    expr_text_list_set(idx, "ARG_NAMES", arg_names)

fn expr_count() -> i64:
    val env_count = expr_count_env()
    if env_count > 0:
        return env_count
    expr_tag.len()

# Keep all arena access in this owner module. Re-export consumers otherwise
# receive private copies of the module arrays in self-hosted native builds.
fn expr_owner_len() -> i64: expr_tag.len()
fn expr_owner_tag(idx: i64) -> i64: expr_tag[idx]
fn expr_owner_span(idx: i64) -> i64: expr_span[idx]
fn expr_owner_span_set(idx: i64, value: i64):
    expr_span[idx] = value
    expr_i64_set(idx, "SPAN", value)
fn expr_owner_int(idx: i64) -> i64: expr_i_val[idx]
fn expr_owner_float(idx: i64) -> text: expr_f_val[idx]
fn expr_owner_str(idx: i64) -> text: expr_s_val[idx]
fn expr_owner_left(idx: i64) -> i64: expr_left[idx]
fn expr_owner_right(idx: i64) -> i64: expr_right[idx]
fn expr_owner_extra(idx: i64) -> i64: expr_extra[idx]
fn expr_owner_args(idx: i64) -> [i64]: expr_args[idx]
fn expr_owner_arg_names(idx: i64) -> [text]: expr_arg_names[idx]
fn expr_owner_asm_kinds(idx: i64) -> [text]: expr_asm_kinds[idx]
fn expr_owner_asm_clobbers(idx: i64) -> [text]: expr_asm_clobbers[idx]
fn expr_owner_asm_outputs(idx: i64) -> [i64]: expr_asm_outputs[idx]
fn expr_owner_asm_locations(idx: i64) -> [text]: expr_asm_locations[idx]
fn expr_owner_stmts(idx: i64) -> [i64]: expr_stmts[idx]
fn expr_owner_tag_set(idx: i64, value: i64):
    expr_tag[idx] = value
fn expr_owner_args_set(idx: i64, value: [i64]):
    expr_args[idx] = value
fn expr_owner_int_set(idx: i64, value: i64):
    expr_i_val[idx] = value
fn expr_owner_float_set(idx: i64, value: text):
    expr_f_val[idx] = value
fn expr_owner_str_set(idx: i64, value: text):
    expr_s_val[idx] = value
fn expr_owner_extra_set(idx: i64, value: i64):
    expr_extra[idx] = value

# ----- Arena generation diagnostics helpers (lane L6) -----

fn ast_gen_slot_ensure():
    # Native binaries may zero-initialize module arrays (same limitation the
    # other *_slot ensure helpers guard against).
    if ast_gen_slot == nil or ast_gen_slot.len() == 0:
        ast_gen_slot = [0]
    if ast_gen_last_report_slot == nil or ast_gen_last_report_slot.len() == 0:
        ast_gen_last_report_slot = [-1]

fn ast_generation() -> i64:
    ast_gen_slot_ensure()
    ast_gen_slot[0]

fn ast_generation_bump() -> i64:
    ast_gen_slot_ensure()
    ast_gen_slot[0] = ast_gen_slot[0] + 1
    ast_gen_slot[0]

fn ast_gen_check_enabled() -> bool:
    # Default OFF => zero hot-path cost. Enable via the dedicated knob or the
    # stage-4 bootstrap lane.
    if (rt_env_get("SIMPLE_AST_GEN_CHECK") ?? "") == "1":
        return true
    (rt_env_get("SIMPLE_BOOTSTRAP_STAGE4") ?? "") == "1"

fn ast_gen_stale_message(kind: text, idx: i64, minted_gen: i64) -> text:
    "stale " + kind + " " + int_to_str(idx) + ": produced at generation " + int_to_str(minted_gen) + ", arena now at " + int_to_str(ast_generation())

fn ast_gen_check_index(kind: text, idx: i64, minted_gen: i64) -> bool:
    # Debug-gated stale-index check. Returns true when `idx` was minted at an
    # older generation than the live arena; reports at most ONCE per current
    # generation so one stale read does not cascade into a diagnostic flood.
    # Callers keep their existing fallback behavior (-1 sentinel etc.).
    if not ast_gen_check_enabled():
        return false
    ast_gen_slot_ensure()
    if minted_gen == ast_gen_slot[0]:
        return false
    if ast_gen_last_report_slot[0] != ast_gen_slot[0]:
        ast_gen_last_report_slot[0] = ast_gen_slot[0]
        val message = ast_gen_stale_message(kind, idx, minted_gen)
        if frontend_trace_suppressed():
            eprint(message)
        else:
            print message
    true

fn expr_reset():
    # Allocate nil module arrays once, then retain their storage across files.
    expr_mode_slots_refresh()
    # Drop the per-index env mirror BEFORE the arrays are cleared: it is read
    # env-first, so anything left here outlives the arena it describes and is
    # served to the next file as if it were that file's own node.
    expr_env_mirror_clear()
    if expr_tag == nil:
        expr_tag = []
    if expr_span == nil:
        expr_span = []
    if expr_i_val == nil:
        expr_i_val = []
    if expr_f_val == nil:
        expr_f_val = []
    if expr_s_val == nil:
        expr_s_val = []
    if expr_left == nil:
        expr_left = []
    if expr_right == nil:
        expr_right = []
    if expr_extra == nil:
        expr_extra = []
    if expr_args == nil:
        expr_args = []
    if expr_arg_names == nil:
        expr_arg_names = []
    if expr_stmts == nil:
        expr_stmts = []
    if expr_asm_kinds == nil:
        expr_asm_kinds = []
    if expr_asm_clobbers == nil:
        expr_asm_clobbers = []
    if expr_asm_outputs == nil:
        expr_asm_outputs = []
    if expr_asm_locations == nil:
        expr_asm_locations = []
    if expr_empty_i64 == nil:
        expr_empty_i64 = []
    if expr_empty_text == nil:
        expr_empty_text = []
    if asm_arm_archs == nil:
        asm_arm_archs = []
    if asm_arm_os == nil:
        asm_arm_os = []
    if asm_arm_abi == nil:
        asm_arm_abi = []
    if asm_arm_backend == nil:
        asm_arm_backend = []
    if asm_arm_ver_ops == nil:
        asm_arm_ver_ops = []
    if asm_arm_ver_vals == nil:
        asm_arm_ver_vals = []
    if asm_arm_asm_text == nil:
        asm_arm_asm_text = []
    if asm_arm_is_compile_error == nil:
        asm_arm_is_compile_error = []
    if asm_arm_error_msg == nil:
        asm_arm_error_msg = []
    if asm_arm_is_wildcard == nil:
        asm_arm_is_wildcard = []
    expr_tag.clear()
    expr_span.clear()
    expr_i_val.clear()
    expr_f_val.clear()
    expr_s_val.clear()
    expr_left.clear()
    expr_right.clear()
    expr_extra.clear()
    expr_args.clear()
    expr_arg_names.clear()
    expr_stmts.clear()
    expr_asm_kinds.clear()
    expr_asm_clobbers.clear()
    expr_asm_outputs.clear()
    expr_asm_locations.clear()
    asm_arm_archs.clear()
    asm_arm_os.clear()
    asm_arm_abi.clear()
    asm_arm_backend.clear()
    asm_arm_ver_ops.clear()
    asm_arm_ver_vals.clear()
    asm_arm_asm_text.clear()
    asm_arm_is_compile_error.clear()
    asm_arm_error_msg.clear()
    asm_arm_is_wildcard.clear()
    expr_count_set(0)

# Allocate a new expression node, returns its index
fn expr_alloc(tag: i64, span_id: i64) -> i64:
    val idx = expr_count_env()
    expr_count_set(idx + 1)
    expr_tag.push(tag)
    expr_span.push(span_id)
    expr_i_val.push(0)
    expr_f_val.push("")
    expr_s_val.push("")
    expr_left.push(-1)
    expr_right.push(-1)
    expr_extra.push(-1)
    expr_args.push(expr_empty_i64)
    expr_arg_names.push(expr_empty_text)
    expr_stmts.push(expr_empty_i64)
    expr_asm_kinds.push(expr_empty_text)
    expr_asm_clobbers.push(expr_empty_text)
    expr_asm_outputs.push(expr_empty_i64)
    expr_asm_locations.push(expr_empty_text)
    expr_i64_set(idx, "TAG", tag)
    expr_i64_set(idx, "SPAN", span_id)
    expr_i64_set(idx, "I", 0)
    expr_text_set(idx, "F", "")
    expr_text_set(idx, "S", "")
    expr_i64_set(idx, "LEFT", -1)
    expr_i64_set(idx, "RIGHT", -1)
    expr_i64_set(idx, "EXTRA", -1)
    expr_list_set(idx, "ARGS", [])
    expr_text_list_set(idx, "ARG_NAMES", [])
    expr_list_set(idx, "STMTS", [])
    if expr_trace_tags_enabled() and (idx < 8 or tag <= 0):
        print "[expr_alloc] idx={idx} tag={tag} span={span_id}"
    idx

# ===== Expression Constructors =====

fn expr_int_lit(value: i64, span_id: i64) -> i64:
    val idx = expr_alloc(1, span_id)
    expr_i_val[idx] = value
    expr_i64_set(idx, "I", value)
    idx

fn expr_float_lit(value: text, span_id: i64) -> i64:
    val idx = expr_alloc(2, span_id)
    expr_f_val[idx] = value
    expr_text_set(idx, "F", value)
    idx

fn expr_string_lit(value: text, span_id: i64) -> i64:
    val idx = expr_alloc(3, span_id)
    expr_s_val[idx] = value
    expr_text_set(idx, "S", value)
    idx

fn expr_raw_string_lit(value: text, span_id: i64) -> i64:
    # EXPR_STRING_LIT reserves I=1 for source forms that never interpolate.
    val idx = expr_string_lit(value, span_id)
    expr_i_val[idx] = 1
    expr_i64_set(idx, "I", 1)
    idx

fn expr_bool_lit(value: i64, span_id: i64) -> i64:
    val idx = expr_alloc(4, span_id)
    expr_i_val[idx] = value
    expr_i64_set(idx, "I", value)
    idx

fn expr_nil_lit(span_id: i64) -> i64:
    expr_alloc(5, span_id)

fn expr_ident(name: text, span_id: i64) -> i64:
    val idx = expr_alloc(6, span_id)
    expr_s_val[idx] = name
    expr_text_set(idx, "S", name)
    expr_i_val[idx] = -1
    expr_i64_set(idx, "I", -1)
    idx

fn expr_binary(op: i64, left_idx: i64, right_idx: i64, span_id: i64) -> i64:
    val idx = expr_alloc(7, span_id)
    expr_i_val[idx] = op
    expr_i64_set(idx, "I", op)
    expr_left[idx] = left_idx
    expr_i64_set(idx, "LEFT", left_idx)
    expr_right[idx] = right_idx
    expr_i64_set(idx, "RIGHT", right_idx)
    idx

fn expr_unary(op: i64, operand: i64, span_id: i64) -> i64:
    val idx = expr_alloc(EXPR_UNARY, span_id)
    expr_i_val[idx] = op
    expr_i64_set(idx, "I", op)
    expr_left[idx] = operand
    expr_i64_set(idx, "LEFT", operand)
    idx

fn expr_call(callee: i64, call_args: [i64], span_id: i64) -> i64:
    expr_call_named(callee, call_args, [], span_id)

fn expr_call_named(callee: i64, call_args: [i64], arg_names: [text], span_id: i64) -> i64:
    # One policy/env decision per call allocation. The former six identical
    # environment probes sat directly on a common expression hot path.
    val trace_calls = ((rt_env_get("SIMPLE_TRACE_AST_EXPR_CALLS") ?? "") == "1" and
        not frontend_trace_suppressed())
    if trace_calls:
        eprint("[ast-expr] call-alloc:start callee={callee} argc={call_args.len()}")
    val idx = expr_alloc(9, span_id)
    if trace_calls:
        eprint("[ast-expr] call-alloc:allocated idx={idx}")
    expr_left[idx] = callee
    expr_i64_set(idx, "LEFT", callee)
    if trace_calls:
        eprint("[ast-expr] call-alloc:left idx={idx}")
    expr_call_args_set(idx, call_args, arg_names)
    if trace_calls:
        eprint("[ast-expr] call-alloc:args-memory idx={idx}")
    if trace_calls:
        eprint("[ast-expr] call-alloc:args-env idx={idx}")
    if trace_calls:
        eprint("[ast-expr] call-alloc:done idx={idx}")
    idx

fn expr_index(base: i64, index_expr: i64, span_id: i64) -> i64:
    val idx = expr_alloc(EXPR_INDEX, span_id)
    expr_left[idx] = base
    expr_i64_set(idx, "LEFT", base)
    expr_right[idx] = index_expr
    expr_i64_set(idx, "RIGHT", index_expr)
    idx

fn expr_field_access(base: i64, field_name: text, span_id: i64) -> i64:
    val idx = expr_alloc(EXPR_FIELD_ACCESS, span_id)
    expr_left[idx] = base
    expr_i64_set(idx, "LEFT", base)
    expr_s_val[idx] = field_name
    expr_text_set(idx, "S", field_name)
    expr_i_val[idx] = -1
    expr_i64_set(idx, "I", -1)
    idx

fn expr_method_call(receiver: i64, method_name: text, call_args: [i64], span_id: i64) -> i64:
    expr_method_call_named(receiver, method_name, call_args, [], span_id)

fn expr_method_call_named(receiver: i64, method_name: text, call_args: [i64], arg_names: [text], span_id: i64) -> i64:
    val idx = expr_alloc(12, span_id)
    expr_left[idx] = receiver
    expr_i64_set(idx, "LEFT", receiver)
    expr_s_val[idx] = method_name
    expr_text_set(idx, "S", method_name)
    expr_call_args_set(idx, call_args, arg_names)
    idx

fn expr_array_lit(elements: [i64], span_id: i64) -> i64:
    val idx = expr_alloc(13, span_id)
    expr_args[idx] = elements
    expr_list_set(idx, "ARGS", elements)
    idx

fn expr_array_repeat(value_expr: i64, count_expr: i64, span_id: i64) -> i64:
    val idx = expr_alloc(EXPR_ARRAY_REPEAT, span_id)
    expr_left[idx] = value_expr
    expr_i64_set(idx, "LEFT", value_expr)
    expr_right[idx] = count_expr
    expr_i64_set(idx, "RIGHT", count_expr)
    idx

fn expr_if_expr(cond: i64, then_branch: i64, else_branch: i64, span_id: i64) -> i64:
    val idx = expr_alloc(EXPR_IF, span_id)
    expr_left[idx] = cond
    expr_i64_set(idx, "LEFT", cond)
    expr_right[idx] = then_branch
    expr_i64_set(idx, "RIGHT", then_branch)
    expr_extra[idx] = else_branch
    expr_i64_set(idx, "EXTRA", else_branch)
    idx

fn expr_match_expr(scrutinee: i64, arms: [i64], span_id: i64) -> i64:
    val idx = expr_alloc(EXPR_MATCH, span_id)
    expr_left[idx] = scrutinee
    expr_i64_set(idx, "LEFT", scrutinee)
    expr_args[idx] = arms
    expr_list_set(idx, "ARGS", arms)
    idx

fn expr_for_expr(iter_var: text, iterable: i64, body_stmts: [i64], span_id: i64) -> i64:
    val idx = expr_alloc(EXPR_FOR, span_id)
    expr_s_val[idx] = iter_var
    expr_text_set(idx, "S", iter_var)
    expr_left[idx] = iterable
    expr_i64_set(idx, "LEFT", iterable)
    expr_stmts[idx] = body_stmts
    expr_list_set(idx, "STMTS", body_stmts)
    idx

fn expr_while_expr(cond: i64, body_stmts: [i64], span_id: i64) -> i64:
    val idx = expr_alloc(EXPR_WHILE, span_id)
    expr_left[idx] = cond
    expr_i64_set(idx, "LEFT", cond)
    expr_stmts[idx] = body_stmts
    expr_list_set(idx, "STMTS", body_stmts)
    idx

fn expr_block(body_stmts: [i64], value_expr: i64, span_id: i64) -> i64:
    val idx = expr_alloc(EXPR_BLOCK, span_id)
    expr_stmts[idx] = body_stmts
    expr_list_set(idx, "STMTS", body_stmts)
    expr_left[idx] = value_expr
    expr_i64_set(idx, "LEFT", value_expr)
    idx

fn expr_return_expr(value: i64, span_id: i64) -> i64:
    val idx = expr_alloc(19, span_id)
    expr_left[idx] = value
    expr_i64_set(idx, "LEFT", value)
    idx

fn expr_break_expr(span_id: i64) -> i64:
    expr_alloc(EXPR_BREAK, span_id)

fn expr_continue_expr(span_id: i64) -> i64:
    expr_alloc(EXPR_CONTINUE, span_id)

fn expr_await(future_expr: i64, span_id: i64) -> i64:
    val idx = expr_alloc(EXPR_AWAIT, span_id)
    expr_left[idx] = future_expr
    expr_i64_set(idx, "LEFT", future_expr)
    idx

fn expr_yield(value_expr: i64, span_id: i64) -> i64:
    val idx = expr_alloc(EXPR_YIELD, span_id)
    expr_left[idx] = value_expr
    expr_i64_set(idx, "LEFT", value_expr)
    idx

fn expr_spawn(call_expr: i64, span_id: i64) -> i64:
    val idx = expr_alloc(EXPR_SPAWN, span_id)
    expr_left[idx] = call_expr
    expr_i64_set(idx, "LEFT", call_expr)
    idx

fn expr_do_block(body_stmts: [i64], span_id: i64) -> i64:
    val idx = expr_alloc(EXPR_DO_BLOCK, span_id)
    expr_stmts[idx] = body_stmts
    expr_list_set(idx, "STMTS", body_stmts)
    idx

fn expr_unsafe_block(body_stmts: [i64], span_id: i64) -> i64:
    expr_unsafe_block_with_caps(body_stmts, [], span_id)

fn expr_unsafe_block_with_caps(body_stmts: [i64], caps: [text], span_id: i64) -> i64:
    # `unsafe(reason: "...", capabilities: [a, b]):` — the capability names
    # ride in the S slot as a comma-joined list (empty for a bare `unsafe:`).
    val idx = expr_alloc(EXPR_UNSAFE_BLOCK, span_id)
    expr_stmts[idx] = body_stmts
    expr_list_set(idx, "STMTS", body_stmts)
    expr_s_val[idx] = caps.join(",")
    expr_text_set(idx, "S", caps.join(","))
    idx

fn expr_custom_block(kind: text, payload: text, span_id: i64) -> i64:
    # Keep the flat node bootstrap-safe while preserving the canonical rich
    # AST meaning. The kind occupies S and the raw payload is a string child;
    # FlatAstBridge maps this one-for-one to ExprKind.CustomBlock.
    val payload_expr = expr_raw_string_lit(payload, span_id)
    val idx = expr_alloc(EXPR_CUSTOM_BLOCK, span_id)
    expr_s_val[idx] = kind
    expr_text_set(idx, "S", kind)
    expr_left[idx] = payload_expr
    expr_i64_set(idx, "LEFT", payload_expr)
    idx

fn expr_atom(name: text, span_id: i64) -> i64:
    val idx = expr_alloc(EXPR_ATOM, span_id)
    expr_s_val[idx] = name
    expr_text_set(idx, "S", name)
    idx

fn expr_spread(inner: i64, span_id: i64) -> i64:
    val idx = expr_alloc(EXPR_SPREAD, span_id)
    expr_left[idx] = inner
    expr_i64_set(idx, "LEFT", inner)
    idx

fn expr_asm(text_value: text, span_id: i64) -> i64:
    val idx = expr_alloc(EXPR_ASM, span_id)
    expr_s_val[idx] = text_value
    expr_text_set(idx, "S", text_value)
    idx

fn expr_asm_operands(text_value: text, values: [i64], names: [text],
                     kinds: [text], locations: [text], outputs: [i64], clobbers: [text], span_id: i64) -> i64:
    """Create inline assembly while retaining its typed operand directives."""
    val idx = expr_asm(text_value, span_id)
    expr_args[idx] = values
    expr_arg_names[idx] = names
    expr_asm_kinds[idx] = kinds
    expr_asm_locations[idx] = locations
    expr_asm_clobbers[idx] = clobbers
    expr_asm_outputs[idx] = outputs
    expr_list_set(idx, "ARGS", values)
    expr_text_list_set(idx, "ARG_NAMES", names)
    idx

# ===== Asm Match Arm Arena =====
# Parallel arrays for target-qualified asm match arms
var asm_arm_archs: [[text]] = []       # arch list per arm (pipe groups)
var asm_arm_os: [text] = []            # os per arm ("" = wildcard)
var asm_arm_abi: [text] = []           # abi per arm ("" = wildcard)
var asm_arm_backend: [text] = []       # backend per arm ("" = wildcard)
var asm_arm_ver_ops: [[text]] = []     # version constraint ops per arm
var asm_arm_ver_vals: [[i64]] = []     # version constraint values per arm
var asm_arm_asm_text: [text] = []      # asm body text per arm
var asm_arm_is_compile_error: [bool] = []  # is compile_error arm
var asm_arm_error_msg: [text] = []     # error message for compile_error arms
var asm_arm_is_wildcard: [bool] = []   # is wildcard (_) arm

fn asm_arm_new(archs: [text], os: text, abi: text, backend: text,
               ver_ops: [text], ver_vals: [i64], asm_text: text,
               is_compile_error: bool, error_msg: text, is_wildcard: bool) -> i64:
    """Allocate a new asm match arm, returns its index."""
    val idx = asm_arm_archs.len()
    asm_arm_archs.push(archs)
    asm_arm_os.push(os)
    asm_arm_abi.push(abi)
    asm_arm_backend.push(backend)
    asm_arm_ver_ops.push(ver_ops)
    asm_arm_ver_vals.push(ver_vals)
    asm_arm_asm_text.push(asm_text)
    asm_arm_is_compile_error.push(is_compile_error)
    asm_arm_error_msg.push(error_msg)
    asm_arm_is_wildcard.push(is_wildcard)
    idx

fn expr_asm_match(arm_indices: [i64], span_id: i64) -> i64:
    """Create asm match expression. arm_indices are indices into asm_arm_* arrays."""
    val idx = expr_alloc(EXPR_ASM_MATCH, span_id)
    expr_args[idx] = arm_indices
    expr_list_set(idx, "ARGS", arm_indices)
    idx

fn expr_asm_assert(arm_idx: i64, span_id: i64) -> i64:
    """Create asm assert expression. arm_idx is index into asm_arm_* arrays.
    Distinguished from asm match by i_val = 1.
    """
    val idx = expr_alloc(EXPR_ASM_MATCH, span_id)
    expr_args[idx] = [arm_idx]
    expr_list_set(idx, "ARGS", [arm_idx])
    expr_i_val[idx] = 1
    expr_i64_set(idx, "I", 1)
    idx

fn expr_range(start_expr: i64, end_expr: i64, inclusive: i64, span_id: i64) -> i64:
    val idx = expr_alloc(EXPR_RANGE, span_id)
    expr_left[idx] = start_expr
    expr_i64_set(idx, "LEFT", start_expr)
    expr_right[idx] = end_expr
    expr_i64_set(idx, "RIGHT", end_expr)
    expr_i_val[idx] = inclusive
    expr_i64_set(idx, "I", inclusive)
    idx

fn expr_assign(target: i64, value: i64, span_id: i64) -> i64:
    val idx = expr_alloc(EXPR_ASSIGN, span_id)
    expr_left[idx] = target
    expr_i64_set(idx, "LEFT", target)
    expr_right[idx] = value
    expr_i64_set(idx, "RIGHT", value)
    idx

fn expr_compound_assign(op: i64, target: i64, value: i64, span_id: i64) -> i64:
    val idx = expr_alloc(EXPR_COMPOUND_ASSIGN, span_id)
    expr_i_val[idx] = op
    expr_i64_set(idx, "I", op)
    expr_left[idx] = target
    expr_i64_set(idx, "LEFT", target)
    expr_right[idx] = value
    expr_i64_set(idx, "RIGHT", value)
    idx

fn expr_dict_lit(key_exprs: [i64], value_exprs: [i64], span_id: i64) -> i64:
    val idx = expr_alloc(25, span_id)
    expr_args[idx] = key_exprs
    expr_list_set(idx, "ARGS", key_exprs)
    expr_stmts[idx] = value_exprs
    expr_list_set(idx, "STMTS", value_exprs)
    idx

fn expr_lambda(param_names: [i64], body_stmts: [i64], span_id: i64) -> i64:
    val idx = expr_alloc(EXPR_LAMBDA, span_id)
    expr_args[idx] = param_names
    expr_list_set(idx, "ARGS", param_names)
    expr_stmts[idx] = body_stmts
    expr_list_set(idx, "STMTS", body_stmts)
    idx

fn expr_struct_lit(type_name: text, field_names: [i64], field_values: [i64], span_id: i64) -> i64:
    val idx = expr_alloc(EXPR_STRUCT_LIT, span_id)
    expr_s_val[idx] = type_name
    expr_text_set(idx, "S", type_name)
    expr_args[idx] = field_names
    expr_list_set(idx, "ARGS", field_names)
    expr_stmts[idx] = field_values
    expr_list_set(idx, "STMTS", field_values)
    idx

fn expr_tuple(elements: [i64], span_id: i64) -> i64:
    val idx = expr_alloc(EXPR_TUPLE, span_id)
    expr_args[idx] = elements
    expr_list_set(idx, "ARGS", elements)
    idx

fn expr_slice(base: i64, start_expr: i64, end_expr: i64, span_id: i64) -> i64:
    val idx = expr_alloc(EXPR_SLICE, span_id)
    expr_left[idx] = base
    expr_i64_set(idx, "LEFT", base)
    expr_right[idx] = start_expr
    expr_i64_set(idx, "RIGHT", start_expr)
    expr_extra[idx] = end_expr
    expr_i64_set(idx, "EXTRA", end_expr)
    idx

fn expr_null_coalesce(left_idx: i64, right_idx: i64, span_id: i64) -> i64:
    val idx = expr_alloc(EXPR_NULL_COALESCE, span_id)
    expr_left[idx] = left_idx
    expr_i64_set(idx, "LEFT", left_idx)
    expr_right[idx] = right_idx
    expr_i64_set(idx, "RIGHT", right_idx)
    idx

fn expr_exists_check(base: i64, span_id: i64) -> i64:
    val idx = expr_alloc(EXPR_EXISTS_CHECK, span_id)
    expr_left[idx] = base
    expr_i64_set(idx, "LEFT", base)
    idx

fn expr_force_unwrap(base: i64, span_id: i64) -> i64:
    val idx = expr_alloc(EXPR_FORCE_UNWRAP, span_id)
    expr_left[idx] = base
    expr_i64_set(idx, "LEFT", base)
    idx

fn expr_try(base: i64, span_id: i64) -> i64:
    val idx = expr_alloc(EXPR_TRY, span_id)
    expr_left[idx] = base
    expr_i64_set(idx, "LEFT", base)
    idx

fn expr_new_alloc(alloc_kind: i64, alloc_expr: i64, inner_expr: i64, span_id: i64) -> i64:
    val idx = expr_alloc(EXPR_NEW, span_id)
    expr_i_val[idx] = alloc_kind
    expr_i64_set(idx, "I", alloc_kind)
    expr_left[idx] = alloc_expr
    expr_i64_set(idx, "LEFT", alloc_expr)
    expr_right[idx] = inner_expr
    expr_i64_set(idx, "RIGHT", inner_expr)
    idx

fn expr_list_comp(iter_var: text, iterable: i64, body: i64, cond: i64, span_id: i64) -> i64:
    # s_val=iter_var, left=iterable, right=body, extra=cond (-1 if none)
    val idx = expr_alloc(EXPR_LIST_COMP, span_id)
    expr_s_val[idx] = iter_var
    expr_text_set(idx, "S", iter_var)
    expr_left[idx] = iterable
    expr_i64_set(idx, "LEFT", iterable)
    expr_right[idx] = body
    expr_i64_set(idx, "RIGHT", body)
    expr_extra[idx] = cond
    expr_i64_set(idx, "EXTRA", cond)
    idx

fn expr_dict_comp(iter_var: text, iterable: i64, key_body: i64, val_body: i64, cond: i64, span_id: i64) -> i64:
    # s_val=iter_var, left=iterable, extra=cond, args=[key_body, val_body]
    val idx = expr_alloc(EXPR_DICT_COMP, span_id)
    expr_s_val[idx] = iter_var
    expr_text_set(idx, "S", iter_var)
    expr_left[idx] = iterable
    expr_i64_set(idx, "LEFT", iterable)
    expr_extra[idx] = cond
    expr_i64_set(idx, "EXTRA", cond)
    expr_args[idx] = [key_body, val_body]
    expr_list_set(idx, "ARGS", [key_body, val_body])
    idx

fn expr_optional_chain(base: i64, field_name: text, span_id: i64) -> i64:
    val idx = expr_alloc(EXPR_OPTIONAL_CHAIN, span_id)
    expr_left[idx] = base
    expr_i64_set(idx, "LEFT", base)
    expr_s_val[idx] = field_name
    expr_text_set(idx, "S", field_name)
    idx

fn expr_cast(value: i64, type_tag: i64, span_id: i64) -> i64:
    val idx = expr_alloc(EXPR_CAST, span_id)
    expr_left[idx] = value
    expr_i64_set(idx, "LEFT", value)
    expr_i_val[idx] = type_tag
    expr_i64_set(idx, "I", type_tag)
    idx

# --- flat-AST pool codec: flat_expr ------------------------------
#
# Dump/restore for this file's 31 pools, in a FIXED SORTED ORDER that
# dump and restore share. Order is the whole contract: the blob carries no
# pool names, so a reordering on one side silently pairs each pool with its
# neighbour's data. Sorting by name keeps the two sides in step without
# anyone having to maintain a hand-written order.
#
# Completeness is enforced by scripts/check/check-flat-ast-codec-complete.shs,
# which derives the pool list from this file and fails when one is not both
# encoded and decoded. Do not add a pool here by hand without running it.

pub fn flat_expr_pools_dump() -> text:
    # Sub-blobs are collected and joined once. `out = out + <sub-blob>` across
    # ~165 pools re-copied the whole growing multi-megabyte blob on every pool,
    # which is quadratic in the pool count and paid on every cache-MISS store.
    # The bytes emitted are unchanged: the same pieces, in the same order.
    # doc/08_tracking/bug/frontend_shard_and_cache_hit_cost_2026-08-21.md
    var parts: [text] = []
    parts = parts.push(flat_pool_enc_text(asm_arm_abi))
    parts = parts.push(flat_pool_enc_text_list(asm_arm_archs))
    parts = parts.push(flat_pool_enc_text(asm_arm_asm_text))
    parts = parts.push(flat_pool_enc_text(asm_arm_backend))
    parts = parts.push(flat_pool_enc_text(asm_arm_error_msg))
    parts = parts.push(flat_pool_enc_bool(asm_arm_is_compile_error))
    parts = parts.push(flat_pool_enc_bool(asm_arm_is_wildcard))
    parts = parts.push(flat_pool_enc_text(asm_arm_os))
    parts = parts.push(flat_pool_enc_text_list(asm_arm_ver_ops))
    parts = parts.push(flat_pool_enc_i64_list(asm_arm_ver_vals))
    parts = parts.push(flat_pool_enc_i64(ast_gen_last_report_slot))
    parts = parts.push(flat_pool_enc_i64(ast_gen_slot))
    parts = parts.push(flat_pool_enc_text_list(expr_arg_names))
    parts = parts.push(flat_pool_enc_i64_list(expr_args))
    parts = parts.push(flat_pool_enc_text_list(expr_asm_clobbers))
    parts = parts.push(flat_pool_enc_text_list(expr_asm_kinds))
    parts = parts.push(flat_pool_enc_text_list(expr_asm_locations))
    parts = parts.push(flat_pool_enc_i64_list(expr_asm_outputs))
    parts = parts.push(flat_pool_enc_i64(expr_count_slot))
    parts = parts.push(flat_pool_enc_i64(expr_empty_i64))
    parts = parts.push(flat_pool_enc_text(expr_empty_text))
    parts = parts.push(flat_pool_enc_i64(expr_env_mirror_high_slot))
    parts = parts.push(flat_pool_enc_i64(expr_extra))
    parts = parts.push(flat_pool_enc_text(expr_f_val))
    parts = parts.push(flat_pool_enc_i64(expr_i_val))
    parts = parts.push(flat_pool_enc_i64(expr_left))
    parts = parts.push(flat_pool_enc_i64(expr_right))
    parts = parts.push(flat_pool_enc_text(expr_s_val))
    parts = parts.push(flat_pool_enc_i64(expr_span))
    parts = parts.push(flat_pool_enc_i64_list(expr_stmts))
    parts = parts.push(flat_pool_enc_i64(expr_tag))
    parts.join("")

# Returns false when the blob ran short or was malformed; the caller must
# treat that as a cache MISS and reparse, never as an empty parse.
pub fn flat_expr_pools_restore(r: FlatPoolReader) -> bool:
    asm_arm_abi = flat_pool_dec_text(r)
    asm_arm_archs = flat_pool_dec_text_list(r)
    asm_arm_asm_text = flat_pool_dec_text(r)
    asm_arm_backend = flat_pool_dec_text(r)
    asm_arm_error_msg = flat_pool_dec_text(r)
    asm_arm_is_compile_error = flat_pool_dec_bool(r)
    asm_arm_is_wildcard = flat_pool_dec_bool(r)
    asm_arm_os = flat_pool_dec_text(r)
    asm_arm_ver_ops = flat_pool_dec_text_list(r)
    asm_arm_ver_vals = flat_pool_dec_i64_list(r)
    ast_gen_last_report_slot = flat_pool_dec_i64(r)
    ast_gen_slot = flat_pool_dec_i64(r)
    expr_arg_names = flat_pool_dec_text_list(r)
    expr_args = flat_pool_dec_i64_list(r)
    expr_asm_clobbers = flat_pool_dec_text_list(r)
