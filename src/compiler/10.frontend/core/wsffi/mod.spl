# Core Simple — WFFI (Wrapped Foreign Function Interface)
#
# Thin Simple wrappers around runtime dlopen/dlsym/dlclose.
# Allows dynamically loading shared libraries and calling functions.
#
# Seed-compatible: no generics, no closures.
#
# Usage:
#   val lib = wffi_load("libm.so")
#   val fptr = wffi_get(lib, "sqrt")
#   val result = wffi_call_1(fptr, 4)
#   wffi_free(lib)

@unsafe(reason: "legacy raw dynamic loader ABI", capabilities: [ffi])
extern fn spl_dlopen(path: text) -> i64
@unsafe(reason: "status/out dynamic loader ABI", capabilities: [ffi, raw_ptr])
extern fn spl_dlopen_checked(path: text, out_handle: *mut i64) -> i64
@unsafe(reason: "legacy raw symbol resolver ABI", capabilities: [ffi, raw_ptr])
extern fn spl_dlsym(handle: i64, name: text) -> i64
@unsafe(reason: "status/out symbol resolver ABI", capabilities: [ffi, raw_ptr])
extern fn spl_dlsym_checked(handle: i64, name: text, out_symbol: *mut i64) -> i64
@unsafe(reason: "raw dynamic loader release ABI", capabilities: [ffi])
extern fn spl_dlclose(handle: i64) -> i64
@unsafe(reason: "untyped integer-only foreign call ABI", capabilities: [ffi, raw_ptr])
extern fn spl_wffi_call_i64(fptr: i64, args: [i64], nargs: i64) -> i64
@unsafe(reason: "typed C-boolean status/out call ABI", capabilities: [ffi, raw_ptr])
extern fn spl_wffi_call_bool0_checked(fptr: i64, out_value: *mut bool) -> i64
@unsafe(reason: "typed C-boolean status/out call ABI", capabilities: [ffi, raw_ptr])
extern fn spl_wffi_call_bool1_checked(fptr: i64, arg0: i64, out_value: *mut bool) -> i64

# Load a shared library. Fails closed instead of returning a null handle.
@unsafe(reason: "loads an unverified dynamic provider", capabilities: [ffi, raw_ptr])
fn wffi_load(path: text) -> i64:
    var handle: i64 = 0
    val status = spl_dlopen_checked(path, &mut handle)
    if status != 0 or handle <= 0:
        panic("E-SFFI-001: failed to load provider: {path} (status {status})")
    handle

# Look up a symbol by name. Fails closed instead of returning a null pointer.
@unsafe(reason: "resolves an unverified raw function pointer", capabilities: [ffi, raw_ptr])
fn wffi_get(handle: i64, name: text) -> i64:
    var symbol: i64 = 0
    val status = spl_dlsym_checked(handle, name, &mut symbol)
    if status != 0 or symbol <= 0:
        panic("E-SFFI-001: unresolved foreign symbol: {name} (status {status})")
    symbol

# Close a loaded library. Returns 0 on success.
@unsafe(reason: "releases an unverified dynamic provider", capabilities: [ffi])
fn wffi_close(handle: i64) -> i64:
    spl_dlclose(handle)

# Alias for wffi_close.
@unsafe(reason: "releases an unverified dynamic provider", capabilities: [ffi])
fn wffi_free(handle: i64) -> i64:
    spl_dlclose(handle)

# Call a function pointer with 0 arguments. Returns i64.
@unsafe(reason: "invokes an untyped integer-only foreign function", capabilities: [ffi, raw_ptr])
fn wffi_call_0(fptr: i64) -> i64:
    var args: [i64] = []
    spl_wffi_call_i64(fptr, args, 0)

# Call with 1 argument.
@unsafe(reason: "invokes an untyped integer-only foreign function", capabilities: [ffi, raw_ptr])
fn wffi_call_1(fptr: i64, a0: i64) -> i64:
    var args: [i64] = []
    args.push(a0)
    spl_wffi_call_i64(fptr, args, 1)

# Call with 2 arguments.
@unsafe(reason: "invokes an untyped integer-only foreign function", capabilities: [ffi, raw_ptr])
fn wffi_call_2(fptr: i64, a0: i64, a1: i64) -> i64:
    var args: [i64] = []
    args.push(a0)
    args.push(a1)
    spl_wffi_call_i64(fptr, args, 2)

# Call with 3 arguments.
@unsafe(reason: "invokes an untyped integer-only foreign function", capabilities: [ffi, raw_ptr])
fn wffi_call_3(fptr: i64, a0: i64, a1: i64, a2: i64) -> i64:
    var args: [i64] = []
    args.push(a0)
    args.push(a1)
    args.push(a2)
    spl_wffi_call_i64(fptr, args, 3)

# Call with 4 arguments.
@unsafe(reason: "invokes an untyped integer-only foreign function", capabilities: [ffi, raw_ptr])
fn wffi_call_4(fptr: i64, a0: i64, a1: i64, a2: i64, a3: i64) -> i64:
    var args: [i64] = []
    args.push(a0)
    args.push(a1)
    args.push(a2)
    args.push(a3)
    spl_wffi_call_i64(fptr, args, 4)

# Call with 5 arguments.
@unsafe(reason: "invokes an untyped integer-only foreign function", capabilities: [ffi, raw_ptr])
fn wffi_call_5(fptr: i64, a0: i64, a1: i64, a2: i64, a3: i64, a4: i64) -> i64:
    var args: [i64] = []
    args.push(a0)
    args.push(a1)
    args.push(a2)
    args.push(a3)
    args.push(a4)
    spl_wffi_call_i64(fptr, args, 5)

# Call with 6 arguments.
@unsafe(reason: "invokes an untyped integer-only foreign function", capabilities: [ffi, raw_ptr])
fn wffi_call_6(fptr: i64, a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64) -> i64:
    var args: [i64] = []
    args.push(a0)
    args.push(a1)
    args.push(a2)
    args.push(a3)
    args.push(a4)
    args.push(a5)
    spl_wffi_call_i64(fptr, args, 6)

# Call with 7 arguments.
@unsafe(reason: "invokes an untyped integer-only foreign function", capabilities: [ffi, raw_ptr])
fn wffi_call_7(fptr: i64, a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64) -> i64:
    var args: [i64] = []
    args.push(a0)
    args.push(a1)
    args.push(a2)
    args.push(a3)
    args.push(a4)
    args.push(a5)
    args.push(a6)
    spl_wffi_call_i64(fptr, args, 7)

# Call with 8 arguments.
@unsafe(reason: "invokes an untyped integer-only foreign function", capabilities: [ffi, raw_ptr])
fn wffi_call_8(fptr: i64, a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64) -> i64:
    var args: [i64] = []
    args.push(a0)
    args.push(a1)
    args.push(a2)
    args.push(a3)
    args.push(a4)
    args.push(a5)
    args.push(a6)
    args.push(a7)
    spl_wffi_call_i64(fptr, args, 8)

# Call with a pre-built args array. Dispatches by args.len().
@unsafe(reason: "invokes an untyped integer-only foreign function", capabilities: [ffi, raw_ptr])
fn wffi_call_n(fptr: i64, args: [i64]) -> i64:
    spl_wffi_call_i64(fptr, args, args.len())

# Call a declared C-boolean function with no arguments. Bridge failure is not
# representable as false: it fails closed before returning a value.
@unsafe(reason: "invokes a typed but otherwise unverified C-boolean function", capabilities: [ffi, raw_ptr])
fn wffi_call_bool(fptr: i64) -> bool:
    var value = false
    val status = spl_wffi_call_bool0_checked(fptr, &mut value)
    if status != 0:
        panic("E-SFFI-014: typed boolean bridge status {status}")
    value

# Call a declared C-boolean function with one i64 argument.
@unsafe(reason: "invokes a typed but otherwise unverified C-boolean function", capabilities: [ffi, raw_ptr])
fn wffi_call_bool_1(fptr: i64, a0: i64) -> bool:
    var value = false
    val status = spl_wffi_call_bool1_checked(fptr, a0, &mut value)
    if status != 0:
        panic("E-SFFI-014: typed boolean bridge status {status}")
    value
