# Parser — Preprocessor Module
#
# Conditional compilation: @when/@elif/@else/@end directives
# and @cfg per-declaration conditionals.
# Extracted from parser.spl.

use compiler.core.cfg_platform.{cfg_strip_quotes, cfg_detect_os, cfg_detect_arch, cfg_os_is_unix}
use compiler.frontend.frontend_target_cfg_receipt_v1.{
    FrontendCfgDecisionV1, FrontendTargetPreprocessV1}

# ===== Preprocessor State =====

var _pp_tokens: [text] = []
var _pp_pos: i64 = 0
var _pp_target_mode: bool = false
var _pp_target_os: text = ""
var _pp_target_arch: text = ""
var _pp_target_error: text = ""
var _pp_target_decisions: [FrontendCfgDecisionV1] = []

# One condition evaluator for both modes. Target mode (receipted native
# builds) evaluates against the explicit target and records an error for
# anything it does not recognize; ambient mode evaluates against the build
# target / host from cfg_platform and treats unknown atoms as false.
fn _pp_current_os() -> text:
    if _pp_target_mode: _pp_target_os else: cfg_detect_os()

fn _pp_current_arch() -> text:
    if _pp_target_mode: _pp_target_arch else: cfg_detect_arch()

fn _pp_unsupported(message: text) -> bool:
    if _pp_target_mode:
        _pp_target_error = message
    false

# Canonical atom set shared with the Rust seed (`parser/src/cond_compile.rs`;
# the module doc there is the normative table). Values are case-insensitive;
# both sides are pinned to test/fixtures/conditional_compile/conformance/.
fn _pp_os_name(raw: text) -> text:
    val value = raw.to_lower()
    if value == "windows" or value == "win": return "windows"
    if value == "macos" or value == "mac" or value == "darwin": return "macos"
    if value == "none" or value == "baremetal": return "none"
    if value == "linux" or value == "freebsd" or value == "openbsd" or
            value == "netbsd" or value == "android" or value == "simpleos" or
            value == "unix":
        return value
    ""

fn _pp_arch_name(raw: text) -> text:
    val value = raw.to_lower()
    if value == "x86_64" or value == "amd64" or value == "x64": return "x86_64"
    if value == "x86" or value == "i386" or value == "i686": return "x86"
    if value == "aarch64" or value == "arm64": return "aarch64"
    if value == "arm" or value == "arm32" or value == "armv6" or value == "armv7": return "arm"
    if value == "ppc64le" or value == "ppc64el" or value == "powerpc64le": return "ppc64le"
    if value == "riscv64" or value == "riscv32" or value == "thumbv6m" or
            value == "thumbv7m" or value == "thumbv7em":
        return value
    ""

fn _pp_os_match(value: text) -> bool:
    val wanted = _pp_os_name(value)
    if wanted == "":
        return _pp_unsupported("unsupported target cfg OS: {value}")
    val os = _pp_current_os()
    if wanted == "unix":
        return cfg_os_is_unix(os)
    os == wanted

fn _pp_family_match(raw: text) -> bool:
    val value = raw.to_lower()
    if value == "unix": return cfg_os_is_unix(_pp_current_os())
    if value == "windows": return _pp_current_os() == "windows"
    _pp_unsupported("unsupported target cfg family: {raw}")

fn _pp_arch_match(value: text) -> bool:
    val wanted = _pp_arch_name(value)
    if wanted == "":
        return _pp_unsupported("unsupported target cfg architecture: {value}")
    _pp_current_arch() == wanted

fn _pp_eval_atom(token: text) -> bool:
    val t = cfg_strip_quotes(token).trim()
    val lowered = t.to_lower()
    if lowered == "true" or lowered == "compiled" or lowered == "debug": return true
    if lowered == "false" or lowered == "interpreter" or lowered == "release": return false
    if not _pp_target_mode and t == "": return false
    if _pp_os_name(t) != "": return _pp_os_match(t)
    if _pp_arch_name(t) != "": return _pp_arch_match(t)
    val parts = if t.contains("=="): t.split("==") else: t.split("=")
    if parts.len() == 2:
        val key = cfg_strip_quotes(parts[0]).trim()
        val value = cfg_strip_quotes(parts[1]).trim()
        if key == "os" or key == "platform" or key == "target_os":
            return _pp_os_match(value)
        if key == "family" or key == "target_family":
            return _pp_family_match(value)
        if key == "arch" or key == "target_arch" or key == "cpu":
            return _pp_arch_match(value)
        # No build features are defined: a feature gate is always false.
        if key == "feature":
            return false
    _pp_unsupported("unsupported target cfg condition atom: {t}")

fn _pp_tokenize_condition(condition: text) -> [text]:
    var tokens: [text] = []
    var current: [text] = []
    var i: i64 = 0

    while i < condition.len():
        val ch = condition[i]

        val is_ws = ch == " " or ch == "\t" or ch == "\r"
        if is_ws:
            if current.len() > 0:
                tokens.push(current.join(""))
                current = []
            i = i + 1
            continue

        val is_paren = ch == "(" or ch == ")"
        if is_paren:
            if current.len() > 0:
                tokens.push(current.join(""))
                current = []
            tokens.push(ch)
            i = i + 1
            continue

        if ch == "&" and i + 1 < condition.len() and condition[i + 1] == "&":
            if current.len() > 0:
                tokens.push(current.join(""))
                current = []
            tokens.push("&&")
            i = i + 2
            continue

        if ch == "|" and i + 1 < condition.len() and condition[i + 1] == "|":
            if current.len() > 0:
                tokens.push(current.join(""))
                current = []
            tokens.push("||")
            i = i + 2
            continue

        if ch == "!":
            if current.len() > 0:
                tokens.push(current.join(""))
                current = []
            tokens.push("!")
            i = i + 1
            continue

        # `=` / `==` are tokens of their own so `os ="x"`, `os= "x"` and
        # `os = "x"` all re-join to one key/value atom (seed does the same).
        if ch == "=":
            if current.len() > 0:
                tokens.push(current.join(""))
                current = []
            if i + 1 < condition.len() and condition[i + 1] == "=":
                tokens.push("==")
                i = i + 2
            else:
                tokens.push("=")
                i = i + 1
            continue

        current.push(ch)
        i = i + 1

    if current.len() > 0:
        tokens.push(current.join(""))

    tokens

fn _pp_peek() -> text:
    if _pp_pos >= _pp_tokens.len():
        return ""
    _pp_tokens[_pp_pos]

fn _pp_take() -> text:
    val token = _pp_peek()
    if token != "":
        _pp_pos = _pp_pos + 1
    token

fn _pp_parse_or() -> bool:
    var left = _pp_parse_and()
    while true:
        val tok = _pp_peek()
        val is_or = tok == "or" or tok == "||"
        if not is_or:
            break
        _pp_take()
        val right = _pp_parse_and()
        left = left or right
    left

fn _pp_parse_and() -> bool:
    var left = _pp_parse_not()
    while true:
        val tok = _pp_peek()
        val is_and = tok == "and" or tok == "&&"
        if not is_and:
            break
        _pp_take()
        val right = _pp_parse_not()
        left = left and right
    left

fn _pp_parse_not() -> bool:
    val tok = _pp_peek()
    val is_not = tok == "not" or tok == "!"
    if is_not:
        _pp_take()
        return not _pp_parse_not()
    _pp_parse_primary()

fn _pp_parse_primary() -> bool:
    val tok = _pp_peek()
    if tok == "(":
        _pp_take()
        val value = _pp_parse_or()
        if _pp_peek() == ")":
            _pp_take()
        return value

    val atom = _pp_take()
    # Task #105: the tokenizer splits a SPACED key/value @cfg condition
    # (`@cfg(arch = "x86_64")`) into separate whitespace-delimited tokens
    # (["arch", "=", "\"x86_64\""] or, for `==`, two single "=" tokens).
    # Without reassembly only `atom` ("arch") reaches `_pp_eval_atom`, which
    # falls through every known-keyword case to `false` regardless of the
    # real value -- so BOTH a matching and a non-matching `@cfg(key = ...)`
    # variant were silently dropped (or, depending on source order, an
    # inactive variant's declaration could survive the false-negative
    # filter untouched), producing wrong/ambiguous @cfg-arch dispatch.
    # Reassemble one or more adjacent "="/"==" tokens plus the following
    # value token into a single `key=value`/`key==value` atom so the
    # key/value path in `_pp_eval_atom` is reached (same as the seed's
    # cond_compile parse_primary).
    var eq_op: [text] = []
    while _pp_peek() == "=" or _pp_peek() == "==":
        eq_op.push(_pp_take())
    if eq_op.len() > 0:
        val value_tok = _pp_take()
        val joined_eq = eq_op.join("")
        return _pp_eval_atom("{atom}{joined_eq}{value_tok}")
    _pp_eval_atom(atom)

fn _pp_eval_condition(condition: text) -> bool:
    _pp_tokens = _pp_tokenize_condition(condition)
    _pp_pos = 0
    if _pp_tokens.len() == 0:
        if _pp_target_mode:
            _pp_target_error = "empty target cfg condition"
        return false
    val result = _pp_parse_or()
    if _pp_target_mode and _pp_pos != _pp_tokens.len():
        _pp_target_error = "malformed target cfg condition: {condition}"
    result

fn _pp_extract_paren_condition(line: text) -> text:
    # Extract condition from @when(condition): or @cfg(condition) etc.
    # Finds '(' and reads until matching ')'.
    var start: i64 = -1
    var i: i64 = 0
    for _ in line:
        if i >= line.len(): break
        if line[i] == "(":
            start = i + 1
            break
        i = i + 1
    if start < 0:
        return ""
    var depth: i64 = 1
    var chars: [text] = []
    var j: i64 = start
    for _ in line:
        if j >= line.len(): break
        val ch = line[j]
        if ch == "(":
            depth = depth + 1
        if ch == ")":
            depth = depth - 1
            if depth == 0: break
        chars.push(ch)
        j = j + 1
    chars.join("").trim()

fn _pp_extract_cfg_condition(line: text) -> text:
    # Extract from @cfg(condition) or @cfg("key", "value")
    # For key-value form, convert to key=value for eval
    val raw = _pp_extract_paren_condition(line)
    if raw.contains(","):
        val parts = raw.split(",")
        if parts.len() >= 2:
            val key = cfg_strip_quotes(parts[0].trim())
            val value = cfg_strip_quotes(parts[1].trim())
            return "{key}={value}"
    raw

fn _pp_split_lines(source: text) -> [text]:
    source.split("\n")

fn _pp_may_have_conditionals(source: text) -> bool:
    (source.contains("@when(") or source.contains("@elif(") or
        source.contains("@else") or source.contains("@end") or
        source.contains("@cfg("))

fn _pp_target_decl_kind(line: text) -> text:
    val t = line.trim()
    if t.starts_with("fn ") or t.starts_with("pub fn ") or
            t.starts_with("me ") or t.starts_with("pub me ") or
            t.starts_with("extern fn ") or t.starts_with("async fn ") or
            t.starts_with("pub async fn ") or t.starts_with("static fn "):
        return "code"
    if t.starts_with("var ") or t.starts_with("val ") or
            t.starts_with("const ") or t.starts_with("pub const ") or
            t.starts_with("static ") or t.starts_with("pub static "):
        return "data"
    if t == "@init" or t.starts_with("@init("):
        return "init"
    ""

fn _pp_target_indent(line: text) -> i64:
    var count = 0
    var i = 0
    while i < line.len():
        val ch = line[i]
        if ch == " ": count = count + 1
        elif ch == "\t": count = count + 4
        else: break
        i = i + 1
    count

fn _pp_target_decl_end(lines: [text], start: i64) -> i64:
    if start < 0 or start >= lines.len(): return start + 1
    val first = lines[start].trim()
    if not first.ends_with(":"): return start + 1
    val indent = _pp_target_indent(lines[start])
    var end = start + 1
    var i = start + 1
    while i < lines.len():
        if lines[i].trim() != "" and _pp_target_indent(lines[i]) <= indent:
            break
        end = i + 1
        i = i + 1
    end

fn _pp_target_record(line: i64, directive_kind: text, condition: text,
    parent_active: bool, condition_result: bool, effective_active: bool,
    excluded_kind: text, excluded_start: i64, excluded_end: i64):
    if not _pp_target_mode: return
    _pp_target_decisions.push(FrontendCfgDecisionV1(
        line: line, directive_kind: directive_kind, condition: condition,
        parent_active: parent_active, condition_result: condition_result,
        effective_active: effective_active,
        excluded_declaration_kind: excluded_kind,
        excluded_start_line: excluded_start, excluded_end_line: excluded_end))

fn _pp_preprocess_conditionals(source: text) -> text:
    # The compiler closure is overwhelmingly ordinary source. Avoid building
    # three full line arrays when none of the recognized directives can occur.
    if not _pp_may_have_conditionals(source):
        return source

    val lines = _pp_split_lines(source)
    var out_lines: [text] = []

    var stack_parent_active: [bool] = []
    var stack_branch_taken: [bool] = []
    var stack_branch_active: [bool] = []
    var stack_else_seen: [bool] = []
    var depth: i64 = 0
    var active: bool = true

    var source_line: i64 = 0
    for line in lines:
        source_line = source_line + 1
        val trimmed = line.trim()

        val is_when = trimmed.starts_with("@when(")
        if is_when:
            val cond = _pp_extract_paren_condition(trimmed)
            if _pp_target_mode and cond == "":
                _pp_target_error = "empty @when condition at line {source_line}"
            val parent = active
            val cond_ok = _pp_eval_condition(cond)
            val current = parent and cond_ok

            if depth >= stack_parent_active.len():
                stack_parent_active.push(parent)
                stack_branch_taken.push(current)
                stack_branch_active.push(current)
                stack_else_seen.push(false)
            else:
                stack_parent_active[depth] = parent
                stack_branch_taken[depth] = current
                stack_branch_active[depth] = current
                stack_else_seen[depth] = false
            depth = depth + 1
            active = current
            _pp_target_record(source_line, "when", cond, parent, cond_ok,
                current, "", 0, 0)
            out_lines.push("")
            continue

        val is_elif = trimmed.starts_with("@elif(")
        if is_elif:
            if depth > 0:
                val idx = depth - 1
                val parent = stack_parent_active[idx]
                var taken = stack_branch_taken[idx]
                var current = false
                val cond = _pp_extract_paren_condition(trimmed)
                if _pp_target_mode and cond == "":
                    _pp_target_error = "empty @elif condition at line {source_line}"
                if _pp_target_mode and stack_else_seen[idx]:
                    _pp_target_error = "@elif after @else at line {source_line}"
                var condition_result = false
                if parent and not taken:
                    condition_result = _pp_eval_condition(cond)
                    current = condition_result
                    if current:
                        taken = true
                elif _pp_target_mode:
                    condition_result = _pp_eval_condition(cond)
                stack_branch_taken[idx] = taken
                stack_branch_active[idx] = current
                active = current
                _pp_target_record(source_line, "elif", cond, parent,
                    condition_result, current, "", 0, 0)
            elif _pp_target_mode:
                _pp_target_error = "@elif without @when at line {source_line}"
            out_lines.push("")
            continue

        val is_else = trimmed == "@else" or trimmed == "@else:"
        if is_else:
            if depth > 0:
                val idx = depth - 1
                if _pp_target_mode and stack_else_seen[idx]:
                    _pp_target_error = "duplicate @else at line {source_line}"
                stack_else_seen[idx] = true
                val parent = stack_parent_active[idx]
                val taken = stack_branch_taken[idx]
                val current = parent and (not taken)
                stack_branch_taken[idx] = taken or current
                stack_branch_active[idx] = current
                active = current
                _pp_target_record(source_line, "else", "", parent,
                    not taken, current, "", 0, 0)
            elif _pp_target_mode:
                _pp_target_error = "@else without @when at line {source_line}"
            out_lines.push("")
            continue

        val is_end = trimmed == "@end"
        if is_end:
            if depth > 0:
                depth = depth - 1
            elif _pp_target_mode:
                _pp_target_error = "@end without @when at line {source_line}"
            if depth <= 0:
                active = true
            else:
                active = stack_branch_active[depth - 1]
            _pp_target_record(source_line, "end", "", true, true,
                active, "", 0, 0)
            out_lines.push("")
            continue

        if active:
            # Branch bodies are flat: kept lines are emitted verbatim, never
            # dedented (same contract as the seed's cond_compile pass).
            out_lines.push(line)
        else:
            # Keep line count stable for diagnostics.
            if _pp_target_mode and trimmed.starts_with("@cfg("):
                val inactive_cond = _pp_extract_cfg_condition(trimmed)
                val inactive_result = _pp_eval_condition(inactive_cond)
                _pp_target_record(source_line, "cfg", inactive_cond, false,
                    inactive_result, false, "", 0, 0)
            val excluded_kind = _pp_target_decl_kind(trimmed)
            if excluded_kind != "":
                _pp_target_record(source_line, "excluded", "", false, false,
                    false, excluded_kind, source_line,
                    _pp_target_decl_end(lines, source_line - 1))
            out_lines.push("")

    if _pp_target_mode and depth != 0:
        _pp_target_error = "unclosed @when block"

    # Second pass: @cfg(condition) per-declaration conditionals
    var final_lines: [text] = []
    var skip_until_dedent: bool = false
    var skip_indent: i64 = -1
    var skip_until_close_brace: bool = false
    var brace_depth: i64 = 0
    var i: i64 = 0
    for _ in out_lines:
        if i >= out_lines.len(): break
        val ol = out_lines[i]
        val ot = ol.trim()

        if skip_until_close_brace:
            # Multi-line brace-delimited declaration (e.g. a multi-line
            # `use module.{...}` import) gated by a false @cfg — blank every
            # continuation line until the braces opened by the declaration
            # line close back to depth 0.
            var opens: i64 = 0
            var closes: i64 = 0
            var bi: i64 = 0
            for _ in ol:
                if bi >= ol.len(): break
                val bc = ol[bi]
                if bc == "{":
                    opens = opens + 1
                elif bc == "}":
                    closes = closes + 1
                bi = bi + 1
            brace_depth = brace_depth + opens - closes
            final_lines.push("")
            i = i + 1
            if brace_depth <= 0:
                skip_until_close_brace = false
                brace_depth = 0
            continue

        if skip_until_dedent:
            if ot == "":
                # Blank lines have no indentation boundary. Keep excluding the
                # declaration across docstring paragraphs and spaced statements.
                final_lines.push("")
                i = i + 1
                continue
            var cur_indent: i64 = 0
            var ci: i64 = 0
            for _ in ol:
                if ci >= ol.len(): break
                val c = ol[ci]
                if c == " ":
                    cur_indent = cur_indent + 1
                elif c == "\t":
                    cur_indent = cur_indent + 4
                else:
                    break
                ci = ci + 1
            if cur_indent > skip_indent:
                final_lines.push("")
                i = i + 1
                continue
            else:
                skip_until_dedent = false
                skip_indent = -1

        if ot.starts_with("@cfg("):
            # In target mode adjacent decorators jointly gate one declaration.
            # The ambient path retains its existing single-decorator behavior.
            var declaration_index = i + 1
            if _pp_target_mode:
                while declaration_index < out_lines.len() and
                        out_lines[declaration_index].trim().starts_with("@cfg("):
                    declaration_index = declaration_index + 1
            var cfg_ok = true
            var cfg_index = i
            while cfg_index < declaration_index:
                val cfg_cond = _pp_extract_cfg_condition(out_lines[cfg_index].trim())
                val condition_result = _pp_eval_condition(cfg_cond)
                val parent = cfg_ok
                cfg_ok = cfg_ok and condition_result
                val excluded_start = if not cfg_ok and declaration_index < out_lines.len():
                    declaration_index + 1
                else:
                    0
                val excluded_end = if excluded_start > 0:
                    _pp_target_decl_end(out_lines, declaration_index)
                else:
                    0
                val excluded_kind = if excluded_start > 0:
                    _pp_target_decl_kind(out_lines[declaration_index])
                else:
                    ""
                _pp_target_record(cfg_index + 1, "cfg", cfg_cond, parent,
                    condition_result, cfg_ok, excluded_kind,
                    excluded_start, excluded_end)
                final_lines.push("")
                cfg_index = cfg_index + 1
            if cfg_ok:
                # Conditions true: decorators are blank; keep declaration.
                i = declaration_index
            else:
                # Conditions false: blank decorators and their declaration.
                if declaration_index < out_lines.len():
                    val next_line = out_lines[declaration_index]
                    val next_trimmed = next_line.trim()
                    var next_indent: i64 = 0
                    var ni: i64 = 0
                    for _ in next_line:
                        if ni >= next_line.len(): break
                        val nc = next_line[ni]
                        if nc == " ":
                            next_indent = next_indent + 1
                        elif nc == "\t":
                            next_indent = next_indent + 4
                        else:
                            break
                        ni = ni + 1
                    # Blank the declaration line
                    final_lines.push("")
                    # If declaration ends with ':', blank its body too
                    if next_trimmed.ends_with(":"):
                        skip_until_dedent = true
                        skip_indent = next_indent
                    elif next_trimmed.ends_with("{") and not next_trimmed.ends_with("}"):
                        # Multi-line brace-delimited declaration (e.g. a
                        # multi-line `use module.{ a, b, c }` import spanning
                        # several lines). @cfg does not otherwise gate `use`
                        # statements at all — the import-closure walker would
                        # still see the (now-syntactically-broken) dangling
                        # continuation lines as unconditional imports. Track
                        # brace depth and blank through the matching close.
                        var opens0: i64 = 0
                        var closes0: i64 = 0
                        var oi: i64 = 0
                        for _ in next_line:
                            if oi >= next_line.len(): break
                            val oc = next_line[oi]
                            if oc == "{":
                                opens0 = opens0 + 1
                            elif oc == "}":
                                closes0 = closes0 + 1
                            oi = oi + 1
                        val depth0 = opens0 - closes0
                        if depth0 > 0:
                            skip_until_close_brace = true
                            brace_depth = depth0
                i = declaration_index + 1
            continue

        final_lines.push(ol)
        i = i + 1

    final_lines.join("\n")

pub fn _pp_preprocess_conditionals_target_receipted_v1(
    source: text, target_os: text, target_arch: text
) -> Result<FrontendTargetPreprocessV1, text>:
    if target_os == "" or target_arch == "":
        return Err("explicit target cfg OS and architecture are required")
    _pp_target_mode = true
    _pp_target_os = target_os
    _pp_target_arch = target_arch
    _pp_target_error = ""
    _pp_target_decisions = []
    val preprocessed = _pp_preprocess_conditionals(source)
    val error = _pp_target_error
    val decisions = _pp_target_decisions
    _pp_target_mode = false
    _pp_target_os = ""
    _pp_target_arch = ""
    _pp_target_error = ""
    _pp_target_decisions = []
    if error != "": return Err(error)
    Ok(FrontendTargetPreprocessV1(source: preprocessed, decisions: decisions))

# ===== Public API =====

fn preprocess_conditionals(source: text) -> text:
    _pp_preprocess_conditionals(source)

# ===== Exports =====

export _pp_preprocess_conditionals, preprocess_conditionals
export _pp_preprocess_conditionals_target_receipted_v1
