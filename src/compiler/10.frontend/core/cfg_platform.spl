# Shared Platform Detection Utilities
#
# Common helpers for detecting OS, architecture, and CPU from environment
# variables. Used by both the parser (compile-time @cfg) and the interpreter
# (runtime @when) conditional compilation systems.

use std.nogc_sync_mut.io_runtime.{env_get, file_read, platform_name, host_arch}

fn cfg_env(key: text) -> text:
    env_get(key)

# Process-lifetime cache for the host-arch probe (host_arch() shells out to
# uname -m; the ambient @cfg evaluator runs per guarded declaration).
var _cfg_host_arch_cache: text = ""

fn cfg_strip_quotes(value: text) -> text:
    val trimmed = value.trim()
    if trimmed.len() >= 2:
        val is_double = trimmed.starts_with("\"") and trimmed.ends_with("\"")
        val is_single = trimmed.starts_with("'") and trimmed.ends_with("'")
        if is_double or is_single:
            return trimmed.slice(1, trimmed.len() - 1)
    trimmed

# Environment / host spelling -> canonical cfg OS. This is the ONE fuzzy rule
# shared with the seed (`cond_compile.rs` `normalize_host_os`): lowercase,
# then the first matching substring in this order. `Windows_NT`, `darwin23`,
# `linux-gnu`, `uname -s` output all resolve. Atom VALUES inside @when/@cfg
# use the exact alias table in parser_preprocessor.spl instead.
fn cfg_normalize_os(raw: text) -> text:
    val value = cfg_strip_quotes(raw).trim().to_lower()
    if value == "":
        return ""
    if value == "win" or value.contains("windows"):
        return "windows"
    if value.contains("linux"):
        return "linux"
    if value == "mac" or value.contains("macos") or value.contains("darwin") or value.contains("mac"):
        return "macos"
    if value.contains("freebsd"):
        return "freebsd"
    if value.contains("openbsd"):
        return "openbsd"
    if value.contains("simpleos"):
        return "simpleos"
    if value.contains("netbsd"):
        return "netbsd"
    if value.contains("android"):
        return "android"
    if value.contains("unix"):
        return "unix"
    # Bare metal: SIMPLE_TARGET_OS=none selects the `none` target, never the
    # host OS.
    if value == "none" or value == "baremetal":
        return "none"
    ""

# Environment / host spelling -> canonical cfg arch; same shared fuzzy rule
# as the seed's `normalize_host_arch` (`AMD64`, `x86_64-pc-linux-gnu`,
# `riscv64gc`, `uname -m` output).
fn cfg_normalize_arch(raw: text) -> text:
    val value = cfg_strip_quotes(raw).trim().to_lower()
    if value == "":
        return ""
    if value == "x64" or value.contains("x86_64") or value.contains("amd64"):
        return "x86_64"
    if value == "x86" or value.contains("i386") or value.contains("i686"):
        return "x86"
    if value.contains("aarch64") or value.contains("arm64"):
        return "aarch64"
    # Thumb-only Cortex-M targets keep their own cfg arch value (the strict
    # target evaluator and frontend_cfg_target_from_triple_v1 use these names).
    if value.starts_with("thumbv6m"):
        return "thumbv6m"
    if value.starts_with("thumbv7em"):
        return "thumbv7em"
    if value.starts_with("thumbv7m"):
        return "thumbv7m"
    if value == "arm" or value == "arm32" or value.contains("armv7") or value.contains("armv6"):
        return "arm"
    if value.contains("riscv64"):
        return "riscv64"
    if value.contains("riscv32"):
        return "riscv32"
    if value == "ppc64el" or value.contains("ppc64le") or value.contains("powerpc64le"):
        return "ppc64le"
    ""

# OS set that the `unix` cfg predicate / `family = "unix"` key selects.
fn cfg_os_is_unix(os: text) -> bool:
    (os == "linux" or os == "macos" or os == "freebsd" or os == "openbsd" or
        os == "netbsd" or os == "android" or os == "simpleos" or os == "unix")

# cfg OS of a target triple ("x86_64-pc-windows-msvc" -> "windows",
# "aarch64-unknown-none" -> "none"). "" when no component names an OS.
fn cfg_triple_os(triple: text) -> text:
    val parts = triple.trim().split("-")
    var i = 1
    while i < parts.len():
        val part = parts[i]
        if part == "none" or part == "baremetal":
            return "none"
        val os = if part == "win32": "windows" else: cfg_normalize_os(part)
        if os != "" and os != "unix":
            return os
        i = i + 1
    ""

# cfg arch of a target triple ("riscv64gc-unknown-linux-gnu" -> "riscv64").
fn cfg_triple_arch(triple: text) -> text:
    val parts = triple.trim().split("-")
    if parts.len() < 2:
        return ""
    cfg_normalize_arch(parts[0])

# Conditional compilation selects for the TARGET being built. The native-build
# and `compile --target` CLI paths export the requested triple as
# SIMPLE_NATIVE_BUILD_TARGET for the whole build (closure scan, parse shards,
# backend); without consulting it here every cross build evaluated @when/@cfg
# against the host.
#
# ONE precedence rule, shared with the seed (cond_compile.rs default_target):
#   1. the explicit build target: SIMPLE_NATIVE_BUILD_TARGET triple
#   2. the manual override: SIMPLE_TARGET_OS / SIMPLE_TARGET_ARCH
#   3. the host
fn cfg_build_target_triple() -> text:
    cfg_env("SIMPLE_NATIVE_BUILD_TARGET").trim()

fn cfg_detect_os() -> text:
    val from_target = cfg_triple_os(cfg_build_target_triple())
    if from_target != "":
        return from_target

    val forced = cfg_normalize_os(cfg_env("SIMPLE_TARGET_OS"))
    if forced != "":
        return forced

    val from_os = cfg_normalize_os(cfg_env("OS"))
    if from_os != "":
        return from_os

    val from_ostype = cfg_normalize_os(cfg_env("OSTYPE"))
    if from_ostype != "":
        return from_ostype

    val from_platform = cfg_normalize_os(cfg_env("PLATFORM"))
    if from_platform != "":
        return from_platform

    val from_uname = cfg_normalize_os(cfg_env("UNAME"))
    if from_uname != "":
        return from_uname

    # Native host fallback: env vars are usually not exported to the process,
    # so consult the runtime directly (host OS, correct for interpretation).
    val plat = platform_name()
    if plat != nil and plat != "":
        val from_plat = cfg_normalize_os(plat)
        if from_plat != "":
            return from_plat

    "unknown"

fn cfg_detect_arch() -> text:
    val from_target = cfg_triple_arch(cfg_build_target_triple())
    if from_target != "":
        return from_target

    val forced = cfg_normalize_arch(cfg_env("SIMPLE_TARGET_ARCH"))
    if forced != "":
        return forced

    val from_arch = cfg_normalize_arch(cfg_env("PROCESSOR_ARCHITECTURE"))
    if from_arch != "":
        return from_arch

    val from_hosttype = cfg_normalize_arch(cfg_env("HOSTTYPE"))
    if from_hosttype != "":
        return from_hosttype

    val from_machtype = cfg_normalize_arch(cfg_env("MACHTYPE"))
    if from_machtype != "":
        return from_machtype

    val from_cpu = cfg_normalize_arch(cfg_env("CPU"))
    if from_cpu != "":
        return from_cpu

    # Native host fallback (Linux, kernel >= 6.1): /proc/sys/kernel/arch.
    # Must not call an extern the runtime does not export — an undefined
    # extern resolves to null and crashes every @cfg-bearing file.
    if platform_name() == "linux":
        val proc_arch_raw = file_read("/proc/sys/kernel/arch")
        val proc_arch = cfg_normalize_arch(proc_arch_raw.trim())
        if proc_arch != "":
            return proc_arch

    # macOS/BSD hosts: the env-var probes above are unexported there and the
    # /proc path is Linux-only, so without this cfg_detect_arch() returned
    # "unknown" on Apple Silicon and EVERY @cfg(arch) guard evaluated false
    # in the ambient preprocessing path — stripping active guarded
    # declarations before parse and surfacing as phase-2 HIR "no exported
    # item" failures (root-caused 2026-10-08; see doc/08_tracking/bug/
    # phase2_cli_test_runner_build_hir_export_origin_failures_2026-10-07.md).
    # host_arch() shells out to uname -m, so resolve it once per process.
    if _cfg_host_arch_cache == "":
        _cfg_host_arch_cache = host_arch()
    val from_host = cfg_normalize_arch(_cfg_host_arch_cache)
    if from_host != "":
        return from_host

    "unknown"

fn cfg_detect_cpu() -> text:
    val forced = cfg_normalize_arch(cfg_env("SIMPLE_TARGET_CPU"))
    if forced != "":
        return forced

    val from_id = cfg_normalize_arch(cfg_env("PROCESSOR_IDENTIFIER"))
    if from_id != "":
        return from_id

    cfg_detect_arch()

fn cfg_eval_key_value(key_raw: text, value_raw: text) -> bool:
    val key = cfg_strip_quotes(key_raw).trim()
    val value = cfg_strip_quotes(value_raw).trim()

    if key == "os" or key == "platform" or key == "target_os":
        if value == "none" or value == "baremetal":
            return cfg_detect_os() == "none"
        val expected = cfg_normalize_os(value)
        if expected == "unix":
            return cfg_os_is_unix(cfg_detect_os())
        return expected != "" and cfg_detect_os() == expected
    if key == "family" or key == "target_family":
        if value == "unix":
            return cfg_os_is_unix(cfg_detect_os())
        if value == "windows":
            return cfg_detect_os() == "windows"
        return false
    if key == "arch" or key == "target_arch":
        val expected = cfg_normalize_arch(value)
        return expected != "" and cfg_detect_arch() == expected
    if key == "cpu":
        val expected = cfg_normalize_arch(value)
        return expected != "" and cfg_detect_cpu() == expected
    if key == "feature":
        return false

    false
