# Core Simple — Lexer (Tokenizer)
#
# Shared core library: converts source text into a stream of tokens.
# Handles indentation tracking, literals, identifiers, keywords,
# operators, delimiters, and comments.
#
# Design: All state in module-level vars. Functions modify state.
# Works when compiled to C; NOT in the interpreter (closure bug).
#
# Split into modules:
#   lexer_scanners.spl — all scanning functions (number, string, ident,
#                        whitespace, indentation, main token scanner)

val _NL: text = "\n"
use compiler.core.tokens.{keyword_lookup}
use compiler.core.lexer_chars.{is_digit, is_hex_digit, is_alpha, is_ident_char, is_space}
use compiler.core.lexer_types.{Token, Span, lex_span_new, lex_token_new, lex_token_eof}
use std.string_core.{char_code, char_from_code}
use compiler.frontend.core.lexer_struct.{CoreLexer, make_core_lexer, core_lexer_next_token, core_lexer_token_text, core_lexer_token_line, core_lexer_token_col}
use compiler.frontend.core.lexer_struct.{core_lexer_last_text_get, core_lexer_last_line_get, core_lexer_last_col_get}
use compiler.core.ast.{module_get_path}
use compiler.core.ast.{lexer_core_pos_get, lexer_core_pos_set, lexer_core_line_get, lexer_core_line_set}
use compiler.core.ast.{lexer_core_col_get, lexer_core_col_set, lexer_core_pending_dedents_get, lexer_core_pending_dedents_set}
use compiler.core.ast.{lexer_core_at_line_start_get, lexer_core_at_line_start_set, lexer_core_paren_depth_get, lexer_core_paren_depth_set}
use compiler.core.ast.{lexer_core_cur_kind_get, lexer_core_cur_kind_set, lexer_core_cur_text_get, lexer_core_cur_text_set}
use compiler.core.ast.{lexer_core_cur_line_get, lexer_core_cur_line_set, lexer_core_cur_col_get, lexer_core_cur_col_set}
use compiler.core.ast.{lexer_core_indent_stack_get, lexer_core_indent_stack_set}
use compiler.core.ast.{lexer_cur_kind2_get, lexer_cur_kind2_set, lexer_cur_text2_get, lexer_cur_text2_set}
use compiler.core.ast.{lexer_cur_line2_get, lexer_cur_line2_set, lexer_cur_col2_get, lexer_cur_col2_set}
use compiler.core.ast.{lexer_cur_suffix2_get, lexer_cur_suffix2_set}
@unsafe(reason: "raw owned tagged-array release ABI", capabilities: [ffi])
extern fn rt_array_free(array: i64)

export use compiler.frontend.lexer_types.{TokenKind}

# Light wrapper struct to satisfy callers expecting a Lexer value.
struct Lexer:
    dummy: i64

struct LexSourceBuffer:
    content: text

# ===== Lexer State =====

var lex_state: {text: text} = {}
var lex_source_char_count_slot: [i64] = [0]
var lex_source_code_base_slot: [i64] = [0]
var lex_source_codes: [i64] = []
# `CoreLexer` owns several aggregate buffers (the codepoint source view and
# indentation stacks).  Keeping that struct inside a one-element module array
# made the array element outlive a parser reset in Stage 3; the next parse
# could dereference its stale aggregate payload.  Keep the lexer as the
# module's direct owner instead, and use this scalar solely to distinguish an
# uninitialized/released owner from a live lexer.  This preserves the existing
# one-build-per-source fast path without a reset-crossing aggregate wrapper.
var current_core_lexer: CoreLexer = make_core_lexer("")
var current_core_lexer_live: bool = false
var lex_env_save_enabled: [bool] = [false]
var lex_generic_close_pending: [bool] = [false]
# One-shot latch so the dead-lexer diagnostic in lex_next() is reported once
# per process instead of once per token (the failure mode being guarded is
# precisely an unbounded per-token print).
var lex_dead_reported: [bool] = [false]
var lex_cur_kind_direct: [i64] = [0]
var lex_cur_text_direct: [text] = [""]
var lex_cur_line_direct: [i64] = [0]
var lex_cur_col_direct: [i64] = [0]
var lex_cur_suffix_direct: [text] = [""]
var lex_token_start_direct: [i64] = [0]
var lex_token_end_direct: [i64] = [0]
var lex_cur_no_interp_direct: [bool] = [false]

# ===== Public wrapper API =====

fn lexer_new(source: text) -> Lexer:
    # Initialize global lexer state for the given source and return a thin handle.
    lex_init(source)
    Lexer(dummy: 0)

fn lexer_next_token(self: Lexer) -> Token:
    # Advance the global lexer and build a Token record.
    val kind: i64 = lex_next()
    val text = lex_token_text()
    val line = lex_token_line()
    val col = lex_token_col()
    val span = lex_span_new(0, text.len(), line, col)
    Token(kind: kind, span: span, text: text)

impl Lexer:
    static fn new(source: text) -> Lexer:
        lexer_new(source)

# ===== Lexer Init/State Access =====

fn lex_init(source: text):
    lexer_prepare_persistent_globals()
    lex_init_with_path(source, "")

fn lexer_prepare_persistent_globals():
    """Allocate process-lifetime lexer owners before transient parsing."""
    core_lexer_prepare_persistent_globals()
    if lex_state == nil:
        lex_state = {}
    if lex_source_char_count_slot == nil or lexer_array_len(lex_source_char_count_slot) == 0:
        lex_source_char_count_slot = [0]
    if lex_source_code_base_slot == nil or lexer_array_len(lex_source_code_base_slot) == 0:
        lex_source_code_base_slot = [0]
    if lex_source_codes == nil:
        lex_source_codes = []
    if detached_core_lexer_slot == nil or lexer_array_len(detached_core_lexer_slot) == 0:
        detached_core_lexer_slot = [make_core_lexer("")]
    if current_core_lexer_slot == nil or lexer_array_len(current_core_lexer_slot) == 0:
        current_core_lexer_slot = [detached_core_lexer_slot[0]]
    if lex_env_save_enabled == nil or lexer_array_len(lex_env_save_enabled) == 0:
        lex_env_save_enabled = [false]
    if lex_generic_close_pending == nil or lexer_array_len(lex_generic_close_pending) == 0:
        lex_generic_close_pending = [false]
    if lex_dead_reported == nil or lexer_array_len(lex_dead_reported) == 0:
        lex_dead_reported = [false]
    if lex_cur_kind_direct == nil or lexer_array_len(lex_cur_kind_direct) == 0:
        lex_cur_kind_direct = [0]
    if lex_cur_text_direct == nil or lexer_array_len(lex_cur_text_direct) == 0:
        lex_cur_text_direct = [""]
    if lex_inline_source_slot == nil or lexer_array_len(lex_inline_source_slot) == 0:
        lex_inline_source_slot = [""]
    if lex_cur_line_direct == nil or lexer_array_len(lex_cur_line_direct) == 0:
        lex_cur_line_direct = [0]
    if lex_cur_col_direct == nil or lexer_array_len(lex_cur_col_direct) == 0:
        lex_cur_col_direct = [0]
    if lex_cur_suffix_direct == nil or lexer_array_len(lex_cur_suffix_direct) == 0:
        lex_cur_suffix_direct = [""]
    if lexer_array_len(lex_token_start_direct) == 0:
        lex_token_start_direct = [0]
    if lex_token_end_direct == nil or lexer_array_len(lex_token_end_direct) == 0:
        lex_token_end_direct = [0]
    if lex_cur_no_interp_direct == nil or lexer_array_len(lex_cur_no_interp_direct) == 0:
        lex_cur_no_interp_direct = [false]
    if lex_all_kinds == nil:
        lex_all_kinds = []
    if lex_all_texts == nil:
        lex_all_texts = []
    if lex_all_lines == nil:
        lex_all_lines = []
    if lex_all_cols == nil:
        lex_all_cols = []

fn lexer_persistent_globals_ready() -> bool:
    (lex_state != nil and
        lex_source_codes != nil and
        lexer_array_len(lex_source_char_count_slot) > 0 and
        lexer_array_len(lex_source_code_base_slot) > 0 and
        lexer_array_len(detached_core_lexer_slot) > 0 and
        lexer_array_len(current_core_lexer_slot) > 0 and
        lexer_array_len(lex_env_save_enabled) > 0 and
        lexer_array_len(lex_generic_close_pending) > 0 and
        lexer_array_len(lex_dead_reported) > 0 and
        lexer_array_len(lex_cur_kind_direct) > 0 and
        lexer_array_len(lex_cur_text_direct) > 0 and
        lexer_array_len(lex_inline_source_slot) > 0 and
        lexer_array_len(lex_cur_line_direct) > 0 and
        lexer_array_len(lex_cur_col_direct) > 0 and
        lexer_array_len(lex_cur_suffix_direct) > 0 and
        lexer_array_len(lex_token_start_direct) > 0 and
        lexer_array_len(lex_token_end_direct) > 0 and
        lexer_array_len(lex_cur_no_interp_direct) > 0)

fn lex_init_with_path(source: text, source_path: text):
    # Shells are prepared by the direct entry or by the streaming driver before
    # its scope begins.  Never repair a missing shell here: doing so would make
    # the process-global owner itself part of the per-file scope.
    if not lexer_persistent_globals_ready():
        eprint("[lexer_fatal] persistent lexer owner was not prepared")
        return
    lex_env_save_enabled[0] = (rt_env_get("SIMPLE_BOOTSTRAP_LEX_ENV_SAVE") ?? "") == "1"
    lex_generic_close_pending[0] = false
    core_token_env_save_set(lex_env_save_enabled[0])
    # Keep the active lexer on the exact caller source. Rereading a non-empty
    # source from disk can differ from preprocessed or generated text.
    var core_source = source
    if core_source == "" and source_path != "":
        core_source = file_read_nullable(source_path) ?? ""
        # Fail-closed: a NAMED source file that reaches the lexer as empty text
        # is the "reads every source as empty" failure. Silently lexing "" then
        # yields an immediate EOF (or, with the pre-2026-08-09 kind-0 read-back
        # bug, an unbounded parser-error loop) and the compile reports a
        # meaningless location. Say so once, loudly, naming the path.
        if core_source == "":
            eprint("[lexer_fatal] empty source handed to lexer for path '{source_path}' (in-memory source was empty and the file re-read produced no bytes)")
    lex_dead_reported[0] = false
    lex_inline_source_slot[0] = core_source
    if env_value_nul_free(core_source):
        rt_env_set("SIMPLE_BOOTSTRAP_LEX_SOURCE", core_source)
    if env_value_nul_free(source_path):
        env_set("SIMPLE_BOOTSTRAP_LEX_PATH", source_path)
    lex_state_set("pos", "0")
    lex_state_set("core_pos", "0")
    lex_state_set("line", "1")
    lex_state_set("core_line", "1")
    lex_state_set("col", "1")
    lex_state_set("core_col", "1")
    lex_state_set("pending_dedents", "0")
    lex_state_set("core_pending_dedents", "0")
    lex_state_set("at_line_start", "1")
    lex_state_set("core_at_line_start", "1")
    lex_state_set("paren_depth", "0")
    lex_state_set("round_paren_depth", "0")
    lex_state_set("core_paren_depth", "0")
    lex_state_set("core_cur_kind", "0")
    lex_state_set("core_cur_text", "")
    lex_state_set("core_cur_line", "0")
    lex_state_set("core_cur_col", "0")
    lex_state_set("core_indent_stack", "0")
    lex_state_set("indent_stack", "0")
    lex_state_set("indent_count", "1")
    lex_cur_kind_set(0)
    lex_cur_text_set("")
    lex_cur_line_set(0)
    lex_cur_col_set(0)
    lex_cur_suffix_set("")
    # Replace the direct owner at every source boundary.  Do not reuse the
    # previous CoreLexer: its aggregate source/indent buffers belong only to
    # the preceding parse.
    current_core_lexer = make_core_lexer(core_source)
    current_core_lexer_live = true
    current_core_lexer_reset_file()

fn lex_state_get(key: text, fallback: text) -> text:
    rt_env_get("SIMPLE_BOOTSTRAP_STATE_{key}") ?? fallback

fn lex_state_set(key: text, value: text):
    if env_value_nul_free(value):
        rt_env_set("SIMPLE_BOOTSTRAP_STATE_{key}", value)

fn lex_source_len() -> i64:
    current_core_source_get().len()

fn lex_source_char_at(pos: i64) -> text:
    # Bug: cur_start/pos (CoreLexer, lexer_struct.spl) are CODEPOINT indices
    # into source.chars() (self.source_chars), but this used to slice the
    # raw `text` value directly (`source[pos:pos+1]`). Simple's `text[a:b]`
    # slicing on this engine is BYTE-indexed, so any multi-byte UTF-8
    # character (e.g. an em-dash "-" in a comment) preceding `pos` made every
    # subsequent codepoint-index read land on the WRONG character -- silently
    # misclassifying a normal double-quoted interpolating string as
    # no-interpolation (str_first read as some mid-token letter instead of
    # the opening quote), which suppressed string-interpolation lowering
    # entirely for that literal. Route through the CoreLexer's own
    # codepoint-indexed source_chars array (same basis as cur_start/pos)
    # instead of re-slicing the raw byte-indexed text.
    if current_core_lexer_slot.len() > 0:
        val lx = current_core_lexer_slot[0]
        return lx.char_at_pos(pos)
    val source = current_core_source_get()
    val source_len = source.len()
    if pos < 0 or pos >= source_len:
        return ""
    source[pos:pos + 1]

fn lex_source_slice(start: i64, end: i64) -> text:
    # See lex_source_char_at: keep the same codepoint-indexed basis as
    # cur_start/pos when a CoreLexer is active.
    if current_core_lexer_slot.len() > 0:
        val lx = current_core_lexer_slot[0]
        return lx.char_slice(start, end)
    val source = current_core_source_get()
    if start < 0:
        start = 0
    val source_len = source.len()
    if end > source_len:
        end = source_len
    if end <= start:
        return ""
    source[start:end]

fn lex_source_set(value: text):
    val source_len = value.len()
    lex_source_code_base_slot[0] = lex_source_codes.len()
    var pos = 0
    while pos < source_len:
        lex_source_codes.push(char_code(value[pos:pos + 1]))
        pos = pos + 1
    lex_source_char_count_slot[0] = source_len

fn lex_pos_get() -> i64:
    lex_state_get("pos", "0").to_int()

    Call at each per-file scope boundary after parsing/conversion no longer
    needs the source graph.  The AST owns copied lexemes, while these globals
    otherwise retain the original source (or its preprocessed form) through
    the active CoreLexer, inline source slot, and legacy character-code buffer.
    """
    # The direct owner may retain the source through its codepoint buffer.
    # Replace it before clearing the source mirror, then mark it unavailable
    # so a later caller reconstructs a fresh owner from the explicit state.
    current_core_lexer = make_core_lexer("")
    current_core_lexer_live = false
    lex_inline_source_slot = [""]
    lex_source_codes = []
    lex_source_char_count_slot = [0]
    lex_source_code_base_slot = [0]
    env_set("SIMPLE_BOOTSTRAP_LEX_SOURCE", "")
    env_set("SIMPLE_BOOTSTRAP_LEX_PATH", "")

fn lex_cur_kind_get_slot() -> i64:
    lex_cur_kind_direct[0]

fn lex_cur_kind_set(value: i64):
    lex_cur_kind_direct[0] = value
    if lex_env_save_enabled[0]:
        rt_env_set("SIMPLE_BOOTSTRAP_LEX_CUR_KIND", "{value}")

fn lex_cur_line_get_slot() -> i64:
    lex_cur_line_direct[0]

fn lex_cur_line_set(value: i64):
    lex_cur_line_direct[0] = value
    if lex_env_save_enabled[0]:
        rt_env_set("SIMPLE_BOOTSTRAP_LEX_CUR_LINE", "{value}")

fn lex_cur_col_get_slot() -> i64:
    lex_cur_col_direct[0]

fn lex_cur_col_set(value: i64):
    lex_cur_col_direct[0] = value
    if lex_env_save_enabled[0]:
        rt_env_set("SIMPLE_BOOTSTRAP_LEX_CUR_COL", "{value}")

fn lex_cur_text_get_slot() -> text:
    if lex_cur_kind_direct[0] == 3:
        return lex_cur_text_direct[0]
    if lex_cur_text_direct[0] == "" and current_core_lexer_slot != nil and current_core_lexer_slot.len() > 0:
        val lx = current_core_lexer_slot[0]
        val start = lex_token_start_direct[0]
        val end = lex_token_end_direct[0]
        val kind = lex_cur_kind_direct[0]
        if start >= 0 and end > start and end <= lx.source.len() and kind != 180 and kind != 181 and kind != 182 and kind != 190:
            return lx.source[start:end]
    lex_cur_text_direct[0]

fn lex_cur_text_set(value: text):
    lex_cur_text_direct[0] = value
    if lex_env_save_enabled[0]:
        val nul = char_from_code(0)
        if value.contains(nul):
            rt_env_set("SIMPLE_BOOTSTRAP_LEX_CUR_TEXT", "")
        else:
            rt_env_set("SIMPLE_BOOTSTRAP_LEX_CUR_TEXT", value)

fn lex_cur_suffix_get_slot() -> text:
    lex_cur_suffix_direct[0]

fn lex_cur_suffix_set(value: text):
    lex_cur_suffix_direct[0] = value
    if lex_env_save_enabled[0]:
        rt_env_set("SIMPLE_BOOTSTRAP_LEX_CUR_SUFFIX", value)

fn lex_token_start_get() -> i64:
    if lex_token_start_direct.len() > 0:
        return lex_token_start_direct[0]
    lex_env_i64("SIMPLE_BOOTSTRAP_LEX_TOKEN_START", 0)

fn lex_token_end_get() -> i64:
    if lex_token_end_direct.len() > 0:
        return lex_token_end_direct[0]
    lex_env_i64("SIMPLE_BOOTSTRAP_LEX_TOKEN_END", 0)

fn lex_cur_no_interp_get() -> bool:
    if lexer_array_len(lex_cur_no_interp_direct) > 0:
        return lex_cur_no_interp_direct[0]
    false

fn lex_env_i64(key: text, fallback: i64) -> i64:
    val raw = rt_env_get(key) ?? ""
    if raw == "":
        return fallback
    raw.to_int()

fn current_core_indent_stack_get() -> [i64]:
    val raw = lex_state_get("core_indent_stack", "0")
    if raw == "" or raw == nil:
        return [0]
    var result: [i64] = []
    for part in raw.split(","):
        if part == "":
            continue
        result = result.push(part.to_int())
    if result.len() == 0:
        return [0]
    result

fn current_core_indent_stack_set(values: [i64]):
    var parts: [text] = []
    for value in values:
        parts = parts.push("{value}")
    if parts.len() == 0:
        lex_state_set("core_indent_stack", "0")
        return
    lex_state_set("core_indent_stack", parts.join(","))

fn current_core_source_get() -> text:
    # Guest-first: the module-global slot persists where the env var does not.
    if lex_inline_source_slot.len() > 0 and lex_inline_source_slot[0] != "":
        return lex_inline_source_slot[0]
    val inline_source = rt_env_get("SIMPLE_BOOTSTRAP_LEX_SOURCE") ?? ""
    if inline_source != "":
        return inline_source
    val source_path = rt_env_get("SIMPLE_BOOTSTRAP_LEX_PATH") ?? module_get_path()
    if source_path != "":
        val content = rt_file_read_text(source_path) ?? ""
        return content
    ""

fn current_core_indent_stack_parse(raw: text) -> [i64]:
    if raw == "" or raw == nil:
        return [0]
    var result: [i64] = []
    for part in raw.split(","):
        if part == "":
            continue
        result = result.push(part.to_int())
    if result.len() == 0:
        return [0]
    result

fn current_core_indent_stack_format(values: [i64]) -> text:
    if values.len() == 0:
        return "0"
    var result = "{values[0]}"
    var i = 1
    while i < values.len():
        result = result + "," + "{values[i]}"
        i = i + 1
    result

fn current_core_lexer_load() -> CoreLexer:
    var pos = 0
    var line = 1
    var col = 1
    var pending_dedents = 0
    var at_line_start = true
    var paren_depth = 0
    var indent_stack_raw = "0"
    val raw_pos = rt_env_get("SIMPLE_BOOTSTRAP_LEX_POS") ?? ""
    val raw_line = rt_env_get("SIMPLE_BOOTSTRAP_LEX_LINE") ?? ""
    val raw_col = rt_env_get("SIMPLE_BOOTSTRAP_LEX_COL") ?? ""
    val raw_pending = rt_env_get("SIMPLE_BOOTSTRAP_LEX_PENDING") ?? ""
    val raw_line_start = rt_env_get("SIMPLE_BOOTSTRAP_LEX_LINE_START") ?? ""
    val raw_paren = rt_env_get("SIMPLE_BOOTSTRAP_LEX_PAREN") ?? ""
    val raw_indent = rt_env_get("SIMPLE_BOOTSTRAP_LEX_INDENT") ?? ""
    if raw_pos != "":
        pos = raw_pos.to_int()
    if raw_line != "":
        line = raw_line.to_int()
    if raw_col != "":
        col = raw_col.to_int()
    if raw_pending != "":
        pending_dedents = raw_pending.to_int()
    if raw_line_start != "":
        at_line_start = raw_line_start == "1"
    if raw_paren != "":
        paren_depth = raw_paren.to_int()
    if raw_indent != "":
        indent_stack_raw = raw_indent
    val source = current_core_source_get()
    var lexer = make_core_lexer(source)
    lexer.pos = pos
    lexer.line = line
    lexer.col = col
    lexer.indent_stack = current_core_indent_stack_parse(indent_stack_raw)
    lexer.pending_dedents = pending_dedents
    lexer.at_line_start = at_line_start
    lexer.paren_depth = paren_depth
    lexer.cur_kind = 0
    lexer.cur_text = ""
    lexer.cur_line = 0
    lexer.cur_col = 0
    lexer.cur_start = pos
    lexer

fn current_core_lexer_save(lexer: CoreLexer):
    if not lex_env_save_enabled[0]:
        return
    rt_env_set("SIMPLE_BOOTSTRAP_LEX_POS", "{lexer.pos}")
    rt_env_set("SIMPLE_BOOTSTRAP_LEX_LINE", "{lexer.line}")
    rt_env_set("SIMPLE_BOOTSTRAP_LEX_COL", "{lexer.col}")
    rt_env_set("SIMPLE_BOOTSTRAP_LEX_PENDING", "{lexer.pending_dedents}")
    if lexer.at_line_start:
        rt_env_set("SIMPLE_BOOTSTRAP_LEX_LINE_START", "1")
    else:
        rt_env_set("SIMPLE_BOOTSTRAP_LEX_LINE_START", "0")
    rt_env_set("SIMPLE_BOOTSTRAP_LEX_PAREN", "{lexer.paren_depth}")
    rt_env_set("SIMPLE_BOOTSTRAP_LEX_INDENT", "0")

fn current_core_lexer_reset_file():
    rt_env_set("SIMPLE_BOOTSTRAP_LEX_POS", "0")
    rt_env_set("SIMPLE_BOOTSTRAP_LEX_LINE", "1")
    rt_env_set("SIMPLE_BOOTSTRAP_LEX_COL", "1")
    rt_env_set("SIMPLE_BOOTSTRAP_LEX_PENDING", "0")
    rt_env_set("SIMPLE_BOOTSTRAP_LEX_LINE_START", "1")
    rt_env_set("SIMPLE_BOOTSTRAP_LEX_PAREN", "0")
    rt_env_set("SIMPLE_BOOTSTRAP_LEX_INDENT", "0")

fn lex_next_token_record() -> Token:
    val kind = lex_next()
    val text = lex_cur_text_get_slot()
    val line = lex_cur_line_get_slot()
    val col = lex_cur_col_get_slot()
    val span = lex_span_new(0, text.len(), line, col)
    Token(kind: kind, span: span, text: text)

fn lex_indent_stack_len() -> i64:
    lex_indent_count_get()

fn lex_indent_stack_top() -> i64:
    val stack_text = lex_state_get("indent_stack", "0")
    if stack_text == "" or stack_text == nil:
        return 0
    val parts = stack_text.split(",")
    if parts.len() <= 0:
        return 0
    parts[parts.len() - 1].to_int()

fn lex_indent_stack_push(value: i64):
    lex_state_set("indent_stack", lex_state_get("indent_stack", "0") + "," + "{value}")
    lex_indent_count_set(lex_indent_count_get() + 1)

fn lex_indent_stack_pop() -> i64:
    val stack_text = lex_state_get("indent_stack", "0")
    if stack_text == "" or stack_text == nil:
        return 0
    val parts = stack_text.split(",")
    if parts.len() <= 1:
        val value = stack_text.to_int()
        lex_state_set("indent_stack", "")
        lex_indent_count_set(0)
        return value
    val value = parts[parts.len() - 1].to_int()
    var new_parts: [text] = []
    var i = 0
    while i < parts.len() - 1:
        new_parts = new_parts.push(parts[i])
        i = i + 1
    lex_state_set("indent_stack", new_parts.join(","))
    lex_indent_count_set(lex_indent_count_get() - 1)
    value

fn lex_at_end() -> bool:
    lex_pos_get() >= lex_source_len()

fn lex_peek() -> text:
    val pos = lex_pos_get()
    lex_source_char_at(pos)

fn lex_peek_next() -> text:
    val next_pos: i64 = lex_pos_get() + 1
    lex_source_char_at(next_pos)

fn lex_peek_at(offset: i64) -> text:
    val target: i64 = lex_pos_get() + offset
    lex_source_char_at(target)

fn lex_advance() -> text:
    val pos = lex_pos_get()
    if pos >= lex_source_len():
        return ""
    val c: text = lex_source_char_at(pos)
    lex_pos_set(pos + 1)
    if c == _NL:
        lex_line_set(lex_line_get() + 1)
        lex_col_set(1)
        lex_at_line_start_set(true)
    else:
        lex_col_set(lex_col_get() + 1)
    c

fn lex_match_char(expected: text) -> bool:
    val pos = lex_pos_get()
    if pos >= lex_source_len():
        return false
    if lex_source_char_at(pos) != expected:
        return false
    lex_pos_set(pos + 1)
    lex_col_set(lex_col_get() + 1)
    true

# ===== Token Construction =====

fn lex_make_token(kind: i64, token_text: text, start_line: i64, start_col: i64):
    lex_cur_kind_set(kind)
    lex_cur_text_set(token_text)
    lex_cur_line_set(start_line)
    lex_cur_col_set(start_col)

fn lex_make_simple(kind: i64, token_text: text):
    lex_make_token(kind, token_text, lex_line_get(), lex_col_get())

fn lex_scan_token_local():
    if lex_at_end():
        val slen: i64 = lex_indent_stack_len()
        if slen > 1:
            lex_indent_stack_pop()
            lex_pending_dedents_set(slen - 2)
            lex_make_token(182, "", lex_line_get(), lex_col_get())
            return
        lex_make_token(190, "", lex_line_get(), lex_col_get())
        return

    if lex_at_line_start_get():
        if lex_round_paren_depth_get() > 0:
            lex_at_line_start_set(false)
            lex_skip_spaces()
            lex_scan_token_local()
            return
        lex_cur_kind_set(0)
        lex_handle_indentation()
        if lex_cur_kind_get_slot() != 0:
            return
        lex_scan_token_local()
        return

    lex_skip_spaces()

    if lex_at_end():
        val slen: i64 = lex_indent_stack_len()
        if slen > 1:
            lex_indent_stack_pop()
            lex_pending_dedents_set(slen - 2)
            lex_make_token(182, "", lex_line_get(), lex_col_get())
            return
        lex_make_token(190, "", lex_line_get(), lex_col_get())
        return

    val start_line: i64 = lex_line_get()
    val start_col: i64 = lex_col_get()
    val c: text = lex_peek()

    if c == _NL:
        lex_advance()
        lex_at_line_start_set(true)
        if lex_round_paren_depth_get() > 0:
            lex_scan_token_local()
            return
        lex_make_token(180, _NL, start_line, start_col)
        return

    if c == "#":
        for i in 0..100000:
            val cc: text = lex_peek()
            val done: bool = cc == _NL or cc == ""
            if done:
                break
            lex_advance()
        lex_scan_token_local()
        return

    val is_dquote: bool = c == "\""
    val is_squote: bool = c == "'"
    if is_dquote:
        lex_scan_string()
        return
    if is_squote:
        val after_quote: text = lex_peek_next()
        val is_label: bool = is_alpha(after_quote) or after_quote == "_"
        if is_label:
            lex_advance()
            val label_start: i64 = lex_pos_get()
            for li in 0..1000:
                val lc: text = lex_peek()
                if is_ident_char(lc):
                    lex_advance()
                else:
                    break
            val label_name: text = lex_source_slice(label_start, lex_pos_get())
            lex_make_token(192, label_name, start_line, start_col)
            return
        lex_scan_string()
        return

    if is_digit(c):
        lex_scan_number()
        return

    val starts_ident: bool = is_alpha(c) or c == "_"
    if starts_ident:
        lex_scan_ident()
        return

    lex_advance()
    if c == "=":
        if lex_match_char("="):
            lex_make_token(80, "==", start_line, start_col)
        elif lex_match_char(">"):
            lex_make_token(168, "=>", start_line, start_col)
        else:
            lex_make_token(100, "=", start_line, start_col)
        return

    if c == "!":
        if lex_match_char("="):
            lex_make_token(81, "!=", start_line, start_col)
        else:
            lex_make_token(57, "!", start_line, start_col)
        return

    if c == "<":
        if lex_match_char("<"):
            lex_make_token(66, "<<", start_line, start_col)
        elif lex_match_char("="):
            lex_make_token(84, "<=", start_line, start_col)
        else:
            lex_make_token(82, "<", start_line, start_col)
        return

    if c == ">":
        if lex_match_char(">"):
            lex_make_token(67, ">>", start_line, start_col)
        elif lex_match_char("="):
            lex_make_token(85, ">=", start_line, start_col)
        else:
            lex_make_token(83, ">", start_line, start_col)
        return

    if c == "\\":
        lex_make_token(220, "\\", start_line, start_col)
        return

    lex_make_token(191, c, start_line, start_col)

# ===== Public API =====

fn lex_next() -> i64:
    if lexer_array_len(current_core_lexer_slot) == 0:
        return 190
    var loaded = current_core_lexer_slot[0]
    if lex_generic_close_pending[0]:
        lex_generic_close_pending[0] = false
        # next_token_after_generic_close() only clears the prior token before
        # scanning. Clear it on the value that crosses the explicit state
        # handoff below so a receiver temporary cannot lose the update.
        loaded.cur_kind = 0
    # CoreLexer is a value-type struct. Carry BOTH the updated lexer and token
    # kind across the function boundary, then rebind the owner slot.
    val scan_result = core_lexer_next_token(loaded)
    loaded = scan_result[0]
    # The Stage-2 seed used to copy mutable struct receivers on every method
    # entry. Returning only a token kind therefore could not preserve the
    # updated position/text state. The explicit tuple handoff above returns the
    # updated CoreLexer value and the kind, and this owner rebinds both.
    # See doc/08_tracking/bug/stage2_binary_lexer_reads_every_source_as_empty_infinite_parser_loop_2026-08-09.md.
    var kind: i64 = scan_result[1]
    # Fail-closed invariant: scan_token()/next_token() ALWAYS route through
    # make_token(), which never emits kind 0 (0 is only the CoreLexer
    # constructor default). Observing 0 here means the lexer state was lost or
    # the scan never ran -- a dead lexer. Terminate the token stream with EOF
    # and a loud one-shot diagnostic instead of handing the parser an
    # unconsumable token forever.
    if kind == 0:
        if not lex_dead_reported[0]:
            lex_dead_reported[0] = true
            val dead_path = env_get_nullable("SIMPLE_BOOTSTRAP_LEX_PATH") ?? ""
            val dead_line = core_lexer_last_line_get()
            val dead_col = core_lexer_last_col_get()
            val dead_len = current_core_source_get().len()
            eprint("[lexer_fatal] dead lexer: next_token() produced kind 0 (never a valid token kind) for path '{dead_path}' at line {dead_line} col {dead_col}; source length {dead_len}. Terminating token stream at EOF.")
        kind = 190
    current_core_lexer_slot[0] = loaded
    current_core_lexer_save(loaded)
    lex_cur_kind_set(kind)
    var token_text = loaded.cur_text
    if token_text == "" and loaded.cur_start >= 0 and loaded.pos >= loaded.cur_start:
        token_text = loaded.source[loaded.cur_start:loaded.pos]
        if kind == 180 or kind == 181 or kind == 182 or kind == 190:
            token_text = ""
    rt_env_set("SIMPLE_BOOTSTRAP_LEX_TOKEN_START", "{loaded.cur_start}")
    rt_env_set("SIMPLE_BOOTSTRAP_LEX_TOKEN_END", "{loaded.pos}")
    lex_cur_text_direct[0] = token_text
    val nul = char_from_code(0)
    if token_text.contains(nul):
        rt_env_set("SIMPLE_BOOTSTRAP_LEX_CUR_TEXT", "")
    else:
        lex_cur_kind_direct[0] = kind
        if kind == 7 or kind == 8:
            lex_cur_suffix_direct[0] = core_lexer_last_suffix_get()
        else:
            lex_cur_suffix_direct[0] = ""
    lex_token_start_direct[0] = loaded.cur_start
    lex_token_end_direct[0] = loaded.pos
    if env_save:
        rt_env_set("SIMPLE_BOOTSTRAP_LEX_TOKEN_START", "{loaded.cur_start}")
        rt_env_set("SIMPLE_BOOTSTRAP_LEX_TOKEN_END", "{loaded.pos}")
    if env_save:
        lex_cur_text_set(loaded.cur_text)
        lex_cur_line_set(core_lexer_last_line_get())
        lex_cur_col_set(core_lexer_last_col_get())
    else:
        lex_cur_suffix_set("")
    lex_cur_text_set(loaded.cur_text)
    lex_cur_line_set(core_lexer_last_line_get())
    lex_cur_col_set(core_lexer_last_col_get())
    kind

# The parser calls this after recognizing `>` as a generic type close. Without
# the handoff, CoreLexer still classifies the current token as the binary `>`
# operator when it scans the following newline, so token_requires_rhs suppresses
# the structural newline/dedent and the next top-level declaration is parsed as
# a member of the preceding owner.
fn lex_mark_current_token_as_generic_close():
    if lexer_array_len(lex_generic_close_pending) > 0:
        lex_generic_close_pending[0] = true

# ===== Live position accessors (bypass the dead legacy `lex_state` slot) =====
#
# The old `lex_pos_get`/`lex_pos_set`/`lex_line_get`/`lex_line_set`/
# `lex_col_get`/`lex_col_set` wrappers read/wrote
# `lex_state_get/set("pos"|"line"|"col", ...)` -- a store that
# CoreLexer.next_token() (lexer_struct.spl) never writes to. Callers of
# those accessors (e.g. the raw-brace asm scanner,
# _ParserPrimary/asm_raw_parsing.spl) were silently reading a permanently
# stale position (observed stuck at its "0"/"1" fallback), producing
# "unterminated asm { ... } block" on real input. The wrappers themselves
# had zero remaining callers by 2026-07-30 (LEXD orphaned-accessor-deletion,
# see doc/08_tracking/bug/lexer_position_unification_2026-07-29.md) and
# were removed. `lex_token_end_get()` already exposes the live struct's
# `pos` (set from `loaded.pos` in `lex_next()` above); the two getters
# below expose the matching live `line`/`col`, and `lex_force_set_pos` lets
# a caller that hand-scanned raw
# source (skipping normal tokenization) hand the live position back so the
# next `lex_next()` resumes from the right place.
fn lex_live_line_get() -> i64:
    if lexer_array_len(current_core_lexer_slot) == 0:
        return current_core_lexer_load().line
    current_core_lexer_slot[0].line

fn lex_live_col_get() -> i64:
    if lexer_array_len(current_core_lexer_slot) == 0:
        return current_core_lexer_load().col
    current_core_lexer_slot[0].col

fn lex_force_set_pos(new_pos: i64, new_line: i64, new_col: i64):
    if lexer_array_len(current_core_lexer_slot) == 0:
        return
    var lx = current_core_lexer_slot[0]
    lx.pos = new_pos
    lx.line = new_line
    lx.col = new_col
    current_core_lexer_slot[0] = lx
    current_core_lexer_save(lx)
    lex_token_end_direct[0] = new_pos

# ===== Forced Indentation (block bodies inside call parens) =====
# See CoreLexer.enable_forced_indentation in lexer_struct.spl. The parser
# calls these around a block-bodied `\param:` lambda so its multi-statement
# body gets real NEWLINE/INDENT/DEDENT tokens even while inside a call's `(`.

fn lex_enable_forced_indentation():
    if lexer_array_len(current_core_lexer_slot) == 0:
        return
    var loaded = current_core_lexer_slot[0]
    loaded.enable_forced_indentation()
    current_core_lexer_slot[0] = loaded

fn lex_disable_forced_indentation():
    if lexer_array_len(current_core_lexer_slot) == 0:
        return
    var loaded = current_core_lexer_slot[0]
    loaded.disable_forced_indentation()
    current_core_lexer_slot[0] = loaded

fn lex_pop_indent():
    if lexer_array_len(current_core_lexer_slot) == 0:
        return
    var loaded = current_core_lexer_slot[0]
    loaded.pop_indent()
    current_core_lexer_slot[0] = loaded

# Batched advance for the parser hot loop: one cross-module call instead of
# four (lex_next + lex_token_text + lex_token_line + lex_token_col). Under the
# seed interpreter every cross-module call pays an env-rebuild (~1.4ms), so the
# parser paid it 4x per token here. Keep the return type explicit and
# homogeneous-by-field: native lowering cannot safely infer the ABI of the old
# mixed [i64, i64, i64, text] array expression across this module boundary.
# See doc/08_tracking/bug/lint_timeout_hwir_zca_rows_2026-08-17.md.
pub struct LexNextTokenSnapshot:
    kind: i64
    line: i64
    col: i64
    text: text

pub fn lex_next_snapshot() -> LexNextTokenSnapshot:
    val kind = lex_next()
    return LexNextTokenSnapshot(
        kind: kind,
        line: lex_cur_line_get_slot(),
        col: lex_cur_col_get_slot(),
        text: lex_cur_text_get_slot())

fn lex_token_kind() -> i64:
    lex_cur_kind_get_slot()

fn lex_token_text() -> text:
    lex_cur_text_get_slot()

fn lex_token_line() -> i64:
    lex_cur_line_get_slot()

fn lex_token_col() -> i64:
    lex_cur_col_get_slot()

fn lex_cur_kind_get() -> i64:
    lex_cur_kind_get_slot()

fn lex_cur_text_get() -> text:
    lex_cur_text_get_slot()

fn lex_cur_line_get() -> i64:
    lex_cur_line_get_slot()

fn lex_cur_col_get() -> i64:
    lex_cur_col_get_slot()

fn lex_cur_suffix_get() -> text:
    lex_cur_suffix_get_slot()

# ===== Lexer + Parser Token Snapshot (for speculative parse / backtrack) =====
#
# Saves / restores the full tokenizer position AND the current parser token.
# Used by try_skip_ident_generic_args to backtrack when <…> turns out to be
# a binary less-than rather than a generic-argument list.
#
# The saved state is a flat [i64] with the layout:
#   [0]  CoreLexer.pos          (source byte offset after current token)
#   [1]  CoreLexer.line
#   [2]  CoreLexer.col
#   [3]  CoreLexer.pending_dedents
#   [4]  CoreLexer.at_line_start  (1 = true)
#   [5]  CoreLexer.paren_depth
#   [6]  CoreLexer.cur_start      (start offset of current token in source)
#   [7]  lex_cur_kind_direct[0]  (kind of the token that is "current")
#   [8]  lex_cur_line_direct[0]
#   [9]  lex_cur_col_direct[0]
#   [10] CoreLexer.cur_kind
#   [11] lex_generic_close_pending[0] (1 = pending)
#
# Text fields (par_text, lex_cur_text, suffix) are stored alongside as [text].

struct LexSnapshot:
    nums: [i64]
    texts: [text]
    indent_stack: [i64]

fn lex_snapshot_save() -> LexSnapshot:
    if lexer_array_len(current_core_lexer_slot) == 0:
        lexer_prepare_persistent_globals()
    val lx = current_core_lexer_slot[0]
    var at_ls_i: i64 = 0
    if lx.at_line_start:
        at_ls_i = 1
    var generic_pending_i: i64 = 0
    if lex_generic_close_pending.len() > 0 and lex_generic_close_pending[0]:
        generic_pending_i = 1
    var nums: [i64] = [lx.pos, lx.line, lx.col, lx.pending_dedents, at_ls_i, lx.paren_depth, lx.cur_start, lex_cur_kind_direct[0], lex_cur_line_direct[0], lex_cur_col_direct[0], lx.cur_kind, generic_pending_i]
    var saved_indent_stack: [i64] = []
    for indent in lx.indent_stack:
        saved_indent_stack = saved_indent_stack.push(indent)
    var txts: [text] = [lex_cur_text_direct[0], lex_cur_suffix_direct[0]]
    LexSnapshot(nums: nums, texts: txts, indent_stack: saved_indent_stack)

fn lex_snapshot_restore(snapshot: LexSnapshot):
    # Rebuild the CoreLexer from saved fields
    if lexer_array_len(current_core_lexer_slot) == 0:
        return
    val nums = snapshot.nums
    val txts = snapshot.texts
    var lx = current_core_lexer_slot[0]
    lx.pos = nums[0]
    lx.line = nums[1]
    lx.col = nums[2]
    lx.pending_dedents = nums[3]
    lx.at_line_start = nums[4] == 1
    lx.paren_depth = nums[5]
    lx.cur_start = nums[6]
    if nums.len() > 10:
        lx.cur_kind = nums[10]
    if nums.len() > 11:
        lex_generic_close_pending[0] = nums[11] == 1
    # Restore the independent stack captured by lex_snapshot_save. Speculative
    # restore must not serialize through text or environment-backed state.
    _sffi_array_free(lx.indent_stack)
    lx.indent_stack = snapshot.indent_stack
    current_core_lexer_slot[0] = lx
    # Restore direct slots only. Environment mirrors are synchronized by the
    # explicit lexer boundary paths, never by speculative parser restore.
    val saved_kind = nums[7]
    val saved_line = nums[8]
    val saved_col  = nums[9]
    val saved_text = txts[0]
    var saved_suffix = ""
    if txts.len() > 1:
        saved_suffix = txts[1]
    lex_cur_kind_direct[0] = saved_kind
    lex_cur_line_direct[0] = saved_line
    lex_cur_col_direct[0] = saved_col
    lex_cur_text_direct[0] = saved_text
    lex_cur_suffix_direct[0] = saved_suffix
    lx.cur_text = saved_text
    lx.cur_line = saved_line
    lx.cur_col = saved_col
    current_core_lexer_slot[0] = lx
    # Restore token offsets for lex_token_start/end snapshot consumers.
    lex_token_start_direct[0] = nums[6]
    lex_token_end_direct[0] = nums[0]

fn lex_snapshot_release(snapshot: LexSnapshot, release_indent_stack: bool):
    _sffi_array_free(snapshot.nums)
    _sffi_array_free(snapshot.texts)
    if release_indent_stack:
        _sffi_array_free(snapshot.indent_stack)

fn lex_snapshot_commit(snapshot: LexSnapshot):
    # No lexer transfer occurred: the snapshot owns every array.
    lex_snapshot_release(snapshot, true)

fn lex_snapshot_rollback(snapshot: LexSnapshot):
    # Restore transfers snapshot.indent_stack into CoreLexer. Only the current
    # speculative stack and the remaining snapshot metadata are released.
    lex_snapshot_restore(snapshot)
    lex_snapshot_release(snapshot, false)

# ===== Convenience: Tokenize All =====
# Tokenizes entire source and returns arrays of token data.
# Useful for testing and debugging.

var lex_all_kinds: [i64] = []
var lex_all_texts: [text] = []
var lex_all_lines: [i64] = []
var lex_all_cols: [i64] = []

fn lex_tokenize_all(source: text) -> i64:
    lexer_prepare_persistent_globals()
    lex_init(source)
    lex_all_kinds.clear()
    lex_all_texts.clear()
    lex_all_lines.clear()
    lex_all_cols.clear()

    for i in 0..1000000:
        val kind: i64 = lex_next()
        lex_all_kinds.push(kind)
        lex_all_texts.push(lex_cur_text_get_slot())
        lex_all_lines.push(lex_cur_line_get_slot())
        lex_all_cols.push(lex_cur_col_get_slot())
        if kind == 190:
            break

    lex_all_kinds.len()
