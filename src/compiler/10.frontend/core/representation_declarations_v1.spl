# Invocation-scoped declaration metadata, owned by the canonical flat parser.
# A parsed row is not an admission: package/module identity must be supplied
# by the compile/lint owner before the shared validator may exempt a binding.
use compiler.common.assurance.representation_manifest_v1.{RepresentationManifestV1, RepresentationDeclarationV1}
use compiler.common.diagnostics.span.{Span}
use compiler.semantics.symbol_id.stable_id.{SymbolComponents, stable_symbol_id}
use compiler.core.parser.{par_kind_get, par_text_get, par_line_get, par_col_get, parser_advance, parser_skip_newlines, parse_module_silent_checked}
use compiler.frontend.core.lexer.{lex_token_start_get, lex_source_slice, lex_source_len}
use compiler.core.ast.{EXPR_STRING_LIT, EXPR_IDENT, EXPR_ARRAY_LIT, expr_get_tag, expr_get_str, expr_get_args}
use compiler.frontend.core.parser_expr.{parse_expr}
use compiler.frontend.core._Ast.decl_nodes.{decl_set_span}
use compiler.core.types.{flat_span_new}
use std.common.crypto.sha256.{sha256_text}

struct RepresentationParseFrameV1:
    declaration: RepresentationDeclarationV1
    parent: i64
    cursor: i64

var representation_frames_v1: [RepresentationParseFrameV1] = []
var representation_stack_v1: [i64] = []
var representation_pending_v1: RepresentationManifestV1? = nil
var representation_pending_span_v1: Span = Span.empty()
var representation_pending_errors_v1: [text] = []
var representation_digest_v1: text = ""
var representation_path_v1: text = ""
var representation_checked_complete_v1: bool = false
var representation_checked_failed_v1: bool = false

extern fn rt_transient_heap_promote<T>(value: T) -> bool

pub fn representation_parser_promote_transient_owner_v1() -> bool:
    rt_transient_heap_promote(representation_frames_v1) and
        rt_transient_heap_promote(representation_stack_v1) and
        rt_transient_heap_promote(representation_pending_v1) and
        rt_transient_heap_promote(representation_pending_span_v1) and
        rt_transient_heap_promote(representation_pending_errors_v1) and
        rt_transient_heap_promote(representation_digest_v1) and
        rt_transient_heap_promote(representation_path_v1)

pub fn representation_parser_reset_v1(source: text, path: text):
    representation_frames_v1 = []
    representation_stack_v1 = []
    representation_pending_v1 = nil
    representation_pending_span_v1 = Span.empty()
    representation_pending_errors_v1 = []
    representation_digest_v1 = sha256_text(source)
    representation_path_v1 = path
    representation_checked_complete_v1 = false
    representation_checked_failed_v1 = false

pub fn representation_parser_refuse_restored_metadata_v1():
    # Supported snapshots contain no representation facts. Clear every slot
    # even when a caller restores pools directly without parser_init.
    representation_frames_v1 = []
    representation_stack_v1 = []
    representation_pending_v1 = nil
    representation_pending_span_v1 = Span.empty()
    representation_pending_errors_v1 = []
    representation_checked_complete_v1 = false
    representation_checked_failed_v1 = false

fn representation_token_span_v1(start: i64, line: i64, col: i64) -> Span:
    val ending = lex_token_start_get()
    Span(start: start, end: ending, line: line, col: col,
        file: representation_path_v1, length: ending - start)

fn representation_literal_list_v1(expr: i64, field: text) -> [text]:
    if expr_get_tag(expr) != EXPR_ARRAY_LIT:
        representation_pending_errors_v1.push("{field} must be a literal array")
        return []
    var out: [text] = []
    for element in expr_get_args(expr):
        val tag = expr_get_tag(element)
        if tag == EXPR_STRING_LIT or tag == EXPR_IDENT:
            out.push(expr_get_str(element))
        else:
            representation_pending_errors_v1.push("{field} entries must be literal text or identifiers")
    out

# Called after the existing attribute dispatcher consumed the name. All
# values use the existing expression parser; strings/comments cannot spoof it.
pub fn representation_parse_attribute_v1(start: i64, line: i64, col: i64):
    if representation_pending_v1 != nil:
        representation_pending_errors_v1.push("duplicate @representation_boundary")
    var kind = ""
    var reason = ""
    var reviewers: [text] = []
    var capabilities: [text] = []
    var keys: Dict<text, bool> = {}
    if par_kind_get() != 140:
        representation_pending_errors_v1.push("representation_boundary requires named literal arguments")
    else:
        parser_advance()
        parser_skip_newlines()
        while par_kind_get() != 141 and par_kind_get() != 190:
            val before = lex_token_start_get()
            val key = par_text_get()
            if par_kind_get() != 6:
                representation_pending_errors_v1.push("expected a named manifest field")
                parser_advance()
                continue
            parser_advance()
            if keys.contains_key(key):
                representation_pending_errors_v1.push("duplicate manifest field: {key}")
            keys[key] = true
            if par_kind_get() != 161:
                representation_pending_errors_v1.push("manifest field {key} requires ':'")
                break
            parser_advance()
            val expression = parse_expr()
            if key == "kind" or key == "reason":
                if expr_get_tag(expression) != EXPR_STRING_LIT:
                    representation_pending_errors_v1.push("{key} must be literal text")
                elif key == "kind":
                    kind = expr_get_str(expression)
                else:
                    reason = expr_get_str(expression)
            elif key == "reviewers":
                reviewers = representation_literal_list_v1(expression, key)
            elif key == "capabilities":
                capabilities = representation_literal_list_v1(expression, key)
            else:
                representation_pending_errors_v1.push("unknown manifest field: {key}")
            parser_skip_newlines()
            if par_kind_get() == 160:
                parser_advance()
                parser_skip_newlines()
            elif par_kind_get() != 141:
                representation_pending_errors_v1.push("manifest fields require commas")
                break
            if lex_token_start_get() == before:
                break
        if par_kind_get() == 141:
            parser_advance()
        else:
            representation_pending_errors_v1.push("unterminated representation_boundary")
    for required in ["kind", "reason", "reviewers", "capabilities"]:
        if not keys.contains_key(required):
            representation_pending_errors_v1.push("missing manifest field: {required}")
    representation_pending_v1 = Some(RepresentationManifestV1(
        schema_version: 1, kind: kind, reason: reason,
        reviewers: reviewers, capabilities: capabilities))
    representation_pending_span_v1 = representation_token_span_v1(start, line, col)

pub fn representation_declaration_begin_v1(kind: text) -> i64:
    val start = lex_token_start_get()
    val span = representation_token_span_v1(start, par_line_get(), par_col_get())
    val parent = if representation_stack_v1.len() == 0: -1 else: representation_stack_v1[representation_stack_v1.len() - 1]
    if parent >= 0:
        var enclosing = representation_frames_v1[parent]
        val child_start = if representation_pending_v1 != nil: representation_pending_span_v1.start else: start
        if enclosing.cursor < child_start:
            enclosing.declaration.owned_intervals.push(Span(
                start: enclosing.cursor, end: child_start, line: enclosing.declaration.declaration_span.line,
                col: 1, file: representation_path_v1, length: child_start - enclosing.cursor))
        representation_frames_v1[parent] = enclosing
    val declaration = RepresentationDeclarationV1(
        components: SymbolComponents(package: "", module_path: "", item_kind: kind,
            owner_id: "", name: "", signature: ""),
        declaration_id: "", local_symbol_id: -1, declaration_span: span,
        attribute_span: representation_pending_span_v1, owned_intervals: [],
        source_digest: representation_digest_v1, manifest: representation_pending_v1,
        metadata_errors: representation_pending_errors_v1, region_capabilities: [],
        requires_manifest: false)
    val position = representation_frames_v1.len()
    representation_frames_v1.push(RepresentationParseFrameV1(declaration: declaration, parent: parent, cursor: start))
    representation_stack_v1.push(position)
    representation_pending_v1 = nil
    representation_pending_span_v1 = Span.empty()
    representation_pending_errors_v1 = []
    position

pub fn representation_method_begin_v1() -> i64:
    # A lexical type supplies an exact owner identity. Impl-only references
    # without that owner remain exclusion barriers until owner resolution can
    # bind them; they must never masquerade as top-level methods.
    var lexical_type = false
    if representation_stack_v1.len() > 0:
        val parent = representation_frames_v1[representation_stack_v1[representation_stack_v1.len() - 1]]
        lexical_type = parent.declaration.components.item_kind == "struct" or
            parent.declaration.components.item_kind == "class"
    representation_declaration_begin_v1(if lexical_type: "method" else: "nested_callable")

pub fn representation_declaration_header_v1(position: i64):
    var frame = representation_frames_v1[position]
    frame.declaration.components.signature = lex_source_slice(frame.declaration.declaration_span.start, lex_token_start_get())
    frame.cursor = lex_token_start_get()
    representation_frames_v1[position] = frame

pub fn representation_declaration_end_v1(position: i64, flat_decl: i64, name: text):
    var frame = representation_frames_v1[position]
    val ending = lex_token_start_get()
    frame.declaration.components.name = name
    frame.declaration.local_symbol_id = flat_decl
    if frame.declaration.components.item_kind == "nested_callable" or frame.declaration.components.item_kind == "nested_extern":
        frame.declaration.local_symbol_id = -1
    frame.declaration.declaration_span.end = ending
    frame.declaration.declaration_span.length = ending - frame.declaration.declaration_span.start
    if flat_decl >= 0:
        decl_set_span(flat_decl, flat_span_new(frame.declaration.declaration_span.start, ending,
            frame.declaration.declaration_span.line, frame.declaration.declaration_span.col))
    if frame.cursor < ending:
        frame.declaration.owned_intervals.push(Span(start: frame.cursor, end: ending,
            line: frame.declaration.declaration_span.line, col: 1,
            file: representation_path_v1, length: ending - frame.cursor))
    representation_frames_v1[position] = frame
    representation_stack_v1 = representation_stack_v1.slice(0, representation_stack_v1.len() - 1)
    if frame.parent >= 0:
        var parent = representation_frames_v1[frame.parent]
        parent.cursor = ending
        representation_frames_v1[frame.parent] = parent

pub fn representation_record_region_v1(capabilities: [text]):
    if representation_stack_v1.len() == 0:
        return
    val position = representation_stack_v1[representation_stack_v1.len() - 1]
    var frame = representation_frames_v1[position]
    frame.declaration.requires_manifest = true
    for capability in capabilities:
        if not frame.declaration.region_capabilities.contains(capability):
            frame.declaration.region_capabilities.push(capability)
    representation_frames_v1[position] = frame

# Unsupported/unattached targets become an invalid explicit row, never a
# pending grant that can migrate onto the next named declaration.
pub fn representation_reject_pending_v1():
    if representation_pending_v1 == nil:
        return
    val position = representation_declaration_begin_v1("unsupported")
    var frame = representation_frames_v1[position]
    frame.declaration.metadata_errors.push("representation_boundary requires an exact fn/me/extern fn/struct/class/enum owner")
    representation_frames_v1[position] = frame
    representation_declaration_end_v1(position, -1, "")

pub fn representation_parser_has_metadata_v1() -> bool:
    if representation_pending_v1 != nil:
        return true
    for frame in representation_frames_v1:
        # Existing HIR already transports unsafe regions/caps. Observation-only
        # legacy rows must not disable ordinary AST/HIR body caching.
        if frame.declaration.manifest != nil or frame.declaration.metadata_errors.len() > 0:
            return true
    false

pub fn representation_parser_declarations_v1(package: text, module_path: text) -> [RepresentationDeclarationV1]:
    var out: [RepresentationDeclarationV1] = []
    var identities: [text] = []
    for frame in representation_frames_v1:
        var declaration = frame.declaration
        declaration.components.package = package
        declaration.components.module_path = module_path
        if frame.parent >= 0:
            declaration.components.owner_id = identities[frame.parent]
        declaration.declaration_id = stable_symbol_id(declaration.components)
        identities.push(declaration.declaration_id)
        out.push(declaration)
    out

pub fn parse_representation_source_v1(source: text, path: text, package: text, module_path: text) -> [RepresentationDeclarationV1]:
    val parse_failed = parse_module_silent_checked(source, path)
    representation_checked_complete_v1 = true
    representation_checked_failed_v1 = parse_failed
    representation_reject_pending_v1()
    if not representation_parser_has_metadata_v1():
        return []
    var declarations = representation_parser_declarations_v1(package, module_path)
    if parse_failed:
        for i in 0..declarations.len():
            declarations[i].metadata_errors.push("source parse failed; representation admission refused")
    declarations

# The CLI's existing AST lint continuation consumes the exact parse that the
# live rule already performed. No second parse and no process-global admission.
pub fn representation_checked_parse_receipt_v1(source: text, path: text) -> bool?:
    if not representation_checked_complete_v1 or representation_path_v1 != path or
            representation_digest_v1 != sha256_text(source):
        return nil
    Some(representation_checked_failed_v1)

pub fn representation_parser_metadata_v1() -> [RepresentationDeclarationV1]:
    if not representation_parser_has_metadata_v1():
        return []
    representation_parser_declarations_v1("", "")
