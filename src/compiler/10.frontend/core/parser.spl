# ===== Parser State =====

var par_errors: [text] = []
var par_warnings: [text] = []
var par_struct_names: [text] = []
var par_had_error: bool = false
var par_diagnostics_suppressed: bool = false
var par_diagnostic_emit_count: i64 = 0
var par_kind_slot: [i64] = [0]
var par_text_slot: [text] = [""]
var par_line_slot: [i64] = [0]
var par_col_slot: [i64] = [0]
# Perf: cache SIMPLE_BOOTSTRAP_PAR_ENV_SAVE env var to avoid per-token getenv() syscall.
# -1 = uncached, 0 = disabled, 1 = enabled
var par_env_save_cached: i64 = -1

extern fn rt_is_debug_mode_enabled() -> bool

fn parser_env_i64(key: text) -> i64:
    val raw = rt_env_get(key) ?? ""
    var value: i64 = 0
    var i: i64 = 0
    var neg: bool = false
    if raw.len() > 0 and raw[0:1] == "-":
        neg = true
        i = 1
    while i < raw.len():
        val code = char_code(raw[i:i + 1])
        if code < 48 or code > 57:
            break
        value = value * 10 + (code - 48)
        i = i + 1
    if neg:
        return 0 - value
    value

fn par_env_save_enabled() -> bool:
    if par_env_save_cached < 0:
        par_env_save_cached = if (rt_env_get("SIMPLE_BOOTSTRAP_PAR_ENV_SAVE") ?? "") == "1": 1 else: 0
    par_env_save_cached == 1

fn parser_current_token_text(kind: i64) -> text:
    if kind == 180 or kind == 181 or kind == 182 or kind == 190:
        return ""
    lex_token_text()

fn par_kind_set(value: i64):
    par_kind_slot[0] = value
    if par_env_save_enabled():
        rt_env_set("SIMPLE_BOOTSTRAP_PAR_KIND", "{value}")

fn par_kind_get() -> i64:
    if par_kind_slot == nil:
        return parser_env_i64("SIMPLE_BOOTSTRAP_PAR_KIND")
    par_kind_slot[0]

fn par_text_set(value: text):
    par_text_slot[0] = value
    if par_env_save_enabled():
        rt_env_set("SIMPLE_BOOTSTRAP_PAR_TEXT", value)

fn par_text_get() -> text:
    if par_text_slot != nil:
        return par_text_slot[0]
    if par_env_save_enabled():
        return rt_env_get("SIMPLE_BOOTSTRAP_PAR_TEXT") ?? ""
    ""

fn par_line_set(value: i64):
    par_line_slot[0] = value
    if par_env_save_enabled():
        rt_env_set("SIMPLE_BOOTSTRAP_PAR_LINE", "{value}")

fn par_line_get() -> i64:
    if par_line_slot == nil:
        return parser_env_i64("SIMPLE_BOOTSTRAP_PAR_LINE")
    par_line_slot[0]

fn par_col_set(value: i64):
    par_col_slot[0] = value
    if par_env_save_enabled():
        rt_env_set("SIMPLE_BOOTSTRAP_PAR_COL", "{value}")

fn par_col_get() -> i64:
    if par_col_slot == nil:
        return parser_env_i64("SIMPLE_BOOTSTRAP_PAR_COL")
    par_col_slot[0]

fn par_had_error_set(value: bool):
    par_had_error = value

fn par_had_error_get() -> bool:
    par_had_error

# Process-global mirror of par_had_error.
#
# A module-level `var` written inside the parse call tree is NOT visible to a
# read made after control has returned across a module boundary: on 2026-07-28
# `bin/simple lint` observed par_had_error == false right after the parser had
# emitted six errors for an unparseable file, so lint reported it clean
# (doc/08_tracking/bug/lint_does_not_detect_syntax_errors_2026-07-28.md). The
# env channel is the same process-global fallback par_line/par_col already use
# (see parser_env_i64 / par_env_save_enabled above) and survives that boundary.
#
# Only parse_module_silent_checked() clears and reads this mirror, so no
# existing parser or bootstrap behaviour changes; the cost is one rt_env_set on
# the (cold) error paths.
fn par_had_error_mirror_set():
    rt_env_set("SIMPLE_PARSER_HAD_ERROR", "1")

fn par_had_error_mirror_clear():
    rt_env_set("SIMPLE_PARSER_HAD_ERROR", "")

fn par_had_error_mirror_get() -> bool:
    (rt_env_get("SIMPLE_PARSER_HAD_ERROR") ?? "") == "1"

# Mirror of the FIRST parser error's location and reason.
#
# Same process-global channel, and the same reason, as par_had_error_mirror
# above: `bin/simple lint` reads it after control has returned across the module
# boundary. Without it PARSE001 could only ever be reported at `<file>:1:0`
# with the fixed text "Source did not parse", so a census could count parse
# failures but never break them down by shape
# (doc/08_tracking/bug/lint_parse_failure_silently_skips_file_2026-08-01.md).
#
# First error wins: later errors are usually cascade noise from the first.
# Written only on the (cold) error path, so no hot-path cost.
fn par_first_error_mirror_set(line: i64, col: i64, msg: text):
    if (rt_env_get("SIMPLE_PARSER_FIRST_ERROR") ?? "") == "":
        rt_env_set("SIMPLE_PARSER_FIRST_ERROR", int_to_str(line) + ":" + int_to_str(col) + ":" + msg)

fn par_first_error_mirror_clear():
    rt_env_set("SIMPLE_PARSER_FIRST_ERROR", "")

# Returns "" when no error was recorded, else "<line>:<col>:<message>".
fn parser_first_error_get() -> text:
    rt_env_get("SIMPLE_PARSER_FIRST_ERROR") ?? ""

fn parser_diagnostics_suppressed_get() -> bool:
    par_diagnostics_suppressed

fn parser_diagnostics_suppressed_set(value: bool):
    par_diagnostics_suppressed = value

fn parser_diagnostic_emit_count_get() -> i64:
    par_diagnostic_emit_count

# ===== Parser Init =====

fn parser_init(source: text):
    parser_init_with_path(source, "")

fn parser_init_with_path(source: text, path: text):
    if par_errors == nil:
        par_errors = []
    par_errors.clear()
    if par_warnings == nil:
        par_warnings = []
    par_warnings.clear()
    if par_struct_names == nil:
        par_struct_names = []
    par_struct_names.clear()
    if par_kind_slot == nil:
        par_kind_slot = [0]
    par_kind_slot[0] = 0
    if par_text_slot == nil:
        par_text_slot = [""]
    par_text_slot[0] = ""
    if par_line_slot == nil:
        par_line_slot = [0]
    par_line_slot[0] = 0
    if par_col_slot == nil:
        par_col_slot = [0]
    par_col_slot[0] = 0
    par_had_error = false
    par_diagnostics_suppressed = false
    par_diagnostic_emit_count = 0
    if (rt_env_get("SIMPLE_TRACE_AST_RESET") ?? "") == "1":
        print "[parser_init_with_path] resetting for path={path}"
    ast_reset()
    # WP-C: reset the `resource` decl registry per parse, same reason
    # ast_reset() is here -- a second parse_module_body() in one process
    # (e.g. a spec that parses two source strings) must not leak the first
    # parse's resource facts into the second. See resource_registry.spl.
    resource_registry_reset()
    # C1: same reason, for the `@layer_eq`/`@layer_field` facts. Without this a
    # spec (or any multi-module compile) that parses a second source would keep
    # the first source's view->target claims alive and re-check them against a
    # module where the view no longer exists.
    layer_eq_registry_reset_module(path)
    layer_field_pending_reset()
    # C4: same module-scoped reset for the `@copy_budget`/`@bounded_loop`
    # facts. Mirrors the C1 line above exactly -- a blanket wipe here would
    # leave only the last-parsed module's effect contracts to check.
    effect_registry_reset_module(path)
    effect_pending_reset()
    # C3: same module-scoped reset for the `@advice`/`@readonly`/`@noalloc`/
    # `@bounded_time` facts. Mirrors the C1 and C4 lines above exactly -- a
    # blanket wipe here would leave only the last-parsed module's advice to
    # check, and every earlier module's pointcuts would go unproven while
    # still reporting green.
    aspect_registry_reset_module(path)
    aspect_pending_reset()
    if path != "":
        module_set_path(path)
    lex_init_with_path(source, path)
    parser_advance()

# Per-token timing probe (level-gated, DEFAULT OFF; SIMPLE_PARSE_PROFILE=1).
# Same idiom as lint_prof_now/lint_prof_mark; see the block comment in
# parser_decls_use.spl. NOT a throwaway probe — do not delete during cleanup.
extern fn rt_time_now_unix_micros() -> i64
var par_prof_enabled_cached: i64 = -1
fn par_prof_enabled() -> bool:
    if par_prof_enabled_cached < 0:
        par_prof_enabled_cached = if (rt_env_get("SIMPLE_PARSE_PROFILE") ?? "") == "": 0 else: 1
    par_prof_enabled_cached == 1

fn parser_advance():
    if par_prof_enabled():
        # Times the SAME batched path as the non-prof branch below.
        val t0 = rt_time_now_unix_micros()
        val snap_p = lex_next_snapshot()
        val t1 = rt_time_now_unix_micros()
        val kind_p: i64 = snap_p[0]
        par_kind_set(kind_p)
        val ta = rt_time_now_unix_micros()
        if kind_p == 180 or kind_p == 181 or kind_p == 182 or kind_p == 190:
            par_text_set("")
        else:
            par_text_set(snap_p[3])
        val tc = rt_time_now_unix_micros()
        par_line_set(snap_p[1])
        par_col_set(snap_p[2])
        val t2 = rt_time_now_unix_micros()
        print("PARSEPROF\ttok:lex_snapshot\t{t1 - t0}")
        print("PARSEPROF\ttok:kind_set\t{ta - t1}")
        print("PARSEPROF\ttok:text_set\t{tc - ta}")
        print("PARSEPROF\ttok:line_col\t{t2 - tc}")
        return
    # Hot loop, minimized CALL COUNT: under the seed interpreter EVERY call
    # (even same-module) costs milliseconds, measured via PARSEPROF —
    # par_line_set+par_col_set alone were ~8.8ms/token. One batched lexer call
    # replaces four (lex_next + text + line + col), and the four par_*_set
    # wrappers are inlined as direct slot writes; the env-save mirror they
    # guarded is preserved behind the same par_env_save_enabled() flag.
    # Behavior identical (the kind mask is parser_current_token_text inlined).
    # See doc/08_tracking/bug/lint_timeout_hwir_zca_rows_2026-08-17.md.
    val snap = lex_next_snapshot()
    val kind: i64 = snap[0]
    par_kind_slot[0] = kind
    if kind == 180 or kind == 181 or kind == 182 or kind == 190:
        par_text_slot[0] = ""
    else:
        par_text_slot[0] = snap[3]
    par_line_slot[0] = snap[1]
    par_col_slot[0] = snap[2]
    if par_env_save_enabled():
        rt_env_set("SIMPLE_BOOTSTRAP_PAR_KIND", "{kind}")
        rt_env_set("SIMPLE_BOOTSTRAP_PAR_TEXT", par_text_slot[0])
        rt_env_set("SIMPLE_BOOTSTRAP_PAR_LINE", "{par_line_slot[0]}")
        rt_env_set("SIMPLE_BOOTSTRAP_PAR_COL", "{par_col_slot[0]}")

# ===== Token Checking =====

fn parser_check(expected: i64) -> bool:
    par_kind_get() == expected

fn parser_match_tok(expected: i64) -> bool:
    if par_kind_get() != expected:
        return false
    parser_advance()
    true

fn parser_expect(expected: i64) -> bool:
    if par_kind_get() == expected:
        parser_advance()
        return true
    # Cross-module attribution: without the path prefix, this message is
    # indistinguishable from an error raised while parsing a DIFFERENT module
    # (e.g. in a full multi-module build, log readers wrongly blamed
    # check_dbs.spl for errors actually raised while parsing an earlier
    # module — see bootstrap stage4 "check_dbs cross-module desync"). Include
    # module_get_path() to match parser_error()'s format below.
    val msg = "path " + module_get_path() + " line " + int_to_str(par_line_get()) + ":" + int_to_str(par_col_get()) + ": expected " + tok_kind_name(expected) + ", got " + tok_kind_name(par_kind_get()) + " '" + par_text_get() + "'"
    if not par_diagnostics_suppressed:
        print "[parser_error] {msg}"
        par_diagnostic_emit_count = par_diagnostic_emit_count + 1
    par_had_error_set(true)
    par_had_error_mirror_set()
    par_record_error(msg)
    par_first_error_mirror_set(par_line_get(), par_col_get(), "expected " + tok_kind_name(expected) + ", got " + tok_kind_name(par_kind_get()) + " '" + par_text_get() + "'")
    false

fn parser_error(msg: text):
    val full = "line " + int_to_str(par_line_get()) + ":" + int_to_str(par_col_get()) + ": " + msg
    if not par_diagnostics_suppressed:
        print "[parser_error] {full}"
        print "[parser_error_ctx] path " + module_get_path() + " kind " + int_to_str(par_kind_get()) + " text '" + par_text_get() + "'"
        par_diagnostic_emit_count = par_diagnostic_emit_count + 1
    par_had_error_set(true)
    par_had_error_mirror_set()
    par_record_error(full)
    par_first_error_mirror_set(par_line_get(), par_col_get(), msg)

# Append to the recorded-error list that backs parser_get_errors() and
# parser_error_count(). `par_errors` was declared, cleared on init and exported,
# but nothing ever pushed to it, so both accessors were hardcoded stubs
# returning [] and 0 — a caller that gated on the COUNT saw a clean parse no
# matter how many errors had been printed. Recorded regardless of
# par_diagnostics_suppressed: suppression hides the message, not the error.
fn par_record_error(msg: text):
    if par_errors == nil:
        par_errors = []
    par_errors.push(msg)

fn parser_guarded_int_text(t: text) -> i64:
    # Lexer bugs must surface as located parser errors, not location-less
    # interpreter aborts ("cannot parse '\"' as i64", stage4 2026-07-03).
    var ok = t.len() > 0
    var gi = 0
    while gi < t.len():
        if not is_digit(t[gi:gi+1]):
            ok = false
        gi = gi + 1
    if not ok:
        parser_error("malformed integer literal token text '" + t + "'")
        return 0
    # Overflow guard: a decimal literal whose magnitude cannot possibly fit in
    # i64 must be a LOUD parse error, not a silently-wrapped garbage value
    # (constedge lane numeric-literal sweep 2026-07-14: native-build accepted
    # `99999999999999999999` and silently produced 7766279631452241919, while
    # the oracle correctly rejects it as "Invalid integer"). i64::MAX
    # ("9223372036854775807") has 19 digits, so any 20+-digit literal is
    # unambiguously out of range. At exactly 19 digits, allow up to
    # "9223372036854775808" (2**63, one past i64::MAX) inclusive — that exact
    # magnitude is required by the `-9223372036854775808` (i64::MIN) literal
    # idiom, which relies on this text wrapping to i64::MIN here and then
    # wrapping back to i64::MIN under negation. Anything larger is rejected.
    if t.len() > 19:
        parser_error("integer literal out of range for i64: '" + t + "'")
        return 0
    if t.len() == 19:
        val max19 = "9223372036854775808"
        var ci = 0
        var too_big = false
        var still_equal = true
        while ci < 19:
            val tc = char_code(t[ci:ci + 1])
            val mc = char_code(max19[ci:ci + 1])
            if still_equal:
                if tc > mc:
                    too_big = true
                    still_equal = false
                elif tc < mc:
                    still_equal = false
            ci = ci + 1
        if too_big:
            parser_error("integer literal out of range for i64: '" + t + "'")
            return 0
    # Manual decimal accumulation: the builtin int(text) miscompiles on stage4
    # (returns the FIRST character's char code: int("1")==49, int("12")==49 —
    # print(1+1) printed 98; bug doc iteration 18/20 #87). The input is
    # digit-guarded above, so this is semantically identical to int(t).
    # (Regressed by bb9aa222509 which reverted the iteration-18 accumulation to
    # a bare int(t); restored here.)
    var acc: i64 = 0
    var di = 0
    while di < t.len():
        val code = char_code(t[di:di + 1])
        acc = acc * 10 + (code - 48)
        di = di + 1
    acc

fn parser_warn(msg: text):
    if par_warnings == nil:
        par_warnings = []
    val full = "line " + int_to_str(par_line_get()) + ":" + int_to_str(par_col_get()) + ": " + msg
    par_warnings.push(full)
    if (rt_env_get("SIMPLE_COMPILER_TRACE") ?? "") == "1":
        print "[parser_warning] {full}"

fn parser_path_is_script(path: text) -> bool:
    val p = path ?? ""
    if p == "":
        return true
    if p.starts_with("examples/") or p.contains("/examples/"):
        return true
    if p.starts_with("scripts/") or p.contains("/scripts/"):
        return true
    if p.starts_with("test/") or p.contains("/test/"):
        return true
    if p.contains("/fixtures/") or p.contains("/repro/"):
        return true
    false

fn parser_warn_print_if_needed():
    if parser_path_is_script(module_get_path()):
        return
    parser_warn("LOG001: use log() instead of print() in non-script code")

fn parser_warnings_get() -> [text]:
    if par_warnings == nil:
        return []
    par_warnings

fn parser_warnings_clear():
    if par_warnings != nil:
        par_warnings.clear()

# ===== Skip Newlines =====

fn parser_skip_newlines():
    while true:
        val kind = par_kind_get()
        if kind != 180:
            break
        parser_advance()

fn parser_skip_newlines_and_semicolons():
    while true:
        val kind = par_kind_get()
        val is_nl = kind == 180
        val is_semi = kind == 163
        val should_skip = is_nl or is_semi
        if not should_skip:
            break
        parser_advance()

# ===== Type Annotation Parsing =====

# Absorb a postfix `?`/`??` optional suffix after a non-named base type so that
# `[T]?`, `(T, T)?`, `{K: V}?`, `fn(...)?` parse like the named-type `i64?`
# shorthand (which is inlined in the named branch below). Returns TYPE_OPTION
# when a suffix is present, else the base type unchanged.
fn parser_absorb_optional_suffix(base: i64) -> i64:
    var kind = par_kind_get()
    if kind != 130 and kind != 132:
        return base
    for _qi in 0..12:
        if kind == 130 or kind == 132:
            parser_advance()
            kind = par_kind_get()
        else:
            break
    TYPE_OPTION

fn parser_parse_type() -> i64:
    parser_parse_type_impl(true)

fn parser_parse_cast_type() -> i64:
    parser_parse_type_impl(false)

# Tuple labels are ABI/documentation names, not distinct element types in the
# bootstrap tag registry. Parse `label: T` by discarding the provisional named
# type for `label` and retaining T; anonymous tuple elements remain unchanged.
fn parser_parse_tuple_element_type() -> i64:
    val candidate = parser_parse_type()
    if par_kind_get() == TOK_COLON:
        parser_advance()
        return parser_parse_type()
    candidate

fn parser_parse_type_impl(allow_spaced_generics: bool) -> i64:
    # dyn Trait -- dynamic dispatch type (parsed as named type)
    var kind = par_kind_get()
    # Canonical reference types.  Register the inner tag and mutability so the
    # flat bridge can preserve `&T` versus `&mut T` instead of merely consuming
    # the prefix for checker parity.
    if kind == TOK_AMPERSAND:
        parser_advance()
        var mutable = false
        if par_kind_get() == TOK_IDENT and par_text_get() == "mut":
            parser_advance()
            mutable = true
        val reference_inner = parser_parse_type_impl(allow_spaced_generics)
        val reference_tag = reference_type_register(reference_inner, mutable)
        if reference_tag < 0:
            parser_error("too many distinct reference type annotations")
            return reference_inner
        return reference_tag
    # Raw/shared pointer types.  The flat type lane carries the inner tag and
    # the only distinction supported by pure HIR (`Ptr(inner, mutable)`).
    # `*T` and `*const T` are immutable; `*mut T` is mutable.
    if kind == TOK_STAR:
        parser_advance()
        var pointer_mutable = false
        if par_text_get() == "const":
            parser_advance()
        elif par_text_get() == "mut":
            parser_advance()
            pointer_mutable = true
        val pointer_inner = parser_parse_type_impl(allow_spaced_generics)
        val pointer_tag = pointer_type_register(pointer_inner, pointer_mutable)
        if pointer_tag < 0:
            parser_error("too many distinct pointer type annotations")
            return pointer_inner
        return pointer_tag
    # Resource-ownership sigil `@T` -- atomic ref-counted sharing (WP-B,
    # doc/03_plan/language/resource/resource_parallel_agent_plan_2026-08-06.md).
    # Just parse-and-register here, same shape as the pointer branch above.
    # Ownership-kind recording and the `thread_safe:` legality gate happen at
    # bridge time (_FlatAstBridge/convert_nodes.spl convert_flat_type), NOT
    # here: resource_registry_declare (WP-C) is only called from
    # module_assembly's __resource_decl handling, which runs during the flat
    # bridge walk -- at raw-parse time (this function) no resource has been
    # registered yet even if its `@sffi resource` decl appears earlier in the
    # same source, so resource_is_declared would always read false here.
    if kind == TOK_AT:
        parser_advance()
        val atomic_inner = parser_parse_type_impl(allow_spaced_generics)
        val atomic_tag = atomic_type_register(atomic_inner)
        if atomic_tag < 0:
            parser_error("too many distinct atomic type annotations")
            return atomic_inner
        return atomic_tag
    # Resource-ownership sigil `-T` -- weak reference (WP-B). Same
    # bridge-time-not-parse-time note as `@T` above.
    if kind == TOK_MINUS:
        parser_advance()
        val weak_inner = parser_parse_type_impl(allow_spaced_generics)
        val weak_tag = weak_type_register(weak_inner)
        if weak_tag < 0:
            parser_error("too many distinct weak type annotations")
            return weak_inner
        return weak_tag
    # Canonical exclusive-capability type `mut T`. Unlike `mut name: T`
    # parameter-binding syntax, this modifier follows the colon and belongs to
    # the type. Preserve it through the flat type registry for the AST bridge.
    if kind == TOK_IDENT and par_text_get() == "mut":
        parser_advance()
        val exclusive_inner = parser_parse_type_impl(allow_spaced_generics)
        val exclusive_tag = exclusive_type_register(exclusive_inner)
        if exclusive_tag < 0:
            return exclusive_inner
        return exclusive_tag
    # LANE ISO2 (2026-07-29): capability-prefixed type `iso T`. `iso` lexes
    # as a plain identifier (kind 6) -- it is not a reserved keyword token
    # (doc/08_tracking/bug/iso_mut_capability_prefix_not_parsed_2026-07-29.md).
    # Left unhandled, it fell into the named-type branch below, which consumed
    # `iso` itself as the type name and then failed on whatever real type
    # followed it (`fn take(a: iso i64)` -> parser error "expected ), got
    # Ident 'i64'"). Register the inner type in the isolated-type side table
    # (mirrors the Dict<K,V>/Result<T,E>/array-element registries below --
    # the flat i64 tag space has no room to carry a wrapped inner type
    # directly) and encode TYPE_ISOLATED_BASE + id so the AST bridge
    # (_FlatAstBridge/convert_nodes.spl convert_flat_type) can rebuild the
    # real TypeKind.Isolated(inner), which HIR lower_type already lowers to
    # HirTypeKind.Isolated. `mut T` in this same type position is a
    # different, still-unimplemented capability (no HIR arm consumes it yet)
    # and is intentionally NOT handled here -- see the bug doc.
    if kind == 6 and par_text_get() == "iso":
        parser_advance()
        val iso_inner = parser_parse_type_impl(allow_spaced_generics)
        val iso_tag = isolated_type_register(iso_inner)
        if iso_tag < 0:
            return iso_inner
        return iso_tag
    # Prefix optional shorthand `?T` is not documented/legal syntax (the
    # supported spelling is the suffix form `T?`, e.g. `i64?`, `[T]?`, or
    # `Option<T>`). Left unhandled, the leading `?` fell through every type
    # form below to the catch-all "expected type annotation" error WITHOUT
    # consuming the token; the caller's subsequent `parser_expect(TOK_COLON)`
    # then also failed on the still-current `?`, and the block parser's error
    # recovery re-parsed the leftover `? i64:` as expression statements —
    # cascading into unrelated "unresolved name: i64" / "unresolved name: n"
    # HIR errors that looked like param registration was destroyed. Emit one
    # clear, located diagnostic naming the workaround and resync by consuming
    # the `?` plus the underlying type so the rest of the declaration (return
    # type position, param list, function body) parses normally.
    if kind == TOK_QUESTION:
        parser_error("prefix optional type '?T' is not supported; use suffix form 'T?' (e.g. i64?) or Option<T> instead")
        parser_advance()
        return parser_parse_type()
    # `nil` is a keyword token rather than an identifier, but it is also the
    # canonical explicit no-value return annotation (`fn f() -> nil`).
    if kind == TOK_KW_NIL:
        parser_advance()
        return TYPE_NIL
    # `fn(T, ...) -> R` function-type annotation (e.g. json's
    # `mapper: fn(any) -> any`). TOK_KW_FN is a keyword, so this used to fall
    # through to the catch-all "expected type annotation" — truncating the
    # whole declaration mid-param-list, which cascaded into "unresolved type:
    # fn" + phantom "untyped function returns a value" on ANNOTATED fns.
    # The bootstrap tag registry has no first-class fn-type, so consume the
    # full shape and answer TYPE_FN (callables are dynamically dispatched).
    if kind == 20:
        parser_advance()
        if par_kind_get() == 140:
            parser_advance()
            for _fnty_i in 0..20:
                if par_kind_get() == 141:
                    break
                val _fnty_param = parser_parse_type()
                if par_kind_get() == 160:
                    parser_advance()
            if par_kind_get() == 141:
                parser_advance()
        if par_kind_get() == 167:
            parser_advance()
            val _fnty_ret = parser_parse_type()
        return TYPE_FN
    if kind == 199:
        parser_advance()
        # Parse the trait name
        val dyn_name = par_text_get()
        kind = par_kind_get()
        if kind == 6:
            parser_advance()
        # Return as named type (interpreter uses structural subtyping anyway)
        val dyn_id = named_type_find(dyn_name)
        if dyn_id >= 0:
            return TYPE_NAMED_BASE + dyn_id
        return TYPE_ANY
    var type_name = par_text_get()
    if kind == 6:
        var type_name_end = lex_token_end_get()
        parser_advance()
        # G35: absorb dotted path segments: json.Value  or  json::Value
        for _gi35 in 0..20:
            val seg_kind = par_kind_get()
            if seg_kind != 164 and seg_kind != 162:
                break
            parser_advance()
            var seg_name = par_text_get()
            val seg_k = par_kind_get()
            val is_ident = seg_k == 6
            val seg_kn = tok_kind_name(seg_k)
            val seg_is_kw = keyword_lookup(seg_kn) == seg_k
            if not is_ident and not seg_is_kw:
                break
            if seg_is_kw and not is_ident:
                seg_name = seg_kn
            type_name_end = lex_token_end_get()
            parser_advance()
            type_name = type_name + "." + seg_name
        # Check for generic type: Option<T>, Result<T, E>, Dict<K,V>, etc.
        kind = par_kind_get()
        val has_lt: bool = kind == TOK_LT and (allow_spaced_generics or type_name_end == lex_token_start_get())
        val has_lt_gen: bool = kind == TOK_LT_GENERIC
        val has_square_generic: bool = kind == TOK_LBRACKET
        val has_generic: bool = has_lt or has_lt_gen or has_square_generic
        if has_generic:
            parser_advance()
            val inner_type = parser_parse_type()
            # Handle multi-param generics: Dict<K, V>, Result<T, E>
            var extra_type = inner_type
            var has_extra_type: bool = false
            for i in 0..10:
                if par_kind_get() != 160:
                    break
                parser_advance()
                extra_type = parser_parse_type()
                has_extra_type = true
            # The same token represents binary `>` and a generic type close.
            # Tell the lexer which meaning the parser established before
            # advancing: otherwise a following newline is treated as a
            # comparison continuation and its structural dedent is swallowed.
            if has_square_generic:
                parser_expect(TOK_RBRACKET)
            else:
                lex_mark_current_token_as_generic_close()
                parser_expect(TOK_GT)
            # Handle Option<T>
            if type_name == "Option":
                if inner_type == TYPE_I64:
                    return parser_absorb_optional_suffix(TYPE_OPTION_I64)
                if inner_type == TYPE_F64:
                    return parser_absorb_optional_suffix(TYPE_OPTION_F64)
                if inner_type == TYPE_TEXT:
                    return parser_absorb_optional_suffix(TYPE_OPTION_TEXT)
                if inner_type == TYPE_BOOL:
                    return parser_absorb_optional_suffix(TYPE_OPTION_BOOL)
                # A non-primitive inner (a user class/struct/enum) has no
                # dedicated TYPE_OPTION_<T> tag, so it used to collapse to bare
                # TYPE_OPTION and erase the payload identity -- see
                # TYPE_OPTION_GENERIC_BASE and bug:
                # native_option_unwrap_receiver_unresolved_2026-08-09. Register
                # the inner tag instead, mirroring Result<T,E>/Dict<K,V> above.
                if inner_type >= TYPE_NAMED_BASE:
                    val opt_generic_tag = option_generic_type_register(inner_type)
                    if opt_generic_tag >= 0:
                        return parser_absorb_optional_suffix(opt_generic_tag)
                return parser_absorb_optional_suffix(TYPE_OPTION)
            # Preserve Result<T,E> generic args for match payload typing.
            if type_name == "Result":
                if has_extra_type:
                    val result_tag = result_type_register(inner_type, extra_type)
                    if result_tag < 0:
                        parser_error("too many distinct Result<T,E> annotations")
                        return parser_absorb_optional_suffix(TYPE_RESULT)
                    return parser_absorb_optional_suffix(result_tag)
                return parser_absorb_optional_suffix(TYPE_RESULT)
            # Dict<K,V> -> register the key/value tags (bug: dicttype -- this
            # used to unconditionally return the bare TYPE_DICT sentinel,
            # silently dropping K/V so every dict-typed param/local arrived at
            # the AST bridge as Named("Dict", []) with no generic args).
            if type_name == "Dict":
                if has_extra_type:
                    val dict_tag = dict_type_register(inner_type, extra_type)
                    if dict_tag < 0:
                        parser_error("too many distinct Dict<K,V> annotations")
                        return parser_absorb_optional_suffix(TYPE_DICT)
                    return parser_absorb_optional_suffix(dict_tag)
                return parser_absorb_optional_suffix(TYPE_DICT)
            # Unknown generic type - check if base is a named struct
            val gid = named_type_find(type_name)
            if gid >= 0:
                return parser_absorb_optional_suffix(TYPE_NAMED_BASE + gid)
            # A written generic base can be declared in another module and
            # therefore absent from this file's named-type registry. Preserve
            # the annotation as ANY; TYPE_VOID means no return was written.
            return parser_absorb_optional_suffix(TYPE_ANY)
        # Check for postfix ? for Option shorthand: i64? -> Option<i64>
        kind = par_kind_get()
        if kind == 130:
            parser_advance()
            kind = par_kind_get()
            # Check for additional ? marks (i64?? = Option<Option<i64>>)
            var opt_result = TYPE_OPTION
            if type_name == "i64":
                opt_result = TYPE_OPTION_I64
            elif type_name == "f64":
                opt_result = TYPE_OPTION_F64
            elif type_name == "text":
                opt_result = TYPE_OPTION_TEXT
            elif type_name == "bool":
                opt_result = TYPE_OPTION_BOOL
            else:
                # `Drv2?` is the shorthand spelling of `Option<Drv2>`; keep the
                # class identity via the inner-type registry rather than
                # collapsing to bare TYPE_OPTION (same rationale as the
                # `Option<T>` generic branch above).
                val postfix_nid = named_type_find(type_name)
                if postfix_nid >= 0:
                    val postfix_opt_tag = option_generic_type_register(TYPE_NAMED_BASE + postfix_nid)
                    if postfix_opt_tag >= 0:
                        opt_result = postfix_opt_tag
            # Loop for additional ? marks (i64?? or i64???)
            for qi in 0..10:
                if kind == 130:
                    parser_advance()
                    kind = par_kind_get()
                    opt_result = TYPE_OPTION
                elif kind == 132:
                    parser_advance()
                    kind = par_kind_get()
                    opt_result = TYPE_OPTION
                else:
                    break
            return opt_result
        # Check for ?? as double optional shorthand: i64?? -> Option<Option<i64>>
        if kind == 132:
            parser_advance()
            kind = par_kind_get()
            # i64?? = Option<Option<i64>>, treat as TYPE_OPTION (nested)
            # Check for additional ? marks
            for qi in 0..10:
                if kind == 130:
                    parser_advance()
                    kind = par_kind_get()
                elif kind == 132:
                    parser_advance()
                    kind = par_kind_get()
                else:
                    break
            return TYPE_OPTION
        # Simple primitive types
        if type_name == "i64":
            return TYPE_I64
        if type_name == "f64":
            return TYPE_F64
        if type_name == "text":
            return TYPE_TEXT
        if type_name == "bool":
            return TYPE_BOOL
        if type_name == "Option":
            return TYPE_OPTION
        if type_name == "Result":
            return TYPE_RESULT
        # `any` has a dedicated tag but was missing from this chain, so
        # `-> any` fell through named_type_find to TYPE_VOID (tag 0) — the
        # bridge's `has_ret = ret > 0` then read ANNOTATED `-> any` functions
        # as declaring no return type (phantom "untyped function returns a
        # value" storms across std.common.json).
        if type_name == "any":
            return TYPE_ANY
        # Check for struct type
        val sid = named_type_find(type_name)
        if sid >= 0:
            return TYPE_NAMED_BASE + sid
        # Fixed-width integer primitives (u8/u16/u32/u64/i8/i16/i32/...) have
        # no dedicated type tag and are never registered as named types, so
        # without this they fell through to TYPE_VOID -- silently producing
        # Unit-typed locals/casts/fields/params for perfectly ordinary code
        # like `x as u32`, `fn f(n: u32)`, or a bitfield's uN-typed fields.
        # Represent them with dedicated fixed-width tags so the bit width and
        # signedness survive into the AST bridge -> HIR Int(bits, signed) -> MIR
        # -> backend type mappers (e.g. VHDL unsigned/signed(W-1 downto 0)).
        if type_name == "u8":
            return TYPE_U8
        if type_name == "u16":
            return TYPE_U16
        if type_name == "u32":
            return TYPE_U32
        if type_name == "u64":
            return TYPE_U64
        if type_name == "i8":
            return TYPE_I8
        if type_name == "i16":
            return TYPE_I16
        if type_name == "i32":
            return TYPE_I32
        # Non-standard widths (u7, u3, ...) have no dedicated tag; keep the i64
        # register lane. Callers needing the exact width re-derive it from the
        # type name text via primitive_integer_bit_width_from_name.
        if primitive_integer_bit_width_from_name(type_name) > 0:
            return TYPE_I64
        # Preserve a written sibling/forward type name through the flat tag.
        # named_type_register is idempotent, so a later local declaration
        # fills this placeholder instead of creating a duplicate type id.
        if type_name != "":
            return TYPE_NAMED_BASE + named_type_register(type_name, [], [])
        return TYPE_VOID
    if kind == 144:
        # Array type: [i64], [text], etc.
        parser_advance()
        # Canonical empty array annotation `[]` means `[Any]`.
        if par_kind_get() == 145:
            parser_advance()
            return parser_absorb_optional_suffix(TYPE_ARRAY_ANY)
        val elem_type = parser_parse_type()
        # Sized array type: [T; N] — accept and drop the size expression
        # (stage4 arrays are dynamic; N is a literal or const ident).
        kind = par_kind_get()
        if kind == 163:
            parser_advance()
            for _si in 0..50:
                if par_kind_get() == 145 or par_kind_get() == 190:
                    break
                parser_advance()
        parser_expect(145)
        # Nested array types [[T]] -> TYPE_ARRAY_ANY
        val is_nested = elem_type == TYPE_ARRAY_I64
        val is_nested2 = elem_type == TYPE_ARRAY_TEXT
        val is_nested3 = elem_type == TYPE_ARRAY_BOOL
        val is_nested4 = elem_type == TYPE_ARRAY_ANY
        val any_nested = is_nested or is_nested2
        val any_nested2 = any_nested or is_nested3
        val any_nested3 = any_nested2 or is_nested4
        var arr_type = TYPE_ARRAY_I64
        if any_nested3:
            arr_type = TYPE_ARRAY_ANY
        elif elem_type == TYPE_TEXT:
            arr_type = TYPE_ARRAY_TEXT
        elif elem_type == TYPE_BOOL:
            arr_type = TYPE_ARRAY_BOOL
        elif elem_type == TYPE_I64 or elem_type == TYPE_VOID:
            # TYPE_VOID here means parser_parse_type_impl's ident branch could
            # not resolve the element name at all (e.g. bare `Any`, which has
            # no dedicated primitive check and no matching named type) --
            # keep this pre-existing fallback byte-identical to before.
            arr_type = TYPE_ARRAY_I64
        else:
            # Preserve every non-dedicated element tag, including fixed-width
            # integers such as `[u32]`, through the flat AST bridge.
            val arr_generic_tag = array_generic_type_register(elem_type)
            if arr_generic_tag < 0:
                arr_type = TYPE_ARRAY_I64
            else:
                arr_type = arr_generic_tag
        # absorb optional suffix: [T]? -> Option
        return parser_absorb_optional_suffix(arr_type)
    # Function type: fn(T, T) -> T
    if par_kind_get() == 20:
        parser_advance()
        parser_expect(140)
        if par_kind_get() != 141:
            parser_parse_type()
            while true:
                if par_kind_get() != 160:
                    break
                parser_advance()
                if par_kind_get() == 141:
                    break
                parser_parse_type()
        parser_expect(141)
        if par_kind_get() == 167:
            parser_advance()
            parser_parse_type()
        return parser_absorb_optional_suffix(TYPE_FN)
    # Tuple type: (T, T)
    if par_kind_get() == 140:
        parser_advance()
        # Collect the element tags instead of discarding them: a 2+ element
        # tuple registers them in the tuple type registry (types.spl
        # TYPE_TUPLE_BASE) so the AST bridge can rebuild TypeKind.Tuple with
        # real element types. Previously every parenthesized tuple type
        # collapsed to bare TYPE_ANY, so `-> (text, text, i32)` lost its
        # element types and a destructure of the call result defaulted every
        # element to i64 (parity case process_run_timeout).
        var tuple_elem_tags: [i64] = []
        if par_kind_get() != 141:
            tuple_elem_tags.push(parser_parse_tuple_element_type())
            while true:
                if par_kind_get() != 160:
                    break
                parser_advance()
                if par_kind_get() == 141:
                    break
                tuple_elem_tags.push(parser_parse_tuple_element_type())
        parser_expect(141)
        # Function type without the `fn` keyword: (T, ...) -> U. When `->`
        # (kind 167) follows the closing paren, the leading paren-group is the
        # parameter list of a first-class function type, not a tuple. Parse and
        # drop the return type and encode as TYPE_FN, exactly like the
        # `fn(...) -> U` branch above (the bootstrap type-id lane carries only
        # the fn-ness, not the signature; MIR derives call arity from the call
        # site). Without this, `g: (i64) -> i64` mis-parsed as a tuple and left
        # the `-> i64` tokens for the param parser to choke on.
        if par_kind_get() == 167:
            parser_advance()
            parser_parse_type()
            return parser_absorb_optional_suffix(TYPE_FN)
        # Unit `()` is the empty tuple and must retain an explicit type tag;
        # TYPE_ANY makes `-> ()` indistinguishable from a dynamic return.
        if tuple_elem_tags.len() == 0:
            val unit_tag = tuple_type_register([])
            if unit_tag < 0:
                parser_error("too many distinct tuple type annotations")
                return parser_absorb_optional_suffix(TYPE_ANY)
            return parser_absorb_optional_suffix(unit_tag)
        # A real tuple (2+ elements) carries its element tags via the
        # registry; a one-element paren group keeps the old TYPE_ANY behavior
        # because `(T)` is not a tuple.
        if tuple_elem_tags.len() >= 2:
            val tuple_tag = tuple_type_register(tuple_elem_tags)
            if tuple_tag < 0:
                parser_error("too many distinct tuple type annotations")
                return parser_absorb_optional_suffix(TYPE_ANY)
            return parser_absorb_optional_suffix(tuple_tag)
        return parser_absorb_optional_suffix(TYPE_ANY)
    # Dict type: {K: V}
    if par_kind_get() == 142:
        parser_advance()
        if par_kind_get() != 143:
            parser_parse_type()
            if par_kind_get() == 161:
                parser_advance()
                parser_parse_type()
        parser_expect(143)
        return parser_absorb_optional_suffix(TYPE_DICT)
    parser_error("expected type annotation")
    TYPE_VOID

# Parses a type that may be a union: A | B | C
fn parser_parse_type_with_union() -> i64:
    val base = parser_parse_type()
    var kind = par_kind_get()
    if kind != 121:
        return base
    # Check that the pipe isn't a |> pipe-forward
    var members: [i64] = []
    members.push(base)
    while kind == 121:
        parser_advance()
        val next = parser_parse_type()
        members.push(next)
        kind = par_kind_get()
    val union_tag = union_type_register(members)
    if union_tag < 0:
        parser_error("too many distinct union type annotations")
        return TYPE_UNION
    union_tag

# ===== Top-Level Module Entry Points =====

fn _parse_module_with_diagnostics(source: text, path: text, suppress_diagnostics: bool) -> bool:
    val saved_lex_source = rt_env_get("SIMPLE_BOOTSTRAP_LEX_SOURCE") ?? ""
    val saved_lex_path = rt_env_get("SIMPLE_BOOTSTRAP_LEX_PATH") ?? ""
    val saved_diagnostics_suppressed = parser_diagnostics_suppressed_get()
    val preprocessed = _pp_preprocess_conditionals(source)
    parser_init_with_path(preprocessed, path)
    parser_diagnostics_suppressed_set(suppress_diagnostics)
    parse_module_body()
    # Read the error state before returning across the split parser-module
    # boundary. Module-level writes made by parser_stmts are not guaranteed to
    # remain visible after that return in self-hosted execution; the process
    # mirror covers the same split-module case. Returning the verdict by value
    # makes parse_module_silent_checked reliable for statement-local errors
    # such as the explicit `val match` rejection.
    val parse_failed = par_had_error_get() or par_had_error_mirror_get()
    parser_diagnostics_suppressed_set(saved_diagnostics_suppressed)
    rt_env_set("SIMPLE_BOOTSTRAP_LEX_SOURCE", saved_lex_source)
    rt_env_set("SIMPLE_BOOTSTRAP_LEX_PATH", saved_lex_path)
    parse_failed

fn parse_module(source: text, path: text):
    _parse_module_with_diagnostics(source, path, false)

fn parse_module_silent(source: text, path: text):
    _parse_module_with_diagnostics(source, path, true)

# Parse quietly and RETURN whether the parse failed.
#
# Callers outside this module must use this instead of
# `parse_module_silent(...)` followed by `parser_has_errors()`: the flag written
# during the parse does not survive the return across the module boundary, so
# the two-step form silently reports success on files that do not parse. The
# bool is returned by value and is therefore reliable.
fn parse_module_silent_checked(source: text, path: text) -> bool:
    par_had_error_mirror_clear()
    par_first_error_mirror_clear()
    _parse_module_with_diagnostics(source, path, true)

fn parse_module_file(source: text, path: text):
    # Parse additional file without resetting AST
    val saved_lex_source = rt_env_get("SIMPLE_BOOTSTRAP_LEX_SOURCE") ?? ""
    val saved_lex_path = rt_env_get("SIMPLE_BOOTSTRAP_LEX_PATH") ?? ""
    # Nil-guards: module-level vars may be nil in native binaries
    if par_errors == nil:
        par_errors = []
    if par_warnings == nil:
        par_warnings = []
    if par_struct_names == nil:
        par_struct_names = []
    par_had_error = false
    val preprocessed = _pp_preprocess_conditionals(source)
    module_set_path(path)
    lex_init_with_path(preprocessed, path)
    parser_advance()
    parse_module_body()
    rt_env_set("SIMPLE_BOOTSTRAP_LEX_SOURCE", saved_lex_source)
    rt_env_set("SIMPLE_BOOTSTRAP_LEX_PATH", saved_lex_path)

fn parser_has_errors() -> bool:
    par_had_error_get()

fn parser_set_had_error(value: bool):
    par_had_error_set(value)

fn parser_get_errors() -> [text]:
    if par_errors == nil:
        return []
    par_errors

fn parser_error_count() -> i64:
    if par_errors == nil:
        return 0
    par_errors.len()

# ===== Parser Token Snapshot (for speculative parse / backtrack) =====
#
# Saves / restores just the four "current token" fields that parser_advance()
# writes.  Used together with lex_snapshot_save/lex_snapshot_restore to give a
# full checkpoint for try_skip_ident_generic_args.
#
# Layout of the returned [i64]: [kind, line, col]
# The text is returned/accepted separately as a plain text value.

fn parser_tok_save() -> ([i64], text):
    var nums: [i64] = [par_kind_get(), par_line_get(), par_col_get()]
    (nums, par_text_get())

fn parser_tok_restore(nums: [i64], saved_text: text):
    par_kind_set(nums[0])
    par_text_set(saved_text)
    par_line_set(nums[1])
    par_col_set(nums[2])

