use compiler.core.types.{option_generic_type_register, is_option_generic_tag}
use compiler.core.types.{result_type_register}
use compiler.core.types.{isolated_type_register}
use compiler.core.types.{exclusive_type_register}
use compiler.core.types.{reference_type_register}
use compiler.core.types.{pointer_type_register}
use compiler.core.types.{atomic_type_register}
