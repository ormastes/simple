# Core Simple -- captured-write check (owner ruling 2026-09-27)
#
# Shared by both pure-Simple engines so they reject the same programs with the
# same text as the seed: the interpreter (interpreter/mod.spl) and the native
# pipeline (_FlatAstBridge/module_assembly.spl flat_ast_to_module). The native
# pipeline ran no such check until 2026-10-11, and its MIR lowers a closure
# body against a by-value snapshot, so the write was silently dropped:
# doc/08_tracking/bug/stage2_closure_capture_write_silently_dropped_2026-10-11.md

use compiler.core.ast.{DECL_FN, DECL_LAZY_VAL, DECL_VAL, DECL_VAR, decl_count, decl_get, expr_get, stmt_get}
use compiler.core.ast.{arm_get_binding, arm_get_body, arm_get_guard, arm_get_pattern}
use compiler.core.ast_expr.{EXPR_ARRAY_LIT, EXPR_ASSIGN, EXPR_BINARY, EXPR_BLOCK, EXPR_CALL}
use compiler.core.ast_expr.{EXPR_COMPOUND_ASSIGN, EXPR_DO_BLOCK, EXPR_FIELD_ACCESS, EXPR_FOR, EXPR_IDENT}
use compiler.core.ast_expr.{EXPR_IF, EXPR_INDEX, EXPR_LAMBDA, EXPR_MATCH, EXPR_METHOD_CALL, EXPR_NULL_COALESCE}
use compiler.core.ast_expr.{EXPR_TUPLE, EXPR_UNARY, EXPR_UNSAFE_BLOCK, EXPR_WHILE}
use compiler.core.ast_stmt.{STMT_ASSIGN, STMT_BLOCK, STMT_COMPOUND_ASSIGN, STMT_EXPR, STMT_FOR}
use compiler.core.ast_stmt.{STMT_IF, STMT_LAZY_VAL_DECL, STMT_MATCH, STMT_RETURN, STMT_VAL_DECL, STMT_VAR_DECL, STMT_WHILE}
use compiler.core.ast_types.{CoreExpr, CoreStmt, CoreDecl}
use compiler.core.types.{span_col, span_line}

# Pure-Simple twin of src/compiler_rust/parser/src/capture_write_check.rs: a
# nested fn or lambda must not assign to a local of an enclosing function or
# lambda. Closures capture enclosing locals by value and are read-only
# (.claude/rules/language.md:22); before this check the write was silently
# lost here too (a nested `bump()` left the caller's counter at 0). Names not
# bound in any enclosing frame are module globals (writable) or implicit
# declarations. The walk covers statements and the expression forms that
# carry nested bodies; it can miss a write but never invents one.

var cw_names: [text] = []
var cw_name_frame: [i64] = []
var cw_frame_boundary: [bool] = []
var cw_frame_fn: [text] = []
var cw_pending_fn: text = ""
var cw_error: text = ""
var cw_error_line: i64 = 0
var cw_error_col: i64 = 0
var cw_globals: [text] = []

fn cw_is_global(name: text) -> bool:
    for g in cw_globals:
        if g == name: return true
    false

fn cw_message(name: text, in_fn: text, line: i64) -> text:
    val site = if in_fn == "<closure>": "a closure" else: "nested fn `" + in_fn + "`"
    val at = if line > 0: " (line " + line.to_text() + ")" else: ""
    "cannot assign to captured variable `" + name + "` inside " + site + at + ": closures capture enclosing locals by value and are read-only; return the new value or use a module-level `var`"

fn cw_push_frame(boundary: bool, fn_name: text):
    cw_frame_boundary.push(boundary)
    cw_frame_fn.push(fn_name)

fn cw_pop_frame():
    val top = cw_frame_boundary.len() - 1
    var kept_names: [text] = []
    var kept_frames: [i64] = []
    var i = 0
    while i < cw_names.len():
        if cw_name_frame[i] < top:
            kept_names.push(cw_names[i])
            kept_frames.push(cw_name_frame[i])
        i = i + 1
    cw_names = kept_names
    cw_name_frame = kept_frames
    var kept_b: [bool] = []
    var kept_f: [text] = []
    var j = 0
    while j < top:
        kept_b.push(cw_frame_boundary[j])
        kept_f.push(cw_frame_fn[j])
        j = j + 1
    cw_frame_boundary = kept_b
    cw_frame_fn = kept_f

fn cw_declare(name: text):
    if name == "": return
    cw_names.push(name)
    cw_name_frame.push(cw_frame_boundary.len() - 1)

# 0 = unbound, 1 = local to the current fn/lambda, 2 = captured enclosing local
fn cw_lookup(name: text) -> i64:
    val top = cw_frame_boundary.len() - 1
    var i = cw_names.len() - 1
    while i >= 0:
        if cw_names[i] == name:
            var g = cw_name_frame[i] + 1
            while g <= top:
                if cw_frame_boundary[g]: return 2
                g = g + 1
            return 1
        i = i - 1
    0

fn cw_current_fn() -> text:
    var k = cw_frame_boundary.len() - 1
    while k >= 0:
        if cw_frame_boundary[k]: return cw_frame_fn[k]
        k = k - 1
    "<closure>"

fn cw_note_assign(target_eid: i64, span_id: i64):
    if target_eid < 0 or cw_error != "": return
    val t: CoreExpr = expr_get(target_eid)
    if t.tag != EXPR_IDENT: return
    val kind = cw_lookup(t.s_val)
    if kind == 2:
        val sid = if span_id > 0: span_id else: t.span_id
        val line = if sid > 0: span_line(sid) else: 0
        cw_error_line = line
        cw_error_col = if sid > 0: span_col(sid) else: 0
        cw_error = cw_message(t.s_val, cw_current_fn(), line)
    elif kind == 0 and not cw_is_global(t.s_val):
        cw_declare(t.s_val)

fn cw_declare_iter(iter_name: text):
    if iter_name == "": return
    if iter_name.starts_with("("):
        val inner = iter_name[1:iter_name.len() - 1]
        for tname in inner.split(","):
            cw_declare(tname.trim())
    else:
        cw_declare(iter_name)

# Names a match pattern binds (`case Some(v)`, `if val x = ...`). Every
# identifier under the pattern is declared; a constructor or constant name
# declared this way is never an assignment target. A module global used as a
# pattern constant must stay a global.
fn cw_declare_pattern(pid: i64):
    if pid < 0: return
    val p: CoreExpr = expr_get(pid)
    if p.tag == EXPR_IDENT:
        if p.s_val != "_" and not cw_is_global(p.s_val):
            cw_declare(p.s_val)
        return
    cw_declare_pattern(p.left)
    cw_declare_pattern(p.right)
    for aid in p.args:
        cw_declare_pattern(aid)

fn cw_walk_arms(arm_ids: [i64]):
    for arm_id in arm_ids:
        cw_declare_pattern(arm_get_pattern(arm_id))
        cw_declare(arm_get_binding(arm_id))
        cw_walk_expr(arm_get_guard(arm_id))
        val arm_body: [i64] = arm_get_body(arm_id)
        cw_walk_stmts(arm_body)

fn cw_walk_stmts(stmts: [i64]):
    for sid in stmts:
        cw_walk_stmt(sid)

fn cw_walk_stmt(sid: i64):
    if sid < 0 or cw_error != "": return
    val s: CoreStmt = stmt_get(sid)
    val tag = s.tag
    if tag == STMT_VAL_DECL or tag == STMT_VAR_DECL or tag == STMT_LAZY_VAL_DECL:
        cw_pending_fn = s.name
        cw_walk_expr(s.expr_idx)
        cw_pending_fn = ""
        # A destructuring decl carries its names encoded as "(a, b)".
        cw_declare_iter(s.name)
        return
    if tag == STMT_ASSIGN or tag == STMT_COMPOUND_ASSIGN:
        for veid in s.body:
            cw_walk_expr(veid)
        cw_note_assign(s.expr_idx, s.span_id)
        return
    if tag == STMT_EXPR or tag == STMT_RETURN:
        cw_walk_expr(s.expr_idx)
        return
    if tag == STMT_FOR:
        cw_walk_expr(s.expr_idx)
        cw_declare_iter(s.name)
        cw_walk_stmts(s.body)
        return
    if tag == STMT_MATCH:
        cw_walk_expr(s.expr_idx)
        cw_walk_arms(s.body)
        return
    if tag == STMT_IF or tag == STMT_WHILE or tag == STMT_BLOCK:
        cw_walk_expr(s.expr_idx)
        cw_walk_stmts(s.body)
        cw_walk_stmts(s.else_body)

fn cw_walk_expr(eid: i64):
    if eid < 0 or cw_error != "": return
    val e: CoreExpr = expr_get(eid)
    val tag = e.tag
    if tag == EXPR_ASSIGN or tag == EXPR_COMPOUND_ASSIGN:
        cw_walk_expr(e.right)
        cw_note_assign(e.left, e.span_id)
        return
    if tag == EXPR_LAMBDA and e.i_val == 1:
        # Colon-block (`describe`/`it`/hook): a scope, not a closure.
        cw_pending_fn = ""
        cw_push_frame(false, "")
        for beid in e.stmts:
            cw_walk_expr(beid)
        cw_pop_frame()
        return
    if tag == EXPR_LAMBDA:
        val fn_name = if cw_pending_fn != "": cw_pending_fn else: "<closure>"
        cw_pending_fn = ""
        cw_push_frame(true, fn_name)
        for pid in e.args:
            cw_declare(expr_get(pid).s_val)
        for beid in e.stmts:
            cw_walk_expr(beid)
        cw_pop_frame()
        return
    cw_pending_fn = ""
    if tag == EXPR_BLOCK or tag == EXPR_DO_BLOCK or tag == EXPR_UNSAFE_BLOCK:
        cw_walk_stmts(e.stmts)
        cw_walk_expr(e.left)
        return
    if tag == EXPR_FOR:
        cw_walk_expr(e.left)
        cw_declare_iter(e.s_val)
        cw_walk_stmts(e.stmts)
        return
    if tag == EXPR_WHILE:
        cw_walk_expr(e.left)
        cw_walk_stmts(e.stmts)
        return
    if tag == EXPR_MATCH:
        cw_walk_expr(e.left)
        cw_walk_arms(e.args)
        return
    if tag == EXPR_IF:
        cw_walk_expr(e.left)
        cw_walk_expr(e.right)
        cw_walk_expr(e.extra)
        return
    if tag == EXPR_CALL or tag == EXPR_METHOD_CALL or tag == EXPR_ARRAY_LIT or tag == EXPR_TUPLE:
        cw_walk_expr(e.left)
        for aid in e.args:
            cw_walk_expr(aid)
        return
    if tag == EXPR_BINARY or tag == EXPR_UNARY or tag == EXPR_INDEX or tag == EXPR_FIELD_ACCESS or tag == EXPR_NULL_COALESCE:
        cw_walk_expr(e.left)
        cw_walk_expr(e.right)

# Returns "" when the module is clean, else the first diagnostic.
fn capture_write_check_module() -> text:
    cw_error = ""
    cw_error_line = 0
    cw_error_col = 0
    # Module-level val/var are globals, never captures: without this an
    # enclosing fn that assigns a global (`G = 0`) would implicitly declare
    # it as a local, and a closure writing the same global would be rejected
    # although the seed accepts it (its checker has a module frame). Collected
    # in declaration order, as the seed does: a global declared AFTER a
    # function is not yet known inside it.
    cw_globals = []
    var did: i64 = 0
    val total = decl_count()
    while did < total and cw_error == "":
        val d: CoreDecl = decl_get(did)
        if d.tag == DECL_VAL or d.tag == DECL_VAR or d.tag == DECL_LAZY_VAL:
            cw_globals.push(d.name)
        elif d.tag == DECL_FN and not d.name.starts_with("__lambda_"):
            cw_names = []
            cw_name_frame = []
            cw_frame_boundary = []
            cw_frame_fn = []
            cw_pending_fn = ""
            cw_push_frame(false, d.name)
            for pname in d.param_names:
                cw_declare(pname)
            cw_walk_stmts(d.body_stmts)
        did = did + 1
    cw_error

# Source position of the write the last capture_write_check_module() reported
# (0 when the span is unknown).
fn capture_write_error_line() -> i64:
    cw_error_line

fn capture_write_error_col() -> i64:
    cw_error_col

export capture_write_check_module, capture_write_error_line, capture_write_error_col
