# Flat raw-AST owner for statement- and value-position if/elif chains.
#
# Arms and statement bodies are scalar linked arenas.  No row contains a
# recursively nested aggregate, so appending arm N cannot copy arms 0..N-1.

const FORM_STMT = 1
const FORM_EXPR = 2

const ARM_CONDITION = 0
const ARM_VALUE_BIND = 1
const ARM_PATTERN_BIND = 2

var flat_if_chain_form: [i64] = []
var flat_if_chain_first_arm: [i64] = []
var flat_if_chain_last_arm: [i64] = []
var flat_if_chain_arm_count: [i64] = []
var flat_if_chain_else_expr: [i64] = []
var flat_if_chain_else_stmt_first: [i64] = []
var flat_if_chain_else_stmt_count: [i64] = []
var flat_if_chain_span: [i64] = []

var flat_if_arm_next: [i64] = []
var flat_if_arm_chain: [i64] = []
var flat_if_arm_kind: [i64] = []
var flat_if_arm_head: [i64] = []
var flat_if_arm_init: [i64] = []
var flat_if_arm_then_expr: [i64] = []
var flat_if_arm_body_first: [i64] = []
var flat_if_arm_body_count: [i64] = []
var flat_if_arm_span: [i64] = []
var flat_if_arm_rationale: [text] = []

var flat_if_stmt_items: [i64] = []
var flat_if_chain_prepared_slot: [text] = ["prepared"]

fn flat_if_chain_prepare_persistent_shells():
    if flat_if_chain_prepared_slot == nil or flat_if_chain_prepared_slot.len() == 0:
        flat_if_chain_prepared_slot = [""]
    if flat_if_chain_form == nil: flat_if_chain_form = []
    if flat_if_chain_first_arm == nil: flat_if_chain_first_arm = []
    if flat_if_chain_last_arm == nil: flat_if_chain_last_arm = []
    if flat_if_chain_arm_count == nil: flat_if_chain_arm_count = []
    if flat_if_chain_else_expr == nil: flat_if_chain_else_expr = []
    if flat_if_chain_else_stmt_first == nil: flat_if_chain_else_stmt_first = []
    if flat_if_chain_else_stmt_count == nil: flat_if_chain_else_stmt_count = []
    if flat_if_chain_span == nil: flat_if_chain_span = []
    if flat_if_arm_next == nil: flat_if_arm_next = []
    if flat_if_arm_chain == nil: flat_if_arm_chain = []
    if flat_if_arm_kind == nil: flat_if_arm_kind = []
    if flat_if_arm_head == nil: flat_if_arm_head = []
    if flat_if_arm_init == nil: flat_if_arm_init = []
    if flat_if_arm_then_expr == nil: flat_if_arm_then_expr = []
    if flat_if_arm_body_first == nil: flat_if_arm_body_first = []
    if flat_if_arm_body_count == nil: flat_if_arm_body_count = []
    if flat_if_arm_span == nil: flat_if_arm_span = []
    if flat_if_arm_rationale == nil: flat_if_arm_rationale = []
    if flat_if_stmt_items == nil: flat_if_stmt_items = []
    flat_if_chain_prepared_slot[0] = "prepared"

fn flat_if_chain_owner_ready() -> bool:
    # Empty owner arenas are valid prepared state and compare nil-like in the
    # bootstrap runtime.  Read the durable slot rather than using emptiness as
    # an ownership sentinel (the same contract as parser readiness).
    flat_if_chain_prepared_slot.len() > 0 and flat_if_chain_prepared_slot[0] == "prepared"

fn flat_if_chain_id_is_live(chain_id: i64) -> bool:
    if not flat_if_chain_owner_ready() or chain_id < 0:
        return false
    (chain_id < flat_if_chain_form.len() and
        chain_id < flat_if_chain_first_arm.len() and
        chain_id < flat_if_chain_last_arm.len() and
        chain_id < flat_if_chain_arm_count.len() and
        chain_id < flat_if_chain_else_expr.len() and
        chain_id < flat_if_chain_else_stmt_first.len() and
        chain_id < flat_if_chain_else_stmt_count.len() and
        chain_id < flat_if_chain_span.len())

fn flat_if_arm_id_is_live(arm_id: i64) -> bool:
    if not flat_if_chain_owner_ready() or arm_id < 0:
        return false
    (arm_id < flat_if_arm_next.len() and
        arm_id < flat_if_arm_chain.len() and
        arm_id < flat_if_arm_kind.len() and
        arm_id < flat_if_arm_head.len() and
        arm_id < flat_if_arm_init.len() and
        arm_id < flat_if_arm_then_expr.len() and
        arm_id < flat_if_arm_body_first.len() and
        arm_id < flat_if_arm_body_count.len() and
        arm_id < flat_if_arm_span.len() and
        arm_id < flat_if_arm_rationale.len())

fn flat_if_stmt_range_is_live(first: i64, count: i64) -> bool:
    if count < 0:
        return false
    if count == 0:
        return first == -1
    first >= 0 and first <= flat_if_stmt_items.len() and count <= flat_if_stmt_items.len() - first

fn flat_if_arm_kind_is_valid(kind: i64) -> bool:
    kind == ARM_CONDITION or kind == ARM_VALUE_BIND or kind == ARM_PATTERN_BIND

# Validate the complete scalar owner before a bridge consumer walks it.  The
# exact-count traversal must terminate at -1: a short row, extra tail, cycle,
# or cross-chain link is malformed and is never partially materialized.
fn flat_if_chain_is_well_formed(chain_id: i64, expected_form: i64) -> bool:
    if not flat_if_chain_id_is_live(chain_id):
        return false
    if expected_form != FORM_STMT and expected_form != FORM_EXPR:
        return false
    if flat_if_chain_form[chain_id] != expected_form:
        return false

    val count = flat_if_chain_arm_count[chain_id]
    if count <= 0:
        return false
    if flat_if_chain_first_arm[chain_id] < 0 or flat_if_chain_last_arm[chain_id] < 0:
        return false

    if expected_form == FORM_STMT:
        if flat_if_chain_else_expr[chain_id] != -1:
            return false
        if not flat_if_stmt_range_is_live(
            flat_if_chain_else_stmt_first[chain_id], flat_if_chain_else_stmt_count[chain_id]):
            return false
    else:
        if flat_if_chain_else_stmt_first[chain_id] != -1 or flat_if_chain_else_stmt_count[chain_id] != 0:
            return false
        val else_expr = flat_if_chain_else_expr[chain_id]
        if else_expr < -1:
            return false

    var arm_id = flat_if_chain_first_arm[chain_id]
    var walked = 0
    var last_seen = -1
    while walked < count:
        if not flat_if_arm_id_is_live(arm_id):
            return false
        if flat_if_arm_chain[arm_id] != chain_id:
            return false
        val kind = flat_if_arm_kind[arm_id]
        if not flat_if_arm_kind_is_valid(kind) or flat_if_arm_head[arm_id] < 0:
            return false
        if kind == ARM_CONDITION:
            if flat_if_arm_init[arm_id] != -1:
                return false
        elif flat_if_arm_init[arm_id] < 0:
            return false

        if expected_form == FORM_STMT:
            if flat_if_arm_then_expr[arm_id] != -1:
                return false
            if not flat_if_stmt_range_is_live(
                flat_if_arm_body_first[arm_id], flat_if_arm_body_count[arm_id]):
                return false
        else:
            if flat_if_arm_then_expr[arm_id] < 0:
                return false
            if flat_if_arm_body_first[arm_id] != -1 or flat_if_arm_body_count[arm_id] != 0:
                return false

        last_seen = arm_id
        arm_id = flat_if_arm_next[arm_id]
        walked = walked + 1

    arm_id == -1 and last_seen == flat_if_chain_last_arm[chain_id]

fn flat_if_chain_reset():
    flat_if_chain_prepare_persistent_shells()
    flat_if_chain_form.clear()
    flat_if_chain_first_arm.clear()
    flat_if_chain_last_arm.clear()
    flat_if_chain_arm_count.clear()
    flat_if_chain_else_expr.clear()
    flat_if_chain_else_stmt_first.clear()
    flat_if_chain_else_stmt_count.clear()
    flat_if_chain_span.clear()
    flat_if_arm_next.clear()
    flat_if_arm_chain.clear()
    flat_if_arm_kind.clear()
    flat_if_arm_head.clear()
    flat_if_arm_init.clear()
    flat_if_arm_then_expr.clear()
    flat_if_arm_body_first.clear()
    flat_if_arm_body_count.clear()
    flat_if_arm_span.clear()
    flat_if_arm_rationale.clear()
    flat_if_stmt_items.clear()

fn flat_if_chain_new(form: i64, span_id: i64) -> i64:
    if not flat_if_chain_owner_ready():
        return -1
    if form != FORM_STMT and form != FORM_EXPR:
        return -1
    val chain_id = flat_if_chain_form.len()
    flat_if_chain_form.push(form)
    flat_if_chain_first_arm.push(-1)
    flat_if_chain_last_arm.push(-1)
    flat_if_chain_arm_count.push(0)
    flat_if_chain_else_expr.push(-1)
    flat_if_chain_else_stmt_first.push(-1)
    flat_if_chain_else_stmt_count.push(0)
    flat_if_chain_span.push(span_id)
    chain_id

fn flat_if_stmt_chain_new(span_id: i64) -> i64:
    flat_if_chain_new(FORM_STMT, span_id)

fn flat_if_expr_chain_new(span_id: i64) -> i64:
    flat_if_chain_new(FORM_EXPR, span_id)

fn flat_if_arm_append_owner(chain_id: i64, kind: i64, head_expr: i64, init_expr: i64, then_expr: i64, span_id: i64) -> i64:
    if not flat_if_chain_id_is_live(chain_id) or not flat_if_arm_kind_is_valid(kind):
        return -1
    val form = flat_if_chain_form[chain_id]
    if form == FORM_STMT and then_expr != -1:
        return -1
    if form == FORM_EXPR and then_expr < 0:
        return -1
    if kind == ARM_CONDITION and init_expr != -1:
        return -1
    if kind != ARM_CONDITION and init_expr < 0:
        return -1
    if head_expr < 0:
        return -1
    val arm_id = flat_if_arm_next.len()
    flat_if_arm_next.push(-1)
    flat_if_arm_chain.push(chain_id)
    flat_if_arm_kind.push(kind)
    flat_if_arm_head.push(head_expr)
    flat_if_arm_init.push(init_expr)
    flat_if_arm_then_expr.push(then_expr)
    flat_if_arm_body_first.push(-1)
    flat_if_arm_body_count.push(0)
    flat_if_arm_span.push(span_id)
    flat_if_arm_rationale.push("")
    val last = flat_if_chain_last_arm[chain_id]
    if last >= 0:
        flat_if_arm_next[last] = arm_id
    else:
        flat_if_chain_first_arm[chain_id] = arm_id
    flat_if_chain_last_arm[chain_id] = arm_id
    flat_if_chain_arm_count[chain_id] = flat_if_chain_arm_count[chain_id] + 1
    arm_id

fn flat_if_stmt_arm_append(chain_id: i64, kind: i64, head_expr: i64, init_expr: i64, span_id: i64) -> i64:
    if not flat_if_chain_id_is_live(chain_id) or flat_if_chain_form[chain_id] != FORM_STMT:
        return -1
    flat_if_arm_append_owner(chain_id, kind, head_expr, init_expr, -1, span_id)

fn flat_if_stmt_arm_body_append(arm_id: i64, stmt_id: i64):
    if not flat_if_arm_id_is_live(arm_id) or stmt_id < 0:
        return
    val chain_id = flat_if_arm_chain[arm_id]
    if not flat_if_chain_id_is_live(chain_id) or flat_if_chain_form[chain_id] != FORM_STMT:
        return
    if flat_if_arm_body_count[arm_id] == 0:
        flat_if_arm_body_first[arm_id] = flat_if_stmt_items.len()
    flat_if_stmt_items.push(stmt_id)
    flat_if_arm_body_count[arm_id] = flat_if_arm_body_count[arm_id] + 1

fn flat_if_expr_arm_append(chain_id: i64, kind: i64, head_expr: i64, init_expr: i64, then_expr: i64, span_id: i64) -> i64:
    if not flat_if_chain_id_is_live(chain_id) or flat_if_chain_form[chain_id] != FORM_EXPR:
        return -1
    flat_if_arm_append_owner(chain_id, kind, head_expr, init_expr, then_expr, span_id)

fn flat_if_stmt_else_append(chain_id: i64, stmt_id: i64):
    if not flat_if_chain_id_is_live(chain_id) or flat_if_chain_form[chain_id] != FORM_STMT or stmt_id < 0:
        return
    if flat_if_chain_else_stmt_count[chain_id] == 0:
        flat_if_chain_else_stmt_first[chain_id] = flat_if_stmt_items.len()
    flat_if_stmt_items.push(stmt_id)
    flat_if_chain_else_stmt_count[chain_id] = flat_if_chain_else_stmt_count[chain_id] + 1

fn flat_if_expr_else_set(chain_id: i64, expr_id: i64):
    if not flat_if_chain_id_is_live(chain_id) or flat_if_chain_form[chain_id] != FORM_EXPR or expr_id < -1:
        return
    flat_if_chain_else_expr[chain_id] = expr_id

fn flat_if_arm_rationale_set(arm_id: i64, rationale: text):
    if not flat_if_arm_id_is_live(arm_id):
        return
    flat_if_arm_rationale[arm_id] = rationale

fn flat_if_chain_form_get(chain_id: i64) -> i64:
    if not flat_if_chain_id_is_live(chain_id): return -1
    flat_if_chain_form[chain_id]
fn flat_if_chain_first_arm_get(chain_id: i64) -> i64:
    if not flat_if_chain_id_is_live(chain_id): return -1
    flat_if_chain_first_arm[chain_id]
fn flat_if_chain_arm_count_get(chain_id: i64) -> i64:
    if not flat_if_chain_id_is_live(chain_id): return -1
    flat_if_chain_arm_count[chain_id]
fn flat_if_chain_span_get(chain_id: i64) -> i64:
    if not flat_if_chain_id_is_live(chain_id): return -1
    flat_if_chain_span[chain_id]
fn flat_if_chain_else_expr_get(chain_id: i64) -> i64:
    if not flat_if_chain_id_is_live(chain_id): return -1
    flat_if_chain_else_expr[chain_id]
fn flat_if_chain_else_stmt_count_get(chain_id: i64) -> i64:
    if not flat_if_chain_id_is_live(chain_id): return -1
    flat_if_chain_else_stmt_count[chain_id]
fn flat_if_chain_else_stmt_at(chain_id: i64, offset: i64) -> i64:
    if not flat_if_chain_id_is_live(chain_id) or offset < 0:
        return -1
    val count = flat_if_chain_else_stmt_count[chain_id]
    val first = flat_if_chain_else_stmt_first[chain_id]
    if offset >= count or not flat_if_stmt_range_is_live(first, count):
        return -1
    flat_if_stmt_items[first + offset]

fn flat_if_arm_next_get(arm_id: i64) -> i64:
    if not flat_if_arm_id_is_live(arm_id): return -1
    flat_if_arm_next[arm_id]
fn flat_if_arm_kind_get(arm_id: i64) -> i64:
    if not flat_if_arm_id_is_live(arm_id): return -1
    flat_if_arm_kind[arm_id]
fn flat_if_arm_head_get(arm_id: i64) -> i64:
    if not flat_if_arm_id_is_live(arm_id): return -1
    flat_if_arm_head[arm_id]
fn flat_if_arm_init_get(arm_id: i64) -> i64:
    if not flat_if_arm_id_is_live(arm_id): return -1
    flat_if_arm_init[arm_id]
fn flat_if_arm_then_expr_get(arm_id: i64) -> i64:
    if not flat_if_arm_id_is_live(arm_id): return -1
    flat_if_arm_then_expr[arm_id]
fn flat_if_arm_span_get(arm_id: i64) -> i64:
    if not flat_if_arm_id_is_live(arm_id): return -1
    flat_if_arm_span[arm_id]
fn flat_if_arm_rationale_get(arm_id: i64) -> text:
    if not flat_if_arm_id_is_live(arm_id): return ""
    flat_if_arm_rationale[arm_id]
fn flat_if_arm_body_count_get(arm_id: i64) -> i64:
    if not flat_if_arm_id_is_live(arm_id): return -1
    flat_if_arm_body_count[arm_id]
fn flat_if_arm_body_at(arm_id: i64, offset: i64) -> i64:
    if not flat_if_arm_id_is_live(arm_id) or offset < 0:
        return -1
    val count = flat_if_arm_body_count[arm_id]
    val first = flat_if_arm_body_first[arm_id]
    if offset >= count or not flat_if_stmt_range_is_live(first, count):
        return -1
    flat_if_stmt_items[first + offset]
