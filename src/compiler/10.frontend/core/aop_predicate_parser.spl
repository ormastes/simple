# AOP Predicate Parser — Validates pc{...} expressions
#
# Validates that pointcut expressions use only supported selectors
# and have correct syntax. Returns error text on failure, empty on success.
#
# Supported selectors: execution(...), within(...), attr(...)
# Supported operators: & (AND), | (OR), ! (NOT), ( ) (grouping)
# Deferred selectors: get, set, init, effect → E1507

# ============================================================================
# Predicate Validation
# ============================================================================

pub fn aop_predicate_tokens(input: text) -> [text]:
    """Shared lexical contract for raw and parser-serialized pointcuts."""
    var tokens: [text] = []
    var word = ""
    var comment = false
    for ch in input.chars():
        if comment:
            if ch == "\n" or ch == "\r":
                comment = false
        elif ch == "#":
            if word != "":
                tokens.push(word)
                word = ""
            comment = true
        elif ch == " " or ch == "\t" or ch == "\n" or ch == "\r":
            if word != "":
                tokens.push(word)
                word = ""
        elif ch == "(" or ch == ")" or ch == "&" or ch == "|" or ch == "!" or ch == "." or ch == "*" or ch == ",":
            if word != "":
                tokens.push(word)
                word = ""
            tokens.push(ch)
        else:
            word = word + ch
    if word != "":
        tokens.push(word)
    tokens

pub fn aop_predicate_canonical_text(input: text) -> text:
    var result = ""
    for token in aop_predicate_tokens(input):
        if result != "":
            result = result + " "
        result = result + token
    result

pub fn validate_predicate(input: text) -> text:
    """Validate Boolean selector syntax without enabling deferred selectors."""
    if input == nil:
        return "E1501: empty pointcut expression"
    validate_predicate_tokens(aop_predicate_tokens(input))

pub fn validate_predicate_tokens(tokens: [text]) -> text:
    """Validate the shared token array without scanning source twice."""
    if tokens.len() == 0:
        return "E1501: empty pointcut expression"
    if tokens.len() == 1 and tokens[0] == "*":
        return ""
    var i = 0
    var depth = 0
    var needs_operand = true
    while i < tokens.len():
        val token = tokens[i]
        if needs_operand:
            if token == ")" or token == "&" or token == "|":
                return "E1501: expected pointcut operand"
            if token == "!":
                i = i + 1
            elif token == "(":
                depth = depth + 1
                i = i + 1
            else:
                val err = validate_selector(token)
                if err != "":
                    return err
                if i + 1 >= tokens.len():
                    return "E1501: expected selector argument list"
                if tokens[i + 1] != "(":
                    return "E1501: expected selector argument list"
                i = i + 2
                val content_start = i
                var selector_depth = 1
                while i < tokens.len() and selector_depth > 0:
                    if tokens[i] == "(":
                        selector_depth = selector_depth + 1
                    elif tokens[i] == ")":
                        selector_depth = selector_depth - 1
                    i = i + 1
                if selector_depth != 0:
                    return "E1501: unmatched opening parenthesis in pointcut"
                if i == content_start + 1:
                    return "E1501: empty selector argument list"
                needs_operand = false
        elif token == "&" or token == "|":
            needs_operand = true
            i = i + 1
        elif token == ")":
            if depth == 0:
                return "E1501: unmatched closing parenthesis in pointcut"
            depth = depth - 1
            i = i + 1
        else:
            return "E1501: expected Boolean operator in pointcut"
    if needs_operand:
        return "E1501: expected pointcut operand"
    if depth != 0:
        return "E1501: unmatched opening parenthesis in pointcut"
    ""

fn extract_selectors(expr: text) -> [text]:
    """Return selector names using the shared lexical boundary."""
    val tokens = aop_predicate_tokens(expr)
    var result: [text] = []
    var i = 0
    while i + 1 < tokens.len():
        if tokens[i].len() > 0 and aop_is_ident_start(tokens[i][0]) and tokens[i + 1] == "(":
            result.push(tokens[i])
            i = i + 2
            var depth = 1
            while i < tokens.len() and depth > 0:
                if tokens[i] == "(": depth = depth + 1
                elif tokens[i] == ")": depth = depth - 1
                i = i + 1
        else:
            i = i + 1
    result

fn validate_selector(name: text) -> text:
    """Validate that a selector name is in the supported set."""
    if name == "execution": return ""
    if name == "within": return ""
    if name == "attr": return ""
    # Deferred selectors — reject with E1507
    if name == "get": return "E1507: selector 'get' is deferred — not supported in current AOP subset"
    if name == "set": return "E1507: selector 'set' is deferred — not supported in current AOP subset"
    if name == "init": return "E1507: selector 'init' is deferred — not supported in current AOP subset"
    if name == "effect": return "E1507: selector 'effect' is deferred — not supported in current AOP subset"
    "E1507: unknown pointcut selector '{name}'"

fn validate_advice_form(form: text) -> text:
    """Validate that an advice form is supported."""
    if form == "before": return ""
    if form == "after_success": return ""
    if form == "after_error": return ""
    if form == "around": return ""
    "E1503: invalid advice type '{form}' — supported: before, after_success, after_error, around"

# ============================================================================
# Helper Functions
# ============================================================================

fn text_trim(s: text) -> text:
    """Trim leading and trailing whitespace."""
    var start = 0
    while start < s.len() and s[start] == " ":
        start = start + 1
    var end = s.len()
    while end > start and s[end - 1] == " ":
        end = end - 1
    if start >= end: return ""
    s.slice(start, end)
fn aop_is_ident_start(ch: text) -> bool:
    if ch == nil: return false
    if ch.len() != 1: return false
    val c = ch[0]
    val lower = c >= "a" and c <= "z"
    val upper = c >= "A" and c <= "Z"
    val under = c == "_"
    lower or upper or under

fn aop_is_ident_continue(ch: text) -> bool:
    if aop_is_ident_start(ch): return true
    val c = ch[0]
    c >= "0" and c <= "9"

# Atom-aware inventory only; selector validation remains authoritative.
pub fn aop_predicate_has_field_selector_v1(expression: text) -> bool:
    val tokens = aop_predicate_tokens(expression)
    var index = 0
    while index < tokens.len():
        val token = tokens[index]
        if token != "(" and token != ")" and token != "!" and token != "&" and token != "|" and index + 1 < tokens.len() and tokens[index + 1] == "(":
            if token == "get" or token == "set": return true
            # A callable named get inside execution(...) is not a field selector.
            var depth = 1
            index = index + 2
            while index < tokens.len() and depth > 0:
                if tokens[index] == "(": depth = depth + 1
                elif tokens[index] == ")": depth = depth - 1
                index = index + 1
        else:
            index = index + 1
    false
