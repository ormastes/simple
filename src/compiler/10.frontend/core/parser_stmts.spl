extern fn rt_env_get(key: text) -> text

fn parser_stmt_trace_enabled() -> bool:
    (rt_env_get("SIMPLE_COMPILER_TRACE") ?? "") == "1"

fn parser_stmt_trace_line_enabled() -> bool:
    parser_stmt_trace_enabled() and par_line_get() >= 60

fn parse_optional_rationale_args() -> text:
    var msg = ""
    if par_kind_get() == 140:
        parser_advance()
        if par_kind_get() == 3:
            msg = par_text_get()
            parser_advance()
            if par_kind_get() == 160:
                parser_advance()
                if par_kind_get() == 3:
                    val hint = par_text_get()
                    parser_advance()
                    if hint != "":
                        if msg != "":
                            msg = msg + " | " + hint
                        else:
                            msg = hint
        parser_expect(141)
    msg

fn extract_wildcard_rationale(pattern_idx: i64) -> text:
    if pattern_idx < 0:
        return ""
    if expr_get_tag(pattern_idx) != EXPR_CALL:
        return ""
    val callee_idx = expr_get_left(pattern_idx)
    if callee_idx < 0:
        return ""
    if expr_get_tag(callee_idx) != EXPR_IDENT:
        return ""
    if expr_get_str(callee_idx) != "_":
        return ""
    val args = expr_get_args(pattern_idx)
    if args.len() == 0:
        return ""
    val first_arg = args[0]
    if first_arg < 0:
        return ""
    if expr_get_tag(first_arg) != EXPR_STRING_LIT:
        return ""
    expr_get_str(first_arg)

fn normalize_wildcard_pattern(pattern_idx: i64) -> i64:
    val rationale = extract_wildcard_rationale(pattern_idx)
    if rationale == "":
        return pattern_idx
    expr_ident("_", 0)

# ===== Type Inference Support =====

fn infer_expr_type_from_parse(expr_id: i64) -> i64:
    # Simple type inference based on expression kind
    # Returns TYPE_VOID (0) if type cannot be inferred
    if expr_id < 0:
        return 0
    val tag = expr_get_tag(expr_id)

    # Literal types
    if tag == EXPR_INT_LIT:
        return TYPE_I64
    if tag == EXPR_FLOAT_LIT:
        return TYPE_F64
    if tag == EXPR_STRING_LIT:
        return TYPE_TEXT
    if tag == EXPR_BOOL_LIT:
        return TYPE_BOOL
    if tag == EXPR_NIL_LIT:
        return TYPE_NIL
    if tag == EXPR_ARRAY_LIT:
        return TYPE_ARRAY_ANY

    # Binary operations - infer from operator
    if tag == EXPR_BINARY:
        val op = expr_get_str(expr_id)
        if op == "+" or op == "-" or op == "*" or op == "/":
            # Could be i64 or f64, default to i64
            return TYPE_I64
        if (op == "==" or op == "!=" or op == "<" or op == ">" or
            op == "<=" or op == ">=" or op == "and" or op == "or"):
            return TYPE_BOOL
        return 0

    # Unary operations
    if tag == EXPR_UNARY:
        val op = expr_get_str(expr_id)
        if op == "not":
            return TYPE_BOOL
        if op == "-":
            return TYPE_I64
        return 0

    # Function calls - cannot infer without function signature
    if tag == EXPR_CALL:
        return 0

    # Default: cannot infer
    0

# ===== Block and Statement Parsing =====

# Trailing colon-block sugar: `callee(args):` / `recv.method(args):` in
# statement position, with the indented body becoming an implicit zero-arg
# lambda appended as the call's last argument (`describe("x"): ...` desugars
# to `describe("x", fn(): ...)`). Mirrors the Rust seed's
# `try_parse_colon_block` (src/compiler_rust/parser/src/expressions/
# no_paren.rs) which the pure-Simple frontend never had — see
# doc/08_tracking/bug/lint_parse001_false_positive_on_spec_files_2026-07-29.md.
# Callers only invoke this after already confirming `call_expr` is an
# EXPR_CALL/EXPR_METHOD_CALL AND the current token is TOK_COLON, so this can
# never intercept an `if cond():`/`while cond():` colon — those consume their
# own colon via parse_if_stmt/parse_while_stmt, a separate code path that
# never reaches this statement-expression fallback.
# `describe "name":` / `it "name":` — a bare identifier IMMEDIATELY followed
# (same line, no separator) by a string literal. This is the dominant DSL
# call shape across the spec-file corpus (~24k files use this no-paren form
# vs ~80 using `describe("name"):`) but the pure-Simple frontend never
# implemented generic no-paren calls (only "print" got a hand-special-cased
# one at module level) — see doc/08_tracking/bug/
# lint_parse001_false_positive_on_spec_files_2026-07-29.md. Without this, the
# identifier and the string literal were silently accepted as TWO unrelated
# expression-statements (the module/statement fallback never required a
# separator between them), so any code relying on `describe`'s block
# argument actually doing something was already semantically broken under
# this frontend, just not diagnosed. No other Simple construct places a bare
# identifier directly adjacent to a string literal with no operator between
# them, so folding this one shape into a real call cannot shadow any
# existing meaning. Returns (false, 0) when the lookahead doesn't match,
# leaving the token stream exactly as found (snapshot-restored).
fn try_parse_bare_ident_string_call() -> (bool, i64):
    val bc_name = par_text_get()
    val bc_snap = lex_snapshot_save()
    val (bc_tok_n, bc_tok_t) = parser_tok_save()
    parser_advance()
    if par_kind_get() != TOK_STRING_LIT:
        lex_snapshot_rollback(bc_snap)
        parser_tok_restore(bc_tok_n, bc_tok_t)
        return (false, 0)
    val bc_arg = parse_expr()
    var bc_args: [i64] = []
    bc_args.push(bc_arg)
    # Handle comma-separated additional arguments: `describe "name", fn(): ...`
    while par_kind_get() == TOK_COMMA:
        parser_advance()
        val next_arg = parse_expr()
        bc_args.push(next_arg)
    lex_snapshot_commit(bc_snap)
    (true, expr_call(expr_ident(bc_name, 0), bc_args, 0))

fn parse_trailing_colon_block_arg(call_expr: i64) -> i64:
    parser_expect(TOK_COLON)
    val body_stmts = parse_block()
    val block_expr = expr_block(body_stmts, -1, 0)
    var lambda_body: [i64] = []
    lambda_body.push(block_expr)
    var lambda_params: [i64] = []
    val lambda_idx = expr_lambda(lambda_params, lambda_body, 0)
    var cb_args = expr_get_args(call_expr)
    var cb_names = expr_get_arg_names(call_expr)
    cb_args.push(lambda_idx)
    cb_names.push("")
    expr_call_args_set(call_expr, cb_args, cb_names)
    call_expr

# Can `kind` legally open a FLAT body — a block body written on the NEXT line at
# the SAME column as its header (`if c:` / newline / `return v`)? Mirrors the
# Rust seed's `is_statement_start` in parser_impl/core.rs, which gates the same
# feature there. Without this gate the pure-Simple parser swallowed ANY following
# token as the flat body, so a BODYLESS `if c:` followed by a same-column
# expression (`7`) parsed as `if c: 7` and the enclosing function lost its tail
# expression — accepted, then miscompiled to garbage (0x80000004 instead of 7).
# See doc/08_tracking/bug/seed_accepts_bodyless_if_native_build_rejects_2026-08-22.md
fn parse_block_flat_body_can_start(kind: i64) -> bool:
    if kind == 6: return true         # Ident (call / assignment statement)
    if kind == 40: return true        # if
    if kind == 43: return true        # match
    if kind == 45: return true        # for
    if kind == 46: return true        # while
    if kind == 47: return true        # break
    if kind == 48: return true        # continue
    if kind == 49: return true        # return
    if kind == 51: return true        # loop
    if kind == 52: return true        # pass
    if kind == 20: return true        # fn
    if kind == 21: return true        # val
    if kind == 22: return true        # var
    if kind == 25: return true        # extern
    if kind == 26: return true        # export
    if kind == 27: return true        # use
    if kind == 28: return true        # import
    if kind == 34: return true        # me
    if kind == 183: return true       # pass_todo
    if kind == 184: return true       # pass_do_nothing
    if kind == 185: return true       # pass_dn
    if kind == 186: return true       # defer
    if kind == 187: return true       # errdefer
    if kind == 188: return true       # const
    if kind == 192: return true       # 'label
    if kind == 201: return true       # static_for
    if kind == 202: return true       # comptime
    if kind == 204: return true       # bind
    if kind == 206: return true       # receive
    if kind == 37: return true        # yield
    if kind == 38: return true        # self
    if kind == 53: return true        # async
    if kind == 54: return true        # await
    if kind == 169: return true       # _ (discard assignment)
    if kind == 195: return true       # do
    if kind == 197: return true       # spawn
    if kind == 203: return true       # mixin
    if kind == 205: return true       # ce
    if kind == 211: return true       # new
    false

fn parse_block() -> [i64]:
    var stmts: [i64] = []
    val crossed_newline = par_kind_get() == 180
    parser_skip_newlines()
    if par_kind_get() == 181:
        # Multi-line indented block
        parser_advance()
        for i in 0..100000:
            parser_skip_newlines()
            if par_kind_get() == 182:
                parser_advance()
                break
            if par_kind_get() == 190:
                break
            val s = parse_statement()
            stmts.push(s)
            parser_skip_newlines_and_semicolons()
        return stmts
    # Flat body: the block body sits on a LATER line at the same column as its
    # header. Only real statement-start tokens qualify; anything else (an
    # expression, a Dedent, Eof) means the header has NO body at all, which is a
    # parse error — Simple has `pass` for a deliberate no-op. A body on the SAME
    # line as the `:` never crossed a newline and is always allowed.
    if crossed_newline and not parse_block_flat_body_can_start(kind):
        parser_expect(181)
        return stmts
    # Single-line body (no indent): parse one statement
    val s = parse_statement()
    stmts.push(s)
    stmts

# Inline consumer for `use` inside function bodies.
# Avoids circular dependency: parser_decls_use.spl already imports parse_block from here,
# so we cannot import parse_use_decl back. Instead, consume the use-path and import list
# tokens and return a no-op pass statement so the rest of the function body parses cleanly.
fn parse_use_stmt_inline() -> i64:
    # Consume 'use' keyword (kind 27)
    parser_advance()
    # Skip optional 'lazy' modifier (kind 194)
    if par_kind_get() == 194:
        parser_advance()
    # Consume dotted path: ident(.ident)*
    for _ui in 0..200:
        val uk = par_kind_get()
        val is_ident_seg: bool = uk == 6
        val is_dot_seg: bool = uk == 164
        val is_star_seg: bool = uk == 62
        val is_seg: bool = is_ident_seg or is_dot_seg or is_star_seg
        if not is_seg:
            break
        parser_advance()
    # Consume optional brace import list: .{name, name, ...} or {name, ...}
    if par_kind_get() == 142:
        parser_advance()
        for _ul in 0..10000:
            val ulk = par_kind_get()
            if ulk == 143 or ulk == 190:
                break
            parser_advance()
        if par_kind_get() == 143:
            parser_advance()
    # Consume optional paren import list: .(name, name) or (name, ...)
    if par_kind_get() == 140:
        parser_advance()
        for _up in 0..10000:
            val upk = par_kind_get()
            if upk == 141 or upk == 190:
                break
            parser_advance()
        if par_kind_get() == 141:
            parser_advance()
    stmt_expr_stmt(expr_pass(0), 0)

# extern fn declaration inside a function body: register the signature
# globally (same as a top-level extern) and emit a no-op statement.
# Inlined here (like parse_use_stmt_inline) to avoid a circular dep with
# the decl-parsing modules, which import parse_block from this file.
fn parse_extern_fn_stmt_inline() -> i64:
    parser_advance()  # consume 'extern'
    parser_expect(20)
    val ef_name = par_text_get()
    parser_expect(6)
    parser_expect(140)
    var ef_pnames: [text] = []
    var ef_ptypes: [i64] = []
    for _ei in 0..100:
        if par_kind_get() == 141 or par_kind_get() == 190:
            break
        val ef_pn = par_text_get()
        parser_advance()  # param name (ident or keyword)
        var ef_pt = 0
        if par_kind_get() == 161:
            parser_advance()
            ef_pt = parser_parse_type()
        ef_pnames.push(ef_pn)
        ef_ptypes.push(ef_pt)
        if par_kind_get() == 160:
            parser_advance()
    parser_expect(141)
    var ef_ret = TYPE_VOID
    if par_kind_get() == 167:
        parser_advance()
        ef_ret = parser_parse_type()
    val ef_tparams: [text] = []
    decl_extern_fn(ef_name, ef_pnames, ef_ptypes, ef_ret, ef_tparams, 0)
    stmt_expr_stmt(expr_pass(0), 0)

fn parse_contract_clause_expr_stmt() -> i64:
    val start = lex_token_start_get()
    val line = par_line_get()
    val col = par_col_get()
    val expression = parse_expr()
    val span_id = flat_span_new(start, lex_token_start_get(), line, col)
    expr_set_span(expression, span_id)
    stmt_expr_stmt(expression, span_id)

fn parse_contract_clause_body() -> [i64]:
    var clauses: [i64] = []
    if par_kind_get() == TOK_NEWLINE:
        parser_skip_newlines()
        parser_expect(TOK_INDENT)
        while par_kind_get() != TOK_DEDENT and par_kind_get() != TOK_EOF:
            parser_skip_newlines()
            if par_kind_get() == TOK_DEDENT or par_kind_get() == TOK_EOF:
                break
            clauses.push(parse_contract_clause_expr_stmt())
            parser_skip_newlines_and_semicolons()
        parser_expect(TOK_DEDENT)
        return clauses
    clauses.push(parse_contract_clause_expr_stmt())
    clauses

fn try_parse_contract_stmt() -> i64:
    # Speculative recognition keeps ordinary identifiers such as `out(value)`
    # on the normal expression path.
    val snap = lex_snapshot_save()
    val (saved_nums, saved_text) = parser_tok_save()
    val first_kind = par_kind_get()
    val first_name = if first_kind == TOK_KW_IN: "in" else: par_text_get()
    val recognized = first_name == "in" or first_name == "requires" or
        first_name == "invariant" or first_name == "out" or
        first_name == "ensures" or first_name == "out_err" or
        first_name == "decreases" or first_name == "proof"
    if not recognized:
        lex_snapshot_commit(snap)
        return -1
    parser_advance()
    var binding = ""
    if first_name == "proof":
        if par_text_get() != "uses":
            lex_snapshot_rollback(snap)
            parser_tok_restore(saved_nums, saved_text)
            return -1
        parser_advance()
        if par_kind_get() != TOK_COLON:
            lex_snapshot_rollback(snap)
            parser_tok_restore(saved_nums, saved_text)
            return -1
        parser_advance()
        if par_kind_get() != TOK_IDENT:
            lex_snapshot_rollback(snap)
            parser_tok_restore(saved_nums, saved_text)
            return -1
        binding = par_text_get()
        parser_advance()
        lex_snapshot_commit(snap)
        return stmt_contract_clause(STMT_CONTRACT_PROOF_USES, binding, [], 0)
    if first_name == "out" or first_name == "out_err":
        if par_kind_get() != TOK_LPAREN:
            lex_snapshot_rollback(snap)
            parser_tok_restore(saved_nums, saved_text)
            return -1
        parser_advance()
        if par_kind_get() == TOK_UNDERSCORE:
            parser_advance()
        elif par_kind_get() == TOK_IDENT:
            binding = par_text_get()
            parser_advance()
        else:
            lex_snapshot_rollback(snap)
            parser_tok_restore(saved_nums, saved_text)
            return -1
        if par_kind_get() != TOK_RPAREN:
            lex_snapshot_rollback(snap)
            parser_tok_restore(saved_nums, saved_text)
            return -1
        parser_advance()
    if par_kind_get() != TOK_COLON:
        lex_snapshot_rollback(snap)
        parser_tok_restore(saved_nums, saved_text)
        return -1
    parser_advance()
    val body = parse_contract_clause_body()
    var tag = STMT_CONTRACT_IN
    if first_name == "invariant": tag = STMT_CONTRACT_INVARIANT
    elif first_name == "out" or first_name == "ensures": tag = STMT_CONTRACT_OUT
    elif first_name == "out_err": tag = STMT_CONTRACT_OUT_ERR
    elif first_name == "decreases": tag = STMT_CONTRACT_DECREASES
    lex_snapshot_commit(snap)
    stmt_contract_clause(tag, binding, body, 0)

fn parse_statement() -> i64:
    var kind = par_kind_get()
    val contract_stmt = try_parse_contract_stmt()
    if contract_stmt >= 0:
        return contract_stmt
    kind = par_kind_get()
    if kind == 21:
        return parse_val_decl_stmt()

    if par_kind_get() == 194:
        parser_advance()
        return parse_lazy_val_decl_stmt()

    if par_kind_get() == 22:
        return parse_var_decl_stmt()

    # use statement inside function body: consume tokens, return pass (no-op)
    # Avoids circular dep with parser_decls_use.spl (which imports parse_block from here).
    if par_kind_get() == 27:
        return parse_use_stmt_inline()

    if par_kind_get() == 49:
        parser_advance()
        val is_nl = par_kind_get() == 180
        val is_ded = par_kind_get() == 182
        val no_value = is_nl or is_ded
        if no_value:
            return stmt_return_stmt(-1, 0)
        val ret_val = parse_expr()
        return stmt_return_stmt(ret_val, 0)

    if par_kind_get() == 40:
        return parse_if_stmt()

    # Labeled loop: 'label: for/while
    if par_kind_get() == 192:
        val loop_label = par_text_get()
        parser_advance()
        # Expect colon after label
        parser_expect(161)
        # Then parse the loop and wrap in labeled_loop stmt
        if par_kind_get() == 45:
            val for_s = parse_for_stmt()
            return stmt_labeled_loop(loop_label, for_s, 0)
        if par_kind_get() == 46:
            val while_s = parse_while_stmt()
            return stmt_labeled_loop(loop_label, while_s, 0)
        # Fallthrough: ignore label if not followed by loop
        return parse_statement()

    if par_kind_get() == 45:
        return parse_for_stmt()

    if par_kind_get() == 201:
        return parse_static_for_stmt()

    if par_kind_get() == 202:
        parser_advance()
        if par_kind_get() == 161:
            parser_advance()
            val ct_body = parse_block()
            return stmt_comptime_block(ct_body, 0)
        # comptime fn inside a block: parse the fn as expression statement
        val ct_expr = parse_expr()
        return stmt_expr_stmt(ct_expr, 0)

    if par_kind_get() == 46:
        return parse_while_stmt()

    # Statement-form `loop:` -- desugar to `while true:` so downstream
    # (HIR/MIR/native) lowering treats it as a genuine loop instead of a
    # one-shot block. (Bug #163: native --entry ran `loop:` zero times
    # because the old expression-position parse produced a plain
    # expr_block with no loop semantics at all.) Loop-as-EXPRESSION
    # (e.g. `val x = loop: ... break v`) is untouched -- still handled
    # by the primary_expr.spl fallback -- since that path carries
    # break-with-value semantics that are out of scope here.
    if kind == TOK_KW_LOOP:
        val loop_snap = lex_snapshot_save()
        val (loop_tok_nums, loop_tok_text) = parser_tok_save()
        parser_advance()
        val is_loop_stmt = par_kind_get() == TOK_COLON
        lex_snapshot_rollback(loop_snap)
        parser_tok_restore(loop_tok_nums, loop_tok_text)
        if is_loop_stmt:
            return parse_loop_stmt()
        # `loop` is also an established keyword-named parameter. Restore it
        # and let the ordinary expression-statement path parse `loop.header`,
        # indexing, assignment, or a bare identifier.
        lex_snapshot_restore(loop_snap_nums, loop_snap_txts)
        parser_tok_restore(loop_tok_nums, loop_tok_text)

    if kind == 43:
        # G33: `match` may be an identifier (var match = true; match = false).
        # After consuming `match`, a token that cannot start an expression
        # means identifier usage. Tradeoff: scrutinees starting with -, (
        # still route to match-stmt (their kinds can start expressions).
        parser_advance()
        kind = par_kind_get()
        if g33_kw_ident_follow(kind):
            var mleft = parse_postfix_on(expr_ident("match", 0))
            mleft = parse_binary_from(mleft)
            if par_kind_get() == 100 or par_kind_get() == 106:
                parser_advance()
                return stmt_expr_stmt(expr_assign(mleft, parse_expr(), 0), 0)
            if par_kind_get() == 101:
                parser_advance()
                return stmt_expr_stmt(expr_compound_assign(60, mleft, parse_expr(), 0), 0)
            if par_kind_get() == 102:
                parser_advance()
                return stmt_expr_stmt(expr_compound_assign(61, mleft, parse_expr(), 0), 0)
            if par_kind_get() == 103:
                parser_advance()
                return stmt_expr_stmt(expr_compound_assign(62, mleft, parse_expr(), 0), 0)
            if par_kind_get() == 104:
                parser_advance()
                return stmt_expr_stmt(expr_compound_assign(63, mleft, parse_expr(), 0), 0)
            return stmt_expr_stmt(mleft, 0)
        return parse_match_stmt_tail()

    if par_kind_get() == 47:
        parser_advance()
        # Check for labeled break: break 'label
        if par_kind_get() == 192:
            val lbl = par_text_get()
            parser_advance()
            return stmt_break_labeled(lbl, 0)
        return stmt_break_stmt(0)

    if par_kind_get() == 48:
        parser_advance()
        # Check for labeled continue: continue 'label
        if par_kind_get() == 192:
            val lbl = par_text_get()
            parser_advance()
            return stmt_continue_labeled(lbl, 0)
        return stmt_continue_stmt(0)

    if par_kind_get() == 206:
        parser_advance()
        return parse_receive_stmt()

    if par_kind_get() == 204:
        parser_advance()
        return parse_bind_stmt()

    if par_kind_get() == 186:
        parser_advance()
        val deferred = parse_expr()
        return stmt_defer_stmt(deferred, 0)

    if par_kind_get() == 187:
        parser_advance()
        val err_deferred = parse_expr()
        return stmt_errdefer_stmt(err_deferred, 0)

    if par_kind_get() == 52:
        parser_advance()
        val msg = parse_optional_rationale_args()
        if msg == "":
            return stmt_expr_stmt(expr_pass(0), 0)
        return stmt_expr_stmt(expr_pass_with_msg(msg, 0), 0)

    if par_kind_get() == 183:
        parser_advance()
        val msg = parse_optional_rationale_args()
        if msg == "":
            parser_warn("REQC001: pass_todo requires a comment string: pass_todo(\"what remains\", \"hint or issue\")")
        if rt_is_debug_mode_enabled() and msg != "":
            print "[debug:pass] {msg}"
        return stmt_expr_stmt(expr_pass_todo(msg, 0), 0)

    if par_kind_get() == 184:
        parser_advance()
        val msg = parse_optional_rationale_args()
        if msg == "":
            parser_warn("REQC001: pass_do_nothing requires a comment string: pass_do_nothing(\"reason\")")
        if rt_is_debug_mode_enabled() and msg != "":
            print "[debug:pass] {msg}"
        return stmt_expr_stmt(expr_pass_do_nothing(msg, 0), 0)

    if par_kind_get() == 185:
        parser_advance()
        val msg = parse_optional_rationale_args()
        if msg == "":
            parser_warn("REQC001: pass_dn requires a comment string: pass_dn(\"reason\")")
        if rt_is_debug_mode_enabled() and msg != "":
            print "[debug:pass] {msg}"
        return stmt_expr_stmt(expr_pass_dn(msg, 0), 0)

    if kind == TOK_IDENT:
        val ident_text = par_text_get()
        # `unsafe:` / `danger:` block (contextual keyword, mirrors the seed
        # parser: compiler_rust/parser/src/parser_impl/core.rs:829-836). Only
        # treated as a block when the identifier is directly followed by a
        # colon (char-level lookahead past spaces/tabs).
        #
        # NOTE: `lex_peek_at` (module-level, lexer.spl) reads a legacy
        # `lex_state_get("pos", ...)` slot that CoreLexer.next_token() never
        # writes back to — it is permanently stale (observed stuck at "0"),
        # so peeking through it inspected the wrong end of the source and
        # this rule silently never fired. `lex_token_end_get()` returns the
        # live CoreLexer struct's `pos` right after the just-scanned token
        # (set in lexer.spl's `lex_next()`), so anchor the lookahead there
        # instead via plain source-char access.
        if ident_text == "unsafe" or ident_text == "danger":
            val uns_snap = lex_snapshot_save()
            val (uns_tok_nums, uns_tok_text) = parser_tok_save()
            parser_advance()
            if par_kind_get() == TOK_COLON:
                parser_advance()
                val unsafe_body = parse_block()
                lex_snapshot_commit(uns_snap)
                return stmt_expr_stmt(expr_unsafe_block(unsafe_body, 0), 0)
            if par_kind_get() == TOK_LPAREN:
                # `unsafe(reason: "...", capabilities: [type_erasure, ...]):`
                # — the capability-scoped block form (hardening plan §8.1).
                # Same argument grammar as the declaration-level `@unsafe(...)`
                # in _ParserDecls/enum_module_body.spl; the reason is accepted
                # and the capability names are carried on the block node.
                var uns_caps: [text] = []
                var uns_ok = true
                parser_advance()
                while par_kind_get() != TOK_RPAREN and par_kind_get() != TOK_EOF:
                    parser_skip_newlines()
                    if par_kind_get() != TOK_IDENT:
                        uns_ok = false
                        break
                    val uns_arg = par_text_get()
                    parser_advance()
                    if par_kind_get() != TOK_COLON:
                        uns_ok = false
                        break
                    parser_advance()
                    if uns_arg == "reason" and par_kind_get() == TOK_STRING_LIT:
                        parser_advance()
                    elif uns_arg == "capabilities" and par_kind_get() == TOK_LBRACKET:
                        parser_advance()
                        while par_kind_get() != TOK_RBRACKET and par_kind_get() != TOK_EOF:
                            if par_kind_get() == TOK_IDENT:
                                uns_caps.push(par_text_get())
                            elif par_kind_get() != TOK_COMMA:
                                uns_ok = false
                                break
                            parser_advance()
                        if par_kind_get() != TOK_RBRACKET:
                            uns_ok = false
                            break
                        parser_advance()
                    else:
                        uns_ok = false
                        break
                    parser_skip_newlines()
                    if par_kind_get() == TOK_COMMA:
                        parser_advance()
                if uns_ok and par_kind_get() == TOK_RPAREN:
                    parser_advance()
                    if par_kind_get() == TOK_COLON:
                        parser_advance()
                        val caps_body = parse_block()
                        lex_snapshot_commit(uns_snap)
                        return stmt_expr_stmt(expr_unsafe_block_with_caps(caps_body, uns_caps, 0), 0)
            lex_snapshot_rollback(uns_snap)
            parser_tok_restore(uns_tok_nums, uns_tok_text)
        if ident_text == "todo":
            parser_advance()
            val msg = parse_optional_rationale_args()
            if msg == "":
                parser_warn("REQC003: todo requires two strings: todo(\"what remains\", \"hint or issue\")")
            return stmt_expr_stmt(expr_pass_todo(msg, 0), 0)

    # Handle gpu_launch(grid: (...), block: (...)): body
    if par_kind_get() == 6:
        if par_text_get() == "gpu_launch":
            return parse_gpu_launch_stmt()

    # Handle bare 'print' keyword (print expr -- no parens)
    if par_kind_get() == 6:
        if par_text_get() == "print":
            parser_warn_print_if_needed()
            parser_advance()
            val is_nl = par_kind_get() == 180
            val is_ded = par_kind_get() == 182
            val is_eof = par_kind_get() == 190
            val no_arg = is_nl or is_ded
            val no_arg2 = no_arg or is_eof
            if no_arg2:
                val callee0 = expr_ident("print", 0)
                var args0: [i64] = []
                val call0 = expr_call(callee0, args0, 0)
                return stmt_expr_stmt(call0, 0)
            val print_arg = parse_expr()
            val callee1 = expr_ident("print", 0)
            var args1: [i64] = []
            args1.push(print_arg)
            val call1 = expr_call(callee1, args1, 0)
            return stmt_expr_stmt(call1, 0)

        if ident_text == "assert":
            parser_advance()
            val assert_cond = parse_expr()
            if par_kind_get() == 160:
                parser_advance()
                val _assert_msg = parse_expr()
            return stmt_expr_stmt(assert_cond, 0)

        # WP-K (resource ownership, doc/03_plan/language/resource/
        # resource_parallel_agent_plan_2026-08-06.md): `with ACQUIRE as NAME:
        # BODY` scoped form. `with` is a SOFT keyword recognized ONLY here, at
        # statement-start position -- the pre-existing class-header mixin form
        # (`class X with Read, Write:`, fn_struct_decls.spl's
        # parse_struct_or_trait_decl) is parsed by a completely different
        # function, reached only while parsing a class/struct/trait
        # declaration's header, never through parse_statement. The two forms
        # therefore never compete for the same token-stream position -- this
        # is the same positional-disambiguation technique WP-A used for
        # `resource` (soft keyword, no new reserved token). If what follows
        # `with` does not match `EXPR as NAME:`, backtrack and fall through
        # to ordinary identifier-expression parsing so `with` stays usable as
        # a plain identifier everywhere else.
        if ident_text == "with":
            val with_snap = lex_snapshot_save()
            val (with_tok_nums, with_tok_text) = parser_tok_save()
            parser_advance()  # consume 'with'
            # `as` is ALSO the cast operator (parser_expr.spl's parse_unary /
            # parse_binary_from), applied WITHIN ordinary expression parsing
            # at unary precedence -- tighter than any binary operator. A
            # plain parse_expr() call therefore already consumes `ACQUIRE as
            # NAME` itself as an `expr_cast(ACQUIRE, NAME-as-a-Type)` node
            # (NAME read as a bare named TYPE, not an identifier) before this
            # branch ever gets a chance to see an unconsumed TOK_KW_AS. Do
            # NOT look for a leftover `as` token after calling parse_expr()
            # -- there isn't one. Unwrap the cast shape instead: gated on the
            # very next token being ':' (so a genuine cast STATEMENT, `x as
            # SomeType` with no with-block colon following, is untouched and
            # keeps its pre-existing meaning/error behavior unchanged).
            val with_parsed = parse_expr()
            var with_ok = false
            var with_acquire = with_parsed
            var with_name = ""
            if expr_get_tag(with_parsed) == EXPR_CAST and par_kind_get() == TOK_COLON:
                val with_cast_type_id = expr_get_int(with_parsed) - TYPE_NAMED_BASE
                val with_cast_name = if with_cast_type_id >= 0: named_type_name(with_cast_type_id) else: ""
                if with_cast_name != "":
                    with_ok = true
                    with_acquire = expr_get_left(with_parsed)
                    with_name = with_cast_name
            if with_ok:
                parser_advance()  # consume ':'
                # Desugar to: val NAME = ACQUIRE ; BODY ; NAME.close()
                # wrapped in one nested block. `val NAME = ACQUIRE` (ACQUIRE
                # may itself end in `?`, e.g. `R.open(...)?`) reuses the
                # `val`-decl resource-local registration
                # (mir_lowering_stmts.spl) as-is: if ACQUIRE's own `?`
                # short-circuits, the val-decl never completes, so NAME is
                # never registered as a resource-owned local and there is
                # nothing to close -- exit (e). Once registered, WP-E's
                # existing function-scoped drop machinery
                # (emit_pending_resource_drops) covers every early exit
                # (explicit `return`, a `?` inside BODY) with zero new MIR
                # code; the explicit `NAME.close()` appended below covers the
                # one exit WP-E does NOT already cover as a byproduct: BODY's
                # own normal fall-through. `.close()` lowers to a consuming
                # Drop (method_calls_literals.spl) and marks NAME consumed,
                # so the function-end sweep does not double-drop it on that
                # path.
                val with_val_decl = stmt_val_decl(with_name, 0, with_acquire, 0)
                var with_stmts: [i64] = []
                with_stmts.push(with_val_decl)
                val with_body = parse_block()
                for with_body_stmt in with_body:
                    with_stmts.push(with_body_stmt)
                var with_close_args: [i64] = []
                val with_close_call = expr_method_call(expr_ident(with_name, 0), "close", with_close_args, 0)
                with_stmts.push(stmt_expr_stmt(with_close_call, 0))
                val with_block_expr = expr_block(with_stmts, -1, 0)
                lex_snapshot_commit(with_snap)
                return stmt_expr_stmt(with_block_expr, 0)
            # Not `with EXPR as NAME:` -- backtrack, `with` is a plain ident.
            lex_snapshot_rollback(with_snap)
            parser_tok_restore(with_tok_nums, with_tok_text)

    # `me NAME(...) [-> T]: body` in statement position (a class's methods
    # written at fn-body indent, e.g. semantics/resolve.spl) — same desugar
    # as the named nested fn below: `val NAME = fn(...): body`.
    # Only when an identifier follows: `me` is also the self-alias in
    # expressions (`me.backend.move_cursor(...)` in office/editor code),
    # which must fall through to the expression path — backtrack then.
    if kind == 34:
        val me_snap = lex_snapshot_save()
        val (me_tok_nums, me_tok_text) = parser_tok_save()
        parser_advance()  # consume me
        if par_kind_get() == TOK_IDENT:
            val me_stmt_name = par_text_get()
            parser_advance()
            val me_stmt_lambda = parse_fn_lambda_after_kw()
            lex_snapshot_commit(me_snap)
            return stmt_val_decl(me_stmt_name, 0, me_stmt_lambda, 0)
        lex_snapshot_rollback(me_snap)
        parser_tok_restore(me_tok_nums, me_tok_text)

    # G_named_nested_fn: `fn NAME(...): body` as a STATEMENT — a named nested
    # fn declared inside another fn's body (only anonymous `fn(...): ...`
    # lambdas parsed here before this fix). Distinguished from the anonymous
    # lambda-as-expression-statement form by the token right after `fn`: an
    # identifier (name) here vs. `(` there (handled by parse_fn_lambda_after_kw
    # via parse_expr's primary-expr fallback below).
    # Desugars to `val NAME = fn(...): body` (a local binding of the lambda).
    # Seed-semantics note (verified with bin/simple run on the Rust seed):
    # named nested fns work when called normally (interpreter resolves by
    # name; JIT/HIR lowering falls back to the interpreter for this shape),
    # but self-recursive calls fail seed-wide ("function X not found" — the
    # seed never pre-binds the name before evaluating the body). This
    # desugar matches that: it supports the non-recursive case only.
    if par_kind_get() == TOK_KW_FN:
        parser_advance()  # consume fn
        if par_kind_get() == TOK_IDENT:
            val nested_fn_name = par_text_get()
            parser_advance()  # consume name
            val nested_lambda = parse_fn_lambda_after_kw()
            return stmt_val_decl(nested_fn_name, 0, nested_lambda, 0)
        # fn(...): ... with no name — anonymous lambda expression statement.
        val anon_lambda = parse_fn_lambda_after_kw()
        return stmt_expr_stmt(anon_lambda, 0)

    # Expression statement (including assignment and walrus)
    # Note: Walrus operator handled inline during expression parsing
    # G31: tuple assignment (a, b) = expr is handled naturally:
    #   G29 makes (a, b) a tuple expr; parse_assignment sees = and builds expr_assign.
    val expression = parse_expr()
    if par_kind_get() == TOK_IDENT:
        val lane_name = par_text_get()
        if lane_name == "gpu" or lane_name == "host":
            parser_advance()
            if par_kind_get() == TOK_BACKSLASH:
                parser_advance()
            parser_expect(TOK_COLON)
            val lane_body = parse_block()
            val lane_block_expr = expr_block(lane_body, -1, 0)
            var lane_lambda_body: [i64] = []
            lane_lambda_body.push(lane_block_expr)
            var lane_params: [i64] = []
            val lane_lambda = expr_lambda(lane_params, lane_lambda_body, 0)
            var lane_args: [i64] = []
            lane_args.push(expression)
            lane_args.push(lane_lambda)
            return stmt_expr_stmt(expr_call(expr_ident(lane_name, 0), lane_args, 0), 0)
    stmt_expr_stmt(expression, 0)

# ===== Val/Var Declaration Statements =====

fn parse_val_decl_stmt() -> i64:
    parser_advance()

    # Tuple destructuring: val (a, b, c) = expr
    if par_kind_get() == 140:
        return parse_tuple_destructure_val()

    val some_binding = try_parse_some_destructure_binding(false)
    if some_binding >= 0:
        return some_binding

    # G23: discard binding `val _ = expr` (`_` is kind 169, not Ident)
    # G26: accept keyword tokens as binding names (e.g. val after = ...)
    var name = par_text_get()
    if par_kind_get() == 169:
        name = "_"
        parser_advance()
    else:
        val vd_kw_name = tok_kind_name(par_kind_get())
        val vd_is_kw = keyword_lookup(vd_kw_name) == par_kind_get()
        if vd_is_kw:
            name = vd_kw_name
            parser_advance()
        else:
            parser_expect(6)

    # Optional type annotation: val x: i64 = ...
    var type_tag = 0
    if par_kind_get() == 161:
        parser_advance()
        type_tag = parser_parse_type()

    parser_expect(100)
    val init = parse_expr()

    # Type inference: if no explicit type, try to infer from initializer
    if type_tag == 0:
        type_tag = infer_expr_type_from_parse(init)

    stmt_val_decl(name, type_tag, init, 0)

fn parse_lazy_val_decl_stmt() -> i64:
    parser_advance()
    val name = par_text_get()
    parser_expect(6)

    var type_tag = 0
    if par_kind_get() == 161:
        parser_advance()
        type_tag = parser_parse_type()

    parser_expect(100)
    val init = parse_expr()

    if type_tag == 0:
        type_tag = infer_expr_type_from_parse(init)

    stmt_lazy_val_decl(name, type_tag, init, 0)

fn parse_var_decl_stmt() -> i64:
    parser_advance()

    # Tuple destructuring: var (a, b, c) = expr
    if par_kind_get() == 140:
        return parse_tuple_destructure_var()

    val some_binding = try_parse_some_destructure_binding(true)
    if some_binding >= 0:
        return some_binding

    # G23: discard binding `var _ = expr` (`_` is kind 169, not Ident)
    # G26: accept keyword tokens as binding names (e.g. var after = ...)
    var name = par_text_get()
    if par_kind_get() == 169:
        name = "_"
        parser_advance()
    else:
        val vr_kw_name = tok_kind_name(par_kind_get())
        val vr_is_kw = keyword_lookup(vr_kw_name) == par_kind_get()
        if vr_is_kw:
            name = vr_kw_name
            parser_advance()
        else:
            parser_expect(6)

    var type_tag = 0
    if par_kind_get() == 161:
        parser_advance()
        type_tag = parser_parse_type()

    # Type inference for var declarations handled after initialization

    parser_expect(100)
    val init = parse_expr()
    stmt_var_decl(name, type_tag, init, 0)

# ===== Control Flow Statements =====

fn parse_if_stmt() -> i64:
    # Parse every arm in one forward pass.  The former implementation called
    # parse_if_stmt recursively for each `elif` / `else if`, making parser
    # stack and transient no-GC allocation proportional to chain length.
    # arm_kind: 0 = ordinary condition, 1 = identifier binding,
    # 2 = constructor-pattern binding.
    var arm_kind: [i64] = []
    var arm_head: [i64] = []
    var arm_init: [i64] = []
    var arm_body_offsets: [i64] = []
    var arm_body_counts: [i64] = []
    var arm_body_flat: [i64] = []
    var arm_start: [i64] = []
    var arm_line: [i64] = []
    var arm_col: [i64] = []
    var terminal_else: [i64] = []
    var collecting = true

        # Plain identifier binding.
        # Mark the synthetic binding so the interpreter unwraps Option only.
        val bind_name = expr_get_str(pattern_idx)
        val bind_stmt = stmt_if_val_decl(bind_name, init_expr, 0)
        val name_expr = expr_ident(bind_name, 0)
        val nil_expr = expr_nil_lit(0)
        val cond_expr = expr_binary(TOK_NEQ, name_expr, nil_expr, 0)
        val elif_idx = elif_new(cond_expr, then_body, else_body)
        val if_stmt = stmt_if_stmt(cond_expr, then_body, elif_idx, 0)
        var block_stmts: [i64] = []
        block_stmts.push(bind_stmt)
        block_stmts.push(if_stmt)
        return stmt_block_stmt(block_stmts, 0)

        if par_kind_get() == TOK_KW_VAL or par_kind_get() == TOK_KW_VAR:
            parser_advance()
            val pattern_idx = parse_or()
            val pattern_tag = expr_get_tag(pattern_idx)
            if pattern_tag != EXPR_CALL and pattern_tag != EXPR_METHOD_CALL and pattern_tag != EXPR_IDENT:
                parser_error("expected identifier or constructor pattern after if val/var")
            parser_expect(TOK_ASSIGN)
            val init_expr = parse_expr()
            parser_expect(TOK_COLON)
            val then_body = parse_block()
            if pattern_tag == EXPR_CALL or pattern_tag == EXPR_METHOD_CALL:
                arm_kind.push(2)
            else:
                # Preserve historical error recovery: after reporting an
                # invalid pattern tag, the old path still used identifier
                # binding desugaring rather than constructor-match lowering.
                arm_kind.push(1)
            arm_head.push(pattern_idx)
            arm_init.push(init_expr)
            arm_body_offsets.push(arm_body_flat.len())
            arm_body_counts.push(then_body.len())
            for body_stmt in then_body:
                arm_body_flat.push(body_stmt)
        else:
            val cond = parse_expr()
            parser_expect(TOK_COLON)
            val then_body = parse_block()
            arm_kind.push(0)
            arm_head.push(cond)
            arm_init.push(-1)
            arm_body_offsets.push(arm_body_flat.len())
            arm_body_counts.push(then_body.len())
            for body_stmt in then_body:
                arm_body_flat.push(body_stmt)

        parser_skip_newlines()
        if par_kind_get() == TOK_KW_ELIF:
            # Leave the keyword current; the next iteration consumes it.
            collecting = true
        elif par_kind_get() == TOK_KW_ELSE:
            parser_advance()
            if par_kind_get() == TOK_KW_IF:
                # G47: `else if` is another arm in the same collected chain.
                collecting = true
            else:
                parser_expect(TOK_COLON)
                terminal_else = parser_owned_stmt_list(parse_block())
                collecting = false
        else:
            collecting = false

    # Store the collected arms once, in source order.  Rebuilding a singleton
    # STMT_IF tail here copied the growing value-semantic aggregate once per
    # arm and reached geometric RSS on compiler-sized dispatch chains.
    val decision_end = lex_token_start_get()
    val chain_span = flat_span_new(arm_start[0], decision_end, arm_line[0], arm_col[0])
    val chain_id = flat_if_stmt_chain_new(chain_span)
    var ai = 0
    while ai < arm_kind.len():
        val decision_span = flat_span_new(arm_start[ai], decision_end, arm_line[ai], arm_col[ai])
        var stored_head = arm_head[ai]
        var rationale = ""
        if arm_kind[ai] == ARM_PATTERN_BIND:
            rationale = extract_wildcard_rationale(stored_head)
            stored_head = normalize_wildcard_pattern(stored_head)
        val arm_id = flat_if_stmt_arm_append(chain_id, arm_kind[ai], stored_head, arm_init[ai], decision_span)
        flat_if_arm_rationale_set(arm_id, rationale)
        var bi = 0
        while bi < arm_body[ai].len():
            flat_if_stmt_arm_body_append(arm_id, arm_body[ai][bi])
            bi = bi + 1
        ai = ai + 1
    var ei = 0
    while ei < terminal_else.len():
        flat_if_stmt_else_append(chain_id, terminal_else[ei])
        ei = ei + 1
    stmt_if_chain_stmt(chain_id, chain_span)

fn parse_for_binding_name() -> text:
    # G26/G40: plain identifiers must preserve their token text; keyword and
    # wildcard bindings use their canonical spelling.  This shared reader keeps
    # parenthesized and unparenthesized tuple loops semantically identical.
    if par_kind_get() == 169:
        parser_advance()
        return "_"
    if par_kind_get() == TOK_IDENT:
        val name = par_text_get()
        parser_expect(6)
        return name
    val kind_name = tok_kind_name(par_kind_get())
    if keyword_lookup(kind_name) == par_kind_get():
        parser_advance()
        return kind_name
    val name = par_text_get()
    parser_expect(6)
    name

fn encode_for_tuple_binding(names: [text]) -> text:
    var joined = "("
    var ni = 0
    while ni < names.len():
        if ni > 0:
            joined = joined + ","
        joined = joined + names[ni]
        ni = ni + 1
    joined + ")"

fn parse_for_stmt() -> i64:
    parser_advance()
    var iter_name = ""
    if par_kind_get() == 140:
        # Tuple destructuring: for (a, b) in list:
        # G40: any keyword or _ accepted as tuple-binding name via G26 round-trip.
        parser_advance()  # consume (
        var names: [text] = []
        # G26/G40 round-trip bug (see parse_tuple_destructure_val above):
        # tok_kind_name(TOK_IDENT) == "Ident" and keyword_lookup("Ident") ==
        # TOK_IDENT (the not-a-keyword fallback), so the keyword round-trip
        # check below is trivially true for EVERY plain identifier -- without
        # this explicit TOK_IDENT branch first, every `for (k, v) in ...`
        # name silently became the literal string "Ident" and the loop
        # body's real `k`/`v` were never bound ("unresolved name: k"/"v").
        if par_kind_get() == 169:
            names.push("_")
            parser_advance()
        elif par_kind_get() == TOK_IDENT:
            names.push(par_text_get())
            parser_expect(6)
        else:
            val ft0_kn = tok_kind_name(par_kind_get())
            if keyword_lookup(ft0_kn) == par_kind_get():
                names.push(ft0_kn)
                parser_advance()
            else:
                names.push(par_text_get())
                parser_expect(6)
        while par_kind_get() == 160:
            parser_advance()  # consume ,
            if par_kind_get() == 169:
                names.push("_")
                parser_advance()
            elif par_kind_get() == TOK_IDENT:
                names.push(par_text_get())
                parser_expect(6)
            else:
                val ftN_kn = tok_kind_name(par_kind_get())
                if keyword_lookup(ftN_kn) == par_kind_get():
                    names.push(ftN_kn)
                    parser_advance()
                else:
                    names.push(par_text_get())
                    parser_expect(6)
        parser_expect(141)
        # Encode tuple pattern as "(a,b,c)" in iter_name
        var joined = "("
        var ni = 0
        while ni < names.len():
            if ni > 0:
                joined = joined + ","
            joined = joined + names[ni]
            ni = ni + 1
        joined = joined + ")"
        iter_name = joined
    else:
        iter_name = par_text_get()
        parser_expect(6)
    parser_expect(50)
    val iterable = parse_expr()
    parser_expect(161)
    val body = parse_block()
    stmt_for_stmt(iter_name, iterable, body, 0)

fn parse_static_for_stmt() -> i64:
    parser_advance()
    val iter_name = par_text_get()
    parser_expect(6)
    parser_expect(50)
    val iterable = parse_expr()
    parser_expect(161)
    val body = parse_block()
    stmt_static_for_stmt(iter_name, iterable, body, 0)

fn parse_while_stmt() -> i64:
    val decision_start = lex_token_start_get()
    val decision_line = par_line_get()
    val decision_col = par_col_get()
    parser_advance()

    # G19: while val NAME = EXPR: body  (re-bind each iteration, break on nil)
    if par_kind_get() == TOK_KW_VAL or par_kind_get() == TOK_KW_VAR:
        parser_advance()  # consume val/var
        val bind_name = par_text_get()
        parser_expect(6)  # consume IDENT
        parser_expect(100)  # consume =
        val init_expr = parse_expr()
        parser_expect(161)  # consume :
        val body = parse_block()

        # Desugar: while true: { val NAME = EXPR; if NAME == nil: break; <body> }
        val bind_stmt = stmt_val_decl(bind_name, 0, init_expr, 0)
        val name_expr = expr_ident(bind_name, 0)
        val nil_expr2 = expr_nil_lit(0)
        # == is kind 80; break if NAME == nil
        val nil_cond_eq = expr_binary(80, name_expr, nil_expr2, 0)
        val nil_check_span = flat_span_new(decision_start + 1, decision_start + 2, decision_line, decision_col + 1)
        expr_set_span(nil_cond_eq, nil_check_span)
        var break_body: [i64] = []
        val break_s = stmt_break_stmt(0)
        break_body.push(break_s)
        val nil_check_if_idx = elif_new(nil_cond_eq, break_body, [])
        val nil_check_stmt = stmt_if_stmt(nil_cond_eq, break_body, nil_check_if_idx, nil_check_span)
        var loop_body: [i64] = []
        loop_body.push(bind_stmt)
        loop_body.push(nil_check_stmt)
        for i in 0..body.len():
            loop_body.push(body[i])
        val true_expr = expr_ident("true", 0)
        expr_set_span(true_expr, flat_span_new(decision_start, decision_start + 1, decision_line, decision_col))
        return stmt_while_stmt(true_expr, loop_body, flat_span_new(decision_start, lex_token_start_get(), decision_line, decision_col))

    val cond = parse_expr()
    parser_expect(161)
    val body = parse_block()
    stmt_while_stmt(cond, body, flat_span_new(decision_start, lex_token_start_get(), decision_line, decision_col))

# Statement-form `loop: <body>` -- desugar to the exact AST shape that
# `while true: <body>` produces (see the `true_expr` desugar above), so
# every downstream layer (type-check, HIR, MIR, native codegen) treats it
# as a genuine loop rather than a plain one-shot block.
fn parse_loop_stmt() -> i64:
    parser_advance()  # consume 'loop'
    parser_expect(161)  # consume ':'
    val body = parse_block()
    # Use the real EXPR_BOOL_LIT node (same as what parsing a literal
    # `true` token in expression position produces) rather than
    # expr_ident("true", ...), which HIR lowering treats as an unresolved
    # identifier and rejects.
    val true_expr = expr_bool_lit(1, 0)
    stmt_while_stmt(true_expr, body, 0)

# G33: kinds that cannot START an expression — a statement keyword followed
# by one of these is being used as an identifier, not a keyword.
fn g33_kw_ident_follow(kind: i64) -> bool:
    if kind >= 100 and kind <= 106:
        return true
    if kind == 141 or kind == 160 or kind == 161 or kind == 164 or kind == 168:
        return true
    if kind == 180 or kind == 181 or kind == 182:
        return true
    if kind == 55 or kind == 56:
        return true
    if kind >= 60 and kind <= 67:
        return true
    if kind >= 80 and kind <= 85:
        return true
    if kind >= 120 and kind <= 122:
        return true
    false

fn parse_match_stmt() -> i64:
    parser_advance()
    return parse_match_stmt_tail()

# Shared arm-parsing core for both `match` in STATEMENT position
# (parse_match_stmt_tail -> stmt_match_stmt, a side-effecting match with no
# value) and `match` in EXPRESSION position (parse_match_expr_tail ->
# expr_match_expr, a value-producing match, e.g. `val r = match n: ...`).
# Returns (scrutinee_expr_id, arm_indices) so each caller only differs in
# which AST constructor it wraps the result in.
fn parse_match_arms_common() -> (i64, [i64]):
    val scrutinee = parse_expr()
    parser_expect(161)
    parser_skip_newlines()
    parser_expect(181)

    var arm_indices: [i64] = []
    var kind = par_kind_get()
    for i in 0..1000:
        parser_skip_newlines()
        if par_kind_get() == 182:
            parser_advance()
            break
        if par_kind_get() == 190:
            break
        # `,` at ARM-BOUNDARY position inside a genuinely INDENTED match body
        # separates one arm from the next (`0 => 10, 1 => 20`) or trails the
        # last one (`_ => 0,`). Comma has two roles around an arm and they
        # never collide: BEFORE the arm's `:`/`=>` it is a multi-pattern
        # separator (`case 1, 2, 3:`), already consumed by the pattern loops
        # below; AFTER the arm body it is an arm separator. Without this the
        # comma fell through to the enclosing-list break just below, which
        # silently truncated the match at its first arm and then made the
        # enclosing parser choke with "expected pattern, found Comma" — that
        # is what made std `tooling/base64_utils.spl` unloadable in its
        # entirety. bug doc: doc/08_tracking/bug/
        #   match_arm_comma_separator_rejected_2026-08-02.md
        #
        # Gated on `saw_indent` so the INLINE shape below keeps its meaning:
        # `Box(a: match x: 1: "one" _: "o", b: x)` has no INDENT, so its comma
        # still terminates the enclosing list.
        if kind == TOK_COMMA and saw_indent and arm_indices.len() > 0:
            parser_advance()
            parser_skip_newlines()
            kind = par_kind_get()
            if kind == 182:
                parser_advance()
                break
            if kind == 190:
                break
            # Trailing comma immediately before the enclosing list's closer.
            if kind == TOK_RPAREN or kind == TOK_RBRACKET or kind == TOK_RBRACE:
                lex_pop_indent()
                break

        # A `match` used as a VALUE inside a call's arg list, a struct-literal
        # field list or a collection literal ends at that list's separator or
        # closing bracket, NOT at a DEDENT: the terminator shares the last
        # arm's line, so the lexer has not flushed a DEDENT yet. Without this
        # break the terminator fell through to the caseless-arm branch below
        # and was fed to parse_expr as if it started another pattern, which is
        # where `Box(a: match x: 1: "one" _: "o", b: x)` failed with
        # "expected pattern, found Comma" (and `found RParen` when the match
        # was the LAST element). Leave the terminator unconsumed for the
        # enclosing list parser and resync the lexer's indent stack, exactly
        # as the block-bodied lambda path does in
        # _ParserPrimary/primary_expr.spl.
        val ends_enclosing_list = kind == TOK_COMMA or kind == TOK_RPAREN or kind == TOK_RBRACKET or kind == TOK_RBRACE
        if ends_enclosing_list:
            if saw_indent:
                lex_pop_indent()
            break

        if par_kind_get() == 44:
            parser_advance()

            # Support multi-pattern: case X | Y | Z:
            # Parse first pattern
            var patterns: [i64] = []
            val ph_prev = set_placeholder_transform_suppressed(true)
            # `case complete b:` / `case dyn b:` region arms (§2 of
            # doc/05_design/compiler/hardening/critical_completeness_design_2026-08-21.md).
            # Patterns are parsed with the general EXPRESSION parser (see
            # convert_flat_pattern's docstring), and `complete b` / `dyn b` are
            # two juxtaposed tokens that no expression grammar accepts -- so
            # they are recognized HERE and lowered to a marker call
            # `__complete_region(b)` / `__dyn_region(b)`, which
            # convert_flat_pattern turns into PatternKind.CompleteRegion /
            # DynRegion. `complete` stays a SOFT keyword (ordinary identifier
            # everywhere else); `dyn` is already TOK_KW_DYN. Both require an
            # IDENT binder immediately after, so a plain `case complete:`
            # matching a variant named `complete` is unaffected.
            val region_marker = parse_match_region_marker()
            if region_marker >= 0:
                patterns.push(region_marker)
            else:
                patterns.push(parse_expr())

            # Check for pipe separator and collect additional patterns
            # Support multi-line patterns by skipping newlines/indents before pipes
            for skip_idx in 0..100:
                kind = par_kind_get()
                val is_nl = kind == 180
                val is_indent = kind == 181
                val should_skip = is_nl or is_indent
                if not should_skip:
                    break
                parser_advance()

            while par_kind_get() == 121:
                parser_advance()
                # Skip newlines/indents after pipe
                for skip_idx in 0..100:
                    kind = par_kind_get()
                    val is_nl = kind == 180
                    val is_indent = kind == 181
                    val should_skip = is_nl or is_indent
                    if not should_skip:
                        break
                    parser_advance()
                patterns.push(parse_expr())
                # Skip newlines/indents after pattern
                for skip_idx in 0..100:
                    kind = par_kind_get()
                    val is_nl = kind == 180
                    val is_indent = kind == 181
                    val should_skip = is_nl or is_indent
                    if not should_skip:
                        break
                    parser_advance()

            # Pattern list is complete -- restore the caller's placeholder
            # setting so the guard and the arm body keep normal `_` semantics.
            set_placeholder_transform_suppressed(ph_prev)

            # Check for guard clause: case X if guard_expr:
            var guard_expr_idx: i64 = -1
            if par_kind_get() == 40:
                parser_advance()
                guard_expr_idx = parse_expr()

            # Check for pattern binding: case X as binding_name:
            var pattern_binding = ""
            if par_kind_get() == TOK_KW_AS:
                parser_advance()
                pattern_binding = par_text_get()
                parser_expect(6)

            # Expect colon after all patterns
            parser_expect(161)
            val arm_body = parse_block()

            # Create an arm for each pattern (they share the same body and guard)
            for i in 0..patterns.len():
                val pattern_idx = patterns[i]
                val rationale = extract_wildcard_rationale(pattern_idx)
                val stored_pattern = normalize_wildcard_pattern(pattern_idx)
                val arm_idx = arm_new_with_binding_and_rationale(stored_pattern, guard_expr_idx, arm_body, pattern_binding, rationale)
                arm_indices.push(arm_idx)
        else:
            # Caseless arm: pattern directly followed by ':' (no 'case' keyword required)
            # e.g. `Enum.Variant:`, `Ok(v):`, `_:`, `0:`
            var patterns: [i64] = []
            patterns.push(parse_expr())

            # Check for guard clause: pattern if guard_expr:
            var guard_expr_idx: i64 = -1
            if par_kind_get() == 40:
                parser_advance()
                guard_expr_idx = parse_expr()

            # Check for pattern binding: pattern as binding_name:
            var pattern_binding = ""
            if par_kind_get() == TOK_KW_AS:
                parser_advance()
                pattern_binding = par_text_get()
                parser_expect(6)

            # G28: accept `=>` as either a single-expression separator or the
            # established block-arm spelling used by UI/web renderers.
            var arm_body: [i64] = []
            if par_kind_get() == TOK_FAT_ARROW:
                parser_advance()
                if par_kind_get() == TOK_NEWLINE:
                    arm_body = parse_block()
                else:
                    val arrow_expr = parse_expr()
                    arm_body.push(stmt_expr_stmt(arrow_expr, 0))
            else:
                # Expect colon after pattern
                parser_expect(161)
                arm_body = parse_block()

            # Create arm
            for i in 0..patterns.len():
                val pattern_idx = patterns[i]
                val rationale = extract_wildcard_rationale(pattern_idx)
                val stored_pattern = normalize_wildcard_pattern(pattern_idx)
                val arm_idx = arm_new_with_binding_and_rationale(stored_pattern, guard_expr_idx, arm_body, pattern_binding, rationale)
                arm_indices.push(arm_idx)

    (scrutinee, arm_indices)

fn parse_match_stmt_tail() -> i64:
    val parsed = parse_match_arms_common()
    stmt_match_stmt(parsed[0], parsed[1], 0)

# `match` used as a VALUE (expression position), e.g. `val r = match n:
# case 1: 10 case _: 99`. Bug: expression-position `match` used to call
# parse_match_stmt_tail() and return its STATEMENT id directly as if it were
# an expr id -- stmt-arena and expr-arena indices overlap, so the caller
# (parse_primary_expr, expecting an expr id) silently read whatever unrelated
# EXPR happened to occupy that numeric slot (a wrong-arena type confusion),
# producing a garbage constant with no branches at all instead of the real
# match value. Building a genuine expr_match_expr node here (mirroring the
# stmt path exactly, just wrapped in the expr constructor) fixes this at the
# source instead of downstream.
fn parse_match_expr_tail() -> i64:
    val parsed = parse_match_arms_common()
    expr_match_expr(parsed[0], parsed[1], 0)

fn parse_receive_stmt() -> i64:
    # Already consumed 'receive' keyword
    parser_expect(161)
    parser_skip_newlines()
    parser_expect(181)

    var arm_indices: [i64] = []
    var timeout_expr: i64 = -1
    var timeout_body_idx: i64 = -1

    var kind = par_kind_get()
    for i in 0..1000:
        parser_skip_newlines()
        if par_kind_get() == 182:
            parser_advance()
            break
        if par_kind_get() == 190:
            break

        if kind == 207:
            # after TIMEOUT: body -- timeout arm
            parser_advance()
            timeout_expr = parse_expr()
            parser_expect(161)
            val after_body = parse_block()
            val after_body_stmt_idx = stmt_block_stmt(after_body, 0)
            timeout_body_idx = after_body_stmt_idx
        elif kind == 44:
            parser_advance()
            var patterns: [i64] = []
            patterns.push(parse_expr())
            for skip_idx in 0..100:
                kind = par_kind_get()
                val is_nl = kind == 180
                val is_indent = kind == 181
                val should_skip = is_nl or is_indent
                if not should_skip:
                    break
                parser_advance()
            while par_kind_get() == 121:
                parser_advance()
                for skip_idx in 0..100:
                    kind = par_kind_get()
                    val is_nl = kind == 180
                    val is_indent = kind == 181
                    val should_skip = is_nl or is_indent
                    if not should_skip:
                        break
                    parser_advance()
                patterns.push(parse_expr())
            var guard_expr_idx: i64 = -1
            if par_kind_get() == 40:
                parser_advance()
                guard_expr_idx = parse_expr()
            parser_expect(161)
            val arm_body = parse_block()
            for j in 0..patterns.len():
                val pattern_idx = patterns[j]
                val rationale = extract_wildcard_rationale(pattern_idx)
                val stored_pattern = normalize_wildcard_pattern(pattern_idx)
                val arm_idx = arm_new_with_binding_and_rationale(stored_pattern, guard_expr_idx, arm_body, "", rationale)
                arm_indices.push(arm_idx)
        else:
            parser_error("expected 'case' or 'after' in receive block")
            parser_advance()

    stmt_receive_stmt(arm_indices, timeout_expr, timeout_body_idx, 0)

fn parse_bind_stmt() -> i64:
    # Already consumed 'bind' keyword
    val var_name = par_text_get()
    parser_expect(6)
    parser_expect(100)
    val rhs = parse_expr()
    stmt_bind_stmt(var_name, rhs, 0)

# ===== Expression-Level Control Flow (for module-level statements) =====

fn parse_if_expr() -> i64:
    # Parse every `elif` / `else if` arm without recursively re-entering this
    # function.  Keep the flat AST wire format unchanged by folding the arms
    # back into the historical nested EXPR_IF representation below.
    var arm_patterns: [i64] = []
    var arm_inits: [i64] = []
    var arm_conds: [i64] = []
    var arm_thens: [i64] = []
    var arm_starts: [i64] = []
    var arm_lines: [i64] = []
    var arm_cols: [i64] = []
    var arm_continued_indents: [i64] = []
    var terminal_else = expr_unit(0)
    var parsing_arms = true

    while parsing_arms:
        val decision_start = lex_token_start_get()
        val decision_line = par_line_get()
        val decision_col = par_col_get()
        parser_advance()  # consume if or elif

        var pattern_idx: i64 = -1
        var init_expr: i64 = -1
        var cond: i64 = -1
        var then_expr: i64 = -1
        var form = 0  # 0 colon block, 1 brace, 2 then, 3 if-val/var
        var continued_indent = 0

        if par_kind_get() == TOK_KW_VAL or par_kind_get() == TOK_KW_VAR:
            form = 3
            parser_advance()
            pattern_idx = parse_or()
            val pattern_tag = expr_get_tag(pattern_idx)
            if pattern_tag != EXPR_CALL and pattern_tag != EXPR_METHOD_CALL and pattern_tag != EXPR_IDENT:
                parser_error("expected identifier or constructor pattern after if val/var")
            parser_expect(100)
            init_expr = parse_expr()
            parser_expect(161)
            val inline_then = par_kind_get() != TOK_NEWLINE
            val then_body = parse_block()
            then_expr = expr_block(then_body, -1, 0)
            parser_skip_newlines()
            if inline_then and par_kind_get() == TOK_INDENT:
                parser_advance()
                continued_indent = 1
        else:
            cond = parse_expr()
            if par_kind_get() == 142:
                form = 1
                parser_advance()
                then_expr = parse_expr()
                parser_expect(143)
            elif par_kind_get() == 6:
                form = 2
                parser_advance()
                if par_kind_get() == 161:
                    parser_advance()
                then_expr = parse_expr()
            else:
                parser_expect(161)
                val inline_then = par_kind_get() != TOK_NEWLINE
                val then_body = parse_block()
                then_expr = expr_block(then_body, -1, 0)
                parser_skip_newlines()
                if inline_then and par_kind_get() == TOK_INDENT:
                    parser_advance()
                    continued_indent = 1

        arm_patterns.push(pattern_idx)
        arm_inits.push(init_expr)
        arm_conds.push(cond)
        arm_thens.push(then_expr)
        arm_starts.push(decision_start)
        arm_lines.push(decision_line)
        arm_cols.push(decision_col)
        arm_continued_indents.push(continued_indent)

        if par_kind_get() == 42:
            # The loop consumes the elif token as the next arm's opener.
            parsing_arms = true
        elif par_kind_get() == 41:
            parser_advance()
            if par_kind_get() == 40:
                # The loop consumes the `if` after `else` as the next opener.
                parsing_arms = true
            else:
                if form == 1 and par_kind_get() == 142:
                    parser_advance()
                    terminal_else = parse_expr()
                    parser_expect(143)
                elif form == 3 and par_kind_get() == 161:
                    parser_advance()
                    val else_body = parse_block()
                    terminal_else = expr_block(else_body, -1, 0)
                elif form == 2:
                    if par_kind_get() == 161:
                        parser_advance()
                    terminal_else = parse_expr()
                elif form == 0 and par_kind_get() == 161:
                    parser_advance()
                    val else_body = parse_block()
                    terminal_else = expr_block(else_body, -1, 0)
                else:
                    terminal_else = parse_expr()
                parsing_arms = false
        else:
            parsing_arms = false

    # Recursive parsing used to close each inline-continuation indent while
    # unwinding.  Close them in the same inner-to-outer order and retain the
    # per-arm end offsets so diagnostic spans remain byte-for-byte equivalent.
    var arm_ends: [i64] = []
    var end_i = 0
    while end_i < arm_conds.len():
        arm_ends.push(0)
        end_i = end_i + 1
    var unwind_i = arm_conds.len()
    while unwind_i > 0:
        unwind_i = unwind_i - 1
        if arm_continued_indents[unwind_i] == 1:
            parser_skip_newlines()
            if par_kind_get() == TOK_DEDENT:
                parser_advance()
        arm_ends[unwind_i] = lex_token_start_get()

    val chain_span = flat_span_new(arm_starts[0], arm_ends[0], arm_lines[0], arm_cols[0])
    val chain_id = flat_if_expr_chain_new(chain_span)
    var ai = 0
    while ai < arm_conds.len():
        val span_id = flat_span_new(arm_starts[ai], arm_ends[ai], arm_lines[ai], arm_cols[ai])
        var arm_kind = ARM_CONDITION
        var arm_head = arm_conds[ai]
        if arm_patterns[ai] >= 0:
            arm_head = arm_patterns[ai]
            val pattern_tag = expr_get_tag(arm_head)
            if pattern_tag == EXPR_CALL or pattern_tag == EXPR_METHOD_CALL:
                arm_kind = ARM_PATTERN_BIND
                arm_head = normalize_wildcard_pattern(arm_head)
            else:
                arm_kind = ARM_VALUE_BIND
        val arm_id = flat_if_expr_arm_append(chain_id, arm_kind, arm_head, arm_inits[ai], arm_thens[ai], span_id)
        if arm_kind == ARM_PATTERN_BIND:
            flat_if_arm_rationale_set(arm_id, extract_wildcard_rationale(arm_patterns[ai]))
        ai = ai + 1
    flat_if_expr_else_set(chain_id, terminal_else)
    expr_if_chain_expr(chain_id, chain_span)

fn parse_for_expr() -> i64:
    parser_advance()
    val iter_name = par_text_get()
    parser_expect(6)
    parser_expect(50)
    val iterable = parse_expr()
    parser_expect(161)
    val body = parse_block()
    expr_for_expr(iter_name, iterable, body, 0)

fn parse_while_expr() -> i64:
    val decision_start = lex_token_start_get()
    val decision_line = par_line_get()
    val decision_col = par_col_get()
    parser_advance()
    val cond = parse_expr()
    parser_expect(161)
    val body = parse_block()
    expr_while_expr(cond, body, flat_span_new(decision_start, lex_token_start_get(), decision_line, decision_col))

# ===== Tuple Destructuring =====
# val (a, b, c) = expr  →  val "(a,b,c)" = expr
# var (a, b, c) = expr  →  var "(a,b,c)" = expr
# The evaluator detects the "(" prefix and destructures at runtime

fn parse_tuple_destructure_val() -> i64:
    # Already consumed 'val', current token is '('
    # Encode as: val "(a,b,c)" = expr
    # The evaluator detects the "(" prefix and destructures
    parser_advance()  # consume (
    var joined = "("
    # G30: accept _ (kind 169); G40: accept any keyword via G26 round-trip
    if par_kind_get() == 169:
        joined = joined + "_"
        parser_advance()
    else:
        val tdv0_kn = tok_kind_name(par_kind_get())
        if keyword_lookup(tdv0_kn) == par_kind_get():
            joined = joined + tdv0_kn
            parser_advance()
        else:
            joined = joined + par_text_get()
            parser_expect(6)
    while par_kind_get() == 160:
        parser_advance()  # consume ,
        if par_kind_get() == 169:
            joined = joined + ",_"
            parser_advance()
        else:
            val tdvN_kn = tok_kind_name(par_kind_get())
            if keyword_lookup(tdvN_kn) == par_kind_get():
                joined = joined + "," + tdvN_kn
                parser_advance()
            else:
                joined = joined + "," + par_text_get()
                parser_expect(6)
    parser_expect(141)
    joined = joined + ")"
    parser_expect(100)
    val init = parse_expr()
    stmt_val_decl(joined, 0, init, 0)

fn parse_tuple_destructure_var() -> i64:
    # Already consumed 'var', current token is '('
    # Encode as: var "(a,b,c)" = expr
    # The evaluator detects the "(" prefix and destructures
    parser_advance()  # consume (
    var joined = "("
    # G30: accept _ (kind 169); G40: accept any keyword via G26 round-trip
    if par_kind_get() == 169:
        joined = joined + "_"
        parser_advance()
    else:
        val tdvr0_kn = tok_kind_name(par_kind_get())
        if keyword_lookup(tdvr0_kn) == par_kind_get():
            joined = joined + tdvr0_kn
            parser_advance()
        else:
            joined = joined + par_text_get()
            parser_expect(6)
    while par_kind_get() == 160:
        parser_advance()  # consume ,
        if par_kind_get() == 169:
            joined = joined + ",_"
            parser_advance()
        else:
            val tdvrN_kn = tok_kind_name(par_kind_get())
            if keyword_lookup(tdvrN_kn) == par_kind_get():
                joined = joined + "," + tdvrN_kn
                parser_advance()
            else:
                joined = joined + "," + par_text_get()
                parser_expect(6)
    parser_expect(141)
    joined = joined + ")"
    parser_expect(100)
    val init = parse_expr()
    stmt_var_decl(joined, 0, init, 0)

# ===== GPU Launch Statement =====

fn parse_gpu_launch_stmt() -> i64:
    """Parse gpu_launch(grid: (...), block: (...)): body

    Syntax:
        gpu_launch(grid: (256,), block: (256,)):
            vector_add(a, b, out, n)

        gpu_launch(grid: (16, 16), block: (32, 32)):
            matrix_mul(a, b, out, n)
    """
    val launch_start = lex_token_start_get()
    val launch_line = par_line_get()
    val launch_col = par_col_get()
    parser_advance()  # consume 'gpu_launch'
    parser_expect(140)

    var grid_exprs: [i64] = []
    var block_exprs: [i64] = []
    var saw_grid = false
    var saw_block = false

    # Parse named arguments: grid: (...), block: (...)
    for arg_i in 0..2:
        if arg_i > 0:
            if par_kind_get() == 160:
                parser_advance()

        val arg_name = par_text_get()
        parser_expect(6)
        parser_expect(161)

        # Parse the complete tuple so an oversized launch is diagnosed here
        # rather than left as a confusing ')' parse error. The flat arena keeps
        # source order; the bridge performs the same defensive validation for
        # restored/cached arenas.
        parser_expect(140)
        var dims: [i64] = []
        while par_kind_get() != 141 and par_kind_get() != 190:
            dims.push(parse_expr())
            if par_kind_get() != 160:
                break
            parser_advance()
            # A trailing comma is valid for the one-dimensional spelling.
            if par_kind_get() == 141:
                break
        parser_expect(141)

        if dims.len() < 1 or dims.len() > 3:
            parser_error("gpu_launch '" + arg_name + "' dimensions must contain 1 to 3 expressions")

        if arg_name == "grid":
            if saw_grid:
                parser_error("gpu_launch config contains duplicate 'grid' argument")
            saw_grid = true
            grid_exprs = dims
        elif arg_name == "block":
            if saw_block:
                parser_error("gpu_launch config contains duplicate 'block' argument")
            saw_block = true
            block_exprs = dims
        else:
            parser_error("gpu_launch config expects only named 'grid' and 'block' arguments; found '" + arg_name + "'")

    if not saw_grid:
        parser_error("gpu_launch config requires a 'grid' argument")
    if not saw_block:
        parser_error("gpu_launch config requires a 'block' argument")

    parser_expect(141)
    parser_expect(161)

    val body = parse_block()
    val launch_span = flat_span_new(launch_start, lex_token_start_get(), launch_line, launch_col)
    stmt_gpu_launch(grid_exprs, block_exprs, body, launch_span)

# ===== Exports =====
export parse_block, parse_statement
export parse_val_decl_stmt, parse_lazy_val_decl_stmt, parse_var_decl_stmt
export parse_if_stmt, parse_for_stmt, parse_while_stmt, parse_match_stmt
export parse_match_stmt_tail, parse_match_expr_tail, g33_kw_ident_follow
export parse_receive_stmt, parse_bind_stmt
export parse_if_expr, parse_for_expr, parse_while_expr
