# Core Simple — AST Statement Nodes
#
# Statement kind tags, arena pools, constructors, and accessors.
# Split from ast.spl for maintainability.
#
# See ast.spl for the full AST module documentation.

use compiler.core.ast_expr.{asm_arm_new, ast_generation}
use compiler.core.types.{int_to_str}

# ===== Statement Kind Tags =====
const STMT_EXPR = 1
const STMT_VAL_DECL = 2
const STMT_VAR_DECL = 3
const STMT_ASSIGN = 4
const STMT_RETURN = 5
const STMT_IF = 6
const STMT_FOR = 7
const STMT_WHILE = 8
const STMT_MATCH = 9
const STMT_BLOCK = 10
const STMT_BREAK = 11
const STMT_CONTINUE = 12
const STMT_COMPOUND_ASSIGN = 13
const STMT_DEFER = 14
const STMT_ERRDEFER = 15
const STMT_LABELED_LOOP = 16  # 'label: for/while wrapper
const STMT_STATIC_FOR = 17   # static_for compile-time loop unrolling
const STMT_COMPTIME = 18     # comptime: block — evaluated eagerly at module load time
const STMT_RECEIVE = 19    # receive: block statement (Erlang mailbox receive)
const STMT_BIND = 20       # bind x = expr (inside ce: blocks, monadic bind)
const STMT_LAZY_VAL_DECL = 21  # lazy val name = expr (deferred initialization)
const STMT_ASM_ASSERT = 22     # asm assert [spec] - compile-time target guard
const STMT_GPU_LAUNCH = 23     # gpu_launch(grid: (...), block: (...)): body

# ===== Statement Arena Pools =====
var stmt_tag: [i64] = []
var stmt_span: [i64] = []
var stmt_expr: [i64] = []
var stmt_name: [text] = []
var stmt_type_tag: [i64] = []
var stmt_body: [[i64]] = []
var stmt_empty_i64: [i64] = []
var stmt_if_val_marker: [bool] = []
var stmt_count_slot: [i64] = [0]

extern fn rt_env_get(key: text) -> text

fn stmt_count_slot_ensure():
    if stmt_count_slot == nil or stmt_count_slot.len() == 0:
        stmt_count_slot = [0]

fn stmt_count_env() -> i64:
    stmt_count_slot_ensure()
    stmt_count_slot[0]

fn stmt_count_set(value: i64):
    stmt_count_slot_ensure()
    stmt_count_slot[0] = value

fn stmt_count() -> i64:
    val env_count = stmt_count_env()
    if env_count > 0:
        return env_count
    stmt_tag.len()

fn stmt_reset():
    # Allocate nil module arrays once, then retain their storage across files.
    if stmt_tag == nil:
        stmt_tag = []
    if stmt_span == nil:
        stmt_span = []
    if stmt_expr == nil:
        stmt_expr = []
    if stmt_name == nil:
        stmt_name = []
    if stmt_type_tag == nil:
        stmt_type_tag = []
    if stmt_body == nil:
        stmt_body = []
    if stmt_empty_i64 == nil:
        stmt_empty_i64 = []
    if stmt_if_val_marker == nil:
        stmt_if_val_marker = []
    if stmt_gpu_grid_exprs == nil:
        stmt_gpu_grid_exprs = []
    if stmt_gpu_block_exprs == nil:
        stmt_gpu_block_exprs = []
    stmt_tag.clear()
    stmt_span.clear()
    stmt_expr.clear()
    stmt_name.clear()
    stmt_type_tag.clear()
    stmt_body.clear()
    stmt_if_val_marker.clear()
    stmt_gpu_grid_exprs.clear()
    stmt_gpu_block_exprs.clear()
    stmt_count_set(0)

fn stmt_alloc(tag: i64, span_id: i64) -> i64:
    val idx = stmt_count_env()
    stmt_count_set(idx + 1)
    stmt_tag.push(tag)
    stmt_span.push(span_id)
    stmt_expr.push(-1)
    stmt_name.push("")
    stmt_type_tag.push(0)
    stmt_body.push(stmt_empty_i64)
    stmt_if_val_marker.push(false)
    val trace_stmt_tags = rt_env_get("SIMPLE_TRACE_STMT_TAGS") ?? ""
    if trace_stmt_tags != "" and (idx < 8 or tag <= 0):
        print "[stmt_alloc] idx={idx} tag={tag} span={span_id}"
    idx

# ===== Statement Constructors =====

fn stmt_expr_stmt(expression: i64, span_id: i64) -> i64:
    val idx = stmt_alloc(1, span_id)
    stmt_expr[idx] = expression
    idx

fn stmt_val_decl(name: text, type_tag: i64, init_expr: i64, span_id: i64) -> i64:
    val idx = stmt_alloc(STMT_VAL_DECL, span_id)
    stmt_name[idx] = name
    stmt_type_tag[idx] = type_tag
    stmt_expr[idx] = init_expr
    stmt_if_val_marker[idx] = false
    idx

fn stmt_if_val_decl(name: text, init_expr: i64, span_id: i64) -> i64:
    val idx = stmt_val_decl(name, 0, init_expr, span_id)
    stmt_if_val_marker[idx] = true
    idx

fn stmt_is_if_val_decl(idx: i64) -> bool:
    idx >= 0 and idx < stmt_if_val_marker.len() and stmt_if_val_marker[idx]

fn stmt_lazy_val_decl(name: text, type_tag: i64, init_expr: i64, span_id: i64) -> i64:
    val idx = stmt_alloc(STMT_LAZY_VAL_DECL, span_id)
    stmt_name[idx] = name
    stmt_type_tag[idx] = type_tag
    stmt_expr[idx] = init_expr
    idx

fn stmt_var_decl(name: text, type_tag: i64, init_expr: i64, span_id: i64) -> i64:
    val idx = stmt_alloc(STMT_VAR_DECL, span_id)
    stmt_name[idx] = name
    stmt_type_tag[idx] = type_tag
    stmt_expr[idx] = init_expr
    idx

fn stmt_assign_stmt(target_expr: i64, value_expr: i64, span_id: i64) -> i64:
    val idx = stmt_alloc(STMT_ASSIGN, span_id)
    stmt_expr[idx] = target_expr
    var body: [i64] = []
    body.push(value_expr)
    stmt_body[idx] = body
    idx

fn stmt_return_stmt(value_expr: i64, span_id: i64) -> i64:
    val idx = stmt_alloc(5, span_id)
    stmt_expr[idx] = value_expr
    idx

fn stmt_if_stmt(cond_expr: i64, then_stmts: [i64], elif_idx: i64, span_id: i64) -> i64:
    val idx = stmt_alloc(STMT_IF, span_id)
    stmt_expr[idx] = cond_expr
    stmt_body[idx] = then_stmts
    stmt_type_tag[idx] = elif_idx
    idx

fn stmt_for_stmt(iter_name: text, iterable: i64, body_stmts: [i64], span_id: i64) -> i64:
    val idx = stmt_alloc(STMT_FOR, span_id)
    stmt_name[idx] = iter_name
    stmt_expr[idx] = iterable
    stmt_body[idx] = body_stmts
    idx

fn stmt_static_for_stmt(iter_name: text, iterable: i64, body_stmts: [i64], span_id: i64) -> i64:
    val idx = stmt_alloc(STMT_STATIC_FOR, span_id)
    stmt_name[idx] = iter_name
    stmt_expr[idx] = iterable
    stmt_body[idx] = body_stmts
    idx

fn stmt_comptime_block(body_stmts: [i64], span_id: i64) -> i64:
    val idx = stmt_alloc(STMT_COMPTIME, span_id)
    stmt_body[idx] = body_stmts
    idx

fn stmt_receive_stmt(arm_indices: [i64], timeout_expr: i64, timeout_body_idx: i64, span_id: i64) -> i64:
    # receive: block — arm_indices = match arm pool indices,
    # timeout_expr = after timeout expr (or -1), timeout_body_idx = after body stmt index (or -1)
    val idx = stmt_alloc(STMT_RECEIVE, span_id)
    stmt_body[idx] = arm_indices
    stmt_expr[idx] = timeout_expr
    stmt_type_tag[idx] = timeout_body_idx
    idx

fn stmt_bind_stmt(var_name: text, rhs_expr: i64, span_id: i64) -> i64:
    # bind x = expr — monadic bind inside ce: blocks
    val idx = stmt_alloc(STMT_BIND, span_id)
    stmt_name[idx] = var_name
    stmt_expr[idx] = rhs_expr
    idx

fn stmt_while_stmt(cond_expr: i64, body_stmts: [i64], span_id: i64) -> i64:
    val idx = stmt_alloc(STMT_WHILE, span_id)
    stmt_expr[idx] = cond_expr
    stmt_body[idx] = body_stmts
    idx

fn stmt_match_stmt(scrutinee: i64, arm_indices: [i64], span_id: i64) -> i64:
    val idx = stmt_alloc(9, span_id)
    stmt_expr[idx] = scrutinee
    stmt_body[idx] = arm_indices
    idx

fn stmt_block_stmt(body_stmts: [i64], span_id: i64) -> i64:
    val idx = stmt_alloc(STMT_BLOCK, span_id)
    stmt_body[idx] = body_stmts
    idx

fn stmt_break_stmt(span_id: i64) -> i64:
    stmt_alloc(STMT_BREAK, span_id)

fn stmt_break_labeled(label: text, span_id: i64) -> i64:
    val idx = stmt_alloc(STMT_BREAK, span_id)
    stmt_name[idx] = label
    idx

fn stmt_continue_stmt(span_id: i64) -> i64:
    stmt_alloc(STMT_CONTINUE, span_id)

fn stmt_continue_labeled(label: text, span_id: i64) -> i64:
    val idx = stmt_alloc(STMT_CONTINUE, span_id)
    stmt_name[idx] = label
    idx

fn stmt_compound_assign_stmt(op: i64, target_expr: i64, value_expr: i64, span_id: i64) -> i64:
    val idx = stmt_alloc(STMT_COMPOUND_ASSIGN, span_id)
    stmt_expr[idx] = target_expr
    stmt_type_tag[idx] = op
    var body: [i64] = []
    body.push(value_expr)
    stmt_body[idx] = body
    idx

fn stmt_defer_stmt(deferred_expr: i64, span_id: i64) -> i64:
    val idx = stmt_alloc(STMT_DEFER, span_id)
    stmt_expr[idx] = deferred_expr
    idx

fn stmt_errdefer_stmt(deferred_expr: i64, span_id: i64) -> i64:
    val idx = stmt_alloc(STMT_ERRDEFER, span_id)
    stmt_expr[idx] = deferred_expr
    idx

# Block-form `defer:` / `errdefer:` (bug #172). EXPR is left at the -1
# "no expr" sentinel (same convention as bare `return` -> stmt_return_stmt(-1,
# ...)) so consumers can tell block-form apart from the single-expr form by
# checking stmt_get_body(idx).len() > 0 first.
fn stmt_defer_block_stmt(body_stmts: [i64], span_id: i64) -> i64:
    val idx = stmt_alloc(STMT_DEFER, span_id)
    stmt_expr[idx] = -1
    stmt_body[idx] = body_stmts
    idx

fn stmt_errdefer_block_stmt(body_stmts: [i64], span_id: i64) -> i64:
    val idx = stmt_alloc(STMT_ERRDEFER, span_id)
    stmt_expr[idx] = -1
    stmt_body[idx] = body_stmts
    idx

fn stmt_labeled_loop(label: text, inner_stmt: i64, span_id: i64) -> i64:
    # Wraps a for/while loop with a label for labeled break/continue
    val idx = stmt_alloc(STMT_LABELED_LOOP, span_id)
    stmt_name[idx] = label
    var body: [i64] = []
    body.push(inner_stmt)
    stmt_body[idx] = body
    idx

fn stmt_asm_assert(archs: [text], os: text, abi: text, backend: text,
                   ver_ops: [text], ver_vals: [i64], span_id: i64) -> i64:
    """Create asm assert statement. Stores target spec in a single asm arm."""
    val arm_idx = asm_arm_new(archs, os, abi, backend, ver_ops, ver_vals, "", false, "", false)
    val idx = stmt_alloc(STMT_ASM_ASSERT, span_id)
    stmt_expr[idx] = arm_idx
    idx

# GPU launch dimension storage (parallel to stmt arrays)
var stmt_gpu_grid_exprs: [[i64]] = []   # grid dimension expression indices
var stmt_gpu_block_exprs: [[i64]] = []  # block dimension expression indices

fn stmt_gpu_launch(grid_exprs: [i64], block_exprs: [i64], body_stmts: [i64], span_id: i64) -> i64:
    """Create gpu_launch statement with grid/block dimensions and body."""
    val idx = stmt_alloc(STMT_GPU_LAUNCH, span_id)
    stmt_body[idx] = body_stmts
    # Grow GPU storage arrays to match
    while stmt_gpu_grid_exprs.len() <= idx:
        stmt_gpu_grid_exprs.push(stmt_empty_i64)
        stmt_gpu_block_exprs.push(stmt_empty_i64)
    stmt_gpu_grid_exprs[idx] = grid_exprs
    stmt_gpu_block_exprs[idx] = block_exprs
    idx

fn stmt_get_gpu_grid(idx: i64) -> [i64]:
    if idx < stmt_gpu_grid_exprs.len():
        return stmt_gpu_grid_exprs[idx]
    []

fn stmt_get_gpu_block(idx: i64) -> [i64]:
    if idx < stmt_gpu_block_exprs.len():
        return stmt_gpu_block_exprs[idx]
    []

# ===== Statement Accessors =====

fn stmt_get_tag(idx: i64) -> i64:
    # Bounds guard: a stale stmt index (captured before an interleaved
    # ast_reset/stmt_reset cleared the shared arena) can exceed the live arena
    # length (stage-4 "index is 48 but length is 13" class). Return -1 so tag
    # dispatchers fall through to their safe default instead of crashing. See
    # doc/08_tracking/bug/flat_bridge_type_index_across_ast_reset_2026-07-12.md
    if idx < 0 or idx >= stmt_tag.len():
        # L6: include the live arena generation so a stale index (minted before
        # an ast_reset) is diagnosable from ONE line instead of an OOB flood.
        print "[stmt_get_tag] OOB idx={idx} arena_len={stmt_tag.len()} arena_gen={ast_generation()} -> -1"
        return -1
    val fallback = stmt_tag[idx]
    val trace_stmt_tags = rt_env_get("SIMPLE_TRACE_STMT_TAGS") ?? ""
    if trace_stmt_tags != "" and (idx < 8 or fallback <= 0):
        print "[stmt_get_tag] idx={idx} arena={fallback}"
    fallback

# Sibling bounds guards for the rest of the statement accessor family.
#
# `stmt_get_tag` above has been guarded since the stage-4 work, but its
# siblings were not — and a guard on the dispatcher alone does not stop the
# crash. A walker asks for the tag (gets -1 plus a loud OOB line), falls
# through to its default branch, and then still reads `stmt_get_span/expr/
# name/type/body` with the SAME stale index. That unguarded read is what
# actually kills the process.
#
# Measured on `src/compiler_rust/lib/std/src/tooling/misc_commands.spl` under
# `simple lint` on the interpreter route:
#
#     [stmt_get_tag] OOB idx=149 arena_len=79 arena_gen=1 -> -1
#     error: semantic: array index out of bounds: index is 149 but length is 79
#
# Same index, same length, one line apart — the guard fired and the very next
# read of the same stale index was fatal. The process ended there: no summary,
# no verdict, no NOT-LINTED count, so the file simply vanished from the run.
# The JIT reaches the identical stale index (149 and 158) and survives it,
# which is the whole reason the two engines disagreed on this file. Neither
# verdict is trustworthy for such a file; what is fixed here is only that the
# interpreter no longer dies silently instead of reporting.
# See doc/08_tracking/bug/lint_parse_failure_silently_skips_file_2026-08-01.md.
#
# These return the neutral values an absent node carries, matching the
# established precedent in this arena family (`decl_get`, `expr_contains_yield`,
# `stmt_contains_yield`, `stmt_get_tag`). This is containment, not a root-cause
# fix: WHY a stale index reaches these accessors at arena_gen=1 — when no
# second ast_reset has run — is still open and tracked in that bug file.
#
# The loud, always-on OOB report stays on `stmt_get_tag`, which any walk
# reaching a stale node passes through first, so completing the family removes
# the crash without silencing the diagnosis. The per-accessor line is gated
# behind SIMPLE_TRACE_AST_OOB (default off) so a walk over a stale subtree
# cannot flood the output with one line per field.
fn stmt_oob_trace(accessor: text, idx: i64, arena_len: i64):
    val trace_ast_oob = rt_env_get("SIMPLE_TRACE_AST_OOB") ?? ""
    if trace_ast_oob != "":
        print "[{accessor}] OOB idx={idx} arena_len={arena_len} arena_gen={ast_generation()}"

fn stmt_get_span(idx: i64) -> i64:
    if idx < 0 or idx >= stmt_span.len():
        stmt_oob_trace("stmt_get_span", idx, stmt_span.len())
        return -1
    stmt_span[idx]

fn stmt_get_expr(idx: i64) -> i64:
    if idx < 0 or idx >= stmt_expr.len():
        stmt_oob_trace("stmt_get_expr", idx, stmt_expr.len())
        return -1
    stmt_expr[idx]

fn stmt_get_name(idx: i64) -> text:
    if idx < 0 or idx >= stmt_name.len():
        stmt_oob_trace("stmt_get_name", idx, stmt_name.len())
        return ""
    stmt_name[idx]

fn stmt_get_type(idx: i64) -> i64:
    if idx < 0 or idx >= stmt_type_tag.len():
        stmt_oob_trace("stmt_get_type", idx, stmt_type_tag.len())
        return 0
    stmt_type_tag[idx]

fn stmt_get_body(idx: i64) -> [i64]:
    if idx < 0 or idx >= stmt_body.len():
        stmt_oob_trace("stmt_get_body", idx, stmt_body.len())
        return []
    stmt_body[idx]

export STMT_EXPR, STMT_VAL_DECL, STMT_VAR_DECL, STMT_ASSIGN, STMT_RETURN
export STMT_IF, STMT_FOR, STMT_WHILE, STMT_MATCH, STMT_BLOCK
export STMT_BREAK, STMT_CONTINUE, STMT_COMPOUND_ASSIGN, STMT_DEFER, STMT_ERRDEFER
export STMT_LABELED_LOOP, STMT_STATIC_FOR, STMT_COMPTIME, STMT_RECEIVE, STMT_BIND
export STMT_LAZY_VAL_DECL, STMT_ASM_ASSERT, STMT_GPU_LAUNCH
export stmt_tag, stmt_span, stmt_expr, stmt_name, stmt_type_tag, stmt_body, stmt_count
export stmt_count_env, stmt_count_set
export stmt_reset, stmt_alloc
