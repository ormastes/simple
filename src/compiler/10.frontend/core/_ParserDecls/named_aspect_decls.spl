# Named aspect ownership. Advice signatures and selectors are unchanged.
use compiler.core.parser.{par_kind_get, par_text_get, parser_advance, parser_expect, parser_error}
use compiler.core.parser.{parser_skip_newlines, parser_skip_newlines_and_semicolons}
use compiler.core.tokens.{TOK_IDENT, TOK_COLON}
use compiler.frontend.core._Ast.module_state.{module_add_decl}
use compiler.frontend.core._ParserDecls.bitfield_aop_arch_decls.{parse_aop_advice_decl}

pub fn parse_named_aspect_decl() -> text:
    parser_advance()  # aspect soft keyword
    val aspect_name = par_text_get()
    if not parser_expect(TOK_IDENT): return ""
    if not parser_expect(TOK_COLON): return aspect_name
    parser_skip_newlines()
    if not parser_expect(181): return aspect_name
    parser_skip_newlines_and_semicolons()
    while par_kind_get() != 182 and par_kind_get() != 190:
        if par_kind_get() == TOK_IDENT and par_text_get() == "on":
            module_add_decl(parse_aop_advice_decl(aspect_name))
        else:
            parser_error("expected 'on pc' advice in named aspect body")
            while par_kind_get() != 180 and par_kind_get() != 182 and par_kind_get() != 190:
                parser_advance()
        parser_skip_newlines_and_semicolons()
    parser_expect(182)
    aspect_name
