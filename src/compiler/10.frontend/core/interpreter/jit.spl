# Core Interpreter — JIT Engine (process-owned in-memory hash-table state)

use compiler.core.interpreter.hashmap.{HM_SIZE, hm_hash_text, hm_make_global_buckets}

var _jit_threshold: i64 = 10
var _jit_enabled: i64 = 0
var _jit_epoch: i64 = 0
var _jit_verbose: i64 = 0
var _jit_backend: text = "auto"
var _jit_compile_attempts: i64 = 0

# Call-count table: fn_name -> count (chained hash map, HM_SIZE = 256)
var _jit_call_keys: [text] = []
var _jit_call_vals: [i64] = []
var _jit_call_buckets: [i64] = []
var _jit_call_nexts: [i64] = []

# Compiled set: fn_name -> live flag (1 = live, 0 = swept/cleaned; HM_SIZE = 256)
var _jit_compiled_keys: [text] = []
var _jit_compiled_live: [i64] = []
var _jit_compiled_buckets: [i64] = []
var _jit_compiled_nexts: [i64] = []
var _jit_compiled_live_count: i64 = 0

# Negative compile cache: fn_name -> failed flag (1 = failed, 0 = cleared; HM_SIZE = 256)
var _jit_failed_keys: [text] = []
var _jit_failed_live: [i64] = []
var _jit_failed_buckets: [i64] = []
var _jit_failed_nexts: [i64] = []
var _jit_failed_live_count: i64 = 0

# Symbol last-used epoch table: fn_name -> epoch (chained hash map, HM_SIZE = 256)
var _jit_used_keys: [text] = []
var _jit_used_vals: [i64] = []
var _jit_used_buckets: [i64] = []
var _jit_used_nexts: [i64] = []

# Explicit native callable return table: fn_name -> (live flag, raw i64 return word).
# Empty unless an execution backend registers a real native callable; prevents
# marking unbacked functions as compiled or returning a fake 0 result.
var _jit_native_keys: [text] = []
var _jit_native_live: [i64] = []
var _jit_native_vals: [i64] = []
var _jit_native_buckets: [i64] = []
var _jit_native_nexts: [i64] = []

class JitState:
    threshold: i64
    enabled: i64
    epoch: i64
    call_keys: [text]
    call_vals: [i64]
    compiled: [text]
    used_keys: [text]
    used_vals: [i64]

class JitThresholdView:
    threshold: i64

fn _state_path() -> text:
    "memory://simple_jit"

fn _jit_reset_tables():
    _jit_call_keys = []
    _jit_call_vals = []
    _jit_call_buckets = hm_make_global_buckets()
    _jit_call_nexts = []

    _jit_compiled_keys = []
    _jit_compiled_live = []
    _jit_compiled_buckets = hm_make_global_buckets()
    _jit_compiled_nexts = []
    _jit_compiled_live_count = 0

    _jit_failed_keys = []
    _jit_failed_live = []
    _jit_failed_buckets = hm_make_global_buckets()
    _jit_failed_nexts = []
    _jit_failed_live_count = 0

    _jit_used_keys = []
    _jit_used_vals = []
    _jit_used_buckets = hm_make_global_buckets()
    _jit_used_nexts = []

    _jit_native_keys = []
    _jit_native_live = []
    _jit_native_vals = []
    _jit_native_buckets = hm_make_global_buckets()
    _jit_native_nexts = []

    _jit_compile_attempts = 0

fn _load_state() -> JitState:
    var compiled_list: [text] = []
    var i: i64 = 0
    while i < _jit_compiled_keys.len():
        if _jit_compiled_live[i] == 1:
            compiled_list.push(_jit_compiled_keys[i])
        i = i + 1
    JitState(
        threshold: _jit_threshold,
        enabled: _jit_enabled,
        epoch: _jit_epoch,
        call_keys: _jit_call_keys,
        call_vals: _jit_call_vals,
        compiled: compiled_list,
        used_keys: _jit_used_keys,
        used_vals: _jit_used_vals
    )

fn _save_state(s: JitState):
    _jit_threshold = s.threshold
    _jit_enabled = s.enabled
    _jit_epoch = s.epoch
    _jit_reset_tables()
    var ci: i64 = 0
    while ci < s.call_keys.len() and ci < s.call_vals.len():
        _jit_set_call_count(s.call_keys[ci], s.call_vals[ci])
        ci = ci + 1
    for name in s.compiled:
        jit_mark_compiled(name)
    var ui: i64 = 0
    while ui < s.used_keys.len() and ui < s.used_vals.len():
        _jit_set_used_epoch(s.used_keys[ui], s.used_vals[ui])
        ui = ui + 1

fn _jit_set_call_count(fn_name: text, count: i64):
    if _jit_call_buckets.len() == 0:
        _jit_call_buckets = hm_make_global_buckets()
    val bucket = hm_hash_text(fn_name) % HM_SIZE
    var idx = _jit_call_buckets[bucket]
    while idx != -1:
        if _jit_call_keys[idx] == fn_name:
            _jit_call_vals[idx] = count
            return
        idx = _jit_call_nexts[idx]
    val new_idx = _jit_call_keys.len()
    _jit_call_keys.push(fn_name)
    _jit_call_vals.push(count)
    _jit_call_nexts.push(_jit_call_buckets[bucket])
    _jit_call_buckets[bucket] = new_idx

fn _jit_set_used_epoch(fn_name: text, epoch: i64):
    if _jit_used_buckets.len() == 0:
        _jit_used_buckets = hm_make_global_buckets()
    val bucket = hm_hash_text(fn_name) % HM_SIZE
    var idx = _jit_used_buckets[bucket]
    while idx != -1:
        if _jit_used_keys[idx] == fn_name:
            _jit_used_vals[idx] = epoch
            return
        idx = _jit_used_nexts[idx]
    val new_idx = _jit_used_keys.len()
    _jit_used_keys.push(fn_name)
    _jit_used_vals.push(epoch)
    _jit_used_nexts.push(_jit_used_buckets[bucket])
    _jit_used_buckets[bucket] = new_idx

fn _jit_used_lookup_idx(fn_name: text) -> i64:
    if _jit_used_buckets.len() == 0:
        return -1
    val bucket = hm_hash_text(fn_name) % HM_SIZE
    var idx = _jit_used_buckets[bucket]
    while idx != -1:
        if _jit_used_keys[idx] == fn_name:
            return idx
        idx = _jit_used_nexts[idx]
    -1

fn _jit_mark_compile_failed(fn_name: text):
    if _jit_failed_buckets.len() == 0:
        _jit_failed_buckets = hm_make_global_buckets()
    val bucket = hm_hash_text(fn_name) % HM_SIZE
    var idx = _jit_failed_buckets[bucket]
    while idx != -1:
        if _jit_failed_keys[idx] == fn_name:
            if _jit_failed_live[idx] == 0:
                _jit_failed_live[idx] = 1
                _jit_failed_live_count = _jit_failed_live_count + 1
            return
        idx = _jit_failed_nexts[idx]
    val new_idx = _jit_failed_keys.len()
    _jit_failed_keys.push(fn_name)
    _jit_failed_live.push(1)
    _jit_failed_nexts.push(_jit_failed_buckets[bucket])
    _jit_failed_buckets[bucket] = new_idx
    _jit_failed_live_count = _jit_failed_live_count + 1

fn _jit_clear_compile_failed(fn_name: text):
    if _jit_failed_live_count == 0 or _jit_failed_buckets.len() == 0:
        return
    val bucket = hm_hash_text(fn_name) % HM_SIZE
    var idx = _jit_failed_buckets[bucket]
    while idx != -1:
        if _jit_failed_keys[idx] == fn_name:
            if _jit_failed_live[idx] == 1:
                _jit_failed_live[idx] = 0
                _jit_failed_live_count = _jit_failed_live_count - 1
            return
        idx = _jit_failed_nexts[idx]

fn jit_init(threshold: i64, verbose: i64):
    var enabled: i64 = 0
    if threshold < 999999:
        enabled = 1
    _jit_threshold = threshold
    _jit_enabled = enabled
    _jit_epoch = 0
    _jit_verbose = verbose
    _jit_backend = "auto"
    _jit_reset_tables()
    if verbose == 1:
        print "jit_init enabled={enabled} threshold={threshold}"

fn jit_init_with_backend(threshold: i64, verbose: i64, backend: text):
    jit_init(threshold, verbose)
    _jit_backend = backend

fn jit_cleanup():
    _jit_threshold = 10
    _jit_enabled = 0
    _jit_epoch = 0
    _jit_verbose = 0
    _jit_backend = "auto"
    _jit_reset_tables()

pub fn jit_record_call(fn_name: text):
    if _jit_enabled == 0:
        return
    jit_mark_symbol_used(fn_name)
    if _jit_call_buckets.len() == 0:
        _jit_call_buckets = hm_make_global_buckets()
    val bucket = hm_hash_text(fn_name) % HM_SIZE
    var idx = _jit_call_buckets[bucket]
    while idx != -1:
        if _jit_call_keys[idx] == fn_name:
            _jit_call_vals[idx] = _jit_call_vals[idx] + 1
            return
        idx = _jit_call_nexts[idx]
    val new_idx = _jit_call_keys.len()
    _jit_call_keys.push(fn_name)
    _jit_call_vals.push(1)
    _jit_call_nexts.push(_jit_call_buckets[bucket])
    _jit_call_buckets[bucket] = new_idx

fn jit_get_call_count(fn_name: text) -> i64:
    if _jit_call_buckets.len() == 0:
        return 0
    val bucket = hm_hash_text(fn_name) % HM_SIZE
    var idx = _jit_call_buckets[bucket]
    while idx != -1:
        if _jit_call_keys[idx] == fn_name:
            return _jit_call_vals[idx]
        idx = _jit_call_nexts[idx]
    0

# reason: core-interpreter JIT negative-cache query returns raw bool status
@allow(primitive_api) # reason: core-interpreter JIT negative-cache query returns raw bool status
pub fn jit_is_compile_failed(fn_name: text) -> bool:
    if _jit_failed_live_count == 0 or _jit_failed_buckets.len() == 0:
        return false
    val bucket = hm_hash_text(fn_name) % HM_SIZE
    var idx = _jit_failed_buckets[bucket]
    while idx != -1:
        if _jit_failed_keys[idx] == fn_name:
            return _jit_failed_live[idx] == 1
        idx = _jit_failed_nexts[idx]
    false

# reason: core-interpreter JIT negative-cache count returns raw i64 counter
@allow(primitive_api) # reason: core-interpreter JIT negative-cache count returns raw i64 counter
pub fn jit_compile_failed_count() -> i64:
    _jit_failed_live_count

# reason: core-interpreter JIT compile-attempt telemetry returns raw i64 counter
@allow(primitive_api) # reason: core-interpreter JIT compile-attempt telemetry returns raw i64 counter
pub fn jit_compile_attempt_count() -> i64:
    _jit_compile_attempts

# reason: core-interpreter JIT native callable registration uses raw i64 return word
@allow(primitive_api) # reason: core-interpreter JIT native callable registration uses raw i64 return word
pub fn jit_register_native_return(fn_name: text, result: i64):
    if _jit_native_buckets.len() == 0:
        _jit_native_buckets = hm_make_global_buckets()
    _jit_clear_compile_failed(fn_name)
    val bucket = hm_hash_text(fn_name) % HM_SIZE
    var idx = _jit_native_buckets[bucket]
    while idx != -1:
        if _jit_native_keys[idx] == fn_name:
            _jit_native_live[idx] = 1
            _jit_native_vals[idx] = result
            return
        idx = _jit_native_nexts[idx]
    val new_idx = _jit_native_keys.len()
    _jit_native_keys.push(fn_name)
    _jit_native_live.push(1)
    _jit_native_vals.push(result)
    _jit_native_nexts.push(_jit_native_buckets[bucket])
    _jit_native_buckets[bucket] = new_idx

# reason: core-interpreter JIT native callable check returns raw bool status
@allow(primitive_api) # reason: core-interpreter JIT native callable check returns raw bool status
pub fn jit_has_native_callable(fn_name: text) -> bool:
    if _jit_native_buckets.len() == 0:
        return false
    val bucket = hm_hash_text(fn_name) % HM_SIZE
    var idx = _jit_native_buckets[bucket]
    while idx != -1:
        if _jit_native_keys[idx] == fn_name:
            return _jit_native_live[idx] == 1
        idx = _jit_native_nexts[idx]
    false

fn jit_should_compile(fn_name: text) -> bool:
    if _jit_enabled == 0:
        return false
    if jit_is_compiled(fn_name):
        return false
    if jit_is_compile_failed(fn_name):
        return false
    val s = JitThresholdView(threshold: _jit_threshold)
    jit_get_call_count(fn_name) >= s.threshold

# reason: core-interpreter JIT compilation query returns raw bool status
@allow(primitive_api) # reason: core-interpreter JIT compilation query returns raw bool status
pub fn jit_is_compiled(fn_name: text) -> bool:
    if _jit_enabled == 0 or _jit_compiled_live_count == 0:
        return false
    if _jit_compiled_buckets.len() == 0:
        return false
    val bucket = hm_hash_text(fn_name) % HM_SIZE
    var idx = _jit_compiled_buckets[bucket]
    while idx != -1:
        if _jit_compiled_keys[idx] == fn_name:
            return _jit_compiled_live[idx] == 1
        idx = _jit_compiled_nexts[idx]
    false

fn jit_mark_compiled(fn_name: text):
    if _jit_compiled_buckets.len() == 0:
        _jit_compiled_buckets = hm_make_global_buckets()
    _jit_clear_compile_failed(fn_name)
    val bucket = hm_hash_text(fn_name) % HM_SIZE
    var idx = _jit_compiled_buckets[bucket]
    while idx != -1:
        if _jit_compiled_keys[idx] == fn_name:
            if _jit_compiled_live[idx] == 0:
                _jit_compiled_live[idx] = 1
                _jit_compiled_live_count = _jit_compiled_live_count + 1
            return
        idx = _jit_compiled_nexts[idx]
    val new_idx = _jit_compiled_keys.len()
    _jit_compiled_keys.push(fn_name)
    _jit_compiled_live.push(1)
    _jit_compiled_nexts.push(_jit_compiled_buckets[bucket])
    _jit_compiled_buckets[bucket] = new_idx
    _jit_compiled_live_count = _jit_compiled_live_count + 1

fn jit_try_compile(fn_name: text, mir_data: text) -> bool:
    if _jit_enabled == 0:
        return false
    if not jit_should_compile(fn_name):
        return false
    _jit_compile_attempts = _jit_compile_attempts + 1
    if jit_has_native_callable(fn_name):
        jit_mark_compiled(fn_name)
        return true
    _jit_mark_compile_failed(fn_name)
    false

# reason: core-interpreter JIT execution boundary uses raw i64 args and (bool, i64) result word
@allow(primitive_api) # reason: core-interpreter JIT execution boundary uses raw i64 args and (bool, i64) result word
pub fn jit_try_execute_checked(fn_name: text, args: [i64]) -> (bool, i64):
    if not jit_is_compiled(fn_name):
        return (false, 0)
    if _jit_native_buckets.len() == 0:
        return (false, 0)
    val bucket = hm_hash_text(fn_name) % HM_SIZE
    var idx = _jit_native_buckets[bucket]
    while idx != -1:
        if _jit_native_keys[idx] == fn_name:
            if _jit_native_live[idx] == 1:
                return (true, _jit_native_vals[idx])
            return (false, 0)
        idx = _jit_native_nexts[idx]
    (false, 0)

# reason: core-interpreter legacy JIT execution hook uses raw i64 args and i64 sentinel return
@allow(primitive_api) # reason: core-interpreter legacy JIT execution hook uses raw i64 args and i64 sentinel return
pub fn jit_try_execute(fn_name: text, args: [i64]) -> i64:
    val exec = jit_try_execute_checked(fn_name, args)
    if exec.0:
        return exec.1
    -1

fn jit_is_enabled() -> bool:
    _jit_enabled == 1

fn jit_compiled_count() -> i64:
    _jit_compiled_live_count

fn jit_total_tracked() -> i64:
    _jit_call_keys.len()

fn jit_mark_symbol_used(fn_name: text):
    _jit_set_used_epoch(fn_name, _jit_epoch)

fn jit_advance_epoch() -> i64:
    _jit_epoch = _jit_epoch + 1
    _jit_epoch

fn jit_get_epoch() -> i64:
    _jit_epoch

fn jit_sweep_stale(max_age: i64) -> i64:
    val cutoff = _jit_epoch - max_age
    var removed: i64 = 0
    var i: i64 = 0
    while i < _jit_compiled_keys.len():
        if _jit_compiled_live[i] == 1:
            val used_idx = _jit_used_lookup_idx(_jit_compiled_keys[i])
            if used_idx >= 0 and _jit_used_vals[used_idx] < cutoff:
                _jit_compiled_live[i] = 0
                _jit_compiled_live_count = _jit_compiled_live_count - 1
                removed = removed + 1
        i = i + 1
    removed

fn jit_cleanup_symbol(fn_name: text):
    if _jit_compiled_live_count > 0 and _jit_compiled_buckets.len() > 0:
        val bucket = hm_hash_text(fn_name) % HM_SIZE
        var idx = _jit_compiled_buckets[bucket]
        while idx != -1:
            if _jit_compiled_keys[idx] == fn_name:
                if _jit_compiled_live[idx] == 1:
                    _jit_compiled_live[idx] = 0
                    _jit_compiled_live_count = _jit_compiled_live_count - 1
                break
            idx = _jit_compiled_nexts[idx]
    _jit_clear_compile_failed(fn_name)
    if _jit_native_buckets.len() > 0:
        val nbucket = hm_hash_text(fn_name) % HM_SIZE
        var nidx = _jit_native_buckets[nbucket]
        while nidx != -1:
            if _jit_native_keys[nidx] == fn_name:
                _jit_native_live[nidx] = 0
                break
            nidx = _jit_native_nexts[nidx]

fn jit_sweep_tracked_count() -> i64:
    _jit_used_keys.len()
