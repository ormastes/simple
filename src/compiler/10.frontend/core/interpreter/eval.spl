# Core Interpreter — Tree-Walking Evaluator
#
# Seed-compilable evaluator for core.ast arena-based AST.
# Dispatches on expr/stmt/decl tags to evaluate the program.
#
# All evaluation returns a value_id (i64). Errors indicated by -1 (VAL_NONE).
#
# Control flow (return/break/continue) uses global flags since we cannot
# use exceptions or Result types in seed-compiled code.
#
# Split into:
# - eval_tables.spl — func/struct/enum tables, annotation scanner
# - eval_builtins.spl — eval_builtin_call
# - eval_stmts.spl — eval_stmt, eval_decl, eval_module, eval_init
# - eval_ops.spl — calls, methods, access, assignment, literals, misc evaluators

# ===== Coverage Instrumentation =====
extern fn rt_coverage_enabled() -> bool
extern fn rt_coverage_decision_probe(decision_id: i64, result: bool,
    file: text, line: i64, column: i64)
extern fn rt_coverage_condition_probe(decision_id: i64, condition_id: i64,
    result: bool, file: text, line: i64, column: i64)

# The runtime SFFI ABI is decision-id/result/file/line/column.  Keep the
# compiler-owned ID stable for one parsed AST: an execution counter produces a
# different ID each time a loop reaches the same branch and cannot truthfully
# represent a source decision.  The condition probe records the evaluated
# `if` predicate as condition 0 of that decision.
fn record_decision(file: text, line: i64, column: i64, decision_id: i64, taken: bool):
    if rt_coverage_enabled():
        rt_coverage_decision_probe(decision_id, taken, file, line, column)
        rt_coverage_condition_probe(decision_id, 0, taken, file, line, column)

# Control predicates need a decision probe plus one condition probe for each
# *evaluated* atomic operand.  Do not assign an execution-order counter here:
# loop iteration and short-circuiting would make a counter non-repeatable.  An
# AST node's source span start is stable for the parsed source; the expression
# id is only a fallback for synthetic/no-span ASTs used by interpreter tests.
fn coverage_condition_id(condition_eid: i64) -> i64:
    val condition_span = expr_get(condition_eid).span_id
    if span_is_valid(condition_span):
        return span_start(condition_span) + 1
    -1

fn coverage_span_decision_id(span_id: i64) -> i64:
    if span_is_valid(span_id): return span_start(span_id) + 1
    -1

fn record_control_decision(file: text, line: i64, column: i64, decision_id: i64, taken: bool):
    if rt_coverage_enabled():
        rt_coverage_decision_probe(decision_id, taken, file, line, column)

fn record_control_condition(decision_id: i64, condition_eid: i64, taken: bool):
    if rt_coverage_enabled():
        val condition_node = expr_get(condition_eid)
        val condition_span = condition_node.span_id
        var condition_line: i64 = 0
        var condition_column: i64 = 0
        if span_is_valid(condition_span):
            condition_line = span_line(condition_span)
            condition_column = span_col(condition_span)
        val condition_id = coverage_condition_id(condition_eid)
        if decision_id >= 0 and condition_id >= 0:
            rt_coverage_condition_probe(
                decision_id, condition_id, taken,
                coverage_owner_file(), condition_line, condition_column
            )

# Evaluates a control predicate while preserving language short-circuit
# semantics.  Only leaf operands are conditions: the enclosing `and`/`or`
# expression is a decision composition, not an independently evaluated input.
fn eval_control_condition(condition_eid: i64, decision_id: i64) -> i64:
    val condition_node = expr_get(condition_eid)
    if condition_node.tag == EXPR_BINARY and condition_node.i_val == 55:
        val left_value = eval_control_condition(condition_node.left, decision_id)
        if eval_had_error: return -1
        if val_is_truthy(left_value) == false:
            return val_make_bool(false)
        val right_value = eval_control_condition(condition_node.right, decision_id)
        if eval_had_error: return -1
        return val_make_bool(val_is_truthy(right_value))
    if condition_node.tag == EXPR_BINARY and condition_node.i_val == 56:
        val left_value = eval_control_condition(condition_node.left, decision_id)
        if eval_had_error: return -1
        if val_is_truthy(left_value):
            return val_make_bool(true)
        val right_value = eval_control_condition(condition_node.right, decision_id)
        if eval_had_error: return -1
        return val_make_bool(val_is_truthy(right_value))
    val condition_value = eval_expr(condition_eid)
    if eval_had_error: return -1
    val taken = val_is_truthy(condition_value)
    record_control_condition(decision_id, condition_eid, taken)
    condition_value

# Resolve the file that should own a coverage decision/line probe fired RIGHT
# NOW — the pure-Simple counterpart of the seed's RC1 (impl-method owner
# tagging, b6a43042) / RC2 (entry-script owner fallback, 40fa02ee). Prefers
# the currently-executing function/method's registered owner file
# (eval_current_decl_id, set by eval_function_call / eval_method_call around
# every call — see decl_owner_file_set, populated by
# module_loader_core.register_module_functions()); falls back to whichever
# module is currently being parsed/evaluated at the top level
# (module_get_path()) for entry-script top-level code, which executes
# immediately as its own module is loaded; falls back to a "<entry>"
# sentinel only if neither signal is available.
fn coverage_owner_file() -> text:
    if eval_current_decl_id >= 0:
        val owned = decl_owner_file_get(eval_current_decl_id)
        if owned != "":
            return owned
    val mp = module_get_path()
    if mp != "":
        return mp
    "<entry>"

# ===== Type Checking Integration =====
# Basic runtime type checking for function parameters

use compiler.core.types.{TYPE_VOID, TYPE_BOOL, TYPE_I64, TYPE_F64, TYPE_TEXT, TYPE_ANY}
use compiler.core.types.{TYPE_U8, TYPE_U16, TYPE_U32, TYPE_U64, TYPE_I8, TYPE_I16, TYPE_I32}
use compiler.core.types.{TYPE_NAMED_BASE, TYPE_STRUCT, named_type_name, type_tag_name}

# ===== Structural Subtyping =====
# Check if a struct value has all the fields declared in a named struct type.
# This implements Go-style structural subtyping / duck typing:
# if struct A has all fields of struct B, then A satisfies B.
#
# Parameters:
#   vid           - value_id of the struct value being checked
#   expected_name - name of the expected struct type (e.g. "OrderRepoPort")
#
# Returns true if the value has all required fields, false otherwise.
fn struct_satisfies(vid: i64, expected_name: text) -> bool:
    # Look up the expected struct declaration by name
    val decl_id = struct_table_lookup(expected_name)
    if decl_id < 0:
        # Unknown expected type — allow (cannot validate)
        return true
    # Get the field names that the expected type requires
    val required_fields = decl_get_fields(decl_id)
    if required_fields.len() == 0:
        # No required fields — any struct satisfies an empty struct
        return true
    # Check that the actual struct value has each required field
    for fname in required_fields:
        val fi = val_struct_find_field_idx(vid, fname)
        if fi < 0:
            return false
    true

fn type_check_value(value_id: i64, expected_type: i64) -> bool:
    # TYPE_ANY or TYPE_VOID means no constraint
    if expected_type == TYPE_ANY or expected_type == TYPE_VOID:
        return true

    # Get actual type from value
    val kind = val_get_kind(value_id)

    # Value kind constants (from value.spl)
    val VAL_NIL: i64 = 0
    val VAL_BOOL: i64 = 1
    val VAL_INT: i64 = 2
    val VAL_FLOAT: i64 = 3
    val VAL_TEXT: i64 = 4

    # Check type match
    if expected_type == TYPE_BOOL:
        return kind == VAL_BOOL
    if expected_type == TYPE_I64:
        return kind == VAL_INT
    if expected_type == TYPE_F64:
        return kind == VAL_FLOAT
    if expected_type == TYPE_TEXT:
        return kind == VAL_TEXT

    # Structural subtyping for named struct types (TYPE_NAMED_BASE + id)
    # If expected type is a named struct, check structural compatibility:
    # the actual value must be a struct with all required fields.
    if expected_type >= TYPE_NAMED_BASE:
        if kind != VAL_STRUCT:
            # Non-struct value cannot satisfy a struct type
            return false
        val nid = expected_type - TYPE_NAMED_BASE
        val expected_name = named_type_name(nid)
        if expected_name == "":
            return true
        # Same type name — exact match, always compatible
        val actual_name = val_get_struct_name(value_id)
        if actual_name == expected_name:
            return true
        # Different type name — apply structural subtyping check
        return struct_satisfies(value_id, expected_name)

    # TYPE_STRUCT (generic struct tag) — any struct satisfies
    if expected_type == TYPE_STRUCT:
        return kind == VAL_STRUCT

    # Default: allow if we don't recognize the type
    true

fn eval_option_binding_value(value_id: i64) -> i64:
    if val_is_struct(value_id):
        val option_name = val_get_struct_name(value_id)
        if option_name == "Option::None": return val_make_nil()
        if option_name == "Option::Some":
            return val_struct_get_field_idx(value_id, 1)
    value_id

# ===== Type Erasure / Monomorphization Support =====
# Cache and specialization logic live in core.monomorphize (shared module).
# Interpreter-specific type inference from runtime values stays here.
use compiler.core.monomorphize.{mono_cache_init, mono_cache_lookup, mono_cache_register, mono_specialize}

fn infer_type_args_from_values(arg_values: [i64]) -> text:
    # Infer type arguments from runtime values
    # Simple approach: concatenate type kinds
    var type_str: text = ""
    for av in arg_values:
        val kind = val_get_kind(av)
        if type_str != "":
            type_str = type_str + "_"
        type_str = type_str + str(kind)
    type_str

fn infer_type_tags_from_values(arg_values: [i64]) -> [i64]:
    """Infer concrete type tags from runtime argument values

    Maps value kinds to type tags:
    - VAL_INT (2) → TYPE_I64 (2)
    - VAL_FLOAT (3) → TYPE_F64 (3)
    - VAL_TEXT (4) → TYPE_TEXT (4)
    - VAL_BOOL (1) → TYPE_BOOL (1)
    - Others → TYPE_ANY (12)
    """
    var type_tags: [i64] = []
    for av in arg_values:
        val kind = val_get_kind(av)
        # Value kinds align with type tags for primitives
        if kind == 1:  # VAL_BOOL
            type_tags.push(TYPE_BOOL)
        elif kind == 2:  # VAL_INT
            type_tags.push(TYPE_I64)
        elif kind == 3:  # VAL_FLOAT
            type_tags.push(TYPE_F64)
        elif kind == 4:  # VAL_TEXT
            type_tags.push(TYPE_TEXT)
        else:
            type_tags.push(TYPE_ANY)
    type_tags

# ===== Local AST Constants for static_for and comptime =====
# STMT_STATIC_FOR = 17 (from ast.spl, avoids import dependency)
val EVAL_STMT_STATIC_FOR: i64 = 17
# STMT_COMPTIME = 18 (from ast.spl, avoids import dependency)
val EVAL_STMT_COMPTIME: i64 = 18
# STMT_BIND = 20 (from ast.spl, avoids import dependency)
val EVAL_STMT_BIND: i64 = 20
# STMT_LAZY_VAL_DECL = 21 (from ast.spl, avoids import dependency)
val EVAL_STMT_LAZY_VAL_DECL: i64 = 21
# DECL_LAZY_VAL = 12 (from ast.spl, avoids import dependency)
val EVAL_DECL_LAZY_VAL: i64 = 12

# ===== Control Flow Flags =====
var eval_returning: bool = false
var eval_return_value: i64 = -1
var eval_breaking: bool = false
var eval_continuing: bool = false
var eval_had_error: bool = false
var eval_error_msg: text = ""
# Labeled break/continue: target label name (empty = unlabeled)
var eval_break_label: text = ""
var eval_continue_label: text = ""
# Label stack: names of currently active loop labels (innermost last)
var eval_label_stack: [text] = []

# ===== Defer Stack =====
# Flat parallel arrays: expression IDs and their block scope depth.
var eval_defer_eids: [i64] = []
var eval_defer_depths: [i64] = []
var eval_defer_depth: i64 = 0

# ===== Errdefer Stack =====
# Separate parallel arrays for errdefer: only executed when scope exits with error.
var eval_errdefer_eids: [i64] = []
var eval_errdefer_depths: [i64] = []

# ===== Yield Accumulator Stack =====
var eval_yield_stack: [[i64]] = []

# ===== LOAD_FAST: Current Function Tracking =====
var eval_current_decl_id: i64 = -1
var eval_implicit_new_stack: [i64] = []

# ===== Warning Tracking =====
var eval_warnings: [text] = []

fn eval_get_warnings() -> [text]:
    eval_warnings

fn eval_reset():
    eval_returning = false
    eval_return_value = -1
    eval_breaking = false
    eval_continuing = false
    eval_had_error = false
    eval_error_msg = ""
    eval_warnings = []
    eval_break_label = ""
    eval_continue_label = ""
    eval_label_stack = []
    init_functions = []
    teardown_functions = []
    when_disabled_decls = []
    eval_current_decl_id = -1
    eval_implicit_new_stack = []
    eval_defer_eids = []
    eval_defer_depths = []
    eval_defer_depth = 0
    eval_errdefer_eids = []
    eval_errdefer_depths = []
    eval_yield_stack = []
    # Full enum-registry reset. Clearing only the two payload arrays left
    # `enum_hm_buckets`/`enum_hm_nexts` holding indices into the now-empty
    # arrays, so the next module's first enum lookup indexed out of bounds
    # (or hit a stale entry) — the re-entrancy defect tracked in
    # doc/08_tracking/bug/pure_simple_interpreter_core_jit_interpret_not_reentrant_2026-08-20.md
    enum_table_reset()

fn eval_set_error(msg: text):
    eval_had_error = true
    eval_error_msg = msg

fn eval_get_error() -> text:
    eval_error_msg

fn eval_has_error() -> bool:
    eval_had_error

# ===== Expression Evaluation =====

fn eval_integer_cast_type(type_tag: i64) -> bool:
    if type_tag == TYPE_I64 or type_tag == TYPE_U8 or type_tag == TYPE_U16: return true
    if type_tag == TYPE_U32 or type_tag == TYPE_U64 or type_tag == TYPE_I8: return true
    type_tag == TYPE_I16 or type_tag == TYPE_I32

fn eval_cast_expr(eid: i64) -> i64:
    val cast_node = expr_get(eid)
    if not eval_integer_cast_type(cast_node.i_val):
        eval_set_error("core interpreter only supports enum/integer casts to integer types")
        return -1
    val operand_id = cast_node.left
    val operand = expr_get(operand_id)
    if operand.tag == EXPR_FIELD_ACCESS:
        val base = expr_get(operand.left)
        if base.tag == EXPR_IDENT:
            val variants = enum_table_lookup(base.s_val)
            if variants != "":
                for variant_name in variants.split(","):
                    if variant_name == operand.s_val:
                        val discriminant = env_lookup_global(base.s_val + "." + variant_name)
                        if val_is_int(discriminant):
                            return discriminant
    val value = eval_expr(operand_id)
    if val_is_int(value):
        return value
    if val_is_struct(value):
        val full_name = val_get_struct_name(value)
        for enum_name in enum_reg_names:
            val prefix = enum_name + "::"
            if full_name.starts_with(prefix):
                val variant_name = full_name.substring(prefix.len())
                val discriminant = env_lookup_global(enum_name + "." + variant_name)
                if val_is_int(discriminant):
                    return discriminant
    eval_set_error("cast operand is not an enum discriminant or integer")
    -1

fn eval_expr(eid: i64) -> i64:
    if eid < 0: return val_make_nil()
    if eval_had_error: return -1
    if eval_returning: return eval_return_value

    val tag = expr_get(eid).tag

    # Range-partitioned dispatch: tags 1-12 (hot), 13-24 (medium), 25+ (rare)
    if tag <= 12:
        # Hot path: literals, ident, binary, unary, call, access
        if tag == EXPR_IDENT: return eval_ident(eid)
        if tag == EXPR_CALL: return eval_call(eid)
        if tag == EXPR_BINARY: return eval_binary(eid)
        if tag == EXPR_INT_LIT: return eval_int_lit(eid)
        if tag == EXPR_STRING_LIT: return eval_string_lit(eid)
        if tag == EXPR_FIELD_ACCESS: return eval_field_access(eid)
        if tag == EXPR_METHOD_CALL: return eval_method_call(eid)
        if tag == EXPR_INDEX: return eval_index_expr(eid)
        if tag == EXPR_UNARY: return eval_unary(eid)
        if tag == EXPR_FLOAT_LIT: return eval_float_lit(eid)
        if tag == EXPR_BOOL_LIT: return eval_bool_lit(eid)
        if tag == EXPR_NIL_LIT: return val_make_nil()
    elif tag <= 24:
        # Medium: control flow, collections, assignment
        if tag == EXPR_IF: return eval_if_expr(eid)
        if tag == EXPR_RETURN: return eval_return_expr(eid)
        if tag == EXPR_BLOCK: return eval_block_expr(eid)
        if tag == EXPR_FOR: return eval_for_expr(eid)
        if tag == EXPR_WHILE: return eval_while_expr(eid)
        if tag == EXPR_MATCH: return eval_match_expr(eid)
        if tag == EXPR_ARRAY_LIT: return eval_array_lit(eid)
        if tag == EXPR_ASSIGN: return eval_assign_expr(eid)
        if tag == EXPR_COMPOUND_ASSIGN: return eval_compound_assign_expr(eid)
        if tag == EXPR_RANGE: return eval_range(eid)
        if tag == EXPR_BREAK:
            eval_breaking = true
            return val_make_nil()
        if tag == EXPR_CONTINUE:
            eval_continuing = true
            return val_make_nil()
    else:
        # Rare: lambda, struct, tuple, async, pass, interpolation, etc.
        if tag == EXPR_LAMBDA: return eval_lambda(eid)
        if tag == EXPR_STRUCT_LIT: return eval_struct_lit(eid)
        if tag == EXPR_TUPLE: return eval_tuple_lit(eid)
        if tag == EXPR_DICT_LIT: return eval_dict_lit(eid)
        if tag == EXPR_INTERPOLATED_STRING: return eval_interpolated_string(eid)
        if tag == EXPR_SLICE: return eval_slice_expr(eid)
        if tag == EXPR_NULL_COALESCE: return eval_null_coalesce(eid)
        if tag == EXPR_CAST: return eval_cast_expr(eid)
        if tag == EXPR_UNIT: return val_make_nil()
        if tag == EXPR_PASS: return val_make_nil()
        if tag == EXPR_PASS_TODO: return val_make_nil()
        if tag == EXPR_PASS_DO_NOTHING: return val_make_nil()
        if tag == EXPR_PASS_DN: return val_make_nil()
        if tag == EXPR_DO_BLOCK: return eval_do_block(eid)
        # unsafe:/danger: block — evaluates its body like a do-block; the
        # unsafe distinction is a compile-time safety-checker concern only.
        if tag == EXPR_UNSAFE_BLOCK: return eval_do_block(eid)
        if tag == EXPR_LIST_COMP: return eval_list_comp(eid)
        if tag == EXPR_DICT_COMP: return eval_dict_comp(eid)
        if tag == EXPR_ATOM: return eval_atom_expr(eid)
        if tag == EXPR_AWAIT: return eval_await_expr(eid)
        if tag == EXPR_YIELD: return eval_yield_expr(eid)
        if tag == EXPR_SPAWN: return eval_spawn_expr(eid)
        if tag == EXPR_ASM: return val_make_int(0)
        if tag == EXPR_ASM_MATCH: return val_make_int(0)
        if tag == EXPR_EXISTS_CHECK:
            val ec_node = expr_get(eid)
            val base_vid = eval_expr(ec_node.left)
            if eval_had_error: return -1
            val normalized_vid = eval_option_binding_value(base_vid)
            if val_exists(normalized_vid):
                return normalized_vid
            else:
                return val_make_nil()
        # `expr!` force-unwrap. Distinct from `.?` above: `.?` YIELDS nil when
        # absent, `!` is an assertion that the operand is present and is a hard
        # error when it is not. Same operand slot (LEFT) as EXPR_EXISTS_CHECK.
        if tag == EXPR_FORCE_UNWRAP:
            val fu_node = expr_get(eid)
            val fu_base = eval_expr(fu_node.left)
            if eval_had_error: return -1
            val fu_value = eval_option_binding_value(fu_base)
            if val_exists(fu_value):
                return fu_value
            eval_set_error("force-unwrap `!` applied to a nil value")
            return -1
        if tag == EXPR_TRY: return eval_try(eid)
        if tag == EXPR_NEW:
            val new_node = expr_get(eid)
            val inner_eid = new_node.right
            return eval_expr(inner_eid)

    eval_set_error("unsupported expression kind: " + expr_kind_name(tag))
    -1

# ===== Literal Evaluation =====

fn eval_int_lit(eid: i64) -> i64:
    val_make_int(expr_get(eid).i_val)

fn eval_float_lit(eid: i64) -> i64:
    val float_text = expr_get(eid).f_val
    val_make_float(parse_float_text(float_text))

fn eval_string_lit(eid: i64) -> i64:
    val_make_text(expr_get(eid).s_val)

fn eval_bool_lit(eid: i64) -> i64:
    val_make_bool(expr_get(eid).i_val != 0)

# ===== Identifier Evaluation =====

fn eval_ident(eid: i64) -> i64:
    # Fast path: LOAD_FAST via pre-resolved local index
    val local_idx = expr_i_val[eid]
    if local_idx >= 0:
        if env_has_frame():
            val fast_val = env_get_local(local_idx)
            if fast_val >= 0:
                if val_is_thunk(fast_val):
                    val forced = eval_expr(val_thunk_get_expr(fast_val))
                    if eval_had_error: return -1
                    env_set_local(local_idx, forced)
                    env_assign(expr_s_val[eid], forced)
                    return forced
                return fast_val
    # Slow path: hash map lookup
    val name = expr_get(eid).s_val
    # Annotation intrinsics: only check when name starts with @ or _
    val id_first = name[0]
    if id_first == "@":
        if name == "@file": return val_make_text(module_get_path())
        if name == "@line": return val_make_int(1)
        if name == "@function":
            if eval_current_decl_id >= 0:
                val fn_decl_node = decl_get(eval_current_decl_id)
                return val_make_text(fn_decl_node.name)
            return val_make_text("<module>")
        if name == "@test_mode": return val_make_bool(false)
        if name == "@debug_mode": return val_make_bool(false)
    elif id_first == "_" and name.starts_with("__builtin_"):
        if name == "__builtin_file": return val_make_text(module_get_path())
        if name == "__builtin_line": return val_make_int(1)
        if name == "__builtin_function":
            if eval_current_decl_id >= 0:
                val bi_fn_node = decl_get(eval_current_decl_id)
                return val_make_text(bi_fn_node.name)
            return val_make_text("<module>")
        if name == "__builtin_test_mode": return val_make_bool(false)
        if name == "__builtin_debug_mode": return val_make_bool(false)
    val vid = env_lookup(name)
    if vid >= 0:
        if val_is_thunk(vid):
            val forced = eval_expr(val_thunk_get_expr(vid))
            if eval_had_error: return -1
            env_assign(name, forced)
            return forced
        return vid
    # Check function table
    val decl_id = func_table_lookup(name)
    if decl_id >= 0:
        return val_make_function(name, decl_id)
    # Try deferred (lazy) modules before giving up
    val forced_ok = try_force_any_deferred_for(name)
    if forced_ok == 1:
        val decl_id2 = func_table_lookup(name)
        if decl_id2 >= 0:
            return val_make_function(name, decl_id2)
        val vid2 = env_lookup(name)
        if vid2 >= 0: return vid2
    eval_set_error("undefined variable: " + name)
    -1

# ===== Binary/Unary =====

fn eval_binary(eid: i64) -> i64:
    val e_node = expr_get(eid)
    val op = e_node.i_val
    val left = eval_expr(e_node.left)
    if eval_had_error: return -1
    if op == 55 and val_is_truthy(left) == false:
        return val_make_bool(false)
    if op == 56 and val_is_truthy(left):
        return val_make_bool(true)
    val right = eval_expr(e_node.right)
    if eval_had_error: return -1
    val result = val_binary_op(op, left, right)
    if result < 0:
        val err = ops_get_error()
        if err != "":
            eval_set_error(err)
    result

fn eval_unary(eid: i64) -> i64:
    val e_node = expr_get(eid)
    val op = e_node.i_val
    val operand = eval_expr(e_node.left)
    if eval_had_error: return -1
    val result = val_unary_op(op, operand)
    if result < 0:
        val err = ops_get_error()
        if err != "":
            eval_set_error(err)
    result

# ===== If Expression =====

fn eval_if_expr(eid: i64) -> i64:
    val e_node = expr_get(eid)
    val cond_id = e_node.left
    val then_id = e_node.right
    val else_id = e_node.extra

    val cond_val = eval_control_condition(cond_id, coverage_span_decision_id(e_node.span_id))
    if eval_had_error: return -1

    val taken = val_is_truthy(cond_val)
    val span_id = e_node.span_id
    var source_line = 0
    var source_column = 0
    if span_is_valid(span_id):
        source_line = span_line(span_id)
        source_column = span_col(span_id)
    if span_is_valid(span_id):
        record_control_decision(coverage_owner_file(), source_line, source_column, span_start(span_id) + 1, taken)

    if taken:
        return eval_expr(then_id)
    if else_id >= 0:
        return eval_expr(else_id)
    val_make_nil()

# ===== Block Expression =====

fn eval_block_expr(eid: i64) -> i64:
    val e_node = expr_get(eid)
    val stmts = e_node.stmts
    val value_expr = e_node.left
    eval_block(stmts, value_expr)

fn eval_block(stmts: [i64], value_expr: i64) -> i64:
    env_push_scope()
    eval_defer_depth = eval_defer_depth + 1
    val my_depth = eval_defer_depth

    var last_val = val_make_nil()

    for sid in stmts:
        if eval_had_error: break
        if eval_returning: break
        if eval_breaking: break
        if eval_continuing: break
        last_val = eval_stmt(sid)

    if value_expr >= 0:
        val ctrl_interrupted = eval_had_error or eval_returning or eval_breaking or eval_continuing
        if ctrl_interrupted == false:
            last_val = eval_expr(value_expr)

    # Execute deferred expressions at this depth in reverse order (LIFO)
    val saved_returning = eval_returning
    val saved_had_error = eval_had_error
    eval_returning = false
    eval_had_error = false

    # Run defer expressions (always run)
    val total_deferred = eval_defer_eids.len()
    # Scan backward to run in LIFO order + tombstone in one pass
    var di = total_deferred - 1
    while di >= 0:
        if eval_defer_depths[di] == my_depth:
            eval_expr(eval_defer_eids[di])
            # Tombstone: mark as dead
            eval_defer_eids[di] = -1
            eval_defer_depths[di] = -1
        di = di - 1

    # Run errdefer expressions (only when scope exits with error)
    if saved_had_error:
        val total_errdeferred = eval_errdefer_eids.len()
        var edi = total_errdeferred - 1
        while edi >= 0:
            if eval_errdefer_depths[edi] == my_depth:
                eval_expr(eval_errdefer_eids[edi])
                # Tombstone: mark as dead
                eval_errdefer_eids[edi] = -1
                eval_errdefer_depths[edi] = -1
            edi = edi - 1
    # Tombstone cleanup for errdefer (always, even if not error — clear registrations)
    if saved_had_error == false:
        val total_errdeferred2 = eval_errdefer_eids.len()
        var edi2 = total_errdeferred2 - 1
        while edi2 >= 0:
            if eval_errdefer_depths[edi2] == my_depth:
                eval_errdefer_eids[edi2] = -1
                eval_errdefer_depths[edi2] = -1
            edi2 = edi2 - 1

    eval_returning = saved_returning
    eval_had_error = saved_had_error
    # Trim tombstones from the end (free O(1) pop cleanup)
    while eval_defer_eids.len() > 0 and eval_defer_eids[eval_defer_eids.len() - 1] == -1:
        eval_defer_eids.pop()
        eval_defer_depths.pop()
    while eval_errdefer_eids.len() > 0 and eval_errdefer_eids[eval_errdefer_eids.len() - 1] == -1:
        eval_errdefer_eids.pop()
        eval_errdefer_depths.pop()
    eval_defer_depth = eval_defer_depth - 1

    env_pop_scope()
    last_val

# ===== For Expression =====

fn eval_for_expr(eid: i64) -> i64:
    val e_node = expr_get(eid)
    val iter_name = e_node.s_val
    val iterable_eid = e_node.left
    val body_stmts = e_node.stmts

    val iterable = eval_expr(iterable_eid)
    if eval_had_error: return -1

    val kind = val_get_kind(iterable)
    var last_val = val_make_nil()

    # Iterate over array
    if kind == VAL_ARRAY:
        val elements = val_get_array(iterable)
        for elem_vid in elements:
            if eval_breaking: break
            if eval_returning: break
            if eval_had_error: break
            eval_continuing = false
            env_push_scope()
            env_define(iter_name, elem_vid)
            for sid in body_stmts:
                if eval_had_error: break
                if eval_returning: break
                if eval_breaking: break
                if eval_continuing: break
                last_val = eval_stmt(sid)
            env_pop_scope()
        eval_breaking = false
        eval_continuing = false
        return last_val

    # Iterate over range (check if iterable is a range pair)
    # Range is stored as: left=start, right=end, i_val=inclusive
    if kind == VAL_INT:
        # Check if iterable_eid is a RANGE expression
        val iterable_tag = expr_get(iterable_eid).tag
        if iterable_tag == EXPR_RANGE:
            val range_node = expr_get(iterable_eid)
            val start_val = eval_expr(range_node.left)
            if eval_had_error: return -1
            val end_val = eval_expr(range_node.right)
            if eval_had_error: return -1
            val inclusive = range_node.i_val
            val start_n = val_get_int(start_val)
            val end_n = val_get_int(end_val)
            var current = start_n
            val limit = end_n
            var _range_iter: i64 = 0
            while _range_iter < 1000001:
                if eval_breaking: break
                if eval_returning: break
                if eval_had_error: break
                val should_stop = current > limit
                val at_limit = current == limit
                if inclusive != 0:
                    if should_stop: break
                else:
                    if at_limit: break
                    if should_stop: break
                eval_continuing = false
                env_push_scope()
                env_define(iter_name, val_make_int(current))
                for sid in body_stmts:
                    if eval_had_error: break
                    if eval_returning: break
                    if eval_breaking: break
                    if eval_continuing: break
                    last_val = eval_stmt(sid)
                env_pop_scope()
                current = current + 1
                _range_iter = _range_iter + 1
            eval_breaking = false
            eval_continuing = false
            return last_val

    eval_set_error("cannot iterate over " + val_kind_name(kind))
    -1

# ===== Range Expression =====
# Range creates an array of integers for now
fn eval_range(eid: i64) -> i64:
    val e_node = expr_get(eid)
    val start_val = eval_expr(e_node.left)
    if eval_had_error: return -1
    val end_val = eval_expr(e_node.right)
    if eval_had_error: return -1
    val inclusive = e_node.i_val
    val start_n = val_get_int(start_val)
    val end_n = val_get_int(end_val)
    var elements: [i64] = []
    var current = start_n
    var _range_iter2: i64 = 0
    while _range_iter2 < 10001:
        val should_stop = current > end_n
        val at_limit = current == end_n
        if inclusive != 0:
            if should_stop: break
        else:
            if at_limit: break
            if should_stop: break
        elements.push(val_make_int(current))
        current = current + 1
        _range_iter2 = _range_iter2 + 1
    val_make_array(elements)

# ===== While Expression =====

fn eval_while_expr(eid: i64) -> i64:
    val e_node = expr_get(eid)
    val cond_eid = e_node.left
    val body_stmts = e_node.stmts
    var last_val = val_make_nil()
    var iterations: i64 = 0
    val max_iterations: i64 = 1000000

    while iterations < max_iterations:
        if eval_had_error: break
        if eval_returning: break
        if eval_breaking: break
        val cond_val = eval_control_condition(cond_eid, coverage_span_decision_id(e_node.span_id))
        if eval_had_error: break
        val taken = val_is_truthy(cond_val)
        val span_id = e_node.span_id
        var source_line: i64 = 0
        var source_column: i64 = 0
        if span_is_valid(span_id):
            source_line = span_line(span_id)
            source_column = span_col(span_id)
        if span_is_valid(span_id):
            record_control_decision(coverage_owner_file(), source_line, source_column, span_start(span_id) + 1, taken)
        if taken == false: break
        eval_continuing = false
        env_push_scope()
        for sid in body_stmts:
            if eval_had_error: break
            if eval_returning: break
            if eval_breaking: break
            if eval_continuing: break
            last_val = eval_stmt(sid)
        env_pop_scope()
        iterations = iterations + 1

    if iterations >= max_iterations:
        eval_set_error("while loop exceeded maximum iterations")

    eval_breaking = false
    eval_continuing = false
    last_val

# ===== Match Expression =====

fn eval_match_expr(eid: i64) -> i64:
    val e_node = expr_get(eid)
    val scrutinee = eval_expr(e_node.left)
    if eval_had_error: return -1
    val arm_ids = e_node.args

    # Exhaustiveness check: warn if enum variants are not all covered
    val inferred_type = infer_match_enum_type(arm_ids)
    check_match_exhaustive(arm_ids, inferred_type)

    for arm_id in arm_ids:
        val pattern_eid = arm_get_pattern(arm_id)
        val guard_eid = arm_get_guard(arm_id)
        val body_stmts = arm_get_body(arm_id)

        env_push_scope()
        val matched = match_pattern(scrutinee, pattern_eid)
        if eval_had_error:
            env_pop_scope()
            return -1
        if matched:
            # Check guard
            if guard_eid >= 0:
                val guard_val = eval_control_condition(guard_eid, coverage_span_decision_id(expr_get(guard_eid).span_id))
                if eval_had_error:
                    env_pop_scope()
                    return -1
                val guard_taken = val_is_truthy(guard_val)
                val guard_span = expr_get(guard_eid).span_id
                var guard_line: i64 = 0
                var guard_column: i64 = 0
                if span_is_valid(guard_span):
                    guard_line = span_line(guard_span)
                    guard_column = span_col(guard_span)
                if span_is_valid(guard_span):
                    record_control_decision(
                        coverage_owner_file(), guard_line, guard_column,
                        span_start(guard_span) + 1, guard_taken
                    )
                if guard_taken == false:
                    env_pop_scope()
                    continue
            # BUG-2026-08-01-match-fallthrough follow-up: a wildcard/bare-binder
            # arm absorbs any variant, including ones added later. Report it
            # (severity-gated, warn-only) using the actually resolved value.
            if val_is_boxed_enum(scrutinee) and pattern_is_wildcard_catch(pattern_eid):
                report_match_wildcard_catch(
                    inferred_type, val_enum_variant_name(scrutinee), val_kind_name(val_get_kind(scrutinee))
                )
            # Execute arm body
            # Pattern binding: case X as name: — bind scrutinee to name
            val binding_name = arm_get_binding(arm_id)
            if binding_name != "":
                env_define(binding_name, scrutinee)
            var last_val = val_make_nil()
            for sid in body_stmts:
                if eval_had_error: break
                if eval_returning: break
                last_val = eval_stmt(sid)
            env_pop_scope()
            return last_val
        env_pop_scope()

    # No arm matched. The old diagnostic named only the runtime KIND ("enum"),
    # which is not enough to find the bug — report the enum, the value, the
    # covered arms and the location. See report_match_fallthrough.
    val kind = val_get_kind(scrutinee)
    val val_name = val_kind_name(kind)
    report_match_fallthrough(inferred_type, val_enum_variant_name(scrutinee), val_name, arm_ids)
    if match_fallthrough_get_abort():
        eval_set_error(eval_warnings[eval_warnings.len() - 1])
        return -1
    val_make_nil()

fn pattern_is_wildcard_catch(pattern_eid: i64) -> bool:
    """True when a match arm pattern is a catch-all: `_`, `_ => expr` (same
    pattern AST node, only the arm-body syntax differs), or a bare lowercase
    binder such as `other:`. Decided purely from the pattern's OWN AST shape --
    the same branch match_pattern below already takes when it treats an
    unrecognized EXPR_IDENT as a binding -- never through a "which enum
    declares this variant name" lookup, so it carries none of the
    bare-name-collision risk documented in
    doc/08_tracking/bug/match_enum_fallthrough_silent_2026-08-01.md. Used by
    the wildcard-catch diagnostic (report_match_wildcard_catch)."""
    if pattern_eid < 0: return true
    val e_node = expr_get(pattern_eid)
    if e_node.tag != EXPR_IDENT: return false
    val name = e_node.s_val
    if name == "_": return true
    if name == "None": return false
    enum_variant_is_declared(name) == false

fn match_pattern(value_id: i64, pattern_eid: i64) -> bool:
    if pattern_eid < 0: return true
    val e_node = expr_get(pattern_eid)
    val tag = e_node.tag

    # Wildcard: _ matches anything
    if tag == EXPR_IDENT:
        val name = e_node.s_val
        if name == "_": return true
        # Nullary variant patterns must NOT be read as bindings. `case None:`
        # bound a variable literally named `None` and then matched every
        # scrutinee, so a `case Some(x)` / `case None` pair silently took
        # whichever arm came first. Same for a bare boxed variant (`case Red:`).
        if name == "None":
            if val_is_boxed_enum(value_id):
                return val_get_text(val_struct_get_field_idx(value_id, 0)) == "None"
            return val_is_nil(value_id)
        if enum_variant_is_declared(name):
            # Delegates to match_enum_variant_pattern so a bare nullary
            # pattern (`case Red:`) gets the same Option::Some/None-wrapper
            # unwrap as the qualified/call forms (`case E.C:`, `case E.A(x):`)
            # -- see the comment on that function.
            return match_enum_variant_pattern(value_id, name, [])
        # Binding: bind value to name
        env_define(name, value_id)
        return true

    # Literal patterns: direct comparison avoids allocating intermediate values
    if tag == EXPR_INT_LIT:
        if val_get_kind(value_id) != VAL_INT: return false
        return val_get_int(value_id) == e_node.i_val

    if tag == EXPR_STRING_LIT:
        if val_get_kind(value_id) != VAL_TEXT: return false
        return val_get_text(value_id) == e_node.s_val

    if tag == EXPR_BOOL_LIT:
        if val_get_kind(value_id) != VAL_BOOL: return false
        return val_get_bool(value_id) == (e_node.i_val != 0)

    if tag == EXPR_NIL_LIT:
        return val_is_nil(value_id)

    # Enum-variant patterns: `case Some(x)`, `case None`, `case Type.Variant`,
    # `case Type.Variant(x)`, `case Circle(r)`.
    #
    # match_pattern had NO enum-variant case at all before this: `case Some(x)`
    # fell through to the "try equality" default below, which EVALUATED the
    # pattern `Some(x)` with `x` unbound -- so the arm compared the scrutinee
    # against `Some(nil)` and the binding never happened. That is the
    # interpreter half of the Dict.get/Option defect (bug
    # cranelift_native_aggregate_return_nil_receiver_hosted_wm_2026-07-26).
    #
    # Option carries a DUAL runtime ABI, here and in the native lane alike
    # (50.mir/_MirLoweringExpr/switch_operators_calls.spl `lower_enum_match`):
    #   - BOXED: a "Type::Variant" struct with fields [__tag, __payload], built
    #     by eval_enum_variant_call (eval_access.spl).
    #   - FLAT:  a bare raw-or-nil word. Every raw producer yields this form --
    #     `Dict.get(k)` (call_method_eval.spl), `d[k]`, and any `T?` value.
    #     Wrapping those producers instead would break ~4,000 raw-or-nil call
    #     sites (`?? default`, `== nil`, direct use), so the decode side is
    #     what adapts -- the same choice `??`, `?` and `if val` already made
    #     (see eval_option_binding_value above, eval_null_coalesce/eval_try in
    #     eval_access.spl).
    # `case i64 v:` type-pattern arm (bug doc
    # union_narrowing_has_no_grammar_or_runtime_2026-08-21.md). The parser
    # lowers it to the marker call `__type_test(<Type>, <binder>)`, so it
    # arrives here as an EXPR_CALL and must be recognized BEFORE the
    # enum-variant branch below -- otherwise `__type_test` would be looked up
    # as a variant name and the arm would silently not match. The test is on
    # the RUNTIME value kind, which is exactly the union's discriminant in
    # this engine, and the binder is bound to the narrowed value.
    if tag == EXPR_CALL:
        val tt_callee = expr_get(e_node.left)
        if tt_callee.tag == EXPR_IDENT and tt_callee.s_val == "__type_test":
            if e_node.args.len() < 2:
                return false
            val tt_type_name = expr_get(e_node.args[0]).s_val
            val tt_binder_name = expr_get(e_node.args[1]).s_val
            val tt_kind = val_get_kind(value_id)
            var tt_ok = false
            if tt_type_name == "nil":
                tt_ok = val_is_nil(value_id)
            elif tt_type_name == "bool":
                tt_ok = tt_kind == VAL_BOOL
            elif tt_type_name == "text" or tt_type_name == "str":
                tt_ok = tt_kind == VAL_TEXT
            elif tt_type_name == "f32" or tt_type_name == "f64":
                tt_ok = tt_kind == VAL_FLOAT
            elif tt_type_name == "i8" or tt_type_name == "i16" or tt_type_name == "i32" or tt_type_name == "i64" or tt_type_name == "u8" or tt_type_name == "u16" or tt_type_name == "u32" or tt_type_name == "u64":
                tt_ok = tt_kind == VAL_INT
            else:
                # A NAMED type: the runtime value is a struct whose recorded
                # type name is the discriminator.
                tt_ok = tt_kind == VAL_STRUCT and val_get_struct_name(value_id) == tt_type_name
            if not tt_ok:
                return false
            env_define(tt_binder_name, value_id)
            return true

    if tag == EXPR_CALL:
        val callee_variant = pattern_enum_variant_name(e_node.left, val_is_boxed_enum(value_id))
        if callee_variant != "":
            return match_enum_variant_pattern(value_id, callee_variant, e_node.args)

    if tag == EXPR_FIELD_ACCESS:
        # `case Type.Variant:` — only claim it when the scrutinee really is a
        # boxed enum, so ordinary constant patterns (`case Colors.RED:`) keep
        # falling through to the equality default below.
        if val_is_boxed_enum(value_id):
            val fa_variant = e_node.s_val
            if fa_variant != "":
                return match_enum_variant_pattern(value_id, fa_variant, [])

    # Default: try equality comparison
    val pattern_val = eval_expr(pattern_eid)
    if eval_had_error: return false
    val_equals(value_id, pattern_val)

fn val_enum_variant_name(value_id: i64) -> text:
    """Variant name of a boxed enum value, or "" when it is not one.

    Used by the match fall-through diagnostic so the report can name the value
    that matched nothing, not just its runtime kind.
    """
    if val_is_boxed_enum(value_id) == false: return ""
    val tag_idx = val_struct_find_field_idx(value_id, "__tag")
    if tag_idx < 0: return ""
    val_get_text(val_struct_get_field_idx(value_id, tag_idx))

fn val_is_boxed_enum(value_id: i64) -> bool:
    """True when `value_id` is the boxed [__tag, __payload] struct that
    eval_enum_variant_call builds for every enum variant construction."""
    if value_id < 0: return false
    if val_is_struct(value_id) == false: return false
    # Dict literals are also dynamic-field structs; a dict is never an enum.
    if val_get_struct_name(value_id) == "__dict": return false
    val_struct_find_field_idx(value_id, "__tag") >= 0

fn pattern_enum_variant_name(callee_eid: i64, value_is_boxed_enum: bool) -> text:
    """Variant name of an enum-variant call pattern, or "" when the callee is
    not a variant reference. `Some(x)` -> "Some"; `Option.Some(x)` -> "Some";
    `helper(x)` -> "" (left to the equality default)."""
    if callee_eid < 0: return ""
    val c_node = expr_get(callee_eid)
    if c_node.tag == EXPR_FIELD_ACCESS:
        # Qualified `Type.Variant(...)` — the field name IS the variant.
        return c_node.s_val
    if c_node.tag == EXPR_IDENT:
        val cname = c_node.s_val
        # Option/Result variants are variant patterns unconditionally: they are
        # the two enums with a flat (unboxed) encoding, so the scrutinee alone
        # cannot identify them. Any other bare identifier is only treated as a
        # variant when the scrutinee is actually a boxed enum — which keeps
        # ordinary `case helper(x):`-shaped call patterns on the equality path.
        if cname == "Some" or cname == "None" or cname == "Ok" or cname == "Err":
            return cname
        if enum_variant_is_declared(cname):
            return cname
        if value_is_boxed_enum:
            return cname
    ""

fn match_enum_variant_pattern(value_id: i64, variant: text, arg_eids: [i64]) -> bool:
    """Match `value_id` against enum variant `variant`, binding sub-patterns
    from the payload. Handles the boxed [__tag, __payload] struct form and the
    flat raw-or-nil form of Option."""
    # Boxed form: compare the runtime __tag against the pattern's variant.
    if val_is_boxed_enum(value_id):
        # An Option::Some/Option::None BOX wrapping a real enum value (as
        # opposed to that enum's OWN boxed [__tag, __payload] struct, whose
        # struct name is "EnumName::Variant") must be unwrapped before
        # comparing a tag against a non-Option variant name. Without this, an
        # `E?` scrutinee matched directly against E's own variant patterns
        # (`case E.A(x):`, no leading `case Some(...)`/force-unwrap) compared
        # the WRAPPER's own tag ("Some"/"None") against "A"/"C" and could
        # never match -- verified directly: match_enum_variant_pattern on an
        # Option::Some(E::A(7)) value against variant "A" returned false
        # before this check. See doc/08_tracking/bug/
        # interpreter_match_on_option_of_enum_fires_no_arm_2026-08-06.md.
        if variant != "Some" and variant != "None":
            val struct_name = val_get_struct_name(value_id)
            if struct_name == "Option::Some":
                return match_enum_variant_pattern(val_struct_get_field_idx(value_id, 1), variant, arg_eids)
            if struct_name == "Option::None":
                return false
        val tag_text = val_get_text(val_struct_get_field_idx(value_id, 0))
        if tag_text != variant: return false
        if arg_eids.len() == 0: return true
        val payload = val_struct_get_field_idx(value_id, 1)
        if arg_eids.len() == 1:
            return match_pattern(payload, arg_eids[0])
        # Multi-field payloads are stored as an array (eval_enum_variant_call).
        if val_get_kind(payload) != VAL_ARRAY: return false
        val elems = val_get_array(payload)
        if elems.len() != arg_eids.len(): return false
        var mi = 0
        while mi < arg_eids.len():
            if match_pattern(elems[mi], arg_eids[mi]) == false: return false
            mi = mi + 1
        return true

    # Flat form: the raw word is its own payload; nil means absent. Only
    # Option's variants have a flat encoding — Result and user enums are
    # always boxed, so an unboxed value simply does not match them.
    if variant == "None":
        return val_is_nil(value_id)
    if variant == "Some":
        if val_is_nil(value_id): return false
        if arg_eids.len() == 0: return true
        return match_pattern(value_id, arg_eids[0])
    false

# ===== Re-exports from split files =====
# These ensure backward compatibility for external imports from eval.spl

# From eval_tables.spl
