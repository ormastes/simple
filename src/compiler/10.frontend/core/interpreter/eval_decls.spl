# Core Interpreter — Declaration/Module/Async Evaluation
#
# Split from eval_stmts.spl. Contains:
# - eval_decl: Declaration evaluation (fn, struct, val, var, enum, use, export, ce)
# - eval_module: Module evaluation (phase 1-5: register, eval, @init, main, @teardown)
# - eval_init: Full initialization
# - Async/await stubs, labeled loops, do blocks, atom expressions
#
# All evaluation returns a value_id (i64). Errors indicated by -1 (VAL_NONE).

use compiler.core.ast_types.{CoreExpr, CoreStmt, CoreDecl}
use compiler.core.enum_discriminant_eval.{eval_enum_discriminant_expr}
use compiler.common.assurance.policy_names.normalize_profile_name
use compiler.common.assurance.warning_phase.{warning_phase_enabled_for_value,
    warning_phase_env_var_name}

@unsafe(reason: "raw assurance-policy environment read; empty text conflates unset input with provider failure", capabilities: [ffi])
extern fn rt_env_get(key: text) -> text

# ===== Declaration Evaluation =====

fn eval_decl(did: i64) -> i64:
    if did < 0: return val_make_nil()
    if eval_had_error: return -1

    val d_node = decl_get(did)
    val tag = d_node.tag

    # Check @when conditional compilation: skip disabled decls
    val decl_name = d_node.name
    for disabled_name in when_disabled_decls:
        if disabled_name == decl_name:
            return val_make_nil()

    if tag == DECL_FN:
        val name = d_node.name
        val ret_type = d_node.ret_type
        func_table_register(name, did)
        func_register_return_type(name, ret_type)
        # coverage owner-attribution (entry-script equivalent of seed RC2):
        # module_get_path() is correct here since eval_decl runs as part of
        # the SAME single-source pipeline that just parsed this exact file.
        decl_owner_file_set(did, module_get_path())
        return val_make_nil()

    if tag == DECL_STRUCT:
        val name = d_node.name
        struct_table_register(name, did)
        return val_make_nil()

    if tag == DECL_IMPL:
        for method_id in d_node.body_stmts:
            val method = decl_get(method_id)
            func_table_register(method.name, method_id)
            func_register_return_type(method.name, method.ret_type)
            # coverage owner-attribution — impl-block methods declared
            # directly in the entry script (RC1 equivalent).
            decl_owner_file_set(method_id, module_get_path())
        return val_make_nil()

    if tag == DECL_VAL:
        val name = d_node.name
        val body = d_node.body_stmts
        var init_val = val_make_nil()
        if body.len() > 0:
            init_val = eval_expr(body[0])
            if eval_had_error: return -1
        env_define_global(name, init_val)
        return init_val

    if tag == EVAL_DECL_LAZY_VAL:
        val lv_name = d_node.name
        val lv_body = d_node.body_stmts
        var thunk_val = val_make_nil()
        if lv_body.len() > 0:
            thunk_val = val_make_thunk(lv_body[0])
        env_define_global(lv_name, thunk_val)
        return thunk_val

    if tag == DECL_VAR:
        val name = d_node.name
        val body = d_node.body_stmts
        var init_val = val_make_nil()
        if body.len() > 0:
            init_val = eval_expr(body[0])
            if eval_had_error: return -1
        env_define_global(name, init_val)
        return init_val

    if tag == DECL_ENUM:
        # Register enum variants as constants
        val name = d_node.name
        val variants = d_node.field_names
        val discriminant_exprs = d_node.field_defaults
        var resolved_discriminants: [i64] = []
        var next_discriminant: i64 = 0
        var vi: i64 = 0
        for variant_name in variants:
            var discriminant = next_discriminant
            if vi < discriminant_exprs.len() and discriminant_exprs[vi] >= 0:
                val evaluated = eval_enum_discriminant_expr(
                    discriminant_exprs[vi], name, variants[0:vi], resolved_discriminants
                )
                if not evaluated.valid:
                    eval_set_error("enum " + name + " variant " + variant_name + ": " + evaluated.error)
                    return -1
                discriminant = evaluated.value
            if discriminant < 0 or discriminant > 2147483647:
                eval_set_error("enum " + name + " variant " + variant_name + " discriminant is outside 0..2147483647")
                return -1
            for prior_discriminant in resolved_discriminants:
                if prior_discriminant == discriminant:
                    eval_set_error("enum " + name + " variant " + variant_name + " has a duplicate discriminant")
                    return -1
            val discriminant_value = val_make_int(discriminant)
            env_define_global(variant_name, discriminant_value)
            env_define_global(name + "." + variant_name, discriminant_value)
            resolved_discriminants.push(discriminant)
            next_discriminant = discriminant + 1
            vi = vi + 1
        # Register enum in registry for exhaustiveness checking
        enum_table_register(name, variants)
        return val_make_nil()

    if tag == DECL_USE:
        # Load module and register its exports
        val module_path = d_node.name
        val imported_names = d_node.imports
        val current_file = module_get_path()

        # Check if this is a lazy import — defer loading
        val is_lazy = decl_get_is_lazy(did)
        if is_lazy == 1:
            register_deferred_module(module_path, current_file, imported_names)
            return val_make_nil()

        # If imports list is empty, load full module
        # Otherwise, load selective imports
        var load_result: i64 = 0
        if imported_names.len() == 0:
            load_result = load_module(module_path, current_file)
        else:
            load_result = load_module_selective(module_path, imported_names, current_file)

        if load_result == 0:
            eval_set_error("failed to load module: " + module_path)
            return -1

        return val_make_nil()

    if tag == DECL_EXPORT:
        # Export declarations - handled during module loading
        # No runtime action needed
        return val_make_nil()

    if tag == DECL_CE:
        # ce NAME: block — evaluate with appropriate CE semantics.
        # For seq/seq_ce builders: collect yield values into array.
        # For other builders: monadic bind with nil short-circuit.
        val ce_builder = d_node.name
        val ce_body = d_node.body_stmts
        env_push_scope()
        var ce_last: i64 = val_make_nil()
        var ce_short_circuit: bool = false
        val ce_is_seq = (ce_builder == "seq" or ce_builder == "seq_ce")
        if ce_is_seq:
            val new_acc: [i64] = []
            eval_yield_stack.push(new_acc)
        for ce_sid in ce_body:
            if eval_had_error: break
            if eval_returning: break
            if ce_short_circuit: break
            val ce_stmt_tag = stmt_get(ce_sid).tag
            if ce_stmt_tag == EVAL_STMT_BIND and not ce_is_seq:
                # Monadic bind: eval rhs, short-circuit on nil
                val ce_bind_node = stmt_get(ce_sid)
                val ce_bind_name = ce_bind_node.name
                val ce_bind_rhs = eval_expr(ce_bind_node.expr_idx)
                if eval_had_error:
                    ce_last = -1
                else:
                    val ce_bind_is_nil = val_get_kind(ce_bind_rhs) == 0
                    if ce_bind_is_nil:
                        ce_last = ce_bind_rhs
                        ce_short_circuit = true
                    else:
                        env_define(ce_bind_name, ce_bind_rhs)
                        ce_last = ce_bind_rhs
            else:
                ce_last = eval_stmt(ce_sid)
        if ce_is_seq:
            val ys_len = eval_yield_stack.len()
            if ys_len > 0:
                val collected = eval_yield_stack[ys_len - 1]
                eval_yield_stack = eval_yield_stack[0:ys_len - 1]
                env_pop_scope()
                return val_make_array(collected)
        env_pop_scope()
        return ce_last

    if tag == DECL_CLI:
        # cli Name: declarative arg parsing — parse argv, define global struct
        val cli_struct_name = d_node.name
        val cli_fields = d_node.field_names
        val cli_directives = d_node.imports
        val cli_sub_decls = d_node.body_stmts
        val parsed_val = cli_parse_argv(cli_fields, cli_directives, cli_sub_decls)
        env_define_global(cli_struct_name, parsed_val)
        return parsed_val

    # DECL_EXTERN_FN and DECL_CLASS — skip for now
    val_make_nil()

# ===== Module Evaluation =====

fn eval_module() -> i64:
    val decls = module_get_decls()

    # Phase 1: Register all functions and structs
    for did in decls:
        val d_node = decl_get(did)
        val tag = d_node.tag
        if tag == DECL_FN:
            func_table_register(d_node.name, did)
            func_register_return_type(d_node.name, d_node.ret_type)
            # coverage owner-attribution — entry-script top-level functions
            # (RC2 equivalent): module_get_path() reflects the entry file
            # itself, since this Phase-1 registration loop runs immediately
            # after parsing that exact source.
            decl_owner_file_set(did, module_get_path())
        if tag == DECL_EXTERN_FN:
            func_register_return_type(d_node.name, d_node.ret_type)
        if tag == DECL_STRUCT:
            struct_table_register(d_node.name, did)
        if tag == DECL_IMPL:
            eval_decl(did)

    # Phase 1.5: Process use/import declarations (load dependent modules)
    for did in decls:
        if eval_had_error: break
        val utag = decl_get(did).tag
        if utag == DECL_USE:
            eval_decl(did)

    # Phase 2: Evaluate declarations (val/var bindings, enums)
    var last_val = val_make_nil()
    for did in decls:
        if eval_had_error: break
        val tag = decl_get(did).tag
        if tag == DECL_VAL:
            eval_decl(did)
        if tag == EVAL_DECL_LAZY_VAL:
            eval_decl(did)
        if tag == DECL_VAR:
            eval_decl(did)
        if tag == DECL_ENUM:
            eval_decl(did)
        if tag == DECL_CLI:
            eval_decl(did)

    # Phase 3: Call @init functions in order (before main)
    for init_fn_name in init_functions:
        if eval_had_error: break
        val init_decl = func_table_lookup(init_fn_name)
        if init_decl >= 0:
            var init_args: [i64] = []
            eval_function_call(init_decl, init_args, [])

    # Phase 4: Call main() if it exists
    val main_decl = func_table_lookup("main")
    if main_decl >= 0:
        var empty_args: [i64] = []
        last_val = eval_function_call(main_decl, empty_args, [])

    # Phase 5: Call @teardown functions in reverse order (after main)
    val teardown_len = teardown_functions.len()
    var tdi: i64 = teardown_len - 1
    while tdi >= 0:
        val td_fn_name = teardown_functions[tdi]
        val td_decl = func_table_lookup(td_fn_name)
        if td_decl >= 0:
            var td_args: [i64] = []
            eval_function_call(td_decl, td_args, [])
        tdi = tdi - 1

    last_val

# ===== Full Initialization =====

# The INTERPRETER'S PROJECTION of the shared assurance-profile table: a plain
# bool ("does this rung abort on a match fall-through"), which is a different
# mapping from the driver's SafetyPassSeverity and from lint's level dict. The
# names are shared; the semantics are not, and WP-3 deliberately did not
# flatten them.
#
# The alias list used to be re-typed here because
# driver_safety_severity.spl's header said it must not be pulled into a session
# that also runs parse_full_frontend
# (doc/08_tracking/bug/interp_lint_main_then_frontend_dict_to_int_2026-07-28.md).
# WP-3 moved the table down to 00.common instead: policy_names.spl has zero
# imports and zero module-level state, and the pairing is covered by
# test/01_unit/compiler/assurance/policy_graph_contamination_probe_spec.spl.
#
# robust/reliable resolve to Warn in the driver, not Deny, so they stay
# non-aborting here too (default warn-only behaviour, unchanged).
fn match_fallthrough_profile_is_deny(raw: text) -> bool:
    normalize_profile_name(raw) == "critical"

# Apply an assurance profile to the interpreter's diagnostic-severity flags.
#
# Premise 5b: eval_init used to READ SIMPLE_SAFETY_PROFILE inline and could
# therefore never observe a policy resolved later — a latch. Splitting the
# apply step out removes the latch: any caller holding a resolved policy calls
# this with `policy_env_value(policy)` (or any accepted spelling) at any point
# in the session, and the flags follow. eval_init still seeds it from the env
# var so an unconfigured session behaves exactly as before, but the env read is
# now only the DEFAULT, not the sole authority.
pub fn eval_apply_assurance_profile(profile_name: text):
    var warning_phase_value = ""
    unsafe(capabilities: [ffi]):
        warning_phase_value = rt_env_get(warning_phase_env_var_name()) ?? ""
    eval_apply_assurance_profile_phased(profile_name,
        warning_phase_enabled_for_value(warning_phase_value))

# WARNING PHASE (2026-08-23) — the interpreter's projection of the one-level
# severity downgrade, and the one place where the three projections genuinely
# differ in what they CAN express. Stated plainly rather than papered over:
#
#   * The interpreter's projection is a BOOL, not a level. A bool can encode
#     exactly one step of the ladder — Deny -> Warn — and nothing below it. It
#     cannot express Warn -> Advisory, and `false` therefore clamps.
#
#   * Only flags with a real warn path may be downgraded. Of the three flags
#     fanned out here, only `match_fallthrough_set_abort` qualifies: `false`
#     leaves the warn-only fall-through diagnostic still being emitted.
#
#   * `match_wildcard_catch_set_enabled` is a VISIBILITY flag, not a severity —
#     `false` stops the wildcard diagnostic being emitted at all. Downgrading it
#     would make critical-under-warning-phase report LESS than critical, which
#     is precisely what this feature forbids. It stays keyed to the raw profile.
#
#   * `import_admission_set_deny` is an ADMISSION gate, not a severity —
#     `false` silently ADMITS the built-in-fallback import
#     (`module_loader_core.spl:499`) with no diagnostic of any kind. It has no
#     warn rung to fall to, so it also stays keyed to the raw profile.
#     TODO [interp][P2][warning-phase]: give import admission a warn rung
#     (emit the diagnostic, admit the import) so it can participate in the
#     downgrade instead of being excluded from it.
#
# Net effect: under warning phase a `critical` interpreter session stops
# ABORTING on match fall-through while still reporting it, and reports strictly
# no less than it did without the phase.
fn eval_apply_assurance_profile_phased(profile_name: text, warning_phase: bool):
    val deny = match_fallthrough_profile_is_deny(profile_name)
    val abort = deny and not warning_phase
    match_fallthrough_set_abort(abort)
    # Same follow-up: surface the wildcard/bare-binder-catch diagnostic under
    # Deny severity too. Warn-only for now (no abort variant) -- "wild card
    # use even warning later error for compatibility" per the user request;
    # the abort escalation is deferred, same as the MIR promotion TODO below.
    match_wildcard_catch_set_enabled(deny)
    import_admission_set_deny(deny)

fn eval_init():
    val_reset()
    env_init()
    func_table_reset()
    struct_table_reset()
    mono_cache_init()
    eval_reset()
    module_loader_init()
    # BUG-2026-08-01-match-fallthrough: promote the warn-only match
    # fall-through diagnostic to a hard interpreter-tier error when the
    # assurance profile resolves to Deny severity. The env var is the DEFAULT
    # seed only (subprocess serialization, WP-3); a caller with a resolved
    # policy re-applies it via eval_apply_assurance_profile at any time.
    var safety_profile_value = ""
    unsafe(capabilities: [ffi]):
        safety_profile_value = rt_env_get("SIMPLE_SAFETY_PROFILE") ?? ""
    eval_apply_assurance_profile(safety_profile_value)

# ===== Async/Await Expressions (Basic Stubs) =====
# TODO [interp][P2]: Full state machine support requires desugaring to state machines
# For now, these are minimal implementations to avoid crashes

fn eval_await_expr(eid: i64) -> i64:
    """Evaluate an await expression: await future_expr

    Basic stub: evaluates the future expression and returns it immediately.
    Full async support requires state machine transformation.
    """
    val e_node = expr_get(eid)
    val future_eid = e_node.left
    # For now, just evaluate the future synchronously
    val result = eval_expr(future_eid)
    if eval_had_error: return -1
    result

fn eval_yield_expr(eid: i64) -> i64:
    val e_node = expr_get(eid)
    val value_eid = e_node.left
    val result = eval_expr(value_eid)
    if eval_had_error: return -1
    if eval_yield_stack.len() > 0:
        val top_idx = eval_yield_stack.len() - 1
        eval_yield_stack[top_idx].push(result)
    result

fn eval_spawn_expr(eid: i64) -> i64:
    """Evaluate a spawn expression: spawn fn_call

    Basic stub: evaluates the call synchronously.
    Full actor support requires async runtime integration.
    """
    val e_node = expr_get(eid)
    val call_eid = e_node.left
    # For now, just evaluate the call synchronously
    val result = eval_expr(call_eid)
    if eval_had_error: return -1
    result

fn eval_labeled_loop(sid: i64) -> i64:
    # Evaluate a labeled loop: push label, run inner loop, pop label
    # If break/continue targets this label, consume the break state
    val s_node = stmt_get(sid)
    val my_label = s_node.name
    val body_stmts = s_node.body
    eval_label_stack.push(my_label)
    # Execute the inner loop stmt
    var result = val_make_nil()
    if body_stmts.len() > 0:
        val inner_sid = body_stmts[0]
        result = eval_stmt(inner_sid)
    # Pop label
    val stack_len = eval_label_stack.len()
    if stack_len > 0:
        val new_stack: [text] = eval_label_stack[0:stack_len - 1]
        eval_label_stack = new_stack
    # If break targeted this label, consume it
    if eval_breaking:
        if eval_break_label == my_label:
            eval_breaking = false
            eval_break_label = ""
    # If continue targeted this label, consume it (already consumed by loop)
    if eval_continuing:
        if eval_continue_label == my_label:
            eval_continuing = false
            eval_continue_label = ""
    result

fn eval_do_block(eid: i64) -> i64:
    # Evaluates a do: block expression, returning the value of the last statement
    val e_node = expr_get(eid)
    val body_stmts = e_node.stmts
    env_push_scope()
    var last_val = val_make_nil()
    for sid in body_stmts:
        if eval_had_error: break
        if eval_returning: break
        last_val = eval_stmt(sid)
    env_pop_scope()
    last_val

fn eval_atom_expr(eid: i64) -> i64:
    # Evaluates an atom literal `symbol — stored as an interned text value
    val e_node = expr_get(eid)
    val atom_name = e_node.s_val
    # Atoms are represented as text with a special prefix for identity comparison
    val_make_text("`" + atom_name)
