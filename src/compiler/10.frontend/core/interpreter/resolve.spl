# Core Interpreter — Local Variable Resolution (LOAD_FAST)
#
# Assigns compile-time slot indices to local variables within function bodies.
# This enables O(1) array access via frame_locals[] instead of O(scope_chain)
# hash map lookups for non-shadowed variables.
#
# Algorithm:
# 1. For each DECL_FN, prescan body to register all local names (params, val, var, for-iterators)
# 2. Names declared more than once are marked "shadowed" and fall back to slow path
# 3. Walk expression tree, set expr_i_val[eid] = slot for non-shadowed EXPR_IDENT nodes
# 4. Per-function slot mappings are cached for use at call time

use compiler.core.ast_types.{CoreExpr, CoreStmt, CoreDecl}
use compiler.core.types.{span_line}

# ===== Resolution State =====
# Current function being resolved
var rl_keys: [text] = []
var rl_vals: [i64] = []
var rl_buckets: [i64] = []
var rl_nexts: [i64] = []
var rl_count: i64 = 0
var rl_shadowed: [bool] = []

val RL_HM_SIZE: i64 = 64

fn rl_make_buckets() -> [i64]:
    var b: [i64] = []
    var i: i64 = 0
    while i < RL_HM_SIZE:
        b.push(-1)
        i = i + 1
    b

fn rl_reset():
    rl_keys = []
    rl_vals = []
    rl_buckets = rl_make_buckets()
    rl_nexts = []
    rl_count = 0
    rl_shadowed = []

fn rl_register(name: text) -> i64:
    val bucket = hm_hash_text(name) % RL_HM_SIZE
    var idx = rl_buckets[bucket]
    while idx != -1:
        if rl_keys[idx] == name:
            # Already registered — mark as shadowed
            rl_shadowed[idx] = true
            return rl_vals[idx]
        idx = rl_nexts[idx]
    # New name
    val slot = rl_count
    val new_idx = rl_keys.len()
    rl_keys.push(name)
    rl_vals.push(slot)
    rl_nexts.push(rl_buckets[bucket])
    rl_buckets[bucket] = new_idx
    rl_shadowed.push(false)
    rl_count = rl_count + 1
    slot

fn rl_lookup(name: text) -> i64:
    val bucket = hm_hash_text(name) % RL_HM_SIZE
    var idx = rl_buckets[bucket]
    while idx != -1:
        if rl_keys[idx] == name:
            return rl_vals[idx]
        idx = rl_nexts[idx]
    -1

fn rl_is_shadowed(slot: i64) -> bool:
    if slot < 0: return true
    if slot >= rl_shadowed.len(): return true
    rl_shadowed[slot]

# ===== Per-Function Slot Cache =====
# Indexed by decl_id for O(1) lookup at call time
var fn_slot_keys: [[text]] = []
var fn_slot_vals: [[i64]] = []
var fn_slot_buckets: [[i64]] = []
var fn_slot_nexts: [[i64]] = []
var fn_slot_counts: [i64] = []
var fn_slot_shadowed: [[bool]] = []

fn fn_slot_ensure(decl_id: i64):
    while fn_slot_keys.len() <= decl_id:
        fn_slot_keys.push([])
        fn_slot_vals.push([])
        fn_slot_buckets.push([])
        fn_slot_nexts.push([])
        fn_slot_counts.push(0)
        fn_slot_shadowed.push([])

fn fn_slot_cache_current(decl_id: i64):
    fn_slot_ensure(decl_id)
    fn_slot_keys[decl_id] = rl_keys
    fn_slot_vals[decl_id] = rl_vals
    fn_slot_buckets[decl_id] = rl_buckets
    fn_slot_nexts[decl_id] = rl_nexts
    fn_slot_counts[decl_id] = rl_count
    fn_slot_shadowed[decl_id] = rl_shadowed

# ===== Public API =====

fn resolve_cached_local_count(decl_id: i64) -> i64:
    if decl_id < 0: return 0
    if decl_id >= fn_slot_counts.len(): return 0
    fn_slot_counts[decl_id]

fn resolve_is_fast_local(decl_id: i64, name: text) -> i64:
    if decl_id < 0: return -1
    if decl_id >= fn_slot_keys.len(): return -1
    val keys = fn_slot_keys[decl_id]
    val vals = fn_slot_vals[decl_id]
    val buckets = fn_slot_buckets[decl_id]
    val nexts = fn_slot_nexts[decl_id]
    val shadowed = fn_slot_shadowed[decl_id]
    if buckets.len() == 0: return -1
    val bucket = hm_hash_text(name) % RL_HM_SIZE
    var idx = buckets[bucket]
    while idx != -1:
        if keys[idx] == name:
            if shadowed[idx]: return -1
            return vals[idx]
        idx = nexts[idx]
    -1

fn resolve_is_slot_shadowed(decl_id: i64, slot: i64) -> bool:
    if decl_id < 0: return true
    if decl_id >= fn_slot_shadowed.len(): return true
    val shadowed = fn_slot_shadowed[decl_id]
    if slot >= shadowed.len(): return true
    shadowed[slot]

# ===== Resolution Pass =====

fn resolve_prescan_stmts(stmts: [i64]):
    for sid in stmts:
        val s_node: CoreStmt = stmt_get(sid)
        val tag = s_node.tag
        if tag == STMT_VAL_DECL or tag == STMT_VAR_DECL:
            val name = s_node.name
            if name != "":
                rl_register(name)
        elif tag == STMT_FOR:
            val iter_name = s_node.name
            if iter_name != "":
                if iter_name.starts_with("("):
                    # Tuple destructuring pattern: register individual names
                    val inner = iter_name[1:iter_name.len() - 1]
                    val names = inner.split(",")
                    for tname in names:
                        rl_register(tname)
                else:
                    rl_register(iter_name)
            # Prescan for body
            resolve_prescan_stmts(s_node.body)
        elif tag == STMT_IF:
            resolve_prescan_stmts(s_node.body)
            resolve_prescan_stmts(s_node.else_body)
        elif tag == STMT_WHILE:
            resolve_prescan_stmts(s_node.body)
        elif tag == STMT_BLOCK:
            resolve_prescan_stmts(s_node.body)

fn resolve_expr(eid: i64):
    if eid < 0: return
    val e0: CoreExpr = expr_get(eid)
    val tag = e0.tag
    if tag == EXPR_IDENT:
        val name = e0.s_val
        val slot = rl_lookup(name)
        if slot >= 0:
            val shadowed = rl_is_shadowed(slot)
            if shadowed == false:
                expr_i_val[eid] = slot
        return
    # Recurse into sub-expressions
    val e: CoreExpr = e0
    if e.left >= 0: resolve_expr(e.left)
    if e.right >= 0: resolve_expr(e.right)
    for arg_eid in e.args:
        resolve_expr(arg_eid)
    for stmt_eid in e.stmts:
        resolve_expr(stmt_eid)

fn resolve_stmt(sid: i64):
    if sid < 0: return
    val s_node: CoreStmt = stmt_get(sid)
    val tag = s_node.tag
    # Resolve expressions in statement
    if s_node.expr_idx >= 0:
        resolve_expr(s_node.expr_idx)
    # Recurse into body
    for child_sid in s_node.body:
        resolve_stmt(child_sid)
    for child_sid in s_node.else_body:
        resolve_stmt(child_sid)

fn resolve_function(decl_id: i64):
    val d_node: CoreDecl = decl_get(decl_id)
    rl_reset()
    # Register parameters first (slots 0..N-1)
    for pname in d_node.param_names:
        rl_register(pname)
    # Prescan body for all local names (detects shadowing)
    resolve_prescan_stmts(d_node.body_stmts)
    # Demote captured-and-mutated names off the fast path (escape analysis).
    var ki: i64 = 0
    while ki < rl_keys.len():
        if esc_contains(rl_keys[ki]):
            rl_shadowed[ki] = true
        ki = ki + 1
    # Walk expressions to set slot indices
    for sid in d_node.body_stmts:
        resolve_stmt(sid)
    # Cache for use at call time
    fn_slot_cache_current(decl_id)

# ===== Escape Analysis (captured-variable demotion) =====
# A local variable that is assigned inside a NESTED function or lambda cannot be
# a LOAD_FAST slot: the nested call updates the shared scope hash map, but the
# enclosing frame's fast-local cache is never refreshed, so the enclosing scope
# keeps reading the stale slot. Any such name is demoted to the slow (scope hash
# map) path so cross-call mutations are observed. Demotion is always correct —
# it only forgoes an optimization — so over-approximation is safe.
#
# A name "escapes" when it is assigned:
#   - inside any lambda body (EXPR_LAMBDA), or
#   - inside a function where it is not one of that function's own locals/params
#     (i.e. a captured outer variable, including hoisted nested named fns).

var esc_names: [text] = []
var esc_buckets: [i64] = []
var esc_nexts: [i64] = []
var esc_in_lambda: bool = false

# Current-function local set (params + declared locals), rebuilt per function.
var cl_names: [text] = []
var cl_buckets: [i64] = []
var cl_nexts: [i64] = []

fn esc_reset_all():
    esc_names = []
    esc_buckets = rl_make_buckets()
    esc_nexts = []
    esc_in_lambda = false

fn esc_add(name: text):
    if name == "": return
    val bucket = hm_hash_text(name) % RL_HM_SIZE
    var idx = esc_buckets[bucket]
    while idx != -1:
        if esc_names[idx] == name: return
        idx = esc_nexts[idx]
    val new_idx = esc_names.len()
    esc_names.push(name)
    esc_nexts.push(esc_buckets[bucket])
    esc_buckets[bucket] = new_idx

fn esc_contains(name: text) -> bool:
    if esc_names.len() == 0: return false
    val bucket = hm_hash_text(name) % RL_HM_SIZE
    var idx = esc_buckets[bucket]
    while idx != -1:
        if esc_names[idx] == name: return true
        idx = esc_nexts[idx]
    false

fn cl_reset():
    cl_names = []
    cl_buckets = rl_make_buckets()
    cl_nexts = []

fn cl_add(name: text):
    if name == "": return
    val bucket = hm_hash_text(name) % RL_HM_SIZE
    var idx = cl_buckets[bucket]
    while idx != -1:
        if cl_names[idx] == name: return
        idx = cl_nexts[idx]
    val new_idx = cl_names.len()
    cl_names.push(name)
    cl_nexts.push(cl_buckets[bucket])
    cl_buckets[bucket] = new_idx

fn cl_contains(name: text) -> bool:
    if cl_names.len() == 0: return false
    val bucket = hm_hash_text(name) % RL_HM_SIZE
    var idx = cl_buckets[bucket]
    while idx != -1:
        if cl_names[idx] == name: return true
        idx = cl_nexts[idx]
    false

fn esc_collect_locals(stmts: [i64]):
    for sid in stmts:
        val s_node: CoreStmt = stmt_get(sid)
        val tag = s_node.tag
        if tag == STMT_VAL_DECL or tag == STMT_VAR_DECL:
            if s_node.name != "": cl_add(s_node.name)
        elif tag == STMT_FOR:
            val iter_name = s_node.name
            if iter_name != "":
                if iter_name.starts_with("("):
                    val inner = iter_name[1:iter_name.len() - 1]
                    for tname in inner.split(","):
                        cl_add(tname)
                else:
                    cl_add(iter_name)
            esc_collect_locals(s_node.body)
        elif tag == STMT_IF:
            esc_collect_locals(s_node.body)
            esc_collect_locals(s_node.else_body)
        elif tag == STMT_WHILE:
            esc_collect_locals(s_node.body)
        elif tag == STMT_BLOCK:
            esc_collect_locals(s_node.body)

fn esc_note_assign_target(target_eid: i64):
    if target_eid < 0: return
    val target_e: CoreExpr = expr_get(target_eid)
    if target_e.tag != EXPR_IDENT: return
    val nm = target_e.s_val
    if esc_in_lambda:
        esc_add(nm)
    elif cl_contains(nm) == false:
        esc_add(nm)

fn esc_walk_expr(eid: i64):
    if eid < 0: return
    val e: CoreExpr = expr_get(eid)
    val tag = e.tag
    if tag == EXPR_ASSIGN or tag == EXPR_COMPOUND_ASSIGN:
        esc_note_assign_target(e.left)
    if tag == EXPR_LAMBDA:
        val prev = esc_in_lambda
        esc_in_lambda = true
        for beid in e.stmts:
            esc_walk_expr(beid)
        esc_in_lambda = prev
        return
    if e.left >= 0: esc_walk_expr(e.left)
    if e.right >= 0: esc_walk_expr(e.right)
    for arg_eid in e.args:
        esc_walk_expr(arg_eid)
    for seid in e.stmts:
        esc_walk_expr(seid)

fn esc_walk_stmt(sid: i64):
    if sid < 0: return
    val s_node: CoreStmt = stmt_get(sid)
    val tag = s_node.tag
    if tag == STMT_ASSIGN or tag == STMT_COMPOUND_ASSIGN:
        esc_note_assign_target(s_node.expr_idx)
        for veid in s_node.body:
            esc_walk_expr(veid)
        return
    if tag == STMT_VAL_DECL or tag == STMT_VAR_DECL or tag == EVAL_STMT_LAZY_VAL_DECL:
        for veid in s_node.body:
            esc_walk_expr(veid)
        return
    if tag == STMT_EXPR or tag == STMT_RETURN:
        esc_walk_expr(s_node.expr_idx)
        return
    # Control flow / other: expr_idx is a condition/scrutinee, body holds stmts.
    if s_node.expr_idx >= 0:
        esc_walk_expr(s_node.expr_idx)
    for cs in s_node.body:
        esc_walk_stmt(cs)
    for cs in s_node.else_body:
        esc_walk_stmt(cs)

fn esc_analyze_function(decl_id: i64):
    val d_node: CoreDecl = decl_get(decl_id)
    cl_reset()
    for pname in d_node.param_names:
        cl_add(pname)
    esc_collect_locals(d_node.body_stmts)
    esc_in_lambda = false
    for sid in d_node.body_stmts:
        esc_walk_stmt(sid)

fn esc_analyze_module():
    esc_reset_all()
    var did: i64 = 0
    val total = decl_count()
    while did < total:
        val d_scan: CoreDecl = decl_get(did)
        if d_scan.tag == DECL_FN:
            esc_analyze_function(did)
        did = did + 1

fn resolve_module_locals():
    # Pass 0: collect names captured-and-mutated across function/lambda
    # boundaries so they can be kept off the LOAD_FAST fast path.
    esc_analyze_module()
    # Walk all declarations, resolve functions
    var did: i64 = 0
    val total = decl_count()
    while did < total:
        val d: CoreDecl = decl_get(did)
        if d.tag == DECL_FN:
            resolve_function(did)
        did = did + 1

# ===== Captured-write check (owner ruling 2026-09-27) =====
# Pure-Simple twin of src/compiler_rust/parser/src/capture_write_check.rs: a
# nested fn or lambda must not assign to a local of an enclosing function or
# lambda. Closures capture enclosing locals by value and are read-only
# (.claude/rules/language.md:22); before this check the write was silently
# lost here too (a nested `bump()` left the caller's counter at 0). Names not
# bound in any enclosing frame are module globals (writable) or implicit
# declarations. The walk covers statements and the expression forms that
# carry nested bodies; it can miss a write but never invents one.

var cw_names: [text] = []
var cw_name_frame: [i64] = []
var cw_frame_boundary: [bool] = []
var cw_frame_fn: [text] = []
var cw_pending_fn: text = ""
var cw_error: text = ""

fn cw_message(name: text, in_fn: text, line: i64) -> text:
    val site = if in_fn == "<closure>": "a closure" else: "nested fn `" + in_fn + "`"
    val at = if line > 0: " (line " + line.to_text() + ")" else: ""
    "cannot assign to captured variable `" + name + "` inside " + site + at + ": closures capture enclosing locals by value and are read-only; return the new value or use a module-level `var`"

fn cw_push_frame(boundary: bool, fn_name: text):
    cw_frame_boundary.push(boundary)
    cw_frame_fn.push(fn_name)

fn cw_pop_frame():
    val top = cw_frame_boundary.len() - 1
    var kept_names: [text] = []
    var kept_frames: [i64] = []
    var i = 0
    while i < cw_names.len():
        if cw_name_frame[i] < top:
            kept_names.push(cw_names[i])
            kept_frames.push(cw_name_frame[i])
        i = i + 1
    cw_names = kept_names
    cw_name_frame = kept_frames
    var kept_b: [bool] = []
    var kept_f: [text] = []
    var j = 0
    while j < top:
        kept_b.push(cw_frame_boundary[j])
        kept_f.push(cw_frame_fn[j])
        j = j + 1
    cw_frame_boundary = kept_b
    cw_frame_fn = kept_f

fn cw_declare(name: text):
    if name == "": return
    cw_names.push(name)
    cw_name_frame.push(cw_frame_boundary.len() - 1)

# 0 = unbound, 1 = local to the current fn/lambda, 2 = captured enclosing local
fn cw_lookup(name: text) -> i64:
    val top = cw_frame_boundary.len() - 1
    var i = cw_names.len() - 1
    while i >= 0:
        if cw_names[i] == name:
            var g = cw_name_frame[i] + 1
            while g <= top:
                if cw_frame_boundary[g]: return 2
                g = g + 1
            return 1
        i = i - 1
    0

fn cw_current_fn() -> text:
    var k = cw_frame_boundary.len() - 1
    while k >= 0:
        if cw_frame_boundary[k]: return cw_frame_fn[k]
        k = k - 1
    "<closure>"

fn cw_note_assign(target_eid: i64, span_id: i64):
    if target_eid < 0 or cw_error != "": return
    val t: CoreExpr = expr_get(target_eid)
    if t.tag != EXPR_IDENT: return
    val kind = cw_lookup(t.s_val)
    if kind == 2:
        val sid = if span_id > 0: span_id else: t.span_id
        val line = if sid > 0: span_line(sid) else: 0
        cw_error = cw_message(t.s_val, cw_current_fn(), line)
    elif kind == 0:
        cw_declare(t.s_val)

fn cw_declare_iter(iter_name: text):
    if iter_name == "": return
    if iter_name.starts_with("("):
        val inner = iter_name[1:iter_name.len() - 1]
        for tname in inner.split(","):
            cw_declare(tname.trim())
    else:
        cw_declare(iter_name)

fn cw_walk_stmts(stmts: [i64]):
    for sid in stmts:
        cw_walk_stmt(sid)

fn cw_walk_stmt(sid: i64):
    if sid < 0 or cw_error != "": return
    val s: CoreStmt = stmt_get(sid)
    val tag = s.tag
    if tag == STMT_VAL_DECL or tag == STMT_VAR_DECL or tag == EVAL_STMT_LAZY_VAL_DECL:
        cw_pending_fn = s.name
        cw_walk_expr(s.expr_idx)
        cw_pending_fn = ""
        cw_declare(s.name)
        return
    if tag == STMT_ASSIGN or tag == STMT_COMPOUND_ASSIGN:
        for veid in s.body:
            cw_walk_expr(veid)
        cw_note_assign(s.expr_idx, s.span_id)
        return
    if tag == STMT_EXPR or tag == STMT_RETURN:
        cw_walk_expr(s.expr_idx)
        return
    if tag == STMT_FOR:
        cw_walk_expr(s.expr_idx)
        cw_declare_iter(s.name)
        cw_walk_stmts(s.body)
        return
    if tag == STMT_IF or tag == STMT_WHILE or tag == STMT_BLOCK:
        cw_walk_expr(s.expr_idx)
        cw_walk_stmts(s.body)
        cw_walk_stmts(s.else_body)

fn cw_walk_expr(eid: i64):
    if eid < 0 or cw_error != "": return
    val e: CoreExpr = expr_get(eid)
    val tag = e.tag
    if tag == EXPR_ASSIGN or tag == EXPR_COMPOUND_ASSIGN:
        cw_walk_expr(e.right)
        cw_note_assign(e.left, e.span_id)
        return
    if tag == EXPR_LAMBDA and e.i_val == 1:
        # Colon-block (`describe`/`it`/hook): a scope, not a closure.
        cw_pending_fn = ""
        cw_push_frame(false, "")
        for beid in e.stmts:
            cw_walk_expr(beid)
        cw_pop_frame()
        return
    if tag == EXPR_LAMBDA:
        val fn_name = if cw_pending_fn != "": cw_pending_fn else: "<closure>"
        cw_pending_fn = ""
        cw_push_frame(true, fn_name)
        for pid in e.args:
            cw_declare(expr_get(pid).s_val)
        for beid in e.stmts:
            cw_walk_expr(beid)
        cw_pop_frame()
        return
    cw_pending_fn = ""
    if tag == EXPR_BLOCK or tag == EXPR_DO_BLOCK or tag == EXPR_UNSAFE_BLOCK:
        cw_walk_stmts(e.stmts)
        cw_walk_expr(e.left)
        return
    if tag == EXPR_FOR:
        cw_walk_expr(e.left)
        cw_declare_iter(e.s_val)
        cw_walk_stmts(e.stmts)
        return
    if tag == EXPR_WHILE:
        cw_walk_expr(e.left)
        cw_walk_stmts(e.stmts)
        return
    if tag == EXPR_IF:
        cw_walk_expr(e.left)
        cw_walk_expr(e.right)
        cw_walk_expr(e.extra)
        return
    if tag == EXPR_CALL or tag == EXPR_METHOD_CALL or tag == EXPR_ARRAY_LIT or tag == EXPR_TUPLE:
        cw_walk_expr(e.left)
        for aid in e.args:
            cw_walk_expr(aid)
        return
    if tag == EXPR_BINARY or tag == EXPR_UNARY or tag == EXPR_INDEX or tag == EXPR_FIELD_ACCESS or tag == EXPR_NULL_COALESCE:
        cw_walk_expr(e.left)
        cw_walk_expr(e.right)

# Returns "" when the module is clean, else the first diagnostic.
fn capture_write_check_module() -> text:
    cw_error = ""
    var did: i64 = 0
    val total = decl_count()
    while did < total and cw_error == "":
        val d: CoreDecl = decl_get(did)
        if d.tag == DECL_FN and not d.name.starts_with("__lambda_"):
            cw_names = []
            cw_name_frame = []
            cw_frame_boundary = []
            cw_frame_fn = []
            cw_pending_fn = ""
            cw_push_frame(false, d.name)
            for pname in d.param_names:
                cw_declare(pname)
            cw_walk_stmts(d.body_stmts)
        did = did + 1
    cw_error

