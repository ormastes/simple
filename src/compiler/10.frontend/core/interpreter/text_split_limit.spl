# Limited text splitting shared by both pure-Simple interpreter dispatchers.

fn text_split_with_limit(value: text, delimiter: text, limit: i64) -> [text]:
    if limit <= 0:
        return []

    val parts = value.split(delimiter)
    if parts.len() <= limit:
        return parts

    var result: [text] = []
    var i = 0
    while i < limit - 1:
        result.push(parts[i])
        i = i + 1

    var remainder: [text] = []
    while i < parts.len():
        remainder.push(parts[i])
        i = i + 1
    result.push(remainder.join(delimiter))
    result
