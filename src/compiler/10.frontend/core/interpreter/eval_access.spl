# ===== Dict Literal =====
# Dict literals are represented as structs with type name "__dict".
# Keys are evaluated as text field names, values are evaluated normally.
# Empty {} creates an empty __dict struct that supports dynamic field add/get.

fn eval_dict_lit(eid: i64) -> i64:
    val e_node = expr_get(eid)
    val key_eids = e_node.args
    val value_eids = e_node.stmts

    var field_names: [text] = []
    var field_values: [i64] = []

    var i: i64 = 0
    for k_eid in key_eids:
        val key_val = eval_expr(k_eid)
        if eval_had_error: return -1
        # Convert key to text for struct field name
        val key_text = val_to_text(key_val)
        field_names.push(key_text)

        val v_val = eval_expr(value_eids[i])
        if eval_had_error: return -1
        field_values.push(v_val)
        i = i + 1

    val_make_struct("__dict", field_names, field_values)

# ===== Assignment Expression =====

fn eval_assign_expr(eid: i64) -> i64:
    val e_node = expr_get(eid)
    val target_eid = e_node.left
    val value_eid = e_node.right

    val new_val = eval_expr(value_eid)
    if eval_had_error: return -1

    val target_node = expr_get(target_eid)
    val target_tag = target_node.tag
    if target_tag == EXPR_IDENT:
        val name = target_node.s_val
        val ok = env_assign(name, new_val)
        if ok == false:
            eval_set_error("undefined variable: " + name)
            return -1
        return new_val

    if target_tag == EXPR_FIELD_ACCESS:
        val base_eid2 = target_node.left
        val field_name = target_node.s_val
        val base_val = eval_expr(base_eid2)
        if eval_had_error: return -1
        if val_is_struct(base_val):
            # S1 copy-site 4 (struct field store). Kept identical to the copy of
            # this same function in _EvalOps/access_literal_assign_eval.spl,
            # which is the one eval_ops.spl re-exports; both are patched so the
            # two duplicates cannot drift on the identity contract.
            val store_val = val_copy_if_value_struct(new_val)
            # Fast path: cached field index
            val cached_idx = expr_i_val[target_eid]
            if cached_idx >= 0:
                val ok = val_struct_check_field_idx(base_val, cached_idx, field_name)
                if ok:
                    val_struct_set_field_idx(base_val, cached_idx, store_val)
                    return store_val
            # Slow path: find + set + cache
            val fi = val_struct_find_field_idx(base_val, field_name)
            if fi >= 0:
                val_struct_set_field_idx(base_val, fi, store_val)
                expr_i_val[target_eid] = fi
                return store_val
            eval_set_error("no field '" + field_name + "' on struct " + val_get_struct_name(base_val))
            return -1
        eval_set_error("cannot set field on " + val_kind_name(val_get_kind(base_val)))
        return -1

    # Index assignment: base[key] = value (dict/array)
    if target_tag == EXPR_INDEX:
        val idx_base_eid = target_node.left
        val idx_key_eid = target_node.right
        val base_val = eval_expr(idx_base_eid)
        if eval_had_error: return -1
        val key_val = eval_expr(idx_key_eid)
        if eval_had_error: return -1

        if val_is_struct(base_val):
            val key_text = val_to_text(key_val)
            # Try to update existing field
            val fi = val_struct_find_field_idx(base_val, key_text)
            if fi >= 0:
                val_struct_set_field_idx(base_val, fi, new_val)
                return new_val
            # Add new field to dict struct
            var fields = val_get_struct_fields(base_val)
            var values = val_get_struct_values(base_val)
            fields.push(key_text)
            values.push(new_val)
            val_struct_fields[base_val] = fields
            val_struct_values[base_val] = values
            return new_val

        if val_is_array(base_val):
            if val_is_int(key_val):
                val idx = val_get_int(key_val)
                var elements = val_get_array(base_val)
                if idx >= 0:
                    if idx < elements.len():
                        elements[idx] = new_val
                        val_arrays[base_val] = elements
                        return new_val
                eval_set_error("array index out of bounds: " + "{idx}")
                return -1

        eval_set_error("cannot index-assign " + val_kind_name(val_get_kind(base_val)))
        return -1

    eval_set_error("invalid assignment target")
    -1

# ===== Return Expression =====

# ===== Interpolated String =====

# Kept behaviourally identical to the copy in _EvalOps/access_literal_assign_eval.spl.
# This copy had DRIFTED: it joined only the evaluated parts and discarded every
# literal segment, so `"heap_registry={n} phase={p}"` rendered as the bare digits
# `"8073392"`. Only scripts/check/class_identity_pure_simple_driver.spl imports this
# module (`use compiler.frontend.core.interpreter.eval_access.*`), so the mainline
# interpreter was unaffected — but the two definitions are co-compiled with an
# identical `(i64) -> i64` signature, which resolves by "last definition wins".
# See doc/08_tracking/bug/selfhosted_stage4_interpreter_string_interpolation_broken_2026-07-30.md
fn eval_interpolation_segments(value: text) -> [text]:
    var segments: [text] = []
    var current = ""
    var depth = 0
    var i = 0
    while i < value.len():
        val ch = value[i:i + 1]
        val next = if i + 1 < value.len(): value[i + 1:i + 2] else: ""
        if depth == 0 and ch == "{" and next == "{":
            current = current + "{"
            i = i + 1
        elif depth == 0 and ch == "}" and next == "}":
            current = current + "}"
            i = i + 1
        elif depth == 0 and ch == "{":
            segments.push(current)
            current = ""
            depth = 1
        elif depth > 0 and ch == "{":
            depth = depth + 1
        elif depth > 0 and ch == "}":
            depth = depth - 1
        elif depth == 0:
            current = current + ch
        i = i + 1
    segments.push(current)
    segments

fn eval_interpolated_string(eid: i64) -> i64:
    val node = expr_get(eid)
    val parts = node.args
    val segments = eval_interpolation_segments(node.s_val)
    if segments.len() != parts.len() + 1:
        eval_set_error("invalid interpolated string")
        return -1
    var result = segments[0]
    var i = 0
    while i < parts.len():
        val part_eid = parts[i]
        val part_val = eval_expr(part_eid)
        if eval_had_error: return -1
        result = result + val_to_text(part_val) + segments[i + 1]
        i = i + 1
    val_make_text(result)

# ===== Null Coalesce =====

fn eval_null_coalesce(eid: i64) -> i64:
    val e_node = expr_get(eid)
    val left = eval_expr(e_node.left)
    if eval_had_error: return -1
    # Plain nil → use right side
    if val_is_nil(left):
        return eval_expr(e_node.right)
    # Enum/Option handling: struct with __tag field
    if val_is_struct(left):
        val tag_field = val_struct_get_field(left, "__tag")
        if tag_field != VAL_NONE:
            val tag_text = val_get_text(tag_field)
            if tag_text == "None" or tag_text == "nil":
                # None variant → use right side (fallback)
                return eval_expr(e_node.right)
            if tag_text == "Some" or tag_text == "Ok":
                # Some/Ok variant → unwrap payload
                val payload = val_struct_get_field(left, "__payload")
                if payload != VAL_NONE:
                    return payload
                return left
    # Non-nil, non-enum → return as-is
    left

# EXPR_TRY: the `?` operator. Unwraps Ok/Some payload; on Err/None/nil it
# early-returns the whole error value from the enclosing function via the
# eval_returning / eval_return_value control-flow signal (same mechanism as
# `return`). This is distinct from `.?` (EXPR_EXISTS_CHECK), which yields a
# present-or-nil value and never propagates.
fn eval_try(eid: i64) -> i64:
    val e_node = expr_get(eid)
    val left = eval_expr(e_node.left)
    if eval_had_error: return -1
    # Plain nil → propagate nil out of the enclosing function.
    if val_is_nil(left):
        eval_returning = true
        eval_return_value = left
        return left
    # Result/Option enum values are structs constructed as
    # [__tag, __payload] (see eval_enum_variant_call below): field index 0 is
    # "__tag", field index 1 is "__payload". Mirroring the (now-fixed)
    # `.unwrap()` path (eval_methods.spl) keeps `?` consistent with
    # unwrap/match rather than reading the tag by mistake.
    if val_is_struct(left):
        val sname = val_get_struct_name(left)
        if sname == "Result::Ok" or sname == "Option::Some":
            # Present → unwrap payload (value flows on).
            return val_struct_get_field_idx(left, 1)
        if sname == "Result::Err" or sname == "Option::None":
            # Absent → early-return the error/none value from the caller.
            eval_returning = true
            eval_return_value = left
            return left
    # Non-nil, non-enum → treat as present, pass through unchanged.
    left

# ===== Enum Variant Construction =====

# ===== Lambda Expression =====
# EXPR_LAMBDA: args = [EXPR_IDENT params], stmts = [body exprs]
# Desugared from \x: expr, _ placeholders, _N numbered, &:method

var lambda_counter: i64 = 0

fn eval_lambda(eid: i64) -> i64:
    val e_node = expr_get(eid)
    val param_idents = e_node.args
    val body_exprs = e_node.stmts

    # Extract param names from EXPR_IDENT nodes
    var param_names: [text] = []
    var param_types: [i64] = []
    for pid in param_idents:
        param_names.push(expr_get(pid).s_val)
        param_types.push(0)

    # Wrap body expressions as stmt_expr_stmt nodes
    var body_stmts: [i64] = []
    for beid in body_exprs:
        body_stmts.push(stmt_expr_stmt(beid, 0))

    # Create anonymous function declaration
    lambda_counter = lambda_counter + 1
    val fn_name = "__lambda_{lambda_counter}"
    var type_params: [text] = []
    val decl_id = decl_fn(fn_name, param_names, param_types, 0, body_stmts, 0, type_params, 0)

    # Register in function table
    func_table_register(fn_name, decl_id)

    # Return function value
    val_make_function(fn_name, decl_id)

# ===== List Comprehension =====
# EXPR_LIST_COMP: s_val=iter_var, left=iterable, right=body, extra=cond (-1 if none)

# ===== Dict Comprehension =====
# EXPR_DICT_COMP: s_val=iter_var, left=iterable, args=[key_body, val_body], extra=cond
