#![allow(unnamed_duplicate_typed_args)]
# Core Interpreter — Call Expression Evaluators
#
# Split from eval_ops.spl. Contains:
# - Float parsing utilities (parse_float_text, char_digit)
# - Call evaluation (eval_call, eval_function_call, eval_struct_constructor)
#
# All evaluation returns a value_id (i64). Errors indicated by -1 (VAL_NONE).

# Explicit owners for names the seed resolved through its flat namespace;
# the pure-Simple HIR resolves per module and reported them as unresolved.
use compiler.core.ast.{decl_get, decl_get_param_muts, expr_get, stmts_contain_yield}
use compiler.core.ast_expr.{EXPR_FIELD_ACCESS, EXPR_IDENT, expr_get_arg_names, expr_owner_int}
use compiler.core.ast_stmt.{STMT_ASSIGN}
use compiler.core.interpreter.env.{env_assign, env_define, env_has_frame, env_lookup, env_pop_frame, env_pop_scope, env_push_frame}
use compiler.core.interpreter.env.{env_push_scope, env_set_local}
use compiler.core.interpreter.eval.{eval_caller_file, eval_current_decl_id, eval_expr, eval_had_error, eval_return_value}
use compiler.core.interpreter.eval.{eval_returning, eval_set_error, eval_yield_stack}
use compiler.core.interpreter.eval.{type_check_value}
use compiler.core.interpreter.eval_builtins.{eval_builtin_call}
use compiler.core.interpreter.eval_ops.{eval_enum_variant_call, eval_struct_constructor}
use compiler.core.interpreter.eval_stmts.{eval_stmt}
use compiler.core.interpreter.eval_tables.{enum_table_lookup_in, func_flat_lookup_for_caller, func_module_namespace_lookup, func_resolve_for_caller, func_resolve_module_member_for_caller}
use compiler.core.interpreter.eval_tables.{func_table_lookup, struct_table_lookup}
use compiler.core.interpreter.jit.{jit_is_compiled, jit_record_call, jit_try_execute}
use compiler.core.interpreter.module_loader_core.{try_force_any_deferred_for}
use compiler.core.interpreter.resolve.{resolve_cached_local_count, resolve_is_fast_local, resolve_is_slot_shadowed}
use compiler.core.interpreter.value.{val_get_func_decl, val_get_int, val_get_struct_fields, val_get_struct_name, val_get_struct_values}
use compiler.core.interpreter.value.{val_is_function, val_is_int, val_is_struct, val_make_array, val_make_int}
use compiler.core.interpreter.value.{val_make_nil, val_make_struct}
use compiler.core.interpreter.value.{val_is_array, val_get_array, val_array_copy, val_array_push, val_struct_set_field_idx}
use compiler.core.interpreter.value_places.{InterpreterValuePlace, eval_prepare_value_place}
use compiler.core.types.{TYPE_VOID, TYPE_BOOL, TYPE_I64, TYPE_F64, TYPE_TEXT, TYPE_ANY}

var _yield_cache: {} = {}

# ===== Float Parsing Utilities =====

# ===== Call Expression =====

fn eval_call(eid: i64) -> i64:
    val e_node = expr_get(eid)
    val callee_eid = e_node.left
    val arg_eids = e_node.args
    val arg_names = expr_get_arg_names(eid)

    # Evaluate callee
    val callee_node = expr_get(callee_eid)
    val callee_tag = callee_node.tag

    # Direct function call by name
    if callee_tag == EXPR_IDENT:
        val name = callee_node.s_val

        # Check for struct constructor (only uppercase names)
        val first_ch = name[0]
        if first_ch >= "A" and first_ch <= "Z":
            val struct_decl = struct_table_lookup(name)
            if struct_decl >= 0:
                return eval_struct_constructor(name, struct_decl, arg_eids, arg_names)

        # Check for builtin
        val builtin_result = eval_builtin_call(name, arg_eids)
        if builtin_result >= -1:
            return builtin_result

        # Check function table
        var decl_id = func_resolve_for_caller(eval_caller_file(), name)
        if decl_id < 0:
            decl_id = func_flat_lookup_for_caller(eval_caller_file(), name)
        if decl_id >= 0:
            return eval_function_call(decl_id, arg_eids, arg_names)

        # Check environment for function value
        val fn_vid = env_lookup(name)
        if fn_vid >= 0:
            if val_is_function(fn_vid):
                val fn_decl = val_get_func_decl(fn_vid)
                return eval_function_call(fn_decl, arg_eids, arg_names)

        # Try deferred (lazy) modules before giving up
        val forced_ok = try_force_any_deferred_for(name, eval_caller_file())
        if forced_ok == 1:
            var decl_id2 = func_resolve_for_caller(eval_caller_file(), name)
            if decl_id2 < 0:
                decl_id2 = func_flat_lookup_for_caller(eval_caller_file(), name)
            if decl_id2 >= 0:
                return eval_function_call(decl_id2, arg_eids, arg_names)
            # Maybe it's a struct constructor after forcing
            val first_ch2 = name[0]
            if first_ch2 >= "A" and first_ch2 <= "Z":
                val struct_decl2 = struct_table_lookup(name)
                if struct_decl2 >= 0:
                    return eval_struct_constructor(name, struct_decl2, arg_eids, arg_names)

        eval_set_error("undefined function: " + name)
        return -1

    # Path call: Type.method(args) or Enum.Variant(args)
    if callee_tag == EXPR_FIELD_ACCESS:
        val base_eid = callee_node.left
        val member_name = callee_node.s_val
        val base_node = expr_get(base_eid)
        val base_tag = base_node.tag
        if base_tag == EXPR_IDENT:
            val type_name = base_node.s_val
            val namespace_owner = func_module_namespace_lookup(
                eval_caller_file(), type_name)
            if namespace_owner != "":
                val member_decl = func_resolve_module_member_for_caller(
                    eval_caller_file(), type_name, member_name)
                if member_decl >= 0:
                    return eval_function_call(member_decl, arg_eids, arg_names)
                # A namespace member may be a struct constructor or a type.
                # Let the existing non-function paths below inspect it.
            # Check enum variant constructor: Enum.Variant(payload)
            val enum_variants = enum_table_lookup_in(eval_caller_file(), type_name)
            if enum_variants != "":
                # Only treat as variant if member_name is a known variant
                val variant_list = enum_variants.split(",")
                var is_variant = false
                for vn in variant_list:
                    if vn == member_name:
                        is_variant = true
                        break
                if is_variant:
                    return eval_enum_variant_call(type_name, member_name, arg_eids)
            # Check static method: Type.method() → Type__method in func table
            val static_fn_name = type_name + "__" + member_name
            val static_decl = func_table_lookup(static_fn_name)
            if static_decl >= 0:
                return eval_function_call(static_decl, arg_eids, arg_names)
            # Check struct constructor with module prefix: Module.Struct(args)
            val struct_decl2 = struct_table_lookup(member_name)
            if struct_decl2 >= 0:
                return eval_struct_constructor(member_name, struct_decl2, arg_eids, arg_names)

            # Try deferred (lazy) modules for Type.method or Enum.Variant
            val forced_path = try_force_any_deferred_for(type_name, eval_caller_file())
            if forced_path == 1:
                val lazy_namespace_owner = func_module_namespace_lookup(
                    eval_caller_file(), type_name)
                if lazy_namespace_owner != "":
                    val lazy_member_decl = func_resolve_module_member_for_caller(
                        eval_caller_file(), type_name, member_name)
                    if lazy_member_decl >= 0:
                        return eval_function_call(lazy_member_decl, arg_eids, arg_names)
                    # Continue through the non-function member paths.
                # Retry enum variant
                val enum_variants2 = enum_table_lookup_in(eval_caller_file(), type_name)
                if enum_variants2 != "":
                    val variant_list2 = enum_variants2.split(",")
                    var is_variant2 = false
                    for vn2 in variant_list2:
                        if vn2 == member_name:
                            is_variant2 = true
                            break
                    if is_variant2:
                        return eval_enum_variant_call(type_name, member_name, arg_eids)
                # Retry static method
                val static_fn2 = type_name + "__" + member_name
                val static_decl2 = func_table_lookup(static_fn2)
                if static_decl2 >= 0:
                    return eval_function_call(static_decl2, arg_eids, arg_names)
                # Retry struct constructor
                val struct_decl3 = struct_table_lookup(member_name)
                if struct_decl3 >= 0:
                    return eval_struct_constructor(member_name, struct_decl3, arg_eids, arg_names)

    # Indirect call (call on expression result)
    val callee_val = eval_expr(callee_eid)
    if eval_had_error: return -1
    if val_is_function(callee_val):
        val fn_decl = val_get_func_decl(callee_val)
        return eval_function_call(fn_decl, arg_eids, arg_names)

    eval_set_error("value is not callable")
    -1

fn eval_function_call(decl_id: i64, arg_eids: [i64], arg_names: [text]) -> i64:
    val d_node = decl_get(decl_id)
    val fn_name = d_node.name
    val param_names = d_node.param_names
    val param_types = d_node.param_types
    val body_stmts = d_node.body_stmts

    # Record call for JIT threshold tracking
    jit_record_call(fn_name)

    # Evaluate arguments
    val argument_context = eval_prepare_call_arguments(decl_id, arg_eids, arg_names, 0)
    if eval_had_error: return -1
    var arg_values: [i64] = argument_context.values

    var has_named_args = false
    for arg_name in arg_names:
        if arg_name != "":
            has_named_args = true
            break
    if has_named_args:
        if arg_values.len() > param_names.len():
            eval_set_error("too many arguments for function '" + fn_name + "'")
            return -1
        var ordered_values: [i64] = []
        for pname in param_names:
            ordered_values.push(-1)
        var next_pos: i64 = 0
        var ai: i64 = 0
        while ai < arg_values.len():
            val arg_name = if ai < arg_names.len(): arg_names[ai] else: ""
            var target: i64 = -1
            if arg_name != "":
                var pi: i64 = 0
                while pi < param_names.len():
                    if param_names[pi] == arg_name:
                        target = pi
                        break
                    pi = pi + 1
                if target < 0:
                    eval_set_error("unknown argument '" + arg_name + "' in function '" + fn_name + "'")
                    return -1
                if ordered_values[target] >= 0:
                    eval_set_error("duplicate argument '" + arg_name + "' in function '" + fn_name + "'")
                    return -1
            else:
                while next_pos < ordered_values.len() and ordered_values[next_pos] >= 0:
                    next_pos = next_pos + 1
                if next_pos >= ordered_values.len():
                    eval_set_error("too many arguments for function '" + fn_name + "'")
                    return -1
                target = next_pos
                next_pos = next_pos + 1
            ordered_values[target] = arg_values[ai]
            ai = ai + 1
        var pi: i64 = 0
        while pi < ordered_values.len():
            if ordered_values[pi] < 0:
                ordered_values[pi] = val_make_nil()
            pi = pi + 1
        arg_values = ordered_values

    # Type check arguments if parameter types are specified
    if param_types.len() > 0:
        var pi: i64 = 0
        for av in arg_values:
            if pi < param_types.len():
                val expected_type = param_types[pi]
                if expected_type != 0:  # 0 = TYPE_VOID means no type annotation
                    val type_matches = type_check_value(av, expected_type)
                    if not type_matches:
                        val param_name = param_names[pi]
                        eval_set_error("type error: argument '" + param_name + "' in function '" + fn_name + "' type mismatch")
                        return -1
            pi = pi + 1

    # Try JIT execution if function is compiled
    if jit_is_compiled(fn_name):
        # Convert value_ids to raw i64s for JIT calling convention
        var raw_args: [i64] = []
        for av in arg_values:
            if val_is_int(av):
                raw_args.push(val_get_int(av))
            else:
                raw_args.push(av)
        val jit_result = jit_try_execute(fn_name, raw_args)
        if jit_result != -1:
            return val_make_int(jit_result)

    # Fall back to tree-walking
    val local_count = resolve_cached_local_count(decl_id)
    val prev_decl_id = eval_current_decl_id
    eval_current_decl_id = decl_id
    if local_count > 0:
        env_push_frame(local_count)
    env_push_scope()
    var pi: i64 = 0
    for pname in param_names:
        var pval = val_make_nil()
        if pi < arg_values.len():
            pval = arg_values[pi]
            # Owned value snapshots or resolved mut places were prepared in
            # source evaluation order, before any later argument ran.
        env_define(pname, pval)
        # LOAD_FAST: set fast local for non-shadowed params
        if local_count > 0:
            val is_shadowed = resolve_is_slot_shadowed(decl_id, pi)
            if is_shadowed == false:
                env_set_local(pi, pval)
        pi = pi + 1

    # Generator detection: push yield accumulator if body contains yield
    val yield_key = "{decl_id}"
    var is_gen = false
    val cached_yield = _yield_cache[yield_key]
    if cached_yield.?:
        is_gen = cached_yield == "y"
    else:
        is_gen = stmts_contain_yield(body_stmts)
        _yield_cache[yield_key] = if is_gen: "y" else: "n"
    if is_gen:
        eval_yield_stack.push([])

    # Execute body
    var last_val = val_make_nil()
    for sid in body_stmts:
        if eval_had_error: break
        if eval_returning: break
        last_val = eval_stmt(sid)

    # Handle return
    var had_explicit_return = false
    if eval_returning:
        last_val = eval_return_value
        eval_returning = false
        eval_return_value = -1
        had_explicit_return = true

    # Generator: pop accumulator and return collected array
    if is_gen:
        val ys_ref = eval_yield_stack
        val ys_len = ys_ref.len()
        val yielded = ys_ref[ys_len - 1]
        eval_yield_stack = ys_ref[0:ys_len - 1]
        if had_explicit_return == false:
            last_val = val_make_array(yielded)

    # S1 copy-site 5 (struct return). Covers BOTH return forms: the explicit
    # `return e` handled above and a tail-expression body (`fn f() -> S: b.cell`),
    # which never goes through eval_stmt_return at all. Returning a value-type
    # struct hands the caller a SNAPSHOT, so writing through the caller's binding
    # cannot reach the place the callee read it from. Class returns fall through
    # the gate unchanged — that is what keeps case E (class returned) REF.
    last_val = val_copy_if_value_struct(last_val)

    # Whole replacements of declared-mut parameters reach the frozen caller
    # place; in-place mutations already changed its owned ValueId.
    argument_context.capture_mutations(param_names)

    env_pop_scope()
    if local_count > 0:
        env_pop_frame()
    eval_current_decl_id = prev_decl_id
    argument_context.apply_mutations()
    last_val

# ===== Struct (value type) vs Class (reference type) param-copy support (#108) =====
#
# The interpreter has one runtime value kind (VAL_STRUCT) for both `struct`
# and `class` instances. The discriminator lives on the DECLARATION: parsing
# tags class-origin struct decls via decl_set_is_value_type(id, 0) (see
# parse_struct_decl in _ParserDecls/fn_struct_decls.spl), defaulting to 1
# (value type) for plain `struct` decls. Lookup failures (builtin pseudo
# structs like Option/File/Class that never went through struct_table_register)
# default to "not a value type" so their existing shared-reference behavior is
# unchanged — only confirmed user `struct` decls get copied.
fn interp_struct_is_value_type(vid: i64) -> bool:
    val name = val_get_struct_name(vid)
    val decl_id = struct_table_lookup(name)
    if decl_id < 0:
        return false
    decl_get(decl_id).is_value_type

fn val_struct_deep_copy(vid: i64) -> i64:
    """Copy value-struct fields, forking array descriptors instead of their
    contents. Class fields retain their reference identities."""
    val context = InterpreterValueCopyContext(copies: {})
    context.copy_value(vid)

class InterpreterValueCopyContext:
    # Reference ownership keeps recursive calls on one memo table.
    copies: {i64: i64}

    me copy_value(vid: i64) -> i64:
        if vid < 0: return vid
        val is_array = val_is_array(vid)
        val is_value_struct = val_is_struct(vid) and interp_struct_is_value_type(vid)
        if not is_array and not is_value_struct: return vid
        if self.copies.contains_key(vid):
            return self.copies[vid] ?? -1
        if is_array:
            val copied = val_array_copy(vid)
            self.copies[vid] = copied
            return copied
        val fields = val_get_struct_fields(vid)
        val values = val_get_struct_values(vid)
        var placeholders: [i64] = []
        for value in values:
            placeholders.push(-1)
        val copied = val_make_struct(val_get_struct_name(vid), fields, placeholders)
        self.copies[vid] = copied
        var index = 0
        while index < values.len():
            val cloned = self.copy_value(values[index])
            val_struct_set_field_idx(copied, index, cloned)
            index = index + 1
        copied

fn val_copy_for_parameter(vid: i64) -> i64:
    """Fork array descriptors and copy value-struct fields at a value boundary.
    Array backing is shared until a write; classes and actors keep identity."""
    if vid < 0: return vid
    if not val_is_array(vid):
        if not val_is_struct(vid): return vid
        if not interp_struct_is_value_type(vid): return vid
    val context = InterpreterValueCopyContext(copies: {})
    context.copy_value(vid)

fn val_copy_if_value_struct(vid: i64) -> i64:
    """Compatibility name for the shared value-copy gate. Arrays fork an
    O(1) descriptor; confirmed value structs copy fields with array forks.
    Classes, actors and scalar arena values keep their identities."""
    if vid < 0: return vid
    if val_is_array(vid): return val_array_copy(vid)
    if val_is_struct(vid) and interp_struct_is_value_type(vid):
        return val_struct_deep_copy(vid)
    vid

fn val_make_array_snapshot(elements: [i64]) -> i64:
    var owned: [i64] = []
    for element in elements:
        owned.push(val_copy_if_value_struct(element))
    val_make_array(owned)

class InterpreterCallArguments:
    values: [i64]
    places: [InterpreterValuePlace]
    targets: [i64]
    mut_flags: [i64]
    inputs: [i64]
    writebacks: [i64]

    me capture_mutations(parameter_names: [text]):
        var index: i64 = 0
        while index < self.values.len():
            var replacement: i64 = -1
            val target = self.targets[index]
            if self.mut_flags[index] == 1 and target >= 0 and target < parameter_names.len():
                val current = env_lookup(parameter_names[target])
                # In-place changes already reached the owned place. Only a
                # whole-value replacement needs explicit caller writeback.
                if current != self.values[index]: replacement = current
            self.writebacks.push(replacement)
            index = index + 1

    fn apply_mutations():
        var index: i64 = 0
        while index < self.writebacks.len():
            if self.writebacks[index] >= 0:
                self.places[index].store(self.writebacks[index])
                if eval_had_error: return
            index = index + 1

fn eval_argument_targets(parameter_names: [text], argument_names: [text], count: i64, offset: i64) -> [i64]:
    var targets: [i64] = []
    var claimed: [i64] = []
    var next = offset
    var has_named = false
    for name in argument_names:
        if name != "": has_named = true
    var index: i64 = 0
    while index < count:
        var target: i64 = -1
        val name = if index < argument_names.len(): argument_names[index] else: ""
        if name != "":
            var parameter = offset
            while parameter < parameter_names.len():
                if parameter_names[parameter] == name:
                    target = parameter
                    break
                parameter = parameter + 1
        else:
            if has_named:
                while claimed.contains(next): next = next + 1
            target = next
            next = next + 1
        targets.push(target)
        if target >= 0: claimed.push(target)
        index = index + 1
    targets

fn eval_prepare_call_arguments(declaration: i64, argument_eids: [i64], argument_names: [text], offset: i64) -> InterpreterCallArguments:
    val parameter_names = decl_get(declaration).param_names
    val parameter_mutability = decl_get_param_muts(declaration)
    val targets = eval_argument_targets(parameter_names, argument_names, argument_eids.len(), offset)
    val prepared = InterpreterCallArguments(values: [], places: [], targets: targets,
        mut_flags: [], inputs: [], writebacks: [])
    var index: i64 = 0
    while index < argument_eids.len():
        val place = eval_prepare_value_place(argument_eids[index])
        if eval_had_error: return prepared
        val target = targets[index]
        val is_mut = target >= 0 and target < parameter_mutability.len() and parameter_mutability[target] == 1
        if is_mut and val_is_array(place.value) and place.root_name == "" and place.kinds.len() == 0:
            eval_set_error("mut array argument requires a writable place")
            return prepared
        prepared.places.push(place)
        prepared.inputs.push(place.value)
        prepared.mut_flags.push(if is_mut: 1 else: 0)
        # Snapshot each value argument before evaluating the next argument.
        prepared.values.push(if is_mut: place.value else: val_copy_for_parameter(place.value))
        index = index + 1
    index = 0
    while index < prepared.values.len():
        if prepared.mut_flags[index] == 1:
            var other: i64 = 0
            while other < prepared.values.len():
                if prepared.mut_flags[other] == 0 and val_is_array(prepared.inputs[index]) and val_is_array(prepared.inputs[other]):
                    if prepared.inputs[index] == prepared.inputs[other] or prepared.places[index].overlaps(prepared.places[other]):
                        eval_set_error("array argument aliases both mut and value parameters")
                        return prepared
                other = other + 1
            prepared.values[index] = prepared.places[index].mutable_value()
            if eval_had_error: return prepared
        index = index + 1
    prepared
