# Core Interpreter — Hash Map Environment
#
# Seed-compilable scope/variable management using hash maps.
# Each scope has a chained hash table for O(1) average variable lookup.
# Scopes form a stack (innermost last). Globals stored in separate hash map.
#
# Uses fixed-capacity scope array to avoid O(depth) rebuild on pop.

# ===== Scope Stack (Hash Maps) =====
# Each scope has: keys, vals, buckets, nexts (chained hash table)
var scope_hm_keys: [[text]] = []
var scope_hm_vals: [[i64]] = []
var scope_hm_buckets: [[i64]] = []
var scope_hm_nexts: [[i64]] = []
var env_depth: i64 = 0

# ===== Globals (Hash Map) =====
var gl_keys: [text] = []
var gl_vals: [i64] = []
var gl_buckets: [i64] = []
var gl_nexts: [i64] = []

# ===== Environment Init/Reset =====

fn env_init():
    scope_hm_keys = []
    scope_hm_vals = []
    scope_hm_buckets = []
    scope_hm_nexts = []
    env_depth = 0
    gl_keys = []
    gl_vals = []
    gl_buckets = hm_make_global_buckets()
    gl_nexts = []
    frame_locals = []
    frame_local_counts = []
    frame_depth = 0
    # Start with one scope (module-level)
    env_push_scope()

fn env_reset():
    env_init()

# ===== Scope Management =====

fn _reset_scope_buckets(buckets: [i64]):
    # Reset all bucket entries to -1 in-place instead of allocating a new array
    var i: i64 = 0
    while i < buckets.len():
        buckets[i] = -1
        i = i + 1

fn env_push_scope():
    if env_depth < scope_hm_keys.len():
        # Reuse existing slot — clear contents, reset buckets in-place
        scope_hm_keys[env_depth] = []
        scope_hm_vals[env_depth] = []
        _reset_scope_buckets(scope_hm_buckets[env_depth])
        scope_hm_nexts[env_depth] = []
    else:
        # Grow arrays
        scope_hm_keys.push([])
        scope_hm_vals.push([])
        scope_hm_buckets.push(hm_make_scope_buckets())
        scope_hm_nexts.push([])
    env_depth = env_depth + 1

fn env_pop_scope():
    # O(1) — just decrement depth, no array rebuild
    if env_depth > 1:
        env_depth = env_depth - 1

fn env_scope_depth() -> i64:
    env_depth

# ===== Variable Definition =====

fn env_define(name: text, value_id: i64):
    val top = env_depth - 1
    val bucket = hm_hash_text(name) % SCOPE_HM_SIZE
    # Fast path: check if already defined (read-only, no mutable copy)
    val r_keys = scope_hm_keys[top]
    val r_buckets = scope_hm_buckets[top]
    val r_nexts = scope_hm_nexts[top]
    var idx = r_buckets[bucket]
    while idx != -1:
        if r_keys[idx] == name:
            # Owner write (was a temp-alias round trip: O(n) copy per rebind).
            scope_hm_vals[top][idx] = value_id
            return
        idx = r_nexts[idx]
    # Slow path: new binding — push through the owners (the former four
    # `var x = owner[top]; x.push(..); owner[top] = x` round trips copied all
    # four scope arrays on every new `val`/param bind).
    val new_idx = scope_hm_keys[top].len()
    val head = scope_hm_buckets[top][bucket]
    scope_hm_keys[top].push(name)
    scope_hm_vals[top].push(value_id)
    scope_hm_nexts[top].push(head)
    scope_hm_buckets[top][bucket] = new_idx

# ===== Variable Assignment (search outward) =====

fn env_assign(name: text, value_id: i64) -> bool:
    val hash_val = hm_hash_text(name)
    val scope_bucket = hash_val % SCOPE_HM_SIZE
    # Search from innermost scope outward
    var si = env_depth - 1
    while si >= 0:
        val keys = scope_hm_keys[si]
        val buckets = scope_hm_buckets[si]
        val nexts = scope_hm_nexts[si]
        var idx = buckets[scope_bucket]
        while idx != -1:
            if keys[idx] == name:
                # Owner write (was a temp-alias round trip per assignment).
                scope_hm_vals[si][idx] = value_id
                return true
            idx = nexts[idx]
        si = si - 1
    # Check globals
    val gl_bucket = hash_val % HM_SIZE
    var gl_idx = gl_buckets[gl_bucket]
    while gl_idx != -1:
        if gl_keys[gl_idx] == name:
            gl_vals[gl_idx] = value_id
            return true
        gl_idx = gl_nexts[gl_idx]
    false

# ===== Variable Lookup =====

fn env_lookup(name: text) -> i64:
    val hash_val = hm_hash_text(name)
    val scope_bucket = hash_val % SCOPE_HM_SIZE
    # Search from innermost scope outward
    var si = env_depth - 1
    while si >= 0:
        val keys = scope_hm_keys[si]
        val vals = scope_hm_vals[si]
        val buckets = scope_hm_buckets[si]
        val nexts = scope_hm_nexts[si]
        var idx = buckets[scope_bucket]
        while idx != -1:
            if keys[idx] == name:
                return vals[idx]
            idx = nexts[idx]
        si = si - 1
    # Check globals
    val gl_bucket = hash_val % HM_SIZE
    var gl_idx = gl_buckets[gl_bucket]
    while gl_idx != -1:
        if gl_keys[gl_idx] == name:
            return gl_vals[gl_idx]
        gl_idx = gl_nexts[gl_idx]
    # VAL_NONE sentinel
    -1

# ===== Global Variables =====

fn env_define_global(name: text, value_id: i64):
    val bucket = hm_hash_text(name) % HM_SIZE
    var idx = gl_buckets[bucket]
    while idx != -1:
        if gl_keys[idx] == name:
            gl_vals[idx] = value_id
            return
        idx = gl_nexts[idx]
    # New global
    val new_idx = gl_keys.len()
    gl_keys.push(name)
    gl_vals.push(value_id)
    gl_nexts.push(gl_buckets[bucket])
    gl_buckets[bucket] = new_idx

fn env_lookup_global(name: text) -> i64:
    val bucket = hm_hash_text(name) % HM_SIZE
    var idx = gl_buckets[bucket]
    while idx != -1:
        if gl_keys[idx] == name:
            return gl_vals[idx]
        idx = gl_nexts[idx]
    -1

fn env_remove_global(name: text) -> bool:
    val bucket = hm_hash_text(name) % HM_SIZE
    var prev: i64 = -1
    var idx = gl_buckets[bucket]
    while idx != -1:
        if gl_keys[idx] == name:
            if prev == -1:
                gl_buckets[bucket] = gl_nexts[idx]
            else:
                gl_nexts[prev] = gl_nexts[idx]
            gl_keys[idx] = ""
            gl_vals[idx] = -1
            return true
        prev = idx
        idx = gl_nexts[idx]
    false

# ===== Fast Locals (LOAD_FAST) =====
var frame_locals: [[i64]] = []
var frame_local_counts: [i64] = []
var frame_depth: i64 = 0

fn env_push_frame(local_count: i64):
    if frame_depth < frame_locals.len():
        # Reuse existing slot — grow and reset in place through the owner
        # (no temp-alias copy of the slot array per call).
        while frame_locals[frame_depth].len() < local_count:
            frame_locals[frame_depth].push(-1)
        var lc: i64 = 0
        while lc < local_count:
            frame_locals[frame_depth][lc] = -1
            lc = lc + 1
        frame_local_counts[frame_depth] = local_count
    else:
        var locals: [i64] = []
        var lc: i64 = 0
        while lc < local_count:
            locals.push(-1)
            lc = lc + 1
        frame_locals.push(locals)
        frame_local_counts.push(local_count)
    frame_depth = frame_depth + 1

fn env_pop_frame():
    if frame_depth > 0:
        frame_depth = frame_depth - 1

fn env_get_local(slot: i64) -> i64:
    if frame_depth <= 0: return -1
    if slot < 0: return -1
    val local_count = frame_local_counts[frame_depth - 1]
    if slot >= local_count: return -1
    val locals = frame_locals[frame_depth - 1]
    locals[slot]

fn env_set_local(slot: i64, value_id: i64):
    if frame_depth <= 0: return
    if slot < 0: return
    val local_count = frame_local_counts[frame_depth - 1]
    if slot >= local_count: return
    # Mutate through the single owner: the former
    # `var locals = frame_locals[d]; locals[slot] = v; frame_locals[d] = locals`
    # deep-copied the whole slot array on EVERY local write (COW alias class,
    # doc/08_tracking/bug/value_semantics_cow_alias_perf_class_2026-08-21.md).
    frame_locals[frame_depth - 1][slot] = value_id

fn env_has_frame() -> bool:
    frame_depth > 0
