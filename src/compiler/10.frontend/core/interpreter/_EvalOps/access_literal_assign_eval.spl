# Interpreter eval: field/index/slice access, literals, assignment, comprehensions.
use compiler.frontend.core.interpreter.eval_ops.*
# Core Interpreter — Complex Expression Evaluators
#
# Split from eval.spl. Contains:
# - Float parsing utilities (parse_float_text, char_digit)
# - Call evaluation (eval_call, eval_function_call, eval_struct_constructor)
# - Method dispatch (eval_method_call, eval_method_with_args)
# - Built-in type methods (eval_array_method, eval_text_method)
# - Access evaluation (eval_field_access, eval_index_expr, eval_slice_expr)
# - Collection literals (eval_array_lit, eval_struct_lit)
# - Assignment (eval_assign_expr, eval_compound_assign_expr)
# - Misc (eval_return_expr, eval_interpolated_string, eval_null_coalesce)
#
# All evaluation returns a value_id (i64). Errors indicated by -1 (VAL_NONE).

use compiler.core.types.{TYPE_VOID, TYPE_BOOL, TYPE_I64, TYPE_F64, TYPE_TEXT, TYPE_ANY}
use compiler.core.monomorphize.{mono_cache_init, mono_cache_lookup, mono_cache_register, mono_specialize}

# Raw O(1) byte read out of the text buffer. Registered for this engine in
# interpreter_extern/mod.rs. See the `byte_at` arm below for why this is not
# rt_text_to_bytes.
extern fn rt_string_byte_at(s: text, index: i64) -> i64

# THE live text-method dispatch table.
#
# This used to be one of TWO definitions of `eval_text_method`; the other lived
# in ../eval_methods.spl and was a superset (24 arms vs 13). The subset was the
# one that ran: the sole call site is call_method_eval.spl:586, in this same
# _EvalOps package, so the package-local definition shadowed the one
# __init__.spl re-exports from eval_methods.spl. Result: byte_at returned 0 for
# every index, slice/char_at/to_upper returned the receiver unchanged, and
# parse_int returned nil -- all silently, because a missing arm falls through to
# eval_set_error + -1 rather than failing loudly at the call site.
#
# Proven by sabotage in both directions through core_interpret_expr: making
# eval_methods.spl's `len` arm return 4242 changed nothing (still 6); making
# THIS arm return 7373 returned 7373.
#
# eval_methods.spl has been deleted rather than resynced -- keeping two copies
# in sync was already attempted once (113f0864c7a fixed char_code_at in both)
# and is precisely what let the drift persist. Do not re-add a second copy;
# text_byte_at_dispatch_spec.spl now asserts eval_methods.spl does not exist.
fn eval_text_method(receiver: i64, method_name: text, arg_eids: [i64]) -> i64:
    val s = val_get_text(receiver)

    if method_name == "len":
        return val_make_int(s.len())

    if method_name == "contains":
        if arg_eids.len() > 0:
            val target = eval_expr(arg_eids[0])
            if eval_had_error: return -1
            val t = val_get_text(target)
            return val_make_bool(s.contains(t))
        return val_make_bool(false)

    # char_code_at is CHARACTER (codepoint) indexed in every other lane: the
    # seed does `s.chars().nth(idx)` (interpreter_method/string.rs), and the
    # compiled lanes lower to __simple_rt_string_char_code_at, which walks
    # UTF-8 widths (runtime_native.c rt_string_char_code_at /
    # src/runtime/simple_core/core_string.spl).
    #
    # This used to be `s.substring(idx, idx+1)` then `.char_code_at(0)` on the
    # result. `substring` is BYTE-indexed (deliberately -- it has to agree with
    # the byte offsets `len` and `index_of` hand out), so on any multi-byte
    # codepoint this sliced ONE byte out of the middle of a character and
    # re-decoded that lone byte as UTF-8. Measured: "café,".char_code_at(3)
    # returned 65533 (U+FFFD, the lossy-decode replacement for a bare 0xC3)
    # instead of 233, and every index at or past the first non-ASCII character
    # was shifted.
    #
    # Bounds are handled inside the runtime, which returns 0 for negative and
    # for out-of-range indices -- matching the seed's `None => 0`. Do NOT
    # re-add an `idx < s.len()` guard here: `len` is BYTE length, so for
    # multi-byte text it is an over-estimate of the character count and the
    # walk is the only thing that knows the real end.
    if method_name == "char_code_at":
        if arg_eids.len() > 0:
            val idx_val = eval_expr(arg_eids[0])
            if eval_had_error: return -1
            val idx = val_get_int(idx_val)
            return val_make_int(s.char_code_at(idx))
        return val_make_int(s.char_code_at(0))

    # byte_at is BYTE-indexed, in contrast to char_code_at above which is
    # CHARACTER-indexed: on non-ASCII text the two diverge (e.g.
    # "café,".byte_at(3) == 195, the raw 0xC3 lead byte of 'é', while
    # char_code_at(3) == 233, the decoded codepoint). It must NOT reuse
    # char_code_at's slice-then-decode shape: slicing one byte out of a
    # multi-byte codepoint and decoding it as UTF-8 yields the replacement
    # char, not the raw byte. It reads through rt_string_byte_at, a direct
    # O(1) buffer read (matches the byte-framing scan in
    # src/lib/common/web/browser_renderer_protocol.spl, which relies on
    # byte_at being byte-indexed). Deliberately NOT rt_text_to_bytes: that
    # materializes the whole byte array per call, so a
    # `while i < s.len(): s.byte_at(i)` scan would be O(n^2) -- the same
    # quadratic trap char_code_at was already fixed for. Bounds and negative
    # indices are handled inside the extern, which returns 0 for both,
    # matching the seed and the compiled lanes.
    if method_name == "byte_at":
        if arg_eids.len() > 0:
            val byte_idx_val = eval_expr(arg_eids[0])
            if eval_had_error: return -1
            val byte_idx = val_get_int(byte_idx_val)
            return val_make_int(rt_string_byte_at(s, byte_idx))
        return val_make_int(0)

    if method_name == "substring":
        if arg_eids.len() >= 2:
            val start_val = eval_expr(arg_eids[0])
            if eval_had_error: return -1
            val end_val = eval_expr(arg_eids[1])
            if eval_had_error: return -1
            val start = val_get_int(start_val)
            val end = val_get_int(end_val)
            var s_start = start
            var s_end = end
            if s_start < 0: s_start = 0
            if s_end > s.len(): s_end = s.len()
            if s_start > s_end: s_start = s_end
            return val_make_text(s.substring(s_start, s_end))
        elif arg_eids.len() == 1:
            val start_val = eval_expr(arg_eids[0])
            if eval_had_error: return -1
            val start = val_get_int(start_val)
            var s_start = start
            if s_start < 0: s_start = 0
            if s_start > s.len(): s_start = s.len()
            return val_make_text(s.substring(s_start, s.len()))
        return val_make_text(s)

    # slice is a byte-offset alias of substring, with the same clamping. Kept
    # byte-indexed on purpose: `len` and `index_of` hand out byte offsets, so a
    # character-indexed slice would not compose with them.
    if method_name == "slice":
        if arg_eids.len() >= 2:
            val sl_start_val = eval_expr(arg_eids[0])
            if eval_had_error: return -1
            val sl_end_val = eval_expr(arg_eids[1])
            if eval_had_error: return -1
            var sl_start = val_get_int(sl_start_val)
            var sl_end = val_get_int(sl_end_val)
            if sl_start < 0: sl_start = 0
            if sl_end > s.len(): sl_end = s.len()
            if sl_start > sl_end: sl_start = sl_end
            return val_make_text(s.substring(sl_start, sl_end))
        elif arg_eids.len() == 1:
            val sl1_start_val = eval_expr(arg_eids[0])
            if eval_had_error: return -1
            var sl1_start = val_get_int(sl1_start_val)
            if sl1_start < 0: sl1_start = 0
            if sl1_start > s.len(): sl1_start = s.len()
            return val_make_text(s.substring(sl1_start, s.len()))
        return val_make_text(s)

    if method_name == "starts_with":
        if arg_eids.len() > 0:
            val prefix_val = eval_expr(arg_eids[0])
            if eval_had_error: return -1
            val prefix = val_get_text(prefix_val)
            return val_make_bool(s.starts_with(prefix))
        return val_make_bool(false)

    if method_name == "ends_with":
        if arg_eids.len() > 0:
            val suffix_val = eval_expr(arg_eids[0])
            if eval_had_error: return -1
            val suffix = val_get_text(suffix_val)
            return val_make_bool(s.ends_with(suffix))
        return val_make_bool(false)

    if method_name == "replace":
        if arg_eids.len() >= 2:
            val old_val = eval_expr(arg_eids[0])
            if eval_had_error: return -1
            val new_val = eval_expr(arg_eids[1])
            if eval_had_error: return -1
            val old_t = val_get_text(old_val)
            val new_t = val_get_text(new_val)
            return val_make_text(s.replace(old_t, new_t))
        return val_make_text(s)

    if method_name == "split":
        if arg_eids.len() > 0:
            val sep_val = eval_expr(arg_eids[0])
            if eval_had_error: return -1
            val sep = val_get_text(sep_val)
            val parts = s.split(sep)
            # Bug (text-split-limit-ignored, 2026-07-20): a second `limit` arg
            # (`.split(sep, N)`) was silently ignored -- this handler always
            # split on every occurrence of `sep`. splitn semantics: keep the
            # first `limit - 1` parts as-is, then rejoin the remainder with
            # `sep` as the final element (mirrors Rust's str::splitn). The fix
            # was written into eval_methods.spl, which does not run, so it
            # never took effect; ported here.
            var limited: [text] = parts
            if arg_eids.len() > 1:
                val limit_val = eval_expr(arg_eids[1])
                if eval_had_error: return -1
                val limit = val_get_int(limit_val)
                if limit > 0 and parts.len() > limit:
                    var head: [text] = []
                    var hi = 0
                    while hi < limit - 1:
                        head.push(parts[hi])
                        hi = hi + 1
                    var tail: [text] = []
                    var ti = limit - 1
                    while ti < parts.len():
                        tail.push(parts[ti])
                        ti = ti + 1
                    head.push(tail.join(sep))
                    limited = head
            var result: [i64] = []
            for p in limited:
                result.push(val_make_text(p))
            return val_make_array(result)
        return val_make_array([val_make_text(s)])

    if method_name == "split_lines" or method_name == "lines":
        # Bug (pure_simple_text_split_lines_missing, 2026-07-16): kept
        # identical to the eval_methods.spl / MIR-lowering implementations
        # (replace CRLF->LF, drop exactly one trailing "\n" if present, then
        # split on "\n" -- matches Rust's str::lines()) so all three
        # execution paths agree on CRLF/trailing-empty-line behavior.
        if s == "":
            return val_make_array([])
        val normalized = s.replace("\r\n", "\n")
        val ends_nl = normalized.ends_with("\n")
        val body = if ends_nl: normalized[0:normalized.len() - 1] else: normalized
        val parts = body.split("\n")
        var result: [i64] = []
        for p in parts:
            result.push(val_make_text(p))
        return val_make_array(result)

    if method_name == "trim" or method_name == "strip":
        return val_make_text(s.trim())

    # `find` / `find_str` are one-arg aliases of index_of; only `index_of`
    # carries the two-arg `(needle, start)` form.
    if method_name == "index_of" or method_name == "find" or method_name == "find_str":
        if arg_eids.len() > 0:
            val needle_val = eval_expr(arg_eids[0])
            if eval_had_error: return -1
            val needle = val_get_text(needle_val)
            if method_name == "index_of" and arg_eids.len() >= 2:
                val start_val = eval_expr(arg_eids[1])
                if eval_had_error: return -1
                # index_of already returns a raw i64 with -1 for not-found, so
                # the `?? -1` these two lines used to carry was never reached
                # on a miss — and it corrupted a genuine hit at index 3, which
                # is the nil sentinel (TAG_SPECIAL = 0b011), into a miss.
                return val_make_int(s.index_of(needle, val_get_int(start_val)))
            return val_make_int(s.index_of(needle))
        return val_make_int(-1)

    if method_name == "last_index_of" or method_name == "rfind":
        if arg_eids.len() > 0:
            val r_needle_val = eval_expr(arg_eids[0])
            if eval_had_error: return -1
            val r_needle = val_get_text(r_needle_val)
            # Same raw-i64 / -1-for-miss contract as the index_of branch above:
            # no `?? -1`, which is dead on a miss and corrupts a genuine hit at
            # index 3 (the nil sentinel, TAG_SPECIAL = 0b011).
            return val_make_int(s.last_index_of(r_needle))
        return val_make_int(-1)

    # char_at is left BYTE-indexed on purpose: the compiled lanes lower it to
    # rt_string_char_at, which is `rt_string_new(s->data + index, 1)` -- a raw
    # one-byte slice (runtime_native.c). The seed disagrees (it uses
    # `s.chars().nth(idx)`), so char_at is a genuine cross-lane divergence in
    # its own right, but the split is between the SEED and the RUNTIME, not
    # something this interpreter introduced -- matching the seed here would
    # break agreement with native/JIT. Tracked separately in
    # doc/08_tracking/bug/2026-08-01_interpreter_char_code_at_byte_indexed.md;
    # do not "fix" one side of it in isolation.
    if method_name == "char_at":
        if arg_eids.len() > 0:
            val ca_idx_val = eval_expr(arg_eids[0])
            if eval_had_error: return -1
            val ca_idx = val_get_int(ca_idx_val)
            if ca_idx >= 0 and ca_idx < s.len():
                return val_make_text(s.substring(ca_idx, ca_idx + 1))
            return val_make_text("")
        return val_make_text("")

    # Text `at`: bounds-checked byte access returning Option in the FLAT
    # encoding — a one-byte text is its own `Some`, `nil` is `None`. Deliberately
    # NOT an alias of `char_at`, and deliberately NOT the seed's semantics:
    #
    #   | lane                                | index | out of range |
    #   |-------------------------------------|-------|--------------|
    #   | seed `interpreter_method/string.rs` | char  | `""`         |
    #   |   (`"char_at" | "at"` share one arm)|       |              |
    #   | C runtime `rt_string_char_at`       | byte  | `nil`        |
    #   |   (what `s[i]` lowers to via rt_index_get)                  |
    #   | live array `at` (call_method_eval)  | n/a   | `nil`        |
    #   | THIS arm                            | byte  | `nil`        |
    #
    # Two properties are being preserved, and they both point the same way:
    #   1. `.at` is this codebase's bounds-checked Option accessor. Array `.at`
    #      returns flat-None for an out-of-range index, and 250+ call sites
    #      `match x.at(i)` as Some/None. An `""` return would make every such
    #      match take the Some branch on an out-of-range read.
    #   2. Byte indexing keeps `at` composable with `len` / `index_of` / `slice`
    #      / `char_at`, which all hand out byte offsets here, and keeps the
    #      interpreter in agreement with native/JIT, which lower text indexing to
    #      `rt_string_char_at`. Interpreter/native agreement is the property that
    #      matters for a compiler lane — the same reasoning recorded on `char_at`
    #      above and in
    #      doc/08_tracking/bug/2026-08-01_interpreter_char_code_at_byte_indexed.md.
    #
    # So this arm agrees with the runtime on BOTH axes and diverges from the seed
    # on both. Do not "fix" it toward the seed in isolation. Recorded in
    # doc/08_tracking/bug/2026-08-01_interpreter_evalops_export_gaps.md.
    if method_name == "at":
        if arg_eids.len() == 0:
            eval_set_error("at() requires an index argument")
            return -1
        val at_idx_val = eval_expr(arg_eids[0])
        if eval_had_error: return -1
        val at_idx = val_get_int(at_idx_val)
        if at_idx >= 0 and at_idx < s.len():
            return val_make_text(s.substring(at_idx, at_idx + 1))
        return val_make_nil()

    if method_name == "parse_int":
        val parsed = s.parse_int()
        if parsed.?:
            val int_val = parsed ?? 0
            # Returned as an Option-shaped struct so `??` works on the result.
            var some_names: [text] = []
            some_names.push("__tag")
            some_names.push("__payload")
            var some_values: [i64] = []
            some_values.push(val_make_text("Some"))
            some_values.push(val_make_int(int_val))
            return val_make_struct("Option", some_names, some_values)
        var none_names: [text] = []
        none_names.push("__tag")
        none_names.push("__payload")
        var none_values: [i64] = []
        none_values.push(val_make_text("None"))
        none_values.push(val_make_nil())
        return val_make_struct("Option", none_names, none_values)

    if method_name == "to_upper":
        return val_make_text(s.to_upper())

    if method_name == "to_lower":
        return val_make_text(s.to_lower())

    if method_name == "to_string":
        return val_make_text(s)

    eval_set_error("no method '" + method_name + "' on text")
    -1

# ===== Field Access =====

fn eval_field_access(eid: i64) -> i64:
    val e_node = expr_get(eid)
    val base_eid = e_node.left
    val field_name = e_node.s_val

    # Check for enum variant access: EnumType.Variant (no-arg)
    val base_node2 = expr_get(base_eid)
    val base_tag = base_node2.tag
    if base_tag == EXPR_IDENT:
        val type_name = base_node2.s_val
        val enum_variants = enum_table_lookup(type_name)
        if enum_variants != "":
            return eval_enum_variant_access(type_name, field_name)
        # Check for static method reference: Type.method
        val static_fn = type_name + "__" + field_name
        val static_decl = func_table_lookup(static_fn)
        if static_decl >= 0:
            return val_make_function(static_fn, static_decl)

    val base_val = eval_expr(base_eid)
    if eval_had_error: return -1

    if val_is_struct(base_val):
        # Fast path: cached field index from previous access
        val cached_idx = expr_i_val[eid]
        if cached_idx >= 0:
            val ok = val_struct_check_field_idx(base_val, cached_idx, field_name)
            if ok:
                return val_struct_get_field_idx(base_val, cached_idx)
        # Slow path: linear search + cache index
        val fi = val_struct_find_field_idx(base_val, field_name)
        if fi >= 0:
            expr_i_val[eid] = fi
            return val_struct_get_field_idx(base_val, fi)
        eval_set_error("no field '" + field_name + "' on struct " + val_get_struct_name(base_val))
        return -1

    eval_set_error("cannot access field on " + val_kind_name(val_get_kind(base_val)))
    -1

# ===== Index Expression =====

fn eval_index_expr(eid: i64) -> i64:
    val e_node = expr_get(eid)
    val base_eid = e_node.left
    val index_eid = e_node.right

    val base_val = eval_expr(base_eid)
    if eval_had_error: return -1
    val index_val = eval_expr(index_eid)
    if eval_had_error: return -1

    if val_is_array(base_val):
        val elements = val_get_array(base_val)
        if not val_is_int(index_val):
            eval_set_error("type error: array index must be int, got " + val_kind_name(val_get_kind(index_val)))
            return -1
        val idx = val_get_int(index_val)
        if idx >= 0:
            val len = elements.len()
            if idx < len:
                return elements[idx]
        eval_set_error("array index out of bounds: " + "{idx}")
        return -1

    if val_is_text(base_val):
        val s = val_get_text(base_val)
        if not val_is_int(index_val):
            eval_set_error("type error: string index must be int, got " + val_kind_name(val_get_kind(index_val)))
            return -1
        val idx = val_get_int(index_val)
        if idx >= 0:
            if idx < s.len():
                return val_make_text(s[idx])
        eval_set_error("string index out of bounds: " + "{idx}")
        return -1

    if val_is_struct(base_val) and val_get_struct_name(base_val) == "__dict":
        val field_val = val_struct_get_field(base_val, val_to_text(index_val))
        if field_val >= 0: return field_val
        return val_make_nil()

    eval_set_error("cannot index " + val_kind_name(val_get_kind(base_val)))
    -1

# ===== Slice Expression =====

fn eval_slice_expr(eid: i64) -> i64:
    """Evaluate slice expression: base[start:end]

    Handles string and array slicing with support for:
    - [:end] - slice from start (start=0)
    - [start:] - slice to end (end=-1 means len)
    - [start:end] - explicit range
    """
    val e_node = expr_get(eid)
    val base_eid = e_node.left
    val start_eid = e_node.right
    val end_eid = e_node.extra

    val base_val = eval_expr(base_eid)
    if eval_had_error: return -1
    val start_val = eval_expr(start_eid)
    if eval_had_error: return -1
    val end_val = eval_expr(end_eid)
    if eval_had_error: return -1

    if val_is_text(base_val):
        val s = val_get_text(base_val)
        val slen = s.len()

        # Get start index (default 0)
        var start_idx = 0
        if not val_is_int(start_val):
            eval_set_error("type error: slice start must be int, got " + val_kind_name(val_get_kind(start_val)))
            return -1
        start_idx = val_get_int(start_val)
        if start_idx < 0:
            start_idx = 0

        # Get end index (default slen, -1 means slen)
        var end_idx = slen
        if not val_is_int(end_val):
            eval_set_error("type error: slice end must be int, got " + val_kind_name(val_get_kind(end_val)))
            return -1
        end_idx = val_get_int(end_val)
        if end_idx < 0:
            end_idx = slen
        if end_idx > slen:
            end_idx = slen

        # Slice the string
        if start_idx >= slen:
            return val_make_text("")
        if end_idx <= start_idx:
            return val_make_text("")

        return val_make_text(s[start_idx:end_idx])

    if val_is_array(base_val):
        val elements = val_get_array(base_val)
        val alen = elements.len()

        # Get start index (default 0)
        var start_idx = 0
        if not val_is_int(start_val):
            eval_set_error("type error: slice start must be int, got " + val_kind_name(val_get_kind(start_val)))
            return -1
        start_idx = val_get_int(start_val)
        if start_idx < 0:
            start_idx = 0

        # Get end index (default alen, -1 means alen)
        var end_idx = alen
        if not val_is_int(end_val):
            eval_set_error("type error: slice end must be int, got " + val_kind_name(val_get_kind(end_val)))
            return -1
        end_idx = val_get_int(end_val)
        if end_idx < 0:
            end_idx = alen
        if end_idx > alen:
            end_idx = alen

        # Slice the array
        var result: [i64] = []
        if start_idx < alen and end_idx > start_idx:
            for i in start_idx..end_idx:
                result.push(elements[i])

        return val_make_array(result)

    eval_set_error("cannot slice " + val_kind_name(val_get_kind(base_val)))
    -1

# ===== Array Literal =====

fn eval_array_lit(eid: i64) -> i64:
    val elem_eids = expr_get(eid).args
    var elements: [i64] = []
    for e_eid in elem_eids:
        val ev = eval_expr(e_eid)
        if eval_had_error: return -1
        elements.push(ev)
    val_make_array(elements)

# ===== Tuple Literal =====
# Tuples are evaluated as arrays in the interpreter

fn eval_tuple_lit(eid: i64) -> i64:
    val elem_eids = expr_get(eid).args
    var elements: [i64] = []
    for e_eid in elem_eids:
        val ev = eval_expr(e_eid)
        if eval_had_error: return -1
        elements.push(ev)
    val_make_array(elements)

# ===== Struct Literal =====

fn eval_struct_lit(eid: i64) -> i64:
    val e_node = expr_get(eid)
    val type_name = e_node.s_val
    val field_name_eids = e_node.args
    val field_value_eids = e_node.stmts

    # Field names stored as ident expressions
    var field_names: [text] = []
    for fn_eid in field_name_eids:
        field_names.push(expr_get(fn_eid).s_val)

    var field_values: [i64] = []
    for fv_eid in field_value_eids:
        val fv = eval_expr(fv_eid)
        if eval_had_error: return -1
        field_values.push(fv)

    val_make_struct(type_name, field_names, field_values)

# Dict literals use the existing dynamic-field struct representation.
fn eval_dict_lit(eid: i64) -> i64:
    val e_node = expr_get(eid)
    val key_eids = e_node.args
    val value_eids = e_node.stmts
    var field_names: [text] = []
    var field_values: [i64] = []
    var i: i64 = 0
    for key_eid in key_eids:
        val key = eval_expr(key_eid)
        if eval_had_error: return -1
        val value = eval_expr(value_eids[i])
        if eval_had_error: return -1
        field_names.push(val_to_text(key))
        field_values.push(value)
        i = i + 1
    val_make_struct("__dict", field_names, field_values)

# ===== Assignment Expression =====

fn eval_assign_expr(eid: i64) -> i64:
    val e_node = expr_get(eid)
    val target_eid = e_node.left
    val value_eid = e_node.right

    val new_val = eval_expr(value_eid)
    if eval_had_error: return -1

    val target_node = expr_get(target_eid)
    val target_tag = target_node.tag
    if target_tag == EXPR_IDENT:
        val name = target_node.s_val
        val ok = env_assign(name, new_val)
        if ok == false:
            eval_set_error("undefined variable: " + name)
            return -1
        return new_val

    if target_tag == EXPR_FIELD_ACCESS:
        val base_eid2 = target_node.left
        val field_name = target_node.s_val
        val base_val = eval_expr(base_eid2)
        if eval_had_error: return -1
        if val_is_struct(base_val):
            # S1 copy-site 4 (struct field store). THIS is the live path for
            # `obj.field = s` written as a statement in a function body: it
            # parses as an assignment EXPRESSION, so it never reaches
            # eval_stmts.spl's STMT_ASSIGN handler. Storing a value-type struct
            # stores a SNAPSHOT; class values fall through the gate unchanged
            # and stay aliased.
            val store_val = val_copy_if_value_struct(new_val)
            # Fast path: cached field index
            val cached_idx = expr_i_val[target_eid]
            if cached_idx >= 0:
                val ok = val_struct_check_field_idx(base_val, cached_idx, field_name)
                if ok:
                    val_struct_set_field_idx(base_val, cached_idx, store_val)
                    return store_val
            # Slow path: find + set + cache
            val fi = val_struct_find_field_idx(base_val, field_name)
            if fi >= 0:
                val_struct_set_field_idx(base_val, fi, store_val)
                expr_i_val[target_eid] = fi
                return store_val
            eval_set_error("no field '" + field_name + "' on struct " + val_get_struct_name(base_val))
            return -1
        eval_set_error("cannot set field on " + val_kind_name(val_get_kind(base_val)))
        return -1

    if target_tag == EXPR_INDEX:
        val base_val = eval_expr(target_node.left)
        if eval_had_error: return -1
        val key_val = eval_expr(target_node.right)
        if eval_had_error: return -1
        if val_is_struct(base_val) and val_get_struct_name(base_val) == "__dict":
            val_struct_upsert_field(base_val, val_to_text(key_val), new_val)
            return new_val
        if val_is_array(base_val) and val_is_int(key_val):
            val idx = val_get_int(key_val)
            if idx >= 0 and idx < val_arrays[base_val].len():
                val_arrays[base_val][idx] = new_val
                return new_val
        eval_set_error("invalid index assignment")
        return -1

    eval_set_error("invalid assignment target")
    -1

fn eval_compound_assign_expr(eid: i64) -> i64:
    val e_node = expr_get(eid)
    val op = e_node.i_val
    val target_eid = e_node.left
    val value_eid = e_node.right

    val target_node = expr_get(target_eid)
    val target_tag = target_node.tag
    if target_tag == EXPR_IDENT:
        val name = target_node.s_val
        val old_val = env_lookup(name)
        if old_val < 0:
            eval_set_error("undefined variable: " + name)
            return -1
        val rhs_val = eval_expr(value_eid)
        if eval_had_error: return -1
        val new_val = val_compound_op(op, old_val, rhs_val)
        if new_val < 0:
            val err = ops_get_error()
            if err != "":
                eval_set_error(err)
            return -1
        env_assign(name, new_val)
        return new_val

    # Field place: base.f op= rhs. The base sub-expression is evaluated ONCE and
    # yields the value_id of the struct that actually stores the field (struct
    # field reads alias — val_struct_get_field_idx returns the stored value_id,
    # it does not rebuild a copy), so this works at ARBITRARY hop depth:
    # `root.mid.inner.n += 1` resolves `root.mid.inner` to the real inner struct
    # and writes through it. Same place model as eval_assign_expr.
    # Kept byte-identical to the copy in ../eval_access.spl — both definitions
    # land in the same flat symbol registry, so they must not diverge.
    if target_tag == EXPR_FIELD_ACCESS:
        val fa_base_eid = target_node.left
        val fa_field = target_node.s_val
        val fa_base = eval_expr(fa_base_eid)
        if eval_had_error: return -1
        if val_is_struct(fa_base) == false:
            eval_set_error("cannot compound-assign field on " + val_kind_name(val_get_kind(fa_base)))
            return -1
        val fa_idx = val_struct_find_field_idx(fa_base, fa_field)
        if fa_idx < 0:
            eval_set_error("no field '" + fa_field + "' on struct " + val_get_struct_name(fa_base))
            return -1
        val fa_old = val_struct_get_field_idx(fa_base, fa_idx)
        val fa_rhs = eval_expr(value_eid)
        if eval_had_error: return -1
        val fa_new = val_compound_op(op, fa_old, fa_rhs)
        if fa_new < 0:
            val fa_err = ops_get_error()
            if fa_err != "":
                eval_set_error(fa_err)
            return -1
        val_struct_set_field_idx(fa_base, fa_idx, fa_new)
        return fa_new

    # Index place: base[k] op= rhs. Mirrors the index branch of eval_assign_expr —
    # the element is updated through the base handle, so array value semantics are
    # unchanged (the base is whatever place the sub-expression already resolved to).
    if target_tag == EXPR_INDEX:
        val ix_base = eval_expr(target_node.left)
        if eval_had_error: return -1
        val ix_key = eval_expr(target_node.right)
        if eval_had_error: return -1

        if val_is_array(ix_base):
            if val_is_int(ix_key):
                val ix_elems = val_get_array(ix_base)
                val ix_i = val_get_int(ix_key)
                var ix_in_range = false
                if ix_i >= 0:
                    if ix_i < ix_elems.len():
                        ix_in_range = true
                if ix_in_range == false:
                    eval_set_error("array index out of bounds: " + "{ix_i}")
                    return -1
                val ix_old = ix_elems[ix_i]
                val ix_rhs = eval_expr(value_eid)
                if eval_had_error: return -1
                val ix_new = val_compound_op(op, ix_old, ix_rhs)
                if ix_new < 0:
                    val ix_err = ops_get_error()
                    if ix_err != "":
                        eval_set_error(ix_err)
                    return -1
                val_arrays[ix_base][ix_i] = ix_new
                return ix_new

        if val_is_struct(ix_base):
            val ix_name = val_to_text(ix_key)
            val ix_fi = val_struct_find_field_idx(ix_base, ix_name)
            if ix_fi < 0:
                eval_set_error("no key '" + ix_name + "' on " + val_get_struct_name(ix_base))
                return -1
            val ix_sold = val_struct_get_field_idx(ix_base, ix_fi)
            val ix_srhs = eval_expr(value_eid)
            if eval_had_error: return -1
            val ix_snew = val_compound_op(op, ix_sold, ix_srhs)
            if ix_snew < 0:
                val ix_serr = ops_get_error()
                if ix_serr != "":
                    eval_set_error(ix_serr)
                return -1
            val_struct_set_field_idx(ix_base, ix_fi, ix_snew)
            return ix_snew

        eval_set_error("cannot compound index-assign " + val_kind_name(val_get_kind(ix_base)))
        return -1

    eval_set_error("invalid compound assignment target")
    -1

# ===== Return Expression =====

fn eval_return_expr(eid: i64) -> i64:
    val value_eid = expr_get(eid).left
    var ret_val = val_make_nil()
    if value_eid >= 0:
        ret_val = eval_expr(value_eid)
        if eval_had_error: return -1
    eval_returning = true
    eval_return_value = ret_val
    ret_val

# ===== Interpolated String =====

fn eval_interpolation_segments(value: text) -> [text]:
    var segments: [text] = []
    var current = ""
    var depth = 0
    var i = 0
    while i < value.len():
        val ch = value[i:i + 1]
        val next = if i + 1 < value.len(): value[i + 1:i + 2] else: ""
        if depth == 0 and ch == "{" and next == "{":
            current = current + "{"
            i = i + 1
        elif depth == 0 and ch == "}" and next == "}":
            current = current + "}"
            i = i + 1
        elif depth == 0 and ch == "{":
            segments.push(current)
            current = ""
            depth = 1
        elif depth > 0 and ch == "{":
            depth = depth + 1
        elif depth > 0 and ch == "}":
            depth = depth - 1
        elif depth == 0:
            current = current + ch
        i = i + 1
    segments.push(current)
    segments

fn eval_interpolated_string(eid: i64) -> i64:
    val node = expr_get(eid)
    val parts = node.args
    val segments = eval_interpolation_segments(node.s_val)
    if segments.len() != parts.len() + 1:
        eval_set_error("invalid interpolated string")
        return -1
    var result = segments[0]
    var i = 0
    while i < parts.len():
        val part_eid = parts[i]
        val part_val = eval_expr(part_eid)
        if eval_had_error: return -1
        result = result + val_to_text(part_val) + segments[i + 1]
        i = i + 1
    val_make_text(result)

# ===== Null Coalesce =====

fn eval_null_coalesce(eid: i64) -> i64:
    val e_node = expr_get(eid)
    val left = eval_expr(e_node.left)
    if eval_had_error: return -1
    if val_is_nil(left) == false: return left
    eval_expr(e_node.right)

# ===== Enum Variant Construction =====

fn eval_enum_variant_call(type_name: text, variant_name: text, arg_eids: [i64]) -> i64:
    # EnumType.Variant(payload) → struct with __tag and __payload fields
    val tag_val = val_make_text(variant_name)
    var payload_val = val_make_nil()
    if arg_eids.len() == 1:
        payload_val = eval_expr(arg_eids[0])
        if eval_had_error: return -1
    elif arg_eids.len() > 1:
        # Multiple args → tuple payload
        var payload_elems: [i64] = []
        for aeid in arg_eids:
            val av = eval_expr(aeid)
            if eval_had_error: return -1
            payload_elems.push(av)
        payload_val = val_make_array(payload_elems)
    val full_name = type_name + "::" + variant_name
    var field_names: [text] = []
    field_names.push("__tag")
    field_names.push("__payload")
    var field_values: [i64] = []
    field_values.push(tag_val)
    field_values.push(payload_val)
    val_make_struct(full_name, field_names, field_values)

fn eval_enum_variant_access(type_name: text, variant_name: text) -> i64:
    # EnumType.Variant (no parens) → struct with __tag, no payload
    val tag_val = val_make_text(variant_name)
    val full_name = type_name + "::" + variant_name
    var field_names: [text] = []
    field_names.push("__tag")
    field_names.push("__payload")
    var field_values: [i64] = []
    field_values.push(tag_val)
    field_values.push(val_make_nil())
    val_make_struct(full_name, field_names, field_values)

# ===== Lambda Expression =====
# EXPR_LAMBDA: args = [EXPR_IDENT params], stmts = [body exprs]
# Desugared from \x: expr, _ placeholders, _N numbered, &:method

var lambda_counter: i64 = 0

fn eval_lambda(eid: i64) -> i64:
    val e_node = expr_get(eid)
    val param_idents = e_node.args
    val body_exprs = e_node.stmts

    # Extract param names from EXPR_IDENT nodes
    var param_names: [text] = []
    var param_types: [i64] = []
    for pid in param_idents:
        param_names.push(expr_get(pid).s_val)
        param_types.push(0)

    # Wrap body expressions as stmt_expr_stmt nodes
    var body_stmts: [i64] = []
    for beid in body_exprs:
        body_stmts.push(stmt_expr_stmt(beid, 0))

    # Create anonymous function declaration
    lambda_counter = lambda_counter + 1
    val fn_name = "__lambda_{lambda_counter}"
    var type_params: [text] = []
    val decl_id = decl_fn(fn_name, param_names, param_types, 0, body_stmts, 0, type_params, 0)

    # Register in function table
    func_table_register(fn_name, decl_id)
    # coverage owner-attribution: a lambda literal has no source file of its
    # own — attribute it to whichever function/module is creating it right
    # now (coverage_owner_file() prefers the enclosing decl's registered
    # owner, falling back to the currently-parsing module).
    decl_owner_file_set(decl_id, coverage_owner_file())

    # Return function value
    val_make_function(fn_name, decl_id)

# ===== List Comprehension =====
# EXPR_LIST_COMP: s_val=iter_var, left=iterable, right=body, extra=cond (-1 if none)

fn eval_list_comp(eid: i64) -> i64:
    val e_node = expr_get(eid)
    val iter_name = e_node.s_val
    val iterable_eid = e_node.left
    val body_eid = e_node.right
    val cond_eid = e_node.extra

    # Evaluate iterable
    val iterable_val = eval_expr(iterable_eid)
    if eval_had_error: return -1

    var result_elements: [i64] = []
    val kind = val_get_kind(iterable_val)

    val iterable_array = val_iterable_array(iterable_val)
    if iterable_array >= 0:
        val elements = val_get_array(iterable_array)
        for elem_vid in elements:
            if eval_had_error: break
            env_push_scope()
            env_define(iter_name, elem_vid)
            # Check condition if present
            var include = true
            if cond_eid >= 0:
                val cond_result = eval_expr(cond_eid)
                if eval_had_error:
                    env_pop_scope()
                    return -1
                include = val_is_truthy(cond_result)
            if include:
                val body_val = eval_expr(body_eid)
                if eval_had_error:
                    env_pop_scope()
                    return -1
                result_elements.push(body_val)
            env_pop_scope()
        return val_make_array(result_elements)

    # Range support: check if iterable_eid is a RANGE expression
    if kind == VAL_INT:
        val iterable_tag = expr_get(iterable_eid).tag
        if iterable_tag == EXPR_RANGE:
            val range_node = expr_get(iterable_eid)
            val start_val = eval_expr(range_node.left)
            if eval_had_error: return -1
            val end_val = eval_expr(range_node.right)
            if eval_had_error: return -1
            val inclusive = range_node.i_val
            val start_n = val_get_int(start_val)
            val end_n = val_get_int(end_val)
            var current = start_n
            var _iter: i64 = 0
            while _iter < 1000001:
                val should_stop = current > end_n
                val at_limit = current == end_n
                if inclusive != 0:
                    if should_stop: break
                else:
                    if at_limit: break
                    if should_stop: break
                env_push_scope()
                env_define(iter_name, val_make_int(current))
                var include = true
                if cond_eid >= 0:
                    val cond_result = eval_expr(cond_eid)
                    if eval_had_error:
                        env_pop_scope()
                        return -1
                    include = val_is_truthy(cond_result)
                if include:
                    val body_val = eval_expr(body_eid)
                    if eval_had_error:
                        env_pop_scope()
                        return -1
                    result_elements.push(body_val)
                env_pop_scope()
                current = current + 1
                _iter = _iter + 1
            return val_make_array(result_elements)

    eval_set_error("comprehension: cannot iterate over " + val_kind_name(kind))
    -1

# ===== Dict Comprehension =====
# EXPR_DICT_COMP: s_val=iter_var, left=iterable, args=[key_body, val_body], extra=cond

fn eval_dict_comp(eid: i64) -> i64:
    # Dict comprehension not supported in tree-walking interpreter (no dict value type)
    # Works via compiled path (HIR/MIR)
    eval_set_error("dict comprehension not supported in interpreter mode")
    -1
