# Dangerous Keywords Registry
#
# Extensible list of identifier names that require a comment string argument
# when used in statement position. Omitting the comment emits a REQC002 warning.
#
# Add new dangerous identifiers via register_dangerous_keyword().

# ============================================================================
# Registry
# ============================================================================

var DANGEROUS_KEYWORDS: [text] = [
    "dangerous_token_but_needs",
    "loss",
    "unsafe_cast",
    "raw_pointer",
    "unchecked"
]

fn is_dangerous_keyword(name: text) -> bool:
    if DANGEROUS_KEYWORDS == nil:
        return false
    for kw in DANGEROUS_KEYWORDS:
        if kw == name:
            return true
    false

fn register_dangerous_keyword(name: text):
    if DANGEROUS_KEYWORDS == nil:
        DANGEROUS_KEYWORDS = []
    for kw in DANGEROUS_KEYWORDS:
        if kw == name:
            return
    DANGEROUS_KEYWORDS.push(name)

fn source_may_contain_dangerous_keyword(source: text) -> bool:
    """Conservative allocation-free admission check for the REQC AST walk.

    The registry is intentionally small and extensible. Searching the source
    once per registered name avoids constructing temporary `name + "("`
    strings on every linted file while allowing harmless false positives; the
    AST pass remains authoritative.
    """
    if source == "" or DANGEROUS_KEYWORDS == nil:
        return false
    for keyword in DANGEROUS_KEYWORDS:
        if source.contains(keyword):
            return true
    false

# ============================================================================
# Argument Parsing
# ============================================================================
