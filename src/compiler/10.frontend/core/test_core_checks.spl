# Direct compiler checks return failure counts; callers own accumulation.

pub fn check_eq_int(label: text, actual: i64, expected: i64) -> i64:
    if actual != expected:
        print "FAIL: {label} - expected {expected}, got {actual}"
        return 1
    0

pub fn check_eq_str(label: text, actual: text, expected: text) -> i64:
    if actual != expected:
        print "FAIL: {label} - expected '{expected}', got '{actual}'"
        return 1
    0

pub fn check_true(label: text, condition: bool) -> i64:
    if not condition:
        print "FAIL: {label}"
        return 1
    0
