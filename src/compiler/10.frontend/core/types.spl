# @no_alloc
# Core Simple — Monomorphized Runtime Types
#
# Shared core library: type system, spans, tokens, symbols, scopes.
# All operations are free functions — no generics, no me methods, no closures.
# Arena pattern: parallel arrays instead of structs.
#
# Types are represented as integer tags and opaque i64 handles.
# The C codegen translates these to proper spl_* calls.

# ===== String Operations (delegated to runtime built-ins) =====
# Call runtime externs directly to avoid method-dispatch recursion in compiled mode.

extern fn rt_string_contains(s: text, substr: text) -> bool
extern fn rt_string_len(s: text) -> i64
extern fn rt_string_starts_with(s: text, prefix: text) -> bool
extern fn rt_string_ends_with(s: text, suffix: text) -> bool
extern fn rt_string_trim(s: text) -> text
extern fn rt_string_replace(s: text, from: text, to: text) -> text
extern fn rt_string_index_of(s: text, needle: text) -> i64

fn str_concat(a: text, b: text) -> text:
    a + b

fn str_len(s: text) -> i64:
    rt_string_len(s)

fn str_eq(a: text, b: text) -> bool:
    a == b

fn str_slice(s: text, start: i64, end_idx: i64) -> text:
    s[start:end_idx]

fn str_char_at(s: text, idx: i64) -> text:
    s[idx]

fn str_contains(s: text, needle: text) -> bool:
    rt_string_contains(s, needle)

fn str_starts_with(s: text, prefix: text) -> bool:
    rt_string_starts_with(s, prefix)

fn str_ends_with(s: text, suffix: text) -> bool:
    rt_string_ends_with(s, suffix)

fn str_index_of(s: text, needle: text) -> i64:
    rt_string_index_of(s, needle)

fn str_trim(s: text) -> text:
    rt_string_trim(s)

fn str_replace(s: text, old_s: text, new_s: text) -> text:
    rt_string_replace(s, old_s, new_s)

# ===== Integer/Text Conversion =====

fn int_to_str(n: i64) -> text:
    if n == 0:
        return "0"
    var neg: bool = false
    var v: i64 = n
    if n < 0:
        neg = true
        v = 0 - n
    var result: text = ""
    for k in 0..20:
        if v == 0:
            break
        val d = v % 10
        var ch: text = "0"
        if d == 1: ch = "1"
        if d == 2: ch = "2"
        if d == 3: ch = "3"
        if d == 4: ch = "4"
        if d == 5: ch = "5"
        if d == 6: ch = "6"
        if d == 7: ch = "7"
        if d == 8: ch = "8"
        if d == 9: ch = "9"
        result = ch + result
        v = v / 10
    if neg:
        return "-" + result
    result

fn bool_to_str(b: bool) -> text:
    if b:
        return "true"
    "false"

# ===== Span (Source Location) =====
# Stored as 4 integers per span to avoid struct issues with the runtime parser.

var span_pool_start: [i64] = []
var span_pool_end: [i64] = []
var span_pool_line: [i64] = []
var span_pool_col: [i64] = []

fn flat_span_new(start: i64, end_pos: i64, line: i64, col: i64) -> i64:
    val idx = span_pool_start.len()
    span_pool_start.push(start)
    span_pool_end.push(end_pos)
    span_pool_line.push(line)
    span_pool_col.push(col)
    idx

fn span_start(span_id: i64) -> i64:
    span_pool_start[span_id]

fn span_end(span_id: i64) -> i64:
    span_pool_end[span_id]

fn span_line(span_id: i64) -> i64:
    span_pool_line[span_id]

fn span_col(span_id: i64) -> i64:
    span_pool_col[span_id]

fn span_is_valid(span_id: i64) -> bool:
    span_id >= 0 and span_id < span_pool_start.len()

fn span_dummy() -> i64:
    flat_span_new(0, 0, 0, 0)

# ===== Token =====
# A token is (kind: i64, span: i64, text: text)
# Stored in parallel arrays for arena allocation.

var tok_pool_kind: [i64] = []
var tok_pool_span: [i64] = []
var tok_pool_text: [text] = []

fn token_new(kind: i64, span_id: i64, value: text) -> i64:
    val idx = tok_pool_kind.len()
    tok_pool_kind.push(kind)
    tok_pool_span.push(span_id)
    tok_pool_text.push(value)
    idx

fn token_kind(tok_id: i64) -> i64:
    tok_pool_kind[tok_id]

fn token_span(tok_id: i64) -> i64:
    tok_pool_span[tok_id]

fn token_text(tok_id: i64) -> text:
    tok_pool_text[tok_id]

# ===== Symbol Table =====
# Maps names to (type_tag, scope_depth, declaration_index)
# Uses Simple built-in dict (string keys).

var sym_names: [text] = []
var sym_types: [i64] = []
var sym_depths: [i64] = []
var sym_decl_ids: [i64] = []
var sym_mutable: [i64] = []

# Symbol type constants
val SYM_VAR: i64 = 1
val SYM_VAL: i64 = 2
val SYM_FN: i64 = 3
val SYM_STRUCT: i64 = 4
val SYM_EXTERN_FN: i64 = 5
val SYM_PARAM: i64 = 6
val SYM_MODULE: i64 = 7

fn symbol_new(name: text, sym_type: i64, depth: i64, decl_id: i64, is_mut: i64) -> i64:
    val idx = sym_names.len()
    sym_names.push(name)
    sym_types.push(sym_type)
    sym_depths.push(depth)
    sym_decl_ids.push(decl_id)
    sym_mutable.push(is_mut)
    idx

fn symbol_name(sym_id: i64) -> text:
    sym_names[sym_id]

fn symbol_type(sym_id: i64) -> i64:
    sym_types[sym_id]

fn symbol_depth(sym_id: i64) -> i64:
    sym_depths[sym_id]

fn symbol_decl(sym_id: i64) -> i64:
    sym_decl_ids[sym_id]

fn symbol_is_mutable(sym_id: i64) -> bool:
    sym_mutable[sym_id] == 1

# ===== Scope Stack =====
# Simple scope tracking: each scope has a start index into the symbol table.
# When exiting scope, symbols after that index are "hidden" (not removed).

var scope_starts: [i64] = []
var current_scope_depth: i64 = 0

fn scope_push() -> i64:
    scope_starts.push(sym_names.len())
    current_scope_depth = current_scope_depth + 1
    current_scope_depth

fn scope_pop() -> i64:
    current_scope_depth = current_scope_depth - 1
    val start = scope_starts[scope_starts.len() - 1]
    # We don't actually remove symbols, just track depth
    start

fn scope_depth() -> i64:
    current_scope_depth

# ===== Type Tags =====
# Bootstrap uses integer tags for types instead of a full type system.

val TYPE_VOID: i64 = 0
val TYPE_BOOL: i64 = 1
val TYPE_I64: i64 = 2
val TYPE_F64: i64 = 3
val TYPE_TEXT: i64 = 4
val TYPE_ARRAY_I64: i64 = 5
val TYPE_ARRAY_TEXT: i64 = 6
val TYPE_ARRAY_BOOL: i64 = 7
val TYPE_ARRAY_ANY: i64 = 8
val TYPE_DICT: i64 = 9
val TYPE_STRUCT: i64 = 10
val TYPE_FN: i64 = 11
val TYPE_ANY: i64 = 12
val TYPE_NIL: i64 = 13
val TYPE_OPTION: i64 = 14
val TYPE_OPTION_I64: i64 = 15
val TYPE_OPTION_F64: i64 = 16
val TYPE_OPTION_TEXT: i64 = 17
val TYPE_OPTION_BOOL: i64 = 18
val TYPE_RESULT: i64 = 19
val TYPE_FUTURE: i64 = 20
val TYPE_POLL: i64 = 21
val TYPE_TASK: i64 = 22
val TYPE_GENERIC_ERASED: i64 = 23
val TYPE_UNION: i64 = 24
val TYPE_INTERSECTION: i64 = 25
val TYPE_REFINEMENT: i64 = 26
# Fixed-width integer primitives. i64 already has TYPE_I64 (=2); these carry the
# concrete bit width and signedness of u8/u16/u32/u64/i8/i16/i32 through the
# flat parser -> AST bridge -> HIR Int(bits, signed) -> MIR I8..U64 -> backend
# type mappers (e.g. VHDL unsigned/signed(W-1 downto 0)). Without them these
# widths collapse to TYPE_I64 and every backend renders a 64-bit lane.
val TYPE_U8: i64 = 27
val TYPE_U16: i64 = 28
val TYPE_U32: i64 = 29
val TYPE_U64: i64 = 30
val TYPE_I8: i64 = 31
val TYPE_I16: i64 = 32
val TYPE_I32: i64 = 33
# Encoded ranges: union/intersection/refinement IDs are encoded into type tags
# TYPE_UNION_BASE + id => specific union, TYPE_INTERSECTION_BASE + id => specific intersection, etc.
# Option<T> generic-arg specializations (bug:
# native_option_unwrap_receiver_unresolved_2026-08-09). TYPE_OPTION (=14) and
# the four TYPE_OPTION_{I64,F64,TEXT,BOOL} tags cover primitive inners only, so
# `Option<Drv2>` / `Drv2?` collapsed to bare TYPE_OPTION and erased the class
# identity all the way through the AST bridge into HIR -- MIR's
# option_inner_hir_type then saw Optional(Any) and static devirtualization of
# `opt.unwrap().method()` had no owner name to recover, hard-failing with
# `unresolved method call`. Mirrors the array element-type registry: register
# the inner tag and encode TYPE_OPTION_GENERIC_BASE + id. 300..500 is the free
# gap below TYPE_UNION_BASE.
val TYPE_OPTION_GENERIC_BASE: i64 = 300
val TYPE_OPTION_GENERIC_LIMIT: i64 = 500
val TYPE_UNION_BASE: i64 = 500
val TYPE_INTERSECTION_BASE: i64 = 600
val TYPE_REFINEMENT_BASE: i64 = 700
# Dict<K,V> generic-arg specializations: bare TYPE_DICT (=9) has no room to
# carry K/V, so a `Dict<text,i64>` annotation registers its two component
# tags here and encodes TYPE_DICT_BASE + id, mirroring the union/intersection/
# refinement registries above (bug: dicttype -- generic args were silently
# dropped, turning every dict-typed param/local into a plain TYPE_DICT with
# no key/value info by the time it reached the AST bridge).
val TYPE_DICT_BASE: i64 = 1000
val TYPE_RESULT_BASE: i64 = 2000
val TYPE_RESULT_LIMIT: i64 = 3000
# Tuple type annotations `(A, B, C)`: the flat tag lane previously collapsed
# every parenthesized tuple type to bare TYPE_ANY (parser.spl paren-type
# branch), so e.g. a tuple-returning extern's declared `(text, text, i32)`
# lost its element types entirely and a destructure of the call result
# defaulted every element local to i64 (parity case process_run_timeout:
# text handles printed as decimal integers). Mirrors the Dict<K,V>/Result
# registries directly above.
val TYPE_TUPLE_BASE: i64 = 3000
val TYPE_TUPLE_LIMIT: i64 = 4000
# Array element-type specializations for element types without their own
# dedicated flat tag (bug: array-class-param-sigsegv). The array-type parser
# (parser.spl's `[T]` branch) only had dedicated flat tags for
# i64/text/bool/Any element types (TYPE_ARRAY_I64/TEXT/BOOL/ANY); a named
# class/struct/enum element (e.g. `[Counter]`) fell through to the default
# and silently became bare TYPE_ARRAY_I64 -- MIR then integer-decoded (>>3)
# class handles read from such arrays into garbage pointers, SIGSEGVing on
# field access. Register the real element tag here (mirrors the
# Dict/Result/Tuple registries above) and encode TYPE_ARRAY_GENERIC_BASE + id
# so the AST bridge can rebuild the true element Type instead of losing it.
# parser.spl currently only routes TYPE_NAMED_BASE+ element tags (real
# struct/class/enum/dyn handles) through this registry -- fixed-width ints
# and Dict/Result/Tuple/Option-as-element are value types, not part of this
# bug, and intentionally keep the pre-existing TYPE_ARRAY_I64 default so
# their encoding stays byte-identical. The registry/predicate functions below
# are general (any i64 tag), so a future writer site could reuse them for a
# different element kind without changing this encoding.
val TYPE_ARRAY_GENERIC_BASE: i64 = 4000
val TYPE_ARRAY_GENERIC_LIMIT: i64 = 5000
# Isolated capability-prefixed type `iso T` (LANE ISO2, doc/08_tracking/bug/
# iso_mut_capability_prefix_not_parsed_2026-07-29.md): like Dict<K,V>/
# Result<T,E>/array-element above, the flat i64 tag space has no room to
# carry a wrapped inner type directly, so `iso T` registers its inner tag
# here and encodes TYPE_ISOLATED_BASE + id. The AST bridge
# (_FlatAstBridge/convert_nodes.spl convert_flat_type) rebuilds the real
# TypeKind.Isolated(inner) from this, which HIR lower_type already lowers to
# HirTypeKind.Isolated.
val TYPE_ISOLATED_BASE: i64 = 5000
val TYPE_ISOLATED_LIMIT: i64 = 6000
# Exclusive capability-prefixed type `mut T`. Keep the wrapped type in the
# flat lane so the bridge can rebuild TypeKind.Reference(T, true) instead of
# erasing the canonical capability annotation.
val TYPE_EXCLUSIVE_BASE: i64 = 6000
val TYPE_EXCLUSIVE_LIMIT: i64 = 7000
# Reference types `&T` and `&mut T`.  Keep immutable and mutable references
# distinct from the capability-prefix spelling `mut T`: both rebuild to
# TypeKind.Reference, but only the latter is intrinsically mutable.
val TYPE_REFERENCE_BASE: i64 = 7000
val TYPE_REFERENCE_LIMIT: i64 = 8000
# Raw/shared pointer types `*T`, `*const T`, and `*mut T`.
val TYPE_POINTER_BASE: i64 = 8000
val TYPE_POINTER_LIMIT: i64 = 9000
# Resource-ownership sigils (WP-B, doc/03_plan/language/resource/
# resource_parallel_agent_plan_2026-08-06.md): atomic ref-counted type `@T`
# and weak-reference type `-T`. Mirror the isolated/exclusive/reference/
# pointer side-registries above -- the flat i64 tag space has no room to
# carry a wrapped inner type directly. 500-wide (half the usual 1000): this
# is the only gap available before TYPE_NAMED_BASE without renumbering it.
val TYPE_ATOMIC_BASE: i64 = 9000
val TYPE_ATOMIC_LIMIT: i64 = 9500
val TYPE_WEAK_BASE: i64 = 9500
val TYPE_WEAK_LIMIT: i64 = 10000
val TYPE_NAMED_BASE: i64 = 10000

# Helper predicates for encoded type tags
fn is_union_tag(tag: i64) -> bool:
    tag >= TYPE_UNION_BASE and tag < TYPE_INTERSECTION_BASE

fn union_tag_to_id(tag: i64) -> i64:
    tag - TYPE_UNION_BASE

fn is_intersection_tag(tag: i64) -> bool:
    tag >= TYPE_INTERSECTION_BASE and tag < TYPE_REFINEMENT_BASE

fn intersection_tag_to_id(tag: i64) -> i64:
    tag - TYPE_INTERSECTION_BASE

fn is_refinement_tag(tag: i64) -> bool:
    tag >= TYPE_REFINEMENT_BASE and tag < TYPE_DICT_BASE

fn refinement_tag_to_id(tag: i64) -> i64:
    tag - TYPE_REFINEMENT_BASE

fn is_dict_tag(tag: i64) -> bool:
    tag >= TYPE_DICT_BASE and tag < TYPE_RESULT_BASE

fn dict_tag_to_id(tag: i64) -> i64:
    tag - TYPE_DICT_BASE

fn is_result_tag(tag: i64) -> bool:
    tag >= TYPE_RESULT_BASE and tag < TYPE_RESULT_LIMIT

fn result_tag_to_id(tag: i64) -> i64:
    tag - TYPE_RESULT_BASE

fn is_tuple_type_tag(tag: i64) -> bool:
    tag >= TYPE_TUPLE_BASE and tag < TYPE_TUPLE_LIMIT

fn tuple_type_tag_to_id(tag: i64) -> i64:
    tag - TYPE_TUPLE_BASE

fn is_option_generic_tag(tag: i64) -> bool:
    tag >= TYPE_OPTION_GENERIC_BASE and tag < TYPE_OPTION_GENERIC_LIMIT

fn option_generic_tag_to_id(tag: i64) -> i64:
    tag - TYPE_OPTION_GENERIC_BASE

fn is_array_generic_tag(tag: i64) -> bool:
    tag >= TYPE_ARRAY_GENERIC_BASE and tag < TYPE_ARRAY_GENERIC_LIMIT

fn array_generic_tag_to_id(tag: i64) -> i64:
    tag - TYPE_ARRAY_GENERIC_BASE

fn is_isolated_tag(tag: i64) -> bool:
    tag >= TYPE_ISOLATED_BASE and tag < TYPE_ISOLATED_LIMIT

fn isolated_tag_to_id(tag: i64) -> i64:
    tag - TYPE_ISOLATED_BASE

fn is_exclusive_tag(tag: i64) -> bool:
    tag >= TYPE_EXCLUSIVE_BASE and tag < TYPE_EXCLUSIVE_LIMIT

fn exclusive_tag_to_id(tag: i64) -> i64:
    tag - TYPE_EXCLUSIVE_BASE

fn is_reference_tag(tag: i64) -> bool:
    tag >= TYPE_REFERENCE_BASE and tag < TYPE_REFERENCE_LIMIT

fn reference_tag_to_id(tag: i64) -> i64:
    tag - TYPE_REFERENCE_BASE

fn is_pointer_tag(tag: i64) -> bool:
    tag >= TYPE_POINTER_BASE and tag < TYPE_POINTER_LIMIT

fn pointer_tag_to_id(tag: i64) -> i64:
    tag - TYPE_POINTER_BASE

fn is_atomic_tag(tag: i64) -> bool:
    tag >= TYPE_ATOMIC_BASE and tag < TYPE_ATOMIC_LIMIT

fn atomic_tag_to_id(tag: i64) -> i64:
    tag - TYPE_ATOMIC_BASE

fn is_weak_tag(tag: i64) -> bool:
    tag >= TYPE_WEAK_BASE and tag < TYPE_WEAK_LIMIT

fn weak_tag_to_id(tag: i64) -> i64:
    tag - TYPE_WEAK_BASE

# Stage-3 imported-module-`val` misread (blocker #7, cd81ef3d85df): a caller in
# ANOTHER module that writes `tag == TYPE_ANY` reads TYPE_ANY as an IMPORTED
# module-level `val`, and under the stage-3/4 self-hosted build that read comes
# back wrong -- the comparison then silently takes the wrong branch with no
# diagnostic. `is_dict_tag`/`is_result_tag`/`is_tuple_type_tag` above are immune
# because they compare against the TYPE_* vals from INSIDE this module, where
# the read is intra-module.
#
# `fixed_type_tag_name` extends that immunity to the fixed low tags 0..33: it
# does the whole comparison here and hands the caller a canonical NAME, so the
# caller dispatches on a text literal and never reads a TYPE_* val across a
# module boundary. Returns "" for anything outside 0..33 (registry-encoded and
# named tags -- the caller keeps using is_dict_tag/is_result_tag/... and
# type_tag_name for those).
#
# The names are the same strings type_tag_name returns for these tags, and are
# API: `_FlatAstBridge/convert_nodes.spl`'s convert_flat_type switches on them.
# Keep the two in sync; this is the ONLY place the fixed tag numbering is
# compared, which is the point -- the previous workaround duplicated the
# numbering as hand-written literal bounds in convert_nodes.spl with nothing
# tying the copies together.
fn fixed_type_tag_name(tag: i64) -> text:
    if tag < TYPE_VOID:
        return ""
    if tag > TYPE_I32:
        return ""
    if tag == TYPE_VOID:
        return "void"
    if tag == TYPE_BOOL:
        return "bool"
    if tag == TYPE_I64:
        return "i64"
    if tag == TYPE_F64:
        return "f64"
    if tag == TYPE_TEXT:
        return "text"
    if tag == TYPE_ARRAY_I64:
        return "[i64]"
    if tag == TYPE_ARRAY_TEXT:
        return "[text]"
    if tag == TYPE_ARRAY_BOOL:
        return "[bool]"
    if tag == TYPE_ARRAY_ANY:
        return "[any]"
    if tag == TYPE_DICT:
        return "dict"
    if tag == TYPE_STRUCT:
        return "struct"
    if tag == TYPE_FN:
        return "fn"
    if tag == TYPE_ANY:
        return "any"
    if tag == TYPE_NIL:
        return "nil"
    if tag == TYPE_OPTION:
        return "Option"
    if tag == TYPE_OPTION_I64:
        return "Option<i64>"
    if tag == TYPE_OPTION_F64:
        return "Option<f64>"
    if tag == TYPE_OPTION_TEXT:
        return "Option<text>"
    if tag == TYPE_OPTION_BOOL:
        return "Option<bool>"
    if tag == TYPE_RESULT:
        return "Result"
    if tag == TYPE_FUTURE:
        return "Future"
    if tag == TYPE_POLL:
        return "Poll"
    if tag == TYPE_TASK:
        return "Task"
    if tag == TYPE_GENERIC_ERASED:
        return "Generic"
    if tag == TYPE_UNION:
        return "Union"
    if tag == TYPE_INTERSECTION:
        return "Intersection"
    if tag == TYPE_REFINEMENT:
        return "Refinement"
    if tag == TYPE_U8:
        return "u8"
    if tag == TYPE_U16:
        return "u16"
    if tag == TYPE_U32:
        return "u32"
    if tag == TYPE_U64:
        return "u64"
    if tag == TYPE_I8:
        return "i8"
    if tag == TYPE_I16:
        return "i16"
    if tag == TYPE_I32:
        return "i32"
    ""

# Same rationale as fixed_type_tag_name: `tag >= TYPE_UNION_BASE` written in an
# importing module is one more cross-module `val` read, and it guards the
# named-type catch-all -- a misread base would divert real expr-arena indices
# into a bogus Named(type_tag_name(idx)) annotation. Compare here instead.
fn is_union_base_or_above(tag: i64) -> bool:
    tag >= TYPE_UNION_BASE

fn type_tag_name(tag: i64) -> text:
    if tag >= TYPE_NAMED_BASE:
        val nid = tag - TYPE_NAMED_BASE
        val nm = named_type_name(nid)
        if nm != "":
            return nm
        return "named_" + int_to_str(nid)
    if tag == TYPE_VOID:
        return "void"
    if tag == TYPE_BOOL:
        return "bool"
    if tag == TYPE_I64:
        return "i64"
    if tag == TYPE_U8:
        return "u8"
    if tag == TYPE_U16:
        return "u16"
    if tag == TYPE_U32:
        return "u32"
    if tag == TYPE_U64:
        return "u64"
    if tag == TYPE_I8:
        return "i8"
    if tag == TYPE_I16:
        return "i16"
    if tag == TYPE_I32:
        return "i32"
    if tag == TYPE_F64:
        return "f64"
    if tag == TYPE_TEXT:
        return "text"
    if tag == TYPE_ARRAY_I64:
        return "[i64]"
    if tag == TYPE_ARRAY_TEXT:
        return "[text]"
    if tag == TYPE_ARRAY_BOOL:
        return "[bool]"
    if tag == TYPE_ARRAY_ANY:
        return "[any]"
    if tag == TYPE_DICT:
        return "dict"
    if tag == TYPE_STRUCT:
        return "struct"
    if tag == TYPE_FN:
        return "fn"
    if tag == TYPE_ANY:
        return "any"
    if tag == TYPE_NIL:
        return "nil"
    if tag == TYPE_OPTION:
        return "Option"
    if tag == TYPE_OPTION_I64:
        return "Option<i64>"
    if tag == TYPE_OPTION_F64:
        return "Option<f64>"
    if tag == TYPE_OPTION_TEXT:
        return "Option<text>"
    if tag == TYPE_OPTION_BOOL:
        return "Option<bool>"
    if tag == TYPE_RESULT:
        return "Result"
    if tag == TYPE_FUTURE:
        return "Future"
    if tag == TYPE_POLL:
        return "Poll"
    if tag == TYPE_TASK:
        return "Task"
    if tag == TYPE_GENERIC_ERASED:
        return "Generic"
    if tag == TYPE_UNION:
        return "Union"
    if tag == TYPE_INTERSECTION:
        return "Intersection"
    if tag == TYPE_REFINEMENT:
        return "Refinement"
    # Encoded union/intersection/refinement ranges
    if is_union_tag(tag):
        val uid = union_tag_to_id(tag)
        val members = union_type_get_members(uid)
        var parts: [text] = []
        for m in members:
            parts.push(type_tag_name(m))
        return parts.join(" | ")
    if is_intersection_tag(tag):
        val iid = intersection_tag_to_id(tag)
        return "Intersection_" + int_to_str(iid)
    if is_refinement_tag(tag):
        val rid = refinement_tag_to_id(tag)
        return "Refinement_" + int_to_str(rid)
    if is_dict_tag(tag):
        val did = dict_tag_to_id(tag)
        val key_name = type_tag_name(dict_type_get_key(did))
        val value_name = type_tag_name(dict_type_get_value(did))
        return "Dict<" + key_name + "," + value_name + ">"
    if is_result_tag(tag):
        val rid = result_tag_to_id(tag)
        return "Result<" + type_tag_name(result_type_get_ok(rid)) + "," + type_tag_name(result_type_get_err(rid)) + ">"
    "unknown"

fn type_tag_to_c(tag: i64) -> text:
    if tag == TYPE_VOID:
        return "void"
    if tag == TYPE_BOOL:
        return "int"
    if tag == TYPE_I64:
        return "int64_t"
    if tag == TYPE_U8:
        return "uint8_t"
    if tag == TYPE_U16:
        return "uint16_t"
    if tag == TYPE_U32:
        return "uint32_t"
    if tag == TYPE_U64:
        return "uint64_t"
    if tag == TYPE_I8:
        return "int8_t"
    if tag == TYPE_I16:
        return "int16_t"
    if tag == TYPE_I32:
        return "int32_t"
    if tag == TYPE_F64:
        return "double"
    if tag == TYPE_TEXT:
        return "const char*"
    if tag == TYPE_ARRAY_I64:
        return "SplArray*"
    if tag == TYPE_ARRAY_TEXT:
        return "SplArray*"
    if tag == TYPE_ARRAY_BOOL:
        return "SplArray*"
    if tag == TYPE_ARRAY_ANY:
        return "SplArray*"
    if tag == TYPE_DICT:
        return "SplDict*"
    if tag == TYPE_STRUCT:
        return "void*"
    if tag == TYPE_FN:
        return "void*"
    if tag == TYPE_ANY:
        return "SplValue"
    if tag == TYPE_NIL:
        return "SplValue"
    if tag == TYPE_OPTION:
        return "SplOption*"
    if tag == TYPE_OPTION_I64:
        return "SplOption*"
    if tag == TYPE_OPTION_F64:
        return "SplOption*"
    if tag == TYPE_OPTION_TEXT:
        return "SplOption*"
    if tag == TYPE_OPTION_BOOL:
        return "SplOption*"
    if tag == TYPE_RESULT:
        return "SplResult*"
    if tag == TYPE_FUTURE:
        return "SplFuture*"
    if tag == TYPE_POLL:
        return "SplPoll*"
    if tag == TYPE_TASK:
        return "SplTask*"
    if tag == TYPE_GENERIC_ERASED:
        return "SplValue"
    if tag == TYPE_UNION:
        return "SplValue"
    if tag == TYPE_INTERSECTION:
        return "SplValue"
    if tag == TYPE_REFINEMENT:
        return "SplValue"
    # Encoded union/intersection/refinement ranges map to SplValue in C
    if is_union_tag(tag):
        return "SplValue"
    if is_intersection_tag(tag):
        return "SplValue"
    if is_refinement_tag(tag):
        return "SplValue"
    if is_dict_tag(tag):
        return "SplDict*"
    if is_result_tag(tag):
        return "SplResult*"
    if tag >= TYPE_NAMED_BASE:
        val nid = tag - TYPE_NAMED_BASE
        val nm = named_type_name(nid)
        if nm != "":
            return nm
        return "int64_t"
    "int64_t"

# ===== Named Type Registry =====
# Maps struct/enum names to their field information.

var named_type_names: [text] = []
var named_type_field_names: [[text]] = []
var named_type_field_types: [[i64]] = []

# Custom primitive registry.
# Newtypes are still constructible single-field structs, but ABI-sensitive
# phases can ask this registry for their transparent primitive representation.
var custom_primitive_names: [text] = []
var custom_primitive_underlying_type_tags: [i64] = []
var custom_primitive_symbol_ids: [i64] = []

fn named_type_register(name: text, field_names: [text], field_types: [i64]) -> i64:
    val existing = named_type_find(name)
    if existing >= 0:
        if field_names.len() > 0 or field_types.len() > 0:
            named_type_update(existing, field_names, field_types)
        return existing
    val idx = named_type_names.len()
    named_type_names.push(name)
    named_type_field_names.push(field_names)
    named_type_field_types.push(field_types)
    idx

fn named_type_update(type_id: i64, field_names: [text], field_types: [i64]):
    named_type_field_names[type_id] = field_names
    named_type_field_types[type_id] = field_types

fn named_type_find(name: text) -> i64:
    var i = 0
    while i < named_type_names.len():
        if named_type_names[i] == name:
            return i
        i = i + 1
    -1

fn named_type_name(type_id: i64) -> text:
    named_type_names[type_id]

fn named_type_fields(type_id: i64) -> [text]:
    named_type_field_names[type_id]

fn named_type_field_type_tags(type_id: i64) -> [i64]:
    named_type_field_types[type_id]

fn primitive_bit_width_from_name(type_name: text) -> i64:
    if type_name == "bool":
        return 1
    if type_name == "i8" or type_name == "u8":
        return 8
    if type_name == "i16" or type_name == "u16":
        return 16
    if type_name == "i32" or type_name == "u32":
        return 32
    if type_name == "i64" or type_name == "u64":
        return 64
    if type_name == "f32":
        return 32
    if type_name == "f64":
        return 64
    0

fn parse_positive_int_text_digits(value: text) -> i64:
    var result: i64 = 0
    if value.len() == 0:
        return 0
    for i in 0..value.len():
        val ch = value[i]
        if ch < "0" or ch > "9":
            return 0
        var digit: i64 = 0
        if ch == "1": digit = 1
        if ch == "2": digit = 2
        if ch == "3": digit = 3
        if ch == "4": digit = 4
        if ch == "5": digit = 5
        if ch == "6": digit = 6
        if ch == "7": digit = 7
        if ch == "8": digit = 8
        if ch == "9": digit = 9
        result = result * 10 + digit
    result

fn primitive_integer_bit_width_from_name(type_name: text) -> i64:
    val has_u_prefix: bool = type_name.starts_with("u")
    val has_i_prefix: bool = type_name.starts_with("i")
    if not (has_u_prefix or has_i_prefix):
        return 0
    if type_name.len() <= 1:
        return 0
    for bi in 1..type_name.len():
        val ch = type_name[bi]
        if ch < "0" or ch > "9":
            return 0
    val bits = parse_positive_int_text_digits(type_name[1:type_name.len()])
    if bits <= 0 or bits > 64:
        return 0
    bits

fn primitive_backing_bits_from_name(type_name: text) -> i64:
    if type_name == "u8":
        return 8
    if type_name == "u16":
        return 16
    if type_name == "u32":
        return 32
    if type_name == "u64":
        return 64
    0

fn custom_primitive_find(name: text) -> i64:
    var i = 0
    while i < custom_primitive_names.len():
        if custom_primitive_names[i] == name:
            return i
        i = i + 1
    -1

fn custom_primitive_register(name: text, underlying_type_tag: i64) -> i64:
    val existing = custom_primitive_find(name)
    if existing >= 0:
        custom_primitive_underlying_type_tags[existing] = underlying_type_tag
        return existing
    val idx = custom_primitive_names.len()
    custom_primitive_names.push(name)
    custom_primitive_underlying_type_tags.push(underlying_type_tag)
    custom_primitive_symbol_ids.push(-1)
    idx

fn custom_primitive_bind_symbol(name: text, symbol_id: i64):
    val idx = custom_primitive_find(name)
    if idx >= 0:
        custom_primitive_symbol_ids[idx] = symbol_id

# Newunit registry.
# `newunit Name: T as suffix` declarations are recorded here at parse time
# (see enum_module_body.spl) so the unit registry builder
# (compiler.types.units.unit_registry) can collect them after parsing.
var newunit_names: [text] = []
var newunit_suffixes: [text] = []
var newunit_underlying_type_tags: [i64] = []

fn newunit_find(name: text) -> i64:
    var i = 0
    while i < newunit_names.len():
        if newunit_names[i] == name:
            return i
        i = i + 1
    -1

fn newunit_register(name: text, suffix: text, underlying_type_tag: i64) -> i64:
    val existing = newunit_find(name)
    if existing >= 0:
        newunit_suffixes[existing] = suffix
        newunit_underlying_type_tags[existing] = underlying_type_tag
        return existing
    val idx = newunit_names.len()
    newunit_names.push(name)
    newunit_suffixes.push(suffix)
    newunit_underlying_type_tags.push(underlying_type_tag)
    idx

fn newunit_count() -> i64:
    newunit_names.len()

fn newunit_name_at(idx: i64) -> text:
    newunit_names[idx]

fn newunit_suffix_at(idx: i64) -> text:
    newunit_suffixes[idx]

fn newunit_underlying_tag_at(idx: i64) -> i64:
    newunit_underlying_type_tags[idx]

fn custom_primitive_is_name(name: text) -> bool:
    custom_primitive_find(name) >= 0

fn custom_primitive_underlying_type_tag_by_name(name: text) -> i64:
    val idx = custom_primitive_find(name)
    if idx < 0:
        return -1
    custom_primitive_underlying_type_tags[idx]

fn custom_primitive_underlying_type_tag_by_symbol(symbol_id: i64) -> i64:
    var i = 0
    while i < custom_primitive_symbol_ids.len():
        if custom_primitive_symbol_ids[i] == symbol_id:
            return custom_primitive_underlying_type_tags[i]
        i = i + 1
    -1

fn custom_primitive_underlying_name_by_name(name: text) -> text:
    val tag = custom_primitive_underlying_type_tag_by_name(name)
    if tag < 0:
        return ""
    type_tag_name(tag)

fn custom_primitive_abi_type_name(type_name: text) -> text:
    val inner = custom_primitive_underlying_name_by_name(type_name)
    if inner == "":
        return type_name
    inner

fn custom_primitive_bit_width_by_name(name: text) -> i64:
    val inner = custom_primitive_underlying_name_by_name(name)
    if inner == "":
        return 0
    primitive_bit_width_from_name(inner)

fn custom_primitive_integer_bit_width_by_name(name: text) -> i64:
    val inner = custom_primitive_underlying_name_by_name(name)
    if inner == "":
        return 0
    if inner == "bool":
        return 1
    primitive_integer_bit_width_from_name(inner)

fn custom_primitive_backing_bits_by_name(name: text) -> i64:
    val inner = custom_primitive_underlying_name_by_name(name)
    if inner == "":
        return 0
    primitive_backing_bits_from_name(inner)

fn custom_primitive_c_type_by_name(name: text) -> text:
    val inner = custom_primitive_underlying_name_by_name(name)
    if inner == "":
        return ""
    type_tag_to_c(custom_primitive_underlying_type_tag_by_name(name))

fn custom_primitive_c_type_by_symbol(symbol_id: i64) -> text:
    val tag = custom_primitive_underlying_type_tag_by_symbol(symbol_id)
    if tag < 0:
        return ""
    type_tag_to_c(tag)

fn custom_primitive_llvm_type_from_tag(tag: i64) -> text:
    if tag == TYPE_BOOL:
        return "i1"
    if tag == TYPE_I64:
        return "i64"
    if tag == TYPE_F64:
        return "double"
    val name = type_tag_name(tag)
    if name == "i8" or name == "u8":
        return "i8"
    if name == "i16" or name == "u16":
        return "i16"
    if name == "i32" or name == "u32":
        return "i32"
    if name == "i64" or name == "u64":
        return "i64"
    if name == "f32":
        return "float"
    if name == "f64":
        return "double"
    ""

fn custom_primitive_llvm_type_by_name(name: text) -> text:
    val tag = custom_primitive_underlying_type_tag_by_name(name)
    if tag < 0:
        return ""
    custom_primitive_llvm_type_from_tag(tag)

fn custom_primitive_llvm_type_by_symbol(symbol_id: i64) -> text:
    val tag = custom_primitive_underlying_type_tag_by_symbol(symbol_id)
    if tag < 0:
        return ""
    custom_primitive_llvm_type_from_tag(tag)

# ===== Function Signature Registry =====
# Tracks function signatures for cross-file resolution and C forward declarations.

var fn_sig_names: [text] = []
var fn_sig_param_names: [[text]] = []
var fn_sig_param_types: [[i64]] = []
var fn_sig_ret_types: [i64] = []
var fn_sig_is_extern: [i64] = []

fn fn_sig_register(name: text, param_names: [text], param_types: [i64], ret_type: i64, is_ext: i64) -> i64:
    val idx = fn_sig_names.len()
    fn_sig_names.push(name)
    fn_sig_param_names.push(param_names)
    fn_sig_param_types.push(param_types)
    fn_sig_ret_types.push(ret_type)
    fn_sig_is_extern.push(is_ext)
    idx

fn fn_sig_find(name: text) -> i64:
    var i = 0
    while i < fn_sig_names.len():
        if fn_sig_names[i] == name:
            return i
        i = i + 1
    -1

fn fn_sig_name(sig_id: i64) -> text:
    fn_sig_names[sig_id]

fn fn_sig_ret_type(sig_id: i64) -> i64:
    fn_sig_ret_types[sig_id]

fn fn_sig_param_count(sig_id: i64) -> i64:
    fn_sig_param_names[sig_id].len()

fn fn_sig_is_extern_fn(sig_id: i64) -> bool:
    fn_sig_is_extern[sig_id] == 1

fn fn_sig_get_param_names(sig_id: i64) -> [text]:
    fn_sig_param_names[sig_id]

fn fn_sig_get_param_types(sig_id: i64) -> [i64]:
    fn_sig_param_types[sig_id]

# ===== Generic Parameter Registry =====
# Tracks type parameters for generic classes and functions.
# Each entry represents a type parameter (T, U, K, V, etc.)

var generic_param_names: [text] = []
var generic_param_contexts: [text] = []
var generic_param_ids: [i64] = []

fn generic_param_register(name: text, context: text) -> i64:
    val idx = generic_param_names.len()
    generic_param_names.push(name)
    generic_param_contexts.push(context)
    generic_param_ids.push(idx)
    idx

fn generic_param_find(name: text, context: text) -> i64:
    var i = 0
    while i < generic_param_names.len():
        if (generic_param_names[i] == name and
            generic_param_contexts[i] == context):
            return i
        i = i + 1
    -1

fn generic_param_name(param_id: i64) -> text:
    generic_param_names[param_id]

fn generic_param_context(param_id: i64) -> text:
    generic_param_contexts[param_id]

fn generic_param_count() -> i64:
    generic_param_names.len()

# ===== Union Type Registry =====
# Tracks union types (A | B | C)

var union_type_members: [[i64]] = []

fn type_tag_list_find(items: [[i64]], target: [i64]) -> i64:
    var i = 0
    while i < items.len():
        val item = items[i]
        if item.len() == target.len():
            var j = 0
            while j < target.len() and item[j] == target[j]:
                j = j + 1
            if j == target.len():
                return i
        i = i + 1
    -1

fn type_tag_pair_find(firsts: [i64], seconds: [i64], first: i64, second: i64) -> i64:
    var i = 0
    while i < firsts.len():
        if firsts[i] == first and seconds[i] == second:
            return i
        i = i + 1
    -1

fn union_type_register(member_types: [i64]) -> i64:
    val existing = type_tag_list_find(union_type_members, member_types)
    if existing >= 0:
        return TYPE_UNION_BASE + existing
    val idx = union_type_members.len()
    if idx >= TYPE_INTERSECTION_BASE - TYPE_UNION_BASE:
        return -1
    union_type_members.push(member_types)
    TYPE_UNION_BASE + idx

fn union_type_get_members(union_id: i64) -> [i64]:
    if union_id >= 0 and union_id < union_type_members.len():
        return union_type_members[union_id]
    []

# ===== Tuple Type Registry =====
# Tracks tuple type annotations `(A, B, C)` -- see TYPE_TUPLE_BASE.

var tuple_type_elem_tags: [[i64]] = []

fn tuple_type_register(elem_types: [i64]) -> i64:
    val existing = type_tag_list_find(tuple_type_elem_tags, elem_types)
    if existing >= 0:
        return TYPE_TUPLE_BASE + existing
    val idx = tuple_type_elem_tags.len()
    if idx >= TYPE_TUPLE_LIMIT - TYPE_TUPLE_BASE:
        return -1
    tuple_type_elem_tags.push(elem_types)
    TYPE_TUPLE_BASE + idx

fn tuple_type_get_elems(tuple_id: i64) -> [i64]:
    if tuple_id >= 0 and tuple_id < tuple_type_elem_tags.len():
        return tuple_type_elem_tags[tuple_id]
    []

# ===== Intersection Type Registry =====
# Tracks intersection types (A & B & C)

var intersection_type_members: [[i64]] = []

fn intersection_type_register(member_types: [i64]) -> i64:
    val existing = type_tag_list_find(intersection_type_members, member_types)
    if existing >= 0:
        return TYPE_INTERSECTION_BASE + existing
    val idx = intersection_type_members.len()
    if idx >= TYPE_REFINEMENT_BASE - TYPE_INTERSECTION_BASE:
        return -1
    intersection_type_members.push(member_types)
    TYPE_INTERSECTION_BASE + idx

fn intersection_type_get_members(inter_id: i64) -> [i64]:
    if inter_id >= 0 and inter_id < intersection_type_members.len():
        return intersection_type_members[inter_id]
    []

# ===== Refinement Type Registry =====
# Tracks refinement types (x: i64 where x > 0)

var refinement_base_types: [i64] = []
var refinement_predicates: [text] = []

fn refinement_type_register(base_type: i64, predicate: text) -> i64:
    var existing = 0
    while existing < refinement_base_types.len():
        if refinement_base_types[existing] == base_type and refinement_predicates[existing] == predicate:
            return TYPE_REFINEMENT_BASE + existing
        existing = existing + 1
    val idx = refinement_base_types.len()
    if idx >= TYPE_DICT_BASE - TYPE_REFINEMENT_BASE:
        return -1
    refinement_base_types.push(base_type)
    refinement_predicates.push(predicate)
    TYPE_REFINEMENT_BASE + idx

fn refinement_type_base(ref_id: i64) -> i64:
    if ref_id >= 0 and ref_id < refinement_base_types.len():
        return refinement_base_types[ref_id]
    TYPE_ANY

fn refinement_type_predicate(ref_id: i64) -> text:
    if ref_id >= 0 and ref_id < refinement_predicates.len():
        return refinement_predicates[ref_id]
    ""

# ===== Dict Specialization Registry =====
# Tracks Dict<K,V> generic-arg specializations (bug: dicttype). Each distinct
# Dict<K,V> annotation registers its key/value tags and is referenced later
# (AST bridge, HIR lowering) via the encoded TYPE_DICT_BASE + id tag.

var dict_type_keys: [i64] = []
var dict_type_values: [i64] = []

fn dict_type_register(key_tag: i64, value_tag: i64) -> i64:
    val existing = type_tag_pair_find(dict_type_keys, dict_type_values, key_tag, value_tag)
    if existing >= 0:
        return TYPE_DICT_BASE + existing
    val idx = dict_type_keys.len()
    if idx >= TYPE_RESULT_BASE - TYPE_DICT_BASE:
        return -1
    dict_type_keys.push(key_tag)
    dict_type_values.push(value_tag)
    TYPE_DICT_BASE + idx

fn dict_type_get_key(dict_id: i64) -> i64:
    if dict_id >= 0 and dict_id < dict_type_keys.len():
        return dict_type_keys[dict_id]
    TYPE_ANY

fn dict_type_get_value(dict_id: i64) -> i64:
    if dict_id >= 0 and dict_id < dict_type_values.len():
        return dict_type_values[dict_id]
    TYPE_ANY

# ===== Result Specialization Registry =====

var result_type_ok: [i64] = []
var result_type_err: [i64] = []

fn result_type_register(ok_tag: i64, err_tag: i64) -> i64:
    val existing = type_tag_pair_find(result_type_ok, result_type_err, ok_tag, err_tag)
    if existing >= 0:
        return TYPE_RESULT_BASE + existing
    val idx = result_type_ok.len()
    if idx >= TYPE_RESULT_LIMIT - TYPE_RESULT_BASE:
        return -1
    result_type_ok.push(ok_tag)
    result_type_err.push(err_tag)
    TYPE_RESULT_BASE + idx

fn result_type_get_ok(result_id: i64) -> i64:
    if result_id >= 0 and result_id < result_type_ok.len():
        return result_type_ok[result_id]
    TYPE_ANY

fn result_type_get_err(result_id: i64) -> i64:
    if result_id >= 0 and result_id < result_type_err.len():
        return result_type_err[result_id]
    TYPE_ANY

# ===== Array Element-Type Specialization Registry =====
# Tracks array element types with no dedicated flat tag (bug:
# array-class-param-sigsegv) -- see TYPE_ARRAY_GENERIC_BASE.

var array_generic_elem_tags: [i64] = []

# ===== Option Inner-Type Specialization Registry =====
# Tracks Option<T> inner types with no dedicated flat tag (bug:
# native_option_unwrap_receiver_unresolved_2026-08-09) -- see
# TYPE_OPTION_GENERIC_BASE.

var option_generic_inner_tags: [i64] = []

fn option_generic_type_register(inner_tag: i64) -> i64:
    var existing = 0
    while existing < option_generic_inner_tags.len():
        if option_generic_inner_tags[existing] == inner_tag:
            return TYPE_OPTION_GENERIC_BASE + existing
        existing = existing + 1
    val idx = option_generic_inner_tags.len()
    if idx >= TYPE_OPTION_GENERIC_LIMIT - TYPE_OPTION_GENERIC_BASE:
        return -1
    option_generic_inner_tags.push(inner_tag)
    TYPE_OPTION_GENERIC_BASE + idx

fn option_generic_type_get_inner(option_id: i64) -> i64:
    if option_id >= 0 and option_id < option_generic_inner_tags.len():
        return option_generic_inner_tags[option_id]
    TYPE_ANY

fn array_generic_type_register(elem_tag: i64) -> i64:
    var existing = 0
    while existing < array_generic_elem_tags.len():
        if array_generic_elem_tags[existing] == elem_tag:
            return TYPE_ARRAY_GENERIC_BASE + existing
        existing = existing + 1
    val idx = array_generic_elem_tags.len()
    if idx >= TYPE_ARRAY_GENERIC_LIMIT - TYPE_ARRAY_GENERIC_BASE:
        return -1
    array_generic_elem_tags.push(elem_tag)
    TYPE_ARRAY_GENERIC_BASE + idx

fn array_generic_type_get_elem(arr_id: i64) -> i64:
    if arr_id >= 0 and arr_id < array_generic_elem_tags.len():
        return array_generic_elem_tags[arr_id]
    TYPE_ANY

# ===== Isolated Capability Type Registry =====
# Tracks `iso T` inner types (LANE ISO2, doc/08_tracking/bug/
# iso_mut_capability_prefix_not_parsed_2026-07-29.md) -- see
# TYPE_ISOLATED_BASE. Mirrors the array-element registry directly above.

var isolated_inner_tags: [i64] = []

fn isolated_type_register(inner_tag: i64) -> i64:
    var existing = 0
    while existing < isolated_inner_tags.len():
        if isolated_inner_tags[existing] == inner_tag:
            return TYPE_ISOLATED_BASE + existing
        existing = existing + 1
    val idx = isolated_inner_tags.len()
    if idx >= TYPE_ISOLATED_LIMIT - TYPE_ISOLATED_BASE:
        return -1
    isolated_inner_tags.push(inner_tag)
    TYPE_ISOLATED_BASE + idx

fn isolated_type_get_inner(iso_id: i64) -> i64:
    if iso_id >= 0 and iso_id < isolated_inner_tags.len():
        return isolated_inner_tags[iso_id]
    TYPE_ANY

# ===== Exclusive Capability Type Registry =====

var exclusive_inner_tags: [i64] = []

fn exclusive_type_register(inner_tag: i64) -> i64:
    var existing = 0
    while existing < exclusive_inner_tags.len():
        if exclusive_inner_tags[existing] == inner_tag:
            return TYPE_EXCLUSIVE_BASE + existing
        existing = existing + 1
    val idx = exclusive_inner_tags.len()
    if idx >= TYPE_EXCLUSIVE_LIMIT - TYPE_EXCLUSIVE_BASE:
        return -1
    exclusive_inner_tags.push(inner_tag)
    TYPE_EXCLUSIVE_BASE + idx

fn exclusive_type_get_inner(exclusive_id: i64) -> i64:
    if exclusive_id >= 0 and exclusive_id < exclusive_inner_tags.len():
        return exclusive_inner_tags[exclusive_id]
    TYPE_ANY

# ===== Reference Type Registry =====

var reference_inner_tags: [i64] = []
var reference_mutable_flags: [i64] = []

fn reference_type_register(inner_tag: i64, mutable: bool) -> i64:
    val mutable_flag: i64 = if mutable: 1 else: 0
    var existing = 0
    while existing < reference_inner_tags.len():
        if reference_inner_tags[existing] == inner_tag and reference_mutable_flags[existing] == mutable_flag:
            return TYPE_REFERENCE_BASE + existing
        existing = existing + 1
    val idx = reference_inner_tags.len()
    if idx >= TYPE_REFERENCE_LIMIT - TYPE_REFERENCE_BASE:
        return -1
    reference_inner_tags.push(inner_tag)
    reference_mutable_flags.push(mutable_flag)
    TYPE_REFERENCE_BASE + idx

fn reference_type_get_inner(reference_id: i64) -> i64:
    if reference_id >= 0 and reference_id < reference_inner_tags.len():
        return reference_inner_tags[reference_id]
    TYPE_ANY

fn reference_type_is_mutable(reference_id: i64) -> bool:
    if reference_id >= 0 and reference_id < reference_mutable_flags.len():
        return reference_mutable_flags[reference_id] != 0
    false

# ===== Pointer Type Registry =====

var pointer_inner_tags: [i64] = []
var pointer_mutable_flags: [i64] = []

fn pointer_type_register(inner_tag: i64, mutable: bool) -> i64:
    val mutable_flag: i64 = if mutable: 1 else: 0
    var existing = 0
    while existing < pointer_inner_tags.len():
        if pointer_inner_tags[existing] == inner_tag and pointer_mutable_flags[existing] == mutable_flag:
            return TYPE_POINTER_BASE + existing
        existing = existing + 1
    val idx = pointer_inner_tags.len()
    if idx >= TYPE_POINTER_LIMIT - TYPE_POINTER_BASE:
        return -1
    pointer_inner_tags.push(inner_tag)
    pointer_mutable_flags.push(mutable_flag)
    TYPE_POINTER_BASE + idx

fn pointer_type_get_inner(pointer_id: i64) -> i64:
    if pointer_id >= 0 and pointer_id < pointer_inner_tags.len():
        return pointer_inner_tags[pointer_id]
    TYPE_ANY

fn pointer_type_is_mutable(pointer_id: i64) -> bool:
    if pointer_id >= 0 and pointer_id < pointer_mutable_flags.len():
        return pointer_mutable_flags[pointer_id] != 0
    false

# ===== Atomic RC Type Registry =====
# `@T` -- atomic reference-counted sharing sigil (WP-B). Mirrors the
# isolated-type registry directly above.

var atomic_inner_tags: [i64] = []

fn atomic_type_register(inner_tag: i64) -> i64:
    var existing = 0
    while existing < atomic_inner_tags.len():
        if atomic_inner_tags[existing] == inner_tag:
            return TYPE_ATOMIC_BASE + existing
        existing = existing + 1
    val idx = atomic_inner_tags.len()
    if idx >= TYPE_ATOMIC_LIMIT - TYPE_ATOMIC_BASE:
        return -1
    atomic_inner_tags.push(inner_tag)
    TYPE_ATOMIC_BASE + idx

fn atomic_type_get_inner(atomic_id: i64) -> i64:
    if atomic_id >= 0 and atomic_id < atomic_inner_tags.len():
        return atomic_inner_tags[atomic_id]
    TYPE_ANY

# ===== Weak Reference Type Registry =====
# `-T` -- weak-reference sigil (WP-B). Mirrors the isolated-type registry
# above.

var weak_inner_tags: [i64] = []

fn weak_type_register(inner_tag: i64) -> i64:
    var existing = 0
    while existing < weak_inner_tags.len():
        if weak_inner_tags[existing] == inner_tag:
            return TYPE_WEAK_BASE + existing
        existing = existing + 1
    val idx = weak_inner_tags.len()
    if idx >= TYPE_WEAK_LIMIT - TYPE_WEAK_BASE:
        return -1
    weak_inner_tags.push(inner_tag)
    TYPE_WEAK_BASE + idx

fn weak_type_get_inner(weak_id: i64) -> i64:
    if weak_id >= 0 and weak_id < weak_inner_tags.len():
        return weak_inner_tags[weak_id]
    TYPE_ANY

# ===== Pool Reset =====
# Call before parsing a new file to reset all pools.

fn clear_i64_pool(pool: [i64]) -> [i64]:
    if pool == nil:
        return []
    pool.clear()
    pool

fn clear_text_pool(pool: [text]) -> [text]:
    if pool == nil:
        return []
    pool.clear()
    pool

fn clear_i64_list_pool(pool: [[i64]]) -> [[i64]]:
    if pool == nil:
        return []
    pool.clear()
    pool

fn clear_text_list_pool(pool: [[text]]) -> [[text]]:
    if pool == nil:
        return []
    pool.clear()
    pool

fn reset_all_pools():
    span_pool_start = clear_i64_pool(span_pool_start)
    span_pool_end = clear_i64_pool(span_pool_end)
    span_pool_line = clear_i64_pool(span_pool_line)
    span_pool_col = clear_i64_pool(span_pool_col)
    tok_pool_kind = clear_i64_pool(tok_pool_kind)
    tok_pool_span = clear_i64_pool(tok_pool_span)
    tok_pool_text = clear_text_pool(tok_pool_text)
    sym_names = clear_text_pool(sym_names)
    sym_types = clear_i64_pool(sym_types)
    sym_depths = clear_i64_pool(sym_depths)
    sym_decl_ids = clear_i64_pool(sym_decl_ids)
    sym_mutable = clear_i64_pool(sym_mutable)
    scope_starts = clear_i64_pool(scope_starts)
    current_scope_depth = 0
    named_type_names = clear_text_pool(named_type_names)
    named_type_field_names = clear_text_list_pool(named_type_field_names)
    named_type_field_types = clear_i64_list_pool(named_type_field_types)
    custom_primitive_names = clear_text_pool(custom_primitive_names)
    custom_primitive_underlying_type_tags = clear_i64_pool(custom_primitive_underlying_type_tags)
    custom_primitive_symbol_ids = clear_i64_pool(custom_primitive_symbol_ids)
    fn_sig_names = clear_text_pool(fn_sig_names)
    fn_sig_param_names = clear_text_list_pool(fn_sig_param_names)
    fn_sig_param_types = clear_i64_list_pool(fn_sig_param_types)
    fn_sig_ret_types = clear_i64_pool(fn_sig_ret_types)
    fn_sig_is_extern = clear_i64_pool(fn_sig_is_extern)
    generic_param_names = clear_text_pool(generic_param_names)
    generic_param_contexts = clear_text_pool(generic_param_contexts)
    generic_param_ids = clear_i64_pool(generic_param_ids)
    union_type_members = clear_i64_list_pool(union_type_members)
    tuple_type_elem_tags = clear_i64_list_pool(tuple_type_elem_tags)
    intersection_type_members = clear_i64_list_pool(intersection_type_members)
    refinement_base_types = clear_i64_pool(refinement_base_types)
    refinement_predicates = clear_text_pool(refinement_predicates)
    dict_type_keys = clear_i64_pool(dict_type_keys)
    dict_type_values = clear_i64_pool(dict_type_values)
    result_type_ok = clear_i64_pool(result_type_ok)
    result_type_err = clear_i64_pool(result_type_err)
    array_generic_elem_tags = clear_i64_pool(array_generic_elem_tags)
    option_generic_inner_tags = clear_i64_pool(option_generic_inner_tags)
    isolated_inner_tags = clear_i64_pool(isolated_inner_tags)
    exclusive_inner_tags = clear_i64_pool(exclusive_inner_tags)
    reference_inner_tags = clear_i64_pool(reference_inner_tags)
    reference_mutable_flags = clear_i64_pool(reference_mutable_flags)
    pointer_inner_tags = clear_i64_pool(pointer_inner_tags)
    pointer_mutable_flags = clear_i64_pool(pointer_mutable_flags)
    atomic_inner_tags = clear_i64_pool(atomic_inner_tags)
    weak_inner_tags = clear_i64_pool(weak_inner_tags)

