# --- flat-AST pool codec: flat_type ------------------------------
#
# Dump/restore for this file's 52 pools, in a FIXED SORTED ORDER that
# dump and restore share. Order is the whole contract: the blob carries no
# pool names, so a reordering on one side silently pairs each pool with its
# neighbour's data. Sorting by name keeps the two sides in step.
#
# current_scope_depth is scalar state that reset_all_pools also resets, so it
# rides along at the end of the blob. It cannot appear in an array-derived
# pool list, so the completeness guard cannot see it -- hence this note.

pub fn flat_type_pools_dump() -> text:
    # Sub-blobs are collected and joined once. `out = out + <sub-blob>` across
    # ~165 pools re-copied the whole growing multi-megabyte blob on every pool,
    # which is quadratic in the pool count and paid on every cache-MISS store.
    # The bytes emitted are unchanged: the same pieces, in the same order.
    # doc/08_tracking/bug/frontend_shard_and_cache_hit_cost_2026-08-21.md
    var parts: [text] = []
    parts = parts.push(flat_pool_enc_i64(array_generic_elem_tags))
    parts = parts.push(flat_pool_enc_i64(atomic_inner_tags))
    parts = parts.push(flat_pool_enc_text(custom_primitive_names))
    # HIR SymbolIds bound after the parse (custom_primitive_bind_symbol): always
    # the -1 placeholder at capture and process-local once bound. Never stored.
    flat_pool_type_trace_clear_next_v1()
    parts = parts.push(flat_pool_enc_i64(custom_primitive_symbol_ids))
    parts = parts.push(flat_pool_enc_i64(custom_primitive_underlying_type_tags))
    parts = parts.push(flat_pool_enc_i64(dict_type_keys))
    parts = parts.push(flat_pool_enc_i64(dict_type_values))
    parts = parts.push(flat_pool_enc_i64(exclusive_inner_tags))
    parts = parts.push(flat_pool_enc_i64(fn_sig_is_extern))
    parts = parts.push(flat_pool_enc_text(fn_sig_names))
    parts = parts.push(flat_pool_enc_text_list(fn_sig_param_names))
    parts = parts.push(flat_pool_enc_i64_list(fn_sig_param_types))
    parts = parts.push(flat_pool_enc_i64(fn_sig_ret_types))
    parts = parts.push(flat_pool_enc_i64_list(function_param_tags))
    parts = parts.push(flat_pool_enc_i64(function_ret_tags))
    parts = parts.push(flat_pool_enc_text(generic_param_contexts))
    parts = parts.push(flat_pool_enc_i64(generic_param_ids))
    parts = parts.push(flat_pool_enc_text(generic_param_names))
    parts = parts.push(flat_pool_enc_i64_list(intersection_type_members))
    parts = parts.push(flat_pool_enc_i64(isolated_inner_tags))
    parts = parts.push(flat_pool_enc_i64_list(named_generic_instance_args))
    parts = parts.push(flat_pool_enc_text(named_generic_instance_bases))
    parts = parts.push(flat_pool_enc_i64(named_generic_instance_ids))
    parts = parts.push(flat_pool_enc_text_list(named_type_field_names))
    parts = parts.push(flat_pool_enc_i64_list(named_type_field_types))
    parts = parts.push(flat_pool_enc_text(named_type_names))
    parts = parts.push(flat_pool_enc_i64_list(named_type_arguments))
    parts = parts.push(flat_pool_enc_i64(named_type_layout_owners))
    parts = parts.push(flat_pool_enc_text(newunit_names))
    parts = parts.push(flat_pool_enc_text(newunit_suffixes))
    parts = parts.push(flat_pool_enc_i64(newunit_underlying_type_tags))
    parts = parts.push(flat_pool_enc_i64(option_generic_inner_tags))
    parts = parts.push(flat_pool_enc_i64(pointer_inner_tags))
    parts = parts.push(flat_pool_enc_i64(pointer_mutable_flags))
    parts = parts.push(flat_pool_enc_i64(reference_inner_tags))
    parts = parts.push(flat_pool_enc_i64(reference_mutable_flags))
    parts = parts.push(flat_pool_enc_i64(refinement_base_types))
    parts = parts.push(flat_pool_enc_text(refinement_predicates))
    parts = parts.push(flat_pool_enc_i64(result_type_err))
    parts = parts.push(flat_pool_enc_i64(result_type_ok))
    parts = parts.push(flat_pool_enc_i64(scope_starts))
    parts = parts.push(flat_pool_enc_i64(span_pool_col))
    parts = parts.push(flat_pool_enc_i64(span_pool_end))
    parts = parts.push(flat_pool_enc_i64(span_pool_line))
    parts = parts.push(flat_pool_enc_i64(span_pool_start))
    parts = parts.push(flat_pool_enc_i64(sym_decl_ids))
    parts = parts.push(flat_pool_enc_i64(sym_depths))
    parts = parts.push(flat_pool_enc_i64(sym_mutable))
    parts = parts.push(flat_pool_enc_text(sym_names))
    parts = parts.push(flat_pool_enc_i64(sym_types))
    parts = parts.push(flat_pool_enc_i64(tok_pool_kind))
    parts = parts.push(flat_pool_enc_i64(tok_pool_span))
    parts = parts.push(flat_pool_enc_text(tok_pool_text))
    parts = parts.push(flat_pool_enc_i64_list(tuple_type_elem_tags))
    parts = parts.push(flat_pool_enc_i64_list(union_type_members))
    parts = parts.push(flat_pool_enc_i64(weak_inner_tags))
    parts = parts.push(flat_pool_enc_scalar_i64(current_scope_depth))
    parts.join("")

fn named_type_argument_graph_valid(
    root: i64, owner_tag: i64, imported_index_by_type: [i64]
) -> bool:
    # Applications may reference earlier named entries through any wrapper
    # registry. Checking only the immediate tag misses Option<Self> cycles.
    # This iterative validation bounds both work and scratch storage at 4096
    # edges per argument and type depth 128, including wrapper-only cycles.
    var pending: [i64] = [root]
    var depths: [i64] = [1]
    var position = 0
    while position < pending.len():
        val tag = pending[position]
        val depth = depths[position]
        position = position + 1
        if tag < 0 or depth > 128: return false
        var children: [i64] = []
        if tag >= TYPE_NAMED_BASE:
            if tag >= owner_tag: return false
            val type_index = tag - TYPE_NAMED_BASE
            if type_index >= imported_index_by_type.len(): return false
            if imported_index_by_type[type_index] >= 0:
                val instance_index = imported_index_by_type[type_index]
                children = named_generic_instance_args[instance_index]
            else:
                if type_index >= named_type_arguments.len(): return false
                children = named_type_arguments[type_index]
        elif is_function_tag(tag):
            val function_id = function_tag_to_id(tag)
            if not function_type_known(function_id): return false
            # Build a fresh child list rather than appending to the registry's
            # parameter array returned by function_type_get_params.
            for parameter_tag in function_type_get_params(function_id):
                children.push(parameter_tag)
            children.push(function_type_get_ret(function_id))
        elif is_option_generic_tag(tag):
            val index = option_generic_tag_to_id(tag)
            if index >= option_generic_inner_tags.len(): return false
            children = [option_generic_inner_tags[index]]
        elif is_array_generic_tag(tag):
            val index = array_generic_tag_to_id(tag)
            if index >= array_generic_elem_tags.len(): return false
            children = [array_generic_elem_tags[index]]
        elif is_dict_tag(tag):
            val index = dict_tag_to_id(tag)
            if index >= dict_type_keys.len() or index >= dict_type_values.len(): return false
            children = [dict_type_keys[index], dict_type_values[index]]
        elif is_result_tag(tag):
            val index = result_tag_to_id(tag)
            if index >= result_type_ok.len() or index >= result_type_err.len(): return false
            children = [result_type_ok[index], result_type_err[index]]
        elif is_tuple_type_tag(tag):
            val index = tuple_type_tag_to_id(tag)
            if index >= tuple_type_elem_tags.len(): return false
            children = tuple_type_elem_tags[index]
        elif is_union_tag(tag):
            val index = union_tag_to_id(tag)
            if index >= union_type_members.len(): return false
            children = union_type_members[index]
        elif is_intersection_tag(tag):
            val index = intersection_tag_to_id(tag)
            if index >= intersection_type_members.len(): return false
            children = intersection_type_members[index]
        elif is_refinement_tag(tag):
            val index = refinement_tag_to_id(tag)
            if index >= refinement_base_types.len(): return false
            children = [refinement_base_types[index]]
        elif is_isolated_tag(tag):
            val index = isolated_tag_to_id(tag)
            if index >= isolated_inner_tags.len(): return false
            children = [isolated_inner_tags[index]]
        elif is_exclusive_tag(tag):
            val index = exclusive_tag_to_id(tag)
            if index >= exclusive_inner_tags.len(): return false
            children = [exclusive_inner_tags[index]]
        elif is_reference_tag(tag):
            val index = reference_tag_to_id(tag)
            if index >= reference_inner_tags.len(): return false
            children = [reference_inner_tags[index]]
        elif is_pointer_tag(tag):
            val index = pointer_tag_to_id(tag)
            if index >= pointer_inner_tags.len(): return false
            children = [pointer_inner_tags[index]]
        elif is_atomic_tag(tag):
            val index = atomic_tag_to_id(tag)
            if index >= atomic_inner_tags.len(): return false
            children = [atomic_inner_tags[index]]
        elif is_weak_tag(tag):
            val index = weak_tag_to_id(tag)
            if index >= weak_inner_tags.len(): return false
            children = [weak_inner_tags[index]]
        if pending.len() + children.len() > 4096: return false
        for child in children:
            pending.push(child)
            depths.push(depth + 1)
    true

# Returns false when the blob ran short or was malformed; the caller must
# treat that as a cache MISS and reparse, never as an empty parse.
pub fn flat_type_pools_restore(r: FlatPoolReader) -> bool:
    array_generic_elem_tags = flat_pool_dec_i64(r)
    atomic_inner_tags = flat_pool_dec_i64(r)
    custom_primitive_names = flat_pool_dec_text(r)
    custom_primitive_symbol_ids = flat_pool_dec_i64(r)
    custom_primitive_underlying_type_tags = flat_pool_dec_i64(r)
    dict_type_keys = flat_pool_dec_i64(r)
    dict_type_values = flat_pool_dec_i64(r)
    exclusive_inner_tags = flat_pool_dec_i64(r)
    fn_sig_is_extern = flat_pool_dec_i64(r)
    fn_sig_names = flat_pool_dec_text(r)
    fn_sig_param_names = flat_pool_dec_text_list(r)
    fn_sig_param_types = flat_pool_dec_i64_list(r)
    fn_sig_ret_types = flat_pool_dec_i64(r)
    function_param_tags = flat_pool_dec_i64_list(r)
    function_ret_tags = flat_pool_dec_i64(r)
    generic_param_contexts = flat_pool_dec_text(r)
    generic_param_ids = flat_pool_dec_i64(r)
    generic_param_names = flat_pool_dec_text(r)
    intersection_type_members = flat_pool_dec_i64_list(r)
    isolated_inner_tags = flat_pool_dec_i64(r)
    named_generic_instance_args = flat_pool_dec_i64_list(r)
    named_generic_instance_bases = flat_pool_dec_text(r)
    named_generic_instance_ids = flat_pool_dec_i64(r)
    named_type_field_names = flat_pool_dec_text_list(r)
    named_type_field_types = flat_pool_dec_i64_list(r)
    named_type_names = flat_pool_dec_text(r)
    named_type_arguments = flat_pool_dec_i64_list(r)
    named_type_layout_owners = flat_pool_dec_i64(r)
    newunit_names = flat_pool_dec_text(r)
    newunit_suffixes = flat_pool_dec_text(r)
    newunit_underlying_type_tags = flat_pool_dec_i64(r)
    option_generic_inner_tags = flat_pool_dec_i64(r)
    pointer_inner_tags = flat_pool_dec_i64(r)
    pointer_mutable_flags = flat_pool_dec_i64(r)
    reference_inner_tags = flat_pool_dec_i64(r)
    reference_mutable_flags = flat_pool_dec_i64(r)
    refinement_base_types = flat_pool_dec_i64(r)
    refinement_predicates = flat_pool_dec_text(r)
    result_type_err = flat_pool_dec_i64(r)
    result_type_ok = flat_pool_dec_i64(r)
    scope_starts = flat_pool_dec_i64(r)
    span_pool_col = flat_pool_dec_i64(r)
    span_pool_end = flat_pool_dec_i64(r)
    span_pool_line = flat_pool_dec_i64(r)
    span_pool_start = flat_pool_dec_i64(r)
    sym_decl_ids = flat_pool_dec_i64(r)
    sym_depths = flat_pool_dec_i64(r)
    sym_mutable = flat_pool_dec_i64(r)
    sym_names = flat_pool_dec_text(r)
    sym_types = flat_pool_dec_i64(r)
    tok_pool_kind = flat_pool_dec_i64(r)
    tok_pool_span = flat_pool_dec_i64(r)
    tok_pool_text = flat_pool_dec_text(r)
    tuple_type_elem_tags = flat_pool_dec_i64_list(r)
    union_type_members = flat_pool_dec_i64_list(r)
    weak_inner_tags = flat_pool_dec_i64(r)
    current_scope_depth = r.next_i64()
    # The interned fn-type pools are parallel arrays; a length mismatch is a
    # torn blob and must be refused, not half-restored.
    if function_param_tags.len() != function_ret_tags.len():
        return false
    if not r.ok or named_type_arguments.len() != named_type_names.len() or
            named_type_layout_owners.len() != named_type_names.len():
        return false
    if named_generic_instance_ids.len() != named_generic_instance_bases.len() or
            named_generic_instance_ids.len() != named_generic_instance_args.len():
        return false
    var imported_index_by_type: [i64] = []
    for _ in 0..named_type_names.len():
        imported_index_by_type.push(-1)
    var seen_instance_keys: Dict<text, bool> = {}
    for i in 0..named_generic_instance_ids.len():
        val type_index = named_generic_instance_ids[i]
        if type_index < 0 or type_index >= named_type_names.len(): return false
        if imported_index_by_type[type_index] >= 0: return false
        val base = named_generic_instance_bases[i]
        if base == "": return false
        val key = named_generic_instance_key(base, named_generic_instance_args[i])
        if named_type_names[type_index] != key: return false
        if named_type_layout_owners[type_index] != type_index: return false
        if seen_instance_keys.has(key): return false
        seen_instance_keys[key] = true
        imported_index_by_type[type_index] = i
    # Parsed type applications reference previously allocated owners/arguments.
    # Reject corrupt forward/self references before recursive AST conversion.
    for i in 0..named_type_arguments.len():
        val owner = named_type_layout_owners[i]
        if owner < 0 or owner > i or named_type_layout_owners[owner] != owner or
                named_type_names[owner] != named_type_names[i]:
            return false
        for argument in named_type_arguments[i]:
            if not named_type_argument_graph_valid(
                    argument, TYPE_NAMED_BASE + i, imported_index_by_type):
                return false
    for i in 0..named_generic_instance_ids.len():
        val owner_tag = TYPE_NAMED_BASE + named_generic_instance_ids[i]
        for argument in named_generic_instance_args[i]:
            if not named_type_argument_graph_valid(argument, owner_tag, imported_index_by_type):
                return false
    true

# Live line chunks of this family's CLEAR pools, in dump order (see
# flat_decl_pools_clear_chunks_v1).
pub fn flat_type_pools_clear_chunks_v1() -> [text]:
    [flat_pool_enc_i64(custom_primitive_symbol_ids)]

export flat_type_pools_dump, flat_type_pools_restore, flat_type_pools_clear_chunks_v1
export named_type_apply, named_type_arguments_for_tag

# ===== Flat-pool context snapshot (ParseContext stage 1) =====
# See doc/05_design/compiler/frontend/parse_context_per_context_state.md.
# take moves the active pools out and leaves fresh empty ones; install
# makes a taken snapshot active again. The globals stay the active context.
pub struct FlatPoolState:
    span_pool_start: [i64]
    span_pool_end: [i64]
    span_pool_line: [i64]
    span_pool_col: [i64]
    tok_pool_kind: [i64]
    tok_pool_span: [i64]
    tok_pool_text: [text]
    sym_names: [text]
    sym_types: [i64]
    sym_depths: [i64]
    sym_decl_ids: [i64]
    sym_mutable: [i64]
    scope_starts: [i64]
    current_scope_depth: i64
    named_type_names: [text]
    named_type_arguments: [[i64]]
    named_type_layout_owners: [i64]
    named_type_field_names: [[text]]
    named_type_field_types: [[i64]]
    custom_primitive_names: [text]
    custom_primitive_underlying_type_tags: [i64]
    custom_primitive_symbol_ids: [i64]
    newunit_names: [text]
    newunit_suffixes: [text]
    newunit_underlying_type_tags: [i64]
    fn_sig_names: [text]
    fn_sig_param_names: [[text]]
    fn_sig_param_types: [[i64]]
    fn_sig_ret_types: [i64]
    fn_sig_is_extern: [i64]
    generic_param_names: [text]
    generic_param_contexts: [text]
    generic_param_ids: [i64]
    union_type_members: [[i64]]
    tuple_type_elem_tags: [[i64]]
    intersection_type_members: [[i64]]
    refinement_base_types: [i64]
    refinement_predicates: [text]
    dict_type_keys: [i64]
    dict_type_values: [i64]
    result_type_ok: [i64]
    result_type_err: [i64]
    array_generic_elem_tags: [i64]
    option_generic_inner_tags: [i64]
    named_generic_instance_ids: [i64]
    named_generic_instance_bases: [text]
    named_generic_instance_args: [[i64]]
    isolated_inner_tags: [i64]
    exclusive_inner_tags: [i64]
    reference_inner_tags: [i64]
    reference_mutable_flags: [i64]
    pointer_inner_tags: [i64]
    pointer_mutable_flags: [i64]
    atomic_inner_tags: [i64]
    weak_inner_tags: [i64]
    function_param_tags: [[i64]]
    function_ret_tags: [i64]

pub fn flat_pool_state_take() -> FlatPoolState:
    val s = FlatPoolState(
        span_pool_start: span_pool_start,
        span_pool_end: span_pool_end,
        span_pool_line: span_pool_line,
        span_pool_col: span_pool_col,
        tok_pool_kind: tok_pool_kind,
        tok_pool_span: tok_pool_span,
        tok_pool_text: tok_pool_text,
        sym_names: sym_names,
        sym_types: sym_types,
        sym_depths: sym_depths,
        sym_decl_ids: sym_decl_ids,
        sym_mutable: sym_mutable,
        scope_starts: scope_starts,
        current_scope_depth: current_scope_depth,
        named_type_names: named_type_names,
        named_type_arguments: named_type_arguments,
        named_type_layout_owners: named_type_layout_owners,
        named_type_field_names: named_type_field_names,
        named_type_field_types: named_type_field_types,
        custom_primitive_names: custom_primitive_names,
        custom_primitive_underlying_type_tags: custom_primitive_underlying_type_tags,
        custom_primitive_symbol_ids: custom_primitive_symbol_ids,
        newunit_names: newunit_names,
        newunit_suffixes: newunit_suffixes,
        newunit_underlying_type_tags: newunit_underlying_type_tags,
        fn_sig_names: fn_sig_names,
        fn_sig_param_names: fn_sig_param_names,
        fn_sig_param_types: fn_sig_param_types,
        fn_sig_ret_types: fn_sig_ret_types,
        fn_sig_is_extern: fn_sig_is_extern,
        generic_param_names: generic_param_names,
        generic_param_contexts: generic_param_contexts,
        generic_param_ids: generic_param_ids,
        union_type_members: union_type_members,
        tuple_type_elem_tags: tuple_type_elem_tags,
        intersection_type_members: intersection_type_members,
        refinement_base_types: refinement_base_types,
        refinement_predicates: refinement_predicates,
        dict_type_keys: dict_type_keys,
        dict_type_values: dict_type_values,
        result_type_ok: result_type_ok,
        result_type_err: result_type_err,
        array_generic_elem_tags: array_generic_elem_tags,
        option_generic_inner_tags: option_generic_inner_tags,
        named_generic_instance_ids: named_generic_instance_ids,
        named_generic_instance_bases: named_generic_instance_bases,
        named_generic_instance_args: named_generic_instance_args,
        isolated_inner_tags: isolated_inner_tags,
        exclusive_inner_tags: exclusive_inner_tags,
        reference_inner_tags: reference_inner_tags,
        reference_mutable_flags: reference_mutable_flags,
        pointer_inner_tags: pointer_inner_tags,
        pointer_mutable_flags: pointer_mutable_flags,
        atomic_inner_tags: atomic_inner_tags,
        weak_inner_tags: weak_inner_tags,
        function_param_tags: function_param_tags,
        function_ret_tags: function_ret_tags
    )
    reset_all_pools()
    s

pub fn flat_pool_state_install(s: FlatPoolState):
    span_pool_start = s.span_pool_start
    span_pool_end = s.span_pool_end
    span_pool_line = s.span_pool_line
    span_pool_col = s.span_pool_col
    tok_pool_kind = s.tok_pool_kind
    tok_pool_span = s.tok_pool_span
    tok_pool_text = s.tok_pool_text
    sym_names = s.sym_names
    sym_types = s.sym_types
    sym_depths = s.sym_depths
    sym_decl_ids = s.sym_decl_ids
    sym_mutable = s.sym_mutable
    scope_starts = s.scope_starts
    current_scope_depth = s.current_scope_depth
    named_type_names = s.named_type_names
    named_type_arguments = s.named_type_arguments
    named_type_layout_owners = s.named_type_layout_owners
    named_type_field_names = s.named_type_field_names
    named_type_field_types = s.named_type_field_types
    custom_primitive_names = s.custom_primitive_names
    custom_primitive_underlying_type_tags = s.custom_primitive_underlying_type_tags
    custom_primitive_symbol_ids = s.custom_primitive_symbol_ids
    newunit_names = s.newunit_names
    newunit_suffixes = s.newunit_suffixes
    newunit_underlying_type_tags = s.newunit_underlying_type_tags
    fn_sig_names = s.fn_sig_names
    fn_sig_param_names = s.fn_sig_param_names
    fn_sig_param_types = s.fn_sig_param_types
    fn_sig_ret_types = s.fn_sig_ret_types
    fn_sig_is_extern = s.fn_sig_is_extern
    generic_param_names = s.generic_param_names
    generic_param_contexts = s.generic_param_contexts
    generic_param_ids = s.generic_param_ids
    union_type_members = s.union_type_members
    tuple_type_elem_tags = s.tuple_type_elem_tags
    intersection_type_members = s.intersection_type_members
    refinement_base_types = s.refinement_base_types
    refinement_predicates = s.refinement_predicates
    dict_type_keys = s.dict_type_keys
    dict_type_values = s.dict_type_values
    result_type_ok = s.result_type_ok
    result_type_err = s.result_type_err
    array_generic_elem_tags = s.array_generic_elem_tags
    option_generic_inner_tags = s.option_generic_inner_tags
    named_generic_instance_ids = s.named_generic_instance_ids
    named_generic_instance_bases = s.named_generic_instance_bases
    named_generic_instance_args = s.named_generic_instance_args
    isolated_inner_tags = s.isolated_inner_tags
    exclusive_inner_tags = s.exclusive_inner_tags
    reference_inner_tags = s.reference_inner_tags
    reference_mutable_flags = s.reference_mutable_flags
    pointer_inner_tags = s.pointer_inner_tags
    pointer_mutable_flags = s.pointer_mutable_flags
    atomic_inner_tags = s.atomic_inner_tags
    weak_inner_tags = s.weak_inner_tags
    function_param_tags = s.function_param_tags
    function_ret_tags = s.function_ret_tags

export FlatPoolState, flat_pool_state_take, flat_pool_state_install
