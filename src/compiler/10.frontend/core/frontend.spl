# Core Frontend Runner
#
# Shared parse entrypoints used by core compiler and core interpreter flows.
# Keeps the core frontend orchestration (parse/reset/append/isolated) in one place.

use compiler.core.parser.{parse_module, parse_module_file, parser_has_errors, parser_set_had_error}
use compiler.core.ast.{expr_count}
use compiler.frontend.core.string_interpolation_expand.{expand_string_interpolations}
use compiler.frontend.desugar.placeholder_lambda.{transform_interpolated_placeholder_args}

fn core_frontend_parse(
    source: text,
    path: text,
    append_mode: bool,
    preserve_error_state: bool
) -> bool:
    val saved_had_error = parser_has_errors()
    val first_expr = if append_mode: expr_count() else: 0

    if append_mode:
        parse_module_file(source, path)
    else:
        parse_module(source, path)

    var parse_ok = not parser_has_errors()
    if parse_ok:
        expand_string_interpolations(first_expr)
        # Interpolated-string call arguments only become inspectable here; run
        # the placeholder-lambda transform over them now (see
        # placeholder_lambda.transform_interpolated_placeholder_args).
        transform_interpolated_placeholder_args(first_expr)
        parse_ok = not parser_has_errors()
    if preserve_error_state:
        parser_set_had_error(saved_had_error)

    parse_ok

fn core_frontend_parse_reset(source: text, path: text) -> bool:
    """Parse a standalone module, resetting parser/AST state."""
    core_frontend_parse(source, path, false, false)

fn core_frontend_parse_append(source: text, path: text) -> bool:
    """Parse and append to current module arena (multi-file compile path)."""
    core_frontend_parse(source, path, true, false)

fn core_frontend_parse_isolated(source: text, path: text) -> bool:
    """Parse in isolated mode and restore prior parser error flag."""
    core_frontend_parse(source, path, false, true)
