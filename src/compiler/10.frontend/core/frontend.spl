# Core Frontend Runner
#
# Shared parse entrypoints used by core compiler and core interpreter flows.
# Keeps the core frontend orchestration (parse/reset/append/isolated) in one place.

use compiler.core.parser.{parse_module, parse_module_file, parser_has_errors, parser_set_had_error}
use compiler.core.ast.{expr_count}
use compiler.frontend.core.string_interpolation_expand.{expand_string_interpolations}
use compiler.frontend.desugar.placeholder_lambda.{transform_interpolated_placeholder_args}

enum ParserProviderV1:
    LegacyReference
    CanonicalScalarCandidate
    SimdCandidate
    GpuCandidate

# Exact differential surface required before CanonicalScalarCandidate may be
# admitted.  This is deliberately a manifest, not a claim that a candidate
# engine exists: the shared structural parser currently executes only a
# lexical DFA and cannot produce Simple AST/HIR semantics.
val PARSER_PROVIDER_DIFFERENTIAL_SCHEMA_V1: i64 = 1
val PARSER_PARITY_TOKENS_V1: i64 = 1
val PARSER_PARITY_REGIONS_V1: i64 = 2
val PARSER_PARITY_ACTIONS_HIR_V1: i64 = 4
val PARSER_PARITY_SOURCE_MAPPINGS_V1: i64 = 8
val PARSER_PARITY_DIAGNOSTICS_V1: i64 = 16
val PARSER_PARITY_INVALIDATION_V1: i64 = 32
val PARSER_PARITY_DETERMINISTIC_HASH_V1: i64 = 64
val PARSER_PARITY_ALL_V1: i64 = 127

enum ParserDifferentialCaseKindV1:
    ResetValid
    ResetInvalid
    AppendValid
    IsolatedInvalid

struct ParserDifferentialCaseRequirementV1:
    ordinal: i64
    case_id: text
    fixture_identity: text
    kind: ParserDifferentialCaseKindV1
    source: text
    path: text
    expected_parse_ok: bool
    initial_had_error: bool
    expected_had_error_after: bool
    prerequisite_ordinal: i64
    required_observables: i64

struct ParserCanonicalScalarPrerequisiteReceiptV1:
    schema_version: i64
    provider: ParserProviderV1
    provider_id: text
    candidate_engine_available: bool
    legacy_executed: bool
    candidate_executed: bool
    compared_case_count: i64
    required_case_count: i64
    required_observables: i64
    qualified: bool
    reason: text

fn parser_provider_v1_canonical_scalar_required_cases() -> [ParserDifferentialCaseRequirementV1]:
    """Return the closed, ordered corpus shape required for scalar promotion."""
    [
        ParserDifferentialCaseRequirementV1(
            ordinal: 0, case_id: "simple.reset.valid",
            fixture_identity: "simple-parser-diff-v1/reset-valid",
            kind: ParserDifferentialCaseKindV1.ResetValid,
            source: "fn canonical_reset_probe():\n    42\n",
            path: "canonical_scalar_reset_valid.spl",
            expected_parse_ok: true, initial_had_error: false,
            expected_had_error_after: false, prerequisite_ordinal: -1,
            required_observables: PARSER_PARITY_ALL_V1),
        ParserDifferentialCaseRequirementV1(
            ordinal: 1, case_id: "simple.reset.invalid",
            fixture_identity: "simple-parser-diff-v1/reset-invalid",
            kind: ParserDifferentialCaseKindV1.ResetInvalid,
            source: "fn canonical_reset_broken(:\n",
            path: "canonical_scalar_reset_invalid.spl",
            expected_parse_ok: false, initial_had_error: false,
            expected_had_error_after: true, prerequisite_ordinal: -1,
            required_observables: PARSER_PARITY_ALL_V1),
        ParserDifferentialCaseRequirementV1(
            ordinal: 2, case_id: "simple.append.valid",
            fixture_identity: "simple-parser-diff-v1/append-valid",
            kind: ParserDifferentialCaseKindV1.AppendValid,
            source: "fn canonical_append_probe():\n    7 + 8\n",
            path: "canonical_scalar_append_valid.spl",
            expected_parse_ok: true, initial_had_error: false,
            expected_had_error_after: false, prerequisite_ordinal: 0,
            required_observables: PARSER_PARITY_ALL_V1),
        ParserDifferentialCaseRequirementV1(
            ordinal: 3, case_id: "simple.isolated.invalid",
            fixture_identity: "simple-parser-diff-v1/isolated-invalid",
            kind: ParserDifferentialCaseKindV1.IsolatedInvalid,
            source: "fn canonical_isolated_broken(:\n",
            path: "canonical_scalar_isolated_invalid.spl",
            expected_parse_ok: false, initial_had_error: false,
            expected_had_error_after: false, prerequisite_ordinal: 0,
            required_observables: PARSER_PARITY_ALL_V1)
    ]

fn parser_provider_v1_canonical_scalar_prerequisite() -> ParserCanonicalScalarPrerequisiteReceiptV1:
    """Report current promotion truth without executing or falling back.

    The available shared ParseRuntime is lexical-only.  It has no generated
    Simple GrammarProgram/ActionProgram and therefore cannot be compared as a
    semantic frontend provider.  Keep this receipt negative until a distinct
    engine produces every required observable for every retained corpus case.
    """
    val cases = parser_provider_v1_canonical_scalar_required_cases()
    ParserCanonicalScalarPrerequisiteReceiptV1(
        schema_version: PARSER_PROVIDER_DIFFERENTIAL_SCHEMA_V1,
        provider: ParserProviderV1.CanonicalScalarCandidate,
        provider_id: parser_provider_v1_name(ParserProviderV1.CanonicalScalarCandidate),
        candidate_engine_available: false,
        legacy_executed: false,
        candidate_executed: false,
        compared_case_count: 0,
        required_case_count: cases.len(),
        required_observables: PARSER_PARITY_ALL_V1,
        qualified: false,
        reason: "canonical_scalar_simple_grammar_action_engine_unavailable")

struct ParserProviderReceiptV1:
    provider: ParserProviderV1
    provider_id: text
    executed: bool
    parse_ok: bool
    fallback_reason: text

struct ParserProviderAdmissionV1:
    provider: ParserProviderV1
    provider_id: text

fn parser_provider_v1_name(provider: ParserProviderV1) -> text:
    match provider:
        case ParserProviderV1.LegacyReference: "parser.simple.legacy-reference"
        case ParserProviderV1.CanonicalScalarCandidate: "parser.simple.canonical-scalar"
        case ParserProviderV1.SimdCandidate: "parser.simple.simd"
        case ParserProviderV1.GpuCandidate: "parser.simple.gpu"

fn parser_provider_v1_default() -> ParserProviderV1:
    """Return the only frontend provider currently qualified for execution."""
    ParserProviderV1.LegacyReference

fn parser_provider_v1_admit(provider: ParserProviderV1) -> Result<ParserProviderAdmissionV1, text>:
    """Admit a provider before any parser-owned state may be mutated."""
    if provider != ParserProviderV1.LegacyReference:
        return Err("parser_provider_unqualified: " + parser_provider_v1_name(provider))
    Ok(ParserProviderAdmissionV1(
        provider: provider,
        provider_id: parser_provider_v1_name(provider)
    ))

fn core_frontend_parse_legacy_reference(
    source: text,
    path: text,
    append_mode: bool,
    preserve_error_state: bool
) -> bool:
    val saved_had_error = parser_has_errors()
    val first_expr = if append_mode: expr_count() else: 0

    if append_mode:
        parse_module_file(source, path)
    else:
        parse_module(source, path)

    var parse_ok = not parser_has_errors()
    if parse_ok:
        expand_string_interpolations(first_expr)
        # Interpolated-string call arguments only become inspectable here; run
        # the placeholder-lambda transform over them now (see
        # placeholder_lambda.transform_interpolated_placeholder_args).
        transform_interpolated_placeholder_args(first_expr)
        parse_ok = not parser_has_errors()
    if preserve_error_state:
        parser_set_had_error(saved_had_error)

    parse_ok

fn parser_provider_v1_execute(
    provider: ParserProviderV1,
    source: text,
    path: text,
    append_mode: bool,
    preserve_error_state: bool
) -> Result<ParserProviderReceiptV1, text>:
    """Execute an admitted full-frontend provider without implicit fallback."""
    val admission = parser_provider_v1_admit(provider)?

    val parse_ok = core_frontend_parse_legacy_reference(
        source, path, append_mode, preserve_error_state)
    Ok(ParserProviderReceiptV1(
        provider: provider,
        provider_id: admission.provider_id,
        executed: true,
        parse_ok: parse_ok,
        fallback_reason: ""
    ))

fn core_frontend_parse(
    source: text,
    path: text,
    append_mode: bool,
    preserve_error_state: bool
) -> bool:
    match parser_provider_v1_execute(
        parser_provider_v1_default(), source, path, append_mode, preserve_error_state):
        case Ok(receipt): receipt.parse_ok
        case Err(_): false

fn core_frontend_parse_reset(source: text, path: text) -> bool:
    """Parse a standalone module, resetting parser/AST state."""
    core_frontend_parse(source, path, false, false)

fn core_frontend_parse_append(source: text, path: text) -> bool:
    """Parse and append to current module arena (multi-file compile path)."""
    core_frontend_parse(source, path, true, false)

fn core_frontend_parse_isolated(source: text, path: text) -> bool:
    """Parse in isolated mode and restore prior parser error flag."""
    core_frontend_parse(source, path, false, true)

export ParserProviderV1, ParserProviderAdmissionV1, ParserProviderReceiptV1
export ParserDifferentialCaseKindV1, ParserDifferentialCaseRequirementV1
export ParserCanonicalScalarPrerequisiteReceiptV1
export PARSER_PROVIDER_DIFFERENTIAL_SCHEMA_V1, PARSER_PARITY_TOKENS_V1
export PARSER_PARITY_REGIONS_V1, PARSER_PARITY_ACTIONS_HIR_V1
export PARSER_PARITY_SOURCE_MAPPINGS_V1, PARSER_PARITY_DIAGNOSTICS_V1
export PARSER_PARITY_INVALIDATION_V1, PARSER_PARITY_DETERMINISTIC_HASH_V1
export PARSER_PARITY_ALL_V1
export parser_provider_v1_name, parser_provider_v1_default, parser_provider_v1_admit, parser_provider_v1_execute
export parser_provider_v1_canonical_scalar_required_cases
export parser_provider_v1_canonical_scalar_prerequisite
export core_frontend_parse_legacy_reference
