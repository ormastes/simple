# Compiler-owned closed-world facet declaration and witness registry.
#
# Declaration rows live for exactly one compiler invocation. The driver calls
# facet_static_begin_compilation() before parsing the first source; individual
# reparses replace only their module's rows. Resolved rows are published only
# after the post-HIR coherence pass has validated the complete compilation.

use compiler.common.module_path_naming.{module_logical_name_from_path}

var facet_static_interfaces: [text] = []
var facet_static_impl_keys: [text] = []
var facet_static_impl_targets: [text] = []
var facet_static_impl_facets: [text] = []
var facet_static_bind_facets: [text] = []
var facet_static_bind_targets: [text] = []
var facet_static_bind_impls: [text] = []
# The declaration owner is independent of every qualified name in the row.
# Reparse/reset must remove facts contributed by the source being replaced,
# even when that source binds a facet declared by another module.
var facet_static_bind_modules: [text] = []

# Validated route rows. route_ids are non-zero runtime witness discriminators.
var facet_static_resolved_route_ids: [i64] = []
var facet_static_resolved_route_keys: [text] = []
var facet_static_resolved_facets: [text] = []
var facet_static_resolved_targets: [text] = []
var facet_static_resolved_impls: [text] = []
var facet_static_resolved_modules: [text] = []

# Exact HIR method identities for each selected implementation. SymbolId is a
# module-local scalar, therefore the defining module and emitted symbol name
# travel with it; MIR refuses a cross-module row it cannot prove locally.
var facet_static_method_route_ids: [i64] = []
var facet_static_method_names: [text] = []
var facet_static_method_symbol_ids: [i64] = []
var facet_static_method_symbol_names: [text] = []
var facet_static_method_modules: [text] = []

extern fn rt_transient_heap_promote(value: Any) -> bool

fn facet_static_prepare_persistent_globals():
    if facet_static_interfaces == nil:
        facet_static_interfaces = []
    if facet_static_impl_keys == nil:
        facet_static_impl_keys = []
    if facet_static_impl_targets == nil:
        facet_static_impl_targets = []
    if facet_static_impl_facets == nil:
        facet_static_impl_facets = []
    if facet_static_bind_facets == nil:
        facet_static_bind_facets = []
    if facet_static_bind_targets == nil:
        facet_static_bind_targets = []
    if facet_static_bind_impls == nil:
        facet_static_bind_impls = []
    if facet_static_bind_modules == nil:
        facet_static_bind_modules = []
    if facet_static_resolved_route_ids == nil:
        facet_static_resolved_route_ids = []
    if facet_static_resolved_route_keys == nil:
        facet_static_resolved_route_keys = []
    if facet_static_resolved_facets == nil:
        facet_static_resolved_facets = []
    if facet_static_resolved_targets == nil:
        facet_static_resolved_targets = []
    if facet_static_resolved_impls == nil:
        facet_static_resolved_impls = []
    if facet_static_resolved_modules == nil:
        facet_static_resolved_modules = []
    if facet_static_method_route_ids == nil:
        facet_static_method_route_ids = []
    if facet_static_method_names == nil:
        facet_static_method_names = []
    if facet_static_method_symbol_ids == nil:
        facet_static_method_symbol_ids = []
    if facet_static_method_symbol_names == nil:
        facet_static_method_symbol_names = []
    if facet_static_method_modules == nil:
        facet_static_method_modules = []

fn facet_static_module_key(path: text) -> text:
    module_logical_name_from_path(path)

fn facet_static_key(path: text, name: text) -> text:
    # A qualified source spelling uses its last component as the item and the
    # preceding components as the logical module. Unqualified names belong to
    # the physical source currently being parsed.
    val normalized = name.replace("::", ".")
    val dot = normalized.last_index_of(".")
    if dot >= 0:
        return normalized[0:dot] + "::" + normalized[dot + 1:]
    facet_static_module_key(path) + "::" + normalized

fn facet_static_path_of(key: text) -> text:
    val parts = key.split("::")
    if parts.len() < 2:
        return ""
    parts[0]

fn facet_static_name_of(key: text) -> text:
    val parts = key.split("::")
    if parts.len() < 2:
        return ""
    parts[parts.len() - 1]

fn facet_static_route_key(facet_key: text, target_key: text, impl_key: text) -> text:
    facet_key + "|" + target_key + "|" + impl_key

fn facet_static_clear_resolved():
    facet_static_resolved_route_ids.clear()
    facet_static_resolved_route_keys.clear()
    facet_static_resolved_facets.clear()
    facet_static_resolved_targets.clear()
    facet_static_resolved_impls.clear()
    facet_static_resolved_modules.clear()
    facet_static_method_route_ids.clear()
    facet_static_method_names.clear()
    facet_static_method_symbol_ids.clear()
    facet_static_method_symbol_names.clear()
    facet_static_method_modules.clear()

fn facet_static_reset_module(path: text):
    val module_key = facet_static_module_key(path)
    val prefix = module_key + "::"
    var kept_interfaces: [text] = []
    for key in facet_static_interfaces:
        if not key.starts_with(prefix):
            kept_interfaces.push(key)
    facet_static_interfaces.clear()
    for key in kept_interfaces:
        facet_static_interfaces.push(key)

    var kept_impl_keys: [text] = []
    var kept_impl_targets: [text] = []
    var kept_impl_facets: [text] = []
    var i: i64 = 0
    while i < facet_static_impl_keys.len():
        if not facet_static_impl_keys[i].starts_with(prefix):
            kept_impl_keys.push(facet_static_impl_keys[i])
            kept_impl_targets.push(facet_static_impl_targets[i])
            kept_impl_facets.push(facet_static_impl_facets[i])
        i = i + 1
    facet_static_impl_keys.clear()
    facet_static_impl_targets.clear()
    facet_static_impl_facets.clear()
    i = 0
    while i < kept_impl_keys.len():
        facet_static_impl_keys.push(kept_impl_keys[i])
        facet_static_impl_targets.push(kept_impl_targets[i])
        facet_static_impl_facets.push(kept_impl_facets[i])
        i = i + 1

    var kept_bind_facets: [text] = []
    var kept_bind_targets: [text] = []
    var kept_bind_impls: [text] = []
    var kept_bind_modules: [text] = []
    i = 0
    while i < facet_static_bind_facets.len():
        if facet_static_bind_modules[i] != module_key:
            kept_bind_facets.push(facet_static_bind_facets[i])
            kept_bind_targets.push(facet_static_bind_targets[i])
            kept_bind_impls.push(facet_static_bind_impls[i])
            kept_bind_modules.push(facet_static_bind_modules[i])
        i = i + 1
    facet_static_bind_facets.clear()
    facet_static_bind_targets.clear()
    facet_static_bind_impls.clear()
    facet_static_bind_modules.clear()
    i = 0
    while i < kept_bind_facets.len():
        facet_static_bind_facets.push(kept_bind_facets[i])
        facet_static_bind_targets.push(kept_bind_targets[i])
        facet_static_bind_impls.push(kept_bind_impls[i])
        facet_static_bind_modules.push(kept_bind_modules[i])
        i = i + 1
    facet_static_clear_resolved()

fn facet_static_reset_all():
    facet_static_interfaces.clear()
    facet_static_impl_keys.clear()
    facet_static_impl_targets.clear()
    facet_static_impl_facets.clear()
    facet_static_bind_facets.clear()
    facet_static_bind_targets.clear()
    facet_static_bind_impls.clear()
    facet_static_bind_modules.clear()
    facet_static_clear_resolved()

fn facet_static_begin_compilation():
    facet_static_prepare_persistent_globals()
    facet_static_reset_all()

fn facet_static_promote_transient_graph() -> bool:
    var ok = true
    if not rt_transient_heap_promote(facet_static_interfaces):
        ok = false
    if not rt_transient_heap_promote(facet_static_impl_keys):
        ok = false
    if not rt_transient_heap_promote(facet_static_impl_targets):
        ok = false
    if not rt_transient_heap_promote(facet_static_impl_facets):
        ok = false
    if not rt_transient_heap_promote(facet_static_bind_facets):
        ok = false
    if not rt_transient_heap_promote(facet_static_bind_targets):
        ok = false
    if not rt_transient_heap_promote(facet_static_bind_impls):
        ok = false
    if not rt_transient_heap_promote(facet_static_bind_modules):
        ok = false
    ok

fn facet_static_declare_interface(path: text, facet_name: text):
    val key = facet_static_key(path, facet_name)
    if facet_name != "" and not facet_static_interfaces.contains(key):
        facet_static_interfaces.push(key)

fn facet_static_declare_impl(path: text, impl_name: text, target_name: text, facet_name: text):
    val key = facet_static_key(path, impl_name)
    val target_key = facet_static_key(path, target_name)
    val facet_key = facet_static_key(path, facet_name)
    var i: i64 = 0
    while i < facet_static_impl_keys.len():
        if facet_static_impl_keys[i] == key:
            facet_static_impl_targets[i] = target_key
            facet_static_impl_facets[i] = facet_key
            return
        i = i + 1
    facet_static_impl_keys.push(key)
    facet_static_impl_targets.push(target_key)
    facet_static_impl_facets.push(facet_key)

fn facet_static_declare_bind(path: text, facet_name: text, target_name: text, impl_name: text):
    facet_static_bind_facets.push(facet_static_key(path, facet_name))
    facet_static_bind_targets.push(facet_static_key(path, target_name))
    facet_static_bind_impls.push(facet_static_key(path, impl_name))
    facet_static_bind_modules.push(facet_static_module_key(path))

fn facet_static_impl_index_key(impl_key: text) -> i64:
    var i: i64 = 0
    while i < facet_static_impl_keys.len():
        if facet_static_impl_keys[i] == impl_key:
            return i
        i = i + 1
    -1

fn facet_static_impl_index(path: text, impl_name: text) -> i64:
    facet_static_impl_index_key(facet_static_key(path, impl_name))

fn facet_static_interface_declared_key(facet_key: text) -> bool:
    facet_static_interfaces.contains(facet_key)

fn facet_static_interface_declared(path: text, facet_name: text) -> bool:
    facet_static_interface_declared_key(facet_static_key(path, facet_name))

fn facet_static_declared_route_key(facet_key: text, target_key: text) -> text:
    var found = ""
    var count: i64 = 0
    var i: i64 = 0
    while i < facet_static_bind_facets.len():
        if facet_static_bind_facets[i] == facet_key and facet_static_bind_targets[i] == target_key:
            found = facet_static_route_key(facet_key, target_key, facet_static_bind_impls[i])
            count = count + 1
        i = i + 1
    if count == 1: found else: ""

fn facet_static_publish_resolved(facet_key: text, target_key: text, impl_key: text, module_key: text) -> i64:
    val route_id = facet_static_resolved_route_ids.len() + 1
    facet_static_resolved_route_ids.push(route_id)
    facet_static_resolved_route_keys.push(facet_static_route_key(facet_key, target_key, impl_key))
    facet_static_resolved_facets.push(facet_key)
    facet_static_resolved_targets.push(target_key)
    facet_static_resolved_impls.push(impl_key)
    facet_static_resolved_modules.push(module_key)
    route_id

fn facet_static_publish_method(route_id: i64, method_name: text, symbol_id: i64, symbol_name: text, module_key: text):
    facet_static_method_route_ids.push(route_id)
    facet_static_method_names.push(method_name)
    facet_static_method_symbol_ids.push(symbol_id)
    facet_static_method_symbol_names.push(symbol_name)
    facet_static_method_modules.push(module_key)

fn facet_static_resolved_count(facet_key: text, target_key: text) -> i64:
    var count: i64 = 0
    var i: i64 = 0
    while i < facet_static_resolved_route_ids.len():
        if facet_static_resolved_facets[i] == facet_key and facet_static_resolved_targets[i] == target_key:
            count = count + 1
        i = i + 1
    count

fn facet_static_resolved_route_id(route_key: text) -> i64:
    var i: i64 = 0
    while i < facet_static_resolved_route_keys.len():
        if facet_static_resolved_route_keys[i] == route_key:
            return facet_static_resolved_route_ids[i]
        i = i + 1
    -1

fn facet_static_resolved_route_key_for(facet_key: text, target_key: text) -> text:
    var found = ""
    var count: i64 = 0
    var i: i64 = 0
    while i < facet_static_resolved_route_ids.len():
        if facet_static_resolved_facets[i] == facet_key and facet_static_resolved_targets[i] == target_key:
            found = facet_static_resolved_route_keys[i]
            count = count + 1
        i = i + 1
    if count == 1: found else: ""

fn facet_static_resolved_impl(facet_key: text, target_key: text) -> text:
    val route_key = facet_static_resolved_route_key_for(facet_key, target_key)
    if route_key == "":
        return ""
    var i: i64 = 0
    while i < facet_static_resolved_route_keys.len():
        if facet_static_resolved_route_keys[i] == route_key:
            return facet_static_resolved_impls[i]
        i = i + 1
    ""

fn facet_static_route_count_for_facet(facet_key: text) -> i64:
    var count: i64 = 0
    for key in facet_static_resolved_facets:
        if key == facet_key:
            count = count + 1
    count

fn facet_static_route_id_for_facet_at(facet_key: text, ordinal: i64) -> i64:
    var seen: i64 = 0
    var i: i64 = 0
    while i < facet_static_resolved_route_ids.len():
        if facet_static_resolved_facets[i] == facet_key:
            if seen == ordinal:
                return facet_static_resolved_route_ids[i]
            seen = seen + 1
        i = i + 1
    -1

fn facet_static_method_symbol_id(route_id: i64, method_name: text) -> i64:
    var i: i64 = 0
    while i < facet_static_method_route_ids.len():
        if facet_static_method_route_ids[i] == route_id and facet_static_method_names[i] == method_name:
            return facet_static_method_symbol_ids[i]
        i = i + 1
    -1

fn facet_static_method_symbol_name(route_id: i64, method_name: text) -> text:
    var i: i64 = 0
    while i < facet_static_method_route_ids.len():
        if facet_static_method_route_ids[i] == route_id and facet_static_method_names[i] == method_name:
            return facet_static_method_symbol_names[i]
        i = i + 1
    ""

fn facet_static_method_module(route_id: i64, method_name: text) -> text:
    var i: i64 = 0
    while i < facet_static_method_route_ids.len():
        if facet_static_method_route_ids[i] == route_id and facet_static_method_names[i] == method_name:
            return facet_static_method_modules[i]
        i = i + 1
    ""

fn facet_static_method_symbol_key(route_id: i64, method_name: text) -> text:
    val module_key = facet_static_method_module(route_id, method_name)
    val symbol_name = facet_static_method_symbol_name(route_id, method_name)
    if module_key == "" or symbol_name == "":
        return ""
    module_key + "::" + symbol_name

fn facet_static_method_symbol_matches(route_id: i64, method_name: text, symbol_id: i64, defining_module: text, symbol_name: text) -> bool:
    facet_static_method_symbol_id(route_id, method_name) == symbol_id and
        facet_static_method_symbol_key(route_id, method_name) ==
            facet_static_module_key(defining_module) + "::" + symbol_name

export facet_static_interfaces, facet_static_impl_keys, facet_static_impl_targets
export facet_static_impl_facets, facet_static_bind_facets, facet_static_bind_targets
export facet_static_bind_impls, facet_static_bind_modules
export facet_static_resolved_route_ids, facet_static_resolved_route_keys
export facet_static_resolved_facets, facet_static_resolved_targets, facet_static_resolved_impls
export facet_static_resolved_modules, facet_static_method_route_ids, facet_static_method_names
export facet_static_method_symbol_ids, facet_static_method_symbol_names, facet_static_method_modules
export facet_static_module_key, facet_static_key, facet_static_path_of, facet_static_name_of
export facet_static_route_key, facet_static_reset_module, facet_static_clear_resolved
export facet_static_reset_all, facet_static_begin_compilation
export facet_static_prepare_persistent_globals, facet_static_promote_transient_graph
export facet_static_declare_interface, facet_static_declare_impl, facet_static_declare_bind
export facet_static_impl_index, facet_static_impl_index_key
export facet_static_interface_declared, facet_static_interface_declared_key
export facet_static_declared_route_key, facet_static_publish_resolved, facet_static_publish_method
export facet_static_resolved_count, facet_static_resolved_route_id
export facet_static_resolved_route_key_for, facet_static_resolved_impl
export facet_static_route_count_for_facet, facet_static_route_id_for_facet_at
export facet_static_method_symbol_id, facet_static_method_symbol_name, facet_static_method_module
export facet_static_method_symbol_key, facet_static_method_symbol_matches
