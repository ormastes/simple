"""
## Purpose and audience
Static (closed-world) facet binding validation for the typed facet pipeline,
doc/04_architecture/compiler/aspect_dynload/typed_facet_pipeline_2026-08-22.md.
Audience: the aspect/dynload lane owner, and the HIR driver, which invokes this
validator once the whole compilation's modules are lowered.

## Operator workflow
Call once per compilation, after every module is lowered, with the whole
module map keyed by module path:

    facet_static_begin_compilation()
    val errors = validate_static_facet_bindings(modules)   # [text], empty = clean

## Compatibility and limitations
Validation is whole-program by construction: a facet acquisition in one module
may only be satisfied by an impl visible somewhere in the same compilation, so
a per-module check cannot decide it. An empty module map therefore declares no
facet and can raise no binding error.

TODO(aspect-dynload lane, REQ-APK-P04): this file is a PLACEHOLDER. The real
177-line validator lived at `src/compiler/35.semantics/facet_static_binding.spl`
and was deleted by `fcbec1c3b62`; restoring it must DELETE this file. See
doc/08_tracking/bug/aspect_dynload_facet_implementation_deleted_by_merge_restore_2026-09-05.md.
Meanwhile the walk below finds zero acquisition sites because the frontend has no `.try_facet<F>()` grammar and HIR
carries no facet-reference node -- see
test/03_system/plan_acceptance/aspect_dynload_lane_plan_spec.spl and
test/01_unit/compiler/semantics/facet_static_binding_spec.spl, which pin this
interface ahead of that parser/HIR work. When those land, `_facet_acquisitions_in`
reads the real nodes and this validator starts reporting.
"""

use compiler.hir.hir_types.{HirModule}
use compiler.frontend.facet_static_registry.{
    facet_static_key,
    facet_static_resolved_count
}

# One `.try_facet<F>()` site: the facet requested, the concrete target it is
# requested on, and where the request was written.
struct FacetAcquisitionSite:
    facet_name: text
    target_name: text
    module_path: text

# Validate every static facet acquisition in the compilation.
#
# `modules` maps module path -> lowered HIR for that module. Returns one error
# text per unsatisfiable acquisition; an empty list means every acquisition
# resolved to exactly one impl.
fn validate_static_facet_bindings(modules: Dict<text, HirModule>) -> [text]:
    var errors: [text] = []
    var sites: [FacetAcquisitionSite] = []
    for path in modules.keys():
        if val module = modules.get(path):
            for site in _facet_acquisitions_in(path, module):
                sites.push(site)
    for site in sites:
        val facet_key = facet_static_key(site.module_path, site.facet_name)
        val target_key = facet_static_key(site.module_path, site.target_name)
        val count = facet_static_resolved_count(facet_key, target_key)
        if count == 0:
            errors.push(site.module_path + ": no impl of facet `" + site.facet_name
                        + "` for `" + site.target_name + "` is visible in this compilation")
        else:
            if count > 1:
                errors.push(site.module_path + ": facet `" + site.facet_name
                            + "` for `" + site.target_name + "` is ambiguous ("
                            + count.to_text() + " impls)")
    errors

# Every `.try_facet<F>()` acquisition site written in this module.
fn _facet_acquisitions_in(path: text, module: HirModule) -> [FacetAcquisitionSite]:
    # The frontend has no `.try_facet<F>()` grammar yet, so a lowered module
    # cannot carry an acquisition site. Returning an empty list is the honest
    # answer, not a stubbed-out one.
    []
