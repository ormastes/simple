# Persistent frontend metadata must outlive a borrowed per-file parse scope.
# Caller precondition: current owner has successfully paused its live scope.
use compiler.frontend.aspect_registry.{aspect_registry_promote_transient_owner}
use compiler.frontend.effect_registry.{effect_registry_promote_transient_owner}
use compiler.frontend.rt_criticality_registry.{rt_criticality_promote_transient_owner}
use compiler.frontend.layer_eq_registry.{layer_eq_registry_promote_transient_owner}
use compiler.core.parser.{parser_promote_transient_owners}
use compiler.core.parser_decls.{parser_declaration_metadata_promote_transient_owner}
use compiler.frontend.resource_registry.{resource_registry_promote_transient_owner}
use compiler.frontend.frontend_parse_cache.{frontend_parse_cache_promote_transient_owner}
use compiler.frontend.frontend_shared_parse_cas_v1.{frontend_shared_parse_promote_transient_owner_v1}
use compiler.core.ast_coverage_inventory.{compiler_coverage_inventory_promote_transient_owner}
use std.nogc_sync_mut.io.process_ops.{eprint}

pub fn frontend_promote_parse_registry_owners_v1() -> bool:
    val aspect_ok = aspect_registry_promote_transient_owner()
    val effect_ok = effect_registry_promote_transient_owner()
    val rt_criticality_ok = rt_criticality_promote_transient_owner()
    val layer_ok = layer_eq_registry_promote_transient_owner()
    aspect_ok and effect_ok and rt_criticality_ok and layer_ok

pub fn frontend_promote_retained_parse_owners_v1(parser_entered: bool) -> bool:
    val registry_ok = if parser_entered: frontend_promote_parse_registry_owners_v1() else: true
    val parser_ok = if parser_entered: parser_promote_transient_owners() else: true
    val declaration_ok = if parser_entered: parser_declaration_metadata_promote_transient_owner() else: true
    val resource_ok = if parser_entered: resource_registry_promote_transient_owner() else: true
    val cache_ok = frontend_parse_cache_promote_transient_owner()
    val shared_ok = frontend_shared_parse_promote_transient_owner_v1()
    val coverage_ok = compiler_coverage_inventory_promote_transient_owner()
    val retained = registry_ok and parser_ok and declaration_ok and resource_ok and cache_ok and shared_ok and coverage_ok
    if not retained:
        eprint("[frontend-owner-promote] registry={registry_ok} parser={parser_ok} declaration={declaration_ok} resource={resource_ok} cache={cache_ok} shared={shared_ok} coverage={coverage_ok} entered={parser_entered}")
    retained
