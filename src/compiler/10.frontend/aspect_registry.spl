# `@advice(KIND, SELECTOR[, MODE])` + `@readonly` / `@noalloc` / `@bounded_time`
# declaration registry (C3, doc/03_plan/ui/perf/
# render_perf_redesign_plan_2026-08-06.md §3 "C3 - logical AOP join points";
# milestone M5 of doc/03_plan/compiler/forwarding/
# zero_cost_layers_c0_c5_staged_implementation_plan_2026-08-07.md).
#
# BEFORE this file existed there was NO way to spell an aspect that targets a
# LOGICAL join point. `70.backend/backend/interpreter_aop_weave.spl` and
# `50.mir/mir_aop_injection.spl` weave against PHYSICAL functions; C3's whole
# point is that "a business-logic-free forwarder need not exist physically for
# advice to observe it", so a physical-function pointcut cannot express it.
#
# This registry is a DELIBERATE MIRROR of `effect_registry.spl` (C4), which is
# itself a mirror of `layer_eq_registry.spl` (C1): same "<module path>|<name>"
# claim keys, same module-scoped reset, same inert `__..._decl(...)` marker
# handoff through `_FlatAstBridge/module_assembly.spl`, same drain-after-HIR
# consumer (`35.semantics/aspect_validation.spl`). Sibling implementations that
# drift are this tree's highest-yield defect class; there is exactly one shape
# here and this is it.
#
# Why a side-registry and not a `HirFunction` field: identical reasoning to
# `effect_registry.spl` -- a new struct field would force edits across
# 10.frontend, 20.hir, 35.semantics, 70.backend and 80.driver, several of which
# are owned by other in-flight sessions on this shared working copy.
#
# Reset: `parser_init_with_path` (10.frontend/core/parser.spl) calls
# `aspect_registry_reset_module(path)` on every fresh parse, right beside
# `effect_registry_reset_module(path)`.
#
# NOTE ON KIND/MODE VALIDATION: none happens here. 10.frontend records the raw
# spelling verbatim; `35.semantics/aspect_validation.spl` owns every verdict.
# Validating in two places is how a typo ends up accepted by one and rejected
# by the other.

# Default weave mode when `@advice(KIND, SELECTOR)` names none. The C3 spec
# lists three modes (static weave / startup dynload / live reload) and the
# staged plan scopes "static-weave mode only for the first slice"; static is
# therefore both the default and the only mode the validator accepts.
val ASPECT_MODE_DEFAULT: text = "static"

extern fn rt_transient_heap_promote(value: Any) -> bool

var aspect_registry_fns: [text] = []
var aspect_registry_kinds: Dict<text, text> = {}
var aspect_registry_selectors: Dict<text, text> = {}
var aspect_registry_modes: Dict<text, text> = {}
var aspect_registry_readonly: Dict<text, bool> = {}
var aspect_registry_noalloc: Dict<text, bool> = {}
var aspect_registry_bounded_time: Dict<text, bool> = {}

fn aspect_registry_reset():
    aspect_registry_fns = []
    aspect_registry_kinds = {}
    aspect_registry_selectors = {}
    aspect_registry_modes = {}
    aspect_registry_readonly = {}
    aspect_registry_noalloc = {}
    aspect_registry_bounded_time = {}

# Per-parse scoped reset: drop only the claims recorded for `path`, keeping
# every OTHER module's claims alive.
#
# A whole-registry wipe would be WRONG here and silently fail open, for the
# reason spelled out in `layer_eq_registry.spl` and repeated in
# `effect_registry.spl`: a multi-module compile parses every module before any
# HIR-stage validation runs, so a blanket reset would leave only the
# LAST-parsed module's advice to check and every earlier module's obligations
# would go unproven while still reporting green.
fn aspect_registry_reset_module(path: text):
    val prefix = path + "|"
    var kept: [text] = []
    var kept_kinds: Dict<text, text> = {}
    var kept_selectors: Dict<text, text> = {}
    var kept_modes: Dict<text, text> = {}
    var kept_readonly: Dict<text, bool> = {}
    var kept_noalloc: Dict<text, bool> = {}
    var kept_bounded_time: Dict<text, bool> = {}
    for key in aspect_registry_fns:
        if key.starts_with(prefix):
            continue
        kept.push(key)
        if aspect_registry_kinds.contains_key(key):
            kept_kinds[key] = aspect_registry_kinds[key]
        if aspect_registry_selectors.contains_key(key):
            kept_selectors[key] = aspect_registry_selectors[key]
        if aspect_registry_modes.contains_key(key):
            kept_modes[key] = aspect_registry_modes[key]
        if aspect_registry_readonly.contains_key(key):
            kept_readonly[key] = aspect_registry_readonly[key]
        if aspect_registry_noalloc.contains_key(key):
            kept_noalloc[key] = aspect_registry_noalloc[key]
        if aspect_registry_bounded_time.contains_key(key):
            kept_bounded_time[key] = aspect_registry_bounded_time[key]
    aspect_registry_fns = kept
    aspect_registry_kinds = kept_kinds
    aspect_registry_selectors = kept_selectors
    aspect_registry_modes = kept_modes
    aspect_registry_readonly = kept_readonly
    aspect_registry_noalloc = kept_noalloc
    aspect_registry_bounded_time = kept_bounded_time

fn aspect_registry_promote_transient_owner() -> bool:
    val fns_ok = rt_transient_heap_promote(aspect_registry_fns)
    val kinds_ok = rt_transient_heap_promote(aspect_registry_kinds)
    val selectors_ok = rt_transient_heap_promote(aspect_registry_selectors)
    val modes_ok = rt_transient_heap_promote(aspect_registry_modes)
    val readonly_ok = rt_transient_heap_promote(aspect_registry_readonly)
    val noalloc_ok = rt_transient_heap_promote(aspect_registry_noalloc)
    val bounded_ok = rt_transient_heap_promote(aspect_registry_bounded_time)
    fns_ok and kinds_ok and selectors_ok and modes_ok and readonly_ok and noalloc_ok and bounded_ok

fn aspect_claim_key(path: text, fn_name: text) -> text:
    path + "|" + fn_name

fn aspect_claim_path(key: text) -> text:
    val parts = key.split("|")
    if parts.len() == 0:
        return ""
    parts[0]

fn aspect_claim_fn(key: text) -> text:
    val parts = key.split("|")
    if parts.len() < 2:
        return ""
    parts[1]

# Record one advice declaration.
#
# `kind` and `selector` are the raw idents from `@advice(KIND, SELECTOR)`.
# `mode` is the optional third ident, or "" -- normalised to
# ASPECT_MODE_DEFAULT here so exactly one place decides what "unspecified"
# means. An advice with an EMPTY kind or selector is still recorded (with the
# empty spelling intact) rather than dropped: the validator rejects it. Dropping
# it here would make a malformed `@advice()` compile clean, which is the
# fail-open direction.
#
# Re-declaring the same (path, fn) overwrites rather than duplicates, so a
# re-parse of one module cannot make the validator report the same obligation
# twice.
fn aspect_registry_declare(path: text, fn_name: text, kind: text, selector: text,
                           mode: text, readonly: bool, noalloc: bool, bounded_time: bool):
    if fn_name == "":
        return
    val key = aspect_claim_key(path, fn_name)
    if not aspect_registry_fns.contains(key):
        aspect_registry_fns.push(key)
    aspect_registry_kinds[key] = kind
    aspect_registry_selectors[key] = selector
    var effective_mode = mode
    if effective_mode == "":
        effective_mode = ASPECT_MODE_DEFAULT
    aspect_registry_modes[key] = effective_mode
    aspect_registry_readonly[key] = readonly
    aspect_registry_noalloc[key] = noalloc
    aspect_registry_bounded_time[key] = bounded_time

fn aspect_registry_claim_keys() -> [text]:
    aspect_registry_fns

fn aspect_is_declared(path: text, fn_name: text) -> bool:
    aspect_registry_fns.contains(aspect_claim_key(path, fn_name))

fn aspect_registry_kind_of_key(key: text) -> text:
    if aspect_registry_kinds.contains_key(key):
        return aspect_registry_kinds[key]
    ""

fn aspect_registry_selector_of_key(key: text) -> text:
    if aspect_registry_selectors.contains_key(key):
        return aspect_registry_selectors[key]
    ""

fn aspect_registry_mode_of_key(key: text) -> text:
    if aspect_registry_modes.contains_key(key):
        return aspect_registry_modes[key]
    ""

# The three advice obligations of the C3 spec ("advice declares `@readonly
# @noalloc @bounded_time`"). Absent reads FALSE, never true: an advice whose
# attributes failed to parse must be REJECTED for missing them, not waved
# through as if it had declared them.
fn aspect_registry_readonly_of_key(key: text) -> bool:
    if aspect_registry_readonly.contains_key(key):
        return aspect_registry_readonly[key]
    false

fn aspect_registry_noalloc_of_key(key: text) -> bool:
    if aspect_registry_noalloc.contains_key(key):
        return aspect_registry_noalloc[key]
    false

fn aspect_registry_bounded_time_of_key(key: text) -> bool:
    if aspect_registry_bounded_time.contains_key(key):
        return aspect_registry_bounded_time[key]
    false

fn aspect_registry_kind_of(path: text, fn_name: text) -> text:
    aspect_registry_kind_of_key(aspect_claim_key(path, fn_name))

fn aspect_registry_selector_of(path: text, fn_name: text) -> text:
    aspect_registry_selector_of_key(aspect_claim_key(path, fn_name))

fn aspect_registry_mode_of(path: text, fn_name: text) -> text:
    aspect_registry_mode_of_key(aspect_claim_key(path, fn_name))

# ===== Parse-time scratch for the stacked advice attributes =====
#
# The four attributes stack on one function:
#
#     @advice(forward, submit)
#     @readonly
#     @noalloc
#     @bounded_time
#     fn trace_submit(): ...
#
# and `parse_module_body`'s decorator arm consumes ONE `@` per loop iteration,
# so every attribute but the last must survive to the iteration that finally
# sees the `fn` token. These vars carry them, and the merge is
# order-independent: whichever attribute lands on the `fn` emits the marker
# carrying all the facts accumulated so far.
#
# Kept here rather than as `PENDING_*` globals in `enum_module_body.spl` so
# producer and consumer read one definition instead of two drifting copies --
# the same call `effect_pending_*` and `layer_field_pending_*` both make.

var aspect_pending_kind: text = ""
var aspect_pending_selector: text = ""
var aspect_pending_mode: text = ""
var aspect_pending_readonly: bool = false
var aspect_pending_noalloc: bool = false
var aspect_pending_bounded_time: bool = false
var aspect_pending_saw_advice: bool = false

fn aspect_pending_reset():
    aspect_pending_kind = ""
    aspect_pending_selector = ""
    aspect_pending_mode = ""
    aspect_pending_readonly = false
    aspect_pending_noalloc = false
    aspect_pending_bounded_time = false
    aspect_pending_saw_advice = false

fn aspect_pending_set_advice(kind: text, selector: text, mode: text):
    aspect_pending_kind = kind
    aspect_pending_selector = selector
    aspect_pending_mode = mode
    aspect_pending_saw_advice = true

fn aspect_pending_set_readonly():
    aspect_pending_readonly = true

fn aspect_pending_set_noalloc():
    aspect_pending_noalloc = true

fn aspect_pending_set_bounded_time():
    aspect_pending_bounded_time = true

fn aspect_pending_kind_get() -> text:
    aspect_pending_kind

fn aspect_pending_selector_get() -> text:
    aspect_pending_selector

fn aspect_pending_mode_get() -> text:
    aspect_pending_mode

fn aspect_pending_readonly_get() -> bool:
    aspect_pending_readonly

fn aspect_pending_noalloc_get() -> bool:
    aspect_pending_noalloc

fn aspect_pending_bounded_time_get() -> bool:
    aspect_pending_bounded_time

# True once an `@advice(...)` has been seen in the current decorator stack.
#
# This is what makes a BARE `@readonly` (no `@advice` above it) a no-op rather
# than a phantom advice claim on an unrelated function: the emit arm only
# records when this is set.
fn aspect_pending_saw_advice_get() -> bool:
    aspect_pending_saw_advice

export ASPECT_MODE_DEFAULT
export aspect_registry_reset, aspect_registry_reset_module, aspect_registry_declare
export aspect_registry_claim_keys, aspect_claim_key, aspect_claim_path, aspect_claim_fn
export aspect_is_declared
export aspect_registry_kind_of, aspect_registry_kind_of_key
export aspect_registry_selector_of, aspect_registry_selector_of_key
export aspect_registry_mode_of, aspect_registry_mode_of_key
export aspect_registry_readonly_of_key, aspect_registry_noalloc_of_key
export aspect_registry_bounded_time_of_key
export aspect_registry_promote_transient_owner
export aspect_pending_reset, aspect_pending_set_advice
export aspect_pending_set_readonly, aspect_pending_set_noalloc, aspect_pending_set_bounded_time
export aspect_pending_kind_get, aspect_pending_selector_get, aspect_pending_mode_get
export aspect_pending_readonly_get, aspect_pending_noalloc_get, aspect_pending_bounded_time_get
export aspect_pending_saw_advice_get
