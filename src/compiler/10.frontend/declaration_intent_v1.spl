# A source fact bound by the module dispatcher to its original declaration.
# raw_decl_id is local to one parse snapshot, never a global symbol identity.
# The containing ParserModule supplies path and selected-source SHA256; byte
# offsets refer to preprocessed lexer input, not an inferred raw-file mapping. Scope,
# resolved exports and requester access are deliberately not inferred here.
pub struct ParserDeclarationIntentV1:
    raw_decl_id: i64
    source_start: i64
    modifier: text
    decl_kind: i64
    decl_name: text

export ParserDeclarationIntentV1
