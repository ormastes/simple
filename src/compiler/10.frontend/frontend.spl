# Compiler Frontend Runner
#
# Shared frontend entrypoint for full Simple compiler modes:
# outline (TreeSitter) -> block resolution -> full parse -> desugar.
#
# This keeps frontend orchestration centralized so compiler modes
# (check/interpret/jit/aot) all consume exactly one parse pipeline.

use compiler.frontend.parser_types.{ParserModule, DomainBlock}
use compiler.frontend.flat_ast_bridge.{parse_and_build_module_scoped}
use compiler.frontend.flat_ast_bridge.{build_module_from_flat_pool_blob, flat_pool_capture_arm, flat_pool_capture_take}
use compiler.frontend.frontend_parse_cache.{frontend_parse_cache_enabled, frontend_parse_cache_key}
use compiler.frontend.frontend_parse_cache.{frontend_parse_cache_load, frontend_parse_cache_store}
use compiler.frontend.frontend_parse_cache.{frontend_parse_cache_note_hit, frontend_parse_cache_note_miss}
use compiler.frontend.desugar.desugar_async.{desugar_module}
use compiler.common.diagnostics.span.{Span}
use std.nogc_sync_mut.io.process_ops.{eprint}
# @cfg/@when conditional-compilation preprocessor. Delegate to the real
# implementation under a UNIQUE name: a local `preprocess_conditionals` that
# collided with a same-name `use` import previously shadowed the real one,
# leaving @cfg stripping inert (all arch variants survived → wrong-arch
# dispatch, e.g. arm64 byte_len on x86_64). The unique `_pp_*` name cannot
# collide, so the real stripping always runs.
use compiler.core.parser_preprocessor.{_pp_preprocess_conditionals}
fn preprocess_conditionals(source: text) -> text:
    _pp_preprocess_conditionals(source)
use compiler.common.config.{Logger}
use std.io_runtime.{env_get_opt}

@unsafe(reason: "raw wall-clock timestamp ABI", capabilities: [ffi])
extern fn rt_time_now_unix_micros() -> i64

fn frontend_log_trace(log: Logger, message: text):
    if log.level >= 20:
        pass_dn

var _frontend_phase_trace_state: i64 = -1

@always_inline
fn frontend_phase_trace_enabled() -> bool:
    if _frontend_phase_trace_state < 0:
        _frontend_phase_trace_state = if env_get_opt("SIMPLE_COMPILER_TRACE") == Some("1"): 1 else: 0
    _frontend_phase_trace_state == 1

# Cache-boundary attribution is deliberately independent from the broader
# parse profile.  It is OFF unless explicitly requested, so normal compiler
# output remains byte-for-byte silent.
var _frontend_cache_boundary_profile_state: i64 = -1

@always_inline
fn frontend_cache_boundary_profile_enabled() -> bool:
    if _frontend_cache_boundary_profile_state < 0:
        # env_get_opt carries an optional text through the flattened frontend.
        # Compare its normalized value, not an Option constructor: the latter
        # did not match in the bootstrap interpreter even when the bridge's
        # equivalent raw-env gate was enabled.
        _frontend_cache_boundary_profile_state = if (env_get_opt("SIMPLE_FRONTEND_CACHE_BOUNDARY_PROFILE") ?? "") == "1": 1 else: 0
    _frontend_cache_boundary_profile_state == 1

@always_inline
fn frontend_cache_boundary_profile_now() -> i64:
    unsafe(capabilities: [ffi]):
        rt_time_now_unix_micros()

fn frontend_domain_kind_for_line(line: text) -> text:
    val kinds = ["schema", "style", "ui", "music", "bim", "cad", "city", "rtl"]
    for kind in kinds:
        if line.starts_with(kind + "{") and line.ends_with("}"):
            return kind
    ""

fn frontend_may_have_domain_block(source: text) -> bool:
    (source.contains("schema{") or source.contains("style{") or
        source.contains("ui{") or source.contains("music{") or
        source.contains("bim{") or source.contains("cad{") or
        source.contains("city{") or source.contains("rtl{"))

fn frontend_extract_domain_blocks(source: text) -> ([DomainBlock], text):
    var blocks: [DomainBlock] = []
    var lines: [text] = []
    for raw_line in source.split("\n"):
        val line = raw_line.trim()
        val kind = frontend_domain_kind_for_line(line)
        if kind != "":
            val payload = line.substring(kind.len() + 1, line.len() - 1).trim()
            blocks.push(DomainBlock(kind, payload, "module", Span.empty()))
            lines.push("")
        else:
            lines.push(raw_line)
    (blocks, lines.join("\n"))


# Front-end cache boundary. A HIT restores the flat pools and runs the same
# bridge, so what comes back is the identical ParserModule and everything after
# this point -- domain blocks, async desugar, surfaces, HIR, type checking --
# runs unchanged. See src/compiler/10.frontend/frontend_parse_cache.spl for why
# that makes the cache sound with no dependency-invalidation prerequisite.
#
# Every doubt is a MISS. A missing key (source not on disk), an absent entry, a
# foreign scope, a torn blob: all fall through to a real parse.
fn frontend_parse_or_restore(parse_source: text, file_path: text, streaming_scope: bool) -> ParserModule:
    val key = if frontend_parse_cache_enabled(): frontend_parse_cache_key(file_path) else: ""
    if key != "":
        val load_t0 = if frontend_cache_boundary_profile_enabled(): frontend_cache_boundary_profile_now() else: 0
        val cached_blob = frontend_parse_cache_load(key)
        if frontend_cache_boundary_profile_enabled():
            val load_t1 = frontend_cache_boundary_profile_now()
            print("PARSECACHE\tload_ms={(load_t1 - load_t0) / 1000}\tbytes={cached_blob.len()}\tpath={file_path}")
        val cached_module = build_module_from_flat_pool_blob(
            cached_blob, parse_source, file_path)
        if cached_module != nil:
            val hit = cached_module.unwrap()
            frontend_parse_cache_note_hit()
            return hit
        frontend_parse_cache_note_miss()
        flat_pool_capture_arm()
        val fresh = parse_and_build_module_scoped(parse_source, file_path, streaming_scope)
        val captured_blob = flat_pool_capture_take()
        val store_t0 = if frontend_cache_boundary_profile_enabled(): frontend_cache_boundary_profile_now() else: 0
        val stored = frontend_parse_cache_store(key, captured_blob)
        if frontend_cache_boundary_profile_enabled():
            val store_t1 = frontend_cache_boundary_profile_now()
            print("PARSECACHE\tstore_ms={(store_t1 - store_t0) / 1000}\tbytes={captured_blob.len()}\tstored={stored}\tpath={file_path}")
        return fresh
    parse_and_build_module_scoped(parse_source, file_path, streaming_scope)

fn parse_full_frontend_with_scope(source: text, file_path: text, module_name: text, log: Logger, streaming_scope: bool) -> ParserModule:
    val preprocessed = preprocess_conditionals(source)
    var domain_blocks: [DomainBlock] = []
    var parse_source = preprocessed
    if frontend_may_have_domain_block(preprocessed):
        val (found_blocks, stripped_source) = frontend_extract_domain_blocks(preprocessed)
        domain_blocks = found_blocks
        parse_source = stripped_source

    frontend_log_trace(log, "2: core parser bridge...")
    if frontend_phase_trace_enabled():
        eprint("[frontend] parse_and_build:start path={file_path}")
    var module = frontend_parse_or_restore(parse_source, file_path, streaming_scope)
    if domain_blocks.len() > 0:
        module.domain_blocks = domain_blocks
    if frontend_phase_trace_enabled():
        eprint("[frontend] parse_and_build:done path={file_path}")
    if frontend_phase_trace_enabled():
        print "[frontend] parsed module path={file_path}"

    # Phase 2d: Desugar async/await/spawn/actor syntax
    frontend_log_trace(log, "2d: desugaring...")
    val desugar_t0 = if frontend_cache_boundary_profile_enabled(): frontend_cache_boundary_profile_now() else: 0
    module = desugar_module(module)
    if frontend_cache_boundary_profile_enabled():
        val desugar_t1 = frontend_cache_boundary_profile_now()
        print("PARSECACHE\tdesugar_ms={(desugar_t1 - desugar_t0) / 1000}\tpath={file_path}")

    # Return the parsed-and-desugared module (declared return type is ParserModule).
    module

fn parse_full_frontend(source: text, file_path: text, module_name: text, log: Logger) -> ParserModule:
    parse_full_frontend_with_scope(source, file_path, module_name, log, false)

pub fn parse_full_frontend_stage4_streaming(source: text, file_path: text, module_name: text, log: Logger) -> ParserModule:
    parse_full_frontend_with_scope(source, file_path, module_name, log, true)
