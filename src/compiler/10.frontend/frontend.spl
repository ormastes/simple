# Compiler Frontend Runner
#
# Shared frontend entrypoint for full Simple compiler modes:
# outline (TreeSitter) -> block resolution -> full parse -> desugar.
#
# This keeps frontend orchestration centralized so compiler modes
# (check/interpret/jit/aot) all consume exactly one parse pipeline.

use compiler.frontend.parser_types.{ParserModule, DomainBlock}
use compiler.frontend.flat_ast_bridge.{parse_and_build_module_scoped, parse_and_build_module_in_borrowed_scope}
use compiler.frontend.flat_ast_bridge.{build_module_from_flat_pool_blob, flat_pool_capture_arm, flat_pool_capture_take}
use compiler.frontend.frontend_parse_cache.{frontend_parse_cache_enabled, frontend_parse_cache_key}
use compiler.frontend.frontend_parse_cache.{frontend_parse_cache_load, frontend_parse_cache_store}
use compiler.frontend.frontend_parse_cache.{frontend_parse_cache_note_hit, frontend_parse_cache_note_miss}
use compiler.frontend.core.collection_feedback.{parser_collection_feedback_active}
use compiler.frontend.desugar.desugar_async.{desugar_module}
use compiler.common.diagnostics.span.{Span}
use std.nogc_sync_mut.io.process_ops.{eprint}
use std.env.{env_get}
# @cfg/@when conditional-compilation preprocessor. Delegate to the real
# implementation under a UNIQUE name: a local `preprocess_conditionals` that
# collided with a same-name `use` import previously shadowed the real one,
# leaving @cfg stripping inert (all arch variants survived → wrong-arch
# dispatch, e.g. arm64 byte_len on x86_64). The unique `_pp_*` name cannot
# collide, so the real stripping always runs.
use compiler.core.parser_preprocessor.{_pp_preprocess_conditionals}
fn preprocess_conditionals(source: text) -> text:
    _pp_preprocess_conditionals(source)
use compiler.common.config.{Logger}
use std.io_runtime.{env_get_opt}
use compiler.frontend.frontend_advisory_preprocess_port_v1.{
    FrontendAdvisoryPreprocessPolicyV1,
    FrontendAdvisoryPreprocessDispatchErrorV1,
    frontend_advisory_preprocess_dispatch_checked_scoped_v1}
use std.common.crypto.sha256.sha256_text
use compiler.core.parser.{parser_path_is_script}
use compiler.common.cache.frontend_parse_identity_v2.{
    frontend_parse_policy_digest_v2, frontend_parse_key_from_digests_v2,
    frontend_parse_identity_frame_v2, frontend_parse_identity_valid_v2}
use compiler.frontend.frontend_parse_cache.{
    frontend_parse_cache_load_bound_v2, frontend_parse_cache_store_bound_v2,
    frontend_parse_cache_current_header_v2}
use compiler.common.cache.reverse_reference_facts.{
    reverse_reference_owner_register_v1, reverse_reference_owner_register_source_alias_v1,
    reverse_reference_owner_active_v2}

# One per-call evidence handoff, never an AST map. Borrowed calls promote only
# their bounded evidence strings. The driver publishes facts AFTER scope close,
# so earlier receipt graphs are not walked/promoted again for every source.
var _frontend_pending_receipt_v2: [text] = []
var _frontend_pending_receipt_promoted_v2: bool = false

@unsafe(reason: "promote bounded receipt handoff during driver-owned paused scope", capabilities: [ffi])
extern fn rt_transient_heap_promote(value: Any) -> bool

fn frontend_promote_pending_parser_identity_v2() -> bool:
    if _frontend_pending_receipt_v2 == nil or _frontend_pending_receipt_v2.len() == 0:
        return true
    unsafe(capabilities: [ffi]):
        _frontend_pending_receipt_promoted_v2 = rt_transient_heap_promote(_frontend_pending_receipt_v2)
    _frontend_pending_receipt_promoted_v2

fn frontend_abandon_unpromoted_parser_identity_v2():
    if not _frontend_pending_receipt_promoted_v2:
        # No allocation while the dying parser scope is active.
        _frontend_pending_receipt_v2 = nil

fn frontend_publish_pending_parser_identity_v2():
    if _frontend_pending_receipt_promoted_v2 and _frontend_pending_receipt_v2 != nil and
            _frontend_pending_receipt_v2.len() == 2:
        val path = _frontend_pending_receipt_v2[0]
        val evidence = _frontend_pending_receipt_v2[1]
        reverse_reference_owner_register_source_alias_v1(path, path)
        reverse_reference_owner_register_v1("frontend-parser-input-v2", path, path, evidence)
    # Called only after scope close. This empty owner is process-lived.
    _frontend_pending_receipt_v2 = []
    _frontend_pending_receipt_promoted_v2 = false

fn frontend_publish_parser_identity_v2(path: text, key: text, identity: text,
    blob: text, borrowed_scope: bool):
    if not reverse_reference_owner_active_v2() or not frontend_parse_identity_valid_v2(identity, key, true):
        return
    val evidence = identity + "|" + sha256_text(blob) + "|" +
        sha256_text(frontend_parse_cache_current_header_v2())
    if borrowed_scope:
        _frontend_pending_receipt_v2 = [path, evidence]
        _frontend_pending_receipt_promoted_v2 = false
    else:
        reverse_reference_owner_register_source_alias_v1(path, path)
        reverse_reference_owner_register_v1("frontend-parser-input-v2", path, path, evidence)

export frontend_publish_pending_parser_identity_v2
export frontend_promote_pending_parser_identity_v2, frontend_abandon_unpromoted_parser_identity_v2

@unsafe(reason: "raw wall-clock timestamp ABI", capabilities: [ffi])
extern fn rt_time_now_unix_micros() -> i64

fn frontend_log_trace(log: Logger, message: text):
    if log.level >= 20:
        pass_dn

var _frontend_phase_trace_state: i64 = -1

@always_inline
fn frontend_phase_trace_enabled() -> bool:
    if _frontend_phase_trace_state < 0:
        _frontend_phase_trace_state = if env_get_opt("SIMPLE_COMPILER_TRACE") == Some("1"): 1 else: 0
    _frontend_phase_trace_state == 1

# Cache-boundary attribution is deliberately independent from the broader
# parse profile.  It is OFF unless explicitly requested, so normal compiler
# output remains byte-for-byte silent.
var _frontend_cache_boundary_profile_state: i64 = -1

@always_inline
fn frontend_cache_boundary_profile_enabled() -> bool:
    if _frontend_cache_boundary_profile_state < 0:
        # env_get_opt carries an optional text through the flattened frontend.
        # Compare its normalized value, not an Option constructor: the latter
        # did not match in the bootstrap interpreter even when the bridge's
        # equivalent raw-env gate was enabled.
        _frontend_cache_boundary_profile_state = if (env_get_opt("SIMPLE_FRONTEND_CACHE_BOUNDARY_PROFILE") ?? "") == "1": 1 else: 0
    _frontend_cache_boundary_profile_state == 1

@always_inline
fn frontend_cache_boundary_profile_now() -> i64:
    unsafe(capabilities: [ffi]):
        rt_time_now_unix_micros()

fn frontend_domain_kind_for_line(line: text) -> text:
    val kinds = ["schema", "style", "ui", "music", "bim", "cad", "city", "rtl"]
    for kind in kinds:
        if line.starts_with(kind + "{") and line.ends_with("}"):
            return kind
    ""

fn frontend_may_have_domain_block(source: text) -> bool:
    (source.contains("schema{") or source.contains("style{") or
        source.contains("ui{") or source.contains("music{") or
        source.contains("bim{") or source.contains("cad{") or
        source.contains("city{") or source.contains("rtl{"))

fn frontend_extract_domain_blocks(source: text) -> ([DomainBlock], text):
    var blocks: [DomainBlock] = []
    var lines: [text] = []
    for raw_line in source.split("\n"):
        val line = raw_line.trim()
        val kind = frontend_domain_kind_for_line(line)
        if kind != "":
            val payload = line.substring(kind.len() + 1, line.len() - 1).trim()
            blocks.push(DomainBlock(kind, payload, "module", Span.empty()))
            lines.push("")
        else:
            lines.push(raw_line)
    (blocks, lines.join("\n"))


# Front-end cache boundary. A HIT restores the flat pools and runs the same
# bridge, so what comes back is the identical ParserModule and everything after
# this point -- domain blocks, async desugar, surfaces, HIR, type checking --
# runs unchanged. See src/compiler/10.frontend/frontend_parse_cache.spl for why
# that makes the cache sound with no dependency-invalidation prerequisite.
#
# Every doubt is a MISS. A missing identity, an absent entry, a
# foreign scope, a torn blob: all fall through to a real parse.
fn frontend_parse_or_restore(parse_source: text, file_path: text, streaming_scope: bool,
    advisory_cache_identity: text, borrowed_scope: bool,
    frozen_raw_digest: text = "", frozen_raw_generation: text = "") -> ParserModule:
    # Feedback-enriched ASTs remain uncached. Ordinary identity binds the
    # actual transformed parser text and path-dependent warning/advisory policy.
    val cache_active = frontend_parse_cache_enabled() and not parser_collection_feedback_active()
    val parser_digest = if cache_active: sha256_text(parse_source) else: ""
    val policy_digest = if cache_active:
        frontend_parse_policy_digest_v2(parser_path_is_script(file_path), advisory_cache_identity)
    else:
        ""
    val key = frontend_parse_key_from_digests_v2(parser_digest, policy_digest)
    val identity = if key != "":
        frontend_parse_identity_frame_v2(parser_digest, policy_digest,
            frozen_raw_digest, frozen_raw_generation)
    else:
        ""
    if key != "":
        val load_t0 = if frontend_cache_boundary_profile_enabled(): frontend_cache_boundary_profile_now() else: 0
        val (cached_identity, cached_blob) = frontend_parse_cache_load_bound_v2(key)
        if frontend_cache_boundary_profile_enabled():
            val load_t1 = frontend_cache_boundary_profile_now()
            print("PARSECACHE\tload_ms={(load_t1 - load_t0) / 1000}\tbytes={cached_blob.len()}\tpath={file_path}")
        val cached_module = build_module_from_flat_pool_blob(
            cached_blob, parse_source, file_path)
        if cached_module != nil:
            val hit = cached_module.unwrap()
            frontend_parse_cache_note_hit()
            # Local AST sharing may span different raw snapshots with identical
            # transformed input. Publish CURRENT frozen provenance, never the
            # old entry's raw generation.
            frontend_publish_parser_identity_v2(file_path, key, identity, cached_blob, borrowed_scope)
            if (env_get("SIMPLE_M4_WORK_RECEIPT") ?? "") == "1":
                print "[M4 parse] module={file_path} work=0 imports={hit.imports.len()}"
            return hit
        frontend_parse_cache_note_miss()
        flat_pool_capture_arm()
        val fresh = if borrowed_scope:
            parse_and_build_module_in_borrowed_scope(parse_source, file_path)
        else:
            parse_and_build_module_scoped(parse_source, file_path, streaming_scope)
        if (env_get("SIMPLE_M4_WORK_RECEIPT") ?? "") == "1":
            print "[M4 parse] module={file_path} work=1 imports={fresh.imports.len()}"
        val captured_blob = flat_pool_capture_take()
        val store_t0 = if frontend_cache_boundary_profile_enabled(): frontend_cache_boundary_profile_now() else: 0
        val content_identity = frontend_parse_identity_frame_v2(
            parser_digest, policy_digest, "", "")
        val stored = frontend_parse_cache_store_bound_v2(key, content_identity, captured_blob)
        if stored:
            frontend_publish_parser_identity_v2(file_path, key, identity, captured_blob, borrowed_scope)
        if frontend_cache_boundary_profile_enabled():
            val store_t1 = frontend_cache_boundary_profile_now()
            print("PARSECACHE\tstore_ms={(store_t1 - store_t0) / 1000}\tbytes={captured_blob.len()}\tstored={stored}\tpath={file_path}")
        return fresh
    val uncached = if borrowed_scope:
        parse_and_build_module_in_borrowed_scope(parse_source, file_path)
    else:
        parse_and_build_module_scoped(parse_source, file_path, streaming_scope)
    if (env_get("SIMPLE_M4_WORK_RECEIPT") ?? "") == "1":
        print "[M4 parse] module={file_path} work=1 imports={uncached.imports.len()}"
    uncached

fn parse_full_frontend_with_scope(source: text, file_path: text, module_name: text,
    log: Logger, streaming_scope: bool, borrowed_scope: bool,
    advisory_policy: FrontendAdvisoryPreprocessPolicyV1,
    advisory_owner_id: u64, advisory_session_id: u64,
    advisory_generation: u64, advisory_cache_identity: text,
    frozen_raw_digest: text = "", frozen_raw_generation: text = ""
) -> Result<ParserModule, FrontendAdvisoryPreprocessDispatchErrorV1>:
    val preprocessed = preprocess_conditionals(source)
    var domain_blocks: [DomainBlock] = []
    var parse_source = preprocessed
    if frontend_may_have_domain_block(preprocessed):
        val (found_blocks, stripped_source) = frontend_extract_domain_blocks(preprocessed)
        domain_blocks = found_blocks
        parse_source = stripped_source

    # Advisory classification is identity-only. A required provider failure is
    # returned to the driver before the reference parser result can be admitted.
    val advisory = frontend_advisory_preprocess_dispatch_checked_scoped_v1(
        parse_source, advisory_policy, advisory_owner_id, advisory_session_id,
        advisory_generation)?
    parse_source = advisory.parse_source

    frontend_log_trace(log, "2: core parser bridge...")
    if frontend_phase_trace_enabled():
        eprint("[frontend] parse_and_build:start path={file_path}")
    var module = frontend_parse_or_restore(
        parse_source, file_path, streaming_scope, advisory_cache_identity, borrowed_scope,
        frozen_raw_digest, frozen_raw_generation)
    if domain_blocks.len() > 0:
        module.domain_blocks = domain_blocks
    if frontend_phase_trace_enabled():
        eprint("[frontend] parse_and_build:done path={file_path}")
    if frontend_phase_trace_enabled():
        print "[frontend] parsed module path={file_path}"

    # Phase 2d: Desugar async/await/spawn/actor syntax
    frontend_log_trace(log, "2d: desugaring...")
    val desugar_t0 = if frontend_cache_boundary_profile_enabled(): frontend_cache_boundary_profile_now() else: 0
    module = desugar_module(module)
    if frontend_cache_boundary_profile_enabled():
        val desugar_t1 = frontend_cache_boundary_profile_now()
        print("PARSECACHE\tdesugar_ms={(desugar_t1 - desugar_t0) / 1000}\tpath={file_path}")

    # Return the parsed-and-desugared module (declared return type is ParserModule).
    Ok(module)

fn parse_full_frontend(source: text, file_path: text, module_name: text, log: Logger) -> ParserModule:
    parse_full_frontend_with_scope(source, file_path, module_name, log, false, false,
        FrontendAdvisoryPreprocessPolicyV1.Reference, 0u64, 0u64, 0u64, "").unwrap()

# The streaming HIR owner keeps this scope active through lowering.
# This reference-policy entry borrows it and never reclaims its allocations.
pub fn parse_full_frontend_in_borrowed_scope(source: text, file_path: text,
    module_name: text, log: Logger) -> ParserModule:
    parse_full_frontend_with_scope(source, file_path, module_name, log, false, true,
        FrontendAdvisoryPreprocessPolicyV1.Reference, 0u64, 0u64, 0u64, "").unwrap()

pub fn parse_full_frontend_with_advisory_policy_v1(source: text, file_path: text,
    module_name: text, log: Logger, policy: FrontendAdvisoryPreprocessPolicyV1,
    owner_id: u64, session_id: u64, generation: u64, cache_identity: text,
    frozen_raw_digest: text = "", frozen_raw_generation: text = ""
) -> Result<ParserModule, FrontendAdvisoryPreprocessDispatchErrorV1>:
    parse_full_frontend_with_scope(source, file_path, module_name, log, false, false, policy,
        owner_id, session_id, generation, cache_identity,
        frozen_raw_digest, frozen_raw_generation)

pub fn parse_full_frontend_stage4_streaming(source: text, file_path: text, module_name: text, log: Logger) -> ParserModule:
    parse_full_frontend_with_scope(source, file_path, module_name, log, true, false,
        FrontendAdvisoryPreprocessPolicyV1.Reference, 0u64, 0u64, 0u64, "").unwrap()

# The driver retains cleanup ownership on success and every provider/parser
# error path. Cache misses borrow its existing scope; hits remain in that same
# parent lifetime until the driver commits/promotes the resulting surface.
pub fn parse_full_frontend_in_borrowed_scope_with_advisory_policy_v1(
    source: text, file_path: text, module_name: text, log: Logger,
    policy: FrontendAdvisoryPreprocessPolicyV1, owner_id: u64, session_id: u64,
    generation: u64, cache_identity: text,
    frozen_raw_digest: text = "", frozen_raw_generation: text = ""
) -> Result<ParserModule, FrontendAdvisoryPreprocessDispatchErrorV1>:
    parse_full_frontend_with_scope(source, file_path, module_name, log, false, true,
        policy, owner_id, session_id, generation, cache_identity,
        frozen_raw_digest, frozen_raw_generation)
