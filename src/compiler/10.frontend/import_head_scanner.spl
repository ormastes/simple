enum ImportHeadScanStatusV1:
    exact
    needs_full_parse

enum ImportHeadScanReasonV1:
    none
    invalid_frozen_view
    head_limit_reached
    unterminated_string
    unterminated_block_comment
    malformed_import
    unsupported_syntax

struct FrozenSourceHeadV1:
    source_identity: text
    snapshot_revision: text
    content_digest: text
    bytes: text
    complete_file: bool

struct ImportHeadScanResultV1:
    status: ImportHeadScanStatusV1
    reason: ImportHeadScanReasonV1
    imports: [text]
    bytes_examined: i64

fn import_head_identity_valid_v1(value: text) -> bool:
    value != "" and not value.contains("\n") and not value.contains("\r")

fn import_head_digest_valid_v1(value: text) -> bool:
    if value.len() != 64:
        return false
    for ch in value:
        if not ((ch >= "0" and ch <= "9") or (ch >= "a" and ch <= "f")):
            return false
    true

fn import_head_result_v1(
    status: ImportHeadScanStatusV1, reason: ImportHeadScanReasonV1,
    imports: [text], bytes_examined: i64
) -> ImportHeadScanResultV1:
    ImportHeadScanResultV1(status, reason, imports, bytes_examined)

fn import_head_sorted_unique_v1(values: [text]) -> [text]:
    var pending = values
    var result: [text] = []
    while pending.len() > 0:
        var selected = 0
        var index = 1
        while index < pending.len():
            if pending[index] < pending[selected]:
                selected = index
            index = index + 1
        val value = pending[selected]
        pending.remove(selected)
        if result.len() == 0 or result[result.len() - 1] != value:
            result.push(value)
    result

fn import_head_is_space_v1(ch: text) -> bool:
    ch == " " or ch == "\t" or ch == "\r" or ch == "\n"

fn import_head_is_name_v1(ch: text) -> bool:
    (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or
        (ch >= "0" and ch <= "9") or ch == "_" or ch == "."

fn import_head_parse_use_v1(line: text) -> text?:
    val trimmed = line.trim()
    if not trimmed.starts_with("use "):
        return nil
    var index = 4
    while index < trimmed.len() and import_head_is_space_v1(trimmed[index]):
        index = index + 1
    val start = index
    while index < trimmed.len() and import_head_is_name_v1(trimmed[index]):
        index = index + 1
    if index == start:
        return nil
    var module_name = trimmed.slice(start, index)
    if (module_name.ends_with(".") and index < trimmed.len() and
            trimmed[index] == "{"):
        module_name = module_name.slice(0, module_name.len() - 1)
    if (module_name.starts_with(".") or module_name.ends_with(".") or
            module_name.contains("..")):
        return nil
    while index < trimmed.len() and import_head_is_space_v1(trimmed[index]):
        index = index + 1
    if index == trimmed.len() or trimmed.slice(index, trimmed.len()).starts_with("#"):
        return Some(module_name)
    if trimmed.slice(index, trimmed.len()).starts_with(".{") or
            trimmed.slice(index, trimmed.len()).starts_with("{"):
        return Some(module_name)
    nil

pub fn scan_import_head_v1(
    frozen: FrozenSourceHeadV1, max_bytes: i64
) -> ImportHeadScanResultV1:
    if (max_bytes <= 0 or not import_head_identity_valid_v1(frozen.source_identity) or
            not import_head_identity_valid_v1(frozen.snapshot_revision) or
            not import_head_digest_valid_v1(frozen.content_digest)):
        return import_head_result_v1(
            ImportHeadScanStatusV1.needs_full_parse,
            ImportHeadScanReasonV1.invalid_frozen_view, [], 0)

    val limit = if frozen.bytes.len() < max_bytes: frozen.bytes.len() else: max_bytes
    var imports: [text] = []
    var line = ""
    var index = 0
    var block_depth = 0
    var quote = ""
    var escaped = false
    while index < limit:
        val ch = frozen.bytes[index]
        val next = if index + 1 < limit: frozen.bytes[index + 1] else: ""
        if block_depth > 0:
            if ch == "/" and next == "*":
                block_depth = block_depth + 1
                index = index + 2
                continue
            if ch == "*" and next == "/":
                block_depth = block_depth - 1
                index = index + 2
                continue
            index = index + 1
            continue
        if quote != "":
            if escaped:
                escaped = false
            elif ch == "\\":
                escaped = true
            elif ch == quote:
                quote = ""
            index = index + 1
            continue
        if ch == "/" and next == "*":
            block_depth = 1
            index = index + 2
            continue
        if ch == "#":
            while index < limit and frozen.bytes[index] != "\n":
                index = index + 1
            continue
        if ch == "\"" or ch == "'":
            quote = ch
            index = index + 1
            continue
        if ch == "\n":
            val trimmed = line.trim()
            if trimmed.starts_with("use"):
                val import_name = import_head_parse_use_v1(trimmed)
                if import_name == nil:
                    return import_head_result_v1(
                        ImportHeadScanStatusV1.needs_full_parse,
                        ImportHeadScanReasonV1.malformed_import, [], index + 1)
                imports.push(import_name!)
            elif trimmed != "" and not trimmed.starts_with("@"):
                return import_head_result_v1(
                    ImportHeadScanStatusV1.exact, ImportHeadScanReasonV1.none,
                    import_head_sorted_unique_v1(imports), index + 1)
            line = ""
        else:
            line = line + ch
        index = index + 1

    if quote != "":
        return import_head_result_v1(
            ImportHeadScanStatusV1.needs_full_parse,
            ImportHeadScanReasonV1.unterminated_string, [], limit)
    if block_depth != 0:
        return import_head_result_v1(
            ImportHeadScanStatusV1.needs_full_parse,
            ImportHeadScanReasonV1.unterminated_block_comment, [], limit)
    if not frozen.complete_file and limit == frozen.bytes.len():
        return import_head_result_v1(
            ImportHeadScanStatusV1.needs_full_parse,
            ImportHeadScanReasonV1.head_limit_reached, [], limit)
    if limit < frozen.bytes.len():
        return import_head_result_v1(
            ImportHeadScanStatusV1.needs_full_parse,
            ImportHeadScanReasonV1.head_limit_reached, [], limit)
    val final_line = line.trim()
    if final_line.starts_with("use"):
        val import_name = import_head_parse_use_v1(final_line)
        if import_name == nil:
            return import_head_result_v1(
                ImportHeadScanStatusV1.needs_full_parse,
                ImportHeadScanReasonV1.malformed_import, [], limit)
        imports.push(import_name!)
    import_head_result_v1(
        ImportHeadScanStatusV1.exact, ImportHeadScanReasonV1.none,
        import_head_sorted_unique_v1(imports), limit)

export ImportHeadScanStatusV1, ImportHeadScanReasonV1, FrozenSourceHeadV1
export ImportHeadScanResultV1, scan_import_head_v1
