# Per-context home for the frontend's process-env parse channels.
# The parser/lexer/AST owners mirror scalar state through process env
# (SIMPLE_PARSER_HAD_ERROR, the SIMPLE_BOOTSTRAP_PAR_* line/col channel, the
# lexer cursor and node-count mirrors) because a module var written across a
# module boundary is not always visible in native builds. take captures these
# keys and clears them; install writes them back. See
# doc/05_design/compiler/frontend/parse_context_per_context_state.md.
#
# Not covered: per-index node mirrors (SIMPLE_BOOTSTRAP_MODULE_DECL_<i> and the
# per-expr/stmt/decl field keys), written only in env-mirror bootstrap mode.
# ParseContext swapping requires those mirror modes to be off.

use std.nogc_sync_mut.io_runtime.{env_get, env_set}

fn parse_env_state_keys() -> [text]:
    [
        "SIMPLE_PARSER_HAD_ERROR", "SIMPLE_PARSER_FIRST_ERROR",
        "SIMPLE_BOOTSTRAP_PAR_KIND", "SIMPLE_BOOTSTRAP_PAR_TEXT",
        "SIMPLE_BOOTSTRAP_PAR_LINE", "SIMPLE_BOOTSTRAP_PAR_COL",
        "SIMPLE_BOOTSTRAP_LEX_SOURCE", "SIMPLE_BOOTSTRAP_LEX_PATH",
        "SIMPLE_BOOTSTRAP_LEX_POS", "SIMPLE_BOOTSTRAP_LEX_LINE",
        "SIMPLE_BOOTSTRAP_LEX_COL", "SIMPLE_BOOTSTRAP_LEX_LINE_START",
        "SIMPLE_BOOTSTRAP_LEX_PAREN", "SIMPLE_BOOTSTRAP_LEX_PENDING",
        "SIMPLE_BOOTSTRAP_LEX_INDENT", "SIMPLE_BOOTSTRAP_LEX_TOKEN_START",
        "SIMPLE_BOOTSTRAP_LEX_TOKEN_END", "SIMPLE_BOOTSTRAP_LEX_CUR_KIND",
        "SIMPLE_BOOTSTRAP_LEX_CUR_TEXT", "SIMPLE_BOOTSTRAP_LEX_CUR_LINE",
        "SIMPLE_BOOTSTRAP_LEX_CUR_COL", "SIMPLE_BOOTSTRAP_LEX_CUR_SUFFIX",
        "SIMPLE_BOOTSTRAP_CORE_TOKEN_TEXT", "SIMPLE_BOOTSTRAP_CORE_TOKEN_LINE",
        "SIMPLE_BOOTSTRAP_CORE_TOKEN_COL", "SIMPLE_BOOTSTRAP_CORE_TOKEN_SUFFIX",
        "SIMPLE_BOOTSTRAP_EXPR_COUNT", "SIMPLE_BOOTSTRAP_STMT_COUNT",
        "SIMPLE_BOOTSTRAP_DECL_COUNT", "SIMPLE_BOOTSTRAP_MODULE_DECL_COUNT"
    ]

pub struct ParseEnvState:
    values: [text]

pub fn parse_env_state_take() -> ParseEnvState:
    var values: [text] = []
    for key in parse_env_state_keys():
        values.push(env_get(key))
        env_set(key, "")
    ParseEnvState(values: values)

pub fn parse_env_state_install(s: ParseEnvState):
    val keys = parse_env_state_keys()
    for i in 0..keys.len():
        env_set(keys[i], s.values[i])

export ParseEnvState, parse_env_state_take, parse_env_state_install
