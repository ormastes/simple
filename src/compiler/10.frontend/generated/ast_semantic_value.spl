fn ast_semantic_encode_unary_op(node: UnaryOp, initial: AstSemanticHash) -> AstSemanticHash:
    if node == nil:
        return _ast_semantic_mix_tag(initial, "nil:UnaryOp")
    var state = _ast_semantic_mix_tag(initial, "UnaryOp")
    var handled = false
    match node:
        case Neg:
            handled = true
            state = _ast_semantic_mix_tag(state, "Neg")
        case Not:
            handled = true
            state = _ast_semantic_mix_tag(state, "Not")
        case BitNot:
            handled = true
            state = _ast_semantic_mix_tag(state, "BitNot")
        case Ref:
            handled = true
            state = _ast_semantic_mix_tag(state, "Ref")
        case RefMut:
            handled = true
            state = _ast_semantic_mix_tag(state, "RefMut")
        case Deref:
            handled = true
            state = _ast_semantic_mix_tag(state, "Deref")
        case Transpose:
            handled = true
            state = _ast_semantic_mix_tag(state, "Transpose")
        case _:
            handled = false
    if not handled:
        _ast_semantic_unhandled("UnaryOp", "ast_semantic_encode_unary_op")
    state

fn ast_semantic_encode_with_item(node: WithItem, initial: AstSemanticHash) -> AstSemanticHash:
    if node == nil:
        return _ast_semantic_mix_tag(initial, "nil:WithItem")
    var state = _ast_semantic_mix_tag(initial, "WithItem")
    state = ast_semantic_encode_expr(node.context_expr, state)
    state = _ast_semantic_mix_scalar_i64(state, "bool", if node.has_target: 1 else: 0)
    state = _ast_semantic_mix_i64(state, if node.has_target: 1 else: 0)
    if node.has_target:
        state = _ast_semantic_mix_scalar_text(state, "text", node.target)
    state

