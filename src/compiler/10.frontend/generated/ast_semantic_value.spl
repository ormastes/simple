        case Isolated(b_Isolated_f0):
            handled = true
            state = _ast_semantic_mix_tag(state, "Isolated")
            state = ast_semantic_encode_type(b_Isolated_f0, state)
        case Union(b_Union_f0):
            handled = true
            state = _ast_semantic_mix_tag(state, "Union")
            state = _ast_semantic_mix_i64(state, b_Union_f0.len())
            for sv0 in b_Union_f0:
                state = ast_semantic_encode_type(sv0, state)
        case Projection(b_Projection_f0, b_Projection_f1):
            handled = true
            state = _ast_semantic_mix_tag(state, "Projection")
            state = ast_semantic_encode_type(b_Projection_f0, state)
            state = _ast_semantic_mix_scalar_text(state, "text", b_Projection_f1)
        case Infer:
            handled = true
            state = _ast_semantic_mix_tag(state, "Infer")
        case Error:
            handled = true
            state = _ast_semantic_mix_tag(state, "Error")
        case Pointer(b_Pointer_f0, b_Pointer_f1):
            handled = true
            state = _ast_semantic_mix_tag(state, "Pointer")
            state = ast_semantic_encode_type(b_Pointer_f0, state)
            state = _ast_semantic_mix_scalar_i64(state, "bool", if b_Pointer_f1: 1 else: 0)
        case Weak(b_Weak_f0):
            handled = true
            state = _ast_semantic_mix_tag(state, "Weak")
            state = ast_semantic_encode_type(b_Weak_f0, state)
