fn walk_ast_stmt<C>(node: Stmt, ctx: C, f: fn(AstWalkNode, C) -> C) -> C:
    if node == nil:
        return ctx
    var acc = f(AstWalkNode.Stmt(node), ctx)
    var handled = false
    match node.kind:
        case Expr(b_f0):
            handled = true
            acc = walk_ast_expr(b_f0, acc, f)
        case Val(_, b_f1, b_f2):
            handled = true
            acc = walk_ast_type(b_f1, acc, f)
            acc = walk_ast_expr(b_f2, acc, f)
        case Var(_, b_f1, b_f2):
            handled = true
            acc = walk_ast_type(b_f1, acc, f)
            acc = walk_ast_expr(b_f2, acc, f)
        case SharedVal(_, b_f1, b_f2):
            handled = true
            acc = walk_ast_type(b_f1, acc, f)
            acc = walk_ast_expr(b_f2, acc, f)
        case SharedVar(_, b_f1, b_f2):
            handled = true
            acc = walk_ast_type(b_f1, acc, f)
            acc = walk_ast_expr(b_f2, acc, f)
        case Assign(b_f0, b_f1, b_f2):
            handled = true
            acc = walk_ast_expr(b_f0, acc, f)
            acc = walk_ast_assign_op(b_f1, acc, f)
            acc = walk_ast_expr(b_f2, acc, f)
        case For(_, b_f1, b_f2):
            handled = true
            acc = walk_ast_expr(b_f1, acc, f)
            acc = walk_ast_block(b_f2, acc, f)
        case While(b_f0, b_f1):
            handled = true
            acc = walk_ast_expr(b_f0, acc, f)
            acc = walk_ast_block(b_f1, acc, f)
        case Loop(b_f0):
            handled = true
            acc = walk_ast_block(b_f0, acc, f)
        case Break(_):
            handled = true
        case Continue(_):
            handled = true
        case Return(b_f0):
            handled = true
            acc = walk_ast_expr(b_f0, acc, f)
        case Yield(b_f0):
            handled = true
            acc = walk_ast_expr(b_f0, acc, f)
        case Throw(b_f0):
            handled = true
            acc = walk_ast_expr(b_f0, acc, f)
        case With(b_f0, b_f1):
            handled = true
            if b_f0 != nil:
                for it0 in b_f0:
                    acc = walk_ast_with_item(it0, acc, f)
            acc = walk_ast_block(b_f1, acc, f)
        case AsmAssert(b_f0):
            handled = true
            acc = walk_ast_asm_target_spec(b_f0, acc, f)
        case GpuLaunch(b_f0, b_f1):
            handled = true
            acc = walk_ast_gpu_launch_config(b_f0, acc, f)
            acc = walk_ast_block(b_f1, acc, f)
        case _:
            handled = false
    if not handled:
        ast_walk_unhandled("StmtKind", "walk_ast_stmt", ast_walk_stmt_kind_name(node))
    acc

fn walk_ast_type<C>(node: Type, ctx: C, f: fn(AstWalkNode, C) -> C) -> C:
