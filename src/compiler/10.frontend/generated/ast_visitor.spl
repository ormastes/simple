    print "E-AST-VISIT-UNHANDLED: {kind} variant {variant} unhandled at {where_}"
    raise "E-AST-VISIT-UNHANDLED: {kind} variant {variant} unhandled at {where_}; regenerate src/compiler/10.frontend/generated"

