                    acc = walk_ast_type(it1, acc, f)
        case Tuple(b_f0):
            handled = true
            if b_f0 != nil:
                for it0 in b_f0:
                    acc = walk_ast_type(it0, acc, f)
        case Array(b_f0, b_f1):
            handled = true
            acc = walk_ast_type(b_f0, acc, f)
            acc = walk_ast_expr(b_f1, acc, f)
        case Function(b_f0, b_f1):
            handled = true
            if b_f0 != nil:
                for it0 in b_f0:
                    acc = walk_ast_type(it0, acc, f)
            acc = walk_ast_type(b_f1, acc, f)
        case Optional(b_f0):
            handled = true
            acc = walk_ast_type(b_f0, acc, f)
        case Reference(b_f0, _):
            handled = true
            acc = walk_ast_type(b_f0, acc, f)
        case Atomic(b_f0):
            handled = true
            acc = walk_ast_type(b_f0, acc, f)
        case Isolated(b_f0):
            handled = true
            acc = walk_ast_type(b_f0, acc, f)
        case Union(b_f0):
            handled = true
            if b_f0 != nil:
                for it0 in b_f0:
                    acc = walk_ast_type(it0, acc, f)
        case Projection(b_f0, _):
            handled = true
            acc = walk_ast_type(b_f0, acc, f)
        case Infer:
            handled = true
        case Error:
            handled = true
        case Pointer(b_f0, _):
            handled = true
            acc = walk_ast_type(b_f0, acc, f)
        case Weak(b_f0):
            handled = true
