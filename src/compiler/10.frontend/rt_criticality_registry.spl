# Parse-to-semantics side channel for compiler-recognized `@rt` declarations.
# The inert marker carrying these records is removed before HIR/MIR, so an
# admitted RT declaration has no runtime representation or dispatch cost.

@unsafe(reason: "raw transient-owner promotion; false is provider failure", capabilities: [ffi])
extern fn rt_transient_heap_promote(value: Any) -> bool

@always_inline
fn _rt_criticality_promote_raw(value: Any) -> bool:
    unsafe(capabilities: [ffi]):
        rt_transient_heap_promote(value)

var rt_criticality_keys: [text] = []
var rt_criticality_profiles: Dict<text, text> = {}
var rt_criticality_reasons: Dict<text, text> = {}
var rt_criticality_bounds: Dict<text, text> = {}
var rt_criticality_hal_tags: Dict<text, bool> = {}

fn rt_criticality_key(path: text, fn_name: text) -> text:
    path + "|" + fn_name

fn rt_criticality_claim_path(key: text) -> text:
    val parts = key.split("|")
    if parts.len() > 0: return parts[0]
    ""

fn rt_criticality_claim_fn(key: text) -> text:
    val parts = key.split("|")
    if parts.len() > 1: return parts[1]
    ""

fn rt_criticality_reset():
    rt_criticality_keys = []
    rt_criticality_profiles = {}
    rt_criticality_reasons = {}
    rt_criticality_bounds = {}
    rt_criticality_hal_tags = {}

fn rt_criticality_reset_module(path: text):
    val prefix = path + "|"
    var keys: [text] = []
    var profiles: Dict<text, text> = {}
    var reasons: Dict<text, text> = {}
    var bounds: Dict<text, text> = {}
    var hal_tags: Dict<text, bool> = {}
    for key in rt_criticality_keys:
        if key.starts_with(prefix): continue
        keys.push(key)
        if rt_criticality_profiles.contains_key(key): profiles[key] = rt_criticality_profiles[key]
        if rt_criticality_reasons.contains_key(key): reasons[key] = rt_criticality_reasons[key]
        if rt_criticality_bounds.contains_key(key): bounds[key] = rt_criticality_bounds[key]
        if rt_criticality_hal_tags.contains_key(key): hal_tags[key] = rt_criticality_hal_tags[key]
    rt_criticality_keys = keys
    rt_criticality_profiles = profiles
    rt_criticality_reasons = reasons
    rt_criticality_bounds = bounds
    rt_criticality_hal_tags = hal_tags

fn rt_criticality_promote_transient_owner() -> bool:
    _rt_criticality_promote_raw(rt_criticality_keys) and
        _rt_criticality_promote_raw(rt_criticality_profiles) and
        _rt_criticality_promote_raw(rt_criticality_reasons) and
        _rt_criticality_promote_raw(rt_criticality_bounds) and
        _rt_criticality_promote_raw(rt_criticality_hal_tags)

fn rt_criticality_trim_quotes(raw: text) -> text:
    if raw.len() >= 2 and raw.starts_with("\"") and raw.ends_with("\""):
        return raw.substring(1, raw.len() - 1)
    raw

fn rt_criticality_parse_args(raw: text) -> (text, text, text):
    # Empty is the legacy implicit spelling. An explicit profile is the first
    # field; lower tiers require `reason:"..."` and are rejected semantically
    # when absent. Splitting is bounded by source length and runs once/decl.
    if raw == "": return ("", "", "")
    val parts = raw.split(",")
    var profile = parts[0]
    # `hal` is the RT provider tag, not a safety-profile spelling. Tagged HAL
    # declarations are explicit RT declarations and therefore default to the
    # canonical critical tier while the provider lane consumes the tag.
    if profile == "hal": profile = "critical"
    var reason = ""
    var bounds = ""
    for part in parts:
        if part.starts_with("reason:"):
            reason = rt_criticality_trim_quotes(part.substring(7, part.len()))
        elif part.starts_with("bounds:"):
            bounds = part.substring(7, part.len())
    (profile, reason, bounds)

fn rt_criticality_declare(path: text, fn_name: text, raw_args: text):
    if fn_name == "": return
    val key = rt_criticality_key(path, fn_name)
    val parsed = rt_criticality_parse_args(raw_args)
    if not rt_criticality_keys.contains(key): rt_criticality_keys.push(key)
    rt_criticality_profiles[key] = parsed[0]
    rt_criticality_reasons[key] = parsed[1]
    rt_criticality_bounds[key] = parsed[2]
    rt_criticality_hal_tags[key] = raw_args == "hal" or raw_args.starts_with("hal,")

fn rt_criticality_claim_keys() -> [text]: rt_criticality_keys
fn rt_criticality_profile(key: text) -> text:
    if rt_criticality_profiles.contains_key(key): return rt_criticality_profiles[key]
    ""
fn rt_criticality_reason(key: text) -> text:
    if rt_criticality_reasons.contains_key(key): return rt_criticality_reasons[key]
    ""
fn rt_criticality_bounds_for(key: text) -> text:
    if rt_criticality_bounds.contains_key(key): return rt_criticality_bounds[key]
    ""
fn rt_criticality_is_hal(key: text) -> bool:
    if rt_criticality_hal_tags.contains_key(key): return rt_criticality_hal_tags[key]
    false

export rt_criticality_reset, rt_criticality_reset_module
export rt_criticality_promote_transient_owner, rt_criticality_declare
export rt_criticality_claim_keys, rt_criticality_claim_path, rt_criticality_claim_fn
export rt_criticality_profile, rt_criticality_reason, rt_criticality_parse_args
export rt_criticality_bounds_for
export rt_criticality_is_hal
