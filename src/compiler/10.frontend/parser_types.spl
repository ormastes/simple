# Parser Types - AST Type Definitions
#
# This module contains all AST (Abstract Syntax Tree) type definitions.
# Split into:
# - parser_types.spl: Module structure (Module, Import, Export, Function, Class, etc.)
# - parser_types_expr.spl: Expression-level types (Type, Expr, Pattern, Stmt, operators, ASM)
# - parser_types_utils.spl: Float parsing utilities

use compiler.common.diagnostics.span.{Span}
use compiler.frontend.lexer_types.{Token}
use compiler.frontend.parser_types_expr.*
use compiler.frontend.parser_types_utils.*
use compiler.common.dependency.visibility.{Visibility}
use compiler.common.value_access.{compiler_value_discriminant, compiler_value_payload}

extern fn rt_env_get(key: text) -> text

fn _parser_type_trace_enabled() -> bool:
    (rt_env_get("SIMPLE_COMPILER_TRACE") ?? "") == "1"

struct Module:
    """Complete parsed module."""
    name: text
    imports: [Import]
    exports: [Export]
    domain_blocks: [DomainBlock]
    functions: Dict<text, ParserFunction>
    # Compact callable signatures built while parser scratch is still scoped.
    # Streaming ModuleSurface construction projects this dictionary directly
    # into its field-sliced owner, so declaration extraction never copies the
    # whole ParserModule or executable bodies merely to retain their headers.
    function_headers: Dict<text, ParserFunctionHeader> = {}
    function_order: [text]
    classes: Dict<text, Class>
    actors: Dict<text, ActorDef>
    structs: Dict<text, Struct>
    enums: Dict<text, Enum>
    bitfields: Dict<text, Bitfield>
    traits: Dict<text, Trait>
    impls: [Impl]
    type_aliases: Dict<text, TypeAlias>
    constants: Dict<text, Const>
    static_asserts: [StaticAssert]
    aop_advices: [AopAdvice]
    di_bindings: [DiBinding]
    arch_rules: [ArchRule]
    mock_decls: [MockDecl]
    # M1 of doc/03_plan/compiler/forwarding/
    # zero_cost_layers_c0_c5_staged_implementation_plan_2026-08-07.md:
    # `@layer(NAME)` module tag, "" when the module is untagged. Populated by
    # module_assembly.spl's `__module_layer_tag` marker handling, validated
    # there against the same-module LayerDagRegistry.
    tagged_layer: text
    # M1b wiring (same plan doc): flat serialization of this module's own
    # `layer NAME [uses A, B]` declarations (source-order), so a
    # whole-program pass (src/compiler/80.driver's parse phase) can merge
    # every module's declared layers/edges into one project-wide
    # LayerDagRegistry after all modules are parsed -- the per-module
    # LayerDagRegistry built in module_assembly.spl is local to that one
    # parse call and is otherwise discarded once check_layer_dag() runs.
    # Format: one fact per line, "D:name" (declare) or "E:from>to" (uses
    # edge), in the same order layer_registry.declare()/.uses() were called.
    # "" when the module declares no layers. See
    # src/compiler/35.semantics/layer_call_wiring.spl for the merge + call
    # check that consumes this.
    layer_dag_edges: text
    # FR-DRIVER-0001 NOTE: module-level attributes like @driver(...) /
    # @native_lib(...) are stored on the owning declaration (fn/impl/class),
    # not on the Module itself. If a future FR needs bare-module attribute
    # support, add `attributes: [Attribute]` here and update all
    # `ParserModule(...)` constructor sites across the self-hosted codebase.

struct DomainBlock:
    """Raw top-level domain block captured at module scope."""
    kind: text
    payload: text
    context: text
    span: Span

struct Import:
    """Import declaration."""
    module: text
    items: [ImportItem]
    is_lazy: bool
    span: Span

struct ImportItem:
    """Single imported item."""
    name: text
    # # DESUGARED: alias: text
    has_alias: bool
    alias: text

struct Export:
    """Export declaration."""
    items: [text]
    span: Span

struct Function:
    """Function definition."""
    name: text
    type_params: [TypeParam]
    params: [Param]
    # # DESUGARED: return_type: Type
    has_return_type: bool
    return_type: Type
    body: Block
    visibility: Visibility
    is_async: bool
    is_static: bool
    is_public: bool
    is_method: bool
    is_mutable: bool    # 'me' vs 'fn'
    is_const: bool      # 'const fn' - can be evaluated at compile time
    is_kernel: bool     # 'kernel fn' - GPU kernel function
    is_extern: bool     # 'extern fn' - external function (no body)
    attributes: [Attribute]  # Attribute annotations (Phase 3[3] - TODO ✅)
    # # DESUGARED: doc_comment: text
    has_doc_comment: bool
    doc_comment: text
    contract: ContractBlock
    span: Span

struct ContractClause:
    """One typed-AST contract predicate retained from source."""
    expr: Expr
    span: Span

struct ContractBlock:
    """Execution contract retained on its owning function."""
    preconditions: [ContractClause]
    invariants: [ContractClause]
    postconditions: [ContractClause]
    error_postconditions: [ContractClause]
    decrease_measure: ContractClause?
    postcondition_binding: text
    error_binding: text
    proof_uses: text

fn contract_block_empty() -> ContractBlock:
    ContractBlock(
        preconditions: [], invariants: [], postconditions: [],
        error_postconditions: [], decrease_measure: nil,
        postcondition_binding: "", error_binding: "", proof_uses: ""
    )

fn parser_function_new(
    name: text,
    type_params: [TypeParam],
    params: [Param],
    has_return_type: bool,
    return_type: Type,
    body: Block,
    visibility: Visibility,
    is_async: bool,
    is_static: bool,
    is_public: bool,
    is_method: bool,
    is_mutable: bool,
    is_const: bool,
    is_kernel: bool,
    is_extern: bool,
    attributes: [Attribute],
    has_doc_comment: bool,
    doc_comment: text,
    contract: ContractBlock,
    span: Span
) -> Function:
    Function(
        name: name,
        type_params: type_params,
        params: params,
        has_return_type: has_return_type,
        return_type: return_type,
        body: body,
        visibility: visibility,
        is_async: is_async,
        is_static: is_static,
        is_public: is_public,
        is_method: is_method,
        is_mutable: is_mutable,
        is_const: is_const,
        is_kernel: is_kernel,
        is_extern: is_extern,
        attributes: attributes,
        has_doc_comment: has_doc_comment,
        doc_comment: doc_comment,
        contract: contract,
        span: span
    )

struct Param:
    """Function parameter."""
    name: text
    # # DESUGARED: type_: Type
    has_type_: bool
    type_: Type
    # # DESUGARED: default: Expr
    has_default: bool
    default: Expr
    span: Span

struct ParserParamHeader:
    name: text
    has_type_: bool
    type_: Type
    is_mutable: bool
    span: Span

struct ParserFunctionHeader:
    name: text
    type_params: [ParserTypeParam]
    params: [ParserParamHeader]
    has_return_type: bool
    return_type: Type
    visibility: Visibility
    is_async: bool
    is_static: bool
    is_public: bool
    is_method: bool
    is_mutable: bool
    is_const: bool
    is_kernel: bool
    is_extern: bool
    span: Span

fn parser_function_header(function_: ParserFunction) -> ParserFunctionHeader:
    var params: [ParserParamHeader] = []
    for param in function_.params:
        params.push(ParserParamHeader(
            name: param.name,
            has_type_: param.has_type_,
            type_: param.type_,
            is_mutable: param.is_mutable,
            span: param.span))
    ParserFunctionHeader(
        name: function_.name,
        type_params: function_.type_params,
        params: params,
        has_return_type: function_.has_return_type,
        return_type: function_.return_type,
        visibility: function_.visibility,
        is_async: function_.is_async,
        is_static: function_.is_static,
        is_public: function_.is_public,
        is_method: function_.is_method,
        is_mutable: function_.is_mutable,
        is_const: function_.is_const,
        is_kernel: function_.is_kernel,
        is_extern: function_.is_extern,
        span: function_.span)

struct ParserTypeParam:
    """Generic type parameter."""
    name: text
    bounds: [Type]
    # # DESUGARED: default: Type
    has_default: bool
    default: Type
    span: Span

struct TraitBound:
    """Trait bound constraint: T: Trait

    Used in:
    - Function signatures: fn foo<T: Display>(x: T)
    - Where clauses: where T: Clone
    - Trait definitions: trait Ord: Eq
    - Impl blocks: impl<T: Clone> Clone for Vec<T>
    """
    type_param: text            # Type parameter name being constrained
    trait_: Type                # Trait that must be implemented
    span: Span

struct Attribute:
    """Attribute annotation on a declaration.

    Syntax:
        @name                     # Simple attribute
        @name(value)              # Attribute with single argument
        @name(arg1, arg2, ...)    # Attribute with multiple arguments
        @name("string_value")     # Attribute with string argument

    Examples:
        @repr("C")
        @align(16)
        @packed
        @deprecated("Use X instead")
    """
    name: text              # Attribute name (e.g., "repr", "align", "packed")
    args: [Expr]            # Attribute arguments (may be empty)
    span: Span

struct Class:
    """Class definition."""
    name: text
    type_params: [TypeParam]
    fields: [Field]
    methods: Dict<text, Function>
    visibility: Visibility
    is_public: bool
    # # DESUGARED: doc_comment: text
    has_doc_comment: bool
    doc_comment: text
    attributes: [Attribute]     # Attributes like @repr, @packed, @align
    span: Span
    ordered_methods: [ParserFunction] = []
    # Exact source provenance for `class Name(Base) with Trait, ...`.
    base_type: Option<Type> = nil
    implemented_traits: [Type] = []

struct ActorDef:
    """Actor definition - message-based concurrent entity."""
    name: text
    type_params: [TypeParam]
    fields: [Field]
    methods: Dict<text, Function>    # Message handlers
    visibility: Visibility
    is_public: bool
    # # DESUGARED: doc_comment: text
    has_doc_comment: bool
    doc_comment: text
    attributes: [Attribute]
    span: Span
    # Exact source spelling aligned with attributes. Typed Expr children remain
    # authoritative for semantics; this sidecar preserves decorator presence
    # and spellings which cannot be reconstructed from the typed tree.
    attribute_raw_spellings: [text] = []
    # Canonical source order for message handlers. Dictionary iteration is not
    # a semantic ordering contract; graph publication consumes this sidecar.
    ordered_methods: [ParserFunction] = []

struct Struct:
    """Struct definition."""
    name: text
    type_params: [TypeParam]
    fields: [Field]
    visibility: Visibility
    is_public: bool
    # # DESUGARED: doc_comment: text
    has_doc_comment: bool
    doc_comment: text
    attributes: [Attribute]     # Attributes like @repr, @packed, @align
    span: Span
    # Kept for the shared composite grammar; consumers decide whether a base
    # is legal for the nominal kind rather than losing it in the parser.
    base_type: Option<Type> = nil
    implemented_traits: [Type] = []

struct Field:
    """Struct/class field."""
    name: text
    type_: Type
    # # DESUGARED: default: Expr
    has_default: bool
    default: Expr
    visibility: Visibility
    is_public: bool
    is_volatile: bool          # @volatile field
    # # DESUGARED: bits: i64
    has_bits: bool
    bits: i64
    # # DESUGARED: fixed_address: i64
    has_fixed_address: bool
    fixed_address: i64
    span: Span

struct Enum:
    """Enum definition."""
    name: text
    type_params: [TypeParam]
    variants: [Variant]
    visibility: Visibility
    is_public: bool
    # # DESUGARED: doc_comment: text
    has_doc_comment: bool
    doc_comment: text
    span: Span

struct Variant:
    """Enum variant."""
    name: text
    kind: VariantKind
    span: Span

"""Enum variant kind."""
enum VariantKind:
    Unit
    Tuple([Type])
    Struct([Field])

fn parser_variant_named_dependencies(variant: Variant) -> [text]:
    """Collect named dependencies using VariantKind's typed owner ABI."""
    val kind = variant.kind
    val disc = compiler_value_discriminant(kind)
    if disc == compiler_value_discriminant(VariantKind.Tuple([])):
        val payload = compiler_value_payload(kind)
        if payload == nil: return []
        val types: [Type] = payload
        var names: [text] = []
        for type_ in types:
            for nested in parser_type_named_dependencies(type_):
                names = names.push(nested)
        return names
    if disc == compiler_value_discriminant(VariantKind.Struct([])):
        val payload = compiler_value_payload(kind)
        if payload == nil: return []
        val fields: [ParserField] = payload
        var names: [text] = []
        for field in fields:
            for nested in parser_type_named_dependencies(field.type_):
                names = names.push(nested)
        return names
    []

struct Bitfield:
    """Bitfield definition.

    Example:
        bitfield Flags(u32):
            enabled: bool       # 1 bit
            priority: u4        # 4 bits
            _reserved: 27       # 27 reserved bits
    """
    name: text
    backing_type: Type          # e.g., u32, u64
    fields: [BitfieldField]
    visibility: Visibility
    is_public: bool
    # # DESUGARED: doc_comment: text
    has_doc_comment: bool
    doc_comment: text
    attributes: [Attribute]
    span: Span

struct BitfieldField:
    """Bitfield field."""
    name: text
    # # DESUGARED: type_: Type
    has_type_: bool
    type_: Type
    # # DESUGARED: bits: i64
    has_bits: bool
    bits: i64
    is_reserved: bool          # True if _reserved field
    span: Span

struct AssocTypeDecl:
    """Associated type declaration in a trait or impl block.

    Examples:
        # In trait body:
        type Item                   # No bounds, no default
        type Output: Display        # With bound
        type Index = i64            # With default

        # In impl body:
        type Item = i64             # Concrete type assignment
    """
    name: text
    bounds: [Type]              # Trait bounds (e.g., : Display + Clone)
    # # DESUGARED: default: Type
    has_default: bool
    default: Type               # Default type (in trait) or concrete type (in impl)
    span: Span

struct Trait:
    """Trait definition.

    Example:
        trait Display:
            fn to_string() -> text:
                pass

        trait Ord: Eq:  # Supertrait
            fn cmp(Self) -> Ordering:
            fn max(Self) -> Self:  # Default implementation
                if self.cmp(other) == Greater: self else: other

        trait Iterator:
            type Item               # Associated type declaration
            fn next() -> Self.Item?
    """
    name: text
    type_params: [TypeParam]
    super_traits: [Type]         # Trait: Supertrait bounds (e.g., trait Ord: Eq)
    where_clause: [TraitBound]   # Where clauses on the trait
    methods: [Function]          # Both abstract and default method implementations
    assoc_types: [AssocTypeDecl] # Associated type declarations
    visibility: Visibility
    is_public: bool
    # # DESUGARED: doc_comment: text
    has_doc_comment: bool
    doc_comment: text
    span: Span

struct Impl:
    """Impl block.

    Examples:
        # Inherent impl (no trait)
        impl Point:
            fn new(i64, i64) -> Point: ...

        # Trait impl
        # REMOVED: impl Display for Point:
        # (Trait implementations not supported in Core Simple)
            # fn to_string() -> text: ...

        # Generic impl with where clause
        impl<T> Display for Vec<T> where T: Display:
            fn to_string() -> text: ...

        # Trait impl with associated type
        impl Iterator for Range:
            type Item = i64
            fn next() -> i64?: ...

        # FR-DRIVER-0001 NOTE: attribute-carrying impl via
        # @driver(class = DriverClass.Block, ...) impl Driver for NullBlock
        # is parsed by the Rust seed today; the attribute is stored on
        # the owning decl (fn/impl) via the normal attribute path. If the
        # self-hosted parser gains module-scope HIR synthesis, add
        # `attributes: [Attribute]` here and update Impl(...) call sites.
    """
    type_: Type                 # Type being implemented for
    # # DESUGARED: trait_: Type
    has_trait_: bool
    trait_: Type
    type_params: [TypeParam]    # Generic parameters (impl<T>)
    where_clause: [TraitBound]  # Where T: Trait constraints
    methods: Dict<text, Function>
    assoc_types: [AssocTypeDecl]  # Associated type implementations
    span: Span

struct TypeAlias:
    """Type alias."""
    name: text
    type_params: [TypeParam]
    type_: Type
    visibility: Visibility
    is_public: bool
    span: Span

struct Const:
    """Module-level constant."""
    name: text
    # # DESUGARED: type_: Type
    has_type_: bool
    type_: Type
    value: Expr
    is_mutable: bool
    visibility: Visibility
    is_public: bool
    is_volatile: bool          # @volatile variable
    # # DESUGARED: fixed_address: i64
    has_fixed_address: bool
    fixed_address: i64
    span: Span

struct StaticAssert:
    """Static assertion - evaluated at compile time.

    Example:
        static assert size_of<u32>() == 4
        static assert align_of<Point>() >= 4  # Point must be 4-byte aligned
    """
    condition: Expr             # Condition expression (must evaluate to bool at compile time)
    # # DESUGARED: message: text
    has_message: bool
    message: text
    span: Span

struct AopAdvice:
    """AOP advice declaration: on pc{...} use interceptor [form] [priority N]"""
    pointcut: text       # raw pc{...} content
    form: text           # "before" | "after_success" | "after_error" | "around"
    handler: text        # interceptor function name (as text identifier)
    priority: i64
    span: Span

struct DiBinding:
    """DI binding: bind on pc{...} -> Impl"""
    pointcut: text
    implementation: text
    span: Span

struct ArchRule:
    """Architecture rule: forbid/allow pc{...} "message" """
    kind: text           # "forbid" | "allow"
    pointcut: text
    message: text
    span: Span

struct MockDecl:
    """Mock declaration: mock Name implements Trait"""
    name: text
    trait_name: text
    span: Span

fn parser_module_new(
    name: text,
    imports: [Import],
    exports: [Export],
    domain_blocks: [DomainBlock],
    functions: Dict<text, Function>,
    classes: Dict<text, Class>,
    actors: Dict<text, ActorDef>,
    structs: Dict<text, Struct>,
    enums: Dict<text, Enum>,
    bitfields: Dict<text, Bitfield>,
    traits: Dict<text, Trait>,
    impls: [Impl],
    type_aliases: Dict<text, TypeAlias>,
    constants: Dict<text, Const>,
    static_asserts: [StaticAssert],
    aop_advices: [AopAdvice],
    di_bindings: [DiBinding],
    arch_rules: [ArchRule],
    mock_decls: [MockDecl],
    tagged_layer: text,
    layer_dag_edges: text
) -> ParserModule:
    if _parser_type_trace_enabled():
        print "[parser_types] parser_module_new name={name}"
    Module(
        name: name,
        imports: imports,
        exports: exports,
        domain_blocks: domain_blocks,
        functions: functions,
        classes: classes,
        actors: actors,
        structs: structs,
        enums: enums,
        bitfields: bitfields,
        traits: traits,
        impls: impls,
        type_aliases: type_aliases,
        constants: constants,
        static_asserts: static_asserts,
        aop_advices: aop_advices,
        di_bindings: di_bindings,
        arch_rules: arch_rules,
        mock_decls: mock_decls,
        tagged_layer: tagged_layer,
        layer_dag_edges: layer_dag_edges
    )

# ============================================================================
# Parser
# ============================================================================

struct Parser:
    """Full AST parser using TreeSitter outline."""
    source: text
    lexer: Any
    current: Token
    previous: Token
    errors: [Any]
    # # DESUGARED: outline: OutlineModule
    has_outline: bool
    outline: Any
    # Block resolver payload is intentionally opaque here; concrete resolver
    # modules live outside the frontend parser type layer.
    has_resolved_blocks: bool
    resolved_blocks: Any

