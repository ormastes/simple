# Parser Types - AST Type Definitions
#
# This module contains all AST (Abstract Syntax Tree) type definitions.
# Split into:
# - parser_types.spl: ParserModule structure (ParserModule, ParserImport, Export, ParserFunction, ParserClass, etc.)
# - parser_types_expr.spl: Expression-level types (Type, Expr, Pattern, Stmt, operators, ASM)
# - parser_types_utils.spl: Float parsing utilities

use compiler.common.diagnostics.span.{Span}
use compiler.frontend.lexer_types.{Token}
use compiler.frontend.parser_types_expr.*
use compiler.frontend.parser_types_utils.*
use compiler.common.dependency.visibility.{Visibility}
use compiler.common.dynamic_identity.closure.{Closure}
use compiler.frontend.trace_policy.{frontend_compiler_trace_enabled}

fn _parser_type_trace_enabled() -> bool:
    frontend_compiler_trace_enabled()

struct ParserModule:
    """Complete parsed module."""
    name: text
    imports: [ParserImport]
    exports: [Export]
    domain_blocks: [DomainBlock]
    functions: Dict<text, ParserFunction>
    # Compact callable signatures built while parser scratch is still scoped.
    # Streaming ModuleSurface construction consumes these through a
    # reference-owned ParserModule wrapper, so declaration extraction never
    # copies executable bodies merely to retain their headers.
    function_headers: Dict<text, ParserFunctionHeader> = {}
    function_order: [text]
    classes: Dict<text, ParserClass>
    actors: Dict<text, ActorDef>
    actor_order: [text]
    structs: Dict<text, ParserStruct>
    enums: Dict<text, ParserEnum>
    bitfields: Dict<text, Bitfield>
    traits: Dict<text, ParserTrait>
    impls: [Impl]
    type_aliases: Dict<text, ParserTypeAlias>
    constants: Dict<text, ParserConst>
    static_asserts: [StaticAssert]
    aop_advices: [AopAdvice]
    di_bindings: [DiBinding]
    arch_rules: [ArchRule]
    mock_decls: [MockDecl]
    # M1 of doc/03_plan/compiler/forwarding/
    # zero_cost_layers_c0_c5_staged_implementation_plan_2026-08-07.md:
    # `@layer(NAME)` module tag, "" when the module is untagged. Populated by
    # module_assembly.spl's `__module_layer_tag` marker handling, validated
    # there against the same-module LayerDagRegistry.
    tagged_layer: text
    # M1b wiring (same plan doc): flat serialization of this module's own
    # `layer NAME [uses A, B]` declarations (source-order), so a
    # whole-program pass (src/compiler/80.driver's parse phase) can merge
    # every module's declared layers/edges into one project-wide
    # LayerDagRegistry after all modules are parsed -- the per-module
    # LayerDagRegistry built in module_assembly.spl is local to that one
    # parse call and is otherwise discarded once check_layer_dag() runs.
    # Format: one fact per line, "D:name" (declare) or "E:from>to" (uses
    # edge), in the same order layer_registry.declare()/.uses() were called.
    # "" when the module declares no layers. See
    # src/compiler/35.semantics/layer_call_wiring.spl for the merge + call
    # check that consumes this.
    layer_dag_edges: text
    # Module authority retained from the outline pass. These are declaration
    # metadata, not executable parser state, and must survive every AST rebuild.
    friends: [text] = []
    internal_exports: [text] = []
    # FR-DRIVER-0001 NOTE: module-level attributes like @driver(...) /
    # @native_lib(...) are stored on the owning declaration (fn/impl/class),
    # not on the ParserModule itself. If a future FR needs bare-module attribute
    # support, add `attributes: [Attribute]` here and update all
    # `ParserModule(...)` constructor sites across the self-hosted codebase.
    #
    # `extend <Enum>:` sections declared in this module, in source order. MUST
    # stay the LAST field (partial named constructions are filled POSITIONALLY
    # by the Rust seed), and carries a default so the existing
    # `ParserModule(...)` sites keep compiling unchanged.
    extend_enums: [ParserExtendEnum] = []

struct DomainBlock:
    """Raw top-level domain block captured at module scope."""
    kind: text
    payload: text
    context: text
    span: Span

struct ParserImport:
    """ParserImport declaration."""
    module: text
    items: [ImportItem]
    is_lazy: bool
    span: Span

struct ImportItem:
    """Single imported item."""
    name: text
    # # DESUGARED: alias: text
    has_alias: bool
    alias: text

struct Export:
    """Export declaration."""
    items: [text]
    span: Span

struct ParserFunction:
    """ParserFunction definition."""
    name: text
    type_params: [ParserTypeParam]
    params: [Param]
    # # DESUGARED: return_type: Type
    has_return_type: bool
    return_type: Type
    body: Block
    visibility: Visibility
    is_async: bool
    is_static: bool
    is_public: bool
    is_method: bool
    is_mutable: bool    # 'me' vs 'fn'
    is_const: bool      # 'const fn' - can be evaluated at compile time
    is_kernel: bool     # 'kernel fn' - GPU kernel function
    is_extern: bool     # 'extern fn' - external function (no body)
    attributes: [Attribute]  # Attribute annotations (Phase 3.3 - TODO ✅)
    # # DESUGARED: doc_comment: text
    has_doc_comment: bool
    doc_comment: text
    contract: ContractBlock
    span: Span

struct ContractClause:
    """One typed-AST contract predicate retained from source."""
    expr: Expr
    span: Span

struct ContractBlock:
    """Execution contract retained on its owning function."""
    preconditions: [ContractClause]
    invariants: [ContractClause]
    postconditions: [ContractClause]
    error_postconditions: [ContractClause]
    decrease_measure: ContractClause?
    postcondition_binding: text
    error_binding: text
    proof_uses: text

fn contract_block_empty() -> ContractBlock:
    ContractBlock(
        preconditions: [], invariants: [], postconditions: [],
        error_postconditions: [], decrease_measure: nil,
        postcondition_binding: "", error_binding: "", proof_uses: ""
    )

fn parser_function_new(
    name: text,
    type_params: [ParserTypeParam],
    params: [Param],
    has_return_type: bool,
    return_type: Type,
    body: Block,
    visibility: Visibility,
    is_async: bool,
    is_static: bool,
    is_public: bool,
    is_method: bool,
    is_mutable: bool,
    is_const: bool,
    is_kernel: bool,
    is_extern: bool,
    attributes: [Attribute],
    has_doc_comment: bool,
    doc_comment: text,
    contract: ContractBlock,
    span: Span
) -> ParserFunction:
    ParserFunction(
        name: name,
        type_params: type_params,
        params: params,
        has_return_type: has_return_type,
        return_type: return_type,
        body: body,
        visibility: visibility,
        is_async: is_async,
        is_static: is_static,
        is_public: is_public,
        is_method: is_method,
        is_mutable: is_mutable,
        is_const: is_const,
        is_kernel: is_kernel,
        is_extern: is_extern,
        attributes: attributes,
        has_doc_comment: has_doc_comment,
        doc_comment: doc_comment,
        contract: contract,
        span: span
    )

struct Param:
    """ParserFunction parameter."""
    name: text
    # # DESUGARED: type_: Type
    has_type_: bool
    type_: Type
    # # DESUGARED: default: Expr
    has_default: bool
    default: Expr
    span: Span
    # `mut name: T` marker (native_freefn_mut_param_no_mutate fix). Threaded
    # from the parser's PARAM_MUTS side table (fn_struct_decls.spl) through
    # to HirParam so MIR lowering can bind the parameter by-reference instead
    # of taking the Bug #167 defensive struct-value-copy. Appended at the end
    # of the struct (not inserted between existing fields) to avoid disturbing
    # any positional-field assumption elsewhere.
    is_mutable: bool

struct ParserParamHeader:
    name: text
    has_type_: bool
    type_: Type
    is_mutable: bool
    span: Span

struct ParserFunctionHeader:
    name: text
    type_params: [ParserTypeParam]
    params: [ParserParamHeader]
    has_return_type: bool
    return_type: Type
    visibility: Visibility
    is_async: bool
    is_static: bool
    is_public: bool
    is_method: bool
    is_mutable: bool
    is_const: bool
    is_kernel: bool
    is_extern: bool
    span: Span

fn parser_function_header(function_: ParserFunction) -> ParserFunctionHeader:
    var params: [ParserParamHeader] = []
    for param in function_.params:
        params.push(ParserParamHeader(
            name: param.name,
            has_type_: param.has_type_,
            type_: param.type_,
            is_mutable: param.is_mutable,
            span: param.span))
    ParserFunctionHeader(
        name: function_.name,
        type_params: function_.type_params,
        params: params,
        has_return_type: function_.has_return_type,
        return_type: function_.return_type,
        visibility: function_.visibility,
        is_async: function_.is_async,
        is_static: function_.is_static,
        is_public: function_.is_public,
        is_method: function_.is_method,
        is_mutable: function_.is_mutable,
        is_const: function_.is_const,
        is_kernel: function_.is_kernel,
        is_extern: function_.is_extern,
        span: function_.span)

struct ParserTypeParam:
    """Generic type parameter."""
    name: text
    bounds: [Type]
    # # DESUGARED: default: Type
    has_default: bool
    default: Type
    span: Span

struct TraitBound:
    """ParserTrait bound constraint: T: ParserTrait

    Used in:
    - ParserFunction signatures: fn foo<T: Display>(x: T)
    - Where clauses: where T: Clone
    - ParserTrait definitions: trait Ord: Eq
    - Impl blocks: impl<T: Clone> Clone for Vec<T>
    """
    type_param: text            # Type parameter name being constrained
    trait_: Type                # ParserTrait that must be implemented
    span: Span

struct Attribute:
    """Attribute annotation on a declaration.

    Syntax:
        @name                     # Simple attribute
        @name(value)              # Attribute with single argument
        @name(arg1, arg2, ...)    # Attribute with multiple arguments
        @name("string_value")     # Attribute with string argument

    Examples:
        @repr("C")
        @align(16)
        @packed
        @deprecated("Use X instead")
    """
    name: text              # Attribute name (e.g., "repr", "align", "packed")
    args: [Expr]            # Attribute arguments (may be empty)
    span: Span

struct ParserClass:
    """ParserClass definition."""
    name: text
    type_params: [ParserTypeParam]
    fields: [ParserField]
    methods: Dict<text, ParserFunction>
    visibility: Visibility
    is_public: bool
    # # DESUGARED: doc_comment: text
    has_doc_comment: bool
    doc_comment: text
    attributes: [Attribute]     # Attributes like @repr, @packed, @align
    span: Span

struct ActorDef:
    """Actor definition - message-based concurrent entity."""
    name: text
    type_params: [ParserTypeParam]
    fields: [ParserField]
    methods: Dict<text, ParserFunction>    # Message handlers
    visibility: Visibility
    is_public: bool
    # # DESUGARED: doc_comment: text
    has_doc_comment: bool
    doc_comment: text
    attributes: [Attribute]
    span: Span

struct ParserStruct:
    """ParserStruct definition."""
    name: text
    type_params: [ParserTypeParam]
    fields: [ParserField]
    visibility: Visibility
    is_public: bool
    # # DESUGARED: doc_comment: text
    has_doc_comment: bool
    doc_comment: text
    attributes: [Attribute]     # Attributes like @repr, @packed, @align
    span: Span

struct ParserField:
    """ParserStruct/class field."""
    name: text
    type_: Type
    # # DESUGARED: default: Expr
    has_default: bool
    default: Expr
    visibility: Visibility
    is_public: bool
    is_volatile: bool          # @volatile field
    # # DESUGARED: bits: i64
    has_bits: bool
    bits: i64
    # # DESUGARED: fixed_address: i64
    has_fixed_address: bool
    fixed_address: i64
    span: Span

struct ParserEnum:
    """ParserEnum definition."""
    name: text
    type_params: [ParserTypeParam]
    variants: [Variant]
    visibility: Visibility
    is_public: bool
    # # DESUGARED: doc_comment: text
    has_doc_comment: bool
    doc_comment: text
    span: Span
    # Raw decorator spellings recorded by the parser, in source order:
    # "closed", "evolving(repr:u16,unknown:Unknown)". MUST stay the LAST field
    # (partial named constructions are filled POSITIONALLY by the Rust seed).
    # See doc/08_tracking/bug/enum_decorators_dropped_before_hir_2026-08-21.md.
    attributes: [text]
    # §2 of doc/05_design/compiler/hardening/critical_completeness_design_2026-08-21.md:
    # a trailing `complete:` / `dyn:` section in the enum body declares that
    # the constructor universe stays OPEN in that region (an enum with neither
    # section is closed). New fields MUST stay after `attributes` for the same
    # positional-construction reason recorded above.
    complete_open: bool = false
    dyn_open: bool = false

# §2 of doc/05_design/compiler/hardening/critical_completeness_design_2026-08-21.md:
#
#     extend ExprKind:
#         complete:
#             async.Await(Expr)
#         dyn:
#             ide.LiveProbe(ProbePayload)
#
# One ParserExtendEnum is produced per `complete:` / `dyn:` SUBSECTION, so a
# single `extend` decl with both sections yields two records sharing a target.
# `Closure` is the shared axis enum from
# src/compiler/00.common/dynamic_identity/closure.spl -- deliberately imported
# rather than redeclared, so the frontend and the seal loader agree on one
# spelling of the state.
struct ParserExtendEnum:
    """A `complete:`/`dyn:` extension section of an `extend <Enum>:` decl."""
    target: text
    closure: Closure
    constructors: [ExtendConstructor]
    span: Span

struct ExtendConstructor:
    """`provider.Name(payload, ...)` inside an `extend` section."""
    provider: text
    name: text
    payload_types: [Type]
    span: Span

struct Variant:
    """ParserEnum variant."""
    name: text
    kind: VariantKind
    # # DESUGARED: discriminant: Expr
    has_discriminant: bool
    discriminant: Expr
    span: Span

"""ParserEnum variant kind."""
enum VariantKind:
    Unit
    Tuple([Type])
    Struct([ParserField])

extern fn rt_enum_payload(value: VariantKind) -> i64
extern fn rt_enum_discriminant(value: VariantKind) -> i64

fn parser_variant_named_dependencies(variant: Variant) -> [text]:
    """Collect named dependencies using VariantKind's typed owner ABI."""
    val kind = variant.kind
    val disc = rt_enum_discriminant(kind)
    if disc == rt_enum_discriminant(VariantKind.Tuple([])):
        val payload = rt_enum_payload(kind)
        if payload == nil: return []
        val types: [Type] = payload
        var names: [text] = []
        for type_ in types:
            for nested in parser_type_named_dependencies(type_):
                names = names.push(nested)
        return names
    if disc == rt_enum_discriminant(VariantKind.Struct([])):
        val payload = rt_enum_payload(kind)
        if payload == nil: return []
        val fields: [ParserField] = payload
        var names: [text] = []
        for field in fields:
            for nested in parser_type_named_dependencies(field.type_):
                names = names.push(nested)
        return names
    []

struct Bitfield:
    """Bitfield definition.

    Example:
        bitfield Flags(u32):
            enabled: bool       # 1 bit
            priority: u4        # 4 bits
            _reserved: 27       # 27 reserved bits
    """
    name: text
    backing_type: Type          # e.g., u32, u64
    fields: [BitfieldField]
    visibility: Visibility
    is_public: bool
    # # DESUGARED: doc_comment: text
    has_doc_comment: bool
    doc_comment: text
    attributes: [Attribute]
    span: Span

struct BitfieldField:
    """Bitfield field."""
    name: text
    # # DESUGARED: type_: Type
    has_type_: bool
    type_: Type
    # # DESUGARED: bits: i64
    has_bits: bool
    bits: i64
    is_reserved: bool          # True if _reserved field
    span: Span

struct AssocTypeDecl:
    """Associated type declaration in a trait or impl block.

    Examples:
        # In trait body:
        type Item                   # No bounds, no default
        type Output: Display        # With bound
        type Index = i64            # With default

        # In impl body:
        type Item = i64             # Concrete type assignment
    """
    name: text
    bounds: [Type]              # ParserTrait bounds (e.g., : Display + Clone)
    # # DESUGARED: default: Type
    has_default: bool
    default: Type               # Default type (in trait) or concrete type (in impl)
    span: Span

struct ParserTrait:
    """ParserTrait definition.

    Example:
        trait Display:
            fn to_string() -> text:
                pass

        trait Ord: Eq:  # Supertrait
            fn cmp(Self) -> Ordering:
            fn max(Self) -> Self:  # Default implementation
                if self.cmp(other) == Greater: self else: other

        trait Iterator:
            type Item               # Associated type declaration
            fn next() -> Self.Item?
    """
    name: text
    type_params: [ParserTypeParam]
    super_traits: [Type]         # ParserTrait: Supertrait bounds (e.g., trait Ord: Eq)
    where_clause: [TraitBound]   # Where clauses on the trait
    methods: [ParserFunction]          # Both abstract and default method implementations
    assoc_types: [AssocTypeDecl] # Associated type declarations
    visibility: Visibility
    is_public: bool
    # # DESUGARED: doc_comment: text
    has_doc_comment: bool
    doc_comment: text
    span: Span

struct Impl:
    """Impl block.

    Examples:
        # Inherent impl (no trait)
        impl Point:
            fn new(i64, i64) -> Point: ...

        # ParserTrait impl
        # REMOVED: impl Display for Point:
        # (ParserTrait implementations not supported in Core Simple)
            # fn to_string() -> text: ...

        # Generic impl with where clause
        impl<T> Display for Vec<T> where T: Display:
            fn to_string() -> text: ...

        # ParserTrait impl with associated type
        impl Iterator for Range:
            type Item = i64
            fn next() -> i64?: ...

        # FR-DRIVER-0001 NOTE: attribute-carrying impl via
        # @driver(class = DriverClass.Block, ...) impl Driver for NullBlock
        # is parsed by the Rust seed today; the attribute is stored on
        # the owning decl (fn/impl) via the normal attribute path. If the
        # self-hosted parser gains module-scope HIR synthesis, add
        # `attributes: [Attribute]` here and update Impl(...) call sites.
    """
    type_: Type                 # Type being implemented for
    # # DESUGARED: trait_: Type
    has_trait_: bool
    trait_: Type
    type_params: [ParserTypeParam]    # Generic parameters (impl<T>)
    where_clause: [TraitBound]  # Where T: ParserTrait constraints
    methods: Dict<text, ParserFunction>
    assoc_types: [AssocTypeDecl]  # Associated type implementations
    span: Span

struct ParserTypeAlias:
    """Type alias."""
    name: text
    type_params: [ParserTypeParam]
    type_: Type
    visibility: Visibility
    is_public: bool
    span: Span

struct ParserConst:
    """ParserModule-level constant."""
    name: text
    # # DESUGARED: type_: Type
    has_type_: bool
    type_: Type
    value: Expr
    is_mutable: bool
    visibility: Visibility
    is_public: bool
    is_volatile: bool          # @volatile variable
    # # DESUGARED: fixed_address: i64
    has_fixed_address: bool
    fixed_address: i64
    span: Span

struct StaticAssert:
    """Static assertion - evaluated at compile time.

    Example:
        static assert size_of<u32>() == 4
        static assert align_of<Point>() >= 4  # Point must be 4-byte aligned
    """
    condition: Expr             # Condition expression (must evaluate to bool at compile time)
    # # DESUGARED: message: text
    has_message: bool
    message: text
    span: Span

struct AopAdvice:
    """AOP advice declaration: on pc{...} use interceptor [form] [priority N]"""
    pointcut: text       # raw pc{...} content
    form: text           # "before" | "after_success" | "after_error" | "around"
    handler: text        # interceptor function name (as text identifier)
    priority: i64
    span: Span

struct DiBinding:
    """DI binding: bind on pc{...} -> Impl"""
    pointcut: text
    implementation: text
    span: Span

struct ArchRule:
    """Architecture rule: forbid/allow pc{...} "message" """
    kind: text           # "forbid" | "allow"
    pointcut: text
    message: text
    span: Span

struct MockDecl:
    """Mock declaration: mock Name implements ParserTrait"""
    name: text
    trait_name: text
    span: Span

fn parser_module_new(
    name: text,
    imports: [ParserImport],
    exports: [Export],
    domain_blocks: [DomainBlock],
    functions: Dict<text, ParserFunction>,
    function_order: [text],
    classes: Dict<text, ParserClass>,
    actors: Dict<text, ActorDef>,
    actor_order: [text],
    structs: Dict<text, ParserStruct>,
    enums: Dict<text, ParserEnum>,
    bitfields: Dict<text, Bitfield>,
    traits: Dict<text, ParserTrait>,
    impls: [Impl],
    type_aliases: Dict<text, ParserTypeAlias>,
    constants: Dict<text, ParserConst>,
    static_asserts: [StaticAssert],
    aop_advices: [AopAdvice],
    di_bindings: [DiBinding],
    arch_rules: [ArchRule],
    mock_decls: [MockDecl],
    tagged_layer: text,
    layer_dag_edges: text,
    friends: [text] = [],
    internal_exports: [text] = []
) -> ParserModule:
    if _parser_type_trace_enabled():
        print "[parser_types] parser_module_new name={name}"
    ParserModule(
        name: name,
        imports: imports,
        exports: exports,
        domain_blocks: domain_blocks,
        functions: functions,
        function_order: function_order,
        classes: classes,
        actors: actors,
        actor_order: actor_order,
        structs: structs,
        enums: enums,
        bitfields: bitfields,
        traits: traits,
        impls: impls,
        type_aliases: type_aliases,
        constants: constants,
        static_asserts: static_asserts,
        aop_advices: aop_advices,
        di_bindings: di_bindings,
        arch_rules: arch_rules,
        mock_decls: mock_decls,
        tagged_layer: tagged_layer,
        layer_dag_edges: layer_dag_edges,
        friends: friends,
        internal_exports: internal_exports
    )

# ============================================================================
# Parser
# ============================================================================

struct Parser:
    """Full AST parser using TreeSitter outline."""
    source: text
    lexer: Any
    current: Token
    previous: Token
    errors: [Any]
    # # DESUGARED: outline: OutlineModule
    has_outline: bool
    outline: Any
    # Block resolver payload is intentionally opaque here; concrete resolver
    # modules live outside the frontend parser type layer.
    has_resolved_blocks: bool
    resolved_blocks: Any

# ============================================================================
# Exports
# ============================================================================

# ParserModule-level types (defined here)

# Re-exported from parser_types_expr
export Type, TypeKind, Expr, ExprKind, CallArg
export Pattern, PatternKind, Stmt, StmtKind
export BinOp, UnaryOp, AssignOp
export Block, MatchArm, CatchClause, Param

# Re-exported from parser_types_utils
