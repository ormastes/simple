# Token and rejection state belong to the mutex-owned native SOSIX owner.
# The Simple facade is stateless across concurrent compiler workers.
use std.nogc_async_mut.sosix.directory_roots_v1.{sosix_directory_pair_check_v1}
use std.nogc_sync_mut.io_runtime.{cwd}

fn frontend_cache_absolute_root_v1(root: text) -> text:
    # Preserve the pathname used by cache I/O. On POSIX a backslash is a literal
    # filename byte, not a separator; normalization would admit a different node.
    val path = root
    if path.starts_with("/") or (path.len() > 2 and path.substring(1, 2) == ":" and
            (path.substring(2, 3) == "/" or path.substring(2, 3) == "\\")):
        return path
    cwd() + "/" + path

pub fn frontend_cache_root_admission_v1(shared_root: text, private_root: text) -> bool:
    if shared_root == "": return true
    if private_root == "": return false
    sosix_directory_pair_check_v1(frontend_cache_absolute_root_v1(shared_root),
        frontend_cache_absolute_root_v1(private_root)) == 0

export frontend_cache_root_admission_v1
