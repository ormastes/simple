# AST node pool pilot reference stores (data plan W3, doc/03_plan/compiler/
# data/data_attributes_layout_containers_xray_2026-11-06.md sections 6.2,
# 12.3, 14.3 item 2).
#
# The direct store is the generated `BinaryExprView` over the existing AST
# pool owner accessors. These two adapters hold the same logical attributes in
# a column (SoA) layout and in a hash-keyed row layout. Each is filled from
# the attribute values directly, never by reading the view, so agreement with
# the view is a real parity result. They are reference adapters for the pilot,
# not production storage, and own no node identity: a node id is the AST pool
# index.

# Columns (SoA): one array per attribute, indexed by position in `nodes`.
class BinaryExprColumnsV1:
    nodes: [i64]
    spans: [i64]
    lefts: [i64]
    ops: [i64]

impl BinaryExprColumnsV1:
    fn source_span(position: i64) -> i64:
        self.spans[position]

    fn left(position: i64) -> i64:
        self.lefts[position]

    fn op(position: i64) -> i64:
        self.ops[position]

fn binary_expr_columns_v1(nodes: [i64], spans: [i64], lefts: [i64], ops: [i64]) -> Result<BinaryExprColumnsV1, text>:
    if spans.len() != nodes.len() or lefts.len() != nodes.len() or ops.len() != nodes.len():
        return Err("every column needs one entry per node")
    Ok(BinaryExprColumnsV1(nodes: nodes, spans: spans, lefts: lefts, ops: ops))

# Rows keyed by node id in a hash map. A missing row is an error, never zero.
struct BinaryExprRowV1:
    source_span: i64
    left: i64
    op: i64

class BinaryExprRowsV1:
    rows: Dict<i64, BinaryExprRowV1>

impl BinaryExprRowsV1:
    fn row(node: i64) -> Result<BinaryExprRowV1, text>:
        if not self.rows.contains_key(node):
            return Err("no row for node " + node.to_text())
        Ok(self.rows[node])

    fn source_span(node: i64) -> Result<i64, text>:
        match self.row(node):
            case Ok(row): Ok(row.source_span)
            case Err(e): Err(e)

    fn left(node: i64) -> Result<i64, text>:
        match self.row(node):
            case Ok(row): Ok(row.left)
            case Err(e): Err(e)

    fn op(node: i64) -> Result<i64, text>:
        match self.row(node):
            case Ok(row): Ok(row.op)
            case Err(e): Err(e)

fn binary_expr_rows_v1(nodes: [i64], spans: [i64], lefts: [i64], ops: [i64]) -> Result<BinaryExprRowsV1, text>:
    if spans.len() != nodes.len() or lefts.len() != nodes.len() or ops.len() != nodes.len():
        return Err("every row needs one entry per attribute")
    var rows: Dict<i64, BinaryExprRowV1> = {}
    for i in 0..nodes.len():
        rows[nodes[i]] = BinaryExprRowV1(source_span: spans[i], left: lefts[i], op: ops[i])
    Ok(BinaryExprRowsV1(rows: rows))

export BinaryExprColumnsV1, BinaryExprRowV1, BinaryExprRowsV1
export binary_expr_columns_v1, binary_expr_rows_v1
