# Shared pure identity algorithm. Ambient feature reads belong to the frontend.
use std.common.crypto.sha256.{sha256_text}

fn frontend_shared_parse_feature_identity_for_v1(arena: text, entry_closure: text, debug_match: text) -> text:
    sha256_text("simple.shared-parse-features.v1\n" + "arena=" + arena + "\n" +
        "entry-closure=" + entry_closure + "\n" + "debug-match=" + debug_match + "\n")

export frontend_shared_parse_feature_identity_for_v1
