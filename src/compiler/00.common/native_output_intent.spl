# Typed interpretation of the existing native-output CLI wire. EntryObject
# is one genuine module action; RelocatableObject retains aggregate semantics.
enum NativeOutputIntentV1:
    Executable
    RelocatableObject
    Archive
    SharedLibrary
    EntryObject

fn native_output_intent_decode_v1(wire: text) -> Result<NativeOutputIntentV1, text>:
    if wire == "": return Ok(NativeOutputIntentV1.Executable)
    if wire == "1": return Ok(NativeOutputIntentV1.RelocatableObject)
    if wire == "archive": return Ok(NativeOutputIntentV1.Archive)
    if wire == "shared": return Ok(NativeOutputIntentV1.SharedLibrary)
    if wire == "entry": return Ok(NativeOutputIntentV1.EntryObject)
    Err("native-output-intent-invalid:" + wire)

fn native_output_intent_wire_v1(intent: NativeOutputIntentV1) -> text:
    match intent:
        case NativeOutputIntentV1.Executable: ""
        case NativeOutputIntentV1.RelocatableObject: "1"
        case NativeOutputIntentV1.Archive: "archive"
        case NativeOutputIntentV1.SharedLibrary: "shared"
        case NativeOutputIntentV1.EntryObject: "entry"

export NativeOutputIntentV1, native_output_intent_decode_v1, native_output_intent_wire_v1
