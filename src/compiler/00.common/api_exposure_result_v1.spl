# Structural exposure verdicts over retained signature facts. Classification
# only: no named rule, no severity, no publication permission is recorded here.
use compiler.common.api_signature_facts_v1.{ApiSignatureKindV1}
use compiler.common.dependency.visibility.{Visibility}

enum ApiExposureVerdictV1:
    Safe
    Violates
    Unknown

# One leaf finding. `path` lists node indexes from the callable root to the
# leaf inclusive; `ordinals` lists each non-root step's ordinal (-1 = return).
struct ApiExposureFindingV1:
    callable: i64
    verdict: ApiExposureVerdictV1
    leaf: i64
    leaf_kind: ApiSignatureKindV1
    path: [i64]
    ordinals: [i64]
    reason: text

struct ApiCallableExposureV1:
    callable: i64
    local_symbol: i64
    declaration_owner: text
    declaration_name: text
    # Carried for the consumer; never used to skip a callable. Effective
    # external visibility is not established by this record.
    declared_visibility: Visibility
    verdict: ApiExposureVerdictV1
    violations: i64
    unknowns: i64

struct ApiModuleExposureV1:
    module_name: text
    module_path: text
    # Fail-closed module verdict: Violates if any callable violates, otherwise
    # Unknown while any callable or module-level reason is unknown. Safe is
    # unreachable until effective export closure is collected.
    verdict: ApiExposureVerdictV1
    callables: [ApiCallableExposureV1]
    findings: [ApiExposureFindingV1]
    unknown_reasons: [text]
    truncated: bool
    format_version: i64 = 1
