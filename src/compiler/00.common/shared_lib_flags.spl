use std.platform.{host_os}

struct SharedLibFlags:
    compile_flags: [text]
    link_flags: [text]
    defines: [text]
    output_extension: text
    import_lib_ext: text

fn get_shared_lib_flags() -> SharedLibFlags:
    match host_os():
        case "windows":
            SharedLibFlags(compile_flags: [], link_flags: ["/DLL"],
                defines: ["SPL_SHARED_LIBRARY", "_USRDLL"],
                output_extension: ".dll", import_lib_ext: ".lib")
        case "macos":
            SharedLibFlags(compile_flags: ["-fPIC"], link_flags: ["-dynamiclib"],
                defines: ["SPL_SHARED_LIBRARY"], output_extension: ".dylib",
                import_lib_ext: "")
        case _:
            SharedLibFlags(compile_flags: ["-fPIC"], link_flags: ["-shared"],
                defines: ["SPL_SHARED_LIBRARY"], output_extension: ".so",
                import_lib_ext: "")
