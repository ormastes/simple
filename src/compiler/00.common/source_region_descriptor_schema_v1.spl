# Physical descriptor schema only. These checks do not grant SOURCE authority.
# Shape 4 rows describe each native 32-byte dictionary ENTRY, not header GEPs.
fn source_region_descriptor_schema_header_v1(shape: i64, extent: u64, count: i64) -> bool:
    if shape == 1:
        if count <= 0 or count > 288230376151711743: return false
        extent == count as u64 * 8u64
    elif shape == 4:
        extent == 64u64 and count == 2
    else:
        false

fn source_region_descriptor_schema_row_v1(shape: i64, extent: u64, count: i64,
    index: i64, offset: u64, width: u64, kind: u64, representation: u64) -> bool:
    if not source_region_descriptor_schema_header_v1(shape, extent, count): return false
    if index < 0 or index >= count or width != 8u64 or offset != index as u64 * 8u64: return false
    if shape == 4:
        if index == 0: return kind == 1u64 and representation == 0u64
        return kind == 2u64 and (representation == 1u64 or representation == 2u64)
    if kind == 1u64: return representation == 0u64
    if kind == 2u64 and representation == 4u64: return true
    (kind == 2u64 or kind == 3u64) and (representation == 1u64 or representation == 2u64)
