# Target-specific scalar ABI differences shared by HIR and aggregate layout.
# The caller supplies its existing architecture baseline; this narrow override
# must not change other architecture/OS combinations or pointer alignment.

pub fn target_scalar_alignment(type_name: text, arch: text, os: text, baseline: i64) -> i64:
    if arch == "x86" and os == "windows":
        if type_name == "i64" or type_name == "u64" or type_name == "f64":
            return 8
    baseline
