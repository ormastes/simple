# An ambiguous selected source authority is an error, never a missing module.
pub enum SourceRootResolutionV1:
    Found(text)
    Missing
    Ambiguous(text)

pub fn source_root_numbered_candidate_v1(entry: text, segment: text) -> bool:
    var prefix_len = 0
    while prefix_len < entry.len() and prefix_len < 3:
        val code = entry.char_code_at(prefix_len)
        if code < 48 or code > 57: break
        prefix_len = prefix_len + 1
    prefix_len >= 1 and prefix_len <= 3 and prefix_len < entry.len() and
        entry.char_at(prefix_len) == "." and entry.substring(prefix_len + 1) == segment

pub fn source_root_numbered_match_v1(previous: SourceRootResolutionV1,
        candidate: text, logical_directory: text) -> SourceRootResolutionV1:
    match previous:
        case SourceRootResolutionV1.Missing: SourceRootResolutionV1.Found(candidate)
        case SourceRootResolutionV1.Found(_): SourceRootResolutionV1.Ambiguous(logical_directory)
        case SourceRootResolutionV1.Ambiguous(_): previous

pub fn source_root_resolution_with_fallback_v1(selected: SourceRootResolutionV1,
        module_path: text, entry_dir: text,
        fallback: fn(text, text) -> text) -> SourceRootResolutionV1:
    match selected:
        case SourceRootResolutionV1.Found(_): selected
        case SourceRootResolutionV1.Ambiguous(_): selected
        case SourceRootResolutionV1.Missing:
            val path: text = fallback(module_path, entry_dir)
            if path == "": SourceRootResolutionV1.Missing
            else: SourceRootResolutionV1.Found(path)
