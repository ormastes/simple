# ROB-USE-01: must_use diagnostic policy shared by the typed-HIR discard check
# (35.semantics/must_use_discard.spl) and the interpreter's expression-statement
# path (10.frontend/core/interpreter/eval_stmts.spl). The interpreter has no HIR,
# so it cannot run the scan; it consumes this policy (codes, severity, and the
# R9 diagnostic text) so the two engines cannot drift.

pub val MUST_USE_CODE_RESULT: text = "SPL-USE-001"
pub val MUST_USE_CODE_MARKED: text = "SPL-USE-002"

# `script_mode` true only for interpreted script execution. Severity does not
# depend on the finding code.
# @allow(primitive_api) severity word is the diagnostic wire format shared with eval_warnings
pub fn must_use_finding_severity(script_mode: bool) -> text:
    if script_mode:
        return "warning"
    "error"

# Interpreter diagnostic for a discarded call to a `@must_use` function.
pub fn must_use_r9_marked_lines(fn_name: text, reason: text) -> [text]:
    var lines: [text] = ["error[R9]: return value of function '" + fn_name + "' must be used"]
    if reason != "":
        lines = lines.push("  = note: " + reason)
    lines = lines.push("  = help: assign to variable or use 'val _ = ...' to discard")
    lines

# Interpreter diagnostic for a discarded value under `@profile(critical)`.
pub fn must_use_r9_critical_lines(fn_name: text, type_name: text) -> [text]:
    ["error[R9]: return value of '" + fn_name + "' (" + type_name + ") discarded in @profile(critical)",
     "  = help: assign to variable or use 'val _ = ...' to discard"]
