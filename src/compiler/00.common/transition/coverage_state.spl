"""
Transition coverage states (hardening plan section 11.3).

A boundary between two compiler stages declares a TOTAL relation: every
variant the producer can emit carries exactly one declared state. The four
states below are the only ones that may be checked in.

`Missing` is deliberately NOT a variant. It is never written down; it is the
result of the set subtraction in `validator.spl`
(`ProducerUniverse - declared`) and it fails the build. Giving it a variant
would let a boundary declare its own hole and stay green.
"""

enum CoverageState:
    # The consumer has a real, explicit arm for this producer variant.
    Implemented
    # The variant never reaches the consumer: an earlier pass rewrites it into
    # `target` (a stable variant id on the consumer side).
    Normalized(target: text)
    # Honestly not handled. `reason` says what happens today; `issue` names a
    # tracking record when one exists (plan 11.3 types it `text?`, so a table
    # whose whole boundary is covered by a single header-level record may leave
    # it empty — `reason` may not be empty).
    Unsupported(reason: text, issue: text)
    # The variant cannot occur at this boundary at all (e.g. it is produced
    # only by a stage downstream of the consumer).
    NotApplicable(reason: text)

"""Canonical lowercase tag for a state, as written in the SDN `state:` field."""
fn coverage_state_tag(state: CoverageState) -> text:
    match state:
        case CoverageState.Implemented: "implemented"
        case CoverageState.Normalized(_): "normalized"
        case CoverageState.Unsupported(_, _): "unsupported"
        case CoverageState.NotApplicable(_): "not_applicable"

"""True when the state means the consumer really executes code for the variant."""
fn coverage_state_is_handled(state: CoverageState) -> bool:
    match state:
        case CoverageState.Implemented: true
        case CoverageState.Normalized(_): true
        case CoverageState.Unsupported(_, _): false
        case CoverageState.NotApplicable(_): false

"""Human-readable rendering, used in checker output and specs."""
fn coverage_state_describe(state: CoverageState) -> text:
    match state:
        case CoverageState.Implemented: "implemented"
        case CoverageState.Normalized(target): "normalized -> {target}"
        case CoverageState.Unsupported(reason, issue): "unsupported ({reason}) [{issue}]"
        case CoverageState.NotApplicable(reason): "not_applicable ({reason})"

"""
Build a state from its SDN fields.

Returns an error text instead of a state when the declaration is incomplete,
so a table cannot claim `unsupported` without an issue or `normalized`
without a target.
"""
"""
Split a `state:` scalar into its tag and its inline payload.

Both spellings in use are accepted: the plain tag `normalized` with the
payload in sibling fields, and the constructor form `Normalized(ExprKind.Call)`
that mirrors the enum declaration in plan 11.3. Returns ("Normalized",
"ExprKind.Call") or ("normalized", "").
"""
fn split_state_payload(raw: text) -> (text, text):
    val v = raw.trim()
    if not v.ends_with(")"):
        return (v, "")
    val open = v.index_of("(")
    if open < 0:
        return (v, "")
    return (v.substring(0, open).trim(), v.substring(open + 1, v.len() - 1).trim())

fn coverage_state_from_fields(
    tag_raw: text,
    to_target_in: text,
    reason_in: text,
    issue_in: text
) -> Result<CoverageState, text>:
    # Tables are hand-written and generated by several lanes; `Implemented`,
    # `implemented` and `NotApplicable` all mean the same state. Sibling fields
    # win over an inline payload when both are present.
    val split = split_state_payload(tag_raw)
    val tag = split.0.to_lower().replace("notapplicable", "not_applicable")
    val payload = split.1
    var to_target = to_target_in
    var reason = reason_in
    var issue = issue_in
    if payload != "":
        if tag == "normalized":
            if to_target == "":
                to_target = payload
        else:
            # `Unsupported(reason, issue)` / `NotApplicable(reason)`: the issue,
            # when present, is the tail after the first comma.
            val comma = payload.index_of(",")
            if comma < 0:
                if reason == "":
                    reason = payload
            else:
                if reason == "":
                    reason = payload.substring(0, comma).trim()
                if issue == "":
                    issue = payload.substring(comma + 1, payload.len()).trim()
    match tag:
        case "implemented":
            Ok(CoverageState.Implemented)
        case "normalized":
            if to_target == "":
                Err("state 'normalized' requires a non-empty 'to:' target")
            else:
                Ok(CoverageState.Normalized(target: to_target))
        case "unsupported":
            if reason == "":
                Err("state 'unsupported' requires a non-empty 'reason:'")
            else:
                Ok(CoverageState.Unsupported(reason: reason, issue: issue))
        case "not_applicable":
            if reason == "":
                Err("state 'not_applicable' requires a non-empty 'reason:'")
            else:
                Ok(CoverageState.NotApplicable(reason: reason))
        case _:
            Err("unknown coverage state '{tag}' (expected implemented|normalized|unsupported|not_applicable)")
