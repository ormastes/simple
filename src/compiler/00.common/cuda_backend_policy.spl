# Compiler provider placement only. Device availability belongs to the runtime.
# The selected source composition installs this once before compilation.
var _cuda_backend_mode_v1: text = "unselected"

pub fn install_cuda_backend_mode_v1(mode: text) -> bool:
    if mode != "static" and mode != "disabled" and mode != "dynamic": return false
    if _cuda_backend_mode_v1 != "unselected": return _cuda_backend_mode_v1 == mode
    _cuda_backend_mode_v1 = mode
    true

pub fn installed_cuda_backend_mode_v1() -> text:
    _cuda_backend_mode_v1

pub fn cuda_backend_request_error_v1(mode: text, backend: text, plugin_path: text) -> text:
    if backend != "cuda" and backend != "ptx": return ""
    if mode == "disabled":
        return "PLUG-E-DISABLED: CUDA/PTX compiler provider is disabled in this composition"
    if plugin_path != "" or mode == "dynamic":
        return "BACKEND_PLUGIN_GPU_ARTIFACT_UNSUPPORTED: CUDA/PTX dynamic providers require a GPU artifact capability; simple_backend_plugin_v1 only finalizes objects"
    if mode != "static":
        return "PLUG-E-CUDA-POLICY: CUDA/PTX compiler composition has not been selected"
    ""
