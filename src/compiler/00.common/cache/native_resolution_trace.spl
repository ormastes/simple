# Neutral retained resolver evidence shared by HIR and cache consumers.

struct NativeResolutionProbeV1:
    path: text
    found: bool

struct NativeResolutionTraceV1:
    consumer_module_id: text
    import_id: text
    probes: [NativeResolutionProbeV1]
    selected: text
    selected_count: i64
    dir_generation: text
    resolver_version: text

export NativeResolutionProbeV1, NativeResolutionTraceV1
