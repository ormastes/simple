# Versioned, producer-neutral identity for compiler reverse-reference entries.
# Registry payloads and mutable indexes remain owned by their existing layers.

use std.common.crypto.sha256.{sha256_text}

struct ReverseReferenceKeyV1:
    registry_kind: text
    owner_generation: text
    root_generation: text
    subject_identity: text
    projection_kind: text
    projection_digest: text
    schema_version: i64

struct ReverseReferenceKeyValidationV1:
    valid: bool
    reason: text

struct ReverseReferenceKeyDecodeV1:
    valid: bool
    reason: text
    key: ReverseReferenceKeyV1?
    digest: text

struct ReverseReferenceTextTokenV1:
    valid: bool
    reason: text
    value: text
    next: i64

struct ReverseReferenceNatTokenV1:
    valid: bool
    reason: text
    value: i64
    next: i64

fn reverse_reference_key_schema_version_v1() -> i64: 1

fn reverse_reference_registry_kind_known_v1(kind: text) -> bool:
    (kind == "semantic" or kind == "native" or kind == "linker" or
        kind == "aop" or kind == "bootstrap")

fn reverse_reference_projection_kind_known_v1(kind: text) -> bool:
    (kind == "direct-import-export" or kind == "trait-type-implementation" or
        kind == "unresolved-method-candidate" or kind == "annotation-consumer" or
        kind == "generic-specialization" or kind == "aop-consumer" or
        kind == "runtime-provider" or kind == "initializer-dependent" or
        kind == "module-scc-artifact" or kind == "emitted-symbol-relocation")

fn reverse_reference_hash256_valid_v1(value: text) -> bool:
    if value.len() != 64:
        return false
    for ch in value:
        if not ((ch >= '0' and ch <= '9') or (ch >= 'a' and ch <= 'f')):
            return false
    true

fn reverse_reference_key_validate_v1(key: ReverseReferenceKeyV1) -> ReverseReferenceKeyValidationV1:
    if key.schema_version != reverse_reference_key_schema_version_v1():
        return ReverseReferenceKeyValidationV1(valid: false, reason: "unsupported-schema-version")
    if not reverse_reference_registry_kind_known_v1(key.registry_kind):
        return ReverseReferenceKeyValidationV1(valid: false, reason: "unknown-registry-kind")
    if key.owner_generation == "":
        return ReverseReferenceKeyValidationV1(valid: false, reason: "missing-owner-generation")
    if key.root_generation == "":
        return ReverseReferenceKeyValidationV1(valid: false, reason: "missing-root-generation")
    if key.subject_identity == "":
        return ReverseReferenceKeyValidationV1(valid: false, reason: "missing-subject-identity")
    if not reverse_reference_projection_kind_known_v1(key.projection_kind):
        return ReverseReferenceKeyValidationV1(valid: false, reason: "unknown-projection-kind")
    if not reverse_reference_hash256_valid_v1(key.projection_digest):
        return ReverseReferenceKeyValidationV1(valid: false, reason: "invalid-projection-digest")
    ReverseReferenceKeyValidationV1(valid: true, reason: "ok")

# This is the compiler cache Canon grammar owned by action_key.spl. This common
# layer cannot depend upward on compiler.driver, so these primitives mirror its
# F/S/N/Q wire contract. Lengths are Simple text lengths, exactly as canon_str
# and canon_field define them; substring uses the same units, including UTF-8.
fn reverse_reference_frame_text_v1(value: text) -> text:
    "S" + "{value.len()}" + ":" + value

fn reverse_reference_frame_nat_v1(value: i64) -> text:
    "N" + "{value}" + ";"

fn reverse_reference_frame_field_v1(name: text, value: text) -> text:
    "F" + "{name.len()}" + ":" + name + value

fn reverse_reference_key_encode_v1(key: ReverseReferenceKeyV1) -> text:
    val validation = reverse_reference_key_validate_v1(key)
    if not validation.valid:
        return ""
    val body = reverse_reference_frame_field_v1(
        "registryKind", reverse_reference_frame_text_v1(key.registry_kind)) +
        reverse_reference_frame_field_v1(
            "ownerGeneration", reverse_reference_frame_text_v1(key.owner_generation)) +
        reverse_reference_frame_field_v1(
            "rootGeneration", reverse_reference_frame_text_v1(key.root_generation)) +
        reverse_reference_frame_field_v1(
            "subjectIdentity", reverse_reference_frame_text_v1(key.subject_identity)) +
        reverse_reference_frame_field_v1(
            "projectionKind", reverse_reference_frame_text_v1(key.projection_kind)) +
        reverse_reference_frame_field_v1(
            "projectionDigest", reverse_reference_frame_text_v1(key.projection_digest)) +
        reverse_reference_frame_field_v1(
            "schemaVersion", reverse_reference_frame_nat_v1(key.schema_version))
    reverse_reference_frame_field_v1(
        "simple/reverse-reference-key/v1", "Q7:" + body)

fn reverse_reference_key_digest_v1(key: ReverseReferenceKeyV1) -> text:
    val encoded = reverse_reference_key_encode_v1(key)
    if encoded == "": "" else: sha256_text(encoded)

fn reverse_reference_invalid_text_token_v1(reason: text) -> ReverseReferenceTextTokenV1:
    ReverseReferenceTextTokenV1(false, reason, "", 0)

fn reverse_reference_invalid_nat_token_v1(reason: text) -> ReverseReferenceNatTokenV1:
    ReverseReferenceNatTokenV1(false, reason, 0, 0)

fn reverse_reference_decimal_end_v1(frame: text, start: i64, delimiter: text) -> i64:
    var cursor = start
    while cursor < frame.len():
        val ch = frame.substring(cursor, cursor + 1)
        if ch == delimiter:
            return cursor
        if ch < "0" or ch > "9":
            return -1
        cursor = cursor + 1
    -1

fn reverse_reference_parse_text_token_v1(frame: text, start: i64) -> ReverseReferenceTextTokenV1:
    if start < 0 or start >= frame.len() or frame.substring(start, start + 1) != "S":
        return reverse_reference_invalid_text_token_v1("invalid-text-token")
    val colon = reverse_reference_decimal_end_v1(frame, start + 1, ":")
    if colon <= start + 1:
        return reverse_reference_invalid_text_token_v1("invalid-text-length")
    val length_text = frame.substring(start + 1, colon)
    val length = length_text.to_i64()
    if length == nil or length! < 0 or "{length!}" != length_text:
        return reverse_reference_invalid_text_token_v1("invalid-text-length")
    val value_start = colon + 1
    val value_end = value_start + length!
    if value_end > frame.len():
        return reverse_reference_invalid_text_token_v1("truncated-text")
    ReverseReferenceTextTokenV1(true, "ok", frame.substring(value_start, value_end), value_end)

fn reverse_reference_parse_nat_token_v1(frame: text, start: i64) -> ReverseReferenceNatTokenV1:
    if start < 0 or start >= frame.len() or frame.substring(start, start + 1) != "N":
        return reverse_reference_invalid_nat_token_v1("invalid-schema-token")
    val semi = reverse_reference_decimal_end_v1(frame, start + 1, ";")
    if semi <= start + 1:
        return reverse_reference_invalid_nat_token_v1("invalid-schema-token")
    val value_text = frame.substring(start + 1, semi)
    val value = value_text.to_i64()
    if value == nil or value! < 0 or "{value!}" != value_text:
        return reverse_reference_invalid_nat_token_v1("invalid-schema-token")
    ReverseReferenceNatTokenV1(true, "ok", value!, semi + 1)

fn reverse_reference_parse_field_text_v1(frame: text, start: i64, name: text) -> ReverseReferenceTextTokenV1:
    val prefix = "F{name.len()}:" + name
    val prefix_end = start + prefix.len()
    if start < 0 or prefix_end > frame.len() or frame.substring(start, prefix_end) != prefix:
        return reverse_reference_invalid_text_token_v1("invalid-field-order-or-name")
    reverse_reference_parse_text_token_v1(frame, prefix_end)

fn reverse_reference_parse_field_nat_v1(frame: text, start: i64, name: text) -> ReverseReferenceNatTokenV1:
    val prefix = "F{name.len()}:" + name
    val prefix_end = start + prefix.len()
    if start < 0 or prefix_end > frame.len() or frame.substring(start, prefix_end) != prefix:
        return reverse_reference_invalid_nat_token_v1("invalid-field-order-or-name")
    reverse_reference_parse_nat_token_v1(frame, prefix_end)

fn reverse_reference_key_decode_v1(frame: text) -> ReverseReferenceKeyDecodeV1:
    val outer = "F31:simple/reverse-reference-key/v1Q7:"
    if frame.len() < outer.len() or frame.substring(0, outer.len()) != outer:
        return ReverseReferenceKeyDecodeV1(false, "invalid-domain-or-field-count", nil, "")
    val registry = reverse_reference_parse_field_text_v1(frame, outer.len(), "registryKind")
    if not registry.valid:
        return ReverseReferenceKeyDecodeV1(false, registry.reason, nil, "")
    val owner = reverse_reference_parse_field_text_v1(frame, registry.next, "ownerGeneration")
    if not owner.valid:
        return ReverseReferenceKeyDecodeV1(false, owner.reason, nil, "")
    val root = reverse_reference_parse_field_text_v1(frame, owner.next, "rootGeneration")
    if not root.valid:
        return ReverseReferenceKeyDecodeV1(false, root.reason, nil, "")
    val subject = reverse_reference_parse_field_text_v1(frame, root.next, "subjectIdentity")
    if not subject.valid:
        return ReverseReferenceKeyDecodeV1(false, subject.reason, nil, "")
    val projection = reverse_reference_parse_field_text_v1(frame, subject.next, "projectionKind")
    if not projection.valid:
        return ReverseReferenceKeyDecodeV1(false, projection.reason, nil, "")
    val projection_digest = reverse_reference_parse_field_text_v1(frame, projection.next, "projectionDigest")
    if not projection_digest.valid:
        return ReverseReferenceKeyDecodeV1(false, projection_digest.reason, nil, "")
    val schema = reverse_reference_parse_field_nat_v1(frame, projection_digest.next, "schemaVersion")
    if not schema.valid:
        return ReverseReferenceKeyDecodeV1(false, schema.reason, nil, "")
    if schema.next != frame.len():
        return ReverseReferenceKeyDecodeV1(false, "trailing-data", nil, "")
    val key = ReverseReferenceKeyV1(registry.value, owner.value, root.value, subject.value,
        projection.value, projection_digest.value, schema.value)
    val validation = reverse_reference_key_validate_v1(key)
    if not validation.valid:
        return ReverseReferenceKeyDecodeV1(false, validation.reason, nil, "")
    ReverseReferenceKeyDecodeV1(true, "ok", Some(key), sha256_text(frame))

export ReverseReferenceKeyV1, ReverseReferenceKeyValidationV1, ReverseReferenceKeyDecodeV1
export reverse_reference_key_schema_version_v1
export reverse_reference_registry_kind_known_v1
export reverse_reference_projection_kind_known_v1
export reverse_reference_key_validate_v1
export reverse_reference_key_encode_v1, reverse_reference_key_digest_v1
export reverse_reference_key_decode_v1
