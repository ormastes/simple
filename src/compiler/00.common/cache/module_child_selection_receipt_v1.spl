# One actual configured namespace-child selection. This is provenance, never
# permission: even a selected pub child cannot authorize a closed ancestor.
pub struct ModuleChildSelectionReceiptV1:
    selected: bool = false
    reason: text = "module-child-route-unavailable"
    configured_namespace: text = ""
    selected_name: text = ""
    manifest_surface: i64 = -1
    manifest_path: text = ""
    child_ordinal: i64 = -1
    child_name: text = ""
    child_modifier: text = ""
    policy_digest: text = ""
    snapshot_id: text = ""
    target_surface: i64 = -1
    target_path: text = ""
    target_digest: text = ""
    target_kind: text = ""
    configured_route_generation: text = ""
    registry_generation: i64 = 0

export ModuleChildSelectionReceiptV1
