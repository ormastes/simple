# Compact parser projection of an implicitly observed manifest. This record
# does not make its imports or executable declarations compilation inputs.
use compiler.common.dependency.manifest_visibility_v1.{ParserManifestVisibilityV1}

pub class VisibilityManifestPolicyV1:
    source_path: text
    directory_path: text
    coverage_root: text
    content_sha256: text
    snapshot_id: text
    has_arch: bool = false
    dimension: text = ""
    layer: text = ""
    expose_paths: [text] = []
    child_names: [text] = []
    child_visibilities: [text] = []
    child_modifiers: [text] = []
    # Retain the existing scoped-access inputs together: a friend name alone
    # never substitutes for internal-export eligibility.
    friend_modules: [text] = []
    internal_exports: [text] = []
    valid: bool = false
    frontend_identity: text = ""
    parser_provider_id: text = ""
    frontend_route: text = ""
    advisory_policy: text = ""
    advisory_identity: text = ""
    target_triple: text = ""
    preprocessed_source_sha256: text = ""
    cfg_receipt_present: bool = false
    cfg_source_identity: text = ""
    cfg_preprocessed_sha256: text = ""
    cfg_decision_digest: text = ""
    # Rows align with explicit child_names. Empty targets are unresolved and
    # grant nothing. Paths and SHA come from the actual configured resolver
    # and authenticated snapshot membership, never name/path reconstruction.
    child_target_paths: [text] = []
    child_target_sha256: [text] = []
    # Empty unless selected. DirectoryInterface is an actual resolver branch,
    # never a guess based on an __init__.spl filename suffix.
    child_target_kinds: [text] = []
    child_resolution_outcomes: [text] = []

    static fn from_facts(source_path: text, directory_path: text,
            coverage_root: text, content_sha256: text, snapshot_id: text,
            facts: ParserManifestVisibilityV1) -> VisibilityManifestPolicyV1:
        val has_arch: bool = facts.has_arch
        val dimension: text = facts.dimension
        val layer: text = facts.layer
        val expose_paths: [text] = facts.expose_paths
        val child_names: [text] = facts.child_names
        val child_visibilities: [text] = facts.child_visibilities
        val child_modifiers: [text] = facts.child_modifiers
        val valid: bool = facts.valid
        VisibilityManifestPolicyV1(source_path: source_path,
            directory_path: directory_path, coverage_root: coverage_root,
            content_sha256: content_sha256, snapshot_id: snapshot_id,
            has_arch: has_arch, dimension: dimension, layer: layer,
            expose_paths: expose_paths, child_names: child_names,
            child_visibilities: child_visibilities, child_modifiers: child_modifiers, valid: valid)

    fn facts() -> ParserManifestVisibilityV1:
        ParserManifestVisibilityV1(has_arch: self.has_arch,
            dimension: self.dimension, layer: self.layer,
            expose_paths: self.expose_paths, child_names: self.child_names,
            child_visibilities: self.child_visibilities, child_modifiers: self.child_modifiers, valid: self.valid)

export VisibilityManifestPolicyV1
