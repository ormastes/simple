# Canonical identity encoding shared by compiler layers.

use std.common.crypto.types.{crypto_text_to_bytes as text_to_bytes}

pub fn canonical_identity_text_lt(a: text, b: text) -> bool:
    val ab = text_to_bytes(a)
    val bb = text_to_bytes(b)
    val an = ab.len()
    val bn = bb.len()
    var index = 0
    while index < an and index < bn:
        val left = ab[index] as i64
        val right = bb[index] as i64
        if left < right:
            return true
        if left > right:
            return false
        index = index + 1
    an < bn

pub fn canonical_identity_text_le(a: text, b: text) -> bool:
    canonical_identity_text_lt(a, b) or a == b

fn canonical_identity_text_sift_down(
    mut items: [text], root_index: i64, heap_len: i64
):
    var root = root_index
    while true:
        val left = root * 2 + 1
        if left >= heap_len:
            return
        var largest = root
        if canonical_identity_text_lt(items[largest], items[left]):
            largest = left
        val right = left + 1
        if right < heap_len and canonical_identity_text_lt(items[largest], items[right]):
            largest = right
        if largest == root:
            return
        val temporary = items[root]
        items[root] = items[largest]
        items[largest] = temporary
        root = largest

pub fn canonical_identity_sort_texts(items: [text]) -> [text]:
    var out = items
    if out.len() < 2:
        return out
    var start = out.len() / 2
    while start > 0:
        start = start - 1
        canonical_identity_text_sift_down(out, start, out.len())
    var end = out.len()
    while end > 1:
        end = end - 1
        val temporary = out[0]
        out[0] = out[end]
        out[end] = temporary
        canonical_identity_text_sift_down(out, 0, end)
    out

pub fn canon_str(value: text) -> text:
    "S" + "{value.len()}" + ":" + value

pub fn canon_nat(value: i64) -> text:
    "N" + "{value}" + ";"

pub fn canon_field(tag: text, encoded_value: text) -> text:
    "F" + "{tag.len()}" + ":" + tag + encoded_value

pub fn canon_seq(encoded_items: [text]) -> text:
    var body = ""
    for item in encoded_items:
        body = body + item
    "Q" + "{encoded_items.len()}" + ":" + body
