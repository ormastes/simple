# Shared invocation resource account. Fixed scalar errors and observations only.
# Reservations are cumulative pre-growth logical charges, not a physical RSS proof.
# The legacy rich-ledger factory is a separate compatibility route.

struct MirLoopResourceLimitsV1:
    max_blocks: i64 = 4096
    max_locals: i64 = 4096
    max_edges: i64 = 65536
    max_instructions: i64 = 65536
    max_sites: i64 = 256
    max_depth: i64 = 128
    max_predicate_nodes: i64 = 65536
    max_work: i64 = 1048576
    max_state_fields: i64 = 262144
    max_output_bytes: i64 = 1048576

enum MirLoopResourceErrorV1:
    InvalidLimit
    Capacity
    InvalidReservation
    Closed

enum MirLoopResourceKindV1:
    Work
    Blocks
    Edges
    Instructions
    StateFields
    PredicateNodes
    OutputBytes

struct MirLoopResourceSnapshotV1:
    stage_id: i64 = 0
    work_used: i64 = 0
    blocks: i64 = 0
    edges: i64 = 0
    instructions: i64 = 0
    state_fields: i64 = 0
    predicate_nodes: i64 = 0
    output_bytes: i64 = 0
    exact: bool = true
    closed: bool = false

fn resource_limits_valid_v1(limits: MirLoopResourceLimitsV1) -> bool:
    if limits == nil: return false
    (limits.max_blocks >= 0 and limits.max_blocks <= 4096 and
        limits.max_locals >= 0 and limits.max_locals <= 4096 and
        limits.max_edges >= 0 and limits.max_edges <= 65536 and
        limits.max_instructions >= 0 and limits.max_instructions <= 65536 and
        limits.max_sites >= 0 and limits.max_sites <= 256 and
        limits.max_depth >= 0 and limits.max_depth <= 128 and
        limits.max_predicate_nodes >= 0 and limits.max_predicate_nodes <= 65536 and
        limits.max_work >= 0 and limits.max_work <= 1048576 and
        limits.max_state_fields >= 0 and limits.max_state_fields <= 262144 and
        limits.max_output_bytes >= 0 and limits.max_output_bytes <= 1048576)

class MirLoopResourceAccountV1:
    limits_: MirLoopResourceLimitsV1
    observed_: MirLoopResourceSnapshotV1

    static fn create(limits: MirLoopResourceLimitsV1) -> Result<MirLoopResourceAccountV1, MirLoopResourceErrorV1>:
        if not resource_limits_valid_v1(limits):
            return Err(MirLoopResourceErrorV1.InvalidLimit)
        # Ten limits, seven usage counters, stage, exactness and closed = 20.
        # Check the initial allocation's reservation before creating the class.
        if limits.max_work < 20 or limits.max_state_fields < 20:
            return Err(MirLoopResourceErrorV1.Capacity)
        Ok(MirLoopResourceAccountV1(limits_: limits,
            observed_: MirLoopResourceSnapshotV1(work_used: 20, state_fields: 20)))

    me reserve(work: i64, blocks: i64 = 0, edges: i64 = 0,
        instructions: i64 = 0, state_fields: i64 = 0,
        predicate_nodes: i64 = 0, output_bytes: i64 = 0) -> Result<(), MirLoopResourceErrorV1>:
        if self.observed_.closed: return Err(MirLoopResourceErrorV1.Closed)
        if work < 0 or blocks < 0 or edges < 0 or instructions < 0 or state_fields < 0 or predicate_nodes < 0 or output_bytes < 0:
            return Err(MirLoopResourceErrorV1.InvalidReservation)
        # Subtract, rather than summing caller deltas: even hostile i64 inputs
        # cannot overflow before their reservation is refused.
        var unassigned_work = work
        if blocks > unassigned_work: return Err(MirLoopResourceErrorV1.InvalidReservation)
        unassigned_work = unassigned_work - blocks
        if edges > unassigned_work: return Err(MirLoopResourceErrorV1.InvalidReservation)
        unassigned_work = unassigned_work - edges
        if instructions > unassigned_work: return Err(MirLoopResourceErrorV1.InvalidReservation)
        unassigned_work = unassigned_work - instructions
        if state_fields > unassigned_work: return Err(MirLoopResourceErrorV1.InvalidReservation)
        unassigned_work = unassigned_work - state_fields
        if predicate_nodes > unassigned_work: return Err(MirLoopResourceErrorV1.InvalidReservation)
        unassigned_work = unassigned_work - predicate_nodes
        if output_bytes > unassigned_work: return Err(MirLoopResourceErrorV1.InvalidReservation)
        unassigned_work = unassigned_work - output_bytes
        if self.observed_.work_used < 0 or self.observed_.work_used > self.limits_.max_work or work > self.limits_.max_work - self.observed_.work_used:
            return Err(MirLoopResourceErrorV1.Capacity)
        if self.observed_.blocks < 0 or self.observed_.blocks > self.limits_.max_blocks or blocks > self.limits_.max_blocks - self.observed_.blocks:
            return Err(MirLoopResourceErrorV1.Capacity)
        if self.observed_.edges < 0 or self.observed_.edges > self.limits_.max_edges or edges > self.limits_.max_edges - self.observed_.edges:
            return Err(MirLoopResourceErrorV1.Capacity)
        if self.observed_.instructions < 0 or self.observed_.instructions > self.limits_.max_instructions or instructions > self.limits_.max_instructions - self.observed_.instructions:
            return Err(MirLoopResourceErrorV1.Capacity)
        if self.observed_.state_fields < 0 or self.observed_.state_fields > self.limits_.max_state_fields or state_fields > self.limits_.max_state_fields - self.observed_.state_fields:
            return Err(MirLoopResourceErrorV1.Capacity)
        if self.observed_.predicate_nodes < 0 or self.observed_.predicate_nodes > self.limits_.max_predicate_nodes or predicate_nodes > self.limits_.max_predicate_nodes - self.observed_.predicate_nodes:
            return Err(MirLoopResourceErrorV1.Capacity)
        if self.observed_.output_bytes < 0 or self.observed_.output_bytes > self.limits_.max_output_bytes or output_bytes > self.limits_.max_output_bytes - self.observed_.output_bytes:
            return Err(MirLoopResourceErrorV1.Capacity)
        # Every check completed. The following additions are bounded by caps.
        self.observed_.work_used = self.observed_.work_used + work
        self.observed_.blocks = self.observed_.blocks + blocks
        self.observed_.edges = self.observed_.edges + edges
        self.observed_.instructions = self.observed_.instructions + instructions
        self.observed_.state_fields = self.observed_.state_fields + state_fields
        self.observed_.predicate_nodes = self.observed_.predicate_nodes + predicate_nodes
        self.observed_.output_bytes = self.observed_.output_bytes + output_bytes
        Ok(())

    fn remaining(kind: MirLoopResourceKindV1) -> i64:
        if self.observed_.closed: return 0
        match kind:
            case MirLoopResourceKindV1.Work: self.limits_.max_work - self.observed_.work_used
            case MirLoopResourceKindV1.Blocks: self.limits_.max_blocks - self.observed_.blocks
            case MirLoopResourceKindV1.Edges: self.limits_.max_edges - self.observed_.edges
            case MirLoopResourceKindV1.Instructions: self.limits_.max_instructions - self.observed_.instructions
            case MirLoopResourceKindV1.StateFields: self.limits_.max_state_fields - self.observed_.state_fields
            case MirLoopResourceKindV1.PredicateNodes: self.limits_.max_predicate_nodes - self.observed_.predicate_nodes
            case MirLoopResourceKindV1.OutputBytes: self.limits_.max_output_bytes - self.observed_.output_bytes

    fn snapshot() -> MirLoopResourceSnapshotV1:
        # This copies a fixed-size scalar record, never graph or text payloads.
        MirLoopResourceSnapshotV1(stage_id: self.observed_.stage_id,
            work_used: self.observed_.work_used, blocks: self.observed_.blocks,
            edges: self.observed_.edges, instructions: self.observed_.instructions,
            state_fields: self.observed_.state_fields,
            predicate_nodes: self.observed_.predicate_nodes,
            output_bytes: self.observed_.output_bytes,
            exact: self.observed_.exact, closed: self.observed_.closed)

    fn limits() -> MirLoopResourceLimitsV1:
        self.limits_

    me set_stage(stage: i64) -> Result<(), MirLoopResourceErrorV1>:
        if self.observed_.closed: return Err(MirLoopResourceErrorV1.Closed)
        if stage < 0: return Err(MirLoopResourceErrorV1.InvalidReservation)
        self.observed_.stage_id = stage
        Ok(())

    me close():
        self.observed_.closed = true

    fn is_closed() -> bool:
        self.observed_.closed

export MirLoopResourceLimitsV1, MirLoopResourceErrorV1, MirLoopResourceKindV1
export MirLoopResourceSnapshotV1, MirLoopResourceAccountV1
