# Compiler-private scalar observations only. These functions debit the SAME
# actual invocation account; a returned bound is not authority or paid credit.
# Actual lexical confinement, C stack witness ownership, canonical array/type
# decoding and failure cleanup/abort remain the owning transaction's duties.
use compiler.common.loop_resource_account_v1.{MirLoopResourceAccountV1}
use compiler.common.source_region_context_v1.{SourceRegionErrorV1, source_region_reserve_v1, source_region_value_v1}

@unsafe(reason: "private native dictionary snapshot owner observation", capabilities: [ffi, raw_ptr])
extern fn rt_dict_snapshot_observation_bound_v1() -> i64
@unsafe(reason: "private canonical array registration cost observation", capabilities: [ffi, raw_ptr])
extern fn rt_array_snapshot_bound_v1(length: i64, metric: i64) -> i64
@unsafe(reason: "private snapshot current registry and traversal cost observation", capabilities: [ffi, raw_ptr])
extern fn rt_dict_snapshot_fill_bound_v1(capacity: i64, length: i64) -> i64

@unsafe(reason: "actual native snapshot owner and compiler invocation account required", capabilities: [ffi, raw_ptr])
pub fn source_region_snapshot_observation_bound_v1(account: MirLoopResourceAccountV1) -> Result<i64, SourceRegionErrorV1>:
    source_region_reserve_v1(account, 1, 0, 0)?
    val result = unsafe(capabilities: [ffi, raw_ptr]): rt_dict_snapshot_observation_bound_v1()
    source_region_value_v1(result)

@unsafe(reason: "actual canonical array owner cost; not allocation permission", capabilities: [ffi, raw_ptr])
pub fn source_region_snapshot_array_bound_v1(account: MirLoopResourceAccountV1,
        length: i64, metric: i64) -> Result<i64, SourceRegionErrorV1>:
    if length < 0 or metric < 0 or metric > 2: return Err(SourceRegionErrorV1.Incomplete)
    source_region_reserve_v1(account, 1, 0, 0)?
    val result = unsafe(capabilities: [ffi, raw_ptr]): rt_array_snapshot_bound_v1(length, metric)
    source_region_value_v1(result)

# Acquire BOTH fill and cleanup observations AFTER output New: its registration
# changes the dimensions used by native bounds. Failure here or in subsequent
# reservation needs actual owner-abort retention or qualified cleanup; never
# invent a credit from this scalar result. (0,0) is the cleanup bound query.
@unsafe(reason: "actual retained snapshot/output owner and current dimensions required", capabilities: [ffi, raw_ptr])
pub fn source_region_snapshot_fill_bound_v1(account: MirLoopResourceAccountV1,
        capacity: i64, length: i64) -> Result<i64, SourceRegionErrorV1>:
    if capacity < 0 or length < 0 or length > capacity: return Err(SourceRegionErrorV1.Incomplete)
    source_region_reserve_v1(account, 1, 0, 0)?
    val result = unsafe(capabilities: [ffi, raw_ptr]): rt_dict_snapshot_fill_bound_v1(capacity, length)
    source_region_value_v1(result)
