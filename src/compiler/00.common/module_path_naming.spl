# Shared module-name-from-path derivation.
#
# This is the SINGLE canonical home for a derivation that used to be
# hand-duplicated four times across compiler layers (80.driver, 70.backend,
# 50.mir, 20.hir) because each of those layers could not import a sibling
# or a higher layer. 00.common sits below all four, so every caller can
# import this copy directly instead of re-deriving it locally.
#
# Former call sites (now import this module instead of re-implementing):
#   - _driver_module_name_from_path (80.driver/driver_source_loading.spl)
#   - llvm_module_name_from_entry_path (70.backend _MirToLlvm/core_codegen.spl)
#   - bootstrap_mir_logical_module_name (50.mir/_MirLowering/bootstrap_globals.spl)
#   - hir_module_logical_name_from_path (20.hir hir_lowering/_Items/module_lowering.spl)
#
# History: 70a29867bc2 changed only one of the four hand-kept copies, and the
# drift made `entry_main_symbol` false for every out-of-tree entry -> no
# `__simple_main` -> the whole native-smoke-matrix went 0/19. Consolidating
# to one function removes the drift class entirely.

fn _module_path_naming_text_index_of(value: text, needle: text) -> i64:
    if needle == "":
        return 0
    val value_len = value.len()
    val needle_len = needle.len()
    if needle_len > value_len:
        return -1
    var start = 0
    while start <= value_len - needle_len:
        var offset = 0
        while offset < needle_len and value.byte_at(start + offset) == needle.byte_at(offset):
            offset = offset + 1
        if offset == needle_len:
            return start
        start = start + 1
    -1

fn _module_path_naming_tier_inner_twin(stripped_tier: text, final_part: text) -> bool:
    """True when `NN.<tier>/<tier>/<final_part>.spl` shadows an existing
    `NN.<tier>/<final_part>.spl` tier-root twin. The resolver probes the tier
    root first, so the tier-root file owns the collapsed spelling and the
    inner twin must keep its doubled name. Verified against the tree on
    2026-10-12 by enumerating every `NN.name/name` tier pair; exactly these
    twins exist. Keep in sync when adding a tier-root file whose inner twin
    dir repeats the tier name."""
    if stripped_tier == "backend":
        return final_part == "__init__" or final_part == "backend_types"
    if stripped_tier == "blocks":
        return final_part == "__init__"
    if stripped_tier == "mir_opt":
        return final_part == "__init__"
    if stripped_tier == "semantics":
        return final_part == "__init__"
    if stripped_tier == "mir":
        return final_part == "__init__"
    if stripped_tier == "mdsoc":
        return final_part == "construct_types" or final_part == "types"
    if stripped_tier == "loader":
        return final_part == "__init__" or final_part == "compiler_sffi" or
            final_part == "jit_context" or final_part == "jit_instantiator" or
            final_part == "object_mapper" or final_part == "smf_cache" or
            final_part == "smf_mmap_native"
    false

fn _module_path_naming_strip_numbered_dirs(path: text) -> text:
    """Make resolver-transparent `NN.name` directories transparent here too.

    ModuleResolver accepts one-to-three digit directory prefixes, so physical
    `editor/00.common/types.spl` owns logical `editor.common.types`.  Applying
    this before slash-to-dot conversion preserves numeric dotted file-name
    segments while keeping the identity pass linear in the number of path
    segments.
    """
    var logical_parts: [text] = []
    val parts = path.split("/")
    var part_index = 0
    while part_index < parts.len():
        val part = parts[part_index]
        var prefix_len = 0
        val part_len = part.len()
        while part_index + 1 < parts.len() and prefix_len < part_len and prefix_len < 3:
            val code = part.char_code_at(prefix_len)
            if code < 48 or code > 57:
                break
            prefix_len = prefix_len + 1
        if part_index + 1 < parts.len() and prefix_len >= 1 and prefix_len <= 3 and prefix_len < part_len and part.char_at(prefix_len) == ".":
            val stripped_part = part.substring(prefix_len + 1)
            # `NN.name/name/...` tiers repeat their own name inside the tier
            # dir (`src/compiler/70.backend/backend/...`, `15.blocks/blocks/...`,
            # `60.mir_opt/mir_opt/...`). The module resolver maps the single
            # spelling onto that same tree (`compiler.backend.*`); folding the
            # redundant inner repeat keeps path-derived keys identical to the
            # import spellings so the shard/full-inventory registry (path-only
            # names) and the sequential registry (import-string aliases) agree
            # (C7 shard doubled-key family, 2026-10-12).
            #
            # Exception: a direct child of the inner repeat dir that also
            # exists at the tier root (`70.backend/backend_types.spl` vs
            # `70.backend/backend/backend_types.spl`, both `__init__.spl`
            # pairs). The resolver probes the tier root first, so the
            # tier-root file owns the collapsed spelling; collapsing the inner
            # twin too would give two physical files one registry key
            # ("module surface name maps to conflicting indices"). The inner
            # twin keeps its doubled name and its doubled import spelling.
            # Direct child of the inner repeat dir means exactly one part
            # follows it; deeper paths (e.g. `backend/native/mach_inst`) can
            # never shadow a tier-root file.
            val inner_direct_child = part_index + 2 == parts.len() - 1
            val collapse_inner_repeat = part_index + 2 < parts.len() and
                parts[part_index + 1] == stripped_part and
                (not inner_direct_child or
                 not _module_path_naming_tier_inner_twin(
                     stripped_part, parts[parts.len() - 1]))
            if collapse_inner_repeat:
                part_index = part_index + 2
            else:
                part_index = part_index + 1
            logical_parts.push(stripped_part)
        else:
            logical_parts.push(part)
            part_index = part_index + 1
    logical_parts.join("/")

pub fn module_source_relative_path(path: text) -> text:
    """Repo-relative source path (`src/...` / `examples/...`) from any
    spelling of it: `../`/`./` prefixes and everything before an absolute
    `/src/` or `/examples/` are dropped, so a worktree, a frozen SCV snapshot
    (`build/scv_snapshots/<revision>/src/...`) and a bare relative path all
    name the same module. This is the ONLY path identity that may reach a
    native symbol: `mir_dynamic_module_init_name` used the raw parsed path,
    and under SCV freeze that is the absolute snapshot path, which embeds the
    host directory and a content hash -- so `__module_init_*` could never
    match the fixed name a C shim declares (cm33_shim.c, gate
    check-cm33-scalar-parser-fs-object.shs)."""
    var mod_path = path.replace("\\", "/")
    while mod_path.starts_with("../"):
        mod_path = mod_path.substring(3)
    if mod_path.starts_with("./"):
        mod_path = mod_path.substring(2)
    val absolute_src = _module_path_naming_text_index_of(mod_path, "/src/")
    if absolute_src >= 0:
        return mod_path.substring(absolute_src + 1)
    val absolute_examples = _module_path_naming_text_index_of(mod_path, "/examples/")
    if absolute_examples >= 0:
        return mod_path.substring(absolute_examples + 1)
    mod_path

pub fn module_relative_name_from_path(path: text, relative_name: text) -> text:
    """Resolve a relative import's physical sibling before normalizing tiers.
    Empty means the caller has no source-file identity (or no relative tail).
    No filesystem lookup or import-visibility decision is performed here."""
    if not relative_name.starts_with("."):
        return ""
    val source_path = module_source_relative_path(path)
    if not source_path.ends_with(".spl"):
        return ""
    var dots = 0
    while dots < relative_name.len() and relative_name.char_at(dots) == ".":
        dots = dots + 1
    val tail = relative_name.substring(dots)
    if tail == "":
        return ""
    val parts = source_path.split("/")
    val keep = if parts.len() > dots: parts.len() - dots else: 0
    var target_parts: [text] = []
    var index = 0
    while index < keep:
        target_parts.push(parts[index])
        index = index + 1
    target_parts.push(tail.replace(".", "/") + ".spl")
    module_logical_name_from_path(target_parts.join("/"))

# Cycle-166 (2026-10-19): MIR profiling of the pathological first-batch
# modules put module_logical_name_from_path at ~14% of wall time -- it builds
# its result with PER-CHAR string concat (O(len^2) allocations per call) and
# MIR lowering re-derives the same module's name thousands of times per
# module. Pure function of its input, so memoize per process (the compiler
# phase is single-threaded; shard workers are separate processes).
var _module_logical_name_cache: {text: text} = {}

pub fn module_logical_name_from_path(path: text) -> text:
    if _module_logical_name_cache.has(path):
        return _module_logical_name_cache[path]
    val computed = _module_logical_name_from_path_uncached(path)
    _module_logical_name_cache[path] = computed
    computed

fn _module_logical_name_from_path_uncached(path: text) -> text:
    """Derive the dotted logical module name (e.g. `_wallB_mod_a`) from a
    source path (e.g. `src/_wallB_mod_a.spl`). Under `SIMPLE_BOOTSTRAP=1`,
    `HirModule.name`/`ParserModule.name` is the raw parsed PATH, not the
    logical name an `use module.{..}` import references -- keying an
    accumulator/symbol name by the raw path instead of this normalized form
    would mismatch the plain module text used at cross-module call sites and
    produce an unparseable `/`- and `.`-laden LLVM identifier (bug
    bootstrap_stage2_empty_mir_bodies_2026-07-05, Probe B). Explicitly
    resolved imports may arrive as absolute workspace paths; module identity
    is kept repo-relative so temporary/worktree directory names cannot leak
    host-path punctuation into native symbols."""
    var mod_path = module_source_relative_path(path)
    if mod_path.starts_with("src/"):
        mod_path = mod_path.substring(4)
    # Stage 2 native currently miscompiles deletion replacement and can turn
    # the entire path into "". These are suffixes, so slice them explicitly.
    if mod_path.ends_with(".spl"):
        mod_path = mod_path.substring(0, mod_path.len() - 4)
    elif mod_path.ends_with(".sdn"):
        mod_path = mod_path.substring(0, mod_path.len() - 4)
    mod_path = _module_path_naming_strip_numbered_dirs(mod_path)
    var portable = ""
    # WORKAROUND: `for ch in <text>` yields a corrupted loop element in the
    # seed interpreter and in pure-Simple-compiled native code, classifying
    # every char unkeepable -> all-underscore module names -> spurious
    # stage4 collision. Explicit char_code_at indexing decodes correctly
    # (see doc/08_tracking/bug/for_loop_over_text_char_code_at_zero_len_crash_2026-07-19.md).
    var _san_i = 0
    val _san_n = mod_path.len()
    while _san_i < _san_n:
        val _san_code = mod_path.char_code_at(_san_i)
        val keep = (_san_code >= 97 and _san_code <= 122) or (_san_code >= 65 and _san_code <= 90) or (_san_code >= 48 and _san_code <= 57) or _san_code == 95 or _san_code == 46 or _san_code == 47
        if keep:
            portable = portable + mod_path.char_at(_san_i)
        else:
            portable = portable + "_"
        _san_i = _san_i + 1
    mod_path = portable
    mod_path.replace("/", ".")
