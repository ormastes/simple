# Fixed-width, pointer-free mirror for generated typed bridges. Foreign
# pointers remain confined to the backend SFFI owner.
val BACKEND_PLUGIN_C_ABI_V1: i64 = 1
val BACKEND_PLUGIN_C_ROLE_INTERPRETER_JIT: i64 = 1
val BACKEND_PLUGIN_C_ROLE_COMPILER_AOT: i64 = 2
val BACKEND_PLUGIN_C_RESULT_MODULE: i64 = 1
val BACKEND_PLUGIN_C_RESULT_OBJECT: i64 = 2

struct BackendPluginWireRequestV1:
    role: i64
    backend_name: text
    target: text
    cpu: text
    features_wire: text
    optimization: text
    mir_abi_digest: text
    required_capabilities: i64

struct BackendPluginWireResultV1:
    result_kind: i64
    status: i64
    payload: [u8]

fn backend_plugin_wire_features_v1(features: [text]) -> text:
    var wire = ""
    for feature in features:
        wire = wire + feature.len().to_string() + ":" + feature
    wire

export BACKEND_PLUGIN_C_ABI_V1
export BACKEND_PLUGIN_C_ROLE_INTERPRETER_JIT, BACKEND_PLUGIN_C_ROLE_COMPILER_AOT
export BACKEND_PLUGIN_C_RESULT_MODULE, BACKEND_PLUGIN_C_RESULT_OBJECT
export BackendPluginWireRequestV1, BackendPluginWireResultV1
export backend_plugin_wire_features_v1
