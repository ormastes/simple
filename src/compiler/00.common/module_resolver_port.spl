# Canonical cross-layer module-resolution port. The loader owns discovery;
# driver and HIR consumers receive this immutable resolution context.

struct ModuleResolverPort:
    name: text
    aspect_roots: [text]
    fingerprint: text

fn module_resolver_port_empty() -> ModuleResolverPort:
    ModuleResolverPort(
        name: "empty",
        aspect_roots: [],
        fingerprint: ""
    )
