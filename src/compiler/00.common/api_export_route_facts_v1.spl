# Export-route observations are not an effective-public-API verdict.
use compiler.common.dependency.visibility.{Visibility}

enum ApiExportJoinV1:
    Unknown
    Joined

struct ApiExportRouteFactV1:
    exporter_index: i64
    exporter_path: text
    exporter_module: text
    export_name: text
    terminal_index: i64
    terminal_path: text
    terminal_module: text
    source_name: text
    local_symbol: i64
    declared_visibility: Visibility
    join_status: ApiExportJoinV1
    unknown_reason: text
    resolution_kind: text = ""

struct ApiExportRouteFactsV1:
    registry_generation: i64
    routes: [ApiExportRouteFactV1]
    unknown_reasons: [text]
    truncated: bool
    format_version: i64 = 1
