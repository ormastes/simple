# Borrowed storage for complete function/expression records. This establishes
# byte integrity and producer framing only; typed consumers retain stage/input
# authority and must decode/re-encode the complete actual generated record.
use compiler.common.cache_contract.hir_cache_envelope_reader_v1.{hir_cache_envelope_parse}
use std.common.crypto.sha256.{sha256_text}
use std.common.encoding.sha256_contract.{sha256_lower_hex_valid}
use std.common.encoding.utf8.{text_byte_len}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.nogc_sync_mut.io.file_ops.{file_read_regular_no_follow_bounded,
    secure_temp_dir_raw, file_publish_noreplace_raw}
use std.nogc_sync_mut.io.dir_ops.{dir_create_all, dir_remove}
use std.nogc_sync_mut.io_runtime.{file_write}

# A record is explicitly bounded; exceeding the bound is a refusal, never a
# placeholder or fallback to an unvalidated provider body. The envelope limit
# includes checksum, producer scope and key binding.
val HIR_OWNED_ARTIFACT_MAX_BYTES_V1: i64 = 8 * 1024 * 1024

struct HirOwnedArtifactContextV1:
    directory: text
    producer_header: text
    enabled: bool

fn hir_owned_artifact_header_v1(context: HirOwnedArtifactContextV1, key: text) -> text:
    context.producer_header + " owned-record-v1 " + key

fn hir_owned_artifact_path_v1(context: HirOwnedArtifactContextV1, key: text) -> text:
    context.directory + "/owned-records-v1/" + key + ".hir-record"

fn hir_owned_artifact_load_blob_v1(context: HirOwnedArtifactContextV1, key: text) -> Result<text, text>:
    if transient_array_scope_state_v1() != 1 or not context.enabled or
            context.directory == "" or context.producer_header == "" or
            not sha256_lower_hex_valid(key):
        return Err("owned artifact input or scope refused")
    val read = file_read_regular_no_follow_bounded(
        hir_owned_artifact_path_v1(context, key), HIR_OWNED_ARTIFACT_MAX_BYTES_V1)
    if read.is_err(): return Err("owned artifact read refused")
    val entry = hir_cache_envelope_parse(read.unwrap(), hir_owned_artifact_header_v1(context, key))
    if entry.reason != "" or entry.checksum != sha256_text(entry.covered) or entry.warnings.len() != 0 or entry.body == "":
        return Err("owned artifact envelope refused")
    Ok(entry.body)

fn hir_owned_artifact_store_blob_v1(context: HirOwnedArtifactContextV1, key: text, blob: text) -> Result<bool, text>:
    if transient_array_scope_state_v1() != 1 or not context.enabled or
            context.directory == "" or context.producer_header == "" or
            not sha256_lower_hex_valid(key) or blob == "":
        return Err("owned artifact input or scope refused")
    val covered = "W\n0\n" + blob
    val encoded = hir_owned_artifact_header_v1(context, key) + "\nC " + sha256_text(covered) + "\n" + covered
    if text_byte_len(encoded) > HIR_OWNED_ARTIFACT_MAX_BYTES_V1:
        return Err("owned artifact bound exceeded")
    val parent = context.directory + "/owned-records-v1"
    if not dir_create_all(parent): return Err("owned artifact directory refused")
    val staged_owner = secure_temp_dir_raw(parent, "hir-owned-record")
    if staged_owner == "": return Err("owned artifact staging refused")
    val staged = staged_owner + "/record"
    if not file_write(staged, encoded):
        dir_remove(staged_owner, true)
        return Err("owned artifact write refused")
    val staged_read = file_read_regular_no_follow_bounded(staged,
        HIR_OWNED_ARTIFACT_MAX_BYTES_V1)
    if staged_read.is_err():
        dir_remove(staged_owner, true)
        return Err("owned artifact staged read refused")
    if staged_read.unwrap() != encoded:
        dir_remove(staged_owner, true)
        return Err("owned artifact staged bytes refused")
    # No replacement: an existing immutable name must contain exactly these
    # bytes. A concurrent writer may win only with an identical record.
    val status = file_publish_noreplace_raw(staged, hir_owned_artifact_path_v1(context, key))
    dir_remove(staged_owner, true)
    if status != 0 and status != 1: return Err("owned artifact publication refused")
    val published = hir_owned_artifact_load_blob_v1(context, key)
    if published.is_err(): return Err("owned artifact published read refused")
    if published.unwrap() != blob: return Err("owned artifact immutable name mismatch")
    Ok(true)

export HirOwnedArtifactContextV1, HIR_OWNED_ARTIFACT_MAX_BYTES_V1
export hir_owned_artifact_store_blob_v1, hir_owned_artifact_load_blob_v1

# Caller prepays allocation_limit before entering. The returned conservative
# logical charge includes envelope temporaries retained by the current arena;
# it is not a measured native RSS or admission receipt.
fn hir_owned_artifact_load_blob_budgeted_v1(context: HirOwnedArtifactContextV1,
        key: text, allocation_limit: i64) -> Result<(text, i64), text>:
    if (transient_array_scope_state_v1() != 1 or not context.enabled or
            context.directory == "" or context.producer_header == "" or
            not sha256_lower_hex_valid(key)):
        return Err("owned artifact input or scope refused")
    # Prepay the bounded file provider's maximum read window before I/O.
    if allocation_limit < HIR_OWNED_ARTIFACT_MAX_BYTES_V1 * 2 + 16384:
        return Err("owned artifact read allocation bound")
    val read = file_read_regular_no_follow_bounded(
        hir_owned_artifact_path_v1(context, key), HIR_OWNED_ARTIFACT_MAX_BYTES_V1)
    if read.is_err(): return Err("owned artifact read refused")
    val raw = read.unwrap()
    val bytes = text_byte_len(raw)
    var lines: i64 = 1
    for character in raw:
        if character == "\n": lines = lines + 1
    # Envelope parsing splits/rejoins several views. Guard those allocations
    # before invoking the legacy envelope parser, not after its split.
    val charge = bytes * 8 + lines * 256 + 16384
    if charge > allocation_limit: return Err("owned artifact envelope allocation bound")
    val entry = hir_cache_envelope_parse(raw, hir_owned_artifact_header_v1(context, key))
    if (entry.reason != "" or entry.checksum != sha256_text(entry.covered) or
            entry.warnings.len() != 0 or entry.body == ""):
        return Err("owned artifact envelope refused")
    Ok((entry.body, charge))

export hir_owned_artifact_load_blob_budgeted_v1
