# Compile-local evidence records, not cache-admission capabilities. The actual
# parse/HIR owners establish source epoch, resolved ownership and completeness.
use compiler.common.cache_contract.directory_source_epoch_v2.{DirectorySourceEpochV2}
use compiler.common.cache_contract.directory_category_projection_v2.{DirectoryCategoryProjectionV2}
use compiler.common.cache_contract.generic_tldr_view_v1.{GenericTemplateSectionV1}

pub struct GenericBinderDraftV2:
    kind: text
    source_name: text
    index: i64
    # Relative generic scope: innermost=0, enclosing generic scope=1.
    scope_depth: i64

pub struct GenericDeclarationDraftV2:
    declaration_identity: text
    declaration_kind: text
    qualified_name: text
    binders: [GenericBinderDraftV2]
    parser_signature_digest: text
    # This is an interface+body parser draft, NOT the final pure-body facet.
    body_digest: text
    has_body: bool
    coverage_reason: text

pub struct GenericProjectionDraftV2:
    source_epoch: DirectorySourceEpochV2
    source: DirectoryCategoryProjectionV2
    module_identity: text
    declarations: [GenericDeclarationDraftV2]
    inventory_digest: text
    inventory_complete: bool
    coverage_reason: text

pub struct GenericCategoryProjectionV2:
    source_epoch: DirectorySourceEpochV2
    source: DirectoryCategoryProjectionV2
    module_identity: text
    inventory_digest: text
    # This existing carrier must pass generic_template_section_encode_v2,
    # including the V2 seal for an empty section. V1 empty is not equivalent.
    section: GenericTemplateSectionV1
    # Retained owner evidence; a caller-created true value grants no authority.
    inventory_complete: bool
