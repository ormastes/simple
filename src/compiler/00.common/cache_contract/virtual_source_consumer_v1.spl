# codex-impl: one transport-neutral virtual-source seam for compiler and tools.

use compiler.common.cache_contract.errors_v1 (SummaryErrorV1)
use compiler.common.cache_contract.virtual_source_store_v1.*

pub enum VirtualSourceConsumerKindV1:
    CompilerCli
    Mcp
    SimpleLspMcp
    SPipe

# The consumer label is observability-only.  It is deliberately not authority:
# every store call receives the original authenticated request unchanged.
pub struct VirtualSourceConsumerContextV1:
    consumer: VirtualSourceConsumerKindV1
    auth: SummaryAuthV1
    snapshot: text

pub class VirtualSourceConsumerAdapterV1:
    store: VirtualSourceStoreV1
    context: VirtualSourceConsumerContextV1

    static fn injected(store: VirtualSourceStoreV1, context: VirtualSourceConsumerContextV1) -> VirtualSourceConsumerAdapterV1:
        VirtualSourceConsumerAdapterV1(store: store, context: context)

    fn list(logical_directory: text, max_entries: i64, continuation: text?) -> Result<VirtualSourceListPageV1, SummaryErrorV1>:
        self.store.list(self.context.auth, self.context.snapshot, logical_directory, max_entries, continuation)

    fn stat(virtual_uri: text) -> Result<SummaryLookupV1<VirtualSourceStatV1>, SummaryErrorV1>:
        self.store.stat(self.context.auth, self.context.snapshot, virtual_uri)

    fn read(virtual_uri: text, offset: i64, max_bytes: i64) -> Result<SummaryLookupV1<VirtualSourceReadV1>, SummaryErrorV1>:
        self.store.read(self.context.auth, self.context.snapshot, virtual_uri, offset, max_bytes)

    fn page(virtual_uri: text, continuation: text?, max_bytes: i64, max_entries: i64) -> Result<SummaryLookupV1<SummaryPageV1>, SummaryErrorV1>:
        self.store.page(self.context.auth, self.context.snapshot, virtual_uri, continuation, max_bytes, max_entries)

pub fn compiler_cli_virtual_source_v1(store: VirtualSourceStoreV1, auth: SummaryAuthV1, snapshot: text) -> VirtualSourceConsumerAdapterV1:
    VirtualSourceConsumerAdapterV1.injected(store, VirtualSourceConsumerContextV1(
        consumer: VirtualSourceConsumerKindV1.CompilerCli, auth: auth, snapshot: snapshot))

pub fn mcp_virtual_source_v1(store: VirtualSourceStoreV1, auth: SummaryAuthV1, snapshot: text) -> VirtualSourceConsumerAdapterV1:
    VirtualSourceConsumerAdapterV1.injected(store, VirtualSourceConsumerContextV1(
        consumer: VirtualSourceConsumerKindV1.Mcp, auth: auth, snapshot: snapshot))

pub fn simple_lsp_mcp_virtual_source_v1(store: VirtualSourceStoreV1, auth: SummaryAuthV1, snapshot: text) -> VirtualSourceConsumerAdapterV1:
    VirtualSourceConsumerAdapterV1.injected(store, VirtualSourceConsumerContextV1(
        consumer: VirtualSourceConsumerKindV1.SimpleLspMcp, auth: auth, snapshot: snapshot))

pub fn spipe_virtual_source_v1(store: VirtualSourceStoreV1, auth: SummaryAuthV1, snapshot: text) -> VirtualSourceConsumerAdapterV1:
    VirtualSourceConsumerAdapterV1.injected(store, VirtualSourceConsumerContextV1(
        consumer: VirtualSourceConsumerKindV1.SPipe, auth: auth, snapshot: snapshot))
