# Compile-local correlation only. This does not authenticate source bytes,
# conditional decisions, compiler identity, or a persisted directory record.
pub struct DirectorySourceEpochV2:
    driver_identity: i64
    generation: i64

pub fn directory_source_epoch_valid_v2(value: DirectorySourceEpochV2) -> bool:
    value.driver_identity > 0 and value.generation > 0

pub fn directory_source_epoch_equal_v2(a: DirectorySourceEpochV2, b: DirectorySourceEpochV2) -> bool:
    directory_source_epoch_valid_v2(a) and directory_source_epoch_valid_v2(b) and
        a.driver_identity == b.driver_identity and a.generation == b.generation

pub fn directory_source_epoch_advance_v2(driver_identity: i64,
        previous_generation: i64) -> Result<DirectorySourceEpochV2, text>:
    if driver_identity <= 0: return Err("directory-source-owner-unavailable")
    if previous_generation < 0 or previous_generation == 9223372036854775807:
        return Err("directory-source-generation-exhausted")
    Ok(DirectorySourceEpochV2(driver_identity: driver_identity,
        generation: previous_generation + 1))
