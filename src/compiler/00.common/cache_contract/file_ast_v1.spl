# codex-impl: immutable, pointer-free frontend cache contract.

pub struct FileAstNodeV1:
    kind: i64
    flags: i64
    source_start: i64
    source_end: i64
    first_child: i64
    child_count: i64
    payload_index: i64

pub struct FileAstV1:
    source_blob_digest: text
    grammar_digest: text
    compiler_owner_digest: text
    string_table: [text]
    nodes: [FileAstNodeV1]
    payload_tables: [text]
    root_node: i64
    public_summary_digest: text
    semantic_read_set_digest: text
