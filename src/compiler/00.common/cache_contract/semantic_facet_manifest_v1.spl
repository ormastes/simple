# Canonical diagnostic DTO/diff schema for future semantic reuse and RR routing.
# Digest shape and an explicit coverage field do not authenticate a source or
# candidate universe. No cache consumer may treat this module as authority.

use std.common.crypto.sha256.{sha256_text}
use std.common.encoding.sha256_contract.{sha256_lower_hex_valid}

val SEMANTIC_FACET_TEXT_MAX_BYTES_V1: i64 = 4096
val SEMANTIC_FACET_MAX_ITEMS_V1: i64 = 65536

pub struct SemanticCallableFacetV1:
    stable_entity_id: text
    callable_signature_digest: text
    effect_digest: text

pub struct SemanticFieldLayoutFacetV1:
    stable_type_id: text
    ordered_fields_digest: text
    layout_digest: text

pub struct SemanticAspectFacetV1:
    stable_aspect_id: text
    call_signature_digest: text
    advice_body_digest: text
    candidate_set_digest: text
    absence_witness_digest: text

pub struct SemanticMacroFacetV1:
    stable_macro_id: text
    call_signature_digest: text
    macro_body_digest: text
    expansion_input_digest: text

pub struct SemanticTraitFacetV1:
    stable_trait_id: text
    call_signature_digest: text
    candidate_set_digest: text
    absence_witness_digest: text

pub struct SemanticFacetManifestV1:
    schema: i64
    producer_id: text
    semantic_profile_digest: text
    callable_coverage_digest: text
    field_layout_coverage_digest: text
    aspect_coverage_digest: text
    macro_coverage_digest: text
    trait_coverage_digest: text
    callable_facets: [SemanticCallableFacetV1]
    field_layout_facets: [SemanticFieldLayoutFacetV1]
    aspect_facets: [SemanticAspectFacetV1]
    macro_facets: [SemanticMacroFacetV1]
    trait_facets: [SemanticTraitFacetV1]

fn _facet_text_valid_v1(value: text) -> bool:
    value != "" and value.bytes().len() <= SEMANTIC_FACET_TEXT_MAX_BYTES_V1 and
        not value.contains("\u0000") and not value.contains("\n") and
        not value.contains("\r")

fn _facet_digest_valid_v1(value: text) -> bool:
    sha256_lower_hex_valid(value)

fn _facet_frame_v1(label: text, value: text) -> text:
    label.bytes().len().to_string() + ":" + label +
        value.bytes().len().to_string() + ":" + value

fn _facet_count_valid_v1(count: i64) -> bool:
    count >= 0 and count <= SEMANTIC_FACET_MAX_ITEMS_V1

fn _callable_valid_v1(value: SemanticCallableFacetV1) -> bool:
    _facet_text_valid_v1(value.stable_entity_id) and
        _facet_digest_valid_v1(value.callable_signature_digest) and
        _facet_digest_valid_v1(value.effect_digest)

fn _field_valid_v1(value: SemanticFieldLayoutFacetV1) -> bool:
    _facet_text_valid_v1(value.stable_type_id) and
        _facet_digest_valid_v1(value.ordered_fields_digest) and
        _facet_digest_valid_v1(value.layout_digest)

fn _aspect_valid_v1(value: SemanticAspectFacetV1) -> bool:
    _facet_text_valid_v1(value.stable_aspect_id) and
        _facet_digest_valid_v1(value.call_signature_digest) and
        _facet_digest_valid_v1(value.advice_body_digest) and
        _facet_digest_valid_v1(value.candidate_set_digest) and
        _facet_digest_valid_v1(value.absence_witness_digest)

fn _macro_valid_v1(value: SemanticMacroFacetV1) -> bool:
    _facet_text_valid_v1(value.stable_macro_id) and
        _facet_digest_valid_v1(value.call_signature_digest) and
        _facet_digest_valid_v1(value.macro_body_digest) and
        _facet_digest_valid_v1(value.expansion_input_digest)

fn _trait_valid_v1(value: SemanticTraitFacetV1) -> bool:
    _facet_text_valid_v1(value.stable_trait_id) and
        _facet_digest_valid_v1(value.call_signature_digest) and
        _facet_digest_valid_v1(value.candidate_set_digest) and
        _facet_digest_valid_v1(value.absence_witness_digest)

pub fn semantic_facet_manifest_valid_v1(value: SemanticFacetManifestV1) -> bool:
    if (value.schema != 1 or not _facet_text_valid_v1(value.producer_id) or
            not _facet_digest_valid_v1(value.semantic_profile_digest) or
            not _facet_digest_valid_v1(value.callable_coverage_digest) or
            not _facet_digest_valid_v1(value.field_layout_coverage_digest) or
            not _facet_digest_valid_v1(value.aspect_coverage_digest) or
            not _facet_digest_valid_v1(value.macro_coverage_digest) or
            not _facet_digest_valid_v1(value.trait_coverage_digest) or
            not _facet_count_valid_v1(value.callable_facets.len()) or
            not _facet_count_valid_v1(value.field_layout_facets.len()) or
            not _facet_count_valid_v1(value.aspect_facets.len()) or
            not _facet_count_valid_v1(value.macro_facets.len()) or
            not _facet_count_valid_v1(value.trait_facets.len())):
        return false
    var prior = ""
    for facet in value.callable_facets:
        if (not _callable_valid_v1(facet) or
                (prior != "" and facet.stable_entity_id <= prior)): return false
        prior = facet.stable_entity_id
    prior = ""
    for facet in value.field_layout_facets:
        if (not _field_valid_v1(facet) or
                (prior != "" and facet.stable_type_id <= prior)): return false
        prior = facet.stable_type_id
    prior = ""
    for facet in value.aspect_facets:
        if (not _aspect_valid_v1(facet) or
                (prior != "" and facet.stable_aspect_id <= prior)): return false
        prior = facet.stable_aspect_id
    prior = ""
    for facet in value.macro_facets:
        if (not _macro_valid_v1(facet) or
                (prior != "" and facet.stable_macro_id <= prior)): return false
        prior = facet.stable_macro_id
    prior = ""
    for facet in value.trait_facets:
        if (not _trait_valid_v1(facet) or
                (prior != "" and facet.stable_trait_id <= prior)): return false
        prior = facet.stable_trait_id
    true

pub fn semantic_facet_manifest_encode_v1(value: SemanticFacetManifestV1) -> text:
    if not semantic_facet_manifest_valid_v1(value): return ""
    var encoded = _facet_frame_v1("schema", value.schema.to_string()) +
        _facet_frame_v1("producer", value.producer_id) +
        _facet_frame_v1("profile", value.semantic_profile_digest) +
        _facet_frame_v1("callable_coverage", value.callable_coverage_digest) +
        _facet_frame_v1("field_coverage", value.field_layout_coverage_digest) +
        _facet_frame_v1("aspect_coverage", value.aspect_coverage_digest) +
        _facet_frame_v1("macro_coverage", value.macro_coverage_digest) +
        _facet_frame_v1("trait_coverage", value.trait_coverage_digest)
    for facet in value.callable_facets:
        encoded = encoded + _facet_frame_v1("callable_id", facet.stable_entity_id) +
            _facet_frame_v1("callable_signature", facet.callable_signature_digest) +
            _facet_frame_v1("callable_effect", facet.effect_digest)
    for facet in value.field_layout_facets:
        encoded = encoded + _facet_frame_v1("field_type", facet.stable_type_id) +
            _facet_frame_v1("ordered_fields", facet.ordered_fields_digest) +
            _facet_frame_v1("field_layout", facet.layout_digest)
    for facet in value.aspect_facets:
        encoded = encoded + _facet_frame_v1("aspect_id", facet.stable_aspect_id) +
            _facet_frame_v1("aspect_signature", facet.call_signature_digest) +
            _facet_frame_v1("advice_body", facet.advice_body_digest) +
            _facet_frame_v1("aspect_candidates", facet.candidate_set_digest) +
            _facet_frame_v1("aspect_absence", facet.absence_witness_digest)
    for facet in value.macro_facets:
        encoded = encoded + _facet_frame_v1("macro_id", facet.stable_macro_id) +
            _facet_frame_v1("macro_signature", facet.call_signature_digest) +
            _facet_frame_v1("macro_body", facet.macro_body_digest) +
            _facet_frame_v1("macro_input", facet.expansion_input_digest)
    for facet in value.trait_facets:
        encoded = encoded + _facet_frame_v1("trait_id", facet.stable_trait_id) +
            _facet_frame_v1("trait_signature", facet.call_signature_digest) +
            _facet_frame_v1("trait_candidates", facet.candidate_set_digest) +
            _facet_frame_v1("trait_absence", facet.absence_witness_digest)
    encoded

pub fn semantic_facet_manifest_digest_v1(value: SemanticFacetManifestV1) -> text:
    val encoded = semantic_facet_manifest_encode_v1(value)
    if encoded == "": return ""
    sha256_text(encoded)

pub struct SemanticFacetChangeV1:
    producer_kind: text
    stable_entity_id: text
    facet: text
    old_fingerprint: text?
    new_fingerprint: text?

fn _append_facet_change_v1(changes: [SemanticFacetChangeV1], kind: text,
        entity: text, facet: text, old_value: text?, new_value: text?
    ) -> [SemanticFacetChangeV1]:
    if old_value == new_value: return changes
    var out = changes
    out.push(SemanticFacetChangeV1(producer_kind: kind,
        stable_entity_id: entity, facet: facet,
        old_fingerprint: old_value, new_fingerprint: new_value))
    out

fn _callable_changes_v1(old: [SemanticCallableFacetV1],
        new: [SemanticCallableFacetV1], changes: [SemanticFacetChangeV1]
    ) -> [SemanticFacetChangeV1]:
    var out = changes
    var left: i64 = 0
    var right: i64 = 0
    while left < old.len() or right < new.len():
        if (right >= new.len() or (left < old.len() and
                old[left].stable_entity_id < new[right].stable_entity_id)):
            out = _append_facet_change_v1(out, "callable", old[left].stable_entity_id,
                "callable_signature", Some(old[left].callable_signature_digest), nil)
            out = _append_facet_change_v1(out, "callable", old[left].stable_entity_id,
                "callable_effect", Some(old[left].effect_digest), nil)
            left = left + 1
        elif left >= old.len() or new[right].stable_entity_id < old[left].stable_entity_id:
            out = _append_facet_change_v1(out, "callable", new[right].stable_entity_id,
                "callable_signature", nil, Some(new[right].callable_signature_digest))
            out = _append_facet_change_v1(out, "callable", new[right].stable_entity_id,
                "callable_effect", nil, Some(new[right].effect_digest))
            right = right + 1
        else:
            out = _append_facet_change_v1(out, "callable", old[left].stable_entity_id,
                "callable_signature", Some(old[left].callable_signature_digest),
                Some(new[right].callable_signature_digest))
            out = _append_facet_change_v1(out, "callable", old[left].stable_entity_id,
                "callable_effect", Some(old[left].effect_digest),
                Some(new[right].effect_digest))
            left = left + 1
            right = right + 1
    out

fn _field_changes_v1(old: [SemanticFieldLayoutFacetV1],
        new: [SemanticFieldLayoutFacetV1], changes: [SemanticFacetChangeV1]
    ) -> [SemanticFacetChangeV1]:
    var out = changes
    var left: i64 = 0
    var right: i64 = 0
    while left < old.len() or right < new.len():
        if (right >= new.len() or (left < old.len() and
                old[left].stable_type_id < new[right].stable_type_id)):
            out = _append_facet_change_v1(out, "type", old[left].stable_type_id,
                "ordered_fields", Some(old[left].ordered_fields_digest), nil)
            out = _append_facet_change_v1(out, "type", old[left].stable_type_id,
                "field_layout", Some(old[left].layout_digest), nil)
            left = left + 1
        elif left >= old.len() or new[right].stable_type_id < old[left].stable_type_id:
            out = _append_facet_change_v1(out, "type", new[right].stable_type_id,
                "ordered_fields", nil, Some(new[right].ordered_fields_digest))
            out = _append_facet_change_v1(out, "type", new[right].stable_type_id,
                "field_layout", nil, Some(new[right].layout_digest))
            right = right + 1
        else:
            out = _append_facet_change_v1(out, "type", old[left].stable_type_id,
                "ordered_fields", Some(old[left].ordered_fields_digest),
                Some(new[right].ordered_fields_digest))
            out = _append_facet_change_v1(out, "type", old[left].stable_type_id,
                "field_layout", Some(old[left].layout_digest),
                Some(new[right].layout_digest))
            left = left + 1
            right = right + 1
    out

fn _aspect_changes_v1(old: [SemanticAspectFacetV1], new: [SemanticAspectFacetV1],
        changes: [SemanticFacetChangeV1]) -> [SemanticFacetChangeV1]:
    var out = changes
    var left: i64 = 0
    var right: i64 = 0
    while left < old.len() or right < new.len():
        if (right >= new.len() or (left < old.len() and
                old[left].stable_aspect_id < new[right].stable_aspect_id)):
            val value = old[left]
            out = _append_facet_change_v1(out, "aspect", value.stable_aspect_id,
                "aspect_call_signature", Some(value.call_signature_digest), nil)
            out = _append_facet_change_v1(out, "aspect", value.stable_aspect_id,
                "aspect_advice_body", Some(value.advice_body_digest), nil)
            out = _append_facet_change_v1(out, "aspect", value.stable_aspect_id,
                "aspect_candidate_set", Some(value.candidate_set_digest), nil)
            out = _append_facet_change_v1(out, "aspect", value.stable_aspect_id,
                "aspect_absence_witness", Some(value.absence_witness_digest), nil)
            left = left + 1
        elif left >= old.len() or new[right].stable_aspect_id < old[left].stable_aspect_id:
            val value = new[right]
            out = _append_facet_change_v1(out, "aspect", value.stable_aspect_id,
                "aspect_call_signature", nil, Some(value.call_signature_digest))
            out = _append_facet_change_v1(out, "aspect", value.stable_aspect_id,
                "aspect_advice_body", nil, Some(value.advice_body_digest))
            out = _append_facet_change_v1(out, "aspect", value.stable_aspect_id,
                "aspect_candidate_set", nil, Some(value.candidate_set_digest))
            out = _append_facet_change_v1(out, "aspect", value.stable_aspect_id,
                "aspect_absence_witness", nil, Some(value.absence_witness_digest))
            right = right + 1
        else:
            val a = old[left]
            val b = new[right]
            out = _append_facet_change_v1(out, "aspect", a.stable_aspect_id,
                "aspect_call_signature", Some(a.call_signature_digest),
                Some(b.call_signature_digest))
            out = _append_facet_change_v1(out, "aspect", a.stable_aspect_id,
                "aspect_advice_body", Some(a.advice_body_digest), Some(b.advice_body_digest))
            out = _append_facet_change_v1(out, "aspect", a.stable_aspect_id,
                "aspect_candidate_set", Some(a.candidate_set_digest), Some(b.candidate_set_digest))
            out = _append_facet_change_v1(out, "aspect", a.stable_aspect_id,
                "aspect_absence_witness", Some(a.absence_witness_digest),
                Some(b.absence_witness_digest))
            left = left + 1
            right = right + 1
    out

fn _macro_changes_v1(old: [SemanticMacroFacetV1], new: [SemanticMacroFacetV1],
        changes: [SemanticFacetChangeV1]) -> [SemanticFacetChangeV1]:
    var out = changes
    var left: i64 = 0
    var right: i64 = 0
    while left < old.len() or right < new.len():
        if (right >= new.len() or (left < old.len() and
                old[left].stable_macro_id < new[right].stable_macro_id)):
            val value = old[left]
            out = _append_facet_change_v1(out, "macro", value.stable_macro_id,
                "macro_call_signature", Some(value.call_signature_digest), nil)
            out = _append_facet_change_v1(out, "macro", value.stable_macro_id,
                "macro_body", Some(value.macro_body_digest), nil)
            out = _append_facet_change_v1(out, "macro", value.stable_macro_id,
                "macro_expansion_input", Some(value.expansion_input_digest), nil)
            left = left + 1
        elif left >= old.len() or new[right].stable_macro_id < old[left].stable_macro_id:
            val value = new[right]
            out = _append_facet_change_v1(out, "macro", value.stable_macro_id,
                "macro_call_signature", nil, Some(value.call_signature_digest))
            out = _append_facet_change_v1(out, "macro", value.stable_macro_id,
                "macro_body", nil, Some(value.macro_body_digest))
            out = _append_facet_change_v1(out, "macro", value.stable_macro_id,
                "macro_expansion_input", nil, Some(value.expansion_input_digest))
            right = right + 1
        else:
            val a = old[left]
            val b = new[right]
            out = _append_facet_change_v1(out, "macro", a.stable_macro_id,
                "macro_call_signature", Some(a.call_signature_digest),
                Some(b.call_signature_digest))
            out = _append_facet_change_v1(out, "macro", a.stable_macro_id,
                "macro_body", Some(a.macro_body_digest), Some(b.macro_body_digest))
            out = _append_facet_change_v1(out, "macro", a.stable_macro_id,
                "macro_expansion_input", Some(a.expansion_input_digest),
                Some(b.expansion_input_digest))
            left = left + 1
            right = right + 1
    out

fn _trait_changes_v1(old: [SemanticTraitFacetV1], new: [SemanticTraitFacetV1],
        changes: [SemanticFacetChangeV1]) -> [SemanticFacetChangeV1]:
    var out = changes
    var left: i64 = 0
    var right: i64 = 0
    while left < old.len() or right < new.len():
        if (right >= new.len() or (left < old.len() and
                old[left].stable_trait_id < new[right].stable_trait_id)):
            val value = old[left]
            out = _append_facet_change_v1(out, "trait", value.stable_trait_id,
                "trait_call_signature", Some(value.call_signature_digest), nil)
            out = _append_facet_change_v1(out, "trait", value.stable_trait_id,
                "trait_candidate_set", Some(value.candidate_set_digest), nil)
            out = _append_facet_change_v1(out, "trait", value.stable_trait_id,
                "trait_absence_witness", Some(value.absence_witness_digest), nil)
            left = left + 1
        elif left >= old.len() or new[right].stable_trait_id < old[left].stable_trait_id:
            val value = new[right]
            out = _append_facet_change_v1(out, "trait", value.stable_trait_id,
                "trait_call_signature", nil, Some(value.call_signature_digest))
            out = _append_facet_change_v1(out, "trait", value.stable_trait_id,
                "trait_candidate_set", nil, Some(value.candidate_set_digest))
            out = _append_facet_change_v1(out, "trait", value.stable_trait_id,
                "trait_absence_witness", nil, Some(value.absence_witness_digest))
            right = right + 1
        else:
            val a = old[left]
            val b = new[right]
            out = _append_facet_change_v1(out, "trait", a.stable_trait_id,
                "trait_call_signature", Some(a.call_signature_digest),
                Some(b.call_signature_digest))
            out = _append_facet_change_v1(out, "trait", a.stable_trait_id,
                "trait_candidate_set", Some(a.candidate_set_digest),
                Some(b.candidate_set_digest))
            out = _append_facet_change_v1(out, "trait", a.stable_trait_id,
                "trait_absence_witness", Some(a.absence_witness_digest),
                Some(b.absence_witness_digest))
            left = left + 1
            right = right + 1
    out

pub fn semantic_facet_changes_v1(old: SemanticFacetManifestV1,
        new: SemanticFacetManifestV1) -> Result<[SemanticFacetChangeV1], text>:
    if (not semantic_facet_manifest_valid_v1(old) or
            not semantic_facet_manifest_valid_v1(new) or
            old.producer_id != new.producer_id or
            old.semantic_profile_digest != new.semantic_profile_digest):
        return Err("semantic facet manifests are not comparable")
    var changes: [SemanticFacetChangeV1] = []
    changes = _append_facet_change_v1(changes, "module", old.producer_id,
        "callable_coverage", Some(old.callable_coverage_digest),
        Some(new.callable_coverage_digest))
    changes = _append_facet_change_v1(changes, "module", old.producer_id,
        "field_layout_coverage", Some(old.field_layout_coverage_digest),
        Some(new.field_layout_coverage_digest))
    changes = _append_facet_change_v1(changes, "module", old.producer_id,
        "aspect_coverage", Some(old.aspect_coverage_digest),
        Some(new.aspect_coverage_digest))
    changes = _append_facet_change_v1(changes, "module", old.producer_id,
        "macro_coverage", Some(old.macro_coverage_digest),
        Some(new.macro_coverage_digest))
    changes = _append_facet_change_v1(changes, "module", old.producer_id,
        "trait_coverage", Some(old.trait_coverage_digest),
        Some(new.trait_coverage_digest))
    changes = _callable_changes_v1(old.callable_facets, new.callable_facets, changes)
    changes = _field_changes_v1(old.field_layout_facets, new.field_layout_facets, changes)
    changes = _aspect_changes_v1(old.aspect_facets, new.aspect_facets, changes)
    changes = _macro_changes_v1(old.macro_facets, new.macro_facets, changes)
    changes = _trait_changes_v1(old.trait_facets, new.trait_facets, changes)
    Ok(changes)
