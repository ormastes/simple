# Historical lowering plan, not final-body or linked-artifact authority.
# A missing plan is unavailable; an explicit empty plan proves the actual
# initializer lowering owner ran and selected no runtime initializers.
pub struct MirInitializerStepV1:
    symbol_id: i64
    name: text

pub struct MirInitializerPlanV1:
    module_identity: text
    bootstrap_module_index: i64
    ordered_steps: [MirInitializerStepV1]
    emitted_init_symbol: text
