use compiler.common.cache_contract.native_initializer_result_v2.{NativeInitializerStartupV2}
use compiler.common.cache_contract.directory_category_projection_v2.{DirectoryCategoryProjectionV2}
# Historical lowering plan, not final-body or linked-artifact authority.
# A missing plan is unavailable; an explicit empty plan proves the actual
# initializer lowering owner ran and selected no runtime initializers.
pub struct MirInitializerStepV1:
    symbol_id: i64
    name: text

pub struct MirInitializerPlanV1:
    module_identity: text
    bootstrap_module_index: i64
    ordered_steps: [MirInitializerStepV1]
    emitted_init_symbol: text


# Observed final initializer bodies only. Object/output joining is still required.
pub struct MirInitializerBodyReceiptV1:
    plan: MirInitializerPlanV1
    initializer_body_digest: text
    wrapper_body_digest: text

# Compile-local observation joined to a verified produced object. This remains
# partial: final startup order/output and full directory coverage are separate.
pub struct MirInitializerObjectReceiptV1:
    module_identity: text
    source_path: text
    source_digest: text
    target_triple: text
    environment_policy_digest: text
    executing_image_digest: text
    capsule_identity_digest: text
    object_path: text
    object_digest: text
    object_size: i64
    category: DirectoryCategoryProjectionV2
    bodies: MirInitializerBodyReceiptV1

# Complete only for this selected current-build object list. Other PackageInit
# category roots and directory membership must still be joined separately.
pub struct MirInitializerBuildReceiptV1:
    ordered_objects: [MirInitializerObjectReceiptV1]
    startup: NativeInitializerStartupV2
    output_path: text
    output_digest: text
    executing_image_digest: text
    target_triple: text
    environment_policy_digest: text
