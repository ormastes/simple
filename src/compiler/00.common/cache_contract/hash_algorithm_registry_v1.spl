# Hash algorithm registry + algorithm-tagged digests (hash agility).
#
# Design: doc/05_design/compiler/incremental_build/packed_binary_ast_v1.md §8.
# Every persisted digest is (algorithm, bytes) -- never a bare fixed-width
# field. Text form `<name>:<lowercase hex>`; binary form (algo_id u16,
# length u16, bytes) for packed containers.
#
# Rules enforced here:
# - An UNKNOWN algorithm (id or name) makes that digest ABSENT, never a match.
# - Two digests match only when the algorithm is the same, known, and the
#   bytes are equal; a different algorithm is not comparable.
# - Cross-host / shared identity needs a collision-resistant algorithm; fast
#   fingerprints are local indexes that must be verified by a collision-
#   resistant digest before a hit is trusted.
# - Truncated ids (id scopes, 8-byte section checksums) are derived values,
#   not algorithms, and are not in this registry.
# Ids >= 0x8000 are private/experimental and never leave a host.

pub val HASH_ALGO_NONE_V1: i64 = 0
pub val HASH_ALGO_SHA256_V1: i64 = 1
pub val HASH_ALGO_BLAKE3_V1: i64 = 2
pub val HASH_ALGO_SHA3_256_V1: i64 = 3
pub val HASH_ALGO_XXH3_128_V1: i64 = 16
pub val HASH_ALGO_XXH3_64_V1: i64 = 17
pub val HASH_ALGO_CRC32_V1: i64 = 18

struct HashAlgorithmV1:
    id: i64
    name: text
    output_bytes: i64
    collision_resistant: bool

struct DigestV1:
    algo_id: i64
    hex: text

pub fn hash_algorithm_registry_v1() -> [HashAlgorithmV1]:
    [
        HashAlgorithmV1(id: HASH_ALGO_SHA256_V1, name: "sha256", output_bytes: 32, collision_resistant: true),
        HashAlgorithmV1(id: HASH_ALGO_BLAKE3_V1, name: "blake3", output_bytes: 32, collision_resistant: true),
        HashAlgorithmV1(id: HASH_ALGO_SHA3_256_V1, name: "sha3-256", output_bytes: 32, collision_resistant: true),
        HashAlgorithmV1(id: HASH_ALGO_XXH3_128_V1, name: "xxh3-128", output_bytes: 16, collision_resistant: false),
        HashAlgorithmV1(id: HASH_ALGO_XXH3_64_V1, name: "xxh3-64", output_bytes: 8, collision_resistant: false),
        HashAlgorithmV1(id: HASH_ALGO_CRC32_V1, name: "crc32", output_bytes: 4, collision_resistant: false),
    ]

pub fn hash_algorithm_by_id_v1(id: i64) -> HashAlgorithmV1?:
    for algo in hash_algorithm_registry_v1():
        if algo.id == id:
            return Some(algo)
    nil

pub fn hash_algorithm_by_name_v1(name: text) -> HashAlgorithmV1?:
    for algo in hash_algorithm_registry_v1():
        if algo.name == name:
            return Some(algo)
    nil

fn _hex_ok_v1(hex: text, bytes: i64) -> bool:
    if hex.len() != bytes * 2:
        return false
    var i = 0
    while i < hex.len():
        val c = hex.char_code_at(i)
        val digit = c >= 48 and c <= 57
        val lower = c >= 97 and c <= 102
        if not digit and not lower:
            return false
        i = i + 1
    true

# A digest of a KNOWN algorithm with well-formed bytes, else nil (absent).
pub fn digest_v1_new(algo_id: i64, hex: text) -> DigestV1?:
    match hash_algorithm_by_id_v1(algo_id):
        case Some(algo):
            if _hex_ok_v1(hex, algo.output_bytes):
                return Some(DigestV1(algo_id: algo_id, hex: hex))
            nil
        case nil: nil

pub fn digest_v1_text(digest: DigestV1) -> text:
    match hash_algorithm_by_id_v1(digest.algo_id):
        case Some(algo): algo.name + ":" + digest.hex
        case nil: ""

# Parse `<name>:<hex>`; unknown name or malformed bytes => nil (absent).
pub fn digest_v1_parse(value: text) -> DigestV1?:
    val colon = value.index_of(":")
    if colon <= 0:
        return nil
    match hash_algorithm_by_name_v1(value.substring(0, colon)):
        case Some(algo): digest_v1_new(algo.id, value.substring(colon + 1))
        case nil: nil

pub fn digest_v1_equal(a: DigestV1, b: DigestV1) -> bool:
    a.algo_id == b.algo_id and a.hex == b.hex and hash_algorithm_by_id_v1(a.algo_id) != nil

# The ONE central gate: may a match of this algorithm be the sole proof of
# identity for a persistent-cache read or an imported/untrusted artifact?
# True only for a KNOWN collision-resistant algorithm (xxh3/crc32 and unknown
# ids are local indexes; they must be confirmed by an admitted digest or an
# exact byte comparison of the key material).
pub fn digest_admits_identity_v1(algo_id: i64) -> bool:
    match hash_algorithm_by_id_v1(algo_id):
        case Some(algo): algo.collision_resistant
        case nil: false

pub fn digest_v1_identity_ok(digest: DigestV1) -> bool:
    digest_admits_identity_v1(digest.algo_id)

pub val DIGEST_SET_MATCH_V1: i64 = 1
pub val DIGEST_SET_MISMATCH_V1: i64 = 0
pub val DIGEST_SET_NO_COMMON_V1: i64 = -1

# Negotiated comparison of two digest sets (1..3 algorithms each). Uses the
# first algorithm both sides know, preferring collision-resistant ones; when
# `need_identity` only collision-resistant algorithms are considered.
# NO_COMMON (=> treat as a miss) when no usable algorithm is shared.
pub fn digest_set_match_v1(have: [DigestV1], want: [DigestV1], need_identity: bool) -> i64:
    for pass_identity in [true, false]:
        if not pass_identity and need_identity:
            continue
        for w in want:
            if digest_v1_identity_ok(w) != pass_identity:
                continue
            for h in have:
                if h.algo_id == w.algo_id and hash_algorithm_by_id_v1(h.algo_id) != nil:
                    return if h.hex == w.hex: DIGEST_SET_MATCH_V1 else: DIGEST_SET_MISMATCH_V1
    DIGEST_SET_NO_COMMON_V1

# Binary form: algo_id (u16 LE), length (u16 LE), raw bytes.
pub fn digest_v1_encode_bytes(digest: DigestV1) -> [u8]:
    var out: [u8] = []
    out.push((digest.algo_id % 256) as u8)
    out.push((digest.algo_id / 256) as u8)
    val length = digest.hex.len() / 2
    out.push((length % 256) as u8)
    out.push((length / 256) as u8)
    var i = 0
    while i < digest.hex.len():
        out.push(((_nibble_v1(digest.hex.char_code_at(i)) * 16) + _nibble_v1(digest.hex.char_code_at(i + 1))) as u8)
        i = i + 2
    out

fn _nibble_v1(code: i64) -> i64:
    if code >= 97: code - 87 else: code - 48

val _HEX_DIGITS_V1: text = "0123456789abcdef"

# Decode at `offset`; nil for an unknown algorithm, a length that disagrees
# with the registry, or a truncated buffer.
pub fn digest_v1_decode_bytes(data: [u8], offset: i64) -> DigestV1?:
    if offset < 0 or offset + 4 > data.len():
        return nil
    val algo_id = (data[offset] as i64) + (data[offset + 1] as i64) * 256
    val length = (data[offset + 2] as i64) + (data[offset + 3] as i64) * 256
    if offset + 4 + length > data.len():
        return nil
    var hex = ""
    var i = 0
    while i < length:
        val b = data[offset + 4 + i] as i64
        hex = hex + _HEX_DIGITS_V1.substring(b / 16, b / 16 + 1) + _HEX_DIGITS_V1.substring(b % 16, b % 16 + 1)
        i = i + 1
    digest_v1_new(algo_id, hex)
