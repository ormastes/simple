use compiler.common.cache_contract.direct_read_pin_v1 (DirectReadPinV1)
use compiler.common.cache_contract.errors_v1 (CacheErrorV1)
use compiler.common.cache_contract.virtual_source_store_v1 (VirtualSourceStoreV1)

pub struct CacheLimitsV1:
    max_bytes: i64
    max_entries: i64

pub struct CacheLookupV1:
    present: bool
    object_kind: text
    object_digest: text
    canonical_bytes: [u8]
    pin: DirectReadPinV1?

pub struct SpoolReceiptV1:
    client_nonce: text
    spool_manifest_digest: text
    object_count: i64

pub struct GatewayStatusV1:
    mode: text
    writer_epoch_digest: text
    journal_generation: i64

# Public transport-neutral facade. It deliberately has no authoritative writer.
pub trait CacheGatewayV1:
    fn begin_direct_read(ttl: i64) -> Result<DirectReadPinV1, CacheErrorV1>
    fn lookup_verified_action(action_digest: text, pin: DirectReadPinV1) -> Result<CacheLookupV1, CacheErrorV1>
    fn get_verified(kind: text, digest: text, limits: CacheLimitsV1, pin: DirectReadPinV1) -> Result<CacheLookupV1, CacheErrorV1>
    fn renew_direct_read_pin(pin: DirectReadPinV1) -> Result<DirectReadPinV1, CacheErrorV1>
    fn release_direct_read_pin(pin: DirectReadPinV1) -> Result<(), CacheErrorV1>
    fn virtual_source_store() -> VirtualSourceStoreV1
    fn status() -> Result<GatewayStatusV1, CacheErrorV1>

# Opaque authority token. Construction and all mutation stay in Lane 3.
pub struct CacheWriterEpochV1:
    epoch_uuid: text
    owner_instance_nonce: text
    peer_user_id: text
    boot_identity_digest: text
    acquired_monotonic_nonce: i64
    protocol_digest: text
    expires_or_lease_generation: i64
    authentication_digest: text

pub struct CacheWriterV1:
    epoch: CacheWriterEpochV1
    authority_digest: text
