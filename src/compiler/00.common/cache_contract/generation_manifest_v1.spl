#![allow(primitive_api)]

use std.common.crypto.sha256.{sha256_u8_hex}
use std.common.structural.wire.{wire_check_envelope, wire_envelope_len, wire_magic,
    wire_put_envelope, wire_put_u32, wire_put_u64}
use compiler.common.cache_contract.physical_tld_v1.{ThreePayloadContractReaderV1,
    three_payload_contract_budget_v1,
    three_payload_contract_digest_valid_v1, three_payload_contract_max_items_v1,
    three_payload_contract_max_payload_bytes_v1,
    three_payload_contract_put_digest_v1}
use compiler.common.cache_contract.portable_object_ref_v1.{PortableObjectRefV1,
    portable_object_ref_budget_v1, portable_object_ref_key_v1,
    portable_object_ref_put_v1, portable_object_ref_read_v1,
    portable_object_ref_valid_v1}

pub struct GenerationManifestV1:
    schema: i64
    snapshot_digest: text
    catalog_digest: text
    summary_refs: [text]
    scope_refs: [text]
    rr_shard_refs: [text]
    forward_manifest_refs: [text]
    portable_refs: [PortableObjectRefV1]
    target_refs: [text]
    diagnostic_refs: [text]

pub struct GenerationManifestDecodeV1:
    ok: bool
    value: GenerationManifestV1?
    error: text

fn _sorted_digests_valid_v1(values: [text]) -> bool:
    if values.len() > three_payload_contract_max_items_v1(): return false
    var previous = ""
    var first = true
    for value in values:
        if not three_payload_contract_digest_valid_v1(value): return false
        if not first and value <= previous: return false
        previous = value
        first = false
    true

fn _portable_refs_valid_v1(values: [PortableObjectRefV1]) -> bool:
    if values.len() > three_payload_contract_max_items_v1(): return false
    var previous = ""
    var first = true
    for value in values:
        if not portable_object_ref_valid_v1(value): return false
        val key = portable_object_ref_key_v1(value)
        if not first and key <= previous: return false
        previous = key
        first = false
    true

pub fn generation_manifest_valid_v1(value: GenerationManifestV1) -> bool:
    val fields_valid = value.schema == 1 and
        three_payload_contract_digest_valid_v1(value.snapshot_digest) and
        three_payload_contract_digest_valid_v1(value.catalog_digest) and
        _sorted_digests_valid_v1(value.summary_refs) and
        _sorted_digests_valid_v1(value.scope_refs) and
        _sorted_digests_valid_v1(value.rr_shard_refs) and
        _sorted_digests_valid_v1(value.forward_manifest_refs) and
        _portable_refs_valid_v1(value.portable_refs) and
        _sorted_digests_valid_v1(value.target_refs) and
        _sorted_digests_valid_v1(value.diagnostic_refs)
    if not fields_valid: return false
    val budget = three_payload_contract_budget_v1()
    budget.add_bytes(wire_envelope_len() + 8)
    budget.add_digest(value.snapshot_digest)
    budget.add_digest(value.catalog_digest)
    for values in [value.summary_refs, value.scope_refs, value.rr_shard_refs,
            value.forward_manifest_refs, value.target_refs, value.diagnostic_refs]:
        budget.add_bytes(4)
        budget.add_items(values.len())
        for digest in values: budget.add_digest(digest)
    budget.add_bytes(4)
    budget.add_items(value.portable_refs.len())
    for reference in value.portable_refs: portable_object_ref_budget_v1(budget, reference)
    budget.ok

fn _put_digests_v1(out: [u8], values: [text]) -> [u8]:
    var bytes = wire_put_u32(out, values.len())
    for value in values: bytes = three_payload_contract_put_digest_v1(bytes, value)
    bytes

fn _read_digests_v1(reader: ThreePayloadContractReaderV1) -> [text]:
    var values: [text] = []
    val count = reader.read_count()
    var index: i64 = 0
    while reader.ok and index < count:
        values.push(reader.read_digest())
        index = index + 1
    values

pub fn generation_manifest_encode_v1(value: GenerationManifestV1) -> [u8]:
    if not generation_manifest_valid_v1(value): return []
    var out: [u8] = []
    out = wire_put_envelope(out, wire_magic("GEN1"), 1)
    out = wire_put_u64(out, value.schema)
    out = three_payload_contract_put_digest_v1(out, value.snapshot_digest)
    out = three_payload_contract_put_digest_v1(out, value.catalog_digest)
    out = _put_digests_v1(out, value.summary_refs)
    out = _put_digests_v1(out, value.scope_refs)
    out = _put_digests_v1(out, value.rr_shard_refs)
    out = _put_digests_v1(out, value.forward_manifest_refs)
    out = wire_put_u32(out, value.portable_refs.len())
    for reference in value.portable_refs: out = portable_object_ref_put_v1(out, reference)
    out = _put_digests_v1(out, value.target_refs)
    _put_digests_v1(out, value.diagnostic_refs)

fn _generation_failure_v1(error: text) -> GenerationManifestDecodeV1:
    GenerationManifestDecodeV1(ok: false, value: nil, error: error)

pub fn generation_manifest_decode_v1(bytes: [u8]) -> GenerationManifestDecodeV1:
    if bytes.len() > three_payload_contract_max_payload_bytes_v1(): return _generation_failure_v1("generation_bounds_exceeded")
    if not wire_check_envelope(bytes, 0, wire_magic("GEN1"), 1): return _generation_failure_v1("generation_v1_envelope_mismatch")
    val reader = ThreePayloadContractReaderV1(data: bytes, offset: wire_envelope_len(), ok: true,
        error: "", retained_text_bytes: 0, retained_items: 0)
    val schema = reader.read_u64_nonnegative()
    val snapshot = reader.read_digest()
    val catalog = reader.read_digest()
    val summaries = _read_digests_v1(reader)
    val scopes = _read_digests_v1(reader)
    val rr_refs = _read_digests_v1(reader)
    val forward_refs = _read_digests_v1(reader)
    val portable_count = reader.read_count()
    var portable: [PortableObjectRefV1] = []
    var index: i64 = 0
    while reader.ok and index < portable_count:
        portable.push(portable_object_ref_read_v1(reader))
        index = index + 1
    val targets = _read_digests_v1(reader)
    val diagnostics = _read_digests_v1(reader)
    if not reader.finished(): return _generation_failure_v1(if reader.error == "": "trailing_generation_bytes" else: reader.error)
    val value = GenerationManifestV1(schema: schema, snapshot_digest: snapshot,
        catalog_digest: catalog, summary_refs: summaries, scope_refs: scopes,
        rr_shard_refs: rr_refs, forward_manifest_refs: forward_refs,
        portable_refs: portable, target_refs: targets, diagnostic_refs: diagnostics)
    if not generation_manifest_valid_v1(value): return _generation_failure_v1("noncanonical_generation_manifest")
    GenerationManifestDecodeV1(ok: true, value: Some(value), error: "")

pub fn generation_manifest_digest_v1(value: GenerationManifestV1) -> text:
    val bytes = generation_manifest_encode_v1(value)
    if bytes.len() == 0: return ""
    sha256_u8_hex(bytes)
