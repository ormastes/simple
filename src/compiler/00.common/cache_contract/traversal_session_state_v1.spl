# One real traversal owner per CompileContext. This common state has no compiler
# imports; the actual lowering owner alone begins a fresh source epoch.
use compiler.common.cache_contract.traversal_output_cache_v1.{TraversalOutputCacheV1,
    TraversalRetentionLedgerV1}

pub class TraversalSessionStateV1:
    source_epoch: i64 = 0
    epoch_admitted: bool = false
    started_epoch: i64 = 0
    completed_epoch: i64 = 0
    cache_session: i64 = 0
    cache_initialized: bool = false
    cache: TraversalOutputCacheV1? = nil
    retention: TraversalRetentionLedgerV1? = nil
    output_lease: i64 = 0
    reuse_hits: i64 = 0

    static fn create() -> TraversalSessionStateV1:
        TraversalSessionStateV1()

    me begin_epoch(epoch: i64) -> bool:
        # Reissuing the same epoch must never certify a previously woven value
        # as fresh. The source owner supplies its monotonically increasing id.
        if epoch <= self.source_epoch:
            self.epoch_admitted = false
            return false
        self.source_epoch = epoch
        self.epoch_admitted = true
        self.started_epoch = 0
        self.completed_epoch = 0
        self.output_lease = 0
        # Do not access retained optional graphs or change allocation-session
        # identity here. The effectful owner validates that separately.
        true
