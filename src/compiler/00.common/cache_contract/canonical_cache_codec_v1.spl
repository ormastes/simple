#![allow(primitive_api, COLL006)]

use std.common.crypto.sha256 (sha256_u8_hex)
use std.common.string_core.{text_to_bytes, bytes_to_text}
use compiler.common.cache_contract.public_summary_v1.{PublicSummaryEntryV1, PublicSummaryV1}
use compiler.common.cache_contract.snapshot_contract_v1.{LogicalSourcePathV1, PathSemanticsV1, SourceBlobV1, SourceEncodingPolicyV1, CompileSnapshotV1, ResolutionWitnessV1, ResolutionCandidateV1, logical_source_path_valid_v1}
use compiler.common.cache_contract.file_ast_v1.{FileAstNodeV1, FileAstV1}
use compiler.common.cache_contract.semantic_read_set_v1.{SemanticEffectKindV1, SemanticReplayPolicyV1, SemanticReadEntryV1, SemanticReadSetV1}

pub fn canonical_cache_max_payload_bytes_v1() -> i64: 268435456
pub fn canonical_cache_max_entries_v1() -> i64: 1048576
pub fn canonical_cache_max_text_bytes_v1() -> i64: 16777216
pub fn canonical_cache_header_bytes_v1() -> i64: 56
pub fn canonical_cache_kind_public_summary_v1() -> i64: 3
pub fn canonical_cache_kind_source_blob_v1() -> i64: 1
pub fn canonical_cache_kind_compile_snapshot_v1() -> i64: 2
pub fn canonical_cache_kind_file_ast_v1() -> i64: 4
pub fn canonical_cache_kind_semantic_read_set_v1() -> i64: 5

pub struct CanonicalCacheEnvelopeV1:
    kind: i64
    schema: i64
    payload: [u8]
    payload_digest: text
    object_digest: text

pub struct CanonicalCacheDecodeV1:
    ok: bool
    value: CanonicalCacheEnvelopeV1?
    error: text

fn _push_u16_v1(buffer: [u8], value: i64):
    buffer.push((value & 255) as u8)
    buffer.push(((value >> 8) & 255) as u8)

fn _push_u32_v1(buffer: [u8], value: i64):
    var shift = 0
    while shift < 32:
        buffer.push(((value >> shift) & 255) as u8)
        shift = shift + 8

fn _push_u64_v1(buffer: [u8], value: i64):
    var shift = 0
    while shift < 64:
        buffer.push(((value >> shift) & 255) as u8)
        shift = shift + 8

fn _read_le_v1(bytes: [u8], offset: i64, count: i64) -> i64:
    var value: i64 = 0
    var i = 0
    while i < count:
        value = value | ((bytes[offset + i] as i64) << (i * 8))
        i = i + 1
    value

fn _hex_nibble_v1(ch: text) -> i64:
    val lower = "0123456789abcdef"
    var i = 0
    while i < 16:
        if ch == lower.char_at(i): return i
        i = i + 1
    -1

fn _digest_hex_to_raw_v1(digest: text) -> [u8]:
    var buffer: [u8] = []
    if digest.len() != 64: return buffer
    var i = 0
    while i < 64:
        val hi = _hex_nibble_v1(digest.char_at(i))
        val lo = _hex_nibble_v1(digest.char_at(i + 1))
        if hi < 0 or lo < 0:
            val empty: [u8] = []
            return empty
        buffer.push(((hi << 4) | lo) as u8)
        i = i + 2
    buffer

fn _raw_digest_to_hex_v1(bytes: [u8], offset: i64) -> text:
    val digits = "0123456789abcdef"
    var buffer = ""
    var i = 0
    while i < 32:
        val value = bytes[offset + i] as i64
        buffer = buffer + digits.char_at((value >> 4) & 15)
        buffer = buffer + digits.char_at(value & 15)
        i = i + 1
    buffer

fn _append_bytes_v1(buffer: [u8], values: [u8]):
    var i = 0
    while i < values.len():
        buffer.push(values[i])
        i = i + 1

pub fn canonical_cache_encode_envelope_v1(kind: i64, schema: i64, payload: [u8]) -> [u8]:
    var buffer: [u8] = []
    if kind < 0 or kind > 65535 or schema < 0 or schema > 65535:
        return buffer
    if payload.len() > canonical_cache_max_payload_bytes_v1():
        return buffer
    _append_bytes_v1(buffer, text_to_bytes("SMPLCAV1"))
    _push_u16_v1(buffer, kind)
    _push_u16_v1(buffer, schema)
    _push_u32_v1(buffer, 0)
    _push_u64_v1(buffer, payload.len())
    val digest = sha256_u8_hex(payload)
    val raw = _digest_hex_to_raw_v1(digest)
    if raw.len() != 32:
        val empty: [u8] = []
        return empty
    _append_bytes_v1(buffer, raw)
    _append_bytes_v1(buffer, payload)
    buffer

fn _decode_failure_v1(message: text) -> CanonicalCacheDecodeV1:
    CanonicalCacheDecodeV1(ok: false, value: nil, error: message)

pub fn canonical_cache_decode_envelope_v1(bytes: [u8]) -> CanonicalCacheDecodeV1:
    val header = canonical_cache_header_bytes_v1()
    if bytes.len() < header: return _decode_failure_v1("truncated_envelope")
    var i = 0
    val magic = text_to_bytes("SMPLCAV1")
    while i < 8:
        if bytes[i] != magic[i]: return _decode_failure_v1("invalid_magic")
        i = i + 1
    val flags = _read_le_v1(bytes, 12, 4)
    if flags != 0: return _decode_failure_v1("reserved_flags_nonzero")
    val payload_len = _read_le_v1(bytes, 16, 8)
    if payload_len < 0 or payload_len > canonical_cache_max_payload_bytes_v1():
        return _decode_failure_v1("payload_bounds_exceeded")
    if payload_len > bytes.len() - header:
        return _decode_failure_v1("truncated_payload")
    if payload_len != bytes.len() - header:
        return _decode_failure_v1("trailing_bytes")
    val payload = bytes[header..bytes.len()]
    val expected = _raw_digest_to_hex_v1(bytes, 24)
    val actual = sha256_u8_hex(payload)
    if expected != actual: return _decode_failure_v1("payload_digest_mismatch")
    val object_digest = canonical_cache_object_digest_v1(bytes)
    val value = CanonicalCacheEnvelopeV1(
        kind: _read_le_v1(bytes, 8, 2), schema: _read_le_v1(bytes, 10, 2),
        payload: payload, payload_digest: actual, object_digest: object_digest)
    CanonicalCacheDecodeV1(ok: true, value: value, error: "")

pub fn canonical_cache_object_digest_v1(envelope: [u8]) -> text:
    var framed: [u8] = []
    _append_bytes_v1(framed, text_to_bytes("simple.cas.object.v1\u0000"))
    _append_bytes_v1(framed, envelope)
    sha256_u8_hex(framed)

fn _domain_digest_v1(domain: text, bytes: [u8]) -> text:
    var framed = text_to_bytes(domain)
    _append_bytes_v1(framed, bytes)
    sha256_u8_hex(framed)

pub fn canonical_cache_encode_text_v1(value: text) -> [u8]:
    val bytes = text_to_bytes(value)
    var buffer: [u8] = []
    if bytes.len() > canonical_cache_max_text_bytes_v1(): return buffer
    _push_u64_v1(buffer, bytes.len())
    _append_bytes_v1(buffer, bytes)
    buffer

pub fn canonical_cache_encode_sorted_text_map_v1(keys: [text], values: [text]) -> [u8]:
    var buffer: [u8] = []
    if keys.len() != values.len() or keys.len() > canonical_cache_max_entries_v1(): return buffer
    var indices: [i64] = []
    var i = 0
    while i < keys.len():
        indices.push(i)
        i = i + 1
    i = 1
    while i < indices.len():
        val held = indices[i]
        var j = i
        while j > 0 and keys[held] < keys[indices[j - 1]]:
            indices[j] = indices[j - 1]
            j = j - 1
        indices[j] = held
        i = i + 1
    i = 1
    while i < indices.len():
        if keys[indices[i - 1]] == keys[indices[i]]:
            val empty: [u8] = []
            return empty
        i = i + 1
    _push_u64_v1(buffer, indices.len())
    for index in indices:
        _append_bytes_v1(buffer, canonical_cache_encode_text_v1(keys[index]))
        _append_bytes_v1(buffer, canonical_cache_encode_text_v1(values[index]))
    buffer

fn _append_digest_v1(buffer: [u8], digest: text) -> bool:
    val raw = _digest_hex_to_raw_v1(digest)
    if raw.len() != 32: return false
    _append_bytes_v1(buffer, raw)
    true

fn _append_logical_path_v1(buffer: [u8], path: LogicalSourcePathV1) -> bool:
    if not logical_source_path_valid_v1(path): return false
    if not _append_digest_v1(buffer, path.repository_namespace_digest): return false
    _append_text_v1(buffer, path.module_relative_utf8)
    match path.path_semantics:
        case PathSemanticsV1.CaseSensitiveNfc: _push_u16_v1(buffer, 1)
        case PathSemanticsV1.CaseFoldedNfc: _push_u16_v1(buffer, 2)
    true

pub fn canonical_source_blob_payload_v1(blob: SourceBlobV1) -> [u8]:
    var buffer: [u8] = []
    if not _append_logical_path_v1(buffer, blob.logical_path): return []
    if blob.source_bytes.len() > canonical_cache_max_payload_bytes_v1(): return []
    _push_u64_v1(buffer, blob.source_bytes.len())
    _append_bytes_v1(buffer, blob.source_bytes)
    val expected = _domain_digest_v1("simple.source.v1\u0000", blob.source_bytes)
    if blob.source_digest != expected or not _append_digest_v1(buffer, blob.source_digest): return []
    match blob.encoding_policy:
        case SourceEncodingPolicyV1.Utf8Exact: _push_u16_v1(buffer, 1)
    match blob.generated_provenance:
        case nil: buffer.push(0 as u8)
        case provenance:
            buffer.push(1 as u8)
            if not _append_digest_v1(buffer, provenance.producer_digest): return []
            if not _append_digest_v1(buffer, provenance.input_manifest_digest): return []
    buffer

pub fn canonical_source_blob_encode_v1(blob: SourceBlobV1) -> [u8]:
    val payload = canonical_source_blob_payload_v1(blob)
    if payload.len() == 0: return payload
    canonical_cache_encode_envelope_v1(canonical_cache_kind_source_blob_v1(), 1, payload)

pub fn canonical_source_blob_digest_v1(blob: SourceBlobV1) -> text:
    val encoded = canonical_source_blob_encode_v1(blob)
    if encoded.len() == 0: return ""
    canonical_cache_object_digest_v1(encoded)

fn _append_text_sequence_v1(buffer: [u8], values: [text]) -> bool:
    if values.len() > canonical_cache_max_entries_v1(): return false
    _push_u64_v1(buffer, values.len())
    for value in values: _append_text_v1(buffer, value)
    true

fn _append_candidate_v1(buffer: [u8], candidate: ResolutionCandidateV1) -> bool:
    if candidate.order < 0: return false
    _push_u64_v1(buffer, candidate.order)
    _append_text_v1(buffer, candidate.logical_path)
    _append_text_v1(buffer, candidate.normalization_key)
    if not _append_digest_v1(buffer, candidate.physical_identity_digest): return false
    if not _append_digest_v1(buffer, candidate.parent_directory_generation_digest): return false
    _append_text_v1(buffer, candidate.entry_kind)
    buffer.push((if candidate.exists: 1 else: 0) as u8)
    buffer.push((if candidate.selected: 1 else: 0) as u8)
    if not _append_digest_v1(buffer, candidate.content_digest): return false
    if not _append_digest_v1(buffer, candidate.symlink_chain_digest): return false
    true

fn _append_witness_v1(buffer: [u8], witness: ResolutionWitnessV1) -> bool:
    if not _append_digest_v1(buffer, witness.resolver_policy_digest): return false
    if not _append_digest_v1(buffer, witness.root_trust_digest): return false
    _push_u64_v1(buffer, witness.candidates.len())
    var i = 0
    var selected = 0
    while i < witness.candidates.len():
        if witness.candidates[i].order != i: return false
        if witness.candidates[i].selected: selected = selected + 1
        if not _append_candidate_v1(buffer, witness.candidates[i]): return false
        i = i + 1
    if witness.selected_index < -1 or witness.selected_index >= witness.candidates.len(): return false
    if witness.selected_index == -1 and selected != 0: return false
    if witness.selected_index >= 0 and (selected != 1 or not witness.candidates[witness.selected_index].selected): return false
    _push_u64_v1(buffer, witness.selected_index + 1)
    if not _append_text_sequence_v1(buffer, witness.generated_input_digests): return false
    _append_digest_v1(buffer, witness.witness_digest)

pub fn canonical_compile_snapshot_payload_v1(snapshot: CompileSnapshotV1) -> [u8]:
    var buffer: [u8] = []
    if snapshot.schema != 1: return buffer
    _push_u64_v1(buffer, snapshot.schema)
    if not _append_digest_v1(buffer, snapshot.repository_namespace_digest): return []
    if not _append_digest_v1(buffer, snapshot.path_policy_digest): return []
    _push_u64_v1(buffer, snapshot.source_entries.len())
    for entry in snapshot.source_entries:
        if not _append_logical_path_v1(buffer, entry.logical_path): return []
        if not _append_digest_v1(buffer, entry.source_blob_digest): return []
    _push_u64_v1(buffer, snapshot.resolution_witnesses.len())
    for witness in snapshot.resolution_witnesses:
        if not _append_witness_v1(buffer, witness): return []
    _push_u64_v1(buffer, snapshot.negative_candidates.len())
    for negative in snapshot.negative_candidates:
        if not _append_logical_path_v1(buffer, negative.anchor): return []
        if not _append_logical_path_v1(buffer, negative.logical_candidate): return []
        if not _append_digest_v1(buffer, negative.absence_witness_digest): return []
    _push_u64_v1(buffer, snapshot.directory_generations.len())
    for generation in snapshot.directory_generations:
        if not _append_logical_path_v1(buffer, generation.anchor_logical_path): return []
        if not _append_digest_v1(buffer, generation.stable_generation_digest): return []
    _push_u64_v1(buffer, snapshot.generated_inputs.len())
    for generated in snapshot.generated_inputs:
        if not _append_logical_path_v1(buffer, generated.logical_path): return []
        if not _append_digest_v1(buffer, generated.producer_digest): return []
        if not _append_digest_v1(buffer, generated.input_manifest_digest): return []
    if not _append_digest_v1(buffer, snapshot.configuration_digest): return []
    if not _append_digest_v1(buffer, snapshot.target_layout_digest): return []
    if not _append_digest_v1(buffer, snapshot.compiler_owner_digest): return []
    if not _append_digest_v1(buffer, snapshot.runtime_digest): return []
    _push_u64_v1(buffer, snapshot.provider_manifests.len())
    for provider in snapshot.provider_manifests:
        _append_text_v1(buffer, provider.name)
        if not _append_digest_v1(buffer, provider.digest): return []
    _push_u64_v1(buffer, snapshot.toolchain_component_digests.len())
    for component in snapshot.toolchain_component_digests:
        _append_text_v1(buffer, component.name)
        if not _append_digest_v1(buffer, component.digest): return []
    buffer

pub fn canonical_compile_snapshot_encode_v1(snapshot: CompileSnapshotV1) -> [u8]:
    val payload = canonical_compile_snapshot_payload_v1(snapshot)
    if payload.len() == 0: return payload
    canonical_cache_encode_envelope_v1(canonical_cache_kind_compile_snapshot_v1(), 1, payload)

pub fn canonical_compile_snapshot_digest_v1(snapshot: CompileSnapshotV1) -> text:
    val payload = canonical_compile_snapshot_payload_v1(snapshot)
    if payload.len() == 0: return ""
    _domain_digest_v1("simple.compile.snapshot.v1\u0000", payload)

pub fn canonical_file_ast_payload_v1(ast: FileAstV1) -> [u8]:
    var buffer: [u8] = []
    if ast.nodes.len() == 0 or ast.nodes.len() > canonical_cache_max_entries_v1(): return buffer
    if ast.root_node < 0 or ast.root_node >= ast.nodes.len(): return buffer
    if not _append_digest_v1(buffer, ast.source_blob_digest): return []
    if not _append_digest_v1(buffer, ast.grammar_digest): return []
    if not _append_digest_v1(buffer, ast.compiler_owner_digest): return []
    if not _append_text_sequence_v1(buffer, ast.string_table): return []
    _push_u64_v1(buffer, ast.nodes.len())
    for node in ast.nodes:
        if node.kind < 0 or node.flags < 0 or node.source_start < 0 or node.source_end < node.source_start: return []
        if node.first_child < 0 or node.child_count < 0 or node.first_child > ast.nodes.len() - node.child_count: return []
        if node.payload_index < -1 or node.payload_index >= ast.payload_tables.len(): return []
        _push_u64_v1(buffer, node.kind)
        _push_u64_v1(buffer, node.flags)
        _push_u64_v1(buffer, node.source_start)
        _push_u64_v1(buffer, node.source_end)
        _push_u64_v1(buffer, node.first_child)
        _push_u64_v1(buffer, node.child_count)
        _push_u64_v1(buffer, node.payload_index + 1)
    if not _append_text_sequence_v1(buffer, ast.payload_tables): return []
    _push_u64_v1(buffer, ast.root_node)
    if not _append_digest_v1(buffer, ast.public_summary_digest): return []
    if not _append_digest_v1(buffer, ast.semantic_read_set_digest): return []
    buffer

pub fn canonical_file_ast_encode_v1(ast: FileAstV1) -> [u8]:
    val payload = canonical_file_ast_payload_v1(ast)
    if payload.len() == 0: return payload
    canonical_cache_encode_envelope_v1(canonical_cache_kind_file_ast_v1(), 1, payload)

pub struct FileAstDecodeV1:
    ok: bool
    value: FileAstV1?
    error: text

pub fn canonical_file_ast_decode_v1(bytes: [u8]) -> FileAstDecodeV1:
    val decoded = canonical_cache_decode_envelope_v1(bytes)
    if not decoded.ok: return FileAstDecodeV1(ok: false, value: nil, error: decoded.error)
    val envelope = match decoded.value:
        case value: value
        case nil: return FileAstDecodeV1(ok: false, value: nil, error: "missing_envelope")
    if envelope.kind != canonical_cache_kind_file_ast_v1() or envelope.schema != 1:
        return FileAstDecodeV1(ok: false, value: nil, error: "file_ast_schema_mismatch")
    val cursor = _CanonicalCursorV1(bytes: envelope.payload, position: 0, failed: false)
    val source = cursor.read_digest()
    val grammar = cursor.read_digest()
    val owner = cursor.read_digest()
    val strings = cursor.read_texts()
    val node_count = cursor.read_u64()
    var nodes: [FileAstNodeV1] = []
    if node_count <= 0 or node_count > canonical_cache_max_entries_v1(): cursor.failed = true
    var i = 0
    while i < node_count and not cursor.failed:
        nodes.push(FileAstNodeV1(kind: cursor.read_u64(), flags: cursor.read_u64(), source_start: cursor.read_u64(),
            source_end: cursor.read_u64(), first_child: cursor.read_u64(), child_count: cursor.read_u64(),
            payload_index: cursor.read_u64() - 1))
        i = i + 1
    val payloads = cursor.read_texts()
    val root = cursor.read_u64()
    val summary = cursor.read_digest()
    val read_set = cursor.read_digest()
    if cursor.failed or cursor.position != cursor.bytes.len():
        return FileAstDecodeV1(ok: false, value: nil, error: "malformed_file_ast")
    val value = FileAstV1(source_blob_digest: source, grammar_digest: grammar, compiler_owner_digest: owner,
        string_table: strings, nodes: nodes, payload_tables: payloads, root_node: root,
        public_summary_digest: summary, semantic_read_set_digest: read_set)
    if canonical_file_ast_payload_v1(value).len() == 0:
        return FileAstDecodeV1(ok: false, value: nil, error: "invalid_file_ast_indices")
    FileAstDecodeV1(ok: true, value: value, error: "")

fn _effect_tag_v1(kind: SemanticEffectKindV1) -> i64:
    match kind:
        case SemanticEffectKindV1.Source: 1
        case SemanticEffectKindV1.GeneratedSource: 2
        case SemanticEffectKindV1.MacroCtfeInput: 3
        case SemanticEffectKindV1.EnvironmentFacade: 4
        case SemanticEffectKindV1.ClockFacade: 5
        case SemanticEffectKindV1.RandomnessFacade: 6
        case SemanticEffectKindV1.NetworkFacade: 7
        case SemanticEffectKindV1.ProcessFacade: 8
        case SemanticEffectKindV1.Plugin: 9
        case SemanticEffectKindV1.ToolchainComponent: 10

fn _replay_tag_v1(policy: SemanticReplayPolicyV1) -> i64:
    match policy:
        case SemanticReplayPolicyV1.DeclaredReplayable: 1
        case SemanticReplayPolicyV1.UndeclaredUncacheable: 2

fn _read_entry_key_v1(entry: SemanticReadEntryV1) -> text:
    _effect_tag_v1(entry.effect_kind).to_text() + "\u0000" + entry.logical_name + "\u0000" + entry.provider_id

pub fn canonical_semantic_read_set_payload_v1(read_set: SemanticReadSetV1) -> [u8]:
    var entries = read_set.entries.copy()
    var i = 1
    while i < entries.len():
        val held = entries[i]
        var j = i
        while j > 0 and _read_entry_key_v1(held) < _read_entry_key_v1(entries[j - 1]):
            entries[j] = entries[j - 1]
            j = j - 1
        entries[j] = held
        i = i + 1
    var buffer: [u8] = []
    _push_u64_v1(buffer, entries.len())
    i = 0
    while i < entries.len():
        if i > 0 and _read_entry_key_v1(entries[i - 1]) == _read_entry_key_v1(entries[i]): return []
        val entry = entries[i]
        _push_u16_v1(buffer, _effect_tag_v1(entry.effect_kind))
        _append_text_v1(buffer, entry.logical_name)
        _append_text_v1(buffer, entry.provider_id)
        if not _append_digest_v1(buffer, entry.provider_manifest_digest): return []
        if not _append_digest_v1(buffer, entry.value_digest): return []
        _push_u16_v1(buffer, _replay_tag_v1(entry.replay_policy))
        i = i + 1
    _append_text_v1(buffer, read_set.uncacheable_reason)
    buffer

pub fn canonical_semantic_read_set_encode_v1(read_set: SemanticReadSetV1) -> [u8]:
    val payload = canonical_semantic_read_set_payload_v1(read_set)
    if payload.len() == 0: return payload
    canonical_cache_encode_envelope_v1(canonical_cache_kind_semantic_read_set_v1(), 1, payload)

pub struct SemanticReadSetDecodeV1:
    ok: bool
    value: SemanticReadSetV1?
    error: text

fn _effect_from_tag_v1(tag: i64) -> SemanticEffectKindV1?:
    match tag:
        case 1: SemanticEffectKindV1.Source
        case 2: SemanticEffectKindV1.GeneratedSource
        case 3: SemanticEffectKindV1.MacroCtfeInput
        case 4: SemanticEffectKindV1.EnvironmentFacade
        case 5: SemanticEffectKindV1.ClockFacade
        case 6: SemanticEffectKindV1.RandomnessFacade
        case 7: SemanticEffectKindV1.NetworkFacade
        case 8: SemanticEffectKindV1.ProcessFacade
        case 9: SemanticEffectKindV1.Plugin
        case 10: SemanticEffectKindV1.ToolchainComponent
        case _: nil

fn _replay_from_tag_v1(tag: i64) -> SemanticReplayPolicyV1?:
    match tag:
        case 1: SemanticReplayPolicyV1.DeclaredReplayable
        case 2: SemanticReplayPolicyV1.UndeclaredUncacheable
        case _: nil

pub fn canonical_semantic_read_set_decode_v1(bytes: [u8]) -> SemanticReadSetDecodeV1:
    val decoded = canonical_cache_decode_envelope_v1(bytes)
    if not decoded.ok: return SemanticReadSetDecodeV1(ok: false, value: nil, error: decoded.error)
    val envelope = match decoded.value:
        case value: value
        case nil: return SemanticReadSetDecodeV1(ok: false, value: nil, error: "missing_envelope")
    if envelope.kind != canonical_cache_kind_semantic_read_set_v1() or envelope.schema != 1:
        return SemanticReadSetDecodeV1(ok: false, value: nil, error: "semantic_read_set_schema_mismatch")
    val cursor = _CanonicalCursorV1(bytes: envelope.payload, position: 0, failed: false)
    val count = cursor.read_u64()
    if count < 0 or count > canonical_cache_max_entries_v1():
        return SemanticReadSetDecodeV1(ok: false, value: nil, error: "semantic_read_set_bounds")
    var entries: [SemanticReadEntryV1] = []
    var i = 0
    while i < count:
        if cursor.position > cursor.bytes.len() - 2:
            return SemanticReadSetDecodeV1(ok: false, value: nil, error: "truncated_effect_tag")
        val effect_tag = _read_le_v1(cursor.bytes, cursor.position, 2)
        cursor.position = cursor.position + 2
        val effect = match _effect_from_tag_v1(effect_tag):
            case value: value
            case nil: return SemanticReadSetDecodeV1(ok: false, value: nil, error: "unknown_effect_tag")
        val logical_name = cursor.read_text()
        val provider_id = cursor.read_text()
        val provider_digest = cursor.read_digest()
        val value_digest = cursor.read_digest()
        if cursor.position > cursor.bytes.len() - 2:
            return SemanticReadSetDecodeV1(ok: false, value: nil, error: "truncated_replay_tag")
        val replay_tag = _read_le_v1(cursor.bytes, cursor.position, 2)
        cursor.position = cursor.position + 2
        val replay = match _replay_from_tag_v1(replay_tag):
            case value: value
            case nil: return SemanticReadSetDecodeV1(ok: false, value: nil, error: "unknown_replay_tag")
        entries.push(SemanticReadEntryV1(effect_kind: effect, logical_name: logical_name, provider_id: provider_id,
            provider_manifest_digest: provider_digest, value_digest: value_digest, replay_policy: replay))
        i = i + 1
    val reason = cursor.read_text()
    if cursor.failed or cursor.position != cursor.bytes.len():
        return SemanticReadSetDecodeV1(ok: false, value: nil, error: "malformed_semantic_read_set")
    val value = SemanticReadSetV1(entries: entries, uncacheable_reason: reason)
    if canonical_semantic_read_set_payload_v1(value).len() == 0:
        return SemanticReadSetDecodeV1(ok: false, value: nil, error: "noncanonical_semantic_read_set")
    SemanticReadSetDecodeV1(ok: true, value: value, error: "")

class _CanonicalCursorV1:
    bytes: [u8]
    position: i64
    failed: bool

    me fn read_u64() -> i64:
        if self.failed or self.position > self.bytes.len() - 8:
            self.failed = true
            return -1
        val value = _read_le_v1(self.bytes, self.position, 8)
        self.position = self.position + 8
        value

    me fn read_text() -> text:
        val count = self.read_u64()
        if count < 0 or count > canonical_cache_max_text_bytes_v1():
            self.failed = true
            return ""
        if self.position > self.bytes.len() - count:
            self.failed = true
            return ""
        val value = bytes_to_text(self.bytes[self.position..(self.position + count)])
        self.position = self.position + count
        value

    me fn read_digest() -> text:
        if self.failed or self.position > self.bytes.len() - 32:
            self.failed = true
            return ""
        val value = _raw_digest_to_hex_v1(self.bytes, self.position)
        self.position = self.position + 32
        value

    me fn read_texts() -> [text]:
        var values: [text] = []
        val count = self.read_u64()
        if count < 0 or count > canonical_cache_max_entries_v1():
            self.failed = true
            return values
        var i = 0
        while i < count:
            values.push(self.read_text())
            i = i + 1
        values

fn _append_text_v1(buffer: [u8], value: text):
    _append_bytes_v1(buffer, canonical_cache_encode_text_v1(value))

fn _summary_entry_less_v1(a: PublicSummaryEntryV1, b: PublicSummaryEntryV1) -> bool:
    a.stable_symbol_id < b.stable_symbol_id or (a.stable_symbol_id == b.stable_symbol_id and a.canonical_bytes < b.canonical_bytes)

fn _summary_entries_sorted_v1(entries: [PublicSummaryEntryV1]) -> [PublicSummaryEntryV1]:
    var sorted = entries.copy()
    var i = 1
    while i < sorted.len():
        val held = sorted[i]
        var j = i
        while j > 0 and _summary_entry_less_v1(held, sorted[j - 1]):
            sorted[j] = sorted[j - 1]
            j = j - 1
        sorted[j] = held
        i = i + 1
    sorted

pub fn canonical_summary_entries_valid_v1(entries: [PublicSummaryEntryV1]) -> bool:
    if entries.len() > canonical_cache_max_entries_v1(): return false
    val sorted = _summary_entries_sorted_v1(entries)
    var i = 1
    while i < sorted.len():
        if sorted[i - 1].stable_symbol_id == sorted[i].stable_symbol_id and sorted[i - 1].canonical_bytes != sorted[i].canonical_bytes:
            return false
        i = i + 1
    true

fn _encode_summary_entries_v1(buffer: [u8], entries: [PublicSummaryEntryV1]):
    val sorted = _summary_entries_sorted_v1(entries)
    _push_u64_v1(buffer, sorted.len())
    for entry in sorted:
        _append_text_v1(buffer, entry.stable_symbol_id)
        _append_text_v1(buffer, entry.canonical_bytes)

fn _decode_summary_entries_v1(cursor: _CanonicalCursorV1) -> [PublicSummaryEntryV1]:
    var buffer: [PublicSummaryEntryV1] = []
    val count = cursor.read_u64()
    if count < 0 or count > canonical_cache_max_entries_v1():
        cursor.failed = true
        return buffer
    var i = 0
    while i < count:
        buffer.push(PublicSummaryEntryV1(stable_symbol_id: cursor.read_text(), canonical_bytes: cursor.read_text()))
        i = i + 1
    if not canonical_summary_entries_valid_v1(buffer): cursor.failed = true
    buffer

pub fn canonical_public_summary_payload_v1(summary: PublicSummaryV1) -> [u8]:
    var buffer: [u8] = []
    val valid = canonical_summary_entries_valid_v1(summary.forward_declarations) and canonical_summary_entries_valid_v1(summary.declarations)
    if not valid or summary.schema != 1: return buffer
    _append_text_v1(buffer, summary.snapshot_id)
    _append_text_v1(buffer, summary.logical_path.repository_namespace_digest)
    _append_text_v1(buffer, summary.logical_path.module_relative_utf8)
    match summary.logical_path.path_semantics:
        case PathSemanticsV1.CaseSensitiveNfc: _push_u16_v1(buffer, 1)
        case PathSemanticsV1.CaseFoldedNfc: _push_u16_v1(buffer, 2)
    _append_text_v1(buffer, summary.source_blob_digest)
    _push_u64_v1(buffer, summary.schema)
    _append_text_v1(buffer, summary.compiler_owner_digest)
    _append_text_v1(buffer, summary.grammar_digest)
    # Distinct fixed phases/tags; forward and full declarations never alias.
    _push_u16_v1(buffer, 1)
    _encode_summary_entries_v1(buffer, summary.forward_declarations)
    _push_u16_v1(buffer, 2)
    _encode_summary_entries_v1(buffer, summary.declarations)
    _encode_summary_entries_v1(buffer, summary.layouts_abi)
    _encode_summary_entries_v1(buffer, summary.traits_impls_coherence)
    _encode_summary_entries_v1(buffer, summary.extensions_reexports)
    _encode_summary_entries_v1(buffer, summary.aop_selectors)
    _encode_summary_entries_v1(buffer, summary.macro_signatures)
    _encode_summary_entries_v1(buffer, summary.body_refs)
    _encode_summary_entries_v1(buffer, summary.reverse_reference_roots)
    _append_text_v1(buffer, summary.declaration_graph_digest)
    _append_text_v1(buffer, summary.virtual_text_digest)
    buffer

pub fn canonical_public_summary_encode_v1(summary: PublicSummaryV1) -> [u8]:
    val payload = canonical_public_summary_payload_v1(summary)
    if payload.len() == 0: return payload
    canonical_cache_encode_envelope_v1(canonical_cache_kind_public_summary_v1(), 1, payload)

pub struct PublicSummaryDecodeV1:
    ok: bool
    value: PublicSummaryV1?
    error: text

fn _summary_decode_failure_v1(error: text) -> PublicSummaryDecodeV1:
    PublicSummaryDecodeV1(ok: false, value: nil, error: error)

pub fn canonical_public_summary_decode_v1(bytes: [u8]) -> PublicSummaryDecodeV1:
    val decoded = canonical_cache_decode_envelope_v1(bytes)
    if not decoded.ok: return _summary_decode_failure_v1(decoded.error)
    val envelope = match decoded.value:
        case value: value
        case nil: return _summary_decode_failure_v1("missing_envelope")
    if envelope.kind != canonical_cache_kind_public_summary_v1() or envelope.schema != 1:
        return _summary_decode_failure_v1("summary_schema_mismatch")
    val cursor = _CanonicalCursorV1(bytes: envelope.payload, position: 0, failed: false)
    val snapshot_id = cursor.read_text()
    val repository_digest = cursor.read_text()
    val relative = cursor.read_text()
    if cursor.failed or cursor.position > cursor.bytes.len() - 2: return _summary_decode_failure_v1("truncated_summary")
    val path_tag = _read_le_v1(cursor.bytes, cursor.position, 2)
    cursor.position = cursor.position + 2
    val semantics = if path_tag == 1: PathSemanticsV1.CaseSensitiveNfc else: PathSemanticsV1.CaseFoldedNfc
    if path_tag != 1 and path_tag != 2: return _summary_decode_failure_v1("unknown_path_semantics")
    val source_digest = cursor.read_text()
    val schema = cursor.read_u64()
    val compiler_digest = cursor.read_text()
    val grammar_digest = cursor.read_text()
    if cursor.failed or cursor.position > cursor.bytes.len() - 2: return _summary_decode_failure_v1("truncated_forward_tag")
    val forward_tag = _read_le_v1(cursor.bytes, cursor.position, 2)
    cursor.position = cursor.position + 2
    if forward_tag != 1: return _summary_decode_failure_v1("unknown_forward_tag")
    val forwards = _decode_summary_entries_v1(cursor)
    if cursor.failed or cursor.position > cursor.bytes.len() - 2: return _summary_decode_failure_v1("truncated_declaration_tag")
    val declaration_tag = _read_le_v1(cursor.bytes, cursor.position, 2)
    cursor.position = cursor.position + 2
    if declaration_tag != 2: return _summary_decode_failure_v1("unknown_declaration_tag")
    val declarations = _decode_summary_entries_v1(cursor)
    val layouts = _decode_summary_entries_v1(cursor)
    val traits = _decode_summary_entries_v1(cursor)
    val extensions = _decode_summary_entries_v1(cursor)
    val aop = _decode_summary_entries_v1(cursor)
    val macros = _decode_summary_entries_v1(cursor)
    val bodies = _decode_summary_entries_v1(cursor)
    val reverse_roots = _decode_summary_entries_v1(cursor)
    val graph_digest = cursor.read_text()
    val virtual_digest = cursor.read_text()
    if cursor.failed: return _summary_decode_failure_v1("malformed_summary")
    if cursor.position != cursor.bytes.len(): return _summary_decode_failure_v1("summary_trailing_bytes")
    val path = LogicalSourcePathV1(repository_namespace_digest: repository_digest, module_relative_utf8: relative, path_semantics: semantics)
    val summary = PublicSummaryV1(snapshot_id: snapshot_id, logical_path: path, source_blob_digest: source_digest,
        schema: schema, compiler_owner_digest: compiler_digest, grammar_digest: grammar_digest,
        forward_declarations: forwards, declarations: declarations, layouts_abi: layouts,
        traits_impls_coherence: traits, extensions_reexports: extensions, aop_selectors: aop,
        macro_signatures: macros, body_refs: bodies, reverse_reference_roots: reverse_roots,
        declaration_graph_digest: graph_digest, virtual_text_digest: virtual_digest)
    PublicSummaryDecodeV1(ok: true, value: summary, error: "")
