use compiler.common.cache_contract.semantic_read_set_v1 (SemanticEffectKindV1)

pub struct ProviderManifestV1:
    provider_id: text
    abi: text
    content_digest: text
    configuration_digest: text
    capabilities: [text]
    supported_effect_kinds: [SemanticEffectKindV1]
    effect_contract_digest: text
    target_constraints: [text]

pub struct CapsuleEffectSummaryV1:
    capsule_id: text
    capsule_content_digest: text
    required_capabilities: [text]
    declared_effects: [SemanticEffectKindV1]
    forbidden_effects: [SemanticEffectKindV1]
    eager_safe: bool
    initialization_effect_digest: text

pub fn capsule_effect_summary_eager_valid_v1(summary: CapsuleEffectSummaryV1) -> bool:
    summary.eager_safe and summary.declared_effects.len() > 0 and summary.initialization_effect_digest != ""
