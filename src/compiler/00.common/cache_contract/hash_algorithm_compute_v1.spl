# Digest computation for the algorithms of hash_algorithm_registry_v1 that this
# build implements. A registered algorithm that is not computable here can be
# carried and matched by another reader, but never verified by this one.
use std.common.crypto.sha256.{sha256_u8_fast_hex, sha256_u8_native_hex_or_empty}
use std.common.crypto.xxh3.{xxh3_64}
use compiler.common.cache_contract.hash_algorithm_registry_v1.{hash_algorithm_by_id_v1,
    HASH_ALGO_SHA256_V1, HASH_ALGO_XXH3_64_V1}

pub fn hash_algorithm_computable_v1(id: i64) -> bool:
    id == HASH_ALGO_SHA256_V1 or id == HASH_ALGO_XXH3_64_V1

pub fn hash_algorithm_name_v1(id: i64) -> text:
    if val a = hash_algorithm_by_id_v1(id):
        return a.name
    ""

fn _hex_to_bytes(hex: text) -> [u8]:
    val digits = "0123456789abcdef"
    var out: [u8] = []
    var i = 0
    while i + 1 < hex.len():
        val hi = digits.index_of(hex.char_at(i).to_lower())
        val lo = digits.index_of(hex.char_at(i + 1).to_lower())
        if hi < 0 or lo < 0:
            return []
        out.push((hi * 16 + lo) as u8)
        i = i + 2
    out

fn _u64_le_bytes(value: i64) -> [u8]:
    var out: [u8] = []
    var v = value
    var i = 0
    while i < 8:
        out.push((v & 255) as u8)
        v = v >> 8
        i = i + 1
    out

# Digest bytes of `data` under `id`; [] when this build cannot compute it.
pub fn hash_algorithm_digest_v1(id: i64, data: [u8]) -> [u8]:
    if id == HASH_ALGO_SHA256_V1:
        return _hex_to_bytes(sha256_u8_fast_hex(data))
    if id == HASH_ALGO_XXH3_64_V1:
        return _u64_le_bytes(xxh3_64(data).to_i64())
    []

# Native-only digest for cache-hit verification: [] when this build cannot
# compute `id` natively (SHA-256 accelerator unavailable), so the caller treats
# the entry as a MISS instead of running the pure-Simple SHA-256 fallback.
pub fn hash_algorithm_digest_native_v1(id: i64, data: [u8]) -> [u8]:
    if id == HASH_ALGO_SHA256_V1:
        val hex = sha256_u8_native_hex_or_empty(data)
        if hex == "":
            return []
        return _hex_to_bytes(hex)
    hash_algorithm_digest_v1(id, data)

export hash_algorithm_computable_v1, hash_algorithm_name_v1, hash_algorithm_digest_v1, hash_algorithm_digest_native_v1
