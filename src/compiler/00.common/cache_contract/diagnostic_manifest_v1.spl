#![allow(primitive_api)]

# Canonical, bounded diagnostic payload admitted by the verified CAS.  Source
# locations are byte offsets in the named source object; entries are sorted so
# equivalent diagnostic sets have one byte representation.

use std.common.structural.wire.{wire_check_envelope, wire_envelope_len, wire_magic,
    wire_put_envelope, wire_put_u8, wire_put_u32, wire_put_u64}
use compiler.common.cache_contract.physical_tld_v1.{ThreePayloadContractBudgetV1,
    ThreePayloadContractReaderV1, three_payload_contract_budget_v1,
    three_payload_contract_digest_valid_v1, three_payload_contract_max_items_v1,
    three_payload_contract_max_payload_bytes_v1,
    three_payload_contract_put_digest_v1, three_payload_contract_put_text_v1,
    three_payload_contract_text_valid_v1}

pub enum DiagnosticSeverityV1:
    Info
    Warning
    Error
    Fatal

pub struct DiagnosticManifestEntryV1:
    source_digest: text
    start_byte: i64
    end_byte: i64
    severity: DiagnosticSeverityV1
    code: text
    message: text

pub struct DiagnosticManifestV1:
    schema: i64
    sorted_entries: [DiagnosticManifestEntryV1]

pub struct DiagnosticManifestDecodeV1:
    ok: bool
    value: DiagnosticManifestV1?
    error: text

fn _diagnostic_severity_tag_v1(value: DiagnosticSeverityV1) -> i64:
    match value:
        case Info: 1
        case Warning: 2
        case Error: 3
        case Fatal: 4

fn _diagnostic_severity_from_tag_v1(value: i64) -> DiagnosticSeverityV1?:
    if value == 1: return Some(DiagnosticSeverityV1.Info)
    if value == 2: return Some(DiagnosticSeverityV1.Warning)
    if value == 3: return Some(DiagnosticSeverityV1.Error)
    if value == 4: return Some(DiagnosticSeverityV1.Fatal)
    nil

pub fn diagnostic_manifest_entry_valid_v1(value: DiagnosticManifestEntryV1) -> bool:
    three_payload_contract_digest_valid_v1(value.source_digest) and
        value.start_byte >= 0 and value.end_byte >= value.start_byte and
        three_payload_contract_text_valid_v1(value.code, false) and
        three_payload_contract_text_valid_v1(value.message, false)

fn _diagnostic_entry_before_v1(left: DiagnosticManifestEntryV1,
        right: DiagnosticManifestEntryV1) -> bool:
    if left.source_digest != right.source_digest: return left.source_digest < right.source_digest
    if left.start_byte != right.start_byte: return left.start_byte < right.start_byte
    if left.end_byte != right.end_byte: return left.end_byte < right.end_byte
    val left_severity = _diagnostic_severity_tag_v1(left.severity)
    val right_severity = _diagnostic_severity_tag_v1(right.severity)
    if left_severity != right_severity: return left_severity < right_severity
    if left.code != right.code: return left.code < right.code
    left.message < right.message

fn _diagnostic_entry_budget_v1(budget: ThreePayloadContractBudgetV1,
        value: DiagnosticManifestEntryV1):
    budget.add_digest(value.source_digest)
    budget.add_bytes(8 + 8 + 1)
    budget.add_text(value.code, false)
    budget.add_text(value.message, false)

pub fn diagnostic_manifest_valid_v1(value: DiagnosticManifestV1) -> bool:
    if value.schema != 1 or value.sorted_entries.len() > three_payload_contract_max_items_v1():
        return false
    val budget = three_payload_contract_budget_v1()
    budget.add_bytes(wire_envelope_len() + 8 + 4)
    budget.add_items(value.sorted_entries.len())
    var index: i64 = 0
    while index < value.sorted_entries.len():
        val entry = value.sorted_entries[index]
        if not diagnostic_manifest_entry_valid_v1(entry): return false
        if index > 0 and not _diagnostic_entry_before_v1(
                value.sorted_entries[index - 1], entry): return false
        _diagnostic_entry_budget_v1(budget, entry)
        index = index + 1
    budget.ok

fn _diagnostic_entry_put_v1(out: [u8], value: DiagnosticManifestEntryV1) -> [u8]:
    var bytes = three_payload_contract_put_digest_v1(out, value.source_digest)
    bytes = wire_put_u64(bytes, value.start_byte)
    bytes = wire_put_u64(bytes, value.end_byte)
    bytes = wire_put_u8(bytes, _diagnostic_severity_tag_v1(value.severity))
    bytes = three_payload_contract_put_text_v1(bytes, value.code)
    three_payload_contract_put_text_v1(bytes, value.message)

pub fn diagnostic_manifest_encode_v1(value: DiagnosticManifestV1) -> [u8]:
    if not diagnostic_manifest_valid_v1(value): return []
    var out: [u8] = []
    out = wire_put_envelope(out, wire_magic("DGM1"), 1)
    out = wire_put_u64(out, value.schema)
    out = wire_put_u32(out, value.sorted_entries.len())
    for entry in value.sorted_entries: out = _diagnostic_entry_put_v1(out, entry)
    out

fn _diagnostic_failure_v1(error: text) -> DiagnosticManifestDecodeV1:
    DiagnosticManifestDecodeV1(ok: false, value: nil, error: error)

pub fn diagnostic_manifest_decode_bounded_v1(bytes: [u8],
        max_items: i64) -> DiagnosticManifestDecodeV1:
    if max_items < 0 or max_items > three_payload_contract_max_items_v1():
        return _diagnostic_failure_v1("invalid_diagnostic_item_limit")
    if bytes.len() > three_payload_contract_max_payload_bytes_v1():
        return _diagnostic_failure_v1("diagnostic_manifest_bounds_exceeded")
    if not wire_check_envelope(bytes, 0, wire_magic("DGM1"), 1):
        return _diagnostic_failure_v1("diagnostic_manifest_v1_envelope_mismatch")
    val reader = ThreePayloadContractReaderV1(data: bytes,
        offset: wire_envelope_len(), ok: true, error: "",
        retained_text_bytes: 0, retained_items: 0)
    val schema = reader.read_u64_nonnegative()
    val count = reader.read_count()
    if not reader.ok: return _diagnostic_failure_v1(reader.error)
    if count > max_items: return _diagnostic_failure_v1("diagnostic_item_limit_exceeded")
    var entries: [DiagnosticManifestEntryV1] = []
    var index: i64 = 0
    while reader.ok and index < count:
        val source = reader.read_digest()
        val start = reader.read_u64_nonnegative()
        val end = reader.read_u64_nonnegative()
        val severity = _diagnostic_severity_from_tag_v1(reader.read_u8())
        if severity == nil:
            reader.reject("unknown_diagnostic_severity")
            return _diagnostic_failure_v1(reader.error)
        val code = reader.read_text(false)
        val message = reader.read_text(false)
        val decoded_severity = match severity:
            case Some(value): value
            case nil: DiagnosticSeverityV1.Error
        entries.push(DiagnosticManifestEntryV1(source_digest: source,
            start_byte: start, end_byte: end, severity: decoded_severity,
            code: code, message: message))
        index = index + 1
    if not reader.finished():
        return _diagnostic_failure_v1(if reader.error == "":
            "trailing_diagnostic_manifest_bytes" else: reader.error)
    val value = DiagnosticManifestV1(schema: schema, sorted_entries: entries)
    if not diagnostic_manifest_valid_v1(value):
        return _diagnostic_failure_v1("noncanonical_diagnostic_manifest")
    DiagnosticManifestDecodeV1(ok: true, value: Some(value), error: "")

pub fn diagnostic_manifest_decode_v1(bytes: [u8]) -> DiagnosticManifestDecodeV1:
    diagnostic_manifest_decode_bounded_v1(bytes, three_payload_contract_max_items_v1())
