use compiler.common.cache_contract.errors_v1 (SummaryErrorV1)
use compiler.common.cache_contract.snapshot_contract_v1 (LogicalSourcePathV1)

pub enum SummaryVisibilityV1:
    PublicOnly

pub enum VirtualSourceKindV1:
    PublicSummary

pub struct SummaryAuthV1:
    root_digest: text
    session_digest: text
    capability_digest: text
    capability_admission_receipt: text
    request_epoch: i64
    expires_epoch: i64

pub struct SummaryLookupV1<T>:
    present: bool
    value: T?

pub struct VirtualSourceListEntryV1:
    uri: text
    logical_path: LogicalSourcePathV1
    content_digest: text

pub struct VirtualSourceListPageV1:
    snapshot_id: text
    logical_directory: text
    entries: [VirtualSourceListEntryV1]
    continuation: text?
    complete: bool
    page_digest: text

pub struct VirtualSourceStatV1:
    uri: text
    snapshot_id: text
    logical_path: LogicalSourcePathV1
    kind: VirtualSourceKindV1
    rendered_size: i64
    content_digest: text
    provenance: text
    visibility: SummaryVisibilityV1

pub struct VirtualSourceReadV1:
    uri: text
    snapshot_id: text
    offset: i64
    bytes: [u8]
    next_offset: i64?
    complete: bool
    content_digest: text
    provenance: text

pub struct SummaryPageV1:
    uri: text
    snapshot_id: text
    logical_path: LogicalSourcePathV1
    visibility: SummaryVisibilityV1
    provenance: text
    page_index: i64
    entries: [text]
    rendered_text: text
    continuation: text?
    complete: bool
    page_digest: text

pub trait VirtualSourceStoreV1:
    fn list(auth: SummaryAuthV1, snapshot: text, logical_directory: text, max_entries: i64, continuation: text?) -> Result<VirtualSourceListPageV1, SummaryErrorV1>
    fn stat(auth: SummaryAuthV1, snapshot: text, virtual_uri: text) -> Result<SummaryLookupV1<VirtualSourceStatV1>, SummaryErrorV1>
    fn read(auth: SummaryAuthV1, snapshot: text, virtual_uri: text, offset: i64, max_bytes: i64) -> Result<SummaryLookupV1<VirtualSourceReadV1>, SummaryErrorV1>
    fn page(auth: SummaryAuthV1, snapshot: text, virtual_uri: text, continuation: text?, max_bytes: i64, max_entries: i64) -> Result<SummaryLookupV1<SummaryPageV1>, SummaryErrorV1>
