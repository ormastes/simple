# Immutable projection of admitted inventory and phase-1 source receipts.
# This checks row correspondence, not the provenance of either input owner.
use compiler.common.cache.canonical_identity.{canonical_identity_text_lt}
use compiler.common.cache_contract.physical_tld_v1.{three_payload_contract_digest_valid_v1,
    three_payload_contract_max_items_v1}

pub struct DirectoryTldrSourceRowV2:
    path: text
    content_digest: text
    byte_count: i64

pub fn directory_tldr_source_rows_match_v2(expected: [DirectoryTldrSourceRowV2],
        held: [DirectoryTldrSourceRowV2]) -> bool:
    if expected.len() == 0 or expected.len() != held.len() or
            expected.len() > three_payload_contract_max_items_v1(): return false
    var previous = ""
    var index = 0
    while index < expected.len():
        val want = expected[index]
        val have = held[index]
        if want.path == "" or (index > 0 and not canonical_identity_text_lt(previous, want.path)) or
                not three_payload_contract_digest_valid_v1(want.content_digest) or want.byte_count < 0 or
                have.path != want.path or have.content_digest != want.content_digest or
                have.byte_count != want.byte_count: return false
        previous = want.path
        index = index + 1
    true
