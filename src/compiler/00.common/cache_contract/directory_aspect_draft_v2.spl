# Compact observations from a full parse, with explicit inventory coverage. These are draft facets, not final
# ABI/effect/capture authority. The HIR owner must resolve every handler before
# constructing a complete local aspect category root.
use compiler.common.cache_contract.directory_source_epoch_v2.{DirectorySourceEpochV2}
use compiler.common.cache_contract.directory_category_projection_v2.{DirectoryCategoryProjectionV2}

pub struct DirectoryAspectDeclarationV2:
    family: text
    # Index within this family inventory, never cross-family application order.
    family_inventory_index: i64
    handler: text
    form: text
    selector: text
    mode: text
    priority: i64
    readonly: bool
    noalloc: bool
    bounded_time: bool

pub struct DirectoryAspectDraftV2:
    epoch: DirectorySourceEpochV2
    source: DirectoryCategoryProjectionV2
    declarations: [DirectoryAspectDeclarationV2]
    parser_generation: i64
    coverage_schema: text
    inventory_complete: bool
    inventory_reason: text
