# Compile-local semantic observations. Publication still requires successful
# compiler validation and the current object/source/provider join.
use compiler.common.cache_contract.directory_aspect_draft_v2.{DirectoryAspectDeclarationV2}
use compiler.common.cache_contract.directory_category_projection_v2.{DirectoryCategoryProjectionV2}
use compiler.common.cache_contract.directory_source_epoch_v2.{DirectorySourceEpochV2}

pub struct DirectoryAspectHandlerV2:
    declaration: DirectoryAspectDeclarationV2
    signature_digest: text
    effects_digest: text

pub struct DirectoryAspectSemanticV2:
    source: DirectoryCategoryProjectionV2
    source_epoch: DirectorySourceEpochV2
    module_identity: text
    coverage_schema: text
    handlers: [DirectoryAspectHandlerV2]
    interface_digest: text

# Whole-object implementation observation, deliberately sensitive to unrelated
# code in the same object. This is not a canonical function-body digest.
pub struct DirectoryAspectObjectV2:
    semantic: DirectoryAspectSemanticV2
    object_digest: text
    capsule_identity_digest: text
    executing_image_digest: text
    implementation_digest: text
