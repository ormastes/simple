# Structural request contract for the live semantic-scope ports that do not yet
# exist.  These public copied values are inputs to future private owners; they
# are not receipts, grants, provider results, or authority.
use std.common.crypto.sha256.{sha256_text}

pub enum SemanticScopeLivePortKindV1:
    WriterAdmission
    PublicSummarySet
    PreparedAttempt
    SemanticContribution

pub struct SemanticScopeLiveIdentityV1:
    writer_instance_digest: text
    generation: i64
    manifest_digest: text
    pin_snapshot_digest: text
    generation_closure_digest: text
    binding_digest: text
    query_domain_digest: text
    semantic_rules_digest: text
    cancellation_epoch: i64

pub struct SemanticScopeWriterLiveRequestV1:
    identity: SemanticScopeLiveIdentityV1
    durable_binding_digest: text

pub struct SemanticScopeSummaryLiveRequestV1:
    identity: SemanticScopeLiveIdentityV1
    public_summary_set_digest: text
    summary_count: i64

pub struct SemanticScopeAttemptLiveRequestV1:
    identity: SemanticScopeLiveIdentityV1
    attempt_seal_digest: text
    source_content_digest: text
    snapshot_semantic_digest: text

pub struct SemanticScopeContributionLiveRequestV1:
    identity: SemanticScopeLiveIdentityV1
    dimension_index: i64
    contribution_digest: text
    issuer_instance_digest: text
    issuer_generation: i64
    authority_serial: i64

pub struct SemanticScopeLivePortRequirementV1:
    kind: SemanticScopeLivePortKindV1
    validation_operation: text
    required_receipts: i64

pub struct SemanticScopeLivePortPlanV1:
    version: i64
    requirements: [SemanticScopeLivePortRequirementV1]
    required_semantic_contributions: i64
    ordinary_source_reads: i64
    ordinary_prior_tld_min: i64
    ordinary_prior_tld_max: i64
    ordinary_initializer_reads: i64
    worker_external_reads: i64
    worker_reverse_reference_reads: i64
    reverse_reference_coordinator_only: bool
    authority_available: bool

pub fn semantic_scope_live_port_contract_version_v1() -> i64:
    1

pub fn semantic_scope_required_contributions_v1() -> i64:
    5

pub fn semantic_scope_live_port_plan_v1() -> SemanticScopeLivePortPlanV1:
    SemanticScopeLivePortPlanV1(
        version: semantic_scope_live_port_contract_version_v1(),
        requirements: [
            SemanticScopeLivePortRequirementV1(
                kind: SemanticScopeLivePortKindV1.WriterAdmission,
                validation_operation: "writer_validate_live_semantic_scope_v1",
                required_receipts: 1,
            ),
            SemanticScopeLivePortRequirementV1(
                kind: SemanticScopeLivePortKindV1.PublicSummarySet,
                validation_operation: "public_summary_validate_live_set_v1",
                required_receipts: 1,
            ),
            SemanticScopeLivePortRequirementV1(
                kind: SemanticScopeLivePortKindV1.PreparedAttempt,
                validation_operation: "prepared_attempt_validate_live_v1",
                required_receipts: 1,
            ),
            SemanticScopeLivePortRequirementV1(
                kind: SemanticScopeLivePortKindV1.SemanticContribution,
                validation_operation: "semantic_owner_validate_live_contribution_v1",
                required_receipts: semantic_scope_required_contributions_v1(),
            ),
        ],
        required_semantic_contributions: semantic_scope_required_contributions_v1(),
        ordinary_source_reads: 1,
        ordinary_prior_tld_min: 0,
        ordinary_prior_tld_max: 1,
        ordinary_initializer_reads: 1,
        worker_external_reads: 0,
        worker_reverse_reference_reads: 0,
        reverse_reference_coordinator_only: true,
        authority_available: false,
    )

pub fn semantic_scope_live_port_contract_available_v1() -> bool:
    false

pub fn semantic_scope_live_port_contract_blocker_v1() -> text:
    "writer_public_summary_attempt_and_five_semantic_contribution_owner_ports_unavailable"

pub fn semantic_scope_live_port_plan_valid_v1(plan: SemanticScopeLivePortPlanV1) -> bool:
    if plan.version != semantic_scope_live_port_contract_version_v1():
        return false
    if plan.requirements.len() != 4:
        return false
    if plan.requirements[0].kind != SemanticScopeLivePortKindV1.WriterAdmission:
        return false
    if plan.requirements[0].validation_operation != "writer_validate_live_semantic_scope_v1":
        return false
    if plan.requirements[0].required_receipts != 1:
        return false
    if plan.requirements[1].kind != SemanticScopeLivePortKindV1.PublicSummarySet:
        return false
    if plan.requirements[1].validation_operation != "public_summary_validate_live_set_v1":
        return false
    if plan.requirements[1].required_receipts != 1:
        return false
    if plan.requirements[2].kind != SemanticScopeLivePortKindV1.PreparedAttempt:
        return false
    if plan.requirements[2].validation_operation != "prepared_attempt_validate_live_v1":
        return false
    if plan.requirements[2].required_receipts != 1:
        return false
    if plan.requirements[3].kind != SemanticScopeLivePortKindV1.SemanticContribution:
        return false
    if plan.requirements[3].validation_operation != "semantic_owner_validate_live_contribution_v1":
        return false
    if plan.requirements[3].required_receipts != semantic_scope_required_contributions_v1():
        return false
    plan.required_semantic_contributions == semantic_scope_required_contributions_v1() and
        plan.ordinary_source_reads == 1 and
        plan.ordinary_prior_tld_min == 0 and
        plan.ordinary_prior_tld_max == 1 and
        plan.ordinary_initializer_reads == 1 and
        plan.worker_external_reads == 0 and
        plan.worker_reverse_reference_reads == 0 and
        plan.reverse_reference_coordinator_only and
        not plan.authority_available and
        not semantic_scope_live_port_contract_available_v1()

fn _semantic_scope_digest_valid_v1(value: text) -> bool:
    if value.len() != 64:
        return false
    for ch in value:
        val decimal = ch >= '0' and ch <= '9'
        val lower_hex = ch >= 'a' and ch <= 'f'
        if not decimal and not lower_hex:
            return false
    true

# V4 owner-returning boundaries keep mutation with the concrete owner while
# carrying only opaque, attempt-bound tokens across compiler layers.  These
# types do not make any production authority available.
pub enum L78BoundaryErrorV4:
    Unavailable
    InvalidRequest
    ForeignToken
    StaleToken
    ExpiredToken
    Bounds
    Incomplete
    Rejected
    Conflict
    Cancelled
    Unknown

pub enum L78AuthorityDomainV4:
    TestDouble
    Live

pub enum L78TokenKindV4:
    Scope
    AffectedDomain
    Namespace
    Closure
    Candidate
    Publication

pub struct L78AttemptKeyV4:
    root_digest: text
    generation: i64
    manifest_digest: text
    profile_digest: text
    operation_digest: text

pub struct L78OwnerTokenV4:
    domain: L78AuthorityDomainV4
    kind: L78TokenKindV4
    owner_instance: i64
    slot: i64
    epoch: i64
    attempt_digest: text

pub struct L78LimitsV4:
    max_items: i64
    max_bytes: i64
    max_steps: i64

pub struct L78OwnedResultV4<P, T>:
    owner: P
    outcome: Result<T, L78BoundaryErrorV4>

pub fn l78_attempt_key_digest_v4(
    key: L78AttemptKeyV4,
) -> Result<text, L78BoundaryErrorV4>:
    if (not _semantic_scope_digest_valid_v1(key.root_digest) or
            key.generation < 0 or
            not _semantic_scope_digest_valid_v1(key.manifest_digest) or
            not _semantic_scope_digest_valid_v1(key.profile_digest) or
            not _semantic_scope_digest_valid_v1(key.operation_digest)):
        return Err(L78BoundaryErrorV4.InvalidRequest)
    Ok(sha256_text("simple.l78.attempt.v4\n" + key.root_digest + "\n" +
        key.generation.to_string() + "\n" + key.manifest_digest + "\n" +
        key.profile_digest + "\n" + key.operation_digest + "\n"))

fn _semantic_scope_live_identity_valid_v1(identity: SemanticScopeLiveIdentityV1) -> bool:
    identity.generation >= 0 and
        identity.cancellation_epoch >= 0 and
        _semantic_scope_digest_valid_v1(identity.writer_instance_digest) and
        _semantic_scope_digest_valid_v1(identity.manifest_digest) and
        _semantic_scope_digest_valid_v1(identity.pin_snapshot_digest) and
        _semantic_scope_digest_valid_v1(identity.generation_closure_digest) and
        _semantic_scope_digest_valid_v1(identity.binding_digest) and
        _semantic_scope_digest_valid_v1(identity.query_domain_digest) and
        _semantic_scope_digest_valid_v1(identity.semantic_rules_digest)

fn _semantic_scope_live_identity_equal_v1(
    left: SemanticScopeLiveIdentityV1,
    right: SemanticScopeLiveIdentityV1,
) -> bool:
    left.writer_instance_digest == right.writer_instance_digest and
        left.generation == right.generation and
        left.manifest_digest == right.manifest_digest and
        left.pin_snapshot_digest == right.pin_snapshot_digest and
        left.generation_closure_digest == right.generation_closure_digest and
        left.binding_digest == right.binding_digest and
        left.query_domain_digest == right.query_domain_digest and
        left.semantic_rules_digest == right.semantic_rules_digest and
        left.cancellation_epoch == right.cancellation_epoch

pub fn semantic_scope_live_requests_coherent_v1(
    writer: SemanticScopeWriterLiveRequestV1,
    summary: SemanticScopeSummaryLiveRequestV1,
    attempt: SemanticScopeAttemptLiveRequestV1,
    contributions: [SemanticScopeContributionLiveRequestV1],
) -> bool:
    if not _semantic_scope_live_identity_valid_v1(writer.identity):
        return false
    if not _semantic_scope_digest_valid_v1(writer.durable_binding_digest):
        return false
    if not _semantic_scope_live_identity_equal_v1(writer.identity, summary.identity):
        return false
    if not _semantic_scope_live_identity_equal_v1(writer.identity, attempt.identity):
        return false
    if not _semantic_scope_digest_valid_v1(summary.public_summary_set_digest):
        return false
    if summary.summary_count < 0:
        return false
    if not _semantic_scope_digest_valid_v1(attempt.attempt_seal_digest):
        return false
    if not _semantic_scope_digest_valid_v1(attempt.source_content_digest):
        return false
    if not _semantic_scope_digest_valid_v1(attempt.snapshot_semantic_digest):
        return false
    if contributions.len() != semantic_scope_required_contributions_v1():
        return false
    for index in 0..contributions.len():
        val contribution = contributions[index]
        if not _semantic_scope_live_identity_equal_v1(writer.identity, contribution.identity):
            return false
        if contribution.dimension_index != index:
            return false
        if not _semantic_scope_digest_valid_v1(contribution.contribution_digest):
            return false
        if not _semantic_scope_digest_valid_v1(contribution.issuer_instance_digest):
            return false
        if contribution.issuer_generation < 0 or contribution.authority_serial <= 0:
            return false
    true
