# Compile-local lexical binder coordinates, not persisted SymbolIds or authority.
# scope_depth is relative to the declaration being projected: its innermost
# generic scope is 0, its enclosing generic scope is 1, and so on. index is
# declaration order inside that scope. Array/traversal order has no meaning.
pub struct GenericTypeBinderV2:
    symbol_id: i64
    source_name: text
    scope_depth: i64
    index: i64
    kind: text

pub fn generic_type_binders_valid_v2(values: [GenericTypeBinderV2]) -> bool:
    if values.len() > 1024: return false
    var ids: Dict<i64, bool> = {}
    var coordinates: Dict<text, bool> = {}
    var names: Dict<text, bool> = {}
    var bytes: i64 = 0
    for value in values:
        if value.symbol_id < 0 or value.source_name == "" or value.scope_depth < 0 or value.scope_depth > 32 or value.index < 0 or value.index >= 1024: return false
        if value.kind != "type" and value.kind != "const": return false
        bytes = bytes + value.source_name.byte_len()
        if bytes > 65536: return false
        val coordinate = "{value.scope_depth}:{value.index}"
        val scoped_name = "{value.scope_depth}:" + value.source_name
        if ids.contains_key(value.symbol_id) or coordinates.contains_key(coordinate) or names.contains_key(scoped_name): return false
        ids[value.symbol_id] = true
        coordinates[coordinate] = true
        names[scoped_name] = true
    true
