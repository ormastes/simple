# The cache envelope and HIR body share a line protocol. Keep their boundary
# in the typed FlatPoolReader; native inferred text offsets may be tagged, so
# no raw index_of cursor crosses this boundary. The entry frame is
#   header LF "C " checksum LF "W" LF count LF escaped-warning LF ... blob
# where the checksum covers every byte after the checksum line. The checksum
# VALUE stays with the driver (hir_cache_body_checksum owns the sha256
# fallback note), so this module never imports the cache owner and the "C "
# prefix is mirrored below instead.
# Design: doc/05_design/hir_cache_envelope_reader.md
use compiler.frontend.core.flat_pool_codec.{FlatPoolReader, flat_pool_unescape}

# Mirrors HIR_CACHE_CHECKSUM_PREFIX in driver_hir_cache.spl, which is exported
# for its specs; duplicated here so this leaf stays importable without a
# cycle with its cache owner.
val HIR_CACHE_ENVELOPE_CHECKSUM_PREFIX: text = "C "

# One parsed frame. `reason` is "" when the frame is intact; otherwise one of
# header / checksum / framing, matching HIR_CACHE_REJECT_REASONS so the cache
# can count every rejection by class. `checksum` (the hex digest) and
# `covered` are populated as soon as the checksum line shape is valid, before
# framing, so the caller can verify the checksum value before trusting the
# framing verdict.
pub struct HirCacheEnvelope:
    reason: text
    checksum: text
    covered: text
    warnings: [text]
    body: text
    parser_classification: text = ""

pub fn hir_cache_parser_record_valid_v1(record: text) -> bool:
    val prefix = if record.starts_with("objectless:"): "objectless:" elif record.starts_with("bodyful:"): "bodyful:" else: ""
    if prefix == "" or record.len() != prefix.len() + 64: return false
    for digit in record[prefix.len():]:
        if not ((digit >= "0" and digit <= "9") or (digit >= "a" and digit <= "f")): return false
    true

fn _hir_cache_envelope_rejected(reason: text) -> HirCacheEnvelope:
    HirCacheEnvelope(reason: reason, checksum: "", covered: "",
        warnings: [], body: "")

fn _hir_cache_envelope_framing(checksum: text, covered: text) -> HirCacheEnvelope:
    HirCacheEnvelope(reason: "framing", checksum: checksum, covered: covered,
        warnings: [], body: "")

fn _hir_cache_envelope_open(raw: text) -> FlatPoolReader:
    # The same direct construction as FlatPoolReader.new_canonical (the
    # sibling-factory MIR workaround lives there), without its upfront
    # missing-final-newline latch: a frame whose bytes are merely missing the
    # terminal newline must still reach the checksum comparison so a truncated
    # body classifies as `checksum` and a shape-valid frame as `framing`,
    # never the reverse. The split/join identity check below is the
    # fail-closed provider contract instead.
    FlatPoolReader(lines: raw.split("\n"), pos: 0, ok: true,
        bounded: false, canonical: true, failure_kind: "", failure_detail: "",
        max_allocation_bytes: 0, max_nodes: 0, max_depth: 0,
        max_work_units: 0, live_reserved_bytes: 0, entered_nodes: 0,
        current_depth: 0, maximum_depth: 0, charged_work_units: 0,
        audit_events: 0)

# Pure: raw file content -> classified frame. Never repairs, normalizes or
# re-serializes a field; every terminal empty field is preserved.
pub fn hir_cache_envelope_parse(raw: text, expected_header: text) -> HirCacheEnvelope:
    var reader: FlatPoolReader = _hir_cache_envelope_open(raw)
    # A provider that drops split fields must fail closed. Identity holds for
    # any well-formed split (join is the exact inverse), so a mismatch means
    # the provider lost bytes and no parse below can be trusted.
    if reader.lines.join("\n") != raw:
        return _hir_cache_envelope_rejected("checksum")
    if reader.next() != expected_header:
        return _hir_cache_envelope_rejected("header")
    val checksum_line = reader.next()
    if (not reader.ok or not checksum_line.starts_with(HIR_CACHE_ENVELOPE_CHECKSUM_PREFIX) or
            checksum_line.len() != HIR_CACHE_ENVELOPE_CHECKSUM_PREFIX.len() + 64):
        return _hir_cache_envelope_rejected("checksum")
    val checksum = checksum_line.substring(HIR_CACHE_ENVELOPE_CHECKSUM_PREFIX.len(),
        checksum_line.len())
    # The exact bytes the checksum covers: every line after the checksum
    # line, joined with LF. Given the identity check above, this is
    # byte-identical to the file's post-checksum suffix.
    var covered_lines: [text] = []
    var covered_index: i64 = reader.pos
    while covered_index < reader.lines.len():
        covered_lines.push(reader.lines[covered_index])
        covered_index = covered_index + 1
    val covered = covered_lines.join("\n")
    # Re-open the cursor over the covered bytes for the framing parse.
    reader = _hir_cache_envelope_open(covered)
    var parser_classification = ""
    if expected_header.starts_with("spl-hircache-v4-parser "):
        if reader.next() != "P": return _hir_cache_envelope_framing(checksum, covered)
        parser_classification = reader.next()
        if not hir_cache_parser_record_valid_v1(parser_classification):
            return _hir_cache_envelope_framing(checksum, covered)
    if reader.next() != "W":
        return _hir_cache_envelope_framing(checksum, covered)
    val warning_count: i64 = reader.next_len()
    if not reader.ok:
        return _hir_cache_envelope_framing(checksum, covered)
    var warnings: [text] = []
    var warning_index: i64 = 0
    while warning_index < warning_count:
        warnings.push(flat_pool_unescape(reader.next()))
        warning_index = warning_index + 1
    if not reader.ok:
        return _hir_cache_envelope_framing(checksum, covered)
    # Keep the exact suffix: HIR owns validation of its header and trailing
    # bytes. No body field is unescaped, trimmed, filtered or re-serialized.
    var body_lines: [text] = []
    while reader.pos < reader.lines.len():
        body_lines.push(reader.next())
    val body = body_lines.join("\n")
    if not reader.ok or body == "":
        return _hir_cache_envelope_framing(checksum, covered)
    HirCacheEnvelope(reason: "", checksum: checksum, covered: covered,
        warnings: warnings, body: body, parser_classification: parser_classification)

# Strict admission view: nil for any rejected frame, the envelope when intact.
pub fn hir_cache_decode_envelope(raw: text, expected_header: text) -> HirCacheEnvelope?:
    val parsed = hir_cache_envelope_parse(raw, expected_header)
    if parsed.reason != "":
        return nil
    Some(parsed)
