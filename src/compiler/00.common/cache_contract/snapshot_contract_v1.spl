pub enum PathSemanticsV1:
    CaseSensitiveNfc
    CaseFoldedNfc

pub struct LogicalSourcePathV1:
    repository_namespace_digest: text
    module_relative_utf8: text
    path_semantics: PathSemanticsV1

pub struct SnapshotSourceEntryV1:
    logical_path: LogicalSourcePathV1
    source_blob_digest: text

pub enum SourceEncodingPolicyV1:
    Utf8Exact

pub struct GeneratedProvenanceV1:
    producer_digest: text
    input_manifest_digest: text

pub struct SourceBlobV1:
    logical_path: LogicalSourcePathV1
    source_bytes: [u8]
    source_digest: text
    encoding_policy: SourceEncodingPolicyV1
    generated_provenance: GeneratedProvenanceV1?

pub struct ResolutionCandidateV1:
    order: i64
    logical_path: text
    normalization_key: text
    physical_identity_digest: text
    parent_directory_generation_digest: text
    entry_kind: text
    exists: bool
    selected: bool
    content_digest: text
    symlink_chain_digest: text

pub struct ResolutionWitnessV1:
    resolver_policy_digest: text
    root_trust_digest: text
    candidates: [ResolutionCandidateV1]
    selected_index: i64
    generated_input_digests: [text]
    witness_digest: text

pub struct NegativeCandidateV1:
    anchor: LogicalSourcePathV1
    logical_candidate: LogicalSourcePathV1
    absence_witness_digest: text

pub struct DirectoryGenerationV1:
    anchor_logical_path: LogicalSourcePathV1
    stable_generation_digest: text

pub struct GeneratedInputV1:
    logical_path: LogicalSourcePathV1
    producer_digest: text
    input_manifest_digest: text

pub struct NamedDigestV1:
    name: text
    digest: text

pub struct CompileSnapshotV1:
    schema: i64
    repository_namespace_digest: text
    path_policy_digest: text
    source_entries: [SnapshotSourceEntryV1]
    resolution_witnesses: [ResolutionWitnessV1]
    negative_candidates: [NegativeCandidateV1]
    directory_generations: [DirectoryGenerationV1]
    generated_inputs: [GeneratedInputV1]
    configuration_digest: text
    target_layout_digest: text
    compiler_owner_digest: text
    runtime_digest: text
    provider_manifests: [NamedDigestV1]
    toolchain_component_digests: [NamedDigestV1]

fn _lower_hex_digest_valid_v1(value: text) -> bool:
    if value.len() != 64: return false
    var i = 0
    while i < value.len():
        val code = value.char_code_at(i)
        if not ((code >= 48 and code <= 57) or (code >= 97 and code <= 102)):
            return false
        i = i + 1
    true

pub fn logical_source_path_valid_v1(path: LogicalSourcePathV1) -> bool:
    if not _lower_hex_digest_valid_v1(path.repository_namespace_digest): return false
    val value = path.module_relative_utf8
    if value == "" or value.starts_with("/") or value.ends_with("/"):
        return false
    if value.contains("\\") or value.contains("\u0000") or value.contains("//"):
        return false
    for segment in value.split("/"):
        if segment == "" or segment == "." or segment == "..":
            return false
    true
