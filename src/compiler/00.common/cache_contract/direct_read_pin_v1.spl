pub struct DirectReadPinV1:
    pin_id: text
    process_instance_nonce: text
    boot_identity_digest: text
    reader_admission_epoch: i64
    journal_superblock_generation: i64
    pinned_manifest_digest: text
    created_monotonic: i64
    expires_monotonic: i64
    namespace_entry_digest: text

pub fn direct_read_pin_time_valid_v1(pin: DirectReadPinV1) -> bool:
    pin.created_monotonic >= 0 and pin.expires_monotonic > pin.created_monotonic
