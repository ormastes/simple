# Compile-local partial category projection. This is not a PackageInit record,
# complete directory inventory, or compiler-provider authorization token.
use compiler.common.cache_contract.physical_tld_v1.{three_payload_contract_digest_valid_v1}

pub struct DirectoryCategoryProjectionV2:
    canonical_path: text
    source_identity: text
    source_digest: text
    target_triple: text
    preprocessed_digest: text
    cfg_decision_digest: text
    environment_policy_digest: text
    trait_root: text
    extension_root: text

# Structural validation only; the parse owner establishes provenance.
pub fn directory_category_projection_valid_v2(value: DirectoryCategoryProjectionV2) -> bool:
    value.canonical_path != "" and value.source_identity != "" and value.target_triple != "" and
        three_payload_contract_digest_valid_v1(value.source_digest) and
        three_payload_contract_digest_valid_v1(value.preprocessed_digest) and
        three_payload_contract_digest_valid_v1(value.cfg_decision_digest) and
        three_payload_contract_digest_valid_v1(value.environment_policy_digest) and
        three_payload_contract_digest_valid_v1(value.trait_root) and
        three_payload_contract_digest_valid_v1(value.extension_root)
