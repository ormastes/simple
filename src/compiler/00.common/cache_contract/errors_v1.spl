pub enum CacheErrorCodeV1:
    CacheUnavailable
    CacheTransportTimeout
    CacheProtocolMismatch
    CacheAccessDenied
    CacheBoundsExceeded
    CacheCorrupt
    CacheWriterEpochStale
    CacheJournalTailQuarantined
    CacheSpoolReconcileFailed
    CacheNondeterminism
    CachePinExpired
    CachePinRenewalFailed

pub enum SummaryErrorCodeV1:
    SummarySnapshotMismatch
    SummaryAccessDenied
    SummaryTokenInvalid
    SummaryTokenExpired
    SummaryBoundsExceeded
    SummaryCorrupt
    SummarySchemaMismatch
    VirtualSourceRequestInvalid

pub enum ProviderErrorCodeV1:
    ProviderAdmissionRejected

pub enum SnapshotErrorCodeV1:
    SourceSnapshotUnstable
    AmbientReadUncacheable

pub enum RetryClassV1:
    Never
    BoundedOnce
    AfterStateChange

pub enum ErrorSeverityV1:
    Info
    Warning
    Error
    Fatal

pub struct RejectTelemetryV1:
    reason_digest: text
    bounded_detail: text

pub struct CacheErrorV1:
    code: CacheErrorCodeV1
    retry: RetryClassV1
    severity: ErrorSeverityV1
    reject: RejectTelemetryV1

pub struct SummaryErrorV1:
    code: SummaryErrorCodeV1
    retry: RetryClassV1
    severity: ErrorSeverityV1
    reject: RejectTelemetryV1

pub struct ProviderErrorV1:
    code: ProviderErrorCodeV1
    retry: RetryClassV1
    severity: ErrorSeverityV1
    reject: RejectTelemetryV1

pub struct SnapshotErrorV1:
    code: SnapshotErrorCodeV1
    retry: RetryClassV1
    severity: ErrorSeverityV1
    reject: RejectTelemetryV1
