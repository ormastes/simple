pub enum CacheErrorCodeV1:
    CacheUnavailable
    CacheTransportTimeout
    CacheProtocolMismatch
    CacheAccessDenied
    CacheBoundsExceeded
    CacheCorrupt
    CacheWriterEpochStale
    CacheJournalTailQuarantined
    CacheSpoolReconcileFailed
    CacheNondeterminism
    CachePinExpired
    CachePinRenewalFailed

pub enum SummaryErrorCodeV1:
    SummarySnapshotMismatch
    SummaryAccessDenied
    SummaryTokenInvalid
    SummaryTokenExpired
    SummaryBoundsExceeded
    SummaryCorrupt
    SummarySchemaMismatch
    VirtualSourceRequestInvalid

pub enum ProviderErrorCodeV1:
    ProviderAdmissionRejected

pub enum SnapshotErrorCodeV1:
    SourceSnapshotUnstable
    AmbientReadUncacheable

pub enum RetryClassV1:
    Never
    BoundedOnce
    AfterStateChange
    NewOwnerOnly
    RecoveryOnly
    NewGenerationReadOnly
    NewTokenOnce
    NewSnapshotOnly
    AfterDeclaredInputChange
    AfterProviderChange

pub enum ErrorSeverityV1:
    Info
    Warning
    Error
    Fatal

pub struct RejectTelemetryV1:
    telemetry_class: text
    safe_context: text
    reason_digest: text
    bounded_detail: text

pub fn cache_error_telemetry_class_v1(code: CacheErrorCodeV1) -> text:
    match code:
        case CacheErrorCodeV1.CacheUnavailable: "availability_fallback"
        case CacheErrorCodeV1.CacheTransportTimeout: "availability_fallback"
        case CacheErrorCodeV1.CacheProtocolMismatch: "protocol_security"
        case CacheErrorCodeV1.CacheAccessDenied: "protocol_security"
        case CacheErrorCodeV1.CacheBoundsExceeded: "validation_reject"
        case CacheErrorCodeV1.CacheCorrupt: "security_integrity"
        case CacheErrorCodeV1.CacheWriterEpochStale: "writer_authority"
        case CacheErrorCodeV1.CacheJournalTailQuarantined: "persistence_integrity"
        case CacheErrorCodeV1.CacheSpoolReconcileFailed: "writer_authority"
        case CacheErrorCodeV1.CacheNondeterminism: "security_integrity"
        case CacheErrorCodeV1.CachePinExpired: "reader_safety"
        case CacheErrorCodeV1.CachePinRenewalFailed: "reader_safety"

pub fn cache_error_safe_context_v1(code: CacheErrorCodeV1) -> text:
    match code:
        case CacheErrorCodeV1.CacheUnavailable: "cache unavailable; direct fallback selected"
        case CacheErrorCodeV1.CacheTransportTimeout: "cache transport exceeded bounded deadline"
        case CacheErrorCodeV1.CacheProtocolMismatch: "cache protocol admission rejected"
        case CacheErrorCodeV1.CacheAccessDenied: "cache peer authorization rejected"
        case CacheErrorCodeV1.CacheBoundsExceeded: "cache request exceeded declared bounds"
        case CacheErrorCodeV1.CacheCorrupt: "cache object integrity verification failed"
        case CacheErrorCodeV1.CacheWriterEpochStale: "cache writer authority is stale"
        case CacheErrorCodeV1.CacheJournalTailQuarantined: "cache journal tail was quarantined"
        case CacheErrorCodeV1.CacheSpoolReconcileFailed: "cache spool reconciliation failed"
        case CacheErrorCodeV1.CacheNondeterminism: "cache output identity diverged"
        case CacheErrorCodeV1.CachePinExpired: "cache read pin expired"
        case CacheErrorCodeV1.CachePinRenewalFailed: "cache read pin renewal failed"

pub fn cache_error_telemetry_valid_v1(error: CacheErrorV1) -> bool:
    error.reject.telemetry_class == cache_error_telemetry_class_v1(error.code) and
        error.reject.safe_context == cache_error_safe_context_v1(error.code) and
        error.reject.bounded_detail.len() <= 256

pub struct CacheErrorV1:
    code: CacheErrorCodeV1
    retry: RetryClassV1
    severity: ErrorSeverityV1
    reject: RejectTelemetryV1

pub struct SummaryErrorV1:
    code: SummaryErrorCodeV1
    retry: RetryClassV1
    severity: ErrorSeverityV1
    reject: RejectTelemetryV1

pub struct ProviderErrorV1:
    code: ProviderErrorCodeV1
    retry: RetryClassV1
    severity: ErrorSeverityV1
    reject: RejectTelemetryV1

pub struct SnapshotErrorV1:
    code: SnapshotErrorCodeV1
    retry: RetryClassV1
    severity: ErrorSeverityV1
    reject: RejectTelemetryV1
