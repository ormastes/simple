# Compatibility gateway installer for the process-local virtual-summary read
# registry. Request handlers should import virtual_source_read_registry_v1 so
# they do not pull cache gateway and reader-pin ownership into their closure.

use compiler.common.cache_contract.cache_gateway_v1 (CacheGatewayV1)
use compiler.common.cache_contract.virtual_source_store_v1 (SummaryAuthV1)
use compiler.common.cache_contract.virtual_source_read_registry_v1 (install_virtual_source_consumers_v1)
export use compiler.common.cache_contract.virtual_source_read_registry_v1.*

pub fn install_virtual_source_consumers_from_gateway_v1(gateway: CacheGatewayV1, auth: SummaryAuthV1, snapshot: text):
    install_virtual_source_consumers_v1(gateway.virtual_source_store(), auth, snapshot)
