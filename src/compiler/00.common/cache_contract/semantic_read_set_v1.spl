pub enum SemanticEffectKindV1:
    Source
    GeneratedSource
    MacroCtfeInput
    EnvironmentFacade
    ClockFacade
    RandomnessFacade
    NetworkFacade
    ProcessFacade
    Plugin
    ToolchainComponent

pub enum SemanticReplayPolicyV1:
    DeclaredReplayable
    UndeclaredUncacheable

pub struct SemanticReadEntryV1:
    effect_kind: SemanticEffectKindV1
    logical_name: text
    provider_id: text
    provider_manifest_digest: text
    value_digest: text
    replay_policy: SemanticReplayPolicyV1

pub struct SemanticReadSetV1:
    entries: [SemanticReadEntryV1]
    uncacheable_reason: text
