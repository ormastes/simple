pub struct ReaderAdmissionEpochV1:
    value: i64
    checksum_digest: text

pub fn reader_admission_epoch_admits_v1(epoch: ReaderAdmissionEpochV1) -> bool:
    epoch.value >= 0 and epoch.value % 2 == 0

pub fn reader_admission_epoch_gc_closed_v1(epoch: ReaderAdmissionEpochV1) -> bool:
    epoch.value >= 0 and epoch.value % 2 == 1
