# Copied diagnostic observations. Public values never grant semantic authority.
use compiler.common.cache_contract.semantic_query_read_manifest_v1.{SemanticQueryReadManifestV1}

pub struct RetainedSourceInputV1:
    path: text
    module_name: text
    source_digest: text

pub struct RetainedSourceTraversalSubjectV1:
    driver_identity: i64
    traversal_generation: i64
    native_target: text
    selected_frontend_context_digest: text
    sources: [RetainedSourceInputV1]
    subject_digest: text

pub struct RetainedSourceParseObservationV1:
    source_index: i64
    function_names: [text]

pub struct RetainedSourceTraversalProjectionV1:
    subject: RetainedSourceTraversalSubjectV1
    query_reads: SemanticQueryReadManifestV1
    observations: [RetainedSourceParseObservationV1]
    semantic_authorized: bool
