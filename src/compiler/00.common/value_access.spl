# Canonical compiler access to the runtime enum/tuple value representation.
#
# Compiler product code must use these typed accessors instead of binding the
# representation ABI directly.  Keeping the three existing runtime operations
# here gives the boundary one owner and prevents call sites from spreading raw
# i64 payload assumptions.  These wrappers are deliberately allocation-free and
# inline so MIR expression dispatch keeps its existing hot-path cost.

@runtime_intrinsics

extern fn rt_enum_discriminant(value: Any) -> i64
extern fn rt_enum_payload(value: Any) -> i64
extern fn rt_tuple_get<TElement>(tuple: i64, index: i64) -> TElement

@inline
fn compiler_value_discriminant<TEnum>(value: TEnum) -> i64:
    rt_enum_discriminant(value)

@inline
fn compiler_value_payload<TEnum>(value: TEnum) -> i64:
    rt_enum_payload(value)

@inline
fn compiler_value_tuple_at<TElement>(payload: i64, index: i64) -> TElement:
    rt_tuple_get<TElement>(payload, index)
