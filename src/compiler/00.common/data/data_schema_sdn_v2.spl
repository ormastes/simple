# Frozen V2 API: nominal syntax is normalized by the shared versioned SDN owner.
use compiler.common.data.data_schema_contracts.*
use compiler.common.data.data_schema_contracts_v2.*
use compiler.common.data.data_schema_sdn_common_v1.{data_schema_sdn_decode_v1}

pub fn data_schema_decls_from_sdn_v2(source: text, path: text, owner: text) -> Result<DataSchemaInputV2, [DataSchemaDiagnosticV1]>:
    val input = data_schema_sdn_decode_v1(source, path, owner, DATA_SCHEMA_INPUT_VERSION_V2, true)?
    var decls: [DataAttrDeclV2] = []
    for attr in input.decls:
        decls.push(DataAttrDeclV2(base: data_attr_decl_v1(attr.tree, attr.view, attr.name,
            data_type_ref_v1(attr.type_source, attr.args), attr.requiredness, attr.default_value,
            attr.provenance), property: attr.property))
    Ok(DataSchemaInputV2(views: input.views, decls: decls))
