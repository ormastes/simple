# V3 config retains a full UNBOUND language type expression. The authorized
# frontend/type owner must bind it before constructing DataAttrDeclV3.
use compiler.common.data.data_schema_contracts.*
use compiler.common.data.data_schema_contracts_v3.*
use compiler.common.data.data_schema_sdn_common_v1.{data_schema_sdn_decode_v1}
use compiler.common.data.data_schema_property_resolver_v1.{data_schema_invalid_v2}

pub fn data_schema_unbound_from_sdn_v3(source: text, path: text, owner: text) -> Result<DataSchemaUnboundInputV3, [DataSchemaDiagnosticV1]>:
    val input = data_schema_sdn_decode_v1(source, path, owner, DATA_SCHEMA_INPUT_VERSION_V3, false)?
    var decls: [DataSchemaUnboundAttrV3] = []
    for attr in input.decls:
        if attr.type_source.byte_len() > 65536:
            return Err([data_schema_invalid_v2(attr.name, attr.provenance, "unbound type expression exceeds 64 KiB")])
        decls.push(DataSchemaUnboundAttrV3(tree: attr.tree, view: attr.view, name: attr.name,
            type_source: attr.type_source, requiredness: attr.requiredness,
            default_value: attr.default_value, provenance: attr.provenance, property: attr.property))
    Ok(DataSchemaUnboundInputV3(views: input.views, decls: decls))
