# Node attribute store over the node attribute placements (data plan W3b, plan P4).
#
# One typed read/write/presence/retire API for a node attribute whose value lives
# embedded on the main node (an owner delegate), in a dense column indexed
# implicitly by node id, in a compact side array whose slot index the node holds
# (array_index), or in a sparse hash keyed by node id. The placement is a storage
# token (`direct` | `column` | `array_index` | `sparse_hash`) resolved ONCE at
# construction by the W1 rule resolver (`data_attr_storage_resolve_v1`); an access
# switches on the `AttrPlacementV1` enum tag only, never on a string.
# `array_ptr` / `hash_ptr` (node holds a pointer to an array slot / hash entry)
# resolve as tokens but fail fast at construction: safe Simple has no element
# reference that stays valid across side-array growth or hash rehash.
# Default OFF: nothing in the compiler builds a store unless a rule or tag
# selects it, and the owner arrays are untouched. Concurrency model: a store is
# owned by one writer per (phase, module); readers share frozen snapshots (see
# phase_cell_*_v1).

use compiler.common.data.data_schema_contracts.*
use compiler.common.data.data_schema_resolver.*

enum AttrPlacementV1:
    Embedded
    Column
    SparseHash
    ArrayIndex
    ArrayPointer
    HashPointer

# Data layout of a multi-field side array: one interleaved array (AoS) or one
# array per field (SoA). Applies to column and array_index only.
enum AttrLayoutV1:
    Aos
    Soa

# The node's own field(s): the store delegates to the owner and keeps no copy.
trait AttrOwnerV1<T>:
    fn owner_read(node: i64) -> T?
    me owner_write(node: i64, value: T?)

# Node-held slot index for a detached array_index store (stands in for the
# node's index field when the caller supplies none).
class AttrIndexCellsV1:
    cells: [i64?]

impl AttrIndexCellsV1:
    static fn create() -> AttrIndexCellsV1:
        AttrIndexCellsV1(cells: [])

impl AttrOwnerV1<i64> for AttrIndexCellsV1:
    fn owner_read(node: i64) -> i64?:
        if node < 0 or node >= self.cells.len():
            return None
        self.cells[node]
    me owner_write(node: i64, value: i64?):
        while self.cells.len() <= node:
            self.cells = self.cells.push(None)
        self.cells[node] = value

class AttributeStoreV1<T>:
    attr: text
    placement: AttrPlacementV1
    owner: AttrOwnerV1<T>?
    slots: [T?]
    present: i64
    hash: Dict<i64, T>
    index_owner: AttrOwnerV1<i64>?
    free: [i64]

fn attr_is_embed_token_v1(token: text) -> bool:
    token == "direct" or token == "embed" or token == "embedded"

pub fn attr_placement_from_token_v1(token: text) -> Result<AttrPlacementV1, text>:
    if attr_is_embed_token_v1(token):
        return Ok(AttrPlacementV1.Embedded)
    if token == "column":
        return Ok(AttrPlacementV1.Column)
    if token == "sparse_hash":
        return Ok(AttrPlacementV1.SparseHash)
    if token == "array_index":
        return Ok(AttrPlacementV1.ArrayIndex)
    if token == "array_ptr":
        return Ok(AttrPlacementV1.ArrayPointer)
    if token == "hash_ptr":
        return Ok(AttrPlacementV1.HashPointer)
    Err("unknown attribute storage token '{token}' (expected direct, embed, column, array_index, sparse_hash, array_ptr or hash_ptr)")

pub fn attr_placement_token_v1(placement: AttrPlacementV1) -> text:
    match placement:
        case Embedded: "direct"
        case Column: "column"
        case SparseHash: "sparse_hash"
        case ArrayIndex: "array_index"
        case ArrayPointer: "array_ptr"
        case HashPointer: "hash_ptr"

# Empty token = SoA, the layout every single-field column already has.
pub fn attr_layout_from_token_v1(token: text) -> Result<AttrLayoutV1, text>:
    if token == "soa" or token == "":
        return Ok(AttrLayoutV1.Soa)
    if token == "aos":
        return Ok(AttrLayoutV1.Aos)
    Err("unknown attribute data layout '{token}' (expected aos or soa)")

pub fn attr_layout_token_v1(layout: AttrLayoutV1) -> text:
    match layout:
        case Aos: "aos"
        case Soa: "soa"

# TODO(node-attr-pointer-layouts): back array_ptr / hash_ptr once safe Simple has a
# stable element reference across side-array growth and hash rehash.
fn attr_pointer_unsupported_v1(attr: text, placement: AttrPlacementV1) -> text:
    "attribute {attr}: {attr_placement_token_v1(placement)} is unsupported: no safe element reference survives side-array growth or hash rehash (use array_index or sparse_hash)"

impl AttributeStoreV1<T>:
    fn placement_token() -> text:
        attr_placement_token_v1(self.placement)

    # Slot held by the node for array_index; -1 when the node holds none.
    fn slot_of(node: i64) -> i64:
        match self.index_owner:
            case Some(ix):
                match ix.owner_read(node):
                    case Some(s): return s
                    case None: pass
            case None: pass
        -1

    # Side-array length for array_index (live + free slots).
    fn side_slots() -> i64:
        self.slots.len()

    fn has(node: i64) -> bool:
        match self.placement:
            case Embedded:
                if val o = self.owner:
                    if val _v = o.owner_read(node):
                        return true
                return false
            case Column:
                if node >= 0 and node < self.slots.len():
                    if val _v = self.slots[node]:
                        return true
                return false
            case SparseHash:
                return self.hash.contains_key(node)
            case ArrayIndex:
                return self.slot_of(node) >= 0
            case _:
                return false

    fn get(node: i64) -> Result<T, text>:
        match self.placement:
            case Embedded:
                match self.owner:
                    case Some(o):
                        match o.owner_read(node):
                            case Some(v): return Ok(v)
                            case None: pass
                    case None: pass
            case Column:
                if node >= 0 and node < self.slots.len():
                    match self.slots[node]:
                        case Some(v): return Ok(v)
                        case None: pass
            case SparseHash:
                if self.hash.contains_key(node):
                    return Ok(self.hash[node])
            case ArrayIndex:
                val s = self.slot_of(node)
                if s >= 0:
                    match self.slots[s]:
                        case Some(v): return Ok(v)
                        case None: pass
            case _: pass
        Err("absent: no {self.attr} entry for node {node}")

    me set(node: i64, value: T) -> Result<bool, text>:
        if node < 0:
            return Err("attribute {self.attr}: negative node id {node}")
        match self.placement:
            case Embedded:
                match self.owner:
                    case Some(o):
                        val fresh = not self.has(node)
                        o.owner_write(node, Some(value))
                        if fresh:
                            self.present = self.present + 1
                    case None: return Err("attribute {self.attr}: embedded placement has no owner")
            case Column:
                while self.slots.len() <= node:
                    self.slots = self.slots.push(None)
                if not self.has(node):
                    self.present = self.present + 1
                self.slots[node] = Some(value)
            case SparseHash:
                self.hash[node] = value
            case ArrayIndex:
                val held = self.slot_of(node)
                if held >= 0:
                    self.slots[held] = Some(value)
                    return Ok(true)
                var s = self.slots.len()
                if self.free.len() > 0:
                    s = self.free[self.free.len() - 1]
                    val _f = self.free.pop()
                    self.slots[s] = Some(value)
                else:
                    self.slots = self.slots.push(Some(value))
                match self.index_owner:
                    case Some(ix): ix.owner_write(node, Some(s))
                    case None: return Err("attribute {self.attr}: array_index placement has no index owner")
                self.present = self.present + 1
            case _: return Err(attr_pointer_unsupported_v1(self.attr, self.placement))
        Ok(true)

    # Retire an entry (node freed or attribute cleared). True when it was present.
    me retire(node: i64) -> bool:
        if not self.has(node):
            return false
        match self.placement:
            case Embedded:
                match self.owner:
                    case Some(o): o.owner_write(node, None)
                    case None: pass
                self.present = self.present - 1
            case Column:
                self.slots[node] = None
                self.present = self.present - 1
            case SparseHash:
                self.hash.remove(node)
            case ArrayIndex:
                val s = self.slot_of(node)
                self.slots[s] = None
                self.free = self.free.push(s)
                match self.index_owner:
                    case Some(ix): ix.owner_write(node, None)
                    case None: pass
                self.present = self.present - 1
            case _: return false
        true

    fn len() -> i64:
        match self.placement:
            case SparseHash: self.hash.len()
            case _: self.present

fn attr_store_new_v1<T>(attr: text, placement: AttrPlacementV1, owner: AttrOwnerV1<T>?,
                        index_owner: AttrOwnerV1<i64>?) -> AttributeStoreV1<T>:
    val h: Dict<i64, T> = {}
    val s: [T?] = []
    val f: [i64] = []
    AttributeStoreV1(attr: attr, placement: placement, owner: owner, slots: s, present: 0, hash: h,
                     index_owner: index_owner, free: f)

pub fn attr_store_for_token_v1<T>(attr: text, token: text, owner: AttrOwnerV1<T>) -> Result<AttributeStoreV1<T>, text>:
    val placement = attr_placement_from_token_v1(token)?
    match placement:
        case ArrayPointer: return Err(attr_pointer_unsupported_v1(attr, placement))
        case HashPointer: return Err(attr_pointer_unsupported_v1(attr, placement))
        case ArrayIndex:
            val index_cells: AttrOwnerV1<i64> = AttrIndexCellsV1.create()
            return Ok(attr_store_new_v1<T>(attr, placement, None, Some(index_cells)))
        case _: pass
    Ok(attr_store_new_v1<T>(attr, placement, Some(owner), None))

# array_index store whose slot index lives on the node through `index_owner`.
pub fn attr_store_indexed_v1<T>(attr: text, index_owner: AttrOwnerV1<i64>) -> AttributeStoreV1<T>:
    attr_store_new_v1<T>(attr, AttrPlacementV1.ArrayIndex, None, Some(index_owner))

# Resolve the placement once from SPL hints/pins and SDN rules (plan 8.4), then
# build the store. Built-in default is `direct` (today's owner behaviour).
pub fn attr_store_resolve_v1<T>(tree: text, view: text, attr: text, rules: [DataPolicyRuleV1],
                                owner: AttrOwnerV1<T>) -> Result<AttributeStoreV1<T>, text>:
    match data_attr_storage_resolve_v1(tree, view, attr, rules, "direct"):
        case Ok(choice): attr_store_for_token_v1(attr, choice.choice, owner)
        case Err(diag): Err(diag.message)

# Store for a column, array_index or sparse-hash placement: the store owns its
# values, so no owner delegate exists. `direct` has no detached form (the owner
# is the store); the pointer placements fail fast.
pub fn attr_store_detached_v1<T>(attr: text, placement: AttrPlacementV1) -> Result<AttributeStoreV1<T>, text>:
    match placement:
        case Embedded: return Err("attribute {attr}: embedded placement needs an owner")
        case ArrayPointer: return Err(attr_pointer_unsupported_v1(attr, placement))
        case HashPointer: return Err(attr_pointer_unsupported_v1(attr, placement))
        case ArrayIndex:
            val index_cells: AttrOwnerV1<i64> = AttrIndexCellsV1.create()
            return Ok(attr_store_new_v1<T>(attr, placement, None, Some(index_cells)))
        case _: pass
    Ok(attr_store_new_v1<T>(attr, placement, None, None))

# Concrete (non-generic) i64 store for column / array_index / sparse_hash.
# AttributeStoreV1<i64> corrupts i64 payloads in native builds: its erased body
# stores tagged words (v<<3|tag) in Dict<i64,T> / [T?] while the concrete caller
# decodes them raw (sparse_hash 9000000000 -> 1125000000, 7 -> 0). This store has
# no type parameter, no Option payloads and no trait-object `T?` return: slots
# are a plain [i64] with a parallel presence [bool], array_index keeps its node
# slot table in a plain [i64] (-1 = none), and the hash is Dict<i64, i64> read
# via contains_key + index (doc/07_guide/language/dict_native_pitfalls.md).
# @workaround bug=native_erased_generic_optional_return_2026-11-15
class AttrI64StoreV1:
    attr: text
    placement: AttrPlacementV1
    vals: [i64]
    live: [bool]
    node_slot: [i64]
    free: [i64]
    hash: Dict<i64, i64>
    present: i64

pub fn attr_i64_store_v1(attr: text, placement: AttrPlacementV1) -> Result<AttrI64StoreV1, text>:
    match placement:
        case Embedded: return Err("attribute {attr}: embedded placement needs an owner")
        case ArrayPointer: return Err(attr_pointer_unsupported_v1(attr, placement))
        case HashPointer: return Err(attr_pointer_unsupported_v1(attr, placement))
        case _: pass
    val v: [i64] = []
    val l: [bool] = []
    val ns: [i64] = []
    val f: [i64] = []
    val h: Dict<i64, i64> = {}
    Ok(AttrI64StoreV1(attr: attr, placement: placement, vals: v, live: l, node_slot: ns, free: f, hash: h, present: 0))

impl AttrI64StoreV1:
    fn placement_token() -> text:
        attr_placement_token_v1(self.placement)

    # Side-array index holding `node`, or -1.
    fn slot_of(node: i64) -> i64:
        if node < 0: return -1
        match self.placement:
            case Column:
                if node < self.live.len() and self.live[node]: return node
                return -1
            case ArrayIndex:
                if node < self.node_slot.len(): return self.node_slot[node]
                return -1
            case _: return -1

    fn has(node: i64) -> bool:
        match self.placement:
            case SparseHash: return self.hash.contains_key(node)
            case _: return self.slot_of(node) >= 0

    fn get(node: i64) -> Result<i64, text>:
        match self.placement:
            case SparseHash:
                if self.hash.contains_key(node):
                    val hv: i64 = self.hash[node]
                    return Ok(hv)
            case _:
                val s = self.slot_of(node)
                if s >= 0:
                    val sv: i64 = self.vals[s]
                    return Ok(sv)
        Err("absent: no {self.attr} entry for node {node}")

    # False only for a negative node id.
    me set(node: i64, value: i64) -> bool:
        if node < 0: return false
        match self.placement:
            case SparseHash:
                self.hash[node] = value
                return true
            case Column:
                while self.vals.len() <= node:
                    self.vals = self.vals.push(0)
                    self.live = self.live.push(false)
                if not self.live[node]:
                    self.present = self.present + 1
                self.vals[node] = value
                self.live[node] = true
                return true
            case _:
                val held = self.slot_of(node)
                if held >= 0:
                    self.vals[held] = value
                    return true
                var s = self.vals.len()
                if self.free.len() > 0:
                    s = self.free[self.free.len() - 1]
                    val _f = self.free.pop()
                    self.vals[s] = value
                    self.live[s] = true
                else:
                    self.vals = self.vals.push(value)
                    self.live = self.live.push(true)
                while self.node_slot.len() <= node:
                    self.node_slot = self.node_slot.push(-1)
                self.node_slot[node] = s
                self.present = self.present + 1
                return true

    me retire(node: i64) -> bool:
        if not self.has(node): return false
        match self.placement:
            case SparseHash:
                self.hash.remove(node)
                return true
            case Column:
                self.live[node] = false
            case _:
                val s = self.node_slot[node]
                self.live[s] = false
                self.free = self.free.push(s)
                self.node_slot[node] = -1
        self.present = self.present - 1
        true

    fn len() -> i64:
        match self.placement:
            case SparseHash: self.hash.len()
            case _: self.present

# ---------------------------------------------------------------------------
# Multi-field side array (`nfields` attributes of one type per row) in AoS or
# SoA layout. Row = node id (column) or the node-held slot (array_index).
# ---------------------------------------------------------------------------
class AttrGroupStoreV1<T>:
    attr: text
    placement: AttrPlacementV1
    layout: AttrLayoutV1
    nfields: i64
    aos: [T?]
    soa: [[T?]]
    live: [bool]
    rows_n: i64
    index: AttrIndexCellsV1
    free: [i64]

pub fn attr_group_store_v1<T>(attr: text, placement: AttrPlacementV1, nfields: i64,
                              layout: AttrLayoutV1) -> Result<AttrGroupStoreV1<T>, text>:
    match placement:
        case Column: pass
        case ArrayIndex: pass
        case _: return Err("attribute group {attr}: {attr_placement_token_v1(placement)} has no side array, so AoS/SoA does not apply")
    if nfields < 1:
        return Err("attribute group {attr}: needs at least one field")
    var soa: [[T?]] = []
    var i = 0
    while i < nfields:
        val col: [T?] = []
        soa.push(col)
        i = i + 1
    val a: [T?] = []
    val l: [bool] = []
    val f: [i64] = []
    Ok(AttrGroupStoreV1(attr: attr, placement: placement, layout: layout, nfields: nfields, aos: a, soa: soa,
                        live: l, rows_n: 0, index: AttrIndexCellsV1.create(), free: f))

impl AttrGroupStoreV1<T>:
    fn layout_token() -> text:
        attr_layout_token_v1(self.layout)

    fn row_of(node: i64) -> i64:
        match self.placement:
            case Column:
                if node >= 0 and node < self.live.len() and self.live[node]:
                    return node
                return -1
            case _:
                match self.index.owner_read(node):
                    case Some(r): return r
                    case None: return -1

    fn has(node: i64) -> bool:
        self.row_of(node) >= 0

    fn rows() -> i64:
        self.rows_n

    fn get(node: i64, field: i64) -> Result<T, text>:
        if field < 0 or field >= self.nfields:
            return Err("attribute group {self.attr}: field {field} out of range")
        val r = self.row_of(node)
        if r >= 0:
            match self.layout:
                case Aos:
                    match self.aos[r * self.nfields + field]:
                        case Some(v): return Ok(v)
                        case None: pass
                case Soa:
                    match self.soa[field][r]:
                        case Some(v): return Ok(v)
                        case None: pass
        Err("absent: no {self.attr}[{field}] entry for node {node}")

    # Grow the side array to hold row r (all fields absent).
    me grow_to(r: i64):
        while self.live.len() <= r:
            self.live = self.live.push(false)
            match self.layout:
                case Aos:
                    var i = 0
                    while i < self.nfields:
                        self.aos = self.aos.push(None)
                        i = i + 1
                case Soa:
                    var i = 0
                    while i < self.nfields:
                        self.soa[i] = self.soa[i].push(None)
                        i = i + 1

    me clear_row(r: i64):
        var i = 0
        while i < self.nfields:
            match self.layout:
                case Aos: self.aos[r * self.nfields + i] = None
                case Soa: self.soa[i][r] = None
            i = i + 1

    me set(node: i64, field: i64, value: T) -> Result<bool, text>:
        if node < 0:
            return Err("attribute group {self.attr}: negative node id {node}")
        if field < 0 or field >= self.nfields:
            return Err("attribute group {self.attr}: field {field} out of range")
        var r = self.row_of(node)
        if r < 0:
            match self.placement:
                case Column: r = node
                case _:
                    if self.free.len() > 0:
                        r = self.free[self.free.len() - 1]
                        val _f = self.free.pop()
                    else:
                        r = self.live.len()
                    self.index.owner_write(node, Some(r))
            self.grow_to(r)
            self.clear_row(r)
            self.live[r] = true
            self.rows_n = self.rows_n + 1
        match self.layout:
            case Aos: self.aos[r * self.nfields + field] = Some(value)
            case Soa: self.soa[field][r] = Some(value)
        Ok(true)

    me retire(node: i64) -> bool:
        val r = self.row_of(node)
        if r < 0:
            return false
        self.clear_row(r)
        self.live[r] = false
        match self.placement:
            case Column: pass
            case _:
                self.index.owner_write(node, None)
                self.free = self.free.push(r)
        self.rows_n = self.rows_n - 1
        true
