# Logical schema V2 extends the canonical data owner, preserving frozen V1.
# It adds explicit views and property semantics, never storage or type authority.
use compiler.common.data.data_schema_contracts.*

pub const DATA_SCHEMA_CONTRACT_V2: i64 = 2
pub const DATA_SCHEMA_DIGEST_DOMAIN_V2: text = "simple.data-schema/v2"
pub const DATA_SCHEMA_INPUT_VERSION_V2: text = "simple.data-policy/v2"
pub const DATA_SCHEMA_MAX_VIEWS_V2: i64 = 4096
pub const DATA_SCHEMA_MAX_DECLS_V2: i64 = 16384
pub const DATA_SCHEMA_MAX_PROPERTY_ITEMS_V2: i64 = 256
pub const DATA_SCHEMA_MAX_NAME_BYTES_V2: i64 = 4096

pub struct DataViewDeclV2:
    tree: text
    name: text
    provenance: DataDeclProvenanceV1

pub enum DataPropertyKindV2:
    Stored
    Computed
    Forwarded

pub fn data_property_kind_code_v2(kind: DataPropertyKindV2) -> i64:
    match kind:
        case DataPropertyKindV2.Stored: 1
        case DataPropertyKindV2.Computed: 2
        case DataPropertyKindV2.Forwarded: 3

pub enum DataVisibilityV2:
    Public
    Module
    Owner

pub fn data_visibility_code_v2(visibility: DataVisibilityV2) -> i64:
    match visibility:
        case DataVisibilityV2.Public: 1
        case DataVisibilityV2.Module: 2
        case DataVisibilityV2.Owner: 3

# Names/owners/effect symbols must already be bound by their semantic owner.
# This contract validates and retains facts; it cannot prove a getter pure,
# resolve a source symbol, execute a default, or authorize a mutation.
pub struct DataPropertyContractV2:
    kind: DataPropertyKindV2
    visibility: DataVisibilityV2
    visibility_owner: text
    writable: bool
    mutation_owner: text
    getter: text
    setter: text
    forward_attr: text
    phase: text
    read_effects: [text]
    write_effects: [text]
    dependencies: [text]

pub struct DataAttrDeclV2:
    base: DataAttrDeclV1
    property: DataPropertyContractV2

pub struct DataSchemaInputV2:
    views: [DataViewDeclV2]
    decls: [DataAttrDeclV2]

pub struct DataResolvedViewV2:
    name: text
    provenances: [DataDeclProvenanceV1]

pub struct DataResolvedPropertyV2:
    attr_id: DataAttrIdV1
    property: DataPropertyContractV2

# `base` supplies canonical names/types/requiredness/defaults/applicability.
# Only this complete V2 surface and digest describe V2 semantics. In particular,
# passing base to V1 construction facts does NOT validate computed/forwarded
# readiness, explicit empty views, owner access, or effectful default execution.
pub struct DataSchemaSurfaceV2:
    contract_version: i64
    base: DataSchemaSurfaceV1
    views: [DataResolvedViewV2]
    properties: [DataResolvedPropertyV2]
    schema_digest: text
