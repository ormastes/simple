# Dedicated schema-input document adapter; full build-envelope integration is
# separate. Never parse source/configuration during managed field access.
use std.common.sdn.value.{SdnValue, SdnSpan, sdn_value_to_text}
use std.common.sdn.parser.{parse_with_spans_and_issues}
use compiler.common.data.data_schema_contracts.*
use compiler.common.data.data_schema_contracts_v2.*
use compiler.common.data.data_schema_property_resolver_v1.{data_schema_invalid_v2, data_schema_sorted_names_v2}

# Internal syntax normalization shared by schema-input V2 and V3. Full V3
# type_source is UNBOUND syntax, not a nominal name or a semantic type proof.
pub struct DataSchemaSdnAttrV1:
    tree: text
    view: text
    name: text
    type_source: text
    args: [text]
    requiredness: DataRequirednessV1
    default_value: text
    provenance: DataDeclProvenanceV1
    property: DataPropertyContractV2

pub struct DataSchemaSdnInputV1:
    views: [DataViewDeclV2]
    decls: [DataSchemaSdnAttrV1]

fn data_schema_sdn_keys_v2(value: SdnValue) -> [text]:
    var keys: [text] = []
    if val dict = value.as_dict():
        for key in dict.keys():
            keys.push(key)
    data_schema_sorted_names_v2(keys)

fn data_schema_sdn_fields_v2(value: SdnValue, allowed: [text]) -> Result<bool, text>:
    if not value.is_dict():
        return Err("expected a mapping")
    for key in data_schema_sdn_keys_v2(value):
        if not allowed.contains(key):
            return Err("unknown or unsupported schema key '{key}'")
    Ok(true)

fn data_schema_sdn_text_v2(value: SdnValue, key: text, required: bool = false) -> Result<text, text>:
    match value.get(key):
        case None:
            if required:
                return Err("missing text field '{key}'")
            Ok("")
        case Some(item):
            match item.as_str():
                case Some(s):
                    if required and s == "":
                        return Err("empty text field '{key}'")
                    Ok(s)
                case None: Err("'{key}' must be text")

fn data_schema_sdn_bool_v2(value: SdnValue, key: text, required: bool = false) -> Result<bool, text>:
    match value.get(key):
        case None:
            if required:
                return Err("missing boolean field '{key}'")
            Ok(false)
        case Some(item):
            match item.as_bool():
                case Some(b): Ok(b)
                case None: Err("'{key}' must be a boolean")

fn data_schema_sdn_names_v2(value: SdnValue, key: text, required: bool = false) -> Result<[text], text>:
    var out: [text] = []
    match value.get(key):
        case None:
            if required:
                return Err("missing explicit list '{key}'")
        case Some(item):
            match item.as_array():
                case None: return Err("'{key}' must be a list of canonical names")
                case Some(items):
                    if items.len() > DATA_SCHEMA_MAX_PROPERTY_ITEMS_V2:
                        return Err("'{key}' exceeds the schema item limit")
                    for entry in items:
                        match entry.as_str():
                            case Some(name): out.push(name)
                            case None: return Err("'{key}' must contain text names")
    Ok(out)

fn data_schema_sdn_property_v2(value: SdnValue) -> Result<DataPropertyContractV2, text>:
    data_schema_sdn_fields_v2(value, ["kind", "visibility", "visibility_owner", "writable",
        "mutation_owner", "getter", "setter", "forward_attr", "phase", "read_effects", "write_effects", "dependencies"])?
    val kind_text = data_schema_sdn_text_v2(value, "kind", true)?
    val kind = match kind_text:
        case "stored": DataPropertyKindV2.Stored
        case "computed": DataPropertyKindV2.Computed
        case "forwarded": DataPropertyKindV2.Forwarded
        case _: return Err("unknown property kind '{kind_text}'")
    val visibility_text = data_schema_sdn_text_v2(value, "visibility", true)?
    val visibility = match visibility_text:
        case "public": DataVisibilityV2.Public
        case "module": DataVisibilityV2.Module
        case "owner": DataVisibilityV2.Owner
        case _: return Err("unknown visibility '{visibility_text}'")
    val visibility_owner = data_schema_sdn_text_v2(value, "visibility_owner")?
    val writable = data_schema_sdn_bool_v2(value, "writable", true)?
    val mutation_owner = data_schema_sdn_text_v2(value, "mutation_owner")?
    val getter = data_schema_sdn_text_v2(value, "getter")?
    val setter = data_schema_sdn_text_v2(value, "setter")?
    val forward_attr = data_schema_sdn_text_v2(value, "forward_attr")?
    val phase = data_schema_sdn_text_v2(value, "phase", true)?
    # Explicit empty lists describe declared facts. Omission never implies
    # purity, and the structural resolver does not verify an effect body.
    val read_effects = data_schema_sdn_names_v2(value, "read_effects", true)?
    val write_effects = data_schema_sdn_names_v2(value, "write_effects", true)?
    val dependencies = data_schema_sdn_names_v2(value, "dependencies")?
    Ok(DataPropertyContractV2(kind: kind, visibility: visibility, visibility_owner: visibility_owner,
        writable: writable, mutation_owner: mutation_owner, getter: getter, setter: setter,
        forward_attr: forward_attr, phase: phase, read_effects: read_effects,
        write_effects: write_effects, dependencies: dependencies))

fn data_schema_sdn_attr_v2(value: SdnValue, tree: text, view: text, name: text,
                          at: DataDeclProvenanceV1, allow_flat_args: bool) -> Result<DataSchemaSdnAttrV1, text>:
    val allowed = if allow_flat_args: ["type", "args", "required", "default", "property"] else: ["type", "required", "default", "property"]
    data_schema_sdn_fields_v2(value, allowed)?
    val type_path = data_schema_sdn_text_v2(value, "type", true)?
    val args = data_schema_sdn_names_v2(value, "args")?
    val required = data_schema_sdn_bool_v2(value, "required")?
    var default_value = ""
    match value.get("default"):
        case None: pass
        case Some(item):
            match item.as_str():
                case Some(s):
                    if s == "":
                        return Err("default expression must not be empty")
                    default_value = s
                case None:
                    if item.is_number() or item.is_bool():
                        default_value = sdn_value_to_text(item)
                    else:
                        return Err("default must be a scalar expression")
    if required and default_value != "":
        return Err("attribute cannot be both required and defaulted")
    var requiredness = DataRequirednessV1.Optional
    if required:
        requiredness = DataRequirednessV1.Required
    elif default_value != "":
        requiredness = DataRequirednessV1.Defaulted
    val property_value = match value.get("property"):
        case Some(p): p
        case None: return Err("attribute needs an explicit property contract")
    val property = data_schema_sdn_property_v2(property_value)?
    Ok(DataSchemaSdnAttrV1(tree: tree, view: view, name: name, type_source: type_path,
        args: args, requiredness: requiredness, default_value: default_value, provenance: at, property: property))

fn data_schema_sdn_line_v2(spans: Dict<text, SdnSpan>, path: text) -> i64:
    if spans.contains_key(path): spans[path].line else: 0

# The caller supplies the explicit build/module authority; configuration
# cannot mint its own authorizing owner by declaring an owner key.
pub fn data_schema_sdn_decode_v1(source: text, path: text, owner: text, expected_version: text, allow_flat_args: bool) -> Result<DataSchemaSdnInputV1, [DataSchemaDiagnosticV1]>:
    val here = data_decl_provenance_v1(DataDeclOriginV1.Sdn, path, 0, owner)
    if source.byte_len() > 16777216:
        return Err([data_schema_invalid_v2("", here, "schema document exceeds 16 MiB")])
    val parsed = match parse_with_spans_and_issues(source):
        case Ok(document): document
        case Err(message): return Err([data_schema_invalid_v2("", here, "SDN parse error: {message}")])
    var diags: [DataSchemaDiagnosticV1] = []
    for issue in parsed.2:
        val at = data_decl_provenance_v1(DataDeclOriginV1.Sdn, path, issue.line, owner)
        diags.push(data_schema_invalid_v2(issue.path, at, "SDN {issue.kind} '{issue.path}'"))
    if diags.len() > 0:
        return Err(diags)
    match data_schema_sdn_fields_v2(parsed.0, ["data_policy"]):
        case Err(message): return Err([data_schema_invalid_v2("", here, message)])
        case Ok(_): pass
    val policy = match parsed.0.get("data_policy"):
        case Some(value): value
        case None: return Err([data_schema_invalid_v2("data_policy", here, "missing data_policy schema input")])
    match data_schema_sdn_fields_v2(policy, ["schema", "declarations"]):
        case Err(message): return Err([data_schema_invalid_v2("data_policy", here, message)])
        case Ok(_): pass
    val version = match data_schema_sdn_text_v2(policy, "schema", true):
        case Ok(value): value
        case Err(message): return Err([data_schema_invalid_v2("schema", here, message)])
    if version != expected_version:
        return Err([data_schema_invalid_v2("schema", here, "unsupported data schema input version '{version}'")])
    val declarations = match policy.get("declarations"):
        case Some(value): value
        case None: return Err([data_schema_invalid_v2("declarations", here, "missing declarations mapping")])
    if not declarations.is_dict():
        return Err([data_schema_invalid_v2("declarations", here, "declarations must be a mapping")])
    val names = data_schema_sdn_keys_v2(declarations)
    if names.len() > DATA_SCHEMA_MAX_VIEWS_V2:
        return Err([data_schema_invalid_v2("declarations", here, "view input limit exceeded")])
    var views: [DataViewDeclV2] = []
    var decls: [DataSchemaSdnAttrV1] = []
    for name in names:
        val node = declarations.get(name).unwrap()
        val node_path = "data_policy.declarations.{name}"
        val at = data_decl_provenance_v1(DataDeclOriginV1.Sdn, path, data_schema_sdn_line_v2(parsed.1, node_path), owner)
        match data_schema_sdn_fields_v2(node, ["tree", "view", "attributes"]):
            case Err(message):
                diags.push(data_schema_invalid_v2(name, at, message))
                continue
            case Ok(_): pass
        val tree = match data_schema_sdn_text_v2(node, "tree", true):
            case Ok(value): value
            case Err(message):
                diags.push(data_schema_invalid_v2(name, at, message))
                continue
        val view = match data_schema_sdn_text_v2(node, "view", true):
            case Ok(value): value
            case Err(message):
                diags.push(data_schema_invalid_v2(name, at, message))
                continue
        val attributes = match node.get("attributes"):
            case Some(value): value
            case None:
                diags.push(data_schema_invalid_v2(name, at, "missing explicit attributes mapping (use {} for a fieldless view)"))
                continue
        if not attributes.is_dict():
            diags.push(data_schema_invalid_v2(name, at, "attributes must be a mapping"))
            continue
        val attr_names = data_schema_sdn_keys_v2(attributes)
        if attr_names.len() > DATA_SCHEMA_MAX_DECLS_V2 - decls.len():
            return Err([data_schema_invalid_v2(name, at, "attribute input limit exceeded")])
        views.push(DataViewDeclV2(tree: tree, name: view, provenance: at))
        for attr_name in attr_names:
            val attr_path = node_path + ".attributes." + attr_name
            val attr_at = data_decl_provenance_v1(DataDeclOriginV1.Sdn, path, data_schema_sdn_line_v2(parsed.1, attr_path), owner)
            match data_schema_sdn_attr_v2(attributes.get(attr_name).unwrap(), tree, view, attr_name, attr_at, allow_flat_args):
                case Ok(decl): decls.push(decl)
                case Err(message): diags.push(data_schema_invalid_v2(attr_name, attr_at, message))
    if diags.len() > 0:
        return Err(diags)
    Ok(DataSchemaSdnInputV1(views: views, decls: decls))
