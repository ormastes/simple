# Rich logical schemas consume the canonical semantic type owner's complete
# structural identity. Frozen V1/V2 nominal fields are never repurposed.
use compiler.common.data.data_schema_contracts.*
use compiler.common.data.data_schema_contracts_v2.*
use compiler.common.data.data_semantic_type_identity_v1.{DataSemanticTypeIdentityV1}

pub const DATA_SCHEMA_CONTRACT_V3: i64 = 3
pub const DATA_SCHEMA_DIGEST_DOMAIN_V3: text = "simple.data-schema/v3"
pub const DATA_SCHEMA_INPUT_VERSION_V3: text = "simple.data-policy/v3"

pub struct DataAttrDeclV3:
    tree: text
    view: text
    name: text
    type_identity: DataSemanticTypeIdentityV1
    requiredness: DataRequirednessV1
    default_value: text
    provenance: DataDeclProvenanceV1
    property: DataPropertyContractV2

pub struct DataResolvedAttrV3:
    id: DataAttrIdV1
    name: text
    type_identity: DataSemanticTypeIdentityV1
    requiredness: DataRequirednessV1
    default_value: text
    views: [text]
    provenances: [DataDeclProvenanceV1]

pub struct DataSchemaSurfaceV3:
    contract_version: i64
    tree: text
    attrs: [DataResolvedAttrV3]
    views: [DataResolvedViewV2]
    properties: [DataResolvedPropertyV2]
    schema_digest: text

# Configuration syntax remains explicitly UNBOUND until the existing language
# parser/type owner resolves it in the authorized compilation context.
pub struct DataSchemaUnboundAttrV3:
    tree: text
    view: text
    name: text
    type_source: text
    requiredness: DataRequirednessV1
    default_value: text
    provenance: DataDeclProvenanceV1
    property: DataPropertyContractV2

pub struct DataSchemaUnboundInputV3:
    views: [DataViewDeclV2]
    decls: [DataSchemaUnboundAttrV3]
