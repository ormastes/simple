# Driver Core Types - lightweight public driver types for external callers.
#
# Canonical location: compiler.common.driver_core_types
# Extracted from compiler.driver.driver_core_types (2026-03-29) to break the
# backend↔driver import cycle. These types have no compiler-pipeline imports
# so any layer can import them without pulling in the full driver/backend graph.
#
# A backward-compat shim remains at compiler.driver.driver_core_types.

pub use compiler.common.driver_core_modes.{
    CompileMode, OutputFormat,
    driver_output_format_native, driver_output_format_smf,
    driver_output_format_both, driver_output_format_self_contained,
    driver_output_format_is_smf, driver_output_format_is_both,
    driver_output_format_is_self_contained,
    driver_mir_eviction_enabled
}
pub use compiler.common.driver_compile_options.{
    CompileOptions, driver_core_compile_options_default,
    compileoptions_effective_mir_opt_level,
    compileoptions_normalize_mir_optimization
}
pub use compiler.common.driver_compile_result.{
    CompileResult, compile_result_is_success, compile_result_errors
}
pub use compiler.common.driver_source_file.{
    BootLogger, SourceFile, source_file_coverage_identity,
    source_file_authored_path
}
