# Pure accounting shared by emitted progress rows and their native regression.
pub fn build_phase_succeeded_units_v1(done: i64, cached: i64, failed: i64) -> i64:
    if done < 0 or cached < 0 or failed < 0: return -1
    if cached > done or failed > done - cached: return -1
    done - cached - failed

pub fn build_phase_record_failed_module_v1(failed: i64, module_failed: bool) -> i64:
    if failed < 0: return -1
    if module_failed: failed + 1 else: failed

pub fn build_phase_terminal_failures_v1(recorded_failed: i64) -> i64:
    # A phase returning failure with no classified module count is unknown,
    # never a fabricated zero or a claimed single failed module.
    if recorded_failed > 0: recorded_failed else: -1

pub fn build_phase_snapshot_compiled_units_v1(phase: text, done: i64,
        cached: i64, failed: i64) -> i64:
    if phase == "mir": return build_phase_succeeded_units_v1(done, cached, failed)
    done

pub fn build_phase_terminal_known_failures_v1(done: i64, total: i64,
        recorded_failed: i64) -> i64:
    if done < 0 or total < 0 or done != total: return -1
    build_phase_terminal_failures_v1(recorded_failed)
