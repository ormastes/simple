enum CompileMode:
    Interpret
    Jit
    Aot
    Check
    Sdn
    SmfExec

impl CompileMode:
    fn to_text() -> text:
        match self:
            case CompileMode.Interpret: "interpret"
            case CompileMode.Jit: "jit"
            case CompileMode.Aot: "aot"
            case CompileMode.Check: "check"
            case CompileMode.Sdn: "sdn"
            case CompileMode.SmfExec: "smf_exec"
            case _: "unknown"

    static fn from_text(s: text) -> CompileMode?:
        match s:
            case "interpret" | "i": Some(CompileMode.Interpret)
            case "jit" | "j": Some(CompileMode.Jit)
            case "aot" | "a" | "compile" | "c": Some(CompileMode.Aot)
            case "check" | "k": Some(CompileMode.Check)
            case "sdn" | "s" | "data": Some(CompileMode.Sdn)
            case _: nil

enum OutputFormat:
    Native
    Smf
    Both
    SelfContained

impl OutputFormat:
    fn to_text() -> text:
        match self:
            case OutputFormat.Native: "native"
            case OutputFormat.Smf: "smf"
            case OutputFormat.Both: "both"
            case OutputFormat.SelfContained: "self-contained"
            case _: "native"

    static fn from_text(s: text) -> OutputFormat:
        match s:
            case "smf": OutputFormat.Smf
            case "both": OutputFormat.Both
            case "self-contained" | "sc": OutputFormat.SelfContained
            case _: OutputFormat.Native

fn driver_output_format_native() -> OutputFormat:
    OutputFormat.Native

fn driver_output_format_smf() -> OutputFormat:
    OutputFormat.Smf

fn driver_output_format_both() -> OutputFormat:
    OutputFormat.Both

fn driver_output_format_self_contained() -> OutputFormat:
    OutputFormat.SelfContained

fn driver_output_format_is_smf(format: OutputFormat) -> bool:
    format == OutputFormat.Smf

fn driver_output_format_is_both(format: OutputFormat) -> bool:
    format == OutputFormat.Both

fn driver_output_format_is_self_contained(format: OutputFormat) -> bool:
    format == OutputFormat.SelfContained
