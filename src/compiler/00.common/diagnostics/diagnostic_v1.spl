# DiagnosticV1 — compatibility re-export
#
# The canonical `DiagnosticV1` family now lives in
# `std.common.diagnostics.diagnostic_v1` (src/lib/common/diagnostics/), next to
# the adjacent batch/action-index contract (`diagnostic_batch.spl`) and the
# byte<->UTF-16 position map (`source_position.spl`). This module re-exports
# the SAME types so `compiler.common.diagnostics.diagnostic_v1.*` importers are
# unchanged. New code should import from `std.common.diagnostics`.

use std.common.diagnostics.diagnostic_v1.{
    FixConfidence, FixReplacement, DiagnosticFix, MacroFrame, LabelV1,
    DiagnosticV1, render_diagnostic_v1_json
}

export FixConfidence
export FixReplacement
export DiagnosticFix
export MacroFrame
export LabelV1
export DiagnosticV1
export render_diagnostic_v1_json
