# RB-DIAG-01: DiagnosticRulePolicy IDs (config/policy/diagnostic_policy.sdn)
# for the interpreter's own warning channel (`eval_warnings`). The interpreter
# (10.frontend) cannot import the lint layer (90.tools), so this table is the
# single source both sides read: the interpreter tags its messages through
# `interpreter_policy_tag`, and `lint_policy_rule_ids()` merges these bindings
# so the CLI (`  policy: <ID>`) and LSP (`data.policy_id`) print the same ID.
#
# Keys are lint names (they must also exist in the lint default-levels table).
# The tag is a trailing suffix so the existing message prefixes
# (`warning: ...`, `[gc-warning]`, `[use-warning]`, ...) that downstream
# filters match on stay byte-identical.

# reason: lint names and policy IDs are canonical string keys at the policy boundary
@allow(primitive_api)
pub fn interpreter_policy_rule_ids() -> Dict<String, String>:
    var ids: Dict<String, String> = {}
    ids["ignored_return"] = "SPL-RET-001"
    ids["non_exhaustive_match"] = "SPL-MATCH-001"
    ids["match_fallthrough"] = "SPL-MATCH-002"
    ids["match_wildcard_catch"] = "SPL-MATCH-003"
    ids["gc_family_import"] = "SPL-GC-001"
    ids["use_unprovided_name"] = "SPL-IMPORT-001"
    ids

# reason: lint names and policy IDs are canonical string keys at the policy boundary
@allow(primitive_api)
pub fn interpreter_policy_id(lint_name: text) -> text:
    val ids = interpreter_policy_rule_ids()
    if ids.contains_key(lint_name):
        return ids[lint_name]
    ""

# reason: diagnostic message text is the interpreter warning wire format
@allow(primitive_api)
pub fn interpreter_policy_tag(msg: text, lint_name: text) -> text:
    val id = interpreter_policy_id(lint_name)
    if id == "":
        return msg
    msg + " [policy: " + id + "]"
