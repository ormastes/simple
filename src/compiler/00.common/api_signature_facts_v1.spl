# Owned observation records, not public-surface admission or a type universe.
use compiler.common.dependency.visibility.{Visibility}

enum ApiSignatureKindV1:
    Unknown
    Integer
    Float
    Bool
    Text
    Char
    Unit
    Never
    Tuple
    Array
    Slice
    Dict
    Optional
    Result
    Function
    Union
    Reference
    Pointer
    Unique
    Shared
    Weak
    Isolated
    Nominal
    Trait

struct ApiSignatureNodeV1:
    kind: ApiSignatureKindV1
    parent: i64
    ordinal: i64
    bits: i64
    mutable_or_signed: bool
    # A local ID is meaningful only in the containing module's symbol table.
    local_symbol: i64
    declaration_owner: text
    declaration_name: text
    unknown_reason: text

struct ApiCallableFactV1:
    local_symbol: i64
    declaration_owner: text
    declaration_name: text
    declared_visibility: Visibility
    signature_root: i64

struct ApiSignatureFactsV1:
    module_name: text
    module_path: text
    callables: [ApiCallableFactV1]
    nodes: [ApiSignatureNodeV1]
    unknown_reasons: [text]
    inference_errors: i64
    # Versioned observation only. No Safe/Allowed result exists in this slice.
    format_version: i64 = 1
    # Bound only for fresh observations in the retained production pass.
    # Generation and physical index are process-local, never durable identities.
    surface_generation: i64 = 0
    surface_index: i64 = -1
    surface_path: text = ""
    surface_binding_reason: text = "surface-not-bound"

pub fn api_signature_unavailable_v1(module_name: text, module_path: text,
        reason: text) -> ApiSignatureFactsV1:
    ApiSignatureFactsV1(module_name, module_path, [], [], [reason], 0)
