# Shared aspect path authorization policy.
#
# This policy is consumed by both the driver and the loader. Keeping it below
# both layers prevents the driver from importing loader implementation code and
# ensures there is only one definition of the security-sensitive rules.

fn aspect_normalize_path(path: text) -> text:
    val normalized = path.replace("\\", "/")
    val absolute = normalized.starts_with("/")
    var parts: [text] = []
    for part in normalized.split("/"):
        if part.len() == 0 or part == ".":
            continue
        if part == "..":
            if parts.len() > 0 and parts[parts.len() - 1] != "..":
                parts.pop()
            elif not absolute:
                parts.push(part)
            continue
        parts.push(part)
    val joined = parts.join("/")
    if absolute:
        return "/{joined}"
    if joined.len() == 0:
        return "."
    joined

fn aspect_path_within(root: text, child: text) -> bool:
    val canonical_root = aspect_normalize_path(root)
    val canonical_child = aspect_normalize_path(child)
    if canonical_root == "/":
        return canonical_child.starts_with("/")
    canonical_child == canonical_root or canonical_child.starts_with("{canonical_root}/")

fn aspect_importer_can_search(from_file: text, roots: [text]) -> bool:
    """Only code already owned by a resolved aspect root may search that registry."""
    for root in roots:
        if aspect_path_within(root, from_file):
            return true
    false
