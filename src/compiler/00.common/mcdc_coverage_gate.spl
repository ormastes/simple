# codex-impl
# Compiler-owned MC/DC report and admission gate.
#
# The gate is deliberately outside instrumentation and runtime recording. It
# scans frozen condition rows once, validates narrowly scoped exclusions once,
# and then decides admission from exact integer counts. No probe hot path calls
# this module.

use compiler.common.assurance.policy_schema.{AssuranceStrictness}
use std.common.mcdc.model.{McdcExclusion}

const MCDC_GATE_ROW_CAP = 1000000
const MCDC_SEMANTIC_ID_BYTE_CAP = 512
const MCDC_IDENTITY_VERSION_BYTE_CAP = 128
const MCDC_REASON_BYTE_CAP = 2048
const MCDC_REVIEW_METADATA_BYTE_CAP = 256

pub struct McdcConditionResult:
    semantic_id: text
    identity_version: text
    condition_ordinal: i64
    covered: bool
    classification: text = ""
    applied_policy: text = ""

pub struct McdcGateDiagnostic:
    code: text
    semantic_id: text
    condition_ordinal: i64
    detail: text

impl McdcGateDiagnostic:
    fn machine_line() -> text:
        val safe_id = mcdc_diagnostic_atom(self.semantic_id)
        val safe_detail = mcdc_diagnostic_atom(self.detail)
        "{self.code}|{safe_id}|{self.condition_ordinal}|{safe_detail}"

    fn human_line() -> text:
        val safe_id = mcdc_diagnostic_atom(self.semantic_id)
        val safe_detail = mcdc_diagnostic_atom(self.detail)
        if self.condition_ordinal >= 0:
            return "{self.code}: {safe_id} condition {self.condition_ordinal}: {safe_detail}"
        "{self.code}: {safe_id}: {safe_detail}"

pub struct McdcCoverageGateReport:
    accepted: bool
    required: i64
    covered: i64
    excluded: i64
    diagnostics: [McdcGateDiagnostic]

impl McdcCoverageGateReport:
    fn machine_report() -> text:
        val accepted_text = if self.accepted: "true" else: "false"
        var lines: [text] = [
            "MCDC-GATE-v1|accepted={accepted_text}|covered={self.covered}" +
                "|required={self.required}|excluded={self.excluded}"
        ]
        for diagnostic in self.diagnostics:
            lines.push(diagnostic.machine_line())
        lines.join("\n")

    fn human_report() -> text:
        var lines: [text] = [
            "MC/DC: covered {self.covered} of {self.required} required conditions; {self.excluded} approved exclusions"
        ]
        for diagnostic in self.diagnostics:
            lines.push(diagnostic.human_line())
        lines.join("\n")

fn mcdc_diagnostic_atom(raw: text) -> text:
    # One record stays one line and one field. This is not a general serializer;
    # it is the stable, allocation-bounded diagnostic wire vocabulary.
    val without_separator = raw.replace("|", "/")
    val without_newline = without_separator.replace("\n", " ")
    val without_return = without_newline.replace("\r", " ")
    without_return.trim()

fn mcdc_condition_key(semantic_id: text, ordinal: i64) -> text:
    "{semantic_id.len()}:{semantic_id}:{ordinal}"

fn mcdc_exclusion_metadata_error(exclusion: McdcExclusion) -> text:
    if exclusion.semantic_id.trim() == "":
        return "stable decision identity is required"
    if exclusion.semantic_id.len() > MCDC_SEMANTIC_ID_BYTE_CAP:
        return "decision identity exceeds the bounded metadata limit"
    if exclusion.whole_decision or exclusion.condition_ordinal < 0:
        return "an exclusion must name exactly one condition occurrence"
    if exclusion.reason.trim() == "":
        return "a non-empty technical reason is required"
    if exclusion.reason.len() > MCDC_REASON_BYTE_CAP:
        return "technical reason exceeds the bounded metadata limit"
    if exclusion.reviewer.trim() == "" or exclusion.review_id.trim() == "":
        return "reviewer and review identifier are required"
    if (exclusion.reviewer.len() > MCDC_REVIEW_METADATA_BYTE_CAP or
            exclusion.review_id.len() > MCDC_REVIEW_METADATA_BYTE_CAP):
        return "review metadata exceeds the bounded metadata limit"
    if exclusion.expires_or_version.trim() == "":
        return "the reviewed decision identity version is required"
    if exclusion.expires_or_version.len() > MCDC_IDENTITY_VERSION_BYTE_CAP:
        return "reviewed identity version exceeds the bounded metadata limit"
    ""

pub fn enforce_mcdc_exact_coverage(
    profile: AssuranceStrictness,
    conditions: [McdcConditionResult],
    exclusions: [McdcExclusion],
    recorder_saturated: bool,
    dropped_count: i64 = 0,
    overwritten_count: i64 = 0
) -> McdcCoverageGateReport:
    # Profile is explicit even though every current normal-or-higher rung is
    # enforcing. Keeping it typed prevents a future caller from silently using
    # a separate profile table.
    val enforcing = profile.at_least(AssuranceStrictness.Moderate)
    var diagnostics: [McdcGateDiagnostic] = []
    if (conditions.len() > MCDC_GATE_ROW_CAP or
            exclusions.len() > MCDC_GATE_ROW_CAP or
            conditions.len() + exclusions.len() > MCDC_GATE_ROW_CAP):
        diagnostics.push(McdcGateDiagnostic(
            code: "MCDC-E-REPORT-CAP",
            semantic_id: "report",
            condition_ordinal: -1,
            detail: "MC/DC report exceeds the bounded one-million-row limit"
        ))
        return McdcCoverageGateReport(
            accepted: false,
            required: 0,
            covered: 0,
            excluded: 0,
            diagnostics: diagnostics
        )
    var condition_indexes: {text: i64} = {}
    var valid_exclusions: {text: bool} = {}

    var condition_index = 0
    for condition in conditions:
        val semantic_id = condition.semantic_id.trim()
        val version = condition.identity_version.trim()
        if (semantic_id == "" or version == "" or condition.condition_ordinal < 0 or
                semantic_id.len() > MCDC_SEMANTIC_ID_BYTE_CAP or
                version.len() > MCDC_IDENTITY_VERSION_BYTE_CAP):
            diagnostics.push(McdcGateDiagnostic(
                code: "MCDC-E-IDENTITY",
                semantic_id: semantic_id,
                condition_ordinal: condition.condition_ordinal,
                detail: "condition has no stable semantic identity/version"
            ))
        else:
            val key = mcdc_condition_key(semantic_id, condition.condition_ordinal)
            if condition_indexes.contains_key(key):
                diagnostics.push(McdcGateDiagnostic(
                    code: "MCDC-E-IDENTITY-DUPLICATE",
                    semantic_id: semantic_id,
                    condition_ordinal: condition.condition_ordinal,
                    detail: "duplicate condition identity"
                ))
            else:
                condition_indexes[key] = condition_index
        condition_index = condition_index + 1

    for exclusion in exclusions:
        val semantic_id = exclusion.semantic_id.trim()
        val metadata_error = mcdc_exclusion_metadata_error(exclusion)
        if metadata_error != "":
            val code = if exclusion.whole_decision or exclusion.condition_ordinal < 0:
                "MCDC-E-EXCLUSION-SCOPE"
            elif exclusion.reason.trim() == "" or exclusion.reviewer.trim() == "" or exclusion.review_id.trim() == "":
                "MCDC-E-EXCLUSION-REASON"
            else:
                "MCDC-E-EXCLUSION-STALE"
            diagnostics.push(McdcGateDiagnostic(
                code: code,
                semantic_id: semantic_id,
                condition_ordinal: exclusion.condition_ordinal,
                detail: metadata_error
            ))
        else:
            val key = mcdc_condition_key(semantic_id, exclusion.condition_ordinal)
            if valid_exclusions.contains_key(key):
                diagnostics.push(McdcGateDiagnostic(
                    code: "MCDC-E-EXCLUSION-DUPLICATE",
                    semantic_id: semantic_id,
                    condition_ordinal: exclusion.condition_ordinal,
                    detail: "duplicate exclusion for one condition occurrence"
                ))
            elif not condition_indexes.contains_key(key):
                diagnostics.push(McdcGateDiagnostic(
                    code: "MCDC-E-EXCLUSION-STALE",
                    semantic_id: semantic_id,
                    condition_ordinal: exclusion.condition_ordinal,
                    detail: "excluded condition does not exist in the current decision inventory"
                ))
            else:
                val indexed_condition = conditions[condition_indexes[key]]
                if exclusion.expires_or_version.trim() != indexed_condition.identity_version.trim():
                    diagnostics.push(McdcGateDiagnostic(
                        code: "MCDC-E-EXCLUSION-STALE",
                        semantic_id: semantic_id,
                        condition_ordinal: exclusion.condition_ordinal,
                        detail: "reviewed identity version does not match the current decision"
                    ))
                else:
                    valid_exclusions[key] = true

    var required = 0
    var covered = 0
    var excluded = 0
    for condition in conditions:
        val semantic_id = condition.semantic_id.trim()
        val version = condition.identity_version.trim()
        if (semantic_id == "" or version == "" or condition.condition_ordinal < 0 or
                semantic_id.len() > MCDC_SEMANTIC_ID_BYTE_CAP or
                version.len() > MCDC_IDENTITY_VERSION_BYTE_CAP):
            continue
        val key = mcdc_condition_key(semantic_id, condition.condition_ordinal)
        if valid_exclusions.contains_key(key):
            excluded = excluded + 1
        else:
            required = required + 1
            if condition.covered:
                covered = covered + 1
            else:
                val diagnostic_code = if condition.classification == "strong-coupling":
                    "MCDC-E-STRONG-COUPLING"
                elif condition.classification == "invalid-policy":
                    "MCDC-E-POLICY-INVALID"
                elif condition.classification == "evidence-dropped":
                    "MCDC-E-EVIDENCE-DROPPED"
                elif condition.classification == "evidence-overwritten":
                    "MCDC-E-EVIDENCE-OVERWRITTEN"
                else:
                    "MCDC-E-MISSING-PAIR"
                val diagnostic_detail = if condition.applied_policy.trim() != "":
                    condition.applied_policy
                else:
                    "no independently affecting outcome pair was observed"
                diagnostics.push(McdcGateDiagnostic(
                    code: diagnostic_code,
                    semantic_id: semantic_id,
                    condition_ordinal: condition.condition_ordinal,
                    detail: diagnostic_detail
                ))

    if recorder_saturated:
        diagnostics.push(McdcGateDiagnostic(
            code: "MCDC-E-BUFFER-SATURATED",
            semantic_id: "recording",
            condition_ordinal: -1,
            detail: "bounded recorder saturation makes evidence incomplete; dropped={dropped_count}; overwritten={overwritten_count}"
        ))

    val accepted = enforcing and diagnostics.len() == 0 and covered == required
    McdcCoverageGateReport(
        accepted: accepted,
        required: required,
        covered: covered,
        excluded: excluded,
        diagnostics: diagnostics
    )
