"""Versioned facet metadata shared by artifact producers and loaders."""

val FACET_ARTIFACT_VERSION: i64 = 3
val FACET_WITNESS_DESCRIPTOR_VERSION: i64 = 1
extern fn rt_bytes_to_text(data: [u8]) -> text

fn facet_witness_symbol(implementation_id: text) -> text:
    implementation_id + "__facet_witness"

fn facet_witness_method_symbol(implementation_id: text, method_name: text) -> text:
    facet_witness_symbol(implementation_id) + "__" + method_name

struct FacetContractMetadata:
    contract_version: i64
    aspect_id: text
    facet_interface_id: text
    parent_facets: [text]
    method_names: [text]
    method_signatures: [text]
    abi_hash: text

struct FacetWitnessMethodEntry:
    method_name: text
    method_symbol: text
    resolved_address: i64

struct FacetWitnessDescriptorV1:
    descriptor_version: i64
    facet_contract_abi_hash: text
    descriptor_symbol: text
    owner_id: text
    method_entries: [FacetWitnessMethodEntry]

struct FacetBindingArtifactSummary:
    contract_version: i64
    binding_id: text
    aspect_id: text
    concrete_type_id: text
    business_interface_id: text
    facet_interface_id: text
    facet_contract_abi_hash: text
    witness_symbol: text
    witness_descriptor: FacetWitnessDescriptorV1
    capabilities: [text]

fn facet_artifact_text_less(left: text, right: text) -> bool:
    # Native text `<` compares pointers in current codegen; compare content.
    var index = 0
    while index < left.len() and index < right.len():
        val left_code = left.char_code_at(index)
        val right_code = right.char_code_at(index)
        if left_code != right_code:
            return left_code < right_code
        index = index + 1
    left.len() < right.len()

fn facet_artifact_u32(value: i64) -> [u8]:
    [(value & 0xff).to_u8(), ((value >> 8) & 0xff).to_u8(),
     ((value >> 16) & 0xff).to_u8(), ((value >> 24) & 0xff).to_u8()]

fn facet_artifact_text(value: text) -> [u8]:
    val bytes = value.to_bytes()
    facet_artifact_u32(bytes.len()).concat(bytes)

fn facet_artifact_texts(values: [text]) -> [u8]:
    var out = facet_artifact_u32(values.len())
    for value in values:
        out = out.concat(facet_artifact_text(value))
    out

fn facet_artifact_legacy_method_name(signature: text) -> Result<text, text>:
    val trimmed = signature.trim()
    if not trimmed.starts_with("fn "):
        return Err("E-AF002 v1 facet method signature must begin with `fn `")
    val parts = trimmed[3:].split("(")
    if parts.len() < 2 or parts[0].trim() == "":
        return Err("E-AF002 v1 facet method signature has no method name")
    Ok(parts[0].trim())

fn facet_artifact_validate_method_names(
    names: [text], signatures: [text]
) -> Result<[text], text>:
    if names.len() != signatures.len():
        return Err("E-AF002 facet method name/signature count mismatch")
    var seen: [text] = []
    for name in names:
        if name.trim() == "":
            return Err("E-AF002 facet method name must not be empty")
        var character_index = 0
        while character_index < name.len():
            val character = name[character_index:character_index + 1]
            val valid = character.is_alpha() or character == "_" or (
                character_index > 0 and character.is_digit())
            if not valid:
                return Err("E-AF002 invalid canonical facet method name: {name}")
            character_index = character_index + 1
        if seen.contains(name):
            return Err("E-AF002 duplicate facet method name: {name}")
        seen = seen.push(name)
    Ok(names)

fn facet_witness_descriptor_from_contract(
    implementation_id: text, contract: FacetContractMetadata
) -> Result<FacetWitnessDescriptorV1, text>:
    if implementation_id == "" or contract.abi_hash == "":
        return Err("E-AF002 facet witness descriptor identity is incomplete")
    if implementation_id.contains("<"):
        return Err("E-AF002 generic facet witness implementations are not publishable")
    if contract.parent_facets.len() > 0:
        return Err("E-AF002 inherited facet witness descriptors require flattened methods")
    val names = facet_artifact_validate_method_names(
        contract.method_names, contract.method_signatures)?
    if names.len() == 0:
        return Err("E-AF002 facet witness descriptor has no executable methods")
    var entries: [FacetWitnessMethodEntry] = []
    var index = 0
    while index < names.len():
        if contract.method_signatures[index].contains("<"):
            return Err("E-AF002 generic facet witness methods are not publishable")
        entries = entries.push(FacetWitnessMethodEntry(
            method_name: names[index],
            method_symbol: facet_witness_method_symbol(
                implementation_id, names[index]),
            resolved_address: 0))
        index = index + 1
    Ok(FacetWitnessDescriptorV1(
        descriptor_version: FACET_WITNESS_DESCRIPTOR_VERSION,
        facet_contract_abi_hash: contract.abi_hash,
        descriptor_symbol: facet_witness_symbol(implementation_id),
        owner_id: "",
        method_entries: entries))

fn facet_empty_witness_descriptor() -> FacetWitnessDescriptorV1:
    FacetWitnessDescriptorV1(
        descriptor_version: 0, facet_contract_abi_hash: "",
        descriptor_symbol: "", owner_id: "",
        method_entries: [])

class FacetArtifactCursor:
    data: [u8]
    offset: i64

    me fn read_u32() -> Result<i64, text>:
        if self.offset + 4 > self.data.len():
            return Err("E-AF002 truncated facet artifact integer")
        val value = ((self.data[self.offset] as i64) |
            ((self.data[self.offset + 1] as i64) << 8) |
            ((self.data[self.offset + 2] as i64) << 16) |
            ((self.data[self.offset + 3] as i64) << 24))
        self.offset = self.offset + 4
        Ok(value)

    me fn read_text() -> Result<text, text>:
        val size = self.read_u32()?
        if size < 0 or self.offset + size > self.data.len():
            return Err("E-AF002 truncated facet artifact text")
        val value = rt_bytes_to_text(self.data[self.offset:self.offset + size])
        self.offset = self.offset + size
        Ok(value)

    me fn read_texts() -> Result<[text], text>:
        val count = self.read_u32()?
        if count > (self.data.len() - self.offset) / 4:
            return Err("E-AF002 invalid facet artifact text-list count")
        var values: [text] = []
        var index = 0
        while index < count:
            values = values.push(self.read_text()?)
            index = index + 1
        Ok(values)

fn encode_facet_contracts(contracts: [FacetContractMetadata]) -> [u8]:
    var out: [u8] = [0x46, 0x43, 0x54, 0x43]
    out = out.concat(facet_artifact_u32(FACET_ARTIFACT_VERSION))
    out = out.concat(facet_artifact_u32(contracts.len()))
    for contract in contracts:
        out = out.concat(facet_artifact_text(contract.aspect_id))
        out = out.concat(facet_artifact_text(contract.facet_interface_id))
        out = out.concat(facet_artifact_texts(contract.parent_facets))
        out = out.concat(facet_artifact_texts(contract.method_names))
        out = out.concat(facet_artifact_texts(contract.method_signatures))
        out = out.concat(facet_artifact_text(contract.abi_hash))
    out

fn decode_facet_contracts(data: [u8]) -> Result<[FacetContractMetadata], text>:
    if data.len() < 12 or data[0:4] != [0x46, 0x43, 0x54, 0x43]:
        return Err("E-AF002 invalid facet contract artifact")
    var cursor = FacetArtifactCursor(data: data, offset: 4)
    val version = cursor.read_u32()?
    if version != 1 and version != 2 and version != FACET_ARTIFACT_VERSION:
        return Err("E-AF002 unsupported facet contract artifact version")
    val count = cursor.read_u32()?
    if count > (data.len() - cursor.offset) / 20:
        return Err("E-AF002 invalid facet contract artifact count")
    var contracts: [FacetContractMetadata] = []
    var index = 0
    while index < count:
        val aspect_id = cursor.read_text()?
        val facet_interface_id = cursor.read_text()?
        val parent_facets = cursor.read_texts()?
        var method_names: [text] = []
        var method_signatures: [text] = []
        if version == 1:
            method_signatures = cursor.read_texts()?
            for signature in method_signatures:
                method_names = method_names.push(
                    facet_artifact_legacy_method_name(signature)?)
        else:
            method_names = cursor.read_texts()?
            method_signatures = cursor.read_texts()?
        method_names = facet_artifact_validate_method_names(
            method_names, method_signatures)?
        contracts = contracts.push(FacetContractMetadata(
            contract_version: version, aspect_id: aspect_id,
            facet_interface_id: facet_interface_id, parent_facets: parent_facets,
            method_names: method_names,
            method_signatures: method_signatures, abi_hash: cursor.read_text()?))
        index = index + 1
    if cursor.offset != data.len():
        return Err("E-AF002 trailing facet contract artifact bytes")
    Ok(contracts)

fn encode_facet_binding_summaries(
    bindings: [FacetBindingArtifactSummary]
) -> Result<[u8], text>:
    var out: [u8] = [0x46, 0x42, 0x4e, 0x44]
    out = out.concat(facet_artifact_u32(FACET_ARTIFACT_VERSION))
    out = out.concat(facet_artifact_u32(bindings.len()))
    for binding in bindings:
        val descriptor = binding.witness_descriptor
        if (binding.contract_version != FACET_ARTIFACT_VERSION or
            descriptor.descriptor_version != FACET_WITNESS_DESCRIPTOR_VERSION or
            descriptor.facet_contract_abi_hash != binding.facet_contract_abi_hash or
            descriptor.descriptor_symbol != binding.witness_symbol or
            descriptor.owner_id != "" or descriptor.method_entries.len() == 0):
            return Err("E-AF002 facet binding encoder requires an inert v3 witness descriptor")
        var method_names: [text] = []
        var method_symbols: [text] = []
        for method in descriptor.method_entries:
            if (method.method_name == "" or method.method_symbol == "" or
                method.resolved_address != 0 or
                method.method_symbol != descriptor.descriptor_symbol + "__" + method.method_name or
                method_names.contains(method.method_name) or
                method_symbols.contains(method.method_symbol)):
                return Err("E-AF002 facet binding encoder rejects resolved or invalid witness methods")
            method_names = method_names.push(method.method_name)
            method_symbols = method_symbols.push(method.method_symbol)
        out = out.concat(facet_artifact_text(binding.binding_id))
        out = out.concat(facet_artifact_text(binding.aspect_id))
        out = out.concat(facet_artifact_text(binding.concrete_type_id))
        out = out.concat(facet_artifact_text(binding.business_interface_id))
        out = out.concat(facet_artifact_text(binding.facet_interface_id))
        out = out.concat(facet_artifact_text(binding.facet_contract_abi_hash))
        out = out.concat(facet_artifact_text(binding.witness_symbol))
        out = out.concat(facet_artifact_u32(
            binding.witness_descriptor.descriptor_version))
        out = out.concat(facet_artifact_text(
            binding.witness_descriptor.facet_contract_abi_hash))
        out = out.concat(facet_artifact_text(
            binding.witness_descriptor.descriptor_symbol))
        out = out.concat(facet_artifact_u32(
            binding.witness_descriptor.method_entries.len()))
        for method in binding.witness_descriptor.method_entries:
            out = out.concat(facet_artifact_text(method.method_name))
            out = out.concat(facet_artifact_text(method.method_symbol))
        out = out.concat(facet_artifact_texts(binding.capabilities))
    Ok(out)

fn decode_facet_binding_summaries(data: [u8]) -> Result<[FacetBindingArtifactSummary], text>:
    if data.len() < 12 or data[0:4] != [0x46, 0x42, 0x4e, 0x44]:
        return Err("E-AF002 invalid facet binding artifact")
    var cursor = FacetArtifactCursor(data: data, offset: 4)
    val version = cursor.read_u32()?
    if version != 1 and version != 2 and version != FACET_ARTIFACT_VERSION:
        return Err("E-AF002 unsupported facet binding artifact version")
    val count = cursor.read_u32()?
    if count > (data.len() - cursor.offset) / 32:
        return Err("E-AF002 invalid facet binding artifact count")
    var bindings: [FacetBindingArtifactSummary] = []
    var index = 0
    while index < count:
        val binding_id = cursor.read_text()?
        val aspect_id = cursor.read_text()?
        val concrete_type_id = cursor.read_text()?
        val business_interface_id = cursor.read_text()?
        val facet_interface_id = cursor.read_text()?
        val facet_contract_abi_hash = cursor.read_text()?
        val witness_symbol = cursor.read_text()?
        var descriptor = facet_empty_witness_descriptor()
        if version >= 3:
            val descriptor_version = cursor.read_u32()?
            val descriptor_hash = cursor.read_text()?
            val descriptor_symbol = cursor.read_text()?
            val method_count = cursor.read_u32()?
            if method_count < 0 or method_count > (data.len() - cursor.offset) / 8:
                return Err("E-AF002 invalid facet witness method count")
            var methods: [FacetWitnessMethodEntry] = []
            var method_index = 0
            while method_index < method_count:
                methods = methods.push(FacetWitnessMethodEntry(
                    method_name: cursor.read_text()?,
                    method_symbol: cursor.read_text()?, resolved_address: 0))
                method_index = method_index + 1
            descriptor = FacetWitnessDescriptorV1(
                descriptor_version: descriptor_version,
                facet_contract_abi_hash: descriptor_hash,
                descriptor_symbol: descriptor_symbol,
                owner_id: "", method_entries: methods)
        bindings = bindings.push(FacetBindingArtifactSummary(
            contract_version: version, binding_id: binding_id,
            aspect_id: aspect_id, concrete_type_id: concrete_type_id,
            business_interface_id: business_interface_id,
            facet_interface_id: facet_interface_id,
            facet_contract_abi_hash: facet_contract_abi_hash,
            witness_symbol: witness_symbol, witness_descriptor: descriptor,
            capabilities: cursor.read_texts()?))
        index = index + 1
    if cursor.offset != data.len():
        return Err("E-AF002 trailing facet binding artifact bytes")
    Ok(bindings)

export FACET_ARTIFACT_VERSION, FACET_WITNESS_DESCRIPTOR_VERSION
export FacetContractMetadata, FacetWitnessMethodEntry, FacetWitnessDescriptorV1
export FacetBindingArtifactSummary
export facet_witness_symbol, facet_witness_method_symbol
export facet_witness_descriptor_from_contract
export encode_facet_contracts, decode_facet_contracts
export encode_facet_binding_summaries, decode_facet_binding_summaries
export facet_artifact_text_less
