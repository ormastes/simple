"""Frozen AOP QueryIR/MutationIR frontend contracts (Wave 2, §11.3)."""

use std.common.structural.execution.contracts.{StageReceipt}

val COMPILER_AOP_CONTRACT_VERSION: i64 = 1
val TYPE_PREDICATE_BYTECODE_VERSION: i64 = 1

# Stable postfix instructions shared by static binding and future descriptor
# registration. Parsing and evaluation remain in the existing predicate owner.
enum TypePredicateInstruction:
    MatchType(text)
    MatchImplements(text)
    MatchSubtype(text)
    Not
    And
    Or

struct TypePredicateBytecode:
    contract_version: i64
    instructions: [TypePredicateInstruction]

# Declaration-only descriptor consumed by the common predicate evaluator.
# HIR projects this shape from ModuleSurface; it contains no parser nodes.
struct TypePredicateDescriptor:
    qualified_name: text
    implemented_types: [text]
    supertypes: [text]

# Static facet contracts are external typed-witness bindings.  Attached is the
# only representation admitted by the first slice: it never changes a base
# object's fields, vtable, or nominal parents.
enum FacetRepresentation:
    Attached
    NominalStatic

enum FacetMultiplicity:
    Single
    Multi

enum FacetAccess:
    PublicReadonly

struct FacetBindingPlan:
    aspect_id: text
    facet_interface_id: text
    target_predicate: TypePredicateBytecode
    implementation_id: text
    representation: FacetRepresentation
    multiplicity: FacetMultiplicity
    access: FacetAccess
    required: bool

# Opaque handles into the QUERY/MUTATE lanes. This lane never sees IR bytes;
# it addresses compiled programs by digest and validates versions at bind time.
struct PointcutQueryRef:
    query_digest: text        # digest of compiled QueryIR program
    dialect_id: text          # "simple.pointcut"
    contract_version: i64

enum PointcutSelectorKind:
    Attr
    Within
    Execution
    Call
    Assignment
    Decision
    Condition
    Error

enum AdviceKind:
    Before
    After
    Around

struct AdviceTemplateRef:
    mutation_digest: text     # digest of MutationIR template
    kind: AdviceKind
    contract_version: i64

struct AopRule:
    rule_id: text
    pointcut: PointcutQueryRef
    selectors: [PointcutSelectorKind]
    advice: AdviceTemplateRef

struct WeavingReceipt:
    rules_enabled: i64
    join_points_matched: i64
    mutations_applied: i64
    proceed_violations: i64   # must be 0 for success; around-advice proceed() exactly once
    receipt: StageReceipt

export COMPILER_AOP_CONTRACT_VERSION, TYPE_PREDICATE_BYTECODE_VERSION
export TypePredicateInstruction, TypePredicateBytecode, TypePredicateDescriptor
export FacetRepresentation, FacetMultiplicity, FacetAccess, FacetBindingPlan
export PointcutQueryRef, PointcutSelectorKind
export AdviceKind, AdviceTemplateRef, AopRule, WeavingReceipt
