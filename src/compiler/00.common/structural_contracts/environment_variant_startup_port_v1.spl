# Public, non-authorizing startup port for an already-collected environment
# variant policy. Collection is supplied by the composition root: this common
# contract deliberately performs no CLI, environment, file, loader, or device
# access.

use compiler.common.structural_contracts.environment_variant_policy_collection_v1.{
    EnvironmentVariantPolicyCollectionV1
}
use std.nogc_sync_mut.composition.environment_variants.contracts_v1.{
    EnvironmentDigest256V1
}
use std.common.crypto.sha256.sha256_text

pub enum EnvironmentVariantStartupStatusV1:
    Reference
    Selected

pub enum EnvironmentVariantStartupErrorV1:
    InvalidOwner
    InvalidRequest
    CapacityExceeded
    CounterOverflow
    SelectionRejected
    BindingRejected
    UnknownOrStale
    Busy
    CleanupFailed
    AlreadyClosed

pub struct EnvironmentVariantStartupRequestV1:
    collection: EnvironmentVariantPolicyCollectionV1

pub struct EnvironmentVariantStartupHandleV1:
    owner_id: u64
    session_id: u64
    generation: u64

pub struct EnvironmentVariantStartupReceiptV1:
    handle: EnvironmentVariantStartupHandleV1
    policy_digest: EnvironmentDigest256V1
    provider_identity: EnvironmentDigest256V1
    variant_identity: EnvironmentDigest256V1
    artifact_identity: EnvironmentDigest256V1
    environment_identity: EnvironmentDigest256V1
    environment_generation: u64
    status: EnvironmentVariantStartupStatusV1
    rejection_code: text

fn _environment_variant_startup_digest_material_v1(
    value: EnvironmentDigest256V1
) -> text:
    value.w0.to_text() + ":" + value.w1.to_text() + ":" +
        value.w2.to_text() + ":" + value.w3.to_text()

# Stable content identity for frontend cache partitioning. Session coordinates
# are deliberately excluded: they authorize dispatch lifetime, not parse-result
# content. The exact policy, provider, variant, artifact, and host-environment
# generation are all independently bound.
pub fn environment_variant_startup_cache_identity_v1(
    receipt: EnvironmentVariantStartupReceiptV1
) -> text:
    val status = if receipt.status == EnvironmentVariantStartupStatusV1.Selected:
        "selected"
    else:
        "reference"
    sha256_text("environment-variant-startup-cache-v1|" +
        _environment_variant_startup_digest_material_v1(receipt.policy_digest) + "|" +
        _environment_variant_startup_digest_material_v1(receipt.provider_identity) + "|" +
        _environment_variant_startup_digest_material_v1(receipt.variant_identity) + "|" +
        _environment_variant_startup_digest_material_v1(receipt.artifact_identity) + "|" +
        _environment_variant_startup_digest_material_v1(receipt.environment_identity) + "|" +
        receipt.environment_generation.to_text() + "|" + status + "|" +
        receipt.rejection_code.len().to_text() + ":" + receipt.rejection_code)
