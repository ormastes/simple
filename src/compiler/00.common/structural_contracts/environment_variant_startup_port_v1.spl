# Public, non-authorizing startup port for an already-collected environment
# variant policy. Collection is supplied by the composition root: this common
# contract deliberately performs no CLI, environment, file, loader, or device
# access.

use compiler.common.structural_contracts.environment_variant_policy_collection_v1.{
    EnvironmentVariantPolicyCollectionV1
}
use std.nogc_sync_mut.composition.environment_variants.contracts_v1.{
    EnvironmentDigest256V1
}

pub enum EnvironmentVariantStartupStatusV1:
    Reference
    Selected

pub enum EnvironmentVariantStartupErrorV1:
    InvalidOwner
    InvalidRequest
    CapacityExceeded
    CounterOverflow
    SelectionRejected
    BindingRejected
    UnknownOrStale
    Busy
    CleanupFailed
    AlreadyClosed

pub struct EnvironmentVariantStartupRequestV1:
    collection: EnvironmentVariantPolicyCollectionV1

pub struct EnvironmentVariantStartupHandleV1:
    owner_id: u64
    session_id: u64
    generation: u64

pub struct EnvironmentVariantStartupReceiptV1:
    handle: EnvironmentVariantStartupHandleV1
    policy_digest: EnvironmentDigest256V1
    provider_identity: EnvironmentDigest256V1
    variant_identity: EnvironmentDigest256V1
    artifact_identity: EnvironmentDigest256V1
    environment_identity: EnvironmentDigest256V1
    environment_generation: u64
    status: EnvironmentVariantStartupStatusV1
    rejection_code: text
