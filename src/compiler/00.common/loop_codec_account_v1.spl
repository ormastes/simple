# Optional codec integration uses the caller's actual cumulative account.
# One allocation byte conservatively charges one retained state field as well;
# this is a logical upper bound, not a native allocator/RSS measurement.
use compiler.common.loop_resource_account_v1.{MirLoopResourceAccountV1}

pub fn mir_loop_codec_charge_v1(account: MirLoopResourceAccountV1,
        work: i64, allocation: i64 = 0) -> Result<(), text>:
    if account == nil or work < 0 or allocation < 0 or allocation > 4611686018427387903:
        return Err("CODEC-ACCOUNT: actual account or reservation bound invalid")
    val retained_work = allocation * 2
    if work > 9223372036854775807 - retained_work:
        return Err("CODEC-ACCOUNT: reservation overflow")
    match account.reserve(work: work + retained_work,
            state_fields: allocation, output_bytes: allocation):
        case Ok(_): Ok(())
        case Err(_): Err("CODEC-ACCOUNT: actual account exhausted or closed")
