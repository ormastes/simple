# Effective export closure over one compilation subject. Membership is
# structural (frozen routes through every ancestor facade in the registry);
# it is not a visibility diagnostic and grants no publication permission.
enum ApiExportClosureStatusV1:
    NotCollected
    Exported
    NotExported
    Unknown

struct ApiExportClosureEntryV1:
    terminal_index: i64
    terminal_module: text
    local_symbol: i64
    declaration_name: text
    status: ApiExportClosureStatusV1
    # Unknown: the route's own reason. NotExported: the exporter that has no
    # route for this callable. Exported: empty.
    reason: text
    # Outermost joined exporter (the module itself when no facade restricts).
    root_exporter_index: i64
    root_exporter_module: text
    chain_depth: i64

struct ApiExportClosureFactsV1:
    registry_generation: i64
    entries: [ApiExportClosureEntryV1]
    unknown_reasons: [text]
    truncated: bool
    format_version: i64 = 1
