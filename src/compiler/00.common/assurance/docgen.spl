# Docgen for the flight-rule registry (WP-0, 2026-08-07).
#
# PURE RENDERERS — text in, text out, NO filesystem access. Three reasons:
#  1. 00.common must stay dependency-free; importing std.fs here would pull
#     I/O into the lowest layer.
#  2. The renderers are then spec-testable without touching disk.
#  3. WP-1 owns `doc/02_requirements/language/flight_core_v1.md`; this file
#     produces the CONTENT, WP-1 places it. Keeping placement out of here
#     avoids two WPs writing the same file.
#
# The point of generating both tables from `flight_rules()` is that no
# hand-maintained severity table has to exist beside the registry. NOTE the
# scope limit: WP-0 does not touch the EXISTING lint/driver/run/test profile
# tables (`config_and_model.spl`, `driver_safety_severity.spl`,
# `handler_commands.spl`, `test_runner_args.spl`). Those are a different
# mapping (profile name -> severity) and WP-3 unifies them. Until WP-3 lands,
# the "no hand-maintained severity table remains" half of WP-0's acceptance is
# satisfied only for FLT-* rules.
#
# Rows are accumulated into a list and joined once — never `s = s + x` in a
# loop, which is O(n^2) and a lint error (COLL006).

use compiler.common.assurance.flight_rules.{
    FlightRuleV1, flight_rules, flight_rules_hash, source_verification_note
}

fn analyzer_cell(rule: FlightRuleV1) -> text:
    if rule.analyzer != "none":
        return "`" + rule.analyzer + "`"
    if rule.is_enforcement_gap():
        return "**none — gap**"
    "none — intrinsic"

# Standards crosswalk: rule -> sources, category, phase, analyzer, deviation
# policy. WP-1's acceptance requires all seven fields per row plus the
# unverified marker on citations; both are emitted here.
pub fn render_standards_crosswalk() -> text:
    val rules = flight_rules()
    var lines: [text] = [
        "# flight-core-v1 — standards crosswalk",
        "",
        "GENERATED from `src/compiler/00.common/assurance/flight_rules.spl`. Do not edit by hand.",
        "",
        "Rule-set hash: `" + flight_rules_hash() + "`",
        "",
        "Citations are " + source_verification_note() + ".",
        "",
        "| Rule | Title | Sources | Category | Phase | Analyzer | Deviation |",
        "|---|---|---|---|---|---|---|"
    ]
    var i = 0
    while i < rules.len():
        val r = rules[i]
        lines.push("| `" + r.id + "` | " + r.title
            + " | " + r.sources.join("; ")
            + " | " + r.category.name()
            + " | " + r.enforcement_phase.name()
            + " | " + analyzer_cell(r)
            + " | " + r.deviation_policy.name() + " |")
        i = i + 1
    lines.join("\n") + "\n"

# Severity table: rule -> level per assurance grade, plus the diagnostic code
# and the remediation line. This is the table that must NOT be maintained by
# hand anywhere else.
pub fn render_severity_table() -> text:
    val rules = flight_rules()
    var lines: [text] = [
        "# flight-core-v1 — severity by assurance grade",
        "",
        "GENERATED from `src/compiler/00.common/assurance/flight_rules.spl`. Do not edit by hand.",
        "",
        "Rule-set hash: `" + flight_rules_hash() + "`",
        "",
        "The ladder is monotone: a higher grade never relaxes a rule.",
        "",
        "| Rule | critical | aero-a | space-a | Diagnostic | Fix |",
        "|---|---|---|---|---|---|"
    ]
    var i = 0
    while i < rules.len():
        val r = rules[i]
        lines.push("| `" + r.id + "` | " + r.critical_level.name()
            + " | " + r.aero_a_level.name()
            + " | " + r.space_a_level.name()
            + " | `" + r.diagnostic + "` | " + r.fix + " |")
        i = i + 1
    lines.join("\n") + "\n"

# Enforcement-gap report: the rules with no analyzer that are NOT intrinsic.
# WP-2's baseline census keys off exactly this set; rendering it here keeps the
# gap list from being maintained separately and going stale.
pub fn render_enforcement_gap_report() -> text:
    val rules = flight_rules()
    var gaps = 0
    var intrinsic = 0
    var wired = 0
    var rows: [text] = []
    var i = 0
    while i < rules.len():
        val r = rules[i]
        if r.is_enforcement_gap():
            gaps = gaps + 1
            rows.push("| `" + r.id + "` | " + r.title + " | " + r.enforcement_phase.name() + " |")
        else:
            if r.analyzer != "none":
                wired = wired + 1
            else:
                intrinsic = intrinsic + 1
        i = i + 1
    var lines: [text] = [
        "# flight-core-v1 — enforcement gaps",
        "",
        "GENERATED from `src/compiler/00.common/assurance/flight_rules.spl`. Do not edit by hand.",
        "",
        ("Rules: " + rules.len().to_text() + " total — " + wired.to_text()
            + " with a live analyzer, " + intrinsic.to_text()
            + " intrinsic (no analyzer needed), " + gaps.to_text() + " unfilled gaps."),
        "",
        "An intrinsic rule has no analyzer because the language cannot express the violation.",
        "A gap has no analyzer because none was written or wired.",
        "",
        "| Rule | Title | Phase |",
        "|---|---|---|"
    ]
    var j = 0
    while j < rows.len():
        lines.push(rows[j])
        j = j + 1
    lines.join("\n") + "\n"

# Everything, in one document.
pub fn render_flight_core_v1_doc() -> text:
    (render_standards_crosswalk() + "\n---\n\n"
        + render_severity_table() + "\n---\n\n"
        + render_enforcement_gap_report())
