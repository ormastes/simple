# Invocation-owned A5 representation metadata. This carrier conveys reviewed
# bounds and exact source ownership; it never conveys an unsafe operation grant.
use compiler.common.diagnostics.span.{Span}
use compiler.common.diagnostics.diagnostic.{Diagnostic}
use compiler.semantics.symbol_id.stable_id.{SymbolComponents}

struct RepresentationManifestV1:
    schema_version: i64
    kind: text
    reason: text
    reviewers: [text]
    capabilities: [text]

struct RepresentationDeclarationV1:
    components: SymbolComponents
    declaration_id: text
    local_symbol_id: i64
    declaration_span: Span
    attribute_span: Span
    # Ordered, half-open, disjoint body/field spans excluding nested owners.
    owned_intervals: [Span]
    source_digest: text
    manifest: RepresentationManifestV1?
    metadata_errors: [text]
    region_capabilities: [text]
    # Explicit unsafe with empty caps still requires a reviewer manifest.
    requires_manifest: bool = false

struct RepresentationAdmissionV1:
    declaration: RepresentationDeclarationV1
    manifest: RepresentationManifestV1?
    primitive_internal_exempt: bool
    diagnostics: [Diagnostic]

struct RepresentationOwnedIntervalV1:
    declaration_id: text
    span: Span

struct RepresentationManifestIndexV1:
    declarations: Dict<text, RepresentationAdmissionV1>
    diagnostics: [Diagnostic]
    intervals: [RepresentationOwnedIntervalV1]

export RepresentationManifestV1, RepresentationDeclarationV1
export RepresentationAdmissionV1, RepresentationOwnedIntervalV1
export RepresentationManifestIndexV1
