# Mission-critical migration EXCEPTIONS (step 1 of the allocatable
# mission-critical migration, 2026-08-28).
#
# A project pinned to `lints: profile: critical` with `warning_phase: true`
# reports every critical-tier violation as a WARNING so the tree keeps
# building while everything is visible. Some modules genuinely cannot be
# mission-critical yet (vendored bindings, GPU/ML glue, families outside the
# migration scope). Those are named HERE, with a reason, so that:
#
#   * the checker SKIPS the critical-tier rules for them (they are linted at
#     the ordinary `strict` baseline instead — never silenced entirely), and
#   * every skip is REPORTED, so the user can decide module by module.
#
# CONFIG FORM — one flat key under `lints:` in the package `simple.sdn`:
#
#     lints:
#       profile: critical
#       warning_phase: true
#       mc_exceptions: "src/lib/gc_sync_mut=outside migration scope, src/lib/skia=vendored bindings"
#
# Grammar: `scope=reason` entries separated by `,`. `scope` is a repo-relative
# path prefix matched on a `/` boundary (a directory or a single file); the
# reason MUST be non-empty. An entry with an empty scope or reason is DROPPED
# (fail-closed: an unjustified exception grants nothing). Repo-relative form
# is deliberate: absolute paths differ between worktrees, and a flat scalar
# is the only shape both readers of `lints:` (the hand-rolled lint scanner and
# the typed `ProjectContext` loader) agree on — see policy.spl's header.
#
# ZERO `use` LINES, ZERO MODULE-LEVEL STATE — same constraint, same reason, as
# its siblings `policy_names.spl` and `warning_phase.spl`.

# One accepted exception.
struct McException:
    scope: text
    reason: text

# Parse the `mc_exceptions:` value. Same grammar as
# `mission_critical.alloc_diagnostic_config.parse_alloc_allowances`, so an
# operator learns one shape.
pub fn parse_mc_exceptions(raw: text) -> [McException]:
    var out: [McException] = []
    if raw == "":
        return out
    for part in raw.split(","):
        val trimmed = part.trim()
        if trimmed == "":
            continue
        val eq = trimmed.find("=")
        if eq < 0:
            continue
        val scope = _mc_normalize_scope(trimmed[0:eq].trim())
        val why = trimmed[eq + 1:trimmed.len()].trim()
        if scope == "" or why == "":
            continue
        out.push(McException(scope: scope, reason: why))
    out

# Strip a leading `./` and any trailing `/` so `src/lib/x/` and `src/lib/x`
# name the same scope.
fn _mc_normalize_scope(scope: text) -> text:
    var s = scope
    if s.starts_with("./"):
        s = s[2:s.len()]
    while s.len() > 1 and s.ends_with("/"):
        s = s[0:s.len() - 1]
    s

# True when `path` (absolute or repo-relative) lies inside `scope`.
# Boundary-aware: `src/lib/gc` must NOT match `src/lib/gc_sync_mut`.
fn mc_exception_scope_matches(scope: text, path: text) -> bool:
    if scope == "" or path == "":
        return false
    if path == scope:
        return true
    if path.starts_with(scope + "/"):
        return true
    if path.ends_with("/" + scope):
        return true
    path.contains("/" + scope + "/")

# The reason for the first exception covering `path`, or "" when none does.
# Returning the reason rather than a bool is deliberate: the caller reports it
# next to the skip, so an exception is always visible in the output.
pub fn mc_exception_reason_for(exceptions: [McException], path: text) -> text:
    for e in exceptions:
        if e.reason != "" and mc_exception_scope_matches(e.scope, path):
            return e.reason
    ""

# The one-line report emitted for a skipped file. Kept here so the CLI text
# and the JSON record cannot drift from each other.
pub fn mc_exception_report_line(path: text, reason: text) -> text:
    "mission-critical exception: " + path + " -- " + reason + " (critical-tier rules skipped; linted at strict)"
