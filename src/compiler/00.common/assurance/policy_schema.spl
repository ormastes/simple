# ResolvedAssurancePolicyV1 — FROZEN SCHEMA (WP-0, 2026-08-07).
#
# The single typed representation of "which assurance rules apply to this
# compilation". Every command that can enforce something — lint, check, build,
# run, test, verify, package, loader — resolves ONE of these and can prove it
# resolved the same one via `policy_hash()`.
#
# SCOPE OF THIS FILE: the SCHEMA and the hash only. The RESOLVER (env var,
# CLI flag, project SDN, precedence, deprecated-alias warnings) is WP-3 and
# lands in a separate `policy.spl` in this directory. WP-0 must not change the
# existing lint/driver/run/test profile tables — WP-3 does that.
#
# Why the hash matters: today `SIMPLE_SAFETY_PROFILE` is a process-global env
# var, never typed state. The driver RE-READS it per call
# (`80.driver/driver_safety_severity.spl:62-63`) while the interpreter LATCHES
# it once at `eval_init` (`10.frontend/core/interpreter/eval_decls.spl:297`)
# and cannot see later changes (plan premise 5b). Two components can therefore
# disagree about the active profile with nothing detecting it. A comparable
# hash is what makes that disagreement observable.

use compiler.common.assurance.flight_rules.{assurance_text_hash, flight_rules_hash}

# The existing four-rung strictness ladder. `critical` is canonical;
# `mission-critical`/`mission_critical` are deprecated aliases and `lib` /
# `reliable` are the older spellings of `strict` / `robust`
# (`90.tools/lint/_LintMain/config_and_model.spl:83-101`). The alias set is
# frozen by definition — deprecated names never grow.
enum AssuranceStrictness:
    Moderate
    Strict
    Robust
    Critical

impl AssuranceStrictness:
    fn name() -> text:
        match self:
            AssuranceStrictness.Moderate: "moderate"
            AssuranceStrictness.Strict: "strict"
            AssuranceStrictness.Robust: "robust"
            AssuranceStrictness.Critical: "critical"

    # Accepts canonical names and the frozen deprecated aliases. Unknown or
    # empty resolves to Moderate — the same fail-soft default the driver uses
    # today, so nothing silently escalates. Emitting the deprecation warning is
    # WP-3's job, not this schema's.
    static fn from_name(raw: text) -> AssuranceStrictness:
        # V1 cannot represent the FV2 proof-closure tier.  Project it to the
        # strongest V1 engineering restrictions rather than the permissive
        # default; verified release admission is owned by PolicyV2.
        if raw == "verified":
            return AssuranceStrictness.Critical
        if raw == "critical" or raw == "mission-critical" or raw == "mission_critical":
            return AssuranceStrictness.Critical
        if raw == "robust" or raw == "reliable":
            return AssuranceStrictness.Robust
        if raw == "strict" or raw == "lib":
            return AssuranceStrictness.Strict
        AssuranceStrictness.Moderate

    fn rank() -> i64:
        match self:
            AssuranceStrictness.Moderate: 0
            AssuranceStrictness.Strict: 1
            AssuranceStrictness.Robust: 2
            AssuranceStrictness.Critical: 3

    # True when `other` is at least as strict. WP-3's "CLI may raise, never
    # lower a pinned robust/critical" rule is expressed with this.
    fn at_least(other: AssuranceStrictness) -> bool:
        self.rank() >= other.rank()

# Certification grade the artifact is being produced for. Independent of
# strictness: `critical` is a language-level profile, a grade adds release
# evidence obligations on top.
enum AssuranceGrade:
    NoGrade
    AeroA
    SpaceA

impl AssuranceGrade:
    fn name() -> text:
        match self:
            AssuranceGrade.NoGrade: "none"
            AssuranceGrade.AeroA: "aero-a"
            AssuranceGrade.SpaceA: "space-a"

    static fn from_name(raw: text) -> AssuranceGrade:
        if raw == "aero-a" or raw == "aero_a":
            return AssuranceGrade.AeroA
        if raw == "space-a" or raw == "space_a":
            return AssuranceGrade.SpaceA
        AssuranceGrade.NoGrade

    fn rank() -> i64:
        match self:
            AssuranceGrade.NoGrade: 0
            AssuranceGrade.AeroA: 1
            AssuranceGrade.SpaceA: 2

# The rule-set convention in force. `flight-core-v1` is the FLT-* registry in
# flight_rules.spl; `none` means only the ordinary profile rules apply.
enum AssuranceConvention:
    NoConvention
    FlightCoreV1

impl AssuranceConvention:
    fn name() -> text:
        match self:
            AssuranceConvention.NoConvention: "none"
            AssuranceConvention.FlightCoreV1: "flight-core-v1"

    static fn from_name(raw: text) -> AssuranceConvention:
        if raw == "flight-core-v1" or raw == "flight_core_v1":
            return AssuranceConvention.FlightCoreV1
        AssuranceConvention.NoConvention

    fn rank() -> i64:
        match self:
            AssuranceConvention.NoConvention: 0
            AssuranceConvention.FlightCoreV1: 1

# ============================================================================
# ResolvedAssurancePolicyV1 — FROZEN SCHEMA. Adding a field means V2 and a
# policy-hash break, which is the point: a silent field addition would make
# two versions of the compiler agree on a hash while disagreeing on policy.
# ============================================================================
struct ResolvedAssurancePolicyV1:
    """The fully resolved assurance policy for one compilation.

    Fields:
    - strictness: moderate | strict | robust | critical.
    - runtime_family: the `src/lib/<family>` tier the closure is built against
      (e.g. `nogc_async_mut_noalloc`). Part of the policy because allocation
      and blocking obligations are family-dependent.
    - assurance_grade: none | aero-a | space-a.
    - convention: none | flight-core-v1.
    """
    strictness: AssuranceStrictness
    runtime_family: text
    assurance_grade: AssuranceGrade
    convention: AssuranceConvention

impl ResolvedAssurancePolicyV1:
    # The permissive baseline: what an unconfigured build resolves to.
    static fn default() -> ResolvedAssurancePolicyV1:
        ResolvedAssurancePolicyV1(
            strictness: AssuranceStrictness.Moderate,
            runtime_family: "nogc_async_mut",
            assurance_grade: AssuranceGrade.NoGrade,
            convention: AssuranceConvention.NoConvention
        )

    # Fixed field order, every enum through its own name(), rule-set identity
    # folded in. Never derived from dict iteration order or tuple-to-text
    # (native tuple-to-text prints a raw pointer).
    fn canonical_text() -> text:
        ("ResolvedAssurancePolicyV1"
            + "|strictness=" + self.strictness.name()
            + "|runtime_family=" + self.runtime_family
            + "|assurance_grade=" + self.assurance_grade.name()
            + "|convention=" + self.convention.name()
            + "|rules=" + flight_rules_hash())

    # Stable across processes and across commands. Two commands printing the
    # same policy_hash have provably resolved the same policy AND the same
    # rule set.
    fn policy_hash() -> text:
        "APOLV1-" + assurance_text_hash(self.canonical_text())

    # True when the FLT-* registry is in force at all.
    fn flight_rules_active() -> bool:
        match self.convention:
            AssuranceConvention.FlightCoreV1: true
            AssuranceConvention.NoConvention: false

    # True when `other` is no weaker on every axis. WP-3 uses this for
    # "CLI may raise, never lower a pinned robust/critical".
    fn is_at_least_as_strict_as(other: ResolvedAssurancePolicyV1) -> bool:
        if not self.strictness.at_least(other.strictness):
            return false
        if self.assurance_grade.rank() < other.assurance_grade.rank():
            return false
        self.convention.rank() >= other.convention.rank()

# ============================================================================
# ResolvedAssurancePolicyV2 — FV2 extension of the frozen V1 policy.
#
# `verified` is deliberately not added to AssuranceStrictness/V1: doing so
# would alter the V1 hash and let an older compiler misread a newer policy.
# V2 retains all V1 dimensions and adds only the fifth strictness value.
# ============================================================================

enum AssuranceStrictnessV2:
    Moderate
    Strict
    Robust
    Critical
    Verified

impl AssuranceStrictnessV2:
    fn name() -> text:
        match self:
            AssuranceStrictnessV2.Moderate: "moderate"
            AssuranceStrictnessV2.Strict: "strict"
            AssuranceStrictnessV2.Robust: "robust"
            AssuranceStrictnessV2.Critical: "critical"
            AssuranceStrictnessV2.Verified: "verified"

    static fn from_name(raw: text) -> AssuranceStrictnessV2:
        if raw == "verified": return AssuranceStrictnessV2.Verified
        if raw == "critical" or raw == "mission-critical" or raw == "mission_critical":
            return AssuranceStrictnessV2.Critical
        if raw == "robust" or raw == "reliable": return AssuranceStrictnessV2.Robust
        if raw == "strict" or raw == "lib": return AssuranceStrictnessV2.Strict
        AssuranceStrictnessV2.Moderate

    fn rank() -> i64:
        match self:
            AssuranceStrictnessV2.Moderate: 0
            AssuranceStrictnessV2.Strict: 1
            AssuranceStrictnessV2.Robust: 2
            AssuranceStrictnessV2.Critical: 3
            AssuranceStrictnessV2.Verified: 4

    fn at_least(other: AssuranceStrictnessV2) -> bool:
        self.rank() >= other.rank()

    static fn from_v1(value: AssuranceStrictness) -> AssuranceStrictnessV2:
        match value:
            AssuranceStrictness.Moderate: AssuranceStrictnessV2.Moderate
            AssuranceStrictness.Strict: AssuranceStrictnessV2.Strict
            AssuranceStrictness.Robust: AssuranceStrictnessV2.Robust
            AssuranceStrictness.Critical: AssuranceStrictnessV2.Critical

struct ResolvedAssurancePolicyV2:
    strictness: AssuranceStrictnessV2
    runtime_family: text
    assurance_grade: AssuranceGrade
    convention: AssuranceConvention

impl ResolvedAssurancePolicyV2:
    static fn default() -> ResolvedAssurancePolicyV2:
        val v1 = ResolvedAssurancePolicyV1.default()
        ResolvedAssurancePolicyV2(AssuranceStrictnessV2.from_v1(v1.strictness),
            v1.runtime_family, v1.assurance_grade, v1.convention)

    static fn upgrade_v1(policy: ResolvedAssurancePolicyV1) -> ResolvedAssurancePolicyV2:
        ResolvedAssurancePolicyV2(AssuranceStrictnessV2.from_v1(policy.strictness),
            policy.runtime_family, policy.assurance_grade, policy.convention)

    fn canonical_text() -> text:
        "ResolvedAssurancePolicyV2" + "|strictness=" + self.strictness.name() +
            "|runtime_family=" + self.runtime_family +
            "|assurance_grade=" + self.assurance_grade.name() +
            "|convention=" + self.convention.name() +
            "|rules=" + flight_rules_hash()

    fn policy_hash() -> text:
        "APOLV2-" + assurance_text_hash(self.canonical_text())

    fn is_at_least_as_strict_as(other: ResolvedAssurancePolicyV2) -> bool:
        if not self.strictness.at_least(other.strictness): return false
        if self.assurance_grade.rank() < other.assurance_grade.rank(): return false
        self.convention.rank() >= other.convention.rank()
