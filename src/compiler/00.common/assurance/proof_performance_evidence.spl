# Formal Verification 2.0 measurable performance evidence contract.
#
# Measurement is performed by the owning runner.  This module validates and
# seals its warm-run, cache, latency, and process-RSS observations without
# reading ambient process state or manufacturing measurements.

use compiler.common.assurance.flight_rules.{assurance_text_hash}

struct ProofPerformanceThresholdsV1:
    min_warm_runs: i64
    max_warm_latency_ms: i64
    max_cached_latency_ms: i64
    max_rss_kib: i64
    min_cache_hits: i64

struct ProofPerformanceObservationV1:
    fixture_id: text
    warm_latency_ms: [i64]
    cached_latency_ms: [i64]
    cache_hits: i64
    cache_misses: i64
    max_rss_kib: i64

struct ProofPerformanceReceiptV1:
    fixture_id: text
    warm_runs: i64
    warm_latency_max_ms: i64
    cached_latency_max_ms: i64
    cache_hits: i64
    cache_misses: i64
    max_rss_kib: i64
    evidence_hash: text
    diagnostic: text

fn _proof_max_measurement(values: [i64]) -> i64:
    var maximum = 0
    for value in values:
        if value > maximum: maximum = value
    maximum

fn _proof_measurements_text(values: [i64]) -> text:
    var parts: [text] = []
    for value in values: parts = parts.push("{value}")
    parts.join(",")

fn seal_proof_performance_evidence_v1(
    thresholds: ProofPerformanceThresholdsV1,
    observation: ProofPerformanceObservationV1
) -> ProofPerformanceReceiptV1:
    if observation.fixture_id == "":
        return ProofPerformanceReceiptV1("", 0, 0, 0, 0, 0, 0, "", "FV2-E-PERF-FIXTURE: fixture identity is required")
    if thresholds.min_warm_runs <= 0 or thresholds.max_warm_latency_ms <= 0 or thresholds.max_cached_latency_ms <= 0 or thresholds.max_rss_kib <= 0 or thresholds.min_cache_hits <= 0:
        return ProofPerformanceReceiptV1(observation.fixture_id, 0, 0, 0, 0, 0, 0, "", "FV2-E-PERF-THRESHOLD: all thresholds must be positive")
    if observation.warm_latency_ms.len() < thresholds.min_warm_runs:
        return ProofPerformanceReceiptV1(observation.fixture_id, observation.warm_latency_ms.len(), 0, 0, observation.cache_hits, observation.cache_misses, observation.max_rss_kib, "", "FV2-E-PERF-WARM-RUNS: insufficient measured warm runs")
    if observation.cached_latency_ms.len() == 0 or observation.cache_hits < thresholds.min_cache_hits:
        return ProofPerformanceReceiptV1(observation.fixture_id, observation.warm_latency_ms.len(), 0, 0, observation.cache_hits, observation.cache_misses, observation.max_rss_kib, "", "FV2-E-PERF-CACHE: measured cache-hit evidence is required")
    for latency in observation.warm_latency_ms:
        if latency < 0:
            return ProofPerformanceReceiptV1(observation.fixture_id, observation.warm_latency_ms.len(), 0, 0, observation.cache_hits, observation.cache_misses, observation.max_rss_kib, "", "FV2-E-PERF-MEASUREMENT: latency cannot be negative")
    for latency in observation.cached_latency_ms:
        if latency < 0:
            return ProofPerformanceReceiptV1(observation.fixture_id, observation.warm_latency_ms.len(), 0, 0, observation.cache_hits, observation.cache_misses, observation.max_rss_kib, "", "FV2-E-PERF-MEASUREMENT: latency cannot be negative")
    if observation.cache_hits < 0 or observation.cache_misses < 0 or observation.max_rss_kib < 0:
        return ProofPerformanceReceiptV1(observation.fixture_id, observation.warm_latency_ms.len(), 0, 0, observation.cache_hits, observation.cache_misses, observation.max_rss_kib, "", "FV2-E-PERF-MEASUREMENT: counters and RSS cannot be negative")

    val warm_max = _proof_max_measurement(observation.warm_latency_ms)
    val cached_max = _proof_max_measurement(observation.cached_latency_ms)
    if warm_max > thresholds.max_warm_latency_ms:
        return ProofPerformanceReceiptV1(observation.fixture_id, observation.warm_latency_ms.len(), warm_max, cached_max, observation.cache_hits, observation.cache_misses, observation.max_rss_kib, "", "FV2-E-PERF-WARM-LATENCY: warm latency threshold exceeded")
    if cached_max > thresholds.max_cached_latency_ms:
        return ProofPerformanceReceiptV1(observation.fixture_id, observation.warm_latency_ms.len(), warm_max, cached_max, observation.cache_hits, observation.cache_misses, observation.max_rss_kib, "", "FV2-E-PERF-CACHED-LATENCY: cached latency threshold exceeded")
    if observation.max_rss_kib > thresholds.max_rss_kib:
        return ProofPerformanceReceiptV1(observation.fixture_id, observation.warm_latency_ms.len(), warm_max, cached_max, observation.cache_hits, observation.cache_misses, observation.max_rss_kib, "", "FV2-E-PERF-RSS: max RSS threshold exceeded")

    val evidence_hash = assurance_text_hash(
        "ProofPerformanceV1|{observation.fixture_id}|{_proof_measurements_text(observation.warm_latency_ms)}|" +
        "{_proof_measurements_text(observation.cached_latency_ms)}|{observation.cache_hits}|{observation.cache_misses}|{observation.max_rss_kib}"
    )
    ProofPerformanceReceiptV1(
        observation.fixture_id, observation.warm_latency_ms.len(), warm_max, cached_max,
        observation.cache_hits, observation.cache_misses, observation.max_rss_kib, evidence_hash, ""
    )

# Owning measurement runner.  Callers provide capability callbacks, not
# observations: this function brackets every workload itself, samples RSS
# after each run, and decides whether that completed run was a cache hit.
fn measure_proof_performance_v1(
    thresholds: ProofPerformanceThresholdsV1,
    fixture_id: text,
    warm_runs: i64,
    work_fn: fn() -> i64,
    cache_hit_fn: fn() -> bool,
    clock_micros_fn: fn() -> i64,
    rss_kib_fn: fn() -> i64
) -> ProofPerformanceReceiptV1:
    if warm_runs <= 0:
        return ProofPerformanceReceiptV1(fixture_id, 0, 0, 0, 0, 0, 0, "", "FV2-E-PERF-WARM-RUNS: positive requested warm runs are required")
    # Prime the workload once; the priming run is intentionally not counted as
    # warm or cached evidence.
    if work_fn() < 0:
        return ProofPerformanceReceiptV1(fixture_id, 0, 0, 0, 0, 0, 0, "", "FV2-E-PERF-WORKLOAD: priming run failed")
    var warm_latency_ms: [i64] = []
    var cached_latency_ms: [i64] = []
    var cache_hits = 0
    var cache_misses = 0
    var peak_rss_kib = rss_kib_fn()
    for _ in 0..warm_runs:
        val started_micros = clock_micros_fn()
        val result_code = work_fn()
        val finished_micros = clock_micros_fn()
        if result_code < 0 or finished_micros < started_micros:
            return ProofPerformanceReceiptV1(fixture_id, warm_latency_ms.len(), 0, 0, cache_hits, cache_misses, peak_rss_kib, "", "FV2-E-PERF-WORKLOAD: measured run failed")
        val elapsed_ms = (finished_micros - started_micros) / 1000
        warm_latency_ms = warm_latency_ms.push(elapsed_ms)
        if cache_hit_fn():
            cache_hits = cache_hits + 1
            cached_latency_ms = cached_latency_ms.push(elapsed_ms)
        else:
            cache_misses = cache_misses + 1
        val rss_kib = rss_kib_fn()
        if rss_kib > peak_rss_kib: peak_rss_kib = rss_kib
    seal_proof_performance_evidence_v1(
        thresholds,
        ProofPerformanceObservationV1(
            fixture_id, warm_latency_ms, cached_latency_ms,
            cache_hits, cache_misses, peak_rss_kib
        )
    )
