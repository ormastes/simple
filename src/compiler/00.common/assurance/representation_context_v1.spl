# Explicit project namespace supplied by the selected simple.sdn owner.
# Project namespace is an identity input, never a reviewer authentication.
use std.common.sdn.parser.{parse}
use std.common.crypto.sha256.{sha256_text}

struct RepresentationProjectContextV1:
    package_identity: text
    provenance_kind: text
    manifest_identity: text
    manifest_digest: text
    error: text

struct RepresentationSourceContextV1:
    package_identity: text
    module_identity: text
    owner_kind: text
    owner_manifest_path: text
    owner_manifest_digest: text
    source_identity: text

pub fn representation_source_context_v1(project: RepresentationProjectContextV1,
        module_identity: text, source_identity: text) -> RepresentationSourceContextV1:
    RepresentationSourceContextV1(
        package_identity: if project.error == "": project.package_identity else: "",
        module_identity: module_identity, owner_kind: project.provenance_kind,
        owner_manifest_path: project.manifest_identity,
        owner_manifest_digest: project.manifest_digest, source_identity: source_identity)

pub fn representation_contexts_identity_v1(contexts: [RepresentationSourceContextV1]) -> text:
    if contexts.len() == 0:
        return ""
    var fields: [text] = ["representation-source-context-v1"]
    for context in contexts:
        for value in [context.package_identity, context.module_identity, context.owner_kind,
                context.owner_manifest_path, context.owner_manifest_digest, context.source_identity]:
            fields.push("{value.len()}:{value}")
    sha256_text(fields.join(""))

pub fn representation_context_missing_v1() -> RepresentationProjectContextV1:
    RepresentationProjectContextV1(package_identity: "", provenance_kind: "project-config",
        manifest_identity: "", manifest_digest: "", error: "selected project configuration with an explicit project.name is required")

pub fn representation_context_from_project_v1(source: text, selected_manifest: text) -> RepresentationProjectContextV1:
    var context = representation_context_missing_v1()
    context.manifest_identity = selected_manifest
    context.manifest_digest = sha256_text(source)
    if selected_manifest == "":
        return context
    match parse(source):
        case Err(_):
            context.error = "selected project configuration is malformed"
        case Ok(root):
            val primary = root.get_path("project.name")
            val alias = root.get_path("name")
            if val declared = primary:
                if val name = declared.as_str():
                    context.package_identity = name
                else:
                    context.error = "project.name must be literal text"
                    return context
            elif val declared = alias:
                if val name = declared.as_str():
                    context.package_identity = name
                else:
                    context.error = "project name must be literal text"
                    return context
            if context.package_identity.trim() == "":
                return context
            if context.package_identity.contains("\n") or context.package_identity.contains("\r"):
                context.error = "project namespace cannot contain line separators"
                context.package_identity = ""
                return context
            context.error = ""
    context

export RepresentationProjectContextV1, RepresentationSourceContextV1, representation_source_context_v1
export representation_context_from_project_v1, representation_context_missing_v1
export representation_contexts_identity_v1
