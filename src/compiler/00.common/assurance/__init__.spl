# Assurance package — the canonical flight-rule registry and the four frozen
# WP-0 schemas (plan: doc/03_plan/language/assurance/aerospace_hardening_plan_2026-08-07.md).
#
# 00.common is the LOW-DEPENDENCY layer: nothing here may import from a
# higher-numbered layer. That constraint is why the registry lives here at all
# — `80.driver` could not import `90.tools`, which is exactly how the profile
# tables came to be duplicated (see the rationale comment at
# src/compiler/80.driver/driver_safety_severity.spl:4-22).
#
# WP-3 added `policy_names.spl` (the canonical profile-name/alias table, zero
# imports and zero module-level state) and `policy.spl` (the typed resolver and
# its raise-only precedence). `policy_schema.spl` holds only the frozen shape
# and the hash.
#
# IMPORT THE LEAF MODULE, NOT THIS PACKAGE, from the driver, the interpreter,
# `run` and the test runner. A leaf-path import provably does not load sibling
# modules (measured 2026-08-07: a package import fails on a broken sibling, a
# leaf-path import does not), so `use compiler.common.assurance.policy_names`
# costs those layers nothing, while `use compiler.common.assurance` would drag
# the 500-line FLT-* registry into their graphs.

export use compiler.common.assurance.flight_rules.{
    RuleCategory, EnforcementPhase, RuleLevel, DeviationPolicy, FlightRuleV1,
    flight_rules, find_flight_rule, flight_rules_in_category,
    flight_rule_enforcement_gaps, flight_rules_canonical_text,
    flight_rules_hash, assurance_text_hash, source_verification_note
}

export use compiler.common.assurance.policy_schema.{
    AssuranceStrictness, AssuranceGrade, AssuranceConvention,
    ResolvedAssurancePolicyV1, AssuranceStrictnessV2,
    ResolvedAssurancePolicyV2
}

export use compiler.common.assurance.policy_names.{
    normalize_profile_name, deprecated_profile_alias_replacement,
    is_known_profile_name, canonical_profile_names,
    all_accepted_profile_spellings, valid_profile_names_help
}

# WARNING PHASE (2026-08-23): the one-level severity downgrade modifier. A
# leaf like policy_names — zero `use` lines, zero module-level state — so
# importing it directly (`use compiler.common.assurance.warning_phase.{...}`)
# stays cheap for 80.driver / 10.frontend / 90.tools / src/app.
# Only the two `pub` name accessors are re-exported here. The severity-rank
# helpers and the value parser are deliberately plain `fn` (bare-primitive
# signatures trip the `primitive_api` lint rule; the tree's convention is to
# keep such helpers non-`pub` — see `35.semantics/match_exhaustiveness.spl:51`),
# so consumers reach them by LEAF-PATH import,
# `use compiler.common.assurance.warning_phase.{...}`, which is the documented
# convention for this directory anyway.
export use compiler.common.assurance.warning_phase.{
    warning_phase_env_var_name, warning_phase_flag_name
}

export use compiler.common.assurance.policy.{
    strictness_for_profile_name, policy_for_profile_name,
    resolve_assurance_policy, policy_would_weaken,
    policy_env_value, policy_from_env_value, profile_name_is_at_least,
    strictness_for_profile_name_v2, policy_for_profile_name_v2,
    resolve_assurance_policy_v2, policy_env_value_v2, policy_from_env_value_v2
}

export use compiler.common.assurance.symbol_summary.{
    AllocationClass, BlockingBehavior, PanicBehavior, BoundStatus,
    EvidenceStatus, LoweringStatus, CriticalSymbolSummaryV1
}

export use compiler.common.assurance.stamp.{
    ExternProviderSummaryV1, AssuranceStampV1
}

export use compiler.common.assurance.docgen.{
    render_standards_crosswalk, render_severity_table,
    render_enforcement_gap_report, render_flight_core_v1_doc
}

# Phase 9 (2026-08-21): evidence receipts — a gate verdict bound to the
# artifact and seal hashes it describes. §23.9: a report is not evidence.
export use compiler.common.assurance.evidence_receipt.{
    EvidenceReceipt, ReceiptReason, receipt_reason_name, receipt_reason_detail,
    all_receipt_reasons, EVIDENCE_RECEIPT_MAGIC,
    evidence_receipt_canonical_text, evidence_receipt_hash, evidence_receipt_render,
    parse_evidence_receipt, receipt_verdict_is_pass, receipt_failure_reason_at,
    receipt_is_fresh, receipt_is_fresh_at, evidence_receipt_set_now,
    evidence_receipt_now, evidence_receipt_file_name
}

# A5 (2026-08-21): canonical unsafe-capability vocabulary, incl. `type_erasure`.
export use compiler.common.assurance.unsafe_capabilities.{
    UnsafeCapability, unsafe_capability_name, all_unsafe_capabilities,
    unsafe_capability_names, is_known_unsafe_capability,
    parse_unsafe_capability, unsafe_capability_set_contains,
    unknown_unsafe_capability_names, valid_unsafe_capability_names_help
}

# Phase 8 package pins (hardening plan 2026-08-21). Leaf-importable like
# `policy_names`: `use compiler.common.assurance.package_pins.{...}` costs a
# caller nothing beyond the SDN parser it actually needs.
export use compiler.common.assurance.package_pins.{
    Waiver, DepEdge, PackagePin, CriticalCheck, PinReason, PinDocError, PinReport,
    profile_rank, default_profile_name, is_at_least_robust,
    normalize_path, join_path, unresolved_marker, is_unresolved,
    parse_package_pin, parse_critical_checks, pin_doc_error_text,
    pin_reason_code, pin_reason_package, pin_reason_text,
    check_is_mandatory, check_covers,
    resolve_edges, dependency_closure,
    check_waivers, check_critical_preconditions, check_package_pins,
    blockers_for_critical, reasons_with_code, count_with_code
}
