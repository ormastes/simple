# Canonical assurance-profile NAME table (WP-3, 2026-08-07).
#
# THE single source of truth for "what profile names exist and which
# deprecated spellings map to which canonical name". Before WP-3 this table
# was hand-copied into five places:
#
#   lint        90.tools/lint/_LintMain/config_and_model.spl  parse_lint_profile
#   driver      80.driver/driver_safety_severity.spl          safety_pass_severity_for_name
#   run         src/app/io/_CliCommands/handler_commands.spl  _run_normalize_profile_name
#   test-runner src/lib/.../test_runner/test_runner_args.spl  normalize_profile_name
#   interpreter 10.frontend/core/interpreter/eval_decls.spl   match_fallthrough_profile_is_deny
#
# All five now delegate here. Note that the five sites keep THREE DIFFERENT
# projections of this one table (lint -> level dict, driver ->
# SafetyPassSeverity, interpreter -> bool); WP-3 converges the NAME half only
# and deliberately does not flatten the semantics.
#
# ---------------------------------------------------------------------------
# WHY THIS FILE HAS ZERO `use` LINES AND ZERO MODULE-LEVEL STATE
# ---------------------------------------------------------------------------
# The duplication existed for two stated reasons
# (`80.driver/driver_safety_severity.spl:4-22` and its echoes):
#
#  1. LAYERING — 80.driver, 10.frontend, src/app/io and src/lib may not import
#     90.tools. 00.common is BELOW all of them, so this file resolves that
#     properly instead of inverting the dependency. Still true; still the
#     reason this file lives here.
#
#  2. "Interpreter contamination" — executing lint-main's module graph and then
#     parse_full_frontend in one interpreter session was reported to fail with
#     `cannot convert dict to int`
#     (doc/08_tracking/bug/interp_lint_main_then_frontend_dict_to_int_2026-07-28.md).
#     WP-3 RE-MEASURED that repro on 2026-08-07 and it no longer reproduces —
#     see the probe spec
#     test/01_unit/compiler/assurance/policy_graph_contamination_probe_spec.spl.
#     The bug record's own analysis names module-level `Dict` state as the
#     likely cause, so this file keeps none: no `var`, no dict, pure functions
#     of their argument. The warn-once alias counter (which IS a dict) stays in
#     the lint CLI, where the driver's comment already says deprecation
#     warnings belong.
#
# Consumers that only need the NAME half import this leaf module directly
# (`use compiler.common.assurance.policy_names.{...}`), NOT the package — a
# leaf-path import provably does not load sibling modules, so nothing here
# drags the 500-line FLT-* registry into the interpreter's init graph. The
# TYPED resolver, which does need the registry for its hash, is policy.spl.
#
# The alias set is FROZEN: deprecated names never grow. New profile names are
# added here and only here.

# Canonical name for any accepted spelling, or "" when unrecognised.
# Case-insensitive: the lint/run/test copies lowercased first and the driver
# copy did not, so normalising here makes the driver strictly more accepting
# without loosening anything (an unrecognised name still returns "").
pub fn normalize_profile_name(raw: text) -> text:
    val lower = raw.lower()
    if lower == "moderate" or lower == "strict" or lower == "robust" or lower == "critical" or lower == "verified":
        return lower
    if lower == "lib":
        return "strict"
    if lower == "reliable":
        return "robust"
    if lower == "mission-critical" or lower == "mission_critical":
        return "critical"
    ""

# Canonical replacement for a DEPRECATED spelling, or "" when `raw` is already
# canonical (or unknown). Callers use a non-empty result as the trigger for a
# one-time deprecation warning; keeping the predicate here means the warning
# text cannot drift from the alias table it describes.
pub fn deprecated_profile_alias_replacement(raw: text) -> text:
    val lower = raw.lower()
    if lower == "lib":
        return "strict"
    if lower == "reliable":
        return "robust"
    if lower == "mission-critical" or lower == "mission_critical":
        return "critical"
    ""

# True when `raw` is any accepted spelling. Explicit predicate rather than an
# Option, so absence assertions in specs cannot be written fail-open.
fn is_known_profile_name(raw: text) -> bool:
    normalize_profile_name(raw) != ""

# The four canonical names, strictness-ascending. Used by the resolver's rank
# comparison and by help text.
pub fn canonical_profile_names() -> [text]:
    ["moderate", "strict", "robust", "critical", "verified"]

# Every accepted spelling, canonical and deprecated. Specs enumerate this to
# prove all five call sites agree over the WHOLE table rather than over a
# hand-picked sample.
pub fn all_accepted_profile_spellings() -> [text]:
    ["moderate", "strict", "robust", "critical", "verified",
     "lib", "reliable", "mission-critical", "mission_critical"]

pub fn valid_profile_names_help() -> text:
    "moderate, strict, robust, critical, verified (deprecated aliases: lib, reliable, mission-critical)"
