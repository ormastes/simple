# Compiler-private SOURCE account facade. Native tokens are not account proofs.
use compiler.common.loop_resource_account_v1.{MirLoopResourceAccountV1, MirLoopResourceErrorV1}

pub enum SourceRegionErrorV1:
    Incomplete
    ForeignOwner
    Stale
    Capacity
    Closed
    Conflict
    Consumed

pub class SourceRegionContextV1:
    account: MirLoopResourceAccountV1
    native_control: i64
    generation: i64
    pending_ticket_: i64 = 0
    pending_commit_work_: i64 = 0

    me begin_write(expected_epoch: i64, destination: i64, slot: i64) -> Result<i64, SourceRegionErrorV1>:
        if self.pending_ticket_ != 0: return Err(SourceRegionErrorV1.Conflict)
        # Both halves are prepaid before the native owner mints the ticket.
        val begin_work = source_region_prepare_v1(self.account, 7)?
        val commit_work = source_region_prepare_v1(self.account, 8)?
        val ticket = source_region_value_v1(rt_source_region_write_begin_v1(
            self.native_control, self.generation, expected_epoch, destination, slot, begin_work))?
        self.pending_ticket_ = ticket
        self.pending_commit_work_ = commit_work
        Ok(ticket)

    me commit_write(ticket: i64, value_bits: i64) -> Result<i64, SourceRegionErrorV1>:
        if ticket <= 0 or ticket != self.pending_ticket_:
            return Err(SourceRegionErrorV1.Consumed)
        val work = self.pending_commit_work_
        self.pending_ticket_ = 0
        self.pending_commit_work_ = 0
        source_region_value_v1(rt_source_region_write_commit_v1(
            self.native_control, self.generation, ticket, value_bits, work))

extern fn rt_source_region_bound_v1(operation: i64, descriptor: i64, capacity: i64, metric: i64) -> i64
extern fn rt_source_region_create_v1(work: i64) -> i64
extern fn rt_source_region_created_generation_v1(control: i64) -> i64
extern fn rt_source_region_allocation_prepare_v1(descriptor: i64, capacity: i64, work: i64) -> i64
extern fn rt_source_region_alloc_v1(control: i64, generation: i64, epoch: i64, descriptor: i64, capacity: i64, prepared: i64, work: i64) -> i64
extern fn rt_source_region_stamp_v1(control: i64, generation: i64, work: i64) -> i64
extern fn rt_source_region_read_begin_v1(control: i64, generation: i64, epoch: i64, work: i64) -> i64
extern fn rt_source_region_read_end_v1(control: i64, generation: i64, lease: i64, work: i64) -> i64
extern fn rt_source_region_write_begin_v1(control: i64, generation: i64, epoch: i64, destination: i64, slot: i64, work: i64) -> i64
extern fn rt_source_region_write_commit_v1(control: i64, generation: i64, ticket: i64, value_bits: i64, work: i64) -> i64
extern fn rt_source_region_alias_write_v1(control: i64, generation: i64, destination: i64, slot: i64, value_bits: i64, work: i64) -> i64
extern fn rt_source_region_close_v1(control: i64, generation: i64, work: i64) -> i64
extern fn rt_source_region_release_v1(control: i64, generation: i64, work: i64) -> i64

fn source_region_value_v1(value: i64) -> Result<i64, SourceRegionErrorV1>:
    match value:
        case -1: Err(SourceRegionErrorV1.Incomplete)
        case -2: Err(SourceRegionErrorV1.ForeignOwner)
        case -3: Err(SourceRegionErrorV1.Stale)
        case -4: Err(SourceRegionErrorV1.Capacity)
        case -5: Err(SourceRegionErrorV1.Closed)
        case -6: Err(SourceRegionErrorV1.Conflict)
        case -7: Err(SourceRegionErrorV1.Consumed)
        case _:
            if value < 0: Err(SourceRegionErrorV1.Incomplete)
            else: Ok(value)

fn source_region_reserve_v1(account: MirLoopResourceAccountV1,
        work: i64, fields: i64 = 0, bytes: i64 = 0) -> Result<(), SourceRegionErrorV1>:
    if account == nil: return Err(SourceRegionErrorV1.Incomplete)
    match account.reserve(work, state_fields: fields, output_bytes: bytes):
        case Ok(_): Ok(())
        case Err(MirLoopResourceErrorV1.Closed): Err(SourceRegionErrorV1.Closed)
        case Err(_): Err(SourceRegionErrorV1.Capacity)

fn source_region_prepare_v1(account: MirLoopResourceAccountV1,
        operation: i64, descriptor: i64 = 0, capacity: i64 = 0) -> Result<i64, SourceRegionErrorV1>:
    # Three fixed provider-bound observations. They must never traverse slots.
    source_region_reserve_v1(account, 3)?
    val work = source_region_value_v1(rt_source_region_bound_v1(operation, descriptor, capacity, 0))?
    val fields = source_region_value_v1(rt_source_region_bound_v1(operation, descriptor, capacity, 1))?
    val bytes = source_region_value_v1(rt_source_region_bound_v1(operation, descriptor, capacity, 2))?
    source_region_reserve_v1(account, work, fields, bytes)?
    Ok(work)

pub fn source_region_create_v1(account: MirLoopResourceAccountV1) -> Result<SourceRegionContextV1, SourceRegionErrorV1>:
    # Reserve the five-field facade and birth-only immutable generation read
    # before native creation. There is no fallible lookup after native birth.
    source_region_reserve_v1(account, 46, 5, 40)?
    val work = source_region_prepare_v1(account, 1)?
    val control = source_region_value_v1(rt_source_region_create_v1(work))?
    if control == 0: return Err(SourceRegionErrorV1.Incomplete)
    val generation = rt_source_region_created_generation_v1(control)
    Ok(SourceRegionContextV1(account: account, native_control: control, generation: generation))

pub fn source_region_stamp_v1(context: SourceRegionContextV1) -> Result<i64, SourceRegionErrorV1>:
    val work = source_region_prepare_v1(context.account, 4)?
    source_region_value_v1(rt_source_region_stamp_v1(context.native_control, context.generation, work))

pub fn source_region_alloc_v1(context: SourceRegionContextV1, descriptor: i64, capacity: i64) -> Result<i64, SourceRegionErrorV1>:
    val preparation_work = source_region_prepare_v1(context.account, 12, descriptor, capacity)?
    val prepared = source_region_value_v1(rt_source_region_allocation_prepare_v1(descriptor, capacity, preparation_work))?
    val epoch = source_region_stamp_v1(context)?
    val work = source_region_prepare_v1(context.account, 2, descriptor, capacity)?
    source_region_value_v1(rt_source_region_alloc_v1(context.native_control,
        context.generation, epoch, descriptor, capacity, prepared, work))

pub fn source_region_read_begin_v1(context: SourceRegionContextV1, expected_epoch: i64) -> Result<i64, SourceRegionErrorV1>:
    val work = source_region_prepare_v1(context.account, 5)?
    source_region_value_v1(rt_source_region_read_begin_v1(context.native_control, context.generation, expected_epoch, work))

pub fn source_region_read_end_v1(context: SourceRegionContextV1, lease: i64) -> Result<i64, SourceRegionErrorV1>:
    val work = source_region_prepare_v1(context.account, 6)?
    source_region_value_v1(rt_source_region_read_end_v1(context.native_control, context.generation, lease, work))

pub fn source_region_write_begin_v1(context: SourceRegionContextV1, expected_epoch: i64,
        destination: i64, slot: i64) -> Result<i64, SourceRegionErrorV1>:
    context.begin_write(expected_epoch, destination, slot)

pub fn source_region_write_commit_v1(context: SourceRegionContextV1, ticket: i64, value_bits: i64) -> Result<i64, SourceRegionErrorV1>:
    context.commit_write(ticket, value_bits)

pub fn source_region_alias_write_v1(context: SourceRegionContextV1,
        destination: i64, slot: i64, value_bits: i64) -> Result<i64, SourceRegionErrorV1>:
    val work = source_region_prepare_v1(context.account, 9)?
    source_region_value_v1(rt_source_region_alias_write_v1(context.native_control, context.generation, destination, slot, value_bits, work))

pub fn source_region_close_v1(context: SourceRegionContextV1) -> Result<i64, SourceRegionErrorV1>:
    val work = source_region_prepare_v1(context.account, 10)?
    source_region_value_v1(rt_source_region_close_v1(context.native_control, context.generation, work))

pub fn source_region_release_v1(context: SourceRegionContextV1) -> Result<i64, SourceRegionErrorV1>:
    val work = source_region_prepare_v1(context.account, 11)?
    source_region_value_v1(rt_source_region_release_v1(context.native_control, context.generation, work))

pub fn source_region_incomplete_v1() -> Result<i64, SourceRegionErrorV1>:
    Err(SourceRegionErrorV1.Incomplete)
