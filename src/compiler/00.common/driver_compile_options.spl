use compiler.common.driver_core_modes.{CompileMode, OutputFormat}
use common.plugin.aspect_params.{AspectParamsV1}

struct CompileOptions:
    mode: CompileMode
    input_files: [text]
    output_file: text?
    output_format: OutputFormat
    optimize: bool
    opt_level: i64?
    release: bool
    debug_info: bool
    strip_output: bool = false
    verbose: bool
    log_level: i64
    profile: text
    no_borrow_check: bool
    backend: text
    # Canonical native target transported from the CLI into codegen/linking.
    # Linkers must not reconstruct this semantic input from process env.
    native_target: text = ""
    backend_plugin_path: text = ""
    interpreter_mode: text
    gc_off: bool
    smf_output_mode: text
    low_memory: bool
    # Semantic trace level for debug instrumentation.
    # Empty string = disabled. Valid values: "functions", "objects", "full".
    debug_trace_level: text
    # Legacy branch/line coverage is independent from exact MC/DC.
    coverage_enabled: bool = false
    # MC/DC transport is scalar/text so standalone native CLI aggregate copies
    # do not depend on enum representation. Empty/zero means "use environment
    # or the compiler default"; explicit static-off is represented by
    # "static-off", not by an empty value.
    mcdc_mode_text: text = ""
    mcdc_owner_bytes: i64 = 0
    mcdc_global_bytes: i64 = 0
    aspect_params: AspectParamsV1 = AspectParamsV1.defaults()
    # Runtime family restriction for module resolution.
    # Empty list = no restriction (all families allowed).
    allowed_families: [text]
    build_mode: text
    # Stable text mirror for standalone CLI mode transport.
    cli_mode_text: text
    bootstrap_input_count: i64
    bootstrap_input_0: text
    bootstrap_input_1: text
    bootstrap_input_2: text
    bootstrap_input_3: text
    bootstrap_input_4: text
    bootstrap_input_5: text
    # Explicit Gen2 RISC-V elaboration target. Empty means the ordinary VHDL
    # route; critical hardware emission must select a concrete target.
    riscv_gen2_target: text

    static fn default() -> CompileOptions:
        driver_core_compile_options_default()

    fn is_family_allowed(family: text) -> bool:
        """Check if a runtime family is allowed by the current restriction.

        Returns true when no restriction exists or the family is listed.

        sdoctest:
            val unrestricted = CompileOptions.default()
            expect(unrestricted.is_family_allowed("gc_async_mut")).to_equal(true)
        """
        if self.allowed_families.len() == 0:
            return true
        for allowed in self.allowed_families:
            if allowed == family:
                return true
        false

fn driver_core_compile_options_default() -> CompileOptions:
    CompileOptions(
        mode: CompileMode.Jit,
        input_files: [],
        output_file: nil,
        output_format: OutputFormat.Native,
        optimize: false,
        opt_level: nil,
        release: false,
        debug_info: true,
        strip_output: false,
        verbose: false,
        log_level: 4,
        profile: "dev",
        no_borrow_check: false,
        backend: "auto",
        native_target: "",
        backend_plugin_path: "",
        interpreter_mode: "optimized",
        gc_off: false,
        smf_output_mode: "code_only",
        low_memory: false,
        debug_trace_level: "",
        coverage_enabled: false,
        mcdc_mode_text: "",
        mcdc_owner_bytes: 0,
        mcdc_global_bytes: 0,
        aspect_params: AspectParamsV1.defaults(),
        allowed_families: [],
        build_mode: "debug",
        cli_mode_text: "",
        bootstrap_input_count: 0,
        bootstrap_input_0: "",
        bootstrap_input_1: "",
        bootstrap_input_2: "",
        bootstrap_input_3: "",
        bootstrap_input_4: "",
        bootstrap_input_5: "",
        riscv_gen2_target: ""
    )

fn compileoptions_effective_mir_opt_level(opts: CompileOptions) -> i64:
    if opts.opt_level.?:
        return opts.opt_level ?? 0
    if opts.release or opts.optimize:
        return 2
    0

fn compileoptions_normalize_mir_optimization(opts: CompileOptions) -> CompileOptions:
    val effective = compileoptions_effective_mir_opt_level(opts)
    # Preserve the scalar MC/DC transport explicitly across the aggregate copy.
    # Standalone bootstrap binaries have historically corrupted tail fields of
    # large by-value aggregates; these values are validated at context creation.
    val mcdc_mode_text = opts.mcdc_mode_text
    val mcdc_owner_bytes = opts.mcdc_owner_bytes
    val mcdc_global_bytes = opts.mcdc_global_bytes
    val aspect_params = opts.aspect_params
    val backend_plugin_path = opts.backend_plugin_path
    val native_target = opts.native_target
    var normalized = opts
    normalized.optimize = effective > 0
    normalized.opt_level = effective
    normalized.release = opts.release or effective > 0
    normalized.mcdc_mode_text = mcdc_mode_text
    normalized.mcdc_owner_bytes = mcdc_owner_bytes
    normalized.mcdc_global_bytes = mcdc_global_bytes
    normalized.aspect_params = aspect_params
    normalized.backend_plugin_path = backend_plugin_path
    normalized.native_target = native_target
    normalized
