use compiler.common.driver_core_modes.{CompileMode, OutputFormat}
use common.plugin.aspect_params.{AspectParamsV1}
use compiler.common.assurance.representation_context_v1.{RepresentationSourceContextV1}

enum TargetBuildProfileV1:
    Development
    Release

enum TargetDebugRequestV1:
    Default
    Disabled
    Enabled

# Capability is supplied by the admission owner, never inferred from policy.
enum TargetTraceCapabilityV1:
    Unavailable(reason: text)
    Available

enum TargetTraceResolutionV1:
    Disabled
    Unavailable(reason: text)
    Available

struct NormalizedTargetProfileV1:
    profile: TargetBuildProfileV1
    debug_request: TargetDebugRequestV1
    # Available means admitted instrumentation, never active recording.
    trace_resolution: TargetTraceResolutionV1

pub fn target_profile_normalize_v1(profile: TargetBuildProfileV1,
        request: TargetDebugRequestV1, automatic_development_debug: bool,
        capability: TargetTraceCapabilityV1) -> Result<NormalizedTargetProfileV1, text>:
    if profile == TargetBuildProfileV1.Release:
        if request == TargetDebugRequestV1.Enabled:
            return Err("TARGET-PROFILE-E-CONFLICT: release forbids debug tracing")
        return Ok(NormalizedTargetProfileV1(profile, request, TargetTraceResolutionV1.Disabled))
    if request == TargetDebugRequestV1.Disabled or
            (request == TargetDebugRequestV1.Default and not automatic_development_debug):
        return Ok(NormalizedTargetProfileV1(profile, request, TargetTraceResolutionV1.Disabled))
    match capability:
        case Unavailable(reason):
            if reason == "":
                return Err("TARGET-PROFILE-E-CAPABILITY: missing unavailability reason")
            if request == TargetDebugRequestV1.Enabled:
                return Err("TARGET-PROFILE-E-UNAVAILABLE: " + reason)
            Ok(NormalizedTargetProfileV1(profile, request, TargetTraceResolutionV1.Unavailable(reason)))
        case Available:
            Ok(NormalizedTargetProfileV1(profile, request, TargetTraceResolutionV1.Available))

pub fn target_profile_identity_fields_v1(profile: NormalizedTargetProfileV1) -> [text]:
    val mode = if profile.profile == TargetBuildProfileV1.Release: "release" else: "development"
    val request = match profile.debug_request:
        case Default: "default"
        case Disabled: "disabled"
        case Enabled: "enabled"
    val resolution = match profile.trace_resolution:
        case Disabled: "disabled"
        case Unavailable(_): "unavailable"
        case Available: "available"
    val reason = match profile.trace_resolution:
        case Unavailable(value): value
        case _: ""
    ["target_profile_schema=1", "target_profile=" + mode,
        "target_debug_request=" + request, "target_trace_resolution=" + resolution,
        "target_trace_reason=" + reason]

struct CompileOptions:
    mode: CompileMode
    input_files: [text]
    # Ordered logical selectors survive replacement of inputs by closure files.
    # The snapshot root is supplied only after native source admission.
    native_source_roots: [text] = []
    native_source_snapshot_root: text = ""
    # Resolved by the entry/project owner for exact admitted sources only.
    representation_sources: [RepresentationSourceContextV1] = []
    output_file: text?
    output_format: OutputFormat
    optimize: bool
    opt_level: i64?
    release: bool
    debug_info: bool
    strip_output: bool = false
    verbose: bool
    log_level: i64
    profile: text
    no_borrow_check: bool
    # Conforming no-GC build: every admitted module must be `@no_gc(strict)`
    # and checked; an unchecked legacy module or an empty checked closure is
    # a fatal NOGC-POLICY error instead of a NOGC-NOTE-001 warning.
    nogc_require_strict: bool = false
    backend: text
    # Canonical native target transported from the CLI into codegen/linking.
    # Linkers must not reconstruct this semantic input from process env.
    native_target: text = ""
    collection_policy: text = "moderate"
    collection_memory_budget_bytes: i64 = -1
    native_libraries: [text] = []
    native_library_paths: [text] = []
    native_linker_flags: [text] = []
    backend_plugin_path: text = ""
    interpreter_mode: text
    program_args: [text] = []
    gc_off: bool
    smf_output_mode: text
    low_memory: bool
    # Semantic trace level for debug instrumentation.
    # Empty string = disabled. Valid values: "functions", "objects", "full".
    debug_trace_level: text
    # Legacy branch/line coverage is independent from exact MC/DC.
    coverage_enabled: bool = false
    # XRay static switch (`--xray`). false = no sleds, no metadata, byte-identical
    # output; resolved once by 80.driver/driver_xray_policy.spl.
    xray_enabled: bool = false
    # Target policy selector, not producer identity or admission authority.
    # Empty preserves ordinary CLI defaults; only managed phase3 enables the
    # automatic development debug request.
    managed_build_phase: text = ""
    target_debug_request: TargetDebugRequestV1 = TargetDebugRequestV1.Default
    # MC/DC transport is scalar/text so standalone native CLI aggregate copies
    # do not depend on enum representation. Empty/zero means "use environment
    # or the compiler default"; explicit static-off is represented by
    # "static-off", not by an empty value.
    mcdc_mode_text: text = ""
    mcdc_owner_bytes: i64 = 0
    mcdc_global_bytes: i64 = 0
    aspect_params: AspectParamsV1 = AspectParamsV1.defaults()
    # Runtime family restriction for module resolution.
    # Empty list = no restriction (all families allowed).
    allowed_families: [text]
    # Explicit semantic selection; empty preserves legacy target restrictions.
    library_mode: text = ""
    build_mode: text
    # Stable text mirror for standalone CLI mode transport.
    cli_mode_text: text
    bootstrap_input_count: i64
    bootstrap_input_0: text
    bootstrap_input_1: text
    bootstrap_input_2: text
    bootstrap_input_3: text
    bootstrap_input_4: text
    bootstrap_input_5: text
    bootstrap_input_6: text
    # Explicit Gen2 RISC-V elaboration target. Empty means the ordinary VHDL
    # route; critical hardware emission must select a concrete target.
    riscv_gen2_target: text

    static fn default() -> CompileOptions:
        driver_core_compile_options_default()

    fn is_family_allowed(family: text) -> bool:
        """Check if a runtime family is allowed by the current restriction.

        Returns true when no restriction exists or the family is listed.

        sdoctest:
            val unrestricted = CompileOptions.default()
            expect(unrestricted.is_family_allowed("gc_async_mut")).to_equal(true)
        """
        if self.allowed_families.len() == 0:
            return true
        for allowed in self.allowed_families:
            if allowed == family:
                return true
        false

pub fn driver_core_compile_options_default() -> CompileOptions:
    CompileOptions(
        mode: CompileMode.Jit,
        input_files: [],
        native_source_roots: [],
        native_source_snapshot_root: "",
        output_file: nil,
        output_format: OutputFormat.Native,
        optimize: false,
        opt_level: nil,
        release: false,
        debug_info: true,
        strip_output: false,
        verbose: false,
        log_level: 4,
        profile: "dev",
        no_borrow_check: false,
        backend: "auto",
        native_target: "",
        backend_plugin_path: "",
        interpreter_mode: "optimized",
        gc_off: false,
        smf_output_mode: "code_only",
        low_memory: false,
        debug_trace_level: "",
        coverage_enabled: false,
        xray_enabled: false,
        mcdc_mode_text: "",
        mcdc_owner_bytes: 0,
        mcdc_global_bytes: 0,
        aspect_params: AspectParamsV1.defaults(),
        allowed_families: [],
        build_mode: "debug",
        cli_mode_text: "",
        bootstrap_input_count: 0,
        bootstrap_input_0: "",
        bootstrap_input_1: "",
        bootstrap_input_2: "",
        bootstrap_input_3: "",
        bootstrap_input_4: "",
        bootstrap_input_5: "",
        bootstrap_input_6: "",
        riscv_gen2_target: ""
    )

pub fn compileoptions_effective_mir_opt_level(opts: CompileOptions) -> i64:
    if opts.opt_level.?:
        return opts.opt_level ?? 0
    if opts.release or opts.optimize:
        return 2
    0

pub fn compileoptions_normalize_mir_optimization(opts: CompileOptions) -> CompileOptions:
    val effective = compileoptions_effective_mir_opt_level(opts)
    # Preserve the scalar MC/DC transport explicitly across the aggregate copy.
    # Standalone bootstrap binaries have historically corrupted tail fields of
    # large by-value aggregates; these values are validated at context creation.
    val mcdc_mode_text = opts.mcdc_mode_text
    val mcdc_owner_bytes = opts.mcdc_owner_bytes
    val mcdc_global_bytes = opts.mcdc_global_bytes
    val aspect_params = opts.aspect_params
    val backend_plugin_path = opts.backend_plugin_path
    val native_target = opts.native_target
    val native_source_roots = opts.native_source_roots
    val native_source_snapshot_root = opts.native_source_snapshot_root
    val collection_policy = opts.collection_policy
    val collection_memory_budget_bytes = opts.collection_memory_budget_bytes
    val xray_enabled = opts.xray_enabled
    val nogc_require_strict = opts.nogc_require_strict
    var normalized = opts
    normalized.optimize = effective > 0
    normalized.opt_level = effective
    # Optimization is independent of development/release semantics.
    normalized.release = opts.release
    normalized.mcdc_mode_text = mcdc_mode_text
    normalized.mcdc_owner_bytes = mcdc_owner_bytes
    normalized.mcdc_global_bytes = mcdc_global_bytes
    normalized.aspect_params = aspect_params
    normalized.backend_plugin_path = backend_plugin_path
    normalized.native_target = native_target
    normalized.native_source_roots = native_source_roots
    normalized.native_source_snapshot_root = native_source_snapshot_root
    normalized.collection_policy = collection_policy
    normalized.collection_memory_budget_bytes = collection_memory_budget_bytes
    normalized.xray_enabled = xray_enabled
    normalized.nogc_require_strict = nogc_require_strict
    normalized.managed_build_phase = opts.managed_build_phase
    normalized.target_debug_request = opts.target_debug_request
    normalized

pub fn compileoptions_target_profile_v1(options: CompileOptions,
        capability: TargetTraceCapabilityV1) -> Result<NormalizedTargetProfileV1, text>:
    val phase = options.managed_build_phase
    if phase != "" and phase != "phase3" and phase != "phase4":
        return Err("TARGET-PROFILE-E-PHASE: unknown managed build phase")
    if (phase == "phase3" and (options.release or options.profile != "dev")) or
            (phase == "phase4" and (not options.release or options.profile != "prod")):
        return Err("TARGET-PROFILE-E-CONFLICT: managed phase and target profile differ")
    if options.release and options.xray_enabled:
        return Err("TARGET-PROFILE-E-CONFLICT: release forbids XRay instrumentation")
    val profile = if options.release: TargetBuildProfileV1.Release else: TargetBuildProfileV1.Development
    target_profile_normalize_v1(profile, options.target_debug_request, phase == "phase3", capability)

export TargetBuildProfileV1, TargetDebugRequestV1, TargetTraceCapabilityV1
export TargetTraceResolutionV1, NormalizedTargetProfileV1
