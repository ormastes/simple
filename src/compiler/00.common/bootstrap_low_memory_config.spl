# Pure bootstrap low-memory option predicate.
#
# Environment ownership stays in the bootstrap API. Keeping this decision
# pure makes the complete positive/negative matrix independently testable.

pub fn bootstrap_low_memory_opt_ins_requested(
    bootstrap: text,
    stage4: text,
    low_memory: text
) -> bool:
    bootstrap == "1" and stage4 == "1" and low_memory == "1"

pub struct BootstrapLowMemoryEnv:
    bootstrap: text
    stage: text
    stage4: text
    low_memory: text

pub enum BootstrapLowMemoryMode:
    Disabled
    StageRelief
    Stage4Full

pub fn bootstrap_low_memory_mode_resolve(env: BootstrapLowMemoryEnv) -> BootstrapLowMemoryMode:
    if bootstrap_low_memory_opt_ins_requested(env.bootstrap, env.stage4, env.low_memory):
        return BootstrapLowMemoryMode.Stage4Full
    if env.low_memory == "1" and (env.bootstrap == "1" or env.stage == "2" or env.stage == "3" or env.stage == "stage2" or env.stage == "stage3"):
        return BootstrapLowMemoryMode.StageRelief
    BootstrapLowMemoryMode.Disabled

fn bootstrap_stage_low_memory_relief_requested(
    bootstrap: text,
    stage: text,
    stage4: text,
    low_memory: text
) -> bool:
    match bootstrap_low_memory_mode_resolve(BootstrapLowMemoryEnv(
        bootstrap: bootstrap,
        stage: stage,
        stage4: stage4,
        low_memory: low_memory
    )):
        case BootstrapLowMemoryMode.Disabled: false
        case _: true

export bootstrap_low_memory_opt_ins_requested
export BootstrapLowMemoryEnv, BootstrapLowMemoryMode, bootstrap_low_memory_mode_resolve
export bootstrap_stage_low_memory_relief_requested
