# Shared interpreter Value family. This is the single terminal declaration owner.
# HIR closure payloads and MIR get_type contracts remain explicit dependencies.
# Relocation changes nominal qualified identity; prior cache/capsule seals are not admitted.
use compiler.hir.hir_definitions.{HirExpr, HirParam}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir_types.{MirType, MirTypeKind}

"""Runtime value for interpreter."""
enum Value:
    Nil
    Unit
    Bool(value: bool)
    Int(value: i64)
    Float(value: f64)
    Char(value: char)
    String(value: text)
    Array(elements: [Value])
    Tuple(elements: [Value])
    Dict(entries: Dict<text, Value>)
    Struct(type_: text, fields: Dict<text, Value>)
    Enum(type_: text, variant: text, payload: EnumPayloadValue?)
    Function(fn_: FunctionValue)
    Closure(closure: ClosureValue)
    Object(obj: ObjectValue)
    Ref(target: Value, mutable: bool)
    Option(value: Value?)
    Result(ok: Value?, err: Value?)
    TraitType(trait_name: text)
    # NEW: SFFI-backed RuntimeValue pointer
    RuntimeValue(ptr: i64)  # Opaque pointer to Rust RuntimeValue

enum EnumPayloadValue:
    Tuple(values: [Value])
    Struct(fields: Dict<text, Value>)

struct FunctionValue:
    """Function value."""
    symbol: SymbolId
    name: text

type ValueCaptureMap = {text: Value}

struct ClosureValue:
    """Closure value with captured environment."""
    params: [HirParam]
    body: HirExpr
    captures: ValueCaptureMap

struct ObjectValue:
    """Class instance handle (Task #112 class reference model).

    Carries only the class name plus an integer HANDLE into the interpreter's
    shared ObjectStore (see objects.spl / env.spl). The instance's fields live
    in the store, NOT inline here, so copying a `Value.Object(ObjectValue)`
    copies the handle and all copies share one record -> reference semantics."""
    class_name: text
    handle: i64

impl Value:
    static fn make_nil() -> Value:
        Value.Nil

    static fn bool(value: bool) -> Value:
        Value.Bool(value)

    static fn int(value: i64) -> Value:
        Value.Int(value)

    static fn float(value: f64) -> Value:
        Value.Float(value)

    static fn string(value: text) -> Value:
        Value.String(value)

    static fn some(value: Value) -> Value:
        # @workaround bug=value_optional_payload_type_context_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=retain declared Value optional payload context across nested Some construction
        val optional_value: Value? = Some(value)
        backend_value_option_v1(optional_value)

    static fn none() -> Value:
        # @workaround bug=value_optional_payload_type_context_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=keep nil payload in the same declared optional factory
        val absent_value: Value? = nil
        backend_value_option_v1(absent_value)

    static fn ok(value: Value) -> Value:
        # @workaround bug=value_optional_payload_type_context_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=retain declared Value optional payload context across nested Some construction
        val optional_value: Value? = Some(value)
        val absent_value: Value? = nil
        backend_value_result_v1(optional_value, absent_value)

    static fn err(value: Value) -> Value:
        # @workaround bug=value_optional_payload_type_context_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=retain declared Value optional payload context across nested Some construction
        val absent_value: Value? = nil
        val optional_value: Value? = Some(value)
        backend_value_result_v1(absent_value, optional_value)

    fn is_truthy() -> bool:
        match self:
            case Nil: false
            case Bool(b): b
            case Int(i): i != 0
            case Float(f): f != 0.0
            case String(s): not s.is_empty()
            case Array(a): not a.is_empty()
            case Option(v): v.?
            case _: true

    fn type_name() -> text:
        match self:
            case Nil: "nil"
            case Unit: "unit"
            case Bool(_): "bool"
            case Int(_): "i64"
            case Float(_): "f64"
            case Char(_): "char"
            case String(_): "text"
            case Array(_): "array"
            case Tuple(_): "tuple"
            case Dict(_): "dict"
            case Struct(t, _): t
            case Enum(t, _, _): t
            case Function(_): "function"
            case Closure(_): "closure"
            case Object(o): "object"
            case Ref(_, _): "ref"
            case Option(_): "option"
            case Result(_, _): "result"
            case TraitType(_): "trait_type"
            case RuntimeValue(_): "runtime_value"
            case _: "unknown"

    # Type checking methods
    fn is_nil() -> bool:
        match self:
            case Nil: true
            case _: false

    fn is_bool() -> bool:
        match self:
            case Bool(_): true
            case _: false

    fn is_int() -> bool:
        match self:
            case Int(_): true
            case _: false

    fn is_float() -> bool:
        match self:
            case Float(_): true
            case _: false

    fn is_char() -> bool:
        match self:
            case Char(_): true
            case _: false

    fn is_string() -> bool:
        match self:
            case String(_): true
            case _: false

    fn is_array() -> bool:
        match self:
            case Array(_): true
            case _: false

    fn is_tuple() -> bool:
        match self:
            case Tuple(_): true
            case _: false

    fn is_dict() -> bool:
        match self:
            case Dict(_): true
            case _: false

    # Accessor methods. Wrong-type access returns a neutral default in the
    # bootstrap-safe path; checked callers should match on Value first.
    fn as_bool() -> bool:
        match self:
            case Bool(b): b
            case _: false

    fn as_int() -> i64:
        match self:
            case Int(i): i
            case _: 0

    fn as_float() -> f64:
        match self:
            case Float(f): f
            case _: 0.0

    fn as_char() -> char:
        match self:
            case Char(c): c
            case _: '\0'

    fn as_string() -> text:
        match self:
            case String(s): s
            case _: ""

    fn as_array() -> [Value]:
        match self:
            case Array(a): a
            case _: []

    fn as_tuple() -> [Value]:
        match self:
            case Tuple(t): t
            case _: []

    fn as_dict() -> Dict<text, Value>:
        match self:
            case Dict(d): d
            case _: {}

    fn get_type() -> MirType?:
        # For now, return nil - full type tracking not implemented
        match self:
            case Int(_): Some(MirType.i64())
            case Float(_): Some(MirType.f64())
            case Bool(_): Some(MirType.bool())
            case String(_): Some(MirType(kind: MirTypeKind.Ptr(MirType(kind: MirTypeKind.I8), false)))
            case Array(_): Some(MirType(kind: MirTypeKind.Array(MirType.unit(), 0)))
            case Tuple(_): Some(MirType(kind: MirTypeKind.Tuple([])))
            case Dict(_): Some(MirType(kind: MirTypeKind.Opaque("dict")))
            case Unit: Some(MirType.unit())
            case Nil: nil

export Value, EnumPayloadValue, FunctionValue, ClosureValue, ObjectValue

# Genuine constructors stay with the original Value declaration and payload types.

# @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
fn backend_value_bool_v1(value: bool) -> Value:
    Value.Bool(value)

# @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
fn backend_value_int_v1(value: i64) -> Value:
    Value.Int(value)

# @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
fn backend_value_float_v1(value: f64) -> Value:
    Value.Float(value)

# @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
fn backend_value_string_v1(value: text) -> Value:
    Value.String(value)

# @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
fn backend_value_array_v1(elements: [Value]) -> Value:
    Value.Array(elements)

# @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
fn backend_value_tuple_v1(elements: [Value]) -> Value:
    Value.Tuple(elements)

# @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
fn backend_value_dict_v1(entries: Dict<text, Value>) -> Value:
    Value.Dict(entries)

# @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
fn backend_value_struct_v1(type_: text, fields: Dict<text, Value>) -> Value:
    Value.Struct(type_, fields)

# @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
fn backend_value_function_v1(fn_: FunctionValue) -> Value:
    Value.Function(fn_)

# @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
fn backend_value_closure_v1(closure: ClosureValue) -> Value:
    Value.Closure(closure)

# @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
fn backend_value_object_v1(obj: ObjectValue) -> Value:
    Value.Object(obj)

# @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
fn backend_value_runtime_value_v1(ptr: i64) -> Value:
    Value.RuntimeValue(ptr)

export backend_value_bool_v1, backend_value_int_v1, backend_value_float_v1, backend_value_string_v1, backend_value_array_v1, backend_value_tuple_v1, backend_value_dict_v1, backend_value_struct_v1, backend_value_function_v1, backend_value_closure_v1, backend_value_object_v1, backend_value_runtime_value_v1

# @workaround bug=value_optional_payload_type_context_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=retain declared Value optional payload context across nested Some construction
fn backend_value_option_v1(value: Value?) -> Value:
    Value.Option(value)

# @workaround bug=value_optional_payload_type_context_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=retain declared Value optional payload context across nested Some construction
fn backend_value_result_v1(ok: Value?, err: Value?) -> Value:
    Value.Result(ok, err)

export backend_value_option_v1, backend_value_result_v1
