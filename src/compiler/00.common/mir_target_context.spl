# Pure target context shared by the driver and MIR lowering.

struct MirTargetContext:
    arch: text
    os: text
    abi: text
    backend: text
    # Build profile: "debug" or "release" (driver sets from CompileOptions.release).
    build_profile: text = "debug"
    # ARM sub-arch from the triple (armv7, armv7a, thumbv7em, ...); "" otherwise.
    subarch: text = ""
    # Canonical CPU tier text (tier_text form, e.g. "x86-64-v3+avx512vnni"); "" = baseline.
    # HIR stays target-neutral; MIR/backend pick the tier from this (cpu_tier_multibuild.md).
    cpu_tier: text = ""
    version: i64
    collection_policy: text = "moderate"
    collection_memory_budget_bytes: i64 = -1
    collection_opt_level: i64 = 0
    collection_trace_active: bool = false
    collection_target_admitted: bool = false

fn mir_collection_target_is_supported(target: MirTargetContext) -> bool:
    if not target.collection_target_admitted or target.backend != "llvm":
        return false
    if target.arch != "x86_64" and target.arch != "aarch64":
        return false
    match target.os:
        case "linux": target.abi == "gnu" or target.abi == "musl"
        case "windows": target.abi == "msvc" or target.abi == "gnu"
        case "macos": target.abi == "macho"
        case "freebsd": target.abi == "sysv"
        case _: false

fn mir_collection_target_admitted(target: text, host_arch: text, host_os: text, backend: text) -> bool:
    # This proof is separate from general target normalization, which permits
    # host fallbacks for legacy callers. Unknown text must not prove an ABI.
    if backend != "llvm" and backend != "llvm-lib" and backend != "llvmlib":
        return false
    if mir_target_context_uses_host(target):
        val arch = mir_target_context_normalize_arch(host_arch)
        val os = mir_target_context_normalize_os(host_os)
        return ((arch == "x86_64" or arch == "aarch64") and
            (os == "linux" or os == "windows" or os == "macos" or os == "freebsd"))
    # Parsing an explicit tuple does not widen collection's supported set.
    # The validator is pure: it must not call context construction/admission.
    val suffix = _mir_target_context_explicit_suffix(target)
    if suffix.is_err():
        return false
    val arch = mir_target_context_normalize_arch(target.split("-")[0])
    if arch != "x86_64" and arch != "aarch64":
        return false
    ["linux-gnu", "unknown-linux-gnu", "linux-musl", "unknown-linux-musl",
        "pc-windows-msvc", "unknown-windows-msvc", "windows-msvc",
        "pc-windows-gnu", "w64-windows-gnu", "apple-darwin", "apple-macos",
        "unknown-freebsd", "freebsd"].contains(suffix.unwrap())

# Conservative explicit tuple vocabulary. This validates representable context
# inputs, not backend capability, semantic portability or cache admission.
# Keep ISA-bearing RISC-V and x86-generation spellings out until the context
# retains that detail: riscv64gc -> riscv64 and i686 -> x86 are lossy here.
fn _mir_target_context_explicit_suffix(target: text) -> Result<text, text>:
    if mir_target_context_uses_host(target):
        return Err("explicit_target_required: resolve native at the compile request boundary")
    val arch = target.split("-")[0]
    if not ["x86_64", "amd64", "x64", "x86",
        "aarch64", "arm64", "arm", "armv6", "armv7", "armv7a", "armv7m", "armv7em",
        "thumbv6m", "thumbv7m", "thumbv7em", "riscv32", "rv32", "riscv64", "rv64"].contains(arch):
        return Err("unsupported_explicit_arch: architecture is unknown or loses target detail")
    for suffix in ["linux-gnu", "unknown-linux-gnu", "linux-musl", "unknown-linux-musl",
        "pc-windows-msvc", "unknown-windows-msvc", "windows-msvc", "windows-gnu",
        "pc-windows-gnu", "w64-windows-gnu", "w64-mingw32", "apple-darwin", "apple-macos",
        "unknown-freebsd", "freebsd", "unknown-simpleos", "simpleos", "unknown-none-elf"]:
        if target == arch + "-" + suffix:
            return Ok(suffix)
    val normalized_arch = mir_target_context_normalize_arch(arch)
    if normalized_arch == "arm":
        for suffix in ["linux-gnueabihf", "unknown-linux-gnueabihf", "none-eabi", "none-eabihf"]:
            if target == arch + "-" + suffix:
                return Ok(suffix)
    if normalized_arch == "riscv32":
        for suffix in ["unknown-linux-ilp32", "unknown-linux-ilp32d"]:
            if target == arch + "-" + suffix:
                return Ok(suffix)
    if normalized_arch == "riscv64" and target == arch + "-unknown-linux-lp64d":
        return Ok("unknown-linux-lp64d")
    Err("unsupported_explicit_target: unknown or incompatible OS/ABI tuple")

fn mir_target_context_normalize_arch(value: text) -> text:
    val arch = value.trim().lower()
    if arch == "amd64" or arch == "x64":
        return "x86_64"
    if arch == "i386" or arch == "i486" or arch == "i586" or arch == "i686":
        return "x86"
    if arch == "arm64":
        return "aarch64"
    if arch.starts_with("armv") or arch.starts_with("thumbv"):
        return "arm"
    if arch.starts_with("rv32") or arch.starts_with("riscv32"):
        return "riscv32"
    if arch.starts_with("rv64") or arch.starts_with("riscv64"):
        return "riscv64"
    arch

fn mir_target_context_normalize_os(value: text) -> text:
    val os = value.trim().lower()
    if os == "darwin" or os == "macos":
        return "macos"
    if os == "win" or os == "win32" or os == "win64" or os == "windows_nt":
        return "windows"
    if os == "none":
        return "baremetal"
    os

fn mir_target_context_uses_host(target: text) -> bool:
    target == "" or target == "host" or target == "native"

fn mir_target_context_os_from(target: text, host_os: text) -> text:
    if mir_target_context_uses_host(target):
        return mir_target_context_normalize_os(host_os)
    if target.contains("simpleos"):
        return "simpleos"
    if target.contains("baremetal") or target.contains("-none"):
        return "baremetal"
    if target.contains("darwin") or target.contains("macos"):
        return "macos"
    if target.contains("windows") or target.contains("mingw"):
        return "windows"
    if target.contains("freebsd"):
        return "freebsd"
    if target.contains("linux"):
        return "linux"
    mir_target_context_normalize_os(host_os)

fn mir_target_context_abi_from(target: text, os: text) -> text:
    if target.contains("mingw"):
        return "gnu"
    if target.contains("eabihf"):
        return "eabihf"
    if target.contains("musl"):
        return "musl"
    if target.contains("msvc"):
        return "msvc"
    if target.contains("macho"):
        return "macho"
    if target.contains("sysv"):
        return "sysv"
    if target.contains("lp64d"):
        return "lp64d"
    if target.contains("ilp32d"):
        return "ilp32d"
    if target.contains("ilp32"):
        return "ilp32"
    if target.contains("gnu"):
        return "gnu"
    if target.contains("eabi"):
        return "eabi"
    if os == "macos":
        return "macho"
    if os == "windows":
        return "msvc"
    if os == "freebsd":
        return "sysv"
    if os == "linux":
        return "gnu"
    "none"

fn mir_target_context_backend_from(value: text) -> text:
    val backend = value.trim().lower()
    if backend == "cranelift":
        return "cranelift"
    if backend == "native" or backend == "c" or backend == "cuda" or backend == "hip":
        return backend
    if backend == "opencl" or backend == "vhdl" or backend == "irtc" or backend == "lua":
        return backend
    "llvm"

# Strict preparation entrypoint for future target-bound readers. Legacy callers
# keep mir_target_context_from and its host/auto compatibility behavior.
# Callers still own target capabilities, semantic witnesses and artifact identity.
fn mir_target_context_from_explicit(target_triple: text, backend: text, version: i64) -> Result<MirTargetContext, text>:
    val target = target_triple.trim().lower()
    val suffix = _mir_target_context_explicit_suffix(target)
    if suffix.is_err():
        return Err(suffix.unwrap_err())
    val explicit_backend = backend.trim().lower()
    if not ["llvm", "llvm-lib", "llvmlib", "cranelift", "native", "c", "cuda", "hip",
        "opencl", "vhdl", "irtc", "lua"].contains(explicit_backend):
        return Err("explicit_backend_required: unknown or unresolved backend")
    Ok(mir_target_context_from(target, "", "", explicit_backend, version))

fn mir_target_context_from(
    target_triple: text,
    host_arch: text,
    host_os: text,
    backend: text,
    version: i64
) -> MirTargetContext:
    val target = target_triple.trim().lower()
    val arch = if mir_target_context_uses_host(target):
        mir_target_context_normalize_arch(host_arch)
    elif target == "simpleos":
        "x86_64"
    else:
        mir_target_context_normalize_arch(target.split("-")[0])
    val os = mir_target_context_os_from(target, host_os)
    val first = target.split("-")[0]
    val sub_src = if mir_target_context_uses_host(target): host_arch.trim().lower() else: first
    val subarch = if sub_src.starts_with("armv") or sub_src.starts_with("thumbv"): sub_src else: ""
    MirTargetContext(
        arch: arch,
        os: os,
        abi: mir_target_context_abi_from(target, os),
        backend: mir_target_context_backend_from(backend),
        version: version,
        subarch: subarch,
        collection_target_admitted: mir_collection_target_admitted(target, host_arch, host_os, backend.trim().lower())
    )
