# SFFI Wrapper Generator - Constrained Unit Declaration Scanner
#
# Line-based feed for constrained_unit_gen. Recognised lines:
#   unit Port: i32 as Pt in 1..=65535     constrained unit (range sugar)
#   unit Port: i32 as Pt in 1..65535      exclusive upper bound (max = hi - 1)
#   unit Port: i32 as Pt where 1 <= self <= 65535
#   unit Port: i32 as Pt where 1 <= self and self <= 65535
#   unit Port: i32 as Pt                  unit declaration (name, ABI type)
#   # @unit_range Port 1..65535           DEPRECATED alias of `in lo..=hi`;
#                                         still honoured (inclusive, either
#                                         side may be empty)
#   extern fn rt_net_port(fd: i32) -> Port
#   extern fn rt_version() -> CStr        borrowed `char*` return: copied to text
#                                         at once (Option<text>, None on null)
#   extern fn rt_flag(fd: i32) -> bool    C `_Bool` return: raw u8, values other
#                                         than 0/1 are a ConstraintError
#   enum Color: i32                       C enum over an explicit integer ABI;
#       Red                               the indented variant lines give the
#       Green                             sequential discriminants 0..=n-1
#   extern fn rt_color() -> Color         discriminant checked against 0..=n-1
# Each extern returning a declared unit becomes a facade (checked when the unit
# has a range, a direct projection otherwise). Externs returning anything else
# are ignored. The range comes from the declaration itself since 2026-11-17
# (same `where` predicate the compiler registers); the annotation comment is
# kept only as a deprecated alias.

use compiler.tools.sffi_gen.constrained_unit_gen.{ConstrainedUnitReturn, UnitReturnFacade, BorrowedCStrReturn, BoolReturn, EnumReturn, generate_unit_return_facade, generate_borrowed_cstr_facade, generate_bool_return_facade, generate_enum_return_facade}

struct _UnitDecl:
    name: text
    abi_type: text
    range_min: text
    range_max: text

fn _find_unit(units: [_UnitDecl], name: text) -> i64:
    var i = 0
    while i < units.len():
        if units[i].name == name:
            return i
        i = i + 1
    -1

fn _is_int_text(t: text) -> bool:
    if t == "": return false
    var i = 0
    if t[0:1] == "-": i = 1
    if i >= t.len(): return false
    while i < t.len():
        val c = t[i:i+1]
        if c < "0" or c > "9": return false
        i = i + 1
    true

# `lo <= self <= hi` / `lo <= self and self <= hi` / `self <= hi` / `lo <= self`
# -> (lo, hi) texts; any other predicate shape yields ("", "") (the facade is
# then a direct projection -- a non-range predicate has no inclusive bounds).
fn _bounds_from_where(pred: text) -> (text, text):
    var toks: [text] = []
    for t in pred.split(" "):
        if t != "": toks.push(t)
    var lo = ""
    var hi = ""
    var i = 0
    while i < toks.len():
        if toks[i] == "self":
            if i >= 2 and toks[i - 1] == "<=" and _is_int_text(toks[i - 2]): lo = toks[i - 2]
            if i + 2 < toks.len() and toks[i + 1] == "<=" and _is_int_text(toks[i + 2]): hi = toks[i + 2]
        i = i + 1
    (lo, hi)

# `lo..=hi` / `lo..hi` -> inclusive (lo, hi) texts (exclusive integer hi -> hi-1).
fn _bounds_from_range(range: text) -> (text, text):
    val inclusive = range.contains("..=")
    val bounds = if inclusive: range.split("..=") else: range.split("..")
    val lo = bounds[0].trim()
    var hi = if bounds.len() > 1: bounds[1].trim() else: ""
    if not inclusive and _is_int_text(hi):
        hi = "{int(hi) - 1}"
    (lo, hi)

fn _scan_units(lines: [text]) -> [_UnitDecl]:
    var units: [_UnitDecl] = []
    for raw in lines:
        val line = raw.trim()
        if line.starts_with("unit ") and line.contains(":") and line.contains(" as "):
            val head = line.split(":")
            val name = head[0].replace("unit ", "").trim()
            val rest = head[1]
            val abi = rest.split(" as ")[0].trim()
            var lo = ""
            var hi = ""
            if rest.contains(" in "):
                val b = _bounds_from_range(rest.split(" in ")[1].trim())
                lo = b.0
                hi = b.1
            elif rest.contains(" where "):
                val b = _bounds_from_where(rest.split(" where ")[1].trim())
                lo = b.0
                hi = b.1
            units.push(_UnitDecl(name: name, abi_type: abi, range_min: lo, range_max: hi))
    for raw in lines:
        val line = raw.trim()
        if line.starts_with("# @unit_range "):
            var parts: [text] = []
            for tok in line.replace("# @unit_range ", "").trim().split(" "):
                if tok != "":
                    parts.push(tok)
            if parts.len() == 2 and parts[1].contains(".."):
                val idx = _find_unit(units, parts[0])
                if idx >= 0:
                    val bounds = parts[1].split("..")
                    val lo = bounds[0].trim()
                    val hi = if bounds.len() > 1: bounds[1].trim() else: ""
                    units[idx] = _UnitDecl(name: units[idx].name, abi_type: units[idx].abi_type, range_min: lo, range_max: hi)
    units

# `enum Name: <abi>` followed by indented variant lines. An enum with no ABI
# type after the colon is a plain Simple enum and is not a C boundary type.
struct _EnumDecl:
    name: text
    abi_type: text
    variant_count: i64

fn _scan_enums(lines: [text]) -> [_EnumDecl]:
    var enums: [_EnumDecl] = []
    var i = 0
    while i < lines.len():
        val line = lines[i].split("#")[0].trim()
        i = i + 1
        if line.starts_with("enum ") and line.contains(":"):
            val head = line.substring(5).split(":")
            val abi = head[1].trim()
            if abi == "":
                continue
            var count = 0
            while i < lines.len():
                val raw = lines[i]
                val body = raw.split("#")[0].trim()
                if body != "" and not (raw.starts_with(" ") or raw.starts_with("\t")):
                    break
                if body != "":
                    count = count + 1
                i = i + 1
            enums.push(_EnumDecl(name: head[0].trim(), abi_type: abi, variant_count: count))
    enums

fn _find_enum(enums: [_EnumDecl], name: text) -> i64:
    var i = 0
    while i < enums.len():
        if enums[i].name == name:
            return i
        i = i + 1
    -1

# Return-type classes of a parsed extern signature.
val RET_CSTR: i64 = 1
val RET_OTHER: i64 = 0

struct _ExternSig:
    valid: bool
    name: text
    params: text
    ret_type: text
    ret_kind: i64

# Parse `extern fn name(params) -> Ret  # comment` into its parts. The return
# type is the text after the `->` that follows the parameter list's closing
# paren (so a `CStr` in a parameter or comment is never the return), with the
# trailing comment and any whitespace (spaces or tabs) removed. Dispatch is on
# `ret_kind`, never on the raw line text.
fn _parse_extern_sig(raw_line: text) -> _ExternSig:
    val none = _ExternSig(valid: false, name: "", params: "", ret_type: "", ret_kind: RET_OTHER)
    val line = raw_line.replace("\t", " ").split("#")[0].trim()
    if not line.starts_with("extern fn "):
        return none
    val rest = line.substring(10).trim()
    val open = rest.index_of("(")
    val close = rest.last_index_of(")")
    if open < 0 or close < open:
        return none
    val after = rest.substring(close + 1).trim()
    if not after.starts_with("->"):
        return none
    val ret = after.substring(2).trim()
    if ret == "":
        return none
    val kind = if ret == "CStr": RET_CSTR else: RET_OTHER
    _ExternSig(valid: true, name: rest.substring(0, open).trim(), params: rest.substring(open + 1, close), ret_type: ret, ret_kind: kind)

fn _arg_names(params: text) -> text:
    var names: [text] = []
    if params.trim() == "":
        return ""
    for p in params.split(","):
        names.push(p.split(":")[0].trim())
    names.join(", ")

# Generate facades for every extern fn returning a declared unit.
pub fn generate_constrained_unit_facades(source: text) -> UnitReturnFacade:
    val lines = source.split("\n")
    val units = _scan_units(lines)
    val enums = _scan_enums(lines)
    var out = ""
    for raw in lines:
        val sig = _parse_extern_sig(raw)
        if sig.valid:
            val name = sig.name
            val params = sig.params
            val ret = sig.ret_type
            if sig.ret_kind == RET_CSTR:
                val cspec = BorrowedCStrReturn(extern_name: name, params: params, arg_names: _arg_names(params))
                out = out + generate_borrowed_cstr_facade(cspec).source + "\n"
                continue
            if ret == "bool":
                val bspec = BoolReturn(extern_name: name, params: params, arg_names: _arg_names(params))
                out = out + generate_bool_return_facade(bspec).source + "\n"
                continue
            val eidx = _find_enum(enums, ret)
            if eidx >= 0:
                val espec = EnumReturn(extern_name: name, params: params, arg_names: _arg_names(params), enum_name: ret, first: "0", last: "{enums[eidx].variant_count - 1}", abi_type: enums[eidx].abi_type)
                val er = generate_enum_return_facade(espec)
                if er.diagnostic != "":
                    return UnitReturnFacade(source: "", diagnostic: er.diagnostic)
                out = out + er.source + "\n"
                continue
            val idx = _find_unit(units, ret)
            if idx >= 0:
                val spec = ConstrainedUnitReturn(extern_name: name, params: params, arg_names: _arg_names(params), unit_name: ret, abi_type: units[idx].abi_type, range_min: units[idx].range_min, range_max: units[idx].range_max)
                val r = generate_unit_return_facade(spec)
                if r.diagnostic != "":
                    return UnitReturnFacade(source: "", diagnostic: r.diagnostic)
                out = out + r.source + "\n"
    if out.contains("rt_cstring_to_text(ptr)"):
        out = "extern fn rt_cstring_to_text(ptr: i64) -> text\n\n" + out
    if out.contains("ConstraintError"):
        out = "use std.common.constraint_error.{{ConstraintError}}\n\n" + out
    UnitReturnFacade(source: out, diagnostic: "")
