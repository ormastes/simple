# Incremental duplicate detection - only reprocess changed files
#
# Caches previous analysis results and reuses them for unchanged files.
# Based on src/app/build/incremental.spl pattern.

use compiler.tools.duplicate_check.config.{DuplicationConfig, compute_config_hash}
use compiler.tools.duplicate_check.cache.{TokenCacheManager}
use compiler.tools.duplicate_check._Detector.interner_and_logging.{
    DuplicateBlock, find_duplicates_in_file, fast_line_window_blocks_in_file,
    new_token_interner
}
use compiler.tools.duplicate_check.math_utils.{hash_string}
use std.nogc_sync_mut.io.file_ops.{file_exists, file_read, file_hash_sha256}
use std.nogc_sync_mut.io.time_ops.{current_time_ms}
use std.nogc_sync_mut.io.dir_ops.{dir_create_all}
use std.common.base_encoding.utilities.{base_encoding_text_to_bytes as text_to_bytes, base_encoding_bytes_to_text as bytes_to_text}

extern fn rt_file_write_text(path: text, content: text) -> bool

struct IncrementalCacheEntry:
    file_path: text
    source_hash: text       # SHA256 hash of file content
    timestamp: i64          # When this was cached
    blocks: [DuplicateBlock]

struct IncrementalCache:
    entries: {text: IncrementalCacheEntry}
    cache_path: text
    config_hash: text       # Hash of config to detect config changes

fn escape_cache_text(value: text) -> text:
    val digits = "0123456789abcdef"
    var escaped = ""
    val bytes = text_to_bytes(value)
    var i = 0
    while i < bytes.len():
        val byte = bytes[i] as i64
        escaped = escaped + digits[byte / 16:byte / 16 + 1]
        escaped = escaped + digits[byte % 16:byte % 16 + 1]
        i = i + 1
    escaped

fn cache_hex_value(ch: text) -> i64:
    val lower = ch.to_lower()
    if lower == "0": 0
    elif lower == "1": 1
    elif lower == "2": 2
    elif lower == "3": 3
    elif lower == "4": 4
    elif lower == "5": 5
    elif lower == "6": 6
    elif lower == "7": 7
    elif lower == "8": 8
    elif lower == "9": 9
    elif lower == "a": 10
    elif lower == "b": 11
    elif lower == "c": 12
    elif lower == "d": 13
    elif lower == "e": 14
    elif lower == "f": 15
    else: -1

fn unescape_cache_text(value: text) -> (text, bool):
    if value.len() % 2 != 0:
        return ("", false)
    var bytes: [u8] = []
    var i = 0
    while i < value.len():
        val high = cache_hex_value(value[i:i + 1])
        val low = cache_hex_value(value[i + 1:i + 2])
        if high < 0 or low < 0:
            return ("", false)
        bytes.push((high * 16 + low) as u8)
        i = i + 2
    val decoded = bytes_to_text(bytes)
    if escape_cache_text(decoded) != value.to_lower():
        return ("", false)
    (decoded, true)

fn stable_block_hash(block: DuplicateBlock) -> i64:
    if block.code.len() > 0:
        return int(hash_string("{block.token_count}|{block.line_end - block.line_start}|{block.code}"))
    block.hash_value

fn normalize_block_hashes(blocks: [DuplicateBlock]) -> [DuplicateBlock]:
    var normalized = []
    for block in blocks:
        normalized.push(DuplicateBlock(
            file: block.file,
            line_start: block.line_start,
            line_end: block.line_end,
            token_count: block.token_count,
            hash_value: stable_block_hash(block),
            snippet_start_offset: block.snippet_start_offset,
            snippet_end_offset: block.snippet_end_offset,
            code: block.code
        ))
    normalized

fn cache_parent_dir(path: text) -> text:
    var last_slash = -1
    var i = 0
    while i < path.len():
        if path[i:i + 1] == "/":
            last_slash = i
        i = i + 1

    if last_slash <= 0:
        return "."

    path[0:last_slash]

fn load_incremental_cache(cache_path: text, config: DuplicationConfig) -> IncrementalCache:
    val current_config_hash = compute_config_hash(config)
    if not file_exists(cache_path):
        return IncrementalCache(
            entries: {},
            cache_path: cache_path,
            config_hash: current_config_hash
        )

    val content = file_read(cache_path)
    val lines = content.split("\n")

    var entries = {}
    var stored_config_hash = ""
    var format_ok = false
    var malformed = false
    var i = 0

    while i < lines.len():
        val line = lines[i]

        if line == "# format: 2":
            format_ok = true
        elif line.starts_with("# config_hash:"):
            stored_config_hash = line.substring(14, line.len()).trim()
        elif line.starts_with("#") or line.len() == 0:
            i = i + 1
            continue
        elif line.starts_with("file:"):
            val parts = line.split("|")
            if parts.len() != 4:
                malformed = true
                break
            val (file_path, path_ok) = unescape_cache_text(parts[0].substring(5, parts[0].len()))
            val timestamp_opt = parts[2].parse_int()
            val block_count_opt = parts[3].parse_int()
            if not path_ok or file_path.len() == 0 or not timestamp_opt.? or not block_count_opt.?:
                malformed = true
                break
            val timestamp = timestamp_opt ?? 0
            val block_count = block_count_opt ?? 0
            if block_count < 0 or block_count > lines.len() - i - 1:
                malformed = true
                break

            var blocks = []
            var j = 0
            while j < block_count:
                val block_line = lines[i + 1 + j]
                if not block_line.starts_with("  "):
                    malformed = true
                    break
                val block_parts = block_line.substring(2, block_line.len()).split("|")
                if block_parts.len() != 7:
                    malformed = true
                    break
                val line_start = block_parts[0].parse_int()
                val line_end = block_parts[1].parse_int()
                val token_count = block_parts[2].parse_int()
                val hash_value = block_parts[3].parse_int()
                val snippet_start = block_parts[4].parse_int()
                val snippet_end = block_parts[5].parse_int()
                val (code, code_ok) = unescape_cache_text(block_parts[6])
                if not line_start.? or not line_end.? or not token_count.? or not hash_value.? or not snippet_start.? or not snippet_end.? or not code_ok:
                    malformed = true
                    break
                val parsed_line_start = line_start ?? 0
                val parsed_line_end = line_end ?? 0
                val parsed_token_count = token_count ?? 0
                val parsed_snippet_start = snippet_start ?? 0
                val parsed_snippet_end = snippet_end ?? 0
                val offsets_valid = (parsed_snippet_start == -1 and parsed_snippet_end == -1) or (parsed_snippet_start >= 0 and parsed_snippet_end >= parsed_snippet_start)
                if parsed_line_start < 1 or parsed_line_end < parsed_line_start or parsed_token_count <= 0 or not offsets_valid:
                    malformed = true
                    break
                blocks.push(DuplicateBlock(
                    file: file_path,
                    line_start: parsed_line_start,
                    line_end: parsed_line_end,
                    token_count: parsed_token_count,
                    hash_value: hash_value ?? 0,
                    snippet_start_offset: parsed_snippet_start,
                    snippet_end_offset: parsed_snippet_end,
                    code: code
                ))
                j = j + 1
            if malformed:
                break
            entries[file_path] = IncrementalCacheEntry(
                file_path: file_path,
                source_hash: parts[1],
                timestamp: timestamp,
                blocks: blocks
            )
            i = i + block_count
        else:
            malformed = true
            break
        i = i + 1

    if malformed or not format_ok or stored_config_hash != current_config_hash:
        return IncrementalCache(
            entries: {},
            cache_path: cache_path,
            config_hash: current_config_hash
        )

    IncrementalCache(
        entries: entries,
        cache_path: cache_path,
        config_hash: current_config_hash
    )

fn save_incremental_cache(cache: IncrementalCache) -> bool:
    # Ensure the cache directory exists before writing the serialized snapshot
    val cache_dir = cache_parent_dir(cache.cache_path)
    if not dir_create_all(cache_dir):
        return false

    var lines = []
    lines.push("# Duplicate detection incremental cache")
    lines.push("# format: 2")
    lines.push("# config_hash: {cache.config_hash}")
    lines.push("")

    for file_path in cache.entries.keys():
        val entry = cache.entries[file_path]
        lines.push("file:{escape_cache_text(file_path)}|{entry.source_hash}|{entry.timestamp}|{entry.blocks.len()}")

        for block in entry.blocks:
            val code = escape_cache_text(block.code)
            lines.push("  {block.line_start}|{block.line_end}|{block.token_count}|{block.hash_value}|{block.snippet_start_offset}|{block.snippet_end_offset}|{code}")

        lines.push("")

    rt_file_write_text(cache.cache_path, lines.join("\n"))

fn needs_reprocessing(
    file_path: text,
    cache: IncrementalCache
) -> bool:
    val cache_key = find_cache_entry_key(cache, file_path)
    if cache_key == "":
        return true  # File not in cache

    val entry = cache.entries[cache_key]
    val current_hash = file_hash_sha256(file_path)

    current_hash != entry.source_hash

fn get_cached_blocks(
    file_path: text,
    cache: IncrementalCache
) -> [DuplicateBlock]:
    val cache_key = find_cache_entry_key(cache, file_path)
    if cache_key != "":
        val entry = cache.entries[cache_key]
        val current_hash = file_hash_sha256(file_path)
        if current_hash == entry.source_hash:
            return entry.blocks

    []

fn find_cache_entry_key(cache: IncrementalCache, file_path: text) -> text:
    for key in cache.entries.keys():
        if key == file_path:
            return key
    ""

fn update_cache_entry(
    cache: IncrementalCache,
    file_path: text,
    blocks: [DuplicateBlock]
) -> IncrementalCache:
    val source_hash = file_hash_sha256(file_path)
    val timestamp = current_time_ms()
    var updated_cache = cache

    updated_cache.entries[file_path] = IncrementalCacheEntry(
        file_path: file_path,
        source_hash: source_hash,
        timestamp: timestamp,
        blocks: blocks
    )
    return updated_cache

fn prune_deleted_cache_entries(cache: IncrementalCache, files: [text]) -> IncrementalCache:
    var present = {}
    for file_path in files:
        present[file_path] = true
    var retained = {}
    for file_path in cache.entries.keys():
        if present.has(file_path):
            retained[file_path] = cache.entries[file_path]
    var updated = cache
    updated.entries = retained
    updated

fn process_files_incremental(
    files: [text],
    config: DuplicationConfig,
    cache: IncrementalCache,
    cache_manager: TokenCacheManager
) -> ([DuplicateBlock], IncrementalStats):
    var all_blocks: [DuplicateBlock] = []
    var cached_files = 0
    val interner = new_token_interner()

    for file_path in files:
        if needs_reprocessing(file_path, cache):
            val raw_blocks = if config.selected_mode == "token":
                fast_line_window_blocks_in_file(file_path, config)
            else:
                find_duplicates_in_file(file_path, config, cache_manager, interner)
            val blocks = normalize_block_hashes(raw_blocks)
            cache = update_cache_entry(cache, file_path, blocks)
            all_blocks.merge(blocks)
        else:
            cached_files = cached_files + 1
            val cached_blocks = get_cached_blocks(file_path, cache)
            all_blocks.merge(cached_blocks)

    val stats = compute_incremental_stats(files.len(), cached_files)
    cache = prune_deleted_cache_entries(cache, files)
    if not save_incremental_cache(cache):
        eprint("duplicate-check: could not write incremental cache: {cache.cache_path}")
    (all_blocks, stats)

struct IncrementalStats:
    total_files: i64
    cached_files: i64
    reprocessed_files: i64
    cache_hit_rate: f64

fn compute_incremental_stats(
    total_files: i64,
    cached_files: i64
) -> IncrementalStats:
    val cache_hit_rate = if total_files > 0:
        (cached_files * 100) / total_files
    else:
        0

    IncrementalStats(
        total_files: total_files,
        cached_files: cached_files,
        reprocessed_files: total_files - cached_files,
        cache_hit_rate: cache_hit_rate
    )

fn format_incremental_stats(stats: IncrementalStats) -> text:
    "Incremental: {stats.reprocessed_files} changed, {stats.cached_files} cached ({stats.cache_hit_rate}% hit rate)"
