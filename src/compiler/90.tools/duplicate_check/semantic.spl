# Semantic doc similarity orchestrator
# Two modes:
#   semantic     — local docstring/signature token-vector comparison (default, fast)
#   semantic-llm — Ollama embedding comparison (requires running Ollama server)

use compiler.tools.duplicate_check.config.{DuplicationConfig}
use compiler.tools.duplicate_check.doc_extractor.{DocEntry, extract_docs_from_directory, build_embedding_key, content_hash}
use lazy compiler.tools.duplicate_check.ollama_client.{EmbeddingResult, check_ollama_available, get_embedding}
use compiler.tools.duplicate_check.embedding_cache.{EmbeddingCacheManager, load_embedding_cache, save_embedding_cache, lookup_cached, set_cached, csv_to_floats, floats_to_csv}
use compiler.tools.duplicate_check.similarity.{SimilarityEngine, SimilarityInput, similarity_for_mode, similarity_input_text, featurize_all, similar_pairs}
use compiler.tools.duplicate_check.similarity.{text_similarity}
use compiler.tools.duplicate_check.math_utils.{cosine_similarity_dense}

struct SemanticMatch:
    entry_a: DocEntry
    entry_b: DocEntry
    similarity: f64
    match_kind: text

struct SemanticReport:
    matches: [SemanticMatch]
    missing_docs: [DocEntry]
    total_items: i64
    items_with_docs: i64
    cache_hits: i64
    cache_misses: i64
    used_fallback: bool

struct DocEntryPartition:
    documented: [DocEntry]
    missing_docs: [DocEntry]

fn partition_doc_entries(entries: [DocEntry]) -> DocEntryPartition:
    var documented: [DocEntry] = []
    var missing_docs: [DocEntry] = []
    for entry in entries:
        if entry.has_doc:
            documented.push(entry)
        else:
            missing_docs.push(entry)
    DocEntryPartition(documented: documented, missing_docs: missing_docs)

fn semantic_match_kind(sim: f64) -> text:
    if sim >= 0.97:
        return "copy_paste"
    "similar"

fn make_semantic_match(a: DocEntry, b: DocEntry, sim: f64, suffix: text) -> SemanticMatch:
    SemanticMatch(
        entry_a: a,
        entry_b: b,
        similarity: sim,
        match_kind: semantic_match_kind(sim) + suffix
    )

fn run_semantic_analysis(target_path: text, config: DuplicationConfig) -> SemanticReport:
    val all_entries = extract_docs_from_directory(target_path, config.exclude_patterns)
    if all_entries.len() == 0:
        return empty_report()

    val partition = partition_doc_entries(all_entries)
    val documented = partition.documented
    val missing_docs = partition.missing_docs

    # Check if Ollama is available
    val ollama_ok = check_ollama_available(config.ollama_url)

    if not ollama_ok:
        print "WARNING: Ollama not available at {config.ollama_url}"
        print "  Install Ollama and pull model: ollama pull {config.semantic_model}"
        print ""
        print "Falling back to text-based similarity..."
        print ""
        val fallback_report = run_text_fallback(documented, config.semantic_threshold, config.semantic_drift_threshold)
        return SemanticReport(
            matches: fallback_report.matches,
            missing_docs: missing_docs,
            total_items: all_entries.len(),
            items_with_docs: documented.len(),
            cache_hits: 0,
            cache_misses: 0,
            used_fallback: true
        )

    # Load embedding cache
    val cache_path = ".semantic_cache.txt"
    var cache = load_embedding_cache(cache_path, config.semantic_model)
    if config.rebuild_embeddings:
        cache = load_embedding_cache("/dev/null/nonexistent", config.semantic_model)

    # Get embeddings for all documented entries
    var embeddings: [[f64]] = []
    var cache_hits = 0
    var cache_misses = 0
    var embed_idx = 0
    while embed_idx < documented.len():
        val entry = documented[embed_idx]
        val emb_key = entry.file_path + "::" + entry.item_name
        val emb_text = build_embedding_key(entry)
        val hash = content_hash(emb_text)

        # Check cache first
        val lookup = lookup_cached(cache, emb_key, hash)
        if lookup.hit:
            cache_hits = cache_hits + 1
            # NOTE: local name must not be `vec` — HIR lowering resolves `vec`
            # to the builtin and fails, knocking the module off the JIT path.
            val cached_vec = csv_to_floats(lookup.embedding_csv)
            embeddings.push(cached_vec)
        else:
            cache_misses = cache_misses + 1
            # Fetch from Ollama
            val result = get_embedding(config.ollama_url, config.semantic_model, emb_text)
            if result.error.len() == 0 and result.vector.len() > 0:
                val csv = floats_to_csv(result.vector)
                cache = set_cached(cache, emb_key, hash, csv)
                embeddings.push(result.vector)
            else:
                embeddings.push([])

        embed_idx = embed_idx + 1

    # Save cache
    save_embedding_cache(cache)

    # Find similar pairs
    val matches = find_similar_pairs(documented, embeddings, config.semantic_threshold, config.semantic_drift_threshold)

    SemanticReport(
        matches: matches,
        missing_docs: missing_docs,
        total_items: all_entries.len(),
        items_with_docs: documented.len(),
        cache_hits: cache_hits,
        cache_misses: cache_misses,
        used_fallback: false
    )

fn semantic_matches(engine: SimilarityEngine, documented: [DocEntry], inputs: [SimilarityInput], threshold: f64, suffix: text) -> [SemanticMatch]:
    """Drive one SimilarityAlgorithm over doc entries: featurize -> candidates
    -> shared threshold scoring; records keep candidate order."""
    val features = featurize_all(engine, inputs)
    val scored = similar_pairs(engine, features, [], threshold)
    var matches: [SemanticMatch] = []
    for p in scored:
        matches.push(make_semantic_match(documented[p.left], documented[p.right], p.score, suffix))
    matches

fn find_similar_pairs(entries: [DocEntry], embeddings: [[f64]], threshold: f64, drift_threshold: f64) -> [SemanticMatch]:
    var inputs: [SimilarityInput] = []
    var i = 0
    while i < entries.len():
        inputs.push(SimilarityInput(text_val: "", tokens: [], embedding: embeddings[i]))
        i = i + 1
    val matches = semantic_matches(similarity_for_mode("semantic-llm", false), entries, inputs, threshold, "")

    # Sort by similarity descending (quicksort)
    if matches.len() > 1:
        quicksort_matches_by_sim(matches, 0, matches.len() - 1)

    matches

fn quicksort_matches_by_sim(arr: [SemanticMatch], low: i64, high: i64):
    if low >= high:
        return
    val pivot_sim = arr[(low + high) / 2].similarity
    var i = low
    var j = high
    while i <= j:
        while arr[i].similarity > pivot_sim:
            i = i + 1
        while arr[j].similarity < pivot_sim:
            j = j - 1
        if i <= j:
            val tmp = arr[i]
            arr[i] = arr[j]
            arr[j] = tmp
            i = i + 1
            j = j - 1
    if low < j:
        quicksort_matches_by_sim(arr, low, j)
    if i < high:
        quicksort_matches_by_sim(arr, i, high)

fn run_text_fallback(entries: [DocEntry], threshold: f64, drift_threshold: f64) -> SemanticReport:
    var inputs: [SimilarityInput] = []
    for entry in entries:
        inputs.push(similarity_input_text(entry.doc_comment))
    val matches = semantic_matches(similarity_for_mode("semantic-text", false), entries, inputs, threshold, " [text-based]")

    SemanticReport(
        matches: matches,
        missing_docs: [],
        total_items: entries.len(),
        items_with_docs: entries.len(),
        cache_hits: 0,
        cache_misses: 0,
        used_fallback: true
    )

fn run_semantic_analysis_local(target_path: text, config: DuplicationConfig) -> SemanticReport:
    val all_entries = extract_docs_from_directory(target_path, config.exclude_patterns)
    if all_entries.len() == 0:
        return empty_report()

    val partition = partition_doc_entries(all_entries)
    val documented = partition.documented
    val missing_docs = partition.missing_docs

    var inputs: [SimilarityInput] = []
    for entry in documented:
        inputs.push(similarity_input_text(build_embedding_key(entry)))

    # use-lsh-prefilter swaps the candidate prefilter (signature buckets ->
    # MinHash/LSH banding); featurize and scoring are unchanged.
    val engine = similarity_for_mode("semantic", config.use_lsh_prefilter)
    val matches = semantic_matches(engine, documented, inputs, config.semantic_threshold, "")

    if matches.len() > 1:
        quicksort_matches_by_sim(matches, 0, matches.len() - 1)

    SemanticReport(
        matches: matches,
        missing_docs: missing_docs,
        total_items: all_entries.len(),
        items_with_docs: documented.len(),
        cache_hits: 0,
        cache_misses: 0,
        used_fallback: false
    )

fn empty_report() -> SemanticReport:
    SemanticReport(
        matches: [],
        missing_docs: [],
        total_items: 0,
        items_with_docs: 0,
        cache_hits: 0,
        cache_misses: 0,
        used_fallback: false
    )
