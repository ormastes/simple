# Tokenizer for duplication detection
# Uses pure Simple lexer for performance

use compiler.tools.duplicate_check.config (DuplicationConfig)

enum SimpleTokenKind:
    Identifier
    Keyword
    Operator
    Literal
    Punctuation
    Comment
    Whitespace

struct SimpleToken:
    kind: SimpleTokenKind
    value: text
    line: i64
    column: i64
    start_offset: i64
    end_offset: i64

# Code-point slicing in O(slice length). `text[a:b]` and `text.len()` count
# code points and walk from the start of a non-ASCII text, so slicing every
# token of a 200 KB file with one non-ASCII byte was quadratic (8.9 s vs 12 ms
# for a 47 KB ASCII file). `slice` returns exactly what `source[a:b]` returns
# (same clamping): non-ASCII text is cut once into SLICE_CHUNK-code-point
# chunks (themselves `source[..]` slices), so each slice walks one short chunk.
# Gap + latent byte/code-point offset mix-up:
# doc/08_tracking/bug/2026-11-24_dupcheck_codepoint_slice_quadratic_non_ascii.md
val SLICE_CHUNK: i64 = 4096

struct SourceSlicer:
    source: text
    ascii: bool
    char_len: i64
    chunks: [text]

fn is_ascii_text(source: text) -> bool:
    for b in source.bytes():
        if b >= 128:
            return false
    true

# @allow(primitive_api) code-point offsets are the plain i64 offsets text slicing already takes
pub fn source_slicer_new(source: text) -> SourceSlicer:
    val char_len = source.len()
    if is_ascii_text(source):
        return SourceSlicer(source: source, ascii: true, char_len: char_len, chunks: [])
    var chunks: [text] = []
    var at = 0
    while at < char_len:
        chunks.push(source[at:at + SLICE_CHUNK])
        at = at + SLICE_CHUNK
    SourceSlicer(source: source, ascii: false, char_len: char_len, chunks: chunks)

# @allow(primitive_api) code-point offsets are the plain i64 offsets text slicing already takes
pub fn source_slice(slicer: SourceSlicer, start: i64, end: i64) -> text:
    if slicer.ascii:
        return slicer.source[start:end]
    val n = slicer.char_len
    val a = if start > n: n else: start
    val b = if end > n: n else: end
    if b <= a:
        return ""
    val first = a / SLICE_CHUNK
    val last = (b - 1) / SLICE_CHUNK
    val base = first * SLICE_CHUNK
    if first == last:
        return slicer.chunks[first][a - base:b - base]
    var out = slicer.chunks[first][a - base:SLICE_CHUNK]
    var k = first + 1
    while k < last:
        out = out + slicer.chunks[k]
        k = k + 1
    out + slicer.chunks[last][0:b - last * SLICE_CHUNK]

fn token_to_string(token: SimpleToken) -> text:
    "{token.kind}:{token.value}"

fn is_keyword_text(value: text) -> bool:
    value == "fn" or value == "val" or value == "var" or value == "if" or value == "else" or value == "while" or value == "for" or value == "match" or value == "case" or value == "return" or value == "break" or value == "continue" or value == "class" or value == "struct" or value == "enum" or value == "use" or value == "export"

fn match_operator_bytes(bytes: [u8], slicer: SourceSlicer, source_len: i64, index: i64) -> text:
    if index >= source_len:
        return ""
    val b = bytes[index]
    val has_next = index + 1 < source_len
    val nb = if has_next: bytes[index + 1] else: 0

    if b == 61 and nb == 61:
        return "=="
    if b == 33 and nb == 61:
        return "!="
    if b == 60 and nb == 61:
        return "<="
    if b == 62 and nb == 61:
        return ">="
    if b == 45 and nb == 62:
        return "->"
    if b == 43 or b == 45 or b == 42 or b == 47 or b == 61 or b == 60 or b == 62 or b == 58 or b == 46 or b == 44 or b == 40 or b == 41 or b == 91 or b == 93 or b == 123 or b == 125:
        return source_slice(slicer, index, index + 1)
    ""

fn is_c_source_path(path: text) -> bool:
    path.ends_with(".c") or path.ends_with(".h")

pub fn tokenize_for_path(path: text, source: text, config: DuplicationConfig) -> [SimpleToken]:
    """Tokenize with C comment rules (`//`, `/* */`) for .c/.h files."""
    tokenize_mode(source, config, is_c_source_path(path))

fn tokenize(source: text, config: DuplicationConfig) -> [SimpleToken]:
    tokenize_mode(source, config, false)

fn tokenize_mode(source: text, config: DuplicationConfig, c_mode: bool) -> [SimpleToken]:
    var result: [SimpleToken] = []
    var i = 0
    var line = 1
    var column = 1
    val slicer = source_slicer_new(source)
    val source_len = slicer.char_len
    val bytes = source.bytes()

    while i < source_len:
        val b = bytes[i]
        var handled = false

        if b == 10:
            if not config.ignore_whitespace:
                result.push(SimpleToken(kind: SimpleTokenKind.Whitespace, value: "\n", line: line, column: column, start_offset: i, end_offset: i + 1))
            line = line + 1
            column = 1
            i = i + 1
            handled = true

        if not handled:
            if b == 32 or b == 9:
                if not config.ignore_whitespace:
                    result.push(SimpleToken(kind: SimpleTokenKind.Whitespace, value: source_slice(slicer, i, i + 1), line: line, column: column, start_offset: i, end_offset: i + 1))
                i = i + 1
                column = column + 1
                handled = true

        if not handled and c_mode and b == 47 and i + 1 < source_len:
            if bytes[i + 1] == 47:
                while i < source_len and bytes[i] != 10:
                    i = i + 1
                handled = true
            elif bytes[i + 1] == 42:
                i = i + 2
                column = column + 2
                while i < source_len and not (bytes[i] == 42 and i + 1 < source_len and bytes[i + 1] == 47):
                    if bytes[i] == 10:
                        line = line + 1
                        column = 1
                    else:
                        column = column + 1
                    i = i + 1
                i = i + 2
                column = column + 2
                handled = true

        if not handled:
            if b == 35:
                while i < source_len and bytes[i] != 10:
                    i = i + 1
                handled = true

        if not handled:
            val is_letter = (b >= 97 and b <= 122) or (b >= 65 and b <= 90) or b == 95
            if is_letter:
                val start_idx = i
                var start_col = column
                while i < source_len:
                    val c = bytes[i]
                    val is_alnum = (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57) or c == 95
                    if not is_alnum:
                        break
                    i = i + 1
                    column = column + 1
                val ident = source_slice(slicer, start_idx, i)
                val is_keyword = is_keyword_text(ident)
                val kind = if is_keyword: SimpleTokenKind.Keyword else: SimpleTokenKind.Identifier
                val value = if kind == SimpleTokenKind.Identifier and config.ignore_identifiers then "IDENTIFIER" else ident
                result.push(SimpleToken(kind: kind, value: value, line: line, column: start_col, start_offset: start_idx, end_offset: i))
                handled = true

        if not handled:
            val is_digit = b >= 48 and b <= 57
            if is_digit:
                val start_idx = i
                var start_col = column
                while i < source_len:
                    val c = bytes[i]
                    val is_numchar = (c >= 48 and c <= 57) or c == 46
                    if not is_numchar:
                        break
                    i = i + 1
                    column = column + 1
                val num = source_slice(slicer, start_idx, i)
                val value = if config.ignore_literals then "LITERAL" else num
                result.push(SimpleToken(kind: SimpleTokenKind.Literal, value: value, line: line, column: start_col, start_offset: start_idx, end_offset: i))
                handled = true

        if not handled:
            val next_is_label = b == 39 and i + 1 < source_len and (((bytes[i + 1] >= 97 and bytes[i + 1] <= 122) or (bytes[i + 1] >= 65 and bytes[i + 1] <= 90) or bytes[i + 1] == 95))
            if b == 34 or (b == 39 and not next_is_label):
                val start_idx = i
                val start_line = line
                val start_col = column
                val quote = b
                val is_triple = i + 2 < source_len and bytes[i + 1] == quote and bytes[i + 2] == quote
                val quote_len = if is_triple: 3 else: 1
                i = i + quote_len
                column = column + quote_len
                var closed = false
                while i < source_len and not closed:
                    if is_triple and i + 2 < source_len and bytes[i] == quote and bytes[i + 1] == quote and bytes[i + 2] == quote:
                        i = i + 3
                        column = column + 3
                        closed = true
                    elif not is_triple and bytes[i] == quote:
                        i = i + 1
                        column = column + 1
                        closed = true
                    elif not is_triple and bytes[i] == 92 and i + 1 < source_len:
                        if bytes[i + 1] == 10:
                            line = line + 1
                            column = 1
                        else:
                            column = column + 2
                        i = i + 2
                    else:
                        if bytes[i] == 10:
                            line = line + 1
                            column = 1
                        else:
                            column = column + 1
                        i = i + 1
                val str_val = source_slice(slicer, start_idx, i)
                val value = if config.ignore_literals then "LITERAL" else str_val
                result.push(SimpleToken(kind: SimpleTokenKind.Literal, value: value, line: start_line, column: start_col, start_offset: start_idx, end_offset: i))
                handled = true

        if not handled:
            val op = match_operator_bytes(bytes, slicer, source_len, i)
            if op.len() > 0:
                result.push(SimpleToken(kind: SimpleTokenKind.Operator, value: op, line: line, column: column, start_offset: i, end_offset: i + op.len()))
                i = i + op.len()
                column = column + op.len()
                handled = true

        if not handled:
            i = i + 1
            column = column + 1

    result
