# Leak Check - Core Types
#
# Data structures for unified memory leak detection.

# Mode of leak checking
enum LeakCheckMode:
    Internal
    External
    Both
    Runtime

fn leak_check_mode_to_string(m: LeakCheckMode) -> text:
    match m:
        case LeakCheckMode.Internal: "internal"
        case LeakCheckMode.External: "external"
        case LeakCheckMode.Both: "both"
        case LeakCheckMode.Runtime: "runtime"

fn leak_check_mode_from_string(s: text):
    match s.lower():
        case "internal": LeakCheckMode.Internal
        case "external": LeakCheckMode.External
        case "both": LeakCheckMode.Both
        case "runtime": LeakCheckMode.Runtime
        case _: nil

# External tool selection
enum ExternalTool:
    Asan
    Valgrind

fn external_tool_to_string(t: ExternalTool) -> text:
    match t:
        case ExternalTool.Asan: "asan"
        case ExternalTool.Valgrind: "valgrind"

fn external_tool_from_string(s: text):
    match s.lower():
        case "asan": ExternalTool.Asan
        case "valgrind": ExternalTool.Valgrind
        case _: nil

# Report output format
enum ReportFormat:
    Console
    Sdn
    Markdown

fn report_format_to_string(f: ReportFormat) -> text:
    match f:
        case ReportFormat.Console: "console"
        case ReportFormat.Sdn: "sdn"
        case ReportFormat.Markdown: "md"

fn report_format_from_string(s: text):
    match s.lower():
        case "console": ReportFormat.Console
        case "sdn": ReportFormat.Sdn
        case "md" | "markdown": ReportFormat.Markdown
        case _: nil

# Kind of target being leak-checked (Auto = infer from source_file suffix)
enum TargetKind:
    Auto
    SDoctest
    SimpleTest
    Program
    Shell

# A single RSS-growth observation from the growth runner
class GrowthEvent:
    kind: text
    baseline_rss_kb: i64
    observed_rss_kb: i64
    delta_kb: i64
    detail: text

# A single static (source-text) allocation-rule violation from the static
# runner. Declared here -- the module every leak_check consumer and the
# app.leak_check.types facade already import it from -- after it was lost:
# the manual stage3 per-module object sweep failed all six
# src/compiler/90.tools/leak_check/*.spl consumer modules with
# `unresolved type: StaticViolation`, the name was declared nowhere in the
# tree, and the app facade's re-export of it turned the break into a
# fabricated-position error three layers from the cause. Field set is
# exactly the two construction sites in static_runner.spl
# (alloc_import summary + no_alloc_violation report).
class StaticViolation:
    function_name: text
    category: text
    detail: text
    source_line: i64

# Configuration for leak check
class LeakCheckConfig:
    mode: LeakCheckMode
    external_tool: ExternalTool
    report_format: ReportFormat
    verbose: bool
    source_file: text
    output_file: text
    compiler_override: text
    track_source_locations: bool
    gc_leak_window: i64
    timeout_seconds: i64
    target_kind: TargetKind

fn default_leak_check_config() -> LeakCheckConfig:
    LeakCheckConfig(
        mode: LeakCheckMode.Internal,
        external_tool: ExternalTool.Asan,
        report_format: ReportFormat.Console,
        verbose: false,
        source_file: "",
        output_file: "",
        compiler_override: "",
        track_source_locations: false,
        gc_leak_window: 4096,
        timeout_seconds: 10,
        target_kind: TargetKind.Auto
    )

# A single allocation record tracked by the internal tracker
class AllocationRecord:
    address: i64
    size: i64
    type_id: text
    source_file: text
    source_line: i64
    source_function: text
    timestamp_us: i64
    freed: bool

# Histogram bucket for allocation grouping
class AllocBucket:
    label: text
    count: i64
    total_bytes: i64

# Overall result of a leak check run
class LeakCheckResult:
    mode: text
    internal_leaks: [AllocationRecord]
    external_report: ExternalLeakReport
    duration_ms: i64
    exit_code: i64
    growth_events: [GrowthEvent]
    evidence_level: text

fn empty_leak_check_result() -> LeakCheckResult:
    LeakCheckResult(
        mode: "internal",
        internal_leaks: [],
        external_report: empty_external_leak_report(),
        duration_ms: 0,
        exit_code: 0,
        growth_events: [],
        evidence_level: ""
    )

# Report from an external leak detection tool
class ExternalLeakReport:
    tool: text
    raw_output: text
    leaks: [ExternalLeak]
    definitely_lost_bytes: i64
    indirectly_lost_bytes: i64
    possibly_lost_bytes: i64
    still_reachable_bytes: i64

fn empty_external_leak_report() -> ExternalLeakReport:
    ExternalLeakReport(
        tool: "",
        raw_output: "",
        leaks: [],
        definitely_lost_bytes: 0,
        indirectly_lost_bytes: 0,
        possibly_lost_bytes: 0,
        still_reachable_bytes: 0
    )

# A single leak detected by an external tool
class ExternalLeak:
    bytes: i64
    blocks: i64
    category: text
    stack_frames: [text]


# Sibling modules (config.spl, external_runner.spl, growth_runner.spl,
# internal_runner.spl, internal_tracker.spl, light_main.spl, reporter.spl)
# reach these types through directory-package sibling registration, which the
# entry-closure HIR path only satisfies for EXPORTED symbols (the seed's flat
# registry resolved unexported siblings for free). Without this, the full-CLI
# tool build reports `unresolved type: LeakCheckResult` et al. against every
# sibling (2026-10-15).
export LeakCheckMode, leak_check_mode_to_string, leak_check_mode_from_string
export ExternalTool, external_tool_to_string, external_tool_from_string
export ReportFormat, report_format_to_string, report_format_from_string
export TargetKind
export GrowthEvent
export StaticViolation
export LeakCheckConfig, default_leak_check_config
export AllocationRecord
export AllocBucket
export LeakCheckResult, empty_leak_check_result
export ExternalLeakReport, empty_external_leak_report
export ExternalLeak
