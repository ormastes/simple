# Leak-check temporary storage policy.

use app.io.mod.{cwd, dir_create_all, env_get, getpid, time_now_unix_micros}

fn leak_check_worktree_storage_root() -> text:
    val configured = env_get("SIMPLE_WORKTREE_STORAGE_ROOT").trim()
    val root = if configured != "": configured else: "{cwd()}/.simple/storage"
    if root.ends_with("/") and root.len() > 1: root[0:root.len() - 1] else: root

fn leak_check_temp_root() -> text:
    "{leak_check_worktree_storage_root()}/tmp/compiler/leak-check"

fn leak_check_create_run_dir() -> text:
    val root = leak_check_temp_root()
    if not dir_create_all(root):
        return ""
    val path = "{root}/run-{getpid()}-{time_now_unix_micros()}"
    if not dir_create_all(path):
        return ""
    path

fn leak_check_runtime_dump_path() -> text:
    val run_dir = leak_check_create_run_dir()
    if run_dir == "":
        return ""
    "{run_dir}/runtime-leaks.txt"

export leak_check_worktree_storage_root, leak_check_temp_root
export leak_check_create_run_dir, leak_check_runtime_dump_path
