# EasyFix Rules - Rule Registry and Dispatch
# Manages rule registration and execution coordination.

use std.tooling.easy_fix.*
use compiler.tools.fix.rules.impl_.lint_spec (
    check_print_in_test_spec,
    check_print_in_test_spec_with_contexts,
    check_spipe_missing_docstrings,
    check_spipe_missing_docstrings_with_lines,
    check_spipe_manual_assertions,
    check_spipe_manual_assertions_with_contexts,
    check_spipe_no_print_based_tests,
    check_spipe_no_print_based_tests_with_contexts,
    check_spipe_minimal_docstrings
)
use compiler.tools.fix.rules.impl_.lint_code (
    check_unnamed_duplicate_typed_args,
    check_resource_leak,
    check_non_exhaustive_match
)
use compiler.tools.fix.rules.impl_.error_fix (
    check_parser_contextual_keyword,
    check_typo_suggestion,
    suggest_typo_fix,
    check_type_mismatch_coercion,
    suggest_type_coercion_fix
)
use compiler.tools.fix.rules.impl_.deprecation (
    check_deprecated_if_let,
    check_struct_construction_parens
)
use compiler.tools.fix.rules.impl_.lint_stub (
    check_stub_impl_text
)
use compiler.tools.fix.rules.impl_.lint_star_import (
    check_star_import_text
)
use compiler.tools.fix.rules.impl_.lint_wide_public (
    check_wide_public_text
)
use compiler.tools.fix.rules.impl_.lint_annotation (
    check_unknown_decorator,
    check_unknown_attribute
)
use compiler.tools.fix.rules.impl_.lint_module (
    check_export_outside_init,
    check_init_boundary_violation,
    check_bypass_with_code_files
)
use compiler.tools.fix.rules.impl_.lint_bool (
    check_bare_bool
)
use compiler.tools.fix.rules.impl_.lint_primitive_api (
    check_primitive_api
)
use compiler.tools.fix.rules.impl_.lint_script_language (
    check_simple_script_required
)
use compiler.tools.fix.rules.impl_.lint_short_grammar (
    check_short_grammar_refactor
)
use compiler.tools.fix.rules.impl_.lint_simd (
    check_simd_opportunities
)
use std.tooling.easy_fix.accessor_field_access.{check_field_access_refactor}
use compiler.tools.fix.rules.helpers.{LineContext, line_contexts_from_lines}
use std.nogc_sync_mut.io_runtime.{env_get, time_now_unix_micros}

# Per-rule timing probe (level-gated, DEFAULT OFF) — same idiom as
# lint_prof_now/mark in lint._LintMain.lint_checks. With SIMPLE_LINT_PROFILE
# unset, no clock read, no output, no behaviour change.
# See doc/08_tracking/bug/lint_timeout_hwir_zca_rows_2026-08-17.md
fn rules_prof_now() -> i64:
    if env_get("SIMPLE_LINT_PROFILE") == "":
        return 0
    time_now_unix_micros()

fn rules_prof_mark(label: text, t0: i64) -> i64:
    if t0 == 0:
        return 0
    val now = time_now_unix_micros()
    print("LINTPROF\trule:{label}\t{now - t0}")
    now

# ============================================================================
# Master: run all text-scanning rules
# ============================================================================

fn check_all_rules(source: String, file: String) -> [EasyFix]:
    check_all_rules_with_lines(source, file, source.split("\n"))

fn check_all_rules_with_lines(source: String, file: String, lines: [String]) -> [EasyFix]:
    var all_fixes: [EasyFix] = []
    var _rt = rules_prof_now()
    val spec_contexts: [LineContext] = if file.ends_with("_spec.spl"):
        line_contexts_from_lines(lines)
    else:
        []

    val fixes1 = check_print_in_test_spec_with_contexts(file, spec_contexts)
    _rt = rules_prof_mark("check_print_in_test_spec", _rt)
    for f in fixes1:
        all_fixes.push(f)

    val fixes2 = check_unnamed_duplicate_typed_args(source, file)
    _rt = rules_prof_mark("check_unnamed_duplicate_typed_args", _rt)
    for f in fixes2:
        all_fixes.push(f)

    val fixes3 = check_resource_leak(source, file)
    _rt = rules_prof_mark("check_resource_leak", _rt)
    for f in fixes3:
        all_fixes.push(f)

    val fixes4 = check_spipe_missing_docstrings_with_lines(file, lines)
    _rt = rules_prof_mark("check_spipe_missing_docstrings", _rt)
    for f in fixes4:
        all_fixes.push(f)

    val fixes5 = check_spipe_manual_assertions_with_contexts(file, spec_contexts)
    _rt = rules_prof_mark("check_spipe_manual_assertions", _rt)
    for f in fixes5:
        all_fixes.push(f)

    val fixes6 = check_non_exhaustive_match(source, file)
    _rt = rules_prof_mark("check_non_exhaustive_match", _rt)
    for f in fixes6:
        all_fixes.push(f)

    val fixes7 = check_parser_contextual_keyword(source, file)
    _rt = rules_prof_mark("check_parser_contextual_keyword", _rt)
    for f in fixes7:
        all_fixes.push(f)

    val fixes8 = check_deprecated_if_let(source, file)
    _rt = rules_prof_mark("check_deprecated_if_let", _rt)
    for f in fixes8:
        all_fixes.push(f)

    val fixes9 = check_struct_construction_parens(source, file)
    _rt = rules_prof_mark("check_struct_construction_parens", _rt)
    for f in fixes9:
        all_fixes.push(f)

    val fixes10 = check_stub_impl_text(source, file)
    _rt = rules_prof_mark("check_stub_impl_text", _rt)
    for f in fixes10:
        all_fixes.push(f)

    val fixes11 = check_star_import_text(source, file)
    _rt = rules_prof_mark("check_star_import_text", _rt)
    for f in fixes11:
        all_fixes.push(f)

    val fixes12 = check_wide_public_text(source, file)
    _rt = rules_prof_mark("check_wide_public_text", _rt)
    for f in fixes12:
        all_fixes.push(f)

    val fixes13 = check_unknown_decorator(source, file)
    _rt = rules_prof_mark("check_unknown_decorator", _rt)
    for f in fixes13:
        all_fixes.push(f)

    val fixes14 = check_unknown_attribute(source, file)
    _rt = rules_prof_mark("check_unknown_attribute", _rt)
    for f in fixes14:
        all_fixes.push(f)

    val fixes15 = check_export_outside_init(source, file)
    _rt = rules_prof_mark("check_export_outside_init", _rt)
    for f in fixes15:
        all_fixes.push(f)

    val fixes16 = check_init_boundary_violation(source, file)
    _rt = rules_prof_mark("check_init_boundary_violation", _rt)
    for f in fixes16:
        all_fixes.push(f)

    val fixes17 = check_bypass_with_code_files(source, file)
    _rt = rules_prof_mark("check_bypass_with_code_files", _rt)
    for f in fixes17:
        all_fixes.push(f)

    val fixes18 = check_bare_bool(source, file)
    _rt = rules_prof_mark("check_bare_bool", _rt)
    for f in fixes18:
        all_fixes.push(f)

    val fixes19 = check_spipe_no_print_based_tests_with_contexts(file, spec_contexts)
    _rt = rules_prof_mark("check_spipe_no_print_based_tests", _rt)
    for f in fixes19:
        all_fixes.push(f)

    val fixes20 = check_spipe_minimal_docstrings(source, file)
    _rt = rules_prof_mark("check_spipe_minimal_docstrings", _rt)
    for f in fixes20:
        all_fixes.push(f)

    val fixes21 = check_primitive_api(source, file)
    _rt = rules_prof_mark("check_primitive_api", _rt)
    for f in fixes21:
        all_fixes.push(f)

    val fixes22 = check_short_grammar_refactor(source, file)
    _rt = rules_prof_mark("check_short_grammar_refactor", _rt)
    for f in fixes22:
        all_fixes.push(f)

    val fixes23 = check_simple_script_required(source, file)
    _rt = rules_prof_mark("check_simple_script_required", _rt)
    for f in fixes23:
        all_fixes.push(f)

    val fixes24 = check_field_access_refactor(source, file)
    _rt = rules_prof_mark("check_field_access_refactor", _rt)
    for f in fixes24:
        all_fixes.push(f)

    # Rules 7 (typo) and 9 (type coercion) are no-ops in text-scanning mode.
    # They require compiler integration (Rust side).

    all_fixes
