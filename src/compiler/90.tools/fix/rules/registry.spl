use compiler.tools.fix.producer.{FixUnit, FixProducer, fix_producer, rules_prof_now, rules_prof_mark}

# ============================================================================
# Registry: every text-scanning rule as a FixProducer keyed by its diagnostic
# code (rev-3 FixProvider routing), dispatched explicitly by code. Order is the
# historical check_all_rules order so `simple fix` output is unchanged. Rules 7
# (typo) and 9 (type coercion) need compiler integration and are not here.
# ============================================================================

pub fn registry_fix_producers() -> [FixProducer]:
    [
        fix_producer("L:print_in_test_spec"),
        fix_producer("L:unnamed_duplicate_typed_args"),
        fix_producer("L:resource_leak"),
        fix_producer("L:spipe_missing_docstrings"),
        fix_producer("L:spipe_manual_assertions"),
        fix_producer("L:non_exhaustive_match"),
        fix_producer("E:parser_contextual_keyword"),
        fix_producer("L:deprecated_if_let"),
        fix_producer("L:struct_construction_parens"),
        fix_producer("L:stub_impl"),
        fix_producer("L:star_import"),
        fix_producer("L:wide_public"),
        fix_producer("L:unknown_annotation"),
        fix_producer("L:export_outside_init"),
        fix_producer("L:init_boundary_violation"),
        fix_producer("L:bypass_with_code_files"),
        fix_producer("L:bare_bool"),
        fix_producer("L:spipe_no_print_based_tests"),
        fix_producer("L:spipe_minimal_docstrings"),
        fix_producer("L:primitive_api"),
        fix_producer("L:short_grammar"),
        fix_producer("L:simple_script_required"),
        fix_producer("L:short_grammar_field_access"),
    ]

pub fn run_registry_producer(code: text, unit: FixUnit) -> [EasyFix]:
    val file = unit.file
    val lines = unit.lines
    val contexts: [LineContext] = unit.contexts
    val std_view: EasyFixSourceView = unit.std_view
    if code == "L:print_in_test_spec": return check_print_in_test_spec_with_contexts(file, contexts)
    if code == "L:unnamed_duplicate_typed_args": return check_unnamed_duplicate_typed_args_with_view(file, lines, contexts)
    if code == "L:resource_leak": return check_resource_leak_with_contexts(file, contexts)
    if code == "L:spipe_missing_docstrings": return check_spipe_missing_docstrings_with_lines(file, lines)
    if code == "L:spipe_manual_assertions": return check_spipe_manual_assertions_with_contexts(file, contexts)
    if code == "L:non_exhaustive_match": return check_non_exhaustive_match_with_lines(file, lines)
    if code == "E:parser_contextual_keyword": return check_parser_contextual_keyword_with_view(file, std_view)
    if code == "L:deprecated_if_let": return check_deprecated_if_let_with_view(file, std_view)
    if code == "L:struct_construction_parens": return check_struct_construction_parens_with_contexts(file, contexts)
    if code == "L:stub_impl": return check_stub_impl_text_with_view(file, std_view)
    if code == "L:star_import": return check_star_import_text_with_lines(file, lines)
    if code == "L:wide_public": return check_wide_public_text_with_lines(file, lines)
    if code == "L:unknown_annotation": return check_unknown_annotation_with_contexts(file, contexts)
    if code == "L:export_outside_init": return check_export_outside_init_with_view(file, lines, contexts)
    if code == "L:init_boundary_violation": return check_init_boundary_violation_with_contexts(file, contexts)
    if code == "L:bypass_with_code_files": return check_bypass_with_code_files_with_lines(file, lines)
    if code == "L:bare_bool": return check_bare_bool_with_lines(file, lines)
    if code == "L:spipe_no_print_based_tests": return check_spipe_no_print_based_tests_with_contexts(file, contexts)
    if code == "L:spipe_minimal_docstrings": return check_spipe_minimal_docstrings(unit.source, file)
    if code == "L:primitive_api": return check_primitive_api_with_lines(file, lines)
    if code == "L:short_grammar": return check_short_grammar_refactor_with_contexts(file, contexts)
    if code == "L:simple_script_required": return check_simple_script_required_with_lines(file, lines)
    if code == "L:short_grammar_field_access": return check_field_access_refactor_with_view(file, lines, contexts)
    []

# All registry rules over one unit (lint --fix path); proposals are unbound
# here, the engine binds them when it validates.
pub fn run_registry_producers(unit: FixUnit) -> [EasyFix]:
    var all: [EasyFix] = []
    var t = rules_prof_now()
    for p in registry_fix_producers():
        for f in run_registry_producer(p.code, unit):
            all.push(f)
        t = rules_prof_mark(p.code, t)
    all

