# EasyFix Rules - Shared Helpers
#
# Line iteration and byte offset helpers live in std easy_fix (rules_helpers,
# rules_errors); this module re-exports them for the compiler fix rules.

export use std.tooling.easy_fix.rules_helpers.{
    LineContext, line_contexts, line_contexts_from_lines,
    for_each_line, byte_offset_of, line_start_offset, line_end_offset
}
export use std.tooling.easy_fix.rules_errors.{levenshtein}
use std.tooling.easy_fix.rules_helpers.{easy_fix_replace_interpolation_identifier}

# ============================================================================
# Cache management functions — now no-ops (globals removed to fix NULL-data crash)
# ============================================================================

fn set_line_cache(source: text):
    val _ = source

fn clear_line_cache():
    val _ = 0

fn get_cached_lines() -> [text]:
    []

fn get_cached_source() -> text:
    ""

pub fn replace_interpolation_identifier(expr: text, param: text, replacement: text) -> text:
    easy_fix_replace_interpolation_identifier(expr, param, replacement)
