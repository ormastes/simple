# EasyFix Rules - Error Fix Rules
#
# Rules that fix compiler errors:
#   E:typo_suggestion            — Fix misspelled identifiers (Levenshtein)
#   E:parser_contextual_keyword  — Fix contextual keyword syntax
#   E:type_mismatch_coercion     — Insert type coercion (.to_string() etc.)

use std.tooling.easy_fix.types.{FixConfidence, Replacement, EasyFix}
use std.tooling.easy_fix.*
use compiler.tools.fix.rules.helpers.*

# ============================================================================
# Rule 7: typo_suggestion (Levenshtein distance)
# Rule 8: parser_contextual_keyword (E0013)
# Rule 9: type_mismatch_coercion
#
# Canonical implementations of check_typo_suggestion, suggest_typo_fix,
# check_parser_contextual_keyword, check_type_mismatch_coercion, and
# suggest_type_coercion_fix live in std.tooling.easy_fix.rules_errors
# (imported below via `use std.tooling.easy_fix.*`); this module re-exports
# them rather than redefining them, to avoid co-compiled symbol collisions.
# ============================================================================
