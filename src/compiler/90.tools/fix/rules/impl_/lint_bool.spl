# EasyFix Rules - Public Bool Parameter (SPL-BOOL-001), real fix
#
#   L:bare_bool — a top-level `pub fn` parameter typed `bool`: rewrite the type
#   token to `<Param>Flag` and declare `pub unit <Param>Flag: bool` once per file.
#   Every fix for the same param name names the same unit and emits the same
#   declaration at the same offset; the applier dedupes identical edits.
#
# Single detector: lint_primitive_api.primitive_api_findings (code SPL-BOOL-001).
# Confidence is Uncertain, so it is only listed by `fix --dry-run` / applied with
# the uncertain tier: every caller must pass `<Name>Flag(true)`. Return types and
# methods inside a class/struct body get the lint finding only (no edit): a unit
# declaration cannot be inserted inside a body, and a return rewrite also needs
# body changes.

use std.tooling.easy_fix.types.{FixConfidence, Replacement, EasyFix}
use std.tooling.easy_fix.*
use compiler.tools.fix.rules.impl_.lint_primitive_api.{primitive_api_findings, bool_flag_unit_name, PrimitiveApiFinding}

pub fn check_bare_bool(source: text, file: text) -> [EasyFix]:
    check_bare_bool_with_lines(file, source.split("\n"))

fn _flag_name_declared(lines: [text], name: text) -> bool:
    # Declared (`unit`/`pub unit`) or imported (`use ... Name ...`) in this file.
    for line in lines:
        val t = line.trim()
        if t.starts_with("unit {name}:") or t.starts_with("pub unit {name}:"):
            return true
        if t.starts_with("use ") and _names_token(t, name):
            return true
    false

# True when `name` is a whole identifier in `line`, not a part of a longer name.
fn _names_token(line: text, name: text) -> bool:
    val spaced = " " + line.replace("{{", " ").replace("}}", " ").replace(",", " ").replace(".", " ").replace(":", " ") + " "
    spaced.contains(" " + name + " ")

# The parameter name of a param finding; `mut` is not part of the name.
fn _bool_param_name(type_path: text) -> text:
    val at = type_path.find(".param.")
    if at < 0:
        return ""
    var name = type_path.slice(at + ".param.".len())
    if name.starts_with("mut "):
        name = name.slice(4).trim()
    name

# Bare-bool findings that get an edit: top-level fns only. Methods and
# returns get the lint finding alone.
fn _bool_targets(lines: [text], findings: [PrimitiveApiFinding]) -> [PrimitiveApiFinding]:
    var out: [PrimitiveApiFinding] = []
    for f in findings:
        if f.code != "SPL-BOOL-001" or f.primitive_type != "bool":
            continue
        if _bool_param_name(f.type_path) == "":
            continue
        val src_line = lines[f.line - 1]
        if src_line.starts_with(" ") or src_line.starts_with("\t"):
            continue
        out.push(f)
    out

# Offset of the start of line `index`, counted the same way as the finding
# offsets (`byte_len()` plus one for the newline).
fn _line_offset(lines: [text], index: i64) -> i64:
    var off = 0
    var i = 0
    while i < index:
        off = off + lines[i].byte_len() + 1
        i = i + 1
    off

# Offset just past the last character of the file. The declaration goes here:
# a forward reference to a `pub unit` is legal, and identical zero-width inserts
# from several fixes at this offset are applied once by the applier.
fn _eof_offset(lines: [text]) -> i64:
    val last = lines.len() - 1
    _line_offset(lines, last) + lines[last].byte_len()

fn _unit_decl_text(lines: [text], unit_name: text) -> text:
    val ends_with_newline = lines.len() > 1 and lines[lines.len() - 1] == ""
    val lead = if ends_with_newline: "\n" else: "\n\n"
    lead + "pub unit {unit_name}: bool\n"

pub fn check_bare_bool_with_lines(file: text, lines: [text]) -> [EasyFix]:
    var fixes: [EasyFix] = []
    val targets = _bool_targets(lines, primitive_api_findings(file, lines))
    for f in targets:
        val param_name = _bool_param_name(f.type_path)
        val unit_name = bool_flag_unit_name(param_name)
        var fix = EasyFix.create(
            id: "L:bare_bool:{f.line}:{f.column}",
            description: "parameter '{param_name}' is a bare bool: use `unit {unit_name}: bool` and pass {unit_name}(true/false) at every call site",
            confidence: FixConfidence.Uncertain
        )
        fix.add_replacement(Replacement.create(
            file: file, start: f.start, end: f.end, line: f.line, column: f.column, new_text: unit_name))
        if not _flag_name_declared(lines, unit_name):
            val off = _eof_offset(lines)
            fix.add_replacement(Replacement.create(
                file: file, start: off, end: off, line: lines.len(), column: 1,
                new_text: _unit_decl_text(lines, unit_name)))
        fixes.push(fix)
    fixes
