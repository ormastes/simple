# EasyFix Rules - Spec File Lint Rules
#
# Rules that only apply to _spec.spl test files:
#   L:spipe_no_print_based_tests — Detect print-based BDD test frameworks
#   L:spipe_minimal_docstrings   — Detect files with too few docstrings

use std.tooling.easy_fix.types.{FixConfidence, Replacement, EasyFix}
use std.tooling.easy_fix.*
use compiler.tools.fix.rules.helpers.*

# ============================================================================
# Rule 7: spipe_no_print_based_tests
# Detects print-based BDD test frameworks in _spec.spl files.
# Confidence: Certain
# ============================================================================

fn check_spipe_no_print_based_tests(source: String, file: String) -> [EasyFix]:
    if not file.ends_with("_spec.spl"):
        return []
    check_spipe_no_print_based_tests_with_contexts(file, line_contexts(source))

fn check_spipe_no_print_based_tests_with_contexts(file: String, contexts: [LineContext]) -> [EasyFix]:
    if not file.ends_with("_spec.spl"):
        return []

    val bdd_keywords = ["describe", "context", "it", "[PASS]", "[FAIL]", "passed", "failed"]

    var fixes: [EasyFix] = []
    for raw_ctx in contexts:
        val ctx: LineContext = raw_ctx

        # Only match lines that are print() calls
        if ctx.trimmed.starts_with("print(") or ctx.trimmed.starts_with("print "):
            # Check if the print argument contains BDD keywords
            var has_bdd_keyword = false
            for keyword in bdd_keywords:
                if ctx.trimmed.contains(keyword):
                    has_bdd_keyword = true

            if has_bdd_keyword:
                val start = ctx.byte_offset + ctx.indent
                val end = ctx.byte_offset + ctx.line.len()

                var fix = EasyFix.create(
                    id: "L:spipe_no_print_based_tests:{ctx.line_num}",
                    description: "print-based BDD test framework detected — use SPipe instead",
                    confidence: FixConfidence.Certain
                )
                fix.add_replacement(Replacement.create(
                    file: file,
                    start: start,
                    end: end,
                    line: ctx.line_num,
                    column: ctx.indent + 1,
                    new_text: ""
                ))
                fixes.push(fix)

    fixes

# ============================================================================
# Rule 8: spipe_minimal_docstrings
# Detects _spec.spl files with too few docstrings.
# Confidence: Likely
# ============================================================================

fn check_spipe_minimal_docstrings(source: String, file: String) -> [EasyFix]:
    var fixes: [EasyFix] = []

    if not file.ends_with("_spec.spl"):
        return fixes

    # Count triple-quote occurrences
    var count = 0
    var search_pos = 0
    while search_pos < source.len():
        # No text method takes a start-offset directly (`index_of_from`
        # exists only as a private compiler-tool helper elsewhere); reuse the
        # working `index_of`/`substring` builtins instead of calling a
        # nonexistent method -- that call previously constructed the target
        # `str.index_of_from`, undefined at the Stage-4 macOS final link
        # (2026-09-07).
        val remainder = source.substring(search_pos, source.byte_len())
        val rel_pos = remainder.index_of("\"\"\"")
        var pos = -1
        if rel_pos >= 0:
            pos = search_pos + rel_pos
        if pos < 0:
            search_pos = source.len()
        else:
            count = count + 1
            search_pos = pos + 3

    # Each docstring has an opening and closing """, so fewer than 4
    # means fewer than 2 complete docstrings
    if count < 4:
        var fix = EasyFix.create(
            id: "L:spipe_minimal_docstrings:1",
            description: "spec file has fewer than 2 docstrings — add docstrings to describe/context blocks",
            confidence: FixConfidence.Likely
        )
        # No replacement — this is a file-level warning, not a line fix
        fix.add_replacement(Replacement.create(
            file: file,
            start: 0,
            end: 0,
            line: 1,
            column: 1,
            new_text: ""
        ))
        fixes.push(fix)

    fixes

export check_print_in_test_spec, check_print_in_test_spec_with_contexts, check_spipe_missing_docstrings, check_spipe_missing_docstrings_with_lines, check_spipe_manual_assertions, check_spipe_manual_assertions_with_contexts, check_spipe_no_print_based_tests, check_spipe_no_print_based_tests_with_contexts, check_spipe_minimal_docstrings
