# EasyFix Rules - Annotation Lint Rules (Text-Scanning)
#
# Text-based detection for unknown decorators and attributes:
#   L:unknown_decorator  — Decorator name not in known whitelist
#   L:unknown_attribute  — Attribute name not in known whitelist

use std.tooling.easy_fix.types.{FixConfidence, Replacement, EasyFix}
use std.tooling.easy_fix.*
use compiler.tools.fix.rules.helpers.*

fn _annotation_name(trimmed: text) -> text:
    if not trimmed.starts_with("@") or trimmed.len() <= 1:
        return ""
    val after_at = trimmed.slice(1)
    var end_pos = after_at.len()
    val paren_pos = after_at.find("(")
    val space_pos = after_at.find(" ")
    if paren_pos >= 0 and paren_pos < end_pos:
        end_pos = paren_pos
    if space_pos >= 0 and space_pos < end_pos:
        end_pos = space_pos
    val name = after_at.slice(0, end_pos)
    if name.starts_with("#") or name.starts_with("@"):
        return ""
    name

fn check_unknown_annotation(source: text, file: text) -> [EasyFix]:
    check_unknown_annotation_with_contexts(file, line_contexts(source))

fn check_unknown_annotation_with_contexts(file: text, contexts: [LineContext]) -> [EasyFix]:
    var fixes: [EasyFix] = []
    for raw_ctx in contexts:
        val ctx: LineContext = raw_ctx
        val name = _annotation_name(ctx.trimmed)
        if name != "" and not _is_known_decorator(name) and not _is_known_attribute(name):
            var fix = EasyFix.create(
                id: "L:unknown_annotation:{ctx.line_num}",
                description: "unknown annotation '@{name}' — not in known decorator/attribute sets",
                confidence: FixConfidence.Likely
            )
            fix.add_replacement(Replacement.create(
                file: file,
                start: ctx.byte_offset + ctx.indent,
                end: ctx.byte_offset + ctx.line.len(),
                line: ctx.line_num,
                column: ctx.indent + 1,
                new_text: ctx.line
            ))
            fixes.push(fix)
    fixes

# ============================================================================
# Rule: unknown_decorator
# Detects @name lines where name is not in the known whitelist.
# Confidence: Likely
# ============================================================================

fn check_unknown_decorator(source: text, file: text) -> [EasyFix]:
    check_unknown_decorator_with_contexts(file, line_contexts(source))

fn check_unknown_decorator_with_contexts(file: text, contexts: [LineContext]) -> [EasyFix]:
    var fixes: [EasyFix] = []
    for raw_ctx in contexts:
        val ctx: LineContext = raw_ctx

        if ctx.trimmed.starts_with("@"):
            # Extract the decorator name (first word after @)
            val after_at = ctx.trimmed.slice(1)
            if after_at.len() > 0:
                # Get the name part (up to first paren, space, or end)
                var name = after_at
                val paren_pos = after_at.find("(")
                val space_pos = after_at.find(" ")
                if paren_pos >= 0 and (space_pos < 0 or paren_pos < space_pos):
                    name = after_at.slice(0, paren_pos)
                else if space_pos >= 0:
                    name = after_at.slice(0, space_pos)

                # Skip empty names or comment lines like @# or @@
                if name.len() > 0 and not name.starts_with("#") and not name.starts_with("@"):
                    if not _is_known_decorator(name):
                        var fix = EasyFix.create(
                            id: "L:unknown_decorator:{ctx.line_num}",
                            description: "unknown decorator '@{name}' — not in known whitelist",
                            confidence: FixConfidence.Likely
                        )
                        fix.add_replacement(Replacement.create(
                            file: file,
                            start: ctx.byte_offset + ctx.indent,
                            end: ctx.byte_offset + ctx.line.len(),
                            line: ctx.line_num,
                            column: ctx.indent + 1,
                            new_text: ctx.line
                        ))
                        fixes.push(fix)

    fixes

fn _is_known_decorator(name: text) -> bool:
    match name:
        case "async" | "pure" | "io" | "net" | "fs" | "unsafe" | "verify" | "trusted": true
        case "ghost" | "auto_lean" | "bounds" | "extern" | "simd" | "inline" | "test": true
        case "property_test" | "snapshot_test" | "deprecated" | "generated_by": true
        case "Lib" | "inject" | "sys_inject" | "naked" | "noreturn" | "interrupt": true
        case "entry" | "align" | "gpu_intrinsic" | "name_checked" | "sffi": true
        case _: false

# ============================================================================
# Rule: unknown_attribute
# Detects @name lines where name is not in the known whitelist.
# Skips @allow, @warn, @deny (already known).
# Confidence: Likely
# ============================================================================

fn check_unknown_attribute(source: text, file: text) -> [EasyFix]:
    check_unknown_attribute_with_contexts(file, line_contexts(source))

fn check_unknown_attribute_with_contexts(file: text, contexts: [LineContext]) -> [EasyFix]:
    var fixes: [EasyFix] = []
    for raw_ctx in contexts:
        val ctx: LineContext = raw_ctx

        # Match @name attribute lines
        if ctx.trimmed.starts_with("@"):
            val after_at = ctx.trimmed.slice(1)
            if after_at.len() > 0:
                # Extract the attribute name (up to first paren, space, or end)
                var name = after_at
                val paren_pos = after_at.find("(")
                val space_pos = after_at.find(" ")

                # Find the earliest delimiter
                var end_pos = name.len()
                if paren_pos >= 0 and paren_pos < end_pos:
                    end_pos = paren_pos
                if space_pos >= 0 and space_pos < end_pos:
                    end_pos = space_pos

                name = after_at.slice(0, end_pos)

                if name.len() > 0:
                    if not _is_known_attribute(name):
                        var fix = EasyFix.create(
                            id: "L:unknown_attribute:{ctx.line_num}",
                            description: "unknown attribute '@{name}' — not in known whitelist",
                            confidence: FixConfidence.Likely
                        )
                        fix.add_replacement(Replacement.create(
                            file: file,
                            start: ctx.byte_offset + ctx.indent,
                            end: ctx.byte_offset + ctx.line.len(),
                            line: ctx.line_num,
                            column: ctx.indent + 1,
                            new_text: ctx.line
                        ))
                        fixes.push(fix)

    fixes

fn _is_known_attribute(name: text) -> bool:
    match name:
        case "allow" | "warn" | "deny" | "default" | "concurrency_mode" | "layout": true
        case "pure" | "snapshot" | "deprecated" | "bypass" | "skip_todo" | "generated": true
        case "inline" | "ignore" | "name_checked": true
        case _: false
