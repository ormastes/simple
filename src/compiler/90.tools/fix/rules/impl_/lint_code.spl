# EasyFix Rules - Code Quality Lint Rules
#
# General code quality rules:
#   L:unnamed_duplicate_typed_args — Add distinct param names for duplicate types
#   L:resource_leak              — Wrap resource in `with` block
#   L:non_exhaustive_match       — Add missing match arms with todo()

use std.tooling.easy_fix.types.{FixConfidence, Replacement, EasyFix}
use std.tooling.easy_fix.*
use compiler.tools.fix.rules.helpers.*

struct DuplicateTypedArgSignature:
    name: text
    line_num: i64
    decl_paren_start: i64
    decl_paren_end: i64
    decl_column: i64
    arg_count: i64
    param_names: [text]
    new_params_text: text
    has_decl_rewrite: bool
    can_rewrite_calls: bool

struct IndexedDuplicateCallReplacement:
    sig_index: i64
    sequence: i64
    replacement: Replacement

# ============================================================================
# Rule 2: unnamed_duplicate_typed_args
# Detects fn signatures with duplicate types that lack distinct names.
# Confidence: Uncertain
# ============================================================================

fn check_unnamed_duplicate_typed_args(source: String, file: String) -> [EasyFix]:
    val lines = source.split("\n")
    check_unnamed_duplicate_typed_args_with_view(file, lines, line_contexts_from_lines(lines))

fn check_unnamed_duplicate_typed_args_with_view(file: String, lines: [String], contexts: [LineContext]) -> [EasyFix]:
    val signatures = _collect_duplicate_typed_arg_signatures_from_contexts(contexts)
    val indexed_calls = _collect_indexed_call_replacements(lines, file, signatures)
    var fixes: [EasyFix] = []
    var call_cursor = 0

    for sig_index in 0..signatures.len():
        val sig = signatures[sig_index]
        var replacements: [Replacement] = []

        if sig.has_decl_rewrite:
            replacements.push(Replacement.create(
                file: file,
                start: sig.decl_paren_start,
                end: sig.decl_paren_end,
                line: sig.line_num,
                column: sig.decl_column,
                new_text: sig.new_params_text
            ))

        while call_cursor < indexed_calls.len() and indexed_calls[call_cursor].sig_index == sig_index:
            replacements.push(indexed_calls[call_cursor].replacement)
            call_cursor = call_cursor + 1

        if not replacements.is_empty():
            val description = if sig.has_decl_rewrite:
                "add distinct parameter names for duplicate types"
            else:
                "rewrite positional duplicate-typed arguments as named calls"
            var fix = EasyFix.create(
                id: "L:unnamed_duplicate_typed_args:{sig.line_num}",
                description: description,
                confidence: FixConfidence.Uncertain
            )
            for rep in replacements:
                fix.add_replacement(rep)
            fixes.push(fix)

    fixes

fn _duplicate_call_key(name: text, arg_count: i64) -> text:
    "{name}#{arg_count}"

fn _collect_indexed_call_replacements(
    lines: [text], file: text, signatures: [DuplicateTypedArgSignature]
) -> [IndexedDuplicateCallReplacement]:
    var key_counts: Dict<text, i64> = {}
    var eligible_names: Dict<text, bool> = {}
    for sig in signatures:
        if not sig.can_rewrite_calls:
            continue
        val key = _duplicate_call_key(sig.name, sig.arg_count)
        key_counts[key] = (key_counts[key] ?? 0) + 1
        eligible_names[sig.name] = true

    var target_by_key: Dict<text, i64> = {}
    for sig_index in 0..signatures.len():
        val sig = signatures[sig_index]
        if not sig.can_rewrite_calls:
            continue
        val key = _duplicate_call_key(sig.name, sig.arg_count)
        if key_counts[key] == 1:
            target_by_key[key] = sig_index

    var indexed: [IndexedDuplicateCallReplacement] = []
    var sequence = 0
    var line_num = 0
    var byte_offset = 0
    for line in lines:
        line_num = line_num + 1
        var i = 0
        while i < line.len():
            val ch = line.slice(i, i + 1)
            if not _is_identifier_char(ch) or _is_digit_char(ch):
                i = i + 1
                continue
            val token_start = i
            i = i + 1
            while i < line.len() and _is_identifier_char(line.slice(i, i + 1)):
                i = i + 1
            val name = line.slice(token_start, i)
            if not eligible_names.has(name) or _is_definition_context(line, token_start):
                continue
            val open_paren = _find_call_open_paren(line, i)
            if open_paren < 0:
                continue
            val close_paren = _find_matching_paren_on_line(line, open_paren)
            if close_paren <= open_paren:
                continue
            val args = _split_top_level_csv(line.slice(open_paren + 1, close_paren))
            if _args_have_named_entries(args):
                i = close_paren + 1
                continue
            val key = _duplicate_call_key(name, args.len())
            if not target_by_key.has(key):
                i = close_paren + 1
                continue
            val sig_index = target_by_key[key]
            val sig = signatures[sig_index]
            var named_args: [text] = []
            for arg_index in 0..args.len():
                named_args.push("{sig.param_names[arg_index]}: {args[arg_index].trim()}")
            indexed.push(IndexedDuplicateCallReplacement(
                sig_index: sig_index,
                sequence: sequence,
                replacement: Replacement.create(
                    file: file,
                    start: byte_offset + open_paren + 1,
                    end: byte_offset + close_paren,
                    line: line_num,
                    column: open_paren + 2,
                    new_text: named_args.join(", ")
                )
            ))
            sequence = sequence + 1
            i = close_paren + 1
        byte_offset = byte_offset + line.len() + 1
    indexed.sort_by(\a, b:
        if a.sig_index == b.sig_index:
            a.sequence - b.sequence
        else:
            a.sig_index - b.sig_index
    )
    indexed

fn _collect_duplicate_typed_arg_signatures(source: text) -> [DuplicateTypedArgSignature]:
    _collect_duplicate_typed_arg_signatures_from_contexts(line_contexts(source))

fn _collect_duplicate_typed_arg_signatures_from_contexts(contexts: [LineContext]) -> [DuplicateTypedArgSignature]:
    var signatures: [DuplicateTypedArgSignature] = []
    for raw_ctx in contexts:
        val ctx: LineContext = raw_ctx
        val sig = _parse_duplicate_typed_arg_signature(ctx)
        match sig:
            case Some(found):
                signatures.push(found)
            case nil:
                pass
    signatures

fn _parse_duplicate_typed_arg_signature(ctx: LineContext) -> DuplicateTypedArgSignature?:
    if not _is_fn_sig(ctx.trimmed):
        return nil
    if not ctx.trimmed.contains("("):
        return nil

    val paren_start = ctx.trimmed.find("(")
    if paren_start < 0:
        return nil
    val paren_end = _find_matching_paren_on_line(ctx.trimmed, paren_start)
    if paren_end <= paren_start:
        return nil

    val name = _extract_sig_name(ctx.trimmed, paren_start)
    if name == "":
        return nil

    val params_str = ctx.trimmed.slice(paren_start + 1, paren_end)
    val params = _split_top_level_csv(params_str)
    if params.is_empty():
        return nil

    var raw_names: [text] = []
    var raw_types: [text] = []
    var normalized_types: [text] = []
    var has_unnamed = false

    for param in params:
        val trimmed_param = param.trim()
        if trimmed_param == "":
            continue
        val colon_pos = _find_top_level_colon(trimmed_param)
        if colon_pos >= 0:
            raw_names.push(trimmed_param.slice(0, colon_pos).trim())
            raw_types.push(trimmed_param.slice(colon_pos + 1).trim())
        else:
            raw_names.push("")
            raw_types.push(trimmed_param)
            has_unnamed = true
        normalized_types.push(_normalize_type_name(raw_types[raw_types.len() - 1]))

    if raw_types.len() < 2:
        return nil

    var type_counts: Dict<text, i64> = {}
    var has_duplicate_types = false
    for ty in normalized_types:
        val count = type_counts[ty] ?? 0
        type_counts[ty] = count + 1
        if count + 1 >= 2:
            has_duplicate_types = true
    if not has_duplicate_types:
        return nil

    var resolved_names: [text] = []
    var rewritten_params: [text] = []
    var generated_counts: Dict<text, i64> = {}
    for i in 0..raw_types.len():
        val param_name = raw_names[i]
        val param_type = raw_types[i]
        var resolved_name = param_name
        if resolved_name == "":
            val key = normalized_types[i]
            val next_count = (generated_counts[key] ?? 0) + 1
            generated_counts[key] = next_count
            resolved_name = "{_type_name_to_identifier(param_type)}{next_count}"
        rewritten_params.push("{resolved_name}: {param_type}")
        resolved_names.push(resolved_name)

    var stable_names = true
    var seen_names: Dict<text, bool> = {}
    for i in 0..resolved_names.len():
        if type_counts[normalized_types[i]] < 2:
            continue
        val name_i = resolved_names[i]
        if name_i == "" or name_i == "_" or name_i.starts_with("_"):
            stable_names = false
            continue
        if seen_names.has(name_i):
            stable_names = false
        else:
            seen_names[name_i] = true
    if stable_names:
        for name in resolved_names:
            if name == "":
                stable_names = false

    Some(DuplicateTypedArgSignature(
        name: name,
        line_num: ctx.line_num,
        decl_paren_start: ctx.byte_offset + ctx.indent + paren_start + 1,
        decl_paren_end: ctx.byte_offset + ctx.indent + paren_end,
        decl_column: paren_start + 2,
        arg_count: resolved_names.len(),
        param_names: resolved_names,
        new_params_text: rewritten_params.join(", "),
        has_decl_rewrite: has_unnamed,
        can_rewrite_calls: stable_names
    ))

fn _is_fn_sig(trimmed: text) -> bool:
    (trimmed.starts_with("fn ")
        or trimmed.starts_with("me ")
        or trimmed.starts_with("static fn ")
        or trimmed.starts_with("pub fn ")
        or trimmed.starts_with("pub me ")
        or trimmed.starts_with("pub static fn "))

fn _extract_sig_name(trimmed: text, paren_start: i64) -> text:
    val before = trimmed.slice(0, paren_start).trim()
    val parts = before.split(" ")
    if parts.is_empty():
        return ""
    parts[parts.len() - 1].trim()

fn _split_top_level_csv(text: text) -> [text]:
    var parts: [text] = []
    var start = 0
    var i = 0
    var paren_depth = 0
    var bracket_depth = 0
    var brace_depth = 0
    var angle_depth = 0
    var in_string = false

    while i < text.len():
        val ch = text.slice(i, i + 1)
        if ch == "\"":
            in_string = not in_string
        elif not in_string:
            if ch == "(":
                paren_depth = paren_depth + 1
            elif ch == ")":
                paren_depth = paren_depth - 1
            elif ch == "[":
                bracket_depth = bracket_depth + 1
            elif ch == "]":
                bracket_depth = bracket_depth - 1
            elif ch == "{":
                brace_depth = brace_depth + 1
            elif ch == "}":
                brace_depth = brace_depth - 1
            elif ch == "<":
                angle_depth = angle_depth + 1
            elif ch == ">":
                angle_depth = angle_depth - 1
            elif ch == "," and paren_depth == 0 and bracket_depth == 0 and brace_depth == 0 and angle_depth == 0:
                parts.push(text.slice(start, i).trim())
                start = i + 1
        i = i + 1

    val tail = text.slice(start).trim()
    if tail != "":
        parts.push(tail)
    parts

fn _find_top_level_colon(text: text) -> i64:
    var i = 0
    var paren_depth = 0
    var bracket_depth = 0
    var brace_depth = 0
    var angle_depth = 0
    var in_string = false

    while i < text.len():
        val ch = text.slice(i, i + 1)
        if ch == "\"":
            in_string = not in_string
        elif not in_string:
            if ch == "(":
                paren_depth = paren_depth + 1
            elif ch == ")":
                paren_depth = paren_depth - 1
            elif ch == "[":
                bracket_depth = bracket_depth + 1
            elif ch == "]":
                bracket_depth = bracket_depth - 1
            elif ch == "{":
                brace_depth = brace_depth + 1
            elif ch == "}":
                brace_depth = brace_depth - 1
            elif ch == "<":
                angle_depth = angle_depth + 1
            elif ch == ">":
                angle_depth = angle_depth - 1
            elif ch == ":" and paren_depth == 0 and bracket_depth == 0 and brace_depth == 0 and angle_depth == 0:
                return i
        i = i + 1
    -1

fn _find_matching_paren_on_line(text: text, open_paren: i64) -> i64:
    var i = open_paren
    var depth = 0
    var in_string = false
    while i < text.len():
        val ch = text.slice(i, i + 1)
        if ch == "\"":
            in_string = not in_string
        elif not in_string:
            if ch == "(":
                depth = depth + 1
            elif ch == ")":
                depth = depth - 1
                if depth == 0:
                    return i
        i = i + 1
    -1

fn _normalize_type_name(text: text) -> text:
    text.trim()

fn _type_name_to_identifier(text: text) -> text:
    var out = ""
    var prev_underscore = false
    var i = 0
    while i < text.len():
        val ch = text.slice(i, i + 1).lower()
        if _is_identifier_char(ch):
            out = out + ch
            prev_underscore = false
        elif not prev_underscore:
            out = out + "_"
            prev_underscore = true
        i = i + 1
    while out.starts_with("_"):
        out = out.slice(1)
    while out.ends_with("_"):
        out = out.slice(0, out.len() - 1)
    if out == "":
        return "arg"
    if _is_digit_char(out.slice(0, 1)):
        return "arg_{out}"
    out

fn _is_definition_context(line: text, token_start: i64) -> bool:
    val before = line.slice(0, token_start).trim()
    before.ends_with("fn") or before.ends_with("me")

fn _find_call_open_paren(line: text, start: i64) -> i64:
    var i = start
    while i < line.len():
        val ch = line.slice(i, i + 1)
        if ch == " " or ch == "\t":
            i = i + 1
            continue
        if ch == "(":
            return i
        return -1
    -1

fn _args_have_named_entries(args: [text]) -> bool:
    for arg in args:
        if _find_top_level_colon(arg.trim()) >= 0:
            return true
    false

fn _is_identifier_char(ch: text) -> bool:
    if ch == "_":
        return true
    (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or _is_digit_char(ch)

fn _is_digit_char(ch: text) -> bool:
    ch >= "0" and ch <= "9"

# ============================================================================
# Rule 3: resource_leak
# Detects open()/connect() calls not wrapped in `with` blocks.
# Confidence: Uncertain
# ============================================================================

fn check_resource_leak(source: String, file: String) -> [EasyFix]:
    check_resource_leak_with_contexts(file, line_contexts(source))

fn check_resource_leak_with_contexts(file: String, contexts: [LineContext]) -> [EasyFix]:
    var fixes: [EasyFix] = []
    for raw_ctx in contexts:
        val ctx: LineContext = raw_ctx

        # Detect val x = open(...) or val x = connect(...) not inside with
        val is_resource_open = ctx.trimmed.contains("= open(") or ctx.trimmed.contains("= connect(") or ctx.trimmed.contains("= File.open(")
        if is_resource_open and ctx.trimmed.starts_with("val ") and not ctx.trimmed.starts_with("with"):
            # Check previous lines for `with` block context (simple heuristic)

            # Extract variable name and expression
            val eq_pos = ctx.trimmed.find("=")
            if eq_pos > 4:
                val var_name = ctx.trimmed.slice(4, eq_pos).trim()
                val expr = ctx.trimmed.slice(eq_pos + 1).trim()

                val start = ctx.byte_offset + ctx.indent
                val end = ctx.byte_offset + ctx.line.len()

                val spaces = " ".repeat(ctx.indent)
                val inner_spaces = " ".repeat(ctx.indent + 4)
                val new_text = "{spaces}with {var_name} = {expr}:\n{inner_spaces}# TODO: use {var_name} here"

                var fix = EasyFix.create(
                    id: "L:resource_leak:{ctx.line_num}",
                    description: "wrap resource in `with` block to ensure cleanup",
                    confidence: FixConfidence.Uncertain
                )
                fix.add_replacement(Replacement.create(
                    file: file,
                    start: start,
                    end: end,
                    line: ctx.line_num,
                    column: ctx.indent + 1,
                    new_text: new_text
                ))
                fixes.push(fix)

    fixes

# ============================================================================
# Rule 6: non_exhaustive_match
# Detects match blocks without a catch-all `case _:` arm.
# Confidence: Safe
# ============================================================================

fn check_non_exhaustive_match(source: String, file: String) -> [EasyFix]:
    check_non_exhaustive_match_with_lines(file, source.split("\n"))

fn check_non_exhaustive_match_with_lines(file: String, lines: [String]) -> [EasyFix]:
    var fixes: [EasyFix] = []
    var line_num = 0
    var byte_offset = 0
    var in_match = false
    var match_indent = 0
    var has_catch_all = false
    var match_end_line = 0
    var match_end_offset = 0
    var last_case_indent = 0

    for line in lines:
        line_num = line_num + 1
        val trimmed = line.trim()
        val indent = line.len() - trimmed.len()

        if trimmed.starts_with("match ") and trimmed.ends_with(":"):
            # Start of match block
            if in_match and not has_catch_all:
                # Previous match was non-exhaustive — emit fix
                _emit_non_exhaustive_fix(fixes, file, match_end_line, match_end_offset, last_case_indent)
            in_match = true
            match_indent = indent
            has_catch_all = false
            match_end_line = line_num
            match_end_offset = byte_offset + line.len()

        if in_match and trimmed.starts_with("case "):
            last_case_indent = indent
            match_end_line = line_num
            match_end_offset = byte_offset + line.len()

            if trimmed.starts_with("case _:") or trimmed.starts_with("case _"):
                has_catch_all = true

        # Detect end of match block (dedent)
        if in_match and line.len() > 0 and indent <= match_indent and not trimmed.starts_with("match ") and not trimmed.starts_with("case "):
            if not has_catch_all:
                _emit_non_exhaustive_fix(fixes, file, match_end_line, match_end_offset, last_case_indent)
            in_match = false

        byte_offset = byte_offset + line.len() + 1

    # Handle match at end of file
    if in_match and not has_catch_all:
        _emit_non_exhaustive_fix(fixes, file, match_end_line, match_end_offset, last_case_indent)

    fixes

fn _emit_non_exhaustive_fix(fixes: [EasyFix], file: String, after_line: Int, after_offset: Int, case_indent: Int):
    val spaces = " ".repeat(case_indent)
    val inner_spaces = " ".repeat(case_indent + 4)
    val new_arm = "\n{spaces}case _:\n{inner_spaces}todo(\"handle remaining cases\")"
    var fix = EasyFix.create(
        id: "L:non_exhaustive_match:{after_line}",
        description: "add missing catch-all arm with todo()",
        confidence: FixConfidence.Safe
    )
    fix.add_replacement(Replacement.create(
        file: file,
        start: after_offset,
        end: after_offset,
        line: after_line,
        column: 1,
        new_text: new_arm
    ))
    fixes.push(fix)
