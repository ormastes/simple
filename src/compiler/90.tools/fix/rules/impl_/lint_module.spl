# EasyFix Rules - Module Boundary Lint Rules (Text-Scanning)
#
# Text-based detection for module boundary violations:
#   L:export_outside_init       — export statement outside __init__.spl (Deny)
#   L:init_boundary_violation   — import bypasses __init__.spl boundary
#   L:bypass_with_code_files    — @bypass in __init__.spl with sibling .spl files

use std.tooling.easy_fix.types.{FixConfidence, Replacement, EasyFix}
use std.tooling.easy_fix.*
use compiler.tools.fix.rules.helpers.*

# ============================================================================
# Rule: export_outside_init
# Detects `export` statements in files that are NOT __init__.spl.
# Level: Deny
#
# Edit (Safe) only for the mechanical subset: a single-line `export a, b` of
# bare names where every name is a top-level `fn` defined exactly once in this
# file, exported by no other line, not `rt_*` and not `extern`. The edit deletes
# the export line and prefixes each non-pub definition with `pub `.
# `pub val` alone does not export (module_system.md E0410), so vals/consts,
# names defined elsewhere, `export use`, dotted/star/braced forms and anything
# else stay a diagnostic with no replacement (Uncertain): moving to
# __init__.spl is a cross-file decision (see PR #9006 decision rules).
# ============================================================================

fn check_export_outside_init(source: text, file: text) -> [EasyFix]:
    val lines = source.split("\n")
    check_export_outside_init_with_view(file, lines, line_contexts_from_lines(lines))

pub fn check_export_outside_init_with_view(file: text, lines: [text], contexts: [LineContext]) -> [EasyFix]:
    # Only trigger if file is NOT an __init__.spl
    if file.ends_with("__init__.spl"):
        return []

    if _is_forwarding_pub_use_shim_lines(lines):
        return []

    var export_ctxs: [LineContext] = []
    for raw_ctx in contexts:
        val ctx: LineContext = raw_ctx
        # Match lines starting with `export ` (not `# export` comments)
        if ctx.trimmed.starts_with("export "):
            export_ctxs.push(ctx)
    if export_ctxs.is_empty():
        return []

    # How many export lines name each bare identifier, and where each
    # top-level fn is defined (count, context index, already pub).
    var export_counts: Dict<text, i64> = {}
    for ctx in export_ctxs:
        for name in _export_bare_names(ctx.trimmed):
            export_counts[name] = (export_counts.get(name) ?? 0) + 1
    var def_counts: Dict<text, i64> = {}
    var def_index: Dict<text, i64> = {}
    var def_is_pub: Dict<text, bool> = {}
    var i = 0
    while i < contexts.len():
        val ctx: LineContext = contexts[i]
        if ctx.indent == 0:
            val is_pub = ctx.trimmed.starts_with("pub ")
            val decl = if is_pub: ctx.trimmed.slice(4).trim() else: ctx.trimmed
            if decl.starts_with("fn "):
                val name = _leading_identifier(decl.slice(3).trim())
                if name != "" and export_counts.has(name):
                    def_counts[name] = (def_counts.get(name) ?? 0) + 1
                    def_index[name] = i
                    def_is_pub[name] = is_pub
        i = i + 1

    val last: LineContext = contexts[contexts.len() - 1]
    val source_len = last.byte_offset + last.line.len()
    var fixes: [EasyFix] = []
    for ctx in export_ctxs:
        val names = _export_bare_names(ctx.trimmed)
        var mechanical = ctx.indent == 0 and names.len() > 0
        for name in names:
            if name.starts_with("rt_") or (export_counts.get(name) ?? 0) != 1 or (def_counts.get(name) ?? 0) != 1:
                mechanical = false
        if not mechanical:
            fixes.push(EasyFix.create(
                id: "L:export_outside_init:{ctx.line_num}",
                description: "export statement outside __init__.spl — move it to the package __init__.spl as `export use` (no automatic edit: not every name is a local fn)",
                confidence: FixConfidence.Uncertain
            ))
            continue
        var fix = EasyFix.create(
            id: "L:export_outside_init:{ctx.line_num}",
            description: "export statement outside __init__.spl — remove it and mark the exported fn(s) pub",
            confidence: FixConfidence.Safe
        )
        # Deletion first: lint takes the diagnostic line from replacements[0].
        var del_end = ctx.byte_offset + ctx.line.len() + 1
        if del_end > source_len:
            del_end = source_len
        fix.add_replacement(Replacement.create(
            file: file,
            start: ctx.byte_offset,
            end: del_end,
            line: ctx.line_num,
            column: 1,
            new_text: ""
        ))
        for name in names:
            if not (def_is_pub.get(name) ?? false):
                val def_ctx: LineContext = contexts[def_index[name]]
                fix.add_replacement(Replacement.create(
                    file: file,
                    start: def_ctx.byte_offset,
                    end: def_ctx.byte_offset,
                    line: def_ctx.line_num,
                    column: 1,
                    new_text: "pub "
                ))
        fixes.push(fix)

    fixes

fn _export_bare_names(trimmed: text) -> [text]:
    """Names of a single-line `export a, b` of bare identifiers; [] for any other form."""
    val rest = trimmed.slice(7).trim()
    if rest == "" or rest.starts_with("use ") or rest.contains("#"):
        return []
    var names: [text] = []
    for part in rest.split(","):
        val name = part.trim()
        if name == "" or _leading_identifier(name) != name:
            return []
        names.push(name)
    names

fn _leading_identifier(value: text) -> text:
    var end = 0
    for ch in value.chars():
        val is_alpha = (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or ch == "_"
        val is_digit = ch >= "0" and ch <= "9"
        if is_alpha or (is_digit and end > 0):
            end = end + 1
        else:
            break
    value.slice(0, end)

fn _is_forwarding_pub_use_shim(source: text) -> bool:
    _is_forwarding_pub_use_shim_lines(source.split("\n"))

fn _is_forwarding_pub_use_shim_lines(lines: [text]) -> bool:
    """Detect narrow forwarding facade files made only of imports/re-exports."""
    var saw_reexport = false
    var continuation_depth = 0

    for line in lines:
        val trimmed = line.trim()

        if trimmed == "" or trimmed.starts_with("#"):
            continue

        if continuation_depth > 0:
            continuation_depth = continuation_depth + _brace_delta(trimmed)
            continue

        if trimmed.starts_with("pub use "):
            saw_reexport = true
            continuation_depth = continuation_depth + _brace_delta(trimmed)
            continue

        if trimmed.starts_with("use "):
            continuation_depth = continuation_depth + _brace_delta(trimmed)
            continue

        if trimmed.starts_with("export "):
            saw_reexport = true
            continuation_depth = continuation_depth + _brace_delta(trimmed)
            continue

        return false

    saw_reexport and continuation_depth == 0

fn _brace_delta(line: text) -> int:
    var delta = 0
    for ch in line.chars():
        if ch == "{{":
            delta = delta + 1
        if ch == "}":
            delta = delta - 1
    delta

# ============================================================================
# Rule: init_boundary_violation
# Detects imports that bypass a directory's __init__.spl boundary by
# reaching into internal submodules directly.
#
# Heuristic: flags `use crate.pkg.sub.X` style imports where the path
# has 4+ segments — suggesting it may be reaching past a public facade.
# This is a text-scanning approximation; full resolution needs the resolver.
#
# Confidence: Uncertain (heuristic — may have false positives)
# ============================================================================

fn check_init_boundary_violation(source: text, file: text) -> [EasyFix]:
    check_init_boundary_violation_with_contexts(file, line_contexts(source))

pub fn check_init_boundary_violation_with_contexts(file: text, contexts: [LineContext]) -> [EasyFix]:
    var fixes: [EasyFix] = []
    for raw_ctx in contexts:
        val ctx: LineContext = raw_ctx

        if ctx.trimmed.starts_with("use "):
            val import_path = _extract_import_path(ctx.trimmed)
            if import_path != "":
                # Check for deep internal imports — paths with internal/private segments
                val segments = import_path.split(".")
                var has_internal = false
                for segment in segments:
                    if segment == "internal" or segment == "private" or segment == "_impl":
                        has_internal = true

                if has_internal:
                    # Diagnostic only: the facade path is a resolver decision,
                    # so there is no edit (never an identity replacement).
                    fixes.push(EasyFix.create(
                        id: "L:init_boundary_violation:{ctx.line_num}",
                        description: "import path '{import_path}' reaches into internal module — use the public __init__.spl facade instead",
                        confidence: FixConfidence.Uncertain
                    ))

    fixes

fn _extract_import_path(trimmed: text) -> text:
    """Extract the module path from a use statement."""
    var rest = trimmed.slice(4).trim()
    # Strip 'lazy ' modifier if present
    if rest.starts_with("lazy "):
        rest = rest.slice(5).trim()
    # Strip trailing .* or .{...}
    val star_pos = rest.find(".*")
    if star_pos >= 0:
        return rest.slice(0, star_pos)
    val brace_pos = rest.find(".{{")
    if brace_pos >= 0:
        return rest.slice(0, brace_pos)
    # Strip trailing comment
    val hash_pos = rest.find(" #")
    if hash_pos >= 0:
        rest = rest.slice(0, hash_pos)
    rest.trim()

# ============================================================================
# Rule: bypass_with_code_files
# Only checks __init__.spl files.
# If the file contains @bypass, warns if the directory also has
# other .spl files (which would be bypassed by the attribute).
#
# Note: This rule uses file path heuristics since we cannot list
# directory contents in pure text scanning. It checks whether the
# source itself references sibling files.
#
# Confidence: Uncertain (text heuristic)
# ============================================================================

fn check_bypass_with_code_files(source: text, file: text) -> [EasyFix]:
    # Only check __init__.spl files
    if not file.ends_with("__init__.spl"):
        return []

    check_bypass_with_code_files_with_lines(file, source.split("\n"))

pub fn check_bypass_with_code_files_with_lines(file: text, lines: [text]) -> [EasyFix]:
    if not file.ends_with("__init__.spl"):
        return []

    var has_bypass = false
    var bypass_line = 0
    var line_num = 0

    for line in lines:
        line_num = line_num + 1
        val trimmed = line.trim()

        if trimmed.starts_with("@bypass") or trimmed == "@bypass":
            has_bypass = true
            bypass_line = line_num

    if not has_bypass:
        return []

    # Check if there are export or pub use statements referencing local files
    # which indicates sibling .spl files exist
    var has_local_exports = false
    for line in lines:
        val trimmed = line.trim()
        if trimmed.starts_with("pub use ") or trimmed.starts_with("export "):
            has_local_exports = true

    if has_local_exports:
        # Diagnostic only: there is no mechanical edit (never an empty edit).
        return [EasyFix.create(
            id: "L:bypass_with_code_files:{bypass_line}",
            description: "#[bypass] in __init__.spl with sibling code files — bypass may hide module contents",
            confidence: FixConfidence.Uncertain
        )]

    []
