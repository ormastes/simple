# SPL-BOUND-002 boundary-return autofix (plan section 7.3, single-file case).
#
# Detection is owned by check_bound_late_casts (35.semantics/lint/bound_late_cast.spl).
# For a finding whose cast argument is exactly one raw extern call whose
# arguments are literals or plain locals/params, `Unit(ext(args))`, this
# proposes ONE review-required FixCandidate that (a) creates or reuses the
# boundary adapter `<extern>_as_<unit>(<extern params>)` annotated
# @unsafe(... capabilities: [ffi]) returning `Unit(ext(...))`, and (b) rewrites
# the late cast sites to call the adapter, passing the args through.
# Move form: `val r = ext(args)` then a later `Unit(r)` / `r as Unit` in the
# same function becomes `val r = <adapter>(args)` and the cast becomes `r` --
# only when `r` has no other use in that function.
#
# Never Safe (confidence Uncertain -> ReviewRequired) and never a no-op edit.
# It aborts with NO fix when the cast argument is neither such a call nor such
# a local, when an extern argument is a nested expression, when the local has
# another raw use, or when a line is not ASCII (byte spans are not trusted).
# Edits carry preconditions, so they only apply through the revision/hash
# checked EditTransaction (std.common.diagnostics.fix_transaction).

use compiler.semantics.lint.bound_late_cast.{check_bound_late_casts, BoundLateCastFinding}
use std.common.diagnostics.diagnostic_v1.{DiagnosticFixConfidence}
use std.common.diagnostics.diagnostic_batch.{FixCandidate}
use std.common.diagnostics.span.{Span}
use std.common.diagnostics.fix_transaction.{DocumentSnapshot}
use std.tooling.easy_fix.types.{FixConfidence, Replacement, EasyFix}

struct BoundSite:
    adapter: text
    extern_name: text
    unit_name: text
    call_args: text
    line: i64
    col: i64
    start: i64
    end: i64
    old_text: text
    # Move-to-boundary form (`val local = ext(args)` then a late cast of
    # `local`): mv_line > 0, the val's rhs span is rewritten to the adapter
    # call and the cast is replaced by `local`.
    local: text
    mv_line: i64
    mv_col: i64
    mv_start: i64
    mv_end: i64
    mv_old: text

fn _bf_unit_of(f: BoundLateCastFinding) -> text:
    val a = f.message.find("`")
    if a < 0:
        return ""
    val rest = f.message.substring(a + 1, f.message.byte_len())
    val b = rest.find("`")
    if b < 0:
        return ""
    rest.substring(0, b)

fn _bf_ident_char(c: text) -> bool:
    (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or (c >= "0" and c <= "9") or c == "_"

# Index of the `)` closing the `(` at `open`, or -1.
fn _bf_close(s: text, open: i64) -> i64:
    var depth = 0
    var i = open
    while i < s.byte_len():
        val c = s.substring(i, i + 1)
        if c == "(":
            depth = depth + 1
        elif c == ")":
            depth = depth - 1
            if depth == 0:
                return i
        i = i + 1
    -1

fn _bf_literal(part: text) -> bool:
    val p = part.trim()
    if p == "":
        return false
    if p == "true" or p == "false":
        return true
    var i = 0
    while i < p.byte_len():
        val c = p.substring(i, i + 1)
        if not ((c >= "0" and c <= "9") or c == "-" or c == "." or c == "_" or c == "x"):
            return false
        i = i + 1
    true

fn _bf_ident(part: text) -> bool:
    val p = part.trim()
    if p == "":
        return false
    val c0 = p.substring(0, 1)
    if c0 >= "0" and c0 <= "9":
        return false
    var i = 0
    while i < p.byte_len():
        if not _bf_ident_char(p.substring(i, i + 1)):
            return false
        i = i + 1
    p != "true" and p != "false"

# Argument list of literals and plain locals/params (passed through to the
# adapter unchanged); empty is fine. A nested call or other expression is
# ambiguous and yields no fix.
fn _bf_args_simple(args: text) -> bool:
    if args.trim() == "":
        return true
    for part in args.split(","):
        if not _bf_literal(part) and not _bf_ident(part):
            return false
    true

fn _bf_arg_count(args: text) -> i64:
    if args.trim() == "":
        return 0
    args.split(",").len()

fn _bf_strip_extern(line: text) -> text:
    var t = line.trim()
    if t.starts_with("pub "):
        t = t.substring(4, t.byte_len())
    if t.starts_with("unsafe "):
        t = t.substring(7, t.byte_len())
    t

fn _bf_extern_names(lines: [text]) -> [text]:
    var out: [text] = []
    for line in lines:
        val t = _bf_strip_extern(line)
        if t.starts_with("extern fn "):
            val rest = t.substring(10, t.byte_len())
            var i = 0
            while i < rest.byte_len() and _bf_ident_char(rest.substring(i, i + 1)):
                i = i + 1
            if i > 0 and not out.contains(rest.substring(0, i)):
                out.push(rest.substring(0, i))
    out

fn _bf_extern_line(lines: [text], name: text) -> i64:
    val needle = "extern fn " + name + "("
    var i = 0
    while i < lines.len():
        if _bf_strip_extern(lines[i]).starts_with(needle):
            return i
        i = i + 1
    -1

# Declared parameter list text ("a: i32, b: i32") of a simple extern, or None
# when the declaration is not simple (generics, nested parens, unnamed params).
fn _bf_extern_params(lines: [text], name: text) -> text?:
    val idx = _bf_extern_line(lines, name)
    if idx < 0:
        return None
    val t = _bf_strip_extern(lines[idx])
    val open = ("extern fn " + name + "(").byte_len() - 1
    val close = _bf_close(t, open)
    if close < 0:
        return None
    val inner = t.substring(open + 1, close)
    if inner.contains("<") or inner.contains("("):
        return None
    if inner.trim() == "":
        return Some("")
    for part in inner.split(","):
        if not part.contains(":"):
            return None
    Some(inner.trim())

fn _bf_param_names(decl: text) -> text:
    if decl == "":
        return ""
    var names: [text] = []
    for part in decl.split(","):
        names.push(part.substring(0, part.find(":")).trim())
    names.join(", ")

fn _bf_line_offset(lines: [text], index: i64) -> i64:
    var off = 0
    var i = 0
    while i < index:
        off = off + lines[i].byte_len() + 1
        i = i + 1
    off

# One rewritable site for the finding, or None when the case is ambiguous.
fn _bf_site(lines: [text], externs: [text], f: BoundLateCastFinding) -> BoundSite?:
    val unit_name = _bf_unit_of(f)
    if unit_name == "" or f.line_num < 1 or f.line_num > lines.len():
        return None
    val line = lines[f.line_num - 1]
    if line.byte_len() != line.len():
        return None
    val needle = unit_name + "("
    var from = 0
    while from < line.byte_len():
        val k = line.substring(from, line.byte_len()).find(needle)
        if k < 0:
            break
        val at = from + k
        from = at + needle.byte_len()
        if at > 0:
            val before = line.substring(at - 1, at)
            if _bf_ident_char(before) or before == ".":
                continue
        val open = at + unit_name.byte_len()
        val close = _bf_close(line, open)
        if close < 0:
            return None
        val arg = line.substring(open + 1, close).trim()
        if _bf_ident(arg):
            return _bf_move_site(lines, externs, f.line_num, unit_name, arg, at, close + 1)
        val base = _bf_line_offset(lines, f.line_num - 1)
        match _bf_ext_call(externs, arg):
            Some(ec):
                return Some(BoundSite(
                    adapter: ec.0 + "_as_" + unit_name,
                    extern_name: ec.0,
                    unit_name: unit_name,
                    call_args: ec.1,
                    line: f.line_num,
                    col: at + 1,
                    start: base + at,
                    end: base + close + 1,
                    old_text: line.substring(at, close + 1),
                    local: "",
                    mv_line: 0,
                    mv_col: 0,
                    mv_start: 0,
                    mv_end: 0,
                    mv_old: ""
                ))
            None:
                return None
    # `local as Unit`: only the move-to-boundary form applies.
    val as_needle = " as " + unit_name
    val k = line.find(as_needle)
    if k <= 0:
        return None
    val after = k + as_needle.byte_len()
    if after < line.byte_len() and _bf_ident_char(line.substring(after, after + 1)):
        return None
    var b = k
    while b > 0 and _bf_ident_char(line.substring(b - 1, b)):
        b = b - 1
    if b > 0 and line.substring(b - 1, b) == ".":
        return None
    val local = line.substring(b, k)
    if not _bf_ident(local):
        return None
    _bf_move_site(lines, externs, f.line_num, unit_name, local, b, after)

# `ext(args)` with simple args -> (extern name, trimmed args); else None.
fn _bf_ext_call(externs: [text], expr: text) -> (text, text)?:
    val arg = expr.trim()
    for e in externs:
        if not arg.starts_with(e + "(") or not arg.ends_with(")"):
            continue
        if _bf_close(arg, e.byte_len()) != arg.byte_len() - 1:
            continue
        val call_args = arg.substring(e.byte_len() + 1, arg.byte_len() - 1)
        if not _bf_args_simple(call_args):
            return None
        return Some((e, call_args.trim()))
    None

# Whole-identifier occurrences of `w` in `s`.
fn _bf_count_word(s: text, w: text) -> i64:
    var n = 0
    var from = 0
    while from < s.byte_len():
        val k = s.substring(from, s.byte_len()).find(w)
        if k < 0:
            return n
        val at = from + k
        val end = at + w.byte_len()
        val left_ok = at == 0 or not (_bf_ident_char(s.substring(at - 1, at)) or s.substring(at - 1, at) == ".")
        val right_ok = end >= s.byte_len() or not _bf_ident_char(s.substring(end, end + 1))
        if left_ok and right_ok:
            n = n + 1
        from = end
    n

fn _bf_indent(s: text) -> i64:
    var i = 0
    while i < s.byte_len() and s.substring(i, i + 1) == " ":
        i = i + 1
    i

# `val local = ext(args)` earlier in the same function, then the late cast
# `[cast_start, cast_end)` of `local` on line `line_num`: move the conversion to
# the boundary (adapter call at the val) and drop the late cast. Only when
# `local` has no other use in the function (else the raw value escapes).
fn _bf_move_site(lines: [text], externs: [text], line_num: i64, unit_name: text, local: text, cast_start: i64, cast_end: i64) -> BoundSite?:
    val ci = line_num - 1
    var h = ci - 1
    while h >= 0:
        var t = lines[h].trim()
        for p in ["pub ", "static ", "async ", "unsafe "]:
            if t.starts_with(p):
                t = t.substring(p.byte_len(), t.byte_len())
        if (t.starts_with("fn ") or t.starts_with("me ")) and _bf_indent(lines[h]) < _bf_indent(lines[ci]):
            break
        h = h - 1
    if h < 0:
        return None
    val hind = _bf_indent(lines[h])
    var vi = -1
    var uses = 0
    var in_doc = false
    var i = h + 1
    while i < lines.len():
        val l = lines[i]
        val lt = l.trim()
        # Comments and doc-string lines never end the body (a column-0 `#`
        # must not hide a later raw use); their mentions still count.
        val doc_line = in_doc or lt.starts_with("\"\"\"")
        if lt.starts_with("\"\"\""):
            val rest = lt.substring(3, lt.byte_len())
            if not (rest.contains("\"\"\"") and not in_doc):
                in_doc = not in_doc
        elif in_doc and lt.contains("\"\"\""):
            in_doc = false
        if lt != "" and not lt.starts_with("#") and not doc_line and _bf_indent(l) <= hind:
            break
        if l.trim().starts_with("val " + local + " = ") or l.trim().starts_with("var " + local + " "):
            if vi >= 0 or i > ci or l.trim().starts_with("var "):
                return None
            vi = i
        uses = uses + _bf_count_word(l, local)
        i = i + 1
    if vi < 0 or uses != 2 or _bf_count_word(lines[ci], local) != 1:
        return None
    val vl = lines[vi]
    if vl.byte_len() != vl.len():
        return None
    val eq = vl.find(" = ")
    val rhs_at = eq + 3
    match _bf_ext_call(externs, vl.substring(rhs_at, vl.byte_len())):
        Some(ec):
            val rhs_end = rhs_at + vl.substring(rhs_at, vl.byte_len()).trim().byte_len()
            val vbase = _bf_line_offset(lines, vi)
            val base = _bf_line_offset(lines, ci)
            return Some(BoundSite(
                adapter: ec.0 + "_as_" + unit_name,
                extern_name: ec.0,
                unit_name: unit_name,
                call_args: ec.1,
                line: line_num,
                col: cast_start + 1,
                start: base + cast_start,
                end: base + cast_end,
                old_text: lines[ci].substring(cast_start, cast_end),
                local: local,
                mv_line: vi + 1,
                mv_col: rhs_at + 1,
                mv_start: vbase + rhs_at,
                mv_end: vbase + rhs_end,
                mv_old: vl.substring(rhs_at, rhs_end)
            ))
        None:
            return None

# True when line `idx` lies in the body of `fn <name>(` (nearest enclosing
# less-indented fn header).
fn _bf_inside_fn(lines: [text], idx: i64, name: text) -> bool:
    var h = idx - 1
    while h >= 0:
        var t = lines[h].trim()
        for p in ["pub ", "static ", "async ", "unsafe "]:
            if t.starts_with(p):
                t = t.substring(p.byte_len(), t.byte_len())
        if (t.starts_with("fn ") or t.starts_with("me ")) and _bf_indent(lines[h]) < _bf_indent(lines[idx]):
            return t.starts_with("fn " + name + "(")
        h = h - 1
    false

fn _bf_has_adapter(lines: [text], adapter: text) -> bool:
    for line in lines:
        var t = line.trim()
        if t.starts_with("pub "):
            t = t.substring(4, t.byte_len())
        if t.starts_with("fn " + adapter + "("):
            return true
    false

fn _bf_adapter_text(site: BoundSite, decl: text) -> text:
    val names = _bf_param_names(decl)
    "@unsafe(reason: \"TODO verify C ABI\", capabilities: [ffi])\nfn " + site.adapter + "(" + decl + ") -> " + site.unit_name + ":\n    " + site.unit_name + "(" + site.extern_name + "(" + names + "))"

# `unit Name: T in LO..=HI` declared in `lines` -> (LO, HI) trimmed literals, or
# None when the unit has no inclusive literal range.
fn _bf_unit_range(lines: [text], unit_name: text) -> (text, text)?:
    val head = "unit " + unit_name + ":"
    for line in lines:
        var t = line.trim()
        if t.starts_with("pub "):
            t = t.substring(4, t.byte_len())
        if not t.starts_with(head):
            continue
        val at = t.find(" in ")
        if at < 0:
            return None
        var range = t.substring(at + 4, t.byte_len())
        val as_at = range.find(" as ")
        if as_at >= 0:
            range = range.substring(0, as_at)
        val dots = range.find("..=")
        if dots < 0:
            return None
        val lo = range.substring(0, dots).trim()
        val hi = range.substring(dots + 3, range.byte_len()).trim()
        if _bf_literal(lo) and _bf_literal(hi):
            return Some((lo, hi))
        return None
    None

fn _bf_has_range(lines: [text], unit_name: text) -> bool:
    match _bf_unit_range(lines, unit_name):
        Some(_): true
        None: false

# Variant adapter name: the constrained form is `<adapter>_checked`.
fn _bf_adapter_for(mode: text, adapter: text) -> text:
    if mode == "constrained":
        return adapter + "_checked"
    adapter

fn _bf_checked_adapter_text(site: BoundSite, decl: text, lo: text, hi: text, name: text) -> text:
    val names = _bf_param_names(decl)
    "@unsafe(reason: \"TODO verify C ABI\", capabilities: [ffi])\nfn " + name + "(" + decl + ") -> " + site.unit_name + "?:\n    val raw = " + site.extern_name + "(" + names + ")\n    if raw < " + lo + " or raw > " + hi + ":\n        return None\n    Some(" + site.unit_name + "(raw))"

# Shared generator. mode "adapter": every rewritable site (id SPL-BOUND-002).
# "move": only `val r = ext(args)` + later cast sites (SPL-BOUND-002-MOVE).
# "constrained": direct-call sites of a unit with an inclusive `in LO..=HI`
# range; the adapter range-checks and returns `Unit?` (SPL-BOUND-002-CONSTRAINED),
# so rewritten sites now yield an Option the reviewer must handle.
fn _bf_candidates(source: text, file: text, version: i64, mode: text) -> [FixCandidate]:
    var out: [FixCandidate] = []
    val findings = check_bound_late_casts(source, file)
    if findings.len() == 0:
        return out
    val lines = source.split("\n")
    val externs = _bf_extern_names(lines)
    var sites: [BoundSite] = []
    for f in findings:
        match _bf_site(lines, externs, f):
            Some(s):
                if mode == "move" and s.mv_line == 0:
                    continue
                if mode == "constrained" and (s.mv_line > 0 or not _bf_has_range(lines, s.unit_name)):
                    continue
                # A cast inside the adapter itself would become self-recursive.
                if not _bf_inside_fn(lines, s.line - 1, _bf_adapter_for(mode, s.adapter)):
                    sites.push(s)
            None:
                pass
    var done: [text] = []
    for first in sites:
        val name = _bf_adapter_for(mode, first.adapter)
        if done.contains(name):
            continue
        done.push(name)
        val decl = _bf_extern_params(lines, first.extern_name) ?? "?"
        if decl == "?" or _bf_arg_count(first.call_args) != _bf_arg_count(decl):
            continue
        var prefix = "SPL-BOUND-002:"
        if mode == "move":
            prefix = "SPL-BOUND-002-MOVE:"
        elif mode == "constrained":
            prefix = "SPL-BOUND-002-CONSTRAINED:"
        var summary = "Return " + first.unit_name + " from boundary adapter " + name
        var detail = "Review required. Creates (or reuses) @unsafe(reason: \"TODO verify C ABI\", capabilities: [ffi]) fn " + name + " returning " + first.unit_name + "(" + first.extern_name + "(...)), and rewrites the late cast to " + name + "(" + first.call_args + "). Verify the C ABI and the unit range before accepting."
        if mode == "constrained":
            summary = "Return " + first.unit_name + "? from range-checked adapter " + name
            detail = "Review required. Creates (or reuses) @unsafe(reason: \"TODO verify C ABI\", capabilities: [ffi]) fn " + name + " that returns None when the raw value is outside the unit's declared range, and rewrites the late cast to " + name + "(" + first.call_args + "). The site now yields " + first.unit_name + "?; handle None before accepting."
        var c = FixCandidate.new(prefix + name, summary, detail, DiagnosticFixConfidence.Uncertain, version)
        if not _bf_has_adapter(lines, name):
            val el = _bf_extern_line(lines, first.extern_name)
            val at = _bf_line_offset(lines, el) + lines[el].byte_len()
            var adapter_text = _bf_adapter_text(first, decl)
            if mode == "constrained":
                if val rg = _bf_unit_range(lines, first.unit_name):
                    adapter_text = _bf_checked_adapter_text(first, decl, rg.0, rg.1, name)
                else:
                    continue
            c = c.with_replacement(file, Span.new(at, at, el + 1, lines[el].byte_len() + 1), "\n" + adapter_text, "")
        for s in sites:
            if _bf_adapter_for(mode, s.adapter) == name and _bf_arg_count(s.call_args) == _bf_arg_count(decl):
                if s.mv_line > 0:
                    c = c.with_replacement(file, Span.new(s.mv_start, s.mv_end, s.mv_line, s.mv_col), name + "(" + s.call_args + ")", s.mv_old)
                    c = c.with_replacement(file, Span.new(s.start, s.end, s.line, s.col), s.local, s.old_text)
                else:
                    c = c.with_replacement(file, Span.new(s.start, s.end, s.line, s.col), name + "(" + s.call_args + ")", s.old_text)
        out.push(c)
    out

# Fix candidates for SPL-BOUND-002 in one file: at most one per adapter name,
# each grouping every rewritable cast site of that adapter. `version` is the
# document version the candidate is computed against.
pub fn bound_late_cast_fix_candidates(source: text, file: text, version: i64) -> [FixCandidate]:
    _bf_candidates(source, file, version, "adapter")

# The variants below take the DocumentSnapshot they will be applied to and stamp
# its version; the registry/easy-fix path stamps version 0, which EasyFix drops:
# run_fix_producers rebinds each proposal to the live snapshot version.
# Move-cast-to-boundary: only the `val r = ext(args)` ... `Unit(r)` sites; the
# conversion moves to the binding via the adapter and the late cast is dropped.
pub fn bound_late_cast_move_candidates(doc: DocumentSnapshot) -> [FixCandidate]:
    _bf_candidates(doc.body, doc.file, doc.version, "move")

# Constrained adapter: range-checked, Option-returning, for ranged units.
pub fn bound_late_cast_constrained_candidates(doc: DocumentSnapshot) -> [FixCandidate]:
    _bf_candidates(doc.body, doc.file, doc.version, "constrained")

# Header line index and name of the function enclosing line index `idx`, or -1.
fn _bf_enclosing_fn(lines: [text], idx: i64) -> (i64, text):
    var h = idx - 1
    while h >= 0:
        var t = lines[h].trim()
        for p in ["pub ", "static ", "async ", "unsafe "]:
            if t.starts_with(p):
                t = t.substring(p.byte_len(), t.byte_len())
        if (t.starts_with("fn ") or t.starts_with("me ")) and _bf_indent(lines[h]) < _bf_indent(lines[idx]):
            val rest = t.substring(3, t.byte_len())
            var i = 0
            while i < rest.byte_len() and _bf_ident_char(rest.substring(i, i + 1)):
                i = i + 1
            return (h, rest.substring(0, i))
        h = h - 1
    (-1, "")

# Scoped exemption: inserts `@allow(bound_late_cast) # reason: <reason>` above
# each function that holds an SPL-BOUND-002 finding (one candidate per
# function). A blank reason yields no candidate: the lint ignores an exemption
# without one, so offering it would be a no-op edit.
pub fn bound_late_cast_allow_candidates(doc: DocumentSnapshot, reason: text) -> [FixCandidate]:
    _bf_allow(doc.body, doc.file, doc.version, reason, false)

# Registry form: the reason is the `# reason: <text>` comment the author wrote
# on the line directly above the function header; no comment, no candidate.
fn _bf_allow_hinted(source: text, file: text) -> [FixCandidate]:
    _bf_allow(source, file, 0, "", true)

fn _bf_reason_hint(lines: [text], header: i64) -> text:
    if header < 1:
        return ""
    val prev = lines[header - 1].trim()
    if not prev.starts_with("# reason:"):
        return ""
    prev.substring(9, prev.byte_len()).trim()

fn _bf_allow(source: text, file: text, version: i64, reason: text, hinted: bool) -> [FixCandidate]:
    var out: [FixCandidate] = []
    val lines = source.split("\n")
    var done: [text] = []
    for f in check_bound_late_casts(source, file):
        if f.code != "SPL-BOUND-002" or f.line_num < 1 or f.line_num > lines.len():
            continue
        val enc = _bf_enclosing_fn(lines, f.line_num - 1)
        if enc.0 < 0 or enc.1 == "" or done.contains(enc.1):
            continue
        done.push(enc.1)
        val why = (if hinted: _bf_reason_hint(lines, enc.0) else: reason).replace("\n", " ").trim()
        if why == "":
            continue
        val at = _bf_line_offset(lines, enc.0)
        val pad = lines[enc.0].substring(0, _bf_indent(lines[enc.0]))
        var c = FixCandidate.new(
            "SPL-BOUND-002-ALLOW:" + enc.1,
            "Exempt " + enc.1 + " from SPL-BOUND-002 with a stated reason",
            "Review required. Adds @allow(bound_late_cast) with the reason \"" + why + "\" above fn " + enc.1 + ". Prefer an adapter fix; use this only when the late cast is intentional.",
            DiagnosticFixConfidence.Uncertain,
            version)
        c = c.with_replacement(file, Span.new(at, at, enc.0 + 1, 1), pad + "@allow(bound_late_cast) # reason: " + why + "\n", "")
        out.push(c)
    out

# Registry/`simple fix` entry: the candidates above as EasyFix proposals
# (Uncertain: never auto-applied). The id follows the "<code>:<line>" convention
# with the first late-cast site's line; the fix engine binds and re-validates
# the proposal against the live snapshot before any write.
fn _bf_easy_fixes(file: text, cs: [FixCandidate], code: text) -> [EasyFix]:
    var out: [EasyFix] = []
    for c in cs:
        val last = c.replacements.len() - 1
        val line = c.replacements[last].span.line
        var fix = EasyFix.create("{code}:{line}", c.explanation, FixConfidence.Uncertain)
        for r in c.replacements:
            fix.add_replacement(Replacement.create(file, r.span.start, r.span.end, r.span.line, r.span.col, r.new_text))
        out.push(fix)
    out

pub fn check_bound_late_cast_easy_fixes(file: text, source: text) -> [EasyFix]:
    _bf_easy_fixes(file, bound_late_cast_fix_candidates(source, file, 0), "SPL-BOUND-002")

# MOVE overlaps the base SPL-BOUND-002 proposal on move sites; both are Uncertain and never auto-applied, so the overlap is accepted.
pub fn check_bound_late_cast_move_easy_fixes(file: text, source: text) -> [EasyFix]:
    _bf_easy_fixes(file, _bf_candidates(source, file, 0, "move"), "SPL-BOUND-002-MOVE")

pub fn check_bound_late_cast_constrained_easy_fixes(file: text, source: text) -> [EasyFix]:
    _bf_easy_fixes(file, _bf_candidates(source, file, 0, "constrained"), "SPL-BOUND-002-CONSTRAINED")

pub fn check_bound_late_cast_allow_easy_fixes(file: text, source: text) -> [EasyFix]:
    _bf_easy_fixes(file, _bf_allow_hinted(source, file), "SPL-BOUND-002-ALLOW")
