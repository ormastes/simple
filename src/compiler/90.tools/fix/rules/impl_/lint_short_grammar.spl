# EasyFix Rules - Short Grammar Rule (L:short_grammar)
#
# The rule body has one owner: std.tooling.easy_fix.rules
# (`easy_fix_check_short_grammar_refactor` and its `_with_contexts` form, which
# the fix registry calls directly). This module only keeps the compiler-facing
# name `check_short_grammar_refactor` that the CLI lint/run commands and the
# Stage 4 entry closure resolve through `compiler.tools.fix.rules`.

use std.tooling.easy_fix.types.{EasyFix}
use std.tooling.easy_fix.rules.{easy_fix_check_short_grammar_refactor}

fn check_short_grammar_refactor(source: text, file: text) -> [EasyFix]:
    easy_fix_check_short_grammar_refactor(source, file)
