# Simple Language EasyFix Module
# Provides machine-applicable fix data structures and application engine.
# Usage: simple fix <file.spl> [--dry-run] [--fix-all] [--fix-interactive]

# I/O imports
use std.nogc_sync_mut.io.file_ops (file_read, file_atomic_write, file_exists, file_size_raw)
use std.nogc_sync_mut.io_runtime.{dir_exists}
use app.io.cli_ops (get_args)
use std.async.future.{Future}

# Import EasyFix data types from stdlib
use std.tooling.easy_fix.types.{EasyFix, Replacement, FixReport, FixConfidence, FixApplicator}
use std.tooling.easy_fix.types.{easyfix_replacements, easyfix_id, easyfix_description}

use compiler.tools.fix.source_edits.{validated_fix_sources}

use compiler.tools.fix.producer.{fix_unit_from_source}
use compiler.tools.fix.builtins.{builtin_fix_producers, run_fix_producers}
use compiler.tools.fix.engine.{snapshots_from_sources, fix_validate, fix_apply_outcome}

# `stdin_read_char` is an always-linked runtime primitive (see
# std.mcp_sdk.transport.stdio.stdio_read_line for the reference pattern).
# The previous `extern fn input_line()` had no native-build implementation
# anywhere in the tree and was falling back to an unresolved-symbol stub.
extern fn stdin_read_char() -> text

fn input_line() -> String:
    var parts: [text] = []
    while true:
        val ch = stdin_read_char()
        if ch == "":
            if parts.length() == 0:
                return ""
            return parts.join("")
        if ch == "\n":
            return parts.join("")
        parts = parts.push(ch)

# ============================================================================
# FixToolApplicator: applies fixes to source files
# ============================================================================

class FixToolApplicator:
    static fn apply(fixes: [EasyFix], sources: Dict<String, String>) -> Result<Dict<String, String>, String>:
        validated_fix_sources(fixes, sources)

    static fn apply_to_disk(fixes: [EasyFix], sources: Dict<String, String>, dry_run: Bool) -> Result<FixReport, String>:
        apply_fixes_to_disk(fixes, sources, dry_run)

    static fn filter_by_confidence(fixes: [EasyFix], min_confidence: FixConfidence) -> [EasyFix]:
        match min_confidence:
            case Safe:
                var out: [EasyFix] = []
                for f in fixes:
                    if f.is_safe():
                        out = out.push(f)
                out
            case Likely:
                var out: [EasyFix] = []
                for f in fixes:
                    if f.is_likely():
                        out = out.push(f)
                out
            case Uncertain:
                fixes

    static fn filter_by_id(fixes: [EasyFix], id_prefix: String) -> [EasyFix]:
        var out: [EasyFix] = []
        for f in fixes:
            if easyfix_id(f).starts_with(id_prefix):
                out = out.push(f)
        out

# Snapshot-writer entry for `simple fix` and lint --fix: staged validation
# (version, edits, reparse) then the drift-guarded atomic write — all in
# compiler.tools.fix.engine, shared with `simple code refactor` and the LSP.
pub fn apply_fixes_to_disk(fixes: [EasyFix], sources: Dict<String, String>, dry_run: Bool) -> Result<FixReport, String>:
    val outcome = fix_validate(fixes, snapshots_from_sources(sources))
    if not outcome.report.ok:
        return Err(outcome.report.errors.join("; "))
    fix_apply_outcome(outcome, dry_run)

pub fn fix_read_source(path: text) -> Result<text, text>:
    if not file_exists(path):
        return Err("File not found: {path}")
    if dir_exists(path):
        return Err("Expected a source file, found directory: {path}")
    val source = file_read(path)
    if source == "" and file_size_raw(path) != 0:
        return Err("Could not read file: {path}")
    Ok(source)

# ============================================================================
# InteractiveFix: prompts user for each fix
# ============================================================================

class InteractiveFix:
    static fn prompt_fixes(fixes: [EasyFix]) -> [EasyFix]:
        var accepted: [EasyFix] = []
        var i = 0

        for fix in fixes:
            print("")
            print("Fix {i + 1}/{fixes.len()}: {fix.format()}")
            print("  [y]es / [n]o / [a]ll / [q]uit > ")

            val input = input_line().trim().lower()

            match input:
                case "y":
                    accepted.push(fix)
                case "yes":
                    accepted.push(fix)
                case "a":
                    accepted.push(fix)
                    # Accept all remaining
                    var j = i + 1
                    while j < fixes.len():
                        accepted.push(fixes[j])
                        j = j + 1
                    return accepted
                case "all":
                    accepted.push(fix)
                    var j = i + 1
                    while j < fixes.len():
                        accepted.push(fixes[j])
                        j = j + 1
                    return accepted
                case "q":
                    return accepted
                case "quit":
                    return accepted
                case _:
                    val _ = 0  # Skip

            i = i + 1

        accepted

# ============================================================================
# CLI Entry Point
# ============================================================================

async fn main() -> Int:
    val args = get_args()

    if args.len() < 2:
        print("Usage: simple fix <file.spl> [options]")
        print("")
        print("Options:")
        print("  --dry-run         Show what would be fixed without applying")
        print("  --fix-all         Apply all fixes regardless of confidence")
        print("  --fix-interactive Prompt for each fix")
        print("  --fix-id=ID       Apply only fixes matching ID prefix")
        print("")
        print("Applies machine-applicable fixes from lint diagnostics.")
        return 1

    val file_path = args[1]
    val dry_run = args.contains("--dry-run") or args.contains("--fix-dry-run")
    val fix_all = args.contains("--fix-all")
    val fix_interactive = args.contains("--fix-interactive")

    var fix_id: Option<String> = nil
    for arg in args:
        if arg.starts_with("--fix-id="):
            fix_id = Some(arg.slice(9))

    val source_result = fix_read_source(file_path)
    match source_result:
        case Err(e):
            print("Error reading file: {e}")
            return 1
        case Ok(source):
            # Build source registry
            var sources: Dict<String, String> = {}
            sources[file_path] = source

            # Collect fixes from lint diagnostics
            # (In production, this would call the lint checker; here we demonstrate the structure)
            val fixes = collect_fixes_from_source(file_path, source)

            if fixes.is_empty():
                print("No fixes available for {file_path}")
                return 0

            # Filter fixes
            var filtered = if fix_all: fixes else: FixToolApplicator.filter_by_confidence(fixes, FixConfidence.Safe)

            match fix_id:
                case Some(prefix):
                    filtered = FixToolApplicator.filter_by_id(filtered, prefix)
                case None:
                    val _ = 0

            if filtered.is_empty():
                print("No applicable fixes found.")
                return 0

            # Interactive mode
            if fix_interactive:
                filtered = InteractiveFix.prompt_fixes(filtered)
                if filtered.is_empty():
                    print("No fixes applied.")
                    return 0

            # Apply fixes
            val apply_result = apply_fixes_to_disk(filtered, sources, dry_run)
            match apply_result:
                case Ok(report):
                    print(report.format(dry_run))
                    return 0
                case Err(e):
                    print("Error applying fixes: {e}")
                    return 1

    return 0

# Collect proposals for one source through the shared built-in producer set
# (compiler.tools.fix.builtins); same path as lint --fix and code actions.
pub fn collect_fixes_from_source(file_path: String, source: String) -> [EasyFix]:
    run_fix_producers(builtin_fix_producers(), fix_unit_from_source(file_path, source))

