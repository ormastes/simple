# Closed ParamExt adapter; preserves the stable LintUnit/plugin ABI.
use common.plugin.iface_id.{ParamExt}
use compiler.tools.lint.lint_rule_api.{LintParamsV1}
use compiler.common.assurance.representation_context_v1.{RepresentationProjectContextV1, RepresentationSourceContextV1, representation_source_context_v1}
use compiler.common.assurance.policy_schema.{AssuranceStrictness}
use compiler.frontend.core.flat_pool_codec.{FlatPoolReader, flat_pool_enc_text, flat_pool_dec_text}
use std.common.text_bytes.{text_to_utf8_bytes, bytes_to_text}
use std.common.crypto.sha256.{sha256_text}
use compiler.common.module_path_naming.{module_logical_name_from_path}

val REPRESENTATION_LINT_EXT_V1 = "simple.lint.representation-context.v1"
val REPRESENTATION_LINT_SCHEMA_V1 = "sha256:simple.lint.representation-context.utf8-flatpool.v1"

struct RepresentationLintContextV1:
    source_context: RepresentationSourceContextV1
    strictness: AssuranceStrictness
    source_path: text
    source_digest: text

pub fn representation_lint_params_v1(project: RepresentationProjectContextV1,
        module_identity: text, strictness: AssuranceStrictness,
        source_path: text, source: text) -> LintParamsV1:
    var params = LintParamsV1.defaults()
    val payload = flat_pool_enc_text([project.package_identity, project.provenance_kind,
        project.manifest_identity, project.manifest_digest, project.error,
        module_identity, strictness.name(), source_path, sha256_text(source)])
    params.ext = [ParamExt(REPRESENTATION_LINT_EXT_V1, 1, text_to_utf8_bytes(payload), REPRESENTATION_LINT_SCHEMA_V1)]
    params

pub fn representation_lint_context_v1(params: LintParamsV1, source_path: text,
        source: text) -> RepresentationLintContextV1?:
    var found: RepresentationLintContextV1? = nil
    var seen = false
    for extension in params.ext:
        if extension.ext_name != REPRESENTATION_LINT_EXT_V1:
            continue
        if seen or extension.ext_major != 1 or extension.payload_schema_hash != REPRESENTATION_LINT_SCHEMA_V1:
            return nil
        seen = true
        val encoded = bytes_to_text(extension.payload)
        val reader = FlatPoolReader.new_canonical(encoded)
        val fields = flat_pool_dec_text(reader)
        if not reader.ok or fields.len() != 9 or not reader.finish_canonical_frame():
            return nil
        if fields[1] != "project-config" or fields[4] != "" or fields[0] == "" or fields[2] == "" or fields[3] == "" or fields[5] == "":
            return nil
        if fields[7] != source_path or fields[8] != sha256_text(source):
            return nil
        if fields[5] != module_logical_name_from_path(source_path):
            return nil
        if not ["moderate", "strict", "robust", "critical"].contains(fields[6]):
            return nil
        val strictness = AssuranceStrictness.from_name(fields[6])
        val project = RepresentationProjectContextV1(package_identity: fields[0], provenance_kind: fields[1],
            manifest_identity: fields[2], manifest_digest: fields[3], error: fields[4])
        found = Some(RepresentationLintContextV1(
            source_context: representation_source_context_v1(project, fields[5], fields[8]),
            strictness: strictness, source_path: fields[7], source_digest: fields[8]))
    found

export representation_lint_params_v1, representation_lint_context_v1, RepresentationLintContextV1
