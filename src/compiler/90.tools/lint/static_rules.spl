export use compiler.tools.lint.lint_rule_api.*
use compiler.tools.lint.rules.param_object_rule.{param_object_lint_rule}
use compiler.tools.lint.rules.param_tag_rule.{param_tag_lint_rule}
use compiler.tools.lint.rules.silent_default_rule.{silent_default_lint_rule}
use compiler.tools.lint.rules.os_freestanding_rule.{os_freestanding_lint_rule}
use compiler.tools.lint.rules.bare_primitive_internal_rule.{bare_primitive_internal_lint_rule}
use compiler.tools.lint.rules.const_ref_default_rule.{const_ref_default_lint_rule}
use compiler.tools.lint.rules.cow_alias_hotpath_rule.{cow_alias_hotpath_lint_rule}
use compiler.tools.lint.rules.leading_operator_rule.{leading_operator_lint_rule}
use compiler.tools.lint.rules.linear_scan_in_loop_rule.{linear_scan_in_loop_lint_rule}
use compiler.tools.lint.rules.module_init_literal_rule.{module_init_literal_lint_rule}
use compiler.tools.lint.rules.raw_sffi_rule.{raw_sffi_lint_rule}
use compiler.tools.lint.rules.unwrapped_foreign_resource_rule.{unwrapped_foreign_resource_lint_rule}
use compiler.tools.lint.rules.accessor_parent_name_rule.{accessor_parent_name_lint_rule}
use compiler.tools.lint.rules.nonexistent_type_rule.{nonexistent_type_lint_rule}
use compiler.tools.lint.rules.riscv_debuggability_rule.{riscv_debuggability_lint_rule}

pub struct StaticLintRuleRun:
    findings: [StaticLintFinding]
    errors: [text]

pub fn static_lint_rule_table() -> [StaticLintRule]:
    [
        accessor_parent_name_lint_rule(),
        bare_primitive_internal_lint_rule(),
        const_ref_default_lint_rule(),
        cow_alias_hotpath_lint_rule(),
        leading_operator_lint_rule(),
        linear_scan_in_loop_lint_rule(),
        module_init_literal_lint_rule(),
        nonexistent_type_lint_rule(),
        os_freestanding_lint_rule(),
        param_object_lint_rule(),
        param_tag_lint_rule(),
        raw_sffi_lint_rule(),
        riscv_debuggability_lint_rule(),
        silent_default_lint_rule(),
        unwrapped_foreign_resource_lint_rule()
    ]

pub fn run_static_lint_rule_table(
    params: LintParamsV1, unit: LintUnit, table: [StaticLintRule]
) -> StaticLintRuleRun:
    var findings: [StaticLintFinding] = []
    var errors: [text] = []
    if params.host_iface.abi_digest != lint_rule_contract_digest_v1():
        return StaticLintRuleRun([], ["PLUG-E-HOST-DIGEST"])
    var previous_id = ""
    for rule in table:
        val rule_id = rule.id()
        if rule_id == "" or rule_id <= previous_id:
            errors.push("PLUG-E-TABLE:{rule_id}")
            continue
        previous_id = rule_id
        val negotiation = lint_rule_negotiate_v1(rule)
        if not negotiation.accepted():
            errors.push("{negotiation.code()}:{rule_id}")
            continue
        for finding in rule.check(params, unit):
            findings.push(finding)
    StaticLintRuleRun(findings, errors)
