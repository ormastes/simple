# Simple Language Linter
# Semantic lints for code quality and safety
# Usage: simple_lint <file.spl> [--deny-all] [--warn-all]

# I/O imports

# Split from src/compiler/90.tools/lint/main.spl to keep module cohesion under the 800-line source limit.
export use compiler.tools.lint._LintMain.config_and_model.*
export use compiler.tools.lint._LintMain.lint_checks.*
export use compiler.tools.lint._LintMain.traceability_and_assertions.*
# entry_and_fixes.* is deliberately NOT wildcard re-exported: that submodule
# declared the lint CLI's `fn main` (since renamed to `lint_main`), and a
# library facade re-exporting a CLI entry point leaks it into every
# wildcard-reachable consumer (a genuine API smell, and the confirmed trigger
# shape for the test-runner's phantom file-level-failure defect — see
# doc/08_tracking/bug/test_runner_wildcard_imported_main_phantom_failure_2026-08-01.md,
# tracked and fixed independently on the runner side). List every non-`main`
# symbol explicitly instead; completeness verified 2026-08-01 by grepping the
# whole repo for
# `compiler.tools.lint.main` and `compiler.tools.lint._LintMain.entry_and_fixes`
# usage — no consumer (internal sibling submodule, app/, lib/, or test/) uses
# any entry_and_fixes symbol other than `run_lint_file` and `lint_cli_source`;
# the rest are included anyway to preserve the pre-existing export surface.
export use compiler.tools.lint._LintMain.entry_and_fixes.{
    lint_cli_source, lint_cli_find_decl_line, lint_cli_find_fn_line,
    LintSourceLocationIndex, lint_source_location_index,
    lint_source_function_line, lint_source_collection_fix_line,
    collection_split_assign, collection_rewrite_for, collection_fix_line,
    collection_easy_fix, run_lint_file, collect_easy_fixes, apply_collected_fixes,
    lint_main
}
export use compiler.tools.lint._LintMain.name_lints.*
export use compiler.tools.lint._LintMain.nonexistent_type_lints.*
export use compiler.tools.lint._LintMain.os_freestanding_lints.*
export use compiler.tools.lint._LintMain.wm_lane_boundary_lints.*
