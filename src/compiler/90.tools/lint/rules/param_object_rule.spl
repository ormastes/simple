use compiler.tools.lint.param_object_rules.{check_param_object_rules}
use compiler.tools.lint.lint_rule_api.{
    LintParamsV1, LintUnit, StaticLintCategory, StaticLintFinding,
    StaticLintLevel, StaticLintRule,
    lint_rule_provider_iface, static_lint_rule
}

fn check_param_object_lint_rule(
    params: LintParamsV1, unit: LintUnit
) -> [StaticLintFinding]:
    val _ = params
    [StaticLintFinding(finding.code, StaticLintLevel.Deny, StaticLintCategory.Correctness,
        finding.message, finding.hint, finding.line_num, 0)
        for finding in check_param_object_rules(unit.content, unit.path)]

pub fn param_object_lint_rule() -> StaticLintRule:
    static_lint_rule("param_object", lint_rule_provider_iface("param_object"), check_param_object_lint_rule)
