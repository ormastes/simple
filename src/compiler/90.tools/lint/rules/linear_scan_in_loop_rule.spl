use compiler.semantics.lint.linear_scan_in_loop.{check_linear_scan_in_loop}
use compiler.tools.lint.lint_rule_api.{LintParamsV1, LintUnit, StaticLintCategory, StaticLintFinding, StaticLintLevel, StaticLintRule, lint_rule_provider_iface, static_lint_rule}

fn check_rule(params: LintParamsV1, unit: LintUnit) -> [StaticLintFinding]:
    val _ = params
    [StaticLintFinding(f.code, StaticLintLevel.Warn, StaticLintCategory.Warning, f.message, f.hint, f.line_num, 0) for f in check_linear_scan_in_loop(unit.content, unit.path)]

pub fn linear_scan_in_loop_lint_rule() -> StaticLintRule:
    static_lint_rule("linear_scan_in_loop", lint_rule_provider_iface("linear_scan_in_loop"), check_rule)
