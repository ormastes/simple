use compiler.tools.lint._LintMain.os_freestanding_lints.{lint_os_freestanding_patterns}
use compiler.tools.lint.lint_rule_api.{
    LintParamsV1, LintUnit, StaticLintCategory, StaticLintFinding,
    StaticLintLevel, StaticLintRule, lint_rule_provider_iface, static_lint_rule
}

fn check_os_freestanding_lint_rule(
    params: LintParamsV1, unit: LintUnit
) -> [StaticLintFinding]:
    val _ = params
    [StaticLintFinding(warning.code, StaticLintLevel.Warn, StaticLintCategory.Correctness,
        warning.message, warning.hint, warning.line, 0)
        for warning in lint_os_freestanding_patterns(unit.path, unit.content)]

pub fn os_freestanding_lint_rule() -> StaticLintRule:
    static_lint_rule("os_freestanding", lint_rule_provider_iface("os_freestanding"), check_os_freestanding_lint_rule)
