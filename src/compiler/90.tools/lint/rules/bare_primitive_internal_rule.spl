use compiler.semantics.lint.bare_primitive_internal.{check_bare_primitive_internal}
use compiler.tools.lint.lint_rule_api.{LintParamsV1, LintUnit, StaticLintCategory, StaticLintFinding, StaticLintLevel, StaticLintRule, lint_rule_provider_iface, static_lint_rule}

fn check_rule(params: LintParamsV1, unit: LintUnit) -> [StaticLintFinding]:
    val _ = params
    [StaticLintFinding(f.code, StaticLintLevel.Allow, StaticLintCategory.Correctness, f.message, f.note, f.line_num, 0) for f in check_bare_primitive_internal(unit.content, unit.path)]

pub fn bare_primitive_internal_lint_rule() -> StaticLintRule:
    static_lint_rule("bare_primitive_internal", lint_rule_provider_iface("bare_primitive_internal"), check_rule)
