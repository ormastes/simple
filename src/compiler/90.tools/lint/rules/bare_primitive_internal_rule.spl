use compiler.semantics.lint.bare_primitive_internal.{check_bare_primitive_internal, check_bare_primitive_internal_with_representation_v1}
use compiler.tools.lint.lint_rule_api.{LintParamsV1, LintUnit, StaticLintCategory, StaticLintFinding, StaticLintLevel, StaticLintRule, lint_rule_provider_iface, static_lint_rule}
use compiler.tools.lint.representation_lint_context_v1.{representation_lint_context_v1}
use compiler.frontend.core.representation_declarations_v1.{parse_representation_source_v1}
use compiler.common.assurance.policy_schema.{AssuranceStrictness}
use compiler.common.assurance.representation_context_v1.{representation_context_missing_v1, representation_source_context_v1}
use compiler.common.diagnostics.span.{Span}
use compiler.semantics.representation_boundary.source_binding.{representation_bind_source_v1}
use compiler.semantics.representation_boundary.validation.{representation_index_build_v1}
use std.common.crypto.sha256.{sha256_text}

fn check_rule(params: LintParamsV1, unit: LintUnit) -> [StaticLintFinding]:
    if not unit.path.ends_with(".spl"):
        return [StaticLintFinding(f.code, StaticLintLevel.Allow, StaticLintCategory.Correctness,
            f.message, f.note, f.line_num, 0) for f in check_bare_primitive_internal(unit.content, unit.path)]
    val resolved = representation_lint_context_v1(params, unit.path, unit.content)
    val context = if val value = resolved: value.source_context
        else: representation_source_context_v1(representation_context_missing_v1(), "", sha256_text(unit.content))
    val strictness = if val value = resolved: value.strictness else: AssuranceStrictness.Moderate
    # Exactly one canonical parse and one invocation-owned index for this source.
    val parsed = parse_representation_source_v1(unit.content, unit.path, "", "")
    val declarations = representation_bind_source_v1(parsed, context)
    val index = representation_index_build_v1(declarations, strictness)
    var findings = [StaticLintFinding(f.code, StaticLintLevel.Allow, StaticLintCategory.Correctness, f.message, f.note, f.line_num, 0) for f in check_bare_primitive_internal_with_representation_v1(unit.content, unit.path, index)]
    for diagnostic in index.diagnostics:
        val span = diagnostic.span ?? Span.empty()
        val level = if strictness == AssuranceStrictness.Critical: StaticLintLevel.Deny else: StaticLintLevel.Warn
        findings.push(StaticLintFinding(diagnostic.code ?? "E-MC-REP-001", level,
            StaticLintCategory.Safety, diagnostic.message, "Supply exact declaration metadata and an explicitly selected project owner", span.line, span.col))
    findings

pub fn bare_primitive_internal_lint_rule() -> StaticLintRule:
    static_lint_rule("bare_primitive_internal", lint_rule_provider_iface("bare_primitive_internal"), check_rule)
