use compiler.tools.lint._LintMain.nonexistent_type_lints.{lint_nonexistent_types}
use compiler.tools.lint.lint_rule_api.{LintParamsV1, LintUnit, StaticLintCategory, StaticLintFinding, StaticLintLevel, StaticLintRule, lint_rule_provider_iface, static_lint_rule}

fn check_rule(params: LintParamsV1, unit: LintUnit) -> [StaticLintFinding]:
    val _ = params
    [StaticLintFinding(w.code, StaticLintLevel.Warn, StaticLintCategory.Correctness, w.message, w.hint, w.line, 0) for w in lint_nonexistent_types(unit.path, unit.content)]

pub fn nonexistent_type_lint_rule() -> StaticLintRule:
    static_lint_rule("nonexistent_type", lint_rule_provider_iface("nonexistent_type"), check_rule)
