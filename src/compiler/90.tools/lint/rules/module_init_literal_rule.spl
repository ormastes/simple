use compiler.semantics.lint.module_init_literal.{check_module_init_literal}
use compiler.tools.lint.lint_rule_api.{LintParamsV1, LintUnit, StaticLintCategory, StaticLintFinding, StaticLintLevel, StaticLintRule, lint_rule_provider_iface, static_lint_rule}

fn check_rule(params: LintParamsV1, unit: LintUnit) -> [StaticLintFinding]:
    val _ = params
    [StaticLintFinding(w.code, StaticLintLevel.Warn, StaticLintCategory.Correctness, w.message, w.hint, w.line_num, 0) for w in check_module_init_literal(unit.content, unit.path)]

pub fn module_init_literal_lint_rule() -> StaticLintRule:
    static_lint_rule("module_init_literal", lint_rule_provider_iface("module_init_literal"), check_rule)
