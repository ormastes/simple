use compiler.semantics.lint.param_tag.{check_param_tag}
use compiler.tools.lint.lint_rule_api.{
    LintParamsV1, LintUnit, StaticLintCategory, StaticLintFinding,
    StaticLintLevel, StaticLintRule, lint_rule_provider_iface, static_lint_rule
}

fn check_param_tag_lint_rule(
    params: LintParamsV1, unit: LintUnit
) -> [StaticLintFinding]:
    val _ = params
    if not unit.path.contains("src/lib/"):
        return []
    [StaticLintFinding(warning.code, StaticLintLevel.Warn, StaticLintCategory.Warning,
        warning.message, warning.hint, warning.line_num, 0)
        for warning in check_param_tag(unit.content.split("\n"), unit.path)]

pub fn param_tag_lint_rule() -> StaticLintRule:
    static_lint_rule("param_tag", lint_rule_provider_iface("param_tag"), check_param_tag_lint_rule)
