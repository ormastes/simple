use compiler.semantics.lint.const_ref_default.{check_const_ref_default}
use compiler.tools.lint.lint_rule_api.{LintParamsV1, LintUnit, StaticLintCategory, StaticLintFinding, StaticLintLevel, StaticLintRule, lint_rule_provider_iface, static_lint_rule}

fn check_rule(params: LintParamsV1, unit: LintUnit) -> [StaticLintFinding]:
    val _ = params
    [StaticLintFinding(f.code, StaticLintLevel.Warn, StaticLintCategory.Correctness, f.message, f.note, f.line_num, 0) for f in check_const_ref_default(unit.content, unit.path)]

pub fn const_ref_default_lint_rule() -> StaticLintRule:
    static_lint_rule("const_ref_default", lint_rule_provider_iface("const_ref_default"), check_rule)
