use compiler.semantics.lint.cow_alias_hotpath.{check_cow_alias_hotpath}
use compiler.tools.lint.lint_rule_api.{LintParamsV1, LintUnit, StaticLintCategory, StaticLintFinding, StaticLintLevel, StaticLintRule, lint_rule_provider_iface, static_lint_rule}

fn check_rule(params: LintParamsV1, unit: LintUnit) -> [StaticLintFinding]:
    val _ = params
    [StaticLintFinding(f.code, StaticLintLevel.Warn, StaticLintCategory.Warning, f.message, f.hint, f.line_num, 0) for f in check_cow_alias_hotpath(unit.content, unit.path)]

pub fn cow_alias_hotpath_lint_rule() -> StaticLintRule:
    static_lint_rule("cow_alias_hotpath", lint_rule_provider_iface("cow_alias_hotpath"), check_rule)
