use compiler.semantics.lint.riscv_rtl_debuggability_lint.{lint_riscv_rtl_debuggability}
use compiler.tools.lint.lint_rule_api.{LintParamsV1, LintUnit, StaticLintCategory, StaticLintFinding, StaticLintLevel, StaticLintRule, lint_rule_provider_iface, static_lint_rule}

fn check_rule(params: LintParamsV1, unit: LintUnit) -> [StaticLintFinding]:
    val _ = params
    var out: [StaticLintFinding] = []
    for w in lint_riscv_rtl_debuggability(unit.content, unit.path):
        val level = if w.severity == "ERROR": StaticLintLevel.Deny else: StaticLintLevel.Warn
        out.push(StaticLintFinding(w.code, level, StaticLintCategory.Correctness, w.message, w.hint, w.line_num, 0))
    out

pub fn riscv_debuggability_lint_rule() -> StaticLintRule:
    static_lint_rule("riscv_debuggability", lint_rule_provider_iface("riscv_debuggability"), check_rule)
