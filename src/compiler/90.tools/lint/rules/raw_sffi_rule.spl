use compiler.semantics.lint.raw_sffi_call.{check_raw_sffi_calls, check_raw_sffi_declarations}
use compiler.tools.lint.lint_rule_api.{LintParamsV1, LintUnit, StaticLintCategory, StaticLintFinding, StaticLintLevel, StaticLintRule, lint_rule_provider_iface, static_lint_rule}

fn check_rule(params: LintParamsV1, unit: LintUnit) -> [StaticLintFinding]:
    val _ = params
    var out: [StaticLintFinding] = []
    for f in check_raw_sffi_calls(unit.content, unit.path):
        out.push(StaticLintFinding(f.code, StaticLintLevel.Allow, StaticLintCategory.Safety, f.message, f.note, f.line_num, 0))
    for f in check_raw_sffi_declarations(unit.content, unit.path):
        out.push(StaticLintFinding(f.code, StaticLintLevel.Allow, StaticLintCategory.Safety, f.message, f.note, f.line_num, 0))
    out

pub fn raw_sffi_lint_rule() -> StaticLintRule:
    static_lint_rule("raw_sffi", lint_rule_provider_iface("raw_sffi"), check_rule)
