use compiler.semantics.lint.bound_unit_reassert.{check_bound_unit_reasserts_cross}
use compiler.tools.lint.rules.bound_import_graph.{bound_unit_import_summaries}
use compiler.tools.lint.lint_rule_api.{LintParamsV1, LintUnit, StaticLintCategory, StaticLintFinding, StaticLintLevel, StaticLintRule, lint_rule_provider_iface, static_lint_rule}

# SPL-BOUND-003 (config/policy/diagnostic_policy.sdn): warn in every profile
# until owners ratify an error date.
fn bound_unit_reassert_check_rule(params: LintParamsV1, unit: LintUnit) -> [StaticLintFinding]:
    val _ = params
    var out: [StaticLintFinding] = []
    # Cross-file findings need a unit re-assertion via an imported eraser.
    val sums = if unit.content.contains("use "): bound_unit_import_summaries(unit.content, unit.path) else: []
    for f in check_bound_unit_reasserts_cross(unit.content, unit.path, sums):
        out.push(StaticLintFinding(f.code, StaticLintLevel.Warn, StaticLintCategory.Safety, f.message, f.note, f.line_num, 0))
    out

pub fn bound_unit_reassert_lint_rule() -> StaticLintRule:
    static_lint_rule("bound_unit_reassert", lint_rule_provider_iface("bound_unit_reassert"), bound_unit_reassert_check_rule)
