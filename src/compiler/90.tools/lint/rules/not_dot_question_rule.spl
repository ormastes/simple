use compiler.semantics.lint.not_dot_question.{check_not_dot_question}
use compiler.tools.lint.lint_rule_api.{LintParamsV1, LintUnit, StaticLintCategory, StaticLintFinding, StaticLintLevel, StaticLintRule, lint_rule_provider_iface, static_lint_rule}

fn not_dot_question_check_rule(params: LintParamsV1, unit: LintUnit) -> [StaticLintFinding]:
    val _ = params
    [StaticLintFinding(f.code, StaticLintLevel.Warn, StaticLintCategory.Correctness, f.message, f.note, f.line_num, 0) for f in check_not_dot_question(unit.content, unit.path)]

pub fn not_dot_question_lint_rule() -> StaticLintRule:
    static_lint_rule("not_dot_question", lint_rule_provider_iface("not_dot_question"), not_dot_question_check_rule)
