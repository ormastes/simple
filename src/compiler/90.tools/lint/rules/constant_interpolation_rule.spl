use compiler.semantics.lint.constant_interpolation.{check_constant_interpolation}
use compiler.tools.lint.lint_rule_api.{LintParamsV1, LintUnit, StaticLintCategory, StaticLintFinding, StaticLintLevel, StaticLintRule, lint_rule_provider_iface, static_lint_rule}

fn check_rule(params: LintParamsV1, unit: LintUnit) -> [StaticLintFinding]:
    val _ = params
    [StaticLintFinding(f.code, StaticLintLevel.Warn, StaticLintCategory.Correctness, f.message, f.note, f.line_num, 0) for f in check_constant_interpolation(unit.content, unit.path)]

pub fn constant_interpolation_lint_rule() -> StaticLintRule:
    static_lint_rule("constant_interpolation", lint_rule_provider_iface("constant_interpolation"), check_rule)
