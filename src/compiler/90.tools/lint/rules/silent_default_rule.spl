use compiler.semantics.lint.silent_default.{check_silent_default}
use compiler.tools.lint.lint_rule_api.{
    LintParamsV1, LintUnit, StaticLintCategory, StaticLintFinding,
    StaticLintLevel, StaticLintRule, lint_rule_provider_iface, static_lint_rule
}

fn check_silent_default_lint_rule(
    params: LintParamsV1, unit: LintUnit
) -> [StaticLintFinding]:
    val _ = params
    [StaticLintFinding(finding.code, StaticLintLevel.Warn, StaticLintCategory.Correctness,
        finding.message, finding.note, finding.line_num, 0)
        for finding in check_silent_default(unit.content, unit.path)]

pub fn silent_default_lint_rule() -> StaticLintRule:
    static_lint_rule("silent_default", lint_rule_provider_iface("silent_default"), check_silent_default_lint_rule)
