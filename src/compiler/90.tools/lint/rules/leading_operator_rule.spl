use compiler.semantics.lint.leading_operator.{check_leading_operator}
use compiler.tools.lint.lint_rule_api.{LintParamsV1, LintUnit, StaticLintCategory, StaticLintFinding, StaticLintLevel, StaticLintRule, lint_rule_provider_iface, static_lint_rule}

fn check_rule(params: LintParamsV1, unit: LintUnit) -> [StaticLintFinding]:
    val _ = params
    [StaticLintFinding(f.code, StaticLintLevel.Warn, StaticLintCategory.Correctness, f.message, f.note, f.line_num, 0) for f in check_leading_operator(unit.content, unit.path)]

pub fn leading_operator_lint_rule() -> StaticLintRule:
    static_lint_rule("leading_operator", lint_rule_provider_iface("leading_operator"), check_rule)
