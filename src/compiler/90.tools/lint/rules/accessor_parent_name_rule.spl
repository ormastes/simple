use compiler.tools.lint._LintMain.name_lints.{lint_accessor_and_parent_names}
use compiler.tools.lint.lint_rule_api.{LintParamsV1, LintUnit, StaticLintCategory, StaticLintFinding, StaticLintLevel, StaticLintRule, lint_rule_provider_iface, static_lint_rule}

fn check_rule(params: LintParamsV1, unit: LintUnit) -> [StaticLintFinding]:
    val _ = params
    [StaticLintFinding(w.code, StaticLintLevel.Warn, StaticLintCategory.Warning, w.message, w.hint, w.line, 0) for w in lint_accessor_and_parent_names(unit.path, unit.content)]

pub fn accessor_parent_name_lint_rule() -> StaticLintRule:
    static_lint_rule("accessor_parent_name", lint_rule_provider_iface("accessor_parent_name"), check_rule)
