use compiler.semantics.lint.unwrapped_foreign_resource.{check_unwrapped_foreign_resource}
use compiler.tools.lint.lint_rule_api.{LintParamsV1, LintUnit, StaticLintCategory, StaticLintFinding, StaticLintLevel, StaticLintRule, lint_rule_provider_iface, static_lint_rule}

fn check_rule(params: LintParamsV1, unit: LintUnit) -> [StaticLintFinding]:
    val _ = params
    [StaticLintFinding(f.code, StaticLintLevel.Allow, StaticLintCategory.Correctness, f.message, f.note, f.line_num, 0) for f in check_unwrapped_foreign_resource(unit.content, unit.path)]

pub fn unwrapped_foreign_resource_lint_rule() -> StaticLintRule:
    static_lint_rule("unwrapped_foreign_resource", lint_rule_provider_iface("unwrapped_foreign_resource"), check_rule)
