use compiler.semantics.lint.bound_late_cast.{check_bound_late_casts_cross}
use compiler.tools.lint.rules.bound_import_graph.{bound_import_summaries}
use compiler.tools.lint.lint_rule_api.{LintParamsV1, LintUnit, StaticLintCategory, StaticLintFinding, StaticLintLevel, StaticLintRule, lint_rule_provider_iface, static_lint_rule}

# SPL-BOUND-001 and SPL-BOUND-002 (config/policy/diagnostic_policy.sdn): warn in every profile
# until owners ratify an error date.
fn bound_late_cast_check_rule(params: LintParamsV1, unit: LintUnit) -> [StaticLintFinding]:
    val _ = params
    var out: [StaticLintFinding] = []
    # Cross-file findings need a late `as` cast in this file; skip the graph walk otherwise.
    val sums = if unit.content.contains(" as "): bound_import_summaries(unit.content, unit.path) else: []
    for f in check_bound_late_casts_cross(unit.content, unit.path, sums):
        out.push(StaticLintFinding(f.code, StaticLintLevel.Warn, StaticLintCategory.Safety, f.message, f.note, f.line_num, 0))
    out

pub fn bound_late_cast_lint_rule() -> StaticLintRule:
    static_lint_rule("bound_late_cast", lint_rule_provider_iface("bound_late_cast"), bound_late_cast_check_rule)
