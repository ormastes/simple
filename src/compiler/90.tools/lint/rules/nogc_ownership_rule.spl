use compiler.semantics.lint.nogc_own.checker.{check_nogc_ownership}
use compiler.tools.lint.lint_rule_api.{LintParamsV1, LintUnit, StaticLintCategory, StaticLintFinding, StaticLintLevel, StaticLintRule, lint_rule_provider_iface, static_lint_rule}

fn check_rule(params: LintParamsV1, unit: LintUnit) -> [StaticLintFinding]:
    val _ = params
    [StaticLintFinding(f.code, StaticLintLevel.Warn, StaticLintCategory.Safety, f.message, f.hint, f.line_num, 0) for f in check_nogc_ownership(unit.content, unit.path)]

pub fn nogc_ownership_lint_rule() -> StaticLintRule:
    static_lint_rule("nogc_ownership", lint_rule_provider_iface("nogc_ownership"), check_rule)
