# LintDiag config, levels, profiles, and the LintDiag/LintRunResult/Linter model.
use compiler.tools.lint.main.*
# Simple Language Linter
# Semantic lints for code quality and safety
# Usage: simple_lint <file.spl> [--deny-all] [--warn-all]

# I/O imports
use std.nogc_sync_mut.io.file_ops (file_read, file_exists, file_write)
use std.nogc_sync_mut.io.dir_ops (is_dir)
use app.io.cli_ops (get_args)

# Logging imports
use std.log.{error, info}

# Shared lint contract from the tooling layer.
# Re-export-compatible enum identities must remain canonical to avoid
# false-positive bare-name collisions when lint and tooling are both imported
# by the same module (canonical failure mode: compiler.tools.lint.main).
use std.tooling.easy_fix.types.{EasyFix, LintLevel, LintCategory}
use compiler.semantics.lint.riscv_rtl_debuggability_lint.{lint_riscv_rtl_debuggability}
use compiler.common.assurance.policy_names.{normalize_profile_name, deprecated_profile_alias_replacement}

# File I/O wrapper

enum LintReadFileResult:
    ReadFileOk(String)
    ReadFileErr(String)

fn lint_read_file(path: String) -> LintReadFileResult:
    val file_content = file_read(path)
    if file_content == "":
        return LintReadFileResult.ReadFileErr("Failed to read file: {path}")
    return LintReadFileResult.ReadFileOk(file_content)

# Strictness tiers (script modes) — the lint-tier axis, orthogonal to the stdlib
# memory tiers (nogc_sync_mut, ...). See
# doc/03_plan/compiler/reliable_mode/reliable_mode_plan.md,
# doc/02_requirements/language/mission_critical_profile.md § Profile ladder
# rename, and glossary.md.
#   moderate — relaxed: deny defaults downgraded to warn (advisory only)
#   strict   — current defaults (the regression-safe baseline); formerly `lib`
#   robust   — strictest: public-surface + safety/correctness lints raised to
#              deny; Rust-parity level; formerly `reliable`
#   critical — robust + REQ-MC rules (bare_primitive_internal=warn); formerly
#              `mission-critical` / `mission_critical`
#
# Renamed 2026-07-28 (user-approved). Old names (`lib`, `reliable`,
# `mission-critical`/`mission_critical`) are kept working as deprecated
# aliases in parse_lint_profile below — they still resolve to the new
# variant, but emit a one-time deprecation warning per distinct old
# spelling (see _warn_deprecated_profile_alias_once).
enum LintProfile:
    Moderate
    Strict
    Robust
    Critical

# Tracks which deprecated profile spellings have already warned this
# process. Module-level state, not a struct field: a once-only flag
# threaded through a struct would not persist (structs are value types) and
# a per-call-site warning would spam an entire build for one file attribute.
# Keyed by the exact old spelling; counts (not just a bool) so specs can
# prove "fires once, not N times" without scraping log output.
var _DEPRECATED_PROFILE_ALIAS_WARN_COUNTS: Dict<String, i64> = {}

# Emit the deprecation notice for `old_name` -> `new_name` exactly once per
# process, no matter how many times parse_lint_profile is called with it.
fn _warn_deprecated_profile_alias_once(old_name: String, new_name: String):
    if _DEPRECATED_PROFILE_ALIAS_WARN_COUNTS.contains_key(old_name):
        return
    _DEPRECATED_PROFILE_ALIAS_WARN_COUNTS[old_name] = 1
    info("lint", "lint profile '{old_name}' is deprecated, use '{new_name}' instead")

# Test-support accessor: how many times has the deprecation notice actually
# fired for this old spelling (0 or 1, never more)? Not used by production
# logic — exists so specs can prove the warn-once contract directly.
fn deprecated_profile_alias_warn_count(old_name: String) -> i64:
    if _DEPRECATED_PROFILE_ALIAS_WARN_COUNTS.contains_key(old_name):
        return _DEPRECATED_PROFILE_ALIAS_WARN_COUNTS[old_name]
    return 0

# Parse a profile string into LintProfile. Returns nil for unknown strings.
# Accepts both current names and deprecated pre-2026-07-28 aliases.
#
# WP-3 (2026-08-07): the name/alias table itself now lives in
# compiler.common.assurance.policy_names — this function is lint's PROJECTION
# of it onto LintProfile (the driver projects the same table onto
# SafetyPassSeverity and the interpreter onto a bool; three meanings, one
# table). The warn-once counter dict stays here on purpose: the driver's own
# header says deprecation warnings are the lint CLI's job, and policy_names.spl
# must keep zero module-level state.
fn parse_lint_profile(profile_str: String) -> Option<LintProfile>:
    val lower = profile_str.lower()
    val canonical = normalize_profile_name(lower)
    if canonical == "":
        return nil
    # --- Deprecated aliases (pre-rename spellings); warn once, keep working ---
    val alias_target = deprecated_profile_alias_replacement(lower)
    if alias_target != "":
        _warn_deprecated_profile_alias_once(lower, alias_target)
    if canonical == "moderate":
        return Some(LintProfile.Moderate)
    if canonical == "strict":
        return Some(LintProfile.Strict)
    if canonical == "robust":
        return Some(LintProfile.Robust)
    if canonical == "critical" or canonical == "verified":
        # `verified` is an accepted canonical profile name with no LintProfile
        # variant of its own. Project it onto the strongest V1 rung, matching
        # policy_schema.from_name(); returning nil here made lint REJECT the
        # strictest profile on the ladder.
        #
        # (Merged 2026-08-17: the other lane fixed the same defect with a
        # separate `verified` branch below this one. Same verdict, so the
        # duplicate branch was unreachable; its rationale is kept here.)
        # `verified` adds FV2 receipt closure above critical; lint is its
        # engineering-restriction projection and must therefore deny exactly as
        # critical rather than reject or weaken the profile.
        return Some(LintProfile.Critical)
    nil

# All configurable lint names.
fn all_lint_names() -> [text]:
    ["primitive_api", "bare_bool", "simple_script_required", "print_in_test_spec", "todo_format",
     "spipe_no_print_based_tests", "spipe_missing_docstrings",
     "spipe_minimal_docstrings", "spipe_manual_assertions",
     "spipe_placeholder_tests", "spipe_empty_examples",
     "spipe_boolean_wrapper_assertions", "spipe_false_boolean_wrapper_assertions",
     "unnamed_duplicate_typed_args", "resource_leak",
     "wildcard_match", "non_exhaustive_match",
     "export_outside_init", "init_boundary_violation",
     "bypass_with_code_files", "unknown_annotation", "unknown_decorator", "stub_impl",
     "unknown_attribute", "too_many_arguments", "dummy_accessor",
     "parser_contextual_keyword", "deprecated_if_let",
     "struct_construction_parens", "short_grammar_refactor",
     "raw_unit_postfix", "simd_opportunity",
     "similar_parent_method_name",
     "required_comment",
     "ui_no_raw_widget_kind", "ui_no_raw_variant", "ui_no_raw_theme_name",
     "stale_md_diagrams", "hash_bracket_attribute", "llvm_backend_type_safety",
     # Newly-configurable families (previously unmapped — see
     # map_lint_code_to_config_name). Default warn (regression-safe).
     "unused_code", "style_convention", "unsafe_pattern", "concurrency_misuse",
     "closure_capture", "ignored_return", "multiline_bool", "memory_safety",
     "collection_performance",
     "visibility_boundary", "database_integrity", "tracking_traceability",
     # Freestanding/kernel-risk entry-closure codegen defect avoidance
     # (C1/C4/C5/C7) — scoped to src/os/** and examples/09_embedded/**.
     "freestanding_enum_eq", "freestanding_anon_tuple_return",
     "freestanding_bare_conversion", "freestanding_global_call_init",
     "module_init_literal", "raw_rt_access",
     # Const-by-default references (W-MC-REF-001) — warn in ALL tiers
     # including robust; deny escalation is a later profile-v2 change.
     "const_ref_default",
     # Bare-primitive internal bindings (W-MC-VAL-001, REQ-MC-011) — allow by
     # default (would flood non-MC code); warn under the critical tier.
     "bare_primitive_internal",
     # Unwrapped foreign resource escape (W-MC-RES-001, REQ-MC-023) — allow
     # by default (would flood non-MC FFI glue); warn under the critical
     # tier. Deny at profile v2 (deliberately not implemented here).
     "unwrapped_foreign_resource",
     "raw_sffi_call",
     # Silent-default / fail-open (W-MC-DEF-001/002/003) — WARN by default so
     # existing code keeps compiling. PROMOTION TO A HARD ERROR IS THE ONE-LINE
     # CHANGE `levels["silent_default"] = "deny"` below, and nothing else.
     "silent_default",
     # WM/GUI/web/2D portable-lane dependency boundary (WML001/WML002) — allow
     # by default because it walks every import line; --wm-lane or --warn-all
     # turns it on. See wm_lane_boundary_lints.spl.
     "wm_lane_boundary"]

# Allocation-free membership for config and attribute parsing. Keep enumeration
# in `all_lint_names`; hot membership must not rebuild and scan that array for
# every authored lint name.
fn lint_name_is_known(name: text) -> bool:
    match name:
        case "primitive_api" | "bare_bool" | "simple_script_required" |
             "print_in_test_spec" | "todo_format" |
             "spipe_no_print_based_tests" | "spipe_missing_docstrings" |
             "spipe_minimal_docstrings" | "spipe_manual_assertions" |
             "spipe_placeholder_tests" | "spipe_empty_examples" |
             "spipe_boolean_wrapper_assertions" |
             "spipe_false_boolean_wrapper_assertions" |
             "unnamed_duplicate_typed_args" | "resource_leak" |
             "wildcard_match" | "non_exhaustive_match" |
             "export_outside_init" | "init_boundary_violation" |
             "bypass_with_code_files" | "unknown_annotation" |
             "unknown_decorator" | "stub_impl" |
             "unknown_attribute" | "too_many_arguments" | "dummy_accessor" |
             "parser_contextual_keyword" | "deprecated_if_let" |
             "struct_construction_parens" | "short_grammar_refactor" |
             "raw_unit_postfix" | "simd_opportunity" |
             "similar_parent_method_name" | "required_comment" |
             "ui_no_raw_widget_kind" | "ui_no_raw_variant" |
             "ui_no_raw_theme_name" | "stale_md_diagrams" |
             "hash_bracket_attribute" | "llvm_backend_type_safety" |
             "unused_code" | "style_convention" | "unsafe_pattern" |
             "concurrency_misuse" | "closure_capture" | "ignored_return" |
             "multiline_bool" | "memory_safety" | "collection_performance" |
             "visibility_boundary" | "database_integrity" |
             "tracking_traceability" | "freestanding_enum_eq" |
             "freestanding_anon_tuple_return" |
             "freestanding_bare_conversion" |
             "freestanding_global_call_init" | "module_init_literal" |
             "raw_rt_access" | "const_ref_default" |
             "bare_primitive_internal" | "unwrapped_foreign_resource" |
             "raw_sffi_call" | "silent_default" | "wm_lane_boundary": true
        case _: false

# Build the default levels dict for all configurable lint names.
# Most are Warn; exceptions: spipe_no_print_based_tests=Deny,
# spipe_placeholder_tests=Deny, spipe_empty_examples=Deny,
# export_outside_init=Deny,
# stub_impl=Deny, wildcard_match=Allow, style_convention=Allow.
fn build_default_levels() -> Dict<String, String>:
    var levels: Dict<String, String> = {}
    levels["primitive_api"] = "deny"
    levels["bare_bool"] = "warn"
    levels["simple_script_required"] = "warn"
    levels["print_in_test_spec"] = "warn"
    levels["todo_format"] = "warn"
    levels["spipe_no_print_based_tests"] = "deny"
    levels["spipe_missing_docstrings"] = "warn"
    levels["spipe_minimal_docstrings"] = "warn"
    levels["spipe_manual_assertions"] = "warn"
    levels["spipe_placeholder_tests"] = "deny"
    levels["spipe_empty_examples"] = "deny"
    levels["spipe_boolean_wrapper_assertions"] = "warn"
    levels["spipe_false_boolean_wrapper_assertions"] = "warn"
    levels["unnamed_duplicate_typed_args"] = "warn"
    levels["resource_leak"] = "warn"
    levels["wildcard_match"] = "allow"
    levels["non_exhaustive_match"] = "warn"
    levels["export_outside_init"] = "deny"
    levels["init_boundary_violation"] = "warn"
    levels["bypass_with_code_files"] = "warn"
    levels["unknown_annotation"] = "warn"
    levels["unknown_decorator"] = "warn"
    levels["stub_impl"] = "deny"
    levels["unknown_attribute"] = "warn"
    levels["parser_contextual_keyword"] = "warn"
    levels["deprecated_if_let"] = "warn"
    levels["struct_construction_parens"] = "warn"
    levels["short_grammar_refactor"] = "warn"
    levels["raw_unit_postfix"] = "warn"
    levels["simd_opportunity"] = "warn"
    levels["too_many_arguments"] = "warn"
    levels["dummy_accessor"] = "warn"
    levels["similar_parent_method_name"] = "warn"
    levels["required_comment"] = "warn"
    levels["ui_no_raw_widget_kind"] = "warn"
    levels["ui_no_raw_variant"] = "warn"
    levels["ui_no_raw_theme_name"] = "warn"
    levels["stale_md_diagrams"] = "warn"
    levels["llvm_backend_type_safety"] = "deny"
    levels["hash_bracket_attribute"] = "warn"
    # Newly-configurable families. Preserve the original suppression level for
    # style diagnostics until --warn-all or an explicit config promotes them.
    levels["unused_code"] = "warn"
    levels["style_convention"] = "allow"
    levels["unsafe_pattern"] = "warn"
    levels["concurrency_misuse"] = "warn"
    levels["closure_capture"] = "warn"
    levels["ignored_return"] = "warn"
    levels["multiline_bool"] = "warn"
    levels["memory_safety"] = "warn"
    # Stable policy owner for COLL001-COLL019 and future typed CollectionPlan
    # diagnostics. Moderate/strict report warnings; robust/critical may deny
    # typed high-confidence defects. The AST fallback caps itself at warning.
    levels["collection_performance"] = "warn"
    levels["visibility_boundary"] = "warn"
    levels["database_integrity"] = "warn"
    levels["tracking_traceability"] = "warn"
    levels["freestanding_enum_eq"] = "warn"
    levels["freestanding_anon_tuple_return"] = "warn"
    levels["freestanding_bare_conversion"] = "warn"
    levels["freestanding_global_call_init"] = "warn"
    levels["module_init_literal"] = "warn"
    levels["raw_rt_access"] = "warn"
    levels["const_ref_default"] = "warn"
    levels["bare_primitive_internal"] = "allow"
    levels["unwrapped_foreign_resource"] = "allow"
    levels["raw_sffi_call"] = "allow"
    # ===== SILENT-DEFAULT ESCALATION POINT =====
    # "warn" today: existing code must keep compiling ("at least warning now,
    # latter bug when sw stable for compatibility"). Change this single line to
    #     levels["silent_default"] = "deny"
    # to make the W-MC-DEF-00x family a hard error. Prerequisite:
    # `sh scripts/check/check-silent-default-baseline.shs` must report a
    # baseline of 0. Nothing in silent_default.spl changes.
    levels["silent_default"] = "warn"
    # DEFAULT OFF. wm_lane_boundary walks every module-level `use` line of every
    # file in the portable WM/GUI/web/2D lane, which costs real time, so it is
    # opt-in only: `--wm-lane`, `--warn-all`, or an explicit simple.sdn
    # [lints] entry. It must never run in a normal build — and cannot, since
    # compiler/90.tools/lint is not on the compile/build driver's import path.
    levels["wm_lane_boundary"] = "allow"
    levels

# Per-tier default levels, layered on top of build_default_levels().
#   Strict   = current defaults (regression-safe baseline); formerly `Lib`
#   Moderate = advisory: every "deny" default downgraded to "warn"
#   Robust   = strict: public-surface + safety/correctness lints elevated to
#              "deny"; formerly `Reliable`
#   Critical = Robust + REQ-MC rules; formerly `MissionCritical`
fn profile_default_levels(profile: LintProfile) -> Dict<String, String>:
    val levels = build_default_levels()
    match profile:
        case Strict:
            return levels
        case Moderate:
            var out: Dict<String, String> = {}
            for key in levels.keys():
                if levels[key] == "deny":
                    out[key] = "warn"
                else:
                    out[key] = levels[key]
            return out
        case Robust:
            return _strict_robust_levels(levels)
        case Critical:
            # Critical = robust strictness PLUS the REQ-MC-011
            # bare-primitive-internal rule and the REQ-MC-023
            # unwrapped-foreign-resource rule at warn (deny at profile v2).
            # const_ref_default keeps its existing default level.
            var mc = _strict_robust_levels(levels)
            mc["bare_primitive_internal"] = "warn"
            mc["unwrapped_foreign_resource"] = "warn"
            return mc
    levels

# Robust-tier elevation, shared by Robust and Critical.
fn _strict_robust_levels(levels: Dict<String, String>) -> Dict<String, String>:
    var strict = levels
    strict["primitive_api"] = "deny"
    strict["unsafe_pattern"] = "deny"
    strict["raw_sffi_call"] = "deny"
    strict["memory_safety"] = "deny"
    strict["collection_performance"] = "deny"
    strict["concurrency_misuse"] = "deny"
    strict["visibility_boundary"] = "deny"
    strict["non_exhaustive_match"] = "deny"
    strict["resource_leak"] = "deny"
    strict["init_boundary_violation"] = "deny"
    strict

# --- Engine-default axis (REQ-MC-012 priority tier 3) -----------------------
# Profile resolution priority (highest first): explicit --profile= CLI flag
# > simple.sdn lints.profile > engine default. The first two tiers are
# wired at the CLI/sdn-loader call sites (see resolve_lint_config below and
# entry_and_fixes.spl); this is the third tier's pure resolution logic,
# parameterized on which engine is asking. Actual --engine=interpreter|jit|
# native CLI plumbing is a separate lane (REQ-MC-012, not implemented here) —
# this only computes what that plumbing should fall back to once wired.
enum LintEngineDefault:
    InterpreterOrJit
    CompilerLoader

# interpreter/JIT -> moderate (today's behavior, unchanged).
# compiler/loader (native build + module loading) -> robust: the full
# Rust-parity rule set is active, at WARN severity during the migration
# window (see engine_default_levels — escalation to deny is a later change).
fn engine_default_profile(engine: LintEngineDefault) -> LintProfile:
    match engine:
        case InterpreterOrJit:
            return LintProfile.Moderate
        case CompilerLoader:
            return LintProfile.Robust

# Effective default levels dict for the engine axis. compiler/loader gets
# robust's full rule set with every "deny" downgraded to "warn" — a
# deliberate migration window; escalating those warnings to errors is a
# LATER change, explicitly not this lane. interpreter/JIT gets moderate's
# dict unchanged.
fn engine_default_levels(engine: LintEngineDefault) -> Dict<String, String>:
    val levels = profile_default_levels(engine_default_profile(engine))
    match engine:
        case CompilerLoader:
            return _cap_at_warn(levels)
        case InterpreterOrJit:
            return levels

# Downgrade every "deny" entry to "warn"; leave "allow"/"warn" untouched.
fn _cap_at_warn(levels: Dict<String, String>) -> Dict<String, String>:
    var capped: Dict<String, String> = {}
    for key in levels.keys():
        if levels[key] == "deny":
            capped[key] = "warn"
        else:
            capped[key] = levels[key]
    capped

# Parse a level string ("allow", "warn", "deny") into LintLevel.
# Returns nil for unknown strings.
fn parse_lint_level(level_str: String) -> Option<LintLevel>:
    val lower = level_str.lower()
    if lower == "allow":
        return Some(LintLevel.Allow)
    if lower == "warn":
        return Some(LintLevel.Warn)
    if lower == "deny":
        return Some(LintLevel.Deny)
    nil

# Immutable command policy parsed once by repository lint. Keeping positional
# targets out of the per-file hot path prevents N files from causing N scans of
# an N-sized argument array. Standalone compatibility wrappers may still build
# one policy for their single file.
class LintCliPolicy:
    deny_all: bool
    warn_all: bool
    json_output: bool
    fix_mode: bool
    fix_all: bool
    fix_dry_run: bool
    wm_lane: bool
    profile: Option<LintProfile>
    error: String

impl LintCliPolicy:
    static fn from_args(args: [text]) -> LintCliPolicy:
        var policy = LintCliPolicy(
            deny_all: false, warn_all: false, json_output: false,
            fix_mode: false, fix_all: false, fix_dry_run: false,
            wm_lane: false, profile: nil, error: "")
        var expect_profile = false
        for arg in args:
            if expect_profile:
                val parsed = parse_lint_profile(arg)
                match parsed:
                    case Some(profile): policy.profile = Some(profile)
                    case nil: policy.error = "unknown profile: {arg}"
                expect_profile = false
            elif arg == "--deny-all": policy.deny_all = true
            elif arg == "--warn-all": policy.warn_all = true
            elif arg == "--json": policy.json_output = true
            elif arg == "--fix": policy.fix_mode = true
            elif arg == "--fix-all": policy.fix_all = true
            elif arg == "--fix-dry-run": policy.fix_dry_run = true
            elif arg == "--wm-lane": policy.wm_lane = true
            elif arg == "--profile": expect_profile = true
            elif arg.starts_with("--profile="):
                val profile_text = arg.slice(10, arg.len())
                val parsed = parse_lint_profile(profile_text)
                match parsed:
                    case Some(profile): policy.profile = Some(profile)
                    case nil: policy.error = "unknown profile: {profile_text}"
        if expect_profile and policy.error == "":
            policy.error = "--profile requires a tier"
        policy

# LintDiag configuration — overrides for lint levels.
# Loaded from the simple.sdn `lints:` section and/or file-level attributes.
class LintConfig:
    levels: Dict<String, String>
    # Immutable effective defaults for this selected profile. Built once when
    # the config/profile changes, never once per diagnostic lookup.
    effective_defaults: Dict<String, String>
    # Exact simple.sdn path from which this config was parsed; empty for
    # programmatic/inline configurations.
    source_path: String
    # Selected strictness tier; nil = unset (legacy build_default_levels behavior).
    profile: Option<LintProfile>
    error: String

    # Create a default config (all defaults, no overrides).
impl LintConfig:
    static fn new() -> LintConfig:
        LintConfig(
            levels: {}, effective_defaults: build_default_levels(),
            source_path: "", profile: nil, error: "")

    # Load config from an SDN file.  Parses the canonical `lints:` section.
    static fn from_sdn_file(path: String) -> LintConfig:
        if not file_exists(path):
            return LintConfig.new()
        val content = file_read(path)
        if content == "":
            return LintConfig.new()
        var config = LintConfig.from_sdn_string(content)
        config.source_path = path
        config

    # Parse config from an SDN string.
    #
    # Accepts the CANONICAL SDN indent/colon form only:
    #
    #     lints:
    #       profile: critical
    #       stub_impl: deny
    #
    # (documented at doc/06_spec/system/compiler/modules/tooling/formatting_lints.md
    # :345,:438). The former TOML-ish `[lints]` / `name = "level"` shape was
    # removed in WP-4 of the aerospace hardening plan: premise 4 of that plan
    # established that NO simple.sdn in the tree ever carried a `lints` key in
    # either shape, so there is no legacy form to stay compatible with.
    #
    # Hand-rolled rather than routed through std.common.sdn.parser or
    # ProjectContext.load_from_sdn: executing extra module init inside
    # lint-main's graph is the documented trigger of
    # doc/08_tracking/bug/interp_lint_main_then_frontend_dict_to_int_2026-07-28.md.
    # The typed loader (compiler.driver.project.ProjectContext.load_from_sdn)
    # does use the real parser and is the canonical mapping; collapsing this
    # copy into it is WP-3's job, not WP-4's.
    static fn from_sdn_string(content: String) -> LintConfig:
        var config = LintConfig.new()
        var in_lints_section = false

        val lines = content.split("\n")
        for line in lines:
            val trimmed = line.trim()

            # Skip empty lines and comments
            if trimmed == "" or trimmed.starts_with("#"):
                continue

            val indented = line.starts_with(" ") or line.starts_with("\t")

            # `lints:` with no inline value opens the section.
            if not indented:
                in_lints_section = trimmed == "lints:"
                continue

            # Parse `name: level` entries nested under `lints:`
            if in_lints_section and trimmed.contains(":"):
                val sep = trimmed.index_of(":") ?? -1
                if sep > 0:
                    val lint_name = trimmed.substring(0, sep).trim()
                    var level_str = trimmed.substring(sep + 1).trim()
                    # Strip surrounding quotes
                    level_str = level_str.replace("\"", "")
                    level_str = level_str.replace("'", "")
                    level_str = level_str.trim()

                    # profile: <tier> selects the strictness tier (not a lint name).
                    # Handle it BEFORE the all_lint_names() gate or it is dropped.
                    if lint_name == "profile":
                        if parse_lint_profile(level_str).?:
                            config.set_profile_from_string(level_str)
                        else:
                            config.set_error_once("unknown profile: {level_str}")
                    # Validate the lint name is known
                    elif lint_name_is_known(lint_name):
                        match parse_lint_level(level_str):
                            case Some(level):
                                config.set_level(lint_name, level)
                            case nil:
                                config.set_error_once("invalid level for {lint_name}: {level_str}")
                    elif lint_name == "default_level":
                        # Section-wide default (formatting_lints.md:438). LintConfig
                        # has no default-level field yet; recognised so it is not
                        # reported as an unknown lint, but not yet honoured.
                        ()
                    else:
                        config.set_error_once("unknown lint: {lint_name}")

        config

    # Get the effective level for a lint name.
    # Checks overrides first, then falls back to built-in defaults.
    fn get_level(lint_name: String) -> LintLevel:
        var level_str = ""
        if self.levels.has(lint_name):
            level_str = self.levels[lint_name]
        else:
            if self.effective_defaults.has(lint_name):
                level_str = self.effective_defaults[lint_name]
            else:
                return LintLevel.Warn  # Unknown lint defaults to Warn

        val parsed = parse_lint_level(level_str)
        match parsed:
            case Some(level):
                return level
            case nil:
                return LintLevel.Warn

    # Select the strictness tier directly.
    me set_profile(profile: LintProfile):
        self.profile = Some(profile)
        self.effective_defaults = profile_default_levels(profile)

    me set_error_once(message: String):
        if self.error == "":
            self.error = message

    # Select the strictness tier from a string; unknown strings are ignored.
    me set_profile_from_string(profile_str: String):
        val parsed = parse_lint_profile(profile_str)
        match parsed:
            case Some(p):
                self.set_profile(p)
            case nil:
                val _ = 0

    # Set the level for a specific lint name.
    me set_level(lint_name: String, level: LintLevel):
        var value = "warn"
        match level:
            case Allow:
                value = "allow"
            case Warn:
                value = "warn"
            case Deny:
                value = "deny"
        self.levels[lint_name] = value
        if lint_name == "unknown_annotation":
            self.levels["unknown_decorator"] = value
            self.levels["unknown_attribute"] = value
        elif lint_name == "unknown_decorator" or lint_name == "unknown_attribute":
            self.levels["unknown_annotation"] = value

    # Apply file-level attribute overrides.
    # Scans the first N lines (before first definition) for:
    #   @allow(lint1, lint2)
    #   @warn(lint1, lint2)
    #   @deny(lint1, lint2)
    #   @allow(lint1)  (inner attribute)
    me apply_file_attributes(content: String):
        self.apply_file_attributes_lines(content.split("\n"))

    me apply_file_attributes_lines(lines: [String]):
        for line in lines:
            val trimmed = line.trim()

            # Stop scanning at the first definition (fn, class, enum, struct, trait, etc.)
            if trimmed.starts_with("fn ") or trimmed.starts_with("me ") or trimmed.starts_with("class ") or trimmed.starts_with("enum ") or trimmed.starts_with("struct ") or trimmed.starts_with("trait "):
                return

            # Also stop at module-level val/var assignments that aren't attributes
            # but continue past use/import and comments
            if trimmed.starts_with("val ") or trimmed.starts_with("var "):
                return

            # Match @allow(...), @warn(...), @deny(...)
            var attr_line = trimmed

            if not attr_line.starts_with("@"):
                continue

            # @lint_profile(<tier>) selects the strictness tier for this file.
            # Distinct from the R9 must-use `@profile(critical)` annotation.
            # Most-local-wins: a file attribute overrides the project sdn profile.
            if attr_line.starts_with("@lint_profile("):
                val close_prof = attr_line.find(")")
                if close_prof >= 14:
                    val prof_str = attr_line.slice(14, close_prof).trim()
                    self.set_profile_from_string(prof_str)
                continue

            # Parse @allow(...), @warn(...), @deny(...)
            var level_opt: Option<LintLevel> = nil
            var inner_start = 0

            if attr_line.starts_with("@allow("):
                level_opt = Some(LintLevel.Allow)
                inner_start = 7
            elif attr_line.starts_with("@warn("):
                level_opt = Some(LintLevel.Warn)
                inner_start = 6
            elif attr_line.starts_with("@deny("):
                level_opt = Some(LintLevel.Deny)
                inner_start = 6

            match level_opt:
                case nil:
                    continue
                case Some(level):
                    # Extract the content between parens
                    val close_paren = attr_line.find(")")
                    if close_paren < 0:
                        continue
                    val lint_list_str = attr_line.slice(inner_start, close_paren)
                    val lint_names = lint_list_str.split(",")
                    for name in lint_names:
                        val clean_name = name.trim()
                        if clean_name == "":
                            continue
                        # Handle meta-lint unknown_annotation
                        if clean_name == "unknown_annotation":
                            self.set_level("unknown_annotation", level)
                        elif lint_name_is_known(clean_name):
                            self.set_level(clean_name, level)

    # Create a child config that inherits all current settings.
    fn child() -> LintConfig:
        var new_levels: Dict<String, String> = {}
        val src_levels = self.levels
        if src_levels != nil:
            val src_keys = src_levels.keys()
            if src_keys != nil:
                for key in src_keys:
                    new_levels[key] = src_levels[key]
        LintConfig(
            levels: new_levels, effective_defaults: self.effective_defaults,
            source_path: self.source_path, profile: self.profile,
            error: self.error)

fn resolve_lint_config(base: LintConfig, path: String, content: String) -> LintConfig:
    resolve_lint_config_with_lines(base, path, content.split("\n"))

fn resolve_lint_config_with_lines(
    base: LintConfig, path: String, lines: [String]
) -> LintConfig:
    var config = base.child()
    config.apply_file_attributes_lines(lines)

    val sdn_path = find_project_sdn(path)
    if sdn_path != "" and sdn_path != base.source_path:
        val file_config = LintConfig.from_sdn_file(sdn_path)
        for key in file_config.levels.keys():
            if not config.levels.has(key):
                config.levels[key] = file_config.levels[key]
    config

# Check if a lint result should be suppressed based on config.
# Returns true if the result should be kept (not suppressed).
fn should_keep_lint_result(config: LintConfig, lint_code: String) -> Bool:
    # Map internal lint codes to config lint names where possible
    val config_name = map_lint_code_to_config_name(lint_code)
    if config_name == "":
        return true  # Unknown lint code — keep it
    val level = config.get_level(config_name)
    match level:
        case Allow:
            return false  # Suppressed
        case Warn:
            return true
        case Deny:
            return true

# Promote lint levels according to config without downgrading stricter diagnostics.
fn apply_config_level(config: LintConfig, lint_code: String, original_level: LintLevel) -> LintLevel:
    val config_name = map_lint_code_to_config_name(lint_code)
    if config_name == "":
        return original_level
    val config_level = config.get_level(config_name)
    match config_level:
        case Deny:
            return LintLevel.Deny
        case Allow:
            return original_level  # Suppression handled by should_keep_lint_result
        case Warn:
            if original_level == LintLevel.Allow:
                return LintLevel.Warn
            return original_level

# Map internal lint code (e.g. "T001") to config name (e.g. "todo_format").
# Returns "" for codes with no direct mapping.
fn map_lint_code_to_config_name(code: String) -> String:
    if code.starts_with("COLL"):
        return "collection_performance"
    match code:
        case "primitive_api" | "bare_bool" | "simple_script_required" |
             "print_in_test_spec" | "spipe_no_print_based_tests" |
             "spipe_missing_docstrings" | "spipe_minimal_docstrings" |
             "spipe_manual_assertions" | "unnamed_duplicate_typed_args" |
             "resource_leak" | "non_exhaustive_match" |
             "export_outside_init" | "init_boundary_violation" |
             "bypass_with_code_files" | "unknown_annotation" | "unknown_decorator" |
             "unknown_attribute" | "stub_impl": return code
        case "parser_contextual_keyword" | "deprecated_if_let" |
             "struct_construction_parens" | "raw_unit_postfix" |
             "simd_opportunity": return code
        case "short_grammar_method_ref" | "short_grammar_function_ref" |
             "short_grammar_placeholder" | "short_grammar_ignored_param":
            return "short_grammar_refactor"
        case _: pass
    if code == "T001" or code == "T002" or code == "T003" or code == "T004":
        return "todo_format"
    if code == "ARG001" or code == "ARG002":
        return "too_many_arguments"
    if code == "WML001" or code == "WML002":
        return "wm_lane_boundary"
    if code == "ACC001":
        return "dummy_accessor"
    if code == "NAME001":
        return "similar_parent_method_name"
    if code == "STUB001" or code == "STUB002" or code == "STUB003":
        return "stub_impl"
    if code == "SPIPE001" or code == "SPIPE002" or code == "SPIPE003":
        return "spipe_placeholder_tests"
    if code == "SPIPE004":
        return "spipe_no_print_based_tests"
    if code == "SPIPE005":
        return "spipe_empty_examples"
    if code == "SPIPE006":
        return "spipe_boolean_wrapper_assertions"
    if code == "SPIPE007":
        return "spipe_false_boolean_wrapper_assertions"
    if code == "I001" or code == "I002" or code == "I003":
        return "init_boundary_violation"
    if code == "D001":
        return "database_integrity"
    if code == "TRK001":
        return "tracking_traceability"
    if code == "W001" or code == "W002" or code == "W003":
        return "unused_code"  # unused variable/import/dead code
    if code == "ST001" or code == "ST002" or code == "ST003":
        return "style_convention"  # style lints
    if code == "C002":
        return "non_exhaustive_match"
    if (code == "MEXH001" or code == "MEXH002" or code == "MEXH003" or
        code == "MEXH004" or code == "MEXH005"):
        return "non_exhaustive_match"
    if code == "S001" or code == "S002" or code == "S003":
        return "unsafe_pattern"  # safety lints
    if code == "CC001" or code == "CC002":
        return "concurrency_misuse"  # concurrency lints
    if code == "CLOS001":
        return "closure_capture"
    if code == "RET001":
        return "ignored_return"
    if code == "BOOL001":
        return "multiline_bool"
    if code == "REQC001" or code == "REQC002" or code == "REQC003" or code == "REQC004":
        return "required_comment"
    if code == "SAFE001" or code == "SAFE003":
        return "memory_safety"  # safety
    if (code == "W0401" or code == "W0402" or code == "W0403" or
        code == "W0404" or code == "W0406"):
        return "visibility_boundary"  # visibility
    if code == "UI001":
        return "ui_no_raw_widget_kind"
    if code == "UI002":
        return "ui_no_raw_variant"
    if code == "UI003":
        return "ui_no_raw_theme_name"
    if code == "DIAG001":
        return "stale_md_diagrams"
    if code == "LLVM001":
        return "llvm_backend_type_safety"
    if code == "FSK001":
        return "freestanding_enum_eq"
    if code == "FSK002":
        return "freestanding_anon_tuple_return"
    if code == "FSK003":
        return "freestanding_bare_conversion"
    if code == "FSK004":
        return "freestanding_global_call_init"
    if code == "MODINIT001":
        return "module_init_literal"
    if code == "RAW-RT-001" or code == "RAW-RT-002" or code == "RAW-RT-003":
        return "raw_rt_access"
    if code == "W-MC-REF-001":
        return "const_ref_default"
    if code == "W-MC-VAL-001":
        return "bare_primitive_internal"
    if code == "W-MC-RES-001":
        return "unwrapped_foreign_resource"
    if code == "SFFI009" or code == "SFFI010":
        return "raw_sffi_call"
    if code == "W-MC-DEF-001" or code == "W-MC-DEF-002" or code == "W-MC-DEF-003":
        return "silent_default"
    ""

# Try to find simple.sdn by walking up from a file path.
fn find_project_sdn(file_path: String) -> String:
    # Try to find simple.sdn in parent directories
    var dir = get_parent_directory(file_path)
    var depth = 0
    while depth < 10:
        val candidate = "{dir}/simple.sdn"
        if file_exists(candidate):
            return candidate
        val parent = get_parent_directory(dir)
        if parent == dir:
            return ""  # Reached root
        dir = parent
        depth = depth + 1
    ""

# Lint categories are imported from std.tooling.easy_fix.types (see line 19).
# A second local `enum LintCategory` used to be declared here, colliding with
# that import at the same terminal name -- the same defect already fixed for
# LintLevel. The two declarations had byte-identical variant sets, so the local
# one was pure duplication. (Merged 2026-08-17: the other lane still carried
# the local enum; kept the removal, since the import at line 19 supplies the
# same five variants.)

enum LintEvidenceTier:
    LegacyCompatible
    SourcePattern
    ParsedStructural
    TypedProven
    Incomplete

fn lint_evidence_tier_name(tier: LintEvidenceTier) -> text:
    match tier:
        case LegacyCompatible: "legacy-compatible"
        case SourcePattern: "source-pattern"
        case ParsedStructural: "parsed-structural"
        case TypedProven: "typed-proven"
        case Incomplete: "incomplete"

class LintDiag:
    code: String
    level: LintLevel
    category: LintCategory
    message: String
    fix_hint: Option<String>
    easy_fix: Option<EasyFix>
    evidence: [String]
    uncertainty: Option<String>
    evidence_tier: LintEvidenceTier

impl LintDiag:
    fn new(code: String, level: LintLevel, category: LintCategory, message: String) -> LintDiag:
        LintDiag(
            code: code,
            level: level,
            category: category,
            message: message,
            fix_hint: nil,
            easy_fix: nil,
            evidence: [],
            uncertainty: nil,
            evidence_tier: LintEvidenceTier.LegacyCompatible
        )

    fn with_fix(hint: String) -> LintDiag:
        LintDiag(
            code: self.code,
            level: self.level,
            category: self.category,
            message: self.message,
            fix_hint: Some(hint),
            easy_fix: self.easy_fix,
            evidence: self.evidence,
            uncertainty: self.uncertainty,
            evidence_tier: self.evidence_tier
        )

    fn with_easy_fix(fix: EasyFix) -> LintDiag:
        LintDiag(
            code: self.code,
            level: self.level,
            category: self.category,
            message: self.message,
            fix_hint: self.fix_hint,
            easy_fix: Some(fix),
            evidence: self.evidence,
            uncertainty: self.uncertainty,
            evidence_tier: self.evidence_tier
        )

    fn with_evidence(evidence: [String]) -> LintDiag:
        LintDiag(
            code: self.code, level: self.level, category: self.category,
            message: self.message, fix_hint: self.fix_hint,
            easy_fix: self.easy_fix, evidence: evidence,
            uncertainty: self.uncertainty,
            evidence_tier: self.evidence_tier
        )

    fn with_uncertainty(reason: String) -> LintDiag:
        LintDiag(
            code: self.code, level: self.level, category: self.category,
            message: self.message, fix_hint: self.fix_hint,
            easy_fix: self.easy_fix, evidence: self.evidence,
            uncertainty: Some(reason), evidence_tier: self.evidence_tier
        )

    fn with_evidence_tier(tier: LintEvidenceTier) -> LintDiag:
        LintDiag(
            code: self.code, level: self.level, category: self.category,
            message: self.message, fix_hint: self.fix_hint,
            easy_fix: self.easy_fix, evidence: self.evidence,
            uncertainty: self.uncertainty, evidence_tier: tier
        )

    fn with_level(level: LintLevel) -> LintDiag:
        LintDiag(
            code: self.code, level: level, category: self.category,
            message: self.message, fix_hint: self.fix_hint,
            easy_fix: self.easy_fix, evidence: self.evidence,
            uncertainty: self.uncertainty, evidence_tier: self.evidence_tier
        )

fn lint_code_is_performance(code: text) -> bool:
    code.starts_with("COLL") or code.starts_with("LOOP") or
    code.starts_with("MEM") or code.starts_with("COPY") or
    code.starts_with("LAYOUT") or code.starts_with("ALLOC") or
    code.starts_with("ESCAPE") or code.starts_with("RETENTION") or
    code.starts_with("CACHE") or code.starts_with("STACK")

fn lint_evidence_tier_is_unproven(tier: LintEvidenceTier) -> bool:
    match tier:
        case SourcePattern | ParsedStructural | Incomplete: true
        case LegacyCompatible | TypedProven: false

fn lint_diag_is_unproven_performance_advisory(lint: LintDiag) -> bool:
    lint_code_is_performance(lint.code) and
        lint_evidence_tier_is_unproven(lint.evidence_tier)

fn apply_config_level_for_evidence(
    config: LintConfig, code: String, default_level: LintLevel,
    evidence_tier: LintEvidenceTier
) -> LintLevel:
    val configured = apply_config_level(config, code, default_level)
    if configured == LintLevel.Deny and lint_code_is_performance(code) and
       lint_evidence_tier_is_unproven(evidence_tier):
        return LintLevel.Warn
    configured

struct LintPolicyDecision:
    keep: bool
    level: LintLevel

fn lint_policy_decision(
    config: LintConfig, code: String, default_level: LintLevel,
    evidence_tier: LintEvidenceTier
) -> LintPolicyDecision:
    """Resolve suppression and severity with one code map and level lookup."""
    val config_name = map_lint_code_to_config_name(code)
    if config_name == "":
        return LintPolicyDecision(true, default_level)
    val configured = config.get_level(config_name)
    match configured:
        case Allow:
            return LintPolicyDecision(false, default_level)
        case Deny:
            if lint_code_is_performance(code) and
               lint_evidence_tier_is_unproven(evidence_tier):
                return LintPolicyDecision(true, LintLevel.Warn)
            return LintPolicyDecision(true, LintLevel.Deny)
        case Warn:
            if default_level == LintLevel.Allow:
                return LintPolicyDecision(true, LintLevel.Warn)
            return LintPolicyDecision(true, default_level)

fn lint_diag_effective_level(lint: LintDiag, deny_all: bool) -> LintLevel:
    if lint.level != LintLevel.Warn or not deny_all:
        return lint.level
    # `--deny-all` is not evidence. Source-shape performance guesses remain
    # advisory until a producer explicitly supplies typed-proven receiver,
    # effect, alias, and cardinality facts. Missing uncertainty text alone is
    # never interpreted as proof.
    if lint_diag_is_unproven_performance_advisory(lint):
        return LintLevel.Warn
    LintLevel.Deny

class LintRunResult:
    file_path: String
    line: Int
    column: Int
    lint: LintDiag

impl LintRunResult:
    fn new(file_path: String, line: Int, column: Int, lint: LintDiag) -> LintRunResult:
        LintRunResult(
            file_path: file_path,
            line: line,
            column: column,
            lint: lint
        )

    fn format() -> String:
        var level_str = "unknown"
        match self.lint.level:
            case Allow:
                level_str = "allow"
            case Warn:
                level_str = "warning"
            case Deny:
                level_str = "error"

        var output = self.file_path + ":" + self.line.to_string() + ":" + self.column.to_string() + ": " + level_str + "[" + self.lint.code + "]: " + self.lint.message

        match self.lint.fix_hint:
            case Some(hint):
                output = output + "\n" + "  hint: " + hint
            case nil:
                val _ = 0

        match self.lint.easy_fix:
            case Some(fix):
                output = output + "\n" + "  fix: available [{fix.id}] ({fix.confidence_str()})"
            case nil:
                val _ = 0

        for evidence_line in self.lint.evidence:
            output = output + "\n  evidence: " + evidence_line

        if self.lint.evidence_tier != LintEvidenceTier.LegacyCompatible:
            output = output + "\n  confidence: " + lint_evidence_tier_name(self.lint.evidence_tier)

        match self.lint.uncertainty:
            case Some(reason):
                output = output + "\n  uncertainty: " + reason
            case nil:
                val _ = 0

        return output

    fn has_easy_fix() -> Bool:
        self.lint.easy_fix.? == true

fn lint_run_result_apply_cli_policy(result: LintRunResult, deny_all: bool) -> LintRunResult:
    LintRunResult.new(
        result.file_path, result.line, result.column,
        result.lint.with_level(lint_diag_effective_level(result.lint, deny_all)))

enum LintFileResult:
    LintFileOk([LintRunResult])
    LintFileErr(String)

# Valid TODO areas and priorities
fn _todo_areas() -> [text]:
    ["runtime", "codegen", "compiler", "parser", "type",
     "stdlib", "gpu", "ui", "test", "driver", "loader", "pkg", "sdn"]

fn _todo_priorities() -> [text]:
    ["P0", "P1", "P2", "P3", "critical", "high", "medium", "low"]

class Linter:
    lints: [LintDiag]
    results: [LintRunResult]
    config: LintConfig
    last_resolved_path: String
    last_resolved_config: LintConfig?
    retain_combined_view: bool
    last_source_view_valid: bool
    last_source_lines: [String]
    # Command-scoped parsed-policy cache. An index plus flat storage avoids
    # struct-valued dictionary retrieval and remains explicitly bounded.
    parsed_sdn_index: Dict<String, i64>
    parsed_sdn_configs: [LintConfig]
    parsed_sdn_count: i64
    manifest_free_config: LintConfig
    critical_dynamic_acquire_loaded: bool
    critical_dynamic_acquire_mode: String
    manifest_dir_cache: Dict<String, String>
    manifest_dir_cache_count: i64
    prepared_config_path: String

fn linter_find_project_sdn(linter: Linter, file_path: String) -> String:
    """Resolve one source's project manifest with a bounded command cache."""
    val source_directory = get_parent_directory(file_path)
    var directory = source_directory
    var depth = 0
    while depth < 10:
        if linter.manifest_dir_cache.contains_key(directory):
            val resolved = linter.manifest_dir_cache[directory]
            linter_cache_manifest_dir(linter, source_directory, resolved)
            return resolved
        val candidate = "{directory}/simple.sdn"
        if file_exists(candidate):
            linter_cache_manifest_dir(linter, directory, candidate)
            linter_cache_manifest_dir(linter, source_directory, candidate)
            return candidate
        val parent = get_parent_directory(directory)
        if parent == directory:
            linter_cache_manifest_dir(linter, source_directory, "")
            return ""
        directory = parent
        depth = depth + 1
    linter_cache_manifest_dir(linter, source_directory, "")
    ""

fn linter_cache_manifest_dir(
    linter: Linter, directory: String, resolved: String
):
    if linter.manifest_dir_cache.contains_key(directory):
        return
    # Bound command memory for generated trees with many distinct directories.
    if linter.manifest_dir_cache_count < 4096:
        linter.manifest_dir_cache[directory] = resolved
        linter.manifest_dir_cache_count = linter.manifest_dir_cache_count + 1

fn resolve_prepared_lint_config_with_lines(
    base: LintConfig, lines: [String]
) -> LintConfig:
    """Apply file attributes when manifest discovery already belongs to caller."""
    var config = base.child()
    config.apply_file_attributes_lines(lines)
    config
