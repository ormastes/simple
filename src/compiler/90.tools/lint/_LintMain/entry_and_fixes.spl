# Linter lint_main() entry and easy-fix collection/application.
# Renamed from `main` 2026-08-01: a library facade re-exporting a CLI `main`
# is an API smell, and matches the confirmed trigger shape for the
# test-runner's phantom file-level-failure defect (a wildcard-resolved import
# chain reaching a module that declares a top-level `fn main`). See
# doc/08_tracking/bug/test_runner_wildcard_imported_main_phantom_failure_2026-08-01.md.
use compiler.tools.lint.main.*
# Simple Language Linter
# Semantic lints for code quality and safety
# Usage: simple_lint <file.spl> [--deny-all] [--warn-all]

# I/O imports
use std.nogc_sync_mut.io.file_ops (file_read, file_exists, file_atomic_write)
use std.nogc_sync_mut.io.dir_ops (is_dir)
use app.io.cli_ops (get_args)

# Logging imports
use std.log.{error, info}

# Import EasyFix data types from stdlib
use std.tooling.easy_fix.*
use common.text.{escape_json}
use std.common.crypto.sha256.{sha256_text}
use compiler.semantics.lint.riscv_rtl_debuggability_lint.{lint_riscv_rtl_debuggability}
use compiler.core.ast.{module_get_decls}
use compiler.core.ast_expr.{ast_generation}
use compiler.core.parser.{parse_module_silent_checked, parser_has_errors, parser_set_had_error, parser_first_error_get}
use compiler.semantics.lint.argument_count.{check_argument_count}
use compiler.semantics.lint.collection_patterns.{check_collection_patterns}
use compiler.semantics.lint.star_import.{check_star_export_file}
use compiler.semantics.lint.stub_impl.{check_stub_impl}
use compiler.semantics.lint.wide_public.{check_wide_public_file}
use compiler.semantics.lint.option_me_call.{check_option_me_call_source}
use compiler.semantics.lint.required_comment.{check_required_comment, required_comment_source_may_match}

# File I/O wrapper

# Project the resolved `LintProfile` onto the assurance-policy name text that
# `compiler.common.assurance.policy.strictness_for_profile_name` (the WP-3
# canonical resolver) understands, for callers — e.g. check_stub_impl (WP-8)
# — that take a profile NAME rather than the lint-local enum. `nil` (no
# profile configured) maps to "", the resolver's own permissive default.
fn _lint_profile_to_assurance_name(profile: Option<LintProfile>) -> text:
    match profile:
        case Some(p):
            match p:
                case Critical:
                    return "critical"
                case Robust:
                    return "robust"
                case Strict:
                    return "strict"
                case Moderate:
                    return "moderate"
        case nil:
            return ""
    ""

fn lint_cli_source(linter: Linter, path: String, content: String) -> [LintRunResult]:
    var results = linter.lint_source_for_parsed_append(path, content)
    if not path.ends_with(".spl"):
        linter.release_combined_lint_view()
        return results

    val previous_parse_error = parser_has_errors()
    # Must use the *_checked form: `parse_module_silent` + `parser_has_errors()`
    # reads back a module-level flag that does not survive the return across the
    # module boundary, which made this gate fail open — lint reported
    # `all files clean` on files the compiler rejects outright. See
    # doc/08_tracking/bug/lint_does_not_detect_syntax_errors_2026-07-28.md.
    val parse_failed = parse_module_silent_checked(content, path)
    parser_set_had_error(previous_parse_error)
    if parse_failed:
        # NOT LINTED, not "one error". Every AST-based lint below this point
        # (ARG*, COLL*, STUB*, W0406 export, wide-public, riscv-rtl) is skipped
        # for this file, so a file that trips this gate has been *analysed less*
        # than a clean file, not more. Wording it as a plain parse error made
        # such files read as "checked, one problem" when in fact nothing was
        # checked — see
        # doc/08_tracking/bug/lint_parse_failure_silently_skips_file_2026-08-01.md.
        # Report WHERE and WHY as well. PARSE001 was emitted at a hardcoded
        # <file>:1:0 with no location and no reason, so a repo-wide census
        # could count parse failures but never break them down by shape. The
        # parser now mirrors its first error out across the module boundary
        # (parser.parser_first_error_get). The NOT LINTED wording above is
        # unchanged and is still the head of the message; the reason is
        # appended. Falls back to 1:0 with no suffix when the parser recorded
        # nothing, so this can never be weaker than before.
        var parse_line = 1
        var parse_col = 0
        var parse_message = "NOT LINTED: source did not parse - every AST-based lint was skipped for this file"
        val first_error = parser_first_error_get()
        if first_error != "":
            val head_sep = first_error.find(":")
            if head_sep > 0:
                val rest = first_error[head_sep + 1:]
                val col_sep = rest.find(":")
                if col_sep > 0:
                    # Explicit 0-based lower bound: the bare `[:idx]` form has
                    # a history of lexing as a symbol literal here.
                    val line_text = first_error[0:head_sep]
                    val col_text = rest[0:col_sep]
                    val parsed_line = line_text.to_i64()
                    val parsed_col = col_text.to_i64()
                    val reason = rest[col_sep + 1:]
                    if parsed_line > 0:
                        parse_line = parsed_line
                    if parsed_col > 0:
                        parse_col = parsed_col
                    if reason != "":
                        parse_message = "{parse_message} ({reason})"
        val lint = LintDiag.new("PARSE001", LintLevel.Deny, LintCategory.Correctness, parse_message)
        results.push(LintRunResult.new(path, parse_line, parse_col, lint))
        linter.release_combined_lint_view()
        return results

    lint_cli_append_parsed_results(linter, path, content, module_get_decls(), results)

struct LintParsedRevision:
    path: text
    source_digest: text
    arena_generation: i64
    decls: [i64]

fn lint_parsed_revision(path: text, content: text, decls: [i64]) -> LintParsedRevision:
    LintParsedRevision(path, sha256_text(content), ast_generation(), decls)

fn lint_cli_source_with_parsed_revision(
    linter: Linter, path: String, content: String, revision: LintParsedRevision
) -> [LintRunResult]:
    """Lint using declarations owned by an already-parsed compiler revision.

    This entrypoint never invokes or resets the parser/AST arena. Revision
    identity is checked before declaration indices are consumed.
    """
    var results = linter.lint_source_for_parsed_append(path, content)
    if not path.ends_with(".spl"):
        linter.release_combined_lint_view()
        return results
    if revision.path != path or revision.source_digest != sha256_text(content)
        or revision.arena_generation != ast_generation():
        val lint = LintDiag.new(
            "LINTREV001", LintLevel.Deny, LintCategory.Correctness,
            "NOT LINTED: parsed revision does not match source path, digest, and AST generation")
        results.push(LintRunResult.new(path, 1, 0, lint))
        linter.release_combined_lint_view()
        return results
    lint_cli_append_parsed_results(linter, path, content, revision.decls, results)

fn lint_cli_append_parsed_results(
    linter: Linter, path: String, content: String, decls: [i64],
    initial_results: [LintRunResult]
) -> [LintRunResult]:
    var results = initial_results
    # `lint_source` immediately precedes this append and retains its exact
    # resolved config. Reuse it instead of rediscovering/rereading simple.sdn.
    val config = if linter.last_resolved_path == path and linter.last_resolved_config.?:
        linter.last_resolved_config.unwrap()
    else:
        resolve_lint_config(linter.config, path, content)
    val source_locations = if linter.last_resolved_path == path
        and linter.last_source_locations_valid:
        LintSourceLocationIndex(
            linter.last_source_function_lines,
            linter.last_source_collection_fix_lines,
            linter.last_source_export_star_lines)
    else:
        lint_source_location_index(content.split("\n"))
    # Config and compact locations are now materialized. Release command-view
    # state before the AST rule loops so no prior-file dictionaries survive
    # diagnostic production; the tail release remains deliberately idempotent.
    linter.release_combined_lint_view()
    val stub_profile_name = _lint_profile_to_assurance_name(config.profile)
    for warning in check_argument_count(decls):
        val base_level = if warning.code == "ARG002": LintLevel.Deny else: LintLevel.Warn
        val policy = lint_policy_decision(
            config, warning.code, base_level, LintEvidenceTier.ParsedStructural)
        if not policy.keep: continue
        # This producer is the AST compatibility fallback. A deny policy is
        # reserved for typed, high-confidence evidence; never turn unresolved
        # receiver/effect/alias facts into a build error.
        val level = if policy.level == LintLevel.Deny: LintLevel.Warn else: policy.level
        val lint = LintDiag.new(warning.code, level, LintCategory.Style, warning.message)
            .with_fix(warning.hint)
        results.push(LintRunResult.new(path, warning.line, 0, lint))
    for warning in check_collection_patterns(decls):
        # This is the AST compatibility fallback.  Robust/critical deny policy
        # is reserved for typed, high-confidence evidence; unresolved receiver,
        # effect, alias, and mutation facts must never become a build error.
        val base_level = LintLevel.Warn
        val policy = lint_policy_decision(
            config, warning.code, base_level, LintEvidenceTier.SourcePattern)
        if not policy.keep: continue
        val level = policy.level
        val lint = LintDiag.new(warning.code, level, LintCategory.Warning, warning.message)
            .with_fix(warning.hint)
            .with_evidence(["item=" + warning.item_name, "source_severity=" + warning.severity])
            .with_uncertainty("source-pattern fallback; receiver type, effects, aliasing, and mutation version are unresolved")
            .with_evidence_tier(LintEvidenceTier.SourcePattern)
        # Locate the offending line textually; the AST span pool is empty on
        # this path (verified: expr/stmt spans all read 0 and span_is_valid is
        # false), so line recovery here works the same way lint_cli_find_fn_line
        # already does.
        val hit = lint_source_collection_fix_line(source_locations, warning.code)
        var coll_line = lint_source_function_line(source_locations, warning.item_name)
        if hit >= 0:
            coll_line = hit + 1
        results.push(LintRunResult.new(path, coll_line, 0, lint))
    for warning in check_stub_impl(decls, stub_profile_name):
        # The line-scan text reimplementation in lint_checks.spl (`pass_todo`
        # substring scan) remains the ONE live STUB003 source for this CLI
        # path — see flight_rules.spl's note that the live STUB003 emitter is
        # the text reimplementation, not this AST checker. This filter is
        # what keeps it that way: it drops every STUB003 this AST pass would
        # otherwise also emit (explicit placeholder bodies AND, since WP-8,
        # the empty-body-under-critical case), so a placeholder still emits
        # exactly once, not twice. See
        # test/01_unit/compiler/lint/lint_cli_stub_impl_contract_check.spl
        # (`cli_stub003_count != 1`) for the regression probe.
        if warning.code != "STUB001" and warning.code != "STUB002":
            continue
        val base_level = if warning.code == "STUB001": LintLevel.Warn else: LintLevel.Allow
        val policy = lint_policy_decision(
            config, warning.code, base_level, LintEvidenceTier.ParsedStructural)
        if not policy.keep: continue
        val level = policy.level
        val lint = LintDiag.new(warning.code, level, LintCategory.Warning, warning.message)
            .with_fix(warning.hint)
        results.push(LintRunResult.new(path, warning.line, 0, lint))
    # REQC00x — WP-7: the AST-based `check_required_comment` (35.semantics)
    # is now the ONLY live REQC001-004 emitter. Its predicate walks the real
    # `pass_*`/`todo`/dangerous-keyword/wildcard-arm AST nodes rather than
    # scanning source text line-by-line, so it does not false-positive on a
    # call whose rationale string is on a different physical line than the
    # opening paren (the old `lint_checks.spl` text scanner did — see
    # doc/03_plan/language/assurance/aerospace_hardening_plan_2026-08-07.md
    # WP-7). The old text reimplementation (lint_checks.spl
    # `check_required_comment_source` + helpers) has been deleted, so this
    # loop is the single source of REQC001-004 diagnostics.
    if required_comment_source_may_match(content):
        for warning in check_required_comment(decls):
            val policy = lint_policy_decision(
                config, warning.code, LintLevel.Warn, LintEvidenceTier.ParsedStructural)
            if not policy.keep: continue
            val level = policy.level
            val lint = LintDiag.new(warning.code, level, LintCategory.Warning, warning.message)
                .with_fix(warning.hint)
            results.push(LintRunResult.new(path, warning.line, 0, lint))
    # W0406 already comes from the text EasyFix owner. Add only the parsed
    # export sibling here so wildcard imports are not reported twice.
    for warning in check_star_export_file(decls, path):
        val policy = lint_policy_decision(
            config, warning.code, LintLevel.Warn, LintEvidenceTier.ParsedStructural)
        if not policy.keep: continue
        val level = policy.level
        val lint = LintDiag.new(warning.code, level, LintCategory.Warning, warning.message)
        results.push(LintRunResult.new(
            path, lint_source_export_star_line(source_locations, warning.module_path), 0, lint))
    for warning in check_wide_public_file(decls, path):
        val policy = lint_policy_decision(
            config, warning.code, LintLevel.Warn, LintEvidenceTier.ParsedStructural)
        if not policy.keep: continue
        val level = policy.level
        val message = "{warning.message} ({warning.export_count} symbols, threshold {warning.threshold})"
        val lint = LintDiag.new(warning.code, level, LintCategory.Warning, message)
        results.push(LintRunResult.new(path, warning.line, 0, lint))
    # OPTME001 — a `me` (mutating) method called through a `T?` receiver
    # silently discards the write. Single-file index: this path only resolves
    # classes declared in the SAME file. The cross-file census (most real sites
    # call a backend class declared elsewhere) is
    # `src/app/optme_lint/optme_scan.spl`, which calls the same rule function
    # with a repo-wide index. See doc/08_tracking/bug/
    # me_method_mutation_through_optional_binding_discarded_2026-08-04.md.
    for warning in check_option_me_call_source(path, content):
        val policy = lint_policy_decision(
            config, warning.code, LintLevel.Warn, LintEvidenceTier.SourcePattern)
        if not policy.keep: continue
        val level = policy.level
        val message = "{warning.message} — {warning.hint}"
        val lint = LintDiag.new(warning.code, level, LintCategory.Correctness, message)
        results.push(LintRunResult.new(path, warning.line_num, 0, lint))
    linter.release_combined_lint_view()
    results

fn lint_cli_find_decl_line(lines: [text], prefix: text, module_path: text) -> i64:
    var i = 0
    while i < lines.len():
        val trimmed = lines[i].trim()
        if trimmed.starts_with(prefix) and trimmed.contains(module_path):
            return i + 1
        i = i + 1
    1

# Locate a declaration line without mistaking comment or string decoys for a function.
fn lint_cli_find_fn_line(lines: [text], fn_name: text) -> i64:
    var i = 0
    while i < lines.len():
        val trimmed = lines[i].trim()
        val is_fn_decl = trimmed.starts_with("fn ") or trimmed.starts_with("pub fn ") or trimmed.starts_with("static fn ") or trimmed.starts_with("pub static fn ") or trimmed.starts_with("async fn ") or trimmed.starts_with("pub async fn ")
        if is_fn_decl:
            if trimmed.contains("fn {fn_name}(") or trimmed.contains("fn {fn_name}<"):
                return i + 1
        i = i + 1
    0

struct LintSourceLocationIndex:
    function_lines: Dict<text, i64>
    collection_fix_lines: Dict<text, i64>
    export_star_lines: Dict<text, i64>

fn lint_source_declared_function_name(trimmed: text) -> text:
    val fn_pos = trimmed.find("fn ")
    if fn_pos < 0: return ""
    val suffix = trimmed[fn_pos + 3:]
    val paren = suffix.find("(")
    val generic = suffix.find("<")
    var end = paren
    if end < 0 or (generic >= 0 and generic < end): end = generic
    if end <= 0: return ""
    suffix[0:end].trim()

fn lint_source_export_star_module(trimmed: text) -> text:
    var prefix = ""
    if trimmed.starts_with("export use "):
        prefix = "export use "
    elif trimmed.starts_with("export "):
        prefix = "export "
    else:
        return ""
    val star = trimmed.find(".*")
    if star <= prefix.len(): return ""
    trimmed[prefix.len():star].trim()

fn lint_source_location_index(lines: [text]) -> LintSourceLocationIndex:
    """Build all fallback source locations in one pass over the file."""
    var function_lines: Dict<text, i64> = {}
    var collection_fix_lines: Dict<text, i64> = {}
    var export_star_lines: Dict<text, i64> = {}
    var line_index = 0
    while line_index < lines.len():
        val trimmed = lines[line_index].trim()
        val is_fn_decl = trimmed.starts_with("fn ") or trimmed.starts_with("pub fn ") or trimmed.starts_with("static fn ") or trimmed.starts_with("pub static fn ") or trimmed.starts_with("async fn ") or trimmed.starts_with("pub async fn ")
        if is_fn_decl:
            val name = lint_source_declared_function_name(trimmed)
            if name != "" and not function_lines.has(name):
                function_lines[name] = line_index + 1
        val export_module = lint_source_export_star_module(trimmed)
        if export_module != "" and not export_star_lines.has(export_module):
            export_star_lines[export_module] = line_index + 1
        val assignment = collection_split_assign(lines[line_index])
        if assignment.0 != "":
            if collection_rewrite_for("COLL001", assignment.0, assignment.1) != "":
                if collection_fix_lines.has("COLL001"):
                    collection_fix_lines["COLL001"] = -1
                else:
                    collection_fix_lines["COLL001"] = line_index
            if collection_rewrite_for("COLL007", assignment.0, assignment.1) != "":
                if collection_fix_lines.has("COLL007"):
                    collection_fix_lines["COLL007"] = -1
                else:
                    collection_fix_lines["COLL007"] = line_index
        line_index = line_index + 1
    LintSourceLocationIndex(function_lines, collection_fix_lines, export_star_lines)

fn lint_source_function_line(index: LintSourceLocationIndex, fn_name: text) -> i64:
    index.function_lines[fn_name] ?? 0

fn lint_source_collection_fix_line(index: LintSourceLocationIndex, code: text) -> i64:
    index.collection_fix_lines[code] ?? -1

fn lint_source_export_star_line(index: LintSourceLocationIndex, module_path: text) -> i64:
    index.export_star_lines[module_path] ?? 1

# ---------------------------------------------------------------------------
# Source-location recovery for collection-efficiency lints (COLL0xx).
#
# AST fallback findings are hint-only: without resolved receiver type, effects,
# aliasing, and mutation version, even a statement-local rewrite is not a
# machine-applicable proof. Typed HIR/CollectionPlan may attach fixes later.
# The structural rules also stay hint-only:
#   COLL002 needs a hoisted HashSet (blocked on a generic HashMap<K,V> —
#           today's pure HashSet is text-keyed only)
#   COLL003 needs an index cursor rewrite of the whole loop
#   COLL005 needs predicate merging across two closures
#   COLL006 needs a builder declared outside the loop
# Those land with the CollectionPlan planner. See
# doc/01_research/compiler/collection_planner/collection_plan_ir_2026-07-31.md
# ---------------------------------------------------------------------------

# Split `lhs = rhs` on a source line, returning ("", "") when the line is not a
# plain assignment to a simple lvalue path. A target carrying a call, index or
# space is not safely reconstructible from source text, so it is rejected here.
fn collection_split_assign(line: text) -> (text, text):
    if line.trim().starts_with("#"):
        return ("", "")
    val eq = line.index_of(" = ")
    if eq <= 0:
        return ("", "")
    val lhs = line.slice(0, eq).trim()
    val rhs = line.slice(eq + 3, line.len()).trim()
    if lhs == "" or lhs.contains(" ") or lhs.contains("(") or lhs.contains("["):
        return ("", "")
    (lhs, rhs)

# The rewritten form for one COLL rule, or "" when the line does not match the
# exact shape the rule fixes.
fn collection_rewrite_for(code: text, lhs: text, rhs: text) -> text:
    if code == "COLL001":
        # arr = arr + [x]  ->  arr.push(x)
        val prefix = "{lhs} + ["
        if not rhs.starts_with(prefix) or not rhs.ends_with("]"):
            return ""
        val inner = rhs.slice(prefix.len(), rhs.len() - 1).trim()
        # A multi-element literal needs one push per element; leave it alone.
        if inner == "" or inner.contains(","):
            return ""
        return "{lhs}.push({inner})"
    if code == "COLL007":
        # arr = arr[0:arr.len()-1]  ->  arr.pop()
        # ponytail: `..` was never valid slice syntax here (only `:` parses to
        # EXPR_SLICE — see the note above is_array_rebuild_pop in
        # collection_patterns.spl), so this matcher tracks the same colon
        # form the detector actually fires on.
        if rhs.replace(" ", "") != "{lhs}[0:{lhs}.len()-1]":
            return ""
        return "{lhs}.pop()"
    ""

# Index of the single line this rule can rewrite, or -1.
#
# ponytail: requires a file-unique match rather than tracking fn scope. Two
# identical concat lines in one file yield no fix (the warning still fires).
# Scope tracking becomes worthwhile once the AST span pool is populated on this
# path — see doc/01_research/compiler/collection_planner/collection_plan_ir_2026-07-31.md
fn collection_fix_line(lines: [text], code: text) -> i64:
    var found = -1
    var i = 0
    while i < lines.len():
        val parts = collection_split_assign(lines[i])
        if parts.0 != "" and collection_rewrite_for(code, parts.0, parts.1) != "":
            if found >= 0:
                return -1
            found = i
        i = i + 1
    found

fn lint_evidence_json(evidence: [text]) -> text:
    var items: [text] = []
    for item in evidence:
        items.push("\"" + escape_json(item) + "\"")
    "[" + items.join(",") + "]"

fn lint_uncertainty_json(uncertainty: text?) -> text:
    match uncertainty:
        case Some(reason): "\"" + escape_json(reason) + "\""
        case nil: "null"

fn lint_main() -> Int:
    val args = get_args()
    val json_output = args.contains("--json")

    if args.len() < 2:
        if json_output:
            print("{\"type\":\"lint-error\",\"message\":\"no input files\"}")
            return 2
        print("Usage: simple_lint <file.spl> [options]")
        print("")
        print("Options:")
        print("  --deny-all        Treat all deniable warnings as errors")
        print("  --warn-all        Enable all style lints")
        print("  --profile=<tier>  Strictness tier: moderate | strict | robust | critical")
        print("  --json            Output in JSON format")
        print("  --fix             Apply safe auto-fixes")
        print("  --fix-all         Apply all fixes regardless of confidence")
        print("  --fix-dry-run     Show what would be fixed without applying")
        print("  --fix-interactive Prompt for each fix")
        print("")
        print("Lint categories:")
        print("  Safety (S): Memory safety and null checks")
        print("  Correctness (C): Logic errors")
        print("  Warning (W): Potential issues")
        print("  Style (ST): Code style")
        print("  Concurrency (CC): Thread safety")
        print("  TODO (T): TODO/FIXME format [area][priority]")
        print("  Stub (STUB): Trivial/dummy implementations")
        return 1

    val file_path = args[1]

    # Verify file exists
    if not file_exists(file_path):
        if json_output:
            print("{\"type\":\"lint-error\",\"file\":\"{escape_json(file_path)}\",\"message\":\"file not found\"}")
        else:
            error("lint", "File not found: " + file_path)
        return 1

    # Normalise the NOT-LINTED code (3) to the historical failure code on the
    # standalone `simple_lint` entry; the loud per-file banner has already been
    # printed by run_lint_file, and the richer code is consumed by the
    # `simple lint` CLI summary, which is where the count belongs.
    val standalone_rc = run_lint_file(file_path, args)
    if standalone_rc == 3:
        return 1
    standalone_rc

# Lint a single file and print a report, shared by the standalone
# `simple_lint` entry above and the `simple lint` CLI wrapper
# (app.io.cli_lint_commands.run_lint_command). Returns 0 when the file is
# clean (or only warnings, unless --deny-all is set), 1 otherwise.
fn run_lint_file(file_path: String, args: [text]) -> Int:
    # The target-scoped command path resolves its manifest below. Do not first
    # discover/read/parse an unrelated cwd manifest only to overwrite it.
    var linter = Linter.new(false)
    run_lint_file_with_linter(linter, file_path, args)

# Command-scoped entrypoint. The caller owns one Linter for the batch, so the
# immutable rule descriptors and bounded parsed-project cache are reused.
fn run_lint_file_with_linter(
    linter: Linter, file_path: String, args: [text]
) -> Int:
    _run_lint_with_linter_source(
        linter, file_path, LintCliPolicy.from_args(args), nil)

# Source-owned command entrypoint. Batch callers that already validated and
# loaded the file use this to share the exact payload with sibling analyses.
fn run_lint_source_with_linter(
    linter: Linter, file_path: String, args: [text], content: String
) -> Int:
    _run_lint_with_linter_source(
        linter, file_path, LintCliPolicy.from_args(args), Some(content))

# Command-scoped entrypoint: the caller parses invariant CLI policy once and
# reuses it for every source. Positional targets never enter the file hot path.
fn run_lint_source_with_linter_policy(
    linter: Linter, file_path: String, policy: LintCliPolicy, content: String
) -> Int:
    _run_lint_with_linter_source(linter, file_path, policy, Some(content))

fn _run_lint_with_linter_source(
    linter: Linter, file_path: String, policy: LintCliPolicy, content: String?
) -> Int:
    val deny_all = policy.deny_all
    val warn_all = policy.warn_all
    val json_output = policy.json_output
    val fix_mode = policy.fix_mode
    val fix_all = policy.fix_all
    val fix_dry_run = policy.fix_dry_run

    # Try to load config relative to the target file
    val sdn_path = linter_find_project_sdn(linter, file_path)
    if sdn_path == "":
        linter.config = linter.manifest_free_config.child()
    elif linter.parsed_sdn_index.contains_key(sdn_path):
        val config_index = linter.parsed_sdn_index[sdn_path]
        linter.config = linter.parsed_sdn_configs[config_index].child()
    else:
        val loaded_config = LintConfig.from_sdn_file(sdn_path)
        # A repository command normally sees one manifest. Bound unusual
        # multi-project/generated trees without changing uncached correctness.
        if linter.parsed_sdn_count < 256:
            linter.parsed_sdn_index[sdn_path] = linter.parsed_sdn_configs.len()
            linter.parsed_sdn_configs.push(loaded_config)
            linter.parsed_sdn_count = linter.parsed_sdn_count + 1
        linter.config = loaded_config.child()
    linter.prepared_config_path = file_path
    if linter.config.error != "":
        if json_output:
            print("{\"type\":\"lint-error\",\"message\":\"{escape_json(linter.config.error)}\"}")
        else:
            error("lint", linter.config.error)
        return 2

    if policy.error != "":
        if json_output:
            print("{\"type\":\"lint-error\",\"message\":\"{escape_json(policy.error)}\"}")
        else:
            error("lint", policy.error)
        return 2

    # --profile=<tier> selects the strictness tier (moderate|strict|robust|
    # critical; old spellings moderate|lib|reliable|mission-critical still
    # parse as deprecated aliases — see config_and_model.parse_lint_profile).
    # A file-header @profile() may still override this (most-local-wins).
    match policy.profile:
        case Some(profile): linter.config.set_profile(profile)
        case nil: pass_do_nothing

    # --wm-lane turns ON the default-off WM/GUI/web/2D portable-lane boundary
    # rule and nothing else, so the portability contract can be checked without
    # the ~900 lines of noise --warn-all produces. See
    # _LintMain/wm_lane_boundary_lints.spl.
    if policy.wm_lane:
        linter.config.set_level("wm_lane_boundary", LintLevel.Deny)

    if warn_all:
        for lint_name in all_lint_names():
            match linter.config.get_level(lint_name):
                case Allow:
                    linter.config.set_level(lint_name, LintLevel.Warn)
                case _:
                    val _ = 0

    var lint_result = LintFileResult.LintFileErr("Failed to read file: {file_path}")
    match content:
        case Some(source):
            lint_result = LintFileResult.LintFileOk(
                lint_cli_source(linter, file_path, source))
        case nil:
            match lint_read_file(file_path):
                case LintReadFileResult.ReadFileErr(error):
                    lint_result = LintFileResult.LintFileErr(error)
                case LintReadFileResult.ReadFileOk(source):
                    lint_result = LintFileResult.LintFileOk(
                        lint_cli_source(linter, file_path, source))
    match lint_result:
        case LintFileResult.LintFileOk(results):
            if results.is_empty():
                if json_output:
                    print("{\"type\":\"lint-file-summary\",\"file\":\"{escape_json(file_path)}\",\"errors\":0,\"warnings\":0,\"fixes\":0}")
                else:
                    info("lint", "No issues found in " + file_path)
                return 0
            else:
                var error_count = 0
                var warning_count = 0
                var fix_count = 0
                var not_linted = false

                for lint_item in results:
                    if lint_item.lint.code == "PARSE001":
                        not_linted = true
                    val effective_item = lint_run_result_apply_cli_policy(lint_item, deny_all)
                    if json_output:
                        var level_text = "allow"
                        match effective_item.lint.level:
                            case Deny: level_text = "error"
                            case Warn: level_text = "warning"
                            case Allow: val _ = 0
                        val evidence_json = lint_evidence_json(effective_item.lint.evidence)
                        val uncertainty_json = lint_uncertainty_json(effective_item.lint.uncertainty)
                        val confidence = lint_evidence_tier_name(effective_item.lint.evidence_tier)
                        print("{\"type\":\"lint-diagnostic\",\"file\":\"{escape_json(effective_item.file_path)}\",\"line\":{effective_item.line},\"column\":{effective_item.column},\"level\":\"{level_text}\",\"code\":\"{escape_json(effective_item.lint.code)}\",\"message\":\"{escape_json(effective_item.lint.message)}\",\"confidence\":\"{confidence}\",\"evidence\":{evidence_json},\"uncertainty\":{uncertainty_json}}")
                    else:
                        print(effective_item.format())

                    match effective_item.lint.level:
                        case Deny:
                            error_count = error_count + 1
                        case Warn:
                            warning_count = warning_count + 1
                        case Allow:
                            val _ = 0

                    if effective_item.has_easy_fix():
                        fix_count = fix_count + 1

                # Render the flag as text rather than interpolating the Bool:
                # to_text on an erased Any bool is corrupt (true -> "nil"), which
                # would emit invalid JSON. See
                # .claude/memory reference_to_to_text_on_erased_any_bool_corrupt.
                val not_linted_json = if not_linted: "true" else: "false"
                if json_output:
                    if not_linted:
                        print("{\"type\":\"lint-not-linted\",\"file\":\"{escape_json(file_path)}\",\"reason\":\"parse failure\"}")
                    print("{\"type\":\"lint-file-summary\",\"file\":\"{escape_json(file_path)}\",\"errors\":{error_count},\"warnings\":{warning_count},\"fixes\":{fix_count},\"not_linted\":{not_linted_json}}")
                else:
                    print("")
                    if not_linted:
                        print("NOT LINTED: {file_path} - source did not parse, so no AST-based lint ran on it")
                    print("Found {error_count} error(s), {warning_count} warning(s), {fix_count} auto-fix(es) available")

                # Apply fixes if requested
                if (fix_mode or fix_all or fix_dry_run) and fix_count > 0:
                    val fixes_to_apply = collect_easy_fixes(results, fix_all)
                    if not fixes_to_apply.is_empty():
                        if not apply_collected_fixes(file_path, fixes_to_apply, fix_dry_run, json_output):
                            return 1

                # 3 = NOT LINTED. A distinct code so the CLI summary can COUNT
                # skipped files separately from files that were analysed and
                # found faulty. Fail-closed: 3 is nonzero on every caller, and
                # it is returned even if some future config downgrades PARSE001
                # below Deny (error_count could then be 0 while the file was
                # still never analysed).
                if not_linted:
                    return 3
                if error_count > 0:
                    return 1
                else:
                    return 0

        case LintFileResult.LintFileErr(error):
            if json_output:
                print("{\"type\":\"lint-error\",\"file\":\"{escape_json(file_path)}\",\"message\":\"{escape_json(error)}\"}")
            else:
                error("lint", error)
            return 1

    return 0

fn collect_easy_fixes(results: [LintRunResult], include_all: Bool) -> [EasyFix]:
    var fixes: [EasyFix] = []
    for result in results:
        match result.lint.easy_fix:
            case Some(fix):
                if include_all or fix.is_safe():
                    fixes.push(fix)
            case nil:
                val _ = 0
    fixes

fn apply_collected_fixes(file_path: String, fixes: [EasyFix], dry_run: Bool, json_output: Bool) -> Bool:
    val source = file_read(file_path)
    if source == "":
        if json_output:
            print("{\"type\":\"lint-error\",\"file\":\"{escape_json(file_path)}\",\"message\":\"reading file for fix failed\"}")
        else:
            error("lint", "reading file for fix failed: {file_path}")
        return false

    # Sort replacements by position descending and apply
    var all_replacements: [Replacement] = []
    for fix in fixes:
        for rep in easyfix_replacements(fix):
            all_replacements.push(rep)

    all_replacements = easyfix_sort_replacements_descending(all_replacements)
    val new_source = easyfix_apply_sorted_replacements(source, all_replacements)

    if dry_run:
        if json_output:
            print("{\"type\":\"lint-fix-summary\",\"file\":\"{escape_json(file_path)}\",\"mode\":\"dry-run\",\"fixes\":{fixes.len()}}")
        else:
            print("\nDry run - would apply {fixes.len()} fix(es):")
            for fix in fixes:
                print("  [{easyfix_id(fix)}] {easyfix_description(fix)}")
    else:
        if not file_atomic_write(file_path, new_source):
            if json_output:
                print("{\"type\":\"lint-error\",\"file\":\"{escape_json(file_path)}\",\"message\":\"atomic fix write failed\"}")
            else:
                error("lint", "atomic fix write failed: {file_path}")
            return false
        if json_output:
            print("{\"type\":\"lint-fix-summary\",\"file\":\"{escape_json(file_path)}\",\"mode\":\"applied\",\"fixes\":{fixes.len()}}")
        else:
            print("\nApplied {fixes.len()} fix(es):")
            for fix in fixes:
                print("  [{easyfix_id(fix)}] {easyfix_description(fix)}")
    true
