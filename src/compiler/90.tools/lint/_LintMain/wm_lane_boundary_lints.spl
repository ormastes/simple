# wm_lane_boundary — WM/GUI/web/2D portable-lane dependency boundary lint.
#
# PORTABILITY CONTRACT ENFORCED
#   If Simple 2D (rendering + event delivery) runs on SimpleOS, the WM runs on
#   SimpleOS. Nothing else may be a precondition.
#
# The WM/GUI/web/2D lane is PORTABLE code. It may depend on the rendering lane
# (engine2d, browser/web model, gpu backends, paint/draw-ir, and the
# common/ui model-layout-style tier), and it may reach the host/OS seam ONLY
# through the single WM host interface, which is scoped to "2D surface +
# event source". Anything else that reaches the host/OS — fs, net, process,
# env, database, raw platform `extern`, kernel/driver/baremetal tiers — is a
# HIDDEN PRECONDITION that would stop the WM from booting on SimpleOS, and is
# therefore a violation.
#
# COST / ACTIVATION
#   This rule walks every module-level `use` line of every in-scope file, so it
#   is DEFAULT OFF (`levels["wm_lane_boundary"] = "allow"` in
#   config_and_model.build_default_levels). It lives in compiler/90.tools/lint,
#   which the compile/build driver never imports (see the explicit
#   "must not import compiler.tools.lint.main" note in
#   src/compiler/80.driver/driver_safety_severity.spl), so a normal
#   `bin/simple build` cannot pay for it. The check body additionally
#   short-circuits on an O(1) override lookup before reading any line — see
#   Linter.check_wm_lane_boundary in lint_checks.spl.
#
#   Turn it on with exactly one of:
#     bin/simple lint --wm-lane <files>     # this rule only (targeted)
#     bin/simple lint --warn-all <files>    # full-diagnosis, every lint
#     simple.sdn  lints:\n#                   wm_lane_boundary: deny
#
# SIBLING-LANE DEPENDENCY
#   The single WM host interface is still being built by a sibling lane. This
#   rule names it by PATH in wm_host_interface_modules() below. When that lane
#   renames or splits the seam, update that one function — it is the only place
#   the door is spelled out.
use compiler.tools.lint.main.*

class WmLaneWarning:
    code: String
    line: Int
    message: String
    hint: String

# Directories that make up the portable WM/GUI/web/2D lane. These are exactly
# the scope roots of doc/04_architecture/ui/wm_gui_web_dependency_audit.md, so
# this rule and that audit's Bucket C list describe the same surface (~471
# files here vs the audit's 454 — this rule's find is a small superset).
# Candidate extensions once the current baseline is burned down:
# common/{engine,render_scene,drawing,layout}.
fn wm_lane_scope_dirs() -> [text]:
    ["src/app/wm_compare/",
     "src/app/wm_showcase/",
     "src/lib/common/ui/",
     "src/lib/common/web/",
     "src/lib/common/window_protocol/",
     "src/lib/gc_async_mut/gpu/browser_engine/",
     "src/lib/gc_async_mut/gpu/engine2d/",
     "src/lib/nogc_async_mut/wm/",
     "src/lib/gc_sync_mut/play/wm/",
     "src/lib/nogc_sync_mut/play/wm/",
     "src/lib/gc_async_mut/play/wm/",
     "src/lib/nogc_async_mut/play/wm/",
     "src/os/services/wm/"]

# The single WM host interface: the ONLY sanctioned door from the portable
# lane to the host/OS. Scoped to 2D surface + event source, and taken from the
# audit's Bucket B (5 edges / 3 capabilities): window+surface lifecycle and
# input events are already centralised in the window_protocol type set, and
# `os.userlib.ipc_protocol` is the transport that delivers them.
#
# `os.compositor.display_backend_core` is deliberately NOT here. It is the host
# compositor's backend, not the surface+event contract, and the audit scores it
# as a violation — keeping it out is what makes this rule agree with the audit
# on src/lib/common/ui.
#
# Owned by the sibling WM-host lane — when that lane lands the real seam, this
# is the one function to update.
fn wm_host_interface_modules() -> [text]:
    ["common.window_protocol.window_protocol",
     "os.userlib.ipc_protocol"]

fn wm_host_interface_summary() -> String:
    "common.window_protocol.window_protocol + os.userlib.ipc_protocol"

# True when `path` is portable WM/GUI/web/2D code the contract applies to.
fn wm_lane_lint_in_scope(path: String) -> Bool:
    if path.contains("/vendor/"):
        return false
    for dir in wm_lane_scope_dirs():
        if path.contains(dir):
            return true
    false

# Module prefixes that mirror wm_lane_scope_dirs(): an import landing back
# inside the lane is an INTRA-SCOPE edge (the audit's bucket I), never a host
# dependency, and must be exempt before any deny rule runs. Kept per-tier and
# spelled out in full — the audit found 68 cross-tier duplicate module names,
# all divergent, so matching on a bare module name would silently skip real
# violations.
fn _wml_intra_scope_modules() -> [text]:
    ["app.wm_compare",
     # `app.wm_compare_host` is NOT a wm_lane_scope_dirs() root — it is the W2
     # host-adapter facade (doc/03_plan/ui/wm_lane_boundary_ratchet_lanes.md,
     # tranche W2): a sibling dir that holds ALL of wm_compare's fs/env/cli/
     # process host imports behind re-exporting facade modules, so wm_compare
     # itself only ever imports the facade, never io.*/rt_* directly. Listed
     # here (not in wm_host_interface_modules(), which is the single *runtime*
     # WM host door) because this is a harness-specific door, not the 2D
     # surface+event contract.
     "app.wm_compare_host",
     "app.wm_showcase",
     # `app.wm_showcase_host` mirrors `app.wm_compare_host`: a sibling dir
     # (NOT a wm_lane_scope_dirs() root) that holds wm_showcase's host/app-
     # shell imports (HostCompositor, the shared app.ui.render contract, the
     # Simple Browser/Terminal render adapters) behind re-exporting facade
     # modules, so wm_showcase's own session.spl imports only the facade,
     # never os.compositor.*/app.ui.render.*/app.browser.*/app.terminal.*
     # directly. See src/app/wm_showcase_host/*.spl.
     "app.wm_showcase_host",
     "common.ui",
     "common.web",
     "common.window_protocol",
     "gc_async_mut.gpu.browser_engine",
     "gc_async_mut.gpu.engine2d",
     "nogc_async_mut.wm",
     "gc_sync_mut.play.wm",
     "nogc_sync_mut.play.wm",
     "gc_async_mut.play.wm",
     "nogc_async_mut.play.wm",
     "os.services.wm"]

# Mutable/host-capable library tiers. Reachable from the portable lane only
# for their rendering sub-lanes (see _wml_render_sublanes).
fn _wml_mutable_tiers() -> [text]:
    ["nogc_sync_mut", "nogc_async_mut", "gc_sync_mut", "gc_async_mut"]

# Rendering-lane sub-modules that stay portable inside a mutable tier.
fn _wml_render_sublanes() -> [text]:
    ["ui", "gpu", "compositor", "text_layout", "engine", "game2d",
     "web_render", "image", "font", "draw_ir", "render", "paint"]

# Top-level module roots that ARE the host/OS by definition. `cli` and `time`
# are here on purpose: the audit's sharpened test demotes tooling-CLI and
# timers to violations, because the WM must run without a terminal or a clock.
fn _wml_host_roots() -> [text]:
    ["io", "io_runtime", "fs", "file_system", "net", "http", "process", "env",
     "database", "db", "ffi", "sffi", "socket", "tcp", "udp", "websocket",
     "tls", "kernel", "driver", "drivers", "baremetal", "qemu", "cli", "time",
     "nogc_async_mut_noalloc"]

# `extern fn` symbols that exist in the freestanding runtime core and are
# therefore present on SimpleOS. Declaring these does NOT add a precondition.
# Superset of the audit's neutral "R" set (rt_alloc, rt_memcpy, rt_ptr_*,
# rt_math_*) — the rest are language/data primitives with the same property.
fn _wml_core_intrinsic_prefixes() -> [text]:
    ["rt_math_", "rt_alloc", "rt_free", "rt_realloc", "rt_mem", "rt_ptr_",
     "rt_raw_", "rt_str", "rt_text_", "rt_array_", "rt_list_", "rt_dict_",
     "rt_bytes_",
     # `rt_u32s_from_raw` is a bulk one-call raw-buffer -> `[u32]` array
     # readback: same freestanding-core memory-primitive category as
     # `rt_memcpy`/`rt_ptr_read_i64` above (it replaces a per-pixel
     # `rt_ptr_read_i64` loop; see the comment above its declaration in
     # window_scene_draw_ir.spl), just not covered by the `rt_raw_`/`rt_ptr_`
     # prefixes because the symbol names the OUTPUT type first. Declared
     # identically (same signature) in window_scene_draw_ir.spl, metal_ptr.spl
     # and cuda_fill_u32.spl — a single core primitive, not a per-file host
     # binding.
     "rt_u32s_from_raw"]

# Rendering-lane and 2D-present externs. GPU backend bindings ARE the rendering
# lane the contract explicitly allows, and rt_fb_* is the audit's Bucket B 2D
# presentation seam. Neither is a hidden precondition: a missing GPU backend
# falls back, and framebuffer present is the thing being ported, not a
# precondition of it.
#
# NOTE the asymmetry with imports: rt_fb_* is exempt here because it IS the
# surface seam, whereas rt_host_*/rt_io_*/rt_time_*/rt_simd_*/rt_file_*/
# spl_dlopen and friends stay violations.
fn _wml_render_extern_prefixes() -> [text]:
    ["rt_gpu_", "rt_vk_", "rt_vulkan_", "rt_cuda_", "rt_webgpu_", "rt_intel_",
     "rt_metal_", "rt_opencl_", "rt_rocm_", "rt_fb_"]

# Module path from a module-level `use` / `export use` / `pub use` line.
# Returns "" when the line is not an import.
fn _wml_use_module(trimmed: String) -> String:
    var rest = ""
    if trimmed.starts_with("export use "):
        rest = trimmed.slice(11)
    elif trimmed.starts_with("pub use "):
        rest = trimmed.slice(8)
    elif trimmed.starts_with("use "):
        rest = trimmed.slice(4)
    else:
        return ""
    rest = rest.trim()
    var i = 0
    while i < rest.len():
        val ch = rest.substring(i, i + 1)
        if ch == "{" or ch == " " or ch == "*" or ch == "#" or ch == ",":
            break
        i = i + 1
    var m = rest.slice(0, i)
    while m.len() > 0 and m.substring(m.len() - 1, m.len()) == ".":
        m = m.slice(0, m.len() - 1)
    m

# `std.` and `lib.` are resolution prefixes onto src/lib — strip them so the
# tier root is the first real segment.
fn _wml_normalize(module: String) -> String:
    var m = module
    if m.starts_with("std."):
        m = m.slice(4)
    if m.starts_with("lib."):
        m = m.slice(4)
    m

fn _wml_seg(m: String, idx: Int) -> String:
    val parts = m.split(".")
    if idx >= parts.len():
        return ""
    parts[idx]

fn _wml_is_host_door(m: String) -> Bool:
    for door in wm_host_interface_modules():
        if m == door or m.starts_with("{door}."):
            return true
    false

# "" when the import is allowed, otherwise the violation message.
fn _wml_classify_import(module: String) -> String:
    val m = _wml_normalize(module)
    if m == "":
        return ""
    # Intra-scope edges first: an import back into the lane is bookkeeping,
    # not a host dependency, whatever tier it lives in.
    for own in _wml_intra_scope_modules():
        if m == own or m.starts_with("{own}."):
            return ""
    if _wml_is_host_door(m):
        return ""
    val root = _wml_seg(m, 0)
    # The `common` tier is the pure, portable rendering lane — EXCEPT where it
    # carries a host capability of its own. `common.io.window_event` is the live
    # example: it sits in the pure tier but is still an io dependency, and the
    # audit scores it as a violation.
    if root == "common":
        for bad in _wml_host_roots():
            if _wml_seg(m, 1) == bad:
                return "portable 2D/WM lane depends on host-capability module `{module}` — the `common` tier is otherwise pure, but this submodule is an io/host seam; route it through the single WM host interface (`{wm_host_interface_summary()}`)"
        return ""
    if root == "os":
        return "portable 2D/WM lane reaches host/OS module `{module}` directly instead of through the single WM host interface `{wm_host_interface_summary()}` — this is a hidden precondition that would stop the WM booting on SimpleOS"
    if root == "app":
        return "portable 2D/WM lane depends on application-shell module `{module}` — an app shell is a host precondition, not part of the rendering lane"
    if root == "nogc_async_mut_noalloc":
        return "portable 2D/WM lane depends on baremetal/kernel-tier module `{module}` — kernel driver tiers are not portable across hosts"
    for tier in _wml_mutable_tiers():
        if root == tier:
            val sub = _wml_seg(m, 1)
            for ok in _wml_render_sublanes():
                if sub == ok:
                    return ""
            return "portable 2D/WM lane depends on host-capability module `{module}` in the `{tier}` tier — only rendering sub-lanes are portable; route host access through `{wm_host_interface_summary()}`"
    for bad in _wml_host_roots():
        if root == bad:
            return "portable 2D/WM lane depends on host-runtime module `{module}` (fs/net/process/env class) — this is a hidden precondition that would stop the WM booting on SimpleOS"
    ""

# Symbol name from an `extern fn NAME(` declaration line ("" when absent).
fn _wml_extern_fn_name(trimmed: String) -> String:
    var rest = trimmed
    if rest.starts_with("pub extern fn "):
        rest = rest.slice(14)
    elif rest.starts_with("extern fn "):
        rest = rest.slice(10)
    else:
        return ""
    rest = rest.trim()
    var i = 0
    while i < rest.len():
        val ch = rest.substring(i, i + 1)
        if not ((ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or (ch >= "0" and ch <= "9") or ch == "_"):
            break
        i = i + 1
    rest.slice(0, i)

fn _wml_is_core_intrinsic(name: String) -> Bool:
    for prefix in _wml_core_intrinsic_prefixes():
        if name.starts_with(prefix):
            return true
    for prefix in _wml_render_extern_prefixes():
        if name.starts_with(prefix):
            return true
    false

# Scan one portable-lane file. Only module-level (column 0) `use` lines are
# considered: an import written at column 0 is the project convention, and the
# restriction keeps prose inside docstrings from being read as an import.
fn lint_wm_lane_boundary(path: String, content: String) -> [WmLaneWarning]:
    lint_wm_lane_boundary_lines(path, content.split("\n"))

fn lint_wm_lane_boundary_lines(
    path: String, lines: [String]
) -> [WmLaneWarning]:
    var warnings: [WmLaneWarning] = []
    if not wm_lane_lint_in_scope(path):
        return warnings
    var line_num = 1
    for line in lines:
        val trimmed = line.trim()
        if trimmed != "" and not trimmed.starts_with("#") and indent_width(line) == 0:
            val module = _wml_use_module(trimmed)
            if module != "":
                val reason = _wml_classify_import(module)
                if reason != "":
                    warnings.push(WmLaneWarning(
                        code: "WML001",
                        line: line_num,
                        message: reason,
                        hint: "Move the host access behind the single WM host interface (`{wm_host_interface_summary()}`), or drop the dependency; suppress a reviewed exception with @allow(wm_lane_boundary)"
                    ))
            else:
                val sym = _wml_extern_fn_name(trimmed)
                if sym != "" and not _wml_is_core_intrinsic(sym):
                    warnings.push(WmLaneWarning(
                        code: "WML002",
                        line: line_num,
                        message: "portable 2D/WM lane declares raw platform extern `{sym}` — a non-core intrinsic binds a host symbol directly and would stop the WM booting on SimpleOS",
                        hint: "Call it through the single WM host interface (`{wm_host_interface_summary()}`) or a std wrapper; freestanding-core intrinsics (rt_math_*, rt_alloc, rt_mem*, rt_ptr_*, ...) are already exempt"
                    ))
        line_num = line_num + 1
    warnings
