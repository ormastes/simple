# Linter check_* rule implementations.
use std.tooling.easy_fix.types.{FixConfidence, Replacement, EasyFix}
use compiler.tools.lint.main.*
# Simple Language Linter
# Semantic lints for code quality and safety
# Usage: simple_lint <file.spl> [--deny-all] [--warn-all]

# I/O imports
use std.nogc_sync_mut.io.file_ops (file_read, file_exists, file_write)
use std.nogc_sync_mut.io.dir_ops (is_dir)
use app.io.cli_ops (get_args)

# Logging imports
use std.log.{error, info}

# Import EasyFix data types from stdlib
use std.tooling.easy_fix.*
use compiler.tools.fix.rules.registry.{check_all_rules}
use compiler.tools.fix.rules.impl_.lint_primitive_api.{check_primitive_api}
use compiler.tools.fix.rules.impl_.lint_script_language.{check_simple_script_required}
use lazy nogc_sync_mut.ui.theme_package.{validate_default_theme_package}
use compiler.semantics.lint.raw_rt_access.{check_raw_rt_access_with_allowlist, raw_rt_lexical_code_lines, raw_rt_wrapper_replacement}
use compiler.semantics.lint.dynamic_capability_acquire.{check_dynamic_capability_acquire}
use std.critical.capability_manifest.{load_critical_mode_config}
use compiler.tools.lint.static_rules.{
    LintParamsV1, LintUnit, StaticLintCategory, StaticLintLevel,
    static_lint_rule_table, run_static_lint_rule_table
}

# File I/O wrapper

var _RAW_RT_ALLOWLIST_LOADED = false
var _RAW_RT_ALLOWLIST = ""

fn _raw_rt_canonical_allowlist() -> text:
    if not _RAW_RT_ALLOWLIST_LOADED:
        _RAW_RT_ALLOWLIST = file_read("scripts/check/no_direct_rt_allowlist.txt")
        _RAW_RT_ALLOWLIST_LOADED = true
    _RAW_RT_ALLOWLIST

fn _raw_rt_wrapper_is_in_scope(content: text, wrapper: text) -> bool:
    # Auto-fix requires an exact selective import of this symbol. Broad module
    # imports, comments, strings, lookalike module names, and unrelated wrapper
    # symbols are intentionally insufficient evidence for a Safe edit.
    val modules = ["app.io.mod", "std.io_runtime", "std.nogc_sync_mut.io_runtime"]
    for raw_line in raw_rt_lexical_code_lines(content):
        val line = raw_line.trim()
        if not line.starts_with("use "):
            continue
        for module_name in modules:
            val brace_form = "use {module_name}.{{"
            if line.starts_with(brace_form) and line.ends_with("}"):
                val body = line.substring(brace_form.len(), line.len() - 1)
                for item in body.split(","):
                    if item.trim() == wrapper:
                        return true
    false

impl Linter:
    static fn new(discover_project_config: bool = true) -> Linter:
        var lints = []

        # Safety lints
        lints.push(LintDiag.new("S001", LintLevel.Deny, LintCategory.Safety,
            "Unused Result type (must use .unwrap(), .expect(), or match)"))
        lints.push(LintDiag.new("S002", LintLevel.Deny, LintCategory.Safety,
            "Potential null pointer dereference"))
        lints.push(LintDiag.new("S003", LintLevel.Warn, LintCategory.Safety,
            "Unsafe block without safety comment"))

        # Correctness lints
        lints.push(LintDiag.new("C001", LintLevel.Deny, LintCategory.Correctness,
            "Unreachable code after return/break/continue"))
        lints.push(LintDiag.new("C002", LintLevel.Warn, LintCategory.Correctness,
            "Non-exhaustive match (add catch-all case)"))
        lints.push(LintDiag.new("MEXH001", LintLevel.Warn, LintCategory.Correctness,
            "Non-exhaustive match on enum: missing variant(s)"))
        lints.push(LintDiag.new("MEXH002", LintLevel.Warn, LintCategory.Correctness,
            "Match expression has no wildcard/default case"))
        lints.push(LintDiag.new("MEXH003", LintLevel.Warn, LintCategory.Correctness,
            "Non-exhaustive boolean match: missing true or false"))
        lints.push(LintDiag.new("MEXH004", LintLevel.Warn, LintCategory.Correctness,
            "Unreachable match arm (after wildcard or duplicate pattern)"))
        lints.push(LintDiag.new("MEXH005", LintLevel.Warn, LintCategory.Correctness,
            "Non-exhaustive Option/Result match: missing variant(s)"))
        # Deny, not Warn: the arm is an irrefutable binding that silently
        # swallows every remaining value and kills all later arms including '_'.
        lints.push(LintDiag.new("MEXH006", LintLevel.Deny, LintCategory.Correctness,
            "Capitalized case name is not a variant — arm is an irrefutable binding"))
        lints.push(LintDiag.new("C003", LintLevel.Warn, LintCategory.Correctness,
            "Comparison of incompatible types"))

        # Warning lints
        lints.push(LintDiag.new("W001", LintLevel.Warn, LintCategory.Warning,
            "Unused variable (prefix with _ to silence)"))
        lints.push(LintDiag.new("W002", LintLevel.Warn, LintCategory.Warning,
            "Unused import"))
        lints.push(LintDiag.new("W003", LintLevel.Warn, LintCategory.Warning,
            "Dead code"))

        # Style lints
        lints.push(LintDiag.new("ST001", LintLevel.Allow, LintCategory.Style,
            "Function name should be snake_case"))
        lints.push(LintDiag.new("ST002", LintLevel.Allow, LintCategory.Style,
            "Class name should be PascalCase"))
        lints.push(LintDiag.new("ST003", LintLevel.Allow, LintCategory.Style,
            "Constant should be UPPER_SNAKE_CASE"))

        # Concurrency lints
        lints.push(LintDiag.new("CC001", LintLevel.Deny, LintCategory.Concurrency,
            "Shared mutable state without synchronization"))
        lints.push(LintDiag.new("CC002", LintLevel.Warn, LintCategory.Concurrency,
            "Send type used without thread safety guarantee"))

        # Database lints (D00x rules)
        lints.push(LintDiag.new("D001", LintLevel.Deny, LintCategory.Correctness,
            "Direct .sdn file write detected. Use lib.database instead."))

        # Tracking lints (TRK00x rules)
        lints.push(LintDiag.new("TRK001", LintLevel.Deny, LintCategory.Correctness,
            "Done feature tracking rows must include full traceability evidence."))

        # TODO/FIXME format lints (T00x rules)
        lints.push(LintDiag.new("T001", LintLevel.Warn, LintCategory.Style,
            "TODO/FIXME missing [area][priority] format"))
        lints.push(LintDiag.new("T002", LintLevel.Warn, LintCategory.Style,
            "TODO/FIXME has invalid area"))
        lints.push(LintDiag.new("T003", LintLevel.Warn, LintCategory.Style,
            "TODO/FIXME has invalid priority"))
        lints.push(LintDiag.new("T004", LintLevel.Deny, LintCategory.Style,
            "P0/critical TODO must have issue number"))

        # Import/Module lints (I00x rules)
        lints.push(LintDiag.new("I001", LintLevel.Deny, LintCategory.Correctness,
            "Unfold subpackage directory does not exist"))
        lints.push(LintDiag.new("I002", LintLevel.Deny, LintCategory.Correctness,
            "Unfold subpackage missing __init__.spl"))
        lints.push(LintDiag.new("I003", LintLevel.Deny, LintCategory.Correctness,
            "Unfold declaration in non-directory module"))

        # Stub implementation lints (STUB00x rules)
        lints.push(LintDiag.new("STUB001", LintLevel.Deny, LintCategory.Warning,
            "Function with params returns trivial value (params unused) — possible stub"))
        lints.push(LintDiag.new("STUB002", LintLevel.Allow, LintCategory.Warning,
            "Zero-param function returns default value — possible stub"))
        lints.push(LintDiag.new("STUB003", LintLevel.Deny, LintCategory.Warning,
            "Explicit pass_todo placeholder in production code"))

        # SPipe quality lints (SPIPE00x rules)
        lints.push(LintDiag.new("SPIPE001", LintLevel.Deny, LintCategory.Correctness,
            "Tautological SPipe assertion — replace placeholder success with a real assertion"))
        lints.push(LintDiag.new("SPIPE002", LintLevel.Deny, LintCategory.Correctness,
            "Placeholder pass helper in SPipe example — use skip: or assert a real capability/result"))
        lints.push(LintDiag.new("SPIPE003", LintLevel.Deny, LintCategory.Correctness,
            "Placeholder success arm in SPipe match — assert returned data or use skip:"))
        lints.push(LintDiag.new("SPIPE004", LintLevel.Deny, LintCategory.Correctness,
            "Print-based skip placeholder in SPipe example — use skip: instead of print-and-return"))
        lints.push(LintDiag.new("SPIPE005", LintLevel.Deny, LintCategory.Correctness,
            "SPipe example has no real assertion or sanctioned skip"))
        lints.push(LintDiag.new("SPIPE006", LintLevel.Warn, LintCategory.Correctness,
            "expect(bool) is called with a boolean matcher such as is_equal(true) — use assert_true(condition)"))
        lints.push(LintDiag.new("SPIPE007", LintLevel.Warn, LintCategory.Correctness,
            "expect(bool) is called with a boolean matcher such as is_equal(false) — use expect_not(condition)"))

        # Argument count lints (ARG00x rules)
        lints.push(LintDiag.new("ARG001", LintLevel.Warn, LintCategory.Style,
            "Function has too many parameters (> 7) — consider grouping into struct"))
        lints.push(LintDiag.new("ARG002", LintLevel.Deny, LintCategory.Style,
            "Function has too many parameters (> 12) — must refactor"))
        lints.push(LintDiag.new("ACC001", LintLevel.Warn, LintCategory.Warning,
            "Trivial get_*/set_*/is_* accessor only forwards a backing field"))
        lints.push(LintDiag.new("NAME001", LintLevel.Warn, LintCategory.Warning,
            "Method name is close to an inherited method name and may be a misspelled override"))

        # Required comment lints (REQC00x rules)
        lints.push(LintDiag.new("REQC001", LintLevel.Warn, LintCategory.Warning,
            "pass_* used without a comment string"))
        lints.push(LintDiag.new("REQC002", LintLevel.Warn, LintCategory.Warning,
            "Dangerous keyword used without a comment string"))
        lints.push(LintDiag.new("REQC003", LintLevel.Warn, LintCategory.Warning,
            "todo used without what-remains and next-step strings"))
        lints.push(LintDiag.new("REQC004", LintLevel.Warn, LintCategory.Warning,
            "Wildcard match arm used without a rationale"))

        # Primitive parameter tag lints (PTAG00x rules)
        lints.push(LintDiag.new("PTAG001", LintLevel.Warn, LintCategory.Warning,
            "pub fn has ≥2 same-type primitive params with no @tag annotation — add `# @tag(p1=role, p2=role)` to disambiguate"))
        lints.push(LintDiag.new("PTAG002", LintLevel.Warn, LintCategory.Warning,
            "Same-type params have different @tag roles — callers must use named args to avoid silent swap"))

        # UI typed-API lints (UI00x rules)
        lints.push(LintDiag.new("UI001", LintLevel.Warn, LintCategory.Style,
            "Raw string literal passed as WidgetNode kind — use WidgetKind.X.to_wire()"))
        lints.push(LintDiag.new("UI002", LintLevel.Warn, LintCategory.Style,
            "Raw string literal in action position — use with_on_typed_action with Action or CommonAction"))
        lints.push(LintDiag.new("UI003", LintLevel.Warn, LintCategory.Style,
            "Raw theme-name string literal — use ThemeId enum variant"))

        # MD diagram staleness lint (DIAG001)
        lints.push(LintDiag.new("DIAG001", LintLevel.Warn, LintCategory.Correctness,
            "Stale SDN diagram — run 'simple md-diagram-update' to regenerate"))

        # Const-by-default reference lint (W-MC-REF-001 / const_ref_default)
        lints.push(LintDiag.new("W-MC-REF-001", LintLevel.Warn, LintCategory.Correctness,
            "Parameter is mutated but not declared 'mut' (references are const by default)"))

        # Bare-primitive internal binding lint (W-MC-VAL-001 /
        # bare_primitive_internal, REQ-MC-011). Allow by default — warn only
        # under the mission-critical profile (would flood non-MC code).
        lints.push(LintDiag.new("W-MC-VAL-001", LintLevel.Allow, LintCategory.Correctness,
            "Internal binding typed only by a bare primitive (mission-critical: use domain types)"))

        # Unwrapped foreign resource escape lint (W-MC-RES-001 /
        # unwrapped_foreign_resource, REQ-MC-023). Allow by default — warn
        # only under the critical profile (would flood non-MC FFI glue).
        lints.push(LintDiag.new("W-MC-RES-001", LintLevel.Allow, LintCategory.Correctness,
            "Bare foreign-resource handle escapes its acquire call site unwrapped (mission-critical: wrap in an owning type)"))

        # Try to load project-level lint config from simple.sdn
        # Search in common project root locations
        val manifest_free_config = LintConfig.new()
        var config = manifest_free_config.child()
        if discover_project_config:
            val sdn_path = find_project_sdn(".")
            if sdn_path != "":
                config = LintConfig.from_sdn_file(sdn_path)

        Linter(
            lints: lints, results: [], config: config,
            last_resolved_path: "", last_resolved_config: nil,
            retain_combined_view: false, last_source_locations_valid: false,
            last_source_function_lines: {}, last_source_collection_fix_lines: {},
            last_source_export_star_lines: {}, last_option_me_warnings: [],
            parsed_sdn_index: {}, parsed_sdn_configs: [],
            parsed_sdn_count: 0, manifest_free_config: manifest_free_config,
            critical_dynamic_acquire_loaded: false,
            critical_dynamic_acquire_mode: "allow",
            manifest_dir_cache: {}, manifest_dir_cache_count: 0,
            prepared_config_path: "", last_diagnostic_count: 0,
            last_error_count: 0, last_warning_count: 0,
            last_not_analyzed: false)
    
    # Lint a source buffer while RETAINING the combined lexical view that
    # `lint_source` otherwise releases on exit. `entry_and_fixes` calls this so
    # the follow-up fix pass can read `last_source_*` without re-resolving.
    # Callers must pair it with `release_combined_lint_view()`.
    me lint_source_for_parsed_append(
        path: String, content: String
    ) -> [LintRunResult]:
        self.retain_combined_view = true
        val results = self.lint_source(path, content)
        self.retain_combined_view = false
        results

    me release_combined_lint_view():
        self.last_resolved_path = ""
        self.last_resolved_config = nil
        self.last_source_locations_valid = false
        self.last_source_function_lines = {}
        self.last_source_collection_fix_lines = {}
        self.last_source_export_star_lines = {}
        self.last_option_me_warnings = []

    me lint_source(path: String, content: String) -> [LintRunResult]:
        self.results = []

        val file_config = resolve_lint_config(self.config, path, content)

        # Run simple pattern-based lints
        val lines = content.split("\n")
        var line_num = 1

        for line in lines:
            self.check_line(path, line_num, line)
            line_num = line_num + 1

        self.check_feature_tracking_done_gate(path, content)
        self.check_spipe_quality(path, content)
        self.check_ui_raw_widget_kind(path, content)
        self.check_ui_raw_variant(path, content)
        self.check_ui_raw_theme_name(path, content)
        self.check_theme_package(path)
        self.check_stale_md_diagrams(path, content)
        self.check_llvm_backend_type_safety(path, content)
        self.check_raw_rt_access_spl(path, content)
        self.check_dynamic_capability_acquire_spl(path, content)
        self.check_static_lint_rules(path, content)
        self.check_wm_lane_boundary(file_config, path, content)

        # Run shared EasyFix rules and attach as lint results
        val shared_fixes = check_all_rules(content, path)
        for fix in shared_fixes:
            val rule_id = easyfix_id(fix).split(":")[1]
            val lint = LintDiag.new(rule_id, LintLevel.Warn, LintCategory.Warning, easyfix_description(fix))
                .with_easy_fix(fix)
            # Extract line from first replacement
            var fix_line = 1
            val fix_reps = easyfix_replacements(fix)
            if fix_reps.len() > 0:
                val first_rep = fix_reps[0]
                fix_line = first_rep.line
            self.results.push(LintRunResult.new(path, fix_line, 0, lint))

        val primitive_api_fixes = check_primitive_api(content, path)
        for fix in primitive_api_fixes:
            val lint = LintDiag.new("primitive_api", LintLevel.Warn, LintCategory.Warning, easyfix_description(fix))
                .with_easy_fix(fix)
            var fix_line = 1
            val fix_reps = easyfix_replacements(fix)
            if fix_reps.len() > 0:
                val first_rep = fix_reps[0]
                fix_line = first_rep.line
            self.results.push(LintRunResult.new(path, fix_line, 0, lint))

        val script_language_fixes = check_simple_script_required(content, path)
        for fix in script_language_fixes:
            val lint = LintDiag.new("simple_script_required", LintLevel.Warn, LintCategory.Warning, easyfix_description(fix))
                .with_easy_fix(fix)
            var fix_line = 1
            val fix_reps = easyfix_replacements(fix)
            if fix_reps.len() > 0:
                val first_rep = fix_reps[0]
                fix_line = first_rep.line
            self.results.push(LintRunResult.new(path, fix_line, 0, lint))

        # Filter and adjust results based on config
        var filtered_results: [LintRunResult] = []
        for result in self.results:
            if should_keep_lint_result(file_config, result.lint.code):
                # Apply config-level override (e.g. promote to Deny)
                val adjusted_level = apply_config_level(file_config, result.lint.code, result.lint.level)
                if adjusted_level != result.lint.level:
                    val adjusted_lint = LintDiag(
                        code: result.lint.code,
                        level: adjusted_level,
                        category: result.lint.category,
                        message: result.lint.message,
                        fix_hint: result.lint.fix_hint,
                        easy_fix: result.lint.easy_fix
                    )
                    filtered_results.push(LintRunResult(
                        file_path: result.file_path,
                        line: result.line,
                        column: result.column,
                        lint: adjusted_lint
                    ))
                else:
                    filtered_results.push(result)

        self.results = filtered_results
        self.results

    me lint_file(path: String) -> LintFileResult:
        val file_content = lint_read_file(path)
        match file_content:
            case LintReadFileResult.ReadFileErr(e):
                return LintFileResult.LintFileErr(e)
            case LintReadFileResult.ReadFileOk(content):
                return LintFileResult.LintFileOk(self.lint_source(path, content))

    me check_theme_package(path: String):
        if not path.starts_with("config/themes/"):
            return
        val issues = validate_default_theme_package()
        for issue in issues:
            val lint = LintDiag.new("THEME001", LintLevel.Deny, LintCategory.Correctness,
                "{issue.path} {issue.key}: {issue.message}")
                .with_fix("Fix config/themes/theme.sdn or the referenced theme package file")
            self.results.push(LintRunResult.new(path, 1, 0, lint))

    # DCA001: capability-group acquisition outside an `@init_phase` function.
    # Severity comes from `critical.dynamic_acquire` in config/critical_mode.sdn,
    # which ships as `enabled: false` -> mode `allow`, so this contributes zero
    # findings to a non-critical build and cannot regress the existing corpus.
    # Critical builds set `enabled: true` (mode `warn` today, promotable to
    # `error`). Reported at LintLevel.Warn for the same reason LEADOP001 is:
    # a rule must not be escalated to Deny before its population is converted.
    me check_dynamic_capability_acquire_spl(path: String, content: String):
        val cfg = load_critical_mode_config("config/critical_mode.sdn")
        val mode = if cfg.enabled: cfg.dynamic_acquire else: "allow"
        if mode == "allow":
            return
        val findings = check_dynamic_capability_acquire(content, path, [], mode)
        for finding in findings:
            val lint = LintDiag.new(finding.code, LintLevel.Warn, LintCategory.Correctness, finding.message)
                .with_fix(finding.note)
            self.results.push(LintRunResult.new(path, finding.line_num, 0, lint))

    me check_raw_rt_access_spl(path: String, content: String):
        val findings = check_raw_rt_access_with_allowlist(content, path, _raw_rt_canonical_allowlist())
        # Resolve import evidence for signature-proven mechanical mappings once
        # per file, not once per finding.
        val process_run_fixable = if findings.len() > 0: _raw_rt_wrapper_is_in_scope(content, "process_run") else: false
        val env_set_fixable = if findings.len() > 0: _raw_rt_wrapper_is_in_scope(content, "env_set") else: false
        val has_fixable_wrapper = process_run_fixable or env_set_fixable
        var fix_lines: [text] = []
        var fix_line_starts: [i64] = []
        if has_fixable_wrapper:
            fix_lines = content.split("\n")
            var next_start = 0
            for fix_line in fix_lines:
                fix_line_starts.push(next_start)
                next_start = next_start + fix_line.len() + 1
        for finding in findings:
            var lint = LintDiag.new(finding.code, LintLevel.Warn, LintCategory.Correctness, finding.message)
                .with_fix(finding.note)
            val wrapper = raw_rt_wrapper_replacement(finding.name)
            val wrapper_fixable = ((wrapper == "process_run" and process_run_fixable) or
                (wrapper == "env_set" and env_set_fixable))
            if finding.code == "RAW-RT-002" and finding.kind == "call" and wrapper_fixable:
                val line_idx = finding.line_num - 1
                if line_idx >= 0 and line_idx < fix_lines.len():
                    val source_line = fix_lines[line_idx]
                    val name_col = finding.column - 1
                    val is_import = source_line.trim().starts_with("use ") or source_line.trim().starts_with("export ")
                    if name_col >= 0 and not is_import:
                        val byte_start = fix_line_starts[line_idx] + name_col
                        var fix = EasyFix.create(
                            "RAW-RT-002:{finding.line_num}:{name_col + 1}",
                            "replace direct `{finding.name}` call with in-scope `{wrapper}` wrapper",
                            FixConfidence.Safe
                        )
                        fix.add_replacement(Replacement.create(
                            path, byte_start, byte_start + finding.name.len(),
                            finding.line_num, name_col + 1, wrapper
                        ))
                        lint = lint.with_easy_fix(fix)
            self.results.push(LintRunResult.new(path, finding.line_num, finding.column, lint))

    me check_static_lint_rules(path: String, content: String):
        val run = run_static_lint_rule_table(
            LintParamsV1.defaults(), LintUnit(path, content), static_lint_rule_table())
        for failure in run.errors:
            val lint = LintDiag.new(failure, LintLevel.Deny, LintCategory.Correctness,
                "Static lint-rule registration was rejected")
            self.results.push(LintRunResult.new(path, 1, 0, lint))
        for finding in run.findings:
            val level = match finding.level:
                case Allow: LintLevel.Allow
                case Warn: LintLevel.Warn
                case Deny: LintLevel.Deny
            val category = match finding.category:
                case Safety: LintCategory.Safety
                case Correctness: LintCategory.Correctness
                case Style: LintCategory.Style
                case Warning: LintCategory.Warning
            val lint = LintDiag.new(finding.code, level, category, finding.message)
                .with_fix(finding.hint)
            self.results.push(LintRunResult.new(path, finding.line_num, finding.column, lint))

    # WM/GUI/web/2D portable-lane dependency boundary (WML001/WML002).
    #
    # OPT-IN ONLY, and the gate below is what makes "off" actually free: the
    # rule walks every module-level import of every in-scope file, so before
    # touching `content` at all it does a single O(1) override lookup. The
    # default level is "allow" and no profile promotes it, so the ONLY ways the
    # name appears in config.levels are an explicit simple.sdn [lints] entry,
    # --wm-lane, or --warn-all — each of which calls set_level. When it is off
    # this costs one dict probe per file and reads zero lines. Deliberately not
    # routed through get_level(), which rebuilds the whole defaults dict on
    # every call.
    me check_wm_lane_boundary(file_config: LintConfig, path: String, content: String):
        if not file_config.levels.has("wm_lane_boundary"):
            return
        match file_config.get_level("wm_lane_boundary"):
            case Allow:
                return
            case _:
                val _ = 0
        val warnings = lint_wm_lane_boundary(path, content)
        for warning in warnings:
            val lint = LintDiag.new(warning.code, LintLevel.Warn, LintCategory.Correctness, warning.message)
                .with_fix(warning.hint)
            self.results.push(LintRunResult.new(path, warning.line, 0, lint))

    me check_line(path: String, line_num: Int, line: String):
        val trimmed = line.trim()
        if trimmed == "":
            return

        # First-character dispatch to skip irrelevant branches early.
        # Most lines start with identifiers/keywords — only a few prefixes matter.
        val first = trimmed[0]

        if first == "v":
            # Check for unused variables (simple heuristic)
            if trimmed.starts_with("val ") and not trimmed.contains("="):
                val lint = LintDiag.new("W001", LintLevel.Warn, LintCategory.Warning,
                    "Variable declared but never assigned")
                    .with_fix("Remove declaration or assign a value")
                self.results.push(LintRunResult.new(path, line_num, 0, lint))

        if first == "f":
            # Check naming conventions for functions
            if trimmed.starts_with("fn "):
                val fn_name = self.extract_function_name(trimmed)
                if not self.is_snake_case(fn_name):
                    val lint = LintDiag.new("ST001", LintLevel.Allow, LintCategory.Style,
                        "Function name '{fn_name}' should be snake_case")
                        .with_fix("Rename to '{self.to_snake_case(fn_name)}'")
                    self.results.push(LintRunResult.new(path, line_num, 0, lint))

        if first == "c":
            if trimmed.starts_with("class "):
                val class_name = self.extract_class_name(trimmed)
                if not self.is_pascal_case(class_name):
                    val lint = LintDiag.new("ST002", LintLevel.Allow, LintCategory.Style,
                        "Class name '{class_name}' should be PascalCase")
                    self.results.push(LintRunResult.new(path, line_num, 0, lint))

        if first == "u":
            # Check unfold declaration (only in __init__.spl files)
            if trimmed.starts_with("unfold ") and trimmed.contains("{"):
                self.check_unfold_declaration(path, line_num, trimmed)

        if first == "#":
            if trimmed.starts_with("#["):
                val after = trimmed.substring(2, trimmed.len())
                var ne = 0
                while ne < after.len():
                    val ac = after.substring(ne, ne + 1)
                    val id = (ac >= "a" and ac <= "z") or (ac >= "A" and ac <= "Z") or (ac >= "0" and ac <= "9") or ac == "_"
                    if not id:
                        break
                    ne = ne + 1
                if ne > 0:
                    val aname = after.substring(0, ne)
                    if aname != "allow" and aname != "bypass":
                        val rest = after.substring(ne, after.len()).trim()
                        if rest.starts_with("]") or rest.starts_with("("):
                            val lint = LintDiag.new("DEPR005", LintLevel.Warn, LintCategory.Warning,
                                "'#[{aname}]' uses deprecated syntax, use '@{aname}' instead")
                                .with_fix("Replace '#[{aname}]' with '@{aname}'")
                            self.results.push(LintRunResult.new(path, line_num, 0, lint))

        # These checks examine content (comments, strings) — always run
        var normalized = trimmed.replace(" ", "")
        normalized = normalized.replace("\t", "")
        var has_production_pass_todo = false
        if normalized == "pass_todo":
            has_production_pass_todo = true
        if normalized.starts_with("pass_todo("):
            has_production_pass_todo = true
        if normalized.contains(":pass_todo"):
            has_production_pass_todo = true
        if normalized.contains("=pass_todo"):
            has_production_pass_todo = true
        if not is_test_like_file(path) and has_production_pass_todo:
            val lint = LintDiag.new("STUB003", LintLevel.Deny, LintCategory.Warning,
                "Explicit pass_todo placeholder in production code")
                .with_fix("Replace pass_todo with a real implementation or return an explicit unsupported error")
            self.results.push(LintRunResult.new(path, line_num, 0, lint))
        self.check_todo_format(path, line_num, trimmed)
        self.check_sdn_write(path, line_num, trimmed)

    fn extract_function_name(line: String) -> String:
        # Extract function name from "fn name(...)" pattern
        val parts = line.split("(")
        if parts.len() > 0:
            val name_part = parts[0].replace("fn ", "").trim()
            return name_part
        ""
    
    fn extract_class_name(line: String) -> String:
        # Extract class name from "class Name:" pattern
        val class_line = line.replace("class ", "")
        val parts = class_line.split(":")
        if parts.len() > 0:
            return parts[0].trim()
        ""
    
    fn is_snake_case(name: String) -> Bool:
        # Simple check: lowercase with underscores
        name == name.lower() and not name.contains("-")
    
    fn is_pascal_case(name: String) -> Bool:
        # Simple check: starts with uppercase
        if name.is_empty():
            return false
        # `String` has no `get(index)` method — calling it aborted the whole lint
        # run with "method `get` not found on type `str`" for any file declaring a
        # class (this is the only caller of is_pascal_case). Use slice+case
        # comparison instead: a non-cased first char (digit, `_`) has
        # upper() == lower(), so it correctly reports false rather than true.
        val first_char = name.slice(0, 1)
        first_char == first_char.upper() and first_char != first_char.lower()
    
    fn to_snake_case(name: String) -> String:
        # Convert to snake_case (simplified)
        name.lower()

    me check_todo_format(path: String, line_num: Int, line: String):
        # Check if line contains TODO or FIXME
        val has_todo = line.contains("TODO")
        val has_fixme = line.contains("FIXME")

        if not has_todo and not has_fixme:
            return

        val keyword = if has_fixme: "FIXME" else: "TODO"
        val idx = line.find(keyword)
        val after_keyword = line.slice(idx + keyword.len()).strip()

        # Check if it starts with : (standard format)
        if not after_keyword.starts_with(":"):
            return  # Not a standard comment format

        val content = after_keyword.slice(1).strip()

        # Check for new format: [area][priority]
        if not content.starts_with("["):
            # Missing format - provide an EasyFix
            var fix = EasyFix.create(
                id: "L:todo_format:{line_num}",
                description: "add [area][priority] format to {keyword} comment",
                confidence: FixConfidence.Uncertain
            )
            # Insert [runtime][P2] before the description text
            val colon_pos = line.find(keyword) + keyword.len() + 1
            fix.add_replacement(Replacement.create(
                file: path,
                start: colon_pos + 1,
                end: colon_pos + 1,
                line: line_num,
                column: colon_pos + 2,
                new_text: "[runtime][P2] "
            ))
            val lint = LintDiag.new("T001", LintLevel.Warn, LintCategory.Style,
                "TODO/FIXME missing [area][priority] format")
                .with_fix("Use: {keyword}: [area][P0-P3] description")
                .with_easy_fix(fix)
            self.results.push(LintRunResult.new(path, line_num, idx, lint))
            return

        # Parse [area][priority]
        val first_close = content.find("]")
        if first_close < 0:
            val lint = LintDiag.new("T001", LintLevel.Warn, LintCategory.Style,
                "TODO/FIXME has malformed [area] tag")
            self.results.push(LintRunResult.new(path, line_num, idx, lint))
            return

        val area = content.slice(1, first_close)

        # Validate area
        if not _todo_areas().contains(area):
            val lint = LintDiag.new("T002", LintLevel.Warn, LintCategory.Style,
                "TODO/FIXME has invalid area '{area}'")
                .with_fix("Valid areas: runtime, codegen, compiler, parser, type, stdlib, gpu, ui, test, driver, loader, pkg, sdn")
            self.results.push(LintRunResult.new(path, line_num, idx, lint))

        # Check for priority
        val after_area = content.slice(first_close + 1).strip()
        if not after_area.starts_with("["):
            val lint = LintDiag.new("T001", LintLevel.Warn, LintCategory.Style,
                "TODO/FIXME missing [priority] after [area]")
                .with_fix("Use: {keyword}: [{area}][P0-P3] description")
            self.results.push(LintRunResult.new(path, line_num, idx, lint))
            return

        val second_close = after_area.find("]")
        if second_close < 0:
            val lint = LintDiag.new("T001", LintLevel.Warn, LintCategory.Style,
                "TODO/FIXME has malformed [priority] tag")
            self.results.push(LintRunResult.new(path, line_num, idx, lint))
            return

        val priority = after_area.slice(1, second_close)

        # Validate priority
        if not _todo_priorities().contains(priority):
            val lint = LintDiag.new("T003", LintLevel.Warn, LintCategory.Style,
                "TODO/FIXME has invalid priority '{priority}'")
                .with_fix("Valid priorities: P0/critical, P1/high, P2/medium, P3/low")
            self.results.push(LintRunResult.new(path, line_num, idx, lint))

        # Check P0/critical requires issue number
        if priority == "P0" or priority == "critical":
            val rest = after_area.slice(second_close + 1)
            if not rest.contains("[#"):
                val lint = LintDiag.new("T004", LintLevel.Deny, LintCategory.Style,
                    "P0/critical TODO must have issue number")
                    .with_fix("Add issue: {keyword}: [{area}][{priority}] description [#123]")
                self.results.push(LintRunResult.new(path, line_num, idx, lint))

    me check_stale_md_diagrams(path: String, content: String):
        if not path.ends_with(".md"):
            return
        val lines = content.split("\n")
        var line_num = 1
        for line in lines:
            val trimmed = line.trim()
            if trimmed.starts_with("```sdn ") and trimmed.contains("hash="):
                val hash_idx = trimmed.index_of("hash=")
                if hash_idx >= 0:
                    val after_hash = trimmed.substring(hash_idx + 5, trimmed.len())
                    val space_idx = after_hash.index_of(" ")
                    var hash_val = after_hash
                    if space_idx > 0:
                        hash_val = after_hash.substring(0, space_idx)
                    if hash_val == "sha256:auto":
                        val lint = LintDiag.new("DIAG001", LintLevel.Warn, LintCategory.Correctness,
                            "SDN diagram has placeholder hash — run 'simple md-diagram-update'")
                            .with_fix("Run: simple md-diagram-update " + path)
                        self.results.push(LintRunResult.new(path, line_num, 0, lint))
            line_num = line_num + 1

    me check_llvm_backend_type_safety(path: String, content: String):
        if not path.contains("src/compiler/70.backend/backend/"):
            return
        val is_text_llvm = path.contains("MirToLlvm") or path.contains("mir_to_llvm_instructions.spl")
        val is_llvm_lib = path.contains("llvm_lib_translate")
        if not is_text_llvm and not is_llvm_lib:
            return
        val lines = content.split("\n")
        var line_num = 1
        for line in lines:
            val trimmed = line.trim()
            val returns_raw_type = (trimmed.contains("ret_ty = self.get_local_type(") or trimmed.contains("phi_ty = self.get_local_type("))
            if returns_raw_type and not trimmed.contains("valid_llvm_type("):
                val lint = LintDiag.new("LLVM001", LintLevel.Deny, LintCategory.Correctness,
                    "LLVM result type is read from local metadata without valid_llvm_type guard")
                    .with_fix("Wrap the local type in valid_llvm_type before emitting LLVM call/phi/result text")
                self.results.push(LintRunResult.new(path, line_num, 0, lint))
            val maps_raw_signature_return = (trimmed.contains("llvm_type_text(sig.return_type)") or trimmed.contains("type_mapper.map_type(sig.return_type)") or trimmed.contains("tm.map_type(sig.return_type)"))
            val missing_signature_nil_guard = not trimmed.contains("sig.return_type == nil")
            val missing_text_llvm_guard = is_text_llvm and not trimmed.contains("valid_llvm_type(")
            if maps_raw_signature_return and (missing_signature_nil_guard or missing_text_llvm_guard):
                val lint = LintDiag.new("LLVM001", LintLevel.Deny, LintCategory.Correctness,
                    "LLVM signature return type is mapped without an explicit nil/valid type guard")
                    .with_fix("Guard nil signature returns explicitly and validate mapped LLVM result types")
                self.results.push(LintRunResult.new(path, line_num, 0, lint))
            val maps_raw_bootstrap_result = (trimmed.contains("llvm_type_text(body.return_ty)") or trimmed.contains("llvm_type_text(signature.return_type)") or trimmed.contains("llvm_type_text(ret)"))
            if is_text_llvm and maps_raw_bootstrap_result:
                val lint = LintDiag.new("LLVM001", LintLevel.Deny, LintCategory.Correctness,
                    "LLVM result type metadata is mapped without an explicit nil/valid type guard")
                    .with_fix("Guard nil result types explicitly and validate mapped LLVM result types")
                self.results.push(LintRunResult.new(path, line_num, 0, lint))
            line_num = line_num + 1
