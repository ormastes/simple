# Simple Language Linter
# Semantic lints for code quality and safety
# Usage: simple_lint <file.spl> [--deny-all] [--warn-all]

# Valid TODO areas and priorities
fn _todo_areas() -> [text]:
    ["runtime", "codegen", "compiler", "parser", "type",
     "stdlib", "gpu", "ui", "test", "driver", "loader", "pkg", "sdn"]

fn _todo_priorities() -> [text]:
    ["P0", "P1", "P2", "P3", "critical", "high", "medium", "low"]


fn lint_rule_code_from_easyfix_id(id: text) -> text:
    """Extract the lint rule code from an EasyFix id without array splitting.
    `L:<code>:<n>` / `E:<code>:<n>` -> `<code>`; `<code>:<n>` -> `<code>`;
    an id with no `:` is returned unchanged."""
    val first = id.find(":")
    if first <= 0:
        return id
    if not id.starts_with("L:") and not id.starts_with("E:"):
        return id.slice(0, first)
    val code_start = first + 1
    var code_end = code_start
    while code_end < id.len() and id.slice(code_end, code_end + 1) != ":":
        code_end = code_end + 1
    if code_end == code_start:
        return id
    id.slice(code_start, code_end)

fn lint_line_from_easyfix_id(id: text) -> i64:
    """Line number carried in an EasyFix id suffix (`L:<code>:<n>` -> n); 1 when
    absent. Locates diagnostic-only fixes that have no replacement to read."""
    var start = id.byte_len()
    while start > 0 and id.slice(start - 1, start) >= "0" and id.slice(start - 1, start) <= "9":
        start = start - 1
    if start == id.byte_len() or start == 0 or id.slice(start - 1, start) != ":":
        return 1
    val line = id.slice(start, id.byte_len()).to_int()
    if line < 1: 1 else: line

fn lint_line_may_contain_pass_todo(value: text) -> bool:
    """Match pass_todo in the virtual stream formed by deleting ASCII space/tab."""
    val target = "pass_todo"
    val target_len = target.byte_len()
    val target_first = target.byte_at(0)
    val value_len = value.byte_len()
    var start = 0
    while start < value_len:
        if value.byte_at(start) == target_first:
            var source_at = start + 1
            var target_at = 1
            while source_at < value_len and target_at < target_len:
                val byte = value.byte_at(source_at)
                source_at = source_at + 1
                if byte == 32 or byte == 9:
                    continue
                if byte != target.byte_at(target_at):
                    break
                target_at = target_at + 1
            if target_at == target_len: return true
        start = start + 1
    false

