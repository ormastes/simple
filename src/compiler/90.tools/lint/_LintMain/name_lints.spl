# Accessor / parent-name lint warnings.
use compiler.tools.lint.main.*

class NameLintWarning:
    code: String
    line: Int
    message: String
    hint: String

class NameLintMethod:
    class_name: String
    parent_name: String
    name: String
    line: Int
    params: [String]
    body: [String]
    name_checked: Bool

class NameLintClass:
    name: String
    parent_name: String
    indent: Int
    line: Int
    methods: [NameLintMethod]

class NameLintClassIndex:
    classes: [NameLintClass]
    first_by_name: Dict<String, Int>

class NameLintInherited:
    names: [String]
    by_name: Dict<String, Bool>

class NameLintParsedMethod:
    method: NameLintMethod
    next_index: Int

fn lint_accessor_and_parent_names(path: String, content: String) -> [NameLintWarning]:
    lint_accessor_and_parent_names_lines(path, content.split("\n"))

fn lint_accessor_and_parent_names_lines(
    path: String, lines: [String]
) -> [NameLintWarning]:
    val classes = name_lint_collect_classes_lines(lines)
    val index = name_lint_build_class_index(classes)
    var warnings: [NameLintWarning] = []
    for class_info in classes:
        # Both rule families consume the same ancestry. Build it once per
        # class; the former path repeated class scans and growing-array dedup.
        val inherited = name_lint_inherited_methods(class_info, index)
        for warning in name_lint_dummy_accessor_warnings_inherited(
            path, class_info, inherited):
            warnings.push(warning)
        for warning in name_lint_similar_parent_method_name_warnings_inherited(
            path, class_info, inherited):
            warnings.push(warning)
    warnings

fn name_lint_collect_classes(content: String) -> [NameLintClass]:
    name_lint_collect_classes_lines(content.split("\n"))

fn name_lint_collect_classes_lines(lines: [String]) -> [NameLintClass]:
    var classes: [NameLintClass] = []
    var i = 0
    while i < lines.len():
        val line = lines[i]
        val trimmed = line.trim()
        if trimmed == "" or trimmed.starts_with("#"):
            i = i + 1
            continue

        val indent = indent_width(line)
        if trimmed.starts_with("class "):
            # Own the in-progress class locally and append it once. This avoids
            # repeated indexed write-back and backend-dependent nested
            # collection detach behavior after every parsed method.
            var class_info = name_lint_parse_class(trimmed, indent, i + 1)
            i = i + 1
            while i < lines.len():
                val member_line = lines[i]
                val member_trimmed = member_line.trim()
                if member_trimmed == "" or member_trimmed.starts_with("#"):
                    i = i + 1
                    continue
                # A nested textual class replaced current_class in the former
                # scanner. Stop without consuming it so it becomes the next
                # independently collected class and the outer class is not
                # resumed after its body.
                if member_trimmed.starts_with("class "):
                    break
                if indent_width(member_line) <= class_info.indent:
                    break
                if name_lint_is_method_header(member_trimmed):
                    val parsed = name_lint_parse_method_with_end(
                        lines, i, class_info.name, class_info.parent_name)
                    class_info.methods.push(parsed.method)
                    i = parsed.next_index
                    continue
                i = i + 1
            classes.push(class_info)
            continue

        i = i + 1
    classes

fn name_lint_build_class_index(classes: [NameLintClass]) -> NameLintClassIndex:
    var first_by_name: Dict<String, Int> = {}
    var i = 0
    while i < classes.len():
        # Preserve name_lint_find_class's first-definition semantics.
        if not first_by_name.has(classes[i].name):
            first_by_name[classes[i].name] = i
        i = i + 1
    NameLintClassIndex(classes: classes, first_by_name: first_by_name)

fn name_lint_parse_class(trimmed: String, indent: Int, line_num: Int) -> NameLintClass:
    var rest = trimmed.slice(6).trim()
    if rest.ends_with(":"):
        rest = rest.slice(0, rest.len() - 1).trim()
    var name = rest
    var parent_name = ""
    val extends_pos = rest.find(" extends ")
    if extends_pos >= 0:
        name = rest.slice(0, extends_pos).trim()
        parent_name = rest.slice(extends_pos + 9).trim()
    else:
        val paren_pos = rest.find("(")
        val close_pos = rest.find(")")
        if paren_pos >= 0 and close_pos > paren_pos:
            name = rest.slice(0, paren_pos).trim()
            parent_name = rest.slice(paren_pos + 1, close_pos).trim()
    NameLintClass(name: name, parent_name: parent_name, indent: indent, line: line_num, methods: [])

fn name_lint_is_method_header(trimmed: String) -> Bool:
    trimmed.starts_with("fn ") or trimmed.starts_with("me ") or trimmed.starts_with("static fn ")

fn name_lint_parse_method(lines: [String], index: Int, class_name: String, parent_name: String) -> NameLintMethod:
    name_lint_parse_method_with_end(lines, index, class_name, parent_name).method

fn name_lint_parse_method_with_end(
    lines: [String], index: Int, class_name: String, parent_name: String
) -> NameLintParsedMethod:
    val line = lines[index]
    val trimmed = line.trim()
    val method_indent = indent_width(line)
    val name = name_lint_extract_method_name(trimmed)
    val params = name_lint_extract_params(trimmed)
    val name_checked = name_lint_has_name_checked_decorator(lines, index, method_indent)
    var body: [String] = []
    var j = index + 1
    while j < lines.len():
        val body_line = lines[j]
        val body_trimmed = body_line.trim()
        if body_trimmed != "" and not body_trimmed.starts_with("#") and indent_width(body_line) <= method_indent:
            break
        if body_trimmed != "" and not body_trimmed.starts_with("#"):
            body.push(body_trimmed)
        j = j + 1
    val method = NameLintMethod(
        class_name: class_name,
        parent_name: parent_name,
        name: name,
        line: index + 1,
        params: params,
        body: body,
        name_checked: name_checked
    )
    NameLintParsedMethod(method: method, next_index: j)

fn name_lint_method_body_end(lines: [String], index: Int) -> Int:
    val method_indent = indent_width(lines[index])
    var j = index + 1
    while j < lines.len():
        val trimmed = lines[j].trim()
        if trimmed != "" and not trimmed.starts_with("#") and indent_width(lines[j]) <= method_indent:
            break
        j = j + 1
    j

fn name_lint_extract_method_name(trimmed: String) -> String:
    var rest = trimmed
    if rest.starts_with("static fn "):
        rest = rest.slice(10).trim()
    elif rest.starts_with("fn "):
        rest = rest.slice(3).trim()
    elif rest.starts_with("me "):
        rest = rest.slice(3).trim()
    val paren = rest.find("(")
    if paren >= 0:
        return rest.slice(0, paren).trim()
    rest.split(" ")[0].trim()

fn name_lint_extract_params(trimmed: String) -> [String]:
    var params: [String] = []
    val start = trimmed.find("(")
    val end = trimmed.find(")")
    if start < 0 or end <= start:
        return params
    val raw = trimmed.slice(start + 1, end).trim()
    if raw == "":
        return params
    for part in raw.split(","):
        var name = part.trim()
        val colon = name.find(":")
        if colon >= 0:
            name = name.slice(0, colon).trim()
        val equal = name.find("=")
        if equal >= 0:
            name = name.slice(0, equal).trim()
        if name != "":
            params.push(name)
    params

fn name_lint_has_name_checked_decorator(lines: [String], index: Int, method_indent: Int) -> Bool:
    var j = index - 1
    while j >= 0:
        val trimmed = lines[j].trim()
        if trimmed == "" or trimmed.starts_with("#"):
            j = j - 1
            continue
        if indent_width(lines[j]) != method_indent:
            return false
        return trimmed == "@name_checked" or trimmed.starts_with("@name_checked(")
    false

fn name_lint_dummy_accessor_warnings(path: String, class_info: NameLintClass, classes: [NameLintClass]) -> [NameLintWarning]:
    name_lint_dummy_accessor_warnings_inherited(
        path, class_info,
        name_lint_inherited_methods(class_info, name_lint_build_class_index(classes)))

fn name_lint_dummy_accessor_warnings_inherited(
    path: String, class_info: NameLintClass, inherited: NameLintInherited
) -> [NameLintWarning]:
    var warnings: [NameLintWarning] = []
    var suffixes: [String] = []
    var suffix_index: Dict<String, Int> = {}
    var suffix_has_real: [Bool] = []
    var group_head: [Int] = []
    var group_tail: [Int] = []
    var next_method: [Int] = []
    var method_index = 0
    while method_index < class_info.methods.len():
        val method = class_info.methods[method_index]
        val suffix = name_lint_accessor_suffix(method.name)
        next_method.push(-1)
        if suffix == "":
            method_index = method_index + 1
            continue
        var group = -1
        if suffix_index.has(suffix):
            group = suffix_index[suffix]
        else:
            group = suffixes.len()
            suffix_index[suffix] = group
            suffixes.push(suffix)
            suffix_has_real.push(false)
            group_head.push(-1)
            group_tail.push(-1)

        if group_head[group] < 0:
            group_head[group] = method_index
        else:
            next_method[group_tail[group]] = method_index
        group_tail[group] = method_index
        if not name_lint_is_dummy_accessor(method, suffix):
            suffix_has_real[group] = true
        method_index = method_index + 1

    var group = 0
    while group < suffixes.len():
        if suffix_has_real[group]:
            group = group + 1
            continue
        val suffix = suffixes[group]
        var member = group_head[group]
        while member >= 0:
            val method = class_info.methods[member]
            member = next_method[member]
            if inherited.by_name.has(method.name):
                continue
            if name_lint_is_dummy_accessor(method, suffix):
                var transform = "replace calls `obj.{method.name}()` with the varname access `obj.{suffix}`"
                if method.name.starts_with("set_"):
                    transform = "replace calls `obj.{method.name}(v)` with the assignment `obj.{suffix} = v`"
                warnings.push(NameLintWarning(
                    code: "ACC001",
                    line: method.line,
                    message: "accessor '{method.name}' only forwards backing field '{suffix}' without behavior",
                    hint: "{transform}, then delete the wrapper. Auto-fix: `SIMPLE_EXECUTION_MODE=interpret bin/simple run src/compiler/90.tools/fix/accessor_fix_main.spl --apply`. Or add real validation/normalization behavior to justify keeping it."
                ))
        group = group + 1
    warnings

fn name_lint_similar_parent_method_name_warnings(path: String, class_info: NameLintClass, classes: [NameLintClass]) -> [NameLintWarning]:
    name_lint_similar_parent_method_name_warnings_inherited(
        path, class_info,
        name_lint_inherited_methods(class_info, name_lint_build_class_index(classes)))

fn name_lint_similar_parent_method_name_warnings_inherited(
    path: String, class_info: NameLintClass, inherited: NameLintInherited
) -> [NameLintWarning]:
    var warnings: [NameLintWarning] = []
    if inherited.names.len() == 0:
        return warnings
    for method in class_info.methods:
        if method.name_checked or inherited.by_name.has(method.name):
            continue
        for parent_name in inherited.names:
            if name_lint_accessor_prefix_collision_expected(method.name, parent_name):
                continue
            if name_lint_likely_misspelling(method.name, parent_name):
                warnings.push(NameLintWarning(
                    code: "NAME001",
                    line: method.line,
                    message: "method '{method.name}' is similar to inherited method '{parent_name}' and may be a misspelled override",
                    hint: "Rename to '{parent_name}' or add @name_checked above the method if the near-match is intentional"
                ))
                break
    warnings

fn name_lint_accessor_suffix(name: String) -> String:
    if name.starts_with("get_") and name.len() > 4:
        return name.slice(4)
    if name.starts_with("set_") and name.len() > 4:
        return name.slice(4)
    if name.starts_with("is_") and name.len() > 3:
        return name.slice(3)
    ""

fn name_lint_is_dummy_accessor(method: NameLintMethod, suffix: String) -> Bool:
    if method.body.len() != 1:
        return false
    val stmt = name_lint_normalize(method.body[0])
    if method.name.starts_with("get_") or method.name.starts_with("is_"):
        return stmt == "self.{suffix}" or stmt == "me.{suffix}" or stmt == "returnself.{suffix}" or stmt == "returnme.{suffix}"
    if method.name.starts_with("set_"):
        val value_param = name_lint_first_value_param(method.params)
        if value_param == "":
            return false
        return stmt == "self.{suffix}={value_param}" or stmt == "me.{suffix}={value_param}"
    false

fn name_lint_first_value_param(params: [String]) -> String:
    for param in params:
        if param != "self" and param != "me":
            return param
    ""

fn name_lint_normalize(value: String) -> String:
    var out = value.replace(" ", "")
    out = out.replace("\t", "")
    out

fn name_lint_inherited_method_names(class_info: NameLintClass, classes: [NameLintClass]) -> [String]:
    name_lint_inherited_methods(
        class_info, name_lint_build_class_index(classes)).names

fn name_lint_inherited_methods(
    class_info: NameLintClass, index: NameLintClassIndex
) -> NameLintInherited:
    var inherited: [String] = []
    var by_name: Dict<String, Bool> = {}
    var parent_name = class_info.parent_name
    var depth = 0
    while parent_name != "" and depth < 20:
        if not index.first_by_name.has(parent_name):
            break
        val parent_class = index.classes[index.first_by_name[parent_name]]
        for method in parent_class.methods:
            if not by_name.has(method.name):
                by_name[method.name] = true
                inherited.push(method.name)
        parent_name = parent_class.parent_name
        depth = depth + 1
    NameLintInherited(names: inherited, by_name: by_name)

fn name_lint_find_class(classes: [NameLintClass], name: String) -> Int:
    var i = 0
    while i < classes.len():
        if classes[i].name == name:
            return i
        i = i + 1
    -1

fn name_lint_accessor_prefix_collision_expected(a: String, b: String) -> Bool:
    val a_suffix = name_lint_accessor_suffix(a)
    val b_suffix = name_lint_accessor_suffix(b)
    if a_suffix == "" or b_suffix == "":
        return false
    if a_suffix != b_suffix:
        return false
    name_lint_accessor_prefix(a) != name_lint_accessor_prefix(b)

fn name_lint_accessor_prefix(name: String) -> String:
    if name.starts_with("get_"):
        return "get"
    if name.starts_with("set_"):
        return "set"
    if name.starts_with("is_"):
        return "is"
    ""

fn name_lint_likely_misspelling(candidate: String, inherited: String) -> Bool:
    if candidate == inherited:
        return false
    val candidate_len = candidate.len()
    val inherited_len = inherited.len()
    val max_len = if candidate_len > inherited_len: candidate_len else: inherited_len
    if max_len < 4:
        return false
    val threshold = if max_len >= 9: 2 else: 1
    name_lint_bounded_damerau_levenshtein(candidate, inherited, threshold) <= threshold

fn name_lint_bounded_damerau_levenshtein(a: String, b: String, limit: Int) -> Int:
    val a_len = a.len()
    val b_len = b.len()
    if name_lint_abs(a_len - b_len) > limit:
        return limit + 1

    val inf = limit + 1
    val width = limit * 2 + 1
    var cells: [Int] = []
    var cell_count = 0
    while cell_count < width * 3:
        cells.push(inf)
        cell_count = cell_count + 1

    var prev_prev_row = 0
    var prev_row = 1
    var curr_row = 2
    var prev_prev_start = 0
    var prev_prev_end = -1
    var prev_start = 0
    var prev_end = b_len
    if prev_end > limit:
        prev_end = limit
    var j0 = 0
    while j0 <= prev_end:
        cells[prev_row * width + (j0 - prev_start)] = j0
        j0 = j0 + 1

    var i = 1
    while i <= a_len:
        var curr_start = i - limit
        if curr_start < 0:
            curr_start = 0
        var curr_end = i + limit
        if curr_end > b_len:
            curr_end = b_len
        var j = curr_start
        while j <= curr_end:
            if j == 0:
                cells[curr_row * width + (j - curr_start)] =
                    if i > inf: inf else: i
                j = j + 1
                continue
            val cost = if a.byte_at(i - 1) == b.byte_at(j - 1): 0 else: 1
            val deletion = name_lint_band_cell_get(
                cells, prev_row, width, prev_start, prev_end, j, inf) + 1
            val insertion = name_lint_band_cell_get(
                cells, curr_row, width, curr_start, curr_end,
                j - 1, inf) + 1
            val substitution = name_lint_band_cell_get(
                cells, prev_row, width, prev_start, prev_end,
                j - 1, inf) + cost
            var best = name_lint_min3(deletion, insertion, substitution)
            if i > 1 and j > 1:
                if a.byte_at(i - 1) == b.byte_at(j - 2) and a.byte_at(i - 2) == b.byte_at(j - 1):
                    val swapped = name_lint_band_cell_get(
                        cells, prev_prev_row, width,
                        prev_prev_start, prev_prev_end,
                        j - 2, inf) + 1
                    if swapped < best:
                        best = swapped
            if best > inf:
                best = inf
            cells[curr_row * width + (j - curr_start)] = best
            j = j + 1
        val reusable_row = prev_prev_row
        prev_prev_row = prev_row
        prev_row = curr_row
        curr_row = reusable_row
        prev_prev_start = prev_start
        prev_prev_end = prev_end
        prev_start = curr_start
        prev_end = curr_end
        i = i + 1
    name_lint_band_cell_get(
        cells, prev_row, width, prev_start, prev_end, b_len, inf)

fn name_lint_band_cell_get(
    cells: [Int], row: Int, width: Int,
    start: Int, end: Int, column: Int, inf: Int
) -> Int:
    if column < start or column > end:
        return inf
    cells[row * width + (column - start)]

fn name_lint_abs(value: Int) -> Int:
    if value < 0:
        return 0 - value
    value

fn name_lint_min3(a: Int, b: Int, c: Int) -> Int:
    var best = a
    if b < best:
        best = b
    if c < best:
        best = c
    best
