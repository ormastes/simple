# Header Generation Utilities
#
# Shared helper functions used by both C and C++ header generators.

use compiler.mir.mir_data.{MirFunction, MirType, mir_signature_params}

fn to_guard_name(lib_name: text) -> text:
    var result = lib_name.upper()
    result = result.replace("-", "_")
    result = result.replace(".", "_")
    result = result.replace(" ", "_")
    result

fn sanitize_c_name(name: text) -> text:
    var s = name.replace("<", "_")
    s = s.replace(">", "")
    s = s.replace(",", "_")
    s = s.replace(" ", "")
    s = s.replace("::", "_")
    s

fn mir_function_params(func: MirFunction) -> [MirType]:
    mir_signature_params(func.signature)

fn mir_function_param_count(func: MirFunction) -> i64:
    mir_function_params(func).len()

fn mir_function_param(func: MirFunction, idx: i64) -> MirType:
    mir_function_params(func)[idx]
