# Flight-rule baseline census — WP-2 of the aerospace hardening plan.
#
# Plan: doc/03_plan/language/assurance/aerospace_hardening_plan_2026-08-07.md
# Registry: src/compiler/00.common/assurance/flight_rules.spl (flight-core-v1,
# 32 `FLT-*` rules, WP-0).
#
# WHAT THIS IS: a read-only, reproducible census of the current repo against
# the flight-core-v1 rule set. It does NOT invoke `bin/simple lint` — the
# deployed lint binary predates its own source (plan premise #0.2) and is not
# a valid oracle here. This scanner does its own independent text-based scan
# over owned-code `.spl` source, the same tier of honesty as the precedent
# scanner (`noalloc_manifest_scan.spl`): a text/line-based fact extractor, not
# an AST/HIR/MIR pass.
#
# WHAT THIS DELIBERATELY DOES NOT DO: it does not fix anything, and it does
# not claim to check rules it cannot mechanically check. Per rule, this
# scanner reports exactly one of three verdicts:
#
#   - "intrinsic"   — critical_level == Intrinsic. The language cannot express
#                     the violation (no goto, no inheritance). Zero sites by
#                     construction; not a coverage claim.
#   - "checked"     — this scanner implements a real, independent text
#                     detector for the rule and reports actual comply/violate
#                     counts over owned code.
#   - "uncheckable" — no detector exists in this scanner today. This is a
#                     REAL, STATED enforcement gap, not a silent omission and
#                     not counted as compliant. (Mirrors flight_rules.spl's
#                     own `is_enforcement_gap()` discriminator.)
#
# Today exactly two rules are "checked": FLT-IMP-001 (placeholder body in a
# concrete function) and FLT-IMP-002 (deviating code needs a substantive
# rationale) — the same two rules flight_rules.spl documents as having a live
# analyzer in production lint (premises 12b/13), reimplemented here
# independently so the census does not depend on lint binary freshness.
#
# FLT-IMP-002 COVERAGE LIMIT, STATED: this scanner only evaluates the
# rationale-comment predicate for a site it already flagged as an FLT-IMP-001
# placeholder. Production REQC001 (premise 12b) checks required comments more
# broadly (any function needing a rationale, not only placeholder bodies), so
# FLT-IMP-002's count here is a strict subset of what REQC001 covers, not an
# independent measurement. This is a deliberate, narrower reading, not a
# hidden gap — do not read the FLT-IMP-002 count as REQC001-equivalent.
#
# SCOPE: `src/**/*.spl`, excluding vendored/third-party runtime source per
# CLAUDE.md "Owned-Code Scope":
#   src/compiler_rust/vendor/**, src/runtime/vendor/**,
#   src/runtime/miniaudio.h, src/runtime/stb_image.h, src/runtime/stb_truetype.h
# (the last three are not .spl, so they are excluded from this scan by file
# extension alone; the two vendor directory prefixes are excluded explicitly.)
# Only `src/` is scanned — not `test/`, `scripts/`, `doc/` — so the coverage
# fraction below is against product source, not the whole repo. That is a
# stated scope limit, not a hidden one.

use compiler.common.assurance.flight_rules.{flight_rules, FlightRuleV1, RuleLevel}
use std.nogc_sync_mut.io.dir_ops.{dir_walk}
use std.nogc_sync_mut.io.file_ops.{file_read}

val SCAN_ROOT = "src"
val VENDOR_PREFIXES = ["src/compiler_rust/vendor/", "src/runtime/vendor/"]

val FILLER_WORDS = ["todo", "fix", "later", "unknown", "because", "na"]

pub struct CensusSite:
    """One scanned finding for a checkable rule: which rule, which site, and
    whether it complies or violates.
    """
    rule_id: text
    path: text
    fn_name: text
    line: i64
    verdict: text  # "comply" | "violate"
    detail: text

struct RuleCensus:
    """Aggregated census for one rule."""
    rule_id: text
    classification: text  # "intrinsic" | "checked" | "uncheckable"
    comply: i64
    violate: i64
    reason: text  # populated for "intrinsic" and "uncheckable"

struct CensusReport:
    files_scanned: i64
    functions_scanned: i64
    rules: [RuleCensus]
    sites: [CensusSite]

fn is_excluded(path: text) -> bool:
    for prefix in VENDOR_PREFIXES:
        if path.starts_with(prefix):
            return true
    false

fn _indent_of(line: text) -> i64:
    var n = 0
    while n < line.len() and line[n:n + 1] == " ":
        n = n + 1
    n

fn _is_fn_decl(line: text) -> bool:
    val t = line.trim()
    t.starts_with("fn ") or t.starts_with("me ") or t.starts_with("static fn ")

fn _fn_name(line: text) -> text:
    val t = line.trim()
    var rest = t
    if rest.starts_with("static fn "):
        rest = rest[10:rest.len()]
    else if rest.starts_with("me fn "):
        rest = rest[6:rest.len()]
    else if rest.starts_with("fn "):
        rest = rest[3:rest.len()]
    else if rest.starts_with("me "):
        rest = rest[3:rest.len()]
    var idx = 0
    while idx < rest.len() and rest[idx:idx + 1] != "(":
        idx = idx + 1
    rest[0:idx]

fn _paren_delta(line: text) -> i64:
    """Net change in open-paren depth contributed by this line (naive: does
    not account for parens inside string/text literals or comments — stated
    limitation, same tier as the rest of this text-based scan)."""
    var delta = 0
    var i = 0
    while i < line.len():
        val ch = line[i:i + 1]
        if ch == "(":
            delta = delta + 1
        else if ch == ")":
            delta = delta - 1
        i = i + 1
    delta

fn _is_comment_line(trimmed: text) -> bool:
    trimmed.starts_with("#")

fn _is_placeholder_stmt(trimmed: text) -> bool:
    """A single body statement recognized as a placeholder: the bare `pass`
    keyword, or a call to one of the placeholder-marker helpers named in
    premise 12b/13 (a "todo" marker, a "do-nothing" marker, or a "deny"
    marker), matched below by exact prefix/name.
    NOT detected (stated coverage limit, not a silent gap): a fabricated
    `Ok(nil)`/similar disguised-success return, and a `_noop_`-named function
    with a real-looking but vacuous body — both need semantic, not textual,
    detection and are left "uncheckable" in that shape.
    """
    if trimmed == "pass":
        return true
    if trimmed.starts_with("pass_todo(") or trimmed == "pass_todo":
        return true
    if trimmed.starts_with("pass_dn(") or trimmed == "pass_dn":
        return true
    if trimmed.starts_with("pass_do_nothing(") or trimmed == "pass_do_nothing":
        return true
    if trimmed.starts_with("todo(") or trimmed == "todo":
        return true
    false

fn _rationale_comment(lines: [text], header_index: i64) -> text:
    """Collect the comment block immediately above the function header (no
    blank-line gap), concatenated. Returns "" if there is none.
    """
    var parts: [text] = []
    var i = header_index - 1
    while i >= 0:
        val trimmed = lines[i].trim()
        if trimmed == "":
            break
        if not _is_comment_line(trimmed):
            break
        parts.push(trimmed[1:trimmed.len()].trim())
        i = i - 1
    if parts.len() == 0:
        return ""
    var out = ""
    var j = parts.len() - 1
    while j >= 0:
        out = out + parts[j] + " "
        j = j - 1
    out.trim()

fn _char_eq_ci(ch: text, lower_target: text) -> bool:
    """True if `ch` equals `lower_target` (a single lowercase ASCII letter),
    case-insensitively. Avoids `.to_lower()` on purpose: the real driver runs
    under `bin/simple run` (Cranelift JIT), where `.to_upper()` is a
    documented silent no-op (run_vs_test_harness_divergence_2026-07-28.md);
    `.to_lower()` is not proven safe there either, so this scanner never
    calls it.
    """
    if ch == lower_target:
        return true
    if ch >= "A" and ch <= "Z":
        return ch.char_code_at(0) - 32 == lower_target.char_code_at(0)
    false

fn _word_eq_ci(word: text, lower_target: text) -> bool:
    if word.len() != lower_target.len():
        return false
    var i = 0
    while i < word.len():
        if not _char_eq_ci(word[i:i + 1], lower_target[i:i + 1]):
            return false
        i = i + 1
    true

fn _extract_words(text_in: text) -> [text]:
    """Alpha-only word tokens, so filler-word matching is whole-word, not a
    substring match (a substring match on "na" or "fix" false-positives on
    ordinary words like "final", "prefix", "unavailable")."""
    var words: [text] = []
    var current = ""
    var i = 0
    while i < text_in.len():
        val ch = text_in[i:i + 1]
        val is_alpha = (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z")
        if is_alpha:
            current = current + ch
        else:
            if current != "":
                words.push(current)
            current = ""
        i = i + 1
    if current != "":
        words.push(current)
    words

fn _is_weak_rationale(comment: text) -> bool:
    """Same predicate the live REQC001 text checker uses (premise 12b):
    empty, under 10 characters, or a filler word — matched whole-word and
    case-insensitively, not as a raw substring.
    """
    val c = comment.trim()
    if c == "":
        return true
    if c.len() < 10:
        return true
    if c.contains("n/a"):
        return true
    for word in _extract_words(c):
        for filler in FILLER_WORDS:
            if _word_eq_ci(word, filler):
                return true
    false

fn scan_file_functions(path: text, content: text) -> ([CensusSite], i64):
    """Scan one file's functions for FLT-IMP-001/002. Returns (sites,
    inspected_count). Arrays are value types in this language — a `[T]`
    parameter mutated inside a callee does NOT propagate to the caller — so
    findings are built in a local list and returned, matching the precedent
    scanner's `scan_noalloc_functions` shape, not passed in and mutated.
    `inspected_count` excludes declarations with no body at all
    (abstract/trait signatures); they carry nothing to check.
    """
    var sites: [CensusSite] = []
    val lines = content.split("\n")
    var inspected = 0
    var i = 0
    while i < lines.len():
        val line = lines[i]
        if _is_fn_decl(line):
            val header_index = i
            val name = _fn_name(line)
            val header_indent = _indent_of(line)

            # A wrapped multi-line signature (open params spanning several
            # lines, e.g. flight_rules.spl's `mk(...)`) must be consumed as
            # part of the header, not the body — otherwise its continuation
            # lines (indent > 0 but part of the signature, not a statement)
            # get misread as body statements, hiding a real placeholder body
            # or manufacturing a false "real body" verdict. Track paren depth
            # from the header line onward until it returns to 0.
            var depth = _paren_delta(line)
            var header_end = i
            while depth > 0 and header_end + 1 < lines.len():
                header_end = header_end + 1
                depth = depth + _paren_delta(lines[header_end])

            var body_lines: [text] = []
            var j = header_end + 1
            while j < lines.len():
                val body_line = lines[j]
                val body_trim = body_line.trim()
                if body_trim != "" and _indent_of(body_line) <= header_indent:
                    break
                body_lines.push(body_line)
                j = j + 1

            # Skip leading blank/comment lines to find the first real
            # statement, and skip a leading docstring block if present.
            var k = 0
            if k < body_lines.len() and body_lines[k].trim().starts_with('"""'):
                # docstring: skip to its close (or end of body)
                k = k + 1
                if not body_lines[k - 1].trim().ends_with('"""') or body_lines[k - 1].trim() == '"""':
                    while k < body_lines.len() and not body_lines[k].trim().ends_with('"""'):
                        k = k + 1
                    if k < body_lines.len():
                        k = k + 1
            var stmt_lines: [text] = []
            while k < body_lines.len():
                val t = body_lines[k].trim()
                if t != "" and not _is_comment_line(t):
                    stmt_lines.push(t)
                k = k + 1

            # A bodiless declaration (abstract/trait signature) followed by a
            # blank line still pushes "" into body_lines, so "body_lines is
            # non-empty" alone is NOT proof of a real body — require at least
            # one non-blank line (statement OR comment) actually indented
            # under the header.
            var has_body_block = false
            for bl in body_lines:
                if bl.trim() != "":
                    has_body_block = true
            if has_body_block:
                inspected = inspected + 1
                var is_placeholder = false
                if stmt_lines.len() == 0:
                    is_placeholder = true
                else if stmt_lines.len() == 1 and _is_placeholder_stmt(stmt_lines[0]):
                    is_placeholder = true

                if is_placeholder:
                    sites.push(CensusSite(
                        rule_id: "FLT-IMP-001", path: path, fn_name: name,
                        line: header_index + 1, verdict: "violate",
                        detail: "placeholder or empty body"))
                    val rationale = _rationale_comment(lines, header_index)
                    if _is_weak_rationale(rationale):
                        sites.push(CensusSite(
                            rule_id: "FLT-IMP-002", path: path, fn_name: name,
                            line: header_index + 1, verdict: "violate",
                            detail: "missing or weak rationale comment"))
                    else:
                        sites.push(CensusSite(
                            rule_id: "FLT-IMP-002", path: path, fn_name: name,
                            line: header_index + 1, verdict: "comply",
                            detail: "substantive rationale present"))
                else:
                    sites.push(CensusSite(
                        rule_id: "FLT-IMP-001", path: path, fn_name: name,
                        line: header_index + 1, verdict: "comply",
                        detail: "real body"))
            i = j
            continue
        i = i + 1
    (sites, inspected)

fn classify_rule(rule: FlightRuleV1) -> (text, text):
    """Returns (classification, reason). reason is populated for
    intrinsic/uncheckable; empty for checked.
    """
    match rule.critical_level:
        RuleLevel.Intrinsic:
            return ("intrinsic", "language cannot express the violation — no analyzer needed")
        _:
            pass_do_nothing("non-symbol census lines are intentionally skipped")
    if rule.id == "FLT-IMP-001" or rule.id == "FLT-IMP-002":
        return ("checked", "")
    ("uncheckable", "no mechanical detector implemented in this census scanner today")

pub fn scan_single_file(path: text, content: text) -> [CensusSite]:
    """Unit-test seam: scan a single synthetic file's content directly,
    without touching disk. Used by flight_rule_census_scan_spec.spl to plant
    known violations and verify exactly those are found.
    """
    val (sites, _) = scan_file_functions(path, content)
    sites

pub fn run_flight_rule_census() -> CensusReport:
    var sites: [CensusSite] = []
    var files_scanned = 0
    var functions_scanned = 0
    for path in dir_walk(SCAN_ROOT):
        if not path.ends_with(".spl"):
            continue
        if is_excluded(path):
            continue
        files_scanned = files_scanned + 1
        val content = file_read(path)
        val (file_sites, file_inspected) = scan_file_functions(path, content)
        for site in file_sites:
            sites.push(site)
        functions_scanned = functions_scanned + file_inspected

    var rules: [RuleCensus] = []
    for rule in flight_rules():
        val (classification, reason) = classify_rule(rule)
        var comply = 0
        var violate = 0
        if classification == "checked":
            for site in sites:
                if site.rule_id == rule.id:
                    if site.verdict == "comply":
                        comply = comply + 1
                    else:
                        violate = violate + 1
        rules.push(RuleCensus(
            rule_id: rule.id, classification: classification,
            comply: comply, violate: violate, reason: reason))

    CensusReport(files_scanned: files_scanned, functions_scanned: functions_scanned,
        rules: rules, sites: sites)

pub fn format_human_table(report: CensusReport) -> text:
    var lines: [text] = []
    lines.push("Flight-rule baseline census — flight-core-v1 (32 rules)")
    lines.push("Scope: src/**/*.spl, excluding vendor paths (see module header)")
    lines.push("Files scanned: {report.files_scanned}, concrete function bodies inspected: {report.functions_scanned}")
    lines.push("")
    lines.push("rule_id           classification  comply  violate  reason")
    for r in report.rules:
        lines.push("{r.rule_id}  {r.classification}  {r.comply}  {r.violate}  {r.reason}")
    var intrinsic_n = 0
    var checked_n = 0
    var uncheckable_n = 0
    for r in report.rules:
        if r.classification == "intrinsic":
            intrinsic_n = intrinsic_n + 1
        else if r.classification == "checked":
            checked_n = checked_n + 1
        else:
            uncheckable_n = uncheckable_n + 1
    val checked_pct = (checked_n * 100) / 32
    lines.push("")
    lines.push("Summary: {intrinsic_n} intrinsic, {checked_n} checked, {uncheckable_n} uncheckable (of 32)")
    lines.push("Mechanical coverage: {checked_n}/32 rules checked (~{checked_pct}%). The remaining {uncheckable_n} rules are stated enforcement gaps (see per-rule reason column), not silently passed.")
    lines.join("\n")

pub fn format_sdn(report: CensusReport) -> text:
    var lines: [text] = []
    lines.push("flight_rule_census:")
    lines.push("  registry: \"flight-core-v1\"")
    lines.push("  rule_count: 32")
    lines.push("  scope: \"src/**/*.spl excluding vendor paths\"")
    lines.push("  files_scanned: {report.files_scanned}")
    lines.push("  functions_scanned: {report.functions_scanned}")
    lines.push("")
    lines.push("rules |rule_id, classification, comply, violate, reason|")
    for r in report.rules:
        val reason = r.reason.replace("\"", "'")
        lines.push("  {r.rule_id}, {r.classification}, {r.comply}, {r.violate}, \"{reason}\"")
    lines.join("\n")
