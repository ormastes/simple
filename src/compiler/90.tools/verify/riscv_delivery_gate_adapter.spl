# Product adapter from executed RV32 ADD external receipts to FV2 Gate 5.

use compiler.backend.backend.riscv_scalar_rvfi_formal.{
    RiscvScalarFormalArtifactsV1, reduce_rv32_add_external_receipt_v1,
    reduce_rv32_add_external_equivalence_receipt_v1,
    reduce_rv32_add_external_sail_receipt_v1}
use compiler.common.assurance.formal_delivery_gates.{FormalDeliveryReceiptFileV1}
use compiler.common.assurance.formal_interfaces.{CompilerCertificateV1}
use compiler.tools.verify.formal_gate_collectors.{FormalGateCollectionV1}
use compiler.tools.verify.formal_os_hardware_gate_collectors.{
    collect_generated_rv32i_end_to_end_gate_v1}

pub fn collect_rv32_add_product_gate_v1(
    artifacts: RiscvScalarFormalArtifactsV1,
    formal_and_equivalence_receipt: text,
    sail_receipt: text,
    hwir_to_rtl: CompilerCertificateV1,
    materialized_external_evidence: [FormalDeliveryReceiptFileV1]
) -> FormalGateCollectionV1:
    val formal = reduce_rv32_add_external_receipt_v1(artifacts,
        formal_and_equivalence_receipt)
    val equivalence = reduce_rv32_add_external_equivalence_receipt_v1(
        artifacts, formal_and_equivalence_receipt)
    val sail = reduce_rv32_add_external_sail_receipt_v1(artifacts,
        sail_receipt)
    collect_generated_rv32i_end_to_end_gate_v1(formal, equivalence, sail,
        hwir_to_rtl, materialized_external_evidence)
