# Layer call-direction scan — text/regex extractor feeding
# layer_call_direction_checker.spl (M1 of doc/03_plan/compiler/forwarding/
# zero_cost_layers_c0_c5_staged_implementation_plan_2026-08-07.md).
#
# SCOPE (stated plainly, do not overclaim):
#   - Same tier of honesty as noalloc_manifest_scan.spl (identifier + '('
#     callee extraction, reused verbatim below) combined with the
#     import-line extraction pattern from noalloc_reachable.spl (`use
#     X.Y.Z.{A, B}` -> module path + imported symbol names). This is a
#     TEXT-based fact extractor, not an AST/HIR/MIR pass — there is no
#     self-hosted parse entry point wired into a standalone tool here, so a
#     call site is only recognized when it both (a) matches the bare
#     `ident(` pattern _extract_callees already accepts as good enough, and
#     (b) that bare identifier was named in a `use` import line naming the
#     module it came from. A call reached through re-export, a wildcard
#     `use module.*`, an aliased import, or a fully-qualified inline call
#     (`mod.fn()` with no `use` line at all) is invisible to this scan. That
#     gap is real and not hidden — it mirrors exactly what noalloc_manifest_scan
#     already accepts: only calls this scan can actually attribute to a
#     module are reported, nothing is fabricated to fill gaps.
#   - Module identity for both the caller (the file being scanned) and the
#     callee (the imported module) is the source file path relative to the
#     repo root, e.g. "src/compiler/35.semantics/noalloc_checker.spl". This
#     is the same identity a per-file `@layer(NAME)` tag would naturally key
#     on, since a tag decorates one source file.
#   - Resolving a dotted `use a.b.c` module string to a file path is a
#     directory-prefix guess (src/lib/, src/compiler/, src/ in that order,
#     each tried as a plain file and as an __init__.spl package) — the same
#     shape as noalloc_reachable.spl's `_resolve_import`, generalized to not
#     assume a single fixed root. An import that resolves to nothing (e.g. a
#     std path this guesser doesn't know) is simply dropped from the callee
#     list, not fabricated as a synthetic module.
#   - Standalone tool: NOT wired into the live compile pipeline, matching
#     noalloc_manifest_scan.spl's own precedent of being a script driven by
#     an explicit scan call, not a pass the compiler runs automatically.

use std.nogc_sync_mut.io.dir_ops.{dir_walk}
use std.nogc_sync_mut.io.file_ops.{file_exists, file_read}

struct ScannedModuleCalls:
    """One scanned source file's caller-module identity and its resolved callees."""
    module_path: text
    callee_modules: [text]

fn _extract_callees(line: text) -> [text]:
    """Bare `ident(` extraction — copied verbatim from
    noalloc_manifest_scan.spl's _extract_callees (same fidelity, same
    limitations: no qualification, no string/comment awareness beyond what
    the caller already filters)."""
    var callees: [text] = []
    var ident = ""
    var i = 0
    while i < line.len():
        val ch = line[i:i + 1]
        val is_alpha = (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or ch == "_"
        val is_digit = ch >= "0" and ch <= "9"
        if is_alpha or (is_digit and ident != ""):
            ident = ident + ch
        else:
            if ch == "(" and ident != "":
                callees.push(ident)
            ident = ""
        i = i + 1
    callees

fn _trim_import_target(target: text) -> text:
    var end_idx = target.len()
    var i = 0
    while i < target.len():
        val ch = target[i:i + 1]
        if ch == " " or ch == "{" or ch == "(" or ch == ",":
            if i < end_idx:
                end_idx = i
        i = i + 1
    target[0:end_idx]

fn _strip_trailing_dot(target: text) -> text:
    """`_trim_import_target` cuts a `use a.b.{X}` line right at the '{', which
    leaves a trailing '.' on the module portion (e.g. "a.b."). Strip it so
    the module string resolves to the same path a `use a.b` whole-module
    import would."""
    if target.ends_with("."):
        return target[0:target.len() - 1]
    target

fn _import_target_from_line(line: text) -> text:
    """Return the raw `a.b.c` (or `a.b.c.{...}`) target of a `use`/`from`
    import line, or "" if the line is not an import."""
    val trimmed = line.trim()
    if trimmed == "" or trimmed.starts_with("#"):
        return ""
    if trimmed.starts_with("use lazy "):
        return _strip_trailing_dot(_trim_import_target(trimmed[9:trimmed.len()]))
    if trimmed.starts_with("use "):
        return _strip_trailing_dot(_trim_import_target(trimmed[4:trimmed.len()]))
    if trimmed.starts_with("from "):
        return _strip_trailing_dot(_trim_import_target(trimmed[5:trimmed.len()]))
    ""

fn _imported_symbols(line: text) -> [text]:
    """Return the `{A, B, C}` symbol names named on an import line, or []
    when the import has no brace list (whole-module import)."""
    var symbols: [text] = []
    var open_idx = 0 - 1
    var i = 0
    while i < line.len():
        if line[i:i + 1] == "{":
            open_idx = i
        i = i + 1
    if open_idx < 0:
        return symbols
    val inside = line[open_idx + 1:line.len()]
    var close_idx = inside.len()
    var j = 0
    while j < inside.len():
        if inside[j:j + 1] == "}":
            close_idx = j
        j = j + 1
    val body = inside[0:close_idx]
    for part in body.split(","):
        val name = part.trim()
        if name != "":
            symbols.push(name)
    symbols

fn _module_rel_path(module: text) -> text:
    module.replace(".", "/")

fn _resolve_module_to_path(module: text) -> text:
    """Best-effort dotted-module -> repo-relative file path guess, tried
    against a handful of known source roots (same shape as
    noalloc_reachable.spl's _resolve_import, generalized). Returns "" when
    no candidate file exists on disk.

    "std." is stripped and tried against "src/lib/" first, matching the
    real `use std.X` -> `src/lib/X` convention documented in
    .claude/rules/structure.md ("Import namespace: `use std.X` preferred
    (resolves from `src/lib/`)"). The remaining roots are the same coarse
    guesses noalloc_reachable.spl already relies on — this does NOT
    replicate numbered-directory stripping (e.g. `src/compiler/35.semantics/`)
    or any other real module-resolver rule beyond that one documented case."""
    if module.starts_with("std."):
        val candidate = _try_candidate("src/lib/" + _module_rel_path(module[4:module.len()]))
        if candidate != "":
            return candidate
    val roots = ["src/lib/", "src/compiler/", "src/"]
    val rel = _module_rel_path(module)
    for root in roots:
        val candidate = _try_candidate(root + rel)
        if candidate != "":
            return candidate
    ""

fn _try_candidate(base_no_ext: text) -> text:
    val plain = base_no_ext + ".spl"
    if file_exists(plain):
        return plain
    val pkg = base_no_ext + "/__init__.spl"
    if file_exists(pkg):
        return pkg
    ""

fn scan_file_calls(path: text) -> ScannedModuleCalls:
    """Scan one source file: build a symbol->module map from its `use`
    lines, then scan every line's bare `ident(` callees and attribute each
    one that matches an imported symbol to that symbol's resolved module
    path."""
    val content = file_read(path)
    val lines = content.split("\n")

    var symbol_module: [{text: text}] = []
    for line in lines:
        val target = _import_target_from_line(line)
        if target == "":
            continue
        val resolved = _resolve_module_to_path(target)
        if resolved == "":
            continue
        for symbol in _imported_symbols(line):
            var entry: {text: text} = {}
            entry[symbol] = resolved
            symbol_module.push(entry)

    var callee_modules: [text] = []
    var seen: {text: bool} = {}
    for line in lines:
        for callee in _extract_callees(line):
            for entry in symbol_module:
                if entry.has(callee):
                    val resolved = entry[callee]
                    if not seen.has(resolved) or not seen[resolved]:
                        seen[resolved] = true
                        callee_modules.push(resolved)

    ScannedModuleCalls(module_path: path, callee_modules: callee_modules)

fn scan_layer_calls(root: text) -> [ScannedModuleCalls]:
    """Walk `root`, scanning every non-spec .spl file for caller-module ->
    resolved-callee-module edges."""
    var results: [ScannedModuleCalls] = []
    for path in dir_walk(root):
        if not path.ends_with(".spl"):
            continue
        if path.ends_with("_spec.spl"):
            continue
        results.push(scan_file_calls(path))
    results

fn layer_call_edges(root: text) -> [{text: [text]}]:
    """Build the caller_module -> [callee_module_path] edge list consumed by
    layer_call_direction_checker.check_all_layer_calls.

    Shape deliberately mirrors noalloc_manifest_scan.spl's fn_callees: a
    LIST of single-key maps (one per scanned module), not one multi-key
    dict — the same array-of-maps convention noalloc_manifest_scan already
    uses to build check_all_noalloc_fns' fn_bodies/fn_callees parameters."""
    var edges: [{text: [text]}] = []
    for entry in scan_layer_calls(root):
        var e: {text: [text]} = {}
        e[entry.module_path] = entry.callee_modules
        edges.push(e)
    edges

export ScannedModuleCalls, scan_file_calls, scan_layer_calls, layer_call_edges
