# Lake Build Runner
#
# Invokes Lean 4's Lake build system for verification projects.
# Handles lake discovery, build, check, and clean operations.

use app.io.mod.{shell, file_exists, file_read, file_write, file_delete, ProcessResult}

# Lean root names are deliberately restricted to the portable identifier subset
# before they become generated Lean source.  This is not a shell-escaping
# mechanism: it prevents a malformed manifest from being interpreted as Lean
# syntax at all.  A verified build must fail rather than attempt recovery.
fn _is_lean_root_segment(segment: text) -> bool:
    if segment == "": return false
    val chars = segment.chars()
    val first = chars[0]
    val first_chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_"
    val rest_chars = first_chars + "0123456789'"
    if not first_chars.contains(first):
        return false
    for char in chars:
        if not rest_chars.contains(char):
            return false
    true

fn _is_lean_proof_root(root: text) -> bool:
    if root == "": return false
    for segment in root.split("."):
        if not _is_lean_root_segment(segment): return false
    true

# Extract only explicit, source-level audit declarations.  Comments and
# strings can at worst add an extra requested root and make the gate fail;
# they can never erase a required root or manufacture successful evidence.
pub fn declared_axiom_roots(source: text) -> [text]:
    val prefix = "#print axioms "
    var roots: [text] = []
    for line in source.lines():
        val trimmed = line.trim()
        if trimmed.starts_with(prefix):
            val root = trimmed.substring(prefix.len()).trim()
            if _is_lean_proof_root(root) and not roots.contains(root):
                roots.push(root)
    roots

# Generate a temporary audit module from the exact Lean source that is being
# checked.  The caller owns the temporary file lifecycle and retains the
# resulting output in the proof receipt.  Invalid roots are rejected before
# any process invocation, preventing a manifest from changing the command or
# generated Lean program shape.
pub fn lean_axiom_audit_source(source: text, roots: [text]) -> Result<text, text>:
    if roots.is_empty():
        return Err("no exported proof roots declared")
    for root in roots:
        if not _is_lean_proof_root(root):
            return Err("invalid Lean proof root: " + root)
    var commands: [text] = []
    for root in roots:
        commands.push("#print axioms " + root)
    Ok(source + "\n\n" + commands.join("\n") + "\n")

# ============================================================================
# Lake Runner
# ============================================================================

class LakeRunner:
    project_dir: text
    lake_path: text

    static fn new(project_dir: text) -> LakeRunner:
        val lake = _find_lake()
        LakeRunner(
            project_dir: project_dir,
            lake_path: lake
        )

fn _find_lake() -> text:
    """Find the lake executable on the system."""
    val check = shell("which lake 2>/dev/null")
    if check.exit_code == 0:
        return check.stdout.trim()
    val check2 = shell("which ~/.elan/bin/lake 2>/dev/null")
    if check2.exit_code == 0:
        return check2.stdout.trim()
    ""

impl LakeRunner:
    fn is_available() -> bool:
        """Check if Lake is available on the system."""
        self.lake_path.len() > 0

    fn build() -> Result<text, text>:
        """Run lake build in the project directory."""
        if not self.is_available():
            return Err("Lake not found. Install Lean 4 / elan first.")
        val result = shell("cd {self.project_dir} && {self.lake_path} build 2>&1")
        if result.exit_code == 0:
            Ok(result.stdout)
        else:
            Err("Lake build failed:\n{result.stdout}\n{result.stderr}")

    fn check_file(path: text) -> Result<text, text>:
        """Type-check a single Lean file."""
        if not self.is_available():
            return Err("Lake not found")
        if not file_exists(path):
            return Err("Lean file not found: " + path)
        val source = file_read(path)
        val roots = declared_axiom_roots(source)
        val audit_source = lean_axiom_audit_source(source, roots)
        val generated = match audit_source:
            case Ok(value): value
            case Err(message): return Err(message)
        # This fixed sibling is safe because ProofChecker invokes this method
        # serially.  Keeping imports relative to the original file also makes
        # the audit module semantically identical to the checked artifact.
        val audit_path = path + ".fv2_axiom_audit.lean"
        if not file_write(audit_path, generated):
            return Err("failed to create Lean axiom audit module")
        val result = shell("cd {self.project_dir} && {self.lake_path} env lean {audit_path} 2>&1")
        file_delete(audit_path)
        if result.exit_code == 0:
            # Retain theorem/audit output. The caller must inspect transitive
            # `#print axioms` evidence rather than treating exit zero alone as
            # a verification result.
            Ok(result.stdout + result.stderr)
        else:
            Err(result.stdout + result.stderr)

    fn clean() -> Result<text, text>:
        """Clean the Lake build artifacts."""
        if not self.is_available():
            return Err("Lake not found")
        val result = shell("cd {self.project_dir} && {self.lake_path} clean 2>&1")
        if result.exit_code == 0:
            Ok("Clean successful")
        else:
            Err("Clean failed: {result.stderr}")

# ============================================================================
# Exports
# ============================================================================
