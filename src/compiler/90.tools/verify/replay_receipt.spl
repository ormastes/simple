# Compatibility surface. The frozen FV2 replay schema is owned by the common
# assurance layer so MIR/compiler promotion can consume it without importing
# the tool layer.

export use compiler.common.assurance.replay_receipt.{
    ReplayCheckerClassV1, ReplayOutcomeV1, ReplayCheckerReceiptV1,
    IndependentReplayClosureV1, close_independent_replay_v1}

# A separate non-promoting candidate schema for the primitive-Nat literal
# boundary.  It is intentionally not part of the replay-closure export above.
export use compiler.common.assurance.nat_normalizer_receipt.{
    BoundedNatNormalizerOutcomeV1, BoundedNatNormalizerReceiptV1,
    nat_normalizer_cannot_close_replay_v1}
