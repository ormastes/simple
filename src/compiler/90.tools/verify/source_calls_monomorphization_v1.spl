# Canonical static specialization for one source-call inventory invocation.
# No archive output, process-global report, persistent cache or formal receipt.
use compiler.hir.hir_types.{HirModule, SymbolId}
use compiler.hir.hir_definitions.{HirFunction, HirClass, HirStruct, HirEnum,
    HirBitfield, HirTrait, HirConst}
use compiler.hir.hir_codec.{hir_codec_header}
use compiler.hir.hir_codec_support.{HirCodecWriter}
use compiler.hir.generated.hir_codec.{hc_enc_hir_module}
use compiler.mono.mono_invocation_policy_v1.{MonoInvocationLimitsV1,
    MonoInvocationBudgetV1}
use compiler.mono.mono_invocation_preflight_v1.{mono_preflight_module_v1}
use compiler.mono.monomorphize_integration.{MonomorphizationPass, MonoStats,
    mono_validate_completed_signatures_v1}
use compiler.mono.verify.post_mono_verify.{post_mono_verify_modules,
    post_mono_report_is_clean, post_mono_report_diagnostics}
use compiler.mir.verification_source_environment_v1.{verification_source_environment_v1}
use std.common.crypto.sha256.{sha256_text}
use std.common.encoding.utf8.{text_byte_len}

pub struct SourceCallsMonoOutputV1:
    module: HirModule
    input_hir_digest: text
    output_hir_digest: text
    stats: MonoStats
    work_remaining: i64

# Existing legacy HIR encoding, under the invocation's remaining allocation/work
# reservation. This local fingerprint is deliberately not a canonical portable
# artifact or a claim that the separately gated canonical codec is available.
fn source_calls_hir_digest_v1(module: HirModule,
    budget: MonoInvocationBudgetV1) -> Result<text, text>:
    val cap = budget.remaining_work
    if cap < 1: return Err("E-MONO-WORK: no work remains for HIR identity")
    var writer = HirCodecWriter.create_canonical_bounded(cap * 16, cap * 256, cap)
    writer.canonical = false
    hc_enc_hir_module(writer, module)
    val encoded = writer.finish_with_header(hir_codec_header())
    if not budget.charge_v1(writer.charged_work_units): return Err(budget.failure)
    if not writer.ok: return Err("E-MONO-ENCODE: " + writer.unsupported)
    val domain = "source-calls-local-hir-v1\n"
    if not budget.charge_v1(text_byte_len(encoded) + text_byte_len(domain)):
        return Err(budget.failure)
    Ok(sha256_text(domain + encoded))

# The canonical pass replaces table entries for constants and generated
# declarations. Give it fresh outer maps as well as the existing owned lexical
# environment. Immutable declarations are borrowed until canonical rewriting
# creates their replacements; no input dictionary is passed as a mutable owner.
# The complete schema preflight has already reserved every row/child and checks
# the actual typed provider count before taking any key snapshots.
fn source_calls_owned_module_v1(module: HirModule,
    budget: MonoInvocationBudgetV1, copy_units: i64) -> Result<HirModule, text>:
    if not budget.charge_product_v1(copy_units, 2): return Err(budget.failure)
    var owned = module
    owned.symbols = verification_source_environment_v1(module.symbols)?
    var functions: Dict<SymbolId, HirFunction> = {}
    if module.functions != nil:
        for key in module.functions.keys(): functions[key] = module.functions[key]
    owned.functions = functions
    var classes: Dict<SymbolId, HirClass> = {}
    if module.classes != nil:
        for key in module.classes.keys(): classes[key] = module.classes[key]
    owned.classes = classes
    var structs: Dict<SymbolId, HirStruct> = {}
    if module.structs != nil:
        for key in module.structs.keys(): structs[key] = module.structs[key]
    owned.structs = structs
    var enums: Dict<SymbolId, HirEnum> = {}
    if module.enums != nil:
        for key in module.enums.keys(): enums[key] = module.enums[key]
    owned.enums = enums
    var bitfields: Dict<SymbolId, HirBitfield> = {}
    if module.bitfields != nil:
        for key in module.bitfields.keys(): bitfields[key] = module.bitfields[key]
    owned.bitfields = bitfields
    var traits: Dict<SymbolId, HirTrait> = {}
    if module.traits != nil:
        for key in module.traits.keys(): traits[key] = module.traits[key]
    owned.traits = traits
    var constants: Dict<SymbolId, HirConst> = {}
    if module.constants != nil:
        for key in module.constants.keys(): constants[key] = module.constants[key]
    owned.constants = constants
    Ok(owned)

fn source_calls_monomorphize_inner_v1(module: HirModule,
    limits: MonoInvocationLimitsV1) -> Result<SourceCallsMonoOutputV1, text>:
    var budget = MonoInvocationBudgetV1.create(limits)?
    if module == nil or module.symbols == nil:
        return Err("E-MONO-INPUT: source module and symbol environment are required")
    val input_facts = mono_preflight_module_v1(module, budget)?
    val input_digest = source_calls_hir_digest_v1(module, budget)?
    val owned = source_calls_owned_module_v1(module, budget, input_facts.copy_units)?
    var input: Dict<text, HirModule> = {}
    if not budget.charge_v1(1): return Err(budget.failure)
    input[module.name] = owned
    var isolated = MonomorphizationPass.create_isolated_v1(limits, budget)?
    val completed = isolated.process_modules_checked_v1(input)?
    if (completed.stats.unresolved_generic_calls != 0 or
            completed.diagnostics.len() != 0 or completed.warnings.len() != 0):
        return Err("E-MONO-DIAGNOSTICS: " +
            completed.diagnostics.join("; ") + "; " + completed.warnings.join("; "))
    if not completed.modules.contains(module.name):
        return Err("E-MONO-OUTPUT: canonical pass omitted the source owner")
    val output: HirModule = completed.modules[module.name]
    if output == nil or output.name != module.name or output.path != module.path:
        return Err("E-MONO-OUTPUT: canonical output owner differs")
    val output_facts = mono_preflight_module_v1(output, budget)?
    # G7 indexes actual declarations and traverses actual output nodes. Reserve
    # its bounded schema work and diagnostic retention before entering that
    # unchanged verifier; this is logical work, not measured native RSS.
    if not budget.charge_product_v1(output_facts.copy_units, 8): return Err(budget.failure)
    val report = post_mono_verify_modules(completed.modules)
    if not post_mono_report_is_clean(report):
        return Err("SOURCE-CALLS-E-G7: " + post_mono_report_diagnostics(report).join("; "))
    mono_validate_completed_signatures_v1(output, budget)?
    val output_digest = source_calls_hir_digest_v1(output, budget)?
    if budget.failure != "": return Err(budget.failure)
    Ok(SourceCallsMonoOutputV1(module: output, input_hir_digest: input_digest,
        output_hir_digest: output_digest, stats: completed.stats,
        work_remaining: budget.remaining_work))

pub fn source_calls_monomorphize_v1(module: HirModule,
    limits: MonoInvocationLimitsV1) -> Result<SourceCallsMonoOutputV1, text>:
    match source_calls_monomorphize_inner_v1(module, limits):
        case Ok(output): Ok(output)
        case Err(message):
            if message.starts_with("SOURCE-CALLS-E-G7:"): return Err(message)
            Err("SOURCE-CALLS-E-MONO: " + message)
