# Receipt-owning FV2 proof replay runners.
#
# These receipt-owning entrypoints currently resolve signed policy candidates
# and fail closed. They do not launch tools until the complete tool chain can
# be pinned to executed bytes.

use std.common.crypto.sha256.{sha256_text}
use std.common.encoding.sha256_contract.{sha256_lower_hex_valid}
use compiler.common.assurance.replay_receipt.{ReplayCheckerClassV1,
    ReplayOutcomeV1, ReplayCheckerReceiptV1}
use compiler.tools.verify.replay_authority.{replay_authority_candidate_v1}

pub struct ReplayRunnerConfigV1:
    project_dir: text
    module_name: text
    declaration_root: text
    artifact_path: text
    artifact_hash: text
    launcher_path: text
    tool_path: text
    tool_name: text
    tool_version: text
    timeout_ms: i64

# The checker is only as trustworthy as the launcher that runs it.  Lake is a
# semantic/trust boundary for fresh Lean replay, and the independent adapter
# is the checker boundary for the second lane.  Keep both file hashes in the
# one frozen receipt identity field rather than silently treating a mutable
# launcher as an unrecorded environmental assumption.
pub fn replay_executable_identity_hash_v1(
    launcher_hash: text,
    tool_hash: text
) -> text:
    # The V1 composite format intentionally remains frozen.  Its components
    # are canonical SHA-256 identities, so the historical separators cannot
    # be interpreted as part of either input domain.
    if not sha256_lower_hex_valid(launcher_hash) or
            not sha256_lower_hex_valid(tool_hash): return ""
    sha256_text("FV2-Replay-Executable-Identity-v1|launcher=" +
        launcher_hash + "|tool=" + tool_hash)

fn replay_module_segment_is_safe_v1(segment: text) -> bool:
    if segment == "": return false
    var index = 0
    while index < segment.len():
        val code = segment.char_code_at(index)
        val ascii_letter = (code >= 97 and code <= 122) or (code >= 65 and code <= 90)
        val ascii_digit = code >= 48 and code <= 57
        if index == 0:
            if not (ascii_letter or code == 95): return false
        elif not (ascii_letter or ascii_digit or code == 95):
            return false
        index = index + 1
    true

pub fn replay_module_name_is_safe_v1(name: text) -> bool:
    if name == "": return false
    for segment in name.split("."):
        if not replay_module_segment_is_safe_v1(segment): return false
    true

pub fn replay_runner_config_error_v1(config: ReplayRunnerConfigV1) -> text:
    if config.project_dir == "": return "FV2-E-REPLAY-PROJECT: project directory is empty"
    if not replay_module_name_is_safe_v1(config.module_name):
        return "FV2-E-REPLAY-MODULE-NAME: module name is not canonical"
    if not replay_module_name_is_safe_v1(config.declaration_root):
        return "FV2-E-REPLAY-DECLARATION-ROOT: proof root is not canonical"
    if config.artifact_path == "": return "FV2-E-REPLAY-ARTIFACT-PATH: artifact path is empty"
    if not sha256_lower_hex_valid(config.artifact_hash):
        return "FV2-E-REPLAY-ARTIFACT: artifact hash is not canonical SHA-256"
    if config.launcher_path == "": return "FV2-E-REPLAY-LAUNCHER: launcher path is empty"
    if config.tool_path == "": return "FV2-E-REPLAY-TOOL: checker path is empty"
    if config.tool_name == "" or config.tool_version == "":
        return "FV2-E-REPLAY-IDENTITY: tool identity is incomplete"
    if config.timeout_ms <= 0: return "FV2-E-REPLAY-TIMEOUT: timeout must be positive"
    ""

fn replay_failed_receipt_v1(
    class_: ReplayCheckerClassV1,
    config: ReplayRunnerConfigV1,
    policy_hash: text,
    outcome: ReplayOutcomeV1,
    diagnostic: text
) -> ReplayCheckerReceiptV1:
    ReplayCheckerReceiptV1(
        "ReplayCheckerReceipt-v1", class_, config.tool_name,
        config.tool_version, "", config.module_name, config.declaration_root,
        config.artifact_hash,
        policy_hash, "", outcome, diagnostic)

# A build-directory manifest cannot authorize itself: an attacker able to
# replace the replay executable can replace an adjacent manifest too. A signed
# operator policy remains only a candidate until the complete executable chain
# is pinned, so the public receipt-owning entrypoints must not promote a
# caller-supplied configuration into accepted replay evidence.
fn replay_authority_error_v1(class_: ReplayCheckerClassV1, config: ReplayRunnerConfigV1) -> (text, text):
    val candidate = replay_authority_candidate_v1(class_, config.launcher_path,
        config.tool_path, config.tool_name, config.tool_version)
    match candidate:
        case Ok(policy_hash):
            ("FV2-E-REPLAY-PINNED-CHAIN-UNAVAILABLE: signed policy candidate is valid, but Lake, checker, and delegated subtools are not yet pinned to executed bytes", policy_hash)
        case Err(reason):
            ("FV2-E-REPLAY-AUTHORITY: canonical policy candidate unavailable (" + reason + ")", sha256_text("replay-authority-unavailable-v1"))

pub fn run_fresh_leanchecker_v1(
    config: ReplayRunnerConfigV1
) -> ReplayCheckerReceiptV1:
    val (authority_error, policy_hash) = replay_authority_error_v1(
        ReplayCheckerClassV1.FreshLeanKernel, config)
    replay_failed_receipt_v1(ReplayCheckerClassV1.FreshLeanKernel, config,
        policy_hash, ReplayOutcomeV1.ToolFailure, authority_error)

pub fn run_independent_replay_adapter_v1(
    config: ReplayRunnerConfigV1
) -> ReplayCheckerReceiptV1:
    val (authority_error, policy_hash) = replay_authority_error_v1(
        ReplayCheckerClassV1.IndependentKernel, config)
    replay_failed_receipt_v1(ReplayCheckerClassV1.IndependentKernel, config,
        policy_hash, ReplayOutcomeV1.ToolFailure, authority_error)
