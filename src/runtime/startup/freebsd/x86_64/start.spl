# Simple Seed - FreeBSD x86_64 _start (naked twin)
#
# Entry point for ELF executables on FreeBSD x86_64.
# Same stack layout as Linux: kernel places argc, argv, envp on stack.
# Syscall numbers differ (handled in crt_freebsd.c).

@naked
@global
@section(".text")
fn _start():
    asm {
        xor %rbp, %rbp

        mov (%rsp), %rdi            # argc
        lea 8(%rsp), %rsi           # argv
        lea 8(%rsi,%rdi,8), %rdx    # envp

        and $~0xF, %rsp

        call __spl_start

        # Should never return - __spl_start calls __spl_exit
        ud2
    }
