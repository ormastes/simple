# Simple Seed - FreeBSD x86 (i386) _start (naked twin)
#
# Entry point for ELF executables on FreeBSD i386.
# Same stack layout as Linux i386.
# Syscall convention differs (handled in crt_freebsd.c).

@naked
@global
@section(".text")
fn _start():
    asm {
        xor %ebp, %ebp

        mov (%esp), %eax            # argc
        lea 4(%esp), %ecx           # argv
        lea 4(%ecx,%eax,4), %edx    # envp

        and $~0xF, %esp

        push %edx
        push %ecx
        push %eax

        call __spl_start

        # Should never return - __spl_start calls __spl_exit
        ud2
    }
