# Pure-Simple enum ABI helpers.

@unsafe(reason: "raw libc zeroed heap allocation ABI; zero means failure", capabilities: [ffi, raw_ptr])
extern fn calloc(count: i64, size: i64) -> i64
@unsafe(reason: "raw pointer/offset i64 load ABI", capabilities: [ffi, raw_ptr])
extern fn spl_load_i64(ptr: i64, offset: i64) -> i64
@unsafe(reason: "raw pointer/offset byte load ABI", capabilities: [ffi, raw_ptr])
extern fn spl_load_u8(ptr: i64, offset: i64) -> i64
@unsafe(reason: "raw pointer/offset i64 store ABI", capabilities: [ffi, raw_ptr])
extern fn spl_store_i64(ptr: i64, offset: i64, value: i64)
@unsafe(reason: "raw pointer/offset byte store ABI", capabilities: [ffi, raw_ptr])
extern fn spl_store_u8(ptr: i64, offset: i64, value: i64)
@unsafe(reason: "raw fail-closed process termination ABI", capabilities: [ffi])
extern fn abort()

@always_inline
fn _sffi_calloc(count: i64, size: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]):
        calloc(count, size)

@always_inline
fn _sffi_load_i64(ptr: i64, offset: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]):
        spl_load_i64(ptr, offset)

@always_inline
fn _sffi_load_u8(ptr: i64, offset: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]):
        spl_load_u8(ptr, offset)

@always_inline
fn _sffi_store_i64(ptr: i64, offset: i64, value: i64):
    unsafe(capabilities: [ffi, raw_ptr]):
        spl_store_i64(ptr, offset, value)

@always_inline
fn _sffi_store_u8(ptr: i64, offset: i64, value: i64):
    unsafe(capabilities: [ffi, raw_ptr]):
        spl_store_u8(ptr, offset, value)

@always_inline
fn _sffi_abort():
    unsafe(capabilities: [ffi]):
        abort()

# ponytail: linear registry is enough for bootstrap-sized enum sets; replace
# with a hash set only if profiles show enum validation on a hot path.
var enum_registry_head: i64 = 0

fn store_u32_le(ptr: i64, offset: i64, value: i64):
    _sffi_store_u8(ptr, offset, value & 255)
    _sffi_store_u8(ptr, offset + 1, (value >> 8) & 255)
    _sffi_store_u8(ptr, offset + 2, (value >> 16) & 255)
    _sffi_store_u8(ptr, offset + 3, (value >> 24) & 255)

fn load_u32_le(ptr: i64, offset: i64) -> i64:
    return _sffi_load_u8(ptr, offset) | (_sffi_load_u8(ptr, offset + 1) << 8) | (_sffi_load_u8(ptr, offset + 2) << 16) | (_sffi_load_u8(ptr, offset + 3) << 24)

fn enum_ptr(value: i64) -> i64:
    if value < 4096:
        return 0
    if (value & 7) != 1:
        return 0
    val candidate = value & -8
    var current = enum_registry_head
    while current > 0:
        if current == candidate:
            if _sffi_load_u8(current, 0) == 4:
                return current
            return 0
        current = _sffi_load_i64(current, 24)
    return 0

pub fn rt_enum_new(enum_id: i32, discriminant: i32, payload: i64) -> i64:
    val value = _sffi_calloc(1, 32)
    if value < 1:
        _sffi_abort()
        return 3
    _sffi_store_u8(value, 0, 4)
    store_u32_le(value, 4, enum_id)
    store_u32_le(value, 8, discriminant)
    _sffi_store_i64(value, 16, payload)
    _sffi_store_i64(value, 24, enum_registry_head)
    enum_registry_head = value
    return value | 1

pub fn rt_enum_discriminant(value: i64) -> i64:
    val ptr = enum_ptr(value)
    if ptr < 1:
        return -1
    return load_u32_le(ptr, 8)

pub fn rt_enum_id(value: i64) -> i64:
    val ptr = enum_ptr(value)
    if ptr < 1:
        return -1
    return load_u32_le(ptr, 4)

pub fn rt_enum_payload(value: i64) -> i64:
    val ptr = enum_ptr(value)
    if ptr < 1:
        return 3
    return _sffi_load_i64(ptr, 16)

# Formation probe for heap-typed enum/Option payloads at fail-closed
# handoffs. Mirrors runtime_native.c's rt_heap_ref_wellformed: 1 for any
# payload word that is a plausible object reference, i.e. not 0 and not a
# zero-page address. A FORMATION check, not liveness. Catches the 2026-08-22
# stage-3 streaming-owner incident class (Some tag survives, payload word 0)
# before the first field load faults. It does NOT require the heap tag:
# requiring it false-rejected every live class instance on the native codegen
# lane, where a class reference is a raw untagged pointer (measured
# 2026-08-24).
pub fn rt_heap_ref_wellformed(value: i64) -> i8:
    if (value & -8) < 4096:
        return 0
    1
