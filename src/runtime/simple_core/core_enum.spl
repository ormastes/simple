# Pure-Simple enum ABI helpers.

@unsafe(reason: "raw libc zeroed allocation ABI; contract: zero sentinel means failure", capabilities: [ffi, raw_ptr])
extern fn calloc(count: i64, size: i64) -> i64
@unsafe(reason: "raw libc heap free ABI", capabilities: [ffi, raw_ptr])
extern fn free(ptr: i64)
@unsafe(reason: "raw pointer i64 load ABI; contract: caller establishes alignment and bounds", capabilities: [ffi, raw_ptr])
extern fn spl_load_i64(ptr: i64, offset: i64) -> i64
@unsafe(reason: "raw pointer byte load ABI; contract: caller establishes bounds", capabilities: [ffi, raw_ptr])
extern fn spl_load_u8(ptr: i64, offset: i64) -> i64
@unsafe(reason: "raw pointer i64 store ABI; contract: caller establishes alignment and bounds", capabilities: [ffi, raw_ptr])
extern fn spl_store_i64(ptr: i64, offset: i64, value: i64)
@unsafe(reason: "raw pointer byte store ABI; contract: caller establishes bounds", capabilities: [ffi, raw_ptr])
extern fn spl_store_u8(ptr: i64, offset: i64, value: i64)
@unsafe(reason: "raw transient-tracking runtime note ABI", capabilities: [ffi, raw_ptr])
extern fn rt_simple_core_transient_note(ptr: i64, kind: i64) -> i64
extern fn rt_atomic_int_new(initial: i64) -> i64
extern fn rt_atomic_int_load(handle: i64) -> i64
extern fn rt_atomic_int_compare_exchange(handle: i64, current: i64, new_value: i64) -> i8

@always_inline
fn _sffi_core_enum_calloc(count: i64, size: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]):
        calloc(count, size)

@always_inline
fn _sffi_core_enum_free(ptr: i64):
    unsafe(capabilities: [ffi, raw_ptr]):
        free(ptr)

@always_inline
fn _sffi_core_enum_transient_note(ptr: i64, kind: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]):
        rt_simple_core_transient_note(ptr, kind)

@always_inline
fn _sffi_core_enum_load_i64(ptr: i64, offset: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]):
        spl_load_i64(ptr, offset)

@always_inline
fn _sffi_core_enum_load_u8(ptr: i64, offset: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]):
        spl_load_u8(ptr, offset)

@always_inline
fn _sffi_core_enum_store_i64(ptr: i64, offset: i64, value: i64):
    unsafe(capabilities: [ffi, raw_ptr]):
        spl_store_i64(ptr, offset, value)

@always_inline
fn _sffi_core_enum_store_u8(ptr: i64, offset: i64, value: i64):
    unsafe(capabilities: [ffi, raw_ptr]):
        spl_store_u8(ptr, offset, value)

# ponytail: linear registry is enough for bootstrap-sized enum sets; replace
# with a hash set only if profiles show enum validation on a hot path.
var enum_registry_head: i64 = 0

fn store_u32_le(ptr: i64, offset: i64, value: i64):
    _sffi_core_enum_store_u8(ptr, offset, value & 255)
    _sffi_core_enum_store_u8(ptr, offset + 1, (value >> 8) & 255)
    _sffi_core_enum_store_u8(ptr, offset + 2, (value >> 16) & 255)
    _sffi_core_enum_store_u8(ptr, offset + 3, (value >> 24) & 255)

fn load_u32_le(ptr: i64, offset: i64) -> i64:
    return _sffi_core_enum_load_u8(ptr, offset) | (_sffi_core_enum_load_u8(ptr, offset + 1) << 8) | (_sffi_core_enum_load_u8(ptr, offset + 2) << 16) | (_sffi_core_enum_load_u8(ptr, offset + 3) << 24)

fn enum_ptr(value: i64) -> i64:
    if value < 4096:
        return 0
    if (value & 7) != 1:
        return 0
    val candidate = value & -8
    var current = enum_registry_head
    while current > 0:
        if current == candidate:
            if _sffi_core_enum_load_u8(current, 0) == 4:
                return current
            return 0
        current = _sffi_core_enum_load_i64(current, 24)
    return 0

# Payload-less variants (Option.None, unit variants: payload is the nil
# special 3, the integer 0, true 11 or false 19) are process-lifetime
# singletons that no transient scope or session heap ever owns, mirroring
# enum_new_unit_singleton in runtime_native.c (C static of the same name; bug
# option_struct_none_box_freed_by_transient_scope_2026_11_09): a None
# allocated inside a scope and returned past its end must not dangle.
# Singleton nodes are 40 bytes: the 32-byte enum header plus a link at offset
# 32 for this list; they are also members of enum_registry_head so enum_ptr
# validates them like any other enum.
# Handle of the rt_atomic_int cell that holds the list head (0 until created).
var enum_unit_singleton_head: i64 = 0

fn enum_payload_is_unit(payload: i64) -> bool:
    return payload == 3 or payload == 0 or payload == 11 or payload == 19

# Walk the prepend-only singleton list from `from` up to (not including)
# `stop`; 0 when no node carries the key. Mirrors enum_unit_singleton_find.
fn enum_unit_singleton_find(from: i64, stop: i64, enum_id: i32, discriminant: i32, payload: i64) -> i64:
    var current = from
    while current > 0 and current != stop:
        if load_u32_le(current, 4) == enum_id and load_u32_le(current, 8) == discriminant and _sffi_core_enum_load_i64(current, 16) == payload:
            return current | 1
        current = _sffi_core_enum_load_i64(current, 32)
    return 0

# The list head lives in an rt_atomic_int cell (core_atomic.spl) so publish
# is a real compare-exchange, the twin of the C atomic_compare_exchange on
# rt_enum_unit_singletons. The cell is created once, before the first unit
# variant is built (process start, single-threaded), and never freed.
fn enum_unit_singleton_head_cell() -> i64:
    if enum_unit_singleton_head == 0:
        enum_unit_singleton_head = rt_atomic_int_new(0)
    return enum_unit_singleton_head

fn enum_unit_singleton_head_load() -> i64:
    return rt_atomic_int_load(enum_unit_singleton_head_cell())

# Publish `node` as the new list head iff the head is still `expected`.
fn enum_unit_singleton_publish(expected: i64, node: i64) -> bool:
    return rt_atomic_int_compare_exchange(enum_unit_singleton_head_cell(), expected, node) != 0

fn enum_new_unit_singleton(enum_id: i32, discriminant: i32, payload: i64) -> i64:
    var head = enum_unit_singleton_head_load()
    val existing = enum_unit_singleton_find(head, 0, enum_id, discriminant, payload)
    if existing != 0:
        return existing
    val value = _sffi_core_enum_calloc(1, 40)
    if value < 1:
        return 3
    _sffi_core_enum_store_u8(value, 0, 4)
    store_u32_le(value, 4, enum_id)
    store_u32_le(value, 8, discriminant)
    _sffi_core_enum_store_i64(value, 16, payload)
    _sffi_core_enum_store_i64(value, 24, enum_registry_head)
    enum_registry_head = value
    while true:
        _sffi_core_enum_store_i64(value, 32, head)
        if enum_unit_singleton_publish(head, value):
            return value | 1
        # Lost the publish race: only nodes prepended since `head` are new.
        val raced = enum_unit_singleton_find(enum_unit_singleton_head_load(), head, enum_id, discriminant, payload)
        if raced != 0:
            enum_unregister(value)
            _sffi_core_enum_free(value)
            return raced
        head = enum_unit_singleton_head_load()
    return 3

pub fn rt_enum_new(enum_id: i32, discriminant: i32, payload: i64) -> i64:
    if enum_payload_is_unit(payload):
        return enum_new_unit_singleton(enum_id, discriminant, payload)
    val value = _sffi_core_enum_calloc(1, 32)
    if value < 1:
        return 3
    _sffi_core_enum_store_u8(value, 0, 4)
    store_u32_le(value, 4, enum_id)
    store_u32_le(value, 8, discriminant)
    _sffi_core_enum_store_i64(value, 16, payload)
    _sffi_core_enum_store_i64(value, 24, enum_registry_head)
    enum_registry_head = value
    if _sffi_core_enum_transient_note(value, 4) < 0:
        enum_registry_head = _sffi_core_enum_load_i64(value, 24)
        _sffi_core_enum_free(value)
        return 3
    return value | 1

# Membership test for the transient machinery (core_memory.spl).
pub fn enum_is_valid(value: i64) -> i64:
    return if enum_ptr(value) > 0: 1 else: 0

fn enum_unregister(ptr: i64):
    var previous: i64 = 0
    var current = enum_registry_head
    while current > 0:
        val next = _sffi_core_enum_load_i64(current, 24)
        if current == ptr:
            if previous < 1:
                enum_registry_head = next
            else:
                _sffi_core_enum_store_i64(previous, 24, next)
            return
        previous = current
        current = next

# Scope-end reclamation of an unpromoted transient enum (raw header ptr).
pub fn enum_reclaim_transient(ptr: i64):
    enum_unregister(ptr)
    _sffi_core_enum_free(ptr)

pub fn rt_enum_discriminant(value: i64) -> i64:
    val ptr = enum_ptr(value)
    if ptr < 1:
        return -1
    return load_u32_le(ptr, 8)

pub fn rt_enum_id(value: i64) -> i64:
    val ptr = enum_ptr(value)
    if ptr < 1:
        return -1
    return load_u32_le(ptr, 4)

pub fn rt_enum_payload(value: i64) -> i64:
    val ptr = enum_ptr(value)
    if ptr < 1:
        return 3
    return _sffi_core_enum_load_i64(ptr, 16)

# Formation probe for heap-typed enum/Option payloads at fail-closed
# handoffs. Mirrors runtime_native.c's rt_heap_ref_wellformed: 1 for either a
# tagged heap reference or a raw/untagged class reference outside the zero
# page. A FORMATION check, not liveness;
# call sites own the heap-payload contract (scalar payloads report 0 by
# design). Catches the 2026-08-22 stage-3 streaming-owner incident class
# (Some tag survives, payload word 0) before the first field load faults.
pub fn rt_heap_ref_wellformed(value: i64) -> i8:
    if (value & -8) < 4096:
        return 0
    1
