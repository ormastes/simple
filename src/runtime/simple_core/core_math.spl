# Pure-Simple simple-core math ABI backed by the platform math library.

@unsafe(reason: "raw platform libm square-root ABI", capabilities: [ffi])
extern fn sqrt(x: f64) -> f64

@always_inline
fn _sffi_core_math_sqrt(x: f64) -> f64:
    unsafe(capabilities: [ffi]):
        sqrt(x)

pub fn rt_math_sqrt(x: f64) -> f64:
    return _sffi_core_math_sqrt(x)

# IEEE-754 classification stays in pure Simple. NaN is the only value unequal
# to itself; multiplying the largest convenient finite decimal by ten forms
# positive infinity on every supported IEEE-754 target.
pub fn rt_math_is_nan(x: f64) -> bool:
    return x != x

pub fn rt_math_is_inf(x: f64) -> bool:
    val positive_infinity = 1.0e308 * 10.0
    return x == positive_infinity or x == 0.0 - positive_infinity

pub fn rt_math_is_finite(x: f64) -> bool:
    return not rt_math_is_nan(x) and not rt_math_is_inf(x)
