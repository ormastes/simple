# Pure-Simple `simple-core` stdio ABI wrappers that do not depend on text layout.

@unsafe(reason: "raw C stream flush status ABI; null stream flushes all output streams", capabilities: [ffi])
extern fn fflush(stream: i64) -> i64

@always_inline
fn _sffi_core_stdio_fflush(stream: i64) -> i64:
    unsafe(capabilities: [ffi]):
        fflush(stream)

pub fn rt_stdout_flush() -> i64:
    return _sffi_core_stdio_fflush(0)

pub fn rt_stderr_flush() -> i64:
    return _sffi_core_stdio_fflush(0)
