# UTF-8 slice-boundary audit, stage 1 (COUNTING ONLY). Level-gated by
# SIMPLE_UTF8_SLICE_AUDIT and DEFAULT OFF; defined in
# src/runtime/runtime_simd_utf8.c, which owns the validator this tier has no
# copy of. When that object is not in the link set the symbol resolves to a
# stub returning 0, so the audit is simply inactive -- fail-closed OFF, never
# a link failure and never a behaviour change.
@unsafe(reason: "raw UTF-8 slice audit ABI; contract: zero means inactive or no recorded violation", capabilities: [ffi])
extern fn rt_text_slice_audit_note_range(src: i64, src_len: i64, begin: i64, finish: i64) -> i64

