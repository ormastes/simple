pub fn rt_string_starts_with(value: i64, prefix: i64) -> i64:
    val ptr = string_ptr(value)
    val prefix_ptr = string_ptr(prefix)
    if ptr < 1 or prefix_ptr < 1:
        return 0
    val prefix_len = string_len_ptr(prefix_ptr)
    if prefix_len > string_len_ptr(ptr):
        return 0
    if prefix_len < 1:
        return 1
    val cmp = _sffi_core_string_memcmp(string_data_ptr_value(ptr), string_data_ptr_value(prefix_ptr), prefix_len)
    if cmp < 0 or cmp > 0:
        return 0
    return 1

pub fn rt_string_ends_with(value: i64, suffix: i64) -> i64:
    val ptr = string_ptr(value)
    val suffix_ptr = string_ptr(suffix)
    if ptr < 1 or suffix_ptr < 1:
        return 0
    val len = string_len_ptr(ptr)
    val suffix_len = string_len_ptr(suffix_ptr)
    if suffix_len > len:
        return 0
    if suffix_len < 1:
        return 1
    val cmp = _sffi_core_string_memcmp(string_data_ptr_value(ptr) + len - suffix_len, string_data_ptr_value(suffix_ptr), suffix_len)
    if cmp < 0 or cmp > 0:
        return 0
    return 1

pub fn rt_string_trim(value: i64) -> i64:
    val ptr = string_ptr(value)
    if ptr < 1:
        return value
    var begin = 0
    var finish = string_len_ptr(ptr)
    while begin < finish and is_space_byte(_sffi_core_string_spl_load_u8(string_data_ptr_value(ptr), begin)) > 0:
        begin = begin + 1
    while finish > begin and is_space_byte(_sffi_core_string_spl_load_u8(string_data_ptr_value(ptr), finish - 1)) > 0:
        finish = finish - 1
    return rt_string_new(string_data_ptr_value(ptr) + begin, finish - begin)

pub fn rt_string_trim_start(value: i64) -> i64:
    val ptr = string_ptr(value)
    if ptr < 1:
        return value
    var begin = 0
    val finish = string_len_ptr(ptr)
    while begin < finish and is_space_byte(_sffi_core_string_spl_load_u8(string_data_ptr_value(ptr), begin)) > 0:
        begin = begin + 1
    return rt_string_new(string_data_ptr_value(ptr) + begin, finish - begin)

pub fn rt_string_trim_end(value: i64) -> i64:
    val ptr = string_ptr(value)
    if ptr < 1:
        return value
    var finish = string_len_ptr(ptr)
    while finish > 0 and is_space_byte(_sffi_core_string_spl_load_u8(string_data_ptr_value(ptr), finish - 1)) > 0:
        finish = finish - 1
    return rt_string_new(string_data_ptr_value(ptr), finish)

pub fn rt_string_to_int(value: i64) -> i64:
    val ptr = string_ptr(value)
    if ptr < 1:
        return 0
    return _sffi_core_string_strtoll(string_data_ptr_value(ptr), 0, 10)

# Task #118: sibling of rt_string_to_int() with the canonical `int(text)`
# semantics — a total, leading-numeric-prefix parse. _sffi_core_string_strtoll() already IS
# this (skips whitespace/sign, parses leading digits, stops at the first
# non-digit, returns 0 if none), so this is byte-for-byte identical to
# rt_string_to_int() above. Named distinctly so the Rust-native
# `simple-runtime` crate's stricter, whole-string-match rt_string_to_int()
# (used by .to_int()/.parse_int()/to_i64() there) stays unaffected.
# Strict optional integer parser used by text.parse_int/parse_i64. The native
# optional ABI is an unboxed tagged integer on success and NIL on failure.
pub fn rt_string_parse_int(value: i64) -> i64:
    val ptr = string_ptr(value)
    if ptr < 1:
        return 3
    val data = string_data_ptr_value(ptr)
    val len = string_len_ptr(ptr)
    var begin = 0
    var finish = len
    while begin < finish and is_space_byte(spl_load_u8(data, begin)) > 0:
        begin = begin + 1
    while finish > begin and is_space_byte(spl_load_u8(data, finish - 1)) > 0:
        finish = finish - 1
    if begin >= finish:
        return 3
    var negative = false
    val sign = spl_load_u8(data, begin)
    if sign == 43 or sign == 45:
        negative = sign == 45
        begin = begin + 1
    if begin >= finish:
        return 3
    val limit: u64 = if negative: 9223372036854775808u64 else: 9223372036854775807u64
    var magnitude: u64 = 0u64
    var i = begin
    while i < finish:
        val byte = spl_load_u8(data, i)
        if byte < 48 or byte > 57:
            return 3
        val digit = (byte - 48) as u64
        if magnitude > (limit - digit) / 10u64:
            return 3
        magnitude = magnitude * 10u64 + digit
        i = i + 1
    if negative:
        if magnitude == 9223372036854775808u64:
            return rt_value_int(-9223372036854775807 - 1)
        return rt_value_int(-(magnitude as i64))
    rt_value_int(magnitude as i64)

pub fn rt_string_is_digit(value: i64) -> i64:
    val ptr = string_ptr(value)
    if ptr < 1:
        return 0
    val data = string_data_ptr_value(ptr)
    val len = string_len_ptr(ptr)
    if len < 1:
        return 0
    var i = 0
    while i < len:
        val byte = spl_load_u8(data, i)
        if byte < 48 or byte > 57:
            return 0
        i = i + 1
    1

pub fn rt_string_to_int_lenient(value: i64) -> i64:
    val ptr = string_ptr(value)
    if ptr < 1:
        return 0
    return _sffi_core_string_strtoll(string_data_ptr_value(ptr), 0, 10)

pub fn rt_to_string(value: i64) -> i64:
    val ptr = string_ptr(value)
    if ptr > 0:
        return value
    if value > 2 and value < 4:
        return rt_string_new(0, 0)
    if value > 10 and value < 12:
        val out = alloc_string(4)
        val out_ptr = string_ptr(out)
        if out_ptr < 1:
            return 3
        _sffi_core_string_spl_store_u8(string_data_ptr_value(out_ptr), 0, 116)
        _sffi_core_string_spl_store_u8(string_data_ptr_value(out_ptr), 1, 114)
        _sffi_core_string_spl_store_u8(string_data_ptr_value(out_ptr), 2, 117)
        _sffi_core_string_spl_store_u8(string_data_ptr_value(out_ptr), 3, 101)
        return out
    if value > 18 and value < 20:
        val out = alloc_string(5)
        val out_ptr = string_ptr(out)
        if out_ptr < 1:
            return 3
        _sffi_core_string_spl_store_u8(string_data_ptr_value(out_ptr), 0, 102)
        _sffi_core_string_spl_store_u8(string_data_ptr_value(out_ptr), 1, 97)
        _sffi_core_string_spl_store_u8(string_data_ptr_value(out_ptr), 2, 108)
        _sffi_core_string_spl_store_u8(string_data_ptr_value(out_ptr), 3, 115)
        _sffi_core_string_spl_store_u8(string_data_ptr_value(out_ptr), 4, 101)
        return out
    if (value & 7) > 0:
        return rt_string_new(0, 0)

    var n = value >> 3
    val buf = _sffi_core_string_malloc(32)
    if buf < 1:
        return 3
    if n < 1 and n > -1:
        _sffi_core_string_spl_store_u8(buf, 0, 48)
        return rt_string_new(buf, 1)

    var negative = 0
    if n < 0:
        negative = 1
        n = 0 - n

    var len = 0
    while n > 0:
        val digit = n % 10
        _sffi_core_string_spl_store_u8(buf, len, 48 + digit)
        len = len + 1
        n = n / 10

    val out = alloc_string(len + negative)
    val out_ptr = string_ptr(out)
    if out_ptr < 1:
        return 3
    var out_i = 0
    if negative > 0:
        _sffi_core_string_spl_store_u8(string_data_ptr_value(out_ptr), 0, 45)
        out_i = 1
    var i = len - 1
    while i >= 0:
        _sffi_core_string_spl_store_u8(string_data_ptr_value(out_ptr), out_i, _sffi_core_string_spl_load_u8(buf, i))
        out_i = out_i + 1
        i = i - 1
    return out

pub fn rt_value_to_string(value: i64) -> i64:
    rt_to_string(value)

pub fn rt_raw_u64_to_string(raw: i64) -> i64:
    var n = raw
    val buf = _sffi_core_string_malloc(32)
    if buf < 1:
        return 3
    if n < 1:
        _sffi_core_string_spl_store_u8(buf, 0, 48)
        return rt_string_new(buf, 1)

    var len = 0
    while n > 0:
        val digit = n % 10
        _sffi_core_string_spl_store_u8(buf, len, 48 + digit)
        len = len + 1
        n = n / 10

    val out = alloc_string(len)
    val out_ptr = string_ptr(out)
    if out_ptr < 1:
        return 3
    var out_i = 0
    var i = len - 1
    while i >= 0:
        _sffi_core_string_spl_store_u8(string_data_ptr_value(out_ptr), out_i, _sffi_core_string_spl_load_u8(buf, i))
        out_i = out_i + 1
        i = i - 1
    out

pub fn rt_raw_i64_to_string(raw: i64) -> i64:
    # Signed sibling of rt_raw_u64_to_string. Digits are extracted on the
    # negative side (digit = 0 - (n % 10)) so INT64_MIN never overflows.
    if raw == 0:
        val zbuf = _sffi_core_string_malloc(32)
        if zbuf < 1:
            return 3
        _sffi_core_string_spl_store_u8(zbuf, 0, 48)
        return rt_string_new(zbuf, 1)

    var n = raw
    val neg = raw < 0
    if not neg:
        n = 0 - n

    val buf = _sffi_core_string_malloc(32)
    if buf < 1:
        return 3
    var len = 0
    while n < 0:
        val digit = 0 - (n % 10)
        _sffi_core_string_spl_store_u8(buf, len, 48 + digit)
        len = len + 1
        n = n / 10
    if neg:
        _sffi_core_string_spl_store_u8(buf, len, 45)
        len = len + 1

    val out = alloc_string(len)
    val out_ptr = string_ptr(out)
    if out_ptr < 1:
        return 3
    var out_i = 0
    var i = len - 1
    while i >= 0:
        _sffi_core_string_spl_store_u8(string_data_ptr_value(out_ptr), out_i, _sffi_core_string_spl_load_u8(buf, i))
        out_i = out_i + 1
        i = i - 1
    out

pub fn rt_string_replace(value: i64, old_value: i64, new_value: i64) -> i64:
    val ptr = string_ptr(value)
    val old_ptr = string_ptr(old_value)
    val new_ptr = string_ptr(new_value)
    if ptr < 1 or old_ptr < 1 or new_ptr < 1:
        return value
    val len = string_len_ptr(ptr)
    val old_len = string_len_ptr(old_ptr)
    val new_len = string_len_ptr(new_ptr)
    if old_len < 1:
        return value

    var count = 0
    var i = 0
    while i + old_len <= len:
        val cmp = _sffi_core_string_memcmp(string_data_ptr_value(ptr) + i, string_data_ptr_value(old_ptr), old_len)
        if cmp > -1 and cmp < 1:
            count = count + 1
            i = i + old_len
        else:
            i = i + 1
    if count < 1:
        return value

    var out_len = len
    if new_len >= old_len:
        out_len = out_len + count * (new_len - old_len)
    else:
        out_len = out_len - count * (old_len - new_len)
    val out = alloc_string(out_len)
    val out_ptr = string_ptr(out)
    if out_ptr < 1:
        return 3

    var in_i = 0
    var out_i = 0
    while in_i < len:
        var matched = 0
        if in_i + old_len <= len:
            val cmp = _sffi_core_string_memcmp(string_data_ptr_value(ptr) + in_i, string_data_ptr_value(old_ptr), old_len)
            if cmp > -1 and cmp < 1:
                matched = 1
        if matched > 0:
            if new_len > 0:
                _sffi_core_string_memcpy(string_data_ptr_value(out_ptr) + out_i, string_data_ptr_value(new_ptr), new_len)
            out_i = out_i + new_len
            in_i = in_i + old_len
        else:
            _sffi_core_string_spl_store_u8(string_data_ptr_value(out_ptr), out_i, _sffi_core_string_spl_load_u8(string_data_ptr_value(ptr), in_i))
            out_i = out_i + 1
            in_i = in_i + 1
    return out

pub fn rt_stdout_write(value: i64) -> i64:
    return write_string_to_fd(1, value)

pub fn rt_stderr_write(value: i64) -> i64:
    return write_string_to_fd(2, value)

pub fn print_raw(value: i64) -> i64:
    write_string_to_fd(1, value)
    return 0

pub fn rt_print_value(value: i64) -> i64:
    write_string_to_fd(1, value)
    return 0

# Writes a fixed one-line diagnostic to `fd` when rt_print_str/rt_eprint_str
# is handed a (ptr, len) pair whose ptr falls inside the null page (< 4096) —
# never a legitimate heap/rodata address. Distinguishes a corrupted/miscompiled
# argument pair (silent data loss) from a legitimate empty string (ptr == 0),
# which stays silent unchanged. Byte-stored via spl_store_u8 (same idiom the
# file already uses to emit the trailing newline in rt_println_str et al.)
# rather than a string literal, since this file predates/implements the
# String type itself.
fn write_null_page_diag(fd: i64) -> i64:
    val buf = _sffi_core_string_malloc(45)
    if buf < 1:
        return 0
    _sffi_core_string_spl_store_u8(buf, 0, 105)
    _sffi_core_string_spl_store_u8(buf, 1, 110)
    _sffi_core_string_spl_store_u8(buf, 2, 118)
    _sffi_core_string_spl_store_u8(buf, 3, 97)
    _sffi_core_string_spl_store_u8(buf, 4, 108)
    _sffi_core_string_spl_store_u8(buf, 5, 105)
    _sffi_core_string_spl_store_u8(buf, 6, 100)
    _sffi_core_string_spl_store_u8(buf, 7, 32)
    _sffi_core_string_spl_store_u8(buf, 8, 116)
    _sffi_core_string_spl_store_u8(buf, 9, 101)
    _sffi_core_string_spl_store_u8(buf, 10, 120)
    _sffi_core_string_spl_store_u8(buf, 11, 116)
    _sffi_core_string_spl_store_u8(buf, 12, 32)
    _sffi_core_string_spl_store_u8(buf, 13, 112)
    _sffi_core_string_spl_store_u8(buf, 14, 116)
    _sffi_core_string_spl_store_u8(buf, 15, 114)
    _sffi_core_string_spl_store_u8(buf, 16, 32)
    _sffi_core_string_spl_store_u8(buf, 17, 40)
    _sffi_core_string_spl_store_u8(buf, 18, 110)
    _sffi_core_string_spl_store_u8(buf, 19, 117)
    _sffi_core_string_spl_store_u8(buf, 20, 108)
    _sffi_core_string_spl_store_u8(buf, 21, 108)
    _sffi_core_string_spl_store_u8(buf, 22, 45)
    _sffi_core_string_spl_store_u8(buf, 23, 112)
    _sffi_core_string_spl_store_u8(buf, 24, 97)
    _sffi_core_string_spl_store_u8(buf, 25, 103)
    _sffi_core_string_spl_store_u8(buf, 26, 101)
    _sffi_core_string_spl_store_u8(buf, 27, 41)
    _sffi_core_string_spl_store_u8(buf, 28, 58)
    _sffi_core_string_spl_store_u8(buf, 29, 32)
    _sffi_core_string_spl_store_u8(buf, 30, 111)
    _sffi_core_string_spl_store_u8(buf, 31, 117)
    _sffi_core_string_spl_store_u8(buf, 32, 116)
    _sffi_core_string_spl_store_u8(buf, 33, 112)
    _sffi_core_string_spl_store_u8(buf, 34, 117)
    _sffi_core_string_spl_store_u8(buf, 35, 116)
    _sffi_core_string_spl_store_u8(buf, 36, 32)
    _sffi_core_string_spl_store_u8(buf, 37, 100)
    _sffi_core_string_spl_store_u8(buf, 38, 114)
    _sffi_core_string_spl_store_u8(buf, 39, 111)
    _sffi_core_string_spl_store_u8(buf, 40, 112)
    _sffi_core_string_spl_store_u8(buf, 41, 112)
    _sffi_core_string_spl_store_u8(buf, 42, 101)
    _sffi_core_string_spl_store_u8(buf, 43, 100)
    _sffi_core_string_spl_store_u8(buf, 44, 10)
    _sffi_core_string_write(fd, buf, 45)
    return 0

pub fn rt_print_str(ptr: i64, len: i64) -> i64:
    if ptr != 0 and ptr < 4096:
        write_null_page_diag(2)
        return 0
    if ptr > 0 and len > 0:
        _sffi_core_string_write(1, ptr, len)
    return 0

pub fn rt_println_value(value: i64) -> i64:
    write_string_to_fd(1, value)
    val nl = _sffi_core_string_malloc(1)
    if nl > 0:
        _sffi_core_string_spl_store_u8(nl, 0, 10)
        _sffi_core_string_write(1, nl, 1)
    return 0

pub fn rt_println_str(ptr: i64, len: i64) -> i64:
    rt_print_str(ptr, len)
