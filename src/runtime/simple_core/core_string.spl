        _sffi_core_string_spl_store_u8(nl, 0, 10)
        _sffi_core_string_write(1, nl, 1)
    return 0

pub fn rt_eprint_value(value: i64) -> i64:
    write_string_to_fd(2, value)
    return 0

pub fn rt_eprint_str(ptr: i64, len: i64) -> i64:
    if ptr != 0 and ptr < 4096:
        write_null_page_diag(2)
        return 0
    if ptr > 0 and len > 0:
        _sffi_core_string_write(2, ptr, len)
    return 0

pub fn rt_eprintln_value(value: i64) -> i64:
    write_string_to_fd(2, value)
    val nl = _sffi_core_string_malloc(1)
    if nl > 0:
        _sffi_core_string_spl_store_u8(nl, 0, 10)
        _sffi_core_string_write(2, nl, 1)
    return 0

pub fn rt_eprintln_str(ptr: i64, len: i64) -> i64:
    rt_eprint_str(ptr, len)
    val nl = _sffi_core_string_malloc(1)
    if nl > 0:
        _sffi_core_string_spl_store_u8(nl, 0, 10)
        _sffi_core_string_write(2, nl, 1)
    return 0

pub fn stdin_read_char() -> i64:
    val byte = _sffi_core_string_malloc(1)
    if byte < 1:
        return rt_string_new(0, 0)
    val count = _sffi_core_string_read(0, byte, 1)
    if count < 1:
        return rt_string_new(0, 0)
    return rt_string_new(byte, 1)

# ---------------------------------------------------------------------------
# Missing rt_string_* functions ported from the Rust runtime.
# ---------------------------------------------------------------------------

pub fn rt_string_eq(left: i64, right: i64) -> i64:
    if (left & 7) != 1 or (right & 7) != 1:
        return 0
    val left_ptr = left & -8
    val right_ptr = right & -8
    if left_ptr < 1 or right_ptr < 1:
        return 0
    if left_ptr == right_ptr:
        return 1
    val left_kind = _sffi_core_string_spl_load_i64(left_ptr, 0) & 4294967295
    val right_kind = _sffi_core_string_spl_load_i64(right_ptr, 0) & 4294967295
    if left_kind != 1398034993 or right_kind != 1398034993:
        return 0
    val left_len = _sffi_core_string_spl_load_i64(left_ptr, 8)
    if left_len != _sffi_core_string_spl_load_i64(right_ptr, 8):
        return 0
    if left_len < 1:
        return 1
    val cmp = _sffi_core_string_memcmp(left_ptr + 16, right_ptr + 16, left_len)
    if cmp < 0 or cmp > 0:
        return 0
    return 1

# rt_string_char_at — byte-indexed (not UTF-8 codepoint-indexed like the Rust
# version).  Returns a 1-byte string for the byte at `index`, or nil (3) if
# out of bounds.
pub fn rt_string_char_at(value: i64, index: i64) -> i64:
    val ptr = string_ptr(value)
    if ptr < 1:
        return 3
    val len = string_len_ptr(ptr)
    if index < 0 or index >= len:
        return 3
    val byte = _sffi_core_string_spl_load_u8(string_data_ptr_value(ptr), index)
    val out = alloc_string(1)
    val out_ptr = string_ptr(out)
    if out_ptr < 1:
        return 3
    _sffi_core_string_spl_store_u8(string_data_ptr_value(out_ptr), 0, byte)
    return out

# rt_string_find — return byte-offset of first occurrence of needle, or -1.
pub fn rt_string_find(value: i64, needle: i64) -> i64:
    val ptr = string_ptr(value)
    val needle_ptr = string_ptr(needle)
    if ptr < 1 or needle_ptr < 1:
        return -1
    val len = string_len_ptr(ptr)
    val needle_len = string_len_ptr(needle_ptr)
    if needle_len < 1:
        return 0
    if needle_len > len:
        return -1
    var i = 0
    while i + needle_len <= len:
        val cmp = _sffi_core_string_memcmp(string_data_ptr_value(ptr) + i, string_data_ptr_value(needle_ptr), needle_len)
        if cmp > -1 and cmp < 1:
            return i
        i = i + 1
    return -1

pub fn rt_string_contains(value: i64, needle: i64) -> i64:
    if rt_string_find(value, needle) >= 0:
        return 1
    return 0

# rt_text_find — positional byte search used by parsers that cannot safely
# materialize and search a non-zero substring receiver in native mode. Also
# the lowering target of two-arg text `index_of(needle, start)`. Negative
# start clamps to 0 (matches the C native runtime and Rust runtime crate).
pub fn rt_text_find(value: i64, needle: i64, start: i64) -> i64:
    val ptr = string_ptr(value)
    val needle_ptr = string_ptr(needle)
    if ptr < 1 or needle_ptr < 1:
        return -1
    val s_start = if start < 0: 0 else: start
    val len = string_len_ptr(ptr)
    val needle_len = string_len_ptr(needle_ptr)
    if needle_len < 1:
        return if s_start < len: s_start else: len
    if s_start >= len or needle_len > len:
        return -1
    var i = s_start
    while i + needle_len <= len:
        val cmp = _sffi_core_string_memcmp(string_data_ptr_value(ptr) + i, string_data_ptr_value(needle_ptr), needle_len)
        if cmp > -1 and cmp < 1:
            return i
        i = i + 1
    -1

# rt_string_rfind — return byte-offset of last occurrence of needle, or -1.
pub fn rt_string_rfind(value: i64, needle: i64) -> i64:
    val ptr = string_ptr(value)
    val needle_ptr = string_ptr(needle)
    if ptr < 1 or needle_ptr < 1:
        return -1
    val len = string_len_ptr(ptr)
    val needle_len = string_len_ptr(needle_ptr)
    if needle_len < 1:
        return len
    if needle_len > len:
        return -1
    var i = len - needle_len
    while i >= 0:
        val cmp = _sffi_core_string_memcmp(string_data_ptr_value(ptr) + i, string_data_ptr_value(needle_ptr), needle_len)
        if cmp > -1 and cmp < 1:
            return i
        i = i - 1
    return -1

pub fn rt_string_index_of(value: i64, needle: i64) -> i64:
    val found = rt_string_find(value, needle)
    if found < 0:
        return _sffi_core_string_rt_enum_new(1, 1, 3)
    return _sffi_core_string_rt_enum_new(1, 0, found)

# rt_string_split — split value by delimiter, returning a new array of strings.
pub fn rt_string_split(value: i64, delimiter: i64) -> i64:
    val ptr = string_ptr(value)
    val del_ptr = string_ptr(delimiter)
    if ptr < 1 or del_ptr < 1:
        return _sffi_core_string_rt_array_new(4)
    val len = string_len_ptr(ptr)
    val del_len = string_len_ptr(del_ptr)
    val result = _sffi_core_string_rt_array_new(4)

    if del_len < 1:
        # Empty delimiter: split every byte into its own string.
        var i = 0
        while i < len:
            val part = rt_string_new(string_data_ptr_value(ptr) + i, 1)
            _sffi_core_string_rt_array_push(result, part)
            i = i + 1
        return result

    var start = 0
    while start <= len:
        # Search for delimiter starting at `start`.
        var found = -1
        if start + del_len <= len:
            var j = start
            while j + del_len <= len:
                val cmp = _sffi_core_string_memcmp(string_data_ptr_value(ptr) + j, string_data_ptr_value(del_ptr), del_len)
                if cmp > -1 and cmp < 1:
                    found = j
                    j = len + 1
                else:
                    j = j + 1
        if found < 0:
            # No more delimiters — push remainder and break.
            val part = rt_string_new(string_data_ptr_value(ptr) + start, len - start)
            _sffi_core_string_rt_array_push(result, part)
            start = len + 1
        else:
            val part = rt_string_new(string_data_ptr_value(ptr) + start, found - start)
            _sffi_core_string_rt_array_push(result, part)
            start = found + del_len
    return result

# Bounded split with splitn semantics. A non-positive limit preserves the
# historical unlimited behavior; limit 1 returns the complete input.
pub fn rt_string_split_limit(value: i64, delimiter: i64, limit: i64) -> i64:
    if limit <= 0:
        return rt_string_split(value, delimiter)
    val ptr = string_ptr(value)
    val del_ptr = string_ptr(delimiter)
    if ptr < 1 or del_ptr < 1:
        return _sffi_core_string_rt_array_new(4)
    val len = string_len_ptr(ptr)
    val del_len = string_len_ptr(del_ptr)
    val result = _sffi_core_string_rt_array_new(4)
    if limit == 1:
        _sffi_core_string_rt_array_push(result, value)
        return result
    if del_len < 1:
        var byte_start = 0
        while byte_start < len and _sffi_core_string_rt_array_len(result) < limit - 1:
            _sffi_core_string_rt_array_push(result, rt_string_new(string_data_ptr_value(ptr) + byte_start, 1))
            byte_start = byte_start + 1
        _sffi_core_string_rt_array_push(result, rt_string_new(string_data_ptr_value(ptr) + byte_start, len - byte_start))
        return result
    var start = 0
    var count = 1
    while start <= len and count < limit:
        var found = -1
        var j = start
        while j + del_len <= len and found < 0:
            if _sffi_core_string_memcmp(string_data_ptr_value(ptr) + j, string_data_ptr_value(del_ptr), del_len) == 0:
                found = j
            else:
                j = j + 1
        if found < 0:
            _sffi_core_string_rt_array_push(result, rt_string_new(string_data_ptr_value(ptr) + start, len - start))
            return result
        else:
            _sffi_core_string_rt_array_push(result, rt_string_new(string_data_ptr_value(ptr) + start, found - start))
            start = found + del_len
            count = count + 1
    if start <= len:
        _sffi_core_string_rt_array_push(result, rt_string_new(string_data_ptr_value(ptr) + start, len - start))
    return result

# rt_string_join — join an array of strings with a separator.
pub fn rt_string_join(array: i64, separator: i64) -> i64:
    # Raw low-address gate BEFORE rt_array_len: under one-binary freestanding
    # the seed inlines rt_array_len at this first use and folds away its
    # internal array_is_valid guard, so a raw-0 / nil array handle reaches the
    # bare (handle&-8)+8 length load and faults (cr2=0x8). This explicit literal
    # check runs first and is not folded away (mirror of array_is_valid's own
    # `< 4096` gate).
    if array < 4096:
        return rt_string_new(0, 0)
    val arr_len = _sffi_core_string_rt_array_len_safe(array)
    if arr_len <= 0:
        return rt_string_new(0, 0)
    val sep_ptr = string_ptr(separator)
    var sep_len = 0
    if sep_ptr > 0:
        sep_len = string_len_ptr(sep_ptr)

    # First pass: compute total length.
    var total = 0
    var i = 0
    while i < arr_len:
        val elem = _sffi_core_string_rt_array_get(array, i)
        val elem_ptr = string_ptr(elem)
        if elem_ptr > 0:
            total = total + string_len_ptr(elem_ptr)
        if i > 0 and sep_len > 0:
            total = total + sep_len
        i = i + 1

    val out = alloc_string(total)
    val out_ptr = string_ptr(out)
    if out_ptr < 1:
        return 3

    # Second pass: copy.
    var offset = 0
    i = 0
    while i < arr_len:
        if i > 0 and sep_len > 0:
            _sffi_core_string_memcpy(string_data_ptr_value(out_ptr) + offset, string_data_ptr_value(sep_ptr), sep_len)
            offset = offset + sep_len
        val elem = _sffi_core_string_rt_array_get(array, i)
        val elem_ptr = string_ptr(elem)
        if elem_ptr > 0:
            val elem_len = string_len_ptr(elem_ptr)
            if elem_len > 0:
                _sffi_core_string_memcpy(string_data_ptr_value(out_ptr) + offset, string_data_ptr_value(elem_ptr), elem_len)
                offset = offset + elem_len
        i = i + 1
    return out

# rt_string_to_upper — ASCII-only uppercase conversion (a-z -> A-Z).
pub fn rt_string_to_upper(value: i64) -> i64:
    val ptr = string_ptr(value)
    if ptr < 1:
        return value
    val len = string_len_ptr(ptr)
    if len < 1:
        return value
    val out = alloc_string(len)
    val out_ptr = string_ptr(out)
    if out_ptr < 1:
        return 3
    var i = 0
    while i < len:
        var ch = _sffi_core_string_spl_load_u8(string_data_ptr_value(ptr), i)
        if ch >= 97 and ch <= 122:
            ch = ch - 32
        _sffi_core_string_spl_store_u8(string_data_ptr_value(out_ptr), i, ch)
        i = i + 1
    return out

# rt_string_to_lower — ASCII-only lowercase conversion (A-Z -> a-z).
pub fn rt_string_to_lower(value: i64) -> i64:
    val ptr = string_ptr(value)
    if ptr < 1:
        return value
    val len = string_len_ptr(ptr)
    if len < 1:
        return value
    val out = alloc_string(len)
    val out_ptr = string_ptr(out)
    if out_ptr < 1:
        return 3
    var i = 0
    while i < len:
        var ch = _sffi_core_string_spl_load_u8(string_data_ptr_value(ptr), i)
        if ch >= 65 and ch <= 90:
            ch = ch + 32
        _sffi_core_string_spl_store_u8(string_data_ptr_value(out_ptr), i, ch)
        i = i + 1
    return out

# rt_string_to_float — parse a decimal float string and return a tagged float
# value (tag 2).  Returns nil (3) on failure.
pub fn rt_string_to_float(value: i64) -> i64:
    val ptr = string_ptr(value)
    if ptr < 1:
        return 3
    val len = string_len_ptr(ptr)
    if len < 1:
        return 3
    val data = string_data_ptr_value(ptr)
    val end_slot = _sffi_core_string_malloc(8)
    if end_slot < 1:
        return 3
    val parsed = _sffi_core_string_strtod(data, end_slot)
    val end_ptr = _sffi_core_string_spl_load_i64(end_slot, 0)
    _sffi_core_string_free(end_slot)
    if end_ptr <= data:
        return 3
    val finish = data + len
    var cursor = end_ptr
    while cursor < finish:
        if is_space_byte(_sffi_core_string_spl_load_u8(cursor, 0)) < 1:
            return 3
        cursor = cursor + 1
    return _sffi_core_string_value_float(parsed)

# -- Lexer source cache (mirrors src/runtime/runtime_native.c
# rt_lexer_source_set / rt_lexer_source_slice). The parser/lexer set the
# active source once and slice it by CHAR index. Scalar module vars land in
# zeroed .bss, which is reliable under freestanding native-build (unlike
# module-level array initializers — see fs_exec_resolve.spl's
# FREESTANDING DISCIPLINE note). Single-threaded guest tool: no lock needed
# here, unlike the hosted C twin.
var g_lexer_source_ptr: i64 = 0
var g_lexer_source_len: i64 = 0

pub fn rt_lexer_source_set(source_ptr: i64, source_len: i64) -> i8:
    if source_ptr < 1 and source_len > 0:
        return 0
    val replacement = _sffi_core_string_malloc(source_len + 1)
    if replacement < 1:
        return 0
    if source_len > 0:
        _sffi_core_string_memcpy(replacement, source_ptr, source_len)
    _sffi_core_string_spl_store_u8(replacement, source_len, 0)
    if g_lexer_source_ptr > 0:
        _sffi_core_string_free(g_lexer_source_ptr)
    g_lexer_source_ptr = replacement
    g_lexer_source_len = source_len
    return 1

fn lexer_source_char_to_byte(target: i64) -> i64:
    """Char index -> byte offset in the cached lexer source, or -1."""
    var chars = 0
    var i = 0
    while i < g_lexer_source_len:
        val marker = _sffi_core_string_spl_load_u8(g_lexer_source_ptr, i) & 192
        if marker < 128 or marker > 128:
            if chars >= target and chars <= target:
                return i
            chars = chars + 1
        i = i + 1
    if chars >= target and chars <= target:
        return g_lexer_source_len
    return -1

pub fn rt_lexer_source_slice(start: i64, end: i64) -> i64:
    if start < 0 or end < start:
        return 3
    val ustart = lexer_source_char_to_byte(start)
    val uend = lexer_source_char_to_byte(end)
    if ustart < 0 or uend < 0:
        return 3
    if g_lexer_source_ptr < 1:
        return rt_string_new(0, 0)
    return rt_string_new(g_lexer_source_ptr + ustart, uend - ustart)
