# ponytail: bootstrap-sized string sets only need a compact linear registry;
# replace it only if equality profiles show pointer validation is hot.
var string_registry_items: i64 = 0
var string_registry_len: i64 = 0
var string_registry_cap: i64 = 0

fn register_string_ptr(ptr: i64) -> i64:
    if string_registry_len >= string_registry_cap:
        val next_cap = if string_registry_cap < 1: 64 else: string_registry_cap * 2
        val next_items = _sffi_core_string_realloc(string_registry_items, next_cap * 8)
        if next_items < 1:
            return 0
        string_registry_items = next_items
        string_registry_cap = next_cap
    _sffi_core_string_spl_store_i64(string_registry_items, string_registry_len * 8, ptr)
    string_registry_len = string_registry_len + 1
    1

fn registered_string_ptr(value: i64) -> i64:
    if value < 4096 or (value & 7) != 1:
        return 0
    val candidate = value & -8
    var i = 0
    while i < string_registry_len:
        if _sffi_core_string_spl_load_i64(string_registry_items, i * 8) == candidate:
            return candidate
        i = i + 1
    0

fn unregister_string_ptr(ptr: i64):
    var i = 0
    while i < string_registry_len:
        if spl_load_i64(string_registry_items, i * 8) == ptr:
            val last = string_registry_len - 1
            if i < last:
                spl_store_i64(string_registry_items, i * 8, spl_load_i64(string_registry_items, last * 8))
            string_registry_len = last
            return
        i = i + 1

# Transient-string support (2026-08-31, spec: runtime_native.c
# RT_CORE_STRING_FLAG_TRANSIENT on RtCoreString.reserved). The pure-lane
# string header keeps its kind magic in the LOW 32 bits of the first word
# (string_ptr masks with 4294967295), so bit 32 of that word is free and
# carries the transient flag here. This lane has no shared short cache or
# literal intern, so C's RT_CORE_STRING_FLAG_SHARED exemption has no
# pure-lane counterpart (nothing ever sets shared).

fn string_transient_flag(ptr: i64) -> i64:
    return spl_load_i64(ptr, 0) & 4294967296

# Membership + flag probe for the transient machinery (core_memory.spl):
# returns the raw header ptr only for a registered, transient-flagged string.
pub fn string_transient_state(value: i64) -> i64:
    val ptr = registered_string_ptr(value)
    if ptr < 1:
        return 0
    if string_transient_flag(ptr) == 0:
        return 0
    return ptr

# Promotion clears the flag; returns whether it had been set (spec :2171).
pub fn string_promote_clear(ptr: i64) -> i64:
    val word = spl_load_i64(ptr, 0)
    if (word & 4294967296) == 0:
        return 0
    spl_store_i64(ptr, 0, word & -4294967297)
    return 1

# Scope-end reclamation: only a still-registered, still-flagged (unpromoted)
# string dies; membership is rechecked before freeing (spec :1673, :1679).
pub fn string_reclaim_transient(ptr: i64) -> i64:
    if registered_string_ptr(ptr | 1) < 1:
        return 0
    if string_transient_flag(ptr) == 0:
        return 0
    unregister_string_ptr(ptr)
    free(ptr)
    return 1

fn string_ptr(value: i64) -> i64:
    if (value & 7) < 1 or (value & 7) > 1:
        return 0
    val ptr = value & -8
    if ptr < 1:
        return 0
    val kind = _sffi_core_string_spl_load_i64(ptr, 0) & 4294967295
    if kind < 1398034993 or kind > 1398034993:
        return 0
    return ptr

fn string_data_ptr_value(ptr: i64) -> i64:
    return ptr + 16

fn string_len_ptr(ptr: i64) -> i64:
    return _sffi_core_string_spl_load_i64(ptr, 8)

fn write_string_to_fd(fd: i64, value: i64) -> i64:
    val ptr = string_ptr(value)
    if ptr < 1:
        return 0
    val len = string_len_ptr(ptr)
    if len < 1:
        return 0
    return _sffi_core_string_write(fd, string_data_ptr_value(ptr), len)

fn is_space_byte(ch: i64) -> i64:
    if ch > 31 and ch < 33:
        return 1
    if ch > 8 and ch < 14:
        return 1
    return 0

fn alloc_string(len: i64) -> i64:
    val ptr = _sffi_core_string_malloc(17 + len)
    if ptr < 1:
        return 3
    if register_string_ptr(ptr) < 1:
        _sffi_core_string_free(ptr)
        return 3
    _sffi_core_string_spl_store_i64(ptr, 0, 1398034993)
    _sffi_core_string_spl_store_i64(ptr, 8, len)
    _sffi_core_string_spl_store_u8(ptr, 16 + len, 0)
    # Transient-scope tracking (spec: runtime_native.c rt_core_register_string
    # :1140-:1156): a string born in an active, unpaused scope carries the
    # transient flag and is reclaimed at scope end unless promoted; a
    # tracking failure fails the allocation.
    val noted = _sffi_core_string_transient_note(ptr, 1)
    if noted < 0:
        unregister_string_ptr(ptr)
        _sffi_core_string_free(ptr)
        return 3
    if noted > 0:
        _sffi_core_string_spl_store_i64(ptr, 0, _sffi_core_string_spl_load_i64(ptr, 0) | 4294967296)
    return ptr | 1

pub fn rt_string_new(bytes: i64, len: i64) -> i64:
    if bytes < 1 and len > 0:
        return 3
    val out = alloc_string(len)
    val ptr = string_ptr(out)
    if ptr < 1:
        return 3
    if len > 0:
        _sffi_core_string_memcpy(ptr + 16, bytes, len)
    return out

pub fn rt_string_new_literal(bytes: i64, len: i64) -> i64:
    rt_string_new(bytes, len)

pub fn rt_text_slice_audit_note_range(src: i64, src_len: i64, begin: i64, finish: i64) -> i64:
    if src < 1 or src_len < 0 or begin < 0 or finish < begin or finish > src_len:
        return -1
    0

pub fn rt_string_len(value: i64) -> i64:
    val ptr = string_ptr(value)
    if ptr > 0:
        return string_len_ptr(ptr)
    if value > 65535:
        return _sffi_core_string_strlen(value)
    return -1

pub fn rt_string_data(value: i64) -> i64:
    val ptr = string_ptr(value)
    if ptr < 1:
        return 0
    return string_data_ptr_value(ptr)

# Raw builder handle layout: len @0, cap @8, byte buffer @16.
pub fn rt_string_builder_new() -> i64:
    val handle = _sffi_core_string_malloc(24)
    if handle < 1:
        return 0
    val data = _sffi_core_string_malloc(64)
    if data < 1:
        _sffi_core_string_free(handle)
        return 0
    _sffi_core_string_spl_store_i64(handle, 0, 0)
    _sffi_core_string_spl_store_i64(handle, 8, 64)
    _sffi_core_string_spl_store_i64(handle, 16, data)
    handle

pub fn rt_string_builder_push(handle: i64, value: i64) -> i64:
    if handle < 4096:
        return 0
    val src = rt_string_data(value)
    val add_len = rt_string_len(value)
    if src < 1 or add_len < 0:
        return 0
    val len = _sffi_core_string_spl_load_i64(handle, 0)
    var cap = _sffi_core_string_spl_load_i64(handle, 8)
    var data = _sffi_core_string_spl_load_i64(handle, 16)
    val needed = len + add_len
    if len < 0 or cap < 1 or data < 1 or needed < len:
        return 0
    if needed > cap:
        var new_cap = cap * 2
        while new_cap < needed:
            new_cap = new_cap * 2
        val grown = _sffi_core_string_realloc(data, new_cap)
        if grown < 1:
            return 0
        data = grown
        cap = new_cap
        _sffi_core_string_spl_store_i64(handle, 8, cap)
        _sffi_core_string_spl_store_i64(handle, 16, data)
    if add_len > 0:
        _sffi_core_string_memcpy(data + len, src, add_len)
    _sffi_core_string_spl_store_i64(handle, 0, needed)
    1

pub fn rt_string_builder_finish(handle: i64) -> i64:
    if handle < 4096:
        return 3
    val len = _sffi_core_string_spl_load_i64(handle, 0)
    val data = _sffi_core_string_spl_load_i64(handle, 16)
    if len < 0 or data < 1:
        return 3
    val out = rt_string_new(data, len)
    _sffi_core_string_free(data)
    _sffi_core_string_free(handle)
    out

pub fn rt_string_builder_len(handle: i64) -> i64:
    if handle < 4096:
        return -1
    _sffi_core_string_spl_load_i64(handle, 0)

pub fn rt_string_builder_free(handle: i64):
    if handle < 4096:
        return
    val data = _sffi_core_string_spl_load_i64(handle, 16)
    if data > 0:
        _sffi_core_string_free(data)
    _sffi_core_string_free(handle)

pub fn rt_string_bytes(value: i64) -> i64:
    val ptr = string_ptr(value)
    if ptr < 1:
        return _sffi_core_string_rt_array_new(0)
    val len = string_len_ptr(ptr)
    val out = _sffi_core_string_rt_array_new(len)
    var i = 0
    while i < len:
        # BUGFIX (byte_span_cross_module_misread_2026-07-19): store the RAW byte,
        # NOT _sffi_core_string_rt_value_int(byte). `.bytes()` is declared `[u8]`, and a `[u8]`
        # array (as produced by `[73u8,..]` literals and `push(u8)`) stores raw
        # untagged byte values in its slots — the `[u8]` element read truncates
        # the slot with `& 0xFF` and does NOT untag. Wrapping in rt_value_int
        # tagged the slot as `byte << 3` (_sffi_core_string_rt_value_int(73)=584=0x248), so the
        # `[u8]` read returned the tag's low byte (0x48=72) instead of 73. The
        # generic/[i64]/inferred read path conditionally untags, so it happened
        # to still work — which is why the corruption only surfaced at `[u8]`
        # sites (function params, struct fields like ByteSpan.data, `var x:[u8]`).
        # Storing raw matches push-built [u8] exactly and is correct at ALL sites.
        _sffi_core_string_rt_array_push(out, _sffi_core_string_spl_load_u8(string_data_ptr_value(ptr), i) & 255)
        i = i + 1
    return out

# Text-kind predicate. Split files (core_array) need this to tell a text
# handle from an array handle without duplicating the tag/kind decode.
pub fn rt_string_is_text(value: i64) -> i64:
    if string_ptr(value) > 0:
        return 1
    0

pub fn rt_string_chars(value: i64) -> i64:
    val ptr = string_ptr(value)
    if ptr < 1:
        return _sffi_core_string_rt_array_new(0)
    val data = string_data_ptr_value(ptr)
    val len = string_len_ptr(ptr)
    val out = _sffi_core_string_rt_array_new(len)
    if len < 1:
        return out
    # The pure runtime has no global short-string cache. Reuse each ASCII
    # handle within this conversion so lexer `source.chars()` does not retain
    # one heap string per source byte. Multibyte codepoints keep the existing
    # exact UTF-8 slice path.
    val ascii_cache = _sffi_core_string_calloc(256, 8)
    var byte_index = 0
    while byte_index < len:
        val b0 = _sffi_core_string_spl_load_u8(data, byte_index) & 255
        var width = 1
        if b0 >= 194 and b0 <= 223 and byte_index + 1 < len:
            width = 2
        elif b0 >= 224 and b0 <= 239 and byte_index + 2 < len:
            width = 3
        elif b0 >= 240 and b0 <= 244 and byte_index + 3 < len:
            width = 4
        var char_value = 0
        if width == 1 and ascii_cache > 0:
            val cache_offset = b0 * 8
            char_value = _sffi_core_string_spl_load_i64(ascii_cache, cache_offset)
            if char_value < 1:
                char_value = rt_string_new(data + byte_index, width)
                if string_ptr(char_value) > 0:
                    _sffi_core_string_spl_store_i64(ascii_cache, cache_offset, char_value)
        else:
            char_value = rt_string_new(data + byte_index, width)
        _sffi_core_string_rt_array_push(out, char_value)
        byte_index = byte_index + width
    if ascii_cache > 0:
        _sffi_core_string_free(ascii_cache)
    return out

# Return the Unicode code point at CHARACTER index `index`.
#
# Semantics are unchanged; only the cost is. Inside an ASCII prefix a character
# index is also a byte index, so scan bytes for the first one >= 0x80 and, when
# `index` falls strictly inside that prefix, read it directly instead of running
# the multi-byte decode loop below.
#
# NOTE: unlike the hosted C/Rust runtimes, this freestanding lane does NOT cache
# the all-ASCII result in the string header, so it stays O(index) per call rather
# than becoming O(1). The header bit the hosted runtimes use is bit 31 of the
# `reserved` field, which lands on the sign bit of the i64 word at offset 0 and
# is awkward to set safely from Simple. Filed as follow-up; this change is still
# a strict improvement (plain byte compare instead of full UTF-8 decode).
pub fn rt_string_char_code_at(value: i64, index: i64) -> i64:
    # Match the hosted C owner's rt_core_as_string guard: an arbitrary raw
    # C-string pointer may happen to have the heap tag bits, so validate it
    # against the managed-string registry before reading a header.
    val ptr = registered_string_ptr(value)
    if index < 0:
        return 0
    var data = value
    var len = 0
    if ptr > 0:
        data = string_data_ptr_value(ptr)
        len = string_len_ptr(ptr)
    else:
        if value < 1:
            return 0
        while _sffi_core_string_spl_load_u8(data, len) != 0:
            len = len + 1
    # ASCII-prefix short-circuit: if every byte up to and including `index` is
    # ASCII, the character at `index` is simply the byte at `index`.
    if index < len:
        var probe = 0
        while probe <= index and (_sffi_core_string_spl_load_u8(data, probe) & 255) < 128:
            probe = probe + 1
        if probe > index:
            return _sffi_core_string_spl_load_u8(data, index) & 255
    var byte_index = 0
    var char_index = 0
    while byte_index < len:
        val b0 = _sffi_core_string_spl_load_u8(data, byte_index) & 255
        var width = 1
        var code = b0
        if b0 >= 194 and b0 <= 223 and byte_index + 1 < len:
            width = 2
            code = ((b0 & 31) << 6) | (_sffi_core_string_spl_load_u8(data, byte_index + 1) & 63)
        elif b0 >= 224 and b0 <= 239 and byte_index + 2 < len:
            width = 3
            code = ((b0 & 15) << 12) | ((_sffi_core_string_spl_load_u8(data, byte_index + 1) & 63) << 6) | (_sffi_core_string_spl_load_u8(data, byte_index + 2) & 63)
        elif b0 >= 240 and b0 <= 244 and byte_index + 3 < len:
            width = 4
            code = ((b0 & 7) << 18) | ((_sffi_core_string_spl_load_u8(data, byte_index + 1) & 63) << 12) | ((_sffi_core_string_spl_load_u8(data, byte_index + 2) & 63) << 6) | (_sffi_core_string_spl_load_u8(data, byte_index + 3) & 63)
        if char_index == index:
            return code
        byte_index = byte_index + width
        char_index = char_index + 1
    return 0

pub fn __simple_rt_string_char_code_at(value: i64, index: i64) -> i64:
    rt_string_char_code_at(value, index)

# Return the raw BYTE at BYTE index `index`, or 0 if out of range.
#
# Deliberately NOT rt_string_char_code_at: that one is CHARACTER-indexed and
# the two disagree on any non-ASCII text ("café,".byte_at(3) is 195, the
# 0xC3 lead byte, while char_code_at(3) is 233 for 'é'). Byte-framing callers
# (e.g. the web renderer's browser_renderer_protocol.spl scanning for byte
# 10 '\n' / 44 ',') index the raw UTF-8 buffer directly, so a character index
# would desync the frame at the first multi-byte codepoint.
# O(1): straight buffer read, no codepoint walk needed.
pub fn rt_string_byte_at(value: i64, index: i64) -> i64:
    val ptr = string_ptr(value)
    if index < 0:
        return 0
    var data = value
    var len = 0
    if ptr > 0:
        data = string_data_ptr_value(ptr)
        len = string_len_ptr(ptr)
    else:
        if value < 1:
            return 0
        while _sffi_core_string_spl_load_u8(data, len) != 0:
            len = len + 1
    if index >= len:
        return 0
    return _sffi_core_string_spl_load_u8(data, index) & 255

pub fn __simple_rt_string_byte_at(value: i64, index: i64) -> i64:
    rt_string_byte_at(value, index)

pub fn text_dot_from_char_code(code: i64) -> i64:
    if code < 0 or code > 1114111 or (code >= 55296 and code <= 57343):
        return 3
    val data = _sffi_core_string_malloc(4)
    if data < 1:
        return 3
    var len = 1
    if code <= 127:
        _sffi_core_string_spl_store_u8(data, 0, code)
    elif code <= 2047:
        len = 2
        _sffi_core_string_spl_store_u8(data, 0, 192 | (code >> 6))
        _sffi_core_string_spl_store_u8(data, 1, 128 | (code & 63))
    elif code <= 65535:
        len = 3
        _sffi_core_string_spl_store_u8(data, 0, 224 | (code >> 12))
        _sffi_core_string_spl_store_u8(data, 1, 128 | ((code >> 6) & 63))
        _sffi_core_string_spl_store_u8(data, 2, 128 | (code & 63))
    else:
        len = 4
        _sffi_core_string_spl_store_u8(data, 0, 240 | (code >> 18))
        _sffi_core_string_spl_store_u8(data, 1, 128 | ((code >> 12) & 63))
        _sffi_core_string_spl_store_u8(data, 2, 128 | ((code >> 6) & 63))
        _sffi_core_string_spl_store_u8(data, 3, 128 | (code & 63))
    val out = rt_string_new(data, len)
    _sffi_core_string_free(data)
    out

# Canonical raw-i64 compiler/runtime ABI for integer `.chr()`/`.to_char()`.
pub fn rt_char_from_code(code: i64) -> i64:
    if code < 0 or code > 1114111 or (code >= 55296 and code <= 57343):
        return rt_string_new(0, 0)
    text_dot_from_char_code(code)

pub fn rt_any_add(left: i64, right: i64) -> i64:
    if (left & 7) == 1 or (right & 7) == 1:
        return rt_string_concat(rt_to_string(left), rt_to_string(right))
    return _sffi_core_string_rt_value_int(_sffi_core_string_rt_value_as_int(left) + _sffi_core_string_rt_value_as_int(right))

pub fn rt_str_hash(value: i64) -> i64:
    if (value & 7) < 1 or (value & 7) > 1:
        return 0
    val ptr = value & -8
    if ptr < 1:
        return 0
    val kind = _sffi_core_string_spl_load_i64(ptr, 0) & 4294967295
    if kind < 1398034993 or kind > 1398034993:
        return 0
    val len = _sffi_core_string_spl_load_i64(ptr, 8)
    val data = ptr + 16
    var h = 5381
    var i = 0
    while i + 3 < len:
        h = h * 1185921 +
            ((_sffi_core_string_spl_load_u8(data, i) & 255) * 35937) +
            ((_sffi_core_string_spl_load_u8(data, i + 1) & 255) * 1089) +
            ((_sffi_core_string_spl_load_u8(data, i + 2) & 255) * 33) +
            (_sffi_core_string_spl_load_u8(data, i + 3) & 255)
        i = i + 4
    while i < len:
        h = (h << 5) + h + (_sffi_core_string_spl_load_u8(data, i) & 255)
        i = i + 1
    return h

pub fn rt_hash_text(value: i64) -> i64:
    if (value & 7) < 1 or (value & 7) > 1:
        return 0
    val ptr = value & -8
    if ptr < 1:
        return 0
    val kind = _sffi_core_string_spl_load_i64(ptr, 0) & 4294967295
    if kind < 1398034993 or kind > 1398034993:
        return 0
    val len = _sffi_core_string_spl_load_i64(ptr, 8)
    val data = ptr + 16
    var h = 5381
    var i = 0
    while i + 3 < len:
        h = h * 1185921 +
            ((_sffi_core_string_spl_load_u8(data, i) & 255) * 35937) +
            ((_sffi_core_string_spl_load_u8(data, i + 1) & 255) * 1089) +
            ((_sffi_core_string_spl_load_u8(data, i + 2) & 255) * 33) +
            (_sffi_core_string_spl_load_u8(data, i + 3) & 255)
        i = i + 4
    while i < len:
        h = (h << 5) + h + (_sffi_core_string_spl_load_u8(data, i) & 255)
        i = i + 1
    return h

pub fn rt_string_concat(left: i64, right: i64) -> i64:
    val left_ptr = string_ptr(left)
    val right_ptr = string_ptr(right)
    if left_ptr < 1 or right_ptr < 1:
        return 3
    val left_len = string_len_ptr(left_ptr)
    val right_len = string_len_ptr(right_ptr)
    val out_len = left_len + right_len
    val out = alloc_string(out_len)
    val out_ptr = string_ptr(out)
    if out_ptr < 1:
        return 3
    if left_len > 0:
        _sffi_core_string_memcpy(string_data_ptr_value(out_ptr), string_data_ptr_value(left_ptr), left_len)
    if right_len > 0:
        _sffi_core_string_memcpy(string_data_ptr_value(out_ptr) + left_len, string_data_ptr_value(right_ptr), right_len)
    return out

# Concat-drop fix: pure-Simple mirror of the native rt_strcat_tagged
# (runtime_native.c). The native side has to normalize a "raw-char*-or-tagged"
# operand duality that only exists on the LLVM native path (string-literal
# globals lower to untagged char*); the interpreter always represents strings
# as tagged RtCoreString handles, so this is exactly rt_string_concat -- kept
# as a distinct named entry point so callers don't need to know which path
# they're on.
pub fn rt_strcat_tagged(left: i64, right: i64) -> i64:
    return rt_string_concat(left, right)

pub fn rt_len(value: i64) -> i64:
    val ptr = string_ptr(value)
    if ptr > 0:
        return string_len_ptr(ptr)
    if (value & 7) == 1 and value > 4095:
        val kind = _sffi_core_string_spl_load_u8(value & -8, 0)
        if kind == 2:
            return _sffi_core_string_rt_array_len(value)
        if kind == 6:
            return _sffi_core_string_rt_dict_len(value)
    return 0

fn runtime_integer_matches(value: i64, expected: i64) -> i64:
    if (value & 7) == 0:
        val signed = value >> 3
        return if signed >= 0 and expected >= 0 and signed == expected: 1 else: 0
    if (value & 7) == 1:
        val ptr = value & -8
        if ptr >= 4096 and (_sffi_core_string_spl_load_i64(ptr, 0) & 4294967295) == 0x55494E54:
            return if _sffi_core_string_spl_load_i64(ptr, 8) == expected: 1 else: 0
    return 0

fn rt_native_eq_inner(left: i64, right: i64, depth: i64) -> i64:
    if left == right:
        return 1
    # ponytail: the depth guard safely rejects cyclic aggregate graphs; add
    # visited-pair tracking only if cyclic structural equality is required.
    if depth >= 64:
        return 0
    val left_uint = if (left & 7) == 1 and (left & -8) >= 4096 and (_sffi_core_string_spl_load_i64(left & -8, 0) & 4294967295) == 0x55494E54: 1 else: 0
    val right_uint = if (right & 7) == 1 and (right & -8) >= 4096 and (_sffi_core_string_spl_load_i64(right & -8, 0) & 4294967295) == 0x55494E54: 1 else: 0
    if left_uint > 0 or right_uint > 0:
        if left_uint > 0 and right_uint > 0:
            return if _sffi_core_string_spl_load_i64(left & -8, 8) == _sffi_core_string_spl_load_i64(right & -8, 8): 1 else: 0
        if left_uint > 0 and (right & 7) == 0:
            val signed_right = right >> 3
            return if signed_right >= 0 and _sffi_core_string_spl_load_i64(left & -8, 8) >= 0 and _sffi_core_string_spl_load_i64(left & -8, 8) == signed_right: 1 else: 0
        if right_uint > 0 and (left & 7) == 0:
            val signed_left = left >> 3
            return if signed_left >= 0 and _sffi_core_string_spl_load_i64(right & -8, 8) >= 0 and signed_left == _sffi_core_string_spl_load_i64(right & -8, 8): 1 else: 0
        return 0
    val left_disc = _sffi_core_string_rt_enum_discriminant(left)
    val right_disc = _sffi_core_string_rt_enum_discriminant(right)
    if left_disc >= 0 or right_disc >= 0:
        if left_disc < 0 or right_disc < 0 or _sffi_core_string_rt_enum_id(left) != _sffi_core_string_rt_enum_id(right) or left_disc != right_disc:
            return 0
        return rt_native_eq_inner(_sffi_core_string_rt_enum_payload(left), _sffi_core_string_rt_enum_payload(right), depth + 1)
    val left_ptr = registered_string_ptr(left)
    val right_ptr = registered_string_ptr(right)
    if left_ptr > 0 or right_ptr > 0:
        if left_ptr < 1 or right_ptr < 1:
            return 0
        val len = _sffi_core_string_spl_load_i64(left_ptr, 8)
        if len != _sffi_core_string_spl_load_i64(right_ptr, 8):
            return 0
        if len < 1:
            return 1
        val cmp = _sffi_core_string_memcmp(left_ptr + 16, right_ptr + 16, len)
        if cmp < 0 or cmp > 0:
            return 0
        return 1
    val left_array = _sffi_core_string_array_is_valid(left) > 0
    val right_array = _sffi_core_string_array_is_valid(right) > 0
    if left_array or right_array:
        if not left_array or not right_array:
            return 0
        val len = _sffi_core_string_rt_array_len(left)
        if len != _sffi_core_string_rt_array_len(right):
            return 0
        val left_flags = _sffi_core_string_array_flags(left)
        val right_flags = _sffi_core_string_array_flags(right)
        val left_bytes = (left_flags & 8) > 0
        val right_bytes = (right_flags & 8) > 0
        val left_u64 = (left_flags & 16) > 0
        val right_u64 = (right_flags & 16) > 0
        val left_items = _sffi_core_string_array_items(left)
        val right_items = _sffi_core_string_array_items(right)
        var i = 0
        if left_bytes and right_bytes:
            while i < len:
                if _sffi_core_string_spl_load_u8(left_items, i) != _sffi_core_string_spl_load_u8(right_items, i):
                    return 0
                i = i + 1
            return 1
        if left_u64 and right_u64:
            while i < len:
                if _sffi_core_string_spl_load_i64(left_items, i * 8) != _sffi_core_string_spl_load_i64(right_items, i * 8):
                    return 0
                i = i + 1
            return 1
        while i < len:
            if left_bytes:
                val value = _sffi_core_string_spl_load_u8(left_items, i)
                if right_u64:
                    if _sffi_core_string_spl_load_i64(right_items, i * 8) != value:
                        return 0
                else:
                    val other = _sffi_core_string_spl_load_i64(right_items, i * 8)
                    if runtime_integer_matches(other, value) < 1:
                        return 0
            elif right_bytes:
                val value = _sffi_core_string_spl_load_u8(right_items, i)
                if left_u64:
                    if _sffi_core_string_spl_load_i64(left_items, i * 8) != value:
                        return 0
                else:
                    val other = _sffi_core_string_spl_load_i64(left_items, i * 8)
                    if runtime_integer_matches(other, value) < 1:
                        return 0
            elif left_u64:
                val other = _sffi_core_string_spl_load_i64(right_items, i * 8)
                if runtime_integer_matches(other, _sffi_core_string_spl_load_i64(left_items, i * 8)) < 1:
                    return 0
            elif right_u64:
                val other = _sffi_core_string_spl_load_i64(left_items, i * 8)
                if runtime_integer_matches(other, _sffi_core_string_spl_load_i64(right_items, i * 8)) < 1:
                    return 0
            else:
                if rt_native_eq_inner(_sffi_core_string_spl_load_i64(left_items, i * 8), _sffi_core_string_spl_load_i64(right_items, i * 8), depth + 1) < 1:
                    return 0
            i = i + 1
        return 1
    return 0

pub fn rt_native_eq(left: i64, right: i64) -> i64:
    rt_native_eq_inner(left, right, 0)

# Decode one rt_native_cmp text operand: a registered heap string yields its
# (data, len); anything else falls back to the raw-cstr convention this lane
# already uses in rt_string_len (`value > 65535` -> treat as NUL-terminated
# char*), mirroring the C spec's rt_interp_cstr (v < 0x10000 -> NULL -> "").
# Returns the data pointer and leaves the length in native_cmp_text_len.
var native_cmp_text_len: i64 = 0

fn native_cmp_text_operand(value: i64) -> i64:
    val ptr = registered_string_ptr(value)
    if ptr > 0:
        native_cmp_text_len = spl_load_i64(ptr, 8)
        return ptr + 16
    if value > 65535:
        native_cmp_text_len = strlen(value)
        return value
    native_cmp_text_len = 0
    return 0

# 2026-08-31 pure-Simple port of runtime_native.c rt_native_cmp (:3847):
# ordering counterpart of rt_native_eq for `<` `<=` `>` `>=` when codegen
# cannot statically prove either operand's type. Dispatch mirrors the C spec
# exactly:
#   - either side a registered heap string -> byte-wise lexicographic compare
#     (C: strcmp via rt_text_cmp_any; identical ordering for NUL-terminated
#     data, with the same raw-char* normalization for the other side)
#   - either side a tagged float -> numeric compare; the non-float side is
#     converted from its RAW i64 value (C: `(double)left`), NOT >>3-decoded —
#     decoding here would silently change the ABI for every dynamic caller
#   - otherwise -> raw signed integer compare, exactly what the inline icmp
#     arm would have done.
# Returns a strcmp-style signed result (<0, 0, >0).
pub fn rt_native_cmp(left: i64, right: i64) -> i64:
    val left_sptr = registered_string_ptr(left)
    val right_sptr = registered_string_ptr(right)
    if left_sptr > 0 or right_sptr > 0:
        val a = native_cmp_text_operand(left)
        val a_len = native_cmp_text_len
        val b = native_cmp_text_operand(right)
        val b_len = native_cmp_text_len
        val min_len = if a_len < b_len: a_len else: b_len
        if min_len > 0:
            val cmp = memcmp(a, b, min_len)
            if cmp < 0 or cmp > 0:
                return cmp
        if a_len < b_len:
            return -1
        if a_len > b_len:
            return 1
        return 0
    if (left & 7) == 2 or (right & 7) == 2:
        val a = if (left & 7) == 2: spl_bits_to_f64(left & -8) else: left as f64
        val b = if (right & 7) == 2: spl_bits_to_f64(right & -8) else: right as f64
        if a < b:
            return -1
        if a > b:
            return 1
        return 0
    if left < right:
        return -1
    if left > right:
        return 1
    return 0

pub fn rt_native_neq(left: i64, right: i64) -> i64:
    val eq = rt_native_eq(left, right)
    if eq < 1:
        return 1
    return 0

pub fn rt_native_cmp(left: i64, right: i64) -> i64:
    val left_ptr = string_ptr(left)
    val right_ptr = string_ptr(right)
    if left_ptr > 0 and right_ptr > 0:
        val left_len = string_len_ptr(left_ptr)
        val right_len = string_len_ptr(right_ptr)
        val shared_len = if left_len < right_len: left_len else: right_len
        if shared_len > 0:
            val compared = _sffi_core_string_memcmp(
                string_data_ptr_value(left_ptr),
                string_data_ptr_value(right_ptr),
                shared_len,
            )
            if compared < 0:
                return -1
            if compared > 0:
                return 1
        if left_len < right_len:
            return -1
        if left_len > right_len:
            return 1
        return 0
    if left < right:
        return -1
    if left > right:
        return 1
    0

pub fn rt_contains(collection: i64, value: i64) -> i8:
    val text_ptr = string_ptr(collection)
    val needle_ptr = string_ptr(value)
    if text_ptr > 0 and needle_ptr > 0:
        val idx = rt_string_find(collection, value)
        if idx >= 0:
            return 1
        return 0
    if (collection & 7) == 1 and collection > 4095:
        val kind = _sffi_core_string_spl_load_u8(collection & -8, 0)
        if kind == 6:
            return _sffi_core_string_rt_dict_contains(collection, value)
        if kind == 2:
            val len = _sffi_core_string_rt_array_len(collection)
            var i = 0
            while i < len:
                if rt_native_eq(_sffi_core_string_rt_array_get(collection, i), value) > 0:
                    return 1
                i = i + 1
    return 0

pub fn rt_slice(value: i64, start: i64, end: i64, step: i64) -> i64:
    if step == 0:
        return 3
    # Negative step (Python-style `s[::-1]`) is not part of the language --
    # see doc/04_architecture/language/slicing/+adr/
    # negative_step_not_supported_2026-07-30.md. Use `.reversed()` instead.
    # Mirrors this function's own existing convention for `step == 0`
    # (return the nil sentinel `3`) since this baremetal tier has no
    # stderr/abort story of its own. Before this check: the array branch
    # below silently implemented full Python-style reversal, while the
    # string branch below silently clamped any `step < 1` to `1` (forward
    # slice, ignoring the sign) -- a third divergence from both the
    # interpreter and default/native engines in src/compiler_rust.
    if step < 0:
        return 3
    val ptr = string_ptr(value)
    if ptr < 1:
        if _sffi_core_string_array_is_valid(value) < 1:
            return 3
        val array_ptr = value & -8
        val array_len = _sffi_core_string_rt_array_len_safe(value)
        var array_begin = if start < 0: array_len + start else: start
        var array_finish = if end < 0: array_len + end else: end
        if array_begin < 0:
            array_begin = 0
        if array_begin > array_len:
            array_begin = array_len
        if array_finish < 0:
            array_finish = 0
        if array_finish > array_len:
            array_finish = array_len
        var count = 0
        var count_i = array_begin
        while (step > 0 and count_i < array_finish) or (step < 0 and count_i > array_finish):
            count = count + 1
            count_i = count_i + step
        val flags = _sffi_core_string_spl_load_u8(array_ptr, 1)
        val out = if (flags & 8) > 0: _sffi_core_string_rt_byte_array_new(count) elif (flags & 16) > 0: _sffi_core_string_rt_array_new_with_cap_u64(count) else: _sffi_core_string_rt_array_new(count)
        if out < 4096:
            return 3
        val source_items = _sffi_core_string_spl_load_i64(array_ptr, 24)
        val out_ptr = out & -8
        val out_items = _sffi_core_string_spl_load_i64(out_ptr, 24)
        var out_i = 0
        var array_i = array_begin
        while (step > 0 and array_i < array_finish) or (step < 0 and array_i > array_finish):
            if (flags & 8) > 0:
                _sffi_core_string_spl_store_u8(out_items, out_i, _sffi_core_string_spl_load_u8(source_items, array_i))
            else:
                _sffi_core_string_spl_store_i64(out_items, out_i * 8, _sffi_core_string_spl_load_i64(source_items, array_i * 8))
            out_i = out_i + 1
            array_i = array_i + step
        _sffi_core_string_spl_store_i64(out_ptr, 8, out_i)
        return out
    val len = string_len_ptr(ptr)
    var begin = start
    var finish = end
    var stride = step
    if stride < 1:
        stride = 1
    if begin < 0:
        begin = len + begin
    if finish < 0:
        finish = len + finish
    if begin < 0:
        begin = 0
    if finish < begin:
        finish = begin
    if begin > len:
        begin = len
    if finish > len:
        finish = len
    if stride > 1:
        var out_len = 0
        var i = begin
        while i < finish:
            out_len = out_len + 1
            i = i + stride
        val out = alloc_string(out_len)
        val out_ptr = string_ptr(out)
