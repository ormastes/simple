# Pure-Simple `simple-core` memory ABI wrappers.
#
# These are the first explicit host-primitive boundary for `simple-core`: the
# Simple runtime archive owns the required `rt_*` symbols and delegates raw
# allocation/memory operations to the platform C ABI.
#
# 2026-08-31: this file additionally owns the pure-Simple port of the C
# runtime's struct-allocation registry and transient-array-scope machinery
# (runtime_native.c is the specification; see
# doc/08_tracking/bug/simple_core_lane_missing_heap_registry_abi_2026-08-22.md).
#
# THREAD-LOCALITY NOTE (task-rule disclosure, do not delete): the C backing
# state for the transient scope and its promotion statistics is
# `_Thread_local` (runtime_native.c:1052-1069). This port uses module-level
# `var` globals instead, which is observationally equivalent ONLY under the
# simple-core lane's documented single-threaded contract (see
# core_values.spl `rt_pool_safepoint`: "simple-core bootstrap execution is
# single-threaded"; every sibling registry in this tree —
# array_registry_head, enum_registry_head, closure_registry_head,
# string_registry_* — already relies on the same contract). If this lane ever
# grows real threads, this state must become per-thread before the transient
# ABI can be considered faithful again.
#
# Registries here are linear "ponytail" tables, matching the lane's existing
# convention (core_array/core_enum/core_string): the C implementation's
# open-addressing hash tables, tombstone-purge heuristics and side-buffer
# release thresholds are PERFORMANCE choices, not semantics, and are
# deliberately not ported.

@unsafe(reason: "raw libc allocation; zero is the allocation-failure sentinel", capabilities: [ffi, raw_ptr])
extern fn malloc(size: i64) -> i64
@unsafe(reason: "raw libc release; pointer ownership is caller-established", capabilities: [ffi, raw_ptr])
extern fn free(ptr: i64)
@unsafe(reason: "raw libc reallocation; zero is failure and the input allocation remains owned", capabilities: [ffi, raw_ptr])
extern fn realloc(ptr: i64, size: i64) -> i64
@unsafe(reason: "raw memory copy; source and destination extents are caller-established", capabilities: [ffi, raw_ptr])
extern fn memcpy(dst: i64, src: i64, n: i64) -> i64
@unsafe(reason: "raw memory fill; destination extent is caller-established", capabilities: [ffi, raw_ptr])
extern fn memset(dst: i64, value: i64, n: i64) -> i64
@unsafe(reason: "raw pointer read; allocation extent and alignment are validated by the wrapper", capabilities: [ffi, raw_ptr])
extern fn spl_load_i64(ptr: i64, offset: i64) -> i64
@unsafe(reason: "raw pointer write; allocation extent and alignment are validated by the wrapper", capabilities: [ffi, raw_ptr])
extern fn spl_store_i64(ptr: i64, offset: i64, value: i64)
@unsafe(reason: "raw byte write; allocation extent is validated by the wrapper", capabilities: [ffi, raw_ptr])
extern fn spl_store_u8(ptr: i64, offset: i64, value: i64)
# Sibling-module heap registries (archive-internal, resolved at link time).
extern fn array_is_valid(array: i64) -> i64
extern fn array_items(array: i64) -> i64
extern fn array_len_value(array: i64) -> i64
extern fn array_cap(array: i64) -> i64
extern fn array_flags(array: i64) -> i64
extern fn rt_array_free(array: i64)
extern fn dict_is_valid(dict: i64) -> i64
extern fn dict_reclaim_transient(ptr: i64)
extern fn enum_is_valid(value: i64) -> i64
extern fn enum_reclaim_transient(ptr: i64)
extern fn rt_enum_payload(value: i64) -> i64
extern fn closure_is_valid(value: i64) -> i64
extern fn closure_reclaim_transient(ptr: i64)
extern fn string_transient_state(value: i64) -> i64
extern fn string_promote_clear(ptr: i64) -> i64
extern fn string_reclaim_transient(ptr: i64) -> i64
extern fn rt_string_len(value: i64) -> i64

# ----------------------------------------------------------------------------
# Struct-allocation registry (spec: runtime_native.c rt_struct_alloc_register /
# rt_struct_alloc_unregister / rt_struct_receiver_valid, :5737-:5775, :5834+).
# Linear table, stride 16: ptr @0, bytes @8.
# ----------------------------------------------------------------------------

var struct_alloc_items: i64 = 0
var struct_alloc_len: i64 = 0
var struct_alloc_cap: i64 = 0

fn struct_table_find(ptr: i64) -> i64:
    var i = 0
    while i < struct_alloc_len:
        if spl_load_i64(struct_alloc_items, i * 16) == ptr:
            return i
        i = i + 1
    return -1

fn struct_table_register(ptr: i64, bytes: i64) -> i64:
    if ptr < 1:
        return 0
    if struct_alloc_len >= struct_alloc_cap:
        val next_cap = if struct_alloc_cap < 1: 64 else: struct_alloc_cap * 2
        val next_items = realloc(struct_alloc_items, next_cap * 16)
        if next_items < 1:
            return 0
        struct_alloc_items = next_items
        struct_alloc_cap = next_cap
    spl_store_i64(struct_alloc_items, struct_alloc_len * 16, ptr)
    spl_store_i64(struct_alloc_items, struct_alloc_len * 16 + 8, bytes)
    struct_alloc_len = struct_alloc_len + 1
    return 1

fn struct_table_unregister(ptr: i64):
    if ptr < 1:
        return
    val idx = struct_table_find(ptr)
    if idx < 0:
        return
    val last = struct_alloc_len - 1
    if idx < last:
        spl_store_i64(struct_alloc_items, idx * 16, spl_load_i64(struct_alloc_items, last * 16))
        spl_store_i64(struct_alloc_items, idx * 16 + 8, spl_load_i64(struct_alloc_items, last * 16 + 8))
    struct_alloc_len = last

# ----------------------------------------------------------------------------
# Transient array scope state (spec: runtime_native.c :1052-1069, :1286-:1324).
# C uses a process-wide atomic for next_id and _Thread_local for the rest;
# see the thread-locality note at the top of this file.
# ----------------------------------------------------------------------------

var transient_scope_next_id: i64 = 1
var transient_scope_id: i64 = 0
var transient_scope_active: i64 = 0
var transient_scope_paused: i64 = 0

# Objects registered while the scope was active AND unpaused.
# Linear table, stride 24: ptr @0, kind @8, scope_id @16.
# Kinds mirror the C RtCoreTransientNode kinds:
#   1 = string, 2 = array, 3 = dict, 4 = enum, 6 = closure, 7 = raw.
# (5 = heap float does not exist in this lane: floats are tag-2 packed
# immediates, and UINT boxes are pre-existing unregistered leaves; both are
# classified as immediates here — documented deviation.)
var transient_objects_items: i64 = 0
var transient_objects_len: i64 = 0
var transient_objects_cap: i64 = 0

# Raw rt_alloc blocks seen while a scope is active.
# Linear table, stride 24: ptr @0, bytes @8, owned @16.
# owned mirrors the C RT_CORE_TRANSIENT_RAW_OWNED_BIT: set only when the
# block was allocated before the scope paused (rt_core_transient_raw_register
# passes owned = !paused); cleared by promotion; owned blocks still present at
# scope end are reclaimed.
var transient_raw_items: i64 = 0
var transient_raw_len: i64 = 0
var transient_raw_cap: i64 = 0

# Promotion statistics (spec: runtime_native.c :2073-:2091).
# last_* is a MOST-RECENT-PROMOTE window: rt_transient_heap_promote zeroes it
# on entry (:2124) and writes the final tallies (:2200-2201).
# scope_* is the running total across every promote in the current scope,
# accumulated with INT64_MAX saturation (:2202-2211) and zeroed ONLY by
# rt_transient_array_scope_begin (:1303-1304).
var transient_last_promoted_node_count: i64 = 0
var transient_last_promoted_byte_count: i64 = 0
var transient_scope_promoted_node_count: i64 = 0
var transient_scope_promoted_byte_count: i64 = 0

fn tobj_find(ptr: i64) -> i64:
    var i = 0
    while i < transient_objects_len:
        if spl_load_i64(transient_objects_items, i * 24) == ptr:
            return i
        i = i + 1
    return -1

fn tobj_append(ptr: i64, kind: i64, scope: i64) -> i64:
    if transient_objects_len >= transient_objects_cap:
        val next_cap = if transient_objects_cap < 1: 64 else: transient_objects_cap * 2
        # 16777216 mirrors C's RT_CORE_TRANSIENT_SCOPE_MAX_OBJECTS (1 << 24).
        if next_cap > 16777216:
            return 0
        val next_items = realloc(transient_objects_items, next_cap * 24)
        if next_items < 1:
            return 0
        transient_objects_items = next_items
        transient_objects_cap = next_cap
    val base = transient_objects_len * 24
    spl_store_i64(transient_objects_items, base, ptr)
    spl_store_i64(transient_objects_items, base + 8, kind)
    spl_store_i64(transient_objects_items, base + 16, scope)
    transient_objects_len = transient_objects_len + 1
    return 1

fn transient_raw_find(ptr: i64) -> i64:
    var i = 0
    while i < transient_raw_len:
        if spl_load_i64(transient_raw_items, i * 24) == ptr:
            return i
        i = i + 1
    return -1

fn transient_raw_erase(ptr: i64):
    val idx = transient_raw_find(ptr)
    if idx < 0:
        return
    val last = transient_raw_len - 1
    if idx < last:
        spl_store_i64(transient_raw_items, idx * 24, spl_load_i64(transient_raw_items, last * 24))
        spl_store_i64(transient_raw_items, idx * 24 + 8, spl_load_i64(transient_raw_items, last * 24 + 8))
        spl_store_i64(transient_raw_items, idx * 24 + 16, spl_load_i64(transient_raw_items, last * 24 + 16))
    transient_raw_len = last

# Spec: rt_core_transient_raw_register_state: "if (!ptr || !active) return
# ptr != NULL" — registration is a successful no-op when no scope is active.
fn transient_raw_register(ptr: i64, bytes: i64, owned: i64) -> i64:
    if ptr < 1:
        return 0
    if transient_scope_active < 1:
        return 1
    if transient_raw_len >= transient_raw_cap:
        val next_cap = if transient_raw_cap < 1: 256 else: transient_raw_cap * 2
        val next_items = realloc(transient_raw_items, next_cap * 24)
        if next_items < 1:
            return 0
        transient_raw_items = next_items
        transient_raw_cap = next_cap
    val base = transient_raw_len * 24
    spl_store_i64(transient_raw_items, base, ptr)
    spl_store_i64(transient_raw_items, base + 8, bytes)
    spl_store_i64(transient_raw_items, base + 16, owned)
    transient_raw_len = transient_raw_len + 1
    return 1

# Allocator hook for the sibling heap modules (core_array, core_array_ops,
# core_enum, core_closure, core_string). Returns 1 when the object was noted
# as transient (scope active AND unpaused — spec:
# rt_core_transient_scope_for_new_object), 0 when there is nothing to note,
# -1 when tracking failed (the caller must fail the allocation, mirroring
# rt_core_register_scoped_immortal's failure contract).
pub fn rt_simple_core_transient_note(ptr: i64, kind: i64) -> i64:
    if transient_scope_active < 1 or transient_scope_paused > 0:
        return 0
    if tobj_append(ptr, kind, transient_scope_id) < 1:
        return -1
    return 1

# ----------------------------------------------------------------------------
# Public ABI: scope lifecycle (spec: runtime_native.c :1286-:1324)
# ----------------------------------------------------------------------------

pub fn rt_transient_array_scope_begin() -> i8:
    # Refuse when a scope is already active or leftovers from an aborted
    # scope are still tracked (mirrors the C guard at :1287).
    if transient_scope_active > 0 or transient_objects_len != 0 or transient_raw_len != 0:
        return 0
    val next_id = transient_scope_next_id
    # The C id counter never hands out 0 and permanently refuses after the
    # u32 space is exhausted (:1289-1299).
    if next_id == 0:
        return 0
    transient_scope_next_id = if next_id == 4294967295: 0 else: next_id + 1
    transient_scope_id = next_id
    transient_scope_active = 1
    transient_scope_paused = 0
    # Reset asymmetry (spec :1303-1304): begin calls the reset — which zeroes
    # ONLY the last_* pair — and then zeroes the scope_* totals separately.
    rt_transient_promotion_stats_reset()
    transient_scope_promoted_node_count = 0
    transient_scope_promoted_byte_count = 0
    return 1

pub fn rt_transient_array_scope_pause() -> i8:
    if transient_scope_active < 1:
        return 0
    transient_scope_paused = 1
    return 1

pub fn rt_transient_array_scope_end() -> i8:
    if transient_scope_active < 1:
        return 0
    val scope = transient_scope_id
    transient_scope_active = 0
    transient_scope_paused = 0
    transient_reclaim_objects(scope)
    transient_reclaim_raw()
    return 1

# ----------------------------------------------------------------------------
# Public ABI: promotion statistics (spec: runtime_native.c :2073-:2091)
# ----------------------------------------------------------------------------

pub fn rt_transient_last_promoted_nodes() -> i64:
    transient_last_promoted_node_count

pub fn rt_transient_last_promoted_bytes() -> i64:
    transient_last_promoted_byte_count

pub fn rt_transient_scope_promoted_nodes() -> i64:
    transient_scope_promoted_node_count

pub fn rt_transient_scope_promoted_bytes() -> i64:
    transient_scope_promoted_byte_count

# Deliberately zeroes ONLY the last_* pair and leaves the scope_* running
# totals untouched (spec :2089-2092). That asymmetry is the pair's whole
# point: scope_begin zeroes the scope totals itself, right after calling this.
pub fn rt_transient_promotion_stats_reset():
    transient_last_promoted_node_count = 0
    transient_last_promoted_byte_count = 0

# ----------------------------------------------------------------------------
# Promotion (spec: runtime_native.c rt_transient_heap_promote :2122-:2218,
# rt_core_transient_classify :2017, rt_core_transient_add :2062,
# rt_core_transient_node_bytes :2094).
# ----------------------------------------------------------------------------

# transient_classify communicates (ptr, bytes) through these module vars; the
# lane is single-threaded and promote is not reentrant.
var classify_ptr: i64 = 0
var classify_bytes: i64 = 0

# Returns the node kind (see the table above), or 0 for an immediate,
# persistent string, or otherwise untracked value. The raw-alloc registry is
# consulted FIRST, and for a tagged value the tag bits are stripped before the
# raw lookup, exactly as in C (:2018-2027): the selfcheck promotes a raw
# carrier root passed as `ptr | 1`.
fn transient_classify(value: i64) -> i64:
    val rawp = if (value & 7) != 0: value & -8 else: value
    val raw_idx = transient_raw_find(rawp)
    if raw_idx >= 0:
        classify_ptr = rawp
        classify_bytes = spl_load_i64(transient_raw_items, raw_idx * 24 + 8)
        return 7
    # C rt_core_is_heap: only tag 1 is a heap reference.
    if (value & 7) != 1:
        return 0
    val ptr = value & -8
    if ptr < 4096:
        return 0
    # Per-kind registry membership replaces C's unified immortal registry;
    # membership is checked BEFORE any dereference of the candidate, guarding
    # the same tag-collision class the C comments call out. Any registered
    # array/dict/enum/closure is a plan node regardless of scope tag (so a
    # promote rooted at a persistent container succeeds and traverses it);
    # strings are plan nodes only while transient-flagged (C :2048-2054).
    if array_is_valid(value) > 0:
        classify_ptr = ptr
        classify_bytes = 0
        return 2
    if dict_is_valid(value) > 0:
        classify_ptr = ptr
        classify_bytes = 0
        return 3
    if enum_is_valid(value) > 0:
        classify_ptr = ptr
        classify_bytes = 0
        return 4
    if closure_is_valid(value) > 0:
        classify_ptr = ptr
        classify_bytes = 0
        return 6
    val sptr = string_transient_state(value)
    if sptr > 0:
        classify_ptr = sptr
        classify_bytes = 0
        return 1
    return 0

# Plan of nodes reachable from the promote root. Doubles as the seen-set
# (linear membership scan — C keeps a separate hash for speed only).
# Stride 24: ptr @0, kind @8, raw bytes @16.
var plan_items: i64 = 0
var plan_len: i64 = 0
var plan_cap: i64 = 0

fn plan_seen(ptr: i64) -> i64:
    var i = 0
    while i < plan_len:
        if spl_load_i64(plan_items, i * 24) == ptr:
            return 1
        i = i + 1
    return 0

fn plan_push(ptr: i64, kind: i64, bytes: i64) -> i64:
    if plan_len >= plan_cap:
        val next_cap = if plan_cap < 1: 32 else: plan_cap * 2
        if next_cap > 16777216:
            return 0
        val next_items = realloc(plan_items, next_cap * 24)
        if next_items < 1:
            return 0
        plan_items = next_items
        plan_cap = next_cap
    val base = plan_len * 24
    spl_store_i64(plan_items, base, ptr)
    spl_store_i64(plan_items, base + 8, kind)
    spl_store_i64(plan_items, base + 16, bytes)
    plan_len = plan_len + 1
    return 1

# 1 = added or skippable immediate, 0 = tracking failure (C returns -1 there;
# either way the promote fails).
fn transient_add(value: i64) -> i64:
    val kind = transient_classify(value)
    if kind < 1:
        return 1
    if plan_seen(classify_ptr) > 0:
        return 1
    return plan_push(classify_ptr, kind, classify_bytes)

# Pure-lane retained-byte accounting, mirroring rt_core_transient_node_bytes
# with THIS lane's object layouts (header sizes differ from C's; byte totals
# are a lane-local measure by design).
fn transient_node_bytes(ptr: i64, kind: i64, raw_bytes: i64) -> i64:
    if kind == 1:
        return 17 + rt_string_len(ptr | 1)
    if kind == 2:
        val elem = if (array_flags(ptr | 1) & 8) != 0: 1 else: 8
        return 40 + array_cap(ptr | 1) * elem
    if kind == 3:
        return 40 + spl_load_i64(ptr, 8) * 16
    if kind == 4:
        return 32
    if kind == 6:
        return 32 + spl_load_i64(ptr, 16) * 8
    if kind == 7:
        return raw_bytes
    return 0

pub fn rt_transient_heap_promote(value: i64) -> i8:
    # The refusal gate comes BEFORE the stats reset (spec :2123-:2125): a
    # refused promote must not clobber the last_* window.
    if transient_scope_active < 1 or transient_scope_paused < 1:
        return 0
    rt_transient_promotion_stats_reset()
    plan_len = 0
    var ok = 1
    # The ROOT must itself classify as a tracked node (spec :2127-:2128):
    # promote of an immediate or of a persistent/non-transient string returns
    # 0, while promote rooted at a persistent container returns 1.
    if transient_classify(value) < 1:
        ok = 0
    if ok > 0 and transient_add(value) < 1:
        ok = 0
    var i = 0
    while ok > 0 and i < plan_len:
        val node_ptr = spl_load_i64(plan_items, i * 24)
        val node_kind = spl_load_i64(plan_items, i * 24 + 8)
        val node_raw_bytes = spl_load_i64(plan_items, i * 24 + 16)
        if node_kind == 2:
            # Packed byte / u64 arrays carry no boxed children (spec :2133).
            if (array_flags(node_ptr | 1) & 24) == 0:
                val alen = array_len_value(node_ptr | 1)
                val aitems = array_items(node_ptr | 1)
                var j = 0
                while ok > 0 and j < alen:
                    if transient_add(spl_load_i64(aitems, j * 8)) < 1:
                        ok = 0
                    j = j + 1
        elif node_kind == 3:
            # Pure-lane dicts are dense linear (key, value) pairs, stride 16.
            val dlen = spl_load_i64(node_ptr, 16)
            val ditems = spl_load_i64(node_ptr, 32)
            var j = 0
            while ok > 0 and j < dlen:
                if transient_add(spl_load_i64(ditems, j * 16)) < 1:
                    ok = 0
                if ok > 0 and transient_add(spl_load_i64(ditems, j * 16 + 8)) < 1:
                    ok = 0
                j = j + 1
        elif node_kind == 4:
            if transient_add(rt_enum_payload(node_ptr | 1)) < 1:
                ok = 0
        elif node_kind == 6:
            val count = spl_load_i64(node_ptr, 16)
            var j = 0
            while ok > 0 and j < count:
                if transient_add(spl_load_i64(node_ptr, 32 + j * 8)) < 1:
                    ok = 0
                j = j + 1
        elif node_kind == 7:
            # Raw blocks are scanned word-by-word for aggregate edges
            # (spec :2154-:2160).
            var offset = 0
            while ok > 0 and offset + 8 <= node_raw_bytes:
                if transient_add(spl_load_i64(node_ptr, offset)) < 1:
                    ok = 0
                offset = offset + 8
        i = i + 1
    if ok > 0:
        var promoted_nodes: i64 = 0
        var promoted_bytes: i64 = 0
        var k = 0
        while k < plan_len:
            val node_ptr = spl_load_i64(plan_items, k * 24)
            val node_kind = spl_load_i64(plan_items, k * 24 + 8)
            val node_raw_bytes = spl_load_i64(plan_items, k * 24 + 16)
            var promoted = 0
            if node_kind == 1:
                promoted = string_promote_clear(node_ptr)
            elif node_kind == 7:
                val ridx = transient_raw_find(node_ptr)
                if ridx >= 0:
                    if spl_load_i64(transient_raw_items, ridx * 24 + 16) != 0:
                        promoted = 1
                    spl_store_i64(transient_raw_items, ridx * 24 + 16, 0)
            else:
                val tidx = tobj_find(node_ptr)
                if tidx >= 0 and spl_load_i64(transient_objects_items, tidx * 24 + 16) == transient_scope_id:
                    promoted = 1
                    spl_store_i64(transient_objects_items, tidx * 24 + 16, 0)
            if promoted > 0:
                val bytes = transient_node_bytes(node_ptr, node_kind, node_raw_bytes)
                promoted_nodes = promoted_nodes + 1
                # INT64_MAX saturation, never wraparound (spec :2196-:2199).
                if bytes > 9223372036854775807 - promoted_bytes:
                    promoted_bytes = 9223372036854775807
                else:
                    promoted_bytes = promoted_bytes + bytes
            k = k + 1
        transient_last_promoted_node_count = promoted_nodes
        transient_last_promoted_byte_count = promoted_bytes
        # scope_* accumulates the last_* tallies with the same saturation
        # (spec :2202-:2211); it is never zeroed here nor by the reset above.
        if promoted_nodes > 9223372036854775807 - transient_scope_promoted_node_count:
            transient_scope_promoted_node_count = 9223372036854775807
        else:
            transient_scope_promoted_node_count = transient_scope_promoted_node_count + promoted_nodes
        if promoted_bytes > 9223372036854775807 - transient_scope_promoted_byte_count:
            transient_scope_promoted_byte_count = 9223372036854775807
        else:
            transient_scope_promoted_byte_count = transient_scope_promoted_byte_count + promoted_bytes
    plan_len = 0
    return if ok > 0: 1 else: 0

# ----------------------------------------------------------------------------
# Scope-end reclamation (spec: runtime_native.c rt_core_reclaim_transient_
# immortal :1669 and rt_core_reclaim_transient_raw :1521). Objects still
# carrying this scope's tag (containers) or the transient flag (strings) die
# SILENTLY: each sibling registry is membership-gated, so a reclaimed handle
# reports invalid forever — no length, dropped pushes, no-op clears — exactly
# the scope-death contract rt_transient_heap_scope_selfcheck.c pins.
# ----------------------------------------------------------------------------

fn transient_reclaim_objects(scope: i64):
    var i = 0
    while i < transient_objects_len:
        val ptr = spl_load_i64(transient_objects_items, i * 24)
        val kind = spl_load_i64(transient_objects_items, i * 24 + 8)
        val entry_scope = spl_load_i64(transient_objects_items, i * 24 + 16)
        if kind == 1:
            # string_reclaim_transient rechecks registry membership and the
            # transient flag itself; a promoted string is left alone.
            string_reclaim_transient(ptr)
        elif entry_scope == scope:
            # Membership is rechecked before every free (spec :1673): an
            # object already freed mid-scope (e.g. rt_array_free) must not be
            # freed twice.
            if kind == 2:
                if array_is_valid(ptr | 1) > 0:
                    rt_array_free(ptr | 1)
            elif kind == 3:
                if dict_is_valid(ptr | 1) > 0:
                    dict_reclaim_transient(ptr)
            elif kind == 4:
                if enum_is_valid(ptr | 1) > 0:
                    enum_reclaim_transient(ptr)
            elif kind == 6:
                if closure_is_valid(ptr | 1) > 0:
                    closure_reclaim_transient(ptr)
        i = i + 1
    transient_objects_len = 0

fn transient_reclaim_raw():
    var i = 0
    while i < transient_raw_len:
        val ptr = spl_load_i64(transient_raw_items, i * 24)
        val owned = spl_load_i64(transient_raw_items, i * 24 + 16)
        if owned != 0:
            struct_table_unregister(ptr)
            free(ptr)
        i = i + 1
    transient_raw_len = 0

# ----------------------------------------------------------------------------
# Raw allocation ABI (transient-aware, spec: runtime_native.c :5824-:5938)
# ----------------------------------------------------------------------------

pub fn rt_alloc(size: i64) -> i64:
    val ptr = malloc(size)
    if ptr < 1:
        return 0
    # Registered on EVERY rt_alloc while a scope is active; owned only when
    # the scope has not paused yet (spec rt_core_transient_raw_register).
    val owned = if transient_scope_paused > 0: 0 else: 1
    if transient_raw_register(ptr, size, owned) < 1:
        free(ptr)
        return 0
    return ptr

pub fn rt_realloc(ptr: i64, size: i64) -> i64:
    val idx = transient_raw_find(ptr)
    if idx < 0:
        # Spec :5910 "if (!tracked) return realloc(ptr, size)": a block the
        # transient registry does not track — allocated before the scope, or
        # with no scope at all — stays UNTRACKED. Registering it here would
        # let scope-end free a pre-scope block (use-after-free).
        return realloc(ptr, size)
    if size == 0:
        # Spec :5911-:5915.
        transient_raw_erase(ptr)
        free(ptr)
        return 0
    # Tracked block: mirror the C malloc+register+copy+erase+free sequence
    # (spec :5916-:5927) so the owned bit is preserved and a registration
    # failure leaves the ORIGINAL block alive and tracked.
    val old_size = spl_load_i64(transient_raw_items, idx * 24 + 8)
    val owned = spl_load_i64(transient_raw_items, idx * 24 + 16)
    val next = malloc(size)
    if next < 1:
        return 0
    if transient_raw_register(next, size, owned) < 1:
        free(next)
        return 0
    memcpy(next, ptr, if old_size < size: old_size else: size)
    transient_raw_erase(ptr)
    free(ptr)
    return next

pub fn rt_free(ptr: i64) -> i64:
    # Spec rt_free :5930: unregister any struct allocation, erase any
    # transient raw entry, then release.
    struct_table_unregister(ptr)
    transient_raw_erase(ptr)
    free(ptr)
    return 0

# ----------------------------------------------------------------------------
# Struct allocation ABI (spec: runtime_native.c :5834-:5870). rt_struct_alloc
# routes through rt_alloc so a scope-born struct block enters the transient
# raw registry exactly like any other raw block (the selfcheck's carrier
# case), then registers in the struct table consulted by guarded field
# accesses. rt_struct_receiver_valid is the safety check itself: it must
# report 0 for a freed or never-struct-allocated receiver — an unconditional
# 1 here would silently remove a machine-checked safety net.
# ----------------------------------------------------------------------------

pub fn rt_struct_alloc(size: i64) -> i64:
    if size < 0:
        return 0
    val ptr = rt_alloc(size)
    if ptr < 1:
        return 0
    if struct_table_register(ptr, size) < 1:
        rt_free(ptr)
        return 0
    return ptr

pub fn rt_struct_receiver_valid(receiver: i64, byte_offset: i64, access_width: i64) -> i8:
    if receiver == 0 or byte_offset < 0 or access_width <= 0:
        return 0
    # Strip the value tag bits (C: ~RT_VALUE_TAG_MASK).
    val ptr = receiver & -8
    if ptr == 0:
        return 0
    val idx = struct_table_find(ptr)
    if idx < 0:
        return 0
    val bytes = spl_load_i64(struct_alloc_items, idx * 16 + 8)
    if byte_offset > bytes:
        return 0
    if access_width > bytes - byte_offset:
        return 0
    return 1

# ----------------------------------------------------------------------------
# Plain memory ABI wrappers (pre-existing)
# ----------------------------------------------------------------------------

pub fn rt_memcpy(dst: i64, src: i64, n: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]):
        return memcpy(dst, src, n)

# Core-library primitive. Callers pass a byte count; generic collections must
# scale their element count before crossing this ABI boundary.
pub fn copy_mem(dst: i64, src: i64, n: i64) -> i64:
    return rt_memcpy(dst, src, n)

pub fn rt_memset(dst: i64, value: i64, n: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]):
        return memset(dst, value, n)

pub fn rt_ptr_read_i64(addr: i64, offset: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]):
        spl_load_i64(addr, offset)

pub fn rt_ptr_write_i64(addr: i64, offset: i64, value: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]):
        spl_store_i64(addr, offset, value)
    return 0

pub fn rt_ptr_write_i32(addr: i64, offset: i64, value: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]):
        spl_store_u8(addr, offset, value & 255)
        spl_store_u8(addr, offset + 1, (value >> 8) & 255)
        spl_store_u8(addr, offset + 2, (value >> 16) & 255)
        spl_store_u8(addr, offset + 3, (value >> 24) & 255)
    return 0

pub fn rt_ptr_write_u8(addr: i64, offset: i64, value: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]):
        spl_store_u8(addr, offset, value)
    return 0

pub fn rt_function_not_found(name: i64, len: i64) -> i64:
    return 3

pub fn rt_interp_call(name: i64, len: i64, argc: i64, argv: i64) -> i64:
    return rt_function_not_found(name, len)
