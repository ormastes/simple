# Pure-Simple Linux x86-64 process-observation V1 provider.
#
# This is the adjacent runtime owner for the boxed `_value` ABI consumed by
# std.nogc_sync_mut.io.process_ops. It owns every descriptor, child identity,
# executable snapshot and generation until collection completes.

@unsafe(reason: "raw libc heap allocation ABI", capabilities: [ffi, raw_ptr])
extern fn calloc(count: i64, size: i64) -> i64
@unsafe(reason: "raw libc heap allocation ABI", capabilities: [ffi, raw_ptr])
extern fn malloc(size: i64) -> i64
@unsafe(reason: "raw libc owned heap release ABI", capabilities: [ffi, raw_ptr])
extern fn free(ptr: i64)
@unsafe(reason: "raw libc descriptor open ABI", capabilities: [ffi, raw_ptr])
extern fn open(path: i64, flags: i64) -> i64
@unsafe(reason: "raw libc descriptor close ABI", capabilities: [ffi])
extern fn close(fd: i64) -> i64
@unsafe(reason: "raw libc descriptor read ABI", capabilities: [ffi, raw_ptr])
extern fn read(fd: i64, buffer: i64, count: i64) -> i64
@unsafe(reason: "raw libc descriptor write ABI", capabilities: [ffi, raw_ptr])
extern fn write(fd: i64, buffer: i64, count: i64) -> i64
@unsafe(reason: "raw libc descriptor seek ABI", capabilities: [ffi])
extern fn lseek(fd: i64, offset: i64, whence: i64) -> i64
@unsafe(reason: "raw libc descriptor stat ABI", capabilities: [ffi, raw_ptr])
extern fn fstat(fd: i64, stat_buffer: i64) -> i64
@unsafe(reason: "raw libc path stat ABI", capabilities: [ffi, raw_ptr])
extern fn stat(path: i64, stat_buffer: i64) -> i64
@unsafe(reason: "raw libc descriptor mode ABI", capabilities: [ffi])
extern fn fchmod(fd: i64, mode: i64) -> i64
@unsafe(reason: "raw Linux anonymous-file ABI", capabilities: [ffi, raw_ptr])
extern fn memfd_create(name: i64, flags: i64) -> i64
@unsafe(reason: "raw Linux pipe descriptor ABI", capabilities: [ffi, raw_ptr])
extern fn pipe2(pipe_fds: i64, flags: i64) -> i64
@unsafe(reason: "raw libc descriptor control ABI", capabilities: [ffi])
extern fn fcntl(fd: i64, command: i64, arg: i64) -> i64
@unsafe(reason: "raw libc descriptor duplication ABI", capabilities: [ffi])
extern fn dup2(old_fd: i64, new_fd: i64) -> i64
@unsafe(reason: "raw libc process fork ABI", capabilities: [ffi])
extern fn fork() -> i64
@unsafe(reason: "raw libc child-only immediate exit ABI", capabilities: [ffi])
extern fn _exit(code: i64)
@unsafe(reason: "raw libc descriptor-backed exec ABI", capabilities: [ffi, raw_ptr])
extern fn fexecve(fd: i64, argv: i64, envp: i64) -> i64
@unsafe(reason: "raw libc nonblocking child wait/rusage ABI", capabilities: [ffi, raw_ptr])
extern fn wait4(pid: i64, status: i64, options: i64, rusage: i64) -> i64
@unsafe(reason: "raw libc process-group signal ABI", capabilities: [ffi])
extern fn kill(pid: i64, signal_number: i64) -> i64
@unsafe(reason: "raw libc process-group ownership ABI", capabilities: [ffi])
extern fn setpgid(pid: i64, pgid: i64) -> i64
@unsafe(reason: "raw libc monotonic-clock ABI", capabilities: [ffi, raw_ptr])
extern fn clock_gettime(clock_id: i64, timespec: i64) -> i64
@unsafe(reason: "raw libc bounded sleep ABI", capabilities: [ffi])
extern fn usleep(microseconds: i64) -> i64
@unsafe(reason: "raw Linux host identity ABI", capabilities: [ffi, raw_ptr])
extern fn uname(buffer: i64) -> i64
@unsafe(reason: "raw thread-local errno address ABI", capabilities: [ffi, raw_ptr])
extern fn __errno_location() -> i64

@unsafe(reason: "raw pointer i64 load ABI", capabilities: [ffi, raw_ptr])
extern fn spl_load_i64(ptr: i64, offset: i64) -> i64
@unsafe(reason: "raw pointer byte load ABI", capabilities: [ffi, raw_ptr])
extern fn spl_load_u8(ptr: i64, offset: i64) -> i64
@unsafe(reason: "raw pointer i64 store ABI", capabilities: [ffi, raw_ptr])
extern fn spl_store_i64(ptr: i64, offset: i64, value: i64)
@unsafe(reason: "raw pointer byte store ABI", capabilities: [ffi, raw_ptr])
extern fn spl_store_u8(ptr: i64, offset: i64, value: i64)
@unsafe(reason: "raw tagged array allocation ABI", capabilities: [ffi])
extern fn rt_array_new(capacity: i64) -> i64
@unsafe(reason: "raw tagged array value-transfer ABI", capabilities: [ffi])
extern fn rt_array_push(array: i64, value: i64) -> i8
@unsafe(reason: "raw tagged integer allocation ABI", capabilities: [ffi])
extern fn rt_value_int(value: i64) -> i64
@unsafe(reason: "raw tagged byte-array allocation ABI", capabilities: [ffi])
extern fn rt_byte_array_new_len(length: i64) -> i64
@unsafe(reason: "raw tagged array payload ABI", capabilities: [ffi, raw_ptr])
