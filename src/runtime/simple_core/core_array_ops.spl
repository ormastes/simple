# ============================================================================
# Value tag helpers
# ============================================================================

fn val_is_int(v: i64) -> i64:
    if (v & 7) < 1:
        return 1
    return 0

fn val_as_int(v: i64) -> i64:
    return v >> 3

fn val_is_falsy(v: i64) -> i64:
    # NIL (3) is falsy
    if v > 2 and v < 4:
        return 1
    # false (19) is falsy
    if v > 18 and v < 20:
        return 1
    # int 0 is falsy (tagged: 0 << 3 = 0)
    if v < 1 and v > -1:
        return 1
    return 0

fn val_from_int(i: i64) -> i64:
    return i << 3

fn typed_word_encode(array: i64, value: i64) -> i64:
    if (_sffi_core_array_ops_array_flags(array) & 16) != 0:
        return value
    return val_from_int(value)

fn typed_word_decode(array: i64, value: i64) -> i64:
    if (_sffi_core_array_ops_array_flags(array) & 16) != 0:
        return value
    return val_as_int(value)

# ============================================================================
# Tier 1: Mechanical, no extra dependencies
# ============================================================================

pub fn rt_array_clear(array: i64) -> i8:
    if _sffi_core_array_ops_array_is_valid(array) < 1:
        return 0
    _sffi_core_array_ops_set_array_len(array, 0)
    return 1

pub fn rt_array_free(array: i64):
    if _sffi_core_array_ops_array_is_valid(array) < 1:
        return
    val ptr = _sffi_core_array_ops_array_ptr(array)
    val items = _sffi_core_array_ops_array_items(array)
    if items > 0:
        _sffi_core_array_ops_free(items)
    _sffi_core_array_ops_unregister_array(ptr)
    _sffi_core_array_ops_free(ptr)

pub fn rt_array_new_with_cap(cap: i64) -> i64:
    return _sffi_core_array_ops_rt_array_new(cap)

pub fn rt_array_new_with_cap_u64(cap: i64) -> i64:
    # flags=16, elem_size=8 — re-implemented locally since array_new_with_flags is private
    var actual_cap = cap
    if actual_cap < 4:
        actual_cap = 4
    if actual_cap > 1152921504606846975:
        return 0
    val array = _sffi_core_array_ops_calloc(1, 40)
    if array < 1:
        return 0
    val items = _sffi_core_array_ops_calloc(actual_cap, 8)
    if items < 1:
        _sffi_core_array_ops_free(array)
        return 0
    _sffi_core_array_ops_store_u8(array, 0, 2)
    _sffi_core_array_ops_store_u8(array, 1, 16)
    _sffi_core_array_ops_set_array_items(array, items)
    _sffi_core_array_ops_set_array_len(array, 0)
    _sffi_core_array_ops_set_array_cap(array, actual_cap)
    _sffi_core_array_ops_register_array(array)
    if _sffi_core_array_ops_transient_note(array, 2) < 0:
        _sffi_core_array_ops_unregister_array(array)
        _sffi_core_array_ops_free(items)
        _sffi_core_array_ops_free(array)
        return 0
    return array | 1

pub fn rt_array_new_with_cap_i64(cap: i64) -> i64:
    return _sffi_core_array_ops_rt_array_new(cap)

pub fn rt_array_new_with_cap_text(cap: i64) -> i64:
    return _sffi_core_array_ops_rt_array_new(cap)

pub fn rt_array_new_with_cap_bool(cap: i64) -> i64:
    return _sffi_core_array_ops_rt_array_new(cap)

pub fn rt_array_new_with_cap_js_value(cap: i64) -> i64:
    return _sffi_core_array_ops_rt_array_new(cap)

fn rt_array_repeat_new_uninit(cap: i64) -> i64:
    var actual_cap = cap
    if actual_cap < 4:
        actual_cap = 4
    val array = _sffi_core_array_ops_calloc(1, 40)
    if array < 1:
        return 0
    val items = _sffi_core_array_ops_malloc(actual_cap * 8)
    if items < 1:
        _sffi_core_array_ops_free(array)
        return 0
    _sffi_core_array_ops_store_u8(array, 0, 2)
    _sffi_core_array_ops_store_u8(array, 1, 0)
    _sffi_core_array_ops_set_array_items(array, items)
    _sffi_core_array_ops_set_array_len(array, 0)
    _sffi_core_array_ops_set_array_cap(array, actual_cap)
    _sffi_core_array_ops_register_array(array)
    if _sffi_core_array_ops_transient_note(array, 2) < 0:
        _sffi_core_array_ops_unregister_array(array)
        _sffi_core_array_ops_free(items)
        _sffi_core_array_ops_free(array)
        return 0
    return array | 1

pub fn rt_array_first(array: i64) -> i64:
    return rt_array_get_local(array, 0)

# Local inline version of rt_array_get to avoid extern call for first/last
fn rt_array_get_local(array: i64, idx: i64) -> i64:
    if _sffi_core_array_ops_array_is_valid(array) < 1:
        return 3
    val actual_idx = _sffi_core_array_ops_normalize_index(array, idx)
    if actual_idx < 0 or actual_idx >= _sffi_core_array_ops_array_len_value(array):
        return 3
    return _sffi_core_array_ops_load_i64(_sffi_core_array_ops_array_items(array), actual_idx * 8)

pub fn rt_array_last(array: i64) -> i64:
    if _sffi_core_array_ops_array_is_valid(array) < 1:
        return 3
    val len = _sffi_core_array_ops_array_len_value(array)
    if len <= 0:
        return 3
    return _sffi_core_array_ops_load_i64(_sffi_core_array_ops_array_items(array), (len - 1) * 8)

pub fn rt_array_copy(array: i64) -> i64:
    if _sffi_core_array_ops_array_is_valid(array) < 1:
        return 0
    val len = _sffi_core_array_ops_array_len_value(array)
    val result = _sffi_core_array_ops_rt_array_new(len)
    if result < 1:
        return 0
    if len > 0:
        _sffi_core_array_ops_memcpy(_sffi_core_array_ops_array_items(result), _sffi_core_array_ops_array_items(array), len * 8)
        _sffi_core_array_ops_set_array_len(result, len)
    return result

pub fn rt_array_concat(a: i64, b: i64) -> i64:
    if _sffi_core_array_ops_array_is_valid(a) < 1 or _sffi_core_array_ops_array_is_valid(b) < 1:
        return 0
    val len_a = _sffi_core_array_ops_array_len_value(a)
    val len_b = _sffi_core_array_ops_array_len_value(b)
    if len_a > 9223372036854775807 - len_b:
        return 0
    val total = len_a + len_b
    val result = _sffi_core_array_ops_rt_array_new(total)
    if result < 1:
        return 0
    if len_a > 0:
        _sffi_core_array_ops_memcpy(_sffi_core_array_ops_array_items(result), _sffi_core_array_ops_array_items(a), len_a * 8)
    if len_b > 0:
        _sffi_core_array_ops_memcpy(_sffi_core_array_ops_array_items(result) + len_a * 8, _sffi_core_array_ops_array_items(b), len_b * 8)
    _sffi_core_array_ops_set_array_len(result, total)
    return result

pub fn rt_array_reverse(array: i64) -> i8:
    if _sffi_core_array_ops_array_is_valid(array) < 1:
        return 0
    val len = _sffi_core_array_ops_array_len_value(array)
    val items = _sffi_core_array_ops_array_items(array)
    var lo = 0
    var hi = len - 1
    while lo < hi:
        val tmp = _sffi_core_array_ops_load_i64(items, lo * 8)
        _sffi_core_array_ops_store_i64(items, lo * 8, _sffi_core_array_ops_load_i64(items, hi * 8))
        _sffi_core_array_ops_store_i64(items, hi * 8, tmp)
        lo = lo + 1
        hi = hi - 1
    return 1

pub fn rt_array_reversed(array: i64) -> i64:
    if _sffi_core_array_ops_array_is_valid(array) < 1:
        return 0
    val len = _sffi_core_array_ops_array_len_value(array)
    val result = _sffi_core_array_ops_rt_array_new(len)
    if result < 1:
        return 0
    val src = _sffi_core_array_ops_array_items(array)
    val dst = _sffi_core_array_ops_array_items(result)
    var i = 0
    while i < len:
        _sffi_core_array_ops_store_i64(dst, i * 8, _sffi_core_array_ops_load_i64(src, (len - 1 - i) * 8))
        i = i + 1
    _sffi_core_array_ops_set_array_len(result, len)
    return result

pub fn rt_array_take(array: i64, n: i64) -> i64:
    if _sffi_core_array_ops_array_is_valid(array) < 1:
        return 0
    val len = _sffi_core_array_ops_array_len_value(array)
    var take_n = n
    if take_n < 0:
        take_n = 0
    if take_n > len:
        take_n = len
    val result = _sffi_core_array_ops_rt_array_new(take_n)
    if result < 1:
        return 0
    if take_n > 0:
        _sffi_core_array_ops_memcpy(_sffi_core_array_ops_array_items(result), _sffi_core_array_ops_array_items(array), take_n * 8)
        _sffi_core_array_ops_set_array_len(result, take_n)
    return result

pub fn rt_array_drop(array: i64, n: i64) -> i64:
    if _sffi_core_array_ops_array_is_valid(array) < 1:
        return 0
    val len = _sffi_core_array_ops_array_len_value(array)
    var drop_count = n
    if drop_count < 0:
        drop_count = 0
    if drop_count > len:
        drop_count = len
    val result_len = len - drop_count
    val result = _sffi_core_array_ops_rt_array_new(result_len)
    if result < 1:
        return 0
    if result_len > 0:
        _sffi_core_array_ops_memcpy(_sffi_core_array_ops_array_items(result), _sffi_core_array_ops_array_items(array) + drop_count * 8, result_len * 8)
        _sffi_core_array_ops_set_array_len(result, result_len)
    return result

pub fn rt_array_fill(array: i64, value: i64) -> i8:
    if _sffi_core_array_ops_array_is_valid(array) < 1:
        return 0
    val len = _sffi_core_array_ops_array_len_value(array)
    val items = _sffi_core_array_ops_array_items(array)
    var i = 0
    while i < len:
        _sffi_core_array_ops_store_i64(items, i * 8, value)
        i = i + 1
    return 1

pub fn rt_array_repeat(value: i64, count: i64) -> i64:
    if count <= 0:
        return _sffi_core_array_ops_rt_array_new(0)
    val result = rt_array_repeat_new_uninit(count)
    if result < 1:
        return 0
    val items = _sffi_core_array_ops_array_items(result)
    _sffi_core_array_ops_store_i64(items, 0, value)
    var filled = 1
    while filled < count:
        var chunk = filled
        if chunk > count - filled:
            chunk = count - filled
        _sffi_core_array_ops_memcpy(items + filled * 8, items, chunk * 8)
        filled = filled + chunk
    _sffi_core_array_ops_set_array_len(result, count)
    return result

pub fn rt_array_range(start: i64, end: i64, step: i64) -> i64:
    if step < 1 and step > -1:
        return 3
    var count = 0
    if step > 0:
        if end > start:
            count = (end - start + step - 1) / step
    if step < 0:
        if start > end:
            count = (start - end + (0 - step) - 1) / (0 - step)
    val result = _sffi_core_array_ops_rt_array_new(count)
    if result < 1:
        return 0
    val items = _sffi_core_array_ops_array_items(result)
    var cur = start
    var idx = 0
    while idx < count:
        _sffi_core_array_ops_store_i64(items, idx * 8, val_from_int(cur))
        cur = cur + step
        idx = idx + 1
    _sffi_core_array_ops_set_array_len(result, count)
    return result

pub fn rt_array_push_grow(array: i64, value: i64) -> i8:
    return _sffi_core_array_ops_rt_array_push(array, value)

pub fn rt_array_push_no_grow(array: i64, value: i64) -> i8:
    if _sffi_core_array_ops_array_is_valid(array) < 1:
        return 0
    val len = _sffi_core_array_ops_array_len_value(array)
    val cap = _sffi_core_array_ops_array_cap(array)
    if len >= cap:
        return 0
    _sffi_core_array_ops_store_i64(_sffi_core_array_ops_array_items(array), len * 8, value)
    _sffi_core_array_ops_set_array_len(array, len + 1)
    return 1

fn byte_array_reserve(array: i64, needed: i64) -> i8:
    if _sffi_core_array_ops_array_is_valid(array) < 1:
        return 0
    var cap = _sffi_core_array_ops_array_cap(array)
    if needed <= cap:
        return 1
    var new_cap = cap * 2
    if new_cap < 4:
        new_cap = 4
    while new_cap < needed:
        new_cap = new_cap * 2
    val new_items = _sffi_core_array_ops_realloc(_sffi_core_array_ops_array_items(array), new_cap)
    if new_items < 1:
        _sffi_core_array_ops_set_array_len(array, 0)
        _sffi_core_array_ops_set_array_cap(array, 0)
        return 0
    _sffi_core_array_ops_set_array_items(array, new_items)
    _sffi_core_array_ops_set_array_cap(array, new_cap)
    return 1

pub fn rt_bytes_u32_le_at(array: i64, idx: i64) -> i64:
    if _sffi_core_array_ops_array_is_valid(array) < 1:
        return 0
    val actual_idx = _sffi_core_array_ops_normalize_index(array, idx)
    if actual_idx < 0 or actual_idx + 4 > _sffi_core_array_ops_array_len_value(array):
        return 0
    val items = _sffi_core_array_ops_array_items(array)
    return (_sffi_core_array_ops_load_u8(items, actual_idx) & 255) |
        ((_sffi_core_array_ops_load_u8(items, actual_idx + 1) & 255) << 8) |
        ((_sffi_core_array_ops_load_u8(items, actual_idx + 2) & 255) << 16) |
        ((_sffi_core_array_ops_load_u8(items, actual_idx + 3) & 255) << 24)

pub fn rt_bytes_u64_le_at(array: i64, idx: i64) -> i64:
    if _sffi_core_array_ops_array_is_valid(array) < 1:
        return 0
    val actual_idx = _sffi_core_array_ops_normalize_index(array, idx)
    if actual_idx < 0 or actual_idx + 8 > _sffi_core_array_ops_array_len_value(array):
        return 0
    val items = _sffi_core_array_ops_array_items(array)
    var out = 0
    var shift = 0
    while shift < 8:
        out = out | ((_sffi_core_array_ops_load_u8(items, actual_idx + shift) & 255) << (shift * 8))
        shift = shift + 1
    return out

pub fn rt_typed_bytes_u8_push(array: i64, value: i64) -> i8:
