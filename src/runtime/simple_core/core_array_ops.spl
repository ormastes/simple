pub fn rt_numeric_xor_sum_u64_data(items: i64, length: i64, xor_value: i64) -> i64:
    if length < 0:
        return 0
    var sum: i64 = 0
    var idx: i64 = 0
    var cursor = items
    while idx + 15 < length:
        sum = sum + (_sffi_core_array_ops_load_i64(cursor, 0) ^ xor_value)
        sum = sum + (_sffi_core_array_ops_load_i64(cursor, 8) ^ xor_value)
        sum = sum + (_sffi_core_array_ops_load_i64(cursor, 16) ^ xor_value)
        sum = sum + (_sffi_core_array_ops_load_i64(cursor, 24) ^ xor_value)
        sum = sum + (_sffi_core_array_ops_load_i64(cursor, 32) ^ xor_value)
        sum = sum + (_sffi_core_array_ops_load_i64(cursor, 40) ^ xor_value)
        sum = sum + (_sffi_core_array_ops_load_i64(cursor, 48) ^ xor_value)
        sum = sum + (_sffi_core_array_ops_load_i64(cursor, 56) ^ xor_value)
        sum = sum + (_sffi_core_array_ops_load_i64(cursor, 64) ^ xor_value)
        sum = sum + (_sffi_core_array_ops_load_i64(cursor, 72) ^ xor_value)
        sum = sum + (_sffi_core_array_ops_load_i64(cursor, 80) ^ xor_value)
        sum = sum + (_sffi_core_array_ops_load_i64(cursor, 88) ^ xor_value)
        sum = sum + (_sffi_core_array_ops_load_i64(cursor, 96) ^ xor_value)
        sum = sum + (_sffi_core_array_ops_load_i64(cursor, 104) ^ xor_value)
        sum = sum + (_sffi_core_array_ops_load_i64(cursor, 112) ^ xor_value)
        sum = sum + (_sffi_core_array_ops_load_i64(cursor, 120) ^ xor_value)
        idx = idx + 16
        cursor = cursor + 128
    while idx < length:
        sum = sum + (_sffi_core_array_ops_load_i64(cursor, 0) ^ xor_value)
        idx = idx + 1
        cursor = cursor + 8
    return sum

pub fn rt_numeric_xor_sum_u64_repeated_data(items: i64, length: i64, iters: i64) -> i64:
    if length < 0 or iters < 0:
        return 0
    var present_bits: i64 = 0
    var present_idx: i64 = 0
    var present_cursor = items
    while present_idx < length:
        present_bits = present_bits | _sffi_core_array_ops_load_i64(present_cursor, 0)
        present_idx = present_idx + 1
        present_cursor = present_cursor + 8

    var total: i64 = 0
    var bit: i64 = 0
    var bit_value: i64 = 1
    while bit < 63:
        var ones: i64 = 0
        if (present_bits & bit_value) != 0:
            var idx: i64 = 0
            var cursor = items
            while idx < length:
                if (_sffi_core_array_ops_load_i64(cursor, 0) & bit_value) != 0:
                    ones = ones + 1
                idx = idx + 1
                cursor = cursor + 8

        var iter_ones: i64 = 0
        if bit_value <= iters:
            val cycle = bit_value << 1
            val full_cycles = iters / cycle
            val remainder = iters - full_cycles * cycle
            iter_ones = full_cycles * bit_value
            if remainder > bit_value:
                iter_ones = iter_ones + (remainder - bit_value)

        val iter_zeros = iters - iter_ones
        val data_zeros = length - ones
        total = total + (ones * iter_zeros + data_zeros * iter_ones) * bit_value
        bit = bit + 1
        bit_value = bit_value << 1
    if (present_bits & bit_value) != 0:
        var sign_ones: i64 = 0
        var sign_idx: i64 = 0
        var sign_cursor = items
        while sign_idx < length:
            if (_sffi_core_array_ops_load_i64(sign_cursor, 0) & bit_value) != 0:
                sign_ones = sign_ones + 1
            sign_idx = sign_idx + 1
            sign_cursor = sign_cursor + 8
        total = total + sign_ones * iters * bit_value
    return total

pub fn rt_numeric_xor_sum_u64(array: i64, xor_value: i64) -> i64:
    if array < 4096:
        return 0
    val ptr = _sffi_core_array_ops_array_ptr(array)
    if (ptr & 7) > 0:
        return 0
    if _sffi_core_array_ops_load_u8(ptr, 0) != 2:
        return 0
    val length = _sffi_core_array_ops_load_i64(ptr, 8)
    if length < 0:
        return 0
    val items = _sffi_core_array_ops_load_i64(ptr, 24)
    var sum: i64 = 0
    var idx: i64 = 0
    var cursor = items
    while idx + 15 < length:
        sum = sum + (_sffi_core_array_ops_load_i64(cursor, 0) ^ xor_value)
        sum = sum + (_sffi_core_array_ops_load_i64(cursor, 8) ^ xor_value)
        sum = sum + (_sffi_core_array_ops_load_i64(cursor, 16) ^ xor_value)
        sum = sum + (_sffi_core_array_ops_load_i64(cursor, 24) ^ xor_value)
        sum = sum + (_sffi_core_array_ops_load_i64(cursor, 32) ^ xor_value)
        sum = sum + (_sffi_core_array_ops_load_i64(cursor, 40) ^ xor_value)
        sum = sum + (_sffi_core_array_ops_load_i64(cursor, 48) ^ xor_value)
        sum = sum + (_sffi_core_array_ops_load_i64(cursor, 56) ^ xor_value)
        sum = sum + (_sffi_core_array_ops_load_i64(cursor, 64) ^ xor_value)
        sum = sum + (_sffi_core_array_ops_load_i64(cursor, 72) ^ xor_value)
        sum = sum + (_sffi_core_array_ops_load_i64(cursor, 80) ^ xor_value)
        sum = sum + (_sffi_core_array_ops_load_i64(cursor, 88) ^ xor_value)
        sum = sum + (_sffi_core_array_ops_load_i64(cursor, 96) ^ xor_value)
        sum = sum + (_sffi_core_array_ops_load_i64(cursor, 104) ^ xor_value)
        sum = sum + (_sffi_core_array_ops_load_i64(cursor, 112) ^ xor_value)
        sum = sum + (_sffi_core_array_ops_load_i64(cursor, 120) ^ xor_value)
        idx = idx + 16
        cursor = cursor + 128
    while idx < length:
        sum = sum + (_sffi_core_array_ops_load_i64(cursor, 0) ^ xor_value)
        idx = idx + 1
        cursor = cursor + 8
    sum << 3

pub fn rt_numeric_contains_u64(array: i64, value: i64) -> i8:
    if array < 4096:
        return 0
    val ptr = _sffi_core_array_ops_array_ptr(array)
    if (ptr & 7) > 0:
        return 0
    if _sffi_core_array_ops_load_u8(ptr, 0) != 2:
        return 0
    val length = _sffi_core_array_ops_load_i64(ptr, 8)
    if length < 0:
        return 0
    val items = _sffi_core_array_ops_load_i64(ptr, 24)
    var idx: i64 = 0
    var cursor = items
    var found: i8 = 0
    while idx + 7 < length:
        val item0 = _sffi_core_array_ops_load_i64(cursor, 0)
        if item0 == value:
            found = 1
            break
        val item1 = _sffi_core_array_ops_load_i64(cursor, 8)
        if item1 == value:
            found = 1
            break
        val item2 = _sffi_core_array_ops_load_i64(cursor, 16)
        if item2 == value:
            found = 1
            break
        val item3 = _sffi_core_array_ops_load_i64(cursor, 24)
        if item3 == value:
            found = 1
            break
        val item4 = _sffi_core_array_ops_load_i64(cursor, 32)
        if item4 == value:
            found = 1
            break
        val item5 = _sffi_core_array_ops_load_i64(cursor, 40)
        if item5 == value:
            found = 1
            break
        val item6 = _sffi_core_array_ops_load_i64(cursor, 48)
        if item6 == value:
            found = 1
            break
        val item7 = _sffi_core_array_ops_load_i64(cursor, 56)
        if item7 == value:
            found = 1
            break
        idx = idx + 8
        cursor = cursor + 64
    while found == 0 and idx < length:
        val item = _sffi_core_array_ops_load_i64(cursor, 0)
        if item == value:
            found = 1
            break
        idx = idx + 1
        cursor = cursor + 8
    return found

