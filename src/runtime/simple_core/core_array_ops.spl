# Pure-Simple `simple-core` array operations — Tier 1 mechanical ops.
# Depends on core_array.spl (linked at archive level).

@unsafe(reason: "raw C allocator ABI; zero is allocation failure", capabilities: [ffi, raw_ptr])
extern fn malloc(size: i64) -> i64
@unsafe(reason: "raw C allocator ABI with count-size overflow contract", capabilities: [ffi, raw_ptr])
extern fn calloc(count: i64, size: i64) -> i64
@unsafe(reason: "raw C reallocator ABI; failure preserves the input allocation", capabilities: [ffi, raw_ptr])
extern fn realloc(ptr: i64, size: i64) -> i64
@unsafe(reason: "consumes a raw C allocation exactly once", capabilities: [ffi, raw_ptr])
extern fn free(ptr: i64)
@unsafe(reason: "raw non-overlapping extent ABI; source and destination must be valid", capabilities: [ffi, raw_ptr])
extern fn memcpy(dst: i64, src: i64, n: i64) -> i64
@unsafe(reason: "raw pointer plus byte-offset load ABI", capabilities: [ffi, raw_ptr])
extern fn spl_load_i64(ptr: i64, offset: i64) -> i64
@unsafe(reason: "raw pointer plus byte-offset store ABI", capabilities: [ffi, raw_ptr])
extern fn spl_store_i64(ptr: i64, offset: i64, value: i64)
@unsafe(reason: "raw pointer plus byte-offset byte-load ABI", capabilities: [ffi, raw_ptr])
extern fn spl_load_u8(ptr: i64, offset: i64) -> i64
@unsafe(reason: "raw pointer plus byte-offset byte-store ABI", capabilities: [ffi, raw_ptr])
extern fn spl_store_u8(ptr: i64, offset: i64, value: i64)

# Helpers from core_array.spl (archive-level linking)
@unsafe(reason: "raw archive-level array header pointer projection ABI", capabilities: [ffi, raw_ptr])
extern fn array_ptr(array: i64) -> i64
@unsafe(reason: "raw archive-level array item-pointer projection ABI", capabilities: [ffi, raw_ptr])
extern fn array_items(array: i64) -> i64
@unsafe(reason: "raw archive-level array length projection ABI", capabilities: [ffi, raw_ptr])
extern fn array_len_value(array: i64) -> i64
@unsafe(reason: "raw archive-level array capacity projection ABI", capabilities: [ffi, raw_ptr])
extern fn array_cap(array: i64) -> i64
@unsafe(reason: "raw archive-level array flags projection ABI", capabilities: [ffi, raw_ptr])
extern fn array_flags(array: i64) -> i64
@unsafe(reason: "raw archive-level array registry validation ABI", capabilities: [ffi, raw_ptr])
extern fn array_is_valid(array: i64) -> i64
@unsafe(reason: "mutates a raw array header item pointer", capabilities: [ffi, raw_ptr])
extern fn set_array_items(array: i64, items: i64)
@unsafe(reason: "mutates a raw array header length", capabilities: [ffi, raw_ptr])
extern fn set_array_len(array: i64, len: i64)
@unsafe(reason: "mutates a raw array header capacity", capabilities: [ffi, raw_ptr])
extern fn set_array_cap(array: i64, cap: i64)
@unsafe(reason: "raw tagged numeric conversion ABI", capabilities: [ffi])
extern fn numeric_index(value: i64) -> i64
@unsafe(reason: "raw array handle and index normalization ABI", capabilities: [ffi, raw_ptr])
extern fn normalize_index(array: i64, idx: i64) -> i64
@unsafe(reason: "publishes a raw array allocation in the process registry", capabilities: [ffi, raw_ptr])
extern fn register_array(array: i64)
@unsafe(reason: "removes a raw array allocation from the process registry", capabilities: [ffi, raw_ptr])
extern fn unregister_array(array: i64)
@unsafe(reason: "allocates a runtime-owned array handle; zero is failure", capabilities: [ffi, raw_ptr])
extern fn rt_array_new(cap: i64) -> i64
@unsafe(reason: "mutates a runtime-owned array handle; false is failure", capabilities: [ffi, raw_ptr])
extern fn rt_array_push(array: i64, value: i64) -> i8
@unsafe(reason: "raw transient-tracking runtime note ABI", capabilities: [ffi, raw_ptr])
extern fn rt_simple_core_transient_note(ptr: i64, kind: i64) -> i64

# Mandatory-inline capability owners keep raw pointer/handle authority out of
# ordinary array algorithms without changing the generated memory operation.
@always_inline
fn _sffi_core_array_ops_transient_note(ptr: i64, kind: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]):
        rt_simple_core_transient_note(ptr, kind)

