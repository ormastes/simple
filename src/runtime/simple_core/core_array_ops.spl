pub fn rt_array_extend_i64(dst: i64, src: i64, count: i64) -> i8:
    if count <= 0:
        return 1
    if _sffi_core_array_ops_array_is_valid(dst) < 1 or _sffi_core_array_ops_array_is_valid(src) < 1:
        return 0
    val src_len = _sffi_core_array_ops_array_len_value(src)
    if count > src_len:
        return 0
    val dst_len = _sffi_core_array_ops_array_len_value(dst)
    val needed = dst_len + count
    var dst_cap = _sffi_core_array_ops_array_cap(dst)
    if needed > dst_cap:
        var new_cap = dst_cap * 2
        if new_cap < needed:
            new_cap = needed
        if new_cap < 4:
            new_cap = 4
        val new_items = _sffi_core_array_ops_realloc(_sffi_core_array_ops_array_items(dst), new_cap * 8)
        if new_items < 1:
            return 0
        _sffi_core_array_ops_set_array_items(dst, new_items)
        _sffi_core_array_ops_set_array_cap(dst, new_cap)
    _sffi_core_array_ops_memcpy(_sffi_core_array_ops_array_items(dst) + dst_len * 8, _sffi_core_array_ops_array_items(src), count * 8)
    _sffi_core_array_ops_set_array_len(dst, dst_len + count)
    return 1
