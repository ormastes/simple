var _rt_cli_argc: i64 = 0
var _rt_cli_argv: i64 = 0

var _rt_debug_mode_enabled = false

pub fn rt_set_debug_mode(enabled: bool):
    _rt_debug_mode_enabled = enabled

pub fn rt_is_debug_mode_enabled() -> bool:
    _rt_debug_mode_enabled

pub fn rt_is_interpreter_runtime() -> bool:
    false

# The pure-Simple core archive backs AOT-native binaries only; seed-JIT code
# never runs on it. Mirrors the core-C standalone definition
# (runtime_native.c:596) so the archive defines BOTH runtime-kind probes in
# CORE_REQUIRED_RUNTIME_SYMBOLS.
pub fn rt_is_jit_runtime() -> bool:
    false

pub fn rt_exit(code: i64) -> i64:
    _sffi_core_process_exit(code)
    return 0

pub fn rt_set_args(argc: i64, argv: i64) -> i64:
    _rt_cli_argc = argc
    _rt_cli_argv = argv
    return 0

pub fn spl_init_args(argc: i64, argv: i64) -> i64:
    return rt_set_args(argc, argv)

pub fn spl_arg_count() -> i64:
    return _rt_cli_argc

pub fn spl_get_arg(index: i64) -> i64:
    if index < 0 or index >= _rt_cli_argc or _rt_cli_argv < 1:
        return 0
    return _sffi_core_process_load_i64(_rt_cli_argv, index * 8)

pub fn rt_get_argc() -> i64:
    return _rt_cli_argc

pub fn rt_cli_get_args() -> i64:
    val out = _sffi_core_process_argv_array_new(_rt_cli_argc)
    if out < 1:
        return 3
    var i = 0
    while i < _rt_cli_argc:
        val cstr = _sffi_core_process_load_i64(_rt_cli_argv, i * 8)
        val value = if cstr < 1: _sffi_core_process_rt_string_new(0, 0) else: _sffi_core_process_rt_string_new(cstr, _sffi_core_process_strlen(cstr))
        if _sffi_core_process_argv_array_push(out, value) < 1:
            return 3
        i = i + 1
    out

pub fn rt_get_args() -> i64:
    return rt_cli_get_args()

pub fn sys_get_args() -> i64:
    return rt_cli_get_args()

pub fn rt_getpid() -> i64:
    _sffi_core_process_getpid()

pub fn rt_cli_arg_count() -> i64:
    return _rt_cli_argc

pub fn rt_cli_arg_at(index: i64) -> i64:
    if index < 0 or index >= _rt_cli_argc or _rt_cli_argv < 1:
        return _sffi_core_process_rt_string_new(0, 0)
    val cstr = _sffi_core_process_load_i64(_rt_cli_argv, index * 8)
    if cstr < 1:
        return _sffi_core_process_rt_string_new(0, 0)
    return _sffi_core_process_rt_string_new(cstr, _sffi_core_process_strlen(cstr))

pub fn rt_time_now_unix() -> i64:
    return _sffi_core_process_time(0)

pub fn rt_time_now_unix_micros() -> i64:
    # struct timeval { time_t tv_sec; suseconds_t tv_usec; } — 16 bytes
    val tv = _sffi_core_process_malloc(16)
    if tv < 1:
        return 0
    val result = _sffi_core_process_gettimeofday(tv, 0)
    if result < 0:
        _sffi_core_process_free(tv)
        return 0
    val sec = _sffi_core_process_load_i64(tv, 0)
    val usec = _sffi_core_process_load_i64(tv, 8)
    _sffi_core_process_free(tv)
    return sec * 1000000 + usec

pub fn rt_time_now_nanos() -> i64:
    # CLOCK_MONOTONIC = 1 on Linux
    # struct timespec { time_t tv_sec; long tv_nsec; } — 16 bytes
    val ts = _sffi_core_process_malloc(16)
    if ts < 1:
        return 0
    val result = _sffi_core_process_clock_gettime(1, ts)
    if result < 0:
        _sffi_core_process_free(ts)
        return 0
    val sec = _sffi_core_process_load_i64(ts, 0)
    val nsec = _sffi_core_process_load_i64(ts, 8)
    _sffi_core_process_free(ts)
    return sec * 1000000000 + nsec

pub fn rt_time_now_micros() -> i64:
    # CLOCK_MONOTONIC = 1 on Linux
    val ts = _sffi_core_process_malloc(16)
    if ts < 1:
        return 0
    val result = _sffi_core_process_clock_gettime(1, ts)
    if result < 0:
        _sffi_core_process_free(ts)
        return 0
    val sec = _sffi_core_process_load_i64(ts, 0)
    val nsec = _sffi_core_process_load_i64(ts, 8)
    _sffi_core_process_free(ts)
    return sec * 1000000 + nsec / 1000

pub fn rt_time_now_monotonic_ms() -> i64:
    rt_time_now_micros() / 1000

pub fn rt_entropy_hardware_ready() -> i64:
    return 0

pub fn rt_platform_name() -> text:
    return "linux"

pub fn rt_term_enable_ansi() -> i64:
    return 1

pub fn rt_term_poll(timeout_ms: i64) -> i8:
    return 0

pub fn rt_term_read_timeout(max_len: i64, timeout_ms: i64) -> text:
    return ""

fn _process_result(exit_code: i64) -> i64:
    val result = _sffi_core_process_rt_tuple_new(3)
    _sffi_core_process_rt_tuple_set(result, 0, _sffi_core_process_rt_string_new(0, 0))
    _sffi_core_process_rt_tuple_set(result, 1, _sffi_core_process_rt_string_new(0, 0))
    _sffi_core_process_rt_tuple_set(result, 2, _sffi_core_process_rt_value_int(exit_code))
    result

fn _process_run_inherit(cmd_ptr: i64, cmd_len: i64, args: i64) -> i64:
    if cmd_ptr < 1 or cmd_len < 1:
        return -1
    val command = _sffi_core_process_malloc(cmd_len + 1)
    if command < 1:
        return -1
    var i = 0
    while i < cmd_len:
        _sffi_core_process_store_u8(command, i, _sffi_core_process_load_u8(cmd_ptr, i))
        i = i + 1
    _sffi_core_process_store_u8(command, cmd_len, 0)

    val argc = _sffi_core_process_rt_array_len(args)
    val argv = _sffi_core_process_calloc(argc + 2, 8)
    if argv < 1:
        _sffi_core_process_free(command)
        return -1
    _sffi_core_process_store_i64(argv, 0, command)
    i = 0
    while i < argc:
        _sffi_core_process_store_i64(argv, (i + 1) * 8, _sffi_core_process_rt_string_data(_sffi_core_process_rt_array_get_text(args, i)))
        i = i + 1

    val status = _sffi_core_process_calloc(1, 8)
    if status < 1:
        _sffi_core_process_free(argv)
        _sffi_core_process_free(command)
        return -1
    val pid = _sffi_core_process_fork()
    if pid == 0:
        _sffi_core_process_execvp(command, argv)
        _sffi_core_process_exit(127)
        return 127
    if pid < 1:
        _sffi_core_process_free(status)
        _sffi_core_process_free(argv)
        _sffi_core_process_free(command)
        return -1

    val waited = _sffi_core_process_waitpid(pid, status, 0)
    val exit_code = if waited < 1: -1 else: (_sffi_core_process_load_i64(status, 0) >> 8) & 255
    _sffi_core_process_free(status)
    _sffi_core_process_free(argv)
    _sffi_core_process_free(command)
    exit_code

pub fn rt_process_run_inherit(cmd_ptr: i64, cmd_len: i64, args: i64) -> i64:
    _process_run_inherit(cmd_ptr, cmd_len, args)

pub fn rt_process_run_inherit_value(cmd: i64, args: i64) -> i64:
    _process_run_inherit(_sffi_core_process_rt_string_data(cmd), _sffi_core_process_rt_string_len(cmd), args)

pub fn rt_process_run(cmd_ptr: i64, cmd_len: i64, args: i64) -> i64:
    # ponytail: stdout/stderr inherit the guest console; add pipe capture when
    # task-local descriptor inheritance is proven by the live process gate.
    _process_result(_process_run_inherit(cmd_ptr, cmd_len, args))

pub fn rt_sleep_ms(ms: i64):
    if ms > 0:
        _sffi_core_process_usleep(ms * 1000)

pub fn rt_thread_sleep(ms: i64):
    if ms > 0:
        _sffi_core_process_usleep(ms * 1000)

pub fn spl_thread_cpu_count() -> i64:
    # Darwin exposes _SC_NPROCESSORS_ONLN as 58. Fail closed to one worker if
    # this bootstrap fallback is selected on a target with another value.
    val count = _sffi_core_process_sysconf(58)
    if count > 0: count else: 1

pub fn rt_signal_check(signal_num: i64) -> i64:
    if signal_num <= 0:
        return 0
    val pending = _sffi_core_process_calloc(1, 128)
    if pending < 1:
        return 0
    val queried = _sffi_core_process_sigpending(pending)
    val present = if queried == 0: _sffi_core_process_sigismember(pending, signal_num) else: 0
    _sffi_core_process_free(pending)
    if present > 0: 1 else: 0

pub fn rt_atexit_check() -> i64:
    if rt_signal_check(2) > 0 or rt_signal_check(15) > 0: 1 else: 0

fn _process_stop_group(pid: i64, worker_live: bool):
    if pid <= 0:
        return
    if _sffi_core_process_kill(0 - pid, 15) != 0 and (not worker_live or _sffi_core_process_kill(pid, 15) != 0):
        return
    _sffi_core_process_usleep(100000)
    _sffi_core_process_kill(0 - pid, 9)
    if worker_live:
        _sffi_core_process_kill(pid, 9)

fn _process_guard_exec(command: i64, argv: i64, expected_parent: i64):
    val worker = _sffi_core_process_fork()
    if worker == 0:
        _sffi_core_process_setpgid(0, 0)
        _sffi_core_process_execvp(command, argv)
        _sffi_core_process_exit(127)
        return
    if worker < 0:
        _sffi_core_process_exit(127)
        return
    _sffi_core_process_setpgid(worker, worker)
    val status = _sffi_core_process_calloc(1, 8)
    if status < 1:
        _process_stop_group(worker, true)
        _sffi_core_process_exit(127)
        return
    var wait_errors = 0
    while true:
        val waited = _sffi_core_process_waitpid(worker, status, 1)
        if waited == worker:
            val raw_status = _sffi_core_process_load_i64(status, 0)
            _process_stop_group(worker, false)
            _sffi_core_process_free(status)
            if (raw_status & 127) != 0:
                val signal_num = raw_status & 127
                _sffi_core_process_signal(signal_num, 0)
                _sffi_core_process_kill(_sffi_core_process_getpid(), signal_num)
                _sffi_core_process_exit(127)
            _sffi_core_process_exit((raw_status >> 8) & 255)
            return
        if waited < 0:
            wait_errors = wait_errors + 1
            if wait_errors <= 3:
                _sffi_core_process_usleep(10000)
                continue
        else:
            wait_errors = 0
        if waited < 0 or _sffi_core_process_getppid() != expected_parent:
            _process_stop_group(worker, true)
            _sffi_core_process_waitpid(worker, status, 0)
            _sffi_core_process_free(status)
            _sffi_core_process_exit(143)
            return
        _sffi_core_process_usleep(10000)

fn _process_spawn(cmd_ptr: i64, cmd_len: i64, args: i64, guarded: bool) -> i64:
    if cmd_ptr < 1 or cmd_len < 1:
        return -1
    val command = _sffi_core_process_malloc(cmd_len + 1)
    if command < 1:
        return -1
    var i = 0
    while i < cmd_len:
        _sffi_core_process_store_u8(command, i, _sffi_core_process_load_u8(cmd_ptr, i))
        i = i + 1
    _sffi_core_process_store_u8(command, cmd_len, 0)
    val argc = _sffi_core_process_rt_array_len(args)
    val argv = _sffi_core_process_calloc(argc + 2, 8)
    if argv < 1:
        _sffi_core_process_free(command)
        return -1
    _sffi_core_process_store_i64(argv, 0, command)
    i = 0
    while i < argc:
        _sffi_core_process_store_i64(argv, (i + 1) * 8, _sffi_core_process_rt_string_data(_sffi_core_process_rt_array_get_text(args, i)))
        i = i + 1
    val expected_parent = _sffi_core_process_getpid()
    val pid = _sffi_core_process_fork()
    if pid == 0:
        if guarded:
            _process_guard_exec(command, argv, expected_parent)
        else:
            _sffi_core_process_execvp(command, argv)
            _sffi_core_process_exit(127)
            return -1
    _sffi_core_process_free(argv)
    _sffi_core_process_free(command)
    pid

pub fn rt_process_spawn_async(cmd_ptr: i64, cmd_len: i64, args: i64) -> i64:
    _process_spawn(cmd_ptr, cmd_len, args, false)

# Spawn a supervised Unix process tree for bounded app workers. Descendants
# that deliberately create a new session are outside this process-group owner.
pub fn rt_process_spawn_guarded(cmd_ptr: i64, cmd_len: i64, args: i64) -> i64:
    _process_spawn(cmd_ptr, cmd_len, args, true)

fn _process_exit_code(status: i64) -> i64:
    if (status & 127) != 0: -1 else: (status >> 8) & 255

pub fn rt_process_wait(pid: i64, timeout_ms: i64) -> i64:
    if pid <= 0:
        return -1
    val status = _sffi_core_process_calloc(1, 8)
    if status < 1:
        return -1
    if timeout_ms <= 0:
        val waited = _sffi_core_process_waitpid(pid, status, 0)
        val code = if waited == pid: _process_exit_code(_sffi_core_process_load_i64(status, 0)) else: -1
        _sffi_core_process_free(status)
        return code
    var elapsed = 0
    while elapsed < timeout_ms:
        val waited = _sffi_core_process_waitpid(pid, status, 1)
        if waited == pid:
            val code = _process_exit_code(_sffi_core_process_load_i64(status, 0))
            _sffi_core_process_free(status)
            return code
        if waited < 0:
            _sffi_core_process_free(status)
            return -1
        _sffi_core_process_usleep(10000)
        elapsed = elapsed + 10
    _sffi_core_process_free(status)
    -2

pub fn rt_process_is_running(pid: i64) -> i8:
    if pid <= 0: 0 else: (if _sffi_core_process_kill(pid, 0) == 0: 1 else: 0)

pub fn rt_process_kill(pid: i64) -> i8:
    if pid <= 0:
        return 0
    if _sffi_core_process_kill(pid, 15) != 0:
        return 0
    _sffi_core_process_usleep(100000)
    if _sffi_core_process_kill(pid, 0) == 0:
        if _sffi_core_process_kill(pid, 9) != 0:
            return 0
    val status = _sffi_core_process_calloc(1, 8)
    if status > 0:
        _sffi_core_process_waitpid(pid, status, 0)
        _sffi_core_process_free(status)
    1

pub fn rt_panic(msg: i64) -> i64:
    _sffi_core_process_rt_stderr_write(msg)
    _sffi_core_process_abort()
    return 0

pub fn panic(msg: i64):
    rt_panic(msg)
