# Pure-Simple `simple-core` process, time, and panic ABI wrappers.

@unsafe(reason: "raw libc process termination ABI", capabilities: [ffi])
extern fn exit(code: i64)
@unsafe(reason: "raw libc time pointer/status ABI", capabilities: [ffi, raw_ptr])
extern fn time(ptr: i64) -> i64
@unsafe(reason: "raw libc thread sleep status ABI", capabilities: [ffi])
extern fn usleep(usec: i64) -> i64
@unsafe(reason: "raw libc abnormal process termination ABI", capabilities: [ffi])
extern fn abort()
@unsafe(reason: "raw libc timeval/timezone output-pointer ABI", capabilities: [ffi, raw_ptr])
extern fn gettimeofday(tv: i64, tz: i64) -> i64
@unsafe(reason: "raw libc clock output-pointer ABI", capabilities: [ffi, raw_ptr])
extern fn clock_gettime(clk_id: i64, tp: i64) -> i64
@unsafe(reason: "raw libc heap allocation ABI; zero means failure", capabilities: [ffi, raw_ptr])
extern fn malloc(size: i64) -> i64
@unsafe(reason: "raw libc zeroed heap allocation ABI; count-size product must not overflow", capabilities: [ffi, raw_ptr])
extern fn calloc(count: i64, size: i64) -> i64
@unsafe(reason: "raw libc owned heap-pointer release ABI", capabilities: [ffi, raw_ptr])
extern fn free(ptr: i64)
@unsafe(reason: "raw pointer/offset i64 load ABI", capabilities: [ffi, raw_ptr])
extern fn spl_load_i64(ptr: i64, offset: i64) -> i64
@unsafe(reason: "raw pointer/offset byte load ABI", capabilities: [ffi, raw_ptr])
extern fn spl_load_u8(ptr: i64, offset: i64) -> i64
@unsafe(reason: "raw pointer/offset i64 store ABI", capabilities: [ffi, raw_ptr])
extern fn spl_store_i64(ptr: i64, offset: i64, value: i64)
@unsafe(reason: "raw pointer/offset byte store ABI", capabilities: [ffi, raw_ptr])
extern fn spl_store_u8(ptr: i64, offset: i64, value: i64)
@unsafe(reason: "raw tagged-array handle length ABI", capabilities: [ffi])
extern fn rt_array_len(array: i64) -> i64
@unsafe(reason: "raw tagged-array handle/index text-value ABI", capabilities: [ffi])
extern fn rt_array_get_text(array: i64, idx: i64) -> i64
@unsafe(reason: "raw owned argument-array handle allocation ABI; nonpositive return is failure", capabilities: [ffi])
extern fn rt_simple_core_argv_array_new_owned(cap: i64) -> i64
@unsafe(reason: "raw owned argument-array/value transfer ABI", capabilities: [ffi])
extern fn rt_simple_core_argv_array_push_owned(array: i64, value: i64) -> i8
@unsafe(reason: "raw owned tuple-handle allocation ABI; nonpositive return is failure", capabilities: [ffi])
extern fn rt_tuple_new(len: i64) -> i64
@unsafe(reason: "raw tuple-handle/index value-transfer ABI", capabilities: [ffi])
extern fn rt_tuple_set(tuple: i64, idx: i64, value: i64) -> i8
@unsafe(reason: "raw owned tagged-integer value allocation ABI", capabilities: [ffi])
extern fn rt_value_int(value: i64) -> i64
@unsafe(reason: "raw tagged-string borrowed data-pointer ABI", capabilities: [ffi, raw_ptr])
extern fn rt_string_data(value: i64) -> i64
@unsafe(reason: "raw tagged-string length ABI", capabilities: [ffi])
extern fn rt_string_len(value: i64) -> i64
@unsafe(reason: "raw borrowed byte pointer/length and owned tagged-string ABI", capabilities: [ffi, raw_ptr])
extern fn rt_string_new(bytes: i64, len: i64) -> i64
@unsafe(reason: "raw tagged-string stderr output-status ABI", capabilities: [ffi])
extern fn rt_stderr_write(value: i64) -> i64
@unsafe(reason: "raw libc process fork ABI", capabilities: [ffi])
extern fn fork() -> i64
@unsafe(reason: "raw libc path/argv pointer exec ABI", capabilities: [ffi, raw_ptr])
extern fn execvp(path: i64, argv: i64) -> i64
@unsafe(reason: "raw libc process wait and status-output pointer ABI", capabilities: [ffi, raw_ptr])
extern fn waitpid(pid: i64, status: i64, options: i64) -> i64
@unsafe(reason: "raw libc process-id ABI", capabilities: [ffi])
extern fn getpid() -> i64
@unsafe(reason: "raw libc parent-process-id ABI", capabilities: [ffi])
extern fn getppid() -> i64
@unsafe(reason: "raw libc process signal-delivery status ABI", capabilities: [ffi])
extern fn kill(pid: i64, signal_num: i64) -> i64
@unsafe(reason: "raw libc signal-handler pointer ABI", capabilities: [ffi, raw_ptr])
extern fn signal(signal_num: i64, handler: i64) -> i64
@unsafe(reason: "raw libc process-group mutation status ABI", capabilities: [ffi])
extern fn setpgid(pid: i64, pgid: i64) -> i64
@unsafe(reason: "raw libc signal-set output-pointer ABI", capabilities: [ffi, raw_ptr])
extern fn sigpending(set_ptr: i64) -> i64
@unsafe(reason: "raw libc signal-set pointer query ABI", capabilities: [ffi, raw_ptr])
