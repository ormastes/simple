# Dynamic arithmetic and ordered comparisons for tagged `Any` operands.

@unsafe(reason: "raw tagged integer constructor ABI; contract: exact tagged value result", capabilities: [ffi])
extern fn rt_value_int(value: i64) -> i64
@unsafe(reason: "raw tagged integer projection ABI; contract: caller supplies integer-tagged value", capabilities: [ffi])
extern fn rt_value_as_int(value: i64) -> i64
@unsafe(reason: "raw tagged float constructor ABI; contract: exact f64 parameter and tagged value result", capabilities: [ffi])
extern fn rt_value_float(value: f64) -> i64

@always_inline
fn _sffi_core_any_ops_bits_to_f64(bits: i64) -> f64:
    f64.from_bits(bits)

@always_inline
fn _sffi_core_any_ops_value_int(value: i64) -> i64:
    unsafe(capabilities: [ffi]):
        rt_value_int(value)

@always_inline
fn _sffi_core_any_ops_value_as_int(value: i64) -> i64:
    unsafe(capabilities: [ffi]):
        rt_value_as_int(value)

@always_inline
fn _sffi_core_any_ops_value_float(value: f64) -> i64:
    unsafe(capabilities: [ffi]):
        rt_value_float(value)

fn any_is_float(value: i64) -> bool: (value & 7) == 2

fn any_as_f64(value: i64) -> f64:
    if any_is_float(value):
        return _sffi_core_any_ops_bits_to_f64(value & -8)
    _sffi_core_any_ops_value_as_int(value) as f64

fn any_box_f64(value: f64) -> i64: _sffi_core_any_ops_value_float(value)

pub fn rt_any_sub(left: i64, right: i64) -> i64:
    if any_is_float(left) or any_is_float(right):
        return any_box_f64(any_as_f64(left) - any_as_f64(right))
    _sffi_core_any_ops_value_int(_sffi_core_any_ops_value_as_int(left) - _sffi_core_any_ops_value_as_int(right))

pub fn rt_any_mul(left: i64, right: i64) -> i64:
    if any_is_float(left) or any_is_float(right):
        return any_box_f64(any_as_f64(left) * any_as_f64(right))
    _sffi_core_any_ops_value_int(_sffi_core_any_ops_value_as_int(left) * _sffi_core_any_ops_value_as_int(right))

fn any_int_div_invalid(left: i64, right: i64) -> bool:
    right == 0 or (left == (-9223372036854775807 - 1) and right == -1)

pub fn rt_any_div(left: i64, right: i64) -> i64:
    if any_is_float(left) or any_is_float(right):
        return any_box_f64(any_as_f64(left) / any_as_f64(right))
    val l = _sffi_core_any_ops_value_as_int(left)
    val r = _sffi_core_any_ops_value_as_int(right)
    if any_int_div_invalid(l, r):
        return _sffi_core_any_ops_value_int(0)
    _sffi_core_any_ops_value_int(l / r)

pub fn rt_any_mod(left: i64, right: i64) -> i64:
    if any_is_float(left) or any_is_float(right):
        return any_box_f64(any_as_f64(left) % any_as_f64(right))
    val l = _sffi_core_any_ops_value_as_int(left)
    val r = _sffi_core_any_ops_value_as_int(right)
    if any_int_div_invalid(l, r):
        return _sffi_core_any_ops_value_int(0)
    _sffi_core_any_ops_value_int(l % r)

pub fn rt_any_lt(left: i64, right: i64) -> i64:
    if any_is_float(left) or any_is_float(right): return if any_as_f64(left) < any_as_f64(right): 1 else: 0
    if _sffi_core_any_ops_value_as_int(left) < _sffi_core_any_ops_value_as_int(right): 1 else: 0

pub fn rt_any_gt(left: i64, right: i64) -> i64:
    if any_is_float(left) or any_is_float(right): return if any_as_f64(left) > any_as_f64(right): 1 else: 0
    if _sffi_core_any_ops_value_as_int(left) > _sffi_core_any_ops_value_as_int(right): 1 else: 0

pub fn rt_any_le(left: i64, right: i64) -> i64:
    if any_is_float(left) or any_is_float(right): return if any_as_f64(left) <= any_as_f64(right): 1 else: 0
    if _sffi_core_any_ops_value_as_int(left) <= _sffi_core_any_ops_value_as_int(right): 1 else: 0

pub fn rt_any_ge(left: i64, right: i64) -> i64:
    if any_is_float(left) or any_is_float(right): return if any_as_f64(left) >= any_as_f64(right): 1 else: 0
    if _sffi_core_any_ops_value_as_int(left) >= _sffi_core_any_ops_value_as_int(right): 1 else: 0
