# Pure-Simple `simple-core` array query/sort/transform — Tiers 2-5.
# Depends on core_array.spl and core_array_ops.spl (linked at archive level).

# Helpers from core_array.spl (archive-level linking)
@unsafe(reason: "raw archive array borrowed items-pointer projection ABI", capabilities: [ffi, raw_ptr])
extern fn array_items(array: i64) -> i64
@unsafe(reason: "raw archive array length projection ABI", capabilities: [ffi])
extern fn array_len_value(array: i64) -> i64
@unsafe(reason: "raw archive array registry validation ABI", capabilities: [ffi])
extern fn array_is_valid(array: i64) -> i64
@unsafe(reason: "raw owned tagged-array allocation ABI; zero means failure", capabilities: [ffi])
extern fn rt_array_new(cap: i64) -> i64
@unsafe(reason: "raw tagged-array value transfer ABI; false means failure", capabilities: [ffi])
extern fn rt_array_push(array: i64, value: i64) -> i8
@unsafe(reason: "raw owned tagged-array copy ABI; zero means failure", capabilities: [ffi])
extern fn rt_array_copy(array: i64) -> i64
@unsafe(reason: "raw tagged-array in-place reverse status ABI", capabilities: [ffi])
extern fn rt_array_reverse(array: i64) -> i8
@unsafe(reason: "raw tagged string-array join ABI", capabilities: [ffi])
extern fn rt_string_join(array: i64, separator: i64) -> i64
@unsafe(reason: "owned Simple signed integer membership query before projection", capabilities: [ffi])
extern fn signed_integer_is_valid(value: i64) -> i64
@unsafe(reason: "owned Simple signed integer projection including registered INT1 leaves", capabilities: [ffi])
extern fn rt_value_as_int_wide(value: i64) -> i64
@unsafe(reason: "owned Simple full-width signed integer constructor", capabilities: [ffi])
extern fn rt_value_int(value: i64) -> i64
@unsafe(reason: "owned Simple numeric registry query before reading UInt payload", capabilities: [ffi])
extern fn numeric_box_kind(value: i64) -> i64
@unsafe(reason: "owned Simple UInt projection after membership validation", capabilities: [ffi])
extern fn rt_value_as_u64(value: i64) -> i64

@always_inline
fn _sffi_core_array_query_array_items(array: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]):
        array_items(array)

@always_inline
fn _sffi_core_array_query_array_len_value(array: i64) -> i64:
    unsafe(capabilities: [ffi]):
        array_len_value(array)

@always_inline
fn _sffi_core_array_query_array_is_valid(array: i64) -> i64:
    unsafe(capabilities: [ffi]):
        array_is_valid(array)

@always_inline
fn _sffi_core_array_query_rt_array_new(cap: i64) -> i64:
    unsafe(capabilities: [ffi]):
        rt_array_new(cap)

@always_inline
fn _sffi_core_array_query_rt_array_push(array: i64, value: i64) -> i8:
    unsafe(capabilities: [ffi]):
        rt_array_push(array, value)

@always_inline
fn _sffi_core_array_query_rt_array_copy(array: i64) -> i64:
    unsafe(capabilities: [ffi]):
        rt_array_copy(array)

@always_inline
fn _sffi_core_array_query_rt_array_reverse(array: i64) -> i8:
    unsafe(capabilities: [ffi]):
        rt_array_reverse(array)

@always_inline
fn _sffi_core_array_query_rt_string_join(array: i64, separator: i64) -> i64:
    unsafe(capabilities: [ffi]):
        rt_string_join(array, separator)

@unsafe(reason: "validated borrowed array storage owner ABI", capabilities: [ffi, raw_ptr])
extern fn array_load_value(array: i64, items: i64, index: i64) -> i64
@always_inline
fn _sffi_core_array_query_array_load_value(array: i64, items: i64, index: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]):
        array_load_value(array, items, index)

@unsafe(reason: "validated borrowed array storage owner ABI", capabilities: [ffi, raw_ptr])
extern fn array_store_value(array: i64, items: i64, index: i64, value: i64)
@always_inline
fn _sffi_core_array_query_array_store_value(array: i64, items: i64, index: i64, value: i64):
    unsafe(capabilities: [ffi, raw_ptr]):
        array_store_value(array, items, index, value)

# Value helpers use the actual numeric owner; INT1 is not an inline tag.
fn array_query_val_is_int(v: i64) -> i64:
    unsafe(capabilities: [ffi]): signed_integer_is_valid(v)

fn array_query_val_as_int(v: i64) -> i64:
    unsafe(capabilities: [ffi]): rt_value_as_int_wide(v)

fn array_query_val_equal(left: i64, right: i64) -> bool:
    if array_query_val_is_int(left) > 0 and array_query_val_is_int(right) > 0:
        return array_query_val_as_int(left) == array_query_val_as_int(right)
    left == right

fn array_query_val_is_falsy(v: i64) -> i64:
    # NIL (3) is falsy
    if v > 2 and v < 4:
        return 1
    # false (19) is falsy
    if v > 18 and v < 20:
        return 1
    # int 0 is falsy (tagged: 0 << 3 = 0)
    if array_query_val_is_int(v) > 0 and array_query_val_as_int(v) == 0:
        return 1
    var numeric_kind: i64 = 0
    unsafe(capabilities: [ffi]): numeric_kind = numeric_box_kind(v)
    if numeric_kind == 0x55494E54:
        var bits: i64 = 0
        unsafe(capabilities: [ffi]): bits = rt_value_as_u64(v)
        if bits == 0:
            return 1
    return 0

fn array_query_val_from_int(i: i64) -> i64:
    unsafe(capabilities: [ffi]): rt_value_int(i)

# ============================================================================
# Tier 2: Signed integer value equality; other values retain word identity.
# ============================================================================

pub fn rt_array_index_of(array: i64, value: i64) -> i64:
    if _sffi_core_array_query_array_is_valid(array) < 1:
        return -1
    val len = _sffi_core_array_query_array_len_value(array)
    val items = _sffi_core_array_query_array_items(array)
    var i = 0
    while i < len:
        val item = _sffi_core_array_query_array_load_value(array, items, i)
        if array_query_val_equal(item, value):
            return i
        i = i + 1
    return -1

pub fn rt_array_last_index_of(array: i64, value: i64) -> i64:
    if _sffi_core_array_query_array_is_valid(array) < 1:
        return -1
    val len = _sffi_core_array_query_array_len_value(array)
    val items = _sffi_core_array_query_array_items(array)
    var i = len - 1
    while i >= 0:
        val item = _sffi_core_array_query_array_load_value(array, items, i)
        if array_query_val_equal(item, value):
            return i
        i = i - 1
    return -1

pub fn rt_array_count(array: i64, value: i64) -> i64:
    if _sffi_core_array_query_array_is_valid(array) < 1:
        return 0
    val len = _sffi_core_array_query_array_len_value(array)
    val items = _sffi_core_array_query_array_items(array)
    var c = 0
    var i = 0
    while i < len:
        val item = _sffi_core_array_query_array_load_value(array, items, i)
        if array_query_val_equal(item, value):
            c = c + 1
        i = i + 1
    return c

pub fn rt_array_unique(array: i64) -> i64:
    if _sffi_core_array_query_array_is_valid(array) < 1:
        return 0
    val len = _sffi_core_array_query_array_len_value(array)
    val result = _sffi_core_array_query_rt_array_new(len)
    if result < 1:
        return 0
    val src_items = _sffi_core_array_query_array_items(array)
    var i = 0
    while i < len:
        val item = _sffi_core_array_query_array_load_value(array, src_items, i)
        # Check if item already in result
        val rlen = _sffi_core_array_query_array_len_value(result)
        val ritems = _sffi_core_array_query_array_items(result)
        var found = 0
        var j = 0
        while j < rlen and found < 1:
            val existing = _sffi_core_array_query_array_load_value(result, ritems, j)
            if array_query_val_equal(existing, item):
                found = 1
            j = j + 1
        if found < 1:
            _sffi_core_array_query_rt_array_push(result, item)
        i = i + 1
    return result

# ============================================================================
# Tier 3: Tag inspection
# ============================================================================

pub fn rt_array_all_truthy(array: i64) -> i64:
    if _sffi_core_array_query_array_is_valid(array) < 1:
        return 0
    val len = _sffi_core_array_query_array_len_value(array)
    val items = _sffi_core_array_query_array_items(array)
    var i = 0
    while i < len:
        val item = _sffi_core_array_query_array_load_value(array, items, i)
        if array_query_val_is_falsy(item) > 0:
            return 0
        i = i + 1
    return 1

pub fn rt_array_any_truthy(array: i64) -> i64:
    if _sffi_core_array_query_array_is_valid(array) < 1:
        return 0
    val len = _sffi_core_array_query_array_len_value(array)
    val items = _sffi_core_array_query_array_items(array)
    var i = 0
    while i < len:
        val item = _sffi_core_array_query_array_load_value(array, items, i)
        if array_query_val_is_falsy(item) < 1:
            return 1
        i = i + 1
    return 0

pub fn rt_array_sum(array: i64) -> i64:
    if _sffi_core_array_query_array_is_valid(array) < 1:
        return array_query_val_from_int(0)
    val len = _sffi_core_array_query_array_len_value(array)
    if len <= 0:
        return array_query_val_from_int(0)
    val items = _sffi_core_array_query_array_items(array)
    var total = 0
    var i = 0
    while i < len:
        val item = _sffi_core_array_query_array_load_value(array, items, i)
        if array_query_val_is_int(item) > 0:
            total = total + array_query_val_as_int(item)
        i = i + 1
    return array_query_val_from_int(total)

pub fn rt_array_min(array: i64) -> i64:
    if _sffi_core_array_query_array_is_valid(array) < 1:
        return 3
    val len = _sffi_core_array_query_array_len_value(array)
    if len <= 0:
        return 3
    val items = _sffi_core_array_query_array_items(array)
    var min_val = _sffi_core_array_query_array_load_value(array, items, 0)
    var i = 1
    while i < len:
        val item = _sffi_core_array_query_array_load_value(array, items, i)
        if array_query_val_is_int(item) > 0 and array_query_val_is_int(min_val) > 0:
            if array_query_val_as_int(item) < array_query_val_as_int(min_val):
                min_val = item
        i = i + 1
    return min_val

pub fn rt_array_max(array: i64) -> i64:
    if _sffi_core_array_query_array_is_valid(array) < 1:
        return 3
    val len = _sffi_core_array_query_array_len_value(array)
    if len <= 0:
        return 3
    val items = _sffi_core_array_query_array_items(array)
    var max_val = _sffi_core_array_query_array_load_value(array, items, 0)
    var i = 1
    while i < len:
        val item = _sffi_core_array_query_array_load_value(array, items, i)
        if array_query_val_is_int(item) > 0 and array_query_val_is_int(max_val) > 0:
            if array_query_val_as_int(item) > array_query_val_as_int(max_val):
                max_val = item
        i = i + 1
    return max_val

# ============================================================================
# Tier 4: Sort (insertion sort on tagged i64 values)
# ============================================================================

fn sort_compare(a: i64, b: i64) -> i64:
    # Compare two tagged values for sorting.
    # Ints: compare decoded values. Non-ints: compare raw bits.
    if array_query_val_is_int(a) > 0 and array_query_val_is_int(b) > 0:
        val ia = array_query_val_as_int(a)
        val ib = array_query_val_as_int(b)
        if ia < ib:
            return -1
        if ia > ib:
            return 1
        return 0
    # Fallback: compare raw tagged values
    if a < b:
        return -1
    if a > b:
        return 1
    return 0

pub fn rt_array_sort(array: i64) -> i8:
    if _sffi_core_array_query_array_is_valid(array) < 1:
        return 0
    val len = _sffi_core_array_query_array_len_value(array)
    if len <= 1:
        return 1
    val items = _sffi_core_array_query_array_items(array)
    # Insertion sort: shift elements right until we find the insert position
    var i = 1
    while i < len:
        val key = _sffi_core_array_query_array_load_value(array, items, i)
        var j = i - 1
        while j >= 0 and sort_compare(_sffi_core_array_query_array_load_value(array, items, j), key) > 0:
            _sffi_core_array_query_array_store_value(array, items, j + 1, _sffi_core_array_query_array_load_value(array, items, j))
            j = j - 1
        _sffi_core_array_query_array_store_value(array, items, j + 1, key)
        i = i + 1
    return 1

pub fn rt_array_sorted(array: i64) -> i64:
    val result = _sffi_core_array_query_rt_array_copy(array)
    if result < 1:
        return 0
    rt_array_sort(result)
    return result

pub fn rt_array_sort_desc(array: i64) -> i8:
    if rt_array_sort(array) < 1:
        return 0
    return _sffi_core_array_query_rt_array_reverse(array)

# ============================================================================
# Tier 5: Depend on tuple/string or heap-type detection
#
# rt_array_zip and rt_array_enumerate: Tuples (rt_tuple_new/rt_tuple_set)
# do not exist in simple-core yet. We use 2-element arrays as pairs instead.
#
# rt_array_flatten: Uses array_is_valid to detect nested arrays since
# simple-core arrays are not heap-tagged.
#
# rt_array_join: Delegates to rt_string_join (declared as extern from
# core_string.spl, linked at archive level).
# ============================================================================

pub fn rt_array_zip(a: i64, b: i64) -> i64:
    if _sffi_core_array_query_array_is_valid(a) < 1 or _sffi_core_array_query_array_is_valid(b) < 1:
        return 0
    val len_a = _sffi_core_array_query_array_len_value(a)
    val len_b = _sffi_core_array_query_array_len_value(b)
    var result_len = len_a
    if len_b < result_len:
        result_len = len_b
    val result = _sffi_core_array_query_rt_array_new(result_len)
    if result < 1:
        return 0
    var i = 0
    while i < result_len:
        val pair = _sffi_core_array_query_rt_array_new(2)
        if pair < 1:
            return 0
        _sffi_core_array_query_rt_array_push(pair, _sffi_core_array_query_array_load_value(a, _sffi_core_array_query_array_items(a), i))
        _sffi_core_array_query_rt_array_push(pair, _sffi_core_array_query_array_load_value(b, _sffi_core_array_query_array_items(b), i))
        _sffi_core_array_query_rt_array_push(result, pair)
        i = i + 1
    return result

pub fn rt_array_enumerate(array: i64) -> i64:
    if _sffi_core_array_query_array_is_valid(array) < 1:
        return 0
    val len = _sffi_core_array_query_array_len_value(array)
    val result = _sffi_core_array_query_rt_array_new(len)
    if result < 1:
        return 0
    val items = _sffi_core_array_query_array_items(array)
    var i = 0
    while i < len:
        val pair = _sffi_core_array_query_rt_array_new(2)
        if pair < 1:
            return 0
        _sffi_core_array_query_rt_array_push(pair, array_query_val_from_int(i))
        _sffi_core_array_query_rt_array_push(pair, _sffi_core_array_query_array_load_value(array, items, i))
        _sffi_core_array_query_rt_array_push(result, pair)
        i = i + 1
    return result

pub fn rt_array_flatten(array: i64) -> i64:
    if _sffi_core_array_query_array_is_valid(array) < 1:
        return 0
    val len = _sffi_core_array_query_array_len_value(array)
    # First pass: count total elements
    val items = _sffi_core_array_query_array_items(array)
    var total = 0
    var i = 0
    while i < len:
        val item = _sffi_core_array_query_array_load_value(array, items, i)
        if _sffi_core_array_query_array_is_valid(item) > 0:
            total = total + _sffi_core_array_query_array_len_value(item)
        if _sffi_core_array_query_array_is_valid(item) < 1:
            total = total + 1
        i = i + 1
    val result = _sffi_core_array_query_rt_array_new(total)
    if result < 1:
        return 0
    # Second pass: copy
    i = 0
    while i < len:
        val item = _sffi_core_array_query_array_load_value(array, items, i)
        if _sffi_core_array_query_array_is_valid(item) > 0:
            val inner_len = _sffi_core_array_query_array_len_value(item)
            val inner_items = _sffi_core_array_query_array_items(item)
            var k = 0
            while k < inner_len:
                _sffi_core_array_query_rt_array_push(result, _sffi_core_array_query_array_load_value(item, inner_items, k))
                k = k + 1
        if _sffi_core_array_query_array_is_valid(item) < 1:
            _sffi_core_array_query_rt_array_push(result, item)
        i = i + 1
    return result

pub fn rt_array_join(array: i64, separator: i64) -> i64:
    return _sffi_core_array_query_rt_string_join(array, separator)
