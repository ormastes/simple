pub enum Val:
    Null
    Bool(bool)
    Int(i64)
    Float(f64)
    String(text)
    Array([Val])
    Dict(Dict<text, Val>)
    Table(headers: [text], rows: [[Val]])

    static fn array(items: [Val]) -> Val:
        Val.Array(items)

    static fn empty_array() -> Val:
        Val.Array([])

    fn is_null(self) -> bool:
        match self:
            case Null: true
            case _: false

fn main() -> i64:
    var v = Val.array([Val.Int(1)])
    if v.is_null(): return 1
    0
