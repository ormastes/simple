# Canonical malformed ABI/layout vectors shared by every generated KPF binding.

pub struct KpfAbiLayoutVectorV1:
    name: text
    available_size: i64
    struct_size: i64
    payload_offset: i64
    payload_length: i64
    required_alignment: i64
    reserved0: i64
    expected_valid: bool

pub const KPF_ABI_LAYOUT_PREFIX_SIZE_V1: i64 = 32

pub fn kpf_abi_layout_vectors_v1() -> [KpfAbiLayoutVectorV1]:
    [
        KpfAbiLayoutVectorV1(name: "valid_exact", available_size: 48, struct_size: 32, payload_offset: 32, payload_length: 16, required_alignment: 8, reserved0: 0, expected_valid: true),
        KpfAbiLayoutVectorV1(name: "valid_append_only_tail", available_size: 56, struct_size: 40, payload_offset: 40, payload_length: 16, required_alignment: 8, reserved0: 0, expected_valid: true),
        KpfAbiLayoutVectorV1(name: "truncated_prefix", available_size: 48, struct_size: 31, payload_offset: 32, payload_length: 16, required_alignment: 8, reserved0: 0, expected_valid: false),
        KpfAbiLayoutVectorV1(name: "declared_oversize", available_size: 48, struct_size: 56, payload_offset: 56, payload_length: 0, required_alignment: 8, reserved0: 0, expected_valid: false),
        KpfAbiLayoutVectorV1(name: "reserved_nonzero", available_size: 48, struct_size: 32, payload_offset: 32, payload_length: 16, required_alignment: 8, reserved0: 1, expected_valid: false),
        KpfAbiLayoutVectorV1(name: "offset_before_header", available_size: 48, struct_size: 32, payload_offset: 24, payload_length: 16, required_alignment: 8, reserved0: 0, expected_valid: false),
        KpfAbiLayoutVectorV1(name: "offset_length_overflow", available_size: 48, struct_size: 32, payload_offset: 40, payload_length: 16, required_alignment: 8, reserved0: 0, expected_valid: false),
        KpfAbiLayoutVectorV1(name: "misaligned_offset", available_size: 48, struct_size: 32, payload_offset: 36, payload_length: 8, required_alignment: 8, reserved0: 0, expected_valid: false),
        KpfAbiLayoutVectorV1(name: "invalid_alignment", available_size: 48, struct_size: 32, payload_offset: 32, payload_length: 16, required_alignment: 3, reserved0: 0, expected_valid: false),
    ]

