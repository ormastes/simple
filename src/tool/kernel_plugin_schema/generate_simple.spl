# Deterministic Simple schema constants for the canonical KPF ABI.

use tool.kernel_plugin_schema.model.{KpfPackageIr}
use tool.kernel_plugin_schema.abi_vectors.{KPF_ABI_LAYOUT_PREFIX_SIZE_V1, kpf_abi_layout_vectors_v1}

fn _symbol_name(value: text) -> text:
    var output = ""
    for character in value:
        if ((character >= 'a' and character <= 'z') or
            (character >= 'A' and character <= 'Z') or
            (character >= '0' and character <= '9')):
            output = output + "{character}"
        else:
            output = output + "_"
    output

# Emit a dependency-free Simple module containing the same persistent schema
# identities and canonical operation slots as the other generated SDKs.
pub fn generate_simple_schema_module(package_ir: KpfPackageIr) -> text:
    var output = "# Generated by simple KPF schema compiler. Do not edit.\n"
    output = output + "pub const KPF_ABI_V1: u32 = 1\n"
    output = output + "pub const KPF_PACKAGE_NAME: text = \"{package_ir.package_name}\"\n"
    output = output + "pub const KPF_PACKAGE_VERSION: text = \"{package_ir.version}\"\n"
    output = output + "pub const KPF_SCHEMA_DIGEST: text = \"{package_ir.schema_digest}\"\n"
    output = output + "pub const KPF_ABI_LAYOUT_PREFIX_SIZE_V1: i64 = {KPF_ABI_LAYOUT_PREFIX_SIZE_V1}\n"
    output = output + "\npub struct KpfAbiLayoutVectorV1:\n    name: text\n    available_size: i64\n    struct_size: i64\n    payload_offset: i64\n    payload_length: i64\n    required_alignment: i64\n    reserved0: i64\n    expected_valid: bool\n"
    output = output + "\npub fn kpf_validate_abi_layout_vector_v1(vector: KpfAbiLayoutVectorV1) -> bool:\n"
    output = output + "    if vector.struct_size < KPF_ABI_LAYOUT_PREFIX_SIZE_V1 or vector.struct_size > vector.available_size: return false\n"
    output = output + "    if vector.reserved0 != 0 or vector.required_alignment <= 0 or (vector.required_alignment & (vector.required_alignment - 1)) != 0: return false\n"
    output = output + "    if vector.payload_offset < vector.struct_size or vector.payload_offset > vector.available_size: return false\n"
    output = output + "    if vector.payload_offset % vector.required_alignment != 0 or vector.payload_length < 0: return false\n"
    output = output + "    vector.payload_length <= vector.available_size - vector.payload_offset\n"
    output = output + "\npub fn kpf_abi_layout_vectors_v1() -> [KpfAbiLayoutVectorV1]:\n    [\n"
    for vector in kpf_abi_layout_vectors_v1():
        var expected = "false"
        if vector.expected_valid:
            expected = "true"
        output = output + "        KpfAbiLayoutVectorV1(name: \"{vector.name}\", available_size: {vector.available_size}, struct_size: {vector.struct_size}, payload_offset: {vector.payload_offset}, payload_length: {vector.payload_length}, required_alignment: {vector.required_alignment}, reserved0: {vector.reserved0}, expected_valid: {expected}),\n"
    output = output + "    ]\n"
    for interface_item in package_ir.interfaces:
        val interface_name = _symbol_name(interface_item.name)
        output = output + "\npub const KPF_INTERFACE_{interface_name}_ID: text = \"{interface_item.interface_id}\"\n"
        output = output + "pub const KPF_INTERFACE_{interface_name}_MAJOR: u32 = {interface_item.major}\n"
        output = output + "pub const KPF_INTERFACE_{interface_name}_REQUIRED_OPERATION_MASK: u64 = {interface_item.required_operation_mask}u64\n"
        var operation_index = 0
        while operation_index < interface_item.operations.len():
            val operation_item = interface_item.operations[operation_index]
            val operation_name = _symbol_name(operation_item.name)
            output = output + "pub const KPF_INTERFACE_{interface_name}_OPERATION_{operation_name}_SLOT: u32 = {operation_index}\n"
            output = output + "pub const KPF_INTERFACE_{interface_name}_OPERATION_{operation_name}_ID: text = \"{operation_item.operation_id}\"\n"
            operation_index = operation_index + 1
    output
