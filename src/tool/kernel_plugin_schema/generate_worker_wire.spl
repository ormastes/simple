# Deterministic worker-wire projection for canonical KPF schemas.

use tool.kernel_plugin_schema.model.{KpfPackageIr}

fn _symbol_name(value: text) -> text:
    var output = ""
    for character in value:
        if ((character >= 'a' and character <= 'z') or
            (character >= 'A' and character <= 'Z') or
            (character >= '0' and character <= '9')):
            output = output + "{character}"
        else:
            output = output + "_"
    output

# Emit the package-specific projection layered over the fixed KPF worker
# envelope. Payload offsets are validated by subtraction so hostile lengths
# cannot wrap an addition before the bounds decision.
pub fn generate_worker_wire_module(package_ir: KpfPackageIr) -> text:
    var output = "# Generated by simple KPF schema compiler. Do not edit.\n"
    output = output + "pub const KPF_WORKER_WIRE_V1: u32 = 1\n"
    output = output + "pub const KPF_WORKER_WIRE_MAGIC_V1: u32 = 1263552087\n"
    output = output + "pub const KPF_WORKER_WIRE_HEADER_SIZE_V1: i64 = 112\n"
    output = output + "pub const KPF_WORKER_WIRE_MAX_FRAME_BYTES_V1: i64 = 4194304\n"
    output = output + "pub const KPF_WORKER_WIRE_SCHEMA_DIGEST: text = \"{package_ir.schema_digest}\"\n"
    output = output + "\npub fn kpf_worker_wire_validate_envelope_v1(magic: u32, wire_version: u32, header_size: i64, schema_digest: text, reserved_zero: u64) -> bool:\n"
    output = output + "    magic == KPF_WORKER_WIRE_MAGIC_V1 and wire_version == KPF_WORKER_WIRE_V1 and header_size == KPF_WORKER_WIRE_HEADER_SIZE_V1 and schema_digest == KPF_WORKER_WIRE_SCHEMA_DIGEST and reserved_zero == 0u64\n"
    output = output + "\npub fn kpf_worker_wire_validate_bounds_v1(frame_length: i64, payload_offset: i64, payload_length: i64, maximum_frame_bytes: i64) -> bool:\n"
    output = output + "    if maximum_frame_bytes < KPF_WORKER_WIRE_HEADER_SIZE_V1: return false\n"
    output = output + "    if maximum_frame_bytes > KPF_WORKER_WIRE_MAX_FRAME_BYTES_V1: return false\n"
    output = output + "    if frame_length < KPF_WORKER_WIRE_HEADER_SIZE_V1 or frame_length > maximum_frame_bytes: return false\n"
    output = output + "    if payload_offset < KPF_WORKER_WIRE_HEADER_SIZE_V1 or payload_offset > frame_length: return false\n"
    output = output + "    if payload_length < 0: return false\n"
    output = output + "    payload_length <= frame_length - payload_offset\n"
    output = output + "\npub fn kpf_worker_wire_operation_known_v1(interface_slot: i64, operation_slot: i64) -> bool:\n"
    var interface_index = 0
    for interface_item in package_ir.interfaces:
        output = output + "    if interface_slot == {interface_index}: return operation_slot >= 0 and operation_slot < {interface_item.operations.len()}\n"
        interface_index = interface_index + 1
    output = output + "    false\n"
    output = output + "\npub fn kpf_worker_wire_operation_required_v1(interface_slot: i64, operation_slot: i64) -> bool:\n"
    interface_index = 0
    for interface_item in package_ir.interfaces:
        var operation_index = 0
        for operation_item in interface_item.operations:
            if operation_item.required:
                output = output + "    if interface_slot == {interface_index} and operation_slot == {operation_index}: return true\n"
            operation_index = operation_index + 1
        interface_index = interface_index + 1
    output = output + "    false\n"
    interface_index = 0
    for interface_item in package_ir.interfaces:
        val interface_name = _symbol_name(interface_item.name)
        output = output + "\npub const KPF_WORKER_INTERFACE_{interface_name}_SLOT: i64 = {interface_index}\n"
        var operation_index = 0
        for operation_item in interface_item.operations:
            val operation_name = _symbol_name(operation_item.name)
            output = output + "pub const KPF_WORKER_INTERFACE_{interface_name}_OPERATION_{operation_name}_SLOT: i64 = {operation_index}\n"
            operation_index = operation_index + 1
        interface_index = interface_index + 1
    output
