# Kernel Plugin Fabric schema compiler intermediate representation.

pub struct KpfOperationIr:
    name: text
    operation_id: text
    required: bool

pub struct KpfInterfaceIr:
    name: text
    interface_id: text
    major: i64
    operations: [KpfOperationIr]
    required_operation_mask: i64

pub struct KpfPackageIr:
    package_name: text
    version: text
    schema_digest: text
    canonical_schema: text
    interfaces: [KpfInterfaceIr]

pub struct KpfCompatibilityReport:
    compatible: bool
    summary: text
