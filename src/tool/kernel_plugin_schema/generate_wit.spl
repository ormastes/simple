# Deterministic WebAssembly Component Model projection of canonical KPF IR.

use tool.kernel_plugin_schema.model.{KpfPackageIr}

fn _is_ascii_upper(character: char) -> bool:
    character >= 'A' and character <= 'Z'

fn _is_ascii_lower(character: char) -> bool:
    character >= 'a' and character <= 'z'

fn _is_ascii_digit(character: char) -> bool:
    character >= '0' and character <= '9'

fn _ascii_lower(character: char) -> char:
    if _is_ascii_upper(character):
        chr(ord(character) + 32)
    else:
        character

fn _wit_identifier(value: text) -> text:
    var output = ""
    var previous_was_separator = true
    var previous_was_lower_or_digit = false
    for character in value:
        if _is_ascii_upper(character):
            if previous_was_lower_or_digit and not previous_was_separator:
                output = output + "-"
            output = output + "{_ascii_lower(character)}"
            previous_was_separator = false
            previous_was_lower_or_digit = false
        else if _is_ascii_lower(character) or _is_ascii_digit(character):
            output = output + "{character}"
            previous_was_separator = false
            previous_was_lower_or_digit = true
        else if not previous_was_separator:
            output = output + "-"
            previous_was_separator = true
            previous_was_lower_or_digit = false
    if output.ends_with("-"):
        output.slice(0, output.len() - 1)
    else:
        output

fn _package_namespace(package_name: text) -> text:
    val parts = package_name.split(".")
    if parts.len() > 1:
        _wit_identifier(parts[0])
    else:
        "simple"

fn _package_name(package_name: text) -> text:
    val parts = package_name.split(".")
    if parts.len() <= 1:
        return _wit_identifier(package_name)
    var output = ""
    var index = 1
    while index < parts.len():
        if output != "":
            output = output + "-"
        output = output + _wit_identifier(parts[index])
        index = index + 1
    output

fn _required_text(required: bool) -> text:
    if required:
        "true"
    else:
        "false"

# Emit a WIT package directly from canonical KPF IR. Payloads remain opaque
# batches until the canonical schema model gains typed operation parameters.
pub fn generate_wit_component(package_ir: KpfPackageIr) -> text:
    val namespace = _package_namespace(package_ir.package_name)
    val package_name = _package_name(package_ir.package_name)
    var output = "// Generated by simple KPF schema compiler. Do not edit.\n"
    output = output + "// kpf-schema-digest: {package_ir.schema_digest}\n"
    output = output + "package {namespace}:{package_name};\n"

    for interface_item in package_ir.interfaces:
        val interface_name = _wit_identifier(interface_item.name)
        output = output + "\n// kpf-interface-id: {interface_item.interface_id}\n"
        output = output + "// kpf-interface-major: {interface_item.major}\n"
        output = output + "// kpf-required-operation-mask: {interface_item.required_operation_mask}\n"
        output = output + "interface {interface_name} {\n"
        output = output + "  variant kpf-error {\n"
        output = output + "    rejected,\n"
        output = output + "    would-block,\n"
        output = output + "    capacity-exceeded,\n"
        output = output + "    deadline-exceeded,\n"
        output = output + "    cancelled,\n"
        output = output + "    failed,\n"
        output = output + "  }\n"
        var operation_index = 0
        while operation_index < interface_item.operations.len():
            val operation_item = interface_item.operations[operation_index]
            val operation_name = _wit_identifier(operation_item.name)
            output = output + "\n  // kpf-operation-id: {operation_item.operation_id}\n"
            output = output + "  // kpf-operation-slot: {operation_index}\n"
            output = output + "  // kpf-operation-required: {_required_text(operation_item.required)}\n"
            output = output + "  {operation_name}: func(input: list<u8>) -> result<list<u8>, kpf-error>;\n"
            operation_index = operation_index + 1
        output = output + "}\n"

    output = output + "\nworld {package_name}-plugin {\n"
    for interface_item in package_ir.interfaces:
        output = output + "  export {_wit_identifier(interface_item.name)};\n"
    output = output + "}\n"
    output
