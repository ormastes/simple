# Deterministic Rust schema constants for the canonical KPF C ABI.

use tool.kernel_plugin_schema.model.{KpfPackageIr}
use tool.kernel_plugin_schema.abi_vectors.{KPF_ABI_LAYOUT_PREFIX_SIZE_V1, kpf_abi_layout_vectors_v1}

fn _symbol_name(value: text) -> text:
    var output = ""
    for character in value:
        if ((character >= 'a' and character <= 'z') or
            (character >= 'A' and character <= 'Z') or
                 (character >= '0' and character <= '9')):
            output = output + "{character}"
        else:
            output = output + "_"
    output

# Emit a dependency-free Rust module containing persistent schema identities,
# required-operation masks, and deterministic operation slots.
pub fn generate_rust_schema_module(package_ir: KpfPackageIr) -> text:
    var output = "// Generated by simple KPF schema compiler. Do not edit.\n#![allow(non_snake_case, non_upper_case_globals)]\n"
    output = output + "pub const KPF_ABI_V1: u32 = 1;\n"
    output = output + "pub const SCHEMA_DIGEST: &str = \"{package_ir.schema_digest}\";\n"
    output = output + "pub const KPF_ABI_LAYOUT_PREFIX_SIZE_V1: u64 = {KPF_ABI_LAYOUT_PREFIX_SIZE_V1};\n"
    output = output + "#[derive(Clone, Copy, Debug)]\npub struct KpfAbiLayoutVectorV1 { pub name: &'static str, pub available_size: u64, pub struct_size: u64, pub payload_offset: u64, pub payload_length: u64, pub required_alignment: u64, pub reserved0: u64, pub expected_valid: bool }\n"
    output = output + "pub const fn kpf_validate_abi_layout_vector_v1(vector: &KpfAbiLayoutVectorV1) -> bool {\n    vector.struct_size >= KPF_ABI_LAYOUT_PREFIX_SIZE_V1 && vector.struct_size <= vector.available_size && vector.reserved0 == 0 && vector.required_alignment != 0 && vector.required_alignment.is_power_of_two() && vector.payload_offset >= vector.struct_size && vector.payload_offset <= vector.available_size && vector.payload_offset % vector.required_alignment == 0 && vector.payload_length <= vector.available_size - vector.payload_offset\n}\n"
    val vectors = kpf_abi_layout_vectors_v1()
    output = output + "pub const KPF_ABI_LAYOUT_VECTORS_V1: [KpfAbiLayoutVectorV1; {vectors.len()}] = [\n"
    for vector in vectors:
        var expected = "false"
        if vector.expected_valid:
            expected = "true"
        output = output + "    KpfAbiLayoutVectorV1 { name: \"{vector.name}\", available_size: {vector.available_size}, struct_size: {vector.struct_size}, payload_offset: {vector.payload_offset}, payload_length: {vector.payload_length}, required_alignment: {vector.required_alignment}, reserved0: {vector.reserved0}, expected_valid: {expected} },\n"
    output = output + "];\n"
    for interface_item in package_ir.interfaces:
        val interface_name = _symbol_name(interface_item.name)
        output = output + "\npub mod interface_{interface_name} {\n"
        output = output + "    pub const ID: &str = \"{interface_item.interface_id}\";\n"
        output = output + "    pub const MAJOR: u32 = {interface_item.major};\n"
        output = output + "    pub const REQUIRED_OPERATION_MASK: u64 = {interface_item.required_operation_mask};\n"
        var operation_index = 0
        while operation_index < interface_item.operations.len():
            val operation_item = interface_item.operations[operation_index]
            val operation_name = _symbol_name(operation_item.name)
            output = output + "    pub const OPERATION_{operation_name}_SLOT: u32 = {operation_index};\n"
            output = output + "    pub const OPERATION_{operation_name}_ID: &str = \"{operation_item.operation_id}\";\n"
            operation_index = operation_index + 1
        output = output + "}\n"
    output
