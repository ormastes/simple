# SMF normative wire schema (Simple Module Format), v1.3
# Status: NORMATIVE for the pure-Simple toolchain AND wire-identical to the
# Rust seed (src/compiler_rust/common/src/smf/header.rs) since v1.3
# (2026-11-06, bug smf_header_wire_layout_diverges_rust_vs_simple_2026-08-10).
# The AUDIT 2026-08-10 divergence is recorded below for history; the legacy
# packed 128-byte layout is accepted on READ ONLY for one release.
smf:
  magic: "SMF\0"          # bytes 0..4
  endianness: little
  header:
    # v1.3: 96-byte block, the Rust seed's #[repr(C)] struct layout, written
    # as a TRAILER at EOF-96 (leading offset-0 header still accepted for
    # legacy files / archive slices). Locator precedence, shared by every
    # reader (compiler.backend.linker.smf_header.smf_header_trailer_offset):
    #   1. magic at EOF-96 with version >= 1.3 (unambiguous)
    #   2. magic at EOF-128 (legacy packed, read-only)
    #   3. seed-shaped header at EOF-96 (Rust-written 1.1: padding 20..24 == 0,
    #      section_count > 0, section_table_offset@24 != 0)
    size_bytes: 96        # fixed; NEVER extended — new metadata goes in the
                          # .simple_meta SECTION, never in new header bytes
    fields:               # repr(C) natural alignment (offset, size)
      magic:                 {offset: 0,  size: 4}
      version_major:         {offset: 4,  size: 1}   # = 1
      version_minor:         {offset: 5,  size: 1}   # 3 (writers); 1 (Rust seed stamp)
      platform:              {offset: 6,  size: 1}
      arch:                  {offset: 7,  size: 1}
      flags:                 {offset: 8,  size: 4, type: u32}
      compression:           {offset: 12, size: 1}
      compression_level:     {offset: 13, size: 1}
      reserved_compression:  {offset: 14, size: 2}
      section_count:         {offset: 16, size: 4, type: u32}
      padding:               {offset: 20, size: 4}   # alignment; content unspecified from Rust
      section_table_offset:  {offset: 24, size: 8, type: u64}
      symbol_table_offset:   {offset: 32, size: 8, type: u64}
      symbol_count:          {offset: 40, size: 4, type: u32}
      exported_count:        {offset: 44, size: 4, type: u32}
      entry_point:           {offset: 48, size: 8, type: u64}
      stub_size:             {offset: 56, size: 4, type: u32}
      smf_data_offset:       {offset: 60, size: 4, type: u32}
      module_hash:           {offset: 64, size: 8, type: u64}
      source_hash:           {offset: 72, size: 8, type: u64}
      app_type:              {offset: 80, size: 1}
      padding_hint:          {offset: 81, size: 1}   # alignment; content unspecified from Rust
      window_width:          {offset: 82, size: 2, type: u16}
      window_height:         {offset: 84, size: 2, type: u16}
      prefetch_hint:         {offset: 86, size: 1}
      prefetch_file_count:   {offset: 87, size: 1}
      reserved_hints:        {offset: 88, size: 5}   # Rust: reserved[5]
      padding_tail:          {offset: 93, size: 3}   # alignment; content unspecified from Rust
    extensibility:
      # Room inside the fixed header: 25 free flag bits, reserved_compression
      # (2 B), reserved_hints (5 B). Padding bytes carry NO meaning (the seed
      # writes them by struct memcpy). Anything larger is a .simple_meta record.
      free_flag_bits: 25
      free_reserved_bytes: 7
    version_minor_semantics:
      # Readers accept major == 1 and 1 <= minor <= 3. The minor also selects
      # the relocation-entry tail format (bytes 13..16 of each 24-byte entry):
      #   1: reserved, must be zero
      #   2: byte 15 == 0xA2 marker, bytes 13..15 = source section index (u16)
      #   3: header flag 0x80 (SMF_FLAG_SOURCE_RELOCS) set => v1.2 form required;
      #      clear => v1.1 form required (replaces the "minor = 2" stamp)
      accepted: [1, 2, 3]
    flags:
      executable: 0x01
      reloadable: 0x02
      debug_info: 0x04
      pic: 0x08
      has_stub: 0x10
      note_sdn: 0x20
      aspect_pack: 0x40
      source_relocs: 0x80        # v1.3
  v1_1:
    trailer_location: "EOF-128"               # legacy packed layout, read-only
    legacy_packed_size_bytes: 128
    legacy_packed_fields:                     # offsets differ from v1.3 by -4 from 20 on;
                                              # hint block packed: app_type@76 ww@77 wh@79
                                              # ph@81 pfc@82 reserved_hints@83 reserved@88
      compile_options_hash: {offset: 88, size: 16}   # reserved[0..16]; all-zero = absent;
                                                     # superseded by records.compile_options_v1
    removal: "delete the packed read path one release after v1.3 lands"
  v1_2:
    # Metadata SECTION, not header bytes. A section named ".simple_meta"
    # listed in the ordinary section table (section type Note = 7); payload
    # is a TLV stream. Implemented by compiler.backend.linker.smf_meta.
    meta_section:
      name: ".simple_meta"
      section_type: 7
      duplicate_sections: reject         # two .simple_meta sections = corruption, never a hit
      tlv_record:           # each record, packed little-endian
        kind:           {offset: 0, size: 2, type: u16}
        version:        {offset: 2, size: 1, type: u8}
        flags:          {offset: 3, size: 1, type: u8}
        payload_length: {offset: 4, size: 4, type: u32}
        payload:        {offset: 8, size: payload_length}
      reader_rules:
        unknown_kind: skip                 # tolerance: skip via payload_length
        truncated_record: reject           # payload_length past section end = error
    records:
      interface_compatibility_v1:
        kind: 1
        payload_size: 72
        fields:
          exact_digest:    {offset: 0,  size: 32}
          lineage_digest:  {offset: 32, size: 32}
          generation:      {offset: 64, size: 4, type: u32}
          compatible_from: {offset: 68, size: 4, type: u32}
      compile_options_v1:
        # compile_options_hash_to_bytes() encoding (80.driver/cache/compile_options_hash.spl).
        # Written by SmfBuildOptions.compile_options_bytes; absent = no record.
        kind: 2
        payload_size: 16
        fields:
          hash:          {offset: 0,  size: 8, type: u64}
          backend_kind:  {offset: 8,  size: 1}
          opt_level:     {offset: 9,  size: 1}
          target_arch:   {offset: 10, size: 1}
          flags:         {offset: 11, size: 1}
          reserved:      {offset: 12, size: 4}
  divergence_audit_2026_08_10:
    # Rust seed SmfHeader is #[repr(C)] with natural alignment: measured via
    # compiled offset_of probe -> SIZE=96, section_table_offset@24,
    # symbol_table_offset@32, symbol_count@40, exported_count@44,
    # entry_point@48, stub_size@56, smf_data_offset@60, module_hash@64,
    # source_hash@72, app_type@80, window_width@82, window_height@84,
    # prefetch_hint@86, prefetch_file_count@87, reserved[5]@88.
    # Trailer sought at EOF-96 (SmfHeader::SIZE), raw struct memcpy on
    # read AND write. Every field from offset 20 onward disagreed with the
    # packed 128-byte layout of v1.0-v1.2; the compile-options-hash bytes
    # (88..104) do not exist in the Rust struct at all.
    rust_seed_header_size: 96
    wire_identical: true                  # since v1.3 (2026-11-06); was false
    converged_by: "writers emit the 96-byte layout; compile-options hash moved to .simple_meta kind 2"
