namespace CacheProtocol

abbrev Sha := String

structure Dep where
  moduleId    : String
  ifaceDigest : Sha
  deriving DecidableEq, Repr

/-- result_kind enum — encoded by NAME, never by ordinal. -/
inductive ResultKind where
  | interpreterModule | mirModule | objectFile | interfaceSummary
  | diagnostics | aopWeaveArtifact | adviceArtifact | aspectPack
  | blockTransferResult | functionSummary | linkProduct
  deriving DecidableEq, Repr

def ResultKind.name : ResultKind → String
  | .interpreterModule   => "interpreter_module"
  | .mirModule           => "mir_module"
  | .objectFile          => "object_file"
  | .interfaceSummary    => "interface_summary"
  | .diagnostics         => "diagnostics"
  | .aopWeaveArtifact    => "aop_weave_artifact"
  | .adviceArtifact      => "advice_artifact"
  | .aspectPack          => "aspect_pack"
  | .blockTransferResult => "block_transfer_result"
  | .functionSummary     => "function_summary"
  | .linkProduct         => "link_product"

theorem ResultKind.name_inj : ∀ a b : ResultKind, name a = name b → a = b := by
  intro a b h
  cases a <;> cases b <;> first | rfl | simp [name] at h

/-- The 21-field v2 ActionKey (schema canonical_order; domain is pos 0). -/
structure ActionKey where
  domain : String
  compilerExe : Sha
  liveCompilerSrc : Sha
  schemaVersion : Nat
  targetTriple : String
  hostArch : String
  cfgFeatures : List String
  stdlibVariant : String
  runtimeFamily : String
  sourceContent : Sha
  resolutionWitness : Sha
  deps : List Dep
  macroRoot : Sha
  aopSelection : Sha
  ctEnvInputs : List String
  schemaDigest : Sha
  aopSurfaceRoot : Sha
  aopCandidatePartitionRoots : List Sha
  aopWeaveRoot : Sha
  blockManifestRoots : List Sha
  resultKind : ResultKind
  deriving DecidableEq, Repr

inductive Canon where
  | str  : String → Canon
  | nat  : Nat → Canon
  | tag  : String → Canon → Canon
  | pair : Canon → Canon → Canon
  | strs : List String → Canon
  | deps : List Dep → Canon
  deriving DecidableEq, Repr

def depLe (a b : Dep) : Bool :=
  decide (a.moduleId < b.moduleId) ||
  (a.moduleId == b.moduleId &&
    (decide (a.ifaceDigest < b.ifaceDigest) || a.ifaceDigest == b.ifaceDigest))

def insDep (a : Dep) : List Dep → List Dep
  | []      => [a]
  | b :: bs => if depLe a b then a :: b :: bs else b :: insDep a bs

def sortDeps : List Dep → List Dep
  | []       => []
  | a :: as' => insDep a (sortDeps as')

def strLe (a b : String) : Bool := decide (a < b) || a == b

def insStr (a : String) : List String → List String
  | []      => [a]
  | b :: bs => if strLe a b then a :: b :: bs else b :: insStr a bs

def sortStrs : List String → List String
  | []       => []
  | a :: as' => insStr a (sortStrs as')

/-- Canonical key: every set-typed field normalised. -/
structure CanonKey where
  domain : String
  compilerExe : Sha
  liveCompilerSrc : Sha
  schemaVersion : Nat
  targetTriple : String
  hostArch : String
  cfgFeatures : List String
  stdlibVariant : String
  runtimeFamily : String
  sourceContent : Sha
  resolutionWitness : Sha
  deps : List Dep
  macroRoot : Sha
  aopSelection : Sha
  ctEnvInputs : List String
  schemaDigest : Sha
  aopSurfaceRoot : Sha
  aopCandidatePartitionRoots : List Sha
  aopWeaveRoot : Sha
  blockManifestRoots : List Sha
  resultKind : ResultKind
  deriving DecidableEq, Repr

def canonKey (k : ActionKey) : CanonKey :=
  { domain := k.domain
  , compilerExe := k.compilerExe
  , liveCompilerSrc := k.liveCompilerSrc
  , schemaVersion := k.schemaVersion
  , targetTriple := k.targetTriple
  , hostArch := k.hostArch
  , cfgFeatures := sortStrs k.cfgFeatures
  , stdlibVariant := k.stdlibVariant
  , runtimeFamily := k.runtimeFamily
  , sourceContent := k.sourceContent
  , resolutionWitness := k.resolutionWitness
  , deps := sortDeps k.deps
  , macroRoot := k.macroRoot
  , aopSelection := k.aopSelection
  , ctEnvInputs := sortStrs k.ctEnvInputs
  , schemaDigest := k.schemaDigest
  , aopSurfaceRoot := k.aopSurfaceRoot
  , aopCandidatePartitionRoots := sortStrs k.aopCandidatePartitionRoots
  , aopWeaveRoot := k.aopWeaveRoot
  , blockManifestRoots := sortStrs k.blockManifestRoots
  , resultKind := k.resultKind
  }

/-- The v2 canonical encoder: every schema field exactly once, tagged,
    in canonical_order; set fields sorted; result_kind by name. -/
def encode (k : ActionKey) : Canon :=
  Canon.tag k.domain <|
    Canon.pair (.tag "compilerExe" (.str k.compilerExe)) <|
    Canon.pair (.tag "liveCompilerSrc" (.str k.liveCompilerSrc)) <|
    Canon.pair (.tag "schemaVersion" (.nat k.schemaVersion)) <|
    Canon.pair (.tag "targetTriple" (.str k.targetTriple)) <|
    Canon.pair (.tag "hostArch" (.str k.hostArch)) <|
    Canon.pair (.tag "cfgFeatures" (.strs (sortStrs k.cfgFeatures))) <|
    Canon.pair (.tag "stdlibVariant" (.str k.stdlibVariant)) <|
    Canon.pair (.tag "runtimeFamily" (.str k.runtimeFamily)) <|
    Canon.pair (.tag "sourceContent" (.str k.sourceContent)) <|
    Canon.pair (.tag "resolutionWitness" (.str k.resolutionWitness)) <|
    Canon.pair (.tag "deps" (.deps (sortDeps k.deps))) <|
    Canon.pair (.tag "macroRoot" (.str k.macroRoot)) <|
    Canon.pair (.tag "aopSelection" (.str k.aopSelection)) <|
    Canon.pair (.tag "ctEnvInputs" (.strs (sortStrs k.ctEnvInputs))) <|
    Canon.pair (.tag "schemaDigest" (.str k.schemaDigest)) <|
    Canon.pair (.tag "aopSurfaceRoot" (.str k.aopSurfaceRoot)) <|
    Canon.pair (.tag "aopCandidatePartitionRoots" (.strs (sortStrs k.aopCandidatePartitionRoots))) <|
    Canon.pair (.tag "aopWeaveRoot" (.str k.aopWeaveRoot)) <|
    Canon.pair (.tag "blockManifestRoots" (.strs (sortStrs k.blockManifestRoots))) <|
    Canon.tag "resultKind" (.str k.resultKind.name)

theorem encode_determines_canon (k1 k2 : ActionKey)
    (h : encode k1 = encode k2) : canonKey k1 = canonKey k2 := by
  simp only [encode, Canon.tag.injEq, Canon.pair.injEq, Canon.str.injEq,
             Canon.nat.injEq, Canon.strs.injEq, Canon.deps.injEq,
             true_and] at h
  obtain ⟨hd, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13, h14, h15, h16, h17, h18, h19, h20⟩ := h
  have hrk : k1.resultKind = k2.resultKind :=
    ResultKind.name_inj _ _ h20
  simp only [canonKey, hd, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13, h14, h15, h16, h17, h18, h19, hrk]

theorem canon_determines_encode (k1 k2 : ActionKey)
    (h : canonKey k1 = canonKey k2) : encode k1 = encode k2 := by
  have hd : k1.domain = k2.domain := congrArg CanonKey.domain h
  have h1 : k1.compilerExe = k2.compilerExe := congrArg CanonKey.compilerExe h
  have h2 : k1.liveCompilerSrc = k2.liveCompilerSrc := congrArg CanonKey.liveCompilerSrc h
  have h3 : k1.schemaVersion = k2.schemaVersion := congrArg CanonKey.schemaVersion h
  have h4 : k1.targetTriple = k2.targetTriple := congrArg CanonKey.targetTriple h
  have h5 : k1.hostArch = k2.hostArch := congrArg CanonKey.hostArch h
  have h6 : sortStrs k1.cfgFeatures = sortStrs k2.cfgFeatures := congrArg CanonKey.cfgFeatures h
  have h7 : k1.stdlibVariant = k2.stdlibVariant := congrArg CanonKey.stdlibVariant h
  have h8 : k1.runtimeFamily = k2.runtimeFamily := congrArg CanonKey.runtimeFamily h
  have h9 : k1.sourceContent = k2.sourceContent := congrArg CanonKey.sourceContent h
  have h10 : k1.resolutionWitness = k2.resolutionWitness := congrArg CanonKey.resolutionWitness h
  have h11 : sortDeps k1.deps = sortDeps k2.deps := congrArg CanonKey.deps h
  have h12 : k1.macroRoot = k2.macroRoot := congrArg CanonKey.macroRoot h
  have h13 : k1.aopSelection = k2.aopSelection := congrArg CanonKey.aopSelection h
  have h14 : sortStrs k1.ctEnvInputs = sortStrs k2.ctEnvInputs := congrArg CanonKey.ctEnvInputs h
  have h15 : k1.schemaDigest = k2.schemaDigest := congrArg CanonKey.schemaDigest h
  have h16 : k1.aopSurfaceRoot = k2.aopSurfaceRoot := congrArg CanonKey.aopSurfaceRoot h
  have h17 : sortStrs k1.aopCandidatePartitionRoots = sortStrs k2.aopCandidatePartitionRoots := congrArg CanonKey.aopCandidatePartitionRoots h
  have h18 : k1.aopWeaveRoot = k2.aopWeaveRoot := congrArg CanonKey.aopWeaveRoot h
  have h19 : sortStrs k1.blockManifestRoots = sortStrs k2.blockManifestRoots := congrArg CanonKey.blockManifestRoots h
  have h20 : k1.resultKind = k2.resultKind := congrArg CanonKey.resultKind h
  simp only [encode, hd, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13, h14, h15, h16, h17, h18, h19, h20]

theorem encode_eq_iff_canon (k1 k2 : ActionKey) :
    encode k1 = encode k2 ↔ canonKey k1 = canonKey k2 :=
  ⟨encode_determines_canon k1 k2, canon_determines_encode k1 k2⟩

-- Byte-level rendering — mirrors action_key.spl canon_* framing exactly.
def canonStr (s : String) : String := "S" ++ toString s.length ++ ":" ++ s
def canonNat (n : Nat) : String := "N" ++ toString n ++ ";"
def canonField (tag v : String) : String := "F" ++ toString tag.length ++ ":" ++ tag ++ v
def canonSeq (items : List String) : String :=
  "Q" ++ toString items.length ++ ":" ++ String.join items
def canonDep (d : Dep) : String :=
  canonSeq [canonField "moduleId" (canonStr d.moduleId),
            canonField "ifaceDigest" (canonStr d.ifaceDigest)]

/-- The v1 inner field items (positions 1..14), byte-identical to
    action_key.spl's `inner` list. -/
def innerItemsV1 (k : ActionKey) : List String :=
  [canonField "compilerExe" (canonStr k.compilerExe)
  , canonField "liveCompilerSrc" (canonStr k.liveCompilerSrc)
  , canonField "schemaVersion" (canonNat k.schemaVersion)
  , canonField "targetTriple" (canonStr k.targetTriple)
  , canonField "hostArch" (canonStr k.hostArch)
  , canonField "cfgFeatures" (canonSeq ((sortStrs k.cfgFeatures).map canonStr))
  , canonField "stdlibVariant" (canonStr k.stdlibVariant)
  , canonField "runtimeFamily" (canonStr k.runtimeFamily)
  , canonField "sourceContent" (canonStr k.sourceContent)
  , canonField "resolutionWitness" (canonStr k.resolutionWitness)
  , canonField "deps" (canonSeq ((sortDeps k.deps).map canonDep))
  , canonField "macroRoot" (canonStr k.macroRoot)
  , canonField "aopSelection" (canonStr k.aopSelection)
  , canonField "ctEnvInputs" (canonSeq ((sortStrs k.ctEnvInputs).map canonStr))
  ]

/-- All v2 inner field items (positions 1..20). -/
def innerItems (k : ActionKey) : List String :=
  innerItemsV1 k ++
  [canonField "schemaDigest" (canonStr k.schemaDigest)
  , canonField "aopSurfaceRoot" (canonStr k.aopSurfaceRoot)
  , canonField "aopCandidatePartitionRoots" (canonSeq ((sortStrs k.aopCandidatePartitionRoots).map canonStr))
  , canonField "aopWeaveRoot" (canonStr k.aopWeaveRoot)
  , canonField "blockManifestRoots" (canonSeq ((sortStrs k.blockManifestRoots).map canonStr))
  , canonField "resultKind" (canonStr k.resultKind.name)
  ]

/-- Byte-level v2 encoding: field(domain, seq(inner 1..20)). -/
def encodeString (k : ActionKey) : String :=
  canonField k.domain (canonSeq (innerItems k))

/-- PREFIX FREEZE, byte level: the first 14 inner items of the v2 encoding
    are exactly the v1 inner items. -/
theorem innerItems_take_14_is_v1 (k : ActionKey) :
    (innerItems k).take 14 = innerItemsV1 k := rfl

structure Entry where
  key      : ActionKey
  artifact : Nat
  deriving Repr

def WellFormed (realize : CanonKey → Nat) (tbl : List Entry) : Prop :=
  ∀ e ∈ tbl, e.artifact = realize (canonKey e.key)

def lookup (tbl : List Entry) (k : ActionKey) : Option Nat :=
  (tbl.find? (fun e => decide (encode e.key = encode k))).map (·.artifact)

end CacheProtocol
