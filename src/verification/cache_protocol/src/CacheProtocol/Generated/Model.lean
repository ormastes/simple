def sStr (s : String) : String := "S" ++ toString s.length ++ ":" ++ s
def sNat (n : Nat) : String := "N" ++ toString n ++ ";"
def sField (tagName v : String) : String := "F" ++ toString tagName.length ++ ":" ++ tagName ++ v
def sSeq (items : List String) : String := "Q" ++ toString items.length ++ ":" ++ String.join items
def sDep (d : Dep) : String :=
  sSeq [sField "moduleId" (sStr d.moduleId), sField "ifaceDigest" (sStr d.ifaceDigest)]

/-- v2 wire form: `F<domain>Q20:<fields>`; v1 prefix byte-identical. -/
def wire (k : ActionKey) : String :=
  sField k.domain (sSeq
    [ sField "compilerExe" (sStr k.compilerExe)
    , sField "liveCompilerSrc" (sStr k.liveCompilerSrc)
    , sField "schemaVersion" (sNat k.schemaVersion)
    , sField "targetTriple" (sStr k.targetTriple)
    , sField "hostArch" (sStr k.hostArch)
    , sField "cfgFeatures" (sSeq ((sortStrs k.cfgFeatures).map sStr))
    , sField "stdlibVariant" (sStr k.stdlibVariant)
    , sField "runtimeFamily" (sStr k.runtimeFamily)
    , sField "sourceContent" (sStr k.sourceContent)
    , sField "resolutionWitness" (sStr k.resolutionWitness)
    , sField "deps" (sSeq ((sortDeps k.deps).map sDep))
    , sField "macroRoot" (sStr k.macroRoot)
    , sField "aopSelection" (sStr k.aopSelection)
    , sField "ctEnvInputs" (sSeq ((sortStrs k.ctEnvInputs).map sStr))
    , sField "schemaDigest" (sStr k.schemaDigest)
    , sField "aopSurfaceRoot" (sStr k.aopSurfaceRoot)
    , sField "aopCandidatePartitionRoots" (sSeq ((sortStrs k.aopCandidatePartitionRoots).map sStr))
    , sField "aopWeaveRoot" (sStr k.aopWeaveRoot)
    , sField "blockManifestRoots" (sSeq ((sortStrs k.blockManifestRoots).map sStr))
    , sField "resultKind" (sStr k.resultKind.name)
    ]
    )

