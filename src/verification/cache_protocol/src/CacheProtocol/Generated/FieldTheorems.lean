-- excluded_from_key — negative (field-absent) theorems. The build env
-- carries every excluded field beside the key; the encoder reads ONLY
-- the key, so changing any excluded field is invisible to identity.
structure BuildEnv where
  key : ActionKey
  branch_name : String  -- PROVENANCE
  source_commit : String  -- PROVENANCE
  source_tree : String  -- PROVENANCE
