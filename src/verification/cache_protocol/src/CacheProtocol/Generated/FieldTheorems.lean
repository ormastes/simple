  timestamp : Nat  -- PROVENANCE
  workspace_absolute_path : String  -- LOCAL_STATE
  workspace_id : String  -- LOCAL_STATE
  worktree_dirty : Bool  -- LOCAL_STATE
  watcher_generation : Nat  -- LOCAL_STATE
  runtime_activation_generation : Nat  -- LOCAL_STATE
  jit_address : Nat  -- LOCAL_STATE
  loader_generation : Nat  -- LOCAL_STATE
  negative_resolution_entry : String  -- LOCAL_STATE
  last_access_time : Nat  -- GC_METADATA
  access_count : Nat  -- GC_METADATA
  unique_retained_bytes : Nat  -- GC_METADATA
  recomputation_cost_ms : Nat  -- GC_METADATA
