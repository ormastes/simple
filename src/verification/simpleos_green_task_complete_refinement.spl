# Implementation-linked SimpleOS green-task completion refinement.
#
# The validator executes the real product transition over every semantic state
# class (including an unknown text tag) and boundary-oriented result samples.
# Lean supplies the universal record/first-write-wins proof. This slice is
# model_proven until a typed proof/replay receipt promotes the source relation.

use std.common.crypto.sha256.{sha256_text}
use compiler.common.assurance.formal_receipt.{TrustManifestV1,
    VerificationCacheKeyV1, ProofReceiptV1}
use compiler.common.assurance.formal_status.{FormalStatus}
use compiler.common.assurance.replay_receipt.{IndependentReplayClosureV1}
use compiler.common.assurance.trust_audit.{audit_lean_axiom_report}
use os.kernel.scheduler.green_task.{GREEN_TASK_RUNNABLE, GREEN_TASK_PARKED,
    GREEN_TASK_DONE, GreenTaskRecord, green_task_complete}

pub val GREEN_TASK_COMPLETE_CASE_COUNT_V1: i64 = 12

fn green_task_record_equal_v1(lhs: GreenTaskRecord,
    rhs: GreenTaskRecord) -> bool:
    lhs.task_id == rhs.task_id and lhs.home_cpu == rhs.home_cpu and
        lhs.assigned_cpu == rhs.assigned_cpu and
        lhs.affinity_mask == rhs.affinity_mask and lhs.state == rhs.state and
        lhs.park_reason == rhs.park_reason and lhs.result == rhs.result

fn green_task_complete_spec_v1(task: GreenTaskRecord,
    result: i64) -> GreenTaskRecord:
    if task.state == GREEN_TASK_DONE: return task
    GreenTaskRecord(task_id: task.task_id, home_cpu: task.home_cpu,
        assigned_cpu: task.assigned_cpu, affinity_mask: task.affinity_mask,
        state: GREEN_TASK_DONE, park_reason: "", result: result)

fn green_task_complete_preserve_reason_mutant_v1(task: GreenTaskRecord,
    result: i64) -> GreenTaskRecord:
    if task.state == GREEN_TASK_DONE: return task
    GreenTaskRecord(task_id: task.task_id, home_cpu: task.home_cpu,
        assigned_cpu: task.assigned_cpu, affinity_mask: task.affinity_mask,
        state: GREEN_TASK_DONE, park_reason: task.park_reason, result: result)

fn green_task_complete_overwrite_done_mutant_v1(task: GreenTaskRecord,
    result: i64) -> GreenTaskRecord:
    GreenTaskRecord(task_id: task.task_id, home_cpu: task.home_cpu,
        assigned_cpu: task.assigned_cpu, affinity_mask: task.affinity_mask,
        state: GREEN_TASK_DONE, park_reason: "", result: result)

fn green_task_complete_state_samples_v1() -> [GreenTaskRecord]:
    [GreenTaskRecord(11, 0, 0, 0, GREEN_TASK_RUNNABLE, "", 0),
        GreenTaskRecord(12, 1, 2, 5, GREEN_TASK_PARKED, "channel_recv", -7),
        GreenTaskRecord(13, 3, 3, 8, GREEN_TASK_DONE, "", 41),
        GreenTaskRecord(14, 4, 5, 0, "unexpected", "stale", 9)]

fn green_task_complete_result_samples_v1() -> [i64]:
    [-9223372036854775807 - 1, 0, 9223372036854775807]

pub struct SimpleOsGreenTaskCompleteReceiptV1:
    symbol_id: text
    source_semantics_hash: text
    model_semantics_hash: text
    theorem_roots: [text]
    axiom_audit_hash: text
    cache_key_hash: text
    trust_manifest_hash: text
    proof_receipt_hash: text
    replay_closure_hash: text
    checked_case_count: i64
    counterexample_count: i64
    preserve_reason_mutant_counterexamples: i64
    overwrite_done_mutant_counterexamples: i64
    status: FormalStatus
    diagnostic: text

impl SimpleOsGreenTaskCompleteReceiptV1:
    fn permits_model_evidence(current_key: VerificationCacheKeyV1) -> bool:
        self.status == FormalStatus.ModelProven and self.diagnostic == "" and
            current_key.diagnostic() == "" and
            self.cache_key_hash == current_key.hash() and
            self.source_semantics_hash != "" and self.model_semantics_hash != "" and
            self.axiom_audit_hash != "" and self.trust_manifest_hash != "" and
            self.checked_case_count == GREEN_TASK_COMPLETE_CASE_COUNT_V1 and
            self.counterexample_count == 0 and
            self.preserve_reason_mutant_counterexamples > 0 and
            self.overwrite_done_mutant_counterexamples > 0

    pub fn permits_source_refinement(current_key: VerificationCacheKeyV1) -> bool:
        self.status == FormalStatus.SourceRefined and self.diagnostic == "" and
            current_key.diagnostic() == "" and
            self.cache_key_hash == current_key.hash() and
            self.source_semantics_hash != "" and self.model_semantics_hash != "" and
            self.axiom_audit_hash != "" and self.trust_manifest_hash != "" and
            self.proof_receipt_hash != "" and self.replay_closure_hash != "" and
            self.checked_case_count == GREEN_TASK_COMPLETE_CASE_COUNT_V1 and
            self.counterexample_count == 0 and
            self.preserve_reason_mutant_counterexamples > 0 and
            self.overwrite_done_mutant_counterexamples > 0

fn green_task_complete_source_semantics_hash_v1() -> text:
    sha256_text("os.kernel.scheduler.green_task.green_task_complete/bounded-v1|states=runnable,parked,done,unknown|results=i64-min,zero,i64-max|done=identity|non-done=done+clear-reason+replace-result|preserve=id+cpu+affinity")

fn green_task_complete_theorem_roots_v1() -> [text]:
    ["KernelScheduler.complete_refinement_bundle"]

fn green_task_complete_model_semantics_hash_v1() -> text:
    sha256_text("KernelScheduler.GreenTask.complete/v2|done=noop|non-done=done+clear-park-reason+result|frame=task+cpu+affinity")

fn green_task_complete_closed_trust_manifest_v1() -> TrustManifestV1:
    TrustManifestV1(["propext"], [], [], [], [], [])

fn green_task_complete_verification_cache_key_v1() -> VerificationCacheKeyV1:
    val trust = green_task_complete_closed_trust_manifest_v1()
    VerificationCacheKeyV1(green_task_complete_source_semantics_hash_v1(),
        green_task_complete_model_semantics_hash_v1(),
        sha256_text("canonical-weave:none"),
        sha256_text("macro-expansion:none"),
        [sha256_text("os.kernel.scheduler.green_task.GreenTaskRecord")],
        "simple-effects-v1:pure", "source-refinement-validator-v1",
        "simple-source:i64+text", "4.33.0", "", [],
        sha256_text("lean-structural-simp-v1"),
        sha256_text(trust.canonical_text()), "verified")

fn failed_green_task_complete_receipt_v1(diagnostic: text,
    cache_key: VerificationCacheKeyV1, trust_hash: text,
    axiom_hash: text = "", checked: i64 = 0, counterexamples: i64 = 0,
    reason_mutants: i64 = 0, done_mutants: i64 = 0
) -> SimpleOsGreenTaskCompleteReceiptV1:
    SimpleOsGreenTaskCompleteReceiptV1(
        "os.kernel.scheduler.green_task.green_task_complete@bounded-state-result-v1",
        green_task_complete_source_semantics_hash_v1(),
        green_task_complete_model_semantics_hash_v1(),
        green_task_complete_theorem_roots_v1(), axiom_hash, cache_key.hash(),
        trust_hash, "", "", checked, counterexamples, reason_mutants, done_mutants,
        FormalStatus.Failed, diagnostic)

pub fn validate_simpleos_green_task_complete_refinement_v1(
    axiom_report: text) -> SimpleOsGreenTaskCompleteReceiptV1:
    val cache_key = green_task_complete_verification_cache_key_v1()
    val trust = green_task_complete_closed_trust_manifest_v1()
    val trust_hash = sha256_text(trust.canonical_text())
    val roots = green_task_complete_theorem_roots_v1()
    val audit = audit_lean_axiom_report(axiom_report, roots, [])
    if not audit.permits_closed_verification():
        return failed_green_task_complete_receipt_v1(
            "FV2-E-SIMPLEOS-SCHED-AUDIT: complete-transition theorem audit is required",
            cache_key, trust_hash)
    val axiom_hash = sha256_text(axiom_report)
    var checked = 0
    var counterexamples = 0
    var reason_mutants = 0
    var done_mutants = 0
    for task in green_task_complete_state_samples_v1():
        for result in green_task_complete_result_samples_v1():
            val expected = green_task_complete_spec_v1(task, result)
            if not green_task_record_equal_v1(
                green_task_complete(task, result), expected):
                counterexamples = counterexamples + 1
            if not green_task_record_equal_v1(
                green_task_complete_preserve_reason_mutant_v1(task, result), expected):
                reason_mutants = reason_mutants + 1
            if not green_task_record_equal_v1(
                green_task_complete_overwrite_done_mutant_v1(task, result), expected):
                done_mutants = done_mutants + 1
            checked = checked + 1
    if checked != GREEN_TASK_COMPLETE_CASE_COUNT_V1:
        return failed_green_task_complete_receipt_v1(
            "FV2-E-SIMPLEOS-SCHED-COVERAGE: complete-transition matrix is incomplete",
            cache_key, trust_hash, axiom_hash, checked, counterexamples,
            reason_mutants, done_mutants)
    if counterexamples != 0:
        return failed_green_task_complete_receipt_v1(
            "FV2-E-SIMPLEOS-SCHED-REFINEMENT: product complete transition differs from specification",
            cache_key, trust_hash, axiom_hash, checked, counterexamples,
            reason_mutants, done_mutants)
    if reason_mutants == 0 or done_mutants == 0:
        return failed_green_task_complete_receipt_v1(
            "FV2-E-SIMPLEOS-SCHED-MUTATION: complete specification did not reject lifecycle mutants",
            cache_key, trust_hash, axiom_hash, checked, counterexamples,
            reason_mutants, done_mutants)
    SimpleOsGreenTaskCompleteReceiptV1(
        "os.kernel.scheduler.green_task.green_task_complete@bounded-state-result-v1",
        green_task_complete_source_semantics_hash_v1(),
        green_task_complete_model_semantics_hash_v1(), roots, axiom_hash,
        cache_key.hash(), trust_hash, "", "", checked, 0, reason_mutants, done_mutants,
        FormalStatus.ModelProven, "")

pub fn promote_simpleos_green_task_complete_refinement_v2(
    model: SimpleOsGreenTaskCompleteReceiptV1,
    proof: ProofReceiptV1,
    replay: IndependentReplayClosureV1
) -> SimpleOsGreenTaskCompleteReceiptV1:
    val key = green_task_complete_verification_cache_key_v1()
    if not model.permits_model_evidence(key):
        return green_task_complete_promotion_failure_v2(model,
            "FV2-E-SIMPLEOS-SCHED-MODEL: closed model evidence is required")
    if model.theorem_roots.len() != 1 or proof.proof_root != model.theorem_roots[0] or
            proof.status != FormalStatus.ModelProven or proof.diagnostic() != "":
        return green_task_complete_promotion_failure_v2(model,
            "FV2-E-SIMPLEOS-SCHED-PROOF: exact composite theorem receipt is required")
    if proof.trust_manifest_hash != model.trust_manifest_hash:
        return green_task_complete_promotion_failure_v2(model,
            "FV2-E-SIMPLEOS-SCHED-TRUST: proof trust identity differs")
    if not proof.binds_independent_replay(replay):
        return green_task_complete_promotion_failure_v2(model,
            "FV2-E-SIMPLEOS-SCHED-REPLAY: exact independent replay is required")
    if not proof.theorem_dependencies.contains(
            "fv2-simpleos-source-semantics:" + model.source_semantics_hash) or
            not proof.theorem_dependencies.contains(
                "fv2-simpleos-model-semantics:" + model.model_semantics_hash):
        return green_task_complete_promotion_failure_v2(model,
            "FV2-E-SIMPLEOS-SCHED-DEPENDENCY: exact semantic identities are required")
    SimpleOsGreenTaskCompleteReceiptV1(model.symbol_id,
        model.source_semantics_hash, model.model_semantics_hash,
        model.theorem_roots, proof.axiom_audit_hash, model.cache_key_hash,
        model.trust_manifest_hash, proof.hash(), replay.hash(),
        model.checked_case_count, model.counterexample_count,
        model.preserve_reason_mutant_counterexamples,
        model.overwrite_done_mutant_counterexamples,
        FormalStatus.SourceRefined, "")

fn green_task_complete_promotion_failure_v2(
    model: SimpleOsGreenTaskCompleteReceiptV1,
    diagnostic: text
) -> SimpleOsGreenTaskCompleteReceiptV1:
    SimpleOsGreenTaskCompleteReceiptV1(model.symbol_id,
        model.source_semantics_hash, model.model_semantics_hash,
        model.theorem_roots, model.axiom_audit_hash, model.cache_key_hash,
        model.trust_manifest_hash, "", "", model.checked_case_count,
        model.counterexample_count, model.preserve_reason_mutant_counterexamples,
        model.overwrite_done_mutant_counterexamples, FormalStatus.Failed,
        diagnostic)
