# Bounded implementation-linked DBFS commit/crash-visibility refinement.

use std.common.crypto.sha256.{sha256_text}
use compiler.common.assurance.formal_receipt.{TrustManifestV1,
    VerificationCacheKeyV1, ProofReceiptV1}
use compiler.common.assurance.formal_status.{FormalStatus}
use compiler.common.assurance.replay_receipt.{IndependentReplayClosureV1}
use compiler.common.assurance.trust_audit.{audit_lean_axiom_report}
use lib.nogc_sync_mut.db.dbfs_engine.txn.{DbfsTxn, TxnId,
    TXN_STATUS_ACTIVE, TXN_STATUS_COMMITTED, TXN_STATUS_ABORTED}

pub val DBFS_COMMIT_CASE_COUNT_V1: i64 = 6

fn txn_for_commit_v1(wal_flushed: bool, status: u8) -> DbfsTxn:
    DbfsTxn(txn_id: TxnId(value: 97), status: status, data_written: "payload",
        meta_written: true, wal_appended: wal_flushed,
        wal_flushed: wal_flushed, root_published: wal_flushed,
        flush_count: if wal_flushed: 1 else: 0, page_lsn: 12,
        wal_flushed_lsn: if wal_flushed: 12 else: 0)

fn crash_visible_v1(txn: DbfsTxn) -> bool:
    txn.wal_flushed and txn.status == TXN_STATUS_COMMITTED

fn early_commit_mutant_visible_v1(_txn: DbfsTxn) -> bool:
    true

fn commit_outcome_matches_v1(wal_flushed: bool, initial_status: u8) -> (bool, bool):
    var txn = txn_for_commit_v1(wal_flushed, initial_status)
    val result = txn.commit()
    val expected_success = wal_flushed
    val success_matches = result.is_ok() == expected_success
    var state_matches = false
    if wal_flushed:
        state_matches = txn.status == TXN_STATUS_COMMITTED and crash_visible_v1(txn)
    else:
        state_matches = txn.status == initial_status and not crash_visible_v1(txn)
    (success_matches, state_matches)

pub struct SimpleOsDbfsCommitReceiptV1:
    symbol_id: text
    semantic_hash: text
    model_semantics_hash: text
    theorem_roots: [text]
    axiom_audit_hash: text
    cache_key_hash: text
    trust_manifest_hash: text
    proof_receipt_hash: text
    replay_closure_hash: text
    checked_case_count: i64
    counterexample_count: i64
    early_commit_mutant_counterexamples: i64
    status: FormalStatus
    diagnostic: text

impl SimpleOsDbfsCommitReceiptV1:
    fn permits_model_evidence(key: VerificationCacheKeyV1) -> bool:
        self.status == FormalStatus.ModelProven and self.diagnostic == "" and
            key.diagnostic() == "" and self.cache_key_hash == key.hash() and
            self.semantic_hash != "" and self.model_semantics_hash != "" and
            self.axiom_audit_hash != "" and self.trust_manifest_hash != "" and
            self.checked_case_count == DBFS_COMMIT_CASE_COUNT_V1 and
            self.counterexample_count == 0 and
            self.early_commit_mutant_counterexamples > 0

    pub fn permits_source_refinement(key: VerificationCacheKeyV1) -> bool:
        self.status == FormalStatus.SourceRefined and self.diagnostic == "" and
            key.diagnostic() == "" and self.cache_key_hash == key.hash() and
            self.semantic_hash != "" and self.model_semantics_hash != "" and
            self.axiom_audit_hash != "" and self.trust_manifest_hash != "" and
            self.proof_receipt_hash != "" and self.replay_closure_hash != "" and
            self.checked_case_count == DBFS_COMMIT_CASE_COUNT_V1 and
            self.counterexample_count == 0 and
            self.early_commit_mutant_counterexamples > 0

fn dbfs_commit_semantic_hash_v1() -> text:
    sha256_text("DbfsTxn.commit/bounded-v1|wal-flushed=false=>Err+state-frame+crash-invisible|wal-flushed=true=>Ok+committed+crash-visible|statuses=active,committed,aborted")

fn dbfs_commit_roots_v1() -> [text]:
    ["DbStorage.TxnCommitExact.commit_refinement_bundle"]

fn dbfs_commit_model_semantics_hash_v1() -> text:
    sha256_text("DbStorage.TxnCommitExact.commit/v2|unflushed=none+invisible|flushed=committed+visible|crash=atomic")

fn dbfs_commit_trust_v1() -> TrustManifestV1:
    TrustManifestV1(["propext"], [], [], [], [], [])

fn dbfs_commit_cache_key_v1() -> VerificationCacheKeyV1:
    val trust = dbfs_commit_trust_v1()
    VerificationCacheKeyV1(dbfs_commit_semantic_hash_v1(),
        dbfs_commit_model_semantics_hash_v1(),
        sha256_text("canonical-weave:none"), sha256_text("macro:none"),
        [sha256_text("lib.nogc_sync_mut.db.dbfs_engine.txn.DbfsTxn")],
        "simple-effects-v1:module-step-log+mutation", "source-refinement-validator-v1",
        "simple-source:dbfs-txn", "4.33.0", "", [],
        sha256_text("lean-commit-crash-case-split-v1"),
        sha256_text(trust.canonical_text()), "verified")

pub fn validate_simpleos_dbfs_commit_refinement_v1(
    axiom_report: text) -> SimpleOsDbfsCommitReceiptV1:
    val key = dbfs_commit_cache_key_v1()
    val trust_hash = sha256_text(dbfs_commit_trust_v1().canonical_text())
    val roots = dbfs_commit_roots_v1()
    val audit = audit_lean_axiom_report(axiom_report, roots, [])
    if not audit.permits_closed_verification():
        return SimpleOsDbfsCommitReceiptV1(
            "lib.nogc_sync_mut.db.dbfs_engine.txn.DbfsTxn.commit@bounded-crash-v1",
            dbfs_commit_semantic_hash_v1(), dbfs_commit_model_semantics_hash_v1(),
            roots, "", key.hash(), trust_hash, "", "", 0, 0, 0,
            FormalStatus.Failed,
            "FV2-E-SIMPLEOS-DBFS-AUDIT: exact commit/crash theorem audit is required")
    var checked = 0
    var counterexamples = 0
    var mutants = 0
    for wal_flushed in [false, true]:
        for status in [TXN_STATUS_ACTIVE, TXN_STATUS_COMMITTED, TXN_STATUS_ABORTED]:
            val outcome = commit_outcome_matches_v1(wal_flushed, status)
            if not outcome[0] or not outcome[1]: counterexamples = counterexamples + 1
            val original = txn_for_commit_v1(wal_flushed, status)
            if early_commit_mutant_visible_v1(original) != wal_flushed:
                mutants = mutants + 1
            checked = checked + 1
    val complete = checked == DBFS_COMMIT_CASE_COUNT_V1
    val good = complete and counterexamples == 0 and mutants > 0
    SimpleOsDbfsCommitReceiptV1(
        "lib.nogc_sync_mut.db.dbfs_engine.txn.DbfsTxn.commit@bounded-crash-v1",
        dbfs_commit_semantic_hash_v1(), dbfs_commit_model_semantics_hash_v1(),
        roots, sha256_text(axiom_report), key.hash(), trust_hash, "", "",
        checked, counterexamples, mutants,
        if good: FormalStatus.ModelProven else: FormalStatus.Failed,
        if good: "" else: "FV2-E-SIMPLEOS-DBFS-REFINEMENT: commit/crash matrix or mutation evidence failed")

pub fn promote_simpleos_dbfs_commit_refinement_v2(
    model: SimpleOsDbfsCommitReceiptV1,
    proof: ProofReceiptV1,
    replay: IndependentReplayClosureV1
) -> SimpleOsDbfsCommitReceiptV1:
    val key = dbfs_commit_cache_key_v1()
    if not model.permits_model_evidence(key):
        return dbfs_commit_promotion_failure_v2(model,
            "FV2-E-SIMPLEOS-DBFS-MODEL: closed model evidence is required")
    if model.theorem_roots.len() != 1 or proof.proof_root != model.theorem_roots[0] or
            proof.status != FormalStatus.ModelProven or proof.diagnostic() != "":
        return dbfs_commit_promotion_failure_v2(model,
            "FV2-E-SIMPLEOS-DBFS-PROOF: exact composite theorem receipt is required")
    if proof.trust_manifest_hash != model.trust_manifest_hash:
        return dbfs_commit_promotion_failure_v2(model,
            "FV2-E-SIMPLEOS-DBFS-TRUST: proof trust identity differs")
    if not proof.binds_independent_replay(replay):
        return dbfs_commit_promotion_failure_v2(model,
            "FV2-E-SIMPLEOS-DBFS-REPLAY: exact independent replay is required")
    if not proof.theorem_dependencies.contains(
            "fv2-simpleos-source-semantics:" + model.semantic_hash) or
            not proof.theorem_dependencies.contains(
                "fv2-simpleos-model-semantics:" + model.model_semantics_hash):
        return dbfs_commit_promotion_failure_v2(model,
            "FV2-E-SIMPLEOS-DBFS-DEPENDENCY: exact semantic identities are required")
    SimpleOsDbfsCommitReceiptV1(model.symbol_id, model.semantic_hash,
        model.model_semantics_hash, model.theorem_roots, proof.axiom_audit_hash,
        model.cache_key_hash, model.trust_manifest_hash, proof.hash(), replay.hash(),
        model.checked_case_count, model.counterexample_count,
        model.early_commit_mutant_counterexamples, FormalStatus.SourceRefined, "")

fn dbfs_commit_promotion_failure_v2(model: SimpleOsDbfsCommitReceiptV1,
    diagnostic: text) -> SimpleOsDbfsCommitReceiptV1:
    SimpleOsDbfsCommitReceiptV1(model.symbol_id, model.semantic_hash,
        model.model_semantics_hash, model.theorem_roots, model.axiom_audit_hash,
        model.cache_key_hash, model.trust_manifest_hash, "", "",
        model.checked_case_count, model.counterexample_count,
        model.early_commit_mutant_counterexamples, FormalStatus.Failed, diagnostic)
