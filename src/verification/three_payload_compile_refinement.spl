use compiler.common.cache_contract.physical_tld_v1.{
    TldPayloadRoleV1, PhysicalTldHeaderV1, PhysicalTldObjectV1,
    physical_tld_section_table_digest_v1}
use compiler.common.cache_contract.semantic_query_read_manifest_v1.{
    SemanticCoverageV1, SemanticQueryKeyV1, SemanticQueryReadV1,
    SemanticQueryReadManifestV1}
use compiler.common.cache_contract.three_payload_compile_v1.{
    ThreePayloadSemanticRefKindV1}
use compiler.common.cache_contract.three_payload_compile_v2.{
    ClosureCoverageRootV1, ThreePayloadFallbackV1}
use compiler.frontend.cache_artifact.physical_tld_codec_v1.{
    encode_physical_tld_v1}
use compiler.frontend.cache_artifact.three_payload_semantic_closure.{
    ThreePayloadSemanticBindBounds, bind_three_payload_semantic_inputs,
    resolve_three_payload_semantic_input}
use compiler.driver.cache.closure.three_payload_closure_packer_v2.{
    ThreePayloadSnapshotV2, ThreePayloadParentGenerationV2,
    ThreePayloadModuleClosureV2, ThreePayloadVerifiedObjectsV2,
    ThreePayloadPackBoundsV2, PreparedThreePayloadV2,
    seal_three_payload_closure_v2, verify_prepared_three_payload_v2}
use compiler.driver.cache.worker.three_payload_worker_io_v1.{
    ThreePayloadWorkerPolicyV1, three_payload_worker_confinement_available_v1}
use compiler.driver.cache.worker.three_payload_physical_file_broker_v1.{
    ThreePayloadPhysicalFileSetV1, read_three_payload_physical_files_v1}
use compiler.driver.cache.reference.reverse_reference_coordinator_v1.{
    ChangedSemanticFacetV1, seed_reverse_shards_v1, stage_reverse_delta_v1,
