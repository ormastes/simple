"""Windows native PTY composition behind the stable public capability.

Select src/providers/windows_native/lib before src/lib in a Windows native
product. Re-exports preserve actual Win64 resource ownership in the provider;
interpreter/Rust and other products retain their ordinary std.sys.pty facade.
"""

export use std.nogc_sync_mut.io.windows_pty_owner.{
    windows_pty_open_v1 as open,
    windows_pty_spawn_v1 as spawn,
    windows_pty_spawn_configured_v1 as spawn_configured_v1,
    windows_pty_write_v1 as write,
    windows_pty_write_some_bytes_v1 as write_some,
    windows_pty_input_pending_v1 as input_pending,
    windows_pty_read_v1 as read,
    windows_pty_close_v1 as close,
    windows_pty_is_running_v1 as is_running,
    windows_pty_resize_v1 as resize,
    windows_pty_cleanup_pending_v1 as cleanup_pending,
    windows_pty_exit_code_v1 as exit_code
}
export use std.sys.pty_launch.{PtyLaunchV1, PtyLaunchModeV1, PtyEnvironmentChangeV1}
use std.nogc_sync_mut.io.windows_pty_owner.{windows_pty_cleanup_proof_v1, windows_pty_write_some_bytes_v1}

# Installed exact-channel mechanism only: no child delivery or qualification claim.
pub fn literal_bytes_supported_v1() -> bool:
    true

pub fn write_literal_some_v1(handle: i32, data: [u8]) -> Result<i64, text>:
    val accepted = windows_pty_write_some_bytes_v1(handle, data)
    if accepted < 0: return Err("literal PTY write failed")
    return Ok(accepted)

# Once per configured owner startup; server admission retains the observation.
# One nonreused lifetime slot is consumed, never a child or parent env/cwd
# mutation. Failure ownership stays in the native registry/quarantine. No
# retries or global cache; capability requests must read the server's result.
# The selected linked provider's required launch APIs predate ConPTY's Windows
# 10 1809 prerequisite. Success is availability, not proof a later spawn works.
pub fn configured_launch_probe_v1() -> bool:
    val handle = open(1, 1)
    if handle < 0: return false
    val closed = close(handle)
    val released = windows_pty_cleanup_proof_v1(handle)
    closed and released

pub fn platform_default_shell() -> text: "cmd.exe"

# This reports provider capability. Each resize operation still validates its
# actual handle, dimensions, and ResizePseudoConsole result independently.
pub fn can_resize() -> bool: true
