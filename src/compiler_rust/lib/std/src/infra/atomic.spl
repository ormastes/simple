/**
Atomic Types

Atomic primitives for concurrent programming.

The C provider uses direct C11 atomics. The Rust compatibility provider uses a
mutex-protected handle map, so this module does not claim universal lock-free
progress. All providers currently execute operations as SeqCst.

Features:
- AtomicInt: Atomic integer operations
- AtomicBool: Atomic boolean flag
- AtomicRef: Atomic reference to object
- AtomicFlag: Simple atomic flag (spinlock building block)
- Memory ordering control for advanced use cases

```sdoctest
>>> val counter = AtomicInt.new(0)
>>> counter.fetch_add(1)
0
>>> counter.load()
1
```
*/

# Memory ordering for atomic operations
enum Ordering:
    Relaxed    # No synchronization
    Acquire    # Synchronize-with for reads
    Release    # Synchronize-with for writes
    AcqRel     # Both Acquire and Release
    SeqCst     # Sequentially consistent (strongest)

    # =========================================================================
    # Helper Methods
    # =========================================================================

    fn is_relaxed(self) -> bool:
        """Check if ordering is Relaxed (no synchronization)."""
        match self:
            case Relaxed: return true
            case _: return false

    fn is_acquire(self) -> bool:
        """Check if ordering is Acquire."""
        match self:
            case Acquire: return true
            case _: return false

    fn is_release(self) -> bool:
        """Check if ordering is Release."""
        match self:
            case Release: return true
            case _: return false

    fn is_acq_rel(self) -> bool:
        """Check if ordering is AcqRel."""
        match self:
            case AcqRel: return true
            case _: return false

    fn is_seq_cst(self) -> bool:
        """Check if ordering is SeqCst (strongest)."""
        match self:
            case SeqCst: return true
            case _: return false

    fn is_synchronizing(self) -> bool:
        """Check if ordering provides synchronization (not Relaxed)."""
        match self:
            case Relaxed: return false
            case _: return true

    fn to_string(self) -> text:
        """Convert ordering to string."""
        match self:
            case Relaxed: return "Relaxed"
            case Acquire: return "Acquire"
            case Release: return "Release"
            case AcqRel: return "AcqRel"
            case SeqCst: return "SeqCst"

    fn description(self) -> text:
        """Get ordering description.

        Returns:
            Human-readable description

        Example:
            Ordering.SeqCst.description()
            # → "Sequentially consistent (strongest)"
        """
        match self:
            case Relaxed: return "No synchronization"
            case Acquire: return "Synchronize-with for reads"
            case Release: return "Synchronize-with for writes"
            case AcqRel: return "Both Acquire and Release"
            case SeqCst: return "Sequentially consistent (strongest)"

    fn summary(self) -> text:
        """Get summary of ordering.

        Returns:
            Human-readable summary

        Example:
            Ordering.SeqCst.summary()
            # → "Ordering: SeqCst (Sequentially consistent (strongest), synchronizing)"
        """
        val name = self.to_string()
        val desc = self.description()
        val sync_label = if self.is_synchronizing(): "synchronizing" else: "no sync"
        return "Ordering: {name} ({desc}, {sync_label})"

# The provider currently uses SeqCst internally. Ordering stays a source-level
# compatibility parameter and is not transported across the raw ABI.
@unsafe(reason: "raw owned atomic-int handle allocation; non-positive means allocation failure", capabilities: [ffi])
extern fn rt_atomic_int_new(value: i64) -> i64
@unsafe(reason: "raw atomic-int handle load; invalid or stale handles fabricate zero", capabilities: [ffi])
extern fn rt_atomic_int_load(ptr: i64) -> i64
@unsafe(reason: "raw atomic-int handle store; invalid or stale handles discard the write", capabilities: [ffi])
extern fn rt_atomic_int_store(ptr: i64, value: i64)
@unsafe(reason: "raw atomic-int handle swap; invalid or stale handles fabricate zero", capabilities: [ffi])
extern fn rt_atomic_int_swap(ptr: i64, value: i64) -> i64
@unsafe(reason: "raw atomic-int compare-exchange; false includes mismatch or invalid handle", capabilities: [ffi])
extern fn rt_atomic_int_compare_exchange(ptr: i64, expected: i64, desired: i64) -> bool
@unsafe(reason: "raw atomic-int fetch-add; invalid or stale handles fabricate zero", capabilities: [ffi])
extern fn rt_atomic_int_fetch_add(ptr: i64, value: i64) -> i64
@unsafe(reason: "raw atomic-int fetch-sub; invalid or stale handles fabricate zero", capabilities: [ffi])
extern fn rt_atomic_int_fetch_sub(ptr: i64, value: i64) -> i64
@unsafe(reason: "raw atomic-int fetch-and; invalid or stale handles fabricate zero", capabilities: [ffi])
extern fn rt_atomic_int_fetch_and(ptr: i64, value: i64) -> i64
@unsafe(reason: "raw atomic-int fetch-or; invalid or stale handles fabricate zero", capabilities: [ffi])
extern fn rt_atomic_int_fetch_or(ptr: i64, value: i64) -> i64
@unsafe(reason: "raw atomic-int fetch-xor; invalid or stale handles fabricate zero", capabilities: [ffi])
extern fn rt_atomic_int_fetch_xor(ptr: i64, value: i64) -> i64
@unsafe(reason: "raw atomic-int handle release; caller must prevent stale or duplicate release", capabilities: [ffi])
extern fn rt_atomic_int_free(ptr: i64)

@unsafe(reason: "raw owned atomic-bool handle allocation; non-positive means allocation failure", capabilities: [ffi])
extern fn rt_atomic_bool_new(value: bool) -> i64
@unsafe(reason: "raw atomic-bool handle load; invalid or stale handles fabricate false", capabilities: [ffi])
extern fn rt_atomic_bool_load(ptr: i64) -> bool
@unsafe(reason: "raw atomic-bool handle store; invalid or stale handles discard the write", capabilities: [ffi])
extern fn rt_atomic_bool_store(ptr: i64, value: bool)
@unsafe(reason: "raw atomic-bool handle swap; invalid or stale handles fabricate false", capabilities: [ffi])
extern fn rt_atomic_bool_swap(ptr: i64, value: bool) -> bool
@unsafe(reason: "raw atomic-bool compare-exchange; false includes mismatch or invalid handle", capabilities: [ffi])
extern fn rt_atomic_bool_compare_exchange(ptr: i64, expected: bool, desired: bool) -> bool
@unsafe(reason: "raw atomic-bool handle release; caller must prevent stale or duplicate release", capabilities: [ffi])
extern fn rt_atomic_bool_free(ptr: i64)

@unsafe(reason: "raw owned atomic-flag handle allocation; non-positive means allocation failure", capabilities: [ffi])
extern fn rt_atomic_flag_new() -> i64
@unsafe(reason: "raw atomic-flag test-and-set; invalid or stale handles fabricate false", capabilities: [ffi])
extern fn rt_atomic_flag_test_and_set(ptr: i64) -> bool
@unsafe(reason: "raw atomic-flag load; invalid or stale handles fabricate false", capabilities: [ffi])
extern fn rt_atomic_flag_load(ptr: i64) -> bool
@unsafe(reason: "raw atomic-flag clear; invalid or stale handles discard the write", capabilities: [ffi])
extern fn rt_atomic_flag_clear(ptr: i64)
@unsafe(reason: "raw atomic-flag handle release; caller must prevent stale or duplicate release", capabilities: [ffi])
extern fn rt_atomic_flag_free(ptr: i64)

@unsafe(reason: "raw architecture spin hint provider; exact provider artifact is not admitted", capabilities: [ffi])
extern fn rt_spin_loop_hint()

/**
Atomic 64-bit integer.

Provides atomic integer operations through the selected runtime provider.
All operations are thread-safe.

```sdoctest
>>> val counter = AtomicInt.new(0)
>>> counter.fetch_add(5)
0
>>> counter.load()
5
>>> counter.compare_exchange(5, 10)
true
>>> counter.load()
10
```
*/
struct AtomicInt:
    _ptr: i64

    fn new(value: i64) -> AtomicInt:
        """Create a new atomic integer with initial value."""
        val ptr = unsafe(capabilities: [ffi]):
            rt_atomic_int_new(value)
        if ptr <= 0:
            panic("E-SFFI-ATOMIC-001: atomic integer allocation failed")
        return AtomicInt(_ptr: ptr)

    fn load(self, ordering: Ordering = Ordering.SeqCst) -> i64:
        """Load the current value."""
        unsafe(capabilities: [ffi]):
            rt_atomic_int_load(self._ptr)

    fn store(self, value: i64, ordering: Ordering = Ordering.SeqCst):
        """Store a new value."""
        unsafe(capabilities: [ffi]):
            rt_atomic_int_store(self._ptr, value)

    fn swap(self, value: i64, ordering: Ordering = Ordering.SeqCst) -> i64:
        """Swap the value, returning the old value."""
        unsafe(capabilities: [ffi]):
            rt_atomic_int_swap(self._ptr, value)

    fn compare_exchange(self, expected: i64,
        desired: i64,
        success_order: Ordering = Ordering.SeqCst,
        failure_order: Ordering = Ordering.SeqCst
    ) -> bool:
        """Compare and exchange.
        If current == expected, sets to desired and returns true.
        Otherwise returns false.
        """
        unsafe(capabilities: [ffi]):
            rt_atomic_int_compare_exchange(self._ptr, expected, desired)

    fn fetch_add(self, value: i64, ordering: Ordering = Ordering.SeqCst) -> i64:
        """Atomically add and return the previous value."""
        unsafe(capabilities: [ffi]):
            rt_atomic_int_fetch_add(self._ptr, value)

    fn fetch_sub(self, value: i64, ordering: Ordering = Ordering.SeqCst) -> i64:
        """Atomically subtract and return the previous value."""
        unsafe(capabilities: [ffi]):
            rt_atomic_int_fetch_sub(self._ptr, value)

    fn fetch_and(self, value: i64, ordering: Ordering = Ordering.SeqCst) -> i64:
        """Atomically AND and return the previous value."""
        unsafe(capabilities: [ffi]):
            rt_atomic_int_fetch_and(self._ptr, value)

    fn fetch_or(self, value: i64, ordering: Ordering = Ordering.SeqCst) -> i64:
        """Atomically OR and return the previous value."""
        unsafe(capabilities: [ffi]):
            rt_atomic_int_fetch_or(self._ptr, value)

    fn fetch_xor(self, value: i64, ordering: Ordering = Ordering.SeqCst) -> i64:
        """Atomically XOR and return the previous value."""
        unsafe(capabilities: [ffi]):
            rt_atomic_int_fetch_xor(self._ptr, value)

    fn increment(self, ordering: Ordering = Ordering.SeqCst) -> i64:
        """Increment and return the new value."""
        return self.fetch_add(1, ordering) + 1

    fn decrement(self, ordering: Ordering = Ordering.SeqCst) -> i64:
        """Decrement and return the new value."""
        return self.fetch_sub(1, ordering) - 1

    @unsafe(reason: "manual release invalidates copied aliases and permits stale-handle use", capabilities: [ffi])
    fn free(self):
        """Free the atomic."""
        unsafe(capabilities: [ffi]):
            rt_atomic_int_free(self._ptr)

    # =========================================================================
    # Helper Methods
    # =========================================================================

    fn is_zero(self, ordering: Ordering = Ordering.SeqCst) -> bool:
        """Check if value is zero."""
        return self.load(ordering) == 0

    fn is_positive(self, ordering: Ordering = Ordering.SeqCst) -> bool:
        """Check if value is positive."""
        return self.load(ordering) > 0

    fn is_negative(self, ordering: Ordering = Ordering.SeqCst) -> bool:
        """Check if value is negative."""
        return self.load(ordering) < 0

    fn summary(self) -> text:
        """Get summary of atomic integer.

        Returns:
            Human-readable summary

        Example:
            counter.summary()
            # → "AtomicInt: 42"
        """
        val value = self.load()
        return "AtomicInt: {value}"

/**
Atomic boolean.

Provides atomic boolean operations through the selected runtime provider.

```sdoctest
>>> val flag = AtomicBool.new(false)
>>> flag.load()
false
>>> flag.store(true)
>>> flag.swap(false)
true
```
*/
struct AtomicBool:
    _ptr: i64

    fn new(value: bool) -> AtomicBool:
        val ptr = unsafe(capabilities: [ffi]):
            rt_atomic_bool_new(value)
        if ptr <= 0:
            panic("E-SFFI-ATOMIC-001: atomic boolean allocation failed")
        return AtomicBool(_ptr: ptr)

    fn load(self, ordering: Ordering = Ordering.SeqCst) -> bool:
        unsafe(capabilities: [ffi]):
            rt_atomic_bool_load(self._ptr)

    fn store(self, value: bool, ordering: Ordering = Ordering.SeqCst):
        unsafe(capabilities: [ffi]):
            rt_atomic_bool_store(self._ptr, value)

    fn swap(self, value: bool, ordering: Ordering = Ordering.SeqCst) -> bool:
        unsafe(capabilities: [ffi]):
            rt_atomic_bool_swap(self._ptr, value)

    fn compare_and_swap(self, expected: bool, desired: bool, ordering: Ordering = Ordering.SeqCst) -> bool:
        """Compare and swap."""
        unsafe(capabilities: [ffi]):
            rt_atomic_bool_compare_exchange(self._ptr, expected, desired)

    @unsafe(reason: "manual release invalidates copied aliases and permits stale-handle use", capabilities: [ffi])
    fn free(self):
        unsafe(capabilities: [ffi]):
            rt_atomic_bool_free(self._ptr)

    # =========================================================================
    # Helper Methods
    # =========================================================================

    fn is_set(self, ordering: Ordering = Ordering.SeqCst) -> bool:
        """Check if flag is set (true)."""
        return self.load(ordering)

    fn is_clear(self, ordering: Ordering = Ordering.SeqCst) -> bool:
        """Check if flag is clear (false)."""
        return not self.load(ordering)

    fn summary(self) -> text:
        """Get summary of atomic boolean.

        Returns:
            Human-readable summary

        Example:
            flag.summary()
            # → "AtomicBool: true"
        """
        val value = self.load()
        return "AtomicBool: {value}"

/**
Atomic flag for spinlock implementation.

Simple atomic flag that can be atomically set and cleared.
Used as building block for spinlocks.

```sdoctest
>>> val flag = AtomicFlag.new()
>>> flag.test_and_set()  # Returns false (was clear)
false
>>> flag.test_and_set()  # Returns true (was set)
true
>>> flag.clear()
>>> flag.test_and_set()  # Returns false again
false
```
*/
struct AtomicFlag:
    _ptr: i64

    static fn new() -> AtomicFlag:
        val ptr = unsafe(capabilities: [ffi]):
            rt_atomic_flag_new()
        if ptr <= 0:
            panic("E-SFFI-ATOMIC-001: atomic flag allocation failed")
        return AtomicFlag(_ptr: ptr)

    fn test_and_set(self, ordering: Ordering = Ordering.Acquire) -> bool:
        """Atomically set the flag and return the previous state.
        Returns true if the flag was already set.
        """
        unsafe(capabilities: [ffi]):
            rt_atomic_flag_test_and_set(self._ptr)

    fn clear(self, ordering: Ordering = Ordering.Release):
        """Clear the flag."""
        unsafe(capabilities: [ffi]):
            rt_atomic_flag_clear(self._ptr)

    @unsafe(reason: "manual release invalidates copied aliases and permits stale-handle use", capabilities: [ffi])
    fn free(self):
        unsafe(capabilities: [ffi]):
            rt_atomic_flag_free(self._ptr)

    # =========================================================================
    # Helper Methods
    # =========================================================================

    fn is_set(self, ordering: Ordering = Ordering.Acquire) -> bool:
        """Check if flag is set.

        Returns:
            True if flag is set

        Example:
            flag.is_set()  # → false
        """
        unsafe(capabilities: [ffi]):
            rt_atomic_flag_load(self._ptr)

    fn is_clear(self, ordering: Ordering = Ordering.Acquire) -> bool:
        """Check if flag is clear.

        Returns:
            True if flag is clear

        Example:
            flag.is_clear()  # → true
        """
        unsafe(capabilities: [ffi]):
            not rt_atomic_flag_load(self._ptr)

    fn summary(self) -> text:
        """Get summary of atomic flag.

        Returns:
            Human-readable summary

        Example:
            flag.summary()
            # → "AtomicFlag: set" or "AtomicFlag: clear"
        """
        val set = unsafe(capabilities: [ffi]):
            rt_atomic_flag_load(self._ptr)
        val status = if set: "set" else: "clear"
        return "AtomicFlag: {status}"

/**
Atomic reference to an object.

Provides atomic load/store of object references.

```sdoctest
>>> val ref = AtomicRef.new(some_object)
>>> val obj = ref.load()
>>> ref.store(another_object)
```
*/
struct AtomicRef<T>:
    _atomic: AtomicInt

    @unsafe(reason: "casts an unverified object representation to a raw integer handle", capabilities: [ffi, raw_ptr])
    fn new(value: T) -> AtomicRef<T>:
        val ptr = value as i64
        return AtomicRef(_atomic: AtomicInt.new(ptr))

    @unsafe(reason: "casts a raw integer back to an object without provenance or lifetime proof", capabilities: [ffi, raw_ptr])
    fn load(self, ordering: Ordering = Ordering.Acquire) -> T:
        val ptr = self._atomic.load(ordering)
        return ptr as T

    @unsafe(reason: "stores an unverified object representation as a raw integer", capabilities: [ffi, raw_ptr])
    fn store(self, value: T, ordering: Ordering = Ordering.Release):
        val ptr = value as i64
        self._atomic.store(ptr, ordering)

    @unsafe(reason: "swaps and reconstructs raw object representations without provenance proof", capabilities: [ffi, raw_ptr])
    fn swap(self, value: T, ordering: Ordering = Ordering.AcqRel) -> T:
        val ptr = value as i64
        val old = self._atomic.swap(ptr, ordering)
        return old as T

    @unsafe(reason: "manual release invalidates copied aliases and permits stale-handle use", capabilities: [ffi])
    fn free(self):
        unsafe(capabilities: [ffi]):
            self._atomic.free()

    # =========================================================================
    # Helper Methods
    # =========================================================================

    @unsafe(reason: "inspects an unverified raw object representation", capabilities: [ffi, raw_ptr])
    fn is_null(self, ordering: Ordering = Ordering.Acquire) -> bool:
        """Check if reference is null (zero).

        Returns:
            True if reference is null

        Example:
            ref.is_null()  # → false
        """
        return self._atomic.load(ordering) == 0

    @unsafe(reason: "inspects an unverified raw object representation", capabilities: [ffi, raw_ptr])
    fn is_not_null(self, ordering: Ordering = Ordering.Acquire) -> bool:
        """Check if reference is not null.

        Returns:
            True if reference is not null

        Example:
            ref.is_not_null()  # → true
        """
        return self._atomic.load(ordering) != 0

    @unsafe(reason: "compares raw object representations without provenance or lifetime proof", capabilities: [ffi, raw_ptr])
    fn compare_and_swap(self, expected: T, desired: T, ordering: Ordering = Ordering.AcqRel) -> bool:
        """Compare and exchange reference.

        Args:
            expected: Expected current value
            desired: Desired new value
            ordering: Memory ordering

        Returns:
            True when the expected reference was replaced

        Example:
            val ok = ref.compare_and_swap(old_obj, new_obj)
        """
        val expected_ptr = expected as i64
        val desired_ptr = desired as i64
        self._atomic.compare_exchange(
            expected_ptr,
            desired_ptr,
            ordering,
            ordering
        )

    @unsafe(reason: "formats an unverified raw object representation", capabilities: [ffi, raw_ptr])
    fn summary(self) -> text:
        """Get summary of atomic reference.

        Returns:
            Human-readable summary

        Example:
            ref.summary()
            # → "AtomicRef: 0x7fff12345678"
        """
        val ptr = self._atomic.load()
        return "AtomicRef: 0x{ptr:x}"

/**
Spin loop hint.

Signals to the CPU that we're in a spin loop.
May reduce power consumption and improve performance.
*/
fn spin_loop_hint():
    unsafe(capabilities: [ffi]):
        rt_spin_loop_hint()

/**
Simple spinlock implementation using AtomicFlag.

```sdoctest
>>> val lock = Spinlock.new()
>>> lock.acquire()
>>> # critical section
>>> lock.release()
```
*/
struct Spinlock:
    _flag: AtomicFlag

    static fn new() -> Spinlock:
        return Spinlock(_flag: AtomicFlag.new())

    fn acquire(self):
        """Acquire the lock, spinning until available."""
        while self._flag.test_and_set(Ordering.Acquire):
            spin_loop_hint()

    fn try_acquire(self) -> bool:
        """Try to acquire the lock without blocking.
        Returns true if acquired.
        """
        return not self._flag.test_and_set(Ordering.Acquire)

    fn release(self):
        """Release the lock."""
        self._flag.clear(Ordering.Release)

    @unsafe(reason: "manual release invalidates copied aliases and permits stale-handle use", capabilities: [ffi])
    fn free(self):
        unsafe(capabilities: [ffi]):
            self._flag.free()

    # =========================================================================
    # Helper Methods
    # =========================================================================

    fn is_locked(self) -> bool:
        """Check if lock is currently held.

        Note: This is a best-effort check and may be stale immediately.
        """
        return not self.try_acquire() or (self.release(), false)[1]

    fn summary(self) -> text:
        """Get summary of spinlock.

        Returns:
            Human-readable summary

        Example:
            lock.summary()
            # → "Spinlock: unlocked" or "Spinlock: locked"
        """
        val status = if self.is_locked(): "locked" else: "unlocked"
        return "Spinlock: {status}"

/**
Atomic counter with convenience methods.

```sdoctest
>>> val counter = Counter.new()
>>> counter.inc()
>>> counter.inc()
>>> counter.get()
2
>>> counter.add(10)
>>> counter.get()
12
```
*/
struct Counter:
    _atomic: AtomicInt

    static fn new() -> Counter:
        return Counter(_atomic: AtomicInt.new(0))

    fn from(value: i64) -> Counter:
        return Counter(_atomic: AtomicInt.new(value))

    fn get(self) -> i64:
        return self._atomic.load()

    fn set(self, value: i64):
        self._atomic.store(value)

    fn inc(self) -> i64:
        return self._atomic.increment()

    fn dec(self) -> i64:
        return self._atomic.decrement()

    fn add(self, value: i64) -> i64:
        return self._atomic.fetch_add(value) + value

    fn sub(self, value: i64) -> i64:
        return self._atomic.fetch_sub(value) - value

    fn reset(self):
        self._atomic.store(0)

    @unsafe(reason: "manual release invalidates copied aliases and permits stale-handle use", capabilities: [ffi])
    fn free(self):
        unsafe(capabilities: [ffi]):
            self._atomic.free()

    # =========================================================================
    # Helper Methods
    # =========================================================================

    fn is_zero(self) -> bool:
        """Check if counter is zero."""
        return self.get() == 0

    fn is_positive(self) -> bool:
        """Check if counter is positive."""
        return self.get() > 0

    fn is_negative(self) -> bool:
        """Check if counter is negative."""
        return self.get() < 0

    fn summary(self) -> text:
        """Get summary of counter.

        Returns:
            Human-readable summary

        Example:
            counter.summary()
            # → "Counter: 42"
        """
        val value = self.get()
        return "Counter: {value}"
