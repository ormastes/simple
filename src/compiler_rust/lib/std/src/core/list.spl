# List<T> - Dynamic growable sequence
# Syntax: [] creates a List
# Implements all collection traits including Growable

use core.traits.*
use core.collections.*
use core.sorting.*

# ============================================
# List Type Definition
# ============================================

struct List<T>:
    data: [T]
    len: usize
    cap: usize

# ============================================
# Constructors
# ============================================

impl List<T>:
    # Create empty list
    static fn new() -> List<T>:
        List { data: [], len: 0, cap: 0 }

    # Create with pre-allocated capacity
    static fn with_capacity(cap: usize) -> List<T>:
        List { data: [], len: 0, cap: cap }

    # Create from variadic arguments
    static fn of(items: T...) -> List<T>:
        var list = List.with_capacity(items.len())
        for item in items:
            list.push(item)
        return list

    # Create filled with value
    static fn filled(value: T, count: usize) -> List<T> where T: Clone:
        var list = List.with_capacity(count)
        for _ in 0..count:
            list.push(value.clone())
        return list

    # Create filled with function
    static fn filled_with(f: fn(usize) -> T, count: usize) -> List<T>:
        var list = List.with_capacity(count)
        for i in 0..count:
            list.push(f(i))
        return list

    # Create from slice - Slice<T> parameter type now supported
    static fn from_slice(slice: Slice<T>) -> List<T> where T: Clone:
        var list = List.with_capacity(slice.len())
        for i in 0..slice.len():
            val item = slice.get(i).expect("valid")
            list.push(item)
        return list

# ============================================
# Internal helpers
# ============================================

impl List<T>:
    # Ensure capacity for at least `additional` more elements
    fn reserve(additional: usize):
        val required = self.len + additional
        if required <= self.cap:
            return

        # Grow by doubling or to required, whichever is larger
        var new_cap = if self.cap == 0: 4 else: self.cap * 2
        while new_cap < required:
            new_cap = new_cap * 2

        self.cap = new_cap

    fn shrink_to_fit():
        self.cap = self.len

    fn swap_unchecked(i: usize, j: usize):
        val tmp = self.data[i]
        self.data[i] = self.data[j]
        self.data[j] = tmp

    fn insertion_sort_range(left: usize, right: usize) where T: Ord:
        if right <= left + 1:
            return
        var i = left + 1
        while i < right:
            var j = i
            while j > left and self.data[j] < self.data[j - 1]:
                self.swap_unchecked(j, j - 1)
                j = j - 1
            i = i + 1

    fn sift_down_range(start: usize, end: usize) where T: Ord:
        var root = start
        while true:
            val left = 2 * root + 1
            if left >= end:
                break
            var largest = root
            if self.data[largest] < self.data[left]:
                largest = left
            val right = left + 1
            if right < end and self.data[largest] < self.data[right]:
                largest = right
            if largest == root:
                break
            self.swap_unchecked(root, largest)
            root = largest

    fn heapsort_in_place() where T: Ord:
        if self.len < 2:
            return
        var i = self.len / 2
        while i > 0:
            i = i - 1
            self.sift_down_range(i, self.len)
        var end = self.len
        while end > 1:
            end = end - 1
            self.swap_unchecked(0, end)
            self.sift_down_range(0, end)

    fn merge_range(left: usize, mid: usize, right: usize) where T: Ord:
        var tmp: [T] = []
        var i = left
        var j = mid
        while i < mid and j < right:
            if self.data[j] < self.data[i]:
                tmp.push(self.data[j])
                j = j + 1
            else:
                tmp.push(self.data[i])
                i = i + 1
        while i < mid:
            tmp.push(self.data[i])
            i = i + 1
        while j < right:
            tmp.push(self.data[j])
            j = j + 1
        for k in 0..tmp.len():
            self.data[left + k] = tmp[k]

    fn merge_sort_range(left: usize, right: usize) where T: Ord:
        if right <= left + 16:
            self.insertion_sort_range(left, right)
            return
        val mid = left + (right - left) / 2
        self.merge_sort_range(left, mid)
        self.merge_sort_range(mid, right)
        self.merge_range(left, mid, right)

    fn timsort_in_place() where T: Ord:
        if self.len < 2:
            return
        val min_run: usize = 32
        var i: usize = 0
        while i < self.len:
            val run_end = if i + min_run < self.len: i + min_run else: self.len
            self.insertion_sort_range(i, run_end)
            i = i + min_run
        var size = min_run
        while size < self.len:
            var left: usize = 0
            while left < self.len:
                val mid = if left + size < self.len: left + size else: self.len
                val right = if left + size * 2 < self.len: left + size * 2 else: self.len
                if mid < right:
                    self.merge_range(left, mid, right)
                left = left + size * 2
            size = size * 2

    fn pdqsort_range(left: usize, right: usize, depth_limit: usize) where T: Ord:
        if right <= left + 16:
            self.insertion_sort_range(left, right)
            return
        if depth_limit == 0:
            self.merge_sort_range(left, right)
            return
        val mid = left + (right - left) / 2
        val pivot = self.data[mid]
        var lt = left
        var eq = left
        var gt = right
        while eq < gt:
            if self.data[eq] < pivot:
                self.swap_unchecked(lt, eq)
                lt = lt + 1
                eq = eq + 1
            elif pivot < self.data[eq]:
                gt = gt - 1
                self.swap_unchecked(eq, gt)
            else:
                eq = eq + 1
        self.pdqsort_range(left, lt, depth_limit - 1)
        self.pdqsort_range(gt, right, depth_limit - 1)

# ============================================
# Capacity trait
# ============================================

impl Capacity for List<T>:
    fn capacity() -> usize:
        self.cap

    fn is_full() -> bool:
        false  # List can always grow

# ============================================
# Len trait
# ============================================

impl Len for List<T>:
    fn len() -> usize:
        self.len

# ============================================
# Iterable trait
# ============================================

impl Iterable<T> for List<T>:
    type Iter = ListIter<T>

    fn iter() -> Self.Iter:
        ListIter { list: self, index: 0 }

    fn into_iter() -> Self.Iter:
        ListIter { list: self, index: 0 }

    fn each(f: fn(T)):
        """Execute closure for each element.

        Args:
            f: Closure to execute with each element

        Example:
            list.each(|x| print(x))
        """
        for item in self.into_iter():
            f(item)

    fn each_with_index(f: fn(usize, T)):
        """Execute closure for each element with its index.

        Args:
            f: Closure to execute with index and element

        Example:
            list.each_with_index(|i, x| print("{i}: {x}"))
        """
        var idx: usize = 0
        for item in self.into_iter():
            f(idx, item)
            idx = idx + 1

# ============================================
# Collection trait - implemented via Sequence
# ============================================
# Note: List<T> implements Collection<T> automatically through
# its Sequence<T> implementation. No explicit impl needed.

# ============================================
# Sequence trait
# ============================================

impl Sequence<T> for List<T>:
    fn get(idx: usize) -> Option<T>:
        if idx < self.len:
            Some(self.data[idx])
        else:
            None

    fn get_slice(start: usize, end: usize) -> Slice<T>:
        if start > end or end > self.len:
            Slice.empty()
        else:
            Slice.from_array(self.data, start, end - start)

    fn first() -> Option<T>:
        self.get(0)

    fn last() -> Option<T>:
        if self.len > 0: self.get(self.len - 1) else: nil

    fn find(predicate: fn(&T) -> bool) -> Option<T>:
        for i in 0..self.len:
            val item = self.data[i]
            if predicate(&item): return Some(item)
        nil

    fn find_index(predicate: fn(&T) -> bool) -> Option<usize>:
        for idx in 0..self.len:
            val item = self.data[idx]
            if predicate(&item): return Some(idx)
        nil

    fn position(item: &T) -> Option<usize> where T: Eq:
        self.find_index(_1 == item)

    fn get_slice_from(start: usize) -> Slice<T>:
        self.get_slice(start, self.len)

    fn get_slice_to(end: usize) -> Slice<T>:
        self.get_slice(0, end)

    fn enumerate() -> Enumerate<Self.Iter>:
        self.into_iter().enumerate()

    fn all(predicate: fn(&T) -> bool) -> bool:
        for i in 0..self.len:
            val item = self.data[i]
            if not predicate(&item): return false
        true

    fn any(predicate: fn(&T) -> bool) -> bool:
        for i in 0..self.len:
            val item = self.data[i]
            if predicate(&item): return true
        false

    fn fold<U>(self, init: U, f: fn(U, T) -> U) -> U:
        var acc = init
        for i in 0..self.len:
            acc = f(acc, self.data[i])
        acc

    fn sum() -> T where T: Add<Output=T> + Default:
        self.fold(T.default(), \acc, x: acc + x)

    fn product() -> T where T: Mul<Output=T> + Default:
        self.fold(T.default(), \acc, x: acc * x)

    fn max() -> Option<T> where T: Ord:
        if self.len == 0: return nil
        var max_val = self.get(0).unwrap()
        for i in 1..self.len:
            val item = self.data[i]
            if item > max_val: max_val = item
        Some(max_val)

    fn min() -> Option<T> where T: Ord:
        if self.len == 0: return nil
        var min_val = self.get(0).unwrap()
        for i in 1..self.len:
            val item = self.data[i]
            if item < min_val: min_val = item
        Some(min_val)

    fn mean() -> f32 where T: Add + Default:
        0.0

    fn variance() -> f32 where T: Add + Default:
        0.0

    fn sample_variance() -> f32 where T: Add + Default:
        0.0

    fn std() -> f32 where T: Add + Default:
        0.0

    fn sample_std() -> f32 where T: Add + Default:
        0.0

    fn median() -> f32 where T: Ord + Clone:
        0.0

    fn quantile(p: f32) -> f32 where T: Ord + Clone:
        0.0

    fn range() -> f32 where T: Ord:
        0.0

    fn iqr() -> f32 where T: Ord + Clone:
        0.0

# ============================================
# MutSequence trait
# ============================================

impl MutSequence<T> for List<T>:
    fn get_mut(idx: usize) -> Option<&mut T>:
        if idx < self.len:
            Some(&mut self.data[idx])
        else:
            None

    fn set(idx: usize, value: T) -> Result<(), IndexError>:
        if idx >= self.len:
            return Err(IndexError.OutOfBounds(idx, self.len))
        self.data[idx] = value
        Ok(())

    fn swap(i: usize, j: usize) -> Result<(), IndexError>:
        if i >= self.len or j >= self.len:
            return Err(IndexError.OutOfBounds(if i >= self.len: i else: j, self.len))
        val temp = self.data[i]
        self.data[i] = self.data[j]
        self.data[j] = temp
        Ok(())

    fn fill(value: T) where T: Clone:
        for i in 0..self.len:
            self.data[i] = value

    fn fill_with(f: fn(usize) -> T):
        for i in 0..self.len:
            self.data[i] = f(i)

    fn reverse():
        if self.len < 2:
            return
        var i = 0
        var j = self.len - 1
        while i < j:
            val _ = self.swap(i, j)
            i = i + 1
            j = j - 1

    fn sort() where T: Ord:
        """Sort list using default algorithm (PDQSort)."""
        self.sort_with(SortAlgorithm.PDQSort)

    fn sort_with(algo: SortAlgorithm) where T: Ord:
        """Sort list using specified algorithm.

        Args:
            algo: Sorting algorithm to use

        Example:
            list.sort_with(SortAlgorithm.TimSort)
        """
        if self.len < 2:
            return
        match algo:
            case SortAlgorithm.InsertionSort:
                self.insertion_sort_range(0, self.len)
            case SortAlgorithm.HeapSort:
                self.heapsort_in_place()
            case SortAlgorithm.TimSort:
                self.timsort_in_place()
            case SortAlgorithm.PDQSort:
                var depth_limit: usize = 2
                var k = self.len
                while k > 1:
                    k = k / 2
                    depth_limit = depth_limit + 2
                self.pdqsort_range(0, self.len, depth_limit)

    fn retain(predicate: fn(&T) -> bool):
        var write: usize = 0
        for read in 0..self.len:
            val item = self.get(read).expect("valid")
            if predicate(&item):
                if write != read:
                    self.set(write, item).expect("valid")
                write = write + 1
        self.len = write

    fn as_mut_slice() -> MutSlice<T>:
        MutSlice.from_array(self.data, 0, self.len)

# ============================================
# ImmutSequence trait
# ============================================

impl ImmutSequence<T> for List<T> where T: Clone:
    type Output = List<T>

    fn with_index(idx: usize, value: T) -> Option<Self.Output>:
        if idx >= self.len:
            return None
        var new_list = self.clone()
        new_list.set(idx, value).expect("valid")
        Some(new_list)

    fn sorted() -> Self.Output where T: Ord:
        var new_list = self.clone()
        new_list.sort()
        new_list

    fn reversed() -> Self.Output:
        var new_list = self.clone()
        new_list.reverse()
        new_list

    fn filtered(predicate: fn(&T) -> bool) -> Self.Output:
        var new_list = List.new()
        for i in 0..self.len:
            val item = self.data[i]
            if predicate(&item):
                new_list.push(item)
        new_list

    fn mapped<U>(self, f: fn(T) -> U) -> List<U>:
        var new_list = List.with_capacity(self.len)
        for i in 0..self.len:
            new_list.push(f(self.data[i]))
        new_list

    fn appended(item: T) -> Self.Output:
        var new_list = self.clone()
        new_list.push(item)
        new_list

    fn prepended(item: T) -> Self.Output:
        var new_list = self.clone()
        new_list.push_front(item)
        new_list

    fn taken(n: usize) -> Self.Output:
        var new_list = List.new()
        val limit = if n < self.len: n else: self.len
        for i in 0..limit:
            new_list.push(self.data[i])
        new_list

    fn dropped(n: usize) -> Self.Output:
        var new_list = List.new()
        for i in n..self.len:
            new_list.push(self.data[i])
        new_list

    fn taken_while(predicate: fn(&T) -> bool) -> Self.Output:
        var new_list = List.new()
        for i in 0..self.len:
            val item = self.data[i]
            if not predicate(&item):
                break
            new_list.push(item)
        new_list

    fn dropped_while(predicate: fn(&T) -> bool) -> Self.Output:
        var new_list = List.new()
        var dropping = true
        for i in 0..self.len:
            val item = self.data[i]
            if dropping and predicate(&item):
                continue
            dropping = false
            new_list.push(item)
        new_list

# ============================================
# Growable trait
# ============================================

impl Growable<T> for List<T>:
    fn push(item: T):
        if self.len < self.data.len():
            self.data[self.len] = item
        else:
            self.data.push(item)
        self.len = self.len + 1
        if self.len > self.cap:
            self.cap = self.len

    fn pop() -> Option<T>:
        if self.len == 0:
            return None
        self.len = self.len - 1
        Some(self.data[self.len])

    fn push_front(item: T):
        if self.len >= self.data.len():
            self.data.push(item)
        # Shift all elements right
        if self.len > 0:
            var i = self.len
            while i > 0:
                self.data[i] = self.data[i - 1]
                i = i - 1
        self.data[0] = item
        self.len = self.len + 1
        if self.len > self.cap:
            self.cap = self.len

    fn pop_front() -> Option<T>:
        if self.len == 0:
            return None
        val item = self.data[0]
        # Shift all elements left
        for i in 0..(self.len - 1):
            self.data[i] = self.data[i + 1]
        self.len = self.len - 1
        Some(item)

    fn insert(idx: usize, item: T) -> Result<(), IndexError>:
        if idx > self.len:
            return Err(IndexError.OutOfBounds(idx, self.len))
        if self.len >= self.data.len():
            self.data.push(item)
        # Shift elements right from idx
        var i = self.len
        while i > idx:
            self.data[i] = self.data[i - 1]
            i = i - 1
        self.data[idx] = item
        self.len = self.len + 1
        if self.len > self.cap:
            self.cap = self.len
        Ok(())

    fn remove(idx: usize) -> Option<T>:
        if idx >= self.len:
            return None
        val item = self.data[idx]
        # Shift elements left
        for i in idx..(self.len - 1):
            self.data[i] = self.data[i + 1]
        self.len = self.len - 1
        Some(item)

    fn clear():
        # Drop all elements if T has Drop
        self.len = 0

    fn extend<I: IntoIterator<Item=T>>(self, iter: I):
        var it = iter.into_iter()
        loop:
            match it.next():
                case Some(item):
                    self.push(item)
                case None:
                    break

    fn append<C: Sequence<T>>(self, other: C) where T: Clone:
        var it = other.into_iter()
        loop:
            match it.next():
                case Some(item):
                    self.push(item)
                case None:
                    break

    fn truncate(len: usize):
        if len < self.len:
            self.len = len

    fn resize(new_len: usize, value: T) where T: Clone:
        if new_len > self.len:
            for _ in self.len..new_len:
                self.push(value)
        else:
            self.truncate(new_len)

# ============================================
# Sliceable trait
# ============================================

impl Sliceable<T> for List<T>:
    fn as_slice() -> Slice<T>:
        Slice.from_array(self.data, 0, self.len)

impl MutSliceable<T> for List<T>:
    fn as_mut_slice() -> MutSlice<T>:
        MutSlice.from_array(self.data, 0, self.len)

# ============================================
# Standard trait implementations
# ============================================

impl Clone for List<T> where T: Clone:
    fn clone() -> Self:
        var new_list = List.with_capacity(self.len)
        for i in 0..self.len:
            new_list.push(self.data[i])
        new_list

impl Default for List<T>:
    static fn default() -> Self:
        List.new()

impl Eq for List<T> where T: Eq:
    fn eq(other: &Self) -> bool:
        if self.len != other.len:
            return false
        for i in 0..self.len:
            val a = self.get(i).expect("valid")
            val b = other.get(i).expect("valid")
            if not a.eq(&b):
                return false
        true

impl Hash for List<T> where T: Hash:
    fn hash() -> u64:
        var h: u64 = 0
        for item in self.into_iter():
            h = h * 31 + item.hash()
        h

impl Display for List<T> where T: Display:
    fn fmt() -> text:
        var s = "["
        for (i, item) in self.enumerate():
            if i > 0:
                s = s + ", "
            s = s + item.fmt()
        s + "]"

impl Index<usize> for List<T>:
    type Output = T

    fn index(idx: usize) -> &Self.Output:
        if idx >= self.len:
            panic("index {idx} out of bounds (len={self.len})")
        &self.data[idx]

impl IndexMut<usize> for List<T>:
    fn index_mut(idx: usize) -> &mut Self.Output:
        if idx >= self.len:
            panic("index {idx} out of bounds (len={self.len})")
        &mut self.data[idx]

impl FromIterator<T> for List<T>:
    fn from_iter<I: Iterator<Item=T>>(iter: I) -> Self:
        var list = List.new()
        loop:
            match iter.next():
                case Some(item):
                    list.push(item)
                case None:
                    break
        list

impl IntoIterator for List<T>:
    type Item = T
    type IntoIter = ListIter<T>
    fn into_iter() -> Self.IntoIter:
        ListIter { list: self, index: 0 }

impl Drop for List<T>:
    fn drop():
        self.len = 0

# ============================================
# List Iterator
# ============================================

struct ListIter<T>:
    list: List<T>
    index: usize

impl Iterator for ListIter<T>:
    type Item = T

    fn next() -> Option<Self.Item>:
        if self.index < self.list.len:
            val item = self.list.get(self.index).expect("valid")
            self.index = self.index + 1
            Some(item)
        else:
            None

impl ExactSizeIterator for ListIter<T>:
    fn len() -> usize:
        self.list.len - self.index

impl DoubleEndedIterator for ListIter<T>:
    fn next_back() -> Option<Self.Item>:
        if self.index < self.list.len:
            val idx = self.list.len - 1
            val item = self.list.get(idx).expect("valid")
            # Shrink effective length (can't modify list, but we track via index math)
            Some(item)
        else:
            None

# ============================================
# Convenience methods (Ruby/Python inspired)
# ============================================

impl List<T>:
    # Ruby-style select (alias for filtered)
    fn select(predicate: fn(&T) -> bool) -> List<T> where T: Clone:
        self.filtered(predicate)

    # Ruby-style reject (opposite of filter)
    fn reject(predicate: fn(&T) -> bool) -> List<T> where T: Clone:
        self.filtered(|x| not predicate(x))

    fn partition(predicate: fn(&T) -> bool) -> (List<T>, List<T>) where T: Clone:
        var yes = List.new()
        var no = List.new()
        for i in 0..self.len:
            val item = self.data[i]
            if predicate(&item):
                yes.push(item)
            else:
                no.push(item)
        (yes, no)

    # Note: compact() is implemented in a separate impl block for List<Option<T>>
    # See the "Methods for Option Lists" section below

    # Ruby-style flatten (one level)
    fn flatten<U>(self) -> List<U> where T: Iterable<U>, U: Clone:
        var result = List.new()
        for i in 0..self.len:
            var it = self.data[i].into_iter()
            loop:
                match it.next():
                    case Some(item):
                        result.push(item)
                    case None:
                        break
        result

    # Python-style chunks
    fn chunks(size: usize) -> List<List<T>> where T: Clone:
        var result = List.new()
        var chunk = List.new()
        for i in 0..self.len:
            chunk.push(self.data[i])
            if chunk.len() == size:
                result.push(chunk)
                chunk = List.new()
        if not chunk.is_empty():
            result.push(chunk)
        result

    # Sliding windows
    fn windows(size: usize) -> List<List<T>> where T: Clone:
        if size == 0 or size > self.len:
            return List.new()
        var result = List.new()
        for i in 0..(self.len - size + 1):
            var window = List.new()
            for j in 0..size:
                window.push(self.get(i + j).expect("valid"))
            result.push(window)
        result

    # Dedup consecutive duplicates
    fn dedup() where T: Eq:
        if self.len < 2:
            return
        var write: usize = 1
        for read in 1..self.len:
            val curr = self.get(read).expect("valid")
            val prev = self.get(write - 1).expect("valid")
            if not curr.eq(&prev):
                if write != read:
                    self.set(write, curr).expect("valid")
                write = write + 1
        self.len = write

    # Join elements into string
    fn join(sep: text) -> text where T: Display:
        var s = text.new()
        for (i, item) in self.enumerate():
            if i > 0:
                s.push_str(sep)
            s.push_str(item.fmt())
        s

    # Map with index
    fn map_with_index<U>(self, f: fn(usize, T) -> U) -> List<U> where T: Clone:
        var result = List.with_capacity(self.len)
        for i in 0..self.len:
            result.push(f(i, self.data[i]))
        result

    # Ruby-style tap (execute function, return self)
    fn tap(f: fn(&List<T>)) -> List<T>:
        f(&self)
        self

    # Ruby-style then (transform self)
    fn then<U>(self, f: fn(List<T>) -> U) -> U:
        f(self)

# ============================================
# Methods for Option Lists
# ============================================

impl<T> List<Option<T>>:
    # Methods specifically for lists of optional values

    fn compact() -> List<T>:
        """Remove None values and unwrap Some values.

        Returns:
            New list containing only the unwrapped Some values

        Example:
            val items = [Some(1), None, Some(2), None, Some(3)]
            val compacted = items.compact()
            # Result: [1, 2, 3]
        """
        var result: List<T> = List.new()
        for i in 0..self.len:
            match self.data[i]:
                case Some(v):
                    result.push(v)
                case None:
                    pass  # Skip None values
        return result

# ============================================
# Type aliases
# ============================================

# Common list sizes (for documentation, lists are always dynamic)
type IntList = List<i64>
type FloatList = List<f64>
type StringList = List<text>
