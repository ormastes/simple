
# Property-Based Fuzzing for Simple
# Lightweight fuzzing library for testing Simple programs


use std.common.random_pure.{LcgRng, lcg_rng, lcg_advance, lcg_value}
use std.common.string_core.{char_from_code}
use std.io_runtime.{time_now_unix_micros}

# ============================================================================
# Generators - Produce random test inputs
# ============================================================================

# Each sample transfers the successor RNG explicitly: no captured mutable state.
struct FuzzSample<T>:
    value: T
    next_rng: LcgRng

# A typed callback carries the sample type without parameterized trait bounds.
struct FuzzGenerator<T>:
    sample: fn(LcgRng) -> FuzzSample<T>

    fn generate(rng: LcgRng) -> FuzzSample<T>:
        self.sample(rng)

# Integer generator
struct IntGen:
    min: i32
    max: i32

    fn generate(self, rng: LcgRng) -> FuzzSample<i32>:
        val next_rng = lcg_advance(rng)
        val width = (self.max as i64) - (self.min as i64) + 1
        val value = (self.min as i64) + (lcg_value(next_rng) % width)
        FuzzSample(value: value as i32, next_rng: next_rng)

# Text generator
struct TextGen:
    min_len: i32
    max_len: i32

    fn generate(self, rng: LcgRng) -> FuzzSample<text>:
        val length_rng = lcg_advance(rng)
        val width = (self.max_len as i64) - (self.min_len as i64) + 1
        val length = (self.min_len as i64) + (lcg_value(length_rng) % width)
        var current_rng = length_rng
        var result = ""
        for _ in 0..length:
            current_rng = lcg_advance(current_rng)
            val code = 32 + (lcg_value(current_rng) % 95)
            result = result + char_from_code(code)
        FuzzSample(value: result, next_rng: current_rng)

# Boolean generator
struct BoolGen:
    fn generate(rng: LcgRng) -> FuzzSample<bool>:
        val next_rng = lcg_advance(rng)
        FuzzSample(value: (lcg_value(next_rng) % 2) == 1, next_rng: next_rng)

# List generator
struct ListGen<T>:
    item_gen: FuzzGenerator<T>
    min_len: i32
    max_len: i32

    fn generate(self, rng: LcgRng) -> FuzzSample<[T]>:
        val length_rng = lcg_advance(rng)
        val width = (self.max_len as i64) - (self.min_len as i64) + 1
        val length = (self.min_len as i64) + (lcg_value(length_rng) % width)
        var current_rng = length_rng
        var result: [T] = []
        for _ in 0..length:
            val item = self.item_gen.generate(current_rng)
            result.append(item.value)
            current_rng = item.next_rng
        FuzzSample(value: result, next_rng: current_rng)

# Explicit adapters also keep directly constructed generator configurations usable.
impl IntGen:
    fn as_generator() -> FuzzGenerator<i32>:
        val config = self
        val sample = fn(rng: LcgRng) -> FuzzSample<i32>:
            config.generate(rng)
        FuzzGenerator(sample: sample)

impl TextGen:
    fn as_generator() -> FuzzGenerator<text>:
        val config = self
        val sample = fn(rng: LcgRng) -> FuzzSample<text>:
            config.generate(rng)
        FuzzGenerator(sample: sample)

impl BoolGen:
    fn as_generator() -> FuzzGenerator<bool>:
        val sample = fn(rng: LcgRng) -> FuzzSample<bool>:
            BoolGen.generate(rng)
        FuzzGenerator(sample: sample)

impl ListGen<T>:
    fn as_generator() -> FuzzGenerator<[T]>:
        val config = self
        val sample = fn(rng: LcgRng) -> FuzzSample<[T]>:
            config.generate(rng)
        FuzzGenerator(sample: sample)

# ============================================================================
# Fuzzing Results
# ============================================================================

enum FuzzResult:
    Pass(iterations: i32)
    Fail(input: text, error: text, iteration: i32)

# ============================================================================
# Main Fuzzing API
# ============================================================================

pub fn fuzz<T>(
    property: fn(T) -> bool,
    generator: FuzzGenerator<T>,
    iterations: i32
) -> FuzzResult:
    """
    Run property-based fuzzing.

    Args:
        property: Function that returns true if property holds
        gen: Generator for random inputs
        iterations: Number of test cases

    Returns:
        FuzzResult with pass/fail status

    Example:
        # Test that reverse(reverse(x)) == x
        fn prop_reverse(xs: List<i32>) -> bool:
            xs.reverse().reverse() == xs

        val gen = fuzz.list(fuzz.int(-100, 100), 0, 20)
        val result = fuzz.fuzz(prop_reverse, gen, 100)
    """
    fuzz_seeded(property, generator, iterations, time_now_unix_micros())

pub fn fuzz_seeded<T>(
    property: fn(T) -> bool,
    generator: FuzzGenerator<T>,
    iterations: i32,
    seed: i64
) -> FuzzResult:
    """Run repeatable fuzzing with an independent explicit-state seed."""
    var rng = lcg_rng(seed)
    for i in 0..iterations:
        val sample = generator.generate(rng)
        rng = sample.next_rng
        if not property(sample.value):
            return FuzzResult.Fail(
                input: "{sample.value}",
                error: "Property returned false",
                iteration: i + 1
            )
    FuzzResult.Pass(iterations: iterations)

# ============================================================================
# Convenience Constructors
# ============================================================================

pub fn int(min: i32, max: i32) -> FuzzGenerator<i32>:
    """Create integer generator.

    Example:
        val gen = fuzz.int(-100, 100)
    """
    IntGen(min: min, max: max).as_generator()

pub fn text(min_len: i32, max_len: i32) -> FuzzGenerator<text>:
    """Create text generator.

    Example:
        val gen = fuzz.text(0, 50)
    """
    TextGen(min_len: min_len, max_len: max_len).as_generator()

pub fn bool() -> FuzzGenerator<bool>:
    """Create boolean generator.

    Example:
        val gen = fuzz.bool()
    """
    BoolGen().as_generator()

pub fn list<T>(item_gen: FuzzGenerator<T>, min_len: i32, max_len: i32) -> FuzzGenerator<[T]>:
    """Create list generator.

    Example:
        val gen = fuzz.list(fuzz.int(0, 100), 5, 20)
    """
    ListGen(
        item_gen: item_gen,
        min_len: min_len,
        max_len: max_len
    ).as_generator()

# ============================================================================
# Result Helpers
# ============================================================================

impl FuzzResult:
    fn is_pass() -> bool:
        match self:
            Pass(_): true
            _: false

    fn is_fail() -> bool:
        not self.is_pass()

    fn unwrap():
        """Get number of iterations if Pass, panic if Fail."""
        match self:
            Pass(iters): iters
            Fail(input, error, iter):
                panic("Fuzz failed at iteration {iter}: {error}\nInput: {input}")

    fn summary() -> text:
        """Human-readable summary."""
        match self:
            Pass(iters):
                "✓ Passed {iters} iterations"
            Fail(input, error, iter):
                "✗ Failed at iteration {iter}\nError: {error}\nInput: {input}"

