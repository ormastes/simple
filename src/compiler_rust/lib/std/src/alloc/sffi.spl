# Alloc SFFI - Low-level memory allocation primitives
#
# Runtime functions for heap memory management.
# These are the foundation for all collection types.

# --- Memory allocation ---
@unsafe(reason: "raw heap allocation ABI; zero means allocation failure", capabilities: [ffi])
extern fn rt_alloc(size: i64) -> i64
@unsafe(reason: "raw owned heap reallocation ABI; zero means failure and old pointer remains owned", capabilities: [ffi])
extern fn rt_realloc(ptr: i64, old_size: i64, new_size: i64) -> i64
@unsafe(reason: "raw owned heap pointer release ABI", capabilities: [ffi])
extern fn rt_free(ptr: i64)
@unsafe(reason: "raw zeroed heap allocation ABI; zero means allocation failure", capabilities: [ffi])
extern fn rt_alloc_zeroed(size: i64) -> i64

# --- Array operations ---
@unsafe(reason: "raw owned runtime-array handle ABI; zero means allocation failure", capabilities: [ffi])
extern fn rt_array_new(capacity: i64) -> i64
@unsafe(reason: "raw runtime-array handle mutation ABI", capabilities: [ffi])
extern fn rt_array_push(arr: i64, value: i64)
@unsafe(reason: "raw runtime-array handle pop ABI; sentinel contract is untyped", capabilities: [ffi])
extern fn rt_array_pop(arr: i64) -> i64
@unsafe(reason: "raw runtime-array handle/index ABI; sentinel contract is untyped", capabilities: [ffi])
extern fn rt_array_get(arr: i64, index: i64) -> i64
@unsafe(reason: "raw runtime-array handle/index mutation ABI", capabilities: [ffi])
extern fn rt_array_set(arr: i64, index: i64, value: i64)
@unsafe(reason: "raw runtime-array handle length ABI", capabilities: [ffi])
extern fn rt_array_len(arr: i64) -> i64
@unsafe(reason: "raw runtime-array handle capacity ABI", capabilities: [ffi])
extern fn rt_array_capacity(arr: i64) -> i64
@unsafe(reason: "raw runtime-array handle mutation ABI", capabilities: [ffi])
extern fn rt_array_clear(arr: i64)
@unsafe(reason: "raw runtime-array slice and owned-result handle ABI", capabilities: [ffi])
extern fn rt_array_slice(arr: i64, start: i64, end: i64) -> i64
@unsafe(reason: "raw runtime-array concatenation and owned-result handle ABI", capabilities: [ffi])
extern fn rt_array_concat(a: i64, b: i64) -> i64
@unsafe(reason: "raw runtime-array in-place sort ABI", capabilities: [ffi])
extern fn rt_array_sort(arr: i64)
@unsafe(reason: "raw runtime-array in-place reverse ABI", capabilities: [ffi])
extern fn rt_array_reverse(arr: i64)

# --- Dict/Map operations ---
@unsafe(reason: "raw owned runtime-dictionary handle ABI; zero means allocation failure", capabilities: [ffi])
extern fn rt_dict_new() -> i64
@unsafe(reason: "raw runtime-dictionary handle/text-key lookup ABI; absence sentinel is untyped", capabilities: [ffi])
extern fn rt_dict_get(dict: i64, key: text) -> i64
@unsafe(reason: "raw runtime-dictionary handle/text-key mutation ABI", capabilities: [ffi])
extern fn rt_dict_set(dict: i64, key: text, value: i64)
@unsafe(reason: "raw runtime-dictionary handle/text-key removal ABI", capabilities: [ffi])
extern fn rt_dict_remove(dict: i64, key: text)
@unsafe(reason: "raw runtime-dictionary handle and dynamic-key ABI", capabilities: [ffi])
extern fn rt_dict_contains(dict: i64, key: Any) -> bool
@unsafe(reason: "raw runtime-dictionary handle length ABI", capabilities: [ffi])
extern fn rt_dict_len(dict: i64) -> i64
@unsafe(reason: "raw runtime-dictionary keys and owned-array handle ABI", capabilities: [ffi])
extern fn rt_dict_keys(dict: i64) -> i64
@unsafe(reason: "raw runtime-dictionary values and owned-array handle ABI", capabilities: [ffi])
extern fn rt_dict_values(dict: i64) -> i64
@unsafe(reason: "raw runtime-dictionary handle mutation ABI", capabilities: [ffi])
extern fn rt_dict_clear(dict: i64)

# --- String operations ---
@unsafe(reason: "raw runtime-owned text allocation ABI", capabilities: [ffi])
extern fn rt_string_new(capacity: i64) -> text
@unsafe(reason: "raw runtime-owned text concatenation ABI", capabilities: [ffi])
extern fn rt_string_concat(a: text, b: text) -> text
@unsafe(reason: "raw runtime text length ABI", capabilities: [ffi])
extern fn rt_string_len(s: text) -> i64
@unsafe(reason: "raw runtime-owned text slice ABI", capabilities: [ffi])
extern fn rt_string_slice(s: text, start: i64, end: i64) -> text
@unsafe(reason: "raw runtime text search ABI", capabilities: [ffi])
extern fn rt_string_contains(s: text, substr: text) -> bool
@unsafe(reason: "raw runtime-owned text replacement ABI", capabilities: [ffi])
extern fn rt_string_replace(s: text, from: text, to: text) -> text
@unsafe(reason: "raw runtime text split and owned-array handle ABI", capabilities: [ffi])
extern fn rt_string_split(s: text, sep: text) -> i64
@unsafe(reason: "raw runtime-owned text trim ABI", capabilities: [ffi])
extern fn rt_string_trim(s: text) -> text
@unsafe(reason: "raw runtime-owned uppercase text ABI", capabilities: [ffi])
extern fn rt_string_to_upper(s: text) -> text
@unsafe(reason: "raw runtime-owned lowercase text ABI", capabilities: [ffi])
extern fn rt_string_to_lower(s: text) -> text
@unsafe(reason: "raw runtime text prefix-query ABI", capabilities: [ffi])
extern fn rt_string_starts_with(s: text, prefix: text) -> bool
@unsafe(reason: "raw runtime text suffix-query ABI", capabilities: [ffi])
extern fn rt_string_ends_with(s: text, suffix: text) -> bool
