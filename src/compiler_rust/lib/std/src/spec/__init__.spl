# BDD Spec Framework - Default (Fast Loading)
# Balanced version: Essential features without heavy advanced modules.
# Advanced mocking, diagrams, gherkin, and architecture APIs live in
# std.spec.adv and are intentionally not re-exported here.

mod spec

# Core DSL
export describe from dsl
export context from dsl
export it from dsl
export pending from dsl
export pending_it from dsl
export slow_it from dsl
export ignore_it from dsl

# Hooks
export before_each from dsl
export after_each from dsl
export before_all from dsl
export after_all from dsl

# Shared examples and memoized context
export shared_examples from dsl
export it_behaves_like from dsl
export include_examples from dsl
export let_lazy from dsl
export get_let from dsl
export has_let from dsl
export given from dsl
export given_lazy from dsl

# Expectations
export expect from expect
export expect_not from expect
export expect_raises from expect

# Core matchers
export eq from matchers.core
export be from matchers.core
export be_nil from matchers.core
export be_true from matchers.boolean
export be_false from matchers.boolean
export be_truthy from matchers.boolean
export be_falsy from matchers.boolean
export gt from matchers.comparison
export lt from matchers.comparison
export gte from matchers.comparison
export lte from matchers.comparison
export include from matchers.collection
export be_empty from matchers.collection
export have_length from matchers.collection
export have_size from matchers.collection
export include_string from matchers.string
export start_with from matchers.string
export end_with from matchers.string
export raise_error from matchers.error
export be_instance_of from matchers.type
export be_a from matchers.type
export be_an from matchers.type

# Runner and configuration
export run_specs from runner.cli
export tag_default from runtime
export timeout_default from runtime

# Tag constants for test filtering
export TAG_UNIT from runner.filter
export TAG_INTEGRATION from runner.filter
export TAG_SYSTEM from runner.filter
export TAG_SLOW from runner.filter
export TAG_FOCUS from runner.filter
export TAG_WIP from runner.filter
export TAG_SKIP from runner.filter
