# Multi-Mode Test Execution (#2050-#2054)
# Executes tests across multiple execution modes with reporting

use execution_mode.{ExecutionMode, ModeSet, mode_to_string, is_mode_available}
use mode_config.{ModeConfig, FailureStrategy}

# SFFI for runtime timing. `rt_current_time_ms` IS registered
# (interpreter_extern/mod.rs), unlike the two externs that used to sit here.
extern fn rt_current_time_ms() -> i64

# There are deliberately NO `runtime_set_jit_enabled` / `runtime_set_backend`
# externs any more. Both were declared here with live callers below and
# registered in NO runtime. An unregistered extern only fails loudly on the
# interpreter and the native/AOT lanes; on the default JIT lane it logs an
# internal error, returns nil, keeps going and exits 0 -- so every call was a
# silent no-op.
#
# They are not missing registrations. There is nothing correct to register them
# TO: the execution engine is chosen ONCE per process, before any user code
# runs.
#
#   * `SIMPLE_EXECUTION_MODE=interpreter|jit` is read at process start.
#   * `simple test` ignores that variable entirely --
#     `run_file_with_interpreter_mode` (driver/src/main.rs) saves it,
#     unconditionally forces `interpret` for the whole run, then restores it.
#   * `describe`/`it`/`expect` have no codegen lowering, so an in-process spec
#     body cannot reach the JIT even inside a JIT process.
#
# Flipping a flag from inside a running program cannot change the engine that
# is already executing that program. Multi-mode coverage requires ONE PROCESS
# PER MODE. Anything else reports modes it did not run, which is strictly worse
# than refusing -- so the helpers below now refuse.

## Test Result
# Result of running a single test in a specific mode
struct TestResult:
    test_name: text
    mode: ExecutionMode
    status: TestStatus
    error: Option<text>
    duration_ms: i64
    config_source: text  # Which level set the mode configuration

enum TestStatus:
    Passed
    Failed
    Skipped

## Mode Execution Result
# Aggregates results across all modes for a single test
struct ModeExecutionResult:
    test_name: text
    results: List<TestResult>
    total_modes: i32
    passed_modes: i32
    failed_modes: i32
    skipped_modes: i32

impl ModeExecutionResult:
    static fn new(test_name: text) -> ModeExecutionResult:
        ModeExecutionResult(
            test_name: test_name,
            results: [],
            total_modes: 0,
            passed_modes: 0,
            failed_modes: 0,
            skipped_modes: 0
        )

    # Add a test result
    me add_result(result: TestResult) -> ModeExecutionResult:
        self.results.push(result)
        self.total_modes = self.total_modes + 1

        match result.status:
            case TestStatus.Passed: self.passed_modes = self.passed_modes + 1
            case TestStatus.Failed: self.failed_modes = self.failed_modes + 1
            case TestStatus.Skipped: self.skipped_modes = self.skipped_modes + 1

        self

    # Check if all modes passed
    fn all_passed() -> bool:
        self.failed_modes == 0 and self.skipped_modes == 0

    # Check if any mode failed
    fn has_failures() -> bool:
        self.failed_modes > 0

## Mode Runner
# Executes tests in multiple modes
struct ModeRunner:
    config: ModeConfig
    results: List<ModeExecutionResult>

impl ModeRunner:
    static fn new(config: ModeConfig) -> ModeRunner:
        ModeRunner(
            config: config,
            results: []
        )

    # Set execution mode for the runtime
    fn set_execution_mode(mode: ExecutionMode):
        """Refuse any in-process engine switch that cannot actually happen.

        This used to call `runtime_set_jit_enabled` / `runtime_set_backend`,
        neither of which was registered in any runtime, so on the default JIT
        lane every call was a silent no-op and the runner then reported a mode
        it had not run. See the header comment: the engine is a per-process
        choice and `simple test` forces the interpreter for the whole run.

        Interpreter is the only mode this process can honestly claim, because
        it is the mode `simple test` pins. Every other mode aborts loudly.
        """
        match mode:
            case ExecutionMode.Interpreter:
                # `simple test` already forced `interpret` for the whole run.
                pass
            case _:
                panic("cannot switch execution mode to {mode_to_string(mode)} from inside a running process: the engine is fixed at process start and `simple test` pins the interpreter. Run one process per mode with SIMPLE_EXECUTION_MODE instead.")

    # Run a test function in all configured modes
    me run_test(test_name: text, test_fn: fn() -> ()) -> ModeExecutionResult:
        val modes = self.config.resolve_modes()
        val strategy = self.config.resolve_failure_strategy()

        var exec_result = ModeExecutionResult.new(test_name)

        for mode in modes.to_list():
            # Skip unavailable modes
            if not is_mode_available(mode):
                val result = TestResult(
                    test_name: test_name,
                    mode: mode,
                    status: TestStatus.Skipped,
                    error: Some("Mode not implemented"),
                    duration_ms: 0,
                    config_source: "availability_check"
                )
                exec_result = exec_result.add_result(result)
                continue

            # Execute test in this mode
            val result = self.execute_in_mode(test_name, test_fn, mode)
            exec_result = exec_result.add_result(result)

            # Handle failure based on strategy
            if result.status == TestStatus.Failed:
                match strategy:
                    case FailureStrategy.FailAll:
                        # Stop execution, mark remaining modes as skipped
                        exec_result = self.skip_remaining_modes(exec_result, modes, mode)
                        break
                    case FailureStrategy.SkipRemaining:
                        # Continue with next mode
                        pass
                    case FailureStrategy.CollectAll:
                        # Continue running all modes
                        pass

        self.results.push(exec_result)
        exec_result

    # Execute test in a specific mode
    fn execute_in_mode(test_name: text, test_fn: fn() -> (), mode: ExecutionMode) -> TestResult:
        val start_time = rt_current_time_ms()

        # Try to execute the test
        var status = TestStatus.Passed
        var error = None

        # Execute test in specified mode
        # Mode switching is handled by setting execution context before running
        self.set_execution_mode(mode)

        match self.try_execute(test_fn):
            case Ok(_):
                status = TestStatus.Passed
            case Err(err):
                status = TestStatus.Failed
                error = Some(err)

        val duration = rt_current_time_ms() - start_time

        TestResult(
            test_name: test_name,
            mode: mode,
            status: status,
            error: error,
            duration_ms: duration,
            config_source: self.config.get_effective_source()
        )

    # Try to execute a test function, catching errors
    fn try_execute(test_fn: fn() -> ()) -> Result<(), text>:
        """Execute test function with error catching.

        Uses Result-based error handling (Simple does not have try/catch).
        """
        test_fn()
        return Ok(())

    # Skip remaining modes after a failure
    fn skip_remaining_modes(mut exec_result: ModeExecutionResult, modes: ModeSet, failed_mode: ExecutionMode) -> ModeExecutionResult:
        var found_failed = false

        for mode in modes.to_list():
            if mode == failed_mode:
                found_failed = true
                continue

            if found_failed:
                val result = TestResult(
                    test_name: exec_result.test_name,
                    mode: mode,
                    status: TestStatus.Skipped,
                    error: Some("Skipped due to failure in {mode_to_string(failed_mode)}"),
                    duration_ms: 0,
                    config_source: "failure_strategy"
                )
                exec_result = exec_result.add_result(result)

        exec_result

    # Get all test results
    fn get_results() -> List<ModeExecutionResult>:
        self.results

## Helper: run_in_modes
# Execute a block of code/tests in specific modes
# Usage: run_in_modes([ExecutionMode.JIT, ExecutionMode.SMF_Cranelift]):
#            it "test": ...
## Module-level mode configuration
var _current_modes: ModeSet = ModeSet.all()

fn run_in_modes(modes: ModeSet, block: fn() -> ()) -> ():
    """Run `block` once per mode in `modes` -- or refuse if it cannot.

    It cannot. This helper NEVER switched the execution engine, on any run,
    ever. Two independent reasons, both measured:

      1. Its body only assigned the module-level `_current_modes` and called
         `block()` exactly ONCE. It never reached `ModeRunner.set_execution_mode`,
         so it never even attempted the (unregistered) mode-switch externs.
      2. Even had it reached them, the engine is fixed at process start -- see
         the header comment at the top of this file.

    So a caller that asked for three modes got ONE run of one engine and a
    report naming three. That is the exact shape of a helper that manufactures
    unearned multi-engine evidence, so it now aborts instead. Run one process
    per mode with SIMPLE_EXECUTION_MODE, or drive `ModeRunner` per process.

    `_current_modes` / `get_current_modes()` remain the honest part: they
    record what was REQUESTED, not what ran.
    """
    val mode_count = modes.to_list().len()
    panic("run_in_modes cannot switch execution mode in-process (requested {mode_count} mode(s)): the engine is fixed at process start and `simple test` pins the interpreter. It would run ONE engine and report {mode_count}. Run one process per mode with SIMPLE_EXECUTION_MODE instead.")

## Get current mode configuration
fn get_current_modes() -> ModeSet:
    _current_modes

## Result: type alias for error handling
# Temporary definition until core Result type is available
enum Result<T, E>:
    Ok(T)
    Err(E)
