# Sys SFFI: I/O - File and directory operations
#
# Runtime functions for filesystem access.
# Not available on baremetal targets.

# --- File operations ---
extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_file_append_text(path: text, content: text) -> bool
extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_delete(path: text) -> bool
extern fn rt_file_copy(src: text, dst: text) -> bool
extern fn rt_file_move(src: text, dst: text) -> bool
extern fn rt_file_size(path: text) -> i64
# `rt_file_read_bytes` deliberately NOT declared here. The C runtime
# (`src/runtime/runtime_native.c:9071`) returns a tagged pointer to a
# BYTE array built by `rt_byte_array_new_len`, i.e. `[u8]`, or 0 on
# failure. The former `-> i64` declaration in this file exposed the raw
# tagged handle and had zero callers in-file and zero importers of this
# module, so it could only ever poison an unrelated module's import
# closure with a sixth, wrong return type. Declare `-> [u8]` locally if
# this module ever needs it. See
# doc/08_tracking/bug/rt_file_read_bytes_declared_with_six_return_types_2026-08-09.md
extern fn rt_file_write_bytes(path: text, data: i64, len: i64) -> bool

# --- Directory operations ---
extern fn rt_dir_create(path: text) -> bool
extern fn rt_dir_create_all(path: text) -> bool
extern fn rt_dir_exists(path: text) -> bool
extern fn rt_dir_delete(path: text) -> bool
extern fn rt_dir_list(path: text) -> i64

# --- Path operations ---
extern fn rt_path_join(base: text, part: text) -> text
extern fn rt_path_parent(path: text) -> text
extern fn rt_path_filename(path: text) -> text
extern fn rt_path_extension(path: text) -> text
extern fn rt_path_absolute(path: text) -> text
extern fn rt_path_normalize(path: text) -> text
