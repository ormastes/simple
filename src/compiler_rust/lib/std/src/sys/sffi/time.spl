# Sys SFFI: Time - Time measurement
#
# Runtime functions for time operations.

@unsafe(reason: "raw nanosecond clock ABI; negative sentinel is provider failure", capabilities: [ffi])
extern fn rt_time_now_nanos() -> i64
@unsafe(reason: "legacy raw millisecond clock has no owned provider admission", capabilities: [ffi])
extern fn rt_time_now_millis() -> i64
@unsafe(reason: "legacy raw integer seconds C ABI; provider admission is required", capabilities: [ffi])
extern fn rt_time_now_seconds() -> i64
@unsafe(reason: "legacy raw sleep provider has no owned provider admission", capabilities: [ffi])
extern fn rt_time_sleep_millis(ms: i64)
