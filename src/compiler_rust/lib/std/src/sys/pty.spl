# PTY (pseudo-terminal) capability.
# Raw runtime operations are private to this module. Applications use the
# typed functions below so POSIX PTYs and Windows ConPTY remain provider
# details. This module is the common cross-platform wrapper: consumers code
# against this surface only, never against OS-specific PTY APIs. The
# source-tree wrapper (src/lib/sys/pty.spl) presents the same common contract.
extern fn rt_pty_open(rows: i32, cols: i32) -> i32
extern fn rt_pty_spawn(handle: i32, program: text) -> i64
extern fn rt_pty_write(handle: i64, data: text) -> bool
extern fn rt_pty_read(handle: i64, timeout_ms: i64) -> text
extern fn rt_pty_close(handle: i64) -> bool
extern fn rt_pty_is_running(handle: i64) -> bool
extern fn rt_pty_resize(handle: i64, rows: i32, cols: i32) -> bool
extern fn rt_platform_name() -> text?

pub fn open(rows: i32, cols: i32) -> i32:
    if rows <= 0 or cols <= 0:
        return -1
    rt_pty_open(rows, cols)

pub fn spawn(handle: i32, program: text) -> i64:
    if handle < 0 or program == "":
        return -1
    rt_pty_spawn(handle, program)

pub fn write(handle: i32, data: text) -> bool:
    if handle < 0:
        return false
    rt_pty_write(handle as i64, data)

pub fn read(handle: i32, timeout_ms: i32) -> text:
    if handle < 0 or timeout_ms < 0:
        return ""
    rt_pty_read(handle as i64, timeout_ms as i64)

pub fn close(handle: i32) -> bool:
    if handle < 0:
        return false
    rt_pty_close(handle as i64)

pub fn is_running(handle: i32) -> bool:
    if handle < 0:
        return false
    rt_pty_is_running(handle as i64)

var _resize_proven = false
var _resize_refused = false

# Positive probe, not a platform guess: resize one real scratch PTY once per
# process. A runtime without rt_pty_resize answers false here.
pub fn can_resize() -> bool:
    if _resize_proven:
        return true
    if _resize_refused:
        return false
    val handle = open(2, 2)
    if handle < 0:
        return false
    val resized = resize(handle, 3, 4)
    val _closed = close(handle)
    if resized:
        _resize_proven = true
    else:
        _resize_refused = true
    resized

pub fn resize(handle: i32, rows: i32, cols: i32) -> bool:
    if handle < 0 or rows <= 0 or cols <= 0:
        return false
    rt_pty_resize(handle as i64, rows, cols)

# The legacy close ABI reclaims synchronously; it owns no deferred buffers.
pub fn cleanup_pending() -> i64:
    0

# The legacy runtime ABI cannot report a child's exit status.
pub fn exit_code(handle: i32) -> Result<i64, text>:
    Err("PTY exit status unavailable in this runtime composition")

pub fn platform_default_shell() -> text:
    val platform = rt_platform_name() ?? "unknown"
    if platform.lower().contains("windows"):
        return "cmd.exe"
    "/bin/sh"
