# std.plugin - runtime plugin loader.
#
# Two-step contract:
#   1. use_plugin(name) - resolve manifest entry, dlopen the .so, cache handle.
#   2. plugin_call_i64(symbol, args) - by-name dispatch via cached handles.

use app.plugin.registry.{PluginEntry, plugin_manifest_path, parse_plugin_manifest_text}

@unsafe(reason: "raw file predicate; false conflates absence with provider failure", capabilities: [ffi])
extern fn rt_file_exists(path: text) -> bool
@unsafe(reason: "raw manifest read; empty text conflates empty data with provider failure", capabilities: [ffi])
extern fn rt_file_read_text(path: text) -> text
@unsafe(reason: "status/out plugin provider loader ABI", capabilities: [ffi, raw_ptr])
extern fn spl_dlopen_checked(path: text, out_handle: *mut i64) -> i64
@unsafe(reason: "status/out plugin symbol resolver ABI", capabilities: [ffi, raw_ptr])
extern fn spl_dlsym_checked(handle: i64, name: text, out_symbol: *mut i64) -> i64
@unsafe(reason: "legacy generic integer plugin ABI has no typed contract", capabilities: [ffi, raw_ptr])
extern fn spl_wffi_call_i64(fptr: i64, args: [i64], nargs: i64) -> i64
@unsafe(reason: "legacy generic float plugin ABI has no typed contract", capabilities: [ffi, raw_ptr])
extern fn spl_wffi_call_f64(fptr: i64, args: [f64], nargs: i64) -> f64
@unsafe(reason: "checked integer transport cannot verify the foreign ABI", capabilities: [ffi, raw_ptr])
extern fn spl_wffi_call_i64_checked(fptr: i64, args: [i64], nargs: i64) -> [i64]
@unsafe(reason: "allocation-free checked integer status/out ABI", capabilities: [ffi, raw_ptr])
extern fn spl_wffi_try_call_i64_out(fptr: i64, args: [i64], nargs: i64, out_value: *mut i64) -> i64
@unsafe(reason: "checked float transport cannot verify the foreign ABI", capabilities: [ffi, raw_ptr])
extern fn spl_wffi_call_f64_checked(fptr: i64, args: [f64], nargs: i64) -> [i64]
@unsafe(reason: "raw IEEE-754 bit lift ABI", capabilities: [ffi])
extern fn spl_bits_to_f64(bits: i64) -> f64

@unsafe(reason: "legacy generic integer plugin ABI has no typed return contract", capabilities: [ffi, raw_ptr])
fn _plugin_call_i64_raw(fptr: i64, args: [i64]) -> i64:
    spl_wffi_call_i64(fptr, args, args.len())

@unsafe(reason: "legacy generic float plugin ABI has no typed return contract", capabilities: [ffi, raw_ptr])
fn _plugin_call_f64_raw(fptr: i64, args: [f64]) -> f64:
    spl_wffi_call_f64(fptr, args, args.len())

@unsafe(reason: "minimal allocation-free raw status/out scope", capabilities: [ffi, raw_ptr])
fn _plugin_try_call_i64_out(fptr: i64, args: [i64], out_value: *mut i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]):
        spl_wffi_try_call_i64_out(fptr, args, args.len(), out_value)

@unsafe(reason: "minimal raw FFI scope; caller validates transport status and IEEE-754 bits", capabilities: [ffi, raw_ptr])
fn _plugin_call_f64_raw_checked(fptr: i64, args: [f64]) -> [i64]:
    spl_wffi_call_f64_checked(fptr, args, args.len())

class LoadedPlugin:
    name: text
    library: text
    handle: i64

var _loaded_plugins: [LoadedPlugin] = []
var _loaded_symbols: {text: i64} = {}

fn _find_loaded(name: text) -> LoadedPlugin?:
    for plug in _loaded_plugins:
        if plug.name == name:
            return plug
    nil

fn _entry_in(entries: [PluginEntry], name: text) -> PluginEntry?:
    for entry in entries:
        if entry.name == name:
            return entry
    nil

@unsafe(reason: "loads an unsigned, unverified native plugin provider", capabilities: [ffi, raw_ptr])
fn use_plugin_from(manifest_path: text, name: text) -> bool:
    if _find_loaded(name).?:
        return true
    val manifest_exists = unsafe(capabilities: [ffi]):
        rt_file_exists(manifest_path)
    if not manifest_exists:
        return false
    val manifest_text = unsafe(capabilities: [ffi]):
        rt_file_read_text(manifest_path) ?? ""
    val entries = parse_plugin_manifest_text(manifest_text)
    for entry in entries:
        if entry.name == name:
            val library_exists = unsafe(capabilities: [ffi]):
                rt_file_exists(entry.library)
            if not library_exists:
                return false
            var handle: i64 = 0
            val load_status = unsafe(capabilities: [ffi, raw_ptr]):
                spl_dlopen_checked(entry.library, &mut handle)
            if load_status != 0 or handle <= 0:
                return false
            _loaded_plugins.push(LoadedPlugin(name: entry.name, library: entry.library, handle: handle))
            return true
    false

@unsafe(reason: "loads an unsigned, unverified native plugin provider", capabilities: [ffi, raw_ptr])
fn use_plugin(name: text) -> bool:
    use_plugin_from(plugin_manifest_path(), name)

fn list_plugins() -> [text]:
    var names: [text] = []
    for plug in _loaded_plugins:
        names.push(plug.name)
    names

@unsafe(reason: "resolves and caches an unverified plugin symbol", capabilities: [ffi, raw_ptr])
fn _plugin_resolve_checked(symbol: text) -> Result<i64, text>:
    val cached = _loaded_symbols[symbol]
    if cached != nil:
        return Ok(cached)
    for plug in _loaded_plugins:
        var fptr: i64 = 0
        val status = spl_dlsym_checked(plug.handle, symbol, &mut fptr)
        if status == 0 and fptr > 0:
            _loaded_symbols[symbol] = fptr
            return Ok(fptr)
    Err("E-SFFI-001: unresolved plugin symbol {symbol}")

@unsafe(reason: "legacy generic integer plugin API cannot prove the selected ABI", capabilities: [ffi, raw_ptr])
fn plugin_call_i64(symbol: text, args: [i64]) -> i64:
    val fptr = match _plugin_resolve_checked(symbol):
        case Ok(value): value
        case Err(error): panic(error)
    _plugin_call_i64_raw(fptr, args)

@unsafe(reason: "checked transport cannot verify the selected integer plugin ABI", capabilities: [ffi, raw_ptr])
fn plugin_call_i64_checked(symbol: text, args: [i64]) -> Result<i64, text>:
    val fptr = match _plugin_resolve_checked(symbol):
        case Ok(value): value
        case Err(error): return Err(error)
    var value: i64 = 0
    val status = _plugin_try_call_i64_out(fptr, args, &mut value)
    if status != 0:
        return Err("E-SFFI-014: integer plugin bridge status {status}")
    Ok(value)

@unsafe(reason: "legacy generic float plugin API cannot prove the selected ABI", capabilities: [ffi, raw_ptr])
fn plugin_call_f64(symbol: text, args: [f64]) -> f64:
    val fptr = match _plugin_resolve_checked(symbol):
        case Ok(value): value
        case Err(error): panic(error)
    _plugin_call_f64_raw(fptr, args)

@unsafe(reason: "checked transport cannot verify the selected float plugin ABI", capabilities: [ffi, raw_ptr])
fn plugin_call_f64_checked(symbol: text, args: [f64]) -> Result<f64, text>:
    val fptr = match _plugin_resolve_checked(symbol):
        case Ok(value): value
        case Err(error): return Err(error)
    val result = _plugin_call_f64_raw_checked(fptr, args)
    if result.len() != 2:
        return Err("E-SFFI-017: corrupt float plugin transport")
    if result[0] != 0:
        return Err("E-SFFI-014: float plugin bridge status {result[0]}")
    Ok(spl_bits_to_f64(result[1]))
