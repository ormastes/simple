# AOP debug-tap aspect for the exec-core VHDL generator.
#
# All dbg_* / debug_* tap emission lives here as advice functions invoked at
# named generator join points: PORTS (entity port list), SIGNALS (architecture
# signal decls), ASSIGNS (concurrent output assigns) and PROCESS_TAPS (in-process
# debug register updates, rv32 only). Mirrors the philosophy of
# src/lib/hardware/debug_hooks/hart_debug.spl: AOP = hart hooks; TAP/DTM/DMI
# stay explicit RTL (src/lib/hardware/debug/*.vhd is NOT generated here).
#
# Default ON — the goldens contain the taps, so byte-match requires enabled.
# OFF mode is diagnostic-only (drops the tap ports/signals/assigns; the literal
# core paragraphs still reference debug_* signals, so OFF output is not meant
# to analyze).

use std.hardware.riscv_common.xlen.XlenConfig
use std.hardware.vhdl_gen.gen_types.{VgPort, VgAssign, no_lines}

fn dbg_slv(hi: i64) -> text:
    "std_logic_vector(" + hi.to_text() + " downto 0)"

# JOIN POINT: ports — appended after the core clk/rst/uart_tx ports.
fn dbg_tap_ports(cfg: XlenConfig, enabled: bool) -> [VgPort]:
    var ports: [VgPort] = []
    if not enabled:
        return ports
    ports = ports.push(VgPort(pre_comments: no_lines(), name: "debug_uart_valid", dir: "out", ty: "std_logic", default_val: ""))
    ports = ports.push(VgPort(pre_comments: no_lines(), name: "debug_uart_byte", dir: "out", ty: dbg_slv(7), default_val: ""))
    if cfg.is_rv32():
        ports = ports.push(VgPort(pre_comments: no_lines(), name: "debug_pc", dir: "out", ty: dbg_slv(15), default_val: ""))
        ports = ports.push(VgPort(pre_comments: no_lines(), name: "debug_ins", dir: "out", ty: dbg_slv(31), default_val: ""))
        ports = ports.push(VgPort(pre_comments: no_lines(), name: "debug_a0", dir: "out", ty: dbg_slv(7), default_val: ""))
        ports = ports.push(VgPort(pre_comments: no_lines(), name: "debug_ra", dir: "out", ty: dbg_slv(15), default_val: ""))
        ports = ports.push(VgPort(pre_comments: no_lines(), name: "debug_sp", dir: "out", ty: dbg_slv(15), default_val: ""))
        ports = ports.push(VgPort(pre_comments: no_lines(), name: "debug_phase", dir: "out", ty: dbg_slv(3), default_val: ""))
    var jtag_comment: [text] = []
    if cfg.is_rv32():
        jtag_comment = jtag_comment.push("    -- Lane KK: ADDITIVE external debug read ports for the JTAG Debug Module.")
        jtag_comment = jtag_comment.push("    -- dbg_reg_addr selects x0..x31; dbg_reg_data returns the full 32-bit")
        jtag_comment = jtag_comment.push("    -- committed register value; dbg_pc exposes the full-width program counter.")
        jtag_comment = jtag_comment.push("    -- The input has a safe default so existing instantiations that do not")
        jtag_comment = jtag_comment.push("    -- connect it stay byte-identical; the outputs are pure read-only taps of")
        jtag_comment = jtag_comment.push("    -- regs_q / pc_q and cannot perturb execution.")
    else:
        jtag_comment = jtag_comment.push("    -- Additive read-only debug taps for the JTAG Debug Module (Lane B). Safe")
        jtag_comment = jtag_comment.push("    -- default on the input so instantiations that ignore it stay identical;")
        jtag_comment = jtag_comment.push("    -- the outputs are pure combinational taps of regs_q / pc_q.")
    ports = ports.push(VgPort(pre_comments: jtag_comment, name: "dbg_reg_addr", dir: "in", ty: dbg_slv(4), default_val: "(others => '0')"))
    ports = ports.push(VgPort(pre_comments: no_lines(), name: "dbg_reg_data", dir: "out", ty: dbg_slv(cfg.xlen - 1), default_val: ""))
    ports = ports.push(VgPort(pre_comments: no_lines(), name: "dbg_pc", dir: "out", ty: dbg_slv(cfg.xlen - 1), default_val: ""))
    ports

# JOIN POINT: signals — debug tap signal declarations.
fn dbg_tap_signal_lines(cfg: XlenConfig, enabled: bool) -> [text]:
    if not enabled:
        return no_lines()
    if cfg.is_rv32():
        rv32_dbg_signal_lines()
    else:
        rv64_dbg_signal_lines()

# JOIN POINT: assigns — concurrent tap assigns (read-only taps of regs_q/pc_q).
fn dbg_tap_assigns(cfg: XlenConfig, enabled: bool) -> [VgAssign]:
    var a: [VgAssign] = []
    if not enabled:
        return a
    a = a.push(VgAssign(pre_comments: no_lines(), lhs: "debug_uart_valid", rhs: "debug_uart_valid_q"))
    a = a.push(VgAssign(pre_comments: no_lines(), lhs: "debug_uart_byte", rhs: "debug_uart_byte_q"))
    if cfg.is_rv32():
        a = a.push(VgAssign(pre_comments: no_lines(), lhs: "debug_pc", rhs: "debug_pc_q"))
        a = a.push(VgAssign(pre_comments: no_lines(), lhs: "debug_ins", rhs: "debug_ins_q"))
        a = a.push(VgAssign(pre_comments: no_lines(), lhs: "debug_a0", rhs: "debug_a0_q"))
        a = a.push(VgAssign(pre_comments: no_lines(), lhs: "debug_ra", rhs: "debug_ra_q"))
        a = a.push(VgAssign(pre_comments: no_lines(), lhs: "debug_sp", rhs: "debug_sp_q"))
        a = a.push(VgAssign(pre_comments: no_lines(), lhs: "debug_phase", rhs: "debug_phase_q"))
    var tap_comment: [text] = []
    if cfg.is_rv32():
        tap_comment = tap_comment.push("  -- Lane KK: additive read-only debug taps (combinational, no state added).")
    a = a.push(VgAssign(pre_comments: tap_comment, lhs: "dbg_reg_data", rhs: "std_logic_vector(regs_q(to_integer(unsigned(dbg_reg_addr))))"))
    a = a.push(VgAssign(pre_comments: no_lines(), lhs: "dbg_pc", rhs: "std_logic_vector(pc_q)"))
    a

# JOIN POINT: process_taps — in-process debug register updates (rv32 only).
fn dbg_tap_process_lines(cfg: XlenConfig, enabled: bool) -> [text]:
    if not enabled:
        return no_lines()
    if cfg.is_rv32():
        rv32_dbg_process_tap_lines()
    else:
        no_lines()

# ---------------------------------------------------------------------------
# Literal tap sections (verbatim from the proven cores)
# ---------------------------------------------------------------------------

fn rv32_dbg_signal_lines() -> [text]:
    var l: [text] = []
    l = l.push("  signal debug_uart_valid_q : std_logic := '0';")
    l = l.push("  signal debug_uart_valid_next_q : std_logic := '0';")
    l = l.push("  signal debug_uart_byte_q : std_logic_vector(7 downto 0) := (others => '0');")
    l = l.push("  signal debug_pc_q : std_logic_vector(15 downto 0) := (others => '0');")
    l = l.push("  signal debug_ins_q : std_logic_vector(31 downto 0) := (others => '0');")
    l = l.push("  signal debug_a0_q : std_logic_vector(7 downto 0) := (others => '0');")
    l = l.push("  signal debug_ra_q : std_logic_vector(15 downto 0) := (others => '0');")
    l = l.push("  signal debug_sp_q : std_logic_vector(15 downto 0) := (others => '0');")
    l = l.push("  signal debug_phase_q : std_logic_vector(3 downto 0) := (others => '0');")
    l

fn rv32_dbg_process_tap_lines() -> [text]:
    var l: [text] = []
    l = l.push("        debug_pc_q <= std_logic_vector(pc_q(15 downto 0));")
    l = l.push("        debug_ins_q <= ins;")
    l = l.push("        debug_a0_q <= std_logic_vector(r(10)(7 downto 0));")
    l = l.push("        debug_ra_q <= std_logic_vector(r(1)(15 downto 0));")
    l = l.push("        debug_sp_q <= std_logic_vector(r(2)(15 downto 0));")
    l = l.push("        if pc_q = x\"8000CD62\" then")
    l = l.push("          debug_phase_q <= x\"1\";")
    l = l.push("        elsif pc_q = x\"8000CF50\" then")
    l = l.push("          debug_phase_q <= x\"2\";")
    l = l.push("        elsif pc_q = x\"80003B8C\" then")
    l = l.push("          debug_phase_q <= x\"3\";")
    l = l.push("        elsif pc_q = x\"80003BAA\" then")
    l = l.push("          debug_phase_q <= x\"4\";")
    l = l.push("        elsif pc_q = x\"80003BBE\" then")
    l = l.push("          debug_phase_q <= x\"5\";")
    l = l.push("        elsif pc_q = x\"8000CF6E\" then")
    l = l.push("          debug_phase_q <= x\"6\";")
    l = l.push("        end if;")
    l

fn rv64_dbg_signal_lines() -> [text]:
    var l: [text] = []
    l = l.push("  signal debug_uart_valid_q      : std_logic := '0';")
    l = l.push("  signal debug_uart_valid_next_q : std_logic := '0';")
    l = l.push("  signal debug_uart_byte_q       : std_logic_vector(7 downto 0) := (others => '0');")
    l

