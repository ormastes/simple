# Built-in Planner Extension
#
# Declares the "task" document kind and the planner.* command surface. The
# real task/board logic lives on PlannerApp, the kanban/list/calendar/
# timeline task manager (src/app/office/planner/planner_app.spl):
# PlannerApp.add_task appends a new task to the project (line 128),
# PlannerApp.move_task moves a task to a different board column (line 135),
# and PlannerApp.switch_view switches between kanban/list/calendar/timeline
# (line 114). This manifest is the typed, host-visible declaration of that
# command surface, matching writer_ext_manifest's pattern of declaring
# commands the app itself owns and runs.
#
# NOTE (IDE extension kernel campaign, lane F5): app.ide.capabilities'
# "planner" row lists owner_module std.nogc_sync_mut.db.query_planner -- a
# DB predicate/index cost-based query planner, not a task/board app. That
# file exists but has no command surface resembling a planner UI. This
# manifest instead derives commands from PlannerApp, the actual office app
# implementing "Planner" (same src/app/office/* convention as
# sheets/slides). capabilities.spl itself is out of this lane's ownership
# (app-code); flagged here for a follow-up owner_module fix.

use std.editor.extensions.manifest.{ExtensionManifest, ExtensionCommand, ExtensionLanguage,
    extension_manifest_basic}

fn planner_ext_manifest() -> ExtensionManifest:
    extension_manifest_basic(
        "planner", "1.0.0", "",
        ["onCommand:planner.add_task", "onCommand:planner.move_task"],
        [
            ExtensionCommand(id: "planner.add_task", title: "Planner: Add Task", category: "Planner"),
            ExtensionCommand(id: "planner.move_task", title: "Planner: Move Task", category: "Planner"),
            ExtensionCommand(id: "planner.switch_view", title: "Planner: Switch View", category: "Planner")
        ],
        [ExtensionLanguage(id: "task", extensions: ["board", "calendar"])]
    )
