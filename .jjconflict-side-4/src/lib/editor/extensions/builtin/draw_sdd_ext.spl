# Built-in Draw/SDD Extension
#
# Declares the "sdd"/"sdn" diagram document kind and the draw.* command
# surface. The real parse/render/export logic lives on the SDN graph model
# (src/lib/editor/services/sdn_graph.spl, owner_module of the "draw-sdd" IDE
# capability): sdn_graph_parse (dense-table -> SdnGraph, line 62),
# sdn_graph_render_html (SdnGraph -> HTML diagram, line 201), and
# sdn_graph_to_canonical_sdn (SdnGraph -> canonical .sdn text, line 174).
# This manifest is the typed, host-visible declaration of that command
# surface, matching md_language_manifest/writer_ext_manifest's pattern of
# declaring commands the app itself owns and runs.

use std.editor.extensions.manifest.{ExtensionManifest, ExtensionCommand, ExtensionLanguage,
    extension_manifest_basic}

fn draw_sdd_ext_manifest() -> ExtensionManifest:
    extension_manifest_basic(
        "draw-sdd", "1.0.0", "",
        ["onCommand:draw.parse_sdn", "onCommand:draw.render_html"],
        [
            ExtensionCommand(id: "draw.parse_sdn", title: "Draw/SDD: Parse Diagram", category: "Draw/SDD"),
            ExtensionCommand(id: "draw.render_html", title: "Draw/SDD: Render HTML", category: "Draw/SDD"),
            ExtensionCommand(id: "draw.export_canonical", title: "Draw/SDD: Export Canonical SDN", category: "Draw/SDD")
        ],
        [ExtensionLanguage(id: "sdd", extensions: ["sdn", "draw"])]
    )
