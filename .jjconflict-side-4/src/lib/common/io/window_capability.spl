use common.io.window_event.{
    WINDOW_STATUS_OK,
    WINDOW_STATUS_UNSUPPORTED,
}

val WINDOW_CAP_SHOW_HIDE: i64 = 1
val WINDOW_CAP_POSITION: i64 = 2
val WINDOW_CAP_FRAMEBUFFER_SCALE: i64 = 3
val WINDOW_CAP_FOCUS: i64 = 4
val WINDOW_CAP_MINIMIZE: i64 = 5
val WINDOW_CAP_MAXIMIZE: i64 = 6
val WINDOW_CAP_DECORATIONS: i64 = 7
val WINDOW_CAP_FLOATING: i64 = 8
val WINDOW_CAP_TEXT_INPUT: i64 = 9
val WINDOW_CAP_CLIPBOARD: i64 = 10
val WINDOW_CAP_CURSOR_CAPTURE: i64 = 11
val WINDOW_CAP_PRESENT_ARGB: i64 = 12

struct WindowCapability:
    operation: i64
    supported: bool
    status: i64
    reason: text

fn window_capability(operation: i64, supported: bool, reason: text) -> WindowCapability:
    WindowCapability(
        operation: operation,
        supported: supported,
        status: if supported: WINDOW_STATUS_OK else: WINDOW_STATUS_UNSUPPORTED,
        reason: reason
    )
