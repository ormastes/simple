# Host adapter: framebuffer driver types for wm_compare's framebuffer-baseline
# pixel path (in-process ARGB8888 buffer via FramebufferDriver.from_buffer, no
# QEMU/MMIO).
#
# Lives outside wm_lane_scope_dirs() (see
# src/compiler/90.tools/lint/_LintMain/wm_lane_boundary_lints.spl:51) so the
# os.drivers.framebuffer.fb_driver import below is legal here. FramebufferDriver
# and Color are plain value types + free constructors (no host-only state
# beyond what wm_compare already treats as measurement input), so a facade
# re-export is the correct boundary, same as wave 1's stateless facades.
# See doc/03_plan/ui/wm_lane_boundary_ratchet_lanes.md (tranche W2, wave 2).

export use os.drivers.framebuffer.fb_driver.{FramebufferDriver, Color}
