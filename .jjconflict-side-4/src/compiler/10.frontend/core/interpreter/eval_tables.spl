# Core Interpreter — Function/Struct/Enum Tables & Annotation Scanner
#
# Split from eval.spl. Contains:
# - Function table (hash map): func_table_register, func_table_lookup, etc.
# - Function return type table: func_register_return_type, func_lookup_return_type
# - Must-Use registry (R9): must_use_register, must_use_is_registered, etc.
# - Annotation scanner: must_use_scan_source (scans for @must_use, @init, @teardown, @when, @cfg)
# - Struct definition table: struct_table_register, struct_table_lookup, etc.
# - Enum type registry: enum_table_register, enum_table_lookup, etc.
# - Phantom struct registry: phantom_struct_register, phantom_struct_is_registered
# - Match exhaustiveness helpers
#
# All evaluation returns a value_id (i64). Errors indicated by -1 (VAL_NONE).

use compiler.core.cfg_platform.{cfg_detect_os, cfg_detect_arch, cfg_detect_cpu, cfg_eval_key_value}
use compiler.core.ast.{module_get_path}
use compiler.core.ast_types.{CoreExpr, CoreStmt, CoreDecl}
use compiler.core.interpreter.hashmap.{HM_SIZE, hm_hash_text, hm_make_global_buckets}

# ===== Function Table (Hash Map) =====
# Maps function name -> decl_id for call resolution
var ft_keys: [text] = []
var ft_vals: [i64] = []
var ft_buckets: [i64] = []
var ft_nexts: [i64] = []

# ===== Function Return Types (Hash Map) =====
var frt_keys: [text] = []
var frt_vals: [i64] = []
var frt_buckets: [i64] = []
var frt_nexts: [i64] = []

# ===== Decl Owner File Tracking (coverage attribution) =====
#
# Maps decl_id -> the source file that DEFINED it, captured at registration
# time. module_get_path() alone is only correct for whichever module is
# CURRENTLY being parsed/loaded; once module_loader_core flattens every
# file's functions and impl-methods into the bare-name func_table, a call
# into another module's function needs ITS OWN file, not whatever module
# happens to be parsing right now. Populated by
# module_loader_core.register_module_functions() for DECL_FN and DECL_IMPL
# methods — the pure-Simple counterpart of the seed's RC1 (impl-method owner
# tagging, b6a43042) / RC2 (entry-script owner fallback, 40fa02ee) fixes.
#
# decl_id is a dense, monotonically-increasing global arena index (see
# decl_alloc in _Ast/decl_nodes.spl), so a direct-indexed array with
# "" padding gives O(1) get/set without a hash map.
var dof_files: [text] = []

fn decl_owner_file_reset():
    dof_files = []

fn decl_owner_file_set(decl_id: i64, file: text):
    if decl_id < 0: return
    while dof_files.len() <= decl_id:
        dof_files.push("")
    dof_files[decl_id] = file

fn decl_owner_file_get(decl_id: i64) -> text:
    if decl_id < 0 or decl_id >= dof_files.len(): return ""
    dof_files[decl_id]

# ===== Must-Use Function Registry (Hash Map, R9) =====
var mu_keys: [text] = []
var mu_reasons: [text] = []
var mu_buckets: [i64] = []
var mu_nexts: [i64] = []
var must_use_critical_mode: bool = false

# @init and @teardown function name lists
var init_functions: [text] = []
var teardown_functions: [text] = []

# @when conditional compilation — skipped decl names
var when_disabled_decls: [text] = []

fn when_check_condition(condition: text) -> bool:
    # Evaluate @when condition for build/profile and target predicates.
    val cond = condition.trim()

    if cond == "true": return true
    if cond == "false": return false
    if cond == "debug": return true     # Always true in interpreter mode
    if cond == "release": return false  # False in interpreter mode
    if cond == "interpreter": return true
    if cond == "compiled": return false

    # Platform shorthands
    if cond == "win" or cond == "windows":
        return cfg_detect_os() == "windows"
    if cond == "linux":
        return cfg_detect_os() == "linux"
    if cond == "mac" or cond == "macos" or cond == "darwin":
        return cfg_detect_os() == "macos"
    if cond == "freebsd":
        return cfg_detect_os() == "freebsd"
    if cond == "openbsd":
        return cfg_detect_os() == "openbsd"
    if cond == "netbsd":
        return cfg_detect_os() == "netbsd"
    if cond == "android":
        return cfg_detect_os() == "android"
    if cond == "unix":
        val os = cfg_detect_os()
        val is_unix = os == "linux" or os == "macos"
        val is_unix2 = os == "freebsd" or os == "openbsd"
        val is_unix3 = os == "netbsd" or os == "android"
        return is_unix or is_unix2 or is_unix3 or os == "unix"

    # CPU/arch shorthands
    if cond == "x86_64" or cond == "amd64" or cond == "x64":
        return cfg_detect_arch() == "x86_64"
    if cond == "x86" or cond == "i386" or cond == "i686":
        return cfg_detect_arch() == "x86"
    if cond == "aarch64" or cond == "arm64":
        return cfg_detect_arch() == "aarch64"
    if cond == "arm" or cond == "armv7" or cond == "armv6":
        return cfg_detect_arch() == "arm"
    if cond == "riscv64":
        return cfg_detect_arch() == "riscv64"
    if cond == "riscv32":
        return cfg_detect_arch() == "riscv32"
    if cond == "ppc64le" or cond == "ppc64el" or cond == "powerpc64le":
        return cfg_detect_arch() == "ppc64le"

    # Key-value forms: os=linux, os=="linux", arch=x86_64, cpu=arm64, feature=foo.
    if cond.contains("=="):
        val parts = cond.split("==")
        if parts.len() >= 2:
            return cfg_eval_key_value(parts[0], parts[1])
    if cond.contains("="):
        val parts = cond.split("=")
        if parts.len() >= 2:
            return cfg_eval_key_value(parts[0], parts[1])

    # Unknown condition: default to true (don't skip existing code silently).
    true

fn func_table_reset():
    ft_keys = []
    ft_vals = []
    ft_buckets = hm_make_global_buckets()
    ft_nexts = []
    frt_keys = []
    frt_vals = []
    frt_buckets = hm_make_global_buckets()
    frt_nexts = []
    mu_keys = []
    mu_reasons = []
    mu_buckets = hm_make_global_buckets()
    mu_nexts = []
    must_use_critical_mode = false
    decl_owner_file_reset()

# Co-compiled signature-collision detection.
#
# The interpreter func_table is a bare-name namespace, and the import loader
# flattens all files into it, so two files that each define the same
# helper with differing signatures silently mis-dispatch: the
# second registration clobbers the first (last-write-wins), and a call to the
# clobbered version dispatches to the wrong body — silent wrong-result or crash.
# This is a non-breaking diagnostic only; the fix is to rename one helper.
# See bug `compiler_cross_module_private_symbol_collision_2026-06-16`.
#
# Scope widened 2026-08-01: this used to skip every name not starting with `_`
# and every method registration (`Type__method`). Both skips were blind spots,
# not safety: a public free function lives in the SAME last-write-wins table as
# a private one, and a `Type__method` key is unique per TYPE, not per MODULE —
# two modules defining `impl Type` with the same method name clobber each other
# identically. Because of those skips, "no collision warning was printed" was
# routinely misread as "nothing collided". Do not reintroduce them. See
# doc/08_tracking/bug/diag_stage_facet_cross_module_collision_under_test_2026-07-06.md
var _ftr_collision_warned: [text] = []

fn _ftr_sig_differs(a_did: i64, b_did: i64) -> bool:
    if decl_get_ret_type(a_did) != decl_get_ret_type(b_did):
        return true
    val ap = decl_get_param_types(a_did)
    val bp = decl_get_param_types(b_did)
    if ap.len() != bp.len():
        return true
    var i = 0
    while i < ap.len():
        if ap[i] != bp[i]:
            return true
        i = i + 1
    false

fn _ftr_collision_kind(name: text) -> text:
    if name.contains("__"):
        return "method"
    if name.starts_with("_"):
        return "private helper"
    "public function"

# Same-signature arm gate. Default OFF.
#
# Two co-compiled definitions with IDENTICAL signatures are not harmless. One
# silently wins and the other is discarded, and because the signatures agree no
# type error, no arity error and no ambiguity fallback can ever fire — the call
# just runs a different module's body than the one the caller imported. It is
# the only collision shape undetectable from the call site, and it was the one
# shape this warning never reported.
#
# Measured 2026-08-01 on the Rust seed: 313 distinct same-signature collisions
# are co-compiled into the import graph of even a 3-example spec, against 38
# differing-signature ones. Reporting them unconditionally would bury the
# existing warning, so this arm is opt-in via
# SIMPLE_DIAG_SAME_SIGNATURE_COLLISION=1. Warn-only; deliberately not fatal.
#
# See doc/08_tracking/bug/vacuous_spec_census_2026-07-30.md
# ("A FOURTH vacuity shape: name-collision hijack").
extern fn rt_env_get_i64(key: text, default_value: i64) -> i64

var _ftr_samesig_diag: i64 = -1

fn _ftr_samesig_diag_enabled() -> bool:
    # Memoised in a slot: func_table_register is a hot path and rt_env_get_i64 is
    # itself a linear environ scan (see ast_env_var_quadratic_parse_2026-06-13),
    # so this must not be re-read per registration.
    if _ftr_samesig_diag == -1:
        _ftr_samesig_diag = rt_env_get_i64("SIMPLE_DIAG_SAME_SIGNATURE_COLLISION", 0)
    _ftr_samesig_diag == 1

fn _ftr_warn_collision(name: text, existing_did: i64, new_did: i64):
    # Private helpers, public free functions and `Type__method` registrations all
    # share this one flat table, so all three are checked. See the note above the
    # `_ftr_collision_warned` declaration before narrowing this again.
    if existing_did == new_did:
        return
    if not _ftr_sig_differs(existing_did, new_did):
        # SAME-SIGNATURE COLLISION. This used to be an unconditional `return`.
        # See `_ftr_samesig_diag` above for why that was backwards.
        if not _ftr_samesig_diag_enabled():
            return
        var k = 0
        while k < _ftr_collision_warned.len():
            if _ftr_collision_warned[k] == "samesig:{name}":
                return
            k = k + 1
        _ftr_collision_warned.push("samesig:{name}")
        val same_kind = _ftr_collision_kind(name)
        print "[WARN] {same_kind} '{name}' has co-compiled definitions with the SAME signature; one silently wins and the rest are discarded. No type/arity error can fire, so a call resolves to a different module's body than the one it imported — a silent wrong answer, and the shape that makes an importing spec vacuous. Rename one of the definitions. [compiler_cross_module_private_symbol_collision]"
        return
    var j = 0
    while j < _ftr_collision_warned.len():
        if _ftr_collision_warned[j] == name:
            return
        j = j + 1
    _ftr_collision_warned.push(name)
    val kind = _ftr_collision_kind(name)
    print "[WARN] {kind} '{name}' has co-compiled definitions with differing signatures; calls resolve by bare name (last-write-wins) and may dispatch to the wrong one — silent wrong-result or crash. Rename the conflicting helper(s). [compiler_cross_module_private_symbol_collision]"

fn func_table_register(name: text, decl_id: i64):
    val bucket = hm_hash_text(name) % HM_SIZE
    var idx = ft_buckets[bucket]
    while idx != -1:
        if ft_keys[idx] == name:
            _ftr_warn_collision(name, ft_vals[idx], decl_id)
            ft_vals[idx] = decl_id
            return
        idx = ft_nexts[idx]
    # New entry
    val new_idx = ft_keys.len()
    ft_keys.push(name)
    ft_vals.push(decl_id)
    ft_nexts.push(ft_buckets[bucket])
    ft_buckets[bucket] = new_idx

fn func_table_lookup(name: text) -> i64:
    val bucket = hm_hash_text(name) % HM_SIZE
    var idx = ft_buckets[bucket]
    while idx != -1:
        if ft_keys[idx] == name:
            return ft_vals[idx]
        idx = ft_nexts[idx]
    -1

fn func_table_remove(name: text) -> bool:
    val bucket = hm_hash_text(name) % HM_SIZE
    var prev: i64 = -1
    var idx = ft_buckets[bucket]
    while idx != -1:
        if ft_keys[idx] == name:
            if prev == -1:
                ft_buckets[bucket] = ft_nexts[idx]
            else:
                ft_nexts[prev] = ft_nexts[idx]
            ft_keys[idx] = ""
            ft_vals[idx] = -1
            return true
        prev = idx
        idx = ft_nexts[idx]
    false

fn func_remove_return_type(name: text) -> bool:
    val bucket = hm_hash_text(name) % HM_SIZE
    var prev: i64 = -1
    var idx = frt_buckets[bucket]
    while idx != -1:
        if frt_keys[idx] == name:
            if prev == -1:
                frt_buckets[bucket] = frt_nexts[idx]
            else:
                frt_nexts[prev] = frt_nexts[idx]
            frt_keys[idx] = ""
            frt_vals[idx] = -1
            return true
        prev = idx
        idx = frt_nexts[idx]
    false

# ===== Owner-Guarded Removal (pure_interp_registry_2026-07-17) =====
#
# func_table/struct_table are bare-name (non-module-qualified) maps: two
# modules registering the same name silently overwrite (last-write-wins).
# If module A registers "helper" then module B (loaded later) also
# registers "helper", the table now holds B's decl_id. If A is later
# selectively unloaded (interp_unload_module), a blind
# func_table_remove("helper") would delete the entry — even though it is
# currently B's LIVE registration, not A's. That deletes an unrelated
# module's function out from under it: a cross-module registry corruption
# via unload, in the same failure class documented for the Rust seed
# (see doc/08_tracking/bug/mcp_stdio_smoke_seed_flat_registry_len_i64_2026-07-17.md).
#
# These _owned variants are additive (existing func_table_remove /
# func_remove_return_type / struct_table_remove are untouched for any
# caller not yet migrated) and no-op when the current owner does not match
# the expected decl_id, preserving whichever module's registration is
# actually live.

fn func_table_remove_owned(name: text, expected_decl_id: i64) -> bool:
    val current = func_table_lookup(name)
    if current != expected_decl_id:
        return false
    func_table_remove(name)

fn func_remove_return_type_owned(name: text, expected_decl_id: i64) -> bool:
    # If a DIFFERENT decl currently owns this bare name in func_table, its
    # return-type entry belongs to that owner too — leave it alone. Safe to
    # remove when nobody (-1) or our own decl currently owns the name.
    val current = func_table_lookup(name)
    if current >= 0 and current != expected_decl_id:
        return false
    func_remove_return_type(name)

fn func_register_return_type(name: text, ret_type: i64):
    val bucket = hm_hash_text(name) % HM_SIZE
    var idx = frt_buckets[bucket]
    while idx != -1:
        if frt_keys[idx] == name:
            frt_vals[idx] = ret_type
            return
        idx = frt_nexts[idx]
    val new_idx = frt_keys.len()
    frt_keys.push(name)
    frt_vals.push(ret_type)
    frt_nexts.push(frt_buckets[bucket])
    frt_buckets[bucket] = new_idx

fn func_lookup_return_type(name: text) -> i64:
    val bucket = hm_hash_text(name) % HM_SIZE
    var idx = frt_buckets[bucket]
    while idx != -1:
        if frt_keys[idx] == name:
            return frt_vals[idx]
        idx = frt_nexts[idx]
    -1

# ===== Must-Use Registry Functions (R9) =====

fn must_use_register(name: text, reason: text):
    val bucket = hm_hash_text(name) % HM_SIZE
    var idx = mu_buckets[bucket]
    while idx != -1:
        if mu_keys[idx] == name:
            mu_reasons[idx] = reason
            return
        idx = mu_nexts[idx]
    val new_idx = mu_keys.len()
    mu_keys.push(name)
    mu_reasons.push(reason)
    mu_nexts.push(mu_buckets[bucket])
    mu_buckets[bucket] = new_idx

fn must_use_is_registered(name: text) -> bool:
    val bucket = hm_hash_text(name) % HM_SIZE
    var idx = mu_buckets[bucket]
    while idx != -1:
        if mu_keys[idx] == name: return true
        idx = mu_nexts[idx]
    false

fn must_use_get_reason(name: text) -> text:
    val bucket = hm_hash_text(name) % HM_SIZE
    var idx = mu_buckets[bucket]
    while idx != -1:
        if mu_keys[idx] == name: return mu_reasons[idx]
        idx = mu_nexts[idx]
    ""

fn must_use_is_critical() -> bool:
    must_use_critical_mode

fn must_use_scan_source(source: text):
    mu_keys = []
    mu_reasons = []
    mu_buckets = hm_make_global_buckets()
    mu_nexts = []
    must_use_critical_mode = false
    # Split source into lines and scan for comment annotations
    var lines: [text] = []
    var line_chars: [text] = []
    var ci: i64 = 0
    for _unused in source:
        if ci >= source.len(): break
        val ch = source[ci]
        if ch == "\n":
            lines.push(line_chars.join(""))
            line_chars = []
        else:
            line_chars.push(ch)
        ci = ci + 1
    if line_chars.len() > 0:
        lines.push(line_chars.join(""))
    # Scan for annotations
    var pending_must_use: bool = false
    var pending_reason: text = ""
    var pending_init: bool = false
    var pending_teardown: bool = false
    var pending_when: text = ""
    var li: i64 = 0
    for line in lines:
        # Trim leading spaces
        var trimmed_chars: [text] = []
        var started: bool = false
        var ti: i64 = 0
        for _c in line:
            if ti >= line.len(): break
            val lc = line[ti]
            if started:
                trimmed_chars.push(lc)
            elif lc != " " and lc != "\t":
                started = true
                trimmed_chars.push(lc)
            ti = ti + 1
        val trimmed = trimmed_chars.join("")
        # Check for @profile(critical)
        if trimmed.starts_with("# @profile(critical)"):
            must_use_critical_mode = true
        # Check for @tailrec annotation — marks function for tail-call optimization
        if trimmed.starts_with("# @tailrec"):
            pending_init = false  # @tailrec isn't @init
            pending_teardown = false
            # Simply note the next fn as tailrec-annotated for warning purposes

        # Check for @init annotation
        if trimmed.starts_with("# @init"):
            pending_init = true
        # Check for @teardown annotation
        if trimmed.starts_with("# @teardown"):
            pending_teardown = true
        # Check for @when(condition) conditional compilation (comment form: backward compat)
        if trimmed.starts_with("# @when("):
            # Extract condition: "# @when(condition)"
            var when_cond_chars: [text] = []
            var wci: i64 = 8
            for _wc in trimmed:
                if wci >= trimmed.len(): break
                val wch = trimmed[wci]
                if wch == ")": break
                when_cond_chars.push(wch)
                wci = wci + 1
            val when_cond = when_cond_chars.join("")
            pending_when = when_cond
        # Check for @cfg(condition) — new proper syntax (no # prefix)
        if trimmed.starts_with("@cfg("):
            var cfg_chars: [text] = []
            var cci: i64 = 5
            var cfg_depth: i64 = 1
            for _cc in trimmed:
                if cci >= trimmed.len(): break
                val cch = trimmed[cci]
                if cch == "(":
                    cfg_depth = cfg_depth + 1
                if cch == ")":
                    cfg_depth = cfg_depth - 1
                    if cfg_depth == 0: break
                cfg_chars.push(cch)
                cci = cci + 1
            var cfg_cond = cfg_chars.join("").trim()
            # Convert @cfg("key", "value") to key=value form
            if cfg_cond.contains(","):
                val cfg_parts = cfg_cond.split(",")
                if cfg_parts.len() >= 2:
                    var cfg_key = cfg_parts[0].trim()
                    var cfg_val = cfg_parts[1].trim()
                    # Strip quotes
                    if cfg_key.len() >= 2 and cfg_key.starts_with("\"") and cfg_key.ends_with("\""):
                        cfg_key = cfg_key[1:cfg_key.len() - 1]
                    if cfg_val.len() >= 2 and cfg_val.starts_with("\"") and cfg_val.ends_with("\""):
                        cfg_val = cfg_val[1:cfg_val.len() - 1]
                    cfg_cond = "{cfg_key}={cfg_val}"
            pending_when = cfg_cond
        # Check for @must_use
        if trimmed.starts_with("# @must_use"):
            pending_must_use = true
            # Extract reason from @must_use("reason")
            pending_reason = ""
            if trimmed.contains("(\""):
                # Find text between (" and ")
                var in_reason: bool = false
                var reason_chars: [text] = []
                var ri: i64 = 0
                for _rc in trimmed:
                    if ri >= trimmed.len(): break
                    if in_reason:
                        val rc2 = trimmed[ri]
                        if rc2 == "\"":
                            in_reason = false
                        else:
                            reason_chars.push(rc2)
                    elif ri + 1 < trimmed.len():
                        val rc3 = trimmed[ri]
                        val rc4 = trimmed[ri + 1]
                        if rc3 == "(" and rc4 == "\"":
                            in_reason = true
                            ri = ri + 1
                    ri = ri + 1
                pending_reason = reason_chars.join("")
        # Check if line declares a function (and we have a pending annotation)
        if pending_must_use:
            if trimmed.starts_with("fn "):
                # Extract function name
                var fname_chars: [text] = []
                var fi: i64 = 3
                for _fc in trimmed:
                    if fi >= trimmed.len(): break
                    val fc2 = trimmed[fi]
                    if fc2 == "(" or fc2 == " " or fc2 == ":": break
                    fname_chars.push(fc2)
                    fi = fi + 1
                val fname = fname_chars.join("")
                if fname != "":
                    must_use_register(fname, pending_reason)
                pending_must_use = false
                pending_reason = ""
            elif trimmed.starts_with("# ") == false and trimmed != "":
                # Non-comment, non-empty line without fn => cancel pending
                pending_must_use = false
                pending_reason = ""
        # Handle @init and @teardown function registration
        if pending_init or pending_teardown or pending_when != "":
            if trimmed.starts_with("fn ") or trimmed.starts_with("val ") or trimmed.starts_with("var "):
                # Extract declaration name
                var anno_fname_chars: [text] = []
                var anno_fi: i64 = 3
                if trimmed.starts_with("val ") or trimmed.starts_with("var "):
                    anno_fi = 4
                for _afc in trimmed:
                    if anno_fi >= trimmed.len(): break
                    val afc2 = trimmed[anno_fi]
                    if afc2 == "(" or afc2 == " " or afc2 == ":" or afc2 == "=": break
                    anno_fname_chars.push(afc2)
                    anno_fi = anno_fi + 1
                val anno_fname = anno_fname_chars.join("")
                if anno_fname != "":
                    if pending_init:
                        init_functions.push(anno_fname)
                    if pending_teardown:
                        teardown_functions.push(anno_fname)
                    if pending_when != "":
                        val when_ok = when_check_condition(pending_when)
                        if when_ok == false:
                            when_disabled_decls.push(anno_fname)
                pending_init = false
                pending_teardown = false
                pending_when = ""
            elif trimmed.starts_with("# ") == false and trimmed != "":
                pending_init = false
                pending_teardown = false
                pending_when = ""
        li = li + 1

# ===== Struct Definition Table (Hash Map) =====
# Maps struct name -> decl_id for constructor resolution
var st_keys: [text] = []
var st_vals: [i64] = []
var st_buckets: [i64] = []
var st_nexts: [i64] = []
var st_module_paths: [text] = []

fn struct_table_reset():
    st_keys = []
    st_vals = []
    st_buckets = hm_make_global_buckets()
    st_nexts = []
    st_module_paths = []

fn struct_table_register(name: text, decl_id: i64):
    val bucket = hm_hash_text(name) % HM_SIZE
    var idx = st_buckets[bucket]
    while idx != -1:
        if st_keys[idx] == name:
            st_vals[idx] = decl_id
            st_module_paths[idx] = module_get_path()
            return
        idx = st_nexts[idx]
    val new_idx = st_keys.len()
    st_keys.push(name)
    st_vals.push(decl_id)
    st_nexts.push(st_buckets[bucket])
    st_buckets[bucket] = new_idx
    st_module_paths.push(module_get_path())

fn struct_table_lookup(name: text) -> i64:
    val bucket = hm_hash_text(name) % HM_SIZE
    var idx = st_buckets[bucket]
    while idx != -1:
        if st_keys[idx] == name:
            return st_vals[idx]
        idx = st_nexts[idx]
    -1

fn struct_table_remove(name: text) -> bool:
    val bucket = hm_hash_text(name) % HM_SIZE
    var prev: i64 = -1
    var idx = st_buckets[bucket]
    while idx != -1:
        if st_keys[idx] == name:
            if prev == -1:
                st_buckets[bucket] = st_nexts[idx]
            else:
                st_nexts[prev] = st_nexts[idx]
            st_keys[idx] = ""
            st_vals[idx] = -1
            st_module_paths[idx] = ""
            return true
        prev = idx
        idx = st_nexts[idx]
    false

fn struct_table_remove_owned(name: text, expected_decl_id: i64) -> bool:
    # pure_interp_registry_2026-07-17: see func_table_remove_owned above —
    # same bare-name unload-corruption guard, for the struct table.
    val current = struct_table_lookup(name)
    if current != expected_decl_id:
        return false
    struct_table_remove(name)

fn struct_table_get_module(name: text) -> text:
    val bucket = hm_hash_text(name) % HM_SIZE
    var idx = st_buckets[bucket]
    while idx != -1:
        if st_keys[idx] == name:
            return st_module_paths[idx]
        idx = st_nexts[idx]
    ""

# ===== Enum Type Registry (Hash Map) =====
# Tracks enum type names and their variants for exhaustiveness checking.
# Variants stored as comma-separated text to avoid [[text]] arrays.
# Uses chained hashing for O(1) average lookup (was O(n) linear scan).
var enum_reg_names: [text] = []
var enum_reg_variants: [text] = []
var enum_hm_buckets: [i64] = []
var enum_hm_nexts: [i64] = []

fn enum_table_reset():
    enum_reg_names = []
    enum_reg_variants = []
    enum_hm_buckets = hm_make_global_buckets()
    enum_hm_nexts = []

# Bare enum names already warned about, so a repeatedly re-registered enum
# reports once instead of once per module. Mirrors `_ftr_collision_warned`.
var _enum_collision_warned: [text] = []

fn _enum_warn_bare_name_collision(name: text, existing_csv: text, new_csv: text):
    """Report a DIVERGENT same-bare-name enum registration.

    This table is keyed by the BARE enum name and is FIRST-WINS: the second
    registration is dropped on the floor. (MIR's parallel table is LAST-wins —
    the two engines resolve the same collision to opposite enums.) An identical
    re-registration is benign and stays quiet; only a differing variant set is
    reported, because only that can change which arm a `case` takes."""
    if existing_csv == new_csv:
        return
    var j = 0
    while j < _enum_collision_warned.len():
        if _enum_collision_warned[j] == name:
            return
        j = j + 1
    _enum_collision_warned.push(name)
    print "[WARN] enum '{name}' has co-compiled declarations with DIFFERENT variants ([{existing_csv}] vs [{new_csv}]); this table is keyed by the bare name and first-wins, so the second declaration is dropped and `case` arms against it silently match nothing. Rename the conflicting enum(s). [compiler_enum_bare_name_collision]"

fn enum_table_register(name: text, variants: [text]):
    if enum_hm_buckets.len() == 0:
        enum_hm_buckets = hm_make_global_buckets()
    val bucket = hm_hash_text(name) % HM_SIZE
    var idx = enum_hm_buckets[bucket]
    while idx != -1:
        if enum_reg_names[idx] == name:
            _enum_warn_bare_name_collision(name, enum_reg_variants[idx], variants.join(","))
            return
        idx = enum_hm_nexts[idx]
    val new_idx = enum_reg_names.len()
    enum_reg_names.push(name)
    enum_reg_variants.push(variants.join(","))
    enum_hm_nexts.push(enum_hm_buckets[bucket])
    enum_hm_buckets[bucket] = new_idx

fn enum_table_lookup(name: text) -> text:
    if enum_hm_buckets.len() == 0: return ""
    val bucket = hm_hash_text(name) % HM_SIZE
    var idx = enum_hm_buckets[bucket]
    while idx != -1:
        if enum_reg_names[idx] == name:
            return enum_reg_variants[idx]
        idx = enum_hm_nexts[idx]
    ""

fn enum_variant_is_declared(variant: text) -> bool:
    """True when some registered enum declares `variant`. Reverse of
    enum_table_lookup — match_pattern needs it to tell a nullary variant
    pattern (`case Red:`) apart from a binding pattern (`case other:`)."""
    if variant == "": return false
    var ei = 0
    while ei < enum_reg_names.len():
        if enum_reg_names[ei] != "":
            for v in enum_reg_variants[ei].split(","):
                if v == variant: return true
        ei = ei + 1
    false

fn enum_table_remove(name: text) -> bool:
    if enum_hm_buckets.len() == 0: return false
    val bucket = hm_hash_text(name) % HM_SIZE
    var prev: i64 = -1
    var idx = enum_hm_buckets[bucket]
    while idx != -1:
        if enum_reg_names[idx] == name:
            if prev == -1:
                enum_hm_buckets[bucket] = enum_hm_nexts[idx]
            else:
                enum_hm_nexts[prev] = enum_hm_nexts[idx]
            enum_reg_names[idx] = ""
            enum_reg_variants[idx] = ""
            return true
        prev = idx
        idx = enum_hm_nexts[idx]
    false

# ===== Phantom Struct Registry (Hash Map) =====
# Tracks struct names explicitly registered as phantom types.
# Uses chained hashing for O(1) average lookup (was O(n) linear scan).
var phantom_reg_names: [text] = []
var phantom_hm_buckets: [i64] = []
var phantom_hm_nexts: [i64] = []

fn phantom_struct_register(name: text):
    if phantom_hm_buckets.len() == 0:
        phantom_hm_buckets = hm_make_global_buckets()
    val bucket = hm_hash_text(name) % HM_SIZE
    var idx = phantom_hm_buckets[bucket]
    while idx != -1:
        if phantom_reg_names[idx] == name: return
        idx = phantom_hm_nexts[idx]
    val new_idx = phantom_reg_names.len()
    phantom_reg_names.push(name)
    phantom_hm_nexts.push(phantom_hm_buckets[bucket])
    phantom_hm_buckets[bucket] = new_idx

fn phantom_struct_is_registered(name: text) -> bool:
    if phantom_hm_buckets.len() == 0: return false
    val bucket = hm_hash_text(name) % HM_SIZE
    var idx = phantom_hm_buckets[bucket]
    while idx != -1:
        if phantom_reg_names[idx] == name: return true
        idx = phantom_hm_nexts[idx]
    false

fn phantom_reg_reset():
    phantom_reg_names = []
    phantom_hm_buckets = hm_make_global_buckets()
    phantom_hm_nexts = []

# ===== Match Exhaustiveness Helpers =====

fn match_arm_is_wildcard(pattern_eid: i64) -> bool:
    # Returns true if pattern_eid is a wildcard (_) or bare identifier (binding)
    # A pattern_eid < 0 means unconditional match
    if pattern_eid < 0: return true
    val e_node = expr_get(pattern_eid)
    val tag = e_node.tag
    if tag == EXPR_IDENT:
        val pname = e_node.s_val
        if pname == "_": return true
        # A bare identifier is a binding pattern — also catches all
        return true
    false

fn match_arm_get_enum_type(pattern_eid: i64) -> text:
    # Extracts enum type name from a pattern like Status.Ok (EXPR_FIELD_ACCESS)
    # Returns "" if pattern is not an enum variant pattern
    if pattern_eid < 0: return ""
    val e_node = expr_get(pattern_eid)
    val tag = e_node.tag
    if tag == EXPR_FIELD_ACCESS:
        val base_eid = e_node.left
        if base_eid >= 0:
            val base_node = expr_get(base_eid)
            if base_node.tag == EXPR_IDENT:
                return base_node.s_val
    ""

fn match_arm_get_variant_name(pattern_eid: i64) -> text:
    # Extracts variant name from a pattern like Status.Ok -> "Ok"
    if pattern_eid < 0: return ""
    val e_node = expr_get(pattern_eid)
    val tag = e_node.tag
    if tag == EXPR_FIELD_ACCESS:
        return e_node.s_val
    ""

fn check_match_exhaustive(arm_ids: [i64], type_name: text):
    # Check if match arms cover all variants of the given enum type.
    # Emits a warning if variants are missing and no wildcard present.
    if type_name == "": return
    val variants_csv = enum_table_lookup(type_name)
    if variants_csv == "": return

    # Check if any arm is a wildcard (catches all)
    var has_wildcard: bool = false
    for arm_id in arm_ids:
        val pattern_eid = arm_get_pattern(arm_id)
        if match_arm_is_wildcard(pattern_eid):
            has_wildcard = true
    if has_wildcard: return

    # Collect covered variant names from arms
    var covered: [text] = []
    for arm_id in arm_ids:
        val pattern_eid = arm_get_pattern(arm_id)
        val variant = match_arm_get_variant_name(pattern_eid)
        if variant != "":
            covered.push(variant)

    # Split variants_csv into individual variants
    var all_variants: [text] = []
    var chars: [text] = []
    var ci2: i64 = 0
    for _c2 in variants_csv:
        if ci2 >= variants_csv.len(): break
        val ch2 = variants_csv[ci2]
        if ch2 == ",":
            if chars.len() > 0:
                all_variants.push(chars.join(""))
                chars = []
        else:
            chars.push(ch2)
        ci2 = ci2 + 1
    if chars.len() > 0:
        all_variants.push(chars.join(""))

    # Find missing variants
    var missing: [text] = []
    for variant in all_variants:
        var found: bool = false
        for cov in covered:
            if cov == variant:
                found = true
        if found == false:
            missing.push(variant)

    if missing.len() > 0:
        var msg = "warning: non-exhaustive match on '" + type_name + "' — missing: "
        var mi: i64 = 0
        for mv in missing:
            if mi > 0:
                msg = msg + ", "
            msg = msg + mv
            mi = mi + 1
        eval_warnings.push(msg)

# ===== Match Fall-Through Diagnostic (BUG-2026-08-01-match-fallthrough) =====
#
# A `match` on an enum where NO arm fires used to take no branch and emit no
# diagnostic: the statement form was a silent no-op, the expression form
# silently produced nil (which reads back as the integer 3 under the nil-sentinel
# encoding). That made a real layout bug invisible for a whole lane — the
# frontier was built by a match that matched nothing, so every downstream stage
# correctly reported "nothing dirty" and the first isolation blamed the wrong
# component.
#
# The static exhaustiveness check CANNOT catch the important case. In the
# reproduced instance the arms textually covered every variant; the value's
# variant tag came from a DIFFERENT enum of the same bare name, resolved through
# the global bare-name registry. Any compile-time checker built on that same
# registry is looking at the wrong enum. So the runtime report is the
# load-bearing half, and it must say so out loud — hence the collision note.
#
# Default mode is WARN (behaviour unchanged, diagnostic added). Callers that
# want a hard stop opt in via match_fallthrough_set_abort(true).

var match_fallthrough_abort: bool = false

fn match_fallthrough_set_abort(enabled: bool):
    """Opt in to hard-failing on a match fall-through instead of warning."""
    match_fallthrough_abort = enabled

fn match_fallthrough_get_abort() -> bool:
    match_fallthrough_abort

fn match_fallthrough_message(
    type_name: text,
    variant: text,
    kind_name: text,
    covered: [text],
    where_path: text
) -> text:
    """Build the fall-through diagnostic.

    Names the enum, the runtime value, the source location and the arms that
    WERE covered. A message that only said "no arm matched" would not have
    shortened the investigation this defect caused, so all four are required.
    """
    var enum_label = type_name
    if enum_label == "":
        enum_label = "<unresolved enum>"
    var value_label = variant
    if value_label == "":
        value_label = "<" + kind_name + " value>"

    var msg = "error: non-exhaustive match: no arm matched value '" + value_label
    msg = msg + "' of enum '" + enum_label + "' (runtime kind: " + kind_name + ")"
    if where_path != "":
        msg = msg + " at " + where_path
    if covered.len() > 0:
        var ci: i64 = 0
        msg = msg + "; arms cover: "
        for cv in covered:
            if ci > 0:
                msg = msg + ", "
            msg = msg + cv
            ci = ci + 1
    else:
        msg = msg + "; no arm covered any variant"

    # The collision hint. When the variant NAME appears in the covered list the
    # arms are textually exhaustive, so the mismatch is one of identity, not
    # coverage — that is the bare-name-registry collision, and saying it here is
    # the whole point of this diagnostic.
    var textually_covered: bool = false
    for cv2 in covered:
        if cv2 == value_label:
            textually_covered = true
    if textually_covered:
        msg = msg + "\n  = note: '" + value_label + "' IS named by an arm, so this is a"
        msg = msg + " bare-name collision: the value's enum is not the enum the arms name."
        msg = msg + " Check for another declaration of '" + enum_label + "' or of '"
        msg = msg + value_label + "' reachable through the global name registry."
    else:
        msg = msg + "\n  = help: add 'case " + value_label + ":' or a wildcard 'case _:' arm"
    msg

fn match_arm_covered_variants(arm_ids: [i64]) -> [text]:
    """Variant names named by the match arms, for the fall-through diagnostic."""
    var covered: [text] = []
    for arm_id in arm_ids:
        val pattern_eid = arm_get_pattern(arm_id)
        val variant = match_arm_get_variant_name(pattern_eid)
        if variant != "":
            covered.push(variant)
    covered

fn report_match_fallthrough(
    type_name: text,
    variant: text,
    kind_name: text,
    arm_ids: [i64]
):
    """Emit the fall-through diagnostic through the interpreter warning channel."""
    val covered = match_arm_covered_variants(arm_ids)
    val msg = match_fallthrough_message(
        type_name, variant, kind_name, covered, module_get_path()
    )
    eval_warnings.push(msg)

# ===== Match Wildcard-Catch Diagnostic (BUG-2026-08-01-match-fallthrough follow-up) =====
#
# A wildcard/bare-binder arm (`case _:`, a bare lowercase binder such as
# `other:`, or `_ => expr`) on an enum scrutinee silently absorbs ANY variant,
# including ones added to the enum after the match was written. For
# mission-critical code that defeats exhaustiveness the same way a missing arm
# does: six months from now a new variant is added, and this match keeps
# compiling and keeps running, just always through the catch-all, with nobody
# told a new case exists to consider.
#
# Sound for the same reason report_match_fallthrough is sound: the caller
# supplies the actually-resolved enum value and variant (read off the runtime
# value, via val_enum_variant_name), not a bare-name-registry guess. "Is this
# PATTERN a wildcard" is answered from the pattern's own AST shape (see
# pattern_is_wildcard_catch in eval.spl), independent of that registry too.
#
# Default is OFF (no diagnostic at all, current behaviour unchanged). A caller
# opts in via match_wildcard_catch_set_enabled(true) -- wired in eval_decls.spl
# eval_init() the same way match_fallthrough_set_abort is, from
# SIMPLE_SAFETY_PROFILE. Warn-only: there is no abort variant of this one (yet
# -- see the TODO at the MIR no-default path in switch_operators_calls.spl).

var match_wildcard_catch_enabled: bool = false

fn match_wildcard_catch_set_enabled(enabled: bool):
    """Opt in to reporting a wildcard/bare-binder arm catching an enum value."""
    match_wildcard_catch_enabled = enabled

fn match_wildcard_catch_get_enabled() -> bool:
    match_wildcard_catch_enabled

fn match_wildcard_catch_message(
    type_name: text,
    variant: text,
    kind_name: text,
    where_path: text
) -> text:
    """Build the wildcard-catch diagnostic. Pure, testable."""
    var enum_label = type_name
    if enum_label == "":
        enum_label = "<unresolved enum>"
    var value_label = variant
    if value_label == "":
        value_label = "<" + kind_name + " value>"
    var msg = "[match-wildcard-catch] value '" + value_label + "' of enum '" + enum_label
    msg = msg + "' was caught by a wildcard arm"
    if where_path != "":
        msg = msg + " at " + where_path
    msg = msg + " -- new variants added to '" + enum_label + "' will not be individually diagnosed here"
    msg

fn report_match_wildcard_catch(type_name: text, variant: text, kind_name: text):
    """Emit the wildcard-catch diagnostic, gated by match_wildcard_catch_get_enabled()."""
    if match_wildcard_catch_get_enabled() == false: return
    val msg = match_wildcard_catch_message(type_name, variant, kind_name, module_get_path())
    eval_warnings.push(msg)

fn infer_match_enum_type(arm_ids: [i64]) -> text:
    # Try to infer enum type from match arms by looking for EXPR_FIELD_ACCESS patterns
    for arm_id in arm_ids:
        val pattern_eid = arm_get_pattern(arm_id)
        val etype = match_arm_get_enum_type(pattern_eid)
        if etype != "":
            return etype
    ""
