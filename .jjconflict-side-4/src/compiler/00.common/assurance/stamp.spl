# AssuranceStampV1 — FROZEN SCHEMA (WP-0, 2026-08-07).
#
# What a BUILT OBJECT carries so that a linker, a loader, an inspector or a
# release gate can decide about it WITHOUT re-running the compiler. Consumers
# per the plan: the per-object note (WP-20), `SimpleArtifactManifest` (WP-19),
# the critical linker, the SimpleOS loader (WP-21) and `simple inspect
# --assurance` (WP-22).
#
# Reachability, stated honestly: none of those consumers exists today. The
# artifact manifest has zero production callers and the loader enforces no
# signature, hash, ceiling or assurance concept (plan premises 16, 19 — 19 is
# marked *refuted*: `cap_exec_gate.spl:24` never denies because every
# production call site passes the `caller = 0` sentinel). This schema is the
# frozen shape those WPs will fill; it is not evidence that anything is
# enforced.

use compiler.common.assurance.flight_rules.{assurance_text_hash}

# Summary of the extern/native provider closure of one object. Counts, not
# names, because the stamp travels with the object and must stay small; the
# full manifest lives beside it.
struct ExternProviderSummaryV1:
    """Extern/provider closure counts for one object.

    - declared: `extern fn` declarations reachable from this object.
    - resolved: those bound to exactly one qualified provider.
    - unbacked: declared with NO provider at all.
    - ambiguous: bound to more than one incompatible provider.
    - weak_fabricated: providers synthesized by the toolchain rather than
      supplied by a real implementation. Named explicitly because the
      freestanding linker fabricates ~4023 weak NIL-returning stubs so the
      link can never fail (`70.backend/.../llvm_native_link.spl:2541`) — a
      flight closure must show 0 here (FLT-ABS-008).
    - providers: qualified provider ids contributing to this object.
    """
    declared: i64
    resolved: i64
    unbacked: i64
    ambiguous: i64
    weak_fabricated: i64
    providers: [text]

impl ExternProviderSummaryV1:
    static fn empty() -> ExternProviderSummaryV1:
        ExternProviderSummaryV1(declared: 0, resolved: 0, unbacked: 0,
            ambiguous: 0, weak_fabricated: 0, providers: [])

    fn is_closed() -> bool:
        if self.unbacked != 0:
            return false
        if self.ambiguous != 0:
            return false
        if self.weak_fabricated != 0:
            return false
        self.resolved == self.declared

    fn canonical_text() -> text:
        val provs = self.providers.join(";")
        ("declared=" + self.declared.to_text()
            + ",resolved=" + self.resolved.to_text()
            + ",unbacked=" + self.unbacked.to_text()
            + ",ambiguous=" + self.ambiguous.to_text()
            + ",weak_fabricated=" + self.weak_fabricated.to_text()
            + ",providers=" + provs)

# ============================================================================
# AssuranceStampV1 — FROZEN SCHEMA.
# ============================================================================
struct AssuranceStampV1:
    """The assurance identity of a built object.

    Fields:
    - preset: the convention it was built under, e.g. `flight-core-v1`.
    - policy_hash: ResolvedAssurancePolicyV1.policy_hash() of the build. Two
      objects with different values here were built under different policies
      and must not be linked together.
    - rule_set_hash: flight_rules_hash() — which registry version applied.
    - compiler_hash: identity of the compiler binary that produced the object.
      NOT a version string: a version string cannot distinguish two builds of
      the same version, and this repo has repeatedly been misled by a stale
      deployed binary reporting a fresh version.
    - source_hash: content hash of the compiled sources.
    - error_count / warning_count: diagnostics at build time. A release build
      requires BOTH to be 0 — warnings in a release build are a gate failure.
    - externs: extern/provider closure summary.
    """
    preset: text
    policy_hash: text
    rule_set_hash: text
    compiler_hash: text
    source_hash: text
    error_count: i64
    warning_count: i64
    externs: ExternProviderSummaryV1

impl AssuranceStampV1:
    fn canonical_text() -> text:
        ("AssuranceStampV1"
            + "|preset=" + self.preset
            + "|policy=" + self.policy_hash
            + "|rules=" + self.rule_set_hash
            + "|compiler=" + self.compiler_hash
            + "|source=" + self.source_hash
            + "|errors=" + self.error_count.to_text()
            + "|warnings=" + self.warning_count.to_text()
            + "|externs=" + self.externs.canonical_text())

    fn stamp_hash() -> text:
        "ASTMPV1-" + assurance_text_hash(self.canonical_text())

    # Two objects may be linked into one flight image only when they agree on
    # policy AND rule set. Compiler and source hashes are allowed to differ —
    # separate compilation is legitimate.
    fn link_compatible_with(other: AssuranceStampV1) -> bool:
        if self.preset != other.preset:
            return false
        if self.policy_hash != other.policy_hash:
            return false
        self.rule_set_hash == other.rule_set_hash

    # Release admissibility of THIS object in isolation. Deliberately strict:
    # warnings count as failures.
    fn release_clean() -> bool:
        if self.error_count != 0:
            return false
        if self.warning_count != 0:
            return false
        self.externs.is_closed()
