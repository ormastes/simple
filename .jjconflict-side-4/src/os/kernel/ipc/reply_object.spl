# Kernel reply object / reply capability — L4-seL4 call/reply/notify semantics.
#
# STATUS: MECHANISM + SPECS ONLY — the live syscall path is NOT yet wired to it.
#
# This module supplies the piece the master plan's `ipc:` row calls out as
# missing: a real REPLY OBJECT. In seL4 terms, a `Call` on an endpoint creates a
# single-use reply capability that is handed to the receiver; the receiver
# performs exactly ONE `Reply` on it, which unblocks the caller and destroys the
# reply cap. A second reply is denied. A notification is non-blocking, mints NO
# reply cap, and can never be replied to. If the caller dies while blocked, the
# reply capability is INVALIDATED (burnt) rather than left dangling.
#
# What is real here:
#   - the reply-object lifecycle (mint / one-shot consume / invalidate),
#   - the call vs. notification distinction and the reply-to-non-call refusal,
#   - attenuated, deny-wins, ATOMIC capability transfer riding on the reply.
#
# What is NOT here (documented blocked row, see .spipe/ipc_reply_object/state.md):
#   - wiring into `_handle_ipc_send` / `_handle_ipc_recv` in
#     `os.kernel.ipc.syscall_ipc`, which needs the two-process QEMU call/reply
#     evidence run to be admissible. Nothing in this file is reachable from a
#     live boot path, and the boot seal is untouched.
#
# §4 no-second-envelope: the one-shot guard is NOT reimplemented here. It is
# `SingleUseLedger` from `os.kernel.ipc.cspace_spawn` — the same Lean-proven
# arm/consume mechanism used for single-use capability grants. `ReplyTable` holds
# TWO INSTANCES of that one class (reply caps vs. transferred handles) purely to
# keep the two id spaces disjoint; that is one mechanism, two ledgers, not two
# mechanisms. Capability transfer likewise reuses `spawn_with_cspace_tracked` for
# the monotonic parent-authority + attenuation check rather than re-deriving it.

use os.kernel.types.capability_types.{CapabilityToken, CapabilityKind, CapabilitySet, capability_kind_allows}
use os.kernel.ipc.cspace_spawn.{SingleUseLedger, AttenuationSpec, CapGrant, SpawnSpec, CspaceMint, spawn_with_cspace_tracked, atten_identity, atten_rights}

# ============================================================================
# Status codes
# ============================================================================

val REPLY_OK: i64                     = 0
val REPLY_ERR_NO_SUCH: i64            = -1   # unknown invocation id
val REPLY_ERR_ALREADY_REPLIED: i64    = -2   # one-shot already spent (replay)
val REPLY_ERR_NOT_A_CALL: i64         = -3   # reply attempted on a notification
val REPLY_ERR_CALLER_DEAD: i64        = -4   # reply cap invalidated by caller death
val REPLY_ERR_WRONG_RECEIVER: i64     = -5   # replier is not the designated receiver
val REPLY_ERR_RIGHTS_ESCALATION: i64  = -6   # transfer asked for authority the sender lacks
val REPLY_ERR_BAD_TRANSFER: i64       = -7   # malformed transfer descriptor

# Internal invocation kind codes (i64 in the table; the enum is the public face).
val INV_KIND_CALL: i64         = 0
val INV_KIND_NOTIFICATION: i64 = 1
val INV_KIND_NONE: i64         = -1

enum IpcInvocationKind:
    """How an invocation was made — decides whether a reply is even meaningful."""
    Call            # blocking; mints a single-use reply capability
    Notification    # non-blocking; mints NO reply capability, can never be replied to
    Unknown         # no such invocation id

# ============================================================================
# Transfer descriptor
# ============================================================================

struct ReplyTransfer:
    """Capabilities that ride along with a reply, each with its own attenuation.

    `kinds[i]` is the authority the REPLIER wants the caller to end up holding;
    `attens[i]` narrows it further (rights mask / path prefix / depth / one-shot).
    Empty arrays = a plain reply with no handle transfer.

    Deny-wins: every entry must be authorized by a concrete token the REPLIER
    actually holds (`capability_kind_allows` + delegation budget). The receiver
    can never gain rights the sender lacked, and never widen them.

    Atomicity: the whole descriptor is all-or-nothing. A batch containing ONE
    unauthorized entry transfers NOTHING and leaves the reply capability unspent.
    """
    kinds: [CapabilityKind]
    attens: [AttenuationSpec]

fn reply_no_handles() -> ReplyTransfer:
    """A plain reply — no capability rides along."""
    ReplyTransfer(kinds: [], attens: [])

fn reply_with_handle(kind: CapabilityKind, atten: AttenuationSpec) -> ReplyTransfer:
    """A reply carrying exactly one attenuated capability."""
    ReplyTransfer(kinds: [kind], attens: [atten])

fn reply_with_handles(kinds: [CapabilityKind], attens: [AttenuationSpec]) -> ReplyTransfer:
    """A reply carrying several attenuated capabilities (all-or-nothing)."""
    ReplyTransfer(kinds: kinds, attens: attens)

# ============================================================================
# Outcomes
# ============================================================================

struct CallHandle:
    """Result of `ReplyTable.call()` — the caller's side of a blocking Call."""
    reply_id: u64        # the reply-object id handed to the receiver (0 on failure)
    caller_blocked: bool # true: a Call blocks awaiting the reply
    status: i64

struct NotifyHandle:
    """Result of `ReplyTable.notify()` — non-blocking, no reply object."""
    invocation_id: u64   # recorded so a reply attempt is REFUSED, not merely unknown
    caller_blocked: bool # always false: notification never blocks
    status: i64

struct ReplyOutcome:
    """Result of `ReplyTable.reply()`.

    On any non-zero `status` NOTHING mutated: `replied` is false, the reply
    capability is still spendable (unless the failure IS the one-shot/death
    guard), and `receiver_caps` is byte-for-byte the set that was passed in.
    """
    status: i64
    replied: bool
    caller_unblocked: bool
    transferred: i64             # number of capabilities that moved (0 on failure)
    receiver_caps: CapabilitySet # post-transfer receiver set; INPUT set unchanged on failure
    first_token_id: u64          # token_id of the first transferred handle (0 if none)

# ============================================================================
# ReplyTable — the kernel-side reply object registry
# ============================================================================

class ReplyTable:
    """Registry of in-flight IPC invocations and their reply objects.

    One row per invocation. A `Call` row owns a single-use reply capability
    (id == the row id) armed in `reply_ledger`; a `Notification` row owns none.

    Two `SingleUseLedger` INSTANCES of the single one-shot mechanism:
      reply_ledger — arms/consumes reply capabilities (ids from `next_id`),
      mint_ledger  — arms/consumes `single_use` TRANSFERRED handles (ids from
                     `next_token_id`).
    Separate instances keep the two id spaces from colliding; the enforcement
    logic is the shared, already-proven `SingleUseLedger`.
    """
    inv_ids: [u64]
    inv_kinds: [i64]
    inv_callers: [u64]
    inv_receivers: [u64]
    inv_valid: [bool]       # false once the caller died (reply cap invalidated)
    inv_blocked: [bool]     # caller currently blocked awaiting reply
    next_id: u64
    next_token_id: u64
    next_generation: u64
    reply_ledger: SingleUseLedger
    mint_ledger: SingleUseLedger

impl ReplyTable:
    static fn new() -> ReplyTable:
        ReplyTable(
            inv_ids: [],
            inv_kinds: [],
            inv_callers: [],
            inv_receivers: [],
            inv_valid: [],
            inv_blocked: [],
            next_id: 1u64,
            next_token_id: 9000u64,
            next_generation: 500u64,
            reply_ledger: SingleUseLedger.new(),
            mint_ledger: SingleUseLedger.new()
        )

    fn _index_of(inv_id: u64) -> i64:
        var i = 0
        while i < self.inv_ids.len():
            if self.inv_ids[i] == inv_id:
                return i.to_i64()
            i = i + 1
        -1

    # ------------------------------------------------------------------
    # Invocation entry points
    # ------------------------------------------------------------------

    me call(caller: u64, receiver: u64) -> CallHandle:
        """Blocking Call: record the invocation, MINT a single-use reply
        capability for `receiver`, and mark the caller blocked.

        The reply capability is armed in `reply_ledger`, so exactly one
        `reply()` can ever spend it."""
        val id = self.next_id
        self.inv_ids.push(id)
        self.inv_kinds.push(INV_KIND_CALL)
        self.inv_callers.push(caller)
        self.inv_receivers.push(receiver)
        self.inv_valid.push(true)
        self.inv_blocked.push(true)
        self.next_id = id + 1u64
        # extract-mutate-write-back: a mutating call through a field hop is not
        # reliably observed on the interpreter.
        var led = self.reply_ledger
        led.arm(id)
        self.reply_ledger = led
        CallHandle(reply_id: id, caller_blocked: true, status: REPLY_OK)

    me notify(caller: u64, receiver: u64) -> NotifyHandle:
        """Non-blocking Notification: NO reply capability is minted and the
        caller does not block. The row is still recorded so that a reply attempt
        against it is explicitly REFUSED (REPLY_ERR_NOT_A_CALL) rather than
        silently mistaken for an unknown id."""
        val id = self.next_id
        self.inv_ids.push(id)
        self.inv_kinds.push(INV_KIND_NOTIFICATION)
        self.inv_callers.push(caller)
        self.inv_receivers.push(receiver)
        self.inv_valid.push(true)
        self.inv_blocked.push(false)
        self.next_id = id + 1u64
        NotifyHandle(invocation_id: id, caller_blocked: false, status: REPLY_OK)

    # ------------------------------------------------------------------
    # Observers
    # ------------------------------------------------------------------

    fn kind_of(inv_id: u64) -> IpcInvocationKind:
        val idx = self._index_of(inv_id)
        if idx < 0:
            return IpcInvocationKind.Unknown
        if self.inv_kinds[idx.to_i32()] == INV_KIND_CALL:
            return IpcInvocationKind.Call
        IpcInvocationKind.Notification

    fn is_caller_blocked(inv_id: u64) -> bool:
        val idx = self._index_of(inv_id)
        if idx < 0:
            return false
        self.inv_blocked[idx.to_i32()]

    fn has_reply_cap(inv_id: u64) -> bool:
        """True while a live, unspent reply capability exists for `inv_id`."""
        val idx = self._index_of(inv_id)
        if idx < 0:
            return false
        if self.inv_kinds[idx.to_i32()] != INV_KIND_CALL:
            return false
        if not self.inv_valid[idx.to_i32()]:
            return false
        not self.reply_ledger.is_consumed(inv_id)

    fn reply_cap_spent(inv_id: u64) -> bool:
        self.reply_ledger.is_consumed(inv_id)

    fn live_reply_cap_count() -> i64:
        var n: i64 = 0
        var i = 0
        while i < self.inv_ids.len():
            if self.inv_kinds[i] == INV_KIND_CALL:
                if self.inv_valid[i]:
                    if not self.reply_ledger.is_consumed(self.inv_ids[i]):
                        n = n + 1
            i = i + 1
        n

    # ------------------------------------------------------------------
    # Caller death
    # ------------------------------------------------------------------

    me mark_task_dead(task: u64) -> i64:
        """Caller death INVALIDATES every reply capability that named it.

        The reply object is not left dangling: the row is marked invalid AND the
        one-shot is BURNT in `reply_ledger`, so no later `reply()` can spend it.
        Returns the number of reply capabilities invalidated."""
        var burnt: i64 = 0
        var led = self.reply_ledger
        var i = 0
        while i < self.inv_ids.len():
            if self.inv_callers[i] == task:
                if self.inv_kinds[i] == INV_KIND_CALL:
                    if self.inv_valid[i]:
                        self.inv_valid[i] = false
                        self.inv_blocked[i] = false
                        if led.consume(self.inv_ids[i]):
                            burnt = burnt + 1
            i = i + 1
        self.reply_ledger = led
        burnt

    # ------------------------------------------------------------------
    # Reply
    # ------------------------------------------------------------------

    me reply(inv_id: u64, replier: u64, sender_caps: CapabilitySet, receiver_caps: CapabilitySet, transfer: ReplyTransfer) -> ReplyOutcome:
        """Consume the reply capability `inv_id`, optionally moving attenuated
        capabilities from `sender_caps` (the REPLIER) into `receiver_caps` (the
        blocked CALLER), and unblock the caller.

        Every rejection path returns BEFORE any state changes, so a failed reply
        leaves neither side mutated: the reply capability stays spendable, the
        caller stays blocked, and `receiver_caps` is returned unchanged.
        """
        val fail = ReplyOutcome(
            status: REPLY_OK, replied: false, caller_unblocked: false,
            transferred: 0, receiver_caps: receiver_caps, first_token_id: 0u64
        )

        # --- Phase 1: validate, mutate nothing ---------------------------
        if transfer.kinds.len() != transfer.attens.len():
            return _with_status(fail, REPLY_ERR_BAD_TRANSFER)

        val idx64 = self._index_of(inv_id)
        if idx64 < 0:
            return _with_status(fail, REPLY_ERR_NO_SUCH)
        val idx = idx64.to_i32()

        if self.inv_kinds[idx] != INV_KIND_CALL:
            # A notification carries no reply object — replying to it is refused.
            return _with_status(fail, REPLY_ERR_NOT_A_CALL)

        if not self.inv_valid[idx]:
            # Caller died: the reply capability was invalidated, not dangling.
            return _with_status(fail, REPLY_ERR_CALLER_DEAD)

        if self.reply_ledger.is_consumed(inv_id):
            # The single-use guard: a SECOND reply is denied.
            return _with_status(fail, REPLY_ERR_ALREADY_REPLIED)

        if self.inv_receivers[idx] != replier:
            return _with_status(fail, REPLY_ERR_WRONG_RECEIVER)

        # --- Phase 2: TRIAL mint of the handle transfer ------------------
        # Reuses spawn_with_cspace_tracked for the monotonic parent-authority
        # and attenuation checks (no second attenuation engine). The trial runs
        # against a THROWAWAY ledger so a partially-authorized batch cannot arm
        # any one-shot before we know the whole batch is admissible — that is
        # what makes the transfer atomic.
        val caller_tid = self.inv_callers[idx]
        var trial_caps = receiver_caps
        var moved: i64 = 0
        var first_tid: u64 = 0u64
        var commit_gen = self.next_generation
        var commit_tid = self.next_token_id

        if transfer.kinds.len() > 0:
            val spec = _transfer_spec(transfer)
            val trial = spawn_with_cspace_tracked(
                sender_caps, spec, caller_tid,
                self.next_generation, self.next_token_id, SingleUseLedger.new()
            )
            if trial.rejected > 0:
                # Deny-wins: the replier does not hold (or cannot narrow to) at
                # least one requested authority. Transfer NOTHING, spend NOTHING.
                return _with_status(fail, REPLY_ERR_RIGHTS_ESCALATION)

            # --- Phase 3: COMMIT (identical mint, real ledger) ------------
            var mint_led = self.mint_ledger
            val minted = spawn_with_cspace_tracked(
                sender_caps, spec, caller_tid,
                self.next_generation, self.next_token_id, mint_led
            )
            self.mint_ledger = mint_led

            var merged: [CapabilityToken] = []
            for c in receiver_caps.caps:
                merged.push(c)
            for c in minted.caps.caps:
                merged.push(c)
            if minted.caps.caps.len() > 0:
                first_tid = minted.caps.caps[0].token_id
            moved = minted.caps.caps.len().to_i64()
            commit_gen = minted.next_generation
            commit_tid = minted.next_token_id
            trial_caps = CapabilitySet(caps: merged, is_pledged: receiver_caps.is_pledged)

        # --- Phase 4: spend the one-shot and unblock ---------------------
        var led = self.reply_ledger
        val spent = led.consume(inv_id)
        self.reply_ledger = led
        if not spent:
            # Unreachable given the Phase-1 guard; fail closed rather than
            # reporting a reply that did not happen.
            return _with_status(fail, REPLY_ERR_ALREADY_REPLIED)

        self.inv_blocked[idx] = false
        self.next_generation = commit_gen
        self.next_token_id = commit_tid

        ReplyOutcome(
            status: REPLY_OK,
            replied: true,
            caller_unblocked: true,
            transferred: moved,
            receiver_caps: trial_caps,
            first_token_id: first_tid
        )

# ============================================================================
# Helpers
# ============================================================================

fn _with_status(base: ReplyOutcome, status: i64) -> ReplyOutcome:
    ReplyOutcome(
        status: status,
        replied: false,
        caller_unblocked: false,
        transferred: 0,
        receiver_caps: base.receiver_caps,
        first_token_id: 0u64
    )

fn _transfer_spec(transfer: ReplyTransfer) -> SpawnSpec:
    """Express a reply's handle transfer as a one-shot SpawnSpec recipe so the
    already-proven `spawn_with_cspace_tracked` monotonic guard does the work."""
    var grants: [CapGrant] = []
    var i = 0
    while i < transfer.kinds.len():
        grants.push(CapGrant(
            label: "ipc.reply.handle",
            requested: transfer.kinds[i],
            atten: transfer.attens[i]
        ))
        i = i + 1
    SpawnSpec(image_hash: "", grants: grants, isolation: "ipc.reply", budget: 0u64)
