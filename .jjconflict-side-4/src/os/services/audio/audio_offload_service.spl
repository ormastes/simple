# Pure-Simple SimpleOS owner for the second QEMU ivshmem audio device.

use os.kernel.ipc.host_gpu_ivshmem_map.{map_qemu_audio_ivshmem_bar2, qemu_audio_ivshmem_window_base}
use os.lib.audio_offload.ivshmem_protocol.*
use os.kernel.boot.monotonic_hardware.{boot_monotonic_now_us}

val SIMPLEOS_AUDIO_OFFLOAD_CAPACITY: i64 = 8

var g_simpleos_audio_offload_base: u64 = 0u64
var g_simpleos_audio_offload_started: bool = false

fn simpleos_audio_offload_start() -> text:
    if g_simpleos_audio_offload_started:
        return "ready"
    val mapped = map_qemu_audio_ivshmem_bar2()
    if mapped <= 0:
        return "audio-ivshmem-unavailable"
    val base = qemu_audio_ivshmem_window_base(mapped)
    if base == 0u64:
        return "audio-ivshmem-map-failed"
    val initialized = simple_audio_ivshmem_initialize(base, SIMPLEOS_AUDIO_OFFLOAD_CAPACITY)
    if initialized != "ready":
        return initialized
    g_simpleos_audio_offload_base = base
    g_simpleos_audio_offload_started = true
    "ready"

fn simpleos_audio_offload_submit_q15(slot: i64, generation: u64, sequence: u64, correlation_id: u64, period_index: u64, period_duration_ns: u64, frames: i64, channels: i64, operation_code: i64, input: [u32], kernel: [u32], cpu_checksum: i64) -> text:
    if not g_simpleos_audio_offload_started:
        return "audio-offload-not-started"
    val now_us = boot_monotonic_now_us()
    if now_us <= 0 or period_duration_ns < 10u64:
        return "invalid-clock"
    val now_ns = (now_us as u64) * 1000u64
    val deadline_ns = now_ns + (period_duration_ns * 3u64) / 5u64
    simple_audio_ivshmem_publish_q15(g_simpleos_audio_offload_base, slot, SIMPLEOS_AUDIO_OFFLOAD_CAPACITY, generation, sequence, correlation_id, period_index, deadline_ns, frames, channels, operation_code, input, kernel, cpu_checksum)

fn simpleos_audio_offload_poll(slot: i64, expected_generation: u64, expected_correlation: u64, deadline_ns: u64) -> text:
    if not g_simpleos_audio_offload_started:
        return "audio-offload-not-started"
    val now_us = boot_monotonic_now_us()
    if now_us <= 0:
        return "invalid-clock"
    val completion = simple_audio_ivshmem_poll(g_simpleos_audio_offload_base, slot, SIMPLEOS_AUDIO_OFFLOAD_CAPACITY)
    simple_audio_ivshmem_completion_status(completion, expected_generation, expected_correlation, (now_us as u64) * 1000u64, deadline_ns)

fn simpleos_audio_offload_release(slot: i64, generation: u64) -> text:
    if not g_simpleos_audio_offload_started:
        return "audio-offload-not-started"
    simple_audio_ivshmem_release(g_simpleos_audio_offload_base, slot, SIMPLEOS_AUDIO_OFFLOAD_CAPACITY, generation)

fn simpleos_audio_offload_stop():
    g_simpleos_audio_offload_started = false
    g_simpleos_audio_offload_base = 0u64

fn simpleos_audio_offload_started() -> bool:
    g_simpleos_audio_offload_started

export SIMPLEOS_AUDIO_OFFLOAD_CAPACITY
export simpleos_audio_offload_start, simpleos_audio_offload_submit_q15
export simpleos_audio_offload_poll, simpleos_audio_offload_release
export simpleos_audio_offload_stop, simpleos_audio_offload_started
