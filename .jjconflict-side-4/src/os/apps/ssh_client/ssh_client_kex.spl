#![allow(unnamed_duplicate_typed_args)]
# SSH client key exchange — curve25519-sha256 with ssh-ed25519 host keys.
#
# Direction-asymmetric half: the client BUILDS SSH_MSG_KEX_ECDH_INIT and
# PARSES SSH_MSG_KEX_ECDH_REPLY (sshd does the mirror image), and the client
# is the only side that VERIFIES a host-key signature over the exchange hash.
#
# Everything below the message layer is reused, not reimplemented:
#   X25519 / exchange hash / key derivation -> os.apps.sshd.ssh_kex_core
#   SSH string+mpint codec                  -> os.apps.sshd.ssh_packet
#   ed25519 verification                    -> os.crypto.ed25519

use os.apps.sshd.ssh_packet.{ssh_put_string, ssh_get_string, ssh_get_text, SshStringResult, SshTextResult}
use os.apps.sshd.ssh_kex_core.{
    ssh_kex_public_from_private, ssh_kex_compute_shared,
    ssh_kex_compute_exchange_hash, ssh_derive_keys
}
use os.apps.sshd.ssh_kex_primitives.{SshSessionKeys}
use os.apps.ssh_client.ssh_known_hosts.{SshKnownHostsDb, ssh_known_hosts_verify}
use os.crypto.ed25519.{ed25519_verify}

extern fn rt_bytes_u8_at(arr: [u8], idx: i64) -> i64

val SSH_MSG_KEX_ECDH_INIT_C: u8 = 30
val SSH_MSG_KEX_ECDH_REPLY_C: u8 = 31
val SSH_MSG_NEWKEYS_C: u8 = 21

struct SshKexEcdhReply:
    """Decoded SSH_MSG_KEX_ECDH_REPLY."""
    host_key_blob: [u8]
    server_public: [u8]
    signature_blob: [u8]

struct SshClientKexResult:
    """Completed client key exchange."""
    algorithm: text          # host key algorithm actually verified
    exchange_hash: [u8]      # H — also the session id for the first KEX
    session_id: [u8]
    host_key_blob: [u8]
    keys: SshSessionKeys

fn _sshcli_u8_at(data: [u8], idx: u64) -> u8:
    rt_bytes_u8_at(data, idx.to_i64()).to_u8()

fn _sshcli_copy(data: [u8]) -> [u8]:
    var out: [u8] = []
    var i: u64 = 0
    while i < data.len():
        out.push(_sshcli_u8_at(data, i))
        i = i + 1
    out

fn ssh_client_build_kex_ecdh_init(client_public: [u8]) -> Result<[u8], text>:
    """Build SSH_MSG_KEX_ECDH_INIT carrying Q_C."""
    if client_public.len() != 32:
        return Err("KEX_ECDH_INIT: client public key must be 32 bytes")
    var buf: [u8] = []
    buf.push(SSH_MSG_KEX_ECDH_INIT_C)
    buf = ssh_put_string(buf, client_public)
    Ok(buf)

fn ssh_client_parse_kex_ecdh_reply(data: [u8]) -> Result<SshKexEcdhReply, text>:
    """Parse SSH_MSG_KEX_ECDH_REPLY: K_S, Q_S, sig(H). Fails closed on any
    truncation or on a Q_S that is not a 32-byte X25519 point."""
    if data.len() < 2:
        return Err("KEX_ECDH_REPLY: too short")
    if _sshcli_u8_at(data, 0) != SSH_MSG_KEX_ECDH_REPLY_C:
        return Err("KEX_ECDH_REPLY: wrong message type")

    val ks: SshStringResult = ssh_get_string(data, 1)?
    val qs: SshStringResult = ssh_get_string(data, ks.next_offset)?
    val sig: SshStringResult = ssh_get_string(data, qs.next_offset)?

    if ks.data.len() == 0:
        return Err("KEX_ECDH_REPLY: empty host key blob")
    if qs.data.len() != 32:
        return Err("KEX_ECDH_REPLY: server public key must be 32 bytes")
    if sig.data.len() == 0:
        return Err("KEX_ECDH_REPLY: empty signature")

    Ok(SshKexEcdhReply(
        host_key_blob: ks.data,
        server_public: qs.data,
        signature_blob: sig.data
    ))

fn ssh_client_host_key_algorithm(host_key_blob: [u8]) -> Result<text, text>:
    """Algorithm name from the leading SSH string of a host key blob."""
    val t: SshTextResult = ssh_get_text(host_key_blob, 0)?
    Ok(t.value)

fn ssh_client_ed25519_host_key(host_key_blob: [u8]) -> Result<[u8], text>:
    """Extract the raw 32-byte ed25519 public key from an ssh-ed25519 blob."""
    val name: SshTextResult = ssh_get_text(host_key_blob, 0)?
    if name.value != "ssh-ed25519":
        return Err("host key: expected ssh-ed25519, got " + name.value)
    val key: SshStringResult = ssh_get_string(host_key_blob, name.next_offset)?
    if key.data.len() != 32:
        return Err("host key: ed25519 public key must be 32 bytes")
    if key.next_offset != host_key_blob.len():
        return Err("host key: trailing bytes after ed25519 public key")
    Ok(key.data)

fn ssh_client_ed25519_signature(signature_blob: [u8]) -> Result<[u8], text>:
    """Extract the raw 64-byte signature from an ssh-ed25519 signature blob."""
    val name: SshTextResult = ssh_get_text(signature_blob, 0)?
    if name.value != "ssh-ed25519":
        return Err("signature: expected ssh-ed25519, got " + name.value)
    val sig: SshStringResult = ssh_get_string(signature_blob, name.next_offset)?
    if sig.data.len() != 64:
        return Err("signature: ed25519 signature must be 64 bytes")
    if sig.next_offset != signature_blob.len():
        return Err("signature: trailing bytes after ed25519 signature")
    Ok(sig.data)

fn ssh_client_verify_host_signature(host_key_blob: [u8], signature_blob: [u8], exchange_hash: [u8]) -> Result<bool, text>:
    """Verify the server's signature over H. Ok(true) is the only success."""
    if exchange_hash.len() != 32:
        return Err("host signature: exchange hash must be 32 bytes")
    val pub_key = ssh_client_ed25519_host_key(host_key_blob)?
    val sig = ssh_client_ed25519_signature(signature_blob)?
    if not ed25519_verify(pub_key, exchange_hash, sig):
        return Err("host signature: ed25519 verification FAILED over exchange hash")
    Ok(true)

fn ssh_client_kex_exchange_hash(
    client_version: [u8],
    server_version: [u8],
    client_kexinit: [u8],
    server_kexinit: [u8],
    reply: SshKexEcdhReply,
    client_public: [u8],
    shared_secret: [u8]
) -> [u8]:
    """H for the client — same reused hash routine, client-ordered inputs."""
    ssh_kex_compute_exchange_hash(
        client_version,
        server_version,
        client_kexinit,
        server_kexinit,
        reply.host_key_blob,
        client_public,
        reply.server_public,
        shared_secret
    )

fn ssh_client_complete_kex(
    host: text,
    known_hosts: SshKnownHostsDb,
    client_private: [u8],
    client_version: [u8],
    server_version: [u8],
    client_kexinit: [u8],
    server_kexinit: [u8],
    reply_payload: [u8]
) -> Result<SshClientKexResult, text>:
    """Full client KEX: decode the reply, pin the host key, verify the
    signature over H, then derive session keys.

    Ordering is a security property: the host key is checked against
    known_hosts FIRST, so a MITM key is refused before its signature is ever
    accepted; only then is the signature verified; only then are keys derived.
    Any failure returns Err and NO key material.
    """
    if client_private.len() != 32:
        return Err("client kex: private key must be 32 bytes")

    val reply = ssh_client_parse_kex_ecdh_reply(reply_payload)?
    val algorithm = ssh_client_host_key_algorithm(reply.host_key_blob)?

    # 1. Pin the presented host key. Fails closed on unknown / changed keys.
    ssh_known_hosts_verify(known_hosts, host, algorithm, reply.host_key_blob)?

    # 2. Shared secret and exchange hash.
    val client_public = ssh_kex_public_from_private(client_private)
    if client_public.len() != 32:
        return Err("client kex: failed to derive client public key")
    val shared = ssh_kex_compute_shared(client_private, reply.server_public)
    if shared.len() != 32:
        return Err("client kex: X25519 shared secret failed")

    val h = ssh_client_kex_exchange_hash(
        client_version, server_version, client_kexinit, server_kexinit,
        reply, client_public, shared
    )
    if h.len() != 32:
        return Err("client kex: exchange hash failed")

    # 3. Verify the server actually holds the pinned host key.
    ssh_client_verify_host_signature(reply.host_key_blob, reply.signature_blob, h)?

    # 4. Derive keys. First KEX: session_id == H.
    val session_id = _sshcli_copy(h)
    val keys = ssh_derive_keys(shared, h, session_id)

    Ok(SshClientKexResult(
        algorithm: algorithm,
        exchange_hash: _sshcli_copy(h),
        session_id: session_id,
        host_key_blob: reply.host_key_blob,
        keys: keys
    ))

fn ssh_client_build_newkeys() -> [u8]:
    var buf: [u8] = []
    buf.push(SSH_MSG_NEWKEYS_C)
    buf

export SshKexEcdhReply, SshClientKexResult
export SSH_MSG_KEX_ECDH_INIT_C, SSH_MSG_KEX_ECDH_REPLY_C, SSH_MSG_NEWKEYS_C
export ssh_client_build_kex_ecdh_init, ssh_client_parse_kex_ecdh_reply
export ssh_client_host_key_algorithm, ssh_client_ed25519_host_key, ssh_client_ed25519_signature
export ssh_client_verify_host_signature, ssh_client_kex_exchange_hash
export ssh_client_complete_kex, ssh_client_build_newkeys
