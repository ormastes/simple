#![allow(unnamed_duplicate_typed_args)]
# SSH client connection protocol — RFC 4254 session channel + exec.
#
# Direction-asymmetric half: the client OPENS the channel and SENDS the exec
# request; os.apps.sshd.ssh_channel does the mirror image. Only the SSH string
# codec is shared (os.apps.sshd.ssh_packet).

use os.apps.sshd.ssh_packet.{
    ssh_put_u32, ssh_put_text, ssh_put_string, ssh_put_bool, ssh_put_byte,
    ssh_get_u32, ssh_get_string, ssh_get_text, ssh_ascii_bytes_to_text,
    SshStringResult, SshTextResult
}

extern fn rt_bytes_u8_at(arr: [u8], idx: i64) -> i64

val SSH_MSG_CHANNEL_OPEN_C: u8 = 90
val SSH_MSG_CHANNEL_OPEN_CONFIRMATION_C: u8 = 91
val SSH_MSG_CHANNEL_OPEN_FAILURE_C: u8 = 92
val SSH_MSG_CHANNEL_WINDOW_ADJUST_C: u8 = 93
val SSH_MSG_CHANNEL_DATA_C: u8 = 94
val SSH_MSG_CHANNEL_EXTENDED_DATA_C: u8 = 95
val SSH_MSG_CHANNEL_EOF_C: u8 = 96
val SSH_MSG_CHANNEL_CLOSE_C: u8 = 97
val SSH_MSG_CHANNEL_REQUEST_C: u8 = 98
val SSH_MSG_CHANNEL_SUCCESS_C: u8 = 99
val SSH_MSG_CHANNEL_FAILURE_C: u8 = 100

val SSH_EXTENDED_DATA_STDERR: u32 = 1

val SSH_CLIENT_WINDOW_SIZE: u32 = 2097152
val SSH_CLIENT_MAX_PACKET: u32 = 32768

# Channel message kinds.
val SSH_CHAN_OPEN_OK: text = "open_ok"
val SSH_CHAN_OPEN_FAILED: text = "open_failed"
val SSH_CHAN_DATA: text = "data"
val SSH_CHAN_STDERR: text = "stderr"
val SSH_CHAN_EOF: text = "eof"
val SSH_CHAN_CLOSE: text = "close"
val SSH_CHAN_EXIT_STATUS: text = "exit_status"
val SSH_CHAN_WINDOW_ADJUST: text = "window_adjust"
val SSH_CHAN_REQ_SUCCESS: text = "request_success"
val SSH_CHAN_REQ_FAILURE: text = "request_failure"

struct SshChannelMessage:
    """A decoded connection-protocol message addressed to our channel."""
    kind: text
    recipient: u32     # our local channel id, as echoed by the peer
    sender: u32        # peer channel id (OPEN_CONFIRMATION)
    window: u32        # initial window / adjust delta
    max_packet: u32
    data: [u8]         # DATA / EXTENDED_DATA payload
    exit_status: u32
    reason: text       # OPEN_FAILURE description

fn _sshcli_u8_at(data: [u8], idx: u64) -> u8:
    rt_bytes_u8_at(data, idx.to_i64()).to_u8()

fn _sshcli_blank(kind: text) -> SshChannelMessage:
    SshChannelMessage(
        kind: kind,
        recipient: 0,
        sender: 0,
        window: 0,
        max_packet: 0,
        data: [],
        exit_status: 0,
        reason: ""
    )

# ============================================================================
# Builders (client -> server)
# ============================================================================

fn ssh_client_build_channel_open_session(local_channel: u32) -> [u8]:
    """byte 90, string "session", uint32 sender channel, uint32 window,
    uint32 max packet size."""
    var buf: [u8] = []
    buf = ssh_put_byte(buf, SSH_MSG_CHANNEL_OPEN_C)
    buf = ssh_put_text(buf, "session")
    buf = ssh_put_u32(buf, local_channel)
    buf = ssh_put_u32(buf, SSH_CLIENT_WINDOW_SIZE)
    buf = ssh_put_u32(buf, SSH_CLIENT_MAX_PACKET)
    buf

fn ssh_client_build_exec_request(remote_channel: u32, command: text, want_reply: bool) -> Result<[u8], text>:
    """byte 98, uint32 recipient, string "exec", boolean want_reply,
    string command."""
    if command == "":
        return Err("exec request: empty command")
    var buf: [u8] = []
    buf = ssh_put_byte(buf, SSH_MSG_CHANNEL_REQUEST_C)
    buf = ssh_put_u32(buf, remote_channel)
    buf = ssh_put_text(buf, "exec")
    buf = ssh_put_bool(buf, want_reply)
    buf = ssh_put_text(buf, command)
    Ok(buf)

fn ssh_client_build_channel_data(remote_channel: u32, data: [u8]) -> [u8]:
    var buf: [u8] = []
    buf = ssh_put_byte(buf, SSH_MSG_CHANNEL_DATA_C)
    buf = ssh_put_u32(buf, remote_channel)
    buf = ssh_put_string(buf, data)
    buf

fn ssh_client_build_channel_eof(remote_channel: u32) -> [u8]:
    var buf: [u8] = []
    buf = ssh_put_byte(buf, SSH_MSG_CHANNEL_EOF_C)
    buf = ssh_put_u32(buf, remote_channel)
    buf

fn ssh_client_build_channel_close(remote_channel: u32) -> [u8]:
    var buf: [u8] = []
    buf = ssh_put_byte(buf, SSH_MSG_CHANNEL_CLOSE_C)
    buf = ssh_put_u32(buf, remote_channel)
    buf

# ============================================================================
# Parser (server -> client)
# ============================================================================

fn ssh_client_parse_channel_message(data: [u8]) -> Result<SshChannelMessage, text>:
    """Decode one connection-protocol message. Unknown types are an error, not
    a silently dropped packet."""
    if data.len() < 1:
        return Err("channel message: empty")
    val msg: u8 = _sshcli_u8_at(data, 0)

    if msg == SSH_MSG_CHANNEL_OPEN_CONFIRMATION_C:
        if data.len() < 17:
            return Err("CHANNEL_OPEN_CONFIRMATION: too short")
        return Ok(SshChannelMessage(
            kind: SSH_CHAN_OPEN_OK,
            recipient: ssh_get_u32(data, 1),
            sender: ssh_get_u32(data, 5),
            window: ssh_get_u32(data, 9),
            max_packet: ssh_get_u32(data, 13),
            data: [],
            exit_status: 0,
            reason: ""
        ))

    if msg == SSH_MSG_CHANNEL_OPEN_FAILURE_C:
        if data.len() < 9:
            return Err("CHANNEL_OPEN_FAILURE: too short")
        val recipient: u32 = ssh_get_u32(data, 1)
        val code: u32 = ssh_get_u32(data, 5)
        val why: SshTextResult = ssh_get_text(data, 9)?
        return Ok(SshChannelMessage(
            kind: SSH_CHAN_OPEN_FAILED,
            recipient: recipient,
            sender: 0,
            window: code,
            max_packet: 0,
            data: [],
            exit_status: 0,
            reason: why.value
        ))

    if msg == SSH_MSG_CHANNEL_DATA_C:
        if data.len() < 5:
            return Err("CHANNEL_DATA: too short")
        val recipient: u32 = ssh_get_u32(data, 1)
        val payload: SshStringResult = ssh_get_string(data, 5)?
        return Ok(SshChannelMessage(
            kind: SSH_CHAN_DATA,
            recipient: recipient,
            sender: 0,
            window: 0,
            max_packet: 0,
            data: payload.data,
            exit_status: 0,
            reason: ""
        ))

    if msg == SSH_MSG_CHANNEL_EXTENDED_DATA_C:
        if data.len() < 9:
            return Err("CHANNEL_EXTENDED_DATA: too short")
        val recipient: u32 = ssh_get_u32(data, 1)
        val kind_code: u32 = ssh_get_u32(data, 5)
        if kind_code != SSH_EXTENDED_DATA_STDERR:
            return Err("CHANNEL_EXTENDED_DATA: unsupported data type code")
        val payload: SshStringResult = ssh_get_string(data, 9)?
        return Ok(SshChannelMessage(
            kind: SSH_CHAN_STDERR,
            recipient: recipient,
            sender: 0,
            window: 0,
            max_packet: 0,
            data: payload.data,
            exit_status: 0,
            reason: ""
        ))

    if msg == SSH_MSG_CHANNEL_WINDOW_ADJUST_C:
        if data.len() < 9:
            return Err("CHANNEL_WINDOW_ADJUST: too short")
        return Ok(SshChannelMessage(
            kind: SSH_CHAN_WINDOW_ADJUST,
            recipient: ssh_get_u32(data, 1),
            sender: 0,
            window: ssh_get_u32(data, 5),
            max_packet: 0,
            data: [],
            exit_status: 0,
            reason: ""
        ))

    if msg == SSH_MSG_CHANNEL_EOF_C or msg == SSH_MSG_CHANNEL_CLOSE_C:
        if data.len() < 5:
            return Err("CHANNEL_EOF/CLOSE: too short")
        var kind: text = SSH_CHAN_EOF
        if msg == SSH_MSG_CHANNEL_CLOSE_C:
            kind = SSH_CHAN_CLOSE
        return Ok(SshChannelMessage(
            kind: kind,
            recipient: ssh_get_u32(data, 1),
            sender: 0,
            window: 0,
            max_packet: 0,
            data: [],
            exit_status: 0,
            reason: ""
        ))

    if msg == SSH_MSG_CHANNEL_SUCCESS_C or msg == SSH_MSG_CHANNEL_FAILURE_C:
        if data.len() < 5:
            return Err("CHANNEL_SUCCESS/FAILURE: too short")
        var kind2: text = SSH_CHAN_REQ_SUCCESS
        if msg == SSH_MSG_CHANNEL_FAILURE_C:
            kind2 = SSH_CHAN_REQ_FAILURE
        return Ok(SshChannelMessage(
            kind: kind2,
            recipient: ssh_get_u32(data, 1),
            sender: 0,
            window: 0,
            max_packet: 0,
            data: [],
            exit_status: 0,
            reason: ""
        ))

    if msg == SSH_MSG_CHANNEL_REQUEST_C:
        if data.len() < 5:
            return Err("CHANNEL_REQUEST: too short")
        val recipient: u32 = ssh_get_u32(data, 1)
        val req: SshTextResult = ssh_get_text(data, 5)?
        if req.value == "exit-status":
            # boolean want_reply (always FALSE) then uint32 status
            if req.next_offset + 5 > data.len():
                return Err("exit-status: truncated")
            return Ok(SshChannelMessage(
                kind: SSH_CHAN_EXIT_STATUS,
                recipient: recipient,
                sender: 0,
                window: 0,
                max_packet: 0,
                data: [],
                exit_status: ssh_get_u32(data, req.next_offset + 1),
                reason: ""
            ))
        return Err("CHANNEL_REQUEST: unsupported request " + req.value)

    Err("channel message: unexpected message type " + msg.to_i64().to_text())

fn ssh_client_channel_text(msg: SshChannelMessage) -> text:
    ssh_ascii_bytes_to_text(msg.data)

export SshChannelMessage
export SSH_MSG_CHANNEL_OPEN_C, SSH_MSG_CHANNEL_OPEN_CONFIRMATION_C, SSH_MSG_CHANNEL_OPEN_FAILURE_C
export SSH_MSG_CHANNEL_DATA_C, SSH_MSG_CHANNEL_EXTENDED_DATA_C, SSH_MSG_CHANNEL_EOF_C
export SSH_MSG_CHANNEL_CLOSE_C, SSH_MSG_CHANNEL_REQUEST_C, SSH_MSG_CHANNEL_SUCCESS_C, SSH_MSG_CHANNEL_FAILURE_C
export SSH_CLIENT_WINDOW_SIZE, SSH_CLIENT_MAX_PACKET, SSH_EXTENDED_DATA_STDERR
export SSH_CHAN_OPEN_OK, SSH_CHAN_OPEN_FAILED, SSH_CHAN_DATA, SSH_CHAN_STDERR
export SSH_CHAN_EOF, SSH_CHAN_CLOSE, SSH_CHAN_EXIT_STATUS, SSH_CHAN_WINDOW_ADJUST
export SSH_CHAN_REQ_SUCCESS, SSH_CHAN_REQ_FAILURE
export ssh_client_build_channel_open_session, ssh_client_build_exec_request
export ssh_client_build_channel_data, ssh_client_build_channel_eof, ssh_client_build_channel_close
export ssh_client_parse_channel_message, ssh_client_channel_text
