# TLS 1.3 X25519MLKEM768 hybrid key-share validation and client decapsulation.
#
# Wire contract (draft-ietf-tls-ecdhe-mlkem-05), pinned by
# src/lib/common/crypto/x25519_mlkem768/contract.spl:
#   named group        0x11EC
#   client key_share = ML-KEM-768 encapsulation key (1184) || X25519 public (32)
#   server key_share = ML-KEM-768 ciphertext        (1088) || X25519 public (32)
#   hybrid secret    = ML-KEM shared secret          (32)  || X25519 shared  (32)
#
# The ML-KEM half comes FIRST in all three. Every entry point here fails closed:
# a rejected group, a wrong-length share or a failed decapsulation returns Err
# and never yields a partial or zeroed shared secret.

mod os.tls13.hybrid_handshake

use lib.common.crypto.x25519_mlkem768.contract.{
    X25519MlKem768Config,
    X25519_MLKEM768_TLS_NAMED_GROUP,
    X25519_MLKEM768_CLIENT_SHARE_BYTES,
    X25519_MLKEM768_SERVER_SHARE_BYTES,
    X25519_MLKEM768_SHARED_SECRET_BYTES}
use os.crypto.x25519_mlkem768.hybrid.{x25519_mlkem768_decapsulate}
use os.tls13.handshake13.{ServerHello13}

val _HYBRID_DECAPSULATION_KEY_BYTES: i64 = 2400

enum TlsHybridAlert:
    IllegalParameter
    InternalError

class TlsHybridError:
    """A hybrid-handshake failure plus the TLS alert it maps to."""
    alert: TlsHybridAlert
    reason: text

class TlsHybridSharedSecret:
    """The 64-byte hybrid secret: ML-KEM shared secret || X25519 shared secret."""
    shared_secret: list

fn _illegal_parameter(reason: text) -> TlsHybridError:
    TlsHybridError(alert: TlsHybridAlert.IllegalParameter, reason: reason)

fn _internal_error(reason: text) -> TlsHybridError:
    TlsHybridError(alert: TlsHybridAlert.InternalError, reason: reason)

fn tls13_hybrid_bytes_to_list(values: [u8]) -> list:
    """Widen a wire byte buffer to the `list` form the hybrid primitives take."""
    var out = []
    var i: u64 = 0u64
    while i < values.len():
        out.push(values[i].to_i64())
        i = i + 1u64
    out

fn tls13_hybrid_list_to_bytes(values: list) -> [u8]:
    """Narrow a hybrid primitive result back to a wire byte buffer."""
    var out: [u8] = []
    var i: i64 = 0
    while i < values.len():
        out.push((values.get(i).to_i64() & 0xFF).to_u8())
        i = i + 1
    out

fn tls13_validate_x25519_mlkem768_client_share(group: u16,
        share: list) -> Result<bool, TlsHybridError>:
    """Accept only a 0x11EC key_share of exactly 1216 bytes."""
    if group.to_i64() != X25519_MLKEM768_TLS_NAMED_GROUP:
        return Err(_illegal_parameter(
            "unexpected named group for an X25519MLKEM768 client key share"))
    if share.len() != X25519_MLKEM768_CLIENT_SHARE_BYTES:
        return Err(_illegal_parameter(
            "X25519MLKEM768 client key share must be exactly 1216 bytes"))
    Ok(true)

fn tls13_validate_x25519_mlkem768_server_share(group: u16,
        share: list) -> Result<bool, TlsHybridError>:
    """Accept only a 0x11EC key_share of exactly 1120 bytes."""
    if group.to_i64() != X25519_MLKEM768_TLS_NAMED_GROUP:
        return Err(_illegal_parameter(
            "unexpected named group for an X25519MLKEM768 server key share"))
    if share.len() != X25519_MLKEM768_SERVER_SHARE_BYTES:
        return Err(_illegal_parameter(
            "X25519MLKEM768 server key share must be exactly 1120 bytes"))
    Ok(true)

fn tls13_decapsulate_x25519_mlkem768_server_hello(sh: ServerHello13,
        config: X25519MlKem768Config, x25519_private: [u8],
        decapsulation_key: list) -> Result<TlsHybridSharedSecret, TlsHybridError>:
    """Derive the 64-byte hybrid secret from a hybrid ServerHello key_share.

    Fails closed: the caller only ever receives a full 64-byte secret, so a
    session key can never be derived from a failed decapsulation.
    """
    val share = tls13_hybrid_bytes_to_list(sh.x25519_mlkem768_share)
    val share_ok = match tls13_validate_x25519_mlkem768_server_share(
            sh.named_group, share):
        case Ok(value): value
        case Err(error): return Err(error)
    if not share_ok:
        return Err(_illegal_parameter(
            "X25519MLKEM768 server key share failed validation"))

    if decapsulation_key.len() != _HYBRID_DECAPSULATION_KEY_BYTES:
        return Err(_internal_error(
            "X25519MLKEM768 needs a 2400-byte ML-KEM-768 decapsulation key"))
    if x25519_private.len().to_i64() != 32:
        return Err(_internal_error(
            "X25519MLKEM768 needs a 32-byte X25519 private key"))

    val decapsulated = match x25519_mlkem768_decapsulate(
            config, share, x25519_private, decapsulation_key):
        case Ok(value): value
        case Err(reason):
            if reason.contains("all-zero"):
                return Err(_illegal_parameter(reason))
            return Err(_internal_error(reason))

    if decapsulated.shared_secret.len() != X25519_MLKEM768_SHARED_SECRET_BYTES:
        return Err(_internal_error(
            "X25519MLKEM768 decapsulation returned a short shared secret"))
    Ok(TlsHybridSharedSecret(shared_secret: decapsulated.shared_secret))

export TlsHybridAlert, TlsHybridError, TlsHybridSharedSecret
export tls13_hybrid_bytes_to_list, tls13_hybrid_list_to_bytes
export tls13_validate_x25519_mlkem768_client_share
export tls13_validate_x25519_mlkem768_server_share
export tls13_decapsulate_x25519_mlkem768_server_hello
