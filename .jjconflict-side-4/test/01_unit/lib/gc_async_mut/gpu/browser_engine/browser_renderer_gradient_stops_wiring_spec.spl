# @tag: unit, gpu, browser_engine, gradient
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_decl_apply.spl 5%
#
# GAP-2 wiring (doc/03_plan/ui/unified_2d_engine/drawir_feature_gap_2026-07-31.md):
# the two ENDS of the N-stop gradient pipeline were already covered on main —
# CSS token parsing (simple_web_html_layout_renderer_foundation_gradient_spec)
# and the raster primitives (engine2d/gradient_stops_paint_spec). This spec
# covers the MIDDLE that connects them: `apply_decls` populating the GAP-2
# Style fields (background_gradient_stop_colors / _stop_positions /
# _angle_deg / _is_radial), and the full HTML→pixels path exercising
# paint_layout prop encoding → draw_ir_adv stop-array rebuild →
# Engine2D.draw_gradient_rect_stops / draw_radial_gradient_rect_stops.

use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_style.{renderer_default_style}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_declarations.{apply_decls}
use std.gc_async_mut.gpu.browser_engine.simple_web_layout_engine2d_fast.{simple_web_layout_render_html_pixels_engine2d}

val WHITE: u32 = 0xFFFFFFFFu32

fn distinct_non_white(pixels: [u32]) -> i32:
    var seen: [u32] = []
    var idx = 0
    while idx < pixels.len():
        val p = pixels[idx]
        if p != WHITE:
            var found = false
            var j = 0
            while j < seen.len():
                if seen[j] == p:
                    found = true
                j = j + 1
            if not found:
                seen.push(p)
        idx = idx + 1
    seen.len()

describe "GAP-2 apply_decls populates the N-stop gradient Style fields":

    it "parses a 3-stop angled linear-gradient into stop colors/positions/angle":
        val st0 = renderer_default_style()
        val st1 = apply_decls(st0, "background-image: linear-gradient(45deg, #ff0000, #ffff00, #0000ff);", 16)
        expect(st1.background_gradient_stop_colors.len()).to_equal(3)
        expect(st1.background_gradient_stop_positions.len()).to_equal(3)
        expect(st1.background_gradient_angle_deg).to_equal(45)
        expect(st1.background_gradient_is_radial).to_equal(false)

    it "parses a radial-gradient into stop fields with the radial flag":
        val st0 = renderer_default_style()
        val st2 = apply_decls(st0, "background-image: radial-gradient(#ff0000, #ffff00, #0000ff);", 16)
        expect(st2.background_gradient_stop_colors.len()).to_equal(3)
        expect(st2.background_gradient_is_radial).to_equal(true)

    it "resets the stop fields on a later background-image none":
        val st0 = renderer_default_style()
        val st1 = apply_decls(st0, "background-image: linear-gradient(45deg, #ff0000, #ffff00, #0000ff);", 16)
        val st2 = apply_decls(st1, "background-image: none;", 16)
        expect(st2.background_gradient_stop_colors.len()).to_equal(0)
        expect(st2.background_gradient_is_radial).to_equal(false)

describe "GAP-2 HTML to pixels through draw_ir_adv stop-list painting":

    it "renders a 3-stop 45deg linear gradient with many distinct shades":
        val html = "<html><body><span style='display:block; width: 20px; height: 20px; background-image: linear-gradient(45deg, #ff0000, #ffff00, #0000ff)'></span></body></html>"
        val px = simple_web_layout_render_html_pixels_engine2d(html, 30, 30, "software")
        expect(distinct_non_white(px) >= 10).to_equal(true)

    it "renders a radial gradient with multiple distinct rings":
        val html = "<html><body><span style='display:block; width: 20px; height: 20px; background-image: radial-gradient(#ff0000, #ffff00, #0000ff)'></span></body></html>"
        val px = simple_web_layout_render_html_pixels_engine2d(html, 30, 30, "software")
        expect(distinct_non_white(px) >= 5).to_equal(true)
