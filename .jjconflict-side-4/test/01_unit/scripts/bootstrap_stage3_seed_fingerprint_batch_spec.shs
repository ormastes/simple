#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
test_tmp=$(mktemp -d)
trap 'rm -rf "$test_tmp"' EXIT INT TERM

. "$repo_root/scripts/check/lib/bootstrap-stage3/authority.shs"

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

real_sha256sum=$(command -v sha256sum) || fail "sha256sum is required"
mkdir -p "$test_tmp/files" "$test_tmp/tools"
call_log="$test_tmp/hash-calls.log"
: >"$call_log"

index=1
while [ "$index" -le 320 ]; do
  file="$test_tmp/files/input $index [seed].rs"
  printf 'seed input %s\n' "$index" >"$file"
  printf '%s\n' "$file" >>"$test_tmp/paths"
  index=$((index + 1))
done

cat >"$test_tmp/tools/sha256sum" <<'WRAPPER'
#!/bin/sh
printf 'call\n' >>"$BATCH_HASH_CALL_LOG"
exec "$BATCH_HASH_REAL_SHA256SUM" "$@"
WRAPPER
chmod +x "$test_tmp/tools/sha256sum"

original_path=$PATH
PATH="$test_tmp/tools:$PATH"
BATCH_HASH_CALL_LOG=$call_log
BATCH_HASH_REAL_SHA256SUM=$real_sha256sum
export PATH BATCH_HASH_CALL_LOG BATCH_HASH_REAL_SHA256SUM

bootstrap_stage3_hash_path_list "$test_tmp/paths" >"$test_tmp/before"
record_count=$(wc -l <"$test_tmp/before" | tr -d ' ')
[ "$record_count" -eq 320 ] || fail "expected 320 authority records, got $record_count"
call_count=$(wc -l <"$call_log" | tr -d ' ')
[ "$call_count" -gt 0 ] || fail "batch hash tool was not called"
[ "$call_count" -le 4 ] || fail "320 inputs launched $call_count hash processes"

# Adjacent deterministic case: identical ordered paths and bytes must produce
# byte-identical path+hash authority records.
bootstrap_stage3_hash_path_list "$test_tmp/paths" >"$test_tmp/repeated"
cmp -s "$test_tmp/before" "$test_tmp/repeated" ||
  fail "unchanged inputs produced a different authority record"

# Adjacent sensitivity case: changing one vendored-style input must change its
# record without disturbing an unchanged path containing shell metacharacters.
changed="$test_tmp/files/input 137 [seed].rs"
stable="$test_tmp/files/input 138 [seed].rs"
changed_before=$(grep -F "  $changed" "$test_tmp/before")
stable_before=$(grep -F "  $stable" "$test_tmp/before")
printf 'changed seed input\n' >"$changed"
bootstrap_stage3_hash_path_list "$test_tmp/paths" >"$test_tmp/after"
changed_after=$(grep -F "  $changed" "$test_tmp/after")
stable_after=$(grep -F "  $stable" "$test_tmp/after")
[ "$changed_before" != "$changed_after" ] || fail "changed input kept its old hash"
[ "$stable_before" = "$stable_after" ] || fail "unchanged input record changed"

PATH=$original_path
export PATH
echo "PASS: bootstrap Stage 3 seed fingerprint batches complete deterministic authority"
