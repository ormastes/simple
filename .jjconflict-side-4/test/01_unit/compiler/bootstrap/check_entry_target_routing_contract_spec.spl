use std.nogc_sync_mut.io.file_ops.{file_read}

describe "check entry target routing":
    it "does not classify the reserved-looking target basename as argv metadata":
        val source = file_read("src/app/cli/check_entry.spl")
        expect(source).to_contain("if i == 0 and arg == \"check\":")
        expect(source).to_contain("a source")
        expect(source.contains("arg.ends_with(\"check_entry.spl\")")).to_equal(false)

    it "still consumes the explicit adjacent check command discriminator":
        val source = file_read("src/app/cli/check_entry.spl")
        expect(source).to_contain("i == 0 and arg == \"check\"")
