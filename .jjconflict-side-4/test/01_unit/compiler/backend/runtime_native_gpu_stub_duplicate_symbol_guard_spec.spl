use std.spec.{describe, it, expect}

extern fn rt_file_read_text(path: text) -> text

# Regression guard for doc/08_tracking/bug/
# rt_host_gpu_queue_duplicate_symbols_freebsd_fatal_2026-08-05.md.
#
# src/runtime/runtime_native.c and src/compiler_rust/runtime/src/host_gpu_lane.rs
# each carry a FULL, independent implementation of the rt_host_gpu_lane_*/
# rt_host_gpu_queue_* family (~24 symbols). That duplication is intentional and
# load-bearing on BOTH sides:
#   - runtime_native.c's copy backs native-compiled (AOT) Simple executables --
#     50.mir/_MirLoweringExpr/expr_dispatch.spl lowers `target.later() gpu|host:`
#     blocks to calls against exactly these C symbols, and
#     src/compiler/70.backend/backend/runtime_compiler.spl unconditionally
#     includes "runtime_native" in the native-product-build C source bundle.
#     Those standalone binaries have no Rust runtime linked in at all, so they
#     need their own C implementation.
#   - host_gpu_lane.rs's copy backs the Rust-hosted seed/compiler binary's own
#     interpreter and JIT execution of the same lane markers (see
#     interpreter/_EvalOps/call_method_eval.spl) and carries its own unit
#     tests (host_gpu_lane.rs, `cargo test -p simple-runtime --lib
#     host_gpu_lane`).
#
# These two copies must NEVER land in the same linked binary: GNU ld silently
# tolerates the resulting duplicate strong symbols (first definition wins,
# picking a winner with no diagnostic), but FreeBSD's default `lld` treats it
# as a fatal link error -- exactly the failure Lane B hit trying to link
# `simple-runtime` in a FreeBSD guest. Reproduced locally: temporarily adding
# "runtime_native.c" to compile_c_runtime_sources()'s c_sources list and
# forcing `-fuse-ld=lld` makes `cargo build -p simple-driver --bin simple`
# fail with 24 "duplicate symbol: rt_host_gpu_*" errors; reverting links clean
# under lld. src/compiler_rust/runtime/build.rs's own `compile_c_runtime_sources`
# already avoids this deliberately (see its "runtime_native_gpu_stub.c" comment,
# lane R2, 2026-08-05): it must keep compiling ONLY the narrow
# runtime_native_gpu_stub.c extract (rt_opengl_*/rt_oneapi_*), never the whole
# runtime_native.c file, so the crate this spec guards never gains a second
# copy of host_gpu_lane.rs's symbols.
describe "rt_host_gpu_* duplicate-symbol guard (runtime crate build.rs)":
    it "never compiles the full runtime_native.c into the simple-runtime crate":
        val build_rs = rt_file_read_text("src/compiler_rust/runtime/build.rs")

        # The narrow, safe extraction must still be present and wired in.
        expect(build_rs).to_contain("\"runtime_native_gpu_stub.c\"")

        # A literal C-source-list entry for the whole file (as it would be
        # written if someone "simplified" the stub back to the real file) is
        # what actually reintroduces the rt_host_gpu_* duplicate. Comments may
        # mention "runtime_native.c" as bare text (they do, extensively, to
        # explain why it's excluded); only the quoted-list-entry form is
        # forbidden.
        expect(build_rs).to_not_contain("\"runtime_native.c\"")

    it "keeps both rt_host_gpu_queue_complete implementations, one per lane":
        # Native AOT lane: MIR lowering must still target the C ABI symbol
        # family so native-compiled `target.later() gpu|host:` blocks keep
        # working (rt_host_gpu_lane_event / rt_host_gpu_queue_emit are the
        # begin/end + emit calls this lowering emits).
        val mir_dispatch = rt_file_read_text(
            "src/compiler/50.mir/_MirLoweringExpr/expr_dispatch.spl")
        expect(mir_dispatch).to_contain("rt_host_gpu_lane_event")
        expect(mir_dispatch).to_contain("rt_host_gpu_queue_emit")

        # Rust-hosted lane: the C source of truth for AOT output.
        val native_c = rt_file_read_text("src/runtime/runtime_native.c")
        expect(native_c).to_contain("int64_t rt_host_gpu_queue_complete(int64_t max_packets)")

        # Rust-hosted lane: host_gpu_lane.rs backs the seed's own
        # interpreter/JIT execution and carries its own unit tests.
        val host_gpu_lane = rt_file_read_text(
            "src/compiler_rust/runtime/src/host_gpu_lane.rs")
        expect(host_gpu_lane).to_contain(
            "pub extern \"C\" fn rt_host_gpu_queue_complete(max_packets: i64) -> i64")
