# @tag: unit, crypto, x25519mlkem768, cuda, vulkan, metal, provenance

use std.spec.{describe, it, expect, fail, step}
use std.sffi.io.{file_read_text, file_hash_sha256}
use os.crypto.x25519_mlkem768.metal_ntt_provider.{
    X25519MlKem768MetalNttExecutor,
    x25519_mlkem768_metal_ntt_execute}
use os.crypto.x25519_mlkem768.vulkan_ntt_provider.{
    X25519MlKem768VulkanNttExecutor,
    x25519_mlkem768_vulkan_ntt_execute}
use os.crypto.x25519_mlkem768.cuda_ntt_provider.{
    X25519MlKem768CudaNttExecutor}

fn _binary_contract_fixture() -> list:
    var out: list = []
    var i: i64 = 0
    while i < 256:
        out.push((i * 29 + 17) % 3329)
        i = i + 1
    out

describe "X25519MLKEM768 exact GPU binary providers":
    it "should keep compiled binary constructors from fabricating source provenance":
        step("Construct missing CUDA and Metal binaries and inspect provenance")
        var cuda = X25519MlKem768CudaNttExecutor.create_binary(
            "test/fixtures/crypto/x25519mlkem768/missing.cubin",
            "0123456789abcdef")
        var metal = X25519MlKem768MetalNttExecutor.create_binary(
            "test/fixtures/crypto/x25519mlkem768/missing.metallib",
            "0123456789abcdef")
        expect(cuda.source_digest).to_equal("")
        expect(metal.source_digest).to_equal("")
        cuda.shutdown()
        metal.shutdown()

    it "should load an admitted Metal metallib instead of recompiling source":
        step("Trace admitted metallib bytes through the in-process loader")
        val facade = file_read_text(
            "src/lib/nogc_sync_mut/io/metal_sffi.spl")
        val session = file_read_text(
            "src/lib/gc_async_mut/crypto_accel/metal_session.spl")
        val runtime = file_read_text(
            "src/compiler_rust/runtime/src/metal_graphics_runtime.rs")
        val registry = file_read_text(
            "src/compiler_rust/common/src/runtime_symbols.rs")
        val interpreter = file_read_text(
            "src/compiler_rust/compiler/src/interpreter_extern/mod.rs")
        val provider = file_read_text(
            "src/os/crypto/x25519_mlkem768/metal_ntt_provider.spl")
        expect(facade).to_contain("rt_metal_load_library_bytes_raw")
        expect(session).to_contain(
            "self.shader = metal_sffi_load_library_bytes(self.device, artifact_bytes)")
        expect(runtime).to_contain("newLibraryWithData_error(&data)")
        expect(registry).to_contain("\"rt_metal_load_library_bytes_raw\"")
        expect(interpreter).to_contain(
            "insert_simple!(\"rt_metal_load_library_bytes\"")
        expect(provider).to_contain(
            "self.artifact_digest != self.expected_artifact_digest")
        expect(provider).to_contain(
            "sha256_u8_hex(artifact_bytes)")
        val binary_init = session.index_of("me init_binary(")
        val binary_load = session.index_of(
            "self.shader = metal_sffi_load_library_bytes")
        expect(binary_load).to_be_greater_than(binary_init)

    it "should admit and load the same in-memory CUDA binary image":
        step("Trace admitted CUDA bytes from provider to module loading")
        val facade = file_read_text("src/lib/gc_async_mut/cuda.spl")
        val session = file_read_text(
            "src/lib/gc_async_mut/crypto_accel/cuda_session.spl")
        val provider = file_read_text(
            "src/os/crypto/x25519_mlkem768/cuda_ntt_provider.spl")
        expect(facade).to_contain("fn cuda_module_load_binary(bytes: [u8])")
        expect(facade).to_contain("rt_cuda_module_load_data_bytes(")
        expect(session).to_contain("me load_module_binary(bytes: [u8])")
        expect(provider).to_contain(
            "self.session.load_module_binary(self.artifact_bytes)")
        expect(provider).to_contain("sha256_u8_hex(artifact_bytes)")

    it "should retain the CUDA module and context when completion is unknown":
        step("Inspect CUDA shutdown guards before dependent resource release")
        val session = file_read_text(
            "src/lib/gc_async_mut/crypto_accel/cuda_session.spl")
        val shutdown = session.index_of("me shutdown():")
        val unknown_guard = session.index_of(
            "if self.completion_unknown:", shutdown)
        val destroy_context = session.index_of("cuda_ctx_destroy", shutdown)
        expect(unknown_guard).to_be_greater_than(shutdown)
        expect(unknown_guard).to_be_less_than(destroy_context)
        val provider = file_read_text(
            "src/os/crypto/x25519_mlkem768/cuda_ntt_provider.spl")
        val release = provider.index_of("me _release_buffers():")
        val dependency_guard = provider.index_of(
            "if self.session.completion_unknown:", release)
        val clear_handle = provider.index_of("self.input_device = 0", release)
        expect(dependency_guard).to_be_greater_than(release)
        expect(dependency_guard).to_be_less_than(clear_handle)

    it "should retain every Metal dependency while completion is unknown":
        step("Inspect Metal shutdown guards before dependent resource release")
        val session = file_read_text(
            "src/lib/gc_async_mut/crypto_accel/metal_session.spl")
        val shutdown = session.index_of("me shutdown():")
        val unknown_guard = session.index_of(
            "if self.completion_unknown:", shutdown)
        val release = session.index_of("self._release_buffers()", shutdown)
        val destroy_pipeline = session.index_of(
            "metal_sffi_destroy_pipeline", shutdown)
        expect(unknown_guard).to_be_greater_than(shutdown)
        expect(unknown_guard).to_be_less_than(release)
        expect(unknown_guard).to_be_less_than(destroy_pipeline)

    it "should reject missing and wrong-extension Metal binaries before hardware":
        step("Submit missing and source-kind artifacts to the Metal provider")
        val fixture = _binary_contract_fixture()
        var missing = X25519MlKem768MetalNttExecutor.create_binary(
            "test/fixtures/crypto/x25519mlkem768/missing.metallib",
            "0123456789abcdef")
        match x25519_mlkem768_metal_ntt_execute(missing, fixture):
            case Ok(_): fail("Metal accepted a missing metallib")
            case Err(reason): expect(reason).to_equal(
                "metal-ntt-binary-artifact-invalid")
        missing.shutdown()
        var wrong_extension = X25519MlKem768MetalNttExecutor.create_binary(
            "src/os/crypto/x25519_mlkem768/kernels/ml_kem_ntt.metal",
            file_hash_sha256(
                "src/os/crypto/x25519_mlkem768/kernels/ml_kem_ntt.metal"))
        match x25519_mlkem768_metal_ntt_execute(
                wrong_extension, fixture):
            case Ok(_): fail("Metal accepted source as a metallib")
            case Err(reason): expect(reason).to_equal(
                "metal-ntt-binary-extension-invalid")
        wrong_extension.shutdown()
    it "should expose a Vulkan algorithm provider that accepts only pinned SPIR-V":
        step("Inspect Vulkan admission, binding, submission, and readback ownership")
        val provider = file_read_text(
            "src/os/crypto/x25519_mlkem768/vulkan_ntt_provider.spl")
        val session = file_read_text(
            "src/lib/gc_async_mut/crypto_accel/vulkan_session.spl")
        expect(provider).to_contain("impl MlKemNttBatchProvider")
        expect(provider).to_contain(
            "sha256_u8_hex(forward_read)")
        expect(provider).to_contain(
            "sha256_u8_hex(inverse_read)")
        expect(provider).to_contain("_vulkan_spirv_magic_valid")
        expect(session).to_contain(
            "vulkan_sffi_compile_spirv(forward_spirv)")
        expect(session).to_contain(
            "vulkan_sffi_compile_spirv(inverse_spirv)")
        expect(session).to_contain("descriptor, 2,")
        expect(session).to_contain("self.zeta_buffer")
        expect(session).to_contain("vulkan_sffi_submit_and_wait_fence")
        expect(session.contains("compile_glsl")).to_equal(false)

    it "should reject absent, wrong-extension, and non-SPIR-V Vulkan artifacts before hardware":
        step("Submit missing and GLSL artifacts to the Vulkan provider")
        val fixture = _binary_contract_fixture()
        var missing = X25519MlKem768VulkanNttExecutor.create_binaries(
            "test/fixtures/crypto/x25519mlkem768/missing.spv",
            "0123456789abcdef",
            "test/fixtures/crypto/x25519mlkem768/missing_inverse.spv",
            "fedcba9876543210")
        match x25519_mlkem768_vulkan_ntt_execute(missing, fixture):
            case Ok(_): fail("Vulkan accepted a missing SPIR-V module")
            case Err(reason): expect(reason).to_equal(
                "vulkan-ntt-binary-artifact-invalid")
        missing.shutdown()
        var wrong_extension = X25519MlKem768VulkanNttExecutor.create_binaries(
            "src/os/crypto/x25519_mlkem768/kernels/ml_kem_ntt_forward.comp",
            file_hash_sha256(
                "src/os/crypto/x25519_mlkem768/kernels/ml_kem_ntt_forward.comp"),
            "src/os/crypto/x25519_mlkem768/kernels/ml_kem_ntt_inverse.comp",
            file_hash_sha256(
                "src/os/crypto/x25519_mlkem768/kernels/ml_kem_ntt_inverse.comp"))
        match x25519_mlkem768_vulkan_ntt_execute(
                wrong_extension, fixture):
            case Ok(_): fail("Vulkan accepted GLSL source as SPIR-V")
            case Err(reason): expect(reason).to_equal(
                "vulkan-ntt-binary-extension-invalid")
        wrong_extension.shutdown()

    it "should align Vulkan build inputs with runtime entry points":
        step("Compare forward and inverse shader entries with provider constants")
        val forward = file_read_text(
            "src/os/crypto/x25519_mlkem768/kernels/ml_kem_ntt_forward.comp")
        val inverse = file_read_text(
            "src/os/crypto/x25519_mlkem768/kernels/ml_kem_ntt_inverse.comp")
        val provider = file_read_text(
            "src/os/crypto/x25519_mlkem768/vulkan_ntt_provider.spl")
        expect(forward).to_contain("void main()")
        expect(inverse).to_contain("void main()")
        expect(forward).to_contain("uint len = 128u >> stage")
        expect(inverse).to_contain("uint len = 2u << stage")
        expect(provider).to_contain(
            "X25519_MLKEM768_VULKAN_NTT_ENTRY: text = \"main\"")
        expect(provider).to_contain("self.forward_spirv, self.inverse_spirv")
        expect(provider).to_contain("X25519_MLKEM768_VULKAN_NTT_ENTRY")

    it "should distinguish source JIT from admitted binaries in GPU evidence":
        step("Inspect hybrid evidence labels and retained artifact digests")
        val hybrid = file_read_text(
            "src/os/crypto/x25519_mlkem768/hybrid.spl")
        val operation_evidence = file_read_text(
            "src/os/crypto/x25519_mlkem768/gpu_operation_evidence.spl")
        expect(operation_evidence).to_contain(
            "if executor.use_binary: \":metallib:\" else: \":source-jit:\"")
        expect(operation_evidence).to_contain(
            "updated.artifact_digest = executor.artifact_digest")
        expect(operation_evidence).to_contain(
            "if executor.use_binary: \":cubin:\" else: \":ptx-jit:\"")

    it "should compare every successful GPU hybrid operation with scalar ML-KEM":
        step("Count the shared scalar-verification calls across all GPU providers")
        val hybrid = file_read_text(
            "src/os/crypto/x25519_mlkem768/hybrid.spl")
        val operation_evidence = file_read_text(
            "src/os/crypto/x25519_mlkem768/gpu_operation_evidence.spl")
        val implementation = hybrid + operation_evidence
        # One definition plus one call for CUDA, Metal, and Vulkan.
        expect(implementation.split(
            "x25519_mlkem768_verify_gpu_keygen(").len()).to_equal(5)
        expect(implementation.split(
            "x25519_mlkem768_verify_gpu_encapsulate(").len()).to_equal(5)
        expect(implementation.split(
            "x25519_mlkem768_verify_gpu_decapsulate(").len()).to_equal(5)
        # Nine successful operation paths must explicitly promote oracle parity.
        expect(hybrid.split(
            "final_evidence.oracle_match = true").len()).to_equal(10)
        expect(operation_evidence).to_contain(
            "GPU key generation failed scalar verification")
        expect(operation_evidence).to_contain(
            "GPU encapsulation failed scalar verification")
        expect(operation_evidence).to_contain(
            "GPU decapsulation failed scalar verification")

    it "should expose all three unpromoted Vulkan hybrid candidate operations":
        step("Inspect key generation, encapsulation, and decapsulation exports")
        val hybrid = file_read_text(
            "src/os/crypto/x25519_mlkem768/hybrid.spl")
        expect(hybrid).to_contain(
            "fn x25519_mlkem768_keygen_vulkan_candidate")
        expect(hybrid).to_contain(
            "fn x25519_mlkem768_encapsulate_vulkan_candidate")
        expect(hybrid).to_contain(
            "fn x25519_mlkem768_decapsulate_vulkan_candidate")
        expect(hybrid).to_contain(
            "x25519_mlkem768_resolve_vulkan_candidate")
