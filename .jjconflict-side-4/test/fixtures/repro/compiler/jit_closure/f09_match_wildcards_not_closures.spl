# Fixture f09 — NEGATIVE control for the checker.
#
# Enum pattern-match wildcards `Variant(_)` are NOT placeholder closures. An
# early revision of check-jit-closure-blockers.shs flagged 11 of these in
# browser_engine/js/values.spl, which would have trained readers to ignore the
# checker. This fixture must stay UNFLAGGED.
#
# It also must not be flagged as a lambda: the escaped quote below is exactly
# the shape (`"\""`) that broke the checker's string-stripping and made
# `\"width:` inside an HTML string read as the lambda `\ident:`.
#
# Being unflagged is a CHECKER property; this file also has no lambda at all,
# so it must additionally JIT-compile with no interpreter fallback.

enum JsVal:
    Bool(b: bool)
    Num(n: i64)
    Str(s: text)

fn kind(v: JsVal) -> text:
    match v:
        case JsVal.Bool(_): "boolean"
        case JsVal.Num(_): "number"
        case JsVal.Str(_): "string"

fn quote_char() -> text:
    "\""

fn main():
    val k = kind(JsVal.Num(n: 1))
    val q = quote_char()
    print("f09 marker kind={k} quote_len={q.len()}")
