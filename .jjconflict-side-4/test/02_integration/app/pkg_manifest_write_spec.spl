use std.spec.{describe, it, expect}
use app.pkg.main.{_write_manifest}
use app.io.mod.{file_delete, file_exists, file_read}

extern fn rt_getpid() -> i64

val suffix = str(rt_getpid())
val MANIFEST_PATH = "/tmp/pkg_manifest_hostile\";id>pkg_manifest_sentinel_" + suffix + ";#"
val SENTINEL_PATH = "pkg_manifest_sentinel_" + suffix

describe "pkg manifest writing":
    it "writes hostile paths and apostrophes without invoking a shell":
        file_delete(MANIFEST_PATH)
        file_delete(SENTINEL_PATH)
        val content = "owner = \"O'Reilly\"\n"
        expect(_write_manifest(MANIFEST_PATH, content)).to_equal(true)
        expect(file_exists(MANIFEST_PATH)).to_equal(true)
        expect(file_read(MANIFEST_PATH)).to_equal(content)
        expect(file_read(MANIFEST_PATH) != "").to_equal(true)
        expect(file_exists(SENTINEL_PATH)).to_equal(false)
        file_delete(MANIFEST_PATH)
