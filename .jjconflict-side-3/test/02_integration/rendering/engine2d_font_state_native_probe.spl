use std.gc_async_mut.gpu.engine2d.engine.{Engine2D}
use std.nogc_sync_mut.sffi.spl_fonts.{font_rasterizer_void_transport_probe}

val BUNGEE_PATH = "assets/fonts/google-fonts/ofl/bungee/Bungee-Regular.ttf"
val BUNGEE_IDENTITY = "sha256=c4f5361ce120af3e6b9156d0bf379fa19cda2ea0cd18ac01fd99596c6bf66e3f;axes=static"

fn main() -> i64:
    if not font_rasterizer_void_transport_probe():
        print("engine2d_font_state_native_status=fail-void-transport")
        return 44
    var engine = Engine2D.create_with_backend(640, 320, "software")
    if not engine.load_font(BUNGEE_PATH):
        print("engine2d_font_state_native_status=fail-load")
        return 1
    if not engine.font_receipt_identity_matches(BUNGEE_IDENTITY):
        print("engine2d_font_state_native_status=fail-identity")
        return 2
    val font_points: i32 = 24
    val font_dpi: i32 = 300
    val font_size_24pt_300dpi: i32 = (font_points * font_dpi + 36) / 72
    if font_size_24pt_300dpi != 100:
        print("engine2d_font_state_native_status=fail-300-dpi-size")
        return 3
    if not engine.font_receipt_reset_cache_stats():
        print("engine2d_font_state_native_status=fail-cold-reset")
        return 4
    val cold_ok = engine.draw_text_points_dpi(
        8, 8, "BUNGEE", 0xffffffffu32, font_points, font_dpi)
    if not cold_ok:
        print("engine2d_font_state_native_status=fail-cold-draw")
        return 5
    if not engine.font_receipt_size_100px():
        print("engine2d_font_state_native_status=fail-cold-size")
        return 6
    if not engine.font_receipt_plan_admitted():
        print("engine2d_font_state_native_status=fail-cold-plan")
        return 7
    if not engine.font_receipt_staged_valid():
        print("engine2d_font_state_native_status=fail-staged-valid")
        return 8
    if not engine.font_receipt_text_phase_layout_nonempty(true):
        print("engine2d_font_state_native_status=fail-text-layout")
        return 26
    if not engine.font_receipt_glyph_phase_rasterizer_maps(true):
        print("engine2d_font_state_native_status=fail-glyph-rasterizer-map")
        return 30
    if not engine.font_receipt_glyph_phase_bitmap_non_nil(true):
        print("engine2d_font_state_native_status=fail-glyph-bitmap-return")
        return 31
    if not engine.font_receipt_glyph_phase_bitmap_positive(true):
        print("engine2d_font_state_native_status=fail-glyph-bitmap-size")
        return 32
    if not engine.font_receipt_glyph_phase_bitmap_pixels_match(true):
        print("engine2d_font_state_native_status=fail-glyph-bitmap-pixels")
        return 33
    if not engine.font_receipt_glyph_phase_adapter_positive(true):
        print("engine2d_font_state_native_status=fail-glyph-adapter-size")
        return 34
    if not engine.font_receipt_glyph_phase_adapter_pixels_match(true):
        print("engine2d_font_state_native_status=fail-glyph-adapter-pixels")
        return 35
    if not engine.font_receipt_glyph_phase_reconstructed_positive(true):
        print("engine2d_font_state_native_status=fail-glyph-reconstructed")
        return 36
    if not engine.font_receipt_glyph_phase_return_positive(true):
        print("engine2d_font_state_native_status=fail-glyph-return-local")
        return 37
    if not engine.font_receipt_text_phase_fallback_glyph_positive(true):
        print("engine2d_font_state_native_status=fail-glyph-first-caller")
        return 38
    if not engine.font_receipt_glyph_phase_cache_hit(true):
        print("engine2d_font_state_native_status=fail-glyph-cache-hit")
        return 39
    if not engine.font_receipt_glyph_phase_cache_hit_positive(true):
        print("engine2d_font_state_native_status=fail-glyph-cache-hit-positive")
        return 40
    if not engine.font_receipt_text_phase_glyph_positive(true):
        print("engine2d_font_state_native_status=fail-text-glyph")
        return 27
    if not engine.font_receipt_text_phase_atlas_index_valid(true):
        print("engine2d_font_state_native_status=fail-text-atlas-index")
        return 28
    if not engine.font_receipt_text_phase_quad_appended(true):
        print("engine2d_font_state_native_status=fail-text-quad-append")
        return 29
    if not engine.font_receipt_quad_phase_local_nonempty(true):
        print("engine2d_font_state_native_status=fail-local-quads")
        return 23
    if not engine.font_receipt_quad_phase_inbound_nonempty(true):
        print("engine2d_font_state_native_status=fail-inbound-quads")
        return 24
    if not engine.font_receipt_quad_phase_stored_nonempty(true):
        print("engine2d_font_state_native_status=fail-stored-quads")
        return 25
    if not engine.font_receipt_staged_quads_nonempty():
        print("engine2d_font_state_native_status=fail-positive-quads")
        return 9
    if not engine.font_receipt_staged_atlas_nonempty():
        print("engine2d_font_state_native_status=fail-atlas-nonempty")
        return 10
    if not engine.font_receipt_staged_atlas_has_alpha():
        print("engine2d_font_state_native_status=fail-atlas-alpha")
        return 11
    if not engine.font_receipt_cache_rasterizations_positive():
        print("engine2d_font_state_native_status=fail-cold-cache")
        return 12
    if not engine.font_receipt_execution_target_cpu():
        print("engine2d_font_state_native_status=fail-cold-target")
        return 13
    if not engine.font_receipt_reset_cache_stats():
        print("engine2d_font_state_native_status=fail-warm-reset")
        return 14
    val warm_ok = engine.draw_text_points_dpi(
        8, 140, "BUNGEE", 0xffffffffu32, font_points, font_dpi)
    if not warm_ok:
        print("engine2d_font_state_native_status=fail-warm-draw")
        return 15
    if not engine.font_receipt_plan_admitted():
        print("engine2d_font_state_native_status=fail-warm-plan")
        return 16
    if not engine.font_receipt_size_100px():
        print("engine2d_font_state_native_status=fail-warm-size")
        return 17
    if not engine.font_receipt_staged_valid():
        print("engine2d_font_state_native_status=fail-warm-valid")
        return 18
    if not engine.font_receipt_staged_quads_nonempty():
        print("engine2d_font_state_native_status=fail-warm-stage")
        return 19
    if not engine.font_receipt_cache_rasterizations_zero():
        print("engine2d_font_state_native_status=fail-warm-cache")
        return 20
    if not engine.font_receipt_cache_hits_positive():
        print("engine2d_font_state_native_status=fail-warm-hits")
        return 21
    if not engine.font_receipt_execution_target_cpu():
        print("engine2d_font_state_native_status=fail-warm-target")
        return 22
    engine.shutdown()
    print("engine2d_font_state_native_status=pass")
    0
