#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd)
source_dir="$root/src/os/kernel/arch/arm32/cosmos"
test_source="$root/test/02_integration/os/cosmos/cosmos_pcie_contract_test.c"
build_dir=$(mktemp -d "${TMPDIR:-/tmp}/cosmos-pcie-auto-cpl.XXXXXX")
trap 'rm -rf "$build_dir"' EXIT HUP INT TERM

common_flags='-std=c11 -O2 -Wall -Wextra -Werror -Wpedantic -Wshadow -Wstrict-prototypes -Wformat=2 -Wno-unused-function'

profile="$source_dir/cosmos_profile_openssd2_8ch8way_v300.h"

cc $common_flags -DCOSMOS_SILICON=1 -DCOSMOS_MMIO_TEST=1 \
    -DCOSMOS_POLL_LIMIT=4U \
    -DCOSMOS_PCIE_BITSTREAM_CONTRACT=0x030000U \
    -DCOSMOS_PCIE_AUTO_COMPLETION_ONLY=1 -I"$source_dir" \
    -include "$profile" \
    "$test_source" "$source_dir/cosmos_pcie.c" \
    -o "$build_dir/cosmos_pcie_auto_completion_test"
"$build_dir/cosmos_pcie_auto_completion_test"

clang --target=armv7-none-eabi -mcpu=cortex-a9 -marm \
    -ffreestanding -nostdlib -fno-builtin $common_flags \
    -DCOSMOS_SILICON=1 -DCOSMOS_PCIE_BITSTREAM_CONTRACT=0x030000U \
    -include "$profile" -I"$source_dir" \
    -c "$source_dir/cosmos_pcie.c" \
    -o "$build_dir/cosmos_pcie.arm.o"

echo "cosmos PCIe AUTO completion ARM compile: PASS"
