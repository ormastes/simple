# `match` on an enum dispatches to the correct arm for both unit-variant and
# payload-variant enums.
#
# Verified 2026-08-07: see
# doc/08_tracking/bug/match_on_enum_native_lowering_status_2026-08-07.md.
# The blanket "match on enum has no native lowering" claim is STALE for the
# JIT (default `bin/simple run`) and interpreter (`SIMPLE_EXECUTION_MODE=
# interpret`) lanes -- both dispatch correctly for unit AND payload variants,
# confirmed live via Cranelift CLIF IR + a sabotage check. It is CURRENT but
# NARROWED for `--native` (LLVM AOT, `simple compile --native`): payload-free
# enum matches compile and run; payload-bearing enum matches are still
# fail-closed-refused ("constructs that require the interpreter: [PatternMatch]").
#
# Interpreter-lane caveat (doc/.claude/rules/testing.md): `bin/simple test`
# hard-defaults to the tree-walk interpreter, not the Cranelift JIT that
# `bin/simple run` uses by default -- so this spec exercises the interpreter
# lane only. The JIT lane and the `--native` AOT refusal are covered by the
# manual probe recorded in the bug doc above, not by this in-process spec.

enum Kind:
    A
    B
    C

enum Shape:
    Circle(f64)
    Rect(f64, f64)
    Point

fn describe_kind(k: Kind) -> text:
    match k:
        case Kind.A: return "kind-A"
        case Kind.B: return "kind-B"
        case Kind.C: return "kind-C"
        case _: return "kind-unknown"

fn describe_shape(s: Shape) -> text:
    match s:
        case Shape.Circle(r): return "circle:" + r.to_text()
        case Shape.Rect(w, h): return "rect:" + w.to_text() + "x" + h.to_text()
        case Shape.Point: return "point"
        case _: return "shape-unknown"

describe "match on enum -- unit variants":
    it "dispatches Kind.A to the A arm":
        expect(describe_kind(Kind.A)).to_equal("kind-A")

    it "dispatches Kind.B to the B arm":
        expect(describe_kind(Kind.B)).to_equal("kind-B")

    it "dispatches Kind.C to the C arm":
        expect(describe_kind(Kind.C)).to_equal("kind-C")

describe "match on enum -- payload variants":
    it "dispatches Circle(r) and binds the payload":
        expect(describe_shape(Shape.Circle(2.5))).to_equal("circle:2.5")

    it "dispatches Rect(w, h) and binds both payload fields":
        expect(describe_shape(Shape.Rect(3.0, 4.0))).to_equal("rect:3.0x4.0")

    it "dispatches the unit-variant Point arm among payload siblings":
        expect(describe_shape(Shape.Point)).to_equal("point")

describe "match on enum -- wildcard arm does not steal a matching case":
    it "does not fall through Kind.C to the wildcard":
        var hit_wildcard = false
        match Kind.C:
            case Kind.A: hit_wildcard = false
            case Kind.B: hit_wildcard = false
            case Kind.C: hit_wildcard = false
            case _: hit_wildcard = true
        expect(hit_wildcard).to_equal(false)

    it "takes the wildcard only when no prior arm matches (out-of-band value via helper)":
        var seen = "unset"
        match Shape.Point:
            case Shape.Circle(_): seen = "circle"
            case Shape.Rect(_, _): seen = "rect"
            case _: seen = "wildcard"
        # Point has its own arm above Shape's match in describe_shape, but this
        # inline match omits it deliberately to prove the wildcard still
        # catches an unmatched payload-enum variant rather than silently
        # falling through (doc/08_tracking/bug/match_enum_fallthrough_silent_2026-08-01.md).
        expect(seen).to_equal("wildcard")
