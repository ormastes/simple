# @cover src/lib/nogc_sync_mut/test_runner/test_executor_parsing.spl 0%
"""
# Child process exit-1 poisons file-level status — minimal repro (Symptom 1)

Pinning spec for
`doc/08_tracking/bug/test_runner_masks_child_and_expectation_failures_2026-07-02.md`.

A spec that legitimately spawns a child process which exits nonzero (a
normal, intentional pattern for asserting a fail-closed CLI flag) must not
cause the whole file to be marked FAILED when every real `expect(...)`
inside the file passes. This spec's only child process call intentionally
spawns `node -e "process.exit(1)"` and asserts on the returned exit code —
that assertion passing IS the correct behavior.
"""

use std.spipe.*
use app.io.mod.{process_run_timeout}

describe "child process nonzero exit inspected by a passing expectation":
    it "spawns a child that exits 1 and correctly asserts on it":
        val result = process_run_timeout("node", ["-e", "process.exit(1)"], 10000)
        expect(result.2).to_equal(1)
        expect(1 + 1).to_equal(2)
