"""GPU interpreter destroy calls preserve the Simple bool ABI."""

use std.spec.{describe, it, expect}

extern fn rt_file_read_text(path: text) -> text

describe "GPU destroy bool ABI":
    it "returns booleans for Vulkan and Metal resource destruction":
        val source = rt_file_read_text("src/compiler_rust/compiler/src/interpreter_extern/gpu.rs")

        val vulkan_shader_start = source.index_of("pub fn rt_vulkan_destroy_shader_fn")
        val vulkan_pipeline_start = source.index_of("pub fn rt_vulkan_destroy_pipeline_fn")
        expect(vulkan_shader_start).to_be_greater_than(-1)
        expect(vulkan_pipeline_start).to_be_greater_than(vulkan_shader_start)
        val vulkan_shader = source.substring(vulkan_shader_start, vulkan_pipeline_start)
        val vulkan_pipeline = source.substring(vulkan_pipeline_start, source.len())
        expect(vulkan_shader).to_contain("return Ok(Value::Bool(true))")
        expect(vulkan_shader).to_contain("Ok(Value::Bool(false))")
        expect(vulkan_pipeline).to_contain("return Ok(Value::Bool(true))")
        expect(vulkan_pipeline).to_contain("Ok(Value::Bool(false))")

        val metal_shader_start = source.index_of("pub fn rt_metal_destroy_shader_fn")
        val metal_pipeline_start = source.index_of("pub fn rt_metal_destroy_pipeline_fn")
        expect(metal_shader_start).to_be_greater_than(-1)
        expect(metal_pipeline_start).to_be_greater_than(metal_shader_start)
        val metal_shader = source.substring(metal_shader_start, metal_pipeline_start)
        val metal_pipeline = source.substring(metal_pipeline_start, vulkan_shader_start)
        expect(metal_shader).to_contain("Ok(Value::Bool(rt_metal_destroy_shader")
        expect(metal_shader).to_contain(")?) != 0))")
        expect(metal_pipeline).to_contain("Ok(Value::Bool(rt_metal_destroy_pipeline")
        expect(metal_pipeline).to_contain(")?) != 0))")
