# @cover src/lib/nogc_sync_mut/text_layout/font_rasterizer.spl 10%
# @tag: unit, ui, font, rasterization
#
# Glyph slot-probe loop spec. The backend glyph env protocol publishes
# GLYPH_COUNT slots; the probe loops were previously unrolled with silent
# hardcoded caps (vector: 8 slots, bitmap: 4 slots) so a payload published at a
# higher slot index was dropped without any signal. The loop honors GLYPH_COUNT
# up to the explicit shared _FONT_GLYPH_SLOT_CAP bound.

use std.spec.{describe, it, expect}
use common.text_layout.font_rasterizer.{rasterize_bitmap_accelerated, reset_bitmap_font_raster_stats, bitmap_font_accelerator_stats}

extern fn rt_env_set(key: text, value: text) -> bool

# Local replica of font_rasterizer `_vector_font_pixels_checksum` (private there).
fn _bitmap_checksum(pixels: [u8], width: i32, height: i32, advance: i32) -> i64:
    var sum: i64 = 0
    var i = 0
    while i < pixels.len():
        val alpha = pixels[i].to_i32().to_i64()
        if alpha > 0:
            sum = sum + alpha * ((i + 1) as i64)
        i = i + 1
    sum + (width.to_i64() * 31) + (height.to_i64() * 17) + advance.to_i64()

fn _set_rocm_bitmap_slot5_payload():
    var px: [u8] = [255u8, 0u8, 0u8, 255u8]
    val checksum = _bitmap_checksum(px, 2, 2, 3)
    rt_env_set("ROCM_BITMAP_FONT_STATUS", "pass")
    rt_env_set("ROCM_BITMAP_FONT_REASON", "rocm-bitmap-font-glyph-pixels-returned")
    rt_env_set("ROCM_BITMAP_FONT_GLYPH_COUNT", "6")
    rt_env_set("ROCM_BITMAP_FONT_GLYPH_5_CODEPOINT", "66")
    rt_env_set("ROCM_BITMAP_FONT_GLYPH_5_FONT_SIZE", "16")
    rt_env_set("ROCM_BITMAP_FONT_GLYPH_5_WIDTH", "2")
    rt_env_set("ROCM_BITMAP_FONT_GLYPH_5_HEIGHT", "2")
    rt_env_set("ROCM_BITMAP_FONT_GLYPH_5_ADVANCE", "3")
    rt_env_set("ROCM_BITMAP_FONT_GLYPH_5_PIXELS", "255,0,0,255")
    rt_env_set("ROCM_BITMAP_FONT_GLYPH_5_CHECKSUM", checksum.to_text())

fn _clear_rocm_bitmap_slot5_payload():
    rt_env_set("ROCM_BITMAP_FONT_STATUS", "")
    rt_env_set("ROCM_BITMAP_FONT_REASON", "")
    rt_env_set("ROCM_BITMAP_FONT_GLYPH_COUNT", "")
    rt_env_set("ROCM_BITMAP_FONT_GLYPH_5_CODEPOINT", "")
    rt_env_set("ROCM_BITMAP_FONT_GLYPH_5_FONT_SIZE", "")
    rt_env_set("ROCM_BITMAP_FONT_GLYPH_5_WIDTH", "")
    rt_env_set("ROCM_BITMAP_FONT_GLYPH_5_HEIGHT", "")
    rt_env_set("ROCM_BITMAP_FONT_GLYPH_5_ADVANCE", "")
    rt_env_set("ROCM_BITMAP_FONT_GLYPH_5_PIXELS", "")
    rt_env_set("ROCM_BITMAP_FONT_GLYPH_5_CHECKSUM", "")

describe "backend glyph slot-probe loop":
    it "finds a bitmap glyph published at slot 5 (beyond the old 4-slot unroll cap)":
        _set_rocm_bitmap_slot5_payload()
        reset_bitmap_font_raster_stats()
        val glyph = rasterize_bitmap_accelerated(66, 16)
        _clear_rocm_bitmap_slot5_payload()
        # The env-published glyph is 2x2/advance 3; the CPU-fallback VGA glyph
        # would be 8x16/advance 8 — so these dimensions prove slot 5 was probed.
        expect(glyph.width).to_equal(2)
        expect(glyph.height).to_equal(2)
        expect(glyph.advance).to_equal(3)
        val stats = bitmap_font_accelerator_stats()
        expect(stats.gpu_returned_glyphs).to_equal(1)
        expect(stats.cpu_fallback_hits).to_equal(0)

    it "falls back to CPU when GLYPH_COUNT is huge but no slot matches (cap bounds the probe)":
        _set_rocm_bitmap_slot5_payload()
        rt_env_set("ROCM_BITMAP_FONT_GLYPH_COUNT", "1000000")
        reset_bitmap_font_raster_stats()
        # Codepoint 67 matches no published slot; the loop must terminate at the
        # slot cap and take the deterministic CPU fallback.
        val glyph = rasterize_bitmap_accelerated(67, 16)
        _clear_rocm_bitmap_slot5_payload()
        expect(glyph.width).to_equal(8)
        expect(glyph.height).to_equal(16)
        val stats = bitmap_font_accelerator_stats()
        expect(stats.cpu_fallback_hits).to_equal(1)
        expect(stats.gpu_returned_glyphs).to_equal(0)
