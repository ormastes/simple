use std.spec
use std.io_runtime.{file_read}

describe "MIR module lowering strict shared bindings":
    it "derives static initializers and call symbols without reassignment":
        val source = file_read("src/compiler/50.mir/_MirLowering/module_lowering.spl")

        expect(source).to_contain("val init_const: MirConstant? = match folded:")
        expect(source).to_contain("val callee_symbol: SymbolId? = match callee.kind:")
        expect(source.contains("var init_const: MirConstant? = nil")).to_equal(false)
        expect(source.contains("var callee_symbol: SymbolId? = nil")).to_equal(false)
