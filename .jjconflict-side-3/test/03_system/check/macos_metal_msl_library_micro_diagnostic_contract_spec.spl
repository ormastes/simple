use std.io.{file_read}
use std.spec.{describe, it, expect}

val PROBE = "test/02_integration/rendering/macos_metal_msl_library_micro_diagnostic.spl"
val CHECKER = "scripts/check/check-macos-metal-msl-library-micro-diagnostic.shs"
val ADMISSION = "scripts/check/lib/macos-gpu-trusted-build-admission.shs"
val BUILDER = "scripts/check/build-macos-gpu-2d-live-native.shs"

describe "macOS Metal MSL library micro diagnostic":
    it "uses the exact Engine2D source and stops at library creation":
        val probe = file_read(PROBE)
        expect(probe).to_contain("_engine2d_msl()")
        expect(probe).to_contain("sha256_text(source)")
        expect(probe).to_contain("metal_sffi_compile_shader(device, source)")
        expect(probe).to_contain("metal_last_error()")
        expect(probe).to_contain("rt_metal_get_last_error() -> C pointer -> rt_cstring_to_text()")
        expect(probe).to_contain("metal_msl_library_probe_error_abi=typed-cstring-to-text")
        expect(probe).to_contain("metal_msl_library_probe_compiler_status=")
        expect(probe).to_contain("ERROR_MAX_BYTES: i64 = 1024")
        expect(probe).to_contain("clean.slice(0, ERROR_MAX_BYTES)")
        expect(probe).to_contain("metal_msl_library_probe_cpu_fallback=unused")
        expect(probe).to_contain("metal_msl_library_probe_window_system=unused")
        expect(probe.contains("metal_sffi_create_command_queue")).to_equal(false)
        expect(probe.contains("metal_sffi_create_compute_pipeline")).to_equal(false)
        expect(probe.contains("SoftwareBackend")).to_equal(false)
        expect(probe.contains("winit")).to_equal(false)

    it "binds trusted compiler and providers and bounds every child process":
        val checker = file_read(CHECKER)
        val admission = file_read(ADMISSION)
        val builder = file_read(BUILDER)
        expect(checker).to_contain("verify_trusted_manifest")
        expect(checker).to_contain("macos_gpu_trusted_manifest_admit")
        expect(checker).to_contain("MACOS_GPU_ADMISSION_COMPILER")
        expect(checker).to_contain("MACOS_GPU_ADMISSION_PROVIDER")
        expect(checker).to_contain("MACOS_GPU_ADMISSION_RUNTIME_C_PROVIDER")
        expect(checker.contains("METAL_MSL_DIAGNOSTIC_TRUSTED_MANIFEST")).to_equal(false)
        expect(builder).to_contain("COMPILER_IDENTITY=\"canonical-pure-simple-stage3-with-bound-backfill-v1\"")
        expect(builder).to_contain("build_compiler_source_kind=canonical-pure-simple-bootstrap-stage3")
        expect(admission).to_contain("build-macos-gpu-2d-live-native.shs")
        expect(admission).to_contain("--verify \"$macos_gpu_admission_backend\"")
        expect(admission).to_contain("source_input_fingerprint")
        expect(admission).to_contain("repo_revision")
        expect(builder).to_contain("build_args_sha256")
        expect(builder).to_contain("build_environment_sha256")
        expect(admission).to_contain("simple_runtime_provider_sha256")
        expect(admission).to_contain("simple_runtime_c_provider_sha256")
        expect(builder).to_contain("compiler-admission.*/simple")
        expect(admission).to_contain("[ -x \"$MACOS_GPU_ADMISSION_COMPILER\" ]")
        expect(admission).to_contain("[ ! -L \"$MACOS_GPU_ADMISSION_COMPILER\" ]")
        expect(admission).to_contain("grep -Fqx")
        expect(admission).to_contain("WARNING: this Rust-built Simple binary is a bootstrap seed only")
        expect(admission.contains("Rust-built|bootstrap seed only|debug build")).to_equal(false)
        expect(checker).to_contain("SIMPLE_NO_STUB_FALLBACK=1")
        expect(checker).to_contain("SIMPLE_LINK_OBJECTS=\"$PROVIDER:$RUNTIME_C_PROVIDER\"")
        expect(checker).to_contain("run_bounded_process")
        expect(checker).to_contain("probe_output_schema_valid")
        expect(checker).to_contain("probe_output_success_valid")
        expect(checker).to_contain("STREAM_MAX_BYTES=8256")
        expect(checker).to_contain("native-build-timeout")
        expect(checker).to_contain("probe-timeout")
        expect(checker).to_contain("setsid")
        expect(checker).to_contain("terminate_process_group")
        expect(checker).to_contain("terminate_filter")
        expect(checker).to_contain("drain_failed")
        expect(checker).to_contain("DYLD_PRINT_LIBRARIES=1")
        expect(checker).to_contain("provider-dyld-resolution-missing")
        expect(checker).to_contain("_rt_metal_compile_shader")
        expect(checker).to_contain("_rt_metal_get_last_error")
        expect(checker.contains("check-macos-metal-2d-live-evidence.shs")).to_equal(false)
        expect(checker.contains(">\"$BUILD_STDERR\" 2>&1")).to_equal(false)
        expect(checker).to_contain("metal_msl_library_probe_status \"$PROBE_STDOUT\")\" = pass")
        expect(checker).to_contain("metal_msl_library_probe_library_destroyed=1")
        expect(checker).to_contain("metal_msl_library_probe_device_destroyed=1")
