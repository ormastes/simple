fn get_via_list_param(l: list, i: i64) -> i64:
    return l[i]

fn get_via_typed_param(l: [i64], i: i64) -> i64:
    return l[i]

fn main():
    var buf: [i64] = [5, 7, 9]
    print("typed0={get_via_typed_param(buf, 0)}\n")
    print("typed1={get_via_typed_param(buf, 1)}\n")
    print("list0={get_via_list_param(buf, 0)}\n")
    print("list1={get_via_list_param(buf, 1)}\n")
