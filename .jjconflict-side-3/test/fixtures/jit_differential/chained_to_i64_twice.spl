# Known bug: a 2+-hop chained call ending in .to_i64() appearing twice in one
# function returns garbage under the default (Cranelift JIT) engine, always
# exactly 32 apart. See memory reference
# reference_jit_chained_method_to_i64_returns_garbage.md and
# test/01_unit/lib/language/chained_method_i64_conversion_spec.spl.
# Expected (interpreter, correct): pw=480 ph=360
fn main():
    val a = "480"
    val b = "360"
    val pw = a.trim().to_i64()
    val ph = b.trim().to_i64()
    print("pw={pw} ph={ph}")
