@allow(unnamed_duplicate_typed_args) # reason: positional API -- arg order is conventional
# JWT Encoding Module
#
# This module handles Base64URL encoding and JSON encoding operations.

# ============================================================================
# Base64URL Encoding/Decoding
# ============================================================================

# Base64 character set
fn base64_chars() -> text:
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

# Base64URL character set (replaces + with -, / with _)
fn base64url_chars() -> text:
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

# Get character index in Base64 alphabet
fn base64_char_index(c: text, alphabet: text) -> i64:
    var i = 0
    var len = alphabet.length()
    while i < len:
        var ch = alphabet.substring(i, i + 1)
        if ch == c:
            return i
        i = i + 1
    return -1

# Encode bytes to Base64
fn base64_encode(data: text) -> text:
    var parts: [text] = []
    var alphabet = base64_chars()
    var len = data.length()
    var i = 0

    while i < len:
        var b1 = data.char_code_at(i)
        var b2 = 0
        var b3 = 0

        if i + 1 < len:
            b2 = data.char_code_at(i + 1)
        if i + 2 < len:
            b3 = data.char_code_at(i + 2)

        # Convert 3 bytes to 4 Base64 characters
        var idx1 = b1 >> 2
        var idx2 = ((b1 & 3) << 4) | (b2 >> 4)
        var idx3 = ((b2 & 15) << 2) | (b3 >> 6)
        var idx4 = b3 & 63

        var c1 = alphabet.substring(idx1, idx1 + 1)
        parts.push(c1)
        var c2 = alphabet.substring(idx2, idx2 + 1)
        parts.push(c2)

        if i + 1 < len:
            var c3 = alphabet.substring(idx3, idx3 + 1)
            parts.push(c3)
        else:
            parts.push("=")

        if i + 2 < len:
            var c4 = alphabet.substring(idx4, idx4 + 1)
            parts.push(c4)
        else:
            parts.push("=")

        i = i + 3

    return parts.join("")

# Decode Base64 to bytes
fn base64_decode(encoded: text) -> text:
    var alphabet = base64_chars()
    var parts: [text] = []
    var i = 0

    # Remove padding
    var raw_clean = encoded.replace("=", "")
    var clean = ""
    var ci = 0
    while ci < raw_clean.length():
        val ch = raw_clean.substring(ci, ci + 1)
        if base64_char_index(ch, alphabet) >= 0:
            clean = clean + ch
        ci = ci + 1
    var clean_len = clean.length()

    while i < clean_len:
        var c1 = clean.substring(i, i + 1)
        var idx1 = base64_char_index(c1, alphabet)

        if i + 1 >= clean_len:
            break

        var c2 = clean.substring(i + 1, i + 2)
        var idx2 = base64_char_index(c2, alphabet)

        # First byte
        var b1 = (idx1 << 2) | (idx2 >> 4)
        parts.push(b1.chr())

        if i + 2 < clean_len:
            var c3 = clean.substring(i + 2, i + 3)
            var idx3 = base64_char_index(c3, alphabet)
            var b2 = ((idx2 & 15) << 4) | (idx3 >> 2)
            parts.push(b2.chr())

        if i + 3 < clean_len:
            var c4 = clean.substring(i + 3, i + 4)
            var idx4 = base64_char_index(c4, alphabet)
            var b3 = ((idx3 & 3) << 6) | idx4
            parts.push(b3.chr())

        i = i + 4

    return parts.join("")

# Encode to Base64URL (URL-safe Base64 without padding)
fn base64url_encode(data: text) -> text:
    var b64 = base64_encode(data)
    var result = b64.replace("+", "-")
    result = result.replace("/", "_")
    result = result.replace("=", "")
    return result

# Decode from Base64URL
fn base64url_decode(encoded: text) -> text:
    var b64 = encoded.replace("-", "+")
    b64 = b64.replace("_", "/")

    # Add padding
    var mod = b64.length() % 4
    if mod == 2:
        b64 = b64 + "=="
    if mod == 3:
        b64 = b64 + "="

    return base64_decode(b64)

# Encode bytes ([u8]) to Base64URL (URL-safe, no padding)
# Used for JWT second/third segment where signature is raw bytes.
fn base64url_encode_bytes(data: [u8]) -> text:
    var parts: [text] = []
    var alphabet = base64url_chars()
    var len = data.len()
    var i = 0

    while i < len:
        var b1 = data[i].to_i64()
        var b2 = 0
        var b3 = 0

        if i + 1 < len:
            b2 = data[i + 1].to_i64()
        if i + 2 < len:
            b3 = data[i + 2].to_i64()

        var idx1 = b1 >> 2
        var idx2 = ((b1 & 3) << 4) | (b2 >> 4)
        var idx3 = ((b2 & 15) << 2) | (b3 >> 6)
        var idx4 = b3 & 63

        parts.push(alphabet.substring(idx1, idx1 + 1))
        parts.push(alphabet.substring(idx2, idx2 + 1))

        if i + 1 < len:
            parts.push(alphabet.substring(idx3, idx3 + 1))
        if i + 2 < len:
            parts.push(alphabet.substring(idx4, idx4 + 1))

        i = i + 3

    parts.join("")

# Decode Base64URL string to bytes ([u8])
fn base64url_decode_to_bytes(encoded: text) -> [u8]:
    var b64 = encoded.replace("-", "+")
    b64 = b64.replace("_", "/")

    # Add padding
    var mod = b64.length() % 4
    if mod == 2:
        b64 = b64 + "=="
    if mod == 3:
        b64 = b64 + "="

    var alphabet = base64_chars()
    var result: [u8] = []
    var raw_clean = b64.replace("=", "")
    var clean = ""
    var ci = 0
    while ci < raw_clean.length():
        val ch = raw_clean.substring(ci, ci + 1)
        if base64_char_index(ch, alphabet) >= 0:
            clean = clean + ch
        ci = ci + 1
    var clean_len = clean.length()
    var i = 0

    while i < clean_len:
        var idx1 = base64_char_index(clean.substring(i, i + 1), alphabet)

        if i + 1 >= clean_len:
            break

        var idx2 = base64_char_index(clean.substring(i + 1, i + 2), alphabet)
        var byte1 = ((idx1 << 2) | (idx2 >> 4)) & 0xFF
        result.push(byte1.to_u8())

        if i + 2 < clean_len:
            var idx3 = base64_char_index(clean.substring(i + 2, i + 3), alphabet)
            var byte2 = (((idx2 & 15) << 4) | (idx3 >> 2)) & 0xFF
            result.push(byte2.to_u8())

        if i + 3 < clean_len:
            var idx4 = base64_char_index(clean.substring(i + 3, i + 4), alphabet)
            var byte3 = (((idx3 & 3) << 6) | idx4) & 0xFF
            result.push(byte3.to_u8())

        i = i + 4

    result

# Encode text as UTF-8 bytes then base64url — for header/payload segments
fn base64url_encode_text(data: text) -> text:
    base64url_encode(data)

# Strip Base64 padding
fn strip_padding(encoded: text) -> text:
    return encoded.replace("=", "")

# Add Base64 padding
fn pad_base64(encoded: text) -> text:
    var mod = encoded.length() % 4
    if mod == 0:
        return encoded
    if mod == 2:
        return encoded + "=="
    if mod == 3:
        return encoded + "="
    return encoded

# ============================================================================
# JSON Encoding/Decoding
# ============================================================================

# Escape string for JSON
fn json_escape_string(s: text) -> text:
    var result = s
    result = result.replace("\\", "\\\\")
    result = result.replace("\"", "\\\"")
    result = result.replace("\n", "\\n")
    result = result.replace("\r", "\\r")
    result = result.replace("\t", "\\t")
    return result

# Encode list of tuples to JSON object
fn json_encode_object(tuples: list) -> text:
    var parts: [text] = []
    var i = 0
    var len = tuples.length()

    while i < len:
        # Index access, not `.at()`: `.at()` is not a valid array/list method
        # in this codebase (only `text.at`/`char_at` exists — see
        # codegen/instr/calls.rs and interpreter_method/string.rs); the
        # original `.at()` calls here would themselves error out
        # ("method `at` not found on type `array`"), a second, independent
        # defect from the `text.from_any` one, confirmed via a standalone
        # probe before this fix.
        var tuple = tuples[i]
        var key = tuple[0]
        var value = tuple[1]

        var escaped_key = json_escape_string(key)

        # Encode value based on type. `.to_text()` (-> `rt_to_string`, the
        # universal Any-to-text runtime formatter that `to_string`/`str()`
        # also dispatch to throughout this codebase — see
        # codegen/instr/core.rs and codegen/llvm/functions/calls.rs) is the
        # canonical conversion here; `text.from_any` (the previous call)
        # does not exist anywhere as a Rust intrinsic or `.spl` function, so
        # this whole encoding path has never worked.
        #
        # Booleans need a dedicated branch: `.to_text()` on a `bool` read
        # back through this `Any`-typed `value` is itself corrupted by a
        # separate, real runtime bug (`true` renders as `"nil"`, `false` as
        # `"0"` — confirmed via a standalone probe; not present for direct
        # equality comparison on the same erased value, which is what the
        # `is_bool_true`/`is_bool_false` checks below use instead of
        # `.to_text()`). JSON booleans must also be emitted unquoted
        # (`true`/`false`), not as a numeric-vs-text digit-sniffed string,
        # so they get their own branch below rather than flowing through
        # the existing digit check.
        var is_bool_true = value == true
        var is_bool_false = value == false
        var value_str = ""
        if is_bool_true:
            value_str = "true"
        elif is_bool_false:
            value_str = "false"
        else:
            value_str = value.to_text()

        if is_bool_true or is_bool_false:
            parts.push("\"" + escaped_key + "\":" + value_str)
        else:
            # Check if value is numeric
            var first_char = ""
            if value_str.length() > 0:
                first_char = value_str.substring(0, 1)

            var is_digit = first_char == "0" or first_char == "1" or first_char == "2"
            is_digit = is_digit or first_char == "3" or first_char == "4"
            is_digit = is_digit or first_char == "5" or first_char == "6"
            is_digit = is_digit or first_char == "7" or first_char == "8"
            is_digit = is_digit or first_char == "9" or first_char == "-"

            if is_digit:
                parts.push("\"" + escaped_key + "\":" + value_str)
            else:
                var escaped_value = json_escape_string(value_str)
                parts.push("\"" + escaped_key + "\":\"" + escaped_value + "\"")

        i = i + 1

    return "{" + parts.join(",") + "}"

# Encode claims list to JSON
fn json_encode(claims: list) -> text:
    return json_encode_object(claims)

# Convert claims to JSON string (alias)
fn claims_to_json(claims: list) -> text:
    return json_encode(claims)

# Pretty-print JSON
fn json_stringify(claims: list) -> text:
    return json_encode(claims)
