# ============================================================================
# common/structural/resolve/style_link_receipts.spl — StageReceipt wiring for
# the WebResourceLinkProfile (StyleLinker) CPU-reference stages (Lane
# STYLERCPT), mirroring smf_link_receipts.spl exactly.
#
# Wires the frozen cross-stage receipt contract
# (`StageReceipt`, src/lib/common/compute/placement_contracts/backend.spl —
# REUSED, never redefined) onto the three StyleLinker CPU-reference steps
# that exist today: collect (style_collect_records), resolve (style_resolve)
# and link (style_link). Each `*_with_receipt` wrapper calls the frozen
# function unchanged and attaches one receipt keyed by a profile-local stage
# const (the SMF precedent keeps stage consts profile-owned; the contract
# doc is untouched):
#
#   collect -> STYLE_LINK_STAGE_COLLECT (0)  key "style_link.collect"
#   resolve -> STYLE_LINK_STAGE_RESOLVE (1)  key "style_link.resolve"
#   link    -> STYLE_LINK_STAGE_LINK    (2)  key "style_link.link"
#
# Receipt content is DETERMINISTIC ONLY: item counts and SHA-256 content
# roots over canonical serializations of the stage's inputs/outputs
# (crypto/sha256.spl — the same reuse rule resolve_core's `intern_name`
# follows). `elapsed_us`, `bytes_read` and `bytes_written` are always 0:
# this in-memory CPU slice performs no byte I/O and a wall-clock value would
# break run-to-run receipt equality (no timestamps by lane rule).
#
# The wrappers live HERE rather than inside style_link_profile.spl because
# this module must import the profile's types to hash the stage inputs —
# calls in the other direction would be a circular import. Callers that want
# receipts call the `*_with_receipt` entry points; the frozen underlying
# functions stay byte-for-byte untouched.
#
# Composition only, no inheritance (repo rule): plain value structs, free
# functions, same discipline as style_link_profile.spl.
# ============================================================================

use std.common.compute.placement_contracts.backend.{StageReceipt}
use std.common.compute.placement_contracts.semantic.{
    BackendId,
    ExecutionMode,
    Hash256,
    StageId
}
use std.common.crypto.sha256.{sha256_text}
use std.common.structural.resolve.resolve_types.{
    DefinitionRecord,
    ReferenceRecord,
    ResolutionRecord
}
use std.common.structural.resolve.style_link_profile.{
    StyleLinkInputs,
    StyleLinkResult,
    StyleSymbolInput,
    style_collect_records,
    style_link,
    style_resolve
}

# ----------------------------------------------------------------------------
# Profile-local stage consts + receipt identity constants. The stage consts
# are OWNED by this profile (contract doc untouched), exactly as the SMF
# profile owns its SMF_LINK_STAGE_L* consts.
# ----------------------------------------------------------------------------

val STYLE_LINK_STAGE_COLLECT: u32 = 0
val STYLE_LINK_STAGE_RESOLVE: u32 = 1
val STYLE_LINK_STAGE_LINK: u32 = 2

val STYLE_LINK_RECEIPT_BACKEND: text = "cpu_reference"
val STYLE_LINK_RECEIPT_SCHEMA: text = "style_link_receipt.v1"

fn _style_stage_name(stage: u32) -> text:
    """Stage-name text for a STYLE_LINK_STAGE_* const. Any other value maps
    to an explicit `invalid.<n>` marker that can never collide with a real
    stage key — a receipt keyed by it is visibly wrong, never silently
    plausible."""
    if stage == STYLE_LINK_STAGE_COLLECT:
        return "collect"
    if stage == STYLE_LINK_STAGE_RESOLVE:
        return "resolve"
    if stage == STYLE_LINK_STAGE_LINK:
        return "link"
    "invalid." + (stage as i64).to_text()

fn style_link_stage_id(stage: u32) -> StageId:
    """The `StageId` a StyleLinker receipt carries for profile-local stage
    const `stage`: `style_link.<stage-name>`. Pure text derivation from the
    const — the receipt key and the stage table can never drift apart."""
    StageId(value: "style_link." + _style_stage_name(stage))

# ----------------------------------------------------------------------------
# Outcome shapes — frozen result + its receipt, one per wrapped stage.
# ----------------------------------------------------------------------------

struct StyleCollectOutcome:
    """`style_collect_records` output plus its collect StageReceipt."""
    defs: [DefinitionRecord]
    refs: [ReferenceRecord]
    receipt: StageReceipt

struct StyleResolveOutcome:
    """`style_resolve` output plus its resolve StageReceipt."""
    results: [ResolutionRecord]
    receipt: StageReceipt

struct StyleLinkOutcome:
    """`style_link` output plus its link StageReceipt."""
    result: StyleLinkResult
    receipt: StageReceipt

# ----------------------------------------------------------------------------
# Canonical serializations (hash preimages). Field order is fixed; every
# record is terminated with `;` and every scalar separated with `,` so no
# two distinct record sequences share a preimage. All names are
# length-prefixed for the same reason.
# ----------------------------------------------------------------------------

fn _ser_bool(b: bool) -> text:
    if b: "1" else: "0"

fn _ser_name(name: text) -> text:
    val name_len = name.len() as i64
    name_len.to_text() + ":" + name

fn _ser_symbol_input(sym: StyleSymbolInput) -> text:
    var out = ("y:" + _ser_name(sym.name) +
        "," + (sym.space as i64).to_text() +
        "," + _ser_bool(sym.defined) +
        ",rn" + sym.referenced_names.len().to_text() + ":")
    for rn in sym.referenced_names:
        out = out + "n:" + _ser_name(rn) + ","
    out + ";"

fn _ser_style_inputs(tag: text, inputs: StyleLinkInputs) -> text:
    var out = tag + "|sheet:" + (inputs.sheet_index as i64).to_text() + "|"
    for sym in inputs.symbols:
        out = out + _ser_symbol_input(sym)
    out

fn _ser_def_or_ref(tag: text, key_hi: i64, key_lo: i64, space: i64, slot: i64, local: i64, attributes: i64, order: i64) -> text:
    (tag + ":" + key_hi.to_text() + "," + key_lo.to_text() +
        "," + space.to_text() + "," + slot.to_text() + "," + local.to_text() +
        "," + attributes.to_text() + "," + order.to_text() + ";")

fn _ser_definition(d: DefinitionRecord) -> text:
    _ser_def_or_ref(
        "d",
        d.key.name_hash.hi as i64,
        d.key.name_hash.lo as i64,
        d.key.space as i64,
        d.owner.object_slot as i64,
        d.owner.local_index as i64,
        d.attributes as i64,
        d.order as i64)

fn _ser_reference(r: ReferenceRecord) -> text:
    _ser_def_or_ref(
        "r",
        r.key.name_hash.hi as i64,
        r.key.name_hash.lo as i64,
        r.key.space as i64,
        r.owner.object_slot as i64,
        r.owner.local_index as i64,
        r.attributes as i64,
        r.order as i64)

fn _ser_records(defs: [DefinitionRecord], refs: [ReferenceRecord]) -> text:
    var out = "defs|"
    for d in defs:
        out = out + _ser_definition(d)
    out = out + "|refs|"
    for r in refs:
        out = out + _ser_reference(r)
    out

fn _ser_resolution(x: ResolutionRecord) -> text:
    ("x:" + (x.reference.object_slot as i64).to_text() +
        "," + (x.reference.local_index as i64).to_text() +
        "," + (x.definition.object_slot as i64).to_text() +
        "," + (x.definition.local_index as i64).to_text() +
        "," + (x.status as i64).to_text() +
        "," + (x.reason as i64).to_text() + ";")

fn _ser_resolutions(results: [ResolutionRecord]) -> text:
    var out = "resolutions|"
    for x in results:
        out = out + _ser_resolution(x)
    out

fn _ser_link_result(result: StyleLinkResult) -> text:
    var out = _ser_resolutions(result.resolutions) + "|unresolved|"
    for un in result.unresolved_names:
        out = out + "u:" + _ser_name(un) + ";"
    out = out + "|cycles|"
    for cn in result.cycle_property_names:
        out = out + "c:" + _ser_name(cn) + ";"
    out

# ----------------------------------------------------------------------------
# Receipt assembly.
# ----------------------------------------------------------------------------

fn _style_stage_receipt(stage: u32, input_ser: text, output_ser: text, count_in: u64, count_out: u64, malformed: u32) -> StageReceipt:
    """Assemble one deterministic StageReceipt: content roots are SHA-256
    over the canonical serializations, `deterministic_hash` binds the stage
    key, both roots and both counts into a single replay check. Byte and
    time counters are structurally 0 (see file header)."""
    val input_root_hex = sha256_text(input_ser)
    val output_root_hex = sha256_text(output_ser)
    val det_hex = sha256_text(
        (STYLE_LINK_RECEIPT_SCHEMA + "|" + _style_stage_name(stage) +
            "|in:" + input_root_hex + "|out:" + output_root_hex +
            "|nin:" + (count_in as i64).to_text() +
            "|nout:" + (count_out as i64).to_text() +
            "|mal:" + (malformed as i64).to_text()))
    StageReceipt(
        stage: style_link_stage_id(stage),
        backend: BackendId(value: STYLE_LINK_RECEIPT_BACKEND),
        mode: ExecutionMode.CpuReference,
        input_root: Hash256(value: input_root_hex),
        output_root: Hash256(value: output_root_hex),
        item_count_in: count_in,
        item_count_out: count_out,
        bytes_read: 0,
        bytes_written: 0,
        fallback_count: 0,
        malformed_count: malformed,
        overflow_flags: 0,
        elapsed_us: 0,
        deterministic_hash: Hash256(value: det_hex))

# ----------------------------------------------------------------------------
# Stage wrappers — frozen function first, receipt second.
# ----------------------------------------------------------------------------

fn style_collect_records_with_receipt(inputs: StyleLinkInputs) -> StyleCollectOutcome:
    """`style_collect_records` plus its COLLECT receipt. `item_count_in` =
    symbols presented, `item_count_out` = records produced (defs + refs —
    equal to the input count today because collect classifies every symbol,
    but counted independently so a future filtering collect step cannot
    silently drop records without the receipt showing it)."""
    val (defs, refs) = style_collect_records(inputs)
    val input_ser = _ser_style_inputs("style.collect.v1", inputs)
    val output_ser = _ser_records(defs, refs)
    val receipt = _style_stage_receipt(
        STYLE_LINK_STAGE_COLLECT,
        input_ser,
        output_ser,
        inputs.symbols.len() as u64,
        (defs.len() + refs.len()) as u64,
        0)
    StyleCollectOutcome(defs: defs, refs: refs, receipt: receipt)

fn style_resolve_with_receipt(defs: [DefinitionRecord], refs: [ReferenceRecord]) -> StyleResolveOutcome:
    """`style_resolve` plus its RESOLVE receipt. `item_count_in` = records
    consumed (defs + refs), `item_count_out` = resolutions produced (one per
    reference — the frozen every-reference-appears-once contract, now
    replayable from the receipt alone)."""
    val results = style_resolve(defs, refs)
    val input_ser = "style.resolve.v1|" + _ser_records(defs, refs)
    val output_ser = _ser_resolutions(results)
    val receipt = _style_stage_receipt(
        STYLE_LINK_STAGE_RESOLVE,
        input_ser,
        output_ser,
        (defs.len() + refs.len()) as u64,
        results.len() as u64,
        0)
    StyleResolveOutcome(results: results, receipt: receipt)

fn style_link_with_receipt(inputs: StyleLinkInputs) -> StyleLinkOutcome:
    """`style_link` plus its LINK receipt. `item_count_in` = symbols
    presented, `item_count_out` = resolutions in the packaged result. The
    output root also covers `unresolved_names` and `cycle_property_names`,
    so a drifted dedup or cycle sweep moves the receipt even when the
    resolution array is unchanged. `style_link` has no rejection path, so
    `malformed_count` is structurally 0."""
    val result = style_link(inputs)
    val input_ser = _ser_style_inputs("style.link.v1", inputs)
    val output_ser = _ser_link_result(result)
    val receipt = _style_stage_receipt(
        STYLE_LINK_STAGE_LINK,
        input_ser,
        output_ser,
        inputs.symbols.len() as u64,
        result.resolutions.len() as u64,
        0)
    StyleLinkOutcome(result: result, receipt: receipt)
