    GPU_EVENT_REJECT_NONE, GPU_EVENT_REJECT_STALE_SCENE_GENERATION,
    GPU_EVENT_REJECT_UNKNOWN_KIND, GPU_EVENT_REJECT_NO_TARGET,
    GPU_EVENT_REJECT_NO_LISTENER, GPU_EVENT_REJECT_UNKNOWN_HANDLER,
    GPU_EVENT_REJECT_CAPACITY, GPU_EVENT_REJECT_STALE_NODE_GENERATION,
    GPU_EVENT_REJECT_UNSUPPORTED_OPERATION,
    GPU_MUT_OP_SET, GPU_MUT_OP_ADD, GPU_MUT_OP_SET_BITS, GPU_MUT_OP_CLEAR_BITS,
    GPU_MUT_OP_TOGGLE_BITS, GPU_MUT_OP_COUNT,
    GpuEventReject, GpuEventTarget, GpuNormalizedEventBatch,
    GpuStagedMutation, GpuStagedHostEffect,
    GpuEventTransaction, GpuMutationJournal,
    GpuNodeStateColumns, GpuStateUndoRecord, GpuEpochApplyResult,
    gpu_event_reject_reason_text, gpu_event_kind_is_known,
    gpu_node_state_empty, gpu_node_state_slot,
    gpu_node_state_read_lo, gpu_node_state_read_hi,
    gpu_event_normalize, gpu_event_build_journal,
    gpu_event_journal_capacity_plan, gpu_web_capacity_manifest_for_event_policy,
    gpu_event_epoch_apply, gpu_event_epoch_rollback
