# GPU Web Event Model — frozen contract + CPU reference for the event
# TRANSACTION model (normalized packet -> mutation journal -> epoch commit).
#
# Contract source (frozen; ordering rules are authoritative):
#   doc/03_plan/ui/gpu_web_scene_offload_mdsoc_plus_plan.md
#     §2 "GPU-offloadable Simple script" (bounded handlers, host effects are
#     not full CPU fallback), §3 "GPU event model" (per-event execution steps
#     1-12 and the deterministic order: event sequence -> capture/target/bubble
#     phase -> route position -> listener registration order -> mutation
#     sequence inside the listener).
# Shared lane rules:
#   doc/03_plan/platform/structural_compute/README.md
#     rule 3 (CPU reference is the oracle), rule 4 (no silent fallback: every
#     fallback carries a reason receipt), rule 6 (ADR-004 write-back idiom).
#
# WHAT THIS FILE OWNS AND WHAT IT REUSES
#   reused, never reimplemented here:
#     common.ui.gpu_web_ports          — the frozen packet records themselves
#                                        (GpuInputEvent / GpuMutation /
#                                        GpuHostEffectRequest).
#     common.ui.gpu_event_core         — generation validation, coalescing,
#                                        ancestor route, capture/target/bubble
#                                        dispatch, journal sort, epoch hash.
#     common.ui.gpu_web_capacity_manifest
#                                      — Kernel C. ALL bound checking goes
#                                        through gpu_web_capacity_verify; this
#                                        module never compares a count against
#                                        a bound itself.
#     common.ui.draw_ir_v3             — DRAW_IR_V3_NO_ID. Node ids in the
#                                        event model are DrawIR v3 node ids
#                                        (plan §3 "Hit testing" lifts hit_rect
#                                        and parent_id out of DrawIR), so the
#                                        absent-id sentinel must be the same
#                                        constant, not a second spelling.
#   owned here:
#     the normalized event batch, the staged-write handler program, the event
#     transaction record, the mutation journal, and the CPU-reference
#     apply/rollback over a flat node-state column set.
#
# STRUCTURE CONVENTIONS (inherited from the frozen DrawIR v3 contract)
#   * no text keys in render-hot records — every id/kind/reason in a packet is
#     numeric; text appears only on cold receipt fields;
#   * no nested dynamic arrays — a journal is parallel flat columns plus
#     (start, count) spans into them;
#   * DRAW_IR_V3_NO_ID marks an absent id;
#   * explicit schema-version constant, mirroring the -v1/-v3 naming.
#
# THE HONESTY RULE FOR THIS FILE
# Nothing is dropped quietly. Every event that does not reach the journal, and
# every epoch that does not commit, produces a receipt naming the reason (and,
# for a capacity rejection, the exact manifest bound). There is deliberately no
# "apply what fits" API: a partially applied epoch would make the journal
# non-replayable, so an over-budget epoch is rejected whole.

use common.ui.gpu_web_ports.{
    GpuInputEvent, GpuMutation, GpuHostEffectRequest,
    GPU_EVENT_KIND_NONE, GPU_EVENT_KIND_HOST_EFFECT_COMPLETION
}
use common.ui.gpu_event_core.{
    GpuEventListener,
    gpu_event_validate_generation, gpu_event_coalesce, gpu_event_build_route,
    gpu_event_dispatch, gpu_mutation_journal_commit, gpu_event_epoch_hash
}
use common.ui.gpu_web_capacity_manifest.{
    GpuWebCapacityManifest, GpuWebCapacityPlan, GpuWebCapacityVerdict,
    gpu_web_capacity_plan_zero, gpu_web_capacity_verify
}
use common.ui.draw_ir_v3.{ DRAW_IR_V3_NO_ID }

# ---------------------------------------------------------------------------
# Frozen contract markers
# ---------------------------------------------------------------------------

pub val GPU_WEB_EVENT_MODEL_SCHEMA_VERSION: text = "simple-gpu-web-event-model-v1"
pub val GPU_WEB_EVENT_MODEL_SCHEMA_ID: u32 = 1u32

# ---------------------------------------------------------------------------
# Reject reason codes (shared rule 4 — no silent fallback)
# ---------------------------------------------------------------------------

pub val GPU_EVENT_REJECT_NONE: u16 = 0u16
# The event was authored against a scene generation that no longer exists.
pub val GPU_EVENT_REJECT_STALE_SCENE_GENERATION: u16 = 1u16
# kind is outside the frozen GPU_EVENT_KIND_* set in gpu_web_ports.
pub val GPU_EVENT_REJECT_UNKNOWN_KIND: u16 = 2u16
# Hit testing produced no target node for this event sequence.
pub val GPU_EVENT_REJECT_NO_TARGET: u16 = 3u16
# The route exists but carries no listener; nothing to execute.
pub val GPU_EVENT_REJECT_NO_LISTENER: u16 = 4u16
# A listener names a handler with no staged program: it cannot run on the GPU
# path, and this receipt is why (plan §2 "Rejected" rows).
pub val GPU_EVENT_REJECT_UNKNOWN_HANDLER: u16 = 5u16
# Kernel C rejected the epoch; the verdict names the bound.
pub val GPU_EVENT_REJECT_CAPACITY: u16 = 6u16
# A mutation targets a node whose generation moved on since it was staged.
pub val GPU_EVENT_REJECT_STALE_NODE_GENERATION: u16 = 7u16
# A mutation carries an operation this contract version does not define.
pub val GPU_EVENT_REJECT_UNSUPPORTED_OPERATION: u16 = 8u16

fn gpu_event_reject_reason_text(reason_code: u16) -> text:
    """Cold-path receipt text. Render-hot records carry the numeric code only."""
    if reason_code == GPU_EVENT_REJECT_NONE:
        return ""
    if reason_code == GPU_EVENT_REJECT_STALE_SCENE_GENERATION:
        return "stale_scene_generation"
    if reason_code == GPU_EVENT_REJECT_UNKNOWN_KIND:
        return "unknown_event_kind"
    if reason_code == GPU_EVENT_REJECT_NO_TARGET:
        return "no_hit_target"
    if reason_code == GPU_EVENT_REJECT_NO_LISTENER:
        return "no_listener_on_route"
    if reason_code == GPU_EVENT_REJECT_UNKNOWN_HANDLER:
        return "unknown_handler_program"
    if reason_code == GPU_EVENT_REJECT_CAPACITY:
        return "capacity_exceeded"
    if reason_code == GPU_EVENT_REJECT_STALE_NODE_GENERATION:
        return "stale_node_generation"
    if reason_code == GPU_EVENT_REJECT_UNSUPPORTED_OPERATION:
        return "unsupported_mutation_operation"
    return "unspecified"

# ---------------------------------------------------------------------------
# Mutation operations (GpuMutation.operation)
# ---------------------------------------------------------------------------
#
# Every operation is deterministic, total, and undoable from the previous slot
# value alone, which is what makes an epoch rollback exact. Field values are a
# 64-bit pair (value_lo, value_hi) held as two u32 columns, matching the frozen
# GpuMutation record.

pub val GPU_MUT_OP_SET: u16 = 0u16
pub val GPU_MUT_OP_ADD: u16 = 1u16
pub val GPU_MUT_OP_SET_BITS: u16 = 2u16
pub val GPU_MUT_OP_CLEAR_BITS: u16 = 3u16
pub val GPU_MUT_OP_TOGGLE_BITS: u16 = 4u16
# One past the last defined operation; a higher code is rejected, not ignored.
pub val GPU_MUT_OP_COUNT: u16 = 5u16

val _GWE_U32_MASK: i64 = 4294967295

# ---------------------------------------------------------------------------
# Receipts and normalized input
# ---------------------------------------------------------------------------

# One dropped event or one non-executable listener. Numeric only; render the
# text with gpu_event_reject_reason_text. Absent ids use DRAW_IR_V3_NO_ID.
struct GpuEventReject:
    event_sequence: u64
    node_id: u32
    handler_id: u32
    reason_code: u16

# Hit-test output: which node an event sequence resolved to. Kept as its own
# flat column rather than a field on the frozen GpuInputEvent, because the
# packet record is frozen and hit testing is a separate stage (plan §3 step 3).
struct GpuEventTarget:
    event_sequence: u64
    target_node: u32

# The normalized event packet the CPU produces for one epoch (plan §3 steps
# 1-2). `events` is admitted, sequence-ordered and coalesced; everything the
# CPU discarded is accounted for in `rejects`.
struct GpuNormalizedEventBatch:
    schema_id: u32
    scene_generation: u64
    input_count: i64
    coalesced_count: i64
    events: [GpuInputEvent]
    rejects: [GpuEventReject]

# ---------------------------------------------------------------------------
# Handler programs (the staged writes a bounded @gpu_event handler performs)
# ---------------------------------------------------------------------------
#
# The `@gpu_event` frontend attribute of plan §2 does not exist yet, so the CPU
# reference takes the handler body already lowered to its staged writes: a flat
# table keyed by numeric handler_id, ordered inside a handler by write_index.
# This is exactly the information a lowered GpuEventIR body would carry, and it
# keeps the reference independent of the unlanded frontend surface.

struct GpuStagedMutation:
    handler_id: u32
    write_index: u32
    node_id: u32
    node_generation: u32
    field_id: u16
    operation: u16
    value_lo: u32
    value_hi: u32

struct GpuStagedHostEffect:
    handler_id: u32
    write_index: u32
    effect_kind: u16
    continuation_id: u16
    payload_offset: u32
    payload_length: u32

# ---------------------------------------------------------------------------
# Transaction and journal
# ---------------------------------------------------------------------------

# One listener execution. No mutation is applied while listeners run (plan §3);
# a transaction only records WHERE that listener's writes landed in the flat
# journal columns, as (start, count) spans.
struct GpuEventTransaction:
    event_sequence: u64
    node_id: u32
    phase: u16
    route_index: u16
    handler_id: u32
    mutation_start: i64
    mutation_count: i64
    host_effect_start: i64
    host_effect_count: i64

# The whole epoch's staged work. Parallel flat columns; transactions index into
# them. `rejects` carries every event and listener that did not make it in.
struct GpuMutationJournal:
    schema_id: u32
    scene_generation: u64
    event_count: i64
    max_route_depth: i64
    transactions: [GpuEventTransaction]
    mutations: [GpuMutation]
    host_effects: [GpuHostEffectRequest]
    rejects: [GpuEventReject]

# ---------------------------------------------------------------------------
# Node state (flat columns) and undo log
# ---------------------------------------------------------------------------

# The committed scene state this reference mutates: a (node_id, field_id) ->
# (value_lo, value_hi) store held as parallel columns. A field never written is
# absent, and absent reads as 0.
struct GpuNodeStateColumns:
    node_ids: [u32]
    node_generations: [u32]
    field_ids: [u16]
    values_lo: [u32]
    values_hi: [u32]

# Enough to restore one applied mutation exactly. `existed == false` means the
# slot was appended by this epoch and rollback removes it again.
struct GpuStateUndoRecord:
    slot_index: i64
    prev_value_lo: u32
    prev_value_hi: u32
    prev_node_generation: u32
    existed: bool

# The epoch commit result. On rejection `state` is the untouched input state,
# `undo` is empty, and `reason` names why (with `breached_bound` naming the
# manifest field for a capacity rejection).
struct GpuEpochApplyResult:
    accepted: bool
    epoch_id: u64
    scene_generation_in: u64
    scene_generation_out: u64
    mutations_applied: i64
    host_effects_requested: i64
    reason_code: u16
    reason: text
    breached_bound: text
    epoch_hash: u64
    verdict: GpuWebCapacityVerdict
    state: GpuNodeStateColumns
    undo: [GpuStateUndoRecord]

fn gpu_node_state_empty() -> GpuNodeStateColumns:
    val ids: [u32] = []
    val gens: [u32] = []
    val fields: [u16] = []
    val lo: [u32] = []
    val hi: [u32] = []
    return GpuNodeStateColumns(
        node_ids: ids,
        node_generations: gens,
        field_ids: fields,
        values_lo: lo,
        values_hi: hi
    )

fn gpu_node_state_slot(state: GpuNodeStateColumns, node_id: u32, field_id: u16) -> i64:
    """Slot index for a (node, field) pair, or -1 when the field is unset."""
    var i: i64 = 0
    val n: i64 = state.node_ids.len()
    while i < n:
        if state.node_ids[i] == node_id and state.field_ids[i] == field_id:
            return i
        i = i + 1
    return -1

fn gpu_node_state_read_lo(state: GpuNodeStateColumns, node_id: u32, field_id: u16) -> u32:
    val slot = gpu_node_state_slot(state, node_id, field_id)
    if slot < 0:
        return 0u32
    return state.values_lo[slot]

fn gpu_node_state_read_hi(state: GpuNodeStateColumns, node_id: u32, field_id: u16) -> u32:
    val slot = gpu_node_state_slot(state, node_id, field_id)
    if slot < 0:
        return 0u32
    return state.values_hi[slot]

# ---------------------------------------------------------------------------
# Step 1-2: normalize the raw input into one epoch packet
# ---------------------------------------------------------------------------

fn gpu_event_kind_is_known(kind: u16) -> bool:
    return kind != GPU_EVENT_KIND_NONE and kind <= GPU_EVENT_KIND_HOST_EFFECT_COMPLETION

fn _gwe_sort_events_by_sequence(events: [GpuInputEvent]) -> [GpuInputEvent]:
    """Stable insertion sort by `sequence`. Arrival order is a transport
    detail; the plan's deterministic order starts at the event sequence."""
    var sorted = events
    val n: i64 = sorted.len()
    var i: i64 = 1
    while i < n:
        val key = sorted[i]
        var j: i64 = i - 1
        while j >= 0 and sorted[j].sequence > key.sequence:
            sorted[j + 1] = sorted[j]
            j = j - 1
        sorted[j + 1] = key
        i = i + 1
    return sorted

fn gpu_event_normalize(raw: [GpuInputEvent], current_generation: u64) -> GpuNormalizedEventBatch:
    """Plan §3 steps 1-2. Validates the scene generation, drops kinds outside
    the frozen set, orders by sequence, then coalesces via the shared core.
    Every dropped event leaves a receipt."""
    var admitted: [GpuInputEvent] = []
    var rejects: [GpuEventReject] = []
    var i: i64 = 0
    val n: i64 = raw.len()
    while i < n:
        val ev = raw[i]
        if not gpu_event_validate_generation(ev, current_generation):
            rejects = rejects.push(GpuEventReject(
                event_sequence: ev.sequence,
                node_id: DRAW_IR_V3_NO_ID,
                handler_id: DRAW_IR_V3_NO_ID,
                reason_code: GPU_EVENT_REJECT_STALE_SCENE_GENERATION
            ))
        else:
            if not gpu_event_kind_is_known(ev.kind):
                rejects = rejects.push(GpuEventReject(
                    event_sequence: ev.sequence,
                    node_id: DRAW_IR_V3_NO_ID,
                    handler_id: DRAW_IR_V3_NO_ID,
                    reason_code: GPU_EVENT_REJECT_UNKNOWN_KIND
                ))
            else:
                admitted = admitted.push(ev)
        i = i + 1

    val ordered = _gwe_sort_events_by_sequence(admitted)
    val coalesced = gpu_event_coalesce(ordered)
    return GpuNormalizedEventBatch(
        schema_id: GPU_WEB_EVENT_MODEL_SCHEMA_ID,
        scene_generation: current_generation,
        input_count: n,
        coalesced_count: ordered.len() - coalesced.len(),
        events: coalesced,
        rejects: rejects
    )

# ---------------------------------------------------------------------------
# Steps 3-9: build the deterministic mutation journal
# ---------------------------------------------------------------------------

fn _gwe_target_for(targets: [GpuEventTarget], event_sequence: u64) -> u32:
    var i: i64 = 0
    val n: i64 = targets.len()
    while i < n:
        if targets[i].event_sequence == event_sequence:
            return targets[i].target_node
        i = i + 1
    return DRAW_IR_V3_NO_ID

fn _gwe_staged_mutations_for(staged: [GpuStagedMutation], handler_id: u32) -> [GpuStagedMutation]:
    """This handler's writes, in write_index order (stable insertion sort)."""
    var picked: [GpuStagedMutation] = []
    var i: i64 = 0
    val n: i64 = staged.len()
    while i < n:
        if staged[i].handler_id == handler_id:
            picked = picked.push(staged[i])
        i = i + 1
    val m: i64 = picked.len()
    var a: i64 = 1
    while a < m:
        val key = picked[a]
        var b: i64 = a - 1
        while b >= 0 and picked[b].write_index > key.write_index:
            picked[b + 1] = picked[b]
            b = b - 1
        picked[b + 1] = key
        a = a + 1
    return picked

fn _gwe_staged_effects_for(staged: [GpuStagedHostEffect], handler_id: u32) -> [GpuStagedHostEffect]:
    var picked: [GpuStagedHostEffect] = []
    var i: i64 = 0
    val n: i64 = staged.len()
    while i < n:
        if staged[i].handler_id == handler_id:
            picked = picked.push(staged[i])
        i = i + 1
    val m: i64 = picked.len()
    var a: i64 = 1
    while a < m:
        val key = picked[a]
        var b: i64 = a - 1
        while b >= 0 and picked[b].write_index > key.write_index:
            picked[b + 1] = picked[b]
            b = b - 1
        picked[b + 1] = key
        a = a + 1
    return picked

fn gpu_event_build_journal(batch: GpuNormalizedEventBatch,
                           targets: [GpuEventTarget],
                           parents: [u32],
                           listeners: [GpuEventListener],
                           staged_mutations: [GpuStagedMutation],
                           staged_effects: [GpuStagedHostEffect]) -> GpuMutationJournal:
    """Plan §3 steps 3-9. Walks the normalized batch in sequence order, routes
    each event through the shared capture/target/bubble dispatch, and appends
    each listener's staged writes into flat journal columns.

    The mutation `sequence` counter increases across the whole epoch, so it
    encodes the plan's full deterministic order in one monotone field:
    event sequence -> phase -> route position -> listener registration order
    -> write index inside the listener."""
    var transactions: [GpuEventTransaction] = []
    var mutations: [GpuMutation] = []
    var effects: [GpuHostEffectRequest] = []
    var rejects = batch.rejects
    var next_sequence: i64 = 0
    var max_depth: i64 = 0

    var e: i64 = 0
    val event_count: i64 = batch.events.len()
    while e < event_count:
        val ev = batch.events[e]
        val target = _gwe_target_for(targets, ev.sequence)
        if target == DRAW_IR_V3_NO_ID:
            rejects = rejects.push(GpuEventReject(
                event_sequence: ev.sequence,
                node_id: DRAW_IR_V3_NO_ID,
                handler_id: DRAW_IR_V3_NO_ID,
                reason_code: GPU_EVENT_REJECT_NO_TARGET
            ))
        else:
            val route = gpu_event_build_route(target, parents)
            if route.len() > max_depth:
                max_depth = route.len()
            val steps = gpu_event_dispatch(target, parents, listeners)
            if steps.len() == 0:
                rejects = rejects.push(GpuEventReject(
                    event_sequence: ev.sequence,
                    node_id: target,
                    handler_id: DRAW_IR_V3_NO_ID,
                    reason_code: GPU_EVENT_REJECT_NO_LISTENER
                ))
            else:
                var r: i64 = 0
                while r < steps.len():
                    val stp = steps[r]
                    val writes = _gwe_staged_mutations_for(staged_mutations, stp.listener_handler_id)
                    val reqs = _gwe_staged_effects_for(staged_effects, stp.listener_handler_id)
                    if writes.len() == 0 and reqs.len() == 0:
                        rejects = rejects.push(GpuEventReject(
                            event_sequence: ev.sequence,
                            node_id: stp.node_id,
                            handler_id: stp.listener_handler_id,
                            reason_code: GPU_EVENT_REJECT_UNKNOWN_HANDLER
                        ))
                    else:
                        val mut_start: i64 = mutations.len()
                        var w: i64 = 0
                        while w < writes.len():
                            val sw = writes[w]
                            mutations = mutations.push(GpuMutation(
                                node_id: sw.node_id,
                                node_generation: sw.node_generation,
                                field_id: sw.field_id,
                                operation: sw.operation,
                                value_lo: sw.value_lo,
                                value_hi: sw.value_hi,
                                sequence: next_sequence.to_u32()
                            ))
                            next_sequence = next_sequence + 1
                            w = w + 1
                        val eff_start: i64 = effects.len()
                        var k: i64 = 0
                        while k < reqs.len():
                            val sr = reqs[k]
                            effects = effects.push(GpuHostEffectRequest(
                                event_sequence: ev.sequence,
                                effect_kind: sr.effect_kind,
                                continuation_id: sr.continuation_id,
                                payload_offset: sr.payload_offset,
                                payload_length: sr.payload_length
                            ))
                            k = k + 1
                        transactions = transactions.push(GpuEventTransaction(
                            event_sequence: ev.sequence,
                            node_id: stp.node_id,
                            phase: stp.phase,
                            route_index: r.to_u16(),
                            handler_id: stp.listener_handler_id,
                            mutation_start: mut_start,
                            mutation_count: mutations.len() - mut_start,
                            host_effect_start: eff_start,
                            host_effect_count: effects.len() - eff_start
                        ))
                    r = r + 1
        e = e + 1

    return GpuMutationJournal(
        schema_id: GPU_WEB_EVENT_MODEL_SCHEMA_ID,
        scene_generation: batch.scene_generation,
        event_count: event_count,
        max_route_depth: max_depth,
        transactions: transactions,
        mutations: mutations,
        host_effects: effects,
        rejects: rejects
    )

# ---------------------------------------------------------------------------
# Capacity: the four event-model bounds, checked by Kernel C only
# ---------------------------------------------------------------------------

fn gpu_event_journal_capacity_plan(journal: GpuMutationJournal) -> GpuWebCapacityPlan:
    """Kernel A+B result for this lane: only the four event-model totals are
    populated. Every other total stays 0, so an unset bound for a resource
    this lane does not use cannot breach."""
    var plan = gpu_web_capacity_plan_zero()
    plan.events_in_flight = journal.event_count.to_u32()
    plan.route_depth = journal.max_route_depth.to_u16()
    plan.mutations_per_epoch = journal.mutations.len().to_u32()
    plan.host_effects_per_epoch = journal.host_effects.len().to_u32()
    return plan

fn _gwe_tighten(current: i64, candidate: i64) -> i64:
    """Tighten-or-set, matching the capacity contract's own manifest sources:
    0 means 'this source says nothing', a bound already committed to is never
    raised."""
    if candidate <= 0:
        return current
    if current == 0:
        return candidate
    if candidate < current:
        return candidate
    return current

fn gpu_web_capacity_manifest_for_event_policy(base: GpuWebCapacityManifest,
                                              max_events_in_flight: i64,
                                              max_route_depth: i64,
                                              max_mutations_per_epoch: i64,
                                              max_host_effects_per_epoch: i64) -> GpuWebCapacityManifest:
    """Handler-policy manifest source. The numbers are NOT invented here: they
    are the bounds a handler declares in plan §2's `@gpu_event(max_steps=...,
    max_mutations=..., max_host_effects=...)` attribute, summed over the
    handlers a build admits, and the caller passes them in. Pass 0 for a bound
    this source has nothing to say about. Like the other manifest sources, a
    bound only tightens or fills an unset slot; it never grows."""
    var m = base
    m.max_events_in_flight = _gwe_tighten(base.max_events_in_flight.to_i64(), max_events_in_flight).to_u32()
    m.max_route_depth = _gwe_tighten(base.max_route_depth.to_i64(), max_route_depth).to_u16()
    m.max_mutations_per_epoch = _gwe_tighten(base.max_mutations_per_epoch.to_i64(), max_mutations_per_epoch).to_u32()
    m.max_host_effects_per_epoch = _gwe_tighten(base.max_host_effects_per_epoch.to_i64(), max_host_effects_per_epoch).to_u32()
    return m

# ---------------------------------------------------------------------------
# Steps 10-11: apply the journal as one transaction
# ---------------------------------------------------------------------------

fn _gwe_apply_op(operation: u16, previous: u32, operand: u32) -> u32:
    val p: i64 = previous.to_i64()
    val v: i64 = operand.to_i64()
    if operation == GPU_MUT_OP_SET:
        return operand
    if operation == GPU_MUT_OP_ADD:
        return ((p + v) & _GWE_U32_MASK).to_u32()
    if operation == GPU_MUT_OP_SET_BITS:
        return (p | v).to_u32()
    if operation == GPU_MUT_OP_CLEAR_BITS:
        return (p & (_GWE_U32_MASK ^ v)).to_u32()
    if operation == GPU_MUT_OP_TOGGLE_BITS:
        return (p ^ v).to_u32()
    return previous

fn _gwe_rejected(state: GpuNodeStateColumns, journal: GpuMutationJournal, epoch_id: u64,
                 reason_code: u16, reason: text, breached_bound: text,
                 verdict: GpuWebCapacityVerdict) -> GpuEpochApplyResult:
    val no_undo: [GpuStateUndoRecord] = []
    return GpuEpochApplyResult(
        accepted: false,
        epoch_id: epoch_id,
        scene_generation_in: journal.scene_generation,
        scene_generation_out: journal.scene_generation,
        mutations_applied: 0,
        host_effects_requested: 0,
        reason_code: reason_code,
        reason: reason,
        breached_bound: breached_bound,
        epoch_hash: 0u64,
        verdict: verdict,
        state: state,
        undo: no_undo
    )

fn gpu_event_epoch_apply(state: GpuNodeStateColumns,
                         journal: GpuMutationJournal,
                         manifest: GpuWebCapacityManifest,
                         epoch_id: u64) -> GpuEpochApplyResult:
    """Plan §3 steps 10-11. All-or-nothing: Kernel C proves the epoch fits,
    a pre-flight proves every mutation is executable, and only then does the
    commit kernel touch state. A rejection leaves the input state byte-identical
    and carries the reason; there is no partial apply."""
    val plan = gpu_event_journal_capacity_plan(journal)
    val verdict = gpu_web_capacity_verify(plan, manifest)
    if not verdict.accepted:
        return _gwe_rejected(state, journal, epoch_id, GPU_EVENT_REJECT_CAPACITY,
            verdict.reason, verdict.first_breach_bound, verdict)

    val ordered = gpu_mutation_journal_commit(journal.mutations)
    val count: i64 = ordered.len()

    # Pre-flight: an unexecutable mutation rejects the epoch before any write.
    var p: i64 = 0
    while p < count:
        val m = ordered[p]
        if m.operation >= GPU_MUT_OP_COUNT:
            return _gwe_rejected(state, journal, epoch_id, GPU_EVENT_REJECT_UNSUPPORTED_OPERATION,
                gpu_event_reject_reason_text(GPU_EVENT_REJECT_UNSUPPORTED_OPERATION)
                    + ": node=" + m.node_id.to_i64().to_text()
                    + " operation=" + m.operation.to_i64().to_text(),
                "", verdict)
        val slot = gpu_node_state_slot(state, m.node_id, m.field_id)
        if slot >= 0 and state.node_generations[slot] != m.node_generation:
            return _gwe_rejected(state, journal, epoch_id, GPU_EVENT_REJECT_STALE_NODE_GENERATION,
                gpu_event_reject_reason_text(GPU_EVENT_REJECT_STALE_NODE_GENERATION)
                    + ": node=" + m.node_id.to_i64().to_text()
                    + " staged=" + m.node_generation.to_i64().to_text()
                    + " committed=" + state.node_generations[slot].to_i64().to_text(),
                "", verdict)
        p = p + 1

    var node_ids = state.node_ids
    var node_generations = state.node_generations
    var field_ids = state.field_ids
    var values_lo = state.values_lo
    var values_hi = state.values_hi
    var undo: [GpuStateUndoRecord] = []

    var i: i64 = 0
    while i < count:
        val m = ordered[i]
        var slot: i64 = -1
        var s: i64 = 0
        while s < node_ids.len():
            if node_ids[s] == m.node_id and field_ids[s] == m.field_id:
                slot = s
                s = node_ids.len()
            else:
                s = s + 1
        if slot < 0:
            undo = undo.push(GpuStateUndoRecord(
                slot_index: node_ids.len(),
                prev_value_lo: 0u32,
                prev_value_hi: 0u32,
                prev_node_generation: 0u32,
                existed: false
            ))
            node_ids = node_ids.push(m.node_id)
            node_generations = node_generations.push(m.node_generation)
            field_ids = field_ids.push(m.field_id)
            values_lo = values_lo.push(_gwe_apply_op(m.operation, 0u32, m.value_lo))
            values_hi = values_hi.push(_gwe_apply_op(m.operation, 0u32, m.value_hi))
        else:
            undo = undo.push(GpuStateUndoRecord(
                slot_index: slot,
                prev_value_lo: values_lo[slot],
                prev_value_hi: values_hi[slot],
                prev_node_generation: node_generations[slot],
                existed: true
            ))
            values_lo[slot] = _gwe_apply_op(m.operation, values_lo[slot], m.value_lo)
            values_hi[slot] = _gwe_apply_op(m.operation, values_hi[slot], m.value_hi)
        i = i + 1

    val next_state = GpuNodeStateColumns(
        node_ids: node_ids,
        node_generations: node_generations,
        field_ids: field_ids,
        values_lo: values_lo,
        values_hi: values_hi
    )

    # An epoch that changed nothing does not burn a scene generation; there is
    # no new immutable scene for a later event to be validated against.
    var generation_out = journal.scene_generation
    if count > 0:
        generation_out = journal.scene_generation + 1u64

    return GpuEpochApplyResult(
        accepted: true,
        epoch_id: epoch_id,
        scene_generation_in: journal.scene_generation,
        scene_generation_out: generation_out,
        mutations_applied: count,
        host_effects_requested: journal.host_effects.len(),
        reason_code: GPU_EVENT_REJECT_NONE,
        reason: "",
        breached_bound: "",
        epoch_hash: gpu_event_epoch_hash(ordered),
        verdict: verdict,
        state: next_state,
        undo: undo
    )

# ---------------------------------------------------------------------------
# Rollback
# ---------------------------------------------------------------------------

fn gpu_event_epoch_rollback(result: GpuEpochApplyResult) -> GpuNodeStateColumns:
    """Undo an applied epoch exactly. Records are replayed in reverse so a slot
    written several times inside one epoch ends at the value it held before the
    epoch began; slots the epoch appended are dropped."""
    var node_ids = result.state.node_ids
    var node_generations = result.state.node_generations
    var field_ids = result.state.field_ids
    var values_lo = result.state.values_lo
    var values_hi = result.state.values_hi

    var keep: i64 = node_ids.len()
    var i: i64 = result.undo.len() - 1
    while i >= 0:
        val u = result.undo[i]
        if u.existed:
            values_lo[u.slot_index] = u.prev_value_lo
            values_hi[u.slot_index] = u.prev_value_hi
            node_generations[u.slot_index] = u.prev_node_generation
        else:
            if u.slot_index < keep:
                keep = u.slot_index
        i = i - 1

    if keep >= node_ids.len():
        return GpuNodeStateColumns(
            node_ids: node_ids,
            node_generations: node_generations,
            field_ids: field_ids,
            values_lo: values_lo,
            values_hi: values_hi
        )

    var out_ids: [u32] = []
    var out_gens: [u32] = []
    var out_fields: [u16] = []
    var out_lo: [u32] = []
    var out_hi: [u32] = []
    var k: i64 = 0
    while k < keep:
        out_ids = out_ids.push(node_ids[k])
        out_gens = out_gens.push(node_generations[k])
        out_fields = out_fields.push(field_ids[k])
        out_lo = out_lo.push(values_lo[k])
        out_hi = out_hi.push(values_hi[k])
        k = k + 1
    return GpuNodeStateColumns(
        node_ids: out_ids,
        node_generations: out_gens,
        field_ids: out_fields,
        values_lo: out_lo,
        values_hi: out_hi
    )

