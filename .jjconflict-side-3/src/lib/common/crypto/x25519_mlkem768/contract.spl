# Backend-neutral X25519MLKEM768 contract.
#
# The wire order follows draft-ietf-tls-ecdhe-mlkem-05:
#   client share = ML-KEM-768 encapsulation key || X25519 public key
#   server share = ML-KEM-768 ciphertext || X25519 public key
#   hybrid secret = ML-KEM shared secret || X25519 shared secret

mod lib.common.crypto.x25519_mlkem768.contract

val X25519_MLKEM768_IMPLEMENTATION_VERSION: text = "0.3.0"
val X25519_MLKEM768_PROFILE_VERSION: text = "fips203-2024+ecdhe-mlkem-05"
val X25519_MLKEM768_STANDARD: text = "FIPS 203 ML-KEM-768"
val X25519_MLKEM768_TLS_DRAFT: text = "draft-ietf-tls-ecdhe-mlkem-05"
val X25519_MLKEM768_TLS_NAMED_GROUP: i64 = 0x11EC
val X25519_MLKEM768_CLIENT_SHARE_BYTES: i64 = 1216
val X25519_MLKEM768_SERVER_SHARE_BYTES: i64 = 1120
val X25519_MLKEM768_SHARED_SECRET_BYTES: i64 = 64

struct X25519MlKem768Profile:
    fips_revision: text
    tls_revision: text
    named_group: i64
    client_share_bytes: i64
    server_share_bytes: i64
    shared_secret_bytes: i64
    semantic_version: text

enum X25519MlKem768Backend:
    Automatic
    ScalarCpu
    Avx2
    Neon
    Rvv
    Cuda
    Vulkan
    Metal

enum X25519MlKem768SelectionMode:
    Suggest
    Require

enum X25519MlKem768VerificationPolicy:
    AbsoluteAndScalar
    AbsoluteOracle
    ScalarDifferential

enum X25519MlKem768Operation:
    ClientKeygen
    ServerEncapsulate
    ClientDecapsulate
    BatchRoundTrip

struct X25519MlKem768Config:
    implementation_version: text
    profile_version: text
    requested_backend: X25519MlKem768Backend
    selection_mode: X25519MlKem768SelectionMode
    verification_policy: X25519MlKem768VerificationPolicy
    minimum_batch: i64
    batch_size: i64

struct X25519MlKem768SimdAdmission:
    encoded_provenance: text
    actual_binary_sha256: text
    actual_provenance_sha256: text

struct X25519MlKem768Request:
    operation: X25519MlKem768Operation
    d: list
    z: list
    m: list
    x25519_private_key: [u8]
    peer_share: list
    batch_id: text
    deterministic_test_input: bool

struct X25519MlKem768Evidence:
    requested_backend: X25519MlKem768Backend
    selected_backend: X25519MlKem768Backend
    attempts: [text]
    fallback_used: bool
    fallback_reason: text
    implementation_version: text
    profile_version: text
    configuration_digest: text
    input_fixture_digest: text
    source_digest: text
    artifact_digest: text
    execution_proof_digest: text
    kernel_invocations: i64
    simd_chunk_hits: i64
    observed_rvv_vlen_bits: i64
    operation: text
    batch_size: i64
    output_digest: text
    executor_identity: text
    compiled: bool
    submitted: bool
    fence_completed: bool
    device_readback: bool
    oracle_match: bool

struct X25519MlKem768KeyPair:
    client_key_share: list
    decapsulation_key: list
    x25519_private_key: [u8]
    evidence: X25519MlKem768Evidence

struct X25519MlKem768Encapsulation:
    server_key_share: list
    shared_secret: list
    evidence: X25519MlKem768Evidence

struct X25519MlKem768Decapsulation:
    shared_secret: list
    evidence: X25519MlKem768Evidence

fn x25519_mlkem768_profile() -> X25519MlKem768Profile:
    X25519MlKem768Profile(
        fips_revision: X25519_MLKEM768_STANDARD,
        tls_revision: X25519_MLKEM768_TLS_DRAFT,
        named_group: X25519_MLKEM768_TLS_NAMED_GROUP,
        client_share_bytes: X25519_MLKEM768_CLIENT_SHARE_BYTES,
        server_share_bytes: X25519_MLKEM768_SERVER_SHARE_BYTES,
        shared_secret_bytes: X25519_MLKEM768_SHARED_SECRET_BYTES,
        semantic_version: X25519_MLKEM768_IMPLEMENTATION_VERSION)

fn x25519_mlkem768_default_config() -> X25519MlKem768Config:
    X25519MlKem768Config(
        implementation_version: X25519_MLKEM768_IMPLEMENTATION_VERSION,
        profile_version: X25519_MLKEM768_PROFILE_VERSION,
        requested_backend: X25519MlKem768Backend.Automatic,
        selection_mode: X25519MlKem768SelectionMode.Suggest,
        verification_policy: X25519MlKem768VerificationPolicy.AbsoluteAndScalar,
        minimum_batch: 1,
        batch_size: 1
    )

export X25519MlKem768Backend, X25519MlKem768SelectionMode
export X25519MlKem768VerificationPolicy, X25519MlKem768Operation
export X25519MlKem768Config, X25519MlKem768Evidence
export X25519MlKem768SimdAdmission
export X25519MlKem768Request
export X25519MlKem768Profile, x25519_mlkem768_profile
export X25519MlKem768KeyPair, X25519MlKem768Encapsulation, X25519MlKem768Decapsulation
export x25519_mlkem768_default_config
export X25519_MLKEM768_IMPLEMENTATION_VERSION, X25519_MLKEM768_STANDARD
export X25519_MLKEM768_PROFILE_VERSION
export X25519_MLKEM768_TLS_DRAFT, X25519_MLKEM768_TLS_NAMED_GROUP
export X25519_MLKEM768_CLIENT_SHARE_BYTES, X25519_MLKEM768_SERVER_SHARE_BYTES
export X25519_MLKEM768_SHARED_SECRET_BYTES
