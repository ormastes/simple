struct BlockHeader:
    """Memory block header for free list.

    Stored at the beginning of each allocated/free block.
    Size includes the header itself.
    """
    size: u32        # Total block size in bytes (including header)
    is_free: bool    # True if block is free, false if allocated
    next: u64        # Address of next block (0 if last)

impl BlockHeader:
    # On-disk/in-memory field offsets. `next` used to live at +5, which made
    # the header span bytes 0..8 inclusive (9 bytes) while header_size()
    # reported 8 — so the payload pointer alloc() hands out (block + 8)
    # aliased the top byte of `next`, and the first byte the caller wrote
    # into its own allocation corrupted the free-list link. `next` is now
    # 4-byte aligned at +8, so payload and header never overlap.
    #
    # The header is 16, not 12. alloc() hands the caller `block +
    # header_size()` and steps to the next block by `header_size() +
    # align_up(size, 8)`, so header_size() is what carries the payload's
    # alignment: it must itself be a multiple of 8 or EVERY payload comes back
    # misaligned. At 12 the payloads were 4-aligned, which contradicts both
    # `align_up(size, 8)` here and BumpAllocator's "align to 8 bytes", and an
    # 8-byte load (u64/f64) at a 4-aligned address traps on the ARM/RISC-V
    # targets this module exists for. 16 keeps `next` at +8 (8 + 8 == 16) and
    # restores 8-aligned payloads for an 8-aligned `base`.
    #
    # `next` is a real memory address, which on the hosted targets this
    # module is verified against is a 64-bit host pointer (e.g.
    # `0x514C8C000000`) — not a small `u32`-range value. It is stored as two
    # `u32` words (low @+8, high @+12) via `mem_read_u64`/`mem_write_u64`
    # rather than widening the volatile MMIO primitives, so no new `extern`
    # is needed and the 16-byte layout is unchanged: bytes 8..16 hold the
    # full 8-byte pointer, exactly filling what used to be padding.
    static fn header_size() -> u64:
        """Size of block header (16 bytes: size@0, is_free@4, next@8..16)."""
        16

    static fn next_offset() -> u64:
        """Byte offset of the `next` field within the header (8).

        Exists so a spec can pin the relationship `next_offset() + 8 <=
        header_size()` instead of hardcoding both as unrelated literals —
        the overlap regression this guards against left `header_size()`
        correct while `next` was still read/written at the old offset.
        """
        8

    static fn from_addr(addr: u64) -> BlockHeader:
        """Read block header from memory address."""
        val size_ptr = addr
        val is_free_ptr = addr + 4
        val next_ptr = addr + BlockHeader.next_offset()

        BlockHeader(
            size: mem_read_u32(size_ptr),
            is_free: mem_read_u8(is_free_ptr) != 0,
            next: mem_read_u64(next_ptr)
        )

    me write_to_addr(addr: u64):
        """Write block header to memory address."""
        mem_write_u32(addr, self.size)
        mem_write_u8(addr + 4, if self.is_free: 1 else: 0)
        mem_write_u64(addr + BlockHeader.next_offset(), self.next)

struct BumpAllocator:
    """Bump pointer allocator.

    Extremely fast O(1) allocation.
    No deallocation - reset entire heap at once.

    Characteristics:
    - Very fast allocation (just bump pointer)
    - No deallocation overhead
    - No fragmentation
    - Bulk deallocation only (reset)
    - Fixed capacity

    Use cases:
    - Single-frame allocations (game rendering)
    - Request handling (reset after each request)
    - Temporary buffers

    Example:
        val allocator = BumpAllocator(base: 0x20000000, size: 64 * 1024)
        val buf1 = allocator.alloc(256)  # Fast
        val buf2 = allocator.alloc(512)  # Fast
        # ... use buffers ...
        allocator.reset()  # Free everything at once
    """
    base: u64          # Start of heap region (real host/target address)
    size: u64          # Total heap size
    offset: u64        # Current allocation offset
    allocated: u64      # Total bytes allocated

impl BumpAllocator:
    me alloc(size: u64) -> u64:
        """Allocate memory block.

        Returns address of allocated block, or 0 if out of memory.
        """
        # Align to 8 bytes
        val aligned_size = align_up(size, 8)

        # Check if enough space
        if self.offset + aligned_size > self.size:
            return 0  # Out of memory

        val addr = self.base + self.offset
        self.offset = self.offset + aligned_size
        self.allocated = self.allocated + aligned_size

        addr

    me alloc_aligned(size: u64, alignment: u64) -> u64:
        """Allocate aligned memory block.

        Alignment must be power of 2.
        Returns address of allocated block, or 0 if out of memory.
        """
        # Align current offset to requested alignment
        val aligned_offset = align_up(self.offset, alignment)
        val padding = aligned_offset - self.offset

        # Align size to 8 bytes
        val aligned_size = align_up(size, 8)

        # Check if enough space (including padding)
        if aligned_offset + aligned_size > self.size:
            return 0  # Out of memory

        val addr = self.base + aligned_offset
        self.offset = aligned_offset + aligned_size
        self.allocated = self.allocated + aligned_size + padding

        addr

    me reset():
        """Reset allocator (free all memory)."""
        self.offset = 0
        self.allocated = 0

    fn remaining() -> u64:
        """Get remaining free bytes."""
        self.size - self.offset

    fn total_allocated() -> u64:
        """Get total allocated bytes."""
        self.allocated

struct FreeListAllocator:
    """Free list allocator with first-fit algorithm.

    General-purpose allocator with deallocation support.
    Maintains a linked list of free blocks.

    Characteristics:
    - O(n) allocation (search free list)
    - O(1) deallocation
    - Supports reallocation
    - Can fragment over time
    - Coalesces adjacent free blocks

    Use cases:
    - General-purpose heap
    - Mixed allocation sizes
    - Long-lived objects

    Example:
        val allocator = FreeListAllocator(base: 0x20000000, size: 128 * 1024)
        allocator.init()

        val buf1 = allocator.alloc(256)
        val buf2 = allocator.alloc(512)

        allocator.dealloc(buf1, 256)  # Frees and coalesces

        val buf3 = allocator.alloc(128)  # Reuses buf1's space
    """
    base: u64          # Start of heap region (real host/target address)
    size: u64          # Total heap size
    free_list: u64     # Address of first free block
    allocated: u64      # Total bytes allocated
    num_blocks: u64     # Number of blocks (for debugging)

impl FreeListAllocator:
    fn init():
        """Initialize free list with single large block."""
        # Create initial free block covering entire heap
        val header = BlockHeader(
            size: self.size.to_u32(),
            is_free: true,
            next: 0
        )
        header.write_to_addr(self.base)

        self.free_list = self.base
        self.allocated = 0
        self.num_blocks = 1

    fn alloc(size: u64) -> u64:
        """Allocate memory block using first-fit algorithm.

        Returns address of allocated block (after header), or 0 if out of memory.
        """
        val header_size = BlockHeader.header_size()
        val total_size = header_size + align_up(size, 8)

        # Search free list for suitable block
        var current = self.free_list
        var prev: u64 = 0

        while current != 0:
            val header = BlockHeader.from_addr(current)

            if header.is_free and header.size.to_u64() >= total_size:
                # Found suitable block

                # `next_free` is what `current`'s slot in the list now points
                # to AFTER this iteration's writes below — NOT `header.next`,
                # which is a snapshot from before the split. Using
                # `header.next` unconditionally here was the bug: on a split
                # it discarded the freshly created remainder block, orphaning
                # it (see
                # doc/08_tracking/bug/baremetal_freelist_allocator_drops_free_list_on_first_split_2026-08-08.md).
                var next_free: u64 = header.next

                # Split block if large enough
                val remainder = header.size.to_u64() - total_size
                if remainder >= header_size + 16:  # Minimum 16-byte payload
                    # Split: create new free block after allocated block
                    val new_block_addr = current + total_size
                    val new_header = BlockHeader(
                        size: remainder.to_u32(),
                        is_free: true,
                        next: header.next
                    )
                    new_header.write_to_addr(new_block_addr)

                    # Update current block
                    val updated_header = BlockHeader(
                        size: total_size.to_u32(),
                        is_free: false,
                        next: new_block_addr
                    )
                    updated_header.write_to_addr(current)

                    self.num_blocks = self.num_blocks + 1
                    next_free = new_block_addr
                else:
                    # Use entire block (no split)
                    val updated_header = BlockHeader(
                        size: header.size,
                        is_free: false,
                        next: header.next
                    )
                    updated_header.write_to_addr(current)

                # Update free list if this was first free block
                if prev == 0:
                    self.free_list = next_free

                self.allocated = self.allocated + total_size

                return current + header_size  # Return address after header

            prev = current
            current = header.next

        # No suitable block found
        0

    fn dealloc(addr: u64, size: u64):
        """Deallocate memory block and coalesce with adjacent free blocks."""
        val header_size = BlockHeader.header_size()
        val block_addr = addr - header_size

        # Mark block as free
        var header = BlockHeader.from_addr(block_addr)
        header.is_free = true
        header.write_to_addr(block_addr)

        self.allocated = sat_sub(self.allocated, header.size.to_u64())

        # Coalesce with next block if free
        if header.next != 0:
            val next_header = BlockHeader.from_addr(header.next)
            if next_header.is_free:
                # Merge with next block
                header.size = (header.size.to_u64() + next_header.size.to_u64()).to_u32()
                header.next = next_header.next
                header.write_to_addr(block_addr)
                self.num_blocks = sat_sub(self.num_blocks, 1)

        # Coalesce with previous block if free
        self.coalesce_with_prev(block_addr)

    fn coalesce_with_prev(addr: u64):
        """Coalesce block with previous free block."""
        # Find previous block
        var current = self.base
        while current < addr:
            val header = BlockHeader.from_addr(current)
            if header.next == addr or header.next == 0:
                # Found previous block
                if header.is_free:
                    val target_header = BlockHeader.from_addr(addr)
                    header.size = (header.size.to_u64() + target_header.size.to_u64()).to_u32()
                    header.next = target_header.next
                    header.write_to_addr(current)
                    self.num_blocks = sat_sub(self.num_blocks, 1)
                return
            current = header.next

    fn realloc(addr: u64, old_size: u64, new_size: u64) -> u64:
        """Reallocate memory block to new size.

        Returns address of reallocated block, or 0 if failed.
        May return same address if block can be resized in place.
        """
        # Try to resize in place first
        val header_size = BlockHeader.header_size()
        val block_addr = addr - header_size
        val header = BlockHeader.from_addr(block_addr)

        val new_total_size = header_size + align_up(new_size, 8)

        if new_total_size <= header.size.to_u64():
            # Shrinking or same size - can do in place
            return addr

        # Need to grow - allocate new block and copy
        val new_addr = self.alloc(new_size)
        if new_addr == 0:
            return 0  # Allocation failed

        # Copy data
        mem_copy(new_addr, addr, old_size)

        # Free old block
        self.dealloc(addr, old_size)

        new_addr

    fn total_allocated() -> u64:
        """Get total allocated bytes."""
        self.allocated

    fn num_free_blocks() -> u64:
        """Count number of free blocks (for debugging)."""
        var count: u64 = 0
        var current = self.base

        while current != 0:
            val header = BlockHeader.from_addr(current)
            if header.is_free:
                count = count + 1
            current = header.next

        count

struct FixedBlockAllocator:
    """Pool allocator for fixed-size objects.

    Very fast O(1) allocation and deallocation.
    No fragmentation, minimal overhead.

    Characteristics:
    - O(1) allocation/deallocation
    - No fragmentation
    - Fixed object size
    - Efficient for uniform objects

    Use cases:
    - AST nodes
    - Network packets
    - Game entities

    Example:
        # Pool for 64-byte objects
        val allocator = FixedBlockAllocator(
            base: 0x20000000,
            block_size: 64,
            capacity: 1000
        )
        allocator.init()

        val obj1 = allocator.alloc()
        val obj2 = allocator.alloc()

        allocator.dealloc(obj1)
        val obj3 = allocator.alloc()  # Reuses obj1's slot
    """
    base: u64          # Start of pool region (real host/target address)
    block_size: u64    # Size of each block (must be >= 8: holds a full
                        # 8-byte free-list link word when free)
    capacity: u64       # Maximum number of blocks
    free_list: u64     # Address of first free block (linked list)
    allocated: u64       # Number of allocated blocks

impl FixedBlockAllocator:
    fn init():
        """Initialize free list linking all blocks."""
        if self.capacity == 0:
            # `capacity - 1` on an unsigned integer wraps to a huge value —
            # the link loop would run away writing across all of memory. An
            # empty pool has no blocks to link and starts exhausted.
            self.free_list = 0
            self.allocated = 0
            return

        var addr = self.base
        var i: u64 = 0

        while i + 1 < self.capacity:
            # Write address of next block (8-byte link word, see block_size)
            val next_addr = addr + self.block_size
            mem_write_u64(addr, next_addr)
            addr = next_addr
            i = i + 1

        # Last block points to null
        mem_write_u64(addr, 0)

        self.free_list = self.base
        self.allocated = 0

    fn alloc() -> u64:
        """Allocate one block.

        Returns address of allocated block, or 0 if pool exhausted.
        """
        if self.free_list == 0:
            return 0  # Pool exhausted

        val addr = self.free_list
        val next = mem_read_u64(addr)
        self.free_list = next
        self.allocated = self.allocated + 1

        addr

    fn dealloc(addr: u64):
        """Deallocate one block (return to pool)."""
        # Add block back to front of free list
        mem_write_u64(addr, self.free_list)
        self.free_list = addr
        self.allocated = sat_sub(self.allocated, 1)

    fn available() -> u64:
        """Get number of available blocks."""
        sat_sub(self.capacity, self.allocated)

    fn is_exhausted() -> bool:
        """Check if pool is exhausted."""
        self.free_list == 0

struct MultiPoolAllocator:
    """Multi-pool allocator with multiple size classes.

    Combines multiple fixed-size pools.
    Efficient for mixed workloads with known size distribution.

    Size classes: 16, 32, 64, 128, 256, 512, 1024, 2048 bytes

    Example:
        val allocator = MultiPoolAllocator(base: 0x20000000, size: 256 * 1024)
        allocator.init()

        val small = allocator.alloc(32)    # Uses 32-byte pool
        val medium = allocator.alloc(200)  # Uses 256-byte pool
        val large = allocator.alloc(1500)  # Uses 2048-byte pool
    """
    base: u64          # Start of multi-pool region (real host/target address)
    size: u64          # Total size
    pools: [u64]       # Array of pool base addresses (8 pools)

    # Size classes
    sizes: [u64]       # [16, 32, 64, 128, 256, 512, 1024, 2048]
    counts: [u64]      # Number of blocks per pool

impl MultiPoolAllocator:
    fn init():
        """Initialize all pools with even distribution."""
        # Size classes
        self.sizes = [16, 32, 64, 128, 256, 512, 1024, 2048]

        # Divide heap among pools
        val pool_size = self.size / 8
        var offset: u64 = 0

        for i in 0..8:
            val pool_base = self.base + offset
            self.pools.push(pool_base)

            val block_size = self.sizes[i]
            val capacity = pool_size / block_size
            self.counts.push(capacity)

            # Initialize this pool's free list
            self.init_pool(pool_base, block_size, capacity)

            offset = offset + pool_size

    fn init_pool(base: u64, block_size: u64, capacity: u64):
        """Initialize a single pool's free list."""
        if capacity == 0:
            # See FixedBlockAllocator.init: `capacity - 1` wraps on unsigned.
            return

        var addr = base
        var i: u64 = 0

        while i + 1 < capacity:
            val next_addr = addr + block_size
            mem_write_u64(addr, next_addr)
            addr = next_addr
            i = i + 1

        mem_write_u64(addr, 0)

    fn alloc(size: u64) -> u64:
        """Allocate from appropriate size class."""
        val pool_idx = self.find_pool(size)
        if pool_idx == 255:  # -1 as u8
            return 0  # Size too large

        val pool_base = self.pools[pool_idx]
        val free_list_addr = mem_read_u64(pool_base)

        if free_list_addr == 0:
            return 0  # Pool exhausted

        val next = mem_read_u64(free_list_addr)
        mem_write_u64(pool_base, next)

        free_list_addr

    fn dealloc(addr: u64, size: u64):
        """Deallocate to appropriate size class."""
        val pool_idx = self.find_pool(size)
        if pool_idx == 255:
            return  # Invalid size

        val pool_base = self.pools[pool_idx]
        val free_list_addr = mem_read_u64(pool_base)

        mem_write_u64(addr, free_list_addr)
        mem_write_u64(pool_base, addr)

    fn find_pool(size: u64) -> u32:
        """Find pool index for size (returns 255 if too large)."""
        for i in 0..8:
            if size <= self.sizes[i]:
                return i
        255  # Too large

extern fn rt_mmio_read_u32(addr: u64) -> u32
extern fn rt_mmio_write_u32(addr: u64, value: u32)
extern fn rt_mmio_read_u8(addr: u64) -> u8
extern fn rt_mmio_write_u8(addr: u64, value: u8)

fn mem_read_u32(addr: u64) -> u32:
    """Read 32-bit word from memory address (volatile)."""
    rt_mmio_read_u32(addr)

fn mem_write_u32(addr: u64, value: u32):
    """Write 32-bit word to memory address (volatile)."""
    rt_mmio_write_u32(addr, value)

fn mem_read_u8(addr: u64) -> u8:
    """Read byte from memory address (volatile)."""
    rt_mmio_read_u8(addr)

fn mem_write_u8(addr: u64, value: u8):
    """Write byte to memory address (volatile)."""
    rt_mmio_write_u8(addr, value)

fn mem_read_u64(addr: u64) -> u64:
    """Read a 64-bit address/link word from memory (volatile, low-word-first).

    No `rt_mmio_read_u64` extern exists (or is needed): every caller in this
    module uses this only to round-trip a real 64-bit address (`BlockHeader.next`,
    and the free-list link word `FixedBlockAllocator`/`MultiPoolAllocator` write
    at the front of each free block), so two volatile `u32` accesses compose
    into one atomic-enough-for-a-single-threaded-allocator 64-bit read without
    widening the runtime's MMIO primitives or requiring a bootstrap rebuild.
    """
    val lo = mem_read_u32(addr).to_u64()
    val hi = mem_read_u32(addr + 4).to_u64()
    (hi << 32) | lo

fn mem_write_u64(addr: u64, value: u64):
    """Write a 64-bit address/link word to memory (volatile, low-word-first)."""
    mem_write_u32(addr, (value & 0xFFFFFFFF).to_u32())
    mem_write_u32(addr + 4, (value >> 32).to_u32())

fn mem_copy(dest: u64, src: u64, size: u64):
    """Copy memory from src to dest."""
    var i: u64 = 0
    while i < size:
        val byte = mem_read_u8(src + i)
        mem_write_u8(dest + i, byte)
        i = i + 1

fn align_up(value: u64, alignment: u64) -> u64:
    """Align value up to alignment (must be power of 2)."""
    (value + alignment - 1) & ~(alignment - 1)

fn sat_sub(a: u64, b: u64) -> u64:
    """Saturating subtraction: `a - b`, floored at 0 instead of wrapping.

    Unsigned subtraction when `b > a` wraps to a huge value (e.g. `0u64 -
    1u64` -> 18446744073709551615) instead of going negative. Every counter
    decrement in this module that isn't already guarded
    (FixedBlockAllocator.available/dealloc, FreeListAllocator.dealloc,
    coalesce_with_prev) has exactly this shape, so they route through here
    instead of repeating an ad hoc guard at each site. See
    doc/08_tracking/bug/baremetal_freelist_allocator_drops_free_list_on_first_split_2026-08-08.md
    section 2.
    """
    if b > a:
        0u64
    else:
        a - b

var global_heap: FreeListAllocator = FreeListAllocator(
    base: 0,
    size: 0,
    free_list: 0,
    allocated: 0,
    num_blocks: 0
)

fn heap_init(base: u64, size: u64):
    """Initialize global heap with free list allocator."""
    global_heap = FreeListAllocator(
        base: base,
        size: size,
        free_list: 0,
        allocated: 0,
        num_blocks: 0
    )
    global_heap.init()

fn heap_stats() -> (u64, u64, u64):
    """Get heap statistics: (allocated, free, fragmentation)."""
    (0, 0, 0)

fn heap_check() -> bool:
    """Check heap integrity (verify free list, block sizes, etc.)."""
    true
