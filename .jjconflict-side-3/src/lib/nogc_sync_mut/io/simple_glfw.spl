# GLFW-shaped hosted adapter over the canonical scalar window event contract.

use common.io.window_capability.{
    WINDOW_CAP_CLIPBOARD,
    WINDOW_CAP_FOCUS,
    WINDOW_CAP_FRAMEBUFFER_SCALE,
    WINDOW_CAP_MAXIMIZE,
    WINDOW_CAP_MINIMIZE,
    WINDOW_CAP_PRESENT_ARGB,
    WINDOW_CAP_SHOW_HIDE,
    WINDOW_CAP_TEXT_INPUT,
    WindowCapability,
    window_capability,
}
use common.io.window_event.{
    WINDOW_EVENT_NONE,
    WINDOW_EVENT_TEXT,
    WINDOW_STATUS_BACKEND_ERROR,
    WINDOW_STATUS_OK,
    WindowEventLoop,
}

extern fn rt_glfw_init() -> i64
extern fn rt_glfw_terminate()
extern fn spl_str_ptr(value: text) -> i64
extern fn rt_glfw_create_window(title_ptr: i64, width: i64, height: i64) -> i64
extern fn rt_glfw_destroy_window(handle: i64) -> i64
extern fn rt_glfw_present_argb(
    handle: i64, pixels: [u32], width: i64, height: i64
) -> i64
extern fn rt_glfw_present_argb_words_raw(
    handle: i64,
    pixels_addr: i64,
    pixel_count: i64,
    width: i64,
    height: i64
) -> i64
extern fn rt_glfw_pump_events() -> i64
extern fn rt_glfw_pop_event() -> i64
extern fn rt_glfw_event_window() -> i64
extern fn rt_glfw_event_sequence() -> i64
extern fn rt_glfw_event_timestamp_ns() -> i64
extern fn rt_glfw_event_key() -> i64
extern fn rt_glfw_event_scancode() -> i64
extern fn rt_glfw_event_action() -> i64
extern fn rt_glfw_event_modifiers() -> i64
extern fn rt_glfw_event_x_milli() -> i64
extern fn rt_glfw_event_y_milli() -> i64
extern fn rt_glfw_event_dx_milli() -> i64
extern fn rt_glfw_event_dy_milli() -> i64
extern fn rt_glfw_event_width() -> i64
extern fn rt_glfw_event_height() -> i64
extern fn rt_glfw_event_text() -> text
extern fn rt_glfw_dropped_event_count() -> i64
extern fn rt_glfw_queued_event_count() -> i64
extern fn rt_glfw_live_window_count() -> i64
extern fn rt_glfw_should_close(handle: i64) -> i64
extern fn rt_glfw_set_visible(handle: i64, visible: i64) -> i64
extern fn rt_glfw_focus(handle: i64) -> i64
extern fn rt_glfw_minimize(handle: i64) -> i64
extern fn rt_glfw_maximize(handle: i64) -> i64
extern fn rt_glfw_restore(handle: i64) -> i64
extern fn rt_glfw_framebuffer_width(handle: i64) -> i64
extern fn rt_glfw_framebuffer_height(handle: i64) -> i64
extern fn rt_glfw_window_width(handle: i64) -> i64
extern fn rt_glfw_window_height(handle: i64) -> i64
extern fn rt_glfw_content_scale_milli(handle: i64) -> i64
extern fn rt_glfw_frame_sequence(handle: i64) -> i64
extern fn rt_glfw_clipboard_get(handle: i64) -> text
extern fn rt_glfw_clipboard_set(handle: i64, value: text) -> i64

class SimpleGlfw:
    available: bool
    init_status: i64
    events: WindowEventLoop

impl SimpleGlfw:
    static fn create(event_capacity: i64, text_capacity: i64) -> SimpleGlfw:
        val initialized = rt_glfw_init() != 0
        SimpleGlfw(
            available: initialized,
            init_status: if initialized:
                WINDOW_STATUS_OK
            else:
                WINDOW_STATUS_BACKEND_ERROR,
            events: WindowEventLoop.create(event_capacity, text_capacity)
        )

    fn backend_identity() -> text:
        if self.available: "glfw" else: "glfw-unavailable"

    fn capability(operation: i64) -> WindowCapability:
        val implemented = (
            operation == WINDOW_CAP_SHOW_HIDE or
            operation == WINDOW_CAP_FRAMEBUFFER_SCALE or
            operation == WINDOW_CAP_FOCUS or
            operation == WINDOW_CAP_MINIMIZE or
            operation == WINDOW_CAP_MAXIMIZE or
            operation == WINDOW_CAP_TEXT_INPUT or
            operation == WINDOW_CAP_CLIPBOARD or
            operation == WINDOW_CAP_PRESENT_ARGB
        )
        val supported = self.available and implemented
        window_capability(
            operation, supported,
            if supported:
                ""
            elif not self.available:
                "GLFW runtime is unavailable"
            else:
                "GLFW operation is unsupported"
        )

    me terminate():
        if self.available:
            rt_glfw_terminate()
        self.available = false

    fn create_window(title: text, width: i64, height: i64) -> i64:
        if not self.available:
            return 0
        rt_glfw_create_window(spl_str_ptr(title), width, height)

    fn destroy_window(handle: i64) -> i64:
        if not self.available:
            return WINDOW_STATUS_BACKEND_ERROR
        val status = rt_glfw_destroy_window(handle)
        if status == WINDOW_STATUS_OK:
            self.events.drop_window_events(handle)
        status

    fn present_argb(
        handle: i64, pixels: [u32], width: i64, height: i64
    ) -> i64:
        if not self.available:
            return WINDOW_STATUS_BACKEND_ERROR
        rt_glfw_present_argb(handle, pixels, width, height)

    fn present_argb_words_raw(
        handle: i64,
        pixels_addr: i64,
        pixel_count: i64,
        width: i64,
        height: i64
    ) -> i64:
        if not self.available:
            return WINDOW_STATUS_BACKEND_ERROR
        rt_glfw_present_argb_words_raw(
            handle, pixels_addr, pixel_count, width, height
        )

    me poll_events() -> i64:
        if not self.available:
            return WINDOW_STATUS_BACKEND_ERROR
        rt_glfw_pump_events()
        var kind = rt_glfw_pop_event()
        while kind != WINDOW_EVENT_NONE:
            val window_handle = rt_glfw_event_window()
            val sequence = rt_glfw_event_sequence()
            val timestamp_ns = rt_glfw_event_timestamp_ns()
            if kind == WINDOW_EVENT_TEXT:
                self.events.enqueue_text(
                    window_handle, sequence, timestamp_ns, rt_glfw_event_text()
                )
            else:
                self.events.enqueue_scalar(
                    kind, window_handle, sequence, timestamp_ns,
                    rt_glfw_event_key(), rt_glfw_event_scancode(),
                    rt_glfw_event_action(), rt_glfw_event_modifiers(),
                    rt_glfw_event_x_milli(), rt_glfw_event_y_milli(),
                    rt_glfw_event_dx_milli(), rt_glfw_event_dy_milli(),
                    rt_glfw_event_width(), rt_glfw_event_height()
                )
            kind = rt_glfw_pop_event()
        WINDOW_STATUS_OK

    me poll_event_scalar() -> i64:
        """Compatibility facade for the canonical scalar poll path."""
        self.events.poll_scalar()

    fn dropped_event_count() -> i64:
        self.events.dropped_event_count + rt_glfw_dropped_event_count()

    fn queued_event_count() -> i64:
        self.events.queued_count() + rt_glfw_queued_event_count()

    fn live_window_count() -> i64:
        rt_glfw_live_window_count()

    fn should_close(handle: i64) -> bool:
        rt_glfw_should_close(handle) != 0

    fn framebuffer_width(handle: i64) -> i64:
        rt_glfw_framebuffer_width(handle)

    fn framebuffer_height(handle: i64) -> i64:
        rt_glfw_framebuffer_height(handle)

    fn window_width(handle: i64) -> i64:
        rt_glfw_window_width(handle)

    fn window_height(handle: i64) -> i64:
        rt_glfw_window_height(handle)

    fn content_scale_milli(handle: i64) -> i64:
        rt_glfw_content_scale_milli(handle)

    fn frame_sequence(handle: i64) -> i64:
        rt_glfw_frame_sequence(handle)

    fn set_visible(handle: i64, visible: bool) -> i64:
        rt_glfw_set_visible(handle, if visible: 1 else: 0)

    fn focus(handle: i64) -> i64:
        rt_glfw_focus(handle)

    fn minimize(handle: i64) -> i64:
        rt_glfw_minimize(handle)

    fn maximize(handle: i64) -> i64:
        rt_glfw_maximize(handle)

    fn restore(handle: i64) -> i64:
        rt_glfw_restore(handle)

    fn clipboard_get(handle: i64) -> text:
        rt_glfw_clipboard_get(handle)

    fn clipboard_set(handle: i64, value: text) -> i64:
        rt_glfw_clipboard_set(handle, value)
