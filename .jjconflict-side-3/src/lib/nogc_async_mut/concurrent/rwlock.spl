"""
# No-GC Async RwLock Facade

Re-exports the no-GC sync RwLock backend, including the guard-pattern
`with_read`/`with_write` API (preferred over manual read()/write()/set()).

## WARNING: sync-backed — with_write's writer gate BLOCKS the OS thread

Same limitation as the async mutex facade: writer-gate contention blocks the
carrier OS thread rather than suspending the async task. See
doc/08_tracking/bug/async_mutex_blocks_carrier_thread_no_suspend_2026-07-28.md
"""

export use std.nogc_sync_mut.concurrent.rwlock.{RwLock, rwlock_new, rwlock_with_read, rwlock_with_write}
