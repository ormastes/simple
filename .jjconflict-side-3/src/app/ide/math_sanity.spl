# Math capability sanity probe.
#
# Runs against std.common.math_repr directly so the feature-check row reports
# real behavior instead of "manifest-only". Mirrors ide_mail_summary.

use std.common.math_repr.{render_latex_raw, to_pretty, to_text, to_debug, to_md}

fn ide_math_summary() -> text:
    # One expression through every renderer: LaTeX, Unicode pretty, and AST.
    val expr = "frac(a, b)"
    val latex = render_latex_raw(expr)
    val pretty = to_pretty(expr)
    val ast = to_debug(expr)
    val md = to_md(expr) == "$" + latex + "$"
    # Renderer specifics that would break independently of the parser.
    var checks = 0
    # NOTE: "{x}" inside one literal would be string interpolation, so the
    # expected LaTeX is spliced across two literals.
    if render_latex_raw("sqrt(x)") == "\\sqrt{" + "x}":
        checks = checks + 1
    if to_pretty("x^2") == "x²":
        checks = checks + 1
    if to_pretty("alpha") == "α":
        checks = checks + 1
    if to_text("") == "?" and render_latex_raw("") == "?":
        checks = checks + 1
    "math: std.common.math_repr latex={latex} pretty={pretty} ast={ast} md={md} checks={checks}/4"
