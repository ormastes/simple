# VirtIO-GPU 2D Command Types and Structures
#
# MDSOC: feature dimension, drivers layer
# VirtIO-GPU protocol uses request/response pairs sent via controlq.
# Each request starts with a VirtioGpuCtrlHdr (24 bytes).
#
# Reference: VirtIO specification v1.1, section 5.7

# ============================================================================
# Command Types — 2D commands
# ============================================================================

val VIRTIO_GPU_CMD_GET_DISPLAY_INFO: u32 = 0x0100
val VIRTIO_GPU_CMD_RESOURCE_CREATE_2D: u32 = 0x0101
val VIRTIO_GPU_CMD_RESOURCE_UNREF: u32 = 0x0102
val VIRTIO_GPU_CMD_SET_SCANOUT: u32 = 0x0103
val VIRTIO_GPU_CMD_RESOURCE_FLUSH: u32 = 0x0104
val VIRTIO_GPU_CMD_TRANSFER_TO_HOST_2D: u32 = 0x0105
val VIRTIO_GPU_CMD_RESOURCE_ATTACH_BACKING: u32 = 0x0106
val VIRTIO_GPU_CMD_RESOURCE_DETACH_BACKING: u32 = 0x0107

# ============================================================================
# Command Types — 3D / capset / blob commands (WS-E1)
# ============================================================================
#
# Only the capset-query pair is *used* by E1. The remaining 3D/blob opcodes are
# declared here so E2 (ring transport) does not have to re-derive them, and so
# the numbering is reviewable against virtio_gpu.h in one place.

val VIRTIO_GPU_CMD_GET_CAPSET_INFO: u32 = 0x0108
val VIRTIO_GPU_CMD_GET_CAPSET: u32 = 0x0109
val VIRTIO_GPU_CMD_GET_EDID: u32 = 0x010a
val VIRTIO_GPU_CMD_RESOURCE_ASSIGN_UUID: u32 = 0x010b
val VIRTIO_GPU_CMD_RESOURCE_CREATE_BLOB: u32 = 0x010c
val VIRTIO_GPU_CMD_SET_SCANOUT_BLOB: u32 = 0x010d

val VIRTIO_GPU_CMD_CTX_CREATE: u32 = 0x0200
val VIRTIO_GPU_CMD_CTX_DESTROY: u32 = 0x0201
val VIRTIO_GPU_CMD_CTX_ATTACH_RESOURCE: u32 = 0x0202
val VIRTIO_GPU_CMD_CTX_DETACH_RESOURCE: u32 = 0x0203
val VIRTIO_GPU_CMD_RESOURCE_CREATE_3D: u32 = 0x0204
val VIRTIO_GPU_CMD_TRANSFER_TO_HOST_3D: u32 = 0x0205
val VIRTIO_GPU_CMD_TRANSFER_FROM_HOST_3D: u32 = 0x0206
val VIRTIO_GPU_CMD_SUBMIT_3D: u32 = 0x0207
val VIRTIO_GPU_CMD_RESOURCE_MAP_BLOB: u32 = 0x0208
val VIRTIO_GPU_CMD_RESOURCE_UNMAP_BLOB: u32 = 0x0209

# ============================================================================
# Device Feature Bits (virtio-gpu, low feature word — select=0)
# ============================================================================
#
# Declared u32 deliberately: all defined virtio-gpu device feature bits live in
# the LOW feature word, which the modern common-cfg reads/writes as a u32. Using
# u64 here would force a mixed-width mask against `modern_read32`.

val VIRTIO_GPU_F_VIRGL: u32 = 0x01          # bit 0 — 3D / virgl contexts
val VIRTIO_GPU_F_EDID: u32 = 0x02           # bit 1
val VIRTIO_GPU_F_RESOURCE_UUID: u32 = 0x04  # bit 2
val VIRTIO_GPU_F_RESOURCE_BLOB: u32 = 0x08  # bit 3
val VIRTIO_GPU_F_CONTEXT_INIT: u32 = 0x10   # bit 4

# The set E1 requests: VIRGL | RESOURCE_BLOB | CONTEXT_INIT = 0x19.
# EDID and RESOURCE_UUID are deliberately NOT requested — they are unrelated to
# Venus and acking them would change existing 2D display-info behavior.
val VIRTIO_GPU_WANT_FEATURES_3D: u32 = 0x19

# ============================================================================
# Capset ids (virtio_gpu.h) — SPEC CONSTANTS, not measurements
# ============================================================================

val VIRTIO_GPU_CAPSET_VIRGL: u32 = 1
val VIRTIO_GPU_CAPSET_VIRGL2: u32 = 2
val VIRTIO_GPU_CAPSET_GFXSTREAM: u32 = 3
val VIRTIO_GPU_CAPSET_VENUS: u32 = 4

# ============================================================================
# Command Types — Cursor commands
# ============================================================================

val VIRTIO_GPU_CMD_UPDATE_CURSOR: u32 = 0x0300
val VIRTIO_GPU_CMD_MOVE_CURSOR: u32 = 0x0301

# ============================================================================
# Response Types
# ============================================================================

val VIRTIO_GPU_RESP_OK_NODATA: u32 = 0x1100
val VIRTIO_GPU_RESP_OK_DISPLAY_INFO: u32 = 0x1101
val VIRTIO_GPU_RESP_OK_CAPSET_INFO: u32 = 0x1102
val VIRTIO_GPU_RESP_OK_CAPSET: u32 = 0x1103
val VIRTIO_GPU_RESP_OK_EDID: u32 = 0x1104
val VIRTIO_GPU_RESP_OK_RESOURCE_UUID: u32 = 0x1105
val VIRTIO_GPU_RESP_OK_MAP_INFO: u32 = 0x1106
val VIRTIO_GPU_RESP_ERR_UNSPEC: u32 = 0x1200
val VIRTIO_GPU_RESP_ERR_OUT_OF_MEMORY: u32 = 0x1201
val VIRTIO_GPU_RESP_ERR_INVALID_SCANOUT_ID: u32 = 0x1202
val VIRTIO_GPU_RESP_ERR_INVALID_RESOURCE_ID: u32 = 0x1203

# ============================================================================
# Pixel Formats
# ============================================================================

val VIRTIO_GPU_FORMAT_B8G8R8A8_UNORM: u32 = 1
val VIRTIO_GPU_FORMAT_B8G8R8X8_UNORM: u32 = 2
val VIRTIO_GPU_FORMAT_A8R8G8B8_UNORM: u32 = 3
val VIRTIO_GPU_FORMAT_X8R8G8B8_UNORM: u32 = 4
val VIRTIO_GPU_FORMAT_R8G8B8A8_UNORM: u32 = 67
val VIRTIO_GPU_FORMAT_X8B8G8R8_UNORM: u32 = 68
val VIRTIO_GPU_FORMAT_A8B8G8R8_UNORM: u32 = 121
val VIRTIO_GPU_FORMAT_R8G8B8X8_UNORM: u32 = 134

# ============================================================================
# Struct Sizes (for DMA buffer layout)
# ============================================================================
#
# VirtioGpuCtrlHdr:          24 bytes (type:u32, flags:u32, fence_id:u64, ctx_id:u32, padding:u32)
# VirtioGpuRect:             16 bytes (x:u32, y:u32, width:u32, height:u32)
# VirtioGpuMemEntry:         16 bytes (addr:u64, length:u32, padding:u32)

val CTRL_HDR_SIZE: u64 = 24
val RECT_SIZE: u64 = 16
val MEM_ENTRY_SIZE: u64 = 16

# GET_DISPLAY_INFO response: hdr(24) + 16 displays * (rect(16) + enabled:u32 + flags:u32) = 24 + 16*24 = 408
val DISPLAY_INFO_RESP_SIZE: u64 = 408

# RESOURCE_CREATE_2D: hdr(24) + resource_id(4) + format(4) + width(4) + height(4) = 40
val RESOURCE_CREATE_SIZE: u64 = 40

# SET_SCANOUT: hdr(24) + rect(16) + scanout_id(4) + resource_id(4) = 48
val SET_SCANOUT_SIZE: u64 = 48

# TRANSFER_TO_HOST_2D: hdr(24) + rect(16) + offset(8) + resource_id(4) + padding(4) = 56
val TRANSFER_SIZE: u64 = 56

# RESOURCE_ATTACH_BACKING: hdr(24) + resource_id(4) + nr_entries(4) = 32
# Followed by nr_entries * MEM_ENTRY (16 each)
val ATTACH_BACKING_HDR_SIZE: u64 = 32
val ATTACH_BACKING_TOTAL_SIZE: u64 = 48  # hdr(32) + 1 mem_entry(16)

# RESOURCE_FLUSH: hdr(24) + rect(16) + resource_id(4) + padding(4) = 48
val FLUSH_SIZE: u64 = 48

# RESOURCE_DETACH_BACKING: hdr(24) + resource_id(4) + padding(4) = 32
val DETACH_BACKING_SIZE: u64 = 32

# RESOURCE_UNREF: hdr(24) + resource_id(4) + padding(4) = 32
val RESOURCE_UNREF_SIZE: u64 = 32

# ----------------------------------------------------------------------------
# Capset query layouts (WS-E1)
# ----------------------------------------------------------------------------
#
# GET_CAPSET_INFO request:  hdr(24) + capset_index(4) + padding(4) = 32
val GET_CAPSET_INFO_SIZE: u64 = 32

# RESP_OK_CAPSET_INFO:      hdr(24) + capset_id(4) + capset_max_version(4)
#                                   + capset_max_size(4) + padding(4) = 40
val RESP_CAPSET_INFO_SIZE: u64 = 40

# GET_CAPSET request:       hdr(24) + capset_id(4) + capset_version(4) = 32
val GET_CAPSET_SIZE: u64 = 32

# Field offsets inside a RESP_OK_CAPSET_INFO buffer (relative to buffer start).
val CAPSET_INFO_OFF_ID: u64 = 24
val CAPSET_INFO_OFF_MAX_VERSION: u64 = 28
val CAPSET_INFO_OFF_MAX_SIZE: u64 = 32

# Field offsets inside a GET_CAPSET request buffer.
val GET_CAPSET_OFF_ID: u64 = 24
val GET_CAPSET_OFF_VERSION: u64 = 28

# Field offset of capset_index inside a GET_CAPSET_INFO request buffer.
val GET_CAPSET_INFO_OFF_INDEX: u64 = 24
