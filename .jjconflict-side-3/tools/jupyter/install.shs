#!/bin/sh
# Install the Simple Jupyter kernelspec, plus (X2) the jupyterlab-lsp server
# spec that points the LSP client at `bin/simple run src/app/lsp/main.spl`.
#
# Copies kernel.json (with the real kernel_wrapper.py path substituted for
# the "<path>" placeholder) plus kernel_wrapper.py into a staging directory,
# then registers it with `jupyter kernelspec install`. See
# doc/07_guide/app/tools/jupyter.md for the documented contract this script
# implements.
#
# The LSP server spec (lsp_server_spec.json) is data, not code: jupyter-lsp's
# `LanguageServerManager.language_servers` traitlet is server-side config it
# reads from `jupyter_server_config.json`, and there is no frontend/labextension
# API to register a new language server (the JupyterLab-bundled @jupyterlab/lsp
# client only *consumes* servers jupyter-lsp already spawned). We merge our one
# key into the user's existing config with a `python3 -c` JSON merge (the same
# pattern this script already uses for the pyzmq/prefix checks below) so an
# existing jupyter_server_config.json isn't clobbered.

set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)/..
REPO_ROOT=$(CDPATH= cd -- "$REPO_ROOT" && pwd)

fail() {
    echo "[FAIL] $*" >&2
    exit 1
}

command -v jupyter >/dev/null 2>&1 || fail "jupyter is required (pip install notebook jupyter_client pyzmq)"
command -v python3 >/dev/null 2>&1 || fail "python3 is required"
python3 -c "import zmq" >/dev/null 2>&1 || fail "pyzmq is required (pip install pyzmq)"

USER_FLAG="--user"
if [ "${SIMPLE_JUPYTER_SYSTEM_INSTALL:-0}" = "1" ]; then
    USER_FLAG=""
fi

STAGE=$(mktemp -d "${TMPDIR:-/tmp}/simple-jupyter-kernelspec.XXXXXX")
trap 'rm -rf "$STAGE"' EXIT HUP INT TERM

WRAPPER_PATH="$SCRIPT_DIR/kernel_wrapper.py"
[ -f "$WRAPPER_PATH" ] || fail "missing $WRAPPER_PATH"

cp "$WRAPPER_PATH" "$STAGE/kernel_wrapper.py"
chmod 755 "$STAGE/kernel_wrapper.py"

# `jupyter kernelspec install` copies the staging directory's contents
# (kernel.json + kernel_wrapper.py) verbatim into its data-dir destination
# and then discards the staging directory -- so kernel.json's argv must
# already point at wherever kernel_wrapper.py will *land*, not at $STAGE.
# `jupyter --data-dir` plus the --user/--sys-prefix choice below determines
# that destination the same way `jupyter kernelspec install` computes it.
if [ -n "$USER_FLAG" ]; then
    DEST_BASE=$(jupyter --data-dir)
else
    DEST_BASE=$(python3 -c "import sys; print(sys.prefix)")/share/jupyter
fi
DEST_DIR="$DEST_BASE/kernels/simple"
WRAPPER_DEST="$DEST_DIR/kernel_wrapper.py"

# Substitute the "<path>" placeholder in kernel.json's argv with the real,
# absolute path the wrapper script will be installed at.
sed "s#<path>/kernel_wrapper.py#$WRAPPER_DEST#" "$SCRIPT_DIR/kernel.json" > "$STAGE/kernel.json"

# shellcheck disable=SC2086
jupyter kernelspec install "$STAGE" --name simple $USER_FLAG

echo "[OK] Simple kernelspec installed. Verify with: jupyter kernelspec list"

# --- X2: jupyterlab-lsp server spec -----------------------------------------
LSP_SPEC_SRC="$SCRIPT_DIR/lsp_server_spec.json"
if [ -f "$LSP_SPEC_SRC" ]; then
    CONFIG_DIR=$(jupyter --config-dir)
    mkdir -p "$CONFIG_DIR"
    SERVER_CONFIG="$CONFIG_DIR/jupyter_server_config.json"
    RESOLVED_SPEC=$(sed "s#<repo_root>#$REPO_ROOT#g" "$LSP_SPEC_SRC")
    python3 - "$SERVER_CONFIG" "$RESOLVED_SPEC" <<'PYEOF'
import json
import sys

dest_path, spec_json = sys.argv[1], sys.argv[2]
spec = json.loads(spec_json)

try:
    with open(dest_path, "r", encoding="utf-8") as f:
        existing = json.load(f)
except (FileNotFoundError, json.JSONDecodeError):
    existing = {}

existing.setdefault("LanguageServerManager", {}).setdefault("language_servers", {})
existing["LanguageServerManager"]["language_servers"].update(
    spec["LanguageServerManager"]["language_servers"]
)

with open(dest_path, "w", encoding="utf-8") as f:
    json.dump(existing, f, indent=4)
    f.write("\n")
PYEOF
    echo "[OK] simple-lsp server spec merged into $SERVER_CONFIG (requires jupyter-lsp: pip install jupyterlab-lsp)"
else
    echo "[WARN] $LSP_SPEC_SRC not found, skipping LSP server spec install" >&2
fi
