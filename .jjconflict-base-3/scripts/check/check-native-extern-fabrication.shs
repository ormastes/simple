#!/bin/sh
# Regression gate for AOT (`native-build`) host-target `@extern fn` fabrication.
#
# WHY THIS EXISTS: `bin/simple test` hard-defaults to the tree-walk interpreter
# and has no AOT mode (TestExecutionMode has Native/Process/Safe/Container
# variants but "Native" there means unsandboxed *process execution*, not the
# LLVM AOT backend) -- so no `*_spec.spl` can ever observe this lane. Only a
# script that actually drives `simple native-build` / `simple compile --native`
# can fence it.
#
# Bug: doc/08_tracking/bug/native_link_fabricates_weak_empty_extern_definitions_2026-08-01.md
#
# Background: an `@extern fn` with NO implementation anywhere should fail the
# link (or at minimum crash loudly at the call site). Instead, native codegen
# emits a small DEFINED stub body for the missing symbol, so the link succeeds
# silently and the program runs to completion returning a fabricated value
# (observed: a zero/garbage return) instead of failing. A prior fix landed a
# link-time guard, `check_no_fabricated_extern_definitions`
# (`src/compiler_rust/compiler/src/linker/native_binary/stubs.rs`), but the
# deployed `bin/simple` in this checkout IS the Rust seed (confirmed via its
# `--version` seed banner), and that guard is NOT reliably in its own request
# path: `native-build` routes via `driver/src/cli/native_build.rs:34,610` to
# `NativeProjectBuilder` (`pipeline/native_project`), which has its own
# `linker.rs` that never calls the guard. `check_no_fabricated_extern_definitions`
# is called only from `linker/native_binary/builder.rs:95`, reachable only via
# `pipeline/execution.rs:801,925` (the single-module path) -- a different
# pipeline than the one `native-build` actually drives. Even if that pipeline
# were reached, the guard's predicate (`*ty == 'W' && !*has_size`,
# `stubs.rs:551-553`) could NOT match a strong (`T`), size-3 symbol -- so
# there are two independent reasons this guard never fires here, not one. The
# pure-Simple self-hosted compiler's own HOST-target link path
# (`link_llvm_native` in src/compiler/70.backend/backend/llvm_native_link.spl:1045)
# is a SEPARATE, untested-by-this-fence code path: `simpleos_check_no_fabricated_rt_stubs`
# is wired ONLY into the SimpleOS freestanding branches
# (`link_simpleos_x86_64/arm64/riscv64/riscv32`) a few lines above, never into
# the generic hosted-C-runtime branch that `link_llvm_native` itself takes --
# but this script exercises the deployed seed binary, not that path, so it
# says nothing about whether `link_llvm_native` has the same gap.
#
# Verified 2026-08-08: `SIMPLE_NO_STUB_FALLBACK=1` makes NO difference on this
# path (it is read only inside the SimpleOS-only guard). The fabricated symbol
# links as a STRONG (`T`, not even weak) 3-byte defined text-section symbol,
# so `nm -u` never sees it and no undefined-symbol check can catch it. This
# script therefore asserts the CURRENT (defective) behaviour as KNOWN-OPEN --
# see rationale in check-native-enum-match-payload.shs for the pattern -- so a
# future fix (the symbol becomes correctly unresolved, or the build fails)
# flips this gate to a hard PASS/FAIL and is reported loudly, not silently
# absorbed.
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

SIMPLE_BINARY="${SIMPLE_BINARY:-bin/simple}"
WORK_DIR="${WORK_DIR:-/tmp/check-native-extern-fabrication.$$}"
ABSENT_FIXTURE="test/fixtures/native_extern_fabrication_probe/main.spl"
CONTROL_FIXTURE="test/fixtures/native_extern_fabrication_probe/control.spl"
ABSENT_SYMBOL="lane_definitely_absent_probe"

test -x "$SIMPLE_BINARY"
mkdir -p "$WORK_DIR"
trap 'rm -rf "$WORK_DIR"' EXIT HUP INT TERM

fail=0

# --- Control: an entry with NO extern reference must still build & run
#     correctly under native-build, so this gate cannot be vacuously green
#     because native-build itself is broken.
ctrl_bin="$WORK_DIR/control"
ctrl_log="$WORK_DIR/control.log"
if ! env -u SIMPLE_BOOTSTRAP "$SIMPLE_BINARY" native-build \
    --source test/fixtures --entry-closure --entry "$CONTROL_FIXTURE" \
    --cache-dir "$WORK_DIR/cache-ctrl" --output "$ctrl_bin" >"$ctrl_log" 2>&1; then
    echo "FAIL — control fixture (no extern) no longer builds under native-build"
    sed -n '1,20p' "$ctrl_log"
    fail=1
else
    ctrl_out="$(timeout 20 "$ctrl_bin" 2>>"$ctrl_log" || true)"
    ctrl_rc=0
    timeout 20 "$ctrl_bin" >/dev/null 2>>"$ctrl_log" || ctrl_rc=$?
    if [ "$ctrl_out" != "ctrl-ok" ] || [ "$ctrl_rc" -ne 7 ]; then
        echo "FAIL — control fixture output/exit regressed (native-build itself broken)"
        echo "  expected: stdout=ctrl-ok exit=7"
        echo "  actual:   stdout=$ctrl_out exit=$ctrl_rc"
        fail=1
    fi
fi

# --- Known-open gap: a genuinely-absent (never implemented anywhere) @extern
#     fn should fail the link or crash at the call site. Test BOTH with and
#     without SIMPLE_NO_STUB_FALLBACK=1 -- a defect that only manifests with
#     the guard off would be a materially different (more defensible) finding
#     than one that manifests even with the strict guard on.
check_absent_case() {
    label="$1"
    extra_env="$2"
    bin_path="$WORK_DIR/absent-$label"
    log_path="$WORK_DIR/absent-$label.log"
    build_rc=0
    env -u SIMPLE_BOOTSTRAP $extra_env "$SIMPLE_BINARY" native-build \
        --source test/fixtures --entry-closure --entry "$ABSENT_FIXTURE" \
        --cache-dir "$WORK_DIR/cache-$label" --output "$bin_path" >"$log_path" 2>&1 || build_rc=$?

    if [ "$build_rc" -ne 0 ]; then
        # A nonzero exit alone does not prove the expected refusal happened --
        # any unrelated build breakage (toolchain missing, fixture path wrong,
        # unrelated codegen crash) also exits nonzero and must not be read as
        # "the fabrication gap closed". Require the log to actually name the
        # absent symbol before treating this as the expected refusal.
        if ! grep -q "$ABSENT_SYMBOL" "$log_path"; then
            echo "FAIL — [$label] native-build exited $build_rc, but the log never"
            echo "       mentions '$ABSENT_SYMBOL' -- this looks like an UNRELATED build"
            echo "       failure, not the expected extern-fabrication refusal. Investigate"
            echo "       rather than treating this as the gap having closed."
            sed -n '1,20p' "$log_path"
            fail=1
            return 0
        fi
        echo "NOTE — [$label] native-build now REFUSES the genuinely-absent extern"
        echo "       (build exit $build_rc) and the log names '$ABSENT_SYMBOL'. The"
        echo "       codegen-side fabrication gap in"
        echo "       doc/08_tracking/bug/native_link_fabricates_weak_empty_extern_definitions_2026-08-01.md"
        echo "       may have closed for this env combination. Promote this branch"
        echo "       to a hard PASS assertion (require nonzero exit + a diagnostic"
        echo "       naming '$ABSENT_SYMBOL')."
        return 0
    fi

    # Build succeeded (exit 0) despite the extern never being implemented
    # anywhere. Confirm the fabrication with hard nm evidence rather than
    # trusting the absence of a build error.
    if ! [ -x "$bin_path" ]; then
        echo "FAIL — [$label] native-build exited 0 but produced no runnable binary (unexpected)"
        fail=1
        return 0
    fi

    defined_line="$(nm -S "$bin_path" 2>/dev/null | grep " $ABSENT_SYMBOL\$" || true)"
    undefined_line="$(nm -u "$bin_path" 2>/dev/null | grep " $ABSENT_SYMBOL\$" || true)"

    if [ -z "$defined_line" ]; then
        echo "FAIL — [$label] native-build exited 0, no fabricated symbol found by nm, and no"
        echo "       diagnostic was printed. This is an UNEXPECTED third outcome — investigate"
        echo "       manually rather than trusting either known state."
        sed -n '1,20p' "$log_path"
        fail=1
        return 0
    fi

    run_out="$(timeout 20 "$bin_path" 2>>"$log_path" || true)"
    echo "KNOWN-OPEN — [$label] native-build fabricates a DEFINED symbol for the"
    echo "             never-implemented extern '$ABSENT_SYMBOL' instead of failing:"
    echo "             nm -S: $defined_line"
    echo "             nm -u: ${undefined_line:-<none -- symbol is NOT undefined, confirming fabrication>}"
    echo "             program ran to completion: $run_out"
}

check_absent_case "default" ""
check_absent_case "strict" "SIMPLE_NO_STUB_FALLBACK=1"

if [ "$fail" -ne 0 ]; then
    exit 1
fi

echo "PASS — native-build extern fabrication: control unaffected, known-open gap unchanged (see KNOWN-OPEN lines above)"
