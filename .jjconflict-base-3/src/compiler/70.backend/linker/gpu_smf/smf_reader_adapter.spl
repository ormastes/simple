# ============================================================================
# compiler/70.backend/linker/gpu_smf/smf_reader_adapter.spl — L1-decode adapter
# (Lane L1ADAPT)
#
# Closes the gap `smf_link_profile.spl`'s header note leaves open: a thin
# adapter from a real decoded SMF symbol table to `SmfSymbolInput` (contract
# doc §6, smf_linker_map.md §3 L1 row).
#
# Route taken — writer-side symbols, not a read-back `.smf` file, and why:
#
#   1. `SmfReaderImpl.open` (smf_reader.spl:186) can only populate
#      `symbols: Dict<text, SmfSymbol>` through `SmfReaderFfi.open`, which
#      calls `rt_smf_reader_open` (smf_reader.spl:31). That extern has no
#      implementation anywhere in the runtime — grepped
#      `src/compiler_rust/`, `src/runtime/`, and every `.rs`/`.c`/`.cpp` file
#      in the repo for `rt_smf_reader_open`; the only match is its own
#      `extern fn` declaration in smf_reader.spl. Calling it would silently
#      return nil (unregistered-extern behavior), not a usable handle.
#   2. There is no checked-in `.smf` fixture anywhere under `test/` (`find
#      test -iname '*.smf'` is empty) to sidestep (1) by reading a
#      pre-built file.
#   3. Building a fresh `.smf` byte artifact via `SmfWriter.write()`
#      (smf_writer.spl:258) does not help either: `write()` is a stub —
#      it declares `extern fn rt_smf_write` locally and then unconditionally
#      `return`s `Ok([])`, regardless of the sections/symbols/relocations
#      added. So even the write half of routes (a)/(b) produces no real
#      bytes today.
#
# With both the read path (1)+(2) and the write path (3) confirmed dead,
# this adapter follows the fallback the lane brief and smf_link_profile.spl's
# own header note both name explicitly: adapt from the writer-side
# `SmfWriterSymbol` list (smf_writer.spl:137-146) — the closest real,
# exercised, non-fabricated symbol shape in this directory — instead of a
# `SmfReaderImpl.symbols` dict this codebase cannot yet construct outside a
# live SFFI handle.
#
# `defined` derivation: `SmfSymbolInput.defined` (smf_link_profile.spl:74-87)
# documents the rule as "whatever the reader considers 'has code' (e.g.
# `size > 0` / a valid `section_index`)". Read disjunctively, as written:
# a symbol counts as defined when it carries a positive size OR sits in a
# real (non-negative) section — either signal alone is evidence this module
# supplies a body, not just a name. `SmfWriterSymbol.section_index` is `i64`
# so "invalid" is modeled the same way ELF/SMF conventionally mark an
# external reference: a negative index.
#
# Composition only, no inheritance (repo rule): plain value structs, free
# functions, same discipline as smf_link_profile.spl.
# ============================================================================

use compiler.backend.linker.smf_writer.{
    SmfWriterSymbol,
    SmfWriterSymbolBinding,
    SmfWriterSymbolType
}
use compiler.backend.linker.gpu_smf.smf_link_profile.{SmfSymbolInput}
use compiler.backend.linker.gpu_smf.smf_link_attributes.{
    SMF_LINK_BINDING_GLOBAL,
    SMF_LINK_BINDING_LOCAL,
    SMF_LINK_BINDING_WEAK,
    SMF_LINK_SYM_TYPE_FUNCTION,
    SMF_LINK_SYM_TYPE_NOTYPE,
    SMF_LINK_SYM_TYPE_OBJECT,
    SMF_LINK_SYM_TYPE_SECTION
}

fn smf_link_binding_code(binding: SmfWriterSymbolBinding) -> u32:
    """Map the writer-side binding enum onto the frozen schema-v1 u32 code
    (smf_link_attributes.spl bits 1-2). Total: every variant is assigned;
    code 3 (the hard-rejected unknown discriminant) is unreachable from
    this enum by construction."""
    match binding:
        case Local: SMF_LINK_BINDING_LOCAL
        case Global: SMF_LINK_BINDING_GLOBAL
        case Weak: SMF_LINK_BINDING_WEAK

fn smf_link_sym_type_code(sym_type: SmfWriterSymbolType) -> u32:
    """Map the writer-side symbol-type enum onto the frozen schema-v1 u32
    code (smf_link_attributes.spl bits 3-4). Total over all four variants."""
    match sym_type:
        case NoType: SMF_LINK_SYM_TYPE_NOTYPE
        case Function: SMF_LINK_SYM_TYPE_FUNCTION
        case Object: SMF_LINK_SYM_TYPE_OBJECT
        case Section: SMF_LINK_SYM_TYPE_SECTION

fn smf_symbol_input_from_writer_symbol(sym: SmfWriterSymbol) -> SmfSymbolInput:
    """Adapt one writer-side symbol into the profile's `SmfSymbolInput`.

    `defined` is true when `sym.size > 0` or `sym.section_index >= 0` —
    see the file header for the disjunctive reading of the documented rule.
    Attribute fields map 1:1: enum bindings/types via the code mappers
    above, `layout_phase` narrowed from the writer's i64 (documented range
    0-3; an out-of-range value is width-masked by
    `smf_link_attributes_encode`, never silently widened here), and the two
    bool flags carried through unchanged.
    """
    val has_size = sym.size > 0
    val has_section = sym.section_index >= 0
    SmfSymbolInput(
        name: sym.name,
        defined: has_size or has_section,
        binding: smf_link_binding_code(sym.binding),
        sym_type: smf_link_sym_type_code(sym.sym_type),
        layout_phase: sym.layout_phase as u32,
        is_event_loop_anchor: sym.is_event_loop_anchor,
        layout_pinned: sym.layout_pinned,
        section_index: sym.section_index)

fn smf_symbol_inputs_from_writer_symbols(symbols: [SmfWriterSymbol]) -> [SmfSymbolInput]:
    """Adapt a whole writer-side symbol list, preserving input order (the
    order `smf_collect_records` uses to build its running `order` counter
    and `EntityRef.local_index`)."""
    var out: [SmfSymbolInput] = []
    for sym in symbols:
        out.push(smf_symbol_input_from_writer_symbol(sym))
    out
