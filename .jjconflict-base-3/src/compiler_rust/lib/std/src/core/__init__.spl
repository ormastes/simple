# Core Module - Variant-agnostic pure utilities
# No allocation, no side effects

@variant(any)
mod core

# Fundamental types and traits
export option.*
export result.*
# Exclude names owned by specialized facade modules below: Ordering/Eq/Ord,
# Error, Iterator, and Display/Debug.
export use traits.{Default, Clone, Number, Hash}
export use traits.{From, Into, TryFrom, TryInto, FromIterator, IntoIterator}
export use traits.{Add, Sub, Mul, Div, Neg, Not, Index, IndexMut}
export use traits.{Deref, DerefMut, Drop, Sized, SeekFrom}
export use traits.{Read, Write, Seek, BufRead, Len, Extend}
export use traits.{AsSlice, AsMutSlice, Clear, Capacity, Reserve}
export use traits.{AsRef, AsMut, Borrow, BorrowMut, ToOwned, ToString, FromStr}
export use traits.{DoubleEndedIterator, ExactSizeIterator}
export use traits.{Sendable, Shareable, Unpinnable, Fn, FnMut, FnOnce, Rev}

# Collection traits and types
export collections.*
export list.*
export array.*
export set.*
export string.*

# JSON support
export json.*

# Math and numeric utilities
export math.*

# random.spl currently contains only an internal sqrt helper; exporting it
# would collide with the canonical math.sqrt facade.

# Regular expressions
export regex.*

# Synchronization primitives
export synchronization.*

# Domain-specific languages
export dsl.*

# Decorator support
export decorators.*

# Context management
export use context.{ContextManager, Lock, TransactionContext}

# Resource cleanup
export resource.*
export resource_registry.*
export leak_tracked.*

# Package-wide unqualified exports are ambiguous when two sibling files define
# the same declaration name. Keep each specialized facade bound to its owner.
export use cmp_ord.{Ordering, Eq, PartialOrd, Ord, Reverse}
export use cmp_ord.{min, max, clamp}

export use error.{Error, GenericError, IoError, IoErrorKind, ParseError}
export use error.{error_to_string, error_chain_string}

export use fmt.{Display, Debug, Binary, Hex, Octal, FormatSpec, StringBuilder}
export use fmt.{pad_left, pad_right, pad_center}
export use fmt.{format_int_binary, format_int_hex, format_int_octal, format_float}
export use fmt.{dbg}

export use graph.{Edge, Graph}
export use graph.{dfs, bfs, dijkstra, bellman_ford, topological_sort}
export use graph.{has_cycle_directed, has_cycle_undirected}
export use graph.{connected_components, is_bipartite, kruskal_mst}

export use iter.{Iterator, SkipIterator, TakeIterator, FilterIterator, MapIterator}
export use iter.{RangeIterator, range, range_from, range_step}

export use regex_parser.{RegexNode, LiteralNode, CharClassNode, ConcatNode, AltNode}
export use regex_parser.{StarNode, PlusNode, QuestionNode, QuantNode, GroupNode, AnchorNode}
export use regex_parser.{NFAState, NFAFragment, NFA, RegexParser}
export use regex_engine.{NFABuilder, NFAMatcher, CompiledRegex}
export use regex_api.{Match, Pattern}
export use regex_api.{compile, match, search, fullmatch, findall, sub, split, escape}
export use regex_api.{is_match, extract_text}
export use regex_api.{digit, word, whitespace, any_char}
export use regex_api.{zero_or_more, one_or_more, optional}
export use regex_api.{exactly, at_least, between}
export use regex_api.{start_of_line, end_of_line, word_boundary}

# Re-exported from time.spl
export use time.{DateTime, Duration, TimeZone, Timer}
export use time.{now_iso8601, now_timestamp, now_ms, now_ns}
export use time.{days_between, seconds_between}
export use time.{from_unix_timestamp, date_to_unix_timestamp}
export use time.{format_unix_to_iso8601, format_date_time}
