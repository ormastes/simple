# Opt-in Calc semantic UI access server.
#
# The server mounts the existing /api/test/ui surface used by `simple ui`.
# It is not SGTTI and it does not define an Office-specific protocol.

use app.office.sheets.access_controller.{calc_access_controller_new}
use app.ui.standalone.{StandaloneOptions, run_test_api_server_with_inject}
use nogc_sync_mut.ui.session.{UISession}

fn run_calc_access_server(port: i32) -> i32:
    if port <= 0 or port > 65535:
        print "Error: Calc UI access port must be between 1 and 65535"
        return 1
    val controller = calc_access_controller_new()
    val session = UISession.new(controller.ui_tree())
    val inject = \event:
        controller.apply_ui_event(event)
        session.dispatch(event)
        session.update_tree(controller.ui_tree())
        print controller.tui_text()
    print controller.tui_text()
    val address = "127.0.0.1:" + port.to_text()
    run_test_api_server_with_inject(
        session,
        StandaloneOptions.new_with_title(address, "Simple Calc TUI"),
        inject
    )
    0

export run_calc_access_server
