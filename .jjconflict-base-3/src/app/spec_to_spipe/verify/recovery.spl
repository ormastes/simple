use app.spec_to_spipe.verify.contracts.*
use app.spec_to_spipe.model.{SpecErrorNode}

fn _verify_error_node(node: SpecErrorNode, strict: bool,
        approved_rule_ids: [text]) -> SpecVerificationResult:
    var rules: [text] = []
    var messages: [text] = []
    if node.source_span.byte_start < 0 or node.source_span.byte_end <= node.source_span.byte_start:
        rules.push("SPEC-REC-001")
        messages.push("error node has an invalid raw source span")
    if node.raw_source.len() == 0:
        rules.push("SPEC-REC-002")
        messages.push("error node does not preserve raw source")
    if node.adapter_rule_id.trim().len() == 0:
        rules.push("SPEC-REC-003")
        messages.push("error node has no adapter rule ID")
    if node.diagnostic_id.trim().len() == 0:
        rules.push("SPEC-REC-004")
        messages.push("error node did not retain a diagnostic identity")
    if node.recovered and strict:
        rules.push("SPEC-REC-006")
        messages.push("strict mode rejects recovered error nodes")
    elif node.recovered and not approved_rule_ids.contains(node.adapter_rule_id):
        rules.push("SPEC-REC-007")
        messages.push("error node recovery is not approved by the compatibility manifest")
    for child in node.children:
        if child.source_span.byte_start < node.source_span.byte_start or
                child.source_span.byte_end > node.source_span.byte_end:
            rules.push("SPEC-REC-005")
            messages.push("nested error node lies outside its parent span")
        val child_result = _verify_error_node(child, strict, approved_rule_ids)
        for rule_id in child_result.rule_ids:
            rules.push(rule_id)
        for message in child_result.messages:
            messages.push(message)
    verification_result(rules, messages)

fn verify_no_silent_recovery(recoveries: [SpecErrorNode], strict: bool,
        approved_rule_ids: [text]) -> SpecVerificationResult:
    var rules: [text] = []
    var messages: [text] = []
    for recovery in recoveries:
        val result = _verify_error_node(recovery, strict, approved_rule_ids)
        for rule_id in result.rule_ids:
            rules.push(rule_id)
        for message in result.messages:
            messages.push(message)
    verification_result(rules, messages)
