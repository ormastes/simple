"""JIT-engine timing baseline for engine2d SIMD kernels (plan unit B2).

`bin/simple run` executes this file on the Cranelift JIT engine. Setting
`SIMPLE_EXECUTION_MODE=interpreter` before invoking `bin/simple run` on the
SAME file runs it on the tree-walk interpreter instead, so one probe produces
both engines' numbers with nothing else different.

Kept deliberately lambda-free (the JIT refuses any module containing a
lambda) and free of `std.cli` / `get_cli_args` / `.insert(` — any of those
silently demotes JIT execution to the interpreter for the WHOLE program, per
`.claude/rules/testing.md`. Engine label is read via
`std.nogc_sync_mut.io_runtime.env_get`, not `std.cli`.

Prints one machine-parseable line per (kernel, bucket):
`TIMING kernel=<k> bucket=<b> engine=<e> scalar_ns=<n> simd_ns=<n>`
"""

use common.gpu.engine2d.scalar_oracle.{
    oracle_fill_const,
    oracle_src_over_const,
    oracle_copy_span,
    oracle_hash_span,
}
use std.nogc_sync_mut.gpu.engine2d.simd_isa_provider.{
    simd_isa_fill_const,
    simd_isa_blend_const_span,
}
use std.nogc_sync_mut.gpu.engine2d.simd_native_rows.{
    rt_engine2d_simd_copy_span_u32,
}
use std.nogc_sync_mut.io_runtime.{time_now_unix_micros, env_get}

fn lcg_next(s: i64) -> i64:
    ((s * 6364136223846793005 + 1442695040888963407) >> 16) & 0x7FFFFFFF

fn filled_random(n: i64, seed: i64) -> [u32]:
    var out: [u32] = [0; n.to_i32()]
    var s: i64 = seed
    var i: i64 = 0
    while i < n:
        s = lcg_next(s)
        out[i.to_i32()] = (s & 0xFFFFFFFF) as u32
        i = i + 1
    out

fn simd_copy_span_inplace(mut dst: [u32], dst_offset: i64, src: [u32], src_offset: i64, count: i64):
    """In-place wrapper over the native (dst,src)->[u32] copy kernel, mirroring
    oracle_copy_span's in-place contract so timing compares like for like."""
    if count <= 0:
        return
    val copied = rt_engine2d_simd_copy_span_u32(dst, dst_offset, src, src_offset, count)
    if copied.len() != dst.len():
        return
    var i: i64 = 0
    while i < count:
        dst[(dst_offset + i).to_i32()] = copied[(dst_offset + i).to_i32()]
        i = i + 1

fn engine_label() -> text:
    val m = env_get("SIMPLE_EXECUTION_MODE")
    if m == "":
        "jit"
    else:
        m

fn time_fill_const(n: i64, iters: i64) -> (i64, i64):
    var scalar_buf: [u32] = [0; n.to_i32()]
    var simd_buf: [u32] = [0; n.to_i32()]
    val t0 = time_now_unix_micros()
    var i0: i64 = 0
    while i0 < iters:
        oracle_fill_const(scalar_buf, 0, n, 0xFF102030)
        i0 = i0 + 1
    val t1 = time_now_unix_micros()
    var i1: i64 = 0
    while i1 < iters:
        simd_isa_fill_const(simd_buf, 0, n, 0xFF102030)
        i1 = i1 + 1
    val t2 = time_now_unix_micros()
    val bit_exact = oracle_hash_span(scalar_buf, 0, n) == oracle_hash_span(simd_buf, 0, n)
    if not bit_exact:
        print("BITEXACT_FAIL kernel=fill_const bucket=" + n.to_text())
    ((t1 - t0) * 1000, (t2 - t1) * 1000)

fn time_src_over(n: i64, iters: i64) -> (i64, i64):
    var scalar_buf = filled_random(n, 555)
    var simd_buf = filled_random(n, 555)
    val t0 = time_now_unix_micros()
    var i0: i64 = 0
    while i0 < iters:
        oracle_src_over_const(scalar_buf, 0, n, 0x40203040)
        i0 = i0 + 1
    val t1 = time_now_unix_micros()
    var i1: i64 = 0
    while i1 < iters:
        simd_isa_blend_const_span(simd_buf, 0, n, 0x40203040)
        i1 = i1 + 1
    val t2 = time_now_unix_micros()
    val bit_exact = oracle_hash_span(scalar_buf, 0, n) == oracle_hash_span(simd_buf, 0, n)
    if not bit_exact:
        print("BITEXACT_FAIL kernel=src_over bucket=" + n.to_text())
    ((t1 - t0) * 1000, (t2 - t1) * 1000)

fn time_copy_span(n: i64, iters: i64) -> (i64, i64):
    val src = filled_random(n, 777)
    var scalar_buf: [u32] = [0; n.to_i32()]
    var simd_buf: [u32] = [0; n.to_i32()]
    val t0 = time_now_unix_micros()
    var i0: i64 = 0
    while i0 < iters:
        oracle_copy_span(scalar_buf, 0, src, 0, n)
        i0 = i0 + 1
    val t1 = time_now_unix_micros()
    var i1: i64 = 0
    while i1 < iters:
        simd_copy_span_inplace(simd_buf, 0, src, 0, n)
        i1 = i1 + 1
    val t2 = time_now_unix_micros()
    val bit_exact = oracle_hash_span(scalar_buf, 0, n) == oracle_hash_span(simd_buf, 0, n)
    if not bit_exact:
        print("BITEXACT_FAIL kernel=copy_span bucket=" + n.to_text())
    ((t1 - t0) * 1000, (t2 - t1) * 1000)

fn run_bucket(n: i64, engine: text):
    val iters: i64 = 50
    val fc = time_fill_const(n, iters)
    print("TIMING kernel=fill_const bucket=" + n.to_text() + " engine=" + engine + " scalar_ns=" + fc.0.to_text() + " simd_ns=" + fc.1.to_text())
    val so = time_src_over(n, iters)
    print("TIMING kernel=src_over bucket=" + n.to_text() + " engine=" + engine + " scalar_ns=" + so.0.to_text() + " simd_ns=" + so.1.to_text())
    val cs = time_copy_span(n, iters)
    print("TIMING kernel=copy_span bucket=" + n.to_text() + " engine=" + engine + " scalar_ns=" + cs.0.to_text() + " simd_ns=" + cs.1.to_text())

fn main():
    val engine = engine_label()
    val buckets: [i64] = [64, 256, 1024, 4096, 16384]
    var i: i64 = 0
    while i < buckets.len():
        run_bucket(buckets[i], engine)
        i = i + 1
