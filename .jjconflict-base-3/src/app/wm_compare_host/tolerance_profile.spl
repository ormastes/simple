# Host adapter: pixel-comparison tolerance profiles for wm_compare.
#
# Lives outside wm_lane_scope_dirs() (see
# src/compiler/90.tools/lint/_LintMain/wm_lane_boundary_lints.spl:51) so the
# os.compositor.tolerance_profile import below is legal here. Every symbol
# here is a pure value type / free-function profile constructor (no I/O, no
# mutable state), so a facade re-export is the correct boundary, same as
# wave 1's stateless facades.
# See doc/03_plan/ui/wm_lane_boundary_ratchet_lanes.md (tranche W2, wave 2).

export use os.compositor.tolerance_profile.{
    ToleranceProfile, profile_strict, profile_text_tolerant, profile_wm_default
}
