# Host adapter: WM scene spec types for wm_compare's scene registry and
# capture pipelines.
#
# Lives outside wm_lane_scope_dirs() (see
# src/compiler/90.tools/lint/_LintMain/wm_lane_boundary_lints.spl:51) so the
# os.compositor.wm_scene import below is legal here. WmSceneSpec and
# SceneElement are plain value types wm_compare builds programmatically and
# hands to the capture backends -- no host state of their own -- so a facade
# re-export is the correct boundary, same as wave 1's stateless facades.
# See doc/03_plan/ui/wm_lane_boundary_ratchet_lanes.md (tranche W2, wave 2).

export use os.compositor.wm_scene.{WmSceneSpec, SceneElement}
