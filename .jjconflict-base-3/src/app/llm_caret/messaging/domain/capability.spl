"""Truthful four-level transport capability model."""

enum CapabilityLevel:
    Native
    Emulated
    PrimitiveSidecar
    Unsupported

struct TransportCapabilities:
    version: i64
    account_provision: CapabilityLevel
    room_create: CapabilityLevel
    room_membership: CapabilityLevel
    history_read: CapabilityLevel
    thread: CapabilityLevel
    reply: CapabilityLevel
    private_message: CapabilityLevel
    native_mention: CapabilityLevel
    notify_all: CapabilityLevel
    mark_read: CapabilityLevel
    human_read_receipt: CapabilityLevel
    edit: CapabilityLevel
    delete: CapabilityLevel
    attachments: CapabilityLevel
    webhook_events: CapabilityLevel
    history_backfill: CapabilityLevel

pub fn capability_level_name(level: CapabilityLevel) -> text:
    match level:
        case CapabilityLevel.Native: "native"
        case CapabilityLevel.Emulated: "emulated"
        case CapabilityLevel.PrimitiveSidecar: "primitive_sidecar"
        case CapabilityLevel.Unsupported: "unsupported"

export CapabilityLevel, TransportCapabilities, capability_level_name
