# Shell exec dispatch — resolve + launch a binary via the shared fs-exec path.
#
# shell_exec resolves the command name through PATH, then dispatches it via
# the architecture-neutral filesystem-exec spawn pipeline.
#
# MDSOC: feature dimension, shell layer

use os.apps.shell.path_search.{shell_path_search}
use os.kernel.loader.fs_exec_spawn.{fs_exec_spawn_ring3_with_recipe}
use os.kernel.loader.spawn_recipes.{SPAWN_RECIPE_SHELL}

extern fn serial_println(msg: text)

# ---------------------------------------------------------------------------
# Public API
# ---------------------------------------------------------------------------

pub fn shell_exec(cmd: text, argv: [text], envp: [text]) -> i64:
    """Resolve cmd via PATH and dispatch via the shared fs-exec bridge.

    Kernel-origin form (`caller == 0`). Prefer `shell_exec_as` from any real
    shell task so the spawn is attributed to — and bounded by — that task.

    Returns the PID (>0) on success, or a negative error code:
      -1  command not found in PATH
      -2  spawn image-resolve failed (file missing / too small)
      -8  spawn image-build failed
      -12 scheduler task creation failed
      -16 user-mode handoff failed
    """
    shell_exec_as(0, cmd, argv, envp)

pub fn shell_exec_as(caller: i64, cmd: text, argv: [text], envp: [text]) -> i64:
    """Resolve cmd via PATH and dispatch under the SHELL spawn recipe.

    Master plan §5.4: the shell is a migrated caller. It no longer takes ambient
    `spawn_full()` authority — it presents `SPAWN_RECIPE_SHELL`, whose grants are
    exactly FileExec + FileRead under `/bin/` plus ProcessSpawn, and the child is
    minted as an attenuated pouch bounded by the shell's own tokens. Arming the
    boot seal therefore changes nothing here.

    Same error codes as `shell_exec`, plus -1 (SPAWN_AUTHORITY_EPERM) if the
    recipe gate ever refuses.
    """
    serial_println("[shell-exec] exec:cmd={cmd}")
    serial_println("[shell-exec] exec:argc={argv.len()}")
    serial_println("[shell-exec] exec:envc={envp.len()}")

    val resolved = shell_path_search(cmd)
    if resolved == nil:
        serial_println("[shell-exec] exec:not-found cmd={cmd}")
        return -1

    val resolved_path = resolved.unwrap()
    serial_println("[shell-exec] exec:resolved={resolved_path}")

    serial_println("[shell-exec] exec:dispatch=ring3-recipe caller={caller} path={resolved_path}")
    val pid = fs_exec_spawn_ring3_with_recipe(caller, SPAWN_RECIPE_SHELL, resolved_path, argv, envp)
    serial_println("[shell-exec] exec:result={pid}")
    pid
