# Pure-Simple DMA ownership for VirtIO-snd split rings and PCM buffers.
# One contiguous allocation keeps slot pressure bounded and permits distinct
# CPU-virtual and device-physical addresses on non-identity mappings.

use os.drivers.virtio.virtio_snd_mmio.{VirtioSndQueueMemory}
use os.kernel.boot.mmio.{mmio_read32, mmio_write32}

extern fn rt_dma_alloc(size: i64, dir_raw: i32) -> i64
extern fn rt_dma_free(handle: i64)
extern fn rt_dma_virt_of(handle: i64) -> i64
extern fn rt_dma_phys_of(handle: i64) -> i64
extern fn rt_dma_sync_for_device(handle: i64, dir_raw: i32)
extern fn rt_dma_sync_for_cpu(handle: i64, dir_raw: i32)

val VIRTIO_SND_DMA_BYTES: i64 = 24576
val VIRTIO_SND_QUEUE_BYTES: i64 = 512
val VIRTIO_SND_QUEUE_SIZE: u16 = 8u16
val VIRTIO_SND_CONTROL_REQUEST_OFFSET: i64 = 2048
val VIRTIO_SND_CONTROL_RESPONSE_OFFSET: i64 = 2304
val VIRTIO_SND_EVENT_BUFFER_OFFSET: i64 = 2560
val VIRTIO_SND_XFER_OFFSET: i64 = 2816
val VIRTIO_SND_STATUS_OFFSET: i64 = 2880
val VIRTIO_SND_PCM_OFFSET: i64 = 4096
val VIRTIO_SND_PCM_BYTES: i64 = 16384
val VIRTIO_SND_TX_PCM_OFFSET: i64 = 4096
val VIRTIO_SND_RX_PCM_OFFSET: i64 = 12288
val VIRTIO_SND_PERIOD_BYTES_MAX: i64 = 8192
val VIRTIO_SND_DMA_BIDIRECTIONAL: i32 = 2

struct VirtioSndDmaResources:
    handle: i64
    cpu_base: u64
    device_base: u64

fn virtio_snd_dma_resources_valid(resources: VirtioSndDmaResources) -> bool:
    resources.handle >= 0 and resources.cpu_base != 0 and resources.device_base != 0 and
        (resources.cpu_base & 127u64) == 0u64 and (resources.device_base & 127u64) == 0u64

fn virtio_snd_dma_create() -> VirtioSndDmaResources:
    val handle = rt_dma_alloc(VIRTIO_SND_DMA_BYTES, VIRTIO_SND_DMA_BIDIRECTIONAL)
    if handle < 0:
        return VirtioSndDmaResources(handle: -1, cpu_base: 0u64, device_base: 0u64)
    val cpu = rt_dma_virt_of(handle)
    val device = rt_dma_phys_of(handle)
    val resources = VirtioSndDmaResources(handle: handle, cpu_base: cpu.to_u64(), device_base: device.to_u64())
    if not virtio_snd_dma_resources_valid(resources):
        rt_dma_free(handle)
        return VirtioSndDmaResources(handle: -2, cpu_base: cpu.to_u64(), device_base: device.to_u64())
    var offset: i64 = 0
    while offset < VIRTIO_SND_DMA_BYTES:
        mmio_write32(cpu.to_u64() + offset.to_u64(), 0u32)
        offset = offset + 4
    rt_dma_sync_for_device(handle, VIRTIO_SND_DMA_BIDIRECTIONAL)
    resources

fn virtio_snd_dma_destroy(resources: VirtioSndDmaResources):
    if resources.handle >= 0:
        rt_dma_free(resources.handle)

fn virtio_snd_dma_queue(resources: VirtioSndDmaResources, index: u32) -> VirtioSndQueueMemory:
    if not virtio_snd_dma_resources_valid(resources) or index >= 4u32:
        return VirtioSndQueueMemory(desc_cpu: 0u64, avail_cpu: 0u64, used_cpu: 0u64, desc: 0u64, avail: 0u64, used: 0u64, size: 0u16)
    val queue_offset = index.to_u64() * VIRTIO_SND_QUEUE_BYTES.to_u64()
    val desc_offset = queue_offset
    val avail_offset = queue_offset + 128u64
    val used_offset = queue_offset + 192u64
    VirtioSndQueueMemory(
        desc_cpu: resources.cpu_base + desc_offset,
        avail_cpu: resources.cpu_base + avail_offset,
        used_cpu: resources.cpu_base + used_offset,
        desc: resources.device_base + desc_offset,
        avail: resources.device_base + avail_offset,
        used: resources.device_base + used_offset,
        size: VIRTIO_SND_QUEUE_SIZE
    )

fn virtio_snd_dma_cpu_address(resources: VirtioSndDmaResources, offset: i64) -> u64:
    if not virtio_snd_dma_resources_valid(resources) or offset < 0 or offset >= VIRTIO_SND_DMA_BYTES:
        return 0u64
    resources.cpu_base + offset.to_u64()

fn virtio_snd_dma_device_address(resources: VirtioSndDmaResources, offset: i64) -> u64:
    if not virtio_snd_dma_resources_valid(resources) or offset < 0 or offset >= VIRTIO_SND_DMA_BYTES:
        return 0u64
    resources.device_base + offset.to_u64()

fn virtio_snd_dma_sync_for_device(resources: VirtioSndDmaResources):
    if resources.handle >= 0:
        rt_dma_sync_for_device(resources.handle, VIRTIO_SND_DMA_BIDIRECTIONAL)

fn virtio_snd_dma_sync_for_cpu(resources: VirtioSndDmaResources):
    if resources.handle >= 0:
        rt_dma_sync_for_cpu(resources.handle, VIRTIO_SND_DMA_BIDIRECTIONAL)

fn virtio_snd_dma_range_valid(offset: i64, length: i64) -> bool:
    offset >= 0 and length >= 0 and offset <= VIRTIO_SND_DMA_BYTES and
        length <= VIRTIO_SND_DMA_BYTES - offset

fn virtio_snd_dma_write_bytes(resources: VirtioSndDmaResources, offset: i64, bytes: [u8]) -> bool:
    if not virtio_snd_dma_resources_valid(resources) or not virtio_snd_dma_range_valid(offset, bytes.len()):
        return false
    var index: i64 = 0
    while index < bytes.len():
        var word: u32 = 0u32
        var lane: i64 = 0
        while lane < 4 and index + lane < bytes.len():
            word = word | (bytes[index + lane].to_u32() << (lane * 8).to_u32())
            lane = lane + 1
        mmio_write32(resources.cpu_base + (offset + index).to_u64(), word)
        index = index + 4
    true

fn virtio_snd_dma_zero_range(resources: VirtioSndDmaResources, offset: i64, length: i64) -> bool:
    if not virtio_snd_dma_resources_valid(resources) or not virtio_snd_dma_range_valid(offset, length):
        return false
    var index: i64 = 0
    while index < length:
        mmio_write32(resources.cpu_base + (offset + index).to_u64(), 0u32)
        index = index + 4
    true

fn virtio_snd_dma_write_pcm_i16(resources: VirtioSndDmaResources, offset: i64, samples: [i64]) -> bool:
    val byte_count = samples.len() * 2
    if not virtio_snd_dma_resources_valid(resources) or not virtio_snd_dma_range_valid(offset, byte_count):
        return false
    var index: i64 = 0
    while index < samples.len():
        var word: u32 = 0u32
        var lane: i64 = 0
        while lane < 2 and index + lane < samples.len():
            val sample = samples[index + lane]
            if sample < -32768 or sample > 32767:
                return false
            word = word | ((sample & 65535).to_u32() << (lane * 16).to_u32())
            lane = lane + 1
        mmio_write32(resources.cpu_base + (offset + index * 2).to_u64(), word)
        index = index + 2
    true

fn virtio_snd_dma_read_u32(resources: VirtioSndDmaResources, offset: i64) -> u32:
    if not virtio_snd_dma_resources_valid(resources) or not virtio_snd_dma_range_valid(offset, 4):
        return 0u32
    mmio_read32(resources.cpu_base + offset.to_u64())

fn virtio_snd_dma_write_u32(resources: VirtioSndDmaResources, offset: i64, value: u32) -> bool:
    if not virtio_snd_dma_resources_valid(resources) or not virtio_snd_dma_range_valid(offset, 4):
        return false
    mmio_write32(resources.cpu_base + offset.to_u64(), value)
    true

fn virtio_snd_dma_read_pcm_i16(resources: VirtioSndDmaResources, offset: i64, sample_count: i64) -> [i64]:
    var samples: [i64] = []
    if not virtio_snd_dma_resources_valid(resources) or sample_count < 0 or
        not virtio_snd_dma_range_valid(offset, sample_count * 2):
        return samples
    var index: i64 = 0
    while index < sample_count:
        val word = mmio_read32(resources.cpu_base + (offset + (index / 2) * 4).to_u64())
        val raw = ((word >> ((index % 2) * 16).to_u32()) & 65535u32).to_i64()
        val sample = if raw >= 32768: raw - 65536 else: raw
        samples.push(sample)
        index = index + 1
    samples

fn virtio_snd_dma_read_pcm_sample_i16(resources: VirtioSndDmaResources, offset: i64, sample_index: i64, sample_count: i64) -> i64:
    if not virtio_snd_dma_resources_valid(resources) or sample_index < 0 or sample_index >= sample_count or
        not virtio_snd_dma_range_valid(offset, sample_count * 2):
        return 0
    val word = mmio_read32(resources.cpu_base + (offset + (sample_index / 2) * 4).to_u64())
    val raw = ((word >> ((sample_index % 2) * 16).to_u32()) & 65535u32).to_i64()
    if raw >= 32768: raw - 65536 else: raw

export VIRTIO_SND_DMA_BYTES, VIRTIO_SND_QUEUE_BYTES, VIRTIO_SND_QUEUE_SIZE
export VIRTIO_SND_CONTROL_REQUEST_OFFSET, VIRTIO_SND_CONTROL_RESPONSE_OFFSET
export VIRTIO_SND_EVENT_BUFFER_OFFSET, VIRTIO_SND_XFER_OFFSET, VIRTIO_SND_STATUS_OFFSET
export VIRTIO_SND_PCM_OFFSET, VIRTIO_SND_PCM_BYTES
export VIRTIO_SND_TX_PCM_OFFSET, VIRTIO_SND_RX_PCM_OFFSET, VIRTIO_SND_PERIOD_BYTES_MAX
export VirtioSndDmaResources, virtio_snd_dma_resources_valid
export virtio_snd_dma_create, virtio_snd_dma_destroy, virtio_snd_dma_queue
export virtio_snd_dma_cpu_address, virtio_snd_dma_device_address
export virtio_snd_dma_sync_for_device, virtio_snd_dma_sync_for_cpu
export virtio_snd_dma_range_valid, virtio_snd_dma_write_bytes, virtio_snd_dma_write_pcm_i16
export virtio_snd_dma_zero_range
export virtio_snd_dma_read_u32
export virtio_snd_dma_write_u32
export virtio_snd_dma_read_pcm_i16
export virtio_snd_dma_read_pcm_sample_i16
