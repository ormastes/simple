"""
# CORS Checker

CorsChecker implements same-origin policy enforcement and preflight logic
per the Fetch specification. No network calls — pure logic.

## Ownership

This module makes NO origin decisions of its own. Every same-origin test and
every "may the requester read this body?" test is delegated to
`security/origin_policy.spl` — `same_origin` and `can_read_response`. The old
serialized-origin string comparisons (`cors_url_origin`, raw requester text
against `allowed_origin`) are gone; they treated a malformed origin as
same-origin with another malformed origin and accepted a literal
`Access-Control-Allow-Origin: null`.
"""

#![allow(REQC001)]

use std.gc_async_mut.gpu.browser_engine.net.entity.cors_types.{PreflightResult}
use std.gc_async_mut.gpu.browser_engine.net.entity.request_types.{FetchRequest, RequestMode}
use std.gc_async_mut.gpu.browser_engine.net.entity.url_types.{Url, Origin}
use std.common.encoding.utf8.{text_byte_len}
use std.gc_async_mut.gpu.browser_engine.security.origin_policy.{
    same_origin,
    can_read_response,
    origin_from_url_text,
    opaque_origin,
    serialize_origin
}

pub fn cors_origin_of_url(url: Url) -> Origin:
    """Security origin of a request target, derived by `origin_policy`.

    Built from the (scheme, host, port) triple as a URL string rather than
    field-copied, so that a target with no usable authority collapses to a
    fresh opaque origin instead of a half-populated tuple. Never reads
    `Url.opaque`, which is nil-filled at struct literals that omit it.
    """
    val nonce = "cors-target:" + url.scheme + "|" + url.host
    if url.port <= 0:
        return origin_from_url_text(url.scheme + "://" + url.host, nonce)
    return origin_from_url_text(url.scheme + "://" + url.host + ":" + url.port.to_text(), nonce)

pub fn is_simple_method(method: text) -> bool:
    """Return true if method is a CORS simple method (GET, POST, HEAD)."""
    val upper = method.to_upper()
    return (upper == "GET" or upper == "POST" or upper == "HEAD")

fn cors_header_value_has_unsafe_byte(value: text) -> bool:
    for index in 0..value.len():
        val code = value.char_code_at(index)
        if (code < 32 and code != 9) or code == 127:
            return true
        if (code == 34 or code == 40 or code == 41 or code == 58 or
            code == 60 or code == 62 or code == 63 or code == 64 or
            code == 91 or code == 92 or code == 93 or code == 123 or
            code == 125):
            return true
    false

fn cors_language_value_is_safelisted(value: text) -> bool:
    for index in 0..value.len():
        val code = value.char_code_at(index)
        val ascii_digit = code >= 48 and code <= 57
        val ascii_upper = code >= 65 and code <= 90
        val ascii_lower = code >= 97 and code <= 122
        val punctuation = (code == 32 or code == 42 or code == 44 or
            code == 45 or code == 46 or code == 59 or code == 61)
        if not (ascii_digit or ascii_upper or ascii_lower or punctuation):
            return false
    true

fn cors_range_value_is_safelisted(value: text) -> bool:
    val trimmed = value.trim()
    if not trimmed.starts_with("bytes=") or trimmed.contains(","):
        return false
    val range = trimmed.slice(6, trimmed.len())
    val dash = range.index_of("-")
    if dash <= 0:
        return false
    if range.slice(dash + 1, range.len()).contains("-"):
        return false
    for index in 0..dash:
        val code = range.char_code_at(index)
        if code < 48 or code > 57:
            return false
    for index in (dash + 1)..range.len():
        val code = range.char_code_at(index)
        if code < 48 or code > 57:
            return false
    val end_text = range.slice(dash + 1, range.len())
    if end_text != "":
        val start_value = range.slice(0, dash).to_i64()
        val end_value = end_text.to_i64()
        if not start_value.? or not end_value.?:
            return false
        if end_value.unwrap() < start_value.unwrap():
            return false
    true

fn cors_header_is_safelisted(name: text, value: text) -> bool:
    if text_byte_len(value) > 128:
        return false
    match name:
        "accept":
            return not cors_header_value_has_unsafe_byte(value)
        "accept-language":
            return cors_language_value_is_safelisted(value)
        "content-language":
            return cors_language_value_is_safelisted(value)
        "content-type":
            if cors_header_value_has_unsafe_byte(value):
                return false
            val mime = value.split(";")[0].trim().to_lower()
            return (mime == "application/x-www-form-urlencoded" or
                mime == "multipart/form-data" or mime == "text/plain")
        "range":
            return cors_range_value_is_safelisted(value)
        _:
            return false

fn cors_add_unique_name(names: [text], name: text):
    for existing in names:
        if existing == name:
            return
    names.push(name)

fn cors_header_name_index(names: [text], expected: text) -> i64:
    var index: i64 = 0
    while index < names.len():
        if names[index] == expected:
            return index
        index = index + 1
    -1

pub fn cors_unsafe_request_header_names(headers: text) -> text:
    """Return sorted, lowercase author-header names requiring preflight."""
    var header_names: [text] = []
    var header_values: [text] = []
    for raw_line in headers.split("\n"):
        val line = raw_line.trim()
        val colon = line.index_of(":")
        if colon > 0:
            val name = line.slice(0, colon).trim().to_lower()
            val value = line.slice(colon + 1, line.len()).trim()
            # Origin is browser-owned and is never an author request header.
            if name != "origin":
                val existing = cors_header_name_index(header_names, name)
                if existing >= 0:
                    header_values[existing] = (
                        header_values[existing] + ", " + value
                    )
                else:
                    header_names.push(name)
                    header_values.push(value)

    var unsafe_names: [text] = []
    var potentially_unsafe_names: [text] = []
    var safelist_value_size: i64 = 0
    var index: i64 = 0
    while index < header_names.len():
        val name = header_names[index]
        val value = header_values[index]
        if cors_header_is_safelisted(name, value):
            safelist_value_size = (
                safelist_value_size + text_byte_len(value)
            )
            cors_add_unique_name(potentially_unsafe_names, name)
        else:
            cors_add_unique_name(unsafe_names, name)
        index = index + 1
    if safelist_value_size > 1024:
        for name in potentially_unsafe_names:
            cors_add_unique_name(unsafe_names, name)
    unsafe_names.sort()
    unsafe_names.join(", ")

pub fn needs_preflight(req: FetchRequest, requester_origin: Origin) -> bool:
    """Return true if the request requires a CORS preflight OPTIONS exchange.

    Preflight is required when:
    - The origin differs from the request target, AND
    - The method is non-simple, OR any author request header is not CORS-safelisted.

    The same-origin test is `origin_policy.same_origin`, so a malformed or
    opaque requester is never same-origin with anything and always preflights.
    """
    if same_origin(requester_origin, cors_origin_of_url(req.url)):
        return false

    if not is_simple_method(req.method):
        return true
    cors_unsafe_request_header_names(req.headers) != ""

pub fn create_preflight(original: FetchRequest) -> FetchRequest:
    """Build an OPTIONS preflight request for the original request."""
    var preflight_headers = (
        "Access-Control-Request-Method: " + original.method.to_upper() + "\r\n"
    )
    val unsafe_names = cors_unsafe_request_header_names(original.headers)
    if unsafe_names != "":
        preflight_headers = preflight_headers + (
            "Access-Control-Request-Headers: " + unsafe_names + "\r\n"
        )
    return FetchRequest {
        method: "OPTIONS",
        url: original.url,
        headers: preflight_headers,
        body: [],
        mode: RequestMode.Cors,
        credentials: original.credentials
    }

pub class CorsChecker:
    """Validates CORS preflight responses for a given requester origin.

    `_requester` is the parsed origin used for every decision and emitted
    browser-owned `Origin` header.
    """
    _requester: Origin

    static fn new(origin: text) -> CorsChecker:
        """Create a CorsChecker for the given origin string.

        The string is parsed by `origin_policy.origin_from_url_text`, so an
        empty or malformed origin becomes opaque and is refused everywhere.
        """
        return CorsChecker {
            _requester: origin_from_url_text(origin, "cors-checker:" + origin)
        }

    me set_origin(origin: text):
        self._requester = origin_from_url_text(origin, "cors-checker:" + origin)

    me fn requester_origin() -> Origin:
        return self._requester

    me fn is_same_origin(url: Url) -> bool:
        return same_origin(self._requester, cors_origin_of_url(url))

    me fn prepare_actual_request(request: FetchRequest) -> FetchRequest:
        """Replace caller-controlled Origin on the actual CORS request.

        The requester origin is browser state. Script and redirect-carried
        headers cannot override it. Non-CORS requests are unchanged.
        """
        match request.mode:
            RequestMode.Cors:
                pass_do_nothing
            _:
                return request

        var headers = ""
        for raw_line in request.headers.split("\n"):
            val line = raw_line.trim()
            val colon = line.index_of(":")
            if line != "":
                val name = if colon > 0:
                    line.slice(0, colon).trim().to_lower()
                else:
                    ""
                if name != "origin":
                    headers = headers + line + "\r\n"
        if not self.is_same_origin(request.url):
            headers = (
                headers + "Origin: " + serialize_origin(self._requester) +
                "\r\n"
            )
        FetchRequest(
            url: request.url,
            method: request.method,
            headers: headers,
            body: request.body,
            mode: request.mode,
            credentials: request.credentials
        )

    me fn can_read_body(response_url: Url, response_headers: text, credentials: text) -> bool:
        """May this requester read the body served from `response_url`?

        The single enforcement point for a cross-origin response read.
        """
        val allowed = cors_header_value(response_headers, "access-control-allow-origin")
        if (cors_credentials_include(credentials) and
            cors_header_value(
                response_headers, "access-control-allow-credentials"
            ).to_lower() != "true"):
            return false
        return can_read_response(
            self._requester,
            cors_origin_of_url(response_url),
            allowed,
            cors_credentials_include(credentials)
        )

    me fn needs_preflight(request: FetchRequest) -> bool:
        needs_preflight(request, self._requester)

    me fn create_preflight(request: FetchRequest) -> FetchRequest:
        var preflight = create_preflight(request)
        preflight.headers = (
            "Origin: " + serialize_origin(self._requester) + "\r\n" +
            preflight.headers
        )
        preflight

    me fn validate_response(response_headers: text, credentials: text) -> PreflightResult:
        """Does the CORS grant in `response_headers` admit this requester?

        Delegated to `origin_policy.can_read_response` against a deliberately
        opaque response origin, so the same-origin shortcut can never fire and
        the answer is purely "is there a valid explicit grant?".
        """
        val allowed_origin = cors_header_value(response_headers, "access-control-allow-origin")
        if (cors_credentials_include(credentials) and
            cors_header_value(
                response_headers, "access-control-allow-credentials"
            ).to_lower() != "true"):
            return PreflightResult.Denied
        val cross = opaque_origin("cors-preflight-response")
        if can_read_response(
            self._requester,
            cross,
            allowed_origin,
            cors_credentials_include(credentials)
        ):
            return PreflightResult.Allowed
        PreflightResult.Denied

    me fn validate_preflight(response_headers: text) -> PreflightResult:
        """Check whether the server's preflight response permits the request.

        Returns Allowed if:
        - Access-Control-Allow-Origin matches this checker's origin (or is *), AND
        - Access-Control-Allow-Methods contains a non-simple method (PUT/DELETE/PATCH/etc.)
        Returns Denied otherwise.
        """
        if self.validate_response(response_headers, "omit") == PreflightResult.Denied:
            return PreflightResult.Denied

        val methods = cors_header_value(response_headers, "access-control-allow-methods")
        for method in ["PUT", "DELETE", "PATCH", "OPTIONS", "CONNECT", "TRACE"]:
            if cors_token_list_contains(methods, method):
                return PreflightResult.Allowed
        PreflightResult.Denied

    me fn validate_preflight_method(response_headers: text, requested_method: text) -> PreflightResult:
        self.validate_preflight_method_with_credentials(response_headers, requested_method, "omit")

    me fn validate_preflight_method_with_credentials(response_headers: text, requested_method: text, credentials: text) -> PreflightResult:
        if self.validate_response(response_headers, credentials) == PreflightResult.Denied:
            return PreflightResult.Denied
        if is_simple_method(requested_method):
            return PreflightResult.Allowed
        val methods = cors_header_value(response_headers, "access-control-allow-methods")
        if cors_token_list_contains(methods, requested_method):
            return PreflightResult.Allowed
        if (not cors_credentials_include(credentials) and
            cors_token_list_contains(methods, "*")):
            return PreflightResult.Allowed
        PreflightResult.Denied

    me fn validate_preflight_headers(response_headers: text, requested_headers: text) -> PreflightResult:
        self.validate_preflight_headers_with_credentials(
            response_headers, requested_headers, "omit"
        )

    me fn validate_preflight_headers_with_credentials(response_headers: text, requested_headers: text, credentials: text) -> PreflightResult:
        if self.validate_response(response_headers, credentials) == PreflightResult.Denied:
            return PreflightResult.Denied
        val allowed = cors_header_value(response_headers, "access-control-allow-headers")
        val wildcard = (not cors_credentials_include(credentials) and
            cors_token_list_contains(allowed, "*"))
        for requested in requested_headers.split(","):
            val name = requested.trim().to_lower()
            if name != "":
                val requires_explicit = name == "authorization" or not wildcard
                if (requires_explicit and
                    not cors_token_list_contains(allowed, name)):
                    return PreflightResult.Denied
        PreflightResult.Allowed

fn cors_header_value(headers: text, name: text) -> text:
    val expected = name.to_lower()
    var combined = ""
    var found = false
    for raw_line in headers.split("\n"):
        val line = raw_line.trim()
        val colon = line.index_of(":")
        if colon > 0:
            if line.slice(0, colon).trim().to_lower() == expected:
                val value = line.slice(colon + 1, line.len()).trim()
                if found:
                    combined = combined + ", " + value
                else:
                    combined = value
                    found = true
    combined

fn cors_token_list_contains(values: text, expected: text) -> bool:
    val target = expected.trim().to_upper()
    for value in values.split(","):
        if value.trim().to_upper() == target:
            return true
    false

fn cors_credentials_include(credentials: text) -> bool:
    val value = credentials.to_lower()
    if value == "include":
        return true
    value.ends_with("::include")

pub fn cors_url_origin_text(url: Url) -> text:
    """Serialized origin of a URL. Delegates to `origin_policy.serialize_origin`.

    Replaces the module's own default-port-elision copy, which disagreed with
    the policy layer on every non-hierarchical scheme.
    """
    return serialize_origin(cors_origin_of_url(url))
