# Mutable emit sink facade for default-tier parser execution.
#
# Wave-1 keeps ParseActionSink immutable value semantics (from parse_types) and
# this module only re-exports compatible helpers for future mutable executor
# wiring.

use std.common.structural.parse.parse_types.{
    ParseActionSink,
    parse_action_sink_new,
    parse_sink_emit_diagnostic,
    parse_sink_emit_tag,
    parse_sink_emit_token,
    parse_token_arena_len,
    parse_diagnostic_arena_len
}

fn parse_action_sink_capacity_checked(
    sink: ParseActionSink,
    max_tokens: i64,
    max_diagnostics: i64
) -> bool:
    parse_token_arena_len(sink.tokens) <= max_tokens and parse_diagnostic_arena_len(sink.diagnostics) <= max_diagnostics

fn parse_action_sink_new_default(tag_demand: u32) -> ParseActionSink:
    parse_action_sink_new(tag_demand)

export ParseActionSink
export parse_action_sink_new_default, parse_action_sink_capacity_checked
export parse_action_sink_new, parse_sink_emit_diagnostic, parse_sink_emit_tag, parse_sink_emit_token
