# Compression utilities — byte helpers, checksums, SIMD tier detection, option builders,
# streaming encoder/decoder, and the public compress/decompress facade.

use std.common.compress.types.{CompressionCodec, CompressionError, CompressionSimdTier}
use std.common.compress.lz4.{CompressionOptions, CompressionLevel}
use std.common.compress.lz4.{lz4_compress_frame, lz4_decompress_frame, lz4_compress_block, lz4_decompress_block}
use std.common.compress.zstd.{zstd_compress_frame, zstd_decompress_frame}
use std.common.compress.gzip.{gzip_compress, gzip_decompress}
use std.common.compress.brotli.{brotli_compress, brotli_decompress}
use std.common.compress.deflate.{deflate_compress_sync_flush, deflate_decompress_eof}
use std.common.compress.lzma2.{lzma2_compress_xz, lzma2_decompress_xz}
use std.simd.{SimdTier, detect_profile, profile_name}

pub use std.common.compress.types.{CompressionSimdTier}

val CRC32_POLY_REV: u32 = 0xEDB88320u32

pub struct CompressionEncoderState:
    options: CompressionOptions
    pending: [u8]

pub struct CompressionDecoderState:
    codec_hint: CompressionCodec?
    pending: [u8]

pub struct MatchExtensionResult:
    length: i64
    next_pos: i64

pub struct LiteralCopyResult:
    out: [u8]
    next_pos: i64

# ── SIMD tier mapping ──────────────────────────────────────────────────────

pub fn compression_simd_tier_from_simd_profile(profile: SimdTier) -> CompressionSimdTier:
    match profile:
        case SimdTier.x86_64_avx2: CompressionSimdTier.avx2
        case SimdTier.aarch64_neon: CompressionSimdTier.neon
        case _: CompressionSimdTier.scalar

pub fn compression_simd_tier_detect() -> CompressionSimdTier:
    compression_simd_tier_from_simd_profile(detect_profile())

pub fn compression_simd_tier_name(tier: CompressionSimdTier) -> text:
    match tier:
        case CompressionSimdTier.scalar: "scalar"
        case CompressionSimdTier.avx2: "avx2"
        case CompressionSimdTier.neon: "neon"
        case CompressionSimdTier.sse2: "sse2"

pub fn compression_simd_runtime_profile_name() -> text:
    profile_name()

# ── Integer I/O helpers ────────────────────────────────────────────────────

pub fn write_u16_le(buf: [u8], value: u16) -> [u8]:
    var result = buf
    result.push((value & 0xFFu16).to_u8())
    result.push(((value >> 8) & 0xFFu16).to_u8())
    result

pub fn write_u16_be(buf: [u8], value: u16) -> [u8]:
    var result = buf
    result.push(((value >> 8) & 0xFFu16).to_u8())
    result.push((value & 0xFFu16).to_u8())
    result

pub fn write_u32_le(buf: [u8], value: u32) -> [u8]:
    var result = buf
    result.push((value & 0xFFu32).to_u8())
    result.push(((value >> 8) & 0xFFu32).to_u8())
    result.push(((value >> 16) & 0xFFu32).to_u8())
    result.push(((value >> 24) & 0xFFu32).to_u8())
    result

pub fn write_u64_le(buf: [u8], value: u64) -> [u8]:
    var result = buf
    var shift: u64 = 0u64
    while shift < 64u64:
        result.push(((value >> shift) & 0xFFu64).to_u8())
        shift = shift + 8u64
    result

pub fn read_u16_le(data: [u8], pos: i64) -> Result<u16, CompressionError>:
    if pos + 2 > data.len():
        return Err(CompressionError.TruncatedInput("need 2 bytes"))
    Ok(data[pos].to_u16() | (data[pos + 1].to_u16() << 8))

pub fn read_u32_le(data: [u8], pos: i64) -> Result<u32, CompressionError>:
    if pos + 4 > data.len():
        return Err(CompressionError.TruncatedInput("need 4 bytes"))
    Ok(data[pos].to_u32() |
        (data[pos + 1].to_u32() << 8) |
        (data[pos + 2].to_u32() << 16) |
        (data[pos + 3].to_u32() << 24))

pub fn read_u64_le(data: [u8], pos: i64) -> Result<u64, CompressionError>:
    if pos + 8 > data.len():
        return Err(CompressionError.TruncatedInput("need 8 bytes"))
    var value: u64 = 0u64
    var shift: u64 = 0u64
    var idx = pos
    while shift < 64u64:
        value = value | (data[idx].to_u64() << shift)
        idx = idx + 1
        shift = shift + 8u64
    Ok(value)

# ── Byte buffer helpers ────────────────────────────────────────────────────

pub fn push_many_byte(buf: [u8], byte: u8, count: i64) -> [u8]:
    var result = buf
    var i = 0
    while i < count:
        result.push(byte)
        i = i + 1
    result

pub fn append_bytes(buf: [u8], bytes: [u8]) -> [u8]:
    var result = buf
    var i = 0
    while i < bytes.len():
        result.push(bytes[i])
        i = i + 1
    result

pub fn append_bytes_range(buf: [u8], bytes: [u8], start: i64, end: i64) -> [u8]:
    var result = buf
    var i = start
    while i < end:
        result.push(bytes[i])
        i = i + 1
    result

pub fn append_self_overlap_copy(buf: [u8], offset: i64, count: i64) -> Result<[u8], CompressionError>:
    if offset <= 0 or offset > buf.len():
        return Err(CompressionError.CorruptStream("invalid overlap copy offset"))
    var result = buf
    var i = 0
    while i < count:
        val src = result.len() - offset
        result.push(result[src])
        i = i + 1
    Ok(result)

pub fn append_self_overlap_copy_scalar(buf: [u8], offset: i64, count: i64) -> Result<[u8], CompressionError>:
    append_self_overlap_copy(buf, offset, count)

pub fn append_self_overlap_copy_avx2(buf: [u8], offset: i64, count: i64) -> Result<[u8], CompressionError>:
    append_self_overlap_copy(buf, offset, count)

pub fn append_self_overlap_copy_neon(buf: [u8], offset: i64, count: i64) -> Result<[u8], CompressionError>:
    append_self_overlap_copy(buf, offset, count)

pub fn append_self_overlap_copy_for_tier(buf: [u8], offset: i64, count: i64, tier: CompressionSimdTier) -> Result<[u8], CompressionError>:
    append_self_overlap_copy(buf, offset, count)

pub fn append_literal_copy(out: [u8], src: [u8], src_pos: i64, length: i64, context: text) -> Result<LiteralCopyResult, CompressionError>:
    if src_pos + length > src.len():
        return Err(CompressionError.TruncatedInput(context + " truncated"))
    var result = out
    var i = src_pos
    while i < src_pos + length:
        result.push(src[i])
        i = i + 1
    Ok(LiteralCopyResult(out: result, next_pos: src_pos + length))

pub fn decode_match_extension_length(base: i64, data: [u8], pos: i64, context: text) -> Result<MatchExtensionResult, CompressionError>:
    var total = base
    var cur = pos
    while true:
        if cur >= data.len():
            return Err(CompressionError.TruncatedInput(context + " match extension truncated"))
        val b = data[cur].to_i64()
        cur = cur + 1
        total = total + b
        if b < 255:
            break
    Ok(MatchExtensionResult(length: total, next_pos: cur))

# ── CRC32 ──────────────────────────────────────────────────────────────────

fn _crc32_update_byte(crc: u32, byte: u8) -> u32:
    var next = crc ^ byte.to_u32()
    var bit = 0
    while bit < 8:
        if (next & 1u32) == 1u32:
            next = (next >> 1) ^ CRC32_POLY_REV
        else:
            next = next >> 1
        bit = bit + 1
    next

pub fn crc32_bytes(data: [u8]) -> u32:
    crc32_bytes_scalar(data)

pub fn crc32_bytes_scalar(data: [u8]) -> u32:
    var crc: u32 = 0xFFFFFFFFu32
    var idx = 0
    while idx < data.len():
        crc = _crc32_update_byte(crc, data[idx])
        idx = idx + 1
    crc ^ 0xFFFFFFFFu32

pub fn crc32_bytes_avx2(data: [u8]) -> u32:
    crc32_bytes_scalar(data)

pub fn crc32_bytes_neon(data: [u8]) -> u32:
    crc32_bytes_scalar(data)

pub fn crc32_bytes_for_tier(data: [u8], tier: CompressionSimdTier) -> u32:
    crc32_bytes_scalar(data)

# ── XXHash32 ───────────────────────────────────────────────────────────────
# Mirrors lz4.spl's algorithm exactly (private names prefixed _utl_ to avoid collision).

val _UTLXXH_P1: u32 = 2654435761u32
val _UTLXXH_P2: u32 = 2246822519u32
val _UTLXXH_P3: u32 = 3266489917u32
val _UTLXXH_P4: u32 = 668265263u32
val _UTLXXH_P5: u32 = 374761393u32

fn _utl_xxh32_rotl(v: u32, r: i64) -> u32:
    (v << r.to_u32()) | (v >> (32 - r).to_u32())

fn _utl_xxh32_round(acc: u32, v: u32) -> u32:
    val a = acc + (v * _UTLXXH_P2)
    _utl_xxh32_rotl(a, 13) * _UTLXXH_P1

fn _utl_xxh32_read_le32(data: [u8], off: i64) -> u32:
    data[off].to_u32() |
        (data[off + 1].to_u32() << 8u32) |
        (data[off + 2].to_u32() << 16u32) |
        (data[off + 3].to_u32() << 24u32)

pub fn xxhash32_bytes(data: [u8], seed: u32) -> u32:
    """Compute xxHash32 of `data` with given `seed`."""
    val n = data.len()
    var h: u32 = 0u32
    var pos = 0
    if n >= 16:
        var v1 = seed + _UTLXXH_P1 + _UTLXXH_P2
        var v2 = seed + _UTLXXH_P2
        var v3 = seed + 0u32
        var v4 = seed - _UTLXXH_P1
        val limit = n - 16
        while pos <= limit:
            v1 = _utl_xxh32_round(v1, _utl_xxh32_read_le32(data, pos))
            pos = pos + 4
            v2 = _utl_xxh32_round(v2, _utl_xxh32_read_le32(data, pos))
            pos = pos + 4
            v3 = _utl_xxh32_round(v3, _utl_xxh32_read_le32(data, pos))
            pos = pos + 4
            v4 = _utl_xxh32_round(v4, _utl_xxh32_read_le32(data, pos))
            pos = pos + 4
        h = (_utl_xxh32_rotl(v1, 1) + _utl_xxh32_rotl(v2, 7) +
             _utl_xxh32_rotl(v3, 12) + _utl_xxh32_rotl(v4, 18))
    else:
        h = seed + _UTLXXH_P5
    h = h + n.to_u32()
    while pos + 4 <= n:
        h = h + (_utl_xxh32_read_le32(data, pos) * _UTLXXH_P3)
        h = _utl_xxh32_rotl(h, 17) * _UTLXXH_P4
        pos = pos + 4
    while pos < n:
        h = h + (data[pos].to_u32() * _UTLXXH_P5)
        h = _utl_xxh32_rotl(h, 11) * _UTLXXH_P1
        pos = pos + 1
    h = (h ^ (h >> 15u32)) * _UTLXXH_P2
    h = (h ^ (h >> 13u32)) * _UTLXXH_P3
    h ^ (h >> 16u32)

pub fn xxhash32_bytes_scalar(data: [u8], seed: u32) -> u32:
    xxhash32_bytes(data, seed)

pub fn xxhash32_bytes_avx2(data: [u8], seed: u32) -> u32:
    xxhash32_bytes_scalar(data, seed)

pub fn xxhash32_bytes_neon(data: [u8], seed: u32) -> u32:
    xxhash32_bytes_scalar(data, seed)

pub fn xxhash32_bytes_for_tier(data: [u8], seed: u32, tier: CompressionSimdTier) -> u32:
    xxhash32_bytes_scalar(data, seed)

# ── Compression option builders ────────────────────────────────────────────

pub fn default_compression_options(codec: CompressionCodec) -> CompressionOptions:
    val level_val = match codec:
        case CompressionCodec.zstd: 3
        case CompressionCodec.lz4: 1
        case CompressionCodec.deflate: 6
        case CompressionCodec.gzip: 6
        case CompressionCodec.brotli: 4
        case CompressionCodec.lzma2: 6
        case CompressionCodec.identity: 0
    val checksum = codec == CompressionCodec.lzma2
    CompressionOptions(
        codec: codec,
        level: CompressionLevel(value: level_val),
        checksum: checksum,
        block_mode: "frame",
        dictionary_bytes: nil,
        dictionary_id: nil,
        content_size: nil
    )

pub fn compression_options(codec: CompressionCodec, level: i64) -> CompressionOptions:
    CompressionOptions(
        codec: codec,
        level: CompressionLevel(value: level),
        checksum: false,
        block_mode: "frame",
        dictionary_bytes: nil,
        dictionary_id: nil,
        content_size: nil
    )

pub fn codec_content_encoding(codec: CompressionCodec) -> text:
    match codec:
        case CompressionCodec.zstd: "zstd"
        case CompressionCodec.lz4: "lz4"
        case CompressionCodec.deflate: "deflate"
        case CompressionCodec.gzip: "gzip"
        case CompressionCodec.brotli: "br"
        case CompressionCodec.lzma2: "xz"
        case CompressionCodec.identity: "identity"

# ── Option validation ──────────────────────────────────────────────────────

pub fn _validate_options(opts: CompressionOptions) -> Result<[u8], CompressionError>:
    # Dictionary checks
    if opts.dictionary_id != nil:
        val did = opts.dictionary_id ?? 0
        if did < 0:
            return Err(CompressionError.UnsupportedFeature("dictionary_id must be >= 0"))
        if opts.dictionary_bytes == nil:
            return Err(CompressionError.UnsupportedFeature("dictionary_id requires dictionary_bytes"))
    if opts.dictionary_bytes != nil:
        return Err(CompressionError.UnsupportedFeature("dictionaries are not supported"))
    # Content size checks
    if opts.content_size != nil:
        val cs = opts.content_size ?? 0
        if cs < 0:
            return Err(CompressionError.UnsupportedFeature("content_size must be >= 0"))
    # Codec-specific checks
    val is_lz4 = opts.codec == CompressionCodec.lz4
    val is_lzma2 = opts.codec == CompressionCodec.lzma2
    if opts.block_mode == "block":
        if is_lz4:
            if opts.checksum:
                return Err(CompressionError.UnsupportedFeature("block mode does not support checksum"))
            if opts.content_size != nil:
                return Err(CompressionError.UnsupportedFeature("block mode does not support content_size"))
        else:
            return Err(CompressionError.UnsupportedFeature("block_mode must be frame for this codec"))
    if is_lz4:
        if opts.level.value != 1:
            return Err(CompressionError.UnsupportedFeature("levels other than 1 are not supported for lz4"))
    if is_lzma2:
        if not opts.checksum:
            return Err(CompressionError.UnsupportedFeature("checksum=true is required for lzma2/xz"))
    Ok([])

# ── Compression facade ─────────────────────────────────────────────────────

pub fn compress_bytes(data: [u8], opts: CompressionOptions) -> [u8]:
    match opts.codec:
        case CompressionCodec.zstd:
            zstd_compress_frame(data, opts)
        case CompressionCodec.lz4:
            if opts.block_mode == "block":
                lz4_compress_block(data)
            else:
                lz4_compress_frame(data, opts)
        case CompressionCodec.deflate:
            val res = deflate_compress_sync_flush(data)
            match res:
                case Ok(bytes): bytes
                case _: []
        case CompressionCodec.gzip:
            gzip_compress(data)
        case CompressionCodec.brotli:
            brotli_compress(data)
        case CompressionCodec.lzma2:
            lzma2_compress_xz(data, opts)
        case CompressionCodec.identity:
            data

pub fn try_compress_bytes(data: [u8], opts: CompressionOptions) -> Result<[u8], CompressionError>:
    val check = _validate_options(opts)
    if check.is_err():
        return check
    if opts.content_size != nil:
        val cs = opts.content_size ?? 0
        if cs != data.len():
            return Err(CompressionError.UnsupportedFeature("content_size mismatch: declared " + cs.to_text() + " but actual is " + data.len().to_text()))
    Ok(compress_bytes(data, opts))

fn _decompress_with_codec(data: [u8], codec: CompressionCodec) -> Result<[u8], CompressionError>:
    match codec:
        case CompressionCodec.zstd:
            zstd_decompress_frame(data)
        case CompressionCodec.lz4:
            if (data.len() >= 4 and data[0] == 0x04u8 and data[1] == 0x22u8 and
                    data[2] == 0x4Du8 and data[3] == 0x18u8):
                lz4_decompress_frame(data)
            else:
                lz4_decompress_block(data)
        case CompressionCodec.deflate:
            deflate_decompress_eof(data)
        case CompressionCodec.gzip:
            if data.len() == 0:
                return Err(CompressionError.TruncatedInput("gzip empty input"))
            val out = gzip_decompress(data)
            if out.len() == 0 and data.len() > 0:
                Err(CompressionError.CorruptData("gzip decompress failed"))
            else:
                Ok(out)
        case CompressionCodec.brotli:
            if data.len() == 0:
                return Err(CompressionError.TruncatedInput("brotli empty input"))
            val out = brotli_decompress(data)
            if out.len() == 0 and data.len() > 0:
                Err(CompressionError.CorruptData("brotli decompress failed"))
            else:
                Ok(out)
        case CompressionCodec.lzma2:
            lzma2_decompress_xz(data)
        case CompressionCodec.identity:
            Ok(data)

fn _detect_codec(data: [u8]) -> Option<CompressionCodec>:
    if data.len() >= 4:
        if data[0] == 0x28u8 and data[1] == 0xB5u8 and data[2] == 0x2Fu8 and data[3] == 0xFDu8:
            return Some(CompressionCodec.zstd)
        if data[0] == 0x04u8 and data[1] == 0x22u8 and data[2] == 0x4Du8 and data[3] == 0x18u8:
            return Some(CompressionCodec.lz4)
    if data.len() >= 2:
        if data[0] == 0x1Fu8 and data[1] == 0x8Bu8:
            return Some(CompressionCodec.gzip)
    if data.len() >= 6:
        if (data[0] == 0xFDu8 and data[1] == 0x37u8 and data[2] == 0x7Au8 and
                data[3] == 0x58u8 and data[4] == 0x5Au8 and data[5] == 0x00u8):
            return Some(CompressionCodec.lzma2)
    nil

pub fn decompress_bytes(data: [u8], codec_hint: Option<CompressionCodec>) -> Result<[u8], CompressionError>:
    if val Some(codec) = codec_hint:
        return _decompress_with_codec(data, codec)
    val detected = _detect_codec(data)
    if val Some(codec) = detected:
        return _decompress_with_codec(data, codec)
    Err(CompressionError.InvalidHeader("codec auto-detect failed"))

# ── Streaming encoder/decoder ──────────────────────────────────────────────

pub fn new_encoder_state(options: CompressionOptions) -> CompressionEncoderState:
    CompressionEncoderState(options: options, pending: [])

pub fn encoder_write(state: CompressionEncoderState, chunk: [u8]) -> CompressionEncoderState:
    var pending = state.pending
    var i = 0
    while i < chunk.len():
        pending.push(chunk[i])
        i = i + 1
    CompressionEncoderState(options: state.options, pending: pending)

pub fn encoder_finish(state: CompressionEncoderState) -> [u8]:
    compress_bytes(state.pending, state.options)

pub fn encoder_finish_checked(state: CompressionEncoderState) -> Result<[u8], CompressionError>:
    val check = _validate_options(state.options)
    if check.is_err():
        return check
    Ok(compress_bytes(state.pending, state.options))

pub fn new_decoder_state(codec_hint: CompressionCodec?) -> CompressionDecoderState:
    CompressionDecoderState(codec_hint: codec_hint, pending: [])

pub fn decoder_write(state: CompressionDecoderState, chunk: [u8]) -> CompressionDecoderState:
    var pending = state.pending
    var i = 0
    while i < chunk.len():
        pending.push(chunk[i])
        i = i + 1
    CompressionDecoderState(codec_hint: state.codec_hint, pending: pending)

pub fn decoder_finish(state: CompressionDecoderState) -> Result<[u8], CompressionError>:
    decompress_bytes(state.pending, state.codec_hint)
