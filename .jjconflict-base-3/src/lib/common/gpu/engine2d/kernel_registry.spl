# Per-operation CPU kernel registry + span-batch descriptor (lane P0).
#
# Replaces the "one global SIMD level" model. Today's SimdLevel is a single
# cached global whose own comments concede that only `auto`/`off` change
# behaviour and that `Avx512` reports "avx2" as its feature text — so one
# switch decides fills, blends and copies alike, at every size. The measured
# consequence is in the retained 8K benchmark: CPU-SIMD is SLOWER than scalar
# (1282.2 ms vs 909.5 ms). A win at 4096-pixel blends does not imply a win at
# 8-pixel fills, and a single global cannot express that.
#
# So selection is keyed per operation x format x alpha x alignment x
# contiguity x size bucket. A provider is registered into a slot only when it
# is BOTH bit-exact against the scalar oracle and measurably faster in that
# slot; otherwise the slot keeps scalar. Registration happens ONCE per session
# — a frame never re-probes CPU features.
#
# Plain integer keys throughout, never enums: this tree has open enum-match
# defects on both engines (a `match` on an enum from `!` fires no arm under the
# JIT; a `match` on an `E?` fires no arm under the interpreter). Integers
# behave identically everywhere.
#
# The table is passed as a FUNCTION PARAMETER, never held as a field of another
# class. Under the interpreter a class stored in another class's field is a
# VALUE COPY (see doc/08_tracking/bug/class_field_reference_semantics_diverge_2026-08-06.md);
# fn parameters are the one form that aliases on both engines.

use common.gpu.engine2d.scalar_oracle.{
    oracle_fill_const,
    oracle_copy_span,
    oracle_src_over_const,
    oracle_src_over_image,
    oracle_mask_src_over,
}

# --- key axes ---------------------------------------------------------------

val KERNEL_OP_FILL_CONST: i64 = 0
val KERNEL_OP_COPY_SPAN: i64 = 1
val KERNEL_OP_SRC_OVER_CONST: i64 = 2
val KERNEL_OP_SRC_OVER_IMAGE: i64 = 3
val KERNEL_OP_MASK_SRC_OVER: i64 = 4
val KERNEL_OP_COUNT: i64 = 5
# Slots are sized for 16 ops so the v1 set can grow to the plan's full list
# (scroll_rect, glyph_mask_blend, blits, gradients, blur) without re-keying.
val KERNEL_OP_CAPACITY: i64 = 16

val KERNEL_FORMAT_ARGB8888_STRAIGHT: i64 = 0
val KERNEL_FORMAT_ARGB8888_PREMUL: i64 = 1
val KERNEL_FORMAT_CAPACITY: i64 = 4

val KERNEL_ALIGN_UNKNOWN: i64 = 0
val KERNEL_ALIGN_16B: i64 = 1
val KERNEL_ALIGN_CAPACITY: i64 = 2

val KERNEL_SPAN_STRIDED: i64 = 0
val KERNEL_SPAN_CONTIGUOUS: i64 = 1
val KERNEL_CONTIGUITY_CAPACITY: i64 = 2

# Size buckets, per the redesign plan: tiny spans must not pay vector setup.
val KERNEL_BUCKET_TINY: i64 = 0      # 0..15    scalar
val KERNEL_BUCKET_SMALL: i64 = 1     # 16..63   scalar or narrow
val KERNEL_BUCKET_MEDIUM: i64 = 2    # 64..255  SIMD
val KERNEL_BUCKET_LARGE: i64 = 3     # 256+     SIMD, possibly threaded
val KERNEL_BUCKET_CAPACITY: i64 = 4

# Provider 0 is always the scalar oracle and is never displaced by default.
val KERNEL_PROVIDER_SCALAR: i64 = 0
# Provider 1 is the x86_64 SIMD ISA provider (nogc_sync_mut.gpu.engine2d.
# simd_isa_provider). kernel_registry itself (common tier) cannot import or
# call it — that would invert the tier order — so this is only a shared ID
# that a higher-tier dispatcher (e.g. simd_isa_provider.spl) and the
# registration call sites agree on.
val KERNEL_PROVIDER_SIMD_ISA: i64 = 1

val KERNEL_SLOT_CAPACITY: i64 = 1024   # 16 * 4 * 2 * 2 * 4

fn kernel_size_bucket(count: i64) -> i64:
    """Size bucket for a span length."""
    if count < 16:
        return KERNEL_BUCKET_TINY
    if count < 64:
        return KERNEL_BUCKET_SMALL
    if count < 256:
        return KERNEL_BUCKET_MEDIUM
    KERNEL_BUCKET_LARGE

fn kernel_slot_key(op: i64, format: i64, alignment: i64, contiguity: i64,
                   bucket: i64) -> i64:
    """Flat slot index for a registry key. Returns -1 on any out-of-range
    axis rather than aliasing onto a valid neighbouring slot."""
    if op < 0 or op >= KERNEL_OP_CAPACITY:
        return 0 - 1
    if format < 0 or format >= KERNEL_FORMAT_CAPACITY:
        return 0 - 1
    if alignment < 0 or alignment >= KERNEL_ALIGN_CAPACITY:
        return 0 - 1
    if contiguity < 0 or contiguity >= KERNEL_CONTIGUITY_CAPACITY:
        return 0 - 1
    if bucket < 0 or bucket >= KERNEL_BUCKET_CAPACITY:
        return 0 - 1
    var k: i64 = op
    k = k * KERNEL_FORMAT_CAPACITY + format
    k = k * KERNEL_ALIGN_CAPACITY + alignment
    k = k * KERNEL_CONTIGUITY_CAPACITY + contiguity
    k = k * KERNEL_BUCKET_CAPACITY + bucket
    k

# --- the session kernel table ----------------------------------------------

class CpuKernelTable:
    """Provider selection per slot. Built once per session, then read-only on
    the frame path.

    Flat top-level fields only — no nested class instances — because a class
    held in another class's field is value-copied under the interpreter.
    """
    slots: [i64]
    sealed: bool
    registrations: i64
    rejections: i64
    lookups: i64

fn kernel_table_new() -> CpuKernelTable:
    """A table with every slot on the scalar oracle."""
    CpuKernelTable(
        slots: [KERNEL_PROVIDER_SCALAR; KERNEL_SLOT_CAPACITY.to_i32()],
        sealed: false,
        registrations: 0,
        rejections: 0,
        lookups: 0,
    )

fn kernel_table_register(mut table: CpuKernelTable, op: i64, format: i64,
                         alignment: i64, contiguity: i64, bucket: i64,
                         provider: i64, bit_exact: bool, faster: bool) -> bool:
    """Claim one slot for a provider. Returns false and leaves the slot on
    scalar unless the provider is BOTH bit-exact and faster.

    Both conditions are required because they fail independently and have both
    actually failed here: the native-row SIMD path was measured slower than
    scalar AND was filed for producing corrupt colour values. Availability of a
    CPU feature is not a promotion criterion.
    """
    if table.sealed:
        table.rejections = table.rejections + 1
        return false
    val key = kernel_slot_key(op, format, alignment, contiguity, bucket)
    if key < 0:
        table.rejections = table.rejections + 1
        return false
    if not bit_exact or not faster:
        table.rejections = table.rejections + 1
        return false
    table.slots[key.to_i32()] = provider
    table.registrations = table.registrations + 1
    true

fn kernel_table_seal(mut table: CpuKernelTable):
    """Close registration. Frame-path code must only ever see a sealed table —
    a frame that can still register is a frame that can re-probe CPU features."""
    table.sealed = true

fn kernel_table_lookup(mut table: CpuKernelTable, op: i64, format: i64,
                       alignment: i64, contiguity: i64, bucket: i64) -> i64:
    """Provider for a slot; scalar for any unregistered or invalid key."""
    table.lookups = table.lookups + 1
    val key = kernel_slot_key(op, format, alignment, contiguity, bucket)
    if key < 0:
        return KERNEL_PROVIDER_SCALAR
    table.slots[key.to_i32()]

# --- span batch descriptor --------------------------------------------------
#
# ONE call carries many span ops. The point is to delete per-row FFI: the
# current native path crosses the boundary once PER SOURCE ROW
# (backend_software.spl:615), with each extern taking a boxed [u32] and
# returning a freshly built [u32], so an O(n) conversion wraps an O(n) kernel.
#
# Parallel arrays, not an array of structs, so a native provider can hand the
# columns over without walking a pointer graph.

class SpanOpBatch:
    """A batch of span operations against one destination buffer."""
    ops: [i64]
    dst_offsets: [i64]
    src_offsets: [i64]
    counts: [i64]
    colours: [i64]
    mask_offsets: [i64]
    length: i64
    capacity: i64
    overflow_refusals: i64
    non_scalar_lookups: i64

fn span_batch_new(capacity: i64) -> SpanOpBatch:
    """A batch preallocated for `capacity` ops. Never grows: growth mid-frame
    is exactly the steady-state allocation the plan forbids."""
    val n = capacity.to_i32()
    SpanOpBatch(
        ops: [0; n],
        dst_offsets: [0; n],
        src_offsets: [0; n],
        counts: [0; n],
        colours: [0; n],
        mask_offsets: [0; n],
        length: 0,
        capacity: capacity,
        overflow_refusals: 0,
        non_scalar_lookups: 0,
    )

fn span_batch_push(mut batch: SpanOpBatch, op: i64, dst_offset: i64,
                   src_offset: i64, count: i64, colour: i64,
                   mask_offset: i64) -> bool:
    """Append one op. REFUSES on overflow rather than growing — a typed
    refusal the caller must handle, not a silent reallocation."""
    if batch.length >= batch.capacity:
        batch.overflow_refusals = batch.overflow_refusals + 1
        return false
    val i = batch.length.to_i32()
    batch.ops[i] = op
    batch.dst_offsets[i] = dst_offset
    batch.src_offsets[i] = src_offset
    batch.counts[i] = count
    batch.colours[i] = colour
    batch.mask_offsets[i] = mask_offset
    batch.length = batch.length + 1
    true

fn span_batch_reset(mut batch: SpanOpBatch):
    """Reuse the batch for the next frame without reallocating."""
    batch.length = 0

# --- batch execution --------------------------------------------------------

fn span_batch_execute(mut batch: SpanOpBatch, mut dst: [u32], src: [u32],
                      mask: [u32], mut table: CpuKernelTable,
                      format: i64, alignment: i64, contiguity: i64) -> i64:
    """Run every op in the batch. Returns the number of ops executed.

    Provider selection is consulted per op and the result is no longer
    discarded: `non_scalar_lookups` counts every op whose slot resolves to a
    non-scalar provider, so callers/specs can observe selection without
    guessing. This function itself still ALWAYS executes via the scalar
    oracle for any op it runs — kernel_registry lives in the `common` tier
    and the SIMD ISA provider (KERNEL_PROVIDER_SIMD_ISA) lives in the higher
    `nogc_sync_mut` tier, so calling it here would invert the tier order.
    The real SIMD dispatcher is `simd_span_batch_execute` in
    `std.nogc_sync_mut.gpu.engine2d.simd_isa_provider`, which imports both
    this registry and the scalar oracle and branches on this same lookup.
    """
    var executed: i64 = 0
    var i: i64 = 0
    while i < batch.length:
        val idx = i.to_i32()
        val op = batch.ops[idx]
        val count = batch.counts[idx]
        if count > 0:
            val bucket = kernel_size_bucket(count)
            val provider = kernel_table_lookup(table, op, format, alignment, contiguity, bucket)
            if provider != KERNEL_PROVIDER_SCALAR:
                batch.non_scalar_lookups = batch.non_scalar_lookups + 1
            val dst_off = batch.dst_offsets[idx]
            val src_off = batch.src_offsets[idx]
            if op == KERNEL_OP_FILL_CONST:
                oracle_fill_const(dst, dst_off, count, batch.colours[idx])
                executed = executed + 1
            elif op == KERNEL_OP_COPY_SPAN:
                oracle_copy_span(dst, dst_off, src, src_off, count)
                executed = executed + 1
            elif op == KERNEL_OP_SRC_OVER_CONST:
                oracle_src_over_const(dst, dst_off, count, batch.colours[idx])
                executed = executed + 1
            elif op == KERNEL_OP_SRC_OVER_IMAGE:
                oracle_src_over_image(dst, dst_off, src, src_off, count)
                executed = executed + 1
            elif op == KERNEL_OP_MASK_SRC_OVER:
                oracle_mask_src_over(dst, dst_off, batch.colours[idx], mask,
                                     batch.mask_offsets[idx], count)
                executed = executed + 1
        i = i + 1
    executed

export CpuKernelTable, SpanOpBatch
export kernel_table_new, kernel_table_register, kernel_table_seal, kernel_table_lookup
export kernel_size_bucket, kernel_slot_key
export span_batch_new, span_batch_push, span_batch_reset, span_batch_execute
export KERNEL_OP_FILL_CONST, KERNEL_OP_COPY_SPAN, KERNEL_OP_SRC_OVER_CONST
export KERNEL_OP_SRC_OVER_IMAGE, KERNEL_OP_MASK_SRC_OVER, KERNEL_OP_COUNT
export KERNEL_FORMAT_ARGB8888_STRAIGHT, KERNEL_FORMAT_ARGB8888_PREMUL
export KERNEL_ALIGN_UNKNOWN, KERNEL_ALIGN_16B
export KERNEL_SPAN_STRIDED, KERNEL_SPAN_CONTIGUOUS
export KERNEL_BUCKET_TINY, KERNEL_BUCKET_SMALL, KERNEL_BUCKET_MEDIUM, KERNEL_BUCKET_LARGE
export KERNEL_PROVIDER_SCALAR, KERNEL_PROVIDER_SIMD_ISA
