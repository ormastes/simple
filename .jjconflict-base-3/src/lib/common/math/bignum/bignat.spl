# BigNat — variable-length natural numbers over the base-2^30 limb layer.
#
# A BigNat is an `[i64]` of limbs in little-endian order (index 0 is least
# significant), each limb in [0, LIMB_MASK]. The canonical form has no trailing
# zero limbs, except for zero itself which is exactly `[0]` — so every value
# has a unique representation and `cmp` can compare lengths first.
#
# This layer is for PUBLIC values only: `cmp`, `div_mod` and friends branch on
# the data. Secret-dependent arithmetic belongs in the constant-time `fixed`
# layer, which is built on the same limb primitives.
#
# Pure functions only (src/lib/common tier): no I/O, no externs, no state.
#
# Usage: use std.math.bignum.bignat.{bn_zero, bn_from_i64, add, mul, div_mod, ...}

use std.math.bignum.limb.{LIMB_BITS, LIMB_BASE, LIMB_MASK, limb_mul, add_limbs, sub_limbs}

# =============================================================================
# Constructors
# =============================================================================

pub fn bn_zero() -> [i64]:
    """Canonical zero — the single-limb `[0]`."""
    [0]

pub fn bn_one() -> [i64]:
    """The value one — `[1]`."""
    [1]

pub fn bn_from_i64(v: i64) -> [i64]:
    """Build a BigNat from a non-negative i64. Negative input yields zero."""
    if v <= 0:
        return [0]
    var out: [i64] = []
    var rest = v
    while rest > 0:
        out.push(rest & LIMB_MASK)
        rest = rest >> LIMB_BITS
    out

# =============================================================================
# Canonicalization and Predicates
# =============================================================================

pub fn normalize(a: [i64]) -> [i64]:
    """Drop trailing zero limbs. Always returns at least one limb (`[0]`)."""
    var last = a.len() - 1
    while last > 0 and a[last] == 0:
        last = last - 1
    var out: [i64] = []
    var i = 0
    while i <= last:
        out.push(a[i])
        i = i + 1
    if out.len() == 0:
        return [0]
    out

pub fn is_zero(a: [i64]) -> bool:
    """True when every limb is zero (works on non-canonical input too)."""
    for l in a:
        if l != 0:
            return false
    true

pub fn is_one(a: [i64]) -> bool:
    """True when the value is exactly one."""
    val n = normalize(a)
    n.len() == 1 and n[0] == 1

# =============================================================================
# Comparison
# =============================================================================

pub fn cmp(a: [i64], b: [i64]) -> i64:
    """Three-way compare. Returns -1 if a < b, 0 if equal, 1 if a > b."""
    val x = normalize(a)
    val y = normalize(b)
    if x.len() != y.len():
        if x.len() < y.len():
            return -1
        return 1
    var i = x.len() - 1
    while i >= 0:
        if x[i] != y[i]:
            if x[i] < y[i]:
                return -1
            return 1
        i = i - 1
    0

# =============================================================================
# Bit Access
# =============================================================================

pub fn bit_length(a: [i64]) -> i64:
    """Number of significant bits. Zero has bit length 0."""
    val n = normalize(a)
    if is_zero(n):
        return 0
    val top = n.len() - 1
    var bits = 0
    var v = n[top]
    while v > 0:
        bits = bits + 1
        v = v >> 1
    top * LIMB_BITS + bits

pub fn get_bit(a: [i64], index: i64) -> i64:
    """Bit `index` (0 = least significant) as 0 or 1. Out of range reads 0."""
    if index < 0:
        return 0
    val limb_index = index / LIMB_BITS
    if limb_index >= a.len():
        return 0
    val bit_index = index - limb_index * LIMB_BITS
    (a[limb_index] >> bit_index) & 1

pub fn shift_left_one(a: [i64]) -> [i64]:
    """Multiply by two."""
    var out: [i64] = []
    var carry = 0
    for l in a:
        val shifted = (l << 1) + carry
        out.push(shifted & LIMB_MASK)
        carry = (shifted >> LIMB_BITS) & 1
    if carry != 0:
        out.push(carry)
    normalize(out)

# =============================================================================
# Addition / Subtraction
# =============================================================================

pub fn add(a: [i64], b: [i64]) -> [i64]:
    """Sum of two BigNats."""
    var out: [i64] = []
    var carry = 0
    val n = if a.len() > b.len(): a.len() else: b.len()
    var i = 0
    while i < n:
        val av = if i < a.len(): a[i] else: 0
        val bv = if i < b.len(): b[i] else: 0
        val r = add_limbs(av, bv, carry)
        out.push(r[0])
        carry = r[1]
        i = i + 1
    if carry != 0:
        out.push(carry)
    normalize(out)

pub fn sub(a: [i64], b: [i64]) -> [i64]:
    """Difference a - b, saturating at zero when b >= a (BigNat is unsigned)."""
    if cmp(a, b) <= 0:
        return [0]
    var out: [i64] = []
    var borrow = 0
    var i = 0
    while i < a.len():
        val bv = if i < b.len(): b[i] else: 0
        val r = sub_limbs(a[i], bv, borrow)
        out.push(r[0])
        borrow = r[1]
        i = i + 1
    normalize(out)

# =============================================================================
# Multiplication
# =============================================================================

pub fn mul(a: [i64], b: [i64]) -> [i64]:
    """Schoolbook product of two BigNats."""
    if is_zero(a) or is_zero(b):
        return [0]
    val alen = a.len()
    val blen = b.len()
    var acc: [i64] = []
    var k = 0
    while k < alen + blen:
        acc.push(0)
        k = k + 1
    var i = 0
    while i < alen:
        var carry = 0
        var j = 0
        while j < blen:
            val p = limb_mul(a[i], b[j])
            # acc[i+j] + low + carry is at most 3 * LIMB_MASK < 2^32, so the
            # running sum stays exact in i64 and splits with a plain shift.
            val s = acc[i + j] + p[0] + carry
            acc[i + j] = s & LIMB_MASK
            carry = (s >> LIMB_BITS) + p[1]
            j = j + 1
        var pos = i + blen
        while carry != 0:
            val s2 = acc[pos] + carry
            acc[pos] = s2 & LIMB_MASK
            carry = s2 >> LIMB_BITS
            pos = pos + 1
        i = i + 1
    normalize(acc)

pub fn mul_i64(a: [i64], m: i64) -> [i64]:
    """Product of a BigNat and a non-negative i64 scalar."""
    if m <= 0 or is_zero(a):
        return [0]
    mul(a, bn_from_i64(m))

# =============================================================================
# Division
# =============================================================================

pub fn div_mod(a: [i64], b: [i64]) -> [[i64]]:
    """Quotient and remainder as `[q, r]` with a = q*b + r and r < b.

    Binary long division over `bit_length(a)` iterations. Division by zero
    returns `[[0], [0]]` rather than trapping — callers on this layer are
    expected to have validated the modulus.
    """
    if is_zero(b):
        return [[0], [0]]
    if cmp(a, b) < 0:
        return [[0], normalize(a)]
    var quotient: [i64] = [0]
    var remainder: [i64] = [0]
    var i = bit_length(a) - 1
    while i >= 0:
        remainder = shift_left_one(remainder)
        if get_bit(a, i) == 1:
            remainder = add(remainder, [1])
        quotient = shift_left_one(quotient)
        if cmp(remainder, b) >= 0:
            remainder = sub(remainder, b)
            quotient = add(quotient, [1])
        i = i - 1
    [normalize(quotient), normalize(remainder)]

pub fn modulo(a: [i64], m: [i64]) -> [i64]:
    """Remainder of a divided by m."""
    val pair = div_mod(a, m)
    pair[1]

# =============================================================================
# Byte Encoding
# =============================================================================

pub fn from_bytes_be(bytes: [u8]) -> [i64]:
    """Decode a big-endian byte string (most significant byte first)."""
    var acc: [i64] = [0]
    for b in bytes:
        acc = mul_i64(acc, 256)
        acc = add(acc, bn_from_i64(b.to_i64()))
    normalize(acc)

pub fn from_bytes_le(bytes: [u8]) -> [i64]:
    """Decode a little-endian byte string (least significant byte first)."""
    var acc: [i64] = [0]
    var i = bytes.len() - 1
    while i >= 0:
        acc = mul_i64(acc, 256)
        acc = add(acc, bn_from_i64(bytes[i].to_i64()))
        i = i - 1
    normalize(acc)

pub fn to_bytes_be(a: [i64], length: i64) -> [u8]:
    """Encode into exactly `length` big-endian bytes, zero-padded on the left.

    Bytes beyond `length` are dropped, matching the fixed-width encodings the
    crypto layers use.
    """
    val le = to_bytes_le(a, length)
    var out: [u8] = []
    var i = le.len() - 1
    while i >= 0:
        out.push(le[i])
        i = i - 1
    out

pub fn to_bytes_le(a: [i64], length: i64) -> [u8]:
    """Encode into exactly `length` little-endian bytes, zero-padded on the right."""
    var rest = normalize(a)
    val divisor = bn_from_i64(256)
    var out: [u8] = []
    var i = 0
    while i < length:
        val pair = div_mod(rest, divisor)
        val r = pair[1]
        out.push((r[0] & 255).to_u8())
        rest = pair[0]
        i = i + 1
    out
