# ============================================================================
# common/structural/resolve/resolve_types.spl — FROZEN resolve contract (LINK)
#
# Architecture Part VII §18 (GraphResolveCore record/profile contract), §19
# (SMF link pipeline L0–L12, linker tags), §29 Wave 7. Contract document:
# doc/05_design/platform/structural_compute/link_manager_contract_v1.md
#
# FROZEN: these record shapes and enum discriminants are contract v1; any
# change is a schema-version bump plus new golden vectors, never an edit.
#
# Identity types (EntityRef, SnapshotId, Hash128) are reused from the frozen
# ID-TAG contract — LINK mints no parallel identity model.
# ============================================================================

use std.common.structural.identity.entity_id.{EntityRef, Hash128, SnapshotId,
    entity_ref, entity_ref_equal, hash128, hash128_equal}

# Schema version for every record in this module.
val RESOLVE_SCHEMA_VERSION: i64 = 1

# ----------------------------------------------------------------------------
# ResolveKey — the hash/intern grouping key (§18).
#
# `name_hash` is the interned symbol/resource name; `space` is the
# profile-defined namespace discriminant (e.g. SMF symbol table vs section
# names vs CSS custom-property names) so one arena can never cross-resolve
# records from two spaces that merely share a name hash.
# ----------------------------------------------------------------------------

struct ResolveKey:
    """Grouping key for definitions and references (§18). 20 bytes on the wire."""
    name_hash: Hash128
    space: u32

# ----------------------------------------------------------------------------
# Record shapes shared by every ResolveProfile (§18).
#
# `attributes` is a profile-defined u64 bitset (SmfLinkProfile packs
# link.symbol.binding / link.symbol.visibility there); `order` is the stable
# input order used for deterministic group reduction and diagnostics.
# ----------------------------------------------------------------------------

struct DefinitionRecord:
    """One definition site of a key (§18). 44 bytes on the wire."""
    key: ResolveKey
    owner: EntityRef
    attributes: u64
    order: u64

struct ReferenceRecord:
    """One reference to a key (§18). 44 bytes on the wire."""
    key: ResolveKey
    owner: EntityRef
    attributes: u64
    order: u64

struct ResolutionRecord:
    """Outcome of resolving one reference (§18). 20 bytes on the wire.

    `definition` is meaningful only when `status` is Resolved or WeakResolved;
    otherwise it is the zero EntityRef and decoders must not dereference it.
    `status`/`reason` carry u8-range discriminants (one wire byte each); u32
    in memory because the frozen siblings use no scalar-u8 fields.
    """
    reference: EntityRef
    definition: EntityRef
    status: u32
    reason: u32

# ----------------------------------------------------------------------------
# ResolveStatus / ResolveReason — u8 discriminants, hard-reject on unknown.
#
# Unresolved is deliberately discriminant 0 so zero-initialized arena memory
# reads as "not resolved", never as a successful resolution.
# ----------------------------------------------------------------------------

enum ResolveStatus:
    Unresolved
    Resolved
    Ambiguous
    WeakResolved

fn resolve_status_to_u8(s: ResolveStatus) -> i64:
    match s:
        case ResolveStatus.Unresolved: 0
        case ResolveStatus.Resolved: 1
        case ResolveStatus.Ambiguous: 2
        case ResolveStatus.WeakResolved: 3

val RESOLVE_STATUS_MAX: i64 = 3

fn resolve_status_from_u8(v: i64) -> ResolveStatus:
    """Caller MUST gate on `resolve_status_valid` first; unknown discriminants
    pin to Unresolved so the function stays total."""
    match v:
        case 1: ResolveStatus.Resolved
        case 2: ResolveStatus.Ambiguous
        case 3: ResolveStatus.WeakResolved
        case _: ResolveStatus.Unresolved

fn resolve_status_valid(v: i64) -> bool:
    v >= 0 and v <= RESOLVE_STATUS_MAX

enum ResolveReason:
    Unspecified
    MissingDefinition
    DuplicateDefinition
    VisibilityDenied
    ArchiveUnextracted
    CycleDetected

fn resolve_reason_to_u8(r: ResolveReason) -> i64:
    match r:
        case ResolveReason.Unspecified: 0
        case ResolveReason.MissingDefinition: 1
        case ResolveReason.DuplicateDefinition: 2
        case ResolveReason.VisibilityDenied: 3
        case ResolveReason.ArchiveUnextracted: 4
        case ResolveReason.CycleDetected: 5

val RESOLVE_REASON_MAX: i64 = 5

fn resolve_reason_from_u8(v: i64) -> ResolveReason:
    """Caller MUST gate on `resolve_reason_valid` first; unknown discriminants
    pin to Unspecified so the function stays total."""
    match v:
        case 1: ResolveReason.MissingDefinition
        case 2: ResolveReason.DuplicateDefinition
        case 3: ResolveReason.VisibilityDenied
        case 4: ResolveReason.ArchiveUnextracted
        case 5: ResolveReason.CycleDetected
        case _: ResolveReason.Unspecified

fn resolve_reason_valid(v: i64) -> bool:
    v >= 0 and v <= RESOLVE_REASON_MAX

# ----------------------------------------------------------------------------
# LinkMutationKind — LINK's projection of the MutationIR kinds it emits (§12,
# §18 emit step). The global MutationIR executor is a consumer contract owned
# by the MUTATE lane; LINK freezes only the kinds it produces.
# ----------------------------------------------------------------------------

enum LinkMutationKind:
    ReplaceLinkDefinition
    AddRelocation
    ChangePlacementHint

fn link_mutation_kind_to_u8(k: LinkMutationKind) -> i64:
    match k:
        case LinkMutationKind.ReplaceLinkDefinition: 0
        case LinkMutationKind.AddRelocation: 1
        case LinkMutationKind.ChangePlacementHint: 2

val LINK_MUTATION_KIND_MAX: i64 = 2

fn link_mutation_kind_from_u8(v: i64) -> LinkMutationKind:
    """Caller MUST gate on `link_mutation_kind_valid` first."""
    match v:
        case 1: LinkMutationKind.AddRelocation
        case 2: LinkMutationKind.ChangePlacementHint
        case _: LinkMutationKind.ReplaceLinkDefinition

fn link_mutation_kind_valid(v: i64) -> bool:
    v >= 0 and v <= LINK_MUTATION_KIND_MAX

# ----------------------------------------------------------------------------
# ResolveMode — the three execution lanes of §19 (cpu_reference is the oracle;
# hybrid and resident must produce byte-identical MutationPlans and receipts).
# ----------------------------------------------------------------------------

enum ResolveMode:
    CpuReference
    HybridVectorGpu
    ResidentGpu

fn resolve_mode_to_u8(m: ResolveMode) -> i64:
    match m:
        case ResolveMode.CpuReference: 0
        case ResolveMode.HybridVectorGpu: 1
        case ResolveMode.ResidentGpu: 2

val RESOLVE_MODE_MAX: i64 = 2

fn resolve_mode_from_u8(v: i64) -> ResolveMode:
    """Caller MUST gate on `resolve_mode_valid` first."""
    match v:
        case 1: ResolveMode.HybridVectorGpu
        case 2: ResolveMode.ResidentGpu
        case _: ResolveMode.CpuReference

fn resolve_mode_valid(v: i64) -> bool:
    v >= 0 and v <= RESOLVE_MODE_MAX

# ----------------------------------------------------------------------------
# Arena references — in-memory handles, never wire records (same convention as
# compute/placement_contracts: object_slot resolves through the Object VM
# descriptor table, generation guards stale handles).
# ----------------------------------------------------------------------------

struct ResolveInputRef:
    """Handle to a profile's collected definition/reference arenas."""
    object_slot: u32
    generation: u32

struct ResolveResultRef:
    """Handle to the resolution-record arena a resolve pass produced."""
    object_slot: u32
    generation: u32

struct ConstraintBatch:
    """Handle to a batch of propagation constraints derived from one group."""
    object_slot: u32
    generation: u32
    count: u32

struct DomainPlacementRef:
    """Handle to profile-domain placement hints (consumed by PLACE, §20)."""
    object_slot: u32
    generation: u32

struct MutationPlanRef:
    """Handle to the MutationIR plan a profile emitted (validated/committed by
    the MUTATE executor, §12)."""
    object_slot: u32
    generation: u32

struct ResolveGroupView:
    """One key's slice of the sorted definition/reference arenas (§18).

    Offsets and counts index the arenas behind a ResolveInputRef; the view
    itself owns nothing.
    """
    key: ResolveKey
    definitions_offset: u32
    definitions_count: u32
    references_offset: u32
    references_count: u32

struct ResolveGroupResult:
    """Deterministic reduction of one group (§18): the selected definition (or
    the zero EntityRef), the status, and the number of diagnostics queued."""
    key: ResolveKey
    selected: EntityRef
    status: u32
    reason: u32
    diagnostic_count: u32

# ----------------------------------------------------------------------------
# ResolveProfile — the frozen six-step profile interface (§18). Profiles share
# GraphResolveCore primitives, never semantics.
# ----------------------------------------------------------------------------

trait ResolveProfile:
    fn collect(snapshot: SnapshotId) -> ResolveInputRef
    fn group_key(record: ReferenceRecord) -> ResolveKey
    fn resolve_group(group: ResolveGroupView) -> ResolveGroupResult
    fn derive_constraints(result: ResolveGroupResult) -> ConstraintBatch
    fn plan_placement(result: ResolveResultRef) -> DomainPlacementRef
    fn emit(result: ResolveResultRef) -> MutationPlanRef

# ----------------------------------------------------------------------------
# Encoded sizes — fixed, so downstream lanes can size arenas without probing.
# ----------------------------------------------------------------------------

val RESOLVE_KEY_LEN: i64 = 20
val DEFINITION_RECORD_LEN: i64 = 44
val REFERENCE_RECORD_LEN: i64 = 44
val RESOLUTION_RECORD_LEN: i64 = 20

# ----------------------------------------------------------------------------
# SMF link pipeline stage ids (§19 L0–L12) — StageReceipt.stage values for the
# SmfLinkProfile. Frozen as plain consts so receipts sort and diff stably.
# ----------------------------------------------------------------------------

val SMF_LINK_STAGE_L0_DISCOVER: i64 = 0
val SMF_LINK_STAGE_L1_DECODE: i64 = 1
val SMF_LINK_STAGE_L2_ARENAS: i64 = 2
val SMF_LINK_STAGE_L3_INTERN_SORT: i64 = 3
val SMF_LINK_STAGE_L4_SELECT: i64 = 4
val SMF_LINK_STAGE_L5_ARCHIVE_FIXPOINT: i64 = 5
val SMF_LINK_STAGE_L6_REACHABILITY: i64 = 6
val SMF_LINK_STAGE_L7_ADDRESS_LAYOUT: i64 = 7
val SMF_LINK_STAGE_L8_RELOCATION: i64 = 8
val SMF_LINK_STAGE_L9_OUTPUT_ASSEMBLY: i64 = 9
val SMF_LINK_STAGE_L10_PROVENANCE: i64 = 10
val SMF_LINK_STAGE_L11_SSD_WRITE: i64 = 11
val SMF_LINK_STAGE_L12_MANIFEST_COMMIT: i64 = 12

# ----------------------------------------------------------------------------
# Linker tag names (§19) — the frozen `link.*` tag vocabulary. Values are
# TagMap entries; the names are frozen here so producers and consumers agree.
# ----------------------------------------------------------------------------

val LINK_TAG_SYMBOL_BINDING: text = "link.symbol.binding"
val LINK_TAG_SYMBOL_VISIBILITY: text = "link.symbol.visibility"
val LINK_TAG_SYMBOL_RESOLUTION: text = "link.symbol.resolution"
val LINK_TAG_SECTION_KIND: text = "link.section.kind"
val LINK_TAG_SECTION_ALIGNMENT: text = "link.section.alignment"
val LINK_TAG_RELOCATION_KIND: text = "link.relocation.kind"
val LINK_TAG_REACHABLE: text = "link.reachable"
val LINK_TAG_ICF_CANDIDATE: text = "link.icf.candidate"
val LINK_TAG_HOT_ORDER: text = "link.hot_order"
val LINK_TAG_OUTPUT_RANGE: text = "link.output_range"

# ----------------------------------------------------------------------------
# Constructors and equality
# ----------------------------------------------------------------------------

fn resolve_key(name_hash: Hash128, space: u32) -> ResolveKey:
    ResolveKey(name_hash: name_hash, space: space)

fn resolve_key_equal(a: ResolveKey, b: ResolveKey) -> bool:
    hash128_equal(a.name_hash, b.name_hash) and a.space == b.space

fn definition_record(key: ResolveKey, owner: EntityRef, attributes: u64, order: u64) -> DefinitionRecord:
    DefinitionRecord(key: key, owner: owner, attributes: attributes, order: order)

fn reference_record(key: ResolveKey, owner: EntityRef, attributes: u64, order: u64) -> ReferenceRecord:
    ReferenceRecord(key: key, owner: owner, attributes: attributes, order: order)

fn resolution_record(reference: EntityRef, definition: EntityRef, status: u32, reason: u32) -> ResolutionRecord:
    ResolutionRecord(reference: reference, definition: definition, status: status, reason: reason)

fn definition_record_equal(a: DefinitionRecord, b: DefinitionRecord) -> bool:
    (resolve_key_equal(a.key, b.key) and entity_ref_equal(a.owner, b.owner)
        and a.attributes == b.attributes and a.order == b.order)

fn reference_record_equal(a: ReferenceRecord, b: ReferenceRecord) -> bool:
    (resolve_key_equal(a.key, b.key) and entity_ref_equal(a.owner, b.owner)
        and a.attributes == b.attributes and a.order == b.order)

fn resolution_record_equal(a: ResolutionRecord, b: ResolutionRecord) -> bool:
    (entity_ref_equal(a.reference, b.reference)
        and entity_ref_equal(a.definition, b.definition)
        and a.status == b.status and a.reason == b.reason)

fn resolution_definition_present(r: ResolutionRecord) -> bool:
    """True when `definition` may be dereferenced: only Resolved and
    WeakResolved carry one."""
    r.status == resolve_status_to_u8(ResolveStatus.Resolved)
        or r.status == resolve_status_to_u8(ResolveStatus.WeakResolved)
