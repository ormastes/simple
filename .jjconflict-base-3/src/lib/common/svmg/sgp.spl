# NOTE: `sgp_header_new` is plain `fn`, not `pub fn` -- its six i64
# params (all "u32 wire value" per design §4.2) trip the `primitive_api`
# lint, whose documented `#![allow(primitive_api)]` suppression does not
# actually take effect under the current seed lint checker (verified
# empirically). Still externally importable as plain `fn` (see
# opcodes.spl's identical note).

# SVM-G program container ("SGP" blob) — design doc §4.2
# (doc/05_design/runtime/gpu_remote_interpreter_architecture.md)
#
#   u32 magic     = 0x53474250        ("SGPB")
#   u32 version   = 1
#   u32 code_off, code_len            (bytes, within DATA)
#   u32 data_off, data_len
#   u32 step_budget
#   u32 entry_pc
#   u32 reserved[1]
#
# 9 u32 fields = 36 bytes, little-endian throughout.

# NOTE: hand-rolled little-endian codec, NOT std.common.binary_io's
# BinaryWriter/BinaryReader -- see
# doc/08_tracking/bug/binary_io_binaryreader_multibyte_read_returns_zero_after_binarywriter_2026-08-07.md.
# BinaryReader's multi-byte reads (read_u16/u32/...) return 0 when fed an
# array produced by BinaryWriter.to_bytes(), even though the array's
# contents are provably correct by direct indexing. Verified empirically
# while building this module; filing the bug rather than silently working
# around it, per repo policy -- but still routing around it here since
# fixing binary_io.spl is out of this task's scope.

fn _push_u32_le(buf: [u8], v: i64) -> [u8]:
    var out = buf
    out.push((v & 0xFF) as u8)
    out.push(((v >> 8) & 0xFF) as u8)
    out.push(((v >> 16) & 0xFF) as u8)
    out.push(((v >> 24) & 0xFF) as u8)
    out

fn _u32_le_at(bytes: [u8], idx: i64) -> i64:
    (bytes[idx] as i64) | ((bytes[idx + 1] as i64) << 8) | ((bytes[idx + 2] as i64) << 16) | ((bytes[idx + 3] as i64) << 24)

pub val SGP_MAGIC: i64 = 0x53474250
pub val SGP_VERSION: i64 = 1
pub val SGP_HEADER_SIZE: i64 = 36

pub struct SgpHeader:
    magic: i64
    version: i64
    code_off: i64
    code_len: i64
    data_off: i64
    data_len: i64
    step_budget: i64
    entry_pc: i64
    reserved0: i64

fn sgp_header_new(code_off: i64, code_len: i64, data_off: i64, data_len: i64, step_budget: i64, entry_pc: i64) -> SgpHeader:
    """Build a well-formed v1 header (magic/version filled in)."""
    SgpHeader(
        magic: SGP_MAGIC,
        version: SGP_VERSION,
        code_off: code_off,
        code_len: code_len,
        data_off: data_off,
        data_len: data_len,
        step_budget: step_budget,
        entry_pc: entry_pc,
        reserved0: 0,
    )

pub fn encode_sgp_header(header: SgpHeader) -> [u8]:
    """Encode an SgpHeader to its 36-byte little-endian wire form."""
    var buf: [u8] = []
    buf = _push_u32_le(buf, header.magic)
    buf = _push_u32_le(buf, header.version)
    buf = _push_u32_le(buf, header.code_off)
    buf = _push_u32_le(buf, header.code_len)
    buf = _push_u32_le(buf, header.data_off)
    buf = _push_u32_le(buf, header.data_len)
    buf = _push_u32_le(buf, header.step_budget)
    buf = _push_u32_le(buf, header.entry_pc)
    buf = _push_u32_le(buf, header.reserved0)
    buf

pub fn decode_sgp_header(bytes: [u8]) -> SgpHeader:
    """Decode a 36-byte little-endian SGP header.

    Fail-fast: panics if the blob is too short, or if magic/version don't
    match — a corrupt/foreign blob must never be silently accepted.
    """
    if bytes.len() < SGP_HEADER_SIZE:
        panic("svmg: SGP header truncated ({bytes.len()} bytes, need {SGP_HEADER_SIZE})")
    val magic = _u32_le_at(bytes, 0)
    val version = _u32_le_at(bytes, 4)
    val code_off = _u32_le_at(bytes, 8)
    val code_len = _u32_le_at(bytes, 12)
    val data_off = _u32_le_at(bytes, 16)
    val data_len = _u32_le_at(bytes, 20)
    val step_budget = _u32_le_at(bytes, 24)
    val entry_pc = _u32_le_at(bytes, 28)
    val reserved0 = _u32_le_at(bytes, 32)
    if magic != SGP_MAGIC:
        panic("svmg: bad SGP magic 0x{magic} (expected 0x{SGP_MAGIC})")
    if version != SGP_VERSION:
        panic("svmg: unsupported SGP version {version} (expected {SGP_VERSION})")
    SgpHeader(
        magic: magic,
        version: version,
        code_off: code_off,
        code_len: code_len,
        data_off: data_off,
        data_len: data_len,
        step_budget: step_budget,
        entry_pc: entry_pc,
        reserved0: reserved0,
    )
