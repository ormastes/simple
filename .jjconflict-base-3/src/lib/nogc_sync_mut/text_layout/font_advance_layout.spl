use std.nogc_sync_mut.text_layout.font_types.{FontRenderQuad}

# Apply the producer-resolved per-character advances to an already rasterized
# font batch. Atlas ownership stays in FontRenderer; only destination positions
# change, so Draw IR never owns transient atlas/cache material.
fn _font_character_index(byte_offsets: [i64], byte_offset: i64) -> i64:
    var low: i64 = 0
    var high = byte_offsets.len()
    while low < high:
        val middle = low + (high - low) / 2
        if byte_offsets[middle] < byte_offset:
            low = middle + 1
        else:
            high = middle
    if low < byte_offsets.len() and byte_offsets[low] == byte_offset:
        return low
    -1

# Rewrites `quads` IN PLACE and answers whether the re-layout held.
#
# This used to take a FontRenderBatch and RETURN a copy with `quads` replaced.
# On the freestanding/cranelift host-WM lane that returned aggregate arrived
# with every scalar intact but an EMPTY `quads` array -- the inner-array-field
# collapse of doc/08_tracking/bug/
# cranelift_native_aggregate_return_nil_receiver_hosted_wm_2026-07-26.md, seen
# live as `[font-batch] degenerate source=text-advances ... quads=0
# atlas_pixels=1048576`. A `mut` array parameter plus element assignment and a
# scalar return are all proven-safe channels.
#
# On any failure `quads` is left EXACTLY as it came in (all validation happens
# before the first write), matching the old "return the un-adjusted batch with
# valid=false" contract.
fn font_batch_apply_advances(content: text, natural_advances: [i32], advance_widths: [i32], mut quads: [FontRenderQuad]) -> bool:
    var byte_offsets: [i64] = []
    var shifts: [i32] = []
    var byte_offset: i64 = 0
    var target_x: i64 = 0
    var natural_x: i64 = 0
    var character_count: i64 = 0
    for ch in content:
        if character_count >= advance_widths.len() or character_count >= natural_advances.len():
            return false
        val advance = advance_widths[character_count]
        val natural_advance = natural_advances[character_count]
        if (advance < 0 or natural_advance < 0 or
            target_x > 2147483647 - advance.to_i64() or
            natural_x > 2147483647 - natural_advance.to_i64()):
            return false
        byte_offsets = byte_offsets.push(byte_offset)
        shifts = shifts.push((target_x - natural_x).to_i32())
        byte_offset = byte_offset + ch.len()
        target_x = target_x + advance.to_i64()
        natural_x = natural_x + natural_advance.to_i64()
        character_count = character_count + 1
    if character_count != advance_widths.len() or character_count != natural_advances.len():
        return false

    # Resolve every destination first; only commit once all of them are valid,
    # so a late rejection cannot leave a half-shifted run behind.
    var shifted_xs: [i32] = []
    var index: i64 = 0
    while index < quads.len():
        val quad = quads[index]
        val character_index = _font_character_index(byte_offsets, quad.byte_offset)
        if character_index < 0:
            return false
        val shifted_x = quad.dst_x.to_i64() + shifts[character_index].to_i64()
        if shifted_x < -2147483648 or shifted_x > 2147483647:
            return false
        shifted_xs = shifted_xs.push(shifted_x.to_i32())
        index = index + 1
    index = 0
    while index < quads.len():
        val quad = quads[index]
        quads[index] = FontRenderQuad(
            codepoint: quad.codepoint, byte_offset: quad.byte_offset,
            dst_x: shifted_xs[index], dst_y: quad.dst_y,
            width: quad.width, height: quad.height,
            atlas_x: quad.atlas_x, atlas_y: quad.atlas_y,
            color: quad.color, cluster: quad.cluster
        )
        index = index + 1
    true
