#!/bin/sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname "$0")/../../../.." && pwd)"
SRC="$ROOT/src/os/kernel/arch/arm32/cosmos"
TEST="$ROOT/test/02_integration/os/cosmos/cosmos_smp_cache_contract_test.c"
CC="${CC:-cc}"
TMP="$(mktemp -d "${TMPDIR:-/tmp}/cosmos-smp-cache-contract.XXXXXX")"
trap 'rm -rf "$TMP"' EXIT

command -v "$CC" >/dev/null 2>&1 || {
    echo "missing-tool: $CC" >&2
    exit 2
}

"$CC" -std=c11 -O2 -Wall -Wextra -Werror -Wpedantic -Wshadow \
    -Wconversion -Wstrict-prototypes -DCOSMOS_CONTRACT_TEST \
    "$TEST" "$SRC/cosmos_mmu_cache.c" "$SRC/cosmos_smp_gic.c" \
    -o "$TMP/cosmos_smp_cache_contract_test"
"$TMP/cosmos_smp_cache_contract_test"
