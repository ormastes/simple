use app.llm_caret.messaging.database_execution.{DatabaseArtifactKind, default_database_execution_plan}
use std.test.{describe, it, expect}

describe "simple caret messaging command contract":
    it "routes database work through the cached SMF carrier":
        val plan = default_database_execution_plan(false)
        expect(plan.kind).to_equal(DatabaseArtifactKind.SmfLibrary)
        expect(plan.artifact_path).to_contain("llm_caret_messaging_db.smf")

    it "keeps the source worker available only as build input":
        val plan = default_database_execution_plan(false)
        expect(plan.source_path).to_end_with("database_worker.spl")
        expect(plan.requires_fresh_artifact).to_equal(true)
