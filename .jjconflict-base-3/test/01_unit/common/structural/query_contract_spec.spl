    TAG_INDEX_SPARSE_RECORDS,
    query_determinism_from_u8,
    query_determinism_satisfies,
    query_determinism_to_u8,
    query_determinism_valid,
    query_dialect_equal,
    query_dialect_from_u8,
    query_dialect_to_u8,
    query_dialect_valid,
    query_op_kind_equal,
    query_op_kind_from_u8,
    query_op_kind_is_binary,
    query_op_kind_is_seed,
    query_op_kind_to_u8,
    query_op_kind_valid,
