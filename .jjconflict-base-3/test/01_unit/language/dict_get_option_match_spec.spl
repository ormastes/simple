# Dict.get() feeds `match ... case Some(x)` correctly.
#
# Regression spec for the Option dual-ABI decode defect
# (doc/08_tracking/bug/cranelift_native_aggregate_return_nil_receiver_hosted_wm_2026-07-26.md).
#
# `Dict.get(k)` returns the FLAT Option form: the raw value on a hit, nil on a
# miss. It never builds a boxed Some/None enum handle, and it must not start
# doing so -- ~4,000 call sites consume it as raw-or-nil (`?? default`,
# `== nil`, direct use). The decode side is what has to understand both forms.
#
# Before the fix: the Some arm fired with a nil payload (interpreter tier:
# "field access on nil receiver"; native tier: no arm matched and the default
# arm ran on a present key).

class Holder:
    id: text
    count: i64

enum Shape:
    Circle
    Square

describe "Dict.get + match Some/None":
    it "binds an intact struct payload for a present key":
        var cache: Dict<text, Holder> = {}
        cache["k"] = Holder(id: "hit", count: 7)
        var seen = "none"
        var seen_count = 0
        match cache.get("k"):
            case Some(hit):
                seen = hit.id
                seen_count = hit.count
            case _:
                seen = "default-arm"
        expect(seen).to_equal("hit")
        expect(seen_count).to_equal(7)

    it "binds an intact text payload for a present key":
        var cache: Dict<text, text> = {}
        cache["k"] = "value"
        var seen = ""
        match cache.get("k"):
            case Some(hit): seen = hit
            case _: seen = "default-arm"
        expect(seen).to_equal("value")

    it "binds an intact i64 payload for a present key":
        var cache: Dict<text, i64> = {}
        cache["k"] = 42
        var seen = 0
        match cache.get("k"):
            case Some(hit): seen = hit
            case _: seen = -1
        expect(seen).to_equal(42)

    it "takes the None arm for an absent key":
        var cache: Dict<text, text> = {}
        cache["present"] = "v"
        var seen = "unset"
        match cache.get("absent"):
            case Some(hit): seen = hit
            case None: seen = "none-arm"
        expect(seen).to_equal("none-arm")

    it "does not take the Some arm for an absent key":
        var cache: Dict<text, i64> = {}
        var took_some = false
        match cache.get("absent"):
            case Some(_): took_some = true
            case _: took_some = false
        expect(took_some).to_equal(false)

describe "Dict.get raw-or-nil consumers stay unchanged":
    it "?? falls back on a miss and passes through on a hit":
        var cache: Dict<text, text> = {}
        cache["k"] = "value"
        expect(cache.get("k") ?? "fallback").to_equal("value")
        expect(cache.get("absent") ?? "fallback").to_equal("fallback")

    it "== nil / != nil still classify hit vs miss":
        var cache: Dict<text, text> = {}
        cache["k"] = "value"
        expect(cache.get("k") != nil).to_equal(true)
        expect(cache.get("absent") == nil).to_equal(true)

    it "if val binds the raw payload on a hit":
        var cache: Dict<text, i64> = {}
        cache["k"] = 11
        var seen = 0
        if val v = cache.get("k"):
            seen = v
        expect(seen).to_equal(11)

    it "if val skips on a miss":
        var cache: Dict<text, i64> = {}
        var ran = false
        if val v = cache.get("absent"):
            ran = true
        expect(ran).to_equal(false)

    it "get_or still returns the default on a miss":
        var cache: Dict<text, text> = {}
        cache["k"] = "value"
        expect(cache.get_or("k", "d")).to_equal("value")
        expect(cache.get_or("absent", "d")).to_equal("d")

describe "boxed enum matching is unaffected":
    it "matches a boxed nullary variant without binding it":
        val s = Shape.Circle
        var name = "unset"
        match s:
            case Circle: name = "circle"
            case Square: name = "square"
        expect(name).to_equal("circle")

    it "still binds a genuine binding pattern as a catch-all":
        val s = Shape.Square
        var bound = "unset"
        match s:
            case Circle: bound = "circle"
            case other: bound = "bound"
        expect(bound).to_equal("bound")

    it "matches a boxed Result payload":
        val r: Result<i64, text> = Ok(5)
        var got = 0
        match r:
            case Ok(v): got = v
            case Err(_): got = -1
        expect(got).to_equal(5)
