# Regression spec: the `in` / `not in` membership operators returned the WRONG
# ANSWER under the Cranelift JIT for a member that was present.
#
#   2 in [1, 2, 3]      -> false      (should be true)
#   1 in {1: 10}        -> false      (should be true)
#   2.5 in [1.5, 2.5]   -> false      (should be true)
#   "zzz" not in "hay"  -> printed "nil" instead of true
#
# Text needles were unaffected, which is why this survived: only a needle that
# is a raw scalar (int / float / bool) missed.
#
# Root causes (all three in the Rust seed, see
# doc/08_tracking/bug/jit_in_operator_unboxed_needle_2026-08-01.md):
#  1. codegen/instr/core.rs `BinOp::In` passed the needle to `rt_contains`
#     UNBOXED, while `.contains()` boxes it. rt_contains compares elements with
#     rt_value_eq against tagged RuntimeValues, so a raw i64 never matched.
#  2. hir/lower/expr/operators.rs omitted `NotIn` from the BOOL result-type
#     list, so `x not in y` was typed as the left operand and printing it
#     decoded the raw 0/1 as a heap handle.
#  3. The boxing helper named symbols (`rt_box_int` / `rt_box_float`) that do
#     not exist in the runtime at all, so the JIT dropped the WHOLE MODULE to
#     the interpreter instead of failing.
#
# CAVEAT ON THIS SPEC: `bin/simple test` runs the tree-walk INTERPRETER, and the
# interpreter was always correct here. These assertions therefore pin the
# contract but do NOT re-measure the JIT. The JIT gate is:
#   SIMPLE_JIT_STRICT=1 src/compiler_rust/target/release/simple <probe>.spl
# which must neither print a jit-fallback line nor answer false for a present
# member.

describe "in operator membership":
    it "finds an i64 element at the first position":
        val a: [i64] = [10, 20, 30]
        assert_true(10 in a)

    it "finds an i64 element in the middle":
        val a: [i64] = [10, 20, 30]
        assert_true(20 in a)

    it "finds an i64 element at the last position":
        val a: [i64] = [10, 20, 30]
        assert_true(30 in a)

    it "rejects an absent i64 element":
        val a: [i64] = [10, 20, 30]
        assert_false(99 in a)

    it "finds an i64 element held in a variable":
        val a: [i64] = [10, 20, 30]
        val needle = 20
        assert_true(needle in a)

    it "agrees with contains on i64 presence":
        val a: [i64] = [10, 20, 30]
        assert_equal(20 in a, a.contains(20))
        assert_equal(99 in a, a.contains(99))

    it "finds a zero element, which a shifted-tag compare matches by accident":
        val z: [i64] = [0, 0, 0]
        assert_true(0 in z)

    it "finds an f64 element":
        val f: [f64] = [1.5, 2.5]
        assert_true(2.5 in f)
        assert_false(9.5 in f)

    it "finds a bool element":
        val b: [bool] = [true, false]
        assert_true(true in b)

    it "finds a text element by value, not identity":
        val t: [text] = ["alpha", "beta"]
        val needle = "be" + "ta"
        assert_true(needle in t)
        assert_false("gamma" in t)

    it "finds an i64 dict key":
        val d = {1: 10, 2: 20}
        assert_true(1 in d)
        assert_false(7 in d)

    it "finds a text dict key built at runtime":
        val d = {"k1": 10, "k2": 20}
        val k = "k" + "1"
        assert_true(k in d)
        assert_false("zz" in d)

    it "finds a substring in text":
        val hay = "hello world"
        assert_true("world" in hay)
        assert_false("zzz" in hay)

    it "finds a substring when both sides are built at runtime":
        val hay = "hello" + " world"
        val needle = "wor" + "ld"
        assert_true(needle in hay)

describe "not in operator membership":
    it "is true for an absent text needle":
        val hay = "hello world"
        assert_true("zzz" not in hay)

    it "is false for a present text needle":
        val hay = "hello world"
        assert_false("world" not in hay)

    it "is true for an absent i64 element":
        val a: [i64] = [10, 20, 30]
        assert_true(99 not in a)

    it "is false for a present i64 element":
        val a: [i64] = [10, 20, 30]
        assert_false(20 not in a)

    it "renders as a bool, not as a decoded heap handle":
        val hay = "hello world"
        val absent = "zzz" not in hay
        assert_equal(absent.to_text(), "true")
        val present = "world" not in hay
        assert_equal(present.to_text(), "false")

    it "is the exact negation of in":
        val a: [i64] = [10, 20, 30]
        assert_equal(20 not in a, not (20 in a))
        assert_equal(99 not in a, not (99 in a))
