# Regression: binary/octal literals lost their type suffix in CoreLexer.
#
# `scan_number` in src/compiler/10.frontend/core/lexer_struct.spl had a suffix
# scan in the hex branch and in the decimal branch, but NOT in the `0b` and
# `0o` branches. So `0b1010u64` lexed as INT("0b1010") followed by a separate
# IDENT("u64"), and `0o644u32` likewise — a token SPLIT, not just a lost
# suffix. Both forms are used in tree (src/os/apps/coreutils/cp.spl:15
# `0o644u32`, test/01_unit/os/posix/signal_compat_spec.spl:17 `0b1010u64`).
#
# The hex cases below are the discriminator: they exercise the exact same
# accessors and call shape and were already GREEN, so a failure limited to the
# 0b/0o rows cannot be a harness artifact.
#
# The 0..64 digit caps in the three radix branches were also `for i in 0..64`
# while decimal used `while true`, truncating a long underscore-separated
# binary literal; covered by the last example.

use compiler.frontend.core.lexer_struct.{CoreLexer, make_core_lexer, core_lexer_next_token, core_lexer_token_text, core_lexer_last_suffix_get}
use compiler.frontend.core.tokens.{TOK_EOF, TOK_INT_LIT, TOK_SUFFIXED_INT}

describe "Lexer radix literal suffixes":

    # Render the whole token stream as `<kind>:<text>[/<suffix>]|...` so one
    # expect() pins the token split, each token's text, and the suffix channel.
    fn lex_render(src: text) -> text:
        var lx: CoreLexer = make_core_lexer(src)
        var out: text = ""
        var seen: i64 = 0
        for i in 0..20:
            val r = core_lexer_next_token(lx)
            lx = r.0
            val k: i64 = r.1
            if k == 0 or k == TOK_EOF:
                break
            val suf: text = core_lexer_last_suffix_get()
            if seen > 0:
                out = out + "|"
            out = out + k.to_text() + ":" + core_lexer_token_text(lx)
            if suf != "":
                out = out + "/" + suf
            seen = seen + 1
        return out

    fn one_int(body: text) -> text:
        return TOK_INT_LIT.to_text() + ":" + body

    fn one_suffixed(body: text, suf: text) -> text:
        return TOK_SUFFIXED_INT.to_text() + ":" + body + "/" + suf

    # --- discriminator: hex was already correct ---

    it "keeps a hex literal's type suffix on one token":
        expect(lex_render("0x1010u64")).to_equal(one_suffixed("0x1010", "u64"))

    it "keeps a hex literal's underscore-form suffix on one token":
        expect(lex_render("0x1010_u64")).to_equal(one_suffixed("0x1010", "u64"))

    # --- the bug: binary ---

    it "keeps a binary literal's type suffix on one token":
        expect(lex_render("0b1010u64")).to_equal(one_suffixed("0b1010", "u64"))

    it "keeps a binary literal's underscore-form suffix on one token":
        expect(lex_render("0b1010_u64")).to_equal(one_suffixed("0b1010", "u64"))

    # --- the bug: octal ---

    it "keeps an octal literal's type suffix on one token":
        expect(lex_render("0o644u32")).to_equal(one_suffixed("0o644", "u32"))

    it "keeps an octal literal's underscore-form suffix on one token":
        expect(lex_render("0o755_u32")).to_equal(one_suffixed("0o755", "u32"))

    # --- unsuffixed forms must stay plain ints ---

    it "leaves an unsuffixed binary literal a plain int":
        expect(lex_render("0b1010")).to_equal(one_int("0b1010"))

    it "leaves an unsuffixed octal literal a plain int":
        expect(lex_render("0o644")).to_equal(one_int("0o644"))

    # --- digit-run length: the 0..64 cap truncated long literals ---

    it "consumes a full 64-bit binary literal with underscore separators":
        # 8 groups of 8 bits = 71 chars after `0b`, past the old 64 cap.
        val body = "0b11111111_00000000_11111111_00000000_11111111_00000000_11111111_00000001"
        expect(lex_render(body)).to_equal(one_int(body))
