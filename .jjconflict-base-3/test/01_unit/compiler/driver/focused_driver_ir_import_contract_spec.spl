use std.spec
use std.nogc_sync_mut.io.file_ops.{file_read}

describe "focused driver IR import contract":
    it "does not retain unused HIR or MIR owners":
        val driver = file_read("src/compiler/80.driver/driver.spl")
        expect(driver.contains("use compiler.hir.hir.*")).to_equal(false)
        expect(driver.contains("use compiler.mir.mir.*")).to_equal(false)
        expect(driver.contains("use compiler.hir.hir_types.")).to_equal(false)
        expect(driver.contains("use compiler.mir.mir_instructions.")).to_equal(false)
        expect(driver.contains("use compiler.backend.sffi.*")).to_equal(false)
        expect(driver.contains("use compiler.common.config.*")).to_equal(false)
        expect(driver.contains("use driver_types.*")).to_equal(false)
        expect(driver).to_contain("use compiler.driver.driver_types.")
        expect(driver).to_contain("use compiler.common.driver_core_types.")
