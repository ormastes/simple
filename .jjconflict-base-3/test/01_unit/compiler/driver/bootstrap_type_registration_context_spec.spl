"""
# Bootstrap Type Registration Context

Requires unsupported flat-HIR field types to retain their owning struct and
field in Stage 3 diagnostics.
"""

extern fn rt_file_read_text(path: text) -> text

describe "Bootstrap Type Registration Context":
    it "reports the struct and field when MIR type lowering fails":
        val source = rt_file_read_text(
            "src/compiler/50.mir/_MirLowering/module_lowering.spl") ?? ""
        expect(source).to_contain(
            "[bootstrap-type-registration] struct={{struct_def.name}} field={{hir_field.name}}")
        expect(source).to_contain("val errors_before = self.errors.len()")
        expect(source).to_contain("if self.errors.len() > errors_before:")
