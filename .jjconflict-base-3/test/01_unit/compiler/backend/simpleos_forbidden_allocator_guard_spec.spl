use std.spec.*
use compiler.backend.backend.llvm_native_link.{
    simpleos_forbidden_allocator_symbols_from_names,
    simpleos_check_no_forbidden_allocator_names,
}

fn step_classify_allocator_symbols(names: [text]) -> [text]:
    step("Classify exact forbidden allocator symbols for a SimpleOS flight closure")
    simpleos_forbidden_allocator_symbols_from_names(names)

describe "SimpleOS forbidden allocator link guard":
    it "rejects exact host and runtime allocator symbols":
        val hits = step_classify_allocator_symbols(["malloc", "rt_alloc", "mimalloc_alloc"])
        expect(hits.len()).to_equal(3)
        expect(hits).to_contain("malloc")
        expect(hits).to_contain("rt_alloc")
        expect(hits).to_contain("mimalloc_alloc")

    it "normalizes Mach-O and glibc symbol decorations":
        val hits = step_classify_allocator_symbols(["_calloc", "free@GLIBC_2.2.5"])
        expect(hits.len()).to_equal(2)
        expect(hits).to_contain("calloc")
        expect(hits).to_contain("free")

    it "does not reject names that only contain allocator substrings":
        val hits = step_classify_allocator_symbols(["my_malloc_wrapper_free", "malloc_stats_print", "rt_memcpy"])
        expect(hits.len()).to_equal(0)

    it "deduplicates repeated forbidden symbols in first-seen order":
        val hits = step_classify_allocator_symbols(["malloc", "_malloc", "mmap", "malloc@GLIBC_2.2.5"])
        expect(hits.len()).to_equal(2)
        expect(hits[0]).to_equal("malloc")
        expect(hits[1]).to_equal("mmap")

    it "skips enforcement outside a flight closure":
        val result = simpleos_check_no_forbidden_allocator_names(["malloc"], ["mmap"], false)
        match result:
            case Ok(clean): expect(clean).to_equal(true)
            case Err(_): expect(false).to_equal(true)

    it "rejects forbidden symbols from either user or support objects in a flight closure":
        val user_result = simpleos_check_no_forbidden_allocator_names(["rt_alloc"], ["rt_memcpy"], true)
        val support_result = simpleos_check_no_forbidden_allocator_names(["rt_memcpy"], ["aligned_alloc"], true)
        match user_result:
            case Err(message): expect(message).to_contain("rt_alloc")
            case Ok(_): expect(false).to_equal(true)
        match support_result:
            case Err(message): expect(message).to_contain("aligned_alloc")
            case Ok(_): expect(false).to_equal(true)

    it "accepts a clean combined user and support closure":
        val result = simpleos_check_no_forbidden_allocator_names(["rt_memcpy"], ["write", "close"], true)
        match result:
            case Ok(clean): expect(clean).to_equal(true)
            case Err(_): expect(false).to_equal(true)
