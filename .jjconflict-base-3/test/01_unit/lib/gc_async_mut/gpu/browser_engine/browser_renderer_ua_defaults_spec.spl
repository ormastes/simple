use std.spec.*

use std.gc_async_mut.gpu.browser_engine.browser_renderer.{render_html_to_pixels_with_viewport}

fn count_changed(pixels: [u32], width: i32, x: i32, y: i32, w: i32, h: i32) -> i32:
    var count: i32 = 0
    var row: i32 = y
    while row < y + h:
        var col: i32 = x
        while col < x + w:
            if pixels[row * width + col] != 0xFFFFFFFFu32:
                count = count + 1
            col = col + 1
        row = row + 1
    count

describe "browser UA defaults":

    it "renders blockquote inline margins":
        val html = "<html><body style='margin:0;background:#fff'><blockquote style='margin-top:0;margin-bottom:0;height:8px;background:#dc2626'></blockquote></body></html>"
        val pixels = render_html_to_pixels_with_viewport(html, 96, 16).pixel_data

        expect(pixels[0]).to_equal(0xFFFFFFFFu32)
        expect(pixels[40]).to_equal(0xFFDC2626u32)

    it "renders preformatted leading whitespace":
        val pre = render_html_to_pixels_with_viewport("<html><body style='margin:0;background:#fff'><pre style='margin:0'>    X</pre></body></html>", 64, 24).pixel_data
        val normal = render_html_to_pixels_with_viewport("<html><body style='margin:0;background:#fff'><div>    X</div></body></html>", 64, 24).pixel_data

        expect(count_changed(pre, 64, 0, 0, 18, 16)).to_equal(0)
        expect(count_changed(normal, 64, 0, 0, 18, 16)).to_be_greater_than(0)
