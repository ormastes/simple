# Runnable probe for the bus-infrastructure RTL lot: generates the AXI4 memory
# adapter XLEN pair, the AXI4-Lite ctrl/observation slave, and the BRAM-only
# SoC top, and byte-compares each against its silicon-proven golden.
# Run: bin/simple run test/01_unit/lib/hardware/vhdl_gen/probe_bus_infra_gen.spl

use std.hardware.riscv_common.xlen.XlenConfig
use std.hardware.vhdl_gen.axi4_mem_adapter_gen.{generate_axi4_mem_adapter, generate_rv32_axi4_mem_adapter, generate_rv64_axi4_mem_adapter}
use std.hardware.vhdl_gen.ctrl_obs_slave_gen.{generate_ctrl_obs_slave}
use std.hardware.vhdl_gen.bram_soc_gen.{generate_bram_soc}

extern fn rt_file_read_text(path: text) -> text

fn check(name: text, ok: bool) -> i64:
    if ok:
        print("PASS " + name)
        0
    else:
        print("FAIL " + name)
        1

fn first_diff(a: text, b: text) -> text:
    val al = a.split("\n")
    val bl = b.split("\n")
    var n = al.len()
    if bl.len() < n:
        n = bl.len()
    var bad = -1
    var i = 0
    while i < n:
        if bad < 0 and al[i] != bl[i]:
            bad = i
        i = i + 1
    if bad < 0:
        return "line count " + al.len().to_text() + " vs " + bl.len().to_text()
    "line " + (bad + 1).to_text() + "\n  got: [" + al[bad] + "]\n  exp: [" + bl[bad] + "]"

fn cmp(name: text, got: text, golden: text) -> i64:
    if got == golden:
        print("PASS " + name)
        0
    else:
        print("FAIL " + name + " -> " + first_diff(got, golden))
        1

fn main():
    var fails = 0
    val rtl = "examples/09_embedded/fpga_riscv/rtl/"
    val g_a32 = rt_file_read_text(rtl + "rv32_axi4_mem_adapter.vhd")
    val g_a64 = rt_file_read_text(rtl + "rv64_axi4_mem_adapter.vhd")
    val a32 = generate_rv32_axi4_mem_adapter()
    val a64 = generate_rv64_axi4_mem_adapter()
    fails = fails + cmp("rv32_axi4_mem_adapter.vhd byte-identical", a32, g_a32)
    fails = fails + cmp("rv64_axi4_mem_adapter.vhd byte-identical", a64, g_a64)
    val a32b = generate_axi4_mem_adapter(XlenConfig.rv32())
    val a64b = generate_axi4_mem_adapter(XlenConfig.rv64())
    fails = fails + check("determinism rv32_axi4_mem_adapter", a32 == a32b)
    fails = fails + check("determinism rv64_axi4_mem_adapter", a64 == a64b)
    val g_cobs = rt_file_read_text(rtl + "rv32_ctrl_obs_slave.vhd")
    val cobs = generate_ctrl_obs_slave()
    fails = fails + cmp("rv32_ctrl_obs_slave.vhd byte-identical", cobs, g_cobs)
    fails = fails + check("determinism rv32_ctrl_obs_slave", cobs == generate_ctrl_obs_slave())
    val g_soc = rt_file_read_text(rtl + "rv32_bram_soc.vhd")
    val soc = generate_bram_soc()
    fails = fails + cmp("rv32_bram_soc.vhd byte-identical", soc, g_soc)
    fails = fails + check("determinism rv32_bram_soc", soc == generate_bram_soc())
    if fails == 0:
        print("BUS_INFRA_GEN PROBE: ALL PASS")
    else:
        print("BUS_INFRA_GEN PROBE: " + fails.to_text() + " FAILURES")
