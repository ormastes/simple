# Memory introspection extern parity — asserts the 7 rt_mem_* externs wired
# into src/compiler/70.backend/backend/interpreter_calls.spl (interpreter
# builtin dispatch) and src/compiler_rust/compiler/src/interpreter_extern/
# (Rust seed dispatch) are callable and behave sanely from Simple source.
#
# Covers: rt_mem_attr_enabled, rt_mem_attr_set_owner, rt_mem_attr_report_print,
# rt_mem_guard_stats, rt_mem_harden_check, rt_mem_profile_abi_version,
# rt_mem_profile_features.

extern fn rt_mem_attr_enabled() -> i64
extern fn rt_mem_attr_set_owner(name: text)
extern fn rt_mem_attr_report_print(n: i64)
extern fn rt_mem_guard_stats() -> i64
extern fn rt_mem_harden_check() -> i64
extern fn rt_mem_profile_abi_version() -> i64
extern fn rt_mem_profile_features() -> i64

use std.spec.{describe, it, expect}

describe "memory introspection extern parity":
    it "rt_mem_profile_abi_version is callable and returns the current ABI version":
        val v = rt_mem_profile_abi_version()
        expect(v).to_equal(1)

    it "rt_mem_profile_features is callable and returns a non-negative bitmask":
        val f = rt_mem_profile_features()
        expect(f >= 0).to_equal(true)

    it "rt_mem_attr_enabled is callable and returns 0 or 1":
        val e = rt_mem_attr_enabled()
        expect(e == 0 or e == 1).to_equal(true)

    it "rt_mem_guard_stats is callable and returns a non-negative sampled count":
        val g = rt_mem_guard_stats()
        expect(g >= 0).to_equal(true)

    it "rt_mem_harden_check is callable and returns a non-negative tamper count":
        val h = rt_mem_harden_check()
        expect(h >= 0).to_equal(true)

    it "rt_mem_attr_set_owner is callable with a text owner label and does not crash":
        rt_mem_attr_set_owner("mem_extern_parity_spec")
        expect(true).to_equal(true)

    it "rt_mem_attr_report_print is callable and does not crash":
        rt_mem_attr_report_print(4)
        expect(true).to_equal(true)
