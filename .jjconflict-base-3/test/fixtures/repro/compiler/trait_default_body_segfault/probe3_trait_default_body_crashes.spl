# Repro: a trait method with a DEFAULT BODY that calls other trait methods
# (both `me`- and `fn`-declared) SIGSEGVs (exit 139) when invoked through a
# trait-object-typed binding, under the default Cranelift JIT engine
# (`bin/simple run`) on the self-hosted binary.
#
# Bug: doc/08_tracking/bug/trait_default_body_segfaults_via_trait_object_2026-08-06.md
#
# The original bug report's `probe3.spl`/`probe4.spl` did not exist on disk
# when this bug was investigated on 2026-08-06 (only inline source in the
# doc survived). This file is a self-contained reconstruction: same shape
# (trait default body dispatching through a trait-object binding, calling
# both a `me` method and `fn` methods on `self`, with enum-payload
# destructuring), but using local types instead of the OS input-driver types
# from the original probe, so it has no `os.*`/`common.ui.*` import
# dependencies and can be run standalone:
#
#   bin/simple run test/fixtures/repro/compiler/trait_default_body_segfault/probe3_trait_default_body_crashes.spl
#
# Expected (per the bug): SIGSEGV / exit 139 on the `b.poll_event()` call
# line, with everything before it printed correctly ("ctrl=true" then
# "char=t"). See probe4_free_function_ok.spl for the control: identical
# logic moved into a free function taking the trait object as a parameter,
# which is NOT expected to crash.
#
# IMPORTANT: this only reproduces under a genuinely working self-hosted,
# `run`-capable (JIT) binary. As of this investigation, no such binary was
# available in the shared working copy — see the bug doc's "Investigation
# notes (2026-08-06)" section for why, before assuming a clean run here
# means the bug is fixed.

enum Key:
    T
    Other

enum KeyEvent:
    Press(Key)
    Release(Key)

enum MouseEvent:
    Move(int, int)

enum HostEvent:
    KeyEv(text, bool, bool, bool)
    MouseEv(int, int)

fn make_key_event(key_event: KeyEvent, ch: text, shift: bool, ctrl: bool, alt: bool) -> HostEvent?:
    Some(HostEvent.KeyEv(ch, shift, ctrl, alt))

fn make_mouse_event(m: MouseEvent) -> HostEvent?:
    if val Move(x, y) = m:
        return Some(HostEvent.MouseEv(x, y))
    nil

trait Backend:
    me poll_key() -> KeyEvent?
    me poll_mouse() -> MouseEvent?
    fn alt_held() -> bool
    fn shift_held() -> bool
    fn ctrl_held() -> bool
    fn key_to_char(key: Key) -> text?

    me poll_event() -> HostEvent?:
        val key_opt: KeyEvent? = self.poll_key()
        if val key_event = key_opt:
            var ch = ""
            if val Press(pressed_key) = key_event:
                if val Some(c) = self.key_to_char(pressed_key):
                    ch = c
            return make_key_event(
                key_event, ch,
                self.shift_held(), self.ctrl_held(), self.alt_held()
            )
        val mouse_opt: MouseEvent? = self.poll_mouse()
        if val mouse_event = mouse_opt:
            return make_mouse_event(mouse_event)
        nil

class SI:
    ch: text

impl Backend for SI:
    me poll_key() -> KeyEvent?:
        Some(KeyEvent.Press(Key.T))

    me poll_mouse() -> MouseEvent?:
        nil

    fn alt_held() -> bool:
        true

    fn shift_held() -> bool:
        false

    fn ctrl_held() -> bool:
        true

    fn key_to_char(key: Key) -> text?:
        Some(self.ch)

fn main():
    val b: Backend = SI(ch: "t")
    print("ctrl=" + b.ctrl_held().to_text())
    if val Some(c) = b.key_to_char(Key.T):
        print("char=" + c)
    val ev = b.poll_event()  # <-- SIGSEGV here, per the bug report
    print("done")
