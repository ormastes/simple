# ============================================================================
# test/fixtures/structural/query_golden_v1.spl
#
# GOLDEN VECTORS for the frozen QueryIR bytecode / capture format contract v1.
#
# Every hex string below was derived BY HAND from the frozen layout in
# doc/05_design/platform/structural_compute/query_contract_v1.md, not captured
# from encoder output. That is what makes them an oracle: the spec asserts
# encoder output EQUALS these bytes, so a codec regression cannot silently
# redefine the contract. A round-trip test would pass a symmetric encode/decode
# defect straight through; these vectors will not.
#
# Follows the golden-vector convention established by the ID-TAG lane in
# identity_tagmap_golden_v1.spl and the MAP lane in mapping_golden_v1.spl: pure
# data, no file I/O, lowercase unseparated hex, one vector per record shape plus
# zero and maximum edge cases, mirrored byte for byte in the sibling .sdn, never
# edited in place.
#
# Envelope = magic(4 ASCII, LE) | version u16 | reserved u16.
#   "SQOP" = 53 51 4f 50   QueryOp        -> 53514f5001000000
#   "SQCP" = 53 51 43 50   CaptureSlot    -> 5351435001000000
#   "SQSV" = 53 51 53 56   EntitySetView  -> 5351535601000000
#   "SQPG" = 53 51 50 47   QueryProgram   -> 5351504701000000
#
# QueryOp body, 18 bytes, no padding:
#   kind u8 | reserved u8 | input_a u32 | input_b u32 | operand u32
#   | constant u32
# Absent operand / constant = 0xffffffff -> ffffffff.
# ============================================================================

# ----------------------------------------------------------------------------
# QueryOp
# ----------------------------------------------------------------------------

# QueryOp(SeedAll = 0, no inputs, no operand, no constant) — zero-opcode case.
# Every u32 slot is the absent sentinel, which is the only op with no arena
# dependency at all.
val GOLDEN_OP_SEED_ALL: text =
    "53514f5001000000"
        + "00"
        + "00"
        + "ffffffff"
        + "ffffffff"
        + "ffffffff"
        + "ffffffff"

# QueryOp(Intersect = 15 = 0x0f, input_a = 0, input_b = 1). The only op class
# that carries a second input; asymmetric inputs so a field-order error cannot
# pass.
val GOLDEN_OP_INTERSECT: text =
    "53514f5001000000"
        + "0f"
        + "00"
        + "00000000"
        + "01000000"
        + "ffffffff"
        + "ffffffff"

# QueryOp(TraverseMapping = 13 = 0x0d, input_a = 1, operand = 0 depth-unbounded,
# constant = 2). The constant slot is where the MappingKindSet mask for
# section 6.4's forward(entity, kind_mask) lives; a u32 mask does not fit in the
# inline operand together with a depth bound, which is why the constant arena
# exists.
val GOLDEN_OP_TRAVERSE_MAPPING: text =
    "53514f5001000000"
        + "0d"
        + "00"
        + "01000000"
        + "ffffffff"
        + "00000000"
        + "02000000"

# QueryOp with the MAXIMUM opcode (Limit = 21 = 0x15), input_a = 3,
# operand = 64 = 0x40. Pins the top of the enum: adding a 23rd opcode without a
# version bump changes what this byte means.
val GOLDEN_OP_LIMIT_MAX: text =
    "53514f5001000000"
        + "15"
        + "00"
        + "03000000"
        + "ffffffff"
        + "40000000"
        + "ffffffff"

# ----------------------------------------------------------------------------
# CaptureSlot — name u32 | kind u8 | reserved u8.
# ----------------------------------------------------------------------------

# CaptureSlot(name = 7, Entity = 0) — the section 7.6 Capture(join_point) shape.
val GOLDEN_CAPTURE_SLOT_ENTITY: text =
    "5351435001000000" + "07000000" + "00" + "00"

# CaptureSlot(name = 0x11223344, EntitySet = 1) — asymmetric name so a byte
# order error in the interned-string id cannot pass, plus the maximum
# CaptureKind discriminant.
val GOLDEN_CAPTURE_SLOT_SET: text =
    "5351435001000000" + "44332211" + "01" + "00"

# ----------------------------------------------------------------------------
# EntitySetView — object_slot u32 | offset u32 | count u32 | order u8.
# 13 bytes, no padding.
# ----------------------------------------------------------------------------

# The empty view: slot 0, offset 0, count 0, Unordered.
val GOLDEN_VIEW_EMPTY: text =
    "5351535601000000"
        + "00000000" + "00000000" + "00000000" + "00"

# EntitySetView(object_slot = 1, offset = 2, count = 3, StableSourceOrder = 2).
# Distinct value in every field, and the maximum EntitySetOrder discriminant.
val GOLDEN_VIEW_BASIC: text =
    "5351535601000000"
        + "01000000" + "02000000" + "03000000" + "02"

# ----------------------------------------------------------------------------
# QueryProgram
#
# Header after the envelope, 22 bytes:
#   dialect u8 | schema_version u32 | determinism u8 | index_requirements u32
#   | op_count u32 | const_count u32 | capture_count u32
# then op_count QueryOp bodies, then const_count u64 constants,
# then capture_count CaptureSlot bodies.
#
# The three counts sit together ahead of all three runs so a decoder can bound
# every variable region before allocating for any of them.
# ----------------------------------------------------------------------------

# Minimal legal program: dialect Syntax(0), schema_version 1,
# determinism SetDeterministic(0), no index requirement, one SeedAll op.
# An op arena is never empty — a program with no ops has no result set — so this
# single-seed form is the smallest thing the encoder will emit.
val GOLDEN_PROGRAM_MINIMAL: text =
    "5351504701000000"
        + "00"
        + "01000000"
        + "00"
        + "00000000"
        + "01000000"
        + "00000000"
        + "00000000"
        + "00" + "00" + "ffffffff" + "ffffffff" + "ffffffff" + "ffffffff"

# The section 7.6 AOP example
#
#   pc{ execution(* service.*(..)) & attr(transactional) }
#
# compiled to a straight-line arena. Section 7.6 writes the filters as
# Intersect(Filter...); applying a filter to the running set IS that
# intersection, so the arena chains unary filters and reserves the binary
# Intersect opcode for two independently seeded sets (see the CSS vector).
#
#   op0  SeedTag(2)      constant 0 = TagKeyId aop.join.execution
#   op1  FilterName(6)   input 0, constant 1 = interned service.*
#   op2  FilterTag(5)    input 1, constant 2 = aop.attr / transactional
#   op3  Capture(0x13)   input 2, operand 0 = capture slot 0
#
# dialect Semantic(1); determinism CaptureDeterministic(2), because the program
# captures and section 30.4 requires stable capture order; index_requirements
# = SPARSE_RECORDS(4) | INVERTED_QUERY(8) = 12 = 0x0c, since section 5.3 stores
# aop.attr as sparse records and a name lookup needs the inverted index.
#
# constant 0 = 0x1122334455667788 -> LE 8877665544332211, asymmetric so a u64
# byte-order error in the constant arena cannot pass.
val GOLDEN_PROGRAM_AOP: text =
    "5351504701000000"
        + "01"
        + "01000000"
        + "02"
        + "0c000000"
        + "04000000"
        + "03000000"
        + "01000000"
        + "02" + "00" + "ffffffff" + "ffffffff" + "ffffffff" + "00000000"
        + "06" + "00" + "00000000" + "ffffffff" + "ffffffff" + "01000000"
        + "05" + "00" + "01000000" + "ffffffff" + "ffffffff" + "02000000"
        + "13" + "00" + "02000000" + "ffffffff" + "00000000" + "ffffffff"
        + "8877665544332211"
        + "0200000000000000"
        + "0300000000000000"
        + "09000000" + "00" + "00"

# The section 7.7 CSS example .panel > button.primary:hover, whose stated
# compilation is
#
#   seed: class(primary) INTERSECT tag(button)
#   filter: pseudo(hover)
#   traverse parent
#   filter: class(panel)
#
# as an arena:
#
#   op0  SeedTagValue(3)    constant 0 = css.class / primary
#   op1  SeedTagValue(3)    constant 1 = dom.tag / button
#   op2  Intersect(0x0f)    inputs 0 and 1
#   op3  FilterTag(5)       input 2, constant 2 = dom.state / hover
#   op4  TraverseParent(8)  input 3, operand 1 = the direct-child combinator's
#                           one-step parent hop
#   op5  FilterTag(5)       input 4, constant 3 = css.class / panel
#   op6  StableSort(0x14)   input 5
#
# A seed at a NON-ZERO arena index (op1) is legal and is exercised here on
# purpose: only op0 is required to be a seed.
#
# dialect CssSelector(6); determinism OrderDeterministic(1) — the program sorts
# but captures nothing; index_requirements = INVERTED_QUERY(8), section 5.3's
# "inverted query index ... class, ID, tag name".
val GOLDEN_PROGRAM_CSS: text =
    "5351504701000000"
        + "06"
        + "01000000"
        + "01"
        + "08000000"
        + "07000000"
        + "04000000"
        + "00000000"
        + "03" + "00" + "ffffffff" + "ffffffff" + "ffffffff" + "00000000"
        + "03" + "00" + "ffffffff" + "ffffffff" + "ffffffff" + "01000000"
        + "0f" + "00" + "00000000" + "01000000" + "ffffffff" + "ffffffff"
        + "05" + "00" + "02000000" + "ffffffff" + "ffffffff" + "02000000"
        + "08" + "00" + "03000000" + "ffffffff" + "01000000" + "ffffffff"
        + "05" + "00" + "04000000" + "ffffffff" + "ffffffff" + "03000000"
        + "14" + "00" + "05000000" + "ffffffff" + "ffffffff" + "ffffffff"
        + "1000000000000000"
        + "1100000000000000"
        + "1200000000000000"
        + "1300000000000000"
