# Default every text file to LF, repo-wide. Without this, files with no
# explicit rule below fall through to core.autocrlf's platform default —
# `true` on a typical Windows checkout, which converts to CRLF on checkout
# for ANY extension not covered here (.sh, .rs, .md, .py, .js, .toml, ...).
# CRLF in a shebang script (`#!/usr/bin/env bash\r`) fails to exec at all;
# CRLF anywhere else is silent repo-wide inconsistency. Only `.bat`/`.cmd`
# (below) are excepted — cmd.exe genuinely misparses LF-only versions of
# those. More specific patterns further down this file win over this one
# (git attributes: last match wins per path), so the exception still applies.
* text=auto eol=lf

# Force LF line endings for Simple language source files.
# CRLF breaks the indentation-sensitive parser.
*.spl text eol=lf
*.shs text eol=lf
*.sdn text eol=lf

# Cargo verifies vendored crate checksums against exact bytes.
src/compiler_rust/vendor/** -text

# Windows batch files must use CRLF — cmd.exe misparses LF-only .cmd files.
*.cmd text eol=crlf
*.bat text eol=crlf

# UI evidence captured for generated SSPEC docs can be large binary data.
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.ppm filter=lfs diff=lfs merge=lfs -text

# Binary packages and checked-in bootstrap executables must never receive
# line-ending conversion or textual diffs in Git/Jujutsu. They remain regular
# tracked artifacts because bootstrap and release workflows consume them.
*.pptx -text -diff
*.zip -text -diff
bin/simple.freebsd -text -diff
bin/simple_native -text -diff
bootstrap/stage*/simple -text -diff
bootstrap/stage*/**/simple -text -diff
release/**/simple -text -diff

# Do not include local development caches or compatibility blobs in git archive exports.
src/app/vscode_extension/node_modules export-ignore
src/app/vscode_extension/.vscode-test export-ignore
src/compiler_rust/target export-ignore
/build export-ignore
/tmp export-ignore
/artifacts export-ignore
/node-compile-cache export-ignore
/system export-ignore
src/verification/generated export-ignore
src/verification/**/.lake export-ignore
config/t32/libXp.so.6 export-ignore
config/t32/libjpeg.so.62.0.0 export-ignore
