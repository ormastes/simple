# RegisterIR — Cosmos+ OpenSSD Tiger4NSC NAND flash controller.
# Single source for src/os/kernel/arch/arm32/cosmos/cosmos_nfc_regs.h.
# Regenerate/verify: bin/simple run src/hardware/ir/register_ir_gen.spl --check
register_block:
  id: cosmos_nfc
  name: "Cosmos+ NAND flash controller (Tiger4NSC v1.1.0)"
  bus: axi_gp0
  endian: little
  base: 0x43C00000
  size: 0x00010000
  array:
    dim: channel
    count: 8
    stride: 0x00010000
  way_count: 8
  clock_domain: pl_clk0
  reset_domain: pl_reset_n
emit:
  target: src/os/kernel/arch/arm32/cosmos/cosmos_nfc_regs.h
  sections:
    - kind: text
      lines:
        - "#ifndef SIMPLE_COSMOS_NFC_REGS_H"
        - "#define SIMPLE_COSMOS_NFC_REGS_H"
        - ""
        - "#include \"cosmos_hal.h\""
        - ""
    - kind: text
      lines:
        - "/*"
        - " * Tiger4NSC/V2F contract from Cosmos-OpenSSD/Cosmos-plus-OpenSSD commit"
        - " * 78601486bb5581e40628ec7e841dea8e97eff034:"
        - " *   source/software/GreedyFTL-3.0.0/nsc_driver.{h,c}"
        - " *   source/software/GreedyFTL-3.0.0/ftl_config.h"
        - " *   source/software/GreedyFTL-3.0.0/request_schedule.c"
        - " *   source/hardware/nfc-substrate/tiger4_nfc_substrate-1.0.0/Dispatcher.v"
        - " *   source/hardware/nfc-substrate/tiger4_nfc_substrate-1.0.0/Decoder.v"
        - " *   source/hardware/nfc-substrate/tiger4_nfc_substrate-1.0.0/"
        - " *     CompletionDataChannel.v"
        - " *   source/hardware/nfc-substrate/tiger4_nfc_substrate-1.0.0/"
        - " *     BCHDecoderOutputControl.v"
        - " *   project/Prebuild/8Ch8Way-3.0.0/OpenSSD2-8C8W-Prebuild-3.0.0.hdf"
        - " * The HDF's OpenSSD2.hwh binds eight Tiger4NSC v1.1.0 instances, eight"
        - " * ways each, at 0x43c00000..0x43c7ffff. The IP exposes no identity register."
        - " * Command values below are uProgROM entry addresses, so they are bitstream"
        - " * specific rather than portable NAND opcodes."
        - " */"
    - kind: defines
      id: block
      defines:
        - name: COSMOS_NFC_CHANNEL0_BASE
          value: "0x43C00000U"
          pad: 46
        - name: COSMOS_NFC_CHANNEL_STRIDE
          value: "0x00010000U"
          pad: 46
        - name: COSMOS_NFC_CHANNEL_COUNT
          value: "8U"
          pad: 46
        - name: COSMOS_NFC_WAY_COUNT
          value: "8U"
          pad: 46
    - kind: text
      lines:
        - ""
    - kind: defines
      id: register_offset
      defines:
        - name: COSMOS_NFC_CMD_SELECT
          value: "0x00U"
          pad: 46
        - name: COSMOS_NFC_ROW_ADDRESS
          value: "0x04U"
          pad: 46
        - name: COSMOS_NFC_USER_DATA
          value: "0x08U"
          pad: 46
        - name: COSMOS_NFC_DATA_ADDRESS
          value: "0x0CU"
          pad: 46
        - name: COSMOS_NFC_SPARE_ADDRESS
          value: "0x10U"
          pad: 46
        - name: COSMOS_NFC_ERROR_COUNT_ADDRESS
          value: "0x14U"
          pad: 46
        - name: COSMOS_NFC_COMPLETION_ADDRESS
          value: "0x18U"
          pad: 46
        - name: COSMOS_NFC_WAY_SELECTION
          value: "0x1CU"
          pad: 46
        - name: COSMOS_NFC_CHANNEL_BUSY
          value: "0x20U"
          pad: 46
        - name: COSMOS_NFC_READY_BUSY
          value: "0x24U"
          pad: 46
        - name: COSMOS_NFC_CONTROLLER_IDLE
          value: "0x2CU"
          pad: 46
    - kind: text
      lines:
        - ""
    - kind: defines
      id: command
      defines:
        - name: COSMOS_NFC_CMD_RESET
          value: "1U"
          pad: 46
        - name: COSMOS_NFC_CMD_SET_FEATURES
          value: "6U"
          pad: 46
        - name: COSMOS_NFC_CMD_READ_PAGE_TRIGGER
          value: "13U"
          pad: 46
        - name: COSMOS_NFC_CMD_READ_PAGE_TRANSFER
          value: "18U"
          pad: 46
        - name: COSMOS_NFC_CMD_READ_PAGE_TRANSFER_RAW
          value: "55U"
          pad: 47
        - name: COSMOS_NFC_CMD_PROGRAM_PAGE
          value: "28U"
          pad: 46
        - name: COSMOS_NFC_CMD_BLOCK_ERASE
          value: "37U"
          pad: 46
        - name: COSMOS_NFC_CMD_STATUS_CHECK
          value: "41U"
          pad: 46
    - kind: text
      lines:
        - ""
    - kind: defines
      id: geometry
      defines:
        - name: COSMOS_NFC_PAGE_DATA_BYTES
          value: "16384U"
          pad: 46
        - name: COSMOS_NFC_PAGE_SPARE_BYTES
          value: "256U"
          pad: 46
        - name: COSMOS_NFC_RAW_ROW_BYTES
          value: "18048U"
          pad: 47
        - name: COSMOS_NFC_ERROR_INFO_WORDS
          value: "11U"
          pad: 46
        - name: COSMOS_NFC_ECC_WARNING_THRESHOLD
          value: "20U"
          pad: 46
        - name: COSMOS_NFC_ROWS_PER_BLOCK
          value: "256U"
          pad: 46
        - name: COSMOS_NFC_LUN0_BASE_ROW
          value: "0x00000000U"
          pad: 47
        - name: COSMOS_NFC_LUN1_BASE_ROW
          value: "0x00200000U"
          pad: 47
        - name: COSMOS_NFC_ROWS_PER_LUN
          value: "0x00105800U"
          pad: 47
    - kind: ifndef_define
      name: COSMOS_NFC_POLL_LIMIT
      value: "COSMOS_POLL_LIMIT"
      pad: 46
    - kind: text
      lines:
        - ""
    - kind: defines
      id: status
      defines:
        - name: COSMOS_NFC_STATUS_REPORT_DONE
          value: "0x1U"
          pad: 46
        - name: COSMOS_NFC_TRANSFER_COMPLETE
          value: "0xA5000001U"
          pad: 46
        - name: COSMOS_NFC_STATUS_COMPLETE_MASK
          value: "0x60U"
          pad: 46
        - name: COSMOS_NFC_STATUS_FAIL_MASK
          value: "0x03U"
          pad: 46
        - name: COSMOS_NFC_ECC_CRC_VALID
          value: "0x10000000U"
          pad: 46
        - name: COSMOS_NFC_ECC_SPARE_VALID
          value: "0x01000000U"
          pad: 46
        - name: COSMOS_NFC_ECC_WORST_MASK
          value: "0x00FF0000U"
          pad: 46
        - name: COSMOS_NFC_ECC_WORST_SHIFT
          value: "16U"
          pad: 46
    - kind: text
      lines:
        - ""
        - "/*"
        - " * The trusted package step may emit this token only after verifying the"
        - " * official HDF bitstream whose OpenSSD2.bit SHA-256 is"
        - " * 66e863b2ff2c0190928e3e71aeba9725551584cffc32854928946b1720cbf5c2."
        - " */"
    - kind: cond_defines
      symbol: COSMOS_NFC_REGISTER_CONTRACT_BOUND
      pad: 44
      base_cond: "defined(COSMOS_NFC_PACKAGE_VERIFIED_OPENSSD2_8C8W_3_0_0)"
      requires: none
    - kind: text
      lines:
        - ""
        - "/*"
        - " * Exact GreedyFTL-3.0.0 memory_map.h pools for the 8-channel/8-way profile."
        - " * Host MMIO tests use the production addresses so range checks cannot pass"
        - " * through a synthetic all-purpose DMA window."
        - " */"
    - kind: guarded_defines
      cond: "defined(COSMOS_MMIO_TEST)"
      id: memory_pool
      defines:
        - name: COSMOS_NFC_NVME_MANAGEMENT_BASE
          value: "0x00200000U"
          pad: 48
          io_contract: false
          default_zero: true
        - name: COSMOS_NFC_NVME_MANAGEMENT_END
          value: "0x002FFFFFU"
          pad: 48
          io_contract: false
          default_zero: true
        - name: COSMOS_NFC_DATA_POOL_BASE
          value: "0x10000000U"
          pad: 48
          io_contract: true
          default_zero: true
        - name: COSMOS_NFC_DATA_POOL_END
          value: "0x110FFFFFU"
          pad: 48
          io_contract: true
          default_zero: true
        - name: COSMOS_NFC_SPARE_POOL_BASE
          value: "0x11100000U"
          pad: 48
          io_contract: true
          default_zero: true
        - name: COSMOS_NFC_SPARE_POOL_END
          value: "0x11143FFFU"
          pad: 48
          io_contract: true
          default_zero: true
        - name: COSMOS_NFC_COMPLETION_POOL_BASE
          value: "0x17000000U"
          pad: 48
          io_contract: true
          default_zero: true
        - name: COSMOS_NFC_COMPLETION_POOL_END
          value: "0x170000FFU"
          pad: 48
          io_contract: true
          default_zero: true
        - name: COSMOS_NFC_STATUS_POOL_BASE
          value: "0x17000100U"
          pad: 48
          io_contract: true
          default_zero: true
        - name: COSMOS_NFC_STATUS_POOL_END
          value: "0x170001FFU"
          pad: 48
          io_contract: true
          default_zero: true
        - name: COSMOS_NFC_ERROR_POOL_BASE
          value: "0x17000200U"
          pad: 48
          io_contract: true
          default_zero: true
        - name: COSMOS_NFC_ERROR_POOL_END
          value: "0x17000CFFU"
          pad: 48
          io_contract: true
          default_zero: true
        - name: COSMOS_NFC_TOGGLE_POOL_BASE
          value: "0x17000D00U"
          pad: 48
          io_contract: true
          default_zero: true
        - name: COSMOS_NFC_TOGGLE_POOL_END
          value: "0x17001CFFU"
          pad: 48
          io_contract: true
          default_zero: true
    - kind: text
      lines:
        - ""
    - kind: cond_defines
      symbol: COSMOS_NFC_IO_CONTRACT_BOUND
      pad: 38
      base_cond: COSMOS_NFC_REGISTER_CONTRACT_BOUND
      requires: io_contract
    - kind: text
      lines:
        - ""
    - kind: ifndef_defaults
      source: memory_pool
      value: "0U"
      pad: 48
    - kind: text
      lines:
        - ""
        - "#define COSMOS_NFC_ERROR_INFO_BYTES \\"
        - "    (COSMOS_NFC_ERROR_INFO_WORDS * sizeof(unsigned int))"
        - ""
        - "struct cosmos_nfc_io {"
        - "    unsigned int channel;"
        - "    unsigned int way;"
        - "    unsigned int row_address;         /* Tiger4NSC consumes 24 bits. */"
        - "    unsigned int data_address;        /* 16 KiB uncached DMA region. */"
        - "    unsigned int spare_address;       /* 256-byte uncached DMA region. */"
        - "    unsigned int error_info_address;  /* Eleven uncached DMA words. */"
        - "    unsigned int completion_address;  /* One uncached DMA word. */"
        - "    unsigned int status_report_address; /* One uncached status word. */"
        - "};"
        - ""
        - "struct cosmos_nfc_ecc {"
        - "    unsigned int crc_valid;           /* Error word 0, bit 28. */"
        - "    unsigned int spare_valid;         /* Error word 0, bit 24. */"
        - "    unsigned int page_valid;          /* Error word 1 is 0xffffffff. */"
        - "    unsigned int worst_chunk_errors;  /* Error word 0, bits 23:16. */"
        - "    unsigned int needs_refresh;       /* GreedyFTL threshold: >20. */"
        - "};"
        - ""
        - "/*"
        - " * Calls are synchronous and serialized per channel. After COSMOS_TIMEOUT, all"
        - " * supplied DMA regions remain globally controller-owned until an explicit"
        - " * SoC/PL hardware reset."
        - " */"
        - "int cosmos_nfc_read_page(const struct cosmos_nfc_io *io,"
        - "                         struct cosmos_nfc_ecc *ecc);"
        - "/*"
        - " * Raw marker read: command 55 DMA-writes one contiguous 18,048-byte NAND row"
        - " * at data_address. spare_address and error_info_address are not consumed."
        - " */"
        - "int cosmos_nfc_read_page_raw(const struct cosmos_nfc_io *io);"
        - "int cosmos_nfc_program_page(const struct cosmos_nfc_io *io);"
        - "int cosmos_nfc_erase_block(unsigned int channel, unsigned int way,"
        - "                           unsigned int row_address,"
        - "                           unsigned int status_report_address);"
        - "int cosmos_nfc_status(unsigned int channel, unsigned int way,"
        - "                      unsigned int status_report_address,"
        - "                      unsigned int *nand_status);"
        - "int cosmos_nfc_decode_ecc(const volatile unsigned int *error_info,"
        - "                          struct cosmos_nfc_ecc *ecc);"
        - ""
        - "#endif"
