# redistributable. This file contains NO specification prose. It carries clause
# identifiers, section numbers, field names, short factual field data, and
# paraphrases generated by src/app/nvme_spec_import from its own controlled
# vocabulary. `source_line` points into a LOCAL copy of the extracted text that
# is deliberately not in this repository.

schema: "simple.nvme.extraction_report.v1"
provenance: "NVM Express Base Specification, Revision 2.3 (2025-08-01, Ratified) - local copy only, not redistributed"
source_text: "/mnt/data/nvme-specs/nvme_base_2.3.txt"
clause_extraction:
  lines_scanned: 73359
  paragraphs: 22238
  headings_recognized: 53
  toc_rows_with_a_section_number: 9
