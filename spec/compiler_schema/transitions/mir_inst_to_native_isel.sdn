# Transition table: MirInstKind -> x86_64 native instruction selection
#
# Boundary: `isel_inst_with_simd`,
# src/compiler/70.backend/backend/native/isel_x86_64.spl
# Producer universe: `enum MirInstKind` (128 variants), enumerated from the
# generated registry spec/compiler_schema/registry/compiler.mir.MirInstKind.sdn.
#
# Lane C7 (backend coverage, hardening plan 2026-08-21 sections 11.3-11.6).
# Before C7, 105 of the 128 variants fell to a terminal `case _:` that emitted a
# NOP -- the instruction was DELETED from the generated machine code and
# execution continued with whatever the missing computation never wrote. They
# now raise a NAMED, spanned E-BACKEND-X86ISEL-INST-<Variant>.
#
# Recorded state verified by source inspection 2026-08-21.

table: mir_inst_to_native_isel
producer: MirInstKind
consumer: X86IselContext
source: src/compiler/70.backend/backend/native/isel_x86_64.spl

