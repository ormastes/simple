# Transition table: MirInstKind -> LLVM text backend (MIR -> .ll emitter)
#
# Boundary: `MirToLlvm.translate_instruction_at`,
# src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl
# Producer universe: `enum MirInstKind` (126 variants), enumerated from the
# generated registry spec/compiler_schema/registry/compiler.mir.MirInstKind.sdn.
#
# Lane C7 (backend coverage, hardening plan 2026-08-21 sections 11.3-11.6).
# Before C7, 32 of the 126 variants fell to a terminal `case _: ()` and were
# SILENTLY DROPPED -- the emitted module simply came out missing the
# instruction. They now raise a NAMED, spanned E-BACKEND-LLVM-INST-<Variant>.
# Const, Copy and LoadGlobal are handled by discriminant-guarded fast paths
# ABOVE the match (they `return` before reaching it), which is why they carry no
# `case` arm; they are recorded implemented here because they are lowered.
#
# Recorded state verified by source inspection 2026-08-21.

table: mir_inst_to_llvm
producer: MirInstKind
consumer: MirToLlvm
source: src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl

