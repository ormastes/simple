# Transition table: HirExprKind -> MIR
#
# Boundary: `MirLowering.lower_expr_impl`,
# src/compiler/50.mir/_MirLoweringExpr/expr_dispatch.spl
# Producer universe: `enum HirExprKind`, src/compiler/20.hir/hir_definitions.spl
# (56 variants), enumerated from the generated registry
# spec/compiler_schema/registry/compiler.hir.HirExprKind.sdn -- not from the
# dispatch itself, which is what makes an omitted arm show up as Missing
# instead of silently disappearing.
#
# Row shape is the shared `transition: from/to/state/reason/test` format defined
# by src/compiler/00.common/transition/ (lane A3). States used here:
#   implemented  -- a dedicated arm lowers this variant to real MIR.
#   unsupported  -- a dedicated arm exists but rejects the variant with its own
#                   NAMED, spanned E-MIR-EXPR-<Variant> diagnostic. NOT omitted
#                   and NOT recorded as implemented: an omission would be
#                   Missing and fail the build, which is the point.
#
# Lane C6 (HIR-expr/stmt -> MIR completeness, hardening plan 2026-08-21
# sections 11.3-11.6). This table records what the lowering ACTUALLY does
# today, not what it should do.
#
# Before C6 the eleven `unsupported` variants below had no arm at all: they fell
# to the terminal `case _:`, which reports `unsupported MIR expression:
# {expr_value.kind}`. That interpolates a heap enum as an opaque `<enum@0x..>`
# handle (the arm's own comment says so), so the variant was never NAMED and the
# construct could not be found. Each now has an explicit arm and its own code.
#
# The terminal `case _:` still exists and is deliberately NOT a row: it is
# unreachable for any well-formed HirExprKind and survives only for a garbage /
# mis-decoded enum handle, which is a different failure with a different
# message (`MIR lowering received a garbage expression handle`).
#
# Nine variants are dispatched TWICE on purpose -- a `rt_enum_discriminant`
# pre-dispatch guard ahead of the main match, because the seed's big match
# mis-binds those payloads (see the stage-3 blocker notes in expr_dispatch.spl).
# The wildcard inside each of those guarded re-matches used to be a silent
# `pass`; as of C6 it raises E-MIR-EXPR-PAYLOAD naming the variant.
#
# Recorded state verified by source inspection 2026-08-21.

table: hir_expr_to_mir
producer: HirExprKind
consumer: MirInstruction
source: src/compiler/50.mir/_MirLoweringExpr/expr_dispatch.spl

universe:
  - ArrayLit
  - ArrayRepeat
  - As
  - Await
  - Binary
  - Block
  - BoolLit
  - Break
  - Call
  - Cast
  - CharLit
  - Comprehension
  - Continue
  - CustomBlock
  - DictLit
  - EnumLit
  - Error
  - ExistsCheck
  - Field
  - FloatLit
  - For
  - HostGpuLane
  - If
  - IfChain
  - Index
  - InlineAsm
  - InlineAsmMatch
  - IntLit
  - Lambda
  - Loop
  - LossBlock
  - MatchCase
  - MethodCall
  - NamedVar
  - NilLit
  - NogradBlock
  - NullCoalesce
  - OptionalChain
  - Range
  - Return
  - SetLit
  - StaticCall
  - StringLit
  - StructLit
  - Throw
  - Try
  - TupleIndex
  - TupleLit
  - Unary
  - UnitLit
  - UnsafeBlock
  - Unwrap
  - Var
  - While
  - With
  - Yield

transition:
  from: HirExprKind.ArrayLit
  to: MirInstruction
  state: implemented
  reason: "dedicated arm in lower_expr_impl"
  test: hir_expr_to_mir_coverage_spec

transition:
  from: HirExprKind.ArrayRepeat
  to: MirInstruction
