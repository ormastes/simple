# Transition table: MirTypeKind -> C backend type mapper
#
# Boundary: `plugins.backend_c.c_type_mapper.CTypeMapper.map_type`,
# delegated to `c_backend_map_type` in the common C ABI mapping owner below.
# Producer universe: `enum MirTypeKind` (29 registry entries -- the integer and
# float families share one registry id each), enumerated from the generated
# registry spec/compiler_schema/registry/compiler.mir.MirTypeKind.sdn.
#
# Lane C7 (backend coverage, hardening plan 2026-08-21 sections 11.3-11.6).
# Before C7 eight variants fell to `case _: "int64_t"` -- the worst shape in the
# file, because int64_t is a perfectly valid C type: a 256-bit vector, a
# scalable vector, an arbitrary-width Bits or a Result silently became a 64-bit
# integer and the generated C compiled and RAN with the wrong representation.
#
# Recorded state verified by source inspection 2026-08-21.

table: mir_type_to_c_backend
producer: MirTypeKind
consumer: CTypeMapper
source: src/compiler/70.backend/backend/common/c_abi_type_mapping.spl

universe:
  - ActorType
  - Array
  - Bits
  - Bool
  - Char
  - Dict
  - Enum
  - F32
  - FuncPtr
  - Generator
  - I8
  - Never
  - Opaque
  - Promise
  - Ptr
  - Ref
  - Result
  - ScalableVec
  - Slice
  - Struct
  - Tuple
  - U8
  - Union
  - Unit
  - Vec4d
  - Vec4f
  - Vec4i
  - Vec8f
  - Vec8i

transition:
  from: MirTypeKind.ActorType
  to: CTypeMapper
  state: implemented
  reason: "dedicated arm maps ActorType to a C type"
  test: mir_type_to_c_backend_coverage_spec

transition:
  from: MirTypeKind.Array
  to: CTypeMapper
  state: implemented
  reason: "dedicated arm maps Array to a C type"
  test: mir_type_to_c_backend_coverage_spec

