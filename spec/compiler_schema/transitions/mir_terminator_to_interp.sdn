# Transition table: MirTerminator -> tree-walk MIR interpreter
#
# Boundary: `MirInterpreter.execute_terminator`, src/compiler/95.interp/mir_interpreter.spl
# Producer universe: `enum MirTerminator` (7 variants), enumerated from the
# generated registry spec/compiler_schema/registry/compiler.mir.MirTerminator.sdn.
#
# Lane C8 (interpreter coverage, hardening plan 2026-08-21 sections 11.3-11.6).
# This is the interpreter's control-flow / statement boundary. All seven
# terminators already had dedicated arms and the match carries no wildcard;
# the table exists so a NEW terminator variant upstream shows up as Missing in
# the transition gate instead of as a runtime match failure.
#
# Recorded state verified by source inspection 2026-08-21.

table: mir_terminator_to_interp
producer: MirTerminator
consumer: MirInterpreter
source: src/compiler/95.interp/mir_interpreter.spl

universe:
  - Abort
  - CallTerminator
  - Goto
  - If
  - Ret
  - Switch
  - Unreachable

transition:
  from: MirTerminator.Abort
  to: MirInterpreter
  state: implemented
  reason: "dedicated arm; raises a RuntimeError carrying the message"
  test: mir_terminator_to_interp_coverage_spec

transition:
  from: MirTerminator.CallTerminator
  to: MirInterpreter
  state: implemented
  reason: "dedicated arm; performs the call, binds dest, continues at the normal block"
  test: mir_terminator_to_interp_coverage_spec

transition:
  from: MirTerminator.Goto
  to: MirInterpreter
  state: implemented
  reason: "dedicated arm; jumps to the target block"
  test: mir_terminator_to_interp_coverage_spec

transition:
  from: MirTerminator.If
  to: MirInterpreter
  state: implemented
  reason: "dedicated arm; branches on a non-zero condition"
  test: mir_terminator_to_interp_coverage_spec

transition:
  from: MirTerminator.Ret
  to: MirInterpreter
  state: implemented
  reason: "dedicated arm; stores the optional value and marks the frame returned"
  test: mir_terminator_to_interp_coverage_spec

transition:
  from: MirTerminator.Switch
  to: MirInterpreter
  state: implemented
  reason: "dedicated arm; linear scan of targets, falls back to the default block"
  test: mir_terminator_to_interp_coverage_spec

transition:
  from: MirTerminator.Unreachable
  to: MirInterpreter
  state: implemented
  reason: "dedicated arm; raises a RuntimeError, never falls through"
  test: mir_terminator_to_interp_coverage_spec

