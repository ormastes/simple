transition:
  from: FlatExprKind.INTERPOLATED_STRING
  to: "ExprKind.StringLit + Interpolation list"
  state: "Normalized(ExprKind.StringLit + Interpolation list)"
  reason: "(flat tag 34) Interpolation is expanded into a StringLit plus an Interpolation list by flat_bridge_build_string_interps."
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_expr_transition_census_spec.spl"

transition:
  from: FlatExprKind.PASS
  to: "ExprKind.NilLit"
  state: "Normalized(ExprKind.NilLit)"
  reason: "(flat tag 35) `pass` is a deliberate no-op; NilLit is the intended target, not a fallback."
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_expr_transition_census_spec.spl"

transition:
  from: FlatExprKind.SUFFIXED_LIT
  to: "ExprKind.Cast(IntLit/FloatLit, suffix type)"
  state: "Normalized(ExprKind.Cast)"
  reason: "(flat tag 36) A suffixed literal becomes a Cast over the bare literal."
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_expr_transition_census_spec.spl"

transition:
  from: FlatExprKind.AWAIT
  to: "ExprKind.Await"
  state: "Implemented"
  reason: "(flat tag 37) Dedicated dispatch arm in convert_flat_expr emits ExprKind.Await, which hir_lowering/expressions.spl handles directly. NOTE (measured): parse_full_frontend runs the async desugar AFTER the bridge, and for a non-async enclosing fn desugar_async.spl:233 rewrites the Await into a plain Call -- so the node observable at the end of parse_full_frontend is a Call, not an Await. That rewrite is downstream of this table."
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_expr_transition_census_spec.spl"

transition:
  from: FlatExprKind.YIELD
  to: "ExprKind.Yield"
