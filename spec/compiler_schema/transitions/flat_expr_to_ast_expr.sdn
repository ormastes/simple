# Flat-AST -> parser-AST transition table for the bootstrap frontend bridge
# (src/compiler/10.frontend/_FlatAstBridge/).
#
# Row shape is the shared `transition: from/to/state/reason/test` format defined
# by src/compiler/00.common/transition/ (lane A3). States:
#   Implemented          -- a dedicated dispatch arm maps this tag onto the
#                           same-named target node.
#   Normalized(target)   -- a dedicated arm maps it onto a DIFFERENT target on
#                           purpose; `to` names the real target.
#   Unsupported(reason)  -- no arm; the node reaches the generic catch-all.
#                           Every such row is LOUD as of lane C2: the fallback
#                           raises a parser_error, so parser_has_errors() goes
#                           true instead of the node vanishing silently.
#   NotApplicable(reason)-- the tag constant exists but nothing ever allocates
#                           the node, so it cannot reach the bridge.
#
# Lane C2 (flat-bridge transition census). Generated from a census of the tag
# constants and of the dispatch arms; keep it in sync when an arm is added.
#
# Source of truth: convert_nodes.spl :: convert_flat_expr (57 tags, 48 arms).
#
# Emitted in the shared reference dialect (flat `transition:` blocks, an
# explicit `universe:` block, lowercase state tags) so
# src/compiler/00.common/transition/transition_table.spl can compute
# Missing = Universe - declared non-vacuously (universe_declared: true).
# The `universe:` list below is EVERY tag constant declared in
# src/compiler/10.frontend/core/_AstExpr/nodes.spl -- 57 of them -- not merely the ones
# this bridge happens to handle, which is what makes an omitted row show
# up as Missing instead of silently disappearing. The numeric flat tag
# lives in each row's `reason:` rather than in `from:`, because the
# loader's variant_name_of() takes the text after the last dot verbatim
# and a ' (tag=N)' suffix would never match a bare universe entry.

table: flat_expr_to_ast_expr
producer: FlatExprKind
consumer: ExprKind
source: src/compiler/10.frontend/_FlatAstBridge/convert_nodes.spl

universe:
  - INT_LIT
  - FLOAT_LIT
  - STRING_LIT
  - BOOL_LIT
  - NIL_LIT
  - IDENT
  - BINARY
  - UNARY
  - CALL
  - INDEX
  - FIELD_ACCESS
  - METHOD_CALL
  - ARRAY_LIT
  - IF
  - MATCH
  - FOR
  - WHILE
  - BLOCK
  - RETURN
  - BREAK
  - CONTINUE
  - RANGE
  - ASSIGN
  - COMPOUND_ASSIGN
  - DICT_LIT
  - LAMBDA
  - STRUCT_LIT
  - TUPLE
  - SLICE
  - NULL_COALESCE
  - OPTIONAL_CHAIN
  - CAST
  - UNIT
  - INTERPOLATED_STRING
  - PASS
  - SUFFIXED_LIT
  - AWAIT
  - YIELD
  - SPAWN
  - PASS_TODO
  - PASS_DO_NOTHING
  - ASYNC_BLOCK
  - PASS_DN
  - DO_BLOCK
  - ATOM
  - SPREAD
  - ASM
  - ASM_MATCH
  - EXISTS_CHECK
  - NEW
  - LIST_COMP
  - DICT_COMP
  - FORCE_UNWRAP
  - TRY
  - ARRAY_REPEAT
  - UNSAFE_BLOCK
  - CUSTOM_BLOCK

transition:
  from: FlatExprKind.INT_LIT
  to: "ExprKind.IntLit"
  state: "Implemented"
  reason: "(flat tag 1) Dedicated dispatch arm in convert_flat_expr maps this tag onto the same-named parser-AST node."
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_expr_transition_census_spec.spl"

