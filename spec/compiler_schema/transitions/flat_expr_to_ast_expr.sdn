  state: "Normalized(ExprKind.Range)"
  reason: "(flat tag 46) Spread in struct-update position is carried as a Range node by the bridge."
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_expr_transition_census_spec.spl"

