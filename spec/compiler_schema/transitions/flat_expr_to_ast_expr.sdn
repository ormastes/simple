  reason: "(flat tag 45) No arm in convert_flat_expr; ExprKind has no Atom variant, so there is nothing mechanical to map onto. Loud fallback only."
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_expr_unsupported_loud_spec.spl"

transition:
