  state: "Unsupported(no-dispatch-arm-loud-fallback, doc/08_tracking/bug/spawn_call_expr_silently_becomes_nillit_2026-07-29.md)"
  reason: "(flat tag 44) No arm in convert_flat_expr; `do:` falls to the loud generic fallback. Left unfixed deliberately -- the target ExprKind mapping is a semantic decision."
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_expr_unsupported_loud_spec.spl"

transition:
  from: FlatExprKind.ATOM
