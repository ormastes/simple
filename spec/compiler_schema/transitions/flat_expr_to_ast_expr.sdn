transition:
  from: FlatExprKind.SPAWN
  to: "ExprKind.Call(Ident(\"spawn\"), [operand])"
  state: "Normalized(ExprKind.Call)"
  reason: "(flat tag 39) ExprKind.Spawn exists but hir_lowering/expressions.spl has no arm for it and would hard-error; every live consumer (E1049, mir_effects, builtin_registry) matches a callee NAME on a plain Call, so the bridge rebuilds a Call."
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_expr_transition_census_spec.spl"

transition:
  from: FlatExprKind.PASS_TODO
  to: "ExprKind.NilLit"
  state: "Normalized(ExprKind.NilLit)"
  reason: "(flat tag 40) `pass todo` is a deliberate no-op; NilLit is the intended target, not a fallback."
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_expr_transition_census_spec.spl"

transition:
  from: FlatExprKind.PASS_DO_NOTHING
  to: "ExprKind.NilLit"
  state: "Normalized(ExprKind.NilLit)"
  reason: "(flat tag 41) `pass do_nothing` is a deliberate no-op; NilLit is the intended target, not a fallback."
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_expr_transition_census_spec.spl"

transition:
  from: FlatExprKind.ASYNC_BLOCK
  to: "(none)"
  state: "NotApplicable(never-allocated)"
  reason: "(flat tag 42) Tag constant is declared but no constructor allocates it (no expr_alloc(EXPR_ASYNC_BLOCK, ..) anywhere in 10.frontend), so this node never reaches the bridge."
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_expr_transition_census_spec.spl"

transition:
  from: FlatExprKind.PASS_DN
  to: "ExprKind.NilLit"
