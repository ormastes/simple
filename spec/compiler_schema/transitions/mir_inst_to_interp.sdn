transition:
  from: MirInstKind.AcquireSnapshot
  to: "(none)"
  state: unsupported
  reason: "explicit arm raises the named, spanned diagnostic E-INTERP-INST-AcquireSnapshot; the interpreter does not model ownership-transfer envelopes"
  issue: E-INTERP-INST-AcquireSnapshot
  test: mir_inst_to_interp_coverage_spec

