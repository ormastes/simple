# Transition table: MirInstKind -> tree-walk MIR interpreter
#
# Boundary: `MirInterpreter.execute_instruction`, src/compiler/95.interp/mir_interpreter.spl
# Producer universe: `enum MirInstKind`, src/compiler/50.mir/mir_instruction_kinds.spl
# (126 variants), enumerated from the generated registry
# spec/compiler_schema/registry/compiler.mir.MirInstKind.sdn -- not from the
# dispatch itself, so an omitted arm shows up as Missing instead of silently
# disappearing.
#
# Row shape is the shared `transition: from/to/state/reason/test` format defined
# by src/compiler/00.common/transition/ (lane A3).
#
# Lane C8 (interpreter coverage, hardening plan 2026-08-21 sections 11.3-11.6).
# The interpreter walks MIR, not HIR, so this is the interpreter's expression/
# statement boundary: every MIR instruction kind is either executed or refused
# with a NAMED, spanned E-INTERP-INST-<Variant>. Before C8, 87 of the 126
# variants reached `case _:` and were reported as the unnamed "unknown
# instruction" (5 more had arms with unnamed messages). The terminal wildcard that remains raises E-INTERP-INST-Unknown
# with the observed discriminant; it is not a row because it is not a variant.
#
# Recorded state verified by source inspection 2026-08-21.

table: mir_inst_to_interp
producer: MirInstKind
consumer: MirInterpreter
source: src/compiler/95.interp/mir_interpreter.spl

universe:
