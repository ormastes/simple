# Negative fixture: an open `dyn` module reachable in a critical build. Complete
# on every other axis, so the only reason it cannot seal is §5.3's closure rule
# — the §17.6 E-MC-DYN-001 shape.
module:
  id: ide_probe
  linkage: dynload
  closure: dyn
  activation: manual

  extends:
    - enum: compiler.hir.HirExprKind
      constructor: ide.LiveProbe
      schema_abi: 1

  provides:
    - HirVerify
    - HirEffects
    - HirVisit
    - HirLowerMir
    - HirPrint
    - HirSerialize
