# OffloadProfile — NvmeChaHwQueues. The INVERSE of CosmosNfcEccDma on the four
# frontend rows: an NVMeCHA-class controller automates queue fetch, PRP walk,
# scatter DMA and completion posting in hardware, while ECC has nothing to do
# (no NAND). Same firmware source; only this file differs.
schema_version: 1
offload:
  id: NvmeChaHwQueues
  units:
    ecc_encode: firmware
    ecc_decode: firmware
    prp_walk: circuit
    queue_fetch: circuit
    completion_post: circuit
    dma_scatter: circuit
    nand_scheduler: firmware
    lba_hash: firmware
    gc_victim_scan: firmware
  differential_required: true
