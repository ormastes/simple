# OffloadProfile — CosmosNfcEccDma. Cosmos+ PL puts ECC and scatter DMA in
# circuit; the queue/PRP/completion path stays in firmware.
schema_version: 1
offload:
  id: CosmosNfcEccDma
  units:
    ecc_encode: circuit
    ecc_decode: circuit
    prp_walk: firmware
    queue_fetch: firmware
    completion_post: firmware
    dma_scatter: circuit
    nand_scheduler: firmware
    lba_hash: firmware
    gc_victim_scan: firmware
  differential_required: true
