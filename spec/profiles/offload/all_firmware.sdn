# OffloadProfile — AllFirmware. Nothing is in circuit; every unit runs in the
# firmware source. This is the baseline against which every offload profile is
# a DIFFERENTIAL.
schema_version: 1
offload:
  id: AllFirmware
  units:
    ecc_encode: firmware
    ecc_decode: firmware
    prp_walk: firmware
    queue_fetch: firmware
    completion_post: firmware
    dma_scatter: firmware
    nand_scheduler: firmware
    lba_hash: firmware
    gc_victim_scan: firmware
  differential_required: false
