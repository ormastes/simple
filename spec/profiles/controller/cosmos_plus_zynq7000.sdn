# ControllerProfile — CosmosPlusZynq7000.
# MEASURED values (apertures, PCI identity, aperture stride) come from
# doc/**/cosmos_openssd_port_2026-06-30.md and spec/hw/cosmos_nfc/register_ir.sdn.
# Values tagged ILLUSTRATIVE have NOT been read out of the Zynq TRM or the
# upstream PL project and must not be relied on.
schema_version: 1

controller:
  id: CosmosPlusZynq7000
  soc: "Xilinx Zynq-7000 XC7Z045"

  cpu:
    isa: armv7a
    endian: little
    harts: 2
    atomic_width: 32
    fpu: vfpv3

  address:
    physical_bits: 32
    dma_bits: 32

  nvme:
    transport: pcie
    generation: gen2
    lanes: 8
    spec_ceiling: "1.3"
    queues:
      admin: 1
      # io_max: ILLUSTRATIVE — not yet read from the PL project
      io_max: 8
      # depth_max: ILLUSTRATIVE
      depth_max: 256
    # outstanding_max: ILLUSTRATIVE
    outstanding_max: 128
    prp: multi_page
    sgl: false

  mmio:
    # MEASURED: matches spec/hw/cosmos_nfc/register_ir.sdn base/stride.
    windows:
      - name: pcie_host
        base: 0x83C00000
        span: 0x10000
        access: rw
      - name: nfc_channel
        base: 0x43C00000
        span: 0x80000
        access: rw

  dma:
    coherent: false
    # descriptors: ILLUSTRATIVE
    descriptors: 64
    # max_transfer: ILLUSTRATIVE
    max_transfer: 65536
    # alignment: ILLUSTRATIVE
    alignment: 64
    cache_maintenance: explicit

  irq:
    mode: gic
    controller: gicv1
    vectors: 96

  protection:
    mpu_regions: 8
    axi_firewall: true
    iommu: none

  # command_context_capacity: ILLUSTRATIVE
  command_context_capacity: 2048
