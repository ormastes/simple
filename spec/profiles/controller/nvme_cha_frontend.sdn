# ControllerProfile — NvmeChaFrontend.
# Derived by READING PUBLIC DOCUMENTATION only (yhqiu16/NVMeCHA + its README):
# Xilinx KCU105, PCIe Gen3 x8, Vivado/Vitis 2019.2, one software-assisted admin
# controller plus per-queue-pair hardware I/O controllers. No source was copied
# (origin ledger mode: reimplemented).
#
# NO PCI vendor/device ID is stated here. The upstream IDs were not verified on
# hardware by this repo, and fabricating them would be worse than omitting them.
# Register offsets are likewise absent: this profile declares WINDOWS, not a
# register layout.
schema_version: 1

controller:
  id: NvmeChaFrontend
  soc: "Xilinx Kintex UltraScale KCU105 (XCKU040)"

  cpu:
    isa: microblaze
    endian: little
    harts: 1
    atomic_width: 32
    fpu: none

  address:
    physical_bits: 64
    dma_bits: 64

  nvme:
    transport: pcie
    generation: gen3
    lanes: 8
    spec_ceiling: "1.3"
    queues:
      admin: 1
      # io_max: ILLUSTRATIVE — per-queue-pair HW controllers, count not verified here
      io_max: 8
      # depth_max: ILLUSTRATIVE
      depth_max: 64
    # outstanding_max: ILLUSTRATIVE
    outstanding_max: 64
    prp: multi_page
    sgl: false

  mmio:
    windows:
      - name: bar0_control
        # base: ILLUSTRATIVE — BAR base is assigned by host enumeration
        base: 0
        span: 0x4000
        access: rw

  dma:
    coherent: true
    # descriptors: ILLUSTRATIVE
    descriptors: 64
    # max_transfer: ILLUSTRATIVE
    max_transfer: 131072
    # alignment: ILLUSTRATIVE
    alignment: 64
    cache_maintenance: none

  irq:
    mode: msix
    controller: pcie_msix
    # vectors: ILLUSTRATIVE
    vectors: 32

  protection:
    mpu_regions: 0
    axi_firewall: false
    iommu: none

  # command_context_capacity: ILLUSTRATIVE
  command_context_capacity: 512
