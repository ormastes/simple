# ControllerProfile — SimpleFpgaRv32.
# In-repo RV32 soft controller. Every value here is AUTHORED by this repo
# (origin ledger row 0), so there are no external unknowns and no ILLUSTRATIVE
# markers: the numbers agree with fw/nvme_transport_profiles.sdn `emu`.
schema_version: 1

controller:
  id: SimpleFpgaRv32
  soc: "Simple RV32IMAC soft core (in-repo)"

  cpu:
    isa: rv32imac
    endian: little
    harts: 1
    atomic_width: 32
    fpu: none

  address:
    physical_bits: 32
    dma_bits: 32

  nvme:
    transport: emu
    generation: none
    lanes: 0
    spec_ceiling: "1.4"
    queues:
      admin: 1
      io_max: 1
      depth_max: 64
    outstanding_max: 1
    prp: single_page
    sgl: false

  mmio:
    windows:
      - name: doorbell
        base: 8192
        span: 16
        access: rw
      - name: property
        base: 8208
        span: 64
        access: rw

  dma:
    coherent: true
    descriptors: 1
    max_transfer: 4096
    alignment: 4
    cache_maintenance: none

  irq:
    mode: polling
    controller: none
    vectors: 0

  protection:
    mpu_regions: 8
    axi_firewall: false
    iommu: none

  command_context_capacity: 64
