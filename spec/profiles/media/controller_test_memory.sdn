# MediaProfile — ControllerTestMemory.
# NVMeCHA-class frontends have NO NAND behind them; the backing store is
# on-controller test memory. This profile exists to make that absence explicit
# and TYPED, so no FTL or media evidence can be claimed from such a board.
schema_version: 1
media:
  id: ControllerTestMemory
  kind: block_backend
  interface: none
  cell: none
  geometry:
    channels_hint: 1
    ways_per_channel: 1
    luns_per_way: 1
    planes_per_lun: 1
    # blocks_per_plane: ILLUSTRATIVE — depends on synthesised BRAM/DDR size
    blocks_per_plane: 64
    # pages_per_block: ILLUSTRATIVE
    pages_per_block: 64
    page_bytes: 4096
    oob_bytes: 0
    sectors_per_page: 8
  timing_ns:
    read_page: 0
    program_page: 0
    erase_block: 0
    transfer_byte: 0
  ecc:
    scheme: none
    correctable_bits_per_1k: 0
    parity_bytes_per_page: 0
  reliability:
    program_erase_cycles: 0
    read_retry_levels: 0
    requires_read_disturb_scan: false
    requires_data_retention_scan: false
  discovery:
    onfi_parameter_page: absent
    narrowing_allowed: false
