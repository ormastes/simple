# MediaProfile — ToshibaOnfiToggle (Cosmos+ class MLC part).
# Every geometry/timing/ECC number below is ILLUSTRATIVE: NAND part datasheets
# are NDA, so these are the plan's placeholder figures and must be replaced by
# measured ONFI parameter-page values with recorded provenance before any C5
# claim. Runtime discovery may NARROW, never exceed, these.
schema_version: 1
media:
  id: ToshibaOnfiToggle
  kind: raw_nand
  interface: toggle_1_0
  cell: mlc
  geometry:
    channels_hint: 8
    ways_per_channel: 8
    luns_per_way: 1
    planes_per_lun: 2
    # blocks_per_plane: ILLUSTRATIVE
    blocks_per_plane: 4096
    # pages_per_block: ILLUSTRATIVE
    pages_per_block: 256
    # page_bytes: ILLUSTRATIVE
    page_bytes: 16384
    # oob_bytes: ILLUSTRATIVE
    oob_bytes: 1280
    # sectors_per_page: ILLUSTRATIVE
    sectors_per_page: 32
  timing_ns:
    # read_page: ILLUSTRATIVE
    read_page: 60000
    # program_page: ILLUSTRATIVE
    program_page: 1300000
    # erase_block: ILLUSTRATIVE
    erase_block: 3800000
    # transfer_byte: ILLUSTRATIVE
    transfer_byte: 6
  ecc:
    scheme: bch
    # correctable_bits_per_1k: ILLUSTRATIVE
    correctable_bits_per_1k: 40
    # parity_bytes_per_page: ILLUSTRATIVE
    parity_bytes_per_page: 1024
  reliability:
    # program_erase_cycles: ILLUSTRATIVE
    program_erase_cycles: 3000
    # read_retry_levels: ILLUSTRATIVE
    read_retry_levels: 7
    requires_read_disturb_scan: true
    requires_data_retention_scan: true
  discovery:
    onfi_parameter_page: required
    narrowing_allowed: true
