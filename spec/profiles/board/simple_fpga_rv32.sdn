# BoardProfile — SimpleFpgaRv32. The only axis file that COMPOSES.
schema_version: 1
board:
  id: SimpleFpgaRv32
  revision: "in-repo-emu-v1"
  controller: SimpleFpgaRv32
  media: EmulatedDram
  offload: AllFirmware
  origin: SimpleFpgaRv32
  # transport_profile: binds to fw/nvme_transport_profiles.sdn
  transport_profile: emu
  # bound: a substrate (the in-process emulator) exists
  bound: 1
  wiring:
    channels: 1
    ways_per_channel: 1
  identity:
    pci_vendor: 0
    pci_device: 0
    pci_class: 0
    bar0_bytes: 8272
    bitstream_sha256: ""
    bitstream_contract: ""
  namespace_capacity_lbas: 2048
  write_buffer_pool: 16
  max_inflight_writes: 1
  per_write_buffers: 1
  reserved_oob_bytes: 8
  metadata_bytes_per_page: 16
  evidence_required: C3
  certification_current: C0
  unsupported:
    - sgl
    - zns
    - controller_memory_buffer
