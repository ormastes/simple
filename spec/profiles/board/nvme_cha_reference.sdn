# BoardProfile — NvmeChaReference.
# C4 CEILING, and C5 would be a category error: there is no NAND behind an
# NVMeCHA frontend, so no FTL or media evidence can flow from it. Declared but
# UNBOUND (bound: 0) — no KCU105 is attached to this repo.
schema_version: 1
board:
  id: NvmeChaReference
  revision: "nvmecha-kcu105-vivado2019.2"
  controller: NvmeChaFrontend
  media: ControllerTestMemory
  offload: NvmeChaHwQueues
  origin: NvmeChaFrontend
  # transport_profile: DECLARED, unbound
  transport_profile: board
  bound: 0
  wiring:
    channels: 1
    ways_per_channel: 1
  identity:
    # pci_vendor: NOT FABRICATED — upstream IDs unverified here
    pci_vendor: 0
    pci_device: 0
    pci_class: 0x010802
    # bar0_bytes: ILLUSTRATIVE
    bar0_bytes: 16384
    bitstream_sha256: ""
    bitstream_contract: ""
  # namespace_capacity_lbas: ILLUSTRATIVE
  namespace_capacity_lbas: 32768
  # write_buffer_pool: ILLUSTRATIVE
  write_buffer_pool: 64
  # max_inflight_writes: ILLUSTRATIVE
  max_inflight_writes: 16
  # per_write_buffers: ILLUSTRATIVE
  per_write_buffers: 2
  reserved_oob_bytes: 0
  metadata_bytes_per_page: 0
  evidence_required: C4
  certification_current: C0
  unsupported:
    - sgl
    - zns
    - controller_memory_buffer
    - real_media
