"""Prewarmed host CUDA service for SimpleOS audio ivshmem work."""

use std.gc_async_mut.engine.audio.simple_audio_cuda_q15.{SimpleAudioCudaQ15Executor, SimpleAudioCudaQ15Result, simple_audio_q15_execute_cuda_raw, simple_audio_q15_raw_checksum}
use std.common.engine.audio.simple_audio_q15.{simple_audio_q15_at, simple_audio_q15_push}
use app.io.file_ops.{file_exists, file_size}
use app.io.volatile_ops.{volatile_read_u64_required, volatile_write_u64_required, memory_barrier_required}
use app.io.time_ops.{time_now_nanos}
use app.io.args_ops.{get_args}
use app.io.thread.{thread_sleep_ms}
use std.nogc_sync_mut.ptr.raw.{rt_ptr_read_i64, raw_alloc, raw_free, raw_write_i64}
use std.sffi.dynamic.{DynLib}

extern fn rt_string_data(value: text) -> i64

val AUDIO_MAGIC: i64 = 6000287076110435377
val AUDIO_VERSION: i64 = 1
val AUDIO_HEADER_BYTES: i64 = 64
val AUDIO_SLOT_BYTES: i64 = 256
val AUDIO_MAX_SLOTS: i64 = 8
val AUDIO_PAYLOAD_BASE: i64 = 4096
val AUDIO_PAYLOAD_STRIDE: i64 = 524288
val AUDIO_REGION_BYTES: i64 = AUDIO_PAYLOAD_BASE + AUDIO_MAX_SLOTS * AUDIO_PAYLOAD_STRIDE
val AUDIO_INPUT_OFFSET: i64 = 0
val AUDIO_KERNEL_OFFSET: i64 = 131072
val AUDIO_OUTPUT_OFFSET: i64 = 147456
val AUDIO_MAX_INPUT_SAMPLES: i64 = 32768
val AUDIO_MAX_KERNEL_SAMPLES: i64 = 4096

val STATE_FREE: i64 = 0
val STATE_PUBLISHED: i64 = 1
val STATE_PROCESSING: i64 = 2
val STATE_COMPLETED: i64 = 3

val SLOT_STATE: i64 = 0
val SLOT_GENERATION: i64 = 8
val SLOT_CORRELATION: i64 = 24
val SLOT_PROVIDER: i64 = 88
val SLOT_NATIVE_HANDLE: i64 = 96
val SLOT_DEVICE_IDENTITY: i64 = 104
val SLOT_READBACK_CHECKSUM: i64 = 112
val SLOT_COMPLETED_NS: i64 = 120
val SLOT_ERROR_MILLIONTHS: i64 = 128
val SLOT_READBACK_SOURCE: i64 = 136
val SLOT_INPUT_SAMPLES: i64 = 144
val SLOT_INPUT_CHECKSUM: i64 = 152
val SLOT_KERNEL_CHECKSUM: i64 = 160
val SLOT_OUTPUT_SAMPLES: i64 = 168
val SLOT_KERNEL_FRAMES: i64 = 64
val SLOT_OPERATION: i64 = 72

fn _read(base: i64, offset: i64) -> i64:
    volatile_read_u64_required(base + offset)

fn _write(base: i64, offset: i64, value: i64):
    volatile_write_u64_required(base + offset, value)

fn _slot(base: i64, index: i64) -> i64:
    base + AUDIO_HEADER_BYTES + index * AUDIO_SLOT_BYTES

fn _payload(base: i64, index: i64) -> i64:
    base + AUDIO_PAYLOAD_BASE + index * AUDIO_PAYLOAD_STRIDE

fn _mapped_u32s(data_ptr: i64, count: i64) -> [u32]:
    var values: [u32] = []
    var index = 0
    while index < count:
        val packed = rt_ptr_read_i64(data_ptr, (index / 2) * 8)
        simple_audio_q15_push(values, (packed & 4294967295).to_u32())
        if index + 1 < count:
            simple_audio_q15_push(values, ((packed >> 32) & 4294967295).to_u32())
        index = index + 2
    values

fn _write_raw_readback(payload: i64, result: SimpleAudioCudaQ15Result, count: i64) -> i64:
    if result.readback_ptr == 0 or result.readback_count != count:
        return 0
    var checksum = 1469598103
    var index = 0
    while index < count:
        val packed = rt_ptr_read_i64(result.readback_ptr, index * 4)
        volatile_write_u64_required(payload + AUDIO_OUTPUT_OFFSET + index * 4, packed as u64)
        val low_raw = packed & 4294967295
        val low_sample = if low_raw > 2147483647: low_raw - 4294967296 else: low_raw
        val low_bits = if low_sample < 0: low_sample + 4294967296 else: low_sample
        checksum = ((checksum * 16777619) + low_bits) % 2147483647
        if index + 1 < count:
            val high_sample = packed >> 32
            val high_bits = if high_sample < 0: high_sample + 4294967296 else: high_sample
            checksum = ((checksum * 16777619) + high_bits) % 2147483647
        index = index + 2
    if checksum == 0: 1 else: checksum

fn _arg_value(args: [text], prefix: text) -> text:
    for arg in args:
        if arg.starts_with(prefix):
            return arg[prefix.len():]
    ""

fn _complete_failure(slot: i64, generation: i64, correlation: i64, elapsed_ns: i64):
    if _read(slot, SLOT_GENERATION) != generation or _read(slot, SLOT_CORRELATION) != correlation or _read(slot, SLOT_STATE) != STATE_PROCESSING:
        return
    _write(slot, SLOT_PROVIDER, 0)
    _write(slot, SLOT_NATIVE_HANDLE, 0)
    _write(slot, SLOT_DEVICE_IDENTITY, 0)
    _write(slot, SLOT_READBACK_CHECKSUM, 0)
    _write(slot, SLOT_COMPLETED_NS, elapsed_ns)
    _write(slot, SLOT_ERROR_MILLIONTHS, 1000000)
    _write(slot, SLOT_READBACK_SOURCE, 0)
    memory_barrier_required()
    _write(slot, SLOT_STATE, STATE_COMPLETED)

fn _process_slot(executor: SimpleAudioCudaQ15Executor, base: i64, index: i64) -> i64:
    val slot = _slot(base, index)
    if _read(slot, SLOT_STATE) != STATE_PUBLISHED:
        return 0
    memory_barrier_required()
    val generation = _read(slot, SLOT_GENERATION)
    val correlation = _read(slot, SLOT_CORRELATION)
    val input_count = _read(slot, SLOT_INPUT_SAMPLES)
    val kernel_count = _read(slot, SLOT_KERNEL_FRAMES)
    val output_count = _read(slot, SLOT_OUTPUT_SAMPLES)
    val input_checksum = _read(slot, SLOT_INPUT_CHECKSUM)
    val kernel_checksum = _read(slot, SLOT_KERNEL_CHECKSUM)
    val operation = _read(slot, SLOT_OPERATION)
    if generation <= 0 or correlation <= 0 or input_count <= 0 or input_count > AUDIO_MAX_INPUT_SAMPLES or kernel_count <= 0 or kernel_count > AUDIO_MAX_KERNEL_SAMPLES or output_count != input_count + kernel_count - 1 or (operation != 1 and operation != 2):
        print("AUDIO_HOST_REJECT slot={index} reason=invalid-metadata generation={generation} correlation={correlation} input={input_count} kernel={kernel_count} output={output_count} operation={operation}\n")
        _write(slot, SLOT_STATE, STATE_PROCESSING)
        _complete_failure(slot, generation, correlation, 1)
        return 1
    _write(slot, SLOT_STATE, STATE_PROCESSING)
    memory_barrier_required()
    val payload = _payload(base, index)
    val input_ptr = payload + AUDIO_INPUT_OFFSET
    val kernel_ptr = payload + AUDIO_KERNEL_OFFSET
    val computed_input_checksum = simple_audio_q15_raw_checksum(input_ptr, input_count)
    val computed_kernel_checksum = simple_audio_q15_raw_checksum(kernel_ptr, kernel_count)
    if computed_input_checksum != input_checksum or computed_kernel_checksum != kernel_checksum:
        print("AUDIO_HOST_REJECT slot={index} reason=payload-checksum input_expected={input_checksum} input_observed={computed_input_checksum} kernel_expected={kernel_checksum} kernel_observed={computed_kernel_checksum}\n")
        _complete_failure(slot, generation, correlation, 1)
        return 1
    val started = time_now_nanos()
    val result = simple_audio_q15_execute_cuda_raw(executor, input_ptr, input_count, kernel_ptr, kernel_count)
    val elapsed = time_now_nanos() - started
    if not result.completed or result.readback_ptr == 0 or result.readback_count != output_count or result.backend_handle <= 0 or result.device_identity <= 0 or result.readback_checksum <= 0 or result.normalized_error_millionths < 0 or result.normalized_error_millionths > 10:
        print("AUDIO_HOST_REJECT slot={index} reason=cuda-result detail={result.reason} completed={result.completed} readback_ptr={result.readback_ptr} readback_count={result.readback_count} expected_count={output_count} handle={result.backend_handle} device={result.device_identity} checksum={result.readback_checksum} error_millionths={result.normalized_error_millionths}\n")
        result.release_readback()
        _complete_failure(slot, generation, correlation, if elapsed > 0: elapsed else: 1)
        return 1
    if _read(slot, SLOT_GENERATION) != generation or _read(slot, SLOT_CORRELATION) != correlation or _read(slot, SLOT_STATE) != STATE_PROCESSING:
        return 0
    val wire_checksum = _write_raw_readback(payload, result, output_count)
    result.release_readback()
    if wire_checksum <= 0:
        print("AUDIO_HOST_REJECT slot={index} reason=wire-writeback count={output_count}\n")
        _complete_failure(slot, generation, correlation, if elapsed > 0: elapsed else: 1)
        return 1
    _write(slot, SLOT_PROVIDER, 1)
    _write(slot, SLOT_NATIVE_HANDLE, result.backend_handle)
    _write(slot, SLOT_DEVICE_IDENTITY, result.device_identity)
    _write(slot, SLOT_READBACK_CHECKSUM, wire_checksum)
    _write(slot, SLOT_COMPLETED_NS, if elapsed > 0: elapsed else: 1)
    _write(slot, SLOT_ERROR_MILLIONTHS, result.normalized_error_millionths)
    _write(slot, SLOT_READBACK_SOURCE, 1)
    memory_barrier_required()
    _write(slot, SLOT_STATE, STATE_COMPLETED)
    print("AUDIO_HOST_DEVICE_READBACK slot={index} generation={generation} correlation={correlation} samples={output_count} checksum={wire_checksum} device={result.device_identity} elapsed_ns={elapsed}\n")
    1

fn simpleos_audio_host_run() -> i64:
    val args = get_args()
    if args.contains("--cuda-probe"):
        var probe_executor = SimpleAudioCudaQ15Executor.create()
        val probe_input = raw_alloc(16)
        val probe_kernel = raw_alloc(8)
        raw_write_i64(probe_input, 0, 70368744177664 + 32768)
        raw_write_i64(probe_input, 8, 4294959104)
        raw_write_i64(probe_kernel, 0, 35184372088832 + 16384)
        val probe = simple_audio_q15_execute_cuda_raw(probe_executor, probe_input, 3, probe_kernel, 2)
        val probe_pair0 = if probe.readback_ptr != 0: rt_ptr_read_i64(probe.readback_ptr, 0) else: 0
        val probe_pair1 = if probe.readback_ptr != 0: rt_ptr_read_i64(probe.readback_ptr, 8) else: 0
        val probe_low0 = probe_pair0 & 4294967295
        val probe_low1 = probe_pair1 & 4294967295
        val probe_sample0 = if probe_low0 > 2147483647: probe_low0 - 4294967296 else: probe_low0
        val probe_sample1 = probe_pair0 >> 32
        val probe_sample2 = if probe_low1 > 2147483647: probe_low1 - 4294967296 else: probe_low1
        val probe_sample3 = probe_pair1 >> 32
        val probe_ok = probe.completed and probe.reason == "device-readback" and probe.backend_handle > 0 and probe.device_identity > 0 and probe.readback_checksum > 0 and probe.normalized_error_millionths <= 10 and probe.readback_count == 4 and probe_sample0 == 16384 and probe_sample1 == 16384 and probe_sample2 == 0 and probe_sample3 == -2048
        print("AUDIO_HOST_CUDA_PROBE ok={probe_ok} reason={probe.reason} handle={probe.backend_handle} device={probe.device_identity} checksum={probe.readback_checksum} error_millionths={probe.normalized_error_millionths} count={probe.readback_count} samples={probe_sample0},{probe_sample1},{probe_sample2},{probe_sample3}\n")
        probe.release_readback()
        raw_free(probe_input, 16)
        raw_free(probe_kernel, 8)
        probe_executor.shutdown()
        return if probe_ok: 0 else: 6
    val path = _arg_value(args, "--shm=")
    val once = args.contains("--once")
    if path == "" or not file_exists(path) or file_size(path) < AUDIO_REGION_BYTES:
        print("simpleos_audio_host: --shm=<audio backing file of at least 4 MiB> required\n")
        return 2
    val host_io = DynLib.load("libsimple_audio_cuda.so")
    if host_io == nil:
        return 3
    val base = host_io.call1("simple_audio_host_map_shared", rt_string_data(path))
    if base <= 0:
        host_io.close()
        return 3
    print("AUDIO_HOST_MAPPED bytes={AUDIO_REGION_BYTES}\n")
    # QEMU and the host service normally start before the guest initializes
    # the shared header. Wait without mutating the guest-owned region.
    var capacity = 0
    while capacity == 0:
        if _read(base, 0) == AUDIO_MAGIC and _read(base, 8) == AUDIO_VERSION and _read(base, 24) == AUDIO_SLOT_BYTES:
            val observed_capacity = _read(base, 16)
            if observed_capacity >= 2 and observed_capacity <= AUDIO_MAX_SLOTS:
                capacity = observed_capacity
                print("AUDIO_HOST_READY capacity={capacity}\n")
            elif once:
                host_io.call1("simple_audio_host_unmap_shared", base)
                host_io.close()
                return 5
        elif once:
            host_io.call1("simple_audio_host_unmap_shared", base)
            host_io.close()
            return 5
        if capacity == 0:
            thread_sleep_ms(1)
    var executor = SimpleAudioCudaQ15Executor.create()
    while true:
        var processed = 0
        var index = 0
        while index < capacity:
            processed = processed + _process_slot(executor, base, index)
            index = index + 1
        if once:
            executor.shutdown()
            host_io.call1("simple_audio_host_unmap_shared", base)
            host_io.close()
            return if processed > 0: 0 else: 4
        if processed == 0:
            thread_sleep_ms(1)
    0

export simpleos_audio_host_run
