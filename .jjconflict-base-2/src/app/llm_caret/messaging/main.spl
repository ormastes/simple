"""Minimal command entrypoint for the LLM Caret messaging control plane.

This intentionally excludes the legacy Caret UI and provider graph. Commands
that touch PureDatabase delegate to freshness-checked compiled workers in
`cli.spl`; interpreting this supervisor never interprets the database hot path.
"""

use std.cli.cli_util.{get_cli_args}
use app.llm_caret.messaging.cli.{run_messaging_cli}

fn main() -> i64:
    run_messaging_cli(get_cli_args())
