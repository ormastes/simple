# Extension Manifest — typed manifest model for editor extensions.
# Model ONLY: parsing/decoding lives in manifest_sdn.spl.
#
# Provides: ExtensionCommand, ExtensionLanguage, ExtensionDebugAdapterManifest,
#           ExtensionTheme, ExtensionKeybinding, ExtensionCustomEditor,
#           ExtensionPermissions, ExtensionManifest.

struct ExtensionCommand:
    id: text
    title: text
    category: text

struct ExtensionLanguage:
    id: text
    extensions: [text]

struct ExtensionDebugAdapterManifest:
    id: text
    label: text
    program: text

struct ExtensionTheme:
    id: text
    label: text
    ui_theme: text
    path: text

struct ExtensionKeybinding:
    command: text
    key: text
    when: text

struct ExtensionCustomEditor:
    id: text
    document_kind: text
    priority: i64

# Default-deny capability grants. Every field is false unless the manifest
# grants it explicitly.
struct ExtensionPermissions:
    workspace_read: bool
    workspace_write: bool
    process_spawn: bool
    network_client: bool
    secrets: bool
    native_ffi: bool

fn extension_permissions_none() -> ExtensionPermissions:
    ExtensionPermissions(
        workspace_read: false,
        workspace_write: false,
        process_spawn: false,
        network_client: false,
        secrets: false,
        native_ffi: false
    )

struct ExtensionManifest:
    # legacy identity fields (kept for backward compatibility)
    name: text
    version: text
    main: text
    # schema "simple.ide.extension/1" fields ("" on legacy manifests)
    schema_version: text
    display_name: text
    engine: text            # raw semver range text; check via contract.semver_range_parse
    entry: text             # runtime entry module (aliases `main` on new manifests)
    host: text              # "" | "builtin" | "in_process" | "worker"
    permissions: ExtensionPermissions
    activation_events: [text]
    contributes_commands: [ExtensionCommand]
    contributes_languages: [ExtensionLanguage]
    contributes_debug_adapters: [ExtensionDebugAdapterManifest]
    contributes_themes: [ExtensionTheme]
    contributes_keybindings: [ExtensionKeybinding]
    contributes_custom_editors: [ExtensionCustomEditor]

fn extension_manifest_empty() -> ExtensionManifest:
    ExtensionManifest(
        name: "",
        version: "",
        main: "",
        schema_version: "",
        display_name: "",
        engine: "",
        entry: "",
        host: "",
        permissions: extension_permissions_none(),
        activation_events: [],
        contributes_commands: [],
        contributes_languages: [],
        contributes_debug_adapters: [],
        contributes_themes: [],
        contributes_keybindings: [],
        contributes_custom_editors: []
    )

# Convenience constructor for builtin manifests: fills schema/permission
# fields with safe defaults (host "builtin", default-deny permissions).
fn extension_manifest_basic(name: text, version: text, main: text,
                            activation_events: [text],
                            commands: [ExtensionCommand],
                            languages: [ExtensionLanguage]) -> ExtensionManifest:
    var m = extension_manifest_empty()
    m.name = name
    m.display_name = name
    m.version = version
    m.main = main
    m.entry = main
    m.host = "builtin"
    m.activation_events = activation_events
    m.contributes_commands = commands
    m.contributes_languages = languages
    m
