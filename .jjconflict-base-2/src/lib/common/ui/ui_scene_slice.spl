# Unified Packed UI Scene — producer contract, slice, and bounds-checked
# writer vocabulary (design §2.2, §2.3).
#
# Design authority: `doc/05_design/ui/unified_packed_ui_scene.md` §2.2, §2.3.
# Lane: L1 (`doc/03_plan/ui/unified_packed_ui_scene_agent_lanes.md`).
#
# Interface vocabulary only — trait definitions and value types are pure.
# NO arena, NO backend/writer implementation: those live in
# `src/lib/nogc_sync_mut/ui/` (later lanes). "GuiIR"/"WebIR" are never
# separately allocated command structures here (design decision record #1) —
# a GUI or Web producer emits directly into the shared arena via this
# contract.

use common.ui.draw_ir_v3.{
    DrawIrV3Command,
    DrawIrV3Geometry,
    DrawIrV3Paint,
    DrawIrV3TextRun,
    DrawIrV3Glyph,
    DrawIrV3Resource,
    DrawIrV3PathSpan,
    DrawIrV3PathPoint,
    DrawIrV3Clip,
    DrawIrV3Transform,
    DrawIrV3HitShape,
    DrawIrV3Provenance
}
use common.ui.ui_scene_counts.{UiSceneCounts, UiSceneRanges, UiSceneOverflowReceipt}
use common.ui.ui_scene_owner_table.{UiOwnerRecord, MenuActionBinding}

# =========================================================================
# Slice (design §2.2)
# =========================================================================

struct UiSceneSlice:
    scene_slot: u32
    scene_generation: u32
    root_component_id: u32
    ranges: UiSceneRanges

# =========================================================================
# Write verdict (design §2.3). A `false` return from any `put_*`, or a
# non-`Exact` verdict from `finish()`, aborts the generation: the back
# buffer is marked invalid, the front generation is untouched, and a
# receipt is produced by the caller. Under-emission is as fatal as
# overflow — a deficit would leave stale rows that still render.
# =========================================================================

enum UiSceneWriteVerdict:
    Exact
    Deficit(table_id: u16, n: u32)
    Surplus(table_id: u16, n: u32)

# EMIT result (design §2.2): a producer refuses rather than clamps.
#
# Positional payload, not a named `slice:` field: `slice` is a soft keyword
# in this grammar (rejected with "expected Comma, found Colon" as a
# `label: Type` field name, confirmed by direct probe) — the design text
# itself specifies this variant positionally (`Emitted(UiSceneSlice)`), so
# no divergence from design is needed, only from an initial named-field
# draft that never should have used the reserved spelling.
enum UiSceneEmitResult:
    Emitted(UiSceneSlice)
    Refused(UiSceneOverflowReceipt)

# =========================================================================
# Writers (design §2.3). One `put_*` per DrawIR v3 table this writer
# covers (tables 0-11: COMMANDS..PROVENANCE_EDGES); row shapes reuse the
# existing frozen `draw_ir_v3.spl` accessor-view structs rather than
# reinventing per-table field lists.
# =========================================================================

trait DrawIrV3Writer:
    fn put_command(row: DrawIrV3Command) -> bool          # false = out of range
    fn put_geometry(row: DrawIrV3Geometry) -> bool
    fn put_paint(row: DrawIrV3Paint) -> bool
    fn put_text_run(row: DrawIrV3TextRun) -> bool
    fn put_glyph(row: DrawIrV3Glyph) -> bool
    fn put_resource(row: DrawIrV3Resource) -> bool
    fn put_path_span(row: DrawIrV3PathSpan) -> bool
    fn put_path_point(row: DrawIrV3PathPoint) -> bool
    fn put_clip(row: DrawIrV3Clip) -> bool
    fn put_transform(row: DrawIrV3Transform) -> bool
    fn put_hit_shape(row: DrawIrV3HitShape) -> bool
    fn put_provenance(row: DrawIrV3Provenance) -> bool
    fn cursor(table_id: u16) -> u32
    # Verifies cursor == reserved count for EVERY table this writer covers.
    fn finish() -> UiSceneWriteVerdict

# `UiOwnerWriter` / `UiActionWriter` follow the same shape over tables 12/13
# (design §2.3).
trait UiOwnerWriter:
    fn put_owner_record(row: UiOwnerRecord) -> bool
    fn cursor() -> u32
    fn finish() -> UiSceneWriteVerdict

trait UiActionWriter:
    fn put_action_binding(row: MenuActionBinding) -> bool
    fn cursor() -> u32
    fn finish() -> UiSceneWriteVerdict

# =========================================================================
# Producer contract (design §2.2). One private producer contract
# implemented by WM, GUI, Web and external-surface producers (decision
# record #2) — no inheritance, trait only.
# =========================================================================

trait UiPackedProducer:
    # Identity for owner records and receipts. Stable within a session.
    fn producer_kind() -> u16          # UI_PRODUCER_WM | _GUI | _WEB | _EXTERNAL
    fn producer_id() -> u32

    # Pass A: report EXACT required rows for every table for this snapshot.
    # Must be side-effect free and repeatable for the same snapshot_id.
    fn count(snapshot_id: u64, counts: UiSceneCounts) -> UiSceneCounts

    # Pass D: write into pre-reserved ranges. Must write EXACTLY the counted
    # rows per table — no fewer, no more (design §5). A nested producer
    # (WebView) is invoked here with its sub-ranges.
    fn emit(
        snapshot_id: u64, ranges: UiSceneRanges,
        draw: DrawIrV3Writer, owners: UiOwnerWriter, actions: UiActionWriter
    ) -> UiSceneEmitResult

export UiSceneSlice, UiSceneWriteVerdict, UiSceneEmitResult,
    DrawIrV3Writer, UiOwnerWriter, UiActionWriter, UiPackedProducer
