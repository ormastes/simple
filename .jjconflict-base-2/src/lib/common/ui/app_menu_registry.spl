# app_menu_registry.spl -- L8: process/session-local application menu
# registry backing AppMenuSnapshot's flat side-table ranges.
#
# Design authority: doc/05_design/ui/unified_packed_ui_scene.md section 6.
# Lane: L8, doc/03_plan/ui/unified_packed_ui_scene_agent_lanes.md.
#
# Lives in common/ui, not nogc_sync_mut: pure linear-array state (a
# scan-based lookup, not a Dict -- native-codegen Dict pitfalls,
# doc/07_guide/language/dict_native_pitfalls.md; project rule), no I/O.
# `register()` builds a flat one-level menu (no submenu nesting): the
# nested Menu/MenuItem convenience DSL is deferred until a real application
# consumer exists (design section 6).

use common.ui.draw_ir_v3.{DRAW_IR_V3_NO_ID}
use common.ui.ui_scene_owner_table.{MenuActionBinding}
use common.ui.app_menu_snapshot.{AppMenuSnapshot, AppMenuItemRow}

class AppMenuRegistry:
    app_ids: [u32]
    snapshots: [AppMenuSnapshot]
    items: [AppMenuItemRow]
    labels: [text]
    actions: [MenuActionBinding]
    next_menu_item_id: u32
    next_action_id: u32

impl AppMenuRegistry:
    static fn new() -> AppMenuRegistry:
        AppMenuRegistry(
            app_ids: [], snapshots: [], items: [], labels: [], actions: [],
            next_menu_item_id: 0u32, next_action_id: 0u32
        )

    me find_app_index(app_id: u32) -> i64:
        var i = 0
        while i < self.app_ids.len():
            if self.app_ids[i] == app_id:
                return i.to_i64()
            i = i + 1
        -1

    # Registers (first call) or replaces (subsequent calls, bumping
    # `menu_revision`) a flat menu for `app_id`. One AppMenuItemRow + one
    # MenuActionBinding per label in `item_labels`, in order.
    me register(app_id: u32, app_generation: u32, focused_owner_id: u32, item_labels: [text], default_target_owner_id: u32) -> AppMenuSnapshot:
        val existing_idx = self.find_app_index(app_id)
        val menu_revision = if existing_idx >= 0: self.snapshots[existing_idx].menu_revision + 1u32 else: 1u32

        val item_start = self.items.len().to_u32()
        val action_start = self.actions.len().to_u32()
        var i = 0
        while i < item_labels.len():
            val label_id = self.labels.len().to_u32()
            self.labels.push(item_labels[i])
            val item_id = self.next_menu_item_id
            self.next_menu_item_id = self.next_menu_item_id + 1u32
            val action_id = self.next_action_id
            self.next_action_id = self.next_action_id + 1u32
            self.items.push(AppMenuItemRow(
                menu_item_id: item_id, parent_item_id: DRAW_IR_V3_NO_ID,
                label_string_id: label_id, action_id: action_id,
                flags: 0u32, shortcut_id: DRAW_IR_V3_NO_ID,
                enabled: true, checked: false,
                submenu_start: 0u32, submenu_count: 0u32
            ))
            self.actions.push(MenuActionBinding(
                app_id: app_id, app_generation: app_generation, menu_revision: menu_revision,
                action_id: action_id, default_target_owner_id: default_target_owner_id
            ))
            i = i + 1

        val snapshot = AppMenuSnapshot(
            app_id: app_id, app_generation: app_generation, menu_revision: menu_revision,
            focused_owner_id: focused_owner_id,
            root_start: item_start, root_count: item_labels.len().to_u32(),
            item_start: item_start, item_count: item_labels.len().to_u32(),
            action_start: action_start, action_count: item_labels.len().to_u32()
        )
        if existing_idx >= 0:
            self.app_ids[existing_idx] = app_id
            self.snapshots[existing_idx] = snapshot
        else:
            self.app_ids.push(app_id)
            self.snapshots.push(snapshot)
        snapshot

    me lookup(app_id: u32) -> AppMenuSnapshot?:
        val idx = self.find_app_index(app_id)
        if idx < 0:
            return nil
        self.snapshots[idx]

    me item_at(idx: u32) -> AppMenuItemRow:
        self.items[idx.to_i64()]

    me label_at(idx: u32) -> text:
        self.labels[idx.to_i64()]

    me action_at(idx: u32) -> MenuActionBinding:
        self.actions[idx.to_i64()]

export AppMenuRegistry
