# Test Configuration
#
# Test runner configuration: compiled defaults + config/simple.test.sdn +
# CI env override, resolved through the shared std.config engine
# (std.common.config_core). Second non-IDE consumer of config_core (CFG3).
#
# The previous hand-rolled merge is deleted: the per-key `match` ladder
# (apply_test_config_value — which also carried a confirmed missing-`mut`
# defect making every file key a silent no-op, see
# doc/08_tracking/bug/test_config_apply_value_missing_mut_param_2026-07-17.md),
# the to_int_or/parse_f64_or fallback chains, the duplicated defaults table,
# and the private line parser (parse_config_key_value). Layer precedence,
# type conversion, validation, and defaults all come from the schema below.
#
# Layers used:
#   compiled_default — schema default_value (single source of defaults)
#   workspace        — the config/simple.test.sdn document
#   session          — CI env override (CI=true / CI=1)
#   mandatory        — reserved for policy ceilings (pins a value; a session
#                      or workspace entry can never displace it)

use std.io.{file_exists, file_read}
use std.io.{env_get}
use std.common.config_core.schema.{ConfigFieldDescriptor}
use std.common.config_core.schema.{config_field, config_int_field, config_f64_field}
use std.common.config_core.schema.{config_parse_int, config_text_to_bool, config_schema_index}
use std.common.config_core.layers.{ConfigEntry}
use std.common.config_core.layers.{config_parse_line, config_strip_inline_comment, config_resolve_valid}

# =========================================================================
# Config Paths
# =========================================================================

val CONFIG_FILENAME = "config/simple.test.sdn"

# =========================================================================
# Test Config
# =========================================================================

struct TestConfig:
    timeout_seconds: i64
    memory_limit_mb: i64
    cpu_limit_seconds: i64
    max_fds: i64
    max_procs: i64
    parallel: bool
    fail_fast: bool
    slow_threshold_ms: i64
    cpu_threshold: f64
    memory_threshold: f64
    throttle_enabled: bool
    run_spec_tests: bool
    run_sdoctests: bool
    run_slow_tests: bool
    run_spl_doctests: bool
    ci_mode: bool
    # Session sharing settings
    session_share: bool
    session_daemon: bool
    session_idle_timeout_ms: i64
    session_startup_timeout_ms: i64
    session_debug: bool
    session_max_qemu_vm: i64
    session_max_container: i64
    session_max_service: i64
    session_max_openocd: i64
    session_max_trace32: i64
    session_max_simulator: i64

# =========================================================================
# Schema — the single source of keys, types, defaults, and bounds.
# =========================================================================

fn test_config_schema() -> [ConfigFieldDescriptor]:
    [
        config_int_field("timeout_seconds", "60", 1),
        config_int_field("memory_limit_mb", "512", 1),
        config_int_field("cpu_limit_seconds", "30", 1),
        config_int_field("max_fds", "256", 1),
        config_int_field("max_procs", "64", 1),
        config_field("parallel", "bool", "false"),
        config_field("fail_fast", "bool", "false"),
        config_int_field("slow_threshold_ms", "5000", 1),
        config_f64_field("cpu_threshold", "80.0"),
        config_f64_field("memory_threshold", "80.0"),
        config_field("throttle_enabled", "bool", "false"),
        config_field("run_spec_tests", "bool", "true"),
        config_field("run_sdoctests", "bool", "false"),
        config_field("run_slow_tests", "bool", "false"),
        config_field("run_spl_doctests", "bool", "false"),
        config_field("ci_mode", "bool", "false"),
        config_field("session_share", "bool", "false"),
        config_field("session_daemon", "bool", "false"),
        config_int_field("session_idle_timeout_ms", "300000", 1),
        config_int_field("session_startup_timeout_ms", "60000", 1),
        config_field("session_debug", "bool", "false"),
        config_int_field("session_max_qemu_vm", "4", 0),
        config_int_field("session_max_container", "2", 0),
        config_int_field("session_max_service", "8", 0),
        config_int_field("session_max_openocd", "1", 0),
        config_int_field("session_max_trace32", "1", 0),
        config_int_field("session_max_simulator", "2", 0)
    ]

# =========================================================================
# Document parsing — flatten the nested simple.test.sdn structure onto the
# canonical schema keys, then let config_core resolve precedence.
# =========================================================================

# Map a document key (with the subsection it appeared under) to the canonical
# schema key. "" means the key is not part of TestConfig and is ignored —
# exactly the old `case _: ()` behaviour.
fn _tc_canonical_key(section: text, key: text) -> text:
    if section == "cpu_throttle":
        if key == "enabled": return "throttle_enabled"
        if key == "threshold": return "cpu_threshold"
        if key == "memory_threshold": return "memory_threshold"
        return ""
    if section == "session_max_sessions":
        if key == "qemu_vm": return "session_max_qemu_vm"
        if key == "container_instance": return "session_max_container"
        if key == "service_process": return "session_max_service"
        if key == "openocd_board": return "session_max_openocd"
        if key == "trace32_board": return "session_max_trace32"
        if key == "simulator_process": return "session_max_simulator"
        return ""
    if section == "session_defaults":
        # kind-specific sub-keys; not part of TestConfig (future use)
        return ""
    if key == "timeout": return "timeout_seconds"
    key

# Parse the nested test-config document into config_core entries tagged with
# `layer`. Section tracking (test:, cpu_throttle:, session_max_sessions:,
# session_defaults:) is document structure; the line split, comment stripping,
# and everything downstream (precedence, validation, defaults) is config_core.
fn test_config_entries(content: text, layer: text) -> [ConfigEntry]:
    val lines = content.split("\n")
    var result: [ConfigEntry] = []
    var in_test_section = false
    var section = ""
    var line_idx = 0
    while line_idx < lines.len():
        val line = lines[line_idx]
        val trimmed = line.trim()
        line_idx = line_idx + 1
        if trimmed == "" or trimmed.starts_with("#"):
            continue
        if trimmed == "test:":
            in_test_section = true
            section = ""
            continue
        if not line.starts_with("  ") and trimmed.ends_with(":"):
            # a different top-level section ends test:
            in_test_section = false
            section = ""
            continue
        if in_test_section and line.starts_with("  ") and not line.starts_with("    "):
            # test-level indentation: any open subsection ends here
            section = ""
            if trimmed == "cpu_throttle:":
                section = "cpu_throttle"
                continue
            if trimmed == "session_max_sessions:":
                section = "session_max_sessions"
                continue
            if trimmed == "session_defaults:":
                section = "session_defaults"
                continue
            if trimmed.ends_with(":"):
                # unknown subsection under test: — skip its body
                section = "unknown"
                continue
        if section == "unknown":
            continue
        val entry = config_parse_line(line: trimmed, layer: layer)
        if entry.key == "":
            continue
        val canonical = _tc_canonical_key(section: section, key: entry.key)
        if canonical == "":
            continue
        val value = config_strip_inline_comment(entry.value)
        result.push(ConfigEntry(key: canonical, value: value, layer: layer))
    result

# CI env override as a session-layer contribution (replaces the old
# direct-assignment block at the end of parse_test_config_content).
fn test_config_env_entries() -> [ConfigEntry]:
    val ci_env = env_get("CI")
    if ci_env == "true" or ci_env == "1":
        return [
            ConfigEntry(key: "ci_mode", value: "true", layer: "session"),
            ConfigEntry(key: "run_slow_tests", value: "true", layer: "session"),
            ConfigEntry(key: "fail_fast", value: "false", layer: "session")
        ]
    []

# =========================================================================
# Resolution — config_core precedence, invalid entries fall back to the
# lower layer (the old to_int_or / parse_f64_or fallback semantics).
# =========================================================================

fn _tc_text(schema: [ConfigFieldDescriptor], entries: [ConfigEntry], key: text) -> text:
    val idx = config_schema_index(schema, key)
    if idx < 0:
        return ""
    config_resolve_valid(schema[idx], entries).value

fn _tc_int(schema: [ConfigFieldDescriptor], entries: [ConfigEntry], key: text) -> i64:
    config_parse_int(_tc_text(schema, entries, key))

fn _tc_bool(schema: [ConfigFieldDescriptor], entries: [ConfigEntry], key: text) -> bool:
    config_text_to_bool(_tc_text(schema, entries, key))

fn _tc_f64(schema: [ConfigFieldDescriptor], entries: [ConfigEntry], key: text) -> f64:
    _tc_text(schema, entries, key).to_float()

# fix-owner: codex-par-testconfig
# Resolve every TestConfig field across the given layer entries. Constructing the
# result from resolved entries avoids the former missing-`mut` helper boundary:
# parsed values are carried into the returned TestConfig without caller mutation.
fn test_config_resolve(entries: [ConfigEntry]) -> TestConfig:
    val schema = test_config_schema()
    TestConfig(
        timeout_seconds: _tc_int(schema, entries, "timeout_seconds"),
        memory_limit_mb: _tc_int(schema, entries, "memory_limit_mb"),
        cpu_limit_seconds: _tc_int(schema, entries, "cpu_limit_seconds"),
        max_fds: _tc_int(schema, entries, "max_fds"),
        max_procs: _tc_int(schema, entries, "max_procs"),
        parallel: _tc_bool(schema, entries, "parallel"),
        fail_fast: _tc_bool(schema, entries, "fail_fast"),
        slow_threshold_ms: _tc_int(schema, entries, "slow_threshold_ms"),
        cpu_threshold: _tc_f64(schema, entries, "cpu_threshold"),
        memory_threshold: _tc_f64(schema, entries, "memory_threshold"),
        throttle_enabled: _tc_bool(schema, entries, "throttle_enabled"),
        run_spec_tests: _tc_bool(schema, entries, "run_spec_tests"),
        run_sdoctests: _tc_bool(schema, entries, "run_sdoctests"),
        run_slow_tests: _tc_bool(schema, entries, "run_slow_tests"),
        run_spl_doctests: _tc_bool(schema, entries, "run_spl_doctests"),
        ci_mode: _tc_bool(schema, entries, "ci_mode"),
        session_share: _tc_bool(schema, entries, "session_share"),
        session_daemon: _tc_bool(schema, entries, "session_daemon"),
        session_idle_timeout_ms: _tc_int(schema, entries, "session_idle_timeout_ms"),
        session_startup_timeout_ms: _tc_int(schema, entries, "session_startup_timeout_ms"),
        session_debug: _tc_bool(schema, entries, "session_debug"),
        session_max_qemu_vm: _tc_int(schema, entries, "session_max_qemu_vm"),
        session_max_container: _tc_int(schema, entries, "session_max_container"),
        session_max_service: _tc_int(schema, entries, "session_max_service"),
        session_max_openocd: _tc_int(schema, entries, "session_max_openocd"),
        session_max_trace32: _tc_int(schema, entries, "session_max_trace32"),
        session_max_simulator: _tc_int(schema, entries, "session_max_simulator")
    )

# =========================================================================
# Loading
# =========================================================================

fn load_test_config_from_path(config_path: text) -> TestConfig:
    val config = TestConfig.defaults()
    # Deterministic-startup gate (pre-existing policy, kept behaviour-identical):
    # the runner boots on compiled defaults. The config_core-backed parse path
    # below is unit-proven (test/01_unit/lib/test_runner/test_config_spec.spl);
    # enabling it is a separate decision from this refactor because the checked-in
    # config/simple.test.sdn would change live runner behaviour (parallel,
    # timeout, throttling).
    return config
    if config_path == "":
        return config

    val content = file_read(config_path) ?? ""
    if content == "":
        return config

    var entries = test_config_entries(content: content, layer: "workspace")
    val env_entries = test_config_env_entries()
    var i = 0
    while i < env_entries.len():
        entries.push(env_entries[i])
        i = i + 1
    test_config_resolve(entries)

impl TestConfig:
    static fn load() -> TestConfig:
        load_test_config_from_path(find_config_file())

    static fn defaults() -> TestConfig:
        # Compiled defaults come straight from the schema — no second table.
        test_config_resolve([])

fn load_test_config() -> TestConfig:
    load_test_config_from_path(find_config_file())

# =========================================================================
# H1: Multi-level config file search
# =========================================================================

fn find_config_file() -> text:
    # Search current, parent, grandparent directories
    val candidates = [
        CONFIG_FILENAME,
        "../{CONFIG_FILENAME}",
        "../../{CONFIG_FILENAME}"
    ]
    var i = 0
    while i < candidates.len():
        val candidate = candidates[i]
        if file_exists(candidate):
            return candidate
        i = i + 1
    ""
