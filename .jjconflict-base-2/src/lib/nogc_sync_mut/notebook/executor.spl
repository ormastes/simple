# NotebookExecutor trait + mode-spec validation.
#
# Design:  doc/05_design/app/tools/notebook_lanes_architecture.md §4.1, §3
# Plan:    doc/03_plan/agent_tasks/notebook_lanes_parallel_plan_2026-08-07.md (Stream K, K1)
#
# Spec validation reuses the test runner's composite-mode extractor helpers
# (src/lib/nogc_sync_mut/test_runner/test_executor_composite_parse.spl) — the
# pure-parser twin of test_executor_composite.spl kept dependency-free exactly
# so callers like this one don't have to pull in remote/JIT backend code.
# GPU-A1 (cuda/vulkan backend recognition, incl. extract_gpu_submode and the
# vulkan-resident rejection diagnostic) is landed, so validation below is the
# real thing, not a stub.

use std.test_runner.test_executor_composite_parse.{
    extract_base_runtime, extract_platform_layer, extract_gpu_submode
}
use std.notebook.types.{LaneStatus, CellResult, SessionOpts}

# ============================================================================
# NotebookExecutor — one lane's session lifecycle + cell execution
# (design §4.1).
# ============================================================================

trait NotebookExecutor:
    fn mode_spec() -> text
    fn probe() -> LaneStatus
    me start(opts: SessionOpts)
    me execute_cell(code: text, cell_id: text) -> CellResult
    me interrupt()
    me reset()
    me shutdown()

# ============================================================================
# NotebookExecutorFactory — builds a NotebookExecutor for a validated mode
# spec. K1 defines the seam only; concrete factories (LocalExec, RemoteExec,
# CudaExec, VulkanExec) land in K2/K4/K5/K6.
# ============================================================================

trait NotebookExecutorFactory:
    me create(mode_spec: text) -> NotebookExecutor

# ============================================================================
# Mode-spec validation — mirrors run_test_file_composite's own dispatch
# decision (test_executor_composite.spl) so an invalid spec produces the
# runner's diagnostic verbatim (design §3): "Unknown platform: <platform>".
# Additionally rejects `vulkan(resident)` with the exact GPU-A1 diagnostic.
# ============================================================================

pub fn validate_mode_spec(spec: text) -> text:
    """Return "" when spec is a valid composite mode spec, otherwise the
    runner's own diagnostic text (verbatim)."""
    val trimmed = spec.trim()
    if trimmed == "":
        return "Unknown platform: "
    val base = extract_base_runtime(trimmed)
    val platform = extract_platform_layer(trimmed)
    if base == "jit":
        return ""
    if platform == "":
        # Plain base runtime (e.g. "interpreter") — no composite nesting.
        return ""
    if platform == "baremetal" or platform == "remote" or platform == "jit":
        val submode = extract_gpu_submode(trimmed)
        if submode.starts_with("resident submode requires"):
            return submode
        return ""
    "Unknown platform: {platform}"

pub fn mode_spec_is_valid(spec: text) -> bool:
    validate_mode_spec(spec) == ""
