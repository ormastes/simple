# codex-impl
# Pure-Simple VirtIO-snd MMIO transport for QEMU virtio-sound-device.

use os.kernel.boot.mmio.{mmio_read16, mmio_read32, mmio_write16, mmio_write32}

extern fn rt_memory_barrier()

val VIRTIO_SND_DEVICE_ID: u32 = 25
val VIRTIO_SND_QUEUE_CONTROL: u32 = 0
val VIRTIO_SND_QUEUE_EVENT: u32 = 1
val VIRTIO_SND_QUEUE_TX: u32 = 2
val VIRTIO_SND_QUEUE_RX: u32 = 3
val VIRTIO_SND_QUEUE_COUNT: u32 = 4

val VIRTIO_SND_MMIO_MAGIC: u64 = 0x000
val VIRTIO_SND_MMIO_VERSION: u64 = 0x004
val VIRTIO_SND_MMIO_DEVICE_ID: u64 = 0x008
val VIRTIO_SND_MMIO_DEVICE_FEATURES: u64 = 0x010
val VIRTIO_SND_MMIO_DEVICE_FEATURES_SEL: u64 = 0x014
val VIRTIO_SND_MMIO_DRIVER_FEATURES: u64 = 0x020
val VIRTIO_SND_MMIO_DRIVER_FEATURES_SEL: u64 = 0x024
val VIRTIO_SND_MMIO_QUEUE_SEL: u64 = 0x030
val VIRTIO_SND_MMIO_QUEUE_NUM_MAX: u64 = 0x034
val VIRTIO_SND_MMIO_QUEUE_NUM: u64 = 0x038
val VIRTIO_SND_MMIO_QUEUE_READY: u64 = 0x044
val VIRTIO_SND_MMIO_QUEUE_NOTIFY: u64 = 0x050
val VIRTIO_SND_MMIO_INTERRUPT_STATUS: u64 = 0x060
val VIRTIO_SND_MMIO_INTERRUPT_ACK: u64 = 0x064
val VIRTIO_SND_MMIO_STATUS: u64 = 0x070
val VIRTIO_SND_MMIO_QUEUE_DESC_LOW: u64 = 0x080
val VIRTIO_SND_MMIO_QUEUE_DESC_HIGH: u64 = 0x084
val VIRTIO_SND_MMIO_QUEUE_AVAIL_LOW: u64 = 0x090
val VIRTIO_SND_MMIO_QUEUE_AVAIL_HIGH: u64 = 0x094
val VIRTIO_SND_MMIO_QUEUE_USED_LOW: u64 = 0x0A0
val VIRTIO_SND_MMIO_QUEUE_USED_HIGH: u64 = 0x0A4
val VIRTIO_SND_MMIO_CONFIG_JACKS: u64 = 0x100
val VIRTIO_SND_MMIO_CONFIG_STREAMS: u64 = 0x104
val VIRTIO_SND_MMIO_CONFIG_CHMAPS: u64 = 0x108

val VIRTIO_SND_STATUS_ACKNOWLEDGE: u32 = 1
val VIRTIO_SND_STATUS_DRIVER: u32 = 2
val VIRTIO_SND_STATUS_DRIVER_OK: u32 = 4
val VIRTIO_SND_STATUS_FEATURES_OK: u32 = 8
val VIRTIO_SND_STATUS_FAILED: u32 = 128
val VIRTIO_F_VERSION_1_HIGH: u32 = 1
val VIRTQ_DESC_F_NEXT: u16 = 1
val VIRTQ_DESC_F_WRITE: u16 = 2

struct VirtioSndQueueMemory:
    desc_cpu: u64
    avail_cpu: u64
    used_cpu: u64
    desc: u64
    avail: u64
    used: u64
    size: u16

struct VirtioSndMmioProbe:
    status: text
    reason: text
    jacks: u32
    streams: u32
    chmaps: u32
    queues_ready: u32

struct VirtioSndUsedReceipt:
    status: text
    descriptor: u32
    bytes: u32
    next_used: u16

fn virtio_snd_queue_memory_valid(memory: VirtioSndQueueMemory) -> bool:
    if memory.size < 2 or memory.size > 256:
        return false
    if (memory.size & (memory.size - 1)) != 0:
        return false
    memory.desc_cpu != 0 and memory.avail_cpu != 0 and memory.used_cpu != 0 and
        memory.desc != 0 and memory.avail != 0 and memory.used != 0

fn virtio_snd_descriptor_valid(queue_size: u16, descriptor: u16, length: u32) -> bool:
    queue_size > 0 and descriptor < queue_size and length > 0

fn virtio_snd_chain_valid(queue_size: u16, head: u16, descriptor_count: u16) -> bool:
    descriptor_count > 0 and head < queue_size and head.to_u32() + descriptor_count.to_u32() <= queue_size.to_u32()

fn virtio_snd_mmio_find(start: u64, slots: i64, stride: u64) -> u64:
    if start == 0 or slots <= 0 or slots > 256 or stride < 0x100u64:
        return 0u64
    var slot: i64 = 0
    while slot < slots:
        val base = start + slot.to_u64() * stride
        if mmio_read32(base + VIRTIO_SND_MMIO_MAGIC) == 0x74726976u32 and
            mmio_read32(base + VIRTIO_SND_MMIO_VERSION) == 2u32 and
            mmio_read32(base + VIRTIO_SND_MMIO_DEVICE_ID) == VIRTIO_SND_DEVICE_ID:
            return base
        slot = slot + 1
    0u64

class VirtioSndMmioTransport:
    base: u64
    control: VirtioSndQueueMemory
    event: VirtioSndQueueMemory
    tx: VirtioSndQueueMemory
    rx: VirtioSndQueueMemory
    control_used: u16
    event_used: u16
    tx_used: u16
    rx_used: u16
    ready: bool
    queue_error: text

impl VirtioSndMmioTransport:
    static fn create(base: u64, control: VirtioSndQueueMemory, event: VirtioSndQueueMemory, tx: VirtioSndQueueMemory, rx: VirtioSndQueueMemory) -> VirtioSndMmioTransport:
        VirtioSndMmioTransport(base: base, control: control, event: event, tx: tx, rx: rx, control_used: 0, event_used: 0, tx_used: 0, rx_used: 0, ready: false, queue_error: "")

    fn read(offset: u64) -> u32:
        mmio_read32(self.base + offset)

    fn write(offset: u64, value: u32):
        mmio_write32(self.base + offset, value)

    fn fail(reason: text) -> VirtioSndMmioProbe:
        self.write(VIRTIO_SND_MMIO_STATUS, VIRTIO_SND_STATUS_FAILED)
        VirtioSndMmioProbe(status: "failed", reason: reason, jacks: 0, streams: 0, chmaps: 0, queues_ready: 0)

    me configure_queue(index: u32, memory: VirtioSndQueueMemory) -> bool:
        if not virtio_snd_queue_memory_valid(memory):
            self.queue_error = "memory-invalid size={memory.size} desc_cpu={memory.desc_cpu} avail_cpu={memory.avail_cpu} used_cpu={memory.used_cpu} desc={memory.desc} avail={memory.avail} used={memory.used}"
            return false
        self.write(VIRTIO_SND_MMIO_QUEUE_SEL, index)
        if self.read(VIRTIO_SND_MMIO_QUEUE_READY) != 0:
            self.queue_error = "already-ready"
            return false
        val maximum = self.read(VIRTIO_SND_MMIO_QUEUE_NUM_MAX)
        if maximum == 0:
            self.queue_error = "maximum-zero"
            return false
        if memory.size.to_u32() > maximum:
            self.queue_error = "size-exceeds-maximum-{maximum}"
            return false
        self.write(VIRTIO_SND_MMIO_QUEUE_NUM, memory.size.to_u32())
        self.write(VIRTIO_SND_MMIO_QUEUE_DESC_LOW, (memory.desc & 0xFFFFFFFFu64).to_u32())
        self.write(VIRTIO_SND_MMIO_QUEUE_DESC_HIGH, (memory.desc >> 32).to_u32())
        self.write(VIRTIO_SND_MMIO_QUEUE_AVAIL_LOW, (memory.avail & 0xFFFFFFFFu64).to_u32())
        self.write(VIRTIO_SND_MMIO_QUEUE_AVAIL_HIGH, (memory.avail >> 32).to_u32())
        self.write(VIRTIO_SND_MMIO_QUEUE_USED_LOW, (memory.used & 0xFFFFFFFFu64).to_u32())
        self.write(VIRTIO_SND_MMIO_QUEUE_USED_HIGH, (memory.used >> 32).to_u32())
        self.write(VIRTIO_SND_MMIO_QUEUE_READY, 1)
        self.queue_error = ""
        true

    me probe_and_start() -> VirtioSndMmioProbe:
        if self.base == 0:
            return self.fail("zero MMIO base")
        if self.read(VIRTIO_SND_MMIO_MAGIC) != 0x74726976:
            return self.fail("bad VirtIO magic")
        if self.read(VIRTIO_SND_MMIO_VERSION) != 2:
            return self.fail("VirtIO modern MMIO version required")
        if self.read(VIRTIO_SND_MMIO_DEVICE_ID) != VIRTIO_SND_DEVICE_ID:
            return self.fail("device is not VirtIO sound")

        self.write(VIRTIO_SND_MMIO_STATUS, 0)
        self.write(VIRTIO_SND_MMIO_STATUS, VIRTIO_SND_STATUS_ACKNOWLEDGE)
        self.write(VIRTIO_SND_MMIO_STATUS, VIRTIO_SND_STATUS_ACKNOWLEDGE | VIRTIO_SND_STATUS_DRIVER)
        self.write(VIRTIO_SND_MMIO_DEVICE_FEATURES_SEL, 1)
        val high_features = self.read(VIRTIO_SND_MMIO_DEVICE_FEATURES)
        if (high_features & VIRTIO_F_VERSION_1_HIGH) == 0:
            return self.fail("VIRTIO_F_VERSION_1 unavailable")
        self.write(VIRTIO_SND_MMIO_DRIVER_FEATURES_SEL, 0)
        self.write(VIRTIO_SND_MMIO_DRIVER_FEATURES, 0)
        self.write(VIRTIO_SND_MMIO_DRIVER_FEATURES_SEL, 1)
        self.write(VIRTIO_SND_MMIO_DRIVER_FEATURES, VIRTIO_F_VERSION_1_HIGH)
        val features_status = VIRTIO_SND_STATUS_ACKNOWLEDGE | VIRTIO_SND_STATUS_DRIVER | VIRTIO_SND_STATUS_FEATURES_OK
        self.write(VIRTIO_SND_MMIO_STATUS, features_status)
        if (self.read(VIRTIO_SND_MMIO_STATUS) & VIRTIO_SND_STATUS_FEATURES_OK) == 0:
            return self.fail("device rejected negotiated features")

        if not self.configure_queue(VIRTIO_SND_QUEUE_CONTROL, self.control):
            return self.fail("control queue unavailable: {self.queue_error}")
        if not self.configure_queue(VIRTIO_SND_QUEUE_EVENT, self.event):
            return self.fail("event queue unavailable: {self.queue_error}")
        if not self.configure_queue(VIRTIO_SND_QUEUE_TX, self.tx):
            return self.fail("playback queue unavailable: {self.queue_error}")
        if not self.configure_queue(VIRTIO_SND_QUEUE_RX, self.rx):
            return self.fail("capture queue unavailable: {self.queue_error}")

        self.write(VIRTIO_SND_MMIO_STATUS, features_status | VIRTIO_SND_STATUS_DRIVER_OK)
        self.ready = true
        VirtioSndMmioProbe(status: "ready", reason: "four VirtIO-snd queues configured", jacks: self.read(VIRTIO_SND_MMIO_CONFIG_JACKS), streams: self.read(VIRTIO_SND_MMIO_CONFIG_STREAMS), chmaps: self.read(VIRTIO_SND_MMIO_CONFIG_CHMAPS), queues_ready: 4)

    fn queue(index: u32) -> VirtioSndQueueMemory:
        if index == VIRTIO_SND_QUEUE_CONTROL: return self.control
        if index == VIRTIO_SND_QUEUE_EVENT: return self.event
        if index == VIRTIO_SND_QUEUE_TX: return self.tx
        self.rx

    fn submit(index: u32, descriptor: u16, buffer: u64, length: u32, device_writes: bool) -> bool:
        if not self.ready or index >= VIRTIO_SND_QUEUE_COUNT:
            return false
        val q = self.queue(index)
        if not virtio_snd_descriptor_valid(q.size, descriptor, length) or buffer == 0:
            return false
        val desc = q.desc_cpu + descriptor.to_u64() * 16
        mmio_write32(desc, (buffer & 0xFFFFFFFFu64).to_u32())
        mmio_write32(desc + 4, (buffer >> 32).to_u32())
        mmio_write32(desc + 8, length)
        val flags: u16 = if device_writes: VIRTQ_DESC_F_WRITE else: 0u16
        mmio_write16(desc + 12, flags)
        mmio_write16(desc + 14, 0)
        val avail_idx = mmio_read16(q.avail_cpu + 2)
        val slot = q.avail_cpu + 4 + ((avail_idx % q.size).to_u64() * 2)
        mmio_write16(slot, descriptor)
        rt_memory_barrier()
        mmio_write16(q.avail_cpu + 2, avail_idx + 1)
        rt_memory_barrier()
        self.write(VIRTIO_SND_MMIO_QUEUE_NOTIFY, index)
        true

    fn write_descriptor(q: VirtioSndQueueMemory, descriptor: u16, buffer: u64, length: u32, flags: u16, next: u16):
        val desc = q.desc_cpu + descriptor.to_u64() * 16
        mmio_write32(desc, (buffer & 0xFFFFFFFFu64).to_u32())
        mmio_write32(desc + 4, (buffer >> 32).to_u32())
        mmio_write32(desc + 8, length)
        mmio_write16(desc + 12, flags)
        mmio_write16(desc + 14, next)

    fn publish_chain(index: u32, q: VirtioSndQueueMemory, head: u16):
        val avail_idx = mmio_read16(q.avail_cpu + 2)
        val slot = q.avail_cpu + 4 + ((avail_idx % q.size).to_u64() * 2)
        mmio_write16(slot, head)
        rt_memory_barrier()
        mmio_write16(q.avail_cpu + 2, avail_idx + 1)
        rt_memory_barrier()
        self.write(VIRTIO_SND_MMIO_QUEUE_NOTIFY, index)

    fn submit_control(head: u16, request: u64, request_bytes: u32, response: u64, response_bytes: u32) -> bool:
        if not self.ready or request == 0 or response == 0:
            return false
        val q = self.control
        if not virtio_snd_chain_valid(q.size, head, 2u16) or request_bytes == 0 or response_bytes == 0:
            return false
        self.write_descriptor(q, head, request, request_bytes, VIRTQ_DESC_F_NEXT, head + 1)
        self.write_descriptor(q, head + 1, response, response_bytes, VIRTQ_DESC_F_WRITE, 0)
        self.publish_chain(VIRTIO_SND_QUEUE_CONTROL, q, head)
        true

    fn post_event(descriptor: u16, event_buffer: u64, event_bytes: u32) -> bool:
        self.submit(VIRTIO_SND_QUEUE_EVENT, descriptor, event_buffer, event_bytes, true)

    fn submit_pcm(index: u32, head: u16, xfer: u64, pcm: u64, pcm_bytes: u32, status: u64, capture: bool) -> bool:
        if not self.ready or (index != VIRTIO_SND_QUEUE_TX and index != VIRTIO_SND_QUEUE_RX):
            return false
        if xfer == 0 or pcm == 0 or status == 0 or pcm_bytes == 0:
            return false
        val q = self.queue(index)
        if not virtio_snd_chain_valid(q.size, head, 3u16):
            return false
        self.write_descriptor(q, head, xfer, 4u32, VIRTQ_DESC_F_NEXT, head + 1)
        val pcm_flags: u16 = if capture: VIRTQ_DESC_F_NEXT | VIRTQ_DESC_F_WRITE else: VIRTQ_DESC_F_NEXT
        self.write_descriptor(q, head + 1, pcm, pcm_bytes, pcm_flags, head + 2)
        self.write_descriptor(q, head + 2, status, 8u32, VIRTQ_DESC_F_WRITE, 0)
        self.publish_chain(index, q, head)
        true

    fn poll_used(index: u32, last_used: u16) -> VirtioSndUsedReceipt:
        if index >= VIRTIO_SND_QUEUE_COUNT:
            return VirtioSndUsedReceipt(status: "invalid-queue", descriptor: 0, bytes: 0, next_used: last_used)
        val q = self.queue(index)
        val device_used = mmio_read16(q.used_cpu + 2)
        if device_used == last_used:
            return VirtioSndUsedReceipt(status: "pending", descriptor: 0, bytes: 0, next_used: last_used)
        val slot = q.used_cpu + 4 + ((last_used % q.size).to_u64() * 8)
        val descriptor = mmio_read32(slot)
        val bytes = mmio_read32(slot + 4)
        if descriptor >= q.size.to_u32():
            return VirtioSndUsedReceipt(status: "malformed", descriptor: descriptor, bytes: bytes, next_used: last_used + 1)
        VirtioSndUsedReceipt(status: "completed", descriptor: descriptor, bytes: bytes, next_used: last_used + 1)

    fn acknowledge_interrupt() -> u32:
        val pending = self.read(VIRTIO_SND_MMIO_INTERRUPT_STATUS)
        if pending != 0:
            self.write(VIRTIO_SND_MMIO_INTERRUPT_ACK, pending)
        pending

    me reset():
        if self.base != 0:
            self.write(VIRTIO_SND_MMIO_STATUS, 0)
            rt_memory_barrier()
        self.ready = false

export VIRTIO_SND_QUEUE_CONTROL, VIRTIO_SND_QUEUE_EVENT, VIRTIO_SND_QUEUE_TX, VIRTIO_SND_QUEUE_RX
export VirtioSndQueueMemory, VirtioSndMmioProbe, VirtioSndUsedReceipt, VirtioSndMmioTransport
export virtio_snd_queue_memory_valid, virtio_snd_descriptor_valid, virtio_snd_chain_valid
export virtio_snd_mmio_find
