#!/bin/sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

ASSEMBLY="/tmp/simple_vulkan_source_storage_buffer.spvasm"
BINARY="/tmp/simple_vulkan_source_storage_buffer.spv"
SPIRV_AS="${SPIRV_AS:-spirv-as}"
SPIRV_VAL="${SPIRV_VAL:-spirv-val}"
SIMPLE_BIN="${SIMPLE_BIN:-bin/simple}"

command -v "$SPIRV_AS" >/dev/null 2>&1
command -v "$SPIRV_VAL" >/dev/null 2>&1
rm -f "$ASSEMBLY" "$BINARY"

"$SIMPLE_BIN" test test/01_unit/compiler/backend/vulkan_source_storage_buffer_abi_spec.spl \
    --mode=interpreter --no-session-daemon --sequential --no-db --no-cache \
    --assert-ran --fail-fast
test -s "$ASSEMBLY"
"$SPIRV_AS" --target-env vulkan1.3 "$ASSEMBLY" -o "$BINARY"
"$SPIRV_VAL" --target-env vulkan1.3 "$BINARY"
test -s "$BINARY"
