struct ZeroArgEvidence:
    marker: i64

class ZeroArgReceiver:
    var execution_target: text
    var performance_evidence: ZeroArgEvidence? = nil
    var marker_value: i64 = 0

impl ZeroArgReceiver:
    fn target() -> text:
        self.execution_target

    fn evidence() -> ZeroArgEvidence?:
        self.performance_evidence

    fn marker() -> i64:
        self.marker_value

class ZeroArgReceiverOwner:
    var poison_execution_target: text
    var poison_performance_evidence: ZeroArgEvidence? = nil
    var poison_marker_value: i64 = 0
    var active: [ZeroArgReceiver]

impl ZeroArgReceiverOwner:
    fn first_marker() -> i64:
        val receiver: ZeroArgReceiver = self.active[0]
        receiver.marker()

export ZeroArgEvidence, ZeroArgReceiver, ZeroArgReceiverOwner
