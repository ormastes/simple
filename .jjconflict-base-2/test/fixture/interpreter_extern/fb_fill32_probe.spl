# Fixture for test/01_unit/compiler/interpreter_extern/fb_image_log_socket_registration_spec.spl.
# Calls a real rt_fb_* extern that previously had no interpreter dispatch
# entry (runtime_framebuffer.c was already compiled into the interpreter
# crate's static archive, but nothing declared/called the symbol from Rust,
# so nothing pulled the object file's symbols in). Before the fix this died
# with `unknown extern function: rt_fb_fill32`. dst_addr=0/pixel_count=0 is a
# deliberate no-op guard inside rt_fb_fill32 itself (see
# runtime_framebuffer.c), so the probe is safe without a real framebuffer.

extern fn rt_fb_fill32(dst_addr: u64, pixel_count: u64, color: u64)

fn main() -> i64:
    rt_fb_fill32(0, 0, 0)
    print "fb_fill32_result=ok"
    0
