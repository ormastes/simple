# Range (".." ) handling across every math_repr renderer.
#
# ".." tokenises to a token the expression grammar originally did not recognise,
# so parsing silently stopped after the "from" half and the "to" bound was
# dropped. Each example below is an exact-string assertion so it discriminates
# against the truncated output rather than merely containing a substring.
#
# Literal braces are escaped as \{ \} -- an unescaped { starts interpolation.

use std.math_repr.{render_latex_raw, to_pretty, to_text, to_debug}

describe "math_repr range handling":

    context "bounded operators split the range into sub/superscript":
        it "renders sum bounds as _{var=from}^{to}":
            expect(render_latex_raw("sum(i, 1..n) i")).to_equal("\\sum_\{i=1\}^\{n\} i")

        it "renders int bounds as _{from}^{to}":
            expect(render_latex_raw("int(x, 0..1) x")).to_equal("\\int_\{0\}^\{1\} x")

    context "the range production keeps both bounds everywhere else":
        it "renders a bare range":
            expect(render_latex_raw("1..n")).to_equal("1 \\ldots n")

        it "renders a range inside a known-function argument list":
            expect(render_latex_raw("lim(x, 0..1) x")).to_equal("\\lim(x, 0 \\ldots 1) x")

        it "renders a range inside a plain function-call argument":
            expect(render_latex_raw("f(1..n)")).to_equal("\\operatorname\{f\}(1 \\ldots n)")

        it "renders a range inside a subscript bracket":
            expect(render_latex_raw("a[1..n]")).to_equal("a_\{1 \\ldots n\}")

    context "range splitting is nesting-aware":
        it "splits int bounds on the top-level .. not a nested one":
            expect(render_latex_raw("int(x, f(a..b)..n) x")).to_equal("\\int_\{\\operatorname\{f\}(a \\ldots b)\}^\{n\} x")

    context "the other renderers keep both bounds too":
        it "pretty keeps the range":
            expect(to_pretty("f(1..n)")).to_equal("f(1..n)")

        it "text keeps the range":
            expect(to_text("f(1..n)")).to_equal("f(1..n)")

        it "debug emits a Range node":
            expect(to_debug("f(1..n)")).to_equal("Call(f, Range(Num(1), Id(n)))")
