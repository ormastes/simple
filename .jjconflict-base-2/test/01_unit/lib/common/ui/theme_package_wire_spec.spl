# @cover src/lib/common/ui/theme_package_wire.spl
# @cover src/lib/common/base_encoding/utilities.spl
# @tag: unit, ui, theme, wire

use std.spec.*
use common.ui.theme_render_snapshot.{ThemeShadowLayer, ThemeMaterialSemantics, ThemeRenderSnapshot, theme_material_sha256}
use common.ui.theme_package_wire.*

val SOURCE_HASH: text = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn _repeat_text(unit: text, count: i64) -> text:
    val builder = StringBuilder.new()
    var i = 0
    while i < count:
        builder.push(unit)
        i = i + 1
    builder.to_text()

fn _shadow(index: i64) -> ThemeShadowLayer:
    ThemeShadowLayer(
        offset_x_px: index.to_i32() - 3,
        offset_y_px: index.to_i32() + 1,
        blur_radius_px: index.to_i32() + 2,
        spread_radius_px: index.to_i32() - 1,
        rgba: (1000000000 + index).to_u32(),
        inset: index % 2 == 1
    )

fn _shadows(count: i64) -> [ThemeShadowLayer]:
    var shadows: [ThemeShadowLayer] = []
    var i = 0
    while i < count:
        shadows = shadows.push(_shadow(i))
        i = i + 1
    shadows

fn _snapshot_with(
    id: text,
    family_id: text,
    composed_css: text,
    gradient_css: text,
    active_count: i64,
    inactive_count: i64
) -> ThemeRenderSnapshot:
    val material = ThemeMaterialSemantics(
        desktop_fill_rgba: 4278190081u32,
        window_fill_rgba: 4278255362u32,
        active_title_fill_rgba: 4278320899u32,
        inactive_title_fill_rgba: 4278386436u32,
        surface_alpha_milli: 875,
        backdrop_blur_px: 30,
        backdrop_saturation_milli: 1700,
        border_width_px: 1,
        border_rgba: 4294901760u32,
        corner_radius_px: 18,
        active_shadows: _shadows(active_count),
        inactive_shadows: _shadows(inactive_count),
        font_family: "Manrope 한글 ✓",
        font_size_px: 14,
        font_weight: 650,
        text_rgba: 4294967295u32,
        secondary_text_rgba: 3435973836u32,
        solid_fallback_rgba: 4279308561u32,
        fallback_contrast_milli: 4700,
        window_gradient_available: true,
        window_gradient_start_rgba: 352321535u32,
        window_gradient_end_rgba: 100663551u32,
        window_gradient_source_css: gradient_css
    )
    ThemeRenderSnapshot(
        id: id,
        family_id: family_id,
        source_reference: "stitch/유리\nsource.html",
        source_manifest_sha256: SOURCE_HASH,
        material_sha256: theme_material_sha256(material),
        composed_css: composed_css,
        background_rgba: 4278190081u32,
        foreground_rgba: 4294967295u32,
        accent_rgba: 4289379276u32,
        material: material
    )

fn _wire_snapshot() -> ThemeRenderSnapshot:
    _snapshot_with(
        "glass",
        "aetheric",
        ":root { --glass: \"✓\"; }\n.wm { backdrop-filter: blur(30px); }\n\0",
        "linear-gradient(135deg, #0f172a 0%, \"한글\" 50%)\n\0",
        2,
        2
    )

fn _snapshot_wire() -> text:
    match theme_render_snapshot_wire_v1_encode(_wire_snapshot()):
        Err(_error):
            expect(false).to_equal(true)
            ""
        Ok(wire):
            wire

fn _expect_snapshot_decode_error(wire: text, family: text):
    match theme_render_snapshot_wire_v1_decode(wire):
        Ok(_snapshot):
            expect(false).to_equal(true)
        Err(error):
            expect(error).to_contain(family)

fn _expect_install_decode_error(wire: text, family: text):
    match theme_package_install_wire_v1_decode(wire):
        Ok(_projection):
            expect(false).to_equal(true)
        Err(error):
            expect(error).to_contain(family)

fn _expect_snapshot_encode_error(snapshot: ThemeRenderSnapshot, family: text):
    match theme_render_snapshot_wire_v1_encode(snapshot):
        Ok(_wire):
            expect(false).to_equal(true)
        Err(error):
            expect(error).to_contain(family)

fn _expect_install_encode_error(requested_id: text, default_id: text, registry_path: text, snapshot: ThemeRenderSnapshot, family: text):
    match theme_package_install_wire_v1_encode(requested_id, default_id, registry_path, snapshot):
        Ok(_wire):
            expect(false).to_equal(true)
        Err(error):
            expect(error).to_contain(family)

fn _expect_shadow_equal(actual: ThemeShadowLayer, expected: ThemeShadowLayer):
    expect(actual.offset_x_px).to_equal(expected.offset_x_px)
    expect(actual.offset_y_px).to_equal(expected.offset_y_px)
    expect(actual.blur_radius_px).to_equal(expected.blur_radius_px)
    expect(actual.spread_radius_px).to_equal(expected.spread_radius_px)
    expect(actual.rgba).to_equal(expected.rgba)
    expect(actual.inset).to_equal(expected.inset)

fn _expect_snapshot_equal(actual: ThemeRenderSnapshot, expected: ThemeRenderSnapshot):
    expect(actual.id).to_equal(expected.id)
    expect(actual.family_id).to_equal(expected.family_id)
    expect(actual.source_reference).to_equal(expected.source_reference)
    expect(actual.source_manifest_sha256).to_equal(expected.source_manifest_sha256)
    expect(actual.material_sha256).to_equal(expected.material_sha256)
    expect(actual.composed_css).to_equal(expected.composed_css)
    expect(actual.background_rgba).to_equal(expected.background_rgba)
    expect(actual.foreground_rgba).to_equal(expected.foreground_rgba)
    expect(actual.accent_rgba).to_equal(expected.accent_rgba)

    val actual_material = actual.material
    val expected_material = expected.material
    expect(actual_material.desktop_fill_rgba).to_equal(expected_material.desktop_fill_rgba)
    expect(actual_material.window_fill_rgba).to_equal(expected_material.window_fill_rgba)
    expect(actual_material.active_title_fill_rgba).to_equal(expected_material.active_title_fill_rgba)
    expect(actual_material.inactive_title_fill_rgba).to_equal(expected_material.inactive_title_fill_rgba)
    expect(actual_material.surface_alpha_milli).to_equal(expected_material.surface_alpha_milli)
    expect(actual_material.backdrop_blur_px).to_equal(expected_material.backdrop_blur_px)
    expect(actual_material.backdrop_saturation_milli).to_equal(expected_material.backdrop_saturation_milli)
    expect(actual_material.border_width_px).to_equal(expected_material.border_width_px)
    expect(actual_material.border_rgba).to_equal(expected_material.border_rgba)
    expect(actual_material.corner_radius_px).to_equal(expected_material.corner_radius_px)
    expect(actual_material.active_shadows.len()).to_equal(expected_material.active_shadows.len())
    expect(actual_material.inactive_shadows.len()).to_equal(expected_material.inactive_shadows.len())
    var i = 0
    while i < actual_material.active_shadows.len():
        _expect_shadow_equal(actual_material.active_shadows[i], expected_material.active_shadows[i])
        i = i + 1
    i = 0
    while i < actual_material.inactive_shadows.len():
        _expect_shadow_equal(actual_material.inactive_shadows[i], expected_material.inactive_shadows[i])
        i = i + 1
    expect(actual_material.font_family).to_equal(expected_material.font_family)
    expect(actual_material.font_size_px).to_equal(expected_material.font_size_px)
    expect(actual_material.font_weight).to_equal(expected_material.font_weight)
    expect(actual_material.text_rgba).to_equal(expected_material.text_rgba)
    expect(actual_material.secondary_text_rgba).to_equal(expected_material.secondary_text_rgba)
    expect(actual_material.solid_fallback_rgba).to_equal(expected_material.solid_fallback_rgba)
    expect(actual_material.fallback_contrast_milli).to_equal(expected_material.fallback_contrast_milli)
    expect(actual_material.window_gradient_available).to_equal(expected_material.window_gradient_available)
    expect(actual_material.window_gradient_start_rgba).to_equal(expected_material.window_gradient_start_rgba)
    expect(actual_material.window_gradient_end_rgba).to_equal(expected_material.window_gradient_end_rgba)
    expect(actual_material.window_gradient_source_css).to_equal(expected_material.window_gradient_source_css)

fn _decode_and_expect_equal(wire: text, expected: ThemeRenderSnapshot):
    match theme_render_snapshot_wire_v1_decode(wire):
        Err(_error):
            expect(false).to_equal(true)
        Ok(decoded):
            _expect_snapshot_equal(decoded, expected)

describe "theme render snapshot wire v1 round trip":

    it "round-trips every scalar Unicode multiline NUL gradient and shadow field":
        val original = _wire_snapshot()
        _decode_and_expect_equal(_snapshot_wire(), original)

    it "emits deterministic lowercase canonical text":
        val first = _snapshot_wire()
        val second = _snapshot_wire()
        expect(first).to_equal(second)
        expect(first).to_contain("id=676c617373\n")
        match theme_render_snapshot_wire_v1_decode(first):
            Err(_error):
                expect(false).to_equal(true)
            Ok(snapshot):
                match theme_render_snapshot_wire_v1_encode(snapshot):
                    Err(_error): expect(false).to_equal(true)
                    Ok(encoded): expect(encoded).to_equal(first)

    it "round-trips zero and exact maximum active and inactive shadow counts":
        val zero = _snapshot_with("zero", "family", "", "", 0, 0)
        match theme_render_snapshot_wire_v1_encode(zero):
            Err(_error): expect(false).to_equal(true)
            Ok(wire): _decode_and_expect_equal(wire, zero)

        val maximum = _snapshot_with("maximum", "family", "", "", 32, 32)
        match theme_render_snapshot_wire_v1_encode(maximum):
            Err(_error): expect(false).to_equal(true)
            Ok(wire): _decode_and_expect_equal(wire, maximum)

    it "round-trips an exact 262144-byte field through the linear buffer path":
        val maximum_css = _repeat_text("x", THEME_RENDER_SNAPSHOT_WIRE_V1_MAX_TEXT_BYTES)
        val snapshot = _snapshot_with("maximum_text", "family", maximum_css, "", 0, 0)
        match theme_render_snapshot_wire_v1_encode(snapshot):
            Err(_error): expect(false).to_equal(true)
            Ok(wire):
                expect(wire.len()).to_be_greater_than(THEME_RENDER_SNAPSHOT_WIRE_V1_MAX_TEXT_BYTES)
                _decode_and_expect_equal(wire, snapshot)

describe "theme render snapshot wire v1 precise rejection":

    it "rejects wrong magic missing final newline complete trailing and duplicate lines":
        val wire = _snapshot_wire()
        _expect_snapshot_decode_error(wire.replace(THEME_RENDER_SNAPSHOT_WIRE_V1_MAGIC, "theme-render-snapshot-wire-v2"), "wrong magic/version")
        _expect_snapshot_decode_error(wire.slice(0, wire.len() - 1), "missing final newline")
        _expect_snapshot_decode_error(wire + "extra=0\n", "trailing or duplicate field")
        _expect_snapshot_decode_error(wire.replace("id=676c617373\n", "id=676c617373\nid=676c617373\n"), "expected field family_id")

    it "accepts lowercase hex and rejects odd uppercase malformed and invalid UTF-8 hex":
        val wire = _snapshot_wire()
        _decode_and_expect_equal(wire, _wire_snapshot())
        _expect_snapshot_decode_error(wire.replace("id=676c617373", "id=676c61737"), "odd length")
        _expect_snapshot_decode_error(wire.replace("id=676c617373", "id=676C617373"), "malformed or noncanonical")
        _expect_snapshot_decode_error(wire.replace("id=676c617373", "id=0g"), "malformed or noncanonical")
        _expect_snapshot_decode_error(wire.replace("id=676c617373", "id=ff"), "does not decode to UTF-8")

    it "rejects bool and every signed or unsigned canonical range branch":
        val wire = _snapshot_wire()
        _expect_snapshot_decode_error(wire.replace("window_gradient_available=1", "window_gradient_available=2"), "bool must be 0 or 1")
        _expect_snapshot_decode_error(wire.replace("background_rgba=4278190081", "background_rgba=04278190081"), "unsigned number is noncanonical")
        _expect_snapshot_decode_error(wire.replace("background_rgba=4278190081", "background_rgba=4294967296"), "overflows u32")
        _expect_snapshot_decode_error(wire.replace("surface_alpha_milli=875", "surface_alpha_milli=-0"), "negative zero")
        _expect_snapshot_decode_error(wire.replace("backdrop_blur_px=30", "backdrop_blur_px=2147483648"), "overflows i32")
        _expect_snapshot_decode_error(wire.replace("corner_radius_px=18", "corner_radius_px=-2147483649"), "overflows i32")

    it "rejects malformed and short source and material hashes independently":
        val wire = _snapshot_wire()
        _expect_snapshot_decode_error(wire.replace(SOURCE_HASH, "Aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"), "source_manifest_sha256 is malformed")
        _expect_snapshot_decode_error(wire.replace(SOURCE_HASH, "aaaa"), "source_manifest_sha256 is malformed")
        val snapshot = _wire_snapshot()
        val material_hash = snapshot.material_sha256
        val material_hash_line = "material_sha256={material_hash}"
        val material_hash_tail = material_hash.slice(1, material_hash.len())
        _expect_snapshot_decode_error(wire.replace(material_hash_line, "material_sha256=Z{material_hash_tail}"), "material_sha256 is malformed")
        _expect_snapshot_decode_error(wire.replace(material_hash_line, "material_sha256=bbbb"), "material_sha256 is malformed")

    it "rejects material mismatch inactive count overflow and count body mismatch":
        val wire = _snapshot_wire()
        _expect_snapshot_decode_error(wire.replace("font_weight=650", "font_weight=651"), "does not match material")
        _expect_snapshot_decode_error(wire.replace("inactive_shadow_count=2", "inactive_shadow_count=33"), "shadow count exceeds limit")
        _expect_snapshot_decode_error(wire.replace("active_shadow_count=2", "active_shadow_count=1"), "expected field inactive_shadow_count")

    it "rejects empty required snapshot ids and fields over 262144 bytes":
        _expect_snapshot_encode_error(_snapshot_with("", "family", "", "", 0, 0), "snapshot id and family_id are required")
        _expect_snapshot_encode_error(_snapshot_with("id", "", "", "", 0, 0), "snapshot id and family_id are required")
        val too_large = _repeat_text("x", THEME_RENDER_SNAPSHOT_WIRE_V1_MAX_TEXT_BYTES + 1)
        _expect_snapshot_encode_error(_snapshot_with("id", "family", too_large, "", 0, 0), "text field exceeds byte limit")

    it "rejects snapshot and install envelopes over 1 MiB before parsing":
        val snapshot_body = _repeat_text("x", THEME_RENDER_SNAPSHOT_WIRE_V1_MAX_BYTES)
        val oversized_snapshot = "{THEME_RENDER_SNAPSHOT_WIRE_V1_MAGIC}\n{snapshot_body}"
        _expect_snapshot_decode_error(oversized_snapshot, "wire size is invalid")
        val install_body = _repeat_text("x", THEME_PACKAGE_INSTALL_WIRE_V1_MAX_UTF8_BYTES)
        val oversized_install = "{THEME_PACKAGE_INSTALL_WIRE_V1_MAGIC}\n{install_body}"
        _expect_install_decode_error(oversized_install, "wire size is invalid")

    it "rejects an encoded snapshot whose two exact-max text fields exceed 1 MiB":
        val maximum_text = _repeat_text("x", THEME_RENDER_SNAPSHOT_WIRE_V1_MAX_TEXT_BYTES)
        _expect_snapshot_encode_error(_snapshot_with("id", "family", maximum_text, maximum_text, 0, 0), "encoded snapshot exceeds wire limit")

describe "theme package install wire v1":

    it "round-trips immutable install metadata and canonical snapshot text":
        val snapshot = _wire_snapshot()
        match theme_package_install_wire_v1_encode("glass", "aetheric_dark", "config/themes/theme.sdn", snapshot):
            Err(_error): expect(false).to_equal(true)
            Ok(wire):
                expect(theme_package_install_wire_v1_utf8_byte_len(wire)).to_equal(wire.len())
                expect(theme_package_install_wire_v1_within_bound(wire)).to_equal(true)
                match theme_package_install_wire_v1_decode(wire):
                    Err(_error): expect(false).to_equal(true)
                    Ok(projection):
                        expect(projection.requested_id).to_equal("glass")
                        expect(projection.default_id).to_equal("aetheric_dark")
                        expect(projection.registry_path).to_equal("config/themes/theme.sdn")
                        _expect_snapshot_equal(projection.snapshot, snapshot)
                        match theme_package_install_wire_v1_encode(projection.requested_id, projection.default_id, projection.registry_path, projection.snapshot):
                            Err(_error): expect(false).to_equal(true)
                            Ok(reencoded): expect(reencoded).to_equal(wire)

    it "accepts exact 4096-byte metadata and rejects the next byte":
        val exact = _repeat_text("m", THEME_PACKAGE_INSTALL_WIRE_V1_MAX_METADATA_BYTES)
        val snapshot = _wire_snapshot()
        match theme_package_install_wire_v1_encode(exact, exact, exact, snapshot):
            Err(_error): expect(false).to_equal(true)
            Ok(wire):
                match theme_package_install_wire_v1_decode(wire):
                    Err(_error): expect(false).to_equal(true)
                    Ok(projection): expect(projection.requested_id).to_equal(exact)
        _expect_install_encode_error("{exact}x", "default", "registry", snapshot, "install metadata exceeds byte limit")

    it "rejects empty metadata nested snapshot overflow and malformed nested wire":
        val snapshot = _wire_snapshot()
        _expect_install_encode_error("", "default", "registry", snapshot, "install metadata is required")
        _expect_install_encode_error("requested", "", "registry", snapshot, "install metadata is required")
        _expect_install_encode_error("requested", "default", "", snapshot, "install metadata is required")
        val nested_too_large = _snapshot_with("large", "family", _repeat_text("x", 131072), "", 0, 0)
        _expect_install_encode_error("requested", "default", "registry", nested_too_large, "snapshot is too large for install wire")

        match theme_package_install_wire_v1_encode("glass", "aetheric_dark", "config/themes/theme.sdn", snapshot):
            Err(_error): expect(false).to_equal(true)
            Ok(wire):
                _expect_install_decode_error(wire.replace("snapshot_wire=7468656d", "snapshot_wire=7568656d"), "wrong magic/version")

    it "reports empty and over-1-MiB install texts outside the shared bound":
        expect(theme_package_install_wire_v1_within_bound("")).to_equal(false)
        val oversized = _repeat_text("x", THEME_PACKAGE_INSTALL_WIRE_V1_MAX_UTF8_BYTES + 1)
        expect(theme_package_install_wire_v1_utf8_byte_len(oversized)).to_equal(THEME_PACKAGE_INSTALL_WIRE_V1_MAX_UTF8_BYTES + 1)
        expect(theme_package_install_wire_v1_within_bound(oversized)).to_equal(false)

    it "rejects complete trailing duplicate odd and uppercase install fields":
        val snapshot = _wire_snapshot()
        match theme_package_install_wire_v1_encode("glass", "aetheric_dark", "config/themes/theme.sdn", snapshot):
            Err(_error): expect(false).to_equal(true)
            Ok(wire):
                _expect_install_decode_error(wire + "extra=0\n", "trailing or duplicate field")
                _expect_install_decode_error(wire.replace("requested_id=676c617373\n", "requested_id=676c617373\nrequested_id=676c617373\n"), "expected field default_id")
                _expect_install_decode_error(wire.replace("requested_id=676c617373", "requested_id=676c61737"), "odd length")
                _expect_install_decode_error(wire.replace("requested_id=676c617373", "requested_id=676C617373"), "malformed or noncanonical")
