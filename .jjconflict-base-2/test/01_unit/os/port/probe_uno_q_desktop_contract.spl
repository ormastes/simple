use os.port.uno_q_desktop_contract.{
    UNO_Q_QRB2210_BOARD_ID,
    UNO_Q_STM32U585_BOARD_ID,
    UNO_Q_DESKTOP_CAP_DISPLAY,
    UNO_Q_DESKTOP_CAP_WINDOW_EVENT,
    UNO_Q_DESKTOP_CAP_AUDIO,
    UNO_Q_DESKTOP_STATUS_PORT_UNAVAILABLE,
    UNO_Q_DESKTOP_STATUS_UNSUPPORTED_MCU,
    UNO_Q_DESKTOP_STATUS_INVALID,
    uno_q_desktop_backend_status,
    uno_q_desktop_backend_reason,
    uno_q_desktop_can_claim_wm,
}

fn main() -> i64:
    if (uno_q_desktop_backend_status(
        UNO_Q_QRB2210_BOARD_ID,
        UNO_Q_DESKTOP_CAP_DISPLAY
    ) != UNO_Q_DESKTOP_STATUS_PORT_UNAVAILABLE or
        uno_q_desktop_backend_status(
            UNO_Q_QRB2210_BOARD_ID,
            UNO_Q_DESKTOP_CAP_WINDOW_EVENT
        ) != UNO_Q_DESKTOP_STATUS_PORT_UNAVAILABLE or
        uno_q_desktop_backend_status(
            UNO_Q_QRB2210_BOARD_ID,
            UNO_Q_DESKTOP_CAP_AUDIO
        ) != UNO_Q_DESKTOP_STATUS_PORT_UNAVAILABLE):
        return 1
    if (uno_q_desktop_backend_status(
        UNO_Q_STM32U585_BOARD_ID,
        UNO_Q_DESKTOP_CAP_DISPLAY
    ) != UNO_Q_DESKTOP_STATUS_UNSUPPORTED_MCU or
        uno_q_desktop_can_claim_wm(UNO_Q_STM32U585_BOARD_ID)):
        return 2
    if (uno_q_desktop_backend_status(
        "unknown", 99
    ) != UNO_Q_DESKTOP_STATUS_INVALID):
        return 3
    if (uno_q_desktop_backend_reason(
        UNO_Q_QRB2210_BOARD_ID,
        UNO_Q_DESKTOP_CAP_AUDIO
    ) != "qrb2210-simpleos-port-unavailable" or
        uno_q_desktop_backend_reason(
            UNO_Q_STM32U585_BOARD_ID,
            UNO_Q_DESKTOP_CAP_WINDOW_EVENT
        ) != "stm32u585-is-coprocessor-not-desktop"):
        return 4
    0
