# @cover src/os/services/update/tuf_signing.spl 30%
"""
# TUF End-To-End Accepted Update (Real Ed25519)

**Category:** Update security
**Status:** Real cryptography (Ed25519)

## Overview

The positive end-to-end oracle for `verify_update_signed`: four TUF roles, each
carrying a genuine Ed25519 signature over its canonical bytes, with versions and
snapshot pinning arranged so no structural defense fires. The result must be
ACCEPTED with reason `TUF_ACCEPTED`.

This is the case the forgery calibrations in `tuf_forgery_spec.spl` are measured
against: without a green baseline, "everything is rejected" would look like a
passing security test.

## Budget note

This single example costs eight Ed25519 operations — four signatures at module
level and four verifications inside `verify_update_signed` — at roughly 2.8 s
each, because the JIT bails with `HIR lowering error: Unknown type: u128` and
the primitive runs interpreted. That is why it occupies a file of its own: a
spec gets roughly 60 s of wall clock before the runner reports
"no examples executed".
"""

use std.spec
use os.crypto.ed25519.{ed25519_keypair_from_seed, ed25519_sign}
use os.services.update.tuf_metadata.{RoleMetadata, CurrentVersions, TUF_ACCEPTED}
use os.services.update.tuf_signing.{
    RoleSignature,
    SignedRole,
    TrustedKey,
    canonical_role_bytes,
    verify_update_signed
}

fn seed_of(n: u64) -> [u8]:
    var s: [u8] = []
    var i: u64 = 0
    while i < 32:
        s = s.push(((i * 7 + n * 31 + 3) % 251).to_u8())
        i = i + 1
    return s

fn mk_role(role: text, ver: u64, deleg: List<text>, rtv: u64) -> RoleMetadata:
    return RoleMetadata(
        role: role,
        version: ver,
        expires_at: 2000,
        threshold: 1,
        signer_key_ids: ["kA"],
        signatures_present: [],
        delegated_key_ids: deleg,
        recorded_targets_version: rtv)

val KP_A: ([u8], [u8]) = ed25519_keypair_from_seed(seed_of(1))
val PUB_A: [u8] = KP_A.1

fn signed_a(meta: RoleMetadata) -> SignedRole:
    """Sign `meta` with the root-trusted key kA over its canonical bytes."""
    return SignedRole(
        meta: meta,
        signatures: [RoleSignature(
            key_id: "kA",
            sig: ed25519_sign(KP_A.0, PUB_A, canonical_role_bytes(meta)))])

# Snapshot pins targets version 11, matching the targets role, so the
# mix-and-match defense does not fire. Versions equal `CURRENT`, so rollback
# does not fire. `now` (100) is well inside expires_at (2000).
val S_ROOT: SignedRole = signed_a(mk_role("root", 5, ["kA"], 0))
val S_TS:   SignedRole = signed_a(mk_role("timestamp", 6, [], 0))
val S_SNAP: SignedRole = signed_a(mk_role("snapshot", 4, [], 11))
val S_TGT:  SignedRole = signed_a(mk_role("targets", 11, [], 0))

val KEYRING: List<TrustedKey> = [TrustedKey(key_id: "kA", public_key: PUB_A)]
val CURRENT: CurrentVersions = CurrentVersions(root: 5, timestamp: 6, snapshot: 4, targets: 11)

# ============================================================================

describe "TUF accepts a correctly signed four-role update":
    """The green baseline: four real signatures, every defense satisfied."""

    it "a fully valid signed update is ACCEPTED":
        """All four signatures verify and no structural defense fires."""
        val touch = S_ROOT
        val out = verify_update_signed(touch, S_TS, S_SNAP, S_TGT, KEYRING, CURRENT, 100)
        assert_true(out.accepted)
        assert_eq(out.reason_code, TUF_ACCEPTED)
