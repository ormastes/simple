use os.drivers.audio.hda_pci_binding.{
    HDA_PCI_NOT_FOUND,
    HDA_PCI_INVALID_RESOURCES,
    HDA_PCI_INVALID_COUNT,
    hda_pci_find_index,
    hda_pci_bar0,
    hda_pci_irq,
    hda_pci_bdf,
    hda_pci_vendor,
    hda_pci_device,
    hda_pci_enable,
}

extern fn rt_hda_pci_probe_set_mode(mode: i64)

fn main() -> i64:
    rt_hda_pci_probe_set_mode(0)
    if hda_pci_find_index() != HDA_PCI_NOT_FOUND:
        return 1
    rt_hda_pci_probe_set_mode(1)
    if hda_pci_find_index() != HDA_PCI_INVALID_RESOURCES:
        return 2
    rt_hda_pci_probe_set_mode(2)
    val index = hda_pci_find_index()
    if (index != 1 or hda_pci_bar0(index) != 0xfebf0000 or
        hda_pci_irq(index) != 11 or hda_pci_bdf(index) != 6912 or
        hda_pci_vendor(index) != 32902 or
        hda_pci_device(index) != 9832 or not hda_pci_enable(index)):
        return 3
    rt_hda_pci_probe_set_mode(3)
    if hda_pci_find_index() != 1:
        return 4
    rt_hda_pci_probe_set_mode(4)
    if hda_pci_find_index() != HDA_PCI_INVALID_COUNT:
        return 5
    if (hda_pci_bar0(-1) != 0 or hda_pci_irq(-1) != 0 or
        hda_pci_enable(-1)):
        return 6
    0
