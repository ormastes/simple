# JIT fixture for erased_receiver_index_of_bind_spec.spl.
#
# Must stay free of `use` imports: a single unsupported construct (and
# `use std.spec` in particular) silently demotes the whole program to the
# tree-walk interpreter, where the cranelift bind under test never runs.
#
# `Str.index_of` exists only so that exactly one `Type_dot_index_of` symbol is
# linked in. The old receiver-type-blind name-suffix resolver bound the erased
# text receiver below to it and printed 999.

struct Str:
    n: i64

impl Str:
    fn index_of(self, needle: text) -> i64:
        return 999

fn main():
    # `lower()` erases its result type to ANY, so `.index_of` reaches codegen
    # as a BARE name with no receiver type to qualify it.
    val erased = "hello world".lower()
    print("erased=" + erased.index_of("world").to_text())

    # Typed text receiver: emits a qualified `text.index_of`, always correct.
    val s = "hello world"
    print("typed=" + s.index_of("world").to_text())

    # The user method must still be reachable on its own typed receiver.
    val f = Str(n: 1)
    print("user=" + f.index_of("world").to_text())
