use std.spec

struct NestedGpuAttrProbe:
    is_entry: bool
    is_naked: bool
    is_noreturn: bool
    section: text?
    is_interrupt: bool
    is_boot: bool
    is_alloc: bool
    is_no_alloc: bool
    is_gpu_kernel: bool
    gpu_target: text
    gpu_backends: text

struct NestedGpuFunctionProbe:
    name: text
    attr: NestedGpuAttrProbe
    is_gpu_kernel: bool
    gpu_target: text
    gpu_backend_order: text

struct NestedGpuModuleProbe:
    name: text
    functions: Dict<text, NestedGpuFunctionProbe>

struct DictFieldTransportProbe:
    name: text
    path: text
    imports: [text]
    exports: [text]
    symbols: Dict<text, i64>
    functions: Dict<text, text>
    values: Dict<text, text>
    names: [text]
    classes: Dict<text, text>
    structs: Dict<text, text>
    enums: Dict<text, text>
    traits: Dict<text, text>
    impls: [text]
    constants: Dict<text, text>
    assertions: [text]
    advices: [text]
    bindings: [text]
    rules: [text]
    mocks: [text]
    types: [text]
    enabled: bool
    revision: i64
    pad00: i64
    pad01: i64
    pad02: i64
    pad03: i64
    pad04: i64
    pad05: i64
    pad06: i64
    pad07: i64
    pad08: i64
    pad09: i64
    pad10: i64
    pad11: i64
    pad12: i64
    pad13: i64
    pad14: i64
    pad15: i64
    pad16: i64
    pad17: i64
    pad18: i64
    pad19: i64
    pad20: i64
    pad21: i64
    pad22: i64
    pad23: i64
    pad24: i64
    pad25: i64
    pad26: i64
    pad27: i64
    pad28: i64
    pad29: i64
    pad30: i64
    pad31: i64
    pad32: i64
    pad33: i64
    pad34: i64
    pad35: i64
    pad36: i64
    pad37: i64
    pad38: i64
    pad39: i64
    pad40: i64
    pad41: i64
    pad42: i64
    pad43: i64
    pad44: i64
    pad45: i64
    pad46: i64
    pad47: i64
    pad48: i64
    pad49: i64
    pad50: i64
    pad51: i64
    pad52: i64
    pad53: i64
    pad54: i64
    pad55: i64
    pad56: i64
    pad57: i64
    pad58: i64
    pad59: i64
    pad60: i64
    pad61: i64
    pad62: i64
    pad63: i64
    tail_values: Dict<text, text>
    tail_names: [text]

    static fn new(values: Dict<text, text>, names: [text]) -> DictFieldTransportProbe:
        DictFieldTransportProbe(
            name: "probe", path: "probe.spl", imports: [], exports: [],
            symbols: {}, functions: {}, values: values, names: names,
            classes: {}, structs: {}, enums: {}, traits: {}, impls: [],
            constants: {}, assertions: [], advices: [], bindings: [], rules: [],
            mocks: [], types: [], enabled: true, revision: 1,
            pad00: 0, pad01: 0, pad02: 0, pad03: 0, pad04: 0, pad05: 0,
            pad06: 0, pad07: 0, pad08: 0, pad09: 0, pad10: 0, pad11: 0,
            pad12: 0, pad13: 0, pad14: 0, pad15: 0, pad16: 0, pad17: 0,
            pad18: 0, pad19: 0, pad20: 0, pad21: 0, pad22: 0, pad23: 0,
            pad24: 0, pad25: 0, pad26: 0, pad27: 0, pad28: 0, pad29: 0,
            pad30: 0, pad31: 0, pad32: 0, pad33: 0, pad34: 0, pad35: 0,
            pad36: 0, pad37: 0, pad38: 0, pad39: 0, pad40: 0, pad41: 0,
            pad42: 0, pad43: 0, pad44: 0, pad45: 0, pad46: 0, pad47: 0,
            pad48: 0, pad49: 0, pad50: 0, pad51: 0, pad52: 0, pad53: 0,
            pad54: 0, pad55: 0, pad56: 0, pad57: 0, pad58: 0, pad59: 0,
            pad60: 0, pad61: 0, pad62: 0, pad63: 0,
            tail_values: values, tail_names: names
        )

    me dict_count(values: Dict<text, text>) -> i64:
        values.keys().len()

    me array_count(names: [text]) -> i64:
        names.len()

    me multi_dict_count(label: text, values: Dict<text, text> = {}, orders: Dict<text, text> = {}) -> i64:
        if label != "gpu":
            return -1
        values.keys().len() + orders.keys().len()

    me aggregate_dict_count(source: DictFieldTransportProbe) -> i64:
        source.values.keys().len()

    me aggregate_array_count(source: DictFieldTransportProbe) -> i64:
        source.names.len()

    me receiver_head_dict_count() -> i64:
        self.values.keys().len()

    me receiver_tail_dict_count() -> i64:
        self.tail_values.keys().len()

    me receiver_tail_array_count() -> i64:
        self.tail_names.len()

    me nested_function_backend_order(function: NestedGpuFunctionProbe) -> text:
        if function.attr.gpu_backends != "": function.attr.gpu_backends else: function.gpu_backend_order

    me nested_module_backend_order(module: NestedGpuModuleProbe) -> text:
        val functions = module.functions.values()
        self.nested_function_backend_order(functions[0])

fn free_dict_count(values: Dict<text, text>) -> i64:
    values.keys().len()

fn free_aggregate_dict_count(source: DictFieldTransportProbe) -> i64:
    source.values.keys().len()

fn free_nested_module_backend_order(module: NestedGpuModuleProbe) -> text:
    val functions = module.functions.values()
    val function = functions[0]
    if function.attr.gpu_backends != "": function.attr.gpu_backends else: function.gpu_backend_order

describe "interpreter aggregate-field argument transport":
    it "preserves dictionary and array fields through free and method calls":
        var values: Dict<text, text> = {}
        values["copy"] = "vulkan"
        var source = DictFieldTransportProbe.new(values, ["copy"])
        var sink = DictFieldTransportProbe.new({}, [])

        expect(free_dict_count(values)).to_equal(1)
        expect(free_dict_count(source.values)).to_equal(1)
        expect(sink.dict_count(values)).to_equal(1)
        expect(sink.dict_count(source.values)).to_equal(1)
        expect(sink.array_count(source.names)).to_equal(1)

        var orders: Dict<text, text> = {}
        orders["copy"] = "cuda,vulkan"
        expect(sink.multi_dict_count("gpu", source.values, orders)).to_equal(2)
        expect(free_aggregate_dict_count(source)).to_equal(1)
        expect(sink.aggregate_dict_count(source)).to_equal(1)
        expect(sink.aggregate_array_count(source)).to_equal(1)
        expect(source.receiver_head_dict_count()).to_equal(1)
        expect(source.receiver_tail_dict_count()).to_equal(1)
        expect(source.receiver_tail_array_count()).to_equal(1)

        var replacement_values: Dict<text, text> = {}
        replacement_values["dispatch"] = "metal"
        val replacement_names = ["dispatch"]
        source.tail_values = replacement_values
        source.tail_names = replacement_names
        expect(source.receiver_tail_dict_count()).to_equal(1)
        expect(source.receiver_tail_array_count()).to_equal(1)

        val values_local = source.values
        val names_local = source.names
        expect(sink.dict_count(values_local)).to_equal(1)
        expect(sink.array_count(names_local)).to_equal(1)

    it "preserves nested tail metadata through Dict.values and method forwarding":
        val attr = NestedGpuAttrProbe(
            is_entry: false, is_naked: false, is_noreturn: false, section: nil,
            is_interrupt: false, is_boot: false, is_alloc: false, is_no_alloc: false,
            is_gpu_kernel: true, gpu_target: "auto", gpu_backends: "rocm,cl,cuda"
        )
        val function = NestedGpuFunctionProbe(
            name: "copy", attr: attr, is_gpu_kernel: true,
            gpu_target: "auto", gpu_backend_order: "rocm,cl,cuda"
        )
        var functions: Dict<text, NestedGpuFunctionProbe> = {}
        functions["copy"] = function
        val module = NestedGpuModuleProbe(name: "gpu", functions: functions)
        val sink = DictFieldTransportProbe.new({}, [])

        expect(free_nested_module_backend_order(module)).to_equal("rocm,cl,cuda")
        expect(sink.nested_module_backend_order(module)).to_equal("rocm,cl,cuda")
