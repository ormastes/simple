# @cover src/compiler/70.backend/backend/vulkan_backend.spl 5%
# @tag: unit, compiler, backend, gpu, vulkan, live-evidence

extern fn rt_file_read_text(path: text) -> text

describe "compiler-produced Vulkan live lane admission":
    it "binds live evidence to Simple compiler assembly output":
        val backend = rt_file_read_text("src/compiler/70.backend/backend/vulkan_backend.spl") ?? ""
        val builder = rt_file_read_text("src/compiler/70.backend/backend/vulkan/spirv_builder.spl") ?? ""
        expect(builder).to_contain("; Generator: Simple Compiler")
        expect(backend).to_contain("spirv_assembly: spirv_assembly")
        expect(backend).to_contain("CodegenOutput.gpu_output(module.name, vk_module.spirv_assembly)")

    it "fails closed until the producer and external-loader harness are admitted":
        val probe = rt_file_read_text("scripts/check/check-vulkan-compiler-live-lane.shs") ?? ""
        expect(probe).to_contain("SIMPLE_VULKAN_SPIRV_PRODUCER")
        expect(probe).to_contain("--emit-vulkan-spirv-assembly")
        expect(probe).to_contain("spirv-as")
        expect(probe).to_contain("spirv-val")
        expect(probe).to_contain("TODO(compiler-vulkan-live)")
        expect(probe).to_contain("compiler_spirv_assembly_sha256")
        expect(probe).to_contain("compiler_spirv_binary_sha256")
        expect(probe).to_contain("embedded_shader=false")
        expect(probe).to_contain("SIMPLE_VULKAN_SPIRV_BINARY")
        expect(probe).to_contain("CHECKER_SPIRV_MODULE")
        expect(probe).to_contain("SPIRV_MODULE=\"$CHECKER_SPIRV_MODULE\"")
        expect(probe).to_contain("SPIRV_VAL_TARGET=vulkan1.3")

    it "keeps the checker validation target configurable with its old default":
        val checker = rt_file_read_text("scripts/check/check-processing-ir-vulkan-break-even.shs") ?? ""
        expect(checker).to_contain("SPIRV_VAL_TARGET=\"${SPIRV_VAL_TARGET:-vulkan1.0}\"")
        expect(checker).to_contain("--target-env \"$SPIRV_VAL_TARGET\"")
