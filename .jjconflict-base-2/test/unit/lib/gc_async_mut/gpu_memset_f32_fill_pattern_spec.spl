# Regression: gpu_memset_f32 discarded its `value` argument and returned Ok(()).
#
# The old body was literally `gpu_memset(ptr, 0, count * 4)` -- `value` was never
# read, so a caller asking to fill a buffer with 3.14 got zeros AND got Ok(()).
# Both copies of the wrapper (gpu_ops.spl and gpu_api.spl) had the same body.
#
# The obvious repair -- forwarding `value` to gpu_memset -- cannot work at ANY
# value. Per the CUDA Driver API:
#     CUresult cuMemsetD8_v2 (CUdeviceptr, unsigned char uc, size_t N)  # N BYTES
#     CUresult cuMemsetD32_v2(CUdeviceptr, unsigned int  ui, size_t N)  # N ELEMS
# cuMemsetD8 truncates to eight bits and replicates that byte, and an f32 bit
# pattern is generally not byte-uniform. So the fill needs the 32-bit primitive
# AND an f32 -> u32 bitcast. gpu_f32_fill_pattern is that bitcast.
#
# ORACLE (external -- IEEE 754-2019 binary32, not taken from the code under
# test). Sign(1) exponent(8, bias 127) significand(23):
#     3.14f  -> 0x4048F5C3 = 1078523331
#     1.0f   -> 0x3F800000 = 1065353216
#     -2.0f  -> 0xC0000000 = 3221225472
#     0.0f   -> 0x00000000 = 0
#     -0.0f  -> 0x80000000 = 2147483648   (sign bit only -- distinguishes a
#                                          bitcast from a numeric conversion)
#     0.5f   -> 0x3F000000 = 1056964608
#
# NOT VERIFIED ON DEVICE: cuInit returns 3 in this process, so no fill was ever
# executed on hardware. This pins the host-side value->pattern conversion only.

use std.gc_async_mut.gpu_ops.{gpu_f32_fill_pattern, gpu_i32_fill_pattern}

describe "gpu_memset_f32 fill pattern":
    it "produces the IEEE-754 bit pattern of 3.14f":
        # The value from the filed bug: 0x4048F5C3 is not byte-uniform, which is
        # why the byte-granularity path could never express it.
        assert_equal(gpu_f32_fill_pattern(3.14 as f32), 1078523331)

    it "produces the IEEE-754 bit pattern for exact binary values":
        assert_equal(gpu_f32_fill_pattern(1.0 as f32), 1065353216)
        assert_equal(gpu_f32_fill_pattern(0.5 as f32), 1056964608)
        assert_equal(gpu_f32_fill_pattern(-2.0 as f32), 3221225472)

    it "is a bitcast, not a numeric conversion":
        # -0.0 numerically equals 0.0 but has a different bit pattern. A cast
        # would collapse these; a bitcast must not.
        assert_equal(gpu_f32_fill_pattern(0.0 as f32), 0)
        assert_equal(gpu_f32_fill_pattern(-0.0 as f32), 2147483648)

    it "does not discard the value (the regression)":
        # The defect returned a zero fill word regardless of input. Any two
        # distinct floats must give distinct, non-zero patterns.
        val a = gpu_f32_fill_pattern(3.14 as f32)
        val b = gpu_f32_fill_pattern(1.0 as f32)
        assert_not_equal(a, b)
        assert_not_equal(a, 0)

    it "leaves the i32 fill pattern alone (control)":
        # Control: passes both before and after, showing the suite is not
        # uniformly red and that the sibling i32 path is untouched.
        assert_equal(gpu_i32_fill_pattern(1), 1)
        assert_equal(gpu_i32_fill_pattern(-1), 4294967295)
