fn opt() -> Option<i64>:
    Some(7)

fn main():
    var parts: [text] = ["a", "b"]
    print("J1={parts.join(\",\")}")
    val s: text = "hello world"
    val xs: [i64] = [1, 2, 3, 4]
    val o: Option<i64> = opt()
    print("U1={o.unwrap()}")
    print("IX1={s.index_of(\"world\")}")
    print("CT1={xs.contains(2)}")
    print("CT2={xs.contains(99)}")
    print("done=1")
