use std.spec.*
use std.gc_async_mut.gpu.browser_engine.net.h1_client.{parse_chunked_body_bytes, h1_chunk_size_value}

fn main():
    describe "debug chunk":
        it "parses expected chunk":
            expect(h1_chunk_size_value("1")).to_equal(1)
            expect(h1_chunk_size_value("0")).to_equal(0)
            val raw = [49u8, 13u8, 10u8, 97u8, 13u8, 10u8, 48u8, 13u8, 10u8, 13u8, 10u8]
            match parse_chunked_body_bytes(raw):
                Ok(body):
                    expect(body).to_equal([97u8])
                Err(error):
                    fail("failed: {error}")
