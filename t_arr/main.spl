fn main():
    val kx = "x"
    val kz = "zz"
    var da: Dict<text, [i64]> = {}
    da[kx] = [10, 20, 30]
    print "C01 arr_len={da.len()}"
    print "C02 arr_keys={da.keys().len()}"
    print "C03 arr_idx_len={da[kx].len()}"
    print "C04 arr_idx_e0={da[kx][0]}"
    print "C05 arr_has={da.contains_key(kx)}"
    val g = da.get(kx)
    print "C06 arr_get_isnil={g == nil}"
    print "C07 arr_get_len={g.len()}"
    print "C08 arr_get_e0={g[0]}"
    print "C09 arr_get_e2={g[2]}"
    val gm = da.get(kz)
    print "C10 arr_miss_isnil={gm == nil}"
    print "C11 arr_miss_len={gm.len()}"
    print "C12 DONE"
