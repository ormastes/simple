# Focused x86_64 freestanding probe for persistent font-atlas storage.
#
# The host checker also counts the baremetal runtime's existing
# `[array-repeat] big count=0x100000` receipt. Three logical resets at two font
# sizes must allocate the 1024x1024 backing store exactly once while retaining
# valid, non-empty glyph batches after every reset.

use std.nogc_sync_mut.text_layout.font_renderer.{
    FontRenderer,
    font_render_config_default_for_size
}

extern fn serial_println(msg: text)
extern fn rt_port_outb(port: u16, value: u8)

fn _start():
    var renderer = FontRenderer.new()

    renderer.stage_text_configured(
        "A", 0xffffffffu32, font_render_config_default_for_size(16)
    )
    serial_println(
        "[font-atlas-probe] stage=16-first quads={renderer.staged_quads.len()} atlas_len={renderer.atlas_pixels.len()} dirty={renderer.staged_dirty_rects.len()} generation={renderer.atlas_generation}"
    )

    renderer.stage_text_configured(
        "A", 0xffffffffu32, font_render_config_default_for_size(32)
    )
    serial_println(
        "[font-atlas-probe] stage=32 quads={renderer.staged_quads.len()} atlas_len={renderer.atlas_pixels.len()} dirty={renderer.staged_dirty_rects.len()} generation={renderer.atlas_generation}"
    )

    renderer.stage_text_configured(
        "A", 0xffffffffu32, font_render_config_default_for_size(16)
    )
    serial_println(
        "[font-atlas-probe] stage=16-return quads={renderer.staged_quads.len()} atlas_len={renderer.atlas_pixels.len()} dirty={renderer.staged_dirty_rects.len()} generation={renderer.atlas_generation}"
    )
    serial_println("FONT_ATLAS_RESET_PROBE_DONE")
    rt_port_outb(0xf4u16, 0x03u8)
