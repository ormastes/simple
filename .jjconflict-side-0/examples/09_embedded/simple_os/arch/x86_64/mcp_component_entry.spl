# SimpleOS x86_64 in-guest MCP component sanity entry (OVMF/GRUB-EFI lane).
#
# Sibling of devtool_component_entry.spl; see that file's header for the boot
# chain (OVMF pflash -> GRUB-EFI -> multiboot; NEVER `-kernel`, NEVER
# isa-debug-exit), the per-component build rule, and the compiler statement
# (RUST SEED).
#
# EXPECTED TO BE BLOCKED AT LINK TIME, and that is the point of keeping it. The
# riscv64 and aarch64 siblings both fail to link this row on rt_closure_new /
# rt_closure_func_ptr: the real MCP dispatcher stores tool handlers as closures,
# and the freestanding runtimes implement no closure representation. The gate
# reports that literal bill rather than stubbing it away — a stubbed handler
# would return 0 with no link error and no runtime diagnostic, which would turn
# "MCP works in-guest" into a false claim. Do NOT set SIMPLE_ALLOW_STUB_FALLBACK
# to get this row green; the honest state is BLOCKED with the bill named.
#
# WHAT IT WOULD PROVE if the closure gap closes: a tool round-trips through the
# REAL dispatcher with a REAL authority token, rung in OPPOSITE directions — a
# registered tool must echo its payload AND an unregistered one must be refused
# — so a dispatcher degraded to "always answer" or "always refuse" fails.
#
# NEVER interpolate an integer into text — that emits rt_raw_i64_to_string,
# which the freestanding x86_64 runtime does not provide, and the link dies.
# No module-level `val` globals: on this native-build config they have been
# observed treated as unresolved extern symbols (see abi_probe_entry.spl).

use lib.nogc_async_mut.mcp.dispatch.{DispatchEntry, DispatchRegistry, dispatch_wrap}
use std.common.privilege.id_path.{id_path_intern}
use std.common.privilege.authority_token.{AuthorityToken, AuthorityLevel}
use std.common.privilege.principal.{Principal, PrincipalKind}

@unsafe(reason: "foreign serial output provider is not artifact-verified", capabilities: [ffi])
extern fn serial_println(msg: text)

fn _contains(haystack: text, needle: text) -> bool:
    """Substring test written locally on purpose: this is gate plumbing, not
    component logic, so implementing it here cannot launder a component pass."""
    val h = haystack.len()
    val n = needle.len()
    if n == 0:
        return true
    if n > h:
        return false
    var i = 0
    while i + n <= h:
        var j = 0
        var same = true
        while j < n:
            if haystack[i + j] != needle[j]:
                same = false
                j = n
            else:
                j = j + 1
        if same:
            return true
        i = i + 1
    false

fn mcp_component_row() -> i64:
    """Dispatch a tool through the REAL MCP dispatcher and print its envelope."""
    # `dispatch_wrap` checks id_path_prefix_match(token.id_path, entry.required),
    # i.e. the ENTRY's required path must sit under the TOKEN's path. The token
    # minted by AuthorityToken.root_for(p) carries "id." + p.id, so the entry's
    # requirement is registered one segment below it.
    val required = id_path_intern("id.mcp.echo")
    val entry = DispatchEntry.echo(required, AuthorityLevel.Write)
    var reg = DispatchRegistry.new_for_test()
    reg.register(entry)

    val token = AuthorityToken.root_for(
        Principal(id: "mcp", kind: PrincipalKind.Anonymous))

    val hit = dispatch_wrap(reg, "echo", ["MCP_RTT_PAYLOAD"], token)
    serial_println("[mcp] request  tool=echo args=[MCP_RTT_PAYLOAD]")
    serial_println("[mcp] response " + hit)

    val miss = dispatch_wrap(reg, "no_such_tool_xyz", [], token)
    serial_println("[mcp] request  tool=no_such_tool_xyz (must be refused)")
    serial_println("[mcp] response " + miss)

    var rc = 0
    if not _contains(hit, "MCP_RTT_PAYLOAD"):
        serial_println("[mcp] FAIL registered dispatch lost the payload")
        rc = 1
    if not _contains(miss, "unregistered_tool"):
        serial_println("[mcp] FAIL unregistered dispatch was not refused")
        rc = 1
    if rc == 0:
        serial_println("COMPONENT_MCP_SIMPLEOS_X86_64_OK dispatch round-trip echoed the payload and refused the unknown tool")
    rc

fn _start():
    """x86_64 in-guest MCP sanity entry, reached from crt0.s after the multiboot
    handover performed by GRUB-EFI under OVMF."""
    serial_println("")
    serial_println("[components] SimpleOS x86_64 in-guest toolchain components (OVMF -> GRUB-EFI)")
    serial_println("[components] serial up, exercising real product modules")
    val rc = mcp_component_row()
    if rc == 0:
        serial_println("[components] all component rows exited rc=0")
    else:
        serial_println("[components] at least one component row exited rc=nonzero")
    serial_println("[components] parking")
