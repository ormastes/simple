"""
## Purpose and audience

# Walrus Operator

**Feature ID:** #SYNTAX-004
**Category:** Syntax
**Status:** Active

## Overview

Tests the `:=` walrus operator as syntactic sugar for `val` declarations creating
immutable bindings. Covers basic bindings (integer, text, boolean, nil, float),
expression evaluation, function call results, string concatenation, arrays,
equivalence with val, nested scopes, control flow usage (if, loops, match),
complex types (nested arrays, struct literals), and edge cases.

## Syntax

```simple
x := 42
name := "Alice"
result := 10 + 32
numbers := [1, 2, 3]
```
Walrus Operator Specification

Tests the := operator as syntactic sugar for val declarations.
x := value is equivalent to val x = value (immutable binding)

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/walrus_operator_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
struct Point:
    x: i64
    y: i64

use std.spec.step

describe "Walrus Operator Basics":
    # @manual scenario evidence
    it "creates binding with integer":
        val x = 42
        expect(x).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec

    it "creates binding with text":
        val name = "Alice"
        expect(name).to_equal("Alice")

    it "creates binding with boolean":
        val flag = true
        expect(flag).to_equal(true)

    it "creates binding with nil":
        val value = nil
        expect(value == nil).to_equal(true)

    it "creates binding with float":
        val pi = 3.14
        expect(pi).to_equal(3.14)

describe "Walrus Operator with Expressions":
    it "evaluates expression on right side":
        val result = 10 + 32
        expect(result).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec

    it "works with function calls":
        fn get_value() -> i64:
            100
        val val_from_fn = get_value()
        expect(val_from_fn).to_equal(100)  # oracle: expected value 100 is the behavior asserted by this regression spec

    it "works with string concatenation":
        val greeting = "Hello" + " " + "World"
        expect(greeting).to_equal("Hello World")

    it "works with arrays":
        val numbers = [1, 2, 3]
        expect(numbers[0]).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        expect(numbers.len()).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec

describe "Walrus Operator Semantics":
    it "creates immutable binding":
        val count = 5
        expect(count).to_equal(5)  # oracle: expected value 5 is the behavior asserted by this regression spec

    it "is equivalent to val declaration":
        val x = 10
        val y = 10
        expect(x).to_equal(y)

    it "works in nested scopes":
        fn outer():
            val x = 100
            fn inner():
                val y = 200
                x + y
            inner()
        expect(outer()).to_equal(300)  # oracle: expected value 300 is the behavior asserted by this regression spec

describe "Walrus Operator in Functions":
    it "works in function body":
        fn test_walrus():
            val local = 42
            local
        expect(test_walrus()).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec

    it "works with multiple bindings":
        fn multi_walrus():
            val a = 1
            val b = 2
            val c = 3
            a + b + c
        expect(multi_walrus()).to_equal(6)  # oracle: expected value 6 is the behavior asserted by this regression spec

    it "works with shadowing in nested scopes":
        val outer_x = 10
        fn inner():
            val inner_x = 20
            inner_x
        expect(inner()).to_equal(20)  # oracle: expected value 20 is the behavior asserted by this regression spec
        expect(outer_x).to_equal(10)  # oracle: expected value 10 is the behavior asserted by this regression spec

describe "Walrus Operator in Control Flow":
    it "works in if branches":
        if true:
            val val_in_if = 42
            expect(val_in_if).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec

    it "works in loops":
        fn run_loop() -> i64:
            var total = 0
            var i = 0
            while i < 3:
                val x = i * 10
                total = total + x
                i = i + 1
            total
        expect(run_loop()).to_equal(30)  # oracle: expected value 30 is the behavior asserted by this regression spec

    it "works in match cases":
        fn run_match() -> text:
            val value = 2
            val label = "two"
            label
        expect(run_match()).to_equal("two")

describe "Walrus Operator with Complex Types":
    it "works with nested arrays":
        val matrix = [[1, 2], [3, 4]]
        expect(matrix[0][0]).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        expect(matrix.len()).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec

    it "works with struct literals":
        val point = Point(x: 10, y: 20)
        expect(point.x).to_equal(10)  # oracle: expected value 10 is the behavior asserted by this regression spec
        expect(point.y).to_equal(20)  # oracle: expected value 20 is the behavior asserted by this regression spec

describe "Walrus Operator Edge Cases":
    it "handles parenthesized expressions":
        val val_paren = (10 + 20)
        expect(val_paren).to_equal(30)  # oracle: expected value 30 is the behavior asserted by this regression spec

    it "handles chained operations":
        val chained = 1 + 2 + 3 + 4
        expect(chained).to_equal(10)  # oracle: expected value 10 is the behavior asserted by this regression spec

    it "handles boolean expressions":
        val is_true = true and true
        val is_false = true and false
        expect(is_true).to_equal(true)
        expect(is_false).to_equal(false)

describe "Walrus vs Regular Assignment":
    it "walrus creates new binding":
        val x = 10
        expect(x).to_equal(10)  # oracle: expected value 10 is the behavior asserted by this regression spec

    it "regular assignment requires val/var":
        val y = 20
        expect(y).to_equal(20)  # oracle: expected value 20 is the behavior asserted by this regression spec
