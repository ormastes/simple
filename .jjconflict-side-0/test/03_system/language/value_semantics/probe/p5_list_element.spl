# Cross-engine value-semantics probe P5: struct extracted from a list element,
# plus write-through-index control (S5b persists under both semantics).
struct Flat:
    a: f64
    b: i64

fn main():
    print("PROBE|CONTROL={40 + 2}")
    var lst = [Flat(a: 1.0, b: 2)]
    var e = lst[0]
    e.a = 77.0
    print("PROBE|S5 lst0.a={lst[0].a} e.a={e.a}")
    lst[0].a = 66.0
    print("PROBE|S5b lst0.a={lst[0].a}")

main()
