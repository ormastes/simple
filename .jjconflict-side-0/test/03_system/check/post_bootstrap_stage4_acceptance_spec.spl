# @req: REQ-CHECK-001
"""
## Purpose and audience
Purpose: should reject missing candidate and provenance inputs
Audience: compiler and tooling engineers who maintain this spec

# Post-bootstrap Stage 4 acceptance

The exact candidate runs this spec after bootstrap. The acceptance interface
binds the canonical Stage 4 candidate, its SHA-256, the adjacent provenance,
and the provenance SHA-256 before verifying transitive Stage 2/3 lineage.
Only retained build and essential-tool smoke logs are inspected; no build,
smoke, Simple test, or tool test is rerun by this spec.

The qualified lane supplies
`$PWD/build/restart12-riscv-current-head/full/x86_64-unknown-linux-gnu/simple`
and its adjacent `.provenance.env` through the four frozen `STAGE4_*`
environment variables. Missing, substituted, malformed, or stale identities
fail closed.
"""
# codex-system-test
# @tag: system, bootstrap, stage4, post-bootstrap, acceptance
# @req: PST4-001, PST4-002, PST4-003, PST4-004, PST4-005, PST4-006, PST4-007, PST4-008, PST4-009
use std.io_runtime.{process_run}
use std.spec.*

fn run_post_bootstrap_stage4_acceptance(shell_command: text) -> (text, text, i64):
    process_run("/bin/sh", ["-c", shell_command])

fn expect_post_bootstrap_marker(output: text, marker: text):
    expect(output).to_contain(marker)

describe "Post-bootstrap Stage 4 acceptance":
    it "should reject missing candidate and provenance inputs":
        step("Verify: should reject missing candidate and provenance inputs")
        # @req: PST4-001,
        step("Invoke the checker without evidence inputs")
        val (_stdout, stderr, code) = process_run("/bin/sh", ["scripts/check/check-post-bootstrap-stage4-sspec.shs"])
        expect(code).to_equal(2)  # oracle: value fixed by the spec contract
        expect(stderr).to_contain("usage:")

    it "should reject a symlink substituted for the exact candidate":
        step("Verify: should reject a symlink substituted for the exact candidate")
        # @req: PST4-001,
        step("Substitute a symlink for the canonical candidate")
        val (stdout, _stderr, code) = process_run("/bin/sh", ["-c", "test -n \"${STAGE4_POST_BOOTSTRAP_BINARY:-}\" && test -n \"${STAGE4_POST_BOOTSTRAP_PROVENANCE:-}\" && tmp=${TMPDIR:-/tmp}/stage4-post-bootstrap-link-$$ && trap 'rm -f \"$tmp\"' EXIT && ln -s \"$STAGE4_POST_BOOTSTRAP_BINARY\" \"$tmp\" && sh scripts/check/check-post-bootstrap-stage4-sspec.shs \"$tmp\" \"$STAGE4_POST_BOOTSTRAP_PROVENANCE\""])
        expect(code).to_equal(1)  # oracle: value fixed by the spec contract
        expect(stdout).to_contain("post_bootstrap_stage4_reason=binary_missing_symlinked_or_noncanonical")

    it "should admit only the exact source-bound candidate with unchanged smoke evidence":
        # @req: PST4-001,
        step("Select the exact candidate and adjacent provenance")
        step("Verify binary, source, producer, parent, Stage 3, logs, and digests")
        step("Verify retained essential-tool receipts without rerunning smoke")
        val (stdout, stderr, code) = process_run("/bin/sh", ["-c", "test -n \"${STAGE4_POST_BOOTSTRAP_BINARY:-}\" && test -n \"${STAGE4_POST_BOOTSTRAP_PROVENANCE:-}\" && SIMPLE_NO_STUB_FALLBACK=1 sh scripts/check/check-post-bootstrap-stage4-sspec.shs \"$STAGE4_POST_BOOTSTRAP_BINARY\" \"$STAGE4_POST_BOOTSTRAP_PROVENANCE\""])
        expect(code).to_equal(0)  # oracle: value fixed by the spec contract
        expect(stderr).to_equal("")
        expect_post_bootstrap_marker(stdout, "post_bootstrap_stage4_candidate_hash_bound=true")
        expect_post_bootstrap_marker(stdout, "post_bootstrap_stage4_provenance_hash_bound=true")
        expect_post_bootstrap_marker(stdout, "post_bootstrap_matrix_compiler_build_stage2=true")
        expect_post_bootstrap_marker(stdout, "post_bootstrap_matrix_compiler_build_stage3=true")
        expect_post_bootstrap_marker(stdout, "post_bootstrap_matrix_compiler_build_stage4=true")
        expect_post_bootstrap_marker(stdout, "post_bootstrap_matrix_tools_build_stage2=not_applicable")
        expect_post_bootstrap_marker(stdout, "post_bootstrap_matrix_tools_build_stage3=not_applicable")
        expect_post_bootstrap_marker(stdout, "post_bootstrap_matrix_tools_build_stage4=true")
        expect_post_bootstrap_marker(stdout, "post_bootstrap_matrix_simple_tests_stage2=not_applicable")
        expect_post_bootstrap_marker(stdout, "post_bootstrap_matrix_simple_tests_stage3=not_applicable")
        expect_post_bootstrap_marker(stdout, "post_bootstrap_matrix_simple_tests_stage4=true")
        expect_post_bootstrap_marker(stdout, "post_bootstrap_matrix_tool_tests_stage2=not_applicable")
        expect_post_bootstrap_marker(stdout, "post_bootstrap_matrix_tool_tests_stage3=not_applicable")
        expect_post_bootstrap_marker(stdout, "post_bootstrap_matrix_tool_tests_stage4=true")
        expect_post_bootstrap_marker(stdout, "post_bootstrap_stage4_smoke_log_unchanged=true")
        expect_post_bootstrap_marker(stdout, "post_bootstrap_stage4_acceptance=true")
