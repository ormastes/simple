"""
# Engine2D Software Offscreen Dispatch Contract

Guards the native SimpleOS rendering path against duck-typed trait calls for
the concrete software offscreen owned by `Engine2D.software_backend`.

The freestanding native compiler deliberately traps a trait method call when
the concrete class has no registered vtable. Software offscreens therefore
must route their primitive, frame, and readback operations through the retained
`SoftwareBackend` option before reaching the generic `RenderBackend` fallback.
"""

# @tag: system, engine2d, simpleos, native

use std.io_runtime.{file_read}
use std.spec.*

fn engine_source() -> text:
    file_read("src/lib/gc_async_mut/gpu/engine2d/engine.spl")

describe "Engine2D software offscreen native dispatch":

    it "routes primitive operations through the concrete software owner":
        val source = engine_source()
        expect(source).to_contain("elif val Some(software) = self.software_backend:\n            software.clear(color)")
        expect(source).to_contain("elif val Some(software) = self.software_backend:\n            software.draw_rect(x, y, w, h, color)")
        expect(source).to_contain("elif val Some(software) = self.software_backend:\n            software.draw_rect_filled(x, y, w, h, color)")
        expect(source).to_contain("elif val Some(software) = self.software_backend:\n            software.draw_line(x1, y1, x2, y2, color, thickness)")
        expect(source).to_contain("elif val Some(software) = self.software_backend:\n            software.draw_circle(cx, cy, r, color)")
        expect(source).to_contain("elif val Some(software) = self.software_backend:\n            software.draw_circle_filled(cx, cy, r, color)")
        expect(source).to_contain("elif val Some(software) = self.software_backend:\n            software.draw_rounded_rect(x, y, w, h, radius, color)")
        expect(source).to_contain("elif val Some(software) = self.software_backend:\n            software.draw_triangle_filled(x1, y1, x2, y2, x3, y3, color)")
        expect(source).to_contain("elif val Some(software) = self.software_backend:\n            software.draw_gradient_rect(x, y, w, h, top_color, bottom_color)")
        expect(source).to_contain("elif val Some(software) = self.software_backend:\n            software.draw_text(x, y, text_val, color, font_size)")
        expect(source).to_contain("elif val Some(software) = self.software_backend:\n            software.draw_image(x, y, w, h, pixels)")
        expect(source).to_contain("elif val Some(software) = self.software_backend:\n            software.draw_rounded_rect_outline(x, y, w, h, radius, color, thickness)")
        expect(source).to_contain("elif val Some(software) = self.software_backend:\n            emu_draw_linear_gradient_stops(software, x, y, w, h, stop_colors, stop_positions, angle_deg)")
        expect(source).to_contain("elif val Some(software) = self.software_backend:\n            software.draw_image_blend(x, y, w, h, pixels)")
        expect(source).to_contain("elif val Some(software) = self.software_backend:\n            software.draw_image_scaled(dst_x, dst_y, dst_w, dst_h, src_w, src_h, pixels)")
        expect(source).to_contain("elif val Some(software) = self.software_backend:\n            emu_draw_image_scaled_blend(")
        expect(source).to_contain("elif val Some(software) = self.software_backend:\n            software.draw_shadow_rect(x, y, w, h, offset_x, offset_y, blur_r, color)")

    it "routes frame state and readback through the concrete software owner":
        val source = engine_source()
        expect(source).to_contain("elif val Some(software) = self.software_backend:\n            software.set_mask(mask_pixels, w, h)")
        expect(source).to_contain("elif val Some(software) = self.software_backend:\n            software.clear_mask()")
        expect(source).to_contain("elif val Some(software) = self.software_backend:\n            software.set_clip(x, y, w, h)")
        expect(source).to_contain("elif val Some(software) = self.software_backend:\n            software.clear_clip()")
        expect(source).to_contain("elif val Some(software) = self.software_backend:\n            software.present()")
        expect(source).to_contain("val ok = software.submit_batch()")
        expect(source).to_contain("val pixels = software.read_pixels()")
        expect(source).to_contain("val readback = software.read_pixels_with_source()")

    it "writes the concrete backend back after every routed operation":
        val source = engine_source()
        expect(source.split("self.software_backend = Some(software)").len()).to_be_greater_than(24)
        expect(source.split("self.backend = software").len()).to_be_greater_than(24)
