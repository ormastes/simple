# @req REQ-004 REQ-014
# @manual: primary
"""Bounded owner-local MC/DC recording and deterministic parent commit."""
use std.spec.*
use std.spec.step
use std.common.mcdc.model.*
use std.nogc_sync_mut.mcdc.recorder.*

fn record_one(recorder: McdcRecorder, decision: i64, outcome: bool) -> bool:
    recorder.record(decision, outcome, 1, 0, 0, 0,
        if outcome: 1 else: 0, 0, 0, 0, 0, 0, 0, 0)

describe "MC/DC parallel recording":
    it "should retain owner identity and deterministic sequence order":
        step("exercise independent conditions")
        var policy = mcdc_default_policy(McdcMode.StaticOn)
        policy.owner_bytes = 320
        val recorder = McdcRecorder.create(17, policy)
        expect(record_one(recorder, 8, false)).to_equal(true)
        expect(record_one(recorder, 8, true)).to_equal(true)
        expect(recorder.evaluation_at(0).owner_id).to_equal(17)
        expect(recorder.evaluation_at(1).sequence).to_equal(2)

    it "should drop newest records at the fixed boundary without growing":
        step("exercise independent conditions")
        var policy = mcdc_default_policy(McdcMode.StaticOn)
        policy.owner_bytes = 160
        policy.overflow = McdcOverflowPolicy.DropNewest
        val recorder = McdcRecorder.create(1, policy)
        expect(record_one(recorder, 1, true)).to_equal(true)
        expect(record_one(recorder, 2, false)).to_equal(false)
        expect(recorder.dropped_count()).to_equal(1)

    it "should overwrite oldest deterministically when configured":
        step("exercise independent conditions")
        var policy = mcdc_default_policy(McdcMode.StaticOn)
        policy.owner_bytes = 160
        policy.overflow = McdcOverflowPolicy.OverwriteOldest
        val recorder = McdcRecorder.create(3, policy)
        record_one(recorder, 11, false)
        record_one(recorder, 12, true)
        expect(recorder.overwritten_count()).to_equal(1)
        expect(recorder.evaluation_at(0).decision_id).to_equal(12)

