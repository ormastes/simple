# System smoke tests for coupling/cohesion quality analysis.
# Detailed algorithm coverage lives in test/01_unit/coupling/coupling_metrics_spec.spl.

use std.spec
use compiler.common.dependency.graph.{ImportGraph, ImportEdge, ImportKind}
use compiler.tools.coupling.metrics.{compute_all_metrics}
use compiler.tools.coupling.layer_check.{find_layer_violations}
use compiler.tools.coupling.lcom.{compute_lcom4, MethodFieldAccess}

fn graph(edges: Dict<text, [text]>) -> ImportGraph:
    ImportGraph(edges: edges, detailed_edges: [])

fn method_access(name: text, fields: [text], calls: [text]) -> MethodFieldAccess:
    MethodFieldAccess(method_name: name, fields_accessed: fields, methods_called: calls)

describe "Coupling Analysis":

    it "computes coupling metrics for a dependency graph":
        # @req REQ-SSPEC-SYSTEM
        step("computes coupling metrics for a dependency graph")
        var edges: Dict<text, [text]> = {}
        edges = edges.set("app", ["lib", "compiler"])
        edges = edges.set("lib", [])
        edges = edges.set("compiler", ["lib"])

    describe "SCC Cycle Detection":
        # @scenario SC-005
        it "detects circular dependencies using SCC":
            pass_do_nothing
        # @scenario SC-006
        it "does not report single-node SCCs":
            pass_do_nothing
        # @scenario SC-007
        it "finds all SCCs in a complex graph":
            pass_do_nothing

        expect(metrics.len()).to_equal(3)
        expect(metrics[0].module_name.len()).to_be_greater_than(0)

    it "detects cohesion split with LCOM4":
        # @req REQ-SSPEC-SYSTEM
        step("detects cohesion split with LCOM4")
        val methods = [
            method_access("read", ["path"], []),
            method_access("write", ["path"], []),
            method_access("render", ["canvas"], [])
        ]

    describe "Output Formats":
        # @scenario SC-012
        it "produces text format report":
            pass_do_nothing
        # @scenario SC-013
        it "produces JSON format report":
            pass_do_nothing
        # @scenario SC-014
        it "produces Markdown format report":
            pass_do_nothing

        expect(result.method_count).to_equal(3)
        expect(result.lcom4).to_equal(2)

    it "flags lower layer importing a higher layer":
        # @req REQ-SSPEC-SYSTEM
        step("flags lower layer importing a higher layer")
        var edges: Dict<text, [text]> = {}
        edges = edges.set("compiler/10.frontend/parser", ["compiler/30.types/checker"])
        edges = edges.set("compiler/30.types/checker", [])

    describe "Public API Quality":
        # @scenario SC-021
        it "computes PSS as public methods + public fields":
            pass_do_nothing
        # @scenario SC-022
        it "computes EUR as externally used / total public":
            pass_do_nothing
        # @scenario SC-023
        it "computes normalized entropy for usage distribution":
            pass_do_nothing

        expect(violations.len()).to_equal(1)  # oracle: 1 — pinned expected value for this behavior
        expect(violations[0].from_layer).to_equal(10)  # oracle: 10 — pinned expected value for this behavior
        expect(violations[0].to_layer).to_equal(30)  # oracle: 30 — pinned expected value for this behavior
