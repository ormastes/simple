"""
## Purpose and audience
Acceptance oracles for the open remains of
doc/03_plan/os/multiarch_qemu_systest/aarch64_darwin_contract_snippet.md.
## Operator workflow
bin/simple test test/03_system/plan_acceptance/aarch64_darwin_contract_snippet_spec.spl
## Compatibility and limitations
Tagged in-development: these pin the promised INTERFACE and fail until the
plan's remaining checkboxes are implemented.
## Verification guidance / troubleshooting
A failure on the first scenario means the six aarch64_darwin_* accessors in
src/os/qemu_systest_contract.spl were renamed; a failure on the second means
simpleos_platform_targets() in
src/os/port/_SimpleosMultiplatformBuild/platform_target_catalog.spl still
lacks the aarch64-apple-darwin entry the merge snippet inserts.
"""
# @tag:in-development
# doc-path: doc/03_plan/os/multiarch_qemu_systest/aarch64_darwin_contract_snippet.md
# @manual_section aarch64-darwin contract snippet remains

use std.spec.{step}
use std.spec.{describe, context, it, expect}
use os.qemu_systest_contract.{
    run_qemu_systest,
    aarch64_darwin_binary_path,
    aarch64_darwin_app_path,
    aarch64_darwin_qemu_bin,
    aarch64_darwin_qemu_args,
    aarch64_darwin_markers,
    aarch64_darwin_timeout_ms
}
use os.port.simpleos_multiplatform_build_part2.{simpleos_platform_targets}

describe "plan: os/multiarch_qemu_systest/aarch64_darwin_contract_snippet remains":

    context "verification checklist (post-merge)":

        it "`bin/simple check src/os/qemu_systest_contract.spl` — no errors":
            step("call each aarch64_darwin_* descriptor accessor the merge snippet inserts")
            # @req REQ-PLAN-AARCH64-DARWIN-001
            # Interface pin: the six aarch64_darwin_* descriptor accessors the
            # snippet inserts must exist, resolve, and return the contracted
            # shapes without a compile error — a real oracle on the values
            # themselves, since "no errors" alone is a build-tool assertion
            # this spec cannot invoke directly.
            expect(aarch64_darwin_binary_path()).to_equal("build/os/darwin-aarch64/simpleos_aarch64_darwin_fs_exec")
            expect(aarch64_darwin_app_path()).to_equal("build/os/darwin-aarch64/hello_world.smf")
            expect(aarch64_darwin_qemu_bin()).to_equal(aarch64_darwin_binary_path())
            expect(aarch64_darwin_qemu_args().len()).to_equal(0u64)
            # oracle: 15000 is the exact millisecond timeout literal the
            # snippet's aarch64_darwin_timeout_ms() body returns (doc line 65).
            expect(aarch64_darwin_timeout_ms()).to_equal(15000)  # oracle: doc-specified 15s timeout
            # AUDIT 2026-09-05: the sixth accessor named by the checkbox,
            # aarch64_darwin_markers(), was previously never asserted — it was
            # only passed opaquely into run_qemu_systest, so any corruption of
            # the marker set (renamed, emptied, or seeded with the bare-metal
            # markers the doc explicitly forbids) went undetected. Pin the
            # exact five-element HOSTED_* set from doc lines 56-62, and pin the
            # forbidden bare-metal markers as absent.
            expect(aarch64_darwin_markers()).to_equal(
                ["HOSTED_FS_READ_OK",
                 "HOSTED_APP_PARSE_OK",
                 "HOSTED_PROCESS_LAUNCH_OK",
                 "HOSTED_EXIT_OK",
                 "TEST PASSED"])
            var forbidden = 0u64
            for m in aarch64_darwin_markers():
                if m == "ELF_LOAD_OK" or m == "user-svc-exit:ok" or m == "SMF_WM_GUI_LAUNCH_OK" or m == "NATIVE_GUI_PROCESS_RENDER_OK":
                    forbidden = forbidden + 1u64
            expect(forbidden).to_equal(0u64)
            # @capture(assertion): the six equalities above (one per accessor
            # the checkbox names) plus the forbidden-marker scan are this
            # scenario's retained evidence for the accessor contract.

        it "`bin/simple check src/os/port/simpleos_multiplatform_build_part2.spl` — no errors":
            step("scan simpleos_platform_targets() for the aarch64-apple-darwin entry the snippet appends")
            # @req REQ-PLAN-AARCH64-DARWIN-002
            # Interface pin: simpleos_platform_targets() must list the 7th
            # element, aarch64-apple-darwin, per the snippet's insertion
            # point. Real oracle: scan the returned catalog for the name.
            val targets = simpleos_platform_targets()
            var found = false
            var i = 0u64
            while i < targets.len():
                if targets[i].name == "aarch64-apple-darwin":
                    found = true
                i = i + 1u64
            expect(found).to_equal(true)
            expect(targets.len() >= 7u64).to_equal(true)
            # AUDIT 2026-09-05: name-presence alone did not discriminate — a
            # placeholder entry carrying only the right name would pass. The
            # snippet (doc lines 118-193) pins concrete field values; assert
            # them so a stub entry fails.
            var i2 = 0u64
            var checked_fields = 0u64
            while i2 < targets.len():
                if targets[i2].name == "aarch64-apple-darwin":
                    expect(targets[i2].native_target).to_equal("aarch64-apple-darwin")
                    expect(targets[i2].clang_target).to_equal("aarch64-apple-darwin")
                    expect(targets[i2].platform_slug).to_equal("aarch64-darwin")
                    expect(targets[i2].qemu_system).to_equal("")
                    expect(targets[i2].bits).to_equal(64)
                    expect(targets[i2].output).to_equal(aarch64_darwin_binary_path())
                    expect(targets[i2].disk_image_output).to_equal(aarch64_darwin_app_path())
                    checked_fields = checked_fields + 1u64
                i2 = i2 + 1u64
            # non-vacuity: the field block above must have executed exactly once
            expect(checked_fields).to_equal(1u64)
            # @capture(assertion): "found", the seven per-field equalities, and
            # the checked_fields non-vacuity counter are all computed by
            # scanning the real catalog return value, not local constants.

        it "`bin/simple test test/03_system/os/qemu/sys_qemu_aarch64_darwin_fs_exec_spec.spl` — RED with missing-media:build/os/darwin-aarch64/simpleos_aarch64_darwin_fs_exec (expected on Linux)":
            step("run_qemu_systest with the aarch64-darwin descriptors on a host lacking the staged darwin binary")
            # @req REQ-PLAN-AARCH64-DARWIN-003
            # Interface pin: on a host without the darwin binary staged (this
            # CI host), run_qemu_systest must return the missing-media
            # classification for the FIRST missing path, kernel_path, before
            # attempting any QEMU spawn — matching the doc's stated contract
            # that this lane is intentionally RED on Linux.
            val verdict = run_qemu_systest(
                "aarch64-darwin",
                aarch64_darwin_binary_path(),
                aarch64_darwin_app_path(),
                aarch64_darwin_qemu_bin(),
                aarch64_darwin_qemu_args(),
                aarch64_darwin_markers(),
                aarch64_darwin_timeout_ms()
            )
            expect(verdict.starts_with("missing-media:")).to_equal(true)
            # AUDIT 2026-09-05: the prefix check alone did NOT discriminate.
            # run_qemu_systest checks kernel_path FIRST and image_path SECOND
            # (src/os/qemu_systest_contract.spl:439-442), so staging only the
            # binary still yields a "missing-media:" verdict — for the .smf
            # instead — and this `it` stayed green. The checkbox names the
            # binary path specifically, so pin the WHOLE classification.
            expect(verdict).to_equal("missing-media:" + aarch64_darwin_binary_path())
            expect(verdict.contains("hello_world.smf")).to_equal(false)
            # @capture(assertion): the full classification string returned by
            # the real run_qemu_systest call above is the retained evidence.

        it "the missing-media classification contains the binary path, not a nil/crash":
            step("assert the verdict text names the exact binary path rather than a generic failure")
            # @req REQ-PLAN-AARCH64-DARWIN-004
            # Real oracle: the classification string must literally contain
            # the aarch64_darwin_binary_path() text, proving the verdict
            # carries the real path rather than a generic/nil failure.
            val verdict = run_qemu_systest(
                "aarch64-darwin",
                aarch64_darwin_binary_path(),
                aarch64_darwin_app_path(),
                aarch64_darwin_qemu_bin(),
                aarch64_darwin_qemu_args(),
                aarch64_darwin_markers(),
                aarch64_darwin_timeout_ms()
            )
            expect(verdict.contains(aarch64_darwin_binary_path())).to_equal(true)
            # AUDIT 2026-09-05: "not a nil/crash" was never actually asserted.
            # Pin the negative half too: the verdict must be non-empty, must
            # not be one of the generic boot-fail classifications, and must not
            # be the accelerator/nonce short-circuit that run_qemu_systest
            # returns when it gets PAST the missing-media checks.
            expect(verdict.len() > 14u64).to_equal(true)
            expect(verdict.contains("boot-fail")).to_equal(false)
            expect(verdict.contains("nonce")).to_equal(false)
            expect(verdict.contains("accelerator")).to_equal(false)
            # @capture(assertion): containment check against the live
            # accessor's own return value plus the four negative
            # classifications above, not a hardcoded path string.
