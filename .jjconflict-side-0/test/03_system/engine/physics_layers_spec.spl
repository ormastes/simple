# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.io_runtime
use std.spec
use std.nogc_sync_mut.engine.physics.collision_layers.{CollisionFilter, CollisionMatrix}

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

fn matrix_with_disabled_24() -> CollisionMatrix:
    var mx = CollisionMatrix.all_collide()
    mx.set_collision(2, 4, false)
    mx

# ---------------------------------------------------------------------------
# Specs
# ---------------------------------------------------------------------------

describe "Physics2 CollisionFilter":
    # @manual scenario evidence
    it "all vs all collides":
        # @req REQ-SSPEC-SYSTEM
        step("all vs all collides")
        val a = CollisionFilter.all()
        val b = CollisionFilter.all()
        expect(a.should_collide(b)).to_equal(true)

    it "none vs any no collision":
        # @req REQ-SSPEC-SYSTEM
        step("none vs any no collision")
        val n = CollisionFilter.none()
        val a = CollisionFilter.all()
        expect(n.should_collide(a)).to_equal(false)

    it "same layer collides":
        # @req REQ-SSPEC-SYSTEM
        step("same layer collides")
        val x = CollisionFilter.with_mask(2, 2)
        val y = CollisionFilter.with_mask(2, 2)
        expect(x.should_collide(y)).to_equal(true)

    it "different exclusive layers no collision":
        # @req REQ-SSPEC-SYSTEM
        step("different exclusive layers no collision")
        val x = CollisionFilter.with_mask(2, 4)
        val y = CollisionFilter.with_mask(8, 1)
        expect(x.should_collide(y)).to_equal(false)

describe "Physics2 CollisionMatrix":
    it "matrix disables collision between layers":
        # @req REQ-SSPEC-SYSTEM
        step("matrix disables collision between layers")
        val mx = matrix_with_disabled_24()
        val fa = CollisionFilter.with_mask(2, 4)
        val fb = CollisionFilter.with_mask(4, 2)
        expect(mx.should_collide(fa, fb)).to_equal(false)
