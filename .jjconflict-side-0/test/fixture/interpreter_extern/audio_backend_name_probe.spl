# Fixture for test/01_unit/compiler/interpreter_extern/audio_registration_spec.spl.
# Calls a real rt_audio_* extern that previously had no entry in
# EXTERN_DISPATCH and no path to the linked C implementation (runtime_audio.c
# was absent from both the native-product-build source list at
# runtime_compiler.spl and the C sources src/compiler_rust/runtime/build.rs
# compiles). Before the fix this died with
# `unknown extern function: rt_audio_backend_name`. rt_audio_backend_name is
# side-effect-free (it never opens an audio device): it returns "uninitialized"
# unless rt_audio_init already ran in this process, so the probe is
# deterministic without depending on a real audio device being present.

extern fn rt_audio_backend_name() -> text

fn main() -> i64:
    val name = rt_audio_backend_name()
    print "audio_backend_name_result={name}"
    0
