# Fixture for test/01_unit/compiler/interpreter_extern/fb_image_log_socket_registration_spec.spl.
# Calls a real rt_image_* extern that previously had no path to the linked C
# implementation (runtime_image.c was absent from both the native-product-
# build source list at runtime_compiler.spl and the C sources
# src/compiler_rust/runtime/build.rs compiles). Before the fix this died with
# `unknown extern function: rt_image_load`. rt_image_load returns 0 on a
# failed decode (see runtime_image.c), so a nonexistent path is a
# deterministic, side-effect-free way to exercise the real C call.

extern fn rt_image_load(path: text) -> i64

fn main() -> i64:
    val h = rt_image_load("/nonexistent/does_not_exist.png")
    print "image_load_result={h}"
    0
