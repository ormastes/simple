use test.fixture.erased_unwrap_oracle.payload_mod.{Payload}
use test.fixture.erased_unwrap_oracle.decoy_mod.{Dec}

class Holder:
    var owner: Payload?

    fn store(p: Payload):
        self.owner = p

    fn take() -> i64:
        val q = self.owner.unwrap()
        q.n

fn main():
    var dec = Dec(v: 7)
    print("DECOY=" + dec.unwrap().to_string() + "\n")
    var h = Holder(owner: nil)
    h.store(Payload(n: 4242))
    print("ERASED_UNWRAP=" + h.take().to_string() + "\n")
