"""Native regression probe for imported value structs read from returned arrays."""

use std.database.sql.types.{DbRow, DbValue}

fn first_cell(row: DbRow) -> text:
    if row.values.len() == 0: return ""
    row.values[0].to_text()

fn rows() -> [DbRow]:
    [DbRow(columns: ["value"], values: [DbValue.Text(value: "1")])]

fn main() -> i64:
    val result = rows()
    if result.len() != 1:
        print "FAIL length"
        return 1
    val value = first_cell(result[0])
    if value != "1":
        print "FAIL value=" + value
        return 2
    print "PASS imported_struct_array_argument"
    0
