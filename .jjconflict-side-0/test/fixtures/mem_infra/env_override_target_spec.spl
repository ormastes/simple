# Fixture (NOT collected: the runner's discovery skips any path containing
# "/fixtures/" — see src/lib/nogc_sync_mut/test_runner/test_runner_files.spl).
#
# Target for test/03_system/check/test_daemon_env_override_passthrough_spec.spl.
# It reports, from inside a real spec body, which SIMPLE_TEST_BINARY value that
# body actually observes — both Simple-side via env_get and in a child shell.
# Those two channels are reported separately because they fail together: when
# the spec body runs inside the long-lived test daemon, the daemon's frozen
# environment is what env_get reads AND what any child shell inherits, so
# resolving an override "in the shell instead" is not a workaround.

use std.spec.*
use std.io_runtime.{process_run, env_get}

describe "env override target fixture":
    it "reports the SIMPLE_TEST_BINARY value visible to a spec body":
        val direct = env_get("SIMPLE_TEST_BINARY") ?? ""
        print "OVERRIDE_TARGET direct=[{direct}]"
        # `{` in a Simple text literal opens an interpolation, so an unescaped
        # `${SIMPLE_TEST_BINARY:-}` is parsed Simple-side and the example dies
        # with "semantic: variable `SIMPLE_TEST_BINARY` not found" BEFORE the
        # shell ever runs. The braces must be doubled. This was wrong from the
        # moment the fixture landed (2026-08-02): the shell channel never
        # printed, so the passthrough spec that asserts on it has been red ever
        # since while appearing to be the regression coverage for that fix.
        # Same trap as test/01_unit/lib/mem_infra/guard_backend_parity_spec.spl:99.
        val (out, _err, _code) = process_run("/bin/sh",
            ["-c", "echo shell=[${{SIMPLE_TEST_BINARY:-}}]"])
        print "OVERRIDE_TARGET {out.trim()}"
        assert_equal(1, 1)
