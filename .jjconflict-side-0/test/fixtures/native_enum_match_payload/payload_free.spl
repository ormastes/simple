# Contrast fixture for scripts/check/check-native-enum-match-payload.shs
# Bug: doc/08_tracking/bug/match_on_enum_native_lowering_status_2026-08-07.md
#
# Payload-free enum match (this file) compiles and runs correctly under
# `--native`. It exists purely as a control: it proves the sibling
# `main.spl` failure is specific to payload-bearing variant patterns, not a
# general `--native` breakage.

enum Kind:
    A
    B
    C

fn describe_kind(k: Kind) -> text:
    match k:
        Kind.A: return "kind-A"
        Kind.B: return "kind-B"
        Kind.C: return "kind-C"

fn main():
    print(describe_kind(Kind.A))
    print(describe_kind(Kind.B))
    print(describe_kind(Kind.C))
