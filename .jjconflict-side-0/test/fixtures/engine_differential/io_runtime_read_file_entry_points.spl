# Divergence class (f): every std.io_runtime text-read entry point, called once.
#
# On 2026-08-23/24 `file_read`, `read_file` and `read_file_text` each ABORTED
# the process with `fatal runtime error: stack overflow` from a single import.
# The source was already correct at origin (1ca19a1e31a routes all three
# through `file_read_result`, whose name has exactly one definition tree-wide);
# the deployed seed was loading a pre-fix stdlib copy from ITS OWN build tree
# alongside the current one and keeping the first `file_read` by name, so the
# original file_read <-> read_file_text cycle re-entered from a file nobody
# was grepping. (io_runtime_read_file_still_aborts_incomplete_fix_2026-08-24.md)
#
# Scope note, measured: from INSIDE the tree the deployed seed happens to win
# the name race and prints all four lengths; the abort reproduces when the same
# program runs from a path OUTSIDE the tree (rc=134, zero stdout). This corpus
# runs in-tree, so on the stale seed this fixture is a control, not a trip-wire;
# it becomes a trip-wire the moment any lane resolves the stdlib the wrong way.
#
# A stack overflow kills the spec runner, so no spec can cover this; here a
# lane that aborts produces no stdout and is recorded as an ERROR lane, which
# is exactly the fail-closed behaviour wanted. Agreement across lanes on the
# four lengths is the property.

use std.io_runtime.{file_read, read_file, read_file_text, file_read_result}

fn main() -> i64:
    val p = "test/fixtures/engine_differential/io_runtime_read_file_entry_points.spl"
    print("file_read=" + file_read(p).len().to_text())
    print("read_file=" + read_file(p).len().to_text())
    print("read_file_text=" + read_file_text(p).len().to_text())
    match file_read_result(p):
        case Ok(s): print("file_read_result=" + s.len().to_text())
        case Err(_): print("file_read_result=ERR")
    0
