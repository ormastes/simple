# Divergence class (c): array mutation / aliasing (COW vs reference).
#
# Arrays are VALUE types in this language: passing one to a function, or
# binding it to a second name, must COPY. A codegen lane that passes the
# backing buffer by reference turns `mutate(copy)` into a mutation of the
# ORIGINAL -- a silent wrong answer with no crash.
#
# `orig0` staying 1 is the whole test. If any engine prints orig0=99 it has
# reference semantics where the language specifies value semantics.

fn mutate(inner: [i64]) -> i64:
    var local = inner
    local[0] = 99
    local[0]

fn main() -> i64:
    var xs = [1, 2, 3]
    val returned = mutate(xs)
    print("callee_saw={returned}")
    print("orig0={xs[0]}")

    var alias = xs
    alias[1] = 77
    print("after_alias_write_orig1={xs[1]}")
    print("alias1={alias[1]}")
    0
