use os.compositor.shared_mdi_setup.{shared_mdi_surfaces}
use common.ui.window_scene_draw_ir.{SharedWmPixelBufferBackend, shared_wm_pixel_buffer_pixels}

fn main():
    val surfaces = shared_mdi_surfaces()
    print(surfaces.len())
    print(surfaces[0].title)
    print(surfaces[4].title)

    var backend = SharedWmPixelBufferBackend.new(4, 3)
    backend.clear(0xFF101010u32)
    backend.fill_rect(1, 1, 2, 1, 0xFF3366CCu32)
    val pixels = shared_wm_pixel_buffer_pixels(backend)
    print(pixels.len())
    print(pixels[0])
    print(pixels[5])
    print(pixels[6])
