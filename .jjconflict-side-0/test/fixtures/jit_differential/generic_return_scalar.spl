# JIT-vs-interpreter fixture for
# doc/08_tracking/bug/generic_struct_field_untagged_payload_seed_2026-08-21.md
#
# A generic function's return slot is `ANY` (a single-uppercase type
# parameter resolves to TypeId::ANY), so the callee BOXES on the way out.
# Nothing unboxed on the way back in, so a scalar `T` accumulated a `<< 3`
# per generic hop: `ident(ai) + 1` twice gave 72 instead of 2. A generic
# struct's field is the same slot in a different coat: `Pair(a: 5).a`
# printed `<value:0x5>` because the raw scalar was stored into an ANY field
# and read back as a tagged word.
#
# Every line below is engine-independent ground truth; the interpreter was
# already correct for all of them.

struct Pair<T>:
    a: T
    b: T

fn ident<T>(a: T) -> T:
    a

fn main():
    var ai: i64 = 0
    ai = ident(ai) + 1
    ai = ident(ai) + 1
    print "i64chain={ai}"
    var af: f64 = 0.5
    af = ident(af) + 1.0
    print "f64chain={af}"
    print "bool={ident(true)}"
    print "text={ident(\"hi\")}"
    val p = Pair(a: 5, b: 6)
    print "ifield={p.a}"
    val q = Pair(a: 1.5, b: 2.5)
    print "ffield={q.a}"
    # Single-line summary for the differential harness, whose ground-truth
    # comparison is one `contains` against `Fixture.expected`.
    print "summary={ai}|{af}|{ident(true)}|{ident(\"hi\")}|{p.a}|{q.a}"
main()
