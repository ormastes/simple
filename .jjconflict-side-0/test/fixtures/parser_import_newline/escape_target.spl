# Minimal imported-module reproducer extracted from controlled_text.spl.
# The individual triple-backslash quote literal imports successfully; the
# compact escape decision chain is the smallest retained failing surface.
fn escape_candidate(cp: i64) -> text:
    val digits = "0123456789abcdef"
    var parts: [text] = []
    if cp == 34: parts.push("\\\"")
    elif cp == 92: parts.push("\\\\")
    elif cp == 8: parts.push("\\b")
    elif cp == 9: parts.push("\\t")
    elif cp == 10: parts.push("\\n")
    elif cp == 12: parts.push("\\f")
    elif cp == 13: parts.push("\\r")
    elif cp < 32:
        parts.push("\\u00" + digits.slice(cp / 16, cp / 16 + 1) + digits.slice(cp % 16, cp % 16 + 1))
    else: parts.push(cp.chr())
    parts.join("")
