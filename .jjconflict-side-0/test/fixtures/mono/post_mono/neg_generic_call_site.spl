# @expect: generic_call=1
# A call site the rewriter never repointed: it still carries type arguments.
use compiler.hir.hir.*
use compiler.verify.post_mono_verify.*
use post_mono_fixture_support.*

fn main():
    val call = fx_expr(HirExprKind.Call(
        fx_expr(HirExprKind.Var(SymbolId(id: 5))),
        [HirCallArg(has_name: false, name: "", value: fx_expr(HirExprKind.IntLit(7, nil)), span: fx_span())],
        [fx_i64()]
    ))
    val body = fx_block([HirStmt(kind: HirStmtKind.Expr(call), span: fx_span())], fx_expr(HirExprKind.NilLit))
    fx_emit(post_mono_verify(fx_module("neg_call", [fx_fn(8, "caller", [], [], fx_type(HirTypeKind.Unit), body)])))
