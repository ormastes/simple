# @expect: clean
# A fully substituted specialization (`$` mangled, concrete types only).
use compiler.hir.hir.*
use compiler.verify.post_mono_verify.*
use post_mono_fixture_support.*

fn main():
    val body = fx_block([], fx_typed_expr(HirExprKind.Var(SymbolId(id: 20)),
                                          fx_type(HirTypeKind.Array(fx_i64(), nil))))
    val f = fx_fn(2, "box_it$i64", [], [fx_param(20, "v", fx_i64())],
                  fx_type(HirTypeKind.Array(fx_i64(), nil)), body)
    fx_emit(post_mono_verify(fx_module("pos_spec", [f])))
