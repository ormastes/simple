# Fixture for lane S4 (union normalization) — a structural union type must
# lower to a CHECKED closed sum, never to Any.
#
# The union is written in a signature, which is where a union is authored.
# The driver runs union_normalize_module over the lowered HIR and must report
# a synthesized `@closed` enum __Union_bool_f64_i64_text for it.

fn tag(x: i64 | f64 | bool | text) -> i64:
    1

fn tag_reordered(x: text | bool | i64 | f64) -> i64:
    2

# A REAL narrowing match site over the same union (bug doc
# union_narrowing_has_no_grammar_or_runtime_2026-08-21.md). Every member is
# named, so this match must be EXHAUSTIVE and silent: it is the positive half
# of the gate. `case i64 v:` denotes variant I64 of __Union_bool_f64_i64_text,
# so the EXISTING closed-enum coverage rule governs it -- no union-specific
# checker exists or should.
fn narrow(x: i64 | f64 | bool | text) -> i64:
    match x:
        case i64 v: v
        case f64 f: 2
        case bool b: 3
        case text s: 4
