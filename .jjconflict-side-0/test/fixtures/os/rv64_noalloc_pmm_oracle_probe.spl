use os.kernel.boot.riscv_noalloc_pmm.{
    riscv_noalloc_pmm_reset,
    riscv_noalloc_pmm_init,
    riscv_noalloc_alloc_page,
    riscv_noalloc_pmm_is_ready,
    riscv_noalloc_pmm_base,
    riscv_noalloc_pmm_limit,
    riscv_noalloc_pmm_next,
    riscv_noalloc_pmm_total_pages,
    riscv_noalloc_pmm_free_pages
}

fn _flag(value: bool) -> i64:
    if value: 1
    else: 0

fn _emit(case_id: text, ok: bool, page0: u64, page1: u64, page2: u64):
    print "{case_id} ok={_flag(ok)} ready={_flag(riscv_noalloc_pmm_is_ready())} base={riscv_noalloc_pmm_base()} limit={riscv_noalloc_pmm_limit()} next={riscv_noalloc_pmm_next()} total={riscv_noalloc_pmm_total_pages()} free={riscv_noalloc_pmm_free_pages()} pages={page0},{page1},{page2}"

fn main():
    riscv_noalloc_pmm_reset()
    val invalid = riscv_noalloc_pmm_init(0x80000000, 4096, 0x80200000, 0x80400000)
    _emit("invalid-small", invalid, riscv_noalloc_alloc_page(), 0, 0)

    riscv_noalloc_pmm_reset()
    val aligned = riscv_noalloc_pmm_init(0x80000000, 0x08000000, 0x80200001, 0x80203000)
    val aligned0 = riscv_noalloc_alloc_page()
    val aligned1 = riscv_noalloc_alloc_page()
    val aligned2 = riscv_noalloc_alloc_page()
    _emit("alignment-exhaustion", aligned, aligned0, aligned1, aligned2)

    riscv_noalloc_pmm_reset()
    val short = riscv_noalloc_pmm_init(0x80000000, 0x08000000, 0x80200000, 0x80200001)
    val short0 = riscv_noalloc_alloc_page()
    _emit("short-window", short, short0, 0, 0)

    riscv_noalloc_pmm_reset()
    val reset_first = riscv_noalloc_pmm_init(0x80000000, 0x08000000, 0x80200000, 0x80203000)
    val reset_page = riscv_noalloc_alloc_page()
    val reset_second = riscv_noalloc_pmm_init(0x80000000, 0x08000000, 0x80300000, 0x80302000)
    _emit("valid-reset", reset_first and reset_second, reset_page, 0, 0)

    riscv_noalloc_pmm_reset()
    val retained_first = riscv_noalloc_pmm_init(0x80000000, 0x08000000, 0x80200000, 0x80202000)
    val retained_page = riscv_noalloc_alloc_page()
    val retained_reject = riscv_noalloc_pmm_init(0x80000000, 4096, 0x80200000, 0x80202000)
    _emit("invalid-retains-state", retained_first and not retained_reject, retained_page, 0, 0)

    riscv_noalloc_pmm_reset()
    val normalized = riscv_noalloc_pmm_init(0xffffffff80000000, 0x08000000, 0xffffffff80200001, 0xffffffff80203000)
    val normalized0 = riscv_noalloc_alloc_page()
    _emit("sign-extended", normalized, normalized0, 0, 0)

    riscv_noalloc_pmm_reset()
    val wrapped = riscv_noalloc_pmm_init(0xfffffffefffff000, 0x100002000, 0xfffffffefffff100, 0xfffffffefffff800)
    _emit("ram-end-wrap", wrapped, riscv_noalloc_alloc_page(), 0, 0)

    riscv_noalloc_pmm_reset()
    val invalid_reserved = riscv_noalloc_pmm_init(0x80000000, 0x08000000, 0x80000000, 0x80400000)
    val invalid_heap = riscv_noalloc_pmm_init(0x80000000, 0x08000000, 0x80200000, 0x80200000)
    val invalid_beyond = riscv_noalloc_pmm_init(0x80000000, 0x01000000, 0x80200000, 0x82000000)
    val invalid_aligned = riscv_noalloc_pmm_init(0x80000000, 0x08000000, 0x80200001, 0x80201000)
    _emit("remaining-invalid", not invalid_reserved and not invalid_heap and not invalid_beyond and not invalid_aligned, 0, 0, 0)
