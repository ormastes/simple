use app.startup.launch_metadata.{
    LOAD_POLICY_MAP_SELECTED_SEGMENTS,
    launch_metadata_default,
    launch_metadata_effective_load_policy,
    launch_metadata_for_simpleos_baremetal_path,
    load_policy_from_mmap_hint,
    load_policy_implies_mmap_hint,
    load_policy_is_valid,
    render_launch_metadata_sidecar,
    startup_plan_from_metadata
}

fn main() -> i64:
    var legacy = launch_metadata_default("smf")
    legacy.load_policy = ""
    val effective = launch_metadata_effective_load_policy(legacy)
    val baremetal = launch_metadata_for_simpleos_baremetal_path("app.smf")
    val plan = startup_plan_from_metadata(
        "app.smf", [], baremetal, false, true)
    val rendered = render_launch_metadata_sidecar(legacy)

    print("effective=" + effective)
    print("from_hint=" + load_policy_from_mmap_hint(true))
    print("implies=" + load_policy_implies_mmap_hint(effective).to_text())
    print("valid=" + load_policy_is_valid(LOAD_POLICY_MAP_SELECTED_SEGMENTS).to_text())
    print("source=" + plan.executable_source)
    print("rendered=" + rendered.contains("load_policy: \"map_selected_segments\"").to_text())
    0
