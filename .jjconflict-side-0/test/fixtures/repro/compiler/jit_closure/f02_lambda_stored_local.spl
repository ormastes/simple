# Fixture f02 — a lambda stored in a local and immediately called.
#
# Expectation: emits `MirInst::ClosureCreate`, so the whole module is
# refused by the JIT closure guard and drops to the tree-walk interpreter.
#
# Run: bin/simple run test/fixtures/repro/compiler/jit_closure/f02_lambda_stored_local.spl

fn main():
    val f = \x: x + 1
    print("f02 marker result={f(41)}")
