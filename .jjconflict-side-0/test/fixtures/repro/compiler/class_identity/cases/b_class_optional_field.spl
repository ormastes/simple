# F1 corpus case B — class instance held in an OPTIONAL field.
# Contract: the optional holds the REFERENCE.
# Prints REF when the contract holds, COPY(n=..) when it is violated.
# Under the seed JIT this case kills the process ("field access on nil
# receiver"), which is why it lives in its own file.

class CellB:
    n: i64

class OptHolderB:
    maybe: CellB?

fn main():
    val c = CellB(n: 110)
    val oh = OptHolderB(maybe: c)
    c.n = 111
    val m = oh.maybe
    val got = if m.? : m!.n else: -1
    if got == 111:
        print "B class optional field = REF"
    else:
        print "B class optional field = COPY(n={got})"
