"""Focused child whose production test wrapper supplies MC/DC transport."""
use std.spec.*

fn guarded_output(a: bool, b: bool) -> i64:
    if a and b:
        return 7
    3

describe "MC/DC end-to-end child vectors":
    it "covers false short-circuit vector":
        expect(guarded_output(false, false)).to_equal(3)

    it "covers second-condition false vector":
        expect(guarded_output(true, false)).to_equal(3)

    it "covers true decision vector":
        expect(guarded_output(true, true)).to_equal(7)

