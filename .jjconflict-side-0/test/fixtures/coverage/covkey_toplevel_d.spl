# Under-reporting probe: line 3 is a MODULE-LEVEL statement, executed once at
# import; lines 5 and 6 are ordinary function-body lines. All three genuinely
# execute, so an honest instrument must report 3/3 = 100%. A report of 2/3
# means module top-level lines lost their file attribution and the fix
# under-reports -- the opposite bug, and not acceptable.
pub val covkey_d_seed = 7

pub fn covfix_d_run() -> i64:
    var x = covkey_d_seed
    return x
