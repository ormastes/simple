"""
# HTTP/2 asynchronous dispatch identity specification
"""

use std.spec
use std.http_server.h2_async_dispatch.{H2AsyncDispatch}
use std.http_server.types.{HttpRequestData}

fn h2_request(path: text) -> HttpRequestData:
    HttpRequestData(
        method: "GET", path: path, query: "", version: "HTTP/2",
        headers: [], body: "", params: {}, peer_addr: "127.0.0.1"
    )

describe "HTTP/2 async dispatch identities":
    it "tracks multiplexed streams independently and cancels by connection":
        var dispatch = H2AsyncDispatch.create()
        expect(dispatch.register(11, 7, 1, h2_request("/one"))).to_equal(true)
        expect(dispatch.register(12, 7, 3, h2_request("/three"))).to_equal(true)
        expect(dispatch.register(13, 8, 1, h2_request("/other"))).to_equal(true)
        expect(dispatch.register(14, 7, 3, h2_request("/duplicate"))).to_equal(false)
        expect(dispatch.count()).to_equal(3)

        val removed = dispatch.remove_connection(7)
        expect(removed.len()).to_equal(2)
        expect(dispatch.contains(11)).to_equal(false)
        expect(dispatch.contains(12)).to_equal(false)
        expect(dispatch.contains(13)).to_equal(true)
        if val remaining = dispatch.get(13):
            expect(remaining.connection_id).to_equal(8)
            expect(remaining.stream_id).to_equal(1)
            expect(remaining.request.path).to_equal("/other")
        else:
            fail("unrelated connection target must remain")
