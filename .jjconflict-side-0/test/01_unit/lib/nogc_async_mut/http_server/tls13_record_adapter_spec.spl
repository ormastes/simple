"""Socket-neutral TLS 1.3 HTTP record adapter behavior."""

use std.spec
use std.http_server.tls13_record_adapter.{
    HttpTls13OpenAction, HttpTls13ReceiveAction, HttpTls13SendAction,
    http_tls13_open, http_tls13_receive, http_tls13_send
}
use os.tls13.server.{Tls13ServerContext}
use os.tls13.record13.{RecordKey, record13_encrypt_for_suite}

fn _tls13_adapter_key16() -> [u8]:
    var out: [u8] = []
    var index: u64 = 0u64
    while index < 16u64:
        out.push((0x10u64 + index).to_u8())
        index = index + 1u64
    out

fn _tls13_adapter_iv12() -> [u8]:
    var out: [u8] = []
    var index: u64 = 0u64
    while index < 12u64:
        out.push((0x30u64 + index).to_u8())
        index = index + 1u64
    out

fn _tls13_adapter_context(cipher_suite: u16) -> Tls13ServerContext:
    Tls13ServerContext(
        cipher_suite: cipher_suite,
        named_group: 0x001Du16,
        server_random: [],
        server_keyshare_pub: [],
        client_app_key: _tls13_adapter_key16(),
        client_app_iv: _tls13_adapter_iv12(),
        server_app_key: _tls13_adapter_key16(),
        server_app_iv: _tls13_adapter_iv12(),
        client_seq: 0u64,
        server_seq: 0u64
    )

fn _tls13_adapter_plaintext() -> [u8]:
    [0x47u8, 0x45u8, 0x54u8, 0x20u8, 0x2Fu8]

fn _tls13_adapter_prefix(data: [u8], count: u64) -> [u8]:
    var out: [u8] = []
    var index: u64 = 0u64
    while index < count:
        out.push(data[index])
        index = index + 1u64
    out

fn _tls13_adapter_suffix(data: [u8], start: u64) -> [u8]:
    var out: [u8] = []
    var index = start
    while index < data.len():
        out.push(data[index])
        index = index + 1u64
    out

describe "HTTP TLS 1.3 record adapter":
    it "round-trips application data and advances directional sequences":
        match http_tls13_open(_tls13_adapter_context(0x1301u16)):
            case HttpTls13OpenAction.Ready(session):
                match http_tls13_send(session, _tls13_adapter_plaintext()):
                    case HttpTls13SendAction.WireRecord(sent_session, record):
                        expect(sent_session.server_seq).to_equal(1u64)
                        match http_tls13_receive(session, record):
                            case HttpTls13ReceiveAction.Plaintext(received_session, data):
                                expect(received_session.client_seq).to_equal(1u64)
                                expect(data).to_equal(_tls13_adapter_plaintext())
                            case HttpTls13ReceiveAction.NeedMore(_):
                                expect(false).to_equal(true)
                            case HttpTls13ReceiveAction.Close(_, _):
                                expect(false).to_equal(true)
                    case HttpTls13SendAction.Close(_, _):
                        expect(false).to_equal(true)
            case HttpTls13OpenAction.Close(_):
                expect(false).to_equal(true)

    it "retains a split record without exposing ciphertext as plaintext":
        match http_tls13_open(_tls13_adapter_context(0x1301u16)):
            case HttpTls13OpenAction.Ready(session):
                val key = RecordKey(key: _tls13_adapter_key16(), iv: _tls13_adapter_iv12())
                val record = record13_encrypt_for_suite(
                    0x1301u16, key, 0u64, 0x17u8, _tls13_adapter_plaintext())
                match http_tls13_receive(session, _tls13_adapter_prefix(record, 7u64)):
                    case HttpTls13ReceiveAction.NeedMore(partial):
                        expect(partial.client_seq).to_equal(0u64)
                        match http_tls13_receive(partial, _tls13_adapter_suffix(record, 7u64)):
                            case HttpTls13ReceiveAction.Plaintext(complete, data):
                                expect(complete.client_seq).to_equal(1u64)
                                expect(data).to_equal(_tls13_adapter_plaintext())
                            case HttpTls13ReceiveAction.NeedMore(_):
                                expect(false).to_equal(true)
                            case HttpTls13ReceiveAction.Close(_, _):
                                expect(false).to_equal(true)
                    case HttpTls13ReceiveAction.Plaintext(_, _):
                        expect(false).to_equal(true)
                    case HttpTls13ReceiveAction.Close(_, _):
                        expect(false).to_equal(true)
            case HttpTls13OpenAction.Close(_):
                expect(false).to_equal(true)

    it "rejects AES-256 rather than silently dispatching it as AES-128":
        match http_tls13_open(_tls13_adapter_context(0x1302u16)):
            case HttpTls13OpenAction.Close(reason):
                expect(reason).to_equal(
                    "tls13_aes256_gcm_application_records_unimplemented")
            case HttpTls13OpenAction.Ready(_):
                expect(false).to_equal(true)

    it "rejects ChaCha20 until the server handshake derives 32-byte keys":
        match http_tls13_open(_tls13_adapter_context(0x1303u16)):
            case HttpTls13OpenAction.Close(reason):
                expect(reason).to_equal(
                    "tls13_chacha20_application_keys_unresolved")
            case HttpTls13OpenAction.Ready(_):
                expect(false).to_equal(true)

    it "closes on an unresolved encrypted post-handshake transition":
        match http_tls13_open(_tls13_adapter_context(0x1301u16)):
            case HttpTls13OpenAction.Ready(session):
                val key = RecordKey(key: _tls13_adapter_key16(), iv: _tls13_adapter_iv12())
                val record = record13_encrypt_for_suite(
                    0x1301u16, key, 0u64, 0x16u8, [0x18u8])
                match http_tls13_receive(session, record):
                    case HttpTls13ReceiveAction.Close(closed, reason):
                        expect(closed.client_seq).to_equal(0u64)
                        expect(reason).to_equal(
                            "tls13_post_handshake_transition_unimplemented")
                    case HttpTls13ReceiveAction.NeedMore(_):
                        expect(false).to_equal(true)
                    case HttpTls13ReceiveAction.Plaintext(_, _):
                        expect(false).to_equal(true)
            case HttpTls13OpenAction.Close(_):
                expect(false).to_equal(true)

    it "closes before buffering an oversized wire batch":
        match http_tls13_open(_tls13_adapter_context(0x1301u16)):
            case HttpTls13OpenAction.Ready(session):
                var oversized: [u8] = []
                var index: u64 = 0u64
                while index < 32813u64:
                    oversized.push(0u8)
                    index = index + 1u64
                match http_tls13_receive(session, oversized):
                    case HttpTls13ReceiveAction.Close(_, reason):
                        expect(reason).to_equal("tls13_receive_buffer_limit")
                    case HttpTls13ReceiveAction.NeedMore(_):
                        expect(false).to_equal(true)
                    case HttpTls13ReceiveAction.Plaintext(_, _):
                        expect(false).to_equal(true)
            case HttpTls13OpenAction.Close(_):
                expect(false).to_equal(true)
