use std.spec.*
use std.common.debug.contracts_v1.{debug_policy_development_v1, debug_policy_observe_only_v1}
use std.common.debug.service_v1.{central_debug_service_v1_close, central_debug_service_v1_receipts}
use std.nogc_async_mut.mcp.session.{SessionManager, TargetType}
use std.nogc_async_mut.debug.coordinator.{DebugCoordinator, DebugBackend, FrameInfo, VarInfo, LocationInfo}
use std.nogc_async_mut.debug.coordinator_service_adapter_v1.{DebugCoordinatorServiceAdapterV1}

class CoordinatorFixtureBackend:
    attach_calls: i64
    detach_calls: i64

    static fn create() -> CoordinatorFixtureBackend:
        CoordinatorFixtureBackend(attach_calls: 0, detach_calls: 0)

impl DebugBackend for CoordinatorFixtureBackend:
    fn name() -> String: "coordinator-fixture"
    me attach(program_path: String, args: [String]) -> Result<Nil, String>:
        self.attach_calls = self.attach_calls + 1
        Ok(nil)
    me detach() -> Result<Nil, String>:
        self.detach_calls = self.detach_calls + 1
        Ok(nil)
    fn run() -> Result<Nil, String>: Ok(nil)
    fn pause() -> Result<Nil, String>: Ok(nil)
    fn resume() -> Result<Nil, String>: Ok(nil)
    fn step_over() -> Result<Nil, String>: Ok(nil)
    fn step_in() -> Result<Nil, String>: Ok(nil)
    fn step_out() -> Result<Nil, String>: Ok(nil)
    fn add_breakpoint(file: String, line: Int) -> Result<Int, String>: Ok(1)
    fn remove_breakpoint(file: String, line: Int) -> Result<Nil, String>: Ok(nil)
    fn stack_trace() -> Result<[FrameInfo], String>: Ok([])
    fn locals() -> Result<[VarInfo], String>: Ok([])
    fn evaluate(expr: String) -> Result<String, String>: Ok(expr)
    fn current_location() -> Result<LocationInfo, String>: Ok(LocationInfo.at("fixture.spl", 1, "fixture"))

fn fixture_adapter(backend: CoordinatorFixtureBackend, manager: SessionManager) -> DebugCoordinatorServiceAdapterV1:
    val coordinator = DebugCoordinator.with_session_manager(manager)
    coordinator.register_interpreter(backend)
    DebugCoordinatorServiceAdapterV1.create(coordinator)

describe "DebugCoordinatorServiceAdapterV1 harmony bridge":
    it "keeps local handles private and assigns unique central session ids":
        val manager = SessionManager.empty()
        val local_first = manager.create_session(TargetType.Interpreter, "first.spl")
        val local_second = manager.create_session(TargetType.Interpreter, "second.spl")
        val backend = CoordinatorFixtureBackend.create()
        val adapter = fixture_adapter(backend, manager)
        val first = adapter.bind(local_first, "build-first", debug_policy_development_v1())!
        val second = adapter.bind(local_second, "build-second", debug_policy_development_v1())!
        expect(first.value == second.value).to_equal(false)
        expect(first.value == local_first).to_equal(false)
        expect(second.value == local_second).to_equal(false)
        adapter.close(first)!
        adapter.close(second)!

    it "denies control before invoking the legacy coordinator backend":
        val manager = SessionManager.empty()
        val local = manager.create_session(TargetType.Interpreter, "denied.spl")
        val backend = CoordinatorFixtureBackend.create()
        val adapter = fixture_adapter(backend, manager)
        val session_id = adapter.bind(local, "build-denied", debug_policy_observe_only_v1())!
        expect(adapter.run_session(session_id).is_err()).to_equal(true)
        expect(backend.attach_calls).to_equal(0)
        val receipts = central_debug_service_v1_receipts(session_id)
        expect(receipts.filter(_.action == "legacy.coordinator.run" and not _.allowed).len()).to_equal(1)
        central_debug_service_v1_close(session_id)!

    it "detaches the resource then closes centrally with ordered receipts":
        val manager = SessionManager.empty()
        val local = manager.create_session(TargetType.Interpreter, "cleanup.spl")
        val backend = CoordinatorFixtureBackend.create()
        val adapter = fixture_adapter(backend, manager)
        val session_id = adapter.bind(local, "build-cleanup", debug_policy_development_v1())!
        adapter.close(session_id)!
        expect(backend.detach_calls).to_equal(1)
        val receipts = central_debug_service_v1_receipts(session_id)
        expect(receipts[receipts.len() - 2].action).to_equal("legacy.coordinator.detach.outcome")
        expect(receipts[receipts.len() - 1].action).to_equal("session.close")
        expect(adapter.close(session_id).is_err()).to_equal(true)
