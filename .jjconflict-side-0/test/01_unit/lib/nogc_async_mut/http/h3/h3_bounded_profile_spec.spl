use std.spec
use std.nogc_async_mut.http.h3.h3_frame.{
    H3SettingsResult, H3Setting, H3_MAX_VARINT,
    h3_varint_encode, h3_frame_parse_bounded,
    h3_settings_encode, h3_settings_decode_strict
}

describe "HTTP/3 bounded typed frame profile":
    it "rejects values outside the QUIC varint domain":
        expect(h3_varint_encode(-1).len()).to_equal(0)
        expect(h3_varint_encode(H3_MAX_VARINT + 1).len()).to_equal(0)

    it "rejects a declared payload before copying it":
        val wire: [u8] = [0, 64, 64]
        match h3_frame_parse_bounded(wire, 0, 32):
            case Err(reason):
                expect(reason).to_equal("frame payload exceeds configured bound")
            case _:
                expect("unexpected outcome").to_equal("rejected")

    it "rejects duplicate SETTINGS atomically":
        match h3_settings_decode_strict([1 as u8, 0 as u8, 1 as u8, 8 as u8]):
            case Err(reason):
                expect(reason).to_equal("duplicate setting identifier")
            case _:
                expect("unexpected outcome").to_equal("rejected")

    it "refuses to emit duplicate SETTINGS":
        val payload = h3_settings_encode([
            H3Setting(identifier: 1, value: 0),
            H3Setting(identifier: 1, value: 8)
        ])
        expect(payload.len()).to_equal(0)

    it "rejects HTTP/2-only setting identifiers":
        match h3_settings_decode_strict([2 as u8, 0 as u8]):
            case Err(reason):
                expect(reason).to_equal("forbidden HTTP/2 setting identifier")
            case _:
                expect("unexpected outcome").to_equal("rejected")

    it "returns the complete valid SETTINGS set":
        val payload = h3_settings_encode([
            H3Setting(identifier: 1, value: 0),
            H3Setting(identifier: 6, value: 4096)
        ])
        match h3_settings_decode_strict(payload):
            case Ok(result):
                expect(result.settings.len()).to_equal(2)
                expect(result.settings[1].value).to_equal(4096)
            case _:
                expect("unexpected outcome").to_equal("accepted")
