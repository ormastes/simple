# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# AsyncTcpListener / AsyncTcpStream, exercised for real on the loopback
# interface: bind, eager connect, accepted-connection echo, and close
# state transitions. Futures are driven with poll() exactly like the
# production single-threaded event loop would.

use std.spec.step
use std.nogc_async_mut.io.tcp.{AsyncTcpListener, AsyncTcpStream}
use std.async.poll.{Poll}

describe "AsyncTcpListener lifecycle":
    # @manual scenario evidence
    it "binds to an ephemeral port and reports its address":
        # @req REQ-SSPEC-LIB
        step("bind on 127.0.0.1:0 and read local_addr")
        val listener = match AsyncTcpListener.bind("127.0.0.1:0").poll():
            case Poll.Ready(Ok(l)): l
            case _: panic("bind failed")
        val addr = listener.local_addr().unwrap()
        expect(addr.contains("127.0.0.1")).to_equal(true)
        expect(listener.is_open()).to_equal(true)
        listener.close()

describe "AsyncTcpStream loopback":
    it "connect is eager and the stream reports open":
        # @req REQ-SSPEC-LIB
        step("connect to a bound listener and check is_open")
        val listener = match AsyncTcpListener.bind("127.0.0.1:0").poll():
            case Poll.Ready(Ok(l)): l
            case _: panic("bind failed")
        val addr = listener.local_addr().unwrap()
        var client = match AsyncTcpStream.connect(addr).poll():
            case Poll.Ready(Ok(s)): s
            case _: panic("connect failed")
        expect(client.is_open()).to_equal(true)
        client.close()
        listener.close()

    it "carries a payload from client to accepted server side":
        # @req REQ-SSPEC-LIB
        step("write then read an exact byte payload across loopback")
        val listener = match AsyncTcpListener.bind("127.0.0.1:0").poll():
            case Poll.Ready(Ok(l)): l
            case _: panic("bind failed")
        val addr = listener.local_addr().unwrap()
        var client = match AsyncTcpStream.connect(addr).poll():
            case Poll.Ready(Ok(s)): s
            case _: panic("connect failed")
        var server = match listener.accept().poll():
            case Poll.Ready(Ok(s)): s
            case _: panic("accept failed")
        val payload: [u8] = [72, 101, 108, 108, 111]
        match client.write(payload).poll():
            case Poll.Ready(Ok(n)): expect(n).to_equal(5)
            case _: expect(false).to_equal(true)
        client.flush()
        var received = match server.read_exact(5).poll():
            case Poll.Ready(Ok(data)): data
            case _: panic("read failed")
        expect(received.len()).to_equal(5)
        expect(received[0]).to_equal(72)
        expect(received[4]).to_equal(111)
        client.close()
        server.close()
        listener.close()

    it "a closed listener no longer reports open":
        # @req REQ-SSPEC-LIB
        step("close the listener and re-check is_open")
        val listener = match AsyncTcpListener.bind("127.0.0.1:0").poll():
            case Poll.Ready(Ok(l)): l
            case _: panic("bind failed")
        listener.close()
        expect(listener.is_open()).to_equal(false)
