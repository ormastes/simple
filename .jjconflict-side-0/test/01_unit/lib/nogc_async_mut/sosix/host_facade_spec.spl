# @cover src/lib/nogc_async_mut/sosix/host_facade.spl 80%
"""
# sosix Host Facade

**Category:** Stdlib
**Status:** In Progress

## Overview

As a tool author I want one `sosix_*` surface for running programs, locating
executables and sampling process usage, so that my tool never reaches for a
native or POSIX library directly and can follow the facade onto Windows or
SimpleOS later. On POSIX the facade must behave exactly like the primitive it
fronts — running a command must round-trip its output and its exit code, a
missing executable must report absence rather than guess, and a usage sample
for a process that does not exist must say so instead of returning zeros.

## Key Concepts

| Concept | Description |
|---------|-------------|
| `sosix_platform()` | Host family, either `"posix"` or `"windows"` |
| `SosixRun` | stdout / stderr / exit code of a finished command |
| `SosixProcUsage` | CPU percent and RSS, with `valid` false when unknown |
"""

use std.spec
use std.nogc_async_mut.sosix.{
    sosix_platform, sosix_run, sosix_which, sosix_proc_usage,
    sosix_spawn, sosix_is_running, sosix_kill
}


describe "sosix host facade":
    it "reports a known host family":
        val plat = sosix_platform()
        step("Then the family is one of the two the facade defines")
        assert_true(plat == "posix" or plat == "windows")

    it "round-trips stdout and a zero exit code from a real command":
        val run = sosix_run("echo", ["sosix-ok"])
        step("Then stdout carries what the command printed")
        expect(run.stdout).to_contain("sosix-ok")
        step("And the exit code is zero")
        expect(run.exit_code).to_equal(0)

    it "reports a nonzero exit code from a failing command":
        val run = sosix_run("sh", ["-c", "exit 3"])
        step("Then the failure is visible to the caller")
        expect(run.exit_code).to_equal(3)

    it "resolves a real executable on PATH":
        val path = sosix_which("sh")
        step("Then a non-empty absolute path comes back")
        expect(path.len()).to_be_greater_than(0)
        expect(path).to_contain("sh")

    it "reports absence for an executable that does not exist":
        val path = sosix_which("sosix_no_such_binary_zzz")
        step("Then the empty string marks it as not installed")
        expect(path).to_equal("")

    it "marks process usage invalid for a bogus pid":
        val usage = sosix_proc_usage(-1)
        step("Then valid is false rather than fabricated zeros")
        assert_false(usage.valid)

    it "samples real usage for a live process":
        val pid = sosix_spawn("sh", ["-c", "sleep 5"])
        expect(pid).to_be_greater_than(0)
        val usage = sosix_proc_usage(pid)
        step("Then the sample is marked valid")
        assert_true(usage.valid)
        step("And a resident set size was actually read")
        assert_true(usage.rss_mb >= 0)
        sosix_kill(pid)

    it "spawns, observes and kills a process":
        val pid = sosix_spawn("sh", ["-c", "sleep 5"])
        step("Then a usable pid comes back")
        expect(pid).to_be_greater_than(0)
        step("And the process is observably alive")
        assert_true(sosix_is_running(pid))
        step("And it can be terminated through the facade")
        assert_true(sosix_kill(pid))
