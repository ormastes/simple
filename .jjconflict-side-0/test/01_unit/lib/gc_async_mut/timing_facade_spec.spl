# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec
use std.spec.step
use std.gc_async_mut.timing.{Instant, ProfileResult, BenchmarkResult}


describe "gc_async_mut timing facade":
    # @manual scenario evidence

    it "re-exports timing record types without depending on wall-clock assertions":
        # @req REQ-SSPEC-UNIT
        step("re-exports timing record types without depending on wall-clock assertions")
        val start = Instant(micros: 1000)
        expect(start.micros).to_equal(1000)

        val profile = ProfileResult(elapsed_ms: 2, elapsed_micros: 2500)
        expect(profile.elapsed_ms).to_equal(2)
        expect(profile.elapsed_micros).to_equal(2500)

        val bench = BenchmarkResult(iterations: 3, total_ms: 9, avg_ms: 3.0, min_ms: 2, max_ms: 4)
        expect(bench.iterations).to_equal(3)
        expect(bench.avg_ms).to_equal(3.0)
        expect(bench.max_ms).to_equal(4)
