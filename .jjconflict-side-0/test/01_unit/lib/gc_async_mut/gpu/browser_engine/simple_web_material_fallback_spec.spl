use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{simple_web_material_fallback_realized}

describe "Simple Web material fallback provenance":

    it "accepts only an opaque layer-free realized material":
        expect(simple_web_material_fallback_realized(true, 0xFF123456u32, 0u32, 0u32, "")).to_be(true)
        expect(simple_web_material_fallback_realized(true, 0x7F123456u32, 0u32, 0u32, "")).to_be(false)
        expect(simple_web_material_fallback_realized(true, 0xFF123456u32, 0xFF000000u32, 0u32, "")).to_be(false)
        expect(simple_web_material_fallback_realized(true, 0xFF123456u32, 0u32, 0u32, "url(material.png)")).to_be(false)

    it "keeps malformed fallback declarations fail-closed":
        expect(simple_web_material_fallback_realized(false, 0xFF123456u32, 0u32, 0u32, "")).to_be(false)
