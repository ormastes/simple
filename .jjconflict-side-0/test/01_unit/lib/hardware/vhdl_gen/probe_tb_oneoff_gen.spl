# Runnable probe for the one-off harness generator — generates each file,
# byte-compares it against the on-disk golden (which is the acceptance oracle
# and is never written by this probe), and proves determinism by generating
# each a second time.
#
# False-green guards, checked BEFORE any PASS is reported:
#   * the generated text must be non-empty and multi-line
#   * the golden read back off disk must be non-empty (a missing file reads as
#     "" and would otherwise compare equal to an empty generation)
#   * the file count must be exactly the expected 2, and the dispatcher must
#     agree with the direct entry points
# Run: bin/simple run test/01_unit/lib/hardware/vhdl_gen/probe_tb_oneoff_gen.spl

use std.hardware.vhdl_gen.tb_oneoff_gen.{generate_tb_rv32_payload, generate_tb_gate, generate_oneoff_tb, oneoff_tb_paths}

extern fn rt_file_read_text(path: text) -> text

val EXPECTED_FILES: i64 = 2

fn first_diff(a: text, b: text) -> i64:
    var n = a.len()
    if b.len() < n:
        n = b.len()
    var i = 0
    while i < n:
        if a[i] != b[i]:
            return i
        i = i + 1
    if a.len() == b.len():
        return -1
    n

fn window(s: text, at: i64) -> text:
    var lo = at - 100
    if lo < 0:
        lo = 0
    var hi = at + 60
    if hi > s.len():
        hi = s.len()
    s.substring(lo, hi)

# Split rather than index: the payload header carries a multi-byte em dash, and
# byte-length vs character-index disagree on it.
fn count_lines(s: text) -> i64:
    s.split("\n").len() - 1

fn check(name: text, ok: bool) -> i64:
    if ok:
        print("PASS " + name)
        return 0
    print("FAIL " + name)
    1

# Byte-compare one generated file against its golden, with the emptiness guards
# applied first so an empty-vs-empty comparison can never report PASS.
fn check_golden(path: text, generated: text, min_lines: i64) -> i64:
    var fails = 0
    if generated.len() == 0:
        print("FAIL " + path + " GUARD: generated text is EMPTY")
        return 1
    val glines = count_lines(generated)
    if glines < min_lines:
        print("FAIL " + path + " GUARD: generated only " + glines.to_text()
            + " lines, expected >= " + min_lines.to_text())
        fails = fails + 1
    val golden = rt_file_read_text(path)
    if golden.len() == 0:
        print("FAIL " + path + " GUARD: golden is EMPTY or unreadable (wrong cwd?)")
        return fails + 1
    if generated == golden:
        print("PASS " + path + " byte-identical (" + generated.len().to_text()
            + " bytes, " + glines.to_text() + " lines)")
        return fails
    print("FAIL " + path + " (gen " + generated.len().to_text()
        + " bytes vs golden " + golden.len().to_text() + " bytes)")
    val d = first_diff(generated, golden)
    print("  first difference at byte " + d.to_text())
    print("  GEN    |" + window(generated, d) + "|")
    print("  GOLDEN |" + window(golden, d) + "|")
    fails + 1

fn main():
    val paths = oneoff_tb_paths()
    var fails = 0

    # Guard: the generator must claim exactly the files this probe verifies.
    fails = fails + check("file count is " + EXPECTED_FILES.to_text(),
        paths.len() == EXPECTED_FILES)

    val payload = generate_tb_rv32_payload()
    val gate = generate_tb_gate()

    fails = fails + check_golden("examples/09_embedded/fpga_riscv/payload/tb_rv32_payload.vhd",
        payload, 101)
    fails = fails + check_golden("test/riscv_isa_gate/tb_gate.vhd", gate, 58)

    # The path dispatcher must agree with the direct entry points, and must
    # return "" for an unknown path (so a typo cannot silently pass).
    fails = fails + check("dispatch payload", generate_oneoff_tb(paths[0]) == payload)
    fails = fails + check("dispatch gate", generate_oneoff_tb(paths[1]) == gate)
    fails = fails + check("dispatch unknown -> empty", generate_oneoff_tb("nope.vhd") == "")

    # Determinism: a second generation pass must be byte-identical. Run
    # repeatedly across processes to also cover per-process ordering effects.
    val payload2 = generate_tb_rv32_payload()
    val gate2 = generate_tb_gate()
    fails = fails + check("determinism tb_rv32_payload", payload == payload2)
    fails = fails + check("determinism tb_gate", gate == gate2)

    # Recorded rationale: bounded_loop_example.vhd is deliberately NOT generated.
    print("SKIP examples/09_embedded/vhdl/simulation/bounded_loop_example.vhd"
        + " — hand-written reference fixture of the compiler --backend=vhdl lane,"
        + " no consumer, and does not analyse (ceil/log2/real without ieee.math_real)")

    if fails == 0:
        print("TB_ONEOFF PROBE: ALL PASS")
    else:
        print("TB_ONEOFF PROBE: " + fails.to_text() + " FAILURES")
