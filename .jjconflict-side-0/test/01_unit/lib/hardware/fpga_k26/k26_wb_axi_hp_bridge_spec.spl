use std.spec.*
use lib.hardware.fpga_k26.k26_axi_hp_bridge.{generate_wb64_axi_hp_bridge_vhdl, generate_rv64_k26_ps_pl_top_vhdl}

describe "K26 RV64 Wishbone to AXI-HP bridge":
    it "holds one request through AXI backpressure and selects both 128-bit lanes":
        val vhdl = generate_wb64_axi_hp_bridge_vhdl()
        expect(vhdl).to_contain("type state_t is (idle, write_issue, write_response, read_issue, read_response, wb_release)")
        expect(vhdl).to_contain("signal aw_pending")
        expect(vhdl).to_contain("signal w_pending")
        expect(vhdl).to_contain("upper_q <= wb_adr_i(3)")
        expect(vhdl).to_contain("m_axi_awlock  <= '0'")
        expect(vhdl).to_contain("m_axi_arlock  <= '0'")
        expect(vhdl).to_contain("axi_addr_q <= unsigned(addr_q(48 downto 0)) - CORE_DDR_BASE + K26_DDR_BASE")
        expect(vhdl).to_contain("m_axi_awaddr  <= std_logic_vector(axi_addr_q(48 downto 3)) & \"000\"")
        expect(vhdl).to_contain("m_axi_araddr  <= std_logic_vector(axi_addr_q(48 downto 3)) & \"000\"")
        expect(vhdl).to_contain("m_axi_wdata   <= data_q & x\"0000000000000000\" when upper_q = '1'")
        expect(vhdl).to_contain("wb_dat_o <= m_axi_rdata(127 downto 64)")
        expect(vhdl).to_contain("wb_dat_o <= m_axi_rdata(63 downto 0)")
        expect(vhdl).to_contain("m_axi_awlen   <= (others => '0')")
        expect(vhdl).to_contain("m_axi_arsize  <= \"011\"")
        expect(vhdl).to_contain("wb_err_o <= m_axi_rresp(1) or not m_axi_rlast")
        expect(vhdl).to_contain("when wb_release =>")
        expect(vhdl).to_contain("if wb_cyc_i = '0' or wb_stb_i = '0' then")

    it "connects the product SoC external DDR boundary to the AXI bridge":
        val vhdl = generate_rv64_k26_ps_pl_top_vhdl()
        expect(vhdl).to_contain("entity work.soc_top_rv64_external_ddr")
        expect(vhdl).to_contain("entity work.wb64_axi_hp_bridge")
        expect(vhdl).to_contain("ddr_wb_lock_o => ddr_lock")
        expect(vhdl).to_contain("wb_lock_i => ddr_lock")
        expect(vhdl).to_contain("ddr_wb_err_i => ddr_err")
        expect(vhdl).to_contain("wb_err_o => ddr_err")
