# @cover src/lib/nogc_sync_mut/mem/dump.spl 20%
"""
# Memory snapshot dump produces a versioned TSV (M8-prep, mem_dump_tsv)

**Category:** Lib / Memory

## Overview

`mem_dump_tsv()` builds the versioned snapshot string described in
`doc/05_design/app/mem_cli/m8_simple_mem_cli_design.md` section 3: a header
line, one `KIND` row per live heap-object-kind counter, optional `OWNER`
rows, and a final `RSS` row. This spec calls the builder directly -- no
signal needed.
"""

use std.spec
use std.nogc_sync_mut.mem.dump.{mem_dump_tsv}

describe "mem_dump_tsv builds a versioned memory snapshot":
    it "first line starts with the format header and version":
        val tsv = mem_dump_tsv()
        val lines = tsv.split("\n")
        expect(lines[0]).to_start_with("simple-mem-snapshot\tv1")

    it "contains at least one KIND row":
        val tsv = mem_dump_tsv()
        expect(tsv).to_contain("KIND\t")

    it "contains an RSS row":
        val tsv = mem_dump_tsv()
        expect(tsv).to_contain("RSS\t")
