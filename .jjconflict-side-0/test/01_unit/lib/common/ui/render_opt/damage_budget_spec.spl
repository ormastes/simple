# @cover src/lib/common/ui/render_opt/damage_budget.spl 95%
# @tag: unit, ui, render_perf, damage, frame_switch, 8k, 80fps

use std.spec
use common.ui.render_opt.damage_tiles.DirtyTilePyramid
use common.ui.render_opt.damage_plan.{DamageFramePlan, build_damage_frame_plan}
use common.ui.render_opt.damage_budget.{
    admit_damage_plan_budget, DAMAGE_BUDGET_IDLE,
    DAMAGE_BUDGET_ADMIT_FULL, DAMAGE_BUDGET_REJECT,
    DAMAGE_BUDGET_INVALID
}

fn plan_for_pixels(rows: i64) -> DamageFramePlan:
    # One full-width tile per row keeps this pure geometry fixture bounded
    # while retaining exact pixel counts for the measured row profile.
    val tiles = DirtyTilePyramid.create(7680, 4320, [7680], [1])
    if rows > 0:
        tiles.mark_rect(0, 0, 7680, rows)
    build_damage_frame_plan(tiles, 0, 8, 100)

describe "measured retained-damage frame budget admission":
    it "admits idle frames with zero predicted work":
        val r = admit_damage_plan_budget(
            plan_for_pixels(0), 12500000, 7680, 114549, "x86-mixed-p95")
        expect(r.status).to_equal(DAMAGE_BUDGET_IDLE)
        assert_true(r.admitted)
        expect(r.predicted_ns).to_equal(0)

    it "pins the mixed-alpha 8K allowance to 838069 pixels":
        val within = admit_damage_plan_budget(
            plan_for_pixels(109), 12500000, 7680, 114549, "x86-mixed-p95")
        expect(within.maximum_pixels).to_equal(838069)
        assert_true(within.admitted)
        val over = admit_damage_plan_budget(
            plan_for_pixels(110), 12500000, 7680, 114549, "x86-mixed-p95")
        expect(over.status).to_equal(DAMAGE_BUDGET_REJECT)
        assert_false(over.admitted)

    it "rejects opaque-image full repaint but admits constant full repaint":
        val full = plan_for_pixels(4320)
        val image = admit_damage_plan_budget(
            full, 12500000, 7680, 12544, "x86-opaque-image-p95")
        expect(image.maximum_pixels).to_equal(7653061)
        expect(image.predicted_ns).to_equal(54190080)
        expect(image.status).to_equal(DAMAGE_BUDGET_REJECT)
        val constant = admit_damage_plan_budget(
            full, 12500000, 7680, 1503, "x86-opaque-constant-p95")
        expect(constant.status).to_equal(DAMAGE_BUDGET_ADMIT_FULL)
        expect(constant.predicted_ns).to_equal(6492960)

    it "fails closed for invalid or missing measurement receipts":
        val r = admit_damage_plan_budget(
            plan_for_pixels(1), 12500000, 0, 0, "missing")
        expect(r.status).to_equal(DAMAGE_BUDGET_INVALID)
        assert_false(r.admitted)
