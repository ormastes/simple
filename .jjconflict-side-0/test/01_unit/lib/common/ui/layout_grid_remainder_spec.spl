"""
## Purpose and audience
Purpose: Prove that layout_grid fills its container exactly.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

# @cover src/lib/common/ui/layout.spl 80%
# @req FR-UI-LAYOUT-GRID-REMAINDER
#
# layout.spl documents one distribution invariant for its flex axes: the
# integer-division remainder is "awarded exactly once, to the last
# space-taking child" (layout_hbox) / "flex_idx == flex_count"
# (layout_vbox), so children always sum to the container. layout_grid did
# not honour it: `cell_w = w / cols` and `cell_h = h / rows` truncate and
# the leftover pixels were simply never handed to anyone, leaving an
# unpainted strip of up to `cols-1` px on the right edge and `rows-1` px
# along the bottom of every grid whose size is not an exact multiple of its
# track count.
#
# These examples assert the SUM property (the last column's right edge is
# the container's right edge; the last row's bottom is the container's
# bottom), not individual cell sizes — a per-cell assertion passes both
# before and after a wrong fix.

use std.spec.{describe, it, expect}
use common.ui.widget.{WidgetNode, WidgetKind}
use common.ui.builder.{button}
use common.ui.layout.{compute_layout, find_rect}

# Border-free grid container: `grid_layout()` builds a WidgetKind.Panel,
# which compute_layout insets by 1px on every side. Any non-"panel" kind
# skips that trim, keeping the expected coordinates exact (same helper the
# sibling layout_grid_columns_spec uses).
fn _grid(id: text, children: [WidgetNode]) -> WidgetNode:
    var node = WidgetNode.new(id, WidgetKind.Card.to_wire())
    node = node.set_layout("grid")
    for child in children:
        node = node.add_child(child)
    node

describe "layout_grid fills its container exactly":

    it "awards the horizontal remainder so the last column reaches the right edge":
        step("Verify: awards the horizontal remainder so the last column reaches the right edge")
        # @req: REQ-LIB-COMMON-001
        val root = _grid("rem_cols", [
            button("rem_c0", "0", "a"),
            button("rem_c1", "1", "a"),
            button("rem_c2", "2", "a"),
        ])
        WidgetNode(id: "rem_cols").set_prop("columns", "3")
        # 100 / 3 == 33 with 1px left over.
        val rects = compute_layout(WidgetNode(id: "rem_cols"), 0, 0, 100, 60)
        match find_rect(rects, "rem_c2"):
            case Some(r2):
                expect(r2.x).to_equal(66)  # oracle: 66 — named expected value from the requirement
                # Right edge must be the container's right edge (100), not 99.
                expect(r2.x + r2.w).to_equal(100)  # oracle: 100 — named expected value from the requirement
            case _: assert_true(false)
        # Earlier columns keep the untruncated base width and stay adjacent.
        match find_rect(rects, "rem_c0"):
            case Some(r0):
                expect(r0.x).to_equal(0)  # oracle: 0 — named expected value from the requirement
                expect(r0.w).to_equal(33)  # oracle: 33 — named expected value from the requirement
            case _: assert_true(false)
        match find_rect(rects, "rem_c1"):
            case Some(r1):
                expect(r1.x).to_equal(33)  # oracle: 33 — named expected value from the requirement
                expect(r1.w).to_equal(33)  # oracle: 33 — named expected value from the requirement
            case _: assert_true(false)

    it "awards the vertical remainder so the last row reaches the bottom edge":
        step("Verify: awards the vertical remainder so the last row reaches the bottom edge")
        val root = _grid("rem_rows", [
            button("rem_r0", "0", "a"),
            button("rem_r1", "1", "a"),
            button("rem_r2", "2", "a"),
            button("rem_r3", "3", "a"),
        ])
        WidgetNode(id: "rem_rows").set_prop("columns", "2")
        # 4 items over 2 columns => 2 rows; 101 / 2 == 50 with 1px left over.
        val rects = compute_layout(WidgetNode(id: "rem_rows"), 0, 0, 80, 101)
        match find_rect(rects, "rem_r0"):
            case Some(r0):
                expect(r0.y).to_equal(0)  # oracle: 0 — named expected value from the requirement
                expect(r0.h).to_equal(50)  # oracle: 50 — named expected value from the requirement
            case _: assert_true(false)
        match find_rect(rects, "rem_r2"):
            case Some(r2):
                expect(r2.y).to_equal(50)  # oracle: 50 — named expected value from the requirement
                # Bottom edge must be the container's bottom edge (101), not 100.
                expect(r2.y + r2.h).to_equal(101)  # oracle: 101 — named expected value from the requirement
            case _: assert_true(false)

    it "keeps a spanned cell inside the container and still reaches the right edge":
        step("Verify: keeps a spanned cell inside the container and still reaches the right edge")
        val root = _grid("rem_span", [
            button("rem_s_wide", "W", "a"),
            button("rem_s_tail", "T", "a"),
        ])
        WidgetNode(id: "rem_span").set_prop("columns", "3")
        WidgetNode(id: "rem_s_wide").set_prop("col_span", "2")
        # 100 / 3 == 33: the 2-col span covers columns 0..1 (0..66), the
        # trailing single cell covers column 2 and absorbs the 1px remainder.
        val rects = compute_layout(WidgetNode(id: "rem_span"), 0, 0, 100, 40)
        match find_rect(rects, "rem_s_wide"):
            case Some(rw):
                expect(rw.x).to_equal(0)  # oracle: 0 — named expected value from the requirement
                expect(rw.w).to_equal(66)  # oracle: 66 — named expected value from the requirement
            case _: assert_true(false)
        match find_rect(rects, "rem_s_tail"):
            case Some(rt):
                expect(rt.x).to_equal(66)  # oracle: 66 — named expected value from the requirement
                expect(rt.x + rt.w).to_equal(100)  # oracle: 100 — named expected value from the requirement
            case _: assert_true(false)

    it "gives a span that runs to the last column the full remaining width":
        step("Verify: gives a span that runs to the last column the full remaining width")
        val root = _grid("rem_span_last", [
            button("rem_sl_a", "A", "a"),
            button("rem_sl_wide", "W", "a"),
        ])
        WidgetNode(id: "rem_span_last").set_prop("columns", "3")
        WidgetNode(id: "rem_sl_wide").set_prop("col_span", "2")
        val rects = compute_layout(WidgetNode(id: "rem_span_last"), 0, 0, 100, 40)
        match find_rect(rects, "rem_sl_wide"):
            case Some(rw):
                expect(rw.x).to_equal(33)  # oracle: 33 — named expected value from the requirement
                # Spans columns 1..2, so its right edge is the container's.
                expect(rw.x + rw.w).to_equal(100)  # oracle: 100 — named expected value from the requirement
            case _: assert_true(false)

    it "never overflows the container when width is smaller than the column count":
        step("Verify: never overflows the container when width is smaller than the column count")
        val root = _grid("rem_tiny", [
            button("rem_t0", "0", "a"),
            button("rem_t1", "1", "a"),
        ])
        WidgetNode(id: "rem_tiny").set_prop("columns", "2")
        # cell_w == 0 for every full track; the last column absorbs all of it.
        val rects = compute_layout(WidgetNode(id: "rem_tiny"), 0, 0, 1, 10)
        match find_rect(rects, "rem_t0"):
            case Some(r0):
                expect(r0.x).to_equal(0)  # oracle: 0 — named expected value from the requirement
                expect(r0.w).to_equal(0)  # oracle: 0 — named expected value from the requirement
            case _: assert_true(false)
        match find_rect(rects, "rem_t1"):
            case Some(r1):
                expect(r1.x).to_equal(0)  # oracle: 0 — named expected value from the requirement
                expect(r1.x + r1.w).to_equal(1)  # oracle: 1 — named expected value from the requirement
            case _: assert_true(false)

    it "never overflows the container when height is smaller than the row count":
        step("Verify: never overflows the container when height is smaller than the row count")
        # Vertical twin of the case above: the horizontal degenerate floor was
        # covered, the vertical one was not. 2 children over 1 column => 2
        # rows, so cell_h == 0 for every full track and the last row absorbs
        # the whole height. compute_layout returns early when inner_h <= 0, so
        # h == 1 is the smallest height that actually reaches layout_grid.
        val root = _grid("rem_tiny_h", [
            button("rem_th0", "0", "a"),
            button("rem_th1", "1", "a"),
        ])
        WidgetNode(id: "rem_tiny_h").set_prop("columns", "1")
        val rects = compute_layout(WidgetNode(id: "rem_tiny_h"), 0, 0, 10, 1)
        match find_rect(rects, "rem_th0"):
            case Some(r0):
                expect(r0.y).to_equal(0)  # oracle: 0 — named expected value from the requirement
                expect(r0.h).to_equal(0)  # oracle: 0 — named expected value from the requirement
            case _: assert_true(false)
        match find_rect(rects, "rem_th1"):
            case Some(r1):
                expect(r1.y).to_equal(0)  # oracle: 0 — named expected value from the requirement
                # Bottom edge is the container's bottom, never past it.
                expect(r1.y + r1.h).to_equal(1)  # oracle: 1 — named expected value from the requirement
            case _: assert_true(false)

    it "leaves the trailing column of a short row unoccupied rather than stretching a child":
        step("Verify: leaves the trailing column of a short row unoccupied rather than stretching a child")
        # cols=4 with two col_span=3 children: each takes columns 0..2 of its
        # own row and column 3 is unoccupied in BOTH rows. The remainder is a
        # property of the TRACK grid, not of child order — awarding it to the
        # last child (the hbox reading) would make these 3-col spans reach
        # x+w and silently misalign them against a full row's columns.
        val root = _grid("rem_short", [
            button("rem_sh_a", "A", "a"),
            button("rem_sh_b", "B", "a"),
        ])
        WidgetNode(id: "rem_short").set_prop("columns", "4")
        WidgetNode(id: "rem_sh_a").set_prop("col_span", "3")
        WidgetNode(id: "rem_sh_b").set_prop("col_span", "3")
        # 10 / 4 == 2, so columns start at 0, 2, 4, 6 and the last ends at 10.
        val rects = compute_layout(WidgetNode(id: "rem_short"), 0, 0, 10, 40)
        match find_rect(rects, "rem_sh_a"):
            case Some(ra):
                expect(ra.x).to_equal(0)  # oracle: 0 — named expected value from the requirement
                # Columns 0..2 => right edge 6, NOT the container's 10.
                expect(ra.x + ra.w).to_equal(6)  # oracle: 6 — named expected value from the requirement
            case _: assert_true(false)
        match find_rect(rects, "rem_sh_b"):
            case Some(rb):
                # Wrapped to row 1, same columns, so identically aligned.
                expect(rb.x).to_equal(0)  # oracle: 0 — named expected value from the requirement
                expect(rb.x + rb.w).to_equal(6)  # oracle: 6 — named expected value from the requirement
            case _: assert_true(false)
