use std.spec
use common.ui.render_surface_widget.{render_surface_is_node}
use common.ui.wm_full_stack_demo.{WmDemo2dState, wm_full_stack_demo_tree}

describe "full stack WM demo widget tree":
    it "contains the required VBox widgets and embedded surfaces":
        val tree = wm_full_stack_demo_tree("Ready", "Play sound", "")
        expect(tree.root_node().layout()).to_equal("vbox")
        expect(tree.find_widget("demo-static-text") != nil).to_equal(true)
        expect(tree.find_widget("demo-image") != nil).to_equal(true)
        expect(tree.find_widget("demo-text-field") != nil).to_equal(true)
        expect(tree.find_widget("demo-button") != nil).to_equal(true)
        expect(tree.find_widget("demo-scroll") != nil).to_equal(true)
        expect(tree.find_widget("demo-status") != nil).to_equal(true)
        if val surface = tree.find_widget("demo-surface-2d"):
            expect(render_surface_is_node(surface)).to_equal(true)
        else:
            expect(false).to_equal(true)
        if val surface = tree.find_widget("demo-surface-web"):
            expect(render_surface_is_node(surface)).to_equal(true)
        else:
            expect(false).to_equal(true)

    it "captures and drags the embedded 2D rectangle":
        var surface = WmDemo2dState.new()
        expect(surface.pointer("down", 30, 30)).to_equal(true)
        expect(surface.pointer("move", 100, 60)).to_equal(true)
        expect(surface.rect_x).to_be_greater_than(24)
        expect(surface.rect_y).to_be_greater_than(24)
        expect(surface.pointer("up", 100, 60)).to_equal(true)
        expect(surface.dragging).to_equal(false)
        val pixels = surface.pixels(240, 90)
        expect(pixels.contains(0xffffa000u32)).to_equal(true)
