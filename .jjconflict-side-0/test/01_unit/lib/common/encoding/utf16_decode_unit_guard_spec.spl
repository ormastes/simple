# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec.{describe, it, assert_equal}
use std.common.encoding.utf16.{utf16_decode_one}


describe "utf16 decode unit guards":
    # @manual scenario evidence
    it "keeps valid unit decode":
        # @req REQ-SSPEC-UNIT
        step("keeps valid unit decode")
        assert_equal(utf16_decode_one([0x41], 0), [0x41, 1])

    it "rejects negative code units":
        # @req REQ-SSPEC-UNIT
        step("rejects negative code units")
        assert_equal(utf16_decode_one([-1], 0), [0xFFFD, 1])

    it "rejects code units above 16 bits":
        # @req REQ-SSPEC-UNIT
        step("rejects code units above 16 bits")
        assert_equal(utf16_decode_one([0x10041], 0), [0xFFFD, 1])

    it "rejects malformed low surrogate units":
        # @req REQ-SSPEC-UNIT
        step("rejects malformed low surrogate units")
        assert_equal(utf16_decode_one([0xD83D, 0x1DE00], 0), [0xFFFD, 1])
