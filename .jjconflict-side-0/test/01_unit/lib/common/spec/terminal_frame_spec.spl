# Unit specs for the ANSI-interpreting TerminalFrame (wave 2, Agent F).
# Contract: doc/04_architecture/ui/testing/typed_ui_interface_arch.md §TUI evidence
use std.spec.{describe, it, expect}
use std.common.spec.terminal_frame.{
    TerminalFrame,
    terminal_frame_new,
    terminal_frame_feed,
    terminal_frame_cell,
    terminal_frame_row_text,
    terminal_frame_text
}

val ESC: text = "\u{001b}"

describe "TerminalFrame plain text and control chars":
    it "prints text at the cursor and advances":
        var f = terminal_frame_new(10, 3)
        f = terminal_frame_feed(f, "hi")
        expect terminal_frame_row_text(f, 0) to_start_with "hi"
        expect f.cursor_col to_equal 2
        expect f.revision to_equal 1

    it "handles CR LF and BS":
        var f = terminal_frame_new(10, 3)
        f = terminal_frame_feed(f, "abc\r\nde")
        expect terminal_frame_row_text(f, 0) to_start_with "abc"
        expect terminal_frame_row_text(f, 1) to_start_with "de"
        f = terminal_frame_feed(f, "\u{0008}X")
        expect terminal_frame_row_text(f, 1) to_start_with "dX"

    it "wraps at the right edge and scrolls at the bottom":
        var f = terminal_frame_new(3, 2)
        f = terminal_frame_feed(f, "abcdef\r\nggg")
        # "abc" scrolled off: rows are "def" then "ggg"
        expect terminal_frame_row_text(f, 0) to_equal "def"
        expect terminal_frame_row_text(f, 1) to_equal "ggg"

describe "TerminalFrame cursor movement":
    it "moves with CUP and prints there":
        var f = terminal_frame_new(10, 4)
        f = terminal_frame_feed(f, ESC + "[3;5HX")
        expect f.cursor_row to_equal 2
        val cell = terminal_frame_cell(f, 2, 4)
        expect cell.grapheme to_equal "X"

    it "moves relatively with CUU CUD CUF CUB and clamps":
        var f = terminal_frame_new(10, 4)
        f = terminal_frame_feed(f, ESC + "[2;2H" + ESC + "[1A" + ESC + "[3C")
        expect f.cursor_row to_equal 0
        expect f.cursor_col to_equal 4
        f = terminal_frame_feed(f, ESC + "[9D" + ESC + "[9B")
        expect f.cursor_col to_equal 0
        expect f.cursor_row to_equal 3

describe "TerminalFrame erase":
    it "EL 2 clears the whole line":
        var f = terminal_frame_new(5, 2)
        f = terminal_frame_feed(f, "abcde" + ESC + "[1;1H" + ESC + "[2K")
        expect terminal_frame_row_text(f, 0) to_equal "     "

    it "ED 0 clears from cursor to end of screen":
        var f = terminal_frame_new(3, 2)
        f = terminal_frame_feed(f, "abc" + "\r\ndef" + ESC + "[1;2H" + ESC + "[0J")
        expect terminal_frame_row_text(f, 0) to_equal "a  "
        expect terminal_frame_row_text(f, 1) to_equal "   "

describe "TerminalFrame SGR":
    it "applies 8-color fg/bg and bold, and resets":
        var f = terminal_frame_new(10, 2)
        f = terminal_frame_feed(f, ESC + "[1;31;42mA" + ESC + "[0mB")
        val a = terminal_frame_cell(f, 0, 0)
        expect a.fg to_equal "1"
        expect a.bg to_equal "2"
        expect a.attrs to_contain "bold"
        val b = terminal_frame_cell(f, 0, 1)
        expect b.fg to_equal ""
        expect b.attrs to_equal ""

    it "applies 256-color and bright colors":
        var f = terminal_frame_new(10, 2)
        f = terminal_frame_feed(f, ESC + "[38;5;196mC" + ESC + "[0m" + ESC + "[92mD")
        expect terminal_frame_cell(f, 0, 0).fg to_equal "256:196"
        expect terminal_frame_cell(f, 0, 1).fg to_equal "bright:2"

    it "applies underline reverse and their resets":
        var f = terminal_frame_new(10, 2)
        f = terminal_frame_feed(f, ESC + "[4;7mE" + ESC + "[24;27mF")
        val e = terminal_frame_cell(f, 0, 0)
        expect e.attrs to_contain "underline"
        expect e.attrs to_contain "reverse"
        expect terminal_frame_cell(f, 0, 1).attrs to_equal ""

describe "TerminalFrame wide chars and alt screen":
    it "lays a CJK char across two cells with a continuation":
        var f = terminal_frame_new(6, 2)
        f = terminal_frame_feed(f, "中x")
        val head = terminal_frame_cell(f, 0, 0)
        expect head.grapheme to_equal "中"
        expect head.width to_equal 2
        val cont = terminal_frame_cell(f, 0, 1)
        expect cont.continuation to_equal true
        expect terminal_frame_cell(f, 0, 2).grapheme to_equal "x"
        expect terminal_frame_row_text(f, 0) to_start_with "中x"

    it "attaches a zero-width combining mark to the preceding cell":
        var f = terminal_frame_new(6, 2)
        # 'e' + U+0301 COMBINING ACUTE ACCENT occupies ONE cell
        f = terminal_frame_feed(f, "e\u{0301}x")
        expect terminal_frame_cell(f, 0, 0).grapheme to_equal "e\u{0301}"
        expect terminal_frame_cell(f, 0, 1).grapheme to_equal "x"
        expect f.cursor_col to_equal 2

    it "enters and leaves the alt screen as a flag":
        var f = terminal_frame_new(4, 2)
        f = terminal_frame_feed(f, "ab" + ESC + "[?1049h")
        expect f.alt_screen to_equal true
        # alt-screen enter clears the grid
        expect terminal_frame_row_text(f, 0) to_equal "    "
        f = terminal_frame_feed(f, ESC + "[?1049l")
        expect f.alt_screen to_equal false

    it "projects all rows via terminal_frame_text":
        var f = terminal_frame_new(3, 2)
        f = terminal_frame_feed(f, "ab\r\ncd")
        val lines = terminal_frame_text(f)
        expect lines.len() to_equal 2
        expect lines[0] to_equal "ab "
