use std.spec
use lib.common.search.provider.{SearchCapabilities, CancelResultV1, ShutdownResultV1}

describe "closed Wave 4 provider capability surface":
    it "advertises implemented operations and rejects phrase capability":
        step("Inspect frozen provider capabilities")
        val caps = SearchCapabilities.bm25_v1()
        expect(caps.lexical).to_equal(true)
        expect(caps.stats).to_equal(true)
        expect(caps.cancel).to_equal(true)
        expect(caps.phrase).to_equal(false)
        expect(CancelResultV1(target_request_id: "r", status: "cancelled").status).to_equal("cancelled")
        expect(ShutdownResultV1(status: "closing").status).to_equal("closing")

