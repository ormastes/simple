# PERF reroute proof (2026-08-17): doctest_runner now imports
# find_simple_binary from its defining module (test_executor_parsing)
# instead of via test_runner_execute. This spec proves the two import
# routes name the same function: both must return the identical binary
# path, and the doctest_runner-visible behavior is unchanged.
use std.test_runner.test_executor_parsing.{find_simple_binary}

describe "doctest_runner find_simple_binary reroute":
    it "resolves a non-empty simple binary path from the defining module":
        val b = find_simple_binary()
        expect(b).to_be_truthy()
        assert_true(b.len() > 0)

    it "returns a stable value across calls (pure lookup)":
        val a = find_simple_binary()
        val b = find_simple_binary()
        expect(a).to_equal(b)
