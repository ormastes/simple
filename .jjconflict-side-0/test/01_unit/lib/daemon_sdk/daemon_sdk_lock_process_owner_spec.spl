use std.spec.{describe, it, expect}
use std.io_runtime.{read_file}

describe "daemon lock process ownership":
    it "uses the canonical process facade instead of a local runtime extern":
        val source = read_file("src/lib/nogc_sync_mut/daemon_sdk/lock.spl")
        expect(source).to_contain("use std.nogc_sync_mut.io.process_ops.{process_is_running}")
        expect(source).to_contain("fn is_pid_alive(pid: i64) -> bool:\n    process_is_running(pid)")
        expect(source.contains("rt_process_exists")).to_equal(false)
