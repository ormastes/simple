# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# design: doc/05_design/os/hal/asm_embedded_hal_and_dual_run.md (B.5) ;
# plan: doc/03_plan/os/hal/asm_to_simple_migration_plan.md (1.8)
#
# Device-effect modes: record-compare (both providers run against the
# VirtualDevice façade, effect logs compared, agreed log replayed ONCE) and
# replay (reference already ran for real; candidate runs against the
# recording, reads answered from the trace, writes compared in order, never
# touches hardware). Temp ledgers only — see the shadow-buffer spec header.

use std.spec
use std.io_runtime.{mkdir_p, remove_file_if_exists}
use std.nogc_sync_mut.rt_hal.dual_runner.*
use std.nogc_sync_mut.rt_hal.virtual_device.*

val TMP_DIR = "build/dual_run/spec_tmp"
val UART: u64 = 0x10000000

fn tmp_ledger(name: text) -> text:
    mkdir_p(TMP_DIR)
    val p = "{TMP_DIR}/{name}.sdn"
    remove_file_if_exists(p)
    p

# 16550 init sequence (riscv startup.spl uart_init): IER=0, LCR=DLAB, DLL, DLM, LCR=8N1
fn ref_uart_init(a: DualArgs, dev: VirtualDevice):
    dev.write_u8(UART + 1, 0x00)
    dev.write_u8(UART + 3, 0x80)
    dev.write_u8(UART + 0, args_i64(a, 0))
    dev.write_u8(UART + 1, 0x00)
    dev.write_u8(UART + 3, 0x03)

fn cand_uart_init(a: DualArgs, dev: VirtualDevice):
    ref_uart_init(a, dev)

# Same writes, DLAB set AFTER the divisor — a real ordering bug.
fn cand_uart_init_reordered(a: DualArgs, dev: VirtualDevice):
    dev.write_u8(UART + 1, 0x00)
    dev.write_u8(UART + 0, args_i64(a, 0))
    dev.write_u8(UART + 3, 0x80)
    dev.write_u8(UART + 1, 0x00)
    dev.write_u8(UART + 3, 0x03)

# putc: poll LSR bit 5 then write THR
fn ref_uart_putc(a: DualArgs, dev: VirtualDevice):
    while (dev.read_u8(UART + 5) & 0x20) == 0:
        pass
    dev.write_u8(UART + 0, args_i64(a, 0))

fn cand_uart_putc_double_poll(a: DualArgs, dev: VirtualDevice):
    dev.read_u8(UART + 5)
    while (dev.read_u8(UART + 5) & 0x20) == 0:
        pass
    dev.write_u8(UART + 0, args_i64(a, 0))

describe "VirtualDevice façade":
    it "records ordered (kind, addr, width, value) and answers reads from the script":
        var dev = VirtualDevice.create([0x00, 0x20])
        dev.write_u32(UART + 8, 0x1FFFF)
        expect(dev.read_u8(UART + 5)).to_equal(0)
        expect(dev.read_u8(UART + 5)).to_equal(0x20)
        expect(dev.read_u8(UART + 5)).to_equal(0x20)
        val log = dev.log()
        expect(log.len()).to_equal(4)
        expect(log[0].kind).to_equal("w")
        expect(log[0].width).to_equal(32)
        expect(log[0].value).to_equal(0x1FFFF)
        expect(log[3].kind).to_equal("r")
        expect(dev.script_exhausted).to_equal(true)
        expect(effect_record_repr(log[0])).to_equal("w32@0x10000008=0x1ffff")

    it "parses a recorded trace and derives its read script":
        val log = effect_log_from_trace_text("# ref trace\nr8 0x10000005 0x00\nr8 0x10000005 0x20\nw8 0x10000000 0x41\n")
        expect(log.len()).to_equal(3)
        expect(log[2].kind).to_equal("w")
        expect(log[2].addr).to_equal(UART)
        expect(log[2].value).to_equal(0x41)
        val script = effect_log_read_script(log)
        expect(script.len()).to_equal(2)
        expect(script[1]).to_equal(0x20)
        expect(effect_log_writes(log).len()).to_equal(1)

    it "poll_collapse folds repeated polls of one address so spin loops compare equal":
        val a = effect_log_from_trace_text("r8 0x10000005 0x00\nr8 0x10000005 0x00\nr8 0x10000005 0x20\nw8 0x10000000 0x41")
        val b = effect_log_from_trace_text("r8 0x10000005 0x20\nw8 0x10000000 0x41")
        expect(effect_logs_compare(a, b, false).agree).to_equal(false)
        expect(effect_logs_compare(a, b, true).agree).to_equal(true)
        val c = effect_logs_compare(a, b, false)
        expect(c.first_diff_index).to_equal(0)

describe "dual-run (5) record-compare mode":
    it "two identical MMIO init sequences agree and the plan is committed exactly once":
        var r = DualRunner.create("uart_init", "record-compare", MismatchPolicy.Trap)
        r.set_ledger(tmp_ledger("rc_ok"))
        val out = dual_run_record_compare(r, dual_args([arg_i64(3)]), ref_uart_init, cand_uart_init, [], false, false)
        expect(out.receipt.agree).to_equal(true)
        expect(out.receipt.committed).to_equal(true)
        expect(out.agreed.len()).to_equal(5)
        expect(out.commit_writes).to_equal(5)
        expect(r.commit_count).to_equal(1)
        expect(out.hardware_applied).to_equal(false)

    it "sequences that differ in ORDER mismatch: nothing replayed, receipt names both logs":
        var r = DualRunner.create("uart_init_reordered", "record-compare", MismatchPolicy.Trap)
        r.set_ledger(tmp_ledger("rc_bad"))
        val out = dual_run_record_compare(r, dual_args([arg_i64(3)]), ref_uart_init, cand_uart_init_reordered, [], false, false)
        expect(out.receipt.agree).to_equal(false)
        expect(out.receipt.committed).to_equal(false)
        expect(out.receipt.trapped).to_equal(true)
        expect(out.commit_writes).to_equal(0)
        expect(r.commit_count).to_equal(0)
        expect(out.receipt.ref_repr).to_contain("w8@0x10000003=0x80 w8@0x10000000=0x3")
        expect(out.receipt.cand_repr).to_contain("w8@0x10000000=0x3 w8@0x10000003=0x80")
        expect(out.receipt.message).to_contain("effect 1")

    it "compares a candidate plan against a RECORDED reference trace (C twin ran elsewhere)":
        var r = DualRunner.create("uart_putc_trace", "record-compare", MismatchPolicy.Trap)
        r.set_ledger(tmp_ledger("rc_trace"))
        val ref_trace = effect_log_from_trace_text("r8 0x10000005 0x00\nr8 0x10000005 0x20\nw8 0x10000000 0x41")
        # candidate sees "ready" at once: r 0x20, r 0x20, w — same writes,
        # different poll count; equal only modulo poll_collapse
        val out = dual_run_record_compare_trace(r, dual_args([arg_i64(0x41)]), ref_trace, cand_uart_putc_double_poll, [0x20], true, false)
        expect(out.receipt.agree).to_equal(true)
        expect(out.commit_writes).to_equal(1)
        val strict = DualRunner.create("uart_putc_trace_strict", "record-compare", MismatchPolicy.Trap)
        strict.set_ledger(tmp_ledger("rc_trace_strict"))
        val out2 = dual_run_record_compare_trace(strict, dual_args([arg_i64(0x41)]), ref_trace, cand_uart_putc_double_poll, [0x20], false, false)
        expect(out2.receipt.agree).to_equal(false)
        expect(out2.receipt.message).to_contain("effect 0")

describe "dual-run (5) replay mode":
    it "answers the candidate's reads from the reference recording and never applies hardware":
        var r = DualRunner.create("uart_putc_replay", "replay", MismatchPolicy.Trap)
        r.set_ledger(tmp_ledger("replay_ok"))
        val recorded = effect_log_from_trace_text("r8 0x10000005 0x00\nr8 0x10000005 0x20\nw8 0x10000000 0x41")
        val out = dual_run_replay(r, dual_args([arg_i64(0x41)]), recorded, ref_uart_putc, true)
        expect(out.receipt.agree).to_equal(true)
        expect(out.receipt.committed).to_equal(true)
        expect(out.receipt.committed_from).to_equal("ref")
        expect(out.hardware_applied).to_equal(false)
        expect(r.commit_count).to_equal(0)

    it "a candidate writing a different byte than the recording mismatches":
        var r = DualRunner.create("uart_putc_replay_bad", "replay", MismatchPolicy.Trap)
        r.set_ledger(tmp_ledger("replay_bad"))
        val recorded = effect_log_from_trace_text("r8 0x10000005 0x20\nw8 0x10000000 0x41")
        val out = dual_run_replay(r, dual_args([arg_i64(0x42)]), recorded, ref_uart_putc, true)
        expect(out.receipt.agree).to_equal(false)
        expect(out.receipt.cand_repr).to_contain("=0x42")
        expect(out.receipt.ref_repr).to_contain("=0x41")
