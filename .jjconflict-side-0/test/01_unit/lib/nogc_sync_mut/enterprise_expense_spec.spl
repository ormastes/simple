"""
# Enterprise Expense Vertical — claims, category caps, tiered approval limits

## Overview

An employee files an expense claim with line items against the durable
enterprise store; a per-category cap bounds it; the claim TOTAL routes it to an
approver tier; a manager/finance approver approves or rejects it with a reason;
finance posts the reimbursement. Every write runs the frozen guarded sequence
(session -> rbac -> validation -> idempotency -> effects in one UoW) and chains
a sha256 audit record. Money is integer cents throughout — never floats.

## Approval tier routing proven here

| claim total (cents) | required approver role |
|---|---|
| <= 50_000    | `manager`   |
| <= 500_000   | `finance`   |
| > 500_000    | `executive` |

The boundary is inclusive on the low side: 50_000 -> `manager`, 50_001 ->
`finance`. A manager approving a 120_000-cent claim is denied `forbidden`
because that total routes to `finance`.

## Guarded sequence proven (reproduce-first for each denial)

| Rung | Denial reason | Scenario |
|------|---------------|----------|
| validation | invalid-record | claim total exceeds the category cap |
| rbac | forbidden | approver's tier is below the total's required tier |
| rbac | forbidden | approving your OWN claim (segregation of duties) |
| transition | invalid-transition | reimbursing a claim that is not approved |
| idempotency | duplicate-key | replay returns recorded result, no second effect |

**Requirements:** N/A
**Plan:** doc/03_plan/agent_tasks/simple_erp.md
**Research:** doc/01_research/local/simple_enterprise_suite_assessment_2026-08-14.md

Lane: .spipe/simple_enterprise_suite (W23-FAN, expense).
"""

use std.spec.*
use std.io_runtime.{file_exists, file_delete, dir_create_all}
use std.nogc_sync_mut.enterprise_store.store.{store_open, store_close}
use std.nogc_sync_mut.enterprise_store.records.{audit_verify_chain, outbox_pending}
use std.nogc_sync_mut.enterprise_sale.foundation.{
    TenantContext, ActorContext, SessionContext, CommandEnvelope,
    reason_allowed
}
use std.nogc_sync_mut.enterprise_expense.expense.{
    expense_setup, expense_cap_set, expense_claim_submit, expense_claim_approve,
    expense_claim_reject, expense_claim_reimburse,
    expense_status, expense_claim_total, expense_cap_cents,
    expense_reject_reason, expense_reimbursed_total,
    expense_required_role, expense_role_meets_tier, expense_lines_sum,
    expense_claim_amount
}

fn db_path(name: text) -> text:
    "build/test-artifacts/expense_" + name + ".db"

fn tenant_a() -> TenantContext:
    TenantContext(tenant_id: "tenant-a", name: "Alpha Trading")

fn emp() -> ActorContext:
    ActorContext(actor_id: "emp-1", role: "employee")

fn mgr() -> ActorContext:
    ActorContext(actor_id: "mgr-1", role: "manager")

fn cfo() -> ActorContext:
    ActorContext(actor_id: "cfo-1", role: "finance")

fn session_for(who: ActorContext, tenant: TenantContext) -> SessionContext:
    SessionContext(token: "tok-" + who.actor_id, actor_id: who.actor_id, tenant_id: tenant.tenant_id, active: true)

fn envelope(key: text) -> CommandEnvelope:
    CommandEnvelope(request_id: "req-" + key, idempotency_key: key, action: "expense", payload: "")

fn fresh_store(name: text):
    dir_create_all("build/test-artifacts")
    if file_exists(db_path(name)):
        file_delete(db_path(name))
    val store = store_open(db_path(name))
    expense_setup(store)
    store

describe "expense vertical — submit a claim with line items":
    it "the claim total is the exact integer sum of its lines and status is submitted":
        step("Open a clean store")
        val store = fresh_store("submit")
        val t = tenant_a()
        val e = emp()
        val s = session_for(e, t)

        step("Employee files claim c-1 with three travel lines")
        val r = expense_claim_submit(store, s, t, e, envelope("s-1"), "c-1", "travel", [1200, 3400, 550])
        expect(r.reason).to_equal("accepted")
        expect(reason_allowed(r.reason)).to_be(true)

        step("Total is 5150 cents and the status folds to submitted")
        expect(expense_claim_total(store, "tenant-a", "c-1")).to_equal(5150)
        expect(expense_status(store, "tenant-a", "c-1")).to_equal("submitted")
        expect(expense_lines_sum([1200, 3400, 550])).to_equal(5150)

        step("The claim amount reads back as Money in the requested currency")
        val m = expense_claim_amount(store, s, t, e, "c-1", "USD")
        expect(m.amount_cents).to_equal(5150)
        expect(m.currency).to_equal("USD")

        step("The audit chain recomputes end to end")
        expect(audit_verify_chain(store, "tenant-a")).to_be(true)
        store_close(store)

describe "expense vertical — per-category cap is enforced before any effect":
    it "reproduce: a claim over the travel cap is denied invalid-record and leaves no claim":
        val store = fresh_store("cap")
        val t = tenant_a()
        val e = emp()
        val f = cfo()

        step("Finance sets a 10_000-cent cap on travel")
        val capset = expense_cap_set(store, session_for(f, t), t, f, envelope("cap-1"), "travel", 10000)
        expect(capset.reason).to_equal("accepted")
        expect(expense_cap_cents(store, "tenant-a", "travel")).to_equal(10000)

        step("A 12_000-cent claim exceeds the cap and is denied")
        val over = expense_claim_submit(store, session_for(e, t), t, e, envelope("s-over"), "c-over", "travel", [12000])
        expect(over.ok).to_be(false)
        expect(over.reason).to_equal("invalid-record")
        expect(reason_allowed(over.reason)).to_be(true)
        expect(expense_status(store, "tenant-a", "c-over")).to_equal("")

        step("A 10_000-cent claim is exactly AT the cap and is accepted")
        val at = expense_claim_submit(store, session_for(e, t), t, e, envelope("s-at"), "c-at", "travel", [10000])
        expect(at.reason).to_equal("accepted")
        expect(expense_status(store, "tenant-a", "c-at")).to_equal("submitted")

        step("An uncapped category is unbounded")
        expect(expense_cap_cents(store, "tenant-a", "software")).to_equal(-1)
        val big = expense_claim_submit(store, session_for(e, t), t, e, envelope("s-big"), "c-big", "software", [900000])
        expect(big.reason).to_equal("accepted")
        store_close(store)

describe "expense vertical — approval tier routing is a pure threshold rule":
    it "the tier boundaries are inclusive on the low side":
        step("50_000 routes to manager; 50_001 routes to finance")
        expect(expense_required_role(50000)).to_equal("manager")
        expect(expense_required_role(50001)).to_equal("finance")
        step("500_000 routes to finance; 500_001 routes to executive")
        expect(expense_required_role(500000)).to_equal("finance")
        expect(expense_required_role(500001)).to_equal("executive")
        step("A role meets a tier only at or above it; admin meets every tier")
        expect(expense_role_meets_tier("manager", 50000)).to_be(true)
        expect(expense_role_meets_tier("manager", 120000)).to_be(false)
        expect(expense_role_meets_tier("finance", 120000)).to_be(true)
        expect(expense_role_meets_tier("finance", 900000)).to_be(false)
        expect(expense_role_meets_tier("admin", 900000)).to_be(true)

describe "expense vertical — a claim above the manager tier needs finance":
    it "reproduce: a manager approving a 120_000-cent claim is denied forbidden":
        val store = fresh_store("tier")
        val t = tenant_a()
        val e = emp()
        val m = mgr()
        val f = cfo()

        step("Employee files a 120_000-cent claim (routes to the finance tier)")
        expense_claim_submit(store, session_for(e, t), t, e, envelope("s-t"), "c-t", "travel", [120000])
        expect(expense_required_role(expense_claim_total(store, "tenant-a", "c-t"))).to_equal("finance")

        step("The manager's approval is denied and the claim stays submitted")
        val denied_r = expense_claim_approve(store, session_for(m, t), t, m, envelope("a-m"), "c-t")
        expect(denied_r.ok).to_be(false)
        expect(denied_r.reason).to_equal("forbidden")
        expect(reason_allowed(denied_r.reason)).to_be(true)
        expect(expense_status(store, "tenant-a", "c-t")).to_equal("submitted")

        step("Finance meets the tier and the approval lands")
        val ok_r = expense_claim_approve(store, session_for(f, t), t, f, envelope("a-f"), "c-t")
        expect(ok_r.reason).to_equal("accepted")
        expect(expense_status(store, "tenant-a", "c-t")).to_equal("approved")
        store_close(store)

describe "expense vertical — segregation of duties blocks approve-own-claim":
    it "reproduce: the submitter cannot approve their own claim even holding the tier role":
        val store = fresh_store("sod")
        val t = tenant_a()
        val m = mgr()
        val f = cfo()

        step("A MANAGER files their own 5_000-cent claim (manager tier suffices)")
        val sub = expense_claim_submit(store, session_for(m, t), t, m, envelope("s-sod"), "c-sod", "travel", [5000])
        expect(sub.reason).to_equal("accepted")
        expect(expense_role_meets_tier("manager", 5000)).to_be(true)

        step("Self-approval is denied forbidden despite the role meeting the tier")
        val self_r = expense_claim_approve(store, session_for(m, t), t, m, envelope("a-sod"), "c-sod")
        expect(self_r.ok).to_be(false)
        expect(self_r.reason).to_equal("forbidden")
        expect(reason_allowed(self_r.reason)).to_be(true)
        expect(expense_status(store, "tenant-a", "c-sod")).to_equal("submitted")

        step("A DIFFERENT approver of the same tier or above succeeds")
        val other = expense_claim_approve(store, session_for(f, t), t, f, envelope("a-sod2"), "c-sod")
        expect(other.reason).to_equal("accepted")
        expect(expense_status(store, "tenant-a", "c-sod")).to_equal("approved")
        store_close(store)

describe "expense vertical — reject with reason records the reason":
    it "a rejected claim carries its reason text and cannot then be reimbursed":
        val store = fresh_store("reject")
        val t = tenant_a()
        val e = emp()
        val m = mgr()
        val f = cfo()

        step("Employee files a 4_000-cent claim; the manager rejects it")
        expense_claim_submit(store, session_for(e, t), t, e, envelope("s-r"), "c-r", "meals", [4000])
        val rej = expense_claim_reject(store, session_for(m, t), t, m, envelope("j-r"), "c-r", "missing receipt")
        expect(rej.reason).to_equal("accepted")
        expect(expense_status(store, "tenant-a", "c-r")).to_equal("rejected")
        expect(expense_reject_reason(store, "tenant-a", "c-r")).to_equal("missing receipt")

        step("An empty reason is refused — a rejection must say why")
        expense_claim_submit(store, session_for(e, t), t, e, envelope("s-r2"), "c-r2", "meals", [4000])
        val bare = expense_claim_reject(store, session_for(m, t), t, m, envelope("j-r2"), "c-r2", "")
        expect(bare.ok).to_be(false)
        expect(bare.reason).to_equal("invalid-record")
        expect(reason_allowed(bare.reason)).to_be(true)

        step("reproduce: reimbursing a REJECTED claim is an invalid transition")
        val reimb = expense_claim_reimburse(store, session_for(f, t), t, f, envelope("p-r"), "c-r")
        expect(reimb.ok).to_be(false)
        expect(reimb.reason).to_equal("invalid-transition")
        expect(reason_allowed(reimb.reason)).to_be(true)
        expect(expense_reimbursed_total(store, "tenant-a", "c-r")).to_equal(0)
        store_close(store)

describe "expense vertical — reimbursement posts only for an approved claim":
    it "submit -> approve -> reimburse posts the exact claim total once":
        val store = fresh_store("reimburse")
        val t = tenant_a()
        val e = emp()
        val m = mgr()
        val f = cfo()

        step("reproduce: reimbursing a still-SUBMITTED claim is an invalid transition")
        expense_claim_submit(store, session_for(e, t), t, e, envelope("s-p"), "c-p", "travel", [2500, 1500])
        val early = expense_claim_reimburse(store, session_for(f, t), t, f, envelope("p-early"), "c-p")
        expect(early.ok).to_be(false)
        expect(early.reason).to_equal("invalid-transition")
        expect(expense_reimbursed_total(store, "tenant-a", "c-p")).to_equal(0)

        step("The manager approves (4_000 cents is inside the manager tier)")
        val app = expense_claim_approve(store, session_for(m, t), t, m, envelope("a-p"), "c-p")
        expect(app.reason).to_equal("accepted")

        step("Finance posts the reimbursement for the exact total")
        val post = expense_claim_reimburse(store, session_for(f, t), t, f, envelope("p-ok"), "c-p")
        expect(post.reason).to_equal("accepted")
        expect(expense_status(store, "tenant-a", "c-p")).to_equal("reimbursed")
        expect(expense_reimbursed_total(store, "tenant-a", "c-p")).to_equal(4000)

        step("A second posting under a NEW key is an invalid transition — pay once")
        val twice = expense_claim_reimburse(store, session_for(f, t), t, f, envelope("p-twice"), "c-p")
        expect(twice.ok).to_be(false)
        expect(twice.reason).to_equal("invalid-transition")
        expect(expense_reimbursed_total(store, "tenant-a", "c-p")).to_equal(4000)

        step("The audit chain recomputes across the whole lifecycle")
        expect(audit_verify_chain(store, "tenant-a")).to_be(true)
        store_close(store)

describe "expense vertical — idempotent replay produces exactly one effect":
    it "replaying expense_claim_submit returns duplicate-key and adds no lines":
        val store = fresh_store("replay")
        val t = tenant_a()
        val e = emp()
        val s = session_for(e, t)

        step("File claim c-i with a 3_000-cent line under key same-key")
        val first = expense_claim_submit(store, s, t, e, envelope("same-key"), "c-i", "travel", [3000])
        expect(first.reason).to_equal("accepted")
        val outbox_after_first = outbox_pending(store, "tenant-a").len()

        step("Replay the SAME key with a DIFFERENT claim id — must not take effect")
        val replay = expense_claim_submit(store, s, t, e, envelope("same-key"), "c-i2", "travel", [9999])
        expect(replay.ok).to_be(true)
        expect(replay.reason).to_equal("duplicate-key")
        expect(reason_allowed(replay.reason)).to_be(true)

        step("No second effect — c-i2 does not exist and the outbox is unchanged")
        expect(expense_status(store, "tenant-a", "c-i2")).to_equal("")
        expect(expense_claim_total(store, "tenant-a", "c-i")).to_equal(3000)
        expect(outbox_pending(store, "tenant-a").len()).to_equal(outbox_after_first)
        store_close(store)
