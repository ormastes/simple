# @req REQ-BUG-MIXED-INDEX-SMTP-EMAIL-VALIDATE
#
# Regression spec for
# doc/08_tracking/bug/mixed_byte_and_codepoint_indexing_defect_class_2026-08-18.md:
# `email_validate` (src/lib/nogc_sync_mut/smtp/send.spl) looped
# `while i < email.length()` (BYTE length) calling `.char_at(i)` (CODEPOINT
# index) purely to count '@' occurrences. On this build the resulting
# out-of-range codepoint access degrades to a silent non-match rather than a
# crash or visible corruption (`bin/simple run` on the pre-fix code gave
# "1 example, 0 failures" for every multibyte probe tried, including one with
# 5 multibyte chars before '@') -- so no FAILING pre-fix repro could be
# captured for this function specifically. The mixed-index SHAPE is still the
# documented defect class and is fixed defensively for consistency with the
# rest of the sweep; this spec locks in correct behavior going forward.
#
# Fix: replaced `.char_at(i)` with `.substring(i, i + 1)`, keeping `i`
# consistently a BYTE index.

use std.spec.{describe, it, assert_equal}
use std.nogc_sync_mut.smtp.send.{email_validate}

describe "email_validate -- multibyte UTF-8 safety":
    it "accepts a local-part with a multibyte char at the start":
        assert_equal(email_validate("\u{e9}user@example.com"), true)

    it "accepts a local-part with a multibyte char at the end":
        assert_equal(email_validate("user\u{e9}@example.com"), true)

    it "accepts a local-part with a multibyte char adjacent to '@'":
        assert_equal(email_validate("caf\u{e9}@example.com"), true)

    it "accepts a purely-multibyte local-part":
        assert_equal(email_validate("\u{e9}\u{e8}\u{ea}@example.com"), true)

    it "accepts a mixed ASCII+multibyte local-part with several multibyte codepoints":
        assert_equal(email_validate("a\u{e9}b\u{e8}c\u{ea}d\u{e9}@example.com"), true)

    it "still rejects a string with no '@'":
        assert_equal(email_validate("caf\u{e9}example.com"), false)

    it "still rejects multiple '@' signs":
        assert_equal(email_validate("a@b@c.com"), false)
