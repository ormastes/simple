extern fn rt_file_read_text(path: text) -> text

describe "Metal SFFI Phase2 closure":
    it "uses the runtime-owned scoped byte-array facade":
        val source = rt_file_read_text("src/lib/nogc_sync_mut/io/metal_sffi.spl") ?? ""
        expect(source).to_contain("extern fn rt_metal_load_library_array(device: i64, bytes: [u8]) -> i64")
        expect(source).to_contain("rt_metal_load_library_array(device, bytes)")
