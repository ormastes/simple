use common.io.window_event.{
    WINDOW_ACTION_PRESS,
    WINDOW_EVENT_KEY,
    WINDOW_MOD_CTRL,
    WINDOW_STATUS_INVALID_HANDLE,
    WINDOW_STATUS_OK,
}
use std.nogc_sync_mut.io.simple_window.{SimpleWindow}

fn main() -> i64:
    var runtime = SimpleWindow.headless(4, 2)
    val window = runtime.create_window("scalar", 8, 6)
    if window <= 0:
        return 1
    if runtime.inject_window_event_scalar(
        WINDOW_EVENT_KEY, window, 1, 10, 65, 30,
        WINDOW_ACTION_PRESS, WINDOW_MOD_CTRL,
        0, 0, 0, 0, 8, 6
    ) != WINDOW_STATUS_OK:
        return 2
    if runtime.poll_event_scalar() != WINDOW_STATUS_OK:
        return 3
    if (runtime.events.polled_kind != WINDOW_EVENT_KEY or
        runtime.events.polled_window_handle != window or
        runtime.events.polled_key != 65 or
        runtime.events.polled_modifiers != WINDOW_MOD_CTRL):
        return 4
    if runtime.destroy_window(window) != WINDOW_STATUS_OK:
        return 5
    if runtime.inject_window_event_scalar(
        WINDOW_EVENT_KEY, window, 2, 20, 66, 48,
        WINDOW_ACTION_PRESS, 0, 0, 0, 0, 0, 8, 6
    ) != WINDOW_STATUS_INVALID_HANDLE:
        return 6
    0
