use std.spec.{describe, it, expect}
use std.nogc_sync_mut.io.window_sffi.{
    winit_compat_event_get_type,
    winit_compat_event_window_close_requested,
}

describe "SDL event to winit compatibility mapping":
    it "keeps event type parity":
        expect(winit_compat_event_get_type(1)).to_equal(3)
        expect(winit_compat_event_get_type(2)).to_equal(10)
        expect(winit_compat_event_get_type(3)).to_equal(10)
        expect(winit_compat_event_get_type(4)).to_equal(21)
        expect(winit_compat_event_get_type(5)).to_equal(20)
        expect(winit_compat_event_get_type(6)).to_equal(20)
        expect(winit_compat_event_get_type(7)).to_equal(22)
        expect(winit_compat_event_get_type(0)).to_equal(0)
        expect(winit_compat_event_get_type(99)).to_equal(0)

    it "keeps close-request status parity":
        expect(winit_compat_event_window_close_requested(1)).to_be(true)
        expect(winit_compat_event_window_close_requested(0)).to_be(false)
        expect(winit_compat_event_window_close_requested(2)).to_be(false)
