"""PostgreSQL connection dispatch is bounded and fail closed."""

use std.spec
use std.database.postgres_mimic.{
    PgWireSslPolicy, PgWireConnectionState, PgWireActionKind,
    pgwire_connection
}

fn be32(value: i64) -> [i64]:
    [value / 16777216, (value / 65536) % 256, (value / 256) % 256, value % 256]

fn startup(user: text) -> [i64]:
    val payload = [0, 3, 0, 0] + "user".bytes() + [0] + user.bytes() + [0, 0]
    be32(payload.len() + 4) + payload

fn query(sql: text) -> [i64]:
    val payload = sql.bytes() + [0]
    [81] + be32(payload.len() + 4) + payload

describe "Postgres mimic connection dispatcher":
    it "requires acknowledged TLS then dispatches startup query and terminate in order":
        var connection = pgwire_connection(PgWireSslPolicy.Required, 1024, 8)
        val ssl = connection.dispatch([0, 0, 0, 8, 4, 210, 22, 47])
        expect(ssl.kind).to_equal(PgWireActionKind.SendSslSupported)
        expect(connection.state).to_equal(PgWireConnectionState.AwaitTlsHandshake)
        expect(connection.tls_established().kind).to_equal(PgWireActionKind.NeedMore)
        val auth = connection.dispatch(startup("simple"))
        expect(auth.kind).to_equal(PgWireActionKind.BeginAuthentication)
        expect(auth.user).to_equal("simple")
        expect(connection.state).to_equal(PgWireConnectionState.AwaitAuthentication)
        expect(connection.authentication_succeeded().kind).to_equal(PgWireActionKind.NeedMore)
        val dispatched = connection.dispatch(query("SELECT 1"))
        expect(dispatched.kind).to_equal(PgWireActionKind.DispatchSimpleQuery)
        expect(dispatched.query).to_equal("SELECT 1")
        expect(connection.dispatch([88, 0, 0, 0, 4]).kind).to_equal(PgWireActionKind.Terminate)
        expect(connection.state).to_equal(PgWireConnectionState.Closed)

    it "rejects plaintext startup and frontend bytes during TLS negotiation":
        var plaintext = pgwire_connection(PgWireSslPolicy.Required)
        expect(plaintext.dispatch(startup("simple")).kind).to_equal(PgWireActionKind.RejectAndClose)
        var negotiating = pgwire_connection(PgWireSslPolicy.Optional)
        expect(negotiating.dispatch([0, 0, 0, 8, 4, 210, 22, 47]).kind).to_equal(PgWireActionKind.SendSslSupported)
        expect(negotiating.dispatch(startup("simple")).kind).to_equal(PgWireActionKind.RejectAndClose)

    it "rejects query bytes until authentication is acknowledged":
        var connection = pgwire_connection(PgWireSslPolicy.Disabled)
        expect(connection.dispatch(startup("simple")).kind).to_equal(PgWireActionKind.BeginAuthentication)
        expect(connection.dispatch(query("SELECT 1")).kind).to_equal(PgWireActionKind.RejectAndClose)
        expect(connection.state).to_equal(PgWireConnectionState.Closed)
