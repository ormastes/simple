# @cover src/os/sosix/qemu_evidence/matrix_contract.spl 80%
use std.spec
use std.common.base_encoding.base64.{base64_encode}
use os.sosix.qemu_evidence.matrix_contract.{
    SOSIX_QEMU_ROW_PASS,
    SOSIX_QEMU_ROW_BLOCKED,
    SosixQemuMatrixRow,
    sosix_qemu_bundle_admission_from_collector_record,
    sosix_qemu_structural_row_from_collector_record,
    sosix_qemu_matrix_hosts,
    sosix_qemu_matrix_guests,
    sosix_qemu_matrix_row_validate,
    sosix_qemu_matrix_evaluate
}
use os.sosix.qemu_evidence.trusted_importer.{sosix_qemu_manifest_row_descriptor_parse}

fn collector_record(host: text, guest: text) -> text:
    "manifest_version=1\n" +
    "host={host}\n" +
    "guest={guest}\n" +
    "status=pass\n" +
    "reason=\n" +
    "resume_command=\n" +
    "owner=host-lane-owner\n" +
    "reviewer=independent-reviewer\n" +
    "evidence_path=rows/{host}/{guest}/evidence.env\n" +
    "evidence_sha256=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\n" +
    "artifact_count=9\n" +
    "source_identity=git:0123456789abcdef0123456789abcdef01234567:tree:89abcdef0123456789abcdef0123456789abcdef:clean\n" +
    "compiler_identity=source-simple:sha256:9999999999999999999999999999999999999999999999999999999999999999\n" +
    "compiler_identity_scope=source-toolchain\n" +
    "compiler_policy_sha256=3c6e3731e238304e28ad182690ee5b3cca67715c8ee40484f6ed15d9e7f624e9\n" +
    "compiler_policy_value=false\n" +
    "compiler_payload_identity=\n" +
    "compiler_image_identity=\n" +
    "compiler_alias_identity=\n" +
    "compiler_manifest_identity=\n" +
    "kernel_identity=sha256:1111111111111111111111111111111111111111111111111111111111111111\n" +
    "image_identity=sha256:2222222222222222222222222222222222222222222222222222222222222222\n" +
    "qemu_identity=sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa:version:qemu-9\n" +
    "qemu_argv=-machine fixture -cpu fixture\n" +
    "accelerator_identity=tcg\n" +
    "transcript_identity=sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\n" +
    "program_identity=sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\n" +
    "firmware_identity=firmware:edk2-aavmf\n" +
    "firmware_mode=uefi-pflash\n" +
    "firmware_path=/usr/share/AAVMF/AAVMF_CODE.fd\n" +
    "firmware_version=version:2026.02\n" +
    "firmware_sha256=sha256:3333333333333333333333333333333333333333333333333333333333333333\n" +
    "firmware_stage_markers=firmware-entry>firmware-handoff>guest-entry\n" +
    "boot_correlation_marker=boot-marker-{host}-{guest}\n" +
    "run_nonce=run-{host}-{guest}-20260813\n" +
    "compiler_in_filesystem=false\n" +
    "compiler_designation_scope=live-policy\n" +
    "compiler_version_evidence_path=\n" +
    "compiler_hello_evidence_path=\n" +
    "compiler_alias_evidence_path=\n" +
    "compiler_manifest_evidence_path=\n" +
    "artifact_1_path=host-admission.env\n" +
    "artifact_1_sha256=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n" +
    "artifact_2_path=qemu.argv\n" +
    "artifact_2_sha256=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\n" +
    "artifact_3_path=qemu.version\n" +
    "artifact_3_sha256=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc\n" +
    "artifact_4_path=transcript.log\n" +
    "artifact_4_sha256=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\n" +
    "artifact_5_path=kernel.elf\n" +
    "artifact_5_sha256=1111111111111111111111111111111111111111111111111111111111111111\n" +
    "artifact_6_path=guest.img\n" +
    "artifact_6_sha256=2222222222222222222222222222222222222222222222222222222222222222\n" +
    "artifact_7_path=program.elf\n" +
    "artifact_7_sha256=eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\n" +
    "artifact_8_path=firmware.bin\n" +
    "artifact_8_sha256=3333333333333333333333333333333333333333333333333333333333333333\n" +
    "artifact_9_path=required-markers.txt\n" +
    "artifact_9_sha256=dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd\n"

fn pass_row(host: text, guest: text) -> SosixQemuMatrixRow:
    sosix_qemu_structural_row_from_collector_record(
        collector_record(host, guest),
        "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef")

fn full_pass_matrix() -> [SosixQemuMatrixRow]:
    var rows: [SosixQemuMatrixRow] = []
    for host in sosix_qemu_matrix_hosts():
        for guest in sosix_qemu_matrix_guests():
            rows.push(pass_row(host, guest))
    rows

fn collector_manifest_for_linux_x86_64() -> text:
    var manifest = "sosix_qemu_matrix_manifest_version=1\n" +
        "sosix_qemu_matrix_row_count=24\n"
    var row: i64 = 0
    for host in sosix_qemu_matrix_hosts():
        for guest in sosix_qemu_matrix_guests():
            row = row + 1
            val prefix = "sosix_qemu_matrix_row_{row}"
            val evidence_path_b64 = base64_encode("rows/" + host + "/" + guest + "/evidence.env")
            val admission_path_b64 = base64_encode("rows/" + host + "/" + guest + "/admission.env")
            val owner_b64 = base64_encode("owner")
            val reviewer_b64 = base64_encode("reviewer")
            manifest = manifest +
                "{prefix}_host={host}\n" +
                "{prefix}_guest={guest}\n" +
                "{prefix}_status=pass\n" +
                "{prefix}_reason_b64=\n" +
                "{prefix}_evidence_path_b64={evidence_path_b64}\n" +
                "{prefix}_admission_record_path_b64={admission_path_b64}\n" +
                "{prefix}_resume_command_b64=\n" +
                "{prefix}_owner_b64={owner_b64}\n" +
                "{prefix}_reviewer_b64={reviewer_b64}\n" +
                "{prefix}_compiler_in_filesystem=false\n" +
                "{prefix}_compiler_identity_scope=source-toolchain\n" +
                "{prefix}_compiler_policy_sha256=3c6e3731e238304e28ad182690ee5b3cca67715c8ee40484f6ed15d9e7f624e9\n" +
                "{prefix}_compiler_policy_value=false\n" +
                "{prefix}_compiler_designation_scope=live-policy\n" +
                "{prefix}_compiler_version_evidence_path_b64=\n" +
                "{prefix}_compiler_hello_evidence_path_b64=\n" +
                "{prefix}_compiler_alias_evidence_path_b64=\n" +
                "{prefix}_compiler_manifest_evidence_path_b64=\n" +
                "{prefix}_source_identity_b64=\n" +
                "{prefix}_compiler_identity_b64=\n" +
                "{prefix}_compiler_payload_identity_b64=\n" +
                "{prefix}_compiler_image_identity_b64=\n" +
                "{prefix}_compiler_alias_identity_b64=\n" +
                "{prefix}_compiler_manifest_identity_b64=\n" +
                "{prefix}_kernel_identity_b64=\n" +
                "{prefix}_image_identity_b64=\n" +
                "{prefix}_qemu_identity_b64=\n" +
                "{prefix}_qemu_argv_b64=\n" +
                "{prefix}_accelerator_identity_b64=\n" +
                "{prefix}_firmware_identity_b64=\n" +
                "{prefix}_firmware_mode_b64=\n" +
                "{prefix}_firmware_path_b64=\n" +
                "{prefix}_firmware_version_b64=\n" +
                "{prefix}_firmware_sha256_b64=\n" +
                "{prefix}_firmware_stage_markers_b64=\n" +
                "{prefix}_boot_correlation_marker_b64=\n" +
                "{prefix}_run_nonce_b64=\n" +
                "{prefix}_transcript_identity_b64=\n" +
                "{prefix}_program_identity_b64=\n" +
                "{prefix}_evidence_sha256=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\n" +
                "{prefix}_admission_record_sha256=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789\n" +
                "{prefix}_artifact_count=9\n"
    manifest + "sosix_qemu_matrix_bundle_id=0123456789abcdef\n"

describe "SOSIX QEMU collector-record matrix contract":
    it "accepts one strict nine-artifact collector record":
        val admission = sosix_qemu_bundle_admission_from_collector_record(collector_record("linux", "x86_64"))
        expect(admission.structurally_valid).to_be(true)
        expect(admission.receipt.artifact_count).to_equal(9)
        expect(admission.reason).to_equal("collector-record-structurally-valid")

    it "accepts exactly four hosts by six guests":
        val result = sosix_qemu_matrix_evaluate(full_pass_matrix())
        expect(result.status).to_equal("pass")
        expect(result.row_count).to_equal(24)
        expect(result.pass_count).to_equal(24)

    it "rejects missing and duplicate matrix cells":
        var missing = full_pass_matrix()
        missing.pop()
        expect(sosix_qemu_matrix_evaluate(missing).reason).to_equal("matrix-row-count")
        var duplicate = full_pass_matrix()
        duplicate[23] = pass_row("linux", "x86_32")
        expect(sosix_qemu_matrix_evaluate(duplicate).reason).to_contain("missing-or-duplicate-cell")

    it "keeps a documented postponed row blocking":
        var rows = full_pass_matrix()
        rows[12] = SosixQemuMatrixRow(
            host: "macos", guest: "x86_32", compiler_in_filesystem: false,
            status: SOSIX_QEMU_ROW_BLOCKED, reason: "native-host-unavailable",
            evidence_path: "rows/macos/x86_32/evidence.env", admission_record: "",
            collector_manifest_evidence_sha256: "",
            resume_command: "resume-macos-x86_32", owner: "host-lane-owner",
            reviewer: "independent-reviewer", compiler_version_evidence_path: "",
            compiler_hello_evidence_path: "")
        expect(sosix_qemu_matrix_evaluate(rows).status).to_equal("blocked")

    it "rejects duplicate empty scalar and boolean fields":
        val base = collector_record("linux", "x86_64")
        expect(sosix_qemu_bundle_admission_from_collector_record(base + "reason=\n").structurally_valid).to_be(false)
        expect(sosix_qemu_bundle_admission_from_collector_record(base + "compiler_in_filesystem=false\n").structurally_valid).to_be(false)

    it "rejects unknown, missing, and extra admission fields":
        val base = collector_record("linux", "x86_64")
        expect(sosix_qemu_bundle_admission_from_collector_record(base + "verified=true\n").structurally_valid).to_be(false)
        val missing = base.replace("reviewer=independent-reviewer\n", "")
        expect(sosix_qemu_bundle_admission_from_collector_record(missing).structurally_valid).to_be(false)

    it "rejects wrong artifact count, order, and identity binding":
        val base = collector_record("linux", "x86_64")
        expect(sosix_qemu_bundle_admission_from_collector_record(base.replace("artifact_count=9", "artifact_count=8")).structurally_valid).to_be(false)
        expect(sosix_qemu_bundle_admission_from_collector_record(base.replace("artifact_1_path=host-admission.env", "artifact_1_path=qemu.argv")).structurally_valid).to_be(false)
        expect(sosix_qemu_bundle_admission_from_collector_record(base.replace("kernel_identity=sha256:1111", "kernel_identity=sha256:9999")).structurally_valid).to_be(false)

    it "binds every passing row to its collector cell and evidence path":
        var wrong_cell = pass_row("linux", "x86_64")
        wrong_cell.admission_record = collector_record("linux", "arm64")
        expect(sosix_qemu_matrix_row_validate(wrong_cell).reason).to_equal("pass-row-receipt-cell-mismatch")
        var wrong_path = pass_row("linux", "x86_64")
        wrong_path.evidence_path = "rows/linux/arm64/evidence.env"
        expect(sosix_qemu_matrix_row_validate(wrong_path).reason).to_equal("pass-row-receipt-path-mismatch")
        var wrong_hash = pass_row("linux", "x86_64")
        wrong_hash.collector_manifest_evidence_sha256 = "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
        expect(sosix_qemu_matrix_row_validate(wrong_hash).reason).to_equal("pass-without-collector-manifest-evidence-hash-binding")

    it "rejects fixture or policy-forged compiler promotion":
        val base = collector_record("linux", "x86_64")
        val fixture = base.replace("compiler_designation_scope=live-policy", "compiler_designation_scope=contract-fixture")
        val forged = base.replace("compiler_policy_value=false", "compiler_policy_value=true")
        expect(sosix_qemu_bundle_admission_from_collector_record(fixture).structurally_valid).to_be(false)
        expect(sosix_qemu_bundle_admission_from_collector_record(forged).structurally_valid).to_be(false)

    it "rejects malformed QEMU, accelerator, source, nonce, and firmware fields":
        val base = collector_record("linux", "x86_64")
        expect(sosix_qemu_bundle_admission_from_collector_record(base.replace("accelerator_identity=tcg", "accelerator_identity=claimed")).structurally_valid).to_be(false)
        expect(sosix_qemu_bundle_admission_from_collector_record(base.replace(":clean", ":dirty")).structurally_valid).to_be(false)
        expect(sosix_qemu_bundle_admission_from_collector_record(base.replace("run_nonce=run-linux-x86_64-20260813", "run_nonce=")).structurally_valid).to_be(false)
        expect(sosix_qemu_bundle_admission_from_collector_record(base.replace("firmware_mode=uefi-pflash", "firmware_mode=placeholder")).structurally_valid).to_be(false)

    it "rejects reordered keys, padded artifact indices, and noncanonical decimals":
        val base = collector_record("linux", "x86_64")
        val reordered = base.replace("host=linux\nguest=x86_64", "guest=x86_64\nhost=linux")
        val padded = base.replace("artifact_1_path=", "artifact_01_path=")
        val decimal = base.replace("artifact_count=9", "artifact_count=09")
        expect(sosix_qemu_bundle_admission_from_collector_record(reordered).structurally_valid).to_be(false)
        expect(sosix_qemu_bundle_admission_from_collector_record(padded).structurally_valid).to_be(false)
        expect(sosix_qemu_bundle_admission_from_collector_record(decimal).structurally_valid).to_be(false)

    it "parses one canonical manifest row without granting byte trust":
        val manifest = collector_manifest_for_linux_x86_64()
        val descriptor = sosix_qemu_manifest_row_descriptor_parse(manifest, "linux", "x86_64")
        expect(descriptor.structurally_valid).to_be(true)
        expect(descriptor.reason).to_equal("manifest-row-structurally-valid")
        val duplicate_hash = manifest + "{descriptor.prefix}_admission_record_sha256=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789\n"
        expect(sosix_qemu_manifest_row_descriptor_parse(duplicate_hash, "linux", "x86_64").structurally_valid).to_be(false)
        val noncanonical_host = manifest.replace("sosix_qemu_matrix_row_2_host=linux", "sosix_qemu_matrix_row_2_host=linux=garbage")
        expect(sosix_qemu_manifest_row_descriptor_parse(noncanonical_host, "linux", "x86_64").structurally_valid).to_be(false)
        val noncanonical_identity = manifest.replace("sosix_qemu_matrix_row_2_source_identity_b64=\n", "sosix_qemu_matrix_row_2_source_identity_b64=@@\n")
        expect(sosix_qemu_manifest_row_descriptor_parse(noncanonical_identity, "linux", "x86_64").structurally_valid).to_be(false)
        val blocked_reason_b64 = base64_encode("native-host-unavailable")
        val blocked_resume_b64 = base64_encode("resume-linux-x86_64")
        val blocked = manifest
            .replace("sosix_qemu_matrix_row_2_status=pass", "sosix_qemu_matrix_row_2_status=blocked")
            .replace("sosix_qemu_matrix_row_2_reason_b64=\n", "sosix_qemu_matrix_row_2_reason_b64={blocked_reason_b64}\n")
            .replace("sosix_qemu_matrix_row_2_resume_command_b64=\n", "sosix_qemu_matrix_row_2_resume_command_b64={blocked_resume_b64}\n")
        val blocked_descriptor = sosix_qemu_manifest_row_descriptor_parse(blocked, "linux", "x86_64")
        expect(blocked_descriptor.structurally_valid).to_be(true)
        expect(blocked_descriptor.status).to_equal("blocked")
        expect(blocked_descriptor.row_reason).to_equal("native-host-unavailable")
