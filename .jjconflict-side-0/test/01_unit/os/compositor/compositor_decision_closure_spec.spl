"""
## Purpose and audience
Purpose: Prove that compositor_engine2d.spl — get_pixel_buffer false arm (no override set).
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-OS-COMPOSITOR-001 — stable requirement identity for this spec.

# @tag: unit, os, compositor, decision-coverage
#
# Targeted decision-arm closure for the C3 unit
# (`doc/09_report/ui/testing/render2d_c2_c3_coverage_measured_2026-08-07.md`).
# Each `it` below closes ONE specific decision row (file:line, arm) left
# uncovered by the existing compositor specs, identified by hand-parsing the
# raw `spl-coverage rollup` decision dump (`id, file, line, column,
# true_count, false_count`) and reading the exact source line at that
# position to confirm it holds a real branch. Never edits an existing spec —
# additive closure only, per task scope.
#
# Genuinely unreachable arms found during this pass are NOT forced here; they
# are documented in the coverage report instead (see the report's "Genuinely
# unreachable arms" section for `_bm_clamp`'s v<0/v>255 branches in
# `_bm_rgba` — both call sites feed it values that are invariant-bounded to
# [0,255] before the call, and `_bm_blend`'s `sa==255` branch — its only two
# call sites guard `_bm_a(color) < 255` before ever calling it).

use std.spec.{describe, it, expect, assert_true, assert_false}
use os.compositor.compositor_engine2d.{Engine2dCompositorBackend}
use os.compositor.engine2d_baremetal_core.{Engine2DBaremetalCore, create_buffer_engine_core}
use os.compositor.frame_pacer.{FramePacer}
use common.ui.draw_ir.{
    draw_ir_batch, draw_ir_batch_with_source, draw_ir_composition,
    draw_ir_embedding_config, draw_ir_rect, draw_ir_image_command,
    draw_ir_source_gui_ast
}

fn _px(core: Engine2DBaremetalCore, x: i32, y: i32) -> u32:
    core.buf[(y * core.width + x).to_u64()]

use std.spec.step

describe "compositor_engine2d.spl — get_pixel_buffer false arm (no override set)":
    it "closes compositor_engine2d.spl:131 false arm — falls through to engine.read_pixels() when no override was ever set":
        step("Verify: closes compositor_engine2d.spl:131 false arm — falls through to engine.read_pixels() when no override was ever set")
        # @req: REQ-OS-COMPOSITOR-001
        var raster = Engine2dCompositorBackend.create_named(4, 4, "software")
        expect(raster.retained_pixel_buffer_override_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        val pixels = raster.get_pixel_buffer()
        expect(pixels.len()).to_equal(16)  # oracle: 16 — named expected value from the requirement
        raster.shutdown()

describe "compositor_engine2d.spl — render_draw_ir_composition wm.content batch true arm":
    it "closes compositor_engine2d.spl:190 true arm — a batch whose source.style_key is wm.content is walked for image commands":
        step("Verify: closes compositor_engine2d.spl:190 true arm — a batch whose source.style_key is wm.content is walked for image commands")
        var raster = Engine2dCompositorBackend.create_named(4, 4, "software")
        val embedding = draw_ir_embedding_config("web", "body", 0, 0, 4, 4, 0, 1000, true)
        val wm_source = draw_ir_source_gui_ast("web-body", "wm.content", "rev-1")
        val batch = draw_ir_batch_with_source("body", "software", embedding, [
            draw_ir_image_command("img0", 0, 0, 4, 4, "test://image", []),
            draw_ir_rect("rect0", 0, 0, 4, 4, 0xFF000000u32)
        ], wm_source)
        val composition = draw_ir_composition("wm-content-test", "hosted-web", "software", [batch])
        val result = raster.render_draw_ir_composition(composition, [])
        # The wm.content-batch image-counting walk (lines 186-197) runs
        # unconditionally before the render call, independent of whether the
        # image resource itself resolves. `selected_backend` (set at line
        # 201, unconditionally, before the success guard) is the only field
        # guaranteed populated regardless of fallback outcome; its exact
        # resolved name diverges from `raster.selected_backend()` between
        # engines (documented engine-divergence, see
        # compositor_engine2d_surface_spec.spl's header), so this asserts
        # only that a real backend name was resolved, not a specific one.
        assert_true(result.selected_backend.len() > 0)
        raster.shutdown()

describe "compositor_engine2d.spl — render_draw_ir_composition readback-not-completed false arm":
    it "closes compositor_engine2d.spl:205 false arm — an empty-commands batch renders zero commands, so the readback-completed guard is never entered":
        step("Verify: closes compositor_engine2d.spl:205 false arm — an empty-commands batch renders zero commands, so the readback-completed guard is never entered")
        var raster = Engine2dCompositorBackend.create_named(4, 4, "software")
        val embedding = draw_ir_embedding_config("web", "body", 0, 0, 4, 4, 0, 1000, true)
        val empty_batch = draw_ir_batch("body", "software", embedding, [])
        val composition = draw_ir_composition("empty-test", "hosted-web", "software", [empty_batch])
        val result = raster.render_draw_ir_composition(composition, [])
        val prov = raster.frame_provenance()
        expect(prov).to_contain("completed=false")
        raster.shutdown()

describe "engine2d_baremetal_core.spl — draw_image with a truncated pixel source":
    it "closes engine2d_baremetal_core.spl:75 true arm — _pixel_at falls back once the run-length scan walks past the supplied pixels array":
        step("Verify: closes engine2d_baremetal_core.spl:75 true arm — _pixel_at falls back once the run-length scan walks past the supplied pixels array")
        var core = create_buffer_engine_core(6, 1)
        core.clear(0xFF000000u32)
        # w=4 requested but only 2 real source pixels supplied; columns 2 and 3
        # must read past pixels.len()==2 and fall back inside _pixel_at.
        core.draw_image(0, 0, 4, 1, [0xFF010101u32, 0xFF020202u32])
        expect(_px(core, 0, 0)).to_equal(0xFF010101u32)
        expect(_px(core, 1, 0)).to_equal(0xFF020202u32)
        expect(_px(core, 2, 0)).to_equal(0xFF020202u32)
        expect(_px(core, 3, 0)).to_equal(0xFF020202u32)
        # untouched beyond the drawn width
        expect(_px(core, 4, 0)).to_equal(0xFF000000u32)

describe "engine2d_baremetal_core.spl — _bm_blend zero-alpha source true arm":
    it "closes engine2d_baremetal_core.spl:114 true arm — a fully-transparent fill color leaves the destination pixel unchanged":
        step("Verify: closes engine2d_baremetal_core.spl:114 true arm — a fully-transparent fill color leaves the destination pixel unchanged")
        var core = create_buffer_engine_core(4, 4)
        core.clear(0xFF224466u32)
        core.draw_rect_filled(1, 1, 2, 2, 0x00FFFFFFu32)
        expect(_px(core, 1, 1)).to_equal(0xFF224466u32)
        expect(_px(core, 2, 2)).to_equal(0xFF224466u32)

describe "frame_pacer.spl — warm_startup_ms called directly before any frame":
    it "closes frame_pacer.spl:134 true arm — frame_count==0 short-circuits to 0 without touching frame_end_ms/frame_start_ms":
        step("Verify: closes frame_pacer.spl:134 true arm — frame_count==0 short-circuits to 0 without touching frame_end_ms/frame_start_ms")
        val pacer = FramePacer.for_60hz()
        expect(pacer.warm_startup_ms()).to_equal(0)  # oracle: 0 — named expected value from the requirement
