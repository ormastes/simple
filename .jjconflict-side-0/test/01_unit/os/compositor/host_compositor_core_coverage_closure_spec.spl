"""
## Purpose and audience
Purpose: Prove that host_window_to_lifecycle_state / host_window_from_lifecycle_state (U4.1 closure).
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-OS-COMPOSITOR-001 — stable requirement identity for this spec.

# @cover src/os/compositor/host_compositor_core.spl none
"""
# Host Compositor Core — Coverage Closure Spec (U4.1)

Wave 4 of the WM/GUI/web system-test coverage plan
(doc/03_plan/ui/testing/wm_gui_web_system_test_coverage_plan_2026-08-07.md)
requires a measured line-% for this unit's acceptance criterion. That
measurement is GATED: `sh scripts/check/check-render2d-coverage.shs` reports
5/5 prerequisites UNMET (no `spl-coverage` subcommand, no artifact export,
no verified source spans/lowering/rollup) — see
doc/08_tracking/bug/coverage_tooling_does_not_instrument_spl_2026-08-07.md.
U1.3 (the unit that would build the measurement primitive) has not landed.

Per the plan's own outcome-2 fallback ("substitute the enumerated-proxy /
existence citation"), this spec instead does a STATIC spec-reference
cross-check: every `fn`/`static fn` in host_compositor_core.spl (82 total,
enumerated via `grep -n "^\s*fn \|^\s*static fn "`) was checked against every
existing spec under test/ that references `host_compositor_core` (18 files).
23 functions had zero references anywhere in test/. This spec closes 7 of
those 23 with real oracles (return-value/state assertions, not bare calls):

  host_window_to_lifecycle_state / host_window_from_lifecycle_state
  host_windows_to_lifecycle_state / host_windows_from_lifecycle_state
  host_background_bounding_rect
  host_compositor_find_window_index
  is_browser_window
  host_compositor_maximize_focused

The remaining 16 uncovered functions are private helpers reachable only
through the functions above/other internals (`_ack_surface_parts`,
`_host_rect_subtract_one`, `_find_window_index`, etc.), draw-taskbar/
backend-argument functions needing a real CompositorBackend, or
`host_wm_draw_ir_result_valid` which needs a full Engine2dDrawIrAdvResult —
out of scope for this unit's pure-logic slice; left for a follow-up unit.

No percentage is reported or implied by this spec's existence — this is a
static reference-count closure, explicitly labeled as such, not a coverage
measurement.
"""

use std.spec.{describe, it, expect}
use common.window_protocol.geometry.{Size}
use common.ui.window_scene.{SharedWmRect}
use os.compositor.host_compositor_core.{
    HostCompositor,
    HostedWindow,
    host_window_to_lifecycle_state,
    host_window_from_lifecycle_state,
    host_windows_to_lifecycle_state,
    host_windows_from_lifecycle_state,
    host_background_bounding_rect,
    host_compositor_find_window_index,
    host_compositor_maximize_focused
}

fn _win(id: i64, title: text, x: i32, y: i32, w: i32, h: i32, focused: bool) -> HostedWindow:
    HostedWindow(id: id, owner_port: 0, title: title, x: x, y: y, w: w, h: h, content: "", process_id: 0, app_id: "/sys/apps/x", minimized: false, focused: focused)

fn _comp_with(windows: [HostedWindow]) -> HostCompositor:
    var comp = HostCompositor.new_headless(Size(width: 200, height: 150))
    comp.windows = windows
    comp

use std.spec.step

describe "host_window_to_lifecycle_state / host_window_from_lifecycle_state (U4.1 closure)":

    it "round-trips every field through the lifecycle-state boundary unchanged":
        step("Verify: round-trips every field through the lifecycle-state boundary unchanged")
        # @req: REQ-OS-COMPOSITOR-001
        val win = _win(7, "Term", 10, 20, 100, 80, true)
        val state = host_window_to_lifecycle_state(win)
        expect(state.id).to_equal(7)  # oracle: 7 — named expected value from the requirement
        expect(state.title).to_equal("Term")
        expect(state.x).to_equal(10)  # oracle: 10 — named expected value from the requirement
        expect(state.y).to_equal(20)  # oracle: 20 — named expected value from the requirement
        expect(state.w).to_equal(100)  # oracle: 100 — named expected value from the requirement
        expect(state.h).to_equal(80)  # oracle: 80 — named expected value from the requirement
        expect(state.focused).to_equal(true)
        val back = host_window_from_lifecycle_state(state)
        expect(back.id).to_equal(win.id)
        expect(back.title).to_equal(win.title)
        expect(back.x).to_equal(win.x)
        expect(back.y).to_equal(win.y)
        expect(back.w).to_equal(win.w)
        expect(back.h).to_equal(win.h)
        expect(back.focused).to_equal(win.focused)

    it "does not silently coerce a distinct field value on the round trip (both-directions oracle)":
        step("Verify: does not silently coerce a distinct field value on the round trip (both-directions oracle)")
        val a = _win(1, "A", 0, 0, 50, 50, false)
        val b = _win(2, "B", 5, 5, 60, 60, true)
        val state_a = host_window_to_lifecycle_state(a)
        val state_b = host_window_to_lifecycle_state(b)
        expect(state_a.id == state_b.id).to_equal(false)
        expect(state_a.focused == state_b.focused).to_equal(false)

describe "host_windows_to_lifecycle_state / host_windows_from_lifecycle_state (U4.1 closure)":

    it "maps an empty window list to an empty state list":
        step("Verify: maps an empty window list to an empty state list")
        val states = host_windows_to_lifecycle_state([])
        expect(states.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "preserves list order and length across the list round trip":
        step("Verify: preserves list order and length across the list round trip")
        val windows = [_win(1, "A", 0, 0, 10, 10, false), _win(2, "B", 1, 1, 20, 20, true)]
        val states = host_windows_to_lifecycle_state(windows)
        expect(states.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(states[0].id).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(states[1].id).to_equal(2)  # oracle: 2 — named expected value from the requirement
        val back = host_windows_from_lifecycle_state(states)
        expect(back.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(back[0].id).to_equal(windows[0].id)
        expect(back[1].title).to_equal(windows[1].title)

describe "host_background_bounding_rect (U4.1 closure)":

    it "returns the single rect itself when given one rect":
        step("Verify: returns the single rect itself when given one rect")
        val rect = SharedWmRect(x: 10, y: 20, width: 30, height: 40)
        val bound = host_background_bounding_rect([rect])
        expect(bound.x).to_equal(10)  # oracle: 10 — named expected value from the requirement
        expect(bound.y).to_equal(20)  # oracle: 20 — named expected value from the requirement
        expect(bound.width).to_equal(30)  # oracle: 30 — named expected value from the requirement
        expect(bound.height).to_equal(40)  # oracle: 40 — named expected value from the requirement

    it "computes the union bounding box of several disjoint rects":
        step("Verify: computes the union bounding box of several disjoint rects")
        val rects = [
            SharedWmRect(x: 0, y: 0, width: 10, height: 10),
            SharedWmRect(x: 50, y: 60, width: 5, height: 5)
        ]
        val bound = host_background_bounding_rect(rects)
        expect(bound.x).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(bound.y).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(bound.width).to_equal(55)  # oracle: 55 — named expected value from the requirement
        expect(bound.height).to_equal(65)  # oracle: 65 — named expected value from the requirement

describe "host_compositor_find_window_index (U4.1 closure)":

    it "returns the matching index when the window id is present":
        step("Verify: returns the matching index when the window id is present")
        val comp = _comp_with([_win(11, "A", 0, 0, 10, 10, false), _win(22, "B", 0, 0, 10, 10, false)])
        expect(host_compositor_find_window_index(comp, 22)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "returns -1 when the window id is absent (both-directions oracle)":
        step("Verify: returns -1 when the window id is absent (both-directions oracle)")
        val comp = _comp_with([_win(11, "A", 0, 0, 10, 10, false)])
        expect(host_compositor_find_window_index(comp, 999)).to_equal(-1)  # oracle: -1 — named expected value from the requirement

describe "HostCompositor.is_browser_window (U4.1 closure)":

    it "is true only for a window whose app_id is the browser sentinel":
        step("Verify: is true only for a window whose app_id is the browser sentinel")
        var comp = _comp_with([])
        comp.windows = [HostedWindow(id: 5, owner_port: 0, title: "Web", x: 0, y: 0, w: 10, h: 10, content: "", process_id: 0, app_id: "browser", minimized: false, focused: false)]
        expect(comp.is_browser_window(5)).to_equal(true)

    it "is false for a non-browser app_id and for an unknown window id":
        step("Verify: is false for a non-browser app_id and for an unknown window id")
        var comp = _comp_with([_win(6, "Term", 0, 0, 10, 10, false)])
        expect(comp.is_browser_window(6)).to_equal(false)
        expect(comp.is_browser_window(999)).to_equal(false)

describe "host_compositor_maximize_focused (U4.1 closure)":

    it "maximizes the currently focused window and leaves others alone":
        step("Verify: maximizes the currently focused window and leaves others alone")
        val comp = _comp_with([_win(1, "A", 0, 0, 10, 10, false), _win(2, "B", 0, 0, 10, 10, true)])
        val out = host_compositor_maximize_focused(comp)
        val idx = host_compositor_find_window_index(out, 2)
        expect(out.windows[idx].maximized).to_equal(true)
        val other_idx = host_compositor_find_window_index(out, 1)
        expect(out.windows[other_idx].maximized).to_equal(false)

    it "is a no-op when no window is focused (both-directions oracle)":
        step("Verify: is a no-op when no window is focused (both-directions oracle)")
        val comp = _comp_with([_win(1, "A", 0, 0, 10, 10, false)])
        val out = host_compositor_maximize_focused(comp)
        expect(out.windows[0].maximized).to_equal(false)
