# @cover src/os/compositor/compositor_engine2d.spl 5%

use std.spec.{describe, it, expect}
use common.ui.draw_ir.{
    draw_ir_batch, draw_ir_composition, draw_ir_embedding_config, draw_ir_rect
}
use os.compositor.compositor_engine2d.Engine2dCompositorBackend
use common.ui.render_opt.damage_plan.{DAMAGE_PLAN_LOCAL, DAMAGE_PLAN_NONE}

fn fixture(color: u32):
    val embedding = draw_ir_embedding_config(
        "web", "body", 0, 0, 4, 4, 0, 1000, true)
    draw_ir_composition("receipt", "hosted-web", "software", [
        draw_ir_batch("body", "software", embedding, [
            draw_ir_rect("fill", 0, 0, 4, 4, color)
        ])
    ])

describe "Engine2D retained frame-switch receipt":
    it "reuses an exact surface without raster submission readback or pixels":
        val composition = fixture(0xFF2563EBu32)
        var backend = Engine2dCompositorBackend.create_named(4, 4, "software")
        val seeded = backend.render_draw_ir_composition_resources_revision(
            composition, [], 7, 3)
        val receipt = backend.try_reuse_draw_ir_composition_revision(
            composition, [], 7, 3)
        expect(receipt.reused).to_equal(true)
        expect(receipt.pixel_count).to_equal(16)
        expect(receipt.checksum).to_equal(seeded.readback_checksum)
        expect(receipt.raster_count).to_equal(0)
        expect(receipt.submission_count).to_equal(0)
        expect(receipt.readback_count).to_equal(0)
        expect(backend.revision_render_count).to_equal(1)
        expect(backend.revision_reuse_count).to_equal(1)
        backend.shutdown()

    it "misses without changing counters when the revision is different":
        val composition = fixture(0xFF2563EBu32)
        var backend = Engine2dCompositorBackend.create_named(4, 4, "software")
        backend.render_draw_ir_composition_resources_revision(
            composition, [], 7, 3)
        val receipt = backend.try_reuse_draw_ir_composition_revision(
            composition, [], 7, 4)
        expect(receipt.reused).to_equal(false)
        expect(receipt.pixel_count).to_equal(0)
        expect(backend.revision_render_count).to_equal(1)
        expect(backend.revision_reuse_count).to_equal(0)
        backend.shutdown()

    it "misses when command content changes under the same tuple":
        val first = fixture(0xFF2563EBu32)
        val changed = fixture(0xFFDC2626u32)
        var backend = Engine2dCompositorBackend.create_named(4, 4, "software")
        backend.render_draw_ir_composition_resources_revision(first, [], 7, 3)
        val receipt = backend.try_reuse_draw_ir_composition_revision(
            changed, [], 7, 3)
        expect(receipt.reused).to_equal(false)
        expect(backend.revision_reuse_count).to_equal(0)
        backend.shutdown()

    it "replaces prior LOCAL damage with NONE on an exact Web cache hit":
        val embedding = draw_ir_embedding_config(
            "web", "body", 0, 0, 64, 64, 0, 1000, true)
        val first = draw_ir_composition("web-cache", "hosted-web", "software", [
            draw_ir_batch("body", "software", embedding, [
                draw_ir_rect("small", 1, 1, 4, 4, 0xFF2563EBu32)
            ])
        ])
        val changed = draw_ir_composition("web-cache", "hosted-web", "software", [
            draw_ir_batch("body", "software", embedding, [
                draw_ir_rect("small", 1, 1, 4, 4, 0xFFDC2626u32)
            ])
        ])
        var backend = Engine2dCompositorBackend.create_named(64, 64, "software")
        backend.render_web_draw_ir_composition_resources_revision(
            first, [], 7, 3)
        backend.render_web_draw_ir_composition_resources_revision(
            changed, [], 7, 4)
        expect(backend.web_effective_damage_mode).to_equal(DAMAGE_PLAN_LOCAL)
        expect(backend.damage_rects_to_i64().len()).to_be_greater_than(0)

        backend.render_web_draw_ir_composition_resources_revision(
            changed, [], 7, 4)
        expect(backend.web_effective_damage_mode).to_equal(DAMAGE_PLAN_NONE)
        expect(backend.web_effective_damage_reason).to_equal(
            "web-revision-cache-hit")
        expect(backend.damage_rects_to_i64()).to_equal([])
        backend.shutdown()

    it "labels Vulkan host-cache reuse as a device copy not a device present":
        val composition = fixture(0xFF16A34Au32)
        var backend = Engine2dCompositorBackend.create_named(4, 4, "vulkan")
        if backend.engine.backend_name() == "vulkan":
            backend.render_draw_ir_composition_resources_revision(
                composition, [], 11, 5)
            val receipt = backend.try_reuse_draw_ir_composition_revision(
                composition, [], 11, 5)
            expect(receipt.reused).to_equal(true)
            expect(receipt.readback_source).to_equal(
                "host_cache_after_device_copy")
            expect(receipt.present_mode).to_equal("host_cache")
            expect(receipt.device_present).to_equal(false)
            expect(receipt.backend_handle).to_be_greater_than(0)
            expect(receipt.device_identity).to_be_greater_than(0)
            expect(receipt.submission_count).to_equal(0)
            expect(receipt.readback_count).to_equal(0)
        else:
            expect(backend.engine.backend_name() == "").to_equal(false)
        backend.shutdown()
