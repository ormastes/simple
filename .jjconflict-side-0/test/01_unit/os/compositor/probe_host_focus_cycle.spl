use common.window_protocol.compositor_methods.{COMP_MINIMIZE}
use common.window_protocol.geometry.{Size}
use os.compositor.host_compositor_entry.{
    HostCompositor,
    host_compositor_cycle_focus,
    host_compositor_focused_window_id,
}
use os.userlib.ipc_protocol.{COMP_CREATE_WINDOW}

fn main() -> i64:
    var compositor = HostCompositor.new_headless(Size.wh(320, 240))
    compositor.apply_bridge_request(
        1, 10, COMP_CREATE_WINDOW.to_i64(), 0,
        "One", 10, 50, 100, 100, "", 1, "/sys/apps/one"
    )
    val first_id = compositor.windows[0].id
    compositor.apply_bridge_request(
        2, 20, COMP_CREATE_WINDOW.to_i64(), 0,
        "Two", 30, 60, 100, 100, "", 2, "/sys/apps/two"
    )
    val second_id = compositor.windows[1].id
    compositor.apply_bridge_request(
        3, 30, COMP_CREATE_WINDOW.to_i64(), 0,
        "Three", 50, 70, 100, 100, "", 3, "/sys/apps/three"
    )
    val third_id = compositor.windows[2].id
    compositor.apply_bridge_request(
        4, 20, COMP_MINIMIZE.to_i64(), second_id,
        "", 0, 0, 0, 0, "", 0, ""
    )
    compositor = host_compositor_cycle_focus(compositor)
    if compositor.windows[compositor.windows.len() - 1].id != first_id:
        return 1
    compositor = host_compositor_cycle_focus(compositor)
    if compositor.windows[compositor.windows.len() - 1].id != third_id:
        return 2
    var i = 0
    while i < compositor.windows.len():
        if (compositor.windows[i].id == second_id and
            not compositor.windows[i].minimized):
            return 3
        i = i + 1
    compositor.apply_bridge_request(
        5, 30, COMP_MINIMIZE.to_i64(), third_id,
        "", 0, 0, 0, 0, "", 0, ""
    )
    compositor.apply_bridge_request(
        6, 10, COMP_MINIMIZE.to_i64(), first_id,
        "", 0, 0, 0, 0, "", 0, ""
    )
    compositor = host_compositor_cycle_focus(compositor)
    if host_compositor_focused_window_id(compositor) != 0:
        return 4
    0
