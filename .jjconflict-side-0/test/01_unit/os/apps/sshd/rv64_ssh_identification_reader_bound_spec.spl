"""
Static source-contract evidence for the RV64 boot SSH identification reader.
It locks the raw-owner boundary; it does not exercise a RISC-V runtime.
"""
# @manual: primary

use std.spec
use app.io.mod.{file_read_text}

val RUNTIME_PATH = "src/os/kernel/arch/riscv64/boot/freestanding_runtime.c"

describe "RV64 SSH identification raw-reader bound":
    it "caps the raw wire line before returned-array allocation or copy":
        step("Inspect the canonical RV64 C owner")
        val source = file_read_text(RUNTIME_PATH)
        expect(source).to_contain("#define RT_BOOT_TCP_SSH_IDENT_MAX_WIRE_BYTES 255ULL")
        expect(source).to_contain("line_end < RT_BOOT_TCP_SSH_IDENT_MAX_WIRE_BYTES")
        expect(source).to_contain("if (line_end == RT_BOOT_TCP_SSH_IDENT_MAX_WIRE_BYTES)")
        expect(source).to_contain("rt_byte_array_new_len(rt_int(1))")
        expect(source).to_contain("data[0] = rt_int(0)")

    it "keeps successful LF and CRLF handling plus close-driven boot RX reset":
        step("Inspect compatible success and cleanup paths")
        val source = file_read_text(RUNTIME_PATH)
        expect(source).to_contain("if (g_boot_tcp_rx_buf[line_end] == '\\n')")
        expect(source).to_contain("if (text_len > 0ULL && g_boot_tcp_rx_buf[text_len - 1ULL] == '\\r')")
        expect(source).to_contain("g_boot_tcp_rx_len = 0;\n        g_boot_tcp_rx_off = 0;")
