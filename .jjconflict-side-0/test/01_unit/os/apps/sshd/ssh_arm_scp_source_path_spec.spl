# @cover src/os/apps/sshd/ssh_session_channel.spl
"""
# ARM SCP source path admission

Calls the production raw SSH exec-payload parser used before the ARM typed VFS
read.  This is protocol-boundary coverage and does not claim a live SSH guest.
"""

use std.spec.*
use os.apps.sshd.ssh_session_channel.{
    ssh_scp_source_path_from_exec_payload_v1,
}

fn _scp_exec_payload(command: [u8]) -> [u8]:
    val n = command.len().to_u32()
    var payload: [u8] = [
        ((n >> 24) & 0xFFu32).to_u8(),
        ((n >> 16) & 0xFFu32).to_u8(),
        ((n >> 8) & 0xFFu32).to_u8(),
        (n & 0xFFu32).to_u8(),
    ]
    for byte in command:
        payload.push(byte)
    payload

describe "ARM SCP source path admission":
    it "should extract one absolute mounted path without rewriting it":
        step("Parse the exact scp source command carried by SSH exec")
        val payload = _scp_exec_payload([
            0x73u8, 0x63u8, 0x70u8, 0x20u8, 0x2Du8, 0x66u8, 0x20u8,
            0x2Fu8, 0x73u8, 0x79u8, 0x73u8, 0x2Fu8, 0x65u8, 0x6Du8,
            0x70u8, 0x74u8, 0x79u8, 0x2Eu8, 0x62u8, 0x69u8, 0x6Eu8,
        ])
        expect(ssh_scp_source_path_from_exec_payload_v1(payload, 0u64)).to_equal([
            0x2Fu8, 0x73u8, 0x79u8, 0x73u8, 0x2Fu8, 0x65u8, 0x6Du8,
            0x70u8, 0x74u8, 0x79u8, 0x2Eu8, 0x62u8, 0x69u8, 0x6Eu8,
        ])

    it "should reject an empty SCP source operand":
        step("Parse scp source mode with no path operand")
        val payload = _scp_exec_payload([
            0x73u8, 0x63u8, 0x70u8, 0x20u8, 0x2Du8, 0x66u8, 0x20u8,
        ])
        expect(ssh_scp_source_path_from_exec_payload_v1(payload, 0u64)).to_equal([])

    it "should reject relative traversal and duplicate separators":
        step("Parse paths that could escape or ambiguously address a mount")
        val traversal = _scp_exec_payload([
            0x73u8, 0x63u8, 0x70u8, 0x20u8, 0x2Du8, 0x66u8, 0x20u8,
            0x2Fu8, 0x73u8, 0x79u8, 0x73u8, 0x2Fu8, 0x2Eu8, 0x2Eu8,
            0x2Fu8, 0x73u8, 0x65u8, 0x63u8, 0x72u8, 0x65u8, 0x74u8,
        ])
        val duplicate = _scp_exec_payload([
            0x73u8, 0x63u8, 0x70u8, 0x20u8, 0x2Du8, 0x66u8, 0x20u8,
            0x2Fu8, 0x73u8, 0x79u8, 0x73u8, 0x2Fu8, 0x2Fu8, 0x61u8,
        ])
        expect(ssh_scp_source_path_from_exec_payload_v1(traversal, 0u64)).to_equal([])
        expect(ssh_scp_source_path_from_exec_payload_v1(duplicate, 0u64)).to_equal([])

    it "should reject extra operands and control bytes":
        step("Keep whitespace and record injection away from filesystem access")
        val extra = _scp_exec_payload([
            0x73u8, 0x63u8, 0x70u8, 0x20u8, 0x2Du8, 0x66u8, 0x20u8,
            0x2Fu8, 0x61u8, 0x20u8, 0x2Fu8, 0x62u8,
        ])
        val newline = _scp_exec_payload([
            0x73u8, 0x63u8, 0x70u8, 0x20u8, 0x2Du8, 0x66u8, 0x20u8,
            0x2Fu8, 0x61u8, 0x0Au8, 0x43u8, 0x30u8, 0x36u8, 0x34u8, 0x34u8,
        ])
        expect(ssh_scp_source_path_from_exec_payload_v1(extra, 0u64)).to_equal([])
        expect(ssh_scp_source_path_from_exec_payload_v1(newline, 0u64)).to_equal([])

    it "should reject payload length mismatch before path parsing":
        step("Present a truncated SSH string envelope")
        val payload: [u8] = [
            0u8, 0u8, 0u8, 9u8,
            0x73u8, 0x63u8, 0x70u8, 0x20u8, 0x2Du8, 0x66u8, 0x20u8,
            0x2Fu8,
        ]
        expect(ssh_scp_source_path_from_exec_payload_v1(payload, 0u64)).to_equal([])
