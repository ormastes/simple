# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# @cover src/os/apps/dbd/dbd_command_ingress.spl 90%
"""
# DBD authenticated command byte ingress

Exercises the fixed-capacity post-authentication RESP owner without inspecting
its source.  Complete frames are returned in order, incomplete bytes remain
mutable, repeated AUTH is classified before text conversion, and one-byte
fragmentation has bounded byte work.
"""

use std.spec.step

use std.spec
use std.spec.step
use os.apps.dbd.dbd_command_ingress.{
    DbdAuthenticatedRespIngressV1, DbdCommandIngressStatusV1,
    DBD_MAX_KEY_BYTES_V1, DBD_MAX_VALUE_BYTES_V1,
    DBD_MAX_QUERY_BYTES_V1
}
use os.apps.dbd.dbd_protocol.DBD_MAX_SESSION_BYTES


fn _append(target: [u8], suffix: [u8]) -> [u8]:
    var out = target
    for byte in suffix:
        out.push(byte)
    out

fn _large_set() -> [u8]:
    var out = "*3\r\n$3\r\nSET\r\n$3\r\nkey\r\n$1024\r\n".bytes()
    var index: i64 = 0
    while index < 1024:
        out.push(120u8)
        index = index + 1
    out.push(13u8)
    out.push(10u8)
    out

fn _inline_frame(byte_count: i64, fill: u8) -> [u8]:
    var out: [u8] = []
    var index: i64 = 0
    while index < byte_count - 2:
        out.push(fill)
        index = index + 1
    out.push(13u8)
    out.push(10u8)
    out

fn _resp_argument(prefix: text, byte_count: i64, fill: u8) -> [u8]:
    var out = prefix.bytes()
    var index: i64 = 0
    while index < byte_count:
        out.push(fill)
        index = index + 1
    out.push(13u8)
    out.push(10u8)
    out

describe "DBD authenticated command byte framing":
    # @manual scenario evidence
    it "frames a command fragmented one byte at a time with linear work":
        # @req REQ-SSPEC-UNIT
        step("frames a command fragmented one byte at a time with linear work")
        val command = _large_set()
        val owner = DbdAuthenticatedRespIngressV1.new()
        var index: i64 = 0
        while index < command.len().to_i64():
            expect(owner.ingest(command.slice(
                index.to_u64(), (index + 1).to_u64()
            ))).to_equal(DbdCommandIngressStatusV1.Accepted)
            index = index + 1
        match owner.take_next():
            case nil:
                fail("complete one-byte-fragmented command was not published")
            case Some(frame):
                expect(frame.bytes).to_equal(command)
                expect(frame.auth_command).to_be(false)
                expect(frame.zeroize_owned_bytes()).to_equal(
                    command.len().to_i64())
                expect(frame.retained_nonzero_byte_count()).to_equal(0i64)
        expect(owner.byte_work()).to_be_less_than(
            command.len().to_i64() * 3 + 1)
        expect(owner.remaining_byte_count()).to_equal(0i64)
        expect(owner.last_take_zeroized_owned_bytes()).to_be(true)

    it "publishes coalesced commands in wire order":
        # @req REQ-SSPEC-UNIT
        step("publishes coalesced commands in wire order")
        val ping = "*1\r\n$4\r\nPING\r\n".bytes()
        val get = "*2\r\n$3\r\nGET\r\n$3\r\nkey\r\n".bytes()
        val owner = DbdAuthenticatedRespIngressV1.new()
        expect(owner.ingest(_append(ping, get))).to_equal(
            DbdCommandIngressStatusV1.Accepted)
        match owner.take_next():
            case nil: fail("first coalesced command missing")
            case Some(frame): expect(frame.bytes).to_equal(ping)
        match owner.take_next():
            case nil: fail("second coalesced command missing")
            case Some(frame): expect(frame.bytes).to_equal(get)
        expect(owner.take_next()).to_be_nil()

    it "preserves and wipes frames that cross the retained ring boundary":
        # Consume a near-capacity frame so the next frame's write, scan, and
        # extraction paths all wrap once without reallocating ring storage.
        val first = _inline_frame(DBD_MAX_SESSION_BYTES - 4, 65u8)
        val wrapped = "PING\r\n".bytes()
        val owner = DbdAuthenticatedRespIngressV1.new()
        expect(owner.ingest(first)).to_equal(
            DbdCommandIngressStatusV1.Accepted)
        match owner.take_next():
            case nil: fail("near-capacity frame missing")
            case Some(frame):
                expect(frame.bytes).to_equal(first)
                expect(frame.zeroize_owned_bytes()).to_equal(first.len().to_i64())
        expect(owner.ingest(wrapped)).to_equal(
            DbdCommandIngressStatusV1.Accepted)
        match owner.take_next():
            case nil: fail("wrapped frame missing")
            case Some(frame):
                expect(frame.bytes).to_equal(wrapped)
                expect(frame.zeroize_owned_bytes()).to_equal(
                    wrapped.len().to_i64())
                expect(frame.retained_nonzero_byte_count()).to_equal(0i64)
        expect(owner.remaining_byte_count()).to_equal(0i64)
        expect(owner.last_take_zeroized_owned_bytes()).to_be(true)

    it "retains an incomplete frame without publishing it":
        # @req REQ-SSPEC-UNIT
        step("retains an incomplete frame without publishing it")
        val owner = DbdAuthenticatedRespIngressV1.new()
        val partial = "*2\r\n$3\r\nGET\r\n$5\r\npar".bytes()
        expect(owner.ingest(partial)).to_equal(
            DbdCommandIngressStatusV1.Accepted)
        expect(owner.take_next()).to_be_nil()
        expect(owner.remaining_byte_count()).to_equal(partial.len().to_i64())

    it "rejects malformed framing and a buffer larger than its fixed bound":
        # @req REQ-SSPEC-UNIT
        step("rejects malformed framing and a buffer larger than its fixed bound")
        val malformed_owner = DbdAuthenticatedRespIngressV1.new()
        expect(malformed_owner.ingest("*1\rX".bytes())).to_equal(
            DbdCommandIngressStatusV1.Malformed)
        expect(malformed_owner.take_next()).to_be_nil()
        expect(malformed_owner.last_failure_zeroized_owned_bytes()).to_be(true)
        expect(malformed_owner.remaining_byte_count()).to_equal(0i64)

        var oversized: [u8] = []
        var index: i64 = 0
        while index <= DBD_MAX_SESSION_BYTES:
            oversized.push(65u8)
            index = index + 1
        val bounded_owner = DbdAuthenticatedRespIngressV1.new()
        expect(bounded_owner.ingest(oversized)).to_equal(
            DbdCommandIngressStatusV1.Overflow)
        expect(bounded_owner.last_failure_zeroized_owned_bytes()).to_be(true)
        expect(bounded_owner.remaining_byte_count()).to_equal(0i64)

    it "classifies unknown commands for non-dispatch error handling":
        val owner = DbdAuthenticatedRespIngressV1.new()
        expect(owner.ingest(
            _append("*1\r\n$7\r\nUNKNOWN\r\n".bytes(), "PING\r\n".bytes())
        )).to_equal(DbdCommandIngressStatusV1.Accepted)
        match owner.take_next():
            case nil: fail("unknown command metadata was not published")
            case Some(frame):
                expect(frame.known_command).to_be(false)
                expect(frame.command_name).to_equal("UNKNOWN".bytes())
                expect(frame.bytes.len()).to_equal(0u64)
        match owner.take_next():
            case nil: fail("known command after unknown was lost")
            case Some(frame):
                expect(frame.known_command).to_be(true)
                expect(frame.command_name).to_equal("PING".bytes())
        expect(owner.remaining_byte_count()).to_equal(0i64)

    it "bounds inline argument fanout before immutable token allocation":
        val owner = DbdAuthenticatedRespIngressV1.new()
        expect(owner.ingest(
            "DEL a b c d e f g h i j k l m n o p\r\n".bytes()
        )).to_equal(DbdCommandIngressStatusV1.Malformed)
        expect(owner.take_next()).to_be_nil()
        expect(owner.last_failure_zeroized_owned_bytes()).to_be(true)

    it "rejects oversized keys and values in the mutable byte owner":
        val oversized_key = _resp_argument(
            "*2\r\n$3\r\nGET\r\n${DBD_MAX_KEY_BYTES_V1 + 1}\r\n",
            DBD_MAX_KEY_BYTES_V1 + 1, 107u8)
        val key_owner = DbdAuthenticatedRespIngressV1.new()
        expect(key_owner.ingest(oversized_key)).to_equal(
            DbdCommandIngressStatusV1.Malformed)
        expect(key_owner.take_next()).to_be_nil()

        val oversized_value = _resp_argument(
            "*3\r\n$3\r\nSET\r\n$1\r\nk\r\n${DBD_MAX_VALUE_BYTES_V1 + 1}\r\n",
            DBD_MAX_VALUE_BYTES_V1 + 1, 118u8)
        val value_owner = DbdAuthenticatedRespIngressV1.new()
        expect(value_owner.ingest(oversized_value)).to_equal(
            DbdCommandIngressStatusV1.Malformed)
        expect(value_owner.take_next()).to_be_nil()

    it "admits exact key and value limits without an off-by-one rejection":
        var command = "*3\r\n$3\r\nSET\r\n${DBD_MAX_KEY_BYTES_V1}\r\n".bytes()
        var index: i64 = 0
        while index < DBD_MAX_KEY_BYTES_V1:
            command.push(107u8)
            index = index + 1
        for byte in "\r\n${DBD_MAX_VALUE_BYTES_V1}\r\n".bytes():
            command.push(byte)
        index = 0
        while index < DBD_MAX_VALUE_BYTES_V1:
            command.push(118u8)
            index = index + 1
        command.push(13u8)
        command.push(10u8)
        val owner = DbdAuthenticatedRespIngressV1.new()
        expect(owner.ingest(command)).to_equal(
            DbdCommandIngressStatusV1.Accepted)
        match owner.take_next():
            case nil: fail("exact-limit command was not published")
            case Some(frame):
                expect(frame.bytes.len()).to_equal(command.len())

    it "rejects an inline query above the exact per-request bound":
        # Leading spaces are accepted by the canonical inline grammar and do
        # not consume an argument limit, so this isolates the frame bound.
        var query: [u8] = []
        var index: i64 = 0
        while index < DBD_MAX_QUERY_BYTES_V1 - 4:
            query.push(32u8)
            index = index + 1
        for byte in "PING\r\n".bytes():
            query.push(byte)
        val owner = DbdAuthenticatedRespIngressV1.new()
        expect(owner.ingest(query)).to_equal(
            DbdCommandIngressStatusV1.Malformed)
        expect(owner.take_next()).to_be_nil()

    it "classifies RESP and inline AUTH before immutable parsing":
        # @req REQ-SSPEC-UNIT
        step("classifies RESP and inline AUTH before immutable parsing")
        val resp_auth = "*2\r\n$4\r\nAUTH\r\n$1\r\nx\r\n".bytes()
        val inline_auth = "auth x\r\n".bytes()
        val owner = DbdAuthenticatedRespIngressV1.new()
        expect(owner.ingest(_append(resp_auth, inline_auth))).to_equal(
            DbdCommandIngressStatusV1.Accepted)
        match owner.take_next():
            case nil: fail("RESP AUTH frame missing")
            case Some(frame): expect(frame.auth_command).to_be(true)
        match owner.take_next():
            case nil: fail("inline AUTH frame missing")
            case Some(frame): expect(frame.auth_command).to_be(true)

    it "wipes incomplete owned bytes when the session closes":
        # @req REQ-SSPEC-UNIT
        step("wipes incomplete owned bytes when the session closes")
        val owner = DbdAuthenticatedRespIngressV1.new()
        val partial = "*2\r\n$3\r\nGET\r\n$8\r\nsecret".bytes()
        expect(owner.ingest(partial)).to_equal(
            DbdCommandIngressStatusV1.Accepted)
        owner.close()
        expect(owner.last_close_wiped_byte_count()).to_equal(
            partial.len().to_i64())
        expect(owner.last_close_zeroized_owned_bytes()).to_be(true)
        expect(owner.remaining_byte_count()).to_equal(0i64)
        expect(owner.ingest([1u8])).to_equal(
            DbdCommandIngressStatusV1.Closed)
