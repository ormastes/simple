use std.spec.{describe, it, expect}
use std.fs_driver.bytes_util.{text_to_bytes_pure}
use std.common.string_core.{char_from_code}
use os.apps.servers_user.rfc6455_server_owner.{
    RFC6455_MAX_MESSAGE_BYTES, RFC6455_MAX_RETAINED_FRAME_BYTES,
    RFC6455_MAX_FRAGMENTS, RFC6455_MAX_HANDSHAKE_BYTES,
    RFC6455_MAX_INPUT_CHUNK_BYTES, RFC6455_MAX_EVENTS_PER_APPEND,
    Rfc6455ServerConnectionOwner, Rfc6455ServerEvent, Rfc6455ServerEventKind,
    validate_rfc6455_server_handshake
}

fn _upgrade(extra: text) -> text:
    "GET /ws HTTP/1.1\r\n" +
        "Host: simpleos\r\n" +
        "Upgrade: websocket\r\n" +
        "Connection: keep-alive, Upgrade\r\n" +
        "Sec-WebSocket-Version: 13\r\n" +
        "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n" + extra + "\r\n"

fn _masked_frame(first: u8, payload: [u8]) -> [u8]:
    _masked_frame_with_mask(first, payload,
        [0x37u8, 0xFAu8, 0x21u8, 0x3Du8])

fn _masked_frame_with_mask(first: u8, payload: [u8], mask: [u8]) -> [u8]:
    var frame: [u8] = [first]
    if payload.len() < 126u64:
        frame.push(0x80u8 | payload.len().to_u8())
    else:
        frame.push(0x80u8 | 126u8)
        frame.push(((payload.len() >> 8u64) & 255u64).to_u8())
        frame.push((payload.len() & 255u64).to_u8())
    frame.extend(mask)
    var index: u64 = 0u64
    while index < payload.len():
        frame.push(payload[index] ^ mask[index % 4u64])
        index = index + 1u64
    frame

fn _u64_length_frame(first: u8, length_bytes: [u8]) -> [u8]:
    var frame: [u8] = [first, 0xFFu8]
    frame.extend(length_bytes)
    frame.extend([1u8, 2u8, 3u8, 4u8])
    frame

fn _append_chunked(owner: Rfc6455ServerConnectionOwner,
    wire: [u8]) -> [Rfc6455ServerEvent]:
    var events: [Rfc6455ServerEvent] = []
    var offset: u64 = 0u64
    while offset < wire.len():
        val remaining = wire.len() - offset
        val count = if remaining < RFC6455_MAX_INPUT_CHUNK_BYTES:
            remaining
        else:
            RFC6455_MAX_INPUT_CHUNK_BYTES
        events.extend(owner.append_tail(wire.slice(offset, offset + count)))
        offset = offset + count
    events

describe "bounded pure-Simple RFC 6455 server prerequisite":
    it "accepts the RFC handshake vector and builds the exact accept value":
        val result = validate_rfc6455_server_handshake(_upgrade(""))
        expect(result.accepted).to_equal(true)
        expect(result.response).to_contain(
            "Sec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\n")

    it "accepts HTTP list-valued upgrade tokens split across field lines":
        val split = _upgrade("").replace(
            "Connection: keep-alive, Upgrade\r\n",
            "Connection: keep-alive\r\nConnection: Upgrade\r\n")
        expect(validate_rfc6455_server_handshake(split).accepted).to_equal(true)

    it "rejects invalid method version key duplication and header smuggling":
        expect(validate_rfc6455_server_handshake(
            _upgrade("").replace("GET /ws", "POST /ws")).accepted).to_equal(false)
        expect(validate_rfc6455_server_handshake(
            _upgrade("").replace("Version: 13", "Version: 12")).accepted).to_equal(false)
        expect(validate_rfc6455_server_handshake(
            _upgrade("").replace("dGhlIHNhbXBsZSBub25jZQ==", "AAAAAAAAAAAAAAAAAAAAAB==")).accepted).to_equal(false)
        expect(validate_rfc6455_server_handshake(_upgrade(
            "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n")).accepted).to_equal(false)
        expect(validate_rfc6455_server_handshake(_upgrade(
            "\r\nInjected: value\r\n")).accepted).to_equal(false)
        expect(validate_rfc6455_server_handshake(_upgrade(
            "Content-Length: 1\r\n")).accepted).to_equal(false)
        expect(validate_rfc6455_server_handshake(_upgrade(
            "Transfer-Encoding: chunked\r\n")).accepted).to_equal(false)
        expect(validate_rfc6455_server_handshake(_upgrade(
            "Origin: https://example.invalid\r\n")).accepted).to_equal(false)

    it "rejects ambiguous request-line separators before splitting fields":
        expect(validate_rfc6455_server_handshake(
            _upgrade("").replace("GET /ws HTTP/1.1", "GET  /ws HTTP/1.1")
        ).accepted).to_equal(false)
        expect(validate_rfc6455_server_handshake(
            _upgrade("").replace("GET /ws HTTP/1.1", " GET /ws HTTP/1.1")
        ).accepted).to_equal(false)
        expect(validate_rfc6455_server_handshake(
            _upgrade("").replace("GET /ws HTTP/1.1", "GET /ws HTTP/1.1 ")
        ).accepted).to_equal(false)
        expect(validate_rfc6455_server_handshake(
            _upgrade("").replace("GET /ws HTTP/1.1", "GET\t/ws HTTP/1.1")
        ).accepted).to_equal(false)
        expect(validate_rfc6455_server_handshake(
            _upgrade("").replace("GET /ws HTTP/1.1", "GET /ws\tHTTP/1.1")
        ).accepted).to_equal(false)

    it "rejects forbidden controls in request targets and field values":
        val nul = char_from_code(0)
        expect(validate_rfc6455_server_handshake(
            _upgrade("").replace("/ws", "/w{nul}s")).accepted).to_equal(false)
        expect(validate_rfc6455_server_handshake(
            _upgrade("").replace("Host: simpleos", "Host: simple{nul}os")).accepted).to_equal(false)
        expect(validate_rfc6455_server_handshake(
            _upgrade("").replace("Upgrade: websocket",
                "Upgrade: websocket, bad{nul}token")).accepted).to_equal(false)
        expect(validate_rfc6455_server_handshake(
            _upgrade("").replace("Upgrade: websocket",
                "Upgrade: websocket, bad token")).accepted).to_equal(false)
        expect(validate_rfc6455_server_handshake(
            _upgrade("").replace("Connection: keep-alive, Upgrade",
                "Connection: keep-alive,,Upgrade")).accepted).to_equal(false)
        expect(validate_rfc6455_server_handshake(
            _upgrade("").replace("/ws", "/bad%zz")).accepted).to_equal(false)

    it "bounds handshake bytes lines and header count before authorization":
        val huge = "GET /" + "a" * 65551 + " HTTP/1.1\r\n\r\n"
        expect(validate_rfc6455_server_handshake(huge).accepted).to_equal(false)
        var many = "GET /ws HTTP/1.1\r\n"
        var index = 0
        while index < 101:
            many = many + "X-{index}: y\r\n"
            index = index + 1
        many = many + "Host: simpleos\r\nUpgrade: websocket\r\n" +
            "Connection: Upgrade\r\nSec-WebSocket-Version: 13\r\n" +
            "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n\r\n"
        expect(validate_rfc6455_server_handshake(many).accepted).to_equal(false)
        expect(RFC6455_MAX_HANDSHAKE_BYTES).to_equal(65550u64)

    it "owns explicit fragmented tail input and emits one text message":
        var owner = Rfc6455ServerConnectionOwner.create()
        val wire = _masked_frame(0x81u8, text_to_bytes_pure("hello"))
        expect(owner.append_tail(wire.slice(0u64, 3u64)).len()).to_equal(0)
        val events = owner.append_tail(wire.slice(3u64, wire.len()))
        expect(events.len()).to_equal(1)
        expect(events[0].kind).to_equal(Rfc6455ServerEventKind.TextMessage)
        expect(events[0].payload).to_equal(text_to_bytes_pure("hello"))
        expect(owner.retained_wire_bytes()).to_equal(0u64)

    it "unmasks every byte across repeated four-byte mask cycles":
        var owner = Rfc6455ServerConnectionOwner.create()
        var payload: [u8] = []
        var index: u64 = 0u64
        while index < 257u64:
            payload.push(((index * 29u64 + 7u64) & 255u64).to_u8())
            index = index + 1u64
        val wire = _masked_frame_with_mask(0x82u8, payload,
            [0x00u8, 0xFFu8, 0xA5u8, 0x5Au8])
        val events = owner.append_tail(wire)
        expect(events.len()).to_equal(1)
        expect(events[0].kind).to_equal(Rfc6455ServerEventKind.BinaryMessage)
        expect(events[0].payload).to_equal(payload)
        expect(owner.retained_wire_bytes()).to_equal(0u64)

    it "assembles fragmentation while allowing interleaved ping":
        var owner = Rfc6455ServerConnectionOwner.create()
        val first = owner.append_tail(_masked_frame(0x01u8, text_to_bytes_pure("hel")))
        expect(first[0].kind).to_equal(Rfc6455ServerEventKind.FragmentProgress)
        val ping = owner.append_tail(_masked_frame(0x89u8, text_to_bytes_pure("p")))
        expect(ping[0].kind).to_equal(Rfc6455ServerEventKind.Ping)
        expect(ping[0].outbound).to_equal([0x8Au8, 1u8, 112u8])
        val final = owner.append_tail(_masked_frame(0x80u8, text_to_bytes_pure("lo")))
        expect(final[0].kind).to_equal(Rfc6455ServerEventKind.TextMessage)
        expect(final[0].payload).to_equal(text_to_bytes_pure("hello"))

    it "accepts the exact fragmented message bound and rejects one byte over":
        val large: [u8] = [97u8; RFC6455_MAX_MESSAGE_BYTES - 1u64]
        var exact = Rfc6455ServerConnectionOwner.create()
        val first_events = _append_chunked(exact, _masked_frame(0x02u8, large))
        expect(first_events[first_events.len() - 1u64].kind).to_equal(
            Rfc6455ServerEventKind.FragmentProgress)
        expect(exact.retained_wire_bytes()).to_equal(0u64)
        expect(exact.retained_message_bytes()).to_equal(
            RFC6455_MAX_MESSAGE_BYTES - 1u64)
        val exact_events = exact.append_tail(_masked_frame(0x80u8, [98u8]))
        expect(exact_events[0].kind).to_equal(Rfc6455ServerEventKind.BinaryMessage)
        expect(exact_events[0].payload.len()).to_equal(RFC6455_MAX_MESSAGE_BYTES)
        var over = Rfc6455ServerConnectionOwner.create()
        val _over_first = _append_chunked(over, _masked_frame(0x02u8, large))
        expect(over.append_tail(_masked_frame(0x80u8, [98u8, 99u8]))[0].close_code).to_equal(1009)

    it "rejects continuation ordering errors":
        var no_start = Rfc6455ServerConnectionOwner.create()
        expect(no_start.append_tail(_masked_frame(0x80u8, []))[0].close_code).to_equal(1002)
        var nested = Rfc6455ServerConnectionOwner.create()
        val _ = nested.append_tail(_masked_frame(0x01u8, [97u8]))
        expect(nested.append_tail(_masked_frame(0x82u8, [98u8]))[0].close_code).to_equal(1002)

    it "bounds adversarial zero-length fragmentation state":
        var owner = Rfc6455ServerConnectionOwner.create()
        val _ = owner.append_tail(_masked_frame(0x01u8, []))
        var index = 1
        while index < RFC6455_MAX_FRAGMENTS:
            val _progress = owner.append_tail(_masked_frame(0x00u8, []))
            index = index + 1
        expect(owner.append_tail(_masked_frame(0x00u8, []))[0].close_code).to_equal(1009)

    it "requires client masking and rejects RSV reserved opcode and control fragmentation":
        var unmasked = Rfc6455ServerConnectionOwner.create()
        val unmasked_events = unmasked.append_tail([0x81u8, 0u8])
        expect(unmasked_events[0].close_code).to_equal(1002)
        var rsv = Rfc6455ServerConnectionOwner.create()
        expect(rsv.append_tail(_masked_frame(0xC1u8, []) )[0].close_code).to_equal(1002)
        var reserved = Rfc6455ServerConnectionOwner.create()
        expect(reserved.append_tail(_masked_frame(0x83u8, []) )[0].close_code).to_equal(1002)
        var control = Rfc6455ServerConnectionOwner.create()
        expect(control.append_tail(_masked_frame(0x09u8, []) )[0].close_code).to_equal(1002)

    it "rejects non-canonical extended lengths and a set 63-bit MSB":
        var short_extended = Rfc6455ServerConnectionOwner.create()
        expect(short_extended.append_tail(
            [0x82u8, 0xFEu8, 0u8, 125u8, 1u8, 2u8, 3u8, 4u8])[0].close_code).to_equal(1002)
        var long_extended = Rfc6455ServerConnectionOwner.create()
        expect(long_extended.append_tail(_u64_length_frame(0x82u8,
            [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 126u8]))[0].close_code).to_equal(1002)
        var msb = Rfc6455ServerConnectionOwner.create()
        expect(msb.append_tail(_u64_length_frame(0x82u8,
            [0x80u8, 0u8, 0u8, 0u8, 0u8, 1u8, 0u8, 0u8]))[0].close_code).to_equal(1002)

    it "enforces UTF-8 close status message and retained-byte bounds":
        var utf8 = Rfc6455ServerConnectionOwner.create()
        expect(utf8.append_tail(_masked_frame(0x81u8, [0xC0u8, 0xAFu8]))[0].close_code).to_equal(1007)
        var close_code = Rfc6455ServerConnectionOwner.create()
        expect(close_code.append_tail(_masked_frame(0x88u8, [3u8, 237u8]))[0].close_code).to_equal(1002)
        var close_reason = Rfc6455ServerConnectionOwner.create()
        expect(close_reason.append_tail(_masked_frame(0x88u8,
            [3u8, 232u8, 0xEDu8, 0xA0u8, 0x80u8]))[0].close_code).to_equal(1007)
        var oversized = Rfc6455ServerConnectionOwner.create()
        expect(oversized.append_tail(_u64_length_frame(0x82u8,
            [0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 0u8, 1u8]))[0].close_code).to_equal(1009)
        expect(RFC6455_MAX_MESSAGE_BYTES).to_equal(65536u64)
        expect(RFC6455_MAX_RETAINED_FRAME_BYTES).to_equal(65550u64)

    it "accepts empty close and the 125-byte control boundary but rejects 126":
        var empty_close = Rfc6455ServerConnectionOwner.create()
        val close_events = empty_close.append_tail(_masked_frame(0x88u8, []))
        expect(close_events[0].kind).to_equal(Rfc6455ServerEventKind.PeerClose)
        expect(close_events[0].outbound).to_equal([0x88u8, 0u8])
        var max_ping = Rfc6455ServerConnectionOwner.create()
        val ping_payload: [u8] = [7u8; 125]
        expect(max_ping.append_tail(_masked_frame(0x89u8, ping_payload))[0].kind).to_equal(
            Rfc6455ServerEventKind.Ping)
        var over_ping = Rfc6455ServerConnectionOwner.create()
        val over_payload: [u8] = [7u8; 126]
        expect(over_ping.append_tail(_masked_frame(0x89u8, over_payload))[0].close_code).to_equal(1002)

    it "bounds each tail call and its returned event array":
        var batch: [u8] = []
        var count = 0
        while batch.len() + 6u64 <= RFC6455_MAX_INPUT_CHUNK_BYTES:
            batch.extend(_masked_frame(0x82u8, []))
            count = count + 1
        var owner = Rfc6455ServerConnectionOwner.create()
        val events = owner.append_tail(batch)
        expect(events.len()).to_equal(count)
        expect(events.len() <= RFC6455_MAX_EVENTS_PER_APPEND).to_equal(true)
        expect(owner.retained_wire_bytes()).to_equal(0u64)
        expect(owner.protocol_failed()).to_equal(false)
        var too_large = Rfc6455ServerConnectionOwner.create()
        val oversized: [u8] = [0u8; RFC6455_MAX_INPUT_CHUNK_BYTES + 1u64]
        expect(too_large.append_tail(oversized)[0].close_code).to_equal(1009)

    it "echoes one valid peer close and remains terminal":
        var owner = Rfc6455ServerConnectionOwner.create()
        val events = owner.append_tail(_masked_frame(0x88u8,
            [3u8, 232u8, 98u8, 121u8, 101u8]))
        expect(events[0].kind).to_equal(Rfc6455ServerEventKind.PeerClose)
        expect(events[0].close_code).to_equal(1000)
        expect(events[0].outbound).to_equal(
            [0x88u8, 5u8, 3u8, 232u8, 98u8, 121u8, 101u8])
        expect(owner.is_terminal()).to_equal(true)
        expect(owner.append_tail(_masked_frame(0x89u8, [])).len()).to_equal(0)

    it "emits one policy close and suppresses every later close":
        var owner = Rfc6455ServerConnectionOwner.create()
        val closing = owner.close_for_policy()
        expect(closing.close_code).to_equal(1001)
        expect(closing.outbound).to_equal([0x88u8, 2u8, 3u8, 233u8])
        expect(owner.is_terminal()).to_equal(true)
        expect(owner.close_for_policy().outbound.len()).to_equal(0)
