use std.spec.*
use std.fs.{read_file}

describe "Pure Simple H2 response owner boundary":
    it "uses static-table or raw non-Huffman HPACK under explicit caps":
        val source = read_file("src/os/apps/servers_user/web_h2_response_owner_v1.spl")
        expect(source).to_contain("hpack_static_table")
        expect(source).to_contain("Literal without indexing")
        expect(source).to_contain("Huffman bit is deliberately zero")
        expect(source).to_contain("WEB_H2_RESPONSE_MAX_HEADER_LIST_V1")
        expect(source).to_contain("WEB_H2_RESPONSE_MAX_HEADER_FIELDS_V1")
        expect(source).to_contain("WEB_H2_RESPONSE_MAX_BODY_V1")
        expect(source).to_not_contain("hpack_huffman")

    it "frames HEADERS then bounded DATA with linear indexed chunk copies":
        val source = read_file("src/os/apps/servers_user/web_h2_response_owner_v1.spl")
        expect(source).to_contain("H2Frame.Headers")
        expect(source).to_contain("remaining < self.peer_max_frame_size")
        expect(source).to_contain("H2Frame.Data")
        expect(source).to_contain("body[offset + chunk_offset]")
        expect(source).to_not_contain("body.slice")

    it "makes prepare commit abort and lease invalidation explicit":
        val source = read_file("src/os/apps/servers_user/web_h2_response_owner_v1.spl")
        val request_source = read_file("src/os/apps/servers_user/web_h2_request_owner_v1.spl")
        val authority_source = read_file("src/os/apps/servers_user/web_h2_response_authority_v1.spl")
        expect(source).to_contain("pending_token")
        expect(source).to_contain("commit_response")
        expect(source).to_contain("abort_response")
        expect(source).to_contain("invalid-response-lease")
        expect(source).to_contain("WebH2ResponseAdmissionReceiptV1")
        expect(source).to_contain("admission._connection_epoch != self.connection_epoch")
        expect(source).to_contain("admission._stream_generation")
        expect(source).to_contain("response-already-started-or-closed")
        expect(source).to_contain("receive_peer_goaway")
        expect(source).to_contain("cancel_stream")
        expect(source).to_contain("one-shot-response-requires-end-stream")
        expect(source).to_contain("self.remove_stream_at(index)")
        expect(source).to_not_contain("WebH2RequestEventV1")
        expect(authority_source).to_contain("pub struct WebH2ResponseAdmissionReceiptV1")
        expect(authority_source).to_contain("_connection_epoch: u64")
        expect(authority_source).to_contain("_response_owner_instance: u64")
        expect(authority_source).to_contain("_stream_generation: u64")
        expect(authority_source).to_contain("_lifecycle_nonce: u64")
        expect(source).to_contain("web_h2_allocate_response_owner_instance_v1")
        expect(authority_source).to_contain("web_h2_response_authority_consume_v1")
        expect(authority_source).to_contain("last_consumed_stream_id")
        expect(authority_source).to_contain("mutex_raw_lock")
        expect(authority_source).to_contain("poisoned: AtomicBool")
        expect(authority_source).to_contain("state.poisoned.store(true")
        expect(authority_source).to_contain("_web_h2_authority_unlock_v1")
        expect(authority_source).to_contain("instance == 0u64 or mutex_handle <= 0")
        expect(authority_source).to_contain("revoked_streams")
        expect(authority_source).to_not_contain("state.revoked_streams = retained")
        expect(request_source).to_contain("web_h2_response_authority_revoke_all_v1")
        expect(request_source).to_contain("web_h2_response_authority_revoke_stream_v1")
        expect(request_source).to_contain("response-authority-revoke-failed")
        expect(source).to_contain("transaction._owner_instance != self.owner_instance")
        expect(source).to_contain("if not web_h2_response_authority_valid_v1(self.authority, self.streams[index].stream_id)")
        expect(authority_source).to_contain("web_h2_response_authority_bind_v1")
        expect(authority_source).to_contain("state.bound")
        expect(request_source).to_contain("WebH2RequestEventKindV1.Reset")

    it "does not wire sockets WEB TLS or advertise ALPN h2":
        val source = read_file("src/os/apps/servers_user/web_h2_response_owner_v1.spl")
        expect(source).to_not_contain("TcpStream")
        expect(source).to_not_contain("ready_alpn_protocols")
        expect(source).to_not_contain("web_server")
        expect(source).to_not_contain("send_all")
