use spec
use os.apps.ssh_client.ssh_client_transport.{
    SshClientTransportError, ssh_client_wire_framer,
    ssh_client_banner_identification_ready
}
use os.apps.sshd.ssh_packet.{ssh_packet_build}

fn payload1() -> [u8]: [20, 1, 2, 3]
fn payload2() -> [u8]: [21]

describe "SSH client bounded socket-neutral transport":
    it "reassembles a packet delivered by partial reads":
        val wire = ssh_packet_build(payload1(), 0)
        var framer = ssh_client_wire_framer(128, 256)
        framer.feed([wire[0], wire[1]])
        expect(framer.drain_frames().len()).to_equal(0)
        framer.feed([wire[2], wire[3], wire[4]])
        expect(framer.drain_frames().len()).to_equal(0)
        var tail: [u8] = []
        var i = 5
        while i < wire.len():
            tail.push(wire[i])
            i = i + 1
        framer.feed(tail)
        val frames = framer.drain_frames()
        expect(frames.len()).to_equal(1)
        expect(frames[0]).to_equal(wire)

    it "drains multiple coalesced packets without losing boundaries":
        val first = ssh_packet_build(payload1(), 0)
        val second = ssh_packet_build(payload2(), 1)
        var combined = first
        var i = 0
        while i < second.len():
            combined.push(second[i])
            i = i + 1
        var framer = ssh_client_wire_framer(128, 512)
        framer.feed(combined)
        val frames = framer.drain_frames()
        expect(frames.len()).to_equal(2)
        expect(frames[0]).to_equal(first)
        expect(frames[1]).to_equal(second)

    it "fails closed with a typed oversized-frame error":
        var framer = ssh_client_wire_framer(16, 64)
        framer.feed([0, 0, 0, 17])
        expect(framer.closed).to_equal(true)
        expect(framer.status.ok).to_equal(false)
        expect(framer.status.error).to_equal(SshClientTransportError.FrameTooLarge)

    it "rejects a packet body too small to contain mandatory SSH padding":
        var framer = ssh_client_wire_framer(128, 256)
        framer.feed([0, 0, 0, 4])
        expect(framer.closed).to_equal(true)
        expect(framer.status.error).to_equal(SshClientTransportError.ProtocolFailure)

    it "fails closed when EOF interrupts a partial frame":
        var framer = ssh_client_wire_framer(128, 256)
        framer.feed([0, 0, 0, 12, 8, 20])
        framer.close_input()
        expect(framer.closed).to_equal(true)
        expect(framer.status.error).to_equal(SshClientTransportError.UnexpectedEof)

    it "rejects unsafe limits with a typed configuration error":
        val framer = ssh_client_wire_framer(1, 8)
        expect(framer.closed).to_equal(true)
        expect(framer.status.error).to_equal(SshClientTransportError.InvalidLimit)

    it "waits through fragmented informational lines for the SSH identification":
        expect(ssh_client_banner_identification_ready([110, 111, 116, 105, 99, 101, 13, 10])).to_equal(false)
        expect(ssh_client_banner_identification_ready([83, 83, 72, 45, 50, 46, 48])).to_equal(false)
        expect(ssh_client_banner_identification_ready([
            110, 111, 116, 105, 99, 101, 13, 10,
            83, 83, 72, 45, 50, 46, 48, 45, 115, 101, 114, 118, 101, 114, 13, 10
        ])).to_equal(true)
