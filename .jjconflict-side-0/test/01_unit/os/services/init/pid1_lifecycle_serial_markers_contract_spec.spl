# @cover src/os/services/init/service_manager_main.spl 100%
# @cover src/os/kernel/loader/root_service_catalog.spl 100%
# @cover src/os/kernel/arch/riscv64/syscall.spl 100%
# @req REQ-005
"""# PID1 lifecycle serial evidence contract

The QEMU gate may consume a marker only when its PID1 or kernel owner has
completed the corresponding catalog, endpoint, reaping, or teardown state
transition. Boot banners are not lifecycle evidence.
"""

use std.spec.{describe, it, expect}
use std.fs.{read_file}

describe "PID1 lifecycle serial evidence contract":
    it "records launch and readiness after successful opaque transitions":
        val source = read_file("src/os/services/init/service_manager_main.spl")
        expect(source).to_contain("if endpoint.is_ok():\n            _record_endpoint_ready(name)")
        expect(source).to_contain("if vfs <= 0:\n        return nil\n    _record_catalog_launch(ROOT_SERVICE_VFS, vfs)")
        expect(source).to_contain("_record_catalog_launch(ROOT_SERVICE_NET, net)")
        expect(source).to_contain("_record_catalog_launch(ROOT_SERVICE_HTTP, http)")
        expect(source).to_contain("[pid1] catalog-launch id=1 service=vfs pid={pid}")
        expect(source).to_contain("[pid1] catalog-launch id=2 service=net pid={pid}")
        expect(source).to_contain("[pid1] catalog-launch id=3 service=http pid={pid}")
        expect(source).to_contain("[pid1] endpoint-ready service=vfs")
        expect(source).to_contain("[pid1] endpoint-ready service=net")
        expect(source).to_contain("[pid1] endpoint-ready service=http")

    it "records crash and restart only after reaping and fresh endpoint readiness":
        val source = read_file("src/os/services/init/service_manager_main.spl")
        expect(source).to_contain("val reaped = root_service_wait_nohang(pids[i])")
        expect(source).to_contain("if reaped != 0:\n                    if catalog_ids[i] == ROOT_SERVICE_NET")
        expect(source).to_contain("[pid1] service-crash service=net pid={pids[i]} reap={reaped}")
        expect(source).to_contain("if not _wait_endpoint_ready(restarted_name):")
        expect(source).to_contain("[pid1] service-restart service=net pid={pids[i]} fresh-grants=true")

    it "clears the exiting service job before publishing kernel revocation evidence":
        val catalog = read_file("src/os/kernel/loader/root_service_catalog.spl")
        val syscall = read_file("src/os/kernel/arch/riscv64/syscall.spl")
        expect(catalog).to_contain("scheduler.set_task_name(child, entry.name)")
        expect(syscall).to_contain("sched.terminate_direct_child_job(task.parent.unwrap(), exiting")
        expect(syscall).to_contain("teardown_exited_task_authority(member, ipc_mgr)")
        expect(syscall).to_contain("[kernel] job-teardown service=net revoked-cspaces={members.len()} revoked-grants=true")
