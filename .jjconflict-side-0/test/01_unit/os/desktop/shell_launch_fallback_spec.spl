"""
## Purpose and audience
Behavioral specification for shell launch fallback.
Audience: compiler/runtime developers and spec maintainers who need
to verify this component's observable behavior and pinned values.
"""
# @req: REQ-TEST-DESKTOP_SHELL_LAUNCH_FALLBACK-001
# Desktop Shell Process Launch Spec
#
# Verifies that shell-side process materialization derives identity from
# launcher-owned process rows.

use std.spec
use os.desktop.shell.{DesktopShell}
use os.compositor.compositor.{Compositor}
use os.compositor.browser_compositor_backend.{BrowserCompositorBackend}
use os.compositor.input_backend.{InputBackend, host_event_from_polled}
use common.ui.host_input_event.{HostInputEvent}
use os.drivers.input.ps2_keyboard.{KeyEvent, Key}
use os.drivers.input.ps2_mouse.{MouseEvent}
use os.services.launcher.launcher.{
    launcher_init, launcher_record_process, launcher_get_process_window_count
}
use os.apps.simple_browser.simple_browser.{simple_browser_app_id}

class SilentInputBackend:
    _unused: bool

impl InputBackend for SilentInputBackend:

    me poll_event() -> HostInputEvent?:
        """The ONE trait-level ingress. Composes the inherent poll_key/poll_mouse
        pair through the shared helper, exactly as the real backends do."""
        val key_opt: KeyEvent? = self.poll_key()
        var ch = ""
        if val key_event = key_opt:
            if val Press(pressed_key) = key_event:
                if val Some(c) = self.key_to_char(pressed_key):
                    ch = c
            return host_event_from_polled(
                key_opt, nil, ch,
                self.shift_held(), self.ctrl_held(), self.alt_held()
            )
        val mouse_opt: MouseEvent? = self.poll_mouse()
        host_event_from_polled(
            nil, mouse_opt, "",
            self.shift_held(), self.ctrl_held(), self.alt_held()
        )
    me poll_key() -> KeyEvent?:
        nil

    me poll_mouse() -> MouseEvent?:
        nil

    fn alt_held() -> bool:
        false

    fn shift_held() -> bool:
        false

    fn ctrl_held() -> bool:
        false

    fn key_to_char(key: Key) -> text?:
        nil

impl SilentInputBackend:
    static fn new() -> SilentInputBackend:
        SilentInputBackend(_unused: false)

describe "DesktopShell process launch materialization":
    it "materializes generic process windows using launcher process identity":
        # @req: REQ-TEST-DESKTOP_SHELL_LAUNCH_FALLBACK-001
        step("Verify: materializes generic process windows using launcher process identity")
        launcher_init()
        val pid: u64 = 7501
        expect(launcher_record_process(pid, 0, "running", 0, 0, true)).to_be(true)

        var shell = _make_test_shell()
        expect(shell.materialize_process_launch("Hello World", pid)).to_be(true)

        expect(shell.compositor.window_count()).to_equal(1)  # oracle: expected value pinned by spec
        val ids = shell.compositor.windows_for_process(pid)
        expect(ids.len()).to_equal(1)  # oracle: expected value pinned by spec
        val wid = ids[0]
        expect(shell.compositor.window_app_id(wid)).to_equal("/sys/apps/hello_world")
        expect(shell.wm.window_owner_app_id(wid)).to_equal("/sys/apps/hello_world")
        expect(launcher_get_process_window_count(0)).to_equal(1)  # oracle: expected value pinned by spec

    it "keeps Browser Demo multi-window materialization while using launcher identity":
        # @req: REQ-TEST-DESKTOP_SHELL_LAUNCH_FALLBACK-001
        step("Verify: keeps Browser Demo multi-window materialization while using launcher identity")
        launcher_init()
        val pid: u64 = 7502
        expect(launcher_record_process(pid, 5, "running", 0, 0, true)).to_be(true)

        var shell = _make_test_shell()
        expect(shell.materialize_process_launch("Browser Demo", pid)).to_be(true)

        expect(shell.compositor.window_count_for_process(pid)).to_equal(2)  # oracle: expected value pinned by spec
        expect(shell.compositor.window_count_for_app("/sys/apps/browser_demo")).to_equal(2)
        expect(shell.wm.window_count_for_app("/sys/apps/browser_demo")).to_equal(2)
        expect(launcher_get_process_window_count(0)).to_equal(2)  # oracle: expected value pinned by spec

    it "materializes Simple Browser as a single filesystem-backed window":
        # @req: REQ-TEST-DESKTOP_SHELL_LAUNCH_FALLBACK-001
        step("Verify: materializes Simple Browser as a single filesystem-backed window")
        launcher_init()
        val pid: u64 = 7504
        expect(launcher_record_process(pid, 7, "running", 0, 0, true)).to_be(true)

        var shell = _make_test_shell()
        expect(shell.materialize_process_launch("Simple Browser", pid)).to_be(true)

        expect(shell.compositor.window_count()).to_equal(1)  # oracle: expected value pinned by spec
        val ids = shell.compositor.windows_for_process(pid)
        expect(ids.len()).to_equal(1)  # oracle: expected value pinned by spec
        val wm_ids = shell.wm.window_ids_for_process(pid)
        expect(wm_ids.len()).to_equal(1)  # oracle: expected value pinned by spec
        val wid = ids[0]
        expect(wm_ids[0]).to_equal(wid)  # oracle: expected value pinned by spec
        expect(shell.compositor.window_process_id(wid)).to_equal(pid)
        expect(shell.compositor.window_app_id(wid)).to_equal(simple_browser_app_id())
        expect(shell.wm.window_owner_process_id(wid)).to_equal(pid)
        expect(shell.wm.window_owner_app_id(wid)).to_equal(simple_browser_app_id())
        expect(shell.compositor.window_title(wid)).to_equal("Simple Browser")
        expect(launcher_get_process_window_count(0)).to_equal(1)  # oracle: expected value pinned by spec

    it "refuses process materialization when pid is missing":
        # @req: REQ-TEST-DESKTOP_SHELL_LAUNCH_FALLBACK-001
        step("Verify: refuses process materialization when pid is missing")
        launcher_init()

        var shell = _make_test_shell()
        expect(shell.materialize_process_launch("Hello World", 0)).to_be(false)
        expect(shell.compositor.window_count()).to_equal(0)  # oracle: expected value pinned by spec

    it "refuses process materialization for unknown apps":
        # @req: REQ-TEST-DESKTOP_SHELL_LAUNCH_FALLBACK-001
        step("Verify: refuses process materialization for unknown apps")
        launcher_init()
        val pid: u64 = 7503

        var shell = _make_test_shell()
        expect(shell.materialize_process_launch("Unknown App", pid)).to_be(false)
        expect(shell.compositor.window_count()).to_equal(0)  # oracle: expected value pinned by spec

fn _make_test_shell() -> DesktopShell:
    val backend = BrowserCompositorBackend.new(1024, 768)
    val input = SilentInputBackend.new()
    val compositor = Compositor.with_backends(backend, input, 1024, 768)
    var shell = DesktopShell.new(compositor)
    shell.set_task_reaper_enabled(false)
    shell
