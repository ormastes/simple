use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}

describe "hosted Web NONE damage present gate":
    it "checks compositor damage after accepting external Web frames":
        val source = file_read("src/os/hosted/hosted_entry.spl")
        expect(source.split("if comp.has_pending_damage():").len()).to_equal(3)
        expect(source).to_contain(
            "if comp.has_pending_damage():\n                            other_dirty = true")
        expect(source).to_contain(
            "if comp.has_pending_damage():\n                                    other_dirty = true")
        expect(source.contains(
            "):\n                                other_dirty = true\n                            else:\n                                browser_renderers.fail_window(")).to_be(false)
