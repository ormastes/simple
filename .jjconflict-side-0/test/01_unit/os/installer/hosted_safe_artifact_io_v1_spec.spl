use std.spec
use os.installer.hosted_safe_artifact_io_v1.{
    hosted_safe_artifact_relative_path_valid_v1,
    hosted_safe_artifact_provider_result_bounded_v1,
}

describe "hosted safe artifact I/O v1 facade":
    it "rejects path escape before provider dispatch":
        expect(hosted_safe_artifact_relative_path_valid_v1("../seed")).to_be(false)
        expect(hosted_safe_artifact_relative_path_valid_v1("/absolute")).to_be(false)

    it "rejects dot and empty components":
        expect(hosted_safe_artifact_relative_path_valid_v1("./manifest")).to_be(false)
        expect(hosted_safe_artifact_relative_path_valid_v1("dir//manifest")).to_be(false)

    it "accepts a canonical relative leaf path":
        expect(hosted_safe_artifact_relative_path_valid_v1(
            "catalog/manifest.sam1")).to_be(true)

    it "rejects an unsafe provider result larger than the requested bound":
        expect(hosted_safe_artifact_provider_result_bounded_v1(
            [1u8, 2u8, 3u8], 2)).to_be(false)
        expect(hosted_safe_artifact_provider_result_bounded_v1(
            [1u8, 2u8], 2)).to_be(true)
