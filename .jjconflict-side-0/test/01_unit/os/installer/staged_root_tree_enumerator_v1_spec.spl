use std.spec
use os.installer.staged_root_tree_enumerator_v1.*

fn _entry(path: text, kind: StagedRootTreeEntryKindV1,
    inode: i64, links: i64, size: i64) -> StagedRootTreeProviderEntryV1:
    StagedRootTreeProviderEntryV1(
        relative_path: path, kind: kind, device: 7, inode: inode,
        link_count: links, size_bytes: size, modified_seconds: 10,
        modified_nanoseconds: 20, provider_receipt: 91u64,
        provider_slot: inode,
        provider_digest_sha256: "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef")

fn _snapshot(entries: [StagedRootTreeProviderEntryV1]) -> StagedRootTreeProviderSnapshotV1:
    StagedRootTreeProviderSnapshotV1(
        root_device: 7, provider_receipt: 91u64,
        root_retained: true, directories_retained: true,
        nofollow_walk: true, walk_complete: true, entries: entries)

describe "staged root tree enumerator v1":
    it "returns lexical stable rows with every directory before its children":
        val result = staged_root_tree_enumerate_v1(_snapshot([
            _entry("usr/bin/tool", StagedRootTreeEntryKindV1.Regular, 4, 1, 12),
            _entry("usr", StagedRootTreeEntryKindV1.Directory, 2, 2, 0),
            _entry("README", StagedRootTreeEntryKindV1.Regular, 5, 1, 3),
            _entry("usr/bin", StagedRootTreeEntryKindV1.Directory, 3, 2, 0),
        ]), staged_root_tree_default_bounds_v1())
        expect(result.ok).to_be(true)
        expect(result.entries[0].relative_path).to_equal("README")
        expect(result.entries[1].relative_path).to_equal("usr")
        expect(result.entries[2].relative_path).to_equal("usr/bin")
        expect(result.entries[3].relative_path).to_equal("usr/bin/tool")
        expect(result.directory_count).to_equal(2)
        expect(result.regular_file_count).to_equal(2)
        expect(result.aggregate_file_bytes).to_equal(15)

    it "rejects traversal control separators missing parents and file parents":
        expect(staged_root_tree_relative_path_depth_v1("../tool")).to_equal(-1)
        expect(staged_root_tree_relative_path_depth_v1("bad\nname")).to_equal(-1)
        expect(staged_root_tree_relative_path_depth_v1("bad\\name")).to_equal(-1)
        expect(staged_root_tree_relative_path_depth_v1("bad:name")).to_equal(-1)
        expect(staged_root_tree_relative_path_depth_v1("bad*name")).to_equal(-1)
        expect(staged_root_tree_relative_path_depth_v1("bad.")).to_equal(-1)
        expect(staged_root_tree_relative_path_depth_v1("bad ")).to_equal(-1)
        val missing = staged_root_tree_enumerate_v1(_snapshot([
            _entry("usr/bin/tool", StagedRootTreeEntryKindV1.Regular, 4, 1, 1),
        ]), staged_root_tree_default_bounds_v1())
        expect(missing.error_code).to_equal("missing-parent-directory")
        val file_parent = staged_root_tree_enumerate_v1(_snapshot([
            _entry("usr", StagedRootTreeEntryKindV1.Regular, 2, 1, 1),
            _entry("usr/tool", StagedRootTreeEntryKindV1.Regular, 3, 1, 1),
        ]), staged_root_tree_default_bounds_v1())
        expect(file_parent.error_code).to_equal("non-directory-parent")

    it "rejects symlink special cross-root hardlink and incomplete provider evidence":
        expect(staged_root_tree_enumerate_v1(_snapshot([
            _entry("link", StagedRootTreeEntryKindV1.Symlink, 2, 1, 0),
        ]), staged_root_tree_default_bounds_v1()).error_code).to_equal("symlink-entry")
        expect(staged_root_tree_enumerate_v1(_snapshot([
            _entry("fifo", StagedRootTreeEntryKindV1.Special, 2, 1, 0),
        ]), staged_root_tree_default_bounds_v1()).error_code).to_equal("special-entry")
        var cross = _entry("tool", StagedRootTreeEntryKindV1.Regular, 2, 1, 1)
        cross.device = 8
        expect(staged_root_tree_enumerate_v1(_snapshot([cross]),
            staged_root_tree_default_bounds_v1()).error_code).to_equal("cross-root-entry")
        expect(staged_root_tree_enumerate_v1(_snapshot([
            _entry("tool", StagedRootTreeEntryKindV1.Regular, 2, 2, 1),
        ]), staged_root_tree_default_bounds_v1()).error_code).to_equal("hardlink-entry")
        var incomplete = _snapshot([])
        incomplete.walk_complete = false
        expect(staged_root_tree_enumerate_v1(incomplete,
            staged_root_tree_default_bounds_v1()).error_code).to_equal("unproven-retained-nofollow-walk")

    it "rejects exact and portable case-folded collisions":
        expect(staged_root_tree_enumerate_v1(_snapshot([
            _entry("tool", StagedRootTreeEntryKindV1.Regular, 2, 1, 1),
            _entry("tool", StagedRootTreeEntryKindV1.Regular, 3, 1, 1),
        ]), staged_root_tree_default_bounds_v1()).error_code).to_equal("duplicate-path")
        expect(staged_root_tree_enumerate_v1(_snapshot([
            _entry("Tool", StagedRootTreeEntryKindV1.Regular, 2, 1, 1),
            _entry("tool", StagedRootTreeEntryKindV1.Regular, 3, 1, 1),
        ]), staged_root_tree_default_bounds_v1()).error_code).to_equal("portable-path-collision")

    it "rejects duplicate retained tokens and duplicate device inode identities":
        val first = _entry("a", StagedRootTreeEntryKindV1.Regular, 2, 1, 1)
        var duplicate_token = _entry("b", StagedRootTreeEntryKindV1.Regular, 3, 1, 1)
        duplicate_token.provider_slot = first.provider_slot
        expect(staged_root_tree_enumerate_v1(_snapshot([first, duplicate_token]),
            staged_root_tree_default_bounds_v1()).error_code).to_equal("duplicate-retained-file-token")
        var duplicate_identity = _entry("b", StagedRootTreeEntryKindV1.Regular, 2, 1, 1)
        duplicate_identity.provider_slot = 9
        expect(staged_root_tree_enumerate_v1(_snapshot([first, duplicate_identity]),
            staged_root_tree_default_bounds_v1()).error_code).to_equal("hardlink-identity-alias")

    it "enforces depth count per-file and aggregate byte bounds":
        val one = _entry("a", StagedRootTreeEntryKindV1.Regular, 2, 1, 6)
        val two = _entry("b", StagedRootTreeEntryKindV1.Regular, 3, 1, 5)
        val count_bounds = StagedRootTreeBoundsV1(
            max_depth: 2, max_entries: 1, max_file_bytes: 10,
            max_aggregate_bytes: 10)
        expect(staged_root_tree_enumerate_v1(_snapshot([one, two]),
            count_bounds).error_code).to_equal("entry-limit-exceeded")
        val size_bounds = StagedRootTreeBoundsV1(
            max_depth: 2, max_entries: 2, max_file_bytes: 5,
            max_aggregate_bytes: 10)
        expect(staged_root_tree_enumerate_v1(_snapshot([one]),
            size_bounds).error_code).to_equal("file-size-limit-exceeded")
        val aggregate_bounds = StagedRootTreeBoundsV1(
            max_depth: 2, max_entries: 2, max_file_bytes: 10,
            max_aggregate_bytes: 10)
        expect(staged_root_tree_enumerate_v1(_snapshot([one, two]),
            aggregate_bounds).error_code).to_equal("aggregate-size-limit-exceeded")
        val depth_bounds = StagedRootTreeBoundsV1(
            max_depth: 1, max_entries: 2, max_file_bytes: 10,
            max_aggregate_bytes: 10)
        expect(staged_root_tree_enumerate_v1(_snapshot([
            _entry("a/b", StagedRootTreeEntryKindV1.Regular, 2, 1, 1),
        ]), depth_bounds).error_code).to_equal("invalid-path-or-depth")

    it "returns digest-friendly identity metadata without file bodies":
        val result = staged_root_tree_enumerate_v1(_snapshot([
            _entry("tool", StagedRootTreeEntryKindV1.Regular, 77, 1, 9),
        ]), staged_root_tree_default_bounds_v1())
        expect(result.ok).to_be(true)
        expect(result.entries[0].device).to_equal(7)
        expect(result.entries[0].inode).to_equal(77)
        expect(result.entries[0].size_bytes).to_equal(9)
        expect(result.entries[0].modified_seconds).to_equal(10)
        expect(result.entries[0].modified_nanoseconds).to_equal(20)
        expect(result.entries[0].provider_receipt).to_equal(91u64)
        expect(result.entries[0].provider_slot).to_equal(77)
        expect(result.entries[0].provider_digest_sha256.len()).to_equal(64)

    it "rejects a regular row without its provider admission digest":
        var row = _entry("tool", StagedRootTreeEntryKindV1.Regular, 77, 1, 9)
        row.provider_digest_sha256 = ""
        expect(staged_root_tree_enumerate_v1(_snapshot([row]),
            staged_root_tree_default_bounds_v1()).error_code).to_equal(
                "invalid-provider-digest")
