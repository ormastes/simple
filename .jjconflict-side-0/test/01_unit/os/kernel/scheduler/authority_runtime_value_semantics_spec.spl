use std.spec.{describe, it, expect}
use os.kernel.scheduler.scheduler.{Scheduler}
use os.kernel.scheduler.scheduler_types.{task_security_binding_managed_child}
use os.kernel.types.task_types.{TaskPriority}
use os.kernel.types.capability_types.{CapabilityKind, CapabilitySet, CapabilityToken}

fn _authority_token(token_id: u64, parent_token_id: u64) -> CapabilityToken:
    CapabilityToken(
        kind: CapabilityKind.ProcessSpawn,
        generation: 1u64,
        owner: 0u64,
        token_id: token_id,
        parent_token_id: parent_token_id,
        depth: 1i64
    )

describe "scheduler authority value-semantic updates":
    it "binds child identity and syscall policy without losing either binding":
        var scheduler = Scheduler.new()
        val parent = scheduler.create_task(
            0x1000, TaskPriority.Normal, CapabilitySet.empty())
        val child = scheduler.create_task(
            0x2000, TaskPriority.Normal, CapabilitySet.empty())
        expect(scheduler.bind_managed_child_security(
            child, task_security_binding_managed_child(parent.id, parent.id, child)
        )).to_equal(true)
        expect(scheduler.bind_managed_child_syscall_filter(child, [4u64, 5u64])).to_equal(true)
        val task = scheduler.get_task(child)
        if task != nil:
            expect(task.security.parent_job_id).to_equal(parent.id.id)
            expect(task.security.syscall_filter_bound).to_equal(true)
            expect(scheduler.syscall_allowed(child, 5u64)).to_equal(true)

    it "reconstructs resource limits while preserving the managed identity":
        var scheduler = Scheduler.new()
        val child = scheduler.create_task(
            0x2000, TaskPriority.Normal, CapabilitySet.empty())
        expect(scheduler.bind_managed_child_security(
            child, task_security_binding_managed_child(0u64, 0u64, child)
        )).to_equal(true)
        expect(scheduler.bind_managed_child_resource_limits(child, 7u64, 11u64)).to_equal(true)
        val task = scheduler.get_task(child)
        if task != nil:
            expect(task.security.principal_id).to_equal(child.id.id)
            expect(task.security.process_limit).to_equal(7u64)
            expect(task.isolation.max_threads).to_equal(7u32)
            expect(task.isolation.max_memory_pages).to_equal(11u64)

    it "revokes a capability lineage and advances only affected CSpaces":
        var scheduler = Scheduler.new()
        val owner = scheduler.create_task(
            0x1000, TaskPriority.Normal,
            CapabilitySet(caps: [_authority_token(40u64, 0u64)], is_pledged: true))
        val delegate = scheduler.create_task(
            0x2000, TaskPriority.Normal,
            CapabilitySet(caps: [_authority_token(41u64, 40u64)], is_pledged: true))
        val untouched = scheduler.create_task(
            0x3000, TaskPriority.Normal,
            CapabilitySet(caps: [_authority_token(90u64, 0u64)], is_pledged: true))
        val untouched_before = scheduler.get_task(untouched)
        expect(scheduler.revoke_cspace_lineage(40u64)).to_equal(2i64)
        val owner_after = scheduler.get_task(owner)
        val delegate_after = scheduler.get_task(delegate)
        val untouched_after = scheduler.get_task(untouched)
        if owner_after != nil and delegate_after != nil and untouched_before != nil and untouched_after != nil:
            expect(owner_after.capabilities.caps.len()).to_equal(0)
            expect(delegate_after.capabilities.caps.len()).to_equal(0)
            expect(untouched_after.capabilities.caps.len()).to_equal(1)
            expect(untouched_after.security.cspace_id).to_equal(untouched_before.security.cspace_id)
