"""Canonical Simple-facing names for the kernel network facade."""

use std.spec.*
use os.kernel.net.rt_net_socket_facade.{
    net_socket_facade_link_anchor,
    net_bind_and_listen,
    net_last_ssh_plain_payload_len,
    net_last_ssh_plain_payload_slice,
}

describe "kernel network facade naming":
    it "links through the canonical Simple-facing facade name":
        expect(net_socket_facade_link_anchor()).to_be(true)

    it "rejects an invalid socket without crossing the FFI boundary":
        expect(net_bind_and_listen(-1, 2222)).to_equal(-1)

    it "exposes the initial empty SSH payload through canonical names":
        expect(net_last_ssh_plain_payload_len()).to_equal(0)
        expect(net_last_ssh_plain_payload_slice(0, 0).len()).to_equal(0u64)
