use std.spec.*
use os.kernel.loader.spawn_recipes.*
use os.kernel.types.capability_types.{CapabilityKind}
use std.common.contracts.execution.simpleos_target_v1.{
    SIMPLEOS_TARGET_V1_X86_64_TRIPLE, SIMPLEOS_TARGET_V1_I686_TRIPLE,
    SIMPLEOS_TARGET_V1_AARCH64_TRIPLE, SIMPLEOS_TARGET_V1_ARMV7_TRIPLE,
    SIMPLEOS_TARGET_V1_RISCV64GC_TRIPLE,
    SIMPLEOS_TARGET_V1_RISCV32IMAC_TRIPLE
}
use os.kernel.loader.clang_cc1_argv_contract_v1.{
    clang_filesystem_cc1_argv_plan_v1
}

fn _compile_argv(root: text) -> [text]:
    ["/usr/bin/clang", "-cc1", "-triple",
     SIMPLEOS_TARGET_V1_X86_64_TRIPLE, "-emit-obj", "-o",
     root + "/hello.o", "-x", "c", root + "/hello.c"]

fn _link_argv(root: text) -> [text]:
    ["/usr/bin/ld.lld", "-m", "elf_x86_64", "-static", "-no-pie",
     "--gc-sections", "--export-dynamic", "--defsym=__bss_end=_end",
     "-T", "/usr/share/simpleos/simpleos.ld", "-e", "_start",
     "/usr/lib/crt0.o", root + "/hello.o", "-L", "/usr/lib",
     "--start-group", "-lsimpleos_c", "-lsimple_runtime", "-lm",
     "--end-group", "-o", root + "/hello.elf"]

fn _has_process_spawn(recipe: i64) -> bool:
    for grant in spawn_recipe_grants(recipe):
        if grant.requested == CapabilityKind.ProcessSpawn: return true
    false

describe "Clang filesystem spawn recipes":
    it "admits the one owner-issued cc1 vector for all six targets":
        val targets = [
            SIMPLEOS_TARGET_V1_X86_64_TRIPLE, SIMPLEOS_TARGET_V1_I686_TRIPLE,
            SIMPLEOS_TARGET_V1_AARCH64_TRIPLE, SIMPLEOS_TARGET_V1_ARMV7_TRIPLE,
            SIMPLEOS_TARGET_V1_RISCV64GC_TRIPLE,
            SIMPLEOS_TARGET_V1_RISCV32IMAC_TRIPLE]
        for target in targets:
            val plan = clang_filesystem_cc1_argv_plan_v1(
                "/usr/bin/clang", target,
                "/dbfs/work/hello.o", "/dbfs/work/hello.c").unwrap()
            expect(plan.argv[plan.source_argv_index]).to_equal(
                "/dbfs/work/hello.c")
            expect(spawn_recipe_launch_contract_valid(
                SPAWN_RECIPE_CLANG_COMPILE_DBFS, "/usr/bin/clang",
                plan.argv, [])).to_be(true)

    it "emits exact RISC-V machine triples ABIs features and source indices":
        val rv64 = clang_filesystem_cc1_argv_plan_v1(
            "/usr/bin/clang", SIMPLEOS_TARGET_V1_RISCV64GC_TRIPLE,
            "/nvfs/work/hello.o", "/nvfs/work/hello.c").unwrap()
        expect(rv64.argv).to_equal([
            "/usr/bin/clang", "-cc1", "-triple", "riscv64-unknown-simpleos",
            "-target-abi", "lp64d", "-target-feature", "+m",
            "-target-feature", "+a", "-target-feature", "+f",
            "-target-feature", "+d", "-target-feature", "+c",
            "-target-feature", "+zicsr", "-target-feature", "+zifencei",
            "-emit-obj", "-o", "/nvfs/work/hello.o", "-x", "c",
            "/nvfs/work/hello.c"])
        expect(rv64.source_argv_index).to_equal(25)
        val rv32 = clang_filesystem_cc1_argv_plan_v1(
            "/usr/bin/clang", SIMPLEOS_TARGET_V1_RISCV32IMAC_TRIPLE,
            "/nvfs/work/hello.o", "/nvfs/work/hello.c").unwrap()
        expect(rv32.argv).to_equal([
            "/usr/bin/clang", "-cc1", "-triple", "riscv32-unknown-simpleos",
            "-target-abi", "ilp32", "-target-feature", "+m",
            "-target-feature", "+a", "-target-feature", "+c",
            "-emit-obj", "-o", "/nvfs/work/hello.o", "-x", "c",
            "/nvfs/work/hello.c"])
        expect(rv32.source_argv_index).to_equal(17)

    it "rejects RISC-V platform triple ABI feature and trailing substitutions":
        val exact = clang_filesystem_cc1_argv_plan_v1(
            "/usr/bin/clang", SIMPLEOS_TARGET_V1_RISCV64GC_TRIPLE,
            "/dbfs/work/hello.o", "/dbfs/work/hello.c").unwrap().argv
        var changed = exact.copy()
        changed[3] = SIMPLEOS_TARGET_V1_RISCV64GC_TRIPLE
        expect(spawn_recipe_launch_contract_valid(
            SPAWN_RECIPE_CLANG_COMPILE_DBFS, "/usr/bin/clang", changed, [])).to_be(false)
        changed = exact.copy()
        changed[5] = "ilp32"
        expect(spawn_recipe_launch_contract_valid(
            SPAWN_RECIPE_CLANG_COMPILE_DBFS, "/usr/bin/clang", changed, [])).to_be(false)
        changed = exact.copy()
        changed[11] = "+c"
        expect(spawn_recipe_launch_contract_valid(
            SPAWN_RECIPE_CLANG_COMPILE_DBFS, "/usr/bin/clang", changed, [])).to_be(false)
        changed = exact.copy()
        changed[17] = "+zifencei"
        expect(spawn_recipe_launch_contract_valid(
            SPAWN_RECIPE_CLANG_COMPILE_DBFS, "/usr/bin/clang", changed, [])).to_be(false)
        changed = exact.copy()
        changed[19] = "+zicsr"
        expect(spawn_recipe_launch_contract_valid(
            SPAWN_RECIPE_CLANG_COMPILE_DBFS, "/usr/bin/clang", changed, [])).to_be(false)
        changed = exact.copy()
        changed.remove(4)
        changed.remove(4)
        expect(spawn_recipe_launch_contract_valid(
            SPAWN_RECIPE_CLANG_COMPILE_DBFS, "/usr/bin/clang", changed, [])).to_be(false)
        changed = exact.copy()
        changed.remove(10)
        changed.remove(10)
        expect(spawn_recipe_launch_contract_valid(
            SPAWN_RECIPE_CLANG_COMPILE_DBFS, "/usr/bin/clang", changed, [])).to_be(false)
        changed = exact.copy()
        changed.pop()
        expect(spawn_recipe_launch_contract_valid(
            SPAWN_RECIPE_CLANG_COMPILE_DBFS, "/usr/bin/clang", changed, [])).to_be(false)
        changed = exact.copy()
        changed.push("--extra")
        expect(spawn_recipe_launch_contract_valid(
            SPAWN_RECIPE_CLANG_COMPILE_DBFS, "/usr/bin/clang", changed, [])).to_be(false)

    it "binds DBFS stages to exact paths argv and an empty environment":
        expect(spawn_recipe_launch_contract_valid(
            SPAWN_RECIPE_CLANG_COMPILE_DBFS, "/usr/bin/clang",
            _compile_argv("/dbfs/work"), [])).to_be(true)
        expect(spawn_recipe_launch_contract_valid(
            SPAWN_RECIPE_LLD_LINK_DBFS, "/usr/bin/ld.lld",
            _link_argv("/dbfs/work"), [])).to_be(true)
        expect(spawn_recipe_launch_contract_valid(
            SPAWN_RECIPE_CLANG_HELLO_DBFS, "/dbfs/work/hello.elf",
            ["/dbfs/work/hello.elf"], [])).to_be(true)

    it "rejects cross-filesystem suffix argv and environment substitution":
        expect(spawn_recipe_launch_contract_valid(
            SPAWN_RECIPE_CLANG_COMPILE_DBFS, "/usr/bin/clang-evil",
            _compile_argv("/dbfs/work"), [])).to_be(false)
        expect(spawn_recipe_launch_contract_valid(
            SPAWN_RECIPE_LLD_LINK_DBFS, "/usr/bin/ld.lld",
            _link_argv("/nvfs/work"), [])).to_be(false)
        expect(spawn_recipe_launch_contract_valid(
            SPAWN_RECIPE_CLANG_HELLO_NVFS, "/nvfs/work/hello.elf",
            ["/nvfs/work/hello.elf"], ["LD_PRELOAD=/nvfs/work/x"])).to_be(false)

    it "keeps child grants free of spawn while each parent retains launch authority":
        val recipes = [
            SPAWN_RECIPE_CLANG_COMPILE_DBFS,
            SPAWN_RECIPE_LLD_LINK_DBFS,
            SPAWN_RECIPE_CLANG_HELLO_DBFS,
            SPAWN_RECIPE_CLANG_COMPILE_NVFS,
            SPAWN_RECIPE_LLD_LINK_NVFS,
            SPAWN_RECIPE_CLANG_HELLO_NVFS,
        ]
        for recipe in recipes:
            expect(_has_process_spawn(recipe)).to_be(false)
            val parent = spawn_recipe_seed_parent_caps(recipe, 77u64)
            expect(parent.caps.len()).to_equal(
                spawn_recipe_grant_count(recipe) + 1)
            var parent_has_spawn = false
            for cap in parent.caps:
                if cap.kind == CapabilityKind.ProcessSpawn:
                    parent_has_spawn = true
            expect(parent_has_spawn).to_be(true)
