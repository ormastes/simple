use std.test.{describe, it, expect}
use std.fs.{file_read}

describe("authenticated x86 filesystem async spawn source contract"):
    it("adopts sealed authority and keeps the scheduler-owned PID live"):
        val facade = file_read("src/os/kernel/loader/x86_64_fs_exec_spawn.spl")
        val service = file_read("src/os/kernel/loader/authenticated_fs_exec_submission_service_v1.spl")
        expect(facade).to_contain("x86_64_fs_exec_adopt_authenticated_async_with_launch_v1")
        expect(facade).to_contain("fs_exec_adopt_authenticated_with_launch_v1(")
        expect(service).to_contain("authenticated_fs_exec_spawn_async_v1")
        expect(service).to_contain("authenticated_fs_exec_spawn_installed_async_v1")
        expect(service).to_contain("if prepared.pid > 0:")
        expect(service).to_contain("scheduler: prepared.scheduler")

    it("accepts only a prepared submission and has no cached-byte resolver"):
        val facade = file_read("src/os/kernel/loader/x86_64_fs_exec_spawn.spl")
        val service = file_read("src/os/kernel/loader/authenticated_fs_exec_submission_service_v1.spl")
        expect(service).to_contain("submission.authorities, submission.token")
        expect(service).to_contain("submission.consumer, submission.entry_point")
        expect(service).to_contain("authenticated_fs_exec_prepare_installed_artifact_online_v1(")
        expect(service).to_contain("vfs_state_mount_table_lease_begin_v1(")
        expect(service).to_contain("executable_loader_revoke(")
        expect(facade).not.to_contain("app_registry_cached_boot_app_id")
        expect(facade).not.to_contain("resolve_executable_bytes")

    it("preserves the live pid when post-publication VFS cleanup is indeterminate"):
        val service = file_read("src/os/kernel/loader/authenticated_fs_exec_submission_service_v1.spl")
        expect(service).to_contain("pid: spawned.pid")
        expect(service).to_contain("spawned.cleanup_indeterminate or not restored")
