# @cover src/os/kernel/arch_adapt/x86_32_user_mapping.spl 100%
# Exact source-decision coverage for x86-32 loader mapping routing.

use std.spec.{describe, it, expect, step}
use app.io.mod.{file_read_text}

val ADAPTER_PATH = "src/os/kernel/arch_adapt/x86_32_user_mapping.spl"
val CONSUMER_PATH =
    "src/os/kernel/loader/x86_32_authenticated_mapping_owner_v1.spl"
val CONCRETE_OWNER = "os.kernel.arch.x86_32.user_page_root_owner_v1"
val ADAPTER_OWNER = "os.kernel.arch_adapt.x86_32_user_mapping"
val EXACT_ADAPTER_SOURCE = "# Compile-time x86-32 User-Mapping Adapter\n" +
    "#\n" +
    "# Loader owners bind to this architecture boundary instead of importing the\n" +
    "# concrete x86-32 tree. Public re-exports preserve the existing declarations;\n" +
    "# no runtime dispatch, allocation, copied state, or additional call is added.\n" +
    "\n" +
    "pub use {CONCRETE_OWNER}.{{\n" +
    "    X8632UserRootLeaseV1,\n" +
    "    X8632LeafDispositionV1,\n" +
    "    x86_32_user_root_create_v1,\n" +
    "    x86_32_user_allocate_and_map_v1,\n" +
    "    x86_32_user_unmap_exact_v1,\n" +
    "    x86_32_user_root_destroy_unpublished_v1,\n" +
    "}}\n"
val EXACT_CONSUMER_IMPORT = "use {ADAPTER_OWNER}.{{\n" +
    "    X8632UserRootLeaseV1, X8632LeafDispositionV1,\n" +
    "    x86_32_user_root_create_v1, x86_32_user_allocate_and_map_v1,\n" +
    "    x86_32_user_unmap_exact_v1, x86_32_user_root_destroy_unpublished_v1\n" +
    "}}"

describe "x86-32 user-mapping compile-time architecture adapter":
    it "re-exports the exact concrete owner surface without runtime work":
        step("Read the adapter source and pin its exact export decision")
        val source = file_read_text(ADAPTER_PATH)
        expect(source).to_equal(EXACT_ADAPTER_SOURCE)

    it "routes the x86-32 loader consumer only through the adapter":
        step("Read and pin the exact consumer import block")
        val consumer = file_read_text(CONSUMER_PATH)
        expect(consumer.contains(EXACT_CONSUMER_IMPORT)).to_equal(true)
        expect(consumer.count(ADAPTER_OWNER)).to_equal(1)

        step("Reject a direct concrete-owner import from the consumer")
        expect(consumer.contains(CONCRETE_OWNER)).to_equal(false)
