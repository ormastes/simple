"""Owned-copy IPC distinguishes request permit minting from reply delivery."""

use std.spec.{describe, it, expect}
use os.kernel.ipc.ipc.{IpcManager}
use os.kernel.ipc.syscall_ipc.{ipc_owned_v1_parse_net_bind_port}
use os.kernel.types.ipc_types.{IpcMessage, IpcFlags, IpcPort}
use os.kernel.types.task_types.{TaskId}

describe "owned IPC reply classification":
    it "classifies a request and reply without consuming either record":
        var ipc = IpcManager.new()
        val client = TaskId(id: 41u64)
        val service = TaskId(id: 42u64)
        val client_port = ipc.create_port(client, "reply-client")
        val service_port = ipc.create_port(service, "reply-service")

        val request = IpcMessage(src_port: client_port.id, dst_port: service_port.id, method: 1u32, flags: IpcFlags.Async as u32, payload_len: 0u32, cap_count: 0u32)
        expect(ipc.send_owned(client, client_port.id, request, [])).to_equal(0)
        expect(ipc.next_owned_is_reply(service, IpcPort(id: service_port.id, owner: service.id))).to_equal(0)

        val received = ipc.recv_owned(service, IpcPort(id: service_port.id, owner: service.id))
        expect(received.header.?).to_equal(true)
        val reply = IpcMessage(src_port: service_port.id, dst_port: client_port.id, method: 1u32, flags: IpcFlags.Reply as u32, payload_len: 0u32, cap_count: 0u32)
        expect(ipc.send_owned(service, service_port.id, reply, [])).to_equal(0)
        expect(ipc.next_owned_is_reply(client, IpcPort(id: client_port.id, owner: client.id))).to_equal(1)

    it "decodes the exact little-endian bind port before enqueue":
        val bind_request = ipc_owned_v1_parse_net_bind_port([0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 80u8, 0u8])
        expect(bind_request.ok).to_equal(true)
        expect(bind_request.port).to_equal(80u16)
        expect(ipc_owned_v1_parse_net_bind_port([0u8]).ok).to_equal(false)
