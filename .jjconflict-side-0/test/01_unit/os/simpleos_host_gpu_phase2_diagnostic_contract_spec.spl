extern fn rt_file_read_text(path: text) -> text

describe "SimpleOS host GPU Phase2 diagnostic lane":
    it "is explicit, ARM64-only, non-attested, and leaves normal admission unchanged":
        val source = rt_file_read_text("scripts/check/check-simpleos-qemu-host-gpu-2d.shs") ?? ""
        expect(source).to_contain("SIMPLEOS_HOST_GPU_ALLOW_BOOTSTRAP_COMPILER_DIAGNOSTIC")
        expect(source).to_contain("[ \"$GUEST_ISA_REQUEST\" = aarch64 ]")
        expect(source).to_contain("[ -f \"$candidate\" ] && [ ! -L \"$candidate\" ] && [ -x \"$candidate\" ]")
        expect(source).to_contain("candidate_frontend_smoke \"$candidate\"")
        expect(source).to_contain("evidence_class=diagnostic-phase2-non-attested")
        expect(source).to_contain("simpleos_qemu_host_gpu_2d_status=$reported_overall")
        expect(source).to_contain("reported_overall=diagnostic")
        expect(source).to_contain("simple_binary_is_valid \"$SIMPLE_BIN\"")
        expect(source).to_contain("metal_guest_negotiation_two_hop_available")
        expect(source).to_contain("'_host_gpu_probe_attempt(' render_backend")
        expect(source).to_contain("'host_gpu_ivshmem_negotiate(' backend")
        expect(source).to_contain("--self-test-metal-guest-contract")
