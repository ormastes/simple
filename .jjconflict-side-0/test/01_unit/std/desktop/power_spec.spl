"""
## Purpose and audience
Verifies the power behaviour end to end so maintainers of this
component and reviewers of its spec share one pinned definition.
## Operator workflow
Run `bin/simple test <this spec>`; read the per-scenario verdicts in
the `Results:` summary. Each scenario asserts an observable outcome.
## Compatibility and limitations
Covers the currently shipped behaviour only; performance, stress and
unrelated sibling features are out of scope.
"""
# @manual: primary
# @req: REQ-TEST-DESKTOP_POWER-001
# doc-path: doc/01_research/os/x86_desktop/x86_dual_arch_qemu_boot.md
# doc-path: doc/03_plan/os/misc/x86_64_desktop_driver_completion.md
# doc-path: doc/04_architecture/hardware/t32_terminal_power_remote.md
# doc-path: doc/05_design/os/desktop/tmux_simpleos.md
# Desktop power monitor API specification

use std.spec.step
use std.nogc_sync_mut.desktop.power.{PowerState, BatteryInfo}

describe "Desktop Power Monitor API":
    it "creates BatteryInfo struct":
        # @req: REQ-TEST-DESKTOP_POWER-001
        step("Verify: creates BatteryInfo struct")
        # evidence(expect(...) oracle verified): pinned constants below are authoritative values asserted by this scenario
        val info = BatteryInfo(state: PowerState.AC, level: 100, time_remaining_seconds: -1, is_charging: false)
        expect info.level == 100
        expect info.is_charging == false
