#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
work=$(mktemp -d "${TMPDIR:-/tmp}/release-version-consistency.XXXXXX")
trap 'rm -rf "$work"' EXIT HUP INT TERM

for file in \
    VERSION config/bootstrap.sdn src/app/simple.sdn src/compiler/simple.sdn \
    src/lib/simple.sdn src/compiler_rust/simple.sdn \
    src/app/cli/bootstrap_identity.spl src/app/cli/cli_helpers.spl \
    src/app/cli/_CliMain/args_and_os_commands.spl \
    src/app/simpleos_tool/main.spl src/compiler_rust/Cargo.toml \
    src/compiler_rust/Cargo.lock; do
    mkdir -p "$work/$(dirname "$file")"
    cp "$root/$file" "$work/$file"
done

sh "$root/scripts/check/check-release-version-consistency.shs" "$work" >/dev/null
printf '9.9.9-test\n' >"$work/VERSION"
if sh "$root/scripts/check/check-release-version-consistency.shs" "$work" \
    >/dev/null 2>&1; then
    exit 1
fi
echo "release_version_consistency_contract=pass"
