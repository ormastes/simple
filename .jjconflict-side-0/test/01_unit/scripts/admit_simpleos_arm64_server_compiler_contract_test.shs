#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
cd "$root"
gate=scripts/check/admit-simpleos-arm64-server-compiler.shs
[ -x "$gate" ]
grep -Fq 'stage4_verify_candidate_provenance' "$gate"
grep -Fq 'check-bootstrap-essential-tools-smoke.shs' "$gate"
grep -Fq 'SIMPLE_NO_STUB_FALLBACK=1' "$gate"
grep -Fq 'build_arm64_servers_payload.shs' "$gate"
grep -Fq 'native_smoke_target=aarch64-unknown-simpleos' "$gate"
grep -Fq 'TARGET="aarch64-unknown-simpleos"' scripts/os/build_arm64_servers_payload.shs
grep -Fq 'SIMPLEOS_SYSROOT' scripts/os/build_arm64_servers_payload.shs
grep -Fq 'SIMPLE_SIMPLE_CORE_PATH' scripts/os/build_arm64_servers_payload.shs
grep -Fq 'source_manifest_roots=$ROOTS' "$gate"
grep -Fq 'chmod 600 "$tmp"' "$gate"
grep -Fq 'mv "$tmp" "$output"' "$gate"
grep -Fq '[ -z "$output_cleanup" ] || rm -f "$output_cleanup"' "$gate"
grep -Fq 'output parent contains a symlink' "$gate"
receipt_mv_line=$(grep -n 'mv "$tmp" "$output"' "$gate" | cut -d: -f1)
published_line=$(grep -n '^published=1' "$gate" | cut -d: -f1)
[ "$receipt_mv_line" -lt "$published_line" ]
[ -z "$(sed -n "${receipt_mv_line},${published_line}p" "$gate" | grep -E 'git rev-parse|snapshot|hash \"\$compiler\"' || true)" ]
sh "$gate" --self-test
echo 'PASS admit SimpleOS ARM64 server compiler contract'
