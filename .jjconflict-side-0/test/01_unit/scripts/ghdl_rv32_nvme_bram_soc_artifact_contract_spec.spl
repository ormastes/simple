extern fn rt_file_read_text(path: text) -> text
use std.spec.{describe, it, expect}

fn source() -> text:
    rt_file_read_text("scripts/fpga/ghdl_rv32_nvme_bram_soc.shs") ?? ""

describe "RV32 NVMe BRAM GHDL artifact contract":
    it "separates clean and garbage runs while retaining the legacy log":
        val script = source()
        expect(script).to_contain("RUN_NAME=clean")
        expect(script).to_contain("RUN_NAME=garbage")
        expect(script).to_contain("DEFAULT_WORK_DIR=\"$WORK_DIR/$RUN_NAME\"")
        expect(script).to_contain("build/test-artifacts/nvme_rv32_bram_soc/$RUN_NAME")
        expect(script).to_contain("cp \"$LOG\" \"$LEGACY_LOG\"")

    it "persists the image and tool output for each run":
        val script = source()
        expect(script).to_contain("cp \"$WORK_DIR/fw.bin\" \"$EVIDENCE_DIR/fw.bin\"")
        expect(script).to_contain("cp \"$WORK_DIR/rv32_flat.mem\" \"$EVIDENCE_DIR/rv32_flat.mem\"")
        expect(script).to_contain("cp \"$WORK_DIR/rv32_ramdisk.mem\" \"$EVIDENCE_DIR/rv32_ramdisk.mem\"")
        expect(script).to_contain("cp \"$WORK_DIR/analyse.log\" \"$EVIDENCE_DIR/analyse.log\"")
        expect(script).to_contain("cp \"$WORK_DIR/elaborate.log\" \"$EVIDENCE_DIR/elaborate.log\"")
        expect(script).to_contain("cp \"$LOG\" \"$EVIDENCE_DIR/sim.log\"")
