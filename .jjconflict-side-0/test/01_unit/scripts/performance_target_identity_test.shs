#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname "$0")/../../.." && pwd -P)
CHECKER="$ROOT/scripts/check/check-performance-target-identity.shs"
work=$(mktemp -d); trap 'rm -rf "$work"' EXIT INT TERM
run_id=benchmark-run-001
cat >"$work/target.env" <<EOF
evidence_schema=simple.must-check-target/v1
gate_id=rust-go-benchmark-parity
run_id=$run_id
target_kind=native-host
target_id=fixture-host
final_verdict=PASS
EOF
cat >"$work/environment.env" <<EOF
environment_schema=simple.rust-go-benchmark-environment/v1
gate_id=rust-go-benchmark-parity
source_fingerprint=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
run_id=$run_id
fixture_id=runtime-fed-lcg-100k
host_id=fixture-host
os=linux
kernel=fixture-kernel
arch=x86_64
cpu_model_sha256=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
cpu_count=4
cpu_governor=performance
cpuset_sha256=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
isolation=offline-controlled
clock_tool_sha256=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
simple_compiler_path=/fixture/bin/release/x86_64/simple
simple_compiler_sha256=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
simple_executable_sha256=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
rust_executable_sha256=dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd
go_executable_sha256=eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee
warmup_iterations=10
runtime_order=simple,rust,go
final_verdict=PASS
EOF
run() { sh "$CHECKER" --gate rust-go-benchmark-parity --run-id "$run_id" --target "$1" --environment "$2"; }
run "$work/target.env" "$work/environment.env" | grep -q '^STATUS: PASS '
sed 's/target_kind=native-host/target_kind=container-host/' "$work/target.env" >"$work/target.kind"
run "$work/target.kind" "$work/environment.env" >/dev/null 2>&1 && { echo 'FAIL: non-native benchmark target accepted' >&2; exit 1; }
sed 's/target_id=fixture-host/target_id=other-host/' "$work/target.env" >"$work/target.other"
run "$work/target.other" "$work/environment.env" >/dev/null 2>&1 && { echo 'FAIL: target/environment host mismatch accepted' >&2; exit 1; }
sed 's/host_id=fixture-host/host_id=other-host/' "$work/environment.env" >"$work/environment.other"
run "$work/target.env" "$work/environment.other" >/dev/null 2>&1 && { echo 'FAIL: environment/target host mismatch accepted' >&2; exit 1; }
sed 's/os=linux/os=darwin/' "$work/environment.env" >"$work/environment.os"
run "$work/target.env" "$work/environment.os" >/dev/null 2>&1 && { echo 'FAIL: non-Linux benchmark environment accepted' >&2; exit 1; }
echo 'PASS: performance target identity is bound to benchmark environment'
