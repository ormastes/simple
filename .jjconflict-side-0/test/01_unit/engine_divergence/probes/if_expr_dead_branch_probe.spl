fn make() -> [text]:
    return ["a", "b", "c"]

fn main():
    val flag = false
    val objs = if flag:
        []
    else:
        make()
    print("I1_len=" + objs.len().to_string())

    val flag2 = true
    val o2 = if flag2:
        make()
    else:
        []
    print("I2_len=" + o2.len().to_string())

    var acc: [text] = []
    val o3 = if flag:
        acc
    else:
        make()
    print("I3_len=" + o3.len().to_string())

main()
