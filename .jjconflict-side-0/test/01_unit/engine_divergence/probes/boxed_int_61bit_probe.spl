fn ident(x: i64) -> i64:
    return x

fn main():
    var a: i64 = 1152921504606846976
    print("P1=" + a.to_string())
    print("P2=" + ident(a).to_string())
    var b: i64 = 4611686018427387903
    print("P3=" + b.to_string())
    print("P4=" + ident(b).to_string())
    var arr = [a, b]
    print("P5=" + arr[0].to_string())
    print("P6=" + arr[1].to_string())

main()
