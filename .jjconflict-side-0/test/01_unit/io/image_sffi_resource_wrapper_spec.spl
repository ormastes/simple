"""
Resource wrapper for Image — WP-J acceptance

Tests the new Image wrapper class with resource ownership pattern:
- Sentinel-based validity checks
- Consuming close() method
- Double-close guard (one-shot safety)
- Backward compatibility with deprecated ImageData aliases
"""

use std.spec
use std.nogc_sync_mut.io.image_sffi.{Image, load_image_resource, ImageData, load_image, free_image}

describe "Image resource wrapper":
    it "Image.is_valid checks sentinel":
        val img = Image(handle: 42, width: 100, height: 100, channels: 4)
        assert_true(img.is_valid())

    it "Image.is_valid detects invalid sentinel (0)":
        val img = Image(handle: 0, width: 100, height: 100, channels: 4)
        assert_false(img.is_valid())

    it "Image sentinel is 0 not -1":
        val img_zero = Image(handle: 0, width: 100, height: 100, channels: 4)
        assert_false(img_zero.is_valid())
        val img_neg = Image(handle: -1, width: 100, height: 100, channels: 4)
        assert_true(img_neg.is_valid())

    # `close()` calls the REAL `rt_image_free` C extern. `Image(handle: 42,
    # ...)` is a fabricated pointer that was never returned by
    # `rt_image_load` -- calling the real free on it is undefined behavior,
    # not a guard-logic test. This crashed the original version of this spec
    # (`error: test-runner: spec failed` partway through the file). The
    # guard's actual behavior -- `if self.handle != 0: free(); handle = 0` --
    # is proven safely below using the invalid sentinel (0), which the guard
    # skips before ever reaching the extern call. Testing double-close on a
    # genuinely-acquired handle needs a real decodable image fixture and is
    # left as a follow-up:
    # doc/08_tracking/bug/image_wrapper_close_needs_live_handle_fixture_2026-08-07.md

    it "close on invalid handle is safe":
        val img = Image(handle: 0, width: 100, height: 100, channels: 4)
        img.close()
        assert_equal(img.handle, 0)
        img.close()
        assert_equal(img.handle, 0)

    it "pixel_count calculates correctly":
        val img = Image(handle: 42, width: 10, height: 20, channels: 4)
        assert_equal(img.pixel_count(), 200)

    it "size_bytes accounts for channels":
        val img = Image(handle: 42, width: 10, height: 20, channels: 4)
        assert_equal(img.size_bytes(), 800)

    it "get_pixel returns 0 for invalid handle":
        val img = Image(handle: 0, width: 10, height: 20, channels: 4)
        assert_equal(img.get_pixel(5, 5), 0)

    it "ImageData (deprecated) still exists":
        val img = ImageData(handle: 42, width: 100, height: 100, channels: 4)
        assert_true(img.is_valid())

    it "load_image (deprecated) still works":
        val result = load_image("/nonexistent/path")
        assert_nil(result)
