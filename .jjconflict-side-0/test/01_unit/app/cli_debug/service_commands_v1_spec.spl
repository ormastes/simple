use std.spec.{describe, it, expect}
use std.common.debug.contracts_v1.{DebugSessionId}
use app.cli_debug.service_commands_v1.{
    DebugServiceCommandConfigV1,
    debug_service_command_config_v1,
    resolve_debug_service_command_v1,
}

fn supported_config() -> DebugServiceCommandConfigV1:
    debug_service_command_config_v1(
        "request-1",
        DebugSessionId(value: "debug-1"),
        "build-sha256-abc",
        ["doctor", "inspect", "probe.apply", "probe.remove", "probe.list", "reproduce", "replay"],
    )

describe "DebugServiceV1 minimal CLI commands":
    it "parses and dispatches doctor without requiring a session":
        val config = debug_service_command_config_v1(
            "request-doctor",
            DebugSessionId(value: ""),
            "build-sha256-abc",
            ["doctor"],
        )
        match resolve_debug_service_command_v1(["doctor", "device.sdn"], config):
            case Err(reason): expect(reason).to_equal("")
            case Ok(wire):
                expect(wire.command).to_equal("doctor")
                expect(wire.operation).to_equal("observe")
                expect(wire.payload).to_equal("device.sdn")

    it "maps inspect, reproduce, and replay to typed evidence requests":
        match resolve_debug_service_command_v1(["inspect", "bundle-a"], supported_config()):
            case Err(reason): expect(reason).to_equal("")
            case Ok(wire):
                expect(wire.command).to_equal("inspect")
                expect(wire.operation).to_equal("evidence")
                expect(wire.payload).to_equal("bundle-a")
        match resolve_debug_service_command_v1(["reproduce", "bundle-a"], supported_config()):
            case Err(reason): expect(reason).to_equal("")
            case Ok(wire): expect(wire.command).to_equal("reproduce")
        match resolve_debug_service_command_v1(["replay", "bundle-a"], supported_config()):
            case Err(reason): expect(reason).to_equal("")
            case Ok(wire): expect(wire.command).to_equal("replay")

    it "maps every probe lifecycle command without collapsing its action":
        match resolve_debug_service_command_v1(["probe", "apply", "probe.sdn"], supported_config()):
            case Err(reason): expect(reason).to_equal("")
            case Ok(wire): expect(wire.command).to_equal("probe.apply")
        match resolve_debug_service_command_v1(["probe", "remove", "probe.sdn"], supported_config()):
            case Err(reason): expect(reason).to_equal("")
            case Ok(wire): expect(wire.command).to_equal("probe.remove")
        match resolve_debug_service_command_v1(["probe", "list", "probe.sdn"], supported_config()):
            case Err(reason): expect(reason).to_equal("")
            case Ok(wire): expect(wire.command).to_equal("probe.list")

    it "fails closed for unknown commands, malformed shapes, and unsupported actions":
        match resolve_debug_service_command_v1(["attach", "123"], supported_config()):
            case Ok(_): expect("accepted").to_equal("rejected")
            case Err(reason): expect(reason).to_contain("unsupported debug command")
        match resolve_debug_service_command_v1(["inspect"], supported_config()):
            case Ok(_): expect("accepted").to_equal("rejected")
            case Err(reason): expect(reason).to_contain("usage: inspect <bundle>")
        match resolve_debug_service_command_v1(["probe", "mutate", "probe.sdn"], supported_config()):
            case Ok(_): expect("accepted").to_equal("rejected")
            case Err(reason): expect(reason).to_contain("unsupported debug probe action")

    it "fails closed when service support, build identity, or session identity is absent":
        val unsupported = debug_service_command_config_v1(
            "request-2", DebugSessionId(value: "debug-1"), "build-sha256-abc", ["doctor"])
        match resolve_debug_service_command_v1(["inspect", "bundle-a"], unsupported):
            case Ok(_): expect("accepted").to_equal("rejected")
            case Err(reason): expect(reason).to_contain("unsupported by configured service")

        val no_build = debug_service_command_config_v1(
            "request-3", DebugSessionId(value: "debug-1"), "", ["inspect"])
        match resolve_debug_service_command_v1(["inspect", "bundle-a"], no_build):
            case Ok(_): expect("accepted").to_equal("rejected")
            case Err(reason): expect(reason).to_contain("exact build id")

        val no_session = debug_service_command_config_v1(
            "request-4", DebugSessionId(value: ""), "build-sha256-abc", ["replay"])
        match resolve_debug_service_command_v1(["replay", "bundle-a"], no_session):
            case Ok(_): expect("accepted").to_equal("rejected")
            case Err(reason): expect(reason).to_contain("DebugSessionId")
