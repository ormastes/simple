use std.spec.{describe, it, expect}
use app.spipe_knowledge_provider.protocol.{provider_parse_frame, provider_encode_frame}
use app.spipe_knowledge_provider.service.{SpipeProviderServiceV1}
use app.spipe_knowledge_provider.wire.{ProviderWireOwnedDispatchV1, ProviderHostBindingV1, provider_dispatch_payload_bound_owned, provider_dispatch_frame_bound_owned}
use std.common.json.parser.{json_parse_with_error}
use std.common.json.object_ops.{json_object_get, json_object_keys}
use std.common.json.types.{json_to_string, json_to_number, json_get_type}

fn composition_payload(request_id: text) -> text:
    "{\"client\":\"spipe\",\"limits\":{\"max_frame_bytes\":1048576},\"operation\":\"initialize\",\"protocol\":{\"major\":1,\"minor\":0},\"request_id\":\"" + request_id + "\",\"required\":{\"analyzer\":\"spipe-unicode-lex-v1\",\"explanation\":\"bm25-explain-v1\",\"logical_index\":\"spipe-lexical-snapshot-v1\",\"provider\":\"spipe-search-provider/1.0\",\"score\":\"bm25-fixed-v1\"}" + "}"

fn compose_public_stages(service: SpipeProviderServiceV1,
                         payload: text) -> ProviderWireOwnedDispatchV1:
    val host = ProviderHostBindingV1.create("WS-PROVIDER",
        "spks1-" + "0" * 64, "sha256:" + "1" * 64).unwrap()
    provider_dispatch_payload_bound_owned(service, host, payload)

fn compose_with_retained_parsed_root(service: SpipeProviderServiceV1,
                                     payload: text) -> ProviderWireOwnedDispatchV1:
    val parsed = json_parse_with_error(payload)
    val retained_request = json_to_string(json_object_get(parsed.0, "request_id")) ?? ""
    val host = ProviderHostBindingV1.create("WS-PROVIDER",
        "spks1-" + "0" * 64, "sha256:" + "1" * 64).unwrap()
    if retained_request == "":
        return provider_dispatch_payload_bound_owned(service, host, "")
    provider_dispatch_payload_bound_owned(service, host, payload)

fn assert_composed(result: ProviderWireOwnedDispatchV1, request_id: text):
    expect(result.service.state.initialized).to_equal(true)
    expect(result.service.state.workspace).to_equal("WS-PROVIDER")
    expect(result.service.state.snapshot_id).to_equal("spks1-" + "0" * 64)
    expect(result.service.state.scope_digest).to_equal("sha256:" + "1" * 64)
    expect(result.service.state.logical_root).to_equal("sha256:" + "0" * 64)
    expect(result.service.state.provider_generation).to_equal(1)
    expect(provider_parse_frame(result.outcome.frame).payload).to_contain(
        "\"request_id\":\"" + request_id + "\"")

describe "SPipe initialize stage composition":
    it "decodes every closed initialize field before canonicalization":
        val payload = composition_payload("decode-fields")
        val parsed = json_parse_with_error(payload)
        expect(parsed.1).to_equal("")
        expect(json_get_type(parsed.0)).to_equal("object")
        expect(json_object_keys(parsed.0).len()).to_equal(6)
        expect(json_to_string(json_object_get(parsed.0, "client")) ?? "").to_equal("spipe")
        expect(json_to_string(json_object_get(parsed.0, "operation")) ?? "").to_equal("initialize")
        expect(json_to_string(json_object_get(parsed.0, "request_id")) ?? "").to_equal("decode-fields")
        val limits = json_object_get(parsed.0, "limits")
        expect(json_object_keys(limits).len()).to_equal(1)
        expect((json_to_number(json_object_get(limits, "max_frame_bytes")) ?? -1.0) as i64).to_equal(1048576)
        val required = json_object_get(parsed.0, "required")
        expect(json_object_keys(required).len()).to_equal(5)
        expect(json_to_string(json_object_get(required, "provider")) ?? "").to_equal("spipe-search-provider/1.0")
        expect(json_to_string(json_object_get(required, "analyzer")) ?? "").to_equal("spipe-unicode-lex-v1")
        expect(json_to_string(json_object_get(required, "score")) ?? "").to_equal("bm25-fixed-v1")
        expect(json_to_string(json_object_get(required, "explanation")) ?? "").to_equal("bm25-explain-v1")
        expect(json_to_string(json_object_get(required, "logical_index")) ?? "").to_equal("spipe-lexical-snapshot-v1")

    it "preserves binding through the public owned dispatch boundary":
        assert_composed(compose_public_stages(SpipeProviderServiceV1.empty(),
            composition_payload("compose-public")), "compose-public")

    it "preserves binding while the parsed JSON root remains live":
        assert_composed(compose_with_retained_parsed_root(
            SpipeProviderServiceV1.empty(), composition_payload("compose-root")),
            "compose-root")

    it "preserves binding when entered through frame decoding":
        val frame = provider_encode_frame(composition_payload("compose-frame")).unwrap()
        val host = ProviderHostBindingV1.create("WS-PROVIDER",
            "spks1-" + "0" * 64, "sha256:" + "1" * 64).unwrap()
        assert_composed(provider_dispatch_frame_bound_owned(
            SpipeProviderServiceV1.empty(), host, frame), "compose-frame")
