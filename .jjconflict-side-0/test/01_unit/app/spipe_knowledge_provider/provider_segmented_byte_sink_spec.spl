use std.spec.{describe, it, expect}
use app.spipe_knowledge_provider.segmented_byte_sink.ProviderSegmentedByteSinkV1
use app.spipe_knowledge_provider.work_control.{ProviderBudgetLimitV1, ProviderBoundedBudgetV1, provider_budget_category_output_bytes, provider_budget_category_logical_allocations}

fn sink_budget(output_bytes: i64, allocations: i64) -> ProviderBoundedBudgetV1:
    ProviderBoundedBudgetV1.configured([
        ProviderBudgetLimitV1(
            category: provider_budget_category_output_bytes(),
            limit: output_bytes),
        ProviderBudgetLimitV1(
            category: provider_budget_category_logical_allocations(),
            limit: allocations),
    ]).unwrap()

describe "SPipe provider segmented byte sink":
    it "rejects nonpositive and inverted sink limits":
        expect(ProviderSegmentedByteSinkV1.configured(0, 8)).to_equal(
            Err("invalid_sink_limits"))
        expect(ProviderSegmentedByteSinkV1.configured(4, 0)).to_equal(
            Err("invalid_sink_limits"))
        expect(ProviderSegmentedByteSinkV1.configured(9, 8)).to_equal(
            Err("invalid_sink_limits"))

    it "copies checked ranges into bounded segments and charges exact work":
        var budget = sink_budget(6, 2)
        var sink = ProviderSegmentedByteSinkV1.configured(3, 6).unwrap()
        expect(sink.append([9u8, 1u8, 2u8, 3u8, 4u8, 8u8], 1, 4,
            budget)).to_equal(Ok(()))
        expect(sink.total_bytes()).to_equal(4)
        expect(budget.consumed(provider_budget_category_output_bytes())).to_equal(4)
        expect(budget.consumed(
            provider_budget_category_logical_allocations())).to_equal(2)
        val owned = sink.take()
        expect(owned.total_bytes).to_equal(4)
        expect(owned.segments).to_equal([[1u8, 2u8, 3u8], [4u8]])

    it "preflights byte and allocation budgets before changing the sink":
        var output_limited = sink_budget(2, 2)
        var sink = ProviderSegmentedByteSinkV1.configured(2, 8).unwrap()
        expect(sink.append([1u8, 2u8, 3u8], 0, 3,
            output_limited)).to_equal(Err("limit_exceeded"))
        expect(sink.total_bytes()).to_equal(0)
        expect(output_limited.consumed(
            provider_budget_category_output_bytes())).to_equal(0)

        var allocation_limited = sink_budget(8, 1)
        expect(sink.append([1u8, 2u8, 3u8], 0, 3,
            allocation_limited)).to_equal(Err("limit_exceeded"))
        expect(sink.total_bytes()).to_equal(0)
        expect(allocation_limited.consumed(
            provider_budget_category_output_bytes())).to_equal(0)

    it "rejects invalid ranges and checked total overflow without charging":
        var budget = sink_budget(10, 10)
        var sink = ProviderSegmentedByteSinkV1.configured(2, 3).unwrap()
        expect(sink.append([1u8], -1, 1, budget)).to_equal(
            Err("invalid_input"))
        expect(sink.append([1u8], 1, 1, budget)).to_equal(
            Err("invalid_input"))
        expect(sink.append([1u8, 2u8], 0, 2, budget)).to_equal(Ok(()))
        expect(sink.append([3u8, 4u8], 0, 2, budget)).to_equal(
            Err("limit_exceeded"))
        expect(sink.total_bytes()).to_equal(2)
        expect(budget.consumed(provider_budget_category_output_bytes())).to_equal(2)

    it "take transfers all segments and leaves no producer alias":
        var budget = sink_budget(8, 4)
        var sink = ProviderSegmentedByteSinkV1.configured(2, 8).unwrap()
        expect(sink.append([1u8, 2u8, 3u8], 0, 3, budget)).to_equal(Ok(()))
        val first = sink.take()
        expect(sink.total_bytes()).to_equal(0)
        expect(sink.append([9u8], 0, 1, budget)).to_equal(Ok(()))
        val second = sink.take()
        expect(first.segments).to_equal([[1u8, 2u8], [3u8]])
        expect(second.segments).to_equal([[9u8]])
