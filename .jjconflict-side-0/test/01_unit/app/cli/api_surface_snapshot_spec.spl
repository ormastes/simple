"""Byte and collection contracts for the API-surface snapshot tool."""

use std.spec
use app.cli.api_surface_snapshot.{SnapshotEntry, SnapshotResult,
    collect_exports_from_file, emit_sdn}

describe "API surface snapshot":
    it "collects ordered nonempty export spans":
        val entries = collect_exports_from_file(
            "test/fixtures/app/cli/api_surface_snapshot_exports.spl",
            "fixture/module.spl")

        expect(entries.len()).to_equal(5)
        expect(entries[0].symbol_name).to_equal("Alpha")
        expect(entries[1].symbol_name).to_equal("beta.Gamma")
        expect(entries[2].symbol_name).to_equal("Delta")
        expect(entries[3].symbol_name).to_equal("EmptyIgnored")
        expect(entries[4].symbol_name).to_equal("Zeta")
        for entry in entries:
            expect(entry.module_key).to_equal("fixture/module.spl")

    it "emits an empty snapshot with the exact header":
        val result = SnapshotResult {
            entries: [], module_count: 0, symbol_count: 0,
        }
        expect(emit_sdn(result)).to_equal(
            "[api_surface]\n" +
            "generated_by = api_surface_snapshot.spl\n" +
            "module_count = 0\n" +
            "symbol_count = 0\n")

    it "preserves ordered entries with one boundary per module":
        val result = SnapshotResult {
            entries: [
                SnapshotEntry { module_key: "src/a/__init__.spl", symbol_name: "Alpha" },
                SnapshotEntry { module_key: "src/a/__init__.spl", symbol_name: "zeta" },
                SnapshotEntry { module_key: "src/b/public.spl", symbol_name: "Beta" },
            ],
            module_count: 2,
            symbol_count: 3,
        }
        expect(emit_sdn(result)).to_equal(
            "[api_surface]\n" +
            "generated_by = api_surface_snapshot.spl\n" +
            "module_count = 2\n" +
            "symbol_count = 3\n" +
            "\n[module]\n" +
            "path = src/a/__init__.spl\n" +
            "symbol = Alpha\n" +
            "symbol = zeta\n" +
            "\n[module]\n" +
            "path = src/b/public.spl\n" +
            "symbol = Beta\n")
