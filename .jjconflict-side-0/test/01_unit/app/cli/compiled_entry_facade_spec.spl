use std.test.{describe, it, expect}
use std.io_runtime.{read_file}

describe "compiled CLI entry facade":
    it "exports the live _CliMain modules instead of deleted split modules":
        val source = read_file("src/app/cli/main.spl")
        expect(source.contains("app.cli._CliMain.main_and_help.*")).to_equal(true)
        expect(source.contains("app.cli._CliMain.args_and_os_commands.*")).to_equal(true)
        expect(source.contains("app.cli.main_part1.*")).to_equal(false)
        expect(source.contains("app.cli.main_part2.*")).to_equal(false)
