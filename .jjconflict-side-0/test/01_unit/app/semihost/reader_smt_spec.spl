# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use app.semihost.reader.{smt_json_id_end}


describe "semihost SMT JSON loading":
    # @manual scenario evidence
    it "rejects malformed string ids before integer parsing":
        # @req REQ-SSPEC-APP
        step("rejects malformed string ids before integer parsing")
        expect(smt_json_id_end("x", 0)).to_equal(-1)

    it "returns the end offset for numeric string ids":
        # @req REQ-SSPEC-APP
        step("returns the end offset for numeric string ids")
        expect(smt_json_id_end("123,", 0)).to_equal(3)
