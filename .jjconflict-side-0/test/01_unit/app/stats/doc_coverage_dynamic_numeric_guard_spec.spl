# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md





use std.spec.step

extern fn rt_file_read_text(path: text) -> text?

describe "doc coverage dynamic stats numeric guard":
    # @manual scenario evidence
    it "guards shell count parsing with a fallback helper":
        # @req REQ-SSPEC-APP
        step("guards shell count parsing with a fallback helper")
        val source = rt_file_read_text("src/app/stats/doc_coverage_dynamic.spl") ?? ""

        expect(source).to_contain("fn dc_parse_count(output: text) -> i64:")
        expect(source).to_contain("output.to_int() ?? 0")
        expect(source).to_contain("dc_parse_count(dc_run_cmd(cmd))")
        assert_false(source.contains("dc_run_cmd(cmd).to_int()"))
