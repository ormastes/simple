# Purpose and audience: executable specification evidence for the SPipe S1-D
# diagnostics registry (single SPK code -> meaning source of truth).
# @req REQ-SPKC-039
# plan: doc/03_plan/infra/spipe/spipe_knowledge_compiler_refined_plan.md (S1-D)

"""SPipe diagnostics registry

Proves the on-disk `registry.sdn` loads cleanly with zero problems, and that
the registry loader's invariants -- no duplicate codes, no code outside the
reserved-legacy or free-new-code ranges, no used-but-unregistered code --
actually reject malformed registries rather than silently accepting them.
The real shipped `src/app/spipe/diagnostics/registry.sdn` carries every
legacy JS SPK code (§2.1 of the plan) as a reserved row plus S1-D's own
admission codes (SPK530-535); this spec is the fail-closed guard that keeps
new collisions like the SPK704/901/902 ones the plan documents from
recurring.
"""

use std.spec.*
use app.spipe.diagnostics.registry.{
    load_registry, parse_registry_source, validate_registry,
    find_duplicate_codes, find_out_of_range_codes,
    find_unregistered_used_codes, code_number, in_free_new_range,
}
use app.spipe.admission.verdict.{admission_diagnostic_codes}

val REGISTRY_PATH = "src/app/spipe/diagnostics/registry.sdn"

describe "SPipe diagnostics registry":
    it "loads the shipped registry with zero validation problems":
        step("Load src/app/spipe/diagnostics/registry.sdn")
        match load_registry(REGISTRY_PATH):
            case Ok(rows):
                step("Validate every row: no duplicates, no out-of-range codes")
                val problems = validate_registry(rows)
                expect(problems.len()).to_equal(0)
                expect(rows.len() > 0).to_be(true)
            case Err(msg):
                expect(msg).to_equal("")

    it "carries every legacy JS SPK code as a reserved row (SPK704 sample)":
        step("Load the shipped registry and find the SPK704 row")
        match load_registry(REGISTRY_PATH):
            case Ok(rows):
                var found = false
                for row in rows:
                    if row.code == "SPK704":
                        found = true
                        expect(row.reserved).to_be(true)
                        expect(row.owner).to_equal("legacy_js")
                expect(found).to_be(true)
            case Err(msg):
                expect(msg).to_equal("")

    it "registers every admission code S1-D can emit":
        step("Cross-check admission_diagnostic_codes() against the registry")
        match load_registry(REGISTRY_PATH):
            case Ok(rows):
                val unregistered = find_unregistered_used_codes(rows, admission_diagnostic_codes())
                expect(unregistered.len()).to_equal(0)
            case Err(msg):
                expect(msg).to_equal("")

    it "REJECTS a registry with a duplicated code":
        step("Load the duplicate-code fixture")
        match load_registry("test/fixture/spipe/registry/duplicate_code.sdn"):
            case Ok(rows):
                val dups = find_duplicate_codes(rows)
                expect(dups.len()).to_equal(1)
                expect(dups[0]).to_equal("SPK530")
                val problems = validate_registry(rows)
                expect(problems.len() > 0).to_be(true)
            case Err(msg):
                expect(msg).to_equal("")

    it "REJECTS a registry with a code outside every free range":
        step("Load the out-of-range fixture")
        match load_registry("test/fixture/spipe/registry/out_of_range_code.sdn"):
            case Ok(rows):
                val bad = find_out_of_range_codes(rows)
                expect(bad.len()).to_equal(1)
                expect(bad[0]).to_equal("SPK999")
            case Err(msg):
                expect(msg).to_equal("")

    it "accepts a minimal clean registry (reserved legacy + one admission code)":
        step("Load the clean-minimal fixture")
        match load_registry("test/fixture/spipe/registry/clean_minimal.sdn"):
            case Ok(rows):
                expect(validate_registry(rows).len()).to_equal(0)
            case Err(msg):
                expect(msg).to_equal("")

    it "classifies code numbers into the reserved SPK110-129/510-529/530-549 free ranges":
        step("Check in_free_new_range for boundary and out-of-range values")
        expect(in_free_new_range(110)).to_be(true)
        expect(in_free_new_range(129)).to_be(true)
        expect(in_free_new_range(109)).to_be(false)
        expect(in_free_new_range(130)).to_be(false)
        expect(in_free_new_range(510)).to_be(true)
        expect(in_free_new_range(529)).to_be(true)
        expect(in_free_new_range(530)).to_be(true)
        expect(in_free_new_range(549)).to_be(true)
        expect(in_free_new_range(550)).to_be(false)
        expect(in_free_new_range(704)).to_be(false)

    it "parses the numeric part of an SPKnnn code, rejecting malformed codes":
        step("Check code_number on well-formed and malformed codes")
        expect(code_number("SPK110")).to_equal(110)
        expect(code_number("SPK001")).to_equal(1)
        expect(code_number("NOTSPK1")).to_equal(-1)
        expect(code_number("SPK")).to_equal(-1)
