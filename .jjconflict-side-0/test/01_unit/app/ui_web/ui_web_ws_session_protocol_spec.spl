use std.spec.*
use app.ui.web.ui_session.{
    UI_WS_PROTOCOL_VERSION,
    ui_ws_diff,
    ui_ws_encode_hello,
    ui_ws_encode_snapshot,
    ui_ws_encode_diff,
    ui_ws_encode_error,
    ui_ws_decode_client,
    ui_ws_session_open,
    ui_ws_session_advance,
    ui_ws_session_resume,
    ui_ws_session_reset_baseline,
    ui_ws_session_find,
    ui_ws_session_put,
    ui_ws_session_close
}
use common.ui.access.{UiAccessNode, UiAccessSnapshot}

fn node(id: text, value: text) -> UiAccessNode:
    UiAccessNode(
        canonical_id: id,
        surface_id: "calc",
        widget_id: id,
        kind: "button",
        visible: true,
        focused: false,
        enabled: true,
        selected: false,
        text_value: value,
        props: [],
        child_ids: [],
        action_names: ["click"]
    )

fn snap(rev: i64, nodes: [UiAccessNode]) -> UiAccessSnapshot:
    UiAccessSnapshot(
        protocol_version: 1,
        snapshot_revision: rev,
        mode: "web",
        active_surface: "calc",
        surfaces: [],
        nodes: nodes,
        recent_events: []
    )

describe "ui.web hosted session wire protocol":

    it "versions every server frame and tags the session":
        val frame = ui_ws_encode_hello("sid-1", "tok-1", -1)
        expect(frame.contains("\"v\":1")).to_be(true)
        expect(frame.contains("\"t\":\"hello\"")).to_be(true)
        expect(frame.contains("\"sid\":\"sid-1\"")).to_be(true)
        expect(frame.contains("\"resume_token\":\"tok-1\"")).to_be(true)
        expect(UI_WS_PROTOCOL_VERSION).to_be(1)

    it "embeds the access snapshot encoding rather than a second one":
        val frame = ui_ws_encode_snapshot("sid-1", snap(7, [node("calc#a", "1")]))
        expect(frame.contains("\"t\":\"snapshot\"")).to_be(true)
        expect(frame.contains("\"rev\":7")).to_be(true)
        expect(frame.contains("\"snapshot_revision\":7")).to_be(true)
        expect(frame.contains("\"canonical_id\":\"calc#a\"")).to_be(true)

    it "diffs by canonical id: changed, added and removed":
        val before = snap(1, [node("calc#a", "1"), node("calc#b", "2")])
        val after = snap(2, [node("calc#a", "9"), node("calc#c", "3")])
        val d = ui_ws_diff(before, after)
        expect(d.from_revision).to_be(1)
        expect(d.to_revision).to_be(2)
        expect(d.changed.len()).to_be(2)
        expect(d.removed.len()).to_be(1)
        expect(d.removed[0]).to_be("calc#b")

    it "emits no changed nodes when nothing moved":
        val a = snap(1, [node("calc#a", "1")])
        val b = snap(2, [node("calc#a", "1")])
        val d = ui_ws_diff(a, b)
        expect(d.changed.len()).to_be(0)
        expect(d.removed.len()).to_be(0)

    it "correlates a diff frame to the revision the client must hold":
        val d = ui_ws_diff(snap(4, [node("calc#a", "1")]), snap(5, [node("calc#a", "2")]))
        val frame = ui_ws_encode_diff("sid-1", d)
        expect(frame.contains("\"t\":\"diff\"")).to_be(true)
        expect(frame.contains("\"rev\":5")).to_be(true)
        expect(frame.contains("\"from\":4")).to_be(true)
        expect(frame.contains("\"removed\":[]")).to_be(true)

    it "encodes errors as stable codes":
        val frame = ui_ws_encode_error("sid-1", "invalid_resume_token", "")
        expect(frame.contains("\"t\":\"error\"")).to_be(true)
        expect(frame.contains("\"code\":\"invalid_resume_token\"")).to_be(true)

describe "ui.web client frame decoding":

    it "accepts a well-formed input frame":
        val m = ui_ws_decode_client("{\"v\":1,\"t\":\"input\",\"id\":\"calc#btn_save\",\"action\":\"click\",\"seq\":12,\"rev\":5}")
        expect(m.ok).to_be(true)
        expect(m.kind).to_be("input")
        expect(m.canonical_id).to_be("calc#btn_save")
        expect(m.action).to_be("click")
        expect(m.client_seq).to_be(12)
        expect(m.since_revision).to_be(5)

    it "accepts a resume frame carrying its token":
        val m = ui_ws_decode_client("{\"v\":1,\"t\":\"resume\",\"resume_token\":\"bearer-abc\",\"rev\":5}")
        expect(m.ok).to_be(true)
        expect(m.kind).to_be("resume")
        expect(m.resume_token).to_be("bearer-abc")

    it "fails closed on version, type, and missing fields":
        expect(ui_ws_decode_client("{\"v\":2,\"t\":\"input\",\"id\":\"a\",\"action\":\"click\"}").error).to_be("unsupported_protocol_version")
        expect(ui_ws_decode_client("{\"v\":1,\"t\":\"snapshot\"}").error).to_be("unsupported_message_type")
        expect(ui_ws_decode_client("{\"v\":1,\"t\":\"input\",\"action\":\"click\"}").error).to_be("missing_target")
        expect(ui_ws_decode_client("{\"v\":1,\"t\":\"input\",\"id\":\"a\"}").error).to_be("missing_action")
        expect(ui_ws_decode_client("{\"v\":1,\"t\":\"resume\"}").error).to_be("missing_resume_token")
        expect(ui_ws_decode_client("not json at all").ok).to_be(false)

describe "ui.web per-session host state":

    it "sends a full snapshot first and a diff thereafter":
        val s0 = ui_ws_session_open("sid-1", "grant-a", "https://localhost", "bearer-1")
        expect(s0.revision).to_be(-1)
        val first = ui_ws_session_advance(s0, snap(1, [node("calc#a", "1")]))
        expect(first.1.contains("\"t\":\"snapshot\"")).to_be(true)
        expect(first.0.revision).to_be(1)
        val second = ui_ws_session_advance(first.0, snap(2, [node("calc#a", "2")]))
        expect(second.1.contains("\"t\":\"diff\"")).to_be(true)
        expect(second.1.contains("\"from\":1")).to_be(true)
        expect(second.0.revision).to_be(2)

    it "keeps two concurrent sessions on independent revision baselines":
        val a0 = ui_ws_session_open("sid-a", "grant-a", "https://localhost", "bearer-a")
        val b0 = ui_ws_session_open("sid-b", "grant-b", "https://localhost", "bearer-b")
        val a1 = ui_ws_session_advance(a0, snap(1, [node("calc#a", "1")]))
        val a2 = ui_ws_session_advance(a1.0, snap(2, [node("calc#a", "2")]))
        expect(a2.0.revision).to_be(2)
        # b never advanced, so it is still un-baselined and gets a full snapshot
        expect(b0.revision).to_be(-1)
        val b1 = ui_ws_session_advance(b0, snap(2, [node("calc#a", "2")]))
        expect(b1.1.contains("\"t\":\"snapshot\"")).to_be(true)
        expect(b1.1.contains("\"sid\":\"sid-b\"")).to_be(true)
        expect(a2.1.contains("\"sid\":\"sid-a\"")).to_be(true)

    it "resumes only on this session's own token and origin":
        val s = ui_ws_session_open("sid-1", "grant-a", "https://localhost", "bearer-1")
        expect(ui_ws_session_resume(s, "bearer-1", "https://localhost").0).to_be(true)
        expect(ui_ws_session_resume(s, "bearer-2", "https://localhost").1).to_be("invalid_resume_token")
        expect(ui_ws_session_resume(s, "bearer-1", "https://evil.test").1).to_be("origin_mismatch")

    it "re-sends a full snapshot after a baseline reset":
        val s = ui_ws_session_open("sid-1", "grant-a", "https://localhost", "bearer-1")
        val first = ui_ws_session_advance(s, snap(1, [node("calc#a", "1")]))
        val reset = ui_ws_session_reset_baseline(first.0)
        expect(reset.revision).to_be(-1)
        val again = ui_ws_session_advance(reset, snap(3, [node("calc#a", "1")]))
        expect(again.1.contains("\"t\":\"snapshot\"")).to_be(true)
        expect(again.0.revision).to_be(3)

    it "stores sessions by unique id":
        val a = ui_ws_session_open("sid-a", "g", "o", "t")
        val b = ui_ws_session_open("sid-b", "g", "o", "t")
        var store = ui_ws_session_put(ui_ws_session_put([], a), b)
        expect(store.len()).to_be(2)
        store = ui_ws_session_put(store, ui_ws_session_open("sid-a", "g2", "o", "t"))
        expect(store.len()).to_be(2)
        val found = ui_ws_session_find(store, "sid-a")
        expect(found != nil).to_be(true)
        store = ui_ws_session_close(store, "sid-a")
        expect(store.len()).to_be(1)
        expect(ui_ws_session_find(store, "sid-a") == nil).to_be(true)
