use std.spec.*
use std.nogc_sync_mut.io.file_ops.{file_read}

fn source_between(source: text, start_marker: text, end_marker: text) -> text:
    val start = source.index_of(start_marker) ?? -1
    val finish = source.index_of(end_marker) ?? -1
    if start < 0 or finish <= start:
        return ""
    source.substring(start, finish)

describe "CLI process calls use app-owned exact-semantics facades":
    it "keeps cli_ops command lookup on the direct process contract":
        val source = file_read("src/app/io/cli_ops.spl")

        expect(source).to_contain(
            "use app.io.process_ops.{process_run_direct, process_run_inherit}")
        expect(source.split("process_run_direct(").len() - 1).to_equal(5)
        expect(source).to_contain(
            "process_run_direct(resolved_cmd, args)")
        expect(source.contains("use std.io_runtime.{process_run}")).to_equal(false)
        expect(source.contains("rt_process_run")).to_equal(false)

    it "routes arbitrary-PID status through the distinct existence facade":
        val source = file_read(
            "src/app/io/_CliCommands/handler_commands.spl")

        expect(source).to_contain(
            "use app.io.process_ops.{process_exists, process_kill_unchecked}")
        expect(source.split("process_exists(pid)").len() - 1).to_equal(2)
        expect(source.contains("extern fn rt_process_exists")).to_equal(false)
        expect(source.contains("rt_process_exists(pid)")).to_equal(false)

    it "keeps the facade contracts distinct and non-recursive":
        val source = file_read("src/app/io/process_ops.spl")
        val direct_body = source_between(
            source,
            "fn process_run_direct(cmd: text, args: [text])",
            "fn process_run_bounded(cmd: text, args: [text]")
        val exists_body = source_between(
            source,
            "fn process_exists(pid: i64)",
            "fn process_kill(pid: i64)")

        expect(direct_body).to_contain(
            "fn process_run_direct(cmd: text, args: [text]) -> (text, text, i64):")
        expect(direct_body.split("_process_run_raw(cmd, args)").len() - 1).to_equal(1)
        expect(direct_body.contains("_resolve_process_cmd")).to_equal(false)
        expect(direct_body.contains("proc_slot_")).to_equal(false)
        expect(direct_body.split("process_run_direct(").len() - 1).to_equal(1)

        expect(exists_body).to_contain("fn process_exists(pid: i64) -> bool:")
        expect(exists_body).to_contain("if pid <= 0:")
        expect(exists_body.split("_process_exists_raw(pid)").len() - 1).to_equal(1)
        expect(exists_body.split("process_exists(pid").len() - 1).to_equal(1)
        expect(source.split("extern fn rt_process_exists(").len() - 1).to_equal(1)
