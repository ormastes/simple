use std.cli.log_modes.{parse_log_options}
use app.cli.check_options.{check_option_error, check_presentation_args, check_cli_handoff_args, check_worker_args}

extern fn rt_exit(code: i32)

val unknown = check_option_error(["--not-a-check-option"])
val bare_log_mode = check_option_error(["--log-mode"])
val swallowed_progress = check_option_error(["--progress", "--json"])
val invalid_log_mode = check_option_error(["--log-mode=noisy"])
val invalid_surface = check_option_error(["--surface", "plain"])
val empty_progress = check_option_error(["--progress="])
val valid_split = check_option_error(["--log-mode", "json", "--progress", "dot"])
val invalid_surface_split = check_option_error(["--surface", "tui"])
val valid_equals = check_option_error(["--surface=stdout", "--progress=none"])
val valid_source = check_option_error(["fixture.spl"])
val sole_help = check_option_error(["--help"])
val command_help = check_option_error(["check", "-h"])
val file_help = check_option_error(["fixture.spl", "--help"])
val unknown_help = check_option_error(["--help", "--not-a-check-option"])
val repeated_help = check_option_error(["--help", "-h"])
val trailing_command_help = check_option_error(["--help", "check"])
val presentation = check_presentation_args(["check", "--llm", "--progress", "count", "a.spl", "b.spl"])
val handoff = check_cli_handoff_args(["check", "a.spl", "b.spl"], ["check", "--llm", "--progress", "count", "a.spl", "b.spl"])
val global_handoff = check_cli_handoff_args(["check", "a.spl"], ["--json", "check", "a.spl"])
val worker = check_worker_args(["--llm", "--progress", "count", "a.spl", "b.spl"], "a.spl")
val json_then_human = parse_log_options(["--json", "--human"])
val human_then_json = parse_log_options(["--human", "--log-mode=json"])
val split_surface = parse_log_options(["--surface", "tui"])

val mixed_help_error = "help cannot be combined with files or other options"
val failed = unknown == "" or bare_log_mode == "" or swallowed_progress == "" or invalid_log_mode == "" or invalid_surface == "" or invalid_surface_split == "" or empty_progress == "" or valid_split != "" or valid_equals != "" or valid_source != "" or sole_help != "" or command_help != "" or file_help != mixed_help_error or unknown_help != mixed_help_error or repeated_help != mixed_help_error or trailing_command_help != mixed_help_error or presentation != ["--llm", "--progress", "count"] or handoff != ["check", "a.spl", "b.spl", "--llm", "--progress", "count"] or global_handoff != ["check", "a.spl", "--json"] or worker != ["a.spl", "--llm", "--progress", "count"] or json_then_human.log_mode == "json" or human_then_json.log_mode != "json" or split_surface.valid
if failed:
    print "FAIL: check option preflight did not fail closed"
    rt_exit(1)

print "PASS: check rejects invalid options before file discovery"
rt_exit(0)
