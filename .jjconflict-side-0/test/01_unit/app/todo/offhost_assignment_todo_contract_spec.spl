extern fn rt_file_read_text(path: text) -> text

describe "off-host bug assignment TODO contract":
    it "tracks every unresolved assignment class in the canonical database":
        val db = rt_file_read_text("doc/08_tracking/todo/todo_db.sdn") ?? ""

        expect(db).to_contain("818, TODO, compiler-lint")
        expect(db).to_contain("819, TODO, bootstrap")
        expect(db).to_contain("820, TODO, board-vulkan")
        expect(db).to_contain("821, TODO, qemu")
        expect(db).to_contain("822, TODO, render-perf")
        expect(db).to_contain("823, TODO, bootstrap")
        expect(db).to_contain("824, TODO, bootstrap")
        expect(db).to_contain("825, TODO, bootstrap")
        expect(db).to_contain("826, TODO, board-vulkan")
        expect(db).to_contain("827, TODO, board-vulkan")
        expect(db).to_contain("828, TODO, riscv")
        expect(db).to_contain("829, TODO, process")
        expect(db).to_contain("830, TODO, interpreter, P2")

    it "keeps external evidence and owner decisions fail closed":
        val db = rt_file_read_text("doc/08_tracking/todo/todo_db.sdn") ?? ""

        expect(db).to_contain("BLOCKED-EXTERNAL-RUNTIME")
        expect(db).to_contain("BLOCKED-HARDWARE")
        expect(db).to_contain("BLOCKED-OWNER-DECISION")
        expect(db).to_contain("synthetic or non-Intel evidence is inadmissible")
        expect(db).to_contain("Do not destructively delete or migrate")

    it "retains the assignment ledger's honest unresolved summary":
        val ledger = rt_file_read_text(
            "doc/03_plan/infra/pending_bug_fix_guides_2026-08-17.md"
        ) ?? ""

        expect(ledger).to_contain("receipt-bound admitted execution")
        expect(ledger).to_contain("external runtime or hardware evidence")
        expect(ledger).to_contain("owner deletion decision")
