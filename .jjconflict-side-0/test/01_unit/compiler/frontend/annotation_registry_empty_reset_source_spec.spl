use std.test.*
use std.io.file.read_text as file_read

describe "annotation registry empty-reset native guard":
    it "uses authoritative scalar counts in all module-scoped registries":
        val layer = file_read("src/compiler/10.frontend/layer_eq_registry.spl")
        val effect = file_read("src/compiler/10.frontend/effect_registry.spl")
        val aspect = file_read("src/compiler/10.frontend/aspect_registry.spl")

        expect(layer).to_contain("if layer_eq_registry_view_count == 0:")
        expect(layer).to_contain("layer_eq_registry_view_count = kept.len()")
        expect(layer).to_contain("layer_eq_registry_view_count = layer_eq_registry_view_count + 1")
        expect(effect).to_contain("if effect_registry_fn_count == 0:")
        expect(effect).to_contain("effect_registry_fn_count = kept.len()")
        expect(effect).to_contain("effect_registry_fn_count = effect_registry_fn_count + 1")
        expect(aspect).to_contain("if aspect_registry_fn_count == 0:")
        expect(aspect).to_contain("aspect_registry_fn_count = kept.len()")
        expect(aspect).to_contain("aspect_registry_fn_count = aspect_registry_fn_count + 1")
