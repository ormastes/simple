"""
# Unknown Generic Return Type

A written generic return annotation remains present even when its base type is
declared outside the file currently being parsed.
"""

use std.spec.*
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.common.config.{Logger}

describe "unknown generic return annotations":
    it "preserves a written external generic return":
        step("Parse a function returning an external generic type")
        val module = parse_full_frontend(
            "fn list_names() -> List<text>:\n    return []",
            "unknown_generic_return",
            "unknown_generic_return",
            Logger(level: 0)
        )

        step("Confirm the return annotation survived parsing")
        expect(module.functions.contains_key("list_names")).to_equal(true)
        expect(module.functions["list_names"].has_return_type).to_equal(true)
