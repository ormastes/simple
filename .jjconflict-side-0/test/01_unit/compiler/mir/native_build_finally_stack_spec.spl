# Regression: MirLowering.finally_stack has no initializer on any construction
# path, so in a function with no try/finally region it is still nil when a
# `return` inside a nested block reaches emit_pending_finally_for_transfer().
# `self.finally_stack.len()` then aborted the whole native-build with
#   error: semantic: method `len` not found on type `nil` (receiver value: nil)
# Located with SIMPLE_INTERP_OOB_DEBUG=1 + SIMPLE_DEBUG_FIELD_ACCESS=1, whose
# [mnf-debug-spl] frame list ends at emit_pending_finally_for_transfer.
# Fixed by treating an absent stack as an empty one.
#
# Pre-fix this shape failed `native-build` (rc=1); post-fix it builds and runs.

fn both_branches_return(op: i64) -> bool:
    if op > 0:
        return true
    else:
        return false

fn main():
    describe("native-build finally stack"):
        it("lowers a return inside if/else with no finally region"):
            expect(both_branches_return(3)).to_equal(true)
            expect(both_branches_return(-1)).to_equal(false)
    return ()
