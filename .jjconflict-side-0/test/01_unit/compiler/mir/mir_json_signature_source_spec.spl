# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md




use std.spec.step

extern fn rt_file_read_text(path: text) -> text

fn mir_json_source() -> text:
    rt_file_read_text("src/compiler/50.mir/mir_json.spl") ?? ""

use compiler.mir.mir_json.{serialize_mir_signature}
use compiler.mir.mir_types.{MirSignature, MirType}

describe "MIR JSON signature serialization":
    # @manual scenario evidence
    it "emits explicit null for missing signature return metadata":
        # @req REQ-SSPEC-COMPILER
        step("serialize a signature with no return type")
        val sig = MirSignature(params: [], return_type: nil, is_variadic: false)
        val json = serialize_mir_signature(sig)
        expect(json).to_contain('"return_type":null')
        expect(json).to_contain('"is_variadic":false')

    it "serializes params and variadic flags":
        # @req REQ-SSPEC-COMPILER
        step("serialize a signature with a unit param and variadic flag")
        val sig = MirSignature(params: [MirType.unit()], return_type: MirType.unit(), is_variadic: true)
        val json = serialize_mir_signature(sig)
        expect(json).to_start_with('{"params":[')
        expect(json).to_contain('"is_variadic":true')
        expect(json.find('"return_type":null') ?? -1).to_equal(-1)
