use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_definitions.{HirExpr, HirExprKind}
use compiler.hir.hir_types.{HirType, HirTypeKind, SymbolId, SymbolTable}
use compiler.mir.mir_data.{MirConstValue, MirOperand, MirOperandKind, MirSignature, MirType, MirTypeKind, bootstrap_fn_ret_shape_register}
use compiler.mir.mir_lowering.{MirLowering}

extern fn rt_file_read_text(path: text) -> text

fn read_source(path: text) -> text:
    rt_file_read_text(path) ?? ""

describe "MIR lowering repair contracts":
    it "repairs a nil Struct payload before emitting the call and field metadata":
        val call_name = "nil_struct_return_probe"
        val shape = "probe.module::Validation"
        bootstrap_fn_ret_shape_register(call_name, shape)

        var lowering = MirLowering.new(SymbolTable.new())
        lowering.struct_field_order[shape] = ["valid", "reason"]
        val broken_type = MirType(kind: MirTypeKind.Struct(nil))
        val function_type = MirType(kind: MirTypeKind.FuncPtr(MirSignature(
            params: [], return_type: broken_type, is_variadic: false)))
        val function = MirOperand(kind: MirOperandKind.Const(
            MirConstValue.Str(call_name), function_type))

        var builder = lowering.builder
        builder.begin_function(SymbolId(id: 700), "caller", MirSignature(
            params: [], return_type: MirType.unit(), is_variadic: false), Span.empty())
        lowering.builder = builder
        val result = lowering.emit_resolved_direct_call(function, [], broken_type)

        val repaired = lowering.local_mir_type_of(result)
        var repaired_symbol_id = -1
        if repaired != nil:
            match repaired.kind:
                case MirTypeKind.Struct(symbol):
                    if symbol != nil:
                        repaired_symbol_id = symbol.id
                case _: ()
        expect(repaired_symbol_id).to_be_greater_than(0)
        expect(lowering.struct_value_syms[result.id]).to_equal(shape)

        val span = Span.empty()
        val base = HirExpr(
            kind: HirExprKind.NilLit,
            has_type_: false,
            type_: HirType(kind: HirTypeKind.Infer(0, 0), span: span),
            span: span)
        expect(lowering.resolve_field_index(base, result, "reason", nil)).to_equal(1)

    it "passes the source span to the shared for-loop lowerer":
        val dispatch = read_source("src/compiler/50.mir/_MirLoweringExpr/expr_dispatch.spl")
        val statements = read_source("src/compiler/50.mir/mir_lowering_stmts.spl")

        expect(dispatch).to_contain("self.lower_for(var_, iter, body, expr_value.span)")
        expect(dispatch.contains("self.lower_for(var_, iter, body)\n")).to_equal(false)
        expect(statements).to_contain("me lower_for(var_: SymbolId, iter: HirExpr, body: HirBlock, source_span: Span)")
