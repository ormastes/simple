use std.spec

extern fn rt_file_read_text(path: text) -> text

fn source(path: text) -> text:
    rt_file_read_text(path) ?? ""

describe "module static diagnostic context":
    it "preserves module static and source identity in fatal diagnostics":
        val lowering = source("src/compiler/50.mir/_MirLowering/module_lowering.spl")
        val globals = source("src/compiler/50.mir/_MirLowering/bootstrap_globals.spl")

        expect(lowering).to_contain("self.current_module_id = mir_layout_canonical_module_name(module.name)")
        expect(globals).to_contain("lowering.current_module_id = mir_layout_canonical_module_name(module_name)")
        expect(lowering).to_contain("me lower_static(const_: HirConst, module_name: text):")
        expect(lowering).to_contain(r"module='{module_name}' static='{const_.name}' source='{static_file}:{static_span.line}:{static_span.col}'")
        expect(lowering).to_contain("self.lower_static(bs_const_vals[bs_ci], module.name)")
        expect(lowering).to_contain("self.lower_static(const_vals[coni], module.name)")
        expect(globals).to_contain("lowering.lower_static(const_, logical_module_name)")
        expect(globals).to_contain("lowering.lower_static(const_, hir_module.name)")
        expect(lowering.contains("self.lower_static(bs_const_vals[bs_ci])")).to_be(false)
        expect(lowering.contains("self.lower_static(const_vals[coni])")).to_be(false)
        expect(globals.contains("lowering.lower_static(const_)" )).to_be(false)
