use std.spec.{describe, it}

extern fn rt_file_read_text(path: text) -> text

describe "loader shadow modules are compatibility facades":
    it "forwards the root SMF cache path without owning shadow state":
        val facade = rt_file_read_text("src/compiler/99.loader/smf_cache.spl")
        expect(facade).to_contain("export use compiler.loader.loader.smf_cache.{{")
        expect(facade.contains("class SmfCache:")).to_equal(false)
        expect(facade.contains("cached_files: Dict<text, MappedSmf>")).to_equal(false)
