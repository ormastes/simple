"""Explicit compatibility-loader intent checks."""

use compiler.loader.module_loader_compat.*
use std.spec.step

fn source_fixture() -> text:
    "test/01_unit/compiler/loader/module_load_intent_spec.spl"

describe "Module load intent":
    it "registers source metadata only when explicitly requested":
        step("Load a source path with SourceMetadata intent")
        var loader = ModuleLoader.with_defaults()
        val path = source_fixture()

        match loader.load_with_intent(path, ModuleLoadIntent.SourceMetadata):
            case LoadResult.Success(module):
                expect(module.path).to_equal(path)
            case _:
                expect("unexpected").to_equal(path)
        expect(loader.is_loaded(path)).to_equal(true)

    it "rejects source bytes when an SMF artifact is required":
        step("Load the same source path with the default SMF intent")
        var loader = ModuleLoader.with_defaults()
        val path = source_fixture()

        match loader.load(path):
            case LoadResult.Error(message):
                expect(message).to_contain("invalid SMF artifact")
            case _:
                expect("unexpected").to_equal("invalid SMF artifact")
        expect(loader.is_loaded(path)).to_equal(false)

    it "does not reuse a source metadata cache entry for SMF intent":
        step("Load source metadata, then request the same path as an SMF artifact")
        var loader = ModuleLoader.with_defaults()
        val path = source_fixture()
        val first = loader.load_with_intent(path, ModuleLoadIntent.SourceMetadata)
        match first:
            case LoadResult.Success(_):
                pass
            case _:
                expect("unexpected").to_equal("source metadata load")

        match loader.load(path):
            case LoadResult.Error(message):
                expect(message).to_contain("different intent")
            case _:
                expect("unexpected").to_equal("cross-intent rejection")
