# @cover src/compiler/80.driver/driver_types.spl
# FV2 driver-policy regression: V1 remains the frozen engineering projection,
# while CompileContext must retain V2's verified identity and disable dynamic
# runtime AOP before any canonical VIR/evidence boundary is formed.

use std.spec
use compiler.driver.driver_types.{CompileContext}
use compiler.driver.driver_compiler_type.{CompilerDriver}
# Load the implementation that owns the post-MIR boundaries under test.
use compiler.driver.driver_pipeline_aop.*
use compiler.driver.driver_pipeline_lowering.*
use compiler.common.driver_compile_options.{CompileOptions,
    driver_core_compile_options_default}

extern fn rt_env_set(key: text, value: text)

fn verified_context() -> CompileContext:
    var options: CompileOptions = driver_core_compile_options_default()
    options.input_files = ["verified_profile_context_spec_input.spl"]
    CompileContext.create(options)

describe "FV2 verified CompileContext policy":
    it "retains V2 verified identity while preserving V1 critical engineering projection":
        rt_env_set("SIMPLE_SAFETY_PROFILE", "verified")
        val ctx = verified_context()
        expect(ctx.assurance_policy_v2.strictness.name()).to_equal("verified")
        expect(ctx.assurance_policy.strictness.name()).to_equal("critical")
        rt_env_set("SIMPLE_SAFETY_PROFILE", "")

    it "disables runtime AOP registration for verified compilation":
        rt_env_set("SIMPLE_SAFETY_PROFILE", "verified")
        val ctx = verified_context()
        expect(ctx.aop.runtime_enabled).to_equal(false)
        rt_env_set("SIMPLE_SAFETY_PROFILE", "")

    it "rejects post-MIR AOP log weaving under verified":
        rt_env_set("SIMPLE_SAFETY_PROFILE", "verified")
        rt_env_set("SIMPLE_AOP_LOG_CALLS", "1")
        val ctx = verified_context()
        val driver = CompilerDriver(ctx: ctx)
        driver.weave_aop()
        expect(ctx.has_errors()).to_equal(true)
        expect(ctx.errors[0]).to_contain("FV2-E-AOP-POST-MIR")
        rt_env_set("SIMPLE_AOP_LOG_CALLS", "")
        rt_env_set("SIMPLE_SAFETY_PROFILE", "")

    it "rejects post-MIR debug instrumentation under verified":
        rt_env_set("SIMPLE_SAFETY_PROFILE", "verified")
        val ctx = verified_context()
        ctx.options.debug_trace_level = "calls"
        val driver = CompilerDriver(ctx: ctx)
        driver.apply_debug_trace()
        expect(ctx.has_errors()).to_equal(true)
        expect(ctx.errors[0]).to_contain("FV2-E-DEBUG-POST-MIR")
        rt_env_set("SIMPLE_SAFETY_PROFILE", "")

    it "stops before MIR when the canonical resolver manifest producer is absent":
        rt_env_set("SIMPLE_SAFETY_PROFILE", "verified")
        val ctx = verified_context()
        val driver = CompilerDriver(ctx: ctx)
        expect(driver.lower_to_mir()).to_equal(false)
        expect(ctx.has_errors()).to_equal(true)
        expect(ctx.errors[0]).to_contain("FV2-E-CALL-MANIFEST-PRODUCER")
        rt_env_set("SIMPLE_SAFETY_PROFILE", "")
