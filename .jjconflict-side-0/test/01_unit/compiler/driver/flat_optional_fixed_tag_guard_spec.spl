"""
# Flat Optional Fixed-Tag Guard

Requires the Stage3 flat bridge to decode fixed optional tags without reading
potentially corrupted imported TYPE_OPTION module values.
"""

extern fn rt_file_read_text(path: text) -> text

describe "Flat Optional Fixed-Tag Guard":
    it "recognizes bare and specialized optional protocol tags first":
        val source = rt_file_read_text(
            "src/compiler/10.frontend/_FlatAstBridge/convert_nodes.spl") ?? ""
        expect(source).to_contain("if type_expr_idx > 13 and type_expr_idx < 15:")
        expect(source).to_contain("if type_expr_idx > 16 and type_expr_idx < 18:")
        expect(source).to_contain(
            "TypeKind.Named(\"Option\", [Type(kind: TypeKind.Named(\"text\", [])")
