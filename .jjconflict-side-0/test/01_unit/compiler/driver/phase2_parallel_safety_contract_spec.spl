use std.spec.*
use std.io_runtime.{file_read}

describe "Phase 2 parallel parsing safety":
    it "documents worker wiring and blocks global-state parallel parsing":
        val parsing = file_read("src/compiler/80.driver/driver_source_pipeline_parsing.spl")
        val aot = file_read("src/compiler/80.driver/driver_aot_native_output.spl")
        val lexer = file_read("src/compiler/10.frontend/core/lexer.spl")
        val parser = file_read("src/compiler/10.frontend/core/parser.spl")

        step("Check worker count belongs to the later AOT stage")
        expect(aot).to_contain("driver_native_build_threads()")
        expect(aot).to_contain("num_threads: driver_native_build_threads()")
        expect(parsing.contains("SIMPLE_NATIVE_BUILD_THREADS")).to_be(false)

        step("Check Phase 2 remains serial until parser state is isolated")
        expect(parsing).to_contain("for source in unique_entry_sources:")
        expect(parsing).to_contain("val entry_module = parse_full_frontend(")
        expect(lexer).to_contain("var current_core_lexer_slot: [CoreLexer] = []")
        expect(lexer).to_contain("var lex_all_kinds: [i64] = []")
        expect(parser).to_contain("var par_errors: [text] = []")
        expect(parser).to_contain("var par_had_error: bool = false")
