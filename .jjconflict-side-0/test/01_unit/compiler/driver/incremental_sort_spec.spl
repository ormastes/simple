use std.spec.{describe, it, expect}
use compiler.driver.driver_build.incremental.{incremental_sorted_text}

describe "incremental compiler-source fingerprint sorting":
    it "returns empty and singleton directory listings unchanged":
        expect(incremental_sorted_text([])).to_equal([])
        expect(incremental_sorted_text(["only"])).to_equal(["only"])

    it "orders an uneven listing and retains duplicate entries":
        val sorted = incremental_sorted_text(
            ["delta", "alpha", "charlie", "bravo", "alpha"])
        expect(sorted).to_equal(
            ["alpha", "alpha", "bravo", "charlie", "delta"])

    it "handles both already-ordered and reverse-ordered listings":
        expect(incremental_sorted_text(["a", "b", "c", "d"]))
            .to_equal(["a", "b", "c", "d"])
        expect(incremental_sorted_text(["d", "c", "b", "a"]))
            .to_equal(["a", "b", "c", "d"])

    it "chooses the greater child while restoring a two-child heap":
        expect(incremental_sorted_text(["a", "z", "m"]))
            .to_equal(["a", "m", "z"])
