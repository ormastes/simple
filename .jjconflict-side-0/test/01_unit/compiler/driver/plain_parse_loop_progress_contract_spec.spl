use std.io_runtime.{file_read}

# doc/08_tracking/bug/bootstrap_main_native_build_stalls_after_source_closure_2026-08-21.md
# Until 2026-08-21 only the --entry-closure branch of parse_all_impl reported
# per-file progress; the plain loop went silent for a whole-tree interpreted
# parse (17+ min CPU-bound) and was misread as a futex stall.
describe "Phase 2 plain parse loop progress contract":
    it "emits per-file parse progress and a phase marker in the plain loop":
        val source = file_read("src/compiler/80.driver/driver_source_pipeline_parsing.spl")
        val plain_start = source.index_of("var layer_wiring_paths: [text] = []")
        expect(plain_start >= 0).to_equal(true)
        val plain_loop = source.substring(plain_start, source.len())
        expect(plain_loop).to_contain("log_build_progress(\"parse\", \"files\", src_idx, sources.len()")
        expect(plain_loop).to_contain("log_phase(\"phase2:parse:file:start {")
