"""
# Contract spec: test/01_unit/compiler/driver/driver_public_compile_split_contract_spec.spl

## Purpose and Audience

Audience: engineers owning the pinned repository sources. Purpose: keep the pinned observable
contracts red-visible, so a regression in the owned code fails this spec
instead of shipping silently.

## Scope and Preconditions

Precondition: the repository working tree holds the subject code under test.
Each scenario exercises the subject and asserts its observable contract; no
behavior outside the named subject is claimed.

## Primary Workflow

Run the scenarios; each one drives the subject through its pinned contract
and asserts the expected observable outcome with an executed oracle.

## Unsupported / Limitations

Only the pinned contracts are asserted here; end-to-end and integration
behavior of the surrounding system is covered by companion specs.

## Verification and Recovery

A red scenario names the contract that regressed. Recover by restoring the
pinned behavior in the subject; verify with
`bin/simple test test/01_unit/compiler/driver/driver_public_compile_split_contract_spec.spl` and a green Results line.
"""

use std.spec
use std.nogc_sync_mut.io.file_ops.{file_read}

describe "driver public compile split contract":
    it "keeps a small compatibility facade":
        # @req REQ-SSPEC-COMPILER
        val facade = file_read("src/compiler/80.driver/driver_public_compile.spl")
        expect(facade).to_contain("driver_public_compile_process")
        expect(facade).to_contain("driver_public_compile_backends")
        expect(facade).to_contain("driver_public_compile_vhdl")
        expect(facade.len()).to_be_less_than(2000)

    it "keeps VHDL fallback isolated from process dispatch":
        # @req REQ-SSPEC-COMPILER
        val process = file_read("src/compiler/80.driver/driver_public_compile_process.spl")
        val vhdl = file_read("src/compiler/80.driver/driver_public_compile_vhdl.spl")
        expect(process).to_not_contain("_compile_simple_vhdl_subset")        expect(vhdl).to_contain("_compile_simple_vhdl_subset")
