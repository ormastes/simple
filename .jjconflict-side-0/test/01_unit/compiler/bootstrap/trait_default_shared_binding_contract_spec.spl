use std.spec
use std.io_runtime.{file_read}

describe "trait default strict shared bindings":
    it "derives the concrete default method type as a value":
        val source = file_read("src/compiler/20.hir/hir_lowering/_Items/trait_impl_lowering.spl")

        expect(source).to_contain("me concrete_default_method_type(default_fn: HirFunction, impl_type: HirType) -> HirType?:")
        expect(source).to_contain("val concrete_symbol_type = self.concrete_default_method_type(default_fn, type_)")
        expect(source).to_contain("return symbol_type")
        expect(source.contains("var concrete_symbol_type: HirType? = nil")).to_equal(false)
        expect(source.contains("concrete_symbol_type = Some(HirType(")).to_equal(false)
