# Fixture B: the same three names as xmod_collision_a.spl, each returning a "B"
# answer. `shared_arity` deliberately takes ONE parameter where A's takes none,
# so a wrong dispatch cannot be excused as a coincidence of identical signatures.

fn _shared_helper() -> text:
    return "B_private"

fn shared_public() -> text:
    return "B_public"

fn shared_arity(n: int) -> text:
    return "B_arity1"

fn b_calls_private() -> text:
    return _shared_helper()

fn b_calls_public() -> text:
    return shared_public()

fn b_calls_arity() -> text:
    return shared_arity(7)
