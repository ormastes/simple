# Fixture A for the cross-module symbol collision probe.
# Defines a private helper, a public function, and a class whose names are
# duplicated verbatim in xmod_collision_b.spl. Each returns an "A" answer.

fn _shared_helper() -> text:
    return "A_private"

fn shared_public() -> text:
    return "A_public"

fn shared_arity() -> text:
    return "A_arity0"

fn a_calls_private() -> text:
    return _shared_helper()

fn a_calls_public() -> text:
    return shared_public()

fn a_calls_arity() -> text:
    return shared_arity()
