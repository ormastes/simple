use std.spec.*
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_scalar_csr_owner.{strict_riscv_scalar_csr_owner}
use compiler.mir.hwir.riscv_lsu_config.{LsuConfig}
use compiler.mir.hwir.riscv_scalar_product_composition.{strict_riscv_scalar_product_composition}
use compiler.backend.backend.riscv_scalar_csr_owner_to_vhdl.{compile_strict_riscv_scalar_csr_owner}
use compiler.backend.backend.riscv_scalar_product_to_vhdl.{compile_strict_riscv_scalar_product}

describe "RISC-V Gen2 atomic CSR owner":
    # @req REQ-G2-016 NFR-G2-017
    it "binds a concrete projection and freezes complete dispatch identity":
        val owner = strict_riscv_scalar_csr_owner("csr_owner_rv64",
            CoreConfig.rv64_zicsr_zifencei(), 0x300092F3).unwrap()
        expect(owner.child_entity).to_equal("csr_owner_rv64_access_projection")
        expect(owner.child_graph_sha256.len()).to_equal(64)
        expect(owner.plan.readable_width(owner.ports, "dispatch_identity_ok")).to_equal(1)
        expect(owner.plan.readable_width(owner.ports, "dispatch_canonical_instruction")).to_equal(32)
        expect(owner.plan.readable_width(owner.ports, "dispatch_instruction_length_bytes")).to_equal(3)
        expect(owner.plan.readable_width(owner.ports, "dispatch_rd")).to_equal(5)
        expect(owner.diagnostic()).to_equal("")

    # @req REQ-G2-016 NFR-G2-017
    it "holds one completion and commits the CSR only on accepted completion":
        val owner = strict_riscv_scalar_csr_owner("csr_owner_protocol",
            CoreConfig.rv32_zicsr_zifencei(), 0x300092F3).unwrap()
        expect(owner.plan.rules[0].name).to_equal("consume")
        expect(owner.plan.rules[1].name).to_equal("identity_fault")
        expect(owner.plan.rules[2].name).to_equal("capture")
        val commit = owner.plan.outputs.filter(fn(output): output.result == "csr_commit_valid")[0]
        expect(commit.guards.len()).to_equal(6)
        expect(commit.guards.map(fn(guard): guard.lhs).contains("completion_ready")).to_equal(true)
        expect(commit.guards.map(fn(guard): guard.lhs).contains("csr_write_reg")).to_equal(true)
        expect(commit.guards.map(fn(guard): guard.lhs).contains("illegal_valid_reg")).to_equal(true)
        expect(commit.guards.map(fn(guard): guard.lhs).contains("execute_trap_valid_reg")).to_equal(true)
        val valid = owner.plan.outputs.filter(fn(output): output.result == "completion_valid")[0]
        expect(valid.source).to_equal("full_reg")
        val access_read = owner.plan.outputs.filter(
            fn(output): output.result == "csr_access_read_enable")[0]
        expect(access_read.source).to_equal("projected_csr_read_enable")

    # @req REQ-G2-016 NFR-G2-017
    it "emits the child before the sequential owner with exact hash binding":
        val emitted = compile_strict_riscv_scalar_csr_owner("csr_owner_emit",
            CoreConfig.rv64_zicsr_zifencei(), 0x300092F3)
        expect(emitted.is_success()).to_equal(true)
        expect(emitted.route).to_equal("hwir-gen2-scalar-csr-owner-v1")
        expect(emitted.vhdl).to_contain("entity csr_owner_emit_access_projection is")
        expect(emitted.vhdl).to_contain("entity csr_owner_emit is")
        expect(emitted.vhdl).to_contain("csr_commit_valid <=")
        expect(emitted.vhdl).to_contain("dispatch_identity_ok <=")

    # @req REQ-G2-016 NFR-G2-017
    it "rejects base-I profiles and non-CSR instructions":
        expect(strict_riscv_scalar_csr_owner("base_profile",
            CoreConfig.rv64(), 0x300092F3).is_err()).to_equal(true)
        expect(strict_riscv_scalar_csr_owner("not_csr",
            CoreConfig.rv64_zicsr_zifencei(), 0x00000073).is_err()).to_equal(true)

    # @req REQ-G2-012 REQ-G2-016 NFR-G2-017
    it "composes CSR through arbitration trap and the sole retirement owner":
        val composition = strict_riscv_scalar_product_composition("csr_product",
            CoreConfig.rv64_zicsr_zifencei(), 0x300092F3,
            LsuConfig.rv64_product_default()).unwrap()
        expect(composition.provider_kind).to_equal("csr")
        expect(composition.csr_provider != nil).to_equal(true)
        expect(composition.completion_skid == nil).to_equal(true)
        expect(composition.retirement_owner_count).to_equal(1)
        expect(composition.binding_diagnostic()).to_equal("")
        val emitted = compile_strict_riscv_scalar_product("csr_product_emit",
            CoreConfig.rv64_zicsr_zifencei(), 0x300092F3,
            LsuConfig.rv64_product_default())
        expect(emitted.is_success()).to_equal(true)
        expect(emitted.vhdl).to_contain("csr_commit_valid")
        expect(emitted.vhdl).to_contain("fault_aggregator: entity work")
