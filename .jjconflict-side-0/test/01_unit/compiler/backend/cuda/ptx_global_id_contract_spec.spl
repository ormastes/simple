use compiler.backend.cuda.ptx_builder.{PtxBuilder}

describe "CUDA offload PTX contract":
    it "emits global thread index arithmetic":
        var builder = PtxBuilder__create((8, 6))
        builder.emit_compute_global_id("%gid", 0)
        val ptx = builder.build()

        expect(ptx).to_contain("mov.u32")
        expect(ptx).to_contain("%tid.x")
        expect(ptx).to_contain("%ctaid.x")
        expect(ptx).to_contain("%ntid.x")
        expect(ptx).to_contain("mul.lo.u32")
        expect(ptx).to_contain("add.u32 %gid")
