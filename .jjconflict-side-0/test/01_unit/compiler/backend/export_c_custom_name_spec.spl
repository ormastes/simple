# Regression spec for: @export("C", name: ...) ignored under --no-mangle
# doc/08_tracking/bug/export_c_custom_name_ignored_under_no_mangle_2026-08-14.md
#
# The LLVM backend's llvm_function_symbol_name returned the bare MIR name
# whenever no_mangle was set, so the requested export symbol (recorded in
# export_symbol_names from MirFunction.export_name) was silently dropped:
# `nm -D` showed pure_simple_provider_query_v1 instead of the requested
# simple_provider_query_v1. The requested name must be authoritative.

use std.spec.*
use compiler.backend.llvm_ir_builder.{MirToLlvm, MirToLlvm__create}
use compiler.backend.backend_api.CodegenTarget

describe "export_c custom name under no-mangle":
    it "honours the requested export name when no_mangle is set":
        var tr = MirToLlvm__create("test", CodegenTarget.X86_64, nil)
        tr.no_mangle = true
        tr.export_symbol_names["pure_simple_provider_query_v1"] = "simple_provider_query_v1"
        expect(tr.llvm_function_symbol_name("pure_simple_provider_query_v1")).to_equal("simple_provider_query_v1")

    it "still passes through non-exported names unchanged under no_mangle":
        var tr = MirToLlvm__create("test", CodegenTarget.X86_64, nil)
        tr.no_mangle = true
        expect(tr.llvm_function_symbol_name("plain_helper")).to_equal("plain_helper")
