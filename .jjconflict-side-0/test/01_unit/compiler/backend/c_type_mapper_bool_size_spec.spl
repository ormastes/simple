use compiler.backend.backend.c_type_mapper.CTypeMapper
use compiler.mir.mir_data.*

describe "C Type Mapper - Bool size/repr consistency":
    it "size_of(Bool) matches the byte width of the C type map_type emits for Bool":
        val mapper = CTypeMapper.create()
        val bool_ty = MirType.bool()

        # map_type emits "int64_t" for Bool (8 bytes) per the mapper's own
        # doc comment: "Bool -> int64_t (runtime uses i64 for bools)".
        expect(mapper.map_type(bool_ty)).to_equal("int64_t")

        # size_of/align_of are used by the C backend (instruction_lowering.spl,
        # class_core.spl) to size stack slots for a value of this MIR type.
        # They must agree with the C type actually emitted above, or a bool
        # stack slot is under-allocated relative to the int64_t write into it.
        expect(mapper.size_of(bool_ty)).to_equal(8)
        expect(mapper.align_of(bool_ty)).to_equal(8)
