# @feature mcdc_hal_runtime_hardening
# @req REQ-015 REQ-016 REQ-017

use std.spec.*
use std.nogc_sync_mut.io_runtime.{file_read}

describe "rt(hal) frozen device execution binding source contract":
    it "defines raw direct compare and tagged leaves for all operations":
        val source = file_read(
            "src/lib/nogc_sync_mut/io/hal_device_dispatch.spl")
        val names = ["irq_mask", "irq_acknowledge", "mmio_read",
            "mmio_write", "dma_map", "dma_submit", "dma_poll",
            "dma_unmap"]
        var index = 0
        while index < names.len():
            val name = names[index]
            expect(source).to_contain("_hal_" + name + "_exec_v1_raw")
            expect(source).to_contain(
                "rt_hal_" + name + "_exec_direct_v1")
            expect(source).to_contain(
                "rt_hal_" + name + "_exec_compare_v1")
            expect(source).to_contain("hal_" + name + "_exec_v1")
            index = index + 1

    it "keeps lifecycle explicit and hot wrappers allocation free":
        val source = file_read(
            "src/lib/nogc_sync_mut/io/hal_device_dispatch.spl")
        expect(source).to_contain("rt_hal_device_route_prepare_v1")
        expect(source).to_contain("rt_hal_device_route_seal_v1")
        expect(source).to_contain("rt_hal_device_route_shutdown_v1")
        expect(source.contains("Dict<")).to_be(false)
        expect(source.contains(".push(")).to_be(false)
        expect(source.contains("process_")).to_be(false)
        expect(source.contains("rt_env_get")).to_be(false)
