use std.spec.{describe, it, expect}

extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_read_text(path: text) -> text

# Regression guard for
# doc/08_tracking/bug/stage3_selfhost_unresolved_name_error_type_mappers_2026-08-08.md.
#
# Root cause: src/lib/common/error.spl (module `std.error`) and
# src/lib/common/error/error.spl (module `std.error.error`) each independently
# defined `extern class SimpleError` and `pub fn error(message: text) ->
# SimpleError`. The second file had ZERO importers anywhere in the tree (dead
# code) but its duplicate top-level `error` definition still entered the
# self-hosted (Stage-3) compiler's whole-program global function symbol table
# alongside the real one. Bare `error("...")` calls in six unrelated backend
# type-mapper/codegen files (llvm_type_mapper.spl, common/type_mapper.spl,
# cuda_type_mapper.spl, cuda/ptx_builder.spl, vulkan_type_mapper.spl,
# lua_backend.spl -- 12 call sites total) then hard-failed HIR lowering with
# "unresolved name: error", poisoning those modules and blocking Stage 3
# self-host (`native-build` compiling the stage2-compiled `simple` against
# itself). Stage 2 (compiled by the Rust seed) was unaffected because the seed
# resolves builtins/globals differently. Fix: delete the orphaned duplicate
# module -- it had no importers, so removing it is pure dead-code deletion
# with no behavior change for any caller.
describe "std.error has exactly one `pub fn error` definition (no dead duplicate module)":
    it "no longer has the orphaned src/lib/common/error/error.spl duplicate":
        expect(rt_file_exists("src/lib/common/error/error.spl")).to_equal(false)

    it "keeps the single canonical std.error module with `pub fn error`":
        val error_mod = rt_file_read_text("src/lib/common/error.spl")
        expect(error_mod).to_contain("pub fn error(message: text) -> SimpleError")
        expect(error_mod).to_contain("extern class SimpleError")

    it "backend type-mapper/codegen files still call the bare `error(` builtin unchanged":
        # The 6 files poisoned by the duplicate-symbol bug keep calling the
        # global `error(...)` panic-style helper; this spec only guards
        # against the duplicate definition reappearing, not against these
        # call sites themselves changing.
        val llvm_mapper = rt_file_read_text(
            "src/compiler/70.backend/backend/llvm_type_mapper.spl")
        expect(llvm_mapper).to_contain("error(\"Unsupported type in LLVM backend")
