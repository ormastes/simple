# Comparison chain closed by `(` must not be misread as generic arguments
#
# Reproduces doc/08_tracking/bug/parser_comparison_chain_misread_as_generic_args_2026-08-18.md.
#
#     if key_col < 0 or key_col > (max_col - min_col):
#
# failed the WHOLE FILE in phase 2 (parse) with
#
#     const generic arguments are not supported: a numeric literal such as
#     `Tensor<i64, 2>` is not a type ...
#
# The `Tensor<i64, 2>` text is a canned EXAMPLE inside the diagnostic, not
# anything in the offending source. The real defect: the generic-argument
# lookahead consumed `0 or key_col` as if those were more type arguments
# (`or` is TOK_OR = 56, inside the keyword range the walk accepted as type
# names), saw the final `>` followed by `(`, and falsely CONFIRMED a
# generic-argument list. The fix (bf440c278b8) added a separator ratchet:
# after a numeric candidate, only a comma or a closing angle may follow.
#
# That fix landed source-only with no spec, which is what this file supplies.
#
# Whole-file PARSE failures cannot be in-process examples, so every example
# drives a subprocess. SIMPLE_BIN lets a lane aim this at a specific stage
# binary; a binary older than the fix fails these examples, which is the
# intended failing-pre-fix behaviour.

use std.spec.*
use std.io_runtime.{file_write, process_run, env_get}

fn compile_source(name: text, source: text) -> text:
    val path = "build/test-artifacts/cmp_chain_" + name + ".spl"
    file_write(path, source)
    var bin = env_get("SIMPLE_BIN")
    if bin == "":
        bin = "bin/simple"
    val cmd = bin + " run " + path + " 2>&1"
    val out = process_run("sh", ["-c", cmd])
    out.0

# The incident shape, verbatim in structure: literal on the left comparison,
# `or`, then a `>` closed by a parenthesised expression.
val IF_SOURCE: text = "fn f(a: i64, b: i64, c: i64) -> bool:\n" +
    "    if a < 0 or a > (b - c):\n" +
    "        return true\n" +
    "    false\n" +
    "\n" +
    "fn main():\n" +
    "    print(\"if ok\")\n"

# Neighbour: same shape as a `while` condition.
val WHILE_SOURCE: text = "fn main():\n" +
    "    var a = 0\n" +
    "    val b = 3\n" +
    "    val c = 1\n" +
    "    while a < 5 or a > (b - c):\n" +
    "        a = a + 1\n" +
    "    print(\"while ok\")\n"

# Neighbour: same shape in a returned expression, not a condition.
val RETURN_SOURCE: text = "fn f(a: i64, b: i64) -> bool:\n" +
    "    a < 1 or a > (b)\n" +
    "\n" +
    "fn main():\n" +
    "    print(\"return ok\")\n"

# Neighbour: no integer literal anywhere — exercises the ident-only walk,
# which reaches the confirming `>(` by a different branch than the ratchet.
val IDENT_ONLY_SOURCE: text = "fn f(a: i64, b: i64, c: i64) -> bool:\n" +
    "    a < b or a > (c)\n" +
    "\n" +
    "fn main():\n" +
    "    print(\"ident ok\")\n"

# Neighbour: `>>` must stay a shift, not two closing angles.
val SHIFT_SOURCE: text = "fn f(a: i64, b: i64, c: i64) -> bool:\n" +
    "    a < 2 or a > (b >> c)\n" +
    "\n" +
    "fn main():\n" +
    "    print(\"shift ok\")\n"

# Absence control: a REAL const-generic argument must still be diagnosed, so
# these examples cannot pass by the diagnostic having been deleted.
val REAL_CONST_ARG_SOURCE: text = "struct Box2<T, N>:\n" +
    "    v: T\n" +
    "\n" +
    "fn main():\n" +
    "    val a = Box2<i64, 2>(v: 7)\n" +
    "    print(a.v.to_text())\n"

fn expect_parses(name: text, source: text, marker: text):
    val out = compile_source(name, source)
    expect(out.contains("const generic")).to_equal(false)
    expect(out).to_contain(marker)

describe "comparison chain closed by a parenthesised expression":
    it "parses the incident shape in an if condition":
        step("`if a < 0 or a > (b - c)` is a comparison chain, not generic args")
        expect_parses("if", IF_SOURCE, "if ok")

    it "parses the same shape in a while condition":
        step("Defect-class neighbour: loop condition position")
        expect_parses("while", WHILE_SOURCE, "while ok")

    it "parses the same shape in a returned expression":
        step("Defect-class neighbour: value position, not condition position")
        expect_parses("return", RETURN_SOURCE, "return ok")

    it "parses an ident-only chain with no numeric literal":
        step("Defect-class neighbour: the separator ratchet never arms here")
        expect_parses("ident", IDENT_ONLY_SOURCE, "ident ok")

    it "keeps `>>` a shift operator rather than two closing angles":
        step("Defect-class neighbour: SHR must not close a phantom generic list")
        expect_parses("shift", SHIFT_SOURCE, "shift ok")

    it "still diagnoses a genuine const-generic argument":
        step("Absence control — the diagnostic was narrowed, not removed")
        val out = compile_source("real", REAL_CONST_ARG_SOURCE)
        expect(out).to_contain("const generic")
