# @feature: compiler-performance-memory-efficiency
# @req: REQ-011

use std.spec.*
use std.fs.{read_file}
use app.cli.query_lint_checks.{
    QueryEnumFacts, _query_enum_facts, _infer_type_from_patterns
}

describe "query lint match membership index":
    it "infers a high-cardinality enum through indexed membership":
        var variants: [text] = []
        var patterns: [text] = []
        var index = 0
        while index < 128:
            val variant = "Variant_{index}"
            variants.push(variant)
            patterns.push(variant)
            index = index + 1
        var enums: Dict<text, QueryEnumFacts> = {}
        enums["Wide"] = _query_enum_facts(variants)
        expect(_infer_type_from_patterns(patterns, enums)).to_equal("Wide")
        expect(enums["Wide"].variant_set.has("Variant_127")).to_be(true)

    it "forbids linear duplicate and variant membership scans":
        val source = read_file("src/app/cli/query_lint_checks.spl")
        expect(source).to_contain("arm_pattern_set.has(pat_name)")
        expect(source).to_contain("arm_pattern_set.has(v)")
        expect(source).to_contain("enums[enum_name].variant_set")
        expect(source).not.to_contain("for prev in arm_patterns:")
