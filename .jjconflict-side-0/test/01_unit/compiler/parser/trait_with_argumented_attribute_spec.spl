# Regression: parser must accept an argumented attribute (`@doc("...")`)
# followed by `trait`.
#
# Prior bug: `parse_attributed_item`'s decorator branch (the path taken when
# the attribute carries arguments, e.g. `@doc("...")`) handled Class, Struct,
# Enum, Union, Extern, and Mixin after the decorator, but not Trait — so it
# fell through to `parse_function_with_attrs` and failed with:
#   "Unexpected token: expected Fn, found Trait"
# Argument-less attributes (`@packed`) took a different, already-correct
# branch, which is why `@packed trait` always parsed fine.
#
# See doc/08_tracking/bug/parser_rejects_trait_after_argumented_attribute_2026-08-10.md

@doc("Parser regression trait")
trait Greeter:
    fn greet() -> text

struct EnglishGreeter:
    pass

impl Greeter for EnglishGreeter:
    fn greet() -> text:
        "hello"

describe "trait with argumented attribute":
    "Regression suite covering the `@doc(\"...\") trait` parser path."

    it "parses an argumented attribute followed by trait":
        "A trait declaration preceded by `@doc(\"...\")` must parse and its methods must be usable."
        val g = EnglishGreeter()
        expect(g.greet()).to_equal("hello")
