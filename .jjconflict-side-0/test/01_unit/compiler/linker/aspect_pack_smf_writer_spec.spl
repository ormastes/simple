"""
## Purpose and audience
Purpose: Prove the compiler driver emits an aspect-pack SMF with the canonical
header flag, section-table type, and byte-exact payload.
Audience: compiler, linker, and aspect-loader maintainers.
"""
# @req: REQ-APKW-04

use std.spec.{describe, it}
use std.spec.step
use compiler.driver.smf_writer.{generate_aspect_pack_smf}
use compiler.backend.linker.smf_writer.{SectionType}
use compiler.backend.linker.smf_reader_memory.{SmfReaderMemory}
use compiler.backend.linker.smf_header.{SMF_FLAG_ASPECT_PACK}
use compiler.loader.aspect_pack_section.{
    smf_find_section_by_wire_type, smf_aspect_pack_bytes,
    SMF_SECTION_ASPECT_PACK_DIRECTORY
}
use std.common.aspect_pack.{
    ApkModuleSourceV1, apk_build_pack_v1, apk_open_pack_v1
}

fn _aspect_pack_fixture() -> [u8]:
    apk_build_pack_v1([
        ApkModuleSourceV1(
            module_id: "debug.core",
            aspect_id: "debug",
            payload: [1u8, 3u8, 3u8, 7u8]
        )
    ]).bytes

describe "aspect-pack SMF producer":
    it "registers .aspect_pack as wire section type 16":
        step("Verify the public section identity used by producer and consumer")
        expect(SectionType.AspectPackDirectory.name()).to_equal(".aspect_pack")
        expect(SectionType.AspectPackDirectory.to_wire_u8() as i64).to_equal(
            SMF_SECTION_ASPECT_PACK_DIRECTORY)

    it "allocates a flag bit disjoint from note.sdn":
        step("Verify bit 5 remains note.sdn and aspect packs use extension bit 6")
        expect(SMF_FLAG_ASPECT_PACK).to_equal(0x40u32)
        expect((SMF_FLAG_ASPECT_PACK & 0x20u32) == 0u32).to_equal(true)

    it "rejects an empty aspect-pack payload":
        step("Verify an empty pack cannot become a flagged SMF artifact")
        expect(generate_aspect_pack_smf([]).is_err()).to_equal(true)

    it "emits the derived header flag and byte-exact uncompressed payload":
        step("Build through the driver and inspect through the production reader")
        val payload = _aspect_pack_fixture()
        val image = generate_aspect_pack_smf(payload).unwrap()
        val reader = SmfReaderMemory.from_data(image).unwrap()
        expect(reader.header.flags.aspect_pack).to_equal(true)
        expect(reader.header.flags.executable).to_equal(false)
        expect(reader.header.has_note_sdn).to_equal(false)
        expect(reader.header.section_count).to_equal(1)
        expect(smf_find_section_by_wire_type(
            reader, SMF_SECTION_ASPECT_PACK_DIRECTORY)).to_equal(0)
        val extracted = smf_aspect_pack_bytes(reader).unwrap()
        expect(extracted).to_equal(payload)
        val opened = apk_open_pack_v1(extracted)
        expect(opened.ok).to_equal(true)
        expect(opened.module_count).to_equal(1)
