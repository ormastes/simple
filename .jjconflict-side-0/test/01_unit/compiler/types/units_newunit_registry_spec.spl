# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md


# @cover src/compiler/30.types/units/unit_registry.spl
# # Newunit Registry Collection Specification
#
# `newunit Name: T as suffix` declarations are recorded by the parser via
# `newunit_register` (compiler.core.types) and collected into the compiler's
# UnitRegistry by `unit_registry_build` / `unit_registry_collect_newunits`.
# Before this landed, unit_registry_build was a no-op skeleton and newunit
# declarations never reached the registry.
#
# Assertion style note: `.?` on an Option evaluates to the PAYLOAD (object),
# not a bool, on both engines (2026-07-28) — so these specs assert via match
# on lookup_entry and concrete field values, never `expect(x.?).to_equal(true)`.

use std.spec.step

use std.spec
use compiler.core.types.{
    newunit_register,
    newunit_count,
    newunit_name_at,
    newunit_suffix_at,
    newunit_underlying_tag_at,
    reset_all_pools,
    newunit_project_reset,
    newunit_project_generation_get,
    newunit_project_commit_current,
    newunit_project_count,
    newunit_project_name_at,
    newunit_project_suffix_at,
    newunit_project_underlying_tag_at,
    newunit_project_find,
    flat_type_pools_dump,
    flat_type_pools_restore,
    TYPE_I64,
    TYPE_F64
}
use compiler.types.units.unit_registry.{

    UnitRegistry, unit_registry_build, unit_registry_collect_newunits
}
use compiler.frontend.core.flat_pool_codec.{FlatPoolReader}

describe "newunit registry collection":
    # @manual scenario evidence

    it "records a newunit declaration in the parser-side registry":
        # @req REQ-SSPEC-UNIT
        step("records a newunit declaration in the parser-side registry")
        val idx = newunit_register("SpecUserId", "suid", TYPE_I64)
        assert_true(idx >= 0)
        assert_true(newunit_count() > idx)

    it "unit_registry_build makes a recorded newunit visible by suffix":
        # @req REQ-SSPEC-UNIT
        step("unit_registry_build makes a recorded newunit visible by suffix")
        newunit_register("SpecMeters", "smtr", TYPE_I64)
        val reg = unit_registry_build()
        assert_true(reg.has("smtr"))

    it "collected entry carries name, suffix, and underlying kind":
        # @req REQ-SSPEC-UNIT
        step("collected entry carries name, suffix, and underlying kind")
        newunit_register("SpecPrice", "sprc", TYPE_F64)
        val reg = unit_registry_build()
        match reg.lookup_entry("sprc"):
            case Some(entry):
                expect(entry.short_symbol).to_equal("sprc")
                expect(entry.full_symbol).to_equal("SpecPrice")
                expect(entry.kind).to_equal("f64")
            case None:
                assert_true(false)

    it "entry is also visible by full type name":
        # @req REQ-SSPEC-UNIT
        step("entry is also visible by full type name")
        newunit_register("SpecWeight", "swt", TYPE_I64)
        val reg = unit_registry_build()
        match reg.lookup_entry("SpecWeight"):
            case Some(entry):
                expect(entry.short_symbol).to_equal("swt")
            case None:
                assert_true(false)

    it "re-registering the same name updates instead of duplicating":
        # @req REQ-SSPEC-UNIT
        step("re-registering the same name updates instead of duplicating")
        val a = newunit_register("SpecDup", "sd1", TYPE_I64)
        val b = newunit_register("SpecDup", "sd2", TYPE_I64)
        expect(a).to_equal(b)
        val reg = UnitRegistry.new()
        unit_registry_collect_newunits(reg)
        assert_true(reg.has("sd2"))

    it "whole-owner pool reset drops all aligned newunit metadata before reuse":
        # Model the next-source boundary used by streaming parsing: the prior
        # source populated every parallel pool, then reset_all_pools replaces
        # their owners without reading or clearing potentially reclaimed
        # backing storage.
        newunit_register("TransientOld", "told", TYPE_F64)
        reset_all_pools()
        expect(newunit_count()).to_equal(0)

        val next = newunit_register("TransientNext", "tnext", TYPE_I64)
        expect(next).to_equal(0)
        expect(newunit_count()).to_equal(1)
        expect(newunit_name_at(next)).to_equal("TransientNext")
        expect(newunit_suffix_at(next)).to_equal("tnext")
        expect(newunit_underlying_tag_at(next)).to_equal(TYPE_I64)

    it "retains successful declarations from two file-local scratch generations":
        newunit_project_reset()
        reset_all_pools()
        newunit_register("ProjectFirst", "pfirst", TYPE_I64)
        expect(newunit_project_commit_current()).to_equal(true)
        reset_all_pools()
        newunit_register("ProjectSecond", "psecond", TYPE_F64)
        expect(newunit_project_commit_current()).to_equal(true)

        expect(newunit_project_count()).to_equal(2)
        expect(newunit_project_find("ProjectFirst")).to_equal(0)
        expect(newunit_project_find("ProjectSecond")).to_equal(1)
        expect(newunit_project_name_at(0)).to_equal("ProjectFirst")
        expect(newunit_project_suffix_at(1)).to_equal("psecond")
        expect(newunit_project_underlying_tag_at(1)).to_equal(TYPE_F64)

    it "does not publish a failed file scratch row":
        newunit_project_reset()
        reset_all_pools()
        newunit_register("FailedFileUnit", "failed", TYPE_I64)
        # A failed parser/projection deliberately skips commit_current.
        reset_all_pools()
        newunit_register("SuccessfulFileUnit", "success", TYPE_F64)
        expect(newunit_project_commit_current()).to_equal(true)
        expect(newunit_project_count()).to_equal(1)
        expect(newunit_project_find("FailedFileUnit")).to_equal(-1)
        expect(newunit_project_find("SuccessfulFileUnit")).to_equal(0)

    it "reset advances generation and removes the prior project authority":
        newunit_project_reset()
        val before = newunit_project_generation_get()
        reset_all_pools()
        newunit_register("PriorGeneration", "prior", TYPE_I64)
        expect(newunit_project_commit_current()).to_equal(true)
        newunit_project_reset()
        expect(newunit_project_generation_get()).to_equal(before + 1)
        expect(newunit_project_count()).to_equal(0)
        expect(newunit_project_find("PriorGeneration")).to_equal(-1)

    it "duplicate publication preserves order and updates aligned metadata":
        newunit_project_reset()
        reset_all_pools()
        newunit_register("ProjectDup", "old", TYPE_I64)
        expect(newunit_project_commit_current()).to_equal(true)
        reset_all_pools()
        newunit_register("ProjectOther", "other", TYPE_I64)
        newunit_register("ProjectDup", "new", TYPE_F64)
        expect(newunit_project_commit_current()).to_equal(true)
        expect(newunit_project_count()).to_equal(2)
        expect(newunit_project_find("ProjectDup")).to_equal(0)
        expect(newunit_project_suffix_at(0)).to_equal("new")
        expect(newunit_project_underlying_tag_at(0)).to_equal(TYPE_F64)

    it "retains the first file when the second low-memory file is a cache hit":
        newunit_project_reset()
        reset_all_pools()
        newunit_register("LowMemoryMiss", "lmiss", TYPE_I64)
        expect(newunit_project_commit_current()).to_equal(true)

        # Materialize the second file's codec payload, then discard its live
        # scratch and restore it exactly as frontend_parse_or_restore does on a
        # hit. The restored owners are process-readable and the driver-owned
        # commit must append them without losing the first file.
        reset_all_pools()
        newunit_register("LowMemoryCacheHit", "lhit", TYPE_F64)
        val cached = flat_type_pools_dump()
        reset_all_pools()
        val reader = FlatPoolReader.new(cached)
        expect(flat_type_pools_restore(reader)).to_equal(true)
        expect(newunit_project_commit_current()).to_equal(true)

        expect(newunit_project_count()).to_equal(2)
        expect(newunit_project_find("LowMemoryMiss")).to_equal(0)
        expect(newunit_project_find("LowMemoryCacheHit")).to_equal(1)
