use compiler.common.suffix_registry.{SuffixEntry, SuffixRegistry}

describe "Suffix registry indexed lookup":

    it "preserves first-registration resolution and conflict order":
        val registry = SuffixRegistry.new()
        registry.register("distance", "Meters", "f64", "units.metric")
        registry.register("time", "Seconds", "f64", "units.time")
        registry.register("distance", "Miles", "f64", "units.imperial")
        registry.register("distance", "NauticalMiles", "f64", "units.nautical")

        expect(registry.resolve("distance").?.type_name).to_equal("Meters")
        expect(registry.conflicts("distance").len()).to_equal(3)
        expect(registry.conflicts("distance")[0].type_name).to_equal("Meters")
        expect(registry.conflicts("distance")[1].type_name).to_equal("Miles")
        expect(registry.conflicts("distance")[2].type_name).to_equal("NauticalMiles")
        expect(registry.get_conflicts()[0].existing.type_name).to_equal("Meters")
        expect(registry.get_conflicts()[0].new_entry.type_name).to_equal("Miles")
        expect(registry.get_conflicts()[1].existing.type_name).to_equal("Meters")
        expect(registry.get_conflicts()[1].new_entry.type_name).to_equal("NauticalMiles")

    it "checks visibility only among entries for the requested suffix":
        val registry = SuffixRegistry.new()
        registry.register_with_visibility("distance", "PrivateMeters", "f64", "units.private", false)
        registry.register("time", "Seconds", "f64", "units.time")
        registry.register("distance", "PublicMeters", "f64", "units.public")

        expect(registry.resolve_visible("distance", "consumer").?.type_name).to_equal("PublicMeters")
        expect(registry.resolve_visible("distance", "units.private").?.type_name).to_equal("PrivateMeters")
        expect(registry.resolve_visible("missing", "consumer")).to_be_nil()
        expect(registry.has("time")).to_equal(true)
        expect(registry.has("missing")).to_equal(false)

    it "upgrades registries built through the pre-index constructor shape":
        val old_entry = SuffixEntry(
            suffix: "distance",
            type_name: "Meters",
            value_type: "f64",
            module_path: "units.metric",
            is_public: true
        )
        val registry = SuffixRegistry(
            entries: [old_entry],
            suffix_map: ["distance"],
            entry_map: [old_entry],
            conflicts_list: []
        )

        expect(registry.resolve("distance").?.type_name).to_equal("Meters")
        registry.register_with_visibility("distance", "Miles", "f64", "units.imperial", true)
        expect(registry.resolve("distance").?.type_name).to_equal("Meters")
        expect(registry.conflicts("distance").len()).to_equal(2)
