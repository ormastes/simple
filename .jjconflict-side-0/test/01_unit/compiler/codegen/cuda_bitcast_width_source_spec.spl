# @cover src/compiler/70.backend/backend/cuda_backend.spl 5%
# @tag: unit, compiler, gpu, cuda, source-contract

extern fn rt_file_read_text(path: text) -> text

describe "CUDA bitcast width source contract":
    it "selects matching 32-bit or 64-bit PTX moves":
        val source = rt_file_read_text(
            "src/compiler/70.backend/backend/cuda_backend.spl"
        ) ?? ""

        expect(source).to_contain("if dest_mir_ty.kind != target.kind:")
        expect(source).to_contain("CUDA bitcast destination type must match target type")
        expect(source).to_contain("case I32 | U32 | F32: 32")
        expect(source).to_contain("case I64 | U64 | F64: 64")
        expect(source).to_contain("case Ptr(_, _) | Ref(_, _) | FuncPtr(_): 64")
        expect(source).to_contain("val source_mir_ty = self.operand_mir_type(func, operand)?")
        expect(source).to_contain("if source_width != dest_width:")
        expect(source).to_contain("CUDA bitcast source and target widths must match")
        expect(source).to_contain("builder.emit_line(\"mov.b")
