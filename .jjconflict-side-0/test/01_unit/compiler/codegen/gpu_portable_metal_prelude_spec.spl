# @cover src/compiler/70.backend/backend/gpu_portable_compute.spl 10%
# @tag: unit, compiler, gpu, metal

use compiler.backend.gpu_portable_compute.{PortableComputeTarget, emit_portable_u32_fill_kernel, emit_portable_u32_add_kernel, emit_portable_2d_scroll_u32_kernel, emit_portable_2d_optimization_module}

describe "portable Metal prelude":
    it "emits self-contained standalone and combined sources":
        val prelude = "#include <metal_stdlib>\nusing namespace metal;\n"
        val metal_fill = emit_portable_u32_fill_kernel(PortableComputeTarget.Metal, "simple_2d_fill_u32")
        val metal_add = emit_portable_u32_add_kernel(PortableComputeTarget.Metal, "simple_2d_add_u32")
        val metal_scroll = emit_portable_2d_scroll_u32_kernel(PortableComputeTarget.Metal)
        val metal_module = emit_portable_2d_optimization_module(PortableComputeTarget.Metal)
        val cuda_module = emit_portable_2d_optimization_module(PortableComputeTarget.Cuda)
        val hip_module = emit_portable_2d_optimization_module(PortableComputeTarget.Hip)
        val opencl_module = emit_portable_2d_optimization_module(PortableComputeTarget.OpenCl)
        val webgpu_module = emit_portable_2d_optimization_module(PortableComputeTarget.WebGpu)

        expect(metal_fill.source).to_start_with(prelude)
        expect(metal_add.source).to_start_with(prelude)
        expect(metal_scroll.source).to_start_with(prelude)
        expect(metal_module.source).to_start_with(prelude)
        expect(metal_module.source.split(prelude).len()).to_equal(2)
        expect(metal_module.source).to_contain("kernel void simple_2d_fill_u32(device uint* dst [[buffer(0)]], constant uint& value [[buffer(1)]], constant uint& count [[buffer(2)]]")
        expect(metal_module.source).to_contain("kernel void simple_2d_copy_u32(device const uint* src [[buffer(0)]], device uint* dst [[buffer(1)]], constant uint& count [[buffer(2)]]")
        expect(metal_module.source).to_contain("kernel void simple_2d_alpha_u32(device const uint* src [[buffer(0)]], device uint* dst [[buffer(1)]], constant uint& alpha [[buffer(2)]], constant uint& count [[buffer(3)]]")
        expect(metal_module.source).to_contain("kernel void simple_2d_scroll_u32(device const uint* src [[buffer(0)]], device uint* dst [[buffer(1)]], constant uint& width [[buffer(2)]], constant uint& height [[buffer(3)]], constant int& delta_y [[buffer(4)]]")
        expect(metal_module.source).to_contain("kernel void simple_2d_bitmap_glyph_raster_u32(device const uint* glyph_bits [[buffer(0)]], device uint* dst [[buffer(1)]], constant uint& width [[buffer(2)]], constant uint& height [[buffer(3)]], constant uint& glyph_count [[buffer(4)]], constant uint& font_size [[buffer(5)]], constant uint& color [[buffer(6)]]")
        expect(cuda_module.source.contains(prelude)).to_be(false)
        expect(hip_module.source.contains(prelude)).to_be(false)
        expect(opencl_module.source.contains(prelude)).to_be(false)
        expect(webgpu_module.source.contains(prelude)).to_be(false)
