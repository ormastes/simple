# Fixture for local_shadows_module_global_write_through_spec: a module-level
# `[text]` arena plus a function whose frame-LOCAL array has the same name.
var body_flat: [text] = []

pub fn arena_push(joined: text):
    body_flat.push(joined)

pub fn arena_get(idx: i64) -> text:
    body_flat[idx]

pub fn arena_len() -> i64:
    body_flat.len()

pub fn build_local_with_same_name(n: i64) -> i64:
    # Same name as the module global above, but a different type and a
    # frame local. Pushing into it must never leak into the global.
    var body_flat: [i64] = []
    var i = 0
    while i < n:
        body_flat.push(i * 10)
        i = i + 1
    body_flat.len()
