use std.spec

extern fn rt_file_read_text(path: text) -> text?

describe "match arm bindings stay outside the write-back baseline":
    it "clears dirty tracking after installing arm-local bindings":
        val source = rt_file_read_text("src/compiler_rust/compiler/src/interpreter/expr/control.rs") ?? ""
        val insert_at = source.find("for (name, value) in arm_bindings")
        val clear_at = source.find("arm_env.clear_dirty();")
        val copy_at = source.find("copy_back_block_writes(&arm_env, env)")
        expect(insert_at).to_be_greater_than(-1)
        expect(clear_at).to_be_greater_than(insert_at)
        expect(copy_at).to_be_greater_than(clear_at)
