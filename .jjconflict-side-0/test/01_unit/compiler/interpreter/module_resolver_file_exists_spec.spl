"""
# Module Resolver rt_file_exists Bool/i64 Regression (B5)

Regression for: rt_file_exists_bool_vs_int_interpreted_resolver_2026-06-10

In the interpreter the `extern fn rt_file_exists` returns a native Rust `bool`
(true/false).  The resolver previously compared `rt_file_exists(path) == 1`
which always failed for `true`, causing all path candidates to be rejected.

The fix: declare the return type as `bool` and use the result directly as a
condition (no `== 1`).

This spec drives the resolver directly and verifies that known-good stdlib paths
resolve to non-empty strings — confirming the bool-path is taken correctly.
"""

use compiler.core.interpreter.module_loader_resolve.{
    resolve_module_path,
    module_resolve_cache_reset,
    module_resolve_uncached_count,
    module_resolve_cache_entry_count,
    module_resolve_cache_eviction_count,
    module_resolve_cache_telemetry
}
use compiler.driver.watcher.source_mutation.{
    watcher_source_created,
    watcher_source_edited,
    watcher_source_deleted,
    watcher_source_moved
}
use std.io_runtime.{dir_create_all, file_write, file_delete, getpid}
use app.io.mod.{file_rename}

fn check_std_ctype_resolves() -> text:
    module_resolve_cache_reset()
    val path = resolve_module_path("std.ctype", "test/01_unit/compiler/interpreter/module_resolver_file_exists_spec.spl")
    if path == "":
        return "resolve_module_path(std.ctype) returned empty — rt_file_exists bool/i64 mismatch likely"
    ""

fn check_std_io_runtime_resolves() -> text:
    module_resolve_cache_reset()
    val path = resolve_module_path("std.io_runtime", "test/01_unit/compiler/interpreter/module_resolver_file_exists_spec.spl")
    if path == "":
        return "resolve_module_path(std.io_runtime) returned empty — rt_file_exists bool/i64 mismatch likely"
    ""

fn check_nonexistent_returns_nonempty_fallback() -> text:
    # The resolver returns the relative path even when the file doesn't exist (will error later).
    # Important: it should NOT return "" for a resolvable-pattern name.
    module_resolve_cache_reset()
    val path = resolve_module_path("std.definitely_nonexistent_xyz_abc", "test/01_unit/compiler/interpreter/module_resolver_file_exists_spec.spl")
    # Returns the attempted path (not empty), even on miss.
    if path == "":
        return "resolver returned empty string for unknown module — unexpected"
    ""

use std.spec.step

describe "module_resolver rt_file_exists bool regression":
    """Verifies the resolver correctly resolves stdlib modules under the interpreter
    where rt_file_exists returns bool (not i64==1). Bug: B5 / 2026-06-10."""

    it "resolves std.ctype to a non-empty path":
        val err = check_std_ctype_resolves()
        expect(err).to_equal("")

    it "resolves std.io_runtime to a non-empty path":
        val err = check_std_io_runtime_resolves()
        expect(err).to_equal("")

    it "returns non-empty fallback path for unknown module":
        val err = check_nonexistent_returns_nonempty_fallback()
        expect(err).to_equal("")

    it "reuses an exact unresolved result within one cache generation":
        step("Verify: reuses an exact unresolved result within one cache generation")
        module_resolve_cache_reset()
        val module_name = "std.definitely_nonexistent_negative_cache_exact"
        val caller = "test/01_unit/compiler/interpreter/module_resolver_file_exists_spec.spl"
        val first = resolve_module_path(module_name, caller)
        val second = resolve_module_path(module_name, caller)
        expect(second).to_equal(first)
        expect(module_resolve_uncached_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "keeps caller-sensitive entries separate and reset invalidates them":
        step("Verify: keeps caller-sensitive entries separate and reset invalidates them")
        module_resolve_cache_reset()
        val module_name = "definitely_nonexistent_negative_cache_adjacent"
        val first = resolve_module_path(module_name, "test/01_unit/a.spl")
        val adjacent = resolve_module_path(module_name, "test/03_system/b.spl")
        expect(adjacent).to_equal(first)
        expect(module_resolve_uncached_count()).to_equal(2)  # oracle: 2 — named expected value from the requirement

        module_resolve_cache_reset()
        val after_reset = resolve_module_path(module_name, "test/01_unit/a.spl")
        expect(after_reset).to_equal(first)
        expect(module_resolve_uncached_count()).to_equal(1)

    it "bounds unique caller-sensitive misses and evicts the oldest entries":
        module_resolve_cache_reset()
        val caller = "/tmp/simple_loader_cache_bound/main.spl"
        for i in 0..300:
            resolve_module_path("loader_cache_unique_miss_" + i.to_text(), caller)
        assert_true(module_resolve_cache_entry_count() <= 256)
        assert_true(module_resolve_cache_eviction_count() > 0)

    it "invalidates cached paths after create edit move and delete events":
        val root = "/tmp/simple_loader_cache_events_" + getpid().to_text()
        val caller = root + "/main.spl"
        val original_name = "loader_cache_event_original"
        val moved_name = "loader_cache_event_moved"
        val original_path = root + "/" + original_name + ".spl"
        val moved_path = root + "/" + moved_name + ".spl"
        dir_create_all(root)
        file_delete(original_path)
        file_delete(moved_path)

        module_resolve_cache_reset()
        val before_create = resolve_module_path(original_name, caller)
        expect(before_create).to_equal(original_name + ".spl")

        val _created = file_write(original_path, "fn cache_event_value() -> i64:\n    1\n")
        expect(watcher_source_created(original_path)).to_equal(1)
        expect(resolve_module_path(original_name, caller)).to_equal(original_path)

        val before_edit_uncached = module_resolve_uncached_count()
        val _edited = file_write(original_path, "fn cache_event_value() -> i64:\n    2\n")
        expect(watcher_source_edited(original_path)).to_equal(1)
        expect(resolve_module_path(original_name, caller)).to_equal(original_path)
        expect(module_resolve_uncached_count()).to_equal(before_edit_uncached + 1)

        val _moved = file_rename(original_path, moved_path)
        expect(watcher_source_moved(original_path, moved_path)).to_equal(1)
        expect(resolve_module_path(original_name, caller)).to_equal(original_name + ".spl")
        expect(resolve_module_path(moved_name, caller)).to_equal(moved_path)

        val _deleted = file_delete(moved_path)
        expect(watcher_source_deleted(moved_path)).to_equal(2)
        expect(resolve_module_path(moved_name, caller)).to_equal(moved_name + ".spl")
        val telemetry = module_resolve_cache_telemetry()
        expect(telemetry.entries).to_equal(1)
        expect(telemetry.uncached_resolutions).to_equal(6)
        expect(telemetry.total_invalidations).to_equal(5)
        expect(telemetry.fast_invalidations).to_equal(0)
        expect(telemetry.precise_full_invalidations).to_equal(5)
        expect(telemetry.fail_closed_full_invalidations).to_equal(0)
        expect(telemetry.normalization_ambiguities).to_equal(1)
        expect(telemetry.mutation_events).to_equal(4)
        expect(telemetry.mutation_paths).to_equal(5)
        expect(telemetry.create_events).to_equal(1)
        expect(telemetry.edit_events).to_equal(1)
        expect(telemetry.delete_events).to_equal(1)
        expect(telemetry.move_events).to_equal(1)

    it "fails closed on an unmatched producer spelling despite fast invalidation":
        val root = "/tmp/simple_loader_cache_spelling_" + getpid().to_text()
        val caller = root + "/main.spl"
        val module_name = "loader_cache_spelling_target"
        val target_path = root + "/" + module_name + ".spl"
        val producer_spelling = root + "/./" + module_name + ".spl"
        dir_create_all(root)
        file_delete(target_path)
        val _created = file_write(target_path, "fn cache_spelling_value() -> i64:\n    1\n")

        module_resolve_cache_reset()
        expect(resolve_module_path(module_name, caller)).to_equal(target_path)
        assert_true(resolve_module_path("std.ctype", caller) != "")
        expect(module_resolve_cache_entry_count()).to_equal(3)

        val _edited = file_write(target_path, "fn cache_spelling_value() -> i64:\n    2\n")
        expect(watcher_source_edited(producer_spelling)).to_equal(3)
        val telemetry = module_resolve_cache_telemetry()
        expect(telemetry.entries).to_equal(0)
        expect(telemetry.total_invalidations).to_equal(3)
        expect(telemetry.fast_invalidations).to_equal(1)
        expect(telemetry.precise_full_invalidations).to_equal(0)
        expect(telemetry.fail_closed_full_invalidations).to_equal(2)
        expect(telemetry.normalization_ambiguities).to_equal(1)
        expect(telemetry.mutation_events).to_equal(1)
        expect(telemetry.mutation_paths).to_equal(1)
        expect(telemetry.edit_events).to_equal(1)
        expect(resolve_module_path(module_name, caller)).to_equal(target_path)
        file_delete(target_path)
