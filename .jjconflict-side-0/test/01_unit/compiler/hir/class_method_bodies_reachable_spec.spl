# @cover src/compiler/20.hir/hir_lowering/_Items/declaration_lowering.spl
# Lane CLSM (class-method-bodies-reachable), mission-critical robustness
# campaign, lane G2 follow-up.
#
# ARCHITECTURE NOTE (discovered while writing this spec, 2026-07-29): the flat
# AST bridge (`_FlatAstBridge/module_assembly.spl`, tag_text branch for
# struct/class decls) ALWAYS constructs `Class.methods` as an empty dict for
# a `class X:` with embedded `me foo(): ...` bodies -- the methods are instead
# carried as a synthesized inherent `impl X:` block (tag_text == "9"), "the
# same mechanism plain structs already use" (see that file's comment). This
# means `declaration_lowering.spl`'s `lower_class` loop over
# `class_.methods.keys()` is NEVER populated with real entries on the current
# parser pipeline -- it is not reachable dead code, not a live crash source.
# Class-embedded method BODIES were already reaching `module.functions` today
# via the synthesized-impl + `lowered_impl_functions` merge path (proven by
# this spec's first two `it` blocks passing pre-fix). This spec still
# verifies `lower_class` now ALSO forwards any real `class_.methods` entries
# into `self.lowered_impl_functions` (mirroring
# `trait_impl_lowering.spl:204`), so the merge behaves consistently for
# BOTH sources if/when the frontend ever changes to populate `Class.methods`
# directly -- and locks in that the current synthesized-impl path keeps
# working (regression).
#
# HARNESS NOTE (per enum_match_unknown_variant_diagnostic_spec.spl and
# param_mutability_semantic_spec.spl headers): the
# parse_full_frontend -> HirLowering -> lower_module pipeline is inlined in
# every `it` block ON PURPOSE -- a module-level helper fn has been observed
# to read back lowering state that does not match what the inline form
# produces for the same fixture. Do not factor this into a shared helper.
#
# RECEIVER NOTE: fixtures deliberately use `self.field` inside `me foo():`
# bodies, not `me.field`. The prefix `me foo():` form synthesizes a receiver
# actually named `self` (parser_decls_use.spl's parse_class_body_method);
# `me` is aliased back to `self` for a single top-level occurrence but 4
# `unresolved name: me` lowering errors were observed here with 2
# `me`-methods in one class -- an unrelated, out-of-scope aliasing gap, not
# this lane's target.

use std.spec
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*

describe "class-embedded method bodies reachable from HirModule.functions":
    it "makes both HirFunctions of a 2-method class present in module.functions with non-empty bodies":
        val src = "class Box:\n" +
            "    value: i64\n" +
            "    me set_value(next: i64) -> i64:\n" +
            "        self.value = next\n" +
            "        self.value\n" +
            "    me double(next: i64) -> i64:\n" +
            "        self.value = next * 2\n" +
            "        self.value\n"
        val parsed = parse_full_frontend(src, "testdata/clsm_two_methods.spl", "clsm_two_methods", Logger(level: 0))
        var hir_lowering = HirLowering.with_filename("testdata/clsm_two_methods.spl")
        val hir = hir_lowering.lower_module(parsed)
        expect(hir_lowering.errors.len()).to_equal(0)

        var found_class = false
        for class_ in hir.classes.values():
            if class_.name == "Box":
                found_class = true
        expect(found_class).to_equal(true)

        var found_set_value = false
        var found_double = false
        for fn_ in hir.functions.values():
            if fn_.name == "set_value":
                found_set_value = true
                expect(fn_.body.stmts.len() > 0).to_equal(true)
                # Walk for a known statement: the first statement of the
                # method body is the `self.value = ...` assignment.
                var has_assign = false
                match fn_.body.stmts[0].kind:
                    case Assign(_, _, _):
                        has_assign = true
                    case _:
                        pass
                expect(has_assign).to_equal(true)
            if fn_.name == "double":
                found_double = true
                expect(fn_.body.stmts.len() > 0).to_equal(true)
                var has_assign = false
                match fn_.body.stmts[0].kind:
                    case Assign(_, _, _):
                        has_assign = true
                    case _:
                        pass
                expect(has_assign).to_equal(true)
        expect(found_set_value).to_equal(true)
        expect(found_double).to_equal(true)

    it "keeps both a class method and a top-level fn reachable in the same module":
        val src = "fn helper() -> i64:\n" +
            "    99\n" +
            "\n" +
            "class Box:\n" +
            "    value: i64\n" +
            "    me set_value(next: i64) -> i64:\n" +
            "        self.value = next\n" +
            "        self.value\n"
        val parsed = parse_full_frontend(src, "testdata/clsm_mixed.spl", "clsm_mixed", Logger(level: 0))
        var hir_lowering = HirLowering.with_filename("testdata/clsm_mixed.spl")
        val hir = hir_lowering.lower_module(parsed)

        var found_helper = false
        var found_method = false
        for fn_ in hir.functions.values():
            if fn_.name == "helper":
                found_helper = true
                expect(fn_.body.stmts.len() >= 0).to_equal(true)
            if fn_.name == "set_value":
                found_method = true
                expect(fn_.body.stmts.len() > 0).to_equal(true)
        expect(found_helper).to_equal(true)
        expect(found_method).to_equal(true)

    it "keeps an impl-block method reachable too (regression, pre-existing merge path)":
        val src = "struct Counter:\n" +
            "    n: i64\n" +
            "\n" +
            "impl Counter:\n" +
            "    me bump():\n" +
            "        self.n = self.n + 1\n"
        val parsed = parse_full_frontend(src, "testdata/clsm_impl_regression.spl", "clsm_impl_regression", Logger(level: 0))
        var hir_lowering = HirLowering.with_filename("testdata/clsm_impl_regression.spl")
        val hir = hir_lowering.lower_module(parsed)
        expect(hir_lowering.errors.len()).to_equal(0)

        var found_bump = false
        for fn_ in hir.functions.values():
            if fn_.name == "bump":
                found_bump = true
                expect(fn_.body.stmts.len() > 0).to_equal(true)
        expect(found_bump).to_equal(true)
