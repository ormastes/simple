# @tag: engine2d, rendering
"""# Engine2D damage-mirror invalidation forwarding

Reproduces the hosted-compositor failures `method
`invalidate_damage_mirror` not found on type `Engine2D`` and `... on type
`SoftwareBackend``: the retained damage mirror shipped `read_pixels_damaged`
forwarders on both the Engine2D facade and the software backend without the
companion `invalidate_damage_mirror` forwarder, so a full-frame write made
outside a retained damage transaction was served stale mirror pixels.

The compositor backend is the entry point because it is the exact caller that
failed -- `compositor_engine2d.spl` invalidates the mirror at three
full-frame sites.
"""

use std.spec.*
use std.common.ui.draw_ir.{
    DrawIrCommand,
    draw_ir_batch,
    draw_ir_composition,
    draw_ir_embedding_config,
    draw_ir_rect
}
use std.gc_async_mut.io.time_ops.{time_now_nanos}
use std.gc_async_mut.io.mod_stub.{env_get}
use os.compositor.compositor_engine2d.{Engine2dCompositorBackend}

fn mirror_spec_composition():
    val embedding = draw_ir_embedding_config(
        "web", "body", 0, 0, 32, 32, 0, 1000, true)
    draw_ir_composition(
        "invalidate-mirror", "hosted-web", "software", [
            draw_ir_batch("body", "software", embedding, [
                draw_ir_rect("cell", 0, 0, 32, 32, 0xFF2563EBu32)
            ])
        ])

describe "Engine2D damage-mirror invalidation":
    it "forwards invalidate_damage_mirror from Engine2D to the backend":
        val _unused_env = env_get("SIMPLE_ENGINE2D_MIRROR_SPEC") ?? ""
        val _unused_clock = time_now_nanos()
        var raster = Engine2dCompositorBackend.create_named(32, 32, "software")
        val rendered = raster.render_draw_ir_composition_resources_revision(
            mirror_spec_composition(), [], 7, 1)
        expect(rendered.pixels.len()).to_equal(1024)
        # positive control: the companion damaged-read forwarder is reachable
        # and seeds the retained mirror.
        expect(raster.engine.read_pixels_damaged(64).len()).to_equal(1024)
        # defect class: the invalidation companion must exist on the facade
        # AND resolve through to the software backend's retained mirror.
        raster.engine.invalidate_damage_mirror()
        # reseeding after invalidation still yields the full surface
        expect(raster.engine.read_pixels_damaged(64).len()).to_equal(1024)
