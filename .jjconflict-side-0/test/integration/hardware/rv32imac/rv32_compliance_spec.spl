"""
## Purpose and audience

# RV32IMAC Compliance Test Harness

**Feature IDs:** #RV32-COMPLIANCE-001
**Category:** Hardware
**Difficulty:** 4/5
**Status:** In Progress

## Overview

Harness for running riscv-arch-test compliance suite.
Compiles test programs, loads into simulation ROM, and compares signatures.

This specification is maintained for compiler and library engineers reviewing INTEGRATION-HARDWARE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/integration/hardware/rv32imac/rv32_compliance_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-INTEGRATION-HARDWARE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @req REQ-RV32IMAC
# @feature rv32imac
# tag: only-compiled, vhdl, slow

use std.spec.*

use hardware.rv64gc.core.rv64_execute.alu_execute
use hardware.rv64gc.ext.rv64_muldiv.muldiv_execute
use hardware.rv64gc.ext.rv64_atomics.{ReservationSet64, amo_execute}
use hardware.riscv_common.pkg.riscv_types_pkg.{AluOp, MulDivOp, AmoOp}

describe "RV32I Compliance":
    """
    ## RV32I Base Integer Instruction Set

    Tests all RV32I instructions using computed expected values.
    """

    it "ADD: rd = rs1 + rs2":
        # @req REQ-SSPEC-INTEGRATION
        step("ADD: rd = rs1 + rs2")
        expect(alu_execute(AluOp.Add, 100, 200)).to_equal(300)
        expect(alu_execute(AluOp.Add, 0xFFFFFFFF, 1)).to_equal(0)  # Overflow wraps

    it "SUB: rd = rs1 - rs2":
        # @req REQ-SSPEC-INTEGRATION
        step("SUB: rd = rs1 - rs2")
        expect(alu_execute(AluOp.Sub, 200, 100)).to_equal(100)
        expect(alu_execute(AluOp.Sub, 0, 1)).to_equal(0xFFFFFFFF)  # Underflow wraps

    it "AND/OR/XOR: bitwise operations":
        # @req REQ-SSPEC-INTEGRATION
        step("AND/OR/XOR: bitwise operations")
        expect(alu_execute(AluOp.And, 0xF0F0, 0xFF00)).to_equal(0xF000)
        expect(alu_execute(AluOp.Or, 0xF0F0, 0x0F0F)).to_equal(0xFFFF)
        expect(alu_execute(AluOp.Xor, 0xFFFF, 0xF0F0)).to_equal(0x0F0F)

    it "SLL/SRL/SRA: shift operations":
        # @req REQ-SSPEC-INTEGRATION
        step("SLL/SRL/SRA: shift operations")
        expect(alu_execute(AluOp.Sll, 1, 10)).to_equal(1024)
        expect(alu_execute(AluOp.Srl, 1024, 10)).to_equal(1)

    it "SLT/SLTU: comparison operations":
        # @req REQ-SSPEC-INTEGRATION
        step("SLT/SLTU: comparison operations")
        # Signed: -1 < 0
        expect(alu_execute(AluOp.Slt, 0xFFFFFFFF, 0)).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        # Unsigned: 0xFFFFFFFF > 0
        expect(alu_execute(AluOp.Sltu, 0xFFFFFFFF, 0)).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

describe "RV32M Compliance":
    """
    ## M Extension

    Tests MUL/DIV/REM operations including edge cases.
    """

    it "MUL: rd = (rs1 * rs2)[31:0]":
        # @req REQ-SSPEC-INTEGRATION
        step("MUL: rd = (rs1 * rs2)[31:0]")
        expect(muldiv_execute(MulDivOp.Mul, 7, 6)).to_equal(42)

    it "MUL: handles overflow":
        expect(muldiv_execute(MulDivOp.Mul, 0x80000000, 2) and 0xFFFFFFFF).to_equal(0)

    it "DIV: rd = rs1 / rs2 (signed)":
        expect(muldiv_execute(MulDivOp.Div, 20, 3)).to_equal(6)

    it "DIV: division by zero returns all ones":
        # @req REQ-SSPEC-INTEGRATION
        step("DIV: division by zero returns all ones")
        # Use var to prevent const-evaluator from folding 42/0
        var zero = 0
        expect(muldiv_execute(MulDivOp.Div, 42, zero) and 0xFFFFFFFF).to_equal(0xFFFFFFFF)

    it "DIVU: unsigned division":
        # @req REQ-SSPEC-INTEGRATION
        step("DIVU: unsigned division")
        expect(muldiv_execute(MulDivOp.Divu, 20, 3)).to_equal(6)

    it "REM: remainder":
        expect(muldiv_execute(MulDivOp.Rem, 20, 3)).to_equal(2)

    it "REMU: unsigned remainder":
        # @req REQ-SSPEC-INTEGRATION
        step("REMU: unsigned remainder")
        expect(muldiv_execute(MulDivOp.Remu, 20, 3)).to_equal(2)

describe "RV32A Compliance":
    """
    ## A Extension

    Tests LR/SC reservation mechanism and AMO operations.
    """

    it "LR/SC succeeds on uncontested reservation":
        # @req REQ-SSPEC-INTEGRATION
        step("LR/SC succeeds on uncontested reservation")
        """
        **Given:** Fresh reservation set
        **When:** LR then SC to same address
        **Then:** SC succeeds (returns true)
        """
        var rs = ReservationSet64.create()
        rs.reserve(0x80000100)
        val success = rs.check_and_clear(0x80000100)
        expect(success).to_equal(true)

    it "SC fails after intervening store":
        # @req REQ-SSPEC-INTEGRATION
        step("SC fails after intervening store")
        """
        **Given:** Active reservation
        **When:** Intervening store to same address, then SC
        **Then:** SC fails (returns false)
        """
        var rs = ReservationSet64.create()
        rs.reserve(0x80000100)
        rs.invalidate()
        val success = rs.check_and_clear(0x80000100)
        expect(success).to_equal(false)

    it "AMOADD computes correctly":
        # @req REQ-SSPEC-INTEGRATION
        step("AMOADD computes correctly")
        expect(amo_execute(AmoOp.Add, 100, 50).new_value).to_equal(150)

    it "AMOSWAP returns rs2":
        expect(amo_execute(AmoOp.Swap, 100, 200).new_value).to_equal(200)

    it "AMOAND computes correctly":
        # @req REQ-SSPEC-INTEGRATION
        step("AMOAND computes correctly")
        expect(amo_execute(AmoOp.And, 0xFF00, 0x0FF0).new_value).to_equal(0x0F00)
