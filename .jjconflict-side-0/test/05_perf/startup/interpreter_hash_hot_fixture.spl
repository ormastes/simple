"""Stable explicitly-owned interpreter hash-memo workload."""

use compiler.core.interpreter.hashmap.{hm_hash_memo_new, hm_hash_text_memoized}

fn main() -> i64:
    val memo = hm_hash_memo_new(8)
    var checksum: i64 = 0
    var i: i64 = 0
    while i < 25000:
        checksum = checksum + (hm_hash_text_memoized(memo, "eval_current_decl_id") & 65535)
        checksum = checksum + (hm_hash_text_memoized(memo, "frame_locals") & 65535)
        checksum = checksum + (hm_hash_text_memoized(memo, "module_loader_cache") & 65535)
        checksum = checksum + (hm_hash_text_memoized(memo, "café_binding") & 65535)
        i = i + 1
    print("hash-hot {i} {checksum} hits={memo.hits} misses={memo.misses}")
    if i == 25000 and checksum == 3338400000 and memo.hits == 99996 and memo.misses == 4: 0 else: 1
