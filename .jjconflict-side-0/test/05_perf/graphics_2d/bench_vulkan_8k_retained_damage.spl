# Native Vulkan 8K retained-damage evidence benchmark.
# Measures one 64x64 dynamic rectangle per frame after a full mirror seed.
# The timed interval includes compute submission, completion, exact strided
# device-to-host transfer, and host-mirror patching. It excludes initialization,
# the first full seed, final checksum, and shutdown.

use std.gc_async_mut.gpu.engine2d.backend_vulkan.VulkanBackend
use std.gc_async_mut.gpu.engine2d.color.rgb
use std.nogc_sync_mut.gpu.engine2d.sffi_vulkan.{
    vulkan_sffi_selected_device_driver_identity_hash
}
use common.ui.render_opt.damage_plan.{DamageFramePlan, DAMAGE_PLAN_LOCAL, DAMAGE_FALLBACK_NONE}

extern fn rt_time_now_nanos() -> i64
extern fn rt_file_read_text(path: text) -> text

val FRAME_W: i32 = 7680
val FRAME_H: i32 = 4320
val DAMAGE_X: i32 = 320
val DAMAGE_Y: i32 = 256
val DAMAGE_W: i32 = 64
val DAMAGE_H: i32 = 64
val WARMUP_FRAMES: i64 = 10
val TIMED_FRAMES: i64 = 200
val SEED_ROWS: i32 = 64

fn exact_damage_plan() -> DamageFramePlan:
    DamageFramePlan(
        rects: [DAMAGE_X as i64, DAMAGE_Y as i64, DAMAGE_W as i64, DAMAGE_H as i64],
        mode: DAMAGE_PLAN_LOCAL,
        source_tile_count: 1, output_rect_count: 1, merged_tile_count: 0,
        dirty_pixels: (DAMAGE_W as i64) * (DAMAGE_H as i64),
        planned_pixels: (DAMAGE_W as i64) * (DAMAGE_H as i64),
        tiles_examined: 1, full_fallback_count: 0,
        fallback_reason: DAMAGE_FALLBACK_NONE)

fn strip_damage_plan(y: i32, rows: i32) -> DamageFramePlan:
    val pixels = (FRAME_W as i64) * (rows as i64)
    DamageFramePlan(
        rects: [0, y as i64, FRAME_W as i64, rows as i64],
        mode: DAMAGE_PLAN_LOCAL,
        source_tile_count: 1, output_rect_count: 1, merged_tile_count: 0,
        dirty_pixels: pixels, planned_pixels: pixels,
        tiles_examined: 1, full_fallback_count: 0,
        fallback_reason: DAMAGE_FALLBACK_NONE)

fn seed_retained_mirror(backend: VulkanBackend) -> bool:
    # Avoid one 132.7 MB staging allocation. The strided runtime admits at most
    # 64 MiB packed per call. Full-width 64-row strips are 1.97 MB each,
    # keeping the JIT byte-array conversion comfortably bounded as well.
    # host_buf is already full-sized. It becomes valid only after every exact
    # strip has been copied from the completed device clear.
    if not backend.submit_batch():
        return false
    backend.host_mirror_valid = true
    var y: i32 = 0
    while y < FRAME_H:
        var rows = SEED_ROWS
        if y + rows > FRAME_H:
            rows = FRAME_H - y
        if not backend.present_damage_plan(strip_damage_plan(y, rows)):
            backend.host_mirror_valid = false
            return false
        y = y + rows
    true

fn sort_samples(samples: [i64]):
    var i: i64 = 1
    while i < samples.len():
        val key = samples[i]
        var j = i - 1
        while j >= 0 and samples[j] > key:
            samples[j + 1] = samples[j]
            j = j - 1
        samples[j + 1] = key
        i = i + 1

fn percentile(samples: [i64], percent: i64) -> i64:
    var index = samples.len() * percent / 100
    if index >= samples.len():
        index = samples.len() - 1
    samples[index]

fn rss_kb() -> i64:
    val status = rt_file_read_text("/proc/self/status")
    val marker = "VmRSS:"
    val start = status.find(marker)
    if start < 0:
        return 0
    var i = start + marker.len()
    while i < status.len() and (status[i] == ' ' or status[i] == '\t'):
        i = i + 1
    var value: i64 = 0
    while i < status.len() and status[i] >= '0' and status[i] <= '9':
        value = value * 10 + (status[i] as i64 - '0' as i64)
        i = i + 1
    value

fn draw_frame(backend: VulkanBackend, frame: i64, plan: DamageFramePlan) -> bool:
    val colour = if frame % 2 == 0: rgb(230, 40, 70) else: rgb(30, 200, 110)
    backend.draw_rect_filled(DAMAGE_X, DAMAGE_Y, DAMAGE_W, DAMAGE_H, colour)
    backend.present_damage_plan(plan)

fn main():
    var backend = VulkanBackend.create()
    if not backend.init(FRAME_W, FRAME_H):
        print("VULKAN_8K_RETAINED status=unavailable reason=" + backend.last_error)
        return
    print("VULKAN_8K_LIFETIME post_init=" + backend.host_buf.len().to_i64().to_string())
    backend.enable_frame_batching()
    backend.clear(rgb(4, 8, 12))
    if not seed_retained_mirror(backend):
        print("VULKAN_8K_RETAINED status=fail reason=mirror-seed")
        backend.shutdown()
        return
    print("VULKAN_8K_LIFETIME post_seed=" + backend.host_buf.len().to_i64().to_string())

    val plan = exact_damage_plan()
    var warmup: i64 = 0
    while warmup < WARMUP_FRAMES:
        if not draw_frame(backend, warmup, plan):
            print("VULKAN_8K_RETAINED status=fail reason=warmup-transfer")
            backend.shutdown()
            return
        warmup = warmup + 1
    print("VULKAN_8K_LIFETIME post_warmup=" + backend.host_buf.len().to_i64().to_string())

    val calls_before = backend.damage_readback_calls
    val bytes_before = backend.damage_readback_bytes
    val fallback_before = backend.damage_full_fallbacks
    var samples: [i64] = [0; TIMED_FRAMES]
    var frame: i64 = 0
    while frame < TIMED_FRAMES:
        val started = rt_time_now_nanos()
        val completed = draw_frame(backend, frame + WARMUP_FRAMES, plan)
        val elapsed = rt_time_now_nanos() - started
        if not completed:
            print("VULKAN_8K_RETAINED status=fail reason=timed-transfer frame=" + frame.to_string())
            backend.shutdown()
            return
        samples[frame] = elapsed
        frame = frame + 1
    print("VULKAN_8K_LIFETIME post_timed=" + backend.host_buf.len().to_i64().to_string())
    sort_samples(samples)

    val p50 = percentile(samples, 50)
    val p95 = percentile(samples, 95)
    val transferred_calls = backend.damage_readback_calls - calls_before
    val transferred_bytes = backend.damage_readback_bytes - bytes_before
    val full_fallbacks = backend.damage_full_fallbacks - fallback_before
    val expected_bytes = TIMED_FRAMES * (DAMAGE_W as i64) * (DAMAGE_H as i64) * 4
    val retained_len = backend.host_buf.len()
    if retained_len != FRAME_W * FRAME_H:
        print("VULKAN_8K_RETAINED status=fail reason=retained-length")
        backend.shutdown()
        return
    val background = rgb(4, 8, 12)
    val final_damage = rgb(30, 200, 110)
    val outside_sample = backend.host_buf[0]
    val damage_sample = backend.host_buf[DAMAGE_Y * FRAME_W + DAMAGE_X]
    val edge_sample = backend.host_buf[FRAME_W * FRAME_H - 1]
    val sampled_checksum = outside_sample.to_i64() + damage_sample.to_i64() * 3 + edge_sample.to_i64() * 7
    val sampled_parity = (outside_sample == background and damage_sample == final_damage and
        edge_sample == background and sampled_checksum != 0)
    val meets_target = (p95 <= 12500000 and transferred_calls == TIMED_FRAMES and
        transferred_bytes == expected_bytes and full_fallbacks == 0 and
        not backend.cpu_fallback_used and not backend.completion_unknown and sampled_parity)
    # Keep each receipt short. One very long concatenation currently collapses
    # to an empty text value under strict JIT, destroying otherwise valid data.
    print("VULKAN_8K_RETAINED result status=" + (if meets_target: "pass" else: "fail") +
        " viewport=7680x4320 backend=vulkan_compute_retained frames=" + TIMED_FRAMES.to_string())
    print("VULKAN_8K_RETAINED timing p50_ns=" + p50.to_string() +
        " p95_ns=" + p95.to_string() + " target_p95_ns=12500000 rss_kb=" + rss_kb().to_string())
    print("VULKAN_8K_RETAINED transfer calls=" + transferred_calls.to_string() +
        " bytes=" + transferred_bytes.to_string() + " expected_bytes=" + expected_bytes.to_string() +
        " full_fallbacks=" + full_fallbacks.to_string())
    print("VULKAN_8K_RETAINED proof cpu_fallback=" + backend.cpu_fallback_used.to_string() +
        " completion_unknown=" + backend.completion_unknown.to_string() +
        " readback_mode=partial_host_cache sampled_parity=" + sampled_parity.to_string() +
        " sampled_checksum=" + sampled_checksum.to_string())
    print("VULKAN_8K_RETAINED samples outside=" + outside_sample.to_i64().to_string() +
        " damage=" + damage_sample.to_i64().to_string() + " edge=" + edge_sample.to_i64().to_string())
    print("VULKAN_8K_RETAINED device identity_hash=" +
        vulkan_sffi_selected_device_driver_identity_hash().to_string())
    backend.shutdown()

main()
