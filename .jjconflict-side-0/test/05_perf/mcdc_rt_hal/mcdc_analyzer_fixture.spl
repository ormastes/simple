# Scaling fixture for the expected-O(E*C) MC/DC analyzer contract.

use test.perf.bench.lib.timing.{bench_now_ns}
use std.nogc_sync_mut.cli.{get_cli_args}
use std.common.mcdc.model.{McdcEvaluation}
use std.nogc_sync_mut.mcdc.analyzer.{analyze_mcdc}

fn bench_arg(name: text, fallback: text) -> text:
    val prefix = "--" + name + "="
    for argument in get_cli_args():
        if argument.starts_with(prefix): return argument.substring(prefix.len())
    fallback

fn evaluations(count: i64, condition_count: i64) -> [McdcEvaluation]:
    var rows: [McdcEvaluation] = []
    var i: i64 = 0
    val low_mask = if condition_count >= 64: -1 else: (1 << condition_count) - 1
    val high_count = condition_count - 64
    val high_mask = if high_count <= 0: 0 elif high_count >= 64: -1 else: (1 << high_count) - 1
    while i < count:
        val values0 = (i * 1103515245 + 12345) & low_mask
        val values1 = ((i + 17) * 214013 + 2531011) & high_mask
        rows.push(McdcEvaluation(
            decision_id: 1, owner_id: 1, sequence: i + 1,
            outcome: (values0 & 1) != 0,
            evaluated_mask0: low_mask, evaluated_mask1: high_mask,
            evaluated_mask2: 0, evaluated_mask3: 0,
            true_mask0: values0, true_mask1: values1,
            true_mask2: 0, true_mask3: 0,
            masked_mask0: 0, masked_mask1: 0,
            masked_mask2: 0, masked_mask3: 0
        ))
        i = i + 1
    rows

fn main():
    val scale = bench_arg("scale", "base")
    val evaluation_count: i64 = if scale == "double-e": 8192 else: 4096
    val condition_count: i64 = if scale == "double-c": 64 else: 32
    val rows = evaluations(evaluation_count, condition_count)
    val start = bench_now_ns()
    val result = analyze_mcdc(rows, condition_count, evaluation_count * 4)
    val elapsed = bench_now_ns() - start
    print "lane=analyzer-{scale} iterations={evaluation_count} elapsed_ns={elapsed} checksum={result.evaluated_rows + result.signature_count + result.condition_count} saturated={result.saturated}"
