# A7 §18.4 control: 3 hand-monomorphic copies, 1M iterations each.
extern fn rt_time_now_nanos() -> i64

fn combine_i64(a: i64, b: i64) -> i64: a + b
fn combine_f64(a: f64, b: f64) -> f64: a + b
fn combine_text(a: text, b: text) -> text: a + b

fn main():
    val iters: i64 = 1000000
    var ai: i64 = 0
    var af: f64 = 0.0
    var at: text = ""
    val t0 = rt_time_now_nanos()
    var i: i64 = 0
    while i < iters:
        ai = combine_i64(ai, 1)
        af = combine_f64(af, 1.0)
        at = combine_text("a", "b")
        i = i + 1
    val t1 = rt_time_now_nanos()
    print "BENCH mono_3copies {(t1 - t0) / (iters * 3)}"
    if ai == 12345678987654321: print "# sink {af} {at}"

main()
