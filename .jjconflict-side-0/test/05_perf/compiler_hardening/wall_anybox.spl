# A7 wall/RSS baseline: Any boxing loop — box i64/f64/text into Any and unbox, 300k iterations.
fn as_i64(x: Any) -> i64:
    x.to_i64()

fn main():
    var acc: i64 = 0
    var i: i64 = 0
    while i < 300000:
        val b: Any = i
        val c: Any = "x"
        val d: Any = 1.5
        acc = acc + as_i64(b)
        if c.to_text() == "y": acc = acc + 1
        if d.to_f64() > 9.0: acc = acc + 1
        i = i + 1
    print "anybox done {acc}"

main()
