# A7 §18.3: Any-typed arithmetic loop (boxing + tag checks), 1M iterations.
extern fn rt_time_now_nanos() -> i64

fn main():
    val iters: i64 = 1000000
    var acc: i64 = 0
    val t0 = rt_time_now_nanos()
    var i: i64 = 0
    while i < iters:
        var x: Any = i
        x = x + 3
        x = x * 2
        x = x - 1
        acc = acc + (x & 1023)
        i = i + 1
    val t1 = rt_time_now_nanos()
    print "BENCH arith_any {(t1 - t0) / iters}"
    if acc == 12345678987654321: print "# sink"

main()
