"""
## Purpose and audience
Purpose: prove the DBFS FTS facade routes BM25 through the common scorer
Audience: compiler and tooling engineers who maintain the DBFS FTS engine

DBFS Canonical BM25 Facade Specification (P7)

This is the re-attempt of the §15.1 rejected facade slice
(doc/05_design/infra/spipe/spipe_knowledge_compiler_search_providers.md §6.1,
§15.1). The rejection required, before any candidate could be accepted:
  - value-semantic child copies with a single owner reassignment, never a
    mutation through a temporary alias into nested collection/struct state;
  - one atomic engine transaction (lexical index must not commit before
    trigram/content state);
  - a corrected `contains_document` ABI;
  - a spec that asserts intermediate statistics/averages, independent
    clean-corpus statistics, contains/absent behavior, exact result-order
    equality, legacy success, and checked-upsert failure/no-change.

This spec asserts each of those, plus the facade/common-scorer agreement that
is the whole point of the migration: `fts_bm25_score`/`fts_bm25_score_fixed`
must be a thin compatibility facade over `std.common.search.ranking`, not a
second, independently-drifting scorer.
"""

# @req: REQ-STORAGE-FtsCanon-001

use std.spec.*
use std.db.dbfs_engine.fts.inverted_index.{FtsInvertedIndex}
use std.db.dbfs_engine.fts.bm25.{fts_bm25_score, fts_bm25_score_fixed, fts_bm25_search, fts_bm25_explain, FtsSearchResult}
use std.db.dbfs_engine.fts.search.{FtsEngine}
use std.db.dbfs_engine.fts.wave4_compatibility.{DBFS_W4_SCOPE, DbfsWave4Document, DbfsWave4Index}
use std.common.search.ranking.{bm25_score_default}

describe "DBFS BM25 facade agrees with the common scorer (bm25-fixed-v1)":

    it "fts_bm25_score_fixed returns exactly bm25_score_default's raw value":
        step("Compute the same term via the DBFS facade and the common scorer directly")
        # @req: REQ-STORAGE-FtsCanon-001
        val tf = 3
        val df = 2
        val doc_len = 40
        val avg_dl_fixed = 30 * 1000000
        val total_docs = 10

        val facade_score = fts_bm25_score_fixed(tf, df, doc_len, avg_dl_fixed, total_docs)
        val common_score = bm25_score_default([tf], [df], doc_len, avg_dl_fixed, total_docs).raw_value()

        step("Verify: the facade never diverges from the common scorer")
        expect(facade_score).to_equal(common_score)  # oracle: single scorer, no duplicate implementation
        expect(facade_score > 0).to_be(true)

    it "fts_bm25_explain reports the same score as the raw facade call":
        step("Ask the facade for a scoring explanation")
        # @req: REQ-STORAGE-FtsCanon-001
        val explanation = fts_bm25_explain(3, 2, 40, 30 * 1000000, 10)
        expect(explanation.score_contract).to_equal("bm25-fixed-v1")
        expect(explanation.score_milli).to_equal(fts_bm25_score_fixed(3, 2, 40, 30 * 1000000, 10))

describe "DBFS inverted index — intermediate statistics and averages":

    it "reports exact corpus statistics after each upsert, not only at the end":
        step("Index three documents of different lengths one at a time")
        # @req: REQ-STORAGE-FtsCanon-001
        var index = FtsInvertedIndex.new()

        index.index_document(1, "alpha beta gamma")
        step("Verify: statistics are exact after the first document")
        expect(index.doc_count()).to_equal(1)
        expect(index.avg_doc_length_fixed()).to_equal(3 * 1000000)

        index.index_document(2, "alpha beta")
        step("Verify: statistics are exact after the second document (intermediate, not final)")
        expect(index.doc_count()).to_equal(2)
        expect(index.avg_doc_length_fixed()).to_equal((5 * 1000000) / 2)

        index.index_document(3, "alpha")
        step("Verify: statistics are exact after the third document")
        expect(index.doc_count()).to_equal(3)
        expect(index.avg_doc_length_fixed()).to_equal((6 * 1000000) / 3)

    it "index_document is an idempotent upsert: re-indexing replaces, not appends":
        step("Index the same document id twice with different content")
        # @req: REQ-STORAGE-FtsCanon-001
        var index = FtsInvertedIndex.new()
        index.index_document(7, "alpha alpha alpha")
        val first_len = index.doc_length(7)
        index.index_document(7, "beta")

        step("Verify: the corpus still has exactly one document with the NEW length")
        expect(index.doc_count()).to_equal(1)  # oracle: not 2 — upsert, not append
        expect(index.doc_length(7)).to_equal(1)
        expect(first_len).to_equal(3)
        expect(index.doc_freq("alpha")).to_equal(0)  # oracle: old postings removed, not stacked
        expect(index.doc_freq("beta")).to_equal(1)

describe "DBFS inverted index — independent clean-corpus statistics":

    it "matches independently computed df/N/avg-length for a clean corpus":
        step("Build a small corpus and compute df/N/avg length independently in the spec")
        # @req: REQ-STORAGE-FtsCanon-001
        var index = FtsInvertedIndex.new()
        val docs = ["alpha beta", "beta gamma", "alpha gamma beta"]
        var i = 0
        while i < docs.len():
            index.index_document((i + 1) as i64, docs[i])
            i = i + 1

        # Independent oracle, computed without touching the index internals.
        val expected_n = docs.len() as i64
        var expected_total_tokens: i64 = 0
        for d in docs:
            expected_total_tokens = expected_total_tokens + d.split(" ").len() as i64
        val expected_avg_fixed = expected_total_tokens * 1000000 / expected_n

        step("Verify: the index's own reported stats equal the independent oracle")
        expect(index.doc_count()).to_equal(expected_n)
        expect(index.avg_doc_length_fixed()).to_equal(expected_avg_fixed)
        expect(index.doc_freq("alpha")).to_equal(2)  # oracle: docs 1 and 3
        expect(index.doc_freq("beta")).to_equal(3)   # oracle: all three docs
        expect(index.doc_freq("gamma")).to_equal(2)  # oracle: docs 2 and 3
        expect(index.doc_freq("delta")).to_equal(0)  # oracle: absent term

describe "DBFS inverted index — contains/absent behavior":

    it "contains_document is true only while a document is live":
        step("Index, then remove, a document")
        # @req: REQ-STORAGE-FtsCanon-001
        var index = FtsInvertedIndex.new()
        expect(index.contains_document(1)).to_be(false)  # oracle: absent before indexing

        index.index_document(1, "alpha beta")
        step("Verify: contains_document is true right after indexing")
        expect(index.contains_document(1)).to_be(true)

        index.remove_document(1)
        step("Verify: contains_document is false after removal, and stats reflect it")
        expect(index.contains_document(1)).to_be(false)
        expect(index.doc_count()).to_equal(0)
        expect(index.doc_length(1)).to_equal(0)

describe "DBFS BM25 search — exact result-order equality":

    it "orders hits by score descending, then doc_id ascending on exact ties":
        step("Index documents that produce a genuine score tie")
        # @req: REQ-STORAGE-FtsCanon-001
        var index = FtsInvertedIndex.new()
        index.index_document(30, "alpha beta")
        index.index_document(10, "alpha beta")
        index.index_document(20, "alpha beta")

        val results = fts_bm25_search(index, "alpha beta")

        step("Verify: all three docs tie in score and are ordered by ascending doc_id")
        expect(results.len()).to_equal(3)
        expect(results[0].score).to_equal(results[1].score)
        expect(results[1].score).to_equal(results[2].score)
        expect(results[0].doc_id).to_equal(10)  # oracle: tie broken by doc_id ascending
        expect(results[1].doc_id).to_equal(20)
        expect(results[2].doc_id).to_equal(30)

    it "ranks a document that matches more query terms above one that matches fewer":
        step("Index one document matching both query terms and one matching only one")
        # @req: REQ-STORAGE-FtsCanon-001
        var index = FtsInvertedIndex.new()
        index.index_document(1, "alpha beta alpha beta")
        index.index_document(2, "alpha only")

        val results = fts_bm25_search(index, "alpha beta")
        step("Verify: doc 1 (matches both terms) ranks strictly above doc 2")
        expect(results.len()).to_equal(2)
        expect(results[0].doc_id).to_equal(1)
        expect(results[0].score > results[1].score).to_be(true)

describe "DBFS BM25 legacy facade — success path preserved":

    it "fts_bm25_score (legacy signature) still returns a positive score for a real match":
        step("Call the pre-existing legacy facade signature directly")
        # @req: REQ-STORAGE-FtsCanon-001
        val legacy_score = fts_bm25_score(2, 1, 20, 15, 5)
        step("Verify: legacy callers still get a positive, non-erroring score")
        expect(legacy_score > 0).to_be(true)

    it "FtsEngine.search_keyword still returns matches through the migrated facade":
        step("Build an engine and search for an indexed term")
        # @req: REQ-STORAGE-FtsCanon-001
        var engine = FtsEngine.new()
        engine.add_document(1, "alpha beta gamma")
        engine.add_document(2, "delta epsilon")

        val hits = engine.search_keyword("alpha")
        step("Verify: legacy FtsEngine callers still see their document")
        expect(hits.len()).to_equal(1)
        expect(hits[0].doc_id).to_equal(1)

describe "DBFS Wave-4 checked upsert — failure leaves the index unchanged":

    it "rejects a non-public document and performs no partial mutation":
        step("Attempt to add a document with an unsupported (non-public) visibility")
        # @req: REQ-STORAGE-FtsCanon-001
        var index = DbfsWave4Index.new(DBFS_W4_SCOPE)
        val before_count = index.document_count()

        val rejected = DbfsWave4Document.of(
            "R-1", "r1", "REQ-X", "Title", "Heading", "cls", "body text",
            "private", DBFS_W4_SCOPE)
        val outcome = index.add(rejected)

        step("Verify: the checked upsert failed and the index has zero observable change")
        expect(outcome.is_err()).to_be(true)  # oracle: checked failure, not silent success
        expect(index.document_count()).to_equal(before_count)  # oracle: no partial mutation
        expect(index.contains_document("R-1")).to_be(false)

    it "accepts a public document and the upsert is idempotent (same id replaces, not duplicates)":
        step("Add the same document id twice with different content")
        # @req: REQ-STORAGE-FtsCanon-001
        var index = DbfsWave4Index.new(DBFS_W4_SCOPE)
        val first = DbfsWave4Document.of(
            "D-1", "r1", "REQ-Y", "Title A", "Heading A", "cls", "body one",
            "public", DBFS_W4_SCOPE)
        val second = DbfsWave4Document.of(
            "D-1", "r1", "REQ-Y", "Title B", "Heading B", "cls", "body two",
            "public", DBFS_W4_SCOPE)

        expect(index.add(first).is_ok()).to_be(true)
        expect(index.add(second).is_ok()).to_be(true)

        step("Verify: exactly one document is stored, holding the second write")
        expect(index.document_count()).to_equal(1)  # oracle: upsert, not duplicate
        expect(index.contains_document("D-1")).to_be(true)
