"""Fault-injected acceptance coverage for the FAT32 mirrored mutation owner."""

use std.spec.{step}
use std.spipe.*
use std.fs_driver.block_device.{BlockDevice}
use std.fs_driver.fat32_core.{
    Fat32Core, Fat32FatMutationKindV1, FAT32_FREE, FAT32_EOC
}

struct MirroredFatBank:
    sectors: [[u8]]
    fail_lba: i64
    fail_applies: bool

var _mirrored_fat_banks: [MirroredFatBank] = []

fn _mf_zeros(count: i32) -> [u8]:
    var out: [u8] = []
    var i = 0
    while i < count:
        out.push(0u8)
        i = i + 1
    out

fn _mf_put_u16(data: [u8], off: i32, value: u16) -> [u8]:
    var out = data
    out[off] = (value & 0xFFu16).to_u8()
    out[off + 1] = ((value >> 8u16) & 0xFFu16).to_u8()
    out

fn _mf_put_u32(data: [u8], off: i32, value: u32) -> [u8]:
    var out = data
    out[off] = (value & 0xFFu32).to_u8()
    out[off + 1] = ((value >> 8u32) & 0xFFu32).to_u8()
    out[off + 2] = ((value >> 16u32) & 0xFFu32).to_u8()
    out[off + 3] = ((value >> 24u32) & 0xFFu32).to_u8()
    out

fn _mf_entry(bank: i32, copy: i32, cluster: u32) -> u32:
    val sector = _mirrored_fat_banks[bank].sectors[1 + copy]
    val off = (cluster * 4u32).to_i32()
    ((sector[off + 3].to_u32() << 24u32) |
        (sector[off + 2].to_u32() << 16u32) |
        (sector[off + 1].to_u32() << 8u32) |
        sector[off].to_u32()) & 0x0FFFFFFFu32

fn _mf_set_entry(bank: i32, copy: i32, cluster: u32, value: u32):
    var state = _mirrored_fat_banks[bank]
    state.sectors[1 + copy] = _mf_put_u32(state.sectors[1 + copy],
        (cluster * 4u32).to_i32(), value)
    _mirrored_fat_banks[bank] = state

fn _mf_set_fault(bank: i32, lba: i64, applies: bool):
    var state = _mirrored_fat_banks[bank]
    state.fail_lba = lba
    state.fail_applies = applies
    _mirrored_fat_banks[bank] = state

fn _mf_disable_mirroring(bank: i32):
    var state = _mirrored_fat_banks[bank]
    state.sectors[0] = _mf_put_u16(state.sectors[0], 40, 0x0080u16)
    _mirrored_fat_banks[bank] = state

class MirroredFatDevice:
    bank: i32

impl MirroredFatDevice:
    static fn new() -> MirroredFatDevice:
        var sectors: [[u8]] = []
        var i = 0
        while i < 128:
            sectors.push(_mf_zeros(512))
            i = i + 1
        var boot = sectors[0]
        boot = _mf_put_u16(boot, 11, 512u16)
        boot[13] = 1u8
        boot = _mf_put_u16(boot, 14, 1u16)
        boot[16] = 2u8
        boot = _mf_put_u32(boot, 32, 128u32)
        boot = _mf_put_u32(boot, 36, 1u32)
        boot = _mf_put_u32(boot, 44, 2u32)
        boot[510] = 0x55u8
        boot[511] = 0xAAu8
        sectors[0] = boot
        var fat = _mf_zeros(512)
        fat = _mf_put_u32(fat, 0, 0x0FFFFFF8u32)
        fat = _mf_put_u32(fat, 4, 0x0FFFFFFFu32)
        fat = _mf_put_u32(fat, 8, FAT32_EOC)
        sectors[1] = fat
        sectors[2] = fat
        _mirrored_fat_banks.push(MirroredFatBank(
            sectors: sectors, fail_lba: -1, fail_applies: false))
        MirroredFatDevice(bank: _mirrored_fat_banks.len() - 1)

impl BlockDevice for MirroredFatDevice:
    fn read_sector(lba: u64) -> Result<[u8], text>:
        if lba >= 128u64: return Err("fault device read out of range")
        Ok(_mirrored_fat_banks[self.bank].sectors[lba.to_i32()])

    fn write_sector(lba: u64, data: [u8]) -> Result<bool, text>:
        if lba >= 128u64: return Err("fault device write out of range")
        var state = _mirrored_fat_banks[self.bank]
        if state.fail_lba == lba.to_i64():
            if state.fail_applies: state.sectors[lba.to_i32()] = data
            _mirrored_fat_banks[self.bank] = state
            return Err("injected FAT write ambiguity")
        state.sectors[lba.to_i32()] = data
        _mirrored_fat_banks[self.bank] = state
        Ok(true)

    fn sector_size() -> u32: 512u32
    fn flush() -> Result<bool, text>: Ok(true)

fn _mf_is_published(kind: Fat32FatMutationKindV1) -> bool:
    match kind:
        case Fat32FatMutationKindV1.Published: true
        case _: false

fn _mf_is_not_published(kind: Fat32FatMutationKindV1) -> bool:
    match kind:
        case Fat32FatMutationKindV1.NotPublished: true
        case _: false

fn _mf_is_indeterminate(kind: Fat32FatMutationKindV1) -> bool:
    match kind:
        case Fat32FatMutationKindV1.Indeterminate: true
        case _: false

describe "FAT32 mirrored FAT mutation owner":
    it "publishes only after every discovered FAT copy reads back":
        step("Mutate one free cluster through the canonical FAT owner")
        val device = MirroredFatDevice.new()
        var core = Fat32Core.new(device)
        core.mount().unwrap()
        val outcome = core.mutate_fat_entry_v1(3u32, FAT32_EOC)
        expect(_mf_is_published(outcome.kind)).to_equal(true)
        expect(outcome.copies_verified).to_equal(2u32)
        expect(_mf_entry(device.bank, 0, 3u32)).to_equal(FAT32_EOC)
        expect(_mf_entry(device.bank, 1, 3u32)).to_equal(FAT32_EOC)

    it "returns NotPublished when a rejected first write leaves every old copy":
        step("Prove every retained old value remains before permitting retry")
        val device = MirroredFatDevice.new()
        var core = Fat32Core.new(device)
        core.mount().unwrap()
        _mf_set_fault(device.bank, 1, false)
        val outcome = core.mutate_fat_entry_v1(3u32, FAT32_EOC)
        expect(_mf_is_not_published(outcome.kind)).to_equal(true)
        expect(outcome.quarantined).to_equal(false)
        expect(_mf_entry(device.bank, 0, 3u32)).to_equal(FAT32_FREE)
        expect(_mf_entry(device.bank, 1, 3u32)).to_equal(FAT32_FREE)

    it "quarantines a partial mirrored write and allocator cannot reuse it":
        step("Fail the second FAT copy after the first copy changed")
        val device = MirroredFatDevice.new()
        var core = Fat32Core.new(device)
        core.mount().unwrap()
        _mf_set_fault(device.bank, 2, false)
        val outcome = core.mutate_fat_entry_v1(3u32, FAT32_EOC)
        expect(_mf_is_indeterminate(outcome.kind)).to_equal(true)
        expect(core.fat_cluster_quarantined(3u32)).to_equal(true)
        _mf_set_fault(device.bank, -1, false)
        expect(core.alloc_cluster().unwrap()).to_equal(4u32)

    it "quarantines divergence discovered before issuing any write":
        step("Reject a pre-existing split-brain mirrored FAT entry")
        val device = MirroredFatDevice.new()
        _mf_set_entry(device.bank, 1, 3u32, FAT32_EOC)
        var core = Fat32Core.new(device)
        core.mount().unwrap()
        val outcome = core.mutate_fat_entry_v1(3u32, FAT32_EOC)
        expect(_mf_is_indeterminate(outcome.kind)).to_equal(true)
        expect(outcome.copies_verified).to_equal(2u32)
        expect(core.fat_quarantined_cluster_count()).to_equal(1)

    it "rediscovers split-brain copies after remount before allocation":
        step("Compare all FAT copies on the first lazy read of a fresh owner")
        val device = MirroredFatDevice.new()
        _mf_set_entry(device.bank, 1, 3u32, FAT32_EOC)
        var remounted = Fat32Core.new(device)
        remounted.mount().unwrap()
        expect(remounted.alloc_cluster().unwrap()).to_equal(4u32)
        expect(remounted.fat_cluster_quarantined(3u32)).to_equal(true)

    it "rejects a BPB that disables FAT mirroring":
        step("Require mirrored geometry before mounting the mirrored owner")
        val device = MirroredFatDevice.new()
        _mf_disable_mirroring(device.bank)
        var core = Fat32Core.new(device)
        expect(core.mount().is_err()).to_equal(true)

    it "treats an error-after-apply as Published when all copies verify new":
        step("Classify device acknowledgement independently from observed media")
        val device = MirroredFatDevice.new()
        var core = Fat32Core.new(device)
        core.mount().unwrap()
        _mf_set_fault(device.bank, 2, true)
        val outcome = core.mutate_fat_entry_v1(3u32, FAT32_EOC)
        expect(_mf_is_published(outcome.kind)).to_equal(true)
        expect(outcome.quarantined).to_equal(false)
