"""
# Bootstrap Stage 3 Folded Module Constant Type Integration

Exercise the smallest owner boundary behind the retained Stage 3 failure:
source parsing, HIR lowering, scalar constant folding, and MIR constant type
selection.  The report binds every unannotated constant name to both its MIR
type and folded-value kind, so an enum-identity/match failure cannot collapse
to an unanchored diagnostic.
"""

# codex-system-test
use std.spec.*
use std.nogc_sync_mut.io.file_ops.{file_read}
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{HirExprKind, HirTypeKind}
use compiler.mir.mir_data.*
use compiler.mir.mir_lowering.MirLowering

val FIXTURE = "test/02_integration/compiler/fixtures/module_const_type/inferred_scalar_constants.spl"

fn mir_type_label(type_: MirType) -> text:
    match type_.kind:
        case MirTypeKind.I64: "i64"
        case MirTypeKind.F64: "f64"
        case MirTypeKind.Bool: "bool"
        case MirTypeKind.Opaque(name): "opaque:" + name
        case _: "unexpected"

fn mir_value_label(value: MirConstValue) -> text:
    match value:
        case MirConstValue.Int(_): "Int"
        case MirConstValue.Float(_): "Float"
        case MirConstValue.Bool(_): "Bool"
        case MirConstValue.Str(_): "Str"
        case MirConstValue.Array(_): "Array"
        case MirConstValue.Tuple(_): "Tuple"
        case MirConstValue.Struct(_): "Struct"
        case MirConstValue.Zero: "Zero"

fn mir_constant_report(constant: MirConstant) -> text:
    constant.name + ":" + mir_type_label(constant.type_) + ":" + mir_value_label(constant.value)

describe "bootstrap Stage 3 folded module constant type integration":
    it "should report inferred scalar constant names, MIR types, and folded kinds":
        step("Parse and lower the isolated unannotated scalar constants to HIR")
        val source = file_read(FIXTURE)
        val ast = parse_full_frontend(source, FIXTURE, FIXTURE, Logger(level: 0))
        var hir_lowering = HirLowering.with_filename(FIXTURE)
        val hir = hir_lowering.lower_module(ast)
        expect(hir_lowering.errors.len()).to_equal(0)
        expect(hir.constants.len()).to_equal(6)

        var folded_hir_is_infer_binary = false
        for constant in hir.constants.values():
            if constant.name == "MODULE_FOLDED_INT":
                match constant.type_.kind:
                    case HirTypeKind.Infer(_, _):
                        match constant.value.kind:
                            case HirExprKind.Binary(_, _, _): folded_hir_is_infer_binary = true
                            case _: ()
                    case _: ()
        expect(folded_hir_is_infer_binary).to_equal(true)

        step("Lower HIR constants through the owning MIR type-derivation boundary")
        var mir_lowering = MirLowering.new(hir.symbols)
        val mir = mir_lowering.lower_module(hir)
        var errors = ""
        for error in mir_lowering.errors:
            errors = errors + error.message + "\n"
        expect(errors).to_equal("")

        step("Report every constant by exact source name, MIR type, and folded-value kind")
        var module_int = "missing"
        var module_zero = "missing"
        var module_float = "missing"
        var module_bool = "missing"
        var module_text = "missing"
        var module_folded_int = "missing"
        for constant in mir.constants.values():
            val report = mir_constant_report(constant)
            if constant.name == "MODULE_INT": module_int = report
            if constant.name == "MODULE_ZERO": module_zero = report
            if constant.name == "MODULE_FLOAT": module_float = report
            if constant.name == "MODULE_BOOL": module_bool = report
            if constant.name == "MODULE_TEXT": module_text = report
            if constant.name == "MODULE_FOLDED_INT": module_folded_int = report

        expect([
            module_int,
            module_zero,
            module_float,
            module_bool,
            module_text,
            module_folded_int
        ]).to_equal([
            "MODULE_INT:i64:Int",
            "MODULE_ZERO:i64:Int",
            "MODULE_FLOAT:f64:Float",
            "MODULE_BOOL:bool:Bool",
            "MODULE_TEXT:opaque:str:Str",
            "MODULE_FOLDED_INT:i64:Int"
        ])
