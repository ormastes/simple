# @engine-reach: native-by-compile — compiles and executes the raw mmap extern fixture
"""
# Raw mmap read symbols link in native code

The exact `rt_file_mmap_read_text(path: text)` shape used by I/O parity and the
adjacent `rt_file_mmap_read_bytes(path: text)` shape must both resolve through
the in-process native symbol table. The fixture is deliberately independent of
the parity benchmark and uses a private native cache.
"""

use std.io_runtime.{env_get, process_run}

describe "Native raw mmap read symbol linking":
    it "compiles and executes text plus adjacent bytes mmap reads":
        val artifact_dir = "build/test-artifacts/native_mmap_read_link"
        val candidate = artifact_dir + "/probe"
        val build_log = artifact_dir + "/build.log"
        val simple = env_get("SIMPLE_BINARY") ?? "bin/simple"
        val script = "mkdir -p " + artifact_dir + "/cache; " +
            "rm -f " + candidate + "; " +
            "SIMPLE_NATIVE_BUILD_CACHE_DIR=" + artifact_dir + "/cache " +
            simple + " compile test/fixtures/native_mmap_read_link/main.spl " +
            "--native --cpu native --opt-level aggressive -o " + candidate +
            " >" + build_log + " 2>&1; " +
            "build_rc=$?; if [ $build_rc -ne 0 ]; then cat " + build_log +
            "; exit $build_rc; fi; " + candidate
        val (stdout, stderr, status) = process_run("sh", ["-c", script])
        expect(status).to_equal(0)
        expect(stderr).to_equal("")
        expect(stdout).to_contain("mmap-link-ok:13:13")
