# codex-system-test
#
# Black-box clocked contract for V7's single tag-2 runtime-M provider.  This
# deliberately drives the frozen public pipeline ABI rather than its private
# multiplier/divider state.
use std.spec.*
use app.io.vhdl_ffi.{ghdl_available, ghdl_unique_workdir, ghdl_analyze_in,
    ghdl_elaborate_in, ghdl_run_in, vhdl_write_file}
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_lsu_config.{LsuConfig}
use compiler.backend.backend.riscv_scalar_runtime_pipeline_v7_flat_to_vhdl.{
    compile_strict_riscv_scalar_runtime_pipeline_v7_flat}

fn runtime_v7_rv32im() -> CoreConfig: CoreConfig.rv32im()
fn runtime_v7_rv64im() -> CoreConfig: CoreConfig.rv64im()

fn runtime_pipeline_v7_flat_clocked_tb(entity_name: text, xlen: i32,
    mulh_lhs: text, mulh_expected: text, divw_case: text) -> text:
    """
library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;
use std.env.all;
entity {entity_name}_tb is end entity;
architecture sim of {entity_name}_tb is
  signal clk, rst, in_valid, completion_ready : std_logic := '0';
  signal instruction : std_logic_vector(31 downto 0) := (others => '0');
  signal instruction_length_bytes : std_logic_vector(2 downto 0) := "100";
  signal rs1_value, rs2_value, pc_before, fallthrough_pc : std_logic_vector({xlen - 1} downto 0) := (others => '0');
  signal privilege : std_logic_vector(1 downto 0) := "11";
  signal provider_event_id, decode_event_id : std_logic_vector(63 downto 0) := (others => '0');
  signal bus_request_ready, bus_response_valid, bus_response_fault, fence_effect_ready : std_logic := '0';
  signal bus_response_id : std_logic_vector(63 downto 0) := (others => '0');
  signal bus_response_data, bus_response_cause, bus_response_tval : std_logic_vector({xlen - 1} downto 0) := (others => '0');
  signal in_ready, completion_valid, completion_rd_write, runtime_protocol_fault : std_logic;
  signal completion_rd : std_logic_vector(4 downto 0);
  signal completion_rd_value, completion_pc_before, completion_pc_after : std_logic_vector({xlen - 1} downto 0);
  signal completion_original_instruction, completion_canonical_instruction : std_logic_vector(31 downto 0);
  signal completion_instruction_length_bytes : std_logic_vector(2 downto 0);
  signal completion_privilege : std_logic_vector(1 downto 0);
  signal completion_memory_address, completion_memory_read_data, completion_memory_write_data : std_logic_vector({xlen - 1} downto 0);
  signal completion_memory_read_mask, completion_memory_write_mask : std_logic_vector({xlen / 8 - 1} downto 0);
  signal completion_execute_trap_valid, completion_memory_trap_valid, completion_redirect_valid, completion_illegal_valid : std_logic;
  signal completion_execute_trap_cause, completion_execute_trap_tval, completion_memory_trap_cause, completion_memory_trap_tval, completion_redirect_target : std_logic_vector({xlen - 1} downto 0);
  signal completion_provider_event_id, completion_decode_event_id : std_logic_vector(63 downto 0);
  signal bus_request_valid, bus_request_write, bus_response_ready, fence_effect_valid : std_logic;
  signal bus_request_id : std_logic_vector(63 downto 0);
  signal bus_request_address, bus_request_write_data : std_logic_vector({xlen - 1} downto 0);
  signal bus_request_byte_mask : std_logic_vector({xlen / 8 - 1} downto 0);
  signal fence_effect_kind : std_logic_vector(1 downto 0);
  signal fence_effect_fm, fence_effect_pred, fence_effect_succ : std_logic_vector(3 downto 0);
begin
  dut: entity work.{entity_name} port map(
    clk=>clk, rst=>rst, in_valid=>in_valid, instruction=>instruction, instruction_length_bytes=>instruction_length_bytes,
    rs1_value=>rs1_value, rs2_value=>rs2_value, pc_before=>pc_before, fallthrough_pc=>fallthrough_pc, privilege=>privilege,
    provider_event_id=>provider_event_id, decode_event_id=>decode_event_id, completion_ready=>completion_ready,
    bus_request_ready=>bus_request_ready, bus_response_valid=>bus_response_valid, bus_response_id=>bus_response_id,
    bus_response_data=>bus_response_data, bus_response_fault=>bus_response_fault, bus_response_cause=>bus_response_cause,
    bus_response_tval=>bus_response_tval, fence_effect_ready=>fence_effect_ready, in_ready=>in_ready, completion_valid=>completion_valid,
    completion_rd=>completion_rd, completion_rd_write=>completion_rd_write, completion_rd_value=>completion_rd_value,
    runtime_protocol_fault=>runtime_protocol_fault, bus_request_valid=>bus_request_valid, bus_request_id=>bus_request_id,
    bus_request_address=>bus_request_address, bus_request_write=>bus_request_write, bus_request_byte_mask=>bus_request_byte_mask,
    bus_request_write_data=>bus_request_write_data, bus_response_ready=>bus_response_ready, fence_effect_valid=>fence_effect_valid,
    fence_effect_kind=>fence_effect_kind, fence_effect_fm=>fence_effect_fm, fence_effect_pred=>fence_effect_pred, fence_effect_succ=>fence_effect_succ,
    completion_privilege=>completion_privilege, completion_original_instruction=>completion_original_instruction,
    completion_canonical_instruction=>completion_canonical_instruction, completion_instruction_length_bytes=>completion_instruction_length_bytes,
    completion_pc_before=>completion_pc_before, completion_pc_after=>completion_pc_after, completion_memory_address=>completion_memory_address,
    completion_memory_read_mask=>completion_memory_read_mask, completion_memory_write_mask=>completion_memory_write_mask,
    completion_memory_read_data=>completion_memory_read_data, completion_memory_write_data=>completion_memory_write_data,
    completion_execute_trap_valid=>completion_execute_trap_valid, completion_execute_trap_cause=>completion_execute_trap_cause,
    completion_execute_trap_tval=>completion_execute_trap_tval, completion_memory_trap_valid=>completion_memory_trap_valid,
    completion_memory_trap_cause=>completion_memory_trap_cause, completion_memory_trap_tval=>completion_memory_trap_tval,
    completion_redirect_valid=>completion_redirect_valid, completion_redirect_target=>completion_redirect_target,
    completion_provider_event_id=>completion_provider_event_id, completion_decode_event_id=>completion_decode_event_id,
    completion_illegal_valid=>completion_illegal_valid);
  process
    procedure tick is begin wait for 1 ns; clk<='1'; wait for 1 ns; clk<='0'; wait for 1 ns; end procedure;
    procedure drive(constant insn : std_logic_vector(31 downto 0); constant lhs, rhs : std_logic_vector({xlen - 1} downto 0); constant id : natural) is begin
      in_valid<='1'; instruction<=insn; rs1_value<=lhs; rs2_value<=rhs;
      pc_before<=std_logic_vector(to_unsigned(256,{xlen})); fallthrough_pc<=std_logic_vector(to_unsigned(260,{xlen}));
      provider_event_id<=std_logic_vector(to_unsigned(id,64)); decode_event_id<=std_logic_vector(to_unsigned(id,64));
    end procedure;
    procedure await_completion(constant label_text : string) is begin
      for n in 1 to {xlen + 16} loop if completion_valid='1' then return; end if; tick; end loop;
      assert false report label_text severity failure;
    end procedure;
  begin
    rst<='1'; tick; rst<='0'; wait for 1 ns;
    assert in_ready='1' and completion_valid='0' and runtime_protocol_fault='0' report "v7 reset state is invalid" severity failure;

    -- DIV x5,x6,x7: restoring latency must remain behind pending tag 2.
    drive(x"027342B3", std_logic_vector(to_unsigned(17,{xlen})), std_logic_vector(to_unsigned(2,{xlen})), 41);
    tick; in_valid<='0'; tick;
    assert in_ready='0' and completion_valid='0' report "DIV bypassed tag-2 pending ownership" severity failure;
    tick; assert in_ready='0' and completion_valid='0' report "DIV completed before iterative ownership" severity failure;
    await_completion("DIV did not retire through tag-2 provider");
    assert completion_rd="00101" and completion_rd_write='1' and completion_rd_value=std_logic_vector(to_unsigned(8,{xlen})) report "DIV payload mismatch" severity failure;
    assert completion_privilege="11" and completion_original_instruction=x"027342B3" and completion_canonical_instruction=x"027342B3" and
      completion_instruction_length_bytes="100" and completion_pc_before=std_logic_vector(to_unsigned(256,{xlen})) and completion_pc_after=std_logic_vector(to_unsigned(260,{xlen})) and
      completion_provider_event_id=std_logic_vector(to_unsigned(41,64)) and completion_decode_event_id=std_logic_vector(to_unsigned(41,64)) and completion_illegal_valid='0' and
      completion_memory_address=(completion_memory_address'range=>'0') and completion_memory_read_mask=(completion_memory_read_mask'range=>'0') and completion_memory_write_mask=(completion_memory_write_mask'range=>'0') and
      completion_memory_read_data=(completion_memory_read_data'range=>'0') and completion_memory_write_data=(completion_memory_write_data'range=>'0') and completion_execute_trap_valid='0' and
      completion_execute_trap_cause=(completion_execute_trap_cause'range=>'0') and completion_execute_trap_tval=(completion_execute_trap_tval'range=>'0') and completion_memory_trap_valid='0' and
      completion_memory_trap_cause=(completion_memory_trap_cause'range=>'0') and completion_memory_trap_tval=(completion_memory_trap_tval'range=>'0') and completion_redirect_valid='0' and completion_redirect_target=(completion_redirect_target'range=>'0')
      report "DIV completion lost public provenance or leaked side effects" severity failure;
    tick; assert completion_valid='1' and completion_rd_value=std_logic_vector(to_unsigned(8,{xlen})) report "DIV completion was not held" severity failure;
    completion_ready<='1'; tick; completion_ready<='0'; assert completion_valid='0' report "DIV completion was not consumed once" severity failure;

    -- MULH proves the same provider accepts non-DIV M rows and preserves high-half semantics.
    drive(x"027312B3", x"{mulh_lhs}", std_logic_vector(to_unsigned(2,{xlen})), 42);
    tick; in_valid<='0'; await_completion("MULH did not retire through tag-2 provider");
    assert completion_rd="00101" and completion_rd_write='1' and completion_rd_value=x"{mulh_expected}" report "MULH signed high-half mismatch" severity failure;
    completion_ready<='1'; tick; completion_ready<='0'; assert completion_valid='0' report "MULH completion was not consumed once" severity failure;

    {divw_case}
    assert bus_response_ready='0' report "orphan response was injected while LSU owned a request" severity failure;
    bus_response_id<=x"0000000000000042"; bus_response_valid<='1'; tick; bus_response_valid<='0';
    assert runtime_protocol_fault='1' and in_ready='0' and completion_valid='0' report "V7 global gate did not fail-stop orphan traffic" severity failure;
    rst<='1'; tick; rst<='0'; wait for 1 ns;
    assert runtime_protocol_fault='0' and in_ready='1' and completion_valid='0' report "reset did not recover V7 fault state" severity failure;
    finish;
  end process;
end architecture;
"""

fn simulate_runtime_pipeline_v7_flat_clocked(entity_name: text, config: CoreConfig, bus: LsuConfig) -> bool:
    val emitted = compile_strict_riscv_scalar_runtime_pipeline_v7_flat(entity_name, config, bus)
    if not emitted.is_success(): return false
    val workdir = ghdl_unique_workdir(entity_name); if workdir.is_err(): return false
    val isolated = workdir.ok().unwrap(); val path = isolated + "/" + entity_name + ".vhd"
    val divw_case = if config.xlen == 64:
        """
    -- DIVW x5,x6,x7: low 32-bit signed quotient must sign-extend to XLEN.
    drive(x"027342BB", x"00000000FFFFFFF8", x"0000000000000002", 43);
    tick; in_valid<='0'; await_completion("DIVW did not retire through tag-2 provider");
    assert completion_rd="00101" and completion_rd_write='1' and completion_rd_value=x"FFFFFFFFFFFFFFFC" report "DIVW did not sign-extend its 32-bit quotient" severity failure;
    tick; assert completion_valid='1' and completion_rd_value=x"FFFFFFFFFFFFFFFC" report "DIVW completion was not held" severity failure;
    completion_ready<='1'; tick; completion_ready<='0'; assert completion_valid='0' report "DIVW completion was not consumed once" severity failure;
"""
    else: ""
    val mulh_lhs = if config.xlen == 64: "8000000000000000" else: "80000000"
    val mulh_expected = if config.xlen == 64: "FFFFFFFFFFFFFFFF" else: "FFFFFFFF"
    if not vhdl_write_file(path, emitted.vhdl + "\n" + runtime_pipeline_v7_flat_clocked_tb(
        entity_name, config.xlen, mulh_lhs, mulh_expected, divw_case)): return false
    if not ghdl_analyze_in(path, isolated).success: return false
    if not ghdl_elaborate_in(entity_name + "_tb", isolated).success: return false
    ghdl_run_in(entity_name + "_tb", Some("5us"), isolated).success

describe "runtime scalar pipeline v7 flat clocked GHDL integration":
    slow_it "proves RV32IM DIV and MULH tag-2 latency, public completion contract, orphan fault, and reset":
        val available = ghdl_available(); expect(available).to_equal(true)
        if not available: return
        expect(simulate_runtime_pipeline_v7_flat_clocked("runtime_pipeline_v7_flat_clocked_rv32", runtime_v7_rv32im(), LsuConfig.rv32_product_default())).to_equal(true)

    slow_it "proves RV64IM DIVW sign extension on the single runtime-M ownership lane":
        val available = ghdl_available(); expect(available).to_equal(true)
        if not available: return
        expect(simulate_runtime_pipeline_v7_flat_clocked("runtime_pipeline_v7_flat_clocked_rv64", runtime_v7_rv64im(), LsuConfig.rv64_product_default())).to_equal(true)
