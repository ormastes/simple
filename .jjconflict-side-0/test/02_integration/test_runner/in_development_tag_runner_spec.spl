"""
## Purpose and audience
End-to-end proof that the `@tag:in-development` semantics are actually
wired into the test runner, not merely implemented in the library: a
tagged failing spec must not fail a sweep, the counts must be printed,
an explicit-path run must still report the honest red, and a tagged spec
that unexpectedly passes must be reported distinctly.
## Operator workflow
Run `bin/simple test test/02_integration/test_runner/in_development_tag_runner_spec.spl`.
Each scenario spawns a REAL child `simple test` over a generated fixture
and asserts on the child's stdout and exit code — the surfaces a human
reads — rather than on any in-process value.
## Compatibility and limitations
Spawns child processes and writes fixtures under a private temp dir; it
is slower than the unit spec. The classification rules themselves are
pinned separately by test/01_unit/lib/spec/in_development_tag_spec.spl.
"""
# @manual: primary
# @timeout_secs 900
# doc-path: doc/05_design/app/testing/in_development_tag.md

use std.spec.{step}
use std.spec.in_development.{
    IN_DEVELOPMENT_SKIP_MARKER,
    IN_DEVELOPMENT_UNEXPECTED_PASS_MARKER,
    IN_DEVELOPMENT_EXPLICIT_MARKER,
    IN_DEVELOPMENT_SUMMARY_MARKER
}
use std.io.{file_write, dir_create_all, file_exists}
use std.io.{env_get}
use std.io_runtime.{getpid, time_now_unix_micros}
use std.nogc_sync_mut.io.process_ops.{process_run_bounded}

val FAILING_FIXTURE: text = "\"\"\"Fixture: work in progress, expected to fail.\"\"\"\n# @tag:in-development\nuse std.spec.{step}\n\ndescribe \"WIP fixture: not implemented yet\":\n    it \"does not pass yet\":\n        step(\"Assert the not-yet-true thing\")\n        expect(1).to_equal(2)\n"

val PASSING_FIXTURE: text = "\"\"\"Fixture: still tagged, but quietly started passing.\"\"\"\n# @tag:in-development\nuse std.spec.{step}\n\ndescribe \"WIP fixture: quietly started working\":\n    it \"passes although still tagged in-development\":\n        step(\"Assert the now-true thing\")\n        expect(1).to_equal(1)\n"

fn simple_binary() -> text:
    """The binary under test.

    `/proc/self/exe` is not reachable from a spec, so prefer the same
    `SIMPLE_BINARY` override the runner itself honours
    (`test_runner_single.find_simple_binary`) and fall back to the
    conventional deployed path a developer's own `bin/simple test`
    resolves to. Reading the env var rather than hardcoding the path is
    what lets this spec run in a worktree that has no `bin/` symlink."""
    val configured = env_get("SIMPLE_BINARY") ?? ""
    if configured != "" and file_exists(configured):
        return configured
    "bin/simple"

fn fixture_dir(name: text) -> text:
    """A private, uniquely named fixture directory.

    Unique per process AND per microsecond so two concurrent lanes running
    this spec cannot collide on a shared path -- the sibling lanes are
    running in parallel by construction."""
    val d = "build/test_fixtures/in_development_{name}_{getpid()}_{time_now_unix_micros()}"
    dir_create_all(d)
    d

fn run_test_cmd(target: text) -> (text, i64):
    """Spawn a real child `simple test <target>` and return (output, code).

    stdout and stderr are combined because the runner writes its summary to
    stdout and its warnings to stderr, and a human reads both together."""
    val (out, err, code) = process_run_bounded(simple_binary(), ["test", target], 900000, 4000000)
    (out + "\n" + err, code)

describe "In-development tag (a): a failing in-development spec does not fail the suite":
    it "sweeps a directory containing a failing tagged spec and still exits green":
        step("Write a failing spec carrying `# @tag:in-development` into a fixture dir")
        val dir = fixture_dir("a")
        expect(file_write(dir + "/wip_failing_spec.spl", FAILING_FIXTURE)).to_equal(true)

        step("Sweep the directory with a real child `simple test <dir>`")
        val (out, code) = run_test_cmd(dir)

        step("Verify the sweep did NOT report a failure for the tagged spec")
        # evidence(observed): the child's own summary line is the surface a
        # human reads; asserting on it rather than an in-process value is
        # what makes this a wiring proof and not a restatement of the unit
        # spec.
        expect(out).to_contain(IN_DEVELOPMENT_SKIP_MARKER)
        expect(out.contains("0 failed")).to_equal(true)

describe "In-development tag (b): the skip is counted and printed":
    it "prints the in-development summary row with the skip count":
        step("Sweep a directory holding one failing tagged spec")
        val dir = fixture_dir("b")
        expect(file_write(dir + "/wip_failing_spec.spl", FAILING_FIXTURE)).to_equal(true)
        val (out, code) = run_test_cmd(dir)

        step("Verify the summary carries the in-development row and a non-zero count")
        # evidence(observed): an invisible skip is the failure mode this
        # feature exists to prevent, so the count must appear on the
        # ordinary summary surface, not behind a verbose flag.
        expect(out).to_contain(IN_DEVELOPMENT_SUMMARY_MARKER)
        expect(out).to_contain("1 skipped")

    it "names the offending file on the per-file skip line":
        step("Sweep and read the per-file line")
        val dir = fixture_dir("b2")
        expect(file_write(dir + "/wip_failing_spec.spl", FAILING_FIXTURE)).to_equal(true)
        val (out, code) = run_test_cmd(dir)
        expect(out).to_contain("wip_failing_spec.spl")
        expect(out).to_contain("expected failure(s)")

describe "In-development tag (c): explicit-path invocation still runs it honestly":
    it "fails red with a non-zero exit when the tagged spec is named by path":
        step("Write the failing tagged spec")
        val dir = fixture_dir("c")
        val path = dir + "/wip_failing_spec.spl"
        expect(file_write(path, FAILING_FIXTURE)).to_equal(true)

        step("Invoke the runner on the FILE, not its directory")
        val (out, code) = run_test_cmd(path)

        step("Verify the honest red: the developer must be able to work on it")
        # evidence(observed): a neutralised explicit run would make a WIP
        # test impossible to iterate on, which is why neutralisation lives
        # only in the sweep path.
        expect(out).to_contain(IN_DEVELOPMENT_EXPLICIT_MARKER)
        expect(out).to_contain("1 failed")
        expect(code).to_equal(1)

    it "does not neutralise the failure into a skip on the explicit path":
        step("Read the explicit-path output again")
        val dir = fixture_dir("c2")
        val path = dir + "/wip_failing_spec.spl"
        expect(file_write(path, FAILING_FIXTURE)).to_equal(true)
        val (out, code) = run_test_cmd(path)
        expect(out.contains(IN_DEVELOPMENT_SKIP_MARKER)).to_equal(false)

describe "In-development tag (d): an unexpectedly passing spec is reported distinctly":
    it "reports an UNEXPECTED PASS, with its own marker, for a tagged spec that passes":
        step("Write a tagged spec that actually passes")
        val dir = fixture_dir("d")
        expect(file_write(dir + "/wip_passing_spec.spl", PASSING_FIXTURE)).to_equal(true)

        step("Sweep the directory")
        val (out, code) = run_test_cmd(dir)

        step("Verify it is announced as ready to promote, not silently passed")
        # evidence(observed): a WIP test that quietly starts passing and says
        # nothing stays tagged forever; the line must name the action.
        expect(out).to_contain(IN_DEVELOPMENT_UNEXPECTED_PASS_MARKER)
        expect(out).to_contain("ready to promote")

    it "keeps the unexpected pass distinct from the expected-failure skip":
        step("Sweep a directory holding BOTH fixtures")
        val dir = fixture_dir("d2")
        expect(file_write(dir + "/wip_failing_spec.spl", FAILING_FIXTURE)).to_equal(true)
        expect(file_write(dir + "/wip_passing_spec.spl", PASSING_FIXTURE)).to_equal(true)
        val (out, code) = run_test_cmd(dir)

        step("Verify BOTH classes appear, and the summary totals them separately")
        expect(out).to_contain(IN_DEVELOPMENT_SKIP_MARKER)
        expect(out).to_contain(IN_DEVELOPMENT_UNEXPECTED_PASS_MARKER)
        expect(out).to_contain("UNEXPECTED PASS")
