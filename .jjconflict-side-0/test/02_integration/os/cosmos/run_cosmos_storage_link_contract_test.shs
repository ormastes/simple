#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd)
source_dir="$root/src/os/kernel/arch/arm32/cosmos"
build_dir=$(mktemp -d "${TMPDIR:-/tmp}/cosmos-storage-link.XXXXXX")
trap 'rm -rf "$build_dir"' EXIT HUP INT TERM

common='--target=armv7-none-eabi -mcpu=cortex-a9 -marm -ffreestanding -nostdlib -fno-builtin -Wall -Wextra -Werror'
units='cosmos_runtime cosmos_mmu_cache cosmos_smp_gic cosmos_fsbl cosmos_nfc cosmos_pcie cosmos_nvme_firmware cosmos_nvme_pcie_adapter cosmos_nvme_admin cosmos_nvme_dispatch cosmos_ftl cosmos_ftl_nfc_backend cosmos_nvme_ftl_media cosmos_storage'

for mode in qemu silicon; do
    mode_dir="$build_dir/$mode"
    mkdir -p "$mode_dir"
    flags="$common"
    if [ "$mode" = silicon ]; then
        flags="$flags -DCOSMOS_SILICON=1 -include $source_dir/cosmos_profile_openssd2_8ch8way_v300.h"
    fi
    clang $flags -c "$source_dir/cosmos_start.S" -o "$mode_dir/start.o"
    clang $flags -O0 -c "$source_dir/cosmos_uart.c" -o "$mode_dir/uart.o"
    objects="$mode_dir/start.o $mode_dir/uart.o"
    for unit in $units; do
        clang $flags -O2 -c "$source_dir/$unit.c" -o "$mode_dir/$unit.o"
        objects="$objects $mode_dir/$unit.o"
    done
    ld.lld -T "$source_dir/cosmos_linker.ld" $objects \
        -o "$mode_dir/firmware.elf"
    if readelf -sW "$mode_dir/firmware.elf" |
            awk '$7 == "UND" && $8 != "" { found = 1 } END { exit found }'; then
        :
    else
        echo "cosmos storage $mode link has unresolved symbols" >&2
        exit 1
    fi
    echo "cosmos storage $mode production link: PASS"
done
