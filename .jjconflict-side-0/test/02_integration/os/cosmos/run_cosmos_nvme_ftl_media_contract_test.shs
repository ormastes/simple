#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd)
source_dir="$root/src/os/kernel/arch/arm32/cosmos"
test_source="$root/test/02_integration/os/cosmos/cosmos_nvme_ftl_media_contract_test.c"
build_dir=$(mktemp -d "${TMPDIR:-/tmp}/cosmos-nvme-ftl-media.XXXXXX")
trap 'rm -rf "$build_dir"' EXIT HUP INT TERM

common_flags='-std=c11 -O2 -Wall -Wextra -Werror -Wpedantic -Wshadow -Wstrict-prototypes -Wformat=2'
seams='-Dcosmos_pcie_host_dma_submit_auto_host_to_device=cosmos_test_dma_h2d
 -Dcosmos_pcie_host_dma_submit_auto_device_to_host=cosmos_test_dma_d2h
 -Dcosmos_pcie_host_dma_poll_auto=cosmos_test_dma_poll
 -Dcosmos_nfc_read_page=cosmos_test_nfc_read
 -Dcosmos_nfc_program_page=cosmos_test_nfc_program'

cc $common_flags -DCOSMOS_MMIO_TEST=1 $seams -I"$source_dir" \
    "$test_source" "$source_dir/cosmos_nvme_ftl_media.c" \
    "$source_dir/cosmos_ftl.c" -o "$build_dir/cosmos_nvme_ftl_media_test"
"$build_dir/cosmos_nvme_ftl_media_test"

clang --target=armv7-none-eabi -mcpu=cortex-a9 -marm \
    -ffreestanding -nostdlib -fno-builtin $common_flags \
    -DCOSMOS_MMIO_TEST=1 $seams -I"$source_dir" \
    -c "$source_dir/cosmos_nvme_ftl_media.c" \
    -o "$build_dir/cosmos_nvme_ftl_media.arm.o"

echo "cosmos NVMe FTL media adapter ARM compile: PASS"
