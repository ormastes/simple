use std.spec.*
use os.kernel.boot.mmio.{mmio_reset_for_test}
use os.kernel.types.memory_types.{VirtAddr}
use os.kernel.memory.pmm.{pmm_init_identity_range, pmm_get_manager, pmm_alloc_page_raw, pmm_free_page_raw, pmm_free_pages}
use os.kernel.memory.vmm.{vmm_init_sparse_for_test, vmm_map_page, vmm_unmap_page, vmm_read_pte, PTE_USER}
use os.kernel.memory.memory_leveling_runtime.{memory_leveling_runtime_reset_for_test, memory_leveling_runtime_manager}
use os.kernel.memory.memory_dma_syscall_owner.{memory_dma_owned_allocate, memory_dma_owned_release}

describe "SimpleOS DMA syscall transaction owner":

    it "maps a PMM-proven user range and releases one leveling identity":
        mmio_reset_for_test()
        expect(pmm_init_identity_range(64 * 1024 * 1024, 1024 * 1024, 2 * 1024 * 1024)).to_equal(true)
        expect(vmm_init_sparse_for_test(pmm_get_manager(), 0)).to_equal(true)
        memory_leveling_runtime_reset_for_test()

        val dma_virt: u64 = 0x10000000
        val warm = memory_dma_owned_allocate(7, dma_virt, 4096)
        expect(warm.ok).to_equal(true)
        expect(memory_dma_owned_release(warm.allocation_id, 7, dma_virt, warm.phys_addr, warm.page_count).ok).to_equal(true)
        val before = pmm_free_pages()
        val allocated = memory_dma_owned_allocate(7, dma_virt, 4096)
        expect(allocated.ok).to_equal(true)
        expect((vmm_read_pte(VirtAddr(addr: dma_virt)) & PTE_USER) != 0).to_equal(true)
        val manager = memory_leveling_runtime_manager()
        expect(manager.get(allocated.allocation_id).unwrap().physical_base).to_equal(allocated.phys_addr)
        expect(manager.runtime_mapping(allocated.allocation_id).unwrap().virt_addr).to_equal(dma_virt)

        val released = memory_dma_owned_release(allocated.allocation_id, 7, dma_virt, allocated.phys_addr, allocated.page_count)
        expect(released.ok).to_equal(true)
        expect(vmm_read_pte(VirtAddr(addr: dma_virt))).to_equal(0)
        expect(memory_leveling_runtime_manager().get(allocated.allocation_id).unwrap().state.name).to_equal("released")
        expect(pmm_free_pages()).to_equal(before)
