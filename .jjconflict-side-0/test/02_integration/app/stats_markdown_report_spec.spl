#!/usr/bin/env simple

use std.spipe
use std.nogc_sync_mut.io.file_ops.{file_exists, file_read, file_write}
use app.stats.markdown_report.{stats_markdown, write_stats_markdown}

describe "stats Markdown report integration":
    it "writes a consumable report file":
        val path = "build/test_stats_markdown_report.md"
        val report = stats_markdown(
            [["compiler", "3", "40"]],
            [["Simple", "3", "40"]],
            3, 40, 1, 10,
            1, 0, 0, 0,
            2, 1, 5, 1, 2,
            2, 2, 1, 1, 0, 0,
            2, 2
        )
        expect(write_stats_markdown(path, report)).to_equal(true)
        expect(file_exists(path)).to_equal(true)
        val written = file_read(path)
        expect(written).to_start_with("# Project Statistics")
        expect(written).to_contain("## Test Inventory")
        expect(written).to_contain("## Features and Coverage")
