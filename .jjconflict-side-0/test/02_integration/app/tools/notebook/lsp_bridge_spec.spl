# @cover src/lib/nogc_sync_mut/notebook/lsp_bridge.spl 80%
# LspBridge integration test — session-long Simple LSP subprocess bridge for
# notebook complete_request/inspect_request (design §5.1).
#
# Design:  doc/05_design/app/tools/notebook_lanes_architecture.md §5.1
# Plan:    doc/03_plan/agent_tasks/notebook_lanes_parallel_plan_2026-08-07.md (Stream P, P1)
#
# Spawns a REAL `bin/simple run src/app/lsp/main.spl` subprocess (via
# StdioProcessTransport / rt_process_spawn_piped) and drives it through the
# real initialize/didOpen/completion/hover/shutdown handshake — a kernel
# process (this spec) launching an LSP process, hence `slow, system`.
#
# `src/app/lsp/lsp_handlers.spl` does not track an in-memory document buffer:
# completion/hover both shell out to
# `src/app/cli/query_visibility.spl completions|hover <path> <line> <col>`,
# which reads the REAL FILE ON DISK at the URI path. `LspBridge._sync_doc`
# therefore rewrites a real temp file before every request. That temp path
# MUST match one of the two absolute-path prefixes allowlisted by
# `sanitize_path` (src/app/cli/query_sanitize.spl) —
# `/tmp/simple_mcp_fmt_*.spl` or `/tmp/simple_lsp_test_*.spl` — any other
# `/tmp/...` path is silently rejected and every completions/hover call
# returns `[]`/`null` no matter what the file contains. Verified manually
# 2026-08-07 against `bin/simple run src/app/cli/query_visibility.spl
# completions|hover <file> <line> <col>` directly: identical fixture content
# returned zero completions under a non-allowlisted `/tmp` prefix and real,
# non-empty results once the path matched `/tmp/simple_lsp_test_*.spl` — this
# is what `lsp_bridge.spl`'s `cell_path` was fixed to use (it previously used
# the non-allowlisted `/tmp/simple_notebook_lsp_*.spl`).
#
# This spec's own subprocess spawn (`LspBridge.start()` -> `StdioProcessTransport.new`
# -> `rt_process_spawn_piped`) hits a pre-existing, already-filed interpreter
# gap on the seed binary `bin/simple test` runs on: `rt_process_spawn_piped`
# and its sibling externs are implemented in `src/runtime/runtime_process.c`
# and declared in `src/lib/nogc_sync_mut/io/process_ops.spl`, but the Rust
# seed's `interpreter_sffi` extern dispatch table never registered them (see
# doc/08_tracking/bug/interpreter_sffi_missing_piped_process_externs_2026-07-29.md).
# Under `bin/simple test` this is a hard per-`it` failure, not a catchable
# Result (no try/catch by design). Following the same established pattern as
# `test/03_system/app/debug/remote/protocol/gdb_mi_transport_spec.spl`, this
# spec probes for that capability out-of-process first (via a throwaway
# `bin/simple run` child, where the same failure degrades to a soft
# `pid=0` instead of aborting) and skips cleanly with a pointer at the bug
# if the capability is absent, rather than either faking a pass or leaving
# a spec permanently red on a gap this change did not cause.

# tag: slow, system

use std.io.{shell_output_trimmed, file_write, file_delete}
use std.notebook.lsp_bridge.{LspBridge}

fn _simple_bin() -> text:
    cwd() + "/bin/simple"

fn _shell_quote(value: text) -> text:
    "'" + value.replace("'", "'\\''") + "'"

fn _piped_process_probe_path() -> text:
    "/tmp/simple_lsp_test_bridge_capability_probe.spl"

fn _piped_process_probe_command(simple_bin: text) -> text:
    _shell_quote(simple_bin) + " run " + _shell_quote(_piped_process_probe_path()) + " 2>/dev/null"

fn _piped_process_extern_available(probe_command: text) -> bool:
    val probe_path = _piped_process_probe_path()
    val probe_src = "use std.nogc_sync_mut.io.{process_spawn_piped}\n\nfn main():\n    val pid = process_spawn_piped(\"true\", [])\n    if pid > 0:\n        print \"PIPED_OK\"\n    else:\n        print \"PIPED_FAIL\"\n"
    file_write(probe_path, probe_src)
    val output = shell_output_trimmed(probe_command, "")
    file_delete(probe_path)
    val ok_count = output.split("PIPED_OK").len() - 1
    val fail_count = output.split("PIPED_FAIL").len() - 1
    val has_one_token = ok_count + fail_count == 1
    expect(has_one_token).to_equal(true)
    # A malformed/empty probe must fail the spec without masquerading as the
    # known missing-capability skip. Returning true keeps execution on the
    # real bridge path after the assertion records the malformed probe.
    if not has_one_token:
        return true
    ok_count == 1

describe "LspBridge — session-long Simple LSP subprocess":
    slow_it "completes a known-defined symbol via the real LSP + query_visibility.spl completions path":
        """A cell defines `my_completable_function` and, on a later line,
        types the prefix `my_comp`. `query_visibility.spl completions`
        matches candidates against symbols parsed from the SAME file, so
        `my_completable_function` is a guaranteed hit at that prefix
        position (verified manually: same fixture, same 1-indexed
        line/col, non-empty completions list)."""
        val simple_bin = _simple_bin()
        val probe_command = _piped_process_probe_command(simple_bin)
        val expected_probe_command = _shell_quote(simple_bin) + " run " + _shell_quote(_piped_process_probe_path()) + " 2>/dev/null"
        expect(probe_command).to_equal(expected_probe_command)
        if not _piped_process_extern_available(probe_command):
            print "SKIP: rt_process_spawn_piped is not registered in this interpreter build's extern dispatch table (pre-existing gap, not caused by this change — see doc/08_tracking/bug/interpreter_sffi_missing_piped_process_externs_2026-07-29.md)"
            return

        var bridge = LspBridge.start()
        val code = "fn my_completable_function() -> i64:\n    42\n\nfn use_it() -> i64:\n    my_comp"
        # LSP protocol positions are 0-indexed; lsp_handlers.spl converts to
        # the 1-indexed line=5, col=8 that resolved to a real completion
        # ("    my_comp" -> col 8 sits inside the "my_comp" identifier).
        val labels = bridge.complete(code, 4, 7)
        expect(labels).to_contain("my_completable_function")
        bridge.shutdown()

    slow_it "hovers a known declaration via the real LSP + query_visibility.spl hover path":
        """Hovering on the declaration line itself
        (`extract_symbol_at` short-circuits to the whole-line declaration
        name regardless of column) returns the real declaration text and a
        visibility marker."""
        val simple_bin = _simple_bin()
        val probe_command = _piped_process_probe_command(simple_bin)
        val expected_probe_command = _shell_quote(simple_bin) + " run " + _shell_quote(_piped_process_probe_path()) + " 2>/dev/null"
        expect(probe_command).to_equal(expected_probe_command)
        if not _piped_process_extern_available(probe_command):
            print "SKIP: rt_process_spawn_piped is not registered in this interpreter build's extern dispatch table (pre-existing gap, not caused by this change — see doc/08_tracking/bug/interpreter_sffi_missing_piped_process_externs_2026-07-29.md)"
            return

        var bridge = LspBridge.start()
        val code = "fn my_completable_function() -> i64:\n    42\n\nfn use_it() -> i64:\n    my_comp"
        val hover_text = bridge.inspect(code, 0, 5)
        expect(hover_text).to_contain("fn my_completable_function")
        expect(hover_text).to_contain("Visibility")
        bridge.shutdown()
