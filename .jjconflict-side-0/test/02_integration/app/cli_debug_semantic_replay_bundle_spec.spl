# @req REQ-008 REQ-009 REQ-014 NFR-001 NFR-007
use std.spec.{describe, it, expect}
use std.nogc_sync_mut.io_runtime.{
    dir_create_all, file_delete, file_exists, file_hash_sha256,
    file_write, file_write_bytes,
}
use std.nogc_sync_mut.replay.codec.{encode_i64, encode_i32_bytes}
use app.cli_debug.evidence_replay_v1.{execute_debug_evidence_semantic_v1}

val REPLAY_BUILD = "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

fn append_i32_bytes_v1(target: [u8], source: [i32]) -> [u8]:
    var result = target
    for value in source:
        result.push(value as u8)
    result

fn one_semantic_event_v1() -> [u8]:
    var bytes: [u8] = []
    bytes = append_i32_bytes_v1(bytes, encode_i64(0))
    bytes = append_i32_bytes_v1(bytes, encode_i64(1))
    bytes = append_i32_bytes_v1(bytes, encode_i32_bytes(1))
    bytes = append_i32_bytes_v1(bytes, encode_i64(10))
    bytes = append_i32_bytes_v1(bytes, encode_i32_bytes(2))
    bytes = append_i32_bytes_v1(bytes, encode_i32_bytes(3))
    bytes = append_i32_bytes_v1(bytes, encode_i32_bytes(4))
    bytes = append_i32_bytes_v1(bytes, encode_i32_bytes(5))
    bytes = append_i32_bytes_v1(bytes, encode_i64(6))
    bytes = append_i32_bytes_v1(bytes, encode_i64(7))
    bytes = append_i32_bytes_v1(bytes, encode_i64(8))
    bytes

fn replay_manifest_v1(path: text, digest: text) -> text:
    "schema: debug-evidence-bundle-v1\n" +
        "session_id: \"captured-1\"\n" +
        "build_id: \"" + REPLAY_BUILD + "\"\n" +
        "captured_at_ns: 14\n" +
        "artifacts:\n" +
        "  - path: \"" + path + "\"\n" +
        "    digest: \"sha256:" + digest + "\"\n" +
        "    media_type: \"application/vnd.simple.semantic-trace\"\n" +
        "    native: false\n" +
        "    privacy: \"redacted\"\n"

describe "minimal CLI semantic replay and reproduction":
    it "replays one verified semantic event without claiming the defect fixed":
        val root = "build/test-cli-debug-semantic-replay"
        val trace = root + "/normalized/replay.sst"
        expect(dir_create_all(root + "/normalized")).to_equal(true)
        expect(file_write_bytes(trace, one_semantic_event_v1())).to_equal(true)
        expect(file_write(root + "/manifest.sdn",
            replay_manifest_v1("normalized/replay.sst", file_hash_sha256(trace)))).to_equal(true)
        val replay = execute_debug_evidence_semantic_v1(root, "replay")?
        expect(replay.event_count).to_equal(1)
        expect(replay.deterministic).to_equal(true)
        expect(replay.original_defect_fixed).to_equal(false)
        val reproduction = execute_debug_evidence_semantic_v1(root, "reproduce")?
        expect(reproduction.event_count).to_equal(1)
        expect(reproduction.original_defect_fixed).to_equal(false)

    it "rejects a shell-shaped trace path before any side effect":
        val root = "build/test-cli-debug-semantic-replay-unsafe"
        val sentinel = "build/test-cli-debug-semantic-replay-injected"
        val _ = file_delete(sentinel)
        expect(dir_create_all(root)).to_equal(true)
        expect(file_write(root + "/manifest.sdn",
            replay_manifest_v1("raw/trace';touch_injected.sst",
                "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))).to_equal(true)
        val result = execute_debug_evidence_semantic_v1(root, "replay")
        expect(result.is_err()).to_equal(true)
        expect(file_exists(sentinel)).to_equal(false)
