use std.io.hosted_volatile_u16_device.{
    HOSTED_VOLATILE_U16_CAPACITY,
    hosted_volatile_u16_owner,
    hosted_volatile_u16_current_owner_admitted,
    hosted_volatile_u16_admit,
    hosted_volatile_u16_reset,
    hosted_volatile_u16_register,
    hosted_volatile_u16_unregister,
    hosted_volatile_u16_try_read,
    hosted_volatile_u16_write
}
use std.io.volatile_ops.{volatile_read_u16, volatile_write_u16}

fn emit_bool(name: text, value: bool):
    print name + "," + value.to_text()

fn emit_i64(name: text, value: i64):
    print name + "," + value.to_text()

fn main() -> i64:
    emit_bool("owned-before-admit", hosted_volatile_u16_current_owner_admitted())
    emit_i64("read-before-admit", hosted_volatile_u16_try_read(4096))
    emit_bool("write-before-admit", hosted_volatile_u16_write(4096, 1))
    emit_bool("admit-owner", hosted_volatile_u16_admit())
    emit_bool("owned-after-admit", hosted_volatile_u16_current_owner_admitted())
    emit_bool("admit-duplicate", hosted_volatile_u16_admit())
    emit_i64("generation-admit", hosted_volatile_u16_owner().generation)
    emit_bool("register-zero-address", hosted_volatile_u16_register(0, 1))
    emit_bool("register-u16-a", hosted_volatile_u16_register(4096, 131071))
    emit_bool("register-duplicate", hosted_volatile_u16_register(4096, 2))
    emit_bool("register-u16-b", hosted_volatile_u16_register(12288, 17))
    emit_bool("register-u16-c", hosted_volatile_u16_register(16384, 33))
    emit_i64("generation-register", hosted_volatile_u16_owner().generation)
    emit_i64("facade-read-unknown", volatile_read_u16(8192))
    emit_i64("facade-read-normalized", volatile_read_u16(4096))
    volatile_write_u16(8192, 1)
    emit_i64("generation-write-unknown", hosted_volatile_u16_owner().generation)
    volatile_write_u16(4096, 65538)
    emit_i64("facade-read-written", volatile_read_u16(4096))
    emit_i64("generation-write", hosted_volatile_u16_owner().generation)
    emit_bool("unregister-unknown", hosted_volatile_u16_unregister(8192))
    emit_i64("generation-unregister-unknown", hosted_volatile_u16_owner().generation)
    emit_bool("unregister-middle", hosted_volatile_u16_unregister(12288))
    emit_i64("retained-left", volatile_read_u16(4096))
    emit_i64("removed-middle", volatile_read_u16(12288))
    emit_i64("retained-right", volatile_read_u16(16384))
    emit_i64("generation-unregister", hosted_volatile_u16_owner().generation)
    emit_bool("reset-owner", hosted_volatile_u16_reset())
    emit_i64("generation-reset", hosted_volatile_u16_owner().generation)
    var i = 0
    var all_registered = true
    while i < HOSTED_VOLATILE_U16_CAPACITY:
        if not hosted_volatile_u16_register(32768 + i, i):
            all_registered = false
        i = i + 1
    emit_bool("capacity-fill", all_registered)
    emit_bool("capacity-reject", hosted_volatile_u16_register(65536, 1))
    emit_i64("capacity-live", hosted_volatile_u16_owner().live_addresses)
    emit_i64("generation-capacity", hosted_volatile_u16_owner().generation)
    0
