"""
## Purpose and audience
Purpose: Prove that File Shell Ext.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-APP-IO-001 — stable requirement identity for this spec.

use app.io.file_shell.{shell, shell_output, file_write, file_delete, file_size}
use std.common.spec.evidence.untyped_capture.{UntypedCapture, untyped_capture_to_canonical}
use std.common.spec.evidence.model.{EvidenceStatus, oracle_spec, check_exact}
use std.common.spec.evidence.evidence_comparator.{compare_evidence}

use std.spec.step

describe "File Shell Ext":
    it "executes shell commands and returns stdout with exit code":
        step("Verify: executes shell commands and returns stdout with exit code")
        # @req: REQ-APP-IO-001
        val result = shell("printf hello")
        val stdout = result.0
        val exit_code = result.2

        expect(exit_code).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(stdout).to_equal("hello")

        val capture = UntypedCapture(label: "file-shell-exec-stdout", raw_value: stdout, source_kind: "stdout")
        val evidence = untyped_capture_to_canonical(capture, "file_shell_exec_spec/executes-shell-commands-stdout")
        val comparison = compare_evidence(evidence, oracle_spec("file_shell_exec_spec/executes-shell-commands-stdout", [
            check_exact("value", "hello")
        ]))
        expect(comparison.status).to_equal(EvidenceStatus.passed)

    it "returns non-zero exit code for failing commands":
        step("Verify: returns non-zero exit code for failing commands")
        val result = shell("false")
        expect(result.2).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "captures stderr from shell commands":
        step("Verify: captures stderr from shell commands")
        val result = shell("printf errmsg >&2")
        expect(result.1).to_contain("errmsg")

    it "returns trimmed stdout from shell_output":
        step("Verify: returns trimmed stdout from shell_output")
        val out = shell_output("printf '  trimmed  '")
        expect(out).to_equal("trimmed")

    it "writes overwrites sizes and deletes temporary files":
        step("Verify: writes overwrites sizes and deletes temporary files")
        val path = "/tmp/simple_test_file_shell_exec_spec.txt"

        expect(file_write(path, "first")).to_equal(true)
        expect(shell_output("cat /tmp/simple_test_file_shell_exec_spec.txt")).to_equal("first")

        expect(file_write(path, "second")).to_equal(true)
        expect(shell_output("cat /tmp/simple_test_file_shell_exec_spec.txt")).to_equal("second")
        expect(file_size(path)).to_be_greater_than(0)

        file_delete(path)
        expect(shell("test -f /tmp/simple_test_file_shell_exec_spec.txt").2).to_equal(1)

    it "returns zero size for missing files":
        step("Verify: returns zero size for missing files")
        val size = file_size("/tmp/simple_test_file_shell_nonexistent_size.txt")
        expect(size).to_equal(0)  # oracle: 0 — named expected value from the requirement
