"""Prove diagnostic location/search parsing is canonical and allocation-bounded."""

use app.cli.query_rich_common.{_find_in_line_from, _parse_error_location}
use std.io_runtime.file_read
use std.spec.step

describe "query diagnostic byte scanning":
    it "preserves byte offsets location fields and total find bounds":
        step("Parse source coordinates without per-candidate substrings")
        val parsed = _parse_error_location("12:7: warning: café: example")
        expect(parsed.0).to_equal(12)
        expect(parsed.1).to_equal(7)
        expect(parsed.2).to_equal("warning: café: example")
        val zero_col = _parse_error_location("4:0: message")
        expect(zero_col.0).to_equal(4)
        expect(zero_col.1).to_equal(1)
        val invalid = _parse_error_location("opaque failure")
        expect(invalid.0).to_equal(1)
        expect(invalid.1).to_equal(1)
        expect(invalid.2).to_equal("opaque failure")
        expect(_find_in_line_from("é|||RELATED", "|||", 0)).to_equal(2)
        expect(_find_in_line_from("é error error", "error", 4)).to_equal(9)
        expect(_find_in_line_from("abc", "a", -7)).to_equal(0)
        expect(_find_in_line_from("abc", "", 3)).to_equal(3)
        expect(_find_in_line_from("abc", "", 4)).to_equal(-1)
        expect(_find_in_line_from("abc", "abcdef", 0)).to_equal(-1)

    it "routes diagnostic owners through one byte-scanning parser":
        step("Reject duplicate parsers and candidate substring allocation")
        val common = file_read("src/app/cli/query_rich_common.spl")
        val parser_start = common.index_of("fn _parse_error_location(")
        val parser_end = common.index_of("fn _extract_decl_name(", parser_start)
        val parser = common.slice(parser_start, parser_end)
        expect(parser).to_contain("err.byte_at(ci) == 58")
        expect(parser).not.to_contain("substring(ci, ci + 1)")
        val find_start = common.index_of("fn _find_in_line_from(")
        val find_end = common.index_of(
            "fn query_rich_nonnegative_int_or_zero(", find_start)
        val finder = common.slice(find_start, find_end)
        expect(finder).to_contain("line.byte_at(i + ni)")
        expect(finder).to_contain("needle.byte_at(ni)")
        expect(finder).not.to_contain("line.substring(i, i + nlen)")
        val commands = file_read("src/app/cli/query_commands.spl")
        expect(commands).to_contain("val parsed = _parse_error_location(err)")
        expect(commands).not.to_contain("fn _parse_error_location(")
        val check = file_read("src/app/cli/query_check.spl")
        expect(check).to_contain("val parsed = _parse_error_location(core_err)")
        expect(check).to_contain("_find_in_line_from(err, sep, 0)")
        expect(check).not.to_contain("fn _parse_error_location(")
        expect(check).not.to_contain("fn _find_in_line_from(")
