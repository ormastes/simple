"""
## Purpose and audience
Engine Render — DebugDrawBuffer Tests

Tests line, box, circle, cross drawing, lifetime expiration, and clear.
"""

use std.spec.{describe, it, expect}
use std.common.engine.math2d.{Vec2}
use std.nogc_sync_mut.engine.render.debug_draw_api.{DebugColor, DebugDrawEntry, DebugDrawBuffer}

# @req: REQ-ENGINE-DebugDrawApi-001
describe "DebugColor":
    it "creates preset colors":
        # @req: REQ-ENGINE-DebugDrawApi-001
        step("Verify: creates preset colors")
        val r = DebugColor.red()
        expect(r.r).to_equal(1.0)  # oracle: value fixed by the spec contract
        expect(r.g).to_equal(0.0)  # oracle: value fixed by the spec contract

        val g = DebugColor.green()
        expect(g.g).to_equal(1.0)  # oracle: value fixed by the spec contract

        val b = DebugColor.blue()
        expect(b.b).to_equal(1.0)  # oracle: value fixed by the spec contract

        val w = DebugColor.white()
        expect(w.r).to_equal(1.0)  # oracle: value fixed by the spec contract
        expect(w.g).to_equal(1.0)  # oracle: value fixed by the spec contract
        expect(w.b).to_equal(1.0)  # oracle: value fixed by the spec contract

        val y = DebugColor.yellow()
        expect(y.r).to_equal(1.0)  # oracle: value fixed by the spec contract
        expect(y.g).to_equal(1.0)  # oracle: value fixed by the spec contract
        expect(y.b).to_equal(0.0)  # oracle: value fixed by the spec contract

describe "DebugDrawBuffer":
    it "draws a single line":
        # @req: REQ-ENGINE-DebugDrawApi-001
        step("Verify: draws a single line")
        var buf = DebugDrawBuffer.new(100)
        val s = Vec2(x: 0.0, y: 0.0)
        val e = Vec2(x: 10.0, y: 10.0)
        buf.draw_line(s, e, DebugColor.red(), 1.0)
        expect(buf.entry_count()).to_equal(1)  # oracle: value fixed by the spec contract

    it "draws a box as 4 lines":
        # @req: REQ-ENGINE-DebugDrawApi-001
        step("Verify: draws a box as 4 lines")
        var buf = DebugDrawBuffer.new(100)
        val c = Vec2(x: 5.0, y: 5.0)
        buf.draw_box(c, 2.0, 3.0, DebugColor.green(), 1.0)
        expect(buf.entry_count()).to_equal(4)  # oracle: value fixed by the spec contract

    it "draws a circle as 16 line segments":
        # @req: REQ-ENGINE-DebugDrawApi-001
        step("Verify: draws a circle as 16 line segments")
        var buf = DebugDrawBuffer.new(100)
        val c = Vec2(x: 0.0, y: 0.0)
        buf.draw_circle(c, 5.0, DebugColor.blue(), 1.0)
        expect(buf.entry_count()).to_equal(16)  # oracle: value fixed by the spec contract

    it "draws a cross as 2 lines":
        # @req: REQ-ENGINE-DebugDrawApi-001
        step("Verify: draws a cross as 2 lines")
        var buf = DebugDrawBuffer.new(100)
        val c = Vec2(x: 0.0, y: 0.0)
        buf.draw_cross(c, 4.0, DebugColor.yellow(), 1.0)
        expect(buf.entry_count()).to_equal(2)  # oracle: value fixed by the spec contract

    it "respects max_entries limit":
        # @req: REQ-ENGINE-DebugDrawApi-001
        step("Verify: respects max_entries limit")
        var buf = DebugDrawBuffer.new(2)
        val p = Vec2(x: 0.0, y: 0.0)
        buf.draw_line(p, p, DebugColor.white(), 1.0)
        buf.draw_line(p, p, DebugColor.white(), 1.0)
        buf.draw_line(p, p, DebugColor.white(), 1.0)
        expect(buf.entry_count()).to_equal(2)  # oracle: value fixed by the spec contract

    it "removes expired entries on update":
        # @req: REQ-ENGINE-DebugDrawApi-001
        step("Verify: removes expired entries on update")
        var buf = DebugDrawBuffer.new(100)
        val p = Vec2(x: 0.0, y: 0.0)
        buf.draw_line(p, p, DebugColor.red(), 0.5)
        buf.draw_line(p, p, DebugColor.green(), 2.0)
        buf.update(1.0)
        expect(buf.entry_count()).to_equal(1)  # oracle: value fixed by the spec contract

    it "decrements lifetime on update":
        # @req: REQ-ENGINE-DebugDrawApi-001
        step("Verify: decrements lifetime on update")
        var buf = DebugDrawBuffer.new(100)
        val p = Vec2(x: 0.0, y: 0.0)
        buf.draw_line(p, p, DebugColor.red(), 3.0)
        buf.update(1.0)
        val entries = buf.get_entries()
        expect(entries[0].lifetime).to_equal(2.0)  # oracle: value fixed by the spec contract

    it "clears all entries":
        # @req: REQ-ENGINE-DebugDrawApi-001
        step("Verify: clears all entries")
        var buf = DebugDrawBuffer.new(100)
        val p = Vec2(x: 0.0, y: 0.0)
        buf.draw_line(p, p, DebugColor.red(), 1.0)
        buf.draw_line(p, p, DebugColor.green(), 1.0)
        buf.clear()
        expect(buf.entry_count()).to_equal(0)  # oracle: value fixed by the spec contract

    it "returns entries via get_entries":
        # @req: REQ-ENGINE-DebugDrawApi-001
        step("Verify: returns entries via get_entries")
        var buf = DebugDrawBuffer.new(100)
        val s = Vec2(x: 1.0, y: 2.0)
        val e = Vec2(x: 3.0, y: 4.0)
        buf.draw_line(s, e, DebugColor.white(), 5.0)
        val entries = buf.get_entries()
        expect(entries.len()).to_equal(1)  # oracle: value fixed by the spec contract
        expect(entries[0].line.start.x).to_equal(1.0)  # oracle: value fixed by the spec contract
        expect(entries[0].line.end_point.x).to_equal(3.0)  # oracle: value fixed by the spec contract
        expect(entries[0].lifetime).to_equal(5.0)  # oracle: value fixed by the spec contract
