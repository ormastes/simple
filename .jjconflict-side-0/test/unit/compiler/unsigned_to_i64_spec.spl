# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Regression: unsigned primitive to_i64 must return the numeric value, not the bit count.

use std.spec.step

describe "unsigned integer to_i64":
    # @manual scenario evidence
    it "preserves u8 values pushed into arrays":
        # @req REQ-SSPEC-UNIT
        step("preserves u8 values pushed into arrays")
        var xs: [u8] = []
        xs.push(0u8)
        xs.push(1u8)
        xs.push(2u8)
        xs.push(4u8)
        xs.push(8u8)
        xs.push(16u8)
        xs.push(255u8)

        expect(xs[0].to_i64()).to_equal(0)
        expect(xs[1].to_i64()).to_equal(1)
        expect(xs[2].to_i64()).to_equal(2)
        expect(xs[3].to_i64()).to_equal(4)
        expect(xs[4].to_i64()).to_equal(8)
        expect(xs[5].to_i64()).to_equal(16)
        expect(xs[6].to_i64()).to_equal(255)

    it "preserves TLS vector hex u8 literals":
        # @req REQ-SSPEC-UNIT
        step("preserves TLS vector hex u8 literals")
        var salt: [u8] = []
        salt.push(0x00u8)
        salt.push(0x01u8)
        salt.push(0x02u8)
        salt.push(0x03u8)
        salt.push(0x04u8)
        salt.push(0x05u8)
        salt.push(0x06u8)
        salt.push(0x07u8)
        salt.push(0x08u8)
        salt.push(0x09u8)
        salt.push(0x0au8)
        salt.push(0x0bu8)
        salt.push(0x0cu8)

        expect(salt[8].to_i64()).to_equal(8)
        expect(salt[9].to_i64()).to_equal(9)
        expect(salt[10].to_i64()).to_equal(10)
        expect(salt[11].to_i64()).to_equal(11)
        expect(salt[12].to_i64()).to_equal(12)
