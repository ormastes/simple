# Canonical orchestration for the baremetal OS SSH component profiles.

use os.posix.mod.{posix_init}
use test.system.os_ssh_support.{os_ssh_report}
use test.system.os_ssh_protocol_profiles.{os_ssh_test_crypto, os_ssh_test_packet_codec, os_ssh_test_auth, os_ssh_test_channel_table, os_ssh_test_transport, os_ssh_test_daemon, os_ssh_test_message_builders}
use test.system.os_ssh_crypto_profiles.{os_ssh_test_cipher, os_ssh_test_kex, os_ssh_test_mpint}

extern fn serial_println(msg: text)

pub fn run_os_ssh_suite():
    serial_println("=== OS SSH & Crypto Unit Tests (143 tests) ===")
    serial_println("")
    posix_init()
    os_ssh_test_crypto()
    os_ssh_test_packet_codec()
    os_ssh_test_auth()
    os_ssh_test_channel_table()
    os_ssh_test_transport()
    os_ssh_test_daemon()
    os_ssh_test_message_builders()
    os_ssh_test_cipher()
    os_ssh_test_kex()
    os_ssh_test_mpint()
    os_ssh_report()

export run_os_ssh_suite
