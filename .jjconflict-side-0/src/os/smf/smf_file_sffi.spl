# SMF artifact file provider. Keeps raw runtime hooks at one explicit FFI
# boundary so the loader can use stable semantic aliases.

@unsafe(reason: "SMF artifact existence ABI; false includes missing or provider failure", capabilities: [ffi])
extern fn rt_file_exists(path: text) -> bool
@unsafe(reason: "SMF artifact byte-read ABI; empty bytes include missing or provider failure", capabilities: [ffi])
extern fn rt_file_read_bytes(path: text) -> [u8]

fn smf_file_exists(path: text) -> bool:
    unsafe(capabilities: [ffi]):
        rt_file_exists(path)

fn smf_file_read_bytes(path: text) -> [u8]:
    unsafe(capabilities: [ffi]):
        rt_file_read_bytes(path) ?? []
