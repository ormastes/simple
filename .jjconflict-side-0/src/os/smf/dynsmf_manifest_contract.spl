# Pure dynSMF manifest value contract.  Kept separate from session mechanics so
# OS admission modules can validate artifacts without depending on the loader
# session implementation.

class DynSmfManifestEntry:
    id: text
    path: text
    source_module: text
    artifact_kind: text
    abi_version: text
    default_autoload: bool
    exports: [text]

export DynSmfManifestEntry
