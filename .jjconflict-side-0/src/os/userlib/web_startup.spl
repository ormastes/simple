# User boundary for scheduler-issued `/WEB.ELF` startup evidence (ABI 132).

use os.userlib.syscall_raw.{syscall}
use os.kernel.loader.web_launch_grants.{
    SIMPLEOS_WEB_CONFIGURED_BIND_IPV4_V1, SIMPLEOS_WEB_HTTP_PORT_V1
}

pub(package) class WebStartupAdmissionV1:
    consumed: bool

pub struct WebStartupEndpointProjectionV1:
    bind_ipv4_address: u32
    port: u16

pub fn web_startup_result_admitted_v1(result: i64) -> bool:
    """Interpret only ABI 132's canonical success result as admission."""
    result == 1

pub fn web_startup_evidence_consume_v1() -> bool:
    """Consume the current WEB execution's opaque one-shot receipt."""
    web_startup_result_admitted_v1(
        syscall(132u64, 0u64, 0u64, 0u64, 0u64, 0u64))

pub(package) fn web_startup_admission_consume_v1() -> WebStartupAdmissionV1:
    WebStartupAdmissionV1(consumed: web_startup_evidence_consume_v1())

pub(package) fn web_startup_admission_ready_v1(
    admission: WebStartupAdmissionV1
) -> bool:
    admission.consumed

pub(package) fn web_startup_admission_endpoint_v1(
    admission: WebStartupAdmissionV1
) -> WebStartupEndpointProjectionV1?:
    """Project the one fixed, read-only endpoint after successful admission."""
    if not admission.consumed: return nil
    Some(WebStartupEndpointProjectionV1(
        bind_ipv4_address: SIMPLEOS_WEB_CONFIGURED_BIND_IPV4_V1,
        port: SIMPLEOS_WEB_HTTP_PORT_V1))
