# Ring-3 client for the kernel-owned PID1 root-service catalog.
#
# The ABI deliberately exposes opaque IDs only.  It has no path, capability,
# image, or manifest arguments: all of those remain verified kernel policy.

use os.userlib.syscall_raw.{syscall}

pub val ROOT_SERVICE_VFS: u64 = 1u64
pub val ROOT_SERVICE_NET: u64 = 2u64
pub val ROOT_SERVICE_HTTP: u64 = 3u64
pub val SYS_ROOT_SERVICE_SPAWN: u64 = 136u64
pub val SYS_ROOT_SERVICE_STOP: u64 = 137u64
pub val SYS_WAITPID: u64 = 61u64
pub val WNOHANG: u64 = 1u64

pub fn root_service_spawn(catalog_id: u64, priority: u64) -> i64:
    syscall(SYS_ROOT_SERVICE_SPAWN, catalog_id, priority, 0u64, 0u64, 0u64)

pub fn root_service_wait_nohang(pid: i64) -> i64:
    """Collect a known service child if it has exited; zero means still live."""
    syscall(SYS_WAITPID, pid as u64, 0u64, WNOHANG, 0u64, 0u64)

pub fn root_service_stop(pid: i64, exit_code: i64) -> i64:
    """Ask PID1's opaque catalogue authority to stop one direct service child.

    The kernel ignores this request unless the caller is the active root-mint
    PID1 and the target is its live direct child; applications cannot turn it
    into a general process-control primitive.
    """
    if pid <= 0:
        return -22
    syscall(SYS_ROOT_SERVICE_STOP, pid as u64, exit_code as u64, 0u64, 0u64, 0u64)
