"""Honest boot measurement and production-entropy capability contract.

Current bare-metal QEMU sources are deterministic placeholders and no TPM,
firmware keyring, or loaded-kernel measurement owner exists. Consequently this
module can report only `Unavailable`; it deliberately has no public or
package-private constructor that can fabricate a usable lease.

A future platform implementation must issue the opaque lease from one owner
after hardware entropy health checks and measured boot. Secret seed bytes are
package-private and must move directly into the loader signer owner.
"""

pub enum BootMeasurementEntropyAvailabilityV1:
    Native
    UnavailableDeterministicEntropy
    UnavailableNoMeasuredBootOwner

pub struct BootMeasurementEntropyStatusV1:
    availability: BootMeasurementEntropyAvailabilityV1
    reason: text

pub(package) struct BootMeasurementEntropyLeaseV1:
    generation: u64
    nonce: u64

pub(package) struct BootMeasurementEntropyReceiptV1:
    """Secret material returned only by authenticated owner-side redemption."""
    production_seed: [u8]
    kernel_sha256: text
    firmware_profile: text
    config_identity: text

trait BootMeasurementEntropyCapabilityV1:
    fn availability() -> BootMeasurementEntropyAvailabilityV1
    fn status() -> BootMeasurementEntropyStatusV1
    me acquire_once() -> BootMeasurementEntropyLeaseV1?

@cfg(baremetal)
pub fn boot_measurement_entropy_status_v1() -> BootMeasurementEntropyStatusV1:
    BootMeasurementEntropyStatusV1(
        availability:
            BootMeasurementEntropyAvailabilityV1.UnavailableDeterministicEntropy,
        reason: "baremetal entropy hooks are deterministic placeholders and no measured-boot owner exists")

@cfg(not(baremetal))
pub fn boot_measurement_entropy_status_v1() -> BootMeasurementEntropyStatusV1:
    BootMeasurementEntropyStatusV1(
        availability:
            BootMeasurementEntropyAvailabilityV1.UnavailableNoMeasuredBootOwner,
        reason: "host entropy is not a SimpleOS measured-boot capability")

pub(package) fn boot_measurement_entropy_lease_consume_v1(
    lease: BootMeasurementEntropyLeaseV1
) -> BootMeasurementEntropyReceiptV1?:
    """Fail closed until a platform owner supplies generational lease state."""
    # Checking shape is intentionally insufficient: without private owner state
    # there is nothing against which generation/nonce can be authenticated.
    nil
