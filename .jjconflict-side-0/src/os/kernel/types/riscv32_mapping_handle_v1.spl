# Architecture-neutral ABI contract for an RV32 scheduler mapping locator.
# It intentionally imports no loader, registry, or RISC-V implementation module.

pub(package) struct SchedulerRiscv32MappingHandleV1:
    slot_plus_one: u32
    handle_generation: u64

pub(package) fn scheduler_riscv32_mapping_handle_absent_v1() -> SchedulerRiscv32MappingHandleV1:
    SchedulerRiscv32MappingHandleV1(slot_plus_one: 0u32, handle_generation: 0u64)

pub(package) fn scheduler_riscv32_mapping_handle_present_v1(
    handle: SchedulerRiscv32MappingHandleV1
) -> bool:
    handle.slot_plus_one != 0u32 and handle.handle_generation != 0u64
