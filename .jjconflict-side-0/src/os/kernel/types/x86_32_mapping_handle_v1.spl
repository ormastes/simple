# Architecture-neutral ABI contract for an x86-32 scheduler mapping locator.
# It intentionally contains no page-directory address or mapper authority.

pub(package) struct SchedulerX8632MappingHandleV1:
    slot_plus_one: u32
    handle_generation: u64

pub(package) fn scheduler_x86_32_mapping_handle_absent_v1() -> SchedulerX8632MappingHandleV1:
    SchedulerX8632MappingHandleV1(slot_plus_one: 0u32, handle_generation: 0u64)

pub(package) fn scheduler_x86_32_mapping_handle_present_v1(
    handle: SchedulerX8632MappingHandleV1
) -> bool:
    # Any partial locator is occupied-but-malformed and must fail closed. A
    # future transfer owner must separately require both fields to be nonzero.
    handle.slot_plus_one != 0u32 or handle.handle_generation != 0u64
