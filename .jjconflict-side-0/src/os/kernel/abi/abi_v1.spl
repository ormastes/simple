# SimpleOS ABI v1 — frozen contract INDEX (freeze-by-reference).
#
# This file is the single authority for "what is ABI v1". It does NOT define a
# parallel type layer: the canonical owners below already define the types, and
# creating second definitions would violate the master plan's no-second-envelope
# rule (doc/01_research/domain/simpleos_production_host_master_plan.md §4).
#
# Canonical owners frozen under v1:
#   os.kernel.types.capability_types  — CapabilityToken/Kind/Set, CAP_RIGHT_* bits, Grant
#   os.kernel.types.ipc_types         — IpcPort, IpcMessage, IpcEndpoint
#   os.kernel.types.endpoint_types    — endpoint objects
#   os.kernel.types.task_types        — TaskId, task model
#   os.kernel.types.thread_types      — thread model
#   os.kernel.types.vmspace_types     — address-space/VM objects
#   os.kernel.types.memory_types      — memory objects
#   os.kernel.types.fs_types          — VFS-facing kernel types
#   os.kernel.types.notification_types— notification objects
#   os.kernel.types.syscall_types     — SyscallArgs/SyscallResult envelope
#   os.kernel.ipc.cspace_spawn        — SpawnSpec, CspaceMint (spawn contract)
#
# Changes to any owner's public surface are ABI changes: file an RFC per
# doc/04_architecture/os/abi/rfc_template.md (A00 approves). No subsystem may
# introduce a second IPC envelope, FD abstraction, process manifest, config
# descriptor, or private capability syntax.
#
# Accessor functions (not exported vals) — cross-module module-globals are
# unreliable in native codegen; functions are the stable import surface.

fn abi_v1_major() -> i64:
    return 1

fn abi_v1_minor() -> i64:
    return 0

# Canonical owner module paths, mirrored in the production status ledger
# (doc/08_tracking/os/production_status.sdn). The duplicate-owner guard spec
# asserts ledger/code parity against this list.
fn abi_v1_canonical_owners() -> [text]:
    return [
        "os.kernel.types.capability_types",
        "os.kernel.types.ipc_types",
        "os.kernel.types.endpoint_types",
        "os.kernel.types.task_types",
        "os.kernel.types.thread_types",
        "os.kernel.types.vmspace_types",
        "os.kernel.types.memory_types",
        "os.kernel.types.fs_types",
        "os.kernel.types.notification_types",
        "os.kernel.types.syscall_types",
        "os.kernel.ipc.cspace_spawn",
    ]

export abi_v1_major, abi_v1_minor, abi_v1_canonical_owners
