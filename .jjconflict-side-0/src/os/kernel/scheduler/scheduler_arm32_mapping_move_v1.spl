# Scheduler adapter for the canonical ARM32 page-table owner's opaque handle.
# No raw mapping receipt crosses this boundary after admission.

use os.kernel.types.arm32_mapping_handle_v1.{SchedulerArm32MappingHandleV1}
use os.kernel.arch_adapt.arm32_user_mapping.{
    Arm32UserPageTableReceiptV1,
    arm32_scheduler_mapping_handle_admit_v1,
    arm32_scheduler_mapping_handle_rollback_v1,
    arm32_scheduler_mapping_handle_publish_v1,
    arm32_scheduler_mapping_handle_mark_terminal_v1,
    arm32_scheduler_mapping_handle_reap_v1,
    arm32_scheduler_mapping_entry_state_v1,
    Arm32UserEntryStateV1
}

pub(package) fn scheduler_arm32_mapping_handle_admit_v1(
    prepared: Arm32UserPageTableReceiptV1,
    task_id: u64,
    lifecycle_generation: u64,
    exec_token: u64,
    exec_generation: u64
) -> SchedulerArm32MappingHandleV1?:
    arm32_scheduler_mapping_handle_admit_v1(
        prepared, task_id, lifecycle_generation, exec_token, exec_generation)

pub(package) fn scheduler_arm32_mapping_handle_rollback_v1(
    handle: SchedulerArm32MappingHandleV1,
    task_id: u64,
    lifecycle_generation: u64
) -> bool:
    arm32_scheduler_mapping_handle_rollback_v1(
        handle, task_id, lifecycle_generation)

pub(package) fn scheduler_arm32_mapping_handle_publish_v1(
    handle: SchedulerArm32MappingHandleV1,
    task_id: u64,
    lifecycle_generation: u64
) -> bool:
    arm32_scheduler_mapping_handle_publish_v1(
        handle, task_id, lifecycle_generation)

pub(package) fn scheduler_arm32_mapping_handle_mark_terminal_v1(
    handle: SchedulerArm32MappingHandleV1,
    task_id: u64,
    lifecycle_generation: u64
) -> bool:
    arm32_scheduler_mapping_handle_mark_terminal_v1(
        handle, task_id, lifecycle_generation)

pub(package) fn scheduler_arm32_mapping_handle_reap_v1(
    handle: SchedulerArm32MappingHandleV1,
    task_id: u64,
    lifecycle_generation: u64
) -> bool:
    arm32_scheduler_mapping_handle_reap_v1(
        handle, task_id, lifecycle_generation)

pub(package) fn scheduler_arm32_mapping_entry_state_v1(
    handle: SchedulerArm32MappingHandleV1,
    task_id: u64,
    lifecycle_generation: u64
) -> Arm32UserEntryStateV1?:
    arm32_scheduler_mapping_entry_state_v1(
        handle, task_id, lifecycle_generation)
