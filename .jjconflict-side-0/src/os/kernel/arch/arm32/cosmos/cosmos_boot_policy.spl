# Pure-Simple boot orchestration policy for the Cosmos+ Cortex-A9 lane.
# UART MMIO, volatile exception publication, assembly halt/WFI, status-string
# pointers, and all HAL side effects remain in cosmos_uart.c.

pub val COSMOS_BOOT_POLICY_DECISIONS: u32 = 38u32
pub val COSMOS_BOOT_POLICY_REQUIRED_LOW: u64 = 0xFFFFFFFFFFFFFFFFu64
pub val COSMOS_BOOT_POLICY_REQUIRED_HIGH: u64 = 0xFFFu64

val COSMOS_OK: i32 = 0
val COSMOS_UNAVAILABLE: i32 = 1
val COSMOS_INVALID: i32 = 2
val COSMOS_TIMEOUT: i32 = 3
val COSMOS_HW_ERROR: i32 = 4
val COSMOS_RETRY: i32 = 5
val EXCEPTION_CLEAR: u32 = 0x434C4541u32

pub val COSMOS_BOOT_STATUS_OK: u32 = 0u32
pub val COSMOS_BOOT_STATUS_UNAVAILABLE: u32 = 1u32
pub val COSMOS_BOOT_STATUS_INVALID: u32 = 2u32
pub val COSMOS_BOOT_STATUS_TIMEOUT: u32 = 3u32
pub val COSMOS_BOOT_STATUS_HW_ERROR: u32 = 4u32
pub val COSMOS_BOOT_STATUS_UNKNOWN: u32 = 5u32
pub val COSMOS_BOOT_EXCEPTION_DATA: u32 = 0u32
pub val COSMOS_BOOT_EXCEPTION_PREFETCH: u32 = 1u32
pub val COSMOS_BOOT_VERDICT_FAIL: u32 = 0u32
pub val COSMOS_BOOT_VERDICT_SOFTWARE: u32 = 1u32
pub val COSMOS_BOOT_VERDICT_SILICON: u32 = 2u32
pub val COSMOS_BOOT_POLL_CONTINUE: u32 = 0u32
pub val COSMOS_BOOT_POLL_FAIL: u32 = 1u32

# D00 uart.enabled
# D01 uart.write-ok
# D02 exception.first-capture
# D03 exception.prefetch
# D04 status.ok
# D05 status.unavailable
# D06 status.invalid
# D07 status.timeout
# D08 status.hw-error
# D09 stage.status-ok
# D10 software.runtime-ok
# D11 software.mmu-ok
# D12 software.gic-ok
# D13 software.policy-selftest-ok
# D14 selftest.qemu
# D15 handoff.software-ready
# D16 handoff.qemu
# D17 handoff.fsbl-ok
# D18 storage.nfc-ok
# D19 storage.pcie-ok
# D20 secondary.not-qemu
# D21 secondary.handoff-allowed
# D22 verdict.qemu
# D23 verdict.software-ready
# D24 verdict.qemu-smp-unavailable
# D25 verdict.qemu-fsbl-unavailable
# D26 verdict.qemu-nfc-unavailable
# D27 verdict.qemu-pcie-unavailable
# D28 verdict.qemu-storage-unavailable
# D29 verdict.silicon-smp-ok
# D30 verdict.silicon-fsbl-ok
# D31 verdict.silicon-nfc-ok
# D32 verdict.silicon-pcie-ok
# D33 verdict.silicon-storage-ok
# D34 irq.gic-ok
# D35 storage-poll.storage-ok
# D36 storage-poll.result-ok
# D37 storage-poll.result-retry

var g_cosmos_boot_policy_coverage_enabled: bool = false
var g_cosmos_boot_policy_coverage_low: u64 = 0u64
var g_cosmos_boot_policy_coverage_high: u64 = 0u64

fn _coverage_record(decision_id: u32, result: bool):
    if not g_cosmos_boot_policy_coverage_enabled:
        return
    val outcome_id = decision_id * 2u32 + (result as u32)
    if outcome_id < 64u32:
        g_cosmos_boot_policy_coverage_low =
            g_cosmos_boot_policy_coverage_low | ((1 as u64) << outcome_id)
    else:
        g_cosmos_boot_policy_coverage_high =
            g_cosmos_boot_policy_coverage_high |
                ((1 as u64) << (outcome_id - 64u32))

fn _as_c_int(result: bool) -> i32:
    if result: 1 else: 0

@export("C", name: "cosmos_boot_policy_coverage_reset")
pub fn cosmos_boot_policy_coverage_reset():
    g_cosmos_boot_policy_coverage_low = 0u64
    g_cosmos_boot_policy_coverage_high = 0u64
    g_cosmos_boot_policy_coverage_enabled = true

@export("C", name: "cosmos_boot_policy_coverage_low")
pub fn cosmos_boot_policy_coverage_low() -> u64:
    g_cosmos_boot_policy_coverage_low

@export("C", name: "cosmos_boot_policy_coverage_high")
pub fn cosmos_boot_policy_coverage_high() -> u64:
    g_cosmos_boot_policy_coverage_high

@export("C", name: "cosmos_boot_policy_coverage_required_low")
pub fn cosmos_boot_policy_coverage_required_low() -> u64:
    COSMOS_BOOT_POLICY_REQUIRED_LOW

@export("C", name: "cosmos_boot_policy_coverage_required_high")
pub fn cosmos_boot_policy_coverage_required_high() -> u64:
    COSMOS_BOOT_POLICY_REQUIRED_HIGH

@export("C", name: "cosmos_boot_policy_coverage_decisions")
pub fn cosmos_boot_policy_coverage_decisions() -> u32:
    COSMOS_BOOT_POLICY_DECISIONS

@export("C", name: "cosmos_boot_policy_uart_should_attempt")
pub fn cosmos_boot_policy_uart_should_attempt(
    enabled_mask: u32,
    uart_bit: u32
) -> i32:
    val enabled = (enabled_mask & uart_bit) != 0u32
    _coverage_record(0u32, enabled)
    _as_c_int(enabled)

@export("C", name: "cosmos_boot_policy_uart_next_enabled")
pub fn cosmos_boot_policy_uart_next_enabled(
    enabled_mask: u32,
    uart_bit: u32,
    write_status: i32
) -> u32:
    val write_ok = write_status == COSMOS_OK
    _coverage_record(1u32, write_ok)
    if write_ok: enabled_mask else: enabled_mask & ~uart_bit

@export("C", name: "cosmos_boot_policy_exception_should_capture")
pub fn cosmos_boot_policy_exception_should_capture(active_state: u32) -> i32:
    val first_capture = active_state == EXCEPTION_CLEAR
    _coverage_record(2u32, first_capture)
    _as_c_int(first_capture)

@export("C", name: "cosmos_boot_policy_exception_message_kind")
pub fn cosmos_boot_policy_exception_message_kind(kind: u32) -> u32:
    val prefetch = kind == 1u32
    _coverage_record(3u32, prefetch)
    if prefetch: COSMOS_BOOT_EXCEPTION_PREFETCH else: COSMOS_BOOT_EXCEPTION_DATA

@export("C", name: "cosmos_boot_policy_status_kind")
pub fn cosmos_boot_policy_status_kind(status: i32) -> u32:
    val ok = status == COSMOS_OK
    _coverage_record(4u32, ok)
    if ok: return COSMOS_BOOT_STATUS_OK
    val unavailable = status == COSMOS_UNAVAILABLE
    _coverage_record(5u32, unavailable)
    if unavailable: return COSMOS_BOOT_STATUS_UNAVAILABLE
    val invalid = status == COSMOS_INVALID
    _coverage_record(6u32, invalid)
    if invalid: return COSMOS_BOOT_STATUS_INVALID
    val timeout = status == COSMOS_TIMEOUT
    _coverage_record(7u32, timeout)
    if timeout: return COSMOS_BOOT_STATUS_TIMEOUT
    val hw_error = status == COSMOS_HW_ERROR
    _coverage_record(8u32, hw_error)
    if hw_error: COSMOS_BOOT_STATUS_HW_ERROR else: COSMOS_BOOT_STATUS_UNKNOWN

@export("C", name: "cosmos_boot_policy_stage_allowed")
pub fn cosmos_boot_policy_stage_allowed(status: i32) -> i32:
    val status_ok = status == COSMOS_OK
    _coverage_record(9u32, status_ok)
    _as_c_int(status_ok)

@export("C", name: "cosmos_boot_policy_software_ready")
pub fn cosmos_boot_policy_software_ready(
    runtime_status: i32,
    mmu_status: i32,
    gic_status: i32,
    policy_selftest: i32
) -> i32:
    val runtime_ok = runtime_status == COSMOS_OK
    _coverage_record(10u32, runtime_ok)
    if not runtime_ok: return 0
    val mmu_ok = mmu_status == COSMOS_OK
    _coverage_record(11u32, mmu_ok)
    if not mmu_ok: return 0
    val gic_ok = gic_status == COSMOS_OK
    _coverage_record(12u32, gic_ok)
    if not gic_ok: return 0
    val selftest_ok = policy_selftest != 0
    _coverage_record(13u32, selftest_ok)
    _as_c_int(selftest_ok)

@export("C", name: "cosmos_boot_policy_selftest")
pub fn cosmos_boot_policy_selftest(is_qemu: i32) -> i32:
    val qemu = is_qemu != 0
    _coverage_record(14u32, qemu)
    if qemu:
        return _as_c_int(
            cosmos_boot_policy_handoff_allows_devices(1, 1, COSMOS_UNAVAILABLE) != 0 and
            cosmos_boot_policy_handoff_allows_devices(1, 0, COSMOS_OK) == 0)
    _as_c_int(
        cosmos_boot_policy_handoff_allows_devices(0, 1, COSMOS_OK) != 0 and
        cosmos_boot_policy_handoff_allows_devices(0, 1, COSMOS_UNAVAILABLE) == 0 and
        cosmos_boot_policy_handoff_allows_devices(0, 0, COSMOS_OK) == 0)

@export("C", name: "cosmos_boot_policy_handoff_allows_devices")
pub fn cosmos_boot_policy_handoff_allows_devices(
    is_qemu: i32,
    software_ready: i32,
    fsbl_status: i32
) -> i32:
    val software_ok = software_ready != 0
    _coverage_record(15u32, software_ok)
    if not software_ok: return 0
    val qemu = is_qemu != 0
    _coverage_record(16u32, qemu)
    if qemu: return 1
    val fsbl_ok = fsbl_status == COSMOS_OK
    _coverage_record(17u32, fsbl_ok)
    _as_c_int(fsbl_ok)

@export("C", name: "cosmos_boot_policy_storage_init_allowed")
pub fn cosmos_boot_policy_storage_init_allowed(
    nfc_status: i32,
    pcie_status: i32
) -> i32:
    val nfc_ok = nfc_status == COSMOS_OK
    _coverage_record(18u32, nfc_ok)
    if not nfc_ok: return 0
    val pcie_ok = pcie_status == COSMOS_OK
    _coverage_record(19u32, pcie_ok)
    _as_c_int(pcie_ok)

@export("C", name: "cosmos_boot_policy_secondary_release_allowed")
pub fn cosmos_boot_policy_secondary_release_allowed(
    is_qemu: i32,
    handoff_allowed: i32
) -> i32:
    val not_qemu = is_qemu == 0
    _coverage_record(20u32, not_qemu)
    if not not_qemu: return 0
    val handoff_ok = handoff_allowed != 0
    _coverage_record(21u32, handoff_ok)
    _as_c_int(handoff_ok)

@export("C", name: "cosmos_boot_policy_terminal_verdict")
pub fn cosmos_boot_policy_terminal_verdict(
    is_qemu: i32,
    software_ready: i32,
    smp_status: i32,
    fsbl_status: i32,
    nfc_status: i32,
    pcie_status: i32,
    storage_status: i32
) -> u32:
    val qemu = is_qemu != 0
    _coverage_record(22u32, qemu)
    val software_ok = software_ready != 0
    _coverage_record(23u32, software_ok)
    if not software_ok: return COSMOS_BOOT_VERDICT_FAIL
    if qemu:
        val smp_unavailable = smp_status == COSMOS_UNAVAILABLE
        _coverage_record(24u32, smp_unavailable)
        if not smp_unavailable: return COSMOS_BOOT_VERDICT_FAIL
        val fsbl_unavailable = fsbl_status == COSMOS_UNAVAILABLE
        _coverage_record(25u32, fsbl_unavailable)
        if not fsbl_unavailable: return COSMOS_BOOT_VERDICT_FAIL
        val nfc_unavailable = nfc_status == COSMOS_UNAVAILABLE
        _coverage_record(26u32, nfc_unavailable)
        if not nfc_unavailable: return COSMOS_BOOT_VERDICT_FAIL
        val pcie_unavailable = pcie_status == COSMOS_UNAVAILABLE
        _coverage_record(27u32, pcie_unavailable)
        if not pcie_unavailable: return COSMOS_BOOT_VERDICT_FAIL
        val storage_unavailable = storage_status == COSMOS_UNAVAILABLE
        _coverage_record(28u32, storage_unavailable)
        if storage_unavailable:
            return COSMOS_BOOT_VERDICT_SOFTWARE
        return COSMOS_BOOT_VERDICT_FAIL
    val smp_ok = smp_status == COSMOS_OK
    _coverage_record(29u32, smp_ok)
    if not smp_ok: return COSMOS_BOOT_VERDICT_FAIL
    val fsbl_ok = fsbl_status == COSMOS_OK
    _coverage_record(30u32, fsbl_ok)
    if not fsbl_ok: return COSMOS_BOOT_VERDICT_FAIL
    val nfc_ok = nfc_status == COSMOS_OK
    _coverage_record(31u32, nfc_ok)
    if not nfc_ok: return COSMOS_BOOT_VERDICT_FAIL
    val pcie_ok = pcie_status == COSMOS_OK
    _coverage_record(32u32, pcie_ok)
    if not pcie_ok: return COSMOS_BOOT_VERDICT_FAIL
    val storage_ok = storage_status == COSMOS_OK
    _coverage_record(33u32, storage_ok)
    if storage_ok: COSMOS_BOOT_VERDICT_SILICON else: COSMOS_BOOT_VERDICT_FAIL

@export("C", name: "cosmos_boot_policy_irq_enable_allowed")
pub fn cosmos_boot_policy_irq_enable_allowed(gic_status: i32) -> i32:
    val gic_ok = gic_status == COSMOS_OK
    _coverage_record(34u32, gic_ok)
    _as_c_int(gic_ok)

@export("C", name: "cosmos_boot_policy_storage_poll_allowed")
pub fn cosmos_boot_policy_storage_poll_allowed(storage_status: i32) -> i32:
    val storage_ok = storage_status == COSMOS_OK
    _coverage_record(35u32, storage_ok)
    _as_c_int(storage_ok)

@export("C", name: "cosmos_boot_policy_storage_poll_action")
pub fn cosmos_boot_policy_storage_poll_action(poll_status: i32) -> u32:
    val result_ok = poll_status == COSMOS_OK
    _coverage_record(36u32, result_ok)
    if result_ok: return COSMOS_BOOT_POLL_CONTINUE
    val result_retry = poll_status == COSMOS_RETRY
    _coverage_record(37u32, result_retry)
    if result_retry: COSMOS_BOOT_POLL_CONTINUE else: COSMOS_BOOT_POLL_FAIL
