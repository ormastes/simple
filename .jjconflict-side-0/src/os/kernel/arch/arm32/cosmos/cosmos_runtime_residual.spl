# Pure-Simple Cosmos freestanding residual memory/string policy.
#
# C retains every public libc, rt_*, and ARM EABI symbol. These exports own the
# deterministic pointer traversal and comparison decisions behind those shims.

val COSMOS_RUNTIME_RESIDUAL_SCAN_LIMIT: u32 = 1000000u32
val COSMOS_RUNTIME_RESIDUAL_DECISIONS: u64 = 27u64
val COSMOS_RUNTIME_RESIDUAL_OUTCOMES_REQUIRED: u64 = 0x003FFFFFFFFFFFFFu64

val D_MOVE_DST_NULL: u32 = 0u32
val D_MOVE_SRC_NULL: u32 = 1u32
val D_MOVE_SAME: u32 = 2u32
val D_MOVE_FORWARD: u32 = 3u32
val D_MOVE_FORWARD_HAS_BYTE: u32 = 4u32
val D_MOVE_BACKWARD_HAS_BYTE: u32 = 5u32
val D_COMPARE_LEFT_NULL: u32 = 6u32
val D_COMPARE_RIGHT_NULL: u32 = 7u32
val D_COMPARE_HAS_BYTE: u32 = 8u32
val D_COMPARE_DIFFERS: u32 = 9u32
val D_LENGTH_TEXT_NULL: u32 = 10u32
val D_LENGTH_HAS_BYTE: u32 = 11u32
val D_LENGTH_TERMINATOR: u32 = 12u32
val D_STRING_LEFT_NULL: u32 = 13u32
val D_STRING_RIGHT_NULL: u32 = 14u32
val D_STRING_HAS_BYTE: u32 = 15u32
val D_STRING_DIFFERS: u32 = 16u32
val D_STRING_TERMINATOR: u32 = 17u32
val D_NSTRING_LEFT_NULL: u32 = 18u32
val D_NSTRING_RIGHT_NULL: u32 = 19u32
val D_NSTRING_HAS_BYTE: u32 = 20u32
val D_NSTRING_DIFFERS: u32 = 21u32
val D_NSTRING_TERMINATOR: u32 = 22u32
val D_COPY_DST_NULL: u32 = 23u32
val D_COPY_SRC_NULL: u32 = 24u32
val D_COPY_HAS_BYTE: u32 = 25u32
val D_COPY_TERMINATOR: u32 = 26u32

var g_cosmos_runtime_residual_outcomes: u64 = 0u64

fn _residual_coverage_record(decision_id: u32, result: bool):
    val outcome_id = decision_id * 2u32 + (result as u32)
    g_cosmos_runtime_residual_outcomes =
        g_cosmos_runtime_residual_outcomes | (1u64 << outcome_id)

@export("C", name: "cosmos_runtime_residual_coverage_reset")
pub fn cosmos_runtime_residual_coverage_reset():
    g_cosmos_runtime_residual_outcomes = 0u64

@export("C", name: "cosmos_runtime_residual_coverage_mask")
pub fn cosmos_runtime_residual_coverage_mask() -> u64:
    g_cosmos_runtime_residual_outcomes

@export("C", name: "cosmos_runtime_residual_coverage_required")
pub fn cosmos_runtime_residual_coverage_required() -> u64:
    COSMOS_RUNTIME_RESIDUAL_OUTCOMES_REQUIRED

@export("C", name: "cosmos_runtime_residual_coverage_decisions")
pub fn cosmos_runtime_residual_coverage_decisions() -> u64:
    COSMOS_RUNTIME_RESIDUAL_DECISIONS

@export("C", name: "cosmos_runtime_residual_memmove")
pub fn cosmos_runtime_residual_memmove(
    dst: *mut u8, src: *const u8, size: u32
) -> *mut u8:
    val dst_null = (dst as u64) == 0u64
    _residual_coverage_record(D_MOVE_DST_NULL, dst_null)
    if dst_null:
        return dst
    val src_null = (src as u64) == 0u64
    _residual_coverage_record(D_MOVE_SRC_NULL, src_null)
    if src_null:
        return dst
    val same = (dst as u64) == (src as u64)
    _residual_coverage_record(D_MOVE_SAME, same)
    if same:
        return dst
    val forward = (dst as u64) < (src as u64)
    _residual_coverage_record(D_MOVE_FORWARD, forward)
    if forward:
        var index = 0u32
        while true:
            val has_byte = index < size
            _residual_coverage_record(D_MOVE_FORWARD_HAS_BYTE, has_byte)
            if not has_byte:
                break
            danger:
                val byte = src.offset(index as isize).read()
                dst.offset(index as isize).write(byte)
            index = index + 1u32
    else:
        var index = size
        while true:
            val has_byte = index != 0u32
            _residual_coverage_record(D_MOVE_BACKWARD_HAS_BYTE, has_byte)
            if not has_byte:
                break
            index = index - 1u32
            danger:
                val byte = src.offset(index as isize).read()
                dst.offset(index as isize).write(byte)
    dst

@export("C", name: "cosmos_runtime_residual_memcmp")
pub fn cosmos_runtime_residual_memcmp(
    left: *const u8, right: *const u8, size: u32
) -> i32:
    val left_null = (left as u64) == 0u64
    _residual_coverage_record(D_COMPARE_LEFT_NULL, left_null)
    if left_null:
        if (right as u64) == 0u64:
            return 0
        return -1
    val right_null = (right as u64) == 0u64
    _residual_coverage_record(D_COMPARE_RIGHT_NULL, right_null)
    if right_null:
        return 1
    var index = 0u32
    while true:
        val has_byte = index < size
        _residual_coverage_record(D_COMPARE_HAS_BYTE, has_byte)
        if not has_byte:
            break
        danger:
            val left_byte = left.offset(index as isize).read()
            val right_byte = right.offset(index as isize).read()
            val differs = left_byte != right_byte
            _residual_coverage_record(D_COMPARE_DIFFERS, differs)
            if differs:
                return (left_byte as i32) - (right_byte as i32)
        index = index + 1u32
    0

@export("C", name: "cosmos_runtime_residual_strlen")
pub fn cosmos_runtime_residual_strlen(text: *const u8) -> u32:
    val text_null = (text as u64) == 0u64
    _residual_coverage_record(D_LENGTH_TEXT_NULL, text_null)
    if text_null:
        return 0u32
    var index = 0u32
    while true:
        val has_byte = index < COSMOS_RUNTIME_RESIDUAL_SCAN_LIMIT
        _residual_coverage_record(D_LENGTH_HAS_BYTE, has_byte)
        if not has_byte:
            break
        danger:
            val terminator = text.offset(index as isize).read() == 0u8
            _residual_coverage_record(D_LENGTH_TERMINATOR, terminator)
            if terminator:
                return index
        index = index + 1u32
    COSMOS_RUNTIME_RESIDUAL_SCAN_LIMIT

@export("C", name: "cosmos_runtime_residual_strcmp")
pub fn cosmos_runtime_residual_strcmp(
    left: *const u8, right: *const u8
) -> i32:
    val left_null = (left as u64) == 0u64
    _residual_coverage_record(D_STRING_LEFT_NULL, left_null)
    if left_null:
        if (right as u64) == 0u64:
            return 0
        return -1
    val right_null = (right as u64) == 0u64
    _residual_coverage_record(D_STRING_RIGHT_NULL, right_null)
    if right_null:
        return 1
    var index = 0u32
    while true:
        val has_byte = index < COSMOS_RUNTIME_RESIDUAL_SCAN_LIMIT
        _residual_coverage_record(D_STRING_HAS_BYTE, has_byte)
        if not has_byte:
            break
        danger:
            val left_byte = left.offset(index as isize).read()
            val right_byte = right.offset(index as isize).read()
            val differs = left_byte != right_byte
            _residual_coverage_record(D_STRING_DIFFERS, differs)
            if differs:
                return (left_byte as i32) - (right_byte as i32)
            val terminator = left_byte == 0u8
            _residual_coverage_record(D_STRING_TERMINATOR, terminator)
            if terminator:
                return 0
        index = index + 1u32
    0

@export("C", name: "cosmos_runtime_residual_strncmp")
pub fn cosmos_runtime_residual_strncmp(
    left: *const u8, right: *const u8, size: u32
) -> i32:
    val left_null = (left as u64) == 0u64
    _residual_coverage_record(D_NSTRING_LEFT_NULL, left_null)
    if left_null:
        if (right as u64) == 0u64:
            return 0
        return -1
    val right_null = (right as u64) == 0u64
    _residual_coverage_record(D_NSTRING_RIGHT_NULL, right_null)
    if right_null:
        return 1
    var index = 0u32
    while true:
        val has_byte = index < size
        _residual_coverage_record(D_NSTRING_HAS_BYTE, has_byte)
        if not has_byte:
            break
        danger:
            val left_byte = left.offset(index as isize).read()
            val right_byte = right.offset(index as isize).read()
            val differs = left_byte != right_byte
            _residual_coverage_record(D_NSTRING_DIFFERS, differs)
            if differs:
                return (left_byte as i32) - (right_byte as i32)
            val terminator = left_byte == 0u8
            _residual_coverage_record(D_NSTRING_TERMINATOR, terminator)
            if terminator:
                return 0
        index = index + 1u32
    0

@export("C", name: "cosmos_runtime_residual_strncpy")
pub fn cosmos_runtime_residual_strncpy(
    dst: *mut u8, src: *const u8, size: u32
) -> *mut u8:
    val dst_null = (dst as u64) == 0u64
    _residual_coverage_record(D_COPY_DST_NULL, dst_null)
    if dst_null:
        return dst
    val src_null = (src as u64) == 0u64
    _residual_coverage_record(D_COPY_SRC_NULL, src_null)
    if src_null:
        return dst
    var index = 0u32
    var padding = false
    while true:
        val has_byte = index < size
        _residual_coverage_record(D_COPY_HAS_BYTE, has_byte)
        if not has_byte:
            break
        var byte = 0u8
        if not padding:
            danger:
                byte = src.offset(index as isize).read()
            val terminator = byte == 0u8
            _residual_coverage_record(D_COPY_TERMINATOR, terminator)
            if terminator:
                padding = true
        danger:
            dst.offset(index as isize).write(byte)
        index = index + 1u32
    dst
