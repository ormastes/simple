# Deterministic read-only packaged root for UP Squared first-light.

use std.fs_driver.types.{DirEntry, Inode}
use os.kernel.arch.x86_64.up_squared.vfs.{up2_vfs_mount_root, up2_vfs_readdir}

fn _up2_packaged_entries() -> [DirEntry]:
    [
        DirEntry(name: "bin", inode: Inode(id: 2), is_dir: true, size: 0),
        DirEntry(name: "etc", inode: Inode(id: 3), is_dir: true, size: 0),
        DirEntry(name: "README.txt", inode: Inode(id: 4), is_dir: false, size: 34)
    ]

fn up2_mount_packaged_root() -> Result<text, text>:
    val mounted = up2_vfs_mount_root(_up2_packaged_entries())
    if mounted.is_err():
        return Err(mounted.unwrap_err())
    val entries = up2_vfs_readdir("/")
    var has_bin = false
    var has_etc = false
    var has_readme = false
    for entry in entries:
        if entry.name == "bin": has_bin = true
        if entry.name == "etc": has_etc = true
        if entry.name == "README.txt": has_readme = true
    if not has_bin or not has_etc or not has_readme:
        return Err("up2-root: public VFS listing incomplete")
    Ok("bin,etc,README.txt")

export up2_mount_packaged_root
