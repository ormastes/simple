# IPC Wire Envelope — flat codec + user-pointer policy
#
# One canonical on-the-wire envelope shared by the kernel IPC manager, the
# WM compositor service (src/os/services/wm/wm_service.spl `parse_message`)
# and every ring-3 client (examples/09_embedded/simpleos_remote_gui/
# remote_window_runtime.c):
#
#   +0  src_port    u64  little-endian
#   +8  dst_port    u64
#   +16 method      u32
#   +20 flags       u32
#   +24 payload_len u32
#   +28 cap_count   u32
#   +32 payload[payload_len]
#
# The header is 32 bytes (message_buffer.spl MSG_HDR_SIZE) and the payload is
# capped at one 4 KiB page (message_buffer.spl BUFFER_PAGE_SIZE), so the
# largest envelope is 4128 bytes — the ring-3 client's IPC_WIRE_CAPACITY.
#
# Freestanding-lane constraints (doc/00_llm_process/feature_expert/
# vector_fonts/skill.md): every function here is a flat scalar/byte-array API,
# no `text`, no Option-into-`val` match, no 3-operand `+` chains, and byte
# values are widened to u64/i64 before any arithmetic or comparison.

use os.kernel.errno.{EFAULT, EINVAL}

# ---------------------------------------------------------------------------
# Wire geometry
# ---------------------------------------------------------------------------

val IPC_WIRE_HEADER_SIZE: i64 = 32
val IPC_WIRE_PAYLOAD_MAX: i64 = 4096
val IPC_WIRE_CAPACITY: i64 = 4128

# flags bit 0 — "this envelope uses the v1 layout above". A ring-3 client
# rejects an envelope whose flags word is non-zero without this bit.
val IPC_WIRE_V1_FLAG: u32 = 1u32

# ---------------------------------------------------------------------------
# User virtual-address window
# ---------------------------------------------------------------------------
# Lower canonical half only. Anything at or above the limit is kernel or
# non-canonical and must never be dereferenced on behalf of a ring-3 caller.
# The first page is reserved so a NULL-adjacent pointer cannot pass.

val IPC_USER_VA_MIN: u64 = 4096u64
val IPC_USER_VA_LIMIT: u64 = 140737488355328u64   # 0x0000_8000_0000_0000

# ---------------------------------------------------------------------------
# Little-endian scalar helpers
# ---------------------------------------------------------------------------

fn _wire_byte_of_u64(value: u64, index: i64) -> u8:
    """Extract byte `index` (0 = least significant) of a u64."""
    val shift = (index * 8).to_u64()
    ((value >> shift) & 255u64).to_u8()

fn _wire_byte_of_u32(value: u32, index: i64) -> u8:
    """Extract byte `index` (0 = least significant) of a u32."""
    _wire_byte_of_u64(value.to_u64(), index)

fn ipc_wire_read_u32(bytes: [u8], offset: i64) -> u32:
    """Read a little-endian u32 at `offset`. Returns 0 if out of range."""
    if offset < 0:
        return 0u32
    if offset + 4 > bytes.len():
        return 0u32
    var acc: u64 = 0u64
    var i: i64 = 0
    while i < 4:
        val byte_wide = bytes[offset + i].to_u64()
        acc = acc | (byte_wide << (i * 8).to_u64())
        i = i + 1
    acc.to_u32()

fn ipc_wire_read_u64(bytes: [u8], offset: i64) -> u64:
    """Read a little-endian u64 at `offset`. Returns 0 if out of range."""
    if offset < 0:
        return 0u64
    if offset + 8 > bytes.len():
        return 0u64
    var acc: u64 = 0u64
    var i: i64 = 0
    while i < 8:
        val byte_wide = bytes[offset + i].to_u64()
        acc = acc | (byte_wide << (i * 8).to_u64())
        i = i + 1
    acc

# ---------------------------------------------------------------------------
# Envelope encode
# ---------------------------------------------------------------------------

fn ipc_wire_encode(
    src_port: u64,
    dst_port: u64,
    method: u32,
    flags: u32,
    payload: [u8]
) -> [u8]:
    """Serialize one envelope: 32-byte header followed by the payload bytes.

    `payload_len` in the header is always the real length of `payload`, so a
    header/body mismatch cannot be constructed through this entry point.
    Payloads longer than IPC_WIRE_PAYLOAD_MAX are truncated to the cap rather
    than emitting a header that over-promises.
    """
    var payload_len = payload.len()
    if payload_len > IPC_WIRE_PAYLOAD_MAX:
        payload_len = IPC_WIRE_PAYLOAD_MAX

    var out: [u8] = []
    var i: i64 = 0
    while i < 8:
        out.push(_wire_byte_of_u64(src_port, i))
        i = i + 1
    i = 0
    while i < 8:
        out.push(_wire_byte_of_u64(dst_port, i))
        i = i + 1
    i = 0
    while i < 4:
        out.push(_wire_byte_of_u32(method, i))
        i = i + 1
    i = 0
    while i < 4:
        out.push(_wire_byte_of_u32(flags, i))
        i = i + 1
    i = 0
    while i < 4:
        out.push(_wire_byte_of_u32(payload_len.to_u32(), i))
        i = i + 1
    i = 0
    while i < 4:
        out.push(0u8)
        i = i + 1

    i = 0
    while i < payload_len:
        out.push(payload[i])
        i = i + 1
    out

fn ipc_wire_payload_method(payload: [u8]) -> u32:
    """Method id a sender stamped into the first payload word.

    Every in-tree compositor client writes the compositor method as the first
    little-endian u32 of the payload and leaves the header method at 0, so the
    kernel lifts it into the header on send. Returns 0 for payloads shorter
    than one word, which is exactly the "no method" case.
    """
    if payload.len() < 4:
        return 0u32
    ipc_wire_read_u32(payload, 0)

# ---------------------------------------------------------------------------
# User-pointer policy (pure — touches no memory)
# ---------------------------------------------------------------------------

fn ipc_user_range_check(ptr: u64, len: u64, min_len: u64, max_len: u64) -> i32:
    """Fail-closed admission test for a ring-3 buffer range.

    Returns 0 when [ptr, ptr+len) may be copied to/from, or a negative errno.
    This decides nothing about whether the pages are actually mapped — the
    caller pairs it with a VMA/page-table check — but it is the gate that
    always applies, including when the task has no registered vmspace:

      -EFAULT  null / low-page pointer, arithmetic wraparound, or any part of
               the range at or above the user/kernel virtual-address boundary
      -EINVAL  length outside the caller's accepted band
    """
    if len < min_len:
        return 0 - EINVAL
    if len > max_len:
        return 0 - EINVAL
    if len == 0u64:
        return 0
    if ptr < IPC_USER_VA_MIN:
        return 0 - EFAULT
    if ptr + len < ptr:
        return 0 - EFAULT
    if ptr >= IPC_USER_VA_LIMIT:
        return 0 - EFAULT
    if ptr + len > IPC_USER_VA_LIMIT:
        return 0 - EFAULT
    0
