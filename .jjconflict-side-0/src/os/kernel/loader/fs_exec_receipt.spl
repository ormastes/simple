# codex-impl
# Typed result for a filesystem-backed executable handoff.

pub struct FsExecReceipt:
    pub path: text
    pub pid: i64
    pub exit_code: i64
    pub started: bool
    pub exited: bool
    pub process_registered: bool

pub fn fs_exec_receipt_failed(path: text, error_code: i64) -> FsExecReceipt:
    FsExecReceipt(path: path, pid: error_code, exit_code: error_code,
        started: false, exited: false, process_registered: false)

pub fn fs_exec_receipt_exited(path: text, pid: i64, exit_code: i64) -> FsExecReceipt:
    # A returned PID alone is not proof that a scheduler-owned process exists.
    FsExecReceipt(path: path, pid: pid, exit_code: exit_code,
        started: true, exited: true, process_registered: false)

pub fn fs_exec_receipt_exited_registered(path: text, pid: i64,
        exit_code: i64) -> FsExecReceipt:
    FsExecReceipt(path: path, pid: pid, exit_code: exit_code,
        started: true, exited: true, process_registered: pid > 0)
