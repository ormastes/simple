"""Pure nonce-bound ARM32 ELF builder, simulator, and live admission gate.

The executable contains ARM-state instructions: every stdout byte uses SVC
syscall 60 and termination uses SVC syscall 0 with status 37. Exact mounted
bytes can pass payload admission, but live execution remains blocked until an
ARM32 user CPSR/context and SVC return owner exists.
"""

pub val ARM32_REAL_EXEC_EXIT_CODE: i64 = 37
pub val ARM32_REAL_EXEC_PATH: text = "/SYS/APPS/FSEXA32.ELF"

pub struct Arm32RealExecSimulation:
    valid: bool
    stdout: text
    exit_code: i64

pub struct Arm32RealExecAdmission:
    payload_accepted: bool
    live_executable: bool
    status: i64
    reason: text

extern fn rt_string_from_byte_array(arr: [u8]) -> text

fn _arm32_push16(out: [u8], value: u64) -> [u8]:
    out.push((value & 0xff).to_u8())
    out.push(((value >> 8) & 0xff).to_u8())
    out

fn _arm32_push32(out: [u8], value: u64) -> [u8]:
    var bytes = out
    bytes = _arm32_push16(bytes, value)
    bytes = _arm32_push16(bytes, value >> 16)
    bytes

fn _arm32_read16(bytes: [u8], offset: i64) -> u64:
    bytes[offset].to_u64() | (bytes[offset + 1].to_u64() << 8)

fn _arm32_read32(bytes: [u8], offset: i64) -> u64:
    _arm32_read16(bytes, offset) | (_arm32_read16(bytes, offset + 2) << 16)

fn _arm32_mov_immediate(rd: u64, value: u64) -> u64:
    0xe3a00000 | (rd << 12) | (value & 0xff)

fn _arm32_nonce_valid(nonce: text) -> bool:
    if nonce.len() < 16 or nonce.len() > 128:
        return false
    var i = 0
    while i < nonce.len():
        val code = nonce.char_code_at(i)
        if code < 0x21 or code > 0x7e:
            return false
        i = i + 1
    true

pub fn arm32_real_exec_stdout(nonce: text) -> text:
    if not _arm32_nonce_valid(nonce):
        return ""
    "SIMPLEOS_FS_EXEC_OK arch=arm32 nonce={nonce}\n"

pub fn arm32_real_exec_elf(nonce: text) -> [u8]:
    val message = arm32_real_exec_stdout(nonce)
    if message == "":
        return []
    val code_size = (message.len() * 12 + 12).to_u64()
    var out: [u8] = [0x7f, 0x45, 0x4c, 0x46, 1, 1, 1, 0]
    while out.len() < 16:
        out.push(0)
    out = _arm32_push16(out, 2)
    out = _arm32_push16(out, 40)
    out = _arm32_push32(out, 1)
    out = _arm32_push32(out, 0x400000)
    out = _arm32_push32(out, 52)
    out = _arm32_push32(out, 0)
    out = _arm32_push32(out, 0x05000000)
    out = _arm32_push16(out, 52)
    out = _arm32_push16(out, 32)
    out = _arm32_push16(out, 1)
    out = _arm32_push16(out, 0)
    out = _arm32_push16(out, 0)
    out = _arm32_push16(out, 0)
    out = _arm32_push32(out, 1)
    out = _arm32_push32(out, 0x100)
    out = _arm32_push32(out, 0x400000)
    out = _arm32_push32(out, 0x400000)
    out = _arm32_push32(out, code_size)
    out = _arm32_push32(out, code_size)
    out = _arm32_push32(out, 5)
    out = _arm32_push32(out, 0x1000)
    while out.len() < 0x100:
        out.push(0)
    var i = 0
    while i < message.len():
        out = _arm32_push32(out, _arm32_mov_immediate(7, 60))
        out = _arm32_push32(out, _arm32_mov_immediate(0, message.char_code_at(i).to_u64()))
        out = _arm32_push32(out, 0xef000000)
        i = i + 1
    out = _arm32_push32(out, _arm32_mov_immediate(7, 0))
    out = _arm32_push32(out, _arm32_mov_immediate(0, ARM32_REAL_EXEC_EXIT_CODE.to_u64()))
    _arm32_push32(out, 0xef000000)

pub fn arm32_simulate_real_exec_elf(bytes: [u8]) -> Arm32RealExecSimulation:
    if bytes.len() < 0x10c or bytes[0] != 0x7f or bytes[4] != 1 or
            _arm32_read16(bytes, 16) != 2 or _arm32_read16(bytes, 18) != 40 or
            _arm32_read32(bytes, 20) != 1 or _arm32_read32(bytes, 36) != 0x05000000 or
            _arm32_read32(bytes, 52) != 1 or _arm32_read32(bytes, 56) != 0x100 or
            _arm32_read32(bytes, 76) != 5 or
            _arm32_read32(bytes, 68) != (bytes.len() - 0x100).to_u64():
        return Arm32RealExecSimulation(valid: false, stdout: "", exit_code: -1)
    var stdout_bytes: [u8] = []
    var offset = 0x100
    while offset + 12 <= bytes.len():
        val set_id = _arm32_read32(bytes, offset)
        val set_arg = _arm32_read32(bytes, offset + 4)
        if _arm32_read32(bytes, offset + 8) != 0xef000000:
            return Arm32RealExecSimulation(valid: false, stdout: rt_string_from_byte_array(stdout_bytes), exit_code: -1)
        val syscall_id = set_id & 0xff
        val arg = set_arg & 0xff
        if set_id != _arm32_mov_immediate(7, syscall_id) or
                set_arg != _arm32_mov_immediate(0, arg):
            return Arm32RealExecSimulation(valid: false, stdout: rt_string_from_byte_array(stdout_bytes), exit_code: -1)
        if syscall_id == 60:
            stdout_bytes.push(arg.to_u8())
        elif syscall_id == 0 and offset + 12 == bytes.len():
            return Arm32RealExecSimulation(
                valid: arg.to_i64() == ARM32_REAL_EXEC_EXIT_CODE,
                stdout: rt_string_from_byte_array(stdout_bytes), exit_code: arg.to_i64())
        else:
            return Arm32RealExecSimulation(valid: false, stdout: rt_string_from_byte_array(stdout_bytes), exit_code: -1)
        offset = offset + 12
    Arm32RealExecSimulation(valid: false, stdout: rt_string_from_byte_array(stdout_bytes), exit_code: -1)

pub fn arm32_admit_mounted_real_exec(bytes: [u8], nonce: text) -> Arm32RealExecAdmission:
    val expected = arm32_real_exec_elf(nonce)
    if expected.len() == 0:
        return Arm32RealExecAdmission(
            payload_accepted: false, live_executable: false,
            status: -22, reason: "arm32-real-exec-invalid-nonce")
    if bytes != expected:
        return Arm32RealExecAdmission(
            payload_accepted: false, live_executable: false,
            status: -13, reason: "arm32-real-exec-mounted-bytes-mismatch")
    val simulated = arm32_simulate_real_exec_elf(bytes)
    if not simulated.valid or simulated.stdout != arm32_real_exec_stdout(nonce) or
            simulated.exit_code != ARM32_REAL_EXEC_EXIT_CODE:
        return Arm32RealExecAdmission(
            payload_accepted: false, live_executable: false,
            status: -8, reason: "arm32-real-exec-payload-invalid")
    Arm32RealExecAdmission(
        payload_accepted: true, live_executable: false,
        status: -95, reason: "arm32-user-cpsr-svc-return-not-installed")

export Arm32RealExecSimulation, Arm32RealExecAdmission
export arm32_real_exec_stdout, arm32_real_exec_elf
export arm32_simulate_real_exec_elf, arm32_admit_mounted_real_exec

