# VM process lifecycle model. Live process ownership remains unsupported until
# the platform facade exposes a cancellable process lease.

enum VmLifecycleState:
    Reserved
    Launched
    Ready
    Running
    TimedOut
    Stopped
    Failed

struct VmProcessLifecycleV1:
    state: VmLifecycleState
    port: i64
    pid: i64
    serial_path: text
    qmp_path: text
    challenge: text
    timeout_ms: i64
    cleanup_complete: bool

pub fn vm_lifecycle_reserve(port: i64, serial_path: text, qmp_path: text, challenge: text, timeout_ms: i64) -> VmProcessLifecycleV1:
    VmProcessLifecycleV1(state: VmLifecycleState.Reserved, port: port, pid: 0, serial_path: serial_path, qmp_path: qmp_path, challenge: challenge, timeout_ms: timeout_ms, cleanup_complete: false)

pub fn vm_lifecycle_mark_launched(life: VmProcessLifecycleV1, pid: i64) -> VmProcessLifecycleV1:
    VmProcessLifecycleV1(state: if pid > 0: VmLifecycleState.Launched else: VmLifecycleState.Failed, port: life.port, pid: pid, serial_path: life.serial_path, qmp_path: life.qmp_path, challenge: life.challenge, timeout_ms: life.timeout_ms, cleanup_complete: false)

pub fn vm_lifecycle_mark_ready(life: VmProcessLifecycleV1, serial: text) -> VmProcessLifecycleV1:
    var next = life
    if life.state == VmLifecycleState.Launched and serial.contains("SIMPLEOS_QEMU_NONCE=" + life.challenge):
        next.state = VmLifecycleState.Ready
    next

pub fn vm_lifecycle_begin_operation(life: VmProcessLifecycleV1) -> VmProcessLifecycleV1:
    var next = life
    if life.state == VmLifecycleState.Ready: next.state = VmLifecycleState.Running
    next

pub fn vm_lifecycle_shutdown(life: VmProcessLifecycleV1, timed_out: bool) -> VmProcessLifecycleV1:
    VmProcessLifecycleV1(state: if timed_out: VmLifecycleState.TimedOut else: VmLifecycleState.Stopped, port: life.port, pid: life.pid, serial_path: life.serial_path, qmp_path: life.qmp_path, challenge: life.challenge, timeout_ms: life.timeout_ms, cleanup_complete: false)

pub fn vm_lifecycle_cleanup(life: VmProcessLifecycleV1) -> VmProcessLifecycleV1:
    VmProcessLifecycleV1(state: life.state, port: life.port, pid: life.pid, serial_path: life.serial_path, qmp_path: life.qmp_path, challenge: life.challenge, timeout_ms: life.timeout_ms, cleanup_complete: true)
