    _x86_32_c_flags, _x86_32_asm_flags, _x86_64_c_flags, _aarch64_c_flags, _arm32_c_flags,
    _riscv64_c_flags, _riscv32_c_flags, _tool_app_contract, _process_vfs_tool_app,
    _native_toolchain_app, _arm_toolchain_apps, _riscv_toolchain_apps, _x86_toolchain_apps,
    _toolchain_lane_markers, _lane_contract
