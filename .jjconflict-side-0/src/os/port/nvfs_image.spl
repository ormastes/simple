# NVFS POSIX root image builder for the current DBFS-backed provider.
#
# This is not a native NVFS storage engine image.  It deliberately records the
# provider boundary in its public names and formats both metadata layers:
#   LBA 0-1  NVFS superblock replicas
#   LBA 2-3  DBFS backing superblock replicas
#   LBA 4+   DBFS arena and persisted namespace

use std.fs_driver.mem_block_device.{MemBlockDevice}
use std.fs_driver.nvfs_superblock.{
    nvfs_superblock_set_device, nvfs_superblock_format_disk
}
use std.db.dbfs_engine.superblock.{
    dbfs_superblock_set_device, dbfs_superblock_format_disk_with_block_count
}
use std.fs_driver.nvfs_posix_driver.{NvfsPosixDriver}
use std.fs_driver.types.{OpenFlags, Path, MountOptions}

pub struct NvfsImageSeed:
    """One file to persist through the NVFS POSIX DBFS-backed provider."""
    name: text
    data: [u8]

pub struct NvfsImageConfig:
    """Configuration for an NVFS POSIX DBFS-backed root image."""
    size_sectors: u64
    seeds: [NvfsImageSeed]

val NVFS_IMAGE_PROVIDER: text = "nvfs-dbfs-backed-v1"
val NVFS_IMAGE_SECTOR_SIZE: u32 = 512u32
val NVFS_IMAGE_FIRST_ARENA_LBA: i64 = 4
val NVFS_IMAGE_MIN_SECTORS: u64 = 8u64
val NVFS_IMAGE_MAX_SECTORS: u64 = 18014398509481983u64
val NVFS_IMAGE_UUID_HI: u64 = 0x53494D504C454653u64
val NVFS_IMAGE_UUID_LO: u64 = 0x4E564653524F4F54u64
val NVFS_IMAGE_DBFS_UUID_HI: u64 = 0x53494D504C454653u64
val NVFS_IMAGE_DBFS_UUID_LO: u64 = 0x444246534241434Bu64

fn _nvfs_image_valid_path(path: text) -> bool:
    if path == "" or not path.starts_with("/"):
        return false
    if path.contains(".."):
        return false
    true

fn _nvfs_image_seed_driver(
    driver: NvfsPosixDriver, seeds: [NvfsImageSeed]
) -> Result<(), text>:
    val mounted = driver.mount(MountOptions.default())
    if mounted.is_err():
        return Err("nvfs image provider mount failed")
    for seed in seeds:
        if not _nvfs_image_valid_path(seed.name):
            return Err("nvfs image seed path must be absolute and non-traversing: " + seed.name)
        val opened = driver.open_path(Path(raw: seed.name), OpenFlags.create_write())
        if opened.is_err():
            return Err("nvfs image seed open failed: " + seed.name)
        val handle = opened.unwrap()
        val wrote = driver.pwrite(handle, 0, seed.data)
        if wrote.is_err() or wrote.unwrap() != seed.data.len() as i64:
            val _ = driver.close_handle(handle)
            return Err("nvfs image seed write failed: " + seed.name)
        val closed = driver.close_handle(handle)
        if closed.is_err():
            return Err("nvfs image seed close failed: " + seed.name)
    Ok(())

pub fn _nvfs_image_mem_device(cfg: NvfsImageConfig) -> Result<MemBlockDevice, text>:
    """Build the current NVFS POSIX DBFS-backed image in memory."""
    if cfg.size_sectors < NVFS_IMAGE_MIN_SECTORS:
        return Err("nvfs image requires at least 8 sectors")
    if cfg.size_sectors > NVFS_IMAGE_MAX_SECTORS:
        return Err("nvfs image sector count exceeds addressable bytes")

    val dev = MemBlockDevice.new(cfg.size_sectors, NVFS_IMAGE_SECTOR_SIZE)
    nvfs_superblock_set_device(dev)
    if not nvfs_superblock_format_disk(NVFS_IMAGE_UUID_HI, NVFS_IMAGE_UUID_LO):
        return Err("nvfs image superblock format failed")

    val arena_blocks = (cfg.size_sectors as i64) - NVFS_IMAGE_FIRST_ARENA_LBA
    dbfs_superblock_set_device(dev)
    if not dbfs_superblock_format_disk_with_block_count(
        NVFS_IMAGE_DBFS_UUID_HI, NVFS_IMAGE_DBFS_UUID_LO, arena_blocks.to_u64()
    ):
        return Err("nvfs image DBFS backing superblock format failed")

    val opened = NvfsPosixDriver.new_on_device(
        NVFS_IMAGE_PROVIDER, dev, NVFS_IMAGE_FIRST_ARENA_LBA, arena_blocks
    )
    if opened.is_err():
        return Err("nvfs image DBFS-backed provider open failed")
    val seeded = _nvfs_image_seed_driver(opened.unwrap(), cfg.seeds)
    if seeded.is_err():
        return seeded
    Ok(dev)

pub fn build_nvfs_rootfs_image(
    cfg: NvfsImageConfig, output_path: text
) -> Result<bool, text>:
    """Write an NVFS POSIX DBFS-backed raw image to output_path."""
    if output_path == "":
        return Err("nvfs image output path is empty")
    val dev_result = _nvfs_image_mem_device(cfg)
    if dev_result.is_err():
        return Err(dev_result.unwrap_err())
    dev_result.unwrap().write_to_file(output_path)
