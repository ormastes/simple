# Board Vulkan — SPIR-V boundary canonicalizer.
#
# Boundary: `vulkan.shader.spirv_binary@1` (soc_profile.board_vulkan_boundary_spirv).
# The relation declared for this boundary in counterpart_plan.spl is byte_exact,
# because SPIR-V has a defined binary encoding. `byte_exact` here is applied to
# the CANONICAL word stream, not the raw bytes two independently-written
# compilers emit — two valid SPIR-V modules with identical runtime semantics
# are allowed to differ in ways the spec explicitly does not attach meaning
# to. Every such allowance is named below and NOTHING ELSE is dropped: an
# opcode or a live operand is never normalized away.
#
# Working representation is `spirv-dis --no-header` disassembly TEXT (one
# instruction per line), because it lets this module diff on tokens instead of
# a bespoke SPIR-V binary reader. The boundary itself stays binary — the
# capture side (boundary_spirv_provider.spl) always assembles through
# `spirv-as` before disassembling back, so the comparison is still over bytes
# a real SPIR-V consumer would load, never over assembly text a human wrote.
#
# Named dropped dimensions (SPEC-HONEST — read before touching):
#
#   1. debug_opcodes          — stripped by an explicit OPCODE ALLOWLIST, never
#      by "is this result id referenced anywhere": OpSource,
#      OpSourceContinued, OpSourceExtension, OpString, OpName, OpMemberName,
#      OpModuleProcessed, OpLine, OpNoLine. SPIR-V 3.32.2 defines these as
#      Debug Instructions: "having no semantic impact ... can be safely
#      removed". A prior version of this module stripped by "unreferenced
#      result id" instead, which silently deleted a live `OpLabel` (a
#      candidate emitting no basic-block label is invalid SPIR-V, not an
#      equivalent one) and a live `OpExtInstImport` — see
#      doc/08_tracking/bug/spirv_boundary_canonicalizer_reachability_filter_dropped_live_instructions_2026-08-10.md.
#      That filter is deleted, not tuned; opcode identity is the only test
#      applied.
#   2. result_id_renumbering  — SPIR-V <id>s are opaque (spec 2.2.1); two
#      compilers assign them independently, so ids are remapped to a canonical
#      sequence by first appearance before comparing.
#   3. assembly_whitespace    — `spirv-dis`'s column-alignment padding is a
#      pretty-printer artifact of the disassembler, not part of the binary
#      encoding; tokens are rejoined with single spaces.
#   4. assembly_comments      — a line whose trimmed text starts with `;` is a
#      SPIR-V TEXT ASSEMBLY comment (the format `spirv_builder.spl`'s
#      `build()` emits directly, e.g. `; SPIR-V`, `; Bound: <n>`). Comments are
#      not instructions and never reach the binary: `spirv-as` drops them
#      during assembly, which is exactly why the fixture-based comparison in
#      `spirv_boundary_glslang_spec.spl` (no `spirv-as` round trip on the
#      committed counterpart side) must strip them itself to compare on equal
#      footing.
#
# Anything that is NOT one of the three above (a different opcode, a missing
# or extra LIVE instruction, a different operand value, a different operand
# order) is a real divergence and must compare unequal. In particular this
# canonicalizer performs NO dead-code / unreferenced-value elimination of any
# kind: if a module carries an instruction whose result nothing else uses
# (glslang's unconditional `gl_WorkGroupSize` builtin composite is exactly
# such a case), the candidate must emit the matching instruction too — the
# comparison does not get to decide an instruction is "safe to ignore" on the
# candidate's behalf. `spirv_boundary_provider.spl` follows this: the fixture
# module deliberately mirrors glslang's builtin-workgroup-size encoding rather
# than relying on this module to paper over its absence.

# === Tokenizing ===

pub fn spirv_line_tokens(line: text) -> [text]:
    var tokens: [text] = []
    for piece in line.trim().split(" "):
        if piece != "":
            tokens.push(piece)
    tokens

pub fn spirv_line_result_id(tokens: [text]) -> text:
    if tokens.len() >= 2 and tokens[1] == "=":
        return tokens[0]
    ""

pub fn spirv_line_opcode(tokens: [text]) -> text:
    if tokens.len() >= 2 and tokens[1] == "=":
        if tokens.len() >= 3:
            return tokens[2]
        return ""
    if tokens.len() >= 1:
        return tokens[0]
    ""

# The ONLY opcodes this canonicalizer ever strips. Every one is a SPIR-V
# Debug Instruction (spec 3.32.2) with no semantic effect on execution.
# Nothing is added to this list based on "nothing references it" — that
# reachability test is exactly the bug this module was rewritten to remove.
pub fn spirv_is_debug_opcode(opcode: text) -> bool:
    (opcode == "OpSource"
        or opcode == "OpSourceContinued"
        or opcode == "OpSourceExtension"
        or opcode == "OpString"
        or opcode == "OpName"
        or opcode == "OpMemberName"
        or opcode == "OpModuleProcessed"
        or opcode == "OpLine"
        or opcode == "OpNoLine")

# === Dimension 4: assembly comments ===

pub fn spirv_is_comment_line(line: text) -> bool:
    line.trim().starts_with(";")

# === Dimension 1: debug opcode allowlist ===

pub fn spirv_drop_debug(lines: [text]) -> [text]:
    var kept: [text] = []
    for line in lines:
        val tokens = spirv_line_tokens(line)
        if tokens.len() == 0:
            continue
        val opcode = spirv_line_opcode(tokens)
        if not spirv_is_debug_opcode(opcode):
            kept.push(line)
    kept

# === Dimension 2 + 3: id renumbering and whitespace normalization ===

pub fn spirv_renumber(lines: [text]) -> [text]:
    var order: [text] = []
    for line in lines:
        for tok in spirv_line_tokens(line):
            if tok.starts_with("%"):
                var seen = false
                for existing in order:
                    if existing == tok:
                        seen = true
                if not seen:
                    order.push(tok)

    var renumbered: [text] = []
    for line in lines:
        var new_tokens: [text] = []
        for tok in spirv_line_tokens(line):
            if tok.starts_with("%"):
                var index = 0
                var found = 0 - 1
                while index < order.len():
                    if order[index] == tok:
                        found = index
                    index = index + 1
                new_tokens.push("%c" + found.to_text())
            else:
                new_tokens.push(tok)
        renumbered.push(new_tokens.join(" "))
    renumbered

# === Entry point ===

pub fn spirv_canonicalize_lines(raw_disassembly: text) -> [text]:
    var lines: [text] = []
    for raw_line in raw_disassembly.split("\n"):
        val trimmed = raw_line.trim()
        if trimmed != "" and not spirv_is_comment_line(trimmed):
            lines.push(trimmed)
    val no_debug = spirv_drop_debug(lines)
    spirv_renumber(no_debug)

pub fn spirv_canonical_text(raw_disassembly: text) -> text:
    spirv_canonicalize_lines(raw_disassembly).join("\n")
