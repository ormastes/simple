# codex-impl
# VirtIO sound protocol contracts for the pure-Simple SimpleOS driver.

val VIRTIO_SND_F_JACK_INFO: u64 = 1u64
val VIRTIO_SND_F_PCM_INFO: u64 = 2u64
val VIRTIO_SND_F_CHMAP_INFO: u64 = 4u64

val VIRTIO_SND_PCM_F_SHMEM_HOST: u64 = 1u64
val VIRTIO_SND_PCM_F_SHMEM_GUEST: u64 = 2u64
val VIRTIO_SND_PCM_F_MSG_POLLING: u64 = 4u64

val VIRTIO_SND_R_PCM_INFO: u32 = 0x0100
val VIRTIO_SND_R_PCM_SET_PARAMS: u32 = 0x0101
val VIRTIO_SND_R_PCM_PREPARE: u32 = 0x0102
val VIRTIO_SND_R_PCM_RELEASE: u32 = 0x0103
val VIRTIO_SND_R_PCM_START: u32 = 0x0104
val VIRTIO_SND_R_PCM_STOP: u32 = 0x0105
val VIRTIO_SND_S_OK: u32 = 0x8000
val VIRTIO_SND_S_BAD_MSG: u32 = 0x8001
val VIRTIO_SND_S_NOT_SUPP: u32 = 0x8002
val VIRTIO_SND_S_IO_ERR: u32 = 0x8003
val VIRTIO_SND_PCM_FMT_S16: u8 = 5u8
val VIRTIO_SND_PCM_RATE_44100: u8 = 6u8
val VIRTIO_SND_PCM_RATE_48000: u8 = 7u8
val VIRTIO_SND_EVT_JACK_CONNECTED: u32 = 0x1000
val VIRTIO_SND_EVT_JACK_DISCONNECTED: u32 = 0x1001
val VIRTIO_SND_EVT_PCM_PERIOD_ELAPSED: u32 = 0x1100
val VIRTIO_SND_EVT_PCM_XRUN: u32 = 0x1101

struct VirtioSndNegotiation:
    status: text
    accepted_features: u64
    playback: bool
    capture: bool
    reason: text

struct VirtioSndPcmRequest:
    stream_id: i64
    direction: text
    sample_rate: i64
    channels: i64
    period_frames: i64
    periods: i64
    buffer_frames: i64

struct VirtioSndPcmValidation:
    status: text
    period_bytes: i64
    buffer_bytes: i64
    reason: text

struct VirtioSndStreamTransition:
    status: text
    next_state: text
    generation: u64
    reason: text

struct VirtioSndCompletion:
    sequence: u64
    stream_id: i64
    generation: u64
    frames: i64
    kind: text
    status: text

struct VirtioSndHardwareEvent:
    status: text
    kind: text
    target_id: i64

fn virtio_snd_pcm_command(code: u32, stream_id: u32) -> [u8]:
    [
        (code & 0xFFu32).to_u8(), ((code >> 8) & 0xFFu32).to_u8(), ((code >> 16) & 0xFFu32).to_u8(), ((code >> 24) & 0xFFu32).to_u8(),
        (stream_id & 0xFFu32).to_u8(), ((stream_id >> 8) & 0xFFu32).to_u8(), ((stream_id >> 16) & 0xFFu32).to_u8(), ((stream_id >> 24) & 0xFFu32).to_u8()
    ]

fn virtio_snd_pcm_info_query(start_id: u32, count: u32) -> [u8]:
    [
        0u8, 1u8, 0u8, 0u8,
        (start_id & 0xFFu32).to_u8(), ((start_id >> 8) & 0xFFu32).to_u8(), ((start_id >> 16) & 0xFFu32).to_u8(), ((start_id >> 24) & 0xFFu32).to_u8(),
        (count & 0xFFu32).to_u8(), ((count >> 8) & 0xFFu32).to_u8(), ((count >> 16) & 0xFFu32).to_u8(), ((count >> 24) & 0xFFu32).to_u8(),
        32u8, 0u8, 0u8, 0u8
    ]

fn virtio_snd_pcm_set_params(values: [u32]) -> [u8]:
    if values.len() != 6: return []
    val stream_id = values[0]
    val buffer_bytes = values[1]
    val period_bytes = values[2]
    val channels = values[3]
    val format = values[4]
    val rate = values[5]
    [
        1u8, 1u8, 0u8, 0u8,
        (stream_id & 0xFFu32).to_u8(), ((stream_id >> 8) & 0xFFu32).to_u8(), ((stream_id >> 16) & 0xFFu32).to_u8(), ((stream_id >> 24) & 0xFFu32).to_u8(),
        (buffer_bytes & 0xFFu32).to_u8(), ((buffer_bytes >> 8) & 0xFFu32).to_u8(), ((buffer_bytes >> 16) & 0xFFu32).to_u8(), ((buffer_bytes >> 24) & 0xFFu32).to_u8(),
        (period_bytes & 0xFFu32).to_u8(), ((period_bytes >> 8) & 0xFFu32).to_u8(), ((period_bytes >> 16) & 0xFFu32).to_u8(), ((period_bytes >> 24) & 0xFFu32).to_u8(),
        0u8, 0u8, 0u8, 0u8, channels.to_u8(), format.to_u8(), rate.to_u8(), 0u8
    ]

fn virtio_snd_status_name(status: u32) -> text:
    if status == VIRTIO_SND_S_OK: return "ok"
    if status == VIRTIO_SND_S_BAD_MSG: return "bad-message"
    if status == VIRTIO_SND_S_NOT_SUPP: return "unsupported"
    if status == VIRTIO_SND_S_IO_ERR: return "io-error"
    "unknown-status"

fn virtio_snd_decode_event(code: u32, data: u32) -> VirtioSndHardwareEvent:
    if code == VIRTIO_SND_EVT_JACK_CONNECTED:
        return VirtioSndHardwareEvent(status: "connected", kind: "audio-jack-connected", target_id: data.to_i64())
    if code == VIRTIO_SND_EVT_JACK_DISCONNECTED:
        return VirtioSndHardwareEvent(status: "disconnected", kind: "audio-jack-disconnected", target_id: data.to_i64())
    if code == VIRTIO_SND_EVT_PCM_PERIOD_ELAPSED:
        return VirtioSndHardwareEvent(status: "completed", kind: "audio-period-elapsed", target_id: data.to_i64())
    if code == VIRTIO_SND_EVT_PCM_XRUN:
        return VirtioSndHardwareEvent(status: "xrun", kind: "audio-xrun", target_id: data.to_i64())
    VirtioSndHardwareEvent(status: "unsupported", kind: "unknown-audio-event", target_id: data.to_i64())

fn virtio_snd_negotiate(device_features: u64, playback_streams: i64, capture_streams: i64) -> VirtioSndNegotiation:
    if playback_streams < 0 or capture_streams < 0:
        return VirtioSndNegotiation(status: "malformed", accepted_features: 0u64, playback: false, capture: false, reason: "negative stream count")
    if playback_streams == 0 and capture_streams == 0:
        return VirtioSndNegotiation(status: "unsupported", accepted_features: 0u64, playback: false, capture: false, reason: "device exposes no PCM streams")
    val accepted = device_features & (VIRTIO_SND_F_JACK_INFO | VIRTIO_SND_F_PCM_INFO | VIRTIO_SND_F_CHMAP_INFO)
    VirtioSndNegotiation(
        status: "accepted",
        accepted_features: accepted,
        playback: playback_streams > 0,
        capture: capture_streams > 0,
        reason: "bounded PCM streams negotiated"
    )

fn virtio_snd_validate_pcm(request: VirtioSndPcmRequest) -> VirtioSndPcmValidation:
    if request.stream_id < 0:
        return VirtioSndPcmValidation(status: "invalid-stream", period_bytes: 0, buffer_bytes: 0, reason: "negative stream id")
    if request.direction != "playback" and request.direction != "capture":
        return VirtioSndPcmValidation(status: "invalid-direction", period_bytes: 0, buffer_bytes: 0, reason: "direction must be playback or capture")
    if request.sample_rate < 8000 or request.sample_rate > 384000:
        return VirtioSndPcmValidation(status: "invalid-format", period_bytes: 0, buffer_bytes: 0, reason: "sample rate outside supported bounds")
    if request.channels < 1 or request.channels > 16:
        return VirtioSndPcmValidation(status: "invalid-format", period_bytes: 0, buffer_bytes: 0, reason: "channel count outside supported bounds")
    if request.period_frames < 16 or request.periods < 2 or request.periods > 64:
        return VirtioSndPcmValidation(status: "invalid-buffer", period_bytes: 0, buffer_bytes: 0, reason: "period geometry outside supported bounds")
    if request.buffer_frames != request.period_frames * request.periods:
        return VirtioSndPcmValidation(status: "invalid-buffer", period_bytes: 0, buffer_bytes: 0, reason: "buffer must contain an exact period count")
    # Canonical guest transport format is interleaved signed 16-bit PCM.
    val period_bytes = request.period_frames * request.channels * 2
    val buffer_bytes = request.buffer_frames * request.channels * 2
    if period_bytes > 1048576 or buffer_bytes > 16777216:
        return VirtioSndPcmValidation(status: "invalid-buffer", period_bytes: 0, buffer_bytes: 0, reason: "bounded DMA size exceeded")
    VirtioSndPcmValidation(status: "accepted", period_bytes: period_bytes, buffer_bytes: buffer_bytes, reason: "PCM geometry accepted")

fn virtio_snd_stream_transition(current: text, action: text, generation: u64) -> VirtioSndStreamTransition:
    if action == "prepare" and current == "closed":
        return VirtioSndStreamTransition(status: "accepted", next_state: "prepared", generation: generation + 1u64, reason: "stream prepared")
    if action == "start" and current == "prepared":
        return VirtioSndStreamTransition(status: "accepted", next_state: "running", generation: generation, reason: "stream running")
    if action == "stop" and current == "running":
        return VirtioSndStreamTransition(status: "accepted", next_state: "prepared", generation: generation, reason: "stream stopped")
    if action == "release" and current == "prepared":
        return VirtioSndStreamTransition(status: "accepted", next_state: "closed", generation: generation + 1u64, reason: "stream released")
    if action == "device-lost" and current != "closed":
        return VirtioSndStreamTransition(status: "disconnected", next_state: "lost", generation: generation + 1u64, reason: "device generation invalidated")
    VirtioSndStreamTransition(status: "invalid-state", next_state: current, generation: generation, reason: "action is not valid in current state")

fn virtio_snd_completion(sequence: u64, stream_id: i64, expected_generation: u64, completion_generation: u64, frames: i64, direction: text) -> VirtioSndCompletion:
    if completion_generation != expected_generation:
        return VirtioSndCompletion(sequence: sequence, stream_id: stream_id, generation: completion_generation, frames: 0, kind: "stale-completion", status: "stale-generation")
    if frames < 0:
        return VirtioSndCompletion(sequence: sequence, stream_id: stream_id, generation: completion_generation, frames: 0, kind: "malformed-completion", status: "malformed")
    val kind = if direction == "capture": "capture-period" else: "playback-period"
    VirtioSndCompletion(sequence: sequence, stream_id: stream_id, generation: completion_generation, frames: frames, kind: kind, status: "completed")

export VIRTIO_SND_R_PCM_INFO, VIRTIO_SND_R_PCM_SET_PARAMS, VIRTIO_SND_R_PCM_PREPARE
export VIRTIO_SND_R_PCM_RELEASE, VIRTIO_SND_R_PCM_START, VIRTIO_SND_R_PCM_STOP
export VIRTIO_SND_S_OK, VIRTIO_SND_PCM_FMT_S16, VIRTIO_SND_PCM_RATE_48000
export VirtioSndNegotiation, VirtioSndPcmRequest, VirtioSndPcmValidation
export VirtioSndStreamTransition, VirtioSndCompletion, VirtioSndHardwareEvent
export virtio_snd_pcm_command, virtio_snd_pcm_info_query, virtio_snd_pcm_set_params
export virtio_snd_status_name, virtio_snd_decode_event, virtio_snd_negotiate
export virtio_snd_validate_pcm, virtio_snd_stream_transition, virtio_snd_completion
