# Fail-closed, backend-neutral GPU measurement admission policy.
#
# Qualification v4 binds the canonical GPU build-admission digest.  This owner
# re-admits that typed value alongside operation and lifecycle evidence.

mod os.crypto.x25519_mlkem768.gpu_measurement_qualification

use lib.common.crypto.x25519_mlkem768.contract.{
    X25519MlKem768Backend, X25519MlKem768SelectionMode,
    X25519MlKem768VerificationPolicy, X25519MlKem768Config,
    X25519MlKem768Evidence}
use lib.common.crypto.x25519_mlkem768.evidence_contract.{
    X25519MlKem768EvidenceBackend}
use lib.common.crypto.x25519_mlkem768.measurement_qualification.{
    X25519MlKem768MeasurementQualification,
    x25519_mlkem768_measurement_qualification_valid}
use os.crypto.x25519_mlkem768.gpu_lifecycle_snapshot.{
    X25519MlKem768GpuLifecycleDelta,
    x25519_mlkem768_gpu_lifecycle_delta_valid}
use os.crypto.x25519_mlkem768.gpu_build_admission.{
    X25519MlKem768GpuBuildAdmission,
    x25519_mlkem768_gpu_build_admission_reason}

fn _gpu_measurement_backend(
        backend: X25519MlKem768EvidenceBackend) -> X25519MlKem768Backend:
    if backend == X25519MlKem768EvidenceBackend.Cuda:
        return X25519MlKem768Backend.Cuda
    if backend == X25519MlKem768EvidenceBackend.Vulkan:
        return X25519MlKem768Backend.Vulkan
    if backend == X25519MlKem768EvidenceBackend.Metal:
        return X25519MlKem768Backend.Metal
    X25519MlKem768Backend.Automatic

fn _gpu_measurement_identity_prefix(
        backend: X25519MlKem768EvidenceBackend) -> text:
    if backend == X25519MlKem768EvidenceBackend.Cuda:
        return "cuda-device:"
    if backend == X25519MlKem768EvidenceBackend.Vulkan:
        return "vulkan-device:"
    if backend == X25519MlKem768EvidenceBackend.Metal:
        return "metal-device:"
    ""

fn x25519_mlkem768_qualified_gpu_measurement_preflight_reason(
        qualification: X25519MlKem768MeasurementQualification,
        config: X25519MlKem768Config,
        build_admission: X25519MlKem768GpuBuildAdmission) -> text:
    if not x25519_mlkem768_measurement_qualification_valid(qualification):
        return "gpu-measurement-qualification-invalid"
    val backend = qualification.target.backend
    val requested_backend = _gpu_measurement_backend(backend)
    if requested_backend == X25519MlKem768Backend.Automatic:
        return "gpu-measurement-qualification-required"
    if (config.requested_backend != requested_backend or
            config.selection_mode != X25519MlKem768SelectionMode.Require or
            config.verification_policy !=
                X25519MlKem768VerificationPolicy.AbsoluteAndScalar):
        return "gpu-measurement-config-policy-mismatch"
    if (config.implementation_version != qualification.implementation_version or
            config.profile_version != qualification.profile_version):
        return "gpu-measurement-config-version-mismatch"
    if (config.batch_size != qualification.batch_size or
            config.batch_size < 1 or config.minimum_batch < 1 or
            config.minimum_batch > config.batch_size):
        return "gpu-measurement-config-batch-mismatch"
    val build_reason = x25519_mlkem768_gpu_build_admission_reason(
        qualification.target, build_admission)
    if build_reason != "": return build_reason
    ""

fn x25519_mlkem768_qualified_gpu_measurement_reason(
        qualification: X25519MlKem768MeasurementQualification,
        config: X25519MlKem768Config,
        build_admission: X25519MlKem768GpuBuildAdmission,
        evidence: X25519MlKem768Evidence,
        lifecycle: X25519MlKem768GpuLifecycleDelta) -> text:
    val preflight_reason =
        x25519_mlkem768_qualified_gpu_measurement_preflight_reason(
            qualification, config, build_admission)
    if preflight_reason != "": return preflight_reason
    val backend = qualification.target.backend
    val requested_backend = _gpu_measurement_backend(backend)
    if (evidence.requested_backend != requested_backend or
            evidence.selected_backend != requested_backend):
        return "gpu-measurement-executed-backend-mismatch"
    if (evidence.implementation_version != qualification.implementation_version or
            evidence.profile_version != qualification.profile_version):
        return "gpu-measurement-evidence-version-mismatch"
    if evidence.batch_size != qualification.batch_size:
        return "gpu-measurement-evidence-batch-mismatch"
    if (evidence.configuration_digest !=
            qualification.target.candidate_configuration_sha256 or
            evidence.artifact_digest !=
                qualification.target.backend_artifact_sha256 or
            evidence.execution_proof_digest !=
                qualification.target.backend_artifact_sha256):
        return "gpu-measurement-execution-binding-mismatch"
    val identity_prefix = _gpu_measurement_identity_prefix(backend)
    if (evidence.executor_identity != qualification.target.executor_identity or
            not evidence.executor_identity.starts_with(identity_prefix)):
        return "gpu-measurement-device-identity-mismatch"
    if (evidence.fallback_used or evidence.fallback_reason != "" or
            not evidence.oracle_match):
        return "gpu-measurement-fallback-or-oracle-mismatch"
    if (not evidence.compiled or not evidence.submitted or
            not evidence.fence_completed or not evidence.device_readback):
        return "gpu-measurement-device-lifecycle-incomplete"
    if not x25519_mlkem768_gpu_lifecycle_delta_valid(lifecycle):
        return "gpu-measurement-lifecycle-delta-invalid"
    if evidence.kernel_invocations != lifecycle.kernel_count:
        return "gpu-measurement-kernel-count-mismatch"
    ""

export x25519_mlkem768_qualified_gpu_measurement_preflight_reason
export x25519_mlkem768_qualified_gpu_measurement_reason
