"""Bounded batch binder for externally signed installed-artifact records.

This provider never signs and never owns a key.  It consumes payload/SCR1
pairs below one no-follow root and returns exact records for the loader's one
catalog bootstrap transaction.
"""

use std.common.contracts.execution.simpleos_executable_v1.{SimpleArtifactManifest}
use std.common.crypto.sha256.{sha256_u8_hex}
use std.common.structural.execution.simple_artifact_manifest_v1_codec.{
    encode_simple_artifact_manifest_v1_signing_bytes
}
use os.installer.hosted_safe_artifact_io_v1.{
    HOSTED_SAFE_ARTIFACT_MAX_BYTES_V1,
    hosted_safe_artifact_root_acquire_v1, hosted_safe_artifact_root_close_v1,
    hosted_safe_artifact_read_once_v1
}
use os.installer.simplebox_signed_catalog_provisioner_v1.{
    SIMPLEBOX_SIGNED_RECORD_MAX_BYTES_V1,
    SimpleboxSafeArtifactBindingReceiptV1,
    simplebox_signed_catalog_record_decode_v1,
    simplebox_signed_catalog_record_encode_v1
}
use os.kernel.loader.installed_artifact_catalog_boot_owner_v1.{
    InstalledArtifactBootRecordV1
}

pub const SIGNED_CATALOG_BUNDLE_MAX_RECORDS_V1: i64 = 16

pub struct SignedCatalogExternalInputV1:
    artifact_relative_path: text
    signed_record_relative_path: text
    manifest_projection: SimpleArtifactManifest

pub struct SignedCatalogBoundBundleV1:
    ok: bool
    reason: text
    records: [InstalledArtifactBootRecordV1]
    receipts: [SimpleboxSafeArtifactBindingReceiptV1]

fn _fail_v1(reason: text) -> SignedCatalogBoundBundleV1:
    SignedCatalogBoundBundleV1(ok: false, reason: reason, records: [], receipts: [])

pub fn signed_catalog_bundle_provision_from_safe_root_v1(
    trusted_absolute_root: text,
    inputs: [SignedCatalogExternalInputV1]
) -> SignedCatalogBoundBundleV1:
    if inputs.len() == 0 or inputs.len() > SIGNED_CATALOG_BUNDLE_MAX_RECORDS_V1:
        return _fail_v1("record-count")
    var input_index: i64 = 0
    while input_index < inputs.len():
        val input = inputs[input_index]
        if input.artifact_relative_path == input.signed_record_relative_path:
            return _fail_v1("path-alias")
        var prior: i64 = 0
        while prior < input_index:
            if inputs[prior].artifact_relative_path == input.artifact_relative_path or
               inputs[prior].signed_record_relative_path == input.signed_record_relative_path or
               inputs[prior].artifact_relative_path == input.signed_record_relative_path or
               inputs[prior].signed_record_relative_path == input.artifact_relative_path:
                return _fail_v1("duplicate-input-path")
            prior = prior + 1
        input_index = input_index + 1
    val authority_result = hosted_safe_artifact_root_acquire_v1(trusted_absolute_root)
    if authority_result.is_err(): return _fail_v1("safe-root-rejected")
    val authority = authority_result.unwrap()
    var records: [InstalledArtifactBootRecordV1] = []
    var receipts: [SimpleboxSafeArtifactBindingReceiptV1] = []
    var failure = ""
    for input in inputs:
        if failure != "": continue
        val artifact = hosted_safe_artifact_read_once_v1(
            authority, input.artifact_relative_path,
            HOSTED_SAFE_ARTIFACT_MAX_BYTES_V1)
        if artifact.is_err():
            failure = "artifact-read"
            continue
        val scr1 = hosted_safe_artifact_read_once_v1(
            authority, input.signed_record_relative_path,
            SIMPLEBOX_SIGNED_RECORD_MAX_BYTES_V1)
        if scr1.is_err():
            failure = "signed-record-read"
            continue
        val candidate = simplebox_signed_catalog_record_decode_v1(
            scr1.unwrap(), input.manifest_projection)
        if not candidate.?:
            failure = "signed-record-decode"
            continue
        val owned = candidate.unwrap()
        val payload = artifact.unwrap()
        val payload_sha256 = sha256_u8_hex(payload)
        val sam1 = encode_simple_artifact_manifest_v1_signing_bytes(
            owned.record.manifest, payload_sha256)
        val canonical = simplebox_signed_catalog_record_encode_v1(owned)
        if payload.len() == 0 or payload_sha256 != owned.record.content_sha256 or
           not sam1.ok or sha256_u8_hex(sam1.bytes) != owned.sam1_identity_sha256 or
           not canonical.? or canonical.unwrap() != scr1.unwrap():
            failure = "artifact-record-binding"
            continue
        records.push(owned.record)
        receipts.push(SimpleboxSafeArtifactBindingReceiptV1(
            artifact_relative_path: input.artifact_relative_path,
            artifact_sha256: payload_sha256,
            artifact_byte_count: payload.len(),
            signed_record_relative_path: input.signed_record_relative_path,
            signed_record_sha256: sha256_u8_hex(scr1.unwrap()),
            sam1_identity_sha256: owned.sam1_identity_sha256))
    val closed = hosted_safe_artifact_root_close_v1(authority)
    if closed.is_err(): return _fail_v1("safe-root-close")
    if failure != "": return _fail_v1(failure)
    SignedCatalogBoundBundleV1(
        ok: true, reason: "", records: records, receipts: receipts)
