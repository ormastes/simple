"""Offline Pure Simple producer for one signed primary-tool release.

The caller supplies five already-hashed, bounded payload/SCR1 observations in
the canonical loader order.  This module has no filesystem, process, or FFI
boundary and does not claim that any payload is staged or ready.
"""

use std.common.contracts.execution.simpleos_executable_v1.{ManifestTarget}
use std.common.crypto.ed25519.{
    pure_ed25519_keypair_from_seed, pure_ed25519_sign_from_seed_v1}
use std.common.crypto.sha256.{sha256_u8_hex}
use os.kernel.loader.executable_manifest_signature_verifier.{
    ExecutableManifestTrustedSignerV1}
use os.kernel.loader.primary_linux_tool_catalog_bundle_v1.{
    PRIMARY_LINUX_TOOL_PAYLOAD_COUNT_V1,
    primary_linux_tool_catalog_required_paths_v1}
use os.kernel.loader.primary_tool_release_descriptor_v1.{
    PRIMARY_TOOL_RELEASE_DESCRIPTOR_DOMAIN_V1,
    PrimaryToolReleaseDescriptorRowV1, PrimaryToolReleaseDescriptorV1,
    primary_tool_release_descriptor_media_lengths_valid_v1,
    primary_tool_release_descriptor_signing_bytes_v1,
    primary_tool_release_descriptor_verify_v1}
use os.kernel.loader.primary_tool_release_descriptor_codec_v1.{
    PRIMARY_TOOL_RELEASE_DESCRIPTOR_MAX_WIRE_BYTES_V1,
    encode_primary_tool_release_descriptor_v1,
    decode_primary_tool_release_descriptor_v1}

pub struct PrimaryToolReleaseMediaObservationV1:
    canonical_path: text
    payload_sha256: text
    payload_length: i64
    scr1_sha256: text
    scr1_length: i64

pub struct PrimaryToolReleaseDescriptorProduceResultV1:
    ok: bool
    reason: text
    descriptor_bytes: [u8]
    public_key: [u8]
    public_key_sha256: text

fn _producer_reject_v1(reason: text) -> PrimaryToolReleaseDescriptorProduceResultV1:
    PrimaryToolReleaseDescriptorProduceResultV1(
        ok: false, reason: reason, descriptor_bytes: [], public_key: [],
        public_key_sha256: "")

fn _bytes_equal_v1(left: [u8], right: [u8]) -> bool:
    if left.len() != right.len(): return false
    var index: i64 = 0
    while index < left.len():
        if left[index] != right[index]: return false
        index = index + 1
    true

pub fn produce_primary_tool_release_descriptor_v1(
    expected_target: ManifestTarget,
    expected_release_id: text,
    expected_signer_key_id: text,
    expected_signer_public_key: [u8],
    observations: [PrimaryToolReleaseMediaObservationV1],
    signing_seed: [u8]
) -> PrimaryToolReleaseDescriptorProduceResultV1:
    """Sign and canonically encode exactly five authoritative observations.

    `expected_signer_key_id` and `expected_signer_public_key` must be supplied
    from the same independently trusted configuration record.
    """
    if observations.len() != PRIMARY_LINUX_TOOL_PAYLOAD_COUNT_V1:
        return _producer_reject_v1("media-row-count-invalid")
    if signing_seed.len() != 32:
        return _producer_reject_v1("signing-key-invalid")
    if expected_signer_public_key.len() != 32:
        return _producer_reject_v1("signer-public-key-invalid")
    val derived_public_key = pure_ed25519_keypair_from_seed(signing_seed).1
    if not _bytes_equal_v1(derived_public_key, expected_signer_public_key):
        return _producer_reject_v1("signer-public-key-mismatch")
    val paths = primary_linux_tool_catalog_required_paths_v1()
    if paths.len() != PRIMARY_LINUX_TOOL_PAYLOAD_COUNT_V1:
        return _producer_reject_v1("catalog-shape-invalid")

    var payload_lengths: [i64] = []
    var scr1_lengths: [i64] = []
    var rows: [PrimaryToolReleaseDescriptorRowV1] = []
    var index: i64 = 0
    while index < PRIMARY_LINUX_TOOL_PAYLOAD_COUNT_V1:
        val observation = observations[index]
        if observation.canonical_path != paths[index]:
            return _producer_reject_v1("path-authority-invalid")
        payload_lengths.push(observation.payload_length)
        scr1_lengths.push(observation.scr1_length)
        rows.push(PrimaryToolReleaseDescriptorRowV1(
            canonical_path: paths[index],
            payload_sha256: observation.payload_sha256,
            scr1_sha256: observation.scr1_sha256))
        index = index + 1
    if not primary_tool_release_descriptor_media_lengths_valid_v1(
        payload_lengths, scr1_lengths):
        return _producer_reject_v1("media-bounds-invalid")

    val unsigned = PrimaryToolReleaseDescriptorV1(
        domain: PRIMARY_TOOL_RELEASE_DESCRIPTOR_DOMAIN_V1,
        target: expected_target, release_id: expected_release_id,
        signer_key_id: expected_signer_key_id, rows: rows, signature: [])
    val signing_result = primary_tool_release_descriptor_signing_bytes_v1(unsigned)
    val signing_bytes = match signing_result:
        case Ok(value): value
        case Err(reason): return _producer_reject_v1(reason)

    # The seed is borrowed. The safe-artifact authority that read it owns
    # compiler-resistant zeroization after this pure signing operation.
    # Producing PTRD bytes proves no staging, measurement, or runtime readiness.
    val signed = pure_ed25519_sign_from_seed_v1(signing_seed, signing_bytes)
    if signed.public_key.len() != 32 or signed.signature.len() != 64:
        return _producer_reject_v1("signing-failed")
    if not _bytes_equal_v1(signed.public_key, expected_signer_public_key):
        return _producer_reject_v1("signer-public-key-mismatch")
    val descriptor = PrimaryToolReleaseDescriptorV1(
        domain: unsigned.domain, target: unsigned.target,
        release_id: unsigned.release_id,
        signer_key_id: unsigned.signer_key_id, rows: unsigned.rows,
        signature: signed.signature)
    val root = ExecutableManifestTrustedSignerV1(
        key_id: expected_signer_key_id, public_key: signed.public_key)
    if not primary_tool_release_descriptor_verify_v1(
        descriptor, [root], expected_target, expected_signer_key_id).ok:
        return _producer_reject_v1("self-verification-failed")
    val encoded = encode_primary_tool_release_descriptor_v1(descriptor)
    if not encoded.ok or
        encoded.bytes.len() > PRIMARY_TOOL_RELEASE_DESCRIPTOR_MAX_WIRE_BYTES_V1:
        return _producer_reject_v1("encoding-failed")
    val decoded = decode_primary_tool_release_descriptor_v1(encoded.bytes)
    if not decoded.ok or not primary_tool_release_descriptor_verify_v1(
        decoded.value, [root], expected_target, expected_signer_key_id).ok:
        return _producer_reject_v1("encoding-consistency-failed")
    val canonical = encode_primary_tool_release_descriptor_v1(decoded.value)
    if not canonical.ok or not _bytes_equal_v1(canonical.bytes, encoded.bytes):
        return _producer_reject_v1("encoding-consistency-failed")

    PrimaryToolReleaseDescriptorProduceResultV1(
        ok: true, reason: "", descriptor_bytes: encoded.bytes,
        public_key: signed.public_key,
        public_key_sha256: sha256_u8_hex(signed.public_key))
