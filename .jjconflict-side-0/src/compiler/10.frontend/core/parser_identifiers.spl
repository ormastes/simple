# Parser identifier compatibility helpers.
#
# Declaration and module-system positions accept contextual keywords as names,
# matching the canonical parser's expect_identifier contract. Expression and
# class-member parsing deliberately remain with their existing owners.

use compiler.core.tokens.{tok_kind_name, keyword_lookup}
use compiler.core.tokens.{TOK_IDENT, TOK_NIL_LIT, TOK_CARET}

fn declaration_identifier_text(kind: i64, token_text: text) -> text:
    if kind == TOK_IDENT:
        return token_text
    if kind == TOK_NIL_LIT:
        return "nil"
    if kind == TOK_CARET and token_text == "xor":
        return "xor"
    val keyword_text = tok_kind_name(kind)
    if keyword_lookup(keyword_text) == kind:
        return keyword_text
    ""

export declaration_identifier_text
