# Opt-in LSH candidate pre-pass for duplicate-check.
#
# Wires the landed fixed-point primitives in `std.common.search`
# (fingerprint.spl MinHash + candidate_bucket.spl LSH banding) into the
# duplicate-check tool WITHOUT changing any default behaviour: nothing here
# runs unless `DuplicationConfig.use_lsh_prefilter` is true (default false,
# settable only via `use-lsh-prefilter` in `simple.duplicate-check.sdn`).
#
# Role: candidate SELECTION only. Surviving pairs are still scored by the
# existing `features.cosine_similarity`, so report shape, ordering and exit
# codes are untouched on both paths.
#
# All arithmetic here is fixed-point i64 (SIMILARITY_SCALE = 1_000_000); no
# f64 is introduced. Tokens are consumed as an already-tokenized `[text]`
# stream, so no byte-vs-char indexing happens in this module.

use std.common.search.fingerprint.{MinHashSignatureV1, shingles_of_tokens, minhash_signature}
use std.common.search.candidate_bucket.{DuplicateCandidatePairV1, bucketed_candidates}

# Banding parameters: 32 hashes = 8 bands x 4 rows. Deterministic and fixed so
# an enabled run is reproducible across processes.
val LSH_NUM_HASHES: i64 = 32
val LSH_BANDS: i64 = 8
val LSH_ROWS: i64 = 4
val LSH_MAX_CANDIDATES_PER_DOC: i64 = 64

struct LshIndexPairV1:
    left: i64
    right: i64
    score: i64

fn sorted_tokens(tokens: [text]) -> [text]:
    """Deterministic token stream: ascending sort. Unigram shingling makes the
    order irrelevant to the resulting shingle set, but sorting keeps signatures
    reproducible run to run."""
    var keys = tokens
    var i = 1
    while i < keys.len():
        val v = keys[i]
        var j = i - 1
        while j >= 0 and keys[j] > v:
            keys[j + 1] = keys[j]
            j = j - 1
        keys[j + 1] = v
        i = i + 1
    keys

fn signature_for_tokens(tokens: [text]) -> MinHashSignatureV1:
    """MinHash signature over unigram (k=1) shingles of a token stream.

    k=1 deliberately: `shingles_of_tokens` joins a k>1 window with an empty
    separator, so multi-token windows can alias across token boundaries."""
    minhash_signature(shingles_of_tokens(tokens, 1), LSH_NUM_HASHES)

fn signatures_for_token_streams(streams: [[text]]) -> [MinHashSignatureV1]:
    var sigs: [MinHashSignatureV1] = []
    var i = 0
    while i < streams.len():
        sigs.push(signature_for_tokens(streams[i]))
        i = i + 1
    sigs

fn lsh_candidate_pairs_for_streams(streams: [[text]]) -> [LshIndexPairV1]:
    """Bounded candidate pairs (document INDEX pairs, left < right) produced by
    LSH banding over MinHash signatures. Never all-pairs."""
    if streams.len() < 2:
        return []
    var doc_ids: [text] = []
    var i = 0
    while i < streams.len():
        doc_ids.push(pad_doc_id(i))
        i = i + 1
    val sigs = signatures_for_token_streams(streams)
    val pairs = bucketed_candidates(doc_ids, sigs, LSH_BANDS, LSH_ROWS, LSH_MAX_CANDIDATES_PER_DOC)
    var out: [LshIndexPairV1] = []
    var p = 0
    while p < pairs.len():
        val left = doc_id_to_index(pairs[p].left_id)
        val right = doc_id_to_index(pairs[p].right_id)
        val lo = if left < right: left else: right
        val hi = if left < right: right else: left
        if lo >= 0 and hi >= 0 and lo != hi:
            out.push(LshIndexPairV1(left: lo, right: hi, score: pairs[p].score))
        p = p + 1
    out

fn pad_doc_id(index: i64) -> text:
    """Zero-padded document id. `bucketed_candidates` orders ids lexically, so
    padding keeps the id ordering consistent with numeric index ordering."""
    var s = "{index}"
    while s.len() < 12:
        s = "0" + s
    "d" + s

fn doc_id_to_index(doc_id: text) -> i64:
    if doc_id.len() < 2:
        return -1
    val digits = doc_id.slice(1, doc_id.len())
    val parsed = digits.to_int()
    if parsed.?:
        return parsed ?? -1
    -1
