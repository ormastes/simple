# Canonical arbitrary-width bit-vector constants for typed HWIR.

pub class HwBitVectorConstant:
    name: text
    bit_width: i32
    canonical_bits: text

    static fn binary(name: text, bit_width: i32,
        canonical_bits: text) -> HwBitVectorConstant:
        HwBitVectorConstant(name: name, bit_width: bit_width,
            canonical_bits: canonical_bits)

    me bits_diagnostic() -> text:
        if self.bit_width < 1 or self.canonical_bits.len() != self.bit_width:
            return "HWIR-E-SEQUENTIAL-DATAPATH-BIT-CONSTANT: bit-vector constants require an exact-width binary value"
        for bit in self.canonical_bits.chars():
            if bit != "0" and bit != "1":
                return "HWIR-E-SEQUENTIAL-DATAPATH-BIT-CONSTANT: bit-vector constants require an exact-width binary value"
        ""
