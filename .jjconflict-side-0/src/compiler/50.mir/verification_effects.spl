# Shared typed effect vocabulary for VerificationIR and MIR effect derivation.

enum VerificationEffectV1:
    Pure
    Read(region: text)
    Write(region: text)
    Allocate(pool: text)
    Free(pool: text)
    IO(device: text)
    Time
    Random
    Spawn
    Suspend
    Atomic(order: text)
    FFI(capability: text)
    MMIO(region: text)
    Unsafe(capability: text)

impl VerificationEffectV1:
    fn canonical_text() -> text:
        match self:
            case Pure: "pure"
            case Read(region): "read:" + region
            case Write(region): "write:" + region
            case Allocate(pool): "allocate:" + pool
            case Free(pool): "free:" + pool
            case IO(device): "io:" + device
            case Time: "time"
            case Random: "random"
            case Spawn: "spawn"
            case Suspend: "suspend"
            case Atomic(order): "atomic:" + order
            case FFI(capability): "ffi:" + capability
            case MMIO(region): "mmio:" + region
            case Unsafe(capability): "unsafe:" + capability

    fn diagnostic() -> text:
        match self:
            case Read(region) | Write(region) | MMIO(region):
                if region == "": "VIR-E-EFFECT-REGION: effect region is required" else: ""
            case Allocate(pool) | Free(pool):
                if pool == "": "VIR-E-EFFECT-POOL: allocation pool is required" else: ""
            case IO(device):
                if device == "": "VIR-E-EFFECT-DEVICE: I/O device identity is required" else: ""
            case Atomic(order):
                if order == "": "VIR-E-EFFECT-ORDER: atomic memory order is required" else: ""
            case FFI(capability) | Unsafe(capability):
                if capability == "": "VIR-E-EFFECT-CAPABILITY: boundary capability is required" else: ""
            case Pure | Time | Random | Spawn | Suspend: ""
