# codex-impl: ABI-safe versioned codegen backend plugin metadata.
# No foreign pointer, library handle, trait object, or heap graph crosses this
# common-layer contract.

val BACKEND_PLUGIN_ABI_VERSION_V1: i64 = 1
val BACKEND_PLUGIN_DESCRIPTOR_MIN_SIZE_V1: i64 = 9

enum BackendRole:
    InterpreterJit
    CompilerAot

impl BackendRole:
    fn name() -> text:
        match self:
            case InterpreterJit: "interpreter_jit"
            case CompilerAot: "compiler_aot"

enum BackendCapability:
    JitExecute
    ObjectEmit
    DebugInfo
    Optimization
    CrossTarget
    IncrementalCompilation

impl BackendCapability:
    fn name() -> text:
        match self:
            case JitExecute: "jit_execute"
            case ObjectEmit: "object_emit"
            case DebugInfo: "debug_info"
            case Optimization: "optimization"
            case CrossTarget: "cross_target"
            case IncrementalCompilation: "incremental_compilation"

# Operation presence only. The later SFFI owner retains actual callable slots.
struct BackendPluginVTableV1:
    supports_open_session: bool
    supports_compile_module: bool
    supports_finalize_object: bool
    supports_execute: bool
    supports_diagnostics: bool
    supports_close_session: bool
    supports_release_buffer: bool

fn backend_plugin_vtable_v1_all_operations() -> BackendPluginVTableV1:
    BackendPluginVTableV1(true, true, true, true, true, true, true)

struct BackendPluginRequestV1:
    role: BackendRole
    backend_name: text
    target: text
    cpu: text
    features: [text]
    optimization: text
    mir_abi_digest: text
    required_capabilities: [BackendCapability]
    plugin_path: text
    has_plugin_path: bool

struct BackendPluginDescriptorV1:
    abi_version: i64
    descriptor_size: i64
    provider_identity: text
    provider_version: text
    build_id: text
    mir_abi_digest: text
    roles: [BackendRole]
    targets: [text]
    capabilities: [BackendCapability]
    vtable: BackendPluginVTableV1

fn backend_plugin_supports_role(descriptor: BackendPluginDescriptorV1, role: BackendRole) -> bool:
    for supported in descriptor.roles:
        if supported == role: return true
    false

fn backend_plugin_supports_target(descriptor: BackendPluginDescriptorV1, target: text) -> bool:
    for supported in descriptor.targets:
        if supported == target: return true
    false

fn backend_plugin_has_capability(descriptor: BackendPluginDescriptorV1, required: BackendCapability) -> bool:
    for capability in descriptor.capabilities:
        if capability == required: return true
    false

export BACKEND_PLUGIN_ABI_VERSION_V1, BACKEND_PLUGIN_DESCRIPTOR_MIN_SIZE_V1,
    BackendRole, BackendCapability, BackendPluginVTableV1,
    BackendPluginRequestV1, BackendPluginDescriptorV1,
    backend_plugin_vtable_v1_all_operations, backend_plugin_supports_role,
    backend_plugin_supports_target, backend_plugin_has_capability
