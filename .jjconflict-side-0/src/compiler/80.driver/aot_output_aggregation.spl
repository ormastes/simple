# Linear text aggregation helpers shared by single-file AOT backends.

pub fn aot_join_text_fragments(fragments: [text]) -> text:
    """Join backend output fragments once, avoiding repeated prefix copies."""
    fragments.join("")

pub fn aot_join_wat_fragments(fragments: [text]) -> text:
    """Join non-empty WAT modules with the historical two-newline separator."""
    var nonempty: [text] = []
    for fragment in fragments:
        if fragment != "":
            nonempty.push(fragment)
    nonempty.join("\n\n")
