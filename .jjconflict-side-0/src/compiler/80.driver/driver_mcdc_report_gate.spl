# codex-impl
# Typed driver boundary between runtime MC/DC evidence and final admission.

use compiler.common.assurance.policy_schema.{AssuranceStrictness}
use compiler.common.mcdc_coverage_gate.{
    McdcConditionResult, McdcCoverageGateReport, enforce_mcdc_exact_coverage
}
use std.common.mcdc.model.{McdcExclusion}
use std.common.convert.{try_parse_int}

pub struct McdcRuntimeCoverageEvidence:
    conditions: [McdcConditionResult]
    exclusions: [McdcExclusion]
    recorder_saturated: bool
    dropped_count: i64 = 0
    overwritten_count: i64 = 0

pub struct McdcReportCompletion:
    requested: bool
    accepted: bool
    machine_diagnostic: text
    human_diagnostic: text
    report: McdcCoverageGateReport?

pub fn driver_parse_mcdc_runtime_evidence_v1(source: text) -> McdcRuntimeCoverageEvidence?:
    """Decode the bounded line artifact produced after an instrumented run.

    The transport deliberately accepts no free-form SDN and no filesystem
    access. Callers inject the already bounded artifact through CompileContext;
    every row is single-pass and malformed input fails closed.
    """
    if source.len() > 67108864: return nil
    val lines = source.split("\n")
    if lines.len() == 0 or lines[0].trim() != "MCDC-EVIDENCE-v1": return nil
    if lines.len() > 1000001: return nil
    var conditions: [McdcConditionResult] = []
    var exclusions: [McdcExclusion] = []
    var saturated = false
    var dropped_count = 0
    var overwritten_count = 0
    var saw_counters = false
    var index = 1
    while index < lines.len():
        val line = lines[index].trim()
        if line != "":
            if line.len() > 4096: return nil
            val fields = line.split("|")
            if fields.len() == 2 and fields[0] == "saturated":
                if fields[1] == "true": saturated = true
                elif fields[1] == "false": saturated = false
                else: return nil
            elif fields.len() == 3 and fields[0] == "counters":
                if saw_counters: return nil
                val dropped = try_parse_int(fields[1])
                val overwritten = try_parse_int(fields[2])
                if dropped == nil or overwritten == nil or dropped.unwrap() < 0 or overwritten.unwrap() < 0:
                    return nil
                dropped_count = dropped.unwrap()
                overwritten_count = overwritten.unwrap()
                saw_counters = true
            elif (fields.len() == 5 or fields.len() == 7) and fields[0] == "condition":
                val ordinal = try_parse_int(fields[3])
                if ordinal == nil: return nil
                if fields[4] != "true" and fields[4] != "false": return nil
                conditions.push(McdcConditionResult(
                    semantic_id: fields[1], identity_version: fields[2],
                    condition_ordinal: ordinal.unwrap(), covered: fields[4] == "true",
                    classification: if fields.len() == 7: fields[5] else: "",
                    applied_policy: if fields.len() == 7: fields[6] else: ""
                ))
            elif fields.len() == 7 and fields[0] == "exclusion":
                val ordinal = try_parse_int(fields[2])
                if ordinal == nil: return nil
                exclusions.push(McdcExclusion(
                    semantic_id: fields[1], condition_ordinal: ordinal.unwrap(),
                    whole_decision: false, reason: fields[3], reviewer: fields[4],
                    review_id: fields[5], expires_or_version: fields[6]
                ))
            else:
                return nil
        index = index + 1
    Some(McdcRuntimeCoverageEvidence(
        conditions: conditions, exclusions: exclusions,
        recorder_saturated: saturated,
        dropped_count: dropped_count, overwritten_count: overwritten_count
    ))

pub fn driver_complete_mcdc_report(
    mode_text: text,
    profile: AssuranceStrictness,
    evidence: McdcRuntimeCoverageEvidence?
) -> McdcReportCompletion:
    if mode_text == "off":
        return McdcReportCompletion(
            requested: false,
            accepted: true,
            machine_diagnostic: "",
            human_diagnostic: "",
            report: nil
        )

    if mode_text != "on" and mode_text != "dynamic":
        return McdcReportCompletion(
            requested: true,
            accepted: false,
            machine_diagnostic: "MCDC-E-MODE|unknown-mode",
            human_diagnostic: "MCDC-E-MODE: unknown MC/DC mode at report completion",
            report: nil
        )

    if val runtime_evidence = evidence:
        if runtime_evidence.conditions.len() == 0:
            return McdcReportCompletion(
                requested: true, accepted: false,
                machine_diagnostic: "MCDC-E-EVIDENCE-EMPTY|mode={mode_text}",
                human_diagnostic: "MCDC-E-EVIDENCE-EMPTY: MC/DC evidence contains no condition rows",
                report: nil
            )
        val report = enforce_mcdc_exact_coverage(
            profile,
            runtime_evidence.conditions,
            runtime_evidence.exclusions,
            runtime_evidence.recorder_saturated,
            runtime_evidence.dropped_count,
            runtime_evidence.overwritten_count
        )
        return McdcReportCompletion(
            requested: true,
            accepted: report.accepted,
            machine_diagnostic: report.machine_report(),
            human_diagnostic: report.human_report(),
            report: Some(report)
        )

    # A compiler inventory contains identities and zero counters, not runtime
    # independence evidence. Treating it as a completed report would create a
    # false PASS. The transport therefore fails closed until the runtime/test
    # owner supplies a typed evidence envelope.
    McdcReportCompletion(
        requested: true,
        accepted: false,
        machine_diagnostic: "MCDC-E-EVIDENCE-MISSING|mode={mode_text}",
        human_diagnostic: "MCDC-E-EVIDENCE-MISSING: MC/DC {mode_text} report " +
            "completion requires typed runtime independence evidence",
        report: nil
    )
