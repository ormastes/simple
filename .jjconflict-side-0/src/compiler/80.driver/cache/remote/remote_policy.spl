# Remote read/write policy matrix — design §15.4.
#
# Encodes the producer-class × {read main, write branch, write main} table as
# DATA, not scattered booleans, so the whole matrix is inspectable and each
# cell is independently testable.
#
# NON-NEGOTIABLE (contract): "Developer machines: write-main is ALWAYS false,
# unconditionally, with no flag or env var that can flip it." This module has
# no field, parameter, or env-var read that can produce `write_main: true`
# for `DirtyDeveloperWorktree` or `CleanDeveloperBranch`. See
# `remote_write_main_allowed` — it is a pure function of `ProducerClass`
# only, and the table literal below is the single source of truth.
#
# First-milestone scope: this table is consulted by callers to decide
# whether an operation is permitted; this agent's code never performs a
# remote-main WRITE itself (remote_client.spl below is read-only).

enum ProducerClass:
    DirtyDeveloperWorktree
    CleanDeveloperBranch
    UntrustedPullRequestOrFork
    TrustedBranchCi
    TrustedMainCi
    ReleaseCi

fn producer_class_text(p: ProducerClass) -> text:
    match p:
        case ProducerClass.DirtyDeveloperWorktree: "dirty_developer_worktree"
        case ProducerClass.CleanDeveloperBranch: "clean_developer_branch"
        case ProducerClass.UntrustedPullRequestOrFork: "untrusted_pull_request_or_fork"
        case ProducerClass.TrustedBranchCi: "trusted_branch_ci"
        case ProducerClass.TrustedMainCi: "trusted_main_ci"
        case ProducerClass.ReleaseCi: "release_ci"

# One row of the §15.4 table.
struct RemotePolicyRow:
    producer: ProducerClass
    read_main: bool
    write_branch: bool
    write_main: bool

# The complete, frozen §15.4 matrix. Order and values mirror the design table
# verbatim. This is the ONLY place `write_main: true` may appear in source,
# and it appears only for the two CI-controlled rows the design allows.
val REMOTE_POLICY_TABLE: [RemotePolicyRow] = [
    RemotePolicyRow(producer: ProducerClass.DirtyDeveloperWorktree, read_main: true, write_branch: false, write_main: false),
    RemotePolicyRow(producer: ProducerClass.CleanDeveloperBranch, read_main: true, write_branch: false, write_main: false),
    RemotePolicyRow(producer: ProducerClass.UntrustedPullRequestOrFork, read_main: true, write_branch: false, write_main: false),
    RemotePolicyRow(producer: ProducerClass.TrustedBranchCi, read_main: true, write_branch: true, write_main: false),
    RemotePolicyRow(producer: ProducerClass.TrustedMainCi, read_main: true, write_branch: false, write_main: true),
    RemotePolicyRow(producer: ProducerClass.ReleaseCi, read_main: true, write_branch: false, write_main: true)
]

fn remote_policy_row_for(p: ProducerClass) -> RemotePolicyRow:
    for row in REMOTE_POLICY_TABLE:
        if row.producer == p:
            return row
    # Unreachable for any enum value listed above; fail closed rather than
    # granting anything by default.
    RemotePolicyRow(producer: p, read_main: false, write_branch: false, write_main: false)

fn remote_read_main_allowed(p: ProducerClass) -> bool:
    remote_policy_row_for(p).read_main

fn remote_write_branch_allowed(p: ProducerClass) -> bool:
    remote_policy_row_for(p).write_branch

# The invariant this function exists to guarantee: for the two developer
# producer classes this ALWAYS returns false. There is no parameter, flag,
# or environment lookup anywhere in this function that can change that for
# those two classes — the only inputs are the literal table above.
fn remote_write_main_allowed(p: ProducerClass) -> bool:
    remote_policy_row_for(p).write_main

# Explicit unconditional guard for the developer-machine invariant, kept as
# its own named predicate (rather than only inline in the table) so a
# regression that edits the table cannot silently loosen it without also
# failing this check.
fn developer_machine_write_main_is_always_false(p: ProducerClass) -> bool:
    val is_developer_class = (p == ProducerClass.DirtyDeveloperWorktree) or (p == ProducerClass.CleanDeveloperBranch)
    if not is_developer_class:
        return true
    not remote_write_main_allowed(p)

export ProducerClass, RemotePolicyRow, REMOTE_POLICY_TABLE
export producer_class_text, remote_policy_row_for
export remote_read_main_allowed, remote_write_branch_allowed, remote_write_main_allowed
export developer_machine_write_main_is_always_false
