# AopGroupManifest + Merkle-partitioned candidate index (design §16.3).
#
# Partitioning today: (component/module_path, join_point_kind tag) — the two
# axes that actually exist on JoinPointContext/JoinPointKind. MDSOC scope and
# entity-id-range levels of the §16.3 tree are SPEC-FORWARD (join points carry
# no scope, and entity ids are transient BlockIds — plan §2b); scope is fixed
# at "global" and each partition holds its leaves directly.
#
# Property delivered: one changed/added candidate changes only its own leaf,
# its partition root, and the top candidate root — sibling partition roots are
# byte-identical.

use std.common.crypto.sha256.{sha256_text}
use compiler.driver.cache.action_key.{canon_str, canon_field, canon_seq, action_key_sort_texts}
use compiler.mdsoc.weaving.join_point.{JoinPointContext}
use compiler.mdsoc.aop_cache.aop_group_keys.{AopCandidatePartitionKey, aop_candidate_partition_key_digest, aop_descriptor_digest, aop_empty_seq_sentinel, AOP_DESCRIPTOR_SCHEMA_VERSION}

# One candidate leaf. entity_id is the stable name pair (module_path +
# function_name) — NEVER a BlockId (transient, LOCAL_STATE per c0 freeze).
struct AopCandidateLeaf:
    entity_id: text
    descriptor_digest: text

struct AopCandidatePartition:
    key: AopCandidatePartitionKey
    key_digest: text
    leaves: [AopCandidateLeaf]
    root: text

struct AopGroupManifest:
    group_id: text
    owner_scope: text
    generation: text
    candidate_partitions: [AopCandidatePartition]
    candidate_partition_roots: [text]     # sorted set of partition roots
    selection_shards: [text]
    weave_artifacts: [text]               # SPEC-FORWARD: no weave artifact producer yet
    implementation_artifacts: [text]
    aspect_pack_artifacts: [text]         # SPEC-FORWARD: no aspect packs yet
    schema_version: i64

fn aop_candidate_entity_id(ctx: JoinPointContext) -> text:
    ctx.module_path + "::" + ctx.function_name

# Merkle root of one partition: sorted leaf encodings (leaf set semantics).
fn aop_partition_root(key_digest: text, leaves: [AopCandidateLeaf]) -> text:
    var leaf_texts: [text] = []
    for l in leaves:
        var fields: [text] = []
        fields.push(canon_field("entityId", canon_str(l.entity_id)))
        fields.push(canon_field("descriptorDigest", canon_str(l.descriptor_digest)))
        leaf_texts.push(canon_seq(fields))
    var items: [text] = []
    for t in action_key_sort_texts(leaf_texts):
        items.push(t)
    var inner: [text] = []
    inner.push(canon_field("partitionKey", canon_str(key_digest)))
    inner.push(canon_field("leaves", canon_seq(items)))
    sha256_text(canon_field("simple/aop-candidate-partition/v1", canon_seq(inner)))

fn aop_partition_key_for(module_path: text, kind_tag: text) -> AopCandidatePartitionKey:
    AopCandidatePartitionKey(
        component: module_path,
        scope: "global",
        join_point_kind: kind_tag,
        target_profile: aop_empty_seq_sentinel(),
        descriptor_schema: AOP_DESCRIPTOR_SCHEMA_VERSION)

# Partition a candidate set by (module_path, kind_tag). kinds[i] is the kind
# tag of contexts[i] (kind lives on JoinPoint, not JoinPointContext).
fn aop_partition_candidates(contexts: [JoinPointContext], kinds: [text]) -> [AopCandidatePartition]:
    # Collect distinct (component, kind) buckets, order-stable then sorted.
    var bucket_ids: [text] = []
    var i = 0
    while i < contexts.len():
        val bid = canon_str(contexts[i].module_path) + canon_str(kinds[i])
        var seen = false
        for b in bucket_ids:
            if b == bid:
                seen = true
        if not seen:
            bucket_ids.push(bid)
        i = i + 1
    var out: [AopCandidatePartition] = []
    for bid in action_key_sort_texts(bucket_ids):
        var leaves: [AopCandidateLeaf] = []
        var comp = ""
        var kind_tag = ""
        var j = 0
        while j < contexts.len():
            val cur = canon_str(contexts[j].module_path) + canon_str(kinds[j])
            if cur == bid:
                comp = contexts[j].module_path
                kind_tag = kinds[j]
                leaves.push(AopCandidateLeaf(
                    entity_id: aop_candidate_entity_id(contexts[j]),
                    descriptor_digest: aop_descriptor_digest(contexts[j])))
            j = j + 1
        val key = aop_partition_key_for(comp, kind_tag)
        val kd = aop_candidate_partition_key_digest(key)
        out.push(AopCandidatePartition(
            key: key, key_digest: kd, leaves: leaves,
            root: aop_partition_root(kd, leaves)))
    out

fn aop_partition_roots(partitions: [AopCandidatePartition]) -> [text]:
    var roots: [text] = []
    for p in partitions:
        roots.push(p.root)
    action_key_sort_texts(roots)

# Top-level roots for the frozen key fields 16–18.
fn aop_surface_root(surface_digests: [text]) -> text:
    var items: [text] = []
    for d in action_key_sort_texts(surface_digests):
        items.push(canon_str(d))
    sha256_text(canon_field("simple/aop-surface-root/v1", canon_seq(items)))

fn aop_weave_root(weave_key_digests: [text]) -> text:
    # SPEC-FORWARD: no per-target weave artifact exists (weaving mutates MIR
    # in place — plan §2b). Callers today pass [] and get the sentinel value.
    var items: [text] = []
    for d in action_key_sort_texts(weave_key_digests):
        items.push(canon_str(d))
    sha256_text(canon_field("simple/aop-weave-root/v1", canon_seq(items)))

fn aop_group_manifest_new(owner_scope: text, partitions: [AopCandidatePartition], selection_shards: [text], implementation_artifacts: [text]) -> AopGroupManifest:
    val roots = aop_partition_roots(partitions)
    var root_items: [text] = []
    for r in roots:
        root_items.push(canon_str(r))
    var shard_items: [text] = []
    for s in action_key_sort_texts(selection_shards):
        shard_items.push(canon_str(s))
    var impl_items: [text] = []
    for a in action_key_sort_texts(implementation_artifacts):
        impl_items.push(canon_str(a))
    var inner: [text] = []
    inner.push(canon_field("ownerScope", canon_str(owner_scope)))
    inner.push(canon_field("candidatePartitionRoots", canon_seq(root_items)))
    inner.push(canon_field("selectionShards", canon_seq(shard_items)))
    inner.push(canon_field("implementationArtifacts", canon_seq(impl_items)))
    val gen = sha256_text(canon_field("simple/aop-group-generation/v1", canon_seq(inner)))
    AopGroupManifest(
        group_id: sha256_text(canon_field("simple/aop-group-id/v1", canon_str(owner_scope))),
        owner_scope: owner_scope,
        generation: gen,
        candidate_partitions: partitions,
        candidate_partition_roots: roots,
        selection_shards: selection_shards,
        weave_artifacts: [],
        implementation_artifacts: implementation_artifacts,
        aspect_pack_artifacts: [],
        schema_version: 2)
