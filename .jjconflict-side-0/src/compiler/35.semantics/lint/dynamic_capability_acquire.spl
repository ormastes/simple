# Dynamic Capability Acquisition Lint
#
# dynamic_capability_acquire: flags capability-group acquisition that happens
# at an arbitrary point in the program instead of during the boot / composition
# phase. In mission-critical builds the set of capabilities a process holds must
# be decided once, at init, from a pinned manifest — not discovered lazily in the
# middle of a control loop where a failed acquisition has nowhere to go.
#
# DCA001: capability acquisition outside an `@init_phase` fn                       warn|error
# DCA002: critical mode with an unpinned `gpu.backend` (e.g. `auto`)               ERROR
#
# ## What "acquisition" means here — read before extending the rule
#
# A capability group is ONE trait over ONE value: the literal union of its
# member methods, which is exactly what P0's `trait G with A, B:` sugar
# desugars to. It is acquired through a SINGLE accessor returning `Option<G>`.
#
# It is emphatically NOT a struct pairing two per-member accessors. That shape
# (design 3 as originally written) is unsound in this language: classes are
# VALUE types, so `session.debug()` and `session.profile()` hand back two
# independent copies and driving one leaves the other behind. It was measured
# RED before being corrected; see
# doc/08_tracking/bug/capability_group_from_unsound_under_value_semantics_2026-08-09.md
# This lint therefore does NOT look for accessor pairing. Pairing is a
# correctness defect owned by that report, not a critical-mode policy question,
# and linting for it here would imply the shape is merely discouraged.
#
# The single-value acquisition calls recognised today:
#
#     val g = G__from(src)             # the static P0's desugar generates
#     val g = G.from(src)              # the same static, spelled on the group
#     val g = ref_debug_profiler(s)    # per-backend interim helper (P2)
#
# The third form is `<backend>_debug_profiler(session) -> Option<DebugProfiler>`,
# which each backend supplies until P0's generator emits the single-accessor
# `.from()`. It is matched on its `_debug_profiler` suffix and is flagged
# regardless of the `group_names` list, because it is an acquisition by
# construction rather than by naming convention.
#
# ## Severity is configuration, not a constant
#
# The user requirement is "a warning now, promotable to an error later", so the
# severity of DCA001 is supplied by the caller from
# `critical.dynamic_acquire` (config/critical_mode.sdn):
#
#   allow  -> no diagnostics at all (default outside critical mode)
#   warn   -> WARNING; the build still succeeds (critical mode's default today)
#   error  -> ERROR; the build fails (critical mode's target state)
#
# There is deliberately no hard-coded default inside the check function: the
# mode always comes from config so that promoting warn -> error is a one-line
# config change and needs no code edit.
#
# ## Marking rules for `@init_phase` (exact, as shipped)
#
# 1. A function is init-phase when the attribute line `@init_phase` (or the
#    bracket spelling `#[init_phase]`) appears immediately above its
#    declaration, with only other attribute lines or blank lines in between.
# 2. A whole file is init-phase when `@init_phase` appears as a bare line in the
#    first 30 lines of the file, before any declaration. This is the composition
#    root escape hatch: a module that exists only to wire the system up does not
#    have to annotate every function in it.
# 3. Everything else is not init-phase. In particular the attribute does NOT
#    propagate into nested functions or into callees — the lint is syntactic and
#    says so rather than pretending to do reachability.
#
# ## Scope and known limits
#
# This is a text-heuristic check (no AST dependency), so it runs in
# interpreter-mode specs the same way `raw_rt_access` and
# `concurrency_api_misuse` do. Consequences, stated plainly:
#
# - Design 4 also mentions `Option<Trait>`-returning accessor calls. Those are
#   NOT detected here: identifying them needs return-type information this pass
#   does not have. Only the acquisition call is covered.
# - Occurrences inside `#` comments are skipped. Occurrences inside string
#   literals are NOT skipped.

# ============================================================================
# Finding Struct
# ============================================================================

pub struct DynCapAcquireFinding:
    code: text
    severity: text
    message: text
    name: text
    note: text
    line_num: i64

    fn fmt() -> text:
        "[{self.code}] {self.severity}: {self.message} — {self.note}"

# ============================================================================
# Mode handling
# ============================================================================

pub fn dca_mode_is_valid(mode: text) -> bool:
    """True for the three configured values of `critical.dynamic_acquire`."""
    mode == "allow" or mode == "warn" or mode == "error"

fn _dca_severity_for(mode: text) -> text:
    """Map the configured mode onto the diagnostic severity string.

    `allow` never reaches here (the check returns early). An unrecognised mode
    is treated as `warn`: a typo in config must not silently disable the lint,
    which is what falling back to `allow` would do."""
    if mode == "error":
        return "ERROR"
    "WARNING"

# ============================================================================
# Identifier helpers
# ============================================================================

fn _dca_is_ident_char(ch: text) -> bool:
    """True for identifier characters (alnum or underscore)."""
    if ch == "_":
        return true
    val is_lower = ch >= "a" and ch <= "z"
    val is_upper = ch >= "A" and ch <= "Z"
    val is_digit = ch >= "0" and ch <= "9"
    is_lower or is_upper or is_digit

fn _dca_starts_upper(name: text) -> bool:
    """True when `name` begins with an ASCII uppercase letter.

    Group traits are type names, so an uppercase first letter is what
    distinguishes `G.from(x)` from value-level helpers like `bytes.from(x)`."""
    if name.len() == 0:
        return false
    val c = name.substring(0, 1)
    c >= "A" and c <= "Z"

fn _dca_ident_ending_at(line: text, end_index: i64) -> text:
    """Read the identifier that ends just before `end_index`, scanning left.

    Returns "" when the character immediately left of `end_index` is not an
    identifier character. Used to recover the `G` in `G.from(` and `G__from(`."""
    var start = end_index
    while start > 0:
        val ch = line.substring(start - 1, start)
        if not _dca_is_ident_char(ch):
            break
        start = start - 1
    if start == end_index:
        return ""
    line.substring(start, end_index)

fn _dca_strip_comment(line: text) -> text:
    """Drop a trailing `#` comment so commented-out calls are not flagged.

    Naive on purpose: a `#` inside a string literal truncates the line early.
    That direction is safe (it can only hide a finding on a line that also has a
    `#` in a literal), and is documented in the file header."""
    val idx = line.index_of("#")
    if idx < 0:
        return line
    line.substring(0, idx)

# ============================================================================
# @init_phase recognition
# ============================================================================

pub fn dca_is_init_phase_attribute(trimmed: text) -> bool:
    """True when `trimmed` is an `@init_phase` attribute line (either spelling)."""
    if trimmed == "@init_phase" or trimmed.starts_with("@init_phase "):
        return true
    trimmed == "#[init_phase]"

fn _dca_is_attribute_line(trimmed: text) -> bool:
    """True for any attribute line, so attributes may be stacked above a fn."""
    if trimmed.starts_with("@"):
        return true
    trimmed.starts_with("#[")

pub fn dca_file_is_init_phase_lines(lines: [text]) -> bool:
    """Rule 2: a bare `@init_phase` in the first 30 lines marks the whole file.

    The scan stops at the first declaration so that an `@init_phase` sitting on
    top of the file's first function is read as marking that function (rule 1),
    not the entire module."""
    var i = 0
    while i < lines.len() and i < 30:
        val t = lines[i].trim()
        if dca_is_init_phase_attribute(t):
            # Look ahead: if a declaration follows (after further attribute or
            # blank lines), this attribute belongs to that declaration.
            var j = i + 1
            while j < lines.len():
                val nt = lines[j].trim()
                if nt == "" or _dca_is_attribute_line(nt):
                    j = j + 1
                    continue
                break
            if j < lines.len():
                val nt2 = lines[j].trim()
                if _dca_is_fn_decl(nt2):
                    return false
            return true
        if _dca_is_fn_decl(t):
            return false
        i = i + 1
    false

pub fn dca_file_is_init_phase(source: text) -> bool:
    """Compatibility adapter for callers that own only source text."""
    dca_file_is_init_phase_lines(source.split("\n"))

fn _dca_is_fn_decl(trimmed: text) -> bool:
    """True for a function declaration line in any of its spellings."""
    if trimmed.starts_with("fn "):
        return true
    if trimmed.starts_with("pub fn "):
        return true
    if trimmed.starts_with("me "):
        return true
    if trimmed.starts_with("pub me "):
        return true
    trimmed.starts_with("async fn ")

# ============================================================================
# Group-name matching
# ============================================================================

fn _dca_name_is_group(name: text, group_names: [text]) -> bool:
    """Decide whether `name` names a capability group.

    With an explicit `group_names` list (the precise mode — pass the groups the
    build actually declares) only those names match. With an empty list the
    lint falls back to the shape heuristic: any uppercase-initial receiver. The
    fallback is what makes the lint useful before a group index exists, and it
    is why the header documents `Text.from(...)`-style false positives as
    possible in that mode."""
    if not _dca_starts_upper(name):
        return false
    if group_names.len() == 0:
        return true
    var i = 0
    while i < group_names.len():
        if group_names[i] == name:
            return true
        i = i + 1
    false

# ============================================================================
# Main Entry Point
# ============================================================================

pub fn check_dynamic_capability_acquire_lines(
    lines: [text],
    file_path: text,
    group_names: [text],
    mode: text
) -> [DynCapAcquireFinding]:
    """DCA001: capability-group acquisition outside an `@init_phase` function.

    `mode` comes from `critical.dynamic_acquire` and decides both whether the
    lint reports at all (`allow` reports nothing) and at what severity. Pass the
    declared group names in `group_names` for a precise scan, or `[]` to use the
    uppercase-receiver shape heuristic. `file_path` appears in the note so the
    diagnostic names the call site."""
    var findings: [DynCapAcquireFinding] = []
    if mode == "allow":
        return findings
    if dca_file_is_init_phase_lines(lines):
        return findings

    val severity = _dca_severity_for(mode)
    var pending_init = false
    var current_fn_init = false
    var line_num = 0

    for raw_line in lines:
        line_num = line_num + 1
        val trimmed = raw_line.trim()

        if dca_is_init_phase_attribute(trimmed):
            pending_init = true
            continue
        if trimmed == "" or _dca_is_attribute_line(trimmed):
            # Blank lines and other attributes keep a pending @init_phase alive
            # so attributes can be stacked above the declaration.
            continue
        if _dca_is_fn_decl(trimmed):
            current_fn_init = pending_init
            pending_init = false
            continue
        pending_init = false

        if current_fn_init:
            continue

        val code_part = _dca_strip_comment(raw_line)
        val more = _dca_scan_line(code_part, line_num, file_path, group_names, severity)
        var k = 0
        while k < more.len():
            findings.push(more[k])
            k = k + 1

    findings

pub fn check_dynamic_capability_acquire(
    source: text,
    file_path: text,
    group_names: [text],
    mode: text
) -> [DynCapAcquireFinding]:
    """Compatibility adapter for callers that own only source text."""
    check_dynamic_capability_acquire_lines(
        source.split("\n"), file_path, group_names, mode)

fn _dca_scan_line(
    line: text,
    line_num: i64,
    file_path: text,
    group_names: [text],
    severity: text
) -> [DynCapAcquireFinding]:
    """Find every acquisition call on one line of code.

    Two scans. The `G.from(` and `G__from(` spellings both end in the literal
    text `from(`, so one scan covers them; the character just left of it says
    which spelling it is (`.` for `G.from(`, an identifier char for
    `G__from(`). The per-backend `<backend>_debug_profiler(` helper is a
    separate scan because it is matched by suffix, not by group name."""
    var out: [DynCapAcquireFinding] = []
    val dp = _dca_scan_debug_profiler(line, line_num, file_path, severity)
    var d = 0
    while d < dp.len():
        out.push(dp[d])
        d = d + 1
    val needle = "from("
    var pos = 0
    val n = line.len()
    while pos < n:
        val rest = line.substring(pos, n)
        val rel = rest.index_of(needle)
        if rel < 0:
            break
        val at = pos + rel
        pos = at + needle.len()

        if at == 0:
            continue
        val prev = line.substring(at - 1, at)
        var group = ""
        var spelling = ""
        if prev == ".":
            group = _dca_ident_ending_at(line, at - 1)
            spelling = "{group}.from(...)"
        else:
            # `G__from(` — read the whole identifier, which ends at the `(`,
            # i.e. 4 characters ("from") past the start of the match.
            val whole = _dca_ident_ending_at(line, at + 4)
            if not whole.ends_with("__from"):
                continue
            group = whole.substring(0, whole.len() - 6)
            spelling = "{group}__from(...)"
        if group == "":
            continue
        if not _dca_name_is_group(group, group_names):
            continue

        val msg = "capability group `{group}` is acquired here via {spelling}, outside any `@init_phase` function"
        val note = "{file_path}:{line_num} — acquire `{group}` once during boot in an `@init_phase` function and pass it down, or pin the capability in the manifest; a mid-flight acquisition has no safe failure path in critical mode"
        out.push(DynCapAcquireFinding(
            code: "DCA001",
            severity: severity,
            message: msg,
            name: group,
            note: note,
            line_num: line_num
        ))
    out

fn _dca_scan_debug_profiler(
    line: text,
    line_num: i64,
    file_path: text,
    severity: text
) -> [DynCapAcquireFinding]:
    """Find `<backend>_debug_profiler(...)` acquisition calls on one line.

    This is the interim single-value acquisition helper P2 landed
    (`ref_debug_profiler(session) -> Option<DebugProfiler>`), which every
    backend supplies until P0's desugar emits the single-accessor `.from()`.
    A non-empty backend prefix is required, so the trait/typedef name
    `DebugProfiler` and a bare `_debug_profiler(` are both left alone; the
    declaration line `pub fn ref_debug_profiler(...)` is excluded too, since
    defining the helper is not acquiring through it."""
    var out: [DynCapAcquireFinding] = []
    val trimmed = line.trim()
    if _dca_is_fn_decl(trimmed):
        return out
    val needle = "_debug_profiler("
    var pos = 0
    val n = line.len()
    while pos < n:
        val rest = line.substring(pos, n)
        val rel = rest.index_of(needle)
        if rel < 0:
            break
        val at = pos + rel
        pos = at + needle.len()

        # `at + 1` skips the leading `_` so the whole helper identifier is read.
        val whole = _dca_ident_ending_at(line, at + needle.len() - 1)
        if not whole.ends_with("_debug_profiler"):
            continue
        val backend = whole.substring(0, whole.len() - 15)
        if backend == "":
            continue

        val msg = "capability group `DebugProfiler` is acquired here via {whole}(...), outside any `@init_phase` function"
        val note = "{file_path}:{line_num} — acquire the debug/profile capability once during boot in an `@init_phase` function and pass the single value down; do not re-acquire per call, and do not pair per-member accessors (classes are value types, so pairing yields diverging copies)"
        out.push(DynCapAcquireFinding(
            code: "DCA001",
            severity: severity,
            message: msg,
            name: whole,
            note: note,
            line_num: line_num
        ))
    out

# ============================================================================
# DCA002 — manifest pin validation for gpu.backend
# ============================================================================

pub fn dca_backend_is_pinned(backend: text) -> bool:
    """A backend is pinned when it names a concrete backend, not a discovery.

    `auto` (and the empty value, which means "unset") are the unpinned spellings:
    both defer the choice to a boot-time probe, which is exactly what critical
    mode forbids."""
    val b = backend.trim()
    if b == "":
        return false
    if b == "auto":
        return false
    true

pub fn check_gpu_backend_pin(backend: text, critical: bool) -> [DynCapAcquireFinding]:
    """DCA002: under critical mode `gpu.backend` must be manifest-pinned.

    Outside critical mode this is not a finding — `auto` is the normal and
    correct setting there. Severity is a fixed ERROR rather than following
    `dynamic_acquire`: an unpinned backend is not a style preference, it makes
    the probe-vs-manifest refusal below unimplementable."""
    var findings: [DynCapAcquireFinding] = []
    if not critical:
        return findings
    if dca_backend_is_pinned(backend):
        return findings
    val shown = if backend.trim() == "": "<unset>" else: backend.trim()
    findings.push(DynCapAcquireFinding(
        code: "DCA002",
        severity: "ERROR",
        message: "critical mode requires a manifest-pinned gpu.backend, found `{shown}`",
        name: "gpu.backend",
        note: "set an explicit backend in the manifest (e.g. `backend: cuda(sm80)`); `auto` defers the choice to a boot probe, which critical mode does not permit",
        line_num: 0
    ))
    findings
