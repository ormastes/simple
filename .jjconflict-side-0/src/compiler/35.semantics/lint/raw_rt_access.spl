# Raw Runtime Intrinsic Access Lint
#
# raw_rt_access: warns when product code declares, imports, or calls a raw
# `rt_*` runtime intrinsic directly. Only sanctioned provider modules may bind
# and call raw runtime symbols.
#
# RAW-RT-001: `extern fn rt_<name>` outside a provider                         WARNING
# RAW-RT-002: direct `rt_<name>(...)` call/import outside a provider           WARNING
# RAW-RT-003: removed product-side `fn rt_<name>` alias                        WARNING
#
# Sanctioned provider modules may declare raw intrinsics directly. Ordinary
# `src/lib/` product code is not implicitly privileged. `src/compiler/` is
# also NOT privileged: a refactor (see
# llvm_native_link.spl) routed ~65 raw rt_* call sites in the compiler
# backend through the std.nogc_sync_mut.io_runtime facade because new
# `extern fn rt_*` decls in CLI-closure modules brick the deployed binary
# (unknown-extern rejection at module load kills ALL native-builds). This
# lint stays at WARNING severity (not Deny) so the many pre-existing
# `extern fn rt_*` declarations still in src/compiler/ (the compiler defines
# and bridges most of the rt_* runtime interface) do not fail the build —
# it flags them for review without gating on the existing count.
#
# This file uses text-heuristic analysis (no AST dependency) so it can run in
# interpreter-mode specs. It scans `extern fn` lines the way
# concurrency_api_misuse's E-PAR-005 scan does and extracts the declared name
# to test the `rt_` prefix.

# ============================================================================
# Finding Struct
# ============================================================================

pub struct RawRtAccessFinding:
    code: text
    kind: text
    severity: text
    message: text
    name: text
    note: text
    line_num: i64
    column: i64

    fn fmt() -> text:
        "[{self.code}] {self.severity}: {self.message} — {self.note}"

# ============================================================================
# Path Privilege Helper
# ============================================================================

pub fn raw_rt_provider_allowlist_allows(file_path: text, allowlist: text) -> bool:
    """Apply the canonical shell gate's prefix/suffix allowlist semantics."""
    var relative = file_path
    val src_at = file_path.find("src/")
    if src_at >= 0:
        relative = file_path.substring(src_at, file_path.len())
    for raw in allowlist.split("\n"):
        val entry = raw.trim()
        if entry == "" or entry.starts_with("#"):
            continue
        if entry.starts_with("suffix:"):
            val suffix = entry.substring(7, entry.len())
            if relative.ends_with(suffix):
                return true
        elif relative.starts_with(entry):
            return true
    false

fn _rra_marks_runtime_intrinsics(source: text) -> bool:
    """File-level `@runtime_intrinsics` / `#[runtime_intrinsics]` opt-out marker.

    Code that legitimately implements or bridges the runtime (emulators,
    baremetal MMIO, crypto/protocol impls) may keep raw `rt_*` externs by
    declaring this marker near the top of the file. Mirrors the Rust seed
    `file_marks_runtime_intrinsics` (top-of-file scan)."""
    val lines = source.split("\n")
    var i = 0
    while i < lines.len() and i < 30:
        val t = lines[i].trim()
        if t == "@runtime_intrinsics" or t.starts_with("@runtime_intrinsics ") or t == "#[runtime_intrinsics]":
            return true
        # The marker is a header declaration, never content inside a module
        # docstring or below code. Ignore only blank lines and ordinary #
        # comments while looking for it.
        if t != "" and not t.starts_with("#"):
            return false
        i = i + 1
    false

# ============================================================================
# Extern Name Extraction
# ============================================================================

fn _rra_extern_fn_name(trimmed: text) -> text:
    """Extract the declared name from a trimmed `extern fn <name>...` line.

    Returns "" when the line is not an extern fn declaration with a name."""
    if not trimmed.starts_with("extern fn "):
        return ""
    val rest = trimmed.substring(10, trimmed.len()).trim()
    var name = ""
    var i = 0
    val rlen = rest.len()
    while i < rlen:
        val ch = rest.substring(i, i + 1)
        if _rra_is_ident_char(ch):
            name = name + ch
        else:
            break
        i = i + 1
    name

fn _rra_is_ident_char(ch: text) -> bool:
    """True for identifier characters (alnum or underscore)."""
    if ch == "_":
        return true
    val is_lower = ch >= "a" and ch <= "z"
    val is_upper = ch >= "A" and ch <= "Z"
    val is_digit = ch >= "0" and ch <= "9"
    is_lower or is_upper or is_digit

fn _rra_leading_indent(line: text) -> i64:
    """Count leading indentation without allocating a trimmed copy."""
    var indent = 0
    while indent < line.len():
        val ch = line.substring(indent, indent + 1)
        if ch != " " and ch != "\t":
            break
        indent = indent + 1
    indent

pub fn raw_rt_wrapper_replacement(name: text) -> text:
    """Canonical wrapper name when a mechanical call rename is known."""
    # These mappings are signature-identical across the canonical facades.
    # Nullable environment reads and recursive-dir wrappers deliberately remain
    # hints, not mechanical edits.
    if name == "rt_process_run": return "process_run"
    if name == "rt_env_set": return "env_set"
    ""

fn _rra_fix_note(name: text) -> text:
    val wrapper = raw_rt_wrapper_replacement(name)
    if name == "rt_process_run":
        return "replace `rt_process_run(...)` with `process_run(...)` from the canonical std/app I/O facade; it preserves `(stdout, stderr, i64 exit_code)` transport; `simple lint --fix` applies this rename only when `process_run` is already imported"
    if name == "rt_env_set":
        return "replace `rt_env_set(...)` with `env_set(...)` from the canonical std/app I/O facade; it preserves the boolean mutation status; `simple lint --fix` applies this rename only when `env_set` is already imported"
    if wrapper != "":
        return "replace `{name}(...)` with `{wrapper}(...)` from the canonical std/app I/O facade; `simple lint --fix` applies this rename when `{wrapper}` is already imported"
    if name == "rt_env_get":
        return "use `env_get_nullable` from `std.nogc_sync_mut.io_runtime` for exact `text?` transport (including explicitly empty values); choose `env_get_opt` only when empty and absent are intentionally equivalent; `simple lint --fix` keeps this warning-only because return contracts differ"
    if name == "rt_file_read_text":
        return "use `file_read_text` from the canonical std/app I/O facade; `simple lint --fix` keeps this as a warning-only migration because nullable return contracts can differ"
    "route `{name}` through its std semantic facade; if none exists, create a provider wrapper instead of a product-side rt_* alias"

class RawRtLexState:
    in_string: bool
    in_triple: bool
    escaped: bool

    static fn new() -> RawRtLexState:
        RawRtLexState(in_string: false, in_triple: false, escaped: false)

    me clean_line(raw_line: text) -> text:
        """Blank comments and strings on one line while preserving columns."""
        # Most candidate lines have neither comments nor strings. Returning the
        # original line avoids one array cell allocation per source byte.
        if not self.in_string and not self.in_triple and not raw_line.contains("\"") and not raw_line.contains("#"):
            return raw_line
        var pieces: [text] = []
        var i = 0
        val line_len = raw_line.len()
        while i < line_len:
            if self.in_triple:
                # Blank in one run to the closing `\"\"\"` instead of one interpreted
                # `substring` + `push` per character. `index_of` matches only a
                # complete 3-char sequence, exactly like the old bounds test.
                val close = raw_line.index_of("\"\"\"", i)
                if close < 0:
                    pieces.push(" ".repeat(line_len - i))
                    i = line_len
                else:
                    pieces.push(" ".repeat(close - i + 3))
                    i = close + 3
                    self.in_triple = false
                continue
            val ch = raw_line.substring(i, i + 1)
            if self.in_string:
                pieces.push(" ")
                if self.escaped:
                    self.escaped = false
                elif ch == "\\":
                    self.escaped = true
                elif ch == "\"":
                    self.in_string = false
                i = i + 1
                continue
            if ch == "#":
                pieces.push(" ".repeat(line_len - i))
                i = line_len
                break
            # A `\"\"\"` can only start at a quote, so the 3-char probe is taken
            # there instead of once per character.
            if ch == "\"":
                if i + 2 < line_len and raw_line.substring(i, i + 3) == "\"\"\"":
                    pieces.push("   ")
                    i = i + 3
                    self.in_triple = true
                    continue
                pieces.push(" ")
                i = i + 1
                self.in_string = true
                continue
            # Ordinary text: copy the whole run up to the next `\"` or `#` in one
            # slice. Every character in it takes the verbatim-copy branch of the
            # original per-character walk, so the join is unchanged.
            var nq = raw_line.index_of("\"", i + 1)
            var nh = raw_line.index_of("#", i + 1)
            if nq < 0: nq = line_len
            if nh < 0: nh = line_len
            var run_end = nq
            if nh < run_end: run_end = nh
            pieces.push(raw_line.substring(i, run_end))
            i = run_end
        pieces.join("")

    me scan_line(raw_line: text) -> text:
        """Return lexical code needed by private token scans."""
        # On a neutral line with no quote, # starts a trailing comment. Token
        # columns before it are unchanged, so truncation avoids filling the
        # rest of the line with one-space array elements.
        if not self.in_string and not self.in_triple and not raw_line.contains("\""):
            val comment_at = raw_line.find("#")
            if comment_at >= 0:
                return raw_line.substring(0, comment_at)
        self.clean_line(raw_line)

pub fn raw_rt_lexical_code_lines(source: text) -> [text]:
    """Blank comments and normal/triple strings while preserving columns."""
    var result: [text] = []
    var state = RawRtLexState.new()
    for raw_line in source.split("\n"):
        result.push(state.clean_line(raw_line))
    result

fn _rra_names_in_call_position(line: text) -> [text]:
    var names: [text] = []
    var i = 0
    while i + 3 < line.len():
        val boundary_ok = i == 0 or not _rra_is_ident_char(line.substring(i - 1, i))
        if boundary_ok and line.substring(i, i + 3) == "rt_":
            var j = i + 3
            while j < line.len() and _rra_is_ident_char(line.substring(j, j + 1)):
                j = j + 1
            var k = j
            while k < line.len() and line.substring(k, k + 1) == " ":
                k = k + 1
            if j > i + 3 and k < line.len() and line.substring(k, k + 1) == "(":
                names.push(line.substring(i, j))
            i = j
        else:
            i = i + 1
    names

fn _rra_call_column(line: text, wanted: text) -> i64:
    var i = 0
    while i + wanted.len() <= line.len():
        val boundary_ok = i == 0 or not _rra_is_ident_char(line.substring(i - 1, i))
        if boundary_ok and line.substring(i, i + wanted.len()) == wanted:
            val end = i + wanted.len()
            var k = end
            while k < line.len() and line.substring(k, k + 1) == " ":
                k = k + 1
            if k < line.len() and line.substring(k, k + 1) == "(":
                return i + 1
        i = i + 1
    0

fn _rra_direct_import_names(line: text, import_context: bool) -> [text]:
    var names: [text] = []
    val t = line.trim()
    if not import_context and not t.starts_with("use ") and not t.starts_with("export use "):
        return names
    var i = 0
    while i + 3 < line.len():
        val boundary_ok = i == 0 or not _rra_is_ident_char(line.substring(i - 1, i))
        if boundary_ok and line.substring(i, i + 3) == "rt_":
            var j = i + 3
            while j < line.len() and _rra_is_ident_char(line.substring(j, j + 1)):
                j = j + 1
            names.push(line.substring(i, j))
            i = j
        else:
            i = i + 1
    names

# ============================================================================
# Main Entry Point
# ============================================================================

pub fn check_raw_rt_access_with_allowlist(source: text, file_path: text, allowlist: text) -> [RawRtAccessFinding]:
    """Text-based heuristic for RAW-RT-001 detection.

    Emits a WARNING for raw declarations, imports, calls, and product aliases
    outside paths admitted by the canonical provider allowlist. The explicit
    header marker remains available for true provider sources. Pass "" for
    file_path when unknown (treated as product code)."""
    var findings: [RawRtAccessFinding] = []
    if raw_rt_provider_allowlist_allows(file_path, allowlist):
        return findings
    if _rra_marks_runtime_intrinsics(source):
        return findings
    # Dominant fast path: avoid line splitting and lexical work for ordinary
    # files. `contains` is the only added scan in this case.
    if not source.contains("rt_"):
        return findings

    val lines = raw_rt_lexical_code_lines(source)
    var line_num = 0
    var in_selective_import = false
    var pending_ffi_declaration = false
    var ffi_block_indent = -1
    for line in lines:
        line_num = line_num + 1
        val code_line = line
        val t = code_line.trim()
        val indent = _rra_leading_indent(code_line)
        if t != "" and ffi_block_indent >= 0 and indent <= ffi_block_indent:
            ffi_block_indent = -1
        if t.starts_with("@unsafe"):
            pending_ffi_declaration = t.contains("ffi") or t.contains("Ffi")
            continue
        if t.starts_with("unsafe(") and t.ends_with(":") and
           (t.contains("ffi") or t.contains("Ffi")):
            ffi_block_indent = indent
            pending_ffi_declaration = false
            continue
        if not code_line.contains("rt_"):
            val starts_import = t.starts_with("use ") or t.starts_with("export use ")
            if starts_import and code_line.contains("{") and not code_line.contains("}"):
                in_selective_import = true
            if in_selective_import and code_line.contains("}"):
                in_selective_import = false
            if t != "" and not t.starts_with("@"):
                pending_ffi_declaration = false
            continue
        if t.starts_with("extern fn "):
            val name = _rra_extern_fn_name(t)
            val acknowledged_unsafe = pending_ffi_declaration
            pending_ffi_declaration = false
            if name.starts_with("rt_") and not acknowledged_unsafe:
                findings.push(RawRtAccessFinding(
                    code: "RAW-RT-001", kind: "declaration", severity: "WARNING",
                    message: "product code must not declare raw runtime intrinsic `{name}` directly",
                    name: name, note: _rra_fix_note(name), line_num: line_num,
                    column: code_line.find(name) + 1
                ))
            continue
        pending_ffi_declaration = false
        val is_rt_alias_decl = t.starts_with("fn rt_") or t.starts_with("pub fn rt_") or t.starts_with("static fn rt_") or t.starts_with("pub static fn rt_") or t.starts_with("async fn rt_") or t.starts_with("pub async fn rt_")
        if is_rt_alias_decl:
            val fn_start = t.find("fn ") + 3
            val tail = t.substring(fn_start, t.len())
            val stop = tail.find("(")
            val name = if stop > 0: tail.substring(0, stop).trim() else: "rt_alias"
            findings.push(RawRtAccessFinding(
                code: "RAW-RT-003", kind: "alias", severity: "WARNING",
                message: "product-side runtime alias `{name}` is removed; expose a semantic wrapper instead",
                name: name, note: _rra_fix_note(name), line_num: line_num,
                column: code_line.find(name) + 1
            ))
            continue
        val starts_import = t.starts_with("use ") or t.starts_with("export use ")
        val import_context = starts_import or in_selective_import
        if starts_import and code_line.contains("{") and not code_line.contains("}"):
            in_selective_import = true
        val import_names = _rra_direct_import_names(code_line, import_context)
        if in_selective_import and code_line.contains("}"):
            in_selective_import = false
        if import_names.len() > 0:
            val name = import_names[0]
            findings.push(RawRtAccessFinding(
                code: "RAW-RT-002", kind: "import", severity: "WARNING",
                message: "product code imports raw runtime intrinsic `{name}` directly",
                name: name, note: _rra_fix_note(name), line_num: line_num,
                column: code_line.find(name) + 1
            ))
            continue
        val call_names = _rra_names_in_call_position(code_line)
        val inside_ffi_block = ffi_block_indent >= 0 and indent > ffi_block_indent
        if call_names.len() > 0 and not inside_ffi_block:
            val name = call_names[0]
            findings.push(RawRtAccessFinding(
                code: "RAW-RT-002", kind: "call", severity: "WARNING",
                message: "product code calls raw runtime intrinsic `{name}` directly",
                name: name, note: _rra_fix_note(name), line_num: line_num,
                column: _rra_call_column(code_line, name)
            ))
    findings

pub fn check_raw_rt_access(source: text, file_path: text) -> [RawRtAccessFinding]:
    """Pure checker used by focused callers; no implicit path exemptions."""
    check_raw_rt_access_with_allowlist(source, file_path, "")
