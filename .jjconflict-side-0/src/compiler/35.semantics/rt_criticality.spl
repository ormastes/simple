# Mission-critical RT admission verdict engine. It consumes bounded compiler
# facts and computes the transitive forbidden-effect closure with one reverse
# graph and one worklist: O(V + E + propagated category bits), no runtime code.

use compiler.common.assurance.policy_names.{normalize_profile_name}
use compiler.common.rt_profile_policy.{RT_PROFILE_MIGRATION_EPOCH, rt_implicit_profile_is_error}
use std.common.crypto.sha256.{sha256_text}

val RT_EFFECT_ALLOC: i64 = 1
val RT_EFFECT_BLOCKING: i64 = 2
val RT_EFFECT_LOOP: i64 = 4
val RT_EFFECT_RECURSION: i64 = 8
val RT_EFFECT_DISPATCH: i64 = 16
val RT_EFFECT_LOGGING: i64 = 32
val RT_EFFECT_SYNC: i64 = 64
val RT_EFFECT_LOADER: i64 = 128
val RT_EFFECT_UNKNOWN: i64 = 256

struct RtCriticalFact:
    name: text
    own_effects: i64
    bounded_effects: i64
    callees: [text]
    line: i64
    effect_units: Dict<i64, i64> = {}

struct RtBoundCapability:
    subject_id: text
    closure_digest: text
    effect: i64
    max_units: i64
    review_id: text

var rt_bound_manifest_entries: [RtBoundCapability] = []
var rt_bound_manifest_sealed: bool = false

fn rt_bound_manifest_replace(entries: [RtBoundCapability]):
    rt_bound_manifest_entries = entries
    rt_bound_manifest_sealed = true

fn rt_bound_manifest_clear():
    rt_bound_manifest_entries = []
    rt_bound_manifest_sealed = false

fn rt_bound_manifest_capabilities() -> [RtBoundCapability]:
    if not rt_bound_manifest_sealed: return []
    rt_bound_manifest_entries

fn rt_sort_text(items: [text]) -> [text]:
    var out: [text] = []
    for item in items:
        var at = out.len()
        var i = 0
        while i < out.len():
            if item < out[i]:
                at = i
                break
            i = i + 1
        out.push(item)
        var j = out.len() - 1
        while j > at:
            out[j] = out[j - 1]
            j = j - 1
        out[at] = item
    out

fn rt_closure_digest(root_name: text, facts: [RtCriticalFact]) -> text:
    var lines: [text] = []
    for fact in facts:
        var unit_parts: [text] = []
        for bit in fact.effect_units.keys():
            unit_parts.push(bit.to_text() + ":" + fact.effect_units[bit].to_text())
        lines.push(fact.name + "|" + fact.own_effects.to_text() + "|" +
            rt_sort_text(unit_parts).join(",") + "|" +
            rt_sort_text(fact.callees).join(","))
    sha256_text("RT-CLOSURE-V1\n" + root_name + "\n" + rt_sort_text(lines).join("\n"))

fn rt_observed_effect_units(effects: i64) -> Dict<i64, i64>:
    var units: Dict<i64, i64> = {}
    for bit in [RT_EFFECT_ALLOC, RT_EFFECT_BLOCKING, RT_EFFECT_LOOP,
        RT_EFFECT_RECURSION, RT_EFFECT_DISPATCH, RT_EFFECT_LOGGING,
        RT_EFFECT_SYNC, RT_EFFECT_LOADER]:
        if (effects & bit) != 0: units[bit] = 1
    units

fn rt_fact_observed_units(fact: RtCriticalFact) -> Dict<i64, i64>:
    if fact.effect_units.len() > 0: return fact.effect_units
    rt_observed_effect_units(fact.own_effects)

fn rt_effect_is_single(effect: i64) -> bool:
    effect > 0 and (effect & (effect - 1)) == 0 and effect <= RT_EFFECT_LOADER

fn rt_reviewed_bound_mask(subject_id: text, closure_digest: text,
    observed_units: Dict<i64, i64>, capabilities: [RtBoundCapability]) -> i64:
    var mask: i64 = 0
    for capability in capabilities:
        if capability.subject_id != subject_id: continue
        if capability.closure_digest == "" or capability.closure_digest != closure_digest: continue
        if capability.review_id == "" or capability.max_units <= 0: continue
        if not rt_effect_is_single(capability.effect): continue
        if not observed_units.contains_key(capability.effect): continue
        val actual = observed_units[capability.effect]
        if actual <= 0 or actual > capability.max_units: continue
        mask = mask | capability.effect
    mask

fn rt_effect_name(bit: i64) -> text:
    if bit == RT_EFFECT_ALLOC: return "allocation"
    if bit == RT_EFFECT_BLOCKING: return "blocking"
    if bit == RT_EFFECT_LOOP: return "loop"
    if bit == RT_EFFECT_RECURSION: return "recursion"
    if bit == RT_EFFECT_DISPATCH: return "dispatch"
    if bit == RT_EFFECT_LOGGING: return "logging"
    if bit == RT_EFFECT_SYNC: return "synchronization"
    if bit == RT_EFFECT_LOADER: return "loader"
    "unknown"

fn rt_critical_profile(profile: text) -> bool:
    profile == "" or normalize_profile_name(profile) == "critical"

fn rt_critical_profile_diagnostics(fn_name: text, profile: text, reason: text, implicit_as_error: bool) -> [text]:
    var out: [text] = []
    if profile == "":
        val level = if implicit_as_error: "error" else: "warning"
        val code = if implicit_as_error: "E-RT-PROFILE-001" else: "W-RT-PROFILE-001"
        out.push(level + "[" + code + "]: @rt declaration '" + fn_name +
            "' defaults to critical; write @rt(critical)")
        return out
    val normalized = normalize_profile_name(profile)
    if normalized == "":
        out.push("error[RT-E-UNKNOWN-PROFILE]: @rt declaration '" + fn_name +
            "' has unknown criticality profile '" + profile + "'")
        return out
    if normalized != "critical" and reason == "":
        out.push("error[RT-E-LOWER-TIER-REASON]: @rt declaration '" + fn_name +
            "' lowers criticality to '" + profile + "' without reason")
    out

fn rt_fact_index(facts: [RtCriticalFact]) -> Dict<text, i64>:
    var index: Dict<text, i64> = {}
    var i = 0
    while i < facts.len():
        index[facts[i].name] = i
        i = i + 1
    index

fn rt_critical_closure(facts: [RtCriticalFact]) -> [i64]:
    val index = rt_fact_index(facts)
    var masks: [i64] = []
    var reverse: [[i64]] = []
    var remaining: [i64] = []
    var queue: [i64] = []
    var i = 0
    while i < facts.len():
        # A reviewed bound applies only to this function's own effect. It is
        # consumed before propagation and can never waive the same category in
        # an arbitrary transitive callee.
        masks.push(facts[i].own_effects & ~facts[i].bounded_effects)
        reverse.push([])
        remaining.push(0)
        i = i + 1
    i = 0
    while i < facts.len():
        for callee in facts[i].callees:
            if index.contains_key(callee):
                val ci = index[callee]
                reverse[ci] = reverse[ci].push(i)
                remaining[i] = remaining[i] + 1
            else:
                masks[i] = masks[i] | RT_EFFECT_UNKNOWN
        if remaining[i] == 0: queue.push(i)
        i = i + 1
    # Kahn elimination identifies every recursive SCC and every caller whose
    # closure depends on it. It deliberately does not propagate effects; the
    # monotone worklist below handles acyclic and cyclic edges uniformly.
    var head = 0
    while head < queue.len():
        val done = queue[head]
        head = head + 1
        for caller in reverse[done]:
            remaining[caller] = remaining[caller] - 1
            if remaining[caller] == 0: queue.push(caller)
    # Nodes left after leaf-first elimination are recursive or depend on a
    # recursive SCC. Both are forbidden in a critical transitive closure.
    i = 0
    while i < facts.len():
        if remaining[i] > 0: masks[i] = masks[i] | RT_EFFECT_RECURSION
        i = i + 1
    # Propagate every category through SCCs and ordinary edges. A bit can enter
    # each node once, so the work is bounded by O((V + E) * category_bits),
    # including recursive graphs; there is no iteration-count guess.
    queue = []
    var queued: [i64] = []
    i = 0
    while i < facts.len():
        queue.push(i)
        queued.push(1)
        i = i + 1
    head = 0
    while head < queue.len():
        val done = queue[head]
        head = head + 1
        queued[done] = 0
        for caller in reverse[done]:
            val next = masks[caller] | masks[done]
            if next != masks[caller]:
                masks[caller] = next
                if queued[caller] == 0:
                    queue.push(caller)
                    queued[caller] = 1
    masks

fn rt_critical_admit(root_name: text, facts: [RtCriticalFact]) -> [text]:
    var out: [text] = []
    val index = rt_fact_index(facts)
    if not index.contains_key(root_name):
        return ["error[RT-E-UNBOUNDED-UNKNOWN]: @rt declaration '" + root_name + "' has no lowered body"]
    val i = index[root_name]
    val masks = rt_critical_closure(facts)
    val rejected = masks[i]
    for bit in [RT_EFFECT_ALLOC, RT_EFFECT_BLOCKING, RT_EFFECT_LOOP,
        RT_EFFECT_RECURSION, RT_EFFECT_DISPATCH, RT_EFFECT_LOGGING,
        RT_EFFECT_SYNC, RT_EFFECT_LOADER, RT_EFFECT_UNKNOWN]:
        if (rejected & bit) != 0:
            out.push("error[RT-E-UNBOUNDED-" + rt_effect_name(bit).to_upper() +
                "]: critical RT closure '" + root_name + "' contains unproved " + rt_effect_name(bit))
    out

export RT_EFFECT_ALLOC, RT_EFFECT_BLOCKING, RT_EFFECT_LOOP, RT_EFFECT_RECURSION
export RT_EFFECT_DISPATCH, RT_EFFECT_LOGGING, RT_EFFECT_SYNC, RT_EFFECT_LOADER, RT_EFFECT_UNKNOWN
export RtCriticalFact, rt_critical_profile, rt_critical_profile_diagnostics
export RtBoundCapability, rt_reviewed_bound_mask, rt_effect_is_single
export rt_bound_manifest_replace, rt_bound_manifest_clear, rt_bound_manifest_capabilities
export rt_closure_digest, rt_observed_effect_units, rt_sort_text
export rt_fact_observed_units
export rt_critical_closure, rt_critical_admit, rt_effect_name
export RT_PROFILE_MIGRATION_EPOCH, rt_implicit_profile_is_error
