# General Loop Optimization Skeletons
#
# LICM, unrolling, and strength reduction are disabled transforms. Their
# compatibility methods remain identities until shared loop/memory facts prove
# legality and a target cost model proves profitability.

use compiler.mir.mir_instructions.{MirFunction, MirBlock}
use compiler.mir_opt.mir_opt.loop_detect.{LoopInfo}
use compiler.mir_opt.mir_opt.loop_licm.{LoopInvariantMotion}
use compiler.mir_opt.mir_opt.loop_strength.{StrengthReduction}

class LoopUnroller:
    unroll_threshold: i64
    unrolled_count: i64

impl LoopUnroller:
    static fn new(threshold: i64) -> LoopUnroller:
        LoopUnroller(unroll_threshold: threshold, unrolled_count: 0)

    me optimize_function(func: MirFunction) -> MirFunction:
        func

    me unroll_loop(
        blocks: [MirBlock], loop_info: LoopInfo, count: i64
    ) -> [MirBlock]:
        blocks

    me partial_unroll_loop(
        blocks: [MirBlock], loop_info: LoopInfo, factor: i64
    ) -> [MirBlock]:
        blocks

class LoopOptimization:
    licm: LoopInvariantMotion
    strength_reduction: StrengthReduction
    unroller: LoopUnroller
    enabled_licm: bool
    enabled_strength: bool
    enabled_unroll: bool

impl LoopOptimization:
    static fn new(
        enable_licm: bool, enable_strength: bool, enable_unroll: bool,
        unroll_threshold: i64
    ) -> LoopOptimization:
        LoopOptimization(
            licm: LoopInvariantMotion.new(),
            strength_reduction: StrengthReduction.new(),
            unroller: LoopUnroller.new(unroll_threshold),
            enabled_licm: enable_licm,
            enabled_strength: enable_strength,
            enabled_unroll: enable_unroll
        )

    static fn conservative() -> LoopOptimization:
        LoopOptimization.new(true, false, false, 4)

    static fn aggressive() -> LoopOptimization:
        LoopOptimization.new(true, true, true, 16)

    fn name() -> text:
        "loop_optimization"

    fn description() -> text:
        "Disabled loop optimization compatibility skeleton"

    fn is_analysis_pass() -> bool:
        false

    fn dependencies() -> [text]:
        ["constant_folding", "copy_propagation"]

    me run_on_function(func: MirFunction) -> MirFunction:
        # Do not chain class methods around the canonical disabled dispatcher.
        func

    fn stats_summary() -> text:
        "LoopOpt: hoisted {self.licm.hoisted_count} invariants, reduced {self.strength_reduction.reduced_count} ops, unrolled {self.unroller.unrolled_count} loops"

fn create_loop_opt_conservative() -> LoopOptimization:
    LoopOptimization.conservative()

fn create_loop_opt_pass() -> LoopOptimization:
    LoopOptimization.aggressive()

fn loop_opt_run_on_function(
    loop_pass: LoopOptimization, func: MirFunction
) -> MirFunction:
    func
