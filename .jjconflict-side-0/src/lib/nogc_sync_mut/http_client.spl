# HTTP Client — nogc_sync_mut root shim
#
# Re-exports the flat HTTP client API from the submodule directory.
# Consumers import: use std.nogc_sync_mut.http_client.{http_get, ...}

use std.nogc_sync_mut.http_client.request.{add_header as request_add_header, create_headers as request_create_headers, get_header as request_get_header, has_header as request_has_header, http_delete as request_http_delete, http_get as request_http_get, http_post as request_http_post, http_put as request_http_put, remove_header as request_remove_header, set_header as request_set_header}
use std.nogc_sync_mut.http_client.response.{response_get_body as response_body, response_get_header as response_header, response_get_headers as response_headers, response_get_status_code as response_status_code, response_get_status_text as response_status_text, response_is_client_error as response_client_error, response_is_redirect as response_redirect, response_is_server_error as response_server_error, response_is_success as response_success}
import std.nogc_sync_mut.http_client.connection

# ============================================================================
# Request helpers — build request tuples
# ============================================================================

fn create_headers() -> list:
    request_create_headers()

fn add_header(headers: list, name: text, value: text) -> list:
    request_add_header(headers, name, value)

fn get_header(headers: list, name: text) -> text?:
    request_get_header(headers, name)

fn has_header(headers: list, name: text) -> bool:
    request_has_header(headers, name)

fn remove_header(headers: list, name: text) -> list:
    request_remove_header(headers, name)

fn set_header(headers: list, name: text, value: text) -> list:
    request_set_header(headers, name, value)

fn http_get(url: text) -> (text, text, list, text):
    request_http_get(url)

fn http_post(url: text, body: text) -> (text, text, list, text):
    request_http_post(url, body)

fn http_put(url: text, body: text) -> (text, text, list, text):
    request_http_put(url, body)

fn http_delete(url: text) -> (text, text, list, text):
    request_http_delete(url)

# ============================================================================
# Response helpers — extract fields from response tuples
# ============================================================================

fn response_get_status_code(resp: (i64, text, list, text)) -> i64:
    response_status_code(resp)

fn response_get_status_text(resp: (i64, text, list, text)) -> text:
    response_status_text(resp)

fn response_get_headers(resp: (i64, text, list, text)) -> list:
    response_headers(resp)

fn response_get_body(resp: (i64, text, list, text)) -> text:
    response_body(resp)

fn response_get_header(resp: (i64, text, list, text), name: text) -> text?:
    response_header(resp, name)

fn response_is_success(resp: (i64, text, list, text)) -> bool:
    response_success(resp)

fn response_is_redirect(resp: (i64, text, list, text)) -> bool:
    response_redirect(resp)

fn response_is_client_error(resp: (i64, text, list, text)) -> bool:
    response_client_error(resp)

fn response_is_server_error(resp: (i64, text, list, text)) -> bool:
    response_server_error(resp)
