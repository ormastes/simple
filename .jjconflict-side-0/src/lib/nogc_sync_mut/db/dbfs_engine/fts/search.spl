# FTS Search Engine — unified full-text search API.
#
# Combines inverted index (BM25), trigram substring search, and fuzzy matching.
# Exports: FtsEngine

use std.io_runtime
use std.db.dbfs_engine.fts.tokenizer.{fts_tokenize, fts_tokenize_raw}
use std.db.dbfs_engine.fts.inverted_index.{FtsInvertedIndex, FtsPosting}
use std.db.dbfs_engine.fts.bm25.{fts_bm25_search, FtsSearchResult}
use std.db.dbfs_engine.fts.trigram.{FtsTrigramIndex, fts_generate_trigrams}
use std.db.dbfs_engine.fts.fuzzy.{fts_levenshtein, fts_fuzzy_match}

# ── FtsEngine ──────────────────────────────────────────────────────────────────

struct FtsEngine:
    _inv_index: FtsInvertedIndex
    _tri_index: FtsTrigramIndex
    _doc_contents: Dict<text, text>

struct FtsTextSearchResult:
    document_id: text
    score_milli: i64

struct FtsCompatibilityCapabilities:
    lexical: bool
    explain: bool
    stats: bool
    text_ids: bool
    scope_partition: text
    phrase: bool
    provider_protocol: bool

struct FtsCompatibilityStats:
    supported_scope: text
    document_count: i64
    total_tokens: i64
    average_document_length_fixed: i64
    query_reads: i64

# Narrow DBFS bridge for callers that need the canonical public text-id order.
# This is deliberately not SearchProvider: snapshot/delta/cursor protocol
# ownership remains with the application provider.
struct FtsCompatibilityIndex:
    _scope: text
    _engine: FtsEngine
    _external_ids: [text]
    _ordinals: [i64]
    _next_ordinal: i64
    _query_reads: i64

impl FtsEngine:
    static fn new() -> FtsEngine:
        FtsEngine(
            _inv_index: FtsInvertedIndex.new(),
            _tri_index: FtsTrigramIndex.new(),
            _doc_contents: {}
        )

    me fn add_document(doc_id: i64, content: text):
        val doc_key = "{doc_id}"
        # Both indexes implement idempotent removal.  Removing first makes
        # add_document an upsert across lexical, trigram, and corpus state.
        self._inv_index.remove_document(doc_id)
        self._tri_index.remove_document(doc_id)
        self._doc_contents[doc_key] = content
        self._inv_index.index_document(doc_id, content)
        self._tri_index.index_document(doc_id, content)

    me fn remove_document(doc_id: i64):
        val doc_key = "{doc_id}"
        self._inv_index.remove_document(doc_id)
        self._tri_index.remove_document(doc_id)
        # Mark as removed in contents
        self._doc_contents[doc_key] = ""

    me fn search_keyword(query: text) -> [FtsSearchResult]:
        fts_bm25_search(self._inv_index, query)

    me fn search_substring(query: text) -> [i64]:
        self._tri_index.search(query)

    me fn search_fuzzy(query: text, max_dist: i64) -> [text]:
        val terms = self._inv_index.get_all_terms()
        fts_fuzzy_match(query, terms, max_dist)

    me fn search(query: text) -> [FtsSearchResult]:
        # Primary: BM25 keyword search
        val keyword_results = fts_bm25_search(self._inv_index, query)
        if keyword_results.len() > 0:
            return keyword_results

        # Fallback: trigram substring search -> convert to FtsSearchResult
        val trigram_ids = self._tri_index.search(query)
        var results: [FtsSearchResult] = []
        var ti: i32 = 0
        while ti < trigram_ids.len() as i32:
            results.push(FtsSearchResult(doc_id: trigram_ids[ti], score: 1000))
            ti = ti + 1
        results

    me fn corpus_stats():
        self._inv_index.corpus_stats()

impl FtsCompatibilityIndex:
    static fn new(supported_scope: text) -> FtsCompatibilityIndex:
        FtsCompatibilityIndex(
            _scope: supported_scope,
            _engine: FtsEngine.new(),
            _external_ids: [],
            _ordinals: [],
            _next_ordinal: 1,
            _query_reads: 0
        )

    fn supported_scope() -> text:
        self._scope

    fn capabilities() -> FtsCompatibilityCapabilities:
        FtsCompatibilityCapabilities(
            lexical: true,
            explain: true,
            stats: true,
            text_ids: true,
            scope_partition: "single",
            phrase: false,
            provider_protocol: false
        )

    fn _slot(document_id: text) -> i64:
        var i: i64 = 0
        while i < self._external_ids.len():
            if self._external_ids[i] == document_id:
                return i
            i = i + 1
        -1

    fn _external_id(ordinal: i64) -> text:
        var i: i64 = 0
        while i < self._ordinals.len():
            if self._ordinals[i] == ordinal:
                return self._external_ids[i]
            i = i + 1
        ""

    me fn add_document(document_id: text, content: text) -> i64:
        val existing = self._slot(document_id)
        if existing >= 0:
            val ordinal = self._ordinals[existing]
            self._engine.add_document(ordinal, content)
            return ordinal
        val ordinal = self._next_ordinal
        self._next_ordinal = self._next_ordinal + 1
        self._external_ids.push(document_id)
        self._ordinals.push(ordinal)
        self._engine.add_document(ordinal, content)
        ordinal

    fn ordinal_for(document_id: text) -> i64:
        val slot = self._slot(document_id)
        if slot < 0:
            return 0
        self._ordinals[slot]

    me fn query(scope: text, query_text: text) -> Result<[FtsTextSearchResult], text>:
        # Authorization/scope must be decided before touching index state.
        if scope != self._scope:
            return Err("unsupported_scope")
        self._query_reads = self._query_reads + 1
        val ordinal_results = self._engine.search_keyword(query_text)
        var results: [FtsTextSearchResult] = []
        var i: i64 = 0
        while i < ordinal_results.len():
            val hit = ordinal_results[i]
            results.push(FtsTextSearchResult(
                document_id: self._external_id(hit.doc_id),
                score_milli: hit.score
            ))
            i = i + 1

        # Public tie contract is UTF-8/text id ascending, independent of the
        # private ordinal assigned by insertion order.
        var si: i64 = 1
        while si < results.len():
            val key_result = results[si]
            var sj: i64 = si - 1
            while (sj >= 0 and
                   (results[sj].score_milli < key_result.score_milli or
                    (results[sj].score_milli == key_result.score_milli and
                     key_result.document_id < results[sj].document_id))):
                results[sj + 1] = results[sj]
                sj = sj - 1
            results[sj + 1] = key_result
            si = si + 1
        Ok(results)

    me fn stats() -> FtsCompatibilityStats:
        val corpus = self._engine.corpus_stats()
        FtsCompatibilityStats(
            supported_scope: self._scope,
            document_count: corpus.document_count,
            total_tokens: corpus.total_tokens,
            average_document_length_fixed: corpus.average_document_length_fixed,
            query_reads: self._query_reads
        )
