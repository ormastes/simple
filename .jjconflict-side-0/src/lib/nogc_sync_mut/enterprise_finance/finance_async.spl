"""
# Enterprise Finance — async wrappers

Thin `async fn` wrappers over the synchronous finance reports and commands,
for callers on the async runtime (web handlers, actors). Semantics are
identical to `finance.spl`; no extra state, no extra effects.
"""

use std.nogc_sync_mut.enterprise_store.store.{EnterpriseStore}
use std.nogc_sync_mut.enterprise_sale.foundation.{
    TenantContext, ActorContext, SessionContext, CommandEnvelope, CommandResult
}
use std.nogc_sync_mut.enterprise_finance.finance.{
    FinTrialBalance,
    fin_trial_balance, fin_ar_open, fin_ap_open,
    fin_period_status, fin_close_report,
    fin_period_close, fin_post_journal_guarded
}

async fn fin_trial_balance_async(store: EnterpriseStore, tenant_id: text) -> FinTrialBalance:
    fin_trial_balance(store, tenant_id)

async fn fin_ar_open_async(store: EnterpriseStore, tenant_id: text) -> [(text, i64)]:
    fin_ar_open(store, tenant_id)

async fn fin_ap_open_async(store: EnterpriseStore, tenant_id: text) -> [(text, i64)]:
    fin_ap_open(store, tenant_id)

async fn fin_period_status_async(store: EnterpriseStore, tenant_id: text) -> i64:
    fin_period_status(store, tenant_id)

async fn fin_close_report_async(store: EnterpriseStore, tenant_id: text) -> (i64, i64):
    fin_close_report(store, tenant_id)

async fn fin_period_close_async(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, envelope: CommandEnvelope, period_end_epoch: i64, now_epoch: i64) -> CommandResult:
    fin_period_close(store, session, tenant, who, envelope, period_end_epoch, now_epoch)

async fn fin_post_journal_guarded_async(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, envelope: CommandEnvelope, ref_id: text, debit_account: text, credit_account: text, amount_cents: i64, posted_at_epoch: i64) -> CommandResult:
    fin_post_journal_guarded(store, session, tenant, who, envelope, ref_id, debit_account, credit_account, amount_cents, posted_at_epoch)

export fin_trial_balance_async, fin_ar_open_async, fin_ap_open_async
export fin_period_status_async, fin_close_report_async
export fin_period_close_async, fin_post_journal_guarded_async
