# VulkanExec — NotebookExecutor backing the Vulkan SVM-G lane
# (`interpreter(remote(vulkan(spvNN)))`).
#
# Design:  doc/05_design/app/tools/notebook_lanes_architecture.md §4.5
# Plan:    doc/03_plan/agent_tasks/notebook_lanes_parallel_plan_2026-08-07.md (Stream K, K6)
#
# Wraps the EXISTING GPU-plan C3 Vulkan SVM-G building blocks (no reimplemented
# SFFI/session/fence logic):
#   - probing:  a throwaway `VulkanLaneSession.probe()` — the exact host-aware
#     capability check `vulkan_vm_executor_conformance_spec.spl`'s `_probe()`
#     helper and `vulkan_lane_session_spec.spl` already use. Never raises,
#     never hangs; returns "" (ready) or "skip:<reason>".
#   - session (device/pipeline/arena, created once): `VulkanLaneSession.init`
#     with the checked-in `svmg_vulkan_kernel.spv` artifact — identical to
#     what `VulkanVmExecutor.init` does internally.
#   - per-cell dispatch: `VulkanVmExecutor.run_source_persisting_data`
#     (added to `vulkan_vm_executor.spl` to fix, at the root,
#     doc/08_tracking/bug/vulkan_vm_executor_run_source_clobbers_arena_data_each_call_2026-08-08.md
#     -- `run_source`'s own fresh-every-call `build_svmg_arena` is unchanged
#     and remains correct for its stateless one-shot conformance-vector
#     contract). This file keeps its own `last_arena: [u8]` copy across
#     `execute_cell()` calls and passes it as `prior_arena` on each call; the
#     executor overlays the freshly assembled header+code onto a COPY of that
#     prior readback (not a freshly zeroed buffer) -- same self-modifying-
#     code semantics `build_svmg_arena` already has for header/code, but the
#     DATA region beyond `data_off` (and anything the previous run wrote via
#     STORE8/STORE32) survives into the next dispatch. The executor also
#     resets the transient, per-run output channels (RAM sentinel word, REG
#     block, LOG head/cap, RECORD ring) before each dispatch, so a cell's
#     `CellResult` reflects only that cell's own dispatch, not a cumulative
#     log across the whole session. The REG block (CMD/ARG0/ARG1/STATUS/
#     RESULT/SEQ_ID/TRIGGER) reset is defensive hygiene for the *separate* A2
#     interactive-mailbox register file this "buffered mailbox only" design
#     does not use (confirmed: `src/lib/common/svmg/ref_vm.spl`'s per-record
#     `seq` field is a plain VM-instance counter that starts at 0 and is
#     never read from or written to that arena region at all) -- it does not
#     affect `record.seq` semantics one way or the other. This file no longer
#     reimplements the header/code overlay or the transient-channel reset
#     itself.
#
# Interrupt / DEVICE_LOST (design §4.5): `VulkanLaneSession.dispatch_once`
# already folds both a plain fence timeout and an unrecoverable
# `VK_ERROR_DEVICE_LOST` into the SAME sentinel/error path (documented in
# `vulkan_lane_session.spl`'s `dispatch_once` docstring: "cannot yet
# distinguish a plain timeout from an actual VK_ERROR_DEVICE_LOST -- both
# fold to the same sentinel"), and leaves the session in
# `completion_unknown`/`release_pending` state, which every other session
# method (`arena_write`/`arena_read`/`dispatch_once`) already refuses to
# proceed past. `VulkanExec` surfaces that as `blocked_reason` (design
# §4.5's "marks the lane blocked until %reset"); `interrupt()` forces the
# same blocked state (no async cancel channel exists below the synchronous
# `dispatch_once` call, same limitation `RemoteExec.interrupt()` documents);
# `reset()` tears the old session down best-effort and builds a BRAND NEW
# `VulkanLaneSession` + re-inits, so the lane genuinely becomes usable again
# (or reports a fresh, honest blocked reason) rather than retry-looping on a
# possibly-wedged session object.

use std.notebook.types.{LaneStatus, CellResult, SessionOpts, cell_result_error}
use std.notebook.executor.{NotebookExecutor, NotebookExecutorFactory}
use std.common.svmg.assembler.{svmg_asm}
use std.common.svmg.sgp.{sgp_header_new, encode_sgp_header, SGP_HEADER_SIZE}
use std.common.svmg.mailbox_const.{
    ARENA_DATA_SIZE, ARENA_TOTAL_SIZE, RAM_SENTINEL_OFFSET,
    REG_BASE_OFFSET, REG_BLOCK_SIZE,
    LOG_HEAD_OFFSET, LOG_CAP_OFFSET, LOG_DATA_OFFSET, DEFAULT_LOG_CAP,
    RECORD_SIZE, SENTINEL_EXIT_MASK}
use std.gc_async_mut.gpu_lane.vulkan_lane_session.{VulkanLaneSession}
use std.gc_async_mut.gpu_lane.vulkan_vm_executor.{
    SVMG_ENTRY, DEFAULT_STEP_BUDGET, build_svmg_arena,
    read_sentinel, read_log, read_records}
use std.sffi.io.{file_read_bytes}
use std.nogc_sync_mut.io.time_ops.{time_now_unix_micros}

# Checked-in SVM-G Vulkan compute-shader artifact (Task C3) — read once per
# start()/reset(), same path `vulkan_vm_executor_conformance_spec.spl` uses.
val _KERNEL_SPV: text = "src/lib/gc_async_mut/gpu_lane/svmg_vulkan_kernel.spv"

# Number of RECORD-ring slots this executor drains per dispatch (matches
# `vulkan_vm_executor.spl`'s `run_source`'s own `read_records(out_arena, 64)`
# call).
val _MAX_RECORDS: i64 = 64

fn _strip_skip_prefix(reason: text) -> text:
    if reason.starts_with("skip:"):
        return reason[5:]
    reason

# Decode ONLY the successful-exit shape of the GMB-1 sentinel (trapped +
# exit_code) -- a timeout/device-lost sentinel is intercepted earlier, at
# `dispatch_once`'s own error return, and never reaches this decode. Small
# local copy of the same bit logic `vulkan_vm_executor.spl`'s private
# `_decode_sentinel` uses (not exported there), matching this repo's existing
# convention of each gpu_lane-adjacent file keeping its own tiny pure decode
# helper rather than reaching into a sibling module for it.
fn _decode_exit(sentinel: i64) -> (bool, i64):
    val high16 = sentinel & 0xFFFF0000
    if high16 == SENTINEL_EXIT_MASK:
        val code_val = sentinel & 0xFFFF
        return (code_val == 0x7F, code_val)
    (false, 0)

# ============================================================================
# VulkanExec — one persistent VulkanLaneSession + a carried-over arena
# readback per (session, mode_spec) cache entry (design §4.5).
# ============================================================================

class VulkanExec:
    spec: text
    session: VulkanLaneSession
    initialized: bool
    blocked_reason: text
    last_arena: [u8]
    step_budget: i64

    static fn make(mode_spec: text) -> VulkanExec:
        VulkanExec(
            spec: mode_spec,
            session: VulkanLaneSession.create(),
            initialized: false,
            blocked_reason: "",
            last_arena: [],
            step_budget: DEFAULT_STEP_BUDGET,
        )

    # ------------------------------------------------------------------
    # Shared start()/reset() bring-up: probe, load kernel, init session,
    # seed last_arena with a valid empty-program arena.
    # ------------------------------------------------------------------

    me _establish():
        val probe_status = self.probe()
        if not probe_status.is_available():
            # `blocked_reason` always holds the RAW diagnostic (no prefix);
            # `execute_cell` is the single place that adds the repo's
            # "blocked: " prefix convention (types.spl) when surfacing it.
            self.blocked_reason = "vulkan probe: {probe_status.to_text()}"
            return

        val kernel_bytes = file_read_bytes(_KERNEL_SPV)
        if kernel_bytes.len() == 0:
            self.blocked_reason = "vulkan kernel artifact missing or empty: {_KERNEL_SPV}"
            return

        val init_err = self.session.init(ARENA_TOTAL_SIZE, kernel_bytes, SVMG_ENTRY)
        if init_err != "":
            self.blocked_reason = "vulkan session init failed: {init_err}"
            return

        self.initialized = true
        self.blocked_reason = ""
        self.last_arena = build_svmg_arena([], self.step_budget, 0)

impl NotebookExecutor for VulkanExec:
    fn mode_spec() -> text:
        self.spec

    fn probe() -> LaneStatus:
        var probe_session = VulkanLaneSession.create()
        val result = probe_session.probe()
        if result == "":
            return LaneStatus.Available
        if result.starts_with("skip:"):
            return LaneStatus.Skip(_strip_skip_prefix(result))
        LaneStatus.Blocked(result)

    me start(opts: SessionOpts):
        self.step_budget = if opts.step_budget > 0: opts.step_budget else: DEFAULT_STEP_BUDGET
        self._establish()

    me execute_cell(code: text, cell_id: text) -> CellResult:
        val _ = cell_id
        if self.blocked_reason != "":
            return cell_result_error("blocked: {self.blocked_reason}", 0)
        if not self.initialized:
            return cell_result_error("vulkan session not started", 0)

        val start_us = time_now_unix_micros()

        # Assemble this cell's SVM-G program (D1 assembler syntax -- same
        # source shape `run_source`/the conformance vectors use; there is no
        # Simple-source-to-SVM-G compiler yet, same documented limitation
        # class as K4's RemoteExec/compile_remote_binary stub).
        val code_bytes = svmg_asm(code)
        val code_off = SGP_HEADER_SIZE
        val code_len = code_bytes.len()
        val data_off = code_off + code_len
        if data_off > ARENA_DATA_SIZE:
            return cell_result_error(
                "cell SGP blob ({data_off} bytes) exceeds DATA region ({ARENA_DATA_SIZE} bytes)", 0)

        val header = sgp_header_new(code_off, code_len, data_off, 0, self.step_budget, 0)
        val header_bytes = encode_sgp_header(header)

        # Overlay onto a COPY of the previous readback (arrays are value
        # types) -- preserves the DATA region a prior cell's STORE8/STORE32
        # left behind, per design §4.5.
        var arena = self.last_arena
        var i = 0
        while i < header_bytes.len():
            arena[i] = header_bytes[i]
            i = i + 1
        i = 0
        while i < code_bytes.len():
            arena[code_off + i] = code_bytes[i]
            i = i + 1

        # Reset only the transient per-dispatch output channels so this
        # cell's CellResult reflects just this dispatch, not a cumulative
        # log across the whole session.
        arena[RAM_SENTINEL_OFFSET + 0] = 0 as u8
        arena[RAM_SENTINEL_OFFSET + 1] = 0 as u8
        arena[RAM_SENTINEL_OFFSET + 2] = 0 as u8
        arena[RAM_SENTINEL_OFFSET + 3] = 0 as u8
        # REG block (CMD/ARG0/ARG1/STATUS/RESULT/SEQ_ID/TRIGGER): defensive
        # hygiene for the separate A2 interactive-mailbox register file this
        # design does not use (see module docstring) -- confirmed via
        # ref_vm.spl to have no bearing on record.seq semantics.
        var reg_i = 0
        while reg_i < REG_BLOCK_SIZE:
            arena[REG_BASE_OFFSET + reg_i] = 0 as u8
            reg_i = reg_i + 1
        arena[LOG_HEAD_OFFSET + 0] = 0 as u8
        arena[LOG_HEAD_OFFSET + 1] = 0 as u8
        arena[LOG_HEAD_OFFSET + 2] = 0 as u8
        arena[LOG_HEAD_OFFSET + 3] = 0 as u8
        arena[LOG_CAP_OFFSET + 0] = (DEFAULT_LOG_CAP & 0xFF) as u8
        arena[LOG_CAP_OFFSET + 1] = ((DEFAULT_LOG_CAP >> 8) & 0xFF) as u8
        arena[LOG_CAP_OFFSET + 2] = ((DEFAULT_LOG_CAP >> 16) & 0xFF) as u8
        arena[LOG_CAP_OFFSET + 3] = ((DEFAULT_LOG_CAP >> 24) & 0xFF) as u8
        val record_base = LOG_DATA_OFFSET + DEFAULT_LOG_CAP
        var r = 0
        while r < _MAX_RECORDS * RECORD_SIZE:
            arena[record_base + r] = 0 as u8
            r = r + 1

        if not self.session.arena_write(arena):
            self.blocked_reason = "vulkan arena write failed"
            return cell_result_error("blocked: {self.blocked_reason}", 0)

        val dispatch_err = self.session.dispatch_once(1)
        if dispatch_err != "":
            # Fence timeout or VK_ERROR_DEVICE_LOST -- both fold to the same
            # sentinel/error at the VulkanLaneSession layer (see module
            # docstring). Either way: blocked until %reset.
            self.blocked_reason = "device lost or fence timeout: {dispatch_err}"
            return cell_result_error("blocked: {self.blocked_reason}", 0)

        val out_arena = self.session.arena_read(ARENA_TOTAL_SIZE)
        if out_arena.len() != ARENA_TOTAL_SIZE:
            self.blocked_reason = "vulkan arena readback short"
            return cell_result_error("blocked: {self.blocked_reason}", 0)

        # Persist for the next cell's DATA region.
        self.last_arena = out_arena

        val sentinel = read_sentinel(out_arena)
        val log_text = read_log(out_arena)
        val records = read_records(out_arena, _MAX_RECORDS)
        val (trapped, exit_code) = _decode_exit(sentinel)

        var record_texts: [text] = []
        for rec in records:
            record_texts.push("seq={rec.seq} passed={rec.passed} value={rec.value}")

        val end_us = time_now_unix_micros()
        val duration_ms = (end_us - start_us) / 1000

        CellResult(
            stdout_delta: log_text,
            display_data: [],
            records: record_texts,
            error: if trapped: "trap: sentinel=0x{sentinel} exit_code={exit_code}" else: "",
            duration_ms: duration_ms,
        )

    me interrupt():
        """design §4.5: interrupt = fence-timeout path. No async cancel
        channel exists below `dispatch_once`'s own synchronous
        submit-and-wait (same limitation `RemoteExec.interrupt()`
        documents) -- escalates straight to the session-blocked state,
        cleared only by %reset."""
        self.blocked_reason = "session interrupted — use %reset to reconnect"

    me reset():
        """%reset (design §4.5 "blocked until %reset"): best-effort release
        of the old session's quarantined resources, then a genuinely NEW
        VulkanLaneSession + re-init -- never retry-loops on a possibly-
        wedged session object."""
        val _cleanup_retry = self.session.retry_terminal_completion()
        val _cleanup_shutdown = self.session.shutdown()
        self.session = VulkanLaneSession.create()
        self.initialized = false
        self.last_arena = []
        self._establish()

    me shutdown():
        if self.initialized:
            val _cleanup_retry = self.session.retry_terminal_completion()
            val _shutdown_err = self.session.shutdown()
        self.initialized = false

# ============================================================================
# VulkanExecFactory — one VulkanExec per (session, mode_spec) cache entry.
# ============================================================================

class VulkanExecFactory:
    """Stateless factory -- every session's VulkanExec is fresh from
    VulkanExec.make(mode_spec), matching RemoteExecFactory's/
    LocalExecFactory's shape."""

impl NotebookExecutorFactory for VulkanExecFactory:
    me create(mode_spec: text) -> NotebookExecutor:
        VulkanExec.make(mode_spec)

export VulkanExec, VulkanExecFactory
