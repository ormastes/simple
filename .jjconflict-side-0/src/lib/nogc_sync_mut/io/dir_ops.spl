# Directory Operations - Pure Simple I/O
# Extracted from mod.spl for modularity

# Extern fn declarations (runtime resolves at file level)

@unsafe(reason: "raw directory-create ABI; false is the explicit provider failure status", capabilities: [ffi])
extern fn rt_dir_create(path: text, recursive: bool) -> bool
@unsafe(reason: "raw directory-remove ABI; false is the explicit provider failure status", capabilities: [ffi])
extern fn rt_dir_remove(path: text, recursive: bool) -> bool
@unsafe(reason: "raw recursive directory-remove ABI; false is the explicit provider failure status", capabilities: [ffi])
extern fn rt_dir_remove_all(path: text) -> bool
@unsafe(reason: "legacy directory-walk ABI cannot distinguish an empty directory from provider failure", capabilities: [ffi])
extern fn rt_dir_walk(path: text) -> [text]
use std.io_runtime.{process_run}

@always_inline
fn _dir_create_raw(path: text, recursive: bool) -> bool:
    unsafe(capabilities: [ffi]):
        rt_dir_create(path, recursive)

@always_inline
fn _dir_remove_raw(path: text, recursive: bool) -> bool:
    unsafe(capabilities: [ffi]):
        rt_dir_remove(path, recursive)

@always_inline
fn _dir_remove_all_raw(path: text) -> bool:
    unsafe(capabilities: [ffi]):
        rt_dir_remove_all(path)

@always_inline
fn _dir_walk_raw(path: text) -> [text]:
    unsafe(capabilities: [ffi]):
        rt_dir_walk(path)

# --- Shell helpers (local copies to avoid circular imports) ---

fn _dir_shell(command: text) -> (text, text, i64):
    process_run("/bin/sh", ["-c", command])

fn _dir_shell_bool(command: text) -> bool:
    val (out, err, code) = _dir_shell(command)
    code == 0

fn _dir_shell_lines(command: text) -> [text]:
    val (out, err, code) = _dir_shell(command)
    var trimmed = out.trim()
    if code == 0 and trimmed.len() > 0:
        trimmed.split("\n")
    else:
        []

# ============================================================================
# Directory Operations
# ============================================================================

fn dir_create(path: text, recursive: bool) -> bool:
    _dir_create_raw(path, recursive)

fn dir_create_all(path: text) -> bool:
    dir_create(path, true)

fn dir_walk(path: text) -> [text]:
    val (out, err, code) = _dir_shell("find '{path}' -type f 2>/dev/null | sort")
    if code == 0:
        var trimmed = out.trim()
        if trimmed != "":
            return trimmed.split("\n")
    []

@unsafe(reason: "legacy native walk collapses provider failure to an empty array", capabilities: [ffi])
fn dir_walk_native(path: text) -> [text]:
    _dir_walk_raw(path)

fn dir_remove_all(path: text) -> bool:
    _dir_remove_all_raw(path)

fn is_dir(path: text) -> bool:
    _dir_shell_bool("test -d '{path}'")

fn dir_list(path: text) -> [text]:
    _dir_shell_lines("ls -1 '{path}' 2>/dev/null")

fn dir_remove(path: text, recursive: bool) -> bool:
    if recursive:
        return dir_remove_all(path)
    _dir_remove_raw(path, false)
