# Compatibility facade over the canonical cached LLVM SFFI owner.
# Re-exporting preserves the existing pointer cache and adds no call layer.
export use std.nogc_sync_mut.sffi.llvm_loader.{
    llvm_load, llvm_available, llvm_lib, _llvm_resolve, _lc0, _lc1,
    _lc2, _lc3, _lc4, _lcn, llvm_make_array, llvm_free_array,
    rt_alloc, rt_free, rt_ptr_write_i64, rt_ptr_read_i64
}
