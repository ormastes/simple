# Pure-Simple verifier for the hash-based script-signing scheme
# `wots-merkle-sha256-w16-h8` (WOTS w=16 under a Merkle tree of height 8,
# SHA-256 only). Byte-exact counterpart of scripts/trust/pq-sign-lib.shs —
# the two MUST agree byte-for-byte; the contract lives in that file's header
# and in doc/07_guide/infra/security/pq_script_signing.md.
#
# Verification only. Signing and keygen are shell-side; no secret ever
# reaches this module.

use std.common.crypto.sha256.{sha256_u8_hex}
use std.io_runtime.{file_read, file_read_bytes, file_exists}

pub val SCRIPT_SIG_ALG: text = "wots-merkle-sha256-w16-h8"

val SS_CHAINS: i64 = 67
val SS_TREE_HEIGHT: i64 = 8
val SS_LEAVES: i64 = 256
val SS_W_MAX: i64 = 15

pub struct ScriptSignatureResult:
    valid: bool
    reason: text
    leaf: i64
    key_id: text

fn ss_result(valid: bool, reason: text, leaf: i64, key_id: text) -> ScriptSignatureResult:
    ScriptSignatureResult(valid: valid, reason: reason, leaf: leaf, key_id: key_id)

fn ss_fail(reason: text) -> ScriptSignatureResult:
    ss_result(false, reason, -1, "")

# --- hex helpers -------------------------------------------------------------

fn ss_hex_digit(code: i64) -> i64:
    if code >= 48 and code <= 57:
        return code - 48
    if code >= 97 and code <= 102:
        return code - 97 + 10
    -1

fn ss_is_hex(s: text) -> bool:
    var i = 0
    val n = s.len()
    while i < n:
        if ss_hex_digit(s[i].ord()) < 0:
            return false
        i = i + 1
    true

# Append the bytes encoded by lowercase hex `s` onto `out` (single owner, no
# temp-alias mutation). Caller has validated the hex.
fn ss_push_hex(out: [u8], s: text):
    var i = 0
    val n = s.len()
    while i + 1 < n:
        val hi = ss_hex_digit(s[i].ord())
        val lo = ss_hex_digit(s[i + 1].ord())
        out.push((hi * 16 + lo) as u8)
        i = i + 2

fn ss_push_text_ascii(out: [u8], s: text):
    var i = 0
    val n = s.len()
    while i < n:
        out.push(s[i].ord() as u8)
        i = i + 1

# --- domain-separated hashes -------------------------------------------------

# F(x) = H("wots-f" || pub_seed || x); returns lowercase hex.
fn ss_chain_step(pub_seed_hex: text, x_hex: text) -> text:
    var buf: [u8] = []
    ss_push_text_ascii(buf, "wots-f")
    ss_push_hex(buf, pub_seed_hex)
    ss_push_hex(buf, x_hex)
    sha256_u8_hex(buf)

fn ss_chain_steps(pub_seed_hex: text, x_hex: text, count: i64) -> text:
    var x = x_hex
    var k = 0
    while k < count:
        x = ss_chain_step(pub_seed_hex, x)
        k = k + 1
    x

fn ss_node(left_hex: text, right_hex: text) -> text:
    var buf: [u8] = []
    ss_push_text_ascii(buf, "node")
    ss_push_hex(buf, left_hex)
    ss_push_hex(buf, right_hex)
    sha256_u8_hex(buf)

# m = H("msg" || script bytes)
fn ss_message_digest(script_bytes: [u8]) -> text:
    var buf: [u8] = []
    ss_push_text_ascii(buf, "msg")
    var i = 0
    val n = script_bytes.len()
    while i < n:
        buf.push(script_bytes[i])
        i = i + 1
    sha256_u8_hex(buf)

# 64 message nibbles (high first) + 3 checksum nibbles (12-bit big-endian).
fn ss_digits(digest_hex: text) -> [i64]:
    var digits: [i64] = []
    var sum = 0
    var i = 0
    while i < 64:
        val v = ss_hex_digit(digest_hex[i].ord())
        digits.push(v)
        sum = sum + (15 - v)
        i = i + 1
    digits.push((sum / 256) % 16)
    digits.push((sum / 16) % 16)
    digits.push(sum % 16)
    digits

# --- key=value text parsing --------------------------------------------------

fn ss_kv(content: text, key: text) -> text:
    val prefix = key + "="
    val lines = content.split("\n")
    var i = 0
    val n = lines.len()
    while i < n:
        val line = lines[i].trim()
        if line.starts_with(prefix):
            return line.substring(prefix.len(), line.len())
        i = i + 1
    ""

fn ss_parse_leaf(s: text) -> i64:
    if s.len() == 0 or s.len() > 3:
        return -1
    var v = 0
    var i = 0
    while i < s.len():
        val c = s[i].ord()
        if c < 48 or c > 57:
            return -1
        v = v * 10 + (c - 48)
        i = i + 1
    v

# --- verification ------------------------------------------------------------

# Verify raw script bytes against .sig text and .pub text (already read).
pub fn script_signature_verify(script_bytes: [u8], sig_text: text, pub_text: text) -> ScriptSignatureResult:
    val alg = ss_kv(sig_text, "alg")
    if alg != SCRIPT_SIG_ALG:
        return ss_fail("unsupported alg '" + alg + "'")
    if ss_kv(pub_text, "alg") != SCRIPT_SIG_ALG:
        return ss_fail("public root alg mismatch")

    val key_id = ss_kv(sig_text, "key_id")
    val pub_key_id = ss_kv(pub_text, "key_id")
    if key_id.len() == 0 or key_id != pub_key_id:
        return ss_fail("key_id mismatch")

    val root = ss_kv(pub_text, "root")
    val pub_seed = ss_kv(pub_text, "pub_seed")
    if root.len() != 64 or not ss_is_hex(root):
        return ss_fail("public root malformed")
    if pub_seed.len() != 64 or not ss_is_hex(pub_seed):
        return ss_fail("pub_seed malformed")

    val leaf = ss_parse_leaf(ss_kv(sig_text, "leaf"))
    if leaf < 0 or leaf >= SS_LEAVES:
        return ss_fail("leaf out of range")

    val sig_hex = ss_kv(sig_text, "sig")
    val auth_hex = ss_kv(sig_text, "auth")
    if sig_hex.len() != SS_CHAINS * 64 or not ss_is_hex(sig_hex):
        return ss_fail("sig malformed")
    if auth_hex.len() != SS_TREE_HEIGHT * 64 or not ss_is_hex(auth_hex):
        return ss_fail("auth malformed")

    val digits = ss_digits(ss_message_digest(script_bytes))

    # Recover each chain endpoint pk_j = F^{15-b_j}(sig_j), hash the leaf.
    var leaf_buf: [u8] = []
    ss_push_text_ascii(leaf_buf, "wots-pk")
    var j = 0
    while j < SS_CHAINS:
        val sig_j = sig_hex.substring(j * 64, j * 64 + 64)
        val pk_j = ss_chain_steps(pub_seed, sig_j, SS_W_MAX - digits[j])
        ss_push_hex(leaf_buf, pk_j)
        j = j + 1
    var node = sha256_u8_hex(leaf_buf)

    # Climb the tree: bit k of the leaf index 0 => our node is the left child.
    var idx = leaf
    var level = 0
    while level < SS_TREE_HEIGHT:
        val sibling = auth_hex.substring(level * 64, level * 64 + 64)
        if idx % 2 == 0:
            node = ss_node(node, sibling)
        else:
            node = ss_node(sibling, node)
        idx = idx / 2
        level = level + 1

    if node != root:
        return ss_fail("root mismatch")
    ss_result(true, "ok", leaf, key_id)

# Convenience: verify script FILE against FILE.sig under a .pub path.
pub fn script_signature_verify_file(script_path: text, pub_path: text) -> ScriptSignatureResult:
    if not file_exists(script_path):
        return ss_fail("script missing")
    val sig_path = script_path + ".sig"
    if not file_exists(sig_path):
        return ss_fail("signature file missing")
    if not file_exists(pub_path):
        return ss_fail("public root file missing")
    val script_bytes = file_read_bytes(script_path)
    script_signature_verify(script_bytes, file_read(sig_path), file_read(pub_path))

export ScriptSignatureResult, SCRIPT_SIG_ALG
export script_signature_verify, script_signature_verify_file
