# std.play.xvfb — Linux Xvfb wrapper
#
# Mirrors scripts/t32_host_bootstrap.shs:65-82 (t32_run_xvfb) for use from
# Simple code. On macOS and Windows this module is a no-op; on Linux it
# auto-wraps commands in `xvfb-run -a` when DISPLAY is not set.

use std.io_runtime.{env_get}
use std.io_runtime.{dir_exists}
use std.io_runtime.{file_exists}
use std.io_runtime.{process_run}
# SELF-RECURSION FIX (2026-09-03): importing `is_windows` into a file that also
# DEFINES `is_windows` makes the AOT lowering bind the alias to the LOCAL
# definition -- a silent infinite self-call (stack overflow), which is what
# killed the Windows MSVC stage 2 candidate. Import the underlying resolver
# `detect_os`, whose bare name collides with nothing here; `env.platform`s
# `is_windows` is literally `detect_os() == "windows"`, so semantics are
# unchanged. Compiler defect:
# doc/08_tracking/bug/aliased_import_shadowed_by_local_fn_native_codegen_2026-09-03.md
use std.nogc_sync_mut.env.platform.{detect_os as platform_detect_os}

fn is_linux() -> bool:
    val uname = process_run("uname", ["-s"])
    uname.0.trim() == "Linux"

fn is_macos() -> bool:
    val uname = process_run("uname", ["-s"])
    uname.0.trim() == "Darwin"

# FAIL-OPEN FIX (2026-09-02): this read ONLY `OS` and returned false when it was
# unset -- i.e. it silently assumed non-Windows under a stripped environment,
# which is exactly where a bootstrap runs. Delegate to the single resolver in
# std.nogc_sync_mut.env.platform, which consults the in-process
# rt_platform_name() primitive first and needs no environment at all.
fn is_windows() -> bool:
    platform_detect_os() == "windows"

fn display_is_set() -> bool:
    val d = env_get("DISPLAY")
    if d == "" or d == nil: false else: true

fn needs_xvfb() -> bool:
    """True iff we're on Linux without an existing DISPLAY."""
    if not is_linux(): return false
    if display_is_set(): return false
    true

fn xvfb_run_available() -> bool:
    val check = process_run("which", ["xvfb-run"])
    check.2 == 0 and check.0.trim() != ""

fn wrap_cmd(cmd: text, args: [text]) -> (text, [text]):
    """If we need Xvfb, return (xvfb-run, ["-a", cmd, ...args]).
    Otherwise return (cmd, args) unchanged."""
    if not needs_xvfb():
        return (cmd, args)
    if not xvfb_run_available():
        return (cmd, args)
    var wrapped: [text] = ["-a"]
    # Check for font path (matches t32_setup_xvfb_args)
    val font_dir = env_get("T32_FONT_DIR")
    if font_dir != "" and font_dir != nil:
        if dir_exists(font_dir) and file_exists(font_dir + "/fonts.dir"):
            wrapped.push("-s")
            wrapped.push("-fp " + font_dir)
    wrapped.push(cmd)
    for a in args:
        wrapped.push(a)
    ("xvfb-run", wrapped)

fn maybe_wrap_cmd(cmd: text, args: [text], force_xvfb: bool) -> (text, [text]):
    """Like wrap_cmd but force_xvfb=true forces wrapping on Linux regardless
    of DISPLAY (useful for CI where a real display exists but we want Xvfb)."""
    if force_xvfb and is_linux() and xvfb_run_available():
        var wrapped: [text] = ["-a", cmd]
        for a in args:
            wrapped.push(a)
        return ("xvfb-run", wrapped)
    wrap_cmd(cmd, args)
