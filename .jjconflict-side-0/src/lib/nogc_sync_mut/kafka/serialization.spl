# Apache Kafka Serialization Module
# Serialization and compression utilities

import kafka.types
use std.common.encoding.utf8.{utf8_decode_all, text_from_codepoints}

# ============================================================================
# Compression Utilities
# ============================================================================

fn compression_codec_to_string(codec: i64) -> text:
    if codec == 0:
        return "none"
    if codec == 1:
        return "gzip"
    if codec == 2:
        return "snappy"
    if codec == 3:
        return "lz4"
    if codec == 4:
        return "zstd"
    "unknown"

fn compression_codec_from_string(codec_name: text) -> i64:
    if codec_name == "none":
        return 0
    if codec_name == "gzip":
        return 1
    if codec_name == "snappy":
        return 2
    if codec_name == "lz4":
        return 3
    if codec_name == "zstd":
        return 4
    0

fn is_valid_compression_codec(codec: i64) -> bool:
    var valid = codec == 0
    if codec == 1:
        valid = true
    if codec == 2:
        valid = true
    if codec == 3:
        valid = true
    if codec == 4:
        valid = true
    valid

# ============================================================================
# Varint Encoding Utilities
# ============================================================================

# Encode unsigned varint (used in Kafka protocol)
#
# `list`-typed params/returns retyped to `[i64]` throughout this file (byte
# values 0-255): a bare `: list` parameter/return corrupts indexed element
# reads under the default engine (JIT/native codegen) -- `list` resolves to
# `HirType::Array { element: ANY }`, so the compiler has no static evidence
# the elements are integers and skips the UnboxInt decode that a concrete
# `[i64]` type gets; the read returns the raw tag-boxed word (e.g. 5 reads
# back as 40 = 5<<3). Root-caused via a MIR dump: `[i64]` reads emit
# `Call rt_array_get` -> `UnboxInt` -> use; `list` reads emit
# `Call rt_array_get` -> use directly, no UnboxInt. See
# doc/08_tracking/bug/untyped_list_element_read_seed_rootcause_2026-07-30.md.
# Interpreter is unaffected (dynamic per-value tag dispatch).
fn encode_varint_unsigned(value: i64) -> [i64]:
    var result: [i64] = []
    var remaining = value
    var continue_encoding = true

    if remaining == 0:
        return [0]

    # Encode 7 bits at a time
    while continue_encoding:
        var byte_val = remaining % 128
        remaining = remaining / 128

        if remaining > 0:
            byte_val = byte_val + 128

        result.push(byte_val)

        if remaining == 0:
            continue_encoding = false

    result

# Decode unsigned varint
fn decode_varint_unsigned(bytes: [i64]) -> i64:
    var result = 0
    var shift = 0
    var idx = 0
    var byte_count = 0

    # Safety: limit to 10 bytes maximum
    while byte_count < 10:
        if idx >= bytes.len():
            return result

        var byte_val = bytes[idx]
        var value_bits = byte_val % 128
        result = result + (value_bits * (2 ** shift))

        idx = idx + 1
        byte_count = byte_count + 1
        shift = shift + 7

        # Check if this is the last byte
        if byte_val < 128:
            return result

    result

# Encode signed varint using zigzag encoding
fn encode_varint_signed(value: i64) -> [i64]:
    var zigzag = 0
    if value >= 0:
        zigzag = value * 2
    if value < 0:
        zigzag = (value * -2) - 1
    encode_varint_unsigned(zigzag)

# Decode signed varint using zigzag encoding
fn decode_varint_signed(bytes: [i64]) -> i64:
    var zigzag = decode_varint_unsigned(bytes)
    var is_negative = (zigzag % 2) == 1

    if is_negative:
        return (zigzag + 1) / -2

    zigzag / 2

# ============================================================================
# CRC32 Calculation
# ============================================================================

# Simple CRC32 implementation for Kafka message integrity
# Using standard CRC32 polynomial: 0xEDB88320
#
# Full standard 256-entry lookup table. Was truncated to only the first 64
# entries, but crc32_calculate indexes it with `table_idx = (crc ^
# byte_val) % 256` (range 0-255) -- a real, previously undetected, severe
# bug unrelated to the `list`/`[i64]` typing question: under
# SIMPLE_EXECUTION_MODE=interpret this was a hard, bounds-checked crash
# (`array index out of bounds: index is N but length is 64`) for any
# byte_val/crc combination whose lookup index landed >= 64 (i.e. most
# real inputs -- byte_val alone is uniform 0-255, so ~75% of single bytes
# already miss); under the default engine it silently read past the end
# of the array and returned a wrong CRC with no error at all. Regenerated
# via the standard bit-reversed CRC-32 (polynomial 0xEDB88320) table
# construction (256 iterations, each running the 8-shift reduction loop) --
# derivable from the polynomial alone, not copied from any external
# source -- and verified against `zlib.crc32` for "" / "123456789" /
# 100 sequential a's / bytes(range(256)).
fn crc32_table() -> [i64]:
    [
        0x00000000, 0x77073096, 0xEE0E612C, 0x990951BA, 0x076DC419, 0x706AF48F,
        0xE963A535, 0x9E6495A3, 0x0EDB8832, 0x79DCB8A4, 0xE0D5E91E, 0x97D2D988,
        0x09B64C2B, 0x7EB17CBD, 0xE7B82D07, 0x90BF1D91, 0x1DB71064, 0x6AB020F2,
        0xF3B97148, 0x84BE41DE, 0x1ADAD47D, 0x6DDDE4EB, 0xF4D4B551, 0x83D385C7,
        0x136C9856, 0x646BA8C0, 0xFD62F97A, 0x8A65C9EC, 0x14015C4F, 0x63066CD9,
        0xFA0F3D63, 0x8D080DF5, 0x3B6E20C8, 0x4C69105E, 0xD56041E4, 0xA2677172,
        0x3C03E4D1, 0x4B04D447, 0xD20D85FD, 0xA50AB56B, 0x35B5A8FA, 0x42B2986C,
        0xDBBBC9D6, 0xACBCF940, 0x32D86CE3, 0x45DF5C75, 0xDCD60DCF, 0xABD13D59,
        0x26D930AC, 0x51DE003A, 0xC8D75180, 0xBFD06116, 0x21B4F4B5, 0x56B3C423,
        0xCFBA9599, 0xB8BDA50F, 0x2802B89E, 0x5F058808, 0xC60CD9B2, 0xB10BE924,
        0x2F6F7C87, 0x58684C11, 0xC1611DAB, 0xB6662D3D, 0x76DC4190, 0x01DB7106,
        0x98D220BC, 0xEFD5102A, 0x71B18589, 0x06B6B51F, 0x9FBFE4A5, 0xE8B8D433,
        0x7807C9A2, 0x0F00F934, 0x9609A88E, 0xE10E9818, 0x7F6A0DBB, 0x086D3D2D,
        0x91646C97, 0xE6635C01, 0x6B6B51F4, 0x1C6C6162, 0x856530D8, 0xF262004E,
        0x6C0695ED, 0x1B01A57B, 0x8208F4C1, 0xF50FC457, 0x65B0D9C6, 0x12B7E950,
        0x8BBEB8EA, 0xFCB9887C, 0x62DD1DDF, 0x15DA2D49, 0x8CD37CF3, 0xFBD44C65,
        0x4DB26158, 0x3AB551CE, 0xA3BC0074, 0xD4BB30E2, 0x4ADFA541, 0x3DD895D7,
        0xA4D1C46D, 0xD3D6F4FB, 0x4369E96A, 0x346ED9FC, 0xAD678846, 0xDA60B8D0,
        0x44042D73, 0x33031DE5, 0xAA0A4C5F, 0xDD0D7CC9, 0x5005713C, 0x270241AA,
        0xBE0B1010, 0xC90C2086, 0x5768B525, 0x206F85B3, 0xB966D409, 0xCE61E49F,
        0x5EDEF90E, 0x29D9C998, 0xB0D09822, 0xC7D7A8B4, 0x59B33D17, 0x2EB40D81,
        0xB7BD5C3B, 0xC0BA6CAD, 0xEDB88320, 0x9ABFB3B6, 0x03B6E20C, 0x74B1D29A,
        0xEAD54739, 0x9DD277AF, 0x04DB2615, 0x73DC1683, 0xE3630B12, 0x94643B84,
        0x0D6D6A3E, 0x7A6A5AA8, 0xE40ECF0B, 0x9309FF9D, 0x0A00AE27, 0x7D079EB1,
        0xF00F9344, 0x8708A3D2, 0x1E01F268, 0x6906C2FE, 0xF762575D, 0x806567CB,
        0x196C3671, 0x6E6B06E7, 0xFED41B76, 0x89D32BE0, 0x10DA7A5A, 0x67DD4ACC,
        0xF9B9DF6F, 0x8EBEEFF9, 0x17B7BE43, 0x60B08ED5, 0xD6D6A3E8, 0xA1D1937E,
        0x38D8C2C4, 0x4FDFF252, 0xD1BB67F1, 0xA6BC5767, 0x3FB506DD, 0x48B2364B,
        0xD80D2BDA, 0xAF0A1B4C, 0x36034AF6, 0x41047A60, 0xDF60EFC3, 0xA867DF55,
        0x316E8EEF, 0x4669BE79, 0xCB61B38C, 0xBC66831A, 0x256FD2A0, 0x5268E236,
        0xCC0C7795, 0xBB0B4703, 0x220216B9, 0x5505262F, 0xC5BA3BBE, 0xB2BD0B28,
        0x2BB45A92, 0x5CB36A04, 0xC2D7FFA7, 0xB5D0CF31, 0x2CD99E8B, 0x5BDEAE1D,
        0x9B64C2B0, 0xEC63F226, 0x756AA39C, 0x026D930A, 0x9C0906A9, 0xEB0E363F,
        0x72076785, 0x05005713, 0x95BF4A82, 0xE2B87A14, 0x7BB12BAE, 0x0CB61B38,
        0x92D28E9B, 0xE5D5BE0D, 0x7CDCEFB7, 0x0BDBDF21, 0x86D3D2D4, 0xF1D4E242,
        0x68DDB3F8, 0x1FDA836E, 0x81BE16CD, 0xF6B9265B, 0x6FB077E1, 0x18B74777,
        0x88085AE6, 0xFF0F6A70, 0x66063BCA, 0x11010B5C, 0x8F659EFF, 0xF862AE69,
        0x616BFFD3, 0x166CCF45, 0xA00AE278, 0xD70DD2EE, 0x4E048354, 0x3903B3C2,
        0xA7672661, 0xD06016F7, 0x4969474D, 0x3E6E77DB, 0xAED16A4A, 0xD9D65ADC,
        0x40DF0B66, 0x37D83BF0, 0xA9BCAE53, 0xDEBB9EC5, 0x47B2CF7F, 0x30B5FFE9,
        0xBDBDF21C, 0xCABAC28A, 0x53B39330, 0x24B4A3A6, 0xBAD03605, 0xCDD70693,
        0x54DE5729, 0x23D967BF, 0xB3667A2E, 0xC4614AB8, 0x5D681B02, 0x2A6F2B94,
        0xB40BBE37, 0xC30C8EA1, 0x5A05DF1B, 0x2D02EF8D
    ]

fn crc32_calculate(data: text) -> i64:
    var table: [i64] = crc32_table()
    var crc = 0xFFFFFFFF
    var idx = 0
    var data_len = data.len()
    # Byte-indexed via .bytes(), not single-index `data[idx].ord()`.
    # `data_len` is a BYTE count (.len()) but plain single-index text
    # access is CHARACTER-indexed (confirmed: "café"[3] is the whole
    # 2-byte "é", .ord()=233, not a byte) -- for multi-byte message keys/
    # values `idx` ran out of characters before reaching `data_len` bytes.
    # Also a correctness requirement, not just a crash-avoidance one: CRC32
    # is a wire-integrity check computed by a real Kafka broker over the
    # actual UTF-8 bytes on the wire, not over Unicode codepoint values --
    # even where it didn't crash, a codepoint-based CRC would silently
    # disagree with the broker's byte-based one for any non-ASCII content.
    var data_bytes = data.bytes()

    while idx < data_len:
        var byte_val = data_bytes[idx]
        var table_idx = (crc ^ byte_val) % 256
        crc = (crc / 256) ^ table[table_idx]
        idx = idx + 1

    crc ^ 0xFFFFFFFF

fn crc32_verify(data: text, expected_crc: i64) -> bool:
    var calculated = crc32_calculate(data)
    calculated == expected_crc

# ============================================================================
# Serialization Utilities
# ============================================================================

# Convert i64 to 4-byte representation (big-endian)
fn int32_to_bytes(value: i64) -> [i64]:
    var byte0 = (value / 16777216) % 256
    var byte1 = (value / 65536) % 256
    var byte2 = (value / 256) % 256
    var byte3 = value % 256
    [byte0, byte1, byte2, byte3]

# Convert i64 to 8-byte representation (big-endian)
fn int64_to_bytes(value: i64) -> [i64]:
    var upper = value / 4294967296
    var lower = value % 4294967296
    var bytes_upper = int32_to_bytes(upper)
    var bytes_lower = int32_to_bytes(lower)
    bytes_upper + bytes_lower

# Convert 4 bytes to i64 (big-endian)
fn bytes_to_int32(bytes: [i64]) -> i64:
    if bytes.len() < 4:
        return 0
    var result = bytes[0] * 16777216
    result = result + (bytes[1] * 65536)
    result = result + (bytes[2] * 256)
    result = result + bytes[3]
    result

# Convert 8 bytes to i64 (big-endian)
fn bytes_to_int64(bytes: [i64]) -> i64:
    if bytes.len() < 8:
        return 0
    var upper_bytes: [i64] = [bytes[0], bytes[1], bytes[2], bytes[3]]
    var lower_bytes: [i64] = [bytes[4], bytes[5], bytes[6], bytes[7]]
    var upper = bytes_to_int32(upper_bytes)
    var lower = bytes_to_int32(lower_bytes)
    (upper * 4294967296) + lower

# Serialize text with length prefix
fn serialize_string(value: text) -> [i64]:
    var length = value.len()
    var length_bytes: [i64] = int32_to_bytes(length)
    var result: [i64] = length_bytes
    var idx = 0
    # Byte-indexed via .bytes(), not single-index `value[idx].ord()` -- see
    # crc32_calculate above for the full explanation. The 4-byte length
    # prefix above already committed to a BYTE count, so the payload must
    # be that many wire bytes.
    var value_bytes = value.bytes()

    while idx < length:
        result.push(value_bytes[idx])
        idx = idx + 1

    result

# Deserialize text with length prefix
fn deserialize_string(bytes: [i64], offset: i64) -> text:
    if offset < 0:
        return ""
    if offset + 4 > bytes.len():
        return ""

    var length_bytes: [i64] = [bytes[offset], bytes[offset + 1], bytes[offset + 2], bytes[offset + 3]]
    var length = bytes_to_int32(length_bytes)

    if length <= 0:
        return ""

    if offset + 4 + length > bytes.len():
        return ""

    # Collect the raw wire bytes and UTF-8-decode them as a whole, not
    # `byte_val.chr()` per byte -- see mqtt_decode_string's fix note
    # (src/lib/*/mqtt/packet.spl) for the full explanation: .chr() treats
    # each raw byte as its own codepoint, which is only correct for ASCII
    # bytes and reconstructs mojibake for any multi-byte UTF-8 content.
    var raw_bytes: [i64] = []
    var idx = 0

    while idx < length:
        raw_bytes.push(bytes[offset + 4 + idx])
        idx = idx + 1

    text_from_codepoints(utf8_decode_all(raw_bytes))

