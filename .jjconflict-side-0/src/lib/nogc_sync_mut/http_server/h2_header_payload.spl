# HTTP/2 HEADERS payload envelope parsing (RFC 9113 section 6.2).
#
# HEADERS carries an HPACK fragment surrounded by an optional one-byte padding
# length, optional five-byte priority record, and trailing padding. Keeping
# this parser separate prevents envelope bytes from reaching HPACK decoding.

fn h2_header_payload_error(payload: [u8], flags: i64) -> text:
    var offset: i64 = 0
    var padding: i64 = 0
    if (flags & 8) != 0:
        if payload.len() == 0:
            return "PADDED HEADERS omitted the padding length"
        padding = payload[0]
        offset = 1
    if (flags & 32) != 0:
        if payload.len() - offset < 5:
            return "PRIORITY HEADERS omitted the five-byte priority record"
        offset = offset + 5
    if padding > payload.len() - offset:
        return "HEADERS padding exceeds its payload"
    ""

fn h2_header_payload_fragment(payload: [u8], flags: i64) -> [u8]:
    var offset: i64 = 0
    var padding: i64 = 0
    if (flags & 8) != 0:
        padding = payload[0]
        offset = 1
    if (flags & 32) != 0:
        offset = offset + 5
    val count = payload.len() - offset - padding
    var fragment: [u8] = []
    var i: i64 = 0
    while i < count:
        fragment.push(payload[offset + i])
        i = i + 1
    fragment

export h2_header_payload_error, h2_header_payload_fragment
