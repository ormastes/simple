# codex-impl

use std.tiny.common.event.{TinyEvent}
use std.tiny.common.abi.{TinyDrawStreamV1, TinyRenderedSurfaceV1}
use std.tiny.common.status.{TinyStatus}
use std.tiny.common.types.{TinyRect}

trait TinyPresentPortV1:
    fn width() -> i32
    fn height() -> i32
    me begin_frame(damage: [TinyRect], damage_count: i32) -> TinyStatus
    me present(surface: TinyRenderedSurfaceV1) -> TinyStatus

trait TinyInputPortV1:
    me poll_event() -> TinyEvent

trait Tiny2DBackendV1:
    fn width() -> i32
    fn height() -> i32
    fn capability_bits() -> i64
    me execute(stream: TinyDrawStreamV1) -> TinyStatus
    fn rendered_surface() -> TinyRenderedSurfaceV1
    fn checksum() -> i64

trait TinyWmPortV1:
    me set_root(content_id: i32) -> TinyStatus
    me open_popup(content_id: i32, bounds: TinyRect) -> TinyStatus
    me close_popup(content_id: i32) -> TinyStatus
    me dispatch(event: TinyEvent) -> TinyStatus
    me frame() -> TinyStatus

trait TinyWebHostPortV1:
    fn viewport_width() -> i32
    fn viewport_height() -> i32
    fn resource_bytes(resource_id: i32) -> [u8]

# Optional compatible extension: V1 cannot distinguish an admitted empty
# resource from a miss because both return an empty byte array.
trait TinyWebHostPortV2:
    fn viewport_width() -> i32
    fn viewport_height() -> i32
    fn resource_exists(resource_id: i32) -> bool
    fn resource_bytes(resource_id: i32) -> [u8]
