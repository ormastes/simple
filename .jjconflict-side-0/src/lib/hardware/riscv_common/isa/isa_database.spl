# Declarative RISC-V ISA capability metadata.
#
# These entries are host/elaboration metadata, never dynamic hardware state.
# RTL uses fixed-width operation functions selected before emission; tooling and
# product manifests use this table to avoid claiming a broader ISA than the
# verified implementation provides.

use compiler.common.mission_critical.riscv_zca_contracts.{riscv_zca_strict_isa_id, riscv_zca_strict_xlen_scope}

class RiscvIsaEntry:
    id: text
    extension: text
    xlen_scope: text
    semantic_class: text
    critical_subset_eligible: bool

class RiscvTargetRtlEvidence:
    """One row-level strict-HWIR target proof.

    This is compiler-host/tooling metadata, never emitted state.  It separates
    a semantic ISA row that is eligible for the critical subset from a row that
    has actually completed generated-RTL evidence.
    """
    id: text
    strict_contract: text
    xlen_scope: text

fn riscv_zca_critical_subset_entries() -> [RiscvIsaEntry]:
    [
        RiscvIsaEntry(id: "zca.c.addi4spn", extension: "Zca", xlen_scope: "rv32-rv64", semantic_class: "integer-immediate", critical_subset_eligible: true),
        RiscvIsaEntry(id: "zca.c.lw", extension: "Zca", xlen_scope: "rv32-rv64", semantic_class: "integer-load", critical_subset_eligible: true),
        RiscvIsaEntry(id: "zca.c.sw", extension: "Zca", xlen_scope: "rv32-rv64", semantic_class: "integer-store", critical_subset_eligible: true),
        RiscvIsaEntry(id: "zca.c.nop_addi", extension: "Zca", xlen_scope: "rv32-rv64", semantic_class: "integer-immediate", critical_subset_eligible: true),
        RiscvIsaEntry(id: "zca.c.li", extension: "Zca", xlen_scope: "rv32-rv64", semantic_class: "integer-immediate", critical_subset_eligible: true),
        RiscvIsaEntry(id: "zca.c.addi16sp", extension: "Zca", xlen_scope: "rv32-rv64", semantic_class: "stack-adjust", critical_subset_eligible: true),
        RiscvIsaEntry(id: "zca.c.lui", extension: "Zca", xlen_scope: "rv32-rv64", semantic_class: "integer-immediate", critical_subset_eligible: true),
        RiscvIsaEntry(id: "zca.c.srli", extension: "Zca", xlen_scope: "rv32-rv64-low-shamt", semantic_class: "integer-shift", critical_subset_eligible: true),
        RiscvIsaEntry(id: "zca.c.srai", extension: "Zca", xlen_scope: "rv32-rv64-low-shamt", semantic_class: "integer-shift", critical_subset_eligible: true),
        RiscvIsaEntry(id: "zca.c.andi", extension: "Zca", xlen_scope: "rv32-rv64", semantic_class: "integer-immediate", critical_subset_eligible: true),
        RiscvIsaEntry(id: "zca.c.sub", extension: "Zca", xlen_scope: "rv32-rv64", semantic_class: "integer-register", critical_subset_eligible: true),
        RiscvIsaEntry(id: "zca.c.xor", extension: "Zca", xlen_scope: "rv32-rv64", semantic_class: "integer-register", critical_subset_eligible: true),
        RiscvIsaEntry(id: "zca.c.or", extension: "Zca", xlen_scope: "rv32-rv64", semantic_class: "integer-register", critical_subset_eligible: true),
        RiscvIsaEntry(id: "zca.c.and", extension: "Zca", xlen_scope: "rv32-rv64", semantic_class: "integer-register", critical_subset_eligible: true),
        RiscvIsaEntry(id: "zca.c.j", extension: "Zca", xlen_scope: "rv32-rv64", semantic_class: "control-flow", critical_subset_eligible: true),
        RiscvIsaEntry(id: "zca.c.beqz", extension: "Zca", xlen_scope: "rv32-rv64", semantic_class: "control-flow", critical_subset_eligible: true),
        RiscvIsaEntry(id: "zca.c.bnez", extension: "Zca", xlen_scope: "rv32-rv64", semantic_class: "control-flow", critical_subset_eligible: true),
        RiscvIsaEntry(id: "zca.c.slli", extension: "Zca", xlen_scope: "rv32-rv64-low-shamt", semantic_class: "integer-shift", critical_subset_eligible: true),
        RiscvIsaEntry(id: "zca.c.lwsp", extension: "Zca", xlen_scope: "rv32-rv64", semantic_class: "integer-load", critical_subset_eligible: true),
        RiscvIsaEntry(id: "zca.c.swsp", extension: "Zca", xlen_scope: "rv32-rv64", semantic_class: "integer-store", critical_subset_eligible: true),
        RiscvIsaEntry(id: "zca.c.jr", extension: "Zca", xlen_scope: "rv32-rv64", semantic_class: "indirect-control", critical_subset_eligible: true),
        RiscvIsaEntry(id: "zca.c.mv", extension: "Zca", xlen_scope: "rv32-rv64", semantic_class: "integer-register", critical_subset_eligible: true),
        RiscvIsaEntry(id: "zca.c.jalr", extension: "Zca", xlen_scope: "rv32-rv64", semantic_class: "indirect-control", critical_subset_eligible: true),
        RiscvIsaEntry(id: "zca.c.add", extension: "Zca", xlen_scope: "rv32-rv64", semantic_class: "integer-register", critical_subset_eligible: true),
        RiscvIsaEntry(id: "zca.c.ebreak", extension: "Zca", xlen_scope: "rv32-rv64", semantic_class: "debug-trap", critical_subset_eligible: true)
    ]

fn riscv_zca_rv32_only_entries() -> [RiscvIsaEntry]:
    [
        RiscvIsaEntry(id: "zca.c.jal", extension: "Zca", xlen_scope: "rv32", semantic_class: "control-flow", critical_subset_eligible: false)
    ]

fn riscv_zca_rv64_only_entries() -> [RiscvIsaEntry]:
    [
        RiscvIsaEntry(id: "zca.c.ld", extension: "Zca", xlen_scope: "rv64", semantic_class: "integer-load", critical_subset_eligible: false),
        RiscvIsaEntry(id: "zca.c.sd", extension: "Zca", xlen_scope: "rv64", semantic_class: "integer-store", critical_subset_eligible: false),
        RiscvIsaEntry(id: "zca.c.addiw", extension: "Zca", xlen_scope: "rv64", semantic_class: "integer-word", critical_subset_eligible: false),
        RiscvIsaEntry(id: "zca.c.subw", extension: "Zca", xlen_scope: "rv64", semantic_class: "integer-word", critical_subset_eligible: false),
        RiscvIsaEntry(id: "zca.c.addw", extension: "Zca", xlen_scope: "rv64", semantic_class: "integer-word", critical_subset_eligible: false),
        RiscvIsaEntry(id: "zca.c.ldsp", extension: "Zca", xlen_scope: "rv64", semantic_class: "integer-load", critical_subset_eligible: false),
        RiscvIsaEntry(id: "zca.c.sdsp", extension: "Zca", xlen_scope: "rv64", semantic_class: "integer-store", critical_subset_eligible: false)
    ]

pub fn riscv_zca_integer_entries() -> [RiscvIsaEntry]:
    """The complete implemented RV32/RV64 integer-Zca capability table.

    This is elaboration metadata only. The fixed RV32/RV64 decoder entrypoints
    are selected by the product; this function does not introduce a runtime
    XLEN or extension selector into emitted hardware.
    """
    var entries = riscv_zca_critical_subset_entries()
    for entry in riscv_zca_rv32_only_entries():
        entries.push(entry)
    for entry in riscv_zca_rv64_only_entries():
        entries.push(entry)
    entries

pub fn riscv_zca_integer_entries_for_xlen(xlen: u32) -> [RiscvIsaEntry]:
    """Return the exact integer-Zca capability rows for one elaborated XLEN."""
    var entries = riscv_zca_critical_subset_entries()
    if xlen == 32:
        for entry in riscv_zca_rv32_only_entries():
            entries.push(entry)
    elif xlen == 64:
        for entry in riscv_zca_rv64_only_entries():
            entries.push(entry)
    else:
        return []
    entries

pub fn riscv_zca_target_rtl_evidence() -> [RiscvTargetRtlEvidence]:
    """Return only critical-Zca rows with completed strict-HWIR target evidence.

    Keep this list narrower than `riscv_zca_critical_subset_entries()`. A row
    becomes claimable here only after its typed graph, strict lowering route,
    and generated VHDL analysis/simulation are all present.
    """
    var evidence = [RiscvTargetRtlEvidence(id: "zca.c.ebreak", strict_contract: "terminal-decode-cebreak", xlen_scope: "rv32-rv64")]
    # This is deliberately an evidence allowlist, not a projection of the
    # strict contract catalog. Adding a lowerable row cannot advertise it;
    # its generated-target proof must add its reserved intrinsic here.
    val proven_contracts = [
        "__simple_riscv_zca_addi4spn_row_v1", "__simple_riscv_zca_lw_row_v1",
        "__simple_riscv_zca_sw_row_v1", "__simple_riscv_zca_lwsp_row_v1",
        "__simple_riscv_zca_swsp_row_v1", "__simple_riscv_zca_caddi_row_v1",
        "__simple_riscv_zca_caddi16sp_row_v1", "__simple_riscv_zca_clui_row_v1",
        "__simple_riscv_zca_cli_row_v1",
        "__simple_riscv_zca_slli_low_row_v1", "__simple_riscv_zca_srli_low_row_v1",
        "__simple_riscv_zca_srai_low_row_v1", "__simple_riscv_zca_candi_row_v1",
        "__simple_riscv_zca_csub_row_v1", "__simple_riscv_zca_cxor_row_v1",
        "__simple_riscv_zca_cor_row_v1", "__simple_riscv_zca_cand_row_v1",
        "__simple_riscv_zca_cj_predecode_v1",
        "__simple_riscv_zca_cbeqz_predecode_v1", "__simple_riscv_zca_cbnez_predecode_v1",
        "__simple_riscv_zca_cjr_row_v1", "__simple_riscv_zca_cmv_row_v1",
        "__simple_riscv_zca_cjalr_row_v1", "__simple_riscv_zca_cadd_row_v1"
    ]
    for strict_contract in proven_contracts:
        val id = riscv_zca_strict_isa_id(strict_contract)
        if id != "":
            evidence.push(RiscvTargetRtlEvidence(id: id, strict_contract: strict_contract, xlen_scope: riscv_zca_strict_xlen_scope(strict_contract)))
    evidence

pub fn riscv_zca_target_rtl_evidence_count() -> i32:
    riscv_zca_target_rtl_evidence().len() as i32

pub fn riscv_zca_critical_subset_has_entry(id: text) -> bool:
    for entry in riscv_zca_critical_subset_entries():
        if entry.id == id:
            return true
    false

pub fn riscv_zca_target_rtl_has_entry(id: text) -> bool:
    for entry in riscv_zca_target_rtl_evidence():
        if entry.id == id:
            return true
    false

pub fn riscv_zca_target_rtl_has_contract(strict_contract: text) -> bool:
    for entry in riscv_zca_target_rtl_evidence():
        if entry.strict_contract == strict_contract:
            return true
    false

pub fn riscv_zca_critical_subset_entry_count() -> i32:
    riscv_zca_critical_subset_entries().len() as i32
