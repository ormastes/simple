# Structural VHDL primitives for the bus-infrastructure RTL lot
# (AXI4 memory adapters, the AXI4-Lite ctrl/observation slave, and the
# BRAM-only SoC top). Sibling of gen_types.spl: same construction-API style
# (typed descriptor arrays elaborated at generator time), same determinism
# contract — arrays only, never a Dict, so repeated generation is
# byte-identical.
#
# These primitives cover the shapes the exec-core generator does not need:
#   * entities with NO generic clause (emit_entity_ports)
#   * signal declarations with group-local name AND type column widths
#   * concurrent/sequential assign blocks at an arbitrary indent
#   * generic `case <expr> is` blocks (state FSMs, register-map read muxes,
#     lane selects) with padded when-selectors
#   * labelled processes with variable declarations
#   * repeated declaration/process templates instantiated from a bank table

use std.hardware.vhdl_gen.gen_types.{VgPortSpec, VgAssign, vg_pad, vg_spaces, vg_append, no_lines}

# One signal declaration. The goldens align the name column and (within a
# group of vector signals) the type column too, while scalar `std_logic`
# members of the same group are NOT type-padded — a single `aligned` flag
# cannot express that, so each item carries its explicit field widths.
struct VgSignalSpec:
    pre_lines: [text]      # verbatim full lines emitted before the signal line
    name: text             # may be a comma list, e.g. "lane0, lane1"
    name_w: i64            # width of the name field before ": "
    ty: text
    ty_w: i64              # width of the type field before ":=" (ignored if init == "")
    init: text             # "" => declaration carries no initializer
    tail: text             # trailing text after the ";" (usually a -- comment)

# One `when <sel> =>` arm of a case statement.
struct VgCaseArm:
    pre_lines: [text]      # verbatim lines before the arm (comments/blanks)
    sel: text              # selector text, already quoted where VHDL needs it
    sel_w: i64             # width of the selector field before " =>" (0 = no pad)
    inline: text           # non-empty => single-line arm
    body: [text]           # verbatim arm body lines

fn bi_jl(lines: [text]) -> text:
    lines.join("\n")

fn bi_no_lines() -> [text]:
    var l: [text] = []
    l

fn bi_one(line: text) -> [text]:
    var l: [text] = []
    l = l.push(line)
    l

fn bi_two(a: text, b: text) -> [text]:
    var l: [text] = []
    l = l.push(a)
    l = l.push(b)
    l

fn bi_three(a: text, b: text, c: text) -> [text]:
    var l: [text] = []
    l = l.push(a)
    l = l.push(b)
    l = l.push(c)
    l

# `std_logic_vector(<hi> downto 0)`
fn bi_slv(hi: i64) -> text:
    "std_logic_vector(" + hi.to_text() + " downto 0)"

fn bi_unsigned(hi: i64) -> text:
    "unsigned(" + hi.to_text() + " downto 0)"

fn bi_port(pre: [text], name: text, name_w: i64, dir: text, dir_w: i64, ty: text) -> VgPortSpec:
    VgPortSpec(pre_comments: pre, name: name, name_w: name_w, dir: dir, dir_w: dir_w, ty: ty, default_val: "")

fn bi_sig(name: text, name_w: i64, ty: text, ty_w: i64, init: text) -> VgSignalSpec:
    VgSignalSpec(pre_lines: bi_no_lines(), name: name, name_w: name_w, ty: ty, ty_w: ty_w, init: init, tail: "")

fn bi_sig_pre(pre: [text], name: text, name_w: i64, ty: text, ty_w: i64, init: text) -> VgSignalSpec:
    VgSignalSpec(pre_lines: pre, name: name, name_w: name_w, ty: ty, ty_w: ty_w, init: init, tail: "")

fn bi_sig_tail(name: text, name_w: i64, ty: text, ty_w: i64, init: text, tail: text) -> VgSignalSpec:
    VgSignalSpec(pre_lines: bi_no_lines(), name: name, name_w: name_w, ty: ty, ty_w: ty_w, init: init, tail: tail)

# `v` rendered as an `nbits`-wide binary literal (register-map selectors).
fn bi_bin(v: i64, nbits: i64) -> text:
    var out = ""
    var i = nbits - 1
    while i >= 0:
        if (v >> i) & 1 == 1:
            out = out + "1"
        else:
            out = out + "0"
        i = i - 1
    out

fn bi_assign(lhs: text, rhs: text) -> VgAssign:
    VgAssign(pre_comments: bi_no_lines(), lhs: lhs, rhs: rhs)

fn bi_assign_pre(pre: [text], lhs: text, rhs: text) -> VgAssign:
    VgAssign(pre_comments: pre, lhs: lhs, rhs: rhs)

fn bi_arm(sel: text, body: [text]) -> VgCaseArm:
    VgCaseArm(pre_lines: bi_no_lines(), sel: sel, sel_w: 0, inline: "", body: body)

fn bi_arm_pre(pre: [text], sel: text, body: [text]) -> VgCaseArm:
    VgCaseArm(pre_lines: pre, sel: sel, sel_w: 0, inline: "", body: body)

fn bi_arm_inline(sel: text, sel_w: i64, inline: text) -> VgCaseArm:
    VgCaseArm(pre_lines: bi_no_lines(), sel: sel, sel_w: sel_w, inline: inline, body: bi_no_lines())

# Inline arm whose right-hand side wraps onto continuation lines.
fn bi_arm_wrapped(sel: text, inline: text, body: [text]) -> VgCaseArm:
    VgCaseArm(pre_lines: bi_no_lines(), sel: sel, sel_w: 0, inline: inline, body: body)

# Entity with a port clause only (no generics). emit_entity_spec in
# gen_types.spl always emits `generic (...)`, which the ctrl/obs slave has not
# got.
fn emit_entity_ports(name: text, ports: [VgPortSpec]) -> [text]:
    var l: [text] = []
    l = l.push("entity " + name + " is")
    l = l.push("  port (")
    var i = 0
    while i < ports.len():
        val p = ports[i]
        l = vg_append(l, p.pre_comments)
        var line = "    " + vg_pad(p.name, p.name_w) + ": " + vg_pad(p.dir, p.dir_w) + " " + p.ty
        if p.default_val != "":
            line = line + " := " + p.default_val
        if i < ports.len() - 1:
            line = line + ";"
        l = l.push(line)
        i = i + 1
    l = l.push("  );")
    l = l.push("end entity " + name + ";")
    l

fn emit_signal_decls(sigs: [VgSignalSpec]) -> [text]:
    var l: [text] = []
    var i = 0
    while i < sigs.len():
        val s = sigs[i]
        l = vg_append(l, s.pre_lines)
        var line = "  signal " + vg_pad(s.name, s.name_w) + ": "
        if s.init == "":
            line = line + s.ty + ";"
        else:
            line = line + vg_pad(s.ty, s.ty_w) + ":= " + s.init + ";"
        l = l.push(line + s.tail)
        i = i + 1
    l

# Assign block at an arbitrary indent with an explicit lhs column width.
fn emit_assigns_at(indent: i64, lhs_w: i64, assigns: [VgAssign]) -> [text]:
    val ind = vg_spaces(indent)
    var l: [text] = []
    var i = 0
    while i < assigns.len():
        val a = assigns[i]
        l = vg_append(l, a.pre_comments)
        l = l.push(ind + vg_pad(a.lhs, lhs_w) + " <= " + a.rhs + ";")
        i = i + 1
    l

# `case <sel> is` / when-arms / `end case;`. Arms sit 2 columns deeper.
fn emit_case(indent: i64, sel: text, arms: [VgCaseArm]) -> [text]:
    val ci = vg_spaces(indent)
    val ai = vg_spaces(indent + 2)
    var l: [text] = []
    l = l.push(ci + "case " + sel + " is")
    var i = 0
    while i < arms.len():
        val a = arms[i]
        l = vg_append(l, a.pre_lines)
        val sel_txt = vg_pad(a.sel, a.sel_w)
        if a.inline != "":
            # An inline arm may still carry continuation lines (a wrapped
            # right-hand side), so the body is appended either way.
            l = l.push(ai + "when " + sel_txt + " => " + a.inline)
            l = vg_append(l, a.body)
        else:
            l = l.push(ai + "when " + sel_txt + " =>")
            l = vg_append(l, a.body)
        i = i + 1
    l = l.push(ci + "end case;")
    l

# `[<label> : ]process(<sens>)` + optional variable decls + begin/body/end.
fn emit_process(indent: i64, label: text, sens: text, var_decls: [text], body: [text]) -> [text]:
    val ind = vg_spaces(indent)
    var l: [text] = []
    var head = ind + "process(" + sens + ")"
    if label != "":
        head = ind + label + " : process(" + sens + ")"
    l = l.push(head)
    l = vg_append(l, var_decls)
    l = l.push(ind + "begin")
    l = vg_append(l, body)
    l = l.push(ind + "end process;")
    l
