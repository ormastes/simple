# Named literal sections for the four single-lane GHDL testbenches.
#
# Only irreducible paragraphs live here: file-header prose, and the handful of
# stimulus/checker bodies whose logic is genuinely one-of-a-kind (the soak
# baud-decode sampler, the nvme marker-window shift, the bram-soc observation
# procedure and capture-buffer compare loop). Everything with structure —
# entity, generics, declarations, instantiation maps, report chains, process
# scaffolds — is emitted from descriptors in tb_single_lane_types.spl and
# assembled in tb_single_lane_gen.spl, NOT here.
#
# Section functions are `sl_*`-prefixed: the interpreter's function registry is
# flat, so a name shared with a sibling module would hijack the import.

# ---------------------------------------------------------------------------
# tb_rv64_soak
# ---------------------------------------------------------------------------

fn sl_soak_head_comment() -> [text]:
    var l: [text] = []
    l = l.push("-- tb_rv64_soak — drives the Adler-32 hard-job soak payload (soak_rv64.s, built")
    l = l.push("-- by scripts/fpga/soak_rv64_hard_job.shs) on rv64_exec_core under GHDL and")
    l = l.push("-- decodes the UART TX line. It reports every emitted byte as")
    l = l.push("--   SOAK_BYTE=<decimal>")
    l = l.push("-- so the harness can reconstruct the 'P' progress markers and the final")
    l = l.push("--   DONE=XXXXXXXX~")
    l = l.push("-- Adler-32 golden, then compare against the host reference. Stops on the 0x7E")
    l = l.push("-- ('~') sentinel.")
    l

# Start-bit sync + mid-bit sample of one UART frame. Irreducible: this is the
# serial receiver itself.
fn sl_soak_bit_sampler(bits: i64) -> [text]:
    var l: [text] = []
    l = l.push("      wait until uart_tx = '0';")
    l = l.push("      wait for BIT_TIME + BIT_TIME / 2;")
    l = l.push("      byte_value := 0;")
    l = l.push("      for bit_idx in 0 to " + (bits - 1).to_text() + " loop")
    l = l.push("        if uart_tx = '1' then")
    l = l.push("          byte_value := byte_value + (2 ** bit_idx);")
    l = l.push("        end if;")
    l = l.push("        wait for BIT_TIME;")
    l = l.push("      end loop;")
    l

# Re-sync to line idle before hunting the next start bit.
fn sl_soak_resync() -> [text]:
    var l: [text] = []
    l = l.push("      if uart_tx = '0' then")
    l = l.push("        wait until uart_tx = '1';")
    l = l.push("      end if;")
    l

# ---------------------------------------------------------------------------
# tb_rv32_nvme_fw_smoke
# ---------------------------------------------------------------------------

fn sl_nvme_head_comment(marker: text, mem_file: text) -> [text]:
    var l: [text] = []
    l = l.push("-- GHDL SoC-sim testbench: run the minimal NVMe self-test firmware on the real")
    l = l.push("-- rv32 soft-core (rv32_exec_core) and check for the same determinate result the")
    l = l.push("-- QEMU gate checks (the UART marker \"" + marker + "\").")
    l = l.push("--")
    l = l.push("-- Firmware is loaded through the core's init_rom path: the core opens")
    l = l.push("-- \"" + mem_file + "\" (relative to the ghdl -r working directory). The driver")
    l = l.push("-- script scripts/fpga/ghdl_rv32_nvme_fw.shs relinks the gate's firmware object")
    l = l.push("-- with examples/09_embedded/fpga_riscv/rtl/nvme_fw_rv32_bram.ld (single 64 KB")
    l = l.push("-- BRAM window, no aliasing) and drops the flat image in as " + mem_file + ".")
    l = l.push("--")
    l = l.push("-- The core's parallel debug UART tap (debug_uart_valid/debug_uart_byte) is used")
    l = l.push("-- instead of serial baud-decoding: one byte per store to the UART THR.")
    l

fn sl_nvme_inst_comment() -> [text]:
    var l: [text] = []
    l = l.push("  -- Small CLK_FREQ shrinks the internal UART baud divisor (BAUD_DIV = CLK/BAUD)")
    l = l.push("  -- so the serial shift between bytes is fast in sim. The debug tap is unaffected.")
    l

# Rolling-window shift-in for the PASS marker and the 4-char FAIL sentinel.
fn sl_nvme_window_shift(fail_len: i64) -> [text]:
    var l: [text] = []
    l = l.push("        -- shift-in for the PASS window")
    l = l.push("        win := win(2 to MARKER'length) & ch;")
    l = l.push("        fwin := fwin(2 to " + fail_len.to_text() + ") & ch;")
    l = l.push("        ncols := ncols + 1;")
    l

fn sl_nvme_timeout_comment() -> [text]:
    var l: [text] = []
    l = l.push("  -- Timeout guard: firmware must reach the marker well within this window.")
    l = l.push("  -- The full self-test firmware completes and prints the PASS marker at")
    l = l.push("  -- ~1.2425 ms of sim time on the rv32 soft-core (measured, matches QEMU's")
    l = l.push("  -- \"ALL RV32 NVME FW CHECKS PASS\" on the identical BRAM ELF). The previous")
    l = l.push("  -- 1 ms bound guillotined the run mid-selftest and produced a false FAIL;")
    l = l.push("  -- 2 ms leaves comfortable margin over the real completion time.")
    l

# ---------------------------------------------------------------------------
# tb_rv32_simpleos_boot_tiny
# ---------------------------------------------------------------------------

fn sl_boot_tiny_head_comment() -> [text]:
    var l: [text] = []
    l = l.push("-- GHDL SoC-sim testbench: boot the TINY (BRAM-only) rv32 SimpleOS kernel.")
    l = l.push("--")
    l = l.push("-- Identical in structure to tb_rv32_simpleos_boot.vhd, but instantiates")
    l = l.push("-- rv32_exec_core_flat with a BRAM-sized main RAM instead of the 16 MB DDR")
    l = l.push("-- stand-in. The point is to prove the tiny image really fits on-chip: if the")
    l = l.push("-- kernel touched a single address beyond the configured budget, is_ram() would")
    l = l.push("-- reject it and the marker chain would break instead of silently working.")
    l = l.push("--")
    l = l.push("--   RAM_WORDS   = 131072 words = 512 KB main RAM")
    l = l.push("--                 (tiny image needs 388 KB: _kernel_end = 0x80061000)")
    l = l.push("--   RDISK_WORDS = 262144 words = 1 MiB FAT32 ramdisk bank at 0x88000000")
    l = l.push("--")
    l = l.push("--   BRAM total  = 512 KB + 1 MiB = 1.5 MB, inside the ~2.8 MB xck26 PL budget.")
    l = l.push("--")
    l = l.push("-- The kernel image is loaded through the core's init_ram path (\"rv32_flat.mem\",")
    l = l.push("-- relative to the ghdl -r working dir); scripts/fpga/ghdl_rv32_simpleos_boot_tiny.shs")
    l = l.push("-- flattens the prebuilt tiny kernel ELF.")
    l = l.push("--")
    l = l.push("-- The core's parallel debug UART tap (debug_uart_valid/debug_uart_byte) is used")
    l = l.push("-- instead of serial baud-decoding: one byte per store to the UART THR. Bytes")
    l = l.push("-- are accumulated into lines and reported so the boot transcript is visible.")
    l

fn sl_boot_tiny_ram_generic_comment() -> [text]:
    var l: [text] = []
    l = l.push("    -- 512 KB main RAM: the whole BRAM-only budget for code+data+stack+heap.")
    l = l.push("    -- Overridable from ghdl -r (-gTINY_RAM_WORDS=...) so smaller BRAM budgets")
    l = l.push("    -- can be proven without editing the testbench; defaults match the")
    l = l.push("    -- original constants exactly.")
    l

fn sl_boot_tiny_tap_comment() -> [text]:
    var l: [text] = []
    l = l.push("  -- Accumulate UART bytes into lines; report each completed line and stop on a")
    l = l.push("  -- terminal marker.")
    l

# ---------------------------------------------------------------------------
# tb_rv32_tiny_bram_soc
# ---------------------------------------------------------------------------

fn sl_bram_head_comment() -> [text]:
    var l: [text] = []
    l = l.push("-- tb_rv32_tiny_bram_soc: GHDL rehearsal of the EXACT synthesizable BRAM SoC")
    l = l.push("-- (rv32_bram_soc: rv32_exec_core_axi + BRAM slave + UART capture + obs port)")
    l = l.push("-- before burning a Vivado run. Only the Vivado top's device primitives")
    l = l.push("-- (STARTUPE3 clocking, BSCANE2 USER4 shift logic) are outside this rehearsal;")
    l = l.push("-- the whole memory/init/capture/observation datapath is the real synth RTL.")
    l = l.push("--")
    l = l.push("-- Pass criteria (all reported as timestamped notes):")
    l = l.push("--   RV32_BRAMSOC_BOOT_DONE reached=TEST_PASSED   -- live UART tap marker chain")
    l = l.push("--   RV32_BRAMSOC_OBS_MAGIC_OK / STATUS_OK        -- obs port sane, pass flag set")
    l = l.push("--   RV32_BRAMSOC_OBS_UART_MATCH bytes=<n>        -- capture buffer readback is")
    l = l.push("--                                                   byte-identical to the live")
    l = l.push("--                                                   UART transcript")
    l = l.push("--")
    l = l.push("-- Generics are overridable from ghdl -r via -gTINY_RAM_WORDS=... etc. so the")
    l = l.push("-- same tb rehearses both the 512KB and the shrunk 256KB budgets.")
    l

fn sl_nvme_bram_head_comment(marker: text) -> [text]:
    var l: [text] = []
    l = l.push("-- tb_rv32_nvme_bram_soc: GHDL rehearsal of the EXACT synthesizable BRAM SoC")
    l = l.push("-- (rv32_bram_soc: rv32_exec_core_axi + BRAM slave + UART capture + obs port)")
    l = l.push("-- running the Simple-generated NVMe self-test firmware, before burning a")
    l = l.push("-- Vivado run for KV260 silicon. Only the Vivado top's device primitives")
    l = l.push("-- (STARTUPE3 clocking, BSCANE2 USER4 shift logic) are outside this rehearsal;")
    l = l.push("-- the whole memory/init/capture/observation datapath is the real synth RTL.")
    l = l.push("--")
    l = l.push("-- The firmware is self-contained (no external NVMe device model): it runs the")
    l = l.push("-- NVMe hook-logic selftests and prints \"" + marker + "\" to the")
    l = l.push("-- 16550 THR at 0x10000000, which rv32_exec_core_axi decodes internally.")
    l = l.push("--")
    l = l.push("-- Pass criteria (all reported as timestamped notes):")
    l = l.push("--   RV32_NVMEBRAM_BOOT_DONE reached=NVME_FW_PASS -- live UART tap marker line")
    l = l.push("--   RV32_NVMEBRAM_OBS_MAGIC_OK                   -- obs port sane")
    l = l.push("--   RV32_NVMEBRAM_OBS_UART_MATCH bytes=<n>       -- capture buffer readback is")
    l = l.push("--                                                   byte-identical to the live")
    l = l.push("--                                                   UART transcript")
    l = l.push("-- NOTE: rv32_bram_soc's hardwired pass_seen matcher looks for \"TEST PASSED\",")
    l = l.push("-- which this firmware does not print; on silicon the verdict comes from the")
    l = l.push("-- transcript text read back over JTAG (read_rv32_tiny_bram_obs.shs transcript),")
    l = l.push("-- exactly as this tb greps the line from the UART tap. The status byte COUNT")
    l = l.push("-- is still meaningful and is reported.")
    l

fn sl_bram_mirror_comment() -> [text]:
    var l: [text] = []
    l = l.push("  -- Live transcript mirror (for byte-exact compare with the capture buffer).")
    l

fn sl_bram_clock_comment() -> [text]:
    var l: [text] = []
    l = l.push("  -- 10 ns period like the sibling tbs; CLK_FREQ=1MHz below only shrinks the")
    l = l.push("  -- UART baud divisor so byte stalls are 8 cycles instead of 217.")
    l

fn sl_bram_tap_comment() -> [text]:
    var l: [text] = []
    l = l.push("  -- Accumulate UART bytes into lines; report each line; mark done on marker.")
    l

# Mirror every tapped byte into the compare buffer.
fn sl_bram_mirror_capture() -> [text]:
    var l: [text] = []
    l = l.push("        if mirror_len < MIRROR_MAX then")
    l = l.push("          mirror(mirror_len) <= debug_uart_byte;")
    l = l.push("          mirror_len <= mirror_len + 1;")
    l = l.push("        end if;")
    l

# `subject` is what had to finish first: "boot" for the SimpleOS rehearsal,
# "firmware" for the NVMe self-test rehearsal.
fn sl_bram_obs_process_comment(subject: text) -> [text]:
    var l: [text] = []
    l = l.push("  -- Observation-port exercise once the " + subject + " finished (or timeout).")
    l

# Observation-port transaction procedure: drive a command, wait out the
# registered response latency, check signature + echo, return the payload.
# Irreducible: this IS the obs-port protocol.
fn sl_bram_obs_procedure(xlen: i64, resp_w: i64, tag: text) -> [text]:
    val cmd_ty = "std_logic_vector(" + (xlen - 1).to_text() + " downto 0)"
    var l: [text] = []
    l = l.push("    procedure obs_do(cmd : in " + cmd_ty + ";")
    l = l.push("                     data : out " + cmd_ty + ") is")
    l = l.push("    begin")
    l = l.push("      wait until rising_edge(clk);")
    l = l.push("      obs_cmd <= cmd;")
    l = l.push("      obs_cmd_valid <= '1';")
    l = l.push("      wait until rising_edge(clk);")
    l = l.push("      obs_cmd_valid <= '0';")
    l = l.push("      -- resp is registered 2 cycles after the valid pulse; wait 4 to be safe.")
    l = l.push("      for i in 1 to 4 loop wait until rising_edge(clk); end loop;")
    l = l.push("      assert obs_resp(" + (resp_w - 1).to_text() + " downto " + (resp_w - 16).to_text() + ") = x\"A55A\"")
    l = l.push("        report \"" + tag + "_OBS_BAD_SIG resp=\" & to_hstring(obs_resp) severity note;")
    l = l.push("      assert obs_resp(" + (resp_w - 17).to_text() + " downto " + xlen.to_text() + ") = cmd(15 downto 0)")
    l = l.push("        report \"" + tag + "_OBS_BAD_ECHO resp=\" & to_hstring(obs_resp) severity note;")
    l = l.push("      data := obs_resp(" + (xlen - 1).to_text() + " downto 0);")
    l = l.push("    end procedure;")
    l

fn sl_bram_settle() -> [text]:
    var l: [text] = []
    l = l.push("    -- settle: let the final UART bytes drain into the capture buffer")
    l = l.push("    for i in 1 to 200 loop wait until rising_edge(clk); end loop;")
    l

# Read the capture buffer back one word at a time and compare each byte lane
# against the live-tap mirror. Irreducible: the lane arithmetic is the check.
fn sl_bram_compare_loop(bytes_per_word: i64) -> [text]:
    val bpw = bytes_per_word.to_text()
    var l: [text] = []
    l = l.push("    -- Read the whole capture buffer back through the obs port and compare with")
    l = l.push("    -- the live-tap mirror byte for byte.")
    l = l.push("    mism := 0;")
    l = l.push("    widx := 0;")
    l = l.push("    while widx * " + bpw + " < nbytes loop")
    l = l.push("      cmdv := std_logic_vector(to_unsigned(widx, 16)) & x\"0003\";")
    l = l.push("      obs_do(cmdv, d);")
    l = l.push("      for lane in 0 to " + (bytes_per_word - 1).to_text() + " loop")
    l = l.push("        if widx * " + bpw + " + lane < nbytes and widx * " + bpw + " + lane < mirror_len then")
    l = l.push("          if d(lane * 8 + 7 downto lane * 8) /= mirror(widx * " + bpw + " + lane) then")
    l = l.push("            mism := mism + 1;")
    l = l.push("          end if;")
    l = l.push("        end if;")
    l = l.push("      end loop;")
    l = l.push("      widx := widx + 1;")
    l = l.push("    end loop;")
    l
