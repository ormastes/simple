# Entry point for scripts/fpga/generate_exec_core_vhdl.shs — writes the six
# generated silicon-lane cores (rv32/rv64 base + flat + axi variants) into
# build/os/rtl/ (a scanned lane of scripts/check/check-riscv-rtl-truth.shs;
# the emitted cores contain real opcode decode so they classify
# generated-real).
#
# Flags:
#   --mem-prefix <dir/>  optional absolute path prefix for the .mem files in
#                        init_rom/init_data_rom/init_mem/init_ram/init_rdisk
#                        (default: golden's relative form, e.g.
#                        "rv32_payload.mem"); the axi cores read no .mem files
#   --out-dir <dir>      output directory (default build/os/rtl)

use app.io.cli_ops.{get_args}
use std.hardware.riscv_common.xlen.XlenConfig
use std.hardware.vhdl_gen.exec_core_gen.{generate_exec_core}
use std.hardware.vhdl_gen.exec_core_variant_gen.{generate_exec_core_flat, generate_exec_core_axi}
use std.hardware.vhdl_gen.axi4_mem_adapter_gen.{generate_rv32_axi4_mem_adapter, generate_rv64_axi4_mem_adapter}
use std.hardware.vhdl_gen.ctrl_obs_slave_gen.{generate_ctrl_obs_slave}
use std.hardware.vhdl_gen.bram_soc_gen.{generate_bram_soc}
use std.hardware.vhdl_gen.soc_top_gen.{generate_soc_top_board, generate_soc_top_k26_ddr, generate_soc_top_sim, generate_soc_top_tiny_bram}
use std.hardware.vhdl_gen.tb_k26_ddr_gen.{generate_tb_rv32_k26_ddr_boot, generate_tb_rv64_k26_ddr_boot}
use std.hardware.vhdl_gen.tb_single_lane_gen.{generate_tb_rv32_nvme_fw_smoke, generate_tb_rv32_simpleos_boot_tiny, generate_tb_rv32_tiny_bram_soc, generate_tb_rv64_soak, generate_tb_rv32_nvme_bram_soc}
use std.hardware.vhdl_gen.tb_simpleos_wb_gen.{generate_wb_soc_smoke, generate_simpleos_boot, generate_simpleos_boot_axi}
use std.hardware.vhdl_gen.tb_oneoff_gen.{generate_tb_rv32_payload, generate_tb_gate}
use std.hardware.vhdl_gen.tb_product_gen.{generate_tb_rv32_product_sv32_pmp, generate_tb_rv64_product_sv39_pmp, generate_tb_rv64_product_wb_axi}

extern fn rt_file_write_text(path: text, content: text) -> bool

fn main():
    var mem_prefix = ""
    var out_dir = "build/os/rtl"
    val args = get_args()
    var i = 0
    while i < args.len():
        if args[i] == "--mem-prefix" and i + 1 < args.len():
            mem_prefix = args[i + 1]
            i = i + 1
        if args[i] == "--out-dir" and i + 1 < args.len():
            out_dir = args[i + 1]
            i = i + 1
        i = i + 1
    var names: [text] = []
    var texts: [text] = []
    names = names.push("rv32_exec_core.vhd")
    texts = texts.push(generate_exec_core(XlenConfig.rv32(), mem_prefix, true))
    names = names.push("rv64_exec_core.vhd")
    texts = texts.push(generate_exec_core(XlenConfig.rv64(), mem_prefix, true))
    names = names.push("rv32_exec_core_flat.vhd")
    texts = texts.push(generate_exec_core_flat(XlenConfig.rv32(), mem_prefix))
    names = names.push("rv64_exec_core_flat.vhd")
    texts = texts.push(generate_exec_core_flat(XlenConfig.rv64(), mem_prefix))
    names = names.push("rv32_exec_core_axi.vhd")
    texts = texts.push(generate_exec_core_axi(XlenConfig.rv32()))
    names = names.push("rv64_exec_core_axi.vhd")
    texts = texts.push(generate_exec_core_axi(XlenConfig.rv64()))
    # Bus/memory infrastructure.
    names = names.push("rv32_axi4_mem_adapter.vhd")
    texts = texts.push(generate_rv32_axi4_mem_adapter())
    names = names.push("rv64_axi4_mem_adapter.vhd")
    texts = texts.push(generate_rv64_axi4_mem_adapter())
    names = names.push("rv32_ctrl_obs_slave.vhd")
    texts = texts.push(generate_ctrl_obs_slave())
    names = names.push("rv32_bram_soc.vhd")
    texts = texts.push(generate_bram_soc())
    # SoC tops: three XLEN pairs plus the rv32-only tiny-BRAM top.
    names = names.push("soc_top_rv32.vhd")
    texts = texts.push(generate_soc_top_board(XlenConfig.rv32()))
    names = names.push("soc_top_rv64.vhd")
    texts = texts.push(generate_soc_top_board(XlenConfig.rv64()))
    names = names.push("soc_top_rv32_k26_ddr.vhd")
    texts = texts.push(generate_soc_top_k26_ddr(XlenConfig.rv32()))
    names = names.push("soc_top_rv64_k26_ddr.vhd")
    texts = texts.push(generate_soc_top_k26_ddr(XlenConfig.rv64()))
    names = names.push("soc_top_rv32_sim.vhd")
    texts = texts.push(generate_soc_top_sim(XlenConfig.rv32()))
    names = names.push("soc_top_rv64_sim.vhd")
    texts = texts.push(generate_soc_top_sim(XlenConfig.rv64()))
    names = names.push("soc_top_rv32_tiny_bram.vhd")
    texts = texts.push(generate_soc_top_tiny_bram())
    # Testbenches: K26 DDR boot pair.
    names = names.push("tb_rv32_k26_ddr_boot.vhd")
    texts = texts.push(generate_tb_rv32_k26_ddr_boot(mem_prefix))
    names = names.push("tb_rv64_k26_ddr_boot.vhd")
    texts = texts.push(generate_tb_rv64_k26_ddr_boot(mem_prefix))
    # Testbenches: SimpleOS boot / WB smoke XLEN pairs.
    names = names.push("tb_rv32_wb_soc_smoke.vhd")
    texts = texts.push(generate_wb_soc_smoke(XlenConfig.rv32()))
    names = names.push("tb_rv64_wb_soc_smoke.vhd")
    texts = texts.push(generate_wb_soc_smoke(XlenConfig.rv64()))
    names = names.push("tb_rv32_simpleos_boot.vhd")
    texts = texts.push(generate_simpleos_boot(XlenConfig.rv32()))
    names = names.push("tb_rv64_simpleos_boot.vhd")
    texts = texts.push(generate_simpleos_boot(XlenConfig.rv64()))
    names = names.push("tb_rv32_simpleos_boot_axi.vhd")
    texts = texts.push(generate_simpleos_boot_axi(XlenConfig.rv32(), mem_prefix))
    names = names.push("tb_rv64_simpleos_boot_axi.vhd")
    texts = texts.push(generate_simpleos_boot_axi(XlenConfig.rv64(), mem_prefix))
    # Testbenches: single-lane (no XLEN sibling).
    names = names.push("tb_rv32_nvme_fw_smoke.vhd")
    texts = texts.push(generate_tb_rv32_nvme_fw_smoke())
    names = names.push("tb_rv32_simpleos_boot_tiny.vhd")
    texts = texts.push(generate_tb_rv32_simpleos_boot_tiny())
    names = names.push("tb_rv32_tiny_bram_soc.vhd")
    texts = texts.push(generate_tb_rv32_tiny_bram_soc())
    names = names.push("tb_rv64_soak.vhd")
    texts = texts.push(generate_tb_rv64_soak())
    names = names.push("tb_rv32_nvme_bram_soc.vhd")
    texts = texts.push(generate_tb_rv32_nvme_bram_soc())
    # RTL whose golden lives OUTSIDE examples/09_embedded/fpga_riscv/rtl/ goes to
    # a SEPARATE output dir (<out_dir>_external), never into out_dir itself.
    # Reason: scripts/check/check-riscv-rtl-truth.shs scans build/os/rtl as one
    # lane and requires every instantiated entity to be defined within it. These
    # testbenches instantiate companions that live only in their own golden dirs,
    # so staging them flat alongside the silicon lane made the truth gate report
    # 4 spurious "wrapper instantiates undefined entity" VIOLATIONs. Keeping them
    # out of that dir fixes the cause instead of suppressing the check.
    var ext_names: [text] = []
    var ext_texts: [text] = []
    ext_names = ext_names.push("tb_rv32_payload.vhd")
    ext_texts = ext_texts.push(generate_tb_rv32_payload())
    ext_names = ext_names.push("tb_gate.vhd")
    ext_texts = ext_texts.push(generate_tb_gate())
    ext_names = ext_names.push("tb_rv32_product_sv32_pmp.vhd")
    ext_texts = ext_texts.push(generate_tb_rv32_product_sv32_pmp())
    ext_names = ext_names.push("tb_rv64_product_sv39_pmp.vhd")
    ext_texts = ext_texts.push(generate_tb_rv64_product_sv39_pmp())
    ext_names = ext_names.push("tb_rv64_product_wb_axi.vhd")
    ext_texts = ext_texts.push(generate_tb_rv64_product_wb_axi())
    var all_ok = true
    i = 0
    while i < names.len():
        val p = out_dir + "/" + names[i]
        val ok = rt_file_write_text(p, texts[i])
        if ok:
            print("VHDL_GEN: wrote " + p)
        else:
            all_ok = false
            print("VHDL_GEN: write failed for " + p)
        i = i + 1
    val ext_dir = out_dir + "_external"
    i = 0
    while i < ext_names.len():
        val ep = ext_dir + "/" + ext_names[i]
        val eok = rt_file_write_text(ep, ext_texts[i])
        if eok:
            print("VHDL_GEN: wrote " + ep)
        else:
            all_ok = false
            print("VHDL_GEN: write failed for " + ep)
        i = i + 1
    if all_ok:
        print("VHDL_GEN: OK")
    else:
        print("VHDL_GEN: FAILED (write error)")
