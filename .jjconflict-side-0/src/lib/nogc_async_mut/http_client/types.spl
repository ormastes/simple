@allow(unnamed_duplicate_typed_args) # reason: positional API -- arg order is conventional
# HTTP Client Type Definitions and Constants

val HTTP_VERSION = "HTTP/1.1"
val METHOD_GET = "GET"
val METHOD_POST = "POST"
val METHOD_PUT = "PUT"
val METHOD_DELETE = "DELETE"
val METHOD_PATCH = "PATCH"
val METHOD_HEAD = "HEAD"
val METHOD_OPTIONS = "OPTIONS"
val CONTENT_TYPE_JSON = "application/json"
val CONTENT_TYPE_FORM = "application/x-www-form-urlencoded"
val CONTENT_TYPE_MULTIPART = "multipart/form-data"
val CONTENT_TYPE_TEXT = "text/plain"
val CONTENT_TYPE_HTML = "text/html"
val CONTENT_TYPE_XML = "application/xml"
val CONTENT_TYPE_OCTET_STREAM = "application/octet-stream"
val STATUS_OK = 200
val STATUS_CREATED = 201
val STATUS_ACCEPTED = 202
val STATUS_NO_CONTENT = 204
val STATUS_MOVED_PERMANENTLY = 301
val STATUS_FOUND = 302
val STATUS_SEE_OTHER = 303
val STATUS_NOT_MODIFIED = 304
val STATUS_TEMPORARY_REDIRECT = 307
val STATUS_PERMANENT_REDIRECT = 308
val STATUS_BAD_REQUEST = 400
val STATUS_UNAUTHORIZED = 401
val STATUS_FORBIDDEN = 403
val STATUS_NOT_FOUND = 404
val STATUS_METHOD_NOT_ALLOWED = 405
val STATUS_CONFLICT = 409
val STATUS_INTERNAL_SERVER_ERROR = 500
val STATUS_NOT_IMPLEMENTED = 501
val STATUS_BAD_GATEWAY = 502
val STATUS_SERVICE_UNAVAILABLE = 503
val USER_AGENT_DEFAULT = "SimpleHTTP/1.0"
val ACCEPT_DEFAULT = "*/*"

fn url_encode(text: text) -> text:
    var parts: [text] = []
    var i = 0
    var len = text.length()
    while i < len:
        var ch = text.char_at(i)
        var code = text.char_code_at(i)
        var is_alpha = (code >= 65 and code <= 90) or (code >= 97 and code <= 122)
        var is_digit = code >= 48 and code <= 57
        var is_unreserved = is_alpha or is_digit or ch == "-" or ch == "_" or ch == "." or ch == "~"
        if is_unreserved:
            parts.push(ch)
        else:
            var hex = code.to_string(16).upper()
            if hex.length() == 1:
                hex = "0" + hex
            parts.push("%" + hex)
        i = i + 1
    parts.join("")

fn url_decode(text: text) -> text:
    # Byte-consistent scan: `run_start` tracks a pending byte RANGE of
    # untouched input to flush as one slice, so a multibyte UTF-8 codepoint
    # is never split into single-byte pieces (each of which would decode
    # to U+FFFD on its own -- see
    # doc/08_tracking/bug/mixed_byte_and_codepoint_indexing_defect_class_2026-08-18.md).
    # `%`/`+` are always single ASCII bytes, so per-byte comparison via
    # `.substring(i, i+1)` is safe for detecting them.
    var parts: [text] = []
    var i = 0
    var len = text.length()
    var run_start = 0
    while i < len:
        var ch = text.substring(i, i + 1)
        if ch == "%":
            if run_start < i:
                parts.push(text.substring(run_start, i))
            if i + 2 < len:
                var hex = text.substring(i + 1, i + 3)
                var code = hex.parse_int(16)
                parts.push(code.to_char())
                i = i + 3
            else:
                parts.push(ch)
                i = i + 1
            run_start = i
        elif ch == "+":
            if run_start < i:
                parts.push(text.substring(run_start, i))
            parts.push(" ")
            i = i + 1
            run_start = i
        else:
            i = i + 1
    if run_start < len:
        parts.push(text.substring(run_start, len))
    parts.join("")

fn url_encode_component(component: text) -> text:
    url_encode(text: component)

fn url_decode_component(component: text) -> text:
    url_decode(text: component)

pub class UrlParts:
    """A successfully parsed absolute URL.

    `scheme` and `host` are lowercase-normalized. `port` is the *effective*
    port: the explicit port when one was given, otherwise the scheme's default
    port, or `0` when the scheme has no default port (`file:` and every
    non-special scheme). `opaque` is true for schemes parsed without an
    authority (`data:`, `about:`, `javascript:`, `mailto:`); for those, `host`
    is always `""` and `path` holds the opaque remainder verbatim.
    """
    scheme: text
    host: text
    port: i64
    path: text
    query: text
    fragment: text
    opaque: bool

fn url_default_port(scheme: text) -> i64:
    """Default port for a special scheme, or 0 when it has none."""
    if scheme == "http": return 80
    if scheme == "ws": return 80
    if scheme == "https": return 443
    if scheme == "wss": return 443
    if scheme == "ftp": return 21
    0

fn url_is_special(scheme: text) -> bool:
    """WHATWG "special scheme" set -- the schemes that require an authority."""
    (scheme == "http" or scheme == "https" or scheme == "ws"
        or scheme == "wss" or scheme == "ftp" or scheme == "file")

fn _url_is_alpha(c: text) -> bool:
    (c >= "a" and c <= "z") or (c >= "A" and c <= "Z")

fn _url_is_digit(c: text) -> bool:
    c >= "0" and c <= "9"

fn _url_trim(raw: text) -> text:
    var start = 0
    var stop = raw.length()
    while start < stop:
        val c = raw.substring(start, start + 1)
        if c == " " or c == "\t" or c == "\n" or c == "\r":
            start = start + 1
        else:
            break
    while stop > start:
        val c = raw.substring(stop - 1, stop)
        if c == " " or c == "\t" or c == "\n" or c == "\r":
            stop = stop - 1
        else:
            break
    raw.substring(start, stop)

fn _url_strip_tabs(raw: text) -> text:
    """Remove tab/newline/CR anywhere in the input, per the WHATWG URL parser."""
    var out = raw
    if out.index_of("\t") >= 0:
        out = out.split("\t").join("")
    if out.index_of("\n") >= 0:
        out = out.split("\n").join("")
    if out.index_of("\r") >= 0:
        out = out.split("\r").join("")
    out

fn _url_parse_port(s: text) -> i64:
    """Parse a port. Returns -1 when `s` is not a valid 1..65535 port.

    Port 0 is rejected deliberately: it is never connectable and would be
    indistinguishable from the "no port" sentinel used by `UrlParts.port`.
    """
    if s.length() == 0: return -1
    if s.length() > 5: return -1
    var acc = 0
    var i = 0
    while i < s.length():
        val c = s.substring(i, i + 1)
        val d = "0123456789".index_of(c)
        if d < 0:
            return -1
        acc = acc * 10 + d
        i = i + 1
    if acc < 1 or acc > 65535:
        return -1
    acc

fn _url_valid_host(host: text) -> bool:
    """Reject the WHATWG forbidden-host code points."""
    if host.length() == 0:
        return false
    var i = 0
    while i < host.length():
        val c = host.substring(i, i + 1)
        if (c == " " or c == "\t" or c == "\n" or c == "\r" or c == "#"
                or c == "/" or c == ":" or c == "?" or c == "@" or c == "["
                or c == "]" or c == "^" or c == "<" or c == ">" or c == "|"
                or c == "%" or c == "\\"):
            return false
        i = i + 1
    true

fn _url_valid_ipv4(text: text) -> bool:
    val parts = text.split(".")
    if parts.len() != 4:
        return false
    for part in parts:
        if part.len() == 0 or part.len() > 3:
            return false
        var value = 0
        for ch in part:
            if not _url_is_digit(ch):
                return false
            value = value * 10 + (ch.char_code_at(0) - 48)
        if value > 255:
            return false
    true

fn _url_valid_ipv6(inner: text) -> bool:
    if inner.len() == 0 or not inner.contains(":"):
        return false
    val compression = inner.index_of("::")
    if compression >= 0 and compression != inner.last_index_of("::"):
        return false
    val before = if compression >= 0: inner.slice(0, compression) else: inner
    val after = if compression >= 0: inner.slice(compression + 2, inner.len()) else: ""
    if before.ends_with(":") or after.starts_with(":"):
        return false
    var groups: [text] = []
    if before != "":
        for group in before.split(":"):
            groups.push(group)
    if after != "":
        for group in after.split(":"):
            groups.push(group)
    var units = 0
    var index = 0
    while index < groups.len():
        val group = groups[index]
        if group.contains("."):
            if index != groups.len() - 1 or not _url_valid_ipv4(group):
                return false
            units = units + 2
        else:
            if group.len() == 0 or group.len() > 4:
                return false
            for ch in group:
                if not (_url_is_digit(ch) or
                    (ch >= "a" and ch <= "f") or
                    (ch >= "A" and ch <= "F")):
                    return false
            units = units + 1
        index = index + 1
    if compression >= 0:
        return units < 8
    units == 8

fn parse_url(url: text) -> Option<UrlParts>:
    """Parse an absolute URL, fail-closed.

    Returns `None` for anything that is not an absolute URL. This parser never
    guesses a scheme and never invents a host: a missing or malformed scheme, a
    malformed authority, or a bad port all yield `None` rather than a
    plausible-looking default. Callers making security decisions (origin
    comparison, CORS, cookies) must treat `None` as "untrusted / opaque".
    """
    val trimmed = _url_strip_tabs(_url_trim(url))
    if trimmed.length() == 0:
        return None

    # --- scheme ---------------------------------------------------------
    if not _url_is_alpha(trimmed.substring(0, 1)):
        return None
    var si = 0
    while si < trimmed.length():
        val c = trimmed.substring(si, si + 1)
        if c == ":":
            break
        if not (_url_is_alpha(c) or _url_is_digit(c) or c == "+" or c == "-" or c == "."):
            return None
        si = si + 1
    if si >= trimmed.length():
        return None
    val scheme = trimmed.substring(0, si).to_lower()
    var rest = trimmed.substring(si + 1, trimmed.length())
    val special = url_is_special(scheme)

    # --- fragment then query (both split before the authority) ----------
    var fragment = ""
    val frag_at = rest.index_of("#")
    if frag_at >= 0:
        fragment = rest.substring(frag_at + 1, rest.length())
        rest = rest.substring(0, frag_at)
    var query = ""
    val q_at = rest.index_of("?")
    if q_at >= 0:
        query = rest.substring(q_at + 1, rest.length())
        rest = rest.substring(0, q_at)

    # --- opaque path (data:, about:, javascript:, mailto:) --------------
    if not rest.starts_with("//"):
        if special:
            # A special scheme without "//" is malformed (e.g. "http:example.com").
            return None
        return Some(UrlParts(
            scheme: scheme, host: "", port: 0, path: rest,
            query: query, fragment: fragment, opaque: true))

    val after = rest.substring(2, rest.length())

    # --- authority ------------------------------------------------------
    var authority = after
    var path = ""
    val slash_at = after.index_of("/")
    if slash_at >= 0:
        authority = after.substring(0, slash_at)
        path = after.substring(slash_at, after.length())

    # Everything up to the LAST "@" is userinfo, not the host. Splitting on the
    # first "@" is the classic "http://evil.com@good.com" host-spoof.
    val at_pos = authority.last_index_of("@")
    if at_pos >= 0:
        authority = authority.substring(at_pos + 1, authority.length())

    var host = ""
    var port = 0
    if authority.starts_with("["):
        val close = authority.index_of("]")
        if close < 0:
            return None
        val inner = authority.substring(1, close)
        if not _url_valid_ipv6(inner):
            return None
        host = "[" + inner.to_lower() + "]"
        val tail = authority.substring(close + 1, authority.length())
        if tail.length() > 0:
            if not tail.starts_with(":"):
                return None
            val ptxt = tail.substring(1, tail.length())
            if ptxt.length() > 0:
                val p = _url_parse_port(ptxt)
                if p < 0:
                    return None
                port = p
    else:
        val colon = authority.index_of(":")
        if colon >= 0:
            host = authority.substring(0, colon).to_lower()
            val ptxt = authority.substring(colon + 1, authority.length())
            if ptxt.length() > 0:
                val p = _url_parse_port(ptxt)
                if p < 0:
                    return None
                port = p
        else:
            host = authority.to_lower()
        if host.length() == 0:
            # "file://" legitimately has an empty host; nothing else may.
            if scheme != "file":
                return None
        else:
            if not _url_valid_host(host):
                return None

    if scheme == "file" and port != 0:
        return None
    if port == 0:
        port = url_default_port(scheme)
    if path.length() == 0 and special:
        path = "/"
    Some(UrlParts(
        scheme: scheme, host: host, port: port, path: path,
        query: query, fragment: fragment, opaque: false))

fn build_url(scheme: text, host: text, port: i64, path: text, query: text, fragment: text) -> text:
    var url = scheme + "://" + host
    val default_port = url_default_port(scheme)
    if port != default_port and port != 0:
        url = url + ":" + port.to_string()
    url = url + path
    if query.length() > 0:
        url = url + "?" + query
    if fragment.length() > 0:
        url = url + "#" + fragment
    url

fn url_join(base: text, relative: text) -> Option<text>:
    """Resolve `relative` against `base`. `None` when `base` is unparseable."""
    val rel_abs = parse_url(relative)
    if rel_abs.?:
        return Some(relative)
    val parsed = parse_url(base)
    if not parsed.?:
        return None
    val b = parsed!
    if b.opaque:
        return None
    var new_path = relative
    if not relative.starts_with("/"):
        val last_slash = b.path.last_index_of("/")
        if last_slash >= 0:
            new_path = b.path.substring(0, last_slash + 1) + relative
        else:
            new_path = "/" + relative
    Some(build_url(scheme: b.scheme, host: b.host, port: b.port, path: new_path, query: "", fragment: ""))

fn parse_query_string(query: text) -> list:
    var params = []
    if query.length() == 0:
        return params
    var pairs = query.split("&")
    var i = 0
    while i < pairs.length():
        var pair = pairs[i]
        var eq_pos = pair.index_of("=")
        if eq_pos >= 0:
            var key = pair.substring(0, eq_pos)
            var value = pair.substring(eq_pos + 1, pair.length())
            key = url_decode(text: key)
            value = url_decode(text: value)
            params.append((key, value))
        else:
            var key = url_decode(text: pair)
            params.append((key, ""))
        i = i + 1
    params

fn build_query_string(params: list) -> text:
    var parts: [text] = []
    var i = 0
    while i < params.length():
        var param = params[i]
        var key = param.0
        var value = param.1
        var entry = url_encode(text: key)
        if value.length() > 0:
            entry = entry + "=" + url_encode(text: value)
        parts.push(entry)
        i = i + 1
    parts.join("&")

fn add_query_param(url: text, key: text, value: text) -> Option<text>:
    """Append a query parameter. `None` when `url` is not a parseable URL."""
    val parsed = parse_url(url)
    if not parsed.?:
        return None
    val u = parsed!
    if u.opaque:
        return None
    var params = parse_query_string(u.query)
    params.append((key, value))
    val new_query = build_query_string(params)
    Some(build_url(scheme: u.scheme, host: u.host, port: u.port, path: u.path,
                   query: new_query, fragment: u.fragment))

fn remove_query_param(url: text, key: text) -> Option<text>:
    """Drop a query parameter. `None` when `url` is not a parseable URL."""
    val parsed = parse_url(url)
    if not parsed.?:
        return None
    val u = parsed!
    if u.opaque:
        return None
    var params = parse_query_string(u.query)
    var filtered = []
    var i = 0
    while i < params.length():
        var param = params[i]
        if param.0 != key:
            filtered.append(param)
        i = i + 1
    val new_query = build_query_string(filtered)
    Some(build_url(scheme: u.scheme, host: u.host, port: u.port, path: u.path,
                   query: new_query, fragment: u.fragment))
