# Cooperative Green Thread Module
# @tag:stdlib
# @tag:api
#
# Green threads are scheduled cooperatively in the current OS thread. They are
# cheaper than OS threads, but they do not run in parallel and cannot preempt a
# long-running closure.
#
# SCHEDULER STATE: All mutable scheduler state is held in a single module-level
# GreenScheduler instance (GREEN_SCHEDULER), replacing what used to be bare
# module-level vars. It carries FIVE counters, in two groups:
#   next_id                  — task id sequence
#   ready_count / done_count — AGGREGATE over both task classes
#   value_ready / value_done — pre-computed value slots ONLY
# The value pair is not redundant with the aggregate: see the GreenScheduler
# docstring for why a value handle must never be compared against done_count.
#
# COOPERATIVE DEFERRAL (E6): green_spawn(fn) stores the closure in a module-level
# task table (GREEN_TASKS: [GreenTask]) keyed by task_id and does NOT evaluate
# the closure at spawn time. The scheduler's green_run_one / green_run_all execute
# pending tasks one-by-one.
#
# ERROR CAPTURE: the thunk type is fn() -> i64, not a Result, so green_run_one
# cannot observe a failing thunk by inspecting its return value (a negative i64
# is a legitimate value-level result, not an error — see the "bad result"
# scenario in green_spawn_deferred_spec.spl). Unlike async_host/scheduler.spl's
# W2-5 TaskDeathRecord (populated by the RUNTIME after observing a Result-typed
# future), a plain fn() -> i64 thunk has no channel for the SCHEDULER to detect
# failure. Instead, green_fail(reason) gives the TASK BODY itself an explicit
# self-report channel: calling it inside a thunk marks that task's run as
# errored. green_run_one() resets the report slot before invoking the thunk and
# reads it back after; if set, the task is recorded has_error: true with that
# reason and green_task_error() returns it. A thunk that never calls
# green_fail() is has_error: false regardless of its return value, exactly as
# the deferred-execution spec's "bad result" scenario documents.
# Previously tracked as a dead export:
# doc/08_tracking/bug/green_task_error_is_a_dead_export_that_can_only_return_empty_2026-08-08.md
# (resolved by wiring the self-report channel described above).
#
# THUNK STORAGE: fn() -> i64 stored in a class field works in interpreter mode
# (empirically verified 2026-06-11: probe storing make_value fn in ThunkHolder.thunk,
# calling via me run() → output 0/1/42 confirming deferred execution).
# Module-level array of GreenTask objects is the backing store. Arrays are value
# types so green_run_one rebuilds GREEN_TASKS on each execution step.
#
# BACKWARD COMPAT: green_spawn_eager(fn) preserves the old eager-evaluation
# semantics (evaluates at spawn, enqueues result via green_spawn_value).
# Existing callers using green_spawn get cooperative deferral; green_spawn_value
# is unchanged (pre-computed values use value_mode:1, always consistent).

class GreenScheduler:
    """Encapsulated scheduler state for the cooperative green-thread queue.

    `ready_count`/`done_count` are AGGREGATE counters over both task classes
    (deferred closures from green_spawn and pre-computed value slots from
    green_spawn_value); green_ready_count() reports the outstanding total from
    them.

    `value_ready`/`value_done` count ONLY the pre-computed value slots. A value
    handle's completion is its position in the value sequence, so it must be
    compared against `value_done`, never against the aggregate `done_count` —
    otherwise running an unrelated deferred task (which bumps `done_count`)
    flips an untouched value handle to is_done()==true while
    green_ready_count() still reports it outstanding.
    """
    next_id: usize
    ready_count: usize
    done_count: usize
    value_ready: usize
    value_done: usize

class GreenTask:
    """A pending deferred task stored in the module-level task table."""
    task_id: usize
    thunk: fn() -> i64
    result: i64
    has_result: bool
    has_error: bool
    error_reason: text

class GreenThreadHandle:
    """Handle for a cooperative green thread."""
    task_id: usize
    value_mode: usize
    value_order: usize
    value_result: i64

    fn id() -> usize:
        self.task_id

    fn is_done() -> bool:
        if self.value_mode == 1:
            return self.value_order <= GREEN_SCHEDULER.value_done
        if self.value_mode == 2:
            var i: usize = 0
            while i < GREEN_TASKS.len():
                val t = GREEN_TASKS[i]
                if t.task_id == self.task_id:
                    return t.has_result or t.has_error
                i = i + 1
            return false
        false

    fn join() -> i64:
        if not self.is_done():
            return 0
        if self.value_mode == 1:
            return self.value_result
        if self.value_mode == 2:
            var i: usize = 0
            while i < GREEN_TASKS.len():
                val t = GREEN_TASKS[i]
                if t.task_id == self.task_id:
                    return t.result
                i = i + 1
            return 0
        0

var GREEN_SCHEDULER: GreenScheduler = GreenScheduler(next_id: 1, ready_count: 0, done_count: 0, value_ready: 0, value_done: 0)
var GREEN_TASKS: [GreenTask] = []

# Self-report slot for the currently-running thunk. Reset to "" by
# green_run_one() immediately before invoking a thunk; a thunk body that wants
# to mark its own run as failed calls green_fail(reason), which writes here.
# Read back once the thunk returns — see the ERROR CAPTURE header note above.
var GREEN_CURRENT_ERROR: text = ""

export GreenThreadHandle
export green_spawn, green_spawn_eager, green_spawn_value, green_fail
export green_task_error, green_ready_count, green_run_one, green_run_all

fn green_spawn(task: fn() -> i64) -> GreenThreadHandle:
    """Schedule a closure cooperatively — body executes on green_run_one/green_run_all, not at spawn."""
    val task_id = GREEN_SCHEDULER.next_id
    GREEN_SCHEDULER.next_id = GREEN_SCHEDULER.next_id + 1
    GREEN_SCHEDULER.ready_count = GREEN_SCHEDULER.ready_count + 1
    val pending = GreenTask(
        task_id: task_id,
        thunk: task,
        result: 0,
        has_result: false,
        has_error: false,
        error_reason: ""
    )
    GREEN_TASKS = GREEN_TASKS.push(pending)
    GreenThreadHandle(task_id: task_id, value_mode: 2, value_order: 0, value_result: 0)

fn green_spawn_eager(task: fn() -> i64) -> GreenThreadHandle:
    """Schedule a closure eagerly — body executes immediately at spawn (old behavior)."""
    green_spawn_value(task())

fn green_spawn_value(result: i64) -> GreenThreadHandle:
    """Schedule an already computed result on the cooperative queue."""
    val task_id = GREEN_SCHEDULER.next_id
    GREEN_SCHEDULER.next_id = GREEN_SCHEDULER.next_id + 1
    # Position in the VALUE sequence — not in the aggregate ready sequence, so
    # that deferred-task completions never satisfy this handle's is_done().
    val value_order = GREEN_SCHEDULER.value_ready + 1
    GREEN_SCHEDULER.value_ready = GREEN_SCHEDULER.value_ready + 1
    GREEN_SCHEDULER.ready_count = GREEN_SCHEDULER.ready_count + 1
    GreenThreadHandle(task_id: task_id, value_mode: 1, value_order: value_order, value_result: result)

fn green_fail(reason: text) -> i64:
    """Report the currently-running green thunk as errored with `reason`.

    Call from inside a green_spawn thunk body. green_run_one() records this
    against the task that was running when the call happened and surfaces it
    via green_task_error(). Returns 0 for convenience as a thunk tail
    expression (e.g. `fn bad() -> i64: return green_fail("boom")`); the
    returned i64 is otherwise not treated specially.
    """
    GREEN_CURRENT_ERROR = reason
    0

fn green_task_error(task_id: usize) -> text:
    """Return the per-task death reason if the task errored, empty string otherwise."""
    var i: usize = 0
    while i < GREEN_TASKS.len():
        val t = GREEN_TASKS[i]
        if t.task_id == task_id:
            if t.has_error:
                return t.error_reason
            return ""
        i = i + 1
    ""

fn green_ready_count() -> usize:
    GREEN_SCHEDULER.ready_count - GREEN_SCHEDULER.done_count

fn green_run_one() -> bool:
    """Run one pending deferred task or advance one pre-computed value to done."""
    # First, find the next deferred task that hasn't run yet.
    var found_idx: usize = 0
    var found: bool = false
    var i: usize = 0
    while i < GREEN_TASKS.len():
        val t = GREEN_TASKS[i]
        if (not t.has_result) and (not t.has_error):
            found_idx = i
            found = true
            i = GREEN_TASKS.len()
        i = i + 1
    if found:
        val t = GREEN_TASKS[found_idx]
        GREEN_CURRENT_ERROR = ""
        val ran_result: i64 = t.thunk()
        val reported_error = GREEN_CURRENT_ERROR
        GREEN_CURRENT_ERROR = ""
        val ran_failed = reported_error != ""
        var updated = GreenTask(
            task_id: t.task_id,
            thunk: t.thunk,
            result: ran_result,
            has_result: not ran_failed,
            has_error: ran_failed,
            error_reason: reported_error
        )
        var new_tasks: [GreenTask] = []
        var j: usize = 0
        while j < GREEN_TASKS.len():
            if j == found_idx:
                new_tasks = new_tasks.push(updated)
            else:
                new_tasks = new_tasks.push(GREEN_TASKS[j])
            j = j + 1
        GREEN_TASKS = new_tasks
        GREEN_SCHEDULER.done_count = GREEN_SCHEDULER.done_count + 1
        return true
    # No deferred tasks; advance a pre-computed slot if any remain.
    # This is the ONLY site that may advance `value_done` — deferred-task
    # completions above bump the aggregate `done_count` alone.
    if GREEN_SCHEDULER.done_count < GREEN_SCHEDULER.ready_count:
        GREEN_SCHEDULER.done_count = GREEN_SCHEDULER.done_count + 1
        GREEN_SCHEDULER.value_done = GREEN_SCHEDULER.value_done + 1
        return true
    false

fn green_run_all() -> usize:
    """Run all currently ready green threads (deferred + pre-computed)."""
    var ran: usize = 0
    while green_run_one():
        ran = ran + 1
    ran
