"""
# sosix — host OS facade

Tools depend on `sosix_*` instead of native/POSIX primitives directly. See
`host_facade.spl` for the overhead policy and the SimpleOS-`src/os/sosix`
distinction.
"""

export use std.nogc_async_mut.sosix.host_facade.{
    SosixRun, SosixProcUsage,
    sosix_platform, sosix_run, sosix_spawn, sosix_is_running,
    sosix_kill, sosix_proc_usage, sosix_which
}
