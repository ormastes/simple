# Untyped-evidence capture adapter (category-1 migration lane).
#
# Design: doc/05_design/infra/sspec/untyped_evidence_migration_design.md
#
# Most existing specs never built a `ScenarioEvidenceArtifact` at all — they
# assert on a raw captured value (process stdout, rendered text, a log line)
# directly with `to_contain`/`to_equal`. `legacy_facade.spl` has nothing to
# adapt there: there is no old-style artifact object to convert. This module
# is the minimal adapter for exactly that shape — category 1 in the design
# doc's triage (a real captured value, never wrapped in any evidence
# envelope). It is deliberately NOT for category 2 (in-memory value
# comparisons with no capture) or category 3 (print-only, no assertion at
# all) — see the design doc for why those are out of scope for this lane.
#
# Unlike `legacy_facade`, there is no old struct to convert losslessly: the
# adapter's only job is to wrap an already-captured raw value into one
# `EvidenceNode` at path "value", tagged with `source_kind` so a reader can
# tell an untyped migration from a fully typed one in the generated manual.
# It deliberately does not attempt to infer structure from the raw text —
# that is what the format adapters (`text_protocol`, `json_document`) are
# for, when the raw text actually has that structure.

use std.common.spec.evidence.model.{
    CanonicalEvidence, EvidenceNode, canonical_evidence, canonical_evidence_parse_error,
    evidence_node_at
}

# The fixed set of source kinds this adapter accepts. A typo'd source_kind
# would silently mislabel evidence in the generated manual (e.g. a log line
# read back as if it were rendered UI text), so it is validated rather than
# accepted as free-form text.
pub fn untyped_capture_source_kind_valid(source_kind: text) -> bool:
    source_kind == "stdout" or source_kind == "rendered_text" or source_kind == "log_line"

pub struct UntypedCapture:
    label: text
    raw_value: text
    source_kind: text

pub fn untyped_capture(label: text, raw_value: text, source_kind: text) -> UntypedCapture:
    UntypedCapture(label: label, raw_value: raw_value, source_kind: source_kind)

# Converts an untyped capture into CanonicalEvidence with one node at path
# "value". An empty `raw_value` is a legitimate captured value (e.g. a process
# that produced no stdout) and still yields a valid node — that is different
# from a MISSING capture, which this function never sees (the caller is
# responsible for not calling it when no capture happened at all).
#
# An unrecognized `source_kind` fails closed via `canonical_evidence_parse_error`
# rather than silently accepting the typo, consistent with the rest of the
# typed-evidence pipeline's fail-closed rules.
pub fn untyped_capture_to_canonical(capture: UntypedCapture, profile_id: text) -> CanonicalEvidence:
    if not untyped_capture_source_kind_valid(capture.source_kind):
        return canonical_evidence_parse_error(
            "untyped_capture",
            profile_id,
            "unrecognized source_kind: " + capture.source_kind
        )
    val nodes: [EvidenceNode] = [
        evidence_node_at("value", capture.raw_value, 0)
    ]
    canonical_evidence("untyped_capture:" + capture.source_kind, profile_id, nodes)
