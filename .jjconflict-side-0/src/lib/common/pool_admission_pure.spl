# pool_admission_pure.spl — pure-Simple twins for the DETERMINISTIC half of
# the `rt_pool_state_*_v1` / `rt_pool_task_*_v1` concurrency ABI
# (src/runtime/runtime_pool.c), written for the rt_* dual-implementation
# directive.
#
# Spec: test/01_unit/lib/common/spec/pool_admission_contract_spec.spl
#
# NOT a `@dual_pair` module, and deliberately so. The C counterparts named
# below CANNOT be dual-run under `bin/simple test` (the tree-walk interpreter,
# and the only engine `check-dual-run-shadow.shs` invokes): every one of them
# dispatches to a Rust stub in interpreter_extern/concurrency.rs, not to
# runtime_pool.c. `rt_pool_state_*_v1` / `rt_pool_task_*_v1` route to
# `rt_pool_state_v1_unavailable`, which RAISES "PoolStateV1 requires the
# native runtime" (measured 2026-09-02); rt_pool_submit/is_done/join/
# get_parallelism return fabricated constants. Annotating a `@dual_pair`
# against any of them would report a green pair to the gate while comparing
# nothing. The spec therefore pins these twins against the C SOURCE literally.
#
# C counterparts this module ports (for traceability, NOT gated pairs):
#   pool_state_capacity_admits      <- rt_pool_state_create_v1 (admission only)
#   pool_state_query_invalid        <- rt_pool_state_pending_v1 et al.
#   pool_state_lifecycle_invalid    <- rt_pool_state_close_v1 / _destroy_v1
#   pool_task_status_invalid        <- rt_pool_task_status_i64_v1
#   pool_submit_reject_code         <- rt_pool_state_try_submit_i64_v1
#   pool_handle_encode/_slot/_generation/_is_structurally_valid
#                                   <- rt_pool_v1_handle_encode/_decode (static)
#
# WHY ONLY THIS HALF — stated rather than glossed. Nearly every symbol in
# runtime_pool.c/runtime_thread.c bottoms out in pthread_mutex_lock /
# pthread_cond_wait / CreateThread. A "twin" of those would just call the same
# primitive, which is theatre, not an oracle. What IS genuinely implementable
# in Simple, and genuinely worth comparing, is the ADMISSION and ERROR-CONTRACT
# layer that runs BEFORE any lock is taken:
#   * capacity validation in rt_pool_state_create_v1 (`capacity < 1 ||
#     capacity > RT_POOL_STATE_MAX_CAPACITY` -> 0), which is pure arithmetic;
#   * the invalid-handle sentinels every query returns from its
#     `state == NULL` early-out, before the mutex;
#   * the try_submit rejection codes (-3 bad handle / -2 closed / -1 full);
#   * the handle slot/generation bit layout.
# These are decided with no scheduling, so they are REPRODUCIBLE — which is
# what makes a dual-run comparison meaningful here at all.
#
# DETERMINISM STORY: every function below is a pure function of its arguments
# — no clock, no allocation, no shared state, and above all no dependence on
# thread interleaving. That is the whole selection criterion: these are exactly
# the parts of the pool ABI whose answer is fixed before any lock is taken, so
# they are reproducible run to run. Pool counters observed while workers run
# (pending/running/outstanding/completed under live tasks) are NOT twinned,
# because their value depends on scheduling and no deterministic comparison
# against them exists.
#
# CONSTANTS mirrored from runtime_pool.c / runtime_thread.c:
#   RT_POOL_STATE_MAX_CAPACITY 65534   (runtime_pool.c:95)
#   RT_POOL_V1_MAX_HANDLES     65536   (runtime_thread.c:504)

# --- capacity admission (rt_pool_state_create_v1) -------------------------

pub fn pool_state_max_capacity() -> i64:
    65534

# True exactly when rt_pool_state_create_v1 would return a NON-ZERO handle.
# C: `if (capacity < 1 || capacity > RT_POOL_STATE_MAX_CAPACITY) return 0;`
# The only other zero-return is calloc failure, which is not reachable for the
# capacities this pair exercises.
pub fn pool_state_capacity_admits(capacity: i64) -> bool:
    if capacity < 1:
        return false
    if capacity > pool_state_max_capacity():
        return false
    true

# --- invalid-handle contracts --------------------------------------------

# rt_pool_state_pending_v1 / _running_v1 / _outstanding_v1 / _completed_v1 all
# early-out with -1 when the handle resolves to NULL, before taking the lock.
pub fn pool_state_query_invalid() -> i64:
    -1

# rt_pool_state_close_v1 / _destroy_v1 / _join_idle_v1 early-out with 0
# (falsy = "did not act") on a NULL state.
pub fn pool_state_lifecycle_invalid() -> i64:
    0

# rt_pool_task_status_i64_v1 returns -1 for a NULL task OR a task whose state
# is NULL. Live statuses are 0=pending 1=done 2=joined 3=released.
pub fn pool_task_status_invalid() -> i64:
    -1

# --- try_submit rejection codes ------------------------------------------

# rt_pool_state_try_submit_i64_v1 rejection ladder, in C's own order:
#   handle does not resolve      -> -3
#   task allocation failed       -> -3   (not modelled; unreachable in test)
#   state closed or destroying   -> -2
#   outstanding >= capacity      -> -1
# A successful submit returns a non-negative task handle, which is NOT
# predictable from inputs alone and is therefore not twinned.
pub fn pool_submit_reject_code(handle_resolves: bool, closed: bool, outstanding: i64, capacity: i64) -> i64:
    if not handle_resolves:
        return -3
    if closed:
        return -2
    if outstanding >= capacity:
        return -1
    0

# --- handle bit layout (rt_pool_v1_handle_encode / _decode) ---------------

# C: `(int64_t)(((uint64_t)generation << 32) | (uint64_t)slot)`
pub fn pool_handle_encode(slot: i64, generation: i64) -> i64:
    val s = slot & 0xFFFFFFFF
    val g = generation & 0xFFFFFFFF
    (g * 0x100000000) + s

# C: `*slot = (uint32_t)(raw & 0xffffffffu)`
pub fn pool_handle_slot(handle: i64) -> i64:
    handle & 0xFFFFFFFF

# C: `*generation = (uint32_t)(raw >> 32)` — logical shift on the unsigned
# reinterpretation, so mask back to 32 bits after the arithmetic shift.
pub fn pool_handle_generation(handle: i64) -> i64:
    (handle / 0x100000000) & 0xFFFFFFFF

# C: `return *slot > 0 && *slot < RT_POOL_V1_MAX_HANDLES && *generation != 0;`
pub fn pool_handle_is_structurally_valid(handle: i64) -> bool:
    val slot = pool_handle_slot(handle)
    val generation = pool_handle_generation(handle)
    slot > 0 and slot < 65536 and generation != 0
