# index_engine.spl — P2: replays IndexOperationV1 (add/replace/delete) over a
# Segment, enforcing the §14.4/§14.12 contract:
#   * idempotent `replace` by (id, revision) — replaying the same (id,
#     revision) that is already indexed is a no-op, not an error/duplicate.
#   * delete of an absent id is a no-op.
#   * the delete precondition is a closed tagged choice: before_revision and
#     before_hash must be BOTH null (delete_absent) or BOTH non-null
#     (delete_present) — a mixed pair is rejected.
#   * clean rebuild (`IndexEngine.of_documents`) is equivalent (same
#     `logical_root`) to any equivalent history of add/replace/delete deltas,
#     because every mutation re-derives the segment via `Segment.build` over
#     the full document set — there is no separate incremental hashing path
#     to drift from the rebuild path.

use std.common.search.document.{ScopedSearchDocumentV1}
use std.common.search.snapshot.{IndexOperationV1}
use std.common.search.segment.{Segment}

struct IndexEngine:
    segment: Segment

impl IndexEngine:
    static fn empty() -> IndexEngine:
        IndexEngine(segment: Segment.build([]))

    static fn of_documents(docs: [ScopedSearchDocumentV1]) -> IndexEngine:
        IndexEngine(segment: Segment.build(docs))

    fn logical_root() -> text:
        self.segment.logical_root

    fn document_count() -> i64:
        self.segment.document_count()

    fn find(document_id: text) -> ScopedSearchDocumentV1?:
        self.segment.find(document_id)

    # Enumerates every document currently held by this engine, in the
    # segment's canonical (ascending unsigned-UTF8 document_id) order. Added
    # for the P0-P5 query orchestrator (`query_exec.spl`), which must score
    # every corpus document against a query and has no other way to reach the
    # full document set through this type's prior surface.
    fn documents() -> [ScopedSearchDocumentV1]:
        self.segment.documents

    fn contains(document_id: text) -> bool:
        self.segment.contains(document_id)

    # Applies a single operation, returning the new engine on success. The
    # receiver is never mutated in place (value semantics) — callers must use
    # the returned engine.
    fn apply_operation(op: IndexOperationV1) -> Result<IndexEngine, text>:
        if not op.has_closed_preconditions():
            return Err("invalid_precondition")
        if op.kind == "add":
            return self._apply_add(op)
        if op.kind == "replace":
            return self._apply_replace(op)
        if op.kind == "delete":
            return self._apply_delete(op)
        Err("unknown_operation_kind")

    fn _apply_add(op: IndexOperationV1) -> Result<IndexEngine, text>:
        val after = op.after
        if after == nil:
            return Err("invalid_precondition")
        val doc = after.unwrap()
        val existing = self.segment.find(op.document_id)
        if existing != nil:
            val current = existing.unwrap()
            if current.revision == doc.revision:
                # Idempotent: identical (id, revision) already indexed.
                return Ok(self)
            return Err("id_exists")
        var next: [ScopedSearchDocumentV1] = []
        var i = 0
        while i < self.segment.documents.len():
            next.push(self.segment.documents[i])
            i = i + 1
        next.push(doc)
        Ok(IndexEngine(segment: Segment.build(next)))

    fn _apply_replace(op: IndexOperationV1) -> Result<IndexEngine, text>:
        val after = op.after
        if after == nil:
            return Err("invalid_precondition")
        val doc = after.unwrap()
        val existing = self.segment.find(op.document_id)
        if existing == nil:
            return Err("not_found")
        val current = existing.unwrap()
        # Idempotent replace by (id, revision): replaying a replace whose
        # target revision is already what's indexed is a no-op.
        if current.revision == doc.revision:
            return Ok(self)
        val before_revision = op.before_revision
        val before_hash = op.before_hash
        if before_revision == nil or before_hash == nil:
            return Err("invalid_precondition")
        if current.revision != before_revision.unwrap():
            return Err("precondition_mismatch")
        if current.scoped_content_hash != before_hash.unwrap():
            return Err("precondition_mismatch")
        var next: [ScopedSearchDocumentV1] = []
        var i = 0
        while i < self.segment.documents.len():
            if self.segment.documents[i].document_id != op.document_id:
                next.push(self.segment.documents[i])
            i = i + 1
        next.push(doc)
        Ok(IndexEngine(segment: Segment.build(next)))

    fn _apply_delete(op: IndexOperationV1) -> Result<IndexEngine, text>:
        val existing = self.segment.find(op.document_id)
        if existing == nil:
            # Delete of an absent id is always a no-op, regardless of which
            # precondition tag the caller supplied.
            return Ok(self)
        val current = existing.unwrap()
        val before_revision = op.before_revision
        val before_hash = op.before_hash
        if before_revision != nil or before_hash != nil:
            # delete_present: caller asserted prior state — it must match.
            if before_revision == nil or before_hash == nil:
                return Err("invalid_precondition")
            if current.revision != before_revision.unwrap():
                return Err("precondition_mismatch")
            if current.scoped_content_hash != before_hash.unwrap():
                return Err("precondition_mismatch")
        var next: [ScopedSearchDocumentV1] = []
        var i = 0
        while i < self.segment.documents.len():
            if self.segment.documents[i].document_id != op.document_id:
                next.push(self.segment.documents[i])
            i = i + 1
        Ok(IndexEngine(segment: Segment.build(next)))

    # Replays a whole operation history in order, short-circuiting on the
    # first error.
    fn apply_operations(ops: [IndexOperationV1]) -> Result<IndexEngine, text>:
        var engine = self
        var i = 0
        while i < ops.len():
            engine = engine.apply_operation(ops[i])?
            i = i + 1
        Ok(engine)
