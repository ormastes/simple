# segment.spl — P2: an in-memory document segment plus a deterministic
# logical-root digest over its contents.
#
# The "logical root" is defined by the plan as: sha256 of canonical JSON over
# ScopedSearchDocumentV1, sorted by unsigned UTF-8 document id. Wiring the full
# app.spipe_knowledge_provider.canonical_json_emitter pipeline through this
# lib-level module pulls in a heavy app-owned dependency graph for a value
# that only needs to be a STABLE, ORDER-INDEPENDENT digest of document
# content; we take the documented interim path instead: build one
# deterministic delimited text encoding (fields/facets sorted by name, values
# escaped so a delimiter inside a value cannot create a collision) and hash it
# with std.common.crypto.sha256.sha256_text. This is NOT canonical JSON — it is
# a clearly-named, deterministic stand-in documented as such (task contract
# point 4's explicitly sanctioned interim).

use std.common.crypto.sha256.{sha256_text}
use std.common.search.document.{ScopedSearchDocumentV1, ScopedFieldV1, ScopedFacetV1}

# Ascending unsigned-UTF8-byte comparator, replicated locally (mirrors the
# pattern in ranking.spl's private `_utf8_text_lt` — that fn is private to
# ranking.spl and cannot be imported).
pub fn unsigned_utf8_lt(a: text, b: text) -> bool:
    val ab = a.bytes()
    val bb = b.bytes()
    var i = 0
    while i < ab.len() and i < bb.len():
        val av = ab[i].to_i64()
        val bv = bb[i].to_i64()
        if av < bv:
            return true
        if av > bv:
            return false
        i = i + 1
    ab.len() < bb.len()

# Escapes `\` and the delimiter `|` so a value cannot forge a field boundary.
fn _escape(value: text) -> text:
    var out = ""
    var i = 0
    val bytes = value.bytes()
    while i < bytes.len():
        val b = bytes[i]
        if b == 92u8 or b == 124u8:
            out = out + "\\"
        out = out + value.substring(i, i + 1)
        i = i + 1
    out

fn _sorted_field_names(fields: [ScopedFieldV1]) -> [text]:
    var names: [text] = []
    var i = 0
    while i < fields.len():
        names.push(fields[i].name)
        i = i + 1
    # simple insertion sort — segments are small (field/facet counts, not doc counts)
    var j = 1
    while j < names.len():
        val key = names[j]
        var k = j - 1
        while k >= 0 and unsigned_utf8_lt(key, names[k]):
            names[k + 1] = names[k]
            k = k - 1
        names[k + 1] = key
        j = j + 1
    names

fn _field_value(fields: [ScopedFieldV1], name: text) -> text:
    var i = 0
    while i < fields.len():
        if fields[i].name == name:
            return fields[i].value
        i = i + 1
    ""

fn _sorted_facet_names(facets: [ScopedFacetV1]) -> [text]:
    var names: [text] = []
    var i = 0
    while i < facets.len():
        names.push(facets[i].name)
        i = i + 1
    var j = 1
    while j < names.len():
        val key = names[j]
        var k = j - 1
        while k >= 0 and unsigned_utf8_lt(key, names[k]):
            names[k + 1] = names[k]
            k = k - 1
        names[k + 1] = key
        j = j + 1
    names

fn _facet_value(facets: [ScopedFacetV1], name: text) -> text:
    var i = 0
    while i < facets.len():
        if facets[i].name == name:
            return facets[i].value
        i = i + 1
    ""

# Deterministic encoding of one ScopedSearchDocumentV1: field/facet order does
# not affect the result (both are re-sorted by name here), so two documents
# that differ only in array order encode identically.
pub fn document_digest_input(doc: ScopedSearchDocumentV1) -> text:
    var out = "id=" + _escape(doc.document_id)
    out = out + "|rev=" + _escape(doc.revision)
    out = out + "|vis=" + _escape(doc.visibility_digest)
    out = out + "|hash=" + _escape(doc.scoped_content_hash)
    out = out + "|scope=" + _escape(doc.scope_digest)
    val field_names = _sorted_field_names(doc.fields)
    var fi = 0
    while fi < field_names.len():
        out = out + "|f:" + _escape(field_names[fi]) + "=" + _escape(_field_value(doc.fields, field_names[fi]))
        fi = fi + 1
    val facet_names = _sorted_facet_names(doc.facets)
    var ci = 0
    while ci < facet_names.len():
        out = out + "|c:" + _escape(facet_names[ci]) + "=" + _escape(_facet_value(doc.facets, facet_names[ci]))
        ci = ci + 1
    out

# A segment: an immutable, ordered (by document id) set of documents plus the
# logical root digest over that set. `documents` is ALWAYS stored sorted by
# unsigned UTF-8 document_id so equality/iteration is deterministic.
struct Segment:
    documents: [ScopedSearchDocumentV1]
    logical_root: text

impl Segment:
    # Builds a segment from an unordered document set: sorts by id, then
    # digests each document and hashes the newline-joined per-document digests
    # (order-stable because the input is sorted first).
    static fn build(docs: [ScopedSearchDocumentV1]) -> Segment:
        var sorted: [ScopedSearchDocumentV1] = []
        var i = 0
        while i < docs.len():
            sorted.push(docs[i])
            i = i + 1
        var j = 1
        while j < sorted.len():
            val key = sorted[j]
            var k = j - 1
            while k >= 0 and unsigned_utf8_lt(key.document_id, sorted[k].document_id):
                sorted[k + 1] = sorted[k]
                k = k - 1
            sorted[k + 1] = key
            j = j + 1
        var digest_input = ""
        var d = 0
        while d < sorted.len():
            digest_input = digest_input + document_digest_input(sorted[d]) + "\n"
            d = d + 1
        Segment(documents: sorted, logical_root: sha256_text(digest_input))

    fn document_count() -> i64:
        self.documents.len()

    fn find(document_id: text) -> ScopedSearchDocumentV1?:
        var i = 0
        while i < self.documents.len():
            if self.documents[i].document_id == document_id:
                return self.documents[i]
            i = i + 1
        nil

    fn contains(document_id: text) -> bool:
        self.find(document_id) != nil
