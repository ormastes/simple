# PixelSurface producer for the shared WM content-frame boundary.

use common.ui.window_scene.{
    WM_CONTENT_ORIGIN_PIXEL_SURFACE,
    WmContentFrame,
    wm_content_frame_checksum,
}

fn pixel_surface_content_frame(
    window_id: text,
    parent_window_id: text,
    offset_x: i32,
    offset_y: i32,
    width: i32,
    height: i32,
    pixels: [u32],
    scene_revision: i64,
    content_revision: i64,
) -> WmContentFrame:
    if (window_id == "" or width <= 0 or height <= 0 or
        pixels.len() != width * height or scene_revision <= 0 or
        content_revision <= 0):
        return WmContentFrame(
            window_id: window_id,
            scene_revision: scene_revision,
            content_revision: content_revision,
            origin_kind: WM_CONTENT_ORIGIN_PIXEL_SURFACE,
            width: width,
            height: height,
            pixels: [],
            checksum: 0u64,
            parent_window_id: parent_window_id,
            offset_x: offset_x,
            offset_y: offset_y
        )
    WmContentFrame(
        window_id: window_id,
        scene_revision: scene_revision,
        content_revision: content_revision,
        origin_kind: WM_CONTENT_ORIGIN_PIXEL_SURFACE,
        width: width,
        height: height,
        pixels: pixels,
        checksum: wm_content_frame_checksum(pixels),
        parent_window_id: parent_window_id,
        offset_x: offset_x,
        offset_y: offset_y
    )
