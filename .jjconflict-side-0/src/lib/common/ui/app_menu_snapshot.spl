# app_menu_snapshot.spl -- L8: application menu snapshot value types.
#
# Design authority: doc/05_design/ui/unified_packed_ui_scene.md section 6.
# Research: doc/01_research/local/unified_packed_ui_scene.md section 6.2
# ("the struct is adopted as written").
# Lane: L8, doc/03_plan/ui/unified_packed_ui_scene_agent_lanes.md.
#
# Pure value vocabulary only -- flat side-table ranges, not nested arrays in
# the hot path (research section 6.2). The nested Menu/MenuItem convenience
# DSL is explicitly deferred (design section 6): this flat snapshot is the
# only v1 surface. No arena, no registry, no I/O -- those live in
# app_menu_registry.spl.

use common.ui.draw_ir_v3.{DRAW_IR_V3_NO_ID}

struct AppMenuSnapshot:
    app_id: u32
    app_generation: u32
    menu_revision: u32
    focused_owner_id: u32
    # Flat side-table ranges into AppMenuRegistry's item/label/action columns.
    root_start: u32
    root_count: u32
    item_start: u32
    item_count: u32
    action_start: u32
    action_count: u32

# Menu item storage row (research section 6.2): numeric ids only, no text
# inline -- `label_string_id` indexes the registry's label column.
struct AppMenuItemRow:
    menu_item_id: u32
    parent_item_id: u32
    label_string_id: u32
    action_id: u32
    flags: u32
    shortcut_id: u32
    enabled: bool
    checked: bool
    submenu_start: u32
    submenu_count: u32

# Shell-default snapshot: no active application (design section 6.4, "With
# no active application, show a shell-default menu"). Zero item/action
# ranges -- a valid, empty menu, not a sentinel error state.
fn app_menu_snapshot_blank() -> AppMenuSnapshot:
    AppMenuSnapshot(
        app_id: DRAW_IR_V3_NO_ID, app_generation: 0u32, menu_revision: 0u32,
        focused_owner_id: DRAW_IR_V3_NO_ID,
        root_start: 0u32, root_count: 0u32,
        item_start: 0u32, item_count: 0u32,
        action_start: 0u32, action_count: 0u32
    )

export AppMenuSnapshot, AppMenuItemRow, app_menu_snapshot_blank
