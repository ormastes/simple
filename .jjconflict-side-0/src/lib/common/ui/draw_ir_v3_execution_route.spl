    DRAW_IR_V3_REASON_NO_DEVICE, DRAW_IR_V3_REASON_MISSING_CAPABILITY,
    DRAW_IR_V3_REASON_CAPACITY_OVERFLOW, DRAW_IR_V3_REASON_DEVICE_FAULT,
    DrawIrV3ExecutionProfile, DrawIrV3RouteDecision,
    draw_ir_v3_reason_is_policy, draw_ir_v3_reason_is_denial,
    draw_ir_v3_route_is_cpu_selected, draw_ir_v3_route_is_gpu_fallback,
    draw_ir_v3_route_decision_is_consistent,
    draw_ir_v3_mode_required_capabilities, draw_ir_v3_missing_capabilities,
    draw_ir_v3_profile_for_mode, draw_ir_v3_profile_cpu_only,
    draw_ir_v3_profile_balanced, draw_ir_v3_profile_full_offload,
    draw_ir_v3_route_select, draw_ir_v3_route_device_fault,
    draw_ir_v3_route_capacity_denial, draw_ir_v3_route_apply_capacity,
