# Fixed — constant-shape big integers for secret-dependent arithmetic.
#
# A `Fixed` is a BigNat pinned to a fixed limb count `n`. Unlike the variable-
# length `bignat` layer, nothing here shortens, normalizes, or early-exits based
# on the VALUE of a limb: every routine walks all `n` limbs, and every
# conditional is expressed as an arithmetic mask (`cond_select` / `cond_swap`)
# rather than a branch. That is what makes this the layer secret material —
# scalars, private exponents, field elements — is allowed to flow through.
#
# The one thing this layer does NOT claim is a constant-time *machine*: the
# interpreter and JIT are free to make `i64` ops data-dependent. The invariant
# maintained here is at the algorithm level (uniform trip counts, no
# value-dependent control flow), which is the necessary precondition for a
# constant-time backend and is what the specs pin.
#
# Values are always rebuilt with the `Fixed(n: ..., limbs: [...])` constructor
# rather than mutated in place — in-place `a.limbs[i] = x` does not persist
# through the interpreter, so constructor-rebind is the only reliable form.
#
# Pure functions only (src/lib/common tier): no I/O, no externs, no state.
#
# Usage: use std.math.bignum.fixed.{Fixed, fx_zero, add_fixed, mod_exp_ct, ...}

use std.math.bignum.limb.{LIMB_BITS, LIMB_BASE, LIMB_MASK, limb_mul, add_limbs, sub_limbs}
use std.math.bignum.bignat.{normalize as bn_normalize}

pub struct Fixed:
    n: i64
    limbs: [i64]

# =============================================================================
# Constructors and Conversion
# =============================================================================

pub fn fx_zero(n: i64) -> Fixed:
    """A Fixed of width `n` with every limb zero."""
    var ls: [i64] = []
    var i = 0
    while i < n:
        ls.push(0)
        i = i + 1
    Fixed(n: n, limbs: ls)

pub fn fx_one(n: i64) -> Fixed:
    """A Fixed of width `n` holding the value one."""
    var ls: [i64] = []
    var i = 0
    while i < n:
        if i == 0:
            ls.push(1)
        else:
            ls.push(0)
        i = i + 1
    Fixed(n: n, limbs: ls)

pub fn fx_clone(a: Fixed) -> Fixed:
    """Deep copy — the limb array is rebuilt, not aliased."""
    var ls: [i64] = []
    var i = 0
    while i < a.n:
        ls.push(a.limbs[i])
        i = i + 1
    Fixed(n: a.n, limbs: ls)

pub fn fx_from_bignat(a: [i64], n: i64) -> Fixed:
    """Widen a BigNat to exactly `n` limbs, zero-padding or truncating."""
    var ls: [i64] = []
    var i = 0
    while i < n:
        if i < a.len():
            ls.push(a[i])
        else:
            ls.push(0)
        i = i + 1
    Fixed(n: n, limbs: ls)

pub fn fx_to_bignat(a: Fixed) -> [i64]:
    """Narrow back to a canonical (normalized) BigNat."""
    var ls: [i64] = []
    var i = 0
    while i < a.n:
        ls.push(a.limbs[i])
        i = i + 1
    bn_normalize(ls)

pub fn fx_eq(a: Fixed, b: Fixed) -> bool:
    """Equality over the full width. Differing widths are never equal."""
    if a.n != b.n:
        return false
    var diff = 0
    var i = 0
    while i < a.n:
        diff = diff | (a.limbs[i] - b.limbs[i])
        i = i + 1
    diff == 0

# =============================================================================
# Width-Preserving Addition / Subtraction
# =============================================================================

pub fn add_fixed(a: Fixed, b: Fixed) -> [Fixed]:
    """Sum modulo 2^(30n). Returns `[sum, carry]`; carry.limbs[0] is 0 or 1."""
    var ls: [i64] = []
    var carry = 0
    var i = 0
    while i < a.n:
        val bv = if i < b.n: b.limbs[i] else: 0
        val r = add_limbs(a.limbs[i], bv, carry)
        ls.push(r[0])
        carry = r[1]
        i = i + 1
    var cl: [i64] = [carry]
    [Fixed(n: a.n, limbs: ls), Fixed(n: 1, limbs: cl)]

pub fn sub_fixed(a: Fixed, b: Fixed) -> [Fixed]:
    """Difference modulo 2^(30n). Returns `[diff, borrow]`; borrow is 0 or 1."""
    var ls: [i64] = []
    var borrow = 0
    var i = 0
    while i < a.n:
        val bv = if i < b.n: b.limbs[i] else: 0
        val r = sub_limbs(a.limbs[i], bv, borrow)
        ls.push(r[0])
        borrow = r[1]
        i = i + 1
    var bl: [i64] = [borrow]
    [Fixed(n: a.n, limbs: ls), Fixed(n: 1, limbs: bl)]

# =============================================================================
# Branch-Free Selection
# =============================================================================

pub fn cond_select(c: i64, a: Fixed, b: Fixed) -> Fixed:
    """`a` when c == 1, `b` when c == 0 — via an arithmetic mask, no branch."""
    val mask = 0 - (c & 1)
    var ls: [i64] = []
    var i = 0
    while i < a.n:
        val bv = if i < b.n: b.limbs[i] else: 0
        ls.push(bv ^ ((a.limbs[i] ^ bv) & mask))
        i = i + 1
    Fixed(n: a.n, limbs: ls)

pub fn cond_swap(a: Fixed, b: Fixed, swap: i64) -> [Fixed]:
    """Returns `[b, a]` when swap == 1, `[a, b]` when swap == 0. Branch-free."""
    [cond_select(swap, b, a), cond_select(swap, a, b)]

# =============================================================================
# Comparison
# =============================================================================

pub fn cmp_fixed(a: Fixed, b: Fixed) -> i64:
    """Three-way compare over the full width, in uniform trip count.

    Walks every limb from least to most significant and keeps the verdict of
    the highest-order differing limb, so the loop shape does not depend on
    where the values diverge.
    """
    var verdict = 0
    var i = 0
    while i < a.n:
        val bv = if i < b.n: b.limbs[i] else: 0
        if a.limbs[i] < bv:
            verdict = -1
        elif a.limbs[i] > bv:
            verdict = 1
        i = i + 1
    verdict

pub fn is_zero_ct(a: Fixed) -> bool:
    """True when every limb is zero. Accumulates rather than early-exiting."""
    var acc = 0
    var i = 0
    while i < a.n:
        acc = acc | a.limbs[i]
        i = i + 1
    acc == 0

# =============================================================================
# Multiplication
# =============================================================================

pub fn mul_fixed(a: Fixed, b: Fixed) -> Fixed:
    """Full-width schoolbook product, `a.n + b.n` limbs wide."""
    val width = a.n + b.n
    var acc: [i64] = []
    var k = 0
    while k < width:
        acc.push(0)
        k = k + 1
    var i = 0
    while i < a.n:
        var carry = 0
        var j = 0
        while j < b.n:
            val p = limb_mul(a.limbs[i], b.limbs[j])
            # acc + low + carry is at most 3 * LIMB_MASK < 2^32 — exact in i64.
            val s = acc[i + j] + p[0] + carry
            acc[i + j] = s & LIMB_MASK
            carry = (s >> LIMB_BITS) + p[1]
            j = j + 1
        var pos = i + b.n
        while pos < width:
            val s2 = acc[pos] + carry
            acc[pos] = s2 & LIMB_MASK
            carry = s2 >> LIMB_BITS
            pos = pos + 1
        i = i + 1
    Fixed(n: width, limbs: acc)

# =============================================================================
# Modular Reduction / Exponentiation / Inversion
# =============================================================================

fn fx_widen(a: Fixed, n: i64) -> Fixed:
    """Re-express `a` at width `n` (zero-pad or truncate)."""
    var ls: [i64] = []
    var i = 0
    while i < n:
        if i < a.n:
            ls.push(a.limbs[i])
        else:
            ls.push(0)
        i = i + 1
    Fixed(n: n, limbs: ls)

fn fx_get_bit(a: Fixed, index: i64) -> i64:
    """Bit `index` of `a`, or 0 when out of range."""
    if index < 0:
        return 0
    val limb_index = index / LIMB_BITS
    if limb_index >= a.n:
        return 0
    val bit_index = index - limb_index * LIMB_BITS
    (a.limbs[limb_index] >> bit_index) & 1

fn _reduce_raw(a: [i64], a_n: i64, mw: [i64], w: i64) -> [i64]:
    """Shift-and-subtract reduction on raw limb arrays. Returns `w` limbs.

    This is the fused inner kernel behind `mod_reduce_ct`. The obvious spelling
    — a shift + add + trial-subtract + select per bit, each allocating —
    allocates five arrays and four `Fixed` structs on every one of the ~30*a_n
    iterations, which timed the spec out under the tree-walk interpreter. Fusing
    the shift-in and the trial subtraction into two flat passes over `w` limbs
    keeps the same value-independent shape with no per-bit allocation.

    `rem` stays strictly below the modulus, and `w` carries one spare limb, so
    the doubling can never carry out of the array.
    """
    var rem: [i64] = []
    var trial: [i64] = []
    var z = 0
    while z < w:
        rem.push(0)
        trial.push(0)
        z = z + 1
    var i = a_n * LIMB_BITS - 1
    while i >= 0:
        # Shift left one and inject bit `i` of `a` at the bottom.
        val limb_index = i / LIMB_BITS
        var carry = (a[limb_index] >> (i - limb_index * LIMB_BITS)) & 1
        var k = 0
        while k < w:
            val s = (rem[k] << 1) + carry
            rem[k] = s & LIMB_MASK
            carry = (s >> LIMB_BITS) & 1
            k = k + 1
        # Trial-subtract the modulus; borrow == 0 means it fit.
        var borrow = 0
        k = 0
        while k < w:
            val d = rem[k] - mw[k] - borrow + LIMB_BASE
            trial[k] = d & LIMB_MASK
            borrow = 1 - ((d >> LIMB_BITS) & 1)
            k = k + 1
        # Mask-select the subtracted value without branching on `borrow`.
        val mask = borrow - 1
        k = 0
        while k < w:
            rem[k] = rem[k] ^ ((trial[k] ^ rem[k]) & mask)
            k = k + 1
        i = i - 1
    rem

fn _widen_limbs(a: Fixed, n: i64) -> [i64]:
    """`a`'s limbs re-expressed at width `n` (zero-padded or truncated)."""
    var ls: [i64] = []
    var i = 0
    while i < n:
        if i < a.n:
            ls.push(a.limbs[i])
        else:
            ls.push(0)
        i = i + 1
    ls

pub fn mod_reduce_ct(a: Fixed, m: Fixed) -> Fixed:
    """`a mod m`, returned at the width of `m`.

    Shift-and-subtract binary reduction: the accumulator is built bit by bit
    from the top of `a` downwards, and each step selects between "subtracted"
    and "not subtracted" with an arithmetic mask rather than a branch. The trip
    count depends only on the WIDTHS of `a` and `m`, never on their values, so
    the shape is uniform for a given modulus size.
    """
    if is_zero_ct(m):
        return fx_zero(m.n)
    # One extra limb of headroom so the shift-in never carries out.
    val w = m.n + 1
    val rem = _reduce_raw(a.limbs, a.n, _widen_limbs(m, w), w)
    fx_widen(Fixed(n: w, limbs: rem), m.n)

pub fn mod_exp_ct(base: Fixed, exponent: Fixed, m: Fixed) -> Fixed:
    """`base^exponent mod m` by square-and-multiply, uniform in the exponent.

    Every exponent bit costs exactly one square plus one multiply; the bit only
    selects (via `cond_select`) which of the two results is kept, so the work
    performed is identical for a zero and a one bit.
    """
    if is_zero_ct(m):
        return fx_zero(m.n)
    val w = m.n + 1
    val mw = _widen_limbs(m, w)
    var acc = fx_widen(fx_one(m.n), m.n)
    val b = mod_reduce_ct(base, m)
    var i = exponent.n * LIMB_BITS - 1
    while i >= 0:
        val sq = mul_fixed(acc, acc)
        val squared = fx_widen(Fixed(n: w, limbs: _reduce_raw(sq.limbs, sq.n, mw, w)), m.n)
        val pr = mul_fixed(squared, b)
        val multiplied = fx_widen(Fixed(n: w, limbs: _reduce_raw(pr.limbs, pr.n, mw, w)), m.n)
        acc = cond_select(fx_get_bit(exponent, i), multiplied, squared)
        i = i - 1
    acc

pub fn mod_inv_ct(a: Fixed, m: Fixed) -> Fixed:
    """`a^-1 mod m` via Fermat's little theorem — requires PRIME `m`.

    Computes `a^(m-2) mod m`. This is the standard constant-time inversion for
    a prime modulus; it is NOT a general modular inverse and returns a
    meaningless value for composite `m`.
    """
    var two_limbs: [i64] = []
    var i = 0
    while i < m.n:
        if i == 0:
            two_limbs.push(2)
        else:
            two_limbs.push(0)
        i = i + 1
    val m_minus_2 = sub_fixed(m, Fixed(n: m.n, limbs: two_limbs))
    mod_exp_ct(a, m_minus_2[0], m)
