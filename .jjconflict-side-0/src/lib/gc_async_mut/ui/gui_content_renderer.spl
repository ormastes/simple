# Hosted GUI producer for the shared WM content-frame boundary.

use common.ui.wm_gui_content_frame.{wm_gui_content_frame_from_pixels}
use common.ui.window_scene.{WmContentFrame}
use nogc_sync_mut.ui.session.{UISession}
use std.gc_async_mut.gpu.engine2d.draw_ir_adv.{
    Engine2dResolvedDrawIrImage,
    Engine2dDrawIrTileOutcome,
    engine2d_draw_ir_adv_composition_with_images,
    engine2d_draw_ir_render_composition_damaged,
    engine2d_draw_ir_render_composition_damaged_with_images,
    engine2d_draw_ir_retained_idle,
    engine2d_draw_ir_retained_rejected,
}
use std.gc_async_mut.gpu.engine2d.engine.{Engine2D}
use common.ui.render_opt.damage_plan.{DamagePlan, DAMAGE_PLAN_NONE}

class GuiRetainedRenderSession:
    engine: Engine2D
    width: i32
    height: i32
    backend: text
    seeded: bool

    static fn create(width: i32, height: i32,
                     backend: text) -> GuiRetainedRenderSession:
        GuiRetainedRenderSession(
            engine: Engine2D.create_with_backend(width, height, backend),
            width: width, height: height, backend: backend, seeded: false)

    me seed(session: UISession) -> bool:
        val composition = session.submit_widget_draw_ir(
            self.width, self.height, self.backend)
        self.engine.clear(gui_content_frame_clear_color())
        # Preserve the executor's explicit retained Engine2D result.  The
        # convenience composition API returns a readback receipt, not the
        # mutated engine value needed by a later LOCAL damage replay.
        val seeded = engine2d_draw_ir_render_composition_damaged_with_images(
            self.engine, composition, [],
            [0i64, 0i64, self.width.to_i64(), self.height.to_i64()], false)
        self.engine = seeded.engine
        if seeded.unsupported_kinds != "none" or seeded.ops_rendered <= 0:
            self.seeded = false
            return false
        self.seeded = true
        true

    me render_damage(session: UISession, plan: DamagePlan,
                     readback_frame: bool) -> Engine2dDrawIrTileOutcome:
        if not self.seeded:
            if not self.seed(session):
                return engine2d_draw_ir_retained_rejected(
                    self.engine, "retained-seed-failed")
            return engine2d_draw_ir_retained_idle(
                self.engine, readback_frame)
        if plan.mode == DAMAGE_PLAN_NONE and plan.rects.len() == 0:
            return engine2d_draw_ir_retained_idle(
                self.engine, readback_frame)
        val composition = session.submit_widget_draw_ir(
            self.width, self.height, self.backend)
        val outcome = engine2d_draw_ir_render_composition_damaged(
            self.engine, composition, plan.rects, readback_frame)
        self.engine = outcome.engine
        outcome

    me shutdown():
        self.engine.shutdown()
        self.seeded = false

fn gui_content_frame_clear_color() -> u32:
    """The canonical widget composition owns its first theme-derived seed."""
    0u32

fn gui_session_content_frame(
    session: UISession,
    window_id: text,
    parent_window_id: text,
    offset_x: i32,
    offset_y: i32,
    width: i32,
    height: i32,
    scene_revision: i64,
    content_revision: i64,
    images: [Engine2dResolvedDrawIrImage],
) -> WmContentFrame:
    if width <= 0 or height <= 0:
        return wm_gui_content_frame_from_pixels(
            window_id, parent_window_id, offset_x, offset_y,
            width, height, [], scene_revision, content_revision
        )
    val composition = session.submit_widget_draw_ir(width, height, "cpu")
    var engine = Engine2D.create_with_backend(width, height, "cpu")
    # The canonical widget Draw IR begins with its package-derived opaque
    # surface initializer. Keep the renderer neutral so it cannot shadow or
    # compete with the selected ThemeRenderSnapshot.
    engine.clear(gui_content_frame_clear_color())
    val rendered = engine2d_draw_ir_adv_composition_with_images(
        engine, composition, false, images
    )
    engine.shutdown()
    if (rendered.fallback_required or rendered.skipped_command_count != 0 or
        rendered.pixels.len() != width * height):
        return wm_gui_content_frame_from_pixels(
            window_id, parent_window_id, offset_x, offset_y,
            width, height, [], scene_revision, content_revision
        )
    wm_gui_content_frame_from_pixels(
        window_id, parent_window_id, offset_x, offset_y,
        width, height, rendered.pixels, scene_revision, content_revision
    )

export gui_content_frame_clear_color
export GuiRetainedRenderSession
