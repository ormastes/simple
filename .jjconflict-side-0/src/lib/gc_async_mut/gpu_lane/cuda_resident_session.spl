# CUDA resident/interactive session (Task B4).
#
# Design: doc/05_design/runtime/gpu_remote_interpreter_architecture.md
# section 5.3. Builds on B1's `CudaLaneSession` and B3's per-launch
# `CudaVmExecutor`, adding the three pieces design 5.3 calls out:
#   1. An 8-slot command ring + doorbell protocol (host writes a program
#      slot then rings the doorbell; device polls/services) -- pure
#      host-side byte-buffer logic, unit-testable on any host, same style
#      as A2's `MailboxArena`.
#   2. A watchdog-device refusal gate (`CU_DEVICE_ATTRIBUTE_KERNEL_EXEC_
#      TIMEOUT`) that refuses to start a resident session on a
#      watchdog-enabled device unless `CUDA_RESIDENT_FORCE=1` -- pure,
#      unit-testable via an injectable attribute value (test seam), never
#      requiring real watchdog hardware to exercise.
#   3. `ResidentSession`, a thin session-level wrapper that keeps ONE
#      `CudaLaneSession` + loaded SVM-G module open across multiple
#      program dispatches (design 5.3's ">=1 resident session, N programs"
#      shape), draining PUTC/RESULT/sentinel via A2's `service_trigger`.
#
# ---------------------------------------------------------------------
# KNOWN GAP (documented, not routed around -- same policy as B3's filed
# bugs on this host): design 5.3 calls for (a) a `cuMemHostAlloc(MAPPED|
# PORTABLE)` pinned arena shared by host and device via
# `cuMemHostGetDevicePointer`, (b) a device-resident kernel that loops on
# the command ring using `cuda::atomic_ref<uint32_t, thread_scope_system>`
# for the doorbell/TRIGGER words so PUTC is visible to the host WHILE the
# kernel is still running, and (c) a `CU_DEVICE_ATTRIBUTE_KERNEL_EXEC_
# TIMEOUT` query. None of the three exist in this repo's CUDA SFFI layer
# (`src/lib/nogc_sync_mut/cuda/sffi.spl` has no `cuMemHostAlloc`,
# `cuMemHostGetDevicePointer`, or `cuDeviceGetAttribute` binding -- grep
# confirmed, see the filed bug), and no checked-in PTX artifact implements
# a ring-polling resident kernel (only the per-launch `svmg_interpret`
# entry from B3's `svmg_cuda_kernel.ptx` exists). Adding any of these
# requires a Rust-runtime extern + bootstrap rebuild, which is out of
# scope for this task per "no bootstrap unless essential".
#
# What this module implements instead, honestly scoped:
#   - The command-ring/doorbell protocol state machine and the watchdog
#     refusal gate: REAL, host-independent, fully unit-tested below.
#   - `ResidentSession.run_programs`: runs N SGP programs through ONE
#     open `CudaLaneSession` (one context, one module load, one arena),
#     satisfying the ">=3 programs through one resident session" shape at
#     the session-lifecycle level. Each program dispatch is internally a
#     per-launch `launch_once`/sync/drain (B3's mechanism) rather than a
#     single long-running ring-polling kernel, so PUTC is captured
#     per-program (buffered), not truly live/interleaved mid-kernel. Since
#     programs run strictly sequentially through the same session, output
#     ORDER across programs is still deterministic and verified by the
#     system spec.
#   - The watchdog attribute is read via `watchdog_attr_fn` (defaults to
#     `unknown_watchdog_attr`, which always returns -1/"unknown" since no
#     SFFI binding exists) -- callers needing the real hardware check must
#     supply a `watchdog_attr_fn` once that SFFI lands. Unknown is treated
#     as REFUSE by default (fail-safe), never as an implicit "assume no
#     watchdog".
#
# Filed: doc/08_tracking/bug/cuda_resident_session_missing_mapped_memory_and_watchdog_sffi_2026-08-07.md

mod std.gc_async_mut.gpu_lane.cuda_resident_session

use std.nogc_sync_mut.test_runner.gpu_mailbox.{
    MailboxArena, ARENA_SIZE, service_trigger, ServiceOutcome, ResultRecord,
    drain_log, drain_records}
use std.nogc_sync_mut.io.env_ops.{env_get}
use std.gc_async_mut.gpu_lane.cuda_lane_session.{CudaLaneSession}
use std.gc_async_mut.gpu_lane.cuda_vm_executor.{
    CudaVmExecutor, step_budget_from_env}

# =========================================================================
# Command ring / doorbell protocol (design §5.3, pure host-side bytes)
# =========================================================================

pub val RING_SLOTS: i64 = 8
pub val RING_SLOT_BYTES: i64 = 8   # (sgp_offset: u32, doorbell: u32)
pub val RING_TOTAL_BYTES: i64 = RING_SLOTS * RING_SLOT_BYTES

pub val DOORBELL_CLEAR: u32 = 0u32
pub val DOORBELL_RUNG: u32 = 0x0000DEADu32       # reuses GMB-1 TRIGGER_MAGIC
pub val CMD_SHUTDOWN: u32 = 0x7Eu32
pub val SGP_OFFSET_SHUTDOWN: u32 = 0xFFFFFFFFu32  # sentinel: never a real DATA offset

fn _u32_to_bytes_le(value: u32) -> [u8]:
    [(value & 0xFFu32) as u8, ((value >> 8) & 0xFFu32) as u8,
     ((value >> 16) & 0xFFu32) as u8, ((value >> 24) & 0xFFu32) as u8]

fn _bytes_to_u32_le(b0: u8, b1: u8, b2: u8, b3: u8) -> u32:
    (b0 as u32) | ((b1 as u32) << 8) | ((b2 as u32) << 16) | ((b3 as u32) << 24)

pub class CommandRing:
    """Host-side view of the 8-slot command ring: `(sgp_offset, doorbell)`
    pairs, 8 bytes/slot. A slot is free when `doorbell == DOORBELL_CLEAR`.
    Host writes `sgp_offset` then rings the doorbell (release); a servicer
    (real device, or the test-side `service_next` simulation below) reads
    the slot and clears the doorbell (acquire+ack)."""
    bytes: [u8]

    static fn new() -> CommandRing:
        var buf: [u8] = []
        var i = 0
        while i < RING_TOTAL_BYTES:
            buf.push(0u8)
            i = i + 1
        CommandRing(bytes: buf)

    me fn _slot_off(slot: i64) -> i64:
        slot * RING_SLOT_BYTES

    me fn sgp_offset(slot: i64) -> u32:
        if slot < 0 or slot >= RING_SLOTS:
            return 0u32
        val o = self._slot_off(slot)
        _bytes_to_u32_le(self.bytes[o], self.bytes[o + 1], self.bytes[o + 2], self.bytes[o + 3])

    me fn doorbell(slot: i64) -> u32:
        if slot < 0 or slot >= RING_SLOTS:
            return DOORBELL_RUNG   # out-of-range reads as "busy", never mistaken for free
        val o = self._slot_off(slot) + 4
        _bytes_to_u32_le(self.bytes[o], self.bytes[o + 1], self.bytes[o + 2], self.bytes[o + 3])

    me fn is_free(slot: i64) -> bool:
        self.doorbell(slot) == DOORBELL_CLEAR

    me _set_u32(off: i64, value: u32):
        val le = _u32_to_bytes_le(value)
        self.bytes[off] = le[0]
        self.bytes[off + 1] = le[1]
        self.bytes[off + 2] = le[2]
        self.bytes[off + 3] = le[3]

    me fn next_free_slot() -> i64:
        """First free slot index, -1 if the ring is fully occupied (host
        stalls -- design does not specify overflow behavior beyond 'ring
        of 8', so a full ring is a hard backpressure signal, never
        silently overwritten)."""
        var i = 0
        while i < RING_SLOTS:
            if self.is_free(i):
                return i
            i = i + 1
        -1

    me write_command(slot: i64, sgp_offset: u32) -> bool:
        """Host side: write the program offset then ring the doorbell.
        Fails (false) if the slot is not free -- never clobbers a pending
        command."""
        if slot < 0 or slot >= RING_SLOTS:
            return false
        if not self.is_free(slot):
            return false
        self._set_u32(self._slot_off(slot), sgp_offset)
        self._set_u32(self._slot_off(slot) + 4, DOORBELL_RUNG)
        true

    me write_shutdown(slot: i64) -> bool:
        """Host side: enqueue the SHUTDOWN(0x7E) sentinel in `slot`."""
        self.write_command(slot, SGP_OFFSET_SHUTDOWN)

    me fn is_shutdown_slot(slot: i64) -> bool:
        self.sgp_offset(slot) == SGP_OFFSET_SHUTDOWN

    me service_next() -> i64:
        """Device-simulation helper (mirrors A2's `service_trigger` test
        style): service the lowest-indexed rung slot -- clear its
        doorbell and return its index, or -1 if no slot is rung."""
        var i = 0
        while i < RING_SLOTS:
            if self.doorbell(i) == DOORBELL_RUNG:
                self._set_u32(self._slot_off(i) + 4, DOORBELL_CLEAR)
                return i
            i = i + 1
        -1

# =========================================================================
# Watchdog-device refusal gate (design §5.3 gate)
# =========================================================================

pub val WATCHDOG_UNKNOWN: i64 = -1
pub val WATCHDOG_DISABLED: i64 = 0
pub val WATCHDOG_ENABLED: i64 = 1

# Plain `fn` (not `pub fn`): the `primitive_api` lint flags `pub fn` with a
# bare i64 param/return (same issue documented in B3's cuda_vm_executor.spl
# for step_budget_from_env et al.). Still externally importable as plain
# `fn`, so this does not change what's usable from outside the module.
fn unknown_watchdog_attr() -> i64:
    """Default watchdog-attribute provider on this build: no
    `cuDeviceGetAttribute(CU_DEVICE_ATTRIBUTE_KERNEL_EXEC_TIMEOUT)` SFFI
    binding exists (grep-confirmed against
    `src/lib/nogc_sync_mut/cuda/sffi.spl`), so the real hardware value is
    unknowable from pure Simple today. ALWAYS returns WATCHDOG_UNKNOWN.
    Filed as a bug rather than silently guessing "no watchdog"."""
    WATCHDOG_UNKNOWN

fn resident_refusal_gate(watchdog_attr: i64, force_env_value: text) -> text:
    """Pure refusal-gate decision (design §5.3): "" means "proceed", any
    other string is the refusal reason. `force_env_value` is the raw
    `CUDA_RESIDENT_FORCE` env value (caller passes `env_get(...)` so this
    stays a pure function, testable without touching the environment).

    Policy (fail-safe -- an unreadable attribute is treated the same as
    "watchdog present", never as "assume safe"):
      - WATCHDOG_ENABLED (1) and not forced -> refuse
      - WATCHDOG_UNKNOWN (-1) and not forced -> refuse (capability gap,
        not a green light)
      - WATCHDOG_DISABLED (0), or forced (`CUDA_RESIDENT_FORCE=1`)      -> proceed
    """
    val forced = force_env_value == "1"
    if forced:
        return ""
    if watchdog_attr == WATCHDOG_ENABLED:
        return "refuse:cuda-resident-watchdog-enabled"
    if watchdog_attr == WATCHDOG_UNKNOWN:
        return "refuse:cuda-resident-watchdog-attr-unavailable"
    ""

# =========================================================================
# InteractiveServicer -- live PUTC/EXIT/RESULT servicing (design §5.3,
# "interactive servicing thread using A2's service_trigger")
# =========================================================================
#
# This is the REAL protocol machinery for interactive servicing: it drives
# A2's `service_trigger` against a `MailboxArena`, exactly as design §3.2
# specifies for the interactive mode. It is wired and unit-tested below by
# simulating the device side with `arena.fire_command(...)` between polls
# (the same test technique A2's own spec uses) -- proving the live-order
# PUTC/EXIT/RESULT servicing logic is correct independent of whether a
# real device is driving TRIGGER. What is NOT wired here (the gap above):
# a real device kernel writing TRIGGER via a system-scope atomic on
# `cuMemHostAlloc`-mapped memory while a host thread runs this loop
# concurrently -- that needs the missing SFFI.
pub class InteractiveServicer:
    arena: MailboxArena
    log_text: text
    records: [ResultRecord]
    exited: bool
    exit_code: i64
    triggers_serviced: i64

    static fn create(arena: MailboxArena) -> InteractiveServicer:
        InteractiveServicer(arena: arena, log_text: "", records: [],
            exited: false, exit_code: 0, triggers_serviced: 0)

    # Service exactly one pending TRIGGER, if any. Accumulates PUTC into
    # `log_text` byte-by-byte as it arrives (live order), records RESULTs,
    # and latches EXIT. Returns the raw `ServiceOutcome` for callers that
    # want per-call detail.
    me poll_once() -> ServiceOutcome:
        val outcome = service_trigger(self.arena)
        if not outcome.serviced:
            return outcome
        self.triggers_serviced = self.triggers_serviced + 1
        if outcome.putc_byte >= 0:
            self.log_text = drain_log(self.arena)
        if outcome.exited:
            self.exited = true
            self.exit_code = outcome.exit_code
        if outcome.result_seq >= 0:
            self.records = drain_records(self.arena)
        outcome

    # Poll up to `max_iters` times or until EXIT is observed, whichever
    # comes first (mirrors the design's watchdog-budget backstop -- a
    # servicer loop must never spin unbounded).
    me service_until_exit(max_iters: i64) -> bool:
        var i = 0
        while i < max_iters and not self.exited:
            val _outcome = self.poll_once()
            i = i + 1
        self.exited

# =========================================================================
# ResidentSession -- one open CudaLaneSession, N sequential program runs
# =========================================================================

pub struct ResidentProgramResult:
    ok: bool
    error: text
    log_text: text
    exit_code: i64

pub class ResidentSession:
    """Keeps one `CudaVmExecutor` (== one `CudaLaneSession` + one loaded
    SVM-G module) open across multiple program dispatches, gated by
    `resident_refusal_gate`. See module docstring for the honest scope
    boundary vs the full design §5.3 ring-polling kernel."""
    executor: CudaVmExecutor
    ring: CommandRing
    started: bool
    refusal_reason: text
    programs_run: i64

    static fn create(kernel_bytes: [u8]) -> ResidentSession:
        ResidentSession(executor: CudaVmExecutor.create(), ring: CommandRing.new(),
            started: false, refusal_reason: "", programs_run: 0)

    # `watchdog_attr` -- caller-supplied result of a (real or test-seam)
    # watchdog attribute query; defaults should come from
    # `unknown_watchdog_attr()` until the SFFI gap above is closed.
    me start(kernel_bytes: [u8], watchdog_attr: i64) -> text:
        val gate = resident_refusal_gate(watchdog_attr, env_get("CUDA_RESIDENT_FORCE"))
        if gate != "":
            self.refusal_reason = gate
            return gate
        val init_err = self.executor.init(kernel_bytes)
        if init_err != "":
            return init_err
        self.started = true
        ""

    # Run one program through the still-open session; ring bookkeeping is
    # exercised (slot claimed -> written -> serviced -> freed) even though
    # actual dispatch goes through the per-launch executor (see gap note).
    me run_program(source: text, entry_pc: i64) -> ResidentProgramResult:
        if not self.started:
            return ResidentProgramResult(ok: false, error: "cuda-resident-not-started",
                log_text: "", exit_code: 0)
        val slot = self.ring.next_free_slot()
        if slot < 0:
            return ResidentProgramResult(ok: false, error: "cuda-resident-ring-full",
                log_text: "", exit_code: 0)
        val _claimed = self.ring.write_command(slot, self.programs_run as u32)
        val outcome = self.executor.run_source(source, step_budget_from_env(), entry_pc)
        val _serviced = self.ring.service_next()
        self.programs_run = self.programs_run + 1
        if not outcome.ok:
            return ResidentProgramResult(ok: false, error: outcome.error, log_text: "", exit_code: 0)
        ResidentProgramResult(ok: true, error: "", log_text: outcome.log_text, exit_code: outcome.exit_code)

    me shutdown() -> text:
        if not self.started:
            return ""
        val slot = self.ring.next_free_slot()
        if slot >= 0:
            val _w = self.ring.write_shutdown(slot)
            val _s = self.ring.service_next()
        self.started = false
        self.executor.shutdown()

export CommandRing, RING_SLOTS, RING_SLOT_BYTES, RING_TOTAL_BYTES
export DOORBELL_CLEAR, DOORBELL_RUNG, CMD_SHUTDOWN, SGP_OFFSET_SHUTDOWN
export WATCHDOG_UNKNOWN, WATCHDOG_DISABLED, WATCHDOG_ENABLED
export unknown_watchdog_attr, resident_refusal_gate
export InteractiveServicer
export ResidentSession, ResidentProgramResult
export ARENA_SIZE
