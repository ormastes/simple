# Vulkan graphics/compute/present backend adapter.
# Full-featured: graphics, compute, and swapchain present supported.

use std.io
use std.gc_async_mut.gpu.session.backend_runtime_ops.{
    backend_vulkan_create_device, backend_vulkan_submit,
    backend_vulkan_present, backend_vulkan_cleanup
}

class BackendVulkanAdapter:
    handle: i64
    device_name: text
    initialized: bool
    session_mode: text

    static fn create(mode: text) -> BackendVulkanAdapter:
        BackendVulkanAdapter(
            handle: 0,
            device_name: "vulkan",
            initialized: false,
            session_mode: mode,
        )

    me init_device() -> text:
        val h = backend_vulkan_create_device()
        if h <= 0:
            return "vulkan: device creation failed"
        self.handle = h
        self.initialized = true
        ""

    me submit_commands(cmd_count: i64) -> text:
        if self.initialized == false:
            return "vulkan: device not initialized"
        if cmd_count < 0:
            return "vulkan: invalid cmd_count"
        backend_vulkan_submit(self.handle, cmd_count)

    me present() -> text:
        if self.initialized == false:
            return "vulkan: device not initialized"
        backend_vulkan_present(self.handle)

    me readback(x: i64, y: i64, w: i64, h: i64) -> text:
        # HONESTY (site 15-19, doc/04_architecture/ui/wm_host_platform_matrix.md):
        # this used to return "" (the success sentinel) after validating
        # arguments while moving zero pixels. There is no real pixel-transfer
        # path implemented in this adapter, so it must refuse rather than
        # claim success.
        if self.initialized == false:
            return "vulkan: device not initialized"
        if w <= 0 or h <= 0:
            return "vulkan: invalid readback dimensions"
        "vulkan: readback not implemented (no pixel transfer path)"

    me supports_compute() -> bool:
        true

    me supports_graphics() -> bool:
        true

    me supports_present() -> bool:
        true

    me device_info() -> text:
        "vulkan handle=" + self.handle.to_text() + " mode=" + self.session_mode + " initialized=" + self.initialized.to_text()

    me cleanup() -> text:
        if self.initialized:
            backend_vulkan_cleanup(self.handle)
        self.initialized = false
        self.handle = 0
        ""
