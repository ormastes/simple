# Host adapter: wall-clock read for engine2d's software-backend SIMD-vs-
# scalar kernel probes.
#
# Lives outside wm_lane_scope_dirs() (see
# src/compiler/tools/lint/_LintMain/wm_lane_boundary_lints.spl:51 —
# `src/lib/gc_async_mut/gpu/engine2d/` is a scope root, this file is a
# sibling of it, not inside it) so the std.nogc_sync_mut.io_runtime import
# below is legal here.
#
# `time_now_unix_micros` is used by `_kernel_probe_*_bucket` in
# `gpu/engine2d/backend_software.spl` to measure whether a SIMD-ISA kernel is
# actually faster than its scalar oracle before the dispatch table admits it
# — a real runtime capability decision (KERNEL_PROBE_FASTER), not debug
# logging, so it cannot simply be dropped. It genuinely needs a clock,
# which the WM/2D portable-lane contract deliberately excludes as a host
# precondition (see `_wml_host_roots()` note: "the WM must run without a
# terminal or a clock"). Importing it via this facade keeps that contract
# honest — the resulting module path lands on the `gpu` render sub-lane
# (see `_wml_render_sublanes()`), which is the correct classification for a
# rendering-lane perf primitive; a bare `nogc_sync_mut.io_runtime` import
# from inside engine2d/ itself is not.
export use std.nogc_sync_mut.io_runtime.{time_now_unix_micros}
