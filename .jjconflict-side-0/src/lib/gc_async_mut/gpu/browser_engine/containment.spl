# CSS `contain` fast-skip support — §7 of
# doc/03_plan/ui/perf/render_perf_redesign_plan_2026-08-06.md ("containment
# where semantics allow", inside the Web-style bullet).
#
# Scope: `contain: layout`, `contain: paint`, `contain: style` only.
# `contain: size` is explicitly OUT of scope — it requires intrinsic-sizing
# machinery (a box's size must not depend on its contents, which needs a
# separate "measure without laying out" pass) that this codebase's layout
# engine (simple_web_html_layout_renderer_layout.spl's array/index-based
# `layout()`) does not have; faking it would silently produce wrong sizes
# instead of skipping work, which is worse than not implementing it.
#
# Containment value is read the same way id/class already are elsewhere in
# this package (dom_accessors.be_dom_get_id: `node.attributes.get("id")`):
# a `contain` attribute holding the resolved computed-value text, e.g.
# "layout", "paint", "style", or a space-separated combination. This mirrors
# the existing attribute-read idiom rather than extending the shared
# StyleProps/ComputedStyleHot struct (dom.spl / *_style.spl), which is out
# of scope for this change and used by many unrelated call sites.
#
# House rules followed: no enum/bitmask on the hot path (three independent
# text-token checks, not a packed flag), Dict<i64,i32>/Dict<i64,bool> only
# (never a struct-valued Dict — Dict.get on struct/enum values is corrupt
# under native codegen per doc/07_guide/language/dict_native_pitfalls.md),
# free functions over class-field reference propagation.

use std.gc_async_mut.gpu.browser_engine.dom.{BeDomNode}
use std.gc_async_mut.gpu.browser_engine.dom_accessors.{be_dom_get_children}

# =========================================================================
# Containment-value parsing
# =========================================================================

pub fn node_contain_value(node: BeDomNode) -> text:
    node.attributes.get("contain") ?? ""

fn contain_has_token(value: text, token: text) -> bool:
    var seg_start = 0
    var idx = 0
    val len = value.len()
    while idx < len:
        if value.slice(idx, idx + 1) == " ":
            if idx > seg_start and value.slice(seg_start, idx) == token:
                return true
            seg_start = idx + 1
        idx = idx + 1
    if len > seg_start and value.slice(seg_start, len) == token:
        return true
    false

pub fn node_contains_layout(node: BeDomNode) -> bool:
    contain_has_token(node_contain_value(node), "layout")

pub fn node_contains_paint(node: BeDomNode) -> bool:
    contain_has_token(node_contain_value(node), "paint")

pub fn node_contains_style(node: BeDomNode) -> bool:
    contain_has_token(node_contain_value(node), "style")

# Text-based entry points for the layout engine (simple_web_html_layout_
# renderer_layout.spl), which represents a node as `HNode` with a raw
# `attrs_raw` attribute string (already read via its own `attr_value`
# helper), not as a `BeDomNode` with an `attributes` Dict. Rather than force
# a BeDomNode conversion into that array/index hot loop, these two functions
# expose the same token-matching logic on the already-extracted attribute
# text so the layout engine can call `attr_value(node.attrs_raw, "contain")`
# itself and hand the result straight in.
fn contain_value_contains_layout(value: text) -> bool:
    contain_has_token(value, "layout")

fn contain_value_contains_paint(value: text) -> bool:
    contain_has_token(value, "paint")

# =========================================================================
# Layout/paint containment: subtree box cache.
#
# A node with `contain: layout` promises its box's layout does not depend
# on anything outside itself (and vice versa: mutating inside it cannot
# change any box outside it), so once its subtree has been laid out and
# nothing inside it changed, recomputation can be skipped entirely and the
# cached box reused. `contain: paint` additionally promises the subtree
# never paints outside its own box, so a repaint triggered outside a
# `contain: paint` boundary never needs to touch pixels inside it (and one
# triggered inside never needs to touch pixels outside it).
#
# This is a deliberately small, self-contained cache (parallel Dict<i64,*>
# fields, never a struct-valued Dict) demonstrating the fast-skip semantics
# end to end for a standalone BeDomNode tree. It is NOT itself used by the
# real 2517-line flattened array/index `layout()`/`layout_with_style()` hot
# loop in simple_web_html_layout_renderer_layout.spl — that loop's per-node
# state is positional (x/y/w threaded by value through `[i32]` arrays keyed
# by node index, produced once per full-tree pass), not persistent
# Dict-keyed state, so bolting THIS Dict-based cache into it would violate
# the "no Dict on the hot numeric path" house rule for no benefit (the
# array is already indexed by node id).
#
# The real hot-loop wiring instead lives in `layout_selected()` in that
# file: it reuses the array-positional structure directly (a `contain`
# check against `HNode.attrs_raw` via `contain_value_contains_layout`
# below, and a subtree recompute seeded from the already-retained `[i32]`
# box arrays) rather than forcing this Dict-keyed cache onto it. See
# `layout_contain_boundary` / the fast path at the top of `layout_selected`
# there for the wired version, and its spec for the correctness +
# proportionality proof.
# =========================================================================

pub class LayoutContainState:
    cached: Dict<i64, bool>
    box_x: Dict<i64, i32>
    box_y: Dict<i64, i32>
    box_w: Dict<i64, i32>
    box_h: Dict<i64, i32>
    dirty_below: Dict<i64, bool>
    recompute_count: i64

pub fn new_layout_contain_state() -> LayoutContainState:
    LayoutContainState(cached: {}, box_x: {}, box_y: {}, box_w: {}, box_h: {}, dirty_below: {}, recompute_count: 0)

pub fn layout_contain_mark_dirty(mut state: LayoutContainState, node_id: i64):
    """Call when a node's own content changed (mirrors
    invalidate_node_discriminant_change's mutation entry point for style).
    Marks only that node's cache entry stale; ancestors/siblings outside a
    containing boundary are never touched by this call, which IS the
    proportionality property under test."""
    state.dirty_below[node_id] = true
    if state.cached.contains_key(node_id):
        state.cached[node_id] = false

fn box_measure(node: BeDomNode) -> i32:
    """Minimal stand-in box metric: total descendant element count, used
    only so the cache has something cheap and deterministic to compute and
    compare for the correctness/proportionality spec below."""
    var total = 1
    val kids = be_dom_get_children(node)
    var i = 0
    while i < kids.len():
        total = total + box_measure(kids[i])
        i = i + 1
    total

pub fn layout_contain_compute(mut state: LayoutContainState, node: BeDomNode, x: i32, y: i32) -> i32:
    """Returns the subtree's box height (box_measure), using the cache when
    the node is `contain: layout` and its cached entry is clean. Always
    recurses (and recomputes) otherwise."""
    val nid = node.node_id
    if node_contains_layout(node) and state.cached.contains_key(nid) and state.cached[nid]:
        return state.box_h[nid]

    state.recompute_count = state.recompute_count + 1
    val h = box_measure(node)
    state.box_x[nid] = x
    state.box_y[nid] = y
    state.box_w[nid] = h
    state.box_h[nid] = h
    if node_contains_layout(node):
        state.cached[nid] = true
        state.dirty_below[nid] = false
    h

export node_contain_value
export node_contains_layout
export node_contains_paint
export node_contains_style
export LayoutContainState
export new_layout_contain_state
export layout_contain_mark_dirty
export layout_contain_compute
