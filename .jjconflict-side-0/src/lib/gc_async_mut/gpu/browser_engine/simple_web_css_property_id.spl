# CSS property-id interning for the apply_decls dispatch fast path.
#
# Stage 3 of the apply_decls loop-inversion fix (see doc/08_tracking/bug/
# web_style_producer_4s_per_node_interpreted_lane_2026-07-29.md). The staged
# dispatch path previously probed EVERY dispatch-handled property name against
# the rule's decl table (~30 O(k) string scans per call, present or not). This
# module interns names to small integer ids in ONE pass so the dispatch body
# only touches properties that actually appear: O(k) in the number of
# declarations, per the plan gate `property_probes <= declaration_count + C`.
#
# APPEND-ONLY: ids are stable; never renumber, never insert mid-list.
# ponytail: plain i64 constants + if/elif chain, not an enum — enum match has
# known engine divergences (match-after-Option-unwrap fires no arm under JIT).

val CSS_PROP_UNKNOWN: i64 = 0
val CSS_PROP_BOX_SIZING: i64 = 1
val CSS_PROP_COLOR: i64 = 2
val CSS_PROP_WIDTH: i64 = 3
val CSS_PROP_HEIGHT: i64 = 4
val CSS_PROP_MIN_HEIGHT: i64 = 5
val CSS_PROP_MARGIN_LEFT: i64 = 6
val CSS_PROP_Z_INDEX: i64 = 7
val CSS_PROP_DISPLAY: i64 = 8
val CSS_PROP_GRID_TEMPLATE_COLUMNS: i64 = 9
val CSS_PROP_GRID_TEMPLATE_ROWS: i64 = 10
val CSS_PROP_GRID_COLUMN: i64 = 11
val CSS_PROP_GRID_ROW: i64 = 12
val CSS_PROP_BORDER_COLLAPSE: i64 = 13
val CSS_PROP_JUSTIFY_CONTENT: i64 = 14
val CSS_PROP_ALIGN_ITEMS: i64 = 15
val CSS_PROP_GAP: i64 = 16
val CSS_PROP_FLEX_BASIS: i64 = 17
val CSS_PROP_TEXT_ALIGN: i64 = 18
val CSS_PROP_FONT_STYLE: i64 = 19
val CSS_PROP_CURSOR: i64 = 20
val CSS_PROP_OUTLINE: i64 = 21
val CSS_PROP_OVERFLOW: i64 = 22
val CSS_PROP_BOX_SHADOW: i64 = 23
val CSS_PROP_PADDING: i64 = 24
val CSS_PROP_MARGIN: i64 = 25
val CSS_PROP_BORDER_RADIUS: i64 = 26
val CSS_PROP_RADIUS_TL: i64 = 27
val CSS_PROP_RADIUS_TR: i64 = 28
val CSS_PROP_RADIUS_BR: i64 = 29
val CSS_PROP_RADIUS_BL: i64 = 30
val CSS_PROP_RADIUS_SS: i64 = 31
val CSS_PROP_RADIUS_SE: i64 = 32
val CSS_PROP_RADIUS_ES: i64 = 33
val CSS_PROP_RADIUS_EE: i64 = 34

# Map a property name to its id; CSS_PROP_UNKNOWN (0) for anything not
# dispatch-handled. This is the single source of truth for what the dispatch
# fast path understands — `_decl_tbl_all_dispatch_handled` gates on id != 0,
# so adding an id here WITHOUT teaching `_apply_decls_dispatch` its semantics
# is a silent rendering bug. Grow both together.
fn css_prop_id(name: text) -> i64:
    if name == "box-sizing": return CSS_PROP_BOX_SIZING
    elif name == "color": return CSS_PROP_COLOR
    elif name == "width": return CSS_PROP_WIDTH
    elif name == "height": return CSS_PROP_HEIGHT
    elif name == "min-height": return CSS_PROP_MIN_HEIGHT
    elif name == "margin-left": return CSS_PROP_MARGIN_LEFT
    elif name == "z-index": return CSS_PROP_Z_INDEX
    elif name == "display": return CSS_PROP_DISPLAY
    elif name == "grid-template-columns": return CSS_PROP_GRID_TEMPLATE_COLUMNS
    elif name == "grid-template-rows": return CSS_PROP_GRID_TEMPLATE_ROWS
    elif name == "grid-column": return CSS_PROP_GRID_COLUMN
    elif name == "grid-row": return CSS_PROP_GRID_ROW
    elif name == "border-collapse": return CSS_PROP_BORDER_COLLAPSE
    elif name == "justify-content": return CSS_PROP_JUSTIFY_CONTENT
    elif name == "align-items": return CSS_PROP_ALIGN_ITEMS
    elif name == "gap": return CSS_PROP_GAP
    elif name == "flex-basis": return CSS_PROP_FLEX_BASIS
    elif name == "text-align": return CSS_PROP_TEXT_ALIGN
    elif name == "font-style": return CSS_PROP_FONT_STYLE
    elif name == "cursor": return CSS_PROP_CURSOR
    elif name == "outline": return CSS_PROP_OUTLINE
    elif name == "overflow": return CSS_PROP_OVERFLOW
    elif name == "box-shadow": return CSS_PROP_BOX_SHADOW
    elif name == "padding": return CSS_PROP_PADDING
    elif name == "margin": return CSS_PROP_MARGIN
    elif name == "border-radius": return CSS_PROP_BORDER_RADIUS
    elif name == "border-top-left-radius": return CSS_PROP_RADIUS_TL
    elif name == "border-top-right-radius": return CSS_PROP_RADIUS_TR
    elif name == "border-bottom-right-radius": return CSS_PROP_RADIUS_BR
    elif name == "border-bottom-left-radius": return CSS_PROP_RADIUS_BL
    elif name == "border-start-start-radius": return CSS_PROP_RADIUS_SS
    elif name == "border-start-end-radius": return CSS_PROP_RADIUS_SE
    elif name == "border-end-start-radius": return CSS_PROP_RADIUS_ES
    elif name == "border-end-end-radius": return CSS_PROP_RADIUS_EE
    CSS_PROP_UNKNOWN

# Presence bitmask over a decl table ([name, value, name, value, ...]):
# one pass, bit (1 << id) set for each known property present.
fn css_prop_mask(decl_tbl: [text]) -> i64:
    var mask: i64 = 0
    var i = 0
    while i < decl_tbl.len():
        val id = css_prop_id(decl_tbl[i])
        if id != CSS_PROP_UNKNOWN:
            mask = mask | (1 << id)
        i = i + 2
    mask

fn css_prop_mask_has(mask: i64, id: i64) -> bool:
    (mask & (1 << id)) != 0

# Any of the 9 border-radius family properties (shorthand + 8 longhands):
# the authored-order radius resolver is shared with the full-probe path and
# is gated as one family.
fn css_prop_mask_has_radius_family(mask: i64) -> bool:
    var family: i64 = 1 << CSS_PROP_BORDER_RADIUS
    var id = CSS_PROP_RADIUS_TL
    while id <= CSS_PROP_RADIUS_EE:
        family = family | (1 << id)
        id = id + 1
    (mask & family) != 0

# --- probe accounting (for the O(k) gate spec; level-gated cost is one add) --
var _css_probe_count: i64 = 0

fn css_probe_reset():
    _css_probe_count = 0

fn css_probe_note():
    _css_probe_count = _css_probe_count + 1

fn css_probe_count() -> i64:
    _css_probe_count
