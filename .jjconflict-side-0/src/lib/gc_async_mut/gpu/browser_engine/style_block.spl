# Style Block Processor — <style> tag CSS rule extraction and application
#
# Extracts CSS rules from <style> blocks in HTML, parses simple selectors
# (tag, .class, #id, compound), and applies matched styles to DOM nodes.
#
# Supports:
#   - Tag selectors: div, span, p, h1-h6, etc.
#   - Class selectors: .container, .active
#   - ID selectors: #main, #header
#   - Attribute selectors: [data-state], div[data-state="active"], prefix/suffix/substring/token/dash operators, i/s flags (partial)
#   - Compound: div.active, span.highlight
#   - Comma-separated: div, span { ... }
#   - Descendant: div span { ... } (limited — matches if ANY ancestor matches)
#   - Pseudo-classes: :nth-child(N/odd/even/common an+b forms) (bounded), :first-child, :last-child, :only-child, :empty, :is(), :where(), :not(), :has()
#     :has() supports simple descendant options and bounded relative child options (`> .class`, `> tag`, `> #id`).
#   - Shorthand properties: flex, border, background, margin multi-value
#
# Split into:
#   style_block.spl         — this file: types, helpers, apply-to-tree, public API
#   style_block_parse.spl   — keyframes, CSS parsing, shorthand expansion, var resolution
#   style_block_resolve.spl — selector matching

use std.gc_async_mut.gpu.browser_engine.dom.{BeDomNode}
use std.gc_async_mut.gpu.browser_engine.dom_accessors.{
    be_dom_get_tag, be_dom_get_id, be_dom_get_classes, be_dom_get_children,
    be_dom_get_is_text, be_dom_get_text, be_dom_set_children, be_dom_get_bg_color,
    be_dom_get_attr, be_dom_has_attr}
use std.gc_async_mut.gpu.browser_engine.dom_color.{parse_color_value}
use std.gc_async_mut.gpu.browser_engine.css.{parse_css_value, BoxEdges,
    BorderProps, CssValue}
use common.string_builder.{StringBuilder}
use std.gc_async_mut.gpu.browser_engine.style.supports.{eval_supports_query}
use std.gc_async_mut.gpu.browser_engine.style.custom_properties.{has_var_reference, parse_var_function}
use std.gc_async_mut.gpu.browser_engine.style.animation.{Keyframe, CSSValue, CSSDeclaration}
use std.gc_async_mut.gpu.browser_engine.style_block_parse.{
    extract_style_blocks, extract_keyframes, parse_css_rules,
    collect_css_vars, resolve_css_vars_in_rules}
use std.gc_async_mut.gpu.browser_engine.style_block_resolve.{selector_matches}
use std.gc_async_mut.gpu.browser_engine.style_property_id.{
    declaration_from_name_value, apply_declarations, property_id_from_name,
    PROPERTY_ID_UNKNOWN}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_style.{
    computed_style_hot_from, renderer_default_style}

# =========================================================================
# CSS Rule types
# =========================================================================

pub class CssRule:
    selector: text
    declarations: [CssDecl]

pub class CssDecl:
    property: text
    value: text

pub fn css_decl_property(decl: CssDecl) -> text:
    decl.property

pub fn css_decl_value(decl: CssDecl) -> text:
    decl.value

pub fn css_decls_contain(decls: [CssDecl], property: text, value: text) -> bool:
    var i = 0
    while i < decls.len():
        val decl = decls[i]
        i = i + 1
        if decl.property == property and decl.value == value:
            return true
    false

# =========================================================================
# Apply rules to DOM tree
# =========================================================================

fn apply_css_rules_to_tree(root: BeDomNode, rules: [CssRule]) -> BeDomNode:
    var w0_stats: Dict<text, i64> = {}
    apply_css_rules_to_tree_with_w0_stats(root, rules, w0_stats)

# T1 (W0 wiring): the production entrypoint above and this function share the
# exact same recursive path (apply_rules_to_node_indexed) -- there is no
# separate "test-only" cascade. Exposed publicly so a spec can pass its own
# counter dict and observe that the live cascade really reaches
# apply_declarations for every known-PropertyId declaration it matches, not
# just style_property_id.spl's own isolated unit tests.
pub fn apply_css_rules_to_tree_with_w0_stats(root: BeDomNode, rules: [CssRule], mut w0_stats: Dict<text, i64>) -> BeDomNode:
    val idx = build_selector_rule_index(rules)
    apply_rules_to_node_indexed(root, rules, idx, nil, 1, 1, w0_stats)

pub fn apply_css_rules_to_tree_linear(root: BeDomNode, rules: [CssRule]) -> BeDomNode:
    """Reference (pre-index) linear-scan path, kept for equivalence testing
    against apply_css_rules_to_tree's indexed path. Not used in production."""
    apply_rules_to_node(root, rules, nil, 1, 1)

fn apply_rules_to_node(node: BeDomNode, rules: [CssRule], parent: BeDomNode?, nth: i32, sibling_count: i32) -> BeDomNode:
    if be_dom_get_is_text(node):
        return node

    # Skip style/link/meta/title/head/html/!doctype elements
    val tag = be_dom_get_tag(node)
    if tag == "style" or tag == "link" or tag == "meta" or tag == "title" or tag == "head":
        return node

    var color_ru_idx = 0
    while color_ru_idx < rules.len():
        val rule = rules[color_ru_idx]
        color_ru_idx = color_ru_idx + 1
        if selector_matches(rule.selector, node, parent, nth, sibling_count):
            var dc_idx = 0
            while dc_idx < rule.declarations.len():
                val decl = rule.declarations[dc_idx]
                dc_idx = dc_idx + 1
                if decl.property == "color":
                    node.set_style(decl.property, decl.value)
    var ru_idx = 0
    while ru_idx < rules.len():
        val rule = rules[ru_idx]
        ru_idx = ru_idx + 1
        if selector_matches(rule.selector, node, parent, nth, sibling_count):
            var dc_idx = 0
            while dc_idx < rule.declarations.len():
                val decl = rule.declarations[dc_idx]
                dc_idx = dc_idx + 1
                if decl.property != "color":
                    node.set_style(decl.property, decl.value)

    # Recurse to children with nth tracking, rebuilding the children array.
    # The interpreter copies class instances on array index/push, so the
    # `child` we fetch from children[i] is a detached copy. We style it,
    # recurse (which rebuilds its grandchildren in turn), then push the
    # RETURNED (re-styled) copy into a new array and write the new array
    # back via be_dom_set_children so the parent sees the changes.
    # be_dom_set_children is a pure constructor (returns a NEW BeDomNode; it
    # does not mutate `node` in place), so this function must return that
    # constructed value and every caller — including the recursive call
    # above — must use the returned node, not the original argument.
    var child_nth = 1
    val sb_kids = be_dom_get_children(node)
    var child_count = 0
    var count_idx = 0
    while count_idx < sb_kids.len():
        if not be_dom_get_is_text(sb_kids[count_idx]):
            child_count = child_count + 1
        count_idx = count_idx + 1
    var new_kids: [BeDomNode] = []
    var sc_idx = 0
    while sc_idx < sb_kids.len():
        var child = sb_kids[sc_idx]
        sc_idx = sc_idx + 1
        val updated_child = apply_rules_to_node(child, rules, node, child_nth, child_count)
        new_kids.push(updated_child)
        if not be_dom_get_is_text(child):
            child_nth = child_nth + 1
    be_dom_set_children(node, new_kids)

# =========================================================================
# Selector index — buckets rules by a cheap discriminant (id / first class /
# tag of the rule's subject simple selector) so per-node matching only runs
# full selector_matches against candidate rules instead of the whole ruleset.
# Soundness: selector_matches always requires the subject (last simple
# selector, i.e. the part that must match the node itself) to match the
# node, so bucketing on a necessary condition of the subject (its id, one of
# its required classes, or its tag) can only ever drop rules that provably
# cannot match. Selectors that resist cheap discrimination (attribute
# selectors, pseudo-functions, bare "*") fall into the universal bucket,
# which is checked for every node — identical to the old linear scan for
# just those rules.
# =========================================================================

pub class SelectorRuleIndex:
    tag_buckets: Dict<text, [i32]>
    id_buckets: Dict<text, [i32]>
    class_buckets: Dict<text, [i32]>
    universal: [i32]

fn selector_bucket_key_end(s: text) -> i64:
    var idx = 0
    val len = s.len()
    while idx < len:
        val ch = s.slice(idx, idx + 1)
        if ch == "." or ch == "#" or ch == ":" or ch == "[":
            return idx
        idx = idx + 1
    len

pub fn selector_bucket_discriminant(selector: text) -> [text]:
    """Returns [kind, key] where kind is one of "id"/"class"/"tag"/"universal"."""
    val trimmed = selector.trim()
    if trimmed.len() == 0:
        return ["universal", ""]
    # Subject is the simple selector that must match the node itself: the
    # part after a top-level child combinator, or the last whitespace token
    # for descendant combinators, mirroring selector_matches's own logic.
    var subject = trimmed
    val child_pos = sb_find_top_level_child_combinator(trimmed)
    if child_pos < 999999999:
        subject = trimmed.slice(child_pos + 1, trimmed.len()).trim()
    else:
        val parts = sb_split_ws(trimmed)
        if parts.len() > 0:
            subject = parts[parts.len() - 1]
    if subject.len() == 0 or subject == "*":
        return ["universal", ""]
    if sb_find(subject, "[", 0) < 999999999:
        return ["universal", ""]
    if subject.starts_with(":"):
        return ["universal", ""]
    val hash_pos = sb_find(subject, "#", 0)
    if hash_pos < 999999999:
        val rest = subject.slice(hash_pos + 1, subject.len())
        val end_pos = selector_bucket_key_end(rest)
        return ["id", rest.slice(0, end_pos)]
    val dot_pos = sb_find(subject, ".", 0)
    if dot_pos < 999999999:
        val rest2 = subject.slice(dot_pos + 1, subject.len())
        val end_pos2 = selector_bucket_key_end(rest2)
        return ["class", rest2.slice(0, end_pos2)]
    val colon_pos = sb_find(subject, ":", 0)
    var tag_part = subject
    if colon_pos < 999999999:
        tag_part = subject.slice(0, colon_pos)
    if tag_part.len() == 0:
        return ["universal", ""]
    ["tag", tag_part]

pub fn build_selector_rule_index(rules: [CssRule]) -> SelectorRuleIndex:
    var idx = SelectorRuleIndex(
        tag_buckets: {},
        id_buckets: {},
        class_buckets: {},
        universal: [])
    var i = 0
    while i < rules.len():
        val kind_key = selector_bucket_discriminant(rules[i].selector)
        val kind = kind_key[0]
        val key = kind_key[1]
        if kind == "id":
            if idx.id_buckets.contains_key(key):
                var arr = idx.id_buckets[key]
                arr.push(i)
                idx.id_buckets[key] = arr
            else:
                idx.id_buckets[key] = [i]
        elif kind == "class":
            if idx.class_buckets.contains_key(key):
                var arr2 = idx.class_buckets[key]
                arr2.push(i)
                idx.class_buckets[key] = arr2
            else:
                idx.class_buckets[key] = [i]
        elif kind == "tag":
            if idx.tag_buckets.contains_key(key):
                var arr3 = idx.tag_buckets[key]
                arr3.push(i)
                idx.tag_buckets[key] = arr3
            else:
                idx.tag_buckets[key] = [i]
        else:
            idx.universal.push(i)
        i = i + 1
    idx

pub fn selector_index_candidates(idx: SelectorRuleIndex, tag: text, id: text, classes: [text]) -> [i32]:
    var out: [i32] = []
    var oi = 0
    while oi < idx.universal.len():
        out.push(idx.universal[oi])
        oi = oi + 1
    if id.len() > 0 and idx.id_buckets.contains_key(id):
        val arr = idx.id_buckets[id]
        var i2 = 0
        while i2 < arr.len():
            out.push(arr[i2])
            i2 = i2 + 1
    if tag.len() > 0 and idx.tag_buckets.contains_key(tag):
        val arr2 = idx.tag_buckets[tag]
        var i3 = 0
        while i3 < arr2.len():
            out.push(arr2[i3])
            i3 = i3 + 1
    var ci = 0
    while ci < classes.len():
        val c = classes[ci]
        if idx.class_buckets.contains_key(c):
            val arr3 = idx.class_buckets[c]
            var i4 = 0
            while i4 < arr3.len():
                out.push(arr3[i4])
                i4 = i4 + 1
        ci = ci + 1
    # The buckets above are concatenated in a FIXED order (universal, id,
    # tag, class-per-node-class) that has nothing to do with the original
    # rule array order. apply_rules_to_node_indexed applies declarations in
    # candidate order and later declarations win on conflict (CSS cascade:
    # last rule of equal specificity wins), so `out` MUST be restored to
    # ascending rule-index order here — otherwise two rules that both match
    # a node but land in different buckets can apply in the wrong relative
    # order and the wrong one wins. (Confirmed divergence: rules
    # [".beta"@idx2, "section .alpha"@idx5] on a node with class="alpha
    # beta" — class-bucket iteration visits "alpha" before "beta" because
    # that's the node's own class order, so idx5 was applied before idx2,
    # picking idx2's declaration as the final value instead of idx5's.)
    var si = 1
    while si < out.len():
        val key = out[si]
        var sj = si - 1
        while sj >= 0 and out[sj] > key:
            out[sj + 1] = out[sj]
            sj = sj - 1
        out[sj + 1] = key
        si = si + 1
    out

fn apply_rules_to_node_indexed(node: BeDomNode, rules: [CssRule], idx: SelectorRuleIndex, parent: BeDomNode?, nth: i32, sibling_count: i32, mut w0_stats: Dict<text, i64>) -> BeDomNode:
    if be_dom_get_is_text(node):
        return node

    val tag = be_dom_get_tag(node)
    if tag == "style" or tag == "link" or tag == "meta" or tag == "title" or tag == "head":
        return node

    val node_id = be_dom_get_id(node)
    val node_classes = be_dom_get_classes(node)
    val candidates = selector_index_candidates(idx, tag, node_id, node_classes)

    # W0 wiring (T1): route every matched declaration whose property has a
    # known PropertyId through the real apply_declarations, alongside (not
    # instead of) the existing text-keyed node.set_style write. `w0_hot` is
    # a per-node scratch ComputedStyleHot that is never read back -- the DOM
    # style text values below remain the single source of truth for
    # rendering, exactly as before this change (see plan §0: the string
    # cascade was already O(k)-ish, so this does not change measured
    # per-node cost in kind, only proves apply_declarations is reachable
    # from the live cascade instead of being an orphan). Sabotaging
    # apply_declarations to a no-op must make w0_stats["touched"] stop
    # growing, which is what the cascade-level spec asserts.
    var w0_hot = computed_style_hot_from(renderer_default_style())

    var color_ci = 0
    while color_ci < candidates.len():
        val rule = rules[candidates[color_ci]]
        color_ci = color_ci + 1
        if selector_matches(rule.selector, node, parent, nth, sibling_count):
            var dc_idx = 0
            while dc_idx < rule.declarations.len():
                val decl = rule.declarations[dc_idx]
                dc_idx = dc_idx + 1
                if decl.property == "color":
                    node.set_style(decl.property, decl.value)
                    if property_id_from_name(decl.property) != PROPERTY_ID_UNKNOWN:
                        val w0_decl = declaration_from_name_value(decl.property, decl.value, false)
                        w0_hot = apply_declarations(w0_hot, [w0_decl], w0_stats)
    var ci2 = 0
    while ci2 < candidates.len():
        val rule = rules[candidates[ci2]]
        ci2 = ci2 + 1
        if selector_matches(rule.selector, node, parent, nth, sibling_count):
            var dc_idx2 = 0
            while dc_idx2 < rule.declarations.len():
                val decl = rule.declarations[dc_idx2]
                dc_idx2 = dc_idx2 + 1
                if decl.property != "color":
                    node.set_style(decl.property, decl.value)
                    if property_id_from_name(decl.property) != PROPERTY_ID_UNKNOWN:
                        val w0_decl2 = declaration_from_name_value(decl.property, decl.value, false)
                        w0_hot = apply_declarations(w0_hot, [w0_decl2], w0_stats)

    var child_nth = 1
    val sb_kids = be_dom_get_children(node)
    var child_count = 0
    var count_idx = 0
    while count_idx < sb_kids.len():
        if not be_dom_get_is_text(sb_kids[count_idx]):
            child_count = child_count + 1
        count_idx = count_idx + 1
    var new_kids: [BeDomNode] = []
    var sc_idx = 0
    while sc_idx < sb_kids.len():
        var child = sb_kids[sc_idx]
        sc_idx = sc_idx + 1
        val updated_child = apply_rules_to_node_indexed(child, rules, idx, node, child_nth, child_count, w0_stats)
        new_kids.push(updated_child)
        if not be_dom_get_is_text(child):
            child_nth = child_nth + 1
    be_dom_set_children(node, new_kids)

# =========================================================================
# Public API: process HTML with <style> blocks
# =========================================================================

pub fn process_style_blocks(root: BeDomNode, html: text) -> BeDomNode:
    val blocks = extract_style_blocks(html)
    var all_rules: [CssRule] = []
    var all_vars: [CssDecl] = []
    var bl_idx = 0
    while bl_idx < blocks.len():
        val block = blocks[bl_idx]
        bl_idx = bl_idx + 1
        val rules = parse_css_rules(block)
        val vars = collect_css_vars(rules)
        var vi = 0
        while vi < vars.len():
            all_vars.push(vars[vi])
            vi = vi + 1
        var ri_idx = 0
        while ri_idx < rules.len():
            val r = rules[ri_idx]
            ri_idx = ri_idx + 1
            all_rules.push(r)
    if all_rules.len() > 0:
        val resolved_rules = resolve_css_vars_in_rules(all_rules, all_vars)
        return apply_css_rules_to_tree(root, resolved_rules)
    root

pub fn process_style_blocks_result(root: BeDomNode, html: text) -> BeDomNode:
    process_style_blocks(root, html)

# =========================================================================
# Helpers (shared by style_block_parse and style_block_resolve via import)
# =========================================================================

pub fn sb_find(s: text, target: text, start: i64) -> i64:
    var i = start
    val tlen = target.len()
    val slen = s.len()
    while i + tlen <= slen:
        if s.slice(i, i + tlen) == target:
            return i
        i = i + 1
    999999999

pub fn sb_split_char(s: text, delimiter: text) -> [text]:
    # char_at() is character-indexed while slice()/len() are byte-indexed
    # on the deployed seed; mixing char_at(i) with a byte-length loop
    # bound silently stops matching once i exceeds the character count on
    # non-ASCII input. Byte-slicing per character also cost an O(i) walk
    # per call under char_at() (it decodes from the string start each
    # time), turning this whole selector-splitting pass quadratic; using
    # slice(i, i+1) for detection plus one bulk slice(seg_start, idx) per
    # segment (instead of a StringBuilder filled one byte at a time) makes
    # both the correctness and the asymptotic cost right.
    var parts: [text] = []
    var seg_start = 0
    var idx = 0
    val len = s.len()
    while idx < len and parts.len() < 256:
        val ch = s.slice(idx, idx + 1)
        if ch == delimiter:
            parts.push(s.slice(seg_start, idx))
            seg_start = idx + 1
        idx = idx + 1
    if seg_start < len:
        parts.push(s.slice(seg_start, len))
    parts

pub fn sb_split_selector_list(s: text) -> [text]:
    # See sb_split_char above.
    var parts: [text] = []
    var seg_start = 0
    var idx = 0
    var paren_depth = 0
    val len = s.len()
    while idx < len and parts.len() < 256:
        val ch = s.slice(idx, idx + 1)
        if ch == "(":
            paren_depth = paren_depth + 1
        elif ch == ")" and paren_depth > 0:
            paren_depth = paren_depth - 1
        elif ch == "," and paren_depth == 0:
            parts.push(s.slice(seg_start, idx))
            seg_start = idx + 1
        idx = idx + 1
    if seg_start < len:
        parts.push(s.slice(seg_start, len))
    parts

pub fn sb_find_top_level_child_combinator(s: text) -> i64:
    # See sb_split_char above.
    var idx = 0
    var paren_depth = 0
    val len = s.len()
    while idx < len:
        val ch = s.slice(idx, idx + 1)
        if ch == "(":
            paren_depth = paren_depth + 1
        elif ch == ")" and paren_depth > 0:
            paren_depth = paren_depth - 1
        elif ch == ">" and paren_depth == 0:
            return idx
        idx = idx + 1
    999999999

pub fn sb_split_ws(s: text) -> [text]:
    # See sb_split_char above.
    var parts: [text] = []
    var seg_start = 0
    var idx = 0
    val len = s.len()
    while idx < len:
        val ch = s.slice(idx, idx + 1)
        if ch == " " or ch == "\t" or ch == "\n" or ch == "\r":
            if idx > seg_start:
                parts.push(s.slice(seg_start, idx))
            seg_start = idx + 1
        idx = idx + 1
    if idx > seg_start:
        parts.push(s.slice(seg_start, idx))
    parts

pub fn sb_skip_ws_comments(s: text, start: i64) -> i64:
    # See sb_split_char above.
    var pos = start
    val slen = s.len()
    while pos < slen:
        val ch = s.slice(pos, pos + 1)
        if ch == " " or ch == "\t" or ch == "\n" or ch == "\r":
            pos = pos + 1
            continue
        # CSS comment: /* ... */
        if pos + 1 < slen and s.slice(pos, pos + 2) == "/*":
            val end = sb_find(s, "*/", pos + 2)
            if end < 999999999:
                pos = end + 2
                continue
            break
        break
    pos

pub fn sb_parse_int(s: text) -> i32:
    """Manual integer parser avoiding optional type bugs in Cranelift."""
    val t = s.trim()
    if t.len() == 0:
        return 0
    var neg = false
    var start = 0
    if t.slice(0, 1) == "-":
        neg = true
        start = 1
    elif t.slice(0, 1) == "+":
        start = 1
    var result = 0
    var idx = start
    val slen = t.len()
    while idx < slen:
        val ch = t.char_at(idx)
        var digit = -1
        if ch == "0": digit = 0
        elif ch == "1": digit = 1
        elif ch == "2": digit = 2
        elif ch == "3": digit = 3
        elif ch == "4": digit = 4
        elif ch == "5": digit = 5
        elif ch == "6": digit = 6
        elif ch == "7": digit = 7
        elif ch == "8": digit = 8
        elif ch == "9": digit = 9
        if digit < 0:
            break
        result = result * 10 + digit
        idx = idx + 1
    if neg:
        return 0 - result
    result

pub fn find_matching_brace(text_val: text, open: i32) -> i32:
    # See sb_split_char above: char_at()'s character-indexing mismatches
    # slice()/len()'s byte-indexing, so brace matching through non-ASCII
    # CSS content (e.g. content: "café") would silently stop early.
    var depth = 0
    var pos = open
    val len = text_val.len()
    while pos < len:
        val ch = text_val.slice(pos, pos + 1)
        if ch == "{":
            depth = depth + 1
        elif ch == "}":
            depth = depth - 1
            if depth == 0:
                return pos
        pos = pos + 1
    999999999
