"""Initial CUDA line breaking for resolved Latin text runs.

The GPU result is evidence-only while inline layout remains CPU-owned. Width
comes exclusively from authored fixed constraints; oracle line boxes are used
only after readback for parity qualification.
"""

use std.common.structural.layout.{LAYOUT_LENGTH_PX}
use std.gc_async_mut.cuda.{
    CUDA_SUCCESS, cuda_memcpy_dtoh, cuda_memcpy_htod
}
use std.gc_async_mut.gpu.engine2d.cuda_session.{CudaSession}
use std.gc_async_mut.gpu.browser_engine.gpu_web.layout.contracts.*
use std.nogc_sync_mut.ptr.raw.{
    raw_alloc, raw_free, raw_read_i32, raw_write_i64,
    raw_write_u32s_checksum
}

val WEB_CUDA_LINE_BREAK_ARG_BYTES: i64 = 40

struct _WebCudaLineBreakCandidate:
    node: WebLayoutNodeSnapshot
    max_width: i64

fn _web_cuda_line_break_ptx() -> text:
    ".version 7.0\n.target sm_52\n.address_size 64\n\n.visible .entry web_line_break_latin(\n    .param .u64 advances,\n    .param .u64 spaces,\n    .param .u64 output,\n    .param .u32 count,\n    .param .u32 max_width\n) {\n    .reg .pred %p<12>;\n    .reg .b32 %r<24>;\n    .reg .b64 %rd<12>;\n    mov.u32 %r0, %tid.x;\n    setp.ne.u32 %p0, %r0, 0;\n    @%p0 bra done;\n    ld.param.u64 %rd0, [advances];\n    ld.param.u64 %rd1, [spaces];\n    ld.param.u64 %rd2, [output];\n    ld.param.u32 %r1, [count];\n    ld.param.u32 %r2, [max_width];\n    mov.u32 %r3, 0;\n    mov.u32 %r4, 0;\n    mov.u32 %r5, 0;\n    mov.u32 %r6, 0;\n    mov.u32 %r7, 0;\nloop:\n    setp.ge.u32 %p1, %r3, %r1;\n    @%p1 bra finish;\n    mul.wide.u32 %rd3, %r3, 4;\n    add.u64 %rd4, %rd0, %rd3;\n    ld.global.u32 %r8, [%rd4];\n    add.u32 %r9, %r5, %r8;\n    setp.le.u32 %p2, %r9, %r2;\n    @%p2 bra fit;\n    setp.eq.u32 %p3, %r3, %r4;\n    @%p3 bra hard_break;\n    setp.gt.u32 %p4, %r6, %r4;\n    @%p4 bra space_break;\n    mov.u32 %r10, %r3;\n    bra store_line;\nhard_break:\n    add.u32 %r10, %r3, 1;\n    bra store_line;\nspace_break:\n    mov.u32 %r10, %r6;\nstore_line:\n    mul.wide.u32 %rd5, %r7, 8;\n    add.u64 %rd6, %rd2, %rd5;\n    st.global.u32 [%rd6+4], %r4;\n    st.global.u32 [%rd6+8], %r10;\n    add.u32 %r7, %r7, 1;\n    mov.u32 %r4, %r10;\nskip_spaces:\n    setp.ge.u32 %p5, %r4, %r1;\n    @%p5 bra reset_line;\n    mul.wide.u32 %rd7, %r4, 4;\n    add.u64 %rd8, %rd1, %rd7;\n    ld.global.u32 %r11, [%rd8];\n    setp.eq.u32 %p6, %r11, 0;\n    @%p6 bra reset_line;\n    add.u32 %r4, %r4, 1;\n    bra skip_spaces;\nreset_line:\n    mov.u32 %r3, %r4;\n    mov.u32 %r5, 0;\n    mov.u32 %r6, %r4;\n    bra loop;\nfit:\n    add.u64 %rd4, %rd1, %rd3;\n    ld.global.u32 %r11, [%rd4];\n    setp.eq.u32 %p7, %r11, 0;\n    @%p7 bra fit_advance;\n    mov.u32 %r6, %r3;\nfit_advance:\n    mov.u32 %r5, %r9;\n    add.u32 %r3, %r3, 1;\n    bra loop;\nfinish:\n    setp.ge.u32 %p8, %r4, %r1;\n    @%p8 bra store_count;\n    mov.u32 %r10, %r1;\n    bra store_line_final;\nstore_line_final:\n    mul.wide.u32 %rd5, %r7, 8;\n    add.u64 %rd6, %rd2, %rd5;\n    st.global.u32 [%rd6+4], %r4;\n    st.global.u32 [%rd6+8], %r10;\n    add.u32 %r7, %r7, 1;\nstore_count:\n    st.global.u32 [%rd2], %r7;\ndone:\n    ret;\n}\n"

fn _web_cuda_line_break_width(snapshot: WebLayoutSnapshot, node: WebLayoutNodeSnapshot) -> i64:
    if node.semantics.box.width.unit == LAYOUT_LENGTH_PX and node.semantics.box.width.value > 0:
        return node.semantics.box.width.value
    for parent in snapshot.nodes:
        if parent.id == node.parent_id and parent.semantics.box.width.unit == LAYOUT_LENGTH_PX:
            var width = parent.semantics.box.width.value
            if parent.semantics.box.border_box:
                width = width - parent.semantics.box.padding.left - parent.semantics.box.padding.right
                width = width - parent.semantics.box.border.left - parent.semantics.box.border.right
            return width
    -1

fn _web_cuda_line_break_latin(text_value: text) -> bool:
    var index: i64 = 0
    while index < text_value.len():
        val code = text_value.char_code_at(index)
        if code < 32 or code > 591:
            return false
        index = index + 1
    true

fn _web_cuda_line_break_candidates(snapshot: WebLayoutSnapshot) -> [_WebCudaLineBreakCandidate]:
    var candidates: [_WebCudaLineBreakCandidate] = []
    for node in snapshot.nodes:
        if node.tag == "#text":
            candidates.push(_WebCudaLineBreakCandidate(
                node: node,
                max_width: _web_cuda_line_break_width(snapshot, node)
            ))
    candidates

fn _web_cuda_line_break_admission_fault(candidates: [_WebCudaLineBreakCandidate]) -> text:
    if candidates.len() == 0:
        return "cuda-line-break-no-text"
    for candidate in candidates:
        val node = candidate.node
        if candidate.max_width <= 0 or candidate.max_width > 2147483647:
            return "cuda-line-break-fixed-width-required"
        if (not node.text_metrics.available or node.text_metrics.font_identity == "" or
            node.text_metrics.advances.len() != node.text_content.len() or
            node.text_metrics.line_height <= 0):
            return "cuda-line-break-resolved-metrics-required"
        if node.text_content.len() == 0:
            return "cuda-line-break-empty-text"
        if not _web_cuda_line_break_latin(node.text_content):
            return "cuda-line-break-complex-script"
        for advance in node.text_metrics.advances:
            if advance <= 0 or advance > 2147483647:
                return "cuda-line-break-invalid-advance"
    ""

fn _web_cuda_line_break_oracle_equal(
    snapshot: WebLayoutSnapshot,
    node_id: i64,
    ranges: [WebGpuLineBreakRange]
) -> bool:
    var oracle_count: i64 = 0
    for line in snapshot.oracle_line_boxes:
        if line.node_id == node_id:
            if oracle_count >= ranges.len():
                return false
            val range = ranges[oracle_count]
            if (range.node_id != node_id or range.line_index != oracle_count or
                range.text_start != line.text_start or range.text_end != line.text_end):
                return false
            oracle_count = oracle_count + 1
    oracle_count == ranges.len()

fn _web_cuda_line_break_cleanup(
    session: CudaSession,
    device_advances: i64,
    device_spaces: i64,
    device_output: i64,
    host_advances: i64,
    host_spaces: i64,
    host_output: i64,
    values_ptr: i64,
    args_ptr: i64,
    input_bytes: i64,
    output_bytes: i64
):
    if device_advances > 0: session.free(device_advances)
    if device_spaces > 0: session.free(device_spaces)
    if device_output > 0: session.free(device_output)
    if host_advances != 0: raw_free(host_advances, input_bytes)
    if host_spaces != 0: raw_free(host_spaces, input_bytes)
    if host_output != 0: raw_free(host_output, output_bytes)
    if values_ptr != 0: raw_free(values_ptr, WEB_CUDA_LINE_BREAK_ARG_BYTES)
    if args_ptr != 0: raw_free(args_ptr, WEB_CUDA_LINE_BREAK_ARG_BYTES)

fn _web_cuda_line_break_failure(
    attempted: bool,
    admitted: bool,
    submitted: bool,
    synchronized: bool,
    readback: bool,
    ranges: [WebGpuLineBreakRange],
    reason: text
) -> WebGpuLineBreakProof:
    WebGpuLineBreakProof(
        attempted: attempted,
        admitted: admitted,
        submitted: submitted,
        synchronized: synchronized,
        device_readback: readback,
        oracle_verified: false,
        ranges: ranges,
        reason: reason
    )

fn web_cuda_line_break(snapshot: WebLayoutSnapshot) -> WebGpuLineBreakProof:
    val candidates = _web_cuda_line_break_candidates(snapshot)
    val admission_fault = _web_cuda_line_break_admission_fault(candidates)
    if admission_fault != "":
        return _web_cuda_line_break_failure(
            candidates.len() > 0, false, false, false, false, [], admission_fault
        )
    var session = CudaSession.create()
    if session.init() != CUDA_SUCCESS or session.activate() != CUDA_SUCCESS:
        session.shutdown()
        return _web_cuda_line_break_failure(
            true, true, false, false, false, [], "cuda-line-break-init-failed"
        )
    if session.load_module(_web_cuda_line_break_ptx()) <= 0:
        session.shutdown()
        return _web_cuda_line_break_failure(
            true, true, false, false, false, [], "cuda-line-break-module-load-failed"
        )

    var all_ranges: [WebGpuLineBreakRange] = []
    for candidate in candidates:
        var advances: [u32] = []
        var spaces: [u32] = []
        var index: i64 = 0
        while index < candidate.node.text_metrics.advances.len():
            advances.push(candidate.node.text_metrics.advances[index] as u32)
            spaces.push(if candidate.node.text_content.char_code_at(index) == 32: 1 else: 0)
            index = index + 1
        val count = advances.len().to_i64()
        val input_bytes = count * 4
        val output_bytes = (1 + count * 2) * 4
        val device_advances = session.alloc(input_bytes)
        val device_spaces = session.alloc(input_bytes)
        val device_output = session.alloc(output_bytes)
        val host_advances = raw_alloc(input_bytes)
        val host_spaces = raw_alloc(input_bytes)
        val host_output = raw_alloc(output_bytes)
        val values_ptr = raw_alloc(WEB_CUDA_LINE_BREAK_ARG_BYTES)
        val args_ptr = raw_alloc(WEB_CUDA_LINE_BREAK_ARG_BYTES)
        if (device_advances <= 0 or device_spaces <= 0 or device_output <= 0 or
            host_advances == 0 or host_spaces == 0 or host_output == 0 or
            values_ptr == 0 or args_ptr == 0):
            _web_cuda_line_break_cleanup(
                session, device_advances, device_spaces, device_output,
                host_advances, host_spaces, host_output, values_ptr, args_ptr,
                input_bytes, output_bytes
            )
            session.shutdown()
            return _web_cuda_line_break_failure(
                true, true, false, false, false, all_ranges,
                "cuda-line-break-allocation-failed"
            )
        raw_write_u32s_checksum(host_advances, advances, count)
        raw_write_u32s_checksum(host_spaces, spaces, count)
        val uploaded = (
            cuda_memcpy_htod(device_advances, host_advances, input_bytes) == CUDA_SUCCESS and
            cuda_memcpy_htod(device_spaces, host_spaces, input_bytes) == CUDA_SUCCESS
        )
        raw_write_i64(values_ptr, 0, device_advances)
        raw_write_i64(values_ptr, 8, device_spaces)
        raw_write_i64(values_ptr, 16, device_output)
        raw_write_i64(values_ptr, 24, count)
        raw_write_i64(values_ptr, 32, candidate.max_width)
        raw_write_i64(args_ptr, 0, values_ptr)
        raw_write_i64(args_ptr, 8, values_ptr + 8)
        raw_write_i64(args_ptr, 16, values_ptr + 16)
        raw_write_i64(args_ptr, 24, values_ptr + 24)
        raw_write_i64(args_ptr, 32, values_ptr + 32)
        val submitted = uploaded and session.launch_kernel_args(
            "web_line_break_latin", 1, 1, 1, 1, 1, 1, args_ptr
        ) == CUDA_SUCCESS
        val synchronized = submitted and session.sync() == CUDA_SUCCESS
        val readback = synchronized and cuda_memcpy_dtoh(
            host_output, device_output, output_bytes
        ) == CUDA_SUCCESS
        var node_ranges: [WebGpuLineBreakRange] = []
        if readback:
            val line_count = raw_read_i32(host_output, 0) as i64
            if line_count < 0 or line_count > count:
                _web_cuda_line_break_cleanup(
                    session, device_advances, device_spaces, device_output,
                    host_advances, host_spaces, host_output, values_ptr, args_ptr,
                    input_bytes, output_bytes
                )
                session.shutdown()
                return _web_cuda_line_break_failure(
                    true, true, submitted, synchronized, true, all_ranges,
                    "cuda-line-break-readback-shape-mismatch"
                )
            var line_index: i64 = 0
            while line_index < line_count:
                val offset = 4 + line_index * 8
                node_ranges.push(WebGpuLineBreakRange(
                    node_id: candidate.node.id,
                    line_index: line_index,
                    text_start: raw_read_i32(host_output, offset) as i64,
                    text_end: raw_read_i32(host_output, offset + 4) as i64
                ))
                line_index = line_index + 1
        _web_cuda_line_break_cleanup(
            session, device_advances, device_spaces, device_output,
            host_advances, host_spaces, host_output, values_ptr, args_ptr,
            input_bytes, output_bytes
        )
        if not uploaded or not submitted or not synchronized or not readback:
            session.shutdown()
            val reason = if not uploaded:
                "cuda-line-break-upload-failed"
            elif not submitted:
                "cuda-line-break-submit-failed"
            elif not synchronized:
                "cuda-line-break-sync-failed"
            else:
                "cuda-line-break-readback-failed"
            return _web_cuda_line_break_failure(
                true, true, submitted, synchronized, readback, all_ranges, reason
            )
        if not _web_cuda_line_break_oracle_equal(snapshot, candidate.node.id, node_ranges):
            for range in node_ranges:
                all_ranges.push(range)
            session.shutdown()
            return _web_cuda_line_break_failure(
                true, true, true, true, true, all_ranges,
                "cuda-line-break-oracle-mismatch"
            )
        for range in node_ranges:
            all_ranges.push(range)
    session.shutdown()
    WebGpuLineBreakProof(
        attempted: true,
        admitted: true,
        submitted: true,
        synchronized: true,
        device_readback: true,
        oracle_verified: true,
        ranges: all_ranges,
        reason: ""
    )

export web_cuda_line_break
