#![allow(REQC001)]
#![allow(REQC004)]
#![allow(unnamed_duplicate_typed_args)]

use std.gc_async_mut.gpu.browser_engine.style.animation.{CSSValue, CSSDeclaration}
use std.gc_async_mut.gpu.browser_engine.shared.logging.{Logger, BrowserLogLevel}

pub class CustomProperty:
    name: text
    value: text
    node_id: i64
    inherited: bool

    static fn create(name: text, value: text, node_id: i64) -> CustomProperty:
        CustomProperty(name: name, value: value, node_id: node_id, inherited: true)

pub class Pair:
    first: text
    second: text

    static fn create(first: text, second: text) -> Pair:
        Pair(first: first, second: second)

val CUSTOM_PROPERTY_RESOLUTION_DEPTH_CAP: i32 = 32
val CUSTOM_PROPERTY_SUBSTITUTION_BUDGET: i32 = 1024

enum CustomPropertyResolution:
    Resolved(value: text)
    Invalid
    Cycle
    DepthExceeded
    BudgetExceeded

class CustomPropertyResolutionState:
    remaining: i32
    active_names: [text]
    memo_names: [text]
    memo_values: [text]
    memo_count: i32

    static fn new() -> CustomPropertyResolutionState:
        CustomPropertyResolutionState(
            remaining: CUSTOM_PROPERTY_SUBSTITUTION_BUDGET,
            active_names: [""; 33],
            memo_names: [""; 200],
            memo_values: [""; 200],
            memo_count: 0
        )

pub class CustomPropertyStore:
    properties: [CustomProperty]
    logger: Logger

    static fn new(logger: Logger) -> CustomPropertyStore:
        val empty: [CustomProperty] = []
        CustomPropertyStore(properties: empty, logger: logger)

    me set_property(node_id: i64, name: text, value: text):
        """Set a custom property on a node. Name must start with '--'."""
        if not is_custom_property(name):
            self.logger.warn("attempted to set non-custom property '{name}' as custom property")
            return

        var found = false
        var new_props: [CustomProperty] = []
        for prop in self.properties:
            if prop.node_id == node_id and prop.name == name:
                new_props.push(CustomProperty.create(name, value, node_id))
                found = true
            else:
                new_props.push(prop)

        if found:
            self.properties = new_props
            self.logger.trace("custom property updated: {name} = {value} on node {node_id}")
            return

        self.properties.push(CustomProperty.create(name, value, node_id))
        self.logger.trace("custom property set: {name} = {value} on node {node_id}")

    fn get_property(node_id: i64, name: text) -> text?:
        """Get the raw value of a custom property for a node. Returns nil if not found."""
        for prop in self.properties:
            if prop.node_id == node_id and prop.name == name:
                return prop.value
        return nil

    fn _resolve_var_state(
        value: text, node_id: i64, depth: i32,
        active_count: i32, state: CustomPropertyResolutionState,
        resolving_property: bool
    ) -> CustomPropertyResolution:
        if depth > CUSTOM_PROPERTY_RESOLUTION_DEPTH_CAP:
            return CustomPropertyResolution.DepthExceeded
        if not has_var_reference(value):
            return CustomPropertyResolution.Resolved(value: value)
        if state.remaining <= 0:
            return CustomPropertyResolution.BudgetExceeded
        state.remaining = state.remaining - 1

        val parsed = parse_var_function(value)
        val var_name = parsed.first
        val fallback = parsed.second
        val var_start = value.index_of("var(")
        var close_depth = 1
        var close_scan = var_start + 4
        while close_scan < value.len() and close_depth > 0:
            val ch = value.char_at(close_scan)
            if ch == "(":
                close_depth = close_depth + 1
            elif ch == ")":
                close_depth = close_depth - 1
            close_scan = close_scan + 1
        if close_depth != 0:
            return CustomPropertyResolution.Invalid
        val prefix = value.substring(0, var_start)
        val suffix = value.substring(close_scan, value.len())
        var replacement = CustomPropertyResolution.Invalid
        var found = false
        var prop_val = ""
        if is_custom_property(var_name):
            for prop in self.properties:
                if prop.node_id == node_id and prop.name == var_name:
                    prop_val = prop.value
                    found = true
        if found:
            var cycle = false
            var active_scan = 0
            while active_scan < active_count:
                if state.active_names[active_scan] == var_name:
                    cycle = true
                    break
                active_scan = active_scan + 1
            if cycle:
                replacement = CustomPropertyResolution.Cycle
            else:
                var memo_index = -1
                var memo_scan = 0
                while memo_scan < state.memo_count:
                    if state.memo_names[memo_scan] == var_name:
                        memo_index = memo_scan
                        break
                    memo_scan = memo_scan + 1
                if memo_index >= 0:
                    replacement = CustomPropertyResolution.Resolved(
                        value: state.memo_values[memo_index]
                    )
                elif has_var_reference(prop_val):
                    if active_count >= state.active_names.len():
                        return CustomPropertyResolution.DepthExceeded
                    state.active_names[active_count] = var_name
                    replacement = self._resolve_var_state(
                        prop_val, node_id, depth + 1,
                        active_count + 1, state, true
                    )
                else:
                    replacement = CustomPropertyResolution.Resolved(
                        value: prop_val
                    )
                match replacement:
                    CustomPropertyResolution.Resolved(resolved_value):
                        if state.memo_count < state.memo_names.len():
                            state.memo_names[state.memo_count] = var_name
                            state.memo_values[state.memo_count] = resolved_value
                            state.memo_count = state.memo_count + 1
                    _:
                        pass

        var should_use_fallback = false
        match replacement:
            CustomPropertyResolution.Invalid:
                should_use_fallback = is_custom_property(var_name)
            CustomPropertyResolution.Cycle:
                should_use_fallback = not resolving_property
            CustomPropertyResolution.DepthExceeded:
                should_use_fallback = not resolving_property
            _:
                pass
        if should_use_fallback and fallback.len() > 0:
            replacement = self._resolve_var_state(
                fallback, node_id, depth + 1, active_count, state,
                resolving_property
            )

        match replacement:
            CustomPropertyResolution.Resolved(resolved_value):
                val combined = prefix + resolved_value + suffix
                if has_var_reference(combined):
                    return self._resolve_var_state(
                        combined, node_id, depth, active_count, state,
                        resolving_property
                    )
                CustomPropertyResolution.Resolved(value: combined)
            CustomPropertyResolution.Invalid:
                self.logger.warn(
                    "unresolved custom property: {var_name} on node {node_id}"
                )
                CustomPropertyResolution.Invalid
            CustomPropertyResolution.Cycle:
                CustomPropertyResolution.Cycle
            CustomPropertyResolution.DepthExceeded:
                CustomPropertyResolution.DepthExceeded
            CustomPropertyResolution.BudgetExceeded:
                CustomPropertyResolution.BudgetExceeded

    fn resolve_var(value: text, node_id: i64) -> CSSValue:
        val resolved = self._resolve_var_state(
            value, node_id, 0, 0, CustomPropertyResolutionState.new(),
            false
        )
        match resolved:
            CustomPropertyResolution.Resolved(resolved_value):
                CSSValue.Keyword(v: resolved_value)
            _:
                CSSValue.Initial

    fn resolve_all_vars(declarations: [CSSDeclaration], node_id: i64) -> [CSSDeclaration]:
        """Resolve all var() references in a list of declarations."""
        var result: [CSSDeclaration] = []
        val state = CustomPropertyResolutionState.new()
        for decl in declarations:
            match decl.value:
                CSSValue.Keyword(v):
                    if has_var_reference(v):
                        val resolved = self._resolve_var_state(
                            v, node_id, 0, 0, state, false
                        )
                        val css_value = match resolved:
                            CustomPropertyResolution.Resolved(resolved_value):
                                CSSValue.Keyword(v: resolved_value)
                            _:
                                CSSValue.Initial
                        result.push(CSSDeclaration(
                            property: decl.property, value: css_value,
                            important: decl.important
                        ))
                    else:
                        result.push(decl)
                _:
                    result.push(decl)
        result

    me inherit_properties(parent_id: i64, child_id: i64):
        """Propagate inherited custom properties from parent to child node."""
        var to_add: [CustomProperty] = []

        for prop in self.properties:
            if prop.node_id == parent_id and prop.inherited:
                var child_has = false
                for existing in self.properties:
                    if existing.node_id == child_id and existing.name == prop.name:
                        child_has = true
                if not child_has:
                    to_add.push(CustomProperty(
                        name: prop.name,
                        value: prop.value,
                        node_id: child_id,
                        inherited: true
                    ))

        for p in to_add:
            self.properties.push(p)

        if to_add.len() > 0:
            self.logger.trace("inherited {to_add.len()} custom properties from node {parent_id} to {child_id}")

pub fn is_custom_property(name: text) -> bool:
    """Return true if name is a CSS custom property (starts with '--')."""
    if name.len() < 3:
        return false
    return name.starts_with("--")

pub fn has_var_reference(value: text) -> bool:
    """Return true if value contains a var() reference."""
    value.contains("var(")

pub fn parse_var_function(value: text) -> Pair:
    """Parse a var(--name, fallback) call. Returns Pair(first=name, second=fallback)."""
    val var_start = value.index_of("var(")
    if var_start < 0:
        return Pair.create("", "")

    val content_start = var_start + 4
    var paren_depth = 1
    var content_end = content_start
    while content_end < value.len() and paren_depth > 0:
        val ch = value.char_at(content_end)
        if ch == "(":
            paren_depth = paren_depth + 1
        else if ch == ")":
            paren_depth = paren_depth - 1
        if paren_depth > 0:
            content_end = content_end + 1
    if paren_depth != 0:
        return Pair.create("", "")

    val content = value.substring(content_start, content_end).trim()

    var comma_pos = -1
    var comma_depth = 0
    var comma_scan = 0
    while comma_scan < content.len():
        val ch = content.char_at(comma_scan)
        if ch == "(":
            comma_depth = comma_depth + 1
        elif ch == ")":
            if comma_depth > 0:
                comma_depth = comma_depth - 1
        elif ch == "," and comma_depth == 0:
            comma_pos = comma_scan
            break
        comma_scan = comma_scan + 1
    if comma_pos < 0:
        return Pair.create(content.trim(), "")

    val var_name = content.substring(0, comma_pos).trim()
    val fallback = content.substring(comma_pos + 1, content.len()).trim()
    Pair.create(var_name, fallback)
