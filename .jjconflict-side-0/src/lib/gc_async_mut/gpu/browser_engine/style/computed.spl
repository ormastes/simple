#![allow(REQC001)]
#![allow(REQC004)]

"""Computed style snapshot for the browser engine style pipeline.

`ComputedStyle` is the resolved property set for one node: the input that
transition detection diffs between two frames.

This module is the library home for `ComputedStyle` and
`get_property_from_style`. They previously did not exist anywhere:
`style/animation_controller.spl` imported them from a non-existent
`examples.browser.feature.style.computed` tree, which the compiler only WARNs
about, so `AnimationController.detect_transitions` would have died at runtime
on the first `get_property_from_style` call.
"""

use std.gc_async_mut.gpu.browser_engine.style.animation.{CSSValue, CSSDeclaration}

pub class ComputedStyle:
    declarations: [CSSDeclaration]

    static fn empty() -> ComputedStyle:
        ComputedStyle(declarations: [])

    static fn from_declarations(declarations: [CSSDeclaration]) -> ComputedStyle:
        ComputedStyle(declarations: declarations)

    me set(property: text, value: CSSValue):
        """Set a property, replacing any existing declaration for it."""
        var kept: [CSSDeclaration] = []
        for decl in self.declarations:
            if decl.property != property:
                kept.push(decl)
        kept.push(CSSDeclaration.create(property, value))
        self.declarations = kept

    fn has_property(property: text) -> bool:
        var found = false
        for decl in self.declarations:
            if decl.property == property:
                found = true
        found

pub fn get_property_from_style(style: ComputedStyle, property: text) -> CSSValue:
    """Resolved value of `property`, or `CSSValue.Unset` when absent.

    Returns the LAST matching declaration, matching cascade order where a later
    declaration for the same property wins.
    """
    var result = CSSValue.Unset
    for decl in style.declarations:
        if decl.property == property:
            result = decl.value
    result
