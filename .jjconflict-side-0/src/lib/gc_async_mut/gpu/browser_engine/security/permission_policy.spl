"""
# Permission Policy

Per-origin permission grants for the browser engine. There was no permission
model anywhere in the engine tree before this.

Design is default-deny by construction, not by convention: only *granted*
(origin, feature) pairs are stored, so an absent entry, a revoked entry, an
unknown feature and an opaque origin are all indistinguishable at the query
boundary — they all read `Denied`.

Keying is `serialize_origin(origin) + "|" + feature`, so scheme and port
differences produce different keys and a grant cannot leak between origins.
An opaque origin serializes to `"null"` and is rejected before it can ever be
stored, so it can never hold a grant.
"""

use std.gc_async_mut.gpu.browser_engine.net.entity.url_types.{Origin}
use std.gc_async_mut.gpu.browser_engine.security.origin_policy.{
    is_opaque,
    is_tuple_origin,
    serialize_origin,
    is_potentially_trustworthy
}

pub enum PermissionState:
    """Result of a permission query. `Denied` is the only default."""
    Denied
    Granted

pub fn state_is_granted(state: PermissionState) -> bool:
    match state:
        PermissionState.Granted:
            return true
        PermissionState.Denied:
            return false
    return false

pub fn known_features() -> [text]:
    """The closed set of permission features. Anything else is rejected."""
    return [
        "geolocation",
        "notifications",
        "camera",
        "microphone",
        "clipboard-read",
        "clipboard-write",
        "midi",
        "persistent-storage",
        "screen-wake-lock"
    ]

pub fn is_known_feature(feature: text) -> bool:
    val features = known_features()
    var i = 0
    while i < features.len():
        if features[i] == feature:
            return true
        i = i + 1
    return false

pub fn requires_secure_context(feature: text) -> bool:
    """Powerful features that may only be granted to a secure context."""
    if feature == "geolocation":
        return true
    if feature == "camera":
        return true
    if feature == "microphone":
        return true
    if feature == "notifications":
        return true
    if feature == "clipboard-read":
        return true
    return false

pub fn permission_key(origin: Origin, feature: text) -> text:
    """Storage key, or empty text when this pair may never be stored."""
    if is_opaque(origin) or not is_tuple_origin(origin):
        return ""
    if not is_known_feature(feature):
        return ""
    val serialized = serialize_origin(origin)
    if serialized == "null":
        return ""
    return serialized + "|" + feature

pub class PermissionSet:
    """Permission grants keyed by origin and feature. Default-deny."""
    _granted: [text]

    static fn create() -> PermissionSet:
        return PermissionSet(_granted: [])

    me fn _index_of(key: text) -> i64:
        var i = 0
        while i < self._granted.len():
            if self._granted[i] == key:
                return i
            i = i + 1
        return -1

    me fn grant(origin: Origin, feature: text) -> bool:
        """Grant a permission. Returns false when the grant was refused.

        Refused for: opaque origins, malformed origins, unknown features, and
        secure-context-only features requested from a non-secure origin.
        """
        val key = permission_key(origin, feature)
        if key == "":
            return false
        if requires_secure_context(feature) and not is_potentially_trustworthy(origin):
            return false
        if self._index_of(key) >= 0:
            return true
        var granted = self._granted
        granted.push(key)
        self._granted = granted
        return true

    me fn revoke(origin: Origin, feature: text) -> bool:
        """Revoke one permission. Returns true when something was removed."""
        val key = permission_key(origin, feature)
        if key == "":
            return false
        val idx = self._index_of(key)
        if idx < 0:
            return false
        var kept: [text] = []
        var i = 0
        while i < self._granted.len():
            if i != idx:
                kept.push(self._granted[i])
            i = i + 1
        self._granted = kept
        return true

    me fn revoke_origin(origin: Origin) -> i64:
        """Revoke every permission held by `origin`. Returns the count removed."""
        if is_opaque(origin) or not is_tuple_origin(origin):
            return 0
        val prefix = serialize_origin(origin) + "|"
        if prefix == "null|":
            return 0
        var kept: [text] = []
        var removed = 0
        var i = 0
        while i < self._granted.len():
            val key = self._granted[i]
            if key.starts_with(prefix):
                removed = removed + 1
            else:
                kept.push(key)
            i = i + 1
        self._granted = kept
        return removed

    me fn query(origin: Origin, feature: text) -> PermissionState:
        """Query a permission. Every path that is not an explicit grant denies."""
        val key = permission_key(origin, feature)
        if key == "":
            return PermissionState.Denied
        if self._index_of(key) < 0:
            return PermissionState.Denied
        return PermissionState.Granted

    me fn allows(origin: Origin, feature: text) -> bool:
        """Convenience boolean form of `query`."""
        return state_is_granted(self.query(origin, feature))

    me fn granted_count() -> i64:
        return self._granted.len()
