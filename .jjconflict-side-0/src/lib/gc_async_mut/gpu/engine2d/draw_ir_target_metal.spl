"""Metal-only implementation of the shared Draw IR render target."""

use std.common.encoding.font_registry.{
    selected_font_asset_local_path_for_identity
}
use std.common.ui.draw_ir.{DrawIrGlyphRunPayload}
use std.gc_async_mut.gpu.engine2d.backend.{
    Engine2DReadback
}
use std.gc_async_mut.gpu.engine2d.backend_emu.{
    emu_draw_image_scaled_blend
}
use std.gc_async_mut.gpu.engine2d.backend_metal.{MetalBackend}
use std.gc_async_mut.gpu.engine2d.draw_ir_target.{
    DrawIrRenderTarget,
    DrawIrTargetFontEvidence
}
use std.gc_async_mut.gpu.engine2d.draw_ir_glass_material.{
    Engine2dGlassExecutionResult,
    Engine2dGlassMaterialConfig,
    engine2d_glass_execution_metal,
    engine2d_glass_execution_unavailable
}
use std.gc_async_mut.text_layout.font_renderer.{
    FontRenderBatch,
    FontRenderer
}
use std.nogc_sync_mut.text_layout.font_types.{
    font_render_config_default_for_size
}

class MetalDrawIrRenderTarget with DrawIrRenderTarget:
    backend: MetalBackend
    font_renderer: FontRenderer
    last_font_target: text

    me _draw_staged_font(x: i32, y: i32) -> bool:
        var atlas: [u32] = []
        if not self.font_renderer.staged_atlas_empty:
            atlas = self.font_renderer.atlas_pixels
        val batch = FontRenderBatch(
            program_version: self.font_renderer.staged_program_version,
            transform_identity: self.font_renderer.staged_transform_identity,
            font_identity: self.font_renderer.staged_font_identity,
            face_generation: self.font_renderer.staged_face_generation,
            valid: self.font_renderer.staged_valid,
            atlas_width: self.font_renderer.staged_atlas_width,
            atlas_height: self.font_renderer.staged_atlas_height,
            atlas_pixels: atlas,
            quads: self.font_renderer.staged_quads,
            atlas_generation: self.font_renderer.staged_atlas_generation,
            dirty_rects: self.font_renderer.staged_dirty_rects,
            atlas_owner_generation: self.font_renderer.staged_atlas_owner_generation,
            render_config_identity: self.font_renderer.staged_render_config_identity,
            execution_target: self.font_renderer.staged_execution_target,
            execution_policy: self.font_renderer.staged_execution_policy
        )
        val drawn = self.backend.draw_font_batch(x, y, batch)
        val complete = (
            batch.valid and batch.quads.len() > 0 and
            drawn == batch.quads.len()
        )
        self.last_font_target = if complete: "metal" else: ""
        complete

    me backend_name() -> text:
        "metal"

    me width() -> i32:
        self.backend.width()

    me height() -> i32:
        self.backend.height()

    me draw_ir_apply_glass_material(
        config: Engine2dGlassMaterialConfig
    ) -> Engine2dGlassExecutionResult:
        val applied = self.backend.draw_ir_apply_glass_material_device(config)
        if applied:
            return engine2d_glass_execution_metal(
                self.backend.d_framebuffer, self.backend.device_identity)
        if not self.backend.initialized:
            return engine2d_glass_execution_unavailable(
                "device-glass-state-unknown")
        engine2d_glass_execution_unavailable(self.backend.last_error)

    me clear(color: u32):
        self.backend.clear(color)

    me draw_rect_filled(x: i32, y: i32, w: i32, h: i32, color: u32):
        self.backend.draw_rect_filled(x, y, w, h, color)

    me draw_rounded_rect(x: i32, y: i32, w: i32, h: i32, radius: i32, color: u32):
        self.backend.draw_rounded_rect(x, y, w, h, radius, color)

    me draw_rounded_rect_outline(x: i32, y: i32, w: i32, h: i32, radius: i32, color: u32, thickness: i32):
        self.backend.draw_rounded_rect_outline(
            x, y, w, h, radius, color, thickness)

    me draw_gradient_rect(x: i32, y: i32, w: i32, h: i32, top_color: u32, bottom_color: u32):
        self.backend.draw_gradient_rect(
            x, y, w, h, top_color, bottom_color)

    me draw_shadow_rect(x: i32, y: i32, w: i32, h: i32, offset_x: i32, offset_y: i32, blur_r: i32, color: u32):
        self.backend.draw_shadow_rect(
            x, y, w, h, offset_x, offset_y, blur_r, color)

    me draw_text(x: i32, y: i32, text_val: text, color: u32, font_size: i32):
        if self.font_renderer.current_font_identity() != "":
            val config = font_render_config_default_for_size(font_size)
            self.font_renderer.stage_text_configured(text_val, color, config)
            self._draw_staged_font(x, y)
            return
        self.last_font_target = ""
        self.backend.draw_text(x, y, text_val, color, font_size)

    me draw_text_with_advances(x: i32, y: i32, text_val: text, advance_widths: [i32], color: u32, font_size: i32) -> bool:
        val config = font_render_config_default_for_size(font_size)
        self.font_renderer.stage_text_with_advances_configured(
            text_val, advance_widths, color, config)
        self._draw_staged_font(x, y)

    me draw_shaped_text(x: i32, y: i32, glyph_run: DrawIrGlyphRunPayload, color: u32, font_size: i32) -> bool:
        val config = font_render_config_default_for_size(font_size)
        self.font_renderer.stage_selected_glyph_run_configured(
            glyph_run, color, config)
        self._draw_staged_font(x, y)

    me draw_image(x: i32, y: i32, w: i32, h: i32, pixels: [u32]):
        self.backend.draw_image(x, y, w, h, pixels)

    me draw_image_blend(x: i32, y: i32, w: i32, h: i32, pixels: [u32]):
        self.backend.draw_image_blend(x, y, w, h, pixels)

    me draw_image_scaled(dst_x: i32, dst_y: i32, dst_w: i32, dst_h: i32, src_w: i32, src_h: i32, pixels: [u32]):
        self.backend.draw_image_scaled(
            dst_x, dst_y, dst_w, dst_h, src_w, src_h, pixels)

    me draw_image_scaled_blend(dst_x: i32, dst_y: i32, dst_w: i32, dst_h: i32, src_w: i32, src_h: i32, pixels: [u32]):
        emu_draw_image_scaled_blend(
            self.backend, dst_x, dst_y, dst_w, dst_h,
            src_w, src_h, pixels)

    me set_clip(x: i32, y: i32, w: i32, h: i32):
        self.backend.set_clip(x, y, w, h)

    me clear_clip():
        self.backend.clear_clip()

    me clear_mask():
        self.backend.clear_mask()

    me select_font_identity(identity: text) -> bool:
        if identity == "":
            return false
        if self.font_renderer.current_font_identity() == identity:
            return true
        if self.font_renderer.try_load_registered_identity(identity):
            return self.font_renderer.current_font_identity() == identity
        val path = selected_font_asset_local_path_for_identity(identity)
        if path == "" or not self.font_renderer.try_load_runtime_ttf(path):
            return false
        self.font_renderer.current_font_identity() == identity

    me fonts() -> FontRenderer:
        self.font_renderer

    me install_font_renderer(renderer: FontRenderer):
        self.backend.invalidate_font_atlas()
        self.font_renderer = renderer
        self.last_font_target = ""

    fn font_execution_target() -> text:
        self.last_font_target

    fn draw_ir_font_evidence() -> DrawIrTargetFontEvidence?:
        nil

    me draw_ir_create_offscreen(width: i32, height: i32) -> Result<DrawIrRenderTarget, text>:
        val pixel_count = width.to_i64() * height.to_i64()
        if (width <= 0 or height <= 0 or pixel_count <= 0 or
            pixel_count > 2147483647):
            return Err("invalid-shared-metal-surface-size")
        if not self.backend.session.is_valid():
            return Err("shared-metal-session-required")
        var child_backend = MetalBackend.create()
        if not child_backend.init_with_session(
            width, height, self.backend.session
        ):
            val reason = if child_backend.last_error == "":
                "shared-metal-surface-init-failed"
            else:
                child_backend.last_error
            return Err(reason)
        Ok(MetalDrawIrRenderTarget(
            backend: child_backend,
            font_renderer: FontRenderer.new(),
            last_font_target: ""
        ))

    me draw_ir_composite_readback(dst_x: i32, dst_y: i32, width: i32, height: i32, readback: Engine2DReadback, opacity_milli: i32) -> bool:
        if (width <= 0 or height <= 0 or opacity_milli <= 0 or
            opacity_milli > 1000):
            return false
        if (readback.source != "device_readback" or
            readback.backend_handle <= 0 or
            readback.device_identity <= 0 or
            readback.device_identity != self.backend.device_identity):
            return false
        if readback.pixels.len() != width.to_i64() * height.to_i64():
            return false
        self.backend.draw_image_blend_checked(
            dst_x, dst_y, width, height, readback.pixels, opacity_milli)

    me present():
        self.backend.present()

    me read_pixels() -> [u32]:
        self.backend.read_pixels()

    me read_pixels_with_source() -> Engine2DReadback:
        # BackendMetal owns both framebuffer and device identity. Forward its
        # receipt unchanged so this adapter cannot mask an owner-level mismatch.
        self.backend.read_pixels_with_source()

    me shutdown():
        self.backend.shutdown()
        self.last_font_target = ""

fn _metal_draw_ir_render_target_create(width: i32, height: i32) -> Result<MetalDrawIrRenderTarget, text>:
    val pixel_count = width.to_i64() * height.to_i64()
    if (width <= 0 or height <= 0 or pixel_count <= 0 or
        pixel_count > 2147483647):
        return Err("invalid-metal-render-target-size")
    var backend = MetalBackend.create()
    if not backend.init(width, height):
        val reason = if backend.last_error == "":
            "metal-render-target-init-failed"
        else:
            backend.last_error
        return Err(reason)
    val identity = backend.device_identity
    if identity <= 0:
        backend.shutdown()
        return Err("metal-device-identity-unavailable")
    Ok(MetalDrawIrRenderTarget(
        backend: backend,
        font_renderer: FontRenderer.new(),
        last_font_target: ""
    ))

fn metal_draw_ir_render_target_create(width: i32, height: i32) -> Result<DrawIrRenderTarget, text>:
    match _metal_draw_ir_render_target_create(width, height):
        Err(reason): Err(reason)
        Ok(target): Ok(target)

fn metal_draw_ir_render_target_probe() -> Result<bool, text>:
    match _metal_draw_ir_render_target_create(1, 1):
        Err(reason): Err(reason)
        Ok(target):
            val available = (
                target.backend_name() == "metal" and
                target.backend.device_identity > 0)
            target.shutdown()
            Ok(available)

export MetalDrawIrRenderTarget
export metal_draw_ir_render_target_create, metal_draw_ir_render_target_probe
