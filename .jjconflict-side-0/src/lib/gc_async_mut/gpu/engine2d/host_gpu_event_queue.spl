fn engine2d_host_gpu_runtime_completed_count() -> i64:
    engine2d_host_gpu_host_completed_count()

fn engine2d_host_gpu_runtime_in_flight_count() -> i64:
    engine2d_host_gpu_host_in_flight_count()

fn engine2d_host_gpu_runtime_last_status() -> i64:
    engine2d_host_gpu_host_last_status()

fn engine2d_host_gpu_runtime_last_backend_handle() -> i64:
    engine2d_host_gpu_host_last_backend_handle()

