# SCV refactoring relations — SCV-IMPL-I-04.
#
# Infers refactoring operations between two versions of a set of files as
# MANY-TO-MANY lineage edges over symbol declarations.
#
# STABLE API (consumed by D-03 edit_graph.spl and by the D-04 identity-merge
# lane — keep signatures and the row format below backward compatible; add
# new kinds/evidence tokens rather than renaming existing ones):
#
#   struct RefactorFileInput(rel, old_text, new_text)
#       old_text == "" means the file was added; new_text == "" means deleted.
#       A rename across files is expressed as two inputs (old rel with
#       new_text "", new rel with old_text "").
#   scv_refactor_infer(files: [RefactorFileInput]) -> [text]
#       rows "kind|from|to|confidence_milli|evidence|status"
#         kind   : rename | move | move_rename | extract | inline | split |
#                  merge | pull_up | push_down | signature_change
#         from/to: comma-separated symbol refs "<rel>:<kind>:<qualified name>"
#                  (many-to-many: `from` and `to` may each list several)
#         status : accepted | suggested | ambiguous
#                  `ambiguous` rows carry EVERY tied candidate in `to` and are
#                  never folded into an accepted edge (I-05 contract).
#   scv_refactor_units(rel, source) -> [DeclUnit]   declaration units
#   scv_refactor_rows_of_kind(rows, kind) -> [text]
#
# Matcher pipeline (plan row I-04):
#   1. anchors      — same (rel, kind, qualified name) on both sides; a
#                     changed header line on an anchored fn = signature_change.
#   2. GumTree-style — unmatched deleted x added units of the SAME kind,
#                     Dice over body lines, candidates indexed by kind and
#                     capped: at most SCV_REFACTOR_CANDIDATES_PER_UNIT per
#                     deleted unit and SCV_REFACTOR_MAX_PAIRS comparisons in
#                     total; beyond the caps units fail open to plain
#                     deleted/added (reported by callers, never guessed).
#                     The best candidate must beat the runner-up by
#                     SCV_REFACTOR_AMBIGUITY_MARGIN_MILLI or the unit is
#                     reported `ambiguous`.
#                     same file + same container, new name  -> rename
#                     other file, same name                 -> move
#                     other file, new name                  -> move_rename
#                     same file, container type -> trait    -> pull_up
#                     same file, container trait -> type    -> push_down
#                     same file, other container change     -> move
#   3. RefactoringMiner-style rules using line containment (|a n b| / |a|,
#      milli).  split/merge run BEFORE stage 2 (a unit split in two must not
#      pair as a rename onto one half); extract/inline run after it:
#                     one deleted -> >=2 added containing its lines  -> split
#                     >=2 deleted -> one added containing their lines -> merge
#                     lines removed from an anchored unit reappear in a
#                     new unit                                        -> extract
#                     a deleted unit's lines reappear inside an
#                     anchored unit that grew                         -> inline
#
# Declaration extraction is the interim .spl scanner of symbol_entity.spl
# (SCV-IMPL-I-03); the same TODO(SCV-IMPL-P-06) applies here.

use std.scv.symbol_entity.{scv_symbol_extract_decls}
use std.scv.structural_match.{scv_dice_similarity}

val SCV_REFACTOR_MAX_PAIRS = 512
val SCV_REFACTOR_CANDIDATES_PER_UNIT = 64
val SCV_REFACTOR_MIN_DICE_MILLI = 500
val SCV_REFACTOR_CONTAIN_MIN_MILLI = 700
val SCV_REFACTOR_AMBIGUITY_MARGIN_MILLI = 50

struct RefactorFileInput:
    rel: text
    old_text: text
    new_text: text

struct DeclUnit:
    rel: text
    kind: text
    name: text        # bare declaration name
    qname: text       # container.name or name
    container: text
    container_kind: text
    header: text      # trimmed declaration line
    body: [text]      # trimmed non-empty lines after the header
    line_start: i64
    line_end: i64

fn scv_refactor_field(row: text, index: i64) -> text:
    val parts = row.split("|")
    if index < parts.len():
        parts[index]
    else:
        ""

fn scv_refactor_ref(u: DeclUnit) -> text:
    "{u.rel}:{u.kind}:{u.qname}"

fn scv_refactor_units(rel: text, source: text) -> [DeclUnit]:
    var out: [DeclUnit] = []
    if source == "":
        return out
    val lines = source.split("\n")
    # a trailing newline yields an empty last segment that is not a line
    val line_count = if lines.len() > 0 and lines[lines.len() - 1] == "": lines.len() - 1 else: lines.len()
    val decls = scv_symbol_extract_decls(source)
    var container_kinds: [text] = []
    var container_names: [text] = []
    var i = 0
    while i < decls.len():
        val kind = scv_refactor_field(decls[i], 0)
        val name = scv_refactor_field(decls[i], 1)
        val start = scv_refactor_field(decls[i], 2).to_int() ?? 1
        val container = scv_refactor_field(decls[i], 3)
        val end = if i + 1 < decls.len(): (scv_refactor_field(decls[i + 1], 2).to_int() ?? start) - 1 else: line_count
        var ckind = ""
        var ci = 0
        while ci < container_names.len():
            if container_names[ci] == container:
                ckind = container_kinds[ci]
            ci = ci + 1
        if kind == "type" or kind == "enum" or kind == "trait":
            container_names.push(name)
            container_kinds.push(kind)
        var body: [text] = []
        var ln = start + 1
        while ln <= end and ln <= lines.len():
            val t = lines[ln - 1].trim()
            if t != "":
                body.push(t)
            ln = ln + 1
        val header = if start <= lines.len(): lines[start - 1].trim() else: ""
        val qname = if container != "": "{container}.{name}" else: name
        out.push(DeclUnit(rel: rel, kind: kind, name: name, qname: qname, container: container, container_kind: ckind, header: header, body: body, line_start: start, line_end: end))
        i = i + 1
    out

fn scv_refactor_find_anchor(units: [DeclUnit], rel: text, kind: text, qname: text) -> i64:
    var i = 0
    while i < units.len():
        if units[i].rel == rel and units[i].kind == kind and units[i].qname == qname:
            return i
        i = i + 1
    -1

fn scv_refactor_has(items: [i64], value: i64) -> bool:
    for item in items:
        if item == value:
            return true
    false

# |a n b| / |a| in milli (multiset, 0 when a is empty).
fn scv_refactor_containment_milli(a: [text], b: [text]) -> i64:
    if a.len() == 0:
        return 0
    var used: [bool] = []
    for _ in b:
        used.push(false)
    var shared = 0
    for la in a:
        var j = 0
        while j < b.len():
            if not used[j] and b[j] == la:
                used[j] = true
                shared = shared + 1
                break
            j = j + 1
    (shared * 1000) / a.len()

# Lines in a that are not in b (multiset difference).
fn scv_refactor_line_minus(a: [text], b: [text]) -> [text]:
    var used: [bool] = []
    for _ in b:
        used.push(false)
    var out: [text] = []
    for la in a:
        var found = false
        var j = 0
        while j < b.len():
            if not used[j] and b[j] == la:
                used[j] = true
                found = true
                break
            j = j + 1
        if not found:
            out.push(la)
    out

fn scv_refactor_join_refs(units: [DeclUnit], idxs: [i64]) -> text:
    var out = ""
    for idx in idxs:
        if out != "":
            out = out + ","
        out = out + scv_refactor_ref(units[idx])
    out

fn scv_refactor_pair_kind(o: DeclUnit, n: DeclUnit) -> text:
    if o.rel != n.rel:
        if o.name == n.name:
            return "move"
        return "move_rename"
    if o.container != n.container:
        if o.container_kind == "type" and n.container_kind == "trait":
            return "pull_up"
        if o.container_kind == "trait" and n.container_kind == "type":
            return "push_down"
        return "move"
    "rename"

fn scv_refactor_rows_of_kind(rows: [text], kind: text) -> [text]:
    var out: [text] = []
    for row in rows:
        if scv_refactor_field(row, 0) == kind:
            out.push(row)
    out

fn scv_refactor_infer(files: [RefactorFileInput]) -> [text]:
    var old_units: [DeclUnit] = []
    var new_units: [DeclUnit] = []
    for f in files:
        for u in scv_refactor_units(f.rel, f.old_text):
            old_units.push(u)
        for u in scv_refactor_units(f.rel, f.new_text):
            new_units.push(u)
    var rows: [text] = []
    # Stage 1: anchors.
    var anchored_old: [i64] = []
    var anchored_new: [i64] = []
    var oi = 0
    while oi < old_units.len():
        val o = old_units[oi]
        val ni = scv_refactor_find_anchor(new_units, o.rel, o.kind, o.qname)
        if ni >= 0:
            anchored_old.push(oi)
            anchored_new.push(ni)
            if o.kind == "fn" and o.header != new_units[ni].header:
                rows.push("signature_change|{scv_refactor_ref(o)}|{scv_refactor_ref(new_units[ni])}|1000|anchor:same_qname,header_differs|accepted")
        oi = oi + 1
    var deleted: [i64] = []
    var added: [i64] = []
    oi = 0
    while oi < old_units.len():
        if not scv_refactor_has(anchored_old, oi):
            deleted.push(oi)
        oi = oi + 1
    var ni = 0
    while ni < new_units.len():
        if not scv_refactor_has(anchored_new, ni):
            added.push(ni)
        ni = ni + 1
    # Stage 3a: RefactoringMiner-style split/merge BEFORE pairing, so a
    # unit split in two is not mistaken for a rename onto one half.
    var matched_old: [i64] = []
    var matched_new: [i64] = []
    var comparisons = 0
    # split: one deleted -> >=2 added each contained in it.
    for d in deleted:
        if scv_refactor_has(matched_old, d):
            continue
        val o = old_units[d]
        if o.body.len() == 0:
            continue
        var parts: [i64] = []
        var covered = 0
        # Each part must be contained in the lines NOT yet consumed by an
        # earlier part, so two copies of the same body are not a split.
        var pool = o.body
        for a in added:
            if scv_refactor_has(matched_new, a) or new_units[a].body.len() == 0:
                continue
            if comparisons >= SCV_REFACTOR_MAX_PAIRS:
                break
            comparisons = comparisons + 1
            if scv_refactor_containment_milli(new_units[a].body, pool) >= SCV_REFACTOR_CONTAIN_MIN_MILLI:
                parts.push(a)
                covered = covered + new_units[a].body.len()
                pool = scv_refactor_line_minus(pool, new_units[a].body)
        if parts.len() >= 2:
            val conf = if covered * 1000 / o.body.len() > 1000: 1000 else: covered * 1000 / o.body.len()
            rows.push("split|{scv_refactor_ref(o)}|{scv_refactor_join_refs(new_units, parts)}|{conf}|containment_parts={parts.len()}|suggested")
            matched_old.push(d)
            for p in parts:
                matched_new.push(p)
    # merge: >=2 deleted -> one added containing them.
    for a in added:
        if scv_refactor_has(matched_new, a):
            continue
        val n = new_units[a]
        if n.body.len() == 0:
            continue
        var sources: [i64] = []
        var covered = 0
        var pool = n.body
        for d in deleted:
            if scv_refactor_has(matched_old, d) or old_units[d].body.len() == 0:
                continue
            if comparisons >= SCV_REFACTOR_MAX_PAIRS:
                break
            comparisons = comparisons + 1
            if scv_refactor_containment_milli(old_units[d].body, pool) >= SCV_REFACTOR_CONTAIN_MIN_MILLI:
                sources.push(d)
                covered = covered + old_units[d].body.len()
                pool = scv_refactor_line_minus(pool, old_units[d].body)
        if sources.len() >= 2:
            val conf = if covered * 1000 / n.body.len() > 1000: 1000 else: covered * 1000 / n.body.len()
            rows.push("merge|{scv_refactor_join_refs(old_units, sources)}|{scv_refactor_ref(n)}|{conf}|containment_sources={sources.len()}|suggested")
            matched_new.push(a)
            for s in sources:
                matched_old.push(s)
    # Stage 2: bounded GumTree-style pairing by body Dice within kind.
    for d in deleted:
        val o = old_units[d]
        if o.body.len() == 0:
            continue
        var cand_idx: [i64] = []
        var cand_score: [i64] = []
        var examined = 0
        for a in added:
            if scv_refactor_has(matched_new, a):
                continue
            if new_units[a].kind != o.kind:
                continue
            if examined >= SCV_REFACTOR_CANDIDATES_PER_UNIT or comparisons >= SCV_REFACTOR_MAX_PAIRS:
                break
            examined = examined + 1
            comparisons = comparisons + 1
            cand_idx.push(a)
            cand_score.push(scv_dice_similarity(o.body, new_units[a].body))
        var best = -1
        var best_score = 0
        var ci = 0
        while ci < cand_idx.len():
            if cand_score[ci] > best_score:
                best_score = cand_score[ci]
                best = cand_idx[ci]
            ci = ci + 1
        if best < 0 or best_score < SCV_REFACTOR_MIN_DICE_MILLI:
            continue
        var cands: [i64] = [best]
        ci = 0
        while ci < cand_idx.len():
            if cand_idx[ci] != best and best_score - cand_score[ci] < SCV_REFACTOR_AMBIGUITY_MARGIN_MILLI:
                cands.push(cand_idx[ci])
            ci = ci + 1
        if cands.len() > 1:
            rows.push("{scv_refactor_pair_kind(o, new_units[best])}|{scv_refactor_ref(o)}|{scv_refactor_join_refs(new_units, cands)}|{best_score}|body_dice_tie|ambiguous")
            matched_old.push(d)
            continue
        val status = if best_score >= 900: "accepted" else: "suggested"
        rows.push("{scv_refactor_pair_kind(o, new_units[best])}|{scv_refactor_ref(o)}|{scv_refactor_ref(new_units[best])}|{best_score}|body_dice={best_score}|{status}")
        matched_old.push(d)
        matched_new.push(best)
    # Stage 3b: extract: lines removed from an anchored unit reappear in an added unit.
    var ai = 0
    while ai < anchored_old.len():
        val o = old_units[anchored_old[ai]]
        val n = new_units[anchored_new[ai]]
        val removed = scv_refactor_line_minus(o.body, n.body)
        val grown = scv_refactor_line_minus(n.body, o.body)
        if removed.len() > 0:
            for a in added:
                if scv_refactor_has(matched_new, a) or new_units[a].body.len() == 0:
                    continue
                if comparisons >= SCV_REFACTOR_MAX_PAIRS:
                    break
                comparisons = comparisons + 1
                val c = scv_refactor_containment_milli(new_units[a].body, removed)
                if c >= SCV_REFACTOR_CONTAIN_MIN_MILLI:
                    rows.push("extract|{scv_refactor_ref(o)}|{scv_refactor_ref(n)},{scv_refactor_ref(new_units[a])}|{c}|removed_lines_reappear|suggested")
                    matched_new.push(a)
        if grown.len() > 0:
            for d in deleted:
                if scv_refactor_has(matched_old, d) or old_units[d].body.len() == 0:
                    continue
                if comparisons >= SCV_REFACTOR_MAX_PAIRS:
                    break
                comparisons = comparisons + 1
                val c = scv_refactor_containment_milli(old_units[d].body, grown)
                if c >= SCV_REFACTOR_CONTAIN_MIN_MILLI:
                    rows.push("inline|{scv_refactor_ref(old_units[d])},{scv_refactor_ref(o)}|{scv_refactor_ref(n)}|{c}|deleted_lines_reappear|suggested")
                    matched_old.push(d)
        ai = ai + 1
    rows

export SCV_REFACTOR_MAX_PAIRS, SCV_REFACTOR_CANDIDATES_PER_UNIT, SCV_REFACTOR_MIN_DICE_MILLI, SCV_REFACTOR_CONTAIN_MIN_MILLI, SCV_REFACTOR_AMBIGUITY_MARGIN_MILLI
export RefactorFileInput, DeclUnit
export scv_refactor_units, scv_refactor_infer, scv_refactor_rows_of_kind, scv_refactor_ref, scv_refactor_containment_milli
