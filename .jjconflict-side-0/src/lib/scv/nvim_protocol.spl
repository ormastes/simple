# SCV Neovim editor protocol — SCV-IMPL-P-07.
#
# `scv/editor/v1`: open_buffer / apply_edit / parser_changed_ranges / save /
# rename / refactor_transaction, defined as a PURE request→response layer
# over an ABSTRACT transport: `scv_nvim_handle` maps (root, state, request)
# to (new state, response), and `scv_nvim_serve` folds a request list —
# an in-process transport that any byte transport can feed line-for-line.
# TODO(SCV-IMPL-E-09): wire this handler over lane A's editor IPC (UDS)
# module once it lands; this file deliberately does not import it so the
# protocol layer has no dependency on the concurrently-developed transport.
#
# AUTHORITY RULE (plan row P-07): Neovim-provided trees/ranges are HINTS.
# Every apply_edit reparses from the buffer BYTES via the parser session and
# recomputes changed ranges from the stored artifact; a hint is compared to
# that recomputation and reported verified/rejected — it is NEVER used as
# the source of truth. Responses carry `authority: bytes+artifact` to state
# this.
#
# Wire format (text, line-oriented):
#   request  = "op: <name>\n" + "<key>: <value>\n"* [+ "new_text:\n<raw>"]
#   response = "status: ok|error\nop: <name>\n" + fields…
# `new_text` is everything after the first "\nnew_text:\n" marker so edit
# payloads may contain newlines.

use std.scv.parser_session.{scv_parser_session_open, scv_parser_session_apply_edit,
    scv_parser_session_changed_ranges, scv_parser_session_checkpoint,
    scv_session_source, scv_session_tree_root, scv_session_edit_count,
    scv_session_last_edit}
use std.scv.store.{scv_write_text}

fn scv_nvim_protocol_version() -> text:
    "scv/editor/v1"

fn scv_nvim_authority() -> text:
    "bytes+artifact"

# --- request encode / decode -------------------------------------------------

# Build a request. fields are "key: value" lines (no newlines inside values);
# new_text (may contain newlines) rides after the "new_text:" marker.
fn scv_nvim_request(op: text, fields: [text], new_text: text) -> text:
    var out = "op: {op}\n"
    for f in fields:
        out = out + f + "\n"
    if new_text != "":
        out = out + "new_text:\n" + new_text
    out

fn _scv_nvim_head(request: text) -> text:
    val parts = request.split("\nnew_text:\n")
    parts[0]

fn scv_nvim_req_new_text(request: text) -> text:
    val parts = request.split("\nnew_text:\n")
    if parts.len() < 2:
        return ""
    parts[1]

fn scv_nvim_req_field(request: text, key: text) -> text:
    val marker = "{key}: "
    for line in _scv_nvim_head(request).split("\n"):
        if line.starts_with(marker):
            return line[marker.len():]
    ""

fn scv_nvim_resp_field(response: text, key: text) -> text:
    scv_nvim_req_field(response, key)

fn _scv_nvim_error(op: text, reason: text) -> text:
    "status: error\nop: {op}\nreason: {reason}\nauthority: {scv_nvim_authority()}\n"

# --- hint verification -------------------------------------------------------

# Deterministic text sort (selection sort; no reliance on sort/insert builtins).
fn _scv_nvim_sort(items: [text]) -> [text]:
    var rest = items
    var out: [text] = []
    while rest.len() > 0:
        var mi = 0
        var i = 1
        while i < rest.len():
            if rest[i] < rest[mi]:
                mi = i
            i = i + 1
        out.push(rest[mi])
        var nr: [text] = []
        var k = 0
        while k < rest.len():
            if k != mi:
                nr.push(rest[k])
            k = k + 1
        rest = nr
    out

# Normalize a comma-separated "a..b,c..d" hint list into sorted unique lines.
fn _scv_nvim_norm_ranges(spec: text) -> [text]:
    var raw: [text] = []
    for part in spec.split(","):
        val p = part.trim()
        if p != "":
            raw.push(p)
    val out = _scv_nvim_sort(raw)
    var uniq: [text] = []
    for r in out:
        if uniq.len() == 0 or uniq[uniq.len() - 1] != r:
            uniq.push(r)
    uniq

# Compare a Neovim-supplied changed-ranges hint against the ranges recomputed
# from bytes+artifact. The recomputed set is authoritative either way.
fn scv_nvim_hint_status(hint: text, computed: text) -> text:
    if hint == "":
        return "none"
    val h = _scv_nvim_norm_ranges(hint)
    val c = _scv_nvim_norm_ranges(computed.trim().replace("\n", ","))
    if h.len() != c.len():
        return "rejected (recomputed from bytes)"
    var i = 0
    while i < h.len():
        if h[i] != c[i]:
            return "rejected (recomputed from bytes)"
        i = i + 1
    "verified"

# --- op handlers -------------------------------------------------------------

fn _scv_nvim_open(root: text, state: Dict<text, text>, request: text) -> (Dict<text, text>, text):
    val path = scv_nvim_req_field(request, "path")
    if path == "":
        return (state, _scv_nvim_error("open_buffer", "missing path"))
    val language = scv_nvim_req_field(request, "language")
    val grammar = scv_nvim_req_field(request, "grammar")
    val version = scv_nvim_req_field(request, "version")
    val parser_hash = scv_nvim_req_field(request, "parser_hash")
    val source = scv_nvim_req_new_text(request)
    var next = state
    next[path] = scv_parser_session_open(root, language, grammar, version,
                                         parser_hash, source)
    val tree = scv_session_tree_root(next[path])
    (next, "status: ok\nop: open_buffer\npath: {path}\ntree_root: {tree}\nauthority: {scv_nvim_authority()}\n")

fn _scv_nvim_apply_edit(root: text, state: Dict<text, text>, request: text) -> (Dict<text, text>, text):
    val path = scv_nvim_req_field(request, "path")
    if not state.contains_key(path):
        return (state, _scv_nvim_error("apply_edit", "buffer not open: {path}"))
    val start_byte = scv_nvim_req_field(request, "start_byte").to_i64() ?? -1
    val old_end = scv_nvim_req_field(request, "old_end_byte").to_i64() ?? -1
    val new_text = scv_nvim_req_new_text(request)
    val old_source = scv_session_source(state[path])
    if start_byte < 0 or old_end < start_byte or old_end > old_source.len():
        return (state, _scv_nvim_error("apply_edit", "edit out of bounds"))
    var next = state
    next[path] = scv_parser_session_apply_edit(root, next[path], start_byte,
                                               old_end, new_text)
    val ranges = scv_parser_session_changed_ranges(root, next[path])
    val hint = scv_nvim_req_field(request, "hint_ranges")
    val hint_status = scv_nvim_hint_status(hint, ranges)
    val edit = scv_session_last_edit(next[path])
    val edits = scv_session_edit_count(next[path])
    val tree = scv_session_tree_root(next[path])
    val flat = ranges.trim().replace("\n", ",")
    (next, "status: ok\nop: apply_edit\npath: {path}\ntree_root: {tree}\nedits: {edits}\ninput_edit: {edit}\nchanged_ranges: {flat}\nhint_status: {hint_status}\nauthority: {scv_nvim_authority()}\n")

fn _scv_nvim_changed_ranges(root: text, state: Dict<text, text>, request: text) -> (Dict<text, text>, text):
    val path = scv_nvim_req_field(request, "path")
    if not state.contains_key(path):
        return (state, _scv_nvim_error("parser_changed_ranges", "buffer not open: {path}"))
    val ranges = scv_parser_session_changed_ranges(root, state[path])
    val hint = scv_nvim_req_field(request, "hint_ranges")
    val hint_status = scv_nvim_hint_status(hint, ranges)
    val flat = ranges.trim().replace("\n", ",")
    (state, "status: ok\nop: parser_changed_ranges\npath: {path}\nchanged_ranges: {flat}\nhint_status: {hint_status}\nauthority: {scv_nvim_authority()}\n")

fn _scv_nvim_save(root: text, state: Dict<text, text>, request: text) -> (Dict<text, text>, text):
    val path = scv_nvim_req_field(request, "path")
    if not state.contains_key(path):
        return (state, _scv_nvim_error("save", "buffer not open: {path}"))
    var target = scv_nvim_req_field(request, "target")
    if target == "":
        target = path
    val source = scv_session_source(state[path])
    scv_write_text(target, source)
    val ck = scv_parser_session_checkpoint(root, state[path])
    (state, "status: ok\nop: save\npath: {path}\ntarget: {target}\nsaved_bytes: {source.len()}\ncheckpoint: {ck}\nauthority: {scv_nvim_authority()}\n")

fn _scv_nvim_rename(root: text, state: Dict<text, text>, request: text) -> (Dict<text, text>, text):
    val path = scv_nvim_req_field(request, "path")
    val to = scv_nvim_req_field(request, "to")
    if not state.contains_key(path):
        return (state, _scv_nvim_error("rename", "buffer not open: {path}"))
    if to == "":
        return (state, _scv_nvim_error("rename", "missing to"))
    if state.contains_key(to):
        return (state, _scv_nvim_error("rename", "target already open: {to}"))
    # rebuild without the old key (no reliance on a Dict.remove builtin)
    var next: Dict<text, text> = {}
    val keys = state.keys()
    for k in keys:
        if k != path:
            next[k] = state[k]
    next[to] = state[path]
    (next, "status: ok\nop: rename\nfrom: {path}\nto: {to}\nauthority: {scv_nvim_authority()}\n")

# refactor_transaction: "edit: path|start_byte|old_end_byte|replacement"
# lines ("\\n" in replacement decodes to a newline). ALL edits are validated
# against current buffer bytes first; one invalid edit rejects the whole
# transaction and no buffer changes (all-or-nothing).
fn _scv_nvim_refactor(root: text, state: Dict<text, text>, request: text) -> (Dict<text, text>, text):
    var edits: [text] = []
    for line in _scv_nvim_head(request).split("\n"):
        if line.starts_with("edit: "):
            edits.push(line[6:])
    if edits.len() == 0:
        return (state, _scv_nvim_error("refactor_transaction", "no edits"))
    # validate all against a simulated copy first
    var sim: Dict<text, text> = {}
    for e in edits:
        val p = e.split("|")
        if p.len() < 4:
            return (state, _scv_nvim_error("refactor_transaction", "malformed edit: {e}"))
        val path = p[0]
        if not state.contains_key(path):
            return (state, _scv_nvim_error("refactor_transaction", "buffer not open: {path}"))
        val start = p[1].to_i64() ?? -1
        val old_end = p[2].to_i64() ?? -1
        val repl = p[3].replace("\\n", "\n")
        if not sim.contains_key(path):
            sim[path] = scv_session_source(state[path])
        val src = sim[path]
        if start < 0 or old_end < start or old_end > src.len():
            return (state, _scv_nvim_error("refactor_transaction", "edit out of bounds: {e}"))
        sim[path] = src.slice(0, start) + repl + src.slice(old_end, src.len())
    # apply for real
    var next = state
    var applied = 0
    for e in edits:
        val p = e.split("|")
        val path = p[0]
        val start = p[1].to_i64() ?? -1
        val old_end = p[2].to_i64() ?? -1
        val repl = p[3].replace("\\n", "\n")
        next[path] = scv_parser_session_apply_edit(root, next[path], start,
                                                   old_end, repl)
        applied = applied + 1
    (next, "status: ok\nop: refactor_transaction\napplied: {applied}\nauthority: {scv_nvim_authority()}\n")

# --- dispatcher / in-process transport ---------------------------------------

fn scv_nvim_handle(root: text, state: Dict<text, text>, request: text) -> (Dict<text, text>, text):
    val op = scv_nvim_req_field(request, "op")
    if op == "open_buffer":
        return _scv_nvim_open(root, state, request)
    if op == "apply_edit":
        return _scv_nvim_apply_edit(root, state, request)
    if op == "parser_changed_ranges":
        return _scv_nvim_changed_ranges(root, state, request)
    if op == "save":
        return _scv_nvim_save(root, state, request)
    if op == "rename":
        return _scv_nvim_rename(root, state, request)
    if op == "refactor_transaction":
        return _scv_nvim_refactor(root, state, request)
    (state, _scv_nvim_error(op, "unknown op"))

# In-process transport: fold a request list through the handler, returning
# one response per request. A real transport (E-09 UDS) feeds the same
# handler request-for-request.
fn scv_nvim_serve(root: text, requests: [text]) -> [text]:
    var state: Dict<text, text> = {}
    var responses: [text] = []
    for req in requests:
        val (next, resp) = scv_nvim_handle(root, state, req)
        state = next
        responses.push(resp)
    responses

export scv_nvim_protocol_version, scv_nvim_authority
export scv_nvim_request, scv_nvim_req_field, scv_nvim_req_new_text, scv_nvim_resp_field
export scv_nvim_hint_status, scv_nvim_handle, scv_nvim_serve
