# std.pure.tensor_ops — re-export facade over the real pure-Simple tensor ops.
#
# WHY THIS FILE CHANGED (2026-07-25):
# This module used to be a 16-line stub exporting only `tensor_sum` and
# `tensor_mul_scalar`, and — because `src/std` is a symlink to `lib` — it
# SHADOWED the real 340-line implementation in
# `std.gc_async_mut.pure.tensor_ops`. Every importer of `std.pure.tensor_ops`
# (including `std.gc_async_mut.pure.{training, nn}`) bound to the stub, so
# add/sub/mul/div/matmul/transpose/sum/mean/max/min/relu/sigmoid/tanh/softmax
# were simply unavailable.
#
# That shadowing is the root cause behind the
# "pre-existing test failures - functions/imports not available" note that had
# `pure/test/tensor_ops_spec.spl` parked with its entire body commented out.
#
# The stub's two exports are a strict subset of the real module's, so this
# forwarding is source-compatible with every existing consumer.

export use std.gc_async_mut.pure.tensor_ops.{add, sub, mul, div, neg, abs_val}
export use std.gc_async_mut.pure.tensor_ops.{mul_scalar, add_scalar, div_scalar, pow_scalar}
export use std.gc_async_mut.pure.tensor_ops.{matmul, transpose}
export use std.gc_async_mut.pure.tensor_ops.{sum, mean, max, min}
export use std.gc_async_mut.pure.tensor_ops.{relu, sigmoid, tanh, softmax}
export use std.gc_async_mut.pure.tensor_ops.{tensor_exp, tensor_log, tensor_sqrt, clamp}
export use std.gc_async_mut.pure.tensor_ops.{tensor_sum_to_scalar, tensor_mean_to_scalar}
export use std.gc_async_mut.pure.tensor_ops.{tensor_sum, tensor_mul_scalar}
export use std.gc_async_mut.pure.tensor_ops.{tensor_add_scalar, tensor_div_scalar, tensor_div}
export use std.gc_async_mut.pure.tensor_ops.{tensor_add, tensor_sub, tensor_mul}
