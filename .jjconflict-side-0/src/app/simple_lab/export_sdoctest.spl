# export_sdoctest — notebook -> SDoctest exporter (shared with the doc-embedded
# sdoctest format; see doc/05_design/app/tools/notebook_lanes_architecture.md
# §7.3 and src/lib/nogc_sync_mut/test_runner/sdoctest/).
#
# Converts a notebook (NbNotebook, from either .ipynb or .snb.sdn) into a
# markdown file whose code cells are ```sdoctest fences and whose markdown
# cells pass through unchanged. The result is runnable by
# `simple test --sdoctest <file>.md` — it turns a notebook into a verified
# doc and gives CI a way to regression-test notebooks without a browser.
#
# Fence format follows the sdoctest doctest convention (each source line
# becomes a `>>> `/`... `-prefixed line; see
# src/lib/nogc_sync_mut/test_runner/sdoctest/extractor.spl:
# `strip_doctest_prompts` strips exactly this prefix back off before running
# the cell, so any line NOT prefixed with `>>> `/`... ` is documentation-only
# and never affects execution — the previously captured cell output is
# emitted this way, giving the exported doc the conventional "expected
# output beneath the prompt" shape even though (as of this writing) the
# runner's pass/fail verdict for a ```sdoctest fence is exit-code based, not
# a text diff against those lines (see src/lib/nogc_sync_mut/test_runner/sdoctest/runner.spl
# fn run_sdoctest_block).

use std.nogc_sync_mut.notebook.ipynb.{NbNotebook, NbCell, NbOutput, ipynb_parse}
use std.nogc_sync_mut.notebook.snb_sdn.{snb_parse}
use std.io.{file_read, file_write, file_exists}

# ============================================================================
# Notebook -> markdown/sdoctest text
# ============================================================================

pub fn nb_to_sdoctest_markdown(nb: NbNotebook) -> text:
    var parts: [text] = []
    for cell in nb.cells:
        if cell.cell_type == "markdown":
            parts.push(cell.source)
        else:
            parts.push(_code_cell_to_sdoctest_block(cell))
    parts.join("\n\n")

fn _code_cell_to_sdoctest_block(cell: NbCell) -> text:
    var lines: [text] = []
    if _cell_has_error_output(cell):
        # The captured run errored — reproduce it as `should_fail` so the
        # exported doc still gives a real pass/fail verdict (a plain
        # ```sdoctest fence requires exit 0; see runner.spl fn
        # run_sdoctest_block) instead of exporting a block that can never
        # pass.
        lines.push("```sdoctest:should_fail")
    else:
        lines.push("```sdoctest")
    lines.push(_prompt_lines(cell.source))
    val output_text = _outputs_to_text(cell.outputs)
    if output_text != "":
        lines.push(output_text)
    lines.push("```")
    lines.join("\n")

fn _cell_has_error_output(cell: NbCell) -> bool:
    for out in cell.outputs:
        if out.output_type == "error":
            return true
    false

# Prefix every source line with the doctest prompt: `>>> ` on the first
# line, `... ` on every continuation line. Functionally the extractor
# treats both prefixes identically (see module docstring), so this choice
# is purely for readability of the exported doc.
fn _prompt_lines(source: text) -> text:
    if source == "":
        return ">>> "
    val lines = source.split("\n")
    var out: [text] = []
    var i = 0
    while i < lines.len():
        if i == 0:
            out.push(">>> " + lines[i])
        else:
            out.push("... " + lines[i])
        i = i + 1
    out.join("\n")

# Render captured outputs as plain (unprefixed) documentation lines beneath
# the prompt — the conventional doctest "expected output" shape.
fn _outputs_to_text(outputs: [NbOutput]) -> text:
    var parts: [text] = []
    for out in outputs:
        if out.output_type == "stream":
            if out.text != "":
                parts.push(out.text)
        elif out.output_type == "display_data":
            if out.text != "":
                parts.push(out.text)
        elif out.output_type == "error":
            parts.push("{out.ename}: {out.evalue}")
    parts.join("\n")

# ============================================================================
# File-level entry points
# ============================================================================

# Load a notebook from `.ipynb` or `.snb.sdn` (dispatched on the file
# extension) and export it to an sdoctest markdown file at `out_md_path`.
pub fn export_notebook_file(in_path: text, out_md_path: text) -> Result<bool, text>:
    if not file_exists(in_path):
        return Err("export_sdoctest: input file not found: {in_path}")
    val src = file_read(in_path)

    var nb_result: Result<NbNotebook, text> = Err("export_sdoctest: unsupported input extension for '{in_path}' (expected .ipynb or .snb.sdn)")
    if in_path.ends_with(".ipynb"):
        nb_result = ipynb_parse(src)
    elif in_path.ends_with(".snb.sdn"):
        nb_result = snb_parse(src)

    var nb_ok = false
    var nb: NbNotebook = NbNotebook(nbformat_minor: 0, metadata_json: "{}", cells: [])
    match nb_result:
        case Ok(parsed):
            nb = parsed
            nb_ok = true
        case Err(msg):
            return Err(msg)

    if not nb_ok:
        return Err("export_sdoctest: failed to parse '{in_path}'")

    val markdown = nb_to_sdoctest_markdown(nb)
    if not file_write(out_md_path, markdown):
        return Err("export_sdoctest: failed to write '{out_md_path}'")
    Ok(true)
