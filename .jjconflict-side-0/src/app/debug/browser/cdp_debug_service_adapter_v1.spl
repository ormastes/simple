# DebugServiceV1 adapter over the existing std.play CDP client.
# Owns no browser process, websocket, or alternate target discovery transport.

use std.play.cdp.client.{CdpClient}
use std.play.cdp.domains.{
    cdp_target_set_discover, cdp_target_set_auto_attach, cdp_target_get_targets,
}
use std.common.debug.capability.{CapLevel}
use std.common.debug.contracts_v1.{
    DebugSessionId, DebugPolicyV1, DebugCapabilityV1, DebugVerificationV1,
    DebugPerturbationV1, DebugRootOperationV1, DebugTargetNodeV1,
    BoundaryFrameV1,
}
use std.common.debug.service_v1.{
    central_debug_service_v1_open, central_debug_service_v1_add_target,
    central_debug_service_v1_authorize, central_debug_service_v1_record,
    central_debug_service_v1_close,
}

pub struct BrowserCdpTargetV1:
    target_id: text
    kind: text

pub struct BrowserCdpDebugSliceV1:
    session_id: DebugSessionId
    targets: [BrowserCdpTargetV1]
    worker_auto_attach_verified: bool
    boundary_frames: [BoundaryFrameV1]
    source_mapping_reason: text

pub fn browser_cdp_targets_v1(body: text) -> [BrowserCdpTargetV1]:
    var out: [BrowserCdpTargetV1] = []
    val segments = body.split("\"targetId\":\"")
    var i = 1
    while i < segments.len():
        val segment = segments[i]
        val target_id = segment.split("\"")[0]
        var kind = "unknown"
        if segment.contains("\"type\":\""):
            kind = segment.split("\"type\":\"")[1].split("\"")[0]
        if target_id != "":
            out.push(BrowserCdpTargetV1(target_id: target_id, kind: kind))
        i = i + 1
    out

pub fn browser_cdp_worker_event_v1(method: text, params_json: text) -> bool:
    if method != "Target.attachedToTarget": return false
    params_json.contains("\"type\":\"worker\"") or
        params_json.contains("\"type\":\"service_worker\"") or
        params_json.contains("\"type\":\"shared_worker\"")

fn _capability(target_id: text, support: CapLevel, verification: DebugVerificationV1, perturbation: DebugPerturbationV1, reason: text) -> DebugCapabilityV1:
    DebugCapabilityV1(target_id, support, verification, perturbation, reason)

fn _add_feature_node(session_id: DebugSessionId, target_id: text, kind: text, support: CapLevel, verification: DebugVerificationV1, perturbation: DebugPerturbationV1, reason: text) -> Result<Nil, text>:
    central_debug_service_v1_add_target(session_id,
        DebugTargetNodeV1(target_id, "browser://root", kind, kind),
        _capability(target_id, support, verification, perturbation, reason))

pub fn browser_cdp_discover_v1(client: CdpClient, build_id: text, policy: DebugPolicyV1, worker_timeout_ms: i64) -> Result<BrowserCdpDebugSliceV1, text>:
    val session_id = central_debug_service_v1_open(build_id, policy)?
    val authorization = central_debug_service_v1_authorize(session_id,
        DebugRootOperationV1.Observe, DebugPerturbationV1.Passive,
        "browser.cdp.target-discovery")
    if not authorization.allowed:
        central_debug_service_v1_close(session_id)
        return Err(authorization.reason)

    match cdp_target_set_discover(client, true):
        case Err(error):
            central_debug_service_v1_record(session_id, DebugRootOperationV1.Observe,
                DebugPerturbationV1.Passive, "browser.cdp.target-discovery.outcome", false, false, error.message)
            central_debug_service_v1_close(session_id)
            return Err("CDP target discovery unavailable: " + error.message)
        case Ok(_): ()
    val body = match cdp_target_get_targets(client):
        case Err(error):
            central_debug_service_v1_record(session_id, DebugRootOperationV1.Observe,
                DebugPerturbationV1.Passive, "browser.cdp.target-discovery.outcome", false, false, error.message)
            central_debug_service_v1_close(session_id)
            return Err("CDP Target.getTargets failed: " + error.message)
        case Ok(value): value
    val targets = browser_cdp_targets_v1(body)
    central_debug_service_v1_add_target(session_id,
        DebugTargetNodeV1("browser://root", "", "browser.cdp", "CDP browser"),
        _capability("browser://root", CapLevel.Native, DebugVerificationV1.LiveVerified,
            DebugPerturbationV1.Passive, "Target.getTargets completed on the existing CDP connection"))?
    for target in targets:
        val id = "browser://target/" + target.target_id
        central_debug_service_v1_add_target(session_id,
            DebugTargetNodeV1(id, "browser://root", "browser." + target.kind, target.kind),
            _capability(id, CapLevel.Native, DebugVerificationV1.LiveVerified,
                DebugPerturbationV1.Passive, "returned by live Target.getTargets"))?
    central_debug_service_v1_record(session_id, DebugRootOperationV1.Observe,
        DebugPerturbationV1.Passive, "browser.cdp.target-discovery.outcome", true, false,
        "targets=" + str(targets.len()) + "; urls redacted")

    var worker_verified = false
    match cdp_target_set_auto_attach(client, true, false):
        case Err(_): worker_verified = false
        case Ok(_):
            match client.wait_for_event("Target.attachedToTarget", worker_timeout_ms):
                case Err(_): worker_verified = false
                case Ok(event): worker_verified = browser_cdp_worker_event_v1(event.method, event.params_json)
    if worker_verified:
        _add_feature_node(session_id, "browser://feature/worker-auto-attach", "browser.worker-auto-attach",
            CapLevel.Native, DebugVerificationV1.LiveVerified, DebugPerturbationV1.Cooperative,
            "observed Target.attachedToTarget for a real worker")?
    else:
        _add_feature_node(session_id, "browser://feature/worker-auto-attach", "browser.worker-auto-attach",
            CapLevel.Unavailable, DebugVerificationV1.Blocked, DebugPerturbationV1.Cooperative,
            "Target.setAutoAttach alone is insufficient; no worker attach event observed")?

    _add_feature_node(session_id, "browser://feature/source-mapping", "browser.source-mapping",
        CapLevel.Unavailable, DebugVerificationV1.Blocked, DebugPerturbationV1.Passive,
        "existing CDP adapter has no Debugger.scriptParsed/source-map consumer")?
    _add_feature_node(session_id, "browser://feature/boundary-frames", "browser.boundary-frames",
        CapLevel.Unavailable, DebugVerificationV1.Blocked, DebugPerturbationV1.Passive,
        "no verified JS/Wasm/Simple logical-stack assembler is wired")?

    Ok(BrowserCdpDebugSliceV1(session_id, targets, worker_verified, [],
        "blocked: Debugger.scriptParsed/source-map and Wasm DWARF integration are not wired"))

pub fn browser_cdp_blocked_v1(build_id: text, policy: DebugPolicyV1, reason: text) -> Result<BrowserCdpDebugSliceV1, text>:
    if reason.trim() == "": return Err("blocked browser capability requires a reason")
    val session_id = central_debug_service_v1_open(build_id, policy)?
    central_debug_service_v1_add_target(session_id,
        DebugTargetNodeV1("browser://root", "", "browser.cdp", "CDP browser"),
        _capability("browser://root", CapLevel.Unavailable, DebugVerificationV1.Blocked,
            DebugPerturbationV1.Passive, reason))?
    _add_feature_node(session_id, "browser://feature/worker-auto-attach", "browser.worker-auto-attach",
        CapLevel.Unavailable, DebugVerificationV1.Blocked, DebugPerturbationV1.Cooperative, reason)?
    _add_feature_node(session_id, "browser://feature/source-mapping", "browser.source-mapping",
        CapLevel.Unavailable, DebugVerificationV1.Blocked, DebugPerturbationV1.Passive,
        "existing CDP adapter has no Debugger.scriptParsed/source-map consumer")?
    _add_feature_node(session_id, "browser://feature/boundary-frames", "browser.boundary-frames",
        CapLevel.Unavailable, DebugVerificationV1.Blocked, DebugPerturbationV1.Passive,
        "no verified JS/Wasm/Simple logical-stack assembler is wired")?
    central_debug_service_v1_record(session_id, DebugRootOperationV1.Observe,
        DebugPerturbationV1.Passive, "browser.cdp.target-discovery.outcome", false, false,
        "blocked; endpoint and page URLs redacted")
    Ok(BrowserCdpDebugSliceV1(session_id, [], false, [],
        "blocked: Debugger.scriptParsed/source-map and Wasm DWARF integration are not wired"))
