# DebugServiceV1 adapter for the existing semantic InterpreterBackend.
#
# This module owns no interpreter hooks. It binds the landed
# app.debug.interpreter_backend mechanism to the shared session, graph, policy,
# and receipt contracts.

use app.io.mod.{file_exists, file_hash_sha256, current_time_ms}
use app.debug.interpreter_backend.{InterpreterBackend}
use app.debug.coordinator.{FrameInfo, VarInfo}
use std.common.debug.capability.{CapLevel}
use std.common.debug.contracts_v1.{
    DebugSessionId, DebugCapabilityV1, DebugVerificationV1,
    DebugPerturbationV1, DebugRootOperationV1, DebugTargetNodeV1,
    debug_policy_development_v1,
}
use std.common.debug.service_v1.{
    central_debug_service_v1_open, central_debug_service_v1_add_target,
    central_debug_service_v1_authorize_at, central_debug_service_v1_record_at,
    central_debug_service_v1_close, central_debug_service_v1_update_target_capability_at,
}

pub struct InterpreterBreakpointV1:
    backend_breakpoint_id: i64
    source_anchor: text
    symbol_id: text

pub struct InterpreterConcurrencySnapshotV1:
    tasks_available: bool
    actors_available: bool
    queues_available: bool
    verification: DebugVerificationV1
    reason: text

pub class InterpreterDebugServiceAdapterV1:
    session_id: DebugSessionId
    target_id: text
    build_id: text
    backend: InterpreterBackend
    attached: bool

    static fn create() -> InterpreterDebugServiceAdapterV1:
        InterpreterDebugServiceAdapterV1(
            session_id: DebugSessionId(value: ""),
            target_id: "",
            build_id: "",
            backend: InterpreterBackend.create(),
            attached: false,
        )

    me launch(program_path: text, args: [text]) -> Result<DebugSessionId, text>:
        if not file_exists(program_path):
            return Err("interpreter debug target is not a readable file")
        val digest = file_hash_sha256(program_path)
        if digest.trim() == "":
            return Err("interpreter debug target requires an exact build digest")
        val session_id = central_debug_service_v1_open("sha256:" + digest, debug_policy_development_v1())?
        val target_id = "simple-interpreter://" + digest
        val now_ns = current_time_ms() * 1000000
        val authorization = central_debug_service_v1_authorize_at(
            session_id, DebugRootOperationV1.Control,
            DebugPerturbationV1.Cooperative, "interpreter.attach", now_ns,
        )
        if not authorization.allowed:
            central_debug_service_v1_close(session_id)
            return Err(authorization.reason)
        match self.backend.attach(program_path, args):
            case Err(reason):
                central_debug_service_v1_record_at(session_id, DebugRootOperationV1.Control, DebugPerturbationV1.Cooperative, "interpreter.attach.outcome", false, false, reason, now_ns)
                central_debug_service_v1_close(session_id)
                return Err(reason)
            case Ok(_): ()
        match central_debug_service_v1_add_target(
            session_id,
            DebugTargetNodeV1(target_id, "", "runtime.simple.interpreter", program_path),
            DebugCapabilityV1(target_id, CapLevel.Native, DebugVerificationV1.FixtureVerified, DebugPerturbationV1.Cooperative, "existing semantic interpreter backend attached; target execution not yet verified"),
        ):
            case Err(reason):
                self.backend.detach()
                central_debug_service_v1_close(session_id)
                return Err(reason)
            case Ok(_): ()
        central_debug_service_v1_record_at(session_id, DebugRootOperationV1.Control, DebugPerturbationV1.Cooperative, "interpreter.attach.outcome", true, false, "", now_ns)
        self.session_id = session_id
        self.target_id = target_id
        self.build_id = "sha256:" + digest
        self.attached = true
        Ok(session_id)

    me set_semantic_breakpoint(file: text, line: i64, symbol_id: text) -> Result<InterpreterBreakpointV1, text>:
        if not self.attached:
            return Err("interpreter adapter is not attached")
        if file.trim() == "" or line <= 0 or symbol_id.trim() == "":
            return Err("semantic breakpoint requires SourceAnchor and SymbolId")
        val now_ns = current_time_ms() * 1000000
        val receipt = central_debug_service_v1_authorize_at(self.session_id, DebugRootOperationV1.Probe, DebugPerturbationV1.Cooperative, "interpreter.breakpoint.set", now_ns)
        if not receipt.allowed:
            return Err(receipt.reason)
        match self.backend.add_breakpoint(file, line):
            case Err(reason):
                central_debug_service_v1_record_at(self.session_id, DebugRootOperationV1.Probe, DebugPerturbationV1.Cooperative, "interpreter.breakpoint.set.outcome", false, false, reason, now_ns)
                Err(reason)
            case Ok(id):
                central_debug_service_v1_record_at(self.session_id, DebugRootOperationV1.Probe, DebugPerturbationV1.Cooperative, "interpreter.breakpoint.set.outcome", true, false, "", now_ns)
                Ok(InterpreterBreakpointV1(id, file + ":" + str(line), symbol_id))

    fn run() -> Result<Nil, text>:
        if not self.attached:
            return Err("interpreter adapter is not attached")
        val now_ns = current_time_ms() * 1000000
        val receipt = central_debug_service_v1_authorize_at(self.session_id, DebugRootOperationV1.Control, DebugPerturbationV1.Stopping, "interpreter.run", now_ns)
        if not receipt.allowed:
            return Err(receipt.reason)
        val result = self.backend.run()
        match result:
            case Ok(_):
                central_debug_service_v1_update_target_capability_at(
                    self.session_id,
                    DebugCapabilityV1(self.target_id, CapLevel.Native, DebugVerificationV1.LiveVerified, DebugPerturbationV1.Cooperative, "interpreter target executed through existing backend"),
                    now_ns,
                )?
                central_debug_service_v1_record_at(self.session_id, DebugRootOperationV1.Control, DebugPerturbationV1.Stopping, "interpreter.run.outcome", true, true, "", now_ns)
            case Err(reason): central_debug_service_v1_record_at(self.session_id, DebugRootOperationV1.Control, DebugPerturbationV1.Stopping, "interpreter.run.outcome", false, false, reason, now_ns)
        result

    fn stack() -> Result<[FrameInfo], text>:
        if not self.attached:
            return Err("interpreter adapter is not attached")
        val now_ns = current_time_ms() * 1000000
        val receipt = central_debug_service_v1_authorize_at(self.session_id, DebugRootOperationV1.Inspect, DebugPerturbationV1.Passive, "interpreter.stack", now_ns)
        if not receipt.allowed:
            return Err(receipt.reason)
        val result = self.backend.stack_trace()
        match result:
            case Ok(_): central_debug_service_v1_record_at(self.session_id, DebugRootOperationV1.Inspect, DebugPerturbationV1.Passive, "interpreter.stack.outcome", true, false, "", now_ns)
            case Err(reason): central_debug_service_v1_record_at(self.session_id, DebugRootOperationV1.Inspect, DebugPerturbationV1.Passive, "interpreter.stack.outcome", false, false, reason, now_ns)
        result

    fn locals() -> Result<[VarInfo], text>:
        if not self.attached:
            return Err("interpreter adapter is not attached")
        val now_ns = current_time_ms() * 1000000
        val receipt = central_debug_service_v1_authorize_at(self.session_id, DebugRootOperationV1.Inspect, DebugPerturbationV1.Passive, "interpreter.locals", now_ns)
        if not receipt.allowed:
            return Err(receipt.reason)
        val result = self.backend.locals()
        match result:
            case Ok(_): central_debug_service_v1_record_at(self.session_id, DebugRootOperationV1.Inspect, DebugPerturbationV1.Passive, "interpreter.locals.outcome", true, false, "", now_ns)
            case Err(reason): central_debug_service_v1_record_at(self.session_id, DebugRootOperationV1.Inspect, DebugPerturbationV1.Passive, "interpreter.locals.outcome", false, false, reason, now_ns)
        result

    fn evaluate_pure(expression: text) -> Result<text, text>:
        if not self.attached:
            return Err("interpreter adapter is not attached")
        if not interpreter_expression_is_pure_lookup_v1(expression):
            val now_ns = current_time_ms() * 1000000
            central_debug_service_v1_record_at(self.session_id, DebugRootOperationV1.Inspect, DebugPerturbationV1.Passive, "interpreter.evaluate", false, false, "impure interpreter evaluation denied", now_ns)
            return Err("impure interpreter evaluation denied")
        self.backend.evaluate(expression)

    fn concurrency_snapshot() -> InterpreterConcurrencySnapshotV1:
        InterpreterConcurrencySnapshotV1(
            tasks_available: false,
            actors_available: false,
            queues_available: false,
            verification: DebugVerificationV1.Blocked,
            reason: "existing InterpreterBackend exposes no task/actor/queue inspection API",
        )

    me close() -> Result<Nil, text>:
        if not self.attached:
            return Ok(nil)
        val now_ns = current_time_ms() * 1000000
        match self.backend.detach():
            case Err(reason):
                central_debug_service_v1_record_at(self.session_id, DebugRootOperationV1.Control, DebugPerturbationV1.Cooperative, "interpreter.detach.outcome", false, false, reason, now_ns)
                return Err(reason)
            case Ok(_): ()
        central_debug_service_v1_record_at(self.session_id, DebugRootOperationV1.Control, DebugPerturbationV1.Cooperative, "interpreter.detach.outcome", true, false, "", now_ns)
        central_debug_service_v1_close(self.session_id)?
        self.attached = false
        Ok(nil)

pub fn interpreter_expression_is_pure_lookup_v1(expression: text) -> bool:
    val value = expression.trim()
    if value == "":
        return false
    for ch in value:
        if not (ch.is_alphanumeric() or ch == '_'):
            return false
    not value[0:1].is_digit()
