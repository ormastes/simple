# LLM Caret - OpenAI-Compatible API
#
# Generic OpenAI-compatible endpoint for Ollama, LM Studio, vLLM, LocalAI, etc.
# Same protocol as OpenAI but configurable base URL and optional API key.

use app.llm_caret.json_helpers.{json_find, json_parse_int}

use std.nogc_sync_mut.io.http_sffi.{http_request_raw}

# ============================================================================
# JSON helpers (inlined)
# ============================================================================

fn _LB() -> text:
    (123 as char).to_text()

fn _RB() -> text:
    (125 as char).to_text()

fn _Q() -> text:
    "\""

fn _escape_json(s: text) -> text:
    var result = ""
    var i = 0
    while i < s.len():
        val ch = s[i]
        if ch == "\\":
            result = result + "\\\\"
        elif ch == "\"":
            result = result + "\\\""
        elif ch == "\n":
            result = result + "\\n"
        elif ch == "\r":
            result = result + "\\r"
        elif ch == "\t":
            result = result + "\\t"
        else:
            result = result + ch
        i = i + 1
    result

fn _extract_json_string(json: text, key: text) -> text:
    val quote = "\""
    val search = quote + key + quote + ":"
    val idx = json_find(json, search)
    if idx < 0:
        return ""
    val slen = search.len()
    val start = idx + slen
    val after = json.substring(start)
    val trimmed = after.trim()
    if trimmed.starts_with(quote):
        val rest = trimmed.substring(1)
        var end = 0
        var escaped = false
        while end < rest.len():
            val ch = rest[end]
            if escaped:
                escaped = false
            elif ch == "\\":
                escaped = true
            elif ch == "\"":
                return rest.substring(0, end)
            end = end + 1
    ""

fn _extract_json_value(json: text, key: text) -> text:
    val search = _Q() + key + _Q() + ":"
    val idx = json_find(json, search)
    if idx < 0:
        return "null"
    val slen = search.len()
    val start = idx + slen
    val after = json.substring(start)
    val trimmed = after.trim()
    var end = 0
    while end < trimmed.len():
        val ch = trimmed[end]
        if ch == "," or ch == _RB() or ch == "]":
            break
        end = end + 1
    trimmed.substring(0, end).trim()

fn _extract_json_int(json: text, key: text) -> i64:
    val raw = _extract_json_value(json, key)
    if raw == "null" or raw == "":
        return 0
    json_parse_int(raw)

# ============================================================================
# Response struct
# ============================================================================

struct CompatResponse:
    content: text
    model: text
    finish_reason: text
    prompt_tokens: i64
    completion_tokens: i64
    error: text
    is_error: bool
    raw: text

struct CompatRequest:
    method: text
    url: text
    headers: text
    body: text

# ============================================================================
# Request building
# ============================================================================

fn build_compat_body(model: text, messages_json: text, max_tokens: i64, temperature: f64) -> text:
    var parts: [text] = []
    parts = parts + [_Q() + "model" + _Q() + ":" + _Q() + _escape_json(model) + _Q()]
    parts = parts + [_Q() + "messages" + _Q() + ":" + messages_json]
    if max_tokens > 0:
        parts = parts + [_Q() + "max_tokens" + _Q() + ":" + max_tokens.to_text()]
    if temperature >= 0.0:
        parts = parts + [_Q() + "temperature" + _Q() + ":" + temperature.to_text()]
    var body = _LB()
    var i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    body = body + _RB()
    body

fn build_compat_headers(api_key: text) -> text:
    var h = "Content-Type: application/json"
    if api_key != "":
        h = "Authorization: Bearer " + api_key + "\n" + h
    h

fn compat_endpoint_url(base_url: text) -> text:
    var base = base_url
    while base.len() > 0 and base.ends_with("/"):
        base = base.substring(0, base.len() - 1)
    base + "/v1/chat/completions"

fn build_compat_request(base_url: text, api_key: text, model: text, messages_json: text, max_tokens: i64, temperature: f64) -> CompatRequest:
    CompatRequest(
        method: "POST",
        url: compat_endpoint_url(base_url),
        headers: build_compat_headers(api_key),
        body: build_compat_body(model, messages_json, max_tokens, temperature)
    )

# ============================================================================
# Response parsing
# ============================================================================

fn parse_compat_response(raw: text) -> CompatResponse:
    val trimmed_raw = raw.trim()
    if trimmed_raw == "":
        return CompatResponse(
            content: "",
            model: "",
            finish_reason: "",
            prompt_tokens: 0,
            completion_tokens: 0,
            error: "empty response",
            is_error: true,
            raw: ""
        )
    if not trimmed_raw.starts_with(_LB()) or not trimmed_raw.ends_with(_RB()):
        return CompatResponse(
            content: "",
            model: "",
            finish_reason: "error",
            prompt_tokens: 0,
            completion_tokens: 0,
            error: "malformed response",
            is_error: true,
            raw: raw
        )
    val error_msg = _extract_json_string(raw, "message")
    val has_content = _extract_json_string(raw, "content")
    if error_msg != "" and has_content == "":
        return CompatResponse(
            content: "",
            model: "",
            finish_reason: "error",
            prompt_tokens: 0,
            completion_tokens: 0,
            error: error_msg,
            is_error: true,
            raw: raw
        )
    if not _has_json_key(raw, "content"):
        return CompatResponse(
            content: "",
            model: "",
            finish_reason: "error",
            prompt_tokens: 0,
            completion_tokens: 0,
            error: "malformed response",
            is_error: true,
            raw: raw
        )
    if not _has_json_string_value(raw, "content"):
        return CompatResponse(
            content: "",
            model: "",
            finish_reason: "error",
            prompt_tokens: 0,
            completion_tokens: 0,
            error: "malformed response",
            is_error: true,
            raw: raw
        )
    val content_text = _extract_json_string(raw, "content")
    val model_val = _extract_json_string(raw, "model")
    val finish = _extract_json_string(raw, "finish_reason")
    val p_tok = _extract_json_int(raw, "prompt_tokens")
    val c_tok = _extract_json_int(raw, "completion_tokens")
    var final_finish = finish
    if final_finish == "":
        final_finish = "stop"
    CompatResponse(
        content: content_text,
        model: model_val,
        finish_reason: final_finish,
        prompt_tokens: p_tok,
        completion_tokens: c_tok,
        error: "",
        is_error: false,
        raw: raw
    )

fn _has_json_key(json: text, key: text) -> bool:
    json_find(json, _Q() + key + _Q() + ":") >= 0

fn _has_json_string_value(json: text, key: text) -> bool:
    val marker = _Q() + key + _Q() + ":"
    val index = json_find(json, marker)
    if index < 0:
        return false
    json.substring(index + marker.len()).trim().starts_with(_Q())

fn complete_compat_exchange(resp_body: text, http_error: text) -> CompatResponse:
    if http_error != "":
        return CompatResponse(
            content: "",
            model: "",
            finish_reason: "error",
            prompt_tokens: 0,
            completion_tokens: 0,
            error: "HTTP error: " + http_error,
            is_error: true,
            raw: resp_body
        )
    parse_compat_response(resp_body)

# ============================================================================
# Send request
# ============================================================================

fn compat_send(base_url: text, api_key: text, model: text, messages_json: text, max_tokens: i64, temperature: f64) -> CompatResponse:
    val request = build_compat_request(base_url, api_key, model, messages_json, max_tokens, temperature)
    val result = http_request_raw(request.method, request.url, request.headers, request.body)
    val resp_body = result.1 ?? ""
    val http_error = result.2 ?? ""
    complete_compat_exchange(resp_body, http_error)
