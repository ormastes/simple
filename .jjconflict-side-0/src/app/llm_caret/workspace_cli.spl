# LLM Caret - `workspace` dev toolset: tmux sessions + git worktrees for agents
#
#   simple run src/app/llm_caret/main.spl workspace <id> <command> [args] [--repo P] [--root P]
#
# Every command targets the private tmux socket `caret_ws_<id>`, so it can
# never reach the operator's own tmux server. `--repo` defaults to the cwd;
# `--root` defaults to <repo>/build/caret_worktrees/<id> (gitignored).
#
# ponytail: positional dispatch, no subcommand framework. Exit codes: 0 ok,
# 1 command failed, 2 usage.

use app.io.mod.{cwd}
use app.llm_caret.agent_workspace.{AgentWorkspace, WorkspaceResult,
    agent_workspace, tmux_available, session_alive, session_ensure,
    session_kill, list_panes, send_to_pane, send_to_each_pane, capture_pane,
    wait_for_pane_text, worktree_add, worktree_remove, worktree_list,
    worktree_path, agent_attach, agent_detach, launch_caret_suite}

struct WorkspaceCliArgs:
    id: text
    command: text
    positional: [text]
    repo: text
    root: text

pub fn workspace_usage() -> text:
    var u = "Usage: llm_caret workspace <id> <command> [args] [--repo <path>] [--root <path>]\n"
    u = u + "\n"
    u = u + "Agent sessions and worktrees on a private tmux socket (caret_ws_<id>).\n"
    u = u + "\n"
    u = u + "Commands:\n"
    u = u + "  status                       session alive? worktrees, panes\n"
    u = u + "  attach <agent> [cmd]         detached worktree + tmux window for <agent>\n"
    u = u + "  detach <agent>               kill the window and remove the worktree\n"
    u = u + "  add <agent> | remove <agent> worktree only\n"
    u = u + "  list                         worktrees git knows about for --repo\n"
    u = u + "  panes                        every pane target in the session\n"
    u = u + "  send <target> <cmd...>       send-keys to one pane\n"
    u = u + "  broadcast <cmd...>           send-keys to EVERY pane\n"
    u = u + "  capture <target>             print a pane's scrollback\n"
    u = u + "  wait <target> <marker> [ms]  block until marker shows on the pane\n"
    u = u + "  suite <spec> [wait_ms]       run bin/simple test <spec> in a caret_suite window\n"
    u = u + "  kill                         kill the private tmux server\n"
    u

pub fn parse_workspace_args(raw: [text]) -> WorkspaceCliArgs:
    # raw[0] == "workspace"
    var id = ""
    var command = ""
    var positional: [text] = []
    var repo = ""
    var root = ""
    var i = 1
    while i < raw.len():
        val a = raw[i]
        if a == "--repo" and i + 1 < raw.len():
            repo = raw[i + 1]
            i = i + 2
        elif a == "--root" and i + 1 < raw.len():
            root = raw[i + 1]
            i = i + 2
        elif id == "":
            id = a
            i = i + 1
        elif command == "":
            command = a
            i = i + 1
        else:
            positional = positional + [a]
            i = i + 1
    if repo == "":
        repo = cwd()
    if root == "":
        root = repo + "/build/caret_worktrees/" + id
    WorkspaceCliArgs(id: id, command: command, positional: positional, repo: repo, root: root)

fn _join(parts: [text]) -> text:
    var out = ""
    for p in parts:
        if out != "":
            out = out + " "
        out = out + p
    out

fn _report(r: WorkspaceResult) -> i64:
    if r.status == "ok":
        print "ok " + r.output.trim()
        return 0
    print "error " + r.reason + " " + r.output.trim()
    1

fn _need(args: WorkspaceCliArgs, n: i64, what: text) -> bool:
    if args.positional.len() >= n:
        return true
    print "error usage: " + args.command + " needs " + what
    false

fn _status(ws: AgentWorkspace) -> i64:
    print "socket " + ws.socket
    print "session " + ws.session + " alive=" + session_alive(ws: ws).to_text()
    for w in worktree_list(ws):
        print "worktree " + w
    for p in list_panes(ws):
        print "pane " + p
    0

pub fn run_workspace_cli(raw: [text]) -> i64:
    val args = parse_workspace_args(raw)
    if args.id == "" or args.command == "" or args.command == "help":
        print workspace_usage()
        return 2
    if not tmux_available() and args.command != "add" and args.command != "remove" and args.command != "list":
        print "error tmux_unavailable: tmux is not installed on this host"
        return 1
    val ws = agent_workspace(args.id, args.repo, args.root)
    val c = args.command
    if c == "status":
        return _status(ws)
    if c == "attach":
        if not _need(args, 1, "<agent> [cmd]"):
            return 2
        val cmd = if args.positional.len() > 1: _join(args.positional.slice(1, args.positional.len())) else ""
        val r = agent_attach(ws: ws, agent_id: args.positional[0], command: cmd)
        if r.status == "ok":
            print "worktree " + worktree_path(ws: ws, agent_id: args.positional[0])
            print "window " + ws.session + ":" + args.positional[0]
        return _report(r)
    if c == "detach":
        if not _need(args, 1, "<agent>"):
            return 2
        return _report(agent_detach(ws: ws, agent_id: args.positional[0]))
    if c == "add":
        if not _need(args, 1, "<agent>"):
            return 2
        val r = worktree_add(ws: ws, agent_id: args.positional[0])
        if r.status == "ok":
            print "worktree " + worktree_path(ws: ws, agent_id: args.positional[0])
        return _report(r)
    if c == "remove":
        if not _need(args, 1, "<agent>"):
            return 2
        return _report(worktree_remove(ws: ws, agent_id: args.positional[0]))
    if c == "list":
        for w in worktree_list(ws):
            print w
        return 0
    if c == "panes":
        for p in list_panes(ws):
            print p
        return 0
    if c == "send":
        if not _need(args, 2, "<target> <cmd...>"):
            return 2
        return _report(send_to_pane(ws: ws, target: args.positional[0],
            command: _join(args.positional.slice(1, args.positional.len()))))
    if c == "broadcast":
        if not _need(args, 1, "<cmd...>"):
            return 2
        val reached = send_to_each_pane(ws, _join(args.positional))
        for p in reached:
            print "sent " + p
        if reached.len() == 0:
            print "error no_panes"
            return 1
        return 0
    if c == "capture":
        if not _need(args, 1, "<target>"):
            return 2
        print capture_pane(ws: ws, target: args.positional[0])
        return 0
    if c == "wait":
        if not _need(args, 2, "<target> <marker> [ms]"):
            return 2
        val ms = if args.positional.len() > 2: (int(args.positional[2]) ?? 30000) else 30000
        if wait_for_pane_text(ws, args.positional[0], args.positional[1], ms):
            print "found " + args.positional[1]
            return 0
        print "error timeout waiting for " + args.positional[1]
        return 1
    if c == "suite":
        if not _need(args, 1, "<spec> [wait_ms]"):
            return 2
        val launched = launch_caret_suite(ws, args.repo, args.positional[0])
        if launched.status != "ok":
            print "error " + launched.reason + " " + launched.output
            return 1
        val target = launched.output
        print "window " + target
        val ms = if args.positional.len() > 1: (int(args.positional[1]) ?? 0) else 0
        if ms <= 0:
            return 0
        if not wait_for_pane_text(ws, target, "Results:", ms):
            print "error timeout: no Results: line within " + ms.to_text() + "ms"
            return 1
        val screen = capture_pane(ws: ws, target: target)
        for line in screen.split("\n"):
            if line.starts_with("Results:") or line.starts_with("SPEC FILE VERDICT:"):
                print line
        if screen.contains("PASS " + args.positional[0]):
            return 0
        print "error suite_failed"
        return 1
    if c == "kill":
        return _report(session_kill(ws))
    print "error unknown command '" + c + "'"
    print workspace_usage()
    2

export WorkspaceCliArgs
export workspace_usage, parse_workspace_args, run_workspace_cli
