"""Process-scoped resolution of transport credential references.

Only reference names cross configuration and persistence boundaries. Secret
values are read in the bridge process and remain memory-only.
"""

use app.io.mod.{env_get}

struct CredentialResolution:
    ok: bool
    value: text
    error: text

fn credential_environment_key(reference: text) -> text:
    if not reference.starts_with("secret://"): return ""
    val name = reference.substring(9)
    if name == "" or name.contains("..") or name.contains("\\") or name.contains(":"):
        return ""
    "SIMPLE_SECRET_" + name.replace("/", "_").replace("-", "_").replace(".", "_").to_upper()

fn resolve_transport_credential(reference: text) -> CredentialResolution:
    val key = credential_environment_key(reference)
    if key == "": return CredentialResolution(ok: false, value: "", error: "invalid_secret_reference")
    val value = env_get(key) ?? ""
    if value == "": return CredentialResolution(ok: false, value: "", error: "secret_unavailable")
    CredentialResolution(ok: true, value: value, error: "")

fn redact_credential_resolution(result: CredentialResolution) -> text:
    if result.ok: "credential_resolved" else: result.error

export CredentialResolution, credential_environment_key
export resolve_transport_credential, redact_credential_resolution
