"""Stable role-provider-ordinal agent name allocation."""

fn _contains_normalized(values: [text], candidate: text) -> bool:
    val normalized = candidate.trim().lower()
    for value in values:
        if value.trim().lower() == normalized:
            return true
    false

pub fn agent_name_reserved(candidate: text) -> bool:
    _contains_normalized(["all", "everyone", "system", "admin", "transport"], candidate)

pub fn allocate_agent_name(explicit_name: text, persisted_name: text, role: text, provider: text, used_names: [text]) -> text:
    val explicit = explicit_name.trim().lower()
    if explicit != "" and not agent_name_reserved(explicit) and not _contains_normalized(used_names, explicit):
        return explicit
    val persisted = persisted_name.trim().lower()
    if persisted != "" and not agent_name_reserved(persisted):
        return persisted
    val base = role.trim().lower() + "-" + provider.trim().lower() + "-"
    var ordinal = 1
    while ordinal <= 999:
        val suffix = if ordinal < 10: "0" + ordinal.to_text() else: ordinal.to_text()
        val candidate = base + suffix
        if not _contains_normalized(used_names, candidate) and not agent_name_reserved(candidate):
            return candidate
        ordinal = ordinal + 1
    ""

export agent_name_reserved, allocate_agent_name
