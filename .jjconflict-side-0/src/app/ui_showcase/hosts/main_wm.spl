# Entry point for the WM-client showcase target.
#
# Run by a window manager with SIMPLE_WM_APP_MODE=client and
# SIMPLE_WM_FRAME_FILE set. Standalone it prints a frames=0 line and says why,
# rather than pretending to have painted a window that does not exist.

use std.io_runtime.{env_get}
use app.ui_showcase.showcase_core.{showcase_run}
use app.ui_showcase.hosts.host_wm.{ScreenWmHost}

fn _env_i64(key: text, fallback: i64) -> i64:
    val raw = env_get(key).trim()
    if raw == "":
        return fallback
    val parsed: i64? = raw.to_int()
    parsed ?? fallback

fn main():
    val frames = _env_i64("SIMPLE_SHOWCASE_FRAMES", 120)
    val opened = ScreenWmHost.open_default()
    match opened:
        case None:
            print "showcase host=wm frames=0 clicks=0 drags=0 typed=\"\" left=0 right=0 free=0"
            print "showcase wm: not a WM client (SIMPLE_WM_APP_MODE / SIMPLE_WM_FRAME_FILE unset)"
        case Some(host):
            val r = showcase_run(host, "scwm", frames)
            host.shutdown()
            print "showcase host={r.host_name} frames={r.frames} clicks={r.clicks} " +
                "drags={r.drags} typed=\"{r.typed_text}\" left={r.left_offset} " +
                "right={r.right_offset} free={r.free_offset}"
            print "showcase wm receipt pixel_count={host.last_pixel_count} checksum={host.last_checksum} frame_seq={host.frame_seq}"
