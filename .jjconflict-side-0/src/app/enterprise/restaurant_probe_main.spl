# Minimal enterprise restaurant entry — one codebase for host OS and SimpleOS (AC-17).
use std.nogc_sync_mut.enterprise_store.store.{store_open_file, store_close}
use std.nogc_sync_mut.enterprise_restaurant.restaurant.{restaurant_setup, restaurant_session_state}

fn main():
    val store = store_open_file("build/test-artifacts/probe_restaurant.splstore")
    val ok = restaurant_setup(store)
    print("enterprise restaurant probe open=" + store.open_ok.to_text() + " setup=" + ok.to_text() + " state=[" + restaurant_session_state(store, "t1", "none") + "]")
    store_close(store)
