# Minimal enterprise booking entry — one codebase for host OS and SimpleOS (AC-17).
use std.nogc_sync_mut.enterprise_store.store.{store_open_file, store_close}
use std.nogc_sync_mut.enterprise_booking.booking.{booking_setup, booking_status}

fn main():
    val store = store_open_file("build/test-artifacts/probe_booking.splstore")
    val ok = booking_setup(store)
    print("enterprise booking probe open=" + store.open_ok.to_text() + " setup=" + ok.to_text() + " status=[" + booking_status(store, "t1", "none") + "]")
    store_close(store)
