"""CLI adapter for the installer-owned safe SCR1 producer.

All filesystem authority, signing-secret handling, and publication remain in
`os.installer.signed_catalog_record_producer_v1`; this leaf only maps CLI
arguments to its public value request.
"""

use std.cli.cli_util.{get_cli_args}
use std.io_runtime.{exit}
use os.installer.signed_catalog_record_producer_v1.{
    SignedCatalogRecordProduceRequestV1,
    signed_catalog_record_produce_v1
}

fn _arg(args: [text], name: text) -> text:
    var index: i64 = 0
    while index + 1 < args.len():
        if args[index] == name: return args[index + 1]
        index = index + 1
    ""

fn main():
    val args = get_cli_args()
    val result = signed_catalog_record_produce_v1(
        SignedCatalogRecordProduceRequestV1(
            trusted_absolute_root: _arg(args, "--trusted-root"),
            manifest_relative_path: _arg(args, "--manifest-sam1"),
            artifact_receipt_relative_path: _arg(args, "--artifact-receipt"),
            signer_seed_relative_path: _arg(args, "--signer-seed"),
            trust_config_relative_path: _arg(args, "--trust-config"),
            aliases_relative_path: _arg(args, "--aliases-file"),
            output_scr1_relative_path: _arg(args, "--output-scr1"),
            expected_canonical_path: _arg(args, "--expected-canonical-path"),
            expected_target_arch: _arg(args, "--expected-target-arch")))
    if not result.ok:
        print "simpleos-catalog-record-producer: " + result.reason
        exit(2)
    print result.receipt_line

main()
