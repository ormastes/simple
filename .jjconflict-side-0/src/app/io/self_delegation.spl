# Self-delegation depth guard.
#
# Several CLI wrappers (`compile`, `run`, `web`, ...) are startup-light shims
# that re-invoke `./bin/simple <same-subcommand> <same args>` and expect the
# binary to handle the subcommand natively. When that native handler is absent
# the shim re-enters ITSELF with identical argv, unconditionally, and every
# ancestor stays blocked in `wait` -- an unbounded live process chain.
#
# That is not hypothetical: `simple replay` did exactly this and consumed a
# 128 GB host (~1520 processes / ~97 GB) before it was caught. See
# doc/08_tracking/bug/simple_replay_self_spawns_unbounded_process_chain_2026-08-10.md
#
# This module makes the whole class self-limiting: each delegating shim calls
# `self_delegation_enter(<command>)` before spawning. The hop count travels to
# the child through the environment, so a self-loop trips the cap within a few
# hops and fails cleanly with a non-zero exit instead of forking forever.

use app.io.env_ops.{env_get, env_set}

# Maximum number of chained CLI self-delegation hops. Legitimate handoffs are
# 1-2 deep (shim -> native handler, or shim -> `run <worker.spl>` -> script);
# the cap leaves headroom for a nested worker while still killing a runaway
# chain after a handful of processes instead of thousands.
pub val SELF_DELEGATION_MAX_DEPTH = 4

pub fn self_delegation_depth() -> i64:
    val raw = env_get("SIMPLE_DELEGATION_DEPTH")
    if raw == "":
        return 0
    val n = raw.trim().to_i64()
    if n < 0:
        return 0
    n

# Record one more delegation hop and report whether the cap has been exceeded.
# Returns true when the caller MUST NOT delegate (terminal path required).
pub fn self_delegation_exceeded(command: text) -> bool:
    val next = self_delegation_depth() + 1
    env_set("SIMPLE_DELEGATION_DEPTH", "{next}")
    next > SELF_DELEGATION_MAX_DEPTH

# Human-readable diagnostic for a tripped guard.
pub fn self_delegation_error_text(command: text) -> text:
    "`simple {command}` re-invoked itself more than {SELF_DELEGATION_MAX_DEPTH} times " +
        "(SIMPLE_DELEGATION_DEPTH={self_delegation_depth()}); refusing to spawn another " +
        "child. This binary has no terminal handler for `{command}`."
