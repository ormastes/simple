# codex-impl
# Fail-closed reader and receipt renderer for release/support.sdn.

use std.nogc_sync_mut.io.file_ops.{file_exists, file_read}

struct SupportRequirement:
    channel: text
    target: text
    tier: text
    runner: text
    required: bool
    required_declared: bool
    availability: text
    bootstrap: text
    whole_tests: text

struct SupportPolicy:
    schema: text
    requirements: [SupportRequirement]
    valid: bool
    error: text

fn _empty_policy(reason: text) -> SupportPolicy:
    SupportPolicy(schema: "", requirements: [], valid: false, error: reason)

fn _value(line: text) -> text:
    val separator = line.index_of(":")
    if separator < 0:
        return ""
    line[separator + 1:].trim().replace("\"", "")

fn _known_channel(channel: text) -> bool:
    channel == "alpha" or channel == "beta" or channel == "rc" or channel == "stable"

fn _safe_atom(value: text) -> bool:
    if value == "":
        return false
    var index = 0
    while index < value.len():
        val code = value.char_code_at(index)
        val valid = (code >= 97 and code <= 122) or (code >= 48 and code <= 57) or code == 45 or code == 46 or code == 95
        if not valid:
            return false
        index = index + 1
    true

fn _append(requirements: [SupportRequirement], channel: text, target: text, tier: text, runner: text, required: bool, required_declared: bool, availability: text, bootstrap: text, whole_tests: text):
    requirements.push(SupportRequirement(channel: channel, target: target, tier: tier, runner: runner, required: required, required_declared: required_declared, availability: availability, bootstrap: bootstrap, whole_tests: whole_tests))

fn parse_support_policy(payload: text) -> SupportPolicy:
    var schema = ""
    var channel = ""
    var target = ""
    var tier = ""
    var runner = ""
    var required = false
    var required_seen = false
    var availability = ""
    var bootstrap = ""
    var whole_tests = ""
    var requirements: [SupportRequirement] = []

    for raw in payload.split("\n"):
        val line = raw.trim()
        if line == "" or line.starts_with("#") or line == "support:":
            continue
        if line.starts_with("schema:"):
            schema = _value(line)
            continue
        if line == "alpha:" or line == "beta:" or line == "rc:" or line == "stable:":
            if target != "":
                _append(requirements, channel, target, tier, runner, required, required_seen, availability, bootstrap, whole_tests)
                target = ""
            channel = line[0:line.len() - 1]
            continue
        if line.starts_with("- target:"):
            if target != "":
                _append(requirements, channel, target, tier, runner, required, required_seen, availability, bootstrap, whole_tests)
            target = _value(line)
            tier = ""
            runner = ""
            required = false
            required_seen = false
            availability = ""
            bootstrap = ""
            whole_tests = ""
        elif line.starts_with("tier:"):
            tier = _value(line)
        elif line.starts_with("runner:"):
            runner = _value(line)
        elif line.starts_with("required:"):
            required_seen = true
            val value = _value(line)
            if value != "true" and value != "false":
                return _empty_policy("release support required flag must be boolean")
            required = value == "true"
        elif line.starts_with("availability:"):
            availability = _value(line)
        elif line.starts_with("bootstrap:"):
            bootstrap = _value(line)
        elif line.starts_with("whole_tests:"):
            whole_tests = _value(line)
        else:
            return _empty_policy("unsupported release support policy field: " + line)

    if target != "":
        _append(requirements, channel, target, tier, runner, required, required_seen, availability, bootstrap, whole_tests)
    if schema != "simple-release-support/2":
        return _empty_policy("release support schema is missing or unsupported")
    for requirement in requirements:
        if not _known_channel(requirement.channel) or not _safe_atom(requirement.target) or not _safe_atom(requirement.runner):
            return _empty_policy("release support requirement has an invalid channel, target, or runner")
        if requirement.tier != "tier_1" and requirement.tier != "tier_2" and requirement.tier != "experimental":
            return _empty_policy("release support tier is invalid")
        if requirement.availability != "supported" and requirement.availability != "blocked" and requirement.availability != "experimental":
            return _empty_policy("release support availability is invalid")
        if not requirement.required_declared:
            return _empty_policy("release support required flag is missing")
        if requirement.bootstrap != "full" or requirement.whole_tests != "required":
            return _empty_policy("declared release support must require full bootstrap and whole tests")
        if requirement.required and requirement.availability != "supported":
            return _empty_policy("required release support cannot be blocked or experimental")
        if requirement.required and requirement.tier == "experimental":
            return _empty_policy("experimental release support cannot be required")
    var left = 0
    while left < requirements.len():
        var right = left + 1
        while right < requirements.len():
            if requirements[left].channel == requirements[right].channel and requirements[left].target == requirements[right].target:
                return _empty_policy("release support contains a duplicate channel target")
            right = right + 1
        left = left + 1
    SupportPolicy(schema: schema, requirements: requirements, valid: true, error: "")

fn load_support_policy(path: text) -> SupportPolicy:
    if not file_exists(path):
        return _empty_policy("release support policy is missing: " + path)
    parse_support_policy(file_read(path))

fn support_for_channel(policy: SupportPolicy, channel: text) -> [SupportRequirement]:
    var selected: [SupportRequirement] = []
    if not policy.valid:
        return selected
    for requirement in policy.requirements:
        if requirement.channel == channel:
            selected.push(requirement)
    selected

fn required_support(policy: SupportPolicy, channel: text) -> [SupportRequirement]:
    var selected: [SupportRequirement] = []
    for requirement in support_for_channel(policy, channel):
        if requirement.required:
            selected.push(requirement)
    selected

fn check_required_support(policy: SupportPolicy, channel: text) -> text:
    if not policy.valid:
        return policy.error
    if not _known_channel(channel):
        return "release support channel is invalid"
    if required_support(policy, channel).len() == 0:
        return "release support channel has no required targets"
    ""

fn check_single_job_coverage(policy: SupportPolicy, channel: text, observed_target: text) -> text:
    val reason = check_required_support(policy, channel)
    if reason != "":
        return reason
    val selected = required_support(policy, channel)
    if selected.len() != 1:
        return "candidate job is missing one or more policy-required target receipts"
    if selected[0].target != observed_target:
        return "candidate job target does not match policy-required support"
    ""

fn _status(requirement: SupportRequirement, observed_target: text) -> text:
    if requirement.target == observed_target:
        return "passed"
    if requirement.required:
        return "blocked"
    if requirement.availability == "blocked":
        return "unsupported"
    if requirement.availability == "experimental":
        return "experimental"
    "not_executed"

fn required_support_json(policy: SupportPolicy, channel: text) -> text:
    val selected = required_support(policy, channel)
    var entries: [text] = []
    for requirement in selected:
        entries.push("{\"target\":\"" + requirement.target + "\",\"tier\":\"" + requirement.tier + "\",\"runner\":\"" + requirement.runner + "\",\"bootstrap\":\"" + requirement.bootstrap + "\",\"whole_tests\":\"" + requirement.whole_tests + "\",\"status\":\"passed\"}")
    "[" + entries.join(",") + "]"

fn support_matrix_json(policy: SupportPolicy, channel: text, observed_target: text) -> text:
    val selected = support_for_channel(policy, channel)
    var entries: [text] = []
    for requirement in selected:
        val required_value = if requirement.required: "true" else: "false"
        val status = _status(requirement, observed_target)
        entries.push("{\"target\":\"" + requirement.target + "\",\"tier\":\"" + requirement.tier + "\",\"runner\":\"" + requirement.runner + "\",\"required\":" + required_value + ",\"availability\":\"" + requirement.availability + "\",\"bootstrap\":\"" + requirement.bootstrap + "\",\"whole_tests\":\"" + requirement.whole_tests + "\",\"status\":\"" + status + "\"}")
    "[" + entries.join(",") + "]"

export SupportRequirement, SupportPolicy, parse_support_policy, load_support_policy
export support_for_channel, required_support, check_required_support
export required_support_json, support_matrix_json, check_single_job_coverage
