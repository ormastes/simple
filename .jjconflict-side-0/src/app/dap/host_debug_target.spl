# Host DebugTarget adapter (P3)
#
# A THIN adapter exposing the existing host DAP session
# (`src/app/dap/simple_dap_main.spl`'s `SimpleDapSession`) behind the shared
# `DebugTarget` trait from `src/lib/common/debug/` (P2), so host and GPU
# debugging drive through ONE interface.
#
# Nothing in the existing DAP files is modified, moved, or restructured: this
# module only imports `SimpleDapSession` / `SimpleDapBreakpoint` and drives
# their existing breakpoint / step / continue / variables machinery.
#
# Selective import is deliberate. `simple_dap_main.spl` ends with a bare
# top-level `simple_dap_server_main()` call; importing only the two named
# symbols does NOT run the stdio server (verified empirically, 2026-08-09).
#
# `me` vs `fn` follows the trait exactly -- a `fn` trait method receives a
# COPY of the receiver and silently discards mutation, so every advancing or
# reconfiguring method here is `me`.
#
# Design: doc/05_design/app/tools/unified_debug_profile_capability_architecture_2026-08-09.md §2, §5

use app.dap.simple_dap_main.{SimpleDapSession, SimpleDapBreakpoint}
use std.common.base_encoding.{base_encoding_facade_text_to_bytes as text_to_bytes}
use std.common.debug.capability.{CapLevel}
use std.common.debug.debug_target.{DebugTarget, DebugState, debug_state_new, PC_KIND_LINE, STOP_BREAKPOINT, STOP_STEP, STOP_HALT, STOP_TRAP, STOP_RUNNING}

pub class HostDebugTarget:
    session: SimpleDapSession
    attached: bool

impl HostDebugTarget:
    # Wrap an already-launched session.
    pub static fn over(session: SimpleDapSession) -> HostDebugTarget:
        HostDebugTarget(session: session, attached: true)

    # Convenience: launch `program` in a fresh session and wrap it.
    pub static fn launch(program: text) -> HostDebugTarget:
        var session = SimpleDapSession.new()
        session.launch(program)
        HostDebugTarget(session: session, attached: true)

    fn has_breakpoint(loc: i64) -> bool:
        var i = 0
        while i < self.session.breakpoints.len():
            if self.session.breakpoints[i].line == loc:
                return true
            i = i + 1
        false

    # Snapshot builder. Pure -- never advances execution, so `state()` can be
    # called repeatedly and yield an equal snapshot.
    fn state_with(stop_reason: text) -> DebugState:
        val line = self.session.current_line
        debug_state_new(line, PC_KIND_LINE, self.variable_count(), [], [line], stop_reason)

    # `sp` on the host is the depth of the source-backed variable slab: the
    # number of bindings visible at the current line.
    fn variable_count() -> i64:
        val slab = self.session.variables_body()
        var count = 0
        val needle = "\"name\":\""
        var i = 0
        while i + needle.len() <= slab.len():
            if slab.slice(i, i + needle.len()) == needle:
                count = count + 1
            i = i + 1
        count

impl DebugTarget for HostDebugTarget:
    fn kind() -> text:
        "host"

    # The host session steps real source lines against a real source-backed
    # variable view -- measured, not synthesized.
    fn debug_level() -> CapLevel:
        CapLevel.Native

    # `loc` is in `pc_kind` units, i.e. a source line for the host.
    # True only when NEWLY added; false when already present or invalid.
    me set_breakpoint(loc: i64) -> bool:
        if not self.attached:
            return false
        if self.has_breakpoint(loc):
            return false
        self.session.set_breakpoint(SimpleDapBreakpoint(line: loc, condition: "", log_message: "", hit_condition: "", hits: 0))

    # `SimpleDapSession` has no removal entry point; the adapter rebuilds the
    # list rather than adding one, so the existing file stays untouched.
    me clear_breakpoint(loc: i64) -> bool:
        var kept: [SimpleDapBreakpoint] = []
        var removed = false
        var i = 0
        while i < self.session.breakpoints.len():
            val bp = self.session.breakpoints[i]
            if bp.line == loc:
                removed = true
            else:
                kept = kept.push(bp)
            i = i + 1
        self.session.breakpoints = kept
        removed

    # Ascending, no duplicates (set_breakpoint already rejects duplicates;
    # the sort makes the ascending half of the contract explicit rather than
    # an accident of insertion order).
    me breakpoints() -> [i64]:
        var lines: [i64] = []
        var i = 0
        while i < self.session.breakpoints.len():
            lines = lines.push(self.session.breakpoints[i].line)
            i = i + 1
        var a = 0
        while a < lines.len():
            var b = a + 1
            while b < lines.len():
                if lines[b] < lines[a]:
                    val tmp = lines[a]
                    lines[a] = lines[b]
                    lines[b] = tmp
                b = b + 1
            a = a + 1
        lines

    # Exactly one executable line, regardless of any breakpoint sitting on
    # the current or the next location.
    me step() -> DebugState:
        if not self.attached:
            return self.state_with(STOP_HALT)
        val before = self.session.current_line
        self.session.step()
        if self.session.current_line == before:
            # No further executable line: the program is at its end.
            return self.state_with(STOP_HALT)
        self.state_with(STOP_STEP)

    me resume() -> DebugState:
        if not self.attached:
            return self.state_with(STOP_HALT)
        val reason = self.session.continue_to_next_breakpoint()
        if reason == "terminated":
            return self.state_with(STOP_HALT)
        if reason == "exception":
            return self.state_with(STOP_TRAP)
        # "breakpoint" and "log" both stop at a breakpoint line.
        self.state_with(STOP_BREAKPOINT)

    me state() -> DebugState:
        self.state_with(STOP_RUNNING)

    # Host analogue of the GPU DATA region: the session's source-backed
    # variable slab, as returned by the existing `variables_body()`.
    # Any request that is negative or would run past the end of the slab
    # returns an EMPTY array -- never a short-but-nonempty buffer.
    me read_mem(offset: i64, len: i64) -> [u8]:
        var out: [u8] = []
        if not self.attached:
            return out
        if len <= 0 or offset < 0:
            return out
        val raw = text_to_bytes(self.session.variables_body())
        if offset + len > raw.len():
            return out
        var i = offset
        val limit = offset + len
        while i < limit:
            out = out.push(raw[i])
            i = i + 1
        out

    # Safe to call twice; the second call is a no-op returning "".
    me detach() -> text:
        self.session.breakpoints = []
        self.session.set_exception_filters([])
        self.attached = false
        ""

# Convenience for callers that only have a program path.
pub fn host_debug_target_for(program: text) -> HostDebugTarget:
    HostDebugTarget.launch(program)

# Byte length of the host "memory" (variable slab) at the current stop point,
# so callers can size a `read_mem` request that will not be rejected.
pub fn host_mem_len(target: HostDebugTarget) -> i64:
    if not target.attached:
        return 0
    text_to_bytes(target.session.variables_body()).len()
