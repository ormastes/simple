# Sheet Function Registry
#
# Lets third-party-style extensions (e.g. builtin/sheets_ext.spl) register
# spreadsheet functions without touching formula.spl's 9.7k-line inline
# dispatch. formula.spl's `_eval_function_call` consults this registry
# FIRST; an unmatched name falls through unchanged to the existing inline
# dispatch (see the hook at formula.spl's `_eval_function_call`).
#
# Single-threaded by contract: formula.spl already keeps module-level
# origin-cell / LET-binding state that is only safe under one evaluation at
# a time (see formula.spl:50-63), so this registry makes the same promise
# and must never be shared across concurrent recalculations.

use app.office.sheets.cell.{CellValue}
use app.office.sheets.spreadsheet.{Sheet}

struct SheetFunctionDescriptor:
    id: text                 # canonical (upper-case) function name, e.g. "DOUBLE"
    display_name: text
    arg_count_min: i32
    arg_count_max: i32       # -1 means unbounded
    volatile: bool           # true if the function must re-evaluate every recalc
    description: text

class SheetFunctionEntry:
    descriptor: SheetFunctionDescriptor
    evaluator: fn([[f64]], Sheet) -> Result<CellValue, text>

class SheetFunctionRegistry:
    entries: [SheetFunctionEntry]

    static fn new() -> SheetFunctionRegistry:
        SheetFunctionRegistry(entries: [])

    # First registration for a name wins; a duplicate id is rejected (not
    # silently overwritten) so a misbehaving extension cannot shadow an
    # already-registered function.
    me register(descriptor: SheetFunctionDescriptor,
                evaluator: fn([[f64]], Sheet) -> Result<CellValue, text>) -> bool:
        val id = descriptor.id.upper()
        var i = 0
        while i < self.entries.len():
            if self.entries[i].descriptor.id.upper() == id:
                return false
            i = i + 1
        self.entries = self.entries.push(SheetFunctionEntry(
            descriptor: SheetFunctionDescriptor(
                id: id,
                display_name: descriptor.display_name,
                arg_count_min: descriptor.arg_count_min,
                arg_count_max: descriptor.arg_count_max,
                volatile: descriptor.volatile,
                description: descriptor.description
            ),
            evaluator: evaluator
        ))
        true

    fn has(self, name: text) -> bool:
        val id = name.upper()
        for entry in self.entries:
            if entry.descriptor.id == id:
                return true
        false

    fn function_ids(self) -> [text]:
        var out: [text] = []
        for entry in self.entries:
            out.push(entry.descriptor.id)
        out

    fn count(self) -> i64:
        self.entries.len()

    # Evaluate a registered function. Callers must check `has(name)` first
    # (this is what formula.spl's hook does) -- calling with an unknown name
    # returns an Err rather than falling through, so the hook stays a plain
    # if/else.
    me evaluate(self, name: text, args: [[f64]], sheet: Sheet) -> Result<CellValue, text>:
        val id = name.upper()
        var i = 0
        while i < self.entries.len():
            if self.entries[i].descriptor.id == id:
                val d = self.entries[i].descriptor
                val argc = args.len().to_i32()
                if argc < d.arg_count_min:
                    return Err("{d.id}: expected at least {d.arg_count_min} argument(s), got {argc}")
                if d.arg_count_max >= 0 and argc > d.arg_count_max:
                    return Err("{d.id}: expected at most {d.arg_count_max} argument(s), got {argc}")
                val callback = self.entries[i].evaluator
                return callback(args, sheet)
            i = i + 1
        Err("no sheet function registered for '{name}'")

# ---- module-level singleton -------------------------------------------------
# formula.spl's evaluator is already single-threaded per recalc (see the
# origin-cell comment above); the registry mirrors that with one shared
# instance, same storage shape (list sentinel) used by theme_registry.spl's
# singleton.
var _sheet_function_registry_singleton: [SheetFunctionRegistry] = []

fn sheet_function_registry() -> SheetFunctionRegistry:
    if _sheet_function_registry_singleton.len() > 0:
        return _sheet_function_registry_singleton[0]
    val registry = SheetFunctionRegistry.new()
    _sheet_function_registry_singleton = [registry]
    registry

# Convenience wrappers so callers (formula.spl's hook, sheets_ext.spl) do not
# need to know the singleton's storage shape. Registration always
# read-modify-writes the WHOLE singleton array (never index-assigns into
# it) -- the same pattern theme_registry.spl's singleton uses, since class
# instances fetched back out of an array are not guaranteed to alias the
# stored element.
fn sheet_function_registry_has(name: text) -> bool:
    sheet_function_registry().has(name)

fn sheet_function_registry_evaluate(name: text, args: [[f64]], sheet: Sheet) -> Result<CellValue, text>:
    sheet_function_registry().evaluate(name, args, sheet)

fn sheet_function_registry_register(descriptor: SheetFunctionDescriptor,
                                     evaluator: fn([[f64]], Sheet) -> Result<CellValue, text>) -> bool:
    var reg = sheet_function_registry()
    val ok = reg.register(descriptor, evaluator)
    _sheet_function_registry_singleton = [reg]
    ok

fn sheet_function_registry_reset():
    """Test-only: clear all registered functions so specs do not leak state
    into each other (the registry is a process-wide singleton)."""
    _sheet_function_registry_singleton = []
