"""Standalone Calc terminal surface with no Office GUI dependency."""

use app.office.sheets.spreadsheet.{Sheet}
use app.office.sheets.cell.{CellRef, cell_ref_to_string, cell_display_text}
use app.office.file_formats.{recalculate_formula_cells}
use app.office.sheets.sheet_io.{sheet_load, sheet_save}
use common.ui.spreadsheet_grid.{spreadsheet_grid_default_metrics, spreadsheet_grid_width, spreadsheet_grid_column_label}
use std.common.string_core.{char_from_code}

struct CalcTuiState:
    sheet: Sheet
    active: CellRef
    buffer: text
    status: text
    pending_escape: i32
    quit: bool
    dirty: bool

fn calc_tui_new(sheet: Sheet) -> CalcTuiState:
    CalcTuiState(
        sheet: sheet,
        active: CellRef(col: 0, row: 0),
        buffer: "",
        status: "arrows move - type edits - Enter commits - s saves - q quits",
        pending_escape: 0,
        quit: false,
        dirty: false
    )

fn _pad(value: text, width: i32) -> text:
    var out = value
    if out.len() > width:
        out = out.slice(0, width)
    while out.len() < width:
        out = out + " "
    out

fn calc_grid_text(sheet: Sheet) -> text:
    val metrics = spreadsheet_grid_default_metrics()
    var lines: [text] = []
    var header = _pad("", metrics.row_header_width)
    var col = 0
    while col < metrics.visible_columns:
        header = header + _pad(spreadsheet_grid_column_label(col), metrics.cell_width)
        col = col + 1
    lines.push(header)
    var row = 0
    while row < metrics.visible_rows:
        var line = _pad((row + 1).to_text(), metrics.row_header_width)
        col = 0
        while col < metrics.visible_columns:
            val ref = cell_ref_to_string(CellRef(col: col, row: row))
            line = line + _pad(cell_display_text(sheet.get_cell(ref)), metrics.cell_width)
            col = col + 1
        lines.push(line)
        row = row + 1
    lines.join("\n")

fn calc_tui_frame(state: CalcTuiState, file_label: text, ansi: bool) -> text:
    val metrics = spreadsheet_grid_default_metrics()
    val ref = cell_ref_to_string(state.active)
    val current = cell_display_text(state.sheet.get_cell(ref))
    val formula = if state.buffer != "": state.buffer else: current
    val esc = char_from_code(27)
    val clear = if ansi: "{esc}[2J{esc}[H" else: ""
    val title = _pad("Simple Calc - {file_label}", spreadsheet_grid_width(metrics))
    val formula_line = _pad("[{ref}] {formula}", spreadsheet_grid_width(metrics))
    val blank = _pad("", spreadsheet_grid_width(metrics))
    val status = _pad(state.status, spreadsheet_grid_width(metrics))
    clear + [title, formula_line, blank, calc_grid_text(state.sheet), blank, status, blank].join("\n")

fn _move(state: CalcTuiState, col_delta: i32, row_delta: i32) -> CalcTuiState:
    var next = state
    val metrics = spreadsheet_grid_default_metrics()
    var col = next.active.col + col_delta
    var row = next.active.row + row_delta
    if col < 0: col = 0
    if row < 0: row = 0
    if col >= metrics.visible_columns: col = metrics.visible_columns - 1
    if row >= metrics.visible_rows: row = metrics.visible_rows - 1
    next.active = CellRef(col: col, row: row)
    next.pending_escape = 0
    next

fn calc_tui_apply_byte(state: CalcTuiState, byte: i64) -> CalcTuiState:
    var next = state
    next.dirty = false
    if byte < 0:
        next.quit = true
        return next
    if next.pending_escape == 1:
        next.pending_escape = if byte == 91: 2 else: 0
        return next
    if next.pending_escape == 2:
        if byte == 65: return _move(next, 0, -1)
        if byte == 66: return _move(next, 0, 1)
        if byte == 67: return _move(next, 1, 0)
        if byte == 68: return _move(next, -1, 0)
        next.pending_escape = 0
        return next
    if byte == 27:
        next.pending_escape = 1
        return next
    if byte == 10 or byte == 13:
        if next.buffer != "":
            var sheet = next.sheet
            val ref = cell_ref_to_string(next.active)
            sheet.set_value(ref, next.buffer)
            sheet = recalculate_formula_cells(sheet)
            next.sheet = sheet
            next.status = "{ref} = {cell_display_text(sheet.get_cell(ref))}"
            next.buffer = ""
        return _move(next, 0, 1)
    if byte == 127 or byte == 8:
        if next.buffer.len() > 0:
            next.buffer = next.buffer.slice(0, next.buffer.len() - 1)
        return next
    if next.buffer == "" and byte == 113:
        next.quit = true
        return next
    if next.buffer == "" and byte == 115:
        next.dirty = true
        next.status = "saved"
        return next
    if byte >= 32 and byte <= 126:
        next.buffer = next.buffer + char_from_code(byte)
    next

fn run_calc_frame_once(path: text) -> i32:
    print calc_tui_frame(calc_tui_new(sheet_load(path)), path, false)
    0

export CalcTuiState, calc_tui_new, calc_grid_text, calc_tui_frame,
    calc_tui_apply_byte, run_calc_frame_once
