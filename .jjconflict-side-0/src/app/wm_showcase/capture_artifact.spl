# WM Showcase capture artifact — write the composited desktop frame to a
# viewable P6 PPM plus a provenance sidecar.
#
# The sidecar exists so the image can never be read as a stronger claim than
# the run supports: it names the lane that produced the pixels, whether the
# readback was device-proven, and how many windows rendered versus were
# declared.

use common.image.ppm_decode.{encode_ppm_p6}
use std.io_runtime.{file_write_bytes, mkdir_p, write_file}
use app.wm_showcase.session.{WmShowcaseCapture, WmShowcaseProvenance}

val WM_SHOWCASE_ARTIFACT_DIR: text = "build/tmp/wm_showcase"

fn wm_showcase_ppm_path(name: text) -> text:
    WM_SHOWCASE_ARTIFACT_DIR + "/" + name + ".ppm"

fn wm_showcase_provenance_path(name: text) -> text:
    WM_SHOWCASE_ARTIFACT_DIR + "/" + name + ".provenance.sdn"

fn wm_showcase_write_ppm(name: text, capture: WmShowcaseCapture) -> bool:
    """Write the frame as P6 PPM. False when the frame is not a full buffer —
    a short buffer is never padded into a plausible-looking image."""
    if capture.width <= 0 or capture.height <= 0:
        return false
    if capture.pixels.len() != capture.width * capture.height:
        return false
    if not mkdir_p(WM_SHOWCASE_ARTIFACT_DIR):
        return false
    val bytes = encode_ppm_p6(
        capture.width as u32, capture.height as u32, capture.pixels
    )
    if bytes.len() == 0:
        return false
    file_write_bytes(wm_showcase_ppm_path(name), bytes)

fn wm_showcase_provenance_sdn(
    capture: WmShowcaseCapture, provenance: WmShowcaseProvenance
) -> text:
    "lane: \"{provenance.lane}\"\n" +
        "resolved_backend: \"{provenance.resolved_backend}\"\n" +
        "readback_source: \"{provenance.readback_source}\"\n" +
        "backend_handle: {provenance.backend_handle}\n" +
        "device_identity: {provenance.device_identity}\n" +
        "readback_pixel_count: {provenance.readback_pixel_count}\n" +
        "expected_pixel_count: {provenance.expected_pixel_count}\n" +
        "device_proven: {provenance.device_proven}\n" +
        "render_degraded: {provenance.render_degraded}\n" +
        "degrade_reason: \"{provenance.degrade_reason}\"\n" +
        "frame_width: {capture.width}\n" +
        "frame_height: {capture.height}\n" +
        "frame_checksum: {capture.checksum}\n" +
        "distinct_colors: {capture.distinct_colors}\n" +
        "declared_windows: {capture.declared_windows}\n" +
        "open_windows: {capture.open_windows}\n" +
        "rendered_windows: {capture.rendered_windows}\n" +
        "taskbar_entries: {capture.taskbar_entries}\n" +
        "taskbar_titles: \"{capture.taskbar_titles}\"\n"

fn wm_showcase_write_provenance(
    name: text, capture: WmShowcaseCapture, provenance: WmShowcaseProvenance
) -> bool:
    if not mkdir_p(WM_SHOWCASE_ARTIFACT_DIR):
        return false
    write_file(
        wm_showcase_provenance_path(name),
        wm_showcase_provenance_sdn(capture, provenance)
    )
