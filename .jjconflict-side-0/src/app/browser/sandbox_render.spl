# Sandboxed render route: page markup -> jailed renderer worker -> pixels.
#
# This is the route problem 3 of
# doc/08_tracking/bug/browser_seccomp_denylist_and_inprocess_unjailed_2026-08-15.md
# was missing. The jail itself already existed (the worker calls
# rt_browser_renderer_sandbox_enter: rlimits + no_new_privs + namespaces +
# Landlock + a seccomp ALLOW-list), and the broker already existed. What was
# missing was a caller in this app that put page markup through them.
#
# The broker/raster handshake is NOT repeated here — it lives once in
# os.hosted.hosted_browser_render_session, shared with the evidence paths in
# hosted_browser_render_evidence.spl. Before that module existed the sequence
# was written out three times. If you need a jailed render, open a session;
# do not re-derive the sequence.
#
# Correction worth recording, because it cost real time: this route was
# previously documented as blocked on "the broker returns DrawIrComposition,
# not [u32], so a rasterization step is needed that does not exist". That was
# WRONG. `Engine2dCompositorBackend.render_draw_ir_composition` has existed all
# along (src/os/compositor/compositor_engine2d.spl:364) and
# src/os/hosted/hosted_browser_render_evidence.spl already drove exactly this
# sequence. The false negative came from searching with the repo's default
# `grep`, a wrapped ugrep honouring .gitignore that returned zero hits;
# /usr/bin/grep returns 20. See .claude/rules/commands.md § Fast Path.
#
# Fail-closed contract: every failure returns Err. Nothing here falls back to
# an in-process render, because a silent fallback is indistinguishable to the
# caller from a successful jailed render — which is the whole defect this
# route exists to remove.

use os.hosted.hosted_browser_render_session.{
    hosted_browser_render_session_open,
    hosted_browser_render_session_close,
    hosted_browser_render_session_frame
}

val BROWSER_SANDBOX_RENDER_TIMEOUT_MS: i64 = 4000

pub fn browser_sandbox_render_pixels(
    executable: text, html: text, width: i32, height: i32
) -> Result<[u32], text>:
    """Render `html` in the sandboxed renderer worker and return its pixels.

    `executable` is the operator-supplied worker-capable binary probed by
    `app.browser.sandbox_routing`. The page's parse/cascade/layout/paint and
    any script all run in the child, behind the jail. Only Draw IR crosses
    back; this process rasterizes it and never evaluates page content."""
    val session = match hosted_browser_render_session_open(
        executable, 1, width, height, BROWSER_SANDBOX_RENDER_TIMEOUT_MS
    ):
        Ok(opened): opened
        Err(reason): return Err("sandboxed {reason}")

    val frame = match hosted_browser_render_session_frame(
        session, "init", html, BROWSER_SANDBOX_RENDER_TIMEOUT_MS
    ):
        Ok(rendered): rendered
        Err(reason):
            hosted_browser_render_session_close(session)
            return Err("sandboxed {reason}")

    val closed = hosted_browser_render_session_close(session)
    if not closed:
        return Err("sandboxed renderer cleanup failed")
    if frame.raster.fallback_required:
        return Err("software raster requested a fallback path")
    # A jailed render that produced no commands is a failure, not an empty
    # page: it is what a crashed or muzzled worker also looks like, and
    # returning a blank buffer would present it as a successful render.
    if frame.raster.rendered_command_count <= 0:
        return Err("sandboxed render produced no draw commands")
    if frame.raster.pixels.len() != (width * height).to_i64():
        return Err("sandboxed render size mismatch")
    Ok(frame.raster.pixels)

export browser_sandbox_render_pixels
