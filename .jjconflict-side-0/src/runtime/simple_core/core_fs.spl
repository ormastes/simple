# Pure-Simple `simple-core` file system ABI wrappers.
#
# Provides file I/O primitives (read, write, append, exists, delete, size)
# and directory creation (mkdir -p) by delegating to libc/POSIX.
# Public rt_* entrypoints follow the compiler runtime SFFI ABI: text inputs
# arrive as pointer/length pairs and text outputs return runtime tagged values.

@unsafe(reason: "raw libc heap allocation ABI; zero means failure", capabilities: [ffi, raw_ptr])
extern fn malloc(size: i64) -> i64
@unsafe(reason: "raw libc owned heap-pointer release ABI", capabilities: [ffi, raw_ptr])
extern fn free(ptr: i64)
@unsafe(reason: "raw NUL-terminated string pointer length ABI", capabilities: [ffi, raw_ptr])
extern fn strlen(s: i64) -> i64
@unsafe(reason: "raw libc path/mode pointer and FILE handle ABI; zero means failure", capabilities: [ffi, raw_ptr])
extern fn fopen(path: i64, mode: i64) -> i64
@unsafe(reason: "raw libc FILE-handle close status ABI", capabilities: [ffi, raw_ptr])
extern fn fclose(stream: i64) -> i64
@unsafe(reason: "raw libc FILE-handle mutable pointer/element extent read ABI", capabilities: [ffi, raw_ptr])
extern fn fread(ptr: i64, size: i64, count: i64, stream: i64) -> i64
@unsafe(reason: "raw libc FILE-handle pointer/element extent write ABI", capabilities: [ffi, raw_ptr])
extern fn fwrite(ptr: i64, size: i64, count: i64, stream: i64) -> i64
@unsafe(reason: "raw libc FILE-handle error-state ABI", capabilities: [ffi, raw_ptr])
extern fn ferror(stream: i64) -> i64
@unsafe(reason: "raw libc FILE-handle seek status ABI", capabilities: [ffi, raw_ptr])
extern fn fseek(stream: i64, offset: i64, whence: i64) -> i64
@unsafe(reason: "raw libc FILE-handle position ABI; negative return is failure", capabilities: [ffi, raw_ptr])
extern fn ftell(stream: i64) -> i64
@unsafe(reason: "raw libc path pointer and file-descriptor ABI; negative return is failure", capabilities: [ffi, raw_ptr])
extern fn open(path: i64, flags: i64) -> i64
@unsafe(reason: "raw file-descriptor mutable pointer/count read ABI", capabilities: [ffi, raw_ptr])
extern fn read(fd: i64, ptr: i64, count: i64) -> i64
@unsafe(reason: "raw file-descriptor pointer/count write ABI", capabilities: [ffi, raw_ptr])
extern fn write(fd: i64, ptr: i64, count: i64) -> i64
@unsafe(reason: "raw file-descriptor close status ABI", capabilities: [ffi])
extern fn close(fd: i64) -> i64
@unsafe(reason: "raw file-descriptor synchronization status ABI", capabilities: [ffi])
extern fn fsync(fd: i64) -> i64
@unsafe(reason: "raw file-descriptor seek ABI; negative return is failure", capabilities: [ffi])
extern fn lseek(fd: i64, offset: i64, whence: i64) -> i64
@unsafe(reason: "raw memory-map address/length and file-descriptor ABI; failure sentinel is platform-defined", capabilities: [ffi, raw_ptr])
extern fn mmap(addr: i64, length: i64, prot: i64, flags: i64, fd: i64, offset: i64) -> i64
@unsafe(reason: "raw memory-map address/length release ABI", capabilities: [ffi, raw_ptr])
extern fn munmap(addr: i64, length: i64) -> i64
@unsafe(reason: "raw libc path pointer and directory-mode status ABI", capabilities: [ffi, raw_ptr])
extern fn mkdir(path: i64, mode: i64) -> i64
@unsafe(reason: "raw libc path pointer and DIR handle ABI; zero means failure", capabilities: [ffi, raw_ptr])
extern fn opendir(path: i64) -> i64
@unsafe(reason: "raw libc DIR handle and borrowed dirent pointer ABI", capabilities: [ffi, raw_ptr])
extern fn readdir(dir: i64) -> i64
@unsafe(reason: "raw libc DIR-handle close status ABI", capabilities: [ffi, raw_ptr])
extern fn closedir(dir: i64) -> i64
@unsafe(reason: "raw libc old/new path pointer rename status ABI", capabilities: [ffi, raw_ptr])
extern fn rename(old_path: i64, new_path: i64) -> i64
@unsafe(reason: "raw libc path pointer removal status ABI", capabilities: [ffi, raw_ptr])
extern fn remove(path: i64) -> i64
@unsafe(reason: "raw tagged-string borrowed data-pointer ABI", capabilities: [ffi, raw_ptr])
extern fn rt_string_data(value: i64) -> i64
@unsafe(reason: "raw tagged-string length ABI", capabilities: [ffi])
extern fn rt_string_len(value: i64) -> i64
@unsafe(reason: "raw borrowed byte pointer/length and owned tagged-string ABI", capabilities: [ffi, raw_ptr])
extern fn rt_string_new(bytes: i64, len: i64) -> i64
@unsafe(reason: "raw owned tagged-array handle allocation ABI; nonpositive return is failure", capabilities: [ffi])
extern fn rt_array_new(cap: i64) -> i64
@unsafe(reason: "raw tagged-array handle value-transfer ABI", capabilities: [ffi])
extern fn rt_array_push(array: i64, value: i64) -> i8
@unsafe(reason: "raw owned byte-array handle allocation ABI; nonpositive return is failure", capabilities: [ffi])
extern fn rt_byte_array_new_len(len: i64) -> i64
@unsafe(reason: "raw pointer/offset byte load ABI", capabilities: [ffi, raw_ptr])
extern fn spl_load_u8(ptr: i64, offset: i64) -> i64
@unsafe(reason: "raw pointer/offset i64 load ABI", capabilities: [ffi, raw_ptr])
extern fn spl_load_i64(ptr: i64, offset: i64) -> i64
@unsafe(reason: "raw pointer/offset byte store ABI", capabilities: [ffi, raw_ptr])
extern fn spl_store_u8(ptr: i64, offset: i64, value: i64)
@unsafe(reason: "raw pointer/offset i64 store ABI", capabilities: [ffi, raw_ptr])
extern fn spl_store_i64(ptr: i64, offset: i64, value: i64)

@always_inline
fn _sffi_core_fs_free(ptr: i64):
    unsafe(capabilities: [ffi, raw_ptr]):
        free(ptr)

@always_inline
fn _sffi_core_fs_fclose(stream: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]):
        fclose(stream)

@always_inline
fn _sffi_core_fs_close(fd: i64) -> i64:
    unsafe(capabilities: [ffi]):
        close(fd)

@always_inline
fn _sffi_core_fs_rt_string_new(bytes: i64, len: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]):
        rt_string_new(bytes, len)

