# Simple-side COMPOSITING extractor for the Chrome<->Simple component-level
# differential (stage 6: compositing / layerization).
#
# Runs the real web-renderer pipeline entry point
# `simple_web_layout_render_html_draw_ir` from
# src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer.spl
# and prints, as one JSON document on stdout between BEGIN/END sentinels, the
# compositing-relevant shape of the resulting DrawIrComposition:
#
#   * its BATCHES -- a DrawIrBatch is Simple's unit of independently-submitted
#     backend work, i.e. the closest counterpart to a cc composited layer, and
#     therefore the thing Chrome's layer list is compared against;
#   * for every command, the promotion-TRIGGER style properties it carries.
#
# The second half is the point. Simple has no layerization pass at all
# (src/lib/cc/entity/layer.spl exists but nothing in the browser engine
# constructs a Layer -- see CONTRACT.md), so a bare unit count would only ever
# say "1 vs N". Recording which trigger properties survive into the Draw IR
# separates two very different defects:
#   (a) the property reaches the Draw IR but nothing acts on it  -> compositor missing
#   (b) the property never reaches the Draw IR at all            -> style plumbing missing too
#
# Env:
#   COMPOSITE_DUMP_HTML   path to the fixture .html          (required)
#   COMPOSITE_DUMP_W      viewport width  in css px, default 800
#   COMPOSITE_DUMP_H      viewport height in css px, default 600
#
# The sentinels exist because the shared toolchain emits use/gc warnings and
# [rfm]/[web-style-producer] probe lines on stdout; the driver slices between
# them.
#
# NOTE: the fixture is read from a FILE, never embedded as a text literal.
# `"body{margin:0}"` in a Simple text literal parses `{margin:0}` as string
# interpolation and fails with "variable `margin` not found".

use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_render_html_draw_ir
}
use std.io_runtime.{env_get, read_file}

val BEGIN_SENTINEL: text = "<<<COMPOSITE_DUMP_JSON_BEGIN>>>"
val END_SENTINEL: text = "<<<COMPOSITE_DUMP_JSON_END>>>"

# A literal `}}` in a Simple text literal collapses to a single `}` (the brace
# escape that pairs with `{` interpolation), which silently produced invalid
# JSON in the paint stage. Close braces one at a time through this constant.
val RB: text = "}"

# Every CSS property that can make Blink promote an element to its own
# composited layer, plus the ones that define the layer's transform/clip.
#
# This list is deliberately the FULL set, not the set Simple happens to emit.
# A property in this list that never appears in any command is a measured
# finding ("Simple's Draw IR carries no `transform` at all"), not a gap in the
# extractor. The differ reports absences explicitly.
val COMPOSITING_PROPS: [text] = [
    "will-change", "transform", "transform-style", "transform-origin", "transform-box",
    "position", "z-index", "opacity", "isolation", "mix-blend-mode", "filter",
    "backdrop-filter", "backface-visibility", "perspective", "contain",
    "animation-name", "transition-property", "overflow-x", "overflow-y",
    "clip-path", "mask"
]

# NOTE: deliberately replace-based, not index-based. `text.len()` returns the
# BYTE length while `text[i]` indexes by CHARACTER, so a char-by-char escape
# loop walks off the end of any non-ASCII string. Same defect noted in
# tools/layout_diff/CONTRACT.md.
fn json_escape(s: text) -> text:
    var out = s.replace("\\", "\\\\")
    out = out.replace("\"", "\\\"")
    out = out.replace("\n", "\\n")
    out = out.replace("\r", "\\r")
    out = out.replace("\t", "\\t")
    out

fn env_i32(name: text, fallback: i32) -> i32:
    val raw = "" + env_get(name)
    if raw == "" or raw == "nil":
        return fallback
    val parsed = raw.to_i64()
    if parsed <= 0:
        return fallback
    parsed as i32

fn is_compositing_prop(key: text) -> bool:
    var i = 0
    while i < (COMPOSITING_PROPS.len() as i32):
        if COMPOSITING_PROPS[i] == key:
            return true
        i = i + 1
    false

fn bool_json(b: bool) -> text:
    if b:
        return "true"
    "false"

fn main() -> i64:
    val path = env_get("COMPOSITE_DUMP_HTML")
    if path == "":
        print "ERROR: COMPOSITE_DUMP_HTML not set"
        return 2
    val width = env_i32("COMPOSITE_DUMP_W", 800)
    val height = env_i32("COMPOSITE_DUMP_H", 600)
    val html = read_file(path)
    if html == "":
        print "ERROR: empty or unreadable fixture: " + path
        return 2

    val comp = simple_web_layout_render_html_draw_ir(html, width, height)
    val batch_count = comp.batches.len() as i32

    print BEGIN_SENTINEL
    print "{"
    print "  \"engine\": \"simple\","
    print "  \"fixture\": \"" + json_escape(path) + "\","
    print "  \"schema\": \"" + json_escape(comp.schema) + "\","
    print "  \"composition_id\": \"" + json_escape(comp.composition_id) + "\","
    print "  \"scene_key\": \"" + json_escape(comp.scene_key) + "\","
    print "  \"backend_target\": \"" + json_escape(comp.backend_target) + "\","
    print "  \"viewport\": {\"w\": " + width.to_string() + ", \"h\": " + height.to_string() + "},"
    print "  \"batch_count\": " + batch_count.to_string() + ","
    print "  \"batches\": ["
    var bi = 0
    while bi < batch_count:
        val batch = comp.batches[bi]
        if bi > 0:
            print "    ,"
        print "    {"
        print "      \"batch_id\": \"" + json_escape(batch.batch_id) + "\","
        print "      \"backend_target\": \"" + json_escape(batch.backend_target) + "\","
        print "      \"components\": ["
        val cmd_count = batch.commands.len() as i32
        var ci = 0
        while ci < cmd_count:
            val c = batch.commands[ci]
            if ci > 0:
                print "        ,"
            var line = "        {\"kind\": \"" + json_escape(c.kind) + "\""
            line = line + ", \"component_id\": \"" + json_escape(c.component_id) + "\""
            line = line + ", \"parent_id\": \"" + json_escape(c.parent_id) + "\""
            line = line + ", \"x\": " + c.x.to_string()
            line = line + ", \"y\": " + c.y.to_string()
            line = line + ", \"w\": " + c.width.to_string()
            line = line + ", \"h\": " + c.height.to_string()
            # A clip_rect is the only structural grouping the Draw IR has; it is
            # what a reader would reach for first as a stand-in for a layer, so
            # record whether one is present and where.
            line = line + ", \"clip_present\": " + bool_json(c.clip_rect.present)
            line = line + ", \"clip_x\": " + c.clip_rect.x.to_string()
            line = line + ", \"clip_y\": " + c.clip_rect.y.to_string()
            line = line + ", \"clip_w\": " + c.clip_rect.width.to_string()
            line = line + ", \"clip_h\": " + c.clip_rect.height.to_string()
            line = line + ", \"triggers\": {"
            var pi = 0
            var emitted = 0
            val prop_count = c.computed_style.len() as i32
            while pi < prop_count:
                val prop = c.computed_style[pi]
                if is_compositing_prop(prop.key):
                    if emitted > 0:
                        line = line + ", "
                    line = line + "\"" + json_escape(prop.key) + "\": \"" + json_escape(prop.value) + "\""
                    emitted = emitted + 1
                pi = pi + 1
            line = line + RB + RB
            print line
            ci = ci + 1
        print "      ]"
        print "    }"
        bi = bi + 1
    print "  ]"
    print "}"
    print END_SENTINEL
    0
