# Flat-AST -> parser-AST transition table for the bootstrap frontend bridge
# (src/compiler/10.frontend/_FlatAstBridge/).
#
# Row shape is the shared `transition: from/to/state/reason/test` format defined
# by src/compiler/00.common/transition/ (lane A3). States:
#   Implemented          -- a dedicated dispatch arm maps this tag onto the
#                           same-named target node.
#   Normalized(target)   -- a dedicated arm maps it onto a DIFFERENT target on
#                           purpose; `to` names the real target.
#   Unsupported(reason)  -- no arm; the node reaches the generic catch-all.
#                           Every such row is LOUD as of lane C2: the fallback
#                           raises a parser_error, so parser_has_errors() goes
#                           true instead of the node vanishing silently.
#   NotApplicable(reason)-- the tag constant exists but nothing ever allocates
#                           the node, so it cannot reach the bridge.
#
# Lane C2 (flat-bridge transition census). Generated from a census of the tag
# constants and of the dispatch arms; keep it in sync when an arm is added.
#
# Source of truth: convert_nodes.spl :: convert_flat_stmt / convert_flat_stmt_in_list
# / convert_flat_if_stmt (29 tags, 21 handled).
#
# Emitted in the shared reference dialect (flat `transition:` blocks, an
# explicit `universe:` block, lowercase state tags) so
# src/compiler/00.common/transition/transition_table.spl can compute
# Missing = Universe - declared non-vacuously (universe_declared: true).
# The `universe:` list below is EVERY tag constant declared in
# src/compiler/10.frontend/core/ast_stmt.spl -- 29 of them -- not merely the ones
# this bridge happens to handle, which is what makes an omitted row show
# up as Missing instead of silently disappearing. The numeric flat tag
# lives in each row's `reason:` rather than in `from:`, because the
# loader's variant_name_of() takes the text after the last dot verbatim
# and a ' (tag=N)' suffix would never match a bare universe entry.

table: flat_stmt_to_ast_stmt
producer: FlatStmtKind
consumer: StmtKind
source: src/compiler/10.frontend/_FlatAstBridge/convert_nodes.spl

universe:
  - EXPR
  - VAL_DECL
  - VAR_DECL
  - ASSIGN
  - RETURN
  - IF
  - FOR
  - WHILE
  - MATCH
  - BLOCK
  - BREAK
  - CONTINUE
  - COMPOUND_ASSIGN
  - DEFER
  - ERRDEFER
  - LABELED_LOOP
  - STATIC_FOR
  - COMPTIME
  - RECEIVE
  - BIND
  - LAZY_VAL_DECL
  - ASM_ASSERT
  - GPU_LAUNCH
  - CONTRACT_IN
  - CONTRACT_INVARIANT
  - CONTRACT_OUT
  - CONTRACT_OUT_ERR
  - CONTRACT_DECREASES
  - CONTRACT_PROOF_USES

transition:
  from: FlatStmtKind.EXPR
  to: "StmtKind.Expr"
  state: "Implemented"
  reason: "(flat tag 1) Dedicated dispatch arm in convert_flat_stmt maps this tag onto the same-named parser-AST statement."
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_stmt_transition_census_spec.spl"

transition:
  from: FlatStmtKind.VAL_DECL
  to: "StmtKind.Val"
  state: "Implemented"
  reason: "(flat tag 2) Dedicated dispatch arm in convert_flat_stmt maps this tag onto the same-named parser-AST statement."
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_stmt_transition_census_spec.spl"

transition:
  from: FlatStmtKind.VAR_DECL
  to: "StmtKind.Var"
  state: "Implemented"
  reason: "(flat tag 3) Dedicated dispatch arm in convert_flat_stmt maps this tag onto the same-named parser-AST statement."
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_stmt_transition_census_spec.spl"

transition:
  from: FlatStmtKind.ASSIGN
  to: "StmtKind.Assign"
  state: "Implemented"
  reason: "(flat tag 4) Dedicated dispatch arm in convert_flat_stmt maps this tag onto the same-named parser-AST statement."
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_stmt_transition_census_spec.spl"

transition:
  from: FlatStmtKind.RETURN
  to: "StmtKind.Return"
  state: "Implemented"
  reason: "(flat tag 5) Dedicated dispatch arm in convert_flat_stmt maps this tag onto the same-named parser-AST statement."
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_stmt_transition_census_spec.spl"

transition:
  from: FlatStmtKind.IF
  to: "StmtKind.If"
  state: "Implemented"
  reason: "(flat tag 6) Dedicated dispatch arm in convert_flat_stmt maps this tag onto the same-named parser-AST statement. The STMT_IF wire value 6 is inlined rather than imported, for Stage-3 bootstrap reasons; the chain walker is convert_flat_if_stmt."
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_stmt_transition_census_spec.spl"

transition:
  from: FlatStmtKind.FOR
  to: "StmtKind.For"
  state: "Implemented"
  reason: "(flat tag 7) Dedicated dispatch arm in convert_flat_stmt maps this tag onto the same-named parser-AST statement."
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_stmt_transition_census_spec.spl"

transition:
  from: FlatStmtKind.WHILE
  to: "StmtKind.While"
  state: "Implemented"
  reason: "(flat tag 8) Dedicated dispatch arm in convert_flat_stmt maps this tag onto the same-named parser-AST statement."
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_stmt_transition_census_spec.spl"

transition:
  from: FlatStmtKind.MATCH
  to: "StmtKind.Expr(ExprKind.MatchCase)"
  state: "Normalized(StmtKind.Expr)"
  reason: "(flat tag 9) StmtKind has no Match variant; a match statement is wrapped as an expression statement."
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_stmt_transition_census_spec.spl"

transition:
  from: FlatStmtKind.BLOCK
  to: "StmtKind.Expr(ExprKind.Block)"
  state: "Normalized(StmtKind.Expr)"
  reason: "(flat tag 10) StmtKind has no Block variant; a block statement is wrapped as an expression statement."
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_stmt_transition_census_spec.spl"

transition:
  from: FlatStmtKind.BREAK
  to: "StmtKind.Break"
  state: "Implemented"
  reason: "(flat tag 11) Dedicated dispatch arm in convert_flat_stmt maps this tag onto the same-named parser-AST statement."
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_stmt_transition_census_spec.spl"

transition:
  from: FlatStmtKind.CONTINUE
  to: "StmtKind.Continue"
  state: "Implemented"
  reason: "(flat tag 12) Dedicated dispatch arm in convert_flat_stmt maps this tag onto the same-named parser-AST statement."
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_stmt_transition_census_spec.spl"

transition:
  from: FlatStmtKind.COMPOUND_ASSIGN
  to: "StmtKind.Expr(ExprKind.NilLit) + parser_error(loud fallback)"
  state: "Unsupported(no-dispatch-arm-loud-fallback, doc/08_tracking/bug/spawn_call_expr_silently_becomes_nillit_2026-07-29.md)"
  reason: "(flat tag 13) No arm in convert_flat_stmt; a statement-position compound assignment reaches the loud generic fallback. (EXPR_COMPOUND_ASSIGN in expression position IS handled.)"
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_stmt_unsupported_loud_spec.spl"

transition:
  from: FlatStmtKind.DEFER
  to: "StmtKind list rewrite in convert_flat_stmt_in_list"
  state: "Normalized(StmtKind list rewrite in convert_flat_stmt_in_list)"
  reason: "(flat tag 14) defer is not a node-for-node mapping: convert_flat_stmt_in_list rewrites the enclosing statement LIST so the deferred body runs at scope exit. Reaching convert_flat_stmt directly yields defer_unsupported_marker, which refuses loudly rather than dropping the defer."
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_stmt_transition_census_spec.spl"

transition:
  from: FlatStmtKind.ERRDEFER
  to: "StmtKind list rewrite in convert_flat_stmt_in_list"
  state: "Normalized(StmtKind list rewrite in convert_flat_stmt_in_list)"
  reason: "(flat tag 15) Same list-rewriting treatment as STMT_DEFER; the direct-call path yields defer_unsupported_marker."
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_stmt_transition_census_spec.spl"

transition:
  from: FlatStmtKind.LABELED_LOOP
  to: "StmtKind.Expr(ExprKind.NilLit) + parser_error(loud fallback)"
  state: "Unsupported(no-dispatch-arm-loud-fallback, doc/08_tracking/bug/spawn_call_expr_silently_becomes_nillit_2026-07-29.md)"
  reason: "(flat tag 16) No arm in convert_flat_stmt; a labelled loop reaches the loud generic fallback and its whole body is dropped."
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_stmt_unsupported_loud_spec.spl"

transition:
  from: FlatStmtKind.STATIC_FOR
  to: "StmtKind.Expr(ExprKind.NilLit) + parser_error(loud fallback)"
  state: "Unsupported(no-dispatch-arm-loud-fallback, doc/08_tracking/bug/spawn_call_expr_silently_becomes_nillit_2026-07-29.md)"
  reason: "(flat tag 17) No arm in convert_flat_stmt; `static for` reaches the loud generic fallback. Compile-time unrolling is a semantic decision, not a mechanical mapping."
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_stmt_unsupported_loud_spec.spl"

transition:
  from: FlatStmtKind.COMPTIME
  to: "StmtKind.Expr(ExprKind.NilLit) + parser_error(loud fallback)"
  state: "Unsupported(no-dispatch-arm-loud-fallback, doc/08_tracking/bug/spawn_call_expr_silently_becomes_nillit_2026-07-29.md)"
  reason: "(flat tag 18) No arm in convert_flat_stmt; a `comptime` block reaches the loud generic fallback."
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_stmt_unsupported_loud_spec.spl"

transition:
  from: FlatStmtKind.RECEIVE
  to: "StmtKind.Expr(ExprKind.NilLit) + parser_error(loud fallback)"
  state: "Unsupported(no-dispatch-arm-loud-fallback, doc/08_tracking/bug/spawn_call_expr_silently_becomes_nillit_2026-07-29.md)"
  reason: "(flat tag 19) No arm in convert_flat_stmt; an actor `receive` block reaches the loud generic fallback."
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_stmt_unsupported_loud_spec.spl"

transition:
  from: FlatStmtKind.BIND
  to: "StmtKind.Expr(ExprKind.NilLit) + parser_error(loud fallback)"
  state: "Unsupported(no-dispatch-arm-loud-fallback, doc/08_tracking/bug/spawn_call_expr_silently_becomes_nillit_2026-07-29.md)"
  reason: "(flat tag 20) No arm in convert_flat_stmt; a `bind` statement reaches the loud generic fallback."
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_stmt_unsupported_loud_spec.spl"

transition:
  from: FlatStmtKind.LAZY_VAL_DECL
  to: "StmtKind.Expr(ExprKind.NilLit) + parser_error(loud fallback)"
  state: "Unsupported(no-dispatch-arm-loud-fallback, doc/08_tracking/bug/spawn_call_expr_silently_becomes_nillit_2026-07-29.md)"
  reason: "(flat tag 21) No arm in convert_flat_stmt; a lazy val declaration reaches the loud generic fallback."
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_stmt_unsupported_loud_spec.spl"

transition:
  from: FlatStmtKind.ASM_ASSERT
  to: "StmtKind.Expr(ExprKind.NilLit) + parser_error(loud fallback)"
  state: "Unsupported(no-dispatch-arm-loud-fallback, doc/08_tracking/bug/spawn_call_expr_silently_becomes_nillit_2026-07-29.md)"
  reason: "(flat tag 22) No arm in convert_flat_stmt; `asm assert` reaches the loud generic fallback. (EXPR_ASM and EXPR_ASM_MATCH in expression position ARE handled.)"
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_stmt_unsupported_loud_spec.spl"

transition:
  from: FlatStmtKind.GPU_LAUNCH
  to: "StmtKind.Expr(ExprKind.NilLit) + parser_error(loud fallback)"
  state: "Unsupported(arm-is-a-no-op-now-loud, doc/08_tracking/bug/spawn_call_expr_silently_becomes_nillit_2026-07-29.md)"
  reason: "(flat tag 23) convert_flat_stmt HAS an arm for this tag, but the arm discards the launch config and the kernel call and returns a bare NilLit -- the generic catch-all's behaviour wearing a dedicated arm's clothes, so the loud fallback never saw it. Lane C2 added flat_bridge_report_unhandled_node to the arm. The real GPU-launch conversion lives in module_assembly.spl; a launch reaching this function did not route through it."
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_stmt_unsupported_loud_spec.spl"

transition:
  from: FlatStmtKind.CONTRACT_IN
  to: "ParserFunction.contract requires"
  state: "Normalized(ParserFunction.contract requires)"
  reason: "(flat tag 24) Contract clauses are not converted as statements at all: convert_decl_fn lifts them off the body into the function's contract before conversion."
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_stmt_transition_census_spec.spl"

transition:
  from: FlatStmtKind.CONTRACT_INVARIANT
  to: "ParserFunction.contract invariants"
  state: "Normalized(ParserFunction.contract invariants)"
  reason: "(flat tag 25) Lifted off the body by convert_decl_fn, as with the other contract clauses."
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_stmt_transition_census_spec.spl"

transition:
  from: FlatStmtKind.CONTRACT_OUT
  to: "ParserFunction.contract ensures"
  state: "Normalized(ParserFunction.contract ensures)"
  reason: "(flat tag 26) Lifted off the body by convert_decl_fn, as with the other contract clauses."
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_stmt_transition_census_spec.spl"

transition:
  from: FlatStmtKind.CONTRACT_OUT_ERR
  to: "ParserFunction.contract ensures_err"
  state: "Normalized(ParserFunction.contract ensures_err)"
  reason: "(flat tag 27) Lifted off the body by convert_decl_fn, as with the other contract clauses."
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_stmt_transition_census_spec.spl"

transition:
  from: FlatStmtKind.CONTRACT_DECREASES
  to: "ParserFunction.contract decreases"
  state: "Normalized(ParserFunction.contract decreases)"
  reason: "(flat tag 28) Lifted off the body by convert_decl_fn, as with the other contract clauses."
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_stmt_transition_census_spec.spl"

transition:
  from: FlatStmtKind.CONTRACT_PROOF_USES
  to: "ParserFunction.contract proof_uses"
  state: "Normalized(ParserFunction.contract proof_uses)"
  reason: "(flat tag 29) Lifted off the body by convert_decl_fn, as with the other contract clauses."
  test: "test/01_unit/compiler/frontend/flat_bridge_coverage/flat_stmt_transition_census_spec.spl"
