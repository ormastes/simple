#!/bin/sh
# check-vulkan-2d-bit-diff.shs — byte-for-byte pixel diff, Simple vs the C
# Vulkan reference.
#
# THE CONTRACT
#   Both legs render the SHARED scene table (test/05_perf/bench/vulkan_2d_c/scenes.txt),
#   dump the raw framebuffer via VK2D_DUMP_FB, and this script compares the
#   two dumps byte for byte. Unlike the throughput gate, a difference here is
#   a RENDERING defect, not a performance one.
#
#   The shared table is load-bearing: when each leg generated its own rect set
#   the two rendered different pictures (60.1% vs 63.9% coverage), and no
#   pixel comparison was meaningful. A missing table is an ERROR here, never a
#   pass.
#
# VERDICT (last line of stdout)
#   PASS  — <n> bytes compared, 0 differing
#   FAIL  — <n> bytes compared, <k> differing (first at byte <o>)
#   ERROR — nothing was compared (<reason>)
#
# A run that compared 0 bytes is ERROR, never a pass: absence of a dump is
# absence of evidence. Missing toolchain (no clang, no MoltenVK ICD, no vulkan
# seed binary) is ERROR for the same reason — this gate has no skip tier,
# because "we could not look" must never read as "the pixels match".
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
BENCH="$ROOT/test/05_perf/bench/vulkan_2d_c"
OUT="$ROOT/build/vulkan-2d-bit-diff"
W=${VK2D_W:-800}
H=${VK2D_H:-600}
RECTS=${VK2D_RECTS:-64}
SEED="$ROOT/src/compiler_rust/target/vulkan/release/simple"
ICD=${VK_ICD_FILENAMES:-/opt/homebrew/etc/vulkan/icd.d/MoltenVK_icd.json}
# The Simple leg intermittently SIGBUSes under MoltenVK (tracked in
# doc/08_tracking/bug/vulkan_engine2d_sequential_frames_flaky_moltenvk_2026-09-02.md).
# Retry a bounded number of times and REPORT the attempt count, so a flaky
# run is visible rather than silently smoothed away.
ATTEMPTS=${VK2D_ATTEMPTS:-4}

err() { echo "ERROR — nothing was compared ($1)"; exit 2; }

[ -f "$BENCH/scenes.txt" ] || err "no shared scene table at test/05_perf/bench/vulkan_2d_c/scenes.txt"
[ -x "$SEED" ] || err "no vulkan seed binary at $SEED"
[ -f "$ICD" ] || err "no MoltenVK ICD at $ICD"
command -v clang >/dev/null 2>&1 || err "no clang to build the C reference"
command -v glslangValidator >/dev/null 2>&1 || err "no glslangValidator for the compute kernel"

mkdir -p "$OUT"
C_FB="$OUT/c.bin"
S_FB="$OUT/simple.bin"
rm -f "$C_FB" "$S_FB"

( cd "$BENCH" && glslangValidator -V rect.comp.glsl -o rect.spv >/dev/null 2>&1 ) || err "shader compile failed"
( cd "$BENCH" && clang -std=c99 -O2 vk2d_bench.c -I/opt/homebrew/include \
    -L/opt/homebrew/lib -lvulkan -o vk2d_bench >/dev/null 2>&1 ) || err "C reference build failed"

( cd "$BENCH" && VK2D_DUMP_FB="$C_FB" VK_ICD_FILENAMES="$ICD" \
    ./vk2d_bench "$W" "$H" "$RECTS" 1 1 >/dev/null 2>&1 ) || true
[ -s "$C_FB" ] || err "C leg produced no framebuffer dump"

s_attempt=0
while [ "$s_attempt" -lt "$ATTEMPTS" ]; do
    s_attempt=$((s_attempt + 1))
    ( cd "$ROOT" && SIMPLE_RUST_SEED_WARNING=0 SIMPLE_LIB=src \
        VK_ICD_FILENAMES="$ICD" VK2D_W="$W" VK2D_H="$H" VK2D_RECTS="$RECTS" \
        VK2D_FRAMES=1 VK2D_DUMP_FB="$S_FB" \
        "$SEED" run test/05_perf/bench/vulkan_2d_c/vk2d_bench.spl >/dev/null 2>&1 ) || true
    [ -s "$S_FB" ] && break
done
[ -s "$S_FB" ] || err "Simple leg produced no framebuffer dump after $ATTEMPTS attempt(s)"

c_size=$(wc -c < "$C_FB" | tr -d ' ')
s_size=$(wc -c < "$S_FB" | tr -d ' ')
[ "$c_size" -gt 0 ] || err "C dump is empty"
if [ "$c_size" -ne "$s_size" ]; then
    echo "FAIL — dumps differ in SIZE: C $c_size bytes, Simple $s_size bytes"
    exit 1
fi

# cmp's exit status is read directly, never through a pipe: a pipeline's $? is
# the last command's status and has produced false greens in this repo before.
cmp -s "$C_FB" "$S_FB"
cmp_rc=$?
if [ "$cmp_rc" -eq 0 ]; then
    echo "simple_attempts=$s_attempt"
    echo "PASS — $c_size bytes compared, 0 differing (${W}x${H}, $RECTS rects, shared scene table)"
    exit 0
fi

differing=$(cmp -l "$C_FB" "$S_FB" 2>/dev/null | wc -l | tr -d ' ')
# GNU cmp says "byte N", BSD/macOS cmp says "char N". Accept both rather than
# printing an empty offset, which is how a FAIL message becomes unactionable.
first=$(cmp "$C_FB" "$S_FB" 2>&1 | sed -n 's/.*[bc][yh][ta][er] \([0-9]*\).*/\1/p' | head -1)
px=""
if [ -n "$first" ]; then
    px=$(( (first - 1) / 4 ))
    px=" = pixel $px (x=$(( px % W )), y=$(( px / W )))"
fi
echo "simple_attempts=$s_attempt"
echo "FAIL — $c_size bytes compared, $differing differing (first at byte ${first:-unknown}${px})"
exit 1
