#!/bin/sh
# Fail-closed Stage-4 branch-coverage and ABI gate for Cortex-M access policy.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
SIMPLE_BIN=${SIMPLE_BIN:-$ROOT/bin/simple}
CC_BIN=${CC:-clang}
NM_BIN=${NM:-nm}
POLICY_REL=src/os/kernel/arch/cortex_m33/access_policy.spl
POLICY=$ROOT/$POLICY_REL
HEADER=$ROOT/src/os/kernel/arch/cortex_m33/access_policy.h
PIN=$ROOT/test/fixture/os/cortex_m_access_policy_coverage_pin.env
PROBE=$ROOT/test/fixture/os/cortex_m33_access_policy_probe.spl
ORACLE=$ROOT/test/fixture/os/cortex_m33_access_policy_oracle.c
ABI_HARNESS=$ROOT/test/fixture/os/cortex_m_access_policy_c_abi.c
EVIDENCE_DIR=$ROOT/build/coverage/cortex-m-access-policy
SCRATCH=$(mktemp -d "${TMPDIR:-/tmp}/cortex-m-access-policy.XXXXXX")
trap 'rm -r -- "$SCRATCH"' EXIT HUP INT TERM

fail() {
    echo "FAIL cortex-m-access-policy: $*" >&2
    exit 1
}

blocked() {
    echo "BLOCKED cortex-m-access-policy: $*" >&2
    exit 2
}

pin_value() {
    sed -n "s/^$1=//p" "$PIN"
}

hash_file() {
    sha256sum "$1" | awk '{print $1}'
}

sh "$ROOT/scripts/check/check-cortex-m-access-policy-source-contract.shs" || \
    fail source-contract

[ -x "$SIMPLE_BIN" ] || blocked missing-compiler
BOOTSTRAP_STAGE3_FACADE_PATH=$ROOT/scripts/check/lib/bootstrap-stage3-provenance.shs
STAGE4_PROVENANCE_HELPER_PATH=$ROOT/scripts/check/lib/stage4-candidate-provenance.shs
export BOOTSTRAP_STAGE3_FACADE_PATH STAGE4_PROVENANCE_HELPER_PATH
. "$BOOTSTRAP_STAGE3_FACADE_PATH"
. "$STAGE4_PROVENANCE_HELPER_PATH"
SIMPLE_CANONICAL=$(bootstrap_stage3_canonical_file "$SIMPLE_BIN") || blocked compiler-canonicalization
SIMPLE_PROVENANCE=${SIMPLE_PROVENANCE:-${SIMPLE_CANONICAL}.provenance.env}
stage4_verify_candidate_provenance "$SIMPLE_PROVENANCE" "$SIMPLE_CANONICAL" "$ROOT" || \
    blocked admitted-current-tree-stage4-required
case $($SIMPLE_CANONICAL --version 2>&1 || true) in
    *"Rust-built Simple binary is a bootstrap seed"*) blocked rust-seed-is-diagnostic-only ;;
esac

for tool in "$CC_BIN" "$NM_BIN" sha256sum diff grep awk llvm-nm; do
    command -v "$tool" >/dev/null 2>&1 || blocked "required-tool:$tool"
done

"$CC_BIN" -std=c11 -O2 -Wall -Wextra -Werror -Wpedantic "$ORACLE" \
    -o "$SCRATCH/c-oracle"
"$SCRATCH/c-oracle" >"$SCRATCH/c.out"
(cd "$ROOT" && "$SIMPLE_CANONICAL" run "$PROBE") \
    >"$SCRATCH/simple.out" 2>"$SCRATCH/simple.log"
diff -u "$SCRATCH/c.out" "$SCRATCH/simple.out" || fail semantic-parity

SIMPLE_COVERAGE=1 SIMPLE_COVERAGE_OUTPUT="$SCRATCH/coverage.sdn" \
    "$SIMPLE_CANONICAL" run "$PROBE" \
    >"$SCRATCH/coverage-probe.out" 2>"$SCRATCH/coverage-probe.log"
[ -s "$SCRATCH/coverage.sdn" ] || fail compiler-runtime-coverage-artifact-missing
grep -n -o 'CORTEX-M-ACCESS-D[0-9][0-9]' "$POLICY" >"$SCRATCH/decision-ids.txt"
: >"$SCRATCH/decision-execution.tsv"
while IFS=: read -r line decision_id; do
    awk -F', *' -v owner="/$POLICY_REL" -v wanted="$line" -v id="$decision_id" '
        index($2, owner) == length($2) - length(owner) + 1 && ($3 + 0) == wanted {
            print id "\t" ($3 + 0) "\t" ($4 + 0) "\t" (($5 + 0) > 0 ? 1 : 0) "\t" (($6 + 0) > 0 ? 1 : 0)
        }
    ' "$SCRATCH/coverage.sdn" >"$SCRATCH/one-decision.tsv"
    [ "$(wc -l <"$SCRATCH/one-decision.tsv" | tr -d ' ')" = 1 ] || \
        fail "coverage-row-missing-or-duplicate:$decision_id"
    cat "$SCRATCH/one-decision.tsv" >>"$SCRATCH/decision-execution.tsv"
done <"$SCRATCH/decision-ids.txt"
DECISION_SITES=$(wc -l <"$SCRATCH/decision-execution.tsv" | tr -d ' ')
BRANCH_COVERED=$(awk -F '\t' '{ covered += $4 + $5 } END { print covered + 0 }' \
    "$SCRATCH/decision-execution.tsv")
BRANCH_TOTAL=$(pin_value branch_outcomes_total)
[ "$DECISION_SITES" = "$(pin_value decision_sites)" ] || fail decision-site-total
[ "$BRANCH_COVERED" = "$BRANCH_TOTAL" ] || \
    fail "branch-outcomes-incomplete:$BRANCH_COVERED/$BRANCH_TOTAL"

HOST_OBJ=$SCRATCH/access-policy-host.o
(cd "$ROOT" && "$SIMPLE_CANONICAL" native-build --backend llvm \
    --source src/os/kernel/arch/cortex_m33 --entry "$POLICY_REL" --entry-closure \
    --target x86_64-unknown-linux-gnu --emit-object --cache-dir "$SCRATCH/cache-host" \
    -o "$HOST_OBJ") >"$SCRATCH/host-object.log" 2>&1 || fail host-object-build
[ -s "$HOST_OBJ" ] || fail host-object-missing
EXPECTED_GLOBALS='_cortex_m_in_region
_cortex_m_policy_receipt
cortex_m_policy_read_receipt
cortex_m_policy_receipt_decision_mask
cortex_m_policy_receipt_outcome
cortex_m_policy_write_receipt'
OBSERVED_GLOBALS=$("$NM_BIN" --defined-only --extern-only --format=posix "$HOST_OBJ" |
    awk '{print $1}' | LC_ALL=C sort)
[ "$OBSERVED_GLOBALS" = "$EXPECTED_GLOBALS" ] || fail host-object-global-set
HOST_UNDEFINED=$("$NM_BIN" --undefined-only --format=posix "$HOST_OBJ" |
    awk '{print $1}' | LC_ALL=C sort)
[ -z "$HOST_UNDEFINED" ] || fail "host-object-undefined:$HOST_UNDEFINED"
"$CC_BIN" -std=c11 -O2 -Wall -Wextra -Werror -Wpedantic \
    -I "$ROOT/src/os/kernel/arch/cortex_m33" "$ABI_HARNESS" "$HOST_OBJ" \
    -o "$SCRATCH/c-abi"
"$SCRATCH/c-abi" >"$SCRATCH/c-abi.out" || fail c-abi-call
grep -F 'status=PASS c_abi_exports=2 scalar_u32=true cases=6' \
    "$SCRATCH/c-abi.out" >/dev/null || fail c-abi-receipt

build_object() {
    target=$1
    output=$2
    cache=$3
    (cd "$ROOT" && "$SIMPLE_CANONICAL" native-build --backend llvm \
        --source src/os/kernel/arch/cortex_m33 --entry "$POLICY_REL" --entry-closure \
        --target "$target" --emit-object --cache-dir "$cache" -o "$output") || \
        fail "target-object-build:$target"
}

V8_OBJ=$SCRATCH/access-policy-v8m.o
V7_OBJ=$SCRATCH/access-policy-v7em.o
build_object thumbv8m.main-none-eabi "$V8_OBJ" "$SCRATCH/cache-v8"
build_object thumbv7em-none-eabi "$V7_OBJ" "$SCRATCH/cache-v7"
sh "$ROOT/scripts/check/check-cortex-m-policy-object.shs" an505 "$V8_OBJ"
sh "$ROOT/scripts/check/check-cortex-m-policy-object.shs" stm32u585 "$V8_OBJ"
sh "$ROOT/scripts/check/check-cortex-m-policy-object.shs" ra4m1 "$V7_OBJ"

mkdir -p "$EVIDENCE_DIR"
cp "$SCRATCH/decision-execution.tsv" "$EVIDENCE_DIR/decision-execution.tsv"
cp "$SCRATCH/coverage.sdn" "$EVIDENCE_DIR/coverage.sdn"
RECEIPT=$EVIDENCE_DIR/receipt.sdn
{
    echo schema=cortex-m-access-policy-evidence/v1
    echo status=pass
    echo compiler_path="$SIMPLE_CANONICAL"
    echo compiler_sha256="$(hash_file "$SIMPLE_CANONICAL")"
    echo compiler_provenance="$SIMPLE_PROVENANCE"
    echo owner_source="$POLICY_REL"
    echo owner_source_sha256="$(hash_file "$POLICY")"
    echo abi_header_sha256="$(hash_file "$HEADER")"
    echo decision_ids_sha256="$(pin_value decision_ids_sha256)"
    echo decision_execution_sha256="$(hash_file "$SCRATCH/decision-execution.tsv")"
    echo decision_sites="$DECISION_SITES"
    echo branch_outcomes_covered="$BRANCH_COVERED"
    echo branch_outcomes_total="$BRANCH_TOTAL"
    echo semantic_matrix_rows=39
    echo semantic_outcomes=78
    echo c_abi_exports=2
    echo object_globals=6
    echo arm_objects=an505,stm32u585,ra4m1
    echo physical_board_evidence=not-included
} >"$RECEIPT"

echo "cortex_m_access_policy status=PASS branch_outcomes=$BRANCH_COVERED/$BRANCH_TOTAL c_abi=2/2 objects=3/3 physical_boards=not-included receipt=$RECEIPT"
