#!/bin/sh
# Executable fixture for the aggregate parity checker. No GPU process is run.
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)"
cd "$ROOT_DIR"
MODE="${1:-full}"

FIXTURE_DIR="$(mktemp -d "${TMPDIR:-/tmp}/simple-macos-2d-parity.XXXXXX")"
trap 'rm -rf -- "$FIXTURE_DIR"' EXIT HUP INT TERM

PIXEL_SHA256="8cdc25affa8f5596abad0771e21fb098e26a1d786de961d96b6510915a386899"
REPO_REVISION="bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
SCENE_FINGERPRINT="cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
WINIT_SHA256="eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"
RUNTIME_SHA256="ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
RUNTIME_C_SHA256="1111111111111111111111111111111111111111111111111111111111111111"

write_lane() {
    backend="$1"
    status_key="$2"
    source_revision="$3"
    ppm_path="$FIXTURE_DIR/$backend.ppm"
    env_path="$FIXTURE_DIR/$backend.env"
    printf 'P6\n2 1\n255\nABCDE\n' >"$ppm_path"
    {
        echo "$status_key=pass"
        echo "macos_${backend}_2d_live_font_identity=fixture-font"
        echo "macos_${backend}_2d_live_font_expected_identity=fixture-font"
        echo "backend=$backend"
        echo "target=macos-host"
        echo "width=2"
        echo "height=1"
        echo "dpi=300"
        echo "pixel_sha256=$PIXEL_SHA256"
        echo "non_background_bounds=0,0,2,1"
        echo "event_sequence=focus,pointer_move,pointer_down,pointer_up,key_down,key_up"
        echo "event_count=6"
        echo "capture_path=$ppm_path"
        echo "source_revision=$source_revision"
        echo "repo_revision=$REPO_REVISION"
        echo "shared_scene_fingerprint=$SCENE_FINGERPRINT"
        echo "draw_ir_composition_id=macos-gpu-2d-frozen-composition-v1"
        echo "draw_ir_scene_key=macos-gpu-2d-frozen-scene-v1"
        echo "draw_ir_rendered_commands=5"
        echo "draw_ir_skipped_commands=0"
        echo "draw_ir_readback_checksum=123"
        echo "semantic_event=focus"
        echo "semantic_before_focus=macos-gpu-2d-root"
        echo "semantic_after_focus=macos-gpu-2d-action"
        echo "semantic_before_accent=100"
        echo "semantic_after_accent=200"
        echo "semantic_changed=true"
        echo "semantic_native_focus_reduced=true"
        echo "semantic_raw_winit_reduced=true"
        echo "semantic_pointer_key_delivery=observed"
        echo "semantic_correlation=native-focus-reduced;pointer-key-delivery-observed"
        echo "font_point_size=24"
        echo "font_dpi=300"
        echo "font_pixel_size=100"
        echo "winit_provider_sha256=$WINIT_SHA256"
        echo "simple_runtime_provider_sha256=$RUNTIME_SHA256"
        echo "simple_runtime_c_provider_sha256=$RUNTIME_C_SHA256"
    } >"$env_path"
}

value_of() {
    key="$1"
    path="$2"
    awk -v key="$key" 'index($0, key "=") == 1 {
        print substr($0, length(key) + 2)
    }' "$path"
}

write_lane vulkan macos_vulkan_2d_live_status \
    aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
write_lane metal macos_metal_2d_live_status \
    dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd

if [ "$MODE" = "--alias-only" ]; then
    before_sha256="$(shasum -a 256 "$FIXTURE_DIR/vulkan.env" | awk '{print $1}')"
    if scripts/check/check-macos-vulkan-metal-2d-parity-evidence.shs \
            "$FIXTURE_DIR/vulkan.env" "$FIXTURE_DIR/metal.env" \
            "$FIXTURE_DIR/vulkan.env" >"$FIXTURE_DIR/alias.out" \
            2>"$FIXTURE_DIR/alias.err"; then
        echo "aliased output unexpectedly passed" >&2
        exit 1
    fi
    after_sha256="$(shasum -a 256 "$FIXTURE_DIR/vulkan.env" | awk '{print $1}')"
    [ "$before_sha256" = "$after_sha256" ]
    grep -Fq "(output-aliases-vulkan-evidence)" "$FIXTURE_DIR/alias.err"
    echo "alias_status=fail"
    echo "alias_reason=output-aliases-vulkan-evidence"
    echo "input_preserved=true"
    exit 0
fi

if [ "$MODE" = "--hardlink-alias-only" ]; then
    hardlink_output="$FIXTURE_DIR/hardlink-result.env"
    ln "$FIXTURE_DIR/vulkan.env" "$hardlink_output"
    before_sha256="$(shasum -a 256 "$FIXTURE_DIR/vulkan.env" | awk '{print $1}')"
    if scripts/check/check-macos-vulkan-metal-2d-parity-evidence.shs \
            "$FIXTURE_DIR/vulkan.env" "$FIXTURE_DIR/metal.env" \
            "$hardlink_output" >"$FIXTURE_DIR/hardlink-alias.out" \
            2>"$FIXTURE_DIR/hardlink-alias.err"; then
        echo "hard-linked output unexpectedly passed" >&2
        exit 1
    fi
    after_sha256="$(shasum -a 256 "$FIXTURE_DIR/vulkan.env" | awk '{print $1}')"
    output_sha256="$(shasum -a 256 "$hardlink_output" | awk '{print $1}')"
    [ "$before_sha256" = "$after_sha256" ]
    [ "$before_sha256" = "$output_sha256" ]
    grep -Fq "(output-aliases-vulkan-evidence)" \
        "$FIXTURE_DIR/hardlink-alias.err"
    echo "hardlink_alias_status=fail"
    echo "hardlink_alias_reason=output-aliases-vulkan-evidence"
    echo "hardlink_input_preserved=true"
    exit 0
fi

RESULT="$FIXTURE_DIR/result.env"
scripts/check/check-macos-vulkan-metal-2d-parity-evidence.shs \
    "$FIXTURE_DIR/vulkan.env" "$FIXTURE_DIR/metal.env" "$RESULT" >/dev/null
pass_status="$(value_of macos_vulkan_metal_2d_parity_status "$RESULT")"
[ "$pass_status" = pass ]

sed 's/^semantic_after_accent=200$/semantic_after_accent=201/' \
    "$FIXTURE_DIR/metal.env" >"$FIXTURE_DIR/metal-mutated.env"
mv "$FIXTURE_DIR/metal-mutated.env" "$FIXTURE_DIR/metal.env"
if scripts/check/check-macos-vulkan-metal-2d-parity-evidence.shs \
        "$FIXTURE_DIR/vulkan.env" "$FIXTURE_DIR/metal.env" "$RESULT" \
        >/dev/null 2>&1; then
    echo "mutated semantic evidence unexpectedly passed" >&2
    exit 1
fi
fail_status="$(value_of macos_vulkan_metal_2d_parity_status "$RESULT")"
fail_reason="$(value_of macos_vulkan_metal_2d_parity_reason "$RESULT")"
[ "$fail_status" = fail ]
[ "$fail_reason" = semantic-after-accent-mismatch ]

echo "pass_status=$pass_status"
echo "fail_status=$fail_status"
echo "fail_reason=$fail_reason"
