#!/bin/sh
set -eu

src=src/os/kernel/loader/segment_mapper.spl

for owner in rt_arm_stage_elf64_load_image rt_arm64_user_as_map_elf64 rt_arm64_user_as_ttbr0_probe; do
    grep -Fq "fn ${owner}_host_stub(" "$src" || {
        echo "FAIL: missing host-only fallback ${owner}_host_stub" >&2
        exit 1
    }
    if grep -Eq "^fn ${owner}\\(" "$src"; then
        echo "FAIL: same-module fallback shadows strong C owner ${owner}" >&2
        exit 1
    fi
done

if [ "$#" -gt 0 ]; then
    elf=$1
    [ -f "$elf" ] || { echo "FAIL: missing ELF: $elf" >&2; exit 1; }
    symbols=$(llvm-nm "$elf")
    for owner in rt_arm_stage_elf64_load_image rt_arm64_user_as_map_elf64 rt_arm64_user_as_ttbr0_probe; do
        printf '%s\n' "$symbols" | grep -Eq " [Tt] ${owner}$" || {
            echo "FAIL: linked ELF lacks strong C owner ${owner}" >&2
            exit 1
        }
        if printf '%s\n' "$symbols" | grep -Eq "segment_mapper__${owner}$"; then
            echo "FAIL: linked ELF retained shadow owner ${owner}" >&2
            exit 1
        fi
    done
fi

echo 'PASS: ARM64 ELF mapping symbols bind exclusively to strong C owners'
