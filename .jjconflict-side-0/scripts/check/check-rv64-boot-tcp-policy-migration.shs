#!/bin/sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd)
CHECKER=$ROOT_DIR/scripts/check/check-rv64-boot-tcp-policy-migration.shs
EVIDENCE_HELPER=$ROOT_DIR/scripts/check/lib/riscv-hal-migration-evidence.shs
[ -f "$EVIDENCE_HELPER" ] || { echo "rv64_boot_tcp_policy_migration status=FAIL reason=evidence-helper-missing" >&2; exit 1; }
. "$EVIDENCE_HELPER"
HAL_MIGRATION_LANE=rv64_boot_tcp_policy
hal_migration_parse_admission "$@"
hal_migration_require_stage4 "$ROOT_DIR"
SIMPLE_BIN=$HAL_MIGRATION_SIMPLE_BIN
hal_migration_bind_target_runtime stage4-embedded-runtime "$SIMPLE_BIN"
CC_BIN=${CC:-cc}
ORACLE_SRC=$ROOT_DIR/test/02_integration/os/kernel/arch/riscv64/rv64_boot_tcp_policy_c_oracle.c
SIMPLE_PROBE=$ROOT_DIR/test/fixtures/os/rv64_boot_tcp_policy_oracle_probe.spl
SPEC=$ROOT_DIR/test/01_unit/os/kernel/arch/riscv64_boot_tcp_policy_spec.spl
POLICY_REL=src/os/kernel/arch/riscv64/boot_tcp_policy.spl
RUNTIME_C=$ROOT_DIR/src/os/kernel/arch/riscv64/boot/freestanding_runtime.c

TMP_DIR=$(mktemp -d "${TMPDIR:-/tmp}/rv64-boot-tcp-policy.XXXXXX")
trap 'rm -rf "$TMP_DIR"' EXIT HUP INT TERM

CC_BIN=$(hal_migration_resolve_tool "$CC_BIN" cc)
hal_migration_begin_input_freeze "$TMP_DIR/evidence-inputs.tsv"
hal_migration_capture_input evidence_helper "$EVIDENCE_HELPER"
hal_migration_capture_input checker "$CHECKER"
hal_migration_capture_input owner_source "$ROOT_DIR/$POLICY_REL"
hal_migration_capture_input runtime_consumer_source "$RUNTIME_C"
hal_migration_capture_input oracle_source "$ORACLE_SRC"
hal_migration_capture_input simple_probe "$SIMPLE_PROBE"
hal_migration_capture_input focused_spec "$SPEC"
hal_migration_capture_input tool_cc "$CC_BIN"
hal_migration_seal_input_freeze
policy_sha=$(hal_migration_frozen_hash owner_source "$ROOT_DIR/$POLICY_REL")
runtime_consumer_sha=$(hal_migration_frozen_hash runtime_consumer_source "$RUNTIME_C")
oracle_sha=$(hal_migration_frozen_hash oracle_source "$ORACLE_SRC")
probe_sha=$(hal_migration_frozen_hash simple_probe "$SIMPLE_PROBE")
spec_sha=$(hal_migration_frozen_hash focused_spec "$SPEC")

"$CC_BIN" -std=c11 -O2 -Wall -Wextra -Werror "$ORACLE_SRC" -o "$TMP_DIR/c-oracle"
"$TMP_DIR/c-oracle" >"$TMP_DIR/c.out"
"$SIMPLE_BIN" run "$SIMPLE_PROBE" >"$TMP_DIR/simple.out" 2>"$TMP_DIR/simple.log"
diff -u "$TMP_DIR/c.out" "$TMP_DIR/simple.out"

coverage_line=$(tail -n 1 "$TMP_DIR/simple.out")
coverage_mask=$(printf '%s\n' "$coverage_line" | sed -n 's/^coverage mask=\([0-9][0-9]*\) required=\([0-9][0-9]*\)$/\1/p')
coverage_required=$(printf '%s\n' "$coverage_line" | sed -n 's/^coverage mask=\([0-9][0-9]*\) required=\([0-9][0-9]*\)$/\2/p')
[ -n "$coverage_mask" ] && [ "$coverage_mask" = "$coverage_required" ] || {
    echo "rv64_boot_tcp_policy_migration status=FAIL reason=scoped-branch-mask-incomplete mask=${coverage_mask:-missing} required=${coverage_required:-missing}" >&2
    exit 1
}

if grep -F 'RtString *text = rt_as_string(addr);' "$RUNTIME_C" >/dev/null; then
    echo "rv64_boot_tcp_policy_migration status=FAIL reason=address-policy-still-defined-in-c" >&2
    exit 1
fi
grep -F 'selected = rt_riscv64_boot_tcp_select_port(addr);' "$RUNTIME_C" >/dev/null
grep -F 'selected = rt_riscv64_boot_tcp_select_explicit_port(port);' "$RUNTIME_C" >/dev/null
grep -F 'spl_i64 rt_boot_tcp_bind(spl_i64 addr) {' "$RUNTIME_C" >/dev/null
grep -F 'spl_i64 rt_boot_tcp_bind_port(spl_i64 port) {' "$RUNTIME_C" >/dev/null

"$SIMPLE_BIN" test "$SPEC" --no-cache >"$TMP_DIR/spec.log" 2>&1
grep -F 'outcome=OK' "$TMP_DIR/spec.log" >/dev/null

RECEIPT=$(hal_migration_receipt_path "$ROOT_DIR" rv64-boot-tcp-policy)
PAYLOAD=$TMP_DIR/receipt.payload.env
{
    hal_migration_write_common_fields rv64-boot-tcp-policy "$CHECKER"
    printf 'evidence_scope=rv64-boot-tcp-policy\n'
    printf 'owner_source=%s\n' "$POLICY_REL"
    printf 'owner_source_sha256=%s\n' "$policy_sha"
    printf 'runtime_consumer_source=src/os/kernel/arch/riscv64/boot/freestanding_runtime.c\n'
    printf 'runtime_consumer_source_sha256=%s\n' "$runtime_consumer_sha"
    printf 'oracle_source=test/02_integration/os/kernel/arch/riscv64/rv64_boot_tcp_policy_c_oracle.c\n'
    printf 'oracle_source_sha256=%s\n' "$oracle_sha"
    printf 'simple_probe=test/fixtures/os/rv64_boot_tcp_policy_oracle_probe.spl\n'
    printf 'simple_probe_sha256=%s\n' "$probe_sha"
    printf 'focused_spec=test/01_unit/os/kernel/arch/riscv64_boot_tcp_policy_spec.spl\n'
    printf 'focused_spec_sha256=%s\n' "$spec_sha"
    printf 'oracle_output_sha256=%s\n' "$(hal_migration_hash_file "$TMP_DIR/c.out")"
    printf 'simple_output_sha256=%s\n' "$(hal_migration_hash_file "$TMP_DIR/simple.out")"
    printf 'oracle_parity=exact\n'
    printf 'instrumentation=production-branch-mask\n'
    printf 'branch_outcomes_covered=11\n'
    printf 'branch_outcomes_total=11\n'
    printf 'branch_coverage_basis_points=10000\n'
} >"$PAYLOAD"
hal_migration_revalidate_before_receipt "$ROOT_DIR"
hal_migration_revalidate_inputs_before_receipt
hal_migration_publish_receipt "$RECEIPT" "$PAYLOAD"

echo "rv64_boot_tcp_policy_migration status=PASS oracle_parity=exact scope=$POLICY_REL instrumentation=production-branch-mask branch_outcomes=11/11 branch_coverage_basis_points=10000 receipt=$HAL_MIGRATION_RECEIPT_PATH receipt_sha256=$HAL_MIGRATION_RECEIPT_SHA256"
