#!/bin/sh
# check-freestanding-dict-arms-in-every-definition.shs
#
# Every C translation unit in a freestanding arch boot tree that DEFINES one of
# the dict-capable subscript/length entry points must give it a HEAP_DICT arm.
#
# WHY THIS GUARD EXISTS (2026-09-01, riscv64 goal row 1)
# ------------------------------------------------------
# The riscv64 boot tree defines rt_index_get / rt_index_set / rt_len TWICE:
# once in boot/baremetal_stubs.c and once in boot/baremetal_runtime_core.inc.c.
# Both TUs are linked; the DUPLICATED names resolve to baremetal_stubs.c.
#
# A prior session added the dict arm to rt_index_set in the .inc.c copy -- the
# one that LOSES the link -- and row 1 did not move. Measured in-guest under
# real OpenSBI v1.4 fw_payload: the parser's `function_order` ARRAY held 1
# entry while its `functions` DICT held 0, simpleos_dict_store was entered ZERO
# times across the whole boot, and the interpreter correctly reported
# "module has no main function". `nm kernel.elf` then showed rt_index_set
# resolving into baremetal_stubs.c's address range, with rt_dict_set and
# simpleos_dict_store absent from the linked image entirely.
#
# A grep that merely asks "does the tree contain a dict arm somewhere" is
# EXACTLY the check that would have passed throughout that failure. So this
# guard is per-DEFINITION, not per-tree: it finds every definition of each
# guarded function and requires HEAP_DICT inside that function's own body.
# Being definition-scoped is the whole point -- it is what makes fixing only
# the losing copy fail.
#
# Verdict is the LAST line of stdout, same convention as the other guards:
#   PASS  — <n> definition(s) checked, 0 missing a dict arm       exit 0
#   FAIL  — ... naming every offending file:function              exit 1
#   ERROR — nothing was checked (<reason>)                        exit 2
# A run that examined 0 definitions is ERROR, never a pass: absence of a
# definition to check is absence of evidence.
#
# --selftest runs before every real scan and is FATAL, with a must-FAIL fixture
# that replays the incident's exact shape (two TUs, only the non-winning one
# carrying the arm).
set -u

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
SCAN_ROOTS=${SCAN_ROOTS:-"$ROOT/examples/09_embedded/simple_os/arch/riscv64/boot"}
GUARDED_FNS="rt_index_get rt_index_set rt_len"

# Explicitly named exclusions, never a wildcard: a NEW TU in the boot tree is
# covered by default, which is the property that makes this a ratchet.
#
#   ghdl_boot_info_runtime.c — a standalone 462-line GHDL boot-info runtime
#   that does not participate in the SimpleOS kernel link and has no dict type
#   at all (zero occurrences of RuntimeDict / HEAP_DICT / rt_dict_new). It IS a
#   smaller instance of the same one-armed shape, and that is recorded here
#   rather than hidden, but giving it a dict arm would mean inventing a whole
#   dict implementation for a TU that never sees one.
EXCLUDE_FILES=${EXCLUDE_FILES:-"ghdl_boot_info_runtime.c"}

nothing() { printf 'ERROR — nothing was checked (%s)\n' "$1"; exit 2; }

# scan_tree <dir> -> prints "file:fn" for each definition MISSING a dict arm,
# and sets EV_CHECKED to the number of definitions examined.
scan_tree() {
    _dir=$1
    EV_CHECKED=0
    EV_OFFENDERS=
    EV_EXCLUDED=0
    [ -d "$_dir" ] || return 0
    # ONE glob only: `*.c` already matches `*.inc.c`, and globbing both would
    # count every .inc.c definition twice.
    for f in "$_dir"/*.c; do
        [ -f "$f" ] || continue
        _skip=0
        for _x in ${EXCLUDE_FILES:-}; do
            [ "$(basename "$f")" = "$_x" ] && { _skip=1; EV_EXCLUDED=$((EV_EXCLUDED + 1)); break; }
        done
        [ "$_skip" -eq 0 ] || continue
        for fn in $GUARDED_FNS; do
            # A DEFINITION is `<type> <fn>(...)` followed by a `{` line; a bare
            # prototype ends in `;` and is deliberately not counted.
            _start=$(awk -v fn="$fn" '
                $0 ~ ("(^|[^A-Za-z0-9_])" fn "[[:space:]]*\\(") && $0 !~ /;[[:space:]]*$/ { print NR; exit }
            ' "$f")
            [ -n "$_start" ] || continue
            EV_CHECKED=$((EV_CHECKED + 1))
            # Body = from the definition line to the first line that is exactly
            # a closing brace in column 1 (the file style throughout this tree).
            _body=$(awk -v s="$_start" 'NR>=s { print; if (NR>s && /^}/) exit }' "$f")
            case "$_body" in
                *HEAP_DICT*) ;;
                *) EV_OFFENDERS="$EV_OFFENDERS $(basename "$f"):$fn" ;;
            esac
        done
    done
}

selftest() {
    # Fixtures are scanned with the exclusion list EMPTY, so a future exclusion
    # entry can never silently disable a must-FAIL fixture.
    EXCLUDE_FILES_SAVED=${EXCLUDE_FILES:-}
    EXCLUDE_FILES=
    _t=$(mktemp -d) || return 1
    _n=0

    # Fixture 1 (must PASS): the winning TU carries the arm.
    mkdir -p "$_t/ok"
    cat > "$_t/ok/win.c" <<'EOF'
RuntimeValue rt_index_set(RuntimeValue v, RuntimeValue i, RuntimeValue x)
{
    if (IS_HEAP(v)) {
        HeapHeader *h = (HeapHeader *)DECODE_PTR(v);
        if (h && h->type == HEAP_DICT) return simpleos_dict_store(v, i, x);
    }
    return rt_array_set(v, i, x);
}
EOF
    scan_tree "$_t/ok"
    [ "$EV_CHECKED" -eq 1 ] || { echo "selftest: fixture 1 checked $EV_CHECKED, want 1"; rm -rf "$_t"; return 1; }
    [ -z "$EV_OFFENDERS" ] || { echo "selftest: fixture 1 should PASS, got:$EV_OFFENDERS"; rm -rf "$_t"; return 1; }
    _n=$((_n + 1))

    # Fixture 2 (must FAIL): THE INCIDENT. Two TUs, arm only in the loser.
    mkdir -p "$_t/bad"
    cat > "$_t/bad/loser.inc.c" <<'EOF'
RuntimeValue rt_index_set(RuntimeValue v, RuntimeValue i, RuntimeValue x)
{
    if (IS_HEAP(v)) {
        HeapHeader *h = (HeapHeader *)DECODE_PTR(v);
        if (h && h->type == HEAP_DICT) return simpleos_dict_store(v, i, x);
    }
    return rt_array_set(v, i, x);
}
EOF
    cat > "$_t/bad/winner.c" <<'EOF'
RuntimeValue rt_index_set(RuntimeValue v, RuntimeValue i, RuntimeValue x)
{
    if (!IS_INT(i)) return 0;
    return rt_array_set(v, i, x);
}
EOF
    scan_tree "$_t/bad"
    [ "$EV_CHECKED" -eq 2 ] || { echo "selftest: fixture 2 checked $EV_CHECKED, want 2"; rm -rf "$_t"; return 1; }
    case "$EV_OFFENDERS" in
        *winner.c:rt_index_set*) ;;
        *) echo "selftest: fixture 2 must FAIL naming winner.c:rt_index_set, got:$EV_OFFENDERS"; rm -rf "$_t"; return 1 ;;
    esac
    case "$EV_OFFENDERS" in
        *loser.inc.c*) echo "selftest: fixture 2 wrongly flagged the compliant copy"; rm -rf "$_t"; return 1 ;;
    esac
    _n=$((_n + 1))

    # Fixture 3 (must not vacuously pass): a tree with no definitions at all
    # must yield 0 checked, forcing the caller to ERROR.
    mkdir -p "$_t/empty"
    echo '/* nothing here */' > "$_t/empty/none.c"
    scan_tree "$_t/empty"
    [ "$EV_CHECKED" -eq 0 ] || { echo "selftest: fixture 3 checked $EV_CHECKED, want 0"; rm -rf "$_t"; return 1; }
    _n=$((_n + 1))

    # Fixture 4 (must FAIL): a prototype-only mention of HEAP_DICT elsewhere in
    # the file must NOT satisfy the check for the function's own body.
    mkdir -p "$_t/decoy"
    cat > "$_t/decoy/decoy.c" <<'EOF'
/* HEAP_DICT is mentioned in this comment and in an unrelated function. */
RuntimeValue rt_len(RuntimeValue v)
{
    if (!IS_HEAP(v)) return 0;
    return 0;
}
RuntimeValue unrelated(RuntimeValue v)
{
    if (v == HEAP_DICT) return 1;
    return 0;
}
EOF
    scan_tree "$_t/decoy"
    case "$EV_OFFENDERS" in
        *decoy.c:rt_len*) ;;
        *) echo "selftest: fixture 4 must FAIL naming decoy.c:rt_len, got:$EV_OFFENDERS"; rm -rf "$_t"; return 1 ;;
    esac
    _n=$((_n + 1))

    rm -rf "$_t"
    EXCLUDE_FILES=$EXCLUDE_FILES_SAVED
    SELFTEST_N=$_n
    return 0
}

selftest || nothing "selftest failed — the scanner cannot be trusted"
printf 'selftest: %s fixture(s) OK\n' "$SELFTEST_N"

TOTAL=0
EXCLUDED=0
ALL_OFFENDERS=
for d in $SCAN_ROOTS; do
    scan_tree "$d"
    TOTAL=$((TOTAL + EV_CHECKED))
    EXCLUDED=$((EXCLUDED + EV_EXCLUDED))
    ALL_OFFENDERS="$ALL_OFFENDERS$EV_OFFENDERS"
done

[ "$TOTAL" -gt 0 ] || nothing "no definition of $GUARDED_FNS found under $SCAN_ROOTS"

if [ -n "$ALL_OFFENDERS" ]; then
    printf 'FAIL — %s definition(s) checked, missing a HEAP_DICT arm:%s\n' "$TOTAL" "$ALL_OFFENDERS"
    exit 1
fi
printf 'PASS — %s definition(s) checked, 0 missing a dict arm (%s file(s) excluded by name)\n' "$TOTAL" "$EXCLUDED"
exit 0
