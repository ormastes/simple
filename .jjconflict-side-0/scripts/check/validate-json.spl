use std.cli.cli_util (get_cli_args)
use std.nogc_sync_mut.io.file_ops.{file_read}
use lib.json.parser.{json_parse_with_error}

fn main() -> i64:
    val args = get_cli_args()
    if args.len() != 1:
        print "usage: validate-json <file>"
        return 2
    if json_parse_with_error(file_read(args[0])).1 == "": 0 else: 1
