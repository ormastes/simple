# Negative contract: compiled Future.map must fail closed until native generic
# specialization preserves both the generic owner and method result types.

use std.async.future.{Future}

fn increment(value: i64) -> i64:
    value + 1

fn main() -> i64:
    val mapped = Future.from_value(1).map(increment)
    if mapped.is_ready():
        0
    else:
        1
