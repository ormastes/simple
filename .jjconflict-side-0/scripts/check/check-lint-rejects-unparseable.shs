#!/bin/sh
# Prove `bin/simple lint` fails closed on a file that does not parse.
#
# Regression guard for the fail-open defect found 2026-07-28
# (doc/08_tracking/bug/lint_does_not_detect_syntax_errors_2026-07-28.md):
# lint printed "Lint passed: all files clean" and exited 0 on a file the
# compiler rejects outright, because it read the parse-failure flag back from a
# module-level var whose write did not survive the return across the module
# boundary. The fix routes lint through parse_module_silent_checked(), which
# RETURNS the flag.
#
# Both directions are checked — a lint that rejects everything is not a fix:
#   1. an unparseable file must be rejected (PARSE001, non-zero exit)
#   2. a valid file must still lint clean (exit 0)
#
# Usage: sh scripts/check/check-lint-rejects-unparseable.shs
# Exit 0 = lint is a real gate, 1 = fail-open (or false-positive) regression.

set -u

simple="${SIMPLE_BIN:-bin/simple}"
if [ ! -x "$simple" ]; then
    echo "FAIL: $simple not found or not executable" >&2
    exit 1
fi

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

broken="$work/lint_gate_broken.spl"
good="$work/lint_gate_good.spl"

# Malformed parameter list, unbalanced '[', inconsistent indentation.
cat > "$broken" <<'SPL'
fn good() -> i64:
    val x = 1
    x

fn broken( -> i64:
        val y = [1, 2
   y
SPL

cat > "$good" <<'SPL'
fn good() -> i64:
    val x = 1
    x
SPL

status=0

"$simple" lint "$broken" > "$work/broken.out" 2>&1
broken_exit=$?
if [ "$broken_exit" -eq 0 ]; then
    echo "FAIL: lint exited 0 on a file that does not parse (fail-open)" >&2
    tail -5 "$work/broken.out" >&2
    status=1
elif ! grep -q 'PARSE001' "$work/broken.out"; then
    echo "FAIL: lint exited $broken_exit but did not report PARSE001" >&2
    tail -5 "$work/broken.out" >&2
    status=1
else
    echo "ok: unparseable file rejected (PARSE001, exit $broken_exit)"
fi

"$simple" lint "$good" > "$work/good.out" 2>&1
good_exit=$?
if [ "$good_exit" -ne 0 ]; then
    echo "FAIL: lint exited $good_exit on a valid file (false positive)" >&2
    tail -5 "$work/good.out" >&2
    status=1
elif grep -q 'PARSE001' "$work/good.out"; then
    echo "FAIL: lint reported PARSE001 on a valid file" >&2
    status=1
else
    echo "ok: valid file lints clean (exit 0)"
fi

exit "$status"
