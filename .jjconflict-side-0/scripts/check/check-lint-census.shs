#!/bin/sh
# Lint census with a CRASH verdict — score "died without a summary" as its own
# outcome, never as a checked file.
#
# WHY THIS EXISTS
# ---------------------------------------------------------------------------
# `simple lint` can die mid-file. On 2026-08-01, linting
# src/compiler_rust/lib/std/src/tooling/misc_commands.spl on the interpreter
# route printed
#
#     [stmt_get_tag] OOB idx=149 arena_len=79 arena_gen=1 -> -1
#     error: semantic: array index out of bounds: index is 149 but length is 79
#
# and the process ended there: no diagnostics block, no `Found N error(s)`, no
# `Lint passed` / `Lint failed`, and — critically — no NOT-LINTED count. The
# NOT-LINTED reporting landed earlier that day closes the case where lint
# *runs* and cannot parse a file. It cannot close this one, because nothing in
# a dead process gets to report anything.
#
# A sweep that scores by summary lines therefore sees such a file as absent
# rather than as failed, and a sweep that scores by "files that produced no
# complaint" sees it as clean. Both read a crash as success. That is the same
# failure class as a guard that exits 0 from the wrong directory
# (scripts/check/check-no-conflict-tree-push.shs documents one), and as the
# lint census retracted on 2026-08-01 for a vacuous oracle.
#
# So: four verdicts, never three, and never a bucket called "checked".
#
#   LINTED      the file was analysed and lint reported a summary
#   NOT_LINTED  lint ran, could not parse the file, and said so
#   CRASH       the process ended without emitting a summary line
#   TIMEOUT     the process exceeded the per-file budget
#
# CRASH and TIMEOUT are failures of the *instrument*, not verdicts about the
# file. They are counted and named separately precisely so nobody can quote a
# clean census that quietly lost files.
#
# CONTRACT
# ---------------------------------------------------------------------------
#   * One lint process per file. Batching is contraindicated: 200 files in a
#     single process aborted on a stack overflow after 107 files and printed
#     no summary at all, and a 4,363-file process reached 8.9 GB RSS. Both are
#     recorded in doc/08_tracking/bug/lint_parse_failure_silently_skips_file_2026-08-01.md.
#   * Every file in the input list gets exactly one verdict. The run asserts
#     `verdicts == inputs` and ERRORs if they differ, so a harness that dies
#     partway cannot be mistaken for a completed census. An earlier revision of
#     an ad-hoc census harness died on `export -f`, linted zero files and
#     exited 0; only a count assertion caught it.
#   * A partial prefix is not a result. Nothing is published unless the run
#     reaches its verdict line.
#   * Exit 0 only when every file is LINTED or NOT_LINTED. Any CRASH or
#     TIMEOUT exits 1. Any harness fault exits 2.
#   * NOTE ON PIPES: a piped exit status is the LAST command's, so
#     `check-lint-census.shs ... | tail` discards this script's status. Redirect
#     to a FILE and read the file. The verdict line always goes to stdout and
#     always begins with PASS —, FAIL — or ERROR — (repo verdict convention).
#
# NON-VACUITY
# ---------------------------------------------------------------------------
# A count-based check cannot detect selective blindness, so the classifier is
# exercised directly by `--self-test`, which feeds it synthetic lint output for
# all four outcomes and asserts each maps to the expected verdict. It calls the
# SAME `classify_run` the census calls — not a copy — so gutting the classifier
# fails the self-test. Run it before quoting any census:
#
#     sh scripts/check/check-lint-census.shs --self-test
#
# USAGE
# ---------------------------------------------------------------------------
#     sh scripts/check/check-lint-census.shs [options] <path> [<path> ...]
#     sh scripts/check/check-lint-census.shs --self-test
#
#     --timeout <sec>   per-file budget (default 600)
#     --binary <path>   lint binary (default bin/simple)
#     --out <file>      write the per-file verdict table here
#     --jit             route via SIMPLE_EXECUTION_MODE=jit
#
# Paths may be files or directories; directories are searched for *.spl.

set -u

TIMEOUT_SEC=600
BINARY=bin/simple
OUT=
USE_JIT=0
SELF_TEST=0
TARGETS=

die_error() {
    # Verdict convention (.claude/rules/vcs.md): last stdout line is
    # `ERROR — nothing was checked...` on exit 2.
    echo "ERROR — nothing was checked: $1"
    exit 2
}

while [ $# -gt 0 ]; do
    case "$1" in
        --self-test) SELF_TEST=1; shift ;;
        --timeout) [ $# -ge 2 ] || die_error "--timeout needs a value"; TIMEOUT_SEC=$2; shift 2 ;;
        --binary) [ $# -ge 2 ] || die_error "--binary needs a value"; BINARY=$2; shift 2 ;;
        --out) [ $# -ge 2 ] || die_error "--out needs a value"; OUT=$2; shift 2 ;;
        --jit) USE_JIT=1; shift ;;
        -*) die_error "unknown option: $1" ;;
        *) TARGETS="$TARGETS $1"; shift ;;
    esac
done

# ---------------------------------------------------------------------------
# THE CLASSIFIER
#
# The single place a run is turned into a verdict. Both the census and
# --self-test call this, so the self-test cannot pass while this is broken.
#
#   $1 = exit status of the lint process
#   $2 = path to the file holding that process's combined stdout+stderr
#
# Order matters. TIMEOUT is checked first because `timeout` reports 124 while
# the output may look like an ordinary truncated run. The summary check comes
# before any reading of counts: absence of a summary is decisive on its own,
# whatever the exit status, because a crashed process can still exit 0 in
# principle and a summary-less success is not something to trust.
# ---------------------------------------------------------------------------
classify_run() {
    _rc=$1
    _log=$2

    if [ ! -f "$_log" ]; then
        echo "CRASH"
        return
    fi

    if [ "$_rc" -eq 124 ] || [ "$_rc" -eq 137 ]; then
        echo "TIMEOUT"
        return
    fi

    # A summary line is the proof that lint reached the end of the file.
    # JSON mode emits `"type":"lint-summary"`; text mode emits
    # `Found N error(s)`. Either is sufficient; neither means the process
    # did not finish, which is a CRASH regardless of what it printed first.
    if grep -q '"type":"lint-summary"' "$_log" 2>/dev/null; then
        _has_summary=1
    elif grep -qE 'Found [0-9]+ error\(s\)' "$_log" 2>/dev/null; then
        _has_summary=1
    else
        _has_summary=0
    fi

    if [ "$_has_summary" -eq 0 ]; then
        echo "CRASH"
        return
    fi

    # NOT LINTED is lint's own, deliberate report that it parsed nothing and
    # therefore ran no AST-based lint on the file. It is a real verdict about
    # the file, unlike CRASH, which is a failure of the instrument.
    if grep -q '"type":"lint-not-linted"' "$_log" 2>/dev/null; then
        echo "NOT_LINTED"
        return
    fi
    if grep -q 'NOT LINTED' "$_log" 2>/dev/null; then
        echo "NOT_LINTED"
        return
    fi

    echo "LINTED"
}

# ---------------------------------------------------------------------------
# SELF TEST — prove the classifier is not vacuous before trusting a census.
# ---------------------------------------------------------------------------
if [ "$SELF_TEST" -eq 1 ]; then
    _tmp=$(mktemp -d) || die_error "mktemp failed"
    _fail=0
    _checked=0

    check_case() {
        _name=$1; _rc=$2; _want=$3; _body=$4
        _f="$_tmp/$_name.log"
        printf '%s\n' "$_body" > "$_f"
        _got=$(classify_run "$_rc" "$_f")
        _checked=$((_checked + 1))
        if [ "$_got" = "$_want" ]; then
            echo "  ok    $_name -> $_got"
        else
            echo "  FAIL  $_name -> $_got (expected $_want)"
            _fail=$((_fail + 1))
        fi
    }

    echo "self-test: classify_run"
    check_case clean_json 0 LINTED \
        '{"type":"lint-file-summary","file":"a.spl","errors":0}
{"type":"lint-summary","status":"passed","failed_files":0,"not_linted_files":0}'
    check_case clean_text 0 LINTED \
        'Found 0 error(s), 0 warning(s), 0 auto-fix(es) available

Lint passed: all files clean'
    check_case not_linted_json 1 NOT_LINTED \
        '{"type":"lint-not-linted","file":"a.spl","reason":"parse failure"}
{"type":"lint-summary","status":"failed","failed_files":1,"not_linted_files":1}'
    check_case not_linted_text 1 NOT_LINTED \
        'a.spl:1:0: error[PARSE001]: NOT LINTED: source did not parse - every AST-based lint was skipped for this file
Found 1 error(s), 0 warning(s), 0 auto-fix(es) available
NOT LINTED: 1 file(s) could not be parsed and were never analysed
Lint failed in 1 file(s)'
    # The live reproducer's exact shape: real diagnostics, then death.
    check_case crash_arena_oob 1 CRASH \
        '[stmt_get_tag] OOB idx=149 arena_len=79 arena_gen=1 -> -1
error: semantic: array index out of bounds: index is 149 but length is 79'
    # A crash that still exits 0 must not be scored as a pass.
    check_case crash_rc_zero 0 CRASH \
        'thread "simple-main" has overflowed its stack
fatal runtime error: stack overflow, aborting'
    # Warnings without a summary are a crash, not a clean-ish run. This is the
    # case a summary-line-counting sweep gets wrong.
    check_case crash_after_findings 1 CRASH \
        'a.spl:12:0: warning[COLL001]: prefer a dict-backed membership test
a.spl:31:0: warning[STUB001]: placeholder implementation
error: semantic: array index out of bounds: index is 158 but length is 79'
    check_case timeout_124 124 TIMEOUT \
        'a.spl:1:0: warning[W0406]: partial output before the budget ran out'
    check_case killed_137 137 TIMEOUT ''
    check_case missing_log 1 CRASH ''
    rm -f "$_tmp/missing_log.log"
    _got=$(classify_run 1 "$_tmp/definitely-absent.log")
    _checked=$((_checked + 1))
    if [ "$_got" = "CRASH" ]; then
        echo "  ok    absent_log -> CRASH"
    else
        echo "  FAIL  absent_log -> $_got (expected CRASH)"
        _fail=$((_fail + 1))
    fi

    rm -rf "$_tmp"
    if [ "$_checked" -lt 11 ]; then
        echo "ERROR — nothing was checked: self-test ran $_checked cases, expected at least 11 - the harness itself did not run"
        exit 2
    fi
    if [ "$_fail" -ne 0 ]; then
        echo "FAIL — $_checked classifier case(s) checked, $_fail wrong"
        exit 1
    fi
    echo "PASS — $_checked classifier case(s) checked, all correct (self-test only, census skipped)"
    exit 0
fi

# ---------------------------------------------------------------------------
# CENSUS
# ---------------------------------------------------------------------------
[ -n "$TARGETS" ] || die_error "no targets given (use --self-test to check the classifier)"
[ -x "$BINARY" ] || command -v "$BINARY" >/dev/null 2>&1 || die_error "lint binary not executable: $BINARY"

WORK=$(mktemp -d) || die_error "mktemp failed"
INPUTS="$WORK/inputs.txt"
: > "$INPUTS"

for t in $TARGETS; do
    if [ -f "$t" ]; then
        echo "$t" >> "$INPUTS"
    elif [ -d "$t" ]; then
        find "$t" -type f -name '*.spl' >> "$INPUTS" || die_error "find failed under $t"
    else
        rm -rf "$WORK"
        die_error "target does not exist: $t"
    fi
done

sort -u "$INPUTS" -o "$INPUTS" || die_error "sort failed"
INPUT_COUNT=$(wc -l < "$INPUTS" | tr -d ' ')
[ "$INPUT_COUNT" -gt 0 ] || { rm -rf "$WORK"; die_error "no .spl files found in the given targets"; }

VERDICTS="$WORK/verdicts.txt"
: > "$VERDICTS"

n_linted=0
n_not_linted=0
n_crash=0
n_timeout=0

while IFS= read -r f; do
    [ -n "$f" ] || continue
    log="$WORK/run.log"
    : > "$log"
    if [ "$USE_JIT" -eq 1 ]; then
        SIMPLE_EXECUTION_MODE=jit timeout "$TIMEOUT_SEC" "$BINARY" lint --json "$f" > "$log" 2>&1
    else
        timeout "$TIMEOUT_SEC" "$BINARY" lint --json "$f" > "$log" 2>&1
    fi
    rc=$?
    verdict=$(classify_run "$rc" "$log")
    printf '%s\t%s\trc=%s\n' "$verdict" "$f" "$rc" >> "$VERDICTS"
    case "$verdict" in
        LINTED) n_linted=$((n_linted + 1)) ;;
        NOT_LINTED) n_not_linted=$((n_not_linted + 1)) ;;
        CRASH) n_crash=$((n_crash + 1)) ;;
        TIMEOUT) n_timeout=$((n_timeout + 1)) ;;
    esac
done < "$INPUTS"

VERDICT_COUNT=$(wc -l < "$VERDICTS" | tr -d ' ')

if [ -n "$OUT" ]; then
    cp "$VERDICTS" "$OUT" || { rm -rf "$WORK"; die_error "could not write $OUT"; }
fi

echo "census: inputs=$INPUT_COUNT verdicts=$VERDICT_COUNT linted=$n_linted not_linted=$n_not_linted crash=$n_crash timeout=$n_timeout"

if [ "$VERDICT_COUNT" -ne "$INPUT_COUNT" ]; then
    rm -rf "$WORK"
    echo "ERROR — nothing was checked: verdicts ($VERDICT_COUNT) != inputs ($INPUT_COUNT) - this census is INCOMPLETE and must not be quoted"
    exit 2
fi

if [ "$n_crash" -gt 0 ] || [ "$n_timeout" -gt 0 ]; then
    echo "--- files with no verdict of their own ---"
    grep -E '^(CRASH|TIMEOUT)' "$VERDICTS"
    rm -rf "$WORK"
    echo "FAIL — $INPUT_COUNT file(s) checked, $n_crash crashed and $n_timeout timed out without producing a lint summary; they are NOT checked files"
    exit 1
fi

rm -rf "$WORK"
if [ "$INPUT_COUNT" -eq 0 ]; then
    echo "ERROR — nothing was checked (0 files fed to the linter)"
    exit 2
fi
echo "PASS — $INPUT_COUNT file(s) checked, all produced a lint summary ($n_linted linted, $n_not_linted not linted)"
exit 0
