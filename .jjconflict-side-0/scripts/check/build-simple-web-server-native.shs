#!/bin/sh
# Production native-build gate for the hosted Simple web server.
#
# Usage:
#   SIMPLE_WEB_RUNTIME_PATH=<matching-runtime-authority> \
#     sh scripts/check/build-simple-web-server-native.shs <simple> [output] [cache]
#
# A non-strict Cranelift build can manufacture weak zero-returning bodies before
# the real C driver gets a chance to satisfy compiler-support symbols such as
# __cpu_model from libgcc/compiler-rt.  That produces a linked executable which
# is not production evidence.  Keep this wrapper fail-closed.
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
SIMPLE_BIN=${1:-"$ROOT_DIR/bin/simple"}
OUTPUT=${2:-"$ROOT_DIR/build/simple-web-server-production/simple_web_server"}
CACHE_DIR=${3:-"$ROOT_DIR/build/simple-web-server-production/cache"}
RUNTIME_PATH=${SIMPLE_WEB_RUNTIME_PATH:-}
TLS_SUPPLEMENT_DIR=${SIMPLE_WEB_TLS_SUPPLEMENT_DIR:-"$ROOT_DIR/build/native_probe/host-gpu-runtime-capsule-current"}
TLS_PROVIDER_OBJECT=${SIMPLE_WEB_TLS_PROVIDER_OBJECT:-"$TLS_SUPPLEMENT_DIR/runtime_tls_hosted.o"}
TLS_SUPPLEMENT_MANIFEST=${SIMPLE_WEB_TLS_SUPPLEMENT_MANIFEST:-"$TLS_SUPPLEMENT_DIR/capsule.manifest"}
TLS_PROVIDER_SOURCE=${SIMPLE_WEB_TLS_PROVIDER_SOURCE:-"$ROOT_DIR/src/runtime/runtime_tls_hosted.c"}
OUTPUT_DIR=$(dirname -- "$OUTPUT")
LOG="$OUTPUT_DIR/build.log"

mkdir -p "$OUTPUT_DIR" "$CACHE_DIR"

runtime_source_tree_sha256() {
    (
        cd "$ROOT_DIR"
        git ls-files --cached --others --exclude-standard -- \
            src/compiler_rust/runtime src/compiler_rust/common/src/runtime_symbols.rs src/runtime \
            | LC_ALL=C sort \
            | while IFS= read -r source; do
                case "$source" in
                    src/runtime/vendor/*|src/runtime/.simple/*|*/target/*) continue ;;
                    src/runtime/*.o|src/runtime/*.a|src/runtime/*.so) continue ;;
                    src/runtime/miniaudio.h|src/runtime/stb_image.h|src/runtime/stb_truetype.h) continue ;;
                esac
                [ -f "$source" ] && sha256sum "$source"
            done
    ) | sha256sum | awk '{print $1}'
}

if [ ! -x "$SIMPLE_BIN" ]; then
    echo "FAIL: Simple compiler is not executable: $SIMPLE_BIN" >&2
    exit 2
fi

# The SSR closure intentionally contains the canonical Engine2D automatic GPU
# lane.  A core-only runtime cannot own the CUDA/ROCm/Metal/Vulkan externs in
# that closure; allowing auto-selection here reaches the linker with dozens of
# predictable undefined rt_* symbols.  Production web builds therefore use
# the host-gpu bundle and must bind it to the admitted compiler's matching
# runtime authority directory.  Do not guess a repository-global Rust target:
# that can silently mix compiler and runtime generations.
if [ -z "$RUNTIME_PATH" ] || [ ! -d "$RUNTIME_PATH" ]; then
    echo "FAIL: GPU-capable SSR requires SIMPLE_WEB_RUNTIME_PATH=<admitted host-gpu runtime authority directory>" >&2
    exit 7
fi
RUNTIME_ARCHIVE=${SIMPLE_WEB_RUNTIME_ARCHIVE:-"$RUNTIME_PATH/libsimple_runtime.a"}

# The currently admitted Stage2 compiler predates runtime_tls_hosted.c in its
# generated host-gpu core-C archive, but it already supports the native-project
# SIMPLE_LINK_OBJECTS contract.  Attach the separately admitted TLS supplement
# explicitly and bind it to its capsule receipt.  This is deliberately
# fail-closed: an arbitrary same-named object must not become a cryptographic
# provider merely by being present on disk.
if [ ! -f "$RUNTIME_ARCHIVE" ] || [ ! -f "$TLS_PROVIDER_OBJECT" ] \
    || [ ! -f "$TLS_PROVIDER_SOURCE" ] || [ ! -f "$TLS_SUPPLEMENT_MANIFEST" ]; then
    echo "FAIL: canonical hosted TLS link supplement is missing (object=$TLS_PROVIDER_OBJECT manifest=$TLS_SUPPLEMENT_MANIFEST)" >&2
    exit 8
fi
if ! grep -Fxq 'schema=simple-host-gpu-runtime-capsule-v1' "$TLS_SUPPLEMENT_MANIFEST" \
    || ! grep -Fxq 'status=pass' "$TLS_SUPPLEMENT_MANIFEST"; then
    echo "FAIL: hosted TLS link supplement manifest is not an admitted capsule: $TLS_SUPPLEMENT_MANIFEST" >&2
    exit 8
fi
# A core-only archive can carry a forged/partial host-GPU receipt and still
# satisfy the generic archive hash checks.  Require the producer's explicit
# GPU ownership contract and verify the symbols in the selected bytes.
if ! grep -Fxq 'gpu_symbol_owner=libsimple_runtime.a' "$TLS_SUPPLEMENT_MANIFEST" \
    || ! grep -Fq 'gpu_archive_symbols=' "$TLS_SUPPLEMENT_MANIFEST"; then
    echo "FAIL: host-GPU capsule does not declare its GPU symbol ownership" >&2
    exit 8
fi
if ! grep -Fxq 'tls_symbol_owner=runtime_tls_hosted.o' "$TLS_SUPPLEMENT_MANIFEST" \
    || ! grep -Fxq 'tls_symbols=rt_byte_char,rt_rsa_decrypt,rt_wire_to_hex,rt_hex_to_wire,rt_random_i64' "$TLS_SUPPLEMENT_MANIFEST"; then
    echo "FAIL: host-GPU capsule does not declare its hosted TLS symbol ownership" >&2
    exit 8
fi
RUNTIME_ARCHIVE_SHA256=$(sha256sum "$RUNTIME_ARCHIVE" | awk '{print $1}')
if ! grep -Fxq "archive_sha256=$RUNTIME_ARCHIVE_SHA256" "$TLS_SUPPLEMENT_MANIFEST"; then
    echo "FAIL: selected host-GPU runtime archive does not match its admitted capsule manifest" >&2
    exit 8
fi
RUNTIME_SOURCE_TREE_SHA256=$(runtime_source_tree_sha256)
if ! grep -Fxq "runtime_source_tree_sha256=$RUNTIME_SOURCE_TREE_SHA256" "$TLS_SUPPLEMENT_MANIFEST"; then
    echo "FAIL: host-GPU runtime archive capsule is stale or lacks an exact source-tree fingerprint" >&2
    exit 8
fi
TLS_PROVIDER_SHA256=$(sha256sum "$TLS_PROVIDER_OBJECT" | awk '{print $1}')
if ! grep -Fxq "tls_provider_object_sha256=$TLS_PROVIDER_SHA256" "$TLS_SUPPLEMENT_MANIFEST"; then
    echo "FAIL: hosted TLS provider object does not match its admitted capsule manifest" >&2
    exit 8
fi
TLS_PROVIDER_SOURCE_SHA256=$(sha256sum "$TLS_PROVIDER_SOURCE" | awk '{print $1}')
if ! grep -Fxq "tls_provider_source_sha256=$TLS_PROVIDER_SOURCE_SHA256" "$TLS_SUPPLEMENT_MANIFEST"; then
    echo "FAIL: hosted TLS object is stale relative to its manifest-bound source" >&2
    exit 8
fi
for TLS_SYMBOL in rt_byte_char rt_rsa_decrypt rt_wire_to_hex rt_hex_to_wire rt_random_i64; do
    if ! nm -g --defined-only "$TLS_PROVIDER_OBJECT" 2>/dev/null \
        | awk -v expected="$TLS_SYMBOL" 'NF >= 1 && $NF == expected { found = 1 } END { exit(found ? 0 : 1) }'; then
        echo "FAIL: selected hosted TLS provider object is missing symbol: $TLS_SYMBOL" >&2
        exit 8
    fi
done

# Resolve the actual shared provider selected by the host C driver and pin its
# content, not merely the logical `-lcrypto` name. This rejects a capsule copied
# between hosts with a different OpenSSL provider while preserving the normal
# driver search semantics used by the final link.
HOST_CC=${CC:-cc}
CRYPTO_LINK_NAME=$($HOST_CC -print-file-name=libcrypto.so)
if [ "$CRYPTO_LINK_NAME" = libcrypto.so ] || [ ! -f "$CRYPTO_LINK_NAME" ]; then
    echo "FAIL: host C driver cannot resolve libcrypto.so" >&2
    exit 8
fi
CRYPTO_PROVIDER=$(realpath "$CRYPTO_LINK_NAME")
CRYPTO_PROVIDER_SHA256=$(sha256sum "$CRYPTO_PROVIDER" | awk '{print $1}')
if ! grep -Fxq "crypto_provider_sha256=$CRYPTO_PROVIDER_SHA256" "$TLS_SUPPLEMENT_MANIFEST"; then
    echo "FAIL: resolved libcrypto provider does not match its admitted capsule manifest" >&2
    exit 8
fi
for GPU_SYMBOL in \
    rt_cuda_available rt_cuda_device_count rt_cuda_init rt_cuda_launch_kernel \
    rt_vulkan_provider_is_available rt_vulkan_provider_device_count \
    rt_vulkan_init rt_vulkan_compile_spirv_raw rt_vulkan_create_compute_pipeline
do
    if ! nm -g --defined-only "$RUNTIME_ARCHIVE" 2>/dev/null \
        | awk -v expected="$GPU_SYMBOL" 'NF >= 1 && $NF == expected { found = 1 } END { exit(found ? 0 : 1) }'; then
        echo "FAIL: selected host-GPU runtime archive is missing symbol: $GPU_SYMBOL" >&2
        exit 8
    fi
done
WEB_LINK_OBJECTS=$TLS_PROVIDER_OBJECT
if [ -n "${SIMPLE_LINK_OBJECTS:-}" ]; then
    WEB_LINK_OBJECTS="${SIMPLE_LINK_OBJECTS}:$WEB_LINK_OBJECTS"
fi
WEB_LINK_LIBRARIES=crypto
if [ -n "${SIMPLE_LINK_LIBRARIES:-}" ]; then
    WEB_LINK_LIBRARIES="${SIMPLE_LINK_LIBRARIES}:$WEB_LINK_LIBRARIES"
fi

. "$ROOT_DIR/scripts/lib/simple-compiler-select.shs"

# A banner-only check is insufficient: stale pure-Simple stages in this tree
# answer --version/--help successfully and then SIGSEGV on the first real
# environment-writing compiler operation.  The shared selector rejects both
# the Rust seed by identity and unusable staged binaries with a bounded real
# native-build probe.  Do this before starting the expensive server closure.
if ! simple_compiler_usable "$SIMPLE_BIN"; then
    echo "FAIL: production build requires a usable pure-Simple self-hosted compiler; authority probe rejected: $SIMPLE_BIN" >&2
    exit 6
fi

set +e
env -u SIMPLE_BOOTSTRAP -u SIMPLE_RUNTIME_PATH \
    SIMPLE_LIB="$ROOT_DIR/src" \
    SIMPLE_NO_STUB_FALLBACK=1 \
    SIMPLE_LINK_OBJECTS="$WEB_LINK_OBJECTS" \
    SIMPLE_LINK_LIBRARIES="$WEB_LINK_LIBRARIES" \
    "$SIMPLE_BIN" native-build \
    --backend cranelift \
    --runtime-bundle host-gpu \
    --runtime-path "$RUNTIME_PATH" \
    --source "$ROOT_DIR/src/app" \
    --source "$ROOT_DIR/src/lib" \
    --entry-closure \
    --cache-dir "$CACHE_DIR" \
    --entry "$ROOT_DIR/src/app/simple_web_server/main.spl" \
    --strip \
    --output "$OUTPUT" >"$LOG" 2>&1
BUILD_STATUS=$?
set -e

sed -n '1,200p' "$LOG"
if [ "$BUILD_STATUS" -ne 0 ]; then
    echo "FAIL: strict Simple web server native-build exited $BUILD_STATUS" >&2
    exit "$BUILD_STATUS"
fi
if [ ! -x "$OUTPUT" ]; then
    echo "FAIL: native-build reported success without an executable: $OUTPUT" >&2
    exit 3
fi
if grep -q 'stub functions for unresolved symbols' "$LOG"; then
    echo "FAIL: production build fabricated unresolved-symbol stubs" >&2
    exit 4
fi

UNRESOLVED=$(nm -u "$OUTPUT" 2>/dev/null || true)
for SYMBOL in \
    __cpu_indicator_init \
    __cpu_model \
    chr \
    text_dot_from_char_code \
    lib__nogc_async_mut__io__SyncTcpListener \
    lib__nogc_async_mut__io__SyncTcpStream
do
    if printf '%s\n' "$UNRESOLVED" | awk '{print $NF}' | grep -Fxq "$SYMBOL"; then
        echo "FAIL: production artifact retains unresolved symbol: $SYMBOL" >&2
        exit 5
    fi
done

echo "PASS: strict Simple web server artifact: $OUTPUT"
