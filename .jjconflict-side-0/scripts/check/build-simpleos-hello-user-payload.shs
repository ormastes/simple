#!/bin/sh
# Build the SimpleOS x86_64 ring-3 hello-world USER program.
#
# Source is Simple (examples/.../hello_user/hello_user_entry.spl); the compiler
# is the RUST SEED, because the pure-Simple self-hosted compiler cannot compile
# anything yet (`hir codec: no Visibility arm for tag -1`). Output is a
# freestanding ET_EXEC with no PT_INTERP, entry `_start` at 0x400000.
#
# It prints via `out` to the 16550 at 0x3f8, which is legal from CPL3 because
# the ring-3 task's rflags carry IOPL=3 — the same mechanism the existing FDR
# ring-3 proof uses. It exits with syscall 0, which longjmps the kernel back
# through its enter-user savepoint: NO isa-debug-exit, NO port 0xf4.
set -eu
ROOT=$(cd "$(dirname "$0")/../.." && pwd)
cd "$ROOT"
SEED="${SEED:-src/compiler_rust/target/release/simple}"
SRC=examples/09_embedded/simple_os/arch/x86_64/hello_user
OUT="${OUT:-build/os/hello/HELLO.ELF}"
CACHE="${CACHE:-build/os/hello/cache}"
[ -x "$SEED" ] || { echo "ERROR — nothing was checked: seed missing at $SEED"; exit 2; }
mkdir -p "$(dirname "$OUT")"
rm -rf "$CACHE"; rm -f "$OUT"
SIMPLE_BOOTSTRAP=1 SIMPLE_LIB="$ROOT/src" SIMPLE_OS_LOG_MODE=off SIMPLE_ALLOW_FREESTANDING_STUBS=1 \
    "$SEED" native-build --source "$SRC" \
    --backend cranelift --cpu x86-64-v1 --opt-level=aggressive --log off --entry-closure \
    --cache-dir "$CACHE" --entry "$SRC/hello_user_entry.spl" \
    --target x86_64-unknown-none -o "$OUT" --linker-script "$SRC/user.ld"
[ -s "$OUT" ] || { echo "FAIL — payload build produced no $OUT"; exit 1; }

# Fail closed on the two ways this payload can be silently wrong.
readelf -hW "$OUT" | grep -Eq 'Type:[[:space:]]+EXEC' || { echo "FAIL — $OUT is not ET_EXEC"; exit 1; }
readelf -lW "$OUT" | grep -Eq '^[[:space:]]*INTERP' && { echo "FAIL — $OUT has PT_INTERP"; exit 1; }
LC_ALL=C grep -aqF 'HELLO_NATIVE_SIMPLEOS_X86_64_OK' "$OUT" \
    || { echo "FAIL — $OUT does not carry its own output marker"; exit 1; }
# The runtime the program needs must be REAL, not a fabricated stub: if
# serial_println were fabricated the program would run and print nothing, which
# is exactly the vacuous green this lane exists to prevent.
for sym in _start serial_println rt_print rt_string_new rt_user_exit; do
    nm "$OUT" 2>/dev/null | grep -qE " (T|t) $sym\$" \
        || { echo "FAIL — $OUT has no real definition of $sym"; exit 1; }
done
echo "OK $OUT ($(stat -c%s "$OUT") bytes, entry $(readelf -hW "$OUT" | sed -n 's/.*Entry point address: *//p'))"
