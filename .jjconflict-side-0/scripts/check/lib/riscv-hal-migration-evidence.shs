#!/bin/sh
# Shared admission and durable-receipt contract for RISC-V HAL migration gates.
# This file is sourced by producers; it never runs a compiler or target itself.

hal_migration_fail() {
    echo "${HAL_MIGRATION_LANE:-riscv_hal_migration} status=FAIL reason=$1" >&2
    exit 1
}

hal_migration_hash_file() {
    hash_output=$(sha256sum "$1") || return 1
    hash_value=${hash_output%%[[:space:]]*}
    hal_migration_is_sha256 "$hash_value" || return 1
    printf '%s\n' "$hash_value"
}

hal_migration_is_sha256() {
    case $1 in
        *[!0-9a-f]*|'') return 1 ;;
    esac
    [ "${#1}" -eq 64 ]
}

hal_migration_canonical_file() {
    [ -f "$1" ] && [ ! -L "$1" ] || return 1
    (CDPATH= cd -- "$(dirname -- "$1")" && printf '%s/%s\n' "$PWD" "$(basename -- "$1")")
}

hal_migration_verify_expected_hash() {
    hash_path=$1
    expected_hash=$2
    hash_label=$3
    hal_migration_is_sha256 "$expected_hash" ||
        hal_migration_fail "$hash_label-expected-hash-invalid"
    actual_hash=$(hal_migration_hash_file "$hash_path") ||
        hal_migration_fail "$hash_label-hash-unavailable"
    [ "$actual_hash" = "$expected_hash" ] ||
        hal_migration_fail "$hash_label-hash-changed"
}

hal_migration_begin_input_freeze() {
    HAL_MIGRATION_INPUT_MANIFEST=$1
    [ ! -e "$HAL_MIGRATION_INPUT_MANIFEST" ] && [ ! -L "$HAL_MIGRATION_INPUT_MANIFEST" ] ||
        hal_migration_fail evidence-input-manifest-collision
    : >"$HAL_MIGRATION_INPUT_MANIFEST" || hal_migration_fail evidence-input-manifest-create-failed
    chmod 600 "$HAL_MIGRATION_INPUT_MANIFEST" || hal_migration_fail evidence-input-manifest-chmod-failed
    HAL_MIGRATION_INPUT_MANIFEST_SHA256=
}

hal_migration_capture_input() {
    input_label=$1
    input_path=$2
    case $input_label in
        *[!a-z0-9_]*|'') hal_migration_fail evidence-input-label-invalid ;;
    esac
    [ -n "${HAL_MIGRATION_INPUT_MANIFEST:-}" ] || hal_migration_fail evidence-input-freeze-not-started
    [ -z "${HAL_MIGRATION_INPUT_MANIFEST_SHA256:-}" ] || hal_migration_fail evidence-input-freeze-already-sealed
    if awk -F '\t' -v label="$input_label" '$1 == label { found = 1 } END { exit !found }' \
        "$HAL_MIGRATION_INPUT_MANIFEST"; then
        hal_migration_fail "evidence-input-$input_label-duplicate"
    fi
    canonical_input=$(hal_migration_canonical_file "$input_path") ||
        hal_migration_fail "evidence-input-$input_label-not-canonical"
    case $canonical_input in
        *"	"*|*"
"*) hal_migration_fail "evidence-input-$input_label-path-invalid" ;;
    esac
    input_sha=$(hal_migration_hash_file "$canonical_input") ||
        hal_migration_fail "evidence-input-$input_label-hash-unavailable"
    printf '%s\t%s\t%s\n' "$input_label" "$input_sha" "$canonical_input" \
        >>"$HAL_MIGRATION_INPUT_MANIFEST" || hal_migration_fail evidence-input-manifest-write-failed
}

hal_migration_resolve_tool() {
    resolved_tool=$(command -v "$1" 2>/dev/null || true)
    [ -n "$resolved_tool" ] || hal_migration_fail "evidence-tool-$2-missing"
    if command -v readlink >/dev/null 2>&1; then
        resolved_tool=$(readlink -f "$resolved_tool") || hal_migration_fail "evidence-tool-$2-not-canonical"
    fi
    hal_migration_canonical_file "$resolved_tool" || hal_migration_fail "evidence-tool-$2-not-canonical"
}

hal_migration_seal_input_freeze() {
    [ -s "${HAL_MIGRATION_INPUT_MANIFEST:-}" ] && [ ! -L "$HAL_MIGRATION_INPUT_MANIFEST" ] ||
        hal_migration_fail evidence-input-manifest-invalid
    HAL_MIGRATION_INPUT_MANIFEST_SHA256=$(hal_migration_hash_file "$HAL_MIGRATION_INPUT_MANIFEST") ||
        hal_migration_fail evidence-input-manifest-hash-unavailable
}

hal_migration_frozen_hash() {
    frozen_label=$1
    frozen_path=$(hal_migration_canonical_file "$2") ||
        hal_migration_fail "evidence-input-$frozen_label-no-longer-canonical"
    [ -n "${HAL_MIGRATION_INPUT_MANIFEST_SHA256:-}" ] || hal_migration_fail evidence-input-freeze-not-sealed
    frozen_row=$(awk -F '\t' -v label="$frozen_label" '$1 == label { print $2 "\t" $3; count++ } END { if (count != 1) exit 1 }' \
        "$HAL_MIGRATION_INPUT_MANIFEST") || hal_migration_fail "evidence-input-$frozen_label-missing"
    frozen_sha=${frozen_row%%"	"*}
    frozen_recorded_path=${frozen_row#*"	"}
    [ "$frozen_recorded_path" = "$frozen_path" ] || hal_migration_fail "evidence-input-$frozen_label-path-changed"
    printf '%s\n' "$frozen_sha"
}

hal_migration_revalidate_inputs_before_receipt() {
    hal_migration_verify_expected_hash \
        "$HAL_MIGRATION_INPUT_MANIFEST" "$HAL_MIGRATION_INPUT_MANIFEST_SHA256" evidence-input-manifest
    input_count=0
    while IFS="	" read -r input_label expected_input_sha expected_input_path; do
        [ -n "$input_label" ] && [ -n "$expected_input_sha" ] && [ -n "$expected_input_path" ] ||
            hal_migration_fail evidence-input-manifest-row-invalid
        current_input=$(hal_migration_canonical_file "$expected_input_path") ||
            hal_migration_fail "evidence-input-$input_label-no-longer-canonical"
        [ "$current_input" = "$expected_input_path" ] ||
            hal_migration_fail "evidence-input-$input_label-path-changed"
        hal_migration_verify_expected_hash "$expected_input_path" "$expected_input_sha" "evidence-input-$input_label"
        input_count=$((input_count + 1))
    done <"$HAL_MIGRATION_INPUT_MANIFEST"
    [ "$input_count" -gt 0 ] || hal_migration_fail evidence-input-manifest-empty
}

hal_migration_parse_admission() {
    [ "$#" -eq 3 ] && [ "$1" = "--admit" ] ||
        hal_migration_fail "stage4-admission-required usage=--admit_SIMPLE_BINARY_PROVENANCE"
    HAL_MIGRATION_SIMPLE_INPUT=$2
    HAL_MIGRATION_PROVENANCE_INPUT=$3
}

hal_migration_require_stage4() {
    root=$1
    stage3_helper=$root/scripts/check/lib/bootstrap-stage3-provenance.shs
    stage4_helper=$root/scripts/check/lib/stage4-candidate-provenance.shs
    [ -f "$stage3_helper" ] && [ -f "$stage4_helper" ] ||
        hal_migration_fail stage4-provenance-helpers-missing

    BOOTSTRAP_STAGE3_FACADE_PATH=$stage3_helper
    STAGE4_PROVENANCE_HELPER_PATH=$stage4_helper
    export BOOTSTRAP_STAGE3_FACADE_PATH STAGE4_PROVENANCE_HELPER_PATH
    . "$BOOTSTRAP_STAGE3_FACADE_PATH"
    . "$STAGE4_PROVENANCE_HELPER_PATH"

    HAL_MIGRATION_SIMPLE_BIN=$(bootstrap_stage3_canonical_file "$HAL_MIGRATION_SIMPLE_INPUT") ||
        hal_migration_fail stage4-binary-not-canonical
    HAL_MIGRATION_STAGE4_PROVENANCE=$(bootstrap_stage3_canonical_file "$HAL_MIGRATION_PROVENANCE_INPUT") ||
        hal_migration_fail stage4-provenance-not-canonical
    stage4_verify_candidate_provenance \
        "$HAL_MIGRATION_STAGE4_PROVENANCE" "$HAL_MIGRATION_SIMPLE_BIN" "$root" ||
        hal_migration_fail admitted-current-tree-stage4-provenance-required
    case $("$HAL_MIGRATION_SIMPLE_BIN" --version 2>&1 || true) in
        *"Rust-built Simple binary is a bootstrap seed"*|*"bootstrap seed only"*)
            hal_migration_fail bootstrap-seed-rejected ;;
    esac

    HAL_MIGRATION_SIMPLE_SHA256=$(hal_migration_hash_file "$HAL_MIGRATION_SIMPLE_BIN") ||
        hal_migration_fail stage4-binary-hash-unavailable
    HAL_MIGRATION_STAGE4_PROVENANCE_SHA256=$(hal_migration_hash_file "$HAL_MIGRATION_STAGE4_PROVENANCE") ||
        hal_migration_fail stage4-provenance-hash-unavailable
    hal_migration_is_sha256 "$HAL_MIGRATION_SIMPLE_SHA256" || hal_migration_fail stage4-binary-hash-invalid
    hal_migration_is_sha256 "$HAL_MIGRATION_STAGE4_PROVENANCE_SHA256" || hal_migration_fail stage4-provenance-hash-invalid
}

hal_migration_bind_target_runtime() {
    HAL_MIGRATION_TARGET_RUNTIME_KIND=$1
    HAL_MIGRATION_TARGET_RUNTIME_PATH=$(hal_migration_canonical_file "$2") ||
        hal_migration_fail target-runtime-not-canonical
    [ -s "$HAL_MIGRATION_TARGET_RUNTIME_PATH" ] || hal_migration_fail target-runtime-empty
    HAL_MIGRATION_TARGET_RUNTIME_SHA256=$(hal_migration_hash_file "$HAL_MIGRATION_TARGET_RUNTIME_PATH") ||
        hal_migration_fail target-runtime-hash-unavailable
    hal_migration_is_sha256 "$HAL_MIGRATION_TARGET_RUNTIME_SHA256" ||
        hal_migration_fail target-runtime-hash-invalid
}

hal_migration_bind_toolchain() {
    HAL_MIGRATION_TARGET_TOOLCHAIN_KIND=$1
    tool_path=$(command -v "$2" 2>/dev/null || true)
    [ -n "$tool_path" ] || hal_migration_fail target-toolchain-missing
    if command -v readlink >/dev/null 2>&1; then
        tool_path=$(readlink -f "$tool_path") || hal_migration_fail target-toolchain-not-canonical
    fi
    HAL_MIGRATION_TARGET_TOOLCHAIN_PATH=$(hal_migration_canonical_file "$tool_path") ||
        hal_migration_fail target-toolchain-not-canonical
    HAL_MIGRATION_TARGET_TOOLCHAIN_SHA256=$(hal_migration_hash_file "$HAL_MIGRATION_TARGET_TOOLCHAIN_PATH") ||
        hal_migration_fail target-toolchain-hash-unavailable
    hal_migration_is_sha256 "$HAL_MIGRATION_TARGET_TOOLCHAIN_SHA256" ||
        hal_migration_fail target-toolchain-hash-invalid
}

hal_migration_revalidate_before_receipt() {
    root=$1
    stage4_verify_candidate_provenance \
        "$HAL_MIGRATION_STAGE4_PROVENANCE" "$HAL_MIGRATION_SIMPLE_BIN" "$root" ||
        hal_migration_fail admitted-current-tree-stage4-provenance-changed
    hal_migration_verify_expected_hash \
        "$HAL_MIGRATION_SIMPLE_BIN" "$HAL_MIGRATION_SIMPLE_SHA256" stage4-binary
    hal_migration_verify_expected_hash \
        "$HAL_MIGRATION_STAGE4_PROVENANCE" \
        "$HAL_MIGRATION_STAGE4_PROVENANCE_SHA256" stage4-provenance
    current_runtime=$(hal_migration_canonical_file "$HAL_MIGRATION_TARGET_RUNTIME_PATH") ||
        hal_migration_fail target-runtime-no-longer-canonical
    [ "$current_runtime" = "$HAL_MIGRATION_TARGET_RUNTIME_PATH" ] ||
        hal_migration_fail target-runtime-path-changed
    hal_migration_verify_expected_hash \
        "$HAL_MIGRATION_TARGET_RUNTIME_PATH" \
        "$HAL_MIGRATION_TARGET_RUNTIME_SHA256" target-runtime
    if [ -n "${HAL_MIGRATION_TARGET_TOOLCHAIN_PATH:-}" ]; then
        hal_migration_verify_expected_hash \
            "$HAL_MIGRATION_TARGET_TOOLCHAIN_PATH" \
            "$HAL_MIGRATION_TARGET_TOOLCHAIN_SHA256" target-toolchain
    fi
}

hal_migration_receipt_path() {
    root=$1
    lane=$2
    printf '%s\n' "${HAL_MIGRATION_RECEIPT:-$root/build/test-artifacts/riscv-hal-migration/$lane/receipt.env}"
}

hal_migration_publish_receipt() {
    receipt=$1
    payload=$2
    [ -s "$payload" ] && [ ! -L "$payload" ] || hal_migration_fail receipt-payload-invalid
    case $receipt in
        */*) receipt_dir=${receipt%/*} ;;
        *) receipt_dir=. ;;
    esac
    mkdir -p "$receipt_dir"
    [ -d "$receipt_dir" ] && [ ! -L "$receipt_dir" ] || hal_migration_fail receipt-directory-invalid
    receipt_tmp=$receipt_dir/.receipt.env.tmp.$$
    [ ! -e "$receipt_tmp" ] && [ ! -L "$receipt_tmp" ] || hal_migration_fail receipt-temp-collision
    payload_sha=$(hal_migration_hash_file "$payload") || hal_migration_fail receipt-payload-hash-unavailable
    {
        cat "$payload"
        printf 'receipt_payload_sha256=%s\n' "$payload_sha"
    } >"$receipt_tmp" || hal_migration_fail receipt-write-failed
    [ -s "$receipt_tmp" ] && [ ! -L "$receipt_tmp" ] || hal_migration_fail receipt-write-failed
    mv -- "$receipt_tmp" "$receipt" || hal_migration_fail receipt-publication-failed
    chmod a-w "$receipt" 2>/dev/null || true
    HAL_MIGRATION_RECEIPT_PATH=$receipt
    HAL_MIGRATION_RECEIPT_SHA256=$(hal_migration_hash_file "$receipt") ||
        hal_migration_fail receipt-hash-unavailable
}

hal_migration_write_common_fields() {
    lane=$1
    checker=$2
    checker_sha=$(hal_migration_frozen_hash checker "$checker")
    printf 'schema=riscv-hal-migration-evidence-v1\n'
    printf 'lane=%s\n' "$lane"
    printf 'status=pass\n'
    printf 'stage4_requirement=admitted-current-tree-pure-simple-full-cli\n'
    printf 'stage4_binary_path=%s\n' "$HAL_MIGRATION_SIMPLE_BIN"
    printf 'stage4_binary_sha256=%s\n' "$HAL_MIGRATION_SIMPLE_SHA256"
    printf 'stage4_provenance_path=%s\n' "$HAL_MIGRATION_STAGE4_PROVENANCE"
    printf 'stage4_provenance_sha256=%s\n' "$HAL_MIGRATION_STAGE4_PROVENANCE_SHA256"
    printf 'target_runtime_kind=%s\n' "$HAL_MIGRATION_TARGET_RUNTIME_KIND"
    printf 'target_runtime_path=%s\n' "$HAL_MIGRATION_TARGET_RUNTIME_PATH"
    printf 'target_runtime_sha256=%s\n' "$HAL_MIGRATION_TARGET_RUNTIME_SHA256"
    printf 'checker_path=%s\n' "$checker"
    printf 'checker_sha256=%s\n' "$checker_sha"
    printf 'evidence_input_manifest_sha256=%s\n' "$HAL_MIGRATION_INPUT_MANIFEST_SHA256"
    frozen_input_count=0
    while IFS="	" read -r frozen_input_label frozen_input_sha frozen_input_path; do
        printf 'evidence_input_%s_path=%s\n' "$frozen_input_label" "$frozen_input_path"
        printf 'evidence_input_%s_sha256=%s\n' "$frozen_input_label" "$frozen_input_sha"
        frozen_input_count=$((frozen_input_count + 1))
    done <"$HAL_MIGRATION_INPUT_MANIFEST"
    printf 'evidence_input_count=%s\n' "$frozen_input_count"
    printf 'qemu=not-run\n'
}
