#!/bin/sh
set -eu

wall_seconds=3600
allow_test_hooks=0
case "${1:-}" in --allow-test-hooks) allow_test_hooks=1; shift ;; esac
case "${1:-}" in --wall-seconds=*) wall_seconds=${1#*=}; shift ;; *) exit 125 ;; esac
[ "${1:-}" = -- ] || exit 125
shift
[ "$#" -ge 2 ] && [ "$2" = native-build ] || exit 125
case "${wall_seconds}" in ''|*[!0-9]*) exit 125 ;; esac
[ "${wall_seconds}" = 3600 ] || [ "${allow_test_hooks}" = 1 ] || exit 125
[ -x /usr/bin/timeout ] && [ -f /usr/bin/timeout ] && [ ! -L /usr/bin/timeout ] || exit 125

if [ "${allow_test_hooks}" = 1 ]; then
  sleep "${STAGE2_DEADLINE_TEST_SETUP_SECONDS:-0}"
elif [ -n "${STAGE2_DEADLINE_TEST_SETUP_SECONDS:-}${STAGE2_DEADLINE_TEST_POST_SECONDS:-}${STAGE2_DEADLINE_TEST_EVENTS:-}" ]; then
  exit 125
fi
if [ -n "${STAGE2_DEADLINE_TEST_EVENTS:-}" ]; then
  printf 'spawn\n' >>"${STAGE2_DEADLINE_TEST_EVENTS}"
fi
set +e
/usr/bin/timeout --signal=TERM --kill-after=10s "${wall_seconds}s" "$@"
status=$?
set -e
if [ -n "${STAGE2_DEADLINE_TEST_EVENTS:-}" ]; then
  printf 'exit=%s\n' "${status}" >>"${STAGE2_DEADLINE_TEST_EVENTS}"
fi
if [ "${allow_test_hooks}" = 1 ]; then
  sleep "${STAGE2_DEADLINE_TEST_POST_SECONDS:-0}"
fi
exit "${status}"
