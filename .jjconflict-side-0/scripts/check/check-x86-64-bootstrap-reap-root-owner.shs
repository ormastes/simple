#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
source_file="$root/src/os/kernel/scheduler/scheduler_task_mgmt.spl"

fail() {
    printf '%s\n' "x86_64 bootstrap reap-root gate: $*" >&2
    exit 1
}

grep -F 'sched_release_task_address_space(task)' "$source_file" >/dev/null || fail "zombie collection must release the exact child address space"
grep -F 'phys_root: task.address_space,' "$source_file" >/dev/null || fail "release must use the task-owned physical root"
grep -F 'id: 0' "$source_file" >/dev/null || fail "release must not require nested isolation metadata"
if grep -F 'task.isolation.address_space_id' "$source_file" >/dev/null; then
    fail "reaper must not read nested isolation metadata"
fi

printf '%s\n' 'PASS x86_64 bootstrap reaper uses physical-root owner only'
