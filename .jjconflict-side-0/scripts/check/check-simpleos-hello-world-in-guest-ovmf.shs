#!/bin/sh
# check-simpleos-hello-world-in-guest-ovmf.shs
#
# Proves that a HELLO WORLD program actually RUNS INSIDE SimpleOS on x86_64 and
# prints ITS OWN output to the console — not merely that the kernel booted.
#
# Boot is OVMF pflash -> GRUB-EFI (a real EFI application) -> multiboot1 kernel.
# NEVER QEMU `-kernel`, NEVER isa-debug-exit: the point of the lane is that the
# same artifact could boot on real hardware (.claude/rules/board-runnable.md).
# The assembled QEMU argv is self-checked for both before the VM is started.
#
# TWO PROGRAM ROWS ARE IN SCOPE:
#   native      A hello world WRITTEN IN SIMPLE, compiled to a freestanding
#               x86_64 ET_EXEC by the RUST SEED (the pure-Simple self-hosted
#               compiler cannot compile anything yet), staged onto the guest's
#               own FAT32/NVMe volume, read back by the guest and executed in
#               RING 3. Its own stdout marker must appear on serial.
#   interpreter Hello world evaluated by the Simple INTERPRETER running in-guest.
#               There is NO in-guest Simple interpreter in this tree; this row is
#               ADVISORY and reported RED unless SIMPLEOS_HELLO_INTERP_ELF names
#               an interpreter payload to stage. See the bug record.
#
# RUNGS (serial log):
#   L1  "[grub-uefi] multiboot loading"        OVMF -> GRUB-EFI application ran
#   L2  "SimpleOS x86_64 hello-world in-guest" multiboot handoff -> spl_start
#   L3  "[hello] nvme online"                  guest storage up
#   L4  "[hello] /FSEXEC.ELF read size="        guest read the program off ITS disk
#   L5  "[hello] entering ring 3"              kernel reached the CPL3 handoff
#   L6  "HELLO_NATIVE_SIMPLEOS_X86_64_OK"      *** THE PROGRAM'S OWN OUTPUT ***
#   L7  "[hello] native program exited rc=0"   clean exit(2), kernel resumed
#
# Verdict is the last line of stdout:
#   PASS  — <n> program(s) checked, ...   exit 0
#   FAIL  — ...                           exit 1
#   ERROR — nothing was checked           exit 2   (0 programs executed is ERROR)
#
# Env: SEED, SKIP_KERNEL=1, QEMU_MEM (2G), BOOT_WAIT (180),
#      SIMPLEOS_HELLO_INTERP_ELF (opt-in interpreter payload).
set -eu
ROOT=$(cd "$(dirname "$0")/../.." && pwd)
cd "$ROOT"

SEED="${SEED:-src/compiler_rust/target/release/simple}"
KERNEL="${KERNEL:-build/os/hello/simpleos_hello_uefi128.elf}"
PAYLOAD="${PAYLOAD:-build/os/hello/HELLO.ELF}"
WORK=build/os/hello/lane
IMG="$WORK/fat32-hello.img"
SERIAL="$WORK/hello_in_guest_ovmf.serial.log"
ESP="$WORK/esp"
EFIAPP="$ESP/EFI/BOOT/BOOTX64.EFI"
OVMF_CODE="${OVMF_CODE:-/usr/share/OVMF/OVMF_CODE_4M.fd}"
OVMF_VARS_SRC="${OVMF_VARS_SRC:-/usr/share/OVMF/OVMF_VARS_4M.fd}"
OVMF_VARS="$WORK/OVMF_VARS_4M.fd"
QEMU_MEM="${QEMU_MEM:-2G}"
BOOT_WAIT="${BOOT_WAIT:-180}"

NATIVE_MARKER='HELLO_NATIVE_SIMPLEOS_X86_64_OK'
INTERP_MARKER='HELLO_INTERP_SIMPLEOS_X86_64_OK'

fail()  { echo "FAIL — $1"; exit 1; }
nothing() { echo "ERROR — nothing was checked: $1"; exit 2; }

# ---------------------------------------------------------------------------
# argv self-check: the real gate's own boot rule, applied to the exact argv.
# ---------------------------------------------------------------------------
assert_real_firmware_argv() {
    # $1 = the assembled argv as a single string
    case " $1 " in
        *" -kernel "*) echo "argv uses QEMU -kernel pass semantics"; return 1 ;;
    esac
    case "$1" in
        *isa-debug-exit*) echo "argv uses isa-debug-exit"; return 1 ;;
    esac
    case "$1" in
        *"if=pflash"*) ;;
        *) echo "argv has no pflash firmware"; return 1 ;;
    esac
    return 0
}

# ---------------------------------------------------------------------------
# --selftest — fatal, runs before any real work.
# ---------------------------------------------------------------------------
selftest() {
    st_tmp=$(mktemp -d "${TMPDIR:-/tmp}/hello-ovmf-selftest.XXXXXX")
    st_fail=0

    # (1) must-PASS serial fixture: every rung present.
    {
        echo '[grub-uefi] multiboot loading /boot/kernel.elf ...'
        echo '=== SimpleOS x86_64 hello-world in-guest (OVMF) ==='
        echo '[hello] nvme online'
        echo '[hello] /FSEXEC.ELF read size=6144 buf=0x900000'
        echo '[hello] entering ring 3 ...'
        echo "$NATIVE_MARKER hello world from Simple"
        echo '[hello] native program exited rc=0'
    } > "$st_tmp/good.log"
    if scan_rungs "$st_tmp/good.log" >/dev/null 2>&1; then :; else
        echo "selftest: must-PASS fixture did not pass"; st_fail=1
    fi

    # (2) must-FAIL: booted fine, program never printed. This is the exact
    #     vacuous-green this gate exists to prevent.
    grep -v "$NATIVE_MARKER" "$st_tmp/good.log" | grep -v 'exited rc=0' > "$st_tmp/bootonly.log"
    if scan_rungs "$st_tmp/bootonly.log" >/dev/null 2>&1; then
        echo "selftest: boot-log-only fixture wrongly passed"; st_fail=1
    fi

    # (3) must-FAIL: program ran but exited non-zero.
    sed 's/exited rc=0/exited rc=-2/' "$st_tmp/good.log" > "$st_tmp/rc.log"
    if scan_rungs "$st_tmp/rc.log" >/dev/null 2>&1; then
        echo "selftest: non-zero-exit fixture wrongly passed"; st_fail=1
    fi

    # (4) must-FAIL: empty serial log — nothing executed.
    : > "$st_tmp/empty.log"
    if scan_rungs "$st_tmp/empty.log" >/dev/null 2>&1; then
        echo "selftest: empty fixture wrongly passed"; st_fail=1
    fi

    # (5) argv self-check: must reject -kernel.
    if assert_real_firmware_argv "qemu-system-x86_64 -m 2G -kernel k.elf -serial file:x" >/dev/null 2>&1; then
        echo "selftest: -kernel argv wrongly accepted"; st_fail=1
    fi
    # (6) argv self-check: must reject isa-debug-exit.
    if assert_real_firmware_argv "qemu-system-x86_64 -drive if=pflash,file=o.fd -device isa-debug-exit,iobase=0xf4" >/dev/null 2>&1; then
        echo "selftest: isa-debug-exit argv wrongly accepted"; st_fail=1
    fi
    # (7) argv self-check: must accept the real pflash argv.
    if assert_real_firmware_argv "qemu-system-x86_64 -drive if=pflash,format=raw,file=o.fd -serial file:x" >/dev/null 2>&1; then :; else
        echo "selftest: real pflash argv wrongly rejected"; st_fail=1
    fi

    rm -rf "$st_tmp"
    [ "$st_fail" -eq 0 ] || { echo "ERROR — nothing was checked: selftest failed"; exit 2; }
}

# scan_rungs LOG -> prints rung table on stdout, returns 0 only when every
# required rung is present. Used by both --selftest and the real run.
scan_rungs() {
    sr_log=$1
    sr_missing=''
    sr_checked=0
    sr_check() {
        sr_checked=$((sr_checked + 1))
        if grep -qF "$2" "$sr_log" 2>/dev/null; then
            echo "  [OK]   $1  $2"
        else
            echo "  [MISS] $1  $2"
            sr_missing="$sr_missing $1"
        fi
    }
    sr_check L1 '[grub-uefi] multiboot loading'
    sr_check L2 'SimpleOS x86_64 hello-world in-guest'
    sr_check L3 '[hello] nvme online'
    sr_check L4 '[hello] /FSEXEC.ELF read size='
    sr_check L5 '[hello] entering ring 3'
    sr_check L6 "$NATIVE_MARKER"
    sr_check L7 '[hello] native program exited rc=0'
    RUNGS_CHECKED=$sr_checked
    RUNGS_MISSING=$sr_missing
    [ -z "$sr_missing" ]
}

case "${1:-}" in
    --selftest) selftest; echo "selftest OK"; exit 0 ;;
esac
selftest >/dev/null || exit 2

# ---------------------------------------------------------------------------
# Host prerequisites — absence of a tool is ERROR, never a pass.
# ---------------------------------------------------------------------------
command -v qemu-system-x86_64 >/dev/null 2>&1 || nothing "qemu-system-x86_64 missing"
command -v grub-mkstandalone  >/dev/null 2>&1 || nothing "grub-mkstandalone missing"
command -v mkfs.vfat          >/dev/null 2>&1 || nothing "mkfs.vfat missing"
[ -x "$SEED" ] || nothing "seed missing at $SEED (needed to run the FAT32 image writer)"
[ -f "$OVMF_CODE" ]     || nothing "OVMF_CODE missing at $OVMF_CODE"
[ -f "$OVMF_VARS_SRC" ] || nothing "OVMF_VARS missing at $OVMF_VARS_SRC"

# ---------------------------------------------------------------------------
# 1. The hello-world PAYLOAD (Simple source -> freestanding ET_EXEC, Rust seed).
# ---------------------------------------------------------------------------
[ -f "$PAYLOAD" ] || SEED="$SEED" OUT="$PAYLOAD" \
    sh scripts/check/build-simpleos-hello-user-payload.shs >/dev/null 2>&1 || true
[ -s "$PAYLOAD" ] || nothing "hello payload missing at $PAYLOAD (run scripts/check/build-simpleos-hello-user-payload.shs)"
readelf -hW "$PAYLOAD" | grep -Eq 'Type:[[:space:]]+EXEC' || fail "payload is not ET_EXEC"
readelf -lW "$PAYLOAD" | grep -Eq '^[[:space:]]*INTERP' && fail "payload has PT_INTERP"
LC_ALL=C grep -aqF "$NATIVE_MARKER" "$PAYLOAD" || fail "payload does not carry $NATIVE_MARKER"

# ---------------------------------------------------------------------------
# 2. Kernel.
# ---------------------------------------------------------------------------
mkdir -p "$WORK"
BUILDLOG="$WORK/kernel-build.log"
if [ "${SKIP_KERNEL:-0}" != "1" ] || [ ! -f "$KERNEL" ]; then
    SEED="$SEED" OUT="$KERNEL" sh scripts/check/build-simpleos-hello-ovmf-kernel.shs > "$BUILDLOG" 2>&1 || true
    tail -3 "$BUILDLOG"
fi
# A kernel that will not build means ZERO programs were executed in-guest. Per
# this gate's verdict convention that is ERROR ("nothing was checked"), never
# FAIL and never PASS — FAIL would imply we ran something and it misbehaved.
if [ ! -f "$KERNEL" ]; then
    BUILD_ABORT=$(grep -oE 'Build failed[^"]*' "$BUILDLOG" 2>/dev/null | tail -1)
    nothing "kernel build produced no $KERNEL — ${BUILD_ABORT:-see $BUILDLOG} (B1: src/os modules fail HIR/MIR lowering; SIMPLE_ALLOW_STUB_FALLBACK cannot bypass module-level lowering failures. See doc/08_tracking/bug/simpleos_x86_64_hello_world_in_guest_2026-08-31.md)"
fi

# The kernel is built with SIMPLE_ALLOW_STUB_FALLBACK=1 so that the 19 src/os
# modules failing on stale source idioms (bug record B1) do not block a lane
# that never calls them. That concession is only sound if NOTHING ON THIS
# LANE'S OWN CALL PATH was stubbed — a stubbed body returns 0 with no link
# error and no runtime diagnostic (that is exactly how B2b's `_text_z_size`
# silently corrupted every ring-3 argv frame). Fail closed on any such stub.
if [ -f "$BUILDLOG" ]; then
    LANE_STUBS=$(grep 'STUB-FALLBACK' "$BUILDLOG" 2>/dev/null \
        | sed -n "s/.*failed for '\([A-Za-z0-9_.]*\)'.*/\1/p" \
        | grep -E '^(_text_z_size|_write_text_z|_build_sysv_stack_frame|_admit_raw_elf64|_map_pt_loads|_x86_64_fs_exec_enter_ring3|_rd8|_rd16|_rd32|_rd64|_wr64|pmm_.*|vmm_.*|mmio_.*|x86_64_enter_user_task|arch_x86_64_early_init|destroy_user_address_space|create_user_address_space)$' \
        | sort -u | tr '\n' ' ') || true
    if [ -n "${LANE_STUBS:-}" ]; then
        fail "kernel built, but functions on THIS lane's call path were stub-fallbacked (would silently misbehave): $LANE_STUBS (see $BUILDLOG)"
    fi
fi
echo "[hello] kernel=$KERNEL ($(stat -c%s "$KERNEL") bytes)"

# ---------------------------------------------------------------------------
# 3. FAT32 NVMe volume carrying the program(s). Raw, no partition table — the
#    kernel's _fat32_init reads the BPB from LBA 0 directly.
# ---------------------------------------------------------------------------
# No mtools and no root-mount here, so the image is built by the repo's own
# pure-Simple FAT32 writer (scripts/os/fsexec_mkimg_simple.spl): it emits a
# structural prefix, the payload is concatenated after it (contiguous at
# PAYLOAD_START), and the image is truncated to the declared total. The payload
# lands at /FSEXEC.ELF (and is aliased at /usr/bin/simple).
#
# The interpreter row stages the SAME way, so when a SimpleOS-targeted `simple`
# binary exists it goes in as the payload instead. Absent that artifact this row
# is ADVISORY/RED — see doc/08_tracking/bug/simpleos_x86_64_hello_world_in_guest_2026-08-31.md.
INTERP_STAGED=0
STAGE_PAYLOAD="$PAYLOAD"
if [ -n "${SIMPLEOS_HELLO_INTERP_ELF:-}" ] && [ -s "${SIMPLEOS_HELLO_INTERP_ELF}" ]; then
    STAGE_PAYLOAD="$SIMPLEOS_HELLO_INTERP_ELF"
    INTERP_STAGED=1
fi
mkdir -p build/os/elfexec_simple
printf 'print("hello world from the in-guest Simple interpreter")\n' \
    > build/os/elfexec_simple/hello.spl
stat -c%s "$STAGE_PAYLOAD" > build/os/elfexec_simple/payload_size.txt
MKOUT=$(SIMPLE_LIB="${SIMPLE_LIB:-src}" "$SEED" run scripts/os/fsexec_mkimg_simple.spl 2>&1) \
    || nothing "FAT32 image writer failed: $(printf '%s' "$MKOUT" | tail -1)"
TOTAL=$(printf '%s\n' "$MKOUT" | sed -n 's/.*total_bytes=\([0-9][0-9]*\).*/\1/p' | tail -1)
[ -n "$TOTAL" ] || nothing "could not parse total_bytes from the FAT32 image writer"
rm -f "$IMG"
cat build/os/elfexec_simple/fat32-simple-prefix.bin "$STAGE_PAYLOAD" > "$IMG"
truncate -s "$TOTAL" "$IMG"
PROGRAMS_STAGED=$((1 + INTERP_STAGED))

# ---------------------------------------------------------------------------
# 4. ESP: self-contained BOOTX64.EFI with the kernel in its memdisk.
# ---------------------------------------------------------------------------
rm -rf "$ESP"; mkdir -p "$ESP/EFI/BOOT"
cp "$OVMF_VARS_SRC" "$OVMF_VARS"
cat > "$WORK/grub.cfg" <<'CFG'
set timeout=0
set default=0
insmod multiboot
insmod normal
menuentry "SimpleOS hello-world in-guest (UEFI/multiboot)" {
    echo "[grub-uefi] multiboot loading /boot/kernel.elf ..."
    multiboot /boot/kernel.elf
    boot
}
CFG
grub-mkstandalone --format=x86_64-efi --output="$EFIAPP" \
    --modules="multiboot normal echo part_gpt fat" \
    "boot/grub/grub.cfg=$WORK/grub.cfg" "boot/kernel.elf=$KERNEL"
[ -f "$EFIAPP" ] || fail "grub-mkstandalone produced no $EFIAPP"

# ---------------------------------------------------------------------------
# 5. Boot under OVMF pflash. argv is assembled first and self-checked.
# ---------------------------------------------------------------------------
QEMU_ARGV="qemu-system-x86_64 -no-user-config -monitor none -nographic -no-reboot \
-machine q35 -cpu qemu64 -m $QEMU_MEM \
-drive if=pflash,format=raw,readonly=on,file=$OVMF_CODE \
-drive if=pflash,format=raw,file=$OVMF_VARS \
-drive file=fat:rw:$ESP,format=raw,id=esp,if=none \
-device virtio-blk-pci,drive=esp,bootindex=0 \
-serial file:$SERIAL \
-drive file=$IMG,if=none,id=nvm,format=raw -device nvme,serial=deadbeef,drive=nvm"
if ! ARGV_ERR=$(assert_real_firmware_argv "$QEMU_ARGV"); then
    nothing "assembled QEMU argv violates the real-firmware rule: $ARGV_ERR"
fi

rm -f "$SERIAL"
# shellcheck disable=SC2086
$QEMU_ARGV >/dev/null 2>&1 &
QEMU_PID=$!
trap 'kill "$QEMU_PID" 2>/dev/null || true' EXIT

i=0
while [ "$i" -lt "$BOOT_WAIT" ]; do
    if [ -f "$SERIAL" ] && { grep -qF 'native program exited' "$SERIAL" 2>/dev/null \
        || grep -qF 'TEST FAILED' "$SERIAL" 2>/dev/null \
        || grep -qF '[hello] FAIL' "$SERIAL" 2>/dev/null; }; then
        break
    fi
    sleep 1
    i=$((i + 1))
done
sleep 2
kill "$QEMU_PID" 2>/dev/null || true
[ -f "$SERIAL" ] || nothing "no serial log produced"

# ---------------------------------------------------------------------------
# 6. Verdict.
# ---------------------------------------------------------------------------
echo "[hello] serial log: $SERIAL"
RUNGS_CHECKED=0
RUNGS_MISSING=''
if scan_rungs "$SERIAL"; then NATIVE_OK=1; else NATIVE_OK=0; fi

INTERP_NOTE='interpreter row ADVISORY/RED: no in-guest Simple interpreter exists in this tree'
if [ "$INTERP_STAGED" = 1 ]; then
    if grep -qF "$INTERP_MARKER" "$SERIAL"; then
        INTERP_NOTE="interpreter row OK ($INTERP_MARKER on serial)"
    else
        INTERP_NOTE="interpreter row FAILED: $INTERP_MARKER absent from serial"
    fi
fi

[ "$RUNGS_CHECKED" -gt 0 ] || nothing "0 rungs evaluated"
[ "$PROGRAMS_STAGED" -gt 0 ] || nothing "0 programs staged"

if [ "$NATIVE_OK" != 1 ]; then
    fail "$PROGRAMS_STAGED program(s) staged, $RUNGS_CHECKED rung(s) checked, missing:$RUNGS_MISSING; $INTERP_NOTE (transcript: $SERIAL)"
fi
if [ "$INTERP_STAGED" = 1 ] && ! grep -qF "$INTERP_MARKER" "$SERIAL"; then
    fail "native hello ran but $INTERP_NOTE (transcript: $SERIAL)"
fi
echo "PASS — $PROGRAMS_STAGED program(s) checked, $RUNGS_CHECKED rung(s) green, hello world printed its own output in-guest under OVMF; $INTERP_NOTE (transcript: $SERIAL)"
