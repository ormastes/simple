#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
source_file="$root/examples/09_embedded/simple_os/arch/arm32/boot/baremetal_stubs.c"
header="$root/examples/09_embedded/simple_os/arch/arm32/boot/arm32_user_transition_contract.h"

for literal in \
    '"FSEXEC  ELF"' \
    'file_size > ARM32_FSEXEC_LOAN_BYTES' \
    'loaded != file_size' \
    'arm32_fat32_rd16(g_arm32_fsexec_loan + 18U) != 40U' \
    'expected_bytes != g_arm32_fsexec_loan' \
    'expected_len != g_arm32_fsexec_loan_len' \
    '((volatile uint8_t *)g_arm32_fsexec_loan)[i] = 0'; do
    rg -F "$literal" "$source_file" >/dev/null || { echo "missing ARM32 FSEXEC loan rule: $literal" >&2; exit 1; }
done
rg -F 'int arm32_fsexec_loan_v16(' "$header" >/dev/null
rg -F 'int arm32_fsexec_release_v16(' "$header" >/dev/null

loan_body=$(sed -n '/int arm32_fsexec_loan_v16(/,/^}/p' "$source_file")
if printf '%s\n' "$loan_body" | rg -n 'Runtime(Value|Array)|__attribute__\(\(weak\)\)' >/dev/null; then
    echo "unstable runtime or weak FSEXEC loan detected" >&2
    exit 1
fi
echo "arm32 mounted FSEXEC loan v16: PASS"
