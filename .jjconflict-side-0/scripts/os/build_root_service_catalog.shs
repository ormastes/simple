#!/bin/sh
# Build the four freestanding images owned by the PID1 root-service catalogue.
#
# The disk bake is intentionally a staging/validation step, not a compiler
# front end. This script is the sole producer for the exact child paths that
# the kernel resolves: PID1, VFS, net and HTTP. Every output remains a raw
# target ELF; make_os_disk.shs applies the legacy SMF envelope only where that
# image writer requires it.
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

TARGET="${SIMPLEOS_SERVICE_TARGET:-x86_64-unknown-simpleos}"
ROOTFS="${SIMPLEOS_SERVICE_ROOTFS:-build/os/rootfs}"
TEST_NET_FAULT_AFTER_READY=false

usage() {
    echo "Usage: sh scripts/os/build_root_service_catalog.shs [--target <triple>] [--rootfs <dir>] [--test-net-fault-after-ready]" >&2
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --target)
            shift
            [ "$#" -gt 0 ] || { usage; exit 2; }
            TARGET="$1"
            ;;
        --target=*) TARGET="${1#*=}" ;;
        --rootfs)
            shift
            [ "$#" -gt 0 ] || { usage; exit 2; }
            ROOTFS="$1"
            ;;
        --rootfs=*) ROOTFS="${1#*=}" ;;
        --test-net-fault-after-ready) TEST_NET_FAULT_AFTER_READY=true ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            echo "error: unknown option: $1" >&2
            usage
            exit 2
            ;;
    esac
    shift
done

case "$TARGET" in
    x86_64-unknown-simpleos)
        BUILD_SCRIPT="scripts/os/simpleos-native-build.shs"
        ELF_MACHINE=62
        ;;
    riscv64-unknown-simpleos)
        BUILD_SCRIPT="scripts/os/simpleos-native-build-riscv64.shs"
        ELF_MACHINE=243
        ;;
    *)
        echo "error: root catalogue payload target is unsupported: $TARGET" >&2
        exit 2
        ;;
esac

validate_target_elf() {
    artifact="$1"
    label="$2"
    [ -s "$artifact" ] || { echo "error: $label output missing: $artifact" >&2; return 1; }
    magic="$(od -An -tx1 -N 4 "$artifact" 2>/dev/null | tr -d ' \n')"
    [ "$magic" = "7f454c46" ] || { echo "error: $label is not ELF: $artifact" >&2; return 1; }
    set -- $(od -An -tu1 -j 18 -N 2 "$artifact" 2>/dev/null)
    [ "$#" -eq 2 ] && [ "$(( $1 + 256 * $2 ))" -eq "$ELF_MACHINE" ] || {
        echo "error: $label has wrong ELF machine for $TARGET: $artifact" >&2
        return 1
    }
    stamp="${artifact}.build_stamp"
    [ -f "$stamp" ] || { echo "error: $label build stamp missing: $stamp" >&2; return 1; }
    grep -Fx "target=$TARGET" "$stamp" >/dev/null || {
        echo "error: $label stamp target mismatch: $stamp" >&2
        return 1
    }
}

build_catalog_entry() {
    entry="$1"
    output="$2"
    label="$3"
    mkdir -p "$(dirname "$output")"
    echo "[catalog] building $label -> $output"
    sh "$BUILD_SCRIPT" --entry "$entry" --output "$output"
    validate_target_elf "$output" "$label"
}

build_catalog_entry \
    src/os/services/init/service_manager_main.spl \
    "$ROOTFS/system/service_manager.smf" \
    "PID1 service manager"
build_catalog_entry \
    src/os/services/vfs/vfs_service_main.spl \
    "$ROOTFS/system/services/vfs.smf" \
    "VFS service"
NET_ENTRY="src/os/services/netstack/net_service_main.spl"
NET_LABEL="network service"
if [ "$TEST_NET_FAULT_AFTER_READY" = true ]; then
    # The alternate entry is test-only and reaches the ordinary net endpoint
    # plus task-exit ABI; production catalogue media never selects it.
    NET_ENTRY="src/os/services/netstack/net_service_fault_after_ready_main.spl"
    NET_LABEL="network service (test fault after ready)"
fi

build_catalog_entry \
    "$NET_ENTRY" \
    "$ROOTFS/system/services/net.smf" \
    "$NET_LABEL"
build_catalog_entry \
    src/os/services/web/http_service_main.spl \
    "$ROOTFS/system/services/http.smf" \
    "HTTP service"

echo "SUCCESS: root service catalogue payloads built for $TARGET"
