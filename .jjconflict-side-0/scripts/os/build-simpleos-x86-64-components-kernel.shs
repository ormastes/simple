#!/bin/sh
# build-simpleos-x86-64-components-kernel.shs <component>
#
# Build build/os/x86_64_components/<component>/kernel.elf — one x86_64 in-guest
# TOOLCHAIN COMPONENT kernel — from tracked Simple source. The x86_64 sibling of
# scripts/os/build-simpleos-aarch64-components-kernel.shs.
#
# <component> is one of: devtool | caret | testrun | mcp
#
# ONE KERNEL PER COMPONENT, on purpose — same reason as the aarch64 lane: a
# combined --entry-closure union left ~500 rt_* symbols undefined on riscv64,
# while the per-component bills were far smaller. Building separately means one
# component's missing closure cannot hold the other three hostage.
#
# COMPILER: the Rust bootstrap SEED, stated loudly. The pure-Simple self-hosted
# compiler cannot compile anything in this tree yet, so every artifact is
# seed-built and the gate's verdict says so rather than implying self-hosting.
#
# The checked-in seed at bin/simple is STALE and manufactures ~34 phantom PARSE
# failures that vanish with zero source changes, so SIMPLE_BIN must point at a
# freshly built seed (`cargo build --release --bin simple` in src/compiler_rust).
#
# --timeout 1200 is passed to native-build deliberately: the 300s default makes
# modules that compile fine "fail". A timeout is not a compile error.
#
# NO STUB FALLBACK. SIMPLE_ALLOW_STUB_FALLBACK is never set here, unlike the
# merged hello-kernel builder which needs it for 19 unrelated src/os modules. A
# component kernel's whole point is that REAL product code ran; a stubbed body
# returns 0 with no link error and no runtime diagnostic, which would turn this
# lane's evidence into a lie. SIMPLE_ALLOW_FREESTANDING_STUBS is a different,
# narrower switch (freestanding runtime shims) and is retained, matching the
# hello kernel that is proven to boot.
#
# Exit status: 0 = a non-empty x86-64 ELF with .text was produced AND the
# component's own row symbol survived --gc-sections; non-zero = nothing usable,
# with the literal linker/compiler tail on stderr. No partial success.
set -eu

REPO_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$REPO_ROOT"

COMPONENT=${1:-}
[ -n "$COMPONENT" ] || { printf 'usage: %s <devtool|caret|testrun|mcp>\n' "$0" >&2; exit 2; }

case "$COMPONENT" in
    devtool) SRC=devtool_component_entry.spl;    SYM=devtool_component_row ;;
    caret)   SRC=caret_component_entry.spl;      SYM=caret_component_row ;;
    testrun) SRC=testrunner_component_entry.spl; SYM=testrunner_component_row ;;
    mcp)     SRC=mcp_component_entry.spl;        SYM=mcp_component_row ;;
    *) printf 'build-x86-64-components: ERROR — unknown component %s\n' "$COMPONENT" >&2; exit 2 ;;
esac

ARCH_DIR=$REPO_ROOT/examples/09_embedded/simple_os/arch/x86_64
OUT_DIR=${OUT_DIR:-$REPO_ROOT/build/os/x86_64_components/$COMPONENT}
SIMPLE_BIN=${SIMPLE_BIN:-$REPO_ROOT/src/compiler_rust/target/release/simple}
ENTRY=$ARCH_DIR/$SRC
# linker_128mb.ld is the script the merged hello lane boots with under
# OVMF -> GRUB-EFI -> multiboot; reuse it rather than inventing a layout.
LDS=${LINKER:-$ARCH_DIR/linker_128mb.ld}
KERNEL=$OUT_DIR/kernel.elf
LOG=$OUT_DIR/kernel-build.log
CACHE=$OUT_DIR/kcache
NB_TIMEOUT=${NATIVE_BUILD_TIMEOUT:-1200}

fail() { printf 'build-x86-64-components[%s]: ERROR — %s\n' "$COMPONENT" "$*" >&2; exit 1; }

[ -x "$SIMPLE_BIN" ] || fail "no compiler at $SIMPLE_BIN (build the seed: cargo build --release --bin simple in src/compiler_rust)"
[ -f "$ENTRY" ] || fail "missing entry $ENTRY"
[ -f "$LDS" ] || fail "missing linker script $LDS"

mkdir -p "$OUT_DIR" build/os/generated
rm -f "$KERNEL"

# The hello kernel's build generates this marker module; the shared src/os
# closure references it, so it must exist for any entry under this arch dir.
printf 'pub fn ssh_live_build_marker() -> text:\n    "x86-64-components-in-guest-ovmf"\n' \
    > build/os/generated/ssh_live_build_marker.spl

OBJCOPY_PREFIX=""
for d in /usr/lib/llvm-23/bin /usr/lib/llvm-20/bin /usr/lib/llvm-19/bin /usr/lib/llvm-18/bin; do
    [ -f "$d/llvm-objcopy" ] && OBJCOPY_PREFIX="$d" && break
done

# Exit status read DIRECTLY into a variable on the next line — never through a
# pipe, whose $? is the last pipeline element's status.
set +e
SIMPLE_BOOTSTRAP=1 SIMPLE_LIB="$REPO_ROOT/src" SIMPLE_OS_LOG_MODE=off \
SIMPLE_ALLOW_FREESTANDING_STUBS=1 \
PATH="${OBJCOPY_PREFIX:+$OBJCOPY_PREFIX:}$PATH" \
    "$SIMPLE_BIN" native-build \
    --source build/os/generated --source src/os --source src/lib \
    --source examples/09_embedded/simple_os \
    --backend cranelift --cpu x86-64-v1 --opt-level=aggressive --log off \
    --entry-closure --cache-dir "$CACHE" \
    --timeout "$NB_TIMEOUT" \
    --entry "$ENTRY" --target x86_64-unknown-none \
    --linker-script "$LDS" -o "$KERNEL" >"$LOG" 2>&1
rc=$?
set -e
[ "$rc" -eq 0 ] || { tail -60 "$LOG" >&2; fail "native-build failed (rc=$rc), log: $LOG"; }

[ -s "$KERNEL" ] || fail "native-build reported success but $KERNEL is missing or empty"

# Structural read-back: a link that silently emitted a host-arch or empty image
# must not report success.
hdr=$(readelf -h "$KERNEL" 2>/dev/null) || fail "readelf could not parse $KERNEL"
case "$hdr" in
    *X86-64*) ;;
    *) fail "$KERNEL is not an x86-64 ELF" ;;
esac
readelf -SW "$KERNEL" 2>/dev/null | grep -q ' \.text ' \
    || fail "$KERNEL has no .text section (empty-link false success)"

# Real-not-stub check: --gc-sections has previously discarded an unrooted
# reachable graph and still reported a successful link.
readelf -sW "$KERNEL" 2>/dev/null | grep -q "$SYM" \
    || fail "$KERNEL contains no $SYM symbol (the component was garbage-collected out)"

size=$(wc -c <"$KERNEL")
printf 'PASS — x86_64 %s component kernel built by the RUST SEED (%s): %s (%s bytes, x86-64 ELF with .text and %s)\n' \
    "$COMPONENT" "$SIMPLE_BIN" "$KERNEL" "$size" "$SYM"
