# Repo-facing forbidden-I/O context scan.
#
# Populates a real ForbiddenIoContextManifest from source under
# src/lib/nogc_async_mut_noalloc and src/compiler/99.loader and runs it
# through forbidden_io_checker.check_all_forbidden_io_fns.

use compiler.tools.verify.forbidden_io_context_scan.{
    scan_forbidden_io_functions, count_forbidden_io_context_functions,
    check_scanned_forbidden_io_functions,
    forbidden_io_context_scan_exit_code,
    format_forbidden_io_context_scan_output,
    SCAN_ROOTS
}


use std.io.{exit_i32}
val scanned = scan_forbidden_io_functions()
val tagged_count = count_forbidden_io_context_functions(scanned)
val messages = check_scanned_forbidden_io_functions(scanned)
for line in format_forbidden_io_context_scan_output(tagged_count, messages, SCAN_ROOTS):
    print line
val exit_code = forbidden_io_context_scan_exit_code(messages)
if exit_code != 0:
    exit_i32(exit_code)
