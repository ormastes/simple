#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/os/installer/image_builder.spl"
owner="$root/src/lib/nogc_sync_mut/io_runtime.spl"
registry="$root/src/compiler_rust/compiler/src/codegen/runtime_sffi.rs"
interpreter="$root/src/compiler_rust/compiler/src/interpreter_extern/mod.rs"

! grep -q '^extern fn rt_' "$module"
grep -q '^use std.io_runtime.{' "$module"
[ "$(grep -Ec '\bimage_(process_run_timeout|file_exists|file_write_text|file_write_bytes|dir_create_all|dir_list|dir_exists|file_size)\(' "$module")" -eq 24 ]

# Exact owners preserve the builder's failure distinctions and one-call shape.
grep -A3 -q '^pub fn file_size_signed(path: text) -> i64:' "$owner"
grep -A3 -q '^pub fn dir_list_optional(path: text) -> \[text\]?:' "$owner"
grep -B1 -q '^pub fn process_run_timeout' "$owner"
grep -q 'if size < 0:' "$module"
grep -q 'if listed == nil:' "$module"
grep -q 'val entries = listed ?? \[\]' "$module"
grep -q 'image_process_run_timeout("/bin/sh", args, 120000)' "$module"
grep -q 'image_process_run_timeout("/bin/sh", \["-c", cmd\], 15000)' "$module"

for symbol in rt_process_run_timeout rt_file_exists rt_file_write_text rt_file_write_bytes rt_dir_create_all rt_dir_list rt_dir_exists rt_file_size; do
    grep -q "RuntimeFuncSpec::new(\"$symbol\"" "$registry"
    grep -q "insert_simple!(\"$symbol\"" "$interpreter"
done

echo "Image-builder SFFI authority audit: PASS (24 private raw calls routed through 8 canonical owners; signed size/nullable listing and exact one-call writes preserved; process tuple owner mandatory-inline; 8/8 providers in both registries)"
