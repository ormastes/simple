#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
provider="$root/src/runtime/spl_winit/src/lib.rs"
interpreter="$root/src/compiler_rust/compiler/src/interpreter_extern/winit_sffi"
wrapper="$root/src/lib/nogc_sync_mut/io/window_winit.spl"

for symbol in rt_winit_event_loop_new rt_winit_window_new rt_winit_event_free \
    rt_winit_window_free rt_winit_event_loop_free; do
    if ! grep -B1 -F "extern fn $symbol" "$wrapper" | grep -Fq 'sentinel'; then
        echo "FAIL: $symbol lacks exact failure metadata" >&2
        exit 1
    fi
done

for signature in \
    'fn winit_loop_free(lp: WinitLoop) -> bool:' \
    'fn winit_window_free(win: WinitWindow) -> bool:'; do
    if ! grep -Fq "$signature" "$wrapper"; then
        echo "FAIL: lifecycle wrapper does not propagate status: $signature" >&2
        exit 1
    fi
done

for name in winit_loop_new winit_loop_free winit_window_new winit_window_free; do
    body=$(sed -n "/^fn $name(/,/^$/p" "$wrapper")
    if ! printf '%s\n' "$body" | grep -Fq 'unsafe(capabilities: [ffi]):'; then
        echo "FAIL: $name lacks lexical FFI scope" >&2
        exit 1
    fi
    if [ "$(printf '%s\n' "$body" | grep -c 'rt_winit_' || true)" -ne 1 ]; then
        echo "FAIL: $name must retain exactly one provider call" >&2
        exit 1
    fi
    if printf '%s\n' "$body" | grep -Eq 'alloc|mutex|hash|dlsym|last_error|retry'; then
        echo "FAIL: $name gained allocation, lookup, lock, hash, error-query, or retry work" >&2
        exit 1
    fi
done

if ! grep -q 'stored_events.remove(&ev).is_some() as i64' "$provider" ||
   ! grep -q 'windows.remove(&win)' "$provider" ||
   ! grep -q 'el != 1 || state.is_none()' "$provider"; then
    echo 'FAIL: Rust provider lifecycle release does not reject stale handles' >&2
    exit 1
fi
if ! grep -Rq 'remove(&event_id).is_some()' "$interpreter" ||
   ! grep -Rq 'invalid event loop handle' "$interpreter"; then
    echo 'FAIL: interpreter lifecycle release does not reject stale handles' >&2
    exit 1
fi

echo 'PASS: Winit lifecycle ownership propagates status without extra calls or retained memory'
