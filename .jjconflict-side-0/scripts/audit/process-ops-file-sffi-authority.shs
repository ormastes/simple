#!/bin/sh
set -eu

module=src/app/io/process_ops.spl

test "$(rg '^extern fn rt_file_(read_text|read_text_at_checked|size)' "$module" | wc -l)" -eq 0
test "$(rg 'rt_file_(read_text|read_text_at_checked|size)\(' "$module" | wc -l)" -eq 0
rg -q 'read_file_text_result' "$module"
rg -q 'file_size_signed' "$module"
rg -q 'file_read_text_at' "$module"
rg -q '^@always_inline$' "$module"

# Preserve the incremental relay: positional reads begin at the relayed byte
# count and request only the newly appended suffix.
rg -q '_read_text_at_checked(stdout_file, stdout_relayed, out_size - stdout_relayed)' "$module"
rg -q '_read_text_at_checked(stderr_file, stderr_relayed, err_size - stderr_relayed)' "$module"
