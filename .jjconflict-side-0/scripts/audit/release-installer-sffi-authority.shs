#!/bin/sh
set -eu

module=src/app/release/install.spl

test "$(rg '^extern fn rt_(file_read_bytes|dir_create)' "$module" | wc -l)" -eq 0
test "$(rg 'rt_(file_read_bytes|dir_create)\(' "$module" | wc -l)" -eq 0
rg -q 'file_read_bytes_result' "$module"
rg -q 'use std\.nogc_sync_mut\.io\.dir_ops\.\{dir_create\}' "$module"
rg -q '^fn copy_source_tree.*-> bool:' "$module"
rg -q 'if not copy_source_tree' "$module"

# Hash checks remain one read per selected file; no existence/read retry is
# introduced inside the hash helper.
helper="$(sed -n '/^fn _file_hash_matches/,/^fn copy_font_tree/p' "$module")"
test "$(printf '%s\n' "$helper" | rg 'file_read_bytes_result\(' | wc -l)" -eq 1
