#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/runtime/simple_core/core_any_ops.spl"
provider="$root/src/runtime/simple_core/core_values.spl"
native_provider="$root/src/runtime/runtime.c"
interpreter_registry="$root/src/compiler_rust/compiler/src/interpreter_extern/mod.rs"
llvm_attrs="$root/src/compiler_rust/compiler/src/codegen/llvm/backend_core.rs"
selfhost_inline="$root/src/compiler/60.mir_opt/mir_opt/_Inline/policy.spl"

for raw in spl_bits_to_f64 rt_value_int rt_value_as_int rt_value_float; do
    [ "$(grep -Ec "^extern fn ${raw}\\(" "$module")" -eq 1 ]
    [ "$(grep -Ec "^[[:space:]]+${raw}\\(" "$module")" -eq 1 ]
done

[ "$(grep -c '^@unsafe(' "$module")" -eq 4 ]
[ "$(grep -c '^@always_inline$' "$module")" -eq 4 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$module")" -eq 4 ]
for expected in _sffi_bits_to_f64:2 _sffi_value_int:7 \
    _sffi_value_as_int:18 _sffi_value_float:2; do
    owner=${expected%%:*}
    count=${expected##*:}
    [ "$(grep -o "${owner}(" "$module" | wc -l)" -eq "$count" ]
done

if grep -q 'spl_f64_to_bits' "$module"; then
    echo "simple-core any ops regained its unused f64-to-bits declaration" >&2
    exit 1
fi
for helper in rt_value_int rt_value_as_int rt_value_float; do
    grep -Eq "^pub fn ${helper}\\(" "$provider"
done
grep -Eq '^double spl_bits_to_f64\(' "$native_provider"
grep -q 'insert_simple!("spl_bits_to_f64"' "$interpreter_registry"
grep -q 'attr == "inline" || attr == "always_inline"' "$llvm_attrs"
grep -q 'func.name.contains("@always_inline")' "$selfhost_inline"

echo "simple-core any-ops authority audit: PASS (all used raw calls confined; no added allocation or dispatch)"
