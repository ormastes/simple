#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/compiler/20.hir/hir_lowering/_Items/lowering_helpers.spl"
registry="$root/src/compiler_rust/compiler/src/codegen/runtime_sffi.rs"
interpreter="$root/src/compiler_rust/compiler/src/interpreter_extern/mod.rs"
llvm_attrs="$root/src/compiler_rust/compiler/src/codegen/llvm/backend_core.rs"
selfhost_inline="$root/src/compiler/60.mir_opt/mir_opt/_Inline/policy.spl"

for suffix in env_get exit transient_heap_promote; do
    raw="rt_$suffix"
    owner="_sffi_$suffix"
    [ "$(grep -Ec "^extern fn ${raw}\\(" "$module")" -eq 1 ]
    [ "$(grep -Ec "^[[:space:]]+${raw}\\(" "$module")" -eq 1 ]
    [ "$(grep -Ec "^fn ${owner}\\(" "$module")" -eq 1 ]
    grep -q "RuntimeFuncSpec::new(\"$raw\"" "$registry"
    grep -q "insert_simple!(\"$raw\"" "$interpreter"
done

grep -q '^extern fn rt_env_get(key: text) -> text?$' "$module"
[ "$(grep -c '^@unsafe(' "$module")" -eq 3 ]
[ "$(grep -c '^@always_inline$' "$module")" -eq 3 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$module")" -eq 3 ]
[ "$(grep -o '_sffi_env_get(' "$module" | wc -l)" -eq 6 ]
[ "$(grep -o '_sffi_exit(' "$module" | wc -l)" -eq 3 ]
[ "$(grep -o '_sffi_transient_heap_promote(' "$module" | wc -l)" -eq 15 ]

grep -q 'rt_exit returned after bootstrap HIR store rejection' "$module"
grep -q 'rt_exit returned after bootstrap HIR function bounds failure' "$module"

# Fourteen existing promotion calls remain one call each and their verdicts
# remain combined. Mandatory inlining adds no graph walk, allocation, copy,
# lookup, or dispatch to the bootstrap publication path.
[ "$(sed -n '/^fn bootstrap_hir_modules_promote_last/,/^fn bootstrap_hir_modules_rollback_last/p' "$module" | grep -c '_sffi_transient_heap_promote(')" -eq 14 ]
grep -q 'attr == "inline" || attr == "always_inline"' "$llvm_attrs"
grep -q 'func.name.contains("@always_inline")' "$selfhost_inline"

echo "HIR lowering-helper SFFI authority audit: PASS (3 raw ABIs confined; 14 promotion verdicts preserved; returning exit provider fails closed; hot publication work unchanged)"
