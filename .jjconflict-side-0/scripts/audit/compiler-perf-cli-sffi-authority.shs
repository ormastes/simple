#!/bin/sh
set -eu

main=src/compiler/90.tools/perf/main.spl
optimizer=src/compiler/90.tools/perf/optimizer.spl
owner=src/lib/nogc_sync_mut/sffi/cli.spl

for module in "$main" "$optimizer"; do
    if rg -q '^extern fn rt_get_args|rt_get_args\(' "$module"; then
        echo "$module must use the canonical CLI owner" >&2
        exit 1
    fi
    test "$(rg -c '^use std\.sffi\.cli\.\{cli_get_args\}' "$module")" -eq 1
    test "$(rg -c 'val args = cli_get_args\(\)' "$module")" -eq 1
done

rg -Uq '@unsafe\(reason: "raw process argument-array ownership ABI", capabilities: \[ffi\]\)\nextern fn sys_get_args\(\) -> \[text\]' "$owner"
test "$(rg -c 'sys_get_args\(\)' "$owner")" -eq 4
