#!/bin/sh
set -eu

provider=src/compiler_rust/compiler/src/interpreter_extern/memory.rs
registration=src/compiler_rust/compiler/src/interpreter_extern/mod.rs
registry=src/compiler_rust/compiler/src/codegen/runtime_sffi.rs
native_header=src/runtime/runtime.h

for name in rt_mem_harden_check rt_mem_guard_stats \
    rt_mem_profile_abi_version rt_mem_profile_features; do
    body="$(sed -n "/^pub fn ${name}/,/^}/p" "$provider")"
    printf '%s\n' "$body" | rg -q 'if !args.is_empty\(\)'
    printf '%s\n' "$body" | rg -q 'return Err\(CompileError::runtime'
    rg -q "insert_simple!\(\"${name}\"" "$registration"
    ! rg -q "RuntimeFuncSpec::new\(\"${name}\"" "$registry"
    ! rg -q "[[:space:]]${name}\(" "$native_header"
done

echo "interpreter memory-profile SFFI contract audit: PASS (exact arity; interpreter-only registration remains unverified)"
