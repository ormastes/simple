#!/bin/sh
set -eu

module=src/compiler/85.mdsoc/layer_doc_checker.spl

if rg -q '^extern fn rt_file_read_text|rt_file_read_text\(' "$module"; then
    echo "layer documentation checker must use the typed file facade" >&2
    exit 1
fi

test "$(rg -c '^use std\.io_runtime\.\{file_exists, file_read_result\}' "$module")" -eq 1
test "$(rg -c 'match file_read_result\(filepath\):' "$module")" -eq 4
test "$(rg -c 'case Err\(_\): return false' "$module")" -eq 2
test "$(rg -c 'case Err\(_\): return "unknown"' "$module")" -eq 1
test "$(rg -c 'case Err\(_\): return 0' "$module")" -eq 1
if rg -q 'file_read_result\(filepath\).*\?\? ""' "$module"; then
    echo "layer documentation reads must not fabricate empty text" >&2
    exit 1
fi
