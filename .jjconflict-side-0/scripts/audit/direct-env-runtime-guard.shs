#!/bin/sh
# Guard against local env/process runtime calls outside owner modules.
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

MODE="${1:---all}"

usage() {
    cat <<'EOF'
Usage: sh scripts/audit/direct-env-runtime-guard.shs [--all|--working|--staged|--self-test]

Blocks direct rt_env_get/cwd and direct process run/spawn/lifecycle calls or
imports in production app leaf code and gc_async_mut lib code outside runtime
owner modules. Use app/std/gc env and process facades instead.

Scope is intentionally src/app plus src/lib/gc_async_mut. Examples, tests,
compiler/bootstrap modules, and lower runtime owner layers are audited/fixed in
their own lanes; the 8K showcase has a documented local runtime-env boundary in
doc/08_tracking/bug/interp_io_runtime_env_get_option_text_corruption_2026-06-19.md.
EOF
}

case "$MODE" in
    --all|--working|--staged|--self-test) ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
esac

FORBIDDEN_DIRECT_ENV_PROCESS_RE='extern fn rt_env_(get|cwd)[[:space:]]*\(|rt_env_(get|cwd)[[:space:]]*\(|extern fn rt_process_(run(_timeout|_bounded|_inherit)?|spawn_async|spawn_inherit|wait|is_running|is_alive|kill)[[:space:]]*\(|rt_process_(run(_timeout|_bounded|_inherit)?|spawn_async|spawn_inherit|wait|is_running|is_alive|kill)[[:space:]]*\(|^(use|import|from|export[[:space:]]+use)[[:space:]].*rt_env_(get|cwd)([^[:alnum:]_]|$)|^(use|import|from|export[[:space:]]+use)[[:space:]].*rt_process_(run(_timeout|_bounded|_inherit)?|spawn_async|spawn_inherit|wait|is_running|is_alive|kill)([^[:alnum:]_]|$)'

is_allowed_owner() {
    case "$1" in
        src/app/io/process_ops.spl) return 0 ;;
        src/app/io/process_env_ops.spl) return 0 ;;
        src/app/io/minimal_runtime_ops.spl) return 0 ;;
        src/app/ffi_gen.specs/*) return 0 ;;
        src/lib/nogc_sync_mut/io/env_ops.spl) return 0 ;;
    esac
    return 1
}

path_has_violation() {
    logical_path="$1"
    source_path="$2"
    is_allowed_owner "$logical_path" && return 1
    grep -nE "$FORBIDDEN_DIRECT_ENV_PROCESS_RE" "$source_path" >/dev/null
}

print_remediation() {
    cat <<'EOF'
Fix: replace leaf runtime calls with canonical facades:
  rt_env_get / rt_env_cwd -> app.io.env_ops.{env_get,cwd}
  run/spawn/wait/kill     -> app.io.process_ops
  rt_process_is_alive     -> app.io.process_env_ops.{process_is_alive}
Keep raw rt_* declarations only in the designated owner modules listed by this guard.
Candidate/auto-fix preview for the supported std.io_runtime subset
(rt_env_get, rt_process_run, rt_process_run_timeout, rt_process_is_running):
  sh scripts/spipe/rt_migration_cycle.shs --dry-run
The dry-run does not mutate. Review its candidates before running the migration
cycle without --dry-run, which edits and commits selected files. Unsupported or
ambiguous sites require manual facade selection.
EOF
}

self_test() {
    tmp_dir="${TMPDIR:-/tmp}/direct-env-runtime-guard.$$"
    mkdir -p "$tmp_dir"
    trap 'rm -rf "$tmp_dir"' EXIT
    printf '%s\n' 'use std.env.types.{rt_process_run}' >"$tmp_dir/raw_import.spl"
    printf '%s\n' 'use app.io.mod.{process_run_timeout}' >"$tmp_dir/facade_import.spl"
    printf '%s\n' 'val result = rt_process_spawn_async("sh", ["-c", "true"])' >"$tmp_dir/raw_call.spl"
    printf '%s\n' 'extern fn rt_process_run_inherit(cmd: text, args: [text]) -> i64' >"$tmp_dir/raw_inherit.spl"
    printf '%s\n' 'extern fn rt_process_run_bounded(cmd: text, args: [text], timeout_ms: i64, max_bytes: i64) -> auto' >"$tmp_dir/raw_bounded.spl"
    printf '%s\n' 'val pid = rt_process_spawn_inherit()' >"$tmp_dir/raw_spawn_inherit.spl"
    printf '%s\n' 'extern fn rt_env_get_var(env_handle: i64, name: text) -> auto' >"$tmp_dir/env_handle_owner.spl"

    grep -nE "$FORBIDDEN_DIRECT_ENV_PROCESS_RE" "$tmp_dir/raw_import.spl" >/dev/null || {
        echo "STATUS: FAIL direct-env-runtime-guard self-test raw import not detected" >&2
        exit 1
    }
    grep -nE "$FORBIDDEN_DIRECT_ENV_PROCESS_RE" "$tmp_dir/raw_call.spl" >/dev/null || {
        echo "STATUS: FAIL direct-env-runtime-guard self-test raw call not detected" >&2
        exit 1
    }
    grep -nE "$FORBIDDEN_DIRECT_ENV_PROCESS_RE" "$tmp_dir/raw_inherit.spl" >/dev/null || {
        echo "STATUS: FAIL direct-env-runtime-guard self-test raw inherit not detected" >&2
        exit 1
    }
    grep -nE "$FORBIDDEN_DIRECT_ENV_PROCESS_RE" "$tmp_dir/raw_bounded.spl" >/dev/null || {
        echo "STATUS: FAIL direct-env-runtime-guard self-test raw bounded run not detected" >&2
        exit 1
    }
    grep -nE "$FORBIDDEN_DIRECT_ENV_PROCESS_RE" "$tmp_dir/raw_spawn_inherit.spl" >/dev/null || {
        echo "STATUS: FAIL direct-env-runtime-guard self-test raw inherited spawn not detected" >&2
        exit 1
    }
    if path_has_violation "src/app/io/process_ops.spl" "$tmp_dir/raw_inherit.spl"; then
        echo "STATUS: FAIL direct-env-runtime-guard self-test process owner provider rejected" >&2
        exit 1
    fi
    if path_has_violation "src/app/io/process_env_ops.spl" "$tmp_dir/raw_call.spl"; then
        echo "STATUS: FAIL direct-env-runtime-guard self-test process env owner provider rejected" >&2
        exit 1
    fi
    path_has_violation "src/app/io/cli_ops.spl" "$tmp_dir/raw_inherit.spl" || {
        echo "STATUS: FAIL direct-env-runtime-guard self-test cli leaf owner leak" >&2
        exit 1
    }
    path_has_violation "src/app/io/process_ops_extra.spl" "$tmp_dir/raw_inherit.spl" || {
        echo "STATUS: FAIL direct-env-runtime-guard self-test adjacent owner name leak" >&2
        exit 1
    }
    if grep -nE "$FORBIDDEN_DIRECT_ENV_PROCESS_RE" "$tmp_dir/facade_import.spl" >/dev/null; then
        echo "STATUS: FAIL direct-env-runtime-guard self-test facade import rejected" >&2
        exit 1
    fi
    if grep -nE "$FORBIDDEN_DIRECT_ENV_PROCESS_RE" "$tmp_dir/env_handle_owner.spl" >/dev/null; then
        echo "STATUS: FAIL direct-env-runtime-guard self-test env handle owner rejected" >&2
        exit 1
    fi
    remediation="$(print_remediation)"
    printf '%s\n' "$remediation" | grep -F 'rt_env_get / rt_env_cwd -> app.io.env_ops.{env_get,cwd}' >/dev/null || {
        echo "STATUS: FAIL direct-env-runtime-guard self-test env remediation missing" >&2
        exit 1
    }
    printf '%s\n' "$remediation" | grep -F 'run/spawn/wait/kill     -> app.io.process_ops' >/dev/null || {
        echo "STATUS: FAIL direct-env-runtime-guard self-test remediation facade missing" >&2
        exit 1
    }
    printf '%s\n' "$remediation" | grep -F 'rt_process_is_alive     -> app.io.process_env_ops.{process_is_alive}' >/dev/null || {
        echo "STATUS: FAIL direct-env-runtime-guard self-test is-alive facade missing" >&2
        exit 1
    }
    printf '%s\n' "$remediation" | grep -F '(rt_env_get, rt_process_run, rt_process_run_timeout, rt_process_is_running)' >/dev/null || {
        echo "STATUS: FAIL direct-env-runtime-guard self-test auto-fix scope missing" >&2
        exit 1
    }
    printf '%s\n' "$remediation" | grep -F 'rt_migration_cycle.shs --dry-run' >/dev/null || {
        echo "STATUS: FAIL direct-env-runtime-guard self-test remediation auto-fix preview missing" >&2
        exit 1
    }
    printf '%s\n' "$remediation" | grep -F 'The dry-run does not mutate.' >/dev/null || {
        echo "STATUS: FAIL direct-env-runtime-guard self-test dry-run safety missing" >&2
        exit 1
    }
    printf '%s\n' "$remediation" | grep -F 'which edits and commits selected files.' >/dev/null || {
        echo "STATUS: FAIL direct-env-runtime-guard self-test mutation warning missing" >&2
        exit 1
    }

    echo "STATUS: PASS direct-env-runtime-guard self-test"
}

if [ "$MODE" = "--self-test" ]; then
    self_test
    exit 0
fi

paths_for_mode() {
    case "$MODE" in
        --all)
            if [ -e .git ]; then
                git ls-files src/app src/lib/gc_async_mut | grep '\.spl$' || true
            elif [ -d .jj ] && command -v jj >/dev/null 2>&1; then
                jj file list src/app src/lib/gc_async_mut | grep '\.spl$' || true
            fi
            ;;
        --working)
            if [ -e .git ]; then
                {
                    git diff --name-only -- src/app src/lib/gc_async_mut
                    git ls-files --others --exclude-standard -- src/app src/lib/gc_async_mut
                } | grep '\.spl$' || true
            elif [ -d .jj ] && command -v jj >/dev/null 2>&1; then
                jj diff --name-only -- src/app src/lib/gc_async_mut | grep '\.spl$' || true
            fi
            ;;
        --staged)
            if [ -e .git ]; then
                git diff --cached --name-only -- src/app src/lib/gc_async_mut | grep '\.spl$' || true
            fi
            ;;
    esac
}

failures=""
for path in $(paths_for_mode | sort -u); do
    [ -f "$path" ] || continue
    is_allowed_owner "$path" && continue
    if grep -nE "$FORBIDDEN_DIRECT_ENV_PROCESS_RE" "$path" >/tmp/direct-env-runtime-guard.$$ 2>/dev/null; then
        while IFS= read -r line; do
            failures="${failures}${path}:${line}
"
        done < /tmp/direct-env-runtime-guard.$$
    fi
done
rm -f /tmp/direct-env-runtime-guard.$$

if [ -n "$failures" ]; then
    printf '%s' "$failures" >&2
    print_remediation >&2
    echo "STATUS: FAIL direct env/process runtime call outside owners" >&2
    exit 1
fi

echo "STATUS: PASS direct-env-runtime-guard"
