#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/os/kernel/loader/x86_64_fs_exec_ring3.spl"
registry="$root/src/compiler_rust/compiler/src/codegen/runtime_sffi.rs"
interpreter="$root/src/compiler_rust/compiler/src/interpreter_extern/mod.rs"

[ "$(grep -c '^extern fn ' "$module")" -eq 8 ]
[ "$(grep -c '^@unsafe(reason:' "$module")" -eq 18 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$module")" -eq 1 ]
[ "$(grep -c '^@always_inline$' "$module" || true)" -eq 0 ]

call_count=$(perl -ne '
    s/#.*//;
    next if /^extern fn /;
    while (/\b(?:serial_println|pmm_alloc_page_raw|simpleos_fat32_stream_read_at|rt_text_to_bytes|rt_text_copy_to_phys|rt_user_heap_init(?:_returning)?|rt_x86_ring3_exit_rc)\b/g) { $count++ }
    END { print $count + 0 }
' "$module")
[ "$call_count" -eq 39 ]

symbols=$(awk '/^extern fn /{name=$3; sub(/\(.*/, "", name); print name}' "$module")
both=0
one=0
none=0
for symbol in $symbols; do
    providers=0
    grep -q "RuntimeFuncSpec::new(\"$symbol\"" "$registry" && providers=$((providers + 1))
    grep -q "insert_simple!(\"$symbol\"" "$interpreter" && providers=$((providers + 1))
    case "$providers" in
        2) both=$((both + 1)) ;;
        1) one=$((one + 1)) ;;
        0) none=$((none + 1)) ;;
    esac
done
[ "$both" -eq 0 ]
[ "$one" -eq 2 ]
[ "$none" -eq 6 ]

grep -q 'MAX_IMAGE_SPAN: u64 = 0x40000000' "$module"
grep -q '(flags & (PF_W | PF_X)) == (PF_W | PF_X)' "$module"
grep -q 'entry_is_file_backed_executable = true' "$module"

echo "x86 ring-3 loader SFFI authority audit: PASS (39 calls/8 symbols; 8 unsafe declarations + 10 raw-memory/handoff owners + 1 lexical text owner; 0 both/2 one/6 no-provider; ELF bounds/W^X/entry checks retained; no forced inlining)"
