#!/bin/sh
# The legacy engine2d CUDA session is deliberately pure cache bookkeeping.
# Real CUDA execution belongs to the typed CUDA owners, never to this old
# providerless facade.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
source="$root/src/lib/nogc_sync_mut/gpu/engine2d/cuda_session.spl"

test "$(grep -c '^extern fn ' "$source")" -eq 0
! grep -Eq '^[[:space:]]*.*rt_cuda_[A-Za-z0-9_]*\(' "$source"
grep -q 'contains no SFFI boundary' "$source"
grep -q 'class CudaModuleCache:' "$source"
grep -q 'class CudaComputeSession:' "$source"

echo 'CUDA session providerless guard: PASS (pure bounded cache; no raw CUDA externs)'
