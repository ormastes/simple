#!/bin/sh
set -eu

decl=src/compiler_rust/lib/std/src/infra/hash.spl
interpreter=src/compiler_rust/compiler/src/interpreter_extern/sha256.rs
registration=src/compiler_rust/compiler/src/interpreter_extern/mod.rs
native=src/compiler_rust/runtime/src/value/sffi/hash/sha256.rs

rg -q '^extern fn rt_sha256_finish\(hasher: i64\) -> text\?$' "$decl"
rg -q '^extern fn rt_sha256_finish_bytes\(hasher: i64\) -> \[u8\]\?$' "$decl"
wrapper="$(sed -n '/^struct Sha256Hasher:/,/^struct /p' "$decl")"
printf '%s\n' "$wrapper" | rg -q 'E-SFFI-SHA256-NEW'
printf '%s\n' "$wrapper" | rg -q 'E-SFFI-SHA256-INVALID-HANDLE'
! printf '%s\n' "$wrapper" | rg -q 'rt_sha256_finish\(self\._handle\) as u64'
! printf '%s\n' "$wrapper" | rg -q 'rt_sha256_finish_bytes\([^)]*,'

body="$(sed -n '/^pub fn rt_sha256_finish_bytes/,/^}/p' "$interpreter")"
printf '%s\n' "$body" | rg -q 'require_arity\(args, 1, "rt_sha256_finish_bytes"\)'
printf '%s\n' "$body" | rg -q 'Value::byte_array'
rg -q 'insert_simple!\("rt_sha256_finish_bytes", sha256::rt_sha256_finish_bytes\);' "$registration"

native_finish="$(sed -n '/^pub extern "C" fn rt_sha256_finish_bytes/,/^}/p' "$native")"
printf '%s\n' "$native_finish" | rg -q 'vec_to_runtime_byte_array'
! printf '%s\n' "$native_finish" | rg -q 'rt_string_new'
helper="$(sed -n '/^fn vec_to_runtime_byte_array/,/^}/p' "$native")"
printf '%s\n' "$helper" | rg -q 'byte_array_write\(array, bytes\)'
! printf '%s\n' "$helper" | rg -q 'rt_bytes_u8_set'

native_write="$(sed -n '/^pub unsafe extern "C" fn rt_sha256_write/,/^}/p' "$native")"
printf '%s\n' "$native_write" | rg -q 'usize::try_from\(data_len\)'
! printf '%s\n' "$native_write" | rg -q 'data_len as usize'
rg -q 'fetch_update(' "$native"

echo "SHA-256 SFFI return audit: PASS (typed cross-lane returns; strict handles/length; bulk digest copy)"
