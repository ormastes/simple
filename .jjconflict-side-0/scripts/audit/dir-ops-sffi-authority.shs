#!/bin/sh
set -eu

module=src/lib/nogc_sync_mut/io/dir_ops.spl

test "$(rg -c '^@unsafe\(reason: .*capabilities: \[ffi\]\)$' "$module")" -ge 5
test "$(rg -c '^fn _dir_(create|remove|remove_all|walk)_raw' "$module")" -eq 4
test "$(rg -c 'unsafe\(capabilities: \[ffi\]\):' "$module")" -eq 4

for symbol in rt_dir_create rt_dir_remove rt_dir_remove_all rt_dir_walk; do
    test "$(rg -c "${symbol}\\(" "$module")" -eq 2
done

rg -q '^@unsafe\(reason: "legacy native walk collapses provider failure to an empty array"' "$module"
rg -q '^fn dir_walk_native\(path: text\) -> \[text\]:' "$module"
