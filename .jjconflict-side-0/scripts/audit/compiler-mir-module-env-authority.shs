#!/bin/sh
set -eu

module=src/compiler/50.mir/_MirLowering/module_lowering.spl

if rg -q '^extern fn rt_env_get\(' "$module"; then
    echo "MIR module lowering must not redeclare raw environment authority" >&2
    exit 1
fi
rg -q '^use std\.io_runtime\.\{env_get_opt\}$' "$module"
rg -q '^@always_inline$' "$module"
test "$(rg -c 'env_get_opt\(' "$module")" -eq 1
test "$(rg -c 'mir_lower_env_get\(' "$module")" -eq 5
test "$(rg -c 'mir_lower_env_get\("SIMPLE_' "$module")" -eq 4
