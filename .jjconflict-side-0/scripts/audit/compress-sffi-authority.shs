#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/lib/nogc_sync_mut/io/compress_sffi.spl"
registry="$root/src/compiler_rust/compiler/src/codegen/runtime_sffi.rs"
interpreter="$root/src/compiler_rust/compiler/src/interpreter_extern/mod.rs"

[ "$(grep -Ec '^extern fn rt_(gzip|deflate|zip|tar|targz)_' "$module")" -eq 24 ]
[ "$(grep -c '^@unsafe(reason:' "$module")" -eq 52 ]
[ "$(grep -c '^fn ' "$module")" -eq 29 ]
grep -q '^fn compression_level_to_int' "$module"

calls=$(perl -0ne '
    s/""".*?"""//sg; s/#.*//mg; s/^\s*extern fn .*\n//mg;
    while (/\brt_(?:gzip|deflate|zip|tar|targz)_[A-Za-z0-9_]*\s*\(/g) { $n++ }
    END { print $n + 0 }
' "$module")
[ "$calls" -eq 24 ]

symbols=$(sed -n 's/^extern fn \(rt_\(gzip\|deflate\|zip\|tar\|targz\)_[A-Za-z0-9_]*\).*/\1/p' "$module")
for symbol in $symbols; do
    ! grep -q "RuntimeFuncSpec::new(\"$symbol\"" "$registry"
    ! grep -q "insert_simple!(\"$symbol\"" "$interpreter"
done

# Four convenience APIs transitively expose the same unbacked boundary.
[ "$(grep -c '^@unsafe(reason: "transitively uses' "$module")" -eq 4 ]
! grep -q '^@always_inline$' "$module"
! grep -q 'unsafe(capabilities:' "$module"
grep -q 'result == 1' "$module"

echo "Compression SFFI authority audit: PASS (24 raw declarations/24 direct and 4 transitive wrappers unsafe; 0/24 providers registered; semantic status/sentinel behavior unchanged; no wrapper/branch/allocation/dispatch added)"
