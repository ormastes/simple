#!/bin/sh
# trace-symbol-across-revs.shs <path> <pattern> [rev...]
# Print, for each rev, how many times <pattern> occurs in <path> at that rev.
# Used to decide whether a missing definition was CLOBBERED (present at a
# parent, absent after) or never existed — restoring vs. fabricating.
set -u
ROOT=$(cd "$(dirname "$0")/../.." && pwd)
cd "$ROOT"
P="$1"; PAT="$2"; shift 2
for r in "$@"; do
    n=$(git show "$r:$P" 2>/dev/null | grep -c "$PAT")
    printf '%s\t%s\n' "$r" "$n"
done
