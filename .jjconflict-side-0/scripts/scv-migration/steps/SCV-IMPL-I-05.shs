#!/bin/sh
# SCV-IMPL-I-05 — confidence calibration corpus + oracle: curated
# rename/move/extract corpus (test/fixtures/scv_identity_corpus, 34 cases),
# classes Explicit/Verified-high/Inferred/Unresolved, auto-accepted relation
# precision >= 99.5% gated by check-scv-identity-precision.shs (honest
# accepted-correct/accepted-total; ambiguity never silently accepted).
# Verdict is ALWAYS the last stdout line: PASS exit 0 / FAIL exit 1 / ERROR exit 2.
# Committed UNSIGNED.
set -u
CORPUS="test/fixtures/scv_identity_corpus"
GATE="scripts/check/check-scv-identity-precision.shs"
[ -d "$CORPUS" ] && [ -f "$GATE" ] || { echo "ERROR — nothing was checked (missing corpus or gate)"; exit 2; }
checked=0
bad=""
cases=$(ls "$CORPUS" | wc -l)
checked=$((checked + 1))
[ "$cases" -ge 30 ] && [ "$cases" -le 200 ] || bad="$bad corpus-bounds($cases)"
grep -q 'scv_corpus_evaluate' src/lib/scv/entity_graph.spl || bad="$bad oracle"
checked=$((checked + 1))
OUT="${TMPDIR:-/tmp}/SCV-IMPL-I-05.$$.log"
sh "$GATE" > "$OUT" 2>&1
rc=$?
checked=$((checked + 1))
GATE_LAST=$(tail -1 "$OUT")
PRECISION=$(grep 'precision_milli_x100:' "$OUT" | tail -1 | tr -s ' ')
rm -f "$OUT"
[ "$rc" -eq 0 ] || bad="$bad gate-rc($rc:$GATE_LAST)"
[ "$checked" -gt 0 ] || { echo "ERROR — nothing was checked"; exit 2; }
if [ -z "$bad" ]; then
  echo "PASS — $checked check(s): $cases corpus case(s),$PRECISION, gate: $GATE_LAST"
  exit 0
fi
echo "FAIL — $checked check(s), unmet:$bad"
exit 1
