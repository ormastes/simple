#!/bin/sh
# SCV-IMPL-D-05 — semistructured region merge (CST regions + line balance, commutative lists)
# Verdict is ALWAYS the last stdout line: PASS exit 0 / FAIL exit 1 / ERROR exit 2.
# Committed UNSIGNED.
set -u
LIB="src/lib/scv/region_merge.spl"
MERGE="src/lib/scv/merge.spl"
SPEC="test/integration/app/scv_region_merge_spec.spl"
TWIN="test/02_integration/app/scv_region_merge_spec.spl"
[ -f "$LIB" ] && [ -f "$MERGE" ] && [ -f "$SPEC" ] && [ -f "$TWIN" ] || { echo "ERROR — nothing was checked (missing files)"; exit 2; }
checked=0
bad=""

grep -q "use std.scv.region_merge.{scv_region_merge_text}" "$MERGE" || bad="$bad merge(region-import)"
checked=$((checked + 1))
grep -q "region-merge" "$MERGE" || bad="$bad merge(region-rung)"
checked=$((checked + 1))
grep -q "^export region_merge\.\*" src/lib/scv/__init__.spl || bad="$bad init(export)"
checked=$((checked + 1))
cmp -s "$SPEC" "$TWIN" || bad="$bad spec-twins-differ"
checked=$((checked + 1))
OUT="${TMPDIR:-/tmp}/SCV-IMPL-D-05.$$.log"
SIMPLE_TIMEOUT_SECONDS=900 bin/simple test "$SPEC" > "$OUT" 2>&1
rc=$?
checked=$((checked + 1))
RESULTS=$(grep 'Results:' "$OUT" | tail -1)
rm -f "$OUT"
[ "$rc" -eq 0 ] || bad="$bad spec-rc($rc)"
case "$RESULTS" in
  *", 0 failed"*) : ;;
  "") bad="$bad spec(no-results-line)" ;;
  *) bad="$bad spec($RESULTS)" ;;
esac
[ "$checked" -gt 0 ] || { echo "ERROR — nothing was checked"; exit 2; }
if [ -z "$bad" ]; then
  echo "PASS — $checked check(s): semistructured region merge (CST regions + line balance, commutative lists) wired, $RESULTS"
  exit 0
fi
echo "FAIL — $checked check(s), unmet:$bad"
exit 1
