#!/bin/sh
# SCV-IMPL-D-04 — identity-aware merge: rename-one-side/edit-other resolved
# via FileEntityId (per-commit identity maps), rename-vs-rename and
# rename-vs-delete recorded as typed conflict DATA (jj stays the
# conflict-storage authority).
# Verdict is ALWAYS the last stdout line: PASS exit 0 / FAIL exit 1 / ERROR exit 2.
# Committed UNSIGNED.
set -u
LIB="src/lib/scv/identity_merge.spl"
MERGE="src/lib/scv/merge.spl"
SPEC="test/integration/app/scv_identity_merge_spec.spl"
TWIN="test/02_integration/app/scv_identity_merge_spec.spl"
[ -f "$LIB" ] && [ -f "$MERGE" ] && [ -f "$SPEC" ] && [ -f "$TWIN" ] || { echo "ERROR — nothing was checked (missing files)"; exit 2; }
checked=0
bad=""
grep -q 'use std.scv.identity_merge.{scv_identity_merge_groups}' "$MERGE" || bad="$bad merge(identity-import)"
checked=$((checked + 1))
grep -q 'scv_apply_identity_group' "$MERGE" || bad="$bad merge(identity-prepass)"
checked=$((checked + 1))
grep -q 'entity_identity_ambiguous' "$MERGE" || bad="$bad merge(typed-conflict)"
checked=$((checked + 1))
grep -q '^export identity_merge\.\*' src/lib/scv/__init__.spl || bad="$bad init(export)"
checked=$((checked + 1))
cmp -s "$SPEC" "$TWIN" || bad="$bad spec-twins-differ"
checked=$((checked + 1))
OUT="${TMPDIR:-/tmp}/SCV-IMPL-D-04.$$.log"
SIMPLE_TIMEOUT_SECONDS=900 bin/simple test "$SPEC" > "$OUT" 2>&1
rc=$?
checked=$((checked + 1))
RESULTS=$(grep 'Results:' "$OUT" | tail -1)
rm -f "$OUT"
[ "$rc" -eq 0 ] || bad="$bad spec-rc($rc)"
case "$RESULTS" in
  *", 0 failed"*) : ;;
  "") bad="$bad spec(no-results-line)" ;;
  *) bad="$bad spec($RESULTS)" ;;
esac
[ "$checked" -gt 0 ] || { echo "ERROR — nothing was checked"; exit 2; }
if [ -z "$bad" ]; then
  echo "PASS — $checked check(s): identity-aware merge wired, $RESULTS"
  exit 0
fi
echo "FAIL — $checked check(s), unmet:$bad"
exit 1
