#!/usr/bin/env sh
# systest_kv260_bringup.shs -- single shared bring-up runner for the KV260
# SimpleOS boot system test. Runs the real JTAG bring-up once and writes the
# evidence log both the spec tiers and the release check grep:
#   build/fpga/systest/kv260_boot_latest.log  (+ timestamped copy)
# Lives OUTSIDE the test runner on purpose: a real board run takes ~5-7 min,
# longer than test-runner child timeouts across deployed binary generations.
set -u

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

LOG_DIR="build/fpga/systest"
LOG_LATEST="$LOG_DIR/kv260_boot_latest.log"
BRINGUP="scripts/fpga/bringup_kv260_rv32_ddr.shs"

mkdir -p "$LOG_DIR"

# Shared board: wait (up to 10 min) for any live xsdb session.
# '[x]sdb' avoids the self-matching-pgrep trap.
i=0
while [ $i -lt 60 ]; do
    pgrep -f '[x]sdb' >/dev/null 2>&1 || break
    sleep 10
    i=$((i + 1))
done

timeout 420 bash "$BRINGUP" > "$LOG_LATEST.tmp" 2>&1
rc=$?
echo "SYSTEST_BRINGUP_RC=$rc" >> "$LOG_LATEST.tmp"

prerun=$(sed -n 's/^PRERUN_AXI_READS=//p' "$LOG_LATEST.tmp" | tail -1)
axi=$(sed -n 's/^AXI_READS=//p' "$LOG_LATEST.tmp" | tail -1)
uart=$(sed -n 's/^UART_BYTE_COUNT=//p' "$LOG_LATEST.tmp" | tail -1)
if [ -n "$prerun" ] && [ "$prerun" -eq 0 ] 2>/dev/null; then echo "SYSTEST_PRERUN_AXI_READS_ZERO=true"; else echo "SYSTEST_PRERUN_AXI_READS_ZERO=false"; fi >> "$LOG_LATEST.tmp"
if [ -n "$axi" ] && [ "$axi" -gt 1000000 ] 2>/dev/null; then echo "SYSTEST_AXI_READS_GT_1M=true"; else echo "SYSTEST_AXI_READS_GT_1M=false"; fi >> "$LOG_LATEST.tmp"
if [ -n "$uart" ] && [ "$uart" -gt 0 ] 2>/dev/null; then echo "SYSTEST_UART_BYTE_COUNT_POSITIVE=true"; else echo "SYSTEST_UART_BYTE_COUNT_POSITIVE=false"; fi >> "$LOG_LATEST.tmp"

mv "$LOG_LATEST.tmp" "$LOG_LATEST"
cp "$LOG_LATEST" "$LOG_DIR/kv260_boot_$(date -u +%Y%m%d_%H%M%SZ).log"
cat "$LOG_LATEST"
exit "$rc"
