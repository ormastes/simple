use app.cli._CliMain.main_and_help.{apply_mem_infra_flags, mem_infra_effective_backend}
use app.cli._CliMain.args_and_os_commands.{parse_global_flags}
use app.io.env_ops.{env_get}

fn main() -> i64:
    val flags = parse_global_flags(["run", "test/fixture/mem_infra/attr_enabled_probe.spl", "--mem-infra=attr"])
    print "case1_backend={mem_infra_effective_backend(flags)}"
    val rc = apply_mem_infra_flags(flags)
    print "case1_rc={rc}"
    print "case1_SIMPLE_MEM_ATTR={env_get(\"SIMPLE_MEM_ATTR\")}"

    val flags2 = parse_global_flags(["run", "x.spl", "--mem-infra=asan"])
    val rc2 = apply_mem_infra_flags(flags2)
    print "case2_rc={rc2}"
    print "case2_SIMPLE_MEM_HARDEN={env_get(\"SIMPLE_MEM_HARDEN\")}"

    val flags3 = parse_global_flags(["run", "x.spl", "--mem-infra=bogus"])
    val rc3 = apply_mem_infra_flags(flags3)
    print "case3_rc={rc3}"

    val flags4 = parse_global_flags(["run", "x.spl", "--mem-infra=memprof"])
    val rc4 = apply_mem_infra_flags(flags4)
    print "case4_rc={rc4}"
    print "case4_SIMPLE_MEM_ATTR={env_get(\"SIMPLE_MEM_ATTR\")}"
    0
