use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir_instruction_kinds.*
use compiler.mir.mir_instruction_support.*
use compiler.mir.mir_instruction_graph.*
use compiler.mir.mir_types.*
use compiler.mir.mir_lowering.{MirLowering}

fn dump_fn(mir: MirModule, name: text):
    for function in mir.functions.values():
        if function.name != name:
            continue
        print("== fn " + function.name)
        for local in function.locals:
            print("  local l" + "{local.id.id}" + " kind=" + "{local.kind}" + " type=" + "{local.type_.kind}")
        for block in function.blocks:
            print("  block b" + "{block.id.bootstrap_value()}")
            for inst in block.instructions:
                print("    inst " + "{inst.kind}")
            print("    term " + "{block.terminator}")

fn lower_and_dump(src: text, names: [text]):
    val ast = parse_full_frontend(src, "probe.spl", "probe.spl", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename("probe.spl")
    val hir = hir_lowering.lower_module(ast)
    var mir_lowering = MirLowering.new(hir.symbols)
    val mir = mir_lowering.lower_module(hir)
    print("-- constants: " + "{mir.constants.keys().len()}" + " statics: " + "{mir.statics.keys().len()}")
    for name in names:
        dump_fn(mir, name)

use std.spec

describe "probe":
    it "dumps":
        lower_and_dump("fn five() -> i64:\n    5\n\nfn use_it() -> i64:\n    val x = five()\n    x + 1\n", ["five", "use_it"])
    lower_and_dump("fn noop():\n    pass\n\nfn caller():\n    noop()\n", ["noop", "caller"])
    lower_and_dump("val G = 7\n\nfn read_g() -> i64:\n    G\n", ["read_g"])
    lower_and_dump("fn pick(c: bool) -> i64:\n    val x = if c: 1 else: 2\n    x\n", ["pick"])
    lower_and_dump("enum E:\n    A, B\n\nfn same(a: E, b: E) -> bool:\n    a == b\n", ["same"])
    lower_and_dump("struct P:\n    x: i64\n\nstruct Box:\n    items: [P]\n\nfn first_x(b: Box) -> i64:\n    b.items[0].x\n", ["first_x"])
    lower_and_dump("fn m(n: i64) -> text:\n    match n:\n        case 0:\n            \"zero\"\n        case _:\n            \"many\"\n", ["m"])
