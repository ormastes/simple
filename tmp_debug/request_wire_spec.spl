use std.spec.*
use std.gc_async_mut.gpu.browser_engine.net.entity.request_types.{FetchRequest, RequestMode}
use std.gc_async_mut.gpu.browser_engine.net.entity.url_types.Url
use std.gc_async_mut.gpu.browser_engine.net.h1_client.{build_request_bytes}

fn main():
    describe "debug wire":
        it "prints wire":
            val request = FetchRequest(
                method: "POST",
                url: Url.parse_or_opaque("https://example.test/submit?q=1"),
                headers: "Accept: application/json\r\nX-Test: yes\r\n",
                body: [111u8, 107u8],
                mode: RequestMode.SameOrigin,
                credentials: "same-origin"
            )
            val wire = build_request_bytes(request)
            fail(wire)
