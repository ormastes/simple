# Minimal production named-target registry.
# Canonical labels are stable graph identities; explicit outputs avoid any
# dependency on the executor's hashed storage-component default.

target //config:configc:
    kind: binary
    entry: src/app/configc/main.spl
    output: build/targets/configc/simple-configc

target //provider:provider_cli:
    kind: binary
    entry: src/app/provider_cli/main.spl
    output: build/targets/provider_cli/simple-provider-cli

target //provider:provider_cli_native:
    kind: shared
    entry: src/app/provider_cli/native_provider_v1.spl
    output: build/providers/provider_cli_native.so

# Build groups. Only `default: true` groups are selected by a default build.
# Optional groups (backend plugins, stdlib static archive, CPU tiers, cross
# providers) live in their own sub-configs under config/build/ and are added
# here with `include: config/build/<group>.sdn`.
group host:
    default: true
    members: //config:configc, //provider:provider_cli, //provider:provider_cli_native

include: config/build/stdlib_static.sdn
