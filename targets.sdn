# Minimal production named-target registry.
# Canonical labels are stable graph identities; explicit outputs avoid any
# dependency on the executor's hashed storage-component default.

target //config:configc:
    kind: binary
    entry: src/app/configc/main.spl
    output: build/targets/configc/simple-configc

target //provider:provider_cli:
    kind: binary
    entry: src/app/provider_cli/main.spl
    output: build/targets/provider_cli/simple-provider-cli
