use app.cli._CliMain.main_and_help.{apply_mem_infra_flags}
use app.cli._CliMain.args_and_os_commands.{parse_global_flags}

extern fn rt_mem_attr_enabled() -> i64

fn main() -> i64:
    val flags = parse_global_flags(["run", "x.spl", "--mem-infra=attr"])
    val rc = apply_mem_infra_flags(flags)
    print "rc={rc}"
    print "first_call_after_apply={rt_mem_attr_enabled()}"
    0
