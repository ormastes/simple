fn main():
    val kx = "x"
    val kz = "zz"

    var di: Dict<text, i64> = {}
    di[kx] = 7
    print "S01 i64_len={di.len()}"
    print "S02 i64_keys={di.keys().len()}"
    print "S03 i64_idx={di[kx]}"
    print "S04 i64_has={di.contains_key(kx)}"
    print "S05 i64_get_isnil={di.get(kx) == nil}"
    print "S06 i64_get_RAW={di.get(kx)}"
    print "S07 i64_miss_isnil={di.get(kz) == nil}"
    print "S08 i64_miss_RAW={di.get(kz)}"

    var d32: Dict<text, i32> = {}
    d32[kx] = 7
    print "S09 i32_len={d32.len()}"
    print "S10 i32_idx={d32[kx]}"
    print "S11 i32_get_RAW={d32.get(kx)}"
    print "S12 i32_miss_isnil={d32.get(kz) == nil}"
    print "S13 i32_miss_RAW={d32.get(kz)}"

    var db: Dict<text, bool> = {}
    db[kx] = true
    print "S14 bool_len={db.len()}"
    print "S15 bool_idx={db[kx]}"
    print "S16 bool_get_RAW={db.get(kx)}"
    print "S17 bool_miss_isnil={db.get(kz) == nil}"
    print "S18 bool_miss_RAW={db.get(kz)}"

    var df: Dict<text, f64> = {}
    df[kx] = 2.5
    print "S19 f64_len={df.len()}"
    print "S20 f64_idx={df[kx]}"
    print "S21 f64_get_RAW={df.get(kx)}"
    print "S22 f64_miss_isnil={df.get(kz) == nil}"
    print "S23 f64_miss_RAW={df.get(kz)}"
    print "S24 DONE"
