# @req REQ-LLM-MSG-001
use std.spec.*
use app.llm_caret.messaging.adapter.store.pure_sql_store.{PureSqlMessagingStore}
use app.llm_caret.messaging.domain.notification.{NotificationDelivery}

describe "durable email notification delivery":
    it "queues and consumes a verification capability exactly once":
        var store = PureSqlMessagingStore.open_memory()
        val delivery = NotificationDelivery(delivery_id: "email-invite-unit-1", channel: "email",
            recipient: "human@example.com", subject: "Verify your LLM Caret account",
            body: "single-use-verification-capability", created_at: 1000)
        expect(store.enqueue_notification(delivery)).to_equal("email-invite-unit-1")
        val consumed = store.take_notification("email", 2000).unwrap()
        expect(consumed.recipient).to_equal("human@example.com")
        expect(consumed.body).to_equal("single-use-verification-capability")
        expect(store.take_notification("email", 3000)).to_be_nil()
        expect(store.close()).to_equal(true)
