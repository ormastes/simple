# Simple-side layout extractor for the Chrome<->Simple component-level layout
# differential. Reads one HTML fixture, runs the real web-renderer layout
# pipeline (parse_html -> extract_css_vw -> build_child_index -> compute_styles
# -> layout, the same sequence as simple_web_layout_debug_layout_by_id in
# src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer.spl)
# and prints one JSON document on stdout between BEGIN/END sentinels.
#
# Env:
#   LAYOUT_DUMP_HTML   path to the fixture .html          (required)
#   LAYOUT_DUMP_W      viewport width  in css px, default 800
#   LAYOUT_DUMP_H      viewport height in css px, default 600
#
# The sentinels exist because the shared toolchain emits use/gc warnings on
# stderr AND stdout; the differ slices between them.

use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    parse_html, extract_css_vw, build_child_index, compute_styles,
    zero_i32_list, empty_i32_lists, neg_one_i32_list, layout
}
use std.io_runtime.{env_get, read_file}

val BEGIN_SENTINEL: text = "<<<LAYOUT_DUMP_JSON_BEGIN>>>"
val END_SENTINEL: text = "<<<LAYOUT_DUMP_JSON_END>>>"

# NOTE: deliberately replace-based, not index-based. `text.len()` returns the
# BYTE length while `text[i]` indexes by CHARACTER, so a char-by-char escape
# loop walks off the end of any non-ASCII string ("string index out of bounds:
# index is 20 but length is 20" on the CJK fixture). Reported as a real defect
# in tools/layout_diff/CONTRACT.md.
fn json_escape(s: text) -> text:
    var out = s.replace("\\", "\\\\")
    out = out.replace("\"", "\\\"")
    out = out.replace("\n", "\\n")
    out = out.replace("\r", "\\r")
    out = out.replace("\t", "\\t")
    out

fn env_i32(name: text, fallback: i32) -> i32:
    val raw = "" + env_get(name)
    if raw == "" or raw == "nil":
        return fallback
    val parsed = raw.to_i64()
    if parsed <= 0:
        return fallback
    parsed as i32

fn main() -> i64:
    val path = env_get("LAYOUT_DUMP_HTML")
    if path == "":
        print "ERROR: LAYOUT_DUMP_HTML not set"
        return 2
    val width = env_i32("LAYOUT_DUMP_W", 800)
    val height = env_i32("LAYOUT_DUMP_H", 600)
    val html = read_file(path)
    if html == "":
        print "ERROR: empty or unreadable fixture: " + path
        return 2

    val nodes = parse_html(html)
    val rules = extract_css_vw(html, width, false)
    val child_index = build_child_index(nodes)
    val styles = compute_styles(nodes, rules, child_index, false, true)
    val node_count = nodes.len() as i32
    val boxes = layout(
        nodes, styles, child_index, 0, 0, 0, width, height,
        zero_i32_list(node_count), zero_i32_list(node_count),
        zero_i32_list(node_count), zero_i32_list(node_count),
        empty_i32_lists(node_count), empty_i32_lists(node_count),
        neg_one_i32_list(node_count)
    )

    print BEGIN_SENTINEL
    print "{"
    print "  \"engine\": \"simple\","
    print "  \"fixture\": \"" + json_escape(path) + "\","
    print "  \"viewport\": {\"w\": " + width.to_string() + ", \"h\": " + height.to_string() + "},"
    print "  \"doc_height\": " + boxes.height.to_string() + ","
    print "  \"nodes\": ["
    var i = 0
    var emitted = 0
    while i < node_count:
        val node = nodes[i]
        if emitted > 0:
            print "    ,"
        var line = "    {\"index\": " + i.to_string()
        line = line + ", \"tag\": \"" + json_escape(node.tag) + "\""
        line = line + ", \"id\": \"" + json_escape(node.id_attr) + "\""
        line = line + ", \"parent\": " + node.parent.to_string()
        line = line + ", \"x\": " + boxes.bx[i].to_string()
        line = line + ", \"y\": " + boxes.by[i].to_string()
        line = line + ", \"w\": " + boxes.bw[i].to_string()
        line = line + ", \"h\": " + boxes.bh[i].to_string()
        line = line + ", \"margin_t\": " + styles[i].margin_t.to_string()
        line = line + ", \"margin_b\": " + styles[i].margin_b.to_string()
        if node.tag == "#text":
            line = line + ", \"text\": \"" + json_escape(node.text_data) + "\""
            line = line + ", \"lines\": ["
            val starts = boxes.wrap_starts[i]
            val ends = boxes.wrap_ends[i]
            var k = 0
            while k < (starts.len() as i32):
                if k > 0:
                    line = line + ", "
                val s = starts[k]
                val e = ends[k]
                line = line + "{\"start\": " + s.to_string()
                line = line + ", \"end\": " + e.to_string() + "}"
                k = k + 1
            line = line + "]"
        line = line + "}"
        print line
        emitted = emitted + 1
        i = i + 1
    print "  ]"
    print "}"
    print END_SENTINEL
    0
