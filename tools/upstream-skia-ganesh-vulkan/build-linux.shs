#!/bin/sh
set -eu

# Deliberately outside every default embedded/native build entrypoint.
if [ "$(uname -s)" != Linux ]; then
    echo "upstream Skia Ganesh Vulkan provider: Linux build required" >&2
    exit 2
fi
if [ -z "${SKIA_ROOT:-}" ]; then
    echo "set SKIA_ROOT to the pinned Skia checkout" >&2
    exit 2
fi
affine_v3=${SIMPLE_UPSTREAM_SKIA_ENABLE_AFFINE_V3:-0}
case "$affine_v3" in
    0|1) ;;
    *)
        echo "SIMPLE_UPSTREAM_SKIA_ENABLE_AFFINE_V3 must be 0 or 1" >&2
        exit 2
        ;;
esac
expected=35d5edfa0d50984c22ff94f5438c31e0db12c6f8
actual=$(git -C "$SKIA_ROOT" rev-parse HEAD)
if [ "$actual" != "$expected" ]; then
    echo "Skia checkout revision differs from skia-pin.json" >&2
    exit 2
fi
if [ -n "$(git -C "$SKIA_ROOT" status --porcelain --untracked-files=all)" ]; then
    echo "Skia checkout has local modifications" >&2
    exit 2
fi
if [ ! -f "$SKIA_ROOT/DEPS" ] ||
   [ ! -f "$SKIA_ROOT/tools/git-sync-deps" ]; then
    echo "pinned Skia DEPS or dependency synchronizer missing" >&2
    exit 2
fi
provider_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_dir=$(CDPATH= cd -- "$provider_dir/../.." && pwd)
# Force the pinned checkout's DEPS even if the caller has an override set.
GIT_SYNC_DEPS_PATH="$SKIA_ROOT/DEPS" python3 "$SKIA_ROOT/tools/git-sync-deps"
deps_manifest=$(mktemp)
trap 'rm -f "$deps_manifest"' EXIT HUP INT TERM
deps_checkout_digest=$(python3 "$provider_dir/verify-skia-deps.py" "$SKIA_ROOT" "$deps_manifest")
skia_out="$SKIA_ROOT/out/simple-upstream-ganesh-vulkan"
(
    cd "$SKIA_ROOT"
    bin/gn gen out/simple-upstream-ganesh-vulkan --args='is_debug=false skia_use_vulkan=true skia_use_gl=false skia_use_metal=false skia_use_dawn=false'
    ninja -C out/simple-upstream-ganesh-vulkan skia
)
if [ ! -f "$skia_out/libskia.a" ]; then
    echo "pinned Skia build produced no libskia.a" >&2
    exit 2
fi
deps_checkout_digest_after=$(python3 "$provider_dir/verify-skia-deps.py" "$SKIA_ROOT" "$deps_manifest")
if [ "$deps_checkout_digest_after" != "$deps_checkout_digest" ]; then
    echo "Skia dependencies changed during build" >&2
    exit 2
fi
output="${1:-$repo_dir/build/optional/libsimple_upstream_skia_ganesh_vulkan.so}"
mkdir -p "$(dirname -- "$output")"
${CXX:-c++} -std=c++17 -O2 -fPIC -shared -Wl,--no-undefined \
    "-DSIMPLE_UPSTREAM_SKIA_ENABLE_AFFINE_V3=$affine_v3" \
    -I"$SKIA_ROOT" -I"$repo_dir/src/runtime" \
    "$provider_dir/provider.cpp" "$skia_out/libskia.a" \
    -lvulkan -ldl -lpthread -lz -o "$output"
deps_digest=$(sha256sum "$SKIA_ROOT/DEPS" | cut -d ' ' -f 1)
skia_digest=$(sha256sum "$skia_out/libskia.a" | cut -d ' ' -f 1)
provider_digest=$(sha256sum "$output" | cut -d ' ' -f 1)
cat > "$output.receipt.json" <<EOF
{
  "provider": "upstream-skia-ganesh-vulkan",
  "skia_revision": "$actual",
  "skia_deps_sha256": "$deps_digest",
  "skia_dependency_checkouts_sha256": "$deps_checkout_digest_after",
  "skia_dependency_checkouts": $(cat "$deps_manifest"),
  "skia_archive_sha256": "$skia_digest",
  "provider_sha256": "$provider_digest",
  "affine_v3_enabled": $affine_v3,
  "gn_args": "is_debug=false skia_use_vulkan=true skia_use_gl=false skia_use_metal=false skia_use_dawn=false",
  "qualification": "build-only; physical Linux device render/readback required"
}
EOF
echo "$provider_digest  $output"
