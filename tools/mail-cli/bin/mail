#!/usr/bin/env bash
# mail — Shell-based email client (IMAP/SMTP via curl)
# Mirrors the gh/jira CLI interface pattern.
#
# Supports: Gmail, Outlook/365, Yahoo, ProtonMail (Bridge), Fastmail, any IMAP/SMTP
#
# CORE COMMANDS
#   auth       Configure email accounts
#   inbox      List inbox messages
#   read <uid> Read a message
#   send       Compose and send
#   reply      Reply to a message
#   forward    Forward a message
#   search     Search messages
#
# ADDITIONAL COMMANDS
#   folder     Manage folders/labels
#   star       Star/flag a message
#   archive    Archive a message
#   delete     Delete a message
#   move       Move to folder
#   draft      Draft management
#   config     Manage settings

set -euo pipefail
umask 077

VERSION="0.1.0"

# Resolve script directory (follow symlinks)
SELF="$0"
while [ -L "$SELF" ]; do
  DIR="$(cd "$(dirname "$SELF")" && pwd)"
  SELF="$(readlink "$SELF")"
  case "$SELF" in /*) ;; *) SELF="${DIR}/${SELF}" ;; esac
done
BIN_DIR="$(cd "$(dirname "$SELF")" && pwd)"
LIB_DIR="$(cd "${BIN_DIR}/../lib" && pwd)"

# Global account override (set by --account flag)
MAIL_ACCOUNT=""

# Source library modules
. "${LIB_DIR}/config.shs"
. "${LIB_DIR}/format.shs"
. "${LIB_DIR}/imap.shs"
. "${LIB_DIR}/pop3.shs"
. "${LIB_DIR}/smtp.shs"
. "${LIB_DIR}/auth.shs"
. "${LIB_DIR}/inbox.shs"
. "${LIB_DIR}/send.shs"
. "${LIB_DIR}/folder.shs"
. "${LIB_DIR}/draft.shs"

check_deps() {
  for cmd in curl jq base64; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
      echo "${C_RED}error:${C_RESET} '${cmd}' is required but not installed." >&2
      echo "  Install ${cmd} with your platform's package manager (see tools/mail-cli/README.md)." >&2
      exit 1
    fi
  done
  # Each transport reports curl's unsupported-protocol error at use-time.
  # A POP3-only curl build must still be able to configure/use POP3 accounts.
}

cmd_config() {
  local subcmd="${1:-}"
  shift 2>/dev/null || true

  case "$subcmd" in
    set)
      if [ $# -lt 2 ]; then
        echo "Usage: mail config set <key> <value>" >&2; return 2
      fi
      mail_config_init
      local tmp="${MAIL_CONFIG_FILE}.tmp"
      jq --arg k "$1" --arg v "$2" '.[$k] = $v' < "$MAIL_CONFIG_FILE" > "$tmp" && mv "$tmp" "$MAIL_CONFIG_FILE"
      chmod 600 "$MAIL_CONFIG_FILE"
      echo "${C_GREEN}✓${C_RESET} Set ${1}"
      ;;
    get)
      [ $# -lt 1 ] && { echo "Usage: mail config get <key>" >&2; return 2; }
      jq -r ".${1} // empty" < "$MAIL_CONFIG_FILE" 2>/dev/null
      ;;
    list)
      mail_config_init
      jq '.' < "$MAIL_CONFIG_FILE" 2>/dev/null
      ;;
    *)
      echo "Manage mail-cli configuration"
      echo ""
      echo "COMMANDS"
      echo "  set <key> <value>   Set a config value"
      echo "  get <key>           Get a config value"
      echo "  list                List all config"
      ;;
  esac
}

cmd_version() {
  echo "mail-cli version ${VERSION} (Simple Language Project)"
  echo "  Config: ${MAIL_CONFIG_FILE}"
  local accounts
  accounts=$(mail_config_list_accounts 2>/dev/null)
  if [ -n "$accounts" ]; then
    local count
    count=$(echo "$accounts" | wc -l | tr -d ' ')
    echo "  Accounts: ${count} configured"
  else
    echo "  Accounts: none"
  fi
  echo ""
  echo "  Supported: Gmail, Outlook/365, Yahoo, ProtonMail, Fastmail, any IMAP/SMTP"
}

cmd_help() {
  echo "mail — Shell-based email client (IMAP/SMTP via curl)"
  echo "Mirrors the gh/jira CLI interface."
  echo ""
  echo "${C_BOLD}USAGE${C_RESET}"
  echo "  mail <command> [flags]"
  echo ""
  echo "${C_BOLD}CORE COMMANDS${C_RESET}"
  echo "  auth        Configure email accounts"
  echo "  inbox       List inbox messages"
  echo "  read <uid>  Read a message"
  echo "  send        Compose and send email"
  echo "  reply <uid> Reply to a message"
  echo "  forward     Forward a message"
  echo "  search      Search messages"
  echo ""
  echo "${C_BOLD}ADDITIONAL COMMANDS${C_RESET}"
  echo "  folder      Manage folders/labels"
  echo "  star <uid>  Star/flag a message"
  echo "  archive     Archive a message"
  echo "  delete      Delete a message"
  echo "  move        Move to folder"
  echo "  draft       Draft management"
  echo "  config      Manage settings"
  echo "  version     Show version"
  echo "  help        Show this help"
  echo ""
  echo "${C_BOLD}GLOBAL FLAGS${C_RESET}"
  echo "  --account NAME   Use specific account (overrides default)"
  echo "  --json           Output as JSON"
  echo "  --password-file FILE  Override saved password (one line; never argv)"
  echo "  --password-cmd CMD    Obtain a password from a command"
  echo "  --non-interactive     Never prompt for credentials"
  echo "  --config-file FILE    Shared account JSON file (e.g. {home}/.config/devhub/email.json)"
  echo "  --config-dir DIR      Account directory containing config.json"
  echo "  Paths accept a leading {home}; quote it in launch commands"
  echo "  POP3: auth login --protocol pop3; inbox/read/reply/forward/send supported"
  echo "  POP3 message numbers can change between sessions; folders/flags/search unavailable"
  echo "  auth password         Validate and save a replacement password"
  echo ""
  echo "${C_BOLD}INBOX/SEARCH FLAGS${C_RESET}"
  echo "  --unread         Only unread messages (inbox)"
  echo "  --threads        Group by subject, parent + indented replies (inbox)"
  echo "  --wide           Disable column truncation (inbox/search)"
  echo "  --limit N        Show at most N messages (default 25)"
  echo "  --no-pager       Disable paging even when output is long"
  echo "                   (inbox/search/folder list; also respects \$PAGER)"
  echo ""
  echo "${C_BOLD}SEND FLAGS${C_RESET}"
  echo "  --attach FILE    Attach a file (repeatable) — sent as multipart/mixed"
  echo "  --cc, --bcc      Additional recipients"
  echo "  --input FILE     Read body from FILE instead of a prompt"
  echo ""
  echo "${C_BOLD}PROVIDERS${C_RESET}"
  echo "  Gmail         App Password required (myaccount.google.com/apppasswords)"
  echo "  Outlook/365   Password or App Password"
  echo "  Yahoo         App Password"
  echo "  ProtonMail    Via ProtonMail Bridge (local proxy)"
  echo "  Fastmail      App Password"
  echo "  Other         Any standard IMAP/SMTP server"
  echo "  All           --password-cmd CMD (auth login) keeps the password"
  echo "                out of config.json — runs CMD to obtain it"
  echo ""
  echo "${C_BOLD}EXAMPLES${C_RESET}"
  echo "  mail auth login --provider gmail         # Setup Gmail"
  echo "  mail auth login --password-cmd 'pass show mail/gmail'"
  echo "  mail auth status                         # Check accounts"
  echo "  mail inbox                               # List inbox"
  echo "  mail inbox --unread                      # Unread only"
  echo "  mail inbox --threads                     # Group by subject"
  echo "  mail read 123                            # Read message"
  echo "  mail send --to a@b.com --subject Hi      # Send email"
  echo "  mail send --to a@b.com --attach report.pdf --attach log.txt"
  echo "  mail reply 123 --body 'Thanks!'          # Reply"
  echo "  mail search 'pull request'               # Search"
  echo "  mail folder list                         # List folders"
  echo "  mail star 123                            # Star message"
  echo "  mail archive 123                         # Archive"
  echo "  mail move 123 'Work'                     # Move to folder"
  echo ""
  echo "${C_BOLD}CONFIG${C_RESET}"
  echo "  Credentials: ~/.config/mail-cli/config.json"
}

main() {
  check_deps

  local command="${1:-help}"
  shift 2>/dev/null || true

  local config_kind=""
  local -a remaining=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --config-file|--config-dir)
        [ $# -ge 2 ] && [ -n "$2" ] || { echo "error: $1 needs a value" >&2; return 2; }
        if [ -n "$config_kind" ] && [ "$config_kind" != "$1" ]; then
          echo "error: choose --config-file or --config-dir" >&2; return 2
        fi
        config_kind="$1"
        if [ "$1" = --config-file ]; then
          MAIL_CONFIG_FILE=$(mail_expand_path "$2") || return $?
          MAIL_CONFIG_DIR=$(dirname -- "$MAIL_CONFIG_FILE")
        else
          MAIL_CONFIG_DIR=$(mail_expand_path "$2") || return $?
          MAIL_CONFIG_FILE="${MAIL_CONFIG_DIR}/config.json"
        fi
        shift 2 ;;
      --account|--password-file|--password-cmd)
        [ $# -ge 2 ] && [ -n "$2" ] || { echo "error: $1 needs a value" >&2; return 2; }
        case "$1" in
          --account) MAIL_ACCOUNT="$2" ;;
          --password-file) MAIL_PASSWORD_FILE="$2" ;;
          --password-cmd) MAIL_PASSWORD_COMMAND="$2" ;;
        esac
        # Auth login/logout still parse these flags themselves.
        if [ "$command" = auth ] && [ "$1" != --password-file ]; then remaining+=("$1" "$2"); fi
        shift 2 ;;
      --non-interactive) MAIL_NONINTERACTIVE=1; shift ;;
      *) remaining+=("$1"); shift ;;
    esac
  done
  set -- "${remaining[@]}"
  if [ -n "${MAIL_PASSWORD_FILE:-}" ] && [ -n "${MAIL_PASSWORD_COMMAND:-}" ]; then
    echo "error: choose --password-file or --password-cmd" >&2; return 2
  fi
  case "$command" in
    inbox|read|send|reply|forward|search|folder|star|archive|delete|move|draft)
      local selected="${MAIL_ACCOUNT:-}" protocol
      [ -n "$selected" ] || selected=$(mail_config_get_default)
      protocol=$(mail_config_get_account "$selected" | jq -r '.protocol // "imap"')
      case "$protocol" in ''|imap|pop3) ;; *) echo "error: unknown mail protocol" >&2; return 2 ;; esac
      if [ "$protocol" = pop3 ]; then
        case "$command" in
          inbox) cmd_pop3_inbox "$@"; return $? ;;
          read|send|reply|forward) ;;
          *) echo "error: POP3 does not support ${command}" >&2; return 2 ;;
        esac
      fi ;;
  esac

  case "$command" in
    auth)    cmd_auth "$@" ;;
    inbox)   cmd_inbox "$@" ;;
    read)    cmd_read "$@" ;;
    send)    cmd_send "$@" ;;
    reply)   cmd_reply "$@" ;;
    forward) cmd_forward "$@" ;;
    search)  cmd_search "$@" ;;
    folder)  cmd_folder "$@" ;;
    star)    cmd_star "$@" ;;
    archive) cmd_archive "$@" ;;
    delete)  cmd_delete "$@" ;;
    move)    cmd_move "$@" ;;
    draft)   cmd_draft "$@" ;;
    config)  cmd_config "$@" ;;
    version|--version|-v) cmd_version ;;
    help|--help|-h)       cmd_help ;;
    *)
      echo "${C_RED}error:${C_RESET} unknown command '${command}'" >&2
      echo "Run 'mail help' for usage." >&2
      exit 2
      ;;
  esac
}

main "$@"
