#!/bin/sh
# Chrome<->Simple component-level PAINT differential driver (stage 5).
#
#   sh tools/paint_diff/run_paint_diff.shs [--chrome <path>] [--width N] [--height N]
#
# Compares each engine's own recorded display list for the same fixture:
#   chrome : LayerTree.snapshotCommandLog  (the layer's SkPicture op stream)
#   simple : simple_web_layout_render_html_draw_ir -> DrawIrComposition
#
# Fail-closed: if chrome is not found, or either extractor produces nothing,
# this exits non-zero. It never reports a pass having compared 0 ops.
set -e

ROOT=$(cd "$(dirname "$0")/../.." && pwd)
DIR="$ROOT/tools/paint_diff"
WIDTH=800
HEIGHT=600
CHROME="${PAINT_DIFF_CHROME:-}"

while [ $# -gt 0 ]; do
  case "$1" in
    --chrome) CHROME="$2"; shift 2 ;;
    --width)  WIDTH="$2";  shift 2 ;;
    --height) HEIGHT="$2"; shift 2 ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done

if [ -z "$CHROME" ]; then
  for c in \
    "$ROOT/../simple-webrender-gpu-offload-wt/.cache/ms-playwright/chromium-1234/chrome-linux64/chrome" \
    "$HOME/.cache/ms-playwright/chromium-*/chrome-linux64/chrome" \
    /usr/bin/google-chrome /usr/bin/chromium /usr/bin/chromium-browser
  do
    for e in $c; do [ -x "$e" ] && CHROME="$e" && break; done
    [ -n "$CHROME" ] && break
  done
fi

if [ -z "$CHROME" ] || [ ! -x "$CHROME" ]; then
  echo "UNAVAILABLE: no chrome executable found; pass --chrome <path> or set PAINT_DIFF_CHROME" >&2
  echo "paint-diff verdict: ERROR — nothing was compared"
  exit 4
fi

rm -rf "$DIR/out/chrome" "$DIR/out/simple"
mkdir -p "$DIR/out/chrome" "$DIR/out/simple"

echo "== chrome paint extraction =="
node "$DIR/chrome_paint_dump.js" --chrome "$CHROME" --out "$DIR/out/chrome" \
     --width "$WIDTH" --height "$HEIGHT" "$DIR"/fixtures/*.html

echo "== simple paint extraction =="
for f in "$DIR"/fixtures/*.html; do
  base=$(basename "$f" .html)
  out="$DIR/out/simple/$base.simple.json"
  if PAINT_DUMP_HTML="$f" PAINT_DUMP_W="$WIDTH" PAINT_DUMP_H="$HEIGHT" \
     SIMPLE_MODULE_LIMIT=4000 timeout 900 "$ROOT/bin/simple" run "$DIR/simple_paint_dump.spl" \
     2>/dev/null | sed -n '/PAINT_DUMP_JSON_BEGIN/,/PAINT_DUMP_JSON_END/p' \
     | sed '1d;$d' > "$out"; then :; fi
  if [ ! -s "$out" ]; then
    echo "FAIL simple extraction: $base" >&2
    rm -f "$out"
  else
    echo "OK   $base -> $out"
  fi
done

echo "== diff =="
node "$DIR/paint_diff.js"
