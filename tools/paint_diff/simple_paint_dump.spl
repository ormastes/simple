# Simple-side PAINT extractor for the Chrome<->Simple component-level
# differential (stage 5: paint / display list).
#
# Runs the real web-renderer paint pipeline entry point
# `simple_web_layout_render_html_draw_ir` from
# src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer.spl
# and prints the resulting DrawIrComposition as one JSON document on stdout
# between BEGIN/END sentinels.
#
# This is the counterpart of Chrome's `LayerTree.snapshotCommandLog`: both are
# the engine's own recorded display list, not a rasterised image.
#
# Env:
#   PAINT_DUMP_HTML   path to the fixture .html          (required)
#   PAINT_DUMP_W      viewport width  in css px, default 800
#   PAINT_DUMP_H      viewport height in css px, default 600
#
# The sentinels exist because the shared toolchain emits use/gc warnings and
# [rfm]/[web-style-producer] probe lines on stdout; the differ slices between
# them.
#
# NOTE: the fixture is read from a FILE, never embedded as a text literal.
# `"body{margin:0}"` in a Simple text literal parses `{margin:0}` as string
# interpolation and fails with "variable `margin` not found".

use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_render_html_draw_ir
}
use std.io_runtime.{env_get, read_file}

val BEGIN_SENTINEL: text = "<<<PAINT_DUMP_JSON_BEGIN>>>"
val END_SENTINEL: text = "<<<PAINT_DUMP_JSON_END>>>"

# A literal `}}` in a Simple text literal collapses to a single `}` (the brace
# escape that pairs with `{` interpolation), which silently produced invalid
# JSON. Close braces one at a time through this constant instead.
val RB: text = "}"

# Only the paint-relevant slice of computed_style is forwarded. The full
# property set is already covered by tools/web_diff (the cascade stage); the
# paint stage needs exactly the properties that decide which ops get recorded.
val PAINT_PROPS: [text] = [
    "border-top-width", "border-right-width", "border-bottom-width", "border-left-width",
    "border-top-color", "border-right-color", "border-bottom-color", "border-left-color",
    "border-top-style", "border-right-style", "border-bottom-style", "border-left-style",
    "border-top-left-radius", "border-top-right-radius",
    "border-bottom-right-radius", "border-bottom-left-radius",
    "background-color", "background-image", "color", "opacity",
    "outline-width", "outline-color", "outline-offset",
    "font-size", "font-family", "overflow-x", "overflow-y", "display", "visibility"
]

# NOTE: deliberately replace-based, not index-based. `text.len()` returns the
# BYTE length while `text[i]` indexes by CHARACTER, so a char-by-char escape
# loop walks off the end of any non-ASCII string. Same defect noted in
# tools/layout_diff/CONTRACT.md.
fn json_escape(s: text) -> text:
    var out = s.replace("\\", "\\\\")
    out = out.replace("\"", "\\\"")
    out = out.replace("\n", "\\n")
    out = out.replace("\r", "\\r")
    out = out.replace("\t", "\\t")
    out

fn env_i32(name: text, fallback: i32) -> i32:
    val raw = "" + env_get(name)
    if raw == "" or raw == "nil":
        return fallback
    val parsed = raw.to_i64()
    if parsed <= 0:
        return fallback
    parsed as i32

fn is_paint_prop(key: text) -> bool:
    var i = 0
    while i < (PAINT_PROPS.len() as i32):
        if PAINT_PROPS[i] == key:
            return true
        i = i + 1
    false

fn rect_json(name: text, present: bool, x: i32, y: i32, w: i32, h: i32) -> text:
    var s = "\"" + name + "\": {\"present\": "
    if present:
        s = s + "true"
    else:
        s = s + "false"
    s = s + ", \"x\": " + x.to_string()
    s = s + ", \"y\": " + y.to_string()
    s = s + ", \"w\": " + w.to_string()
    s = s + ", \"h\": " + h.to_string() + "}"
    s

fn main() -> i64:
    val path = env_get("PAINT_DUMP_HTML")
    if path == "":
        print "ERROR: PAINT_DUMP_HTML not set"
        return 2
    val width = env_i32("PAINT_DUMP_W", 800)
    val height = env_i32("PAINT_DUMP_H", 600)
    val html = read_file(path)
    if html == "":
        print "ERROR: empty or unreadable fixture: " + path
        return 2

    val comp = simple_web_layout_render_html_draw_ir(html, width, height)
    val batch_count = comp.batches.len() as i32

    print BEGIN_SENTINEL
    print "{"
    print "  \"engine\": \"simple\","
    print "  \"fixture\": \"" + json_escape(path) + "\","
    print "  \"schema\": \"" + json_escape(comp.schema) + "\","
    print "  \"backend_target\": \"" + json_escape(comp.backend_target) + "\","
    print "  \"viewport\": {\"w\": " + width.to_string() + ", \"h\": " + height.to_string() + "},"
    print "  \"batches\": ["
    var bi = 0
    while bi < batch_count:
        val batch = comp.batches[bi]
        if bi > 0:
            print "    ,"
        print "    {"
        print "      \"batch_id\": \"" + json_escape(batch.batch_id) + "\","
        print "      \"backend_target\": \"" + json_escape(batch.backend_target) + "\","
        print "      \"ops\": ["
        val cmd_count = batch.commands.len() as i32
        var ci = 0
        while ci < cmd_count:
            val c = batch.commands[ci]
            if ci > 0:
                print "        ,"
            var line = "        {\"kind\": \"" + json_escape(c.kind) + "\""
            line = line + ", \"component_id\": \"" + json_escape(c.component_id) + "\""
            line = line + ", \"parent_id\": \"" + json_escape(c.parent_id) + "\""
            line = line + ", \"x\": " + c.x.to_string()
            line = line + ", \"y\": " + c.y.to_string()
            line = line + ", \"w\": " + c.width.to_string()
            line = line + ", \"h\": " + c.height.to_string()
            line = line + ", \"color\": " + (c.color as i64).to_string()
            line = line + ", \"text\": \"" + json_escape(c.text_value) + "\""
            line = line + ", \"image_uri\": \"" + json_escape(c.image_uri) + "\""
            line = line + ", " + rect_json("border_rect", c.border_rect.present, c.border_rect.x, c.border_rect.y, c.border_rect.width, c.border_rect.height)
            line = line + ", " + rect_json("content_rect", c.content_rect.present, c.content_rect.x, c.content_rect.y, c.content_rect.width, c.content_rect.height)
            line = line + ", " + rect_json("clip_rect", c.clip_rect.present, c.clip_rect.x, c.clip_rect.y, c.clip_rect.width, c.clip_rect.height)
            line = line + ", \"style\": {"
            var pi = 0
            var emitted = 0
            val prop_count = c.computed_style.len() as i32
            while pi < prop_count:
                val prop = c.computed_style[pi]
                if is_paint_prop(prop.key):
                    if emitted > 0:
                        line = line + ", "
                    line = line + "\"" + json_escape(prop.key) + "\": \"" + json_escape(prop.value) + "\""
                    emitted = emitted + 1
                pi = pi + 1
            line = line + RB + RB
            print line
            ci = ci + 1
        print "      ]"
        print "    }"
        bi = bi + 1
    print "  ]"
    print "}"
    print END_SENTINEL
    0
