#!/bin/sh
# Chrome <-> Simple component-level differential runner.
#
# Stage 1: HTML parse -> DOM tree
# Stage 2: CSS parse + cascade -> computed style per node
#
# Fail-closed: if chrome is absent, or either extractor fails, or a fixture
# compares zero nodes/properties, this script exits NON-ZERO. There is no
# vacuous-pass path.
#
# Usage:
#   sh tools/web_diff/run_web_diff.shs [fixture-glob]
# Env:
#   WEB_DIFF_CHROME   explicit chrome binary path (required; no auto-discovery,
#                     because the repo's existing discovery helpers only probe
#                     /usr/bin and $HOME/.cache/ms-playwright)
#   WEB_DIFF_OUTDIR   output dir (default tools/web_diff/out)
set -eu

REPO=$(cd "$(dirname "$0")/../.." && pwd)
OUTDIR=${WEB_DIFF_OUTDIR:-"$REPO/tools/web_diff/out"}
FIXDIR="$REPO/tools/web_diff/fixtures"
SIMPLE_BIN=${SIMPLE_BIN:-"$REPO/bin/simple"}

if [ -z "${WEB_DIFF_CHROME:-}" ]; then
    echo "WEB_DIFF_UNAVAILABLE reason=no-chrome-path (set WEB_DIFF_CHROME)" >&2
    exit 3
fi
if [ ! -x "$WEB_DIFF_CHROME" ]; then
    echo "WEB_DIFF_UNAVAILABLE reason=chrome-not-executable path=$WEB_DIFF_CHROME" >&2
    exit 3
fi
if [ ! -x "$SIMPLE_BIN" ]; then
    echo "WEB_DIFF_UNAVAILABLE reason=simple-binary-missing path=$SIMPLE_BIN" >&2
    exit 3
fi

mkdir -p "$OUTDIR"
PATTERN=${1:-"*.html"}
FIXTURES=$(ls "$FIXDIR"/$PATTERN 2>/dev/null || true)
if [ -z "$FIXTURES" ]; then
    echo "WEB_DIFF_UNAVAILABLE reason=no-fixtures-matched pattern=$PATTERN" >&2
    exit 3
fi

TOTAL=0
FAILED=0
for f in $FIXTURES; do
    name=$(basename "$f" .html)
    TOTAL=$((TOTAL + 1))
    cj="$OUTDIR/$name.chrome.json"
    sj="$OUTDIR/$name.simple.json"
    rj="$OUTDIR/$name.diff.json"
    rm -f "$cj" "$sj" "$rj"

    if ! WEB_DIFF_CHROME="$WEB_DIFF_CHROME" WEB_DIFF_IN="$f" WEB_DIFF_OUT="$cj" \
        node "$REPO/tools/web_diff/chrome_extract.js" >"$OUTDIR/$name.chrome.log" 2>&1; then
        echo "FAIL $name chrome-extract"; FAILED=$((FAILED + 1)); continue
    fi
    if ! SIMPLE_MODULE_LIMIT=4000 WEB_DIFF_IN="$f" WEB_DIFF_OUT="$sj" \
        "$SIMPLE_BIN" run "$REPO/tools/web_diff/simple_extract.spl" \
        >"$OUTDIR/$name.simple.log" 2>&1; then
        echo "FAIL $name simple-extract"; FAILED=$((FAILED + 1)); continue
    fi
    if ! grep -q SIMPLE_EXTRACT_OK "$OUTDIR/$name.simple.log"; then
        echo "FAIL $name simple-extract-no-ok-marker"; FAILED=$((FAILED + 1)); continue
    fi
    if ! node "$REPO/tools/web_diff/normalize_diff.js" "$cj" "$sj" "$rj" "$name"; then
        echo "FAIL $name diff"; FAILED=$((FAILED + 1)); continue
    fi
done

node "$REPO/tools/web_diff/summarize.js" "$OUTDIR" || exit 1

echo "WEB_DIFF_RUN fixtures=$TOTAL failed=$FAILED"
[ "$FAILED" -eq 0 ] || exit 1
[ "$TOTAL" -gt 0 ] || exit 1
