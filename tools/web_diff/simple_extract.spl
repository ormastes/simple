# Simple-side stage extractor for the Chrome<->Simple component differential.
#
# Stage 1 (DOM):   html_tree_builder_build(html) -> BeDomNode tree
# Stage 2 (STYLE): process_style_blocks(root, html) -> same tree with
#                  node.style: StyleProps populated by the cascade.
#
# Emits ONE JSON document to WEB_DIFF_OUT describing both stages, in
# document order (pre-order), so the differ can align node-for-node with
# Chrome's DOMSnapshot.
#
# Env:
#   WEB_DIFF_IN   path to the fixture .html   (required)
#   WEB_DIFF_OUT  path to write the JSON      (required)
use std.env.variables.{env_get_or}
use std.nogc_sync_mut.io.file_ops.{file_read_text, file_write}
use std.gc_async_mut.gpu.browser_engine.dom.{BeDomNode, StyleProps}
use std.gc_async_mut.gpu.browser_engine.html_tree_builder.{
    html_tree_builder_build
}
use std.gc_async_mut.gpu.browser_engine.style_block.{process_style_blocks}

fn jesc(s: text) -> text:
    # Iterate by character, not by index: `text[i]` + `text.len()` disagree on
    # multi-byte input (an NBSP fixture reproduces
    # "string index out of bounds: index is 1 but length is 1").
    var out = ""
    for c in s:
        if c == "\"":
            out = out + "\\\""
        elif c == "\\":
            out = out + "\\\\"
        elif c == "\n":
            out = out + "\\n"
        elif c == "\r":
            out = out + "\\r"
        elif c == "\t":
            out = out + "\\t"
        else:
            out = out + c
    out

fn jstr(s: text) -> text:
    "\"" + jesc(s) + "\""

fn jnum(v: f64) -> text:
    "" + v

fn is_control_prefixed(key: text) -> bool:
    for c in key:
        return c.char_code_at(0) < 32
    false

fn attrs_json(node: BeDomNode) -> text:
    var keys = node.attributes.keys()
    keys.sort()
    var out = "{"
    var first = true
    for key in keys:
        # The tree builder stores internal bookkeeping under keys prefixed with
        # a control character (NUL). Those are not DOM attributes and must not
        # reach the differ. Tested by first-char class rather than by a literal
        # NUL so this source file stays plain ASCII text.
        if not is_control_prefixed(key):
            if not first:
                out = out + ","
            first = false
            out = out + jstr(key) + ":" + jstr(node.attributes.get(key) ?? "")
    out + "}"

fn style_json(s: StyleProps) -> text:
    var out = "{"
    out = out + jstr("display") + ":" + jstr(s.display)
    out = out + "," + jstr("position") + ":" + jstr(s.position)
    out = out + "," + jstr("width") + ":" + jnum(s.width)
    out = out + "," + jstr("height") + ":" + jnum(s.height)
    out = out + "," + jstr("margin-top") + ":" + jnum(s.margin_top)
    out = out + "," + jstr("margin-right") + ":" + jnum(s.margin_right)
    out = out + "," + jstr("margin-bottom") + ":" + jnum(s.margin_bottom)
    out = out + "," + jstr("margin-left") + ":" + jnum(s.margin_left)
    out = out + "," + jstr("padding-top") + ":" + jnum(s.padding_top)
    out = out + "," + jstr("padding-right") + ":" + jnum(s.padding_right)
    out = out + "," + jstr("padding-bottom") + ":" + jnum(s.padding_bottom)
    out = out + "," + jstr("padding-left") + ":" + jnum(s.padding_left)
    out = out + "," + jstr("color") + ":" + jstr(s.color)
    out = out + "," + jstr("background-color") + ":" + jstr(s.background_color)
    out = out + "," + jstr("font-size") + ":" + jnum(s.font_size)
    out = out + "," + jstr("font-weight") + ":" + jstr(s.font_weight)
    out = out + "," + jstr("font-family") + ":" + jstr(s.font_family)
    out = out + "," + jstr("text-align") + ":" + jstr(s.text_align)
    out = out + "," + jstr("border-width") + ":" + jnum(s.border_width)
    out = out + "," + jstr("border-color") + ":" + jstr(s.border_color)
    out = out + "," + jstr("border-style") + ":" + jstr(s.border_style)
    out = out + "," + jstr("flex-direction") + ":" + jstr(s.flex_direction)
    out = out + "," + jstr("flex-grow") + ":" + jnum(s.flex_grow)
    out = out + "," + jstr("top") + ":" + jnum(s.top)
    out = out + "," + jstr("left") + ":" + jnum(s.left)
    out = out + "," + jstr("z-index") + ":" + jnum(s.z_index as f64)
    out = out + "," + jstr("overflow") + ":" + jstr(s.overflow)
    out = out + "," + jstr("float") + ":" + jstr(s.float_css)
    out = out + "," + jstr("clear") + ":" + jstr(s.clear_css)
    out + "}"

fn walk(node: BeDomNode, parent: i32, mut rows: [text], mut counter: [i32]):
    val idx = counter[0]
    counter[0] = idx + 1
    var row = "{"
    row = row + jstr("index") + ":" + ("" + idx)
    row = row + "," + jstr("parent") + ":" + ("" + parent)
    row = row + "," + jstr("name") + ":" + jstr(node.tag_name)
    row = row + "," + jstr("text") + ":" + jstr(node.data)
    row = row + "," + jstr("attrs") + ":" + attrs_json(node)
    row = row + "," + jstr("style") + ":" + style_json(node.style)
    row = row + "}"
    rows.push(row)
    for child in node.children:
        walk(child, idx, rows, counter)

val in_path = env_get_or("WEB_DIFF_IN", "")
val out_path = env_get_or("WEB_DIFF_OUT", "")
if in_path == "" or out_path == "":
    print("SIMPLE_EXTRACT_ERROR missing WEB_DIFF_IN/WEB_DIFF_OUT")
else:
    val html = file_read_text(in_path)
    if html.len() == 0:
        print("SIMPLE_EXTRACT_ERROR empty input " + in_path)
    else:
        var root = html_tree_builder_build(html)
        root = process_style_blocks(root, html)
        var rows: [text] = []
        var counter: [i32] = [0]
        walk(root, -1, rows, counter)
        var body = ""
        var i = 0
        while i < rows.len():
            if i > 0:
                body = body + ","
            body = body + rows[i]
            i = i + 1
        val doc = "{\"engine\":\"simple\",\"source\":" + jstr(in_path) +
            ",\"nodeCount\":" + ("" + rows.len()) +
            ",\"nodes\":[" + body + "]}"
        file_write(out_path, doc)
        print("SIMPLE_EXTRACT_OK nodes=" + ("" + rows.len()) + " -> " + out_path)
