FROM ubuntu:24.04

# Host C/C++ compiler policy: Clang. Do not replace this with GCC.

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        coreutils \
        clang \
        libc6-dev \
        make \
        golang-go \
        python3 \
        time \
        procps \
        jq \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

ENTRYPOINT ["/bin/sh"]
