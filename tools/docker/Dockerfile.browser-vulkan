# Dockerfile.browser-vulkan — deps-only container for the headless
# browser-over-Vulkan system lane (scripts/check/check-simple-web-browser-docker-vulkan.shs).
#
# Same COPY-the-repo prohibition as Dockerfile.test-isolation: the repo is
# bind-mounted at `docker run` time; build context is tools/docker only.
#
# Adds on top of the test-isolation set:
#   mesa-vulkan-drivers — lavapipe (llvmpipe) software Vulkan ICD, the
#                         headless device the lane renders on
#   libvulkan1          — the Vulkan loader the vulkan-featured seed dlopens
#   vulkan-tools        — vulkaninfo, for in-container device diagnostics
FROM ubuntu:24.04

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        coreutils \
        jq \
        libvulkan1 \
        mesa-vulkan-drivers \
        vulkan-tools \
    && rm -rf /var/lib/apt/lists/*

ENV VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/lvp_icd.json

WORKDIR /opt/simple

ENTRYPOINT ["/bin/bash"]
