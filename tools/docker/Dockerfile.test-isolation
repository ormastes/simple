# Dockerfile.test-isolation — deps-only container for running `bin/simple
# test` against a bind-mounted repo checkout.
#
# COPY-the-repo is forbidden here — build context in this shared tree is
# ~235GB (184GB build/ + 51GB .git/); a `COPY . /opt/simple` build ran 10+
# minutes at high CPU before being killed. Instead this image installs only
# the runtime deps the seed binary needs, and the repo is bind-mounted at
# `docker run` time (see scripts/local-container-test.shs). Build context for
# this image is `tools/docker` (a handful of KB), never the repo root.
#
# `ldd bin/release/x86_64-unknown-linux-gnu/simple` -> libm, libgcc_s, libc,
# ld-linux only — all already present in the ubuntu:24.04 base image, so no
# extra runtime libs are installed here. bash/coreutils/ca-certificates/jq
# are kept for the test runner's own shell/script needs.
FROM ubuntu:24.04

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        coreutils \
        jq \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/simple

ENTRYPOINT ["/bin/bash"]
