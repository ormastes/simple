{
    "LanguageServerManager": {
        "language_servers": {
            "simple-lsp": {
                "version": 2,
                "argv": ["<repo_root>/bin/simple", "run", "<repo_root>/src/app/lsp/main.spl"],
                "languages": ["simple"],
                "mime_types": ["text/x-simple"],
                "display_name": "Simple Language Server"
            }
        }
    }
}
