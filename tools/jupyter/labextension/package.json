{
  "name": "@simple-lang/jupyterlab-simple",
  "version": "0.1.0",
  "description": "JupyterLab extension for the Simple language: CodeMirror 6 syntax highlighting, LSP wiring, lane picker, math outputs.",
  "license": "Apache-2.0",
  "author": "simple-lang",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension",
    "simple-lang"
  ],
  "files": [
    "lib/**/*.{d.ts,eot,gif,html,jpg,js,js.map,json,png,svg,woff2,ttf}",
    "style/**/*.{css,eot,gif,html,jpg,json,png,svg,woff2,ttf}",
    "schema/*.json"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "style": "style/index.css",
  "sideEffects": [
    "style/*.css"
  ],
  "jupyterlab": {
    "extension": true,
    "outputDir": "simple_labextension/labextension"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf lib tsconfig.tsbuildinfo",
    "gen:grammar": "ts-node scripts/../../../scripts/gen_cm6_grammar.ts",
    "test": "jest",
    "watch": "tsc -b -w"
  },
  "dependencies": {
    "@codemirror/language": "^6.10.0",
    "@jupyterlab/application": "^4.0.0",
    "@jupyterlab/apputils": "^4.0.0",
    "@jupyterlab/codemirror": "^4.0.0",
    "@jupyterlab/notebook": "^4.0.0",
    "@jupyterlab/services": "^7.0.0",
    "@jupyterlab/statusbar": "^4.0.0",
    "@lezer/highlight": "^1.2.0",
    "@lumino/commands": "^2.0.0",
    "@lumino/widgets": "^2.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.ts"
    ],
    "setupFiles": [
      "<rootDir>/tests/jsdom-polyfills.ts"
    ]
  }
}
