use std.cli.cli_util.{get_cli_args}
use std.nogc_sync_mut.io.file_ops.{file_read}
use app.sspec_maintain.analyzer.{analyze_sspec_text}

fn main():
    val args = get_cli_args()
    var i = 0
    while i < args.len():
        val path = args[i]
        i = i + 1
        val source = file_read(path) ?? ""
        if source == "":
            print path + "\t-1"
            continue
        val report = analyze_sspec_text(path, source)
        print path + "\t" + report.scenario_count.to_text() + "\t" + report.real_assertion_count.to_text() + "\t" + report.step_count.to_text() + "\t" + report.requirement_count.to_text()
