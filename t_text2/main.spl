fn main():
    val k = "k"
    val miss = "nope"
    var d: Dict<text, text> = {}
    d[k] = "VALUE_ALPHA"
    d["k2"] = "VALUE_BETA"

    print "T01 ctl_has={d.contains_key(k)}"
    print "T02 ctl_keys_len={d.keys().len()}"
    print "T03 ctl_idx={d[k]}"
    print "T04 dict_len={d.len()}"

    val g = d.get(k)
    print "T05 get_hit_isnil={g == nil}"
    print "T06 get_hit_RAWPRINT={g}"

    val gm = d.get(miss)
    print "T07 get_miss_isnil={gm == nil}"
    print "T08 get_miss_RAWPRINT={gm}"

    # CONTROL: does .unwrap() resolve at all in this harness?
    val ctrl: text? = Some("CTRL_VAL")
    print "T09 ctrl_isnil={ctrl == nil}"
    print "T10 ctrl_unwrap={ctrl.unwrap()}"

    # CONTROL: Some(d[k]) manual wrap, documented as correct
    val wrapped: text? = Some(d[k])
    print "T11 wrapped_unwrap={wrapped.unwrap()}"
    print "T12 DONE"
