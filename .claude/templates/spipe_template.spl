# @cover src/path/to/covered_module.spl 80%
"""
## Purpose and audience
One paragraph: what this feature does, why it matters, who reads this manual.
Feature IDs: #XXX. Category: Infrastructure | Language | Stdlib | Runtime | Testing | Tooling.
## Operator workflow
bin/simple test test/<path>/<name>_spec.spl
## Compatibility and limitations
What is unsupported, and on which hosts this spec cannot run.
## Verification guidance and troubleshooting
How to read the retained evidence; what a RED here usually means.
"""
# Lifecycle: doc/01_research/<existing>.md ; doc/03_plan/<existing>.md ;
# doc/04_architecture/<existing>.md ; doc/05_design/<existing>.md
# (MNT-007/MNT-009: list only files that EXIST; never fabricate a path. The
# four placeholders above cost -10 maintainability each on the scan surface
# until replaced — the template as shipped measures GATE 100 / SCAN 93.)
# Acceptance specs that pin a not-yet-implemented interface carry the
# in-development tag as a `# ` comment on LINE 1 (spipe.md "the ONE legitimate
# way to ship an expected-to-fail spec"). The tag scanner matches the token
# ANYWHERE in the source, comments included, so it is deliberately not spelled
# out here — copying this template must not tag your spec.
# @manual_section: primary

use std.spec

# ============================================================================
# The manual-first authoring convention
# ----------------------------------------------------------------------------
# Write the MANUAL before the assertions. A spipe spec is the executable source
# of a user- or qa-facing manual, so the document is the design artifact and the
# code is what proves it; specs written assertions-first produce manuals that
# read as a transcript of someone debugging, not as something a reader can
# follow. In order:
#
#   1. Draft the docstring above as the manual's opening — purpose, audience,
#      operator workflow, limitations. If you cannot say who reads it and what
#      they do with it, the scenario is not yet designed.
#   2. Name each `it` as the sentence you want to appear as a manual heading:
#      what the product does, in the reader's vocabulary, not "test X returns Y".
#   3. Write the `step("...")` calls as the numbered prose of that section,
#      BEFORE the expectations. Each step is a sentence in the shipped manual —
#      docgen emits them verbatim — so they must read as instructions to a
#      person, not as narration of the test harness.
#   4. Attach the evidence: a `# @capture(...)` line directly above the step it
#      documents (docgen binds a capture to the NEXT step), or a real capture
#      call. Evidence is what turns the prose into a generated manual rather
#      than a claim.
#   5. Only then write `expect(...)` over what the product actually returned.
#
# Fold long or repeated evidence out of the manual body with the `@manual` and
# `@manual-file` tags rather than trimming the prose; use `@manual_section:` to
# group scenarios under one heading when a file carries more than one.
#
# The audience decides the register: `--audience=user` manuals describe observable
# behaviour only, `--audience=qa` manuals may name internal fixtures and wire
# formats. Write for one audience per scenario and let docgen gate the other.
#
# Consequence worth stating plainly: a scenario whose steps do not read as a
# manual is a defect in the SPEC, not a docgen shortfall — fix the prose here.
#
# ============================================================================
# Score-bearing structure (see .claude/skills/spipe.md "Scoring 90+"):
#   - triple-quoted docstring with "## Purpose and audience"  (NAR-001)
#   - `# @req` + a REQ id INSIDE every `it` body, nowhere else (TRC-001/003)
#   - >= 1 step("...") in every `it` body                    (BEH-001)
#   - a `# @capture(...)` line inside the body, directly above
#     the step("...") it documents (docgen attaches it to the
#     NEXT step), or a real capture call                    (EVD-001)
#   - assert what the product returned, never a literal you
#     just bound (`val x = 3` / `expect(x).to_equal(3)`)     (ORA-002 blocker)
#   - numeric expected values carry `# oracle: <source>`     (ORA-003)
#   - one adverse scenario (rejects/invalid/boundary/...)    (COV-001)
#   - `# @manual_section:` once when there are >1 scenarios (MNT-001)
#   - never a bare `@step "..."` decorator; use `# @step:`   (MNT-003)
# Measure: sh scripts/check/sspec-score-seed-lane.shs <this file>
# ============================================================================

# ============================================================================
# Step Helpers — name helpers so underscores read as manual sentences
# (docgen renders `open_app()` as "Open app"). `# @step:` overrides the label.
# ============================================================================

# @step: Open the application
fn open_app() -> text:
    fail("TODO: replace generated placeholder with the real launch")

fn configure_with_valid_settings(config: text) -> text:
    fail("TODO: replace generated placeholder with the real configuration call")

fn perform_main_action(session: text) -> text:
    fail("TODO: replace generated placeholder with the real action")


# ============================================================================
# Primary Scenarios
# ============================================================================

describe "Feature Name":

    it "completes the primary workflow and reports the documented outcome":
        # @req REQ-FEATURE-001
        step("Open the application")
        val session = open_app()
        step("Configure it with valid settings")
        val configured = configure_with_valid_settings("default")
        step("Perform the main action")
        val result = perform_main_action(configured)
        # @capture(exec): stdout/stderr of the main action
        step("Verify the documented outcome")
        expect(result).to_equal(session)

    it "rejects invalid settings instead of proceeding":
        # @req REQ-FEATURE-002
        step("Open the application")
        val session = open_app()
        step("Configure it with settings the product must reject")
        val outcome = configure_with_valid_settings("")
        # @capture(exec): the rejection message
        step("Verify the rejection is reported, not silently accepted")
        expect(outcome).to_contain("rejected")
        assert_not_equal(outcome, session)


# ============================================================================
# Environmental / System Evidence (use for system specs)
# ============================================================================
