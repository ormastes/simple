# ============================================================================
# Typed Evidence / Modern SSpec Oracle (commented example)
# ============================================================================
# Attach a typed oracle to a captured value instead of asserting on a string
# built from the observation itself. Guide: doc/07_guide/infra/sspec_typed_evidence.md
#
# use std.common.spec.evidence.model.{check_exact, check_full_pattern, check_ignore, oracle_spec}
# use std.common.spec.evidence.evidence_comparator.{compare_evidence}
#
# describe "Protocol Frame":
#     it "matches the typed oracle":
#         # @req <your REQ id>
#         step("Capture the protocol frame")
#         val evidence = capture_frame_evidence()
#         step("Compare against the typed oracle spec")
#         val checks = [
#             check_exact("frame.type", "SYN"),
#             check_full_pattern("frame.nonce", "hex:16"),
#             check_ignore("frame.timestamp", "non-deterministic wall clock"),
#         ]
#         val spec = oracle_spec("protocol.v1", checks)
#         val result = compare_evidence(evidence, spec)
#         expect(result.status).to_equal(EvidenceStatus.passed)

# ============================================================================
# Lane-Gated Spec Pattern (commented example)
# ============================================================================
# Specs that require optional hardware (QEMU, CUDA, Vulkan) or host features
# (Jupyter kernel) probe first and `skip(...)` when absent. A skip(...) CALL
# inside a scenario is an ORA-001 pending scaffold for the scorer, so keep the
# probe in a helper that returns a bool and branch on it in the body:
#
# fn probe_example_hardware() -> bool:
#     fail("TODO: probe for required hardware and return true if available")
#
# describe "Feature Requiring Optional Hardware":
#     it "primary workflow with hardware":
#         # @req <your REQ id>
#         step("Check the hardware lane")
#         val available = probe_example_hardware()
#         step("Execute on the available hardware")
#         # @capture(exec): device transcript
#         val result = if available: run_on_hardware() else: "lane-absent"
#         assert_not_equal(result, "")

# Before handoff: measure with `sh scripts/check/sspec-score-seed-lane.shs
# <this-spec>` (or `simple sspec-maintain scan <this-spec>` where a full CLI is
# deployed). Review all seven dimensions and stable findings. `improve` is
# preview-only until the exact patch is confirmed. Every unresolved oracle
# must remain fail-fast; never replace one with a pending marker.
