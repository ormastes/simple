#!/bin/sh
# UserPromptSubmit hook: track ponytail toggles deterministically.
#
# Reads the hook JSON on stdin, looks at the prompt text only, and writes
# .simple/ponytail.level when it sees:
#   /ponytail lite|full|ultra|off      -> that level
#   /ponytail (bare)                   -> full
#   "stop ponytail" / "normal mode"    -> off
# Prints a one-line notice on change (added to context). Anything else: silent.
#
# --selftest: feed fixture prompts, print Results: <passed> passed, <failed> failed
#
# ponytail: grep on the raw JSON instead of a JSON parser — the prompt field is
# the only string these phrases can plausibly appear in; parse properly if it misfires.

ROOT="${CLAUDE_PROJECT_DIR:-$(cd "$(dirname "$0")/../.." && pwd)}"
LEVEL_FILE="${PONYTAIL_LEVEL_FILE:-$ROOT/.simple/ponytail.level}"

apply() {  # reads prompt json from stdin
    input=$(cat)
    new=""
    # Deactivation phrases must be the WHOLE prompt (trailing punctuation
    # ignored), as the original plugin does (ponytail-config.js:40-43) — a
    # substring match would switch the mode off on "don't stop ponytail".
    prompt=$(printf '%s' "$input" | sed -n 's/.*"prompt"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1 | tr 'A-Z' 'a-z' | sed 's/^[[:space:]]*//; s/[[:space:]!.?]*$//')
    if [ "$prompt" = "stop ponytail" ] || [ "$prompt" = "normal mode" ] || printf '%s' "$input" | grep -qiE '/ponytail[[:space:]]+off'; then
        new=off
    elif printf '%s' "$input" | grep -qE '/ponytail[[:space:]]+(lite|full|ultra)'; then
        new=$(printf '%s' "$input" | grep -oE '/ponytail[[:space:]]+(lite|full|ultra)' | head -n 1 | awk '{print $2}')
    elif printf '%s' "$input" | grep -qE '/ponytail([^-a-z]|$)'; then
        new=full
    fi
    [ -z "$new" ] && return 0
    mkdir -p "$(dirname "$LEVEL_FILE")"
    printf '%s\n' "$new" > "$LEVEL_FILE"
    if [ "$new" = off ]; then
        echo "PONYTAIL MODE OFF"
    else
        echo "PONYTAIL MODE CHANGED — level: $new"
    fi
}

selftest() {
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/ponytail-prompt.XXXXXX")
    pass=0; fail=0
    check() {  # name prompt expected_level_file_content
        printf '{"prompt":"%s"}' "$2" | PONYTAIL_LEVEL_FILE="$tmp/level" sh "$0" >/dev/null
        got=$(cat "$tmp/level" 2>/dev/null || echo "")
        if [ "$got" = "$3" ]; then pass=$((pass+1)); else fail=$((fail+1)); echo "FAIL $1: got '$got' want '$3'"; fi
    }
    check lite      "/ponytail lite please"      lite
    check ultra     "/ponytail ultra"            ultra
    check bare      "/ponytail"                  full
    check stop      "Stop ponytail!"             off
    check normal    "normal mode"                off
    check noop      "unrelated prompt"           off
    check help-noop "/ponytail-help"             off
    printf 'ultra\n' > "$tmp/level"
    check embedded  "do not stop ponytail yet"   ultra
    check embedded2 "back to normal mode later"  ultra
    rm -rf "$tmp"
    echo "Results: $pass passed, $fail failed"
    [ "$fail" -eq 0 ]
}

case "${1:-}" in
    --selftest) selftest ;;
    *) apply ;;
esac
