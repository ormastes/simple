#!/bin/sh
# ctx_common.shs — shared helpers for the project-level PreToolUse hooks.
# Sourced (`. "$dir/ctx_common.shs"`) by every hook under .claude/hooks/.
# POSIX sh only (dash-clean): no arrays, no [[ ]], no local-scoped regex.
#
# Hook protocol (Claude Code PreToolUse): JSON on stdin with tool_name and
# tool_input; a JSON object on stdout carrying hookSpecificOutput decides.
#   deny  -> {"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"..."}}
#   hint  -> {"hookSpecificOutput":{"hookEventName":"PreToolUse","additionalContext":"..."}}
#
# Speed: on Windows (Git Bash) every fork costs tens of ms, so helpers here use
# shell builtins (read, case, parameter expansion) wherever they can; the
# measured budget is well under 300 ms per hook call.

# Read all of stdin into HOOK_INPUT. Lines are joined with a space, so the
# value is always single-line (Claude Code sends one JSON line; embedded
# newlines inside strings are the two characters \n). Builtins only, no `cat`.
ctx_read_input() {
    HOOK_INPUT=""
    while IFS= read -r _l || [ -n "$_l" ]; do
        HOOK_INPUT="$HOOK_INPUT$_l "
    done
    return 0
}

# Extract the string value of a JSON key from HOOK_INPUT (first occurrence)
# and DECODE its JSON escapes: \\ -> \, \" -> ", \n -> newline, \t -> space,
# \r -> (dropped), \/ -> /. Decoding happens here, once, so no caller ever sees
# a still-escaped value (a Windows path arrives as C:\dev\x, not C:\\dev\\x).
# \uXXXX is left as-is.
ctx_json_str() {
    # NOTE: uses ERE (-E) deliberately. The BRE form of this expression needs
    # `\|` alternation, which is a GNU sed extension — BSD/macOS sed treats it
    # as a literal `|`, so the pattern never matched and every hook that calls
    # this saw an empty value. bash_net_blocker.shs is fail-closed, so on macOS
    # that silently denied EVERY Bash command. -E is portable across BSD + GNU.
    # Decode order matters: `\\` is parked as the two characters `\{` first
    # (a bare `\{` is not a legal JSON escape, so it cannot occur in input) so
    # `\\n` (escaped backslash + n) is not read as a newline. A newline is
    # emitted with the POSIX backslash-newline replacement form (portable to
    # BSD sed). Input comes from a here-doc, not a pipe: a pipe forks a
    # subshell for the builtin printf, which costs ~15 ms on Windows.
    _nl='
'
    sed -n -E \
        -e "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"(([^\"\\\\]|\\\\.)*)\".*/\1/;t dec" \
        -e "b" \
        -e ":dec" \
        -e "s/\\\\\\\\/\\\\{/g" \
        -e "s/\\\\\"/\"/g" \
        -e "s/\\\\n/\\${_nl}/g" \
        -e "s/\\\\t/ /g" \
        -e "s/\\\\r//g" \
        -e "s/\\\\\\//\\//g" \
        -e "s/\\\\\\{/\\\\/g" \
        -e "p" <<CTX_JSON_EOF
$HOOK_INPUT
CTX_JSON_EOF
}

# Turn a decoded Windows path (C:\dev\x) into one `[ -f ]` accepts under
# Git Bash / MSYS / Cygwin. POSIX paths pass through untouched. Result is left
# in CTX_PATH (no subshell: forks are expensive on Windows). The `\` -> `/`
# swap is tried first (Git Bash accepts C:/dev/x); cygpath -u is the fallback
# for runtimes that do not.
ctx_posix_path() {
    CTX_PATH=$1
    case $1 in
        [A-Za-z]:[\\/]*)
            _in=$1
            CTX_PATH=""
            while :; do
                case $_in in
                    *\\*) CTX_PATH="$CTX_PATH${_in%%\\*}/"; _in=${_in#*\\} ;;
                    *) CTX_PATH="$CTX_PATH$_in"; break ;;
                esac
            done
            if [ ! -e "$CTX_PATH" ] && command -v cygpath >/dev/null 2>&1; then
                _q=$(cygpath -u "$1" 2>/dev/null) && [ -n "$_q" ] && CTX_PATH=$_q
            fi ;;
    esac
    return 0
}

# Hints name simple_ctx_* tools of the `simple-mcp` server. Emit them only if
# the launcher .mcp.json names for that server exists (as given, or with a
# Windows .cmd/.exe/.bat suffix); otherwise the hint would point at tools the
# session does not have. Existence is the lightest reliable check — it does not
# prove the server starts. CTX_HINTS=0 silences hints; CTX_HINTS_FORCE=1 skips
# the check (selftests). Builtins only.
ctx_hints_enabled() {
    [ "${CTX_HINTS:-}" = 0 ] && return 1
    [ "${CTX_HINTS_FORCE:-}" = 1 ] && return 0
    ctx_posix_path "${CLAUDE_PROJECT_DIR:-${HOOK_DIR:-${0%/*}}/../..}"
    _root=$CTX_PATH
    [ -f "$_root/.mcp.json" ] || return 1
    _cmd=""
    _in_srv=0
    while IFS= read -r _l || [ -n "$_l" ]; do
        case $_l in
            *'"simple-mcp"'*:*'{'*) _in_srv=1 ;;
            *'"command"'*:*)
                if [ "$_in_srv" = 1 ]; then
                    _v=${_l#*'"command"'}
                    _v=${_v#*'"'}
                    _cmd=${_v%%'"'*}
                    break
                fi ;;
        esac
    done < "$_root/.mcp.json"
    [ -n "$_cmd" ] || return 1
    ctx_posix_path "$_cmd"
    case $_cmd in
        [A-Za-z]:[\\/]*|/*) _base=$CTX_PATH ;;
        *) _base="$_root/$_cmd" ;;
    esac
    for _s in "" .cmd .exe .bat; do
        [ -f "$_base$_s" ] && return 0
    done
    return 1
}

# Make text safe to embed inside a JSON string literal; result in CTX_ESC.
# Control characters (newline, CR, tab -> space; others dropped) take the slow
# tr path only when present; backslash and quote are escaped with builtins.
ctx_json_esc() {
    _s=$1
    case $_s in
        *[[:cntrl:]]*) _s=$(printf '%s' "$_s" | tr '\n\r\t' '   ' | tr -d '\000-\010\013\014\016-\037') ;;
    esac
    CTX_ESC=""
    while :; do
        case $_s in
            *[\\\"]*)
                _pre=${_s%%[\\\"]*}
                _rest=${_s#"$_pre"}
                _c=${_rest%"${_rest#?}"}
                CTX_ESC="$CTX_ESC$_pre\\$_c"
                _s=${_rest#?} ;;
            *) CTX_ESC="$CTX_ESC$_s"; break ;;
        esac
    done
}

ctx_emit_deny() {
    ctx_json_esc "$1"
    printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"%s"}}\n' "$CTX_ESC"
}

# Hints are advisory and only valid when simple-mcp is actually launchable.
ctx_emit_hint() {
    ctx_hints_enabled || return 0
    ctx_json_esc "$1"
    printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","additionalContext":"%s"}}\n' "$CTX_ESC"
}
