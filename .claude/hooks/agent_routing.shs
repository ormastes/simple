#!/bin/sh
# agent_routing.shs — PreToolUse(Agent|Task) MODIFY. FAIL-OPEN.
#
# Parity with the context-mode plugin's Agent/Task routing (its
# core/routing.mjs:184-194): append the ctx routing block
# (.claude/hooks/ctx_routing_block.md) to the subagent prompt and upgrade a
# `Bash`-typed subagent to `general-purpose` so it can reach the simple_ctx_*
# MCP tools. Emits Claude Code's `updatedInput` envelope, the same shape the
# plugin's formatters.mjs `modify` produces.
#
# Idempotent: silent when the prompt already carries the block. Fail-open:
# no jq, no block file, unparsable input, non-object tool_input -> exit 0
# with no output (the call proceeds unmodified).
#
# Selftest: sh .claude/hooks/agent_routing.shs --selftest
set -u
HOOK_DIR=$(dirname "$0")
BLOCK_FILE="${CTX_ROUTING_BLOCK:-$HOOK_DIR/ctx_routing_block.md}"

ctx_decide() {   # stdin: hook JSON; stdout: envelope or nothing
    command -v jq >/dev/null 2>&1 || return 0
    [ -f "$BLOCK_FILE" ] || return 0
    # Buffer stdin first so a malformed/empty payload is skipped cheaply
    # (the pipe itself delivers fine; an earlier empty-output hunt here was a
    # payload truncated at source — see the }} string-literal bug record).
    input=$(cat 2>/dev/null) || return 0
    [ -n "$input" ] || return 0
    printf '%s' "$input" | jq -c --rawfile block "$BLOCK_FILE" '
        .tool_input as $ti
        | if ($ti | type) != "object" then empty
          elif (($ti.prompt // "") | contains("<context_window_protection>")) then empty
          else {hookSpecificOutput: {hookEventName: "PreToolUse",
                  updatedInput: ($ti
                      + {prompt: (($ti.prompt // "") + "\n\n" + $block)}
                      + (if ($ti.subagent_type // "") == "Bash" then {subagent_type: "general-purpose"} else {} end))}}
          end' 2>/dev/null
    return 0
}

if [ "${1:-}" = "--selftest" ]; then
    fail=0
    out=$(printf '%s' '{"tool_name":"Agent","tool_input":{"prompt":"p1","subagent_type":"Bash","description":"d"}}' | ctx_decide)
    case "$out" in *'"updatedInput"'*'"subagent_type":"general-purpose"'*) ;; *) echo "selftest FAIL: Bash subagent not upgraded"; fail=1 ;; esac
    case "$out" in *'<context_window_protection>'*'"description":"d"'*|*'"description":"d"'*'<context_window_protection>'*) ;; *) echo "selftest FAIL: block or fields missing"; fail=1 ;; esac
    out=$(printf '%s' '{"tool_name":"Task","tool_input":{"prompt":"p2","subagent_type":"Explore"}}' | ctx_decide)
    case "$out" in *'"subagent_type":"Explore"'*) ;; *) echo "selftest FAIL: non-Bash type changed"; fail=1 ;; esac
    out=$(printf '%s' '{"tool_input":{"prompt":"<context_window_protection> already"}}' | ctx_decide)
    [ -z "$out" ] || { echo "selftest FAIL: not idempotent"; fail=1; }
    out=$(printf '%s' '{"tool_input":7}' | ctx_decide)
    [ -z "$out" ] || { echo "selftest FAIL: non-object tool_input must be silent"; fail=1; }
    out=$(printf '%s' 'not json' | ctx_decide)
    [ -z "$out" ] || { echo "selftest FAIL: bad input must be silent"; fail=1; }
    [ "$fail" -eq 0 ] && echo "PASS — agent_routing selftest: 2 modified, 3 silent"
    exit "$fail"
fi

ctx_decide
exit 0
