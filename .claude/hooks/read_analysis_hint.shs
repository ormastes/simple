#!/bin/sh
# read_analysis_hint.shs — PreToolUse(Read) HINT. FAIL-OPEN.
#
# When a Read targets a large file (> READ_HINT_LINES lines, default 200) and
# no offset/limit window was given, add context suggesting
# simple_ctx_execute_file(path, language, code) — the file stays in the
# sandbox and only the printed summary returns. Reading in order to Edit is
# still the right call; the hint says so.
#
# Fail-open: missing file, unreadable input, anything odd -> exit 0 silently.
#
# Selftest: sh .claude/hooks/read_analysis_hint.shs --selftest

set -u
HOOK_DIR=$(dirname "$0")
. "$HOOK_DIR/ctx_common.shs" || exit 0
LIMIT=${READ_HINT_LINES:-200}

ctx_decide() {
    path=$1
    windowed=$2
    [ -n "$path" ] || return 0
    [ "$windowed" = "1" ] && return 0
    [ -f "$path" ] || return 0
    lines=$(wc -l < "$path" 2>/dev/null) || return 0
    [ "${lines:-0}" -gt "$LIMIT" ] 2>/dev/null || return 0
    ctx_emit_hint "Read of a ${lines}-line file. If you are reading to Edit it, Read is correct. If you are reading to analyze, explore or summarize, prefer simple-mcp simple_ctx_execute_file(path, language: shell|javascript|simple, code) — the file is exposed to the code as \$1/\$FILE and only stdout enters the transcript."
    return 0
}

if [ "${1:-}" = "--selftest" ]; then
    fail=0
    big=$(mktemp) || exit 1
    i=0; while [ "$i" -lt 300 ]; do echo "line $i"; i=$((i+1)); done > "$big"
    out=$(ctx_decide "$big" 0)
    case "$out" in *'"additionalContext"'*300-line*) ;; *) echo "selftest FAIL: big file not hinted"; fail=1 ;; esac
    out=$(ctx_decide "$big" 1)
    [ -z "$out" ] || { echo "selftest FAIL: windowed read hinted"; fail=1; }
    out=$(ctx_decide "$big.missing" 0)
    [ -z "$out" ] || { echo "selftest FAIL: missing file must be silent"; fail=1; }
    out=$(ctx_decide "" 0)
    [ -z "$out" ] || { echo "selftest FAIL: empty path must be silent"; fail=1; }
    rm -f "$big"
    [ "$fail" -eq 0 ] && echo "PASS — read_analysis_hint selftest: 1 hinted, 3 silent"
    exit "$fail"
fi

ctx_read_input || exit 0
path=$(ctx_json_str file_path) || exit 0
windowed=0
case "$HOOK_INPUT" in *'"offset"'*|*'"limit"'*) windowed=1 ;; esac
ctx_decide "$path" "$windowed"
exit 0
