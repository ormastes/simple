# @cover src/app/test/chrome_component_renderer_parity/sharding.spl
use std.spec.*
use app.test.chrome_component_renderer_parity.*

describe "Chrome component renderer parity deterministic sharding":
    it "assigns every fixture once and returns stable ordered shards":
        val manifest = load_parity_manifest(DEFAULT_PARITY_MANIFEST)
        var total: i64 = 0
        var shard_index: i64 = 0
        while shard_index < 16:
            val first = build_parity_shard(manifest, 16, shard_index)
            val second = build_parity_shard(manifest, 16, shard_index)
            expect(first.valid()).to_equal(true)
            expect(first.cases.len()).to_be_less_than(26)
            expect(second.cases.len()).to_equal(first.cases.len())
            var index: i64 = 0
            while index < first.cases.len():
                expect(second.cases[index].id).to_equal(first.cases[index].id)
                expect(parity_fixture_shard(first.cases[index].id, 16)).to_equal(shard_index)
                index = index + 1
            total = total + first.cases.len()
            shard_index = shard_index + 1
        expect(total).to_equal(232)

    it "fails closed for invalid shard coordinates":
        val manifest = load_parity_manifest(DEFAULT_PARITY_MANIFEST)
        expect(build_parity_shard(manifest, 0, 0).valid()).to_equal(false)
        expect(build_parity_shard(manifest, 12, -1).valid()).to_equal(false)
        expect(build_parity_shard(manifest, 12, 12).valid()).to_equal(false)
