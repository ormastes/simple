use std.spec
use std.security.sanitize.{strip_html_tags}

# UTF-8 index-space regression for the HTML sanitizer.
#
# `input.len()` and `input.slice(a, b)` count BYTES; `char_at(i)` counts
# CHARACTERS. `strip_html_tags` mixed them, so `slice(i, i + 1)` emitted a
# SINGLE BYTE at a character index. Two consequences, both observed:
#   1. every multi-byte character left the sanitizer as an isolated lead byte
#      (invalid UTF-8), and
#   2. the byte-length loop bound desynced the in_tag state machine, so tag
#      fragments LEAKED through -- `"<p>\u{e9}</p>"` returned a broken byte
#      followed by a literal `>`.
# The second is a sanitizer correctness failure, not just mojibake.
#
# Byte widths below are hand-computed from the UTF-8 encoding, never taken
# from a reference implementation or from cross-engine agreement:
#   e-acute  U+00E9  = C3 A9        2 bytes, 1 character
#   CJK      U+4E2D  = E4 B8 AD     3 bytes, 1 character
#   party    U+1F389 = F0 9F 8E 89  4 bytes, 1 character

describe "strip_html_tags UTF-8 index space":
    # "<p>" 3 + e-acute 2 + "</p>" 4 = 9 BYTES but 8 CHARACTERS.
    it "keeps a 2-byte character as tag content":
        expect(strip_html_tags("<p>\u{e9}</p>")).to_equal("\u{e9}")

    it "keeps a 3-byte CJK character as tag content":
        expect(strip_html_tags("<p>\u{4e2d}</p>")).to_equal("\u{4e2d}")

    it "keeps a 4-byte emoji as tag content":
        expect(strip_html_tags("<p>\u{1f389}</p>")).to_equal("\u{1f389}")

    # ASCII control: this shape always worked, which is what hid the defect.
    it "ASCII control -- removes tags around single-byte content":
        expect(strip_html_tags("<p>e</p>")).to_equal("e")

    it "keeps mixed-width text intact across several tags":
        expect(strip_html_tags("<b>caf\u{e9}</b> <i>\u{4e2d}</i>")).to_equal("caf\u{e9} \u{4e2d}")

    # Byte length proves nothing was split into an isolated byte and that the
    # loop did not overrun: "caf" 3 + e-acute 2 = 5 BYTES.
    it "preserves byte length of multi-byte tag content":
        expect(strip_html_tags("<p>caf\u{e9}</p>").len()).to_equal(5)

    # The state-machine half: markup after a multi-byte character must still be
    # suppressed. Before the fix this leaked a literal ">".
    it "keeps the tag state machine in sync after a multi-byte character":
        expect(strip_html_tags("\u{e9}<b>x</b>y")).to_equal("\u{e9}xy")

    it "does not leak tag characters after a multi-byte character":
        expect(strip_html_tags("<p>\u{e9}</p>").contains(">")).to_equal(false)
