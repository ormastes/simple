# @cover src/lib/common/ui/widget_draw_ir.spl 60%
# @tag: unit, ui, draw_ir, draw_ir_v3, text, unified_packed_ui_scene
#
# Regression guard for
# doc/08_tracking/bug/packed_scene_text_runs_carry_zero_glyphs_2026-08-06.md.
#
# The DrawIR v3 text-run table stores ONLY glyphs -- it has no string field --
# so a run with `glyph_count == 0` is unrenderable no matter what the consumer
# does. Before the fix, `widget_tree_to_draw_ir_cpu` emitted glyphs only for
# complex-script text, so every Latin label reached v3 with zero glyphs and no
# showcase target drew any text.
#
# Anti-vacuity: it is not enough to assert "a text command exists" or to trust
# `raster_scene_into`'s painted counter -- that counter increments for a TEXT
# command whose run has zero glyphs, which is exactly how the defect stayed
# invisible. These examples assert a POSITIVE glyph count and that a zero-glyph
# run rasterizes to a literally blank surface.

use std.spec
use app.ui_showcase.showcase_core.{showcase_build_sized}
use app.ui_showcase.hosts.scene_raster.{raster_scene_argb, RASTER_BG}
use common.ui.widget_draw_ir.{widget_tree_to_draw_ir_cpu}
use common.ui.draw_ir_v2_to_v3.{draw_ir_v2_to_v3}
use common.ui.draw_ir_v3.{draw_ir_v3_text_run_at, DRAW_IR_V3_KIND_TEXT}
use common.ui.draw_ir.{
    draw_ir_batch,
    draw_ir_composition,
    draw_ir_embedding_config,
    draw_ir_glyph_run_payload,
    draw_ir_text,
    draw_ir_text_shaped_font
}

fn _showcase_v2() -> DrawIrComposition:
    val st = showcase_build_sized("glyphspec", 4, 3)
    widget_tree_to_draw_ir_cpu(st.tree.root_node(), 400, 300)

fn _text_command_stats(comp: DrawIrComposition) -> (i64, i64):
    var total: i64 = 0
    var with_glyphs: i64 = 0
    for b in comp.batches:
        for c in b.commands:
            if c.kind == "text":
                total = total + 1
                if c.glyph_run.valid and c.glyph_run.glyph_ids.len() > 0:
                    with_glyphs = with_glyphs + 1
    (total, with_glyphs)

fn _lit_pixels(pixels: [u32]) -> i64:
    var lit: i64 = 0
    var i: i64 = 0
    while i < pixels.len().to_i64():
        if pixels[i] != RASTER_BG:
            lit = lit + 1
        i = i + 1
    lit

fn _one_command_scene(command: DrawIrCommand) -> DrawIrV3Scene:
    val embedding = draw_ir_embedding_config("s", "c", 0, 0, 64, 32, 0, 1000, false)
    val batch = draw_ir_batch("b", "cpu", embedding, [command])
    draw_ir_v2_to_v3(draw_ir_composition("comp", "key", "cpu", [batch]))

describe "widget Draw-IR text runs carry glyphs":

    it "emits a glyph run for every plain-Latin text command (v2)":
        val (total, with_glyphs) = _text_command_stats(_showcase_v2())
        # Anti-vacuity: the tree must actually contain text, otherwise
        # "all text commands have glyphs" is trivially true of an empty set.
        expect(total > 0).to_equal(true)
        expect(with_glyphs).to_equal(total)

    it "carries those glyphs through to the v3 text-run table":
        val scene = draw_ir_v2_to_v3(_showcase_v2())
        var runs: i64 = 0
        var runs_with_glyphs: i64 = 0
        var total_glyphs: i64 = 0
        var i: i64 = 0
        while i < scene.commands.len().to_i64():
            val cmd = scene.commands[i]
            if cmd.kind == DRAW_IR_V3_KIND_TEXT:
                runs = runs + 1
                val run = draw_ir_v3_text_run_at(scene.text_runs, cmd.text_run_id)
                if run.present and run.glyph_count > 0u32:
                    runs_with_glyphs = runs_with_glyphs + 1
                    total_glyphs = total_glyphs + run.glyph_count.to_i64()
            i = i + 1
        expect(runs > 0).to_equal(true)
        expect(runs_with_glyphs).to_equal(runs)
        expect(total_glyphs > 0).to_equal(true)
        # The shared glyph table must be populated, not merely counted.
        expect(scene.text_runs.glyph_ids.len().to_i64()).to_equal(total_glyphs)

    it "rasterizes a glyph-bearing run to real pixels":
        val run = draw_ir_glyph_run_payload(
            [0u32, 1u32, 2u32], [2, 8, 14], [12, 12, 12], [0i64, 1i64, 2i64], true)
        val cmd = draw_ir_text_shaped_font(
            "t", 2, 5, "ABC", 0xFFFFFFFFu32, "sans", "id", [6, 6, 6], 18, 12, 12, run)
        expect(_lit_pixels(raster_scene_argb(_one_command_scene(cmd), 64, 32)) > 0).to_equal(true)

    it "rasterizes a zero-glyph run to a BLANK surface (the defect's signature)":
        # This is why a missing glyph run is fatal rather than degraded: the v3
        # text run has no string to fall back on, so the consumer draws nothing.
        val cmd = draw_ir_text("t", 2, 5, "ABC", 0xFFFFFFFFu32)
        expect(_lit_pixels(raster_scene_argb(_one_command_scene(cmd), 64, 32))).to_equal(0)
