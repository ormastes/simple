use common.io.window_event.{
    WINDOW_ACTION_PRESS,
    WINDOW_EVENT_KEY,
    WINDOW_EVENT_TEXT,
    WINDOW_MOD_CTRL,
    WINDOW_MOD_SHIFT,
    WINDOW_STATUS_EMPTY,
    WINDOW_STATUS_INVALID_HANDLE,
    WINDOW_STATUS_OK,
    WINDOW_STATUS_OVERFLOW,
    WindowEventLoop,
}

fn main() -> i64:
    var events = WindowEventLoop.create(2, 1)
    if events.enqueue_text(7, 1, 10, "Simple") != WINDOW_STATUS_OK:
        return 1
    if events.poll_scalar() != WINDOW_STATUS_OK:
        return 2
    if (events.polled_kind != WINDOW_EVENT_TEXT or
        events.polled_window_handle != 7):
        return 3
    val first_text_handle = events.polled_text_handle
    if events.text_value(first_text_handle) != "Simple":
        return 4
    if events.release_text(first_text_handle) != WINDOW_STATUS_OK:
        return 5
    if events.release_text(first_text_handle) != WINDOW_STATUS_INVALID_HANDLE:
        return 6
    if events.poll_scalar() != WINDOW_STATUS_EMPTY:
        return 7
    if events.enqueue_text(7, 2, 20, "A") != WINDOW_STATUS_OK:
        return 8
    if events.enqueue_text(7, 3, 30, "B") != WINDOW_STATUS_OVERFLOW:
        return 9
    if events.poll_scalar() != WINDOW_STATUS_OK:
        return 10
    events.release_text(events.polled_text_handle)
    if events.dropped_event_count != 1:
        return 11
    if events.enqueue_scalar(
        WINDOW_EVENT_KEY, 7, 4, 40, 65, 30,
        WINDOW_ACTION_PRESS, WINDOW_MOD_CTRL | WINDOW_MOD_SHIFT,
        1000, 2000, 0, 0, 80, 60
    ) != WINDOW_STATUS_OK:
        return 12
    if events.poll_scalar() != WINDOW_STATUS_OK:
        return 13
    if (events.polled_kind != WINDOW_EVENT_KEY or
        events.polled_key != 65 or events.polled_scancode != 30 or
        events.polled_modifiers != (WINDOW_MOD_CTRL | WINDOW_MOD_SHIFT) or
        events.polled_x_milli != 1000 or events.polled_height != 60):
        return 14
    0
