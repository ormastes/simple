use std.spec
use std.env.platform.{get_temp_dir}
use std.io_runtime.{file_read}

describe "environment process runtime ownership":
    it "keeps rt_process_run owned by env types only":
        val platform = file_read("src/lib/nogc_sync_mut/env/platform.spl")
        val types = file_read("src/lib/nogc_sync_mut/env/types.spl")

        expect(platform).to_contain("use std.env.types.{rt_env_home, rt_hostname, rt_env_cwd, rt_process_run}")
        expect(platform.contains("extern fn rt_process_run")).to_equal(false)
        expect(types).to_contain("extern fn rt_process_run")
        expect(types).to_contain("export rt_env_get, rt_env_get_i64, rt_env_home, rt_env_set, rt_env_cwd, rt_env_remove, rt_hostname, rt_process_run, rt_env_vars")

    it "keeps temp paths concrete":
        val platform = file_read("src/lib/nogc_sync_mut/env/platform.spl")
        val mirrored = file_read("src/std/nogc_sync_mut/env/platform.spl")
        val parsing = file_read(
            "src/lib/nogc_sync_mut/test_runner/test_executor_parsing.spl"
        )
        val runner = file_read(
            "src/lib/nogc_sync_mut/test_runner/test_runner_execute.spl"
        )
        val temp_dir = get_temp_dir()

        expect(platform).to_contain("if tmp != \"\" and tmp != nil:")
        expect(mirrored).to_contain("if tmp != \"\" and tmp != nil:")
        expect(parsing).to_contain("fn _tp_get_temp_dir() -> text:")
        expect(parsing).to_contain("if tmpdir != \"\" and tmpdir != nil:")
        expect(parsing).to_contain("if temp != \"\" and temp != nil:")
        expect(runner).to_contain("_tp_get_temp_dir() + \"/spipe_wrapped_\"")
        expect(temp_dir == nil).to_equal(false)
        expect(temp_dir.starts_with("/") or temp_dir.contains(":")).to_equal(true)
