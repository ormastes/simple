# @cover src/lib/nogc_sync_mut/gpu/engine2d/simd_isa_provider.spl 60%
# @tag: unit, gpu, engine2d, simd_isa_provider, kernel_registry, dispatch
#
# Proves that `simd_span_batch_execute` (the real per-op production
# dispatcher, added in the same change that fixed the discarded
# `kernel_table_lookup` return value in `kernel_registry.span_batch_execute`)
# actually branches on the registered provider instead of always falling
# back to the scalar oracle.
#
# Observable signal: `SpanOpBatch.non_scalar_lookups`, incremented exactly
# when a slot resolves to a non-scalar provider. Sabotage test: with an
# unregistered (all-scalar) table the counter must stay 0; with
# KERNEL_PROVIDER_SIMD_ISA registered for the exact slot the op falls into,
# the counter must be incremented once per matching op — and the two paths
# must still agree bit-for-bit with the scalar oracle.

use std.spec
use common.gpu.engine2d.scalar_oracle.{oracle_src_over_const, oracle_hash_span}
use common.gpu.engine2d.kernel_registry.{
    kernel_table_new,
    kernel_table_register,
    kernel_table_seal,
    kernel_table_lookup,
    span_batch_new,
    span_batch_push,
    KERNEL_OP_SRC_OVER_CONST,
    KERNEL_PROVIDER_SCALAR,
    KERNEL_PROVIDER_SIMD_ISA,
    KERNEL_FORMAT_ARGB8888_STRAIGHT,
    KERNEL_ALIGN_UNKNOWN,
    KERNEL_SPAN_CONTIGUOUS,
    KERNEL_BUCKET_LARGE,
}
use std.nogc_sync_mut.gpu.engine2d.simd_isa_provider.{simd_span_batch_execute}

fn filled(n: i64, seed: i64) -> [u32]:
    var a: [u32] = [0; n.to_i32()]
    var i: i64 = 0
    while i < n:
        a[i.to_i32()] = ((seed + i * 7) & 0xFF) as u32 | 0x80000000
        i = i + 1
    a

describe "simd_span_batch_execute — real provider dispatch (not silently discarded)":
    it "does not touch the SIMD path when no provider is registered (fallback = scalar, counter stays 0)":
        val n: i64 = 4096
        var dst_scalar = filled(n, 11)
        var dst_dispatch = filled(n, 11)
        var unused_buf: [u32] = [0; n.to_i32()]
        val colour: i64 = 0x40203040

        oracle_src_over_const(dst_scalar, 0, n, colour)

        var table = kernel_table_new()
        var batch = span_batch_new(4)
        assert_true(span_batch_push(batch, KERNEL_OP_SRC_OVER_CONST, 0, 0, n, colour, 0))

        val executed = simd_span_batch_execute(batch, dst_dispatch, unused_buf, unused_buf, table,
                                               KERNEL_FORMAT_ARGB8888_STRAIGHT, KERNEL_ALIGN_UNKNOWN,
                                               KERNEL_SPAN_CONTIGUOUS)

        assert_true(executed == 1)
        assert_true(batch.non_scalar_lookups == 0)
        assert_true(oracle_hash_span(dst_scalar, 0, n) == oracle_hash_span(dst_dispatch, 0, n))

    it "dispatches to the SIMD provider when the exact slot is registered, and stays bit-exact":
        val n: i64 = 4096
        var dst_scalar = filled(n, 22)
        var dst_dispatch = filled(n, 22)
        var unused_buf: [u32] = [0; n.to_i32()]
        val colour: i64 = 0x40203040

        oracle_src_over_const(dst_scalar, 0, n, colour)

        var table = kernel_table_new()
        val ok = kernel_table_register(table, KERNEL_OP_SRC_OVER_CONST,
                                       KERNEL_FORMAT_ARGB8888_STRAIGHT,
                                       KERNEL_ALIGN_UNKNOWN,
                                       KERNEL_SPAN_CONTIGUOUS,
                                       KERNEL_BUCKET_LARGE,
                                       KERNEL_PROVIDER_SIMD_ISA, true, true)
        assert_true(ok)
        assert_true(kernel_table_lookup(table, KERNEL_OP_SRC_OVER_CONST,
                                        KERNEL_FORMAT_ARGB8888_STRAIGHT,
                                        KERNEL_ALIGN_UNKNOWN,
                                        KERNEL_SPAN_CONTIGUOUS,
                                        KERNEL_BUCKET_LARGE) == KERNEL_PROVIDER_SIMD_ISA)
        kernel_table_seal(table)

        var batch = span_batch_new(4)
        assert_true(span_batch_push(batch, KERNEL_OP_SRC_OVER_CONST, 0, 0, n, colour, 0))

        val executed = simd_span_batch_execute(batch, dst_dispatch, unused_buf, unused_buf, table,
                                               KERNEL_FORMAT_ARGB8888_STRAIGHT, KERNEL_ALIGN_UNKNOWN,
                                               KERNEL_SPAN_CONTIGUOUS)

        assert_true(executed == 1)
        # This is the proof the SIMD path was actually taken, not silently
        # ignored: the dispatcher's own counter, incremented only inside the
        # `use_simd` branch, went from 0 (previous test) to 1 here.
        assert_true(batch.non_scalar_lookups == 1)
        assert_true(oracle_hash_span(dst_scalar, 0, n) == oracle_hash_span(dst_dispatch, 0, n))

    it "sealing the table BEFORE registering forces the lookup to miss (sabotage: registration is rejected, dispatch falls back to scalar)":
        val n: i64 = 4096
        var dst_scalar = filled(n, 33)
        var dst_dispatch = filled(n, 33)
        var unused_buf: [u32] = [0; n.to_i32()]
        val colour: i64 = 0x40203040

        oracle_src_over_const(dst_scalar, 0, n, colour)

        var table = kernel_table_new()
        kernel_table_seal(table)  # sabotage: seal before any registration
        val ok = kernel_table_register(table, KERNEL_OP_SRC_OVER_CONST,
                                       KERNEL_FORMAT_ARGB8888_STRAIGHT,
                                       KERNEL_ALIGN_UNKNOWN,
                                       KERNEL_SPAN_CONTIGUOUS,
                                       KERNEL_BUCKET_LARGE,
                                       KERNEL_PROVIDER_SIMD_ISA, true, true)
        # Registration on a sealed table is rejected — the registry's own
        # documented contract, not a bug in this spec.
        assert_true(not ok)
        assert_true(kernel_table_lookup(table, KERNEL_OP_SRC_OVER_CONST,
                                        KERNEL_FORMAT_ARGB8888_STRAIGHT,
                                        KERNEL_ALIGN_UNKNOWN,
                                        KERNEL_SPAN_CONTIGUOUS,
                                        KERNEL_BUCKET_LARGE) == KERNEL_PROVIDER_SCALAR)

        var batch = span_batch_new(4)
        assert_true(span_batch_push(batch, KERNEL_OP_SRC_OVER_CONST, 0, 0, n, colour, 0))

        val executed = simd_span_batch_execute(batch, dst_dispatch, unused_buf, unused_buf, table,
                                               KERNEL_FORMAT_ARGB8888_STRAIGHT, KERNEL_ALIGN_UNKNOWN,
                                               KERNEL_SPAN_CONTIGUOUS)

        assert_true(executed == 1)
        assert_true(batch.non_scalar_lookups == 0)  # fell back to scalar, exactly as the sabotage predicts
        assert_true(oracle_hash_span(dst_scalar, 0, n) == oracle_hash_span(dst_dispatch, 0, n))
