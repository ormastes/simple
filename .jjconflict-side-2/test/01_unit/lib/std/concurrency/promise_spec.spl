"""
Promise<T> Specification Tests

Tests for the Promise type implementing async-by-default semantics.

NOTE: Simple language uses Result<T, E> for error handling, not exceptions.
Promise module has been updated to work without try-catch blocks.
"""

use std.spec.*

# Inline Promise implementation for testing
# (Using inline until module import works)

enum PromiseState:
    Pending
    Resolved(value)
    Rejected(error)

impl PromiseState:
    fn is_pending() -> bool:
        match self:
            case Pending: true
            case _: false

    fn is_resolved() -> bool:
        match self:
            case Resolved(_): true
            case _: false

    fn is_rejected() -> bool:
        match self:
            case Rejected(_): true
            case _: false

# Module-level registry backing Promise.new()'s mutable state while the
# executor runs. Promise<T> itself stays a plain value-type struct
# (state, callbacks) so the `Promise { state: ..., callbacks: [] }`
# literal construction used throughout this file keeps working
# unmodified. `static fn new` only needs a mutable cell for the
# duration of the executor call, then freezes the result into an
# immutable struct.
#
# Root cause of the "unknown static method new on class Promise"
# failure this fixes: the class genuinely never declared a `new`
# constructor (not the erased-receiver static-method-resolution
# landmine documented at driver_core_types.spl:150 -- this class is
# locally defined with a concrete, non-erased receiver type, and
# CancellationToken.new()/similar static constructors resolve fine
# under the same interpreter).
#
# resolve()/reject() below are nested named `fn`s that mutate this
# MODULE-level `var` by index -- not a captured local of the enclosing
# `new()` call -- which is the pattern this codebase's runtime
# actually supports (see src/lib/nogc_async_mut/async/cancellation.spl
# header comment: "Simple structs are value types -- storing children
# in the parent ... would mutate copies, not the caller's vars.
# Instead we use a module-level flat registry"). Mutating a captured
# *local* `var` from a nested closure is the documented limitation
# ("Nested closure capture - can READ outer vars, CANNOT MODIFY");
# module-level closures work fine, which is what this uses.
var _promise_new_state: [PromiseState] = []

# NOTE (interpreter defect, new shape, found while fixing this spec):
# `_promise_new_state = _promise_new_state.push(...)` (a module `var`
# reassignment) must NOT live in the same function body as a nested
# `fn` that also references `_promise_new_state` -- doing so desyncs
# the enclosing function's view of the array from the one the nested
# closure mutates (the outer function keeps reading a stale/pre-push
# snapshot after the closure runs, confirmed in an isolated 4-line
# repro outside this file: push-and-reassign in the SAME function as
# the nested closure loses the write; hoisting the push into a
# separate free function fixes it). This is the same family as
# `interpreter_module_array_stale_read_via_free_fn_helper_2026-07-29.md`
# but the opposite direction (there, indirection THROUGH a free
# function was the bug; here, indirection THROUGH a free function is
# the FIX and doing the push inline is the bug) -- see the new bug doc
# filed alongside this spec for the minimal repro.
fn _promise_new_push_pending() -> i64:
    val idx = _promise_new_state.len()
    _promise_new_state = _promise_new_state.push(PromiseState.Pending)
    idx

class Promise<T>:
    state: PromiseState
    callbacks: List

    static fn new(executor) -> Promise<T>:
        val idx = _promise_new_push_pending()

        fn resolve(v):
            if _promise_new_state[idx].is_pending():
                _promise_new_state[idx] = PromiseState.Resolved(v)

        fn reject(e):
            if _promise_new_state[idx].is_pending():
                _promise_new_state[idx] = PromiseState.Rejected(e)

        executor(resolve, reject)
        Promise { state: _promise_new_state[idx], callbacks: [] }

    fn is_pending() -> bool:
        val s = self.state
        s.is_pending()

    fn is_resolved() -> bool:
        val s = self.state
        s.is_resolved()

    fn is_rejected() -> bool:
        val s = self.state
        s.is_rejected()

# Helper functions for creating promises
fn make_resolved<T>(v: T) -> Promise<T>:
    return Promise {
        state: PromiseState.Resolved(v),
        callbacks: []
    }

fn make_rejected<T>(err) -> Promise<T>:
    return Promise {
        state: PromiseState.Rejected(err),
        callbacks: []
    }

describe "Promise<T> - Basic Operations":
    """
    Tests for core Promise operations including creation, resolution, and rejection.
    """

    it "creates a resolved promise":
        val p = make_resolved(42)
        expect p.is_resolved()
        expect not p.is_pending()

    it "creates a rejected promise":
        val p = make_rejected("error")
        expect p.is_rejected()
        expect not p.is_pending()

    it "creates a promise with executor that resolves":
        val p = Promise.new(\resolve, reject: resolve(100))
        expect p.is_resolved()

    it "creates a promise with executor that rejects":
        val p = Promise.new(\resolve, reject: reject("failed"))
        expect p.is_rejected()

    it "starts as pending before executor runs":
        # For immediate executors, promise resolves synchronously
        # This tests the initial state construction
        val p = Promise {
            state: PromiseState.Pending,
            callbacks: []
        }
        expect p.is_pending()

describe "Promise<T> - State Management":
    """
    Tests for Promise state transitions and immutability rules.
    """

    it "resolves only once":
        var resolve_count = 0
        val p = Promise.new(\resolve, reject:
            resolve(1)
            resolve(2)  # Should be ignored
        )
        expect p.is_resolved()
        # Verify first value was used (can't check exact value without await)

    it "rejects only once":
        var reject_count = 0
        val p = Promise.new(\resolve, reject:
            reject("first")
            reject("second")  # Should be ignored
        )
        expect p.is_rejected()

    it "cannot transition from resolved to rejected":
        val p = Promise.new(\resolve, reject:
            resolve(42)
            reject("error")  # Should be ignored
        )
        expect p.is_resolved()
        expect not p.is_rejected()

    it "cannot transition from rejected to resolved":
        val p = Promise.new(\resolve, reject:
            reject("error")
            resolve(42)  # Should be ignored
        )
        expect p.is_rejected()
        expect not p.is_resolved()

    it "preserves state after creation":
        val p1 = make_resolved(10)
        val p2 = make_rejected("err")

        # Check states are stable
        expect p1.is_resolved()
        expect p2.is_rejected()

describe "Promise<T> - Type Safety":
    """
    Tests for Promise type parameterization with different value types.
    """

    it "can hold integer values":
        val p = make_resolved(42)
        expect p.is_resolved()

    it "can hold string values":
        val p = make_resolved("hello")
        expect p.is_resolved()

    it "can hold errors as strings":
        val p = make_rejected("error message")
        expect p.is_rejected()

describe "Promise<T> - Edge Cases":
    """
    Tests for edge cases including nil values and empty callback lists.
    """

    it "handles nil resolution":
        val p = make_resolved(nil)
        expect p.is_resolved()

    it "handles nil rejection":
        val p = make_rejected(nil)
        expect p.is_rejected()

    it "handles empty callback list":
        val p = Promise {
            state: PromiseState.Resolved(42),
            callbacks: []
        }
        expect p.is_resolved()

describe "Promise<T> - Integration":
    """
    Tests for Promise integration with pattern matching and executor callbacks.
    """

    it "works with match expressions on state":
        val p = make_resolved(100)
        var matched = false

        match p.state:
            case PromiseState.Resolved(v):
                matched = true
            case _:
                matched = false

        expect matched

    it "works with match expressions for rejection":
        val p = make_rejected("error")
        var matched = false

        match p.state:
            case PromiseState.Rejected(e):
                matched = true
            case _:
                matched = false

        expect matched

    it "executor receives both callbacks":
        var resolve_called = false
        var reject_called = false

        val p1 = Promise.new(\resolve, reject:
            resolve_called = true
            resolve(1)
        )

        val p2 = Promise.new(\resolve, reject:
            reject_called = true
            reject("err")
        )

        expect resolve_called
        expect reject_called
