"""
# Retained Web Renderer Animation Clock Contract

Prevents the retained compose path from regressing to an undeclared
`animation_time_ms` global and checks every adjacent forwarding path.
"""

extern fn rt_file_read_text(path: text) -> text?

describe "retained web renderer animation clock contract":
    it "declares the compose parameter and retained preparation field":
        val source = rt_file_read_text("src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer.spl") ?? ""
        expect(source).to_contain("animation_schedule: _SimpleWebAnimationSchedule,\n    animation_time_ms: i64,\n    animation_property_work_count: i64,")
        expect(source).to_contain("animation_schedule: _SimpleWebAnimationSchedule\n    animation_time_ms: i64\n    animation_property_work_count: i64")

    it "forwards the clock through direct, prepared, and rerender compose calls":
        val source = rt_file_read_text("src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer.spl") ?? ""
        expect(source).to_contain("animation_registry, animation_schedule, animation_time_ms,\n        animation_property_work_count")
        expect(source).to_contain("animation_schedule: animation_schedule,\n        animation_time_ms: animation_time_ms,")
        expect(source).to_contain("prepared.animation_registry, prepared.animation_schedule,\n        prepared.animation_time_ms,")
        expect(source).to_contain("raw_boxes, prior.animation_registry, animation_schedule,\n        animation_time_ms,")
