# @cover src/lib/common/gpu/engine2d/kernel_registry.spl 90%
# @tag: unit, gpu, engine2d, kernel_registry, decision_coverage
#
# Decision-coverage closure for C2 (`src/lib/nogc_sync_mut/gpu/engine2d/`,
# measured transitively through `src/lib/common/gpu/engine2d/`) per
# doc/09_report/ui/testing/render2d_c2_c3_coverage_measured_2026-08-07.md.
# That report rolled up exactly the 4 specs under
# test/01_unit/lib/nogc_sync_mut/gpu/engine2d/ (simd_isa_provider,
# simd_native_rows, simd_provider, simd_span_batch_execute) and found 31/68
# decision rows covered (45.6%), with 11 of the 37 uncovered real rows in
# `kernel_registry.spl` and 6 more in `scalar_oracle.spl` (both common-tier,
# pulled in transitively) plus 1 in `simd_kernels.spl`.
#
# NOTE: `kernel_size_bucket`'s boundary cases and `kernel_slot_key`'s
# out-of-range rejections already have a dedicated, more thorough spec at
# test/01_unit/lib/common/gpu/engine2d/kernel_registry_spec.spl — but that
# spec was NOT part of the artifact set the report rolled up (it lives
# outside test/01_unit/lib/nogc_sync_mut/gpu/engine2d/), so its coverage
# does not appear in the 31/68 baseline. This spec re-exercises the same
# entry points so a rollup that includes it closes those specific rows;
# it additionally closes rows the sibling spec does not touch at all
# (`kernel_table_register`'s key<0 short-circuit, `kernel_table_lookup`'s
# key<0 short-circuit, `span_batch_push` overflow, and the `count <= 0`
# early-returns + `m > 0` mask-skip in `scalar_oracle.spl`, plus the
# `detect_simd_level` in-process cache hit in `simd_kernels.spl`).
#
# Left undone (documented, not forced): `simd_isa_provider.spl` carries 12
# more uncovered rows in this rollup — mostly CPU-feature-gated branches
# (avx2/sse/neon probes) whose false arm requires a host without the
# feature, which this box does not have. `simd_kernels.spl` line 130
# (`if engine2d_simd_has_avx2():` — false arm) is the same class of
# environment-gated row: on a host with AVX2 the condition is always true,
# so the false arm cannot be forced from within a spec without mocking the
# extern. Line 64 (`case Sse42: "sse42"` inside `feature_text()`'s match) is
# a match-arm decision, not an independent branch pair, and forcing the
# "other case" side is not a meaningful additional test given `feature_text`
# is already exercised end-to-end elsewhere.

use std.spec
use common.gpu.engine2d.kernel_registry.{
    kernel_table_new,
    kernel_table_register,
    kernel_table_lookup,
    kernel_size_bucket,
    kernel_slot_key,
    span_batch_new,
    span_batch_push,
    KERNEL_OP_FILL_CONST,
    KERNEL_PROVIDER_SCALAR,
    KERNEL_FORMAT_ARGB8888_STRAIGHT,
    KERNEL_ALIGN_UNKNOWN,
    KERNEL_SPAN_CONTIGUOUS,
    KERNEL_BUCKET_TINY,
    KERNEL_BUCKET_SMALL,
    KERNEL_BUCKET_MEDIUM,
    KERNEL_OP_CAPACITY,
    KERNEL_FORMAT_CAPACITY,
    KERNEL_ALIGN_CAPACITY,
    KERNEL_CONTIGUITY_CAPACITY,
    KERNEL_BUCKET_CAPACITY,
}
use common.gpu.engine2d.scalar_oracle.{
    oracle_fill_const,
    oracle_src_over_const,
    oracle_src_over_image,
    oracle_mask_src_over,
    oracle_hash_span,
}
use std.nogc_sync_mut.gpu.engine2d.simd_kernels.{detect_simd_level}

val SIMD_PROVIDER_ID: i64 = 9

describe "kernel_size_bucket — true arm of each boundary if, not just the false fall-through":
    it "takes the count<16 true branch for a below-threshold count":
        assert_true(kernel_size_bucket(5) == KERNEL_BUCKET_TINY)

    it "takes the count<64 true branch once the count<16 check is false":
        assert_true(kernel_size_bucket(30) == KERNEL_BUCKET_SMALL)

    it "takes the count<256 true branch once both earlier checks are false":
        assert_true(kernel_size_bucket(100) == KERNEL_BUCKET_MEDIUM)

describe "kernel_slot_key — true arm of every out-of-range axis check, isolated one at a time":
    it "rejects an out-of-range op while every other axis is valid":
        val k = kernel_slot_key(0 - 1, KERNEL_FORMAT_ARGB8888_STRAIGHT, KERNEL_ALIGN_UNKNOWN,
                                KERNEL_SPAN_CONTIGUOUS, KERNEL_BUCKET_TINY)
        assert_true(k == 0 - 1)

    it "rejects an out-of-range format once op is valid":
        val k = kernel_slot_key(KERNEL_OP_FILL_CONST, KERNEL_FORMAT_CAPACITY, KERNEL_ALIGN_UNKNOWN,
                                KERNEL_SPAN_CONTIGUOUS, KERNEL_BUCKET_TINY)
        assert_true(k == 0 - 1)

    it "rejects an out-of-range alignment once op and format are valid":
        val k = kernel_slot_key(KERNEL_OP_FILL_CONST, KERNEL_FORMAT_ARGB8888_STRAIGHT, KERNEL_ALIGN_CAPACITY,
                                KERNEL_SPAN_CONTIGUOUS, KERNEL_BUCKET_TINY)
        assert_true(k == 0 - 1)

    it "rejects an out-of-range contiguity once op/format/alignment are valid":
        val k = kernel_slot_key(KERNEL_OP_FILL_CONST, KERNEL_FORMAT_ARGB8888_STRAIGHT, KERNEL_ALIGN_UNKNOWN,
                                KERNEL_CONTIGUITY_CAPACITY, KERNEL_BUCKET_TINY)
        assert_true(k == 0 - 1)

    it "rejects an out-of-range bucket once every earlier axis is valid":
        val k = kernel_slot_key(KERNEL_OP_FILL_CONST, KERNEL_FORMAT_ARGB8888_STRAIGHT, KERNEL_ALIGN_UNKNOWN,
                                KERNEL_SPAN_CONTIGUOUS, KERNEL_BUCKET_CAPACITY)
        assert_true(k == 0 - 1)

describe "kernel_table_register — key<0 short-circuit before the bit_exact/faster gate":
    it "rejects an out-of-range op before ever consulting bit_exact/faster":
        var t = kernel_table_new()
        val ok = kernel_table_register(t, KERNEL_OP_CAPACITY, KERNEL_FORMAT_ARGB8888_STRAIGHT,
                                       KERNEL_ALIGN_UNKNOWN, KERNEL_SPAN_CONTIGUOUS,
                                       KERNEL_BUCKET_TINY, SIMD_PROVIDER_ID, true, true)
        assert_true(not ok)
        assert_true(t.rejections == 1)

describe "kernel_table_lookup — key<0 short-circuit falls back to scalar without indexing slots":
    it "falls back to scalar for an out-of-range op on lookup":
        var t = kernel_table_new()
        val provider = kernel_table_lookup(t, KERNEL_OP_CAPACITY, KERNEL_FORMAT_ARGB8888_STRAIGHT,
                                           KERNEL_ALIGN_UNKNOWN, KERNEL_SPAN_CONTIGUOUS,
                                           KERNEL_BUCKET_TINY)
        assert_true(provider == KERNEL_PROVIDER_SCALAR)

describe "span_batch_push — true arm of the overflow refusal":
    it "refuses the push once length reaches capacity":
        var b = span_batch_new(1)
        val ok0 = span_batch_push(b, KERNEL_OP_FILL_CONST, 0, 0, 4, 0, 0)
        val ok1 = span_batch_push(b, KERNEL_OP_FILL_CONST, 4, 0, 4, 0, 0)
        assert_true(ok0)
        assert_false(ok1)
        assert_true(b.overflow_refusals == 1)

describe "scalar_oracle kernels — true arm of every count<=0 early return":
    it "oracle_fill_const returns immediately for a zero count, leaving dst untouched":
        var dst: [u32] = [0xAAAAAAAA.to_u32(); 4]
        oracle_fill_const(dst, 0, 0, 0xFFFFFFFF)
        assert_true(dst[0] == 0xAAAAAAAA.to_u32())

    it "oracle_src_over_const returns immediately for a zero count":
        var dst: [u32] = [0x11111111.to_u32(); 4]
        oracle_src_over_const(dst, 0, 0, 0xFFFFFFFF)
        assert_true(dst[0] == 0x11111111.to_u32())

    it "oracle_src_over_image returns immediately for a zero count":
        var dst: [u32] = [0x22222222.to_u32(); 4]
        var src: [u32] = [0xFFFFFFFF.to_u32(); 4]
        oracle_src_over_image(dst, 0, src, 0, 0)
        assert_true(dst[0] == 0x22222222.to_u32())

    it "oracle_mask_src_over returns immediately for a zero count":
        var dst: [u32] = [0x33333333.to_u32(); 4]
        var mask: [u32] = [0xFF.to_u32(); 4]
        oracle_mask_src_over(dst, 0, 0xFFFFFFFF, mask, 0, 0)
        assert_true(dst[0] == 0x33333333.to_u32())

    it "oracle_hash_span returns the seed hash immediately for a zero count":
        var buf: [u32] = [0xDEADBEEF.to_u32(); 4]
        val h = oracle_hash_span(buf, 0, 0)
        assert_true(h == (0xCBF29CE484222325 & 0xFFFFFFFFFFFF))

describe "scalar_oracle oracle_mask_src_over — false arm of the per-pixel m>0 check":
    it "skips a zero-coverage mask pixel without touching dst at that index":
        var dst: [u32] = [0x44444444.to_u32(); 2]
        var mask: [u32] = [0.to_u32(), 0xFF.to_u32()]
        oracle_mask_src_over(dst, 0, 0xFFFFFFFF, mask, 0, 2)
        assert_true(dst[0] == 0x44444444.to_u32())
        assert_true(dst[1] != 0x44444444.to_u32())

describe "simd_kernels detect_simd_level — true arm of the in-process cache hit":
    it "returns the same level on a second call without re-probing":
        val first = detect_simd_level()
        val second = detect_simd_level()
        assert_true(first == second)
