# F1: the credential KDF must fill all 32 bytes of an AES-256 key.
#
# Guards finding F1 of
# doc/09_report/lib/crypto/credential_store_aes_cbc_adversarial_review_2026-08-08.md
#
# Before 2026-08-08 the KDF took bcrypt's customary 24 output bytes and
# ZERO-PADDED them to 32, so every AES-256 key ended in 8 known 0x00 bytes:
# 192 bits of real keyspace, not 256. credential_derive_key now expands those
# 24 bytes to the full 32 with HKDF-SHA256 (RFC 5869).
#
# ONE derivation only. A spec performing several derivations aborts the test
# child with rc=255 and no verdict under the interpreter -- see
# doc/08_tracking/bug/credential_kdf_multi_derivation_spec_aborts_runner_2026-08-08.md
# The bcrypt-free cases live in credential_key_file_format_spec.spl.
#
# RED evidence for this assertion: with the derivation reverted to the
# zero-padding form, this file reported
#   ✗ derives 32 bytes with a non-fixed tail
#   executed=1 passed=0 failed=1 dropped=0

use std.spec.*
use std.terminal.credential.store.{credential_derive_key}

describe "F1 credential key derivation fills all 32 bytes":

    it "derives 32 bytes with a non-fixed tail":
        var s: list[i64] = []
        var i = 0
        while i < 16:
            s.push(i)
            i = i + 1
        val k = credential_derive_key("pw", s, 4)
        expect(k.length()).to_equal(32)
        # The old KDF zero-padded bcrypt's 24 bytes to 32, so bytes 24..31 were
        # ALWAYS 0x00 for every passphrase. At least one must now be non-zero.
        var tail_all_zero = true
        var j = 24
        while j < 32:
            if k[j] != 0:
                tail_all_zero = false
            j = j + 1
        expect(tail_all_zero).to_equal(false)
