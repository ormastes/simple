use std.spec
use common.ui.builder.{build_tree, label, scroll, with_height}
use common.ui.event.{process_event}
use common.ui.widget.{UIEvent, UIState}

describe "scrollbar pointer capture":
    it "drags the visible thumb and releases capture":
        val tree = build_tree(scroll("list", 72, [
            with_height(label("r1", "one"), 24),
            with_height(label("r2", "two"), 24),
            with_height(label("r3", "three"), 24),
            with_height(label("r4", "four"), 24),
            with_height(label("r5", "five"), 24),
        ]))
        var state = UIState.new(tree)
        state = process_event(state, UIEvent.Resize(100, 72))
        state = process_event(
            state, UIEvent.MouseEvent(96.0, 10.0, "left", "down")
        )
        state = process_event(
            state, UIEvent.MouseEvent(96.0, 60.0, "", "move")
        )
        val list = tree.find_widget("list")
        expect(list.get_prop("scroll_offset").to_int() ?? 0).to_be_greater_than(0)
        state = process_event(
            state, UIEvent.MouseEvent(96.0, 60.0, "left", "up")
        )
        expect(list.get_prop("ui_scrollbar_dragging")).to_equal("false")
