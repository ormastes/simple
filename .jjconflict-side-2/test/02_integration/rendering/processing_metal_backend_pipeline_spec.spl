# @req REQ-004 REQ-005 REQ-006 REQ-007 REQ-011

use std.spec.{describe, it, expect}
use std.common.processing.processing_ir.{processing_ir_fill_u32}
use std.common.processing.backend_contract.{ProcessingBackendTarget}
use std.gc_async_mut.processing.backend_pipeline.{
    compile_processing_backend_artifact, validate_processing_backend_artifact,
    run_processing_backend_device_probe, check_processing_backend_oracle_parity
}

describe "shared ProcessingIR Metal backend pipeline":
    it "should generate and validate MSL but fail closed without a Metal device":
        val ir = processing_ir_fill_u32(64, 0xA1B2C3D4u32)
        val artifact = compile_processing_backend_artifact(ir, ProcessingBackendTarget.MetalMsl)
        val compilation = validate_processing_backend_artifact(ir, artifact)
        expect(artifact.valid).to_equal(true)
        expect(artifact.source).to_contain("processing_fill_u32")
        expect(compilation.artifact_valid).to_equal(true)
        expect(compilation.reason).to_equal("ok")
        val device = run_processing_backend_device_probe(ir, artifact)
        if device.device_origin:
            expect(device.submitted).to_equal(true)
            expect(device.device_identity).to_be_greater_than(0)
            expect(check_processing_backend_oracle_parity(ir, device)).to_equal(true)
        else:
            expect(device.submitted).to_equal(false)
            expect(device.device_identity).to_equal(0)
            expect(device.values.len()).to_equal(0)
            expect(check_processing_backend_oracle_parity(ir, device)).to_equal(false)
