use common.ui.widget_draw_ir.{widget_tree_to_draw_ir_cpu}
use common.ui.widget.{WidgetNode}
use common.ui.wm_full_stack_demo.{wm_full_stack_demo_tree}

fn _has_command(composition, component_id: text) -> bool:
    for batch in composition.batches:
        for command in batch.commands:
            if command.component_id == component_id:
                return true
    false

fn main() -> i64:
    val tree = wm_full_stack_demo_tree("Ready", "Play sound", "")
    val status = WidgetNode(id: "demo-status").set_prop(
        "label", "Native mutation"
    )
    if status.get_prop("label") != "Native mutation":
        print "WIDGET DRAW IR NATIVE PROBE: FAIL mutation"
        return 1
    val composition = widget_tree_to_draw_ir_cpu(
        tree.root_node(), 480, 480
    )
    val root_present = _has_command(composition, "demo-root")
    val button_present = _has_command(composition, "demo-button")
    val scrollbar_present = _has_command(
        composition, "demo-scroll-scrollbar-thumb"
    )
    val surface_2d_present = _has_command(composition, "demo-surface-2d-bg")
    val surface_web_present = _has_command(composition, "demo-surface-web-bg")
    if (composition.batches.len() == 2 and root_present and button_present and
        scrollbar_present and surface_2d_present and surface_web_present):
        print "WIDGET DRAW IR NATIVE PROBE: PASS"
        return 0
    print(
        "WIDGET DRAW IR NATIVE PROBE: FAIL batches={composition.batches.len()} " +
        "root={root_present} button={button_present} " +
        "scrollbar={scrollbar_present} surface2d={surface_2d_present} " +
        "surfaceweb={surface_web_present}"
    )
    1
