use test.fixtures.native_trait_optional_struct_return.provider.{
    TraitFixtureBackend,
    TraitInputBackend,
    TraitSecondBackend,
    trait_aggregate_result,
    trait_aggregate_option,
    trait_nested_return,
    trait_aggregate_by_value_score,
    trait_global_aggregate_score,
    trait_global_aggregate_update
}

class TraitFixtureCompositor:
    input: TraitInputBackend?

impl TraitFixtureCompositor:
    me dispatch_mouse() -> i64:
        val backend = self.input
        if backend == nil:
            return -1
        val event = backend.poll_mouse()
        if val mouse = event:
            return mouse.dx * 10 + mouse.dy
        0

fn make_compositor(second: bool) -> TraitFixtureCompositor:
    if second:
        TraitFixtureCompositor(input: TraitSecondBackend(padding: 99, has_event: true))
    else:
        TraitFixtureCompositor(input: TraitFixtureBackend(has_event: true))

fn main() -> i64:
    var first = make_compositor(false)
    print(first.dispatch_mouse())
    print(first.dispatch_mouse())
    var second = make_compositor(true)
    print(second.dispatch_mouse())
    print(second.dispatch_mouse())
    match trait_aggregate_result(true):
        Err(error):
            print("unexpected={error}")
        Ok(payload):
            print("aggregate={payload.nested.event.dx}/{payload.nested.event.dy}/{payload.nested.values[0]}/{payload.nested.values[1]}/{payload.label}")
            print("by-value={trait_aggregate_by_value_score(payload)}")
    match trait_aggregate_option(true):
        Some(payload):
            print("option={payload.nested.event.dx}/{payload.nested.event.dy}/{payload.nested.values[0]}/{payload.nested.values[1]}/{payload.label}")
        nil:
            print("option=missing")
    val nested = trait_nested_return()
    print("nested={nested.event.dx}/{nested.event.dy}/{nested.values[0]}/{nested.values[1]}")
    print("global-before={trait_global_aggregate_score()}")
    trait_global_aggregate_update()
    print("global-after={trait_global_aggregate_score()}")
    0
