"""Depth and sub-pattern-kind matrix for enum payload sub-patterns.

Companion to `nested_payload_subpattern_matrix.spl`, which pins the ONE-level
shapes. This file pins the residue that file recorded as still open:
nesting depth 3 and 4, literal sub-patterns in payload position, and a literal
inside a struct sub-pattern in payload position.

Run under BOTH engines and diff -- the tree-walk interpreter recurses correctly
and was always right here, so an interpreter-only run proves nothing:

    SIMPLE_EXECUTION_MODE=interpreter simple run <this file>
    SIMPLE_EXECUTION_MODE=jit         simple run <this file>

Both must print `BADCOUNT 0`. Before the fix the JIT printed BADCOUNT 7.

The nil sentinel is the integer 3, so a binder that silently reads nil is
indistinguishable from a correct 3. `d4_value3_ctrl` therefore asserts a case
whose CORRECT answer is 3 while `d4_p`/`d4_q` assert answers that are not 3 --
a silent-nil result cannot satisfy both.

The `arr_*` / `tup_*` / `payload_arr_*` / `payload_tup_*` rows cover ARRAY and
TUPLE destructuring, which emitted no bindings at all on the JIT (every binder
read the zeroed stack, so `case [a, b]: a + b` over `[1, 2]` answered 0).

`arr3` is the row that separates a real fix from the obvious non-fix. Adding a
length discriminator ALONE moves `[1, 2, 3]` off the `[a, b]` arm and onto the
`[a, b, c]` arm, but that arm still binds zeros, so it answers 100. Only real
destructuring binders answer 106. A run that reports `arr2` PASS and `arr3`
got=100 has a length test and no binders.
"""

struct Point:
    x: i64
    y: i64

enum L4:
    P(a: i64)
    Q(b: i64)

enum L3:
    X(inner: L4)
    Y(m: i64)

enum L2:
    S(inner: L3)
    T(q: i64)

enum L1:
    C(mid: L2, tag: i64)
    D(z: i64)

enum Lit:
    A(x: i64, y: i64)
    B(z: i64)

enum Named:
    Tag(s: text)
    Off

enum Holder:
    Wrap(p: Point)
    Bare(k: i64)

enum Seq:
    Items(xs: [i64])
    Pair(t: (i64, i64))
    Nothing

# Struct sub-patterns nested INSIDE an array/tuple element. `bind_subpattern`
# bound nothing for these -- the condition side tested them by positional field
# access and selected the arm, then `a`/`b` were read off the zeroed stack.
enum SeqP:
    Items(ps: [Point])
    Pair(t: (Point, i64))
    Nothing

# A `T?` whose payload is a TUPLE. A natively compiled `T?`-returning function
# produces the "raw migration form" (the bare payload), for which
# `rt_enum_payload` answers NIL -- so `Some((a, b))` bound the nil sentinel 3.
fn opt_pair() -> (i64, i64)?:
    return (5, 8)

fn opt_pair3() -> (i64, i64)?:
    return (3, 7)

fn opt_pair_nil() -> (i64, i64)?:
    return nil

# Depth 3: the arm must be selected by the INNERMOST variant, and the
# innermost binder must actually bind.
fn depth3(o: L1) -> i64:
    match o:
        case C(L2.S(L3.Y(m)), tag): m + tag + 700
        case C(L2.T(q), tag): q + tag + 900
        case _: -1

# Depth 4.
fn depth4(o: L1) -> i64:
    match o:
        case C(L2.S(L3.X(L4.P(a))), tag): a + tag
        case C(L2.S(L3.X(L4.Q(b))), tag): b + tag + 500
        case C(L2.S(L3.Y(m)), tag): m + tag + 700
        case C(L2.T(q), tag): q + tag + 900
        case _: -1

# Literal sub-pattern in a multi-slot payload.
fn lit_multi(o: Lit) -> i64:
    match o:
        case A(0, y): y
        case A(x, y): x + y + 100
        case _: -1

# Literal sub-pattern in a single-slot payload.
fn lit_single(o: Lit) -> i64:
    match o:
        case B(5): 55
        case B(z): z + 200
        case _: -1

# Text literal sub-pattern -- takes the rt_string_eq path, not the scalar one.
fn lit_text(o: Named) -> i64:
    match o:
        case Tag("hi"): 1
        case Tag(_): 2
        case _: -1

# Literal inside a STRUCT sub-pattern in payload position: refutable by
# positional field access, not by payload extraction.
fn struct_lit(o: Holder) -> i64:
    match o:
        case Wrap(Point(0, b)): b
        case Wrap(Point(a, b)): a + b + 100
        case _: -1

# Top-level ARRAY destructuring -- no enum anywhere. Needs BOTH a length
# discriminator (so `[1,2,3]` does not take the `[a,b]` arm) and real binders
# (so the `[a,b,c]` arm answers 106 and not 100).
fn arr_top(xs: [i64]) -> i64:
    match xs:
        case [a, b]: a + b
        case [a, b, c]: a + b + c + 100
        case _: -1

# Top-level TUPLE destructuring. A tuple's arity is fixed by its type, so this
# has no length test -- it is a pure binder check.
fn tup_top(t: (i64, i64)) -> i64:
    match t:
        case (a, b): a + b
        case _: -1

# Literal element inside a top-level array pattern: refutable per element.
fn arr_lit(xs: [i64]) -> i64:
    match xs:
        case [0, b]: b
        case [a, b]: a + b + 100
        case _: -1

# Trailing rest: `[a, ...]` is a MINIMUM-length test, not an exact one.
fn arr_rest(xs: [i64]) -> i64:
    match xs:
        case [a, ...]: a + 300
        case _: -1

# ARRAY sub-pattern inside an enum payload.
fn payload_arr(o: Seq) -> i64:
    match o:
        case Items([a, b]): a + b
        case Items([a, b, c]): a + b + c + 100
        case _: -1

# TUPLE sub-pattern inside an enum payload, with a literal element.
fn payload_tup(o: Seq) -> i64:
    match o:
        case Pair((0, b)): b
        case Pair((a, b)): a + b + 100
        case _: -1

# STRUCT sub-pattern inside an ARRAY element, in enum payload position.
fn payload_arr_struct(o: SeqP) -> i64:
    match o:
        case Items([Point(a, b)]): a * 10 + b
        case _: -1

# STRUCT sub-pattern inside a TUPLE element, in enum payload position.
fn payload_tup_struct(o: SeqP) -> i64:
    match o:
        case Pair((Point(a, b), k)): a * 100 + b * 10 + k
        case _: -1

# STRUCT sub-pattern inside a TOP-LEVEL array pattern (no enum anywhere).
fn top_arr_struct(ps: [Point]) -> i64:
    match ps:
        case [Point(a, b)]: a * 10 + b
        case _: -1

# Control for the no-double-emit claim: a TOP-LEVEL struct pattern is served by
# `build_pattern_binding_stmts` and must NOT also be bound by `bind_subpattern`.
fn top_struct(p: Point) -> i64:
    match p:
        case Point(a, b): a * 10 + b
        case _: -1

# TUPLE sub-pattern under `Some`, over the raw migration form.
fn some_tup_match(o: (i64, i64)?) -> i64:
    match o:
        case Some((a, b)): a * 100 + b
        case _: -1

fn some_tup_iflet(o: (i64, i64)?) -> i64:
    if val Some((a, b)) = o:
        return a * 100 + b
    -1

fn check(name: text, got: i64, want: i64) -> i64:
    if got == want:
        print("PASS {name} got={got}")
        return 0
    print("FAIL {name} got={got} want={want}")
    1

# Harness self-test: proves `check` CAN report a mismatch, so a green matrix is
# not vacuous. The single FAIL line it prints is expected.
fn sentinel() -> i64:
    print("-- sentinel: the next FAIL line is EXPECTED --")
    val detected = check("SENTINEL_expected_fail", 1, 999)
    if detected == 1:
        print("PASS sentinel_harness_live")
        return 0
    print("FAIL sentinel_harness_VACUOUS")
    1

fn main() -> i64:
    var bad = 0
    bad = bad + sentinel()

    bad = bad + check("d3_y", depth3(L1.C(mid: L2.S(inner: L3.Y(m: 7)), tag: 3)), 710)
    bad = bad + check("d3_t", depth3(L1.C(mid: L2.T(q: 7), tag: 3)), 910)
    bad = bad + check("d3_other", depth3(L1.D(z: 1)), -1)

    bad = bad + check("d4_p", depth4(L1.C(mid: L2.S(inner: L3.X(inner: L4.P(a: 7))), tag: 3)), 10)
    bad = bad + check("d4_q", depth4(L1.C(mid: L2.S(inner: L3.X(inner: L4.Q(b: 7))), tag: 3)), 510)
    bad = bad + check("d4_y", depth4(L1.C(mid: L2.S(inner: L3.Y(m: 7)), tag: 3)), 710)
    bad = bad + check("d4_value3_ctrl", depth4(L1.C(mid: L2.S(inner: L3.X(inner: L4.P(a: 0))), tag: 3)), 3)

    bad = bad + check("lit_multi_hit", lit_multi(Lit.A(x: 0, y: 7)), 7)
    bad = bad + check("lit_multi_miss", lit_multi(Lit.A(x: 9, y: 7)), 116)
    bad = bad + check("lit_single_hit", lit_single(Lit.B(z: 5)), 55)
    bad = bad + check("lit_single_miss", lit_single(Lit.B(z: 9)), 209)
    bad = bad + check("lit_text_hit", lit_text(Named.Tag(s: "hi")), 1)
    bad = bad + check("lit_text_miss", lit_text(Named.Tag(s: "bye")), 2)

    bad = bad + check("struct_lit_hit", struct_lit(Holder.Wrap(p: Point(x: 0, y: 4))), 4)
    bad = bad + check("struct_lit_miss", struct_lit(Holder.Wrap(p: Point(x: 3, y: 4))), 107)

    # Array/tuple destructuring. `arr2`'s correct answer is 3 -- the nil
    # sentinel -- so it doubles as a second value-3 control alongside
    # `d4_value3_ctrl`; `arr3` at 106 cannot be satisfied by a silent nil.
    bad = bad + check("arr2", arr_top([1, 2]), 3)
    bad = bad + check("arr3", arr_top([1, 2, 3]), 106)
    bad = bad + check("arr_too_short", arr_top([9]), -1)
    bad = bad + check("arr_too_long", arr_top([1, 2, 3, 4]), -1)
    bad = bad + check("tup2", tup_top((4, 5)), 9)
    bad = bad + check("arr_lit_hit", arr_lit([0, 7]), 7)
    bad = bad + check("arr_lit_miss", arr_lit([3, 4]), 107)
    bad = bad + check("arr_rest_one", arr_rest([5]), 305)
    bad = bad + check("arr_rest_many", arr_rest([5, 6, 7]), 305)
    bad = bad + check("arr_rest_empty", arr_rest([]), -1)

    bad = bad + check("payload_arr2", payload_arr(Seq.Items(xs: [1, 2])), 3)
    bad = bad + check("payload_arr3", payload_arr(Seq.Items(xs: [1, 2, 3])), 106)
    bad = bad + check("payload_tup_hit", payload_tup(Seq.Pair(t: (0, 7))), 7)
    bad = bad + check("payload_tup_miss", payload_tup(Seq.Pair(t: (3, 4))), 107)


    # Struct sub-pattern inside an array/tuple element (`bind_subpattern` had no
    # struct arm at all). `top_struct` is the no-double-emit control: it is
    # served by `build_pattern_binding_stmts` and never reaches
    # `bind_subpattern`, proved with SIMPLE_DEBUG_PATTERN_LOWER=1 (3 Enum hits
    # for the three nested rows, not 4).
    bad = bad + check("payload_arr_struct", payload_arr_struct(SeqP.Items(ps: [Point(x: 4, y: 7)])), 47)
    bad = bad + check("payload_tup_struct", payload_tup_struct(SeqP.Pair(t: (Point(x: 4, y: 7), 2))), 472)
    bad = bad + check("top_arr_struct", top_arr_struct([Point(x: 4, y: 7)]), 47)
    bad = bad + check("top_struct_ctrl", top_struct(Point(x: 4, y: 7)), 47)

    # `Some((a, b))` over the raw migration form. `some_tup_value3` is a THIRD
    # value-3 control: its correct answer is 307, and a binder that silently
    # read the nil sentinel answers 303 -- so nil cannot satisfy it.
    bad = bad + check("some_tup_match", some_tup_match(opt_pair()), 508)
    bad = bad + check("some_tup_iflet", some_tup_iflet(opt_pair()), 508)
    bad = bad + check("some_tup_value3", some_tup_match(opt_pair3()), 307)
    bad = bad + check("some_tup_nil", some_tup_match(opt_pair_nil()), -1)

    print("BADCOUNT {bad}")
    bad
