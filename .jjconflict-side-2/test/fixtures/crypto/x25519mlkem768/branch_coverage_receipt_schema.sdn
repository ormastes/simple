    (id: "metal_provider" path: "src/os/crypto/x25519_mlkem768/metal_ntt_provider.spl")
    (id: "vulkan_provider" path: "src/os/crypto/x25519_mlkem768/vulkan_ntt_provider.spl")
    (id: "execution_policy" path: "src/os/crypto/x25519_mlkem768/execution_policy.spl")
    (id: "hybrid" path: "src/os/crypto/x25519_mlkem768/hybrid.spl")
    (id: "hybrid_support" path: "src/os/crypto/x25519_mlkem768/hybrid_support.spl")
    (id: "gpu_operation_evidence" path: "src/os/crypto/x25519_mlkem768/gpu_operation_evidence.spl")
    (id: "simd_operation_evidence" path: "src/os/crypto/x25519_mlkem768/simd_operation_evidence.spl")
    (id: "gpu_build_admission" path: "src/os/crypto/x25519_mlkem768/gpu_build_admission.spl")
    (id: "gpu_measurement_qualification" path: "src/os/crypto/x25519_mlkem768/gpu_measurement_qualification.spl")
    (id: "gpu_lifecycle_snapshot" path: "src/os/crypto/x25519_mlkem768/gpu_lifecycle_snapshot.spl")
    (id: "gpu_dispatch" path: "src/app/test/x25519mlkem768_gpu_dispatch.spl")
    (id: "evidence_contract" path: "src/lib/common/crypto/x25519_mlkem768/evidence_contract.spl")
    (id: "matrix_receipt" path: "src/lib/common/crypto/x25519_mlkem768/matrix_receipt.spl")
    (id: "executed_row_composer" path: "src/lib/common/crypto/x25519_mlkem768/executed_row_composer.spl")
    (id: "cuda_session" path: "src/lib/gc_async_mut/crypto_accel/cuda_session.spl")
    (id: "metal_session" path: "src/lib/gc_async_mut/crypto_accel/metal_session.spl")
    (id: "vulkan_session" path: "src/lib/gc_async_mut/crypto_accel/vulkan_session.spl")
    (id: "simd_runtime" path: "src/runtime/runtime_simd_dispatch.c")
    (id: "browser_tls" path: "src/lib/gc_async_mut/gpu/browser_engine/net/tls.spl")
    (id: "browser_h1" path: "src/lib/gc_async_mut/gpu/browser_engine/net/h1_client.spl")
    (id: "server_config" path: "src/lib/nogc_async_mut/http_server/server.spl")
    (id: "server_worker" path: "src/lib/nogc_async_mut/http_server/worker.spl")
    (id: "mlkem_core" path: "src/os/crypto/ml_kem.spl")
    (id: "mlkem_kpke" path: "src/os/crypto/ml_kem_kpke.spl")
    (id: "mlkem_ntt" path: "src/os/crypto/ml_kem_ntt.spl")
  ]
  owner_scope_note: "The exact 30 owners are execution and integration owners. Common qualification, qualified-timing, and performance-attestation evidence consumers remain outside this inventory and require their own focused branch evidence."
  non_owner_evidence_support: [
    "src/lib/common/crypto/x25519_mlkem768/measurement_qualification.spl"
    "src/lib/common/crypto/x25519_mlkem768/qualified_timing.spl"
    "src/lib/common/crypto/x25519_mlkem768/performance_attestation.spl"
    "src/lib/nogc_sync_mut/platform_measurement_observer.spl"
  ]
  required_identity_digests: [
    "runner_sha256" "raw_coverage_sha256" "zero_count_inventory_sha256"
    "critical_branch_inventory_sha256"
    "source_manifest_sha256" "spec_manifest_sha256"
    "compiler_artifact_sha256" "compiler_provenance_sha256"
    "compiler_source_revision" "compiler_version_sha256"
    "critical_symbolic_sha256" "runtime_artifact_sha256"
    "<owner>_source_sha256"
  ]
  artifact_path_policy: (
    repository_relative_required: true
    absolute_paths_forbidden: true
    parent_traversal_forbidden: true
    resolved_path_must_remain_inside_repository: true
    missing_empty_and_symlink_escape_rejected: true
  )
  required_measurement_fields: [
    "measurement_status=measured"
    "measurement_kind=instrumented-decision-counters"
    "decision_counter_unit=condition-outcome"
    "coverage_runtime_format=simple-coverage-sdn-v1+decision-condition-extension-v1"
    "raw_counter_semantics=decision-id,condition-id,true-count,false-count"
    "instrumentation_active=true" "static_analysis=false"
    "fallback_used=false" "promotion_basis=measured-decision-coverage"
    "promotion_status=eligible" "status=pass"
    "critical_branch_gate=measured-condition-outcomes"
    "critical_branch_status=pass"
  ]
  owner_count_rules: [
    "0<decision_site_total<=condition_site_total"
    "branch_outcome_total=condition_site_total*2"
    "0<=branch_outcome_covered<=branch_outcome_total"
    "branch_outcome_covered+zero_outcome_count=branch_outcome_total"
    "each owner counter<=1000000000"
  ]
  aggregate_rules: [
    "decision_site_total=sum(owner decision sites)"
    "condition_site_total=sum(owner condition sites)"
    "branch_outcome_total=sum(owner outcome totals)"
    "branch_outcome_covered=sum(owner covered outcomes)"
    "zero_count_outcomes=sum(owner zero outcomes)"
    "branch_coverage_basis_points=floor(branch_outcome_covered*10000/branch_outcome_total)"
    "branch_coverage_basis_points>=9800"
    "0<critical_branch_outcome_total=critical_branch_outcome_covered"
    "critical_branch_missing_outcomes=0"
  ]
  critical_branch_inventory: (
    always_required: true
    header: "owner|source_path|line|decision_id|condition_id|outcome"
    rows_equal_critical_branch_outcome_total: true
    exact_row_count: 346
    minimum_rows_per_owner: 2
    true_false_pair_required_per_condition: true
    canonical_symbolic_path: "test/fixtures/crypto/x25519mlkem768/critical_branch_symbolic_v1.psv"
    canonical_symbolic_sha256: "7ed24e210eda5e03a4c3f740fa7b82148f208446d5135aef781a52cbe98a2b1f"
    duplicate_outcome_identity_forbidden: true
    empty_inventory_forbidden: true
  )
  zero_count_inventory: (
    always_required: true
    header: "owner|source_path|line|decision_id|condition_id|outcome"
    rows_equal_zero_count_outcomes: true
    per_owner_rows_equal_owner_zero_outcome_count: true
    duplicate_outcome_identity_forbidden: true
    condition_line_must_be_consistent: true
    owner_and_path_must_match_exact_owner_set: true
    positive_source_line_required: true
  )
)
