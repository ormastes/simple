(
  schema: "x25519mlkem768-branch-coverage-v2"
  feature: "x25519mlkem768"
  target_basis_points: 9800
  measurement_required: true
  static_or_unmeasured_promotion_forbidden: true
  exact_owner_set: [
    (id: "cache_identity" path: "src/os/crypto/x25519_mlkem768/cache_identity.spl")
    (id: "artifact_snapshot" path: "src/os/crypto/x25519_mlkem768/artifact_snapshot_admission.spl")
