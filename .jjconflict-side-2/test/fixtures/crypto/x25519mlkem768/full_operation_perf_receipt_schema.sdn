(
  schema: "x25519mlkem768-full-operation-perf-v3"
  historical_non_promotable_schemas: ["x25519mlkem768-full-operation-perf-v2"]
  scope: "full-hybrid-facade-only"
  forbidden_substitutes: ["ntt" "intt" "ml-kem-only" "kernel-only" "jit-only"]
  operations: ["keygen" "encaps" "decaps" "combine_batch1024" "exchange"]
  common_required: [
    "operation_scope"
    "implementation_version" "profile_version" "configuration_digest"
    "runner_sha256" "runner_version" "spec_sha256" "fixture_sha256"
    "contract_sha256" "hybrid_sha256" "mlkem_sha256"
    "backend" "requested_backend" "selection_mode" "selected_backend"
    "fallback_used" "fallback_reason"
    "verification_policy" "execution_environment" "mode"
    "device_identity" "sample_count" "warmup_count" "batch_sizes"
    "<backend>_cold_exchange_first_use_us" "max_rss_kb" "cache_policy"
    "cache_invalidation" "status"
    "candidate_minimum_batch" "candidate_batch_size"
    "measurement_qualification_schema" "measurement_qualification_sha256"
    "performance_attestation_schema" "public_attestation_schema"
    "public_attestation_path" "public_attestation_sha256" "attestation_status"
    "qualified_timing_sha256" "scalar_sample_set_sha256"
    "candidate_sample_set_sha256" "workload_configuration_sha256"
    "scalar_configuration_sha256" "candidate_configuration_sha256"
    "set_a_first_output_sha256" "set_a_second_output_sha256"
    "set_b_first_output_sha256" "set_b_second_output_sha256"
    "set_c_first_output_sha256" "set_c_second_output_sha256"
  ]
  operation_required_suffixes: ["p50_us" "p95_us" "p99_us" "ops_per_s"]
  minimum_sample_count: 30
  minimum_warmup_count: 2
  duplicate_keys_forbidden: true
  typed_identity: (
    measurement_qualification_schema: "x25519mlkem768-measurement-qualification-v6"
    performance_attestation_schema: "x25519mlkem768-performance-attestation-v7"
    public_attestation_schema: "x25519mlkem768-full-operation-public-attestation-v1"
    retained_regular_no_follow_required: true
    attestation_status: "pass"
    candidate_configuration_recomputed: true
    scalar_projection_recomputed: true
    canonical_public_set_outputs_required: true
    secret_derived_digests_forbidden: true
  )
  required_selection_mode: "require"
  scalar: (
    backend: "scalar-cpu"
    baseline_required: true
    maximum_p95_regression_percent: 5
    device_memory_bytes: 0
    cache_policy: "not-applicable-scalar"
    cache_invalidation: "not-applicable-scalar"
  )
  simd: (
    backends: ["avx2" "neon" "rvv"]
    required_fields: [
      "native_isa" "native_arch" "physical_device" "emulated"
      "scalar_same_run_exchange_p50_us" "scalar_same_run_exchange_p95_us"
      "scalar_same_run_exchange_p99_us" "scalar_same_run_fixture_sha256"
      "scalar_same_run_batch_sizes" "scalar_same_run_sample_count"
      "scalar_same_run_warmup_count" "full_operation_speedup_milli"
      "oracle_match"
    ]
    physical_native_required: true
    emulated_required: false
    native_arches: ["x86_64" "aarch64" "riscv64"]
    scalar_same_run_required: true
    scalar_same_run_field: "scalar_same_run_exchange_p95_us"
    scalar_same_run_identity: [
      "fixture_sha256" "batch_sizes" "sample_count" "warmup_count"
      "ordered_p50_p95_p99"
    ]
    oracle_match_required: true
    minimum_full_operation_speedup_milli: 1500
    cache_policy: "runtime-isa-dispatch-no-executor-cache"
    cache_invalidation: "profile,source,configuration,semantic-version"
    cache_invalidation_required: ["profile" "source" "configuration" "semantic-version"]
  )
  gpu: (
    backends: ["cuda" "vulkan" "metal"]
    required_fields: [
      "artifact_kind" "artifact_sha256" "physical_device" "emulated"
      "persistent_executor" "oracle_match" "device_allocation_bytes"
      "break_even_operation" "break_even_batch" "break_even_speedup_milli"
      "scalar_same_run_exchange_p50_us" "scalar_same_run_exchange_p95_us"
      "scalar_same_run_exchange_p99_us" "scalar_same_run_fixture_sha256"
      "scalar_same_run_batch_sizes" "scalar_same_run_sample_count"
      "scalar_same_run_warmup_count"
      "cache_counter_scope" "cache_shutdown_count"
      "cache_live_executor_count" "eviction_shutdown_verified"
    ]
    exact_artifact_kinds: ["exact-cubin" "exact-spirv" "exact-metallib"]
    physical_native_required: true
    emulated_required: false
    scalar_same_run_required: true
    scalar_same_run_field: "scalar_same_run_exchange_p95_us"
    scalar_same_run_identity: [
      "fixture_sha256" "batch_sizes" "sample_count" "warmup_count"
      "ordered_p50_p95_p99"
    ]
    oracle_match_required: true
    minimum_break_even_speedup_milli: 1250
    break_even_operation: "exchange"
    break_even_batch_must_match_batch_sizes: true
    persistent_executor_required: true
    cache_policy: "bounded-fifo-executor-owner-v1"
    cache_invalidation: "profile,source,artifact,device,configuration,semantic-version"
    cache_invalidation_required: [
      "profile" "source" "artifact" "device" "configuration" "semantic-version"
    ]
    cache_identity_required: ["cache_admission_digest" "cache_execution_digest"]
    cache_count_required: [
      "cache_capacity" "cache_hit_count" "cache_miss_count" "cache_eviction_count"
      "cache_shutdown_count" "cache_live_executor_count"
    ]
    cache_counter_scope: "measured-phases-only-after-warmup"
    cache_count_relations: [
      "hit=warm_hit_samples+operation_samples"
      "miss=cold_admission_samples+eviction_samples"
      "eviction=eviction_samples" "shutdown=eviction"
      "live_executor=capacity"
    ]
    eviction_shutdown_verified_required: true
    cache_phase_samples_required: [
      "cache_cold_admission_sample_count" "cache_warm_hit_sample_count"
      "cache_eviction_sample_count" "operation_sample_count"
    ]
    cache_phase_metrics: [
      "cache_cold_admission" "cache_warm_hit" "cache_eviction" "operation"
    ]
    cache_phase_metric_suffixes: ["p50_us" "p95_us" "p99_us"]
    minimum_cache_phase_sample_count: 30
    positive_numeric_device_identity_required: true
    required_memory: ["max_rss_kb" "device_allocation_bytes"]
    cuda: (
      artifact_kind: "exact-cubin"
      timing_splits: ["h2d" "launch" "sync" "d2h" "end_to_end"]
      timing_split_suffix: "p95_us"
    )
    vulkan: (
      artifact_kind: "exact-spirv"
      timing_splits: ["upload" "launch" "sync" "readback" "end_to_end"]
      timing_split_suffix: "p95_us"
    )
    metal: (
      artifact_kind: "exact-metallib"
      timing_splits: ["upload" "launch" "sync" "readback" "end_to_end"]
      timing_split_suffix: "p95_us"
    )
  )
)
