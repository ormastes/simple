# Golden vectors — frozen MutationIR / conflict order contract v1
#
# Language-neutral mirror of test/fixtures/structural/mutation_golden_v1.spl.
# Byte-for-byte identical to the Simple fixture; this copy exists so a Rust/C++
# bridge or an external validator can check its encoder without linking Simple.
#
# Normative layout: doc/05_design/platform/structural_compute/
#                   mutation_contract_v1.md
#
# All `bytes` values are lowercase unseparated hex of the COMPLETE framed record
# (8-byte envelope included), except the `*_BODY` entries, which are the UNFRAMED
# op bodies a MutationPlan embeds.

contract:
  mutation_schema_version: 1
  byte_order: little-endian
  envelope: magic_u32 | version_u16 | reserved_u16
  mutation_effect_len: 21
  mutation_origin_len: 9
  mutation_op_len: 105
  mutation_receipt_len: 104
  mutation_plan_header_len: 9
  mutation_kind_count: 26
  mutation_kind_max: 25
  mutation_phase_count: 4
  mutation_phase_max: 3
  mutation_producer_count: 6
  mutation_producer_max: 5
  conflict_policy_count: 5
  conflict_policy_max: 4
  entity_kind_set_bit_count: 13
  entity_kind_set_known: 0x1fff
  effect_flags_known: 0x0f
  absent_u32_sentinel: 0xffffffff

magic:
  MutationEffect: SMEF
  MutationOrigin: SMOR
  MutationOp: SMOP
  MutationPlan: SMPL
  MutationCommitReceipt: SMRC

mutation_kind_discriminants:
  AddTag: 0
  RemoveTag: 1
  ReplaceSourceRange: 2
  InsertSourceBefore: 3
  InsertSourceAfter: 4
  ReplaceSyntaxNode: 5
  InsertSyntaxChild: 6
  DeleteSyntaxNode: 7
  ReplaceHirNode: 8
  ReplaceMirInstruction: 9
  InsertMirBefore: 10
  InsertMirAfter: 11
  SplitBasicBlock: 12
  ReplaceLlvmInstruction: 13
  InsertDomChild: 14
  RemoveDomSubtree: 15
  MoveDomSubtree: 16
  SetDomAttribute: 17
  ReplaceDomText: 18
  InsertCssRule: 19
  ReplaceCssRule: 20
  DeleteCssRule: 21
  ReplaceDeclaration: 22
  ReplaceLinkDefinition: 23
  AddRelocation: 24
  ChangePlacementHint: 25

mutation_phase_discriminants:
  Remove: 0
  Replace: 1
  Insert: 2
  Restructure: 3

mutation_producer_discriminants:
  AopAdvice: 0
  OptimizerPass: 1
  CssCascade: 2
  LinkResolver: 3
  ClangAdapter: 4
  Plugin: 5

conflict_policy_discriminants:
  Reject: 0
  HighestPriorityWins: 1
  ComposeIfDisjoint: 2
  RequeryAfterEarlierMutation: 3
  DomainResolver: 4

entity_kind_set:
  Tag: 0x0001
  SourceText: 0x0002
  SyntaxNode: 0x0004
  HirNode: 0x0008
  MirInstruction: 0x0010
  BasicBlock: 0x0020
  LlvmInstruction: 0x0040
  DomNode: 0x0080
  CssRule: 0x0100
  Declaration: 0x0200
  LinkDefinition: 0x0400
  Relocation: 0x0800
  PlacementHint: 0x1000
  reserved: bits 13..31 MUST be zero

effect_flags:
  may_change_control_flow: 0x01
  may_change_types: 0x02
  may_change_abi: 0x04
  may_change_layout_geometry: 0x08
  reserved: bits 4..7 MUST be zero

mutation_effect_layout:
  reads: u32
  writes: u32
  creates: u32
  deletes: u32
  invalidates: u32
  flags: u8

mutation_origin_layout:
  producer: u8
  stable_name: u32
  source_order: u32

mutation_op_layout:
  kind: u8
  phase: u8
  reserved: u8
  target: EntityKey (32)
  expected_revision: ArtifactId (20)
  payload: u32
  precondition: u32
  origin: MutationOrigin (9)
  priority: i32
  stable_order: u64
  effect: MutationEffect (21)

mutation_plan_layout:
  policy: u8
  schema_version: u32
  op_count: u32
  ops: MutationOp * op_count

mutation_receipt_layout:
  input_snapshot: SnapshotId (28)
  output_snapshot: SnapshotId (28)
  plan_hash: Hash128 (16)
  matched_entities: u64
  applied_ops: u64
  skipped_ops: u64
  conflicts: u64

conflict_order_keys:
  1: target artifact/entity (EntityKey, wire-field order, unsigned)
  2: mutation phase (ascending)
  3: declared priority (DESCENDING - HighestPriorityWins)
  4: origin.stable_name (ascending)
  5: origin.source_order (ascending)
  6: stable_order (ascending, unsigned)

vectors:
  GOLDEN_EFFECT_NONE:
    len: 29
    bytes: 534d454601000000000000000000000000000000000000000000000000
  GOLDEN_EFFECT_MIR:
    len: 29
    bytes: 534d454601000000300000001000000000000000000000000300000001
  GOLDEN_EFFECT_MAX:
    len: 29
    bytes: 534d454601000000ff1f0000ff1f00000000000000000000ffffffff0f
  GOLDEN_ORIGIN_AOP:
    len: 17
    bytes: 534d4f5201000000004433221107000000
  GOLDEN_ORIGIN_PLUGIN_MAX:
    len: 17
    bytes: 534d4f52010000000500000000ffffffff
  GOLDEN_OP_ADD_TAG_BODY:
