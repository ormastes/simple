# OPEN DEFECT repro (NOT gated by the runner). See README.md.
# A `me`-receiver method `m3/3` called with 2 arguments SHOULD be rejected
# (TOR-FM-02). On the deployed binary it is silently ACCEPTED and the missing
# parameter reads as the nil sentinel 3, so this prints 3078 instead of the
# 9078 a correct 3-argument call yields. Exit 0, no diagnostic.
class Box:
    var base: i64 = 0
    fn m3(a: i64, b: i64, c: i64) -> i64:
        return self.base + c * 1000 + a * 10 + b

fn main():
    var bx = Box(base: 0)
    print(bx.m3(7, 8))
