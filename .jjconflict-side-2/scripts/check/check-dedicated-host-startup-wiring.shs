#!/bin/sh
# Structural admission gate for the dedicated-host pre-main ABI.
#
# This is intentionally not a live SimpleOS claim.  It verifies that the
# generated POSIX entry and both supported SimpleOS CRT variants offer the
# same weak hook *after argv publication and before constructors*.  A live
# QEMU/in-guest-Clang proof is tracked separately because it needs a booted
# guest and a manifest-aware generated artifact.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$root"

fail() {
    echo "error=dedicated_host_startup_wiring:$*" >&2
    exit 1
}

entry=src/compiler/70.backend/backend/llvm_native_link.spl
x64=src/os/libc/simpleos_crt0.S
arm64=src/os/libc/simpleos_crt0_aarch64.S

grep -Fq 'extern int __simple_startup_before_main(int argc, char** argv) __attribute__((weak));' "$entry" ||
    fail "generated_native_entry_hook_missing"
grep -Fq 'if (__simple_startup_before_main && __simple_startup_before_main(argc, argv) != 0) return 125;' "$entry" ||
    fail "generated_native_entry_call_missing"

for crt in "$x64" "$arm64"; do
    grep -Fq '.weak __simple_startup_before_main' "$crt" ||
        fail "weak_crt_hook_missing:$crt"
    hook_line=$(grep -n '__simple_startup_before_main' "$crt" | head -n 1 | cut -d: -f1)
    init_line=$(grep -n '__libc_init_array' "$crt" | head -n 1 | cut -d: -f1)
    args_line=$(grep -n 'rt_set_args' "$crt" | head -n 1 | cut -d: -f1)
    [ -n "$hook_line" ] && [ -n "$init_line" ] && [ -n "$args_line" ] ||
        fail "crt_hook_order_markers_missing:$crt"
    [ "$args_line" -lt "$hook_line" ] || fail "crt_hook_precedes_argv:$crt"
    [ "$hook_line" -lt "$init_line" ] || fail "crt_hook_follows_constructors:$crt"
done

echo 'dedicated_host_startup_wiring=structural-pass'
