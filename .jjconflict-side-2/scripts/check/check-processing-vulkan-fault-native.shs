#!/bin/sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$ROOT_DIR"

PROBE_BIN=${PROCESSING_VULKAN_FAULT_PROBE_BIN:-build/simpleos_gpu_host/vulkan_fault_native/processing_vulkan_fault_probe}
TIMEOUT_SECONDS=${PROCESSING_VULKAN_FAULT_TIMEOUT_SECONDS:-30}
case "$TIMEOUT_SECONDS" in ''|0|*[!0-9]*) exit 2 ;; esac

if [ ! -x "$PROBE_BIN" ]; then
    echo "processing_vulkan_fault_native_status=blocked"
    echo "processing_vulkan_fault_native_reason=probe-binary-missing"
    exit 1
fi

run_case() {
    phase=$1
    if [ "$phase" = none ]; then
        set +e
        output=$(timeout -k 5 "$TIMEOUT_SECONDS" env -u SIMPLE_GPU_TEST -u SIMPLE_GPU_FAULT_INJECT -u SIMPLE_GPU_FAULT_INJECT_SKIP_MATCHES "$PROBE_BIN" --phase=none 2>&1)
        code=$?
        set -e
        printf '%s\n' "$output"
        [ "$code" -eq 0 ] || return "$code"
        total=$(printf '%s\n' "$output" | grep -Ec '^VULKAN_FAULT_NATIVE ' || true)
        valid=$(printf '%s\n' "$output" | grep -Ec '^VULKAN_FAULT_NATIVE status=pass phase=none fault_active=false completed=true reason=ok values=64 values_exact=true hash_sanity=true handle=[1-9][0-9]* identity=[1-9][0-9]*$' || true)
        [ "$total" -eq 1 ] && [ "$valid" -eq 1 ]
        return
    fi
    set +e
    output=$(timeout -k 5 "$TIMEOUT_SECONDS" env -u SIMPLE_GPU_FAULT_INJECT_SKIP_MATCHES SIMPLE_GPU_TEST=1 SIMPLE_GPU_FAULT_INJECT="vulkan:$phase" "$PROBE_BIN" --phase="$phase" 2>&1)
    code=$?
    set -e
    printf '%s\n' "$output"
    [ "$code" -eq 0 ] || return "$code"
    expected_reason="vulkan-$phase-failed"
    [ "$phase" != unavailable ] || expected_reason=vulkan-unavailable
    [ "$phase" != mismatch ] || expected_reason=checksum-mismatch
    [ "$phase" != dispatch-ineligible ] || expected_reason=vulkan-dispatch-ineligible
    total=$(printf '%s\n' "$output" | grep -Ec '^VULKAN_FAULT_NATIVE ' || true)
    valid=$(printf '%s\n' "$output" | grep -Ec "^VULKAN_FAULT_NATIVE status=pass phase=$phase fault_active=true completed=false reason=$expected_reason values=0 values_exact=false hash_sanity=true handle=0 identity=0$" || true)
    [ "$total" -eq 1 ] && [ "$valid" -eq 1 ]
}

run_case none
for phase in unavailable init submit readback mismatch dispatch-ineligible; do
    run_case "$phase"
done

set +e
recovery_output=$(timeout -k 5 "$TIMEOUT_SECONDS" env \
    -u SIMPLE_GPU_FAULT_INJECT -u SIMPLE_GPU_FAULT_INJECT_SKIP_MATCHES \
    SIMPLE_GPU_TEST=1 \
    "$PROBE_BIN" --recover=submit 2>&1)
recovery_code=$?
set -e
printf '%s\n' "$recovery_output"
[ "$recovery_code" -eq 0 ]
recovery_total=$(printf '%s\n' "$recovery_output" | grep -Ec '^VULKAN_FAULT_RECOVERY ' || true)
recovery_valid=$(printf '%s\n' "$recovery_output" | grep -Ec '^VULKAN_FAULT_RECOVERY status=pass phase=submit before_exact=true before_handle=[1-9][0-9]* before_identity=[1-9][0-9]* fault_armed=true failed_reason=vulkan-submit-failed failed_handle=0 failed_identity=0 fault_cleared=true recovered=true recovered_exact=true recovered_handle=[1-9][0-9]* recovered_identity=[1-9][0-9]* identity_stable=true$' || true)
[ "$recovery_total" -eq 1 ] && [ "$recovery_valid" -eq 1 ]

echo "processing_vulkan_fault_native_status=pass"
