"""Host-specific providers for the shared SimpleOS GPU daemon wire runner."""

use std.common.processing.processing_ir.{ProcessingIr}
use std.gc_async_mut.gpu.engine2d.draw_ir_target.{DrawIrRenderTarget}

struct SimpleOsGpuHostProcessingResult:
    completed: bool
    reason: text
    values: [u32]
    backend_handle: i64
    device_identity: i64

fn simpleos_gpu_host_processing_result(completed: bool, reason: text, values: [u32], backend_handle: i64, device_identity: i64) -> SimpleOsGpuHostProcessingResult:
    SimpleOsGpuHostProcessingResult(
        completed: completed,
        reason: reason,
        values: values,
        backend_handle: backend_handle,
        device_identity: device_identity)

fn simpleos_gpu_host_processing_failure(reason: text) -> SimpleOsGpuHostProcessingResult:
    simpleos_gpu_host_processing_result(false, reason, [], 0, 0)

trait SimpleOsGpuHostPlatform:
    fn create_render_target(width: i32, height: i32, backend: text) -> Result<DrawIrRenderTarget, text>
    fn probe_render_backend(backend: text) -> Result<bool, text>
    fn render_device_identity(backend: text) -> i64
    fn processing_backend_mask(requested: i64, selector: text) -> i64
    fn execute_processing(ir: ProcessingIr, backend: text) -> SimpleOsGpuHostProcessingResult
    fn shutdown()

export SimpleOsGpuHostProcessingResult, SimpleOsGpuHostPlatform
export simpleos_gpu_host_processing_result, simpleos_gpu_host_processing_failure
