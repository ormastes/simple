"""Signed generic HTTP/webhook transport security boundary."""

use std.crypto.hmac.{hmac_sha256}
use std.common.crypto.constant_time.{constant_time_compare}
use app.llm_caret.messaging.port.contracts.{ChatTransportPort}
use app.llm_caret.messaging.domain.capability.{TransportCapabilities}
use app.llm_caret.messaging.domain.model.{RoomMessage}
use app.llm_caret.messaging.adapter.chat.capability_registry.{chat_adapter_descriptor}

struct SignedHttpEnvelope:
    accepted: bool
    endpoint: text
    timestamp_ms: i64
    event_id: text
    body: text
    signature: text
    error: text

struct WebhookVerification:
    accepted: bool
    duplicate: bool
    error: text

class GenericHttpTransport with ChatTransportPort:
    endpoint: text
    secret: text
    bindings: [text]
    accepted_event_ids: [text]
    max_clock_skew_ms: i64

    static fn new(endpoint: text, secret: text) -> GenericHttpTransport:
        GenericHttpTransport(endpoint: endpoint.trim(), secret: secret,
            bindings: [], accepted_event_ids: [], max_clock_skew_ms: 300000)

    fn capabilities() -> TransportCapabilities:
        chat_adapter_descriptor("generic_http").capabilities

    me connect(binding_id: text) -> text:
        if self.endpoint == "": return "endpoint_required"
        if self.secret.len() < 16: return "webhook_secret_too_short"
        if binding_id.trim() == "": return "binding_id_required"
        for existing in self.bindings:
            if existing == binding_id: return "connected:generic_http:" + binding_id
        self.bindings.push(binding_id)
        "connected:generic_http:" + binding_id

    fn connected(binding_id: text) -> bool:
        for existing in self.bindings:
            if existing == binding_id: return true
        false

    fn signing_input(timestamp_ms: i64, event_id: text, body: text) -> text:
        timestamp_ms.to_text() + "." + event_id + "." + body

    fn signature(timestamp_ms: i64, event_id: text, body: text) -> text:
        "v1=" + hmac_sha256(self.secret, self.signing_input(timestamp_ms, event_id, body))

    fn prepare_outbound(binding_id: text, event_id: text, body: text,
            timestamp_ms: i64) -> SignedHttpEnvelope:
        if not self.connected(binding_id):
            return SignedHttpEnvelope(accepted: false, endpoint: "", timestamp_ms: timestamp_ms,
                event_id: event_id, body: "", signature: "", error: "binding_not_connected")
        if event_id.trim() == "":
            return SignedHttpEnvelope(accepted: false, endpoint: "", timestamp_ms: timestamp_ms,
                event_id: event_id, body: "", signature: "", error: "event_id_required")
        SignedHttpEnvelope(accepted: true, endpoint: self.endpoint, timestamp_ms: timestamp_ms,
            event_id: event_id, body: body, signature: self.signature(timestamp_ms, event_id, body), error: "")

    me verify_inbound(binding_id: text, event_id: text, body: text, timestamp_ms: i64,
            provided_signature: text, now_ms: i64) -> WebhookVerification:
        if not self.connected(binding_id):
            return WebhookVerification(accepted: false, duplicate: false, error: "binding_not_connected")
        val age = if now_ms >= timestamp_ms: now_ms - timestamp_ms else: timestamp_ms - now_ms
        if age > self.max_clock_skew_ms:
            return WebhookVerification(accepted: false, duplicate: false, error: "webhook_timestamp_out_of_range")
        val expected = self.signature(timestamp_ms, event_id, body)
        if not constant_time_compare(expected, provided_signature):
            return WebhookVerification(accepted: false, duplicate: false, error: "webhook_signature_invalid")
        for seen in self.accepted_event_ids:
            if seen == binding_id + ":" + event_id:
                return WebhookVerification(accepted: true, duplicate: true, error: "")
        self.accepted_event_ids.push(binding_id + ":" + event_id)
        WebhookVerification(accepted: true, duplicate: false, error: "")

    me send(binding_id: text, message: RoomMessage, idempotency_key: text) -> text:
        if not self.connected(binding_id): return "binding_not_connected"
        if idempotency_key.len() < 8: return "stable_idempotency_key_required"
        "signed_http_outbox:" + message.message_id.value

    me mark_read(binding_id: text, external_message_id: text) -> text:
        if not self.connected(binding_id): return "binding_not_connected"
        "primitive_sidecar:mark_read:" + external_message_id

    me open_private(binding_id: text, identity_ids: [text]) -> text:
        if identity_ids.len() < 2: return "private_room_requires_two_identities"
        "primitive_sidecar:open_private:" + binding_id

export SignedHttpEnvelope, WebhookVerification, GenericHttpTransport
