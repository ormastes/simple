"""Schema-aligned stdio client primitives for the Codex App Server v2 API."""

use app.io.mod.{process_spawn_piped, process_write_stdin, process_read_stdout,
    process_is_piped_alive, process_close_piped}
use app.llm_caret.json_helpers.{escape_json_text}

struct CodexRpcWrite:
    accepted: bool
    request_id: i64
    error: text

fn _q(value: text) -> text:
    "\"" + escape_json_text(value) + "\""

fn codex_rpc_request(request_id: i64, method: text, params_json: text) -> text:
    "{\"jsonrpc\":\"2.0\",\"id\":" + request_id.to_text() +
        ",\"method\":" + _q(method) + ",\"params\":" + params_json + "}"

fn codex_rpc_notification(method: text, params_json: text) -> text:
    if params_json == "":
        return "{\"jsonrpc\":\"2.0\",\"method\":" + _q(method) + "}"
    "{\"jsonrpc\":\"2.0\",\"method\":" + _q(method) +
        ",\"params\":" + params_json + "}"

fn codex_initialize_params() -> text:
    "{\"clientInfo\":{\"name\":\"llm-caret-messaging\",\"title\":\"LLM Caret Messaging\",\"version\":\"0.1.0\"},\"capabilities\":{}}"

fn codex_thread_start_params(cwd: text) -> text:
    if cwd == "": return "{}"
    "{\"cwd\":" + _q(cwd) + "}"

fn codex_thread_resume_params(thread_id: text) -> text:
    "{\"threadId\":" + _q(thread_id) + "}"

fn codex_thread_inject_items_params(thread_id: text, context_text: text) -> text:
    "{\"threadId\":" + _q(thread_id) +
        ",\"items\":[{\"type\":\"message\",\"role\":\"user\",\"content\":[{\"type\":\"input_text\",\"text\":" +
        _q(context_text) + "}]}]}"

fn _codex_text_input(value: text) -> text:
    "[{\"type\":\"text\",\"text\":" + _q(value) + ",\"text_elements\":[]}]"

fn codex_turn_start_params(thread_id: text, message: text, client_message_id: text) -> text:
    "{\"threadId\":" + _q(thread_id) + ",\"input\":" + _codex_text_input(message) +
        ",\"clientUserMessageId\":" + _q(client_message_id) + "}"

fn codex_turn_steer_params(thread_id: text, expected_turn_id: text,
        message: text, client_message_id: text) -> text:
    "{\"threadId\":" + _q(thread_id) + ",\"expectedTurnId\":" +
        _q(expected_turn_id) + ",\"input\":" + _codex_text_input(message) +
        ",\"clientUserMessageId\":" + _q(client_message_id) + "}"

fn codex_turn_interrupt_params(thread_id: text, turn_id: text) -> text:
    "{\"threadId\":" + _q(thread_id) + ",\"turnId\":" + _q(turn_id) + "}"

class CodexAppServerProcess:
    pid: i64
    next_request_id: i64

impl CodexAppServerProcess:
    static fn start() -> CodexAppServerProcess:
        val pid = process_spawn_piped("codex", ["app-server", "--listen", "stdio://"])
        CodexAppServerProcess(pid: pid, next_request_id: 1)

    fn alive() -> bool:
        self.pid > 0 and process_is_piped_alive(self.pid)

    me send(method: text, params_json: text) -> CodexRpcWrite:
        if not self.alive():
            return CodexRpcWrite(accepted: false, request_id: 0, error: "app_server_not_running")
        val request_id = self.next_request_id
        self.next_request_id = self.next_request_id + 1
        val wire = codex_rpc_request(request_id, method, params_json) + "\n"
        if not process_write_stdin(self.pid, wire):
            return CodexRpcWrite(accepted: false, request_id: request_id, error: "app_server_write_failed")
        CodexRpcWrite(accepted: true, request_id: request_id, error: "")

    fn notify(method: text, params_json: text) -> bool:
        self.alive() and process_write_stdin(self.pid,
            codex_rpc_notification(method, params_json) + "\n")

    fn read_available() -> text:
        if not self.alive(): return ""
        process_read_stdout(self.pid)

    me close() -> bool:
        if self.pid <= 0: return true
        val closed = process_close_piped(self.pid)
        self.pid = 0
        closed

export CodexRpcWrite, CodexAppServerProcess
export codex_rpc_request, codex_rpc_notification, codex_initialize_params
export codex_thread_start_params, codex_thread_resume_params, codex_thread_inject_items_params
export codex_turn_start_params, codex_turn_steer_params, codex_turn_interrupt_params
