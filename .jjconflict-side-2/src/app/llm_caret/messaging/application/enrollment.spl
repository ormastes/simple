"""Local email enrollment with hashed, expiring, single-use capabilities."""

use std.crypto.sha256.{sha256_text}

struct EmailInvite:
    invite_id: text
    email: text
    token_hash: text
    expires_at: i64
    attempts: i64
    max_attempts: i64
    used: bool

struct LocalAccount:
    account_id: text
    identity_id: text
    email: text
    created_at: i64

struct EnrollmentMutation:
    accepted: bool
    error: text
    invite_id: text
    account_id: text
    identity_id: text
    delivery_token: text

fn enrollment_email(value: text) -> text: value.trim().to_lower()

fn enrollment_token(secret: text, invite_id: text, email: text, now: i64) -> text:
    sha256_text(secret + ":" + invite_id + ":" + enrollment_email(email) + ":" + now.to_text())

fn enrollment_hash(token: text) -> text: "sha256:" + sha256_text(token)

fn enrollment_constant_match(left: text, right: text) -> bool:
    var difference = left.len() - right.len()
    val cap = if left.len() < right.len(): left.len() else: right.len()
    var i = 0
    while i < cap:
        if left.substring(i, i + 1) != right.substring(i, i + 1): difference = difference + 1
        i = i + 1
    difference == 0

class EnrollmentService:
    invites: [EmailInvite]
    accounts: [LocalAccount]

    static fn empty() -> EnrollmentService: EnrollmentService(invites: [], accounts: [])

    static fn restore(invites: [EmailInvite], accounts: [LocalAccount]) -> EnrollmentService:
        EnrollmentService(invites: invites, accounts: accounts)

    me issue_invite(invite_id: text, email: text, secret: text, now: i64,
            ttl_ms: i64, max_attempts: i64) -> EnrollmentMutation:
        val normalized = enrollment_email(email)
        if invite_id.trim() == "" or not normalized.contains("@"):
            return EnrollmentMutation(accepted: false, error: "valid_email_required", invite_id: "",
                account_id: "", identity_id: "", delivery_token: "")
        if secret.len() < 16 or ttl_ms < 60000 or max_attempts < 1:
            return EnrollmentMutation(accepted: false, error: "unsafe_invite_policy", invite_id: "",
                account_id: "", identity_id: "", delivery_token: "")
        for account in self.accounts:
            if account.email == normalized:
                return EnrollmentMutation(accepted: false, error: "account_already_exists", invite_id: "",
                    account_id: account.account_id, identity_id: account.identity_id, delivery_token: "")
        val token = enrollment_token(secret, invite_id, normalized, now)
        self.invites.push(EmailInvite(invite_id: invite_id, email: normalized,
            token_hash: enrollment_hash(token), expires_at: now + ttl_ms, attempts: 0,
            max_attempts: max_attempts, used: false))
        EnrollmentMutation(accepted: true, error: "", invite_id: invite_id,
            account_id: "", identity_id: "", delivery_token: token)

    me accept_invite(invite_id: text, token: text, now: i64) -> EnrollmentMutation:
        var i = 0
        while i < self.invites.len():
            if self.invites[i].invite_id == invite_id:
                val invite = self.invites[i]
                if invite.used:
                    return EnrollmentMutation(accepted: false, error: "invite_already_used", invite_id: invite_id,
                        account_id: "", identity_id: "", delivery_token: "")
                if invite.expires_at <= now:
                    return EnrollmentMutation(accepted: false, error: "invite_expired", invite_id: invite_id,
                        account_id: "", identity_id: "", delivery_token: "")
                if invite.attempts >= invite.max_attempts:
                    return EnrollmentMutation(accepted: false, error: "invite_attempt_limit", invite_id: invite_id,
                        account_id: "", identity_id: "", delivery_token: "")
                val valid = enrollment_constant_match(invite.token_hash, enrollment_hash(token))
                self.invites[i] = EmailInvite(invite_id: invite.invite_id, email: invite.email,
                    token_hash: invite.token_hash, expires_at: invite.expires_at,
                    attempts: invite.attempts + 1, max_attempts: invite.max_attempts, used: valid)
                if not valid:
                    return EnrollmentMutation(accepted: false, error: "invite_token_invalid", invite_id: invite_id,
                        account_id: "", identity_id: "", delivery_token: "")
                val account_id = "account-" + invite_id
                val identity_id = "identity-" + invite_id
                self.accounts.push(LocalAccount(account_id: account_id, identity_id: identity_id,
                    email: invite.email, created_at: now))
                return EnrollmentMutation(accepted: true, error: "", invite_id: invite_id,
                    account_id: account_id, identity_id: identity_id, delivery_token: "")
            i = i + 1
        EnrollmentMutation(accepted: false, error: "invite_not_found", invite_id: invite_id,
            account_id: "", identity_id: "", delivery_token: "")

    me accept_token(token: text, now: i64) -> EnrollmentMutation:
        val token_hash = enrollment_hash(token)
        for invite in self.invites:
            if enrollment_constant_match(invite.token_hash, token_hash):
                return self.accept_invite(invite.invite_id, token, now)
        EnrollmentMutation(accepted: false, error: "invite_token_invalid", invite_id: "",
            account_id: "", identity_id: "", delivery_token: "")

export EmailInvite, LocalAccount, EnrollmentMutation, EnrollmentService
export enrollment_hash, enrollment_constant_match
