"""Does `var local = <module-level val struct>` copy, or alias?

The qualified-timing spec hoists per-backend qualifications to module-level
vals; one example takes `var q = <val>` and MUTATES q. If assignment aliased,
that mutation would poison every later example. Verdict line names the answer.
"""

use lib.common.crypto.x25519_mlkem768.evidence_contract.{
    X25519MlKem768EvidenceBackend}
use test.helpers.x25519mlkem768_performance_fixture.{
    x25519_mlkem768_synthetic_measurement_qualification}

val _SHARED = x25519_mlkem768_synthetic_measurement_qualification(
    X25519MlKem768EvidenceBackend.Avx2)

fn main():
    val original = _SHARED.qualification_sha256
    var mutated = _SHARED
    mutated.qualification_sha256 = "0" * 64
    val after = _SHARED.qualification_sha256
    print("PROBE original_len=" + original.len().to_text())
    print("PROBE mutated=" + mutated.qualification_sha256.substring(0, 8))
    print("PROBE shared_after=" + after.substring(0, 8))
    if after == original:
        print("PROBE VERDICT: PASS value-semantics (assignment COPIES)")
    else:
        print("PROBE VERDICT: FAIL alias-semantics (assignment ALIASES)")
