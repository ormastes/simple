# Response-Time Report (WP-18)
#
# doc/03_plan/language/assurance/aerospace_hardening_plan_2026-08-07.md, WP-18.
#
# Report-only, matching this session's WP-14 established default (report,
# never enforce): given a task's period/deadline (WP-17's TaskSlot fields --
# see async/scheduler.spl) and an observed_max_ticks measurement (see
# wcet_adapter.spl), this reports whether the task's OBSERVED behaviour fits
# within its deadline, with a margin. It changes nothing about scheduling and
# cancels/blocks nothing.
#
# Implicit-deadline assumption, stated explicitly rather than left implicit:
# this uses the task's release `period` (ticks) as the relative deadline
# within each period -- i.e. "the task must finish before its next release,"
# a standard simplification in response-time analysis when no separate
# relative deadline is tracked. TaskSlot's own `deadline` field (see
# scheduler.spl) is an ABSOLUTE tick value for one specific release and is
# not reused here, since the correct notion for a recurring per-period
# response-time check is the relative one.
#
# LOAD-BEARING CAVEAT: every report produced by this module states, in its
# own text, that it reflects OBSERVED timing (an ObservedMaxTracker sample
# set -- see wcet_adapter.spl file header) and NOT a proven WCET bound, and
# is therefore not sufficient evidence for a certification claim on its own.
# This is not decorative wording -- do not remove it when consuming this
# report's output.

use std.nogc_async_mut_noalloc.async.scheduler.{NoallocScheduler}

class ResponseTimeMargin:
    """Computed observed-vs-deadline comparison for one task.

    period_ticks: the task's release period, used here as the relative
                  deadline (see file header's implicit-deadline note). 0
                  means "not periodic" -- see meets_deadline_observed.
    observed_max_ticks: the input measurement (see ObservedMaxTracker).
    margin_ticks: period_ticks - observed_max_ticks. Positive means slack;
                  negative means the observed maximum already exceeds the
                  period. Meaningless (reported as 0) when period_ticks
                  is 0.
    meets_deadline_observed: true iff observed_max_ticks <= period_ticks
                              and period_ticks > 0. A task with no period
                              set (period_ticks == 0, aperiodic/best-effort
                              per TaskSlot's own docstring) has nothing to
                              check against and is reported false here --
                              callers should not read that as "fails," only
                              as "not applicable," and should branch on
                              period_ticks > 0 before treating this as a
                              flag.
    """
    task_id: i32
    period_ticks: i64
    observed_max_ticks: i64
    margin_ticks: i64
    meets_deadline_observed: bool

fn build_response_time_margin(sched: NoallocScheduler, task_id: i32, observed_max_ticks: i64) -> ResponseTimeMargin:
    """Build a ResponseTimeMargin for `task_id` from the scheduler's recorded
    period and the given observed_max_ticks measurement (see
    ObservedMaxTracker.observed_max_ticks() in wcet_adapter.spl)."""
    val period = sched.task_period(task_id)
    var margin: i64 = 0
    var meets = false
    if period > 0:
        margin = period - observed_max_ticks
        meets = observed_max_ticks <= period
    ResponseTimeMargin(
        task_id: task_id,
        period_ticks: period,
        observed_max_ticks: observed_max_ticks,
        margin_ticks: margin,
        meets_deadline_observed: meets
    )

fn format_response_time_report(r: ResponseTimeMargin) -> text:
    """Render a ResponseTimeMargin as a human-readable report, always
    including the load-bearing observed-vs-proven caveat (see file
    header) -- never strip this text when displaying or forwarding the
    report."""
    var verdict = "NOT APPLICABLE (no period set)"
    if r.period_ticks > 0:
        if r.meets_deadline_observed:
            verdict = "OK (observed margin " + r.margin_ticks.to_text() + " ticks)"
        else:
            verdict = "DEADLINE AT RISK (observed max exceeds period by " + (0 - r.margin_ticks).to_text() + " ticks)"
    "Response-time report (task " + r.task_id.to_text() + "):\n" +
    "  period_ticks: " + r.period_ticks.to_text() + "\n" +
    "  observed_max_ticks: " + r.observed_max_ticks.to_text() + "\n" +
    "  verdict: " + verdict + "\n" +
    "  CAVEAT: based on OBSERVED timing samples (an empirical maximum over " +
    "the runs actually executed), NOT a proven WCET bound. An unexecuted " +
    "path could exceed observed_max_ticks. This report alone is NOT " +
    "sufficient evidence for a certification claim."
