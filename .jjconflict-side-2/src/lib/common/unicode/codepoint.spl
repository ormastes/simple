# codepoint - Unicode codepoint classification and simple case mapping
#
# `std.common.encoding.unicode_text` imports these eight functions and calls
# them from fourteen sites. The module they were imported from did not exist,
# so every one of those calls failed at runtime with E1002.
#
# SCOPE, stated so callers are not misled. This is a RANGE TABLE, not a full
# UCD import -- the same approach `encoding/text_ops.spl:codepoint_script`
# already uses in this tier. Coverage is:
#
#   case mapping   Latin (ASCII, Latin-1, Latin Extended-A), Greek, Cyrillic
#   letters        the cased blocks above plus the major caseless scripts
#                  (Hebrew, Arabic, Devanagari, Bengali, Thai, Hiragana,
#                  Katakana, Hangul, CJK)
#   digits         Nd blocks in common use
#   whitespace     the full Unicode White_Space set below U+10000
#   combining      the main combining-mark blocks below U+10000
#
# Case mapping is SIMPLE (one codepoint in, one out). Characters with no
# simple uppercase -- U+00DF sharp s, U+0138, U+0149 -- are returned
# unchanged, which is what simple case mapping specifies; they are NOT
# silently mangled. A codepoint outside the covered blocks is likewise
# returned unchanged by the case functions, which is correct for every
# caseless character and is the honest answer for the rest.

# ============================================================================
# Whitespace
# ============================================================================

fn is_unicode_whitespace(cp: i64) -> bool:
    """True for Unicode White_Space codepoints below U+10000."""
    if cp >= 0x09 and cp <= 0x0D:
        return true
    if cp == 0x20 or cp == 0x85 or cp == 0xA0:
        return true
    if cp == 0x1680:
        return true
    if cp >= 0x2000 and cp <= 0x200A:
        return true
    if cp == 0x2028 or cp == 0x2029:
        return true
    if cp == 0x202F or cp == 0x205F or cp == 0x3000:
        return true
    false

# ============================================================================
# Digits (Unicode general category Nd)
# ============================================================================

fn is_unicode_digit(cp: i64) -> bool:
    """True for decimal digits (category Nd) in the covered blocks."""
    if cp >= 0x30 and cp <= 0x39:
        return true
    if cp >= 0x0660 and cp <= 0x0669:      # Arabic-Indic
        return true
    if cp >= 0x06F0 and cp <= 0x06F9:      # Extended Arabic-Indic
        return true
    if cp >= 0x07C0 and cp <= 0x07C9:      # NKo
        return true
    if cp >= 0x0966 and cp <= 0x096F:      # Devanagari
        return true
    if cp >= 0x09E6 and cp <= 0x09EF:      # Bengali
        return true
    if cp >= 0x0A66 and cp <= 0x0A6F:      # Gurmukhi
        return true
    if cp >= 0x0AE6 and cp <= 0x0AEF:      # Gujarati
        return true
    if cp >= 0x0B66 and cp <= 0x0B6F:      # Oriya
        return true
    if cp >= 0x0BE6 and cp <= 0x0BEF:      # Tamil
        return true
    if cp >= 0x0C66 and cp <= 0x0C6F:      # Telugu
        return true
    if cp >= 0x0CE6 and cp <= 0x0CEF:      # Kannada
        return true
    if cp >= 0x0D66 and cp <= 0x0D6F:      # Malayalam
        return true
    if cp >= 0x0E50 and cp <= 0x0E59:      # Thai
        return true
    if cp >= 0x0ED0 and cp <= 0x0ED9:      # Lao
        return true
    if cp >= 0x0F20 and cp <= 0x0F29:      # Tibetan
        return true
    if cp >= 0x1040 and cp <= 0x1049:      # Myanmar
        return true
    if cp >= 0x17E0 and cp <= 0x17E9:      # Khmer
        return true
    if cp >= 0x1810 and cp <= 0x1819:      # Mongolian
        return true
    if cp >= 0xFF10 and cp <= 0xFF19:      # Fullwidth
        return true
    false

# ============================================================================
# Combining marks
# ============================================================================

fn is_combining_mark(cp: i64) -> bool:
    """True for combining marks in the main below-BMP-boundary blocks.

    Used for grapheme clustering: a combining mark attaches to the preceding
    base character rather than starting a new cluster."""
    if cp >= 0x0300 and cp <= 0x036F:      # Combining Diacritical Marks
        return true
    if cp >= 0x0483 and cp <= 0x0489:      # Cyrillic
        return true
    if cp >= 0x0591 and cp <= 0x05BD:      # Hebrew
        return true
    if cp == 0x05BF or cp == 0x05C1 or cp == 0x05C2:
        return true
    if cp == 0x05C4 or cp == 0x05C5 or cp == 0x05C7:
        return true
    if cp >= 0x0610 and cp <= 0x061A:      # Arabic
        return true
    if cp >= 0x064B and cp <= 0x065F:
        return true
    if cp == 0x0670:
        return true
    if cp >= 0x06D6 and cp <= 0x06DC:
        return true
    if cp >= 0x06DF and cp <= 0x06E4:
        return true
    if cp >= 0x0730 and cp <= 0x074A:      # Syriac
        return true
    if cp >= 0x07A6 and cp <= 0x07B0:      # Thaana
        return true
    if cp >= 0x0900 and cp <= 0x0903:      # Devanagari
        return true
    if cp >= 0x093A and cp <= 0x094F:
        return true
    if cp >= 0x0951 and cp <= 0x0957:
        return true
    if cp >= 0x0981 and cp <= 0x0983:      # Bengali
        return true
    if cp >= 0x09BC and cp <= 0x09CD:
        return true
    if cp >= 0x0E31 and cp <= 0x0E3A:      # Thai
        return true
    if cp >= 0x0E47 and cp <= 0x0E4E:
        return true
    if cp >= 0x1AB0 and cp <= 0x1AFF:      # Combining Diacriticals Extended
        return true
    if cp >= 0x1DC0 and cp <= 0x1DFF:      # Combining Diacriticals Supplement
        return true
    if cp >= 0x20D0 and cp <= 0x20F0:      # Combining Marks for Symbols
        return true
    if cp >= 0xFE00 and cp <= 0xFE0F:      # Variation Selectors
        return true
    if cp >= 0xFE20 and cp <= 0xFE2F:      # Combining Half Marks
        return true
    false

# ============================================================================
# Case classification
# ============================================================================

fn is_unicode_upper(cp: i64) -> bool:
    """True for uppercase letters in the covered cased blocks."""
    # ASCII
    if cp >= 0x41 and cp <= 0x5A:
        return true
    # Latin-1 Supplement: 0xD7 is the multiplication sign, not a letter.
    if cp >= 0xC0 and cp <= 0xD6:
        return true
    if cp >= 0xD8 and cp <= 0xDE:
        return true
    # Latin Extended-A. The block alternates upper/lower, but the phase
    # flips twice; see _latin_ext_a_is_upper for the exact segmentation.
    if cp >= 0x100 and cp <= 0x17F:
        return _latin_ext_a_is_upper(cp)
    # Greek
    if cp == 0x386 or (cp >= 0x388 and cp <= 0x38A) or cp == 0x38C:
        return true
    if cp == 0x38E or cp == 0x38F:
        return true
    if cp >= 0x391 and cp <= 0x3A1:
        return true
    if cp >= 0x3A3 and cp <= 0x3AB:
        return true
    # Cyrillic
    if cp >= 0x400 and cp <= 0x42F:
        return true
    false

fn is_unicode_lower(cp: i64) -> bool:
    """True for lowercase letters in the covered cased blocks."""
    # ASCII
    if cp >= 0x61 and cp <= 0x7A:
        return true
    # Latin-1 Supplement: 0xF7 is the division sign, not a letter.
    if cp == 0xB5 or cp == 0xDF:           # micro sign, sharp s
        return true
    if cp >= 0xE0 and cp <= 0xF6:
        return true
    if cp >= 0xF8 and cp <= 0xFF:
        return true
    # Latin Extended-A
    if cp >= 0x100 and cp <= 0x17F:
        return not _latin_ext_a_is_upper(cp)
    # Greek
    if cp >= 0x3AC and cp <= 0x3C1:
        return true
    if cp >= 0x3C2 and cp <= 0x3CE:
        return true
    # Cyrillic
    if cp >= 0x430 and cp <= 0x45F:
        return true
    false

fn _latin_ext_a_is_upper(cp: i64) -> bool:
    """Uppercase test inside Latin Extended-A (U+0100..U+017F).

    The block is a run of upper/lower pairs, but the parity flips after
    U+0138 and again after U+0178, so a single even/odd test is wrong.

      0x100..0x137  even = upper   (A-macron, A-breve, ...)
      0x138         lower only     (kra, no uppercase)
      0x139..0x148  odd  = upper   (L-acute, L-cedilla, ...)
      0x149         lower only     (n preceded by apostrophe)
      0x14A..0x177  even = upper   (Eng, O-macron, ...)
      0x178         upper          (Y-diaeresis, lowercases to U+00FF)
      0x179..0x17E  odd  = upper   (Z-acute, Z-dot, Z-caron)
      0x17F         lower          (long s)
    """
    if cp == 0x138 or cp == 0x149 or cp == 0x17F:
        return false
    if cp == 0x178:
        return true
    if cp <= 0x137:
        return cp % 2 == 0
    if cp <= 0x148:
        return cp % 2 == 1
    if cp <= 0x177:
        return cp % 2 == 0
    cp % 2 == 1

# ============================================================================
# Letters
# ============================================================================

fn is_unicode_letter(cp: i64) -> bool:
    """True for letters in the covered scripts.

    Covers the cased blocks plus the major caseless scripts. A codepoint from
    a script not listed here reports false; the covered set is the one this
    tier's callers work in."""
    if is_unicode_upper(cp) or is_unicode_lower(cp):
        return true
    # Caseless or modifier letters inside otherwise-cased blocks
    if cp == 0xAA or cp == 0xBA:           # feminine/masculine ordinal
        return true
    if cp >= 0x2B0 and cp <= 0x2C1:        # modifier letters
        return true
    if cp >= 0x370 and cp <= 0x373:        # archaic Greek
        return true
    if cp >= 0x376 and cp <= 0x377:
        return true
    if cp >= 0x37B and cp <= 0x37D:
        return true
    if cp >= 0x460 and cp <= 0x52F:        # Cyrillic supplement
        return true
    if cp >= 0x531 and cp <= 0x556:        # Armenian
        return true
    if cp >= 0x561 and cp <= 0x587:
        return true
    if cp >= 0x5D0 and cp <= 0x5EA:        # Hebrew
        return true
    if cp >= 0x620 and cp <= 0x64A:        # Arabic
        return true
    if cp >= 0x671 and cp <= 0x6D3:
        return true
    if cp >= 0x710 and cp <= 0x72F:        # Syriac
        return true
    if cp >= 0x780 and cp <= 0x7A5:        # Thaana
        return true
    if cp >= 0x904 and cp <= 0x939:        # Devanagari
        return true
    if cp >= 0x985 and cp <= 0x9B9:        # Bengali
        return true
    if cp >= 0xE01 and cp <= 0xE30:        # Thai
        return true
    if cp >= 0xE32 and cp <= 0xE33:
        return true
    if cp >= 0x10A0 and cp <= 0x10FA:      # Georgian
        return true
    if cp >= 0x1E00 and cp <= 0x1EFF:      # Latin Extended Additional
        return true
    if cp >= 0x1F00 and cp <= 0x1FFF:      # Greek Extended
        return true
    if cp >= 0x3041 and cp <= 0x3096:      # Hiragana
        return true
    if cp >= 0x30A1 and cp <= 0x30FA:      # Katakana
        return true
    if cp >= 0x3400 and cp <= 0x4DBF:      # CJK Extension A
        return true
    if cp >= 0x4E00 and cp <= 0x9FFF:      # CJK Unified Ideographs
        return true
    if cp >= 0xA000 and cp <= 0xA48C:      # Yi
        return true
    if cp >= 0xAC00 and cp <= 0xD7A3:      # Hangul syllables
        return true
    if cp >= 0x1100 and cp <= 0x11FF:      # Hangul Jamo
        return true
    if cp >= 0xF900 and cp <= 0xFAFF:      # CJK compatibility ideographs
        return true
    false

# ============================================================================
# Simple case mapping
# ============================================================================

fn unicode_to_upper(cp: i64) -> i64:
    """Simple uppercase mapping. Returns cp unchanged when there is none."""
    # ASCII
    if cp >= 0x61 and cp <= 0x7A:
        return cp - 0x20
    # Latin-1: sharp s (0xDF) has no simple uppercase and stays put.
    if cp >= 0xE0 and cp <= 0xF6:
        return cp - 0x20
    if cp >= 0xF8 and cp <= 0xFE:
        return cp - 0x20
    if cp == 0xFF:
        return 0x178                        # y-diaeresis -> Y-diaeresis
    if cp == 0xB5:
        return 0x39C                        # micro sign -> Greek capital Mu
    # Latin Extended-A
    if cp >= 0x100 and cp <= 0x17F:
        if cp == 0x131:
            return 0x49                     # dotless i -> I
        if cp == 0x17F:
            return 0x53                     # long s -> S
        if cp == 0x138 or cp == 0x149:
            return cp                       # no simple uppercase
        if _latin_ext_a_is_upper(cp):
            return cp
        if cp <= 0x137:
            return cp - 1
        if cp <= 0x148:
            return cp - 1
        if cp <= 0x177:
            return cp - 1
        return cp - 1
    # Greek
    if cp == 0x3C2:
        return 0x3A3                        # final sigma -> capital sigma
    if cp >= 0x3B1 and cp <= 0x3C1:
        return cp - 0x20
    if cp >= 0x3C3 and cp <= 0x3CB:
        return cp - 0x20
    # Cyrillic
    if cp >= 0x430 and cp <= 0x44F:
        return cp - 0x20
    if cp >= 0x450 and cp <= 0x45F:
        return cp - 0x50
    cp

fn unicode_to_lower(cp: i64) -> i64:
    """Simple lowercase mapping. Returns cp unchanged when there is none."""
    # ASCII
    if cp >= 0x41 and cp <= 0x5A:
        return cp + 0x20
    # Latin-1
    if cp >= 0xC0 and cp <= 0xD6:
        return cp + 0x20
    if cp >= 0xD8 and cp <= 0xDE:
        return cp + 0x20
    # Latin Extended-A
    if cp >= 0x100 and cp <= 0x17F:
        if cp == 0x130:
            return 0x69                     # I-with-dot -> i
        if cp == 0x178:
            return 0xFF                     # Y-diaeresis -> y-diaeresis
        if not _latin_ext_a_is_upper(cp):
            return cp
        return cp + 1
    # Greek
    if cp >= 0x391 and cp <= 0x3A1:
        return cp + 0x20
    if cp >= 0x3A3 and cp <= 0x3AB:
        return cp + 0x20
    # Cyrillic
    if cp >= 0x400 and cp <= 0x40F:
        return cp + 0x50
    if cp >= 0x410 and cp <= 0x42F:
        return cp + 0x20
    cp
