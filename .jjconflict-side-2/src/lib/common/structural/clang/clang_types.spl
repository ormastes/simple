# ============================================================================
# common/structural/clang/clang_types.spl — FROZEN CLANG-AST contract v1
#
# Architecture: doc/04_architecture/compiler/mdsoc/
#   mdsoc_plus_tagged_structural_compute_architecture.md
#   §12 (Clang bridge architecture), §12.2 (Clang entity identity),
#   §12.3 (Clang AOP rewrite policy), §12.6 (version and compatibility policy),
#   §25 (source placement), §26 (contract freeze), §27 (lane ownership).
# Plan: doc/03_plan/platform/structural_compute/clang_bridge_plan.md phase 1
#   ("Pin + export"), mode C0 `cpu_reference`.
#
# Wave 1 CPU reference. Conventions are inherited unchanged from the ID-TAG
# lane (wave 0a) and restated normatively in
# doc/05_design/platform/structural_compute/identity_tagmap_contract_v1.md §2:
# all integers little-endian, fixed width, no padding, no alignment; every enum
# is a u8 discriminant; every top-level record carries the 8-byte wire
# envelope; an unknown enum discriminant or a set reserved bit is a HARD
# REJECT, never a silent default.
#
# SCOPE — what this file is and is not.
#
# §12.1 names five bridge components (simple-clang-export, -query, -transform,
# simple-llvm-pass, -profile) and §25 places them under `tools/clang-bridge/`.
# Those are Clang/LLVM C++ plugin surfaces (FrontendAction, PPCallbacks,
# ASTConsumer, PassBuilder) and cannot be expressed in Simple; they are not
# shipped by this lane and no C/C++ build step is added. What IS shippable in
# Simple, and what this file freezes, is the *contract* those components
# exchange: the durable identity of an exported Clang entity, the flat AST
# export record, and the adapter capability handshake. An independent C++
# encoder validates itself against test/fixtures/structural/clang_golden_v1.sdn
# exactly as identity_tagmap_contract_v1.md §6 prescribes.
#
# Phases 2 (QueryIR -> AST Matcher) and 3 (MutationIR -> Replacements) of the
# plan are NOT started here: QueryIR bytecode and MutationIR are §26 artifact
# groups 4 and 5, owned by the QUERY and MUTATE lanes, and neither is frozen at
# this revision (there is no src/lib/common/structural/query/ or /mutation/).
# Shared rule 1 forbids implementing against an unfrozen contract.
#
# FROZEN: enum discriminants and flag bits are wire values. A discriminant is
# never reused and never renumbered; new variants take the next free number.
# ============================================================================

use std.common.structural.identity.entity_id.{
    ArtifactId,
    SourceAnchor,
    artifact_id,
    artifact_id_equal,
    hash128,
    source_anchor,
    source_anchor_equal
}

val CLANG_SCHEMA_VERSION: i64 = 1

# ----------------------------------------------------------------------------
# Absent-id sentinel.
#
# §12.2 declares `semantic_usr: StringId?`. This contract does not put an
# Option on the wire: the ID-TAG conventions (§2.3) reject Option because its
# lowering differs across this repo's execution engines, and the frozen scalar
# width for StringId is u32. The absent value is therefore the all-ones u32,
# matching the absent-id convention already used by the DrawIR v3 / GPU-web
# capacity contracts. 0xffffffff is not a reachable StringId: the string arena
# would have to hold 2^32 entries for the last index to be legal.
#
# The same sentinel marks an absent parent (a root node) and an absent
# expansion context.
# ----------------------------------------------------------------------------

val CLANG_ABSENT_ID: i64 = 0xffffffff

# ----------------------------------------------------------------------------
# Supported Clang majors (§12.6).
#
# "Build and test one adapter per supported Clang major. Reject unknown majors
# rather than silently assuming ABI compatibility."
#
# The range mirrors the range this repo already builds and tests against in
# src/compiler/70.backend/backend/llvm_version.spl (LLVM_VERSION_MIN 16,
# LLVM_VERSION_MAX 19, LLVM_VERSION_PRIMARY 18). It is restated here rather
# than imported: src/lib/common must not depend on src/compiler, and that file
# belongs to a different lane. If the toolchain pin moves, both move, and the
# clang schema version bumps because the accepted-major set is wire-visible
# policy.
#
# The plan text says "One supported Clang major"; §12.6 (the normative parent)
# says one *adapter* per supported major, i.e. a set. §12.6 wins.
# ----------------------------------------------------------------------------

val CLANG_SUPPORTED_MAJOR_MIN: i64 = 16
val CLANG_SUPPORTED_MAJOR_MAX: i64 = 19
val CLANG_SUPPORTED_MAJOR_PRIMARY: i64 = 18

fn clang_major_supported(major: i64) -> bool:
    """True when a built-and-tested adapter exists for this Clang major."""
    major >= CLANG_SUPPORTED_MAJOR_MIN and major <= CLANG_SUPPORTED_MAJOR_MAX

# ----------------------------------------------------------------------------
# ClangFeatureSet — DERIVED, not defined by the architecture.
#
# §12.6 declares `supported_features: CapabilitySet` and never defines
# CapabilitySet. Rather than invent a vocabulary, this freezes the wire SLOT as
# a u32 bitset (the same choice the MAP lane made for MappingKindSet) and
# defines exactly one bit per component that §12.1 enumerates — no more. Each
# bit says "this adapter build ships that component".
#
# Bits 5..31 are RESERVED and MUST be zero. A set reserved bit is a hard
# reject: a reader that ignored it would silently believe an adapter lacks a
# capability it advertises, and would then pick a fallback path without a
# reason receipt, which shared rule 4 forbids.
#
# Raised back to the architecture owner for ratification — see the contract
# document's "Underspecified in §12" table.
# ----------------------------------------------------------------------------

val CLANG_FEATURE_SET_LEN: i64 = 4
val CLANG_FEATURE_NONE: i64 = 0
val CLANG_FEATURE_AST_EXPORT: i64 = 1
val CLANG_FEATURE_MATCHER_QUERY: i64 = 2
val CLANG_FEATURE_SOURCE_TRANSFORM: i64 = 4
val CLANG_FEATURE_LLVM_PASS: i64 = 8
val CLANG_FEATURE_PROFILE_REMARKS: i64 = 16
val CLANG_FEATURE_SET_ALL: i64 = 31

fn clang_feature_set_valid(raw: i64) -> bool:
    """True when no reserved bit is set."""
    raw >= 0 and (raw & CLANG_FEATURE_SET_ALL) == raw

fn clang_feature_set_contains(set: i64, feature: i64) -> bool:
    (set & feature) == feature and feature != 0

fn clang_feature_set_add(set: i64, feature: i64) -> i64:
    set | feature

# ----------------------------------------------------------------------------
# ClangNodeFlags — DERIVED, not enumerated by the architecture.
#
# §12.2's last two bullets and §12.3's last bullet force these into existence.
# Each bit cites the sentence that requires it:
#
#   bit 0  MACRO_EXPANSION  — §12.2 "macro entities preserve spelling and
#          expansion locations"; §12.3 "reject or require explicit policy for
#          rewrites inside macro definitions".
#   bit 1  IMPLICIT         — §12.2 "generated/implicit declarations are
#          tagged".
#   bit 2  SYSTEM_HEADER    — §12.3 "... system headers ...".
#   bit 3  GENERATED_FILE   — §12.3 "... generated files ...".
#   bit 4  TEMPLATE_INSTANTIATION — §12.3 "... templates with ambiguous
#          instantiations".
#   bit 5  SYNTHETIC_ORIGIN — §12.2 "and receive synthetic origins": an
#          implicit decl that is tagged but has no true source origin is a
#          different state from one whose origin was simply not recorded.
#
# Bits 6..31 are RESERVED and MUST be zero; a set reserved bit is a hard
# reject, for the same reason as a set reserved feature bit.
# ----------------------------------------------------------------------------

val CLANG_NODE_FLAG_NONE: i64 = 0
val CLANG_NODE_FLAG_MACRO_EXPANSION: i64 = 1
val CLANG_NODE_FLAG_IMPLICIT: i64 = 2
val CLANG_NODE_FLAG_SYSTEM_HEADER: i64 = 4
val CLANG_NODE_FLAG_GENERATED_FILE: i64 = 8
val CLANG_NODE_FLAG_TEMPLATE_INSTANTIATION: i64 = 16
val CLANG_NODE_FLAG_SYNTHETIC_ORIGIN: i64 = 32
val CLANG_NODE_FLAGS_ALL: i64 = 63

# The subset of flags that §12.3 says a rewrite may not cross without an
# explicit policy decision. SYNTHETIC_ORIGIN and IMPLICIT are deliberately NOT
# in this mask: an implicit decl is not a source range, so there is nothing to
# rewrite and nothing to decide.
# = MACRO_EXPANSION | SYSTEM_HEADER | GENERATED_FILE | TEMPLATE_INSTANTIATION
#     1              | 4             | 8              | 16
val CLANG_NODE_FLAGS_REWRITE_GUARDED: i64 = 29

fn clang_node_flags_valid(raw: i64) -> bool:
    """True when no reserved bit is set."""
    raw >= 0 and (raw & CLANG_NODE_FLAGS_ALL) == raw

fn clang_rewrite_policy_required(flags: i64) -> bool:
    """§12.3: a source-safe rewrite touching this node requires an explicit
    policy decision rather than proceeding. This is the CPU-reference oracle
    for the transform lane's admission check; it is pure and needs no
    MutationIR, so it is shippable while MutationIR is still unfrozen."""
    (flags & CLANG_NODE_FLAGS_REWRITE_GUARDED) != 0

# ----------------------------------------------------------------------------
# ClangEntityIdentity (§12.2) — frozen exactly as the architecture spells it,
# in declaration order.
#
#   tu_artifact   ArtifactId  20
#   ast_kind      u32          4
#   source        SourceAnchor 36
#   semantic_usr  u32          4   (CLANG_ABSENT_ID when the entity has no USR)
#   local_ordinal u32          4
#                             --
#                             68
#
# INTERPRETATION (architecture is silent): §12.2's prose says statements and
# expressions identify by "source anchor, kind, PARENT IDENTITY, and
# deterministic ordinal", but the struct it gives carries no parent field. The
# struct is frozen as given and the parent link lives in the export arena
# (ClangAstExport.parent) instead, because the parent relation is graph
# structure — §6 MappingGraph already owns edges — while ClangEntityIdentity is
# the durable key that travels alone. `clang_identity_of` reconstructs an
# identity from an arena node, so the parent is always recoverable from the
# artifact the identity names. Raised for ratification.
# ----------------------------------------------------------------------------

struct ClangEntityIdentity:
    tu_artifact: ArtifactId
    ast_kind: u32
    source: SourceAnchor
    semantic_usr: u32
    local_ordinal: u32

val CLANG_ENTITY_IDENTITY_LEN: i64 = 68

fn clang_entity_identity(tu_artifact: ArtifactId, ast_kind: u32,
                         source: SourceAnchor, semantic_usr: u32,
                         local_ordinal: u32) -> ClangEntityIdentity:
    ClangEntityIdentity(tu_artifact: tu_artifact, ast_kind: ast_kind,
                        source: source, semantic_usr: semantic_usr,
                        local_ordinal: local_ordinal)

fn clang_entity_identity_equal(a: ClangEntityIdentity,
                               b: ClangEntityIdentity) -> bool:
    artifact_id_equal(a.tu_artifact, b.tu_artifact)
        and a.ast_kind == b.ast_kind
        and source_anchor_equal(a.source, b.source)
        and a.semantic_usr == b.semantic_usr
        and a.local_ordinal == b.local_ordinal

fn clang_entity_identity_has_usr(id: ClangEntityIdentity) -> bool:
    """§12.2: declarations PREFER a USR/signature semantic key. A statement or
    expression has none and identifies positionally instead."""
    id.semantic_usr != CLANG_ABSENT_ID

fn clang_zero_source_anchor() -> SourceAnchor:
    source_anchor(clang_zero_artifact(), 0, 0, 0, 0)

fn clang_zero_artifact() -> ArtifactId:
    artifact_id(hash128(0, 0), 0)

fn clang_zero_identity() -> ClangEntityIdentity:
    clang_entity_identity(clang_zero_artifact(), 0, clang_zero_source_anchor(),
                          0, 0)

# ----------------------------------------------------------------------------
# ClangAdapterCapability (§12.6) — frozen exactly as the architecture spells
# it, in declaration order. CapabilitySet is the u32 feature bitset above.
#
#   clang_major                  u16  2
#   ast_export_schema            u16  2
#   matcher_adapter_version      u16  2
#   transformer_adapter_version  u16  2
#   llvm_ir_schema               u16  2
#   supported_features           u32  4
#                                    --
#                                    14
# ----------------------------------------------------------------------------

struct ClangAdapterCapability:
    clang_major: u32
    ast_export_schema: u32
    matcher_adapter_version: u32
    transformer_adapter_version: u32
    llvm_ir_schema: u32
    supported_features: u32

val CLANG_ADAPTER_CAPABILITY_LEN: i64 = 14

# Adapter surface versions this build implements. They version independently of
# CLANG_SCHEMA_VERSION, which versions the encoding: a reader can distinguish
# "I do not understand this format" from "I understand it but not this adapter
# revision". The matcher and transformer adapters are NOT implemented at this
# revision (their upstream contracts are unfrozen), so both advertise 0 —
# "absent", never "assume compatible".
val CLANG_AST_EXPORT_SCHEMA: i64 = 1
val CLANG_MATCHER_ADAPTER_VERSION: i64 = 0
val CLANG_TRANSFORMER_ADAPTER_VERSION: i64 = 0
val CLANG_LLVM_IR_SCHEMA: i64 = 0

fn clang_adapter_capability(clang_major: u32, ast_export_schema: u32,
                            matcher_adapter_version: u32,
                            transformer_adapter_version: u32,
                            llvm_ir_schema: u32,
                            supported_features: u32) -> ClangAdapterCapability:
    ClangAdapterCapability(
        clang_major: clang_major,
        ast_export_schema: ast_export_schema,
        matcher_adapter_version: matcher_adapter_version,
        transformer_adapter_version: transformer_adapter_version,
        llvm_ir_schema: llvm_ir_schema,
        supported_features: supported_features)

fn clang_adapter_capability_equal(a: ClangAdapterCapability,
                                  b: ClangAdapterCapability) -> bool:
    a.clang_major == b.clang_major
        and a.ast_export_schema == b.ast_export_schema
        and a.matcher_adapter_version == b.matcher_adapter_version
        and a.transformer_adapter_version == b.transformer_adapter_version
        and a.llvm_ir_schema == b.llvm_ir_schema
        and a.supported_features == b.supported_features

fn clang_zero_capability() -> ClangAdapterCapability:
    clang_adapter_capability(0, 0, 0, 0, 0, 0)

fn clang_this_build_capability() -> ClangAdapterCapability:
    """The capability this wave-1 CPU-reference build advertises. Only
    AST_EXPORT is shipped; the query/transform/pass components are C++ plugin
    surfaces and their upstream contracts are unfrozen."""
    clang_adapter_capability(CLANG_SUPPORTED_MAJOR_PRIMARY,
                             CLANG_AST_EXPORT_SCHEMA,
                             CLANG_MATCHER_ADAPTER_VERSION,
                             CLANG_TRANSFORMER_ADAPTER_VERSION,
                             CLANG_LLVM_IR_SCHEMA,
                             CLANG_FEATURE_AST_EXPORT)

# ----------------------------------------------------------------------------
# Capability decision + reason receipt.
#
# Shared rule 4 (README): "No silent fallback ... every fallback carries a
# reason receipt." Acceptance is therefore not a bare bool — a rejected adapter
# reports WHY, so a caller that drops to a different adapter or to plain Clang
# records a receipt rather than a shrug.
#
# Discriminants are wire values (they travel inside receipts): append-only,
# never renumbered.
# ----------------------------------------------------------------------------

enum ClangRejectReason:
    Accepted
    UnsupportedMajor
    AstExportSchemaMismatch
    MatcherAdapterMissing
    TransformerAdapterMissing
    LlvmIrSchemaMismatch
    MissingRequiredFeature
    UnknownFeatureBits

fn clang_reject_reason_to_u8(r: ClangRejectReason) -> i64:
    match r:
        case ClangRejectReason.Accepted: 0
        case ClangRejectReason.UnsupportedMajor: 1
        case ClangRejectReason.AstExportSchemaMismatch: 2
        case ClangRejectReason.MatcherAdapterMissing: 3
        case ClangRejectReason.TransformerAdapterMissing: 4
        case ClangRejectReason.LlvmIrSchemaMismatch: 5
        case ClangRejectReason.MissingRequiredFeature: 6
        case ClangRejectReason.UnknownFeatureBits: 7

val CLANG_REJECT_REASON_MAX: i64 = 7
val CLANG_REJECT_REASON_COUNT: i64 = 8

fn clang_reject_reason_valid(v: i64) -> bool:
    v >= 0 and v <= CLANG_REJECT_REASON_MAX

fn clang_reject_reason_from_u8(v: i64) -> ClangRejectReason:
    """Caller MUST gate on `clang_reject_reason_valid` first; this maps only
    known discriminants and pins anything else to Accepted so the function
    stays total (same rule as mapping_kind_from_u8)."""
    match v:
        case 1: ClangRejectReason.UnsupportedMajor
        case 2: ClangRejectReason.AstExportSchemaMismatch
        case 3: ClangRejectReason.MatcherAdapterMissing
        case 4: ClangRejectReason.TransformerAdapterMissing
        case 5: ClangRejectReason.LlvmIrSchemaMismatch
        case 6: ClangRejectReason.MissingRequiredFeature
        case 7: ClangRejectReason.UnknownFeatureBits
        case _: ClangRejectReason.Accepted

struct ClangCapabilityDecision:
    accepted: bool
    reason: ClangRejectReason

fn clang_capability_decision(accepted: bool,
                             reason: ClangRejectReason) -> ClangCapabilityDecision:
    ClangCapabilityDecision(accepted: accepted, reason: reason)

fn clang_capability_decide(cap: ClangAdapterCapability,
                           required_features: i64) -> ClangCapabilityDecision:
    """Decide whether an advertised adapter may be used, with a reason receipt.

    Order is deliberate and frozen: the major is checked first because an
    unknown major invalidates every other field's meaning (§12.6 rejects
    unknown majors rather than assuming ABI compatibility). Reserved feature
    bits are checked before required features so an adapter from the future is
    rejected as unknown rather than as merely lacking something."""
    if not clang_major_supported(cap.clang_major):
        return clang_capability_decision(false,
                                         ClangRejectReason.UnsupportedMajor)
    if not clang_feature_set_valid(cap.supported_features):
        return clang_capability_decision(false,
                                         ClangRejectReason.UnknownFeatureBits)
    if cap.ast_export_schema != CLANG_AST_EXPORT_SCHEMA:
        return clang_capability_decision(
            false, ClangRejectReason.AstExportSchemaMismatch)
    if not clang_feature_set_valid(required_features):
        return clang_capability_decision(false,
                                         ClangRejectReason.UnknownFeatureBits)
    if (cap.supported_features & required_features) != required_features:
        return clang_capability_decision(
            false, ClangRejectReason.MissingRequiredFeature)
    val need_matcher = clang_feature_set_contains(required_features, CLANG_FEATURE_MATCHER_QUERY)
    if need_matcher and cap.matcher_adapter_version == 0:
        return clang_capability_decision(
            false, ClangRejectReason.MatcherAdapterMissing)
    val need_transform = clang_feature_set_contains(required_features, CLANG_FEATURE_SOURCE_TRANSFORM)
    if need_transform and cap.transformer_adapter_version == 0:
        return clang_capability_decision(
            false, ClangRejectReason.TransformerAdapterMissing)
    val need_pass = clang_feature_set_contains(required_features, CLANG_FEATURE_LLVM_PASS)
    if need_pass and cap.llvm_ir_schema == 0:
        return clang_capability_decision(
            false, ClangRejectReason.LlvmIrSchemaMismatch)
    clang_capability_decision(true, ClangRejectReason.Accepted)

# ----------------------------------------------------------------------------
# ClangAstExport — the "canonical flat AST export" of §12.
#
# Structure-of-arrays, one column per attribute, following the §13.1 DomArena
# precedent and the frozen DrawIR v3 / GPU-web conventions: no text keys in the
# hot structure, no nested dynamic arrays, absent ids are 0xffffffff. Column
# order on the wire is column-major so a C1/C2 consumer can DMA one column
# without a gather.
#
#   tu_artifact           ArtifactId    identifies the translation unit
#   producer_clang_major  u32           §12.6: which Clang produced this
#   kind[i]               u32           Clang AST kind of node i
#   parent[i]             u32           parent node index, CLANG_ABSENT_ID at a
#                                       root; frozen invariant: parent[i] < i
#                                       (preorder), so a corrupted tree fails
#                                       loudly instead of silently reparenting
#   ordinal[i]            u32           §12.2 deterministic ordinal among
#                                       siblings
#   flags[i]              u32           ClangNodeFlags bitset
#   usr[i]                u32           StringId of the USR, CLANG_ABSENT_ID
#                                       when the node has none
#   anchor[i]             SourceAnchor  §12.2 spelling + expansion contexts
#
# An EMPTY export (node_count 0, all columns empty) is VALID and is the
# canonical result of exporting a translation unit with no nodes; it is not an
# error state.
#
# ADR-004: every accessor below returns a fresh value and never mutates through
# an index, so the value-semantics write-back hazard does not arise here.
# ----------------------------------------------------------------------------

struct ClangAstExport:
    tu_artifact: ArtifactId
    producer_clang_major: u32
    kind: [u32]
    parent: [u32]
    ordinal: [u32]
    flags: [u32]
    usr: [u32]
    anchor: [SourceAnchor]

# Per-node wire cost: kind + parent + ordinal + flags + usr + anchor.
val CLANG_AST_NODE_LEN: i64 = 56
# Fixed header after the envelope: producer_clang_major + tu_artifact + count.
val CLANG_AST_EXPORT_HEADER_LEN: i64 = 28

fn clang_ast_export(tu_artifact: ArtifactId, producer_clang_major: u32,
                    kind: [u32], parent: [u32], ordinal: [u32], flags: [u32],
                    usr: [u32], anchor: [SourceAnchor]) -> ClangAstExport:
    ClangAstExport(tu_artifact: tu_artifact,
                   producer_clang_major: producer_clang_major,
                   kind: kind, parent: parent, ordinal: ordinal, flags: flags,
                   usr: usr, anchor: anchor)

fn clang_empty_export(tu_artifact: ArtifactId,
                      producer_clang_major: u32) -> ClangAstExport:
    """The canonical empty export. Valid, not an error."""
    val k: [u32] = []
    val p: [u32] = []
    val o: [u32] = []
    val f: [u32] = []
    val u: [u32] = []
    val a: [SourceAnchor] = []
    clang_ast_export(tu_artifact, producer_clang_major, k, p, o, f, u, a)

fn clang_export_node_count(e: ClangAstExport) -> i64:
    e.kind.len()

fn clang_export_columns_aligned(e: ClangAstExport) -> bool:
    """Every column must be exactly node_count long. A short column is the SoA
    equivalent of a truncated record and reads a neighbouring node's data."""
    val n = e.kind.len()
    e.parent.len() == n and e.ordinal.len() == n and e.flags.len() == n
        and e.usr.len() == n and e.anchor.len() == n

fn clang_export_valid(e: ClangAstExport) -> bool:
    """Frozen well-formedness. Checked on encode AND on decode, because a
    producer that emits a malformed arena and a consumer that accepts one are
    two different failures and the freeze has to stop both."""
    if not clang_export_columns_aligned(e):
        return false
    if not clang_major_supported(e.producer_clang_major):
        return false
    val n = e.kind.len()
    var i = 0
    while i < n:
        if not clang_node_flags_valid(e.flags[i]):
            return false
        val p = e.parent[i]
        if p != CLANG_ABSENT_ID and p >= i:
            # Preorder: a parent is always emitted before its children. This
            # also rules out self-parenting and every cycle in one check.
            return false
        i = i + 1
    true

fn clang_export_is_root(e: ClangAstExport, index: i64) -> bool:
    e.parent[index] == CLANG_ABSENT_ID

fn clang_identity_of(e: ClangAstExport, index: i64) -> ClangEntityIdentity:
    """Reconstruct the durable §12.2 identity of arena node `index`.

    This is the boundary rule from plan phase 2: captures return a durable
    identity, never a Decl* / Stmt* and never a bare arena index, because arena
    indices are translation-unit-local exactly as raw Clang pointers are."""
    clang_entity_identity(e.tu_artifact, e.kind[index], e.anchor[index],
                          e.usr[index], e.ordinal[index])

fn clang_export_index_of(e: ClangAstExport,
                         id: ClangEntityIdentity) -> i64:
    """Canonical-index resolution: find the node an identity names, or -1.

    This is the CPU-reference oracle side of plan phase 2 ("canonical-index
    evaluation otherwise"). It is a linear scan on purpose — the C1 hybrid mode
    replaces it with a hashed pre-index and must agree with this result
    exactly. Returns -1 rather than an Option, per the ID-TAG convention."""
    if not artifact_id_equal(e.tu_artifact, id.tu_artifact):
        return -1
    val n = e.kind.len()
    var i = 0
    while i < n:
        if clang_entity_identity_equal(clang_identity_of(e, i), id):
            return i
        i = i + 1
    -1

fn clang_export_equal(a: ClangAstExport, b: ClangAstExport) -> bool:
    if not artifact_id_equal(a.tu_artifact, b.tu_artifact):
        return false
    if a.producer_clang_major != b.producer_clang_major:
        return false
    val n = a.kind.len()
    if b.kind.len() != n:
        return false
    if not clang_export_columns_aligned(a) or not clang_export_columns_aligned(b):
        return false
    var i = 0
    while i < n:
        if a.kind[i] != b.kind[i]:
            return false
        if a.parent[i] != b.parent[i]:
            return false
        if a.ordinal[i] != b.ordinal[i]:
            return false
        if a.flags[i] != b.flags[i]:
            return false
        if a.usr[i] != b.usr[i]:
            return false
        if not source_anchor_equal(a.anchor[i], b.anchor[i]):
            return false
        i = i + 1
    true
