# ============================================================================
# common/structural/mutation/mutation_plan.spl — FROZEN MutationIR records,
# invariants and the §8.4 deterministic conflict order
#
# Architecture §8.2 (MutationOp), §8.3 (effect summary), §8.4 (deterministic
# conflict resolution), §8.5 (receipt), §30.5 (verification obligations).
#
# Encoded sizes are fixed, so a downstream lane can size arenas without probing.
# ============================================================================

use std.common.structural.identity.entity_id.{
    ArtifactId,
    EntityKey,
    Hash128,
    SnapshotId,
    artifact_id_equal,
    entity_key_equal,
    hash128_equal,
    snapshot_id_equal,
    snapshot_supersedes
}
use std.common.structural.mutation.mutation_contracts.{
    ConflictPolicy,
    MutationKind,
    MutationPhase,
    MutationProducer,
    conflict_policy_equal,
    entity_kind_set_contains,
    entity_kind_set_valid,
    mutation_i32_valid,
    mutation_kind_equal,
    mutation_kind_phase,
    mutation_kind_target_kind,
    mutation_kind_to_u8,
    mutation_phase_equal,
    mutation_phase_to_u8,
    mutation_producer_equal,
    mutation_producer_to_u8,
    mutation_u32_valid,
    mutation_u64_lt
}

# ----------------------------------------------------------------------------
# Arena-index sentinels.
#
# §8.2 types `payload: MutationPayloadRef` and `precondition: QueryProgramRef?`,
# and neither ref type is defined anywhere in the document. The MUTATE lane does
# NOT invent two new handle types: the QUERY lane already established that a
# wire record addresses its side tables by u32 arena INDEX (QueryOp.operand /
# QueryOp.constant), because an in-memory {object_slot, generation} handle is
# explicitly "never a wire record" (structural/resolve/resolve_types.spl). So
# both fields are frozen as u32 indexes into arenas the plan's owner supplies,
# with 0xffffffff meaning absent — the same absent sentinel the QUERY lane
# froze. `precondition` is the `?` field of §8.2 and may be absent; `payload`
# may also be absent, because AddTag/RemoveTag carry their whole meaning in the
# kind and target.
# ----------------------------------------------------------------------------

val MUTATION_NO_PAYLOAD: i64 = 4294967295
val MUTATION_NO_PRECONDITION: i64 = 4294967295

# ----------------------------------------------------------------------------
# MutationEffect (§8.3 `EffectSummary`, renamed — see mutation_contracts.spl).
#
# 21 bytes: reads u32 | writes u32 | creates u32 | deletes u32
#           | invalidates u32 | flags u8
#
# `invalidates: DirtyMask` is the INVALIDATE lane's artifact (§26 lists
# "DirtyMask and dependency edge format" as a SEPARATE frozen group). This lane
# freezes only the SLOT — u32, little-endian — and deliberately does NOT
# validate its bits, because inventing a dirty-bit vocabulary here would
# pre-empt that lane. The existing `structural/invalidation/contracts.spl`
# DirtyMask is a layout-domain mask (DIRTY_LAYOUT / DIRTY_HIT_TEST) and is NOT
# the §8.3/§9 structural mask, so it is not imported.
#
# The four §8.3 booleans are packed into one flags byte rather than four bytes:
# a per-op record that is read by a GPU conflict sorter pays for every byte, and
# §8.3 lists them as a fixed set. Bits 4..7 are RESERVED and MUST be zero —
# hard reject, no invented flags.
# ----------------------------------------------------------------------------

val MUTATION_EFFECT_LEN: i64 = 21
val EFFECT_FLAG_CONTROL_FLOW: i64 = 1
val EFFECT_FLAG_TYPES: i64 = 2
val EFFECT_FLAG_ABI: i64 = 4
val EFFECT_FLAG_LAYOUT_GEOMETRY: i64 = 8
val EFFECT_FLAGS_KNOWN: i64 = 15

struct MutationEffect:
    """§8.3's effect summary: what conflict detection, pass scheduling, cache
    invalidation and verification selection all run on."""
    reads: u32
    writes: u32
    creates: u32
    deletes: u32
    invalidates: u32
    flags: u8

fn mutation_effect(reads: u32, writes: u32, creates: u32, deletes: u32,
                   invalidates: u32, flags: u8) -> MutationEffect:
    MutationEffect(reads: reads, writes: writes, creates: creates,
                   deletes: deletes, invalidates: invalidates, flags: flags)

fn mutation_effect_none() -> MutationEffect:
    mutation_effect(0, 0, 0, 0, 0, 0)

fn effect_flags_valid(raw: i64) -> bool:
    raw >= 0 and (raw & EFFECT_FLAGS_KNOWN) == raw

fn mutation_effect_well_formed(e: MutationEffect) -> bool:
    """Every kind set must name only known bits, and the flags byte must have no
    reserved bit set."""
    (entity_kind_set_valid(e.reads)
        and entity_kind_set_valid(e.writes)
        and entity_kind_set_valid(e.creates)
        and entity_kind_set_valid(e.deletes)
        and mutation_u32_valid(e.invalidates)
        and effect_flags_valid(e.flags))

fn mutation_effect_mutates(e: MutationEffect) -> i64:
    """The union of everything the op changes. §8.4's ComposeIfDisjoint tests
    this against another op's."""
    (e.writes | e.creates) | e.deletes

fn mutation_effect_flag(e: MutationEffect, flag: i64) -> bool:
    (e.flags & flag) != 0

fn mutation_effect_equal(a: MutationEffect, b: MutationEffect) -> bool:
    (a.reads == b.reads and a.writes == b.writes and a.creates == b.creates
        and a.deletes == b.deletes and a.invalidates == b.invalidates
        and a.flags == b.flags)

# ----------------------------------------------------------------------------
# MutationOrigin (§8.2 `origin`) — 9 bytes:
#   producer u8 | stable_name u32 | source_order u32
#
# `stable_name` is §8.4 ordering key 4 ("plugin/advice stable name") as an
# interned name id, and `source_order` is key 5. Both are carried in the origin
# rather than in the op because §8.4 attributes both to the PRODUCER, and two
# ops from one advice must not be able to disagree about their producer's name.
# ----------------------------------------------------------------------------

val MUTATION_ORIGIN_LEN: i64 = 9

struct MutationOrigin:
    """Who emitted the op, and where it sat in that producer's output."""
    producer: MutationProducer
    stable_name: u32
    source_order: u32

fn mutation_origin(producer: MutationProducer, stable_name: u32,
                   source_order: u32) -> MutationOrigin:
    MutationOrigin(producer: producer, stable_name: stable_name,
                   source_order: source_order)

fn mutation_origin_zero() -> MutationOrigin:
    mutation_origin(MutationProducer.AopAdvice, 0, 0)

fn mutation_origin_well_formed(o: MutationOrigin) -> bool:
    mutation_u32_valid(o.stable_name) and mutation_u32_valid(o.source_order)

fn mutation_origin_equal(a: MutationOrigin, b: MutationOrigin) -> bool:
    (mutation_producer_equal(a.producer, b.producer)
        and a.stable_name == b.stable_name
        and a.source_order == b.source_order)

# ----------------------------------------------------------------------------
# MutationOp (§8.2) — 105 bytes, no padding:
#
#   kind u8 | phase u8 | reserved u8
#   | target EntityKey (32) | expected_revision ArtifactId (20)
#   | payload u32 | precondition u32 | origin MutationOrigin (9)
#   | priority i32 (4) | stable_order u64 (8) | effect MutationEffect (21)
#
# `expected_revision: ArtifactId` is §30.5's "stale-revision commit fails": the
# op names the artifact revision it was planned against, and the executor
# refuses to apply it into a snapshot whose target artifact has moved on.
# ----------------------------------------------------------------------------

val MUTATION_OP_LEN: i64 = 105

struct MutationOp:
    """One transactional edit (§8.2)."""
    kind: MutationKind
    phase: MutationPhase
    reserved: u8
    target: EntityKey
    expected_revision: ArtifactId
    payload: u32
    precondition: u32
    origin: MutationOrigin
    priority: i32
    stable_order: u64
    effect: MutationEffect

fn mutation_op(kind: MutationKind, target: EntityKey,
               expected_revision: ArtifactId, payload: u32, precondition: u32,
               origin: MutationOrigin, priority: i32, stable_order: u64,
               effect: MutationEffect) -> MutationOp:
    """Build an op with its phase DERIVED from its kind. There is deliberately
    no constructor that lets a caller supply a phase: the phase is a function of
    the kind, and the codec enforces that on both directions of the wire."""
    MutationOp(kind: kind, phase: mutation_kind_phase(kind), reserved: 0,
               target: target, expected_revision: expected_revision,
               payload: payload, precondition: precondition, origin: origin,
               priority: priority, stable_order: stable_order, effect: effect)

fn mutation_op_has_payload(op: MutationOp) -> bool:
    op.payload != MUTATION_NO_PAYLOAD

fn mutation_op_has_precondition(op: MutationOp) -> bool:
    op.precondition != MUTATION_NO_PRECONDITION

fn mutation_op_well_formed(op: MutationOp) -> bool:
    """The per-op contract, applied identically on encode and on decode.

    The effect check is the load-bearing one: §8.3 says the effect summary is
    what conflict detection runs on, so an op whose effect does not admit that
    it touches its own target kind is invisible to conflict detection while
    still editing the snapshot. That is a silently-wrong result, not a loud
    failure, which is exactly the class of defect §8 set out to remove — so it
    is refused on the way OUT as well as on the way in.
    """
    if op.reserved != 0:
        return false
    if not mutation_phase_equal(op.phase, mutation_kind_phase(op.kind)):
        return false
    if not mutation_origin_well_formed(op.origin):
        return false
    if not mutation_effect_well_formed(op.effect):
        return false
    if not mutation_u32_valid(op.payload):
        return false
    if not mutation_u32_valid(op.precondition):
        return false
    if not mutation_i32_valid(op.priority):
        return false
    entity_kind_set_contains(mutation_effect_mutates(op.effect),
                             mutation_kind_target_kind(op.kind))

fn mutation_op_equal(a: MutationOp, b: MutationOp) -> bool:
    (mutation_kind_equal(a.kind, b.kind)
        and mutation_phase_equal(a.phase, b.phase)
        and a.reserved == b.reserved
        and entity_key_equal(a.target, b.target)
        and artifact_id_equal(a.expected_revision, b.expected_revision)
        and a.payload == b.payload
        and a.precondition == b.precondition
        and mutation_origin_equal(a.origin, b.origin)
        and a.priority == b.priority
        and a.stable_order == b.stable_order
        and mutation_effect_equal(a.effect, b.effect))

fn mutation_op_conflicts_with(a: MutationOp, b: MutationOp) -> bool:
    """Two ops conflict when they touch the same target and the set of entity
    kinds they change overlaps. §8.4's ComposeIfDisjoint is precisely the policy
    that admits the non-overlapping case."""
    if not entity_key_equal(a.target, b.target):
        return false
    not ((mutation_effect_mutates(a.effect)
          & mutation_effect_mutates(b.effect)) == 0)

# ----------------------------------------------------------------------------
# §8.4 deterministic conflict order.
#
#   1. target artifact/entity
#   2. mutation phase
#   3. declared priority
#   4. plugin/advice stable name
#   5. source order
#   6. stable operation ordinal
#
# Key 3 sorts DESCENDING: §8.4 names the policy "HighestPriorityWins", so the
# highest priority must come first. Every other key ascends.
#
# Key 1 needs a total order on EntityKey, which §4.2 does not give. The order
# used is the record's own WIRE order — content_hash.hi, content_hash.lo,
# artifact.schema_version, schema, local_identity — so that a sorter reading the
# encoded bytes and a sorter reading the struct agree by construction, and so
# that the order is stable across languages without a side table. All five
# components are unsigned.
# ----------------------------------------------------------------------------

fn mutation_hash128_before(a: Hash128, b: Hash128) -> bool:
    if a.hi != b.hi:
        return mutation_u64_lt(a.hi, b.hi)
    mutation_u64_lt(a.lo, b.lo)

fn mutation_artifact_before(a: ArtifactId, b: ArtifactId) -> bool:
    if not hash128_equal(a.content_hash, b.content_hash):
        return mutation_hash128_before(a.content_hash, b.content_hash)
    a.schema_version < b.schema_version

fn mutation_entity_key_before(a: EntityKey, b: EntityKey) -> bool:
    """Total order on EntityKey in wire-field order."""
    if not artifact_id_equal(a.artifact, b.artifact):
        return mutation_artifact_before(a.artifact, b.artifact)
    if a.schema != b.schema:
        return a.schema < b.schema
    mutation_u64_lt(a.local_identity, b.local_identity)

fn mutation_op_before(a: MutationOp, b: MutationOp) -> bool:
    """§8.4's six-key deterministic order. Strict: returns false for two ops
    with identical keys, which is what makes `mutation_plan_ordered` able to
    reject a plan containing an ambiguous pair."""
    if not entity_key_equal(a.target, b.target):
        return mutation_entity_key_before(a.target, b.target)
    val pa = mutation_phase_to_u8(a.phase)
    val pb = mutation_phase_to_u8(b.phase)
    if pa != pb:
        return pa < pb
    if a.priority != b.priority:
        return a.priority > b.priority
    if a.origin.stable_name != b.origin.stable_name:
        return a.origin.stable_name < b.origin.stable_name
    if a.origin.source_order != b.origin.source_order:
        return a.origin.source_order < b.origin.source_order
    mutation_u64_lt(a.stable_order, b.stable_order)

fn mutation_op_order_equal(a: MutationOp, b: MutationOp) -> bool:
    """True when neither op precedes the other — an order-ambiguous pair."""
    not mutation_op_before(a, b) and not mutation_op_before(b, a)

# ----------------------------------------------------------------------------
# MutationPlan (§8.1 "MutationPlan", §8.6 `merge(plans, policy)`).
#
#   envelope(8) | policy u8 | schema_version u32 | op_count u32
#               | ops MutationOp * op_count
#
# The count sits ahead of the run so a decoder can bound the region before
# allocating — the ordering rule wave 0b used for the mapping shard.
# ----------------------------------------------------------------------------

struct MutationPlan:
    """An ordered, conflict-resolved batch of ops (§8.1)."""
    policy: ConflictPolicy
    schema_version: u32
    ops: [MutationOp]

fn mutation_plan(policy: ConflictPolicy, schema_version: u32,
                 ops: [MutationOp]) -> MutationPlan:
    MutationPlan(policy: policy, schema_version: schema_version, ops: ops)

fn mutation_plan_ordered(p: MutationPlan) -> bool:
    """Every op strictly precedes the next under §8.4's six keys.

    This is the whole point of the group. §30.5 requires that "operation
    ordering is deterministic" and that "conflicts never depend on thread
    scheduling"; a plan whose ops are stored out of order, or that contains two
    ops with identical order keys, has no deterministic application and would
    give a different snapshot depending on which evaluator walked it. Enforced
    on ENCODE as well as decode, so such a plan is unrepresentable on the wire.
    """
    var i = 1
    while i < p.ops.len():
        if not mutation_op_before(p.ops[i - 1], p.ops[i]):
            return false
        i = i + 1
    true

fn mutation_plan_valid(p: MutationPlan) -> bool:
    """A plan is valid when it is non-empty, every op is well formed, and the
    ops are in strict §8.4 order. Empty is refused for the reason the QUERY lane
    refused an empty op arena: an empty plan and a rejected plan would otherwise
    be indistinguishable to a caller that ignores `ok`."""
    if p.ops.len() == 0:
        return false
    if not mutation_u32_valid(p.schema_version):
        return false
    var i = 0
    while i < p.ops.len():
        if not mutation_op_well_formed(p.ops[i]):
            return false
        i = i + 1
    mutation_plan_ordered(p)

fn mutation_plan_equal(a: MutationPlan, b: MutationPlan) -> bool:
    if not conflict_policy_equal(a.policy, b.policy):
        return false
    if a.schema_version != b.schema_version:
        return false
    if a.ops.len() != b.ops.len():
        return false
    var i = 0
    while i < a.ops.len():
        if not mutation_op_equal(a.ops[i], b.ops[i]):
            return false
        i = i + 1
    true

fn mutation_plan_conflict_count(p: MutationPlan) -> i64:
    """Number of adjacent op pairs that conflict. Adjacent is sufficient
    because the plan is in §8.4 order, which groups a target's ops together."""
    var n = 0
    var i = 1
    while i < p.ops.len():
        if mutation_op_conflicts_with(p.ops[i - 1], p.ops[i]):
            n = n + 1
        i = i + 1
    n

# ----------------------------------------------------------------------------
# MutationCommitReceipt (§8.5 `MutationReceipt`, renamed — see
# mutation_contracts.spl) — 104 bytes of body:
#
#   input_snapshot SnapshotId (28) | output_snapshot SnapshotId (28)
#   | plan_hash Hash128 (16)
#   | matched_entities u64 | applied_ops u64 | skipped_ops u64 | conflicts u64
#
# DEVIATIONS FROM §8.5, both reported for ratification:
#
#  1. `plan_hash: Hash256`. Hash256 exists in-tree only as a `text` wrapper
#     class (common/compute/placement_contracts/semantic.spl) with no wire
#     encoding, while the ID-TAG lane froze Hash128 as THE content hash of the
#     structural wire and the receipts lane already reused it for
#     MappingShardRef.content_hash with the note "Hash128 is reused from the
#     ID-TAG lane rather than a new width being introduced". This lane follows
#     that precedent rather than minting a second hash width.
#
#  2. `mapping_delta: MappingShardRef`, `tag_delta: TagShardRef`,
#     `invalidation: InvalidationSetRef` and `verification: VerificationReceipt`
#     are NOT on the v1 wire. Two of those four types do not exist anywhere in
#     the tree: `TagShardRef` is frozen only as a compiler sidecar handle
#     (compiler/00.common/structural_contracts/sidecars.spl) and
#     `InvalidationSetRef` is not declared at all — the ID-TAG and INVALIDATE
#     lanes own them and have not frozen them. Encoding two of the four and
#     inventing the other two would produce a record that cannot express §8.5
#     anyway, so v1 freezes the numeric core and carries the four handles
#     out-of-band. They take appended slots in a v2 bump once those lanes land.
# ----------------------------------------------------------------------------

val MUTATION_RECEIPT_LEN: i64 = 104

struct MutationCommitReceipt:
    """What a commit actually did (§8.5)."""
    input_snapshot: SnapshotId
    output_snapshot: SnapshotId
    plan_hash: Hash128
    matched_entities: u64
    applied_ops: u64
    skipped_ops: u64
    conflicts: u64

fn mutation_commit_receipt(input_snapshot: SnapshotId,
                           output_snapshot: SnapshotId, plan_hash: Hash128,
                           matched_entities: u64, applied_ops: u64,
                           skipped_ops: u64,
                           conflicts: u64) -> MutationCommitReceipt:
    MutationCommitReceipt(input_snapshot: input_snapshot,
                          output_snapshot: output_snapshot,
                          plan_hash: plan_hash,
                          matched_entities: matched_entities,
                          applied_ops: applied_ops, skipped_ops: skipped_ops,
                          conflicts: conflicts)

fn mutation_receipt_no_op(snapshot: SnapshotId, plan_hash: Hash128,
                          matched_entities: u64,
                          skipped_ops: u64) -> MutationCommitReceipt:
    """The failed-validation receipt: §30.5's "failed validation leaves the
    original snapshot unchanged", so output == input and nothing applied."""
    mutation_commit_receipt(snapshot, snapshot, plan_hash, matched_entities, 0,
                            skipped_ops, skipped_ops)

fn mutation_receipt_applied_anything(r: MutationCommitReceipt) -> bool:
    r.applied_ops != 0

fn mutation_receipt_well_formed(r: MutationCommitReceipt) -> bool:
    """§30.5's receipt obligations, as a predicate applied on encode AND decode:

      - "receipts exactly explain applied, skipped, and rejected operations":
        every conflicted op was necessarily NOT applied, so conflicts can never
        exceed skipped_ops. A receipt reporting 3 conflicts and 1 skip is
        internally impossible and must not be storable.
      - "failed validation leaves the original snapshot unchanged": if nothing
        was applied, the output snapshot MUST be the input snapshot.
      - a commit that applied something must publish a LATER epoch of the same
        artifact lineage — `snapshot_supersedes`, the ID-TAG lane's ratified
        rule, rather than a second definition of staleness here.

    All comparisons on the u64 counters go through `mutation_u64_lt` so a count
    above 2^63 (which Simple carries as a negative i64) cannot compare as
    smaller than a small one.
    """
    if mutation_u64_lt(r.skipped_ops, r.conflicts):
        return false
    if not mutation_receipt_applied_anything(r):
        return snapshot_id_equal(r.output_snapshot, r.input_snapshot)
    snapshot_supersedes(r.output_snapshot, r.input_snapshot)

fn mutation_receipt_equal(a: MutationCommitReceipt,
                          b: MutationCommitReceipt) -> bool:
    (snapshot_id_equal(a.input_snapshot, b.input_snapshot)
        and snapshot_id_equal(a.output_snapshot, b.output_snapshot)
        and hash128_equal(a.plan_hash, b.plan_hash)
        and a.matched_entities == b.matched_entities
        and a.applied_ops == b.applied_ops
        and a.skipped_ops == b.skipped_ops
        and a.conflicts == b.conflicts)

export MUTATION_NO_PAYLOAD, MUTATION_NO_PRECONDITION
export MUTATION_EFFECT_LEN, MUTATION_ORIGIN_LEN, MUTATION_OP_LEN
export MUTATION_RECEIPT_LEN
export EFFECT_FLAG_CONTROL_FLOW, EFFECT_FLAG_TYPES, EFFECT_FLAG_ABI
export EFFECT_FLAG_LAYOUT_GEOMETRY, EFFECT_FLAGS_KNOWN
export MutationEffect, mutation_effect, mutation_effect_none
export effect_flags_valid, mutation_effect_well_formed, mutation_effect_mutates
export mutation_effect_flag, mutation_effect_equal
export MutationOrigin, mutation_origin, mutation_origin_zero
export mutation_origin_well_formed, mutation_origin_equal
export MutationOp, mutation_op, mutation_op_well_formed, mutation_op_equal
export mutation_op_has_payload, mutation_op_has_precondition
export mutation_op_conflicts_with
export mutation_hash128_before, mutation_artifact_before
export mutation_entity_key_before, mutation_op_before, mutation_op_order_equal
export MutationPlan, mutation_plan, mutation_plan_ordered, mutation_plan_valid
export mutation_plan_equal, mutation_plan_conflict_count
export MutationCommitReceipt, mutation_commit_receipt, mutation_receipt_no_op
export mutation_receipt_applied_anything, mutation_receipt_well_formed
export mutation_receipt_equal
