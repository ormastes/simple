"""Deterministic Metal MSL generators for validated ProcessingIR and drawing access."""

use std.common.processing.processing_ir.{
    PROCESSING_IR_OP_FILL_U32, PROCESSING_IR_OP_FILL_RECT_U32,
    ProcessingIr, processing_ir_validate
}
use std.common.processing.backend_contract.{
    ProcessingBackendTarget, ProcessingBackendArtifact,
    processing_backend_artifact_reject, processing_backend_semantic_key
}

val PROCESSING_METAL_MSL_ABI_VERSION: text = "processing-metal-msl-abi-v1"
val PROCESSING_METAL_FILL_ENTRY: text = "processing_fill_u32"

fn processing_metal_source(ir: ProcessingIr) -> text:
    val validation = processing_ir_validate(ir)
    if not validation.valid:
        return ""
    if ir.op == PROCESSING_IR_OP_FILL_RECT_U32:
        return "#include <metal_stdlib>\nusing namespace metal;\n// " + PROCESSING_METAL_MSL_ABI_VERSION +
            "\nstruct ProcessingDrawParams { uint width; uint height; uint stride; uint x; uint y; uint rect_width; uint rect_height; uint pixel; };\n" +
            "kernel void processing_fill_rect(device uint* pixels [[buffer(0)]], device uint* unused [[buffer(1)]], " +
            "constant ProcessingDrawParams& p [[buffer(2)]], uint2 gid [[thread_position_in_grid]]) " +
            "{ if (gid.x >= p.stride || gid.y >= p.height) return; " +
            "bool inside = gid.x < p.width && gid.x >= p.x && gid.x < p.x + p.rect_width && gid.y >= p.y && gid.y < p.y + p.rect_height; " +
            "pixels[gid.y * p.stride + gid.x] = inside ? p.pixel : 0u; }\n"
    "#include <metal_stdlib>\nusing namespace metal;\n// " + PROCESSING_METAL_MSL_ABI_VERSION +
        "\nstruct ProcessingFillParams { uint value; uint count; };\n" +
        "kernel void " + PROCESSING_METAL_FILL_ENTRY +
        "(device uint* output [[buffer(0)]], device uint* unused [[buffer(1)]], " +
        "constant ProcessingFillParams& p [[buffer(2)]], uint tid [[thread_position_in_grid]]) " +
        "{ if (tid >= p.count) return; output[tid] = p.value; }\n"

fn processing_metal_generate_artifact(ir: ProcessingIr) -> ProcessingBackendArtifact:
    val target = ProcessingBackendTarget.MetalMsl
    val validation = processing_ir_validate(ir)
    if not validation.valid:
        return processing_backend_artifact_reject(ir, target, validation.reason)
    val source = processing_metal_source(ir)
    if source == "":
        return processing_backend_artifact_reject(ir, target, "metal-msl-generation-failed")
    ProcessingBackendArtifact(
        target: target, format: "msl",
        entry_point: if ir.op == PROCESSING_IR_OP_FILL_RECT_U32: "processing_fill_rect" else: PROCESSING_METAL_FILL_ENTRY,
        source: source, binary: [], semantic_key: processing_backend_semantic_key(ir, target),
        valid: true, reason: "ok")

enum ProcessingMetalDrawingOp:
    FillRect
    Unsupported

struct ProcessingMetalDrawingAccess:
    op: ProcessingMetalDrawingOp
    width: i64
    height: i64
    x: i64
    y: i64
    rect_width: i64
    rect_height: i64
    pixel: u32

fn processing_metal_drawing_fill_rect(width: i64, height: i64, x: i64, y: i64, rect_width: i64, rect_height: i64, pixel: u32) -> ProcessingMetalDrawingAccess:
    ProcessingMetalDrawingAccess(op: ProcessingMetalDrawingOp.FillRect, width: width,
        height: height, x: x, y: y, rect_width: rect_width,
        rect_height: rect_height, pixel: pixel)

fn processing_metal_drawing_validate(draw: ProcessingMetalDrawingAccess) -> text:
    if draw.op != ProcessingMetalDrawingOp.FillRect:
        return "unsupported-drawing-op"
    if draw.width <= 0 or draw.height <= 0:
        return "invalid-drawing-extent"
    if draw.width > 1048576 or draw.height > 1048576 or draw.width * draw.height > 536870911:
        return "drawing-output-size-overflow"
    if draw.x < 0 or draw.y < 0 or draw.rect_width <= 0 or draw.rect_height <= 0:
        return "invalid-drawing-rectangle"
    if draw.x + draw.rect_width > draw.width or draw.y + draw.rect_height > draw.height:
        return "drawing-rectangle-out-of-bounds"
    "ok"

fn processing_metal_drawing_semantic_key(draw: ProcessingMetalDrawingAccess) -> text:
    "processing-draw-v1|metal-msl|fill-rect|width={draw.width}|height={draw.height}|x={draw.x}|y={draw.y}|rect-width={draw.rect_width}|rect-height={draw.rect_height}|pixel={draw.pixel}|abi=" + PROCESSING_METAL_MSL_ABI_VERSION

fn processing_metal_drawing_source(draw: ProcessingMetalDrawingAccess) -> text:
    if processing_metal_drawing_validate(draw) != "ok":
        return ""
    "#include <metal_stdlib>\nusing namespace metal;\n// " + PROCESSING_METAL_MSL_ABI_VERSION +
        "\nstruct ProcessingDrawParams { uint width; uint height; uint x; uint y; uint rect_width; uint rect_height; uint pixel; };\n" +
        "kernel void processing_fill_rect(device uint* pixels [[buffer(0)]], " +
        "constant ProcessingDrawParams& p [[buffer(2)]], uint2 gid [[thread_position_in_grid]]) " +
        "{ if (gid.x >= p.width || gid.y >= p.height) return; " +
        "if (gid.x >= p.x && gid.x < p.x + p.rect_width && gid.y >= p.y && gid.y < p.y + p.rect_height) " +
        "pixels[gid.y * p.width + gid.x] = p.pixel; }\n"

fn processing_metal_generate_drawing_artifact(draw: ProcessingMetalDrawingAccess) -> ProcessingBackendArtifact:
    val reason = processing_metal_drawing_validate(draw)
    val target = ProcessingBackendTarget.MetalMsl
    if reason != "ok":
        return ProcessingBackendArtifact(target: target, format: "msl", entry_point: "",
            source: "", binary: [], semantic_key: processing_metal_drawing_semantic_key(draw),
            valid: false, reason: reason)
    ProcessingBackendArtifact(target: target, format: "msl",
        entry_point: "processing_fill_rect", source: processing_metal_drawing_source(draw), binary: [],
        semantic_key: processing_metal_drawing_semantic_key(draw), valid: true, reason: "ok")

fn processing_metal_drawing_cpu_oracle(draw: ProcessingMetalDrawingAccess) -> [u32]:
    if processing_metal_drawing_validate(draw) != "ok":
        return []
    var pixels: [u32] = []
    var yy: i64 = 0
    while yy < draw.height:
        var xx: i64 = 0
        while xx < draw.width:
            val inside = xx >= draw.x and xx < draw.x + draw.rect_width and yy >= draw.y and yy < draw.y + draw.rect_height
            pixels.push(if inside: draw.pixel else: 0u32)
            xx = xx + 1
        yy = yy + 1
    pixels

export PROCESSING_METAL_MSL_ABI_VERSION, PROCESSING_METAL_FILL_ENTRY
export processing_metal_source, processing_metal_generate_artifact
export ProcessingMetalDrawingOp, ProcessingMetalDrawingAccess
export processing_metal_drawing_fill_rect, processing_metal_drawing_validate
export processing_metal_drawing_semantic_key, processing_metal_drawing_source
export processing_metal_generate_drawing_artifact, processing_metal_drawing_cpu_oracle
