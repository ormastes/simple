# Notebook magics — parse/strip %mode, %%mode, %lanes, %reset, %budget,
# %timeout, %onfault from a cell's raw source before it ever reaches the
# lowering/execution path.
#
# Design:  doc/05_design/app/tools/notebook_lanes_architecture.md §3
# Plan:    doc/03_plan/agent_tasks/notebook_lanes_parallel_plan_2026-08-07.md (Stream K, K3)
#
# This module is a thin parsing/dispatch layer that sits in FRONT of
# KernelSessionManager (K1, src/lib/nogc_sync_mut/notebook/session_manager.spl).
# It never re-implements %mode/%%mode resolution — that logic (session
# default vs. per-cell override) already lives in
# KernelSession.resolve_mode / KernelSessionManager.resolve_cell_mode. This
# module only recognizes the magic lines, strips them from the cell text, and
# translates them into calls against the existing manager API.
#
# Magics are lines starting with "%" or "%%" at the TOP of a cell (design §3:
# "%%mode ... — first line of a cell"). Once a non-magic line is seen, magic
# parsing stops — the rest of the cell (including any "%"-looking text inside
# code, e.g. a modulo expression) is left untouched and handed to the
# executor verbatim.

use std.notebook.types.{SessionOpts}
use std.notebook.session_manager.{KernelSessionManager}

# ============================================================================
# The supported magic set (design §3) — used both for dispatch and for the
# unknown-magic diagnostic's "supported list".
# ============================================================================

pub val SUPPORTED_MAGICS: [text] = ["%mode", "%%mode", "%lanes", "%reset", "%budget", "%timeout", "%onfault"]

fn supported_magics_list() -> text:
    SUPPORTED_MAGICS.join(", ")

# ============================================================================
# ParsedMagics — the result of stripping magic lines off a cell's raw source.
# `code` is what remains after every leading magic line is removed; it is
# exactly what must be handed to the executor (magics never reach lowering).
# ============================================================================

struct ParsedMagics:
    code: text
    mode: text                # %mode target, "" if absent
    cell_mode_override: text  # %%mode target for THIS cell only, "" if absent
    lanes: bool                # %lanes requested
    reset: bool                 # %reset requested
    budget: i64                 # %budget value, -1 if absent
    timeout_ms: i64             # %timeout value, -1 if absent
    onfault: text                # %onfault value, "" if absent
    error: text                  # unknown-magic diagnostic, "" if none

fn parsed_magics_empty(code: text) -> ParsedMagics:
    ParsedMagics(code: code, mode: "", cell_mode_override: "", lanes: false, reset: false,
        budget: -1, timeout_ms: -1, onfault: "", error: "")

fn parsed_magics_error(diag: text) -> ParsedMagics:
    ParsedMagics(code: "", mode: "", cell_mode_override: "", lanes: false, reset: false,
        budget: -1, timeout_ms: -1, onfault: "", error: diag)

fn is_magic_line(line: text) -> bool:
    line.trim().starts_with("%")

# Parses a non-negative integer literal. Returns -1 for "" or anything with a
# non-digit character (deliberately hand-rolled rather than `text.to_i64()`,
# whose interpreter intrinsic returns Nil — not 0 — on a parse failure; see
# reference_jit_option_i64_value3_none_collision.md for why routing an
# untrusted Nil into a declared-i64 slot is unsafe here).
fn parse_uint_arg(arg: text) -> i64:
    val t = arg.trim()
    if t == "":
        return -1
    var i = 0
    while i < t.len():
        val c = t.substring(i, i + 1)
        if c < "0" or c > "9":
            return -1
        i = i + 1
    t.to_i64()

# One magic line's keyword + argument (everything after the keyword,
# trimmed). "%mode interpreter(...)" -> ("%mode", "interpreter(...)").
fn magic_keyword_and_arg(line: text) -> (text, text):
    val trimmed = line.trim()
    # "%%mode" must be matched before "%mode" (both start with "%"). Each
    # check requires a word boundary (exact match or a following space) so
    # e.g. "%modexyz" is NOT mistaken for "%mode" with arg "xyz".
    if trimmed == "%%mode" or trimmed.starts_with("%%mode "):
        return ("%%mode", trimmed.substring(6).trim())
    if trimmed == "%mode" or trimmed.starts_with("%mode "):
        return ("%mode", trimmed.substring(5).trim())
    if trimmed == "%lanes" or trimmed.starts_with("%lanes "):
        return ("%lanes", trimmed.substring(6).trim())
    if trimmed == "%reset" or trimmed.starts_with("%reset "):
        return ("%reset", trimmed.substring(6).trim())
    if trimmed == "%budget" or trimmed.starts_with("%budget "):
        return ("%budget", trimmed.substring(7).trim())
    if trimmed == "%timeout" or trimmed.starts_with("%timeout "):
        return ("%timeout", trimmed.substring(8).trim())
    if trimmed == "%onfault" or trimmed.starts_with("%onfault "):
        return ("%onfault", trimmed.substring(8).trim())
    # Unknown magic: report the leading token (up to the first space) as-is.
    var i = 0
    while i < trimmed.len() and trimmed.substring(i, i + 1) != " ":
        i = i + 1
    (trimmed.substring(0, i), "")

pub fn parse_magics(source: text) -> ParsedMagics:
    """Strip leading magic lines from `source` (design §3). Returns a
    ParsedMagics whose `code` field is the remainder of the cell, ready to
    hand straight to the executor. An unknown magic sets `error` to a
    diagnostic naming the supported list; `code` is then "" (the caller must
    check `error` before using `code`)."""
    val all_lines = source.split("\n")
    var result = parsed_magics_empty("")
    var i = 0
    var stopped = false
    while i < all_lines.len() and not stopped:
        val line = all_lines[i]
        if is_magic_line(line):
            val (keyword, arg) = magic_keyword_and_arg(line)
            if keyword == "%%mode":
                if i != 0:
                    # %%mode is only recognized as the FIRST line of a cell
                    # (design §3); elsewhere it is an unknown magic in this
                    # position (still stripped-and-erred, never silently
                    # ignored, never forwarded to the executor).
                    return parsed_magics_error("Unknown magic: {keyword} (only valid as the first line of a cell); supported magics: {supported_magics_list()}")
                result.cell_mode_override = arg
            elif keyword == "%mode":
                result.mode = arg
            elif keyword == "%lanes":
                result.lanes = true
            elif keyword == "%reset":
                result.reset = true
            elif keyword == "%budget":
                val n = parse_uint_arg(arg)
                if n < 0:
                    return parsed_magics_error("%budget requires a non-negative integer argument, got: '{arg}'")
                result.budget = n
            elif keyword == "%timeout":
                val n = parse_uint_arg(arg)
                if n < 0:
                    return parsed_magics_error("%timeout requires a non-negative integer argument, got: '{arg}'")
                result.timeout_ms = n
            elif keyword == "%onfault":
                if arg.trim() == "":
                    return parsed_magics_error("%onfault requires an argument (e.g. 'reset'), got none")
                result.onfault = arg
            else:
                return parsed_magics_error("Unknown magic: {keyword}; supported magics: {supported_magics_list()}")
            i = i + 1
        else:
            stopped = true
    # Whatever wasn't consumed as a magic line is the real cell body.
    var body_lines: [text] = []
    var j = i
    while j < all_lines.len():
        body_lines.push(all_lines[j])
        j = j + 1
    result.code = body_lines.join("\n")
    result

# ============================================================================
# MagicsState — per-session %budget/%timeout/%onfault knobs (design §3:
# "set ... for subsequent [cells]"). Threaded by the caller (kernel main /
# Simple Lab) across execute_cell calls for one session; not stored inside
# KernelSessionManager because SessionOpts is only consumed at executor
# `start()` time (K1/K2), and no landed executor (LocalExec) reads these
# fields yet — GPU lanes (K5/K6) are the intended consumers per design §3.
# ============================================================================

class MagicsState:
    budget: i64
    timeout_ms: i64
    onfault_reset: bool

    static fn create() -> MagicsState:
        MagicsState(budget: 0, timeout_ms: 0, onfault_reset: false)

    me apply(parsed: ParsedMagics):
        if parsed.budget >= 0:
            self.budget = parsed.budget
        if parsed.timeout_ms >= 0:
            self.timeout_ms = parsed.timeout_ms
        if parsed.onfault != "":
            self.onfault_reset = parsed.onfault.trim() == "reset"

    fn to_session_opts(session_id: text, mode_spec: text) -> SessionOpts:
        SessionOpts(session_id: session_id, mode_spec: mode_spec, step_budget: self.budget,
            timeout_ms: self.timeout_ms, onfault_reset: self.onfault_reset)

# ============================================================================
# MagicsResult — outcome of dispatching a parsed cell's magics against a
# KernelSessionManager, handed back to the caller alongside the stripped
# code (the caller still runs `code` through execute_cell itself when
# `code` is non-empty and `error` is "" — a magics-only cell, e.g. a bare
# "%lanes", has empty `code` and nothing further to execute).
# ============================================================================

struct MagicsResult:
    code: text
    cell_mode_override: text  # pass straight to KernelSessionManager.execute_cell
    message: text               # confirmation / table output for magics-only cells (e.g. %lanes)
    error: text                  # "" on success

fn magics_result_error(diag: text) -> MagicsResult:
    MagicsResult(code: "", cell_mode_override: "", message: "", error: diag)

pub fn dispatch_magics(mgr: KernelSessionManager, session_id: text, state: MagicsState, source: text) -> MagicsResult:
    """Parse the magics off `source`, apply them against `mgr`/`state`, and
    return the remaining cell body + any confirmation/table text. Never
    forwards a magic line to the executor."""
    val parsed = parse_magics(source)
    if parsed.error != "":
        return magics_result_error(parsed.error)

    var messages: [text] = []

    if parsed.mode != "":
        val diag = mgr.set_default_mode(session_id, parsed.mode)
        if diag != "":
            return magics_result_error(diag)
        messages.push("mode set to {parsed.mode}")

    if parsed.reset:
        val diag = mgr.reset_session(session_id)
        if diag != "":
            return magics_result_error(diag)
        messages.push("session reset")

    state.apply(parsed)
    if parsed.budget >= 0:
        messages.push("budget set to {parsed.budget}")
    if parsed.timeout_ms >= 0:
        messages.push("timeout set to {parsed.timeout_ms}ms")
    if parsed.onfault != "":
        messages.push("onfault set to {parsed.onfault}")

    if parsed.lanes:
        messages.push(lane_table(mgr, session_id))

    MagicsResult(code: parsed.code, cell_mode_override: parsed.cell_mode_override,
        message: messages.join("\n"), error: "")

fn lane_table(mgr: KernelSessionManager, session_id: text) -> text:
    """%lanes: print the availability of every lane this session currently
    has a cached (started) executor for, plus the session default (design
    §3). The full cross-lane probe table (remote/CUDA/Vulkan availability
    before a session ever touches them) is the GPU-plan A3/E2 lane registry,
    consumed once K4-K6 land; until then the table reports what this session
    actually knows about: its default mode and every lane already started
    via %mode/%%mode, probed live."""
    var i = 0
    while i < mgr.sessions.len():
        if mgr.sessions[i].id == session_id:
            val session = mgr.sessions[i]
            var lines: [text] = ["default: {session.default_mode}"]
            var j = 0
            while j < session.cache.len():
                val entry = session.cache[j]
                lines.push("{entry.mode_spec}: {entry.executor.probe().to_text()}")
                j = j + 1
            return lines.join("\n")
        i = i + 1
    "No active lanes for session: {session_id}"
