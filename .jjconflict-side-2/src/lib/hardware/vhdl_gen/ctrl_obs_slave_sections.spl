# Named literal sections for rv32_ctrl_obs_slave — irreducible paragraphs only:
# the file header rationale prose, the capture-buffer declaration rationale,
# and the AXI4-Lite handshake logic paragraphs. The register map (both its
# documentation table AND the read-mux case arms), the entity, the signal
# declarations, the lane select/concat, and the reset blocks are generated
# structurally in ctrl_obs_slave_gen.spl.

fn ctrl_obs_head_prose() -> [text]:
    var l: [text] = []
    l = l.push("-- rv32_ctrl_obs_slave: AXI4-Lite slave giving the Zynq PS (and therefore xsdb")
    l = l.push("-- over JTAG, via mrd/mwr) control over the rv32 soft-core and a window onto its")
    l = l.push("-- progress. This is the observation path on the KV260 carrier, where the fabric")
    l = l.push("-- UART TX lands on FPGA pin H12 (PMOD J2) and is NOT wired to the onboard")
    l = l.push("-- FT4232H -- so no host tty ever sees the core's UART bytes.")
    l = l.push("--")
    l = l.push("-- Instead the core's debug_uart_valid/debug_uart_byte side-channel is captured")
    l = l.push("-- into a 4096-byte buffer readable over this slave. The boot marker chain")
    l = l.push("-- (\"SimpleOS RV32 boot OK\" ... \"TEST PASSED\") fits comfortably in 4 KB, so a")
    l = l.push("-- JTAG readout reconstructs the console transcript verbatim.")
    l = l.push("--")
    l = l.push("-- Capture STOPS when the buffer fills (it does not wrap), which preserves the")
    l = l.push("-- earliest boot output -- exactly the markers we need -- rather than letting")
    l = l.push("-- later chatter overwrite it.")
    l = l.push("--")
    l = l.push("-- Register map (byte offsets):")
    l

fn ctrl_obs_buffer_decl_comment() -> [text]:
    var l: [text] = []
    l = l.push("  -- 4096 words x 4 byte lanes = 16 KB of transcript. Held as four independent")
    l = l.push("  -- byte arrays so a capture write touches exactly one lane -- no")
    l = l.push("  -- read-modify-write, and each lane infers a simple byte-wide BRAM.")
    l

fn ctrl_obs_rdata_mux_comment() -> [text]:
    var l: [text] = []
    l = l.push("  -- Capture-buffer bytes resolve out of the registered BRAM read port; all")
    l = l.push("  -- other offsets come from the register mux latched at arready time.")
    l

# Write-channel handshake body (between the reset block and `end if;`).
fn ctrl_obs_write_body() -> [text]:
    var l: [text] = []
    l = l.push("        if awready_q = '0' and s_axi_ctrl_awvalid = '1' then")
    l = l.push("          awready_q <= '1';")
    l = l.push("          awaddr_q  <= s_axi_ctrl_awaddr;")
    l = l.push("        else")
    l = l.push("          awready_q <= '0';")
    l = l.push("        end if;")
    l = l.push("")
    l = l.push("        if wready_q = '0' and s_axi_ctrl_wvalid = '1' then")
    l = l.push("          wready_q <= '1';")
    l = l.push("          -- Only CTRL is writable.")
    l = l.push("          if awaddr_q(15) = '0' and awaddr_q(7 downto 2) = \"000000\" then")
    l = l.push("            core_run_q <= s_axi_ctrl_wdata(0);")
    l = l.push("          end if;")
    l = l.push("          bvalid_q <= '1';")
    l = l.push("        else")
    l = l.push("          wready_q <= '0';")
    l = l.push("        end if;")
    l = l.push("")
    l = l.push("        if bvalid_q = '1' and s_axi_ctrl_bready = '1' then")
    l = l.push("          bvalid_q <= '0';")
    l = l.push("        end if;")
    l

# Read-channel tail: rvalid pipeline and R-channel retire.
fn ctrl_obs_read_tail() -> [text]:
    var l: [text] = []
    l = l.push("        end if;")
    l = l.push("")
    l = l.push("        if arready_q = '1' then")
    l = l.push("          -- Buffer reads resolve one cycle later than register reads; by now")
    l = l.push("          -- buf_rd_q holds the addressed byte.")
    l = l.push("          rvalid_q <= '1';")
    l = l.push("        end if;")
    l = l.push("")
    l = l.push("        if rvalid_q = '1' and s_axi_ctrl_rready = '1' then")
    l = l.push("          rvalid_q <= '0';")
    l = l.push("        end if;")
    l
