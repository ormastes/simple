# Built-in Math Extension
#
# Declares the "formula"/"mathml" document kind and the math.* command
# surface. The real formula-rendering logic lives on the math representation
# model (src/lib/common/math_repr.spl, owner_module of the "math" IDE
# capability): render_latex_raw (formula text -> LaTeX, line 1093), to_pretty
# (formula text -> Unicode pretty-print, line 1100), and to_md (formula text
# -> Markdown-embeddable form, line 1121). This manifest is the typed,
# host-visible declaration of that command surface, matching
# writer_ext_manifest's pattern of declaring commands the app itself owns
# and runs.

use std.editor.extensions.manifest.{ExtensionManifest, ExtensionCommand, ExtensionLanguage,
    extension_manifest_basic}

fn math_ext_manifest() -> ExtensionManifest:
    extension_manifest_basic(
        "math", "1.0.0", "",
        ["onCommand:math.render_latex", "onCommand:math.render_pretty"],
        [
            ExtensionCommand(id: "math.render_latex", title: "Math: Render LaTeX", category: "Math"),
            ExtensionCommand(id: "math.render_pretty", title: "Math: Render Pretty", category: "Math"),
            ExtensionCommand(id: "math.render_md", title: "Math: Render Markdown", category: "Math")
        ],
        [ExtensionLanguage(id: "formula", extensions: ["mathml"])]
    )
