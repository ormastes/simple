# Structural index executor seam for wave-2.
#
# Deliberately returns an explicit contract failure in wave-1.

use std.common.structural.parse.contracts.{ParseError, ParseErrorCode, SourceSnapshot}
use std.common.structural.parse.parse_types.{ParseDialect}

class StructuralBlockState:
    entry_state: i64
    exit_state: i64
    digest: text

struct StructuralIndex:
    positions: [i64]
    kinds: [i64]
    blocks: [StructuralBlockState]

fn build_structural_index(dialect: ParseDialect, snapshot: SourceSnapshot) -> Result<StructuralIndex, ParseError>:
    Err(ParseError(
        code: ParseErrorCode.UnsupportedMode,
        message: "build_structural_index is not implemented in wave-1",
        span: nil
    ))
