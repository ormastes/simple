# Stable SymbolId foundation for semantic markdown links.
#
# Produces a 128-bit content-derived symbol identity (32 hex chars) plus a
# short fingerprint used in link syntax:
#     spl:fn@compiler.frontend.parser.parse_module~a3b9c7d2e1f8
#
# Design: doc/01_research/language/simple_vs_rust_mission_critical_2026-07-27.md
# (section 5.1 / 13.3). This is deliberately independent of the compile-local
# HIR SymbolId (src/compiler/70.backend/backend/env.spl), which is an unstable
# per-compilation i64 and must never leak into documents.
#
# Identity inputs (ALL of them, nothing else):
#   schema_version, package, module_path, item_kind, owner_id, name,
#   normalized signature.
# Excluded BY CONSTRUCTION (there is no input to carry them):
#   line/column, byte offset, arena/node index, function body, doc text.

use std.common.crypto.sha256.{sha256_text}
use std.common.string_builder.{StringBuilder, string_builder}

# ============================================================================
# Components
# ============================================================================

struct SymbolComponents:
    package: text        # package identity, e.g. "ormastes.simple"
    module_path: text    # dotted module path, e.g. "compiler.frontend.parser"
    item_kind: text      # fn | method | type | trait | field | variant | const | contract | test
    owner_id: text       # full 32-hex stable id of the owning symbol, "" for top-level items
    name: text           # declared name
    signature: text      # raw declaration signature text; normalized internally

fn symbol_id_schema_version() -> i64:
    """Version of the id derivation scheme. Bump only when the canonical
    serialization or hash changes — bumping invalidates every existing link."""
    1

# ============================================================================
# Stable id
# ============================================================================

fn clean_component(s: text) -> text:
    """Field values must not contain the canonical separator (newline)."""
    s.replace("\n", " ").replace("\r", " ")

fn stable_symbol_id(c: SymbolComponents) -> text:
    """128-bit stable symbol id as 32 lowercase hex chars.

    Same components -> same id, on any machine, in any build.
    Canonical serialization: newline-joined tagged fields hashed with sha256,
    truncated to 128 bits."""
    val ver = symbol_id_schema_version()
    val fields = [
        "spl-symbol",
        "v{ver}",
        clean_component(c.package),
        clean_component(c.module_path),
        clean_component(c.item_kind),
        clean_component(c.owner_id),
        clean_component(c.name),
        normalize_signature(c.signature)
    ]
    val digest = sha256_text(fields.join("\n"))
    digest.slice(0, 32)

# ============================================================================
# Short fingerprint
# ============================================================================

fn default_short_len() -> i64:
    12

fn clamp_short_len(n: i64) -> i64:
    if n < 1:
        1
    elif n > 32:
        32
    else:
        n

fn short_fingerprint_n(full_id: text, short_len: i64) -> text:
    """Hex-prefix short form of a full 32-hex id."""
    var n = clamp_short_len(short_len)
    if n > full_id.len():
        n = full_id.len()
    full_id.slice(0, n)

fn short_fingerprint(full_id: text) -> text:
    short_fingerprint_n(full_id, default_short_len())

fn format_short_link(c: SymbolComponents, full_id: text) -> text:
    """Render the short link form: spl:<kind>@<module_path>.<name>~<fingerprint>."""
    val fp = short_fingerprint(full_id)
    "spl:{c.item_kind}@{c.module_path}.{c.name}~{fp}"

# ============================================================================
# Collision check
# ============================================================================

fn find_short_collisions(full_ids: [text], short_len: i64) -> [text]:
    """Short forms (at short_len) claimed by more than one DISTINCT full id.
    Duplicate occurrences of the same full id are not collisions."""
    var seen: Dict<text, text> = {}
    var out: [text] = []
    for full in full_ids:
        val short = short_fingerprint_n(full, short_len)
        if seen.contains_key(short):
            val existing = seen[short]
            if existing != full and not out.contains(short):
                out = out.push(short)
        else:
            seen[short] = full
    out

fn check_short_forms_unique(full_ids: [text], short_len: i64) -> Result<(), text>:
    """Errors (never guesses) when any short form is ambiguous within the set."""
    val cols = find_short_collisions(full_ids, short_len)
    if cols.is_empty():
        Ok(())
    else:
        val joined = cols.join(", ")
        Err("short fingerprint collision at length {short_len}: {joined}")

# ============================================================================
# Signature normalization
# ============================================================================

fn normalize_signature(sig: text) -> text:
    """Deterministic signature normal form: parameter TYPES + arity + return type.

    Kept:     parameter types (order-sensitive), arity, return type.
    Dropped:  parameter names, default values, all whitespace.
    Never present (excluded by construction, not by filtering): line/column,
    byte offsets, function body, doc text.

    "fn f(count: i64, msg: text = \"x\") -> bool"  ->  "(i64,text)->bool"
    A signature without a parameter list (fields, consts) is whitespace-stripped
    verbatim."""
    val s = sig.trim()
    val open = find_char_top(s, "(")
    if open < 0:
        return strip_ws(s)
    val close = matching_close(s, open)
    if close < 0:
        return strip_ws(s)
    val inner = s.slice(open + 1, close)
    val after = s.slice(close + 1)
    var ret = ""
    val arrow = find_sub(after, "->")
    if arrow >= 0:
        ret = strip_ws(after.slice(arrow + 2))
    var types: [text] = []
    if strip_ws(inner) != "":
        val parts = split_top_level(inner, ",")
        for p in parts:
            types = types.push(strip_ws(param_type_of(p)))
    val joined = types.join(",")
    if ret == "":
        "({joined})"
    else:
        "({joined})->{ret}"

fn param_type_of(p: text) -> text:
    """Strip 'name:' prefix and '= default' suffix from one parameter."""
    var body = p
    val eq = find_char_top(body, "=")
    if eq >= 0:
        body = body.slice(0, eq)
    val colon = find_char_top(body, ":")
    if colon >= 0:
        body = body.slice(colon + 1)
    body

fn strip_ws(s: text) -> text:
    val sb = string_builder()
    for i in 0..s.len():
        val ch = s.slice(i, i + 1)
        if ch != " " and ch != "\t" and ch != "\n" and ch != "\r":
            sb.push(ch)
    sb.build()

# --- top-level (bracket-depth-0) scanning helpers ---------------------------

fn is_open_bracket(ch: text) -> bool:
    ch == "(" or ch == "[" or ch == "{" or ch == "<"

fn is_close_bracket(ch: text, prev: text) -> bool:
    # ">" preceded by "-" is the arrow "->", not a closing angle bracket.
    ch == ")" or ch == "]" or ch == "}" or (ch == ">" and prev != "-")

fn find_char_top(s: text, target: text) -> i64:
    """Index of first occurrence of target at bracket depth 0, or -1."""
    var depth = 0
    var prev = ""
    for i in 0..s.len():
        val ch = s.slice(i, i + 1)
        if depth == 0 and ch == target:
            return i
        if is_open_bracket(ch):
            depth = 1 + depth
        elif is_close_bracket(ch, prev):
            depth = depth - 1
        prev = ch
    -1

fn matching_close(s: text, open: i64) -> i64:
    """Index of the ')' matching the '(' at open, or -1."""
    var depth = 0
    for i in open..s.len():
        val ch = s.slice(i, i + 1)
        if ch == "(":
            depth = 1 + depth
        elif ch == ")":
            depth = depth - 1
            if depth == 0:
                return i
    -1

fn split_top_level(s: text, sep: text) -> [text]:
    """Split on sep occurrences at bracket depth 0 (angle-aware, arrow-safe)."""
    var parts: [text] = []
    var cur = string_builder()
    var depth = 0
    var prev = ""
    for i in 0..s.len():
        val ch = s.slice(i, i + 1)
        if depth == 0 and ch == sep:
            parts = parts.push(cur.build())
            cur = string_builder()
        else:
            if is_open_bracket(ch):
                depth = 1 + depth
            elif is_close_bracket(ch, prev):
                depth = depth - 1
            cur.push(ch)
        prev = ch
    parts = parts.push(cur.build())
    parts

fn find_sub(s: text, needle: text) -> i64:
    """First index of substring needle in s, or -1. (Manual scan on purpose.)"""
    val n = needle.len()
    if n == 0 or n > s.len():
        return -1
    for i in 0..(s.len() - n + 1):
        if s.slice(i, i + n) == needle:
            return i
    -1
