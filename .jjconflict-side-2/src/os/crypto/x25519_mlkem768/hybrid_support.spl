# Shared pure-Simple byte, digest, evidence, and zeroization support.
mod os.crypto.x25519_mlkem768.hybrid_support
use lib.common.crypto.x25519_mlkem768.contract.{
    X25519MlKem768Config, X25519MlKem768Evidence,
    X25519MlKem768SimdAdmission}
use os.crypto.x25519_mlkem768.execution_policy.{
    x25519_mlkem768_resolve_simd_candidate_with_stage4_provenance}
use os.crypto.sha256.{sha256}

enum X25519MlKem768BufferError:
    NegativeStart(start: i64, length: i64)
    NegativeCount(count: i64, length: i64)
    StartPastEnd(start: i64, length: i64)
    RangePastEnd(start: i64, count: i64, length: i64)
    NonByteValue(index: i64, value: i64)

fn x25519_mlkem768_buffer_error_text(
        error: X25519MlKem768BufferError) -> text:
    match error:
        case NegativeStart(start, length):
            "negative slice start {start} for buffer length {length}"
        case NegativeCount(count, length):
            "negative slice count {count} for buffer length {length}"
        case StartPastEnd(start, length):
            "slice start {start} is past buffer length {length}"
        case RangePastEnd(start, count, length):
            "slice range start {start} count {count} exceeds buffer length {length}"
        case NonByteValue(index, value):
            "buffer value at index {index} is not a byte: {value}"

fn x25519_mlkem768_wipe_owned(values: list):
    var index: i64 = 0
    while index < values.len():
        values[index] = 0
        index = index + 1

fn x25519_mlkem768_wipe_owned_bytes(values: [u8]):
    var index: i64 = 0
    while index < values.len().to_i64():
        values[index] = 0
        index = index + 1

fn _hex_digit(value: i64) -> text:
    if value < 10: return value.to_text()
    if value == 10: "a"
    elif value == 11: "b"
    elif value == 12: "c"
    elif value == 13: "d"
    elif value == 14: "e"
    else: "f"

fn x25519_mlkem768_slice_list(values: list, start: i64,
        count: i64) -> Result<list, X25519MlKem768BufferError>:
    val length: i64 = values.len()
    if start < 0:
        return Err(X25519MlKem768BufferError.NegativeStart(start, length))
    if count < 0:
        return Err(X25519MlKem768BufferError.NegativeCount(count, length))
    if start > length:
        return Err(X25519MlKem768BufferError.StartPastEnd(start, length))
    if count > length - start:
        return Err(X25519MlKem768BufferError.RangePastEnd(
            start, count, length))
    var out: list = []
    var index: i64 = 0
    while index < count:
        out.push(values.get(start + index))
        index = index + 1
    Ok(out)

fn x25519_mlkem768_slice_bytes(values: list, start: i64,
        count: i64) -> Result<[u8], X25519MlKem768BufferError>:
    val length: i64 = values.len()
    if start < 0:
        return Err(X25519MlKem768BufferError.NegativeStart(start, length))
    if count < 0:
        return Err(X25519MlKem768BufferError.NegativeCount(count, length))
    if start > length:
        return Err(X25519MlKem768BufferError.StartPastEnd(start, length))
    if count > length - start:
        return Err(X25519MlKem768BufferError.RangePastEnd(
            start, count, length))
    var out: [u8] = []
    var index: i64 = 0
    while index < count:
        val value: i64 = values.get(start + index)
        if value < 0 or value > 255:
            return Err(X25519MlKem768BufferError.NonByteValue(
                start + index, value))
        out.push(value.to_u8())
        index = index + 1
    Ok(out)

fn x25519_mlkem768_digest(
        values: list) -> Result<text, X25519MlKem768BufferError>:
    val bytes = match x25519_mlkem768_slice_bytes(values, 0, values.len()):
        case Ok(value): value
        case Err(error): return Err(error)
    val digest = sha256(bytes)
    var out = ""
    var index: i64 = 0
    while index < digest.len().to_i64():
        val value = digest[index].to_i64()
        out = out + _hex_digit((value >> 4) & 15) + _hex_digit(value & 15)
        index = index + 1
    Ok(out)

fn x25519_mlkem768_keygen_fixture_digest(
        client_key_share: list) -> Result<text, X25519MlKem768BufferError>:
    x25519_mlkem768_digest(client_key_share)

fn x25519_mlkem768_encapsulate_fixture_digest(
        client_key_share: list) -> Result<text, X25519MlKem768BufferError>:
    x25519_mlkem768_digest(client_key_share)

fn x25519_mlkem768_decapsulate_fixture_digest(
        server_key_share: list) -> Result<text, X25519MlKem768BufferError>:
    x25519_mlkem768_digest(server_key_share)

fn x25519_mlkem768_append_bytes(out: list, bytes: [u8]) -> list:
    var joined = out
    var index: i64 = 0
    while index < bytes.len().to_i64():
        joined.push(bytes[index].to_i64())
        index = index + 1
    joined

fn x25519_mlkem768_lists_equal(left: list, right: list) -> bool:
    var difference: i64 = left.len() ^ right.len()
    val compare_length = if left.len() < right.len(): left.len() else: right.len()
    var index: i64 = 0
    while index < compare_length:
        difference = difference | (left.get(index) ^ right.get(index))
        index = index + 1
    difference == 0

fn x25519_mlkem768_bytes_valid(values: list) -> bool:
    var index: i64 = 0
    while index < values.len():
        val value = values.get(index)
        if value < 0 or value > 255: return false
        index = index + 1
    true

fn x25519_mlkem768_bytes_all_zero(values: [u8]) -> bool:
    var accumulator: i64 = 0
    var index: i64 = 0
    while index < values.len().to_i64():
        accumulator = accumulator | values[index].to_i64()
        index = index + 1
    accumulator == 0

fn x25519_mlkem768_resolve_admitted_simd(config: X25519MlKem768Config,
        admission: X25519MlKem768SimdAdmission,
        operation: text) -> Result<X25519MlKem768Evidence, text>:
    x25519_mlkem768_resolve_simd_candidate_with_stage4_provenance(
        config, operation, admission.encoded_provenance,
        admission.actual_binary_sha256, admission.actual_provenance_sha256)

export x25519_mlkem768_wipe_owned, x25519_mlkem768_wipe_owned_bytes
export X25519MlKem768BufferError, x25519_mlkem768_buffer_error_text
export x25519_mlkem768_slice_list
export x25519_mlkem768_slice_bytes, x25519_mlkem768_digest
export x25519_mlkem768_append_bytes, x25519_mlkem768_lists_equal
export x25519_mlkem768_bytes_valid, x25519_mlkem768_bytes_all_zero
export x25519_mlkem768_resolve_admitted_simd
export x25519_mlkem768_keygen_fixture_digest
export x25519_mlkem768_encapsulate_fixture_digest
export x25519_mlkem768_decapsulate_fixture_digest
