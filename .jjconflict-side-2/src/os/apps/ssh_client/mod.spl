# SimpleOS pure-Simple SSH CLIENT — module root
#
# Companion to os.apps.sshd. Only the direction-ASYMMETRIC half of SSH-2 lives
# here; everything direction-agnostic is reused from the server tree so there
# is exactly one owner of each protocol concept.
#
# REUSED FROM os.apps.sshd (no second implementation):
#   ssh_packet          — binary packet protocol, SSH string/mpint codec
#   ssh_transport       — SSH-2.0- prefix check, KEXINIT decode, algorithm
#                         negotiation, strict-KEX detection
#   ssh_kex_core        — X25519, exchange hash, session key derivation
#   ssh_kex_primitives  — SshSessionKeys, ed25519 host key blob builder
#   ssh_cipher / ssh_mac— AES-GCM and ETM MAC (wired in a later increment)
# REUSED FROM os.crypto: ed25519 (sign/verify), sha256, curve25519.
#
# NEW HERE (client-only, has no server counterpart):
#   ssh_client_version  — client banner, preamble skipping, banner hardening
#   ssh_client_kexinit  — client proposal (ext-info-c / kex-strict-c)
#   ssh_known_hosts     — host key pinning; fail-closed verification
#   ssh_client_kex      — KEX_ECDH_INIT build, KEX_ECDH_REPLY parse,
#                         host-key signature verification
#   ssh_client_auth     — SERVICE_REQUEST / USERAUTH_REQUEST build, reply parse
#   ssh_client_channel  — session channel open + exec, channel message parse
#   ssh_client_session  — socket-free client state machine

use os.apps.ssh_client.ssh_client_version.{SshClientBanner, ssh_client_version_bytes, ssh_client_version_wire, ssh_client_parse_server_banner}
use os.apps.ssh_client.ssh_client_kexinit.{ssh_client_build_kexinit, ssh_client_negotiate_from_payloads}
use os.apps.ssh_client.ssh_known_hosts.{SshKnownHostsDb, SshKnownHostEntry, ssh_known_hosts_parse, ssh_known_hosts_verify}
use os.apps.ssh_client.ssh_client_kex.{SshKexEcdhReply, SshClientKexResult, ssh_client_build_kex_ecdh_init, ssh_client_complete_kex}
use os.apps.ssh_client.ssh_client_auth.{SshAuthReply, ssh_client_build_service_request, ssh_client_build_userauth_password, ssh_client_build_userauth_publickey_ed25519, ssh_client_parse_userauth_reply}
use os.apps.ssh_client.ssh_client_channel.{SshChannelMessage, ssh_client_build_channel_open_session, ssh_client_build_exec_request, ssh_client_parse_channel_message}
use os.apps.ssh_client.ssh_client_session.{SshClientSession, SshClientConfig, ssh_client_session_new, ssh_client_session_step}
