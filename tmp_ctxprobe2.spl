use std.nogc_async_mut.mcp.main_lazy.{dispatch_tool}
use std.nogc_async_mut.mcp.lazy_protocol_schemas.{make_tools_list}
fn main() -> i64:
    print("TL=" + make_tools_list("1")[:200])
    print("TLCTX=" + str(make_tools_list("1").contains("simple_context")))
    print("TLPON=" + str(make_tools_list("1").contains("simple_ponytail")))
    print("LDC=" + dispatch_tool("lc", "simple_context", "{\"file\":\"src/lib/nogc_sync_mut/service/lease_manager.spl\"}")[:160])
    print("LDCB=" + dispatch_tool("lcb", "simple_context", "{\"file\":\"src/lib/nogc_sync_mut/service/lease_manager.spl\",\"format\":\"zz\"}")[:120])
    print("LDCJ=" + dispatch_tool("lcj", "simple_context", "{\"file\":\"src/lib/nogc_sync_mut/service/lease_manager.spl\",\"format\":\"json\"}")[:200])
    print("LDP=" + dispatch_tool("lp", "simple_ponytail", "{\"file\":\"src/lib/nogc_sync_mut/service/lease_manager.spl\"}")[:120])
    print("LDPB=" + dispatch_tool("lpb", "simple_ponytail", "{\"file\":\"src/lib/nogc_sync_mut/service/lease_manager.spl\",\"mode\":\"zz\"}")[:120])
    print("CSQL=" + handle_ctx_sql())
    0
fn handle_ctx_sql() -> text:
    "skip"
