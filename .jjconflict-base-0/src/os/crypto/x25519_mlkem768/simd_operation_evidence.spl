# Runtime-observed SIMD evidence mapping for admitted hybrid operations.

mod os.crypto.x25519_mlkem768.simd_operation_evidence

use lib.common.crypto.x25519_mlkem768.contract.{
    X25519MlKem768Backend, X25519MlKem768Evidence}
use std.simd.{MlKemNttSimdReceipt}

fn _simd_backend_from_code(code: i64) -> Result<X25519MlKem768Backend, text>:
    if code == 1:
        return Ok(X25519MlKem768Backend.Avx2)
    if code == 2:
        return Ok(X25519MlKem768Backend.Neon)
    if code == 3:
        return Ok(X25519MlKem768Backend.Rvv)
    Err("X25519MLKEM768 SIMD receipt reported an unknown backend")

fn x25519_mlkem768_simd_operation_evidence(
        evidence: X25519MlKem768Evidence,
        receipt: MlKemNttSimdReceipt
) -> Result<X25519MlKem768Evidence, text>:
    if receipt.chunk_hits < 1:
        return Err("X25519MLKEM768 SIMD operation produced no native execution receipt")
    val actual_backend = match _simd_backend_from_code(receipt.backend_code):
        case Ok(value): value
        case Err(reason): return Err(reason)
    if actual_backend != evidence.requested_backend:
        return Err("X25519MLKEM768 SIMD receipt backend does not match the admitted backend")
    if actual_backend == X25519MlKem768Backend.Rvv:
        if (receipt.observed_rvv_vlen_bits < 128 or
                receipt.observed_rvv_vlen_bits % 32 != 0):
            return Err("X25519MLKEM768 SIMD receipt reported an invalid RVV VLEN")
    elif receipt.observed_rvv_vlen_bits != 0:
        return Err("X25519MLKEM768 non-RVV receipt reported an RVV VLEN")
    var updated = evidence
    updated.selected_backend = actual_backend
    updated.kernel_invocations = 0
    updated.simd_chunk_hits = receipt.chunk_hits
    updated.observed_rvv_vlen_bits = receipt.observed_rvv_vlen_bits
    # Bind runtime-observed execution to the admitted Stage-4 artifact. The
    # public output has its own digest and must not replace provenance proof.
    updated.execution_proof_digest = updated.artifact_digest
    # SIMD admission is build provenance, not a GPU compile lifecycle event.
    updated.compiled = false
    updated.submitted = false
    updated.fence_completed = false
    updated.device_readback = false
    Ok(updated)

export x25519_mlkem768_simd_operation_evidence
