#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer InputPolynomials {
    int input_coefficients[];
};
layout(set = 0, binding = 1, std430) writeonly buffer OutputPolynomials {
    int output_coefficients[];
};
layout(set = 0, binding = 2, std430) readonly buffer ZetaTable {
    int zetas[];
};
layout(push_constant) uniform Parameters {
    uint polynomial_count;
    uint stage_count;
} parameters;

shared int stage_a[256];
shared int stage_b[256];

int modq(int value) {
    if (value < 0) {
        int magnitude = -(value + 1);
        int residue = ((magnitude % 3329) + 1) % 3329;
        return residue == 0 ? 0 : 3329 - residue;
    }
    return value % 3329;
}

void main() {
    uint polynomial = gl_WorkGroupID.x;
    if (polynomial >= parameters.polynomial_count) return;
    uint tid = gl_LocalInvocationID.x;
    uint base_offset = polynomial * 256u;
    stage_a[tid] = modq(input_coefficients[base_offset + tid]);
    barrier();

    bool current_is_a = true;
    uint stages = min(parameters.stage_count, 7u);
    for (uint stage = 0u; stage < stages; stage += 1u) {
        uint len = 2u << stage;
        uint span = len << 1u;
        if (tid < 128u) {
            uint group = tid / len;
            uint offset = tid % len;
            uint lower_tid = group * span + offset;
            uint upper_tid = lower_tid + len;
            uint zeta_top = 127u >> stage;
            int lower = current_is_a ? stage_a[lower_tid] : stage_b[lower_tid];
            int upper = current_is_a ? stage_a[upper_tid] : stage_b[upper_tid];
            int next_lower = modq(lower + upper);
            int next_upper = modq(
                zetas[zeta_top - group] * modq(upper - lower));
            if (current_is_a) {
                stage_b[lower_tid] = next_lower;
                stage_b[upper_tid] = next_upper;
            } else {
                stage_a[lower_tid] = next_lower;
                stage_a[upper_tid] = next_upper;
            }
        }
        memoryBarrierShared();
        barrier();
        current_is_a = !current_is_a;
    }
    int value = current_is_a ? stage_a[tid] : stage_b[tid];
    output_coefficients[base_offset + tid] = modq(value * 3303);
}
