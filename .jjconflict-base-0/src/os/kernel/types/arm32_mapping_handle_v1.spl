# Architecture-neutral ABI contract for an ARM32 scheduler mapping locator.
# It intentionally imports no ARM32 implementation modules.

pub(package) struct SchedulerArm32MappingHandleV1:
    slot_plus_one: u32
    handle_generation: u64

pub(package) fn scheduler_arm32_mapping_handle_absent_v1() -> SchedulerArm32MappingHandleV1:
    SchedulerArm32MappingHandleV1(slot_plus_one: 0u32, handle_generation: 0u64)

pub(package) fn scheduler_arm32_mapping_handle_present_v1(
    handle: SchedulerArm32MappingHandleV1
) -> bool:
    handle.slot_plus_one != 0u32 and handle.handle_generation != 0u64

