# x86 I/O APIC INTx routing used by PCI devices on Q35.

use os.kernel.boot.mmio.{
    mmio_read32,
    mmio_write32,
}

val IOAPIC_BASE: i64 = 0xFEC00000
val IOAPIC_REGSEL: i64 = 0x00
val IOAPIC_WINDOW: i64 = 0x10
val IOAPIC_REDTBL_BASE: i64 = 0x10
val IOAPIC_MAX_IRQ: i64 = 23

fn ioapic_intx_low_value(vector: i64, masked: bool) -> u32:
    var value = (
        (vector as u32) |
        (1u32 << 13) |  # active low
        (1u32 << 15)    # level triggered
    )
    if masked:
        value = value | (1u32 << 16)
    value

fn _ioapic_select(register: i64):
    mmio_write32((IOAPIC_BASE + IOAPIC_REGSEL) as u64, register as u32)

fn _ioapic_write(register: i64, value: u32):
    _ioapic_select(register)
    mmio_write32((IOAPIC_BASE + IOAPIC_WINDOW) as u64, value)

fn _ioapic_read(register: i64) -> u32:
    _ioapic_select(register)
    mmio_read32((IOAPIC_BASE + IOAPIC_WINDOW) as u64)

fn ioapic_route_intx(irq: i64, vector: i64) -> bool:
    if (irq < 0 or irq > IOAPIC_MAX_IRQ or
        vector < 32 or vector > 255):
        return false
    val low_register = IOAPIC_REDTBL_BASE + irq * 2
    _ioapic_write(low_register + 1, 0u32)  # physical destination: LAPIC 0
    _ioapic_write(low_register, ioapic_intx_low_value(vector, false))
    true

fn ioapic_mask_intx(irq: i64) -> bool:
    if irq < 0 or irq > IOAPIC_MAX_IRQ:
        return false
    val low_register = IOAPIC_REDTBL_BASE + irq * 2
    val current = _ioapic_read(low_register)
    _ioapic_write(low_register, current | (1u32 << 16))
    true

export IOAPIC_BASE, IOAPIC_MAX_IRQ
export ioapic_intx_low_value, ioapic_route_intx, ioapic_mask_intx
