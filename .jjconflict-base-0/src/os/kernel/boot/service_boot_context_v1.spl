"""Value-threaded authority context for production service boot.

The boot caller must treat context passage as a value-state transfer and adopt
the context returned in ServiceBootResultV1.  This module neither constructs
replacement owners nor publishes a global accessor.  Infrastructure readiness
is derived only from live owners and boot-observed authenticated media state;
it is not current-task launch admission.
"""

use os.kernel.scheduler.scheduler_types.{Scheduler}
use os.kernel.loader.executable_authority_registry.{
    ExecutableAuthorityRegistryV1, executable_authority_owner_live_v1}
use os.services.vfs.vfs_boot_state.{
    vfs_state_mount_table_owner_handle_v1,
    vfs_state_mount_table_owner_handle_is_live_v1}

pub(package) class ServiceBootContextV1:
    scheduler: Scheduler
    executable_authority: ExecutableAuthorityRegistryV1

pub(package) struct ServiceBootReadinessV1:
    storage: bool
    network: bool
    display: bool
    spm_port: bool
    canonical_vfs_owner: bool
    authenticated_media: bool
    executable_infrastructure: bool

pub(package) struct ServiceBootResultV1:
    boot: ServiceBootContextV1
    readiness: ServiceBootReadinessV1

pub(package) fn service_boot_context_create_v1(
    scheduler: Scheduler,
    executable_authority: ExecutableAuthorityRegistryV1
) -> ServiceBootContextV1:
    """Package-private value-transfer seam for existing boot authorities."""
    ServiceBootContextV1(
        scheduler: scheduler,
        executable_authority: executable_authority)

pub(package) fn service_boot_context_take_scheduler_v1(
    boot: ServiceBootContextV1
) -> Scheduler:
    """Take the Scheduler value carried by a returned boot context.

    ServiceBootContextV1 has value-transfer semantics.  A caller that passes a
    context into service initialization must adopt this returned value rather
    than continuing to mutate its pre-call Scheduler copy.
    """
    boot.scheduler

pub(package) fn service_boot_context_take_executable_authority_v1(
    boot: ServiceBootContextV1
) -> ExecutableAuthorityRegistryV1:
    """Take the executable-authority owner carried by a returned context.

    The registry value is an opaque owner coordinate, not newly minted
    authority.  Copying the coordinate does not copy or fabricate registry
    slot state; the caller must retain the returned coordinate as its owner.
    """
    boot.executable_authority

pub(package) fn service_boot_result_take_context_v1(
    result: ServiceBootResultV1
) -> ServiceBootContextV1:
    """Take the post-initialization context for explicit owner adoption."""
    result.boot

pub(package) fn service_boot_context_valid_v1(
    boot: ServiceBootContextV1
) -> bool:
    """Validate the live registry and canonical VFS owner coordinates."""
    if not executable_authority_owner_live_v1(boot.executable_authority):
        return false
    val vfs_owner = vfs_state_mount_table_owner_handle_v1()
    if not vfs_owner.?: return false
    vfs_state_mount_table_owner_handle_is_live_v1(vfs_owner.unwrap())

pub(package) fn service_boot_executable_infrastructure_ready_v1(
    boot: ServiceBootContextV1,
    canonical_vfs_owner_installed: bool,
    authenticated_media_sealed: bool
) -> bool:
    """Join boot facts without claiming current-task launch admission."""
    canonical_vfs_owner_installed and authenticated_media_sealed and
        service_boot_context_valid_v1(boot)
