# Compile-time ARM32 User-Mapping Adapter
#
# Scheduler owners bind to this architecture boundary instead of importing the
# concrete ARM32 tree. Public re-exports preserve the existing declarations;
# no runtime dispatch, allocation, copied state, or additional call is added.

pub use os.kernel.arch.arm32.user_page_table_owner_v1.{
    Arm32UserPageTableReceiptV1,
    Arm32UserPageTableStateV1,
    Arm32UserPageTableErrorV1,
    arm32_user_page_table_prepare_with_launch_v1,
    arm32_user_page_table_reserve_adoption_v1,
    arm32_user_page_table_rollback_adoption_v1,
    arm32_user_page_table_destroy_v1,
    arm32_scheduler_mapping_handle_admit_v1,
    arm32_scheduler_mapping_handle_rollback_v1,
    arm32_scheduler_mapping_handle_publish_v1,
    arm32_scheduler_mapping_handle_mark_terminal_v1,
    arm32_scheduler_mapping_handle_reap_v1,
    arm32_scheduler_mapping_entry_state_v1,
}
pub use os.kernel.arch.arm32.user_entry_state_v1.{Arm32UserEntryStateV1}
