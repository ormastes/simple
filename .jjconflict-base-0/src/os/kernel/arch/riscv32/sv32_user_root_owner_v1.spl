# RV32 Sv32 user-root lifecycle owner.
#
# This bounded capsule is the only producer of root identities and
# root-unreachable receipts. It owns root/L0 page-table frames until an exact
# detached receipt has been consumed. Data frames remain owned by the loader
# mapping capsule and are never freed here.

use os.kernel.types.memory_types.{PhysAddr, PageFrame, VmFlags}
use os.kernel.memory.pmm.{pmm_alloc_page, pmm_free_page}
use os.kernel.boot.mmio.{mmio_read32, mmio_write32}
use os.kernel.arch.riscv32.paging.{vmm_get_manager}
use std.thread_sffi.{mutex_raw_create, mutex_raw_lock, mutex_raw_unlock}

val _SV32_PAGE_SIZE_V1: u64 = 4096u64
val _SV32_ENTRY_COUNT_V1: u64 = 1024u64
val _SV32_USER_ROOT_LIMIT_V1: u64 = 512u64
val _SV32_PTE_V_V1: u32 = 1u32
val _SV32_PTE_R_V1: u32 = 2u32
val _SV32_PTE_W_V1: u32 = 4u32
val _SV32_PTE_X_V1: u32 = 8u32
val _SV32_PTE_U_V1: u32 = 16u32
val _SV32_PTE_A_V1: u32 = 64u32
val _SV32_PTE_D_V1: u32 = 128u32
val _SV32_PTE_PPN_MASK_V1: u32 = 0xFFFFFC00u32
val _SV32_PHYS_LIMIT_V1: u64 = 0x0000000400000000u64

pub struct Riscv32Sv32RootLeaseV1:
    root_id: u64
    generation: u64
    nonce: u64

pub struct Riscv32Sv32RootUnreachableReceiptV1:
    root_id: u64
    generation: u64
    nonce: u64
    detach_attempt: u64

pub struct Riscv32Sv32MapResultV1:
    ok: bool
    created_table_phys: u64
    created_root_index: u64

enum Riscv32Sv32RootStateV1:
    NeverActivated
    AdoptionReserved
    Detached
    ReleaseClaimed

struct Riscv32Sv32TableV1:
    root_index: u64
    phys: u64

struct Riscv32Sv32RootSlotV1:
    generation: u64
    nonce: u64
    state: Riscv32Sv32RootStateV1
    root_phys: u64
    detach_attempt: u64
    adoption_nonce: u64
    tables: [Riscv32Sv32TableV1]

val _sv32_root_mutex_v1: i64 = mutex_raw_create()
var _sv32_root_slots_v1: [Riscv32Sv32RootSlotV1] = []
var _sv32_root_next_generation_v1: u64 = 1u64
var _sv32_root_poisoned_v1: bool = false

pub fn riscv32_sv32_user_root_max_live_v1() -> i64:
    4

pub fn riscv32_sv32_user_mapping_request_valid_v1(
    virt: u64,
    phys: u64,
    flags: VmFlags
) -> bool:
    virt != 0u64 and virt < 0x80000000u64 and
        virt % _SV32_PAGE_SIZE_V1 == 0u64 and
        phys != 0u64 and phys % _SV32_PAGE_SIZE_V1 == 0u64 and
        phys < _SV32_PHYS_LIMIT_V1 and flags.user() and flags.present() and
        not (flags.writable() and not flags.no_execute())

fn _sv32_lock_v1() -> bool:
    if _sv32_root_poisoned_v1: return false
    _sv32_root_mutex_v1 > 0 and mutex_raw_lock(_sv32_root_mutex_v1)

fn _sv32_unlock_v1() -> bool:
    if not mutex_raw_unlock(_sv32_root_mutex_v1):
        _sv32_root_poisoned_v1 = true
        return false
    true

fn _sv32_pte_addr_v1(table: u64, index: u64) -> u64:
    table + index * 4u64

fn _sv32_read_v1(table: u64, index: u64) -> u32:
    mmio_read32(_sv32_pte_addr_v1(table, index))

fn _sv32_write_v1(table: u64, index: u64, value: u32):
    mmio_write32(_sv32_pte_addr_v1(table, index), value)

fn _sv32_zero_page_v1(phys: u64):
    var index = 0u64
    while index < _SV32_ENTRY_COUNT_V1:
        _sv32_write_v1(phys, index, 0u32)
        index = index + 1u64

fn _sv32_pte_phys_v1(pte: u32) -> u64:
    (((pte & _SV32_PTE_PPN_MASK_V1) >> 10) as u64) << 12

fn _sv32_phys_pte_v1(phys: u64) -> u32:
    (((phys >> 12) as u32) << 10)

fn _sv32_slot_index_v1(lease: Riscv32Sv32RootLeaseV1) -> i64:
    var index = 0
    while index < _sv32_root_slots_v1.len():
        val slot = _sv32_root_slots_v1[index]
        if (slot.root_phys == lease.root_id and
            slot.generation == lease.generation and slot.nonce == lease.nonce):
            return index
        index = index + 1
    -1

pub(package) fn riscv32_sv32_user_root_create_v1() -> Riscv32Sv32RootLeaseV1?:
    if not _sv32_lock_v1(): return nil
    var result: Riscv32Sv32RootLeaseV1? = nil
    if (_sv32_root_slots_v1.len() < riscv32_sv32_user_root_max_live_v1() and
        _sv32_root_next_generation_v1 != 0u64 and
        _sv32_root_next_generation_v1 != 18446744073709551615u64):
        val frame = pmm_alloc_page()
        if frame.?:
            val root = frame.unwrap().to_phys_addr().addr
            val kernel_root = vmm_get_manager().root_phys
            if (root != 0u64 and root % _SV32_PAGE_SIZE_V1 == 0u64 and
                root < _SV32_PHYS_LIMIT_V1 and
                kernel_root != 0u64 and
                kernel_root % _SV32_PAGE_SIZE_V1 == 0u64 and
                kernel_root < _SV32_PHYS_LIMIT_V1):
                _sv32_zero_page_v1(root)
                var index = _SV32_USER_ROOT_LIMIT_V1
                while index < _SV32_ENTRY_COUNT_V1:
                    _sv32_write_v1(root, index, _sv32_read_v1(kernel_root, index))
                    index = index + 1u64
                val generation = _sv32_root_next_generation_v1
                _sv32_root_next_generation_v1 = generation + 1u64
                var nonce = root ^ generation ^ 0x5256333253563332u64
                if nonce == 0u64: nonce = generation ^ 0xA55A32u64
                _sv32_root_slots_v1.push(Riscv32Sv32RootSlotV1(
                    generation: generation, nonce: nonce,
                    state: Riscv32Sv32RootStateV1.NeverActivated,
                    root_phys: root, detach_attempt: 0u64,
                    adoption_nonce: 0u64, tables: []))
                result = Some(Riscv32Sv32RootLeaseV1(
                    root_id: root, generation: generation, nonce: nonce))
            else:
                pmm_free_page(frame.unwrap())
    if not _sv32_unlock_v1(): return nil
    result

pub(package) fn riscv32_sv32_user_map_exact_v1(
    lease: Riscv32Sv32RootLeaseV1,
    virt: u64,
    phys: u64,
    flags: VmFlags
) -> Riscv32Sv32MapResultV1:
    val rejected = Riscv32Sv32MapResultV1(
        ok: false, created_table_phys: 0u64, created_root_index: 0u64)
    if not riscv32_sv32_user_mapping_request_valid_v1(virt, phys, flags):
        return rejected
    if not _sv32_lock_v1(): return rejected
    var answer = rejected
    val slot_index = _sv32_slot_index_v1(lease)
    if slot_index >= 0:
        var slot = _sv32_root_slots_v1[slot_index]
        if slot.state == Riscv32Sv32RootStateV1.NeverActivated and
            slot.adoption_nonce == 0u64:
            val root_index = (virt >> 22) & 0x3FFu64
            val leaf_index = (virt >> 12) & 0x3FFu64
            var root_pte = _sv32_read_v1(slot.root_phys, root_index)
            var leaf_table = 0u64
            var created = 0u64
            if (root_pte & _SV32_PTE_V_V1) == 0u32:
                val table_frame = pmm_alloc_page()
                if table_frame.?:
                    leaf_table = table_frame.unwrap().to_phys_addr().addr
                    if (leaf_table != 0u64 and
                        leaf_table % _SV32_PAGE_SIZE_V1 == 0u64 and
                        leaf_table < _SV32_PHYS_LIMIT_V1):
                        _sv32_zero_page_v1(leaf_table)
                        root_pte = _sv32_phys_pte_v1(leaf_table) | _SV32_PTE_V_V1
                        _sv32_write_v1(slot.root_phys, root_index, root_pte)
                        slot.tables.push(Riscv32Sv32TableV1(
                            root_index: root_index, phys: leaf_table))
                        created = leaf_table
                    else:
                        pmm_free_page(table_frame.unwrap())
            elif (root_pte & (_SV32_PTE_R_V1 | _SV32_PTE_W_V1 | _SV32_PTE_X_V1)) == 0u32:
                leaf_table = _sv32_pte_phys_v1(root_pte)
            if leaf_table != 0u64 and _sv32_read_v1(leaf_table, leaf_index) == 0u32:
                var bits = _SV32_PTE_V_V1 | _SV32_PTE_U_V1 | _SV32_PTE_A_V1
                if flags.writable():
                    bits = bits | _SV32_PTE_R_V1 | _SV32_PTE_W_V1 | _SV32_PTE_D_V1
                elif flags.no_execute():
                    bits = bits | _SV32_PTE_R_V1
                else:
                    bits = bits | _SV32_PTE_R_V1 | _SV32_PTE_X_V1
                _sv32_write_v1(leaf_table, leaf_index, _sv32_phys_pte_v1(phys) | bits)
                _sv32_root_slots_v1[slot_index] = slot
                answer = Riscv32Sv32MapResultV1(
                    ok: true, created_table_phys: created,
                    created_root_index: root_index)
    if not _sv32_unlock_v1(): return rejected
    answer

pub(package) fn riscv32_sv32_user_unmap_exact_v1(
    lease: Riscv32Sv32RootLeaseV1,
    virt: u64,
    expected_phys: u64
) -> bool:
    if not _sv32_lock_v1(): return false
    var ok = false
    val index = _sv32_slot_index_v1(lease)
    if index >= 0:
        val slot = _sv32_root_slots_v1[index]
        if slot.state == Riscv32Sv32RootStateV1.NeverActivated and
            slot.adoption_nonce == 0u64:
            val root_index = (virt >> 22) & 0x3FFu64
            val root_pte = _sv32_read_v1(slot.root_phys, root_index)
            if ((root_pte & _SV32_PTE_V_V1) != 0u32 and
                (root_pte & (_SV32_PTE_R_V1 | _SV32_PTE_W_V1 | _SV32_PTE_X_V1)) == 0u32):
                val table = _sv32_pte_phys_v1(root_pte)
                val leaf_index = (virt >> 12) & 0x3FFu64
                val leaf = _sv32_read_v1(table, leaf_index)
                if ((leaf & _SV32_PTE_V_V1) != 0u32 and
                    _sv32_pte_phys_v1(leaf) == expected_phys):
                    _sv32_write_v1(table, leaf_index, 0u32)
                    ok = true
    if not _sv32_unlock_v1(): return false
    ok

pub(package) fn riscv32_sv32_user_root_detach_v1(
    lease: Riscv32Sv32RootLeaseV1
) -> Riscv32Sv32RootUnreachableReceiptV1?:
    if not _sv32_lock_v1(): return nil
    var receipt: Riscv32Sv32RootUnreachableReceiptV1? = nil
    val index = _sv32_slot_index_v1(lease)
    if index >= 0:
        var slot = _sv32_root_slots_v1[index]
        if slot.state == Riscv32Sv32RootStateV1.Detached:
            receipt = Some(Riscv32Sv32RootUnreachableReceiptV1(
                root_id: slot.root_phys, generation: slot.generation,
                nonce: slot.nonce, detach_attempt: slot.detach_attempt))
        elif slot.state == Riscv32Sv32RootStateV1.NeverActivated and
            slot.adoption_nonce == 0u64:
            var exact = true
            var table_index = 0
            while table_index < slot.tables.len():
                val table = slot.tables[table_index]
                if (_sv32_read_v1(slot.root_phys, table.root_index) !=
                    (_sv32_phys_pte_v1(table.phys) | _SV32_PTE_V_V1)):
                    exact = false
                var leaf_index = 0u64
                while leaf_index < _SV32_ENTRY_COUNT_V1:
                    if _sv32_read_v1(table.phys, leaf_index) != 0u32: exact = false
                    leaf_index = leaf_index + 1u64
                table_index = table_index + 1
            var root_index = 0u64
            while root_index < _SV32_USER_ROOT_LIMIT_V1:
                val pte = _sv32_read_v1(slot.root_phys, root_index)
                if pte != 0u32:
                    var owned = false
                    for table in slot.tables:
                        if table.root_index == root_index and
                            pte == (_sv32_phys_pte_v1(table.phys) | _SV32_PTE_V_V1):
                            owned = true
                    if not owned: exact = false
                root_index = root_index + 1u64
            if exact and slot.detach_attempt != 18446744073709551615u64:
                for table in slot.tables:
                    _sv32_write_v1(slot.root_phys, table.root_index, 0u32)
                slot.detach_attempt = slot.detach_attempt + 1u64
                slot.state = Riscv32Sv32RootStateV1.Detached
                _sv32_root_slots_v1[index] = slot
                receipt = Some(Riscv32Sv32RootUnreachableReceiptV1(
                    root_id: slot.root_phys, generation: slot.generation,
                    nonce: slot.nonce, detach_attempt: slot.detach_attempt))
    if not _sv32_unlock_v1(): return nil
    receipt

pub(package) fn riscv32_sv32_root_unreachable_claim_v1(
    receipt: Riscv32Sv32RootUnreachableReceiptV1,
    root_id: u64,
    generation: u64
) -> bool:
    if not _sv32_lock_v1(): return false
    var matches = false
    val lease = Riscv32Sv32RootLeaseV1(
        root_id: receipt.root_id, generation: receipt.generation,
        nonce: receipt.nonce)
    val index = _sv32_slot_index_v1(lease)
    if index >= 0:
        var slot = _sv32_root_slots_v1[index]
        matches = ((slot.state == Riscv32Sv32RootStateV1.Detached or
                slot.state == Riscv32Sv32RootStateV1.ReleaseClaimed) and
            slot.root_phys == root_id and slot.generation == generation and
            slot.detach_attempt == receipt.detach_attempt and
            receipt.detach_attempt != 0u64)
        if matches and slot.state == Riscv32Sv32RootStateV1.Detached:
            # Claiming under the architecture mutex prevents a concurrent
            # package peer from freeing the root between registry validation
            # and the registry's canonical state transition.
            slot.state = Riscv32Sv32RootStateV1.ReleaseClaimed
            _sv32_root_slots_v1[index] = slot
    if not _sv32_unlock_v1(): return false
    matches

pub(package) fn riscv32_sv32_user_root_release_detached_v1(
    receipt: Riscv32Sv32RootUnreachableReceiptV1
) -> bool:
    if not _sv32_lock_v1(): return false
    var ok = false
    val lease = Riscv32Sv32RootLeaseV1(
        root_id: receipt.root_id, generation: receipt.generation,
        nonce: receipt.nonce)
    val index = _sv32_slot_index_v1(lease)
    if index >= 0:
        val slot = _sv32_root_slots_v1[index]
        if (slot.state == Riscv32Sv32RootStateV1.ReleaseClaimed and
            slot.detach_attempt == receipt.detach_attempt):
            for table in slot.tables:
                pmm_free_page(PageFrame.from_phys_addr(PhysAddr(addr: table.phys)))
            pmm_free_page(PageFrame.from_phys_addr(PhysAddr(addr: slot.root_phys)))
            _sv32_root_slots_v1.remove(index)
            ok = true
    if not _sv32_unlock_v1(): return false
    ok

pub(package) fn riscv32_sv32_user_root_abort_fresh_v1(
    lease: Riscv32Sv32RootLeaseV1
) -> bool:
    """Release a create-issued root that was never bound or mapped."""
    if not _sv32_lock_v1(): return false
    var ok = false
    val index = _sv32_slot_index_v1(lease)
    if index >= 0:
        val slot = _sv32_root_slots_v1[index]
        var empty = slot.state == Riscv32Sv32RootStateV1.NeverActivated and
            slot.adoption_nonce == 0u64 and slot.tables.len() == 0
        var root_index = 0u64
        while root_index < _SV32_USER_ROOT_LIMIT_V1:
            if _sv32_read_v1(slot.root_phys, root_index) != 0u32: empty = false
            root_index = root_index + 1u64
        if empty:
            pmm_free_page(PageFrame.from_phys_addr(
                PhysAddr(addr: slot.root_phys)))
            _sv32_root_slots_v1.remove(index)
            ok = true
    if not _sv32_unlock_v1(): return false
    ok

export Riscv32Sv32RootLeaseV1
export Riscv32Sv32RootUnreachableReceiptV1
export Riscv32Sv32MapResultV1
export riscv32_sv32_user_root_max_live_v1
export riscv32_sv32_user_mapping_request_valid_v1
export riscv32_sv32_user_root_create_v1
export riscv32_sv32_user_map_exact_v1
export riscv32_sv32_user_unmap_exact_v1
export riscv32_sv32_user_root_detach_v1
export riscv32_sv32_root_unreachable_claim_v1
export riscv32_sv32_user_root_release_detached_v1
export riscv32_sv32_user_root_abort_fresh_v1
