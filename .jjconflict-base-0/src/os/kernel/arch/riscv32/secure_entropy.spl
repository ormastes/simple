# RV32 privilege-transition key entropy admission.
#
# This owner validates provider output and provenance. The current platform has
# neither a virtio-rng driver nor an authenticated boot injection and therefore
# remains unavailable. The early timer/metadata mixer is intentionally absent.

val RV32_SECURE_ENTROPY_BYTES: u64 = 16

enum Rv32SecureEntropyProvenance:
    Unavailable
    VirtioRngMmio
    AuthenticatedBootInjection

struct Rv32SecureEntropyCandidate:
    provenance: Rv32SecureEntropyProvenance
    capability_present: bool
    provider_ready: bool
    authenticated_handoff: bool
    bytes: [u8]

struct Rv32SecureEntropyReceipt:
    provenance: Rv32SecureEntropyProvenance
    bytes: [u8]

fn _rv32_entropy_wipe(bytes: [u8]):
    var i: u64 = 0
    while i < bytes.len():
        bytes[i] = 0u8
        i = i + 1

fn _rv32_entropy_all_zero(bytes: [u8]) -> bool:
    var aggregate: u8 = 0u8
    var i: u64 = 0
    while i < bytes.len():
        aggregate = aggregate | bytes[i]
        i = i + 1
    aggregate == 0u8

fn rv32_admit_secure_entropy_candidate(
    candidate: Rv32SecureEntropyCandidate
) -> Result<Rv32SecureEntropyReceipt, text>:
    var bytes = candidate.bytes
    if not candidate.capability_present or not candidate.provider_ready:
        _rv32_entropy_wipe(bytes)
        return Err("rv32 secure entropy provider unavailable")
    match candidate.provenance:
        case Rv32SecureEntropyProvenance.VirtioRngMmio:
            pass_do_nothing
        case Rv32SecureEntropyProvenance.AuthenticatedBootInjection:
            if not candidate.authenticated_handoff:
                _rv32_entropy_wipe(bytes)
                return Err("rv32 boot entropy handoff is not authenticated")
        case Rv32SecureEntropyProvenance.Unavailable:
            _rv32_entropy_wipe(bytes)
            return Err("rv32 secure entropy provenance unavailable")
    if bytes.len() != RV32_SECURE_ENTROPY_BYTES:
        _rv32_entropy_wipe(bytes)
        return Err("rv32 secure entropy provider returned wrong length")
    if _rv32_entropy_all_zero(bytes):
        _rv32_entropy_wipe(bytes)
        return Err("rv32 secure entropy provider returned all-zero key")
    Ok(Rv32SecureEntropyReceipt(
        provenance: candidate.provenance,
        bytes: bytes
    ))

fn rv32_current_secure_entropy() -> Result<Rv32SecureEntropyReceipt, text>:
    """Fail closed until a canonical RV32 provider installs one capability."""
    rv32_admit_secure_entropy_candidate(Rv32SecureEntropyCandidate(
        provenance: Rv32SecureEntropyProvenance.Unavailable,
        capability_present: false,
        provider_ready: false,
        authenticated_handoff: false,
        bytes: []
    ))

export Rv32SecureEntropyProvenance, Rv32SecureEntropyCandidate
export Rv32SecureEntropyReceipt, rv32_admit_secure_entropy_candidate
export rv32_current_secure_entropy, RV32_SECURE_ENTROPY_BYTES
