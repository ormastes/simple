# Trusted x86-64 CR3 write/readback adapter for the scheduler switch owner.

use os.kernel.arch.x86_64.cpu.{X86Cpu}
use os.kernel.scheduler.architecture_switch_completion_owner_v1.{
    ArchitectureSwitchTicketV1, ArchitectureSwitchReadbackReceiptV1,
    architecture_switch_mark_write_started_v1,
    architecture_switch_x86_cr3_receipt_v1
}

pub(package) fn x86_64_switch_root_with_receipt_v1(
    ticket: ArchitectureSwitchTicketV1,
    root_phys: u64
) -> ArchitectureSwitchReadbackReceiptV1:
    val preflight = architecture_switch_x86_cr3_receipt_v1(
        ticket, root_phys, root_phys, 64u64, true)
    if not preflight.readback_matches: return preflight
    var cpu = X86Cpu()
    if cpu.cpu_id() != ticket.cpu_id:
        return architecture_switch_x86_cr3_receipt_v1(
            ticket, root_phys, 0u64, 64u64, false)
    cpu.cpu_disable_interrupts()
    if cpu.cpu_id() != ticket.cpu_id:
        return architecture_switch_x86_cr3_receipt_v1(
            ticket, root_phys, 0u64, 64u64, false)
    if not architecture_switch_mark_write_started_v1(ticket):
        return architecture_switch_x86_cr3_receipt_v1(
            ticket, root_phys, 0u64, 64u64, false)
    cpu.cpu_write_page_table_base(root_phys)
    val observed = cpu.cpu_read_page_table_base()
    architecture_switch_x86_cr3_receipt_v1(
        ticket, root_phys, observed, 64u64, true)
