# Pure-Simple Cosmos+ freestanding memory/division core.
#
# C retains the public libc and ARM EABI names. These exports are the narrow
# internal ABI behind those shims. The mutable coverage word records actual
# production decisions; the host oracle can only reset/read it.

val COSMOS_RUNTIME_CORE_DECISIONS: u64 = 13u64
val COSMOS_RUNTIME_CORE_OUTCOMES_REQUIRED: u64 = 0x03FFFFFFu64

# Closed audit of the 13 semantic decision sites (two outcomes per site).
val D_COPY_DST_NULL: u32 = 0u32
val D_COPY_SRC_NULL: u32 = 1u32
val D_COPY_HAS_BYTE: u32 = 2u32
val D_FILL_DST_NULL: u32 = 3u32
val D_FILL_HAS_BYTE: u32 = 4u32
val D_UDIV_OUTPUT_NULL: u32 = 5u32
val D_UDIV_DENOMINATOR_ZERO: u32 = 6u32
val D_UDIV_NUMERATOR_SMALLER: u32 = 7u32
val D_UDIV_HAS_BIT: u32 = 8u32
val D_UDIV_SUBTRACT: u32 = 9u32
val D_UNSIGNED_DIV0_ZERO: u32 = 10u32
val D_SIGNED_DIV0_POSITIVE: u32 = 11u32
val D_SIGNED_DIV0_NEGATIVE: u32 = 12u32

var g_cosmos_runtime_core_outcomes: u32 = 0u32

fn _runtime_core_coverage_record(decision_id: u32, result: bool):
    val outcome_id = decision_id * 2u32 + (result as u32)
    g_cosmos_runtime_core_outcomes =
        g_cosmos_runtime_core_outcomes | (1u32 << outcome_id)

@export("C", name: "cosmos_runtime_core_coverage_reset")
pub fn cosmos_runtime_core_coverage_reset():
    g_cosmos_runtime_core_outcomes = 0u32

@export("C", name: "cosmos_runtime_core_coverage_mask")
pub fn cosmos_runtime_core_coverage_mask() -> u64:
    g_cosmos_runtime_core_outcomes as u64

@export("C", name: "cosmos_runtime_core_coverage_required")
pub fn cosmos_runtime_core_coverage_required() -> u64:
    COSMOS_RUNTIME_CORE_OUTCOMES_REQUIRED

@export("C", name: "cosmos_runtime_core_coverage_decisions")
pub fn cosmos_runtime_core_coverage_decisions() -> u64:
    COSMOS_RUNTIME_CORE_DECISIONS

@export("C", name: "cosmos_runtime_core_copy")
pub fn cosmos_runtime_core_copy(
    dst: *mut u8, src: *const u8, size: u32
) -> *mut u8:
    val dst_is_null = (dst as u64) == 0u64
    _runtime_core_coverage_record(D_COPY_DST_NULL, dst_is_null)
    if dst_is_null:
        return dst

    val src_is_null = (src as u64) == 0u64
    _runtime_core_coverage_record(D_COPY_SRC_NULL, src_is_null)
    if src_is_null:
        return dst

    var index = 0u32
    while true:
        val has_byte = index < size
        _runtime_core_coverage_record(D_COPY_HAS_BYTE, has_byte)
        if not has_byte:
            break
        danger:
            val byte = src.offset(index as isize).read()
            dst.offset(index as isize).write(byte)
        index = index + 1u32
    dst

@export("C", name: "cosmos_runtime_core_fill")
pub fn cosmos_runtime_core_fill(
    dst: *mut u8, value: i32, size: u32
) -> *mut u8:
    val dst_is_null = (dst as u64) == 0u64
    _runtime_core_coverage_record(D_FILL_DST_NULL, dst_is_null)
    if dst_is_null:
        return dst

    val byte = value as u8
    var index = 0u32
    while true:
        val has_byte = index < size
        _runtime_core_coverage_record(D_FILL_HAS_BYTE, has_byte)
        if not has_byte:
            break
        danger:
            dst.offset(index as isize).write(byte)
        index = index + 1u32
    dst

@export("C", name: "cosmos_runtime_core_udivmod")
pub fn cosmos_runtime_core_udivmod(
    numerator: u32,
    denominator: u32,
    quotient: *mut u32,
    remainder: *mut u32
) -> i32:
    val output_is_null =
        (quotient as u64) == 0u64 or (remainder as u64) == 0u64
    _runtime_core_coverage_record(D_UDIV_OUTPUT_NULL, output_is_null)
    if output_is_null:
        return 0

    val denominator_is_zero = denominator == 0u32
    _runtime_core_coverage_record(D_UDIV_DENOMINATOR_ZERO, denominator_is_zero)
    if denominator_is_zero:
        return 0

    val numerator_is_smaller = numerator < denominator
    _runtime_core_coverage_record(D_UDIV_NUMERATOR_SMALLER, numerator_is_smaller)
    if numerator_is_smaller:
        danger:
            quotient.write(0u32)
            remainder.write(numerator)
        return 1

    var quotient_value = 0u32
    var remainder_value = 0u32
    var bit_index = 32u32
    while true:
        val has_bit = bit_index != 0u32
        _runtime_core_coverage_record(D_UDIV_HAS_BIT, has_bit)
        if not has_bit:
            break
        bit_index = bit_index - 1u32
        remainder_value =
            (remainder_value << 1u32) |
            ((numerator >> bit_index) & 1u32)
        val subtract_denominator = remainder_value >= denominator
        _runtime_core_coverage_record(D_UDIV_SUBTRACT, subtract_denominator)
        if subtract_denominator:
            remainder_value = remainder_value - denominator
            quotient_value = quotient_value | (1u32 << bit_index)

    danger:
        quotient.write(quotient_value)
        remainder.write(remainder_value)
    1

@export("C", name: "cosmos_runtime_core_unsigned_div0_value")
pub fn cosmos_runtime_core_unsigned_div0_value(numerator: u32) -> u32:
    val numerator_is_zero = numerator == 0u32
    _runtime_core_coverage_record(D_UNSIGNED_DIV0_ZERO, numerator_is_zero)
    if numerator_is_zero:
        return 0u32
    0xFFFFFFFFu32

@export("C", name: "cosmos_runtime_core_signed_div0_value")
pub fn cosmos_runtime_core_signed_div0_value(numerator: i32) -> i32:
    val numerator_is_positive = numerator > 0
    _runtime_core_coverage_record(D_SIGNED_DIV0_POSITIVE, numerator_is_positive)
    if numerator_is_positive:
        return 0x7FFFFFFFu32 as i32

    val numerator_is_negative = numerator < 0
    _runtime_core_coverage_record(D_SIGNED_DIV0_NEGATIVE, numerator_is_negative)
    if numerator_is_negative:
        return 0x80000000u32 as i32
    0
