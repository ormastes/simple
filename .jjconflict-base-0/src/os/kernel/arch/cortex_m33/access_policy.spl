# codex-impl
# Shared Cortex-M shell MMIO access policy for M33/PMSAv8-M and M4/PMSAv7-M.
#
# The C shim still acquires the address text, performs the volatile access, and
# writes UART diagnostics.  Alignment and region validation live here so every
# board uses one pure-Simple policy owner.

const CORTEX_M_ACCESS_OK: u32 = 0
const CORTEX_M_ACCESS_UNALIGNED: u32 = 1
const CORTEX_M_ACCESS_UNREADABLE: u32 = 2
const CORTEX_M_ACCESS_UNWRITABLE: u32 = 3

const CORTEX_M_READ_DECISION_UNALIGNED: u32 = 1
const CORTEX_M_READ_DECISION_FLASH: u32 = 2
const CORTEX_M_READ_DECISION_RAM: u32 = 4
const CORTEX_M_READ_DECISION_PERIPHERAL: u32 = 8
const CORTEX_M_READ_DECISION_PPB: u32 = 16
const CORTEX_M_READ_DECISION_REJECTED: u32 = 32
const CORTEX_M_WRITE_DECISION_UNALIGNED: u32 = 64
const CORTEX_M_WRITE_DECISION_RAM: u32 = 128
const CORTEX_M_WRITE_DECISION_PERIPHERAL: u32 = 256
const CORTEX_M_WRITE_DECISION_REJECTED: u32 = 512

const CORTEX_M_ACCESS_OUTCOME_MASK: u32 = 255
const CORTEX_M_ACCESS_DECISION_SHIFT: u32 = 8

fn _cortex_m_policy_receipt(outcome: u32, decision_mask: u32) -> u32:
    (decision_mask << CORTEX_M_ACCESS_DECISION_SHIFT) | outcome

fn _cortex_m_in_region(addr: u32, base: u32, size: u32) -> bool:
    addr >= base and addr < base + size

fn cortex_m_policy_receipt_outcome(receipt: u32) -> u32:
    receipt & CORTEX_M_ACCESS_OUTCOME_MASK

fn cortex_m_policy_receipt_decision_mask(receipt: u32) -> u32:
    receipt >> CORTEX_M_ACCESS_DECISION_SHIFT

@export("C")
fn cortex_m_policy_read_receipt(
    addr: u32,
    flash_base: u32,
    flash_size: u32,
    ram_base: u32,
    ram_size: u32
) -> u32:
    if (addr & 3) != 0:  # CORTEX-M-ACCESS-D01
        return _cortex_m_policy_receipt(CORTEX_M_ACCESS_UNALIGNED, CORTEX_M_READ_DECISION_UNALIGNED)
    if _cortex_m_in_region(addr: addr, base: flash_base, size: flash_size):  # CORTEX-M-ACCESS-D02
        return _cortex_m_policy_receipt(CORTEX_M_ACCESS_OK, CORTEX_M_READ_DECISION_FLASH)
    if _cortex_m_in_region(addr: addr, base: ram_base, size: ram_size):  # CORTEX-M-ACCESS-D03
        return _cortex_m_policy_receipt(CORTEX_M_ACCESS_OK, CORTEX_M_READ_DECISION_RAM)
    if addr >= 0x40000000 and addr < 0x60000000:  # CORTEX-M-ACCESS-D04
        return _cortex_m_policy_receipt(CORTEX_M_ACCESS_OK, CORTEX_M_READ_DECISION_PERIPHERAL)
    if addr >= 0xE000E000 and addr < 0xE0100000:  # CORTEX-M-ACCESS-D05
        return _cortex_m_policy_receipt(CORTEX_M_ACCESS_OK, CORTEX_M_READ_DECISION_PPB)
    _cortex_m_policy_receipt(CORTEX_M_ACCESS_UNREADABLE, CORTEX_M_READ_DECISION_REJECTED)

@export("C")
fn cortex_m_policy_write_receipt(addr: u32, ram_base: u32, ram_size: u32) -> u32:
    if (addr & 3) != 0:  # CORTEX-M-ACCESS-D06
        return _cortex_m_policy_receipt(CORTEX_M_ACCESS_UNALIGNED, CORTEX_M_WRITE_DECISION_UNALIGNED)
    if _cortex_m_in_region(addr: addr, base: ram_base, size: ram_size):  # CORTEX-M-ACCESS-D07
        return _cortex_m_policy_receipt(CORTEX_M_ACCESS_OK, CORTEX_M_WRITE_DECISION_RAM)
    if addr >= 0x40000000 and addr < 0x60000000:  # CORTEX-M-ACCESS-D08
        return _cortex_m_policy_receipt(CORTEX_M_ACCESS_OK, CORTEX_M_WRITE_DECISION_PERIPHERAL)
    _cortex_m_policy_receipt(CORTEX_M_ACCESS_UNWRITABLE, CORTEX_M_WRITE_DECISION_REJECTED)
