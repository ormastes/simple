"""x86_64 pinned-root adapter for the native SCR2 catalog."""

use os.kernel.loader.authenticated_media_parser.{authenticated_media_hex_bytes_v1}
use os.kernel.loader.executable_manifest_signature_verifier.{ExecutableManifestTrustedSignerV1}
use os.kernel.loader.scr2_native_catalog_policy_v1.{
    Scr2NativeCatalogLocalAdmissionV1, scr2_native_catalog_authenticate_x86_64_v1
}
use x86_64_auth_trust_config.{
    x86_64_authenticated_pinned_key_id_v1,
    x86_64_authenticated_pinned_public_key_hex_v1
}

pub fn x86_64_scr2_native_catalog_authenticate_v1(catalog_bytes: [u8],
    receipt_bytes: [u8]) -> Scr2NativeCatalogLocalAdmissionV1:
    scr2_native_catalog_authenticate_x86_64_v1(catalog_bytes, receipt_bytes,
        ExecutableManifestTrustedSignerV1(
            key_id: x86_64_authenticated_pinned_key_id_v1(),
            public_key: authenticated_media_hex_bytes_v1(
                x86_64_authenticated_pinned_public_key_hex_v1())))
