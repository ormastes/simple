# x86_64 filesystem-exec compatibility facade.
#
# A path, resident byte buffer, or FAT stream is not execution authority. All
# production entrypoints converge on the authenticated filesystem gate. The
# loader-owned registry/token/consumer route is exposed by
# fs_exec_adopt_authenticated_v1; this facade intentionally cannot mint or
# reconstruct those values and therefore fails closed for path-only callers.

use os.kernel.loader.fs_exec_spawn.{fs_exec_spawn_as}
use os.kernel.loader.fs_exec_spawn.{fs_exec_adopt_authenticated_v1}
use std.fs_driver.mount_table.{MountTable}
use os.kernel.loader.executable_authority_registry.{ExecutableAuthorityRegistryV1, ExecutableAuthorityTokenV1}
use os.kernel.loader.executable_load_plan_v1.{ExecutableLoadConsumerV1}
use os.kernel.scheduler.scheduler_types.{Scheduler}
use os.kernel.arch.arch_context.{Architecture}
use os.kernel.arch.user_entry_bridge.{dispatch_fs_exec_user_handoff}
use os.kernel.types.task_types.{TaskId}
use os.kernel.scheduler.scheduler.{wait_collect_result_error, wait_collect_result_status}

pub fn x86_64_fs_exec_handoff_blob_ready(byte_len: i64, raw_blob: u64) -> bool:
    # Retained as a pure diagnostic predicate for older evidence readers. It no
    # longer authorizes or triggers a ring-3 handoff.
    byte_len > 4 and raw_blob != 0.to_u64()

pub fn x86_64_fs_exec_spawn(path: text, argv: [text], envp: [text]) -> i64:
    """Reject path-only kernel execution through the canonical auth gate."""
    x86_64_fs_exec_spawn_as(0, path, argv, envp)

pub fn x86_64_fs_exec_spawn_scheduler_owned(
    path: text,
    argv: [text],
    envp: [text]
) -> i64:
    """Compatibility name; scheduler ownership still requires loader authority."""
    fs_exec_spawn_as(0, path, argv, envp)

pub fn x86_64_fs_exec_spawn_authenticated_v1(
    scheduler: Scheduler,
    table: MountTable,
    authorities: ExecutableAuthorityRegistryV1,
    token: ExecutableAuthorityTokenV1,
    consumer: ExecutableLoadConsumerV1,
    entry_point: u64,
    caller: i64,
    path: text,
    recipe: i64
) -> i64:
    """Consume loader authority, enter CPL3, and reap the exact child once."""
    val prepared = fs_exec_adopt_authenticated_v1(
        scheduler, table, authorities, token, consumer, entry_point,
        caller, path, recipe)
    if prepared.pid <= 0:
        return prepared.pid
    val child = TaskId(id: prepared.pid.to_u64())
    val exit_code = dispatch_fs_exec_user_handoff(
        Architecture.X86_64, child.id, prepared.scheduler)
    var owner = prepared.scheduler
    owner.exit_task_by_id(child, exit_code.to_i32())
    val collected = owner.wait_for_collect(TaskId(id: 0u64), child, false)
    if wait_collect_result_error(collected) != 0 or
       wait_collect_result_status(collected) != exit_code.to_i32():
        return -10
    exit_code

pub fn x86_64_fs_exec_spawn_as(
    caller: i64,
    path: text,
    argv: [text],
    envp: [text]
) -> i64:
    """Reject path-only x86 execution; authenticated adoption is mandatory."""
    fs_exec_spawn_as(caller, path, argv, envp)

pub fn x86_64_fs_exec_spawn_heap(
    path: text,
    argv: [text],
    envp: [text]
) -> i64:
    """Reject the former unauthenticated streaming-heap handoff."""
    fs_exec_spawn_as(0, path, argv, envp)

fn x86_64_fs_exec_spawn_hello_world_smf() -> i64:
    """Backward-compatible path-only request; expected to fail closed."""
    x86_64_fs_exec_spawn("/SYS/APPS/HELLOSMF.SMF", [], [])
