pub fn x86_64_authenticated_media_root_matches_pin_v1(
    pinned_key_id: text, pinned_public_key_hex: text, pinned_hash: text,
    media_key_id: text, media_public_key_hex: text, admission_hash: text
) -> bool:
    pinned_key_id != "" and pinned_public_key_hex.len() == 64 and
    pinned_hash.len() == 64 and media_key_id == pinned_key_id and
    media_public_key_hex == pinned_public_key_hex and admission_hash == pinned_hash

export x86_64_authenticated_media_root_matches_pin_v1
