"""Shared terminal collection contract for filesystem execution."""

use os.kernel.scheduler.scheduler_types.{WaitCollectResult}
use os.kernel.scheduler.scheduler.{
    wait_collect_result_error, wait_collect_result_pid,
    wait_collect_result_status
}

pub fn fs_exec_terminal_status_matches_v1(
    collected: WaitCollectResult,
    child_id: u64,
    exit_code: i64
) -> bool:
    """Accept only the exact child/status pair from a successful collection."""
    (child_id != 0u64 and
        wait_collect_result_error(collected) == 0 and
        wait_collect_result_pid(collected) == child_id and
        wait_collect_result_status(collected) == exit_code.to_i32())

export fs_exec_terminal_status_matches_v1
