"""Static ownership coverage for the interrupt-quiescence lease capsule.

# @manual: primary
REQ-SIMPLEOS-CPU-IRQ-QUIESCENCE-LEASE-V1
"""

use std.spec.{describe, it, expect}
use std.spec.step
use os.kernel.smp.cpu_topology_identity_owner_v1.{
    CpuHardwareIdentityKindV1, CpuTopologyIdentityOwnerV1,
}
use os.kernel.smp.cpu_interrupt_quiescence_lease_v1.{
    CpuInterruptQuiescenceOwnerV1,
}

fn x86_owner_v1() -> CpuInterruptQuiescenceOwnerV1:
    var topology = CpuTopologyIdentityOwnerV1.create(
        CpuHardwareIdentityKindV1.X86Apic)
    topology.register_x86_apic(0u32, 7u32)
    topology.register_x86_apic(1u32, 9u32)
    CpuInterruptQuiescenceOwnerV1.create(topology.seal().snapshot).unwrap()

describe "CPU interrupt-quiescence lease ownership":
    it "restores the exact prior enabled state and recycles only after readback":
        step("Reserve the exact boot-sealed CPU identity")
        val owner = x86_owner_v1()
        val admitted = owner.reserve_from_architecture_v1(
            0u32, CpuHardwareIdentityKindV1.X86Apic, 7u64)
        expect(admitted.ok).to_equal(true)
        val lease = admitted.lease.unwrap()

        step("Publish save-disable and a same-CPU completion")
        expect(owner.publish_disabled_from_architecture_v1(
            lease, true, true)).to_equal(true)
        expect(owner.complete_from_architecture_v1(
            lease, 0u32, CpuHardwareIdentityKindV1.X86Apic,
            7u64, true)).to_equal(true)

        step("Consume one restore permit and confirm restored IRQ state")
        val restore = owner.redeem_restore_from_architecture_v1(lease, true)
        expect(restore.ok).to_equal(true)
        val receipt = owner.finish_restore_from_architecture_v1(
            restore.permit.unwrap(), 0u32,
            CpuHardwareIdentityKindV1.X86Apic, 7u64, true)
        expect(receipt.ok).to_equal(true)
        expect(receipt.prior_interrupts_enabled).to_equal(true)
        expect(owner.slot_is_idle(0u32)).to_equal(true)

    it "rejects identity aliases overlapping leases and replay":
        step("Reject a hardware identity not present in the sealed topology")
        val owner = x86_owner_v1()
        expect(owner.reserve_from_architecture_v1(
            0u32, CpuHardwareIdentityKindV1.X86Apic, 8u64).ok).to_equal(false)

        step("Retain one slot until its exact restore is observed")
        val first = owner.reserve_from_architecture_v1(
            0u32, CpuHardwareIdentityKindV1.X86Apic, 7u64).lease.unwrap()
        expect(owner.reserve_from_architecture_v1(
            0u32, CpuHardwareIdentityKindV1.X86Apic, 7u64).ok).to_equal(false)
        expect(owner.publish_disabled_from_architecture_v1(
            first, false, true)).to_equal(true)
        expect(owner.publish_disabled_from_architecture_v1(
            first, true, true)).to_equal(false)
        expect(owner.complete_from_architecture_v1(
            first, 1u32, CpuHardwareIdentityKindV1.X86Apic,
            9u64, true)).to_equal(false)
        expect(owner.complete_from_architecture_v1(
            first, 0u32, CpuHardwareIdentityKindV1.X86Apic,
            7u64, true)).to_equal(true)
        val permit = owner.redeem_restore_from_architecture_v1(
            first, true).permit.unwrap()
        expect(owner.finish_restore_from_architecture_v1(
            permit, 0u32, CpuHardwareIdentityKindV1.X86Apic,
            7u64, false).ok).to_equal(true)
        expect(owner.complete_from_architecture_v1(
            first, 0u32, CpuHardwareIdentityKindV1.X86Apic,
            7u64, true)).to_equal(false)

    it "does not let a stale restore permit mutate a newer generation":
        step("Complete one disabled-prior lease and retain its consumed permit")
        val owner = x86_owner_v1()
        val old_lease = owner.reserve_from_architecture_v1(
            0u32, CpuHardwareIdentityKindV1.X86Apic, 7u64).lease.unwrap()
        expect(owner.publish_disabled_from_architecture_v1(
            old_lease, false, true)).to_equal(true)
        expect(owner.complete_from_architecture_v1(
            old_lease, 0u32, CpuHardwareIdentityKindV1.X86Apic,
            7u64, true)).to_equal(true)
        val old_permit = owner.redeem_restore_from_architecture_v1(
            old_lease, true).permit.unwrap()
        expect(owner.finish_restore_from_architecture_v1(
            old_permit, 0u32, CpuHardwareIdentityKindV1.X86Apic,
            7u64, false).ok).to_equal(true)

        step("Advance a new generation to restoring")
        val new_lease = owner.reserve_from_architecture_v1(
            0u32, CpuHardwareIdentityKindV1.X86Apic, 7u64).lease.unwrap()
        expect(owner.publish_disabled_from_architecture_v1(
            new_lease, true, true)).to_equal(true)
        expect(owner.complete_from_architecture_v1(
            new_lease, 0u32, CpuHardwareIdentityKindV1.X86Apic,
            7u64, true)).to_equal(true)
        val new_permit = owner.redeem_restore_from_architecture_v1(
            new_lease, true).permit.unwrap()

        step("Reject the stale permit without poisoning the current restore")
        expect(owner.finish_restore_from_architecture_v1(
            old_permit, 0u32, CpuHardwareIdentityKindV1.X86Apic,
            7u64, false).ok).to_equal(false)
        expect(owner.slot_is_quarantined(0u32)).to_equal(false)
        expect(owner.finish_restore_from_architecture_v1(
            new_permit, 0u32, CpuHardwareIdentityKindV1.X86Apic,
            7u64, true).ok).to_equal(true)

    it "quarantines a slot when restored state does not match the saved state":
        step("Save an enabled state and attempt to finish while still disabled")
        val owner = x86_owner_v1()
        val lease = owner.reserve_from_architecture_v1(
            1u32, CpuHardwareIdentityKindV1.X86Apic, 9u64).lease.unwrap()
        expect(owner.publish_disabled_from_architecture_v1(
            lease, true, true)).to_equal(true)
        expect(owner.complete_from_architecture_v1(
            lease, 1u32, CpuHardwareIdentityKindV1.X86Apic,
            9u64, true)).to_equal(true)
        val permit = owner.redeem_restore_from_architecture_v1(
            lease, true).permit.unwrap()
        expect(owner.finish_restore_from_architecture_v1(
            permit, 1u32, CpuHardwareIdentityKindV1.X86Apic,
            9u64, false).ok).to_equal(false)
        expect(owner.slot_is_quarantined(1u32)).to_equal(true)

    it "does not advance from reserve unless the adapter proves IRQs disabled":
        step("Reject a save-disable publication with enabled IRQ observation")
        val owner = x86_owner_v1()
        val lease = owner.reserve_from_architecture_v1(
            0u32, CpuHardwareIdentityKindV1.X86Apic, 7u64).lease.unwrap()
        expect(owner.publish_disabled_from_architecture_v1(
            lease, true, false)).to_equal(false)
        expect(owner.complete_from_architecture_v1(
            lease, 0u32, CpuHardwareIdentityKindV1.X86Apic,
            7u64, true)).to_equal(false)
