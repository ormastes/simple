#![allow(primitive_api, bare_bool)]
@allow(primitive_api, bare_bool)
# Vulkan/virtio-gpu-venus `CompositorBackend` trait skeleton (lane G1).
#
# Lane G0 (`doc/04_architecture/os/vulkan/simpleos_vulkan_render_backend_plan.md`)
# deliberately did NOT create this file: no VulkanBackend stub existed ahead
# of real trait wiring. This lane (G1) wires the trait skeleton G0 deferred,
# WITHOUT implementing any real Vulkan/venus call — none exist in this tree
# yet (see `doc/01_research/os/vulkan/venus_virtio_gpu_protocol_facts.md`).
#
# HONESTY CONTRACT (read before touching this file):
#   * No method here talks to a GPU, a venus ring, or any Vulkan API. There
#     is no `vk*` call anywhere in this file.
#   * `is_available()` is hardcoded `false` and MUST stay `false` until a
#     real venus session (CTX_CREATE + blob ring + SUBMIT_3D, per the G0
#     plan §1) is actually implemented and bit-exact/faster gated through
#     `kernel_registry.spl` (per the G0 plan §3). Flipping it without that
#     work landing is exactly the "looks wired but isn't" failure mode this
#     lane was told to avoid.
#   * Every `CompositorBackend` drawing method (`clear`, `fill_rect`,
#     `draw_text`, `draw_char_8x16`, `put_pixel`, `blit_pixels`, `present`,
#     `present_rect`) is a REJECTING NO-OP: it touches no pixel buffer,
#     reports no success, and records the rejection via `rejected_op_count()`
#     / `last_rejection_reason()` so a spec (or a future caller) can observe
#     that nothing was drawn. It never silently delegates to another backend.
#   * The ONE real, verifiable piece of behavior is
#     `detect_virtio_gpu_device()`: a filesystem check that the path exists
#     AND is a character device (stat mode bits), the DRM render-node shape.
#     That proves a device node exists — it proves NOTHING about
#     venus/Vulkan capset support, and QEMU-side venus is itself unproven on
#     the research host (`doc/08_tracking/bug/simpleos_vulkan_board_gap_venus_is_qemu_only_2026-08-06.md`).
#     No board path exists for virtio-gpu at all (same doc). Fixed
#     2026-08-07 (`doc/08_tracking/bug/vulkan_detect_virtio_gpu_device_is_existence_check_not_device_probe_2026-08-07.md`):
#     it previously reported `true` for ANY existing path, including a plain
#     regular file, which is not a device probe at all.
#   * SECURITY (fixed 2026-08-08, see the "Security rework" section of the
#     same bug doc): `detect_virtio_gpu_device()` used to interpolate
#     `render_node` directly into a `/bin/sh -c "test -c '{render_node}'"`
#     command line. Because `shell_bool()` (`std.io_runtime`) shells out via
#     `/bin/sh -c` and the value is quoted with single quotes, a
#     `render_node` containing a single quote could break out of the
#     quoting and inject arbitrary shell commands, e.g.
#     `'; touch /tmp/pwned; echo '` -- which also spoofed the probe result
#     to `true` via the trailing `echo`'s exit code. `render_node` is a
#     `pub fn` parameter, i.e. untrusted input from any caller. The
#     immediate fix validated the path with `is_safe_render_node_path()`
#     BEFORE it ever reached the shell: only `[A-Za-z0-9/._-]`, must start
#     with `/`.
#   * SHELL-DROP (2026-08-08, same-day follow-up, same bug doc): the shell
#     probe above is now GONE. `detect_virtio_gpu_device()` calls
#     `std.io_runtime.is_char_device()`, which wraps the new no-shell
#     `rt_file_is_char_device` runtime primitive (stat(2) + S_ISCHR;
#     `src/runtime/runtime.c`/`runtime_native.c`) -- no `/bin/sh` involved,
#     so it works on baremetal where `/bin/sh` may not exist and it is
#     immune to shell-metacharacter injection by construction (the path is
#     never interpolated into a command string at all). `is_safe_render_node_path()`
#     is KEPT as defense-in-depth allowlisting even though nothing shells
#     out anymore -- it costs nothing and rejects garbage input early.
#
# MDSOC: feature dimension, compositor layer

use std.io_runtime.{is_char_device}
use os.compositor.display_backend_core.{CompositorBackend, CompositorGlassCapable}

## Default DRM render node checked for virtio-gpu/any-GPU device presence.
## Overridable via `create_from_env`'s `render_node` argument for tests.
pub val VULKAN_VENUS_DEFAULT_RENDER_NODE: text = "/dev/dri/renderD128"

pub fn is_safe_render_node_path(render_node: text) -> bool:
    """Allowlist a render-node path. `detect_virtio_gpu_device()` no longer
    shells out at all (see the file-level SHELL-DROP note), so this is now
    defense-in-depth rather than a shell-injection fix: it still rejects
    anything that is not a plain absolute path built only from
    `[A-Za-z0-9/._-]`, closing off garbage/weird input early rather than
    letting it reach the stat(2) syscall."""
    if render_node == "":
        return false
    if render_node.char_at(0) != "/":
        return false
    val n = render_node.length()
    var i = 0
    while i < n:
        val c = render_node.char_code_at(i)
        val is_upper = c >= 65 and c <= 90
        val is_lower = c >= 97 and c <= 122
        val is_digit = c >= 48 and c <= 57
        # '/' = 47, '.' = 46, '_' = 95, '-' = 45
        val is_symbol = c == 47 or c == 46 or c == 95 or c == 45
        if not (is_upper or is_lower or is_digit or is_symbol):
            return false
        i = i + 1
    true

pub fn detect_virtio_gpu_device(render_node: text) -> bool:
    """REAL, VERIFIABLE capability probe: does a character device exist at
    this path on disk? A DRM render node is always a character device, so
    checking `stat` mode bits (via `rt_file_is_char_device`, a stat(2) +
    S_ISCHR call) rejects plain files and directories that merely happen to
    exist -- unlike a bare existence check, which cannot tell a device node
    from `/etc/hostname`. This is the only claim this file is willing to
    make about hardware. It does NOT mean virtio-gpu specifically (any
    character device passes, e.g. /dev/null), and it does NOT mean
    venus/Vulkan capset support -- those require protocol negotiation this
    file does not implement. Callers must not read a `true` result as
    "Vulkan works".

    No shell involved: `is_safe_render_node_path()` allowlists the path as
    defense-in-depth (see the file-level SHELL-DROP note above), then
    `std.io_runtime.is_char_device()` calls stat(2) directly."""
    if render_node == "":
        return false
    if not is_safe_render_node_path(render_node):
        return false
    is_char_device(render_node)

pub class VulkanCompositorBackend:
    w: i32
    h: i32
    render_node: text
    device_node_present: bool
    rejected_ops: i64 = 0
    last_rejection_reason: text = ""

    static fn create_from_env(width: i32, height: i32) -> VulkanCompositorBackend:
        """Construct with a real (but limited) capability probe against the
        default render node. Drawing remains rejected regardless of the
        probe result -- see the file-level honesty contract."""
        VulkanCompositorBackend.create_with_render_node(
            width, height, VULKAN_VENUS_DEFAULT_RENDER_NODE
        )

    static fn create_with_render_node(
        width: i32,
        height: i32,
        render_node: text
    ) -> VulkanCompositorBackend:
        """Same as `create_from_env` but with an injectable render-node path,
        so specs can exercise both the present and absent branches of
        `detect_virtio_gpu_device` without depending on host hardware."""
        VulkanCompositorBackend(
            w: width,
            h: height,
            render_node: render_node,
            device_node_present: detect_virtio_gpu_device(render_node),
            rejected_ops: 0,
            last_rejection_reason: ""
        )

    pub fn is_available() -> bool:
        """Always false today. No venus session, ring, pipeline, or op is
        implemented -- a present DRM render node is not sufficient. This
        method exists specifically so node-presence can never be mistaken
        for Vulkan/venus capability by a caller who only checks one flag."""
        false

    pub fn unavailable_reason() -> text:
        """Human-readable reason `is_available()` is false. Always includes
        the `qemu_only` scope marker required by the G0 plan §4 so a reader
        cannot mistake this for a claim of board support."""
        if not self.device_node_present:
            return "no_drm_render_node:{self.render_node}:qemu_only"
        "vulkan_venus_session_not_implemented:qemu_only:board_gap_open"

    pub fn rejected_op_count() -> i64:
        self.rejected_ops

    pub fn last_rejection() -> text:
        self.last_rejection_reason

    me reject(op: text):
        """Record a rejected draw call. Never touches a pixel, never claims
        success -- the honest-gate primitive every trait method below routes
        through."""
        self.rejected_ops = self.rejected_ops + 1
        self.last_rejection_reason = "not_implemented:{op}:{self.unavailable_reason()}"

impl CompositorBackend for VulkanCompositorBackend:
    fn width() -> i32:
        self.w

    fn height() -> i32:
        self.h

    me clear(color: u32):
        self.reject("clear")

    me fill_rect(x: i32, y: i32, w: i32, h: i32, color: u32):
        self.reject("fill_rect")

    me draw_text(x: i32, y: i32, text_str: text, fg: u32, bg: u32):
        self.reject("draw_text")

    me draw_char_8x16(x: i32, y: i32, ch: u8, fg: u32, bg: u32):
        self.reject("draw_char_8x16")

    me put_pixel(x: i32, y: i32, color: u32):
        self.reject("put_pixel")

    me blit_pixels(x: i32, y: i32, w: i32, h: i32, pixels: [u32]):
        self.reject("blit_pixels")

    me present():
        self.reject("present")

    me present_rect(x: i32, y: i32, w: i32, h: i32):
        self.reject("present_rect")

    me report_damage(x: i32, y: i32, w: i32, h: i32):
        pass_dn

    fn as_glass_capable() -> CompositorGlassCapable?:
        # No glass/blur GPU path exists either -- do not claim one.
        nil
