# Shared path helpers for the installer submodules
# MDSOC: feature dimension, apps layer
#
# `image_builder.spl` and `usb_installer.spl` both need the list of
# intermediate directory paths that must exist before a file can be written
# under a staged rootfs tree. This was previously duplicated verbatim
# (identical string-processing logic) in both files, each then looping over
# its own locally-scoped `mkdir`. Extracted here as a pure function — it
# returns the path chain rather than creating directories itself, so each
# caller keeps using its own `mkdir` (the two modules intentionally use
# different `mkdir` implementations: image_builder talks to the host
# filesystem directly via `rt_dir_create_all`, usb_installer goes through
# `os.userlib.fs`).

fn parent_dir_chain(root: text, file_path: text) -> [text]:
    val parts = file_path.split("/")
    var current = root
    var i: u64 = 0
    var result: [text] = []
    while i + 1 < parts.len().to_u64():
        val part = parts[i as i64].trim()
        if part != "":
            current = current + "/" + part
            result.push(current)
        i = i + 1
    result
