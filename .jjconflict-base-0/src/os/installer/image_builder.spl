## SimpleOS staged filesystem image builder.
use os.packages.os_packages.{list_all_packages}
use os.tools.pkg.pkg_format.{ExtendedManifest, PkgArch, PackageType, pkg_arch_to_text, pkg_arch_from_text}
use os.port.font_bundle.{simpleos_font_bundle_entries, load_simpleos_font_bundle_entry}
use os.installer.path_utils.{parent_dir_chain}
use os.installer.image_package_payload_policy.{IMAGE_MAX_NATIVE_PAYLOAD_BYTES_V1, image_package_payload_decision_v1, image_native_executable_payload_admitted_v1, image_package_metadata_payload_v1}
use os.installer.image_builder_payloads.{
    IMAGE_SIMPLE_TOOLCHAIN_ROLE_PATHS, IMAGE_CLANG_GUEST_BIN_PATHS,
    IMAGE_RUSTC_GUEST_BIN_PATHS, image_target_architecture,
    image_effective_simple_binary, image_validate_simple_binary,
    image_load_validated_simple_binary,
    image_effective_clang_binary, image_effective_rustc_binary,
    image_effective_sysroot_dir, image_copy_tree,
    image_simple_toolchain_manifest, image_clang_fixture_payload,
    image_clang_embedded_payload, image_rust_fixture_payload,
    image_rust_embedded_payload, image_fstab_payload,
    image_normalized_rootfs_backend, image_rootfs_backend_payload,
    image_rootfs_boot_marker, image_rc_conf_payload,
    image_default_bootloader_config, image_installer_bootloader_config,
}
use os.installer.image_bounded_file_reader.{IMAGE_MAX_PACKAGE_ARCHIVE_BYTES_V1, image_read_file_bounded_v1, image_read_text_bounded_v1}
extern fn rt_process_run_timeout(cmd: text, args: [text], timeout_ms: i64) -> (text, text, i32)
extern fn rt_env_get(key: text) -> text?
extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_read_text(path: text) -> text
extern fn rt_file_read_bytes(path: text) -> [u8]
extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_dir_create_all(path: text) -> bool
extern fn rt_dir_list(path: text) -> [text]

# === Image Constants ===

val DEFAULT_IMAGE_SIZE_MB: u64 = 512
val EFI_PARTITION_SIZE_MB: u64 = 64

val _ROOT_LAYOUT = [
    "/boot",
    "/boot/efi",
    "/bin",
    "/sbin",
    "/etc",
    "/etc/shell",
    "/etc/pkg",
    "/etc/registry",
    "/lib",
    "/usr",
    "/usr/bin",
    "/usr/sbin",
    "/usr/lib",
    "/usr/libexec",
    "/usr/libexec/simpleos-installer",
    "/usr/libexec/simpleos-installer/kernel",
    "/usr/libexec/simpleos-installer/packages",
    "/usr/local",
    "/usr/local/bin",
    "/usr/local/lib",
    "/usr/local/share",
    "/usr/local/share/themes",
    "/var",
    "/var/cache",
    "/var/cache/pkg",
    "/var/db",
    "/var/db/pkg",
    "/var/db/pkg/installed",
    "/var/log",
    "/tmp",
    "/home"
]

struct ImageConfig:
    arch: PkgArch
    output_path: text
    image_size_mb: u64
    kernel_path: text
    bootloader_config: text
    package_dir: text
    include_installer: bool
struct PartitionLayout:
    efi_start_sector: u64
    efi_size_sectors: u64
    root_start_sector: u64
    root_size_sectors: u64
    total_sectors: u64

var _image_builder_rootfs_backend: text = "fat32"

val _IMAGE_SCREEN_TYPES: [text] = ["wm", "2d", "web", "gui"]
val _IMAGE_SCREEN_SIMD_VALUES: [text] = ["auto", "on", "off", "sse2", "avx2", "neon"]
var _image_builder_screen_type: text = ""
var _image_builder_screen_res: text = ""
var _image_builder_screen_simd: text = ""
fn _image_builder_reset_screen():
    _image_builder_screen_type = ""
    _image_builder_screen_res = ""
    _image_builder_screen_simd = ""
fn _validated_screen_type(raw: text) -> Result<text, text>:
    val value = raw.trim().to_lower()
    if value == "":
        return Result.Ok("")
    for t in _IMAGE_SCREEN_TYPES:
        if value == t:
            return Result.Ok(value)
    Result.Err("SimpleOS image screen_type invalid: \"{raw}\" (want wm|2d|web|gui)")
fn _validated_screen_simd(raw: text) -> Result<text, text>:
    val value = raw.trim().to_lower()
    if value == "":
        return Result.Ok("")
    for s in _IMAGE_SCREEN_SIMD_VALUES:
        if value == s:
            return Result.Ok(value)
    Result.Err("SimpleOS image screen_simd invalid: \"{raw}\" (want auto|on|off|sse2|avx2|neon)")
fn _validated_screen_res(raw: text) -> Result<text, text>:
    val value = raw.trim().to_lower()
    if value == "":
        return Result.Ok("")
    val parts = value.split("x")
    if parts.len() != 2:
        return Result.Err("SimpleOS image screen_res invalid: \"{raw}\" (want WxH)")
    val w = parts[0].to_i64()
    val h = parts[1].to_i64()
    if w <= 0 or h <= 0:
        return Result.Err("SimpleOS image screen_res invalid: \"{raw}\" (want WxH)")
    Result.Ok("{w}x{h}")
pub fn image_builder_set_screen(screen_type: text, screen_res: text, screen_simd: text) -> Result<bool, text>:
    """Request validated boot screen configuration for the next image build."""
    val t = _validated_screen_type(screen_type)?
    val r = _validated_screen_res(screen_res)?
    val s = _validated_screen_simd(screen_simd)?
    _image_builder_screen_type = t
    _image_builder_screen_res = r
    _image_builder_screen_simd = s
    Result.Ok(true)

class ImageBuilder:
    config: ImageConfig
    layout: PartitionLayout

impl ImageBuilder:
    static fn new(config: ImageConfig) -> ImageBuilder:
        val layout = _compute_layout(config.image_size_mb)
        ImageBuilder(config: config, layout: layout)

    fn build(observer: _ImageSimpleboxValidationObserverV1) -> Result<text, text>:
        if self.config.image_size_mb < MIN_IMAGE_SIZE_MB_V1:
            return Err("SimpleOS image size must be at least {MIN_IMAGE_SIZE_MB_V1} MB")
        val arch_name = pkg_arch_to_text(self.config.arch)
        val artifact_kind = if self.config.include_installer: "installer-dvd" else: "disk-image"
        val simple_binary = _effective_simple_binary(self.config)
        if simple_binary != "":
            val simple_check = _validate_simple_binary(simple_binary, self.config.arch)
            if val Err(e) = simple_check:
                return Err(e)
        var font_guest_paths: [text] = []
        var font_blobs: [[u8]] = []
        for entry in simpleos_font_bundle_entries():
            val loaded = load_simpleos_font_bundle_entry(entry)
            if not loaded.valid:
                return Err("SimpleOS font bundle entry invalid: " + loaded.reason)
            font_guest_paths.push(entry.guest_long_path)
            font_blobs.push(loaded.data)
        print "Creating {artifact_kind}: {self.config.output_path}"
        print "  Architecture: {arch_name}"
        print "  Size: {self.config.image_size_mb} MB"

        val staging_root = _staging_root(self.config.output_path)
        val efi_root = "{staging_root}/efi"
        val rootfs_root = "{staging_root}/rootfs"
        val reports_root = "{staging_root}/reports"

        _ensure_dir(staging_root)
        _ensure_dir(efi_root)
        _ensure_dir(rootfs_root)
        _ensure_dir(reports_root)

        var deploy_manifest = _manifest_header(self.config, self.layout)
        deploy_manifest = deploy_manifest + self._populate_efi_partition(efi_root)
        val root_manifest = self._populate_root_partition(rootfs_root, font_guest_paths, font_blobs)?
        deploy_manifest = deploy_manifest + root_manifest

        if self.config.include_installer:
            deploy_manifest = deploy_manifest + self._populate_install_media(rootfs_root)

        val manifest_path = "{reports_root}/deployed-files.sdn"
        write_text(manifest_path, deploy_manifest)
        write_text(_sidecar_manifest_path(self.config.output_path), deploy_manifest)

        val artifact_result = self._materialize_primary_artifact(manifest_path)
        if val Err(e) = artifact_result:
            return Result.Err(e)

        print "  Staged filesystem: {rootfs_root}"
        print "  Deploy manifest: {manifest_path}"
        print "Image created: {self.config.output_path}"
        Result.Ok(self.config.output_path)

    fn _populate_efi_partition(efi_root: text) -> text:
        _ensure_dir("{efi_root}/EFI")
        _ensure_dir("{efi_root}/EFI/BOOT")
        _ensure_dir("{efi_root}/simpleos")

        val kernel_text = _kernel_payload(self.config.kernel_path, self.config.arch)
        write_text("{efi_root}/kernel.elf", kernel_text)
        write_text("{efi_root}/limine.cfg", _effective_bootloader_config(self.config))

        var manifest = ""
        manifest = manifest + _manifest_file("/boot/kernel.elf", "efi-kernel", "simpleos-kernel")
        manifest = manifest + _manifest_file("/boot/limine.cfg", "bootloader-config", "simpleos-kernel")
        manifest

    fn _populate_root_partition(rootfs_root: text, font_guest_paths: [text], font_blobs: [[u8]]) -> Result<text, text>:
        if font_guest_paths.len() != font_blobs.len():
            return Err("SimpleOS font asset staging input mismatch")
        for dir in _ROOT_LAYOUT:
            _ensure_dir("{rootfs_root}{dir}")

        write_text("{rootfs_root}/etc/hostname", "simpleos\n")
        write_text("{rootfs_root}/etc/fstab", image_fstab_payload())
        write_text("{rootfs_root}/etc/rc.conf", _rc_conf_template())
        _image_builder_reset_screen()
        write_text("{rootfs_root}/etc/pkg/repos.sdn", _pkg_repo_template())
        write_text("{rootfs_root}/etc/shell/profile.sdn", "shell = \"/bin/shell\"\n")
        write_text("{rootfs_root}/etc/rootfs.sdn", image_rootfs_backend_payload(_image_builder_rootfs_backend))
        _ensure_dir("{rootfs_root}/SYS")
        write_text("{rootfs_root}/SYS/ROOTFS.CFG", _rootfs_boot_marker_payload(_image_builder_rootfs_backend))

        var manifest = ""
        manifest = manifest + _manifest_file("/etc/hostname", "system-config", "simpleos-core")
        manifest = manifest + _manifest_file("/etc/fstab", "system-config", "simpleos-core")
        manifest = manifest + _manifest_file("/etc/rc.conf", "system-config", "simpleos-core")
        manifest = manifest + _manifest_file("/etc/pkg/repos.sdn", "pkg-config", "simpleos-tools")
        manifest = manifest + _manifest_file("/etc/shell/profile.sdn", "shell-config", "simpleos-shell")
        manifest = manifest + _manifest_file("/etc/rootfs.sdn", "rootfs-config", "simpleos-core")
        manifest = manifest + image_package_payload_decision_v1(
            "simpleos-core", "/sbin/init", [], image_target_architecture(self.config.arch)).inventory_row
        manifest = manifest + self._native_payload_manifest(
            "{rootfs_root}/boot/kernel.elf", "/boot/kernel.elf",
            "simpleos-kernel", "runtime-kernel", kernel_bytes)
        manifest = manifest + image_package_payload_decision_v1(
            "simpleos-core", "/bin/simplebox", [], image_target_architecture(self.config.arch)).inventory_row
        manifest = manifest + _manifest_file("/SYS/ROOTFS.CFG", "rootfs-boot-marker", "simpleos-core")

        val packages = list_all_packages(self.config.arch)
        for pkg in packages:
            manifest = manifest + self._deploy_package(rootfs_root, pkg)

        manifest = manifest + self._stage_simple_toolchain_payload(rootfs_root)
        manifest = manifest + self._stage_clang_toolchain_payload(rootfs_root)
        manifest = manifest + self._stage_rust_toolchain_payload(rootfs_root)
        manifest

    fn _stage_simple_toolchain_payload(rootfs_root: text) -> Result<text, text>:
        val simple_binary = image_effective_simple_binary(self.config.simple_binary)
        if simple_binary == "" or not rt_file_exists(simple_binary):
            var blocked = ""
            for guest_path in IMAGE_SIMPLE_TOOLCHAIN_ROLE_PATHS:
                blocked = blocked + image_package_payload_decision_v1(
                    "simpleos-tools", guest_path, [], image_target_architecture(self.config.arch)).inventory_row
            return Ok(blocked)
        val simple_bytes = image_load_validated_simple_binary(
            simple_binary, self.config.arch)?

        var manifest = ""
        for guest_path in _SIMPLE_TOOLCHAIN_ROLE_PATHS:
            val target_path = "{rootfs_root}{guest_path}"
            _ensure_parent_dirs(rootfs_root, guest_path)
            val ok = _copy_file(simple_binary, target_path)
            if ok:
                manifest = manifest + _manifest_file(guest_path, "simple-toolchain-role", "simpleos-tools")

        _ensure_dir("{rootfs_root}/SYS")
        write_text("{rootfs_root}/SYS/SIMPLETOOL.SDN", _simple_toolchain_manifest_payload(simple_binary))
        manifest = manifest + _manifest_file("/SYS/SIMPLETOOL.SDN", "simple-toolchain-manifest", "simpleos-tools")
        manifest

    # Embed the REAL guest-native clang toolchain when build/os/clang_static is
    # present; otherwise leave the package-staged fixture in place and record a
    # clear "fixture: clang_static not built" marker. The clang binary is large,
    # so it is copied with `cp` rather than read into a Simple buffer; the 2000+
    # header sysroot is bulk-copied with `cp -a`.
    fn _stage_clang_toolchain_payload(rootfs_root: text) -> text:
        val clang_binary = _effective_clang_binary()
        if clang_binary == "" or not rt_file_exists(clang_binary):
            _ensure_dir("{rootfs_root}/SYS")
            write_text("{rootfs_root}/SYS/CLANGTOOL.SDN", _clang_toolchain_fixture_payload())
            return _manifest_file("/SYS/CLANGTOOL.SDN", "clang-toolchain-fixture", "simpleos-tools")

        var manifest = ""
        for guest_path in _CLANG_GUEST_BIN_PATHS:
            _ensure_parent_dirs(rootfs_root, guest_path)
            if _copy_file(clang_binary, "{rootfs_root}{guest_path}"):
                manifest = manifest + _manifest_file(guest_path, "clang-toolchain-binary", "simpleos-tools")

        val sysroot = _effective_sysroot_dir()
        var sysroot_embedded = false
        if sysroot != "" and rt_file_exists(sysroot):
            _ensure_dir("{rootfs_root}/usr/lib")
            _ensure_dir("{rootfs_root}/usr/share/simpleos")
            val libs_ok = _copy_tree("{sysroot}/lib", "{rootfs_root}/usr/lib")
            val sysroot_ok = _copy_tree(sysroot, "{rootfs_root}/usr/share/simpleos")
            sysroot_embedded = libs_ok and sysroot_ok
            if libs_ok:
                manifest = manifest + _manifest_file("/usr/lib", "clang-sysroot-libs", "simpleos-tools")
            if sysroot_ok:
                manifest = manifest + _manifest_file("/usr/share/simpleos", "clang-sysroot", "simpleos-tools")

        _ensure_dir("{rootfs_root}/SYS")
        write_text("{rootfs_root}/SYS/CLANGTOOL.SDN", _clang_toolchain_embedded_payload(clang_binary, sysroot, sysroot_embedded))
        manifest = manifest + _manifest_file("/SYS/CLANGTOOL.SDN", "clang-toolchain-manifest", "simpleos-tools")
        manifest

    # Optional symmetric rustc_static embedding — shares the clang sysroot.
    fn _stage_rust_toolchain_payload(rootfs_root: text) -> text:
        val rustc_binary = _effective_rustc_binary()
        if rustc_binary == "" or not rt_file_exists(rustc_binary):
            _ensure_dir("{rootfs_root}/SYS")
            write_text("{rootfs_root}/SYS/RUSTTOOL.SDN", _rust_toolchain_fixture_payload())
            return _manifest_file("/SYS/RUSTTOOL.SDN", "rust-toolchain-fixture", "simpleos-tools")

        var manifest = ""
        for guest_path in _RUSTC_GUEST_BIN_PATHS:
            _ensure_parent_dirs(rootfs_root, guest_path)
            if _copy_file(rustc_binary, "{rootfs_root}{guest_path}"):
                manifest = manifest + _manifest_file(guest_path, "rust-toolchain-binary", "simpleos-tools")

        _ensure_dir("{rootfs_root}/SYS")
        write_text("{rootfs_root}/SYS/RUSTTOOL.SDN", _rust_toolchain_embedded_payload(rustc_binary))
        manifest = manifest + _manifest_file("/SYS/RUSTTOOL.SDN", "rust-toolchain-manifest", "simpleos-tools")
        manifest

    fn _populate_install_media(rootfs_root: text) -> text:
        val installer_root = "{rootfs_root}/usr/libexec/simpleos-installer"
        _ensure_dir(installer_root)
        _ensure_dir("{installer_root}/kernel")
        _ensure_dir("{installer_root}/packages")

        write_text("{installer_root}/installer", _installer_payload(self.config.arch))
        write_text("{installer_root}/kernel/kernel.elf", _kernel_payload(self.config.kernel_path, self.config.arch))

        var manifest = ""
        manifest = manifest + _manifest_file("/usr/libexec/simpleos-installer/installer", "install-media", "simpleos-installer")
        manifest = manifest + _manifest_file("/usr/libexec/simpleos-installer/kernel/kernel.elf", "install-media-kernel", "simpleos-installer")

        if self.config.package_dir != "":
            val entries = readdir(self.config.package_dir)
            for entry in entries:
                if entry.ends_with(".spk"):
                    val content = read_text("{self.config.package_dir}/{entry}")
                    write_text("{installer_root}/packages/{entry}", content)
                    manifest = manifest + _manifest_file("/usr/libexec/simpleos-installer/packages/{entry}", "install-package", "simpleos-installer")
        manifest

    fn _deploy_package(rootfs_root: text, pkg: ExtendedManifest) -> text:
        var manifest = ""
        if pkg.pkg_type == PackageType.Meta:
            write_text("{rootfs_root}/var/db/pkg/installed/{pkg.base.name}.sdn", "# meta-package\nname = \"{pkg.base.name}\"\n")
            return _manifest_file("/var/db/pkg/installed/{pkg.base.name}.sdn", "pkg-db", pkg.base.name)

        for file_path in pkg.base.files:
            if file_path == "":
                continue
            if file_path.ends_with("/"):
                _ensure_dir("{rootfs_root}{file_path}")
                manifest = manifest + _manifest_dir(file_path, pkg.base.name)
            else:
                _write_placeholder_payload(rootfs_root, file_path, pkg, self.config.arch)
                manifest = manifest + _manifest_file(file_path, "package-payload", pkg.base.name)
        write_text("{rootfs_root}/var/db/pkg/installed/{pkg.base.name}.sdn", _installed_pkg_record(pkg))
        manifest = manifest + _manifest_file("/var/db/pkg/installed/{pkg.base.name}.sdn", "pkg-db", pkg.base.name)
        manifest

    fn _materialize_primary_artifact(rootfs_root: text, manifest_path: text) -> Result<bool, text>:
        if self.config.arch == PkgArch.X86_64 and not self.config.include_installer:
            val args = [
                "scripts/os/make_os_disk.shs",
                self.config.image_size_mb.to_text(),
                self.config.output_path,
                rootfs_root
            ]
            val (stdout, stderr, exit_code) = rt_process_run_timeout("/bin/sh", args, 120000)
            if stdout != "":
                print stdout.trim()
            if stderr != "":
                print stderr.trim()
            if exit_code == 0 and rt_file_exists(self.config.output_path):
                return Result.Ok(true)
            print "[image-builder] FAT32 disk generation failed, writing descriptor fallback"
        _write_artifact_descriptor(self.config, self.layout, manifest_path)
        Result.Ok(true)

fn _build_image_v1(config: ImageConfig) -> Result<text, text>:
    ImageBuilder.new(config).build(_ImageSimpleboxValidationObserverV1.new())

fn build_usb_installer_image(
    arch: PkgArch,
    kernel_path: text,
    package_dir: text,
    output_path: text,
    size_mb: u64
) -> Result<text, text>:
    val config = ImageConfig(
        arch: arch,
        output_path: output_path,
        image_size_mb: if size_mb > 0: size_mb else: DEFAULT_IMAGE_SIZE_MB,
        kernel_path: kernel_path,
        bootloader_config: _installer_bootloader_config(arch),
        package_dir: package_dir,
        include_installer: true
    )
    _image_builder_rootfs_backend = "fat32"
    _build_image_v1(config)

fn build_usb_installer_image_with_rootfs(
    arch: PkgArch,
    kernel_path: text,
    package_dir: text,
    output_path: text,
    size_mb: u64,
    rootfs_backend: text
) -> Result<text, text>:
    val config = ImageConfig(
        arch: arch,
        output_path: output_path,
        image_size_mb: if size_mb > 0: size_mb else: DEFAULT_IMAGE_SIZE_MB,
        kernel_path: kernel_path,
        bootloader_config: _installer_bootloader_config(arch),
        package_dir: package_dir,
        include_installer: true
    )
    _image_builder_rootfs_backend = _normalized_rootfs_backend(rootfs_backend)
    ImageBuilder.new(config).build()

fn build_install_image(
    arch: PkgArch,
    kernel_path: text,
    package_dir: text,
    output_path: text,
    size_mb: u64
) -> Result<text, text>:
    val config = ImageConfig(
        arch: arch,
        output_path: output_path,
        image_size_mb: if size_mb > 0: size_mb else: DEFAULT_IMAGE_SIZE_MB,
        kernel_path: kernel_path,
        bootloader_config: "",
        package_dir: package_dir,
        include_installer: false
    )
    _image_builder_rootfs_backend = "fat32"
    val observer = _ImageSimpleboxValidationObserverV1.new()
    val built = ImageBuilder.new(config).build(observer)?
    Ok((built, observer.snapshot()))

fn build_install_image_with_rootfs(
    arch: PkgArch,
    kernel_path: text,
    package_dir: text,
    output_path: text,
    size_mb: u64,
    rootfs_backend: text
) -> Result<text, text>:
    val config = ImageConfig(
        arch: arch,
        output_path: output_path,
        image_size_mb: if size_mb > 0: size_mb else: DEFAULT_IMAGE_SIZE_MB,
        kernel_path: kernel_path,
        bootloader_config: "",
        package_dir: package_dir,
        include_installer: false
    )
    _image_builder_rootfs_backend = _normalized_rootfs_backend(rootfs_backend)
    ImageBuilder.new(config).build()

fn _print_image_usage():
    print "Usage: image-builder create [--arch=ARCH] [--output=PATH] [--size=MB] [--kernel=PATH] [--packages=DIR] [--simple-binary=PATH] [--rootfs=fat32|dbfs|nvfs] [--screen-type=T] [--screen-res=WxH] [--screen-simd=S] [--installer]"

fn run_image_builder(args: [text]) -> i32:
    for arg in args:
        if arg == "-h":
            _print_image_usage()
            return 0
    if args.len() < 1 or args[0] != "create":
        _print_image_usage()
        return 1

    var arch_str = "x86_64"
    var output = "simpleos.img"
    var size_mb: u64 = DEFAULT_IMAGE_SIZE_MB
    # NOTE: local must not be named `kernel` — a local shadowed by the
    # `os.kernel` module name fails HIR lowering / interp semantic analysis.
    # See doc/08_tracking/bug/local_var_kernel_shadowed_by_module_2026-07-06.md
    var kernel_elf = ""
    var packages = ""
    var simple_binary = ""
    var installer = false
    var rootfs_backend = "fat32"
    var screen_type = ""
    var screen_res = ""
    var screen_simd = ""

    var i = 1
    while i < args.len():
        val arg = args[i]
        if arg.starts_with("--arch="):
            arch_str = arg.slice(7, arg.len())
        else if arg.starts_with("--output="):
            output = arg.slice(9, arg.len())
        else if arg.starts_with("--size="):
            size_mb = arg.slice(7, arg.len()).to_u64()
        else if arg.starts_with("--kernel="):
            kernel = arg.slice(9, arg.len())
        else if arg.starts_with("--packages="):
            packages = arg.slice(11, arg.len())
        else if arg.starts_with("--simple-binary="):
            simple_binary = arg.slice(16, arg.len())
        else if arg.starts_with("--rootfs="):
            rootfs_backend = arg.slice(9, arg.len())
        else if arg.starts_with("--screen-type="):
            screen_type = arg.slice(14, arg.len())
        else if arg.starts_with("--screen-res="):
            screen_res = arg.slice(13, arg.len())
        else if arg.starts_with("--screen-simd="):
            screen_simd = arg.slice(14, arg.len())
        else if arg == "--installer":
            installer = true
        i = i + 1

    val arch_result = pkg_arch_from_text(arch_str)
    if val Err(e) = arch_result:
        print "Error: {e}"
        return 1
    val arch = arch_result.unwrap()

    val screen_result = image_builder_set_screen(screen_type, screen_res, screen_simd)
    if val Err(e) = screen_result:
        print "Error: {e}"
        return 1

    val result = if installer:
        val config = ImageConfig(
            arch: arch,
            output_path: output,
            image_size_mb: if size_mb > 0: size_mb else: DEFAULT_IMAGE_SIZE_MB,
            kernel_path: kernel_elf,
            bootloader_config: _installer_bootloader_config(arch),
            package_dir: packages,
            simple_binary: simple_binary,
            include_installer: true
        )
        _image_builder_rootfs_backend = _normalized_rootfs_backend(rootfs_backend)
        ImageBuilder.new(config).build()
    else:
        val config = ImageConfig(
            arch: arch,
            output_path: output,
            image_size_mb: if size_mb > 0: size_mb else: DEFAULT_IMAGE_SIZE_MB,
            kernel_path: kernel_elf,
            bootloader_config: "",
            package_dir: packages,
            simple_binary: simple_binary,
            include_installer: false
        )
        _image_builder_rootfs_backend = _normalized_rootfs_backend(rootfs_backend)
        ImageBuilder.new(config).build()

    if val Ok(path) = result:
        print "Artifact created: {path}"
        return 0
    else if val Err(e) = result:
        print "Error: {e}"
        return 1
    0

fn _compute_layout(image_size_mb: u64) -> PartitionLayout:
    val total_sectors = (image_size_mb * 1024 * 1024) / 512
    val efi_start: u64 = 2048
    val efi_sectors = (EFI_PARTITION_SIZE_MB * 1024 * 1024) / 512
    val root_start = efi_start + efi_sectors
    val reserved_end = root_start + 2048
    val root_sectors = if total_sectors > reserved_end:
        total_sectors - reserved_end
    else:
        0u64
    PartitionLayout(
        efi_start_sector: efi_start,
        efi_size_sectors: efi_sectors,
        root_start_sector: root_start,
        root_size_sectors: root_sectors,
        total_sectors: total_sectors
    )

fn _staging_root(output_path: text) -> text:
    "{output_path}.contents"

fn _sidecar_manifest_path(output_path: text) -> text:
    "{output_path}.manifest.sdn"

fn read_text(path: text) -> text:
    rt_file_read_text(path) ?? ""

fn write_text(path: text, content: text):
    val _ok = rt_file_write_text(path, content)

fn readdir(path: text) -> [text]:
    rt_dir_list(path) ?? []

fn mkdir(path: text):
    val _ok = rt_dir_create_all(path)

fn _ensure_dir(path: text):
    if path == "":
        return
    val parts = path.split("/")
    var current = ""
    for raw in parts:
        val part = raw.trim()
        if part == "":
            continue
        current = current + "/" + part
        mkdir(current)

fn _ensure_parent_dirs(rootfs_root: text, file_path: text):
    for dir in parent_dir_chain(rootfs_root, file_path):
        mkdir(dir)

fn _manifest_header(config: ImageConfig, layout: PartitionLayout) -> text:
    val kind = if config.include_installer: "installer-dvd" else: "disk-image"
    val rootfs_backend = _normalized_rootfs_backend(_image_builder_rootfs_backend)
    var out = "[artifact]\n"
    out = out + "arch = \"{pkg_arch_to_text(config.arch)}\"\n"
    out = out + "output = \"{config.output_path}\"\n"
    out = out + "kind = \"{kind}\"\n"
    out = out + "rootfs_backend = \"{rootfs_backend}\"\n"
    out = out + "image_size_mb = {config.image_size_mb}\n"
    out = out + "efi_start_sector = {layout.efi_start_sector}\n"
    out = out + "efi_size_sectors = {layout.efi_size_sectors}\n"
    out = out + "root_start_sector = {layout.root_start_sector}\n"
    out = out + "root_size_sectors = {layout.root_size_sectors}\n\n"
    out

fn _manifest_file(path: text, role: text, owner: text) -> text:
    "[deploy]\npath = \"{path}\"\nkind = \"file\"\nrole = \"{role}\"\nowner = \"{owner}\"\n\n"

fn _manifest_dir(path: text, owner: text) -> text:
    "[deploy]\npath = \"{path}\"\nkind = \"dir\"\nrole = \"package-dir\"\nowner = \"{owner}\"\n\n"

fn _installed_pkg_record(pkg: ExtendedManifest) -> text:
    var out = "[package]\n"
    out = out + "name = \"{pkg.base.name}\"\n"
    out = out + "version = \"{pkg.base.version.to_text()}\"\n"
    out = out + "arch = \"{pkg_arch_to_text(pkg.arch)}\"\n"
    out = out + "files = {pkg.base.files.len()}\n"
    out

fn _effective_bootloader_config(config: ImageConfig) -> text:
    if config.bootloader_config != "":
        return config.bootloader_config
    image_default_bootloader_config(config.arch)

fn _kernel_payload(kernel_path: text, arch: PkgArch) -> text:
    if kernel_path != "":
        val content = read_text(kernel_path)
        if content != "":
            return content
    "# placeholder kernel\narch = \"{pkg_arch_to_text(arch)}\"\n"

fn _fstab_template() -> text:
    var out = "# SimpleOS filesystem table\n"
    out = out + "/dev/root / auto defaults 0 1\n"
    out = out + "/dev/efi /boot/efi fat32 defaults 0 2\n"
    out

# Detect the ISO authoring tool available on the build host. Returns the tool
# basename (e.g. "xorriso", "mkisofs", "genisoimage") or "iso-tool-missing".
fn detect_iso_tool() -> text:
    val cmd = "command -v xorriso || command -v mkisofs || command -v genisoimage || true"
    val (stdout, _e, _c) = rt_process_run_timeout("/bin/sh", ["-c", cmd], 15000)
    val found = stdout.trim()
    if found == "":
        return "iso-tool-missing"
    _basename(found)

fn _rootfs_backend_payload(rootfs_backend: text) -> text:
    val backend = _normalized_rootfs_backend(rootfs_backend)
    var out = "[rootfs]\n"
    out = out + "backend = \"{backend}\"\n"
    out = out + "carrier = \"fat32\"\n"
    out = out + "boot_mode = \"fat32-carrier\"\n"
    out

# make_os_disk.shs argv: SIZE_BITS IMAGE [KERNEL] [PLATFORM]. The KERNEL slot
# must be the host kernel ELF path (may be empty -> missing-kernel marker);
# passing a directory there makes make_os_disk die("file read failed") and
# forces the descriptor fallback.
fn _make_os_disk_command(config: ImageConfig) -> text:
    val simple_binary = _effective_simple_binary(config)
    var command = ""
    if simple_binary != "":
        command = command + "SIMPLEOS_SIMPLE_BINARY=" + _shell_quote(simple_binary) + " "
    command = command + "sh scripts/os/make_os_disk.shs "
    command = command + _shell_quote(config.image_size_mb.to_text()) + " "
    command = command + _shell_quote(config.output_path) + " "
    command = command + _shell_quote(config.kernel_path) + " "
    command + "x86_64"

fn _rc_conf_template() -> text:
    image_rc_conf_payload(
        _image_builder_screen_type,
        _image_builder_screen_res,
        _image_builder_screen_simd
    )

fn _pkg_repo_template() -> text:
    "[repositories]\nlocal = \"/var/cache/pkg/local\"\n"

fn _write_artifact_descriptor(config: ImageConfig, layout: PartitionLayout, manifest_path: text):
    var out = _manifest_header(config, layout)
    out = out + "[descriptor]\n"
    out = out + "staging_root = \"{_staging_root(config.output_path)}\"\n"
    out = out + "deploy_manifest = \"{manifest_path}\"\n"
    out = out + "materialized = false\n"
    write_text(config.output_path, out)

fn _default_bootloader_config(arch: PkgArch) -> text:
    var cfg = "# Limine bootloader config\n"
    cfg = cfg + "TIMEOUT=5\n"
    cfg = cfg + "\n:SimpleOS\n"
    cfg = cfg + "  PROTOCOL=limine\n"
    cfg = cfg + "  KERNEL_PATH=boot:///kernel.elf\n"
    cfg = cfg + "  CMDLINE=console=serial root=/dev/sda2 arch={pkg_arch_to_text(arch)}\n"
    cfg

fn _installer_bootloader_config(arch: PkgArch) -> text:
    var cfg = "TIMEOUT=5\n"
    cfg = cfg + "\n:SimpleOS Installer\n"
    cfg = cfg + "  PROTOCOL=limine\n"
    cfg = cfg + "  KERNEL_PATH=boot:///kernel.elf\n"
    cfg = cfg + "  CMDLINE=console=serial installer=1 root=/dev/sda2 arch={pkg_arch_to_text(arch)}\n"
    cfg = cfg + "\n:SimpleOS (Live)\n"
    cfg = cfg + "  PROTOCOL=limine\n"
    cfg = cfg + "  KERNEL_PATH=boot:///kernel.elf\n"
    cfg = cfg + "  CMDLINE=console=serial live=1 arch={pkg_arch_to_text(arch)}\n"
    cfg
