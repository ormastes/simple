# Package projection for filesystem-launched pure-Simple text tools.

use os.tools.shell.grep.grep_artifact_contract.{
    TextToolArtifactContractV1, text_tool_artifact_contract_v1,
    text_tool_artifact_contract_valid_v1
}

pub const TEXT_TOOL_PACKAGE_IDENTITY_SCHEMA_V1: i64 = 1

pub struct TextToolPackageIdentityV1:
    schema_version: i64
    package_name: text
    artifact: TextToolArtifactContractV1
    artifact_digest: text
    admission_receipt_id: text
    blocker: text

pub fn text_tool_package_identity_v1(
    command: text
) -> Result<TextToolPackageIdentityV1, text>:
    val artifact = text_tool_artifact_contract_v1(command)
    match artifact:
        case Err(reason): Err(reason)
        case Ok(value):
            Ok(TextToolPackageIdentityV1(
                schema_version: TEXT_TOOL_PACKAGE_IDENTITY_SCHEMA_V1,
                package_name: "simpleos-text-tools",
                artifact: value,
                artifact_digest: "",
                admission_receipt_id: "",
                blocker: "target-artifact-and-loader-token-unavailable",
            ))

pub fn text_tool_package_identity_blocked_v1(
    identity: TextToolPackageIdentityV1
) -> bool:
    identity.schema_version == TEXT_TOOL_PACKAGE_IDENTITY_SCHEMA_V1 and
        identity.package_name == "simpleos-text-tools" and
        text_tool_artifact_contract_valid_v1(identity.artifact) and
        identity.artifact_digest == "" and
        identity.admission_receipt_id == "" and
        identity.blocker == "target-artifact-and-loader-token-unavailable"
