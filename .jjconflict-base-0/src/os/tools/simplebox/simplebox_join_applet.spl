# Bounded unique-key sorted join for filesystem-launched SimpleOS Simplebox.

use os.userlib.fs.{file_open_direct, file_read_direct, file_close_direct}
use os.tools.simplebox.simplebox_fs_applets.{
    SIMPLEBOX_FILE_BYTES_LIMIT, SIMPLEBOX_READ_CHUNK_BYTES,
    SIMPLEBOX_PATH_OPERAND_BYTES_LIMIT
}
use std.nogc_sync_mut.binary_io.{bytes_to_string}

extern fn stdout_write(data: text)

pub const SIMPLEBOX_JOIN_TOTAL_INPUT_BYTES_LIMIT: u64 = 67108864u64
pub const SIMPLEBOX_JOIN_LINE_BYTES_LIMIT: u64 = 1048576u64
pub const SIMPLEBOX_JOIN_LINE_LIMIT: u64 = 1000000u64
pub const SIMPLEBOX_JOIN_OUTPUT_BYTES_LIMIT: u64 = 67108864u64
pub const SIMPLEBOX_JOIN_ROWS_PER_BLOCK: u64 = 1024u64

struct SimpleboxJoinPlan:
    delimiter: text
    delimiter_byte: u8
    whitespace: bool
    first_path: text
    second_path: text
    accepted: bool
    error: text

struct SimpleboxJoinRecord:
    key: [u8]
    remainder: [u8]
    has_remainder: bool

class SimpleboxJoinReadState:
    records: [SimpleboxJoinRecord]
    pending: [u8]
    consumed: u64
    failure: text

    me finish_line(plan: SimpleboxJoinPlan, path: text, line_limit: u64):
        if me.records.len() >= line_limit:
            me.failure = path + ": input exceeds simplebox line limit"
            return
        val record = _join_record(me.pending, plan)
        if (me.records.len() > 0u64 and
            _join_bytes_compare(record.key,
                me.records[me.records.len() - 1u64].key) <= 0):
            me.failure = path + ": join keys must be strictly increasing"
            return
        me.records.push(record)
        me.pending = []

    me append_byte(byte: u8, path: text):
        if me.pending.len() >= SIMPLEBOX_JOIN_LINE_BYTES_LIMIT:
            me.failure = path + ": line exceeds simplebox byte limit"
            return
        me.pending.push(byte)

class SimpleboxJoinOutputState:
    blocks: [text]
    buffered_rows: [text]
    output_bytes: u64
    failure: text

    me push_row(row: text):
        if (me.output_bytes > SIMPLEBOX_JOIN_OUTPUT_BYTES_LIMIT or
            row.len() > SIMPLEBOX_JOIN_OUTPUT_BYTES_LIMIT - me.output_bytes):
            me.failure = "output exceeds simplebox byte limit"
            return
        me.buffered_rows.push(row)
        if me.buffered_rows.len() == SIMPLEBOX_JOIN_ROWS_PER_BLOCK:
            me.blocks.push(me.buffered_rows.join(""))
            me.buffered_rows = []
        me.output_bytes = me.output_bytes + row.len()

    me finish():
        if me.buffered_rows.len() > 0u64:
            me.blocks.push(me.buffered_rows.join(""))
            me.buffered_rows = []

fn _join_delimiter(spec: text) -> text:
    if spec == "\\t":
        return "\t"
    if spec == "\\\\":
        return "\\"
    if spec.bytes().len() == 1u64:
        return spec
    ""

fn _join_bytes_compare(left: [u8], right: [u8]) -> i64:
    val shared = if left.len() < right.len(): left.len() else: right.len()
    var index: u64 = 0u64
    while index < shared:
        if left[index] < right[index]: return -1
        if left[index] > right[index]: return 1
        index = index + 1u64
    if left.len() < right.len(): return -1
    if left.len() > right.len(): return 1
    0

fn _join_plan(args: [text]) -> SimpleboxJoinPlan:
    var delimiter = " "
    var delimiter_byte: u8 = 32u8
    var whitespace = true
    var delimiter_set = false
    var paths: [text] = []
    var options = true
    var index: u64 = 0u64
    while index < args.len():
        val arg = args[index]
        if options and arg == "--":
            options = false
        elif options and arg == "-t":
            if delimiter_set or index + 1u64 >= args.len():
                return SimpleboxJoinPlan(delimiter: "", delimiter_byte: 0u8,
                    whitespace: false, first_path: "", second_path: "",
                    accepted: false, error: "-t requires one delimiter")
            delimiter = _join_delimiter(args[index + 1u64])
            if delimiter == "":
                return SimpleboxJoinPlan(delimiter: "", delimiter_byte: 0u8,
                    whitespace: false, first_path: "", second_path: "",
                    accepted: false, error: "delimiter must be exactly one supported byte")
            delimiter_byte = delimiter.bytes()[0]
            whitespace = false
            delimiter_set = true
            index = index + 1u64
        elif options and arg.starts_with("-t") and arg.len() > 2u64:
            if delimiter_set:
                return SimpleboxJoinPlan(delimiter: "", delimiter_byte: 0u8,
                    whitespace: false, first_path: "", second_path: "",
                    accepted: false, error: "delimiter specified more than once")
            delimiter = _join_delimiter(arg.slice(2, arg.len()))
            if delimiter == "":
                return SimpleboxJoinPlan(delimiter: "", delimiter_byte: 0u8,
                    whitespace: false, first_path: "", second_path: "",
                    accepted: false, error: "delimiter must be exactly one supported byte")
            delimiter_byte = delimiter.bytes()[0]
            whitespace = false
            delimiter_set = true
        elif options and arg.starts_with("-"):
            return SimpleboxJoinPlan(delimiter: "", delimiter_byte: 0u8,
                whitespace: false, first_path: "", second_path: "",
                accepted: false, error: "unsupported option: " + arg)
        else:
            options = false
            paths.push(arg)
        index = index + 1u64
    if paths.len() != 2u64:
        return SimpleboxJoinPlan(delimiter: "", delimiter_byte: 0u8,
            whitespace: false, first_path: "", second_path: "",
            accepted: false, error: "expected exactly two FILE operands")
    for path in paths:
        if path.len() == 0u64 or path.len() > SIMPLEBOX_PATH_OPERAND_BYTES_LIMIT:
            return SimpleboxJoinPlan(delimiter: "", delimiter_byte: 0u8,
                whitespace: false, first_path: "", second_path: "",
                accepted: false, error: "invalid path length")
    SimpleboxJoinPlan(delimiter: delimiter, delimiter_byte: delimiter_byte,
        whitespace: whitespace, first_path: paths[0], second_path: paths[1],
        accepted: true, error: "")

fn _join_record(line: [u8], plan: SimpleboxJoinPlan) -> SimpleboxJoinRecord:
    var key_start: u64 = 0u64
    var key_end = line.len()
    var remainder_start = line.len()
    var has_remainder = false
    if plan.whitespace:
        while key_start < line.len() and (line[key_start] == 32u8 or line[key_start] == 9u8):
            key_start = key_start + 1u64
        key_end = key_start
        while key_end < line.len() and line[key_end] != 32u8 and line[key_end] != 9u8:
            key_end = key_end + 1u64
        remainder_start = key_end
        while remainder_start < line.len() and (line[remainder_start] == 32u8 or line[remainder_start] == 9u8):
            remainder_start = remainder_start + 1u64
        has_remainder = remainder_start < line.len()
    else:
        var index: u64 = 0u64
        while index < line.len() and line[index] != plan.delimiter_byte:
            index = index + 1u64
        key_end = index
        remainder_start = if index < line.len(): index + 1u64 else: line.len()
        has_remainder = index < line.len()
    SimpleboxJoinRecord(
        key: line.slice(key_start, key_end),
        remainder: line.slice(remainder_start, line.len()),
        has_remainder: has_remainder)

fn _join_read_file(
    path: text, plan: SimpleboxJoinPlan, byte_limit: u64, line_limit: u64
) -> SimpleboxJoinReadState:
    val state = SimpleboxJoinReadState(records: [], pending: [], consumed: 0u64,
        failure: "")
    val opened = file_open_direct(path, 0u32)
    match opened:
        case Err(reason):
            state.failure = path + ": " + reason
            state
        case Ok(fd):
            var complete = false
            while not complete and state.failure == "":
                match file_read_direct(fd, SIMPLEBOX_READ_CHUNK_BYTES):
                    case Err(reason): state.failure = path + ": " + reason
                    case Ok(chunk):
                        if chunk.len() == 0u64:
                            complete = true
                        elif (state.consumed > SIMPLEBOX_FILE_BYTES_LIMIT or
                            state.consumed > byte_limit or
                            chunk.len() > SIMPLEBOX_FILE_BYTES_LIMIT - state.consumed or
                            chunk.len() > byte_limit - state.consumed):
                            state.failure = path + ": input exceeds admitted byte limit"
                        else:
                            state.consumed = state.consumed + chunk.len()
                            var index: u64 = 0u64
                            while index < chunk.len() and state.failure == "":
                                if chunk[index] == 10u8:
                                    state.finish_line(plan, path, line_limit)
                                else:
                                    state.append_byte(chunk[index], path)
                                index = index + 1u64
            if state.failure == "" and state.pending.len() > 0u64:
                state.finish_line(plan, path, line_limit)
            if not file_close_direct(fd) and state.failure == "":
                state.failure = path + ": close failed"
            state

fn _join_row(
    first: SimpleboxJoinRecord, second: SimpleboxJoinRecord,
    delimiter: text
) -> text:
    var parts: [text] = [bytes_to_string(first.key)]
    if first.has_remainder:
        parts.push(delimiter)
        parts.push(bytes_to_string(first.remainder))
    if second.has_remainder:
        parts.push(delimiter)
        parts.push(bytes_to_string(second.remainder))
    parts.push("\n")
    parts.join("")

fn _join_merge(
    first: [SimpleboxJoinRecord], second: [SimpleboxJoinRecord],
    plan: SimpleboxJoinPlan
) -> SimpleboxJoinOutputState:
    val output = SimpleboxJoinOutputState(blocks: [], buffered_rows: [],
        output_bytes: 0u64, failure: "")
    var first_index: u64 = 0u64
    var second_index: u64 = 0u64
    while first_index < first.len() and second_index < second.len() and output.failure == "":
        val first_key = first[first_index].key
        val second_key = second[second_index].key
        val ordering = _join_bytes_compare(first_key, second_key)
        if ordering < 0:
            first_index = first_index + 1u64
        elif ordering > 0:
            second_index = second_index + 1u64
        else:
            output.push_row(_join_row(first[first_index], second[second_index], plan.delimiter))
            first_index = first_index + 1u64
            second_index = second_index + 1u64
    if output.failure == "":
        output.finish()
    output

pub fn simplebox_join(args: [text]) -> i32:
    """Join two bounded sorted files on their first field.

    Supported form: `join [-t BYTE] [--] FILE1 FILE2`, including `-tBYTE`.
    Without `-t`, runs of ASCII space/tab separate fields and output uses one
    space. With `-t`, one literal byte, `\\t`, or `\\\\` is the exact separator.
    Each input must have strictly increasing first-field keys; duplicate keys
    are rejected rather than expanding to a quadratic Cartesian product. Only
    matching rows are emitted as key, FILE1 remainder, FILE2 remainder. Files,
    aggregate bytes, line length/count, and output are bounded. Both inputs
    close before the O(n+m) merge or stdout, and output is block-coalesced.
    """
    val plan = _join_plan(args)
    if not plan.accepted:
        stdout_write("join: " + plan.error + "\n")
        return 2
    val first = _join_read_file(plan.first_path, plan,
        SIMPLEBOX_JOIN_TOTAL_INPUT_BYTES_LIMIT, SIMPLEBOX_JOIN_LINE_LIMIT)
    if first.failure != "":
        stdout_write("join: " + first.failure + "\n")
        return 2
    val second = _join_read_file(plan.second_path, plan,
        SIMPLEBOX_JOIN_TOTAL_INPUT_BYTES_LIMIT - first.consumed,
        SIMPLEBOX_JOIN_LINE_LIMIT - first.records.len())
    if second.failure != "":
        stdout_write("join: " + second.failure + "\n")
        return 2
    val output = _join_merge(first.records, second.records, plan)
    if output.failure != "":
        stdout_write("join: " + output.failure + "\n")
        return 2
    for block in output.blocks:
        stdout_write(block)
    0
