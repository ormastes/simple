# Bounded canonical byte dump for filesystem-launched SimpleOS Simplebox.

use os.userlib.fs.{file_open_direct, file_read_direct, file_close_direct}
use os.tools.simplebox.simplebox_fs_applets.{
    SIMPLEBOX_FILE_BYTES_LIMIT, SIMPLEBOX_READ_CHUNK_BYTES,
    SIMPLEBOX_PATH_OPERAND_BYTES_LIMIT
}

extern fn stdout_write(data: text)

pub const SIMPLEBOX_OD_ROW_BYTES: u64 = 16u64
pub const SIMPLEBOX_OD_ROWS_PER_BLOCK: u64 = 1024u64
pub const SIMPLEBOX_OD_OUTPUT_BYTES_LIMIT: u64 = 67108864u64

struct SimpleboxOdPlan:
    show_addresses: bool
    path: text
    accepted: bool
    error: text

struct SimpleboxOdState:
    blocks: [text]
    buffered_rows: [text]
    pending: [u8]
    consumed: u64
    output_bytes: u64
    failure: text

fn _od_hex_digit(value: u8) -> text:
    val digits = "0123456789abcdef"
    digits.slice(value.to_i64(), value.to_i64() + 1)

fn _od_hex_byte(value: u8) -> text:
    _od_hex_digit(value / 16u8) + _od_hex_digit(value % 16u8)

fn _od_hex_offset(value: u64) -> text:
    var digits: [text] = []
    var divisor: u64 = 1152921504606846976u64 # 16^15
    var remaining = value
    var index: u64 = 0u64
    while index < 16u64:
        val digit = (remaining / divisor).to_u8()
        digits.push(_od_hex_digit(digit))
        remaining = remaining % divisor
        if divisor > 1u64:
            divisor = divisor / 16u64
        index = index + 1u64
    digits.join("")

fn _od_plan(args: [text]) -> SimpleboxOdPlan:
    var show_addresses = true
    var path = ""
    var options = true
    var index: u64 = 0u64
    while index < args.len():
        val arg = args[index]
        if options and arg == "--":
            options = false
        elif options and arg == "-An":
            show_addresses = false
        elif options and arg == "-Ax":
            show_addresses = true
        elif options and arg == "-tx1":
            pass_do_nothing("canonical byte-hex format is already selected")
        elif options and arg.starts_with("-"):
            return SimpleboxOdPlan(show_addresses: true, path: "", accepted: false,
                error: "unsupported option: " + arg)
        elif path != "":
            return SimpleboxOdPlan(show_addresses: true, path: "", accepted: false,
                error: "expected exactly one FILE operand")
        else:
            path = arg
            options = false
        index = index + 1u64
    if path == "":
        return SimpleboxOdPlan(show_addresses: true, path: "", accepted: false,
            error: "missing FILE operand")
    if path.len() > SIMPLEBOX_PATH_OPERAND_BYTES_LIMIT:
        return SimpleboxOdPlan(show_addresses: true, path: "", accepted: false,
            error: "invalid path length")
    SimpleboxOdPlan(show_addresses: show_addresses, path: path,
        accepted: true, error: "")

fn _od_finish_row(prior: SimpleboxOdState, show_addresses: bool) -> SimpleboxOdState:
    var state = prior
    val row_offset = state.consumed - state.pending.len()
    var parts: [text] = []
    if show_addresses:
        parts.push(_od_hex_offset(row_offset))
    var index: u64 = 0u64
    while index < state.pending.len():
        if show_addresses or index > 0u64:
            parts.push(" ")
        parts.push(_od_hex_byte(state.pending[index]))
        index = index + 1u64
    parts.push("\n")
    val row = parts.join("")
    if row.len() > SIMPLEBOX_OD_OUTPUT_BYTES_LIMIT - state.output_bytes:
        state.failure = "output exceeds simplebox byte limit"
        return state
    state.buffered_rows.push(row)
    if state.buffered_rows.len() == SIMPLEBOX_OD_ROWS_PER_BLOCK:
        state.blocks.push(state.buffered_rows.join(""))
        state.buffered_rows = []
    state.output_bytes = state.output_bytes + row.len()
    state.pending = []
    state

fn _od_finish_offset(prior: SimpleboxOdState) -> SimpleboxOdState:
    var state = prior
    val row = _od_hex_offset(state.consumed) + "\n"
    if row.len() > SIMPLEBOX_OD_OUTPUT_BYTES_LIMIT - state.output_bytes:
        state.failure = "output exceeds simplebox byte limit"
        return state
    state.buffered_rows.push(row)
    state.output_bytes = state.output_bytes + row.len()
    state

fn _od_read(plan: SimpleboxOdPlan) -> SimpleboxOdState:
    var state = SimpleboxOdState(blocks: [], buffered_rows: [], pending: [],
        consumed: 0u64, output_bytes: 0u64, failure: "")
    val opened = file_open_direct(plan.path, 0u32)
    match opened:
        case Err(reason):
            state.failure = plan.path + ": " + reason
            state
        case Ok(fd):
            var complete = false
            while not complete and state.failure == "":
                match file_read_direct(fd, SIMPLEBOX_READ_CHUNK_BYTES):
                    case Err(reason): state.failure = plan.path + ": " + reason
                    case Ok(chunk):
                        if chunk.len() == 0u64:
                            complete = true
                        elif chunk.len() > SIMPLEBOX_FILE_BYTES_LIMIT - state.consumed:
                            state.failure = plan.path + ": file exceeds simplebox byte limit"
                        else:
                            var index: u64 = 0u64
                            while index < chunk.len() and state.failure == "":
                                state.pending.push(chunk[index])
                                state.consumed = state.consumed + 1u64
                                if state.pending.len() == SIMPLEBOX_OD_ROW_BYTES:
                                    state = _od_finish_row(state, plan.show_addresses)
                                index = index + 1u64
            if state.failure == "" and state.pending.len() > 0u64:
                state = _od_finish_row(state, plan.show_addresses)
            if state.failure == "" and plan.show_addresses:
                state = _od_finish_offset(state)
            if not file_close_direct(fd) and state.failure == "":
                state.failure = plan.path + ": close failed"
            if state.failure == "" and state.buffered_rows.len() > 0u64:
                state.blocks.push(state.buffered_rows.join(""))
                state.buffered_rows = []
            state

pub fn simplebox_od(args: [text]) -> i32:
    """Dump one bounded file as deterministic hexadecimal bytes.

    The supported subset is `od [-Ax|-An] [-tx1] [--] FILE`. Output uses
    16-byte rows, lowercase hexadecimal, and 16-digit hexadecimal offsets.
    The default is `-Ax -tx1`; `-An` suppresses offsets. Stdin, offset/length
    operands, duplicate elision, other formats, and unbounded input are
    rejected. The whole read and close are admitted before output begins.
    """
    val plan = _od_plan(args)
    if not plan.accepted:
        stdout_write("od: " + plan.error + "\n")
        return 2
    val state = _od_read(plan)
    if state.failure != "":
        stdout_write("od: " + state.failure + "\n")
        return 2
    for block in state.blocks:
        stdout_write(block)
    0
