# Lean VirtIO-input wire contract shared by freestanding MMIO and translators.

class VirtioInputEvent:
    device_kind: u32
    type_: u16
    code: u16
    value: u32
    irq_status: u32

val VIRTIO_INPUT_DEVICE_KEYBOARD: u32 = 1
val VIRTIO_INPUT_DEVICE_POINTER: u32 = 2

export VirtioInputEvent, VIRTIO_INPUT_DEVICE_KEYBOARD, VIRTIO_INPUT_DEVICE_POINTER
