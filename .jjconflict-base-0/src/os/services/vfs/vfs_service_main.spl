# Root-catalogue VFS payload.
#
# This owns a task-local NVMe driver, bounded block adapter, concrete FAT32
# Filesystem implementation, and the named `vfs` IPC endpoint. It never calls
# vfs_boot_init or reads the kernel-global VFS singleton.

use os.drivers.nvme.nvme_driver.{NvmeDriver}
use os.kernel.types.capability_types.{SIMPLEOS_NVME_SYSTEM_QUEUE_ID}
use os.kernel.types.fs_types.{FileFlags, FsNode, DirEntry}
use os.services.fat32.shared_fat32_driver.{SharedFat32Driver}
use os.services.vfs.vfs.{VfsManager, Filesystem, SeekWhence}
use os.services.vfs.vfs_block_adapters.{NvmeBlockAdapter}
use os.services.vfs.vfs_service.{VfsService}
use os.userlib.device.{request_assigned_device_grant}

class BrokeredFat32Filesystem:
    driver: SharedFat32Driver

impl BrokeredFat32Filesystem:
    static fn new(adapter: NvmeBlockAdapter) -> BrokeredFat32Filesystem:
        BrokeredFat32Filesystem(driver: SharedFat32Driver.new(adapter))

impl Filesystem for BrokeredFat32Filesystem:
    fn fs_name() -> text:
        "fat32-brokered"

    fn mount(device: text, options: text) -> Result<bool, text>:
        self.driver.mount(device, options)

    fn unmount() -> Result<bool, text>:
        self.driver.unmount_service()

    fn open(path: text, flags: FileFlags) -> Result<u64, text>:
        self.driver.open(path, flags)

    fn read(handle: u64, size: u64) -> Result<[u8], text>:
        self.driver.read(handle, size)

    fn write(handle: u64, data: [u8]) -> Result<u64, text>:
        self.driver.write(handle, data)

    fn close(handle: u64) -> Result<bool, text>:
        self.driver.close(handle)

    fn seek(handle: u64, offset: i64, whence: SeekWhence) -> Result<u64, text>:
        match whence:
            SeekWhence.Set: self.driver.seek_absolute(handle, offset)
            SeekWhence.Cur: Err("FAT32 relative seek is not available in service ABI")
            SeekWhence.End: Err("FAT32 end-relative seek is not available in service ABI")

    fn stat(path: text) -> Result<FsNode, text>:
        self.driver.stat(path)

    fn chmod(path: text, mode: u16) -> Result<bool, text>:
        Err("FAT32 chmod unsupported")

    fn mkdir(path: text) -> Result<bool, text>:
        self.driver.mkdir(path)

    fn rmdir(path: text) -> Result<bool, text>:
        Err("FAT32 rmdir unsupported")

    fn readdir(path: text) -> Result<[DirEntry], text>:
        self.driver.readdir(path)

    fn unlink(path: text) -> Result<bool, text>:
        self.driver.unlink_text(path)

    fn rename(old_path: text, new_path: text) -> Result<bool, text>:
        self.driver.rename_text(old_path, new_path)

    fn symlink(target: text, link_path: text) -> Result<bool, text>:
        Err("FAT32 symlink unsupported")

fn vfs_service_main() -> i32:
    val grant_result = request_assigned_device_grant()
    if grant_result.is_err():
        return 1
    var nvme = NvmeDriver.new()
    val initialized = nvme.init_from_grant(grant_result.unwrap())
    if initialized.is_err():
        return 2
    var adapter = NvmeBlockAdapter.for_identified_namespace_unchecked(
        nvme, 1u32, SIMPLEOS_NVME_SYSTEM_QUEUE_ID, 0u64,
        nvme.get_sector_count(), nvme.get_sector_size(), "fat32"
    )
    val bounce = adapter.init_bounce_buffer()
    if bounce.is_err():
        return 3
    var manager = VfsManager.new()
    val fs = BrokeredFat32Filesystem.new(adapter)
    val mounted = manager.mount("/", "fat32", "brokered-nvme", false, fs)
    if mounted.is_err():
        return 4
    var service = VfsService.new(manager)
    if not service.start_catalogue_owned():
        return 5
    0

fn main(argv: [text]) -> i32:
    vfs_service_main()
