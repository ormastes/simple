# Service Manifest — Typed service_v1 lifecycle contract (SVC lane)
#
# Master plan: doc/01_research/domain/simpleos_production_host_master_plan.md
#   §4  service_v1  — shared ABI: lifecycle, readiness, health, supervision
#   §20 service health / watchdog / restart facilities
#   §21 invariant: "service restart cannot retain stale device or secret grants"
#
# This module is the TYPED contract that generalizes the ad-hoc per-service
# ready() bools in src/os/kernel/boot/init_services.spl. It is compatible with —
# not a duplicate of — src/os/services/driver_supervisor/{supervisor,grant_broker}.spl:
#   * supervisor.spl owns the live restart mechanism (spawn/ping/regrant).
#   * grant_broker.spl owns issuance/revocation of device grant tokens.
#   * ServiceManifest here is the declarative, side-effect-free descriptor a
#     service publishes, plus the pure lifecycle/health/restart state machine a
#     supervisor evaluates against it. on_restart() encodes the §21 invariant so
#     any supervisor that respawns from a manifest starts with zero stale grants.
#
# Pure model: no live IO, no syscalls, no extern rt_*. Freestanding-safe.
# ============================================================================

# ----------------------------------------------------------------------------
# Lifecycle state names (string constants — readable absolute oracles)
#   Registered -> Starting -> Ready -> (Degraded | Failed) -> Stopping -> Stopped
#   with a Restarting sub-path re-entering Starting after grants are cleared.
# ----------------------------------------------------------------------------
val STATE_REGISTERED: text = "Registered"
val STATE_STARTING: text = "Starting"
val STATE_READY: text = "Ready"
val STATE_DEGRADED: text = "Degraded"
val STATE_FAILED: text = "Failed"
val STATE_STOPPING: text = "Stopping"
val STATE_STOPPED: text = "Stopped"
val STATE_RESTARTING: text = "Restarting"

# Restart policies (mirrors driver_supervisor intent)
val POLICY_NEVER: text = "never"
val POLICY_ON_FAILURE: text = "on_failure"
val POLICY_ALWAYS: text = "always"

# ============================================================================
# ServiceManifest — the typed service_v1 descriptor + lifecycle carrier
# ============================================================================

class ServiceManifest:
    """Typed declaration of a service plus its live lifecycle state.

    required_capabilities / granted_handles are grant ids or labels (as issued
    by grant_broker.spl). readiness_deps are service names that must be Ready
    before this service may start.
    """
    name: text
    version: text
    required_capabilities: [text]      # grant ids/labels the service needs
    readiness_deps: [text]             # service names that must be Ready first
    health_check_kind: text            # "none" | "ping" | "heartbeat"
    restart_policy: text               # never | on_failure | always
    max_restarts: i64                  # cap within the restart window
    restart_count: i64                 # restarts consumed so far
    watchdog_timeout_ms: i64           # 0 disables the watchdog
    last_heartbeat_ms: i64             # timestamp of last observed heartbeat
    granted_handles: [text]            # device/secret grant ids currently HELD
    state: text                        # one of STATE_*

impl ServiceManifest:
    static fn create(name: text, version: text) -> ServiceManifest:
        """Create a freshly-Registered manifest with safe defaults."""
        ServiceManifest(
            name: name,
            version: version,
            required_capabilities: [],
            readiness_deps: [],
            health_check_kind: "none",
            restart_policy: POLICY_ON_FAILURE,
            max_restarts: 3,
            restart_count: 0,
            watchdog_timeout_ms: 0,
            last_heartbeat_ms: 0,
            granted_handles: [],
            state: STATE_REGISTERED
        )

# ----------------------------------------------------------------------------
# Internal clone helper — single construction site so every transition copies
# ALL declarative fields and varies only the lifecycle-mutable ones.
# ----------------------------------------------------------------------------
fn _clone(m: ServiceManifest, new_state: text, new_restart_count: i64,
          new_handles: [text], new_heartbeat: i64) -> ServiceManifest:
    ServiceManifest(
        name: m.name,
        version: m.version,
        required_capabilities: m.required_capabilities,
        readiness_deps: m.readiness_deps,
        health_check_kind: m.health_check_kind,
        restart_policy: m.restart_policy,
        max_restarts: m.max_restarts,
        restart_count: new_restart_count,
        watchdog_timeout_ms: m.watchdog_timeout_ms,
        last_heartbeat_ms: new_heartbeat,
        granted_handles: new_handles,
        state: new_state
    )

fn _list_contains(xs: [text], target: text) -> bool:
    for x in xs:
        if x == target:
            return true
    false

# ============================================================================
# Pure lifecycle / health / restart functions
# ============================================================================

fn can_start(m: ServiceManifest, ready_set: [text]) -> bool:
    """True only when every readiness dependency is present in ready_set."""
    for dep in m.readiness_deps:
        if not _list_contains(ready_set, dep):
            return false
    true

fn mark_starting(m: ServiceManifest) -> ServiceManifest:
    """Registered/Restarting -> Starting."""
    _clone(m, STATE_STARTING, m.restart_count, m.granted_handles, m.last_heartbeat_ms)

fn mark_ready(m: ServiceManifest) -> ServiceManifest:
    """Starting -> Ready (service reported up)."""
    _clone(m, STATE_READY, m.restart_count, m.granted_handles, m.last_heartbeat_ms)

fn record_heartbeat(m: ServiceManifest, now_ms: i64) -> ServiceManifest:
    """Record a fresh heartbeat timestamp (feeds the watchdog)."""
    _clone(m, m.state, m.restart_count, m.granted_handles, now_ms)

fn record_health(m: ServiceManifest, ok: bool) -> ServiceManifest:
    """Apply a health-check result.

    ok  : keeps/returns to Ready.
    !ok : Ready -> Degraded, then Degraded/Failed -> Failed (degrade then fail
          on repeated failures).
    """
    if ok:
        return _clone(m, STATE_READY, m.restart_count, m.granted_handles, m.last_heartbeat_ms)
    if m.state == STATE_READY:
        return _clone(m, STATE_DEGRADED, m.restart_count, m.granted_handles, m.last_heartbeat_ms)
    # already Degraded/Failed (or otherwise unhealthy) -> Failed
    _clone(m, STATE_FAILED, m.restart_count, m.granted_handles, m.last_heartbeat_ms)

fn check_watchdog(m: ServiceManifest, now_ms: i64) -> ServiceManifest:
    """A Ready service past its watchdog deadline with no heartbeat -> Failed.

    watchdog_timeout_ms == 0 disables the watchdog.
    """
    if m.watchdog_timeout_ms <= 0:
        return m
    if m.state != STATE_READY:
        return m
    val elapsed = now_ms - m.last_heartbeat_ms
    if elapsed > m.watchdog_timeout_ms:
        return _clone(m, STATE_FAILED, m.restart_count, m.granted_handles, m.last_heartbeat_ms)
    m

fn should_restart(policy: text, restart_count: i64, max_restarts: i64) -> bool:
    """Restart-storm bound: never => false; otherwise deny once count hits max."""
    if policy == POLICY_NEVER:
        return false
    restart_count < max_restarts

fn on_restart(m: ServiceManifest) -> ServiceManifest:
    """§21 invariant: a restarted service retains NO stale device/secret grants.

    Returns a manifest whose granted_handles is CLEARED (empty), restart_count
    incremented, and state set to Restarting. The service must re-acquire every
    grant from the broker after respawn — none carry across the restart.
    """
    val cleared: [text] = []
    _clone(m, STATE_RESTARTING, m.restart_count + 1, cleared, m.last_heartbeat_ms)

fn mark_stopping(m: ServiceManifest) -> ServiceManifest:
    """Any live state -> Stopping (grants still held until Stopped)."""
    _clone(m, STATE_STOPPING, m.restart_count, m.granted_handles, m.last_heartbeat_ms)

fn mark_stopped(m: ServiceManifest) -> ServiceManifest:
    """Stopping -> Stopped, releasing all grants (empty granted_handles)."""
    val cleared: [text] = []
    _clone(m, STATE_STOPPED, m.restart_count, cleared, m.last_heartbeat_ms)

fn holds_grants(m: ServiceManifest) -> bool:
    """True while the manifest still holds at least one device/secret grant."""
    m.granted_handles.len() > 0
