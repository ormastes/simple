# SSH encrypted-epoch traffic accounting.
#
# The live session owns the mutable counters.  This module is deliberately
# scalar-only: packet hot paths can decide whether an epoch remains admissible
# without allocating, copying payloads, or dispatching outside the owner.

pub val SSH_REKEY_PACKET_SOFT_LIMIT_V1: u64 = 2147483648u64
pub val SSH_REKEY_PACKET_HARD_LIMIT_V1: u64 = 4294901760u64
pub val SSH_REKEY_BYTE_SOFT_LIMIT_V1: u64 = 1073741824u64
pub val SSH_REKEY_BYTE_HARD_LIMIT_V1: u64 = 1082130432u64

pub struct SshRekeyCounterCommitV1:
    allowed: bool
    packets: u64
    bytes: u64
    rekey_due: bool

pub fn ssh_rekey_counter_can_admit_v1(
    packets: u64, bytes: u64, frame_bytes: u64
) -> bool:
    packets < SSH_REKEY_PACKET_HARD_LIMIT_V1 and
        bytes < SSH_REKEY_BYTE_HARD_LIMIT_V1 and
        frame_bytes < SSH_REKEY_BYTE_HARD_LIMIT_V1 - bytes

pub fn ssh_rekey_wire_sequence_allowed_v1(sequence: u32) -> bool:
    """Keep every cipher invocation below the lifetime u32 wrap boundary."""
    sequence.to_u64() < SSH_REKEY_PACKET_HARD_LIMIT_V1

pub fn ssh_rekey_counter_commit_v1(
    packets: u64, bytes: u64, committed_bytes: u64
) -> SshRekeyCounterCommitV1:
    """Account exactly one authenticated or exactly-delivered encrypted frame.

    Reject before either counter can overflow or reach the conservative hard
    epoch boundary.  The soft boundary leaves eight MiB of byte headroom and
    almost 2^31 packets for the synchronous KEX exchange itself.
    """
    if not ssh_rekey_counter_can_admit_v1(packets, bytes, committed_bytes):
        return SshRekeyCounterCommitV1(
            allowed: false, packets: packets, bytes: bytes, rekey_due: true)
    val next_packets = packets + 1u64
    val next_bytes = bytes + committed_bytes
    if next_packets >= SSH_REKEY_PACKET_HARD_LIMIT_V1 or
        next_bytes >= SSH_REKEY_BYTE_HARD_LIMIT_V1:
        return SshRekeyCounterCommitV1(
            allowed: false, packets: packets, bytes: bytes, rekey_due: true)
    SshRekeyCounterCommitV1(
        allowed: true,
        packets: next_packets,
        bytes: next_bytes,
        rekey_due: next_packets >= SSH_REKEY_PACKET_SOFT_LIMIT_V1 or
            next_bytes >= SSH_REKEY_BYTE_SOFT_LIMIT_V1
    )

pub fn ssh_rekey_epoch_due_v1(
    c2s_packets: u64, c2s_bytes: u64,
    s2c_packets: u64, s2c_bytes: u64
) -> bool:
    c2s_packets >= SSH_REKEY_PACKET_SOFT_LIMIT_V1 or
        c2s_bytes >= SSH_REKEY_BYTE_SOFT_LIMIT_V1 or
        s2c_packets >= SSH_REKEY_PACKET_SOFT_LIMIT_V1 or
        s2c_bytes >= SSH_REKEY_BYTE_SOFT_LIMIT_V1

export SshRekeyCounterCommitV1, ssh_rekey_counter_can_admit_v1, ssh_rekey_counter_commit_v1, ssh_rekey_wire_sequence_allowed_v1, ssh_rekey_epoch_due_v1
