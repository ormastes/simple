# Authenticated application-byte HTTP/1.1 + RFC6455 connection owner for WEB.

use os.userlib.net.{Socket, socket_recv, socket_send_range}
use std.nogc_sync_mut.http_server.server.{SecureServerPolicy}
use std.nogc_sync_mut.http_server.types.{HttpResponse, HttpStatus}
use std.nogc_sync_mut.http_server.response.{
    serialize_response_head_for_body_length_connection,
    with_default_security_headers
}
use std.fs_driver.bytes_util.{text_to_bytes_pure}
use os.apps.servers_user.http1_request_frame_owner.{Http1RequestFrameOwner}
use os.apps.servers_user.rfc6455_server_owner.{
    Rfc6455ServerConnectionOwner, Rfc6455ServerEvent,
    validate_rfc6455_server_handshake
}
use os.apps.servers_user.web_tls_stream_owner.{
    WebTlsStreamOwnerV1, WebTlsSendKindV1
}

pub val WEB_TLS_HTTP_MAX_RECORD_READS_V1: i32 = 200
pub val WEB_TLS_WS_MAX_RECORD_READS_V1: i32 = 4096
pub val WEB_TLS_SOCKET_READ_BYTES_V1: u64 = 8192u64
pub val WEB_TLS_HTTP_HEAD_ALLOWANCE_V1: i64 = 1024
pub val WEB_TLS_HTTP_MAX_STATIC_ASSET_V1: u64 = 64512u64

fn _web_tls_send_application_v1(
    socket: Socket, stream: WebTlsStreamOwnerV1, plaintext: [u8]
) -> bool:
    if not stream.begin_application(plaintext): return false
    while stream.has_response_bytes() or stream.has_pending_send():
        val prepared = stream.prepare_next()
        if prepared.kind == WebTlsSendKindV1.None: return false
        var sent: u64 = 0u64
        while sent < prepared.wire_bytes.len():
            match socket_send_range(socket, prepared.wire_bytes, sent, 4096u64):
                case Err(_):
                    val _ = stream.abort_send(prepared.token, sent.to_i64())
                    return false
                case Ok(progress):
                    if progress.0 == 0u64:
                        val _ = stream.abort_send(prepared.token, sent.to_i64())
                        return false
                    sent = sent + progress.0
        if not stream.commit_send(prepared.token): return false
    true

fn _web_tls_send_close_v1(socket: Socket, stream: WebTlsStreamOwnerV1):
    if not stream.request_local_close(): return
    val prepared = stream.prepare_next()
    if prepared.kind != WebTlsSendKindV1.CloseNotify: return
    var sent: u64 = 0u64
    while sent < prepared.wire_bytes.len():
        match socket_send_range(socket, prepared.wire_bytes, sent, 4096u64):
            case Err(_):
                val _ = stream.abort_send(prepared.token, sent.to_i64())
                return
            case Ok(progress):
                if progress.0 == 0u64:
                    val _ = stream.abort_send(prepared.token, sent.to_i64())
                    return
                sent = sent + progress.0
    val _ = stream.commit_send(prepared.token)

fn _web_tls_send_reciprocal_close_v1(
    socket: Socket, stream: WebTlsStreamOwnerV1
) -> bool:
    # PeerClosed is already the canonical close request. Do not call
    # request_local_close(), which correctly accepts only Open.
    val prepared = stream.prepare_next()
    if prepared.kind != WebTlsSendKindV1.CloseNotify: return false
    var sent: u64 = 0u64
    while sent < prepared.wire_bytes.len():
        match socket_send_range(socket, prepared.wire_bytes, sent, 4096u64):
            case Err(_):
                val _ = stream.abort_send(prepared.token, sent.to_i64())
                return false
            case Ok(progress):
                if progress.0 == 0u64:
                    val _ = stream.abort_send(prepared.token, sent.to_i64())
                    return false
                sent = sent + progress.0
    stream.commit_send(prepared.token)

fn _web_tls_send_ws_events_v1(
    socket: Socket, stream: WebTlsStreamOwnerV1, events: [Rfc6455ServerEvent]
) -> bool:
    for event in events:
        if event.outbound.len() > 0u64 and
            not _web_tls_send_application_v1(socket, stream, event.outbound):
            return false
    true

fn _web_tls_http_response_v1(request: text, static_asset: [u8]) -> [u8]:
    val line_end = request.find("\r\n")
    val line = if line_end < 0: "" else: request.slice(0, line_end)
    val head_only = line.starts_with("HEAD ")
    val allowed = (line.starts_with("GET / HTTP/1.1") or
        line.starts_with("HEAD / HTTP/1.1") or
        line.starts_with("GET /SERVER.HTM HTTP/1.1") or
        line.starts_with("HEAD /SERVER.HTM HTTP/1.1"))
    val response = with_default_security_headers(HttpResponse(
        status: if allowed: HttpStatus.Ok else: HttpStatus.NotFound,
        headers: [("Content-Type", "text/html; charset=utf-8")],
        body: ""), false)
    val body = if allowed: static_asset else: text_to_bytes_pure("ERR route not found\n")
    val head = text_to_bytes_pure(
        serialize_response_head_for_body_length_connection(
            response, body.len().to_i64(), true))
    val wire = if head_only: head else: head + body
    if (head.len().to_i64() > WEB_TLS_HTTP_HEAD_ALLOWANCE_V1 or
        wire.len().to_i64() > WEB_TLS_HTTP_HEAD_ALLOWANCE_V1 +
            WEB_TLS_HTTP_MAX_STATIC_ASSET_V1.to_i64()):
        return []
    wire

fn _web_tls_ws_loop_v1(
    socket: Socket, stream: WebTlsStreamOwnerV1,
    initial: [u8]
) -> bool:
    var protocol = Rfc6455ServerConnectionOwner.create()
    val events = protocol.append_tail(initial)
    if not _web_tls_send_ws_events_v1(socket, stream, events): return false
    var reads: i32 = 0
    while reads < WEB_TLS_WS_MAX_RECORD_READS_V1 and not protocol.is_terminal():
        match socket_recv(socket, WEB_TLS_SOCKET_READ_BYTES_V1):
            case Err(_): return false
            case Ok(wire):
                if wire.len() == 0u64: return stream.transport_eof()
                var ingress = stream.ingest(wire)
                if ingress.reciprocal_close_required:
                    val _ = ingress.ingress.zeroize_plaintext_frames()
                    return _web_tls_send_reciprocal_close_v1(socket, stream)
                if not ingress.authenticated_frames_dispatchable:
                    val _ = ingress.ingress.zeroize_plaintext_frames()
                    return false
                for frame in ingress.ingress.plaintext_frames:
                    val appended = protocol.append_tail(frame)
                    if not _web_tls_send_ws_events_v1(
                        socket, stream, appended):
                        val _ = ingress.ingress.zeroize_plaintext_frames()
                        return false
                val _ = ingress.ingress.zeroize_plaintext_frames()
        reads = reads + 1
    if protocol.is_terminal(): return true
    # A bounded lifecycle stop emits RFC6455 Going Away (1001) before TLS close.
    _web_tls_send_ws_events_v1(
        socket, stream, [protocol.close_for_policy()])

pub fn web_tls_http1_handle_v1(
    socket: Socket, stream: WebTlsStreamOwnerV1, static_asset: [u8]
) -> bool:
    var framer = Http1RequestFrameOwner.create(SecureServerPolicy.production())
    var reads: i32 = 0
    while not framer.terminal() and reads < WEB_TLS_HTTP_MAX_RECORD_READS_V1:
        match socket_recv(socket, WEB_TLS_SOCKET_READ_BYTES_V1):
            case Err(_): return false
            case Ok(wire):
                if wire.len() == 0u64: return stream.transport_eof()
                var ingress = stream.ingest(wire)
                if ingress.reciprocal_close_required:
                    val _ = ingress.ingress.zeroize_plaintext_frames()
                    return _web_tls_send_reciprocal_close_v1(socket, stream)
                if not ingress.authenticated_frames_dispatchable:
                    val _ = ingress.ingress.zeroize_plaintext_frames()
                    return false
                for frame in ingress.ingress.plaintext_frames:
                    if not framer.terminal(): framer.append(frame)
                val _ = ingress.ingress.zeroize_plaintext_frames()
        reads = reads + 1
    val framed = framer.result()
    if not framed.complete: return false
    if framed.websocket_upgrade_candidate:
        if (not framed.request.starts_with("GET /ws HTTP/1.1\r\n") and
            not framed.request.starts_with("GET /ws?")):
            return false
        val decision = validate_rfc6455_server_handshake(framed.request)
        if not decision.accepted: return false
        if not _web_tls_send_application_v1(
            socket, stream, text_to_bytes_pure(decision.response)): return false
        val served = _web_tls_ws_loop_v1(socket, stream, framed.upgrade_tail)
        _web_tls_send_close_v1(socket, stream)
        return served
    val response = _web_tls_http_response_v1(framed.request, static_asset)
    if response.len() == 0u64: return false
    val sent = _web_tls_send_application_v1(socket, stream, response)
    _web_tls_send_close_v1(socket, stream)
    sent

export web_tls_http1_handle_v1
export WEB_TLS_HTTP_MAX_RECORD_READS_V1, WEB_TLS_WS_MAX_RECORD_READS_V1
export WEB_TLS_HTTP_HEAD_ALLOWANCE_V1, WEB_TLS_HTTP_MAX_STATIC_ASSET_V1
