# Authenticated, bounded HTTP/2 frame/control foundation. It owns no network
# stream or close operation. Its bounded receive-only request child deliberately
# rejects Huffman strings, trailers, and response generation in this V1 profile.

use std.http.h2.h2_frame.{H2Frame, H2SettingsFrame, H2Setting, H2PingFrame, H2GoawayFrame, H2_DEFAULT_MAX_FRAME_SIZE, H2_FLAG_ACK, H2_SETTINGS_MAX_FRAME_SIZE, H2_SETTINGS_INITIAL_WINDOW_SIZE, H2_SETTINGS_MAX_CONCURRENT_STREAMS, H2_SETTINGS_HEADER_TABLE_SIZE, H2_SETTINGS_ENABLE_PUSH, H2_ERR_PROTOCOL_ERROR}
use std.http.h2.h2_parser.{H2BoundedParseResult, h2_parse_frame_bounded}
use std.http.h2.h2_writer.{h2_write_frame}
use std.http.h2.h2_preface.{h2_connection_preface_bytes, H2_CONNECTION_PREFACE_LEN}
use os.apps.servers_user.web_h2_request_owner_v1.{WebH2RequestOwnerV1, WebH2RequestFrameResultV1, WebH2RequestFrameStatusV1, WebH2RequestEventV1, WEB_H2_MAX_ACTIVE_STREAMS_V1}
use os.apps.servers_user.web_h2_response_authority_v1.{WebH2ResponseOwnerBindingV1, WebH2ResponseAdmissionReceiptV1, WebH2LocalGoawayCutoffV1}

pub val WEB_H2_CONTROL_MAX_BUFFERED_PLAINTEXT_V1: i64 = 65536
pub val WEB_H2_CONTROL_MAX_WINDOW_V1: i64 = 2147483647
pub val WEB_H2_CONTROL_MAX_PING_DEBTS_V1: i64 = 16
pub val WEB_H2_CONTROL_MAX_SETTINGS_ACK_DEBTS_V1: i64 = 16

pub enum WebH2ControlStatusV1:
    AwaitingClientPreface
    AwaitingClientSettings
    ControlReady
    Failed

pub enum WebH2ControlFeedStatusV1:
    Accepted
    NeedMore
    RejectedUnauthenticated
    ProtocolError
    Overflow

pub enum WebH2ControlSendKindV1:
    None
    ServerSettings
    SettingsAck
    PingAck
    Goaway

pub enum H2OrderedInboundActionKindV1:
    Request
    Control
    SettingsInitialWindow(new_window: i64, delta: i64)
    ConnectionWindowUpdate(increment: i64)
    StreamWindowUpdate(stream_id: i64, increment: i64)
    PeerGoaway

pub class H2OrderedInboundActionV1:
    """One parsed frame's effects, retained in exact wire order."""
    frame: H2Frame
    kind: H2OrderedInboundActionKindV1
    request_events: [WebH2RequestEventV1]
    response_admissions: [WebH2ResponseAdmissionReceiptV1]

pub class WebH2ControlFeedResultV1:
    status: WebH2ControlFeedStatusV1
    admitted_control_frames: [H2Frame]
    settings_ack_required: bool
    request_events: [WebH2RequestEventV1]
    response_admissions: [WebH2ResponseAdmissionReceiptV1]
    ordered_actions: [H2OrderedInboundActionV1]
    protocol_error_code: i64
    close_after_error_goaway: bool
    blocker: text

pub class WebH2PreparedControlRecordV1:
    token: i64
    kind: WebH2ControlSendKindV1
    wire_bytes: [u8]

fn _control_settings() -> [H2Setting]:
    [H2Setting(identifier: H2_SETTINGS_HEADER_TABLE_SIZE, value: 4096), H2Setting(identifier: H2_SETTINGS_ENABLE_PUSH, value: 0), H2Setting(identifier: H2_SETTINGS_MAX_CONCURRENT_STREAMS, value: WEB_H2_MAX_ACTIVE_STREAMS_V1), H2Setting(identifier: H2_SETTINGS_INITIAL_WINDOW_SIZE, value: 65535), H2Setting(identifier: H2_SETTINGS_MAX_FRAME_SIZE, value: H2_DEFAULT_MAX_FRAME_SIZE)]

fn _empty_feed(status: WebH2ControlFeedStatusV1, blocker: text) -> WebH2ControlFeedResultV1:
    WebH2ControlFeedResultV1(status: status, admitted_control_frames: [], settings_ack_required: false, request_events: [], response_admissions: [], ordered_actions: [], protocol_error_code: (if status == WebH2ControlFeedStatusV1.ProtocolError or status == WebH2ControlFeedStatusV1.Overflow: H2_ERR_PROTOCOL_ERROR else: 0), close_after_error_goaway: status == WebH2ControlFeedStatusV1.ProtocolError or status == WebH2ControlFeedStatusV1.Overflow, blocker: blocker)

fn _copy_control_bytes(source: [u8]) -> [u8]:
    var copied: [u8] = []
    for byte in source: copied.push(byte)
    copied

pub class WebH2ControlOwnerV1:
    status: WebH2ControlStatusV1
    inbound: [u8]
    preface_offset: i64
    peer_max_frame_size: i64
    peer_initial_stream_window: i64
    server_settings_committed: bool
    server_settings_ack_owed: bool
    settings_acks_owed: i64
    ping_ack_debts: [[u8]]
    pending_token: i64
    pending_kind: WebH2ControlSendKindV1
    pending_wire_bytes: [u8]
    next_token: i64
    goaway_committed: bool
    response_connection_epoch: u64
    response_owner_instance: u64
    error_goaway_attempts: i64
    coordinator_error_code: i64
    coordinator_error_last_completed: i64
    coordinator_poisoned: bool
    request_owner: WebH2RequestOwnerV1

    pub static fn create() -> WebH2ControlOwnerV1:
        WebH2ControlOwnerV1(status: WebH2ControlStatusV1.AwaitingClientPreface, inbound: [], preface_offset: 0, peer_max_frame_size: H2_DEFAULT_MAX_FRAME_SIZE, peer_initial_stream_window: 65535, server_settings_committed: false, server_settings_ack_owed: false, settings_acks_owed: 0, ping_ack_debts: [], pending_token: 0, pending_kind: WebH2ControlSendKindV1.None, pending_wire_bytes: [], next_token: 1, goaway_committed: false, response_connection_epoch: 0u64, response_owner_instance: 0u64, error_goaway_attempts: 0, coordinator_error_code: 0, coordinator_error_last_completed: 0, coordinator_poisoned: false, request_owner: WebH2RequestOwnerV1.create())

    pub static fn create_bound(binding: WebH2ResponseOwnerBindingV1) -> WebH2ControlOwnerV1:
        var owner = WebH2ControlOwnerV1.create()
        owner.request_owner = WebH2RequestOwnerV1.create_bound(binding)
        owner.response_connection_epoch = binding._connection_epoch
        owner.response_owner_instance = binding._response_owner_instance
        owner

    me fail():
        self.status = WebH2ControlStatusV1.Failed
        self.inbound = []
        self.server_settings_ack_owed = false
        self.settings_acks_owed = 0
        self.ping_ack_debts = []
        self.pending_token = 0
        self.pending_kind = WebH2ControlSendKindV1.None
        self.pending_wire_bytes = []
        self.request_owner.cancel()

    me admit_settings(settings: H2SettingsFrame) -> bool:
        if (settings.flags & H2_FLAG_ACK) != 0: return false
        for setting in settings.settings:
            if setting.identifier == H2_SETTINGS_MAX_FRAME_SIZE:
                self.peer_max_frame_size = setting.value
            elif setting.identifier == H2_SETTINGS_INITIAL_WINDOW_SIZE:
                self.peer_initial_stream_window = setting.value
        true

    me admit_request_frame(frame: H2Frame) -> WebH2RequestFrameResultV1:
        if self.status != WebH2ControlStatusV1.ControlReady:
            return WebH2RequestFrameResultV1(
                status: WebH2RequestFrameStatusV1.NotRequestFrame,
                events: [], response_admissions: [], blocker: "")
        self.request_owner.admit_frame(frame)

    pub me fn feed_authenticated_plaintext(plaintext: [u8], authenticated: bool) -> WebH2ControlFeedResultV1:
        if not authenticated: return _empty_feed(WebH2ControlFeedStatusV1.RejectedUnauthenticated, "plaintext-not-authenticated")
        if self.status == WebH2ControlStatusV1.Failed: return _empty_feed(WebH2ControlFeedStatusV1.ProtocolError, "h2-control-owner-failed")
        if self.inbound.len().to_i64() + plaintext.len().to_i64() > WEB_H2_CONTROL_MAX_BUFFERED_PLAINTEXT_V1:
            self.fail()
            return _empty_feed(WebH2ControlFeedStatusV1.Overflow, "h2-control-plaintext-overflow")
        for byte in plaintext: self.inbound.push(byte)
        val preface = h2_connection_preface_bytes()
        while self.status == WebH2ControlStatusV1.AwaitingClientPreface and self.preface_offset < H2_CONNECTION_PREFACE_LEN and self.inbound.len() > 0u64:
            if self.inbound[0] != preface[self.preface_offset]:
                self.fail()
                return _empty_feed(WebH2ControlFeedStatusV1.ProtocolError, "invalid-client-connection-preface")
            self.inbound = self.inbound.slice(1u64, self.inbound.len())
            self.preface_offset = self.preface_offset + 1
        if self.status == WebH2ControlStatusV1.AwaitingClientPreface:
            if self.preface_offset < H2_CONNECTION_PREFACE_LEN: return _empty_feed(WebH2ControlFeedStatusV1.NeedMore, "")
            self.status = WebH2ControlStatusV1.AwaitingClientSettings
        if (self.status == WebH2ControlStatusV1.AwaitingClientSettings and
            self.inbound.len() == 0u64):
            return _empty_feed(WebH2ControlFeedStatusV1.NeedMore, "")
        var admitted: [H2Frame] = []
        var ack_required = false
        var request_events: [WebH2RequestEventV1] = []
        var response_admissions: [WebH2ResponseAdmissionReceiptV1] = []
        var ordered_actions: [H2OrderedInboundActionV1] = []
        var offset: i64 = 0
        while offset < self.inbound.len().to_i64():
            match h2_parse_frame_bounded(self.inbound, offset, H2_DEFAULT_MAX_FRAME_SIZE):
                case Incomplete(_):
                    self.inbound = self.inbound.slice(offset.to_u64(), self.inbound.len())
                    return WebH2ControlFeedResultV1(status: WebH2ControlFeedStatusV1.NeedMore, admitted_control_frames: admitted, settings_ack_required: ack_required, request_events: request_events, response_admissions: response_admissions, ordered_actions: ordered_actions, protocol_error_code: 0, close_after_error_goaway: false, blocker: "")
                case Ignored(_):
                    self.fail()
                    return _empty_feed(WebH2ControlFeedStatusV1.ProtocolError, "extension-frame-not-admitted")
                case Rejected(reason):
                    self.fail()
                    return _empty_feed(WebH2ControlFeedStatusV1.ProtocolError, reason)
                case Complete(ok):
                    val request_result = self.admit_request_frame(ok.frame)
                    match request_result.status:
                        case ProtocolError:
                            self.fail()
                            return _empty_feed(WebH2ControlFeedStatusV1.ProtocolError, request_result.blocker)
                        case CompressionError:
                            self.fail()
                            return _empty_feed(WebH2ControlFeedStatusV1.ProtocolError, request_result.blocker)
                        case Overflow:
                            self.fail()
                            return _empty_feed(WebH2ControlFeedStatusV1.Overflow, request_result.blocker)
                        case Accepted:
                            for event in request_result.events: request_events.push(event)
                            for admission in request_result.response_admissions: response_admissions.push(admission)
                            ordered_actions.push(H2OrderedInboundActionV1(frame: ok.frame,
                                kind: H2OrderedInboundActionKindV1.Request,
                                request_events: request_result.events,
                                response_admissions: request_result.response_admissions))
                            offset = offset + ok.consumed
                            continue
                        case NotRequestFrame:
                            pass_do_nothing("control dispatch below owns this frame")
                    match ok.frame:
                        case Settings(settings):
                            val prior_initial_window = self.peer_initial_stream_window
                            var initial_window_seen = false
                            for setting in settings.settings:
                                if setting.identifier == H2_SETTINGS_INITIAL_WINDOW_SIZE:
                                    initial_window_seen = true
                            if self.status == WebH2ControlStatusV1.AwaitingClientSettings:
                                if self.settings_acks_owed >= WEB_H2_CONTROL_MAX_SETTINGS_ACK_DEBTS_V1:
                                    self.fail()
                                    return _empty_feed(WebH2ControlFeedStatusV1.Overflow, "settings-ack-debt-overflow")
                                if not self.admit_settings(settings):
                                    self.fail()
                                    return _empty_feed(WebH2ControlFeedStatusV1.ProtocolError, "first-client-frame-must-be-non-ack-settings")
                                self.status = WebH2ControlStatusV1.ControlReady
                                self.settings_acks_owed = self.settings_acks_owed + 1
                                ack_required = true
                            elif (settings.flags & H2_FLAG_ACK) == 0:
                                if self.settings_acks_owed >= WEB_H2_CONTROL_MAX_SETTINGS_ACK_DEBTS_V1:
                                    self.fail()
                                    return _empty_feed(WebH2ControlFeedStatusV1.Overflow, "settings-ack-debt-overflow")
                                if not self.admit_settings(settings): return _empty_feed(WebH2ControlFeedStatusV1.ProtocolError, "invalid-client-settings")
                                self.settings_acks_owed = self.settings_acks_owed + 1
                                ack_required = true
                            elif not self.server_settings_committed or not self.server_settings_ack_owed:
                                self.fail()
                                return _empty_feed(WebH2ControlFeedStatusV1.ProtocolError, "unexpected-server-settings-ack")
                            else:
                                self.server_settings_ack_owed = false
                            admitted.push(ok.frame)
                            if initial_window_seen:
                                ordered_actions.push(H2OrderedInboundActionV1(
                                    frame: ok.frame,
                                    kind: H2OrderedInboundActionKindV1.SettingsInitialWindow(
                                        new_window: self.peer_initial_stream_window,
                                        delta: self.peer_initial_stream_window - prior_initial_window),
                                    request_events: [], response_admissions: []))
                                offset = offset + ok.consumed
                                continue
                        case WindowUpdate(update):
                            if self.status != WebH2ControlStatusV1.ControlReady or update.increment <= 0:
                                self.fail()
                                return _empty_feed(WebH2ControlFeedStatusV1.ProtocolError, "invalid-window-update-increment")
                            if update.stream_id == 0:
                                ordered_actions.push(H2OrderedInboundActionV1(frame: ok.frame,
                                    kind: H2OrderedInboundActionKindV1.ConnectionWindowUpdate(
                                        increment: update.increment), request_events: [],
                                    response_admissions: []))
                            else:
                                ordered_actions.push(H2OrderedInboundActionV1(frame: ok.frame,
                                    kind: H2OrderedInboundActionKindV1.StreamWindowUpdate(
                                        stream_id: update.stream_id, increment: update.increment),
                                    request_events: [], response_admissions: []))
                            admitted.push(ok.frame)
                            offset = offset + ok.consumed
                            continue
                        case Ping(ping):
                            if self.status != WebH2ControlStatusV1.ControlReady:
                                self.fail()
                                return _empty_feed(WebH2ControlFeedStatusV1.ProtocolError, "first-client-frame-must-be-non-ack-settings")
                            if (ping.flags & H2_FLAG_ACK) == 0:
                                if self.ping_ack_debts.len().to_i64() >= WEB_H2_CONTROL_MAX_PING_DEBTS_V1:
                                    self.fail()
                                    return _empty_feed(WebH2ControlFeedStatusV1.Overflow, "ping-ack-debt-overflow")
                                self.ping_ack_debts.push(
                                    _copy_control_bytes(ping.opaque_data))
                            admitted.push(ok.frame)
                        case Goaway(_):
                            if self.status != WebH2ControlStatusV1.ControlReady:
                                self.fail()
                                return _empty_feed(WebH2ControlFeedStatusV1.ProtocolError, "first-client-frame-must-be-non-ack-settings")
                            admitted.push(ok.frame)
                            offset = offset + ok.consumed
                            ordered_actions.push(H2OrderedInboundActionV1(
                                frame: ok.frame,
                                kind: H2OrderedInboundActionKindV1.PeerGoaway,
                                request_events: [], response_admissions: []))
                            continue
                        case _:
                            self.fail()
                            return _empty_feed(WebH2ControlFeedStatusV1.ProtocolError, "frame-not-owned")
                    offset = offset + ok.consumed
                    ordered_actions.push(H2OrderedInboundActionV1(frame: ok.frame,
                        kind: H2OrderedInboundActionKindV1.Control,
                        request_events: [], response_admissions: []))
        self.inbound = []
        WebH2ControlFeedResultV1(status: WebH2ControlFeedStatusV1.Accepted, admitted_control_frames: admitted, settings_ack_required: ack_required, request_events: request_events, response_admissions: response_admissions, ordered_actions: ordered_actions, protocol_error_code: 0, close_after_error_goaway: false, blocker: "")

    me prepare(kind: WebH2ControlSendKindV1, frame: H2Frame) -> WebH2PreparedControlRecordV1:
        if self.pending_token != 0: return WebH2PreparedControlRecordV1(token: 0, kind: WebH2ControlSendKindV1.None, wire_bytes: [])
        self.pending_token = self.next_token
        self.next_token = self.next_token + 1
        self.pending_kind = kind
        self.pending_wire_bytes = h2_write_frame(frame)
        WebH2PreparedControlRecordV1(token: self.pending_token, kind: kind, wire_bytes: self.pending_wire_bytes)

    pub me fn prepare_server_settings() -> WebH2PreparedControlRecordV1:
        if self.status == WebH2ControlStatusV1.Failed or self.server_settings_committed: return WebH2PreparedControlRecordV1(token: 0, kind: WebH2ControlSendKindV1.None, wire_bytes: [])
        self.prepare(WebH2ControlSendKindV1.ServerSettings, H2Frame.Settings(H2SettingsFrame(flags: 0, settings: _control_settings())))

    pub me fn prepare_settings_ack() -> WebH2PreparedControlRecordV1:
        if self.status != WebH2ControlStatusV1.ControlReady or self.settings_acks_owed <= 0: return WebH2PreparedControlRecordV1(token: 0, kind: WebH2ControlSendKindV1.None, wire_bytes: [])
        self.prepare(WebH2ControlSendKindV1.SettingsAck, H2Frame.Settings(H2SettingsFrame(flags: H2_FLAG_ACK, settings: [])))

    pub me fn prepare_ping_ack() -> WebH2PreparedControlRecordV1:
        if self.status != WebH2ControlStatusV1.ControlReady or self.ping_ack_debts.len() == 0u64: return WebH2PreparedControlRecordV1(token: 0, kind: WebH2ControlSendKindV1.None, wire_bytes: [])
        self.prepare(WebH2ControlSendKindV1.PingAck, H2Frame.Ping(H2PingFrame(flags: H2_FLAG_ACK, opaque_data: self.ping_ack_debts[0])))

    pub me fn prepare_local_goaway_v1(cutoff: WebH2LocalGoawayCutoffV1, error_code: i64) -> WebH2PreparedControlRecordV1:
        val last_completed_stream_id = cutoff._highest_completed_stream_id
        if self.status != WebH2ControlStatusV1.ControlReady or self.goaway_committed or cutoff._connection_epoch == 0u64 or cutoff._connection_epoch != self.response_connection_epoch or cutoff._response_owner_instance != self.response_owner_instance or last_completed_stream_id < 0 or last_completed_stream_id > WEB_H2_CONTROL_MAX_WINDOW_V1 or (last_completed_stream_id != 0 and last_completed_stream_id % 2 == 0) or error_code < 0 or error_code > 4294967295:
            return WebH2PreparedControlRecordV1(token: 0, kind: WebH2ControlSendKindV1.None, wire_bytes: [])
        self.prepare(WebH2ControlSendKindV1.Goaway, H2Frame.Goaway(H2GoawayFrame(
            last_stream_id: last_completed_stream_id, error_code: error_code,
            debug_data: [])))

    pub me fn prepare_error_goaway_v1(error_code: i64) -> WebH2PreparedControlRecordV1:
        # Two bounded TLS write attempts are permitted; after both abort, the
        # transport must close without another protocol write.
        if self.status != WebH2ControlStatusV1.Failed or self.coordinator_poisoned or self.goaway_committed or self.error_goaway_attempts >= 2 or error_code <= 0 or error_code > 4294967295 or (self.coordinator_error_code != 0 and error_code != self.coordinator_error_code):
            return WebH2PreparedControlRecordV1(token: 0, kind: WebH2ControlSendKindV1.None, wire_bytes: [])
        val prepared = self.prepare(WebH2ControlSendKindV1.Goaway,
            H2Frame.Goaway(H2GoawayFrame(last_stream_id:
                self.coordinator_error_last_completed,
                error_code: error_code, debug_data: [])))
        if prepared.token != 0: self.error_goaway_attempts = self.error_goaway_attempts + 1
        prepared

    pub me fn prepare_retained_error_goaway_v1() -> WebH2PreparedControlRecordV1:
        if self.coordinator_error_code <= 0:
            return WebH2PreparedControlRecordV1(token: 0,
                kind: WebH2ControlSendKindV1.None, wire_bytes: [])
        self.prepare_error_goaway_v1(self.coordinator_error_code)

    pub fn must_close_without_send_v1() -> bool:
        self.status == WebH2ControlStatusV1.Failed and not self.goaway_committed and self.pending_token == 0 and (self.coordinator_poisoned or self.error_goaway_attempts >= 2)

    pub fn must_close_v1() -> bool:
        self.coordinator_poisoned or self.goaway_committed or
            self.must_close_without_send_v1()

    pub me fn fail_protocol_from_coordinator_v1(error_code: i64,
        cutoff: WebH2LocalGoawayCutoffV1) -> bool:
        val eligible_status = self.status == WebH2ControlStatusV1.ControlReady or (self.status == WebH2ControlStatusV1.Failed and self.coordinator_error_code == 0)
        if not eligible_status or error_code <= 0 or error_code > 4294967295 or cutoff._connection_epoch != self.response_connection_epoch or cutoff._response_owner_instance != self.response_owner_instance or cutoff._highest_completed_stream_id < 0 or cutoff._highest_completed_stream_id > WEB_H2_CONTROL_MAX_WINDOW_V1:
            self.coordinator_poisoned = true
            self.fail()
            return false
        if self.status == WebH2ControlStatusV1.ControlReady: self.fail()
        self.coordinator_error_code = error_code
        self.coordinator_error_last_completed = cutoff._highest_completed_stream_id
        true

    pub me fn commit_control(token: i64) -> bool:
        if token <= 0 or token != self.pending_token: return false
        if self.pending_kind == WebH2ControlSendKindV1.ServerSettings:
            self.server_settings_committed = true
            self.server_settings_ack_owed = true
        elif self.pending_kind == WebH2ControlSendKindV1.SettingsAck:
            self.settings_acks_owed = self.settings_acks_owed - 1
        elif self.pending_kind == WebH2ControlSendKindV1.PingAck:
            self.ping_ack_debts = self.ping_ack_debts.slice(
                1u64, self.ping_ack_debts.len())
        elif self.pending_kind == WebH2ControlSendKindV1.Goaway:
            self.goaway_committed = true
            self.status = WebH2ControlStatusV1.Failed
            self.request_owner.cancel()
        self.pending_token = 0
        self.pending_kind = WebH2ControlSendKindV1.None
        self.pending_wire_bytes = []
        true

    pub me fn abort_control(token: i64) -> bool:
        if token <= 0 or token != self.pending_token: return false
        self.pending_token = 0
        self.pending_kind = WebH2ControlSendKindV1.None
        self.pending_wire_bytes = []
        true

    pub fn negotiated_peer_max_frame_size() -> i64: self.peer_max_frame_size
    pub fn negotiated_peer_initial_stream_window() -> i64:
        self.peer_initial_stream_window
    pub fn ping_ack_debt_count() -> i64:
        self.ping_ack_debts.len().to_i64()
    pub fn settings_ack_debt_count() -> i64: self.settings_acks_owed
    pub fn server_settings_ack_pending() -> bool: self.server_settings_ack_owed

export WebH2ControlOwnerV1, WebH2ControlStatusV1, WebH2ControlFeedStatusV1
export WebH2ControlSendKindV1, WebH2ControlFeedResultV1
export WebH2PreparedControlRecordV1
export H2OrderedInboundActionV1
export H2OrderedInboundActionKindV1
export WEB_H2_CONTROL_MAX_BUFFERED_PLAINTEXT_V1, WEB_H2_CONTROL_MAX_WINDOW_V1
export WEB_H2_CONTROL_MAX_PING_DEBTS_V1
export WEB_H2_CONTROL_MAX_SETTINGS_ACK_DEBTS_V1
