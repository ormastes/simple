# codex-impl
# Pure Simple plan executor. Host effects exist only behind the injected port.

use lib.common.env_access.model.*
use std.common.crypto.sha256.{sha256_text}

pub trait EnvAccessCapability:
    # Resolve a repo-relative path through the host filesystem. Returning nil
    # means containment or symlink resolution could not be proven.
    fn canonical_repo_path(canonical_repo_root: text, relative_path: text) -> text?

    # Resolve a logical tool identity without consulting PATH. The result must
    # equal the admitted canonical path or execution is rejected.
    fn canonical_tool_path(tool_id: text, identity_hash: text) -> text?

    # Execute exactly one already-resolved instruction with bounded capture.
    # RunAllowedTool must be a direct argv invocation; shell interpretation is
    # outside this capability and is never implied by argument text.
    fn execute_bounded(instruction: EnvAccessInstruction,
                       canonical_resource: text) -> EnvAccessRawResult

fn rejected_receipt(plan_id: text, index: i64, reason: text) -> EnvAccessReceipt:
    return EnvAccessReceipt(
        plan_id: plan_id,
        instruction_index: index,
        status: EnvAccessStatus.Rejected,
        exit_code: -1,
        stdout_hash: "",
        stderr_hash: "",
        discarded_bytes: 0,
        reason: reason,
        prerequisite: "provide a canonical admitted environment capability",
        owner: "environment-executor",
        artifact_paths: [],
        resume_command: "rerun the same typed environment plan"
    )

fn contained_by_repo(root: text, resolved: text) -> bool:
    if (resolved == "" or resolved.contains("\\") or resolved.contains("/../") or
        resolved.ends_with("/..") or resolved.contains("//")):
        return false
    if not resolved.starts_with("/") and not (resolved.len() >= 3 and resolved[1..3] == ":/"):
        return false
    if resolved == root:
        return true
    return resolved.starts_with(root + "/")

fn admitted_tool(plan: EnvAccessPlan, tool_id: text) -> EnvToolIdentity?:
    for tool in plan.allowed_tools:
        if tool.tool_id == tool_id:
            return Some(tool)
    return nil

fn resolved_resource(plan: EnvAccessPlan, instruction: EnvAccessInstruction,
                     capability: EnvAccessCapability) -> text?:
    if instruction.kind == EnvAccessKind.ReadRepoFile:
        match capability.canonical_repo_path(plan.canonical_repo_root, instruction.resource):
            case Some(resolved):
                if contained_by_repo(plan.canonical_repo_root, resolved):
                    return Some(resolved)
            case nil:
                return nil
        return nil
    if instruction.kind == EnvAccessKind.RunAllowedTool:
        match admitted_tool(plan, instruction.resource):
            case Some(tool):
                match capability.canonical_tool_path(tool.tool_id, tool.identity_hash):
                    case Some(resolved):
                        if resolved == tool.canonical_path:
                            return Some(resolved)
                    case nil:
                        return nil
            case nil:
                return nil
        return nil
    return Some(instruction.resource)

fn receipt_from_raw(plan_id: text, index: i64, instruction: EnvAccessInstruction,
                    raw: EnvAccessRawResult) -> Result<EnvAccessReceipt, text>:
    if (raw.stdout.len() > instruction.max_stdout_bytes or
        raw.stderr.len() > instruction.max_stderr_bytes):
        return Err("ENV-E-OUTPUT-CAP")
    if raw.elapsed_ms < 0 or raw.elapsed_ms > instruction.timeout_ms:
        return Err("ENV-E-TIMEOUT-CAP")
    if raw.discarded_bytes < 0:
        return Err("ENV-E-BOUND")
    val receipt = EnvAccessReceipt(
        plan_id: plan_id,
        instruction_index: index,
        status: raw.status,
        exit_code: raw.exit_code,
        stdout_hash: "sha256:" + sha256_text(raw.stdout),
        stderr_hash: "sha256:" + sha256_text(raw.stderr),
        discarded_bytes: raw.discarded_bytes,
        reason: raw.reason,
        prerequisite: raw.prerequisite,
        owner: raw.owner,
        artifact_paths: raw.artifact_paths,
        resume_command: raw.resume_command
    )
    val problem = env_access_receipt_error(receipt)
    if problem != "":
        return Err(problem)
    return Ok(receipt)

# Executes sequentially so effects and receipts have one deterministic order.
# The result array is bounded by the validated 1024-instruction plan cap.
pub fn env_access_execute(plan: EnvAccessPlan,
                          capability: EnvAccessCapability) -> Result<[EnvAccessReceipt], text>:
    val problem = env_access_plan_error(plan)
    if problem != "":
        return Err(problem)
    var receipts: [EnvAccessReceipt] = []
    var index = 0
    while index < plan.instructions.len():
        val instruction = plan.instructions[index]
        match resolved_resource(plan, instruction, capability):
            case Some(canonical_resource):
                val raw = capability.execute_bounded(instruction, canonical_resource)
                match receipt_from_raw(plan.plan_id, index, instruction, raw):
                    case Ok(receipt): receipts.push(receipt)
                    case Err(receipt_problem): return Err(receipt_problem)
            case nil:
                receipts.push(rejected_receipt(plan.plan_id, index, "canonical resource identity could not be proven"))
        index = index + 1
    return Ok(receipts)
