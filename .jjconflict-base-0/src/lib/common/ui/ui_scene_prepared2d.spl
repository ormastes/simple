# Unified Packed UI Scene — Prepared2D sidecar (design §2.5).
#
# Design authority: `doc/05_design/ui/unified_packed_ui_scene.md` §2.5.
# Lane: L1 (`doc/03_plan/ui/unified_packed_ui_scene_agent_lanes.md`).
#
# Derived value sidecar; construction is a pure function of scene +
# capability key. NO arena, NO backend implementation — the actual batch
# construction (reading a resolved scene and producing these rows) is a
# later lane; this file is the vocabulary only.

use common.ui.ui_scene_counts.{UiSceneRange}

# Prepared2DBatch.flags bit 0 (design §2.5 / §4.1): the batch could not be
# composited without an offscreen surface (rotated+clipped group, or
# overlapping group opacity) and an executor that cannot honor it must
# refuse rather than render with the clip/opacity dropped.
pub val UI_SCENE_PREPARED2D_FLAG_NONE: u32 = 0u32
pub val UI_SCENE_PREPARED2D_FLAG_NEEDS_OFFSCREEN: u32 = 1u32

struct Prepared2DBatch:
    first_command: u32
    command_count: u32
    target_surface_id: u32
    pipeline_id: u32
    resource_set_id: u32
    resolved_clip_id: u32
    resolved_transform_id: u32
    flags: u32

struct Prepared2DPlan:
    batches: UiSceneRange             # into PREPARED_BATCHES table
    dirty_upload: UiSceneRange        # into DIRTY_RANGES table (byte ranges)
    damage_rect_count: u32
    capability_key: u64               # backend identity+capability generation
    scene_generation: u32

# Cache key = (scene_generation, capability_key, viewport_generation).
# Unchanged key -> reuse the plan bit-for-bit, zero reconstruction.
struct Prepared2DCacheKey:
    scene_generation: u32
    capability_key: u64
    viewport_generation: u32

fn ui_scene_prepared2d_cache_key(plan: Prepared2DPlan, viewport_generation: u32) -> Prepared2DCacheKey:
    Prepared2DCacheKey(
        scene_generation: plan.scene_generation,
        capability_key: plan.capability_key,
        viewport_generation: viewport_generation
    )

fn ui_scene_prepared2d_cache_key_equal(a: Prepared2DCacheKey, b: Prepared2DCacheKey) -> bool:
    a.scene_generation == b.scene_generation
        and a.capability_key == b.capability_key
        and a.viewport_generation == b.viewport_generation

fn ui_scene_prepared2d_batch_needs_offscreen(batch: Prepared2DBatch) -> bool:
    (batch.flags & UI_SCENE_PREPARED2D_FLAG_NEEDS_OFFSCREEN) != 0u32

export UI_SCENE_PREPARED2D_FLAG_NONE, UI_SCENE_PREPARED2D_FLAG_NEEDS_OFFSCREEN,
    Prepared2DBatch, Prepared2DPlan, Prepared2DCacheKey,
    ui_scene_prepared2d_cache_key, ui_scene_prepared2d_cache_key_equal,
    ui_scene_prepared2d_batch_needs_offscreen
