        return capacity.max_rows_glyphs
    if table_id == UI_SCENE_TABLE_RESOURCES:
        return capacity.max_rows_resources
    if table_id == UI_SCENE_TABLE_PATH_SPANS:
        return capacity.max_rows_path_spans
    if table_id == UI_SCENE_TABLE_PATH_POINTS:
        return capacity.max_rows_path_points
    if table_id == UI_SCENE_TABLE_CLIPS:
        return capacity.max_rows_clips
    if table_id == UI_SCENE_TABLE_TRANSFORMS:
        return capacity.max_rows_transforms
    if table_id == UI_SCENE_TABLE_HIT_SHAPES:
        return capacity.max_rows_hit_shapes
    if table_id == UI_SCENE_TABLE_PROVENANCE_EDGES:
        return capacity.max_rows_provenance_edges
    if table_id == UI_SCENE_TABLE_OWNER_RECORDS:
        return capacity.max_rows_owner_records
    if table_id == UI_SCENE_TABLE_ACTION_BINDINGS:
        return capacity.max_rows_action_bindings
    if table_id == UI_SCENE_TABLE_PREPARED_BATCHES:
        return capacity.max_rows_prepared_batches
    if table_id == UI_SCENE_TABLE_DIRTY_RANGES:
        return capacity.max_rows_dirty_ranges
    0u32

fn ui_scene_capacity_set(capacity: UiSceneCapacityExtensionV1, table_id: u16, value: u32) -> UiSceneCapacityExtensionV1:
    var out = capacity
    if table_id == UI_SCENE_TABLE_COMMANDS:
        out.max_rows_commands = value
    if table_id == UI_SCENE_TABLE_GEOMETRY:
        out.max_rows_geometry = value
    if table_id == UI_SCENE_TABLE_PAINT:
        out.max_rows_paint = value
    if table_id == UI_SCENE_TABLE_TEXT_RUNS:
