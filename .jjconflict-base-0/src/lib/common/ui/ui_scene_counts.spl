# =========================================================================
# Capacity sidecar (design §2.7). Frozen `gpu_web_capacity_manifest.spl` /
# `_strides.spl` are never edited; this is purely additive.
# =========================================================================

struct UiSceneCapacityExtensionV1:
    max_rows_commands: u32
    max_rows_geometry: u32
    max_rows_paint: u32
    max_rows_text_runs: u32
    max_rows_glyphs: u32
    max_rows_resources: u32
    max_rows_path_spans: u32
    max_rows_path_points: u32
    max_rows_clips: u32
    max_rows_transforms: u32
    max_rows_hit_shapes: u32
    max_rows_provenance_edges: u32
    max_rows_owner_records: u32
    max_rows_action_bindings: u32
    max_rows_prepared_batches: u32
    max_rows_dirty_ranges: u32
    scan_scratch_rows: u32
    backend_scratch_bytes: u32

fn ui_scene_capacity_zero() -> UiSceneCapacityExtensionV1:
    UiSceneCapacityExtensionV1(
        max_rows_commands: 0u32, max_rows_geometry: 0u32, max_rows_paint: 0u32,
        max_rows_text_runs: 0u32, max_rows_glyphs: 0u32, max_rows_resources: 0u32,
        max_rows_path_spans: 0u32, max_rows_path_points: 0u32, max_rows_clips: 0u32,
        max_rows_transforms: 0u32, max_rows_hit_shapes: 0u32,
        max_rows_provenance_edges: 0u32, max_rows_owner_records: 0u32,
        max_rows_action_bindings: 0u32, max_rows_prepared_batches: 0u32,
        max_rows_dirty_ranges: 0u32, scan_scratch_rows: 0u32,
        backend_scratch_bytes: 0u32
    )

