# Unified Packed UI Scene — table ids, counts/ranges, capacity sidecar and
# the count -> scan -> verify state machine (design §2.1, §2.7, §5).
#
# Design authority: `doc/05_design/ui/unified_packed_ui_scene.md` §2, §5.
# Lane: L1 (`doc/03_plan/ui/unified_packed_ui_scene_agent_lanes.md`).
#
# Pure value vocabulary only. NO arena, NO backend implementation, NO I/O —
# those are later lanes (L4/L5/L6/L7) built on top of this file.
#
# Fixed-size array fields (`[u32; 16]` / `[UiSceneRange; 16]`) are not yet
# expressible as struct field types in this tier, so `UiSceneCounts`,
# `UiSceneRanges` and `UiSceneCapacityExtensionV1` use the documented
# fallback form: 16 named fields, one per `UiSceneTableId`, in the same
# order as the id numbering below (design §2.1 note).

# =========================================================================
# UiSceneTableId — sixteen destination tables (u16, stable, append-only).
# This numbering is a cross-module ABI (design §2.1). Pinned literally.
# =========================================================================
pub val UI_SCENE_TABLE_COMMANDS: u16 = 0u16
pub val UI_SCENE_TABLE_GEOMETRY: u16 = 1u16
pub val UI_SCENE_TABLE_PAINT: u16 = 2u16
pub val UI_SCENE_TABLE_TEXT_RUNS: u16 = 3u16
pub val UI_SCENE_TABLE_GLYPHS: u16 = 4u16
pub val UI_SCENE_TABLE_RESOURCES: u16 = 5u16
pub val UI_SCENE_TABLE_PATH_SPANS: u16 = 6u16
pub val UI_SCENE_TABLE_PATH_POINTS: u16 = 7u16
pub val UI_SCENE_TABLE_CLIPS: u16 = 8u16
pub val UI_SCENE_TABLE_TRANSFORMS: u16 = 9u16
pub val UI_SCENE_TABLE_HIT_SHAPES: u16 = 10u16
pub val UI_SCENE_TABLE_PROVENANCE_EDGES: u16 = 11u16
pub val UI_SCENE_TABLE_OWNER_RECORDS: u16 = 12u16
pub val UI_SCENE_TABLE_ACTION_BINDINGS: u16 = 13u16
pub val UI_SCENE_TABLE_PREPARED_BATCHES: u16 = 14u16
pub val UI_SCENE_TABLE_DIRTY_RANGES: u16 = 15u16

# Total table count, for callers that need to iterate all 16.
pub val UI_SCENE_TABLE_ID_COUNT: u16 = 16u16

# --- producer kinds (u16) --------------------------------------------------
# Shared by `UiOwnerRecord.producer_kind` (ui_scene_owner_table.spl) and
# `UiPackedProducer.producer_kind()` (ui_scene_slice.spl). Defined here so
# neither of those files has to depend on the other.
pub val UI_PRODUCER_WM: u16 = 0u16
pub val UI_PRODUCER_GUI: u16 = 1u16
pub val UI_PRODUCER_WEB: u16 = 2u16
pub val UI_PRODUCER_EXTERNAL: u16 = 3u16

# --- overflow receipt kinds (u16) ------------------------------------------
pub val UI_SCENE_OVERFLOW_CAPACITY: u16 = 0u16
pub val UI_SCENE_OVERFLOW_DEFICIT: u16 = 1u16
pub val UI_SCENE_OVERFLOW_SURPLUS: u16 = 2u16
pub val UI_SCENE_OVERFLOW_RANGE_VIOLATION: u16 = 3u16
pub val UI_SCENE_OVERFLOW_STRUCTURE: u16 = 4u16

# =========================================================================
# Counts / ranges (design §2.1)
# =========================================================================

struct UiSceneCounts:
    # One producer's exact required row count per table, same order as
    # UiSceneTableId.
    commands: u32
    geometry: u32
    paint: u32
    text_runs: u32
    glyphs: u32
    resources: u32
    path_spans: u32
    path_points: u32
    clips: u32
    transforms: u32
    hit_shapes: u32
    provenance_edges: u32
    owner_records: u32
    action_bindings: u32
    prepared_batches: u32
    dirty_ranges: u32

struct UiSceneRange:
    start: u32
    count: u32

struct UiSceneRanges:
    # One assigned range per table, same order as UiSceneTableId.
    commands: UiSceneRange
    geometry: UiSceneRange
    paint: UiSceneRange
    text_runs: UiSceneRange
    glyphs: UiSceneRange
    resources: UiSceneRange
    path_spans: UiSceneRange
    path_points: UiSceneRange
    clips: UiSceneRange
    transforms: UiSceneRange
    hit_shapes: UiSceneRange
    provenance_edges: UiSceneRange
    owner_records: UiSceneRange
    action_bindings: UiSceneRange
    prepared_batches: UiSceneRange
    dirty_ranges: UiSceneRange

fn ui_scene_counts_zero() -> UiSceneCounts:
    UiSceneCounts(
        commands: 0u32, geometry: 0u32, paint: 0u32, text_runs: 0u32,
        glyphs: 0u32, resources: 0u32, path_spans: 0u32, path_points: 0u32,
        clips: 0u32, transforms: 0u32, hit_shapes: 0u32, provenance_edges: 0u32,
        owner_records: 0u32, action_bindings: 0u32, prepared_batches: 0u32,
        dirty_ranges: 0u32
    )

fn ui_scene_counts_at(counts: UiSceneCounts, table_id: u16) -> u32:
    if table_id == UI_SCENE_TABLE_COMMANDS:
        return counts.commands
    if table_id == UI_SCENE_TABLE_GEOMETRY:
        return counts.geometry
    if table_id == UI_SCENE_TABLE_PAINT:
        return counts.paint
    if table_id == UI_SCENE_TABLE_TEXT_RUNS:
        return counts.text_runs
    if table_id == UI_SCENE_TABLE_GLYPHS:
        return counts.glyphs
    if table_id == UI_SCENE_TABLE_RESOURCES:
        return counts.resources
    if table_id == UI_SCENE_TABLE_PATH_SPANS:
        return counts.path_spans
    if table_id == UI_SCENE_TABLE_PATH_POINTS:
        return counts.path_points
    if table_id == UI_SCENE_TABLE_CLIPS:
        return counts.clips
    if table_id == UI_SCENE_TABLE_TRANSFORMS:
        return counts.transforms
    if table_id == UI_SCENE_TABLE_HIT_SHAPES:
        return counts.hit_shapes
    if table_id == UI_SCENE_TABLE_PROVENANCE_EDGES:
        return counts.provenance_edges
    if table_id == UI_SCENE_TABLE_OWNER_RECORDS:
        return counts.owner_records
    if table_id == UI_SCENE_TABLE_ACTION_BINDINGS:
        return counts.action_bindings
    if table_id == UI_SCENE_TABLE_PREPARED_BATCHES:
        return counts.prepared_batches
    if table_id == UI_SCENE_TABLE_DIRTY_RANGES:
        return counts.dirty_ranges
    0u32

fn ui_scene_counts_set(counts: UiSceneCounts, table_id: u16, value: u32) -> UiSceneCounts:
    var out = counts
    if table_id == UI_SCENE_TABLE_COMMANDS:
        out.commands = value
    if table_id == UI_SCENE_TABLE_GEOMETRY:
        out.geometry = value
    if table_id == UI_SCENE_TABLE_PAINT:
        out.paint = value
    if table_id == UI_SCENE_TABLE_TEXT_RUNS:
        out.text_runs = value
    if table_id == UI_SCENE_TABLE_GLYPHS:
        out.glyphs = value
    if table_id == UI_SCENE_TABLE_RESOURCES:
        out.resources = value
    if table_id == UI_SCENE_TABLE_PATH_SPANS:
        out.path_spans = value
    if table_id == UI_SCENE_TABLE_PATH_POINTS:
        out.path_points = value
    if table_id == UI_SCENE_TABLE_CLIPS:
        out.clips = value
    if table_id == UI_SCENE_TABLE_TRANSFORMS:
        out.transforms = value
    if table_id == UI_SCENE_TABLE_HIT_SHAPES:
        out.hit_shapes = value
    if table_id == UI_SCENE_TABLE_PROVENANCE_EDGES:
