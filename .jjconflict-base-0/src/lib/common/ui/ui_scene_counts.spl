        out.max_rows_owner_records = value
    if table_id == UI_SCENE_TABLE_ACTION_BINDINGS:
        out.max_rows_action_bindings = value
    if table_id == UI_SCENE_TABLE_PREPARED_BATCHES:
        out.max_rows_prepared_batches = value
    if table_id == UI_SCENE_TABLE_DIRTY_RANGES:
        out.max_rows_dirty_ranges = value
    out

# =========================================================================
# Overflow receipt (design §5)
# =========================================================================

struct UiSceneOverflowReceipt:
    table_id: u16
    kind: u16
    required: u32
    capacity: u32
    producer_kind: u16
    producer_id: u32
    snapshot_id: u64

# =========================================================================
# COUNT -> SCAN -> VERIFY state machine (design §5). EMIT is bounds-checked
# writers, defined as trait vocabulary in ui_scene_slice.spl; no emit-side
# implementation lives here.
# =========================================================================

# One table's exclusive prefix scan across a sequence of per-producer
# counts. Disjoint, gapless: producer i's range starts exactly where
# producer i-1's range ends. A zero count still gets a valid (non-advancing)
# range rather than being skipped.
fn ui_scene_scan_table(counts: [u32]) -> [UiSceneRange]:
    var out: [UiSceneRange] = []
    var cursor = 0u32
    var i = 0
    while i < counts.len():
        val n = counts[i]
        out.push(UiSceneRange(start: cursor, count: n))
        cursor = cursor + n
        i = i + 1
    out

# Full 16-table scan across producers: table-by-table exclusive prefix scan,
# reassembled per producer. Order of producers in `all_counts` is the order
# ranges are assigned in.
fn ui_scene_scan(all_counts: [UiSceneCounts]) -> [UiSceneRanges]:
    var result: [UiSceneRanges] = []
    var p = 0
    while p < all_counts.len():
        result.push(ui_scene_ranges_zero())
        p = p + 1

    for t in 0..16:
        val table_id = t as u16
        var column: [u32] = []
        p = 0
        while p < all_counts.len():
            column.push(ui_scene_counts_at(all_counts[p], table_id))
            p = p + 1
        val table_ranges = ui_scene_scan_table(column)
        p = 0
        while p < all_counts.len():
            result[p] = ui_scene_ranges_set(result[p], table_id, table_ranges[p])
            p = p + 1
    result

# Sum of every producer's exact count, per table — the VERIFY input.
fn ui_scene_counts_total(all_counts: [UiSceneCounts]) -> UiSceneCounts:
    var total = ui_scene_counts_zero()
    for t in 0..16:
        val table_id = t as u16
        var sum = 0u32
        var p = 0
        while p < all_counts.len():
            sum = sum + ui_scene_counts_at(all_counts[p], table_id)
            p = p + 1
        total = ui_scene_counts_set(total, table_id, sum)
    total

# VERIFY: for each table, total <= capacity.max_rows[t]. PASS -> nil
# (caller proceeds to EMIT); FAIL -> the receipt for the first breaching
# table (fail-closed; nothing is emitted, front generation untouched). This
# function performs no emission itself — it is the gate a caller checks
# before invoking any writer.
fn ui_scene_verify(
    totals: UiSceneCounts, capacity: UiSceneCapacityExtensionV1,
    producer_kind: u16, producer_id: u32, snapshot_id: u64
) -> UiSceneOverflowReceipt?:
    for t in 0..16:
        val table_id = t as u16
        val required = ui_scene_counts_at(totals, table_id)
        val cap = ui_scene_capacity_max_rows_at(capacity, table_id)
        if required > cap:
            return UiSceneOverflowReceipt(
                table_id: table_id,
                kind: UI_SCENE_OVERFLOW_CAPACITY,
                required: required,
                capacity: cap,
                producer_kind: producer_kind,
                producer_id: producer_id,
                snapshot_id: snapshot_id
            )
    return nil

export UI_SCENE_TABLE_COMMANDS, UI_SCENE_TABLE_GEOMETRY, UI_SCENE_TABLE_PAINT,
    UI_SCENE_TABLE_TEXT_RUNS, UI_SCENE_TABLE_GLYPHS, UI_SCENE_TABLE_RESOURCES,
    UI_SCENE_TABLE_PATH_SPANS, UI_SCENE_TABLE_PATH_POINTS, UI_SCENE_TABLE_CLIPS,
    UI_SCENE_TABLE_TRANSFORMS, UI_SCENE_TABLE_HIT_SHAPES,
    UI_SCENE_TABLE_PROVENANCE_EDGES, UI_SCENE_TABLE_OWNER_RECORDS,
    UI_SCENE_TABLE_ACTION_BINDINGS, UI_SCENE_TABLE_PREPARED_BATCHES,
    UI_SCENE_TABLE_DIRTY_RANGES, UI_SCENE_TABLE_ID_COUNT,
    UI_PRODUCER_WM, UI_PRODUCER_GUI, UI_PRODUCER_WEB, UI_PRODUCER_EXTERNAL,
    UI_SCENE_OVERFLOW_CAPACITY, UI_SCENE_OVERFLOW_DEFICIT,
    UI_SCENE_OVERFLOW_SURPLUS, UI_SCENE_OVERFLOW_RANGE_VIOLATION,
    UI_SCENE_OVERFLOW_STRUCTURE,
    UiSceneCounts, UiSceneRange, UiSceneRanges, UiSceneCapacityExtensionV1,
    UiSceneOverflowReceipt,
    ui_scene_counts_zero, ui_scene_counts_at, ui_scene_counts_set,
    ui_scene_ranges_zero, ui_scene_ranges_at, ui_scene_ranges_set,
    ui_scene_capacity_zero, ui_scene_capacity_max_rows_at, ui_scene_capacity_set,
    ui_scene_scan_table, ui_scene_scan, ui_scene_counts_total, ui_scene_verify
