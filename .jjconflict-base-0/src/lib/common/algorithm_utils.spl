# Algorithm utilities: sorting, searching, and list operations

# is_sorted() -> true if arr is non-decreasing (adjacent elements satisfy a[i] <= a[i+1]).
fn is_sorted(arr: [i64]) -> bool:
    if arr.len() <= 1:
        return true
    var i = 0
    while i < arr.len() - 1:
        if arr[i] > arr[i + 1]:
            return false
        i = i + 1
    true

# lists_equal() -> true if a and b have the same length and equal elements at every index.
fn lists_equal(a: [i64], b: [i64]) -> bool:
    if a.len() != b.len():
        return false
    var i = 0
    while i < a.len():
        if a[i] != b[i]:
            return false
        i = i + 1
    true

# swap(i, j) -> new array with elements at indices i and j exchanged (arr unchanged).
fn swap(arr: [i64], i: i64, j: i64) -> [i64]:
    var result: [i64] = []
    var k = 0
    while k < arr.len():
        if k == i:
            result = result.push(arr[j])
        elif k == j:
            result = result.push(arr[i])
        else:
            result = result.push(arr[k])
        k = k + 1
    result

# bubble_sort() -> new ascending-sorted array via repeated adjacent-swap passes, O(n^2).
fn bubble_sort(arr: [i64]) -> [i64]:
    val n = arr.len()
    if n <= 1:
        return arr
    var result = arr
    var i = 0
    while i < n:
        var j = 0
        while j < n - i - 1:
            if result[j] > result[j + 1]:
                result = swap(result, j, j + 1)
            j = j + 1
        i = i + 1
    result

# selection_sort() -> new ascending-sorted array; repeatedly swaps the minimum of the
# unsorted suffix into place, O(n^2).
fn selection_sort(arr: [i64]) -> [i64]:
    val n = arr.len()
    if n <= 1:
        return arr
    var result = arr
    var i = 0
    while i < n - 1:
        var min_idx = i
        var j = i + 1
        while j < n:
            if result[j] < result[min_idx]:
                min_idx = j
            j = j + 1
        if min_idx != i:
            result = swap(result, i, min_idx)
        i = i + 1
    result

# insertion_sort() -> new ascending-sorted array; stable, O(n^2) worst case, O(n) on
# already-sorted input.
fn insertion_sort(arr: [i64]) -> [i64]:
    val n = arr.len()
    if n <= 1:
        return arr
    var result = arr
    var i = 1
    while i < n:
        var j = i
        while j > 0:
            if result[j - 1] > result[j]:
                result = swap(result, j - 1, j)
                j = j - 1
            else:
                j = 0
        i = i + 1
    result

# quick_sort() -> new ascending-sorted array; partitions around arr[0] as pivot and
# recurses on the less/greater partitions (not in-place, not tail-call optimized).
fn quick_sort(arr: [i64]) -> [i64]:
    val n = arr.len()
    if n <= 1:
        return arr
    val pivot = arr[0]
    var less: [i64] = []
    var equal: [i64] = []
    var greater: [i64] = []
    var i = 0
    while i < n:
        val v = arr[i]
        if v < pivot:
            less = less.push(v)
        elif v == pivot:
            equal = equal.push(v)
        else:
            greater = greater.push(v)
        i = i + 1
    val sorted_less = quick_sort(less)
    val sorted_greater = quick_sort(greater)
    var result: [i64] = []
    var j = 0
    while j < sorted_less.len():
        result = result.push(sorted_less[j])
        j = j + 1
    j = 0
    while j < equal.len():
        result = result.push(equal[j])
        j = j + 1
    j = 0
    while j < sorted_greater.len():
        result = result.push(sorted_greater[j])
        j = j + 1
    result

fn _merge(left: [i64], right: [i64]) -> [i64]:
    var result: [i64] = []
    var i = 0
    var j = 0
    while i < left.len() and j < right.len():
        if left[i] <= right[j]:
            result = result.push(left[i])
            i = i + 1
        else:
            result = result.push(right[j])
            j = j + 1
    while i < left.len():
        result = result.push(left[i])
        i = i + 1
    while j < right.len():
        result = result.push(right[j])
        j = j + 1
    result

# merge_sort() -> new ascending-sorted array via recursive split + merge, stable, O(n log n).
fn merge_sort(arr: [i64]) -> [i64]:
    val n = arr.len()
    if n <= 1:
        return arr
    val mid = n / 2
    var left: [i64] = []
    var right: [i64] = []
    var i = 0
    while i < mid:
        left = left.push(arr[i])
        i = i + 1
    while i < n:
        right = right.push(arr[i])
        i = i + 1
    _merge(merge_sort(left), merge_sort(right))

# linear_search(target) -> index of the first occurrence of target, or nil if absent. O(n).
fn linear_search(arr: [i64], target: i64) -> i64?:
    var i = 0
    while i < arr.len():
        if arr[i] == target:
            return i
        i = i + 1
    nil

# binary_search(target) -> index of target, or nil if absent. Requires arr sorted ascending;
# behavior is undefined otherwise.
fn binary_search(arr: [i64], target: i64) -> i64?:
    var lo = 0
    var hi = arr.len() - 1
    while lo <= hi:
        val mid = (lo + hi) / 2
        if arr[mid] == target:
            return mid
        elif arr[mid] < target:
            lo = mid + 1
        else:
            hi = mid - 1
    nil

# find_min() -> smallest element, or nil for an empty array.
fn find_min(arr: [i64]) -> i64?:
    if arr.len() == 0:
        return nil
    var m = arr[0]
    var i = 1
    while i < arr.len():
        if arr[i] < m:
            m = arr[i]
        i = i + 1
    m

# find_max() -> largest element, or nil for an empty array.
fn find_max(arr: [i64]) -> i64?:
    if arr.len() == 0:
        return nil
    var m = arr[0]
    var i = 1
    while i < arr.len():
        if arr[i] > m:
            m = arr[i]
        i = i + 1
    m

# find_min_index() -> index of the smallest element (first occurrence if tied), or nil
# for an empty array.
fn find_min_index(arr: [i64]) -> i64?:
    if arr.len() == 0:
        return nil
    var min_val = arr[0]
    var min_idx = 0
    var i = 1
    while i < arr.len():
        if arr[i] < min_val:
            min_val = arr[i]
            min_idx = i
        i = i + 1
    min_idx

# find_max_index() -> index of the largest element (first occurrence if tied), or nil
# for an empty array.
fn find_max_index(arr: [i64]) -> i64?:
    if arr.len() == 0:
        return nil
    var max_val = arr[0]
    var max_idx = 0
    var i = 1
    while i < arr.len():
        if arr[i] > max_val:
            max_val = arr[i]
            max_idx = i
        i = i + 1
    max_idx

fn reverse_list(arr: [i64]) -> [i64]:
    var result: [i64] = []
    var i = arr.len() - 1
    while i >= 0:
        result = result.push(arr[i])
        i = i - 1
    result

fn take(arr: [i64], n: i64) -> [i64]:
    var result: [i64] = []
    var limit = n
    if n > arr.len():
        limit = arr.len()
    var i = 0
    while i < limit:
        result = result.push(arr[i])
        i = i + 1
    result

fn drop(arr: [i64], n: i64) -> [i64]:
    var result: [i64] = []
    var i = n
    if i < 0:
        i = 0
    while i < arr.len():
        result = result.push(arr[i])
        i = i + 1
    result

fn sum(arr: [i64]) -> i64:
    var total = 0
    var i = 0
    while i < arr.len():
        total = total + arr[i]
        i = i + 1
    total

fn count_occurrences(arr: [i64], target: i64) -> i64:
    var count = 0
    var i = 0
    while i < arr.len():
        if arr[i] == target:
            count = count + 1
        i = i + 1
    count

fn find_all_indices(arr: [i64], target: i64) -> [i64]:
    var result: [i64] = []
    var i = 0
    while i < arr.len():
        if arr[i] == target:
            result = result.push(i)
        i = i + 1
    result

fn _contains(arr: [i64], v: i64) -> bool:
    var i = 0
    while i < arr.len():
        if arr[i] == v:
            return true
        i = i + 1
    false

fn remove_duplicates(arr: [i64]) -> [i64]:
    var result: [i64] = []
    var i = 0
    while i < arr.len():
        val v = arr[i]
        if _contains(result, v) == false:
            result = result.push(v)
        i = i + 1
    result

# is_prefix(arr) -> true if prefix matches arr's leading elements exactly. An empty
# prefix always matches.
fn is_prefix(prefix: [i64], arr: [i64]) -> bool:
    if prefix.len() > arr.len():
        return false
    var i = 0
    while i < prefix.len():
        if prefix[i] != arr[i]:
            return false
        i = i + 1
    true

# is_suffix(arr) -> true if suffix matches arr's trailing elements exactly. An empty
# suffix always matches.
fn is_suffix(suffix: [i64], arr: [i64]) -> bool:
    val sl = suffix.len()
    val al = arr.len()
    if sl > al:
        return false
    val offset = al - sl
    var i = 0
    while i < sl:
        if suffix[i] != arr[offset + i]:
            return false
        i = i + 1
    true

fn _swap_generic<T>(arr: [T], i: i64, j: i64) -> [T]:
    var result: [T] = []
    var k = 0
    while k < arr.len():
        if k == i:
            result = result.push(arr[j])
        elif k == j:
            result = result.push(arr[i])
        else:
            result = result.push(arr[k])
        k = k + 1
    result

# appended(x) -> new array with x at the end. Receiver unchanged
# (arrays are value types); matches interpreter's Value::appended.
fn appended<T>(arr: [T], x: T) -> [T]:
    var result: [T] = []
    var i = 0
    while i < arr.len():
        result = result.push(arr[i])
        i = i + 1
    result = result.push(x)
    result

# prepended(x) -> new array with x at the front.
fn prepended<T>(arr: [T], x: T) -> [T]:
    var result: [T] = [x]
    var i = 0
    while i < arr.len():
        result = result.push(arr[i])
        i = i + 1
    result

# reversed() -> new reversed array (receiver unchanged).
fn reversed<T>(arr: [T]) -> [T]:
    var result: [T] = []
    var i = arr.len() - 1
    while i >= 0:
        result = result.push(arr[i])
        i = i - 1
    result

# sorted() -> new sorted-ascending array (stable insertion sort;
# matches interpreter's Value::sorted).
fn sorted<T>(arr: [T]) -> [T]:
    val n = arr.len()
    if n <= 1:
        return arr
    var result = arr
    var i = 1
    while i < n:
        var j = i
        while j > 0:
            if result[j - 1] > result[j]:
                result = _swap_generic(result, j - 1, j)
                j = j - 1
            else:
                j = 0
        i = i + 1
    result

# sort_desc() -> new sorted-descending array.
fn sort_desc<T>(arr: [T]) -> [T]:
    reversed(sorted(arr))

# find_sublist(needle) -> index of needle's first occurrence in haystack as a contiguous
# run, or nil if not found. An empty needle matches at index 0.
fn find_sublist(haystack: [i64], needle: [i64]) -> i64?:
    val hl = haystack.len()
    val nl = needle.len()
    if nl == 0:
        return 0
    if nl > hl:
        return nil
    var i = 0
    while i <= hl - nl:
        var j = 0
        var match = true
        while j < nl:
            if haystack[i + j] != needle[j]:
                match = false
            j = j + 1
        if match:
            return i
        i = i + 1
    nil

export is_sorted, lists_equal, swap
export bubble_sort, selection_sort, insertion_sort, quick_sort, merge_sort
export linear_search, binary_search, find_min, find_max
export find_min_index, find_max_index
export reverse_list, take, drop, sum, count_occurrences, find_all_indices
export remove_duplicates, is_prefix, is_suffix, find_sublist
export appended, prepended, sorted, sort_desc, reversed
