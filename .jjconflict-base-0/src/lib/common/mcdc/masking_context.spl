# codex-impl
# Frozen compiler/runtime contract for sound masking MC/DC evidence.

pub const MCDC_MASKING_CONTEXT_SCHEMA_V1 = 1
pub const MCDC_MASKING_CONTEXT_MAX_REQUIREMENTS = 256

# A context is tied to one compiler proof and one target occurrence.  The
# compiler assigns requirement ordinals to Boolean sibling sub-decisions on
# the target-to-root path; it does not project every other leaf away.
pub struct McdcMaskingContext:
    decision_id: i64
    target_ordinal: i64
    proof_id: i64
    context_id: i64
    requirement_count: i64
    strong_coupling: bool

# Fixed-size evidence for one target in one completed decision evaluation.
# `satisfied` means the required sibling sub-decision produced its compiler-
# specified neutral outcome. `masked` means it was not evaluated because of
# short circuit. A pair is admissible only if every requirement is satisfied
# by at least one member and is satisfied-or-masked in both members.
pub struct McdcMaskingContextEvidence:
    decision_id: i64
    owner_id: i64
    sequence: i64
    target_ordinal: i64
    proof_id: i64
    context_id: i64
    satisfied0: i64
    satisfied1: i64
    satisfied2: i64
    satisfied3: i64
    masked0: i64
    masked1: i64
    masked2: i64
    masked3: i64

pub fn mcdc_masking_context_error(context: McdcMaskingContext) -> text:
    if context.decision_id <= 0 or context.target_ordinal < 0:
        return "MCDC-E-CONTEXT-IDENTITY"
    if context.proof_id <= 0 or context.context_id <= 0:
        return "MCDC-E-CONTEXT-PROOF"
    if (context.requirement_count < 0 or
        context.requirement_count > MCDC_MASKING_CONTEXT_MAX_REQUIREMENTS):
        return "MCDC-E-CONTEXT-BOUND"
    return ""

fn mcdc_context_word(evidence: McdcMaskingContextEvidence, word: i64, masked: bool) -> i64:
    if masked:
        match word:
            0: return evidence.masked0
            1: return evidence.masked1
            2: return evidence.masked2
            _: return evidence.masked3
    match word:
        0: return evidence.satisfied0
        1: return evidence.satisfied1
        2: return evidence.satisfied2
        _: return evidence.satisfied3
    return 0

fn mcdc_low_bits(count: i64) -> i64:
    if count <= 0: return 0
    if count >= 64: return -1
    return (1 << count) - 1

pub fn mcdc_masking_evidence_matches_context(
    context: McdcMaskingContext, evidence: McdcMaskingContextEvidence
) -> bool:
    if mcdc_masking_context_error(context) != "": return false
    if (context.decision_id != evidence.decision_id or
        context.target_ordinal != evidence.target_ordinal or
        context.proof_id != evidence.proof_id or
        context.context_id != evidence.context_id):
        return false
    var word = 0
    while word < 4:
        val remaining = context.requirement_count - word * 64
        val required = mcdc_low_bits(remaining)
        val satisfied = mcdc_context_word(evidence, word, false)
        val masked = mcdc_context_word(evidence, word, true)
        if (satisfied & masked) != 0: return false
        val known = satisfied | masked
        if (known & ~required) != 0: return false
        if (known & required) != required: return false
        word = word + 1
    return true

pub fn mcdc_masking_pair_context_valid(
    context: McdcMaskingContext,
    left: McdcMaskingContextEvidence,
    right: McdcMaskingContextEvidence
) -> bool:
    if (not mcdc_masking_evidence_matches_context(context, left) or
        not mcdc_masking_evidence_matches_context(context, right)):
        return false
    var word = 0
    while word < 4:
        val remaining = context.requirement_count - word * 64
        val required = mcdc_low_bits(remaining)
        val jointly_satisfied = (
            mcdc_context_word(left, word, false) |
            mcdc_context_word(right, word, false))
        if (jointly_satisfied & required) != required: return false
        word = word + 1
    return true
