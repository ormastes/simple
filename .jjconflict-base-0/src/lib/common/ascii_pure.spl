# Pure-Simple ASCII-ness probe.
#
# C-MIG-0039 companion: `is_ascii_text` mirrors the Rust-interpreter extern
# `rt_text_is_ascii` (src/compiler_rust/compiler/src/interpreter_extern/
# simd.rs::rt_text_is_ascii, registered mod.rs:1916 — `s.is_ascii()`, i.e.
# every byte < 0x80) via an explicit byte-value scan, genuinely different
# machinery from the extern's Rust stdlib call.

# True iff every byte of `s` is in the ASCII range (0x00..0x7F). Matches
# Rust's `str::is_ascii` — a UTF-8 multibyte codepoint always has at least
# one byte >= 0x80, so this also correctly rejects any non-ASCII text.
pub fn is_ascii_text(s: text) -> bool:
    val bs = s.bytes()
    val n = bs.len()
    var i = 0
    while i < n:
        if bs[i] >= 128:
            return false
        i = i + 1
    return true
