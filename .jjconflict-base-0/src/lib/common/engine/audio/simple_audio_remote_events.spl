# codex-impl
# Maps remote audio driver lifecycle into the shared ordered device-event ring.

use std.io.simple_device_event.{SimpleDeviceEventRing}

struct SimpleAudioRemoteEventResult:
    publish_status: text
    event_kind: text
    event_status: text
    accepted_device_result: bool
    cpu_fallback: bool

fn simple_audio_remote_event_kind(driver_status: text) -> text:
    if driver_status == "accepted-device-result":
        return "audio-period"
    if driver_status == "pending":
        return "audio-offload-pending"
    if driver_status == "device-reset" or driver_status == "device-lost":
        return "device-reset"
    if driver_status == "shutdown":
        return "shutdown"
    if driver_status.starts_with("cpu-fallback"):
        return "audio-offload-fallback"
    "audio-offload-fault"

fn simple_audio_remote_event_status(driver_status: text) -> text:
    if driver_status == "accepted-device-result":
        return "remote-host-cuda-readback"
    if driver_status == "pending":
        return "pending"
    if driver_status == "shutdown":
        return "completed"
    driver_status

fn simple_audio_publish_remote_event(events: SimpleDeviceEventRing, monotonic_ns: u64, device_clock_frames: u64, device_id: i64, stream_id: i64, correlation_id: u64, driver_status: text) -> SimpleAudioRemoteEventResult:
    val kind = simple_audio_remote_event_kind(driver_status)
    val status = simple_audio_remote_event_status(driver_status)
    val published = events.publish(monotonic_ns, device_clock_frames, device_id, stream_id, correlation_id, kind, status)
    SimpleAudioRemoteEventResult(publish_status: published, event_kind: kind, event_status: status, accepted_device_result: driver_status == "accepted-device-result", cpu_fallback: driver_status.starts_with("cpu-fallback"))
