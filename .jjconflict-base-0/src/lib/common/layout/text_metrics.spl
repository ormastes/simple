# Monospace inline text metrics — common.layout.text_metrics
#
# WHY THIS MODULE EXISTS
#
# Inline text measurement was absent from the blink render lane entirely, which
# blocked every pixel consumer: blink could not decide how wide a run of text
# is, so it could not lay text out at all. The live lane
# (`gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_layout.spl`)
# has the logic, but blink is architecturally a LEAF — it imports only `blink`,
# `skia` and `common`, never `gc_async_mut.gpu.**` — so the live implementation
# is unreachable from it. Copying it into blink would have added yet another
# member to a duplicate family the repo is already trying to shrink. So the
# logic lands HERE, in `common/`, which both lanes may import.
#
# THE THREE WIDTH CONTRACTS — DO NOT MERGE THESE
#
# The repo has three superficially similar "how wide is this string" helpers.
# They answer three DIFFERENT questions and are not interchangeable; reusing one
# where another is meant is a behaviour change, not a dedupe:
#
#   1. PIXEL ADVANCE (this module). "How many device pixels does this run
#      occupy at font size N?" Scales with font size, applies letter- and
#      word-spacing. Consumers: the browser/blink layout lanes.
#   2. ANSI-STRIPPED VISIBLE COLUMNS (`app/ui.render/layout.spl:96 text_width`,
#      `app/ui.tui/screen.spl:118 _visible_width`, and the `pad_to_width` family
#      built on them). "How many terminal columns will this print in, ignoring
#      the escape sequences?" It skips ESC..letter runs — a concern this module
#      has none of — and counts every visible character as exactly one column,
#      including CJK.
#   3. TERMINAL CELL COLUMNS (`common/spec/evidence/format/terminal_grid.spl
#      display_width_of`). Like (2) but Unicode-correct: wide glyphs take two
#      cells and combining marks take none. It has no ANSI handling.
#
# This module supplies the Unicode classification that (1) and (3) share, and
# `terminal_grid.spl` now delegates to it rather than keeping a second copy.
# Contract (2) is deliberately NOT unified with either: ANSI stripping is a
# terminal-transport concern that has no meaning in a pixel lane, and its
# "every character is one column" rule contradicts (3) for CJK.
#
# MEASURED DEFECT IN THE LIVE LANE (2026-08-11)
#
# `text.len()` is BYTE length while `char_code_at(i)` is CODEPOINT indexed.
# Measured directly: for "aé漢", `len()` is 6 but there are only 3 codepoints,
# and `char_code_at(3..5)` returns 0. The live lane's
# `inline_text_advance_width` loops `while i < raw.len()` calling
# `char_code_at(i)`, and `intrinsic_text_width` computes `txt.len() * ink_w`, so
# BOTH measure multi-byte text by its UTF-8 byte count — "漢" is charged three
# characters' worth of advance and two phantom zero-codepoints are measured on
# top. This module iterates codepoints instead, so it disagrees with the live
# lane on any non-ASCII string. That divergence is intentional and is the
# correct side of the disagreement; see
# doc/08_tracking/bug/live_lane_inline_text_measure_counts_utf8_bytes_2026-08-11.md.

use std.common.encoding.utf8.{text_codepoints, char_from_codepoint}

# --------------------------------------------------------------------------
# Unicode column classification (shared with terminal_grid.spl)
# --------------------------------------------------------------------------

fn _in_range(cp: i64, lo: i64, hi: i64) -> bool:
    cp >= lo and cp <= hi

pub fn is_zero_width_codepoint(cp: i64) -> bool:
    """Return true when `cp` advances no column: a combining mark, a variation
    selector, or a zero-width joiner."""
    if _in_range(cp, 0x0300, 0x036F):
        return true
    if _in_range(cp, 0xFE00, 0xFE0F):
        return true
    if cp == 0x200D:
        return true
    false

pub fn is_wide_codepoint(cp: i64) -> bool:
    """Return true when `cp` occupies two columns: East-Asian wide/fullwidth
    blocks and the common emoji planes."""
    if _in_range(cp, 0x1100, 0x115F):
        return true
    if _in_range(cp, 0x2E80, 0x303E):
        return true
    if _in_range(cp, 0x3041, 0x33FF):
        return true
    if _in_range(cp, 0x3400, 0x4DBF):
        return true
    if _in_range(cp, 0x4E00, 0x9FFF):
        return true
    if _in_range(cp, 0xAC00, 0xD7A3):
        return true
    if _in_range(cp, 0xF900, 0xFAFF):
        return true
    if _in_range(cp, 0xFF00, 0xFF60):
        return true
    if _in_range(cp, 0x1F300, 0x1FAFF):
        return true
    if _in_range(cp, 0x1F000, 0x1F2FF):
        return true
    false

pub fn codepoint_cells(cp: i64) -> i64:
    """Return how many monospace cells `cp` advances: 0, 1 or 2."""
    if is_zero_width_codepoint(cp):
        return 0
    if is_wide_codepoint(cp):
        return 2
    1

pub fn text_cell_width(s: text) -> i64:
    """Return the monospace cell width of `s`, counting by codepoint.

    This is a CELL count, not a pixel advance and not an ANSI-aware visible
    width — see the contract table at the top of this file."""
    val cps = text_codepoints(s)
    var total: i64 = 0
    var i: i64 = 0
    while i < cps.len():
        total = total + codepoint_cells(cps[i])
        i = i + 1
    total

# --------------------------------------------------------------------------
# Pixel metrics
# --------------------------------------------------------------------------

# The glyph geometry constants below reproduce the live lane's bitmap font so
# that ASCII measurements agree pixel-for-pixel:
#   glyph_scale(fs) = max(1, fs / 8)
#   advance         = 4 when fs <= 8, else 5 * scale
#   line height     = 9 * scale
pub fn glyph_scale(font_size_px: i64) -> i64:
    """Return the integer bitmap-font scale factor for `font_size_px`."""
    var s = font_size_px / 8
    if s < 1:
        s = 1
    s

struct TextMetrics:
    """Resolved per-run advance metrics, in device pixels.

    `cell_advance_px` is the advance of one single-width cell; a wide glyph
    costs twice that and a zero-width one costs nothing."""
    cell_advance_px: i64
    space_advance_px: i64
    line_height_px: i64

pub fn monospace_metrics(
    font_size_px: i64,
    letter_spacing_px: i64,
    word_spacing_px: i64,
    line_height_px: i64
) -> TextMetrics:
    """Return the metrics for a monospace run at `font_size_px`.

    A `line_height_px` of 0 or less means "use the font's natural line height".
    Advances are clamped to at least 1px so a run of text can never measure
    zero and collapse a line box."""
    val scale = glyph_scale(font_size_px)
    var advance = if font_size_px <= 8: 4 else: 5 * scale
    advance = advance + letter_spacing_px
    if advance < 1:
        advance = 1
    var space = advance / 2 + word_spacing_px
    if space < 1:
        space = 1
    var line_h = line_height_px
    if line_h <= 0:
        line_h = 9 * scale
    TextMetrics(
        cell_advance_px: advance,
        space_advance_px: space,
        line_height_px: line_h
    )

pub fn baseline_offset_px(m: TextMetrics) -> i64:
    """Return the baseline's y offset from the top of the line box.

    The bitmap font's ink sits on the upper 2/3 of the line box, so the
    baseline is 2/3 of the way down, and never above the first pixel row."""
    var b = m.line_height_px * 2 / 3
    if b < 1:
        b = 1
    b

pub fn measure_codepoints(cps: [i64], m: TextMetrics) -> i64:
    """Return the advance width in pixels of `cps` under `m`.

    A space uses `space_advance_px`; every other codepoint costs its cell count
    times `cell_advance_px`, so a wide glyph is charged double and a combining
    mark is free."""
    var width: i64 = 0
    var i: i64 = 0
    while i < cps.len():
        val cp = cps[i]
        if cp == 32:
            width = width + m.space_advance_px
        else:
            width = width + codepoint_cells(cp) * m.cell_advance_px
        i = i + 1
    width

pub fn measure_text(s: text, m: TextMetrics) -> i64:
    """Return the advance width in pixels of `s` under `m`.

    Measured by CODEPOINT, so a multi-byte character is charged once and not
    once per UTF-8 byte."""
    measure_codepoints(text_codepoints(s), m)

pub fn measure_range(cps: [i64], start: i64, endv: i64, m: TextMetrics) -> i64:
    """Return the advance width of `cps[start..endv]` under `m`.

    Indices are CODEPOINT indices. An out-of-order or out-of-range span
    measures the clamped overlap rather than reading past the end."""
    var lo = start
    var hi = endv
    if lo < 0:
        lo = 0
    if hi > cps.len():
        hi = cps.len()
    var width: i64 = 0
    var i = lo
    while i < hi:
        val cp = cps[i]
        if cp == 32:
            width = width + m.space_advance_px
        else:
            width = width + codepoint_cells(cp) * m.cell_advance_px
        i = i + 1
    width

# --------------------------------------------------------------------------
# Line breaking
# --------------------------------------------------------------------------

pub fn wrap_line_end(cps: [i64], start: i64, max_width_px: i64, m: TextMetrics) -> i64:
    """Return the codepoint index one past the last codepoint that fits on a
    line beginning at `start`, within `max_width_px`.

    Breaks at the last space before the overflow when there is one, so words
    stay whole; a single word longer than the line is broken mid-word rather
    than looping forever. The returned index is always greater than `start`
    while any input remains, which is what makes a wrapping loop terminate."""
    val n = cps.len()
    if start >= n:
        return n
    var width: i64 = 0
    var last_space: i64 = -1
    var i = start
    while i < n:
        val cp = cps[i]
        val adv = if cp == 32: m.space_advance_px else: codepoint_cells(cp) * m.cell_advance_px
        if width + adv > max_width_px and i > start:
            if last_space > start:
                return last_space
            return i
        if cp == 32:
            last_space = i
        width = width + adv
        i = i + 1
    n

pub fn wrap_text_lines(s: text, max_width_px: i64, m: TextMetrics) -> [text]:
    """Return `s` broken into lines each fitting within `max_width_px`.

    An empty input yields one empty line, so a wrapped empty paragraph still
    occupies one line box rather than none."""
    val cps = text_codepoints(s)
    var out: [text] = []
    if cps.len() == 0:
        out.push("")
        return out
    var start: i64 = 0
    while start < cps.len():
        val endv = wrap_line_end(cps, start, max_width_px, m)
        var line = ""
        var i = start
        while i < endv:
            line = line + char_from_codepoint(cps[i])
            i = i + 1
        out.push(line)
        var next = endv
        # Skip the space the break consumed so it does not open the next line.
        while next < cps.len() and cps[next] == 32:
            next = next + 1
        if next <= start:
            next = start + 1
        start = next
    out
