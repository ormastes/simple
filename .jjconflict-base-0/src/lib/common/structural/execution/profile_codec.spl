# ============================================================================
# common/structural/execution/profile_codec.spl — CPU reference serializer and
# deserializer for the frozen ExecutionProfile / capability contract v1.
#
# Architecture §21, §21.1, §26 (artifact group 9). Layout is normative in
# doc/05_design/platform/structural_compute/execution_profile_contract_v1.md
# and pinned byte-for-byte by test/fixtures/structural/
# execution_profile_golden_v1.{spl,sdn}.
#
# Conventions are wire.spl's, shared with every other frozen structural group:
# little-endian, fixed width, no padding, no alignment; an 8-byte envelope of
# magic u32 | version u16 | reserved u16 (== 0); lists and texts as u32 count
# then elements; unknown discriminants and set reserved bits HARD-REJECTED.
#
# Both directions enforce the SAME invariant gate
# (`stage_execution_profile_valid` / `stage_capabilities_valid`). An encoder
# that accepts what its decoder refuses is how a contract rots from one side;
# more to the point, a profile whose requested mode its own device mask
# forbids can only ever be honoured by an unannounced fallback, so refusing to
# serialize it is what makes the receipt lane's "no silent fallback"
# guarantee reachable instead of aspirational.
# ============================================================================

use std.common.structural.wire.{
    WIRE_ENVELOPE_LEN,
    wire_check_envelope,
    wire_get_u32,
    wire_get_u64,
    wire_get_u8,
    wire_has,
    wire_magic,
    wire_put_envelope,
    wire_put_u32,
    wire_put_u64,
    wire_put_u8
}
use std.common.compute.placement_contracts.semantic.{ExecutionMode}
use std.common.structural.receipt.receipt_types.{
    VerificationPolicy,
    execution_mode_from_u8,
    execution_mode_to_u8,
    execution_mode_valid,
    verification_policy_from_u8,
    verification_policy_to_u8,
    verification_policy_valid
}
use std.common.structural.execution.profile_types.{
    STRUCTURAL_EXECUTION_PROFILE_VERSION,
    StageCapabilities,
    StageExecutionProfile,
    StageFallbackPolicy,
    stage_capabilities,
    stage_capabilities_valid,
    stage_capabilities_zero,
    stage_execution_profile,
    stage_execution_profile_valid,
    stage_execution_profile_zero,
    stage_fallback_policy_from_u8,
    stage_fallback_policy_to_u8,
    stage_fallback_policy_valid,
    wire_bool_from_u8,
    wire_bool_to_u8,
    wire_bool_valid
}

# ----------------------------------------------------------------------------
# Magics. Four ASCII bytes each, "SX" for structural-execution, then the record.
# Distinct from the receipt family's SRSR/SRVR/SRMS so a buffer handed to the
# wrong decoder is rejected by the envelope rather than misread.
# ----------------------------------------------------------------------------

fn profile_magic_execution() -> i64:
    wire_magic("SXEP")

fn profile_magic_capabilities() -> i64:
    wire_magic("SXSC")

# ----------------------------------------------------------------------------
# Fixed body extents
#
# StageExecutionProfile, 48 bytes, no padding:
#   contract_version u32 @0  | mode u8 @4 | deterministic u8 @5
#   | fallback u8 @6 | verification u8 @7
#   | host_memory_budget u64 @8    | device_memory_budget u64 @16
#   | latency_target_us u64 @24    | throughput_target u64 @32
#   | allowed_devices u64 @40
#
# StageCapabilities head, 16 bytes, followed by the backend text:
#   contract_version u32 @0 | supported_modes u8 @4 | storage_tiers u8 @5
#   | max_verification u8 @6 | deterministic u8 @7 | device_mask u64 @8
#   | backend text @16 (u32 len, then that many ASCII bytes)
# ----------------------------------------------------------------------------

val STAGE_EXECUTION_PROFILE_LEN: i64 = 48
val STAGE_CAPABILITIES_HEAD_LEN: i64 = 16

struct StageExecutionProfileResult:
    ok: bool
    value: StageExecutionProfile

struct StageCapabilitiesResult:
    ok: bool
    value: StageCapabilities

fn profile_reject() -> StageExecutionProfileResult:
    StageExecutionProfileResult(ok: false, value: stage_execution_profile_zero())

fn capabilities_reject() -> StageCapabilitiesResult:
    StageCapabilitiesResult(ok: false, value: stage_capabilities_zero())

# ----------------------------------------------------------------------------
# Text fields — ASCII only, u32 length then bytes.
#
# Same rule and same reasoning as the receipt codec: a BackendId is ASCII by
# construction, one byte per character keeps a golden vector hand-derivable,
# and a non-ASCII byte becomes a loud failure rather than a re-encoded one.
# ----------------------------------------------------------------------------

val PROFILE_ASCII: text =
    " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

fn profile_text_ascii(s: text) -> bool:
    var i = 0
    while i < s.len():
        val c = s.char_code_at(i)
        if c < 32 or c > 126:
            return false
        i = i + 1
    true

fn profile_put_text(out: [u8], s: text) -> [u8]:
    var b = wire_put_u32(out, s.len())
    var i = 0
    while i < s.len():
        b = wire_put_u8(b, s.char_code_at(i))
        i = i + 1
    b

fn profile_text_from_code(c: i64) -> text:
    if c < 32 or c > 126:
        return ""
    PROFILE_ASCII.substring(c - 32, c - 31)

fn profile_read_text(data: [u8], off: i64, n: i64) -> text:
    var s = ""
    var i = 0
    while i < n:
        s = s + profile_text_from_code(data[off + i] & 0xFF)
        i = i + 1
    s

fn profile_read_text_len(data: [u8], off: i64) -> i64:
    """Length of the text field at `off`, or -1 when unreadable or holding a
    byte outside printable ASCII."""
    if not wire_has(data, off, 4):
        return -1
    val n = wire_get_u32(data, off)
    if n < 0:
        return -1
    if not wire_has(data, off + 4, n):
        return -1
    var i = 0
    while i < n:
        val c = data[off + 4 + i] & 0xFF
        if c < 32 or c > 126:
            return -1
        i = i + 1
    n

# ----------------------------------------------------------------------------
# StageExecutionProfile
# ----------------------------------------------------------------------------

fn stage_execution_profile_encodable(p: StageExecutionProfile) -> bool:
    """Everything encode refuses, exposed separately so a spec can assert the
    REASON for a refusal rather than only the empty buffer."""
    stage_execution_profile_valid(p)

fn encode_stage_execution_profile(p: StageExecutionProfile) -> [u8]:
    """Serialize a profile. An invalid profile encodes to an EMPTY buffer
    rather than to bytes: an unsatisfiable request must not be able to reach a
    backend, because the only way to "honour" it is the silent fallback §21.4
    forbids."""
    var b: [u8] = []
    if not stage_execution_profile_encodable(p):
        return b
    b = wire_put_envelope(b, profile_magic_execution(),
                          STRUCTURAL_EXECUTION_PROFILE_VERSION)
    b = wire_put_u32(b, p.contract_version)
    b = wire_put_u8(b, execution_mode_to_u8(p.mode))
    b = wire_put_u8(b, wire_bool_to_u8(p.deterministic))
    b = wire_put_u8(b, stage_fallback_policy_to_u8(p.fallback))
    b = wire_put_u8(b, verification_policy_to_u8(p.verification))
    b = wire_put_u64(b, p.host_memory_budget)
    b = wire_put_u64(b, p.device_memory_budget)
    b = wire_put_u64(b, p.latency_target_us)
    b = wire_put_u64(b, p.throughput_target)
    wire_put_u64(b, p.allowed_devices)

fn decode_stage_execution_profile(data: [u8]) -> StageExecutionProfileResult:
    if not wire_check_envelope(data, 0, profile_magic_execution(),
                               STRUCTURAL_EXECUTION_PROFILE_VERSION):
        return profile_reject()
    if data.len() != WIRE_ENVELOPE_LEN + STAGE_EXECUTION_PROFILE_LEN:
        return profile_reject()
    val off = WIRE_ENVELOPE_LEN
    val version = wire_get_u32(data, off)
    if version != STRUCTURAL_EXECUTION_PROFILE_VERSION:
        return profile_reject()
    val raw_mode = wire_get_u8(data, off + 4)
    if not execution_mode_valid(raw_mode):
        return profile_reject()
    val raw_det = wire_get_u8(data, off + 5)
    if not wire_bool_valid(raw_det):
        return profile_reject()
    val raw_fallback = wire_get_u8(data, off + 6)
    if not stage_fallback_policy_valid(raw_fallback):
        return profile_reject()
    val raw_verify = wire_get_u8(data, off + 7)
    if not verification_policy_valid(raw_verify):
        return profile_reject()
    val out = stage_execution_profile(
        execution_mode_from_u8(raw_mode),
        wire_bool_from_u8(raw_det),
        wire_get_u64(data, off + 8),
        wire_get_u64(data, off + 16),
        wire_get_u64(data, off + 24),
        wire_get_u64(data, off + 32),
        stage_fallback_policy_from_u8(raw_fallback),
        verification_policy_from_u8(raw_verify),
        wire_get_u64(data, off + 40)
    )
    if not stage_execution_profile_valid(out):
        return profile_reject()
    StageExecutionProfileResult(ok: true, value: out)

# ----------------------------------------------------------------------------
# StageCapabilities
# ----------------------------------------------------------------------------

fn stage_capabilities_encodable(c: StageCapabilities) -> bool:
    if not stage_capabilities_valid(c):
        return false
    profile_text_ascii(c.backend)

fn encode_stage_capabilities(c: StageCapabilities) -> [u8]:
    var b: [u8] = []
    if not stage_capabilities_encodable(c):
        return b
    b = wire_put_envelope(b, profile_magic_capabilities(),
                          STRUCTURAL_EXECUTION_PROFILE_VERSION)
    b = wire_put_u32(b, c.contract_version)
    b = wire_put_u8(b, c.supported_modes)
    b = wire_put_u8(b, c.storage_tiers)
    b = wire_put_u8(b, verification_policy_to_u8(c.max_verification))
    b = wire_put_u8(b, wire_bool_to_u8(c.deterministic))
    b = wire_put_u64(b, c.device_mask)
    profile_put_text(b, c.backend)

fn decode_stage_capabilities(data: [u8]) -> StageCapabilitiesResult:
    if not wire_check_envelope(data, 0, profile_magic_capabilities(),
                               STRUCTURAL_EXECUTION_PROFILE_VERSION):
        return capabilities_reject()
    val off = WIRE_ENVELOPE_LEN
    if not wire_has(data, off, STAGE_CAPABILITIES_HEAD_LEN):
        return capabilities_reject()
    val version = wire_get_u32(data, off)
    if version != STRUCTURAL_EXECUTION_PROFILE_VERSION:
        return capabilities_reject()
    val raw_modes = wire_get_u8(data, off + 4)
    val raw_storage = wire_get_u8(data, off + 5)
    val raw_verify = wire_get_u8(data, off + 6)
    if not verification_policy_valid(raw_verify):
        return capabilities_reject()
    val raw_det = wire_get_u8(data, off + 7)
    if not wire_bool_valid(raw_det):
        return capabilities_reject()
    val device_mask = wire_get_u64(data, off + 8)
    val name_off = off + STAGE_CAPABILITIES_HEAD_LEN
    val name_len = profile_read_text_len(data, name_off)
    if name_len < 0:
        return capabilities_reject()
    # Trailing-byte rejection: the record is exactly its head plus its one
    # text field. A buffer with extra bytes is a different record, not a
    # tolerant read of this one.
    if data.len() != name_off + 4 + name_len:
        return capabilities_reject()
    val out = stage_capabilities(
        profile_read_text(data, name_off + 4, name_len),
        raw_modes,
        raw_storage,
        verification_policy_from_u8(raw_verify),
        wire_bool_from_u8(raw_det),
        device_mask
    )
    if not stage_capabilities_valid(out):
        return capabilities_reject()
    StageCapabilitiesResult(ok: true, value: out)

export STAGE_EXECUTION_PROFILE_LEN, STAGE_CAPABILITIES_HEAD_LEN
export StageExecutionProfileResult, StageCapabilitiesResult
export profile_magic_execution, profile_magic_capabilities
export profile_text_ascii
export stage_execution_profile_encodable, stage_capabilities_encodable
export encode_stage_execution_profile, decode_stage_execution_profile
export encode_stage_capabilities, decode_stage_capabilities
