# ============================================================================
# common/structural/receipt/receipt_codec.spl — CPU reference serializers
#
# CPU reference codec for the frozen StageReceipt / VerificationReceipt
# contract (architecture §21.3, §21.4, §26 group 7). This is the oracle: any
# future GPU-resident or bridge-side receipt writer must produce byte-identical
# output.
#
# Layout (little-endian, no padding — see common/structural/wire.spl):
#
#   text            u32 len | len ASCII bytes         (wire.spl's list rule)
#
#   MappingShardRef 52   snapshot SnapshotId 28 | shard_index u32 4
#                        | edge_count u32 4 | content_hash Hash128 16
#
#   StageReceipt    envelope(8) | contract_version u32 | requested_mode u8
#                        | mode u8 | fallback_reason u8
#                        | item_count_in u64 | item_count_out u64
#                        | bytes_read u64 | bytes_written u64
#                        | fallback_count u32 | malformed_count u32
#                        | overflow_flags u64 | elapsed_us u64
#                        | stage text | backend text | candidate_backend text
#                        | input_hash text | output_hash text
#                        | deterministic_hash text
#                   fixed head 63 bytes, then six length-prefixed texts
#
#   VerificationReceipt envelope(8) | contract_version u32 | mode u8
#                        | policy u8 | outcome u8
#                        | checked_count u64 | mismatch_count u64
#                        | first_mismatch EntityRef 8 | elapsed_us u64
#                        | origins MappingShardRef 52
#                        | stage text | backend text
#                        | result_hash text | oracle_hash text
#                   fixed head 91 bytes, then four length-prefixed texts
#
# WHY `requested_mode` IS ON THE WIRE BUT NOT IN THE STRUCT
# --------------------------------------------------------
# The in-tree StageReceipt (structural/execution/contracts.spl) has no
# requested-mode field, and this lane does not redeclare or edit a struct 20
# modules read. The requested mode is therefore an explicit parameter of
# `encode_stage_receipt` and an explicit field of StageReceiptResult. It has
# to be on the wire: without it, `mode = CpuReference` cannot be told from a
# CPU run that was never asked to use a device, and the entire
# cpu_selected-vs-gpu_fallback distinction collapses. Ratification item R1 in
# the contract document proposes adding the field to the struct.
#
# HARD REJECTS, never a silent default:
#   - wrong magic, wrong version, non-zero envelope reserved;
#   - unknown ExecutionMode / StageFallbackReason / VerificationPolicy /
#     VerificationOutcome discriminant;
#   - a mode or fallback-reason TEXT spelling this build does not sanction
#     (the in-tree fields are free-form `text` and call sites write ad-hoc
#     strings; passing an unrecognised reason through would record a
#     degradation nobody can act on);
#   - a non-ASCII byte in any text field;
#   - a declared text length that runs past the buffer;
#   - a receipt that fails `stage_receipt_selection_consistent` — that is the
#     no-silent-fallback rule of §21.4 enforced at the wire, so a stage that
#     changed mode without saying why cannot be serialized at all;
#   - a receipt that fails `verification_receipt_consistent`;
#   - trailing bytes after the record.
#
# The consistency checks run on ENCODE as well as decode, for the reason wave
# 0b gave: a producer must not be able to put a record on the wire that no
# decoder will accept, and a verification receipt claiming Mismatch with zero
# mismatches is worse than a rejected one — it reads as a pass.
# ============================================================================

use std.common.structural.wire.{
    WIRE_ENVELOPE_LEN,
    wire_check_envelope,
    wire_get_u32,
    wire_get_u64,
    wire_get_u8,
    wire_has,
    wire_magic,
    wire_put_envelope,
    wire_put_u32,
    wire_put_u64,
    wire_put_u8
}
use std.common.structural.identity.entity_id.{
    ENTITY_REF_LEN,
    EntityRef,
    HASH128_LEN,
    Hash128,
    SNAPSHOT_ID_LEN,
    entity_ref
}
use std.common.structural.identity.identity_codec.{
    entity_ref_put,
    entity_ref_read,
    hash128_put,
    hash128_read,
    snapshot_id_put,
    snapshot_id_read
}
use std.common.structural.execution.contracts.{StageReceipt}
use std.common.compute.placement_contracts.semantic.{ExecutionMode}
use std.common.structural.receipt.receipt_types.{
    MAPPING_SHARD_REF_LEN,
    MappingShardRef,
    RECEIPT_SCHEMA_VERSION,
    StageFallbackReason,
    VerificationOutcome,
    VerificationPolicy,
    VerificationReceipt,
    execution_mode_from_u8,
    execution_mode_to_text,
    execution_mode_to_u8,
    execution_mode_valid,
    mapping_shard_ref,
    mapping_shard_ref_none,
    stage_fallback_reason_from_text,
    stage_fallback_reason_from_u8,
    stage_fallback_reason_to_text,
    stage_fallback_reason_valid,
    stage_receipt_mode_u8,
    stage_receipt_selection_consistent,
    verification_outcome_from_u8,
    verification_outcome_to_u8,
    verification_outcome_valid,
    verification_policy_from_u8,
    verification_policy_to_u8,
    verification_policy_valid,
    verification_receipt,
    verification_receipt_consistent
}

fn receipt_magic_stage() -> i64:
    wire_magic("SRSR")

fn receipt_magic_verification() -> i64:
    wire_magic("SRVR")

fn receipt_magic_shard_ref() -> i64:
    wire_magic("SRMS")

val STAGE_RECEIPT_HEAD_LEN: i64 = 63
val VERIFICATION_RECEIPT_HEAD_LEN: i64 = 91

# ----------------------------------------------------------------------------
# Result carriers — same shape as the ID-TAG and MAP lanes', so a caller that
# already handles an EntityRefResult handles these without a new idiom.
# ----------------------------------------------------------------------------

struct MappingShardRefResult:
    ok: bool
    value: MappingShardRef

struct StageReceiptResult:
    ok: bool
    value: StageReceipt
    requested: ExecutionMode

struct VerificationReceiptResult:
    ok: bool
    value: VerificationReceipt

# ----------------------------------------------------------------------------
# Text fields
#
# ASCII only. Every text field in a receipt is a stage name, a backend name or
# a hex hash, all of which are ASCII by construction; restricting the field
# keeps the encoding one byte per character so a golden vector can be derived
# by hand from the layout, and makes a non-ASCII byte a loud failure rather
# than a silently re-encoded one.
# ----------------------------------------------------------------------------

fn receipt_text_ascii(s: text) -> bool:
    var i = 0
    while i < s.len():
        val c = s.char_code_at(i)
        if c < 0 or c > 127:
            return false
        i = i + 1
    true

fn receipt_put_text(out: [u8], s: text) -> [u8]:
    var b = wire_put_u32(out, s.len())
    var i = 0
    while i < s.len():
        b = wire_put_u8(b, s.char_code_at(i))
        i = i + 1
    b

fn receipt_text_wire_len(s: text) -> i64:
    4 + s.len()

fn receipt_read_text(data: [u8], off: i64, n: i64) -> text:
    var s = ""
    var i = 0
    while i < n:
        s = s + text_from_code(data[off + i] & 0xFF)
        i = i + 1
    s

val RECEIPT_ASCII: text =
    " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

fn text_from_code(c: i64) -> text:
    """Single-character text for an ASCII code. Printable codes 32..126 come
    from the table; anything else is rejected by the caller before it gets
    here, so the empty fallback is unreachable rather than lossy."""
    if c < 32 or c > 126:
        return ""
    RECEIPT_ASCII.substring(c - 32, c - 31)

fn receipt_read_text_field(data: [u8], off: i64) -> i64:
    """Length of the text field at `off`, or -1 if it is unreadable or holds a
    byte outside printable ASCII."""
    if not wire_has(data, off, 4):
        return -1
    val n = wire_get_u32(data, off)
    if n < 0:
        return -1
    if not wire_has(data, off + 4, n):
        return -1
    var i = 0
    while i < n:
        val c = data[off + 4 + i] & 0xFF
        if c < 32 or c > 126:
            return -1
        i = i + 1
    n

# ----------------------------------------------------------------------------
# MappingShardRef
# ----------------------------------------------------------------------------

fn mapping_shard_ref_put(out: [u8], r: MappingShardRef) -> [u8]:
    var b = snapshot_id_put(out, r.snapshot)
    b = wire_put_u32(b, r.shard_index)
    b = wire_put_u32(b, r.edge_count)
    hash128_put(b, r.content_hash)

fn mapping_shard_ref_read(data: [u8], off: i64) -> MappingShardRef:
    """Caller MUST bounds-check MAPPING_SHARD_REF_LEN bytes at `off` first."""
    mapping_shard_ref(snapshot_id_read(data, off),
                      wire_get_u32(data, off + SNAPSHOT_ID_LEN),
                      wire_get_u32(data, off + SNAPSHOT_ID_LEN + 4),
                      hash128_read(data, off + SNAPSHOT_ID_LEN + 8))

fn encode_mapping_shard_ref(r: MappingShardRef) -> [u8]:
    var b: [u8] = []
    b = wire_put_envelope(b, receipt_magic_shard_ref(), RECEIPT_SCHEMA_VERSION)
    mapping_shard_ref_put(b, r)

fn decode_mapping_shard_ref(data: [u8]) -> MappingShardRefResult:
    if not wire_check_envelope(data, 0, receipt_magic_shard_ref(),
                               RECEIPT_SCHEMA_VERSION):
        return MappingShardRefResult(ok: false, value: mapping_shard_ref_none())
    if data.len() != WIRE_ENVELOPE_LEN + MAPPING_SHARD_REF_LEN:
        return MappingShardRefResult(ok: false, value: mapping_shard_ref_none())
    MappingShardRefResult(ok: true,
                          value: mapping_shard_ref_read(data, WIRE_ENVELOPE_LEN))

# ----------------------------------------------------------------------------
# StageReceipt
# ----------------------------------------------------------------------------

fn stage_receipt_reject() -> StageReceiptResult:
    StageReceiptResult(ok: false, value: stage_receipt_zero(),
                       requested: ExecutionMode.CpuReference)

fn stage_receipt_zero() -> StageReceipt:
    """A StageReceipt with every wire field at its zero value and every
    non-wire (layout-lane scratch) field at a documented default. Decode
    reconstructs exactly the wire projection: the scratch fields are NOT part
    of the frozen contract and come back at these defaults, which is why the
    spec compares receipts with stage_receipt_wire_equal and not field-wise."""
    val ids: [i64] = []
    StageReceipt(contract_version: RECEIPT_SCHEMA_VERSION,
                 stage: "", candidate_backend: "", backend: "",
                 mode: "cpu_reference", input_hash: "", output_hash: "",
                 item_count_in: 0, item_count_out: 0,
                 bytes_read: 0, bytes_written: 0,
                 fallback_count: 0, fallback_reason: "",
                 malformed_count: 0, overflow_flags: 0, elapsed_us: 0,
                 deterministic_hash: "",
                 visited_island_ids: ids, converged: false, iterations: 0,
                 cpu_us: 0, gpu_us: 0, submitted: false, synchronized: false,
                 device_readback: false, oracle_verified: false)

fn stage_receipt_wire_equal(a: StageReceipt, b: StageReceipt) -> bool:
    """Equality over exactly the frozen wire projection."""
    (a.contract_version == b.contract_version
        and a.stage == b.stage
        and a.backend == b.backend
        and a.candidate_backend == b.candidate_backend
        and a.mode == b.mode
        and a.fallback_reason == b.fallback_reason
        and a.input_hash == b.input_hash
        and a.output_hash == b.output_hash
        and a.deterministic_hash == b.deterministic_hash
        and a.item_count_in == b.item_count_in
        and a.item_count_out == b.item_count_out
        and a.bytes_read == b.bytes_read
        and a.bytes_written == b.bytes_written
        and a.fallback_count == b.fallback_count
        and a.malformed_count == b.malformed_count
        and a.overflow_flags == b.overflow_flags
        and a.elapsed_us == b.elapsed_us)

fn stage_receipt_encodable(r: StageReceipt, requested: ExecutionMode) -> bool:
    """Everything encode refuses. Kept separate so the spec can assert the
    refusal reason rather than only the empty buffer."""
    if not stage_receipt_selection_consistent(r, requested):
        return false
    if not receipt_text_ascii(r.stage):
        return false
    if not receipt_text_ascii(r.backend):
        return false
    if not receipt_text_ascii(r.candidate_backend):
        return false
    if not receipt_text_ascii(r.input_hash):
        return false
    if not receipt_text_ascii(r.output_hash):
        return false
    receipt_text_ascii(r.deterministic_hash)

fn encode_stage_receipt(r: StageReceipt, requested: ExecutionMode) -> [u8]:
    """Serialize a stage receipt. A receipt that changed mode without naming a
    reason encodes to an EMPTY buffer rather than to bytes that assert a
    silent fallback — §21.4 says a fallback "emits a reason", and a format
    that lets a producer skip it does not implement that sentence."""
    var b: [u8] = []
    if not stage_receipt_encodable(r, requested):
        return b
    b = wire_put_envelope(b, receipt_magic_stage(), RECEIPT_SCHEMA_VERSION)
    b = wire_put_u32(b, r.contract_version)
    b = wire_put_u8(b, execution_mode_to_u8(requested))
    b = wire_put_u8(b, stage_receipt_mode_u8(r))
    b = wire_put_u8(b, stage_fallback_reason_from_text(r.fallback_reason))
    b = wire_put_u64(b, r.item_count_in)
    b = wire_put_u64(b, r.item_count_out)
    b = wire_put_u64(b, r.bytes_read)
    b = wire_put_u64(b, r.bytes_written)
    b = wire_put_u32(b, r.fallback_count)
    b = wire_put_u32(b, r.malformed_count)
    b = wire_put_u64(b, r.overflow_flags)
    b = wire_put_u64(b, r.elapsed_us)
    b = receipt_put_text(b, r.stage)
    b = receipt_put_text(b, r.backend)
    b = receipt_put_text(b, r.candidate_backend)
    b = receipt_put_text(b, r.input_hash)
    b = receipt_put_text(b, r.output_hash)
    receipt_put_text(b, r.deterministic_hash)

fn decode_stage_receipt(data: [u8]) -> StageReceiptResult:
    if not wire_check_envelope(data, 0, receipt_magic_stage(),
                               RECEIPT_SCHEMA_VERSION):
        return stage_receipt_reject()
    if not wire_has(data, WIRE_ENVELOPE_LEN, STAGE_RECEIPT_HEAD_LEN):
        return stage_receipt_reject()
    var off = WIRE_ENVELOPE_LEN
    val version = wire_get_u32(data, off)
    val raw_requested = wire_get_u8(data, off + 4)
    val raw_mode = wire_get_u8(data, off + 5)
    val raw_reason = wire_get_u8(data, off + 6)
    # Three closed enums, three hard rejects. A stage receipt whose mode this
    # build cannot name is worthless: every downstream question about it is a
    # question about which device ran the work.
    if not execution_mode_valid(raw_requested):
        return stage_receipt_reject()
    if not execution_mode_valid(raw_mode):
        return stage_receipt_reject()
    if not stage_fallback_reason_valid(raw_reason):
        return stage_receipt_reject()
    val item_in = wire_get_u64(data, off + 7)
    val item_out = wire_get_u64(data, off + 15)
    val b_read = wire_get_u64(data, off + 23)
    val b_written = wire_get_u64(data, off + 31)
    val fb_count = wire_get_u32(data, off + 39)
    val mal_count = wire_get_u32(data, off + 43)
    val ovf = wire_get_u64(data, off + 47)
    val elapsed = wire_get_u64(data, off + 55)
    off = off + STAGE_RECEIPT_HEAD_LEN

    val n_stage = receipt_read_text_field(data, off)
    if n_stage < 0:
        return stage_receipt_reject()
    val s_stage = receipt_read_text(data, off + 4, n_stage)
    off = off + 4 + n_stage

    val n_backend = receipt_read_text_field(data, off)
    if n_backend < 0:
        return stage_receipt_reject()
    val s_backend = receipt_read_text(data, off + 4, n_backend)
    off = off + 4 + n_backend

    val n_cand = receipt_read_text_field(data, off)
    if n_cand < 0:
        return stage_receipt_reject()
    val s_cand = receipt_read_text(data, off + 4, n_cand)
    off = off + 4 + n_cand

    val n_in = receipt_read_text_field(data, off)
    if n_in < 0:
        return stage_receipt_reject()
    val s_in = receipt_read_text(data, off + 4, n_in)
    off = off + 4 + n_in

    val n_out = receipt_read_text_field(data, off)
    if n_out < 0:
        return stage_receipt_reject()
    val s_out = receipt_read_text(data, off + 4, n_out)
    off = off + 4 + n_out

    val n_det = receipt_read_text_field(data, off)
    if n_det < 0:
        return stage_receipt_reject()
    val s_det = receipt_read_text(data, off + 4, n_det)
    off = off + 4 + n_det

    if data.len() != off:
        return stage_receipt_reject()

    val ids: [i64] = []
    val out = StageReceipt(
        contract_version: version,
        stage: s_stage,
        candidate_backend: s_cand,
        backend: s_backend,
        mode: execution_mode_to_text(execution_mode_from_u8(raw_mode)),
        input_hash: s_in,
        output_hash: s_out,
        item_count_in: item_in,
        item_count_out: item_out,
        bytes_read: b_read,
        bytes_written: b_written,
        fallback_count: fb_count,
        fallback_reason: stage_fallback_reason_to_text(
            stage_fallback_reason_from_u8(raw_reason)),
        malformed_count: mal_count,
        overflow_flags: ovf,
        elapsed_us: elapsed,
        deterministic_hash: s_det,
        visited_island_ids: ids, converged: false, iterations: 0,
        cpu_us: 0, gpu_us: 0, submitted: false, synchronized: false,
        device_readback: false, oracle_verified: false)
    val requested = execution_mode_from_u8(raw_requested)
    # Re-run the full structural rule so decode accepts exactly the set encode
    # emits. This is what catches a hand-forged buffer that pairs a diverged
    # mode with reason None.
    if not stage_receipt_selection_consistent(out, requested):
        return stage_receipt_reject()
    StageReceiptResult(ok: true, value: out, requested: requested)

# ----------------------------------------------------------------------------
# VerificationReceipt
# ----------------------------------------------------------------------------

fn verification_receipt_reject() -> VerificationReceiptResult:
    VerificationReceiptResult(
        ok: false,
        value: verification_receipt("", "", ExecutionMode.CpuReference,
                                    VerificationPolicy.Off,
                                    VerificationOutcome.NotRun, 0, 0,
                                    entity_ref(0, 0), "", "",
                                    mapping_shard_ref_none(), 0))

fn verification_receipt_encodable(v: VerificationReceipt) -> bool:
    if not verification_receipt_consistent(v):
        return false
    if not receipt_text_ascii(v.stage):
        return false
    if not receipt_text_ascii(v.backend):
        return false
    if not receipt_text_ascii(v.result_hash):
        return false
    receipt_text_ascii(v.oracle_hash)

fn encode_verification_receipt(v: VerificationReceipt) -> [u8]:
    """An inconsistent verification receipt encodes to an empty buffer. A
    receipt that says Mismatch while reporting zero mismatches reads as a pass
    to anything that only looks at the count, so it must not exist on the
    wire at all."""
    var b: [u8] = []
    if not verification_receipt_encodable(v):
        return b
    b = wire_put_envelope(b, receipt_magic_verification(),
                          RECEIPT_SCHEMA_VERSION)
    b = wire_put_u32(b, v.contract_version)
    b = wire_put_u8(b, execution_mode_to_u8(v.mode))
    b = wire_put_u8(b, verification_policy_to_u8(v.policy))
    b = wire_put_u8(b, verification_outcome_to_u8(v.outcome))
    b = wire_put_u64(b, v.checked_count)
    b = wire_put_u64(b, v.mismatch_count)
    b = entity_ref_put(b, v.first_mismatch)
    b = wire_put_u64(b, v.elapsed_us)
    b = mapping_shard_ref_put(b, v.origins)
    b = receipt_put_text(b, v.stage)
    b = receipt_put_text(b, v.backend)
    b = receipt_put_text(b, v.result_hash)
    receipt_put_text(b, v.oracle_hash)

fn decode_verification_receipt(data: [u8]) -> VerificationReceiptResult:
    if not wire_check_envelope(data, 0, receipt_magic_verification(),
                               RECEIPT_SCHEMA_VERSION):
        return verification_receipt_reject()
    if not wire_has(data, WIRE_ENVELOPE_LEN, VERIFICATION_RECEIPT_HEAD_LEN):
        return verification_receipt_reject()
    var off = WIRE_ENVELOPE_LEN
    val version = wire_get_u32(data, off)
    val raw_mode = wire_get_u8(data, off + 4)
    val raw_policy = wire_get_u8(data, off + 5)
    val raw_outcome = wire_get_u8(data, off + 6)
    if not execution_mode_valid(raw_mode):
        return verification_receipt_reject()
    if not verification_policy_valid(raw_policy):
        return verification_receipt_reject()
    if not verification_outcome_valid(raw_outcome):
        return verification_receipt_reject()
    val checked = wire_get_u64(data, off + 7)
    val mismatched = wire_get_u64(data, off + 15)
    val first = entity_ref_read(data, off + 23)
    val elapsed = wire_get_u64(data, off + 31)
    val origins = mapping_shard_ref_read(data, off + 39)
    off = off + VERIFICATION_RECEIPT_HEAD_LEN

    val n_stage = receipt_read_text_field(data, off)
    if n_stage < 0:
        return verification_receipt_reject()
    val s_stage = receipt_read_text(data, off + 4, n_stage)
    off = off + 4 + n_stage

    val n_backend = receipt_read_text_field(data, off)
    if n_backend < 0:
        return verification_receipt_reject()
    val s_backend = receipt_read_text(data, off + 4, n_backend)
    off = off + 4 + n_backend

    val n_res = receipt_read_text_field(data, off)
    if n_res < 0:
        return verification_receipt_reject()
    val s_res = receipt_read_text(data, off + 4, n_res)
    off = off + 4 + n_res

    val n_ora = receipt_read_text_field(data, off)
    if n_ora < 0:
        return verification_receipt_reject()
    val s_ora = receipt_read_text(data, off + 4, n_ora)
    off = off + 4 + n_ora

    if data.len() != off:
        return verification_receipt_reject()

    val out = VerificationReceipt(
        contract_version: version,
        stage: s_stage,
        backend: s_backend,
        mode: execution_mode_from_u8(raw_mode),
        policy: verification_policy_from_u8(raw_policy),
        outcome: verification_outcome_from_u8(raw_outcome),
        checked_count: checked,
        mismatch_count: mismatched,
        first_mismatch: first,
        result_hash: s_res,
        oracle_hash: s_ora,
        origins: origins,
        elapsed_us: elapsed)
    if not verification_receipt_consistent(out):
        return verification_receipt_reject()
    VerificationReceiptResult(ok: true, value: out)
