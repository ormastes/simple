# ============================================================================
# common/structural/storage_layout/storage_layout_contracts.spl — frozen v1
# logical-record storage vocabulary. This is not the spatial-layout capsule.
# ============================================================================

val STORAGE_LAYOUT_SCHEMA_VERSION: i64 = 1

enum StorageLayoutKind:
    AoS
    SoA
    AoSoA
    Grouped
    Tiled
    Packed
    FactoredIndex
    ExternalFixed

enum StorageConversionPolicy:
    Never
    OnDemand
    Cached
    Pinned

val STORAGE_LAYOUT_KIND_MAX: i64 = 7
val STORAGE_LAYOUT_KIND_COUNT: i64 = 8
val STORAGE_CONVERSION_POLICY_MAX: i64 = 3
val STORAGE_CONVERSION_POLICY_COUNT: i64 = 4

fn storage_layout_kind_to_u8(value: StorageLayoutKind) -> i64:
    match value:
        case StorageLayoutKind.AoS: 0
        case StorageLayoutKind.SoA: 1
        case StorageLayoutKind.AoSoA: 2
        case StorageLayoutKind.Grouped: 3
        case StorageLayoutKind.Tiled: 4
        case StorageLayoutKind.Packed: 5
        case StorageLayoutKind.FactoredIndex: 6
        case StorageLayoutKind.ExternalFixed: 7

fn storage_layout_kind_valid(value: i64) -> bool:
    value >= 0 and value <= STORAGE_LAYOUT_KIND_MAX

fn storage_conversion_policy_to_u8(value: StorageConversionPolicy) -> i64:
    match value:
        case StorageConversionPolicy.Never: 0
        case StorageConversionPolicy.OnDemand: 1
        case StorageConversionPolicy.Cached: 2
        case StorageConversionPolicy.Pinned: 3

fn storage_conversion_policy_valid(value: i64) -> bool:
    value >= 0 and value <= STORAGE_CONVERSION_POLICY_MAX

struct StorageLayoutPlanV1:
    contract_version: i64
    logical_type_id: i64
    layout: StorageLayoutKind
    block_width: i64
    alignment: i64
    abi_pinned: bool
    conversion: StorageConversionPolicy
    policy_hash: text
    decision_reason: text

fn storage_layout_plan_v1(logical_type_id: i64, layout: StorageLayoutKind,
                          block_width: i64, alignment: i64, abi_pinned: bool,
                          conversion: StorageConversionPolicy,
                          policy_hash: text, decision_reason: text) -> StorageLayoutPlanV1:
    StorageLayoutPlanV1(contract_version: STORAGE_LAYOUT_SCHEMA_VERSION,
                        logical_type_id: logical_type_id, layout: layout,
                        block_width: block_width, alignment: alignment,
                        abi_pinned: abi_pinned, conversion: conversion,
                        policy_hash: policy_hash, decision_reason: decision_reason)

fn storage_layout_plan_v1_well_formed(value: StorageLayoutPlanV1) -> bool:
    if value.contract_version != STORAGE_LAYOUT_SCHEMA_VERSION:
        return false
    if value.logical_type_id <= 0 or value.block_width <= 0 or value.alignment <= 0:
        return false
    if value.policy_hash.len() == 0 or value.decision_reason.len() == 0:
        return false
    if value.policy_hash.len() > 128 or value.decision_reason.len() > 64:
        return false
    # Alignment is an addressing contract, so non-power-of-two values are
    # rejected rather than rounded differently by individual backends.
    if (value.alignment & (value.alignment - 1)) != 0:
        return false
    val layout = storage_layout_kind_to_u8(value.layout)
    if layout == 0 or layout == 1 or layout == 7:
        if value.block_width != 1:
            return false
    if layout == 7:
        return value.abi_pinned and storage_conversion_policy_to_u8(value.conversion) == 3
    if value.abi_pinned:
        return layout == 0 and storage_conversion_policy_to_u8(value.conversion) == 0
    true
