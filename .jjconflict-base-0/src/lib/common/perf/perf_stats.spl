#![allow(primitive_api)]
# perf_stats — honest p50/p95 statistics over independent repeated trials.
#
# Gap this fills (render_perf_redesign_plan_2026-08-06.md §10, second promotion
# criterion "p95/RSS inside budget"): every SIMD kernel spec measured a SINGLE
# t1-t0 delta over N iterations inside one timed block. That is one sample, not
# a distribution — it cannot produce a real p50 or p95. This module takes an
# array of independently-measured trial durations (each trial itself timed by
# the caller in its own t0..t1 block, never nested inside another timed block)
# and computes p50/p95 by sort + index — no fabricated formula, no smoothing.
#
# RSS/memory note (same §10 gate, "RSS" half): this repo has NO real
# process-RSS primitive (grepped rt_*rss*/rt_*memory*/getrusage — none exist).
# The nearest thing, mimalloc_stats._g_allocation_count, is a MODELED counter
# in a pure-Simple mimalloc compat shim that the tree-walk interpreter's array
# literals do not route through — using it as an RSS proxy would misattribute
# a number that was never touched. Callers must report memory as ABSENT, not
# fabricate a proxy that isn't wired to the code under measurement.

pub fn perf_stats_sort_i64(values: [i64]) -> [i64]:
    """Ascending insertion sort. No fabricated ordering — a genuine sort."""
    var out: [i64] = values
    var i: i64 = 1
    val n = out.len()
    while i < n:
        val key = out[i.to_i32()]
        var j = i - 1
        while j >= 0 and out[j.to_i32()] > key:
            out[(j + 1).to_i32()] = out[j.to_i32()]
            j = j - 1
        out[(j + 1).to_i32()] = key
        i = i + 1
    out

#[allow(primitive_api)]
pub fn perf_stats_percentile(sorted_values: [i64], p: i64) -> i64:
    """Nearest-rank percentile over an already-ascending-sorted array.
    p is 0..100. index = ceil(p/100 * n) - 1, clamped into range."""
    val n = sorted_values.len()
    if n == 0:
        return -1
    if n == 1:
        return sorted_values[0]
    var idx = (p * n + 99) / 100 - 1
    if idx < 0:
        idx = 0
    if idx >= n:
        idx = n - 1
    sorted_values[idx.to_i32()]

#[allow(primitive_api)]
pub fn perf_stats_p50(trial_values: [i64]) -> i64:
    perf_stats_percentile(perf_stats_sort_i64(trial_values), 50)

#[allow(primitive_api)]
pub fn perf_stats_p95(trial_values: [i64]) -> i64:
    perf_stats_percentile(perf_stats_sort_i64(trial_values), 95)

# @tag(scalar_p50=baseline_us, candidate_p50=candidate_us)
pub fn perf_stats_pct_win(scalar_p50: i64, candidate_p50: i64) -> i64:
    """Percent win of candidate over scalar at p50, integer percent
    (candidate faster => positive). Matches plan §10 "≥10% p50 win" language."""
    if scalar_p50 <= 0:
        return 0
    ((scalar_p50 - candidate_p50) * 100) / scalar_p50
