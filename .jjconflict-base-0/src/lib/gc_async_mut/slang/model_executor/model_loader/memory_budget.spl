# @gc — module uses GC runtime
#
# Admission control for model loads.
#
# WHY THIS IS A GATE AND NOT A HINT
# ---------------------------------
# This host is a DGX Spark (GB10): 128 GB of memory UNIFIED between CPU and GPU.
# There is no separate VRAM pool to fall back on, so a model that does not fit
# does not swap or spill — it takes the whole machine down with it, along with
# whatever else was running. During this module's own bring-up a 46 GB model
# loaded alongside a 42 GB compiler build left 23 GB of headroom; a second model
# would have been fatal.
#
# So the fit check runs BEFORE a load is attempted, refuses in typed form, and
# reports the arithmetic it used. A refusal a caller can read is worth more than
# a verdict it has to trust.

use std.io_runtime.{read_file}

# Bytes to leave for the OS, the page cache and whatever else shares this
# machine. Deliberately generous: the cost of being wrong upward is a refused
# load, and the cost of being wrong downward is the host.
fn default_headroom_bytes() -> i64:
    8 * 1024 * 1024 * 1024

struct FitVerdict:
    fits: bool
    model_bytes: i64
    available_bytes: i64
    headroom_bytes: i64
    reason: text

# MemAvailable, not MemFree: free memory excludes reclaimable page cache and so
# under-reports what a load can actually use, which would refuse loads that fit.
fn mem_available_bytes() -> i64:
    val content = read_file("/proc/meminfo")
    for line in content.split("\n"):
        if line.starts_with("MemAvailable:"):
            for part in line.split(" "):
                val t = part.trim()
                if t != "" and t != "MemAvailable:" and t != "kB":
                    return t.to_i64() * 1024
    -1

fn _gib(bytes: i64) -> text:
    (bytes / (1024 * 1024 * 1024)).to_text() + " GiB"

# A model needs its weights plus room for the KV cache and activations.
# `overhead_bytes` is the caller's estimate of that second part; it is not
# guessed here because it depends on context length, which is the caller's
# choice.
fn check_fit(model_bytes: i64, overhead_bytes: i64, headroom_bytes: i64) -> FitVerdict:
    val available = mem_available_bytes()
    val needed = model_bytes + overhead_bytes + headroom_bytes
    if available < 0:
        return FitVerdict(fits: false, model_bytes: model_bytes, available_bytes: -1,
            headroom_bytes: headroom_bytes,
            reason: "could not read MemAvailable from /proc/meminfo; refusing rather than loading blind")
    if needed > available:
        return FitVerdict(fits: false, model_bytes: model_bytes, available_bytes: available,
            headroom_bytes: headroom_bytes,
            reason: "needs " + _gib(needed) + " (" + _gib(model_bytes) + " weights + " + _gib(overhead_bytes) + " runtime + " + _gib(headroom_bytes) + " headroom) but only " + _gib(available) + " is available")
    FitVerdict(fits: true, model_bytes: model_bytes, available_bytes: available,
        headroom_bytes: headroom_bytes, reason: "")

export FitVerdict, default_headroom_bytes, mem_available_bytes, check_fit
