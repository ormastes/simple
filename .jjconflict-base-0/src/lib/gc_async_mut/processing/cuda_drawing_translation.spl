"""Fail-closed CUDA drawing-access translation to Vulkan or DirectX artifacts."""

use std.common.processing.processing_ir.{
    ProcessingIr,
    PROCESSING_IR_OP_FILL_RECT_U32,
    processing_ir_validate
}
use std.common.processing.backend_contract.{
    ProcessingBackendTarget,
    ProcessingBackendArtifact,
    processing_backend_semantic_key,
    processing_backend_artifact_reject
}
use std.gc_async_mut.processing.backend_pipeline.{compile_processing_backend_artifact}

fn _processing_directx_fill_rect_hlsl() -> text:
    "RWStructuredBuffer<uint> output : register(u0);\n" +
    "cbuffer DrawParams : register(b0) {\n" +
    "    uint canvas_width; uint canvas_height; uint stride; uint rect_x;\n" +
    "    uint rect_y; uint rect_width; uint rect_height; uint pixel_value;\n" +
    "};\n" +
    "[numthreads(16, 16, 1)]\n" +
    "void processing_fill_rect_u32(uint3 tid : SV_DispatchThreadID) {\n" +
    "    uint px = tid.x; uint py = tid.y;\n" +
    "    if (px >= canvas_width || py >= canvas_height) return;\n" +
    "    bool inside = px >= rect_x && px < rect_x + rect_width &&\n" +
    "                  py >= rect_y && py < rect_y + rect_height;\n" +
    "    output[py * stride + px] = inside ? pixel_value : 0u;\n" +
    "}\n"

fn translate_cuda_drawing_access(ir: ProcessingIr,
                                 target: ProcessingBackendTarget) -> ProcessingBackendArtifact:
    val validation = processing_ir_validate(ir)
    if not validation.valid:
        return processing_backend_artifact_reject(ir, target, validation.reason)
    if ir.op != PROCESSING_IR_OP_FILL_RECT_U32:
        return processing_backend_artifact_reject(
            ir, target, "unsupported-cuda-drawing-op")
    if target == ProcessingBackendTarget.VulkanSpirv:
        return compile_processing_backend_artifact(ir, target)
    if target == ProcessingBackendTarget.DirectXHlsl:
        return ProcessingBackendArtifact(
            target: target,
            format: "hlsl",
            entry_point: "processing_fill_rect_u32",
            source: _processing_directx_fill_rect_hlsl(),
            binary: [],
            semantic_key: processing_backend_semantic_key(ir, target),
            valid: true,
            reason: "ok")
    processing_backend_artifact_reject(
        ir, target, "unsupported-cuda-drawing-translation-target")

export translate_cuda_drawing_access
