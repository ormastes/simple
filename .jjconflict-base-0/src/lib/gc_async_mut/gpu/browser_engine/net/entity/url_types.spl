"""
# URL Types

Entity types for URL and Origin — pure value types with no externs.
"""

use std.gc_async_mut.http_client.types.{parse_url, url_default_port}
use std.common.base_encoding.utilities.{base_encoding_text_to_bytes as text_to_bytes}
use std.string_core.{char_from_code}

fn _request_target_is_hex(byte: i64) -> bool:
    (byte >= 48 and byte <= 57) or
        (byte >= 65 and byte <= 70) or
        (byte >= 97 and byte <= 102)

fn _request_target_hex(byte: i64) -> text:
    val digits = "0123456789ABCDEF"
    digits.slice((byte >> 4) & 15, ((byte >> 4) & 15) + 1) +
        digits.slice(byte & 15, (byte & 15) + 1)

fn _request_target_byte_allowed(byte: i64, query: bool) -> bool:
    val alpha = (byte >= 65 and byte <= 90) or
        (byte >= 97 and byte <= 122)
    val digit = byte >= 48 and byte <= 57
    val unreserved = alpha or digit or byte == 45 or byte == 46 or
        byte == 95 or byte == 126
    val sub_delimiter = byte == 33 or byte == 36 or byte == 38 or
        byte == 39 or byte == 40 or byte == 41 or byte == 42 or
        byte == 43 or byte == 44 or byte == 59 or byte == 61
    unreserved or sub_delimiter or byte == 47 or byte == 58 or
        byte == 64 or (query and byte == 63)

fn _request_target_component(value: text, query: bool) -> text:
    val bytes = text_to_bytes(value)
    var parts: [text] = []
    var index = 0
    while index < bytes.len():
        val byte = bytes[index] as i64
        if (
            byte == 37 and index + 2 < bytes.len() and
            _request_target_is_hex(bytes[index + 1] as i64) and
            _request_target_is_hex(bytes[index + 2] as i64)
        ):
            parts.push("%")
            parts.push(char_from_code(bytes[index + 1] as i64))
            parts.push(char_from_code(bytes[index + 2] as i64))
            index = index + 3
        elif _request_target_byte_allowed(byte, query):
            parts.push(char_from_code(byte))
            index = index + 1
        else:
            parts.push("%" + _request_target_hex(byte))
            index = index + 1
    parts.join("")

pub class Url:
    """A parsed URL with scheme, host, port, path, query, and fragment.

    `opaque` marks URLs parsed without an authority (`data:`, `about:`,
    `javascript:`, `mailto:`); those have an empty `host` and must never be
    treated as same-origin with a network URL.
    """
    scheme: text
    host: text
    port: i64
    path: text
    query: text
    fragment: text
    opaque: bool

    static fn create(scheme: text, host: text, port: i64, path: text) -> Url:
        Url(scheme: scheme, host: host, port: port, path: path, query: "", fragment: "", opaque: false)

    static fn parse(raw: text) -> Option<Url>:
        """Parse an absolute URL. `None` when `raw` is not a parseable URL.

        This never falls back to a guessed `http` scheme or an empty host, so
        two unparseable inputs are no longer mutually same-origin.
        """
        val parsed = parse_url(raw)
        if not parsed.?:
            return None
        val p = parsed!
        Some(Url(
            scheme: p.scheme,
            host: p.host,
            port: p.port,
            path: p.path,
            query: p.query,
            fragment: p.fragment,
            opaque: p.opaque
        ))

    static fn opaque_invalid(raw: text) -> Url:
        """The fail-closed stand-in for an unparseable URL.

        Empty scheme and host, so it is same-origin with nothing and cannot be
        confused for a real site. Use only where the caller has no failure
        channel; prefer `Url.parse` and propagate the `None`.
        """
        Url(scheme: "", host: "", port: 0, path: raw, query: "", fragment: "", opaque: true)

    static fn parse_or_opaque(raw: text) -> Url:
        """`Url.parse`, falling back to `Url.opaque_invalid` instead of a
        guessed `http` origin."""
        val parsed = Url.parse(raw)
        if parsed.?:
            return parsed!
        Url.opaque_invalid(raw)

    fn valid() -> bool:
        """False for the fail-closed stand-in produced by `parse_or_opaque`."""
        self.scheme != ""

    fn authority() -> text:
        var out = self.host
        if self.port > 0 and self.port != url_default_port(self.scheme):
            out = out + ":{self.port}"
        out

    fn request_target() -> text:
        """Return the ASCII origin-form target shared by HTTP transports."""
        val path = if self.path.len() > 0: self.path else: "/"
        var target = _request_target_component(path, false)
        if self.query.len() > 0:
            target = target + "?" + _request_target_component(
                self.query, true
            )
        target

    fn to_text() -> text:
        if self.opaque:
            var opq = "{self.scheme}:{self.path}"
            if self.query != "":
                opq = opq + "?{self.query}"
            if self.fragment != "":
                opq = opq + "#{self.fragment}"
            return opq
        var out = "{self.scheme}://{self.authority()}"
        out = out + self.path
        if self.query != "":
            out = out + "?{self.query}"
        if self.fragment != "":
            out = out + "#{self.fragment}"
        out

pub class Origin:
    """The security origin of a URL: scheme + host + port."""
    scheme: text
    host: text
    port: i64

    static fn from_url(url: Url) -> Origin:
        Origin(scheme: url.scheme.to_lower(), host: url.host.to_lower(), port: url.port)

    fn to_text() -> text:
        var out = "{self.scheme}://{self.host}"
        if self.port > 0 and self.port != url_default_port(self.scheme):
            out = out + ":{self.port}"
        out
