"""
# JS DOM Bridge

Bridges the JS interpreter to the browser engine BeDomNode tree.
Provides document.getElementById, textContent, style, classList,
and addEventListener integration from JS to the canonical DOM.
"""

#![allow(REQC001)]
#![allow(REQC004)]
#![allow(unnamed_duplicate_typed_args)]

use std.gc_async_mut.gpu.browser_engine.dom.{
    BeDomNode, be_dom_query_selector
}
use std.gc_async_mut.gpu.browser_engine.dom_identity_index.{
    DomNodeRoute, DomIdentityIndex
}
use std.gc_async_mut.gpu.browser_engine.dom_accessors.{be_dom_node_for_route}
# =========================================================================
# Event listener registration
# =========================================================================

pub class JsDomListener:
    """A registered DOM event listener."""
    route: DomNodeRoute
    event_type: text
    callback_id: i64

# =========================================================================
# DOM Bridge
# =========================================================================

pub class JsDomBridge:
    """Bridges JS interpreter calls to BeDomNode mutations.

    Holds a mutable DOM root, tracks dirty state, and manages
    event listener registrations for JS event dispatch.
    """
    _root: BeDomNode
    _identity_index: DomIdentityIndex
    _dirty: bool
    _listeners: [JsDomListener]

    static fn new(root: BeDomNode, index: DomIdentityIndex) -> JsDomBridge:
        """Create one bridge from the session-published DOM/index pair."""
        JsDomBridge(
            _root: root,
            _identity_index: index,
            _dirty: false,
            _listeners: []
        )

    me root() -> BeDomNode:
        """Return the current DOM root."""
        self._root

    me dirty() -> bool:
        """True if JS has mutated the DOM since last clear_dirty()."""
        self._dirty

    me clear_dirty():
        """Reset the dirty flag."""
        self._dirty = false

    me route_for_author_id(author_id: text) -> DomNodeRoute?:
        """Resolve document.getElementById into a stable page-object route."""
        self._identity_index.route_for_author_id(author_id)

    me author_id_for_route(route: DomNodeRoute) -> text?:
        """Project an author ID for page code without authorizing by text."""
        self._identity_index.author_id_for_route(route)

    me node_for_route(route: DomNodeRoute) -> BeDomNode?:
        """Resolve only a live route from this bridge's session generation."""
        be_dom_node_for_route(self._root, self._identity_index, route)

    me find_by_id(author_id: text) -> DomNodeRoute?:
        """Resolve document.getElementById to a stable page-object route."""
        self.route_for_author_id(author_id)

    me query_selector(selector: text) -> DomNodeRoute?:
        """Resolve the first selector match to a stable page-object route."""
        val node = match be_dom_query_selector(self._root, selector):
            Some(value): value
            nil: return nil
        val route = DomNodeRoute(
            generation: self._identity_index.generation,
            node_id: node.node_id
        )
        if self._identity_index.contains_route(route):
            return Some(route)
        nil

    me set_text_content(route: DomNodeRoute, value: text) -> bool:
        """Stage text content for a generation-qualified page object."""
        val found = self.node_for_route(route)
        if found != nil:
            self._dirty = true
            return true
        false

    me set_style_prop(
        route: DomNodeRoute, prop: text, value: text
    ) -> bool:
        """Stage a CSS property for a generation-qualified page object."""
        val found = self.node_for_route(route)
        if found != nil:
            self._dirty = true
            return true
        false

    me add_class(route: DomNodeRoute, cls: text) -> bool:
        """Stage a class addition for a generation-qualified page object."""
        val found = self.node_for_route(route)
        if found != nil:
            self._dirty = true
            return true
        false

    me remove_class(route: DomNodeRoute, cls: text) -> bool:
        """Stage a class removal for a generation-qualified page object."""
        val found = self.node_for_route(route)
        if found != nil:
            self._dirty = true
            return true
        false

    me add_event_listener(
        route: DomNodeRoute, event_type: text, callback_id: i64
    ) -> bool:
        """Register a JS callback on a live generation-qualified route."""
        if self.node_for_route(route) == nil:
            return false
        self._listeners.push(JsDomListener(
            route: route,
            event_type: event_type,
            callback_id: callback_id
        ))
        true

    me remove_event_listener(
        route: DomNodeRoute, event_type: text, callback_id: i64
    ) -> bool:
        """Remove a listener only through its original document route."""
        if self.node_for_route(route) == nil:
            return false
        var new_list: [JsDomListener] = []
        var removed = false
        var i = 0
        while i < self._listeners.len():
            val l = self._listeners[i]
            if l.route.generation.value == route.generation.value and
               l.route.node_id == route.node_id and
               l.event_type == event_type and l.callback_id == callback_id:
                removed = true
            else:
                new_list.push(l)
            i = i + 1
        self._listeners = new_list
        removed

    me get_listeners(route: DomNodeRoute, event_type: text) -> [i64]:
        """Return callbacks in registration order for a live typed route."""
        if self.node_for_route(route) == nil:
            return []
        var result: [i64] = []
        var i = 0
        while i < self._listeners.len():
            val l = self._listeners[i]
            if l.route.generation.value == route.generation.value and
               l.route.node_id == route.node_id and l.event_type == event_type:
                result.push(l.callback_id)
            i = i + 1
        result

    me listener_count() -> i32:
        """Return total number of registered listeners."""
        self._listeners.len()
