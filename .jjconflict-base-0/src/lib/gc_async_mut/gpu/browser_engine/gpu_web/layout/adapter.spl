# Browser CPU-oracle adapter for the structural layout framework.

use std.common.hash.djb2.{djb2_hash_text}
use std.common.structural.invalidation.contracts.{DIRTY_LAYOUT, LayoutDependency, layout_dependency}
use std.common.structural.layout.{
    LayoutExecutionProfile,
    LayoutBoxConstraints,
    LayoutFlexConstraints,
    LayoutGridConstraints,
    LayoutOverflowPolicy,
    LayoutPositionConstraints,
    LayoutInputSnapshot,
    LayoutFragment,
    LayoutLength,
    LayoutLineBox,
    LayoutNodeInput,
    LayoutNodeSemantics,
    LayoutOverflow,
    LAYOUT_GPU_ADMISSION_CONTENT_HIDDEN,
    LAYOUT_GPU_ADMISSION_INLINE_FLOW,
    LAYOUT_GPU_ADMISSION_LEGACY_WIDGET_BOX,
    LAYOUT_GPU_ADMISSION_POSITIONED,
    LAYOUT_GPU_ADMISSION_REPLACED,
    LAYOUT_GPU_ADMISSION_SCROLLING,
    LAYOUT_GPU_ADMISSION_TEXT,
    LAYOUT_GPU_ADMISSION_UNSUPPORTED_TRACK,
    LAYOUT_GPU_ADMISSION_VIEWPORT_FILL,
    LAYOUT_OVERFLOW_AUTO,
    LAYOUT_OVERFLOW_HIDDEN,
    LAYOUT_OVERFLOW_SCROLL,
    LAYOUT_OVERFLOW_VISIBLE,
    LAYOUT_POSITION_ABSOLUTE,
    LAYOUT_POSITION_RELATIVE,
    LAYOUT_POSITION_STATIC,
    LAYOUT_POSITION_STICKY,
    layout_edges,
    layout_fragment,
    layout_length_auto,
    layout_length_percent,
    layout_length_px,
    layout_length_viewport_height,
    layout_box,
    layout_line_box,
    layout_oracle_artifacts,
    layout_overflow,
    layout_input_with_text,
    layout_node,
    layout_profile_supported
}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    HNode, HtmlChildIndex, LayoutResult, SimpleWebLayoutDrawIrResult,
    SimpleWebRetainedLayoutPreparation, Style
}
use std.gc_async_mut.gpu.browser_engine.gpu_web.layout.contracts.*

struct WebLayoutAdapterResult:
    snapshot: WebLayoutSnapshot
    fault: text

struct _WebLayoutTrackAppend:
    tracks: [i64]
    start: i64
    count: i64
    supported: bool

fn _web_layout_hash(parts: [text]) -> text:
    var value = "web-layout-v1"
    for part in parts:
        value = value + "|" + part
    djb2_hash_text(value).to_text()

fn _web_layout_i32s(values: [i32]) -> [i64]:
    var result: [i64] = []
    for value in values:
        result.push(value as i64)
    result

fn _web_layout_bool(value: bool) -> text:
    if value: "1" else: "0"

fn _web_layout_size(value: i32) -> LayoutLength:
    if value > 0: return layout_length_px(value as i64)
    if value < 0: return layout_length_percent((0 - value) as i64)
    layout_length_auto()

fn _web_layout_horizontal_margin(value: i32) -> LayoutLength:
    if value < 0: return layout_length_percent((0 - value) as i64)
    layout_length_px(value as i64)

fn _web_layout_vertical_margin(value: i32) -> LayoutLength:
    if value <= -1000: return layout_length_viewport_height(((0 - value) - 1000) as i64)
    layout_length_px(if value < 0: 0 else: value as i64)

fn _web_layout_position_offset(value: i32, available: bool) -> LayoutLength:
    if available: layout_length_px(value as i64) else: layout_length_auto()

fn _web_layout_position_kind(relative: bool, absolute: bool, sticky: bool) -> text:
    if absolute: return LAYOUT_POSITION_ABSOLUTE
    if sticky: return LAYOUT_POSITION_STICKY
    if relative: return LAYOUT_POSITION_RELATIVE
    LAYOUT_POSITION_STATIC

fn _web_layout_overflow_policy(hidden: bool, auto_y: bool, scroll_y: bool) -> LayoutOverflowPolicy:
    if hidden:
        return LayoutOverflowPolicy(x: LAYOUT_OVERFLOW_HIDDEN, y: LAYOUT_OVERFLOW_HIDDEN)
    LayoutOverflowPolicy(
        x: LAYOUT_OVERFLOW_VISIBLE,
        y: if scroll_y: LAYOUT_OVERFLOW_SCROLL elif auto_y: LAYOUT_OVERFLOW_AUTO else: LAYOUT_OVERFLOW_VISIBLE
    )

fn _web_layout_append_tracks(existing: [i64], raw: text) -> _WebLayoutTrackAppend:
    val start = existing.len()
    var tracks = existing
    if raw.trim() == "":
        return _WebLayoutTrackAppend(tracks: tracks, start: start, count: 0, supported: true)
    for part in raw.split(" "):
        val token = part.trim()
        if token != "":
            val size = token.to_i64()
            if size <= 0:
                return _WebLayoutTrackAppend(tracks: existing, start: start, count: 0, supported: false)
            tracks.push(size)
    _WebLayoutTrackAppend(tracks: tracks, start: start, count: tracks.len() - start, supported: true)

fn _web_layout_grid_start(raw: text) -> i64:
    val value = raw.trim()
    if value == "": return -1
    val parts = value.split("/")
    val line = parts[0].trim().to_i64()
    if line > 0: line - 1 else: -1

fn _web_layout_grid_span(raw: text) -> i64:
    val parts = raw.trim().split("/")
    if parts.len() < 2: return 1
    val start = parts[0].trim().to_i64()
    val tail = parts[1].trim()
    if tail.starts_with("span "):
        val span = tail.substring(5, tail.len()).trim().to_i64()
        return if span > 0: span else: 1
    val end_line = tail.to_i64()
    if start > 0 and end_line > start: end_line - start else: 1

fn _web_layout_replaced(tag: text) -> bool:
    (tag == "audio" or tag == "button" or tag == "canvas" or tag == "embed" or
        tag == "iframe" or tag == "img" or tag == "input" or tag == "meter" or
        tag == "object" or tag == "progress" or tag == "select" or
        tag == "textarea" or tag == "video")

fn _web_layout_boundary(profile_id: text, parent_id: i64) -> bool:
    (parent_id == 0 or profile_id == "flex" or profile_id == "grid" or
        profile_id == "table" or profile_id == "absolute-sticky" or
        profile_id == "scroll" or profile_id == "replaced")

fn _web_layout_empty_snapshot(
    generation: i64,
    viewport_fingerprint: text,
    execution: LayoutExecutionProfile,
    fixed_point_cap: i64
) -> WebLayoutSnapshot:
    web_layout_snapshot(generation, viewport_fingerprint, [], [], execution, fixed_point_cap)

fn _web_layout_adapt_state(
    nodes: [HNode], styles: [Style], child_index: HtmlChildIndex,
    viewport_width: i32, viewport_height: i32, boxes: LayoutResult,
    include_oracle: bool,
    generation: i64,
    execution: LayoutExecutionProfile,
    fixed_point_cap: i64
) -> WebLayoutAdapterResult:
    val viewport = viewport_width.to_text() + "x" + viewport_height.to_text()
    val has_boxes = (
        nodes.len() == boxes.bx.len() and nodes.len() == boxes.by.len() and
        nodes.len() == boxes.bw.len() and nodes.len() == boxes.bh.len() and
        nodes.len() == boxes.wrap_starts.len() and
        nodes.len() == boxes.wrap_ends.len()
    )
    if nodes.len() != styles.len() or (include_oracle and not has_boxes):
        return WebLayoutAdapterResult(
            snapshot: _web_layout_empty_snapshot(generation, viewport, execution, fixed_point_cap),
            fault: "browser-oracle-shape-mismatch"
        )

    var adapted_nodes: [WebLayoutNodeSnapshot] = []
    var dependencies: [LayoutDependency] = []
    var grid_tracks: [i64] = []
    var oracle_boxes: [LayoutBox] = []
    var oracle_fragments: [LayoutFragment] = []
    var oracle_line_boxes: [LayoutLineBox] = []
    var oracle_overflows: [LayoutOverflow] = []
    var right_extents: [i64] = []
    var bottom_extents: [i64] = []
    var extent_index: i64 = 0
    while has_boxes and extent_index < nodes.len():
        right_extents.push(
            (boxes.bx[extent_index] as i64) + (boxes.bw[extent_index] as i64)
        )
        bottom_extents.push(
            (boxes.by[extent_index] as i64) + (boxes.bh[extent_index] as i64)
        )
        extent_index = extent_index + 1
    extent_index = nodes.len() - 1
    while has_boxes and extent_index >= 0:
        val parent = nodes[extent_index].parent as i64
        val clips = (styles[extent_index].overflow_hidden or
            styles[extent_index].overflow_auto_y or
            styles[extent_index].overflow_scroll_y)
        if parent >= 0 and not clips:
            if right_extents[extent_index] > right_extents[parent]:
                right_extents[parent] = right_extents[extent_index]
            if bottom_extents[extent_index] > bottom_extents[parent]:
                bottom_extents[parent] = bottom_extents[extent_index]
        extent_index = extent_index - 1
    var index: i64 = 0
    while index < nodes.len():
        val node = nodes[index]
        val style = styles[index]
        val admission = web_layout_admit_profile(
            node.tag,
            style.display,
            style.position_absolute,
            style.position_sticky,
            style.overflow_auto_y,
            style.overflow_scroll_y
        )
        if not admission.supported:
            return WebLayoutAdapterResult(
                snapshot: _web_layout_empty_snapshot(generation, viewport, execution, fixed_point_cap),
                fault: admission.reason
            )

        val id = index + 1
        val parent_id = if node.parent < 0: 0 else: node.parent + 1
        val oracle_box = if has_boxes:
            layout_box(
                id, boxes.bx[index] as i64, boxes.by[index] as i64,
                boxes.bw[index] as i64, boxes.bh[index] as i64
            )
        else:
            layout_box(id, 0, 0, 0, 0)
        if has_boxes:
            oracle_boxes.push(oracle_box)
        if include_oracle:
            oracle_fragments.push(layout_fragment(id, id, oracle_box, "principal", 0))
        val starts = if has_boxes: boxes.wrap_starts[index] else: []
        val ends = if has_boxes: boxes.wrap_ends[index] else: []
        if include_oracle and starts.len() != ends.len():
            return WebLayoutAdapterResult(
                snapshot: _web_layout_empty_snapshot(generation, viewport, execution, fixed_point_cap),
                fault: "browser-oracle-line-shape-mismatch"
            )
        var line_index: i64 = 0
        while include_oracle and line_index < starts.len():
            val start = starts[line_index] as i64
            val endv = ends[line_index] as i64
            if (start < 0 or endv < start or
                endv > style.resolved_font_advances.len() or
                style.resolved_font_line_height <= 0):
                return WebLayoutAdapterResult(
                    snapshot: _web_layout_empty_snapshot(generation, viewport, execution, fixed_point_cap),
                    fault: "browser-oracle-line-metrics-mismatch"
                )
            var line_width: i64 = 0
            var advance_index = start
            while advance_index < endv:
                line_width = line_width + (style.resolved_font_advances[advance_index] as i64)
                advance_index = advance_index + 1
            val line_geometry = layout_box(
                id,
                oracle_box.x,
                oracle_box.y + line_index * (style.resolved_font_line_height as i64),
                line_width,
                style.resolved_font_line_height as i64
            )
            oracle_line_boxes.push(layout_line_box(id, line_index, line_geometry, start, endv))
            oracle_fragments.push(layout_fragment(id, id, line_geometry, "line", line_index + 1))
            line_index = line_index + 1
        val scroll_width = if has_boxes and right_extents[index] > oracle_box.x:
            right_extents[index] - oracle_box.x
        else:
            oracle_box.width
        val scroll_height = if has_boxes and bottom_extents[index] > oracle_box.y:
            bottom_extents[index] - oracle_box.y
        else:
            oracle_box.height
        if include_oracle:
            oracle_overflows.push(layout_overflow(
                id, oracle_box,
                if scroll_width > oracle_box.width: scroll_width else: oracle_box.width,
                if scroll_height > oracle_box.height: scroll_height else: oracle_box.height
            ))
        val column_tracks = _web_layout_append_tracks(grid_tracks, style.grid_template_columns)
        grid_tracks = column_tracks.tracks
        val row_tracks = _web_layout_append_tracks(grid_tracks, style.grid_template_rows)
        grid_tracks = row_tracks.tracks
        var margin_auto_bits: i64 = 0
        if style.margin_l_auto: margin_auto_bits = margin_auto_bits | 1
        if style.margin_t_auto: margin_auto_bits = margin_auto_bits | 2
        if style.margin_r_auto: margin_auto_bits = margin_auto_bits | 4
        if style.margin_b_auto: margin_auto_bits = margin_auto_bits | 8
        val replaced = _web_layout_replaced(node.tag)
        var admission_flags: i64 = 0
        if node.tag == "#text": admission_flags = admission_flags | LAYOUT_GPU_ADMISSION_TEXT
        if replaced: admission_flags = admission_flags | LAYOUT_GPU_ADMISSION_REPLACED
        if node.has_widget_class or node.has_icon_image_class:
            admission_flags = admission_flags | LAYOUT_GPU_ADMISSION_LEGACY_WIDGET_BOX
        if style.flex_fill or style.min_height_vh or node.has_widget_panel_class:
            admission_flags = admission_flags | LAYOUT_GPU_ADMISSION_VIEWPORT_FILL
        if style.position_relative or style.position_sticky:
            admission_flags = admission_flags | LAYOUT_GPU_ADMISSION_POSITIONED
        if style.content_visibility_hidden:
            admission_flags = admission_flags | LAYOUT_GPU_ADMISSION_CONTENT_HIDDEN
        if (style.display != "block" and style.display != "list-item" and
            style.display != "flex" and style.display != "grid"):
            admission_flags = admission_flags | LAYOUT_GPU_ADMISSION_INLINE_FLOW
        if (style.display == "grid" and
            (not column_tracks.supported or column_tracks.count == 0 or not row_tracks.supported)):
            admission_flags = admission_flags | LAYOUT_GPU_ADMISSION_UNSUPPORTED_TRACK
        val first_child = child_index.first_child[index]
        val next_sibling = child_index.next_sibling[index]
        val semantics = LayoutNodeSemantics(
            first_child_id: if first_child < 0: 0 else: (first_child as i64) + 1,
            next_sibling_id: if next_sibling < 0: 0 else: (next_sibling as i64) + 1,
            child_count: child_index.child_count[index] as i64,
            node_kind: if node.tag == "#root": "root" elif node.tag == "#text": "text" elif replaced: "replaced" else: "normal",
            display: style.display,
            box: LayoutBoxConstraints(
                width: _web_layout_size(style.width_px),
                height: _web_layout_size(style.height_px),
                min_width_px: style.min_width_px as i64,
                max_width_px: style.max_width_px as i64,
                min_height_px: style.min_height_px as i64,
                max_height_px: style.max_height_px as i64,
                border_box: style.border_box,
                padding: layout_edges(style.pad_l as i64, style.pad_t as i64, style.pad_r as i64, style.pad_b as i64),
                border: layout_edges(style.border_l as i64, style.border_t as i64, style.border_r as i64, style.border_b as i64),
                margin_left: _web_layout_horizontal_margin(style.margin_l),
                margin_top: _web_layout_vertical_margin(style.margin_t),
                margin_right: _web_layout_horizontal_margin(style.margin_r),
                margin_bottom: _web_layout_vertical_margin(style.margin_b),
                margin_auto_bits: margin_auto_bits,
                gap_px: style.gap_px as i64,
                row_gap_px: style.row_gap_px as i64,
                column_gap_px: style.column_gap_px as i64
            ),
            flex: LayoutFlexConstraints(
                direction: style.flex_direction,
                wrap: style.flex_wrap,
                justify_content: style.justify_content,
                align_items: style.align_items,
                align_self: style.align_self,
                align_content: style.align_content,
                grow: style.flex_grow as i64,
                shrink: style.flex_shrink as i64,
                basis: if style.flex_basis_px > 0: layout_length_px(style.flex_basis_px as i64) else: layout_length_auto(),
                order: style.order as i64,
                direction_rtl: style.direction_rtl
            ),
            grid: LayoutGridConstraints(
                column_track_start: column_tracks.start,
                column_track_count: column_tracks.count,
                row_track_start: row_tracks.start,
                row_track_count: row_tracks.count,
                column_start: _web_layout_grid_start(style.grid_column),
                column_span: _web_layout_grid_span(style.grid_column),
                row_start: _web_layout_grid_start(style.grid_row),
                row_span: _web_layout_grid_span(style.grid_row),
                align_items_authored: style.align_items_authored
            ),
            position: LayoutPositionConstraints(
                kind: _web_layout_position_kind(
                    style.position_relative,
                    style.position_absolute,
                    style.position_sticky
                ),
                left: _web_layout_position_offset(
                    style.left_px, style.position_absolute or style.position_relative or style.position_sticky
                ),
                top: _web_layout_position_offset(
                    style.top_px, style.position_absolute or style.position_relative or style.position_sticky
                ),
                right: _web_layout_position_offset(style.right_px, style.right_px >= 0),
                bottom: _web_layout_position_offset(style.bottom_px, style.bottom_px >= 0)
            ),
            overflow: _web_layout_overflow_policy(
                style.overflow_hidden,
                style.overflow_auto_y,
                style.overflow_scroll_y
            ),
            gpu_admission_flags: admission_flags
        )
        val fingerprint = web_layout_style_fingerprint(
            _web_layout_hash([style.fg.to_text(), style.font_family, style.font_size.to_text()]),
            _web_layout_hash([style.bg.to_text(), style.border_w.to_text(), style.border_color.to_text()]),
            _web_layout_hash([style.opacity_pct.to_text(), style.will_change]),
            _web_layout_hash([style.font_family, style.font_size.to_text(), style.resolved_font_identity]),
            _web_layout_hash([style.width_px.to_text(), style.height_px.to_text(), style.display]),
            _web_layout_hash([
                style.display,
                _web_layout_bool(style.position_relative),
                _web_layout_bool(style.position_absolute),
                _web_layout_bool(style.position_sticky),
                style.left_px.to_text(), style.top_px.to_text(),
                style.right_px.to_text(), style.bottom_px.to_text()
            ]),
            _web_layout_hash([
                admission.profile_id,
                _web_layout_bool(style.overflow_hidden),
                _web_layout_bool(style.overflow_auto_y),
                _web_layout_bool(style.overflow_scroll_y)
            ]),
            _web_layout_hash([
                style.width_px.to_text(), style.height_px.to_text(),
                style.min_width_px.to_text(), style.max_width_px.to_text(),
                style.min_height_px.to_text(), style.max_height_px.to_text(),
                style.margin_l.to_text(), style.margin_t.to_text(),
                style.margin_r.to_text(), style.margin_b.to_text(),
                style.pad_l.to_text(), style.pad_t.to_text(),
                style.pad_r.to_text(), style.pad_b.to_text(),
                style.gap_px.to_text(), style.row_gap_px.to_text(),
                style.column_gap_px.to_text()
            ])
        )
        adapted_nodes.push(WebLayoutNodeSnapshot(
            id: id,
            arena_index: index,
            dom_route_id: index,
            parent_id: parent_id,
            tag: node.tag,
            profile_id: admission.profile_id,
            formatting_boundary: _web_layout_boundary(admission.profile_id, parent_id),
            layout_contained: false,
            style: fingerprint,
            text_content: if style.white_space_nowrap: node.text_data else: node.text_trimmed,
            font_family: style.font_family,
            font_size: style.font_size as i64,
            language: "",
            text_metrics: WebLayoutResolvedTextMetrics(
                available: node.tag != "#text" or style.resolved_font_width >= 0,
                font_identity: style.resolved_font_identity,
                advances: _web_layout_i32s(style.resolved_font_advances),
                width: style.resolved_font_width as i64,
                line_height: style.resolved_font_line_height as i64
            ),
            semantics: semantics,
            estimated_work: (child_index.child_count[index] as i64) + 1,
            text_measure_required: node.tag == "#text"
        ))
        if parent_id != 0:
            dependencies.push(layout_dependency(parent_id, id, "containing-context", DIRTY_LAYOUT))
        index = index + 1

    WebLayoutAdapterResult(
        snapshot: web_layout_snapshot(
            generation,
            viewport,
            adapted_nodes,
            dependencies,
            execution,
            fixed_point_cap,
            viewport_width as i64,
            viewport_height as i64,
            grid_tracks,
            if include_oracle: oracle_boxes else: [],
            if include_oracle: oracle_fragments else: [],
            if include_oracle: oracle_line_boxes else: [],
            if include_oracle: oracle_overflows else: [],
            if include_oracle: [] else: oracle_boxes,
            if include_oracle: [] else: oracle_fragments,
            if include_oracle: [] else: oracle_line_boxes,
            if include_oracle: [] else: oracle_overflows
        ),
        fault: ""
    )

fn web_layout_adapt_cpu_oracle(
    result: SimpleWebLayoutDrawIrResult,
    generation: i64,
    execution: LayoutExecutionProfile,
    fixed_point_cap: i64
) -> WebLayoutAdapterResult:
    _web_layout_adapt_state(
        result.hit_index.nodes, result.hit_index.styles,
        result.hit_index.child_index, result.hit_index.width,
        result.hit_index.height, result.raw_boxes, true,
        generation, execution, fixed_point_cap
    )

fn web_layout_adapt_prepared(
    prepared: SimpleWebRetainedLayoutPreparation,
    retained: LayoutResult,
    generation: i64,
    execution: LayoutExecutionProfile,
    fixed_point_cap: i64
) -> WebLayoutAdapterResult:
    _web_layout_adapt_state(
        prepared.nodes, prepared.styles, prepared.child_index,
        prepared.width, prepared.height, retained, false,
        generation, execution, fixed_point_cap
    )

fn _web_layout_dirty_bits(frontier: WebLayoutFrontier, id: i64) -> i64:
    for dirty in frontier.dirty_nodes:
        if dirty.id == id:
            return dirty.dirty_bits
    0

fn web_layout_validate_snapshot(snapshot: WebLayoutSnapshot) -> text:
    if snapshot.contract_version != WEB_LAYOUT_CONTRACT_VERSION:
        return "web-layout-contract-version-mismatch"
    var seen: [i64] = []
    for node in snapshot.nodes:
        if node.id <= 0:
            return "web-layout-node-id-mismatch"
        if not layout_profile_supported(node.profile_id):
            return "unsupported-profile:" + node.profile_id
        # ponytail: quadratic duplicate check is enough for v1 fixtures; index if browser-scale evidence requires it.
        for prior_id in seen:
            if prior_id == node.id:
                return "duplicate-web-layout-node-id"
        seen.push(node.id)
    ""

fn web_layout_framework_input(
    snapshot: WebLayoutSnapshot,
    frontier: WebLayoutFrontier
) -> LayoutInputSnapshot:
    var nodes: [LayoutNodeInput] = []
    for node in snapshot.nodes:
        nodes.push(layout_node(
            node.id,
            node.parent_id,
            node.profile_id,
            node.formatting_boundary,
            node.layout_contained,
            _web_layout_dirty_bits(frontier, node.id),
            node.estimated_work,
            node.text_measure_required,
            node.semantics
        ))
    layout_input_with_text(
        nodes,
        snapshot.dependencies,
        frontier.invalidated_ids,
        snapshot.text_requests,
        snapshot.execution,
        snapshot.fixed_point_cap,
        snapshot.viewport_width,
        snapshot.viewport_height,
        snapshot.grid_tracks,
        snapshot.oracle_boxes,
        layout_oracle_artifacts(
            snapshot.oracle_fragments,
            snapshot.oracle_line_boxes,
            snapshot.oracle_overflows
        ),
        snapshot.retained_boxes,
        layout_oracle_artifacts(
            snapshot.retained_fragments,
            snapshot.retained_line_boxes,
            snapshot.retained_overflows
        )
    )

export WebLayoutAdapterResult, web_layout_adapt_cpu_oracle, web_layout_adapt_prepared
export web_layout_validate_snapshot, web_layout_framework_input
