# Incremental parse planner seam for wave-2.
#
# Deliberately returns an explicit contract failure in wave-1.

use std.common.structural.parse.contracts.{ParseError, ParseErrorCode, SourceSpan}
use std.common.structural.parse.parse_types.{ParseDialect, ParseRequest}

class IncrementalParsePlan:
    base_snapshot_id: i64
    stabilized_spans: [SourceSpan]
    reused_segment_slots: [u32]
    reparsed_region_ordinals: [i64]

fn incremental_parse_plan(dialect: ParseDialect, request: ParseRequest) -> Result<IncrementalParsePlan, ParseError>:
    Err(ParseError(
        code: ParseErrorCode.UnsupportedMode,
        message: "incremental_parse_plan is not implemented in wave-1",
        span: nil
    ))
