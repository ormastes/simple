# Compositor Layer — a single node of a layer tree.
#
# A Layer is the compositor's unit of independently-composited content. It
# carries the bounds it occupies in its own coordinate space plus the flags the
# tree walk needs (kind, opacity, draws-content).
#
# Provides: LayerKind, Layer.

use std.skia.entity.geometry.{SkRect}

# What role a layer plays in its tree.
enum LayerKind:
    Root
    Picture
    Scroll
    Effect

class Layer:
    id: i64
    kind: LayerKind
    bounds: SkRect
    opacity: f64
    draws_content: bool

    # The root layer of a tree: fully opaque, drawing, covering `bounds`.
    # `id` is assigned by the tree when the layer is added, so it starts at -1.
    static fn root(bounds: SkRect) -> Layer:
        Layer(id: -1, kind: LayerKind.Root, bounds: bounds,
              opacity: 1.0, draws_content: true)

    # A content layer produced by a paint pass.
    static fn picture(bounds: SkRect) -> Layer:
        Layer(id: -1, kind: LayerKind.Picture, bounds: bounds,
              opacity: 1.0, draws_content: true)

    fn width() -> f64:
        self.bounds.width()

    fn height() -> f64:
        self.bounds.height()

    # A layer contributes to the frame only when it both draws and is visible.
    fn is_drawn() -> bool:
        self.draws_content and self.opacity > 0.0

    fn to_string() -> text:
        "Layer(id: {self.id})"
