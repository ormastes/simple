# Blink form-control state keyed by DOM node id.

struct FormFieldEntry:
    node_id: i64
    value: text
    placeholder: text

class FormState:
    fields: [FormFieldEntry]

fn form_state_empty() -> FormState:
    FormState(fields: [])

fn form_state_with_field(state: FormState, entry: FormFieldEntry) -> FormState:
    var fields: [FormFieldEntry] = []
    var replaced = false
    for current in state.fields:
        if current.node_id == entry.node_id:
            fields.push(entry)
            replaced = true
        else:
            fields.push(current)
    if not replaced:
        fields.push(entry)
    FormState(fields: fields)

fn form_state_set_value(state: FormState, node_id: i64, value: text) -> FormState:
    var placeholder = ""
    for field in state.fields:
        if field.node_id == node_id:
            placeholder = field.placeholder
    form_state_with_field(state, FormFieldEntry(
        node_id: node_id, value: value, placeholder: placeholder
    ))

fn form_state_get_value(state: FormState, node_id: i64) -> text:
    for field in state.fields:
        if field.node_id == node_id:
            return field.value
    ""
fn form_state_get_placeholder(state: FormState, node_id: i64) -> text:
    for field in state.fields:
        if field.node_id == node_id:
            return field.placeholder
    ""
