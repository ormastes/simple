# Blink PaintArtifact — the output of a paint pass.
#
# A paint pass produces a flat list of DisplayItems plus a list of PaintChunks.
# Each chunk covers a half-open run [begin_index, end_index) of that item list
# whose members all draw under the same PaintChunkProperties, so the compositor
# only has to re-evaluate property state once per chunk instead of per item.
#
# Provides: PaintChunkProperties, PaintChunk, PaintArtifact.

use std.common.render_scene.paint_types.{DisplayItem}

# The property-tree state a run of display items is drawn under. `0` is the
# root node of each tree.
pub struct PaintChunkProperties:
    transform_id: i64
    clip_id: i64
    effect_id: i64

impl PaintChunkProperties:
    # The state at the root of every property tree.
    static fn root() -> PaintChunkProperties:
        PaintChunkProperties(transform_id: 0, clip_id: 0, effect_id: 0)

    # Structural equality — the test that decides whether two display items can
    # share a chunk.
    fn equals(other: PaintChunkProperties) -> bool:
        self.transform_id == other.transform_id and
        self.clip_id == other.clip_id and
        self.effect_id == other.effect_id

# A half-open range [begin_index, end_index) into the owning artifact's display
# item list, together with the property state those items draw under.
pub struct PaintChunk:
    begin_index: i64
    end_index: i64
    properties: PaintChunkProperties

impl PaintChunk:
    static fn create(begin_index: i64, end_index: i64,
                     properties: PaintChunkProperties) -> PaintChunk:
        PaintChunk(begin_index: begin_index, end_index: end_index,
                   properties: properties)

    # Number of display items covered by this chunk.
    fn size() -> i64:
        self.end_index - self.begin_index

    # A chunk that covers no display items.
    fn is_empty() -> bool:
        self.begin_index == self.end_index

# The complete result of a paint pass.
pub class PaintArtifact:
    items: [DisplayItem]
    chunks: [PaintChunk]

impl PaintArtifact:
    # An artifact that painted nothing.
    static fn empty() -> PaintArtifact:
        PaintArtifact(items: [], chunks: [])

    static fn create(items: [DisplayItem], chunks: [PaintChunk]) -> PaintArtifact:
        PaintArtifact(items: items, chunks: chunks)

    # Total number of display items across the whole artifact.
    fn item_count() -> i64:
        self.items.len()

    # Number of chunks the items were grouped into.
    fn chunk_count() -> i64:
        self.chunks.len()
