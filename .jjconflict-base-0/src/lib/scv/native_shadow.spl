# SCV dual-write comparison gate (SCV-MIG-24, stabilization stage S4:
# "dual-write — native objects written too, compare every operation").
#
# `scv_dual_write_verify(root, dest)`: after an explicit commit/snapshot,
# (a) shadow-syncs via the existing scv_shadow_sync (MIG-16), then
# (b) INDEPENDENTLY compares primary vs shadow over the same must-replicate
# set — recomputed content-hash equality for immutable object kinds (plus a
# deterministic-hash recompute of the SHADOW bytes for kinds whose id is
# derivable from content), byte agreement for refs/operation heads, field-wise
# comparison for change objects (the one in-place-mutable kind, §14.2), and
# commit parent-DAG agreement (every parent named by a shadow commit exists on
# BOTH sides). Reports counts per kind. The compare runs even when the sync
# fails, so corruption is caught by the independent recompute, not only by the
# sync path.
#
# `scv_dual_write_fsck(dest)`: object-level integrity of the SHADOW itself.
# Honest scope note: scv_fsck(root) is hardwired to the `<root>/.scv` layout
# via scv_repo_dir and additionally validates rebuildable state (parser
# index/lockfile) that the shadow deliberately excludes, so the whole of
# scv_fsck cannot be pointed at a shadow dest. Instead this reuses its
# per-object primitives (scv_expected_object_hash, content-id-of-file) against
# the shadow treated as a repo dir: chunk content id == filename, deterministic
# object hashes recompute, commit parents resolve, change `latest` commits
# resolve, HEAD_OP present.
#
# Verdicts are result RECORDS (multi-line text ending in a PASS/FAIL/ERROR
# line); house last-line semantics belong to the step script (SCV-MIG-24.shs).

use app.io.mod (file_exists, file_read, dir_walk)
use std.scv.core.{scv_repo_dir}
use std.scv.store.{scv_repo_exists, scv_content_id_for_file, scv_object_field}
use std.scv.stabilize.{scv_checkpoint_rel_sources}
use std.scv.shadow.{scv_shadow_sync}
use std.scv.integrity.{scv_expected_object_hash}

# Change objects are compared field by field, never by content hash: the file
# for a ChangeId legitimately evolves in place across snapshots (§14.2).
fn scv_change_compare_fields() -> [text]:
    ["change", "latest", "predecessors", "state", "origin", "created_operation"]

fn scv_dual_write_kind_of(rel: text) -> text:
    if rel == "HEAD_OP" or rel.starts_with("meta/"):
        return "refs"
    for kind in ["operations", "changes", "commits", "trees", "files", "chunks", "conflicts"]:
        if rel.starts_with("objects/{kind}/"):
            return kind
    "other"

fn scv_dual_write_object_id(rel: text) -> text:
    # Same id derivation as integrity's scv_object_id_from_path: the store
    # names object files `<id>.sdn` / `<id>.blob`.
    val parts = rel.split("/")
    val name = parts[parts.len() - 1]
    if name.ends_with(".sdn"):
        name[0:name.len() - 4]
    elif name.ends_with(".blob"):
        name[0:name.len() - 5]
    else:
        name

fn scv_dual_write_compare_change(src_content: text, dst_content: text, rel: text) -> [text]:
    var mismatches: [text] = []
    for field in scv_change_compare_fields():
        val a = scv_object_field(src_content, field)
        val b = scv_object_field(dst_content, field)
        if a != b:
            mismatches.push("change field mismatch: {rel} field={field} primary={a} shadow={b}\n")
    mismatches

fn scv_dual_write_commit_dag_check(root: text, dest: text, dst_content: text, rel: text) -> [text]:
    var mismatches: [text] = []
    val parents = scv_object_field(dst_content, "parents")
    for parent in parents.split(" "):
        if parent.trim() == "":
            continue
        if not file_exists("{dest}/objects/commits/{parent}.sdn"):
            mismatches.push("commit parent missing in shadow: {rel} parent={parent}\n")
        if not file_exists("{scv_repo_dir(root)}/objects/commits/{parent}.sdn"):
            mismatches.push("commit parent missing in primary: {rel} parent={parent}\n")
    mismatches

fn scv_dual_write_verify(root: text, dest: text) -> text:
    if not scv_repo_exists(root):
        return "ERROR — nothing was checked (repository not initialized)\n"
    if dest == "":
        return "ERROR — nothing was checked (dual-write verify requires a shadow dest)\n"
    # (a) Shadow-sync first — the write half of dual-write. Its verdict is
    # recorded, but the independent compare below runs regardless.
    val sync_verdict = scv_shadow_sync(root, dest).split("\n")[0]
    # (b) Independent compare over the must-replicate set.
    val rels = scv_checkpoint_rel_sources(root)
    if rels.len() == 0:
        return "ERROR — nothing was checked (no replication sources)\n"
    var refs = 0
    var operations = 0
    var changes = 0
    var commits = 0
    var trees = 0
    var files = 0
    var chunks = 0
    var conflicts = 0
    var mismatches: [text] = []
    for rel in rels:
        val kind = scv_dual_write_kind_of(rel)
        val src = "{scv_repo_dir(root)}/{rel}"
        val dst = "{dest}/{rel}"
        if not file_exists(dst):
            mismatches.push("missing in shadow: {rel}\n")
            continue
        if kind == "refs":
            refs = refs + 1
            # Tree/head/ref agreement: refs and heads must byte-agree.
            if file_read(src) != file_read(dst):
                mismatches.push("ref disagreement: {rel}\n")
            continue
        if kind == "changes":
            changes = changes + 1
            for m in scv_dual_write_compare_change(file_read(src), file_read(dst), rel):
                mismatches.push(m)
            continue
        # Immutable kinds: recomputed hash equality on both sides.
        val src_sha = scv_content_id_for_file(src)
        val dst_sha = scv_content_id_for_file(dst)
        if src_sha != dst_sha:
            mismatches.push("object hash mismatch: {rel} primary={src_sha} shadow={dst_sha}\n")
        val id = scv_dual_write_object_id(rel)
        if kind == "chunks":
            chunks = chunks + 1
            if dst_sha != id:
                mismatches.push("chunk content id mismatch in shadow: {rel}\n")
            continue
        # Deterministic-hash recompute over the SHADOW bytes where the id is
        # content-derived (files/trees/commits/conflicts, view operations).
        val dst_content = file_read(dst)
        if scv_expected_object_hash(kind, id, dst_content) != id:
            mismatches.push("deterministic hash mismatch in shadow: {rel}\n")
        if kind == "operations":
            operations = operations + 1
        elif kind == "trees":
            trees = trees + 1
        elif kind == "files":
            files = files + 1
        elif kind == "conflicts":
            conflicts = conflicts + 1
        elif kind == "commits":
            commits = commits + 1
            for m in scv_dual_write_commit_dag_check(root, dest, dst_content, rel):
                mismatches.push(m)
    val compared = refs + operations + changes + commits + trees + files + chunks + conflicts
    var report = "dual_write:\n  sync: {sync_verdict}\n"
    report = report + "  compared: refs={refs} operations={operations} changes={changes} commits={commits} trees={trees} files={files} chunks={chunks} conflicts={conflicts}\n"
    report = report + mismatches.join("")
    val sync_ok = sync_verdict.starts_with("PASS")
    if mismatches.len() == 0 and sync_ok:
        return report + "PASS — dual-write verified: {compared} object(s) compared, 0 mismatch(es)\n"
    val sync_note = if sync_ok: "" else: "; sync verdict: {sync_verdict}"
    report + "FAIL — dual-write verified: {compared} object(s) compared, {mismatches.len()} mismatch(es){sync_note}\n"

fn scv_dual_write_fsck(dest: text) -> text:
    if dest == "" or not file_exists(dest):
        return "ERROR — nothing was checked (shadow dest missing: {dest})\n"
    if not file_exists("{dest}/HEAD_OP"):
        return "ERROR — nothing was checked (no HEAD_OP in shadow: {dest})\n"
    var checked = 0
    var errors: [text] = []
    for kind in ["operations", "changes", "commits", "trees", "files", "chunks", "conflicts"]:
        val dir = "{dest}/objects/{kind}"
        if not file_exists(dir):
            continue
        for path in dir_walk(dir):
            checked = checked + 1
            val id = scv_dual_write_object_id(path)
            if kind == "chunks":
                if scv_content_id_for_file(path) != id:
                    errors.push("corrupt shadow chunk: {id}\n")
                continue
            val content = file_read(path)
            if kind == "changes":
                val latest = scv_object_field(content, "latest")
                if latest != "" and not file_exists("{dest}/objects/commits/{latest}.sdn"):
                    errors.push("shadow change latest missing commit: {id} latest={latest}\n")
                continue
            if scv_expected_object_hash(kind, id, content) != id:
                errors.push("shadow object hash mismatch: {kind} {id}\n")
            if kind == "commits":
                for parent in scv_object_field(content, "parents").split(" "):
                    if parent.trim() != "" and not file_exists("{dest}/objects/commits/{parent}.sdn"):
                        errors.push("shadow commit parent missing: {id} parent={parent}\n")
    if checked == 0:
        return "ERROR — nothing was checked (shadow object store is empty: {dest})\n"
    if errors.len() == 0:
        return "PASS — shadow fsck: {checked} object(s) checked, 0 error(s)\n"
    errors.join("") + "FAIL — shadow fsck: {checked} object(s) checked, {errors.len()} error(s)\n"
