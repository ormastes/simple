# codex-impl
# Durable, provider-neutral SCV lifecycle value objects.

struct RevisionAliases:
    jj_change_id: text
    jj_commit_id: text
    git_oid: text
    provider_patchsets: [text]

struct ChangeIdentity:
    change_id: text
    title: text
    intent_digest: text
    owner: text

struct RevisionIdentity:
    revision_id: text
    change_id: text
    tree_id: text
    parent_revision_ids: [text]
    metadata_digest: text
    aliases: RevisionAliases

struct ReviewSession:
    review_id: text
    change_id: text
    base_revision_id: text
    head_revision_id: text
    target_ref: text
    profile: text
    state: text

struct ReviewRun:
    review_run_id: text
    review_id: text
    parent_run_id: text
    reviewer: text
    reviewer_version: text
    role: text
    policy_digest: text
    evidence_bundle_id: text
    verdict: text
    unresolved_question_ids: [text]

struct SourceAnchor:
    path: text
    parser: text
    symbol_id: text
    syntax_node_kind: text
    syntax_node_fingerprint: text
    surrounding_token_hash: text
    semantic_entity_id: text
    fallback_line: i64
    fallback_column: i64

struct Finding:
    finding_id: text
    review_id: text
    revision_id: text
    producer_run_id: text
    rule_id: text
    category: text
    severity: text
    confidence_evidence: text
    source_anchor: SourceAnchor
    fingerprint: text
    message: text
    evidence_refs: [text]
    state: text

struct Approval:
    approval_id: text
    review_id: text
    revision_id: text
    tree_digest: text
    reviewer: text
    authority: text
    policy_digest: text
    evidence_bundle_digest: text
    created_at: text
    state: text

struct GateRun:
    gate_run_id: text
    revision_id: text
    gate_id: text
    policy_digest: text
    tool_digest: text
    environment_digest: text
    verdict: text
    evidence_objects: [text]

struct GateBundle:
    gate_bundle_id: text
    revision_id: text
    gate_run_ids: [text]
    approval_ids: [text]
    complete: bool
    bundle_digest: text
    policy_digest: text

struct RemoteBinding:
    binding_id: text
    entity_type: text
    entity_id: text
    provider_instance: text
    remote_kind: text
    remote_id: text
    remote_revision: text
    authority_policy_id: text
    sync_base_digest: text
    state: text

struct SyncConflict:
    conflict_id: text
    binding_id: text
    field: text
    base_value: text
    local_value: text
    remote_value: text
    policy: text
    state: text

struct Feature:
    feature_id: text
    title: text
    state: text
    owner: text
    goal: text
    acceptance_ids: [text]
    document_paths: [text]
    task_ids: [text]

struct LifecycleRun:
    run_id: text
    feature_id: text
    task_id: text
    change_id: text
    base_revision_id: text
    state: text

struct OperationAudit:
    operation_id: text
    operation_kind: text
    entity_id: text
    actor: text
    authority: text
    policy_digest: text
    input_digest: text
    output_digest: text
    state: text

struct Task:
    task_id: text
    feature_id: text
    title: text
    state: text
    owner: text
    change_ids: [text]

struct Publication:
    publication_id: text
    entity_type: text
    entity_id: text
    provider_instance: text
    remote_id: text
    artifact_digest: text
    state: text

struct ReleaseCandidate:
    candidate_id: text
    version: text
    line_id: text
    source_revision_id: text
    gate_bundle_id: text
    artifact_set_id: text
    review_id: text
    state: text

struct ReleaseLine:
    line_id: text
    product: text
    major: i64
    minor: i64
    source_ref: text
    support_state: text
    support_policy_digest: text
    remote_binding_ids: [text]

struct ReleaseIdentity:
    release_id: text
    version: text
    line_id: text
    source_revision_id: text
    source_tree_hash: text
    git_commit_oid: text
    git_tag_object_oid: text
    gate_bundle_id: text
    artifact_set_id: text
    sbom_ids: [text]
    provenance_ids: [text]
    publication_ids: [text]
    state: text
    immutable: bool

struct LifecycleResult:
    ok: bool
    status: text
    code: text
    message: text
    entity_id: text
    output_version: text

fn lifecycle_ok(status: text, entity_id: text) -> LifecycleResult:
    LifecycleResult(ok: true, status: status, code: "", message: "", entity_id: entity_id, output_version: "devhub/v1")

fn lifecycle_error(code: text, message: text) -> LifecycleResult:
    LifecycleResult(ok: false, status: "rejected", code: code, message: message, entity_id: "", output_version: "devhub/v1")

export RevisionAliases, ChangeIdentity, RevisionIdentity, ReviewSession, ReviewRun, SourceAnchor, Finding, Approval
export GateRun, GateBundle, RemoteBinding, SyncConflict
export Feature, Task, LifecycleRun, OperationAudit, Publication
export ReleaseLine, ReleaseCandidate, ReleaseIdentity, LifecycleResult
export lifecycle_ok, lifecycle_error
