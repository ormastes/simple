# std.pure.tensor — re-export facade over the real pure-Simple tensor core.
#
# WHY THIS FILE CHANGED (2026-07-25):
# This module used to be a 14-line *stub*: a `PureTensor` struct with only
# `data`/`shape` (no `strides`), no `get`/`set`/`numel`, and only two factory
# functions. Because `src/std` is a symlink to `lib`, `std.pure.tensor` resolved
# to this stub and SHADOWED the real 166-line implementation in
# `std.gc_async_mut.pure.tensor`. Everything importing `std.pure.tensor` — and
# that includes the real `std.gc_async_mut.pure.{tensor_ops, training, nn}` —
# silently bound to the stub.
#
# That shadowing is the actual root cause behind the "pre-existing test failures
# - functions/imports not available" note that had `pure/test/tensor_spec.spl`
# parked. Verified by probe: importing `std.pure.tensor.{compute_strides,
# tensor_zeros}` failed with "function `compute_strides` not found", while the
# identical probe against `std.gc_async_mut.pure.tensor` passed 4/4.
#
# The stub surface (PureTensor, tensor_from_data, tensor_zeros_like) is a strict
# subset of the real module's exports, so forwarding is source-compatible for
# every existing consumer while giving them the working implementation.

export use std.gc_async_mut.pure.tensor.{PureTensor, compute_strides}
export use std.gc_async_mut.pure.tensor.{tensor_from_data, tensor_from_data_i64}
export use std.gc_async_mut.pure.tensor.{tensor_zeros, tensor_ones, tensor_randn}
export use std.gc_async_mut.pure.tensor.{tensor_zeros_like}
export use std.gc_async_mut.pure.tensor.{total_elements, zeros_like, ones_like}
export use std.gc_async_mut.pure.tensor.{broadcast_shapes}
