"""BoundedChannel — hardened close semantics with backpressure.

A bounded FIFO channel with explicit close signalling.
Senders receive `false` from `send` after close.
Receivers drain remaining items before observing close.
"""

# Channel states
fn chan_state_open() -> i64:
    0

fn chan_state_closed() -> i64:
    1

class BoundedChannel:
    capacity: i64
    items: [i64]
    head: i64
    state: i64

    fn is_closed() -> bool:
        self.state == chan_state_closed()

    fn is_full() -> bool:
        self.len() >= self.capacity

    fn is_empty() -> bool:
        self.len() == 0

    fn len() -> i64:
        self.items.len() - self.head

    me compact_consumed_prefix_if_needed():
        """Reuse bounded storage before appending after cursor-only receives."""
        if self.head <= 0 or self.items.len() < self.capacity:
            return
        self.items = self.items.slice(self.head, self.items.len())
        self.head = 0

    # Returns true if item was accepted, false if channel closed or full
    me fn send(item: i64) -> bool:
        if self.is_closed():
            return false
        if self.is_full():
            return false
        self.compact_consumed_prefix_if_needed()
        self.items.push(item)
        true

    # Returns item or -1 if empty; -2 if closed-and-empty
    me fn recv() -> i64:
        if self.len() > 0:
            val item = self.items[self.head]
            self.head = self.head + 1
            if self.head >= self.items.len():
                self.items = []
                self.head = 0
            return item
        if self.is_closed():
            return -2
        -1

    # Close the channel — no more sends accepted; existing items still drainable
    me fn close():
        self.state = chan_state_closed()

fn bounded_channel_new(capacity: i64) -> BoundedChannel:
    BoundedChannel(capacity: capacity, items: [], head: 0, state: chan_state_open())
