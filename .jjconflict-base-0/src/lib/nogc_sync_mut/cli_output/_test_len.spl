# Shared module for testing .len() corruption on module-level arrays.
#
# BUG: Calling .len() twice on a module-level array in the same function
# corrupts the variable (becomes i64(0)) when the module is imported via use.
# Calling .len() once works fine.
#
# The exported names here are the contract consumed by the fixtures under
# test/system/module_import/fixtures/ (len_once_text.spl, len_twice_i64.spl,
# ...). Keep the two in sync: an unresolved import is only reported as
# `function <name> not found`, which reads as a product defect rather than a
# stale fixture.

var text_arr: [text] = []
var i64_arr: [i64] = []
var second_arr: [text] = []

fn len_once_text() -> i64:
    text_arr.len()

fn len_twice_text() -> i64:
    val a = text_arr.len()
    text_arr.len()

fn len_once_i64() -> i64:
    i64_arr.len()

fn len_twice_i64() -> i64:
    val a = i64_arr.len()
    i64_arr.len()

fn push_then_len() -> i64:
    text_arr.push("x")
    text_arr.len()

fn len_then_push() -> i64:
    val l = text_arr.len()
    text_arr.push("x")
    l

fn len_cached_text() -> i64:
    val cached = text_arr.len()
    cached + cached

fn len_multi_arrays() -> i64:
    val a = text_arr.len()
    val b = i64_arr.len()
    val c = second_arr.len()
    a + b + c
