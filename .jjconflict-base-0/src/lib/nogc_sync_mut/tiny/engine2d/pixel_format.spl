# codex-impl

const TINY_PIXEL_ARGB8888: i32 = 1
const TINY_PIXEL_RGB565: i32 = 2

fn tiny_argb_to_rgb565(argb: i32) -> i32:
    val red = (argb >> 16) & 255
    val green = (argb >> 8) & 255
    val blue = argb & 255
    ((red >> 3) << 11) | ((green >> 2) << 5) | (blue >> 3)

fn tiny_rgb565_to_argb(rgb: i32) -> i32:
    val red5 = (rgb >> 11) & 31
    val green6 = (rgb >> 5) & 63
    val blue5 = rgb & 31
    val red = (red5 << 3) | (red5 >> 2)
    val green = (green6 << 2) | (green6 >> 4)
    val blue = (blue5 << 3) | (blue5 >> 2)
    -16777216 | (red << 16) | (green << 8) | blue
