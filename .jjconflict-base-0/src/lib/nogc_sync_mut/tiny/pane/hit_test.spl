# codex-impl

use std.tiny.common.status.{TinyStatus, TINY_ERR_INVALID}
use std.tiny.common.types.{TinyHandle, TinyPoint, tiny_contains}
use std.tiny.pane.model.{TinyResolvedPane, TINY_PANE_VISIBLE, TINY_PANE_ENABLED, TINY_PANE_POINTER}

class TinyHitResult:
    status: TinyStatus
    handle: TinyHandle
    local_point: TinyPoint

fn tiny_hit_test(panes: [TinyResolvedPane], point: TinyPoint) -> TinyHitResult:
    var best_index = -1
    var best_z = -2147483647
    var i = panes.len() - 1
    while i >= 0:
        val pane = panes[i]
        val interactive = (
            (pane.flags & TINY_PANE_VISIBLE) != 0 and
            (pane.flags & TINY_PANE_ENABLED) != 0 and
            (pane.flags & TINY_PANE_POINTER) != 0
        )
        if interactive and tiny_contains(pane.effective_clip, point):
            if best_index < 0 or pane.z > best_z:
                best_index = i
                best_z = pane.z
        i = i - 1
    if best_index < 0:
        return TinyHitResult(
            status: TinyStatus.error(TINY_ERR_INVALID, 0), handle: TinyHandle.invalid(),
            local_point: TinyPoint(x: 0, y: 0),
        )
    val hit = panes[best_index]
    TinyHitResult(
        status: TinyStatus.ok(), handle: hit.id,
        local_point: TinyPoint(x: point.x - hit.absolute.x, y: point.y - hit.absolute.y),
    )
