"""Pure Metal-pipeline cache bookkeeping.

The former `MetalComputeSession` declared ten providerless Engine2D Metal
functions with ad-hoc handle and text contracts. Production does not import
that execution façade; retaining it could turn a missing foreign provider into
fabricated handles or text. The active GC Metal backend is a separate owner.

This module intentionally preserves only allocation-free bounded pipeline-cache
bookkeeping. It contains no SFFI boundary.
"""

# ============================================================================
# MetalPipelineCache — flat storage for up to 4 named pipeline handles
# ============================================================================

class MetalPipelineCache:
    p0_name: text
    p0_handle: i64
    p1_name: text
    p1_handle: i64
    p2_name: text
    p2_handle: i64
    p3_name: text
    p3_handle: i64
    count: i64

    static fn create() -> MetalPipelineCache:
        MetalPipelineCache(
            p0_name: "", p0_handle: 0,
            p1_name: "", p1_handle: 0,
            p2_name: "", p2_handle: 0,
            p3_name: "", p3_handle: 0,
            count: 0)

    me cache_pipeline(name: text, handle: i64) -> text:
        if self.count == 0:
            self.p0_name = name
            self.p0_handle = handle
            self.count = 1
            return ""
        if self.count == 1:
            self.p1_name = name
            self.p1_handle = handle
            self.count = 2
            return ""
        if self.count == 2:
            self.p2_name = name
            self.p2_handle = handle
            self.count = 3
            return ""
        if self.count == 3:
            self.p3_name = name
            self.p3_handle = handle
            self.count = 4
            return ""
        "pipeline cache full (max 4)"

    me find_pipeline(name: text) -> i64:
        if self.p0_name == name:
            return self.p0_handle
        if self.p1_name == name:
            return self.p1_handle
        if self.p2_name == name:
            return self.p2_handle
        if self.p3_name == name:
            return self.p3_handle
        0

# ============================================================================
# MetalComputeSession
# ============================================================================

class MetalComputeSession:
    pipeline_cache: MetalPipelineCache
    mode: text
    cache_reject_count: i64
    last_cache_rejection: text

    static fn create(mode: text) -> MetalComputeSession:
        MetalComputeSession(
            pipeline_cache: MetalPipelineCache.create(),
            mode: mode,
            cache_reject_count: 0,
            last_cache_rejection: "")

    # The caller supplies an already-admitted pipeline identity. This method
    # performs bounded cache bookkeeping only and never invokes Metal.
    me record_pipeline(name: text, handle: i64):
        val cache_result = self.pipeline_cache.cache_pipeline(name, handle)
        if cache_result != "":
            self.cache_reject_count = self.cache_reject_count + 1
            self.last_cache_rejection = "pipeline:{name}"

    me cache_reject_count_get() -> i64:
        self.cache_reject_count

    me last_cache_rejection_get() -> text:
        self.last_cache_rejection
