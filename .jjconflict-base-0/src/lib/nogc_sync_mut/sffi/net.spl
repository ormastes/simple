# net runtime aliases — thin typed wrappers over rt_* primitives.
#
# Part of the rt_* migration programme (scripts/check/rt_alias_map.sdn):
# every wrapper here is signature-identical to the raw runtime call it names,
# so `rt_migrate` can rewrite product call sites mechanically. Product code
# imports these instead of declaring `extern fn rt_*` itself. Signatures come
# from the majority extern declaration in the tree (see the map's decl census).

@unsafe(reason: "raw runtime ABI for rt_http_get", capabilities: [ffi])
extern fn rt_http_get(url: text) -> (i64, text, text)

@always_inline
fn http_get(url: text) -> (i64, text, text):
    unsafe(capabilities: [ffi]):
        rt_http_get(url)

@unsafe(reason: "raw runtime ABI for rt_http_request", capabilities: [ffi])
extern fn rt_http_request(method: text, url: text, headers: text, body: text) -> (i64, text, text)

@always_inline
fn http_request(method: text, url: text, headers: text, body: text) -> (i64, text, text):
    unsafe(capabilities: [ffi]):
        rt_http_request(method, url, headers, body)

