# codex-impl
# Bounded parent-owned commit for results created by isolated HAL workers.

use std.common.rt_hal.model.*

val RT_HAL_RETAINED_SLOT_BYTES: i64 = 128

pub struct RtHalResultSlot:
    present: bool
    result: RtHalChildResult

pub class RtHalCoordinator:
    comparison: RtHalComparison
    requests: [RtHalRequest]
    provider_count: i64
    case_count: i64
    accepted: i64
    rejected: i64
    retained_input_bytes: i64
    retained_output_bytes: i64
    memory_capacity_exceeded: bool
    dispatch_rounds: i64
    max_parallel_width: i64
    dispatch_error: text
    slots: [RtHalResultSlot]

impl RtHalCoordinator:
    static fn create(comparison: RtHalComparison, requests: [RtHalRequest]) -> RtHalCoordinator:
        val empty_outcome = RtHalOutcome(
            status: RtHalOutcomeStatus.Unsupported, code: "RTHAL-W-UNSUPPORTED",
            value_hash: "", effect_hash: ""
        )
        val empty_result = RtHalChildResult(
            provider_ordinal: -1, case_index: -1, case_id: -1,
            provider_id: "", mode: RtHalWorkMode.ExecuteQuery,
            outcome: empty_outcome
        )
        val provider_count = comparison.providers.len()
        var safe_case_count = 0
        if provider_count > 0 and comparison.queue_capacity > 0:
            val max_cases = comparison.queue_capacity / provider_count
            val memory_cases = comparison.max_output_bytes / RT_HAL_RETAINED_SLOT_BYTES / provider_count
            safe_case_count = requests.len()
            if safe_case_count > max_cases:
                safe_case_count = max_cases
            if safe_case_count > memory_cases:
                safe_case_count = memory_cases
        val slot_count = provider_count * safe_case_count
        var slots: [RtHalResultSlot] = []
        var index = 0
        while index < slot_count:
            slots.push(RtHalResultSlot(present: false, result: empty_result))
            index = index + 1
        # Covers each fixed result slot plus amortized provider/request records;
        # variable text payloads are charged separately below.
        var retained_input_bytes = slot_count * RT_HAL_RETAINED_SLOT_BYTES
        var memory_capacity_exceeded = requests.len() > safe_case_count
        var provider_index = 0
        while provider_index < provider_count:
            val provider_bytes = comparison.providers[provider_index].provider_id.len()
            if provider_bytes > comparison.max_output_bytes - retained_input_bytes:
                memory_capacity_exceeded = true
            else:
                retained_input_bytes = retained_input_bytes + provider_bytes
            provider_index = provider_index + 1
        var request_index = 0
        while request_index < safe_case_count:
            val request = requests[request_index]
            val operation_bytes = request.operation_id.len()
            val input_bytes = request.input_hash.len()
            val replay_bytes = request.replay_hash.len()
            if operation_bytes > comparison.max_output_bytes - retained_input_bytes:
                memory_capacity_exceeded = true
            else:
                retained_input_bytes = retained_input_bytes + operation_bytes
            if input_bytes > comparison.max_output_bytes - retained_input_bytes:
                memory_capacity_exceeded = true
            else:
                retained_input_bytes = retained_input_bytes + input_bytes
            if replay_bytes > comparison.max_output_bytes - retained_input_bytes:
                memory_capacity_exceeded = true
            else:
                retained_input_bytes = retained_input_bytes + replay_bytes
            request_index = request_index + 1
        RtHalCoordinator(
            comparison: comparison, requests: requests,
            provider_count: provider_count, case_count: safe_case_count,
            accepted: 0, rejected: 0, retained_input_bytes: retained_input_bytes,
            retained_output_bytes: 0,
            memory_capacity_exceeded: memory_capacity_exceeded, dispatch_rounds: 0,
            max_parallel_width: 0, dispatch_error: "", slots: slots
        )

    fn configuration_error() -> text:
        val comparison_error = rt_hal_comparison_error(self.comparison)
        if comparison_error != "":
            return comparison_error
        if self.memory_capacity_exceeded:
            return "RTHAL-E-MEMORY-BOUND"
        if self.case_count <= 0:
            return "RTHAL-E-BOUND"
        if self.case_count != self.requests.len() or self.provider_count * self.case_count > self.comparison.queue_capacity:
            return "RTHAL-E-BOUND"
        val requests_error = rt_hal_requests_error(self.requests)
        if requests_error != "":
            return requests_error
        ""

    # O(1), allocation-free after create(). The parent alone mutates slots.
    me submit(child: RtHalChildResult) -> text:
        if child.provider_ordinal < 0 or child.provider_ordinal >= self.provider_count:
            self.rejected = self.rejected + 1
            return "RTHAL-E-PROVIDER-ID"
        if child.case_index < 0 or child.case_index >= self.case_count:
            self.rejected = self.rejected + 1
            return "RTHAL-E-REQUEST"
        val provider = self.comparison.providers[child.provider_ordinal]
        val request = self.requests[child.case_index]
        if child.provider_id != provider.provider_id or child.case_id != request.case_id:
            self.rejected = self.rejected + 1
            return "RTHAL-E-RESULT-IDENTITY"
        val required_mode = rt_hal_work_mode(provider, request)
        if child.mode != required_mode:
            self.rejected = self.rejected + 1
            if request.operation == RtHalOperationKind.Effectful:
                return "RTHAL-E-UNSAFE-REPLAY"
            return "RTHAL-E-RESULT-MODE"
        val slot_index = child.case_index * self.provider_count + child.provider_ordinal
        if self.slots[slot_index].present:
            self.rejected = self.rejected + 1
            return "RTHAL-E-RESULT-DUPLICATE"
        val code_bytes = child.outcome.code.len()
        val value_bytes = child.outcome.value_hash.len()
        val effect_bytes = child.outcome.effect_hash.len()
        val remaining = self.comparison.max_output_bytes - self.retained_input_bytes - self.retained_output_bytes
        if code_bytes > remaining:
            self.rejected = self.rejected + 1
            return "RTHAL-E-OUTPUT-BOUND"
        val after_code = remaining - code_bytes
        if value_bytes > after_code:
            self.rejected = self.rejected + 1
            return "RTHAL-E-OUTPUT-BOUND"
        val after_value = after_code - value_bytes
        if effect_bytes > after_value:
            self.rejected = self.rejected + 1
            return "RTHAL-E-OUTPUT-BOUND"
        self.slots[slot_index] = RtHalResultSlot(present: true, result: child)
        self.retained_output_bytes = self.retained_output_bytes + code_bytes + value_bytes + effect_bytes
        self.accepted = self.accepted + 1
        ""

    fn result_present(case_index: i64, provider_ordinal: i64) -> bool:
        if case_index < 0 or case_index >= self.case_count:
            return false
        if provider_ordinal < 0 or provider_ordinal >= self.provider_count:
            return false
        self.slots[case_index * self.provider_count + provider_ordinal].present

    fn compared_result(case_index: i64, provider_ordinal: i64) -> RtHalComparedResult:
        val pure_slot = self.slots[case_index * self.provider_count]
        val candidate_slot = self.slots[case_index * self.provider_count + provider_ordinal]
        val provider = self.comparison.providers[provider_ordinal]
        val missing = RtHalOutcome(
            status: RtHalOutcomeStatus.Unsupported, code: "RTHAL-W-UNSUPPORTED",
            value_hash: "", effect_hash: ""
        )
        val candidate = if candidate_slot.present: candidate_slot.result.outcome else: missing
        RtHalComparedResult(
            provider_ordinal: provider_ordinal,
            case_id: self.requests[case_index].case_id,
            provider_id: provider.provider_id, outcome: candidate,
            matches_pure: pure_slot.present and candidate_slot.present and
                rt_hal_outcomes_match(pure_slot.result.outcome, candidate)
        )

    fn completion_error() -> text:
        if self.dispatch_error != "":
            return self.dispatch_error
        var case_index = 0
        while case_index < self.case_count:
            if not self.result_present(case_index, 0):
                return "RTHAL-E-PURE-MISSING"
            val pure_status = self.slots[case_index * self.provider_count].result.outcome.status
            if pure_status == RtHalOutcomeStatus.Blocked:
                return "RTHAL-E-BLOCKED"
            if pure_status == RtHalOutcomeStatus.Unsupported:
                return "RTHAL-W-UNSUPPORTED"
            if pure_status == RtHalOutcomeStatus.TimedOut:
                return "RTHAL-E-TIMEOUT"
            if pure_status == RtHalOutcomeStatus.Error:
                return "RTHAL-E-PURE-ERROR"
            var provider_ordinal = 1
            while provider_ordinal < self.provider_count:
                if not self.result_present(case_index, provider_ordinal):
                    if self.comparison.require_all:
                        return "RTHAL-E-RESULT-MISSING"
                else:
                    val candidate_status = self.slots[case_index * self.provider_count + provider_ordinal].result.outcome.status
                    if candidate_status == RtHalOutcomeStatus.Blocked:
                        return "RTHAL-E-BLOCKED"
                    if candidate_status == RtHalOutcomeStatus.TimedOut:
                        return "RTHAL-E-TIMEOUT"
                    if candidate_status == RtHalOutcomeStatus.Unsupported:
                        if self.comparison.require_all:
                            return "RTHAL-W-UNSUPPORTED"
                    else:
                        val compared = self.compared_result(case_index, provider_ordinal)
                        if not compared.matches_pure:
                            return "RTHAL-E-MISMATCH"
                provider_ordinal = provider_ordinal + 1
            case_index = case_index + 1
        ""
