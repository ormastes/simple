# Shared font-rendering values. Kept separate so renderer and rasterizer do not
# depend on each other's partially resolved module shape.

use std.common.gpu.font_atlas_composite.{font_atlas_composite_program_version_valid}

class CachedGlyph:
    codepoint: i32
    face_id: i64
    face_generation: i64
    glyph_index: i32
    font_size: i32
    width: i32
    height: i32
    advance: i32
    bearing_x: i32
    bearing_y: i32
    pixels: [u8]
    render_config_identity: text = ""

    static fn empty(cp: i32, fs: i32) -> CachedGlyph:
        CachedGlyph(codepoint: cp, face_id: 0, face_generation: 0, glyph_index: -1, font_size: fs, width: 0, height: 0, advance: 0, bearing_x: 0, bearing_y: 0, pixels: [])

class FontGlyphRun:
    valid: bool
    face_id: i64
    face_generation: i64
    glyph_ids: [u32]
    xs: [i32]
    ys: [i32]
    # Logical source positions in the caller's codepoint array. Text APIs may
    # later translate these to UTF-8 byte offsets; this value does not pretend
    # to be a byte index.
    clusters: [i64]

class FontCacheStats:
    entries: i64
    bytes: i64
    generation: i64
    font_identity: text
    hits: i64
    misses: i64
    rasterizations: i64
    evictions: i64
    render_config_identity: text = ""

enum FontExecutionPolicy:
    Suggested
    Preferred
    Required

fn font_execution_policy_name(policy: FontExecutionPolicy) -> text:
    match policy:
        FontExecutionPolicy.Suggested: "suggested"
        FontExecutionPolicy.Preferred: "preferred"
        FontExecutionPolicy.Required: "required"

fn font_render_config_normalize(value: text) -> text:
    val trimmed = value.trim()
    trimmed.lower()

fn font_execution_target_name(target: text) -> text:
    val normalized = font_render_config_normalize(target)
    if normalized == "hip": "rocm" else: normalized

fn font_execution_target_supported(target: text) -> bool:
    val normalized = font_execution_target_name(target)
    (normalized == "auto" or normalized == "cuda" or normalized == "metal" or
        normalized == "rocm" or normalized == "opencl" or normalized == "vulkan" or
        normalized == "cpu")

fn font_render_category_name(category: text) -> text:
    val normalized = font_render_config_normalize(category)
    if normalized == "pixel/bitmap": "pixel" else: normalized

fn font_render_category_supported(category: text) -> bool:
    val normalized = font_render_category_name(category)
    (normalized == "auto" or normalized == "sans" or normalized == "serif" or
        normalized == "mono" or normalized == "display" or normalized == "rounded" or
        normalized == "handwriting" or normalized == "slab" or normalized == "blackletter" or
        normalized == "pixel" or normalized == "emoji")

class FontRenderConfig:
    family: text
    category: text
    language: text
    script: text
    size: i32
    weight: text
    style: text
    hinting: text
    antialiasing: text
    atlas_policy: text
    execution_target: text
    execution_policy: FontExecutionPolicy

    static fn default_for_size(size: i32) -> FontRenderConfig:
        font_render_config_default_for_size(size)

# NOTE(2026-07-18): identity()/valid() are FREE FUNCTIONS, not instance methods.
# A `config.identity()`/`config.valid()` instance-method call is miscompiled on the
# entry-closure freestanding native path (`--entry-closure --target x86_64-unknown-none`):
# the call loads the callee's own address into the `self` register (rdi) instead of the
# receiver, so `self` is a code address and every field read faults (first desktop-frame
# fault storm). Free-function calls pass `config` correctly as an argument. See bug
# doc/08_tracking/bug/engine2d_cpu_offscreen_render_commands_first_frame_fault_2026-07-17.md.

fn font_render_config_identity(config: FontRenderConfig) -> text:
    val family = font_render_config_normalize(config.family)
    val category = font_render_category_name(config.category)
    val language = font_render_config_normalize(config.language)
    val script = font_render_config_normalize(config.script)
    val weight = font_render_config_normalize(config.weight)
    val style = font_render_config_normalize(config.style)
    val hinting = font_render_config_normalize(config.hinting)
    val antialiasing = font_render_config_normalize(config.antialiasing)
    val atlas = font_render_config_normalize(config.atlas_policy)
    val target = font_execution_target_name(config.execution_target)
    "font-config-v1|family=" + family.len().to_string() + ":" + family +
        "|category=" + category.len().to_string() + ":" + category +
        "|language=" + language.len().to_string() + ":" + language +
        "|script=" + script.len().to_string() + ":" + script +
        "|size=" + config.size.to_string() +
        "|weight=" + weight.len().to_string() + ":" + weight +
        "|style=" + style.len().to_string() + ":" + style +
        "|hinting=" + hinting.len().to_string() + ":" + hinting +
        "|antialiasing=" + antialiasing.len().to_string() + ":" + antialiasing +
        "|atlas=" + atlas.len().to_string() + ":" + atlas +
        "|target=" + target.len().to_string() + ":" + target +
        "|policy=" + font_execution_policy_name(config.execution_policy)

fn font_render_config_valid(config: FontRenderConfig) -> bool:
    val target = font_execution_target_name(config.execution_target)
    # Sequential explicit gates, not one mixed and/or chain: the freestanding
    # entry-closure codegen drops left operands of mixed boolean chains
    # (third confirmed site 2026-07-26 — this validator rejected the healthy
    # default config at exactly one call site, [font-plan] config-invalid
    # size=12 target=auto). Semantics identical on healthy compilers.
    if config.size <= 0:
        return false
    if config.size > 512:
        return false
    if config.family.trim() == "":
        return false
    if not font_render_category_supported(config.category):
        return false
    if config.language.trim() == "":
        return false
    if config.script.trim() == "":
        return false
    if font_render_config_normalize(config.weight) != "normal":
        return false
    if font_render_config_normalize(config.style) != "normal":
        return false
    if font_render_config_normalize(config.hinting) != "none":
        return false
    if font_render_config_normalize(config.antialiasing) != "grayscale":
        return false
    if font_render_config_normalize(config.atlas_policy) != "shared-alpha-1024":
        return false
    if not font_execution_target_supported(target):
        return false
    if target == "auto":
        # Direct ==/!= between the enum FIELD and a fresh variant literal
        # miscompiles on the freestanding entry-closure lane: a config
        # constructed with Suggested compared != Suggested here
        # ([font-plan] config-dump policy_suggested=0, rerun34 2026-07-26).
        # match on the field switches on the tag and works — same idiom
        # font_execution_policy_name relies on. Semantics identical.
        var policy_suggested = false
        match config.execution_policy:
            FontExecutionPolicy.Suggested: policy_suggested = true
            FontExecutionPolicy.Preferred: policy_suggested = false
            FontExecutionPolicy.Required: policy_suggested = false
        if not policy_suggested:
            return false
    true

fn font_execution_plan(config: FontRenderConfig, executable_targets: [text]) -> [text]:
    if not font_render_config_valid(config):
        return []
    var order: [text] = []
    for raw in executable_targets:
        val target = font_execution_target_name(raw)
        if target == "auto" or not font_execution_target_supported(target):
            return []
        if not order.contains(target):
            order.push(target)
    val requested = font_execution_target_name(config.execution_target)
    if order.len() == 0 or (requested != "auto" and not order.contains(requested)):
        return []
    if config.execution_policy == FontExecutionPolicy.Required:
        return [requested]
    if config.execution_policy == FontExecutionPolicy.Preferred:
        var preferred = [requested]
        if requested != "cpu" and order.contains("cpu"):
            preferred.push("cpu")
        return preferred
    if requested == "auto":
        return order
    var suggested = [requested]
    for target in order:
        if target != requested:
            suggested.push(target)
    suggested

pub fn font_execution_plan_into(config: FontRenderConfig, executable_targets: [text], mut plan_out: [text]) -> i64:
    """Freestanding-safe variant of font_execution_plan: fills the caller's
    plan_out (mut array param, proven channel) and returns the count as a
    scalar. The [text] array RETURN of font_execution_plan arrived empty at
    one engine call site on the freestanding lane while the identical call
    in the shaped path survived (layout-dependent loss; [e2d-batch]
    plan-empty, 2026-07-26). Logic mirrors font_execution_plan exactly.
    Per-gate receipts are silent on healthy configs and attribute WHICH
    gate rejected when the plan comes back empty."""
    if not font_render_config_valid(config):
        print("[font-plan] config-invalid size={config.size} target={config.execution_target}")
        # Field dump (locals, no chains): names WHICH field arrives corrupted
        # through the aggregate param hops — expected healthy values are
        # family=auto category=auto language=und script=auto weight=normal
        # style=normal hinting=none aa=grayscale atlas=shared-alpha-1024.
        val d_size = config.size
        val d_family: text = config.family
        val d_category: text = config.category
        val d_language: text = config.language
        val d_script: text = config.script
        val d_weight: text = config.weight
        val d_style: text = config.style
        val d_hinting: text = config.hinting
        val d_aa: text = config.antialiasing
        val d_atlas: text = config.atlas_policy
        val d_policy_suggested = if config.execution_policy == FontExecutionPolicy.Suggested: 1 else: 0
        val d_eq_p = if config.execution_policy == FontExecutionPolicy.Preferred: 1 else: 0
        val d_eq_r = if config.execution_policy == FontExecutionPolicy.Required: 1 else: 0
        var d_policy_match = "none"
        match config.execution_policy:
            FontExecutionPolicy.Suggested: d_policy_match = "suggested"
            FontExecutionPolicy.Preferred: d_policy_match = "preferred"
            FontExecutionPolicy.Required: d_policy_match = "required"
        print("[font-plan] config-dump size={d_size} family='{d_family}' category='{d_category}' language='{d_language}' script='{d_script}' weight='{d_weight}' style='{d_style}' hinting='{d_hinting}' aa='{d_aa}' atlas='{d_atlas}' policy_suggested={d_policy_suggested} policy_eq_pr={d_eq_p}{d_eq_r} policy_match='{d_policy_match}'")
        return 0
    var order: [text] = []
    for raw in executable_targets:
        val target = font_execution_target_name(raw)
        if target == "auto" or not font_execution_target_supported(target):
            print("[font-plan] target-unsupported target={target}")
            return 0
        if not order.contains(target):
            order.push(target)
    val requested = font_execution_target_name(config.execution_target)
    if order.len() == 0 or (requested != "auto" and not order.contains(requested)):
        print("[font-plan] requested-not-executable requested={requested} order_len={order.len()}")
        return 0
    if config.execution_policy == FontExecutionPolicy.Required:
        plan_out.push(requested)
        return 1
    if config.execution_policy == FontExecutionPolicy.Preferred:
        plan_out.push(requested)
        var preferred_count: i64 = 1
        if requested != "cpu":
            if order.contains("cpu"):
                plan_out.push("cpu")
                preferred_count = 2
        return preferred_count
    var plan_count: i64 = 0
    if requested == "auto":
        for target in order:
            plan_out.push(target)
            plan_count = plan_count + 1
        return plan_count
    plan_out.push(requested)
    plan_count = 1
    for target in order:
        if target != requested:
            plan_out.push(target)
            plan_count = plan_count + 1
    plan_count

# Free-function form of FontRenderConfig.default_for_size: the seed compiler's
# semantic analyzer rejects the static path call `FontRenderConfig.default_for_size(...)`
# ("unsupported path call") in the interpreted web-render path, while free
# function calls resolve fine. Callers in that path use this; the static method
# delegates here so both entry points stay identical. See bug
# web_font_provider_split_nested_call_resolution_2026-07-14 (same seed-gap cluster).
fn font_render_config_default_for_size(size: i32) -> FontRenderConfig:
    FontRenderConfig(
        family: "auto", category: "auto", language: "und", script: "auto", size: size,
        weight: "normal", style: "normal", hinting: "none", antialiasing: "grayscale",
        atlas_policy: "shared-alpha-1024", execution_target: "auto",
        execution_policy: FontExecutionPolicy.Suggested
    )

class FontTextPayload:
    valid: bool
    width: i32
    height: i32
    offset_x: i32
    offset_y: i32
    pixels: [u32]

    fn is_empty() -> bool:
        self.width <= 0 or self.height <= 0 or self.pixels.len() == 0

class FontRenderQuad:
    codepoint: i32
    byte_offset: i64
    dst_x: i32
    dst_y: i32
    width: i32
    height: i32
    atlas_x: i32
    atlas_y: i32
    color: u32
    # Logical codepoint cluster for shaped runs; -1 for byte-oriented layout.
    cluster: i64 = -1

class FontRenderBatch:
    program_version: i64
    font_identity: text
    face_generation: i64
    valid: bool
    atlas_width: i32
    atlas_height: i32
    atlas_pixels: [u32]
    quads: [FontRenderQuad]
    atlas_generation: i64
    dirty_rects: [FontRenderQuad]
    # Overrides face_generation in atlas_owner_identity()/atlas_cache_identity()
    # when multiple faces (e.g. synthesized weights/styles of one family) share
    # one atlas and must key ownership by the shared owner's generation instead
    # of each face's own generation. -1 means "no override; use face_generation".
    atlas_owner_generation: i64 = -1
    render_config_identity: text = "coverage8;hint=none;subpixel=none"
    transform_identity: text = "uniform-scale;translate-late"
    execution_target: text = "auto"
    execution_policy: FontExecutionPolicy = FontExecutionPolicy.Suggested

    fn is_empty() -> bool:
        self.quads.len() == 0 or self.atlas_pixels.len() == 0

    fn material_supported() -> bool:
        self.valid and font_atlas_composite_program_version_valid(self.program_version) and
            self.transform_identity == "uniform-scale;translate-late"

    # NOTE: the body lives in the free function font_render_batch_atlas_owner_identity()
    # below (same free-function-holds-the-logic pattern as
    # font_render_config_default_for_size()/FontRenderConfig.default_for_size() above);
    # this method only delegates so both call forms stay identical. See that free
    # function's comment for why the logic isn't inlined here as `self.field` reads.
    fn atlas_owner_identity() -> text:
        font_render_batch_atlas_owner_identity(self)

    fn atlas_cache_identity() -> text:
        font_render_batch_atlas_cache_identity(self)

# NOTE: font_render_batch_atlas_owner_identity()/font_render_batch_atlas_cache_identity()
# are FREE-FUNCTION forms of FontRenderBatch.atlas_owner_identity()/atlas_cache_identity()
# above, for the same reason as font_render_config_identity() (see the NOTE(2026-07-18)
# above): the entry-closure freestanding native path miscompiles instance method calls
# (self.method()), passing the callee's own code address as `self` instead of the
# receiver. To stay native-safe these free functions read `batch.<field>` directly and
# do NOT call back into the instance methods (self.method()) — the class methods above
# delegate to these, not the other way around.

fn font_render_batch_atlas_owner_identity(batch: FontRenderBatch) -> text:
    val identity = batch.font_identity
    val owner_generation = if batch.atlas_owner_generation != -1: batch.atlas_owner_generation else: batch.face_generation
    "font-atlas-v1|" + identity.len().to_string() + ":" + identity +
        "|face-generation=" + owner_generation.to_string() +
        "|program=" + batch.program_version.to_string() +
        "|config=" + batch.render_config_identity.len().to_string() + ":" + batch.render_config_identity +
        "|transform=" + batch.transform_identity.len().to_string() + ":" + batch.transform_identity +
        "|size=" + batch.atlas_width.to_string() + "x" + batch.atlas_height.to_string()

fn font_render_batch_atlas_cache_identity(batch: FontRenderBatch) -> text:
    font_render_batch_atlas_owner_identity(batch) + "|generation=" + batch.atlas_generation.to_string()
