# Notebook execution lane types — LaneStatus, CellResult, SessionOpts, DisplayItem.
#
# Design:  doc/05_design/app/tools/notebook_lanes_architecture.md §4.1
# Plan:    doc/03_plan/agent_tasks/notebook_lanes_parallel_plan_2026-08-07.md (Stream K, K1)
# Research: doc/01_research/app/tools/notebook_lanes_research.md

# ============================================================================
# LaneStatus — availability of a NotebookExecutor lane.
#
# Reuses the repo-wide "skip:<reason>" / "blocked:<reason>" wording convention
# (see src/lib/common/test_env_gate.spl and src/os/simpleos_config_matrix.spl)
# so lane tables (§3 "%lanes") read identically to test-runner skip/blocked
# diagnostics.
# ============================================================================

enum LaneStatus:
    Available
    Skip(reason: text)
    Blocked(reason: text)

impl LaneStatus:
    fn to_text() -> text:
        """Render using the repo's skip:/blocked: wording convention."""
        match self:
            LaneStatus.Available: "available"
            LaneStatus.Skip(reason): "skip: {reason}"
            LaneStatus.Blocked(reason): "blocked: {reason}"

    fn is_available() -> bool:
        match self:
            LaneStatus.Available: true
            LaneStatus.Skip(reason): false
            LaneStatus.Blocked(reason): false

# ============================================================================
# DisplayItem — one rich-display payload attached to a CellResult
# (design §4.1 "display_data list"; e.g. text/latex, text/markdown, text/plain).
# ============================================================================

struct DisplayItem:
    mime: text
    data: text

# ============================================================================
# CellResult — design §4.1: "stdout delta, display_data list, records, error?, duration"
# ============================================================================

struct CellResult:
    stdout_delta: text
    display_data: [DisplayItem]
    records: [text]
    error: text
    duration_ms: i64

impl CellResult:
    fn is_ok() -> bool:
        self.error == ""

pub fn cell_result_ok(stdout_delta: text, display_data: [DisplayItem], records: [text], duration_ms: i64) -> CellResult:
    CellResult(stdout_delta: stdout_delta, display_data: display_data, records: records, error: "", duration_ms: duration_ms)

pub fn cell_result_error(error: text, duration_ms: i64) -> CellResult:
    CellResult(stdout_delta: "", display_data: [], records: [], error: error, duration_ms: duration_ms)

# ============================================================================
# SessionOpts — passed to NotebookExecutor.start() (design §4.1
# "acquire device/board/process"); carries the §3 magic-derived knobs.
# ============================================================================

struct SessionOpts:
    session_id: text
    mode_spec: text
    step_budget: i64
    timeout_ms: i64
    onfault_reset: bool

pub fn session_opts_default(session_id: text, mode_spec: text) -> SessionOpts:
    SessionOpts(session_id: session_id, mode_spec: mode_spec, step_budget: 0, timeout_ms: 0, onfault_reset: false)
