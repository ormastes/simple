# RemoteExec — NotebookExecutor backing the JTAG/T32/OpenOCD/GHDL remote
# baremetal lanes (`interpreter(remote(baremetal(...)))`,
# `interpreter(remote(t32(...)))`, `interpreter(remote(openocd(...)))`,
# `interpreter(remote(ghdl(...)))`).
#
# Design:  doc/05_design/app/tools/notebook_lanes_architecture.md §4.3
# Plan:    doc/03_plan/agent_tasks/notebook_lanes_parallel_plan_2026-08-07.md (Stream K, K4)
#
# Wraps the EXISTING remote execution pipeline (no GPU-plan dependency):
#   - probing:            capability_report.probe_qemu_rv32 / probe_openocd /
#                          probe_ghdl / probe_trace32 — reused verbatim via
#                          each adapter's own `capability_report()` method
#                          (same call the test runner's JIT-remote lane uses).
#   - session (spawn/attach once): the per-backend adapter's `connect()` /
#     `disconnect()` (QemuRv32Adapter, Stm32H7Adapter, GhdlRv32Adapter,
#     Trace32Adapter — src/lib/nogc_sync_mut/debug/remote/exec/adapter_*.spl).
#   - compile+upload+run+collect: RemoteExecutionManager.execute_bytes, fed by
#     compiler_bridge.compile_remote_binary, exactly as
#     test_executor_composite_jit_generic.spl's run_test_file_jit_with_adapter
#     already wires them for the test runner's `jit(remote(...))` lane — the
#     only difference here is the adapter/manager are kept ALIVE across
#     multiple execute_cell() calls (one QEMU/OpenOCD/GHDL/T32 process for the
#     whole notebook session) instead of connect-once-per-test-file.
#
# KNOWN LIMITATION (pre-existing, not introduced here): compile_remote_binary
# (src/lib/nogc_sync_mut/debug/remote/exec/compiler_bridge.spl:24-28) ignores
# `source` and always returns a fixed "return 0" stub for every architecture.
# It does not compile the cell's Simple source to real target semantics, so
# RemoteExec cannot yet produce cell-code-driven cross-cell VALUE state (e.g.
# a `val x = 1` cell's `x` observably changing a later cell's result) purely
# through compiled code. What DOES work today, and is what this file proves
# (see the integration spec), is genuine session/target-memory persistence:
# the same QEMU/adapter process — and therefore the same target RAM — stays
# live across execute_cell() calls until reset()/shutdown() tears it down.
# Filed: doc/08_tracking/bug/remote_exec_compile_remote_binary_is_a_stub_2026-08-07.md

use std.notebook.types.{LaneStatus, CellResult, SessionOpts, cell_result_ok, cell_result_error}
use std.notebook.executor.{NotebookExecutor, NotebookExecutorFactory}
use std.test_runner.test_executor_composite_parse.{extract_target_from_spec, extract_remote_backend}
use std.nogc_sync_mut.debug.remote.types.{Architecture}
use std.nogc_sync_mut.debug.remote.exec.types.{MemoryMap, ExecResult}
use std.nogc_sync_mut.debug.remote.exec.manager.{RemoteExecutionManager}
use std.nogc_sync_mut.debug.remote.exec.compiler_bridge.{compile_remote_binary}
use std.nogc_sync_mut.debug.remote.exec.capability_report.{CapabilityReport, CapabilityStatus}
use std.nogc_sync_mut.debug.remote.exec.adapter_qemu_rv32.{QemuRv32Adapter}
use std.nogc_sync_mut.debug.remote.exec.adapter_stm32h7.{Stm32H7Adapter}
use std.nogc_sync_mut.debug.remote.exec.adapter_ghdl_rv32.{GhdlRv32Adapter}
use std.nogc_sync_mut.debug.remote.exec.adapter_trace32.{Trace32Adapter}
use std.nogc_sync_mut.jit.jit_types.{JitBinary}
use std.nogc_sync_mut.jit.jit_layout.{plan_binary_layout}
use std.nogc_sync_mut.io.time_ops.{time_now_unix_micros}

# ============================================================================
# Backend selection — mirrors the composite-mode target/backend extraction
# already used by the test runner (design §3: "same extractor helpers").
# ============================================================================

fn remote_exec_backend_for(mode_spec: text) -> text:
    """Pick one of the four adapter families this file wraps, from a
    validated composite mode spec. "" means the spec's target has no wired
    remote-baremetal adapter (yet)."""
    val target = extract_target_from_spec(mode_spec)
    val backend = extract_remote_backend(mode_spec)
    if target == "ghdl_rv32" or backend == "ghdl":
        return "ghdl_rv32"
    if target == "trace32_stm32h7":
        return "trace32_stm32h7"
    if target == "trace32_stm32wb":
        return "trace32_stm32wb"
    if target == "riscv32":
        return "qemu_rv32"
    if target == "stm32h7":
        return "openocd_stm32h7"
    ""

fn capability_to_lane_status(report: CapabilityReport) -> LaneStatus:
    """Reuses the adapter's own capability_report() verbatim (design §4.1
    probe() contract), just renamed onto LaneStatus's skip:/blocked:
    wording (types.spl)."""
    match report.status:
        CapabilityStatus.ready: LaneStatus.Available
        CapabilityStatus.skip_missing_tool: LaneStatus.Skip(report.detail)
        CapabilityStatus.skip_missing_board: LaneStatus.Skip(report.detail)
        CapabilityStatus.blocked_permissions: LaneStatus.Blocked(report.detail)
        CapabilityStatus.blocked_host_config: LaneStatus.Blocked(report.detail)
        CapabilityStatus.failed_runtime: LaneStatus.Blocked(report.detail)

# ============================================================================
# RemoteExec — one live remote-target session per (session, mode_spec) cache
# entry (design §4.3): start() spawns/attaches once, execute_cell() compiles
# the cell delta and runs it on the still-live target, reset() tears the
# target down and reconnects (fresh RAM), shutdown() tears it down for good.
# ============================================================================

class RemoteExec:
    spec: text
    backend: text
    arch: Architecture
    memory_map: MemoryMap
    qemu_rv32: Option<QemuRv32Adapter>
    openocd_stm32h7: Option<Stm32H7Adapter>
    ghdl_rv32: Option<GhdlRv32Adapter>
    trace32: Option<Trace32Adapter>
    manager: Option<RemoteExecutionManager>
    connected: bool
    blocked_reason: text

    static fn make(mode_spec: text) -> RemoteExec:
        val backend = remote_exec_backend_for(mode_spec)
        var out = RemoteExec(
            spec: mode_spec,
            backend: backend,
            arch: Architecture.RiscV32,
            memory_map: MemoryMap.qemu_rv32(),
            qemu_rv32: nil,
            openocd_stm32h7: nil,
            ghdl_rv32: nil,
            trace32: nil,
            manager: nil,
            connected: false,
            blocked_reason: ""
        )
        if backend == "qemu_rv32":
            out.arch = Architecture.RiscV32
            out.memory_map = MemoryMap.qemu_rv32()
            out.qemu_rv32 = Some(QemuRv32Adapter.new())
        elif backend == "ghdl_rv32":
            out.arch = Architecture.RiscV32
            out.memory_map = MemoryMap.ghdl_rv32()
            out.ghdl_rv32 = Some(GhdlRv32Adapter.new())
        elif backend == "openocd_stm32h7":
            out.arch = Architecture.Arm32
            out.memory_map = MemoryMap.stm32h7()
            out.openocd_stm32h7 = Some(Stm32H7Adapter.new())
        elif backend == "trace32_stm32h7":
            out.arch = Architecture.Arm32
            out.memory_map = MemoryMap.stm32h7()
            out.trace32 = Some(Trace32Adapter.for_stm32h7())
        elif backend == "trace32_stm32wb":
            out.arch = Architecture.Arm32
            out.memory_map = MemoryMap.stm32wb()
            out.trace32 = Some(Trace32Adapter.for_stm32wb())
        out

    # ------------------------------------------------------------------
    # Per-backend dispatch helpers — composition over the four existing
    # adapters (no shared trait on them, no inheritance here either).
    # ------------------------------------------------------------------

    fn backend_capability_report() -> CapabilityReport:
        if self.backend == "qemu_rv32":
            match self.qemu_rv32:
                Some(a): return a.capability_report()
                nil: pass_dn
        if self.backend == "ghdl_rv32":
            match self.ghdl_rv32:
                Some(a): return a.capability_report()
                nil: pass_dn
        if self.backend == "openocd_stm32h7":
            match self.openocd_stm32h7:
                Some(a): return a.capability_report()
                nil: pass_dn
        if self.backend == "trace32_stm32h7" or self.backend == "trace32_stm32wb":
            match self.trace32:
                Some(a): return a.capability_report()
                nil: pass_dn
        CapabilityReport.skip_tool(self.backend, "no adapter wired for mode spec: {self.spec}")

    me backend_connect() -> Result<text, text>:
        # NOTE: adapters are class VALUES stored in an Option field — a `me`
        # method called on the value extracted by `match` mutates only that
        # local copy, so every call below writes the mutated adapter BACK
        # into self.<field> (same "extract, mutate, write back" pattern
        # session_manager.spl uses for KernelSession/ExecutorCacheEntry).
        if self.backend == "qemu_rv32":
            match self.qemu_rv32:
                Some(a):
                    var adapter = a
                    val result = adapter.connect()
                    self.qemu_rv32 = Some(adapter)
                    return result
                nil: return Err("qemu_rv32 adapter not initialized")
        if self.backend == "ghdl_rv32":
            match self.ghdl_rv32:
                Some(a):
                    var adapter = a
                    val result = adapter.connect()
                    self.ghdl_rv32 = Some(adapter)
                    return result
                nil: return Err("ghdl_rv32 adapter not initialized")
        if self.backend == "openocd_stm32h7":
            match self.openocd_stm32h7:
                Some(a):
                    var adapter = a
                    val result = adapter.connect()
                    self.openocd_stm32h7 = Some(adapter)
                    return result
                nil: return Err("openocd_stm32h7 adapter not initialized")
        if self.backend == "trace32_stm32h7" or self.backend == "trace32_stm32wb":
            match self.trace32:
                Some(a):
                    var adapter = a
                    val result = adapter.connect()
                    self.trace32 = Some(adapter)
                    return result
                nil: return Err("trace32 adapter not initialized")
        Err("RemoteExec: no adapter wired for mode spec: {self.spec}")

    me backend_disconnect():
        if self.backend == "qemu_rv32":
            match self.qemu_rv32:
                Some(a):
                    var adapter = a
                    adapter.disconnect()
                    self.qemu_rv32 = Some(adapter)
                nil: pass_dn
        elif self.backend == "ghdl_rv32":
            match self.ghdl_rv32:
                Some(a):
                    var adapter = a
                    adapter.disconnect()
                    self.ghdl_rv32 = Some(adapter)
                nil: pass_dn
        elif self.backend == "openocd_stm32h7":
            match self.openocd_stm32h7:
                Some(a):
                    var adapter = a
                    adapter.disconnect()
                    self.openocd_stm32h7 = Some(adapter)
                nil: pass_dn
        elif self.backend == "trace32_stm32h7" or self.backend == "trace32_stm32wb":
            match self.trace32:
                Some(a):
                    var adapter = a
                    adapter.disconnect()
                    self.trace32 = Some(adapter)
                nil: pass_dn

    me backend_create_manager() -> Result<RemoteExecutionManager, text>:
        if self.backend == "qemu_rv32":
            match self.qemu_rv32:
                Some(a):
                    var adapter = a
                    val result = adapter.create_manager()
                    self.qemu_rv32 = Some(adapter)
                    return result
                nil: return Err("qemu_rv32 adapter not initialized")
        if self.backend == "ghdl_rv32":
            match self.ghdl_rv32:
                Some(a):
                    var adapter = a
                    val result = adapter.create_manager()
                    self.ghdl_rv32 = Some(adapter)
                    return result
                nil: return Err("ghdl_rv32 adapter not initialized")
        if self.backend == "openocd_stm32h7":
            match self.openocd_stm32h7:
                Some(a):
                    var adapter = a
                    val result = adapter.create_manager()
                    self.openocd_stm32h7 = Some(adapter)
                    return result
                nil: return Err("openocd_stm32h7 adapter not initialized")
        if self.backend == "trace32_stm32h7" or self.backend == "trace32_stm32wb":
            match self.trace32:
                Some(a):
                    var adapter = a
                    val result = adapter.create_manager()
                    self.trace32 = Some(adapter)
                    return result
                nil: return Err("trace32 adapter not initialized")
        Err("RemoteExec: no adapter wired for mode spec: {self.spec}")

    me establish_session() -> text:
        """Connect + create the RemoteExecutionManager. Returns "" on
        success, else a diagnostic (never panics — design §4.1/§5.3)."""
        val connect_result = self.backend_connect()
        match connect_result:
            Ok(_): pass
            Err(reason):
                return "remote target connect failed: {reason}"
        val manager_result = self.backend_create_manager()
        match manager_result:
            Ok(m):
                self.manager = Some(m)
                self.connected = true
                self.blocked_reason = ""
                return ""
            Err(reason):
                self.backend_disconnect()
                return "remote target session setup failed: {reason}"

impl NotebookExecutor for RemoteExec:
    fn mode_spec() -> text:
        self.spec

    fn probe() -> LaneStatus:
        if self.backend == "":
            return LaneStatus.Skip("no remote-baremetal adapter wired for mode spec: {self.spec}")
        capability_to_lane_status(self.backend_capability_report())

    me start(opts: SessionOpts):
        val _ = opts
        if self.backend == "":
            self.blocked_reason = "no remote-baremetal adapter wired for mode spec: {self.spec}"
            return
        val diag = self.establish_session()
        if diag != "":
            self.blocked_reason = diag

    me execute_cell(code: text, cell_id: text) -> CellResult:
        if self.backend == "":
            return cell_result_error("no remote-baremetal adapter wired for mode spec: {self.spec}", 0)
        if self.blocked_reason != "":
            return cell_result_error("blocked: {self.blocked_reason}", 0)
        if not self.connected:
            val diag = self.establish_session()
            if diag != "":
                self.blocked_reason = diag
                return cell_result_error("blocked: {diag}", 0)

        val start_us = time_now_unix_micros()

        # Cell-delta compile — reuses the SAME compiler_bridge call the test
        # runner's jit(remote(...)) lane uses (test_executor_composite_jit_generic.spl).
        val bytes = match compile_remote_binary(code, self.arch, self.memory_map.code_start):
            case Ok(compiled): compiled
            case Err(reason):
                return cell_result_error("cell compile failed: {reason}", 0)

        val binary = JitBinary(name: cell_id, bytes: bytes, entry_offset: 0, stack_bytes: 0, arch: self.arch)
        match plan_binary_layout(binary, self.memory_map, self.arch):
            case Ok(_): pass
            case Err(reason):
                return cell_result_error("cell layout failed: {reason}", 0)

        val manager = match self.manager:
            Some(m): m
            nil: return cell_result_error("blocked: remote session is not established", 0)

        # Upload + run + collect — the session (and therefore target memory)
        # stays live across this and every subsequent execute_cell() call
        # until reset()/shutdown(); the manager's own bump allocator keeps
        # each cell's code in a fresh region so cells don't clobber each
        # other's uploaded bytes.
        val exec_result = manager.execute_bytes(cell_id, bytes, [])
        val end_us = time_now_unix_micros()
        val duration_ms = (end_us - start_us) / 1000

        match exec_result:
            Ok(exec):
                if exec.is_ok():
                    cell_result_ok("a0={exec.return_value} halt={exec.halt_reason}", [], [], duration_ms)
                else:
                    cell_result_error(exec.error, duration_ms)
            Err(reason):
                cell_result_error("cell execute failed: {reason}", duration_ms)

    me interrupt():
        """§5.3 interrupt contract: cooperative cancel has no channel in this
        synchronous compile/upload/run/collect pipeline (execute_bytes blocks
        until halt or its own 10s timeout), so RemoteExec escalates straight
        to the force path — session teardown with blocked: status — exactly
        the last tier §5.3 describes."""
        if self.connected:
            self.backend_disconnect()
            self.connected = false
            self.manager = nil
        self.blocked_reason = "session interrupted — use %reset to reconnect"

    me reset():
        """%reset (design §3/§4.3): target reset + scaffold reload. A fresh
        connect() is a fresh QEMU/OpenOCD/GHDL/T32 process, so target RAM
        (and therefore any state a cell left behind) is genuinely gone."""
        if self.connected:
            self.backend_disconnect()
        self.connected = false
        self.manager = nil
        self.blocked_reason = ""
        if self.backend == "":
            return
        val diag = self.establish_session()
        if diag != "":
            self.blocked_reason = diag

    me shutdown():
        if self.connected:
            self.backend_disconnect()
        self.connected = false
        self.manager = nil

# ============================================================================
# RemoteExecFactory — one RemoteExec per (session, mode_spec) cache entry.
# ============================================================================

class RemoteExecFactory:
    """Stateless factory — every session's RemoteExec is fresh from
    RemoteExec.make(mode_spec), matching LocalExecFactory's shape."""

impl NotebookExecutorFactory for RemoteExecFactory:
    me create(mode_spec: text) -> NotebookExecutor:
        RemoteExec.make(mode_spec)
