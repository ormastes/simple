use std.tooling.easy_fix.accessor_core.{parse_accessor_classes_lines}
use std.tooling.easy_fix.accessor_rewrite.{rewrite_get_in_line, rewrite_set_in_line}
use std.tooling.easy_fix.types.{EasyFix, Replacement, FixConfidence}
use std.tooling.easy_fix.rules_helpers.{LineContext, line_contexts_from_lines, _text_index_len}

# Field-access short grammar: inside a class that defines a dummy get_*/set_*/is_*
# forwarder, rewrite the class's own `self.`/`me.` accessor calls to direct field
# access — `self.get_x()` -> `self.x`, `self.set_x(v)` -> `self.x = v`. The
# receiver type is statically known (it is the defining class) so this is Safe.
# Reuses the accessor-fix rewrite engine, which already guards expression-context
# and multi-argument setter calls.
fn check_field_access_refactor(source: text, file: text) -> [EasyFix]:
    val lines = source.split("\n")
    check_field_access_refactor_with_view(
        file, lines, line_contexts_from_lines(lines))

fn acc_field_access_is_ident_char(ch: text) -> bool:
    val chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
    chars.contains(ch)

fn acc_field_access_names(line: text) -> [text]:
    var names: [text] = []
    var seen: Dict<text, bool> = {}
    var index = 0
    while index < line.len():
        if line[index:index + 1] != ".":
            index = index + 1
            continue
        val has_long_prefix = index + 5 <= line.len() and (
            line.slice(index + 1, index + 5) == "get_" or
            line.slice(index + 1, index + 5) == "set_")
        val has_short_prefix = index + 4 <= line.len() and
            line.slice(index + 1, index + 4) == "is_"
        if not has_long_prefix and not has_short_prefix:
            index = index + 1
            continue
        var end = index + 1
        while end < line.len() and acc_field_access_is_ident_char(
                line[end:end + 1]):
            end = end + 1
        if end < line.len() and line[end:end + 1] == "(":
            val name = line.slice(index + 1, end)
            if not seen.has(name):
                seen[name] = true
                names.push(name)
        index = end + 1
    names

fn check_field_access_refactor_with_view(
    file: text, lines: [text], contexts: [LineContext]
) -> [EasyFix]:
    var fixes: [EasyFix] = []
    var has_accessor_call = false
    for line in lines:
        if line.contains(".get_") or line.contains(".set_") or line.contains(".is_"):
            has_accessor_call = true
            break
    if not has_accessor_call:
        return fixes
    val classes = parse_accessor_classes_lines(lines)
    for c in classes:
        var real_fields: Dict<text, bool> = {}
        for m in c.methods:
            if m.kind != "" and not m.is_dummy:
                real_fields[m.field] = true
        var kind_by_name: Dict<text, text> = {}
        var field_by_name: Dict<text, text> = {}
        var ambiguous_names: Dict<text, bool> = {}
        for m in c.methods:
            if not m.is_dummy or m.kind == "" or real_fields.has(m.field):
                continue
            if kind_by_name.has(m.name):
                if kind_by_name[m.name] != m.kind or field_by_name[m.name] != m.field:
                    ambiguous_names[m.name] = true
            else:
                kind_by_name[m.name] = m.kind
                field_by_name[m.name] = m.field
        if kind_by_name.len() == 0:
            continue
        var idx = c.start_line
        while idx < c.end_line and idx < lines.len() and idx < contexts.len():
            var line = lines[idx]
            var changed = false
            for name in acc_field_access_names(line):
                if kind_by_name.has(name) and not ambiguous_names.has(name):
                    val kind = kind_by_name[name]
                    val field = field_by_name[name]
                    if kind == "set":
                        var (sl, sn) = rewrite_set_in_line(line, name, field, true)
                        if sn > 0:
                            line = sl
                            changed = true
                    else:
                        var (gl, gn) = rewrite_get_in_line(line, name, field, true)
                        if gn > 0:
                            line = gl
                            changed = true
            if changed:
                val s = contexts[idx].byte_offset
                val e = s + _text_index_len(lines[idx])
                var fix = EasyFix.create(
                    id: "L:short_grammar_field_access:{idx + 1}:1",
                    description: "use field access for dummy get/set accessor",
                    confidence: FixConfidence.Safe
                )
                fix.add_replacement(Replacement.create(
                    file: file,
                    start: s,
                    end: e,
                    line: idx + 1,
                    column: 1,
                    new_text: line
                ))
                fixes.push(fix)
            idx = idx + 1
    fixes
