# Canonical logical path to host-native boundary conversion.
#
# CROSS-PLATFORM IMPACT (read before editing): off Windows every function here
# is the IDENTITY -- it returns its argument byte for byte. That is deliberate
# and load-bearing. A backslash is a LEGAL character in a POSIX filename, so a
# "\\" -> "/" rewrite off Windows silently addresses a DIFFERENT file. This file
# used to run that rewrite unconditionally, before the platform check, so on
# Linux/macOS `/home/a\b.txt` (13 bytes) became `/home/a/b.txt` (13 bytes) --
# the SAME LENGTH, which is why a length-only assertion cannot see it -- on
# every `file_ops` call, every process spawn, rename, move and dir_remove_all.
#
# The platform decision is therefore the FIRST statement of every entry point,
# and the non-Windows branch returns `path` itself with no conversion run.
#
# Apply ONLY to a value already known to be a filesystem path. A URL, a CLI
# switch or a regex also contains "/" and would be mangled.
#
# Record: doc/08_tracking/bug/pr255_host_path_native_corrupts_posix_paths_and_costs_unix_2026-09-02.md

@unsafe(reason: "raw compiled host-platform name ABI", capabilities: [ffi])
extern fn rt_platform_name() -> text

fn _host_is_windows(platform: text) -> bool:
    # Fast exact-match arm for the three names the runtime actually emits, so
    # the common case pays no `.lower()` allocation and no substring scan. The
    # general arm below still admits mingw/msys/cygwin spellings.
    if platform == "windows": return true
    if platform == "linux" or platform == "macos": return false
    val name = platform.lower()
    name.contains("windows") or name.contains("mingw") or name.contains("msys") or name.contains("cygwin")

fn _ascii_drive(value: text) -> bool:
    value.len() == 1 and "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz".contains(value)

pub fn host_path_canonical_for(path: text, platform: text) -> text:
    """Native-form path -> canonical forward-slash form, for an EXPLICIT platform.

    Windows only. Off Windows this is the identity: `\\` is a legal POSIX
    filename character, so rewriting it corrupts real paths.
    """
    if not _host_is_windows(platform): return path
    path.replace("\\", "/")

fn _mingw_drive_to_windows(path: text) -> text:
    # Documented MinGW/MSYS grammar: `/d/foo` -> `d:/foo`.
    #
    # The drive letter is emitted LOWER-CASE, matching the specified conversion
    # `/d/foo/bar` -> `d:\foo\bar`. Windows treats the two cases as equivalent;
    # test fixtures and log comparisons do not, so the spelling is pinned here
    # rather than left to whichever `.upper()`/`.lower()` a caller reaches for.
    #
    # An input that ALREADY carries a drive letter (`C:/tmp`) falls through
    # untouched, so its case is PRESERVED. That case-preserving idempotence is
    # what lets std.platform.to_native_path delegate here without changing its
    # published contract (`to_native_path("C:/tmp/a.txt") == "C:\tmp\a.txt"`).
    #
    # The compact `c/rest` spelling is deliberately ABSENT. It turned ANY
    # relative path whose first segment is a single letter into a drive root
    # (`c/foo` -> `C:\foo`), and this converter is hit by every file operation
    # -- combined with an atomic write that is a data-loss shape. If the
    # language path surface wants that spelling it belongs in `{sys:...}`
    # desugaring, where the input is known to be a system-location template,
    # not in a universal filesystem boundary.
    if path.len() >= 3 and path.starts_with("/") and _ascii_drive(path.slice(1, 2)) and path.slice(2, 3) == "/":
        return path.slice(1, 2).lower() + ":/" + path.slice(3, path.len())
    path

pub fn host_path_native_for(path: text, platform: text) -> text:
    """Canonical path -> native path for an EXPLICIT platform name.

    The test seam: pass `"linux"` to assert the identity contract from a Windows
    host. The platform guard is the first statement, so no conversion whatsoever
    runs before it.
    """
    if not _host_is_windows(platform): return path
    _mingw_drive_to_windows(path.replace("\\", "/")).replace("/", "\\")

fn _host_platform_name() -> text:
    unsafe(capabilities: [ffi]):
        rt_platform_name()

# Cached host-platform decision. Empty = not yet computed; [0] is 1/0.
# `rt_platform_name()` and the name classification run at most once per process.
var _host_windows_flag: [i64] = []

pub fn host_is_windows_host() -> bool:
    """True when the running host wants native (backslash) paths. Computed once."""
    if _host_windows_flag.len() == 0:
        var value = 0
        if _host_is_windows(_host_platform_name()): value = 1
        _host_windows_flag = _host_windows_flag.push(value)
    _host_windows_flag[0] == 1

pub fn host_path_canonical(path: text) -> text:
    """Native-form path -> canonical form on the running host. Identity off Windows."""
    if not host_is_windows_host(): return path
    path.replace("\\", "/")

pub fn host_path_native(path: text) -> text:
    """Canonical path -> native path on the running host. Identity off Windows.

    COST: this sits on every file_ops call and every process spawn, so the Unix
    path must be a branch and a return -- no scan, no allocation, no copy. The
    first statement is the CACHED platform guard, and the non-Windows branch
    returns `path` itself. Re-measured min-of-3, 5,000,000 iterations, JIT lane,
    both variants forced onto the NON-Windows branch: the pre-fix shape
    9,473 ms, a bare call 36 ms, this shape 76 ms -- ~125x off the pre-fix
    shape, ~1.9 us/call down to ~15 ns/call. There is no
    comptime/@cfg mechanism in this language, so a first-statement early return
    is the ceiling -- keep it first.
    """
    if not host_is_windows_host(): return path
    host_path_native_for(path, "windows")
