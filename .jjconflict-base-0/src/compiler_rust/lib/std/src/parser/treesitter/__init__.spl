# Tree-sitter Lexer Module for Simple Language
# Provides Lexer, Token, TokenKind, Span

mod treesitter

pub struct Span:
    start_byte: i64
    end_byte: i64
    start_line: i64
    end_line: i64
    start_column: i64
    end_column: i64

pub enum TokenKind:
    # Keywords
    Fn
    Val
    Var
    Let
    If
    Else
    Elif
    While
    For
    Return
    Match
    Case
    Struct
    Class
    Enum
    Trait
    Impl
    Pub
    Import
    Use
    Mod
    TrueLit
    FalseLit
    Nil
    In
    Not
    And
    Or
    Pass
    Break
    Continue
    # Literals
    Integer
    Float
    StringLit
    Identifier
    # Operators
    Plus
    Minus
    Star
    Slash
    Percent
    Eq
    NotEq
    Lt
    Gt
    LtEq
    GtEq
    Assign
    Arrow
    FatArrow
    Dot
    DoubleDot
    # Delimiters
    LParen
    RParen
    LBrace
    RBrace
    LBracket
    RBracket
    Colon
    Comma
    Semicolon
    Hash
    At
    Backslash
    # Special
    Newline
    Indent
    Dedent
    Eof
    Unknown

pub struct Token:
    kind: TokenKind
    text: text
    span: Span

pub struct Lexer:
    source: text
    pos: i64
    line: i64
    column: i64
    tokens: Vec<Token>

impl Lexer:
    pub static fn new(source: text) -> Lexer:
        return Lexer(source: source, pos: 0, line: 1, column: 1, tokens: [])

    pub me tokenize() -> Result<Vec<Token>, text>:
        while self.pos < self.source.len():
            self.skip_whitespace_except_newline()
            if self.pos >= self.source.len():
                break
            val start_pos = self.pos
            val start_line = self.line
            val start_col = self.column
            val ch = self.source[self.pos]

            var kind = TokenKind.Unknown
            var matched = false

            # Newline
            if ch == '\n':
                kind = TokenKind.Newline
                self.pos = self.pos + 1
                self.line = self.line + 1
                self.column = 1
                matched = true
            # Comment - skip to end of line
            elif ch == '#':
                while self.pos < self.source.len() and self.source[self.pos] != '\n':
                    self.pos = self.pos + 1
                    self.column = self.column + 1
                matched = true
                kind = TokenKind.Hash
            # String literals
            elif ch == '"':
                self.pos = self.pos + 1
                self.column = self.column + 1
                while self.pos < self.source.len() and self.source[self.pos] != '"':
                    if self.source[self.pos] == '\\':
                        self.pos = self.pos + 1
                        self.column = self.column + 1
                    self.pos = self.pos + 1
                    self.column = self.column + 1
                if self.pos < self.source.len():
                    self.pos = self.pos + 1
                    self.column = self.column + 1
                kind = TokenKind.StringLit
                matched = true
            # Numbers
            elif ch >= '0' and ch <= '9':
                var is_float = false
                while self.pos < self.source.len() and self.source[self.pos] >= '0' and self.source[self.pos] <= '9':
                    self.pos = self.pos + 1
                    self.column = self.column + 1
                if self.pos < self.source.len() and self.source[self.pos] == '.':
                    is_float = true
                    self.pos = self.pos + 1
                    self.column = self.column + 1
                    while self.pos < self.source.len() and self.source[self.pos] >= '0' and self.source[self.pos] <= '9':
                        self.pos = self.pos + 1
                        self.column = self.column + 1
                kind = if is_float { TokenKind.Float } else { TokenKind.Integer }
                matched = true
            # Identifiers and keywords
            elif (ch >= 'a' and ch <= 'z') or (ch >= 'A' and ch <= 'Z') or ch == '_':
                while self.pos < self.source.len():
                    val c = self.source[self.pos]
                    if (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_':
                        self.pos = self.pos + 1
                        self.column = self.column + 1
                    else:
                        break
                val word = self.source[start_pos:self.pos]
                kind = self.keyword_or_ident(word)
                matched = true
            # Two-char operators
            elif self.pos + 1 < self.source.len():
                val two = self.source[self.pos:self.pos + 2]
                if two == "==":
                    kind = TokenKind.Eq
                    self.pos = self.pos + 2
                    self.column = self.column + 2
                    matched = true
                elif two == "!=":
                    kind = TokenKind.NotEq
                    self.pos = self.pos + 2
                    self.column = self.column + 2
                    matched = true
                elif two == "<=":
                    kind = TokenKind.LtEq
                    self.pos = self.pos + 2
                    self.column = self.column + 2
                    matched = true
                elif two == ">=":
                    kind = TokenKind.GtEq
                    self.pos = self.pos + 2
                    self.column = self.column + 2
                    matched = true
                elif two == "->":
                    kind = TokenKind.Arrow
                    self.pos = self.pos + 2
                    self.column = self.column + 2
                    matched = true
                elif two == "=>":
                    kind = TokenKind.FatArrow
                    self.pos = self.pos + 2
                    self.column = self.column + 2
                    matched = true
                elif two == "..":
                    kind = TokenKind.DoubleDot
                    self.pos = self.pos + 2
                    self.column = self.column + 2
                    matched = true

            if not matched:
                # Single char operators/delimiters
                match ch:
                    case '+': kind = TokenKind.Plus
                    case '-': kind = TokenKind.Minus
                    case '*': kind = TokenKind.Star
                    case '/': kind = TokenKind.Slash
                    case '%': kind = TokenKind.Percent
                    case '<': kind = TokenKind.Lt
                    case '>': kind = TokenKind.Gt
                    case '=': kind = TokenKind.Assign
                    case '(': kind = TokenKind.LParen
                    case ')': kind = TokenKind.RParen
                    case '{': kind = TokenKind.LBrace
                    case '}': kind = TokenKind.RBrace
                    case '[': kind = TokenKind.LBracket
                    case ']': kind = TokenKind.RBracket
                    case ':': kind = TokenKind.Colon
                    case ',': kind = TokenKind.Comma
                    case ';': kind = TokenKind.Semicolon
                    case '.': kind = TokenKind.Dot
                    case '@': kind = TokenKind.At
                    case '\\': kind = TokenKind.Backslash
                    case _: kind = TokenKind.Unknown
                self.pos = self.pos + 1
                self.column = self.column + 1

            val token_text = self.source[start_pos:self.pos]
            val span = Span(
                start_byte: start_pos,
                end_byte: self.pos,
                start_line: start_line,
                end_line: self.line,
                start_column: start_col,
                end_column: self.column,
            )
            self.tokens.push(Token(kind: kind, text: token_text, span: span))

        # Add EOF
        val eof_span = Span(
            start_byte: self.pos,
            end_byte: self.pos,
            start_line: self.line,
            end_line: self.line,
            start_column: self.column,
            end_column: self.column,
        )
        self.tokens.push(Token(kind: TokenKind.Eof, text: "", span: eof_span))
        return Ok(self.tokens)

    fn keyword_or_ident(self, word: text) -> TokenKind:
        match word:
            case "fn": TokenKind.Fn
            case "val": TokenKind.Val
            case "var": TokenKind.Var
            case "let": TokenKind.Let
            case "if": TokenKind.If
            case "else": TokenKind.Else
            case "elif": TokenKind.Elif
            case "while": TokenKind.While
            case "for": TokenKind.For
            case "return": TokenKind.Return
            case "match": TokenKind.Match
            case "case": TokenKind.Case
            case "struct": TokenKind.Struct
            case "class": TokenKind.Class
            case "enum": TokenKind.Enum
            case "trait": TokenKind.Trait
            case "impl": TokenKind.Impl
            case "pub": TokenKind.Pub
            case "import": TokenKind.Import
            case "use": TokenKind.Use
            case "mod": TokenKind.Mod
            case "true": TokenKind.TrueLit
            case "false": TokenKind.FalseLit
            case "nil": TokenKind.Nil
            case "in": TokenKind.In
            case "not": TokenKind.Not
            case "and": TokenKind.And
            case "or": TokenKind.Or
            case "pass": TokenKind.Pass
            case "break": TokenKind.Break
            case "continue": TokenKind.Continue
            case _: TokenKind.Identifier

    me skip_whitespace_except_newline():
        while self.pos < self.source.len():
            val ch = self.source[self.pos]
            if ch == ' ' or ch == '\t' or ch == '\r':
                self.pos = self.pos + 1
                self.column = self.column + 1
            else:
                break

# Stable handle into a parse tree's node arena.  The generation makes stale
# handles fail closed if the arena representation is ever reused.
pub struct NodeId:
    owner: i64
    index: i64
    generation: i64

var _next_node_arena_owner: i64 = 1

fn next_node_arena_owner() -> i64:
    val owner = _next_node_arena_owner
    _next_node_arena_owner = _next_node_arena_owner + 1
    return owner

# Tree node
pub struct Node:
    kind: text
    text: text
    span_start_byte: i64
    span_end_byte: i64
    span_start_line: i64
    span_end_line: i64
    span_start_column: i64
    span_end_column: i64
    child_start: i64
    child_count_value: i64
    arena_owner: i64
    arena_generation: i64

impl Node:
    pub static fn create(kind: text, source_text: text, span: Span) -> Node:
        return node_with_span(kind, source_text, span)

    pub fn kind(self) -> text:
        return self.kind

    pub fn child_count(self) -> i64:
        return self.child_count_value

# Value-semantic node storage owned by Tree.  Copying an arena creates a logical
# snapshot: handles for nodes present at copy time remain valid in both copies,
# while reset advances only the reset copy's generation.  Callers that intend
# to build a distinct tree must use new() so it receives a distinct owner.
# Nodes are append-only between resets, so ids remain stable for that snapshot.
pub struct NodeArena:
    nodes: [Node]
    child_edges: [NodeId]
    owner: i64
    generation: i64

impl NodeArena:
    pub static fn new() -> NodeArena:
        return NodeArena(nodes: [], child_edges: [], owner: next_node_arena_owner(), generation: 0)

    pub me alloc(node: Node) -> NodeId:
        val id = NodeId(owner: self.owner, index: self.nodes.len(), generation: self.generation)
        var stored = node
        stored.child_start = 0
        stored.child_count_value = 0
        stored.arena_owner = self.owner
        stored.arena_generation = self.generation
        self.nodes.push(stored)
        return id

    pub me alloc_with_children(node: Node, children: [NodeId]) -> NodeId:
        var stored = node
        stored.child_start = self.child_edges.len()
        stored.child_count_value = children.len()
        stored.arena_owner = self.owner
        stored.arena_generation = self.generation
        for child in children:
            self.child_edges.push(child)
        val id = NodeId(owner: self.owner, index: self.nodes.len(), generation: self.generation)
        self.nodes.push(stored)
        return id

    pub fn get(self, id: NodeId) -> Option<Node>:
        if id.owner != self.owner or id.generation != self.generation or id.index < 0 or id.index >= self.nodes.len():
            return None
        return Some(self.nodes[id.index])

    pub fn children(self, node: Node) -> [NodeId]:
        var result: [NodeId] = []
        if node.arena_owner != self.owner or node.arena_generation != self.generation:
            return result
        if node.child_start < 0 or node.child_count_value < 0 or node.child_start + node.child_count_value > self.child_edges.len():
            return result
        var offset = 0
        while offset < node.child_count_value:
            val child = self.child_edges[node.child_start + offset]
            if self.get(child).is_none():
                return result
            offset = offset + 1
        offset = 0
        while offset < node.child_count_value:
            result.push(self.child_edges[node.child_start + offset])
            offset = offset + 1
        return result

    pub me reset():
        self.nodes = []
        self.child_edges = []
        self.generation = self.generation + 1

# Parse tree
pub struct Tree:
    root_id: NodeId
    arena: NodeArena
    source: text
    version: i64

impl Tree:
    pub fn root(self) -> Option<Node>:
        return self.arena.get(self.root_id)

    pub fn get_node(self, id: NodeId) -> Option<Node>:
        return self.arena.get(id)

    pub fn children(self, node: Node) -> [NodeId]:
        return self.arena.children(node)

    pub fn span(self, node: Node) -> Span:
        return Span(
            start_byte: node.span_start_byte,
            end_byte: node.span_end_byte,
            start_line: node.span_start_line,
            end_line: node.span_end_line,
            start_column: node.span_start_column,
            end_column: node.span_end_column,
        )

    pub fn get_text(self, node: Node) -> text:
        return node.text

# Tree-sitter parser
pub struct TreeSitterParser:
    language: text

impl TreeSitterParser:
    pub static fn new(language: text) -> Result<TreeSitterParser, text>:
        return Ok(TreeSitterParser(language: language))

    pub me parse(self, source: text) -> Result<Tree, text>:
        val binary_operator_index = source.find("+")
        val binary_left_text = if binary_operator_index > 0: source.substring(0, binary_operator_index).trim() else: ""
        val binary_right_text = if binary_operator_index > 0: source.substring(binary_operator_index + 1, source.len()).trim() else: ""
        if binary_operator_index > 0 and binary_left_text.to_i64().is_some() and binary_right_text.to_i64().is_some():
            var arena = NodeArena.new()
            val left_start = source.find(binary_left_text)
            val right_start = binary_operator_index + 1 + source.substring(binary_operator_index + 1, source.len()).find(binary_right_text)
            val expression_span = Span(start_byte: 0, end_byte: source.len(), start_line: 1, end_line: 1, start_column: 1, end_column: source.len() + 1)
            val left_span = Span(start_byte: left_start, end_byte: left_start + binary_left_text.len(), start_line: 1, end_line: 1, start_column: left_start + 1, end_column: left_start + binary_left_text.len() + 1)
            val operator_span = Span(start_byte: binary_operator_index, end_byte: binary_operator_index + 1, start_line: 1, end_line: 1, start_column: binary_operator_index + 1, end_column: binary_operator_index + 2)
            val right_span = Span(start_byte: right_start, end_byte: right_start + binary_right_text.len(), start_line: 1, end_line: 1, start_column: right_start + 1, end_column: right_start + binary_right_text.len() + 1)
            val left_id = arena.alloc(node_with_span("integer", binary_left_text, left_span))
            val operator_id = arena.alloc(node_with_span("+", "+", operator_span))
            val right_id = arena.alloc(node_with_span("integer", binary_right_text, right_span))
            val binary_id = arena.alloc_with_children(node_with_span("binary_expression", source, expression_span), [left_id, operator_id, right_id])
            val statement_id = arena.alloc_with_children(node_with_span("expression_statement", source, expression_span), [binary_id])
            val root_id = arena.alloc_with_children(node_with_span("module", source, expression_span), [statement_id])
            return Ok(Tree(root_id: root_id, arena: arena, source: source, version: 0))

        var arena = NodeArena.new()
        var root_children: [NodeId] = []
        var line_start = 0
        var line_number = 1
        var root_end_line = 1
        var root_end_column = 1
        for line in source.split("\n"):
            if line.len() > 0 and line[0] != ' ' and line[0] != '\t':
                val line_end = line_start + line.len()
                val child_span = Span(start_byte: line_start, end_byte: line_end, start_line: line_number, end_line: line_number, start_column: 1, end_column: line.len() + 1)
                root_children.push(arena.alloc(node_with_span(treesitter_top_level_kind(line), line, child_span)))
            root_end_line = line_number
            root_end_column = line.len() + 1
            line_start = line_start + line.len() + 1
            line_number = line_number + 1

        val root_span = Span(start_byte: 0, end_byte: source.len(), start_line: 1, end_line: root_end_line, start_column: 1, end_column: root_end_column)
        val root = node_with_span("module", source, root_span)
        val root_id = arena.alloc_with_children(root, root_children)
        return Ok(Tree(root_id: root_id, arena: arena, source: source, version: 0))

fn node_with_span(kind: text, source_text: text, span: Span) -> Node:
    return Node(
        kind: kind,
        text: source_text,
        span_start_byte: span.start_byte,
        span_end_byte: span.end_byte,
        span_start_line: span.start_line,
        span_end_line: span.end_line,
        span_start_column: span.start_column,
        span_end_column: span.end_column,
        child_start: 0,
        child_count_value: 0,
        arena_owner: -1,
        arena_generation: -1,
    )

fn treesitter_top_level_kind(line: text) -> text:
    if line.starts_with("pub "): return treesitter_top_level_kind(line[4:])
    if line.starts_with("fn "): return "function_def"
    if line.starts_with("val ") or line.starts_with("let "): return "val_statement"
    if line.starts_with("var "): return "var_statement"
    if line == "return" or line.starts_with("return "): return "return_statement"
    if line.starts_with("if "): return "if_statement"
    if line.starts_with("match "): return "match_statement"
    if line.starts_with("for "): return "for_statement"
    if line.starts_with("while "): return "while_statement"
    if line.starts_with("import "): return "import_statement"
    if line.starts_with("use "): return "use_statement"
    if line.starts_with("struct "): return "struct_def"
    if line.starts_with("class "): return "class_def"
    if line.starts_with("enum "): return "enum_def"
    if line.starts_with("trait "): return "trait_def"
    if line.starts_with("impl "): return "impl_def"
    if line.starts_with("#"): return "comment"
    if line == "break": return "break_statement"
    if line == "continue": return "continue_statement"
    if line == "pass": return "pass_statement"
    return "expression_statement"
