# Shared RT declaration migration policy. Kept below frontend and semantics so
# exactly one parser diagnostic owns the warning-to-error transition.

val RT_PROFILE_MIGRATION_EPOCH: i64 = 1

fn rt_implicit_profile_is_error() -> bool:
    RT_PROFILE_MIGRATION_EPOCH >= 2

export RT_PROFILE_MIGRATION_EPOCH, rt_implicit_profile_is_error
