# DiagnosticV1 schema
#
# Data-shape description of DiagnosticV1 (diagnostic_v1.spl), for tooling that
# needs the shape without parsing Simple source. Config/data artifacts in this
# repo are SDN, not JSON/YAML; the JSON renderer (to_json / render_diagnostic_v1_json
# in diagnostic_v1.spl) is the interchange format for actual diagnostic payloads.

diagnostic_v1_schema:
  version: 1
  description: >
    Canonical diagnostic type covering nested/child diagnostics, multi-file
    labels, macro expansion chains, and confidence-scored suggested fixes.
    Additive to (not a replacement for) the thin pure-Simple Diagnostic type.

  enums:
    severity:
      values: [error, warning, note, help, info]
    fix_confidence:
      values: [safe, likely, uncertain]
      meaning:
        safe: "safe to auto-apply (e.g. syntax migration)"
        likely: "likely correct but should be reviewed"
        uncertain: "may change semantics, needs human review"

  structs:
    span:
      fields:
        start: i64
        end: i64
        line: i64
        col: i64

    label_v1:
      fields:
        file: text        # "" means the diagnostic's primary file
        span: span
        message: text
        primary: bool

    fix_replacement:
      fields:
        file: text
        span: span
        new_text: text

    diagnostic_fix:
      fields:
        id: text
        description: text
        replacements: list<fix_replacement>
        confidence: fix_confidence

    macro_frame:
      fields:
        name: text
        span: span
        file: text

    diagnostic_v1:
      fields:
        severity: severity
        code: text                        # required -- stable code, unlike prior types where it is optional
        message: text
        file: text?                       # primary file, nil = no file context
        span: span?                       # primary source location
        labels: list<label_v1>            # each label carries its own file
        notes: list<text>
        help: list<text>                  # list, not a single optional message
        children: list<diagnostic_v1>     # nested/child diagnostics (recursive)
        macro_trace: list<macro_frame>    # expansion chain, outermost-first
        fix: diagnostic_fix?              # suggested machine-applicable fix

  json_rendering:
    format: object
    field_order: [severity, code, message, file, span, labels, notes, help, children, macro_trace, fix]
    null_encoding:
      file: "null when absent"
      span: "null when absent"
      fix: "null when absent"
    recursive: "children render as a JSON array of the same object shape"
    scope: "JSON renderer only -- no LSP/SARIF output in this lane"
