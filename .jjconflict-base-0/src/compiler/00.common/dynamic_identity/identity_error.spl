# The named seal-time rejections of plan §7.5.
#
# Every rejection this module can produce is its OWN variant carrying the
# facts that caused it. There is deliberately no `Other(text)` catch-all: a
# text-only error is unmatchable, so a caller cannot react to a specific
# failure and a spec cannot prove which check fired. §11.6 ("no silent
# fallback") is the same rule one layer up.

enum IdentityError:
    # static constructor count outside tag capacity
    StaticCountOverflow(count: i64, capacity: i64)
    # complete constructor count outside dense-tag capacity
    CompleteCountOverflow(count: i64, capacity: i64)
    # provider-local ID reuse
    ProviderLocalOrdinalReuse(owner_enum: text, provider_module: text, local_ordinal: i64)
    # persistent identity collision (the same tuple contributed twice)
    IdentityCollision(canonical_text: text)
    # mismatched stable-ID tuple and claimed hash
    TupleHashMismatch(canonical_text: text, claimed_hash: text, computed_hash: text)

impl IdentityError:
    # Stable machine-readable code. Used by specs and diagnostics so a rename
    # of the prose message cannot silently change what a test pins.
    fn code() -> text:
        match self:
            case IdentityError.StaticCountOverflow(_, _): "ID-OVF-STATIC"
            case IdentityError.CompleteCountOverflow(_, _): "ID-OVF-COMPLETE"
            case IdentityError.ProviderLocalOrdinalReuse(_, _, _): "ID-REUSE-ORDINAL"
            case IdentityError.IdentityCollision(_): "ID-COLLISION"
            case IdentityError.TupleHashMismatch(_, _, _): "ID-HASH-MISMATCH"

    fn message() -> text:
        match self:
            case IdentityError.StaticCountOverflow(count, capacity):
                "static constructor count " + count.to_text()
                    + " exceeds tag capacity " + capacity.to_text()
            case IdentityError.CompleteCountOverflow(count, capacity):
                "sealed constructor count " + count.to_text()
                    + " exceeds dense-tag capacity " + capacity.to_text()
            case IdentityError.ProviderLocalOrdinalReuse(owner_enum, provider_module, local_ordinal):
                "provider " + provider_module + " reuses local ordinal "
                    + local_ordinal.to_text() + " for owner enum " + owner_enum
            case IdentityError.IdentityCollision(canonical_text):
                "persistent identity collision: " + canonical_text
            case IdentityError.TupleHashMismatch(canonical_text, claimed_hash, computed_hash):
                "claimed identity hash " + claimed_hash + " does not match "
                    + computed_hash + " computed from tuple " + canonical_text

    fn describe() -> text:
        self.code() + ": " + self.message()
