# Dynamic identity package (hardening plan §5.3, §7.1-§7.5, work package A4).
#
# 00.common is the LOW-DEPENDENCY layer: nothing here imports from a
# higher-numbered layer, and nothing here touches the filesystem. The only
# outside dependency is `std.common.crypto.sha256`, for the §7.2 identity hash.
#
# Import the LEAF MODULE from consumers (`use
# compiler.common.dynamic_identity.closure`), not this package -- a leaf-path
# import provably does not load sibling modules, so a component that only needs
# the closure/activation table does not drag the seal machinery into its graph.

export use compiler.common.dynamic_identity.closure.{
    Closure, Linkage, Activation, critical_admits, critical_precondition
}

export use compiler.common.dynamic_identity.persistent_id.{
    PersistentExtensionId, sort_persistent_ids
}

export use compiler.common.dynamic_identity.identity_error.{IdentityError}

export use compiler.common.dynamic_identity.dense_tag_map.{
    TagCapacity, ClaimedVariant, DenseTagMap, claim_of, freeze_universe, dyn_marker,
    dyn_tag, serialized_field_keys, serialize_variant, deserialize_to_dense
}
