# NOTE: intentionally NOT importing lex_pos_get/lex_pos_set/lex_line_get/
# lex_line_set/lex_col_get/lex_col_set here -- those wrap a dead legacy
# `lex_state` slot that CoreLexer.next_token() never writes back to, so they
# read a permanently-stale position (root cause of "unterminated asm { ... }
# block" on real bare-brace asm text, e.g. `asm { nop }`). Use the live
# equivalents below instead. See lexer.spl's "Live position accessors" note.
use compiler.frontend.core.lexer.{lex_token_end_get, lex_live_line_get, lex_live_col_get, lex_force_set_pos}
use compiler.frontend.core.lexer.{lex_source_char_at, lex_source_len, lex_source_slice}
use compiler.core.parser.{par_kind_get, par_text_get, par_line_get, par_col_get, par_errors}
use compiler.core.parser.{parser_advance, parser_expect, parser_error, parser_warn, parser_skip_newlines}
use compiler.core.parser.{parser_parse_type}

# Forward declarations for mutual recursion
use compiler.frontend.core.parser_stmts.{parse_block, parse_if_expr}
use compiler.frontend.core.parser_expr.{parse_expr, parse_not, parse_unary}

fn parse_optional_rationale_args() -> text:
    var msg = ""
    if par_kind_get() == 140:
        parser_advance()
        if par_kind_get() == 3:
            msg = par_text_get()
            parser_advance()
            if par_kind_get() == 160:
                parser_advance()
                if par_kind_get() == 3:
                    val hint = par_text_get()
                    parser_advance()
                    if hint != "":
                        if msg != "":
                            msg = msg + " | " + hint
                        else:
                            msg = hint
        parser_expect(141)
    msg

fn parse_raw_asm_normalize(payload: text) -> text:
    var parts: [text] = []
    for line in payload.split("\n"):
        var trimmed = line.trim()
        while trimmed.ends_with(";") or trimmed.ends_with(","):
            trimmed = trimmed[0:trimmed.len() - 1].trim()
        if trimmed.len() >= 2:
            val first = trimmed[0:1]
            val last = trimmed[trimmed.len() - 1:trimmed.len()]
            if (first == "\"" and last == "\"") or (first == "'" and last == "'"):
                trimmed = trimmed[1:trimmed.len() - 1]
        if trimmed != "":
            parts.push(trimmed)
    parts.join("\n")

fn parse_raw_asm_advance_lexer(start_pos: i64, end_pos: i64):
    var line = lex_live_line_get()
    var col = lex_live_col_get()
    var pos = start_pos
    while pos < end_pos:
        val ch = lex_source_char_at(pos)
        if ch == "\n":
            line = line + 1
            col = 1
        else:
            col = col + 1
        pos = pos + 1
    lex_force_set_pos(end_pos, line, col)

fn parse_raw_braced_payload(kind: text) -> text:
    val content_start = lex_token_end_get()
    val source_len = lex_source_len()
    var pos = content_start
    var depth = 1
    var in_string = false
    var string_quote = ""
    var escaped = false
    while pos < source_len:
        val ch = lex_source_char_at(pos)
        if in_string:
            if escaped:
                escaped = false
            elif ch == "\\":
                escaped = true
            elif ch == string_quote:
                in_string = false
        else:
            if ch == "\"" or ch == "'":
                in_string = true
                string_quote = ch
            elif ch == "{":
                depth = depth + 1
            elif ch == "}":
                depth = depth - 1
                if depth == 0:
                    val payload = lex_source_slice(content_start, pos)
                    parse_raw_asm_advance_lexer(content_start, pos + 1)
                    parser_advance()
                    return payload
        pos = pos + 1
    parser_error("unterminated " + kind + " block (missing closing brace)")
    val payload = lex_source_slice(content_start, source_len)
    parse_raw_asm_advance_lexer(content_start, source_len)
    parser_advance()
    payload

fn parse_raw_asm_braced_payload() -> text:
    parse_raw_asm_normalize(parse_raw_braced_payload("asm"))

fn parse_legacy_parenthesized_asm() -> i64:
    parser_warn("legacy inline asm syntax; use asm { ... }")
    parser_expect(140)
    var asm_lines: [text] = []
    while par_kind_get() == 3:
        asm_lines.push(par_text_get())
        parser_advance()
        if par_kind_get() == 160:
            parser_advance()

    var values: [i64] = []
    var names: [text] = []
    var kinds: [text] = []
    var locations: [text] = []
    var clobbers: [text] = []
    var outputs: [i64] = []
    while par_kind_get() != 141 and par_kind_get() != 190:
        var name = ""
        var directive = par_text_get()
        if directive != "in" and directive != "out" and directive != "inout" and directive != "lateout" and directive != "clobber" and directive != "clobber_abi" and directive != "options":
            name = directive
            parser_advance()
            parser_expect(TOK_ASSIGN)
            directive = par_text_get()
        if directive == "clobber" or directive == "clobber_abi" or directive == "options":
            # These directives do not carry a value operand. The rich AST has
            # no options field yet, matching the prior flat-parser behavior;
            # consume the balanced directive without fabricating a MIR input.
            parser_advance()
            parser_expect(140)
            var directive_depth = 1
            var directive_parts: [text] = []
            while directive_depth > 0 and par_kind_get() != 190:
                if par_kind_get() == 140: directive_depth = directive_depth + 1
                elif par_kind_get() == 141: directive_depth = directive_depth - 1
                if directive_depth > 0: directive_parts.push(par_text_get())
                parser_advance()
            clobbers.push(directive + ":" + directive_parts.join(""))
            if par_kind_get() == 160: parser_advance()
            continue
        if directive != "in" and directive != "out" and directive != "inout" and directive != "lateout":
            parser_error("expected in/out/inout/lateout inline-asm operand")
            while par_kind_get() != 141 and par_kind_get() != 190:
                parser_advance()
            break
        parser_advance()
        parser_expect(140)
        val location = par_text_get()
        parser_advance()
        parser_expect(141)
        val value = parse_expr()
        var output = -1
        if directive == "inout" and par_kind_get() == 168:
            parser_advance()
            output = parse_expr()
        values.push(value)
        names.push(name)
        kinds.push(directive)
        locations.push(location)
        outputs.push(output)
        if par_kind_get() == 160:
            parser_advance()
    parser_expect(141)
    expr_asm_operands(asm_lines.join("\n"), values, names, kinds, locations, outputs, clobbers, 0)
