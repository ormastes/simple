# Proof Checker
#
# Checks the authoritative Lean verification artifact inventory.
# A file only passes when Lean succeeds and the file contains no `sorry`.

use app.io.mod.{file_exists, file_read}
use compiler.tools.verify.lake_runner.{LakeRunner}
use compiler.common.assurance.trust_audit.{audit_lean_axiom_report}
use verification.regenerate as regen

# ============================================================================
# Proof Status
# ============================================================================

enum ProofStatus:
    """Status of a single verification artifact."""
    ModelProven
    Failed
    Skipped
    Pending

impl ProofStatus:
    fn to_text() -> text:
        match self:
            case ModelProven: "model_proven"
            case Failed: "failed"
            case Skipped: "skipped"
            case Pending: "pending"

    fn is_success() -> bool:
        match self:
            case ModelProven: true
            case _: false

# ============================================================================
# Proof Result
# ============================================================================

struct ProofResult:
    """Result of checking a single file."""
    file_path: text
    status: ProofStatus
    sorry_count: i64
    error_message: text
    theorem_count: i64

impl ProofResult:
    fn summary_line() -> text:
        val status_str = self.status.to_text()
        var detail = ""
        if self.sorry_count > 0:
            detail = " ({self.sorry_count} sorry)"
        if self.error_message.len() > 0:
            detail = "{detail} - {self.error_message}"
        "[{status_str}] {self.file_path}: {self.theorem_count} theorems{detail}"

# ============================================================================
# Check Result (aggregate)
# ============================================================================

struct CheckResult:
    """Aggregate result of checking the inventory."""
    file_results: [ProofResult]

impl CheckResult:
    fn model_proven_count() -> i64:
        var count = 0
        for r in self.file_results:
            if r.status == ProofStatus.ModelProven:
                count = count + 1
        count

    fn pending_count() -> i64:
        var count = 0
        for r in self.file_results:
            if r.status == ProofStatus.Pending:
                count = count + 1
        count

    fn failure_count() -> i64:
        var count = 0
        for r in self.file_results:
            if r.status == ProofStatus.Failed:
                count = count + 1
        count

    fn skipped_count() -> i64:
        var count = 0
        for r in self.file_results:
            if r.status == ProofStatus.Skipped:
                count = count + 1
        count

    fn total_sorry_count() -> i64:
        var count = 0
        for r in self.file_results:
            count = count + r.sorry_count
        count

    fn total_theorem_count() -> i64:
        var count = 0
        for r in self.file_results:
            count = count + r.theorem_count
        count

    fn summary() -> text:
        val total = self.file_results.len()
        val model_proven = self.model_proven_count()
        val pending = self.pending_count()
        val failed = self.failure_count()
        val skipped = self.skipped_count()
        val theorems = self.total_theorem_count()
        val sorries = self.total_sorry_count()
        var lines: [text] = []
        lines = lines.push("Proof Check Summary")
        lines = lines.push("===================")
        lines = lines.push("Files checked: {total}")
        lines = lines.push("  Model proven: {model_proven}")
        lines = lines.push("  Failed:    {failed}")
        lines = lines.push("  Pending:   {pending}")
        lines = lines.push("  Skipped:   {skipped}")
        lines = lines.push("")
        lines = lines.push("Theorems: {theorems}")
        lines = lines.push("Pending proofs (sorry): {sorries}")
        lines.join("\n")

# ============================================================================
# Inventory
# ============================================================================

fn known_verification_files() -> [text]:
    regen.known_regenerated_files()

# ============================================================================
# Checker Configuration
# ============================================================================

class CheckerConfig:
    project_dir: text
    lean_path: text
    lake_path: text
    timeout_ms: i64

    static fn create() -> CheckerConfig:
        CheckerConfig(
            project_dir: ".",
            lean_path: "lean",
            lake_path: "lake",
            timeout_ms: 30000
        )

    fn with_project_dir(dir: text) -> CheckerConfig:
        CheckerConfig(
            project_dir: dir,
            lean_path: self.lean_path,
            lake_path: self.lake_path,
            timeout_ms: self.timeout_ms
        )

fn is_lean_available() -> bool:
    val config = CheckerConfig.create()
    val runner = LakeRunner.new(config.project_dir)
    runner.is_available()

# ============================================================================
# Proof Checker
# ============================================================================

class ProofChecker:
    """Checks Lean verification artifacts for correctness."""
    config: CheckerConfig
    lake: LakeRunner

    static fn create(config: CheckerConfig = CheckerConfig.create()) -> ProofChecker:
        ProofChecker(
            config: config,
            lake: LakeRunner.new(config.project_dir)
        )

impl ProofChecker:
    fn check_verification_dir() -> CheckResult:
        self.check_files(known_verification_files())

    fn check_files(file_paths: [text]) -> CheckResult:
        var results: [ProofResult] = []
        for file_path in file_paths:
            results = results.push(self.check_file(file_path))
        CheckResult(file_results: results)

    fn check_file(path: text) -> ProofResult:
        if not file_exists(path):
            return ProofResult(
                file_path: path,
                status: ProofStatus.Failed,
                sorry_count: 0,
                error_message: "missing file",
                theorem_count: 0
            )

        val content = file_read(path)
        val sorry_count = _count_sorry(content)
        val theorem_count = _count_theorems(content)

        if sorry_count > 0:
            return ProofResult(
                file_path: path,
                status: ProofStatus.Failed,
                sorry_count: sorry_count,
                error_message: "contains sorry",
                theorem_count: theorem_count
            )

        if not self.lake.is_available():
            return ProofResult(
                file_path: path,
                status: ProofStatus.Failed,
                sorry_count: sorry_count,
                error_message: "Lean 4 / Lake not available",
                theorem_count: theorem_count
            )

        val expected_roots = _extract_axiom_roots(content)
        if expected_roots.is_empty():
            return ProofResult(
                file_path: path,
                status: ProofStatus.Failed,
                sorry_count: sorry_count,
                error_message: "missing explicit #print axioms proof roots",
                theorem_count: theorem_count)
        val declared_theorems = _extract_declared_theorem_names(content)
        for theorem_name in declared_theorems:
            var covered = false
            for root in expected_roots:
                if root == theorem_name or root.ends_with("." + theorem_name):
                    covered = true
            if not covered:
                return ProofResult(
                    file_path: path,
                    status: ProofStatus.Failed,
                    sorry_count: sorry_count,
                    error_message: "missing transitive axiom root for theorem " + theorem_name,
                    theorem_count: theorem_count)

        match self.lake.check_file(path):
            case Ok(output):
                val audit = audit_lean_axiom_report(output, expected_roots, [])
                if not audit.permits_closed_verification():
                    return ProofResult(
                        file_path: path,
                        status: ProofStatus.Failed,
                        sorry_count: sorry_count,
                        error_message: "transitive axiom audit failed: " + audit.reason,
                        theorem_count: theorem_count)
                ProofResult(
                    file_path: path,
                    status: ProofStatus.ModelProven,
                    sorry_count: sorry_count,
                    error_message: "",
                    theorem_count: theorem_count
                )
            case Err(msg):
                ProofResult(
                    file_path: path,
                    status: ProofStatus.Failed,
                    sorry_count: sorry_count,
                    error_message: msg,
                    theorem_count: theorem_count
                )

    fn summary() -> text:
        self.check_verification_dir().summary()

# ============================================================================
# Helpers
# ============================================================================

# Characters that may appear in a Lean identifier. A `sorry`/`admit` match is
# only a real proof hole when it is NOT surrounded by these (so `sorryless`,
# `sorryAx`, `my_sorry` do not count).
val _LEAN_IDENT_CHARS = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_'"

fn _extract_axiom_roots(content: text) -> [text]:
    val code = _lean_code_chars(content).join("")
    val prefix = "#print axioms "
    var roots: [text] = []
    for line in code.lines():
        val trimmed = line.trim()
        if trimmed.starts_with(prefix):
            val root = trimmed.substring(prefix.len()).trim()
            if root != "" and not roots.contains(root): roots.push(root)
    roots

fn _extract_declared_theorem_names(content: text) -> [text]:
    val code = _lean_code_chars(content).join("")
    var names: [text] = []
    for line in code.lines():
        val trimmed = line.trim()
        var rest = ""
        if trimmed.starts_with("theorem "):
            rest = trimmed.substring(8).trim()
        elif trimmed.starts_with("lemma "):
            rest = trimmed.substring(6).trim()
        if rest != "":
            var name = ""
            for char in rest.chars():
                if _is_lean_ident_char(char) or char == ".":
                    name = name + char
                else:
                    break
            if name != "" and not names.contains(name): names.push(name)
    names

fn _is_lean_ident_char(c: text) -> bool:
    c != "" and _LEAN_IDENT_CHARS.contains(c)

# Return content as a char array with Lean comments (line `--`, nested block
# `/- ... -/`) and string-literal bodies blanked to spaces, so prose mentions
# of `sorry`/`admit` are never counted as proof holes.
fn _lean_code_chars(content: text) -> [text]:
    var chars = content.chars()
    val n = chars.len()
    var i = 0
    var block_depth = 0
    var in_line_comment = false
    var in_string = false
    while i < n:
        val c = chars[i]
        var next = ""
        if i + 1 < n:
            next = chars[i + 1]
        if in_line_comment:
            if c == "\n":
                in_line_comment = false
            else:
                chars[i] = " "
            i = i + 1
        elif block_depth > 0:
            if c == "/" and next == "-":
                block_depth = block_depth + 1
                chars[i] = " "
                chars[i + 1] = " "
                i = i + 2
            elif c == "-" and next == "/":
                block_depth = block_depth - 1
                chars[i] = " "
                chars[i + 1] = " "
                i = i + 2
            else:
                if c != "\n":
                    chars[i] = " "
                i = i + 1
        elif in_string:
            if c == "\\":
                chars[i] = " "
                if i + 1 < n:
                    chars[i + 1] = " "
                i = i + 2
            elif c == "\"":
                in_string = false
                chars[i] = " "
                i = i + 1
            else:
                if c != "\n":
                    chars[i] = " "
                i = i + 1
        else:
            if c == "-" and next == "-":
                in_line_comment = true
                chars[i] = " "
                chars[i + 1] = " "
                i = i + 2
            elif c == "/" and next == "-":
                block_depth = 1
                chars[i] = " "
                chars[i + 1] = " "
                i = i + 2
            elif c == "\"":
                in_string = true
                chars[i] = " "
                i = i + 1
            else:
                i = i + 1
    chars

# Count standalone-token occurrences of `token` in a char array.
fn _count_token(chars: [text], token: text) -> i64:
    val tchars = token.chars()
    val tlen = tchars.len()
    val n = chars.len()
    var count = 0
    var i = 0
    while i < n:
        var matched = i + tlen <= n
        if matched:
            for j in 0..tlen:
                if chars[i + j] != tchars[j]:
                    matched = false
        if matched and i > 0:
            if _is_lean_ident_char(chars[i - 1]):
                matched = false
        if matched and i + tlen < n:
            if _is_lean_ident_char(chars[i + tlen]):
                matched = false
        if matched:
            count = count + 1
            i = i + tlen
        else:
            i = i + 1
    count

# Count real proof holes: `sorry` / `admit` as standalone tokens outside
# comments and string literals.
fn _count_sorry(content: text) -> i64:
    val chars = _lean_code_chars(content)
    _count_token(chars, "sorry") + _count_token(chars, "admit")

fn _count_theorems(content: text) -> i64:
    var count = 0
    val lines = content.split("\n")
    for line in lines:
        val trimmed = line.trim()
        if trimmed.starts_with("theorem "):
            count = count + 1
    count
