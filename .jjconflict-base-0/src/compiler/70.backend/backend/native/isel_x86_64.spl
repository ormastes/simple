# x86_64 Instruction Selection
#
# Translates MIR instructions to x86_64 MachInst sequences.
# Pattern-matches on MirInstKind to produce low-level machine instructions.
# Follows System V AMD64 ABI for function calls.
#
# Pipeline: MIR -> ISel (this module) -> RegAlloc -> Encode -> ELF

use compiler.mir.mir_data.{MirModule, MirFunction, MirBlock, MirInst, MirInstKind, MirBinOp, MirUnaryOp, MirOperand, MirOperandKind, MirConstValue, MirTerminator, MirType, MirTypeKind, MirStatic, LocalId, LocalKind, BlockId, SwitchCase}
use compiler.mir.intrinsics.{BIT_ROTATE_LEFT, BIT_ROTATE_RIGHT, BIT_POPCOUNT, BIT_BSWAP}
use compiler.backend.native.mach_inst.{MachReg, virtual_reg, physical_reg, reg_id, Operand, OperandKind, op_reg, op_phys, op_virt, op_imm, op_mem, op_label, op_sym, operand_get_reg, MachInst, new_mach_inst, MachBlock, new_mach_block, mach_block_add_inst, MachFunction, new_mach_function, mach_func_add_block, mach_func_set_frame_size, MachModule, DataEntry, new_mach_module, mach_module_add_func, mach_module_add_data, mach_module_add_extern}
use compiler.backend.common.isel_common.{LoweredOperand, ISelFuncResult, ISelBlockResult, ISelInstResult, local_to_vreg, local_vreg_op, isel_fresh_dest, isel_emit_one}
use compiler.backend.native.mach_inst.{X86_RAX, X86_RCX, X86_RDX, X86_RBX, X86_RSP, X86_RBP, X86_RSI, X86_RDI, X86_R8, X86_R9, X86_R10, X86_R11, X86_R12, X86_R13, X86_R14, X86_R15, X86_YMM_ALLOCATABLE}
use compiler.backend.native.mach_inst.{X86_ARG_REGS, X86_ARG_REG_COUNT, X86_CALLEE_SAVED}
use compiler.backend.native.mach_inst.{X86_OP_MOV_REG_REG, X86_OP_MOV_REG_IMM, X86_OP_MOV_REG_MEM, X86_OP_MOV_MEM_REG, X86_OP_ADD, X86_OP_SUB, X86_OP_IMUL, X86_OP_IDIV, X86_OP_AND, X86_OP_OR, X86_OP_XOR, X86_OP_SHL, X86_OP_SAR, X86_OP_SHR, X86_OP_NEG, X86_OP_NOT, X86_OP_BSWAP, X86_OP_POPCNT, X86_OP_CMP, X86_OP_TEST, X86_OP_SETE, X86_OP_SETNE, X86_OP_SETL, X86_OP_SETLE, X86_OP_SETG, X86_OP_SETGE, X86_OP_JMP, X86_OP_JE, X86_OP_JNE, X86_OP_JNZ, X86_OP_JZ, X86_OP_CALL, X86_OP_RET, X86_OP_PUSH, X86_OP_POP, X86_OP_LEA, X86_OP_MOVZX, X86_OP_CQO, X86_OP_NOP, X86_OP_INT3, X86_OP_ADD_IMM, X86_OP_SUB_IMM, X86_OP_CMP_IMM, X86_OP_MOV_REG_IMM32, X86_OP_CALL_INDIRECT, X86_OP_VMOVAPS_LOAD_YMM, X86_OP_VMOVAPS_STORE_YMM, X86_OP_VADDPS_YMM, X86_OP_VSUBPS_YMM, X86_OP_VMULPS_YMM, X86_OP_VDIVPS_YMM}
use compiler.backend.native.mach_inst.{X86_OP_MOVZX_REG_MEM8, X86_OP_MOVZX_REG_MEM16, X86_OP_MOV_REG_MEM32, X86_OP_MOV_MEM8_REG, X86_OP_MOV_MEM16_REG, X86_OP_MOV_MEM32_REG}
use compiler.backend.native.mach_inst.{X86_OP_MOVSX_REG_MEM8, X86_OP_MOVSX_REG_MEM16, X86_OP_MOVSX_REG_MEM32}
use compiler.backend.common.isel_context.{ISelContext, new_isel_context, isel_alloc_vreg, isel_get_vreg, isel_alloc_frame_slot, isel_frame_offset, isel_add_extern, isel_add_string_data, isel_last_string_label}
use compiler.backend.common.ascii_utils.{char_to_ascii}
use compiler.backend.native.native_avx2_capability.{NativeAvx2CapabilityV1, native_avx2_denied_v1}
use compiler.mir_opt.mir_opt.storage_projection_lowering.{MIR_STORAGE_PROJECT_ADDRESS_V1}
use compiler.common.diagnostics.span.{Span}
extern fn rt_enum_discriminant(value: Any) -> i64

# ============================================================================
# Operand Lowering
# ============================================================================

fn lower_operand(ctx: ISelContext, operand: MirOperand) -> LoweredOperand:
    match operand.kind:
        case Copy(local):
            LoweredOperand(insts: [], result: local_vreg_op(local.id), ctx: ctx)
        case Move(local):
            LoweredOperand(insts: [], result: local_vreg_op(local.id), ctx: ctx)
        case Const(const_value, const_type):
            x64_lower_const(ctx, const_value, const_type)

fn x64_lower_const(ctx: ISelContext, value: MirConstValue, type_: MirType) -> LoweredOperand:
    match value:
        case Int(v):
            isel_emit_one(ctx, X86_OP_MOV_REG_IMM, [op_imm(v)])
        case Bool(v):
            val imm_val = if v: 1 else: 0
            isel_emit_one(ctx, X86_OP_MOV_REG_IMM, [op_imm(imm_val)])
        case Str(s):
            var new_ctx = isel_add_string_data(ctx, s, char_to_ascii)
            val label = isel_last_string_label(new_ctx)
            isel_emit_one(new_ctx, X86_OP_LEA, [op_sym(label)])
        case Zero:
            val low = isel_fresh_dest(ctx)
            val inst = new_mach_inst(X86_OP_XOR, [low.result, low.result])
            LoweredOperand(insts: [inst], result: low.result, ctx: low.ctx)
        case _:
            isel_emit_one(ctx, X86_OP_MOV_REG_IMM, [op_imm(0)])

# ============================================================================
# Instruction Selection - Core
# ============================================================================

fn isel_module(module: MirModule) -> MachModule:
    isel_module_with_avx2_capability(module, native_avx2_denied_v1())

fn isel_module_with_avx2_capability(module: MirModule, capability: NativeAvx2CapabilityV1) -> MachModule:
    var mach_module = new_mach_module(module.name)
    var ctx = new_isel_context()

    # Materialize module statics once, before functions.  Stable SymbolId order
    # makes bytes and relocation symbol indices reproducible across Dict seeds.
    var static_ids: [i64] = []
    var static_by_id: Dict<i64, MirStatic> = {}
    for symbol in module.statics.keys():
        static_ids.push(symbol.id)
        static_by_id[symbol.id] = module.statics[symbol]
    static_ids.sort()
    var global_names: Dict<i64, text> = {}
    var global_sizes: Dict<i64, i64> = {}
    var global_signed: Dict<i64, bool> = {}
    var global_mutable: Dict<i64, bool> = {}
    var static_entries: [DataEntry] = []
    for symbol_id in static_ids:
        val static_ = static_by_id[symbol_id]
        if not x86_static_type_supported(static_.type_):
            panic("x86_64 native static '{static_.name}' has unsupported non-scalar object type")
        val size = static_.type_.size_bytes()
        if size != 1 and size != 2 and size != 4 and size != 8:
            panic("x86_64 native static '{static_.name}' has unsupported {size}-byte object representation")
        val natural_align = static_.type_.alignment()
        val align = if static_.alignment > 0: static_.alignment else: natural_align
        if not x86_static_alignment_valid(static_.type_, static_.alignment):
            panic("x86_64 native static '{static_.name}' alignment {align} is invalid for natural alignment {natural_align}")
        val bytes = x86_static_initializer_bytes(static_, size)
        static_entries.push(DataEntry(name: static_.name, data: bytes, is_readonly: not static_.is_mutable, alignment: align, is_global: static_.visibility.is_public()))
        global_names[symbol_id] = static_.name
        global_sizes[symbol_id] = size
        match static_.type_.kind:
            case I8 | I16 | I32: global_signed[symbol_id] = true
            case _: global_signed[symbol_id] = false
        global_mutable[symbol_id] = static_.is_mutable
    ctx = ISelContext(
        next_vreg: ctx.next_vreg, frame_slots: ctx.frame_slots,
        next_frame_offset: ctx.next_frame_offset, extern_symbols: ctx.extern_symbols,
        data_entries: static_entries, string_counter: ctx.string_counter,
        global_names: global_names, global_sizes: global_sizes,
        global_signed: global_signed, global_mutable: global_mutable
    )

    val func_keys = module.functions.keys()
    for key in func_keys:
        val func = module.functions[key]
        var result = isel_function_with_avx2_capability(ctx, func, capability)
        ctx = result.ctx
        mach_module = mach_module_add_func(mach_module, result.func)

    # Add data entries from string constants
    for entry in ctx.data_entries:
        mach_module = mach_module_add_data(mach_module, entry)

    # Add extern symbols
    for sym in ctx.extern_symbols:
        mach_module = mach_module_add_extern(mach_module, sym)

    mach_module

fn x86_static_integer_bytes(value: i64, size: i64) -> [i64]:
    var bytes: [i64] = []
    var remaining = value
    for _ in 0..size:
        var byte = remaining % 256
        if byte < 0: byte = byte + 256
        bytes.push(byte)
        remaining = (remaining - byte) / 256
    bytes

fn x86_is_power_of_two(value: i64) -> bool:
    if value <= 0: return false
    var remaining = value
    while remaining > 1:
        if remaining % 2 != 0: return false
        remaining = remaining / 2
    true

fn x86_static_type_supported(type_: MirType) -> bool:
    match type_.kind:
        case I8 | I16 | I32 | I64 | U8 | U16 | U32 | U64 | Bool | Char | Ptr(_, _) | Ref(_, _) | FuncPtr(_): true
        case _: false

fn x86_static_alignment_valid(type_: MirType, explicit_alignment: i64) -> bool:
    if explicit_alignment < 0: return false
    val natural = type_.alignment()
    val effective = if explicit_alignment > 0: explicit_alignment else: natural
    x86_is_power_of_two(effective) and effective >= natural

fn x86_static_write_admitted(is_mutable: bool, requests_write: bool) -> bool:
    not requests_write or is_mutable

fn x86_static_initializer_bytes(static_: MirStatic, size: i64) -> [i64]:
    if static_.init == nil:
        return x86_static_integer_bytes(0, size)
    val constant = static_.init.unwrap()
    match constant.value:
        case Int(value): x86_static_integer_bytes(value, size)
        case Bool(value): x86_static_integer_bytes(if value: 1 else: 0, size)
        case Zero: x86_static_integer_bytes(0, size)
        case _:
            panic("x86_64 native static '{static_.name}' initializer is not a scalar integer/boolean/zero constant")

fn isel_function(ctx: ISelContext, func: MirFunction) -> ISelFuncResult:
    isel_function_with_avx2_capability(ctx, func, native_avx2_denied_v1())

fn isel_function_with_avx2_capability(ctx: ISelContext, func: MirFunction, capability: NativeAvx2CapabilityV1) -> ISelFuncResult:
    val simd_plan = x86_plan_avx2_f32x8(func)
    if not simd_plan.ok:
        panic("x86_64 SIMD selection rejected: {simd_plan.reason}")
    if simd_plan.registers.len() > 0 and not capability.avx2_admitted:
        panic("x86_64 SIMD selection rejected: {capability.reason}")
    var mach_func = new_mach_function(func.name)

    # Reset vreg counter - use local IDs directly, start high for temps
    var local_ctx = ISelContext(
        next_vreg: func.locals.len() + 100,
        frame_slots: ctx.frame_slots,
        next_frame_offset: 0,
        extern_symbols: ctx.extern_symbols,
        data_entries: ctx.data_entries,
        string_counter: ctx.string_counter,
        global_names: ctx.global_names,
        global_sizes: ctx.global_sizes,
        global_signed: ctx.global_signed,
        global_mutable: ctx.global_mutable
    )

    # Allocate frame slots for locals that need stack space
    for local in func.locals:
        val size = local.type_.size_bytes()
        local_ctx = isel_alloc_frame_slot(local_ctx, local.id.id, size)

    # Generate prologue block
    var prologue_block = new_mach_block("prologue", -1)
    prologue_block = mach_block_add_inst(prologue_block, new_mach_inst(X86_OP_PUSH, [op_phys(X86_RBP)]))
    prologue_block = mach_block_add_inst(prologue_block, new_mach_inst(X86_OP_MOV_REG_REG, [op_phys(X86_RBP), op_phys(X86_RSP)]))
    # Frame size placeholder - will be patched after we know total frame size
    prologue_block = mach_block_add_inst(prologue_block, new_mach_inst(X86_OP_SUB_IMM, [op_phys(X86_RSP), op_imm(0)]))

    # Move arguments from ABI registers to virtual registers
    var arg_idx = 0
    for local in func.locals:
        match local.kind:
            case Arg(index):
                if index < X86_ARG_REG_COUNT:
                    val arg_reg = X86_ARG_REGS[index]
                    prologue_block = mach_block_add_inst(prologue_block, new_mach_inst(X86_OP_MOV_REG_REG, [local_vreg_op(local.id.id), op_phys(arg_reg)]))
                arg_idx = arg_idx + 1
            case _: ()

    mach_func = mach_func_add_block(mach_func, prologue_block)

    var next_trampoline_id = 0
    for block in func.blocks:
        if block.id.id >= next_trampoline_id: next_trampoline_id = block.id.id + 1
    # Translate each MIR block
    for block in func.blocks:
        var trampoline_id = -1
        var trampoline_tag_dest = -1
        var trampoline_target = -1
        match block.terminator:
            case CallTerminator(_, _, _, _, Some(unwind), _, Some(tag_dest)):
                trampoline_id = next_trampoline_id
                next_trampoline_id = next_trampoline_id + 1
                trampoline_tag_dest = tag_dest.id
                trampoline_target = unwind.id
            case _: ()
        var result = isel_block_with_simd(local_ctx, block, simd_plan.registers, trampoline_id)
        local_ctx = result.ctx
        mach_func = mach_func_add_block(mach_func, result.block)
        if trampoline_id >= 0:
            var trampoline = new_mach_block("exc.tag.{block.id.id}", trampoline_id)
            trampoline = mach_block_add_inst(trampoline, new_mach_inst(X86_OP_CALL, [op_sym("rt_exception_caught_type_tag")]))
            trampoline = mach_block_add_inst(trampoline, new_mach_inst(X86_OP_MOV_REG_REG, [local_vreg_op(trampoline_tag_dest), op_phys(X86_RAX)]))
            trampoline = mach_block_add_inst(trampoline, new_mach_inst(X86_OP_JMP, [op_label(trampoline_target)]))
            mach_func = mach_func_add_block(mach_func, trampoline)

    # Set frame size (aligned to 16)
    var frame_size = local_ctx.next_frame_offset
    if frame_size % 16 != 0:
        frame_size = frame_size + (16 - (frame_size % 16))
    mach_func = mach_func_set_frame_size(mach_func, frame_size)

    # Propagate context back
    val out_ctx = ISelContext(
        next_vreg: ctx.next_vreg,
        frame_slots: ctx.frame_slots,
        next_frame_offset: ctx.next_frame_offset,
        extern_symbols: local_ctx.extern_symbols,
        data_entries: local_ctx.data_entries,
        string_counter: local_ctx.string_counter,
        global_names: local_ctx.global_names,
        global_sizes: local_ctx.global_sizes,
        global_signed: local_ctx.global_signed,
        global_mutable: local_ctx.global_mutable
    )

    ISelFuncResult(func: mach_func, ctx: out_ctx)

fn isel_block(ctx: ISelContext, block: MirBlock) -> ISelBlockResult:
    isel_block_with_simd(ctx, block, {}, -1)

fn isel_block_with_simd(ctx: ISelContext, block: MirBlock, simd_regs: Dict<i64, i64>, unwind_trampoline_id: i64) -> ISelBlockResult:
    val label = if block.label.?: block.label.unwrap() else: "bb{block.id.id}"
    var mach_block = new_mach_block(label, block.id.id)
    var current_ctx = ctx

    # Lower instructions
    for inst in block.instructions:
        var result = isel_inst_with_simd(current_ctx, inst, simd_regs)
        current_ctx = result.ctx
        for mi in result.insts:
            mach_block = mach_block_add_inst(mach_block, mi)

    # Lower terminator
    var term_result = isel_terminator(current_ctx, block.terminator, unwind_trampoline_id)
    current_ctx = term_result.ctx
    for mi in term_result.insts:
        mach_block = mach_block_add_inst(mach_block, mi)

    ISelBlockResult(block: mach_block, ctx: current_ctx)

# ============================================================================
# Instruction Selection - Instructions
# ============================================================================

# Lane C7: render a MIR instruction's source span for a loud backend
# diagnostic, or a stable placeholder when the instruction carries none.
fn x86_isel_format_span(span: Span?) -> text:
    if span.?:
        val sp = span.unwrap()
        "{sp.file}:{sp.line}:{sp.col}"
    else:
        "unknown location"

fn x86_unsupported_inst(ctx: ISelContext, variant: text, span: Span?) -> ISelInstResult:
    """NAMED, spanned refusal for a MirInstKind variant x86_64 instruction
    selection cannot lower (lane C7). `E-BACKEND-X86ISEL-INST-<Variant>` is
    stable and greppable. This used to be a shared `case _:` that emitted a NOP,
    i.e. it deleted the instruction and let the program run on regardless."""
    panic("E-BACKEND-X86ISEL-INST-{variant}: x86_64 instruction selection does not lower {variant} at {x86_isel_format_span(span)}")

fn isel_inst(ctx: ISelContext, inst: MirInst) -> ISelInstResult:
    isel_inst_with_simd(ctx, inst, {})

fn isel_inst_with_simd(ctx: ISelContext, inst: MirInst, simd_regs: Dict<i64, i64>) -> ISelInstResult:
    match inst.kind:
        case Const(dest, value, type_):
            isel_const(ctx, dest, value, type_)
        case Copy(dest, src):
            isel_copy(ctx, dest, src)
        case Move(dest, src):
            isel_copy(ctx, dest, src)
        case BinOp(dest, op, left, right):
            isel_binop(ctx, dest, op, left, right)
        case UnaryOp(dest, op, operand):
            isel_unaryop(ctx, dest, op, operand)
        case Load(dest, ptr):
            isel_load(ctx, dest, ptr)
        case Store(ptr, value):
            isel_store(ctx, ptr, value)
        case Call(dest, func_op, args):
            isel_call(ctx, dest, func_op, args)
        case GetField(dest, base, field):
            isel_get_field(ctx, dest, base, field)
        case SetField(base, field, value):
            isel_set_field(ctx, base, field, value)
        case Alloc(dest, type_):
            isel_alloc(ctx, dest, type_)
        case Aggregate(dest, kind, operands):
            isel_aggregate(ctx, dest, operands)
        case Cast(dest, operand, target):
            isel_cast(ctx, dest, operand, target)
        case GetElementPtr(dest, base, indices):
            isel_get_element_ptr(ctx, dest, base, indices)
        case Intrinsic(dest, name, args):
            isel_intrinsic(ctx, dest, name, args)
        case MirSimdLoad(dest, ptr, aligned, vec_type):
            isel_avx2_load(ctx, dest, ptr, aligned, vec_type, simd_regs)
        case MirSimdStore(value, ptr, aligned):
            isel_avx2_store(ctx, value, ptr, aligned, simd_regs)
        case MirSimdBinop(dest, lhs, rhs, op):
            isel_avx2_binop(ctx, dest, lhs, rhs, op, simd_regs)
        case DecisionProbe(_, semantic_id, _, _, _, _):
            panic("x86_64 isel: unlowered DecisionProbe '{semantic_id}' reached instruction selection")
        case ConditionProbe(_, semantic_id, _, _, _, _, _, _):
            panic("x86_64 isel: unlowered ConditionProbe '{semantic_id}' reached instruction selection")
        case Nop:
            ISelInstResult(insts: [new_mach_inst(X86_OP_NOP, [])], ctx: ctx)
        # --------------------------------------------------------------------
        # Lane C7 (backend coverage, hardening plan 2026-08-21 sections
        # 11.3-11.6). EXPLICIT arms for the 105 MirInstKind variants that used to
        # reach the terminal `case _:` below, which emitted a NOP -- the
        # instruction was silently DELETED from the generated machine code and
        # execution ran on with whatever the missing computation never wrote.
        # Each now raises a stable, spanned E-BACKEND-X86ISEL-INST-<Variant>.
        # Universe: spec/compiler_schema/registry/compiler.mir.MirInstKind.sdn
        # Table:    spec/compiler_schema/transitions/mir_inst_to_native_isel.sdn
        # --------------------------------------------------------------------
        case AcquireSnapshot(_, _):
            x86_unsupported_inst(ctx, "AcquireSnapshot", inst.span)
        case Await(_, _):
            x86_unsupported_inst(ctx, "Await", inst.span)
        case Bitcast(_, _, _):
            x86_unsupported_inst(ctx, "Bitcast", inst.span)
        case CallIndirect(_, _, _, _):
            x86_unsupported_inst(ctx, "CallIndirect", inst.span)
        case CheckedBinOp(_, _, _, _):
            x86_unsupported_inst(ctx, "CheckedBinOp", inst.span)
        case CommitUpdates(_, _, _):
            x86_unsupported_inst(ctx, "CommitUpdates", inst.span)
        case Compose(_, _, _, _):
            x86_unsupported_inst(ctx, "Compose", inst.span)
        case CreatePromise(_, _, _):
            x86_unsupported_inst(ctx, "CreatePromise", inst.span)
        case DebugValue(_, _):
            # Deliberate no-op: DebugValue is a MIR-level marker with no machine
            # code. A real NOP encoding is the correct lowering, unlike the
            # blanket wildcard this replaces. Recorded `implemented`.
            ISelInstResult(insts: [new_mach_inst(X86_OP_NOP, [])], ctx: ctx)
        case Drop(_):
            # Deliberate no-op: Drop is a MIR-level marker with no machine
            # code. A real NOP encoding is the correct lowering, unlike the
            # blanket wildcard this replaces. Recorded `implemented`.
            ISelInstResult(insts: [new_mach_inst(X86_OP_NOP, [])], ctx: ctx)
        case FreezeRegion(_):
            x86_unsupported_inst(ctx, "FreezeRegion", inst.span)
        case GpuAtomicCas(_, _, _, _):
            x86_unsupported_inst(ctx, "GpuAtomicCas", inst.span)
        case GpuAtomicOp(_, _, _, _):
            x86_unsupported_inst(ctx, "GpuAtomicOp", inst.span)
        case GpuBarrier(_):
            x86_unsupported_inst(ctx, "GpuBarrier", inst.span)
        case GpuBlockDim(_, _):
            x86_unsupported_inst(ctx, "GpuBlockDim", inst.span)
        case GpuBlockId(_, _):
            x86_unsupported_inst(ctx, "GpuBlockId", inst.span)
        case GpuGlobalId(_, _):
            x86_unsupported_inst(ctx, "GpuGlobalId", inst.span)
        case GpuGridDim(_, _):
            x86_unsupported_inst(ctx, "GpuGridDim", inst.span)
        case GpuKernelDef(_):
            x86_unsupported_inst(ctx, "GpuKernelDef", inst.span)
        case GpuLaunch(_):
            x86_unsupported_inst(ctx, "GpuLaunch", inst.span)
        case GpuLocalId(_, _):
            x86_unsupported_inst(ctx, "GpuLocalId", inst.span)
        case GpuMemFence(_):
            x86_unsupported_inst(ctx, "GpuMemFence", inst.span)
        case GpuSharedAlloc(_, _, _):
            x86_unsupported_inst(ctx, "GpuSharedAlloc", inst.span)
        case HostGpuLaneBegin(_, _):
            x86_unsupported_inst(ctx, "HostGpuLaneBegin", inst.span)
        case HostGpuLaneEnd(_):
            x86_unsupported_inst(ctx, "HostGpuLaneEnd", inst.span)
        case InlineAsm(_, _, _, _, _, _, _):
            x86_unsupported_inst(ctx, "InlineAsm", inst.span)
        case LayerConnect(_, _, _):
            x86_unsupported_inst(ctx, "LayerConnect", inst.span)
        case LoadGlobal(dest, symbol):
            x86_isel_load_global(ctx, dest, symbol.id)
        case GlobalAddr(dest, symbol, mutable):
            x86_isel_global_addr(ctx, dest, symbol.id, mutable)
        case MaskFromCmp(_, _, _, _):
            x86_unsupported_inst(ctx, "MaskFromCmp", inst.span)
        case MaskedAdd(_, _, _, _):
            x86_unsupported_inst(ctx, "MaskedAdd", inst.span)
        case MaskedFma(_, _, _, _, _):
            x86_unsupported_inst(ctx, "MaskedFma", inst.span)
        case MaskedMul(_, _, _, _):
            x86_unsupported_inst(ctx, "MaskedMul", inst.span)
        case MirSimdCmp(_, _, _, _):
            x86_unsupported_inst(ctx, "MirSimdCmp", inst.span)
        case MirSimdGather(_, _, _, _):
            x86_unsupported_inst(ctx, "MirSimdGather", inst.span)
        case MirSimdMaskOp(_, _, _, _):
            x86_unsupported_inst(ctx, "MirSimdMaskOp", inst.span)
        case MirSimdPermute(_, _, _):
            x86_unsupported_inst(ctx, "MirSimdPermute", inst.span)
        case MirSimdReduce(_, _, _):
            x86_unsupported_inst(ctx, "MirSimdReduce", inst.span)
        case MirSimdScalableVsetvl(_, _, _):
            x86_unsupported_inst(ctx, "MirSimdScalableVsetvl", inst.span)
        case MirSimdScatter(_, _, _):
            x86_unsupported_inst(ctx, "MirSimdScatter", inst.span)
        case MirSimdSelect(_, _, _, _):
            x86_unsupported_inst(ctx, "MirSimdSelect", inst.span)
        case MirSimdShuffle(_, _, _, _):
            x86_unsupported_inst(ctx, "MirSimdShuffle", inst.span)
        case MirSimdSplat(_, _, _):
            x86_unsupported_inst(ctx, "MirSimdSplat", inst.span)
        case MirSimdTernop(_, _, _, _, _):
            x86_unsupported_inst(ctx, "MirSimdTernop", inst.span)
        case MirSimdUnop(_, _, _):
            x86_unsupported_inst(ctx, "MirSimdUnop", inst.span)
        case MirWarpActivesMask(_):
            x86_unsupported_inst(ctx, "MirWarpActivesMask", inst.span)
        case MirWarpBallot(_, _, _):
            x86_unsupported_inst(ctx, "MirWarpBallot", inst.span)
        case MirWarpReduce(_, _, _, _):
            x86_unsupported_inst(ctx, "MirWarpReduce", inst.span)
        case MirWarpShfl(_, _, _, _, _):
            x86_unsupported_inst(ctx, "MirWarpShfl", inst.span)
        case MirWarpSync(_):
            x86_unsupported_inst(ctx, "MirWarpSync", inst.span)
        case Parallel(_, _):
            x86_unsupported_inst(ctx, "Parallel", inst.span)
        case PipeForward(_, _, _):
            x86_unsupported_inst(ctx, "PipeForward", inst.span)
        case PredicatedAdd(_, _, _, _, _, _):
            x86_unsupported_inst(ctx, "PredicatedAdd", inst.span)
        case PredicatedFma(_, _, _, _, _, _, _):
            x86_unsupported_inst(ctx, "PredicatedFma", inst.span)
        case PredicatedMul(_, _, _, _, _, _):
            x86_unsupported_inst(ctx, "PredicatedMul", inst.span)
        case Receive(_, _):
            x86_unsupported_inst(ctx, "Receive", inst.span)
        case Ref(_, _, _):
            x86_unsupported_inst(ctx, "Ref", inst.span)
        case ResultMatchSemantic(_, _, _, _, _, _, _):
            # Verification WITNESS, not an executable instruction. The whole
            # Result match -- arm blocks, payload binds, result copies, merge
            # terminator -- is ALREADY emitted before this marker is appended
            # into the merge block (50.mir/_MirLoweringExpr/
            # switch_operators_calls.spl:2848). It exists only so the Lean
            # backend can recover the match shape (lean_mir_translate.spl:280,
            # witness_count) and for perf_facts; verification_region_effects.spl
            # :296 already classes it with Nop. Executable backends must skip
            # it -- rejecting it made every Result-matching module
            # native-unbuildable (E-BACKEND-LLVM-INST-ResultMatchSemantic).
            ()
        case ScalableVecFence(_):
            x86_unsupported_inst(ctx, "ScalableVecFence", inst.span)
        case Send(_, _, _):
            x86_unsupported_inst(ctx, "Send", inst.span)
        case SimdAddF32x4(_, _, _):
            x86_unsupported_inst(ctx, "SimdAddF32x4", inst.span)
        case SimdAddF32x8(_, _, _):
            x86_unsupported_inst(ctx, "SimdAddF32x8", inst.span)
        case SimdAddF64x4(_, _, _):
            x86_unsupported_inst(ctx, "SimdAddF64x4", inst.span)
        case SimdAddI32x4(_, _, _):
            x86_unsupported_inst(ctx, "SimdAddI32x4", inst.span)
        case SimdAddI32x8(_, _, _):
            x86_unsupported_inst(ctx, "SimdAddI32x8", inst.span)
        case SimdAndI32x4(_, _, _):
            x86_unsupported_inst(ctx, "SimdAndI32x4", inst.span)
        case SimdAndI32x8(_, _, _):
            x86_unsupported_inst(ctx, "SimdAndI32x8", inst.span)
        case SimdDivF32x4(_, _, _):
            x86_unsupported_inst(ctx, "SimdDivF32x4", inst.span)
        case SimdDivF32x8(_, _, _):
            x86_unsupported_inst(ctx, "SimdDivF32x8", inst.span)
        case SimdDivF64x4(_, _, _):
            x86_unsupported_inst(ctx, "SimdDivF64x4", inst.span)
        case SimdFmaF32x4(_, _, _, _):
            x86_unsupported_inst(ctx, "SimdFmaF32x4", inst.span)
        case SimdFmaF32x8(_, _, _, _):
            x86_unsupported_inst(ctx, "SimdFmaF32x8", inst.span)
        case SimdFmaF64x4(_, _, _, _):
            x86_unsupported_inst(ctx, "SimdFmaF64x4", inst.span)
        case SimdHaddF32x4(_, _):
            x86_unsupported_inst(ctx, "SimdHaddF32x4", inst.span)
        case SimdHmaxF32x4(_, _):
            x86_unsupported_inst(ctx, "SimdHmaxF32x4", inst.span)
        case SimdHminF32x4(_, _):
            x86_unsupported_inst(ctx, "SimdHminF32x4", inst.span)
        case SimdMulF32x4(_, _, _):
            x86_unsupported_inst(ctx, "SimdMulF32x4", inst.span)
        case SimdMulF32x8(_, _, _):
            x86_unsupported_inst(ctx, "SimdMulF32x8", inst.span)
        case SimdMulF64x4(_, _, _):
            x86_unsupported_inst(ctx, "SimdMulF64x4", inst.span)
        case SimdMulI32x4(_, _, _):
            x86_unsupported_inst(ctx, "SimdMulI32x4", inst.span)
        case SimdMulI32x8(_, _, _):
            x86_unsupported_inst(ctx, "SimdMulI32x8", inst.span)
        case SimdOrI32x4(_, _, _):
            x86_unsupported_inst(ctx, "SimdOrI32x4", inst.span)
        case SimdOrI32x8(_, _, _):
            x86_unsupported_inst(ctx, "SimdOrI32x8", inst.span)
        case SimdShlI32x4(_, _, _):
            x86_unsupported_inst(ctx, "SimdShlI32x4", inst.span)
        case SimdShlI32x8(_, _, _):
            x86_unsupported_inst(ctx, "SimdShlI32x8", inst.span)
        case SimdShrI32x4(_, _, _):
            x86_unsupported_inst(ctx, "SimdShrI32x4", inst.span)
        case SimdShrI32x8(_, _, _):
            x86_unsupported_inst(ctx, "SimdShrI32x8", inst.span)
        case SimdSubF32x4(_, _, _):
            x86_unsupported_inst(ctx, "SimdSubF32x4", inst.span)
        case SimdSubF32x8(_, _, _):
            x86_unsupported_inst(ctx, "SimdSubF32x8", inst.span)
        case SimdSubF64x4(_, _, _):
            x86_unsupported_inst(ctx, "SimdSubF64x4", inst.span)
        case SimdSubI32x4(_, _, _):
            x86_unsupported_inst(ctx, "SimdSubI32x4", inst.span)
        case SimdSubI32x8(_, _, _):
            x86_unsupported_inst(ctx, "SimdSubI32x8", inst.span)
        case SimdXorI32x4(_, _, _):
            x86_unsupported_inst(ctx, "SimdXorI32x4", inst.span)
        case SimdXorI32x8(_, _, _):
            x86_unsupported_inst(ctx, "SimdXorI32x8", inst.span)
        case Spawn(_, _, _):
            x86_unsupported_inst(ctx, "Spawn", inst.span)
        case StoreGlobal(symbol, value):
            x86_isel_store_global(ctx, symbol.id, value)
        case TransferIn(_, _, _, _):
            x86_unsupported_inst(ctx, "TransferIn", inst.span)
        case TransferOut(_, _, _, _, _, _):
            x86_unsupported_inst(ctx, "TransferOut", inst.span)
        case VhdlConcat(_, _):
            x86_unsupported_inst(ctx, "VhdlConcat", inst.span)
        case VhdlPortMap(_, _, _):
            x86_unsupported_inst(ctx, "VhdlPortMap", inst.span)
        case VhdlProcess(_, _):
            x86_unsupported_inst(ctx, "VhdlProcess", inst.span)
        case VhdlResize(_, _, _, _):
            x86_unsupported_inst(ctx, "VhdlResize", inst.span)
        case VhdlSignalAssign(_, _, _):
            x86_unsupported_inst(ctx, "VhdlSignalAssign", inst.span)
        case VhdlSlice(_, _, _, _):
            x86_unsupported_inst(ctx, "VhdlSlice", inst.span)
        case VhdlVarAssign(_, _):
            x86_unsupported_inst(ctx, "VhdlVarAssign", inst.span)
        case Yield(_):
            x86_unsupported_inst(ctx, "Yield", inst.span)
        case _:
            # Not a variant: every MirInstKind now has an arm above, so this is
            # reachable only by a NEW upstream variant with no arm here, or by a
            # mis-decoded enum handle. It used to lower to a silent NOP.
            val unknown_isel_disc = rt_enum_discriminant(inst.kind)
            panic("E-BACKEND-X86ISEL-INST-Unknown: no x86_64 instruction-selection arm for MIR instruction kind (discriminant {unknown_isel_disc}) at {x86_isel_format_span(inst.span)}")

struct X86Avx2FunctionPlanV1:
    ok: bool
    registers: Dict<i64, i64>
    reason: text

fn x86_simd_operand_local(operand: MirOperand) -> i64:
    match operand.kind:
        case Copy(local): local.id
        case Move(local): local.id
        case _: -1

fn x86_plan_avx2_f32x8(func: MirFunction) -> X86Avx2FunctionPlanV1:
    # This first reusable-register contract is deliberately single-block.
    # Reusing registers across CFG joins requires edge-sensitive liveness and
    # phi handling, so multi-block SIMD fails closed instead of guessing.
    if func.blocks.len() != 1:
        return X86Avx2FunctionPlanV1(
            ok: false, registers: {}, reason: "simd-cfg-liveness-unavailable")

    var last_use: Dict<i64, i64> = {}
    var pos = 0
    for inst in func.blocks[0].instructions:
        match inst.kind:
            case Call(_, _, _), CallIndirect(_, _, _, _):
                return X86Avx2FunctionPlanV1(
                    ok: false, registers: {}, reason: "simd-value-across-call-unsupported")
            case MirSimdLoad(dest, _, _, _):
                last_use[dest.id] = pos
            case MirSimdBinop(dest, lhs, rhs, _):
                last_use[dest.id] = pos
                val lhs_id = x86_simd_operand_local(lhs)
                val rhs_id = x86_simd_operand_local(rhs)
                if lhs_id >= 0: last_use[lhs_id] = pos
                if rhs_id >= 0: last_use[rhs_id] = pos
            case MirSimdStore(value, _, _):
                val value_id = x86_simd_operand_local(value)
                if value_id >= 0: last_use[value_id] = pos
            case _:
                ()
        pos = pos + 1

    var registers: Dict<i64, i64> = {}
    var active: Dict<i64, bool> = {}
    var free_regs = [true, true, true, true, true, true, true, true]
    pos = 0
    for inst in func.blocks[0].instructions:
        for local_id in active.keys():
            if active[local_id] and last_use.contains_key(local_id) and last_use[local_id] < pos:
                val reg_index = registers[local_id] - X86_YMM_ALLOCATABLE[0]
                if reg_index >= 0 and reg_index < free_regs.len(): free_regs[reg_index] = true
                active[local_id] = false
        # AVX three-operand operations permit the destination to alias a source.
        # Release sources whose final read is this instruction before choosing
        # the destination, while retaining their stable local->register mapping
        # for instruction lowering below.
        var dying_sources: [i64] = []
        match inst.kind:
            case MirSimdBinop(_, lhs, rhs, _):
                dying_sources.push(x86_simd_operand_local(lhs))
                dying_sources.push(x86_simd_operand_local(rhs))
            case _:
                ()
        for local_id in dying_sources:
            if local_id >= 0 and last_use.contains_key(local_id) and last_use[local_id] == pos:
                if active.contains_key(local_id) and active[local_id] and registers.contains_key(local_id):
                    val reg_index = registers[local_id] - X86_YMM_ALLOCATABLE[0]
                    if reg_index >= 0 and reg_index < free_regs.len(): free_regs[reg_index] = true
                    active[local_id] = false

        var dest_id = -1
        match inst.kind:
            case MirSimdLoad(dest, _, aligned, vec_type):
                if not aligned or vec_type.kind != MirTypeKind.Vec8f:
                    return X86Avx2FunctionPlanV1(ok: false, registers: {}, reason: "requires-aligned-f32x8-load")
                dest_id = dest.id
            case MirSimdBinop(dest, _, _, op):
                if op != "Add" and op != "Sub" and op != "Mul" and op != "Div":
                    return X86Avx2FunctionPlanV1(ok: false, registers: {}, reason: "unsupported-f32x8-operation")
                dest_id = dest.id
            case MirSimdStore(_, _, aligned):
                if not aligned:
                    return X86Avx2FunctionPlanV1(ok: false, registers: {}, reason: "requires-aligned-f32x8-store")
            case MirSimdSplat(_, _, _), MirSimdGather(_, _, _, _), MirSimdScatter(_, _, _), MirSimdTernop(_, _, _, _, _), MirSimdUnop(_, _, _), MirSimdReduce(_, _, _), MirSimdShuffle(_, _, _, _), MirSimdPermute(_, _, _), MirSimdCmp(_, _, _, _), MirSimdSelect(_, _, _, _), MirSimdMaskOp(_, _, _, _):
                return X86Avx2FunctionPlanV1(ok: false, registers: {}, reason: "unsupported-x86-simd-instruction")
            case _: ()
        if dest_id >= 0 and not registers.contains_key(dest_id):
            var free_index = -1
            for index in 0..free_regs.len():
                if free_index < 0 and free_regs[index]: free_index = index
            if free_index < 0:
                return X86Avx2FunctionPlanV1(ok: false, registers: {}, reason: "simd-register-pressure")
            registers[dest_id] = X86_YMM_ALLOCATABLE[free_index]
            free_regs[free_index] = false
            active[dest_id] = true
        pos = pos + 1
    for block in func.blocks:
        for inst in block.instructions:
            match inst.kind:
                case MirSimdBinop(_, lhs, rhs, _):
                    if not registers.contains_key(x86_simd_operand_local(lhs)) or not registers.contains_key(x86_simd_operand_local(rhs)):
                        return X86Avx2FunctionPlanV1(ok: false, registers: {}, reason: "simd-use-before-load")
                case MirSimdStore(value, _, _):
                    if not registers.contains_key(x86_simd_operand_local(value)):
                        return X86Avx2FunctionPlanV1(ok: false, registers: {}, reason: "simd-store-value-unavailable")
                case _: ()
    X86Avx2FunctionPlanV1(ok: true, registers: registers, reason: "avx2-f32x8-planned")

fn isel_avx2_load(ctx: ISelContext, dest: LocalId, ptr: MirOperand, aligned: bool, vec_type: MirType, simd_regs: Dict<i64, i64>) -> ISelInstResult:
    if not aligned or vec_type.kind != MirTypeKind.Vec8f or not simd_regs.contains_key(dest.id):
        panic("x86_64 SIMD load escaped function validation")
    val pointer = lower_operand(ctx, ptr)
    var insts = pointer.insts
    insts.push(new_mach_inst(X86_OP_VMOVAPS_LOAD_YMM, [op_phys(simd_regs[dest.id]), op_mem(operand_get_reg(pointer.result), 0)]))
    ISelInstResult(insts: insts, ctx: pointer.ctx)

fn isel_avx2_store(ctx: ISelContext, value: MirOperand, ptr: MirOperand, aligned: bool, simd_regs: Dict<i64, i64>) -> ISelInstResult:
    val value_id = x86_simd_operand_local(value)
    if not aligned or not simd_regs.contains_key(value_id):
        panic("x86_64 SIMD store escaped function validation")
    val pointer = lower_operand(ctx, ptr)
    var insts = pointer.insts
    insts.push(new_mach_inst(X86_OP_VMOVAPS_STORE_YMM, [op_mem(operand_get_reg(pointer.result), 0), op_phys(simd_regs[value_id])]))
    ISelInstResult(insts: insts, ctx: pointer.ctx)

fn isel_avx2_binop(ctx: ISelContext, dest: LocalId, lhs: MirOperand, rhs: MirOperand, op: text, simd_regs: Dict<i64, i64>) -> ISelInstResult:
    val left_id = x86_simd_operand_local(lhs)
    val right_id = x86_simd_operand_local(rhs)
    if not simd_regs.contains_key(dest.id) or not simd_regs.contains_key(left_id) or not simd_regs.contains_key(right_id):
        panic("x86_64 SIMD binop escaped function validation")
    var opcode = X86_OP_VADDPS_YMM
    if op == "Sub": opcode = X86_OP_VSUBPS_YMM
    elif op == "Mul": opcode = X86_OP_VMULPS_YMM
    elif op == "Div": opcode = X86_OP_VDIVPS_YMM
    elif op != "Add": panic("x86_64 SIMD operation escaped function validation")
    ISelInstResult(insts: [new_mach_inst(opcode, [op_phys(simd_regs[dest.id]), op_phys(simd_regs[left_id]), op_phys(simd_regs[right_id])])], ctx: ctx)

fn isel_const(ctx: ISelContext, dest: LocalId, value: MirConstValue, type_: MirType) -> ISelInstResult:
    val lowered = x64_lower_const(ctx, value, type_)
    val dest_op = local_vreg_op(dest.id)
    # Move the const result to the destination vreg
    var insts = lowered.insts
    insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [dest_op, lowered.result]))
    ISelInstResult(insts: insts, ctx: lowered.ctx)

fn isel_copy(ctx: ISelContext, dest: LocalId, src: LocalId) -> ISelInstResult:
    val inst = new_mach_inst(X86_OP_MOV_REG_REG, [local_vreg_op(dest.id), local_vreg_op(src.id)])
    ISelInstResult(insts: [inst], ctx: ctx)

fn isel_binop(ctx: ISelContext, dest: LocalId, op: MirBinOp, left: MirOperand, right: MirOperand) -> ISelInstResult:
    val left_low = lower_operand(ctx, left)
    val right_low = lower_operand(left_low.ctx, right)
    var current_ctx = right_low.ctx
    val dest_op = local_vreg_op(dest.id)
    var insts: [MachInst] = []
    for ai in left_low.insts:
        insts.push(ai)
    for ai in right_low.insts:
        insts.push(ai)

    match op:
        case Add:
            insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [dest_op, left_low.result]))
            insts.push(new_mach_inst(X86_OP_ADD, [dest_op, right_low.result]))
        case Sub:
            insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [dest_op, left_low.result]))
            insts.push(new_mach_inst(X86_OP_SUB, [dest_op, right_low.result]))
        case Mul:
            insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [dest_op, left_low.result]))
            insts.push(new_mach_inst(X86_OP_IMUL, [dest_op, right_low.result]))
        case Div:
            # idiv uses rax:rdx / operand -> quotient in rax
            insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [op_phys(X86_RAX), left_low.result]))
            insts.push(new_mach_inst(X86_OP_CQO, []))
            insts.push(new_mach_inst(X86_OP_IDIV, [right_low.result]))
            insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [dest_op, op_phys(X86_RAX)]))
        case Rem:
            # idiv uses rax:rdx / operand -> remainder in rdx
            insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [op_phys(X86_RAX), left_low.result]))
            insts.push(new_mach_inst(X86_OP_CQO, []))
            insts.push(new_mach_inst(X86_OP_IDIV, [right_low.result]))
            insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [dest_op, op_phys(X86_RDX)]))
        case BitAnd:
            insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [dest_op, left_low.result]))
            insts.push(new_mach_inst(X86_OP_AND, [dest_op, right_low.result]))
        case BitOr:
            insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [dest_op, left_low.result]))
            insts.push(new_mach_inst(X86_OP_OR, [dest_op, right_low.result]))
        case BitXor:
            insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [dest_op, left_low.result]))
            insts.push(new_mach_inst(X86_OP_XOR, [dest_op, right_low.result]))
        case Shl:
            insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [dest_op, left_low.result]))
            insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [op_phys(X86_RCX), right_low.result]))
            insts.push(new_mach_inst(X86_OP_SHL, [dest_op]))
        case Shr:
            insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [dest_op, left_low.result]))
            insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [op_phys(X86_RCX), right_low.result]))
            insts.push(new_mach_inst(X86_OP_SHR, [dest_op]))
        case Eq:
            for ai in isel_comparison(dest_op, left_low.result, right_low.result, X86_OP_SETE):
                insts.push(ai)
        case Ne:
            for ai in isel_comparison(dest_op, left_low.result, right_low.result, X86_OP_SETNE):
                insts.push(ai)
        case Lt:
            for ai in isel_comparison(dest_op, left_low.result, right_low.result, X86_OP_SETL):
                insts.push(ai)
        case Le:
            for ai in isel_comparison(dest_op, left_low.result, right_low.result, X86_OP_SETLE):
                insts.push(ai)
        case Gt:
            for ai in isel_comparison(dest_op, left_low.result, right_low.result, X86_OP_SETG):
                insts.push(ai)
        case Ge:
            for ai in isel_comparison(dest_op, left_low.result, right_low.result, X86_OP_SETGE):
                insts.push(ai)
        case _:
            # Unsupported binop - zero result
            insts.push(new_mach_inst(X86_OP_XOR, [dest_op, dest_op]))

    ISelInstResult(insts: insts, ctx: current_ctx)

fn isel_comparison(dest: Operand, left: Operand, right: Operand, setcc_op: i64) -> [MachInst]:
    var insts: [MachInst] = []
    insts.push(new_mach_inst(X86_OP_CMP, [left, right]))
    insts.push(new_mach_inst(setcc_op, [dest]))
    insts.push(new_mach_inst(X86_OP_MOVZX, [dest, dest]))
    insts

fn isel_unaryop(ctx: ISelContext, dest: LocalId, op: MirUnaryOp, operand: MirOperand) -> ISelInstResult:
    val low = lower_operand(ctx, operand)
    val dest_op = local_vreg_op(dest.id)
    var insts = low.insts

    match op:
        case Neg:
            insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [dest_op, low.result]))
            insts.push(new_mach_inst(X86_OP_NEG, [dest_op]))
        case Not:
            insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [dest_op, low.result]))
            insts.push(new_mach_inst(X86_OP_NOT, [dest_op]))
        case BitNot:
            insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [dest_op, low.result]))
            insts.push(new_mach_inst(X86_OP_NOT, [dest_op]))
        case _:
            insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [dest_op, low.result]))

    ISelInstResult(insts: insts, ctx: low.ctx)

fn isel_load(ctx: ISelContext, dest: LocalId, ptr: MirOperand) -> ISelInstResult:
    val low = lower_operand(ctx, ptr)
    val dest_op = local_vreg_op(dest.id)
    var insts = low.insts
    insts.push(new_mach_inst(X86_OP_MOV_REG_MEM, [dest_op, op_mem(operand_get_reg(low.result), 0)]))
    ISelInstResult(insts: insts, ctx: low.ctx)

fn x86_global_name(ctx: ISelContext, symbol_id: i64) -> text:
    if not ctx.global_names.contains(symbol_id):
        panic("x86_64 native global references unknown MIR symbol {symbol_id}")
    ctx.global_names[symbol_id]

fn x86_global_width(ctx: ISelContext, symbol_id: i64) -> i64:
    if not ctx.global_sizes.contains(symbol_id):
        panic("x86_64 native global has no storage width for MIR symbol {symbol_id}")
    ctx.global_sizes[symbol_id]

fn x86_global_load_opcode(width: i64, signed: bool) -> i64:
    if width == 1 and signed: return X86_OP_MOVSX_REG_MEM8
    if width == 1 and not signed: return X86_OP_MOVZX_REG_MEM8
    if width == 2 and signed: return X86_OP_MOVSX_REG_MEM16
    if width == 2 and not signed: return X86_OP_MOVZX_REG_MEM16
    if width == 4 and signed: return X86_OP_MOVSX_REG_MEM32
    if width == 4 and not signed: return X86_OP_MOV_REG_MEM32
    if width == 8: return X86_OP_MOV_REG_MEM
    panic("x86_64 native global load has unsupported width {width}")

fn x86_global_store_opcode(width: i64) -> i64:
    if width == 1: return X86_OP_MOV_MEM8_REG
    if width == 2: return X86_OP_MOV_MEM16_REG
    if width == 4: return X86_OP_MOV_MEM32_REG
    if width == 8: return X86_OP_MOV_MEM_REG
    panic("x86_64 native global store has unsupported width {width}")

fn x86_isel_global_addr(ctx: ISelContext, dest: LocalId, symbol_id: i64, mutable: bool) -> ISelInstResult:
    val is_mutable = ctx.global_mutable.contains(symbol_id) and ctx.global_mutable[symbol_id]
    if not x86_static_write_admitted(is_mutable, mutable):
        panic("x86_64 native mutable address requested for immutable global '{x86_global_name(ctx, symbol_id)}'")
    val inst = new_mach_inst(X86_OP_LEA, [local_vreg_op(dest.id), op_sym(x86_global_name(ctx, symbol_id))])
    ISelInstResult(insts: [inst], ctx: ctx)

fn x86_isel_load_global(ctx: ISelContext, dest: LocalId, symbol_id: i64) -> ISelInstResult:
    val signed = if ctx.global_signed.contains(symbol_id): ctx.global_signed[symbol_id] else: false
    val inst = new_mach_inst(x86_global_load_opcode(x86_global_width(ctx, symbol_id), signed), [local_vreg_op(dest.id), op_sym(x86_global_name(ctx, symbol_id))])
    ISelInstResult(insts: [inst], ctx: ctx)

fn x86_isel_store_global(ctx: ISelContext, symbol_id: i64, value: MirOperand) -> ISelInstResult:
    val is_mutable = ctx.global_mutable.contains(symbol_id) and ctx.global_mutable[symbol_id]
    if not x86_static_write_admitted(is_mutable, true):
        panic("x86_64 native store rejected for immutable global '{x86_global_name(ctx, symbol_id)}'")
    val lowered = lower_operand(ctx, value)
    var insts = lowered.insts
    insts.push(new_mach_inst(x86_global_store_opcode(x86_global_width(ctx, symbol_id)), [op_sym(x86_global_name(ctx, symbol_id)), lowered.result]))
    ISelInstResult(insts: insts, ctx: lowered.ctx)

fn isel_store(ctx: ISelContext, ptr: MirOperand, value: MirOperand) -> ISelInstResult:
    val ptr_low = lower_operand(ctx, ptr)
    val val_low = lower_operand(ptr_low.ctx, value)
    var insts = ptr_low.insts
    for ai in val_low.insts:
        insts.push(ai)
    insts.push(new_mach_inst(X86_OP_MOV_MEM_REG, [op_mem(operand_get_reg(ptr_low.result), 0), val_low.result]))
    ISelInstResult(insts: insts, ctx: val_low.ctx)

fn isel_call(ctx: ISelContext, dest: LocalId?, func_op: MirOperand, args: [MirOperand]) -> ISelInstResult:
    var insts: [MachInst] = []
    var current_ctx = ctx

    # Lower arguments into ABI registers
    for i in 0..args.len():
        val arg_low = lower_operand(current_ctx, args[i])
        current_ctx = arg_low.ctx
        for ai in arg_low.insts:
            insts.push(ai)
        if i < X86_ARG_REG_COUNT:
            val arg_reg = X86_ARG_REGS[i]
            insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [op_phys(arg_reg), arg_low.result]))
        else:
            # Stack argument
            insts.push(new_mach_inst(X86_OP_PUSH, [arg_low.result]))

    # Emit call
    match func_op.kind:
        case Const(const_value, _):
            # `mirconstvalue_Str(name)` was written here as a nested pattern.
            # No such symbol exists anywhere in the tree -- and even the
            # correct spelling `MirConstValue.Str(name)` would be wrong in a
            # payload position, because a nested enum sub-pattern always
            # matches and never binds on the native/JIT lanes. Destructure the
            # constant with a second, top-level match.
            match const_value:
                case Str(name):
                    # Direct call to named function
                    current_ctx = isel_add_extern(current_ctx, name)
                    insts.push(new_mach_inst(X86_OP_CALL, [op_sym(name)]))
                case _:
                    # A non-symbol constant callee has no call lowering.
                    # Emitting a NOP here would silently drop the call and
                    # then read whatever stale value rax holds as the result.
                    panic("x86_64 isel: call through non-symbol constant callee has no lowering")
        case Copy(local):
            # Indirect call through register
            insts.push(new_mach_inst(X86_OP_CALL_INDIRECT, [local_vreg_op(local.id)]))
        case Move(local):
            insts.push(new_mach_inst(X86_OP_CALL_INDIRECT, [local_vreg_op(local.id)]))
        case _:
            insts.push(new_mach_inst(X86_OP_NOP, []))

    # Move return value from rax. `dest` is optional (MirInstKind.Call and
    # MirTerminator.CallTerminator both declare `dest: LocalId?`): a void call
    # has no destination, and reading `.id` off a nil dest would write rax into
    # a bogus vreg.
    match dest:
        case Some(d):
            insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [local_vreg_op(d.id), op_phys(X86_RAX)]))
        case None: ()

    # Clean up stack args
    val stack_args = if args.len() > X86_ARG_REG_COUNT: args.len() - X86_ARG_REG_COUNT else: 0
    if stack_args > 0:
        insts.push(new_mach_inst(X86_OP_ADD_IMM, [op_phys(X86_RSP), op_imm(stack_args * 8)]))

    ISelInstResult(insts: insts, ctx: current_ctx)

fn isel_get_field(ctx: ISelContext, dest: LocalId, base: MirOperand, field: i64) -> ISelInstResult:
    val base_low = lower_operand(ctx, base)
    val dest_op = local_vreg_op(dest.id)
    val offset = field * 8
    var insts = base_low.insts
    insts.push(new_mach_inst(X86_OP_MOV_REG_MEM, [dest_op, op_mem(operand_get_reg(base_low.result), offset)]))
    ISelInstResult(insts: insts, ctx: base_low.ctx)

fn isel_set_field(ctx: ISelContext, base: MirOperand, field: i64, value: MirOperand) -> ISelInstResult:
    val base_low = lower_operand(ctx, base)
    val val_low = lower_operand(base_low.ctx, value)
    val offset = field * 8
    var insts = base_low.insts
    for ai in val_low.insts:
        insts.push(ai)
    insts.push(new_mach_inst(X86_OP_MOV_MEM_REG, [op_mem(operand_get_reg(base_low.result), offset), val_low.result]))
    ISelInstResult(insts: insts, ctx: val_low.ctx)

fn isel_alloc(ctx: ISelContext, dest: LocalId, type_: MirType) -> ISelInstResult:
    val size = type_.size_bytes()
    val aligned = if size < 8: 8 else: size
    val dest_op = local_vreg_op(dest.id)
    var insts: [MachInst] = []
    insts.push(new_mach_inst(X86_OP_SUB_IMM, [op_phys(X86_RSP), op_imm(aligned)]))
    insts.push(new_mach_inst(X86_OP_LEA, [dest_op, op_mem(physical_reg(X86_RSP), 0)]))
    ISelInstResult(insts: insts, ctx: ctx)

fn isel_aggregate(ctx: ISelContext, dest: LocalId, operands: [MirOperand]) -> ISelInstResult:
    var insts: [MachInst] = []
    var current_ctx = ctx

    # Calculate total size (each field is 8 bytes)
    val num_fields = operands.len()
    var total_size = (num_fields * 8).max(8)
    # Align to 16 bytes for stack alignment
    if total_size % 16 != 0:
        total_size = total_size + (16 - (total_size % 16))

    # Allocate stack space
    insts.push(new_mach_inst(X86_OP_SUB_IMM, [op_phys(X86_RSP), op_imm(total_size)]))

    # Get base address into destination vreg
    val dest_op = local_vreg_op(dest.id)
    val base_reg = virtual_reg(dest.id)
    insts.push(new_mach_inst(X86_OP_LEA, [dest_op, op_mem(physical_reg(X86_RSP), 0)]))

    # Store each operand at its field offset
    for i in 0..num_fields:
        val op_low = lower_operand(current_ctx, operands[i])
        current_ctx = op_low.ctx
        for ai in op_low.insts:
            insts.push(ai)
        val offset = i * 8
        insts.push(new_mach_inst(X86_OP_MOV_MEM_REG, [op_mem(base_reg, offset), op_low.result]))

    ISelInstResult(insts: insts, ctx: current_ctx)

fn isel_get_element_ptr(ctx: ISelContext, dest: LocalId, base: MirOperand, indices: [MirOperand]) -> ISelInstResult:
    """Compute element address: dest = base + indices[0] * 8."""
    var insts: [MachInst] = []
    var current_ctx = ctx

    # Lower base operand
    val base_low = lower_operand(current_ctx, base)
    current_ctx = base_low.ctx
    for ai in base_low.insts:
        insts.push(ai)

    val dest_op = local_vreg_op(dest.id)

    if indices.len() > 0:
        # Lower index operand
        val idx_low = lower_operand(current_ctx, indices[0])
        current_ctx = idx_low.ctx
        for ai in idx_low.insts:
            insts.push(ai)

        # Allocate temp vreg for scaled index
        current_ctx = isel_alloc_vreg(current_ctx)
        val tmp_vreg = isel_get_vreg(current_ctx)
        val tmp_op = op_reg(virtual_reg(tmp_vreg))

        # tmp = 8 (element size)
        insts.push(new_mach_inst(X86_OP_MOV_REG_IMM, [tmp_op, op_imm(8)]))
        # tmp = tmp * index = 8 * index
        insts.push(new_mach_inst(X86_OP_IMUL, [tmp_op, idx_low.result]))
        # dest = base
        insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [dest_op, base_low.result]))
        # dest = dest + tmp = base + index * 8
        insts.push(new_mach_inst(X86_OP_ADD, [dest_op, tmp_op]))
    else:
        # No indices - just copy base
        insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [dest_op, base_low.result]))

    ISelInstResult(insts: insts, ctx: current_ctx)

fn isel_cast(ctx: ISelContext, dest: LocalId, operand: MirOperand, target: MirType) -> ISelInstResult:
    val low = lower_operand(ctx, operand)
    val dest_op = local_vreg_op(dest.id)
    var insts = low.insts
    # Simple move - truncation/extension handled by encoder based on type
    insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [dest_op, low.result]))
    ISelInstResult(insts: insts, ctx: low.ctx)

fn isel_intrinsic(ctx: ISelContext, dest: LocalId?, name: text, args: [MirOperand]) -> ISelInstResult:
    val supported = (name == BIT_ROTATE_LEFT or name == BIT_ROTATE_RIGHT or
        name == BIT_POPCOUNT or name == BIT_BSWAP or
        name == MIR_STORAGE_PROJECT_ADDRESS_V1)
    if not supported:
        panic("E-BACKEND-X86ISEL-INTRINSIC-Unsupported: x86_64 instruction selection does not lower intrinsic '{name}'")
    if not dest.?:
        panic("E-BACKEND-X86ISEL-INTRINSIC-MissingDest: x86_64 intrinsic '{name}' requires a destination")

    if name == BIT_ROTATE_LEFT:
        return isel_rotate(ctx, dest.unwrap(), args, true)
    if name == BIT_ROTATE_RIGHT:
        return isel_rotate(ctx, dest.unwrap(), args, false)
    if name == BIT_POPCOUNT:
        return isel_popcount(ctx, dest.unwrap(), args)
    if name == BIT_BSWAP:
        return isel_bswap(ctx, dest.unwrap(), args)
    if name == MIR_STORAGE_PROJECT_ADDRESS_V1:
        return isel_storage_project_address_v1(ctx, dest.unwrap(), args)
    panic("E-BACKEND-X86ISEL-INTRINSIC-Unreachable: supported intrinsic '{name}' has no lowering")

fn isel_storage_const_i64(operand: MirOperand) -> i64:
    match operand.kind:
        case Const(MirConstValue.Int(value), _): value
        case _: -1

fn isel_storage_project_address_v1(ctx: ISelContext, dest: LocalId,
                                   args: [MirOperand]) -> ISelInstResult:
    if args.len() != 4:
        panic("x86_64 storage projection requires four arguments")
    val scale = isel_storage_const_i64(args[2])
    val base_offset = isel_storage_const_i64(args[3])
    if scale <= 0 or base_offset < 0:
        panic("x86_64 storage projection requires valid affine constants")
    val base_low = lower_operand(ctx, args[0])
    val index_low = lower_operand(base_low.ctx, args[1])
    var current_ctx = isel_alloc_vreg(index_low.ctx)
    val scaled = op_reg(virtual_reg(isel_get_vreg(current_ctx)))
    val dest_op = local_vreg_op(dest.id)
    var insts = base_low.insts + index_low.insts
    insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [scaled, index_low.result]))
    if scale != 1:
        current_ctx = isel_alloc_vreg(current_ctx)
        val scale_reg = op_reg(virtual_reg(isel_get_vreg(current_ctx)))
        insts.push(new_mach_inst(X86_OP_MOV_REG_IMM, [scale_reg, op_imm(scale)]))
        insts.push(new_mach_inst(X86_OP_IMUL, [scaled, scale_reg]))
    insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [dest_op, base_low.result]))
    insts.push(new_mach_inst(X86_OP_ADD, [dest_op, scaled]))
    if base_offset > 0:
        if base_offset <= 2147483647:
            insts.push(new_mach_inst(X86_OP_ADD_IMM, [dest_op, op_imm(base_offset)]))
        else:
            current_ctx = isel_alloc_vreg(current_ctx)
            val offset_reg = op_reg(virtual_reg(isel_get_vreg(current_ctx)))
            insts.push(new_mach_inst(X86_OP_MOV_REG_IMM, [offset_reg, op_imm(base_offset)]))
            insts.push(new_mach_inst(X86_OP_ADD, [dest_op, offset_reg]))
    ISelInstResult(insts: insts, ctx: current_ctx)

fn isel_popcount(ctx: ISelContext, dest: LocalId, args: [MirOperand]) -> ISelInstResult:
    if args.len() != 1:
        return ISelInstResult(insts: [new_mach_inst(X86_OP_NOP, [])], ctx: ctx)

    val value_low = lower_operand(ctx, args[0])
    val dest_op = local_vreg_op(dest.id)
    var insts = value_low.insts
    insts.push(new_mach_inst(X86_OP_POPCNT, [dest_op, value_low.result]))
    ISelInstResult(insts: insts, ctx: value_low.ctx)

fn isel_bswap(ctx: ISelContext, dest: LocalId, args: [MirOperand]) -> ISelInstResult:
    if args.len() != 1:
        return ISelInstResult(insts: [new_mach_inst(X86_OP_NOP, [])], ctx: ctx)

    val value_low = lower_operand(ctx, args[0])
    val dest_op = local_vreg_op(dest.id)
    var insts = value_low.insts
    insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [dest_op, value_low.result]))
    insts.push(new_mach_inst(X86_OP_BSWAP, [dest_op]))
    ISelInstResult(insts: insts, ctx: value_low.ctx)

fn isel_rotate(ctx: ISelContext, dest: LocalId, args: [MirOperand], is_left: bool) -> ISelInstResult:
    if args.len() != 2:
        return ISelInstResult(insts: [new_mach_inst(X86_OP_NOP, [])], ctx: ctx)

    val value_low = lower_operand(ctx, args[0])
    val count_low = lower_operand(value_low.ctx, args[1])
    var current_ctx = count_low.ctx
    var insts: [MachInst] = []
    for ai in value_low.insts:
        insts.push(ai)
    for ai in count_low.insts:
        insts.push(ai)

    current_ctx = isel_alloc_vreg(current_ctx)
    val masked_count_vreg = isel_get_vreg(current_ctx)
    val masked_count_op = op_reg(virtual_reg(masked_count_vreg))

    current_ctx = isel_alloc_vreg(current_ctx)
    val value_copy_vreg = isel_get_vreg(current_ctx)
    val value_copy_op = op_reg(virtual_reg(value_copy_vreg))

    current_ctx = isel_alloc_vreg(current_ctx)
    val complement_vreg = isel_get_vreg(current_ctx)
    val complement_op = op_reg(virtual_reg(complement_vreg))

    current_ctx = isel_alloc_vreg(current_ctx)
    val mask_vreg = isel_get_vreg(current_ctx)
    val mask_op = op_reg(virtual_reg(mask_vreg))

    val dest_op = local_vreg_op(dest.id)

    insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [dest_op, value_low.result]))
    insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [masked_count_op, count_low.result]))
    insts.push(new_mach_inst(X86_OP_MOV_REG_IMM, [mask_op, op_imm(63)]))
    insts.push(new_mach_inst(X86_OP_AND, [masked_count_op, mask_op]))
    insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [value_copy_op, value_low.result]))
    insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [op_phys(X86_RCX), masked_count_op]))
    if is_left:
        insts.push(new_mach_inst(X86_OP_SHL, [dest_op]))
    else:
        insts.push(new_mach_inst(X86_OP_SHR, [dest_op]))
    insts.push(new_mach_inst(X86_OP_MOV_REG_IMM, [complement_op, op_imm(64)]))
    insts.push(new_mach_inst(X86_OP_SUB, [complement_op, masked_count_op]))
    insts.push(new_mach_inst(X86_OP_AND, [complement_op, mask_op]))
    insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [op_phys(X86_RCX), complement_op]))
    if is_left:
        insts.push(new_mach_inst(X86_OP_SHR, [value_copy_op]))
    else:
        insts.push(new_mach_inst(X86_OP_SHL, [value_copy_op]))
    insts.push(new_mach_inst(X86_OP_OR, [dest_op, value_copy_op]))

    ISelInstResult(insts: insts, ctx: current_ctx)

# ============================================================================
# Instruction Selection - Terminators
# ============================================================================

fn isel_terminator(ctx: ISelContext, term: MirTerminator, unwind_trampoline_id: i64) -> ISelInstResult:
    match term:
        case Goto(target):
            val inst = new_mach_inst(X86_OP_JMP, [op_label(target.id)])
            ISelInstResult(insts: [inst], ctx: ctx)
        case Ret(value):
            var insts: [MachInst] = []
            match value:
                case Some(v):
                    val low = lower_operand(ctx, v)
                    for ai in low.insts:
                        insts.push(ai)
                    insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [op_phys(X86_RAX), low.result]))
                case None: ()
            # Epilogue
            insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [op_phys(X86_RSP), op_phys(X86_RBP)]))
            insts.push(new_mach_inst(X86_OP_POP, [op_phys(X86_RBP)]))
            insts.push(new_mach_inst(X86_OP_RET, []))
            ISelInstResult(insts: insts, ctx: ctx)
        case If(cond, then_, else_):
            val cond_low = lower_operand(ctx, cond)
            var insts = cond_low.insts
            insts.push(new_mach_inst(X86_OP_TEST, [cond_low.result, cond_low.result]))
            insts.push(new_mach_inst(X86_OP_JNZ, [op_label(then_.id)]))
            insts.push(new_mach_inst(X86_OP_JMP, [op_label(else_.id)]))
            ISelInstResult(insts: insts, ctx: cond_low.ctx)
        case Switch(value, targets, default_target):
            val val_low = lower_operand(ctx, value)
            var insts = val_low.insts
            for target in targets:
                insts.push(new_mach_inst(X86_OP_CMP_IMM, [val_low.result, op_imm(target.value)]))
                insts.push(new_mach_inst(X86_OP_JE, [op_label(target.target.id)]))
            insts.push(new_mach_inst(X86_OP_JMP, [op_label(default_target.id)]))
            ISelInstResult(insts: insts, ctx: val_low.ctx)
        case Unreachable:
            ISelInstResult(insts: [new_mach_inst(X86_OP_NOP, [])], ctx: ctx)
        case Abort(message):
            # Abort must HALT. It previously fell through to the `case _:` NOP
            # below, which lowered an aborting block to nothing at all -- control
            # then ran straight on into whatever block was laid out next, with
            # exactly the corrupt state the abort existed to stop. INT3 traps.
            ISelInstResult(insts: [new_mach_inst(X86_OP_INT3, [])], ctx: ctx)
        case Throw(payload, type_tag):
            val payload_low = lower_operand(ctx, payload)
            val tag_low = lower_operand(payload_low.ctx, type_tag)
            var throw_ctx = isel_add_extern(tag_low.ctx, "rt_exception_throw")
            var insts = payload_low.insts
            for tag_inst in tag_low.insts:
                insts.push(tag_inst)
            insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [op_phys(X86_RDI), payload_low.result]))
            insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [op_phys(X86_RSI), tag_low.result]))
            insts.push(new_mach_inst(X86_OP_CALL, [op_sym("rt_exception_throw")]))
            insts.push(new_mach_inst(X86_OP_INT3, []))
            ISelInstResult(insts: insts, ctx: throw_ctx)
        case Resume(payload, type_tag):
            val payload_low = lower_operand(ctx, payload)
            val tag_low = lower_operand(payload_low.ctx, type_tag)
            var resume_ctx = isel_add_extern(tag_low.ctx, "rt_exception_resume")
            var insts = payload_low.insts
            for tag_inst in tag_low.insts:
                insts.push(tag_inst)
            insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [op_phys(X86_RDI), payload_low.result]))
            insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [op_phys(X86_RSI), tag_low.result]))
            insts.push(new_mach_inst(X86_OP_CALL, [op_sym("rt_exception_resume")]))
            insts.push(new_mach_inst(X86_OP_INT3, []))
            ISelInstResult(insts: insts, ctx: resume_ctx)
        case CallTerminator(dest, func, args, normal, unwind, unwind_payload_dest, unwind_type_tag_dest):
            # Contract (mir_interpreter.spl `case CallTerminator`): perform the
            # call, bind the return value into `dest` when present, then
            # transfer to `normal`. The NOP this used to emit dropped both the
            # call and the edge.
            if unwind.?:
                var unwind_ctx = isel_add_extern(ctx, "rt_exception_frame_push")
                unwind_ctx = isel_add_extern(unwind_ctx, "_setjmp")
                unwind_ctx = isel_add_extern(unwind_ctx, "rt_exception_frame_capture")
                unwind_ctx = isel_add_extern(unwind_ctx, "rt_exception_caught_type_tag")
                unwind_ctx = isel_add_extern(unwind_ctx, "rt_exception_frame_pop")
                unwind_ctx = isel_alloc_vreg(unwind_ctx)
                val frame = op_reg(virtual_reg(isel_get_vreg(unwind_ctx)))
                unwind_ctx = isel_alloc_vreg(unwind_ctx)
                val capture_status = op_reg(virtual_reg(isel_get_vreg(unwind_ctx)))
                var insts: [MachInst] = []
                insts.push(new_mach_inst(X86_OP_CALL, [op_sym("rt_exception_frame_push")]))
                insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [frame, op_phys(X86_RAX)]))
                insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [op_phys(X86_RDI), frame]))
                insts.push(new_mach_inst(X86_OP_CALL, [op_sym("_setjmp")]))
                insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [op_phys(X86_RDI), op_phys(X86_RAX)]))
                # SysV returns the two-word capture as payload/status in
                # RAX/RDX, so no value must survive another call.
                insts.push(new_mach_inst(X86_OP_CALL, [op_sym("rt_exception_frame_capture")]))
                match unwind_payload_dest:
                    case Some(d): insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [local_vreg_op(d.id), op_phys(X86_RAX)]))
                    case None: ()
                insts.push(new_mach_inst(X86_OP_MOV_REG_REG, [capture_status, op_phys(X86_RDX)]))
                insts.push(new_mach_inst(X86_OP_TEST, [capture_status, capture_status]))
                val exceptional_target = if unwind_trampoline_id >= 0: unwind_trampoline_id else: unwind.unwrap().id
                insts.push(new_mach_inst(X86_OP_JNZ, [op_label(exceptional_target)]))
                val call_res = isel_call(unwind_ctx, dest, func, args)
                for call_inst in call_res.insts:
                    insts.push(call_inst)
                insts.push(new_mach_inst(X86_OP_CALL, [op_sym("rt_exception_frame_pop")]))
                insts.push(new_mach_inst(X86_OP_JMP, [op_label(normal.id)]))
                return ISelInstResult(insts: insts, ctx: call_res.ctx)
            val call_res = isel_call(ctx, dest, func, args)
            var insts = call_res.insts
            insts.push(new_mach_inst(X86_OP_JMP, [op_label(normal.id)]))
            ISelInstResult(insts: insts, ctx: call_res.ctx)
        case _:
            # All nine MirTerminator variants are handled above. A NOP here
            # would silently delete a terminator; fail loudly instead.
            panic("x86_64 isel: unhandled MirTerminator variant -- terminator lowered to nothing")

# ============================================================================
# Exports
# ============================================================================
