# src/compiler/60.mir_opt/mir_opt/predicate_promote.spl
#
# Predicate-mode promotion pass: quarantined MaskFromCmp + Masked* fusion
#
# Pattern: src/compiler/60.mir_opt/mir_opt/simd_lowering.spl
# History: Wave I2 fusion prototype; currently quarantined
# Spec:    simd_unified_architecture_detail.md C2 §1 (predication); I2 rollout
#
# The original adjacency matcher removed MaskFromCmp without proving that its
# destination had exactly one use. A later instruction, successor block, or
# terminator could therefore retain an undefined-local use. The public module,
# function, and block adapters are compatibility identities until a shared
# function-wide def-use receipt proves sole use, dominance, type/lane legality,
# Move handling, and source-span preservation.
#
use compiler.mir.mir_data.{MirInst, MirOperand, MirOperandKind, LocalId}
use compiler.mir.mir_instructions.{MirModule, MirFunction, MirBlock}

export run_predicate_promote
export promote_function_predicate, promote_block_predicate
export operand_is_local, try_fuse_binary, try_fuse_ternary

# ============================================================================
# Predicate-mode promotion pass entry point
# ============================================================================

fn run_predicate_promote(module: MirModule) -> MirModule:
    """
    Compatibility identity while predicate-promotion legality is incomplete.
    """
    module

# ============================================================================
# Function-level walk
# ============================================================================

fn promote_function_predicate(func: MirFunction) -> MirFunction:
    """Compatibility identity; a function-wide def-use receipt is not available."""
    func

# ============================================================================
# Block-level walk
# ============================================================================

fn promote_block_predicate(block: MirBlock) -> MirBlock:
    """
    Compatibility identity. Block-local adjacency cannot establish sole use.
    """
    block

fn operand_is_local(op: MirOperand, id: LocalId) -> bool:
    """Compatibility matcher retained for callers; it does not authorize fusion."""
    match op.kind:
        case Copy(local): local.id == id.id
        case Move(local): local.id == id.id
        case _: false

fn try_fuse_binary(
    pending_dest: LocalId?, cmp_kind: text, cmp_a: MirOperand?, cmp_b: MirOperand?,
    mask: MirOperand, dest: LocalId, a: MirOperand, b: MirOperand, op: text
) -> MirInst?:
    """Compatibility API; quarantined until a function-wide legality receipt exists."""
    nil

fn try_fuse_ternary(
    pending_dest: LocalId?, cmp_kind: text, cmp_a: MirOperand?, cmp_b: MirOperand?,
    mask: MirOperand, dest: LocalId, a: MirOperand, b: MirOperand, c: MirOperand
) -> MirInst?:
    """Compatibility API; quarantined until a function-wide legality receipt exists."""
    nil
