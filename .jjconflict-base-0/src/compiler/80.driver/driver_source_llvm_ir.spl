# Compiler-owned source -> HIR -> MIR -> LLVM IR product.
#
# This is intentionally not re-exported by the broad driver facade: only the
# compile CLI adapter should retain the source compiler closure.

use compiler.driver.driver.{compiler_driver_create}
use compiler.driver.driver_compiler_type.{CompilerDriver}
use compiler.driver.driver_phase_gates.{
    driver_streaming_surface_enabled,
    bootstrap_entry_source_index
}
use compiler.common.driver_core_types.{CompileMode, driver_core_compile_options_default}
use compiler.common.mir_target_context.{mir_target_context_from}
use compiler.mir.mir_instructions.{MirModule}
use compiler.frontend.core.ast_coverage_inventory.{compiler_coverage_inventory_reset}
use compiler.backend.backend.backend_types.{CodegenTarget}
use compiler.backend.llvm_target.{
    LlvmTargetConfig,
    llvm_explicit_codegen_target,
    llvm_explicit_target_config
}
use compiler.backend.mir_to_llvm.{MirToLlvm}

pub class CompilerSourceLlvmIrResult:
    module_names: [text]
    module_irs: [text]
    entry_module_name: text
    target_triple: text
    bare_metal: bool
    error: text
    exit_code: i64

    static fn failure(message: text, target_triple: text, bare_metal: bool) -> CompilerSourceLlvmIrResult:
        CompilerSourceLlvmIrResult(
            module_names: [],
            module_irs: [],
            entry_module_name: "",
            target_triple: target_triple,
            bare_metal: bare_metal,
            error: message,
            exit_code: 1)

    static fn success(
        module_names: [text],
        module_irs: [text],
        entry_module_name: text,
        target_triple: text,
        bare_metal: bool
    ) -> CompilerSourceLlvmIrResult:
        CompilerSourceLlvmIrResult(
            module_names: module_names,
            module_irs: module_irs,
            entry_module_name: entry_module_name,
            target_triple: target_triple,
            bare_metal: bare_metal,
            error: "",
            exit_code: 0)

    fn is_success() -> bool:
        self.exit_code == 0 and self.error == "" and
        self.module_names.len() > 0 and
        self.module_names.len() == self.module_irs.len() and
        self.entry_module_name != ""

    fn module_count() -> i64:
        if self.module_names.len() != self.module_irs.len():
            return 0
        self.module_names.len()

fn compiler_source_llvm_phase_error(driver: CompilerDriver, phase: text) -> text:
    val error_count = driver.ctx.error_count_value
    if error_count <= 0:
        return "{phase} failed without a compiler diagnostic"
    var messages: [text] = [""; error_count]
    var index = 0
    while index < error_count:
        messages[index] = driver.ctx.error_message_at(index)
        index = index + 1
    "{phase} failed:\n{messages.join("\n")}"

fn compiler_source_llvm_mir_emits_unit(module: MirModule) -> bool:
    module.functions.len() > 0 or module.statics.len() > 0

pub fn compile_source_to_llvm_ir(
    source_file: text,
    target_triple: text,
    bare_metal: bool
) -> CompilerSourceLlvmIrResult:
    if source_file.trim() == "":
        return CompilerSourceLlvmIrResult.failure(
            "source entry path must not be empty", target_triple.trim(), bare_metal)
    val trimmed_target = target_triple.trim()
    val normalized_target = trimmed_target.lower()

    val codegen_target: CodegenTarget = match llvm_explicit_codegen_target(normalized_target):
        case Ok(value): value
        case Err(message):
            return CompilerSourceLlvmIrResult.failure(
                message, normalized_target, bare_metal)
    val target_config: LlvmTargetConfig = match llvm_explicit_target_config(
        normalized_target, bare_metal):
        case Ok(value): value
        case Err(message):
            return CompilerSourceLlvmIrResult.failure(
                message, normalized_target, bare_metal)
    val target_arch = target_config.triple.arch
    val target_vendor = target_config.triple.vendor
    val target_os = target_config.triple.os
    var target_env = ""
    var target_has_env = false
    match target_config.triple.env:
        Some(value):
            target_env = value
            target_has_env = value != ""
        nil:
            ()
    val target_datalayout = target_config.triple.datalayout()

    var options = driver_core_compile_options_default()
    options.mode = CompileMode.Aot
    options.cli_mode_text = "aot"
    options.input_files = [source_file]
    options.backend = "llvm"
    options.release = false
    options.optimize = false
    options.opt_level = 0
    options.debug_info = false
    options.low_memory = false

    var driver = compiler_driver_create(options)
    driver.ctx.config["compiler_source_entry"] = source_file
    driver.ctx.config["compiler_source_closure"] = "1"
    driver.ctx.config["compiler_explicit_semantic_policy"] = "1"
    val source_streaming_in_place = driver_streaming_surface_enabled(driver.ctx)
    val (loaded_ctx, load_ok) = driver.load_sources_impl()
    if not source_streaming_in_place:
        driver.ctx = loaded_ctx
    if not load_ok:
        return CompilerSourceLlvmIrResult.failure(
            compiler_source_llvm_phase_error(driver, "source loading"),
            normalized_target, bare_metal)

    compiler_coverage_inventory_reset(false, "", "")
    if not driver.parse_all_committing_impl():
        return CompilerSourceLlvmIrResult.failure(
            compiler_source_llvm_phase_error(driver, "parsing"),
            normalized_target, bare_metal)

    val hir_streaming_in_place = driver_streaming_surface_enabled(driver.ctx)
    val (analyzed_ctx, analyze_ok) = driver.lower_and_check_impl()
    if not hir_streaming_in_place:
        driver.ctx = analyzed_ctx
    if not analyze_ok:
        return CompilerSourceLlvmIrResult.failure(
            compiler_source_llvm_phase_error(driver, "HIR lowering/type checking"),
            normalized_target, bare_metal)

    if not driver.monomorphize_for_explicit_compilation(analyze_ok):
        return CompilerSourceLlvmIrResult.failure(
            compiler_source_llvm_phase_error(driver, "monomorphization"),
            normalized_target, bare_metal)

    val mir_target = mir_target_context_from(
        normalized_target, "", "", "llvm", -1)
    if not driver.lower_to_mir_for_explicit_target(mir_target):
        return CompilerSourceLlvmIrResult.failure(
            compiler_source_llvm_phase_error(driver, "MIR lowering"),
            normalized_target, bare_metal)
    if not driver.borrow_check():
        return CompilerSourceLlvmIrResult.failure(
            compiler_source_llvm_phase_error(driver, "borrow checking"),
            normalized_target, bare_metal)

    val _async_state_machines = driver.process_async()
    driver.optimize_mir_level(0)
    driver.weave_aop_for_explicit_compilation()
    driver.apply_debug_trace()
    if driver.ctx.error_count_value > 0:
        return CompilerSourceLlvmIrResult.failure(
            compiler_source_llvm_phase_error(driver, "MIR transforms"),
            normalized_target, bare_metal)

    val source_count = driver.ctx.sources.len()
    if source_count <= 0:
        return CompilerSourceLlvmIrResult.failure(
            "source compilation produced no source modules",
            normalized_target, bare_metal)

    val entry_source_index = bootstrap_entry_source_index(driver.ctx)
    if entry_source_index < 0 or entry_source_index >= source_count:
        return CompilerSourceLlvmIrResult.failure(
            "source compilation lost the requested entry identity",
            normalized_target, bare_metal)
    val entry_module_name = driver.ctx.sources[entry_source_index].module_name

    var unit_count = 0
    var source_index = 0
    while source_index < source_count:
        val source = driver.ctx.sources[source_index]
        if not driver.ctx.mir_modules.has(source.module_name):
            return CompilerSourceLlvmIrResult.failure(
                "LLVM translation missing MIR module '{source.module_name}'",
                normalized_target, bare_metal)
        val mir_module = driver.ctx.mir_modules[source.module_name]
        if source_index == entry_source_index and mir_module.functions.len() == 0:
            return CompilerSourceLlvmIrResult.failure(
                "entry source '{source_file}' produced no MIR functions",
                normalized_target, bare_metal)
        if compiler_source_llvm_mir_emits_unit(mir_module):
            unit_count = unit_count + 1
        source_index = source_index + 1

    if unit_count <= 0:
        return CompilerSourceLlvmIrResult.failure(
            "source compilation produced no translatable MIR units",
            normalized_target, bare_metal)

    # Allocate once and fill by index. A giant concatenated LLVM module is not
    # valid aggregation and repeated array push would recopy the whole bundle.
    var module_names: [text] = [""; unit_count]
    var module_irs: [text] = [""; unit_count]
    val expected_target_header = "target triple = \"{normalized_target}\""
    var unit_index = 0
    source_index = 0
    while source_index < source_count:
        val source = driver.ctx.sources[source_index]
        val mir_module = driver.ctx.mir_modules[source.module_name]
        if compiler_source_llvm_mir_emits_unit(mir_module):
            var translator = MirToLlvm.create_explicit_target(
                source.module_name, codegen_target,
                target_arch, target_vendor, target_os,
                target_env, target_has_env, target_datalayout,
                bare_metal)
            val llvm_ir = translator.translate_module_with_entry(
                mir_module, source_index == entry_source_index)
            if llvm_ir == "" or not llvm_ir.contains(expected_target_header):
                return CompilerSourceLlvmIrResult.failure(
                    "LLVM translation did not preserve target '{normalized_target}' for module '{source.module_name}'",
                    normalized_target, bare_metal)
            if source_index == entry_source_index and not llvm_ir.contains("define "):
                return CompilerSourceLlvmIrResult.failure(
                    "LLVM translation produced no function definition for entry source '{source_file}'",
                    normalized_target, bare_metal)
            module_names[unit_index] = source.module_name
            module_irs[unit_index] = llvm_ir
            unit_index = unit_index + 1
        source_index = source_index + 1

    CompilerSourceLlvmIrResult.success(
        module_names, module_irs, entry_module_name,
        normalized_target, bare_metal)
