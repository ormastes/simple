# RISC-V FPGA board bundle for a GPU target (plan W3.4 board flow)
#
# Backs `bin/simple build --gpu-target=<t> --board=<b>` from plan row W3.4 of
# doc/03_plan/language/gpu_fpga/sycl_parity_unified_kernel_plan_2026-06-13.md.
#
# This is a thin composition over the REAL existing FPGA generators in
# src/lib/hardware/fpga_linux — nothing here invents board data:
#
#   XilinxBoardProfile.from_id  -> real part number / clock / programmer
#   SocTopConfig.full_vhdl      -> real generated SoC top-level VHDL
#   generate_xdc_for_board      -> real board XDC (empty + diagnostic if none)
#   emit_kernel_all_backends    -> the real VHDL kernel entity from shared MIR
#
# Everything is composed IN MEMORY: this entry point deliberately does not call
# create_synthesis_flow / generate_riscv_fpga_rtl_bundle_configured, both of
# which write a full RTL tree to disk. Those remain the deployment step.
#
# TODO(W3.4-xdc): xdc_gen only ships MLK-S02-100T pin assignments, so a K26/KV260
# bundle currently has no constraints leg at all. Add the real K26 pinout there.
#
# TODO(W3.4-board): drive the on-disk RTL bundle + Vivado invocation + board
# programming from this bundle so a real KV260 is flashed end to end. Only the
# artifact composition is wired today; nothing here touches a device.

use std.hardware.fpga_linux.riscv_fpga_linux.{XilinxBoardProfile, Xlen}
use std.hardware.fpga_linux.synthesis_wrapper.{SocTopConfig}
use std.hardware.fpga_linux.xdc_gen.{generate_xdc_for_board}
use compiler.backend.unified_kernel_emit.{emit_kernel_all_backends}

struct RiscvFpgaGpuTargetBundle:
    """
    A board bundle for one `--gpu-target=<t> --board=<b>` invocation.

    `board` echoes the board id as REQUESTED on the command line (it is the
    user-facing name). `board_profile_id` is the profile actually resolved,
    which differs whenever a board is a carrier for a known SOM.
    """
    board: text
    board_profile_id: text
    board_part: text
    board_clock_hz: i64
    board_programmer: text
    gpu_target: text
    kernel_vhdl: text
    soc_top_vhdl: text
    constraints_xdc: text
    generated_artifacts: [text]
    diagnostics: [text]

fn riscv_fpga_board_profile_id(board: text) -> text:
    """
    Map a board id to the SOM/board profile that carries it.

    The Kria KV260 vision starter kit is a carrier for the Xilinx K26 SOM
    (xck26-sfvc784-2LV-c), so it resolves onto the `xilinx_k26` profile that
    riscv_fpga_linux already ships. Unknown ids pass through unchanged so the
    real profile lookup produces the real "unknown board id" diagnostic.
    """
    if board == "kv260" or board == "kria_kv260":
        "xilinx_k26"
    else:
        board

fn generate_riscv_fpga_bundle_gpu_target(gpu_target: text, board: text) -> RiscvFpgaGpuTargetBundle:
    """
    Compose the board bundle for a GPU target on a RISC-V FPGA board.

    Every field is derived from the real generators; a generator that refuses
    leaves its artifact empty and records the refusal in `diagnostics`.
    """
    var diagnostics: [text] = []
    var artifacts: [text] = []
    val profile_id = riscv_fpga_board_profile_id(board)

    var board_part = ""
    var board_clock_hz = 0
    var board_programmer = ""
    var soc_top_vhdl = ""
    val profile_result = XilinxBoardProfile.from_id(profile_id)
    if profile_result.is_ok():
        val profile = profile_result.unwrap()
        board_part = profile.part
        board_clock_hz = profile.clock_hz
        board_programmer = profile.programmer
        soc_top_vhdl = SocTopConfig.default_for(profile, Xlen.Rv32).full_vhdl()
        if soc_top_vhdl.len() > 0:
            artifacts.push("simple_soc_top.vhd")
    else:
        diagnostics.push(profile_result.unwrap_err())

    # Board constraints: only the real per-board XDC. There is deliberately no
    # generic fallback — the generic snippet carries Artix-7 (MLK-S02-100T)
    # pin assignments, and shipping those under another board's name would be
    # wrong pinout presented as this board's constraints.
    var constraints_xdc = ""
    val xdc_result = generate_xdc_for_board(profile_id)
    if xdc_result.is_ok():
        constraints_xdc = xdc_result.unwrap().to_xdc()
        artifacts.push(profile_id + ".xdc")
    else:
        diagnostics.push(xdc_result.unwrap_err())

    # The GPU kernel itself, through the shared-MIR multi-backend emitter.
    var kernel_vhdl = ""
    if gpu_target == "vhdl":
        val emission = emit_kernel_all_backends("vector_add")
        kernel_vhdl = emission.vhdl
        if kernel_vhdl.len() > 0:
            artifacts.push("vector_add.vhd")
        else:
            diagnostics.push(emission.vhdl_diagnostic)
    else:
        diagnostics.push("gpu target `" + gpu_target + "` emits no VHDL kernel for an FPGA board bundle")

    RiscvFpgaGpuTargetBundle(
        board: board,
        board_profile_id: profile_id,
        board_part: board_part,
        board_clock_hz: board_clock_hz,
        board_programmer: board_programmer,
        gpu_target: gpu_target,
        kernel_vhdl: kernel_vhdl,
        soc_top_vhdl: soc_top_vhdl,
        constraints_xdc: constraints_xdc,
        generated_artifacts: artifacts,
        diagnostics: diagnostics
    )

export RiscvFpgaGpuTargetBundle
export generate_riscv_fpga_bundle_gpu_target
