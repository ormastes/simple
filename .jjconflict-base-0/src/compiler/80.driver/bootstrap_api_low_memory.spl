use compiler.common.bootstrap_low_memory_config.{bootstrap_low_memory_opt_ins_requested}
use std.nogc_sync_mut.io.env_ops.{env_get}

pub fn bootstrap_low_memory_requested() -> bool:
    bootstrap_low_memory_opt_ins_requested(
        env_get("SIMPLE_BOOTSTRAP"),
        env_get("SIMPLE_BOOTSTRAP_STAGE4"),
        env_get("SIMPLE_BOOTSTRAP_LOW_MEMORY")
    )
