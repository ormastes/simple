# codex-impl: Driver-owned role/default projection for backend plugin startup.
#
# The caller supplies already-resolved target/CPU parameters. This pure owner
# does not read environment state and does not perform provider substitution.

use compiler.common.backend_plugin.model.{
    BackendRole, BackendCapability, BackendPluginRequestV1
}
use compiler.common.backend_plugin.receipt.{BackendPluginError}
use compiler.backend.backend_plugin.registry.{BUILTIN_MIR_ABI_DIGEST_V1}

fn driver_default_backend_name(role: BackendRole) -> text:
    match role:
        case BackendRole.InterpreterJit: "cranelift"
        case BackendRole.CompilerAot: "llvm"

pub fn driver_backend_plugin_request_v1(
    role: BackendRole,
    configured_backend: text,
    target: text,
    cpu: text,
    features: [text],
    optimization: text,
    mir_abi_digest: text,
    required_capabilities: [BackendCapability],
    plugin_path: text = ""
) -> BackendPluginRequestV1:
    val backend_name = if configured_backend == "" or configured_backend == "auto":
        driver_default_backend_name(role)
    else:
        configured_backend
    BackendPluginRequestV1(
        role,
        backend_name,
        target,
        cpu,
        features,
        optimization,
        mir_abi_digest,
        required_capabilities,
        plugin_path,
        plugin_path != ""
    )

fn driver_aot_uses_versioned_backend(configured_backend: text) -> bool:
    # Keep established non-plugin providers on their existing lanes. Everything
    # else, including an unknown explicit name, must reach admission and fail
    # closed instead of falling through the legacy helper's LLVM default.
    match configured_backend:
        case "llvm-lib" | "llvmlib" | "native": false
        case "c" | "cpp" | "ccodegen": false
        case "cuda" | "ptx" | "hip" | "hip-cpp" | "hsaco" | "rocm": false
        case "opencl" | "opencl-c" | "opencl-spirv" | "cl": false
        case "vulkan" | "spirv" | "vhdl" | "byl": false
        case "irtc" | "mllvm-qemu" | "lua": false
        case "wasm" | "wasm32" | "wasm64": false
        case _: true

fn driver_backend_plugin_target(configured_target: text) -> text:
    if configured_target == "":
        return "host"
    if configured_target == "native":
        return "native"
    val arch = configured_target.split("-")[0]
    match arch:
        case "amd64": "x86_64"
        case "x64": "x86_64"
        case "arm64": "aarch64"
        case "i386" | "i486" | "i586" | "i686": "x86"
        case "x86_64" | "aarch64" | "riscv64" | "riscv32" | "x86" | "arm": arch
        case _: configured_target

fn driver_backend_plugin_optimization(opt_level: i64) -> text:
    if opt_level <= 0:
        "o0"
    elif opt_level == 1:
        "o1"
    elif opt_level == 2:
        "o2"
    else:
        "o3"

fn driver_aot_backend_plugin_request_v1(
    configured_backend: text,
    configured_target: text,
    configured_cpu: text,
    opt_level: i64,
    plugin_path: text = ""
) -> BackendPluginRequestV1:
    driver_backend_plugin_request_v1(
        BackendRole.CompilerAot,
        configured_backend,
        driver_backend_plugin_target(configured_target),
        if configured_cpu == "": "generic" else: configured_cpu,
        [],
        driver_backend_plugin_optimization(opt_level),
        BUILTIN_MIR_ABI_DIGEST_V1,
        [BackendCapability.ObjectEmit],
        plugin_path
    )

fn driver_backend_plugin_error_text(error: BackendPluginError) -> text:
    error.code() + ": " + error.diagnostic()

export driver_default_backend_name, driver_backend_plugin_request_v1
export driver_aot_uses_versioned_backend, driver_backend_plugin_target
export driver_backend_plugin_optimization, driver_aot_backend_plugin_request_v1
export driver_backend_plugin_error_text
