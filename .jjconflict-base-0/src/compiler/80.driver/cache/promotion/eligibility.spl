# Main-eligibility gate — design §15.1.
#
# A result is eligible for the trusted remote-main action namespace ONLY when
# every one of the ten conditions below holds. This module evaluates each
# condition independently and reports WHICH ONE failed (never just a
# boolean) — first-milestone scope requires diagnosability, not just a gate.
#
# This module never performs a write. It is a pure decision function over an
# `EligibilityInput` snapshot supplied by the caller (see git_ancestry.spl for
# how the reachability/freshness fields of that snapshot are produced).

use compiler.driver.cache.promotion.promotion_receipt.{PromotionReceipt}

# One condition from the §15.1 conjunction, in the same order as the design
# doc lists them. Used both to report failure and to enumerate the family in
# tests (each must be individually sabotage-able).
enum EligibilityCondition:
    CleanSourceTree
    ExactImmutableSourceCommit
    AuthenticatedRepositoryIdentity
    TrustedOriginMainSnapshot
    SourceCommitReachableFromSnapshot
    TrustedCiBuilderAndProtectedWorkflow
    HermeticDeclaredActionInputs
    StrictManifestAndArtifactVerification
    SuccessfulRequiredTestsOrProofs
    SignedPromotionReceipt

fn eligibility_condition_text(c: EligibilityCondition) -> text:
    match c:
        case EligibilityCondition.CleanSourceTree: "clean_source_tree"
        case EligibilityCondition.ExactImmutableSourceCommit: "exact_immutable_source_commit"
        case EligibilityCondition.AuthenticatedRepositoryIdentity: "authenticated_repository_identity"
        case EligibilityCondition.TrustedOriginMainSnapshot: "trusted_origin_main_snapshot"
        case EligibilityCondition.SourceCommitReachableFromSnapshot: "source_commit_reachable_from_snapshot"
        case EligibilityCondition.TrustedCiBuilderAndProtectedWorkflow: "trusted_ci_builder_and_protected_workflow"
        case EligibilityCondition.HermeticDeclaredActionInputs: "hermetic_declared_action_inputs"
        case EligibilityCondition.StrictManifestAndArtifactVerification: "strict_manifest_and_artifact_verification"
        case EligibilityCondition.SuccessfulRequiredTestsOrProofs: "successful_required_tests_or_proofs"
        case EligibilityCondition.SignedPromotionReceipt: "signed_promotion_receipt"

# Snapshot of everything the gate needs to decide. Every field is a plain
# boolean/text fact the caller must have already established (e.g. via
# git_ancestry.spl for the reachability/freshness facts) — this module does
# not shell out or touch the filesystem itself, so it stays unit-testable
# with a fake oracle.
struct EligibilityInput:
    clean_tree: bool
    exact_commit_pinned: bool          # source commit is an exact, immutable id (not a movable ref)
    repository_identity_authenticated: bool
    origin_main_snapshot_trusted: bool  # snapshot came from an authenticated fetch, not a stale local ref
    origin_main_snapshot_fresh: bool    # freshness is part of the trust proof per §15.1
    commit_reachable_from_snapshot: bool
    builder_is_trusted_ci: bool
    workflow_is_protected: bool
    inputs_are_hermetic_and_declared: bool
    manifest_and_artifacts_strictly_verified: bool
    required_tests_or_proofs_passed: bool
    receipt: PromotionReceipt?          # must be present AND signed

# Result of the gate: either eligible, or the first failing condition in
# §15.1 order. Reporting only the FIRST failure (not all) mirrors a
# conjunction short-circuit, but every condition is still individually
# testable by flipping exactly one input field at a time.
enum EligibilityResult:
    Eligible
    Rejected(EligibilityCondition)

fn receipt_is_signed(receipt: PromotionReceipt?) -> bool:
    match receipt:
        case Some(r):
            r.signature.len() > 0
        case nil:
            false

fn eligibility_check(input: EligibilityInput) -> EligibilityResult:
    if not input.clean_tree:
        return EligibilityResult.Rejected(EligibilityCondition.CleanSourceTree)
    if not input.exact_commit_pinned:
        return EligibilityResult.Rejected(EligibilityCondition.ExactImmutableSourceCommit)
    if not input.repository_identity_authenticated:
        return EligibilityResult.Rejected(EligibilityCondition.AuthenticatedRepositoryIdentity)
    if not (input.origin_main_snapshot_trusted and input.origin_main_snapshot_fresh):
        return EligibilityResult.Rejected(EligibilityCondition.TrustedOriginMainSnapshot)
    if not input.commit_reachable_from_snapshot:
        return EligibilityResult.Rejected(EligibilityCondition.SourceCommitReachableFromSnapshot)
    if not (input.builder_is_trusted_ci and input.workflow_is_protected):
        return EligibilityResult.Rejected(EligibilityCondition.TrustedCiBuilderAndProtectedWorkflow)
    if not input.inputs_are_hermetic_and_declared:
        return EligibilityResult.Rejected(EligibilityCondition.HermeticDeclaredActionInputs)
    if not input.manifest_and_artifacts_strictly_verified:
        return EligibilityResult.Rejected(EligibilityCondition.StrictManifestAndArtifactVerification)
    if not input.required_tests_or_proofs_passed:
        return EligibilityResult.Rejected(EligibilityCondition.SuccessfulRequiredTestsOrProofs)
    if not receipt_is_signed(input.receipt):
        return EligibilityResult.Rejected(EligibilityCondition.SignedPromotionReceipt)
    EligibilityResult.Eligible

# Convenience: an all-true input, for tests to clone-and-flip one field.
fn eligibility_input_all_pass(receipt: PromotionReceipt) -> EligibilityInput:
    EligibilityInput(
        clean_tree: true,
        exact_commit_pinned: true,
        repository_identity_authenticated: true,
        origin_main_snapshot_trusted: true,
        origin_main_snapshot_fresh: true,
        commit_reachable_from_snapshot: true,
        builder_is_trusted_ci: true,
        workflow_is_protected: true,
        inputs_are_hermetic_and_declared: true,
        manifest_and_artifacts_strictly_verified: true,
        required_tests_or_proofs_passed: true,
        receipt: receipt
    )

export EligibilityCondition, EligibilityInput, EligibilityResult
export eligibility_condition_text, eligibility_check, receipt_is_signed
export eligibility_input_all_pass
