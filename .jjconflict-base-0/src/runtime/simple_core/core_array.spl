# Pure-Simple `simple-core` array ABI.

@unsafe(reason: "raw libc heap allocation ABI; zero means failure", capabilities: [ffi, raw_ptr])
extern fn malloc(size: i64) -> i64
@unsafe(reason: "raw libc zeroed allocation ABI; count-size overflow must fail", capabilities: [ffi, raw_ptr])
extern fn calloc(count: i64, size: i64) -> i64
@unsafe(reason: "raw libc owned allocation resize ABI; zero means failure", capabilities: [ffi, raw_ptr])
extern fn realloc(ptr: i64, size: i64) -> i64
@unsafe(reason: "raw libc owned allocation release ABI", capabilities: [ffi, raw_ptr])
extern fn free(ptr: i64)
@unsafe(reason: "raw non-overlapping pointer/extent copy ABI", capabilities: [ffi, raw_ptr])
extern fn memcpy(dst: i64, src: i64, n: i64) -> i64
@unsafe(reason: "raw pointer/offset i64 load ABI", capabilities: [ffi, raw_ptr])
extern fn spl_load_i64(ptr: i64, offset: i64) -> i64
@unsafe(reason: "raw pointer/offset i64 store ABI", capabilities: [ffi, raw_ptr])
extern fn spl_store_i64(ptr: i64, offset: i64, value: i64)
@unsafe(reason: "raw pointer/offset byte load ABI", capabilities: [ffi, raw_ptr])
extern fn spl_load_u8(ptr: i64, offset: i64) -> i64
@unsafe(reason: "raw pointer/offset byte store ABI", capabilities: [ffi, raw_ptr])
extern fn spl_store_u8(ptr: i64, offset: i64, value: i64)
@unsafe(reason: "raw tagged string-array join ABI", capabilities: [ffi])
extern fn rt_string_join(array: i64, separator: i64) -> i64
@unsafe(reason: "raw tagged-string character projection ABI", capabilities: [ffi])
extern fn rt_string_char_at(value: i64, index: i64) -> i64
@unsafe(reason: "raw tagged-value text predicate ABI", capabilities: [ffi])
extern fn rt_string_is_text(value: i64) -> i64
@unsafe(reason: "raw tagged-string character-array allocation ABI", capabilities: [ffi])
extern fn rt_string_chars(value: i64) -> i64
@unsafe(reason: "raw tagged-value equality ABI", capabilities: [ffi])
extern fn rt_native_eq(left: i64, right: i64) -> i64
@unsafe(reason: "raw transient-tracking runtime note ABI", capabilities: [ffi, raw_ptr])
extern fn rt_simple_core_transient_note(ptr: i64, kind: i64) -> i64

@always_inline
fn _sffi_core_array_transient_note(ptr: i64, kind: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]):
        rt_simple_core_transient_note(ptr, kind)

@always_inline
fn _sffi_core_array_calloc(count: i64, size: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]):
        calloc(count, size)

@always_inline
fn _sffi_core_array_realloc(ptr: i64, size: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]):
        realloc(ptr, size)

@always_inline
fn _sffi_core_array_free(ptr: i64):
    unsafe(capabilities: [ffi, raw_ptr]):
        free(ptr)

@always_inline
fn _sffi_core_array_load_i64(ptr: i64, offset: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]):
        spl_load_i64(ptr, offset)

@always_inline
fn _sffi_core_array_store_i64(ptr: i64, offset: i64, value: i64):
    unsafe(capabilities: [ffi, raw_ptr]):
        spl_store_i64(ptr, offset, value)

@always_inline
fn _sffi_core_array_load_u8(ptr: i64, offset: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]):
        spl_load_u8(ptr, offset)

@always_inline
fn _sffi_core_array_store_u8(ptr: i64, offset: i64, value: i64):
    unsafe(capabilities: [ffi, raw_ptr]):
        spl_store_u8(ptr, offset, value)

@always_inline
fn _sffi_core_array_rt_string_char_at(value: i64, index: i64) -> i64:
    unsafe(capabilities: [ffi]):
        rt_string_char_at(value, index)

@always_inline
fn _sffi_core_array_rt_string_is_text(value: i64) -> i64:
    unsafe(capabilities: [ffi]):
        rt_string_is_text(value)

@always_inline
fn _sffi_core_array_rt_string_chars(value: i64) -> i64:
    unsafe(capabilities: [ffi]):
        rt_string_chars(value)

@always_inline
fn _sffi_core_array_rt_native_eq(left: i64, right: i64) -> i64:
    unsafe(capabilities: [ffi]):
        rt_native_eq(left, right)

# Registry links live in the private fifth word of each pure-Simple array.
var array_registry_head: i64 = 0

# Dict membership registry, mirroring runtime_native.c's "RtCoreDict
# membership, mirroring the string/float registries" design: registry links
# live in the previously unused fourth word (@24) of each dict header, so a
# reclaimed transient dict handle reports invalid instead of dereferencing
# freed memory.
var dict_registry_head: i64 = 0

# ============================================================================
# Internal ABI helpers — pub so split files (core_array_ops, core_array_query)
# can call them as extern fn without duplicating logic.
# ============================================================================

pub fn array_ptr(array: i64) -> i64:
    if (array & 7) == 1:
        return array & -8
    return array

pub fn array_items(array: i64) -> i64:
    return _sffi_core_array_load_i64(array_ptr(array), 24)

pub fn array_len_value(array: i64) -> i64:
    return _sffi_core_array_load_i64(array_ptr(array), 8)

pub fn array_cap(array: i64) -> i64:
    return _sffi_core_array_load_i64(array_ptr(array), 16)

pub fn array_flags(array: i64) -> i64:
    return _sffi_core_array_load_u8(array_ptr(array), 1)

pub fn array_is_valid(array: i64) -> i64:
    if array < 4096:
        return 0
    val ptr = array_ptr(array)
    if (ptr & 7) > 0:
        return 0
    var current = array_registry_head
    while current > 0 and current != ptr:
        current = _sffi_core_array_load_i64(current, 32)
    if current < 1:
        return 0
    if _sffi_core_array_load_u8(ptr, 0) != 2:
        return 0
    val len = _sffi_core_array_load_i64(ptr, 8)
    val cap = _sffi_core_array_load_i64(ptr, 16)
    if len < 0 or cap < 0:
        return 0
    if len > cap:
        return 0
    if cap > 100000000:
        return 0
    return 1

pub fn register_array(array: i64):
    _sffi_core_array_store_i64(array, 32, array_registry_head)
    array_registry_head = array

pub fn unregister_array(array: i64):
    var previous: i64 = 0
    var current = array_registry_head
    while current > 0:
        val next = _sffi_core_array_load_i64(current, 32)
        if current == array:
            if previous < 1:
                array_registry_head = next
            else:
                _sffi_core_array_store_i64(previous, 32, next)
            return
        previous = current
        current = next

pub fn set_array_items(array: i64, items: i64):
    _sffi_core_array_store_i64(array_ptr(array), 24, items)

pub fn set_array_len(array: i64, len: i64):
    _sffi_core_array_store_i64(array_ptr(array), 8, len)

pub fn set_array_cap(array: i64, cap: i64):
    _sffi_core_array_store_i64(array_ptr(array), 16, cap)

pub fn numeric_index(value: i64) -> i64:
    if (value & 7) < 1 and value >= 8:
        return value >> 3
    return value

pub fn normalize_index(array: i64, idx: i64) -> i64:
    val raw_idx = numeric_index(idx)
    if raw_idx < 0:
        return array_len_value(array) + raw_idx
    return raw_idx

# ============================================================================
# Core array construction
# ============================================================================

fn array_new_with_flags(cap: i64, flags: i64, elem_size: i64) -> i64:
    var actual_cap = cap
    if actual_cap < 4:
        actual_cap = 4
    val array = _sffi_core_array_calloc(1, 40)
    if array < 1:
        return 0
    val items = _sffi_core_array_calloc(actual_cap, elem_size)
    if items < 1:
        _sffi_core_array_free(array)
        return 0
    if flags == 0 and elem_size == 8:
        # Generic 8-byte VALUE slots must start as the tagged nil sentinel 0x3,
        # not calloc's raw zero: on the freestanding native-build a raw-0 element
        # is NOT recognized by `.?` nil checks (compiled as `!= 0x3`), so a field
        # access on an unset slot derefs null (SimpleOS WM first-frame fault,
        # cr2=0, 2026-07-17). Packed byte/u64 storage (flags != 0) keeps raw 0.
        var i = 0
        while i < actual_cap:
            _sffi_core_array_store_i64(items, i * 8, 3)
            i = i + 1
    _sffi_core_array_store_u8(array, 0, 2)
    _sffi_core_array_store_u8(array, 1, flags)
    set_array_items(array, items)
    set_array_len(array, 0)
    set_array_cap(array, actual_cap)
    register_array(array)
    # Transient-scope tracking (spec: runtime_native.c
    # rt_core_register_scoped_immortal): a tracking failure fails the
    # allocation rather than leaking an untracked scope-born object.
    if _sffi_core_array_transient_note(array, 2) < 0:
        unregister_array(array)
        _sffi_core_array_free(items)
        _sffi_core_array_free(array)
        return 0
    return array | 1

pub fn rt_array_new(cap: i64) -> i64:
    return array_new_with_flags(cap, 0, 8)

# The selected pure-Simple argv owner must not relocate through the duplicate
# public array ABI under whole-archive/allow-multiple-definition linkage.
pub fn rt_simple_core_argv_array_new_owned(cap: i64) -> i64:
    return array_new_with_flags(cap, 0, 8)

pub fn rt_byte_array_new(cap: i64) -> i64:
    return array_new_with_flags(cap, 8, 1)

pub fn rt_byte_array_new_len(len: i64) -> i64:
    val array = rt_byte_array_new(len)
    if array_is_valid(array) < 1:
        return array
    set_array_len(array, len)
    return array

pub fn rt_array_len(array: i64) -> i64:
    if array_is_valid(array) < 1:
        return 0
    return array_len_value(array)

pub fn rt_array_len_safe(array: i64) -> i64:
    if array_is_valid(array) < 1:
        return 0
    return array_len_value(array)

# Strong target-owner implementations override runtime_native.c's weak hosted
# fallbacks when SimpleOS links the pure-Simple core archive.
pub fn rt_array_bytes_validate(value: i64) -> i64:
    if array_is_valid(value) < 1:
        return -22
    val flags = array_flags(value)
    if flags != 0 and flags != 8:
        return -22
    val len = array_len_value(value)
    if flags == 8:
        return len
    val items = array_items(value)
    var i = 0
    while i < len:
        val item = _sffi_core_array_load_i64(items, i * 8)
        if (item & 7) != 0:
            return -22
        val byte = item >> 3
        if byte < 0 or byte > 255:
            return -22
        i = i + 1
    len

pub fn rt_array_bytes_copy_checked(value: i64, out: i64, capacity: i64) -> i64:
    val len = rt_array_bytes_validate(value)
    if len < 0 or capacity < len or (len > 0 and out < 1):
        return -22
    val items = array_items(value)
    val packed = array_flags(value) == 8
    var i = 0
    while i < len:
        val byte = if packed: _sffi_core_array_load_u8(items, i) else: _sffi_core_array_load_i64(items, i * 8) >> 3
        _sffi_core_array_store_u8(out, i, byte)
        i = i + 1
    len

pub fn rt_array_bytes_store_checked(value: i64, bytes: i64, len: i64) -> i64:
    val capacity = rt_array_bytes_validate(value)
    if capacity < 0 or len < 0 or len > capacity or (len > 0 and bytes < 1):
        return -22
    val items = array_items(value)
    val packed = array_flags(value) == 8
    var i = 0
    while i < len:
        val byte = _sffi_core_array_load_u8(bytes, i)
        if packed:
            _sffi_core_array_store_u8(items, i, byte)
        else:
            _sffi_core_array_store_i64(items, i * 8, byte << 3)
        i = i + 1
    len

fn array_get_raw(array: i64, idx: i64) -> i64:
    if array_is_valid(array) < 1:
        return 3
    val actual_idx = if idx < 0: array_len_value(array) + idx else: idx
    if actual_idx < 0 or actual_idx >= array_len_value(array):
        return 3
    return _sffi_core_array_load_i64(array_items(array), actual_idx * 8)

pub fn rt_array_get(array: i64, idx: i64) -> i64:
    array_get_raw(array, idx)

pub fn rt_array_get_text(array: i64, idx: i64) -> i64:
    return rt_array_get(array, idx)

fn array_set_raw(array: i64, idx: i64, value: i64) -> i8:
    if array_is_valid(array) < 1:
        return 0
    val actual_idx = if idx < 0: array_len_value(array) + idx else: idx
    if actual_idx < 0 or actual_idx >= array_len_value(array):
        return 0
    _sffi_core_array_store_i64(array_items(array), actual_idx * 8, value)
    return 1

pub fn rt_array_set(array: i64, idx: i64, value: i64) -> i8:
    array_set_raw(array, idx, value)

pub fn rt_array_set_text(array: i64, idx: i64, value: i64) -> i8:
    return rt_array_set(array, idx, value)

fn dict_ptr(dict: i64) -> i64:
    # Registry membership BEFORE the kind-byte dereference (2026-08-31,
    # mirroring runtime_native.c rt_core_as_dict): a transient dict reclaimed
    # at scope end is freed memory, and the scope-death contract requires a
    # stale handle to report invalid silently, not to read through it.
    if dict_is_valid(dict) < 1:
        return 0
    dict & -8

fn dict_cap(dict: i64) -> i64:
    _sffi_core_array_load_i64(dict_ptr(dict), 8)

fn dict_len_value(dict: i64) -> i64:
    _sffi_core_array_load_i64(dict_ptr(dict), 16)

fn dict_items(dict: i64) -> i64:
    _sffi_core_array_load_i64(dict_ptr(dict), 32)

fn dict_key(key: i64) -> i64:
    if key >= 4096 and (key & 7) == 1:
        return key
    if (key & 7) == 0 and (key >= 8 or key <= -8):
        return key
    key << 3

# ponytail: linear pairs are sufficient for the focused bootstrap compiler;
# replace with hashing only when guest-scale profiles prove it necessary.

fn dict_find(dict: i64, key: i64) -> i64:
    val ptr = dict_ptr(dict)
    if ptr < 1:
        return -1
    val canonical = dict_key(key)
    val len = dict_len_value(dict)
    val items = dict_items(dict)
    var i = 0
    while i < len:
        if _sffi_core_array_rt_native_eq(_sffi_core_array_load_i64(items, i * 16), canonical) != 0:
            return i
        i = i + 1
    -1

fn dict_reserve(dict: i64, needed: i64) -> i8:
    var cap = dict_cap(dict)
    if needed <= cap:
        return 1
    var new_cap = cap * 2
    if new_cap < needed:
        new_cap = needed
    val new_items = _sffi_core_array_realloc(dict_items(dict), new_cap * 16)
    if new_items < 1:
        return 0
    _sffi_core_array_store_i64(dict_ptr(dict), 8, new_cap)
    _sffi_core_array_store_i64(dict_ptr(dict), 32, new_items)
    1

pub fn rt_index_get(collection: i64, idx: i64) -> i64:
    if dict_ptr(collection) > 0:
        return rt_dict_get(collection, idx)
    if (idx & 7) > 0:
        return 3
    val raw_idx = idx >> 3
    if array_is_valid(collection) > 0:
        return array_get_raw(collection, raw_idx)
    _sffi_core_array_rt_string_char_at(collection, raw_idx)

pub fn rt_index_set(collection: i64, idx: i64, value: i64) -> i8:
    if dict_ptr(collection) > 0:
        return if rt_dict_set(collection, idx, value) != 0: 1 else: 0
    if (idx & 7) > 0:
        return 0
    array_set_raw(collection, idx >> 3, value)

pub fn rt_tuple_new(len: i64) -> i64:
    val tuple = rt_array_new(len)
    if array_is_valid(tuple) < 1:
        return tuple
    if len < 0:
        return tuple
    set_array_len(tuple, len)
    tuple

pub fn rt_tuple_set(tuple: i64, idx: i64, value: i64) -> i8:
    rt_array_set(tuple, idx, value)

pub fn rt_tuple_get(tuple: i64, idx: i64) -> i64:
    return rt_array_get(tuple, idx)

pub fn rt_dict_new(cap: i64) -> i64:
    val _ = cap
    val actual_cap = 8
    val dict = _sffi_core_array_calloc(1, 40)
    if dict < 1:
        return 3
    val items = _sffi_core_array_calloc(actual_cap, 16)
    if items < 1:
        _sffi_core_array_free(dict)
        return 3
    _sffi_core_array_store_u8(dict, 0, 6)
    _sffi_core_array_store_i64(dict, 8, actual_cap)
    _sffi_core_array_store_i64(dict, 16, 0)
    _sffi_core_array_store_i64(dict, 32, items)
    _sffi_core_array_store_i64(dict, 24, dict_registry_head)
    dict_registry_head = dict
    if _sffi_core_array_transient_note(dict, 3) < 0:
        dict_registry_head = _sffi_core_array_load_i64(dict, 24)
        _sffi_core_array_free(items)
        _sffi_core_array_free(dict)
        return 3
    dict | 1

# Membership test for the transient machinery (core_memory.spl): registry
# walk BEFORE any dereference of the candidate, then the kind byte.
pub fn dict_is_valid(dict: i64) -> i64:
    if dict < 4096 or (dict & 7) != 1:
        return 0
    val candidate = dict & -8
    var current = dict_registry_head
    while current > 0 and current != candidate:
        current = _sffi_core_array_load_i64(current, 24)
    if current < 1:
        return 0
    if _sffi_core_array_load_u8(candidate, 0) != 6:
        return 0
    return 1

fn dict_unregister(ptr: i64):
    var previous: i64 = 0
    var current = dict_registry_head
    while current > 0:
        val next = _sffi_core_array_load_i64(current, 24)
        if current == ptr:
            if previous < 1:
                dict_registry_head = next
            else:
                _sffi_core_array_store_i64(previous, 24, next)
            return
        previous = current
        current = next

# Scope-end reclamation of an unpromoted transient dict (raw header ptr).
pub fn dict_reclaim_transient(ptr: i64):
    dict_unregister(ptr)
    val items = _sffi_core_array_load_i64(ptr, 32)
    if items > 0:
        _sffi_core_array_free(items)
    _sffi_core_array_free(ptr)

pub fn rt_dict_get(dict: i64, key: i64) -> i64:
    val index = dict_find(dict, key)
    if index < 0:
        return 3
    _sffi_core_array_load_i64(dict_items(dict), index * 16 + 8)

pub fn rt_dict_set(dict: i64, key: i64, value: i64) -> i8:
    if dict_ptr(dict) < 1:
        return 0
    var index = dict_find(dict, key)
    if index >= 0:
        _sffi_core_array_store_i64(dict_items(dict), index * 16 + 8, value)
        return 1
    val len = dict_len_value(dict)
    if dict_reserve(dict, len + 1) < 1:
        return 0
    index = len
    val items = dict_items(dict)
    _sffi_core_array_store_i64(items, index * 16, dict_key(key))
    _sffi_core_array_store_i64(items, index * 16 + 8, value)
    _sffi_core_array_store_i64(dict_ptr(dict), 16, len + 1)
    1

pub fn rt_dict_insert(dict: i64, key: i64, value: i64) -> i8:
    rt_dict_set(dict, key, value)

pub fn rt_dict_contains(dict: i64, key: i64) -> i8:
    return if dict_find(dict, key) >= 0: 1 else: 0

pub fn rt_dict_remove(dict: i64, key: i64) -> i8:
    val index = dict_find(dict, key)
    if index < 0:
        return 0
    val len = dict_len_value(dict)
    val last = len - 1
    val items = dict_items(dict)
    if index < last:
        _sffi_core_array_store_i64(items, index * 16, _sffi_core_array_load_i64(items, last * 16))
        _sffi_core_array_store_i64(items, index * 16 + 8, _sffi_core_array_load_i64(items, last * 16 + 8))
    _sffi_core_array_store_i64(dict_ptr(dict), 16, last)
    1

pub fn rt_dict_clear(dict: i64) -> i8:
    if dict_ptr(dict) < 1:
        return 0
    _sffi_core_array_store_i64(dict_ptr(dict), 16, 0)
    1

pub fn rt_dict_len(dict: i64) -> i64:
    if dict_ptr(dict) < 1:
        return 0
    dict_len_value(dict)

pub fn rt_dict_keys(dict: i64) -> i64:
    if dict_ptr(dict) < 1:
        return rt_array_new(0)
    val len = rt_dict_len(dict)
    val out = rt_array_new(len)
    if out < 4096:
        return 3
    var i = 0
    while i < len:
        rt_array_push(out, _sffi_core_array_load_i64(dict_items(dict), i * 16))
        i = i + 1
    out

pub fn rt_dict_values(dict: i64) -> i64:
    if dict_ptr(dict) < 1:
        return rt_array_new(0)
    val len = rt_dict_len(dict)
    val out = rt_array_new(len)
    if out < 4096:
        return 3
    var i = 0
    while i < len:
        rt_array_push(out, _sffi_core_array_load_i64(dict_items(dict), i * 16 + 8))
        i = i + 1
    out

pub fn rt_dict_entries(dict: i64) -> i64:
    if dict_ptr(dict) < 1:
        return rt_array_new(0)
    val len = rt_dict_len(dict)
    val out = rt_array_new(len)
    if out < 4096:
        return 3
    var i = 0
    while i < len:
        val pair = rt_tuple_new(2)
        if pair < 4096:
            return 3
        rt_tuple_set(pair, 0, _sffi_core_array_load_i64(dict_items(dict), i * 16))
        rt_tuple_set(pair, 1, _sffi_core_array_load_i64(dict_items(dict), i * 16 + 8))
        rt_array_push(out, pair)
        i = i + 1
    out

pub fn rt_for_iterable(collection: i64) -> i64:
    if dict_ptr(collection) > 0:
        return rt_dict_entries(collection)
    # Text becomes its UTF-8 codepoint array, so `for ch in <text>` binds one
    # 1-char text per codepoint. Without this a string fell through to the
    # generic rt_array_len / index-get path, which read the BYTE length and
    # indexed raw bytes: "café," ran 6 times instead of 5 and bound garbage
    # that concatenated to nothing. Mirror of rt_for_iterable in
    # src/runtime/runtime_native.c.
    if _sffi_core_array_rt_string_is_text(collection) > 0:
        return _sffi_core_array_rt_string_chars(collection)
    collection
pub fn rt_array_header_ptr(array: i64) -> i64:
    if array_is_valid(array) < 1:
        return 0
    array_ptr(array)

pub fn rt_array_data_ptr(array: i64) -> i64:
    if array_is_valid(array) < 1:
        return 0
    array_items(array)

pub fn rt_array_data_ptr_text(array: i64) -> i64:
    rt_array_data_ptr(array)

pub fn rt_array_set_len_known(array: i64, len: i64) -> i8:
    if array_is_valid(array) < 1:
        return 0
    if len < 0 or len > array_cap(array):
        return 0
    set_array_len(array, len)
    return 1

pub fn rt_array_set_len_known_text(array: i64, len: i64) -> i8:
    return rt_array_set_len_known(array, len)

fn array_push_owned(array: i64, value: i64) -> i8:
    if array_is_valid(array) < 1:
        return 0
    var len = array_len_value(array)
    var cap = array_cap(array)
    if len >= cap:
        var new_cap = cap * 2
        if new_cap < 4:
            new_cap = 4
        val new_items = _sffi_core_array_realloc(array_items(array), new_cap * 8)
        if new_items < 1:
            set_array_len(array, 0)
            set_array_cap(array, 0)
            return 0
        set_array_items(array, new_items)
        set_array_cap(array, new_cap)
        cap = new_cap
    _sffi_core_array_store_i64(array_items(array), len * 8, value)
    set_array_len(array, len + 1)
    return 1

pub fn rt_array_push(array: i64, value: i64) -> i8:
    return array_push_owned(array, value)

pub fn rt_simple_core_argv_array_push_owned(array: i64, value: i64) -> i8:
    return array_push_owned(array, value)

pub fn rt_array_pop(array: i64) -> i64:
    if array_is_valid(array) < 1:
        return 3
    val len = array_len_value(array)
    if len <= 0:
        return 3
    val new_len = len - 1
    val value = _sffi_core_array_load_i64(array_items(array), new_len * 8)
    set_array_len(array, new_len)
    return value
