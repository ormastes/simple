# Slide Layout Registry
#
# Decouples slide-layout creation from the closed `SlideLayout` enum
# (slide.spl:9-14). The enum stays as-is (nothing here deletes it) -- this
# registry sits alongside it as the source of truth for layout GEOMETRY and
# for id-based lookup so slides_app.spl's dropdown and third-party-style
# extensions (slides_ext.spl) never need a literal layout list.
#
# Pure data module by design: it does NOT import slide.spl (Slide,
# SlideElement, ...) so that slide.spl can import THIS module and have its
# title_slide/content_slide/two_column_slide/section_header_slide
# constructors delegate to the registry for placeholder geometry without an
# import cycle. Slide-shaped construction from an arbitrary layout id lives
# in slide.spl's `create_slide_from_layout_id`.
#
# Singleton storage mirrors app.office.sheets.function_registry.spl: a
# one-element array is the whole-value read-modify-write cell, because a
# class instance read back out of an array is not guaranteed to alias the
# stored element (see .spipe/ide_extension_kernel/state.md language hazards).

struct PlaceholderSpec:
    kind: text          # e.g. "title", "subtitle", "body", "left", "right", "heading"
    default_text: text  # seed content used when a slide is built generically from the id
    x: i32
    y: i32
    width: i32
    height: i32

struct SlideLayoutDescriptor:
    id: text             # e.g. "title_slide" -- stable, used for lookup and dropdown wiring
    display_name: text   # e.g. "Title Slide" -- shown in the layout dropdown
    placeholders: [PlaceholderSpec]

class SlideLayoutRegistry:
    entries: [SlideLayoutDescriptor]

    static fn new() -> SlideLayoutRegistry:
        SlideLayoutRegistry(entries: _builtin_slide_layout_descriptors())

    # First registration for an id wins; a duplicate id is rejected so a
    # misbehaving extension cannot shadow an already-registered layout.
    me register(descriptor: SlideLayoutDescriptor) -> bool:
        var i = 0
        while i < self.entries.len():
            if self.entries[i].id == descriptor.id:
                return false
            i = i + 1
        self.entries = self.entries.push(descriptor)
        true

    fn has(self, id: text) -> bool:
        for d in self.entries:
            if d.id == id:
                return true
        false

    fn find(self, id: text) -> SlideLayoutDescriptor?:
        for d in self.entries:
            if d.id == id:
                return d
        nil

    fn ids(self) -> [text]:
        var out: [text] = []
        for d in self.entries:
            out.push(d.id)
        out

    fn display_names(self) -> [text]:
        var out: [text] = []
        for d in self.entries:
            out.push(d.display_name)
        out

    fn count(self) -> i64:
        self.entries.len()

# ---- builtin geometry -------------------------------------------------
# These numbers reproduce, exactly, the geometry the legacy hardcoded paths
# already used: slide.spl:133-174 (title_slide/content_slide) and
# templates.spl:34-70 (template_two_column/template_section_header, the
# geometry slides_app.spl's add_slide -> apply_template path actually
# creates for TwoColumn/SectionHeader today).
fn _builtin_slide_layout_descriptors() -> [SlideLayoutDescriptor]:
    [
        SlideLayoutDescriptor(
            id: "title_slide",
            display_name: "Title Slide",
            placeholders: [
                PlaceholderSpec(kind: "title", default_text: "Title", x: 100, y: 150, width: 760, height: 80),
                PlaceholderSpec(kind: "subtitle", default_text: "Subtitle", x: 150, y: 250, width: 660, height: 50)
            ]
        ),
        SlideLayoutDescriptor(
            id: "title_content",
            display_name: "Title + Content",
            placeholders: [
                PlaceholderSpec(kind: "title", default_text: "Title", x: 50, y: 30, width: 860, height: 60),
                PlaceholderSpec(kind: "body", default_text: "Content goes here", x: 50, y: 110, width: 860, height: 400)
            ]
        ),
        SlideLayoutDescriptor(
            id: "two_column",
            display_name: "Two Column",
            placeholders: [
                PlaceholderSpec(kind: "title", default_text: "Title", x: 50, y: 30, width: 860, height: 60),
                PlaceholderSpec(kind: "left", default_text: "Left column", x: 50, y: 110, width: 410, height: 400),
                PlaceholderSpec(kind: "right", default_text: "Right column", x: 500, y: 110, width: 410, height: 400)
            ]
        ),
        SlideLayoutDescriptor(
            id: "blank",
            display_name: "Blank",
            placeholders: []
        ),
        SlideLayoutDescriptor(
            id: "section_header",
            display_name: "Section Header",
            placeholders: [
                PlaceholderSpec(kind: "heading", default_text: "Section Title", x: 100, y: 200, width: 760, height: 120)
            ]
        )
    ]

var _slide_layout_registry_singleton: [SlideLayoutRegistry] = []

fn slide_layout_registry() -> SlideLayoutRegistry:
    if _slide_layout_registry_singleton.len() > 0:
        return _slide_layout_registry_singleton[0]
    val registry = SlideLayoutRegistry.new()
    _slide_layout_registry_singleton = [registry]
    registry

fn slide_layout_registry_has(id: text) -> bool:
    slide_layout_registry().has(id)

fn slide_layout_registry_find(id: text) -> SlideLayoutDescriptor?:
    slide_layout_registry().find(id)

fn slide_layout_registry_ids() -> [text]:
    slide_layout_registry().ids()

fn slide_layout_registry_display_names() -> [text]:
    slide_layout_registry().display_names()

fn slide_layout_registry_count() -> i64:
    slide_layout_registry().count()

fn slide_layout_registry_register(descriptor: SlideLayoutDescriptor) -> bool:
    var reg = slide_layout_registry()
    val ok = reg.register(descriptor)
    _slide_layout_registry_singleton = [reg]
    ok

fn slide_layout_registry_reset():
    """Test-only: reset to the five builtin layouts, dropping any registered
    extras (the registry is a process-wide singleton, same caveat as
    sheet_function_registry_reset)."""
    _slide_layout_registry_singleton = []
