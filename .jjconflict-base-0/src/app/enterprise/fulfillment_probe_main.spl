# Minimal enterprise fulfillment entry — one codebase for host OS and SimpleOS (AC-17).
use std.nogc_sync_mut.enterprise_store.store.{store_open_file, store_close}
use std.nogc_sync_mut.enterprise_fulfillment.shipments.{ful_setup, ful_shipment_status}

fn main():
    val store = store_open_file("build/test-artifacts/probe_fulfillment.splstore")
    val ok = ful_setup(store)
    print("enterprise fulfillment probe open=" + store.open_ok.to_text() + " setup=" + ok.to_text() + " status=[" + ful_shipment_status(store, "t1", "none") + "]")
    store_close(store)
