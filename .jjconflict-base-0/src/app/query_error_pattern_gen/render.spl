use app.query_error_pattern_gen.generator.{QueryErrorGeneratedModel}

fn _render_query_i64_array(name: text, kind: text, values: [i64], columns: i64) -> text:
    var parts: [text] = ["val ", name, ": [", kind, "] = [\n"]
    var index = 0
    while index < values.len():
        if index % columns == 0:
            parts.push("    ")
        parts.push(values[index].to_string())
        parts.push(kind)
        if index + 1 < values.len():
            parts.push(",")
        if index % columns == columns - 1 or index + 1 == values.len():
            parts.push("\n")
        else:
            parts.push(" ")
        index = index + 1
    parts.push("]\n\n")
    parts.join("")

fn _render_query_u64_array(name: text, values: [u64]) -> text:
    var parts: [text] = ["val ", name, ": [u64] = [\n"]
    var index = 0
    while index < values.len():
        if index % 8 == 0:
            parts.push("    ")
        parts.push("0x{values[index]:x}u64")
        if index + 1 < values.len():
            parts.push(",")
        if index % 8 == 7 or index + 1 == values.len():
            parts.push("\n")
        else:
            parts.push(" ")
        index = index + 1
    parts.push("]\n\n")
    parts.join("")

fn query_error_pattern_render(model: QueryErrorGeneratedModel, pattern_count: i64) -> text:
    var parts: [text] = []
    parts.push("# Generated by app.query_error_pattern_gen; do not edit numeric tables.\n")
    parts.push("# Source contract: {pattern_count} ASCII patterns, {model.fail.len()} states, {model.edge_byte.len()} edges.\n")
    parts.push("# Pattern IDs are pinned by the canonical Pure Simple manifest.\n\n")
    parts.push("const QUERY_ERROR_PATTERN_COUNT: i64 = {pattern_count}\n")
    parts.push("const QUERY_ERROR_PATTERN_STATE_COUNT: i64 = {model.fail.len()}\n")
    parts.push("const QUERY_ERROR_PATTERN_EDGE_COUNT: i64 = {model.edge_byte.len()}\n\n")
    parts.push("struct QueryErrorPatternHits:\n    lo: u64\n    hi: u64\n\n")
    parts.push(_render_query_i64_array("_QEC_ROOT_NEXT", "u16", model.root_next, 16))
    parts.push(_render_query_i64_array("_QEC_EDGE_START", "u16", model.edge_start, 16))
    parts.push(_render_query_i64_array("_QEC_EDGE_BYTE", "u8", model.edge_byte, 16))
    parts.push(_render_query_i64_array("_QEC_EDGE_NEXT", "u16", model.edge_next, 16))
    parts.push(_render_query_i64_array("_QEC_FAIL", "u16", model.fail, 16))
    parts.push(_render_query_i64_array("_QEC_OUTPUT_INDEX", "u16", model.output_index, 16))
    parts.push(_render_query_u64_array("_QEC_OUTPUT_LO", model.output_lo))
    parts.push(_render_query_u64_array("_QEC_OUTPUT_HI", model.output_hi))
    parts.push("""fn _query_error_direct_transition(state: i64, byte: i64) -> i64:
    if state == 0:
        if byte < 0 or byte >= 128:
            return 0
        return _QEC_ROOT_NEXT[byte].to_i64()
    val edge_end = _QEC_EDGE_START[state + 1].to_i64()
    var edge = _QEC_EDGE_START[state].to_i64()
    while edge < edge_end:
        val candidate = _QEC_EDGE_BYTE[edge].to_i64()
        if candidate == byte:
            return _QEC_EDGE_NEXT[edge].to_i64()
        if candidate > byte:
            return -1
        edge = edge + 1
    -1

fn query_error_pattern_hits(message: text) -> QueryErrorPatternHits:
    var lo = 0u64
    var hi = 0u64
    var state = 0
    var offset = 0
    while offset < message.len():
        val byte = message.byte_at(offset)
        var next_state = _query_error_direct_transition(state, byte)
        while next_state < 0:
            state = _QEC_FAIL[state].to_i64()
            next_state = _query_error_direct_transition(state, byte)
        state = next_state
        val output_index = _QEC_OUTPUT_INDEX[state].to_i64()
        if output_index > 0:
            lo = lo | _QEC_OUTPUT_LO[output_index]
            hi = hi | _QEC_OUTPUT_HI[output_index]
        offset = offset + 1
    QueryErrorPatternHits(lo: lo, hi: hi)

fn query_error_pattern_hit(hits: QueryErrorPatternHits, pattern_id: i64) -> bool:
    if pattern_id < 0 or pattern_id >= QUERY_ERROR_PATTERN_COUNT:
        return false
    if pattern_id < 64:
        return (hits.lo & (1u64 << pattern_id.to_u64())) != 0u64
    (hits.hi & (1u64 << (pattern_id - 64).to_u64())) != 0u64
""")
    parts.join("")
