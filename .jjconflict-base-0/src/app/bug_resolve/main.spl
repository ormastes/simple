# Simple CLI - bug-resolve command
# Marks a bug as Closed in doc/08_tracking/bug/bug_db.sdn

use std.cli.cli_util (get_cli_args)
use std.cli.log_modes.{parse_log_options, log_options_help, render_progress}
use nogc_sync_mut.database.bug.{load_bug_database}
use std.nogc_sync_mut.io.file_ops.{file_exists}
use std.log.{error}

val BUG_DB_PATH = "doc/08_tracking/bug/bug_db.sdn"

fn print_help():
    print "Usage: simple bug-resolve --id=<id> --input-tokens=<n|unavailable> --output-tokens=<n|unavailable> --cache-read-tokens=<n|unavailable> --cache-create-tokens=<n|unavailable> --token-source=<source>"
    print ""
    print "Mark a bug as Closed in the bug database."
    print ""
    print "Options:"
    print "  --id=<id>      Bug identifier to resolve"
    print "  --date=<date>  Resolution date (required; YYYY-MM-DD)"
    print "  --input-tokens=<n|unavailable>        Provider-reported input tokens"
    print "  --output-tokens=<n|unavailable>       Provider-reported output tokens"
    print "  --cache-read-tokens=<n|unavailable>   Provider-reported cache-read tokens"
    print "  --cache-create-tokens=<n|unavailable> Provider-reported cache-create tokens"
    print "  --token-source=<source>               Provider/session usage source"
    print "  --token-provider=<provider>           Provider identity (required and separate from source)"
    print "  --knowledge=<path|none>               Required knowledge link above 2x average"
    print "  --json         Output as JSON"
    for line in log_options_help():
        print "  {line}"
    print "  -h, --help     Show this help"

fn _is_log_option(arg: text) -> bool:
    arg == "--human" or arg == "--llm" or arg == "--json" or
        arg == "--tui" or arg == "--stdout" or arg == "--quiet" or
        arg == "--verbose" or arg == "--dots" or arg == "--count" or
        arg == "--no-progress" or arg == "--log-mode" or arg == "--surface" or
        arg == "--progress" or arg.starts_with("--log-mode=") or
        arg.starts_with("--surface=") or arg.starts_with("--progress=")

fn parse_flag(args: [text], prefix: text) -> text:
    for arg in args:
        if arg.starts_with(prefix):
            return arg[prefix.len():]
    ""

fn _token_value(raw: text) -> i64:
    if raw == "unavailable" or raw == "-1":
        return -1
    match raw.parse_i64():
        case Some(value): if value >= 0: value else: -2
        case None: -2

fn _token_field_valid(raw: text) -> bool:
    _token_value(raw) != -2

fn _knowledge_path_allowed(path: text) -> bool:
    path != "" and not path.starts_with("/") and not path.contains("..") and
        not path.contains("//") and path.ends_with(".md") and
        (path.starts_with("doc/00_llm_process/") or path.starts_with("doc/07_guide/") or
        path.starts_with(".codex/skills/") or path.starts_with(".agents/skills/") or
        path.starts_with(".claude/skills/"))

fn _valid_date(raw: text) -> bool:
    if raw.len() != 10 or raw[4:5] != "-" or raw[7:8] != "-":
        return false
    val year = raw[0:4].parse_i64()
    val month = raw[5:7].parse_i64()
    val day = raw[8:10].parse_i64()
    year.? and month.? and day.? and year! >= 1970 and
        month! >= 1 and month! <= 12 and day! >= 1 and day! <= 31

fn main() -> i64:
    val args = get_cli_args()
    val log_opts = parse_log_options(args)
    if not log_opts.valid:
        error("bug-resolve", log_opts.error)
        return 1

    var as_json = log_opts.log_mode == "json"
    var ai = 0
    while ai < args.len():
        val arg = args[ai]
        if arg == "-h" or arg == "--help":
            print_help()
            return 0
        elif arg == "--json" or arg == "--log-mode=json":
            as_json = true
        elif arg == "--log-mode" or arg == "--surface" or arg == "--progress":
            ai = ai + 1
        elif _is_log_option(arg):
            pass
        ai = ai + 1

    val id = parse_flag(args, "--id=")
    val date_str = parse_flag(args, "--date=")
    val input_tokens = parse_flag(args, "--input-tokens=")
    val output_tokens = parse_flag(args, "--output-tokens=")
    val cache_read_tokens = parse_flag(args, "--cache-read-tokens=")
    val cache_create_tokens = parse_flag(args, "--cache-create-tokens=")
    val token_source = parse_flag(args, "--token-source=")
    val token_provider_raw = parse_flag(args, "--token-provider=")
    val knowledge = parse_flag(args, "--knowledge=")

    if id == "":
        print "Error: --id is required"
        print_help()
        return 1

    if date_str == "" or not _valid_date(date_str):
        print "Error: --date is required in YYYY-MM-DD form for a truthful completion receipt"
        return 1

    if input_tokens == "" or output_tokens == "" or cache_read_tokens == "" or cache_create_tokens == "" or token_source == "" or token_provider_raw == "" or knowledge == "":
        print "Error: completion token receipt fields are required; use 'unavailable' and 'none' explicitly"
        print_help()
        return 1

    if not _token_field_valid(input_tokens) or not _token_field_valid(output_tokens) or not _token_field_valid(cache_read_tokens) or not _token_field_valid(cache_create_tokens):
        print "Error: token fields must be nonnegative decimal integers or literal 'unavailable'"
        return 1

    val input_value = _token_value(input_tokens)
    val output_value = _token_value(output_tokens)
    val cache_read_value = _token_value(cache_read_tokens)
    val cache_create_value = _token_value(cache_create_tokens)
    val numeric_usage = input_value >= 0 and output_value >= 0 and cache_read_value >= 0 and cache_create_value >= 0
    var total_tokens: i64 = -1
    if numeric_usage:
        if input_value > 9223372036854775807 - output_value:
            print "Error: token total overflow"
            return 1
        val first_total = input_value + output_value
        if first_total > 9223372036854775807 - cache_read_value:
            print "Error: token total overflow"
            return 1
        val second_total = first_total + cache_read_value
        if second_total > 9223372036854775807 - cache_create_value:
            print "Error: token total overflow"
            return 1
        total_tokens = second_total + cache_create_value

    val timestamp = date_str
    val token_provider = token_provider_raw

    val db_opt = load_bug_database(BUG_DB_PATH)
    var db = match db_opt:
        case Some(value): value
        case nil:
            print "Error: could not load bug database at {BUG_DB_PATH}"
            return 1

    val token_category = db.token_category_for_bug(id)
    val average_value = db.comparable_token_average(token_category, id)
    if average_value == -2:
        print "Error: comparable token cohort is invalid or overflows"
        return 1
    val above_twice_average = total_tokens >= 0 and average_value >= 0 and average_value <= 4611686018427387903 and total_tokens > average_value * 2
    if above_twice_average:
        if knowledge == "none" or not _knowledge_path_allowed(knowledge) or not file_exists(knowledge):
            print "Error: token usage exceeds 2x derived average; --knowledge must name an existing repository knowledge artifact"
            return 1
    val any_unavailable = input_value < 0 or output_value < 0 or cache_read_value < 0 or cache_create_value < 0
    val all_unavailable = input_value < 0 and output_value < 0 and cache_read_value < 0 and cache_create_value < 0
    if any_unavailable and not all_unavailable:
        if knowledge == "none" or not _knowledge_path_allowed(knowledge) or not file_exists(knowledge):
            print "Error: partial token usage cannot be compared; --knowledge must name an existing repository knowledge artifact"
            return 1

    val total_text = if total_tokens >= 0: "{total_tokens}" else: "unavailable"
    val average_text = if average_value >= 0: "{average_value}" else: "unavailable"
    val token_receipt = "token_usage category={token_category} provider={token_provider} input={input_tokens} output={output_tokens} cache_read={cache_read_tokens} cache_create={cache_create_tokens} total={total_text} source={token_source} comparable_average={average_text} knowledge={knowledge}"
    if not db.add_investigation_log(id, token_receipt):
        print "Error: bug '{id}' not found in database"
        return 1
    if not db.add_token_usage(id, token_category, token_provider, input_value, output_value, cache_read_value, cache_create_value, total_tokens, token_source, knowledge, timestamp):
        print "Error: failed to store structured bug token usage"
        return 1

    if not db.resolve_bug(id, timestamp):
        print "Error: bug '{id}' could not be resolved atomically"
        return 1
    if not db.save():
        print "Error: failed to save bug database"
        return 1

    if log_opts.progress != "summary":
        val progress_line = render_progress(log_opts.progress, 1, 1, "bug-resolve")
        if progress_line != "":
            print progress_line
    if as_json:
        print "{\"command\":\"bug-resolve\",\"status\":\"ok\",\"id\":\"" + id + "\",\"updated_at\":\"" + timestamp + "\"}"
    else:
        print "Resolved bug {id} (status: Closed, updated_at: {timestamp})"
    0
