@allow(primitive_api)
# `simple counterpart build` — compile an adapter into the content-addressed
# cache and record what was built.
#
# The build writes three things next to the artifact: the artifact itself,
# `provider.manifest.sdn` (the descriptor as the loader will see it, carrying
# the artifact hash actually produced) and `build.receipt.sdn` (the inputs that
# produced it). The receipt is what makes a later `verify` meaningful — without
# it, a matching hash only proves the file did not change, not that it came
# from the locked inputs.
#
# Building never marks a provider verified. `verify` does that, by re-hashing.

use std.io_runtime.{file_exists, mkdir_p, process_run, write_file}
use std.nogc_sync_mut.spec.evidence.counterpart.package_registry.{
    COUNTERPART_LOCK_PATH,
    LockRecord,
    ProviderDescriptor,
    artifact_path_for,
    artifact_sha256_of_file,
    build_digest,
    cache_dir_for,
    descriptor_rejections,
    load_lock_file,
    lock_record_for,
    manifest_path_for,
    receipt_path_for
}
use app.counterpart.inspect.{descriptors_for}

# The counterpart C ABI header (lane F1). Every adapter includes it, so the
# include root is a framework constant rather than something each descriptor
# repeats and can get wrong.
pub val COUNTERPART_SDK_INCLUDE: text = "tools/counterpart/sdk/c"

pub fn render_provider_manifest(
    descriptor: ProviderDescriptor,
    record: LockRecord,
    artifact_hash: text
) -> text:
    var out = "# Generated by `simple counterpart build`. Do not edit.\n"
    out = out + "provider_manifest:\n"
    out = out + "  provider_id: " + descriptor.provider_id + "\n"
    out = out + "  provider_kind: " + descriptor.provider_kind + "\n"
    out = out + "  independence_group: " + descriptor.independence_group + "\n"
    out = out + "  abi_version: " + descriptor.abi_version.to_text() + "\n"
    out = out + "  license_spdx: " + descriptor.license_spdx + "\n"
    out = out + "  target_triple: " + record.target_triple + "\n"
    out = out + "  artifact_hash: " + artifact_hash + "\n"
    out = out + "  components:\n"
    for component in descriptor.components:
        out = out + "    - component_id: " + component.component_id + "\n"
        out = out + "      counterpart_boundary_id: " + component.counterpart_boundary_id + "\n"
        out = out + "      deterministic_claim: " + component.deterministic_claim + "\n"
    out

pub fn render_build_receipt(
    descriptor: ProviderDescriptor,
    record: LockRecord,
    digest: text,
    artifact_hash: text
) -> text:
    var out = "# Generated by `simple counterpart build`. Do not edit.\n"
    out = out + "build_receipt:\n"
    out = out + "  provider_id: " + descriptor.provider_id + "\n"
    out = out + "  build_digest: " + digest + "\n"
    out = out + "  adapter_source: " + descriptor.adapter_source + "\n"
    out = out + "  upstream_revision: " + record.upstream_revision + "\n"
    out = out + "  build_recipe_version: " + record.build_recipe_version.to_text() + "\n"
    out = out + "  toolchain_identity: " + record.toolchain_identity + "\n"
    out = out + "  target_triple: " + record.target_triple + "\n"
    out = out + "  build_options: " + record.build_options + "\n"
    out = out + "  license_spdx: " + record.license_spdx + "\n"
    out = out + "  artifact_sha256: " + artifact_hash + "\n"
    out = out + "  locked_artifact_sha256: " + record.artifact_sha256 + "\n"
    out

fn build_one(descriptor: ProviderDescriptor, record: LockRecord) -> i64:
    val contract_failures = descriptor_rejections(descriptor, record.artifact_sha256)
    if contract_failures.len() > 0:
        print "counterpart build: descriptor for '{descriptor.provider_id}' is rejected"
        for failure in contract_failures:
            print "  {failure}"
        return 1
    if not file_exists(descriptor.adapter_source):
        print "counterpart build: adapter source '{descriptor.adapter_source}' does not exist"
        return 1

    val digest = build_digest(descriptor, record)
    val cache_dir = cache_dir_for(record.target_triple, digest)
    val artifact = artifact_path_for(descriptor, record.target_triple, digest)
    mkdir_p(cache_dir)

    val compiler = if record.toolchain_identity == "host-cc": "cc" else: record.toolchain_identity
    val (_stdout, stderr, code) = process_run("/bin/sh", ["-c",
        "{compiler} {record.build_options} -I'{COUNTERPART_SDK_INCLUDE}' -o '{artifact}' '{descriptor.adapter_source}'"])
    if code != 0:
        print "counterpart build: compile failed rc={code}"
        print stderr
        return 1

    val artifact_hash = artifact_sha256_of_file(artifact)
    if artifact_hash == "":
        print "counterpart build: compiler reported success but produced no artifact at {artifact}"
        return 1

    write_file(manifest_path_for(record.target_triple, digest),
        render_provider_manifest(descriptor, record, artifact_hash))
    write_file(receipt_path_for(record.target_triple, digest),
        render_build_receipt(descriptor, record, digest, artifact_hash))

    print "counterpart build: {descriptor.provider_id} -> {artifact}"
    print "  artifact_sha256: {artifact_hash}"
    if artifact_hash != record.artifact_sha256:
        print "  NOTE: this differs from the locked artifact_sha256 ({record.artifact_sha256});"
        print "  the provider stays UNVERIFIED until the lockfile records this digest."
    0

pub fn run_build(provider_id: text) -> i64:
    val descriptors = descriptors_for(provider_id)
    if descriptors.len() == 0:
        print "counterpart build: no descriptor for '{provider_id}'"
        return 1
    val records = load_lock_file(COUNTERPART_LOCK_PATH)
    var worst: i64 = 0
    for descriptor in descriptors:
        if val record = lock_record_for(records, descriptor.provider_id):
            val code = build_one(descriptor, record)
            if code != 0:
                worst = code
        else:
            print "counterpart build: '{descriptor.provider_id}' has no lock record; refusing to build an unpinned provider"
            worst = 1
    worst
