"""Native u32 array transport diagnostic for ProcessingIR receipts."""

struct U32TransportResult:
    values: [u32]

fn _pushed(count: i64, value: u32) -> [u32]:
    var values: [u32] = []
    var index: i64 = 0
    while index < count:
        values.push(value)
        index = index + 1
    values

fn _fixed(count: i64, value: u32) -> [u32]:
    var values: [u32] = [0u32; count]
    var index: i64 = 0
    while index < count:
        values[index] = value
        index = index + 1
    values

fn _wrapped(count: i64, value: u32) -> U32TransportResult:
    U32TransportResult(values: _pushed(count, value))

fn _check(label: text, values: [u32], expected: u32) -> bool:
    var checksum: u64 = 0
    var mismatches: i64 = 0
    for value in values:
        checksum = checksum + value.to_u64()
        if value != expected:
            mismatches = mismatches + 1
    var indexed_mismatches: i64 = 0
    var index: i64 = 0
    while index < values.len().to_i64():
        if values[index] != expected:
            indexed_mismatches = indexed_mismatches + 1
        index = index + 1
    val first = if values.len() > 0: values[0] else: 0u32
    val valid = values.len() == 64 and checksum == 1082179840u64 and
        mismatches == 0 and indexed_mismatches == 0 and first == expected
    val status = if valid: "pass" else: "fail"
    print("U32_TRANSPORT case={label} status={status} count={values.len()} first={first} checksum={checksum} iterator_mismatches={mismatches} indexed_mismatches={indexed_mismatches}\n")
    valid

fn main() -> i64:
    val expected = 0x01020304u32
    val local_push = _pushed(64, expected)
    val local_fixed = _fixed(64, expected)
    val returned = _pushed(64, expected)
    val wrapped = _wrapped(64, expected)
    val local_push_valid = _check("local-push", local_push, expected)
    val local_fixed_valid = _check("local-fixed", local_fixed, expected)
    val returned_valid = _check("returned", returned, expected)
    val wrapped_valid = _check("wrapped", wrapped.values, expected)
    val valid = local_push_valid and local_fixed_valid and
        returned_valid and wrapped_valid
    if valid: 0 else: 1
