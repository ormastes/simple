# Explainable seven-dimension scoring with an effective blocker cap.
use app.sspec_maintain.model.*

fn _score_clamp(value: i64) -> i64:
    if value < 0: return 0
    if value > 100: return 100
    value

fn score_sspec_findings(findings: [SspecDocumentizationFinding]) -> SspecDocumentizationScore:
    var narrative: i64 = 100
    var structure: i64 = 100
    var oracle: i64 = 100
    var traceability: i64 = 100
    var evidence: i64 = 100
    var coverage: i64 = 100
    var maintainability: i64 = 100
    var blockers: i64 = 0
    for finding in findings:
        if finding.dimension == "narrative": narrative = narrative - finding.score_deduction
        elif finding.dimension == "structure": structure = structure - finding.score_deduction
        elif finding.dimension == "oracle": oracle = oracle - finding.score_deduction
        elif finding.dimension == "traceability": traceability = traceability - finding.score_deduction
        elif finding.dimension == "evidence": evidence = evidence - finding.score_deduction
        elif finding.dimension == "coverage": coverage = coverage - finding.score_deduction
        elif finding.dimension == "maintainability": maintainability = maintainability - finding.score_deduction
        if finding.blocker: blockers = blockers + 1
    narrative = _score_clamp(narrative)
    structure = _score_clamp(structure)
    oracle = _score_clamp(oracle)
    traceability = _score_clamp(traceability)
    evidence = _score_clamp(evidence)
    coverage = _score_clamp(coverage)
    maintainability = _score_clamp(maintainability)
    val raw = (narrative * 15 + structure * 15 + oracle * 20 +
        traceability * 15 + evidence * 15 + coverage * 10 + maintainability * 10) / 100
    val effective = if blockers > 0 and raw > 49: 49 else: raw
    SspecDocumentizationScore(narrative: narrative, structure: structure,
        oracle: oracle, traceability: traceability, evidence: evidence,
        coverage: coverage, maintainability: maintainability,
        raw_aggregate: raw, effective_aggregate: effective, aggregate: effective,
        blocker_count: blockers, blockers: blockers,
        release_ready: blockers == 0)

