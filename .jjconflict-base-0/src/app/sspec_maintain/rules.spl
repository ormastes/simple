# Stable, explainable SSDOC rule catalog. SPIPE001..007 remain lint-owned.
use app.sspec_maintain.model.*

fn sspec_rule_definitions() -> [SspecRuleDefinition]:
    [
        SspecRuleDefinition(rule_id: "SSDOC-NAR-001", dimension: "narrative", default_severity: "warning", deduction: 20, blocker: false, title: "Missing authored purpose", detection: "No purpose or audience narrative is present.", rationale: "Readers need scope, audience, and intent before executable detail.", false_positive_limits: "Accepts either a Purpose heading or an authored purpose section.", suppression_policy: "Suppress only with rule ID, owner, and reason.", safe_edit: false),
        SspecRuleDefinition(rule_id: "SSDOC-NAR-002", dimension: "narrative", default_severity: "warning", deduction: 20, blocker: false, title: "Placeholder narrative", detection: "Generic TODO or filler prose is visible.", rationale: "Generated filler is not specification content.", false_positive_limits: "Matches only known placeholder phrases.", suppression_policy: "Replace the phrase; do not suppress permanent filler.", safe_edit: false),
        SspecRuleDefinition(rule_id: "SSDOC-BEH-001", dimension: "structure", default_severity: "warning", deduction: 10, blocker: false, title: "Scenario has no visible step", detection: "An executable scenario contains no step call.", rationale: "Ordered visible actions make the manual operable.", false_positive_limits: "Applied per scenario and capped at 40 points.", suppression_policy: "Suppress only for declarative one-oracle scenarios with a reason.", safe_edit: false),
        SspecRuleDefinition(rule_id: "SSDOC-BEH-002", dimension: "structure", default_severity: "advice", deduction: 5, blocker: false, title: "Scenario name is not an outcome", detection: "The name uses test-speak or a generic placeholder.", rationale: "Outcome names describe product behavior rather than test mechanics.", false_positive_limits: "Uses a conservative vocabulary of known test-speak.", suppression_policy: "Suppress domain terms that coincide with the vocabulary.", safe_edit: false),
        SspecRuleDefinition(rule_id: "SSDOC-ORA-001", dimension: "oracle", default_severity: "blocker", deduction: 50, blocker: true, title: "No real executed assertion", detection: "No non-placeholder assertion exists or pending scaffolds remain.", rationale: "A passing-looking document without an oracle is not conformance evidence.", false_positive_limits: "Recognizes expectation, assertion, and compiler-oracle calls.", suppression_policy: "Blockers require implementation, not suppression.", safe_edit: false),
        SspecRuleDefinition(rule_id: "SSDOC-ORA-002", dimension: "oracle", default_severity: "blocker", deduction: 50, blocker: true, title: "Pseudo-system oracle", detection: "A scenario asserts only source text or locally constructed arithmetic.", rationale: "Source presence or self-created arithmetic does not demonstrate production behavior.", false_positive_limits: "Flags explicit source-text assertions and literal/local self-equality patterns.", suppression_policy: "Replace the invented oracle; blockers cannot be suppressed.", safe_edit: false),
        SspecRuleDefinition(rule_id: "SSDOC-ORA-003", dimension: "oracle", default_severity: "advice", deduction: 10, blocker: false, title: "Unexplained expected literal", detection: "A numeric expected value has no named oracle or explanation marker.", rationale: "Reviewers need to know why a magic expected value is authoritative.", false_positive_limits: "A named expected value or '# oracle:'/'# explained:' marker avoids the finding.", suppression_policy: "Suppress only when an external cited oracle fixes the literal.", safe_edit: false),
        SspecRuleDefinition(rule_id: "SSDOC-TRC-001", dimension: "traceability", default_severity: "warning", deduction: 20, blocker: false, title: "Missing requirement identity", detection: "No REQ or @req identity is present.", rationale: "Stable requirement identity connects intent, implementation, and evidence.", false_positive_limits: "Does not validate external registries.", suppression_policy: "Suppress only when the suite is explicitly non-requirement evidence.", safe_edit: false),
        SspecRuleDefinition(rule_id: "SSDOC-TRC-002", dimension: "traceability", default_severity: "blocker", deduction: 40, blocker: true, title: "Requirement is planned but not implemented", detection: "Selected/planned requirement annotations outnumber implemented bindings.", rationale: "Planned annotations cannot be reported as implemented coverage.", false_positive_limits: "Requires explicit selected or planned markers.", suppression_policy: "Resolve the binding or retain explicit blocked status.", safe_edit: false),
        SspecRuleDefinition(rule_id: "SSDOC-TRC-003", dimension: "traceability", default_severity: "blocker", deduction: 40, blocker: true, title: "Dangling requirement identity", detection: "A declared requirement ID is not bound inside any executable scenario.", rationale: "A requirement list without scenario evidence is inventory, not traceability.", false_positive_limits: "Compares stable REQ IDs declared anywhere with IDs bound in scenario bodies.", suppression_policy: "Bind the requirement or mark it explicitly blocked; do not suppress.", safe_edit: false),
        SspecRuleDefinition(rule_id: "SSDOC-EVD-001", dimension: "evidence", default_severity: "warning", deduction: 10, blocker: false, title: "Visible scenario lacks evidence", detection: "A stepped user/operator scenario has no capture or evidence declaration.", rationale: "Professional manuals need retained observable evidence.", false_positive_limits: "Applied only to scenarios with visible steps and capped at 30.", suppression_policy: "Suppress when the assertion itself is the complete typed evidence.", safe_edit: false),
        SspecRuleDefinition(rule_id: "SSDOC-COV-001", dimension: "coverage", default_severity: "advice", deduction: 20, blocker: false, title: "No adverse-path coverage", detection: "No negative, boundary, recovery, unsupported, or ambiguity case is named.", rationale: "Specifications should explain behavior outside the happy path.", false_positive_limits: "A source-level heuristic; requirement-aware adapters may supersede it.", suppression_policy: "Suppress when the requirement source defines no adverse behavior.", safe_edit: false),
        SspecRuleDefinition(rule_id: "SSDOC-MNT-001", dimension: "maintainability", default_severity: "advice", deduction: 15, blocker: false, title: "Flat scenario presentation", detection: "Multiple scenarios have no supported manual/folding organization.", rationale: "Long flat dumps obscure the primary workflow.", false_positive_limits: "Requires more than one scenario.", suppression_policy: "Suppress for intentionally short reference tables.", safe_edit: false),
        SspecRuleDefinition(rule_id: "SSDOC-MNT-002", dimension: "maintainability", default_severity: "warning", deduction: 25, blocker: false, title: "Missing or stale mirrored manual", detection: "The canonical doc/06_spec mirror is absent or lacks current source identity.", rationale: "Living documentation must be generated from the current executable source.", false_positive_limits: "Only evaluated when a source/manual pair is requested.", suppression_policy: "Regenerate or record an explicit non-documentized scope.", safe_edit: false),
        SspecRuleDefinition(rule_id: "SSDOC-MNT-003", dimension: "maintainability", default_severity: "warning", deduction: 10, blocker: false, title: "Invalid bare step annotation", detection: "A standalone @step form is used instead of supported metadata.", rationale: "Unsupported annotations silently disappear from generated manuals.", false_positive_limits: "Matches only line-start bare @step forms.", suppression_policy: "No suppression; apply the certain syntax fix.", safe_edit: true),
        SspecRuleDefinition(rule_id: "SSDOC-MNT-004", dimension: "maintainability", default_severity: "warning", deduction: 10, blocker: false, title: "Internal tag leaks into reader output", detection: "Internal execution tags are present in reader-facing source or manual.", rationale: "Reader manuals should expose outcomes, not harness routing.", false_positive_limits: "Matches explicit internal-only tag names.", suppression_policy: "Suppress only if the tag is intentionally documented.", safe_edit: false),
        SspecRuleDefinition(rule_id: "SSDOC-MNT-005", dimension: "maintainability", default_severity: "advice", deduction: 10, blocker: false, title: "Missing verification or troubleshooting guidance", detection: "The manual lacks verification or troubleshooting sections.", rationale: "Operators need recovery and evidence interpretation guidance.", false_positive_limits: "Satisfied by either explicit verification and troubleshooting facts.", suppression_policy: "Suppress for library-only specifications with no operator workflow.", safe_edit: false),
        SspecRuleDefinition(rule_id: "SSDOC-MNT-006", dimension: "maintainability", default_severity: "advice", deduction: 10, blocker: false, title: "Repeated unnamed setup", detection: "Repeated setup is not represented by a domain-named helper.", rationale: "Named setup helpers keep scenarios concise and consistent.", false_positive_limits: "Conservative source heuristic; does not infer semantic duplication.", suppression_policy: "Suppress when repetition is deliberately scenario-local.", safe_edit: false),
        SspecRuleDefinition(rule_id: "SSDOC-MNT-007", dimension: "maintainability", default_severity: "advice", deduction: 10, blocker: false, title: "Lifecycle metadata is incomplete", detection: "Research, plan, architecture, or design links are absent.", rationale: "Reviewers need selected lifecycle evidence, not inferred project state.", false_positive_limits: "Repository policy may configure this rule for small isolated specs.", suppression_policy: "Suppress with scope, owner, and reason.", safe_edit: false),
        SspecRuleDefinition(rule_id: "SSDOC-EVD-002", dimension: "evidence", default_severity: "warning", deduction: 15, blocker: false, title: "Steps are absent from the manual", detection: "Executable steps do not appear in the generated manual.", rationale: "Source tokens alone do not prove reader-visible workflow structure.", false_positive_limits: "Evaluated only when a manual is supplied.", suppression_policy: "Fix supported visibility metadata or explain an intentionally hidden detail flow.", safe_edit: false),
        SspecRuleDefinition(rule_id: "SSDOC-EVD-003", dimension: "evidence", default_severity: "warning", deduction: 15, blocker: false, title: "Captures are absent from the manual", detection: "Declared source captures do not render as evidence.", rationale: "Retained evidence must be visible or linked from the professional manual.", false_positive_limits: "Evaluated only when source captures exist.", suppression_policy: "Select a supported display or document an external evidence reference.", safe_edit: false),
        SspecRuleDefinition(rule_id: "SSDOC-MNT-008", dimension: "maintainability", default_severity: "warning", deduction: 20, blocker: false, title: "Incomplete professional manual", detection: "The generated mirror lacks one or more required operator-specification sections.", rationale: "A test dump is not a complete professional specification manual.", false_positive_limits: "Checks section concepts, not exact heading spelling.", suppression_policy: "Suppress only for a bounded non-operator document with owner and reason.", safe_edit: false),
        SspecRuleDefinition(rule_id: "SSDOC-MNT-009", dimension: "maintainability", default_severity: "warning", deduction: 10, blocker: false, title: "Stale lifecycle link", detection: "A declared research, plan, architecture, or design path does not exist.", rationale: "Traceability metadata must resolve to current review evidence.", false_positive_limits: "Filesystem validation runs only for repository-backed CLI scans.", suppression_policy: "Update the path or suppress with owner, reason, and fingerprint.", safe_edit: false)
    ]

fn sspec_rule_definition(rule_id: text) -> Option<SspecRuleDefinition>:
    for rule in sspec_rule_definitions():
        if rule.rule_id == rule_id:
            return Some(rule)
    None

fn sspec_lint_rule_references() -> [text]:
    "SPIPE correctness remains lint-owned; maintenance reports reference these IDs without reimplementing them."
    ["SPIPE001", "SPIPE002", "SPIPE003", "SPIPE004", "SPIPE005", "SPIPE006", "SPIPE007"]
