# Durable generation tombstone independent from the contended lifecycle CAS.
# The receipt authority signs the complete request-bound error record so a
# restart can deny the whole generation and replay the exact losing response.
use app.spipe_knowledge_provider.lifecycle.{ReceiptAuthorityPort, provider_generation_id}
use app.spipe_knowledge_provider.protocol.{provider_bound_error}
use app.spipe_knowledge_provider.wire_json.{wire_canonical_json_value, wire_has_exact_keys, wire_json_string, wire_valid_hash, wire_valid_id, wire_valid_snapshot_id}
use std.common.crypto.sha256.{sha256_u8_hex}
use std.common.string_core.{text_to_bytes}
use std.common.json.parser.{json_parse_with_error}
use std.common.json.object_ops.{json_object_get}
use std.common.json.types.{json_get_type, json_to_string}

val GENERATION_QUARANTINE_SCHEMA = "spipe-provider-generation-quarantine-v1"
val GENERATION_QUARANTINE_DOMAIN = "SPKC-GENERATION-QUARANTINE-V1\0"
val GENERATION_QUARANTINE_DETAIL = "provider generation closed after bounded lifecycle contention"

fn _text(value: any, key: text) -> text:
    val item = json_to_string(json_object_get(value, key))
    if item == nil: "" else: item

fn _domain_bytes(canonical_unsigned: text) -> [u8]:
    var out = text_to_bytes(GENERATION_QUARANTINE_DOMAIN)
    val size = canonical_unsigned.bytes().len()
    var shift = 56
    while shift >= 0:
        out.push(((size >> shift) & 255) as u8)
        shift = shift - 8
    val payload = canonical_unsigned.bytes()
    var i = 0
    while i < payload.len():
        out.push(payload[i])
        i = i + 1
    out

fn _unsigned(base_logical_root: text, candidate_uid: text,
             operation_id: text, payload_hash: text,
             provider_generation: text, request_id: text,
             response: text, result_logical_root: text,
             scope_digest: text, snapshot: text,
             workspace: text) -> text:
    "{\"base_logical_root\":" + wire_json_string(base_logical_root) +
        ",\"candidate_uid\":" + wire_json_string(candidate_uid) +
        ",\"operation\":\"index_publish\",\"operation_id\":" +
        wire_json_string(operation_id) + ",\"payload_hash\":" +
        wire_json_string(payload_hash) + ",\"provider_generation\":" +
        wire_json_string(provider_generation) + ",\"request_id\":" +
        wire_json_string(request_id) + ",\"response\":" + response +
        ",\"response_hash\":\"sha256:" +
        sha256_u8_hex(text_to_bytes(response)) +
        "\",\"result_logical_root\":" + wire_json_string(result_logical_root) +
        ",\"schema\":" + wire_json_string(GENERATION_QUARANTINE_SCHEMA) +
        ",\"scope_digest\":" + wire_json_string(scope_digest) +
        ",\"snapshot\":" + wire_json_string(snapshot) +
        ",\"workspace\":" + wire_json_string(workspace) + "}"

fn generation_quarantine_error_response(provider_generation: i64,
                                        workspace: text, snapshot: text,
                                        scope_digest: text,
                                        request_id: text) -> text:
    provider_bound_error(request_id, "index_publish",
        provider_generation_id(provider_generation), workspace, snapshot,
        scope_digest, "fatal_provider_error", GENERATION_QUARANTINE_DETAIL)

fn create_generation_quarantine_record(authority: ReceiptAuthorityPort,
                                       provider_generation: i64,
                                       workspace: text, snapshot: text,
                                       scope_digest: text,
                                       request_id: text, operation_id: text,
                                       payload_hash: text,
                                       candidate_uid: text,
                                       base_logical_root: text,
                                       result_logical_root: text) -> Result<(text, text), text>:
    val generation = provider_generation_id(provider_generation)
    if not authority.available() or generation == "" or
            not wire_valid_id(workspace) or not wire_valid_snapshot_id(snapshot) or
            not wire_valid_hash(scope_digest) or not wire_valid_id(request_id) or
            not wire_valid_id(operation_id) or not wire_valid_hash(payload_hash) or
            not wire_valid_id(candidate_uid) or
            not wire_valid_hash(base_logical_root) or
            not wire_valid_hash(result_logical_root):
        return Err("fatal_provider_error")
    val response = generation_quarantine_error_response(provider_generation,
        workspace, snapshot, scope_digest, request_id)
    val unsigned = _unsigned(base_logical_root, candidate_uid, operation_id,
        payload_hash, generation, request_id, response, result_logical_root,
        scope_digest, snapshot, workspace)
    val signing = _domain_bytes(unsigned)
    val quarantine_id = "gq-" + sha256_u8_hex(signing)
    val signature = authority.sign(signing)?
    val with_id = unsigned.replace("\"request_id\":", "\"quarantine_id\":" +
        wire_json_string(quarantine_id) + ",\"request_id\":")
    val complete = with_id.replace("\"snapshot\":", "\"signature\":" +
        wire_json_string(signature) + ",\"snapshot\":")
    Ok((complete, response))

fn _validated_generation_quarantine(record: text,
                                    authority: ReceiptAuthorityPort,
                                    provider_generation: i64,
                                    workspace: text, snapshot: text,
                                    scope_digest: text) -> Result<any, text>:
    if record == "": return Err("generation_quarantine_missing")
    val parsed = json_parse_with_error(record)
    if parsed.1 != "" or not wire_has_exact_keys(parsed.0,
            ["base_logical_root", "candidate_uid", "operation", "operation_id",
             "payload_hash", "provider_generation", "quarantine_id", "request_id",
             "response", "response_hash", "result_logical_root", "schema",
             "scope_digest", "signature", "snapshot", "workspace"]):
        return Err("snapshot_corrupt")
    val root = parsed.0
    val canonical = wire_canonical_json_value(root)
    val response_value = json_object_get(root, "response")
    val response = wire_canonical_json_value(response_value)
    if val Err(_) = canonical: return Err("snapshot_corrupt")
    if val Err(_) = response: return Err("snapshot_corrupt")
    if canonical.unwrap() != record or json_get_type(response_value) != "object":
        return Err("snapshot_corrupt")
    val request_id = _text(root, "request_id")
    val generation = provider_generation_id(provider_generation)
    val expected_response = generation_quarantine_error_response(
        provider_generation, workspace, snapshot, scope_digest, request_id)
    if _text(root, "schema") != GENERATION_QUARANTINE_SCHEMA or
            _text(root, "operation") != "index_publish" or
            _text(root, "provider_generation") != generation or
            _text(root, "workspace") != workspace or
            _text(root, "snapshot") != snapshot or
            _text(root, "scope_digest") != scope_digest or
            not wire_valid_id(request_id) or
            not wire_valid_id(_text(root, "operation_id")) or
            not wire_valid_hash(_text(root, "payload_hash")) or
            not wire_valid_id(_text(root, "candidate_uid")) or
            not wire_valid_hash(_text(root, "base_logical_root")) or
            not wire_valid_hash(_text(root, "result_logical_root")) or
            response.unwrap() != expected_response or
            _text(root, "response_hash") != "sha256:" +
                sha256_u8_hex(text_to_bytes(response.unwrap())):
        return Err("snapshot_corrupt")
    val unsigned = _unsigned(_text(root, "base_logical_root"),
        _text(root, "candidate_uid"), _text(root, "operation_id"),
        _text(root, "payload_hash"), generation, request_id,
        response.unwrap(), _text(root, "result_logical_root"), scope_digest,
        snapshot, workspace)
    val signing = _domain_bytes(unsigned)
    if _text(root, "quarantine_id") != "gq-" + sha256_u8_hex(signing) or
            not authority.verify(signing, _text(root, "signature")):
        return Err("snapshot_corrupt")
    Ok(root)

fn generation_quarantine_is_bound(record: text,
                                  authority: ReceiptAuthorityPort,
                                  provider_generation: i64,
                                  workspace: text, snapshot: text,
                                  scope_digest: text) -> Result<bool, text>:
    if record == "": return Ok(false)
    val _ = _validated_generation_quarantine(record, authority,
        provider_generation, workspace, snapshot, scope_digest)?
    Ok(true)

fn generation_quarantine_replay(record: text,
                                authority: ReceiptAuthorityPort,
                                provider_generation: i64,
                                workspace: text, snapshot: text,
                                scope_digest: text,
                                operation_id: text,
                                payload_hash: text) -> Result<text, text>:
    if record == "": return Ok("")
    val root = _validated_generation_quarantine(record, authority,
        provider_generation, workspace, snapshot, scope_digest)?
    if _text(root, "operation_id") != operation_id:
        return Err("fatal_provider_error")
    if _text(root, "payload_hash") != payload_hash:
        return Err("operation_conflict")
    val response = wire_canonical_json_value(json_object_get(root, "response"))
    if val Err(_) = response: return Err("snapshot_corrupt")
    Ok(response.unwrap())
