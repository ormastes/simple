# codex-impl
# Deterministic release/main convergence planning plus a bounded, read-only Git
# observation boundary. Neither surface selects, applies, integrates, or pushes.

use app.io.mod.{process_run_bounded}
use app.release.policy.{ReleaseSession}
use app.release.session_authority.{verify_release_session}

struct ReviewedBugFix:
    commit_sha: text
    review_receipt_sha256: text
    source_ref: text
    change_kind: text

struct ConvergenceRequest:
    last_scanned_main_sha: text
    current_main_sha: text
    release_ref: text
    release_head_sha: text
    last_scan_epoch_seconds: i64
    current_epoch_seconds: i64
    scan_interval_seconds: i64
    eligible_reviewed_bug_fixes: [ReviewedBugFix]
    selected_bug_fix_shas: [text]
    caller_selection_confirmed: bool
    direction: text
    forward_port_required: bool
    forward_port_target_ref: text
    main_tracks_release: bool

struct ConvergenceReceipt:
    valid: bool
    ready: bool
    reason: text
    mutation: text
    last_scanned_main_sha: text
    current_main_sha: text
    release_ref: text
    release_head_sha: text
    scan_interval_seconds: i64
    scan_due: bool
    eligible_reviewed_bug_fix_shas: [text]
    selected_bug_fix_shas: [text]
    caller_selection_required: bool
    direction: text
    forward_port_required: bool
    forward_port_target_ref: text
    main_remains_independent: bool

struct GitConvergenceObservation:
    valid: bool
    reason: text
    mutation: text
    fetched_main_sha: text
    fetched_release_sha: text
    source_sha: text
    target_sha: text
    source_only_commit_shas: [text]
    selected_bug_fix_shas: [text]
    selected_exactly_reviewed: bool
    selected_reachable_from_source: bool
    selected_absent_from_target: bool
    main_remains_independent: bool
    plan: ConvergenceReceipt

struct PostIntegrationDivergenceRequest:
    direction: text
    release_ref: text
    source_head_before: text
    target_head_before: text
    result_commit_sha: text
    selected_bug_fix_shas: [text]
    review_receipt_sha256: text
    evidence_receipt_sha256: text
    integration_receipt_sha256: text

struct PostIntegrationDivergenceReceipt:
    valid: bool
    reason: text
    mutation: text
    direction: text
    source_head_before: text
    source_head_after: text
    target_head_before: text
    target_head_after: text
    result_commit_sha: text
    selected_bug_fix_shas: [text]
    review_receipt_sha256: text
    evidence_receipt_sha256: text
    integration_receipt_sha256: text
    source_unchanged: bool
    target_equals_result: bool
    main_remains_independent: bool

# Immutable decision produced by protected integration and consumed by candidate
# admission.  Inventory arrays contain every source-only commit observed in each
# direction.  Every selected main fix has an aligned release-targeted backport
# result and receipt, every release-only commit has an aligned kind and
# classification receipt, and every classified release fix has an aligned
# main-targeted forward-port result and receipt.  Candidate CI independently
# recomputes the inventories and patch bindings before calling this validator,
# so an invented empty receipt cannot hide drift.
struct ConvergenceAdmissionRequest:
    candidate_commit_sha: text
    receipt_candidate_commit_sha: text
    release_ref: text
    main_head_sha: text
    release_head_sha: text
    receipt_sha256: text
    review_summary_sha256: text
    evidence_receipt_sha256: text
    integration_receipt_sha256: text
    inventory_origin: text
    graph_independent: bool
    main_to_release_inventory_shas: [text]
    main_to_release_shared_fix_shas: [text]
    main_to_release_selected_shas: [text]
    main_to_release_backported_shas: [text]
    main_to_release_backport_result_shas: [text]
    main_to_release_backport_target_refs: [text]
    backport_receipt_sha256s: [text]
    release_to_main_inventory_shas: [text]
    release_to_main_classified_shas: [text]
    release_to_main_classification_kinds: [text]
    release_to_main_classification_receipt_sha256s: [text]
    release_to_main_forward_ported_shas: [text]
    release_to_main_forward_port_result_shas: [text]
    release_to_main_forward_port_target_refs: [text]
    forward_port_receipt_sha256s: [text]

struct ConvergenceAdmissionReceipt:
    valid: bool
    reason: text
    mutation: text
    candidate_commit_sha: text
    release_ref: text
    main_head_sha: text
    release_head_sha: text
    receipt_sha256: text
    main_to_release_inventory_count: i64
    main_to_release_selected_count: i64
    release_to_main_inventory_count: i64
    release_to_main_forward_ported_count: i64
    main_remains_independent: bool

fn _empty_plan() -> ConvergenceReceipt:
    ConvergenceReceipt(
        valid: false, ready: false, reason: "observation did not reach planning",
        mutation: "none", last_scanned_main_sha: "", current_main_sha: "",
        release_ref: "", release_head_sha: "", scan_interval_seconds: 0,
        scan_due: false, eligible_reviewed_bug_fix_shas: [], selected_bug_fix_shas: [],
        caller_selection_required: false, direction: "", forward_port_required: false,
        forward_port_target_ref: "", main_remains_independent: true
    )

fn _observation_rejected(reason: text) -> GitConvergenceObservation:
    GitConvergenceObservation(
        valid: false, reason: reason, mutation: "none", fetched_main_sha: "",
        fetched_release_sha: "", source_sha: "", target_sha: "",
        source_only_commit_shas: [],
        selected_bug_fix_shas: [], selected_exactly_reviewed: false,
        selected_reachable_from_source: false, selected_absent_from_target: false,
        main_remains_independent: true, plan: _empty_plan()
    )

fn _convergence_git(root: text, arguments: [text], timeout_ms: i64) -> (text, text, i64):
    process_run_bounded("git", ["-C", root] + arguments, timeout_ms, 1048576)

fn _git_value(root: text, arguments: [text]) -> text:
    val (stdout, _stderr, code) = _convergence_git(root, arguments, 10000)
    if code != 0:
        return ""
    stdout.trim()

fn _refresh_convergence_refs(root: text, release_ref: text) -> text:
    if not _release_ref_valid(release_ref):
        return "release convergence requires a valid release/X.Y ref"
    val main_spec = "+refs/heads/main:refs/remotes/origin/main"
    val release_spec = "+refs/heads/" + release_ref + ":refs/remotes/origin/" + release_ref
    val (_stdout, stderr, code) = _convergence_git(root, ["fetch", "--no-tags", "--prune", "origin", main_spec, release_spec], 30000)
    if code != 0:
        val detail = stderr.trim()
        if detail != "":
            return "bounded convergence fetch failed: " + detail
        return "bounded convergence fetch failed"
    ""

fn _is_ancestor(root: text, ancestor: text, descendant: text) -> bool:
    val (_stdout, _stderr, code) = _convergence_git(root, ["merge-base", "--is-ancestor", ancestor, descendant], 10000)
    code == 0

fn _patch_absent_from_target(root: text, commit_sha: text, target_sha: text) -> bool:
    # `git cherry <target> <commit>^..<commit>` emits `+` only when the exact
    # selected patch is not already represented in the target history.
    val (stdout, _stderr, code) = _convergence_git(
        root, ["cherry", target_sha, commit_sha, commit_sha + "^"], 10000
    )
    code == 0 and stdout.trim().starts_with("+ ")

fn _patch_present_in_target(root: text, commit_sha: text, target_sha: text) -> bool:
    val (stdout, _stderr, code) = _convergence_git(
        root, ["cherry", target_sha, commit_sha, commit_sha + "^"], 10000
    )
    code == 0 and stdout.trim().starts_with("- ")

fn _source_only_commits(root: text, source_sha: text, target_sha: text) -> [text]:
    val (stdout, _stderr, code) = _convergence_git(
        root, ["rev-list", "--topo-order", "--max-count=257", target_sha + ".." + source_sha], 10000
    )
    if code != 0:
        return []
    var commits: [text] = []
    for raw in stdout.split("\n"):
        val commit_sha = raw.trim()
        if commit_sha != "":
            commits.push(commit_sha)
    commits

fn _hex_identity_valid(value: text, expected_len: i64) -> bool:
    if value.len() != expected_len:
        return false
    var i = 0
    while i < value.len():
        val code = value.char_code_at(i)
        val decimal = code >= 48 and code <= 57
        val lowercase_hex = code >= 97 and code <= 102
        if not decimal and not lowercase_hex:
            return false
        i = i + 1
    true

fn _commit_sha_valid(value: text) -> bool:
    _hex_identity_valid(value, 40) or _hex_identity_valid(value, 64)

fn _sha256_valid(value: text) -> bool:
    _hex_identity_valid(value, 64)

fn _release_ref_valid(value: text) -> bool:
    if not value.starts_with("release/"):
        return false
    val line = value[8:].split(".")
    if line.len() != 2 or line[0] == "" or line[1] == "":
        return false
    var i = 0
    while i < line.len():
        val part = line[i]
        var j = 0
        while j < part.len():
            val code = part.char_code_at(j)
            if code < 48 or code > 57:
                return false
            j = j + 1
        i = i + 1
    true

fn _contains(values: [text], expected: text) -> bool:
    for value in values:
        if value == expected:
            return true
    false

fn _has_duplicates(values: [text]) -> bool:
    var i = 0
    while i < values.len():
        var j = i + 1
        while j < values.len():
            if values[i] == values[j]:
                return true
            j = j + 1
        i = i + 1
    false

fn _same_set(left: [text], right: [text]) -> bool:
    if left.len() != right.len():
        return false
    for value in left:
        if not _contains(right, value):
            return false
    true

fn _all_exact_commits(values: [text]) -> bool:
    for value in values:
        if not _commit_sha_valid(value):
            return false
    true

fn _all_exact_receipts(values: [text]) -> bool:
    for value in values:
        if not _sha256_valid(value):
            return false
    true

fn _all_main_targets(values: [text]) -> bool:
    for value in values:
        if value != "main":
            return false
    true

fn _all_targets(values: [text], expected: text) -> bool:
    for value in values:
        if value != expected:
            return false
    true

fn convergence_graph_allowed(source_head_is_ancestor_of_target: bool) -> bool:
    not source_head_is_ancestor_of_target

fn _admission(request: ConvergenceAdmissionRequest, valid: bool,
              reason: text) -> ConvergenceAdmissionReceipt:
    ConvergenceAdmissionReceipt(
        valid: valid, reason: reason, mutation: "none",
        candidate_commit_sha: request.candidate_commit_sha,
        release_ref: request.release_ref, main_head_sha: request.main_head_sha,
        release_head_sha: request.release_head_sha,
        receipt_sha256: request.receipt_sha256,
        main_to_release_inventory_count: request.main_to_release_inventory_shas.len(),
        main_to_release_selected_count: request.main_to_release_selected_shas.len(),
        release_to_main_inventory_count: request.release_to_main_inventory_shas.len(),
        release_to_main_forward_ported_count: request.release_to_main_forward_ported_shas.len(),
        main_remains_independent: request.graph_independent and request.main_head_sha != request.release_head_sha
    )

fn check_convergence_admission(request: ConvergenceAdmissionRequest) -> ConvergenceAdmissionReceipt:
    if (not _commit_sha_valid(request.candidate_commit_sha) or
        not _commit_sha_valid(request.receipt_candidate_commit_sha) or
        not _commit_sha_valid(request.main_head_sha) or
        not _commit_sha_valid(request.release_head_sha)):
        return _admission(request, false, "convergence admission requires exact commit identities")
    if request.candidate_commit_sha != request.receipt_candidate_commit_sha:
        return _admission(request, false, "convergence receipt is not bound to the candidate commit")
    if request.candidate_commit_sha != request.release_head_sha:
        return _admission(request, false, "candidate commit must equal the protected release integration head")
    if not _release_ref_valid(request.release_ref):
        return _admission(request, false, "convergence receipt requires a valid release line")
    if request.main_head_sha == request.release_head_sha:
        return _admission(request, false, "main must remain an independent trunk")
    if not request.graph_independent:
        return _admission(request, false, "main and release must remain graph-independent in both directions")
    if (not _sha256_valid(request.receipt_sha256) or
        not _sha256_valid(request.review_summary_sha256) or
        not _sha256_valid(request.evidence_receipt_sha256) or
        not _sha256_valid(request.integration_receipt_sha256)):
        return _admission(request, false, "convergence receipt requires exact receipt identities")
    if request.inventory_origin != "protected_integration":
        return _admission(request, false, "convergence inventory must originate from protected integration")
    val all_commits = (request.main_to_release_inventory_shas +
        request.main_to_release_shared_fix_shas + request.main_to_release_selected_shas +
        request.main_to_release_backported_shas +
        request.main_to_release_backport_result_shas +
        request.release_to_main_inventory_shas + request.release_to_main_classified_shas +
        request.release_to_main_forward_ported_shas +
        request.release_to_main_forward_port_result_shas)
    if not _all_exact_commits(all_commits):
        return _admission(request, false, "convergence inventory contains a non-exact commit identity")
    if (_has_duplicates(request.main_to_release_inventory_shas) or
        _has_duplicates(request.main_to_release_shared_fix_shas) or
        _has_duplicates(request.main_to_release_selected_shas) or
        _has_duplicates(request.main_to_release_backported_shas) or
        _has_duplicates(request.main_to_release_backport_result_shas) or
        _has_duplicates(request.release_to_main_inventory_shas) or
        _has_duplicates(request.release_to_main_classified_shas) or
        _has_duplicates(request.release_to_main_forward_ported_shas)):
        return _admission(request, false, "convergence inventory and decisions must be unique")
    for shared in request.main_to_release_shared_fix_shas:
        if not _contains(request.main_to_release_inventory_shas, shared):
            return _admission(request, false, "main-to-release shared fix is absent from the reviewed inventory")
    if not _same_set(request.main_to_release_shared_fix_shas, request.main_to_release_selected_shas):
        return _admission(request, false, "every main shared fix must be explicitly selected for backport")
    if not _same_set(request.main_to_release_selected_shas, request.main_to_release_backported_shas):
        return _admission(request, false, "every selected main fix requires a completed backport to the release line")
    val backport_count = request.main_to_release_backported_shas.len()
    if (request.main_to_release_backport_result_shas.len() != backport_count or
        request.main_to_release_backport_target_refs.len() != backport_count or
        request.backport_receipt_sha256s.len() != backport_count):
        return _admission(request, false, "every completed backport requires one result, release target, and exact receipt")
    if (not _all_targets(request.main_to_release_backport_target_refs, request.release_ref) or
        not _all_exact_receipts(request.backport_receipt_sha256s)):
        return _admission(request, false, "every selected main fix requires an exact backport receipt targeting the release line")
    if not _same_set(request.release_to_main_inventory_shas, request.release_to_main_classified_shas):
        return _admission(request, false, "every release-first inventory commit requires an exhaustive receipt-bound classification")
    if (request.release_to_main_classification_kinds.len() != request.release_to_main_classified_shas.len() or
        request.release_to_main_classification_receipt_sha256s.len() != request.release_to_main_classified_shas.len()):
        return _admission(request, false, "every release-first classification requires one kind and one exact receipt")
    if not _all_exact_receipts(request.release_to_main_classification_receipt_sha256s):
        return _admission(request, false, "release-first classification receipt identity is invalid")
    var release_first_fix_shas: [text] = []
    var classification_index = 0
    while classification_index < request.release_to_main_classification_kinds.len():
        val kind = request.release_to_main_classification_kinds[classification_index]
        if kind == "fix":
            release_first_fix_shas.push(request.release_to_main_classified_shas[classification_index])
        elif kind != "non_fix":
            return _admission(request, false, "release-first classification kind must be fix or non_fix")
        classification_index = classification_index + 1
    if not _same_set(release_first_fix_shas, request.release_to_main_forward_ported_shas):
        return _admission(request, false, "every reviewed release-first kind=fix requires a completed forward port to main")
    val forward_count = request.release_to_main_forward_ported_shas.len()
    if (request.release_to_main_forward_port_result_shas.len() != forward_count or
        request.release_to_main_forward_port_target_refs.len() != forward_count or
        request.forward_port_receipt_sha256s.len() != forward_count):
        return _admission(request, false, "every completed forward port requires one result, main target, and exact receipt")
    if (not _all_main_targets(request.release_to_main_forward_port_target_refs) or
        not _all_exact_receipts(request.forward_port_receipt_sha256s)):
        return _admission(request, false, "every release-first fix requires an exact forward-port receipt targeting main")
    _admission(request, true, "reviewed bidirectional convergence is admitted")

fn _receipt(request: ConvergenceRequest, valid: bool, ready: bool, reason: text,
            due: bool, eligible_shas: [text]) -> ConvergenceReceipt:
    ConvergenceReceipt(
        valid: valid,
        ready: ready,
        reason: reason,
        mutation: "none",
        last_scanned_main_sha: request.last_scanned_main_sha,
        current_main_sha: request.current_main_sha,
        release_ref: request.release_ref,
        release_head_sha: request.release_head_sha,
        scan_interval_seconds: request.scan_interval_seconds,
        scan_due: due,
        eligible_reviewed_bug_fix_shas: eligible_shas,
        selected_bug_fix_shas: request.selected_bug_fix_shas,
        caller_selection_required: due and eligible_shas.len() > 0,
        direction: request.direction,
        forward_port_required: request.forward_port_required,
        forward_port_target_ref: request.forward_port_target_ref,
        main_remains_independent: not request.main_tracks_release
    )

fn plan_release_main_convergence(request: ConvergenceRequest) -> ConvergenceReceipt:
    var eligible_shas: [text] = []
    if not _commit_sha_valid(request.last_scanned_main_sha) or not _commit_sha_valid(request.current_main_sha):
        return _receipt(request, false, false, "convergence scan requires exact main revisions", false, eligible_shas)
    if not _release_ref_valid(request.release_ref) or not _commit_sha_valid(request.release_head_sha):
        return _receipt(request, false, false, "convergence scan requires an exact release-line head", false, eligible_shas)
    if request.main_tracks_release:
        return _receipt(request, false, false, "main must remain an independent trunk and never track a release branch", false, eligible_shas)
    if request.scan_interval_seconds <= 0 or request.last_scan_epoch_seconds < 0 or request.current_epoch_seconds < request.last_scan_epoch_seconds:
        return _receipt(request, false, false, "convergence scan requires a positive interval and monotonic timestamps", false, eligible_shas)

    val due = request.current_epoch_seconds - request.last_scan_epoch_seconds >= request.scan_interval_seconds
    if not due:
        if request.eligible_reviewed_bug_fixes.len() > 0 or request.selected_bug_fix_shas.len() > 0:
            return _receipt(request, false, false, "bug-fix candidates cannot be admitted before the convergence scan is due", false, eligible_shas)
        return _receipt(request, true, false, "convergence scan is not due", false, eligible_shas)

    val expected_source_ref = if request.direction == "main_to_release": "main" else: request.release_ref
    if request.direction != "main_to_release" and request.direction != "release_to_main":
        return _receipt(request, false, false, "convergence direction must be main_to_release or release_to_main", true, eligible_shas)

    for fix in request.eligible_reviewed_bug_fixes:
        if not _commit_sha_valid(fix.commit_sha) or not _sha256_valid(fix.review_receipt_sha256):
            return _receipt(request, false, false, "eligible bug fixes require exact commit and review identities", true, eligible_shas)
        if fix.change_kind != "fix" or fix.source_ref != expected_source_ref:
            return _receipt(request, false, false, "eligible candidates must be reviewed bug fixes from the declared direction", true, eligible_shas)
        eligible_shas.push(fix.commit_sha)
    if _has_duplicates(eligible_shas) or _has_duplicates(request.selected_bug_fix_shas):
        return _receipt(request, false, false, "convergence candidates and selections must be unique", true, eligible_shas)

    if request.direction == "main_to_release":
        if request.forward_port_required or request.forward_port_target_ref != "":
            return _receipt(request, false, false, "main-to-release fixes do not claim a forward port", true, eligible_shas)
    else:
        if not request.forward_port_required or request.forward_port_target_ref != "main":
            return _receipt(request, false, false, "release-first fixes require a forward port to main", true, eligible_shas)

    if eligible_shas.len() == 0:
        if request.selected_bug_fix_shas.len() > 0 or request.caller_selection_confirmed:
            return _receipt(request, false, false, "caller selection cannot name an ineligible bug fix", true, eligible_shas)
        return _receipt(request, true, true, "no eligible reviewed bug fixes", true, eligible_shas)
    if not request.caller_selection_confirmed or request.selected_bug_fix_shas.len() == 0:
        return _receipt(request, false, false, "caller must explicitly select eligible bug-fix SHAs", true, eligible_shas)
    for selected in request.selected_bug_fix_shas:
        if not _contains(eligible_shas, selected):
            return _receipt(request, false, false, "caller selection contains an ineligible bug-fix SHA", true, eligible_shas)

    _receipt(request, true, true, "convergence plan is ready for an external guarded VCS adapter", true, eligible_shas)

fn inspect_release_main_convergence(root: text, session: ReleaseSession,
                                    request: ConvergenceRequest) -> GitConvergenceObservation:
    val verified = verify_release_session(root, session)
    if not verified.valid:
        return _observation_rejected("trusted release session rejected convergence observation: " + verified.reason)
    val expected_session_target = if request.direction == "main_to_release": request.release_ref else: "main"
    if session.target_ref != expected_session_target:
        return _observation_rejected("convergence direction does not match the trusted session target")

    val fetch_error = _refresh_convergence_refs(verified.canonical_root, request.release_ref)
    if fetch_error != "":
        return _observation_rejected(fetch_error)
    val main_sha = _git_value(verified.canonical_root, ["rev-parse", "--verify", "refs/remotes/origin/main"])
    val release_sha = _git_value(verified.canonical_root, ["rev-parse", "--verify", "refs/remotes/origin/" + request.release_ref])
    if not _commit_sha_valid(main_sha) or not _commit_sha_valid(release_sha):
        return _observation_rejected("convergence fetch did not resolve exact main and release heads")
    if request.current_main_sha != main_sha or request.release_head_sha != release_sha:
        return _observation_rejected("caller convergence heads do not match freshly fetched Git refs")
    val target_sha_for_session = if request.direction == "main_to_release": release_sha else: main_sha
    if session.expected_target_sha != target_sha_for_session:
        return _observation_rejected("trusted session target changed during convergence fetch")

    val plan = plan_release_main_convergence(request)
    if not plan.valid or not plan.ready:
        return GitConvergenceObservation(
            valid: plan.valid, reason: plan.reason, mutation: "none",
            fetched_main_sha: main_sha, fetched_release_sha: release_sha,
            source_sha: if request.direction == "main_to_release": main_sha else: release_sha,
            target_sha: if request.direction == "main_to_release": release_sha else: main_sha,
            source_only_commit_shas: [],
            selected_bug_fix_shas: request.selected_bug_fix_shas,
            selected_exactly_reviewed: false, selected_reachable_from_source: false,
            selected_absent_from_target: false, main_remains_independent: true,
            plan: plan
        )

    val source_sha = if request.direction == "main_to_release": main_sha else: release_sha
    val target_sha = if request.direction == "main_to_release": release_sha else: main_sha
    val source_only = _source_only_commits(verified.canonical_root, source_sha, target_sha)
    if source_only.len() > 256:
        return _observation_rejected("convergence comparison exceeds the bounded 256-commit review window")
    for selected in request.selected_bug_fix_shas:
        if not _contains(plan.eligible_reviewed_bug_fix_shas, selected):
            return _observation_rejected("selected convergence commit is not bound to an exact review receipt")
        if not _is_ancestor(verified.canonical_root, selected, source_sha):
            return _observation_rejected("selected convergence commit is not reachable from the fetched source ref")
        if _is_ancestor(verified.canonical_root, selected, target_sha):
            return _observation_rejected("selected convergence commit is already in the target history")
        if not _patch_absent_from_target(verified.canonical_root, selected, target_sha):
            return _observation_rejected("selected convergence patch is already represented in the target history")

    GitConvergenceObservation(
        valid: true, reason: "exact reviewed convergence selection observed; external guarded integration is still required",
        mutation: "fetch-only", fetched_main_sha: main_sha, fetched_release_sha: release_sha,
        source_sha: source_sha, target_sha: target_sha,
        source_only_commit_shas: source_only,
        selected_bug_fix_shas: request.selected_bug_fix_shas,
        selected_exactly_reviewed: true, selected_reachable_from_source: true,
        selected_absent_from_target: true, main_remains_independent: true,
        plan: plan
    )

fn record_post_integration_divergence(root: text, session: ReleaseSession,
                                      request: PostIntegrationDivergenceRequest) -> PostIntegrationDivergenceReceipt:
    val rejected = \reason: PostIntegrationDivergenceReceipt(
        valid: false, reason: reason, mutation: "none", direction: request.direction,
        source_head_before: request.source_head_before, source_head_after: "",
        target_head_before: request.target_head_before, target_head_after: "",
        result_commit_sha: request.result_commit_sha,
        selected_bug_fix_shas: request.selected_bug_fix_shas,
        review_receipt_sha256: request.review_receipt_sha256,
        evidence_receipt_sha256: request.evidence_receipt_sha256,
        integration_receipt_sha256: request.integration_receipt_sha256,
        source_unchanged: false, target_equals_result: false,
        main_remains_independent: true
    )
    val verified = verify_release_session(root, session)
    if not verified.valid:
        return rejected("trusted release session rejected divergence observation: " + verified.reason)
    if request.direction != "main_to_release" and request.direction != "release_to_main":
        return rejected("post-integration divergence direction is invalid")
    if (not _commit_sha_valid(request.source_head_before) or
        not _commit_sha_valid(request.target_head_before) or
        not _commit_sha_valid(request.result_commit_sha)):
        return rejected("post-integration divergence requires exact commit identities")
    if (not _sha256_valid(request.review_receipt_sha256) or
        not _sha256_valid(request.evidence_receipt_sha256) or
        not _sha256_valid(request.integration_receipt_sha256)):
        return rejected("post-integration divergence requires review, evidence, and integration receipts")
    if request.selected_bug_fix_shas.len() == 0 or _has_duplicates(request.selected_bug_fix_shas):
        return rejected("post-integration divergence requires unique selected bug-fix commits")
    for selected in request.selected_bug_fix_shas:
        if not _commit_sha_valid(selected):
            return rejected("post-integration divergence contains an invalid selected commit")

    val fetch_error = _refresh_convergence_refs(verified.canonical_root, request.release_ref)
    if fetch_error != "":
        return rejected(fetch_error)
    val main_after = _git_value(verified.canonical_root, ["rev-parse", "--verify", "refs/remotes/origin/main"])
    val release_after = _git_value(verified.canonical_root, ["rev-parse", "--verify", "refs/remotes/origin/" + request.release_ref])
    val source_after = if request.direction == "main_to_release": main_after else: release_after
    val target_after = if request.direction == "main_to_release": release_after else: main_after
    if source_after != request.source_head_before:
        return rejected("convergence source changed before the post-integration receipt was recorded")
    if target_after != request.result_commit_sha or session.expected_target_sha != target_after:
        return rejected("convergence target does not equal the reviewed integration result")
    if target_after == request.target_head_before or not _is_ancestor(verified.canonical_root, request.target_head_before, target_after):
        return rejected("convergence result is not an append-only descendant of the observed target")
    if target_after == source_after:
        return rejected("main and release line must remain independent after convergence")
    val source_head_is_ancestor = _is_ancestor(verified.canonical_root, source_after, target_after)
    if not convergence_graph_allowed(source_head_is_ancestor):
        return rejected("convergence must not absorb an entire source line into its target")
    for selected in request.selected_bug_fix_shas:
        if (not _is_ancestor(verified.canonical_root, selected, target_after) and
            not _patch_present_in_target(verified.canonical_root, selected, target_after)):
            return rejected("selected bug fix is not represented in the integrated target")

    PostIntegrationDivergenceReceipt(
        valid: true, reason: "post-integration divergence recorded",
        mutation: "fetch-only", direction: request.direction,
        source_head_before: request.source_head_before, source_head_after: source_after,
        target_head_before: request.target_head_before, target_head_after: target_after,
        result_commit_sha: request.result_commit_sha,
        selected_bug_fix_shas: request.selected_bug_fix_shas,
        review_receipt_sha256: request.review_receipt_sha256,
        evidence_receipt_sha256: request.evidence_receipt_sha256,
        integration_receipt_sha256: request.integration_receipt_sha256,
        source_unchanged: true, target_equals_result: true,
        main_remains_independent: true
    )

export ReviewedBugFix, ConvergenceRequest, ConvergenceReceipt, GitConvergenceObservation
export PostIntegrationDivergenceRequest, PostIntegrationDivergenceReceipt
export ConvergenceAdmissionRequest, ConvergenceAdmissionReceipt
export plan_release_main_convergence, inspect_release_main_convergence
export record_post_integration_divergence
export check_convergence_admission
export convergence_graph_allowed
