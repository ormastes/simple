fn f1(n: i64) -> i64?:
    n
fn f2(n: i64) -> i64?:
    val v: i64? = n
    v
fn f3(n: i64) -> i64?:
    if n > 0: n
    else: nil
fn f4(n: i64) -> i64?:
    val x: i64? = n
    if n > 0: x
    else: nil
fn f5(n: i64) -> i64?:
    match n > 0:
        case true: n
        case false: nil
fn main() -> void:
    print("f1={f1(3) ?? -1}")
    print("f2={f2(3) ?? -1}")
    print("f3={f3(3) ?? -1}")
    print("f4={f4(3) ?? -1}")
    print("f5={f5(3) ?? -1}")
