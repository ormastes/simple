# MCP Node Tool Handlers — one-shot Node.js execution
#
# node_repl runs a snippet of JavaScript through `node -e <code>` and returns
# combined stdout/stderr. It is one-shot (no persistent process/session):
# each call spawns node, waits for exit or timeout, and reports the result.
#
# Every tool here depends on an external program that may not be installed.
# require_external_tool() is a small, reusable preflight: call it at the top
# of any handler that shells out to a program the server does not control,
# and return its message as a normal MCP tool error instead of letting the
# opaque process-spawn failure (or a hang) reach the client.

use .main_lazy_json.{extract_field, make_tool_error, make_tool_result, mcp_run_argv}

use std.io_runtime.{process_run}

const _NODE_REPL_DEFAULT_TIMEOUT_MS: i64 = 10000
const _NODE_REPL_MAX_TIMEOUT_MS: i64 = 60000
const _NODE_REPL_MAX_OUTPUT_BYTES: i64 = 1048576

# Preflight for MCP tools that depend on an external program (node, npm, ...).
# Returns an error message when `cmd` is not on PATH, nil when it is found.
# `tool_name` and `friendly_name` make the message identify both the calling
# MCP tool and the human-readable program name, e.g.:
#   "node_repl requires 'node' (Node.js) which is not installed or not on PATH"
fn require_external_tool(tool_name: text, cmd: text, friendly_name: text) -> text?:
    val (_, _, code) = process_run("which", [cmd])
    if code == 0:
        return nil
    "{tool_name} requires '{cmd}' ({friendly_name}) which is not installed or not on PATH"

fn _node_repl_timeout_ms(body: text) -> i64:
    val raw = extract_field(body, "timeout_ms")
    if raw == "":
        return _NODE_REPL_DEFAULT_TIMEOUT_MS
    val parsed = raw.to_int() ?? _NODE_REPL_DEFAULT_TIMEOUT_MS
    if parsed <= 0:
        return _NODE_REPL_DEFAULT_TIMEOUT_MS
    if parsed > _NODE_REPL_MAX_TIMEOUT_MS:
        return _NODE_REPL_MAX_TIMEOUT_MS
    parsed

fn handle_node_repl(id: text, body: text) -> text:
    if val missing = require_external_tool("node_repl", "node", "Node.js"):
        return make_tool_error(id, -32603, missing)

    val code = extract_field(body, "code")
    if code == "":
        return make_tool_error(id, -32602, "Missing required parameter: code")

    val timeout_ms = _node_repl_timeout_ms(body)
    val (out, exit_code) = mcp_run_argv("node", ["-e", code], timeout_ms, _NODE_REPL_MAX_OUTPUT_BYTES)

    var output = "-- node_repl (exit: " + str(exit_code) + ") --\n" + out
    if exit_code == 124:
        output = "TIMEOUT: node_repl timed out after " + str(timeout_ms) + "ms\n" + out
    make_tool_result(id, output)
