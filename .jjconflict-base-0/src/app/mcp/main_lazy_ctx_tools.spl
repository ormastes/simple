# MCP Context Tool Handlers — persistent BM25 index + sandboxed execution
#
# Repo-native replacement for the user-level "context-mode" plugin tools:
#
#   simple_ctx_index(content, source)                 -> chunk + index text
#   simple_ctx_search(queries[] | query, source?, limit?) -> ranked BM25 hits
#   simple_ctx_execute(language, code, timeout_ms?)   -> bounded run, stdout only
#   simple_ctx_execute_file(path, language, code)     -> same, file path in $1/argv
#   simple_ctx_batch_execute(commands[], queries[], source?) -> run+index+search
#   simple_ctx_fetch_and_index(url, source, max_bytes?) -> capped GET, tags stripped
#   simple_ctx_stats()                                -> counts + bytes saved
#   simple_ctx_doctor()                               -> self-check checklist
#   simple_ctx_upgrade()                              -> re-index/compact the store
#
# Store: `.simple/ctx/` (override: SIMPLE_CTX_DIR). Two SDN tables:
#   chunks.sdn  ctx_chunks | id, source, ts, bytes, text |   (text is escaped)
#   stats.sdn   ctx_stats  | key, value |
# chunks.sdn is append-only (one row per chunk, `file_append_text`); the row
# reader skips a torn trailing row, so a killed session never poisons the
# store. stats.sdn is small and rewritten atomically (tmp + rename). The index
# survives across server processes and sessions — it is a file, not a
# per-process temp DB. Search is BM25 (k1=1.2, b=0.75) over word tokens of
# each chunk, computed at query time from the stored chunks; no external
# search engine, no SQLite FTS5 dependency.
#
# Scale contract (2026-08-28, doc/08_tracking/bug/mcp_ctx_batch_execute_crash_hang_on_real_output_2026-08-28.md):
# every hot path over captured output or stored chunks is LINEAR and built
# from native string ops (`split`/`replace`/`contains`/`index_of`) — never a
# per-character `for ch in s` loop. Two reasons: (1) the interpreter's for-in
# has no arm for `Value::StrBytes` (a text carrying non-UTF-8 bytes, which is
# exactly what `git log`/`grep` over a real tree emit), so a per-char loop
# over captured output crashes the server with `cannot iterate over this
# type: StrBytes(...)`; (2) when this module runs interpreted (JIT fallback
# in main.spl) a per-char loop costs ~6.5 us/char — 4 MB of `git log --stat`
# is ~30 s per pass, and the old search tokenized every chunk once per query.
#
# Capture cap: each command's stdout/stderr is bounded at the reader
# (`max_output_bytes` of the resource scope, enforced in the runtime, so
# memory is bounded regardless of what the child prints). Default 8 MiB per
# command, `SIMPLE_CTX_CAPTURE_MAX_BYTES` env or `capture_bytes` param, hard
# max 64 MiB. A truncated capture is marked inline and counted in stats
# (`capture_truncations`). Unlike the plugin's 100 KB truncate-first cap, the
# whole capture (up to the cap) is indexed and searchable.
#
# Sandbox: every execution goes through std resource_scope
# (`run_in_execution_resource_scope`) which applies wall timeout, output cap,
# pid cap (`ulimit -u`) and memory cap. Only stdout is returned; stderr is
# summarized to one line so a noisy failure cannot flood the caller.

use .main_lazy_json.{extract_field, extract_field_raw, make_tool_error, make_tool_result}
use .main_lazy_node_tools.{require_external_tool}
use .main_lazy_telemetry.{tok_record, tok_rollup, tok_load_events, TOK_FEATURE_CTX}
use .main_lazy_log_opt.{log_opt_optimize, log_opt_optimize_recorded, log_opt_plugins_text, LOG_OPT_FEATURE}

use std.io_runtime.{env_get, file_read, file_write, file_append_text, file_exists, file_delete, file_move_cross_device, dir_create, time_now_unix_micros}
use std.database.core.{parse_sdn_table}
use std.nogc_sync_mut.io.resource_scope.{ExecutionResourceClass, execution_resource_scope, run_in_execution_resource_scope}
use std.nogc_sync_mut.io.http_sffi.{http_get}
use std.nogc_sync_mut.security.sanitize.{strip_html_tags}
use std.common.math.special.{ln_f64}
use std.common.perf.execution_metrics.{TerminationCause}

const _CTX_CHUNK_CHARS: i64 = 1200
const _CTX_DEFAULT_LIMIT: i64 = 5
const _CTX_MAX_LIMIT: i64 = 25
const _CTX_SNIPPET_CHARS: i64 = 320
const _CTX_DEFAULT_TIMEOUT_MS: i64 = 15000
const _CTX_MAX_TIMEOUT_MS: i64 = 120000
# Return cap for execute stdout (parity with context-mode's 100 KB smart
# truncation): above this, the head (60%) and tail (40%) are returned, the
# full output is indexed under `exec:<ts>` and the annotation names it.
const _CTX_RETURN_CAP_BYTES: i64 = 102400
const _CTX_CAPTURE_DEFAULT_MAX_BYTES: i64 = 8388608
const _CTX_CAPTURE_HARD_MAX_BYTES: i64 = 67108864
const _CTX_FETCH_DEFAULT_MAX_BYTES: i64 = 262144
const _CTX_FETCH_HARD_MAX_BYTES: i64 = 2097152
const _CTX_SCHEMA_VERSION: i64 = 1

# ---------------------------------------------------------------------------
# Store location + SDN cell escaping
# ---------------------------------------------------------------------------

fn ctx_store_dir() -> text:
    val override = env_get("SIMPLE_CTX_DIR") ?? ""
    if override != "":
        return override
    ".simple/ctx"

fn _ctx_chunks_path() -> text:
    ctx_store_dir() + "/chunks.sdn"

fn _ctx_stats_path() -> text:
    ctx_store_dir() + "/stats.sdn"

fn _ctx_ensure_dir() -> bool:
    val dir = ctx_store_dir()
    if file_exists(dir):
        return true
    dir_create(dir, true)

# One SDN cell must be a single line with no raw double quote (the SDN row
# splitter toggles quoting on `"`). Commas are fine: the writer quotes cells
# containing them and the parser strips the quotes back off.
fn ctx_escape_cell(s: text) -> text:
    var r = s.replace("\\", "\\\\")
    r = r.replace("\"", "\\q")
    r = r.replace("\r", "\\r")
    r = r.replace("\n", "\\n")
    r = r.replace("\t", "\\t")
    r

# Segment-wise unescape: split on the backslash (native), then each segment
# after the first starts with its escape code. An EMPTY segment is an escaped
# backslash (`\\`), and the segment after it is plain text. Linear, no
# per-character loop (see the scale contract in the header).
fn _ctx_unescape_segments(s: text, json_codes: bool) -> text:
    if not s.contains("\\"):
        return s
    val segs = s.split("\\")
    var out: [text] = [segs[0]]
    var i = 1
    while i < segs.len():
        val seg = segs[i]
        if seg == "":
            out.push("\\")
            if i + 1 < segs.len():
                out.push(segs[i + 1])
            i = i + 2
            continue
        val code = seg.substring(0, 1)
        val rest = seg.substring(1)
        if code == "n":
            out.push("\n")
        elif code == "r":
            out.push("\r")
        elif code == "t":
            out.push("\t")
        elif code == "q":
            out.push("\"")
        elif json_codes and (code == "b" or code == "f"):
            pass
        elif json_codes and code == "u":
            out.push("\\u")
        else:
            out.push(code)
        out.push(rest)
        i = i + 1
    out.join("")

fn ctx_unescape_cell(s: text) -> text:
    _ctx_unescape_segments(s, false)

fn _ctx_cell(s: text) -> text:
    val e = ctx_escape_cell(s)
    if e.contains(","):
        return "\"" + e + "\""
    e

# Atomic write: tmp file + rename.
fn _ctx_write_atomic(path: text, content: text) -> bool:
    val tmp = path + ".tmp"
    if not file_write(tmp, content):
        return false
    file_move_cross_device(tmp, path)

# ---------------------------------------------------------------------------
# Chunk store
# ---------------------------------------------------------------------------

struct CtxChunk:
    id: i64
    source: text
    ts: i64
    bytes: i64
    body: text

# One data row of chunks.sdn: `    id, source, ts, bytes, text`. A cell that
# carried a comma was written quoted (`"..."`); escaped cells never contain a
# raw double quote, so the closing quote is unambiguous. Returns nil for a
# header/comment line or a torn row (an append interrupted mid-line).
fn _ctx_parse_chunk_row(line: text) -> CtxChunk?:
    if not line.starts_with("    "):
        return nil
    val rest = line.substring(4)
    val p1 = rest.index_of(", ") ?? -1
    if p1 < 0:
        return nil
    val id = rest.substring(0, p1).to_int() ?? 0
    var r2 = rest.substring(p1 + 2)
    var source = ""
    if r2.starts_with("\""):
        val close = r2.index_of("\"", 1) ?? -1
        if close < 0:
            return nil
        source = r2.substring(1, close)
        r2 = r2.substring(close + 1)
        if not r2.starts_with(", "):
            return nil
        r2 = r2.substring(2)
    else:
        val p2 = r2.index_of(", ") ?? -1
        if p2 < 0:
            return nil
        source = r2.substring(0, p2)
        r2 = r2.substring(p2 + 2)
    val p3 = r2.index_of(", ") ?? -1
    if p3 < 0:
        return nil
    val ts = r2.substring(0, p3).to_int() ?? 0
    r2 = r2.substring(p3 + 2)
    val p4 = r2.index_of(", ") ?? -1
    if p4 < 0:
        return nil
    val bytes = r2.substring(0, p4).to_int() ?? 0
    var cell = r2.substring(p4 + 2)
    if cell.len() >= 2 and cell.starts_with("\"") and cell.ends_with("\""):
        cell = cell.substring(1, cell.len() - 1)
    Some(CtxChunk(id: id, source: source, ts: ts, bytes: bytes, body: ctx_unescape_cell(cell)))

# Linear row reader: one native line split + a handful of `index_of` per
# row. Replaces the generic SDN table parser, which walked the whole file
# per character (minutes for a multi-MB store when interpreted).
fn _ctx_load_chunks() -> [CtxChunk]:
    var out: [CtxChunk] = []
    val path = _ctx_chunks_path()
    if not file_exists(path):
        return out
    for line in file_read(path).split("\n"):
        if val c = _ctx_parse_chunk_row(line):
            out.push(c)
    out

fn _ctx_chunk_line(c: CtxChunk) -> text:
    "    " + str(c.id) + ", " + _ctx_cell(c.source) + ", " + str(c.ts) + ", " + str(c.bytes) + ", " + _ctx_cell(c.body) + "\n"

fn _ctx_store_header() -> text:
    "# ctx chunk store — written by simple_ctx_* MCP tools. Do not edit by hand.\n# ctx_schema_version: " + str(_CTX_SCHEMA_VERSION) + "\nctx_chunks | id, source, ts, bytes, text |\n"

# Append-only: the existing store is never re-read or rewritten on index, so
# indexing N commands costs O(new bytes), not O(store) per command.
fn _ctx_append_chunks(new_chunks: [CtxChunk]) -> bool:
    if not _ctx_ensure_dir():
        return false
    val path = _ctx_chunks_path()
    if not file_exists(path):
        if not file_write(path, _ctx_store_header()):
            return false
    var lines: [text] = []
    for c in new_chunks:
        lines.push(_ctx_chunk_line(c))
    file_append_text(path, lines.join(""))

fn _ctx_next_id(existing: [CtxChunk]) -> i64:
    var mx: i64 = 0
    for c in existing:
        if c.id > mx:
            mx = c.id
    mx + 1

# Reserve `count` consecutive ids; the high-water mark lives in stats.sdn so
# indexing does not need to load the chunk store. A store without the key
# (pre-existing or externally rewritten) is scanned once to seed it.
fn _ctx_reserve_ids(count: i64) -> i64:
    var d = _ctx_load_stats()
    var next: i64 = 0
    if d.contains_key("next_id"):
        next = d["next_id"]
    if next <= 0:
        next = _ctx_next_id(_ctx_load_chunks())
    d["next_id"] = next + count
    _ctx_save_stats(d)
    next

# Per-command capture cap (bytes of stdout, and separately stderr, retained).
fn ctx_capture_max_bytes() -> i64:
    val raw = env_get("SIMPLE_CTX_CAPTURE_MAX_BYTES") ?? ""
    val n = raw.trim().to_int() ?? 0
    if n <= 0:
        return _CTX_CAPTURE_DEFAULT_MAX_BYTES
    if n > _CTX_CAPTURE_HARD_MAX_BYTES:
        return _CTX_CAPTURE_HARD_MAX_BYTES
    n

fn _ctx_now_secs() -> i64:
    time_now_unix_micros() / 1000000

# Split text into chunks of ~_CTX_CHUNK_CHARS, breaking on line boundaries.
fn ctx_chunk_text(content: text, chunk_chars: i64) -> [text]:
    var chunks: [text] = []
    var cur: [text] = []
    var cur_len: i64 = 0
    for line in content.split("\n"):
        val ll = line.len() + 1
        if cur_len > 0 and cur_len + ll > chunk_chars:
            chunks.push(cur.join("\n"))
            cur = []
            cur_len = 0
        # A single line longer than the chunk budget is split by fixed width.
        if ll > chunk_chars:
            var start = 0
            val n = line.len()
            while start < n:
                var end = start + chunk_chars
                if end > n:
                    end = n
                chunks.push(line.substring(start, end))
                start = end
            continue
        cur.push(line)
        cur_len = cur_len + ll
    if cur_len > 0:
        val tail = cur.join("\n")
        if tail.trim() != "":
            chunks.push(tail)
    chunks

# Index `content` under `source`; returns number of chunks written.
fn ctx_index_text(content: text, source: text) -> i64:
    if content.trim() == "":
        return 0
    val pieces = ctx_chunk_text(content, _CTX_CHUNK_CHARS)
    if pieces.len() == 0:
        return 0
    var next = _ctx_reserve_ids(pieces.len())
    val now = _ctx_now_secs()
    var rows: [CtxChunk] = []
    for piece in pieces:
        rows.push(CtxChunk(id: next, source: source, ts: now, bytes: piece.len(), body: piece))
        next = next + 1
    if not _ctx_append_chunks(rows):
        return -1
    _ctx_stats_bump("bytes_indexed", content.len())
    _ctx_stats_bump("index_calls", 1)
    rows.len()

# ---------------------------------------------------------------------------
# Stats (key/value SDN)
# ---------------------------------------------------------------------------

fn _ctx_load_stats() -> Dict<text, i64>:
    var d: Dict<text, i64> = {}
    val path = _ctx_stats_path()
    if not file_exists(path):
        return d
    val table = parse_sdn_table(file_read(path))
    match table:
        Some(t):
            for row in t.rows:
                val k = row.get("key") ?? ""
                val v = (row.get("value") ?? "0").to_int() ?? 0
                if k != "":
                    d[k] = v
        nil:
            pass
    d

fn _ctx_save_stats(d: Dict<text, i64>) -> bool:
    if not _ctx_ensure_dir():
        return false
    var lines: [text] = []
    lines.push("ctx_stats | key, value |\n")
    val keys = d.keys()
    for k in keys:
        lines.push("    " + k + ", " + str(d[k]) + "\n")
    _ctx_write_atomic(_ctx_stats_path(), lines.join(""))

fn _ctx_stats_bump(key: text, delta: i64):
    var d = _ctx_load_stats()
    if d.contains_key(key):
        d[key] = d[key] + delta
    else:
        d[key] = delta
    _ctx_save_stats(d)

# ---------------------------------------------------------------------------
# Tokenizer + BM25
# ---------------------------------------------------------------------------

# Every byte that is not a word character (a-z, 0-9, _) in typical program
# output. Each is replaced by TWO spaces so that a token is always framed by
# whitespace on both sides and two adjacent occurrences of ` term ` can never
# share a space — that is what makes `split(" term ").len() - 1` an exact
# occurrence count.
const _CTX_SEPARATORS: [text] = [" ", "\n", "\t", "\r", "/", ".", ":", "(", ")", "[", "]", "{", "}", ",", ";", "=", "+", "-", "*", "<", ">", "\"", "'", "`", "|", "&", "!", "?", "@", "#", "$", "%", "^", "~", "\\"]

# Lower-cased text with every separator widened to two spaces and a space at
# each end, so ` term ` matches exactly one whole-word occurrence. Built from
# native replace passes only — no per-character loop, so it costs the same
# whether this module is JIT-compiled or interpreted, and it never iterates
# a StrBytes value.
fn ctx_normalize(s: text) -> text:
    var n = s.lower()
    for sep in _CTX_SEPARATORS:
        n = n.replace(sep, "  ")
    " " + n + " "

fn ctx_tokenize(s: text) -> [text]:
    var toks: [text] = []
    for t in ctx_normalize(s).split(" "):
        if t.len() >= 2:
            toks.push(t)
    toks

struct CtxHit:
    chunk: CtxChunk
    score: f64
    matched: i64
    mode: text      # "bm25" | "substring"

# Query-side stopwords (parity with context-mode's stopword strip: common
# English + dev-noise words). Applied to query terms only, so document
# lengths and the store are untouched.
const _CTX_STOPWORDS: [text] = ["the", "a", "an", "and", "or", "of", "to", "in", "is", "it", "for", "on", "with", "as", "at", "by", "be", "this", "that", "from", "are", "was", "not", "but", "if", "then", "so", "we", "you", "do", "does", "did", "has", "have", "had", "will", "can", "use", "using", "how", "what", "which", "where", "when", "all", "any", "each", "into", "than", "also", "just", "more", "some", "such", "only", "same", "other", "out", "up", "no", "yes", "its", "these", "those", "there", "here", "update", "fix", "test", "deps"]

fn _ctx_is_stopword(t: text) -> bool:
    for s in _CTX_STOPWORDS:
        if s == t:
            return true
    false

# Query terms with stopwords removed; a query made only of stopwords keeps
# its raw terms so it still answers rather than returning nothing.
fn ctx_query_terms(query: text) -> [text]:
    val raw = ctx_tokenize(query)
    var kept: [text] = []
    for t in raw:
        if not _ctx_is_stopword(t):
            kept.push(t)
    if kept.len() == 0:
        return raw
    kept

# Prepared search index: the filtered chunks plus their normalized bodies,
# built ONCE per handler call and shared by every query in that call.
struct CtxIndex:
    docs: [CtxChunk]
    norm: [text]
    avg_bytes: f64

# Raw substring needles for the zero-hit fallback: whitespace-separated
# pieces of the query (>= 3 chars), lowercased — keeps `_`, `.`, `-`, `(`
# so a partial identifier like `string_len` or `foo.bar` still matches.
fn _ctx_substring_needles(query: text) -> [text]:
    var out: [text] = []
    for piece in query.lower().split(" "):
        val p = piece.trim()
        if p.len() >= 3:
            out.push(p)
    out

# Top-k by repeated max selection (result sets are small).
fn _ctx_top_k(scored: [CtxHit], limit: i64) -> [CtxHit]:
    var out: [CtxHit] = []
    var taken: [bool] = []
    for h in scored:
        taken.push(false)
    var k = 0
    while k < limit and k < scored.len():
        var best = -1
        var j = 0
        while j < scored.len():
            if not taken[j]:
                if best < 0 or scored[j].score > scored[best].score:
                    best = j
            j = j + 1
        if best < 0:
            break
        taken[best] = true
        out.push(scored[best])
        k = k + 1
    out

# Chunk bodies are joined with this sentinel, normalized in one pass and
# split back apart, so a 5,000-chunk store costs one replace pass per
# separator instead of 5,000 x 35 native calls.
const _CTX_DOC_SENTINEL: text = "qzctxsepzq"

fn ctx_prepare_index(chunks: [CtxChunk], source_prefix: text) -> CtxIndex:
    var docs: [CtxChunk] = []
    var bodies: [text] = []
    var total_bytes: i64 = 0
    for c in chunks:
        if source_prefix == "" or c.source.starts_with(source_prefix):
            docs.push(c)
            bodies.push(c.body)
            total_bytes = total_bytes + c.body.len()
    if docs.len() == 0:
        return CtxIndex(docs: [], norm: [], avg_bytes: 1.0)
    var norm = ctx_normalize(bodies.join(" " + _CTX_DOC_SENTINEL + " ")).split(_CTX_DOC_SENTINEL)
    if norm.len() != docs.len():
        # A body contained the sentinel text itself; fall back to per-doc.
        norm = []
        for b in bodies:
            norm.push(ctx_normalize(b))
    var avg = total_bytes.to_float() / docs.len().to_float()
    if avg < 1.0:
        avg = 1.0
    CtxIndex(docs: docs, norm: norm, avg_bytes: avg)

fn _ctx_dedupe(terms: [text]) -> [text]:
    var seen: Dict<text, bool> = {}
    var out: [text] = []
    for t in terms:
        if not seen.contains_key(t):
            seen[t] = true
            out.push(t)
    out

# BM25 over a prepared index. Term frequency per document is an exact
# whole-word occurrence count over the normalized body (native `contains`
# gate + `split`), document length is the body's byte length.
fn ctx_bm25_search_index(idx: CtxIndex, query: text, limit: i64) -> [CtxHit]:
    val q_terms = _ctx_dedupe(ctx_query_terms(query))
    val n_docs = idx.docs.len()
    if q_terms.len() == 0 or n_docs == 0:
        return []
    val k1 = 1.2
    val b = 0.75
    var scores: [f64] = []
    var matched: [i64] = []
    var i = 0
    while i < n_docs:
        scores.push(0.0)
        matched.push(0)
        i = i + 1
    for qt in q_terms:
        val needle = " " + qt + " "
        var counts: [i64] = []
        var df: i64 = 0
        i = 0
        while i < n_docs:
            var f: i64 = 0
            if idx.norm[i].contains(needle):
                f = idx.norm[i].split(needle).len() - 1
            if f > 0:
                df = df + 1
            counts.push(f)
            i = i + 1
        if df == 0:
            continue
        val idf = ln_f64(1.0 + (n_docs.to_float() - df.to_float() + 0.5) / (df.to_float() + 0.5))
        i = 0
        while i < n_docs:
            if counts[i] > 0:
                val f = counts[i].to_float()
                val dl = idx.docs[i].body.len().to_float()
                val denom = f + k1 * (1.0 - b + b * dl / idx.avg_bytes)
                scores[i] = scores[i] + idf * (f * (k1 + 1.0)) / denom
                matched[i] = matched[i] + 1
            i = i + 1
    var scored: [CtxHit] = []
    i = 0
    while i < n_docs:
        if matched[i] > 0:
            scored.push(CtxHit(chunk: idx.docs[i], score: scores[i], matched: matched[i], mode: "bm25"))
        i = i + 1
    if scored.len() > 0:
        return _ctx_top_k(scored, limit)
    # Zero-hit fallback: raw substring match over the un-normalized lowered
    # body, scored by occurrence count (the role of context-mode's trigram
    # table). Only reached when BM25 matched nothing, so the per-doc lower()
    # never runs on the hot path.
    val needles = _ctx_substring_needles(query)
    if needles.len() == 0:
        return []
    i = 0
    while i < n_docs:
        val low = idx.docs[i].body.lower()
        var hits: i64 = 0
        for nd in needles:
            if low.contains(nd):
                hits = hits + low.split(nd).len() - 1
        if hits > 0:
            scored.push(CtxHit(chunk: idx.docs[i], score: hits.to_float(), matched: 0, mode: "substring"))
        i = i + 1
    _ctx_top_k(scored, limit)

# One-query convenience over ctx_prepare_index + ctx_bm25_search_index.
fn ctx_bm25_search(chunks: [CtxChunk], query: text, source_prefix: text, limit: i64) -> [CtxHit]:
    ctx_bm25_search_index(ctx_prepare_index(chunks, source_prefix), query, limit)

fn _ctx_fmt_score(score: f64) -> text:
    val milli = (score * 1000.0).to_int()
    val whole = milli / 1000
    var frac = milli - whole * 1000
    if frac < 0:
        frac = 0 - frac
    var frac_s = str(frac)
    while frac_s.len() < 3:
        frac_s = "0" + frac_s
    str(whole) + "." + frac_s

# Snippet: window around the first query token hit, else the chunk head.
fn _ctx_snippet(body: text, query: text) -> text:
    val lower = body.lower()
    var pos = -1
    for qt in ctx_tokenize(query):
        val p = lower.index_of(qt)
        if p >= 0 and (pos < 0 or p < pos):
            pos = p
    var start = 0
    if pos > _CTX_SNIPPET_CHARS / 3:
        start = pos - _CTX_SNIPPET_CHARS / 3
    var end = start + _CTX_SNIPPET_CHARS
    if end > body.len():
        end = body.len()
    var s = body.substring(start, end)
    if start > 0:
        s = "…" + s
    if end < body.len():
        s = s + "…"
    s

fn ctx_format_hits(query: text, hits: [CtxHit]) -> text:
    var lines: [text] = []
    lines.push("## query: " + query + " (" + str(hits.len()) + " hit(s))")
    var rank = 1
    for h in hits:
        lines.push("[" + str(rank) + "] score=" + _ctx_fmt_score(h.score) + " match=" + h.mode + " source=" + h.chunk.source + " chunk=" + str(h.chunk.id) + " ts=" + str(h.chunk.ts))
        lines.push(_ctx_snippet(h.chunk.body, query))
        lines.push("")
        rank = rank + 1
    lines.join("\n")

# ---------------------------------------------------------------------------
# Parameter helpers
# ---------------------------------------------------------------------------

# extract_field returns the still-escaped JSON string body; undo the escapes.
fn ctx_unescape_json(s: text) -> text:
    _ctx_unescape_segments(s, true)

# Parse a JSON array of strings ("[\"a\", \"b\"]") into unescaped texts.
# A bare string is accepted as a one-element list.
fn ctx_parse_string_array(raw: text) -> [text]:
    var out: [text] = []
    val t = raw.trim()
    if t == "" or t == "null":
        return out
    if t.starts_with("\""):
        var inner = t.substring(1, t.len())
        if inner.ends_with("\""):
            inner = inner.substring(0, inner.len() - 1)
        out.push(ctx_unescape_json(inner))
        return out
    if not t.starts_with("["):
        return out
    var in_str = false
    var esc = false
    var cur: [text] = []
    for ch in t:
        if in_str:
            if esc:
                cur.push("\\" + ch)
                esc = false
            elif ch == "\\":
                esc = true
            elif ch == "\"":
                out.push(ctx_unescape_json(cur.join("")))
                cur = []
                in_str = false
            else:
                cur.push(ch)
        elif ch == "\"":
            in_str = true
    out

fn _ctx_int_param(body: text, key: text, default_value: i64, max_value: i64) -> i64:
    val raw = extract_field(body, key)
    if raw == "":
        return default_value
    val parsed = raw.to_int() ?? default_value
    if parsed <= 0:
        return default_value
    if parsed > max_value:
        return max_value
    parsed

fn _ctx_queries(body: text) -> [text]:
    var qs = ctx_parse_string_array(extract_field_raw(body, "queries"))
    if qs.len() == 0:
        val single = ctx_unescape_json(extract_field(body, "query"))
        if single != "":
            qs.push(single)
    qs

# ---------------------------------------------------------------------------
# Sandboxed execution
# ---------------------------------------------------------------------------

struct CtxExecResult:
    stdout: text
    stderr_summary: text
    exit_code: i64
    timed_out: bool
    wall_ms: i64
    raw_bytes: i64   # stdout + stderr bytes retained (each stream bounded at capture_max)
    truncated: bool  # stdout hit the per-command capture cap
    capture_max: i64

fn _ctx_summarize_stderr(stderr: text, truncated: bool) -> text:
    val trimmed = stderr.trim()
    if trimmed == "":
        return "stderr: (empty)"
    val lines = trimmed.split("\n")
    var first = lines[0]
    if first.len() > 200:
        first = first.substring(0, 200) + "…"
    var s = "stderr: " + str(lines.len()) + " line(s), " + str(stderr.len()) + " byte(s); first: " + first
    if truncated:
        s = s + " [truncated]"
    s

# `capture_max` bounds each stream AT THE READER (runtime-enforced), so the
# server's memory is bounded by the cap regardless of what the child prints.
fn ctx_run_bounded(cmd: text, args: [text], timeout_ms: i64, capture_max: i64) -> CtxExecResult:
    val scope = execution_resource_scope(ExecutionResourceClass.Large, timeout_ms, capture_max)
    val r = run_in_execution_resource_scope(scope, cmd, args)
    val p = r.process
    val exit_code = p.usage.exit_code
    val timed_out = p.usage.termination == TerminationCause.WallTimeout
    var out = p.stdout
    if p.stdout_truncated:
        out = out + "\n[capture truncated at " + str(capture_max) + " bytes]"
        _ctx_stats_bump("capture_truncations", 1)
    CtxExecResult(
        stdout: out,
        stderr_summary: _ctx_summarize_stderr(p.stderr, p.stderr_truncated),
        exit_code: exit_code,
        timed_out: timed_out,
        wall_ms: p.usage.wall_ms,
        raw_bytes: p.stdout.len() + p.stderr.len(),
        truncated: p.stdout_truncated,
        capture_max: capture_max
    )

fn _ctx_simple_binary() -> text:
    val env_bin = env_get("SIMPLE_BINARY") ?? ""
    if env_bin != "":
        return env_bin
    "bin/simple"

# Run `code` in `language`. `file_path` (may be "") is exposed to the code as
# `$1`/`$FILE` (shell), `process.argv[2]` (javascript) or the first CLI
# argument (simple). Returns nil + error text when the language is unknown.
fn ctx_execute_code(language: text, code: text, file_path: text, timeout_ms: i64) -> (CtxExecResult?, text):
    val lang = language.lower().trim()
    val cap = ctx_capture_max_bytes()
    if lang == "shell" or lang == "sh" or lang == "bash" or lang == "":
        var argv: [text] = ["-c", "FILE=\"$1\"; export FILE; " + code, "sh"]
        if file_path != "":
            argv.push(file_path)
        return (Some(ctx_run_bounded("/bin/sh", argv, timeout_ms, cap)), "")
    if lang == "javascript" or lang == "js" or lang == "node":
        if val missing = require_external_tool("simple_ctx_execute", "node", "Node.js"):
            return (nil, missing)
        var argv: [text] = ["-e", code]
        if file_path != "":
            argv.push("--")
            argv.push(file_path)
        return (Some(ctx_run_bounded("node", argv, timeout_ms, cap)), "")
    if lang == "simple" or lang == "spl":
        if not _ctx_ensure_dir():
            return (nil, "cannot create " + ctx_store_dir())
        val tmp = ctx_store_dir() + "/exec_" + str(time_now_unix_micros()) + ".spl"
        if not file_write(tmp, code):
            return (nil, "cannot write " + tmp)
        var argv: [text] = ["run", tmp]
        if file_path != "":
            argv.push(file_path)
        return (Some(ctx_run_bounded(_ctx_simple_binary(), argv, timeout_ms, cap)), "")
    (nil, "Unsupported language: " + language + " (use shell, javascript, or simple)")

# Smart truncation: keep whole lines from the head up to 60% of `cap` bytes
# and from the tail up to 40%, with `marker` as the line between them;
# returns (text, omitted_lines, omitted_bytes), omitted_lines == 0 when
# nothing was cut.
fn ctx_smart_truncate(stdout: text, cap: i64, marker: text) -> (text, i64, i64):
    if stdout.len() <= cap:
        return (stdout, 0, 0)
    val lines = stdout.split("\n")
    val n = lines.len()
    val head_budget = cap * 6 / 10
    val tail_budget = cap - head_budget
    var head_end = 0
    var used: i64 = 0
    while head_end < n and used + lines[head_end].len() + 1 <= head_budget:
        used = used + lines[head_end].len() + 1
        head_end = head_end + 1
    var tail_start = n
    used = 0
    while tail_start > head_end and used + lines[tail_start - 1].len() + 1 <= tail_budget:
        used = used + lines[tail_start - 1].len() + 1
        tail_start = tail_start - 1
    if tail_start <= head_end:
        return (stdout, 0, 0)
    var omitted_bytes: i64 = 0
    var i = head_end
    while i < tail_start:
        omitted_bytes = omitted_bytes + lines[i].len() + 1
        i = i + 1
    var out: [text] = []
    i = 0
    while i < head_end:
        out.push(lines[i])
        i = i + 1
    out.push(marker)
    i = tail_start
    while i < n:
        out.push(lines[i])
        i = i + 1
    (out.join("\n"), tail_start - head_end, omitted_bytes)

# Apply the return cap to an execute result: when the stdout exceeds
# `_CTX_RETURN_CAP_BYTES` the full text is indexed under `exec:<ts>` and the
# returned stdout is the head+tail with an annotation naming that source.
fn _ctx_with_stdout(r: CtxExecResult, stdout: text) -> CtxExecResult:
    CtxExecResult(stdout: stdout, stderr_summary: r.stderr_summary, exit_code: r.exit_code, timed_out: r.timed_out, wall_ms: r.wall_ms, raw_bytes: r.raw_bytes)

fn ctx_cap_exec_stdout(r: CtxExecResult) -> CtxExecResult:
    # A toolchain log optimizer runs BEFORE the size cap: dropping progress
    # noise routinely keeps the one real error INSIDE the cap instead of
    # leaving it past the truncation point. The raw text is what gets
    # indexed below, so a dropped line is still reachable by search.
    val raw = r.stdout
    val filtered = log_opt_optimize_recorded(raw)
    if filtered.len() <= _CTX_RETURN_CAP_BYTES:
        return _ctx_with_stdout(r, filtered)
    val source = "exec:" + str(time_now_unix_micros())
    val (kept, omitted_lines, omitted_bytes) = ctx_smart_truncate(filtered, _CTX_RETURN_CAP_BYTES, "[...truncated: see below]")
    if omitted_lines == 0:
        return _ctx_with_stdout(r, filtered)
    val n = ctx_index_text(raw, source)
    val note = "[...truncated — " + str(omitted_lines) + " line(s) / " + str(omitted_bytes) + " byte(s) omitted from the middle; full output indexed as " + str(n) + " chunk(s): simple_ctx_search(queries: [...], source: '" + source + "')]"
    _ctx_with_stdout(r, kept.replace("[...truncated: see below]", note))

fn ctx_format_exec(label: text, r: CtxExecResult) -> text:
    var head = "-- " + label + " (exit: " + str(r.exit_code) + ", " + str(r.wall_ms) + "ms) --"
    if r.timed_out:
        head = "TIMEOUT: " + label + " exceeded its wall budget (exit: " + str(r.exit_code) + ")"
    head + "\n" + r.stdout + "\n" + r.stderr_summary

# ---------------------------------------------------------------------------
# Tool handlers
# ---------------------------------------------------------------------------

fn handle_simple_ctx_index(id: text, body: text) -> text:
    val content = ctx_unescape_json(extract_field(body, "content"))
    if content == "":
        return make_tool_error(id, -32602, "Missing required parameter: content")
    var source = ctx_unescape_json(extract_field(body, "source"))
    if source == "":
        source = "manual:" + str(_ctx_now_secs())
    val n = ctx_index_text(content, source)
    if n < 0:
        return make_tool_error(id, -32603, "simple_ctx_index: cannot write " + _ctx_chunks_path())
    val msg = "Indexed " + str(n) + " chunk(s) (" + str(content.len()) + " bytes) under source '" + source + "' in " + ctx_store_dir()
    tok_record(TOK_FEATURE_CTX, "simple_ctx_index", content.len(), msg.len(), false)
    make_tool_result(id, msg)

fn handle_simple_ctx_search(id: text, body: text) -> text:
    val queries = _ctx_queries(body)
    if queries.len() == 0:
        return make_tool_error(id, -32602, "Missing required parameter: queries (array) or query")
    val source = ctx_unescape_json(extract_field(body, "source"))
    val limit = _ctx_int_param(body, "limit", _CTX_DEFAULT_LIMIT, _CTX_MAX_LIMIT)
    val index = ctx_prepare_index(_ctx_load_chunks(), source)
    var blocks: [text] = []
    for q in queries:
        blocks.push(ctx_format_hits(q, ctx_bm25_search_index(index, q, limit)))
    val out = blocks.join("\n")
    _ctx_stats_bump("bytes_returned", out.len())
    _ctx_stats_bump("search_calls", 1)
    tok_record(TOK_FEATURE_CTX, "simple_ctx_search", 0, out.len(), false)
    make_tool_result(id, out)

fn _ctx_exec_common(id: text, body: text, tool: text, file_path: text) -> text:
    val code = ctx_unescape_json(extract_field(body, "code"))
    if code == "":
        return make_tool_error(id, -32602, "Missing required parameter: code")
    val language = extract_field(body, "language")
    val timeout_ms = _ctx_int_param(body, "timeout_ms", _CTX_DEFAULT_TIMEOUT_MS, _CTX_MAX_TIMEOUT_MS)
    val (result, err) = ctx_execute_code(language, code, file_path, timeout_ms)
    match result:
        Some(raw):
            val r = ctx_cap_exec_stdout(raw)
            _ctx_stats_bump("exec_calls", 1)
            _ctx_stats_bump("bytes_returned", r.stdout.len())
            val out = ctx_format_exec(tool, r)
            val tool_name = if tool.starts_with("simple_ctx_execute_file"): "simple_ctx_execute_file" else: "simple_ctx_execute"
            tok_record(TOK_FEATURE_CTX, tool_name, r.raw_bytes, out.len(), false)
            make_tool_result(id, out)
        nil:
            make_tool_error(id, -32602, tool + ": " + err)

fn handle_simple_ctx_execute(id: text, body: text) -> text:
    _ctx_exec_common(id, body, "simple_ctx_execute", "")

fn handle_simple_ctx_execute_file(id: text, body: text) -> text:
    val path = ctx_unescape_json(extract_field(body, "path"))
    if path == "":
        return make_tool_error(id, -32602, "Missing required parameter: path")
    if not file_exists(path):
        return make_tool_error(id, -32602, "simple_ctx_execute_file: no such file: " + path)
    _ctx_exec_common(id, body, "simple_ctx_execute_file " + path, path)

fn handle_simple_ctx_batch_execute(id: text, body: text) -> text:
    val commands = ctx_parse_string_array(extract_field_raw(body, "commands"))
    if commands.len() == 0:
        return make_tool_error(id, -32602, "Missing required parameter: commands (array)")
    val queries = _ctx_queries(body)
    var source = ctx_unescape_json(extract_field(body, "source"))
    if source == "":
        source = "batch:" + str(_ctx_now_secs())
    val timeout_ms = _ctx_int_param(body, "timeout_ms", _CTX_DEFAULT_TIMEOUT_MS, _CTX_MAX_TIMEOUT_MS)
    val limit = _ctx_int_param(body, "limit", _CTX_DEFAULT_LIMIT, _CTX_MAX_LIMIT)
    val capture_max = _ctx_int_param(body, "capture_bytes", ctx_capture_max_bytes(), _CTX_CAPTURE_HARD_MAX_BYTES)
    var lines: [text] = []
    lines.push("## batch: " + str(commands.len()) + " command(s) indexed under '" + source + "'")
    var idx = 0
    var total_bytes: i64 = 0
    for cmd in commands:
        val r = ctx_run_bounded("/bin/sh", ["-c", cmd], timeout_ms, capture_max)
        val label = source + "#" + str(idx)
        val text_out = "$ " + cmd + "\n" + r.stdout + "\n" + r.stderr_summary
        val n = ctx_index_text(text_out, label)
        total_bytes = total_bytes + text_out.len()
        var status = "exit " + str(r.exit_code)
        if r.timed_out:
            status = "TIMEOUT"
        var line = "[" + str(idx) + "] " + status + ", " + str(r.stdout.len()) + " stdout byte(s), " + str(n) + " chunk(s) -> source " + label
        if r.truncated:
            line = line + " [capture truncated at " + str(capture_max) + " bytes]"
        lines.push(line)
        idx = idx + 1
    lines.push("")
    if queries.len() == 0:
        lines.push("(no queries given — use simple_ctx_search with source '" + source + "')")
    else:
        # One store load + one normalization pass, shared by every query.
        val index = ctx_prepare_index(_ctx_load_chunks(), source)
        for q in queries:
            lines.push(ctx_format_hits(q, ctx_bm25_search_index(index, q, limit)))
    val out = lines.join("\n")
    _ctx_stats_bump("bytes_returned", out.len())
    _ctx_stats_bump("batch_calls", 1)
    tok_record(TOK_FEATURE_CTX, "simple_ctx_batch_execute", total_bytes, out.len(), false)
    make_tool_result(id, out)

fn ctx_fetch_allowed_url(url: text) -> bool:
    url.starts_with("http://") or url.starts_with("https://")

# Plain-text extraction: strip tags, collapse blank runs. No script execution.
fn ctx_html_to_text(html: text) -> text:
    var stripped = strip_html_tags(html)
    stripped = stripped.replace("&nbsp;", " ").replace("&amp;", "&").replace("&lt;", "<").replace("&gt;", ">").replace("&quot;", "\"")
    var out: [text] = []
    var blank_run = 0
    for line in stripped.split("\n"):
        val t = line.trim()
        if t == "":
            blank_run = blank_run + 1
            if blank_run > 1:
                continue
        else:
            blank_run = 0
        out.push(t)
    out.join("\n")

fn ctx_cap_bytes(s: text, max_bytes: i64) -> (text, bool):
    if s.len() <= max_bytes:
        return (s, false)
    (s.substring(0, max_bytes), true)

fn handle_simple_ctx_fetch_and_index(id: text, body: text) -> text:
    val url = ctx_unescape_json(extract_field(body, "url"))
    if url == "":
        return make_tool_error(id, -32602, "Missing required parameter: url")
    if not ctx_fetch_allowed_url(url):
        return make_tool_error(id, -32602, "simple_ctx_fetch_and_index: only http:// and https:// URLs are allowed")
    var source = ctx_unescape_json(extract_field(body, "source"))
    if source == "":
        source = "web:" + url
    val max_bytes = _ctx_int_param(body, "max_bytes", _CTX_FETCH_DEFAULT_MAX_BYTES, _CTX_FETCH_HARD_MAX_BYTES)
    val resp = http_get(url)
    if resp.status_code < 0 or resp.error != "":
        return make_tool_error(id, -32603, "simple_ctx_fetch_and_index: transport error: " + resp.error)
    if not resp.is_ok:
        return make_tool_error(id, -32603, "simple_ctx_fetch_and_index: HTTP " + str(resp.status_code))
    val (raw, capped) = ctx_cap_bytes(resp.body, max_bytes)
    val plain = ctx_html_to_text(raw)
    val n = ctx_index_text(plain, source)
    if n < 0:
        return make_tool_error(id, -32603, "simple_ctx_fetch_and_index: cannot write " + _ctx_chunks_path())
    var msg = "Fetched " + url + ": " + str(resp.body.len()) + " byte(s)"
    if capped:
        msg = msg + " (capped to " + str(max_bytes) + ")"
    msg = msg + ", " + str(plain.len()) + " byte(s) of text, " + str(n) + " chunk(s) under source '" + source + "'"
    _ctx_stats_bump("fetch_calls", 1)
    tok_record(TOK_FEATURE_CTX, "simple_ctx_fetch_and_index", resp.body.len(), msg.len(), false)
    make_tool_result(id, msg)

# ---------------------------------------------------------------------------
# Toolchain log optimizer (plugin engine lives in main_lazy_log_opt)
# ---------------------------------------------------------------------------

# With no `log` argument this lists the loaded plugin descriptors, so an
# operator can see what is installed without feeding it a build log.
fn handle_simple_log_optimize(id: text, body: text) -> text:
    val raw = ctx_unescape_json(extract_field(body, "log"))
    if raw == "":
        return make_tool_result(id, log_opt_plugins_text())
    val (out, name, dropped) = log_opt_optimize(raw)
    if name == "":
        return make_tool_result(id, "[log-opt] no descriptor claimed this log; returned unchanged\n" + out)
    tok_record(LOG_OPT_FEATURE, "logopt:" + name, raw.len(), out.len(), false)
    make_tool_result(id, out)

fn _ctx_stat_get(d: Dict<text, i64>, k: text) -> i64:
    if d.contains_key(k):
        return d[k]
    0

fn ctx_stats_text() -> text:
    val chunks = _ctx_load_chunks()
    var sources: Dict<text, i64> = {}
    var stored_bytes: i64 = 0
    for c in chunks:
        stored_bytes = stored_bytes + c.bytes
        if sources.contains_key(c.source):
            sources[c.source] = sources[c.source] + 1
        else:
            sources[c.source] = 1
    val d = _ctx_load_stats()
    val indexed = _ctx_stat_get(d, "bytes_indexed")
    val returned = _ctx_stat_get(d, "bytes_returned")
    var saved = indexed - returned
    if saved < 0:
        saved = 0
    var lines: [text] = []
    lines.push("ctx store: " + ctx_store_dir())
    lines.push("chunks: " + str(chunks.len()))
    lines.push("sources: " + str(sources.len()))
    lines.push("stored_bytes: " + str(stored_bytes))
    lines.push("bytes_indexed: " + str(indexed))
    lines.push("bytes_returned: " + str(returned))
    lines.push("bytes_saved: " + str(saved))
    lines.push("capture_max_bytes: " + str(ctx_capture_max_bytes()))
    lines.push("capture_truncations: " + str(_ctx_stat_get(d, "capture_truncations")))
    lines.push("calls: index=" + str(_ctx_stat_get(d, "index_calls")) + " search=" + str(_ctx_stat_get(d, "search_calls")) + " exec=" + str(_ctx_stat_get(d, "exec_calls")) + " batch=" + str(_ctx_stat_get(d, "batch_calls")) + " fetch=" + str(_ctx_stat_get(d, "fetch_calls")))
    # Token-savings telemetry (see simple_token_stats for the per-feature view).
    val tok = tok_rollup(tok_load_events(), TOK_FEATURE_CTX, _ctx_now_secs())
    lines.push("telemetry_calls: " + str(tok.calls))
    lines.push("telemetry_bytes_captured: " + str(tok.captured))
    lines.push("telemetry_bytes_returned: " + str(tok.returned))
    lines.push("telemetry_tokens_saved: " + str(tok.saved))
    lines.push("telemetry_tokens_saved_7d: " + str(tok.saved_7d))
    lines.join("\n")

fn handle_simple_ctx_stats(id: text, body: text) -> text:
    make_tool_result(id, ctx_stats_text())

# ---------------------------------------------------------------------------
# Doctor: self-check of the ctx store
# ---------------------------------------------------------------------------

const _CTX_HOOK_FILES: [text] = [
    ".claude/hooks/bash_net_blocker.shs",
    ".claude/hooks/bash_output_hint.shs",
    ".claude/hooks/webfetch_deny.shs",
    ".claude/hooks/read_analysis_hint.shs",
    ".claude/hooks/ctx_common.shs",
]

fn _ctx_check_line(ok: bool, label: text) -> text:
    if ok:
        return "[ok] " + label
    "[FAIL] " + label

# Chunks whose stored body is empty/whitespace-only — nothing a search can
# ever rank, left behind by an interrupted write or a since-fixed bug.
fn _ctx_count_orphans(chunks: [CtxChunk]) -> i64:
    var n: i64 = 0
    for c in chunks:
        if c.body.trim() == "":
            n = n + 1
    n

fn ctx_doctor_text() -> text:
    var lines: [text] = []
    val dir = ctx_store_dir()
    val dir_existed = file_exists(dir)
    val dir_ok = dir_existed or _ctx_ensure_dir()
    lines.push(_ctx_check_line(dir_ok, "store dir '" + dir + "' exists"))

    # Writable: round-trip a probe file through the atomic-write path, then
    # remove it — never leaves scratch state behind.
    val probe = dir + "/.doctor_probe"
    val write_ok = _ctx_write_atomic(probe, "probe")
    val read_ok = write_ok and file_exists(probe) and file_read(probe) == "probe"
    if file_exists(probe):
        file_delete(probe)
    lines.push(_ctx_check_line(read_ok, "store dir is writable (probe write+read+cleanup)"))

    val chunks = _ctx_load_chunks()
    lines.push("[ok] index row count: " + str(chunks.len()))

    val orphans = _ctx_count_orphans(chunks)
    lines.push(_ctx_check_line(orphans == 0, "orphan chunks (empty body): " + str(orphans)))

    val schema_ok = _ctx_detect_schema_version() == _CTX_SCHEMA_VERSION
    lines.push(_ctx_check_line(schema_ok, "chunk store schema is current (v" + str(_CTX_SCHEMA_VERSION) + "; run simple_ctx_upgrade if not)"))

    for hf in _CTX_HOOK_FILES:
        lines.push(_ctx_check_line(file_exists(hf), "hook file present: " + hf))

    lines.join("\n")

fn handle_simple_ctx_doctor(id: text, body: text) -> text:
    make_tool_result(id, ctx_doctor_text())

# ---------------------------------------------------------------------------
# Upgrade: re-index/compact the store
# ---------------------------------------------------------------------------

# The chunk file's schema is stamped in a header comment. A store written
# before this stamp existed (or by an older schema version) reads back as
# version 0 and gets rewritten below.
fn _ctx_detect_schema_version() -> i64:
    val path = _ctx_chunks_path()
    if not file_exists(path):
        return _CTX_SCHEMA_VERSION
    val content = file_read(path)
    if content.contains("# ctx_schema_version: " + str(_CTX_SCHEMA_VERSION)):
        return _CTX_SCHEMA_VERSION
    0

# Public accessor for specs — mirrors _ctx_detect_schema_version.
fn ctx_schema_version() -> i64:
    _ctx_detect_schema_version()

# Rewrites the chunk store under the current schema: drops orphan (empty-body)
# rows and re-stamps the schema header. Returns (before_count, after_count,
# before_version).
fn ctx_upgrade_store() -> (i64, i64, i64):
    val before = _ctx_load_chunks()
    val before_version = _ctx_detect_schema_version()
    val before_count = before.len()
    var kept: [CtxChunk] = []
    for c in before:
        if c.body.trim() != "":
            kept.push(c)
    _ctx_ensure_dir()
    var lines: [text] = []
    lines.push("# ctx chunk store — written by simple_ctx_* MCP tools. Do not edit by hand.\n")
    lines.push("# ctx_schema_version: " + str(_CTX_SCHEMA_VERSION) + "\n")
    lines.push("ctx_chunks | id, source, ts, bytes, text |\n")
    for c in kept:
        lines.push(_ctx_chunk_line(c))
    _ctx_write_atomic(_ctx_chunks_path(), lines.join(""))
    (before_count, kept.len(), before_version)

fn handle_simple_ctx_upgrade(id: text, body: text) -> text:
    val (before_count, after_count, before_version) = ctx_upgrade_store()
    var msg = "ctx upgrade: schema v" + str(before_version) + " -> v" + str(_CTX_SCHEMA_VERSION) + ", chunks " + str(before_count) + " -> " + str(after_count)
    if before_count != after_count:
        msg = msg + " (" + str(before_count - after_count) + " orphan/empty chunk(s) dropped)"
    _ctx_stats_bump("upgrade_calls", 1)
    make_tool_result(id, msg)

