# Manifest-driven lightweight startup argument parsing and pre-main loading.
#
# Only arguments declared by SimpleArtifactManifest.argument_schema are parsed.
# Only files declared by startup_preloads are opened.  The provider performs
# either a native mmap preload (POSIX/Linux) or VFS page prewarm (SimpleOS).

use app.startup.launch_metadata.{startup_normalize_program_args}
use common.platform.dedicated_host.{DedicatedHost, HostFilePreload}
use os.kernel.loader.artifact_manifest.{
    ManifestArgument,
    ManifestPreload,
    SimpleArtifactManifest
}

pub struct StartupArgumentValue:
    name: text
    value: text

pub struct StartupFileArguments:
    ok: bool
    program_args: [text]
    values: [StartupArgumentValue]
    error: text

pub struct StartupBeforeMainResult:
    ok: bool
    phase: text
    arguments: StartupFileArguments
    preloads: [HostFilePreload]
    error: text

fn _startup_argument_value(values: [StartupArgumentValue], name: text) -> text:
    for entry in values:
        if entry.name == name:
            return entry.value
    ""

fn _startup_argument_present(values: [StartupArgumentValue], name: text) -> bool:
    for entry in values:
        if entry.name == name:
            return true
    false

fn _startup_argument_error(program_args: [text], values: [StartupArgumentValue], error: text) -> StartupFileArguments:
    StartupFileArguments(ok: false, program_args: program_args, values: values, error: error)

pub fn startup_parse_file_arguments(
    entry_path: text,
    args: [text],
    schema: [ManifestArgument]
) -> StartupFileArguments:
    val normalized = startup_normalize_program_args(entry_path, args)
    var values: [StartupArgumentValue] = []
    var i = 1
    while i < normalized.len():
        val arg = normalized[i]
        for declaration in schema:
            val inline_prefix = declaration.name + "="
            if arg == declaration.name or arg.starts_with(inline_prefix):
                if _startup_argument_present(values, declaration.name):
                    return _startup_argument_error(normalized, values, "duplicate-argument:" + declaration.name)
                var value = ""
                if declaration.value_kind == "flag":
                    if arg != declaration.name:
                        return _startup_argument_error(normalized, values, "flag-must-not-have-value:" + declaration.name)
                    value = "true"
                elif arg.starts_with(inline_prefix):
                    value = arg.slice(inline_prefix.len(), arg.len())
                else:
                    if i + 1 >= normalized.len():
                        return _startup_argument_error(normalized, values, "missing-value:" + declaration.name)
                    i = i + 1
                    value = normalized[i]
                if value == "" and declaration.value_kind != "flag":
                    return _startup_argument_error(normalized, values, "empty-value:" + declaration.name)
                values.push(StartupArgumentValue(name: declaration.name, value: value))
        i = i + 1

    for declaration in schema:
        if not _startup_argument_present(values, declaration.name):
            if declaration.default_value != "":
                values.push(StartupArgumentValue(name: declaration.name, value: declaration.default_value))
            elif declaration.required:
                return _startup_argument_error(normalized, values, "missing-required-argument:" + declaration.name)
    StartupFileArguments(ok: true, program_args: normalized, values: values, error: "")

fn _startup_preload_path(spec: ManifestPreload, values: [StartupArgumentValue]) -> text:
    if spec.fixed_path != "" and spec.source_arg == "":
        return spec.fixed_path
    if spec.source_arg != "" and spec.fixed_path == "":
        return _startup_argument_value(values, spec.source_arg)
    ""

fn _startup_before_main_error(
    arguments: StartupFileArguments,
    preloads: [HostFilePreload],
    error: text
) -> StartupBeforeMainResult:
    StartupBeforeMainResult(
        ok: false,
        phase: "blocked-before-main",
        arguments: arguments,
        preloads: preloads,
        error: error
    )

pub fn startup_before_main(
    host: DedicatedHost,
    entry_path: text,
    args: [text],
    manifest: SimpleArtifactManifest
) -> StartupBeforeMainResult:
    val arguments = startup_parse_file_arguments(entry_path, args, manifest.argument_schema)
    var preloads: [HostFilePreload] = []
    if not arguments.ok:
        return _startup_before_main_error(arguments, preloads, arguments.error)
    var active_host = host
    val page_size = active_host.page_size()
    if page_size <= 0:
        return _startup_before_main_error(arguments, preloads, "page-size-must-be-positive")
    for spec in manifest.startup_preloads:
        if spec.mode != "map_read_only" and spec.mode != "read_ahead":
            return _startup_before_main_error(arguments, preloads, "unsupported-preload-mode:" + spec.mode)
        val path = _startup_preload_path(spec, arguments.values)
        if path == "":
            if spec.required:
                return _startup_before_main_error(arguments, preloads, "required-preload-path-missing")
            continue
        val preload = active_host.preload_readonly_file(path, page_size)
        preloads.push(preload)
        if not preload.ok:
            if spec.required:
                return _startup_before_main_error(arguments, preloads, "required-preload-failed:" + path + ":" + preload.error)
            continue
        if spec.maximum_bytes > 0 and preload.byte_count > spec.maximum_bytes:
            return _startup_before_main_error(arguments, preloads, "preload-maximum-bytes-exceeded:" + path)

    StartupBeforeMainResult(
        ok: true,
        phase: "ready-before-main",
        arguments: arguments,
        preloads: preloads,
        error: ""
    )
