"""Canonical transport-neutral model for LLM Caret messaging."""

struct MessagingId:
    kind: text
    value: text

enum IdentityKind:
    Human
    Agent
    Bridge
    System

enum AgentStatus:
    Offline
    Idle
    Queued
    Running
    WaitingInput
    Blocked
    Completed
    Failed
    Stopped

enum RoomKind:
    Channel
    Private
    Direct
    Task

enum MessageOrigin:
    Human
    AgentAnswer
    AgentUpdate
    System
    TransportBridge
    CommandResult

struct Workspace:
    workspace_id: MessagingId
    name: text
    created_at: i64

struct Identity:
    identity_id: MessagingId
    workspace_id: MessagingId
    kind: IdentityKind
    account_id: text
    display_name: text
    external_transport: text
    external_id: text
    created_at: i64

enum AgentHandler:
    Main
    Subagent
    Advisor
    Router

struct AgentProfile:
    agent_id: MessagingId
    display_name: text
    aliases: [text]
    provider: text
    role_summary: text
    capabilities: [text]
    current_task_id: text
    status: AgentStatus
    owner_identity_id: text
    room_ids: [text]
    last_activity_at: i64

struct Room:
    room_id: MessagingId
    workspace_id: MessagingId
    kind: RoomKind
    name: text
    topic: text
    visibility: text
    mode: text
    update_policy: text
    context_policy: text
    created_by: MessagingId
    created_at: i64

struct RoomMessage:
    message_id: MessagingId
    workspace_id: MessagingId
    room_id: MessagingId
    room_seq: i64
    thread_root_id: text
    reply_to_id: text
    sender_identity_id: MessagingId
    sender_agent_id: text
    origin: MessageOrigin
    body: text
    mentions: [text]
    command: text
    audience: [text]
    external_ref: text
    correlation_id: text
    causation_id: text
    hop_count: i64
    created_at: i64
    edited_at: i64

struct AgentBinding:
    binding_id: MessagingId
    room_id: MessagingId
    agent_id: MessagingId
    handler: AgentHandler
    session_policy: text
    trigger_policy: text
    update_policy: text
    context_policy: text
    permissions: [text]

pub fn messaging_id(kind: text, value: text) -> MessagingId:
    MessagingId(kind: kind.trim().lower(), value: value.trim())

pub fn messaging_id_valid(id: MessagingId) -> bool:
    id.kind != "" and id.value != "" and not id.value.contains(" ")

export MessagingId, IdentityKind, AgentStatus, RoomKind, MessageOrigin, AgentHandler
export Workspace, Identity, AgentProfile, Room, RoomMessage, AgentBinding
export messaging_id, messaging_id_valid
