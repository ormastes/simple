"""Validated activation policy for the v1 composite agent plugin."""

struct MessagingAgentSelection:
    valid: bool
    agents: [text]
    error: text

fn parse_messaging_agent_selection(raw_value: text) -> MessagingAgentSelection:
    var raw = raw_value.trim()
    if raw == "":
        raw = "claude,codex,gemini"
    var selected: [text] = []
    for item in raw.split(","):
        val agent = item.trim().lower()
        if agent == "" or (agent != "claude" and agent != "codex" and agent != "gemini"):
            return MessagingAgentSelection(valid: false, agents: [],
                error: "unsupported_agent_selection:" + agent)
        if selected.contains(agent):
            return MessagingAgentSelection(valid: false, agents: [],
                error: "duplicate_agent_selection:" + agent)
        selected.push(agent)
    if selected.len() != 3 or not selected.contains("claude") or
            not selected.contains("codex") or not selected.contains("gemini"):
        return MessagingAgentSelection(valid: false, agents: selected,
            error: "composite_plugin_requires_claude_codex_gemini")
    MessagingAgentSelection(valid: true, agents: selected, error: "")

fn agent_activation_sdn(selection: MessagingAgentSelection) -> text:
    if not selection.valid: return ""
    "activation:\n  schema: simple.llm-caret-messaging.activation/v1\n  agents: [" +
        selection.agents.join(", ") + "]\n"

export MessagingAgentSelection, parse_messaging_agent_selection, agent_activation_sdn
