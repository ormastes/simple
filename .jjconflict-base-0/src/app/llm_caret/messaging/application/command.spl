"""Canonical mention and room command parsing."""

struct ParsedCommand:
    name: text
    target: text
    reference: text
    body: text

fn _visible_text(body: text) -> text:
    var visible = ""
    var fenced = false
    for line in body.split("\n"):
        if line.trim().starts_with("```"):
            fenced = not fenced
        elif not fenced:
            visible = visible + " " + line
    visible

pub fn mentions_agent(body: text, canonical_name: text, aliases: [text]) -> bool:
    val visible = _visible_text(body).lower()
    if visible.contains("@" + canonical_name.lower()) and not visible.contains("\\@" + canonical_name.lower()):
        return true
    for alias in aliases:
        if visible.contains("@" + alias.lower()) and not visible.contains("\\@" + alias.lower()):
            return true
    false

pub fn keyword_matches(body: text, keywords: [text]) -> bool:
    val visible = _visible_text(body).lower()
    for keyword in keywords:
        if keyword != "" and visible.contains(keyword.lower()):
            return true
    false

pub fn parse_room_command(body: text) -> ParsedCommand:
    val trimmed = body.trim()
    if not trimmed.starts_with("/"):
        return ParsedCommand(name: "", target: "", reference: "", body: trimmed)
    val parts = trimmed.split(" ")
    val name = parts[0].substring(1).lower()
    var target = ""
    var reference = ""
    var rest = ""
    var i = 1
    while i < parts.len():
        val part = parts[i]
        if target == "" and part.starts_with("@"):
            target = part.substring(1)
        elif reference == "" and (part == "^" or part.starts_with("#")):
            reference = part
        elif part != "":
            rest = if rest == "": part else: rest + " " + part
        i = i + 1
    ParsedCommand(name: name, target: target, reference: reference, body: rest)

export ParsedCommand, mentions_agent, keyword_matches, parse_room_command
