#![allow(primitive_api, unnamed_duplicate_typed_args)]
@allow(primitive_api, unnamed_duplicate_typed_args)
"""Pure room lifecycle and membership operations for the primitive service.

Wire-facing primitive timestamps and flags are intentionally translated into
domain records at this application boundary.
"""

use app.llm_caret.messaging.domain.model.{MessagingId, Room, RoomKind, messaging_id, messaging_id_valid}

struct RoomMembership:
    room_id: text
    identity_id: text
    role: text
    joined_at: i64

struct RoomMutation:
    accepted: bool
    error: text
    room: Room
    memberships: [RoomMembership]

fn _empty_room() -> Room:
    Room(room_id: messaging_id("room", "invalid"), workspace_id: messaging_id("workspace", "invalid"),
        kind: RoomKind.Channel, name: "", topic: "", visibility: "", mode: "",
        update_policy: "", context_policy: "", created_by: messaging_id("identity", "invalid"), created_at: 0)

fn _has_member(memberships: [RoomMembership], room_id: text, identity_id: text) -> bool:
    for membership in memberships:
        if membership.room_id == room_id and membership.identity_id == identity_id:
            return true
    false

pub fn create_room(room_id: text, workspace_id: text, kind: RoomKind, name: text, topic: text,
        visibility: text, mode: text, update_policy: text, context_policy: text,
        created_by: text, created_at: i64) -> RoomMutation:
    val room_key = messaging_id("room", room_id)
    val workspace_key = messaging_id("workspace", workspace_id)
    val creator_key = messaging_id("identity", created_by)
    if not messaging_id_valid(room_key) or not messaging_id_valid(workspace_key) or not messaging_id_valid(creator_key):
        return RoomMutation(accepted: false, error: "invalid_id", room: _empty_room(), memberships: [])
    if kind != RoomKind.Direct and name.trim() == "":
        return RoomMutation(accepted: false, error: "room_name_required", room: _empty_room(), memberships: [])
    if mode != "room" and mode != "mention" and mode != "keyword":
        return RoomMutation(accepted: false, error: "invalid_room_mode", room: _empty_room(), memberships: [])
    val room = Room(room_id: room_key, workspace_id: workspace_key, kind: kind, name: name.trim(),
        topic: topic.trim(), visibility: visibility, mode: mode, update_policy: update_policy,
        context_policy: context_policy, created_by: creator_key, created_at: created_at)
    val owner = RoomMembership(room_id: room_id, identity_id: created_by, role: "owner", joined_at: created_at)
    RoomMutation(accepted: true, error: "", room: room, memberships: [owner])

pub fn add_room_member(room: Room, memberships: [RoomMembership], identity_id: text, role: text, joined_at: i64) -> RoomMutation:
    if identity_id.trim() == "" or role.trim() == "":
        return RoomMutation(accepted: false, error: "invalid_membership", room: room, memberships: memberships)
    if _has_member(memberships, room.room_id.value, identity_id):
        return RoomMutation(accepted: true, error: "", room: room, memberships: memberships)
    val membership = RoomMembership(room_id: room.room_id.value, identity_id: identity_id, role: role, joined_at: joined_at)
    RoomMutation(accepted: true, error: "", room: room, memberships: memberships + [membership])

pub fn remove_room_member(room: Room, memberships: [RoomMembership], identity_id: text) -> RoomMutation:
    var remaining: [RoomMembership] = []
    var removed = false
    for membership in memberships:
        if membership.room_id == room.room_id.value and membership.identity_id == identity_id:
            removed = true
        else:
            remaining = remaining + [membership]
    if not removed:
        return RoomMutation(accepted: false, error: "membership_not_found", room: room, memberships: memberships)
    RoomMutation(accepted: true, error: "", room: room, memberships: remaining)

pub fn create_direct_room(room_id: text, workspace_id: text, first_identity_id: text,
        second_identity_id: text, created_at: i64) -> RoomMutation:
    if first_identity_id == second_identity_id or second_identity_id.trim() == "":
        return RoomMutation(accepted: false, error: "direct_room_requires_two_identities", room: _empty_room(), memberships: [])
    val created = create_room(room_id, workspace_id, RoomKind.Direct, "", "", "private", "mention",
        "milestones", "direct", first_identity_id, created_at)
    if not created.accepted:
        return created
    add_room_member(created.room, created.memberships, second_identity_id, "member", created_at)

pub fn identity_can_read(room: Room, memberships: [RoomMembership], identity_id: text) -> bool:
    if room.visibility == "public":
        return true
    _has_member(memberships, room.room_id.value, identity_id)

export RoomMembership, RoomMutation
export create_room, add_room_member, remove_room_member, create_direct_room, identity_can_read
