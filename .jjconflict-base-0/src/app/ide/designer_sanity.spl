# Designer capability sanity probe.
#
# Runs against std.common.markdown_visual_editor directly so the feature-check
# row reports real behavior instead of "manifest-only". Mirrors ide_mail_summary.

use std.common.markdown_visual_editor.{markdown_visual_note, markdown_visual_is_markdown_path, markdown_visual_preview_lines}

fn _ide_designer_source() -> text:
    val lines = [
        "# Landing Page",
        "- hero band",
        "- footer band",
        "Tokens come from [[theme]] and [[layout]]."
    ]
    lines.join("\n")

fn ide_designer_summary() -> text:
    val source = _ide_designer_source()
    val note = markdown_visual_note("design/landing.md", source)
    val blocks = note.blocks.len()
    var headings = 0
    var bullets = 0
    for block in note.blocks:
        if block.kind == "heading":
            headings = headings + 1
        if block.kind == "bullet":
            bullets = bullets + 1
    val links = note.wiki_links.len()
    # An H1 wins over the filename; a note without one falls back to the basename.
    var titles = 0
    if note.title == "Landing Page":
        titles = titles + 1
    if markdown_visual_note("design/untitled.md", "plain body").title == "untitled":
        titles = titles + 1
    # Bullets must be re-marked when the source is rendered back to a preview.
    val rows = markdown_visual_preview_lines(source)
    val prev = rows.len()
    var marked = false
    for row in rows:
        if row == "* hero band":
            marked = true
    val paths = markdown_visual_is_markdown_path("design/landing.md") and not markdown_visual_is_markdown_path("design/landing.txt")
    "designer: std.common.markdown_visual_editor blocks={blocks} head={headings} bull={bullets} links={links} prev={prev}:{marked} titles={titles}/2 md-path={paths}"
