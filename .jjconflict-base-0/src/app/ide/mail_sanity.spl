# Mail capability sanity probe.
#
# Runs against app.office.mail directly so the feature-check row reports real
# behavior instead of "manifest-only". Mirrors ide_agent_dashboard_summary.

use app.office.mail.mail_app.{MailApp}
use common.ui.widget.{UIEvent}

fn ide_mail_summary() -> text:
    var app = MailApp.new()
    val total = app.emails.len()
    val folders = app.folders.len()
    val inbox = app.filtered_emails().len()
    val unread_before = app.unread_count()
    # Selecting an unread email marks it read, so the unread count must drop.
    var read_on_select = false
    if total > 0:
        app.handle_event(UIEvent.Action("select_email_" + app.emails[0].id))
        read_on_select = app.unread_count() < unread_before
    # Compose is a real state transition, not a no-op.
    app.handle_event(UIEvent.Action("compose"))
    val composing = app.composing
    app.handle_event(UIEvent.Action("discard"))
    val discarded = not app.composing
    "mail: app.office.mail emails={total} folders={folders} inbox={inbox} unread={unread_before} read-on-select={read_on_select} compose={composing} discard={discarded}"
