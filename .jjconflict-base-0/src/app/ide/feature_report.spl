# IDE feature-check report.
#
# Keeps executable sanity checks separate from capability metadata so each probe
# runs directly against its owning subsystem instead of being precomputed inside
# the registry.

use app.ide.sheets_compat.{ide_sheet_compat_summary}
use app.ide.slides_compat.{ide_slide_compat_summary}
use app.ide.db_admin.{ide_db_admin_summary}
use app.ide.agent_dashboard.{ide_agent_dashboard_summary}
use app.ide.markdown_render.{ide_markdown_render_summary}
use app.ide.launch_sanity.{ide_launch_sanity_summary}
use app.ide.plugin_manifest.{ide_plugin_manifest_summary}
use app.ide.gui_sanity.{ide_gui_sanity_summary}
use app.ide.tui_sanity.{ide_tui_sanity_summary}
use app.ide.mail_sanity.{ide_mail_summary}
use app.ide.planner_sanity.{ide_planner_summary}
use app.ide.draw_sdd_sanity.{ide_draw_sdd_summary}
use app.ide.designer_sanity.{ide_designer_summary}
use app.ide.base_sanity.{ide_base_summary}
use app.ide.math_sanity.{ide_math_summary}
use app.ide.capabilities.{ide_capability_count, ide_capabilities_live}
use app.ide.saml_analysis.{ide_saml_analysis_summary}

fn ide_feature_check_report(mode: text) -> [text]:
    var lines: [text] = []
    lines.push("Simple IDE feature check")
    lines.push("mode: {mode}")
    lines.push("capabilities: {ide_capability_count()}")
    lines.push("markdown: Markdown/Writer [document-renderer] -> std.editor.render.md_renderer (md, markdown, writer, html)")
    lines.push("  check: " + ide_markdown_render_summary())
    lines.push("  edit-command: md-edit=true stale-reject=true reason=stale-line")
    lines.push("slides: Impress/PPT [office-app] -> app.office.slides (ppt, presentation, slides)")
    lines.push("  check: " + ide_slide_compat_summary())
    lines.push("  edit-command: slide-edit=true stale-reject=true reason=stale-slide-element")
    lines.push("sheets: Calc Spreadsheet [office-app] -> app.office.sheets (excel, xlsx, tabular, csv)")
    lines.push("  check: " + ide_sheet_compat_summary())
    lines.push("  edit-command: sheet-edit=true stale-reject=true reason=stale-cell")
    lines.push("  gui: " + ide_gui_sanity_summary())
    lines.push("draw-sdd: Draw/SDD [diagram-app] -> std.editor.services.sdn_graph (draw, sdd, sdn)")
    lines.push("  check: " + ide_draw_sdd_summary())
    lines.push("designer: Designer [designer-app] -> std.common.markdown_visual_editor (html, css, ui)")
    lines.push("  check: " + ide_designer_summary())
    lines.push("base: Base [database-app] -> std.editor.core.session_db (table, database, import)")
    lines.push("  check: " + ide_base_summary())
    lines.push("math: Math [formula-app] -> std.common.math_repr (formula, mathml)")
    lines.push("  check: " + ide_math_summary())
    lines.push("mail: Mail [mail-app] -> app.office.mail (message, folder, compose)")
    lines.push("  check: " + ide_mail_summary())
    lines.push("planner: Planner [planner-app] -> app.office.planner (task, board, calendar)")
    lines.push("  check: " + ide_planner_summary())
    lines.push("agent-dashboard: Agent Dashboard [dashboard] -> app.editor.mcp_tools (agent, dashboard, mcp)")
    lines.push("  check: " + ide_agent_dashboard_summary())
    lines.push("db-admin: Database Admin [database] -> std.editor.core.session_db (embedded-db, simple-db, portal-db)")
    lines.push("  check: " + ide_db_admin_summary())
    lines.push("  tui: " + ide_tui_sanity_summary())
    lines.push("  launch: " + ide_launch_sanity_summary())
    lines.push("  plugin-manifest: " + ide_plugin_manifest_summary())
    lines.push("saml: SAML Analysis [language-analysis] -> std.common.saml (saml, llm-fn, prompt, schema)")
    lines.push("  check: " + ide_saml_analysis_summary())
    return lines

# Live capability-truth report: one line per capability naming its
# kernel-verified state (declared/indexed/activatable/bound) and the command
# id that was probed to reach it. Kept SEPARATE from ide_feature_check_report
# (rather than appended) so that report's line count/order stays a stable
# contract for existing consumers; this is the dedicated live-state surface.
fn ide_capability_truth_report() -> [text]:
    var lines: [text] = ["capability-truth:"]
    for cap in ide_capabilities_live():
        lines.push("  " + cap.id + ": state=" + cap.state + " check=" + cap.feature_check)
    lines
