# Link scanner — byte-offset markdown link extraction (S1-A).
#
# Finds inline links `[text](target)`, reference definitions
# `[label]: target`, reference uses `[text][label]` / `[text][]`, and
# autolinks `<https://...>` in raw markdown bytes, skipping anything inside a
# fenced code block or inline code span (scan/regions.spl).
#
# BYTE OFFSETS ONLY (plan §3.5.1): this scanner iterates the UTF-8 byte array
# via `text_to_bytes`, never `text.len()`/`s[i]` char indexing, so a document
# containing multibyte (non-ASCII) text before/inside/after a link scans and
# slices correctly. `SourceRange.start_offset`/`end_offset`/`target_start`/
# `target_end` are exact byte offsets into the original source.

use std.common.string_core.{text_to_bytes, bytes_to_text}
use app.spipe.model.types.{SourceRange, LinkForm}
use app.spipe.scan.regions.{excluded_regions, is_excluded, ByteRange}

fn _byte(bytes: [u8], i: i64) -> u8:
    bytes[i]

fn _is(bytes: [u8], i: i64, ch: i64) -> bool:
    i >= 0 and i < bytes.len() and (bytes[i] as i64) == ch

# `[` = 91, `]` = 93, `(` = 40, `)` = 41, `<` = 60, `>` = 62, `:` = 58,
# `!` = 33, space = 32, newline = 10.

fn _find_matching_bracket_close(bytes: [u8], open_pos: i64) -> i64:
    # open_pos is the index of `[`. Returns index of the matching `]`, or -1.
    # No nested `[...]` inside link text per this scanner's bounded grammar
    # (a literal `]` inside link text is not supported in slice 1).
    var i = open_pos + 1
    val n = bytes.len()
    while i < n:
        if _is(bytes, i, 93):
            return i
        if _is(bytes, i, 10):
            return -1
        i = i + 1
    -1

fn _slice_text(bytes: [u8], start: i64, end: i64) -> text:
    var out: [u8] = []
    var i = start
    while i < end:
        out.push(bytes[i])
        i = i + 1
    bytes_to_text(out)

# Scans one document's raw bytes for link records. `path` is the canonical
# POSIX-separator path recorded on every emitted `SourceRange`.
fn scan_links(path: text, source: text) -> [SourceRange]:
    val bytes = text_to_bytes(source)
    val n = bytes.len()
    val excl = excluded_regions(source)
    var out: [SourceRange] = []
    var i = 0
    while i < n:
        if is_excluded(i, excl):
            i = i + 1
        elif _is(bytes, i, 60):
            # Possible autolink: <scheme:...>
            val close = _autolink_close(bytes, i)
            if close >= 0:
                val raw = _slice_text(bytes, i + 1, close)
                if _looks_like_autolink(raw):
                    out.push(SourceRange(path: path, start_offset: i, end_offset: close + 1,
                        target_start: i + 1, target_end: close,
                        link_form: LinkForm.Autolink, raw_target: raw,
                        fragment: _fragment_of(raw)))
                    i = close + 1
                else:
                    i = i + 1
            else:
                i = i + 1
        elif _is(bytes, i, 91):
            val label_close = _find_matching_bracket_close(bytes, i)
            if label_close < 0:
                i = i + 1
            elif _is(bytes, label_close + 1, 40):
                # Inline: [text](target)
                val target_open = label_close + 2
                val target_close = _find_paren_close(bytes, target_open)
                if target_close >= 0:
                    val raw = _slice_text(bytes, target_open, target_close)
                    out.push(SourceRange(path: path, start_offset: i,
                        end_offset: target_close + 1, target_start: target_open,
                        target_end: target_close, link_form: LinkForm.Inline,
                        raw_target: raw, fragment: _fragment_of(raw)))
                    i = target_close + 1
                else:
                    i = label_close + 1
            elif _is(bytes, label_close + 1, 91):
                # Reference use: [text][label] or [text][]
                val ref_close = _find_matching_bracket_close(bytes,
                    label_close + 1)
                if ref_close >= 0:
                    val ref_start = label_close + 2
                    val raw = _slice_text(bytes, ref_start, ref_close)
                    out.push(SourceRange(path: path, start_offset: i,
                        end_offset: ref_close + 1, target_start: ref_start,
                        target_end: ref_close, link_form: LinkForm.ReferenceUse,
                        raw_target: raw, fragment: _fragment_of(raw)))
                    i = ref_close + 1
                else:
                    i = label_close + 1
            elif _is(bytes, label_close + 1, 58) and _at_line_start(bytes, i):
                # Reference definition: [label]: target  (must start the line)
                var j = label_close + 2
                while j < n and _is(bytes, j, 32):
                    j = j + 1
                val target_start = j
                var k = j
                while k < n and not _is(bytes, k, 10):
                    k = k + 1
                var target_end = k
                while target_end > target_start and
                        (_is(bytes, target_end - 1, 32) or
                         _is(bytes, target_end - 1, 13)):
                    target_end = target_end - 1
                if target_end > target_start:
                    val raw = _slice_text(bytes, target_start, target_end)
                    out.push(SourceRange(path: path, start_offset: i, end_offset: target_end,
                        target_start: target_start, target_end: target_end,
                        link_form: LinkForm.ReferenceDefinition,
                        raw_target: raw, fragment: _fragment_of(raw)))
                i = k
            else:
                i = label_close + 1
        else:
            i = i + 1
    out

fn _at_line_start(bytes: [u8], pos: i64) -> bool:
    pos == 0 or _is(bytes, pos - 1, 10)

fn _find_paren_close(bytes: [u8], start: i64) -> i64:
    var i = start
    val n = bytes.len()
    var depth = 1
    while i < n:
        if _is(bytes, i, 40):
            depth = depth + 1
        elif _is(bytes, i, 41):
            depth = depth - 1
            if depth == 0:
                return i
        elif _is(bytes, i, 10):
            return -1
        i = i + 1
    -1

fn _autolink_close(bytes: [u8], open_pos: i64) -> i64:
    var i = open_pos + 1
    val n = bytes.len()
    while i < n:
        if _is(bytes, i, 62):
            return i
        if _is(bytes, i, 10) or _is(bytes, i, 32) or _is(bytes, i, 60):
            return -1
        i = i + 1
    -1

fn _looks_like_autolink(raw: text) -> bool:
    raw.contains("://") or raw.starts_with("mailto:")

# Extracts a trailing `#fragment` from a raw link target, if present.
fn _fragment_of(raw: text) -> Option<text>:
    var i = 0
    val bytes = text_to_bytes(raw)
    val n = bytes.len()
    var hash_pos = -1
    while i < n:
        if (bytes[i] as i64) == 35:
            hash_pos = i
        i = i + 1
    if hash_pos < 0:
        return None
    Some(_slice_text(bytes, hash_pos + 1, n))
