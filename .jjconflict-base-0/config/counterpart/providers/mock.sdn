# Counterpart provider descriptor — mock (P1 pilot).
#
# The mock provider has no upstream: it is built from adapter source only, and
# exists to exercise every ABI, worker and negative path before any real
# upstream is attached. Domain lanes add their own descriptor next to this one;
# nobody edits a central registry file.
#
# ADR: doc/04_architecture/infra/adr/adr_counterpart_conformance_contract_freeze_2026-08-09.md

provider:
  provider_id: mock
  provider_kind: native_in_process
  independence_group: mock
  abi_version: 1
  license_spdx: Apache-2.0

  upstream:
    # No upstream project. `fetch` is a no-op for this provider.
    kind: none

  adapter:
    source: tools/counterpart/adapters/mock/simple_counterpart_mock.c
    output: libsimple_counterpart_mock

  components:
    - component_id: mock.echo
      counterpart_boundary_id: mock.execution.echo@1
      deterministic_claim: deterministic
      supported_relations: [byte_exact, canonical_exact]
      supported_execution_modes: [cpu_reference]
    - component_id: mock.hash
      counterpart_boundary_id: mock.execution.hash@1
      deterministic_claim: deterministic
      supported_relations: [byte_exact]
      supported_execution_modes: [cpu_reference]
    - component_id: mock.error
      counterpart_boundary_id: mock.execution.error@1
      deterministic_claim: deterministic
      supported_relations: [semantic_equal]
      supported_execution_modes: [cpu_reference]
    - component_id: mock.crash
      counterpart_boundary_id: mock.execution.crash@1
      deterministic_claim: aborts_by_design
      supported_relations: []
      supported_execution_modes: [cpu_reference]
