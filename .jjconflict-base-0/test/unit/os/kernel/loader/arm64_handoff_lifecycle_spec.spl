use std.spec.*
use os.kernel.loader.arm64_handoff_lifecycle.{arm64_handoff_nonce, arm64_handoff_binding_matches}
use os.kernel.scheduler.scheduler_task_mgmt.{sched_synthetic_bootstrap_parent_matches}

describe "ARM64 blocking handoff identity":
    it "binds the exact task generation address space and nonce":
        val nonce = arm64_handoff_nonce(5, 3, 0x4000)
        expect(arm64_handoff_binding_matches(5, 3, 0x4000, nonce, 5, 3, 0x4000)).to_equal(true)

    it "rejects stale pid generation address space and forged nonce":
        val nonce = arm64_handoff_nonce(5, 3, 0x4000)
        expect(arm64_handoff_binding_matches(5, 3, 0x4000, nonce, 6, 3, 0x4000)).to_equal(false)
        expect(arm64_handoff_binding_matches(5, 3, 0x4000, nonce, 5, 4, 0x4000)).to_equal(false)
        expect(arm64_handoff_binding_matches(5, 3, 0x4000, nonce, 5, 3, 0x5000)).to_equal(false)
        expect(arm64_handoff_binding_matches(5, 3, 0x4000, nonce ^ 1, 5, 3, 0x4000)).to_equal(false)

    it "collects only the exact PID-0 bootstrap child":
        expect(sched_synthetic_bootstrap_parent_matches(0, 5, 5, 0)).to_equal(true)
        expect(sched_synthetic_bootstrap_parent_matches(1, 5, 5, 0)).to_equal(false)
        expect(sched_synthetic_bootstrap_parent_matches(0, 0, 5, 0)).to_equal(false)
        expect(sched_synthetic_bootstrap_parent_matches(0, 0xFFFFFFFFFFFFFFFF, 5, 0)).to_equal(false)
        expect(sched_synthetic_bootstrap_parent_matches(0, 5, 6, 0)).to_equal(false)
        expect(sched_synthetic_bootstrap_parent_matches(0, 5, 5, 2)).to_equal(false)
