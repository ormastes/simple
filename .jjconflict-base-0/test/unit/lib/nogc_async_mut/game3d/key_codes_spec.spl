            expect(KeyCode.A.is_digit()).to_equal(false)

        it "returns false for Space":
            # @req: REQ-LIB-GAME3D_KEY_CODES-001
            step("Verify: returns false for Space")
            expect(KeyCode.Space.is_digit()).to_equal(false)

        it "returns false for F1":
            # @req: REQ-LIB-GAME3D_KEY_CODES-001
