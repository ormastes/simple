use std.spec.*
use std.nogc_async_mut.game3d.key_codes.*

describe "KeyCode":
    context "is_letter()":
        it "returns true for A":
            # @req: REQ-LIB-GAME3D_KEY_CODES-001
            step("Verify: returns true for A")
            expect(KeyCode.A.is_letter()).to_equal(true)

        it "returns true for Z":
            # @req: REQ-LIB-GAME3D_KEY_CODES-001
            step("Verify: returns true for Z")
            expect(KeyCode.Z.is_letter()).to_equal(true)

        it "returns true for M (middle letter)":
            # @req: REQ-LIB-GAME3D_KEY_CODES-001
            step("Verify: returns true for M (middle letter)")
            expect(KeyCode.M.is_letter()).to_equal(true)

        it "returns false for Space":
            # @req: REQ-LIB-GAME3D_KEY_CODES-001
            step("Verify: returns false for Space")
            expect(KeyCode.Space.is_letter()).to_equal(false)

        it "returns false for Num0":
            # @req: REQ-LIB-GAME3D_KEY_CODES-001
            step("Verify: returns false for Num0")
            expect(KeyCode.Num0.is_letter()).to_equal(false)  # oracle: expected value pinned by spec

        it "returns false for Num9":
            # @req: REQ-LIB-GAME3D_KEY_CODES-001
            step("Verify: returns false for Num9")
            expect(KeyCode.Num9.is_letter()).to_equal(false)  # oracle: expected value pinned by spec

        it "returns false for Escape":
            # @req: REQ-LIB-GAME3D_KEY_CODES-001
            step("Verify: returns false for Escape")
            expect(KeyCode.Escape.is_letter()).to_equal(false)

    context "is_digit()":
