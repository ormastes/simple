# # Log Module Export Spec
#
# **Feature IDs:** #LOG-EXPORT
# **Category:** Stdlib
# **Status:** Implemented
#
# Tests that std.log exports are accessible when imported across modules.
# Previously broken: LOG_ERROR (and other constants) were not found when
# log functions were called from an importing module.
#
# Root cause was that module-level val/var are not accessible across module
# boundaries in the interpreter; fixed by using literal integers in log fns.

use std.log.{LOG_ERROR, LOG_WARN, LOG_INFO, LOG_DEBUG, LOG_TRACE, LOG_FATAL, LOG_OFF}
use std.log.{
    LEGACY_LOG_ERROR, LEGACY_LOG_WARN, LEGACY_LOG_INFO, LEGACY_LOG_DEBUG,
    LEGACY_LOG_TRACE, LEGACY_LOG_FATAL, LEGACY_LOG_OFF
}
use std.log.{error, warn, info, debug, trace, fatal}
use std.log.{
    log_set_level, log_register_backend, log_remove_backend,
    ring_backend_new, ring_backend_clear, ring_backend_count,
    ring_backend_level_at
}
fn check(condition: bool):
    expect(condition).to_equal(true)

describe "Log module exports":
    it "LOG_ERROR constant is accessible":
        check(LOG_ERROR == 4)

    it "LOG_WARN constant is accessible":
        check(LOG_WARN == 3)

    it "LOG_INFO constant is accessible":
        check(LOG_INFO == 2)

    it "LOG_DEBUG constant is accessible":
        check(LOG_DEBUG == 1)

    it "LOG_TRACE constant is accessible":
        check(LOG_TRACE == 0)

    it "LOG_FATAL constant is accessible":
        check(LOG_FATAL == 5)

    it "LOG_OFF constant is accessible":
        check(LOG_OFF == 6)

    it "legacy level aliases preserve the old public numeric contract":
        check(LEGACY_LOG_OFF == 0)
        check(LEGACY_LOG_FATAL == 1)
        check(LEGACY_LOG_ERROR == 2)
        check(LEGACY_LOG_WARN == 3)
        check(LEGACY_LOG_INFO == 4)
        check(LEGACY_LOG_DEBUG == 5)
        check(LEGACY_LOG_TRACE == 6)

    it "error function is callable without crash":
        log_set_level(LOG_TRACE)
        val sink = ring_backend_new(8)
        val id = log_register_backend(sink.ops)
        ring_backend_clear(sink)
        error("test", "exported error")
        expect(ring_backend_count(sink)).to_equal(1)
        expect(ring_backend_level_at(sink, 0)).to_equal(LOG_ERROR)
        log_remove_backend(id)

    it "warn function is callable without crash":
        log_set_level(LOG_TRACE)
        val sink = ring_backend_new(8)
        val id = log_register_backend(sink.ops)
        ring_backend_clear(sink)
        warn("test", "exported warn")
        expect(ring_backend_count(sink)).to_equal(1)
        expect(ring_backend_level_at(sink, 0)).to_equal(LOG_WARN)
        log_remove_backend(id)
