"""Prove diagnostic severity overrides avoid byte fragments and needless copies."""

use app.cli.query_rich_common.{
    _DIAG_COLLECT_MODE, _DIAG_COLLECTED, _DIAG_SEVERITY_OVERRIDE,
    _DIAG_SEVERITY_OVERRIDE_COUNT, _diag_emit_or_collect}
use std.io_runtime.file_read
use std.spec.step

fn _reset_severity_override_fixture():
    _DIAG_COLLECT_MODE = true
    _DIAG_COLLECTED = []
    _DIAG_SEVERITY_OVERRIDE = {}
    _DIAG_SEVERITY_OVERRIDE_COUNT = 0

describe "query diagnostic severity override":
    it "preserves identity rewrites exact replacements and suppression":
        step("Route every result once while malformed severity fails closed")
        _reset_severity_override_fixture()
        val unchanged = "{\"severity\":2,\"code\":\"X\",\"message\":\"same\"}"
        _diag_emit_or_collect(unchanged)
        expect(_DIAG_COLLECTED).to_equal([unchanged])

        _DIAG_COLLECTED = []
        val missing_code = "{\"severity\":2,\"message\":\"no code\"}"
        _diag_emit_or_collect(missing_code)
        expect(_DIAG_COLLECTED).to_equal([missing_code])

        _DIAG_COLLECTED = []
        _DIAG_SEVERITY_OVERRIDE = {}
        _DIAG_SEVERITY_OVERRIDE["Y"] = 1
        _DIAG_SEVERITY_OVERRIDE_COUNT = 1
        _diag_emit_or_collect(unchanged)
        expect(_DIAG_COLLECTED).to_equal([unchanged])

        _DIAG_COLLECTED = []
        _DIAG_SEVERITY_OVERRIDE = {}
        _DIAG_SEVERITY_OVERRIDE["X"] = 2
        _diag_emit_or_collect(unchanged)
        expect(_DIAG_COLLECTED).to_equal([unchanged])

        _DIAG_COLLECTED = []
        val multi = "{\"severity\":20,\"code\":\"X\",\"message\":\"rewrite\"}"
        _DIAG_SEVERITY_OVERRIDE["X"] = 1
        _diag_emit_or_collect(multi)
        expect(_DIAG_COLLECTED).to_equal([
            "{\"severity\":1,\"code\":\"X\",\"message\":\"rewrite\"}"])

        _DIAG_COLLECTED = []
        val malformed = "{\"severity\":\"bad\",\"code\":\"X\"}"
        _diag_emit_or_collect(malformed)
        expect(_DIAG_COLLECTED).to_equal([malformed])

        _DIAG_COLLECTED = []
        val missing = "{\"code\":\"X\",\"message\":\"no severity\"}"
        _diag_emit_or_collect(missing)
        expect(_DIAG_COLLECTED).to_equal([missing])

        _DIAG_COLLECTED = []
        _DIAG_SEVERITY_OVERRIDE["X"] = -1
        _diag_emit_or_collect(unchanged)
        expect(_DIAG_COLLECTED.len()).to_equal(0)
        _reset_severity_override_fixture()
        _DIAG_COLLECT_MODE = false

    it "uses byte digits an unchanged fast path and one final join":
        step("Reject per-digit substrings and growing immutable rewrites")
        val source = file_read("src/app/cli/query_rich_common.spl")
        val start = source.index_of("fn _diag_rewrite_severity(")
        val finish = source.index_of("fn _diag_emit_or_collect(", start)
        expect(start).to_be_greater_than(-1)
        expect(finish).to_be_greater_than(start)
        val rewrite = source.slice(start, finish)
        expect(rewrite).to_contain("_diag_is_digit_byte(json_str.byte_at(vend))")
        expect(rewrite).to_contain("if vend == vstart:")
        expect(rewrite).to_contain("severity_text.len() == vend - vstart")
        expect(rewrite).to_contain("severity_text.byte_at(si)")
        expect(rewrite).to_contain("json_str.substring(0, vstart)")
        expect(rewrite).to_contain("json_str.substring(vend)")
        expect(rewrite).to_contain("parts.join(\"\")")
        expect(rewrite).not.to_contain("substring(vend, vend + 1)")
        expect(rewrite).not.to_contain(" + sev.to_string() + ")

        val emit_start = finish
        val emit_end = source.index_of("fn query_file_read_rich(", emit_start)
        val emit = source.slice(emit_start, emit_end)
        val gate = emit.index_of("if _DIAG_SEVERITY_OVERRIDE_COUNT > 0:")
        val code_scan = emit.index_of("val code = _diag_code_of(json_str)")
        val membership = emit.index_of("_DIAG_SEVERITY_OVERRIDE.has(code)")
        val suppress = emit.index_of("if ov < 0:")
        val route = emit.index_of("out = _diag_rewrite_severity(json_str, ov)")
        val collect = emit.index_of("if _DIAG_COLLECT_MODE:")
        expect(gate).to_be_greater_than(-1)
        expect(code_scan).to_be_greater_than(gate)
        expect(membership).to_be_greater_than(code_scan)
        expect(suppress).to_be_greater_than(membership)
        expect(route).to_be_greater_than(suppress)
        expect(collect).to_be_greater_than(route)
        expect(emit.split("_diag_code_of(json_str)").len()).to_equal(2)
        expect(emit).to_contain("if _DIAG_SEVERITY_OVERRIDE_COUNT > 0:\n        val code = _diag_code_of(json_str)\n        if code != \"\" and _DIAG_SEVERITY_OVERRIDE.has(code):\n            val ov = _DIAG_SEVERITY_OVERRIDE[code]\n            if ov < 0:\n                return  # suppressed (Allow)\n            out = _diag_rewrite_severity(json_str, ov)")
