# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use app.llm_dashboard.gui.ios_css.{ios_css_overrides}

describe "ios_css":
    # @manual scenario evidence
    describe "ios_css_overrides":
        it "AC-5: returns a non-empty CSS string":
            # @req REQ-SSPEC-UNIT
            step("AC-5: returns a non-empty CSS string")
            val css = ios_css_overrides()
            expect(css.len()).to_be_greater_than(0)

        it "AC-5: contains -webkit-overflow-scrolling for touch scroll":
            # @req REQ-SSPEC-UNIT
            step("AC-5: contains -webkit-overflow-scrolling for touch scroll")
            val css = ios_css_overrides()
            expect(css).to_contain("-webkit-overflow-scrolling")

        it "AC-5: contains iOS accent color #007AFF":
            # @req REQ-SSPEC-UNIT
            step("AC-5: contains iOS accent color #007AFF")
            val css = ios_css_overrides()
            expect(css).to_contain("#007AFF")

        it "AC-5: contains 44px touch target min-height":
            # @req REQ-SSPEC-UNIT
            step("AC-5: contains 44px touch target min-height")
            val css = ios_css_overrides()
            expect(css).to_contain("min-height: 44px")
