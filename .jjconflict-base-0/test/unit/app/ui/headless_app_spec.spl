# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Feature: Headless Application for UI Testing
# Category: UI Components
# Status: Implemented

use std.spec.step

use std.spec.*

use app.ui.none.app.{HeadlessApp}
use common.ui.widget.{UIEvent, UIMode}


# ============================================================================
# Test Group 1: Loading
# ============================================================================

describe "HeadlessApp Loading":
    # @manual scenario evidence

    it "loads a valid .ui.sdn file":
        val result = HeadlessApp.new("examples/06_io/ui/minimal.ui.sdn")
        match result:
            Ok(app) =>
                expect(true).to_equal(true)
            Err(e) =>
                expect(false).to_equal(true)

    it "returns error for nonexistent file":
        # @req REQ-SSPEC-UNIT
        step("returns error for nonexistent file")
        val result = HeadlessApp.new("nonexistent/path.ui.sdn")
        match result:
            Ok(app) =>
                expect(false).to_equal(true)
            Err(e) =>
                expect(true).to_equal(true)


# ============================================================================
# Test Group 2: Running
# ============================================================================

describe "HeadlessApp Running":

    it "performs initial render on run":
        val result = HeadlessApp.new("examples/06_io/ui/minimal.ui.sdn")
        match result:
            Ok(app) =>
                val run_result = app.run()
                match run_result:
                    Ok(_) =>
                        expect(app.render_count()).to_be_greater_than(0)
                    Err(e) =>
                        expect(false).to_equal(true)
            Err(e) =>
                expect(false).to_equal(true)

    it "stops on Quit event":
        val result = HeadlessApp.new("examples/06_io/ui/minimal.ui.sdn")
        match result:
            Ok(app) =>
                app.inject_event(UIEvent.Quit)
                val run_result = app.run()
                match run_result:
                    Ok(_) =>
                        expect(true).to_equal(true)
                    Err(e) =>
                        expect(false).to_equal(true)
            Err(e) =>
                expect(false).to_equal(true)


# ============================================================================
# Test Group 3: State Transitions
# ============================================================================

describe "HeadlessApp State Transitions":

    it "returns current state":
        val result = HeadlessApp.new("examples/06_io/ui/minimal.ui.sdn")
        match result:
            Ok(app) =>
                val state = app.current_state()
                expect(state.tree.title).to_equal("Minimal")
            Err(e) =>
                expect(false).to_equal(true)

    it "processes FocusNext event":
        val result = HeadlessApp.new("examples/06_io/ui/minimal.ui.sdn")
        match result:
            Ok(app) =>
                val new_state = app.run_single_event(UIEvent.FocusNext)
                expect(new_state.tree.title).to_equal("Minimal")
            Err(e) =>
                expect(false).to_equal(true)

    it "processes CommandMode event":
        val result = HeadlessApp.new("examples/06_io/ui/minimal.ui.sdn")
        match result:
            Ok(app) =>
                val new_state = app.run_single_event(UIEvent.CommandMode)
                expect(app.render_count()).to_be_greater_than(0)
            Err(e) =>
                expect(false).to_equal(true)


# ============================================================================
# Test Group 4: Render Capture
# ============================================================================

describe "HeadlessApp Render Capture":

    it "captures rendered HTML":
        val result = HeadlessApp.new("examples/06_io/ui/minimal.ui.sdn")
        match result:
            Ok(app) =>
                app.run()
                val html = app.last_html()
                expect(html.len()).to_be_greater_than(0)
            Err(e) =>
                expect(false).to_equal(true)
