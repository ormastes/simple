"""
## Purpose and audience
Purpose: Prove that typed empty array constructor generalization.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-SEMANTIC-001 — stable requirement identity for this spec.

# Generalization spec for the typed empty-array constructor fix
# (doc/08_tracking/bug/typed_empty_array_constructor_rejected_2026-08-10.md):
# the `[T]()` form must work for other primitive element types, nested
# array element types, and user-defined class element types -- and must NOT
# swallow calls whose array-literal callee is not a type expression.

use std.spec.*

class Point:
    x: i64
    y: i64

describe "typed empty array constructor generalization":
    it "works for f64 element type":
        step("Verify: works for f64 element type")
        # @req: REQ-COMPILER-SEMANTIC-001
        val xs: [f64] = [f64]()
        expect(xs.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "works for str element type":
        step("Verify: works for str element type")
        var ss: [str] = [str]()
        ss.push("a")
        expect(ss.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "works for bool element type":
        step("Verify: works for bool element type")
        val bs: [bool] = [bool]()
        expect(bs.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "works for nested array element type":
        step("Verify: works for nested array element type")
        val nested: [[i64]] = [[i64]]()
        expect(nested.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "works for a user-defined class element type":
        step("Verify: works for a user-defined class element type")
        var ps: [Point] = [Point]()
        ps.push(Point(x: 1, y: 2))
        expect(ps.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(ps[0].x).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "does not intercept a single-element value array literal":
        step("Verify: does not intercept a single-element value array literal")
        val xs = [21]
        expect(xs[0] * 2).to_equal(42)  # oracle: 42 — named expected value from the requirement
