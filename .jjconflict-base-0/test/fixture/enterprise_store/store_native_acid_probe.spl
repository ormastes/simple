# Native store_backend_acid probe (lane W13-A).
#
# Unlike store_open_acid_probe.spl (which replays store_open()'s prologue
# against sqlite_sffi directly), this imports std.enterprise_store itself and
# reads the EnterpriseStore.acid field through store_backend_acid() — the last
# hop left unmeasured by lane W12-A. Importing the store module pulls in
# file_backend.spl, whose rt_file_atomic_write extern is exactly the symbol the
# native link used to drop (doc/08_tracking/bug/
# native_link_missing_rt_file_atomic_write_2026-08-17.md).
use std.nogc_sync_mut.enterprise_store.store

# NOTE: no "{}".format here — native codegen has a str.format dispatch gap
# (Runtime error: Function 'str.format' not found), so print fixed strings.
fn main():
    val store = store_open("/tmp/store_native_acid_probe/probe.db")
    if store.open_ok:
        print("store_open_ok=true")
    else:
        print("store_open_ok=false")
    if store_backend_acid(store):
        print("store_acid=true")
    else:
        print("store_acid=false")
    store_close(store)
