# Fixed workload for scripts/check/check-stage4-memory-gate.shs.
# Allocates a modest, deterministic amount of memory and stays alive long
# enough (default ~6 s) for the out-of-process memstat sampler to attach and
# collect several rows. Lifetime tunable via STAGE4_MEM_GATE_WORKLOAD_MS.

use std.io_runtime.{thread_sleep, env_get}

fn parse_dec(s: text) -> i64:
    var i = 0
    var n = 0
    var found = false
    val len = s.len()
    while i < len:
        val c = s.char_code_at(i)
        if c >= 48 and c <= 57:
            found = true
            n = n * 10 + (c - 48)
        elif found:
            return n
        i = i + 1
    if found:
        return n
    -1

fn main() -> i64:
    var life_ms = 6000
    val env_ms = parse_dec(env_get("STAGE4_MEM_GATE_WORKLOAD_MS"))
    if env_ms > 0:
        life_ms = env_ms

    # Deterministic small allocation so RSS is visibly nonzero.
    var acc: [i64] = []
    var i = 0
    while i < 20000:
        acc = acc.push(i)
        i = i + 1

    var waited = 0
    while waited < life_ms:
        thread_sleep(200)
        waited = waited + 200

    print "gate_workload: done len={acc.len()} waited_ms={waited}"
    0
