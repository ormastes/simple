# @tag: unit, contract, engine2d, retained, damage, frame_switch

use std.spec
use std.io.file.read_text
use common.ui.render_opt.damage_tiles.DirtyTilePyramid
use common.ui.render_opt.damage_plan.build_damage_frame_plan
use common.ui.render_opt.retained_damage_plan.RetainedDamagePlanReceipt
use common.ui.render_opt.retained_frame_schedule.{
    retained_frame_schedule, RETAINED_SCHEDULE_EXECUTE,
    RETAINED_SCHEDULE_DEFER_BUDGET
}

fn execute_schedule_for(plan_pixels: i64):
    val tiles = DirtyTilePyramid.create(8, 6, [1], [1])
    tiles.mark_rect(2, 2, 3, 2)
    val plan = build_damage_frame_plan(tiles, 0, 8, 100)
    val damage = RetainedDamagePlanReceipt(
        accepted: true, source_rect_count: 1, marked_tile_count: 6, plan: plan)
    retained_frame_schedule(damage, 1000, 48, plan_pixels, "focused-contract")

describe "Engine2D retained schedule consumer":
    it "produces an executable exact local schedule for the consumer":
        val schedule = execute_schedule_for(1000)
        expect(schedule.status).to_equal(RETAINED_SCHEDULE_EXECUTE)
        assert_true(schedule.execute_now)

    it "keeps a deferred measured schedule non-executable before consumer dispatch":
        val schedule = execute_schedule_for(10000)
        expect(schedule.status).to_equal(RETAINED_SCHEDULE_DEFER_BUDGET)
        assert_true(not schedule.execute_now)

    it "guards every non-executable or malformed schedule before backend dispatch":
        val source = read_text("src/lib/gc_async_mut/gpu/engine2d/engine.spl")
        expect(source).to_contain("me present_retained_schedule(schedule: RetainedFrameSchedule) -> bool:")
        expect(source).to_contain("if pixels != schedule.planned_pixels:")
        expect(source).to_contain("if ox < x + width and x < ox + ow")
        expect(source).to_contain("schedule.status != RETAINED_SCHEDULE_EXECUTE")
        val reject_state = source.index_of("if not schedule.state_accepted:")
        val reject_deferred = source.index_of(
            "if schedule.status != RETAINED_SCHEDULE_EXECUTE or not schedule.execute_now:")
        val backend_dispatch = source.index_of("rects: schedule.plan_rects, mode: schedule.plan_mode,")
        expect(reject_state >= 0).to_equal(true)
        expect(reject_deferred >= 0).to_equal(true)
        expect(backend_dispatch >= 0).to_equal(true)
        expect(reject_state).to_be_less_than(backend_dispatch)
        expect(reject_deferred).to_be_less_than(backend_dispatch)
