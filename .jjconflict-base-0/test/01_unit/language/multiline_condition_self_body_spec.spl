# Regression spec for item 23 of doc/08_tracking/bug/
# unit_sweep_language_and_interpreter_gaps_2026-08-26.md
#
# Two defects, both in the Rust seed parser.
#
# (a) "expected Indent, found Self_". An `if`/`while` whose condition uses a
#     multi-line operator continuation at the SAME column as the body emits no
#     fresh Indent for the body, so the parser must recognise the body's first
#     token as a statement start. `is_statement_start` listed `Identifier` and
#     `Me` but NOT `Self_` or `Underscore`, so a body beginning `self.x = ...`
#     fell through to `expect(Indent)`. A body starting with anything else --
#     including an ordinary identifier -- parsed fine, which made this look like
#     an indentation problem rather than a token-list omission.
#
# (b) "expected identifier, found Newline" on a hoisted `val`/`var`. NOT the
#     `.?` / `==` continuation the bug record suspected: it is the TYPE
#     ANNOTATION that wraps --
#
#         var g_service_v1:
#             AuthenticatedFsExecUserServiceV1? = nil
#
#     The trailing-colon continuation now mirrors the trailing-`=` continuation
#     the parser already accepted.
#
# The workaround applied across the sweep was to hoist such conditions into a
# local `val`. That is no longer needed for these shapes.

# (b) wrapped type annotation, module level
var g_wrapped:
    i64? = nil

class Counter:
    var total: i64 = 0
    var armed: bool = false

    me arm():
        self.armed = true

    # (a) equal-column condition continuation with a self-led body
    me bump(step: i64, enabled: bool) -> i64:
        if self.armed and
            enabled:
            self.total = self.total + step
            return self.total
        self.total

fn discard_via_underscore(a: bool, b: bool) -> i64:
    if a and
        b:
        _ = 99
        return 1
    0

fn wrapped_local() -> i64:
    val x:
        i64 = 41
    x + 1

describe "multi-line condition with a self-led body":
    it "runs the self-led body when the wrapped condition holds":
        val c = Counter()
        c.arm()
        expect(c.bump(5, true)).to_equal(5)

    it "skips the self-led body when the wrapped condition fails":
        val c = Counter()
        c.arm()
        expect(c.bump(5, false)).to_equal(0)

    it "accepts an `_`-led body after a wrapped condition":
        expect(discard_via_underscore(true, true)).to_equal(1)
        expect(discard_via_underscore(true, false)).to_equal(0)

describe "trailing-colon type annotation continuation":
    it "parses a wrapped type on a module-level var":
        expect(g_wrapped).to_equal(nil)

    it "parses a wrapped type on a local val":
        expect(wrapped_local()).to_equal(42)
