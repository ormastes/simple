# Phase C: invariant lexical grammar for --x<ns>-<key>[=<value>] plus the
# hard `--` terminator boundary (research sections 5.9 and 6.3).
use std.nogc_sync_mut.composition.{
    CLI_TOKEN_EXTENSION, CLI_TOKEN_EXACT_OPTION, CLI_TOKEN_POSITIONAL,
    CLI_TOKEN_TERMINATOR, CLI_TOKEN_PROGRAM_ARG, CLI_TOKEN_MALFORMED,
    cli_namespace_shape_valid_v1, split_cli_extension_token_v1,
    classify_cli_tokens_v1
}

describe "namespace shape [a-z][a-z0-9_]{0,31}":
    it "accepts valid namespace shapes":
        val valid = ["llvm", "log", "a", "interp", "office2", "long_name_ns", "abcdefghijklmnopqrstuvwxyz012345"]
        var accepted = 0
        var i = 0
        while i < valid.len():
            if cli_namespace_shape_valid_v1(valid[i]): accepted = accepted + 1
            i = i + 1
        expect(accepted).to_equal(7)

    it "rejects invalid namespace shapes":
        val invalid = ["", "1llvm", "_ns", "Upper", "has space", "abcdefghijklmnopqrstuvwxyz0123456", "uni-code"]
        var rejected = 0
        var i = 0
        while i < invalid.len():
            if not cli_namespace_shape_valid_v1(invalid[i]): rejected = rejected + 1
            i = i + 1
        expect(rejected).to_equal(7)

describe "lexical splitter for --x tokens":
    it "splits a namespaced key with an = value":
        val tok = split_cli_extension_token_v1("--xllvm-pass=loop-vectorize")
        expect(tok.kind).to_equal(CLI_TOKEN_EXTENSION)
        expect(tok.namespace).to_equal("llvm")
        expect(tok.key).to_equal("pass")
        expect(tok.value).to_equal("loop-vectorize")
        expect(tok.has_value).to_equal(true)

    it "treats the bare form as a flag with no value":
        val tok = split_cli_extension_token_v1("--xoffice-experimental-ribbon")
        expect(tok.kind).to_equal(CLI_TOKEN_EXTENSION)
        expect(tok.namespace).to_equal("office")
        expect(tok.key).to_equal("experimental-ribbon")
        expect(tok.has_value).to_equal(false)
        expect(tok.value).to_equal("")

    it "uses the first dash after --x as the ns/key delimiter":
        val tok = split_cli_extension_token_v1("--xlog-level=debug")
        expect(tok.namespace).to_equal("log")
        expect(tok.key).to_equal("level")
        expect(tok.value).to_equal("debug")

    it "keeps = inside the value after the first =":
        val tok = split_cli_extension_token_v1("--xinterp-define=a=b")
        expect(tok.kind).to_equal(CLI_TOKEN_EXTENSION)
        expect(tok.key).to_equal("define")
        expect(tok.value).to_equal("a=b")

    it "allows an empty value after =":
        val tok = split_cli_extension_token_v1("--xlog-tag=")
        expect(tok.kind).to_equal(CLI_TOKEN_EXTENSION)
        expect(tok.has_value).to_equal(true)
        expect(tok.value).to_equal("")

    it "marks malformed --x forms without consuming anything":
        val bad = ["--x", "--x-key", "--xns", "--xns-", "--xNS-key", "--x1ns-key", "--xns=value"]
        var malformed = 0
        var i = 0
        while i < bad.len():
            val tok = split_cli_extension_token_v1(bad[i])
            if tok.kind == CLI_TOKEN_MALFORMED: malformed = malformed + 1
            i = i + 1
        expect(malformed).to_equal(7)

    it "classifies non-x tokens as exact options or positionals":
        expect(split_cli_extension_token_v1("--backend=llvm").kind).to_equal(CLI_TOKEN_EXACT_OPTION)
        expect(split_cli_extension_token_v1("-v").kind).to_equal(CLI_TOKEN_POSITIONAL)
        expect(split_cli_extension_token_v1("build").kind).to_equal(CLI_TOKEN_POSITIONAL)
        expect(split_cli_extension_token_v1("--").kind).to_equal(CLI_TOKEN_TERMINATOR)

describe "hard -- terminator boundary":
    it "intercepts nothing after the terminator":
        val tokens = ["--xlog-level=debug", "--", "--xlog-level=trace", "--help", "positional"]
        val out = classify_cli_tokens_v1(tokens)
        expect(out.len()).to_equal(5)
        expect(out[0].kind).to_equal(CLI_TOKEN_EXTENSION)
        expect(out[1].kind).to_equal(CLI_TOKEN_TERMINATOR)
        expect(out[2].kind).to_equal(CLI_TOKEN_PROGRAM_ARG)
        expect(out[3].kind).to_equal(CLI_TOKEN_PROGRAM_ARG)
        expect(out[4].kind).to_equal(CLI_TOKEN_PROGRAM_ARG)

    it "a value requires = and never consumes the next argv token":
        val out = classify_cli_tokens_v1(["--xllvm-pass", "gvn"])
        expect(out[0].kind).to_equal(CLI_TOKEN_EXTENSION)
        expect(out[0].has_value).to_equal(false)
        expect(out[1].kind).to_equal(CLI_TOKEN_POSITIONAL)
