# AES inverse cipher (FIPS 197) + AES-CBC (NIST SP 800-38A F.2) regression spec
#
# Guards the fix for
# doc/08_tracking/bug/credential_store_aes_cbc_label_is_actually_ctr_with_deterministic_iv_2026-08-07.md
#
# Before 2026-08-08 `aes_cbc_encrypt`/`aes_cbc_decrypt` were undocumented
# aliases for the CTR functions: no chaining, no padding, and no AES inverse
# cipher existed at all in the typed (`[u8]`) crypto path. This spec pins:
#
#   1. The AES inverse cipher against published FIPS 197 vectors (C.1 AES-128,
#      C.3 AES-256), in BOTH directions. These are the assertions that fail if
#      the inverse S-box, InvShiftRows, or InvMixColumns is wrong — a
#      round-trip-only test would pass under a symmetric bug.
#   2. Real CBC chaining against NIST SP 800-38A Appendix F.2 (F.2.1 AES-128,
#      F.2.5 AES-256). Because aes_cbc_encrypt always appends a PKCS#7 block,
#      the F.2 vectors are compared against the leading 64 bytes.
#   3. PKCS#7 boundary round-trips (0/1/15/16/17/multi-block).
#   4. Fail-closed decryption under a wrong key (nil, not garbage plaintext).
#
# Sources:
#   FIPS 197, Appendix C.1 / C.3
#   NIST SP 800-38A, Appendix F.2

"""
## Purpose and audience
Purpose: Verify AES inverse cipher — FIPS 197 Appendix C known-answer tests.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-LIB-AES-CBC-FIPS197-001 — stable requirement identity for this spec.

use std.spec.*
use std.common.aes.modes.{aes_cbc_encrypt, aes_cbc_decrypt, aes_ctr_encrypt}
use std.common.crypto.aes_gcm.{
    aes128_key_expansion,
    aes256_key_expansion,
    aes128_encrypt_block,
    aes256_encrypt_block,
    aes128_decrypt_block,
    aes256_decrypt_block
}

extern fn rt_bytes_u8_at(arr: [u8], idx: i64) -> i64

# ============================================================================
# Helpers (module-level to avoid the it-block var-mutation footgun)
# ============================================================================

fn _to_u8(arr: list) -> [u8]:
    var out: [u8] = []
    var i = 0
    while i < arr.length():
        out.push((arr[i] & 0xFF).to_u8())
        i = i + 1
    out

fn _from_u8(arr: [u8], n: i64) -> list:
    var out = []
    var i = 0
    while i < n:
        out.append(rt_bytes_u8_at(arr, i) & 0xFF)
        i = i + 1
    out

fn _take(arr: list, n: i64) -> list:
    var out = []
    var i = 0
    while i < n:
        out.append(arr[i])
        i = i + 1
    out

fn _seq(n: i64) -> list:
    var out = []
    var i = 0
    while i < n:
        out.append((i * 7 + 3) & 0xFF)
        i = i + 1
    out

# ============================================================================
# FIPS 197 Appendix C vectors
# ============================================================================

# C.1/C.3 shared plaintext: 00112233445566778899aabbccddeeff
fn _fips_pt() -> list:
    [0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77,
     0x88, 0x99, 0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff]

# C.1 AES-128 key: 000102030405060708090a0b0c0d0e0f
fn _fips_key128() -> list:
    [0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
     0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f]

# C.1 AES-128 ciphertext: 69c4e0d86a7b0430d8cdb78070b4c55a
fn _fips_ct128() -> list:
    [0x69, 0xc4, 0xe0, 0xd8, 0x6a, 0x7b, 0x04, 0x30,
     0xd8, 0xcd, 0xb7, 0x80, 0x70, 0xb4, 0xc5, 0x5a]

# C.3 AES-256 key: 000102...1c1d1e1f
fn _fips_key256() -> list:
    [0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
     0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,
     0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17,
     0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f]

# C.3 AES-256 ciphertext: 8ea2b7ca516745bfeafc49904b496089
fn _fips_ct256() -> list:
    [0x8e, 0xa2, 0xb7, 0xca, 0x51, 0x67, 0x45, 0xbf,
     0xea, 0xfc, 0x49, 0x90, 0x4b, 0x49, 0x60, 0x89]

# ============================================================================
# NIST SP 800-38A Appendix F.2 (CBC) vectors
# ============================================================================

# F.2 IV: 000102030405060708090a0b0c0d0e0f
fn _cbc_iv() -> list:
    [0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
     0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f]

fn _cbc_key128() -> list:
    [0x2b, 0x7e, 0x15, 0x16, 0x28, 0xae, 0xd2, 0xa6,
     0xab, 0xf7, 0x15, 0x88, 0x09, 0xcf, 0x4f, 0x3c]

fn _cbc_key256() -> list:
    [0x60, 0x3d, 0xeb, 0x10, 0x15, 0xca, 0x71, 0xbe,
     0x2b, 0x73, 0xae, 0xf0, 0x85, 0x7d, 0x77, 0x81,
     0x1f, 0x35, 0x2c, 0x07, 0x3b, 0x61, 0x08, 0xd7,
     0x2d, 0x98, 0x10, 0xa3, 0x09, 0x14, 0xdf, 0xf4]

# Standard 4-block SP 800-38A plaintext
fn _cbc_pt() -> list:
    [0x6b, 0xc1, 0xbe, 0xe2, 0x2e, 0x40, 0x9f, 0x96,
     0xe9, 0x3d, 0x7e, 0x11, 0x73, 0x93, 0x17, 0x2a,
     0xae, 0x2d, 0x8a, 0x57, 0x1e, 0x03, 0xac, 0x9c,
     0x9e, 0xb7, 0x6f, 0xac, 0x45, 0xaf, 0x8e, 0x51,
     0x30, 0xc8, 0x1c, 0x46, 0xa3, 0x5c, 0xe4, 0x11,
     0xe5, 0xfb, 0xc1, 0x19, 0x1a, 0x0a, 0x52, 0xef,
     0xf6, 0x9f, 0x24, 0x45, 0xdf, 0x4f, 0x9b, 0x17,
     0xad, 0x2b, 0x41, 0x7b, 0xe6, 0x6c, 0x37, 0x10]

# F.2.1 AES-128-CBC ciphertext (4 blocks)
fn _cbc_ct128() -> list:
    [0x76, 0x49, 0xab, 0xac, 0x81, 0x19, 0xb2, 0x46,
     0xce, 0xe9, 0x8e, 0x9b, 0x12, 0xe9, 0x19, 0x7d,
     0x50, 0x86, 0xcb, 0x9b, 0x50, 0x72, 0x19, 0xee,
     0x95, 0xdb, 0x11, 0x3a, 0x91, 0x76, 0x78, 0xb2,
     0x73, 0xbe, 0xd6, 0xb8, 0xe3, 0xc1, 0x74, 0x3b,
     0x71, 0x16, 0xe6, 0x9e, 0x22, 0x22, 0x95, 0x16,
     0x3f, 0xf1, 0xca, 0xa1, 0x68, 0x1f, 0xac, 0x09,
     0x12, 0x0e, 0xca, 0x30, 0x75, 0x86, 0xe1, 0xa7]

# F.2.5 AES-256-CBC ciphertext (4 blocks)
fn _cbc_ct256() -> list:
    [0xf5, 0x8c, 0x4c, 0x04, 0xd6, 0xe5, 0xf1, 0xba,
     0x77, 0x9e, 0xab, 0xfb, 0x5f, 0x7b, 0xfb, 0xd6,
     0x9c, 0xfc, 0x4e, 0x96, 0x7e, 0xdb, 0x80, 0x8d,
     0x67, 0x9f, 0x77, 0x7b, 0xc6, 0x70, 0x2c, 0x7d,
     0x39, 0xf2, 0x33, 0x69, 0xa9, 0xd9, 0xba, 0xcf,
     0xa5, 0x30, 0xe2, 0x63, 0x04, 0x23, 0x14, 0x61,
     0xb2, 0xeb, 0x05, 0xe2, 0xc3, 0x9b, 0xe9, 0xfc,
     0xda, 0x6c, 0x19, 0x07, 0x8c, 0x6a, 0x9d, 0x1b]

# ============================================================================
# Specs
# ============================================================================

describe "AES inverse cipher — FIPS 197 Appendix C known-answer tests":

    it "C.1 AES-128 encrypt block matches the published ciphertext":
        step("Verify: C.1 AES-128 encrypt block matches the published ciphertext")
        # @req: REQ-LIB-AES-CBC-FIPS197-001
        val sched = aes128_key_expansion(_to_u8(_fips_key128()))
        val ct = aes128_encrypt_block(_to_u8(_fips_pt()), sched)
        expect(_from_u8(ct, 16)).to_equal(_fips_ct128())

    it "C.1 AES-128 decrypt block recovers the published plaintext":
        step("Verify: C.1 AES-128 decrypt block recovers the published plaintext")
        val sched = aes128_key_expansion(_to_u8(_fips_key128()))
        val pt = aes128_decrypt_block(_to_u8(_fips_ct128()), sched)
        expect(_from_u8(pt, 16)).to_equal(_fips_pt())

    it "C.3 AES-256 encrypt block matches the published ciphertext":
        step("Verify: C.3 AES-256 encrypt block matches the published ciphertext")
        val sched = aes256_key_expansion(_to_u8(_fips_key256()))
        val ct = aes256_encrypt_block(_to_u8(_fips_pt()), sched)
        expect(_from_u8(ct, 16)).to_equal(_fips_ct256())

    it "C.3 AES-256 decrypt block recovers the published plaintext":
        step("Verify: C.3 AES-256 decrypt block recovers the published plaintext")
        val sched = aes256_key_expansion(_to_u8(_fips_key256()))
        val pt = aes256_decrypt_block(_to_u8(_fips_ct256()), sched)
        expect(_from_u8(pt, 16)).to_equal(_fips_pt())

describe "AES-CBC — NIST SP 800-38A Appendix F.2 chaining vectors":

    it "F.2.1 AES-128-CBC produces the published ciphertext blocks":
        step("Verify: F.2.1 AES-128-CBC produces the published ciphertext blocks")
        # aes_cbc_encrypt always appends one PKCS#7 block, so the F.2 vector
        # is the leading 64 bytes of an 80-byte result.
        val ct = aes_cbc_encrypt(_cbc_pt(), _cbc_key128(), _cbc_iv())
        expect(ct.length()).to_equal(80)  # oracle: authoritative expected value documented by this spec's contract
        expect(_take(ct, 64)).to_equal(_cbc_ct128())

    it "F.2.5 AES-256-CBC produces the published ciphertext blocks":
        step("Verify: F.2.5 AES-256-CBC produces the published ciphertext blocks")
        val ct = aes_cbc_encrypt(_cbc_pt(), _cbc_key256(), _cbc_iv())
        expect(ct.length()).to_equal(80)  # oracle: authoritative expected value documented by this spec's contract
        expect(_take(ct, 64)).to_equal(_cbc_ct256())

    it "CBC is NOT the same transform as CTR (the aliasing defect)":
        step("Verify: CBC is NOT the same transform as CTR (the aliasing defect)")
        # Regression guard: the old aes_cbc_encrypt simply called
        # aes_ctr_encrypt. Real CBC differs in both length and content.
        val cbc = aes_cbc_encrypt(_cbc_pt(), _cbc_key128(), _cbc_iv())
        val ctr = aes_ctr_encrypt(_cbc_pt(), _cbc_key128(), _cbc_iv())
        expect(ctr.length()).to_equal(64)  # oracle: authoritative expected value documented by this spec's contract
        expect(_take(cbc, 64) == ctr).to_equal(false)

describe "AES-CBC — PKCS#7 padding boundaries and fail-closed decryption":

    it "round-trips an empty message (pads to one full block)":
        step("Verify: round-trips an empty message (pads to one full block)")
        val ct = aes_cbc_encrypt([], _cbc_key256(), _cbc_iv())
        expect(ct.length()).to_equal(16)  # oracle: authoritative expected value documented by this spec's contract
        expect(aes_cbc_decrypt(ct, _cbc_key256(), _cbc_iv()) ?? [1]).to_equal([])

    it "round-trips a 1-byte message":
        step("Verify: round-trips a 1-byte message")
        val pt = _seq(1)
        val ct = aes_cbc_encrypt(pt, _cbc_key256(), _cbc_iv())
        expect(ct.length()).to_equal(16)  # oracle: authoritative expected value documented by this spec's contract
        expect(aes_cbc_decrypt(ct, _cbc_key256(), _cbc_iv()) ?? []).to_equal(pt)

    it "round-trips a 15-byte message (one pad byte)":
        step("Verify: round-trips a 15-byte message (one pad byte)")
        val pt = _seq(15)
        val ct = aes_cbc_encrypt(pt, _cbc_key256(), _cbc_iv())
        expect(ct.length()).to_equal(16)  # oracle: authoritative expected value documented by this spec's contract
        expect(aes_cbc_decrypt(ct, _cbc_key256(), _cbc_iv()) ?? []).to_equal(pt)

    it "round-trips a 16-byte message (adds a whole padding block)":
        step("Verify: round-trips a 16-byte message (adds a whole padding block)")
        val pt = _seq(16)
        val ct = aes_cbc_encrypt(pt, _cbc_key256(), _cbc_iv())
        expect(ct.length()).to_equal(32)  # oracle: authoritative expected value documented by this spec's contract
        expect(aes_cbc_decrypt(ct, _cbc_key256(), _cbc_iv()) ?? []).to_equal(pt)

    it "round-trips a 17-byte message":
        step("Verify: round-trips a 17-byte message")
        val pt = _seq(17)
        val ct = aes_cbc_encrypt(pt, _cbc_key256(), _cbc_iv())
        expect(ct.length()).to_equal(32)  # oracle: authoritative expected value documented by this spec's contract
        expect(aes_cbc_decrypt(ct, _cbc_key256(), _cbc_iv()) ?? []).to_equal(pt)

    it "round-trips a multi-block 100-byte message":
        step("Verify: round-trips a multi-block 100-byte message")
        val pt = _seq(100)
        val ct = aes_cbc_encrypt(pt, _cbc_key256(), _cbc_iv())
        expect(ct.length()).to_equal(112)  # oracle: authoritative expected value documented by this spec's contract
        expect(aes_cbc_decrypt(ct, _cbc_key256(), _cbc_iv()) ?? []).to_equal(pt)

    it "round-trips under AES-128 as well as AES-256":
        step("Verify: round-trips under AES-128 as well as AES-256")
        val pt = _seq(40)
        val ct = aes_cbc_encrypt(pt, _cbc_key128(), _cbc_iv())
        expect(aes_cbc_decrypt(ct, _cbc_key128(), _cbc_iv()) ?? []).to_equal(pt)

    it "returns nil (not garbage) when decrypted under the wrong key":
        step("Verify: returns nil (not garbage) when decrypted under the wrong key")
        val ct = aes_cbc_encrypt(_seq(20), _cbc_key256(), _cbc_iv())
        val wrong = aes_cbc_decrypt(ct, _cbc_key128(), _cbc_iv())
        expect(wrong == nil).to_equal(true)

    it "returns nil for a ciphertext that is not a whole number of blocks":
        step("Verify: returns nil for a ciphertext that is not a whole number of blocks")
        expect(aes_cbc_decrypt(_seq(20), _cbc_key256(), _cbc_iv()) == nil).to_equal(true)

    it "returns nil for an empty ciphertext":
        step("Verify: returns nil for an empty ciphertext")
        expect(aes_cbc_decrypt([], _cbc_key256(), _cbc_iv()) == nil).to_equal(true)

    it "returns [] for an encryption with a wrong-sized IV":
        step("Verify: returns [] for an encryption with a wrong-sized IV")
        expect(aes_cbc_encrypt(_seq(20), _cbc_key256(), _seq(12))).to_equal([])
