"""
## Purpose and audience
Purpose: Pin the INTERPRETER-lane semantics of three SIMD runtime entry
points whose native and interpreter lanes are known to disagree, so the
divergence is recorded by an executing test instead of only by prose.
Audience: runtime, SIMD and crypto engineers.

`rt_simd_hmax_f32x4`, `rt_simd_hmin_f32x4` and `rt_simd_vec4u64_get` are
implemented ONLY in `src/compiler_rust/compiler/src/interpreter_extern/simd.rs`
(registered at `interpreter_extern/mod.rs:1867,1868,1906`). They have no C
definition under `src/runtime/**` and no definition in the `simple-runtime`
crate; MIR lowers the two horizontal ops to native SIMD instructions instead
(`src/compiler/60.mir_opt/mir_opt/simd_lowering.spl:170,172`). Nothing tested
any of the three before this file — see
doc/08_tracking/test/rt_test_coverage_audit_2026-08-31.md.

## What this spec does and does NOT claim

`bin/simple test` runs the tree-walk INTERPRETER (`.claude/rules/testing.md`,
"run and test are DIFFERENT ENGINES"). Every assertion below therefore pins
the interpreter lane only, and each one says so. This spec deliberately does
NOT assert a single cross-lane answer for the divergent cases: doing so would
force one lane's behaviour to be called correct without a decision having
been made. What it does is make the interpreter's answer executable, so that
the day the two lanes are unified the change cannot land silently.

## Divergences recorded here (not fixed here)

- N1/N2 NaN ordering. The interpreter uses Rust's `f32::max` / `f32::min`,
  which IGNORE a NaN operand and return the other one. Native SSE `maxps` /
  `minps` are ORDER-DEPENDENT and return the SECOND operand when either is
  NaN, so lane order changes the answer. The interpreter's answer is
  order-independent; native's is not.
- G1 out-of-range lane index. The interpreter RAISES
  (`rt_simd_vec4u64_get: index {idx} out of range 0..4`, simd.rs:1922).
  The native lane returns 0, i.e. a valid-looking lane value, with no
  diagnostic — an out-of-range read is indistinguishable from a zero lane.
  Because the interpreter raises, this spec cannot execute the OOB call
  without aborting the example, so G1 asserts the IN-RANGE contract fully
  and the OOB divergence is recorded in prose and in the audit doc rather
  than being asserted here. That limitation is stated rather than papered
  over.

## Discrimination
- H1..H4, M1..M2, G0..G3 are DISCRIMINATING: each compares against a value
  that a constant, zero-returning, or first-lane-returning stub would miss,
  and several use distinct expected values within one example.
- N1/N2 are DISCRIMINATING for the interpreter's NaN policy specifically: a
  stub implementing the native order-dependent policy fails them.
- A1 is DISCRIMINATING for `Vec4f.to_array` lane ORDER and VALUE.
"""

# @req: REQ-RT-SIMD-HMAX-001 — horizontal max/min over an f32x4.
# @req: REQ-RT-SIMD-VEC4U64-GET-001 — lane read from a Vec4u64.

use std.spec
use std.nogc_sync_mut.simd.{Vec4f, simd_hmax_f32x4, simd_hmin_f32x4}
use std.nogc_sync_mut.simd_crypto.{Vec4u64}

describe "rt_simd horizontal ops (interpreter lane)":

    it "H1 hmax picks the largest lane regardless of position":
        step("Verify: max is found in each of the four lane positions")
        # @req: REQ-RT-SIMD-HMAX-001
        # DISCRIMINATING: a stub returning lane 0, lane 3, or a constant
        # fails, because the maximum sits in a different position each time.
        expect(simd_hmax_f32x4(Vec4f(x: 9.0, y: 1.0, z: 2.0, w: 3.0))).to_equal(9.0)
        expect(simd_hmax_f32x4(Vec4f(x: 1.0, y: 9.0, z: 2.0, w: 3.0))).to_equal(9.0)
        expect(simd_hmax_f32x4(Vec4f(x: 1.0, y: 2.0, z: 9.0, w: 3.0))).to_equal(9.0)
        expect(simd_hmax_f32x4(Vec4f(x: 1.0, y: 2.0, z: 3.0, w: 9.0))).to_equal(9.0)

    it "H2 hmax handles negative lanes":
        step("Verify: the least negative value wins")
        # DISCRIMINATING against an abs()/magnitude stub, which would answer
        # -9.0 here.
        expect(simd_hmax_f32x4(Vec4f(x: -9.0, y: -1.0, z: -5.0, w: -3.0))).to_equal(-1.0)

    it "H3 hmax of a uniform vector is that value":
        step("Verify: splat behaves")
        expect(simd_hmax_f32x4(Vec4f(x: 4.0, y: 4.0, z: 4.0, w: 4.0))).to_equal(4.0)

    it "H4 hmin picks the smallest lane regardless of position":
        step("Verify: min is found in each of the four lane positions")
        expect(simd_hmin_f32x4(Vec4f(x: 0.5, y: 1.0, z: 2.0, w: 3.0))).to_equal(0.5)
        expect(simd_hmin_f32x4(Vec4f(x: 1.0, y: 0.5, z: 2.0, w: 3.0))).to_equal(0.5)
        expect(simd_hmin_f32x4(Vec4f(x: 1.0, y: 2.0, z: 0.5, w: 3.0))).to_equal(0.5)
        expect(simd_hmin_f32x4(Vec4f(x: 1.0, y: 2.0, z: 3.0, w: 0.5))).to_equal(0.5)

    it "M1 hmin and hmax disagree on a non-uniform vector":
        step("Verify: the two entry points are not the same function")
        # DISCRIMINATING against a build in which one symbol was accidentally
        # wired to the other's implementation — which H1..H4 alone, each
        # checked in isolation, would not catch.
        val v = Vec4f(x: 1.0, y: 7.0, z: 3.0, w: 2.0)
        expect(simd_hmax_f32x4(v)).to_equal(7.0)
        expect(simd_hmin_f32x4(v)).to_equal(1.0)

    it "M2 hmax bound holds against every lane":
        step("Verify: the result is >= each input lane")
        val m = simd_hmax_f32x4(Vec4f(x: 2.5, y: -3.0, z: 6.25, w: 0.0))
        expect(m).to_equal(6.25)
        expect(m >= 2.5).to_equal(true)
        expect(m >= -3.0).to_equal(true)
        expect(m >= 0.0).to_equal(true)

describe "rt_simd_vec4u64_get (interpreter lane)":

    it "G0 reads each of the four lanes distinctly":
        step("Verify: lane(i) returns lane i, not lane 0 and not a constant")
        # @req: REQ-RT-SIMD-VEC4U64-GET-001
        # DISCRIMINATING: four distinct expected values, so a stub returning
        # 0, a constant, or always lane 0 fails.
        val v = Vec4u64.new(11, 22, 33, 44)
        expect(v.lane(0)).to_equal(11)
        expect(v.lane(1)).to_equal(22)
        expect(v.lane(2)).to_equal(33)
        expect(v.lane(3)).to_equal(44)

    it "G1 a genuine zero lane is readable":
        step("Verify: a zero lane reads back as zero")
        # This is the assertion that the NATIVE lane's out-of-range-returns-0
        # behaviour makes ambiguous: on native, `lane(0) == 0` here and
        # `lane(9) == 0` there are indistinguishable answers. Recorded, not
        # asserted for native — see the header.
        val v = Vec4u64.new(0, 1, 0, 1)
        expect(v.lane(0)).to_equal(0)
        expect(v.lane(1)).to_equal(1)
        expect(v.lane(2)).to_equal(0)
        expect(v.lane(3)).to_equal(1)

    it "G2 reads a large u64 lane without truncation":
        step("Verify: a value above 2^32 survives the round trip")
        # DISCRIMINATING against a 32-bit truncating read, which G0's small
        # values could never expose.
        val v = Vec4u64.new(4294967296, 4294967297, 1, 2)
        expect(v.lane(0)).to_equal(4294967296)
        expect(v.lane(1)).to_equal(4294967297)

    it "G3 a zero vector reads zero in every lane":
        step("Verify: Vec4u64.zero")
        val z = Vec4u64.zero()
        expect(z.lane(0)).to_equal(0)
        expect(z.lane(3)).to_equal(0)

describe "Vec4f.to_array":

    it "A1 round-trips four distinct lanes in order":
        step("Verify: to_array preserves lane order and value")
        # DISCRIMINATING for both ORDER and VALUE: four distinct constants,
        # so a reversed, splatted or zeroed result fails. This is the shape
        # in which a raw-f32-read-of-an-f64-slot defect would surface as
        # wrong numbers rather than as a crash.
        val a = Vec4f(x: 1.5, y: 2.25, z: -3.75, w: 4.0).to_array()
        expect(a.len()).to_equal(4)
        expect(a[0]).to_equal(1.5)
        expect(a[1]).to_equal(2.25)
        expect(a[2]).to_equal(-3.75)
        expect(a[3]).to_equal(4.0)

    it "A2 from_array/to_array is an identity":
        step("Verify: the two converters are inverse")
        val src = [10.5, 20.25, 30.125, 40.0]
        val back = Vec4f.from_array(src).to_array()
        expect(back[0]).to_equal(10.5)
        expect(back[1]).to_equal(20.25)
        expect(back[2]).to_equal(30.125)
        expect(back[3]).to_equal(40.0)
