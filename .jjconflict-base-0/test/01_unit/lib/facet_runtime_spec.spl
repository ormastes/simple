# Focused runtime/ABI specs for compiler-emitted dynamic facet operations.

use std.common.string_core.{text_to_bytes}
use std.common.aspect_pack.{
    ApkModuleSourceV1, ApkCatalogEntryV1,
    apk_build_pack_v1, apk_build_catalog_v1, apk_loader_new,
    apk_loader_register_pack, apk_loader_packs_opened,
    apk_loader_modules_decompressed, apk_unload_facet_v1,
    facet_runtime_new, facet_runtime_set_default,
    facet_runtime_register_route_v1, facet_runtime_register_method_v1,
    facet_lookup_loaded, facet_lookup_lazy,
    facet_dispatch_loaded, facet_ref_handle_v1,
    facet_ref_slot_count_v1, facet_ref_generation_v1, facet_ref_release_v1,
    facet_load_error_code, FACET_LOAD_STALE_GENERATION,
    FACET_LOAD_ADVICE_MISMATCH
}
use std.spec.{describe, it, expect}

struct FacetRuntimeFixture:
    loader: i64
    runtime: i64
    facet_key: text

fn facet_runtime_sum_handler(base: i64, args: [i64]) -> i64:
    var result = base
    var i = 0
    while i < args.len():
        result = result + args[i]
        i = i + 1
    result

fn build_facet_runtime_fixture() -> FacetRuntimeFixture:
    val facet_key = "runtime.Item/runtime.Named"
    var modules: [ApkModuleSourceV1] = []
    modules.push(ApkModuleSourceV1(
        module_id: "runtime.named",
        aspect_id: "runtime",
        payload: text_to_bytes("runtime named payload")
    ))
    val pack = apk_build_pack_v1(modules)
    var entries: [ApkCatalogEntryV1] = []
    entries.push(ApkCatalogEntryV1(
        facet_key: facet_key,
        pack_path: "aspect/runtime.apk",
        module_id: "runtime.named"
    ))
    val catalog = apk_build_catalog_v1(entries)
    val loader = apk_loader_new()
    expect(pack.ok).to_equal(true)
    expect(catalog.ok).to_equal(true)
    expect(apk_loader_register_pack(loader, "aspect/runtime.apk", pack.bytes)).to_equal(true)
    val runtime = facet_runtime_new(loader, catalog.bytes)
    expect(facet_runtime_set_default(runtime)).to_equal(true)
    expect(facet_runtime_register_route_v1(runtime, facet_key, 71, 19).is_ok()).to_equal(true)
    expect(facet_runtime_register_method_v1(
        runtime, facet_key, "sum", facet_runtime_sum_handler).is_ok()).to_equal(true)
    FacetRuntimeFixture(loader: loader, runtime: runtime, facet_key: facet_key)

fn acquire_runtime_handle(fixture: FacetRuntimeFixture, base: i64) -> i64:
    val acquired = facet_lookup_lazy(base, fixture.facet_key, -1, 0)
    match acquired:
        case Ok(optional):
            match optional:
                case Some(handle): return handle
                case None: expect(false).to_equal(true)
        case Err(_): expect(false).to_equal(true)
    -1

describe "dynamic facet runtime surface":
    it "keeps resident lookup I/O-free and returns a pinned four-slot handle":
        val fixture = build_facet_runtime_fixture()
        val cold_opens = apk_loader_packs_opened(fixture.loader)
        val cold_decompressed = apk_loader_modules_decompressed(fixture.loader)
        val cold = facet_lookup_loaded(40, fixture.facet_key, -1, 0)
        expect(cold.?).to_equal(false)
        expect(apk_loader_packs_opened(fixture.loader)).to_equal(cold_opens)
        expect(apk_loader_modules_decompressed(fixture.loader)).to_equal(cold_decompressed)

        val lazy_handle = acquire_runtime_handle(fixture, 40)
        expect(facet_ref_slot_count_v1(lazy_handle)).to_equal(4)
        expect(apk_loader_packs_opened(fixture.loader)).to_equal(cold_opens + 1)
        expect(apk_loader_modules_decompressed(fixture.loader)).to_equal(cold_decompressed + 1)

        val warm_opens = apk_loader_packs_opened(fixture.loader)
        val warm_decompressed = apk_loader_modules_decompressed(fixture.loader)
        val resident = facet_lookup_loaded(40, fixture.facet_key, -1, 0)
        expect(resident.?).to_equal(true)
        expect(apk_loader_packs_opened(fixture.loader)).to_equal(warm_opens)
        expect(apk_loader_modules_decompressed(fixture.loader)).to_equal(warm_decompressed)

        val dispatched = facet_dispatch_loaded(lazy_handle, fixture.facet_key + "::sum", [1, 2, 3])
        match dispatched:
            case Ok(value): expect(value).to_equal(46)
            case Err(_): expect(false).to_equal(true)
        expect(facet_ref_release_v1(fixture.runtime, lazy_handle).is_ok()).to_equal(true)
        if val resident_handle = resident:
            expect(facet_ref_release_v1(fixture.runtime, resident_handle).is_ok()).to_equal(true)

    it "rejects stale generations and tampered advice before method dispatch":
        val fixture = build_facet_runtime_fixture()
        val first = acquire_runtime_handle(fixture, 8)
        val generation = facet_ref_generation_v1(first)
        val stale_result = facet_ref_handle_v1(8, 71, generation + 1, 19)
        var stale_handle: i64 = -1
        match stale_result:
            case Ok(handle): stale_handle = handle
            case Err(_): expect(false).to_equal(true)
        val stale = facet_dispatch_loaded(stale_handle, fixture.facet_key + "::sum", [1])
        match stale:
            case Err(error):
                expect(facet_load_error_code(error)).to_equal(FACET_LOAD_STALE_GENERATION)
            case Ok(_): expect(false).to_equal(true)

        val bad_advice_result = facet_ref_handle_v1(8, 71, generation, 20)
        match bad_advice_result:
            case Ok(bad_advice):
                val rejected = facet_dispatch_loaded(
                    bad_advice, fixture.facet_key + "::sum", [1])
                match rejected:
                    case Err(error):
                        expect(facet_load_error_code(error)).to_equal(FACET_LOAD_ADVICE_MISMATCH)
                    case Ok(_): expect(false).to_equal(true)
            case Err(_): expect(false).to_equal(true)

        val live = facet_dispatch_loaded(first, fixture.facet_key + "::sum", [1])
        match live:
            case Ok(value): expect(value).to_equal(9)
            case Err(_): expect(false).to_equal(true)
        val pending = apk_unload_facet_v1(fixture.loader, fixture.facet_key)
        expect(pending.quiescing).to_equal(true)
        val quiescing_dispatch = facet_dispatch_loaded(
            first, fixture.facet_key + "::sum", [1])
        match quiescing_dispatch:
            case Err(error):
                expect(facet_load_error_code(error)).to_equal(FACET_LOAD_STALE_GENERATION)
            case Ok(_): expect(false).to_equal(true)
        expect(facet_ref_release_v1(fixture.runtime, first).is_ok()).to_equal(true)
