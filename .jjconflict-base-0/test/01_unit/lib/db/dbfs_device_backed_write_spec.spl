"""Device-backed DBFS/NVFS create, write and positioned write.

Reproduce spec for doc/08_tracking/bug/nvfs_stack_phantom_functions_called_never_defined_2026-09-01.md
items 1 and 2. Every case here FAILED before that fix:

  * `open_path(.., create_write())` returned FsError::InvalidArg, because
    _open_path_locked pushed a DbFsInode without `content_generation`, so it
    defaulted to 0 and _valid_entry_shape() rejected the namespace snapshot.
  * `write_bytes_handle` returned FsError::InvalidArg for the same reason at
    the six inode-rebuild sites.
  * `pwrite_bytes_handle` did not exist at all — it was called from five
    places and defined nowhere.

Both arena layouts are covered on purpose: base_block 4 is the NVFS layout
(NVFS superblock at LBA 0-1, DBFS backing superblock at 2-3, arena from 4) and
base_block 0 is what the mount-table lease path uses. The original defect hit
both, so a single-layout spec would under-constrain the fix.
"""

use std.fs_driver.mem_block_device.{MemBlockDevice}
use std.db.dbfs_driver.dbfs_driver.{DbFsDriver}
use std.fs_driver.types.{OpenFlags, Path}
use std.spec.{describe, it, expect}

extern fn rt_text_to_bytes(s: text) -> [u8]

fn _open_driver(base: i64, count: i64) -> DbFsDriver?:
    val dev = MemBlockDevice.new(4096u64, 512u32)
    val opened = DbFsDriver.open_on_device(dev, base, count)
    if opened.is_err():
        return nil
    Some(opened.unwrap())

fn spec():
    describe("device-backed DBFS create/write", fn():

        it("creates a file on the NVFS arena layout (base 4)", fn():
            val d_opt = _open_driver(4, 4092)
            expect(d_opt.?).to_equal(true)
            var d = d_opt.unwrap()
            val opened = d.open_path(Path(raw: "/PROBE.TXT"), OpenFlags.create_write())
            # Pre-fix this was Err(FsError::InvalidArg).
            expect(opened.is_ok()).to_equal(true)
        )

        it("creates a file at base 0", fn():
            val d_opt = _open_driver(0, 4096)
            expect(d_opt.?).to_equal(true)
            var d = d_opt.unwrap()
            expect(d.open_path(Path(raw: "/PROBE.TXT"), OpenFlags.create_write()).is_ok()).to_equal(true)
        )

        it("writes whole-file bytes through a created handle", fn():
            val d_opt = _open_driver(4, 4092)
            expect(d_opt.?).to_equal(true)
            var d = d_opt.unwrap()
            val opened = d.open_path(Path(raw: "/PROBE.TXT"), OpenFlags.create_write())
            expect(opened.is_ok()).to_equal(true)
            val h = opened.unwrap()
            # Pre-fix this was Err(FsError::InvalidArg).
            expect(d.write_bytes_handle(h, rt_text_to_bytes("marker-ZZZ9999")).is_ok()).to_equal(true)
        )

        it("supports positioned byte writes (pwrite_bytes_handle)", fn():
            val d_opt = _open_driver(4, 4092)
            expect(d_opt.?).to_equal(true)
            var d = d_opt.unwrap()
            val opened = d.open_path(Path(raw: "/PW.BIN"), OpenFlags.create_write())
            expect(opened.is_ok()).to_equal(true)
            val h = opened.unwrap()
            expect(d.write_bytes_handle(h, rt_text_to_bytes("AAAABBBB")).is_ok()).to_equal(true)
            # Pre-fix pwrite_bytes_handle did not exist: this did not compile.
            val wrote = d.pwrite_bytes_handle(h, 4, rt_text_to_bytes("CCCC"))
            expect(wrote.is_ok()).to_equal(true)
            expect(wrote.unwrap()).to_equal(4)
        )

        it("zero-fills a positioned write past end of file", fn():
            val d_opt = _open_driver(4, 4092)
            expect(d_opt.?).to_equal(true)
            var d = d_opt.unwrap()
            val opened = d.open_path(Path(raw: "/GAP.BIN"), OpenFlags.create_write())
            expect(opened.is_ok()).to_equal(true)
            val h = opened.unwrap()
            val wrote = d.pwrite_bytes_handle(h, 8, rt_text_to_bytes("XY"))
            expect(wrote.is_ok()).to_equal(true)
            expect(wrote.unwrap()).to_equal(2)
        )

        it("rejects a negative positioned write offset", fn():
            val d_opt = _open_driver(4, 4092)
            expect(d_opt.?).to_equal(true)
            var d = d_opt.unwrap()
            val opened = d.open_path(Path(raw: "/NEG.BIN"), OpenFlags.create_write())
            expect(opened.is_ok()).to_equal(true)
            expect(d.pwrite_bytes_handle(opened.unwrap(), -1, rt_text_to_bytes("Z")).is_err()).to_equal(true)
        )
    )
    return ()

fn main():
    spec()
    return ()
