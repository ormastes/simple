# Selector-matching coverage for the browser engine's style resolver.
#
# Union coverage of style_block_resolve.spl against every spec that reaches it
# by import was 87% (276/317). Of the 41 uncovered lines, 36 were reachable
# from the module's two public entry points and are exercised here; the other
# five are unreachable by construction and are argued line-by-line in the
# commit message, never folded silently into a percentage.
#
# @cover src/lib/gc_async_mut/gpu/browser_engine/style_block_resolve.spl
use std.spec.{describe, it, expect}

use std.gc_async_mut.gpu.browser_engine.dom.{BeDomNode, StyleProps}
use std.gc_async_mut.gpu.browser_engine.style_block_resolve.{
    selector_matches, simple_selector_matches}

fn el(tag: text) -> BeDomNode:
    BeDomNode.element_with_id(1, tag)

fn el_attrs(tag: text, attrs: Dict<text, text>) -> BeDomNode:
    BeDomNode(
        node_id: 1,
        tag_name: tag,
        data: "",
        attributes: attrs,
        style: StyleProps.empty(),
        children: [],
        parent_id: -1,
        event_listener_types: [],
        event_listener_actions: [],
        event_listener_capture: [])

fn el_children(tag: text, kids: [BeDomNode]) -> BeDomNode:
    BeDomNode(
        node_id: 1,
        tag_name: tag,
        data: "",
        attributes: {},
        style: StyleProps.empty(),
        children: kids,
        parent_id: -1,
        event_listener_types: [],
        event_listener_actions: [],
        event_listener_capture: [])

describe "style_block_resolve selector entry points":

    it "rejects an empty selector":
        expect(selector_matches("", el("div"), nil, 1, 1)).to_equal(false)

    it "rejects an empty simple selector":
        expect(simple_selector_matches("", el("div"), 1, 1)).to_equal(false)

describe "style_block_resolve child combinator":
    # The `case Some(parent_node)` arm (style_block_resolve.spl line 41) used to
    # be uncoverable here: the interpreter -- the only engine a spec ever runs
    # on -- fell through BOTH arms of `match parent` when `parent` held a bare
    # (non-nil) node, and control dropped into the descendant branch below, which
    # returns true whenever the LAST selector matches the node. So `a > b` was
    # silently answering like `a b`.
    #
    # The cause was NOT a missing Some-wrap at the coercion site: neither engine
    # wraps, and the value in `parent` is the raw node in both. It was the
    # interpreter's `Some(p)` PATTERN refusing to match a non-nil, non-enum
    # value. Aligned to the default (JIT) engine in
    # src/compiler_rust/compiler/src/interpreter_patterns.rs.
    #
    # These three examples are the by-value proof: same node and same parent,
    # `>` and ` ` must disagree. If the `Some` arm ever stops matching again, the
    # first example flips to true and this describe goes red instead of silent.

    it "matches a child combinator only when the parent is the immediate parent":
        expect(selector_matches("div > span", el("span"), el("p"), 1, 1)).to_equal(false)

    it "matches a child combinator when the parent does match":
        expect(selector_matches("div > span", el("span"), el("div"), 1, 1)).to_equal(true)

    it "distinguishes the child combinator from the descendant combinator":
        # Identical node and parent; only the combinator differs. Under the
        # fall-through defect both answered true.
        val span = el("span")
        val p = el("p")
        expect(selector_matches("div > span", span, p, 1, 1)).to_equal(false)
        expect(selector_matches("div span", span, p, 1, 1)).to_equal(true)

    it "rejects when the right-hand side does not match the node":
        # Returns before the `match parent`, so this example is unaffected.
        val div = el("div")
        expect(selector_matches("div > span", div, div, 1, 1)).to_equal(false)

    it "rejects when there is no parent to match against":
        # The `case None` arm is correct on both engines.
        expect(selector_matches("div > span", el("span"), nil, 1, 1)).to_equal(false)

describe "style_block_resolve structural pseudo-classes":

    it "matches :last-child on the final sibling only":
        expect(simple_selector_matches(":last-child", el("div"), 3, 3)).to_equal(true)
        expect(simple_selector_matches(":last-child", el("div"), 2, 3)).to_equal(false)

    it "matches :only-child on a lone child":
        expect(simple_selector_matches(":only-child", el("div"), 1, 1)).to_equal(true)

    it "matches a bare :nth-child with no compound base":
        expect(simple_selector_matches(":nth-child(2)", el("div"), 2, 4)).to_equal(true)
        expect(simple_selector_matches(":nth-child(2)", el("div"), 3, 4)).to_equal(false)

    it "rejects a structural pseudo that is not at the end of the selector":
        # The `pos + len(pseudo) != sel.len()` guards: a trailing character
        # after the pseudo makes the whole selector unmatchable.
        expect(simple_selector_matches("div:emptyx", el("div"), 1, 1)).to_equal(false)
        expect(simple_selector_matches("div:first-childx", el("div"), 1, 1)).to_equal(false)
        expect(simple_selector_matches("div:last-childx", el("div"), 1, 1)).to_equal(false)
        expect(simple_selector_matches("div:only-childx", el("div"), 1, 1)).to_equal(false)

describe "style_block_resolve :empty":

    it "matches an element with no children":
        expect(simple_selector_matches(":empty", el("div"), 1, 1)).to_equal(true)

    it "matches an element whose only child is whitespace text":
        val ws = el_children("div", [BeDomNode.text_node(2, "   ")])
        expect(simple_selector_matches(":empty", ws, 1, 1)).to_equal(true)

    it "rejects an element with an element child":
        val parent = el_children("div", [el("span")])
        expect(simple_selector_matches(":empty", parent, 1, 1)).to_equal(false)

    it "rejects an element with non-blank text":
        val parent = el_children("div", [BeDomNode.text_node(2, "hi")])
        expect(simple_selector_matches(":empty", parent, 1, 1)).to_equal(false)

describe "style_block_resolve :nth-child formulas":

    it "matches the 2n formula on even positions":
        expect(simple_selector_matches(":nth-child(2n)", el("div"), 4, 6)).to_equal(true)
        expect(simple_selector_matches(":nth-child(2n)", el("div"), 3, 6)).to_equal(false)

    it "matches the n+3 formula from the third position on":
        expect(simple_selector_matches(":nth-child(n+3)", el("div"), 4, 6)).to_equal(true)
        expect(simple_selector_matches(":nth-child(n+3)", el("div"), 2, 6)).to_equal(false)

    it "strips interior whitespace out of a formula":
        # `2n + 1` must behave exactly like `2n+1`.
        expect(simple_selector_matches(":nth-child(2n + 1)", el("div"), 3, 6)).to_equal(true)

describe "style_block_resolve :where compound":

    it "matches a tag compounded with :where":
        val divc = el_attrs("div", {"class": "hero"})
        expect(simple_selector_matches("div:where(.hero)", divc, 1, 1)).to_equal(true)
        expect(simple_selector_matches("div:where(.other)", divc, 1, 1)).to_equal(false)

describe "style_block_resolve attribute selectors":

    it "rejects an attribute selector with no closing bracket":
        expect(simple_selector_matches("div[foo", el("div"), 1, 1)).to_equal(false)

    it "rejects :root on a non-html element and accepts it on html":
        val html = el_attrs("html", {"lang": "en-US"})
        expect(simple_selector_matches(":root[lang]", el("div"), 1, 1)).to_equal(false)
        expect(simple_selector_matches(":root[lang]", html, 1, 1)).to_equal(true)

    it "rejects when the compound base before the bracket does not match":
        val html = el_attrs("html", {"lang": "en-US"})
        expect(simple_selector_matches("span[lang]", html, 1, 1)).to_equal(false)

    it "rejects an empty attribute body":
        expect(simple_selector_matches("div[]", el("div"), 1, 1)).to_equal(false)

    it "rejects a valued attribute selector when the attribute is absent":
        expect(simple_selector_matches("div[data-x=y]", el("div"), 1, 1)).to_equal(false)

describe "style_block_resolve attribute operators":

    it "applies the i flag to a prefix match":
        val a = el_attrs("a", {"href": "HTTP://Example.test/Docs"})
        expect(simple_selector_matches("a[href^=\"http\" i]", a, 1, 1)).to_equal(true)
        expect(simple_selector_matches("a[href^=\"ftp\" i]", a, 1, 1)).to_equal(false)

    it "stays case-sensitive without the i flag":
        val a = el_attrs("a", {"href": "HTTP://Example.test/Docs"})
        expect(simple_selector_matches("a[href^=\"HTTP\"]", a, 1, 1)).to_equal(true)
        expect(simple_selector_matches("a[href^=\"http\"]", a, 1, 1)).to_equal(false)

    it "matches the hyphen-prefix operator on a language subtag":
        val html = el_attrs("html", {"lang": "en-US"})
        expect(simple_selector_matches("html[lang|=\"en\"]", html, 1, 1)).to_equal(true)
        expect(simple_selector_matches("html[lang|=\"en-US\"]", html, 1, 1)).to_equal(true)
        expect(simple_selector_matches("html[lang|=\"fr\"]", html, 1, 1)).to_equal(false)

describe "style_block_resolve functional selector lists":

    it "rejects :is() whose parenthesis is never closed":
        expect(simple_selector_matches(":is(div", el("div"), 1, 1)).to_equal(false)

    it "rejects :not() whose parenthesis is never closed":
        expect(simple_selector_matches(":not(div", el("div"), 1, 1)).to_equal(false)
