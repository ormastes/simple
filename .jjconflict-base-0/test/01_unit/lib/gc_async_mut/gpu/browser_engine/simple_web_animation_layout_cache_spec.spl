"""Retained web animation layout classification stays exact and O(1) to query."""

use std.spec.{describe, it, expect}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_render_html_draw_ir_result_at_time,
    simple_web_layout_animation_needs_layout
}

fn animated(property: text) -> text:
    "<style>" +
    "@keyframes motion { from { " + property + ": 0px; } " +
    "to { " + property + ": 12px; } } " +
    "div { width: 20px; height: 12px; background-color: #336699; " +
    "animation-name: motion; animation-duration: 1000ms; }" +
    "</style><div></div>"

describe "retained web animation layout classification":
    it "caches a layout requirement for layout-affecting keyframes":
        val result = simple_web_layout_render_html_draw_ir_result_at_time(
            animated("left"), 64, 48, 500
        )
        expect(result.animation_layout_required).to_be(true)
        expect(simple_web_layout_animation_needs_layout(result)).to_be(true)

    it "keeps paint-only keyframes on the retained paint path":
        val result = simple_web_layout_render_html_draw_ir_result_at_time(
            animated("opacity"), 64, 48, 500
        )
        expect(result.animation_layout_required).to_be(false)
        expect(simple_web_layout_animation_needs_layout(result)).to_be(false)

