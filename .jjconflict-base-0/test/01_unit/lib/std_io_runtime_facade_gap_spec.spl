# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# std_io_runtime_facade_gap_spec
#
# `src/lib/io_runtime.spl` shadows `nogc_sync_mut/io_runtime.spl` (`std.io_runtime`
# resolves to the direct facade file first). The facade re-exports an explicit
# brace-list, and it was missing 5 symbols the shadowed module exports:
# is_char_device, platform_name, cli_arg_count, cli_arg_at, thread_sleep.
# Pinned here so a future facade edit cannot silently drop them again.

use std.spec.step

use std.spec
use std.spec.step
use std.io_runtime.{is_char_device, platform_name, cli_arg_count, thread_sleep}


describe "std.io_runtime facade — previously-missing symbols":
    # @manual scenario evidence

    it "exposes platform_name":
        # @req REQ-SSPEC-UNIT
        step("exposes platform_name")
        val p = platform_name()
        expect(p.len() > 0).to_be_true()

    it "exposes is_char_device":
        # @req REQ-SSPEC-UNIT
        step("exposes is_char_device")
        val r = is_char_device("/dev/null")
        expect(r).to_equal(true)

    it "exposes cli_arg_count":
        # @req REQ-SSPEC-UNIT
        step("exposes cli_arg_count")
        val n = cli_arg_count()
        expect(n >= 0).to_be_true()

    it "exposes thread_sleep (callable, near-zero duration)":
        # @req REQ-SSPEC-UNIT
        step("exposes thread_sleep (callable, near-zero duration)")
        thread_sleep(0)
        expect(true).to_be_true()
