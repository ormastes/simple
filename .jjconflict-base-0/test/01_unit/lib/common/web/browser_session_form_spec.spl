use std.spec.*

use std.gc_async_mut.gpu.browser_engine.html_tree_builder.{
    html_tree_builder_build
}
use std.gc_async_mut.web.browser_session_form.{
    browser_form_encode, browser_form_encode_textarea_value,
    browser_form_submission
}

describe "BrowserSession form defaults":

    it "encodes UTF-8 successful controls and submitter overrides":
        val dom = html_tree_builder_build(
            "<html><body><form id='search' action='/ignored' method='post'><input name='q' value='Ada 한'><input name='off' type='checkbox'><input name='on' type='checkbox' checked value='yes'><textarea name='note'>A&amp;B</textarea><select name='kind'><option value='a'>A</option><option value='b' selected>B</option></select><button id='go' name='submit' value='Go' formaction='/find' formmethod='get'>Find</button></form></body></html>"
        )

        expect(browser_form_encode("Ada 한")).to_equal("Ada+%ED%95%9C")
        val submission = browser_form_submission(
            dom, "search", "go", "https://example.test/start"
        )
        expect(submission.error).to_equal("")
        expect(submission.method).to_equal("GET")
        expect(submission.url).to_equal(
            "https://example.test/find?q=Ada+%ED%95%9C&on=yes&note=A%26B&kind=b&submit=Go"
        )

    it "fails closed on unsupported form encoding":
        val dom = html_tree_builder_build(
            "<html><body><form id='upload' method='post' enctype='multipart/form-data'><button id='go'>Go</button></form></body></html>"
        )
        val submission = browser_form_submission(
            dom, "upload", "go", "https://example.test/start"
        )
        expect(submission.error).to_contain("unsupported form encoding")

    it "normalizes every textarea newline spelling before UTF-8 encoding":
        expect(browser_form_encode_textarea_value(
            "LF\nCR\rCRLF\r\n한"
        )).to_equal(
            "LF%0D%0ACR%0D%0ACRLF%0D%0A%ED%95%9C"
        )
