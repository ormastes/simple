use std.spec.*
use std.common.web.browser_renderer_protocol.{
    BrowserRendererMessage,
    browser_renderer_decoder_feed,
    browser_renderer_decoder_new,
    browser_renderer_frame_reuse_decode,
    browser_renderer_frame_reuse_encode
}

fn reuse_message(payload: text) -> BrowserRendererMessage:
    BrowserRendererMessage(
        kind: "frame-reuse", generation: 7, request_id: 12,
        payload: payload)

describe "browser renderer revision-only frame reuse protocol":
    it "round trips without a DrawIR or image payload":
        val encoded = browser_renderer_frame_reuse_encode(
            7, 12, 11, 42, -1)
        expect(encoded.ok).to_equal(true)
        expect(encoded.kind).to_equal("frame-reuse")
        expect(encoded.payload).to_equal("SBRR1\t11\t42\t-1")
        expect(encoded.payload.contains("SBRF")).to_equal(false)
        expect(encoded.payload.len()).to_be_less_than(64)

        val envelope = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), encoded.wire)
        expect(envelope.status).to_equal("message")
        expect(envelope.message.kind).to_equal("frame-reuse")

        val decoded = browser_renderer_frame_reuse_decode(
            envelope.message)
        expect(decoded.ok).to_equal(true)
        expect(decoded.reply_to_request_id).to_equal(11)
        expect(decoded.composition_revision).to_equal(42)
        expect(decoded.next_animation_ms).to_equal(-1)

    it "rejects noncanonical, stale-shape, and invalid revision receipts":
        expect(browser_renderer_frame_reuse_decode(
            reuse_message("SBRR1\t11\t042\t-1")).ok).to_equal(false)
        expect(browser_renderer_frame_reuse_decode(
            reuse_message("SBRR1\t11\t-1\t-1")).ok).to_equal(false)
        expect(browser_renderer_frame_reuse_decode(
            reuse_message("SBRR1\t11\t42")).ok).to_equal(false)
        expect(browser_renderer_frame_reuse_encode(
            7, 12, 11, -1, -1).ok).to_equal(false)
