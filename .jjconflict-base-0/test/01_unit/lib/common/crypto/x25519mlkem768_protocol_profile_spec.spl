use lib.common.crypto.x25519_mlkem768.protocol_profile.{
    X25519MlKem768ProtocolProfile, X25519MlKem768ProtocolPolicy,
    X25519_MLKEM768_TLS_GROUP_NAME, X25519_MLKEM768_SSH_KEX_NAME,
    X25519_MLKEM768_CLIENT_ORDER, X25519_MLKEM768_SERVER_ORDER,
    X25519_MLKEM768_SECRET_ORDER,
    x25519_mlkem768_tls13_protocol_profile,
    x25519_mlkem768_ssh2_protocol_profile,
    x25519_mlkem768_validate_protocol_profile,
    x25519_mlkem768_validate_protocol_policy,
    x25519_mlkem768_validate_protocol_admission}

fn strict_policy() -> X25519MlKem768ProtocolPolicy:
    X25519MlKem768ProtocolPolicy(
        require_hybrid: true,
        authentication_enabled: true,
        aead_enabled: true,
        allow_classical_retry_after_hybrid_failure: false)

fn expect_profile_error(profile: X25519MlKem768ProtocolProfile,
        field: text):
    match x25519_mlkem768_validate_protocol_profile(profile):
        case Ok(_): fail("invalid profile was admitted")
        case Err(reason): expect(reason).to_contain(field)

describe "pinned X25519MLKEM768 TLS and SSH protocol profile":
    it "pins exact TLS and SSH names sizes orders and combiners":
        val tls = x25519_mlkem768_tls13_protocol_profile()
        expect(tls.protocol_version).to_equal("TLS1.3")
        expect(tls.specification_revision).to_equal("draft-ietf-tls-ecdhe-mlkem-05")
        expect(tls.algorithm_name).to_equal(X25519_MLKEM768_TLS_GROUP_NAME)
        expect(tls.named_group).to_equal(0x11EC)
        expect(tls.client_share_bytes).to_equal(1216)
        expect(tls.server_share_bytes).to_equal(1120)
        expect(tls.client_component_order).to_equal(X25519_MLKEM768_CLIENT_ORDER)
        expect(tls.server_component_order).to_equal(X25519_MLKEM768_SERVER_ORDER)
        expect(tls.secret_component_order).to_equal(X25519_MLKEM768_SECRET_ORDER)
        expect(tls.combiner).to_equal("tls13-key-schedule-input")
        expect(tls.combined_secret_bytes).to_equal(64)

        val ssh = x25519_mlkem768_ssh2_protocol_profile()
        expect(ssh.protocol_version).to_equal("SSH-2.0")
        expect(ssh.specification_revision).to_equal("openssh-9.9-mlkem768x25519-v1")
        expect(ssh.algorithm_name).to_equal(X25519_MLKEM768_SSH_KEX_NAME)
        expect(ssh.named_group).to_equal(-1)
        expect(ssh.client_share_bytes).to_equal(1216)
        expect(ssh.server_share_bytes).to_equal(1120)
        expect(ssh.client_component_order).to_equal(X25519_MLKEM768_CLIENT_ORDER)
        expect(ssh.server_component_order).to_equal(X25519_MLKEM768_SERVER_ORDER)
        expect(ssh.secret_component_order).to_equal(X25519_MLKEM768_SECRET_ORDER)
        expect(ssh.combiner).to_equal("sha256")
        expect(ssh.combined_secret_bytes).to_equal(32)

    it "accepts only exact pinned profiles with strict policy":
        val tls = x25519_mlkem768_tls13_protocol_profile()
        val ssh = x25519_mlkem768_ssh2_protocol_profile()
        expect(x25519_mlkem768_validate_protocol_profile(tls) ?? false).to_be(true)
        expect(x25519_mlkem768_validate_protocol_profile(ssh) ?? false).to_be(true)
        expect(x25519_mlkem768_validate_protocol_policy(strict_policy()) ?? false).to_be(true)
        expect(x25519_mlkem768_validate_protocol_admission(
            tls, strict_policy(), 1216, 1120) ?? false).to_be(true)

    it "rejects wrong version name group length order and combiner":
        val base = x25519_mlkem768_tls13_protocol_profile()
        expect_profile_error(X25519MlKem768ProtocolProfile(
            ..base, protocol_version: "draft-obsolete"), "protocol version")
        expect_profile_error(X25519MlKem768ProtocolProfile(
            ..base, specification_revision: "draft-ietf-tls-ecdhe-mlkem-03"),
            "specification revision")
        expect_profile_error(X25519MlKem768ProtocolProfile(
            ..base, algorithm_name: "X25519Kyber768Draft00"), "algorithm name")
        expect_profile_error(X25519MlKem768ProtocolProfile(
            ..base, named_group: 0x6399), "named group")
        expect_profile_error(X25519MlKem768ProtocolProfile(
            ..base, client_share_bytes: 1215), "client share length")
        expect_profile_error(X25519MlKem768ProtocolProfile(
            ..base, server_share_bytes: 1119), "server share length")
        expect_profile_error(X25519MlKem768ProtocolProfile(
            ..base, client_component_order: "x25519-public||mlkem768-encapsulation-key"),
            "client component order")
        expect_profile_error(X25519MlKem768ProtocolProfile(
            ..base, server_component_order: "x25519-public||mlkem768-ciphertext"),
            "server component order")
        expect_profile_error(X25519MlKem768ProtocolProfile(
            ..base, secret_component_order: "x25519-shared-secret||mlkem768-shared-secret"),
            "secret component order")
        expect_profile_error(X25519MlKem768ProtocolProfile(
            ..base, combiner: "sha256"), "combiner")

    it "fails closed without authentication AEAD or hybrid continuity":
        val no_hybrid = X25519MlKem768ProtocolPolicy(
            ..strict_policy(), require_hybrid: false)
        val no_auth = X25519MlKem768ProtocolPolicy(
            ..strict_policy(), authentication_enabled: false)
        val no_aead = X25519MlKem768ProtocolPolicy(
            ..strict_policy(), aead_enabled: false)
        val downgrade = X25519MlKem768ProtocolPolicy(
            ..strict_policy(), allow_classical_retry_after_hybrid_failure: true)
        match x25519_mlkem768_validate_protocol_policy(no_hybrid):
            case Ok(_): fail("optional hybrid was admitted")
            case Err(reason): expect(reason).to_contain("require")
        match x25519_mlkem768_validate_protocol_policy(no_auth):
            case Ok(_): fail("unauthenticated KEX was admitted")
            case Err(reason): expect(reason).to_contain("authentication")
        match x25519_mlkem768_validate_protocol_policy(no_aead):
            case Ok(_): fail("KEX without AEAD was admitted")
            case Err(reason): expect(reason).to_contain("authenticated cipher")
        match x25519_mlkem768_validate_protocol_policy(downgrade):
            case Ok(_): fail("classical downgrade was admitted")
            case Err(reason): expect(reason).to_contain("classical-only")

    it "rejects observed wire lengths before protocol use":
        val profile = x25519_mlkem768_ssh2_protocol_profile()
        match x25519_mlkem768_validate_protocol_admission(
                profile, strict_policy(), 1215, 1120):
            case Ok(_): fail("short client share was admitted")
            case Err(reason): expect(reason).to_contain("client share")
        match x25519_mlkem768_validate_protocol_admission(
                profile, strict_policy(), 1216, 1119):
            case Ok(_): fail("short server share was admitted")
            case Err(reason): expect(reason).to_contain("server share")
