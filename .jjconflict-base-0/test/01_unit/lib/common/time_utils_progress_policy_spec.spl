use std.spec.{describe, it, expect}
use std.common.time_utils.{
    progress_clock_failed, progress_should_lazy_init, progress_elapsed_regressed
}

describe "Pure Simple progress policy authored vectors":
    it "authors both clock-failure outcomes":
        expect(progress_clock_failed(-1)).to_be(true)
        expect(progress_clock_failed(0)).to_be(false)

    it "authors both lazy-initialization outcomes":
        expect(progress_should_lazy_init(false)).to_be(true)
        expect(progress_should_lazy_init(true)).to_be(false)

    it "authors both monotonic-regression outcomes":
        expect(progress_elapsed_regressed(9, 10)).to_be(true)
        expect(progress_elapsed_regressed(10, 10)).to_be(false)
