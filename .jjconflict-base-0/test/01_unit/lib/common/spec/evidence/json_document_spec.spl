"""
# JSON document evidence (E4)

## Purpose and audience

A backend returns a JSON response body. The JSON document adapter turns that
raw text into typed evidence addressed by RFC 6901 JSON Pointers, so a check
like "/response/items/0" resolves to a real node instead of a reviewer
eyeballing pasted JSON. Audience: QA authors capturing API responses and
reviewers who must trust pointer-addressed assertions over raw JSON text.
"""

use std.spec.*

use std.common.spec.evidence.model.{
    check_exact, check_exact_selector, check_full_pattern, check_ignore,
    selector_json_pointer, oracle_spec, EvidenceStatus
}
use std.common.spec.evidence.evidence_comparator.{compare_evidence}
use std.common.spec.evidence.format.json_document.{
    json_to_evidence, json_pointer_escape, json_pointer_resolve, json_pretty_lines
}

describe "JSON document format adapter":
    # @manual: show
    # @capture(protocol_json)
    it "parses a JSON document and verifies it end to end via json pointer selectors":
        step("Capture a JSON response body")
        val raw = "{\"response\": {\"items\": [\"alpha\", \"beta\"], \"count\": 2}, \"trace_id\": \"a1b2c3d4\"}"

        step("Convert the document into canonical evidence")
        val evidence = json_to_evidence(raw, "sample/1")
        expect(evidence.parse_ok).to_equal(true)

        step("Verify selected pointers against a closed oracle using exact, pattern, and ignore checks")
        val spec = oracle_spec(
            "sample/1",
            [
                check_exact_selector(selector_json_pointer("/response/items/0"), "alpha"),
                check_exact_selector(selector_json_pointer("/response/items/1"), "beta"),
                check_full_pattern("/trace_id", "hex:8"),
                check_ignore("/response/count", "not asserted by this scenario")
            ]
        )
        val result = compare_evidence(evidence, spec)
        expect(result.summary).to_equal("3 check(s) passed")

    it "resolves a nested value at its full pointer path":
        step("Capture a deeply nested document")
        val raw = "{\"a\": {\"b\": {\"c\": [1, 2, {\"d\": \"deep\"" + "}" + "]" + "}" + "}" + "}"

        step("Convert to evidence and resolve the deepest pointer")
        val evidence = json_to_evidence(raw, "nested/1")
        expect(evidence.parse_ok).to_equal(true)
        expect(json_pointer_resolve(evidence, "/a/b/c/2/d")).to_equal("deep")

    it "fails malformed JSON as a parse error rather than a partial node set":
        step("Capture a document with a missing closing brace")
        val raw = "{\"a\": 1"

        step("Verify the adapter reports a parse error with no nodes")
        val evidence = json_to_evidence(raw, "broken/1")
        expect(evidence.parse_ok).to_equal(false)
        expect(evidence.nodes.len()).to_equal(0)

        step("Verify comparing malformed evidence fails closed, never a clean pass")
        val spec = oracle_spec("broken/1", [check_ignore("/a", "not asserted")])
        val result = compare_evidence(evidence, spec)
        expect(result.status).to_equal(EvidenceStatus.failed)

    it "keeps both occurrences of a duplicate key instead of overwriting one":
        step("Capture a document whose object repeats a member name")
        val raw = "{\"tag\": \"one\", \"tag\": \"two\"}"

        step("Verify both occurrences survive as separate nodes at the same pointer")
        val evidence = json_to_evidence(raw, "dup/1")
        expect(evidence.parse_ok).to_equal(true)
        var tag_values: [text] = []
        for node in evidence.nodes:
            if node.path == "/tag":
                tag_values.push(node.value)
        expect(tag_values).to_equal(["one", "two"])

    it "round-trips a key containing a slash and a tilde through pointer escaping":
        step("Escape a member name that contains both special characters")
        val escaped = json_pointer_escape("a/b~c")
        expect(escaped).to_equal("a~1b~0c")

        step("Verify the escaped key does not split into extra pointer segments")
        val raw = "{\"a/b~c\": \"value\"}"
        val evidence = json_to_evidence(raw, "escape/1")
        expect(evidence.parse_ok).to_equal(true)
        expect(json_pointer_resolve(evidence, "/" + escaped)).to_equal("value")

    it "distinguishes an empty object and an empty array from an absent field":
        step("Capture a document with an empty object and an empty array")
        val raw = "{\"obj\": {}, \"arr\": []}"

        step("Verify each empty collection still emits a presence node")
        val evidence = json_to_evidence(raw, "empty/1")
        expect(evidence.parse_ok).to_equal(true)
        expect(json_pointer_resolve(evidence, "/obj")).to_equal("{}")
        expect(json_pointer_resolve(evidence, "/arr")).to_equal("[]")

        step("Verify a field that was never present resolves to nothing")
        expect(json_pointer_resolve(evidence, "/missing")).to_equal("")

    it "preserves array order so an ordered comparison is meaningful":
        step("Capture an array of three elements")
        val raw = "{\"seq\": [\"x\", \"y\", \"z\"]}"

        step("Verify each element resolves at its numeric segment in order")
        val evidence = json_to_evidence(raw, "order/1")
        expect(json_pointer_resolve(evidence, "/seq/0")).to_equal("x")
        expect(json_pointer_resolve(evidence, "/seq/1")).to_equal("y")
        expect(json_pointer_resolve(evidence, "/seq/2")).to_equal("z")

    it "projects a pretty-printed rendering for the manual's narrative section":
        step("Pretty-print a small document")
        val lines = json_pretty_lines("{\"a\":1}")

        step("Verify the projection is multi-line, not the canonical one-liner")
        expect(lines.len() > 1).to_equal(true)
