# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec.{describe, it, assert_equal}
use std.common.encoding.utf32.{utf32_to_bytes_le, utf32_to_bytes_be, utf32_from_bytes_le, utf32_from_bytes_be}


describe "utf32 byte encoding guards":
    # @manual scenario evidence
    it "keeps valid little-endian serialization":
        # @req REQ-SSPEC-UNIT
        step("keeps valid little-endian serialization")
        assert_equal(utf32_to_bytes_le([0x41]), [0x41, 0x00, 0x00, 0x00])

    it "keeps valid big-endian serialization":
        # @req REQ-SSPEC-UNIT
        step("keeps valid big-endian serialization")
        assert_equal(utf32_to_bytes_be([0x41]), [0x00, 0x00, 0x00, 0x41])

    it "serializes negative scalars as replacement":
        # @req REQ-SSPEC-UNIT
        step("serializes negative scalars as replacement")
        assert_equal(utf32_from_bytes_le(utf32_to_bytes_le([-1])), [0xFFFD])

    it "serializes above-range scalars as replacement":
        # @req REQ-SSPEC-UNIT
        step("serializes above-range scalars as replacement")
        assert_equal(utf32_from_bytes_be(utf32_to_bytes_be([0x110000])), [0xFFFD])
