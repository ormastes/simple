# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec.{describe, it, assert_equal}
use std.common.encoding.yaml.{yaml_parse, yaml_parse_mapping, yaml_get, yaml_get_list}


# Reproducing spec for
# doc/08_tracking/bug/common_encoding_yaml_broken_cross_submodule_import_2026-07-20.md
# The documented import breakage is fixed, but the public API stayed
# non-functional: yaml node constructors in src/lib/common/yaml/types.spl had
# no return-type annotation, so the tuple tag was erased across the call
# boundary and `node.0` read back as nil -- every mapping parse produced 0
# entries.

describe "std.common.encoding.yaml public API is functional":
    # @manual scenario evidence
    it "tags a block mapping node as a mapping":
        # @req REQ-SSPEC-UNIT
        step("tags a block mapping node as a mapping")
        val node = yaml_parse("name: Alice\nage: 30\n")
        assert_equal(node.0, "mapping")

    it "returns the block mapping entries":
        # @req REQ-SSPEC-UNIT
        step("returns the block mapping entries")
        val entries = yaml_parse_mapping("name: Alice\nage: 30\n")
        assert_equal(entries.length(), 2)

    it "reads scalar values by key":
        # @req REQ-SSPEC-UNIT
        step("reads scalar values by key")
        val entries = yaml_parse_mapping("name: Alice\nage: 30\n")
        assert_equal(yaml_get(entries, "name"), "Alice")
        assert_equal(yaml_get(entries, "age"), "30")

    it "reads sequence values by key":
        # @req REQ-SSPEC-UNIT
        step("reads sequence values by key")
        val entries = yaml_parse_mapping("tags:\n  - a\n  - b\n  - c\n")
        assert_equal(yaml_get_list(entries, "tags").length(), 3)

    it "strips comment lines before parsing":
        # @req REQ-SSPEC-UNIT
        step("strips comment lines before parsing")
        val entries = yaml_parse_mapping("# header\nname: Alice\n")
        assert_equal(yaml_get(entries, "name"), "Alice")
