# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec.{describe, it, expect}
use std.nogc_sync_mut.io.metal_sffi.metal_sffi_quarantine_release_proven


describe "Metal deferred-submission release policy":
    # @manual scenario evidence
    it "retains a command when completion and registry ownership are both unknown":
        # @req REQ-SSPEC-UNIT
        step("retains a command when completion and registry ownership are both unknown")
        expect(metal_sffi_quarantine_release_proven(false, false)).to_equal(false)

    it "releases dependencies after a successful completion wait":
        # @req REQ-SSPEC-UNIT
        step("releases dependencies after a successful completion wait")
        expect(metal_sffi_quarantine_release_proven(true, false)).to_equal(true)

    it "releases dependencies after terminal registry removal proves ownership":
        # @req REQ-SSPEC-UNIT
        step("releases dependencies after terminal registry removal proves ownership")
        expect(metal_sffi_quarantine_release_proven(false, true)).to_equal(true)

    it "keeps release monotonic when both proofs are present":
        # @req REQ-SSPEC-UNIT
        step("keeps release monotonic when both proofs are present")
        expect(metal_sffi_quarantine_release_proven(true, true)).to_equal(true)
