"""
# Async HTTP handler lifecycle specification
"""

use std.spec
use std.concurrent.channel.{channel_new}
use std.http_server.types.{default_response_data}
use std.http_server.async_handler_lifecycle.{
    AsyncHandlerLifecycle, AsyncSubmitResult, AsyncCompletionResult,
    AsyncHandlerCompletionMessage, async_handler_state_label,
    send_async_handler_completion
}

fn accepted_job(result: AsyncSubmitResult) -> i64:
    match result:
        AsyncSubmitResult.Accepted(job_id): job_id
        AsyncSubmitResult.Rejected: -1

describe "bounded async HTTP handler lifecycle":
    it "returns executor completion through the worker inbox":
        var lifecycle = AsyncHandlerLifecycle.create(1)
        val job_id = accepted_job(lifecycle.submit(12, 100, 50))
        expect(lifecycle.mark_pending(job_id)).to_equal(true)

        val inbox = channel_new()
        val response = default_response_data(201, "Created", "async")
        expect(send_async_handler_completion(inbox.id(), job_id, response)).to_equal(true)
        val raw_message = inbox.try_recv()
        expect(raw_message.?).to_equal(true)
        val completion = raw_message as AsyncHandlerCompletionMessage
        expect(completion.job_id).to_equal(job_id)
        expect(lifecycle.complete(completion.job_id, completion.response)).to_equal(true)
        match lifecycle.take_completed(job_id):
            AsyncCompletionResult.Ready(delivered):
                expect(delivered.status).to_equal(201)
                expect(delivered.body).to_equal("async")
            _:
                fail("expected inbox completion to resume the lifecycle")
        inbox.close()

    it "enforces capacity and exactly-once terminal cleanup":
        var lifecycle = AsyncHandlerLifecycle.create(2)

        val completed_id = accepted_job(lifecycle.submit(10, 100, 50))
        val timeout_id = accepted_job(lifecycle.submit(20, 100, 10))
        expect(completed_id).to_be_greater_than(0)
        expect(timeout_id).to_be_greater_than(completed_id)
        expect(accepted_job(lifecycle.submit(30, 100, 50))).to_equal(-1)
        expect(async_handler_state_label(lifecycle.state_of(completed_id))).to_equal("submitted")

        expect(lifecycle.mark_pending(completed_id)).to_equal(true)
        expect(async_handler_state_label(lifecycle.state_of(completed_id))).to_equal("pending")
        val response = default_response_data(200, "OK", "rendered")
        expect(lifecycle.complete(completed_id, response)).to_equal(true)
        expect(lifecycle.complete(completed_id, response)).to_equal(false)
        expect(async_handler_state_label(lifecycle.state_of(completed_id))).to_equal("completed")

        expect(lifecycle.expire(110)).to_equal(1)
        expect(lifecycle.expire(110)).to_equal(0)
        expect(async_handler_state_label(lifecycle.state_of(timeout_id))).to_equal("timedout")
        expect(lifecycle.complete(timeout_id, response)).to_equal(false)

        match lifecycle.take_completed(completed_id):
            AsyncCompletionResult.Ready(delivered):
                expect(delivered.status).to_equal(200)
                expect(delivered.body).to_equal("rendered")
            _:
                fail("expected completed response delivery")
        match lifecycle.take_completed(completed_id):
            AsyncCompletionResult.Gone: expect(lifecycle.retained_count()).to_equal(1)
            _:
                fail("expected completed job to be gone after delivery")
        match lifecycle.take_completed(timeout_id):
            AsyncCompletionResult.Gone: expect(lifecycle.retained_count()).to_equal(0)
            _:
                fail("expected timed-out job to be reclaimed")

        val cancelled_id = accepted_job(lifecycle.submit(30, 120, 50))
        expect(lifecycle.cancel_connection(30)).to_equal(1)
        expect(lifecycle.cancel_connection(30)).to_equal(0)
        expect(async_handler_state_label(lifecycle.state_of(cancelled_id))).to_equal("cancelled")
        expect(lifecycle.reclaim_terminal(cancelled_id)).to_equal(true)
        expect(lifecycle.reclaim_terminal(cancelled_id)).to_equal(false)

        val drain_id = accepted_job(lifecycle.submit(40, 120, 50))
        expect(drain_id).to_be_greater_than(cancelled_id)
        expect(lifecycle.begin_drain()).to_equal(1)
        expect(async_handler_state_label(lifecycle.state_of(drain_id))).to_equal("submitted")
        expect(accepted_job(lifecycle.submit(50, 120, 50))).to_equal(-1)
        expect(lifecycle.mark_pending(drain_id)).to_equal(true)
        expect(lifecycle.complete(drain_id, response)).to_equal(true)
        match lifecycle.take_completed(drain_id):
            AsyncCompletionResult.Ready(delivered):
                expect(delivered.status).to_equal(200)
            _:
                fail("expected accepted work to finish during graceful drain")
        expect(lifecycle.cleanup_terminal()).to_equal(0)
        expect(lifecycle.retained_count()).to_equal(0)

    it "cancels accepted work only for forced shutdown":
        var lifecycle = AsyncHandlerLifecycle.create(1)
        val job_id = accepted_job(lifecycle.submit(60, 200, 50))
        expect(lifecycle.mark_pending(job_id)).to_equal(true)
        expect(lifecycle.cancel_all()).to_equal(1)
        expect(async_handler_state_label(lifecycle.state_of(job_id))).to_equal("cancelled")
        expect(lifecycle.cleanup_terminal()).to_equal(1)
        expect(lifecycle.retained_count()).to_equal(0)

    it "cancels one multiplexed job without cancelling its sibling":
        var lifecycle = AsyncHandlerLifecycle.create(2)
        val first = accepted_job(lifecycle.submit(70, 300, 50))
        val sibling = accepted_job(lifecycle.submit(70, 300, 50))
        expect(lifecycle.cancel(first)).to_equal(true)
        expect(async_handler_state_label(lifecycle.state_of(first))).to_equal("cancelled")
        expect(async_handler_state_label(lifecycle.state_of(sibling))).to_equal("submitted")
        expect(lifecycle.reclaim_terminal(first)).to_equal(true)
        expect(lifecycle.mark_pending(sibling)).to_equal(true)
