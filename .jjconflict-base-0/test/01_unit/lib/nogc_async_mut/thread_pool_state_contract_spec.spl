extern fn rt_file_read_text(path: text) -> text

fn pool_state_source() -> text:
    rt_file_read_text("src/lib/nogc_async_mut/thread_pool_state.spl") ?? ""

describe "PoolStateV1 scalar ownership contract":
    it "owns bounded state and scalar task receipts without global registries":
        val src = pool_state_source()
        expect(src.contains("class PoolStateV1")).to_equal(true)
        expect(src.contains("class PoolTaskI64V1")).to_equal(true)
        expect(src.contains("me try_submit_i64(entry: fn(i64) -> i64, input: i64)")).to_equal(true)
        expect(src.contains("rt_pool_state_try_submit_i64_v1")).to_equal(true)
        expect(src.contains("GLOBAL_")).to_equal(false)

    it "requires join before release and caches a zero-capable scalar result":
        val src = pool_state_source()
        expect(src.contains("if not self.joined:\n            return false")).to_equal(true)
        expect(src.contains("self.cached_result = result")).to_equal(true)
        expect(src.contains("PoolJoinI64V1(valid: true, value: result)")).to_equal(true)

    it "keeps full closed invalid and stale states explicit":
        val src = pool_state_source()
        expect(src.contains("val POOL_SUBMIT_FULL_V1: i64 = -1")).to_equal(true)
        expect(src.contains("val POOL_SUBMIT_CLOSED_V1: i64 = -2")).to_equal(true)
        expect(src.contains("val POOL_SUBMIT_INVALID_V1: i64 = -3")).to_equal(true)
        expect(src.contains("POOL_TASK_INVALID_V1")).to_equal(true)
