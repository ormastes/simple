"""Scalar-only pgwire limit projection and ownership contract."""

use std.spec
use std.database.postgres_mimic.linux_limits.{PgWireLinuxLimits}
use std.database.postgres_mimic.scalar_limits.{
    pgwire_max_sessions_snapshot, pgwire_max_sessions
}

fn limits(max_sessions: i64) -> PgWireLinuxLimits:
    PgWireLinuxLimits(max_sessions: max_sessions, read_chunk: 16384,
        max_frame: 1024 * 1024, max_parameters: 64,
        max_buffer: 2 * 1024 * 1024, max_response: 1024 * 1024,
        read_timeout_ms: 15000, write_timeout_ms: 15000)

describe "Postgres mimic scalar limit owner" :
    it "copies a bounded max-session scalar and does not retain the source aggregate":
        var source = limits(17)
        val snapshot = pgwire_max_sessions_snapshot(source)
        source.max_sessions = 99
        expect(pgwire_max_sessions(snapshot)).to_equal(17)

    it "normalizes a non-positive admission bound to one":
        val snapshot = pgwire_max_sessions_snapshot(limits(0))
        expect(pgwire_max_sessions(snapshot)).to_equal(1)

    it "publishes only a scalar value to a copied worker view":
        val snapshot = pgwire_max_sessions_snapshot(limits(23))
        val worker_copy = snapshot
        expect(pgwire_max_sessions(worker_copy)).to_equal(23)
