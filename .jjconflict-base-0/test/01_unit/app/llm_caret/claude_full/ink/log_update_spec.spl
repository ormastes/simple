# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md






use std.spec.step

use std.spec.*
use app.llm_caret.claude_full.ink.log_update.{LogUpdate, LogFrame, LogPoint, LogDiffOp, VirtualScreen, logFrame, diffKinds, stdoutText, joinTrimmedLines}
use app.llm_caret.claude_full.ink.screen.{stylePoolNew}

fn nonTty() -> LogUpdate:
    LogUpdate.new(false, stylePoolNew())

fn main() -> ():
    describe("ink VirtualScreen", fn() -> ():
        it("starts at the supplied origin with an empty diff", fn() -> ():
                    # @req REQ-SSPEC-UNIT
                # @req REQ-SSPEC-UNIT
            val s = VirtualScreen.new(LogPoint.new(3, 7), 80)
            expect(s.cursor.x).to_equal(3)
            expect(s.cursor.y).to_equal(7)
            expect(s.diff.len()).to_equal(0)
        )

        it("appends patches and advances the cursor by the declared delta", fn() -> ():
            var s = VirtualScreen.new(LogPoint.new(0, 0), 80)
            s.txn([LogDiffOp.stdout("abc")], 3, 0)
            s.txn([LogDiffOp.carriageReturn(), LogDiffOp.newline()], -3, 1)
            expect(s.diff.len()).to_equal(3)
            expect(s.cursor.x).to_equal(0)
            expect(s.cursor.y).to_equal(1)
            expect(s.diff[0].kind).to_equal("stdout")
            expect(s.diff[1].kind).to_equal("carriageReturn")
        )

        it("does not alias the origin point it was constructed from", fn() -> ():
            var origin = LogPoint.new(1, 1)
            var s = VirtualScreen.new(origin, 80)
            s.txn([LogDiffOp.stdout("x")], 5, 5)
            expect(origin.x).to_equal(1)
            expect(origin.y).to_equal(1)
        )
    )

    describe("ink LogUpdate", fn() -> ():
        it("renders a non-TTY frame as a single trimmed stdout write", fn() -> ():
            val ops = nonTty().renderFullFrame(logFrame(["a  ", "b"], 80, 10))
            expect(ops.len()).to_equal(1)
            expect(ops[0].kind).to_equal("stdout")
            expect(ops[0].content).to_equal("a\nb")
        )

        it("renders an empty frame as no operations at all", fn() -> ():
            expect(nonTty().renderFullFrame(logFrame([], 80, 10)).len()).to_equal(0)
        )

        it("emits a bare newline for a non-TTY previous-output render", fn() -> ():
            val ops = nonTty().renderPreviousOutput_DEPRECATED(logFrame(["a"], 80, 10))
            expect(ops.len()).to_equal(1)
            expect(ops[0].content).to_equal("\n")
        )

        it("restores a hidden cursor when the frame is done and clears previous output", fn() -> ():
            var lu = LogUpdate.defaultTTY()
            lu.previousOutput = "stale"
            val ops = lu.getRenderOpsForDone(logFrame(["a"], 80, 10).withCursor(0, 1, false))
            expect(ops.len()).to_equal(1)
            expect(ops[0].kind).to_equal("cursorShow")
            expect(lu.previousOutput).to_equal("")
        )

        it("emits nothing extra when the cursor is already visible", fn() -> ():
            expect(LogUpdate.defaultTTY().getRenderOpsForDone(logFrame(["a"], 80, 10)).len()).to_equal(0)
        )

        it("falls back to a full clear+redraw when the viewport width changes", fn() -> ():
            val prev = logFrame(["a"], 80, 10)
            val next = logFrame(["a"], 60, 10)
            val ops = LogUpdate.defaultTTY().render(prev, next, false, false)
            expect(ops[0].kind).to_equal("clearTerminal")
            expect(ops[0].reason).to_equal("resize")
        )

        it("falls back to a full clear+redraw when the viewport shrinks vertically", fn() -> ():
            val ops = LogUpdate.defaultTTY().render(logFrame(["a"], 80, 10), logFrame(["a"], 80, 8), false, false)
            expect(ops[0].kind).to_equal("clearTerminal")
            expect(ops[0].reason).to_equal("resize")
        )

        it("emits a stdout op for a line that actually changed", fn() -> ():
            val prev = logFrame(["hello"], 80, 10)
            val next = logFrame(["world"], 80, 10)
            expect(stdoutText(LogUpdate.defaultTTY().render(prev, next, true, false)).contains("world")).to_equal(true)
        )

        it("emits no stdout text when the frame is unchanged", fn() -> ():
            val frame = logFrame(["hello"], 80, 10)
            expect(stdoutText(LogUpdate.defaultTTY().render(frame, frame, true, false))).to_equal("")
        )

        it("clears the surplus rows when the next frame has fewer lines", fn() -> ():
            val prev = logFrame(["a", "b", "c"], 80, 10)
            val next = logFrame(["a"], 80, 10)
            val kinds = diffKinds(LogUpdate.defaultTTY().render(prev, next, true, false))
            expect(kinds.len() > 0).to_equal(true)
            expect(kinds[0]).to_equal("clear")
        )

        it("prepends a scroll op only when DECSTBM is safe and a delta exists", fn() -> ():
            val prev = logFrame(["a"], 80, 10)
            val next = logFrame(["a"], 80, 10).withScroll(1, 9, 2)
            val withScroll = LogUpdate.defaultTTY().render(prev, next, true, true)
            expect(stdoutText(withScroll).contains("scroll:1:9:2")).to_equal(true)
            val without = LogUpdate.defaultTTY().render(prev, next, true, false)
            expect(stdoutText(without).contains("scroll:")).to_equal(false)
        )

        it("reset clears the retained previous output", fn() -> ():
            var lu = LogUpdate.defaultTTY()
            lu.previousOutput = "stale"
            lu.reset()
            expect(lu.previousOutput).to_equal("")
        )

        it("joins frame lines with newlines after trimming trailing spaces", fn() -> ():
            expect(joinTrimmedLines(["a  ", "  b  ", ""])).to_equal("a\n  b\n")
        )
    )
    # ponytail: explicit unit return - trailing describe() leaks a value into
    # the process exit code, so a 0-failure spec exits 1. Bug: doc/08_tracking/bug/
    # spec_describe_in_main_leaks_exit_code_2026-08-30.md
    return ()
