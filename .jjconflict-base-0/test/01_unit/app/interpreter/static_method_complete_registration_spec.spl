# @req: REQ-APP-INTERPRETER-001

use std.spipe.*
use std.gc_async_immut.{PersistentVec}
use std.nogc_sync_mut.gc.{GcConfig}

struct StaticRegistrationNeighbor:
    value: i64

impl StaticRegistrationNeighbor:
    static fn first() -> StaticRegistrationNeighbor:
        StaticRegistrationNeighbor(value: 1)

    static fn second(value: i64) -> StaticRegistrationNeighbor:
        StaticRegistrationNeighbor(value: value)

    static fn third() -> StaticRegistrationNeighbor:
        StaticRegistrationNeighbor(value: 3)

use std.spec.step

describe "complete static method registration":
    """Every static member remains callable regardless of declaration order,
    parameter shape, or neighboring methods in the same class/impl registry."""

    it "keeps every PersistentVec array constructor callable":
        # @req: REQ-APP-INTERPRETER-001
        step("Verify: keeps every PersistentVec array constructor callable")
        val from_array = PersistentVec.from_array([4, 5, 6])
        val from_of = PersistentVec.of([7, 8])
        expect from_array.len() to_equal 3
        expect from_array.get(1) to_equal 5
        expect from_of.len() to_equal 2
        expect from_of.get(1) to_equal 8

    it "keeps a later GcConfig impl static callable":
        # @req: REQ-APP-INTERPRETER-001
        step("Verify: keeps a later GcConfig impl static callable")
        val config = GcConfig.with_heap_size(20 * 1024)
        expect config.young_size to_equal 4 * 1024
        expect config.old_size to_equal 16 * 1024

    it "keeps adjacent static methods before and after a parameterized member":
        # @req: REQ-APP-INTERPRETER-001
        step("Verify: keeps adjacent static methods before and after a parameterized member")
        expect StaticRegistrationNeighbor.first().value to_equal 1
        expect StaticRegistrationNeighbor.second(2).value to_equal 2
        expect StaticRegistrationNeighbor.third().value to_equal 3
