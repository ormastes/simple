"""
## Purpose and audience
Purpose: Prove that standalone Office Calc CLI.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-APP-OFFICE-001 — stable requirement identity for this spec.

use std.spec.*
use app.office.calc_cli.{parse_calc_cli}
use app.office.sheets.calc_tui.{calc_tui_new, calc_tui_frame, calc_tui_apply_byte}
use app.office.sheets.spreadsheet.{Sheet}
use app.office.sheets.cell.{cell_display_text}
use app.office.sheets.access_controller.{calc_access_controller_with_sheet}
use app.office.sheets.calc_gui_host.{calc_gui_html}

describe "standalone Office Calc CLI":
    it "parses a TUI workbook without requiring the Simple CLI":
        step("Verify: parses a TUI workbook without requiring the Simple CLI")
        # @req: REQ-APP-OFFICE-001
        val parsed = parse_calc_cli(["book.csv", "--tui"])
        match parsed:
            case Ok(options):
                expect(options.path).to_equal("book.csv")
                expect(options.tui).to_be(true)
                expect(options.gui).to_be(false)
                expect(options.frame_once).to_be(false)
                expect(options.access_port).to_equal(0)  # oracle: 0 — named expected value from the requirement
            case Err(message):
                fail(message)

    it "supports a deterministic frame-only SimpleOS launch probe":
        step("Verify: supports a deterministic frame-only SimpleOS launch probe")
        val parsed = parse_calc_cli(["--frame-once"])
        match parsed:
            case Ok(options):
                expect(options.path).to_equal("untitled.csv")
                expect(options.frame_once).to_be(true)
            case Err(message):
                fail(message)

    it "rejects unknown options":
        step("Verify: rejects unknown options")
        val parsed = parse_calc_cli(["--not-real"])
        match parsed:
            case Ok(_): fail("unknown option was accepted")
            case Err(message): expect(message).to_contain("unknown option")

    it "parses validated opt-in UI access for the TUI":
        step("Verify: parses validated opt-in UI access for the TUI")
        val parsed = parse_calc_cli(["book.csv", "--tui", "--ui-access-port", "38123"])
        match parsed:
            case Ok(options): expect(options.access_port).to_equal(38123)  # oracle: 38123 — named expected value from the requirement
            case Err(message): fail(message)

    it "parses the browser GUI with a deterministic default or explicit port":
        step("Verify: parses the browser GUI with a deterministic default or explicit port")
        match parse_calc_cli(["book.csv", "--gui"]):
            case Ok(options):
                expect(options.gui).to_be(true)
                expect(options.tui).to_be(false)
                expect(options.access_port).to_equal(3000)  # oracle: 3000 — named expected value from the requirement
            case Err(message): fail(message)
        match parse_calc_cli(["book.csv", "--gui", "--ui-access-port", "38124"]):
            case Ok(options): expect(options.access_port).to_equal(38124)  # oracle: 38124 — named expected value from the requirement
            case Err(message): fail(message)

    it "renders a nonempty Calc GUI from the shared semantic grid tree":
        step("Verify: renders a nonempty Calc GUI from the shared semantic grid tree")
        var sheet = Sheet.new("gui")
        sheet.set_cell("A1", "48")
        val html = calc_gui_html(calc_access_controller_with_sheet(sheet))
        expect(html).to_contain("Simple Calc")
        expect(html).to_contain("formula_input")
        expect(html).to_contain("sheet_grid")
        expect(html).to_contain("cell_A1")
        expect(html).to_contain("48")

    it "rejects invalid or frame-only UI access ports":
        step("Verify: rejects invalid or frame-only UI access ports")
        match parse_calc_cli(["--tui", "--ui-access-port", "0"]):
            case Ok(_): fail("port zero was accepted")
            case Err(message): expect(message).to_contain("between 1 and 65535")
        match parse_calc_cli(["--frame-once", "--ui-access-port", "38123"]):
            case Ok(_): fail("frame-only access transport was accepted")
            case Err(message): expect(message).to_contain("requires --tui")

    it "renders the fixed 124 by 37 Calc surface":
        step("Verify: renders the fixed 124 by 37 Calc surface")
        val frame = calc_tui_frame(calc_tui_new(Sheet.new("unit")), "unit.csv", false)
        val lines = frame.split("\n")
        expect(lines.len()).to_equal(37)  # oracle: 37 — named expected value from the requirement
        expect(lines[0].len()).to_equal(124)  # oracle: 124 — named expected value from the requirement
        expect(frame).to_contain("Simple Calc")
        expect(frame).to_contain("T")
        expect(frame).to_contain("30")

    it "evaluates multiplication and AVG through real cell commits":
        step("Verify: evaluates multiplication and AVG through real cell commits")
        var state = calc_tui_new(Sheet.new("formula"))
        for byte in [54, 13, 56, 13]:
            state = calc_tui_apply_byte(state, byte)
        # Move back to A1, then across to B1 and commit multiplication.
        state = calc_tui_apply_byte(state, 27)
        state = calc_tui_apply_byte(state, 91)
        state = calc_tui_apply_byte(state, 65)
        state = calc_tui_apply_byte(state, 27)
        state = calc_tui_apply_byte(state, 91)
        state = calc_tui_apply_byte(state, 65)
        state = calc_tui_apply_byte(state, 27)
        state = calc_tui_apply_byte(state, 91)
        state = calc_tui_apply_byte(state, 67)
        for byte in [61, 65, 49, 42, 65, 50, 13]:
            state = calc_tui_apply_byte(state, byte)
        state = calc_tui_apply_byte(state, 27)
        state = calc_tui_apply_byte(state, 91)
        state = calc_tui_apply_byte(state, 65)
        state = calc_tui_apply_byte(state, 27)
        state = calc_tui_apply_byte(state, 91)
        state = calc_tui_apply_byte(state, 67)
        for byte in [61, 65, 86, 71, 40, 65, 49, 58, 65, 50, 41, 13]:
            state = calc_tui_apply_byte(state, byte)
        expect(cell_display_text(state.sheet.get_cell("B1"))).to_equal("48")
        expect(cell_display_text(state.sheet.get_cell("C1"))).to_equal("7")
