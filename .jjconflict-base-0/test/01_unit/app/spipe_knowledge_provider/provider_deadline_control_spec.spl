use std.spec.{describe, it, expect}
use std.common.search.document.{SearchDocument, SearchField, SearchFacet}
use std.common.search.snapshot.{SearchSnapshot}
use std.common.search.query.{SearchQuery}
use std.common.search.analyzer.{AnalyzerIdentity}
use app.spipe_knowledge_provider.lexical.{search_snapshot_lexical, search_snapshot_lexical_controlled, matched_fields_snapshot_lexical_controlled}
use app.spipe_knowledge_provider.query_clock.{FixedQueryClockV1, SteppingQueryClockV1}
use app.spipe_knowledge_provider.durable_records.{lifecycle_records_json}
use app.spipe_knowledge_provider.lifecycle_serialization.{lifecycle_records_json_controlled}
use app.spipe_knowledge_provider.service.{SpipeProviderServiceV1}
use app.spipe_knowledge_provider.state.{SpipeProviderStateV1}
use app.spipe_knowledge_provider.wire_types.{ProviderHostBindingV1}
use app.spipe_knowledge_provider.wire_dispatch.{provider_dispatch_payload_bound_owned_controlled}

fn deadline_snapshot() -> SearchSnapshot:
    SearchSnapshot.of("spks1-" + "0" * 64, "r1",
        AnalyzerIdentity.spipe_v1(), [
            SearchDocument.of("A-2", "r1", [
                SearchField.of("title", "alpha beta", 4000),
                SearchField.of("body", "alpha body", 1000),
            ], [SearchFacet.of("component", "search")]),
            SearchDocument.of("A-1", "r1", [
                SearchField.of("title", "alpha", 4000),
                SearchField.of("body", "beta alpha", 1000),
            ], [SearchFacet.of("component", "search")]),
            SearchDocument.of("A-3", "r1", [
                SearchField.of("body", "alpha gamma", 1000),
            ], [SearchFacet.of("component", "other")]),
        ])

fn initialized_deadline_service() -> SpipeProviderServiceV1:
    var service = SpipeProviderServiceV1.empty()
    service.state = SpipeProviderStateV1.initialized_bound(
        "WS-PROVIDER", "spks1-" + "0" * 64, "sha256:" + "1" * 64, 1,
        "sha256:" + "0" * 64, deadline_snapshot(),
        service.state.capabilities_value, [], false)
    service

fn stats_payload(request_id: text, deadline_ms: i64) -> text:
    "{\"deadline_ms\":" + deadline_ms.to_text() +
        ",\"operation\":\"stats\",\"operation_receipt\":null," +
        "\"payload\":{\"logical_root\":\"sha256:" + "0" * 64 +
        "\"},\"protocol\":{\"major\":1,\"minor\":0}," +
        "\"provider_generation\":\"pg-00000000000000000000000000000001\"," +
        "\"query_receipt\":null,\"request_id\":\"" + request_id +
        "\",\"scope_digest\":\"sha256:" + "1" * 64 +
        "\",\"snapshot\":\"spks1-" + "0" * 64 +
        "\",\"workspace\":\"WS-PROVIDER\"}"

describe "SPipe cooperative request deadline and cancellation control":
    it "preserves lexical ordering when the cooperative clock does not stop":
        val query = SearchQuery.of("alpha", [
            SearchFacet.of("component", "search")], 10, "", false)
        val expected = search_snapshot_lexical(deadline_snapshot(), query, 10)
        val actual = search_snapshot_lexical_controlled(deadline_snapshot(),
            query, 10, "REQ-ORDER", 0, 1000, FixedQueryClockV1.at(1))
        expect(actual).to_equal(expected)

    it "stops inside lexical work on deadline and cancellation":
        val query = SearchQuery.of("alpha", [], 10, "", false)
        val deadline_clock = SteppingQueryClockV1.configured(0, 1, -1, "")
        expect(search_snapshot_lexical_controlled(deadline_snapshot(), query,
            10, "REQ-DEADLINE", 0, 2, deadline_clock)).to_equal(
                Err("deadline_exceeded"))
        val cancel_clock = SteppingQueryClockV1.configured(
            0, 0, 2, "REQ-CANCEL")
        expect(matched_fields_snapshot_lexical_controlled(
            deadline_snapshot(), query, "A-1", "REQ-CANCEL", 0, 1000,
            cancel_clock)).to_equal(Err("cancelled"))

    it "keeps lifecycle bytes exact and stops before serialization completes":
        val canonical = lifecycle_records_json([], [], "WS-PROVIDER",
            "spks1-" + "0" * 64, "sha256:" + "1" * 64, 1,
            "sha256:" + "0" * 64)
        val controlled = lifecycle_records_json_controlled([], [],
            "WS-PROVIDER", "spks1-" + "0" * 64,
            "sha256:" + "1" * 64, 1, "sha256:" + "0" * 64,
            "REQ-SERIALIZE", 0, 1000, FixedQueryClockV1.at(1))
        expect(controlled).to_equal(Ok(canonical))
        val deadline_clock = SteppingQueryClockV1.configured(0, 1, -1, "")
        expect(lifecycle_records_json_controlled([], [], "WS-PROVIDER",
            "spks1-" + "0" * 64, "sha256:" + "1" * 64, 1,
            "sha256:" + "0" * 64, "REQ-SERIALIZE", 0, 1,
            deadline_clock)).to_equal(Err("deadline_exceeded"))

    it "returns exact retryability for deadline and cancellation at dispatch":
        val host = ProviderHostBindingV1.create("WS-PROVIDER",
            "spks1-" + "0" * 64, "sha256:" + "1" * 64).unwrap()
        val deadline_clock = SteppingQueryClockV1.configured(0, 1, -1, "")
        val deadline = provider_dispatch_payload_bound_owned_controlled(
            initialized_deadline_service(), host,
            stats_payload("REQ-WIRE-DEADLINE", 1), deadline_clock)
        expect(deadline.outcome.frame).to_contain(
            "\"code\":\"deadline_exceeded\"")
        expect(deadline.outcome.frame).to_contain("\"retryable\":true")
        expect(deadline.service.candidates.len()).to_equal(0)
        expect(deadline.service.replay.len()).to_equal(0)

        val cancel_clock = SteppingQueryClockV1.configured(
            0, 0, 1, "REQ-WIRE-CANCEL")
        val cancelled = provider_dispatch_payload_bound_owned_controlled(
            initialized_deadline_service(), host,
            stats_payload("REQ-WIRE-CANCEL", 1000), cancel_clock)
        expect(cancelled.outcome.frame).to_contain("\"code\":\"cancelled\"")
        expect(cancelled.outcome.frame).to_contain("\"retryable\":false")
        expect(cancelled.service.candidates.len()).to_equal(0)
        expect(cancelled.service.replay.len()).to_equal(0)
