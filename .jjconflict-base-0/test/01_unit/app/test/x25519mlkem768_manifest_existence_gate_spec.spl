# Existence gate for the two X25519MLKEM768 campaign manifests.
#
# A coverage manifest that lists a path which is not on disk reports coverage it
# does not have.  AC-8 forbids silent exclusion, so this spec goes RED whenever
# a listed path is absent and is not DECLARED BLOCKED in the coverage contract.
#
# @req AC-8

# NOTE ON IMPORTS: this spec deliberately imports only the coverage contract.
# `x25519mlkem768_critical_inventory.spl` cannot be loaded by a spec today —
# it pulls in `x25519mlkem768_coverage_receipt.spl`, which does not parse
# ("Unexpected token: expected expression, found Assign"), so every spec that
# touches it dies at file level.  That is a separate, pre-existing defect.  The
# gate stays runnable regardless because the critical inventory's owner list now
# DELEGATES to the contract's, so gating the contract gates both manifests.

use std.spec.*
use app.test.x25519mlkem768_coverage_contract.{
    X25519_MLKEM768_CRITICAL_SYMBOLIC_PATH,
    x25519_mlkem768_coverage_absent_in,
    x25519_mlkem768_coverage_declared_blocked_paths,
    x25519_mlkem768_coverage_manifest_absent_paths,
    x25519_mlkem768_coverage_manifest_gate_report,
    x25519_mlkem768_coverage_manifest_paths,
    x25519_mlkem768_coverage_owner_paths,
    x25519_mlkem768_coverage_stale_blocked_paths}

# The critical inventory declares exactly the contract's owner paths plus the
# symbolic-spec fixture.  Mirrored here so the gate can score it without loading
# the module.
fn critical_manifest_paths() -> [text]:
    var paths: [text] = []
    for path in x25519_mlkem768_coverage_owner_paths(): paths.push(path)
    paths.push(X25519_MLKEM768_CRITICAL_SYMBOLIC_PATH)
    paths

describe "X25519MLKEM768 campaign manifest existence gate":

    it "should prove the checker can go RED on a path that is not on disk":
        """A phantom path must be reported, otherwise the gate is fail-open and
        every green result below would be meaningless."""
        val phantom = "src/app/test/no_such_manifest_entry_exists.spl"
        val absent = x25519_mlkem768_coverage_absent_in([phantom])
        assert_equal(absent.len(), 1)
        assert_equal(absent[0], phantom)

    it "should not report a path that does exist":
        val absent = x25519_mlkem768_coverage_absent_in(
            ["src/app/test/x25519mlkem768_coverage_contract.spl"])
        assert_equal(absent.len(), 0)

    it "should list every declared coverage-contract path exactly once":
        val paths = x25519_mlkem768_coverage_manifest_paths()
        assert_equal(paths.len(), 37)
        var seen: [text] = []
        for path in paths:
            assert_false(seen.contains(path))
            seen.push(path)

    it "should list every declared critical-inventory path exactly once":
        val paths = critical_manifest_paths()
        assert_equal(paths.len(), 24)
        var seen: [text] = []
        for path in paths:
            assert_false(seen.contains(path))
            seen.push(path)

    it "should find no unexpectedly absent path in the coverage contract":
        val absent = x25519_mlkem768_coverage_manifest_absent_paths()
        print x25519_mlkem768_coverage_manifest_gate_report()
        assert_equal(absent.join(","), "")

    it "should find no unexpectedly absent path in the critical inventory":
        val absent = x25519_mlkem768_coverage_absent_in(critical_manifest_paths())
        print "critical-inventory manifest-existence-gate: absent={absent.len()}"
        assert_equal(absent.join(","), "")

    it "should retire a declared block once the module lands":
        """A block that outlives the gap would keep an owner out of the coverage
        denominator forever, which is the silent exclusion AC-8 forbids."""
        val stale = x25519_mlkem768_coverage_stale_blocked_paths()
        assert_equal(stale.join(","), "")

    it "should keep every declared-blocked path named inside a manifest":
        """A block is an explicit, enumerated exclusion. A path that is blocked
        but no longer listed would be excluded twice over, and invisibly."""
        for path in x25519_mlkem768_coverage_declared_blocked_paths():
            assert_true(x25519_mlkem768_coverage_manifest_paths().contains(path))
