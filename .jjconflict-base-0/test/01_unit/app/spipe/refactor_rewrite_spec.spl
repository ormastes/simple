# Purpose and audience: executable specification evidence for the S1-B
# link-safe move/rename transaction package.
# @req REQ-SPIPE-S1B
# plan: doc/03_plan/infra/spipe/spipe_knowledge_compiler_refined_plan.md (S1-B)

use std.spec.*
use app.spipe.refactor.rewrite.{RewriteEdit, apply_edits_to_text}
use app.spipe.refactor.plan.{RefactorRequest, FileRewrite, build_refactor_plan}

describe "byte-range rewrite":
    """
    Purpose: prove the S1-B rewrite core edits only the declared
    [target_start, target_end) byte range and preserves every other byte,
    including multibyte (non-ASCII) text, byte-identically.
    Audience: engineers extending the move/rename transaction.
    """

    it "rewrites a single link target and preserves surrounding text byte-for-byte":
        # @req REQ-SPIPE-S1B
        step("Rewrite the target substring of one link")
        val content = "see [x](old/path.md) for more"
        val start = content.find("old/path.md")
        val edits = [RewriteEdit(target_start: start, target_end: start + "old/path.md".len(),
            replacement: "new/path.md")]
        val rewritten = apply_edits_to_text(content, edits)
        expect(rewritten.is_ok()).to_equal(true)
        expect(rewritten.unwrap()).to_equal("see [x](new/path.md) for more")

    it "applies multiple non-overlapping edits in one pass, descending offset":
        # @req REQ-SPIPE-S1B
        step("Rewrite two separate link targets in the same document")
        val content = "[a](one.md) and [b](two.md)"
        val one_start = content.find("one.md")
        val two_start = content.find("two.md")
        val edits = [
            RewriteEdit(target_start: one_start, target_end: one_start + "one.md".len(), replacement: "ONE.md"),
            RewriteEdit(target_start: two_start, target_end: two_start + "two.md".len(), replacement: "TWO.md"),
        ]
        val rewritten = apply_edits_to_text(content, edits)
        expect(rewritten.unwrap()).to_equal("[a](ONE.md) and [b](TWO.md)")

    it "round-trips multibyte text before, inside, and after the target byte-identically":
        # @req REQ-SPIPE-S1B
        step("Rewrite a link target surrounded by non-ASCII prose")
        val content = "précis \u{2192} [héading](old.md) \u{2014} end"
        val start = content.find("old.md")
        val edits = [RewriteEdit(target_start: start, target_end: start + "old.md".len(), replacement: "new.md")]
        val rewritten = apply_edits_to_text(content, edits)
        val expected = "précis \u{2192} [héading](new.md) \u{2014} end"
        expect(rewritten.unwrap()).to_equal(expected)

    it "rejects overlapping edits instead of corrupting the file":
        # @req REQ-SPIPE-S1B
        step("Attempt two overlapping edits")
        val content = "0123456789"
        val edits = [
            RewriteEdit(target_start: 2, target_end: 6, replacement: "AA"),
            RewriteEdit(target_start: 4, target_end: 8, replacement: "BB"),
        ]
        val rewritten = apply_edits_to_text(content, edits)
        expect(rewritten.is_err()).to_equal(true)
        expect(rewritten.unwrap_err()).to_equal("overlapping_edits")

    it "rejects an out-of-range edit instead of silently truncating":
        # @req REQ-SPIPE-S1B
        step("Attempt an edit whose range exceeds the content length")
        val content = "short"
        val edits = [RewriteEdit(target_start: 0, target_end: 999, replacement: "x")]
        val rewritten = apply_edits_to_text(content, edits)
        expect(rewritten.is_err()).to_equal(true)
        expect(rewritten.unwrap_err()).to_equal("invalid_edit_range")

describe "refactor plan construction":
    """
    Purpose: prove build_refactor_plan validates a move/rename request and its
    affected-file edit set before any filesystem work happens.
    Audience: engineers wiring S1-A's reverse index into S1-B.
    """

    it "builds a plan for a valid move with well-formed referencing-file edits":
        # @req REQ-SPIPE-S1B
        step("Build a plan moving one file with one referencing edit")
        val request = RefactorRequest(old_path: "doc/old.md", new_path: "doc/new.md")
        val affected = [FileRewrite(path: "doc/index.md", content_len: 20,
            edits: [RewriteEdit(target_start: 5, target_end: 12, replacement: "new.md")])]
        val plan = build_refactor_plan(request, affected)
        expect(plan.is_ok()).to_equal(true)
        expect(plan.unwrap().old_path).to_equal("doc/old.md")
        expect(plan.unwrap().new_path).to_equal("doc/new.md")

    it "rejects a request whose old and new paths are identical":
        # @req REQ-SPIPE-S1B
        step("Build a plan with old_path == new_path")
        val request = RefactorRequest(old_path: "doc/a.md", new_path: "doc/a.md")
        val plan = build_refactor_plan(request, [])
        expect(plan.is_err()).to_equal(true)
        expect(plan.unwrap_err()).to_equal("old_path_equals_new_path")

    it "rejects an affected-file edit set with overlapping ranges":
        # @req REQ-SPIPE-S1B
        step("Build a plan whose referencing file has overlapping edits")
        val request = RefactorRequest(old_path: "doc/old.md", new_path: "doc/new.md")
        val affected = [FileRewrite(path: "doc/index.md", content_len: 20, edits: [
            RewriteEdit(target_start: 2, target_end: 8, replacement: "x"),
            RewriteEdit(target_start: 5, target_end: 10, replacement: "y"),
        ])]
        val plan = build_refactor_plan(request, affected)
        expect(plan.is_err()).to_equal(true)
        expect(plan.unwrap_err()).to_equal("overlapping_edits")
