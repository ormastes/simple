use std.spec.*
use common.ui.host_input_event.{HostInputEvent, HOST_BTN_NONE}
fn _pointer(ev: HostInputEvent) -> (i32, i32, i64, bool, i32):
    match ev:
        HostInputEvent.Pointer(x, y, button, pressed, wheel): (x, y, button, pressed, wheel)
        _: (0, 0, HOST_BTN_NONE, false, 0)
describe "probe":
    it "should parse":
        val (x, y, b, p, w) = _pointer(HostInputEvent.Pointer(x: 1, y: 2, button: 0, pressed: true, wheel: 0))
        expect(x).to_equal(1)
