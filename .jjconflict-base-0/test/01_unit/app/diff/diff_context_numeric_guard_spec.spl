use std.spec.step

extern fn rt_file_read_text(path: text) -> text?

describe "diff context numeric guard":
    # @manual scenario evidence
    it "defaults malformed context values":
        # @req REQ-SSPEC-APP
        step("defaults malformed context values")
        # evidence(protocol_json): asserted result fields below are the complete typed oracle
        val source = rt_file_read_text("src/app/diff/main.spl") ?? ""

        expect(source).to_contain("fn parse_context_or_default(value: text, default_value: i64) -> i64")
        expect(source).to_contain("return trimmed.to_int() ?? default_value")
        assert_false(source.contains("return trimmed.to_int()\n"))
