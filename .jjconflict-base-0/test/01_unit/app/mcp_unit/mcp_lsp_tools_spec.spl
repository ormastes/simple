describe "simple_document_formatting tool":
    it "rejects a missing file parameter with an invalid-params error":
        # @req REQ-MCP-LSP-051
        # @capture(protocol_json): the shipped -32602 file gate for document-formatting
        step("Read the shipped handler and verify the missing-file gate for document-formatting")
