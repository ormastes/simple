        val gates_missing_file = owner.contains(
            "make_tool_error(id, -32602, \"Missing required parameter: file\")")
        expect(gates_missing_file).to_equal(true)

    it "builds formatting command":
        # @req REQ-MCP-LSP-052
        # @capture(protocol_json): the shipped document-formatting CLI marshalling line
        step("Read the shipped handler and verify the document-formatting marshalling")
        val owner = bridge_source()
        val marshals_document_formatting = owner.contains(
            "\" query document-formatting \" + file + \" 2>&1\"")
        expect(marshals_document_formatting).to_equal(true)

    it "does not require line parameter":
        # @req REQ-MCP-LSP-053
        # @capture(protocol_json): the shipped file-only signature for document-formatting
        step("Read the shipped handler and verify no line argument is read")
        val owner = bridge_source()
        val reads_only_the_file = owner.contains(
            "val file = extract_field(body, \"file\")")
        expect(reads_only_the_file).to_equal(true)

    it "is marked as destructive tool":
        # @req REQ-MCP-LSP-054
        # @capture(protocol_json): the registry destructiveHint classification of document-formatting
        step("Read the shipped registry and verify document-formatting is classified destructive")
        val registry = registry_source()
        val marks_formatting_destructive = registry.contains(
            "name == \"simple_rename\" or name == \"simple_document_formatting\"")
        expect(marks_formatting_destructive).to_equal(true)

# ============================================================================
# Test Group 11: Cross-tool consistency
# ============================================================================

describe "LSP tool consistency":
    it "registry names all ten Tier 4 tools":
        # @req REQ-MCP-LSP-055
        # @capture(protocol_json): the registry name list for the ten Tier 4 tools
        step("Read the shipped registry and verify every Tier 4 tool name appears")
        val registry = registry_source()
        val lists_signature_help = registry.contains("simple_signature_help")
        val lists_rename = registry.contains("simple_rename")
        val lists_code_actions = registry.contains("simple_code_actions")
        val lists_workspace_symbols = registry.contains("simple_workspace_symbols")
        val lists_call_hierarchy = registry.contains("simple_call_hierarchy")
        val lists_type_hierarchy = registry.contains("simple_type_hierarchy")
        val lists_semantic_tokens = registry.contains("simple_semantic_tokens")
        val lists_inlay_hints = registry.contains("simple_inlay_hints")
        val lists_selection_range = registry.contains("simple_selection_range")
        val lists_document_formatting = registry.contains("simple_document_formatting")
        expect(lists_signature_help and lists_rename and lists_code_actions and
            lists_workspace_symbols and lists_call_hierarchy and lists_type_hierarchy and
            lists_semantic_tokens and lists_inlay_hints and lists_selection_range and
            lists_document_formatting).to_equal(true)

    it "read-only classification covers the eight non-mutating tools":
        # @req REQ-MCP-LSP-056
        # @capture(protocol_json): the registry read-only classification chain
        step("Read the shipped registry and verify the read-only chain names the query tools")
        val registry = registry_source()
        val classifies_signature_help_read_only = registry.contains(
            "name == \"simple_signature_help\" or name == \"simple_code_actions\" or name == \"simple_workspace_symbols\"")
        expect(classifies_signature_help_read_only).to_equal(true)

    it "destructive classification is exactly rename and document-formatting":
        # @req REQ-MCP-LSP-057
        # @capture(protocol_json): the registry destructive classification chain
        step("Read the shipped registry and verify the destructive chain names exactly two tools")
        val registry = registry_source()
        val marks_exactly_two_destructive = registry.contains(
            "name == \"simple_rename\" or name == \"simple_document_formatting\"")
        expect(marks_exactly_two_destructive).to_equal(true)

    it "every handler marshals through the bounded timeout and query CLI":
        # @req REQ-MCP-LSP-058
        # @capture(protocol_json): the shared timeout and query-CLI prefix tokens
        step("Read the shipped handler and verify the shared timeout and query prefix")
        val owner = bridge_source()
        val keeps_timeout_guard = owner.contains(
            "\"timeout 30 \" + _mcp_find_simple_binary()")
        expect(keeps_timeout_guard).to_equal(true)
        val routes_through_query_cli = owner.contains(
            "+ \" query signature-help \"")
        expect(routes_through_query_cli).to_equal(true)

    it "every handler reports the exit code in its tool result":
        # @req REQ-MCP-LSP-059
        # @capture(protocol_json): the shared exit-code tool-result wrapper token
        step("Read the shipped handler and verify the exit-code result wrapper")
        val owner = bridge_source()
        val wraps_exit_code_into_result = owner.contains(
            "\"-- simple_signature_help (exit: \" + str(exit_code) + \") --")
        expect(wraps_exit_code_into_result).to_equal(true)

# ============================================================================
# Test Group 12: Error handling patterns
# ============================================================================

describe "LSP tool error handling":
    it "empty file path is an error":
        # @req REQ-MCP-LSP-060
        # @capture(protocol_json): the shipped emptiness comparison for file parameters
        step("Read the shipped handler and verify file emptiness is compared before dispatch")
        val owner = bridge_source()
        val compares_file_emptiness = owner.contains("if file == \"\":")
        expect(compares_file_emptiness).to_equal(true)

    it "empty line is an error for position tools":
        # @req REQ-MCP-LSP-061
        # @capture(protocol_json): the shipped emptiness comparison for line parameters
        step("Read the shipped handler and verify line emptiness is compared before dispatch")
        val owner = bridge_source()
        val compares_line_emptiness = owner.contains("if line == \"\":")
        expect(compares_line_emptiness).to_equal(true)

    it "empty query is an error for workspace-symbols":
        # @req REQ-MCP-LSP-062
        # @capture(protocol_json): the shipped emptiness comparison for the query parameter
        step("Read the shipped handler and verify query emptiness is compared before dispatch")
        val owner = bridge_source()
        val compares_query_emptiness = owner.contains("if query == \"\":")
        expect(compares_query_emptiness).to_equal(true)

    it "empty new_name is an error for rename":
        # @req REQ-MCP-LSP-063
        # @capture(protocol_json): the shipped emptiness comparison for the new-name parameter
        step("Read the shipped handler and verify new-name emptiness is compared before dispatch")
        val owner = bridge_source()
        val compares_new_name_emptiness = owner.contains(
            "if new_name == \"\":")
        expect(compares_new_name_emptiness).to_equal(true)

    it "every rejection uses the JSON-RPC invalid-params code":
        # @req REQ-MCP-LSP-064
        # @capture(protocol_json): the shared -32602 invalid-params error token
        step("Read the shipped handler and verify rejections use the -32602 code")
        val owner = bridge_source()
        val uses_invalid_params_code = owner.contains(
            "make_tool_error(id, -32602, ")
        expect(uses_invalid_params_code).to_equal(true)

    it "negative line number is technically accepted as string":
        # @req REQ-MCP-LSP-065
        # @capture(protocol_json): the shipped string-typed line parameter declaration
        step("Read the shipped handler and verify line stays a string field end to end")
        val owner = bridge_source()
        val keeps_line_as_string = owner.contains(
            "val line = extract_field(body, \"line\")")
        expect(keeps_line_as_string).to_equal(true)

    it "stderr redirect captures error output":
        # @req REQ-MCP-LSP-066
        # @capture(protocol_json): the shipped stderr redirect suffix token
        step("Read the shipped handler and verify the stderr redirect survives marshalling")
        val owner = bridge_source()
        val keeps_stderr_redirect = owner.contains("cmd = cmd + \" 2>&1\"")
        expect(keeps_stderr_redirect).to_equal(true)
