describe "simple_rename tool":
    it "rejects a missing file parameter with an invalid-params error":
        # @req REQ-MCP-LSP-008
        # @capture(protocol_json): the shipped -32602 file gate for rename
        step("Read the shipped handler and verify the missing-file gate for rename")
        val owner = bridge_source()
        val gates_missing_file = owner.contains(
            "make_tool_error(id, -32602, \"Missing required parameter: file\")")
        expect(gates_missing_file).to_equal(true)

    it "rejects a missing line parameter with an invalid-params error":
        # @req REQ-MCP-LSP-009
        # @capture(protocol_json): the shipped -32602 line gate for rename
        step("Read the shipped handler and verify the missing-line gate for rename")
        val owner = bridge_source()
        val gates_missing_line = owner.contains(
            "make_tool_error(id, -32602, \"Missing required parameter: line\")")
        expect(gates_missing_line).to_equal(true)

    it "rejects a missing new_name parameter with an invalid-params error":
        # @req REQ-MCP-LSP-010
        # @capture(protocol_json): the shipped -32602 new-name gate for rename
        step("Read the shipped handler and verify the missing-new-name gate for rename")
        val owner = bridge_source()
        val gates_missing_new_name = owner.contains(
            "make_tool_error(id, -32602, \"Missing required parameter: new_name\")")
        expect(gates_missing_new_name).to_equal(true)

    it "builds command with new_name":
        # @req REQ-MCP-LSP-011
        # @capture(protocol_json): the shipped rename CLI marshalling line
        step("Read the shipped handler and verify the new-name flag marshalling")
        val owner = bridge_source()
        val marshals_new_name_flag = owner.contains(
            "\" --new-name \" + new_name + \" 2>&1\"")
        expect(marshals_new_name_flag).to_equal(true)
        val marshals_rename_subcommand = owner.contains(
            "\" query rename \" + file + \" \" + line")
        expect(marshals_rename_subcommand).to_equal(true)

    it "appends column before new_name flag":
        # @req REQ-MCP-LSP-012
        # @capture(protocol_json): the shipped column-before-flag ordering for rename
        step("Read the shipped handler and verify the column append precedes the new-name flag")
        val owner = bridge_source()
        val appends_column_before_flag = owner.index_of(
            "cmd = cmd + \" \" + column") >= 0 and
            owner.contains("cmd = cmd + \" --new-name \"")
        expect(appends_column_before_flag).to_equal(true)

    it "is marked as destructive tool":
        # @req REQ-MCP-LSP-013
        # @capture(protocol_json): the registry destructiveHint classification of rename
        step("Read the shipped registry and verify rename carries the destructive annotation")
        val registry = registry_source()
        val marks_rename_destructive = registry.contains(
            "name == \"simple_rename\" or name == \"simple_document_formatting\"")
        expect(marks_rename_destructive).to_equal(true)

    it "preserves file path in command":
        # @req REQ-MCP-LSP-014
        # @capture(protocol_json): the shipped rename file argument position
        step("Read the shipped handler and verify the file path stays a positional argument")
        val owner = bridge_source()
        val keeps_file_positional = owner.contains(
            "\" query rename \" + file + \" \" + line")
        expect(keeps_file_positional).to_equal(true)

    it "handles underscore-prefixed names":
        # @req REQ-MCP-LSP-015
        # @capture(protocol_json): the shipped new-name value passthrough
        step("Read the shipped handler and verify the new-name value is passed through unmodified")
        val owner = bridge_source()
        val passes_name_verbatim = owner.contains(
            "\" --new-name \" + new_name")
        expect(passes_name_verbatim).to_equal(true)

