"""
## Purpose and audience
Executable contract for the ten Tier 4 LSP tools of the Simple MCP server
(signature-help, rename, code-actions, workspace-symbols, call-hierarchy,
type-hierarchy, semantic-tokens, inlay-hints, selection-range,
document-formatting): the required-parameter gates, the `simple query`
CLI marshalling shape each handler ships, the bounded timeout guard, and
the tools/list registry entries that name and classify them. Written for
the engineers who own src/lib/nogc_async_mut/mcp/main_lazy_query_tools.spl
and the MCP protocol surface.
## Operator workflow
Run the file with the pure-Simple CLI:
./src/compiler_rust/target/bootstrap/simple run test/01_unit/app/mcp_unit/mcp_lsp_tools_spec.spl
## Compatibility and limitations
The Tier 4 handlers execute only inside the merged MCP server namespace
(a standalone import cannot resolve their shared helpers), so scenarios
pin the shipped handler source and the tools/list registry instead of
invoking them; the argv-level runtime contract is covered by
mcp_argv_query_contract_spec.spl in this directory. The handler source
reads require the repository checkout.
## Verification guidance and troubleshooting
A parameter-gate failure means a tool stopped rejecting a missing file,
line, new-name, or query argument (the client would see a silent empty
result); a marshalling failure means the CLI invocation shape drifted and
LSP clients lose position or flag arguments. Rerun the single file above
after any main_lazy_query_tools.spl or lazy_protocol_schemas.spl edit.
"""
# Lifecycle: doc/01_research/domain/sspec_documentization_maintenance.md ;
# doc/03_plan/sspec_modernization_plan.md ;
# doc/04_architecture/sspec_documentization_maintenance.md ;
# doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
# @manual_section: mcp-lsp-tools

use std.spec.{describe, it, expect, step}
use std.io_runtime.{file_read}

# The shipped Tier 4 owner module; every handler and marshalling line
# asserted below lives in this file.
fn bridge_source() -> text:
    file_read("src/lib/nogc_async_mut/mcp/main_lazy_query_tools.spl")

# The shipped tools/list registry (names, descriptions, annotations).
fn registry_source() -> text:
    file_read("src/lib/nogc_async_mut/mcp/lazy_protocol_schemas.spl")

# ============================================================================
# Test Group 1: simple_signature_help tool
# ============================================================================

describe "simple_signature_help tool":
    it "rejects a missing file parameter with an invalid-params error":
        # @req REQ-MCP-LSP-001
        # @capture(protocol_json): the shipped -32602 file gate for signature-help
        step("Read the shipped handler and verify the missing-file gate")
        val owner = bridge_source()
        val gates_missing_file = owner.contains(
            "make_tool_error(id, -32602, \"Missing required parameter: file\")")
        expect(gates_missing_file).to_equal(true)

    it "rejects a missing line parameter with an invalid-params error":
        # @req REQ-MCP-LSP-002
        # @capture(protocol_json): the shipped -32602 line gate for signature-help
        step("Read the shipped handler and verify the missing-line gate")
        val owner = bridge_source()
        val gates_missing_line = owner.contains(
            "make_tool_error(id, -32602, \"Missing required parameter: line\")")
        expect(gates_missing_line).to_equal(true)

    it "builds correct command with file and line":
        # @req REQ-MCP-LSP-003
        # @capture(protocol_json): the shipped signature-help CLI marshalling line
        step("Read the shipped handler and verify the signature-help subcommand marshalling")
        val owner = bridge_source()
        val marshals_file_and_line = owner.contains(
            "\" query signature-help \" + file + \" \" + line")
        expect(marshals_file_and_line).to_equal(true)

    it "appends column when provided":
        # @req REQ-MCP-LSP-004
        # @capture(protocol_json): the shipped optional-column append for signature-help
        step("Read the shipped handler and verify the guarded column append")
        val owner = bridge_source()
        val appends_column_when_present = owner.contains(
            "cmd = cmd + \" \" + column")
        expect(appends_column_when_present).to_equal(true)

    it "has 30 second timeout":
        # @req REQ-MCP-LSP-005
        # @capture(protocol_json): the shipped timeout guard prefix
        step("Read the shipped handler and verify the 30 second timeout guard")
        val owner = bridge_source()
        val keeps_thirty_second_timeout = owner.contains(
            "\"timeout 30 \" + _mcp_find_simple_binary()")
        expect(keeps_thirty_second_timeout).to_equal(true)

    it "omits column when not provided":
        # @req REQ-MCP-LSP-006
        # @capture(protocol_json): the shipped emptiness guard around the column append
        step("Read the shipped handler and verify the column append sits behind an emptiness guard")
        val owner = bridge_source()
        val guards_column_on_emptiness = owner.contains("if column != \"\":")
        expect(guards_column_on_emptiness).to_equal(true)

    it "uses query subcommand not direct subcommand":
        # @req REQ-MCP-LSP-007
        # @capture(protocol_json): the shipped query subcommand routing token
        step("Read the shipped handler and verify routing through the query subcommand")
        val owner = bridge_source()
        val routes_via_query_cli = owner.contains(
            "_mcp_find_simple_binary() + \" query signature-help \"")
        expect(routes_via_query_cli).to_equal(true)

