        # @req REQ-MCP-LSP-038
        # @capture(protocol_json): the shipped semantic-tokens CLI marshalling line
        step("Read the shipped handler and verify the file-only marshalling")
        val owner = bridge_source()
        val marshals_file_only = owner.contains(
            "\" query semantic-tokens \" + file")
        expect(marshals_file_only).to_equal(true)

    it "supports start_line and end_line range":
        # @req REQ-MCP-LSP-039
        # @capture(protocol_json): the shipped range flag marshalling for semantic-tokens
        step("Read the shipped handler and verify both range flags are marshalled")
        val owner = bridge_source()
        val marshals_start_line = owner.contains(
            "\" --start-line \" + start_line")
        expect(marshals_start_line).to_equal(true)
        val marshals_end_line = owner.contains(
            "\" --end-line \" + end_line")
        expect(marshals_end_line).to_equal(true)

    it "does not require line as positional arg":
        # @req REQ-MCP-LSP-040
        # @capture(protocol_json): the shipped file-only signature without a positional line
        step("Read the shipped handler and verify no positional line follows the file")
        val owner = bridge_source()
        val keeps_file_only_shape = owner.contains(
            "\" query semantic-tokens \" + file")
        expect(keeps_file_only_shape).to_equal(true)

    it "supports start_line without end_line":
        # @req REQ-MCP-LSP-041
        # @capture(protocol_json): the shipped independent start-line guard
        step("Read the shipped handler and verify start-line carries its own guard")
        val owner = bridge_source()
        val guards_start_line_on_emptiness = owner.contains(
            "if start_line != \"\":")
        expect(guards_start_line_on_emptiness).to_equal(true)

    it "supports end_line without start_line":
        # @req REQ-MCP-LSP-042
        # @capture(protocol_json): the shipped independent end-line guard
        step("Read the shipped handler and verify end-line carries its own guard")
        val owner = bridge_source()
        val guards_end_line_on_emptiness = owner.contains(
