# Reproduce + regression gate for the test-DB write abort.
#
# The runner's own process -- not the spec child -- flattens the whole
# test_runner + database stack, and in THAT module graph the local alias
# `use std.io_runtime.{file_rename as runtime_file_rename}`
# (src/lib/nogc_sync_mut/io/file_ops.spl:218) failed to resolve. The
# interpreter looked the bare alias up in its `functions` map, missed, and
# emitted
#   error[E1002]: function `runtime_file_rename` not found
# from `update_test_database` (test_runner_main.spl:1144) -- AFTER
# print_summary (:1125) had already printed a clean `Results:` block.
#
# The observable contract this file pins: a directory in which every test
# passes must exit 0 and must leave a written test DB. Before the fix this
# directory printed `All tests passed!` and still exited 1, and wrote no DB
# at all -- which is why doc/08_tracking/test/test_result.md froze.
#
# Note this spec cannot fail from INSIDE the child: the alias resolves fine
# in a spec child's smaller module graph. The gate is the runner's exit code
# over this directory, exercised by
# scripts/check/check-test-db-write-succeeds.shs.

describe "test DB write":
    it "runs a trivially passing example so the directory is all-green":
        expect(1 + 1).to_equal(2)
