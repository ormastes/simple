# @tag:unit, spec
"""
# `after_all` Drains at the End of Its Own Group

Reproduce spec for the lifecycle-hook defect where `after_all` hooks were
registered but never run under the interpreter's builtin BDD runner.

`describe`/`context` are intercepted by the builtin runner
(`interpreter_call/bdd.rs`, `interpreter_call/block_execution.rs` and
`interpreter_control.rs`), so `std.spec`'s pure-Simple `describe` -- the only
code that drained `after_all_hooks` -- never executed. Registration therefore
parked the hook in a list nothing read and it silently never fired.

Oracle: a nested `context`'s `after_all` must fire when THAT context ends, so
the sibling `it` written after it already observes the marker; the enclosing
describe's `after_all` must fire when the describe ends, observed by a later
top-level describe. Each marker list has exactly ONE writer -- a hook's write
to a list some other hook already mutated in the same group is lost, tracked
separately in
doc/08_tracking/bug/after_all_hook_module_global_write_lost_after_in_group_mutation_2026-08-31.md
"""

use std.nogc_async_mut.spipe

var inner_done: [text] = []
var outer_done: [text] = []

describe "outer group with a nested context":
    after_all:
        outer_done.push("outer")

    context "inner context":
        after_all:
            inner_done.push("inner")

        it "runs before its own group's after_all":
            assert_equal(inner_done.len(), 0)

    it "sees the inner context's after_all already drained":
        assert_equal(inner_done.len(), 1)
        assert_equal(inner_done[0], "inner")
        assert_equal(outer_done.len(), 0)

describe "drain point declared after the group above":
    it "sees the outer describe's after_all drained at its group end":
        assert_equal(outer_done.len(), 1)
        assert_equal(outer_done[0], "outer")
        assert_equal(inner_done.len(), 1)
