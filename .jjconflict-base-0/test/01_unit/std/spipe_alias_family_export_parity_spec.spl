"""
## Purpose and audience
Verifies that all runtime-family alias modules under `src/lib/*/spipe.spl` explicitly re-export
the `std.spec` lifecycle hooks. This ensures that any new alias family added without an explicit
export list does not silently reintroduce missing lifecycle-hook resolution errors.

## Operator workflow
Run the spec with `bin/simple test test/01_unit/std/spipe_alias_family_export_parity_spec.spl`.
The test scans four alias modules (`nogc_sync_mut`, `nogc_async_mut`, `gc_async_mut`, `gc_sync_mut`)
and verifies each contains an explicit export list or star re-export facade.

## Compatibility and limitations
Works with the current alias-module structure. Does not test nested or multi-level imports.
Requires file-system access to inspect module source.

## Verification guidance and troubleshooting
If a test fails, inspect the named alias module to confirm it contains either an explicit
`export before_all` line or an `export use std.spec` facade. A bare `use` is insufficient.
"""
# Lifecycle: doc/01_research/domain/spec_to_spipe_toolchain.md ;
# doc/03_plan/agent_tasks/spipe_knowledge_compiler.md ;
# doc/04_architecture/app/spec_to_spipe.md ;
# doc/05_design/app/spec_to_spipe_evidence_extension.md
# @manual_section: alias_modules

use std.spec.step

use std.spec.{describe, it, expect}
use std.fs.{read_file}


fn _alias_reexports(path: text) -> bool:
    val src = read_file(path)
    # Either an explicit export list, or a star re-export facade.
    return src.contains("export before_all") or src.contains("export use ")

describe "spipe alias modules re-export lifecycle hooks":
    it "nogc_sync_mut alias re-exports":
        # @req REQ-SSPEC-UNIT
        # @capture(bit_table): source code of src/lib/nogc_sync_mut/spipe.spl
        step("nogc_sync_mut alias re-exports")
        expect(_alias_reexports("src/lib/nogc_sync_mut/spipe.spl")).to_equal(true)

    it "nogc_async_mut alias re-exports":
        # @req REQ-SSPEC-UNIT
        # @capture(bit_table): source code of src/lib/nogc_async_mut/spipe.spl
        step("nogc_async_mut alias re-exports")
        expect(_alias_reexports("src/lib/nogc_async_mut/spipe.spl")).to_equal(true)

    it "gc_async_mut alias re-exports":
        # @req REQ-SSPEC-UNIT
        # @capture(bit_table): source code of src/lib/gc_async_mut/spipe.spl
        step("gc_async_mut alias re-exports")
        expect(_alias_reexports("src/lib/gc_async_mut/spipe.spl")).to_equal(true)

    it "gc_sync_mut alias re-exports":
        # @req REQ-SSPEC-UNIT
        # @capture(bit_table): source code of src/lib/gc_sync_mut/spipe.spl
        step("gc_sync_mut alias re-exports")
        expect(_alias_reexports("src/lib/gc_sync_mut/spipe.spl")).to_equal(true)
