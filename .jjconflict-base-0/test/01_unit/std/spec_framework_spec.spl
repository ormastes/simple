# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-STD
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# SPipe Framework - Self-Test
#
# Tests the built-in test framework matchers.
# Uses only matchers supported by the bootstrap runtime.
#
# Supported: to_equal, to_be, to_be_nil, to_contain,
#            to_start_with, to_end_with,
#            to_be_greater_than, to_be_less_than
#
# No try/catch/throw - Simple does not support exceptions.


use std.spec.step

describe "SPipe Framework":
    # @manual scenario evidence

    context "describe and context nesting":

        it "runs basic test":
            # @req REQ-SSPEC-STD
            step("runs basic test")
            expect(1 + 1).to_equal(2)

        it "supports nested context":
            # @req REQ-SSPEC-STD
            step("supports nested context")
            val context_name = "describe/context nesting"
            expect(context_name).to_contain("context")

    context "expect() matchers":

        it "to_equal checks equality":
            # @req REQ-SSPEC-STD
            step("to_equal checks equality")
            expect(42).to_equal(42)
            expect("hello").to_equal("hello")

        it "to_be is alias for to_equal":
            # @req REQ-SSPEC-STD
            step("to_be is alias for to_equal")
            expect(10).to_be(10)

        it "to_equal true checks boolean true":
            # @req REQ-SSPEC-STD
            step("to_equal true checks boolean true")
            val enabled = true
            expect(enabled).to_equal(not false)

        it "to_equal false checks boolean false":
            # @req REQ-SSPEC-STD
            step("to_equal false checks boolean false")
            expect(false).to_equal(false)

        it "to_be_nil checks nil":
            # @req REQ-SSPEC-STD
            step("to_be_nil checks nil")
            expect(nil).to_be_nil()

        it "to_contain checks string membership":
            # @req REQ-SSPEC-STD
            step("to_contain checks string membership")
            expect("hello world").to_contain("world")

        it "to_contain checks array membership":
            # @req REQ-SSPEC-STD
            step("to_contain checks array membership")
            expect([1, 2, 3]).to_contain(2)

        it "to_start_with checks prefix":
            # @req REQ-SSPEC-STD
            step("to_start_with checks prefix")
            expect("hello").to_start_with("hel")

        it "to_end_with checks suffix":
            # @req REQ-SSPEC-STD
            step("to_end_with checks suffix")
            expect("hello").to_end_with("llo")

        it "to_be_greater_than compares":
            # @req REQ-SSPEC-STD
            step("to_be_greater_than compares")
            expect(10).to_be_greater_than(5)

        it "to_be_less_than compares":
            # @req REQ-SSPEC-STD
            step("to_be_less_than compares")
            expect(5).to_be_less_than(10)

    context "value comparisons":

        it "equality with strings":
            # @req REQ-SSPEC-STD
            step("equality with strings")
            expect("abc").to_equal("abc")

        it "equality with arrays":
            # @req REQ-SSPEC-STD
            step("equality with arrays")
            expect([1, 2]).to_equal([1, 2])

        it "nil equality":
            # @req REQ-SSPEC-STD
            step("nil equality")
            expect(nil).to_be_nil()
            expect(nil).to_equal(nil)
