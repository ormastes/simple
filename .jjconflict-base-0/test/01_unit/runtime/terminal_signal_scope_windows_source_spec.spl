use std.spec.{describe, it, expect}

extern fn rt_file_read_text(path: text) -> text

describe "Windows terminal signal scope source contract":
    it "publishes before admission and drains readers before CloseHandle":
        val source = rt_file_read_text("src/runtime/runtime_terminal.c") ?? ""
        val windows_end = source.find("bool rt_terminal_signal_scope_end(int64_t scope)")
        val windows = if windows_end >= 0: source.substring(0, windows_end + 1800) else: ""
        expect(windows).to_contain("rt_terminal_scope_event = event")
        expect(windows).to_contain("InterlockedExchange(&rt_terminal_scope_active, 1)")
        expect(windows).to_contain("rt_terminal_scope_reader_active")
        expect(windows).to_contain("rt_terminal_scope_handler_inflight")
        expect(windows).to_contain("SetEvent(rt_terminal_scope_event)")
        expect(windows).to_contain("CloseHandle(event)")
        expect(windows).to_contain("InterlockedIncrement64(&rt_terminal_scope_handle)")
        expect(windows).to_contain("#include <errno.h>")
        expect(windows).to_contain("InterlockedIncrement(&rt_terminal_scope_handler_inflight)")
        expect(windows).to_contain("HANDLE wake_event = rt_terminal_scope_event")
        expect(windows).to_contain("while (InterlockedCompareExchange(&rt_terminal_scope_handler_inflight, 0, 0) != 0) {}")

    it "keeps both native inventories and the public facade closed":
        val simple_native = rt_file_read_text("src/compiler/70.backend/backend/runtime_compiler.spl") ?? ""
        val rust_native = rt_file_read_text("src/compiler_rust/runtime/build.rs") ?? ""
        val terminal = rt_file_read_text("src/lib/nogc_sync_mut/tui/terminal.spl") ?? ""
        val tui = rt_file_read_text("src/lib/nogc_sync_mut/tui/__init__.spl") ?? ""
        val legacy_native = rt_file_read_text("src/app/compile/native.spl") ?? ""
        val hosted = rt_file_read_text("src/compiler_rust/runtime/src/value/sffi/env_process.rs") ?? ""
        expect(simple_native).to_contain("runtime_terminal")
        expect(rust_native).to_contain("runtime_terminal.c")
        expect(terminal).to_contain("extern fn rt_terminal_signal_scope_begin() -> i64")
        expect(terminal).to_contain("fn terminal_read_byte_interruptible(scope: i64) -> i64")
        expect(tui).to_contain("terminal_signal_scope_begin")
        expect(legacy_native).to_contain("src/runtime/runtime_terminal.c")
        expect(hosted).to_contain("fn hosted_terminal_enable_raw_mode() -> RuntimeValue")
        expect(hosted).to_contain("fn hosted_stdin_read_byte() -> i64")
