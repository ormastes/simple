"""@naked / @section / @align / @global end-to-end contract (design A.2, plan 1.3).

Unit half of the acceptance: the attribute parser, the MIR threading and the
pure-Simple LLVM emitter. The objdump/readelf half runs in
`scripts/check/check-naked-no-prologue.shs` against a real native build.
"""
# @req REQ-HAL-ASM-NAKED
# research: doc/01_research/os/hal/hal_asm_embedding_dual_run_survey_2026-08-28.md ; plan: doc/03_plan/os/hal/asm_to_simple_migration_plan.md ; design: doc/05_design/os/hal/asm_embedded_hal_and_dual_run.md

use std.spec
use std.spec.step
use compiler.frontend.flat_ast_bridge.{parse_and_build_module}
use compiler.common.attributes.{parse_function_attrs, is_valid_asm_symbol_name, vhdl_hardware_metadata_default}
use compiler.backend.{MirToLlvm}
use compiler.backend.backend.backend_types.{CodegenTarget}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir.*

fn naked_module(naked: bool, section: text, align: i64, global: bool) -> MirModule:
    """One `()` function whose body is a single raw asm block (`ud2`)."""
    val void_type = MirType.unit()
    val function = MirFunction(
        symbol: SymbolId(id: 7), name: "trap_only",
        signature: MirSignature(params: [], return_type: void_type, is_variadic: false),
        locals: [],
        blocks: [MirBlock(
            id: BlockId.entry(), label: Some("entry"),
            instructions: [
                MirInst(kind: MirInstKind.InlineAsm("ud2", true, [], [], [], [], []), span: nil)
            ],
            terminator: MirTerminator.Ret(nil)
        )],
        entry_block: BlockId.entry(), span: Span.empty(), generic_params: [],
        is_generic_template: false, specialization_of: nil, type_bindings: {},
        layout_phase: nil, is_kernel: false, gpu_target: "", gpu_backend_order: "",
        is_export_c: false, export_name: "", has_driver_manifest_attr: false,
        driver_manifest_attr: nil, has_vhdl_metadata: false,
        vhdl_metadata: vhdl_hardware_metadata_default(), has_fast_math: false,
        is_naked: naked, section: section, align: align, is_global: global)
    var functions: Dict<SymbolId, MirFunction> = {}
    functions[function.symbol] = function
    MirModule(name: "hal.naked.backend", functions: functions,
        statics: {}, constants: {}, types: {})

fn ir_for(naked: bool, section: text, align: i64, global: bool) -> text:
    MirToLlvm.create("hal.naked.backend", CodegenTarget.X86_64, nil).translate_module(naked_module(naked, section, align, global))

describe "@naked/@section/@align/@global attribute parsing":
    it "threads naked, section, align and global through FunctionAttr":
        step("threads naked, section, align and global through FunctionAttr")
        val source = "@naked\n@section(\".text.boot\")\n@align(16)\n@global\nfn _start_twin():\n    pass\n"
        val module = parse_and_build_module(source, "naked_attrs.spl")
        val fa = parse_function_attrs(module.functions["_start_twin"].attributes)
        expect(fa.is_naked).to_be(true)
        expect(fa.section ?? "").to_equal(".text.boot")
        expect(fa.align).to_equal(16)
        expect(fa.is_global).to_be(true)
        expect(fa.placement_error).to_equal("")

    it "rejects a non-power-of-two or out-of-range @align with E-ALIGN-RANGE":
        step("rejects a non-power-of-two or out-of-range @align with E-ALIGN-RANGE")
        val bad = parse_and_build_module("@align(3)\nfn f():\n    pass\n", "bad_align.spl")
        expect(parse_function_attrs(bad.functions["f"].attributes).placement_error).to_contain("E-ALIGN-RANGE")
        val huge = parse_and_build_module("@align(8192)\nfn g():\n    pass\n", "huge_align.spl")
        expect(parse_function_attrs(huge.functions["g"].attributes).placement_error).to_contain("E-ALIGN-RANGE")
        val ok = parse_function_attrs(parse_and_build_module("@align(4096)\nfn h():\n    pass\n", "ok_align.spl").functions["h"].attributes)
        expect(ok.align).to_equal(4096)
        expect(ok.placement_error).to_equal("")

    it "only accepts assembler-valid names for @global (E-GLOBAL-MANGLE)":
        step("only accepts assembler-valid names for @global (E-GLOBAL-MANGLE)")
        expect(is_valid_asm_symbol_name("_start")).to_be(true)
        expect(is_valid_asm_symbol_name("vector_table")).to_be(true)
        expect(is_valid_asm_symbol_name("gdt64.pointer")).to_be(true)
        expect(is_valid_asm_symbol_name("")).to_be(false)
        expect(is_valid_asm_symbol_name("has-dash")).to_be(false)
        expect(is_valid_asm_symbol_name("has space")).to_be(false)

describe "@naked lowering to LLVM IR (pure-Simple backend)":
    it "emits naked+noinline, unreachable, and no ret for a @naked body":
        step("emits naked+noinline, unreachable, and no ret for a @naked body")
        val ir = ir_for(true, "", 0, false)
        expect(ir).to_contain("@trap_only()")
        expect(ir).to_contain(" naked noinline")
        expect(ir).to_contain("  unreachable")
        expect(ir).to_not_contain("  ret void")
        expect(ir).to_not_contain("alwaysinline")

    it "keeps a plain function on the ret path with no naked attribute":
        step("keeps a plain function on the ret path with no naked attribute")
        val ir = ir_for(false, "", 0, false)
        expect(ir).to_contain("  ret void")
        expect(ir).to_not_contain(" naked")
        expect(ir).to_not_contain("unreachable")

    it "places @section and @align on the define line":
        step("places @section and @align on the define line")
        val ir = ir_for(true, ".text.boot", 16, false)
        expect(ir).to_contain("section \".text.boot\"")
        expect(ir).to_contain(" align 16")

    it "exports a @global function as dso_local under its unmangled name":
        step("exports a @global function as dso_local under its unmangled name")
        val ir = ir_for(true, ".text.boot", 0, true)
        expect(ir).to_contain("define dso_local void @trap_only()")
        val plain = ir_for(false, "", 0, false)
        expect(plain).to_not_contain("dso_local void @trap_only")
