## Behavioral coverage for pre-resolved manual auto-defer candidates.

use std.spec
use compiler.semantics.auto_defer.{
    AutoDeferCandidate,
    auto_defer_analyze,
    auto_defer_generate_stmts,
}

describe "auto-defer pre-resolved manual state":
    it "does not count or emit a defer already marked manual":
        val candidate = AutoDeferCandidate(
            var_name: "file",
            type_name: "File",
            scope_depth: 0,
            has_manual_defer: true,
            has_no_auto_defer_annotation: false,
        )

        val result = auto_defer_analyze([candidate], [])

        expect(result.inserted_count).to_equal(0)
        expect(result.skipped_manual).to_equal(1)
        expect(result.candidates.len()).to_equal(1)
        expect(result.candidates[0].has_manual_defer).to_equal(true)
        expect(auto_defer_generate_stmts(result).len()).to_equal(0)

    it "still discovers a manual defer from source text":
        val candidate = AutoDeferCandidate(
            var_name: "socket",
            type_name: "Socket",
            scope_depth: 0,
            has_manual_defer: false,
            has_no_auto_defer_annotation: false,
        )

        val result = auto_defer_analyze([candidate], ["defer socket.close()"])

        expect(result.inserted_count).to_equal(0)
        expect(result.skipped_manual).to_equal(1)
        expect(result.candidates[0].has_manual_defer).to_equal(true)
        expect(auto_defer_generate_stmts(result).len()).to_equal(0)
