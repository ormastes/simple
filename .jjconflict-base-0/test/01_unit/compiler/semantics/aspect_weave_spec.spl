"""
## Purpose and audience
Purpose: Prove that C3 static-weave codegen: weave_forward_advice on real `forward` join points.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-SEMANTICS-001 — stable requirement identity for this spec.

# C3 static-weave codegen: prove `weave_forward_advice` (35.semantics/
# aspect_weave.spl) actually rewrites a matched `forward` join point's
# forwarder body, and that the advice call it inserts really EXECUTES --
# not just that the HIR shape changed.
#
# doc/03_plan/ui/perf/render_perf_redesign_plan_2026-08-06.md §3 (C3)
# doc/03_plan/compiler/forwarding/
#   zero_cost_layers_c0_c5_staged_implementation_plan_2026-08-07.md (M5 = C3)
#
# WHAT THIS CLOSES: the C3 commit landed at ecd8cddab7e4 proved validation and
# enumeration end-to-end (parser -> flat-AST bridge -> HIR lowering ->
# validate_aspect_contracts) but its own report says "this pass validates and
# enumerates; it does not rewrite anything. Static-weave codegen ... [is] the
# remainder of M5 and [is] not claimed." This spec is the corresponding
# end-to-end proof for the codegen half, on the SAME real source path.
#
# THE TRIPWIRE TRICK: proving "the advice call was inserted into the HIR body"
# is necessary but not sufficient -- a Call node sitting in the AST could
# still be mis-wired (wrong callee resolution, wrong block, never reached).
# So the advice function's OWN body is an integer divide-by-zero. The
# tree-walking interpreter (`70.backend/backend/interpreter.spl`,
# `HirBinOp.Div`) turns that into `Err(BackendError.runtime_error("division by
# zero", ...))`. That means:
#   * if the weave fires, calling the forwarder raises -- the advice's own
#     code really ran, not merely "compiled".
#   * if the weave does NOT fire (wrong kind, unmatched selector), calling the
#     forwarder returns its ordinary value and nothing traps.
# This is the same fail-closed shape `aspect_validation.spl` already uses
# (a distinct, checkable outcome per branch) applied to execution instead of
# to a diagnostics list.
#
# Each example fails (not passes) under these wrong behaviors:
#   * "weave_forward_advice is a no-op stub returning 0"
#       -> ex.1's `woven` assertion fails, ex.2's Err assertion fails (the
#          tripwire never fires because nothing was inserted).
#   * "weave_forward_advice matches on kind/selector too loosely" (e.g. weaves
#     any advice regardless of kind or match)
#       -> ex.3 and ex.4 both expect Ok (no trap) and `woven == 0`; a
#          loosened matcher would trap them or report a nonzero weave count.
#   * "weaving is not idempotent" (a second pass re-inserts the advice call)
#       -> ex.5's second `woven` and final stmt-count assertions fail.

use std.spec.{describe, it, expect}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.semantics.aspect_validation.{validate_aspect_contracts}
use compiler.semantics.aspect_weave.{weave_forward_advice}
use compiler.backend.backend.interpreter.{InterpreterBackendImpl}
use compiler.common.config.{Logger}

fn wv_logger() -> Logger:
    Logger(level: 0)

fn wv_lower(src: text, path: text) -> HirModule:
    val module = parse_full_frontend(src, path, "wv_probe", wv_logger())
    var lowering = HirLowering.with_filename(path)
    lowering.lower_module(module)

# Number of statements in the `submit_view` forwarder's body, across the
# module dict. -1 if `submit_view` is not found (would fail every assertion
# below rather than silently comparing -1 to -1).
fn wv_submit_view_stmt_count(modules: Dict<text, HirModule>) -> i64:
    var count: i64 = -1
    for module_key in modules.keys():
        val module: HirModule = modules[module_key]
        for sym in module.functions.keys():
            val f: HirFunction = module.functions[sym]
            if f.name == "submit_view":
                count = f.body.stmts.len()
    count

val OBLIGATIONS = "@readonly\n@noalloc\n@bounded_time\n"

# The only real logical `forward` join point in every fixture below:
# `submit_view`'s entire body is one delegating call to `submit_impl`.
val FORWARDER = "fn submit_impl(n: i64) -> i64:\n    n + 1\n\nfn submit_view(n: i64) -> i64:\n    submit_impl(n)\n\n"

# TRIPWIRE advice body: see file header. Never touches `n`, so it has no
# effect on `submit_view`'s return value EXCEPT that it raises before the
# delegating call ever runs, when (and only when) it is actually woven in.
val TRIPWIRE = "fn trace_submit():\n    val z: i64 = 0\n    val _boom = 1 / z\n"

val MAIN = "fn main() -> i64:\n    submit_view(41)\n"

# CLEAN MATCH: kind=forward, selector names the real forwarder. Weave MUST fire.
val SRC_MATCH = FORWARDER + "\n@advice(forward, submit_view)\n" + OBLIGATIONS + TRIPWIRE + "\n" + MAIN

# SABOTAGE 1: right selector, WRONG KIND. `scene_commit` is a real C3 kind but
# unmeasurable on this tree, so validation would report it UNMEASURED -- and
# the weaver must independently refuse it too (it does not trust "the
# selector happens to name a real forwarder" as license to weave a non-
# `forward` kind).
val SRC_WRONG_KIND = FORWARDER + "\n@advice(scene_commit, submit_view)\n" + OBLIGATIONS + TRIPWIRE + "\n" + MAIN

# SABOTAGE 2: right kind, selector names nothing that exists. Weave MUST NOT
# fire (there is no join point to attach to).
val SRC_UNMATCHED_SELECTOR = FORWARDER + "\n@advice(forward, no_such_forwarder)\n" + OBLIGATIONS + TRIPWIRE + "\n" + MAIN

describe "C3 static-weave codegen: weave_forward_advice on real `forward` join points":

    it "validates clean and weaves exactly one forwarder for a real matched selector":
        step("Verify: validates clean and weaves exactly one forwarder for a real matched selector")
        # @req: REQ-COMPILER-SEMANTICS-001
        val hir = wv_lower(SRC_MATCH, "wv_match.spl")
        val modules: Dict<text, HirModule> = {"wv_probe": hir}
        # Confirms this fixture is the "everything proven" case the weaver is
        # allowed to run on (mirrors the driver's own gate in
        # 80.driver/driver_hir_pipeline_lowering.spl).
        expect(validate_aspect_contracts(modules).len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        val woven = weave_forward_advice(modules)
        expect(woven).to_equal(1)  # oracle: 1 — named expected value from the requirement
        # Structural: the forwarder body grew by exactly one statement (the
        # prepended advice call). `submit_view`'s original body is a single
        # tail EXPRESSION (`submit_impl(n)`), which HIR keeps in
        # `HirBlock.value` (see the `# DESUGARED: value: HirExpr` / `has: bool`
        # split at compiler/20.hir/hir_definitions.spl:722), not in `.stmts` --
        # so the baseline `.stmts.len()` is 0, not 1, and after weaving in the
        # one prepended advice-call statement it is 1, not 2.
        expect(wv_submit_view_stmt_count(modules)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "the woven advice call actually EXECUTES: the tripwire fires":
        step("Verify: the woven advice call actually EXECUTES: the tripwire fires")
        val hir = wv_lower(SRC_MATCH, "wv_exec.spl")
        val modules: Dict<text, HirModule> = {"wv_probe": hir}
        val woven = weave_forward_advice(modules)
        expect(woven).to_equal(1)  # oracle: 1 — named expected value from the requirement
        val backend = InterpreterBackendImpl.new()
        val result = backend.process_module(modules["wv_probe"])
        # Running `main` (which calls the now-woven `submit_view`) must raise,
        # because the advice's division-by-zero body actually ran. A weave
        # that inserted a Call node the interpreter never reaches (wrong
        # block, wrong ordering, wrong callee name) would leave this Ok.
        expect(result.is_err()).to_equal(true)

    it "does NOT weave, and the tripwire does NOT fire, on a wrong join-point kind":
        step("Verify: does NOT weave, and the tripwire does NOT fire, on a wrong join-point kind")
        val hir = wv_lower(SRC_WRONG_KIND, "wv_wrongkind.spl")
        val modules: Dict<text, HirModule> = {"wv_probe": hir}
        val woven = weave_forward_advice(modules)
        expect(woven).to_equal(0)  # oracle: 0 — named expected value from the requirement
        # UNWOVEN baseline is 0, not 1. `submit_view`'s body is a single tail
        # EXPRESSION (`submit_impl(n)`), which HIR stores in `HirBlock.value`
        # behind the `has: bool` flag, NOT in `.stmts` (struct HirBlock,
        # compiler/20.hir/hir_definitions.spl:722-727: `stmts / has / value /
        # span`). So an un-woven forwarder has ZERO statements; only the
        # weave's prepended advice-call statement makes it 1. Example 1
        # already documents exactly this and asserts 1 *after* weaving. The
        # `1` previously asserted here was copied from that woven case and was
        # wrong for a case that must NOT weave -- it made this example pass
        # only if the weaver had (incorrectly) fired.
        expect(wv_submit_view_stmt_count(modules)).to_equal(0)  # oracle: 0 — named expected value from the requirement
        val backend = InterpreterBackendImpl.new()
        val result = backend.process_module(modules["wv_probe"])
        expect(result.is_err()).to_equal(false)

    it "does NOT weave, and the tripwire does NOT fire, on an unmatched selector":
        step("Verify: does NOT weave, and the tripwire does NOT fire, on an unmatched selector")
        val hir = wv_lower(SRC_UNMATCHED_SELECTOR, "wv_nomatch.spl")
        val modules: Dict<text, HirModule> = {"wv_probe": hir}
        val woven = weave_forward_advice(modules)
        expect(woven).to_equal(0)  # oracle: 0 — named expected value from the requirement
        # 0, not 1 -- same un-woven baseline as the wrong-kind example above.
        expect(wv_submit_view_stmt_count(modules)).to_equal(0)  # oracle: 0 — named expected value from the requirement
        val backend = InterpreterBackendImpl.new()
        val result = backend.process_module(modules["wv_probe"])
        expect(result.is_err()).to_equal(false)

    it "is idempotent: a second weave pass does not double-insert the advice call":
        step("Verify: is idempotent: a second weave pass does not double-insert the advice call")
        val hir = wv_lower(SRC_MATCH, "wv_idempotent.spl")
        val modules: Dict<text, HirModule> = {"wv_probe": hir}
        val first = weave_forward_advice(modules)
        val second = weave_forward_advice(modules)
        expect(first).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(second).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(wv_submit_view_stmt_count(modules)).to_equal(1)  # oracle: 1 — named expected value from the requirement
