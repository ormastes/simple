"""
## Purpose and audience
Purpose: Prove that layer call direction checker.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-SEMANTICS-001 — stable requirement identity for this spec.

# Spec for layer_call_direction_checker.spl (M1 of doc/03_plan/compiler/
# forwarding/zero_cost_layers_c0_c5_staged_implementation_plan_2026-08-07.md).
#
# BINARY PROVENANCE: run under bin/simple, which on this tree resolves to
# the self-hosted binary at bin/release/x86_64-unknown-linux-gnu/simple
# (verified via `readlink -f bin/simple`) — not the Rust seed.
#
# Same style as layer_dag_checker_spec.spl: synthetic LayerDagRegistry and
# module->layer fixtures built directly in this spec, exercising the
# checker's OWN same-layer-or-downward logic — it does not depend on the
# real module-tagging slice (a separate, parallel M1 piece) landing first,
# per this file's own scope note.

use std.spec.{describe, it, expect, expect_not, assert_true}
use compiler.semantics.layer_dag_checker.{LayerDagRegistry}
use compiler.semantics.layer_call_direction_checker.{
    layer_reaches, check_layer_call_edge, check_all_layer_calls,
    format_layer_call_violation, format_layer_call_violations
}

fn _sketch_dag() -> LayerDagRegistry:
    """draw <- gui <- web, wm (same acyclic sketch as layer_dag_checker_spec)."""
    val reg = LayerDagRegistry.new()
    reg.declare("draw")
    reg.declare("gui")
    reg.declare("web")
    reg.declare("wm")
    reg.uses("gui", "draw")
    reg.uses("web", "gui")
    reg.uses("wm", "gui")
    reg

fn _tag(module_layers: [{text: text}], module_path: text, layer: text) -> [{text: text}]:
    var entry: {text: text} = {}
    entry[module_path] = layer
    module_layers.push(entry)
    module_layers

describe "layer call direction checker":

    it "accepts a same-layer call":
        step("Verify: accepts a same-layer call")
        # @req: REQ-COMPILER-SEMANTICS-001
        val dag = _sketch_dag()
        var layers: [{text: text}] = []
        layers = _tag(layers, "a.spl", "gui")
        layers = _tag(layers, "b.spl", "gui")
        val v = check_layer_call_edge("a.spl", "b.spl", layers, dag)
        expect(v.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "accepts a downward call (web -> gui -> draw)":
        step("Verify: accepts a downward call (web -> gui -> draw)")
        val dag = _sketch_dag()
        var layers: [{text: text}] = []
        layers = _tag(layers, "web_mod.spl", "web")
        layers = _tag(layers, "draw_mod.spl", "draw")
        val v = check_layer_call_edge("web_mod.spl", "draw_mod.spl", layers, dag)
        expect(v.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "rejects an upward call (draw -> gui)":
        step("Verify: rejects an upward call (draw -> gui)")
        val dag = _sketch_dag()
        var layers: [{text: text}] = []
        layers = _tag(layers, "draw_mod.spl", "draw")
        layers = _tag(layers, "gui_mod.spl", "gui")
        val v = check_layer_call_edge("draw_mod.spl", "gui_mod.spl", layers, dag)
        expect(v.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(v[0].caller_layer).to_equal("draw")
        expect(v[0].callee_layer).to_equal("gui")

    it "rejects a cross-branch call with no uses edge (web -> wm)":
        step("Verify: rejects a cross-branch call with no uses edge (web -> wm)")
        val dag = _sketch_dag()
        var layers: [{text: text}] = []
        layers = _tag(layers, "web_mod.spl", "web")
        layers = _tag(layers, "wm_mod.spl", "wm")
        val v = check_layer_call_edge("web_mod.spl", "wm_mod.spl", layers, dag)
        expect(v.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "skips an edge where the caller module has no known layer tag":
        step("Verify: skips an edge where the caller module has no known layer tag")
        val dag = _sketch_dag()
        var layers: [{text: text}] = []
        layers = _tag(layers, "gui_mod.spl", "gui")
        val v = check_layer_call_edge("untagged.spl", "gui_mod.spl", layers, dag)
        expect(v.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "skips an edge where the callee module has no known layer tag":
        step("Verify: skips an edge where the callee module has no known layer tag")
        val dag = _sketch_dag()
        var layers: [{text: text}] = []
        layers = _tag(layers, "gui_mod.spl", "gui")
        val v = check_layer_call_edge("gui_mod.spl", "untagged.spl", layers, dag)
        expect(v.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "checks every edge in a multi-entry call-edge list via check_all_layer_calls":
        step("Verify: checks every edge in a multi-entry call-edge list via check_all_layer_calls")
        val dag = _sketch_dag()
        var layers: [{text: text}] = []
        layers = _tag(layers, "web_mod.spl", "web")
        layers = _tag(layers, "gui_mod.spl", "gui")
        layers = _tag(layers, "draw_mod.spl", "draw")

        var call_edges: [{text: [text]}] = []
        var e1: {text: [text]} = {}
        e1["web_mod.spl"] = ["gui_mod.spl", "draw_mod.spl"]
        call_edges.push(e1)
        var e2: {text: [text]} = {}
        e2["draw_mod.spl"] = ["gui_mod.spl"]
        call_edges.push(e2)

        val violations = check_all_layer_calls(call_edges, layers, dag)
        expect(violations.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(violations[0].caller_module).to_equal("draw_mod.spl")
        expect(violations[0].callee_module).to_equal("gui_mod.spl")

        val messages = format_layer_call_violations(violations)
        expect(messages.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        assert_true(messages[0].starts_with("error[layer_call]"))

    it "layer_reaches: same layer is always reachable, unrelated layer is not":
        step("Verify: layer_reaches: same layer is always reachable, unrelated layer is not")
        val dag = _sketch_dag()
        expect(layer_reaches(dag, "gui", "gui")).to_equal(true)
        expect(layer_reaches(dag, "web", "draw")).to_equal(true)
        expect_not(layer_reaches(dag, "draw", "web"))
        expect_not(layer_reaches(dag, "web", "wm"))
