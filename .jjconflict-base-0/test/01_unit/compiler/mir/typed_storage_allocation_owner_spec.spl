use std.spec.{describe, it, assert_equal, assert_true}
use compiler.mir.mir_data.*
use compiler.mir.intrinsics.{MIR_STORAGE_ALLOC_OWNED_RAW_V1}

describe "MIR compiler-owned typed raw allocation owner":
    it "emits allocation proof and returns matching immutable fact atomically":
        var builder = MirBuilder.new()
        val fact = builder.emit_typed_storage_alloc_owned_raw_v1(
            MirType.i64(), 128, 9201, 4, 5,
            "allocation:9201:4:5:128",
            "compiler-site:particles:read_mass:0", "snapshot:def456")
        assert_equal(fact.allocation_byte_len, 128)
        assert_equal(fact.logical_type_id, 9201)
        assert_equal(fact.revision, 4)
        assert_equal(fact.element_count, 5)
        assert_equal(fact.allocation_provenance,
            "compiler-site:particles:read_mass:0")
        assert_equal(fact.source_revision, "snapshot:def456")
        val instructions = builder.instructions
        assert_equal(instructions.len(), 1)
        match instructions[0].kind:
            case Intrinsic(Some(dest), name, args):
                assert_equal(dest.id, fact.base_local.id)
                assert_equal(name, MIR_STORAGE_ALLOC_OWNED_RAW_V1)
                assert_equal(args.len(), 5)
            case _: assert_true(false)
