use std.io_runtime.{file_read}
use std.spec.*

describe "MIR lowering of HirTypeKind.DynTrait":
    it "normalizes DynTrait to a two-pointer fat pointer tuple":
        val source = file_read("src/compiler/50.mir/_MirLowering/function_lowering.spl")
        expect(source).to_contain("case HirTypeKind.DynTrait(_):")
        expect(source).to_contain("# Normalized to MirTypeKind.Tuple([Ptr(U8), Ptr(U8)])")
