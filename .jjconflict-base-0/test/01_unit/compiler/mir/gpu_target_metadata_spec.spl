# @tag: unit, compiler, mir, gpu, opencl

use std.spec.step

use std.spipe.*
use compiler.common.attributes.{FunctionAttr, parse_function_attrs}
use compiler.common.gpu_target_metadata.{normalize_gpu_backend_order_metadata}
use compiler.common.diagnostics.span.{Span}
use compiler.common.attributes.{vhdl_hardware_metadata_default}
use compiler.frontend.parser_types.{Attribute}
use compiler.frontend.parser_types_expr.{Expr, ExprKind}
use compiler.hir.hir_definitions.{HirFunction, HirBlock, HirExpr, HirExprKind}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_types.{SymbolId, SymbolTable, HirType, HirTypeKind}
use compiler.mir.mir_data.{MirFunction, MirModule, MirSignature, MirBuilder, BlockId}
use compiler.mir.mir_instructions.{MirBlock, MirTerminator, MirInstKind, MirOperandKind}
use compiler.mir.mir_types.{MirType, MirConstValue}
use compiler.mir.mir_lowering.{MirLowering}
use compiler.common.dependency.visibility.{Visibility}

extern fn rt_enum_discriminant(value: Any) -> i64

fn empty_span() -> Span:
    Span.empty()

fn empty_block(label: text) -> MirBlock:
    MirBlock(
        id: BlockId.entry(),
        label: Some(label),
        instructions: [],
        terminator: MirTerminator.Unreachable
    )

fn make_mir_function(name: text) -> MirFunction:
    MirFunction(
        symbol: SymbolId(id: 1),
        name: name,
        signature: MirSignature(params: [], return_type: MirType.unit(), is_variadic: false),
        locals: [],
        blocks: [empty_block("entry")],
        entry_block: BlockId.entry(),
        span: empty_span(),
        generic_params: [],
        is_generic_template: false,
        specialization_of: nil,
        type_bindings: {},
        layout_phase: nil,
        is_kernel: false,
        gpu_target: "",
        gpu_backend_order: "",
        is_export_c: false,
        export_name: "",
        has_driver_manifest_attr: false,
        driver_manifest_attr: nil,
        has_vhdl_metadata: false,
        vhdl_metadata: vhdl_hardware_metadata_default(),
        has_fast_math: false
    )

fn make_gpu_attr(target: text, backends: text) -> FunctionAttr:
    var attr = FunctionAttr.default()
    attr.is_gpu_kernel = true
    attr.gpu_target = target
    attr.gpu_backends = backends
    attr

fn make_gpu_source_attr(target: text) -> Attribute:
    val span = empty_span()
    Attribute(
        name: "gpu",
        args: [Expr(kind: ExprKind.StringLit(target, nil), span: span)],
        span: span
    )

fn make_ident_expr(name: text) -> Expr:
    Expr(kind: ExprKind.Ident(name), span: empty_span())

fn make_string_expr(value: text) -> Expr:
    Expr(kind: ExprKind.StringLit(value, nil), span: empty_span())

fn make_assign_expr(name: text, value: text) -> Expr:
    Expr(kind: ExprKind.Assign(make_ident_expr(name), nil, make_string_expr(value)), span: empty_span())

fn make_gpu_source_attr_with_backends(target: text, backends: text) -> Attribute:
    val span = empty_span()
    Attribute(
        name: "gpu",
        args: [make_assign_expr("target", target), make_assign_expr("backends", backends)],
        span: span
    )

fn unit_hir_type() -> HirType:
    HirType(kind: HirTypeKind.Unit, span: empty_span())

fn unit_hir_expr() -> HirExpr:
    HirExpr(kind: HirExprKind.UnitLit, has_type_: true, type_: unit_hir_type(), span: empty_span())

fn unit_hir_block() -> HirBlock:
    HirBlock(stmts: [], has: true, value: unit_hir_expr(), span: empty_span())

fn make_hir_gpu_function(name: text, attr: FunctionAttr) -> HirFunction:
    HirFunction(
        symbol: SymbolId(id: 10),
        name: name,
        type_params: [],
        params: [],
        return_type: unit_hir_type(),
        body: unit_hir_block(),
        effects: [],
        visibility: Visibility.Private,
        is_async: false,
        is_static: false,
        is_public: false,
        is_method: false,
        is_mutable: false,
        is_const: false,
        is_extern: false,
        func_attr: Some(attr),
        has_export_attr: false,
        export_attr: nil,
        has_driver_manifest_attr: false,
        driver_manifest_attr: nil,
        has_suspension: false,
        has_vhdl_metadata: false,
        vhdl_metadata: vhdl_hardware_metadata_default(),
        has_doc_comment: false,
        doc_comment: "",
        span: empty_span()
    )

fn make_bool_tail_function(name: text) -> HirFunction:
    val span = empty_span()
    val type_ = HirType(kind: HirTypeKind.Bool, span: span)
    var fn_ = make_nonunit_hir_gpu_function(name, FunctionAttr.default())
    fn_.return_type = type_
    fn_.body = HirBlock(
        stmts: [], has: true,
        value: HirExpr(kind: HirExprKind.BoolLit(true), has_type_: true, type_: type_, span: span),
        span: span
    )
    fn_

fn make_text_tail_function(name: text) -> HirFunction:
    val span = empty_span()
    val type_ = HirType(kind: HirTypeKind.Str, span: span)
    var fn_ = make_nonunit_hir_gpu_function(name, FunctionAttr.default())
    fn_.return_type = type_
    fn_.body = HirBlock(
        stmts: [], has: true,
        value: HirExpr(kind: HirExprKind.StringLit("owner-tail", nil), has_type_: true, type_: type_, span: span),
        span: span
    )
    fn_

fn owner_for_function(fn_: HirFunction) -> BootstrapHirModuleOwner:
    BootstrapHirModuleOwner(
        name: "owner_parity",
        is_entry: true,
        symbols: [],
        functions: [fn_],
        constants: [],
        enums: [],
        structs: [],
        classes: []
    )

fn mir_instruction_count(fn_: MirFunction) -> i64:
    var count = 0
    for block in fn_.blocks:
        count = count + block.instructions.len()
    count

fn mir_returned_local_id(fn_: MirFunction) -> i64:
    if fn_.blocks.len() == 0:
        return -1
    match fn_.blocks[fn_.blocks.len() - 1].terminator:
        case Ret(returned):
            if val returned_operand = returned:
                match returned_operand.kind:
                    case Copy(local): return local.id
                    case Move(local): return local.id
                    case _: return -1
            return -1
        case _: return -1

fn mir_local_is_int_constant(fn_: MirFunction, local_id: i64, expected: i64) -> bool:
    for block in fn_.blocks:
        for inst in block.instructions:
            match inst.kind:
                case Const(dest, value, _):
                    if dest.id == local_id:
                        match value:
                            case Int(actual): return actual == expected
                            case _: return false
                case _: ()
    false

fn expect_owner_tail_parity(fn_: HirFunction):
    val owner = owner_for_function(fn_)
    val value_lowerer = MirLowering.new(SymbolTable.new())
    val owner_lowerer = MirLowering.new(SymbolTable.new())
    val value_result = value_lowerer.lower_function(fn_)
    val owner_result = owner_lowerer.lower_function_from_module_owner(owner, 0)

    expect(owner_lowerer.errors.len()).to_equal(value_lowerer.errors.len())
    expect(owner_lowerer.errors.len()).to_equal(0)
    expect(owner_result.signature.return_type).to_equal(value_result.signature.return_type)
    expect(owner_result.name).to_equal(value_result.name)
    expect(owner_result.locals.len()).to_equal(value_result.locals.len())
    expect(owner_result.blocks.len()).to_equal(value_result.blocks.len())
    expect(mir_instruction_count(owner_result)).to_equal(mir_instruction_count(value_result))
    expect(mir_returned_local_id(owner_result)).to_equal(mir_returned_local_id(value_result))
    expect(mir_returned_local_id(owner_result) >= 0).to_equal(true)

fn lower_hir_attr_function_to_mir(attr: FunctionAttr, function_name: text) -> MirFunction:
    val lowerer = MirLowering.new(SymbolTable.new())
    lowerer.lower_function(make_hir_gpu_function(function_name, attr))

describe "MIR GPU target metadata":
    it "leaves export metadata disabled for a nil struct optional":
        val result = lower_hir_attr_function_to_mir(FunctionAttr.default(), "plain_fn")

        expect(result.is_export_c).to_equal(false)
        expect(result.export_name).to_equal("")

    it "copies a present export struct optional without retaining its wrapper":
        val lowerer = MirLowering.new(SymbolTable.new())
        var hir_fn = make_hir_gpu_function("exported_fn", FunctionAttr.default())
        hir_fn.has_export_attr = true
        hir_fn.export_attr = Some(ExportAttr(is_export_c: true, export_name: "gpu_export"))

        val result = lowerer.lower_function(hir_fn)

        expect(result.is_export_c).to_equal(true)
        expect(result.export_name).to_equal("gpu_export")

    it "lowers frontend-shaped gpu attribute metadata into MIR":
        # @req REQ-SSPEC-COMPILER
        step("lowers frontend-shaped gpu attribute metadata into MIR")
        val parsed_attr = parse_function_attrs([make_gpu_source_attr("opencl")])
        val lowerer = MirLowering.new(SymbolTable.new())
        val fn_ = make_mir_function("gpu_kernel")

        val result = lowerer.apply_function_attr_to_mir(fn_, parsed_attr)

        expect(result.is_kernel).to_equal(true)
        expect(result.gpu_target).to_equal("opencl")
        expect(result.gpu_backend_order).to_equal("opencl")

    it "propagates normalized OpenCL target metadata from function attrs":
        # @req REQ-SSPEC-COMPILER
        step("propagates normalized OpenCL target metadata from function attrs")
        val lowerer = MirLowering.new(SymbolTable.new())
        val fn_ = make_mir_function("gpu_kernel")
        val attr = make_gpu_attr("opencl-spirv", "")

        val result = lowerer.apply_function_attr_to_mir(fn_, attr)

        expect(result.is_kernel).to_equal(true)
        expect(result.gpu_target).to_equal("opencl")
        expect(result.gpu_backend_order).to_equal("opencl")

    it "propagates normalized ROCm target metadata as HIP from function attrs":
        # @req REQ-SSPEC-COMPILER
        step("propagates normalized ROCm target metadata as HIP from function attrs")
        val lowerer = MirLowering.new(SymbolTable.new())
        val fn_ = make_mir_function("gpu_kernel")
        val attr = make_gpu_attr("rocm", "")

        val result = lowerer.apply_function_attr_to_mir(fn_, attr)

        expect(result.is_kernel).to_equal(true)
        expect(result.gpu_target).to_equal("hip")
        expect(result.gpu_backend_order).to_equal("hip")

    it "preserves canonical explicit backend order through MirFunction copies":
        # @req REQ-SSPEC-COMPILER
        step("preserves canonical explicit backend order through MirFunction copies")
        val fn_ = make_mir_function("gpu_kernel")
        val attr = parse_function_attrs([make_gpu_source_attr_with_backends("auto", "rocm,cl,cuda")])
        val lowerer = MirLowering.new(SymbolTable.new())
        val tagged = lowerer.apply_function_attr_to_mir(fn_, attr)

        val copied = MirFunction.with_blocks(tagged, [empty_block("replacement")])

        expect(copied.is_kernel).to_equal(true)
        expect(copied.gpu_target).to_equal("auto")
        expect(copied.gpu_backend_order).to_equal("hip,opencl,cuda")

    it "canonicalizes explicit backend order metadata through common aliases":
        # @req REQ-SSPEC-COMPILER
        step("canonicalizes explicit backend order metadata through common aliases")
        expect(normalize_gpu_backend_order_metadata("rocm, cl, nvptx")).to_equal("hip,opencl,cuda")

        val fn_ = make_mir_function("gpu_kernel")
        val attr = make_gpu_attr("auto", " hip-cpp, opencl-spirv, ptx ")
        val lowerer = MirLowering.new(SymbolTable.new())

        val result = lowerer.apply_function_attr_to_mir(fn_, attr)

        expect(result.gpu_target).to_equal("auto")
        expect(result.gpu_backend_order).to_equal("hip,opencl,cuda")

    it "preserves positional GPU target metadata through HIR and MIR lowering":
        # @req REQ-SSPEC-COMPILER
        step("preserves positional GPU target metadata through HIR and MIR lowering")
        val attr = parse_function_attrs([make_gpu_source_attr("opencl")])

        val result = lower_hir_attr_function_to_mir(attr, "positional_opencl_kernel")

        expect(result.is_kernel).to_equal(true)
        expect(result.gpu_target).to_equal("opencl")
        expect(result.gpu_backend_order).to_equal("opencl")

    it "preserves named GPU target metadata through HIR and MIR lowering":
        # @req REQ-SSPEC-COMPILER
        step("preserves named GPU target metadata through HIR and MIR lowering")
        val attr = parse_function_attrs([make_gpu_source_attr_with_backends("opencl", "")])

        val result = lower_hir_attr_function_to_mir(attr, "named_opencl_kernel")

        expect(result.is_kernel).to_equal(true)
        expect(result.gpu_target).to_equal("opencl")
        expect(result.gpu_backend_order).to_equal("opencl")

    it "preserves named GPU backend order metadata through HIR and MIR lowering":
        # @req REQ-SSPEC-COMPILER
        step("preserves named GPU backend order metadata through HIR and MIR lowering")
        val attr = parse_function_attrs([make_gpu_source_attr_with_backends("auto", "rocm,cl,cuda")])

        val result = lower_hir_attr_function_to_mir(attr, "ordered_gpu_kernel")

        expect(result.is_kernel).to_equal(true)
        expect(result.gpu_target).to_equal("auto")
        expect(result.gpu_backend_order).to_equal("hip,opencl,cuda")
