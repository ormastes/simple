"""Executable source contract for append-compatible MIR declaration carriers."""
# @req: REQ-COMPILER-MIR-DECLARATION-001

use std.spec
use std.spec.step
use compiler.common.dependency.visibility.{Visibility}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir.{MirModule, MirStatic, MirType, MirVariantDef}
use compiler.mir.mir_declaration_support.{
    serialize_mir_module_declarations, validate_mir_declarations,
    mir_append_declaration_shard, mir_declaration_structural_hash}

describe "MIR declaration schema":
    it "keeps legacy module and static constructors append compatible":
        step("Construct legacy-shaped values and inspect explicit absence")
        val module = MirModule(name: "legacy", functions: {}, statics: {},
            constants: {}, types: {})
        val static_ = MirStatic(symbol: SymbolId(id: 1), name: "state",
            type_: MirType.i64(), init: nil, is_mutable: true)
        expect(module.externs.len()).to_equal(0)
        expect(module.enum_extensions.len()).to_equal(0)
        expect(static_.is_volatile).to_equal(false)
        expect(static_.has_fixed_address).to_equal(false)
        expect(static_.has_runtime_init).to_equal(false)

    it "serializes explicit presence and unresolved extension discriminants":
        step("Retain zero-valued address and unresolved-discriminant presence")
        val static_ = MirStatic(symbol: SymbolId(id: 2), name: "mmio",
            type_: MirType.i64(), init: nil, is_mutable: true,
            visibility: Visibility.Private, is_volatile: true,
            has_fixed_address: true, fixed_address: 0,
            has_runtime_init: true, runtime_init_expr_row: 0)
        val variant = MirVariantDef(name: "Later", discriminant: 0,
            payload: nil, has_discriminant: false,
            has_resolved_discriminant: false, discriminant_expr_row: -1)
        var statics: Dict<SymbolId, MirStatic> = {}
        statics[static_.symbol] = static_
        val module = MirModule(name: "declarations", functions: {},
            statics: statics, constants: {}, types: {})
        val encoded = serialize_mir_module_declarations(module)
        expect(encoded).to_contain("\"has_fixed_address\":true")
        expect(encoded).to_contain("\"fixed_address\":0")
        expect(encoded).to_contain("\"runtime_init_expr_row\":0")
        expect(variant.has_resolved_discriminant).to_equal(false)
        expect(validate_mir_declarations(module).len()).to_equal(0)

    it "keeps graph declaration identity module qualified":
        step("Append module-local symbol dictionaries without flattening")
        val graph = MirModule(name: "entry", functions: {}, statics: {},
            constants: {}, types: {})
        val dependency = MirModule(name: "pkg.dep", functions: {}, statics: {},
            constants: {}, types: {})
        val aggregated = mir_append_declaration_shard(graph, dependency, 7,
            "pkg.dep")
        expect(aggregated == nil).to_equal(false)
        if val result = aggregated:
            expect(result.declaration_shards.len()).to_equal(1)
            expect(result.declaration_shard_index[7]).to_equal(0)
            val encoded = serialize_mir_module_declarations(result)
            expect(encoded).to_contain("\"declaration_shard_index\":[[7,0]]")
            var corrupt = result
            var corrupt_index = corrupt.declaration_shard_index
            corrupt_index[7] = 1
            corrupt.declaration_shard_index = corrupt_index
            expect(validate_mir_declarations(corrupt).len()).to_be_greater_than(0)
            expect(mir_declaration_structural_hash(corrupt) ==
                mir_declaration_structural_hash(result)).to_equal(false)
            corrupt_index[8] = 0
            corrupt.declaration_shard_index = corrupt_index
            expect(validate_mir_declarations(corrupt).len()).to_be_greater_than(0)
            expect(mir_append_declaration_shard(result, dependency, 7,
                "pkg.dep") == nil).to_equal(true)
