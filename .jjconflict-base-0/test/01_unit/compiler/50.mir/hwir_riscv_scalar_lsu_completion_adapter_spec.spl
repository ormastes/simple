use std.spec.*
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_lsu_config.{LsuConfig}
use compiler.mir.hwir.riscv_scalar_lsu_completion_adapter.{strict_riscv_scalar_lsu_completion_adapter}
use compiler.mir.hwir.riscv_scalar_completion_interface.{strict_hw_scalar_completion_interface}

describe "typed LSU scalar-completion adapter":
    it "normalizes PA and bus masks into the frozen completion widths":
        val rv32 = strict_riscv_scalar_lsu_completion_adapter("lsu_completion32",
            CoreConfig.rv32(), LsuConfig.rv32_product_default())
        val rv64 = strict_riscv_scalar_lsu_completion_adapter("lsu_completion64",
            CoreConfig.rv64(), LsuConfig.rv64_product_default())
        expect(rv32.is_ok()).to_equal(true)
        expect(rv64.is_ok()).to_equal(true)
        if rv64.is_ok():
            val module = rv64.ok().unwrap()
            expect(module.port_width("memory_address")).to_equal(64)
            expect(module.port_width("memory_read_mask")).to_equal(32)
            expect(module.port_width("memory_write_mask")).to_equal(32)
            expect(module.comb_ops[0].op).to_equal("zext")
            expect(module.comb_ops[3].op).to_equal("shr")
            expect(module.structural_sha256().len()).to_equal(64)

    it "rejects a physical address wider than the completion XLEN":
        val config = CoreConfig.rv32()
        config.physical_address_bits = 40
        val rejected = strict_riscv_scalar_lsu_completion_adapter("bad_pa", config,
            LsuConfig.rv32_product_default())
        expect(rejected.is_err()).to_equal(true)
        if rejected.is_err(): expect(rejected.err().unwrap()).to_contain("PA width")

    it "hashes every CoreConfig field into the frozen completion identity":
        val base = CoreConfig.rv32()
        val changed = CoreConfig.rv32()
        changed.compressed_decode_profile = "zca-common-critical"
        changed.profile = "rv32-other"
        val bus = LsuConfig.rv32_product_default()
        val base_hash = strict_hw_scalar_completion_interface(base, bus).unwrap().structural_sha256()
        val changed_hash = strict_hw_scalar_completion_interface(changed, bus).unwrap().structural_sha256()
        expect(base_hash == changed_hash).to_equal(false)
