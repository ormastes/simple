use std.spec.*
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_lsu_config.{LsuConfig}
use compiler.mir.hwir.riscv_scalar_runtime_pipeline_v6.{strict_riscv_scalar_runtime_pipeline_v6_direct}

describe "runtime scalar pipeline v6 direct construction":
    it "owns a direct dynamic multiply leaf while preserving the frozen V5 ABI":
        val pipeline = strict_riscv_scalar_runtime_pipeline_v6_direct(
            "runtime_v6_direct", CoreConfig.rv64im(), LsuConfig.rv64_product_default()).unwrap()
        expect(pipeline.local_diagnostic()).to_equal("")
        expect(pipeline.diagnostic()).to_equal("")
        expect(pipeline.muldiv.entity_name).to_equal("runtime_v6_direct_muldiv")
        expect(pipeline.top_ports.len()).to_equal(61)
        expect(pipeline.top_ports[0].name).to_equal("clk")
        expect(pipeline.top_ports[60].name).to_equal("fence_effect_succ")

    it "binds tag-two pending request and return directly to the multiply provider":
        val pipeline = strict_riscv_scalar_runtime_pipeline_v6_direct(
            "runtime_v6_muldiv", CoreConfig.rv32im(), LsuConfig.rv32_product_default()).unwrap()
        var request = false
        var return_valid = false
        var completion_ready = false
        for binding in pipeline.bindings:
            if binding.source_owner == "pending" and binding.source_port == "muldiv_request_valid" and
                    binding.destination_owner == "muldiv" and binding.destination_port == "request_valid":
                request = true
            if binding.source_owner == "muldiv" and binding.source_port == "completion_valid" and
                    binding.destination_owner == "pending" and binding.destination_port == "muldiv_completion_valid":
                return_valid = true
            if binding.source_owner == "pending" and binding.source_port == "muldiv_completion_ready" and
                    binding.destination_owner == "muldiv" and binding.destination_port == "completion_ready":
                completion_ready = true
        expect(request).to_equal(true)
        expect(return_valid).to_equal(true)
        expect(completion_ready).to_equal(true)
