use std.spec
use verification.lean.types.TypeTranslator
use verification.lean.emitter.format_lean_type
use verification.lean.structure_gen.translate_type_to_lean
use verification.lean._Codegen.lean_codegen.cg_make_simple_type

describe "Legacy Lean generators preserve verification truth":
    it "uses exact widths for signed and unsigned machine integers":
        expect(TypeTranslator.translate_primitive("i32").to_lean()).to_equal("BitVec 32")
        expect(TypeTranslator.translate_primitive("u64").to_lean()).to_equal("BitVec 64")
        expect(format_lean_type("i64")).to_equal("BitVec 64")
        expect(translate_type_to_lean("u32", false, false)).to_equal("BitVec 32")
        expect(cg_make_simple_type("i32")).to_equal("BitVec 32")

    it "fails closed when exact floating point semantics are unavailable":
        expect(TypeTranslator.translate_primitive("f32").to_lean()).to_contain("UNSUPPORTED")
        expect(format_lean_type("f64")).to_contain("UNSUPPORTED")
        expect(translate_type_to_lean("f32", false, false)).to_contain("UNSUPPORTED")
        expect(cg_make_simple_type("f64")).to_contain("UNSUPPORTED")

