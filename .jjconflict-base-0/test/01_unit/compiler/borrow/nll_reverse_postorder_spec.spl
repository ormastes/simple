"""
Control-flow worklist coverage for NLL reverse-postorder discovery.

The graph deliberately combines a duplicate edge, a diamond join, a back
edge, and a missing target. This covers both scheduled-set branches while
pinning the historical deterministic discovery order and missing-target
behavior.
"""

use std.spec
use compiler.borrow.borrow_check.*

fn cfg_block(id: i64, successors: [i64]) -> BasicBlock:
    var block = BasicBlock.create(id)
    block.successors = successors
    block

describe "NLL control-flow worklist":
    it "discovers each target once in deterministic predecessor-first order":
        var cfg = ControlFlowGraph.create()
        cfg.add_block(cfg_block(0, [1, 2, 1]))
        cfg.add_block(cfg_block(1, [3]))
        cfg.add_block(cfg_block(2, [3, 99]))
        cfg.add_block(cfg_block(3, [0]))
        cfg.set_entry(0)

        expect(cfg.reverse_postorder()).to_equal([0, 1, 2, 3, 99])

    it "keeps the historical missing-entry result":
        var cfg = ControlFlowGraph.create()
        cfg.set_entry(7)

        expect(cfg.reverse_postorder()).to_equal([7])
