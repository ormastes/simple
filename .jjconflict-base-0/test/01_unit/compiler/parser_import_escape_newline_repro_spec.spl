use std.spec.{describe, it, expect}
use test.fixtures.parser_import_newline.escape_target.{escape_candidate}

describe "imported escaped JSON strings parse":
    it "preserves escaped branch bytes":
        expect(escape_candidate(10)).to_equal("\\n")

    it "executes the block-form control branch":
        expect(escape_candidate(1)).to_equal("\\u0001")

    it "executes the terminal inline else branch":
        expect(escape_candidate(65)).to_equal("A")
