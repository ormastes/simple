# Purpose and audience: focused structural gate coverage for REQ-008.
# @req REQ-008

use std.spec.{describe, it, expect}
use compiler.tools.verify.backend_plugin_boundary_scan.{
    backend_plugin_provider_calls_allowed,
    scan_backend_plugin_boundary_source,
}

fn spec():
    describe("versioned backend plugin direct-provider boundary", fn():
        it("allows direct provider calls only in adapter and SFFI owners", fn():
            expect(backend_plugin_provider_calls_allowed(
                "src/compiler/70.backend/backend/cranelift_codegen_adapter.spl"
            )).to_equal(true)
            expect(backend_plugin_provider_calls_allowed(
                "src/lib/nogc_sync_mut/sffi/llvm_codegen.spl"
            )).to_equal(true)
            expect(backend_plugin_provider_calls_allowed(
                "src/compiler/90.tools/sffi_gen/specs/cranelift_codegen.spl"
            )).to_equal(true)
            expect(backend_plugin_provider_calls_allowed(
                "src/compiler/80.driver/driver_codegen.spl"
            )).to_equal(false)
        )

        it("rejects Cranelift and LLVM provider calls from a caller", fn():
            val source = "fn compile():\n"
                + "    val module = rt_cranelift_new_module(1, 2, 3)\n"
                + "    llvm_build_add(builder, lhs, rhs, name)\n"
            val violations = scan_backend_plugin_boundary_source(
                "src/compiler/80.driver/driver_codegen.spl", source)
            expect(violations.len()).to_equal(2)
            expect(violations[0].line).to_equal(2)
            expect(violations[0].provider).to_equal("cranelift")
            expect(violations[0].symbol).to_equal("rt_cranelift_new_module")
            expect(violations[1].line).to_equal(3)
            expect(violations[1].provider).to_equal("llvm")
            expect(violations[1].symbol).to_equal("llvm_build_add")
        )

        it("rejects raw JIT and execution-manager calls outside session owners", fn():
            val source = "fn compile_hotspot():\n"
                + "    val handle = rt_jit_create()\n"
                + "    rt_exec_manager_compile(handle, mir_text)\n"
            val violations = scan_backend_plugin_boundary_source(
                "src/compiler/95.interp/execution/tiered_jit_manager.spl",
                source)
            expect(violations.len()).to_equal(2)
            expect(violations[0].provider).to_equal("jit")
            expect(violations[0].symbol).to_equal("rt_jit_create")
            expect(violations[1].provider).to_equal("execution-manager")
            expect(violations[1].symbol).to_equal("rt_exec_manager_compile")
        )

        it("rejects legacy direct compile helpers from driver callers", fn():
            val source = "fn compile_aot():\n"
                + "    val result = compile_module_with_backend(name, module, false, 0)\n"
                + "    llvm_compile_module_direct(options, module)\n"
            val violations = scan_backend_plugin_boundary_source(
                "src/compiler/80.driver/driver_aot_codegen_outputs.spl",
                source)
            expect(violations.len()).to_equal(2)
            expect(violations[0].provider).to_equal("legacy-compile")
            expect(violations[0].symbol).to_equal(
                "compile_module_with_backend")
            expect(violations[1].provider).to_equal("legacy-compile")
            expect(violations[1].symbol).to_equal(
                "llvm_compile_module_direct")
        )

        it("does not mistake comments strings declarations or helper names for calls", fn():
            val source = "# rt_cranelift_new_module(1, 2, 3)\n"
                + "val diagnostic = \"llvm_build_add(builder, lhs, rhs, name)\"\n"
                + "extern fn rt_cranelift_fixture(value: i64) -> i64\n"
                + "extern fn rt_jit_create() -> i64\n"
                + "fn llvm_fixture(value: i64) -> i64: value\n"
                + "fn compile_module_with_backend(value: i64) -> i64: value\n"
                + "val llvm_default_pipeline = 2\n"
            val violations = scan_backend_plugin_boundary_source(
                "src/compiler/80.driver/driver_codegen.spl", source)
            expect(violations.len()).to_equal(0)
        )

        it("does not report provider calls in an allowed adapter", fn():
            val source = "fn compile():\n"
                + "    rt_cranelift_new_module(1, 2, 3)\n"
                + "    llvm_build_add(builder, lhs, rhs, name)\n"
            val violations = scan_backend_plugin_boundary_source(
                "src/compiler/70.backend/backend/provider_adapter.spl", source)
            expect(violations.len()).to_equal(0)
        )

        it("allows legacy helpers and raw JIT calls only in explicit owners", fn():
            val legacy = "fn compile():\n"
                + "    llvm_compile_module_direct(options, module)\n"
            val jit = "fn compile():\n"
                + "    rt_jit_compile_source(handle, source)\n"
            expect(scan_backend_plugin_boundary_source(
                "src/compiler/70.backend/backend/backend_helpers.spl",
                legacy).len()).to_equal(0)
            expect(scan_backend_plugin_boundary_source(
                "src/app/io/jit_sffi.spl", jit).len()).to_equal(0)
        )
    )

spec()
