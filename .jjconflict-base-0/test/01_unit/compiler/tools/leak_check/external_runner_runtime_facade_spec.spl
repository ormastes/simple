"""
# External Runner Runtime Facade Contract

The external leak-check runner owns missing-source policy while
`std.io_runtime` owns the exact file-existence runtime boundary.
"""

use std.io_runtime.{read_file_text}
use std.spec.step

describe "external runner runtime facade ownership":
    it "uses the exact-equivalent file-existence facade":
        step("Load the production external runner source")
        val source = read_file_text("src/compiler/90.tools/leak_check/external_runner.spl")

        step("Require one canonical facade call")
        expect(source).to_contain("use std.io_runtime.{file_exists}")
        expect(source).to_contain("if not file_exists(cfg.source_file):")
        expect(source.split("file_exists(cfg.source_file)").len()).to_equal(2)

        step("Reject duplicate direct runtime ownership")
        expect(source).to_not_contain("extern fn rt_file_exists")
        expect(source).to_not_contain("rt_file_exists(")

    it "preserves the missing-source policy branch":
        step("Load the production external runner source")
        val source = read_file_text("src/compiler/90.tools/leak_check/external_runner.spl")

        step("Pin the missing path error and failure result")
        expect(source).to_contain("if not file_exists(cfg.source_file):\n        print \"Error: source file not found: {cfg.source_file}\"\n        result.exit_code = 1\n        return result")
