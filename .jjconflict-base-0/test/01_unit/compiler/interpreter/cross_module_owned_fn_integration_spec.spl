use test.fixtures.interpreter_owned_call.a.{owned_call_a}
use test.fixtures.interpreter_owned_call.b.{owned_call_b}

describe "caller-owned function resolution integration":
    it "keeps each imported module's private same-named helper":
        expect(owned_call_a()).to_equal(41)
        expect(owned_call_b()).to_equal(73)
