# Run-path (JIT) probe for optional TAIL-EXPRESSION returns.
#
# WHY THIS FILE EXISTS: `bin/simple test` executes specs on the tree-walk
# INTERPRETER, which is correct here, so an ordinary spec cannot observe this
# defect at all. Only the run path (Cranelift JIT) can.
#
# DEFECT (fixed 2026-08-31): `HirStmt::Return` applied the tagged-slot
# box/unbox coercion, but an implicit TAIL-EXPRESSION return did not — even
# though `mir/lower/lowering_core.rs` turns `last_expr_value` straight into
# `Terminator::Return`. So `fn f() -> i64?: 42` returned the RAW word 42 into a
# tagged return slot and the caller decoded it through the wrong tag:
#   i64?  -> a denormal f64 (~2e-322)
#   f64?  -> bits(2.5) >> 3 = 576601489791778816
#   bool? -> nil
# `??` could not rescue any of them: silent numeric corruption.
# `return 42` was already correct, which is what pinned it to this path.
#
#   bin/simple run <this>                                   -> ALL PASS
#   SIMPLE_EXECUTION_MODE=interpreter bin/simple run <this>  -> ALL PASS (control)
#
# Tracked by doc/08_tracking/bug/jit_optional_i64_payload_reinterpreted_2026-08-17.md

use std.io_runtime.{exit}

fn tail_i64() -> i64?:
    42

fn expl_i64() -> i64?:
    return 42

fn tail_f64() -> f64?:
    2.5

fn tail_bool() -> bool?:
    true

fn tail_branch(n: i64) -> i64?:
    if n > 0:
        n * 2
    else:
        -1

fn takes_opt(x: i64?) -> i64:
    x ?? -1

# Guards the one hazard of coercing at the expression-statement site: a block
# expression's result also flows through `last_expr_value`, so a NON-tail
# statement inside an optional-returning function must NOT be boxed against
# the function's return type.
fn block_expr_local() -> i64?:
    val x: i64 = if true:
        1
    else:
        2
    x + 40

fn loop_body_local() -> i64?:
    var s: i64 = 0
    var i = 0
    while i < 3:
        s = s + i
        i = i + 1
    s + 39

# Control: same shape, RAW return slot — must be untouched by the coercion.
fn block_expr_raw_slot() -> i64:
    val y: i64 = if false:
        7
    else:
        8
    y

fn check(name: text, actual: text, expected: text, fails: i64) -> i64:
    if actual == expected:
        print("PASS " + name + " = " + actual)
        return fails
    print("FAIL " + name + " expected=" + expected + " actual=" + actual)
    return fails + 1

fn main():
    var fails = 0

    val v = tail_i64()
    fails = check("tail_i64_renders_payload", v.to_text(), "42", fails)
    fails = check("tail_i64_bang_unwrap", (v!).to_text(), "42", fails)
    fails = check("tail_i64_coalesce", (tail_i64() ?? 0).to_text(), "42", fails)
    fails = check("explicit_return_i64_still_ok", (expl_i64() ?? 0).to_text(), "42", fails)
    fails = check("tail_f64_coalesce", (tail_f64() ?? 0.0).to_text(), "2.5", fails)
    fails = check("tail_bool_coalesce", (tail_bool() ?? false).to_text(), "true", fails)
    fails = check("tail_branch_then", (tail_branch(3) ?? 0).to_text(), "6", fails)
    fails = check("tail_branch_else", (tail_branch(-3) ?? 0).to_text(), "-1", fails)
    fails = check("tail_optional_as_argument", takes_opt(tail_i64()).to_text(), "42", fails)

    val xs: [i64?] = [tail_i64(), nil]
    fails = check("tail_optional_in_collection", (xs[0] ?? 0).to_text(), "42", fails)

    fails = check("block_expr_local_not_boxed", (block_expr_local() ?? 0).to_text(), "41", fails)
    fails = check("loop_body_local_not_boxed", (loop_body_local() ?? 0).to_text(), "42", fails)
    fails = check("block_expr_raw_slot_unchanged", block_expr_raw_slot().to_text(), "8", fails)

    if fails == 0:
        print("OPTIONAL_TAIL_RETURN PROBE: ALL PASS")
        exit(0)
    print("OPTIONAL_TAIL_RETURN PROBE: " + fails.to_text() + " FAILURES")
    exit(1)

main()
