# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER

"""
# Free-function `-> any?` / `-> any` return contract

Reproducer for
`doc/08_tracking/bug/free_fn_optional_wrap_2026-06-26.md` and
`doc/08_tracking/bug/llm_caret_json_parse_nil_contract_and_any_option_wrap_2026-08-25.md`.

Before the seed fix, a free function declared `-> any?` Option-wrapped its
return value, so callers saw an enum instead of the payload
("cannot convert enum to float", `as i64` == 0) and `x == nil` was false
for a nil return. Methods with `-> any?` are covered for contrast.
"""

fn any_opt_value() -> any?:
    2.5

fn any_opt_nil() -> any?:
    nil

fn any_opt_branch(flag: bool) -> any?:
    if flag:
        return 42
    nil

struct AoHolder:
    v: f64

impl AoHolder:
    fn get(flag: bool) -> any?:
        if flag:
            return me.v
        nil

describe "free fn -> any? return contract":
    it "delivers a raw float usable in arithmetic":
        val x = any_opt_value()
        expect(x == nil).to_equal(false)
        expect(x + 0.5).to_equal(3.0)

    it "delivers nil as nil":
        val z = any_opt_nil()
        expect(z == nil).to_equal(true)

    it "branch: value leg casts as i64":
        val v = any_opt_branch(true)
        expect(v == nil).to_equal(false)
        expect(v as i64).to_equal(42)

    it "branch: nil leg compares equal to nil":
        expect(any_opt_branch(false) == nil).to_equal(true)

describe "method -> any? return contract (contrast)":
    it "delivers a raw float usable in arithmetic":
        val h = AoHolder(v: 2.5)
        val x = h.get(true)
        expect(x == nil).to_equal(false)
        expect(x + 0.5).to_equal(3.0)

    it "delivers nil as nil":
        val h = AoHolder(v: 2.5)
        expect(h.get(false) == nil).to_equal(true)
