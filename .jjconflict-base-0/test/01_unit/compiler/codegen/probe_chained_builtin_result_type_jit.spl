# Run-path probe: the STATIC RESULT TYPE of a directly-chained builtin method.
#
# Executed as a SUBPROCESS by chained_builtin_result_type_class_spec.spl under
# both engines. It must never be run as a spec: a spec body executes on the
# tree-walk interpreter, which is correct here, so the defect cannot appear.
#
# THE DEFECT (doc/08_tracking/bug/jit_substring_chained_to_int_returns_pointer_2026-08-04.md)
# `arg.substring(10).to_int()` returned the intermediate text's HEAP POINTER as
# a "successful" integer -- a large, run-varying number, exit 0, no warning, and
# `?? -1` could not rescue it because to_int() never reported failure. Binding
# the intermediate to a typed `val` first was correct, which is the tell: the
# value was fine, only the CHAINED lowering was wrong.
#
# The builtin call sites in codegen/instr/closures_structs.rs recorded the
# result VALUE (ctx.vreg_values) but never its TYPE (ctx.vreg_types). A chained
# receiver therefore arrived with no recorded type, and the numeric-cast block
# defaults a missing type to TypeId::I64 (`unwrap_or(TypeId::I64)`), so `to_int`
# skipped the `from_ty == TypeId::STRING` branch that routes to rt_string_to_int
# and fell into the generic raw-register conversion.
#
# Every oracle below is an ABSOLUTE literal. "Both engines agree" is explicitly
# NOT used -- that passes while both are wrong the same way.

var failures: i64 = 0

fn check(name: text, got: text, want: text):
    if got == want:
        print("PASS " + name)
    else:
        print("FAIL " + name + " got=[" + got + "] want=[" + want + "]")
        failures = failures + 1

fn check_i(name: text, got: i64, want: i64):
    check(name, got.to_text(), want.to_text())

fn main() -> i64:
    val arg: text = "--timeout=800"

    # --- the filed reproducer, exactly ---------------------------------------
    check_i("chained_substring_to_int", arg.substring(10).to_int() ?? -1, 800)

    # The control arm: the SAME value through a typed intermediate. This was
    # already correct, so a red here means the probe itself is broken.
    val s: text = arg.substring(10)
    check_i("via_typed_val_to_int", s.to_int() ?? -1, 800)

    # --- generalisation: the CLASS is "chained builtin result has no type" ----
    # Any text-returning builtin feeding any numeric cast is the same shape, so
    # each combination is exercised rather than just the one that was filed.
    check_i("chained_substring_to_i64", "abc900".substring(3).to_i64() ?? -1, 900)
    check_i("chained_substring_to_i32", "abc123".substring(3).to_i32() ?? -1, 123)
    check_i("chained_trim_to_int", "  77  ".trim().to_int() ?? -1, 77)
    check_i("chained_slice_to_int", "xx42".slice(2).to_int() ?? -1, 42)
    check_i("chained_replace_to_int", "1x2".replace("x", "").to_int() ?? -1, 12)

    # Text-in/text-out chains must stay TEXT, not decay to a pointer-as-int.
    check("chained_substring_to_upper", "ab-cd".substring(3).to_upper(), "CD")
    check("chained_trim_substring", "  hello  ".trim().substring(1), "ello")

    # Length/predicate builtins chained off a text-returning builtin.
    check_i("chained_substring_len", "abcdef".substring(2).len(), 4)
    check("chained_substring_starts_with", "abcdef".substring(2).starts_with("cd").to_text(), "true")
    check("chained_trim_is_empty", "   ".trim().is_empty().to_text(), "true")

    # A float cast off a chained receiver is the same defect with a different
    # destination type (it used to fcvt_from_uint the string's POINTER).
    check("chained_substring_to_float", "v=2.5".substring(2).to_float().to_text(), "2.5")

    if failures == 0:
        print("CHAINED_BUILTIN_RESULT_TYPE PROBE: ALL PASS")
    else:
        print("CHAINED_BUILTIN_RESULT_TYPE PROBE: " + failures.to_text() + " FAILURES")
    failures
