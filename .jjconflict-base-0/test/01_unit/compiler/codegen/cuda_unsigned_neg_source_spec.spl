# @cover src/compiler/70.backend/backend/cuda/ptx_builder.spl 5%
# @tag: unit, compiler, gpu, cuda, source-contract

extern fn rt_file_read_text(path: text) -> text

describe "CUDA unary source contract":
    it "validates unary types and emits legal PTX forms":
        val backend = rt_file_read_text(
            "src/compiler/70.backend/backend/cuda_backend.spl"
        ) ?? ""
        val builder = rt_file_read_text(
            "src/compiler/70.backend/backend/cuda/ptx_builder.spl"
        ) ?? ""

        expect(backend).to_contain("if dest_mir_ty.kind != operand_mir_ty.kind:")
        expect(backend).to_contain("CUDA logical Not requires a Bool operand")
        expect(backend).to_contain("case I16 | I32 | I64 | U16 | U32 | U64: ()")
        expect(backend).to_contain("builder.emit_bitnot(dest_reg, ty, src_reg)")
        expect(builder).to_contain("case U16 | U32 | U64:")
        expect(builder).to_contain("case I16 | U16: 16")
        expect(builder).to_contain("case I32 | U32: 32")
        expect(builder).to_contain("val tmp = self.alloc_reg(PrimitiveType.U16)")
        expect(builder).to_contain("setp.ne.u16")
        expect(builder).to_contain("self.emit_line(\"sub")
        expect(builder).to_contain("self.emit_line(\"neg")
        expect(builder).to_contain("self.emit_line(\"not.b")
