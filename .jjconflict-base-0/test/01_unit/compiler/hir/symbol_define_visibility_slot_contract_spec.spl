"""
## Purpose and audience
Purpose: Pin that no `symbols.define(...)` call site in HIR lowering passes a
BOOL in the `visibility: Visibility` slot. The stale-snapshot clobber
`4edef8fab8e` reverted commit `0560611bd6b` ("25 define() call sites passed a
bool where a Visibility is required — Stage-2 `compile` blocker"), and the
release branch re-pinned the reverted version; a Stage-2 binary built from
that tree fails HIR lowering of every enum-payload match with
`nested match pattern kind not supported inside an enum payload here`.
Audience: compiler engineers maintaining HIR lowering.
## Operator workflow
Run with the test runner; each scenario asserts on committed source text.
The full-tree scanner is scripts/check/check-symbol-define-visibility-arg.shs.
## Compatibility and limitations
Source-text contract on the two files the incident exercised, not behaviour;
the behavioural repro is compiling an enum-payload match with a Stage-2
binary built from the tree.
# @manual: primary
REQ-COMPILER-HIR-002
doc/01_research/local/REQ-COMPILER-HIR-002.md
doc/03_plan/sys_test/REQ-COMPILER-HIR-002.md
doc/04_architecture/REQ-COMPILER-HIR-002.md
doc/05_design/REQ-COMPILER-HIR-002.md
"""
# @req: REQ-COMPILER-HIR-002

use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}

fn spec_source(path: text) -> text:
    file_read(path)

describe("symbols.define visibility slot carries a Visibility, not a bool"):
    it("match_desugaring passes Visibility.Private at every fresh-binding define"):
        # @req: REQ-COMPILER-HIR-002
        val source = spec_source("src/compiler/20.hir/hir_lowering/_Expressions/match_desugaring.spl")
        expect(source.len() > 0).to_be_truthy()
        # The five fresh temps of the incident (0560611bd6b) all spell the
        # Visibility argument explicitly. oracle: 0 bool-in-slot sites.
        expect(source.contains("use compiler.common.dependency.visibility.\{Visibility\}")).to_be_truthy()
        expect(source.contains("SymbolKind.Variable, nil, span, false,")).to_be_falsy()
        expect(source.contains("\"__mp_enum_slot\", SymbolKind.Variable, nil, span, Visibility.Private")).to_be_truthy()
        expect(source.contains("\"__mp_scrutinee\", SymbolKind.Variable, nil, span, Visibility.Private")).to_be_truthy()
        expect(source.contains("\"__mp_nested_flat\", SymbolKind.Variable, nil, span, Visibility.Private")).to_be_truthy()
    it("statements lowering passes no bool in the visibility slot"):
        val source = spec_source("src/compiler/20.hir/hir_lowering/statements.spl")
        expect(source.len() > 0).to_be_truthy()
        expect(source.contains("use compiler.common.dependency.visibility.\{Visibility\}")).to_be_truthy()
        # oracle: 0 — the incident shape `span, false, <mut>, nil)` must not appear
        expect(source.contains(", span, false, false, nil)")).to_be_falsy()
        expect(source.contains(", span, false, true, nil)")).to_be_falsy()
        expect(source.contains(", s.span, false, true, nil)")).to_be_falsy()
        expect(source.contains(", s.span, false, false, nil)")).to_be_falsy()
        expect(source.contains(", clause.span, false, false, nil)")).to_be_falsy()
        expect(source.contains(", item.span, false, false, nil)")).to_be_falsy()
