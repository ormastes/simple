"""
# io_runtime Facade Materialization Unit Spec

Protects the canonical runtime facade shape used by compiler modules.  Runtime
operations exported from their explicit provider must retain that provider as
their HIR origin.
"""

use compiler.hir.hir_lowering.types.{hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.common.driver_core_types.{SourceFile}
use compiler.common.config.{Logger}
use std.spec.step

fn io_runtime_facade_test_logger() -> Logger:
    Logger(level: 0)

describe "io_runtime compatibility facade materialization":
    it "materializes process and environment operations through one explicit facade":
        val log = io_runtime_facade_test_logger()
        val provider_source = "pub fn env_get_nullable(key: text) -> text?:\n    nil\npub fn env_get_opt(key: text) -> text?:\n    nil\npub fn process_run(command: text) -> i64:\n    0\npub fn getpid() -> i64:\n    1\npub fn time_now_unix_micros() -> i64:\n    2\npub fn dir_create_all(path: text) -> bool:\n    true\npub fn shell(command: text) -> i64:\n    0\npub fn hash_text(value: text) -> text:\n    value"
        val facade_source = "export env_get_nullable, env_get_opt, process_run, getpid, time_now_unix_micros, dir_create_all, shell, hash_text from nogc_sync_mut.io_runtime"
        val consumer_source = "use std.io_runtime.\{env_get_nullable, env_get_opt, process_run, getpid, time_now_unix_micros, dir_create_all, shell, hash_text\}\nfn consume_runtime_facade() -> i64:\n    process_run(\"true\") + getpid() + time_now_unix_micros() + shell(\"true\")"
        val provider = parse_full_frontend(
            provider_source, "nogc_sync_mut.io_runtime", "nogc_sync_mut.io_runtime", log)
        val facade = parse_full_frontend(
            facade_source, "std.io_runtime", "std.io_runtime", log)
        val consumer = parse_full_frontend(
            consumer_source, "compiler.consumer", "compiler.consumer", log)

        var modules: Dict<text, Module> = {}
        modules["nogc_sync_mut.io_runtime"] = provider
        modules["std.io_runtime"] = facade
        val result = module_surfaces_from_modules(modules, [
            SourceFile(
                path: "nogc_sync_mut/io_runtime.spl",
                content: provider_source,
                module_name: "nogc_sync_mut.io_runtime"),
            SourceFile(
                path: "std/io_runtime.spl",
                content: facade_source,
                module_name: "std.io_runtime")
        ])
        expect(result.is_ok()).to_equal(true)
        val surfaces = result.unwrap()
        val facade_surface = surfaces.surfaces[surfaces.index_by_name["std.io_runtime"]]
        if val process_origin = facade_surface.export_origins["process_run"]:
            expect(process_origin.owner_module).to_equal("nogc_sync_mut.io_runtime")
        else:
            expect(false).to_equal(true)
        if val env_origin = facade_surface.export_origins["env_get_opt"]:
            expect(env_origin.owner_module).to_equal("nogc_sync_mut.io_runtime")
        else:
            expect(false).to_equal(true)

        var lowering = hirlowering_for_module("compiler.consumer", surfaces)
        val hir = lowering.lower_module(consumer)
        expect(lowering.errors.len()).to_equal(0)
        expect(hir.symbols.lookup("env_get_nullable") != nil).to_equal(true)
        expect(hir.symbols.lookup("env_get_opt") != nil).to_equal(true)
        expect(hir.symbols.lookup("process_run") != nil).to_equal(true)
        expect(hir.symbols.lookup("getpid") != nil).to_equal(true)
        expect(hir.symbols.lookup("time_now_unix_micros") != nil).to_equal(true)
        expect(hir.symbols.lookup("dir_create_all") != nil).to_equal(true)
        expect(hir.symbols.lookup("shell") != nil).to_equal(true)
        expect(hir.symbols.lookup("hash_text") != nil).to_equal(true)
