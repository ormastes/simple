# @tag: unit, compiler, hir, source-contract

use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}

val SOURCE = "src/compiler/20.hir/hir_lowering/expressions.spl"

describe "HIR pattern condition collection mutability":
    it "keeps all three recursive pattern collectors mutable":
        val source = file_read(SOURCE)
        expect(source.split("var conditions: [HirExpr] = []").len() - 1).to_equal(3)
        expect(source.contains("val conditions: [HirExpr] = []")).to_equal(false)
