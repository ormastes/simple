"""
Nil Dict Receiver — get() Must Be Nil (Phantom-Some Family)

Bug doc: doc/08_tracking/bug/hir_stub_module_nil_dict_get_phantom_some_2026-07-27.md

Lineage: during stage-4 bootstrap, HirLowering.register_imported_symbol operates
on a stub Module whose dict fields (e.g. `imported_const_decls`) were never
initialized — the seed NIL-FILLS omitted struct-init fields, so the field holds
nil. Under native codegen, `.get()` on that nil Dict receiver returns a phantom
non-nil Option (a "Some" wrapping garbage) while `.len()` on the SAME receiver
returns -1. Downstream code trusts the phantom Some and dereferences garbage,
which is the stage-4 bootstrap segfault lineage this spec pins.

This spec asserts the DESIRED fail-closed contract, not today's behavior:
  * `.get(key)` on a nil-dict receiver returns nil — never a phantom value
  * `.len()` and `.get()` must agree: len() <= 0 implies get() is nil

EXPECTED RED: this spec is deliberately red under native codegen until the
nil-receiver fail-closed fix lands (see bug doc above). Per repo convention for
filed defects (precedent: rv32_trap_completeness_spec.spl), it must stay
visibly red — do NOT skip() it. Interpreter semantics may differ from native
(that divergence is part of the same defect family); the spec's value is as the
native-contract pin.
"""

use std.spec

# Mirrors the compiler's stub Module shape: a struct holding a Dict field that
# is obtained in a nil state because struct construction omitted it (the seed
# nil-fills omitted struct-init fields — exactly how HirLowering hits it).
struct StubModule:
    name: text
    imported_const_decls: Dict<text, i64>

fn make_stub_module() -> StubModule:
    # `imported_const_decls` deliberately omitted -> nil-filled dict field.
    StubModule(name: "stub")

describe "nil Dict receiver contract (phantom-Some family)":
    it "nil dict receiver returns nil from get, never a phantom value":
        val m = make_stub_module()
        val got = m.imported_const_decls.get("k")
        expect(got).to_be_nil()

    it "len and get agree on a nil dict receiver: non-positive len implies nil get":
        val m = make_stub_module()
        val n = m.imported_const_decls.len()
        val got = m.imported_const_decls.get("missing")
        if n <= 0:
            # Fail-closed: a receiver that reports no (or invalid) length must
            # never hand out a value for any key.
            expect(got).to_be_nil()
        else:
            # If len() claims elements on a never-initialized dict field, the
            # nil-fill contract itself is broken — surface that as red too.
            expect(n).to_equal(0)
