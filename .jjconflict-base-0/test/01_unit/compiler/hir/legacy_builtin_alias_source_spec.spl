# @tag: unit, compiler, hir, mir, source-contract

use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}

val EXPRESSIONS = "src/compiler/20.hir/hir_lowering/expressions.spl"
val TYPES = "src/compiler/20.hir/hir_lowering/types.spl"
val CALLS = "src/compiler/50.mir/_MirLoweringExpr/switch_operators_calls.spl"

describe "legacy builtin HIR and MIR aliases":
    it "lowers text conversion and bare list through canonical owners":
        val expressions = file_read(EXPRESSIONS)
        val types = file_read(TYPES)
        val calls = file_read(CALLS)
        expect(expressions).to_contain("name == \"str\" or name == \"text\"")
        expect(types).to_contain(
            "case \"list\": HirTypeKind.Array(HirType(kind: HirTypeKind.Any, span: span), nil)")
        expect(calls).to_contain(
            "if (direct_name == \"str\" or direct_name == \"text\") and args.len() == 1:")
