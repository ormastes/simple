# @tag: unit, compiler, hir, gpu, source-contract
use std.spec.*
use std.io_runtime.{read_file_text}

fn gpu_source(path: text) -> text:
    read_file_text(path)

describe "canonical HIR GPU statement integration source contract":
    it "keeps append-only rich HIR shapes and explicit initializer presence":
        val definitions = gpu_source("src/compiler/20.hir/hir_definitions.spl")
        expect(definitions).to_contain("SharedVal(symbol: SymbolId, type_: HirType, has_init: bool, init: HirExpr)")
        expect(definitions).to_contain("SharedVar(symbol: SymbolId, type_: HirType, has_init: bool, init: HirExpr)")
        expect(definitions).to_contain("GpuLaunch(config: HirGpuLaunchConfig, body: HirBlock)")
        expect(definitions).to_contain("struct HirGpuLaunchConfig:")
        expect(definitions).to_contain("grid: [HirExpr]\n    block: [HirExpr]\n    span: Span")

    it "lowers valid rich statements and rejects malformed launch dimensions":
        val lowering = gpu_source("src/compiler/20.hir/hir_lowering/statements.spl")
        expect(lowering).to_contain("if sk_disc == HIR_STMT_SHARED_VAL_TAG or sk_disc == HIR_STMT_SHARED_VAR_TAG:")
        expect(lowering).to_contain("HirStmtKind.SharedVal(shared_symbol, shared_hir_type, shared_has_init, shared_hir_init)")
        expect(lowering).to_contain("HirStmtKind.SharedVar(shared_symbol, shared_hir_type, shared_has_init, shared_hir_init)")
        expect(lowering).to_contain("if sk_disc == HIR_STMT_GPU_LAUNCH_TAG:")
        expect(lowering).to_contain("grid_count < 1 or grid_count > 3 or block_count < 1 or block_count > 3")
        expect(lowering).to_contain("HirGpuLaunchConfig(grid: hir_grid, block: hir_block, span: launch_config.span)")

    it "retains source order and diagnostics through flat parser assembly":
        val parser = gpu_source("src/compiler/10.frontend/core/parser_stmts.spl")
        val bridge = gpu_source("src/compiler/10.frontend/_FlatAstBridge/convert_nodes.spl")
        expect(parser).to_contain("gpu_launch config requires a 'grid' argument")
        expect(parser).to_contain("gpu_launch config requires a 'block' argument")
        expect(parser).to_contain("stmt_gpu_launch(grid_exprs, block_exprs, body, launch_span)")
        expect(bridge).to_contain("StmtKind.GpuLaunch(config, body)")
        expect(bridge).not_to_contain("Lane C2: this arm EXISTS but is a silent no-op")

    it "covers every generated HIR consumer and uses appended codec tags":
        val generated = [
            "src/compiler/20.hir/generated/hir_children.spl",
            "src/compiler/20.hir/generated/hir_hash.spl",
            "src/compiler/20.hir/generated/hir_visit.spl",
            "src/compiler/20.hir/generated/hir_visitor.spl"
        ]
        for path in generated:
            val source = gpu_source(path)
            expect(source).to_contain("SharedVal(")
            expect(source).to_contain("SharedVar(")
            expect(source).to_contain("GpuLaunch(")
        val codec = gpu_source("src/compiler/20.hir/generated/hir_codec.spl")
        expect(codec).to_contain("fn hc_enc_hir_gpu_launch_config")
        expect(codec).to_contain("fn hc_dec_hir_gpu_launch_config")
        expect(codec).to_contain("case SharedVal(")
        expect(codec).to_contain("w.put_i64(5)")
        expect(codec).to_contain("case SharedVar(")
        expect(codec).to_contain("w.put_i64(6)")
        expect(codec).to_contain("case GpuLaunch(")
        expect(codec).to_contain("w.put_i64(7)")

    it "uses scalar destination rows without aggregate transport":
        val schema = gpu_source("src/compiler/20.hir/hir_lowering/hir_destination_statement_schema.spl")
        val writer = gpu_source("src/compiler/20.hir/hir_lowering/hir_destination_registry_writer.spl")
        val reader = gpu_source("src/compiler/20.hir/hir_lowering/hir_destination_registry_reader.spl")
        expect(schema).to_contain("HD_STMT_SHARED_VAL: i64 = 2006")
        expect(schema).to_contain("HD_STMT_SHARED_VAR: i64 = 2007")
        expect(schema).to_contain("HD_STMT_GPU_LAUNCH: i64 = 2008")
        expect(writer).to_contain("hdw_stmt_shared_val, hdw_stmt_shared_var")
        expect(writer).to_contain("hdw_stmt_gpu_launch")
        expect(reader).to_contain("hdr_stmt_i64, hdr_stmt_bool, hdr_stmt_span")

    it "walks semantic payloads and publishes typed MIR launch data":
        val semantic_paths = [
            "src/compiler/35.semantics/any_escape/checker.spl",
            "src/compiler/35.semantics/resolve.spl",
            "src/compiler/35.semantics/safety_checker.spl",
            "src/compiler/35.semantics/safety_checker_transfer.spl",
            "src/compiler/35.semantics/visibility_integration.spl",
            "src/compiler/40.mono/monomorphize/hir_subst/body_subst.spl"
        ]
        for path in semantic_paths:
            val source = gpu_source(path)
            expect(source).to_contain("SharedVal(")
            expect(source).to_contain("SharedVar(")
            expect(source).to_contain("GpuLaunch(")
        val kinds = gpu_source("src/compiler/50.mir/mir_instruction_kinds.spl")
        val mir = gpu_source("src/compiler/50.mir/mir_lowering_stmts.spl")
        expect(kinds).to_contain("GpuLaunchConfigured(grid: [MirOperand], block: [MirOperand], body: BlockId)")
        expect(kinds).to_contain("GpuSharedAllocInit(dest: LocalId, type_: MirType, size: i64, init: MirOperand)")
        expect(mir).to_contain("if stmt_disc == HIR_STMT_SHARED_VAL_TAG:")
        expect(mir).to_contain("if stmt_disc == HIR_STMT_SHARED_VAR_TAG:")
        expect(mir).to_contain("if stmt_disc == HIR_STMT_GPU_LAUNCH_TAG:")
        expect(mir).to_contain("MirInstKind.GpuLaunchConfigured(grid_operands, block_operands, body_block)")
        expect(mir).to_contain("MirInstKind.GpuSharedAllocInit(shared_local, element_type,")
        expect(mir).not_to_contain("MirInstKind.GpuLaunch([")
