# `@layer(NAME)` module tagging (M1 of doc/03_plan/compiler/forwarding/
# zero_cost_layers_c0_c5_staged_implementation_plan_2026-08-07.md).
#
# @cover src/compiler/10.frontend/core/_ParserDecls/enum_module_body.spl
# @cover src/compiler/10.frontend/_FlatAstBridge/module_assembly.spl
# @cover src/compiler/10.frontend/parser_types.spl
#
# Exercises the self-hosted frontend directly via parse_and_build_module,
# same in-process verification method as layer_decl_parse_spec.spl (M0's
# own spec) -- bin/simple currently resolves to the Rust seed, which never
# reads src/compiler/10.frontend/ at all, so this is the only way to observe
# this parser code running.
#
# Scope: M1 parses `@layer(NAME)` on a module, records the tag on
# ParserModule.tagged_layer, and validates NAME refers to a layer actually
# declared via M0's `layer NAME` mechanism somewhere in the same module.
# The same-layer/downward CALL-DIRECTION check that consumes this fact is
# explicitly out of scope here (separate call-edge-tracking effort).
#
# `@layer(...)` reuses the SAME generic `@name(args)` decorator dispatch in
# enum_module_body.spl that already parses @derive/@gpu/@unsafe/etc over the
# flat-arena token stream (par_kind_get()/par_text_get()) -- NOT the
# disjoint tree-based AttributeParser in parser_extensions.spl, whose only
# caller is the LSP/outline path (treesitter/outline.spl) and which operates
# on a completely different Token/Expr representation the real compile
# pipeline never touches.

use compiler.frontend.flat_ast_bridge.{parse_and_build_module}
use compiler.frontend.core.parser.{parser_has_errors, parser_get_errors}

describe "@layer(NAME) module tagging":
    it "tags a module with a previously-declared layer, no errors":
        val source = "layer gui\n\n@layer(gui)\n\nfn main() -> i64:\n    0\n"
        val module = parse_and_build_module(source, "layer_tag_ok.spl")

        expect(parser_has_errors()).to_equal(false)
        expect(module.tagged_layer).to_equal("gui")
        expect(module.functions.contains("main")).to_equal(true)

    it "tags a module with a layer declared later in the same file, no errors":
        # Validation runs once after the whole decl loop, so source order
        # between the `@layer(...)` tag and the `layer NAME` decl it refers
        # to must not matter.
        val source = "@layer(gui)\n\nlayer gui\n\nfn main() -> i64:\n    0\n"
        val module = parse_and_build_module(source, "layer_tag_order.spl")

        expect(parser_has_errors()).to_equal(false)
        expect(module.tagged_layer).to_equal("gui")

    it "is inert: no stray constant/decl is emitted for the marker":
        val source = "layer gui\n\n@layer(gui)\n\nfn main() -> i64:\n    0\n"
        val module = parse_and_build_module(source, "layer_tag_inert.spl")

        expect(parser_has_errors()).to_equal(false)
        expect(module.constants.contains("_expr_layer_tag_0")).to_equal(false)

    it "leaves untagged modules with an empty tagged_layer":
        val source = "fn main() -> i64:\n    0\n"
        val module = parse_and_build_module(source, "layer_tag_absent.spl")

        expect(parser_has_errors()).to_equal(false)
        expect(module.tagged_layer).to_equal("")

    it "sabotage: rejects @layer(NAME) when NAME was never declared":
        val source = "@layer(nonexistent)\n\nfn main() -> i64:\n    0\n"
        val module = parse_and_build_module(source, "layer_tag_unknown.spl")

        expect(parser_has_errors()).to_equal(true)
        val errors = parser_get_errors()
        var found_layer_dag_error = false
        for e in errors:
            if e.contains("layer_dag"):
                found_layer_dag_error = true
        expect(found_layer_dag_error).to_equal(true)

    it "sabotage: rejects a bare '@layer()' with no name argument":
        val source = "layer gui\n\n@layer()\n\nfn main() -> i64:\n    0\n"
        val module = parse_and_build_module(source, "layer_tag_empty_args.spl")

        expect(parser_has_errors()).to_equal(true)

    it "does not regress: ordinary decorators (@derive) still parse alongside a layer tag":
        val source = "layer gui\n\n@layer(gui)\n\n@derive(Eq)\nstruct Point:\n    x: i64\n    y: i64\n\nfn main() -> i64:\n    0\n"
        val module = parse_and_build_module(source, "layer_tag_broader_regression.spl")

        expect(parser_has_errors()).to_equal(false)
        expect(module.tagged_layer).to_equal("gui")
        expect(module.structs.contains("Point")).to_equal(true)
        expect(module.functions.contains("main")).to_equal(true)
