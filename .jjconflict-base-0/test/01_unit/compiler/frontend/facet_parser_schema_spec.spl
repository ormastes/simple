"""Focused typed-facet grammar and explicit method-generic transport regressions."""

use std.spec.*
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.core.parser.{parser_has_errors}
use compiler.core.parser_decls.{parser_set_aspect_context, parser_clear_aspect_context}
use compiler.frontend.parser_types_expr.{ExprKind, StmtKind, TypeKind}

describe "typed facet parser schema":
    it "parses all four facet declaration families into distinct module collections":
        step("Parse a versioned aspect with interface, implementation, binding, and requirement")
        val source = "aspect telemetry:\n" +
            "    facet interface Readable<T>:\n" +
            "        fn read(self) -> T\n" +
            "    facet impl FileReadable<T>:\n" +
            "        for File<T>\n" +
            "        implements Readable<T>\n" +
            "        inspect readonly:\n" +
            "        fn read(self) -> T:\n" +
            "            self.value\n" +
            "    bind facet Readable<i64> to pc{type File} using FileReadable<i64> nominal_static priority 7 provider disk\n" +
            "    require facet Readable<i64> on pc{type File}\n"
        parser_set_aspect_context("telemetry", 3,
            "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
        val module = parse_full_frontend(source, "facet_valid.spl", "facet_valid", Logger(level: 0))
        parser_clear_aspect_context()
        expect(parser_has_errors()).to_equal(false)
        expect(module.facet_interfaces.len()).to_equal(1)
        expect(module.facet_impls.len()).to_equal(1)
        expect(module.facet_bindings.len()).to_equal(1)
        expect(module.facet_requirements.len()).to_equal(1)
        expect(module.facet_interfaces[0].aspect_id).to_equal("telemetry")
        expect(module.facet_interfaces[0].aspect_version).to_equal(3)
        expect(module.facet_bindings[0].priority).to_equal(7)
        expect(module.facet_bindings[0].provider_id).to_equal("disk")

    it "rejects a facet aspect without admitted manifest identity":
        step("Parse an otherwise valid facet declaration without manifest context")
        val source = "aspect broken:\n" +
            "    facet interface Readable:\n" +
            "        fn read(self) -> i64\n"
        parser_clear_aspect_context()
        val module = parse_full_frontend(source, "facet_malformed.spl", "facet_malformed", Logger(level: 0))
        expect(parser_has_errors()).to_equal(true)
        expect(module.name).to_equal("facet_malformed")

    it "recovers once from a malformed implementation header":
        step("Reject missing implementation clauses without looping")
        val source = "aspect broken:\n" +
            "    facet impl Missing:\n" +
            "        fn read(self) -> i64:\n" +
            "            0\n"
        parser_set_aspect_context("broken", 1,
            "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")
        val module = parse_full_frontend(source, "facet_bad_impl.spl", "facet_bad_impl", Logger(level: 0))
        parser_clear_aspect_context()
        expect(parser_has_errors()).to_equal(true)
        expect(module.facet_impls.len()).to_be_less_than(2)

describe "generic method call token restoration":
    it "preserves nested closing angles as two method type arguments":
        step("Parse obj.convert<List<Pair<i64, text>>, Result<i64, text>>()")
        val source = "fn probe(obj):\n" +
            "    obj.convert<List<Pair<i64, text>>, Result<i64, text>>()\n"
        val module = parse_full_frontend(source, "method_nested_generics.spl", "method_nested_generics", Logger(level: 0))
        expect(parser_has_errors()).to_equal(false)
        val stmt = module.functions["probe"].body.stmts[0]
        match stmt.kind:
            case StmtKind.Expr(expr):
                expect(expr.type_args.len()).to_equal(2)
                match expr.kind:
                    case ExprKind.MethodCall(_, method, _): expect(method).to_equal("convert")
                    case _: expect("kind").to_equal("method-call")
            case _: expect("stmt").to_equal("expression")

    it "restores comparison tokens after rejected generic speculation":
        step("Parse a method call followed by less-than and greater-than comparisons")
        val source = "fn probe(obj, a: i64, b: i64) -> bool:\n" +
            "    obj.size() < a and b > obj.limit()\n"
        val module = parse_full_frontend(source, "method_comparison_restore.spl", "method_comparison_restore", Logger(level: 0))
        expect(parser_has_errors()).to_equal(false)
        expect(module.functions.contains("probe")).to_equal(true)
