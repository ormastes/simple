use std.test.{describe, it, expect}
use std.fs.{read_file}

describe "formula entry closure has explicit canonical owners":
    it "imports every called math bridge wrapper from its physical owner":
        val formula = read_file("src/app/office/sheets/formula.spl") ?? ""
        val bridge = read_file("src/app/office/sheets/math_bridge.spl") ?? ""
        val names = [
            "excel_sin", "excel_cos", "excel_tan", "excel_atan",
            "excel_asin", "excel_acos", "excel_sinh", "excel_cosh",
            "excel_tanh", "excel_log", "excel_log10", "excel_exp",
            "excel_ln", "excel_atan2", "excel_var_p", "excel_stdev_p",
            "excel_trunc", "excel_floor", "excel_ceiling",
            "excel_standardize"
        ]
        val exact_import = """use app.office.sheets.math_bridge.{
    excel_sin, excel_cos, excel_tan, excel_atan, excel_asin, excel_acos,
    excel_sinh, excel_cosh, excel_tanh, excel_log, excel_log10, excel_exp,
    excel_ln, excel_atan2, excel_var_p, excel_stdev_p, excel_trunc,
    excel_floor, excel_ceiling, excel_standardize
}"""
        expect(formula).to_contain(exact_import)
        for name in names:
            expect(bridge).to_contain("pub fn {name}")

    it "uses the canonical sample variance API":
        val bridge = read_file("src/app/office/sheets/math_bridge.spl") ?? ""
        expect(bridge).to_contain("var_sample(values)")
        expect(bridge.contains("variance_sample")).to_be(false)

    it "retains real implementations for every restored dispatch surface":
        val formula = read_file("src/app/office/sheets/formula.spl") ?? ""
        val helpers = [
            "_array_groupby", "_array_pivotby", "_bit_op", "_fin_pmt",
            "_fin_ipmt", "_fin_rate", "_fin_irr", "_fin_mirr", "_fin_db",
            "_fin_ddb", "_forecast_ets_decompose",
            "_forecast_ets_seasonality_strength", "_intl_is_weekend",
            "_is_nonneg_int", "_iso_weekday", "_is_weekday", "_pow2_i64",
            "_time_total_seconds", "_eval_getpivotdata"
        ]
        for helper in helpers:
            expect(formula).to_contain("fn {helper}")

    it "keeps dispatch scalar means from shadowing the statistics owner":
        val formula = read_file("src/app/office/sheets/formula.spl") ?? ""
        expect(formula.contains("val mean = mean_sum / flat.len().to_f64()")).to_be(false)
        expect(formula.contains("val mean = _first_val(args[1])")).to_be(false)
        expect(formula).to_contain("val average_value = mean_sum / flat.len().to_f64()")
        expect(formula).to_contain("val normal_mean = _first_val(args[1])")
        expect(formula).to_contain("val inverse_mean = _first_val(args[1])")
        expect(formula).to_contain("val lognormal_mean = _first_val(args[1])")
        expect(formula).to_contain("val standardize_mean = _first_val(args[1])")
        expect(formula).to_contain("mean(args[0]) - slope * mean(args[1])")
        expect(formula).to_contain("mean(args[1]) - slope * mean(args[2])")
