"""
# Contract spec: test/01_unit/compiler/bootstrap/loader_metadata_helpers_contract_spec.spl

## Purpose and Audience

Audience: engineers owning the pinned repository sources. Purpose: keep the pinned observable
contracts red-visible, so a regression in the owned code fails this spec
instead of shipping silently.

## Scope and Preconditions

Precondition: the repository working tree holds the subject code under test.
Each scenario exercises the subject and asserts its observable contract; no
behavior outside the named subject is claimed.

## Primary Workflow

Run the scenarios; each one drives the subject through its pinned contract
and asserts the expected observable outcome with an executed oracle.

## Unsupported / Limitations

Only the pinned contracts are asserted here; end-to-end and integration
behavior of the surrounding system is covered by companion specs.

## Verification and Recovery

A red scenario names the contract that regressed. Recover by restoring the
pinned behavior in the subject; verify with
`bin/simple test test/01_unit/compiler/bootstrap/loader_metadata_helpers_contract_spec.spl` and a green Results line.
"""

use std.spec
use std.io_runtime.{file_read}

describe "loader metadata helper types":
    it "keeps shared metadata dictionaries explicit for JIT lowering":
        # @req REQ-SSPEC-COMPILER
        val source = file_read("src/compiler/99.loader/metadata_symbols.spl")
        val unload = file_read("src/compiler/99.loader/unload_ownership.spl")
        val jit = file_read("src/compiler/99.loader/jit_instantiator.spl")
        val loader = file_read("src/compiler/99.loader/module_loader.spl")

        expect(source).to_contain("loaded_metadata: Dict<text, LoadedMetadata>")
        expect(source).to_contain(") -> Dict<text, LoadedMetadata>:")
        expect(unload).to_contain("global_symbols: Dict<text, (text, T)>")
        expect(unload).to_contain(") -> Dict<text, (text, T)>:")
        expect(jit).to_contain("jit_cache: Dict<text, JitCacheRecord>")
        expect(jit).to_contain("JitCacheRecord(code: compiled, address: address, owner: owner_id)")
        expect(loader).to_contain("rec_cache: JitCacheRecord")
        expect(loader).to_not_contain("rec_cache[\"code\"]")        expect(loader).to_contain("me moduleloader_load(self: ModuleLoader")
        expect(loader).to_contain("me moduleloader_record_semantic_fingerprint(self: ModuleLoader")
        expect(loader).to_contain("me moduleloader_invalidate_semantic_change(self: ModuleLoader")
