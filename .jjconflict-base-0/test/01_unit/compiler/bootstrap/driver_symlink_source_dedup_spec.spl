extern fn rt_dir_create(path: text, recursive: bool) -> bool
extern fn rt_dir_remove_all(path: text) -> bool
extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_package_create_symlink(target: text, link_path: text) -> i32

use compiler.common.driver_core_types.{SourceFile}
use compiler.driver.driver_source_loading.{_driver_unique_physical_sources}

describe "driver symlink source dedup":
    it "collapses a symlink-reachable physical file to one parse source":
        """`src/compiler/backend` is a symlink to `70.backend`, so the same
        physical file is reachable under two lexically-different paths. The
        phase-2 parse plan must register it once, not once per alias."""
        val fixture = "/tmp/simple-driver-symlink-source-dedup"
        val real_dir = fixture + "/real"
        expect(rt_dir_create(real_dir, true)).to_be(true)
        val real_path = real_dir + "/shared.spl"
        val link_path = fixture + "/shared_via_link.spl"
        expect(rt_file_write_text(real_path, "fn shared() -> i64: 1\n")).to_be(true)

        val symlink_status = rt_package_create_symlink(real_path, link_path)
        if symlink_status != 0:
            print("SKIP: symlink creation unavailable on this platform/sandbox (status={symlink_status}) -- symlink dedup is untested by this case")
            expect(true).to_equal(true)
        else:
            val sources = [
                SourceFile(path: real_path, content: "", module_name: "fixture.real.shared"),
                SourceFile(path: link_path, content: "", module_name: "fixture.link.shared")
            ]
            expect(_driver_unique_physical_sources(sources).len()).to_equal(1)

        expect(rt_dir_remove_all(fixture)).to_be(true)
