# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/compiler/parser/dangerous_comment_grammar_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/dangerous_comment_grammar_spec.md
# doc-path: doc/03_plan/sys_test/dangerous_comment_grammar_spec.md
# doc-path: doc/04_architecture/dangerous_comment_grammar_spec.md
# doc-path: doc/05_design/dangerous_comment_grammar_spec_oracles.md
# @manual: primary

"""
# Dangerous Comment Grammar Parser Coverage
"""
use std.spec.step

use compiler.core.parser.{parser_init, parser_warnings_get}
use compiler.core.parser_stmts.{parse_statement}
use compiler.core.ast.{expr_get_tag, expr_get_str, stmt_get_expr, EXPR_PASS_TODO}
use compiler.core.ast.{stmt_get_body, arm_get_pattern, arm_get_rationale}


describe "dangerous comment grammar parser":
    # @manual scenario evidence
    it "parses pass_todo with what-remains and hint strings":
        # @req REQ-SSPEC-COMPILER
        step("parses pass_todo with what-remains and hint strings")
        parser_init("pass_todo(\"implement retry backoff\", \"tracked by SIMPLE-123\")")
        val stmt = parse_statement()
        val expr = stmt_get_expr(stmt)
        expect(expr_get_tag(expr)).to_equal(EXPR_PASS_TODO)
        expect(expr_get_str(expr)).to_contain("implement retry backoff")
        expect(expr_get_str(expr)).to_contain("tracked by SIMPLE-123")

    it "warns for bare pass_todo":
        # @req REQ-SSPEC-COMPILER
        step("warns for bare pass_todo")
        parser_init("pass_todo")
        parse_statement()
        val warnings = parser_warnings_get()
        expect(warnings.len()).to_be_greater_than(0)
        expect(warnings[0]).to_contain("REQC001")

    it "parses todo as a pass_todo placeholder expression":
        # @req REQ-SSPEC-COMPILER
        step("parses todo as a pass_todo placeholder expression")
        parser_init("todo(\"implement retry backoff\", \"tracked by SIMPLE-123\")")
        val stmt = parse_statement()
        val expr = stmt_get_expr(stmt)
        expect(expr_get_tag(expr)).to_equal(EXPR_PASS_TODO)
        expect(expr_get_str(expr)).to_contain("implement retry backoff")
        expect(expr_get_str(expr)).to_contain("tracked by SIMPLE-123")

    it "parses wildcard arm rationale metadata":
        # @req REQ-SSPEC-COMPILER
        step("parses wildcard arm rationale metadata")
        parser_init("match value:\n    case _(\"all remaining values share fallback\"):\n        pass_do_nothing(\"fallback has no side effects\")\n")
        val stmt = parse_statement()
        val arms = stmt_get_body(stmt)
        expect(arms.len()).to_equal(1)
        expect(expr_get_str(arm_get_pattern(arms[0]))).to_equal("_")
        expect(arm_get_rationale(arms[0])).to_contain("all remaining values")
