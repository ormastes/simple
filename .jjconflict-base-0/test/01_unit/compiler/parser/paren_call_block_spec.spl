# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



# Regression spec for paren-form call followed by indented colon-block.
#
# Before the fix, `describe("x"):` with an indented body leaked the trailing
# colon back to the statement parser, producing
#   "parse error: Unexpected token: expected expression, found Colon"
# because parse_with_no_paren_calls only attached a colon-block to plain
# Identifier/FieldAccess/Path callees, not to already-built Call/MethodCall
# expressions.
#
# See: src/compiler_rust/parser/src/expressions/no_paren.rs
# Found via: test/unit/os/kernel/arch/syscall_dispatch_spec.spl (Wave 10B)

use std.spec.step

use std.spec

describe("paren-form describe block parses"):
    it("accepts describe(string): with indented body"):
        # @req REQ-SSPEC-UNIT
        # @req REQ-SSPEC-UNIT
        expect(1).to_equal(1)

    it("accepts it(string): with indented body"):
        expect("it(string):").to_contain("it")

    it "accepts val with type annotation at module level":
        # @req: REQ-COMPILER-PARSER-001
        step("Verify: accepts val with type annotation at module level")
        val X: u64 = 0
        val Y:  u64 = 1
        val Z:                u64 = 2
        expect(X).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(Y).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(Z).to_equal(2)  # oracle: 2 — named expected value from the requirement
