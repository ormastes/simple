"""Live ModuleLoader segment transaction and rollback coverage."""

use compiler.backend.linker.smf_writer.{
    DataSectionKind, RelocationType, SmfRelocation, SmfWriter,
    SmfWriterSymbol, SmfWriterSymbolBinding, SmfWriterSymbolType
}
use compiler.loader.module_loader_compat.{LoadResult, ModuleLoader}
use compiler.loader.smf_mmap_native.{native_mmap_read_bytes}
use std.io_runtime.{file_write_bytes, mkdir_p}
use std.spec.{describe, it}

fn _txn_path(tag: text) -> text:
    "build/test/module_loader_segment_transaction_{tag}.smf"

fn _txn_code() -> [i64]:
    var bytes: [i64] = []
    var i = 0i64
    while i < 16:
        bytes.push(0)
        i = i + 1
    bytes

fn _txn_symbol(name: text, section_index: i64, value: i64, ty: SmfWriterSymbolType) -> SmfWriterSymbol:
    SmfWriterSymbol(
        name: name,
        binding: SmfWriterSymbolBinding.Global,
        sym_type: ty,
        section_index: section_index,
        value: value,
        size: 8,
        layout_phase: 0,
        is_event_loop_anchor: false,
        layout_pinned: false)

fn _txn_to_u8(bytes: [i64]) -> [u8]:
    var out: [u8] = []
    for byte in bytes:
        out.push(byte as u8)
    out

fn _txn_i64_le(value: i64) -> [u8]:
    var out: [u8] = []
    var shift = 0i64
    while shift < 64:
        out.push(((value >> shift) & 0xFF) as u8)
        shift = shift + 8
    out

fn _write_relocation_fixture(tag: text, offset: i64, addend: i64) -> text:
    var writer = SmfWriter.create()
    _ = writer.add_code_section("code", _txn_code())
    _ = writer.add_symbol(_txn_symbol("target_{tag}", 0, 0, SmfWriterSymbolType.Function))
    _ = writer.add_symbol(_txn_symbol("patch_{tag}", 0, 8, SmfWriterSymbolType.Function))
    writer.add_relocation(SmfRelocation(
        offset: offset,
        symbol_index: 0,
        reloc_type: RelocationType.Abs64,
        addend: addend))
    val image_result = writer.write()
    val image = image_result.unwrap()
    val _ = mkdir_p("build/test")
    val path = _txn_path(tag)
    expect(file_write_bytes(path, _txn_to_u8(image))).to_equal(true)
    path

describe "live ModuleLoader segment transaction":
    it "maps one section, applies its relocation once, seals, and publishes":
        val path = _write_relocation_fixture("success", 8, 0)
        var loader = ModuleLoader.with_defaults()
        match loader.load(path):
            case LoadResult.Success(module):
                val target = module.symbols["target_success"]
                val patch = module.symbols["patch_success"]
                expect(patch.address).to_equal(target.address + 8)
                expect(native_mmap_read_bytes(target.address, 8, 8)).to_equal(_txn_i64_le(target.address))
                val stats = loader.segment_mapper.stats()
                expect(stats.segment_count).to_equal(1)
                expect(stats.mapping_calls).to_equal(1)
                expect(stats.symbol_count).to_equal(2)
                expect(stats.protection_transitions).to_equal(1)
            case LoadResult.Error(message):
                fail("transactional segment load failed: {message}")
            case _:
                fail("unexpected load result")

        loader.unload(path)
        expect(loader.segment_mapper.stats().segment_count).to_equal(0)
        expect(loader.global_symbols.has("target_success")).to_equal(false)
        expect(loader.modules.has(path)).to_equal(false)

    it "rejects relocation range errors before mapping or publication":
        val path = _write_relocation_fixture("range", 12, 0)
        var loader = ModuleLoader.with_defaults()
        match loader.load(path):
            case LoadResult.Error(message):
                expect(message.contains("escapes executable section")).to_equal(true)
            case _:
                fail("out-of-range relocation was accepted")
        val stats = loader.segment_mapper.stats()
        expect(stats.mapping_calls).to_equal(0)
        expect(stats.segment_count).to_equal(0)
        expect(loader.global_symbols.keys().len()).to_equal(0)
        expect(loader.modules.has(path)).to_equal(false)

    it "binds non-relocated multi-Code symbols to their encoded owner sections":
        var writer = SmfWriter.create()
        _ = writer.add_code_section("owner_a", _txn_code())
        _ = writer.add_code_section("owner_b", _txn_code())
        _ = writer.add_symbol(_txn_symbol("owned_a", 0, 0, SmfWriterSymbolType.Function))
        _ = writer.add_symbol(_txn_symbol("owned_b", 1, 0, SmfWriterSymbolType.Function))
        val path = _txn_path("owners")
        val _ = mkdir_p("build/test")
        val image_result = writer.write()
        val image = image_result.unwrap()
        expect(file_write_bytes(path, _txn_to_u8(image))).to_equal(true)

        var loader = ModuleLoader.with_defaults()
        match loader.load(path):
            case LoadResult.Success(module):
                expect(module.symbols["owned_a"].address).to_equal(
                    loader.segment_mapper.segment_base(path, 0))
                expect(module.symbols["owned_b"].address).to_equal(
                    loader.segment_mapper.segment_base(path, 1))
                val stats = loader.segment_mapper.stats()
                expect(stats.segment_count).to_equal(2)
                expect(stats.mapping_calls).to_equal(2)
                expect(stats.protection_transitions).to_equal(2)
            case LoadResult.Error(message):
                fail("multi-Code owner load failed: {message}")
            case _:
                fail("unexpected multi-Code load result")

        loader.unload(path)
        expect(loader.segment_mapper.stats().segment_count).to_equal(0)
        expect(loader.modules.has(path)).to_equal(false)

    it "rejects ambiguous multi-Code-section relocation ownership before mapping":
        var writer = SmfWriter.create()
        _ = writer.add_code_section("code_a", _txn_code())
        _ = writer.add_code_section("code_b", _txn_code())
        _ = writer.add_symbol(_txn_symbol("multi_target", 0, 0, SmfWriterSymbolType.Function))
        _ = writer.add_symbol(_txn_symbol("multi_patch", 1, 8, SmfWriterSymbolType.Function))
        writer.add_relocation(SmfRelocation(
            offset: 8,
            symbol_index: 0,
            reloc_type: RelocationType.Abs64,
            addend: 0))
        val path = _txn_path("ambiguous")
        val _ = mkdir_p("build/test")
        val image_result = writer.write()
        val image = image_result.unwrap()
        expect(file_write_bytes(path, _txn_to_u8(image))).to_equal(true)

        var loader = ModuleLoader.with_defaults()
        match loader.load(path):
            case LoadResult.Error(message):
                expect(message.contains("target section is ambiguous")).to_equal(true)
            case _:
                fail("multi-section relocation without a target-section field was accepted")
        expect(loader.segment_mapper.stats().mapping_calls).to_equal(0)
        expect(loader.global_symbols.keys().len()).to_equal(0)
        expect(loader.modules.has(path)).to_equal(false)

    it "rolls back mapped ownership when address-dependent patch planning fails":
        val path = _write_relocation_fixture("overflow", 8, 0x7FFFFFFFFFFFFFFF)
        var loader = ModuleLoader.with_defaults()
        match loader.load(path):
            case LoadResult.Error(message):
                expect(message.contains("overflow")).to_equal(true)
            case _:
                fail("overflowing relocation was accepted")
        val stats = loader.segment_mapper.stats()
        expect(stats.mapping_calls).to_equal(1)
        expect(stats.segment_count).to_equal(0)
        expect(stats.symbol_count).to_equal(0)
        expect(stats.bytes_mapped).to_equal(0)
        expect(loader.global_symbols.keys().len()).to_equal(0)
        expect(loader.modules.has(path)).to_equal(false)

    it "rejects data exports instead of mapping them executable":
        var writer = SmfWriter.create()
        _ = writer.add_code_section("code", _txn_code())
        _ = writer.add_data_section("data", _txn_code(), DataSectionKind.Mutable)
        _ = writer.add_symbol(_txn_symbol("code_export", 0, 0, SmfWriterSymbolType.Function))
        _ = writer.add_symbol(_txn_symbol("data_export", 1, 0, SmfWriterSymbolType.Object))
        writer.add_relocation(SmfRelocation(
            offset: 8,
            symbol_index: 0,
            reloc_type: RelocationType.Abs64,
            addend: 0))
        val path = _txn_path("data")
        val _ = mkdir_p("build/test")
        val image_result = writer.write()
        val image = image_result.unwrap()
        expect(file_write_bytes(path, _txn_to_u8(image))).to_equal(true)

        var loader = ModuleLoader.with_defaults()
        match loader.load(path):
            case LoadResult.Error(message):
                expect(message.contains("non-function symbol")).to_equal(true)
            case _:
                fail("data export was mapped as executable code")
        expect(loader.segment_mapper.stats().mapping_calls).to_equal(0)
        expect(loader.global_symbols.keys().len()).to_equal(0)
        expect(loader.modules.has(path)).to_equal(false)
