# @cover src/compiler/99.loader/completeness_seal/admission.spl 80%
"""
# Completeness-seal admission linear flattening

Admission preserves extension and operation encounter order while flattening a
candidate into the immutable registry payload. The private flattening path uses
amortized-linear array accumulation and computes each extension identity prefix
once, without changing public output bytes or cardinality.
"""

use std.spec.*
use std.io_runtime.{file_read}
use compiler.loader.completeness_seal.manifest.{ExtensionManifest}
use compiler.loader.completeness_seal.admission.{
    AdmissionCandidate,
    AdmissionProfile,
    admit_module
}
use compiler.loader.completeness_seal.seal.{CompletenessSeal}
use compiler.common.dynamic_identity.dense_tag_map.{DenseTagMap}

fn extension(provider: text, constructor: text, ops: [text], handlers: [text]) -> ExtensionManifest:
    ExtensionManifest(
        owner_enum: "HirNode",
        constructor: constructor,
        closure: "complete",
        payload_schema_hash: "payload-v1",
        module_abi_hash: "module-v1",
        required_core_abi_hash: "core-v1",
        provider_module: provider,
        local_ordinal: 1,
        schema_abi_version: 1,
        provided_ops: ops,
        provided_handlers: handlers,
        transition: nil
    )

fn empty_seal(hash: text) -> CompletenessSeal:
    CompletenessSeal(
        tags: DenseTagMap(entries: [], static_count: 0, sealed_count: 0, seal_hash: hash),
        module_ids: [],
        canonical_lines: [],
        seal_hash: hash
    )

describe "completeness-seal admission linear flattening":
    it "preserves exact extension, operation, and handler encounter order":
        val hash = "COMPLETESEALV1-linear-flatten"
        val cand = AdmissionCandidate(
            module_id: "late_provider",
            expects_seal_hash: hash,
            extensions: [
                extension("provider.alpha", "Alpha",
                    ["verify", "type_check", "effects", "visit_children", "lower_mir", "print", "hash", "serialize"],
                    ["alpha.verify", "alpha.type", "alpha.effects", "alpha.visit", "alpha.lower", "alpha.print", "alpha.hash", "alpha.serialize"]),
                extension("provider.beta", "Beta",
                    ["serialize", "hash", "print", "lower_mir", "visit_children", "effects", "type_check", "verify"],
                    ["beta.serialize", "beta.hash", "beta.print", "beta.lower", "beta.visit", "beta.effects", "beta.type", "beta.verify"])
            ],
            modules: []
        )
        match admit_module(empty_seal(hash), cand, AdmissionProfile(critical: true)):
            case Err(_):
                assert_true(false)
            case Ok(admitted):
                assert_equal(admitted.identities.len(), 2)
                assert_equal(admitted.identities[0].constructor_name, "Alpha")
                assert_equal(admitted.identities[1].constructor_name, "Beta")
                assert_equal(admitted.op_keys.len(), 16)
                val alpha_key = "SimpleVariantIdentityV1|owner_enum:7:HirNode|provider_module:14:provider.alpha|constructor_name:5:Alpha|local_ordinal:1|schema_abi_version:1"
                val beta_key = "SimpleVariantIdentityV1|owner_enum:7:HirNode|provider_module:13:provider.beta|constructor_name:4:Beta|local_ordinal:1|schema_abi_version:1"
                assert_equal(admitted.op_keys[0], alpha_key + "#verify")
                assert_equal(admitted.op_keys[7], alpha_key + "#serialize")
                assert_equal(admitted.op_keys[8], beta_key + "#serialize")
                assert_equal(admitted.op_keys[15], beta_key + "#verify")
                assert_equal(admitted.op_handlers[0], "alpha.verify")
                assert_equal(admitted.op_handlers[7], "alpha.serialize")
                assert_equal(admitted.op_handlers[8], "beta.serialize")
                assert_equal(admitted.op_handlers[15], "beta.verify")

    it "pins amortized-linear accumulation and one identity-key computation per extension":
        val source = file_read("src/compiler/99.loader/completeness_seal/admission.spl")
        val begin = source.index_of("fn _admission_flatten(")
        val finish = source.index_of("# The §13.1 admission gate", begin)
        assert_true(begin >= 0 and finish > begin)
        val body = source.substring(begin, finish)
        assert_equal(body.count("ids.push(id)"), 1)
        assert_equal(body.count("keys.push(identity_key + \"#\" + ext.provided_ops[i])"), 1)
        assert_equal(body.count("handlers.push(ext.provided_handlers[i])"), 1)
        assert_equal(body.count("val identity_key = _identity_key(id)"), 1)
        assert_equal(body.count("ids = ids + ["), 0)
        assert_equal(body.count("keys = keys + ["), 0)
        assert_equal(body.count("handlers = handlers + ["), 0)
        assert_equal(body.count("_identity_key(id) + \"#\""), 0)
