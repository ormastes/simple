"""Regression coverage for the flat SegmentMapper.clear teardown index."""

use std.spec.{describe, it, expect}
use std.io_runtime.read_file_text
use compiler.loader.segment_mapper.{
    SegmentMapper, MappedSegment, SegmentSymbol
}

var _clear_mock_calls: [i64] = []
var _clear_mock_failure: i64 = -1

fn _clear_mock_free(address: i64, size: i64) -> bool:
    _clear_mock_calls = _clear_mock_calls + [address]
    address != _clear_mock_failure and size > 0

fn _clear_mock_reset(failure: i64):
    _clear_mock_calls = []
    _clear_mock_failure = failure

fn _mapped(owner: text, section: i32, address: i64, size: i64) -> MappedSegment:
    MappedSegment(
        owner_id: owner,
        section_index: section,
        base: address,
        size: size,
        alignment: 16,
        symbol_count: 0,
        protected_executable: true)

fn _symbol(name: text, owner: text, address: i64) -> SegmentSymbol:
    SegmentSymbol(
        name: name,
        owner_id: owner,
        section_index: 0,
        offset: 0,
        size: 1,
        address: address)

describe "SegmentMapper.clear flat owner adjacency":
    it "is a no-op for an empty mapper":
        _clear_mock_reset(-1)
        var mapper = SegmentMapper.new()
        mapper._clear_with(_clear_mock_free)
        expect(_clear_mock_calls.len()).to_equal(0)
        expect(mapper.stats().segment_count).to_equal(0)
        expect(mapper.stats().symbol_count).to_equal(0)

    it "preserves first-seen owner grouping and per-owner key order":
        _clear_mock_reset(-1)
        var mapper = SegmentMapper.new()
        # Interleaved insertion plus duplicate owner A.  Historical clear
        # groups A first (101, 103), then B (102).
        mapper.segments["a0"] = _mapped("A", 0, 101, 10)
        mapper.segments["b0"] = _mapped("B", 0, 102, 20)
        mapper.segments["a1"] = _mapped("A", 1, 103, 30)
        mapper.bytes_mapped = 60

        mapper._clear_with(_clear_mock_free)

        expect(_clear_mock_calls).to_equal([101, 103, 102])
        expect(mapper.stats().segment_count).to_equal(0)
        expect(mapper.stats().bytes_mapped).to_equal(0)

    it "retains failed segments but removes symbols for every seen owner":
        _clear_mock_reset(103)
        var mapper = SegmentMapper.new()
        mapper.segments["a0"] = _mapped("A", 0, 101, 10)
        mapper.segments["b0"] = _mapped("B", 0, 102, 20)
        mapper.segments["a1"] = _mapped("A", 1, 103, 30)
        mapper.symbols["a"] = _symbol("a", "A", 101)
        mapper.symbols["b"] = _symbol("b", "B", 102)
        mapper.symbols["orphan"] = _symbol("orphan", "ORPHAN", 999)
        mapper.bytes_mapped = 60
        mapper.generation = 7

        mapper._clear_with(_clear_mock_free)

        expect(_clear_mock_calls).to_equal([101, 103, 102])
        expect(mapper.stats().segment_count).to_equal(1)
        expect(mapper.stats().bytes_mapped).to_equal(30)
        expect(mapper.lookup("a") == nil).to_equal(true)
        expect(mapper.lookup("b") == nil).to_equal(true)
        expect(mapper.lookup("orphan") != nil).to_equal(true)
        expect(mapper.stats().generation).to_equal(7)

    it "keeps the implementation flat and avoids per-owner unmap rescans":
        val source = read_file_text("src/compiler/99.loader/segment_mapper.spl")
        val clear_source = source.split("    fn stats()")[0].split("    me clear():")[1]
        expect(clear_source).to_contain("var owner_index: Dict<text, i64> = {}")
        expect(clear_source).to_contain("var next_key: [i64] = []")
        expect(clear_source).to_contain("val symbol_names = self.symbols.keys()")
        expect(clear_source.contains("var owner_keys: Dict<text, [text]> = {}"))
            .to_equal(false)
        expect(clear_source.contains("self.unmap_owner(owner)")).to_equal(false)
