# RED(phase3): explicit narrowing must discard the high 32 bits before compare.

extern fn rt_alloc(size: i64) -> i64
extern fn rt_free(ptr: i64)
extern fn rt_ptr_read_i64(addr: i64, offset: i64) -> i64
extern fn rt_ptr_write_i64(addr: i64, offset: i64, value: i64) -> i64

fn main() -> i64:
    val address = rt_alloc(8)
    if address == 0:
        return 2
    rt_ptr_write_i64(address, 0, 0x12345678ff102030)
    val wide = rt_ptr_read_i64(address, 0)
    val narrow = wide as u32
    rt_free(address)
    if narrow != 0xff102030u32:
        return 1
    0
