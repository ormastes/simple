# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec.{describe, it, expect}
use compiler.driver.incremental.{IncrementalState}


describe "IncrementalState.add_dependency edge bookkeeping":
    # @manual scenario evidence
    it "records both the forward dependency and the reverse dependent":
        # @req REQ-SSPEC-COMPILER
        step("records both the forward dependency and the reverse dependent")
        var state = IncrementalState.create()
        state.add_dependency("a.spl", "b.spl")

        expect(state.dependencies["a.spl"]).to_equal(["b.spl"])
        expect(state.dependents["b.spl"]).to_equal(["a.spl"])

    it "does not duplicate an edge added twice":
        # @req REQ-SSPEC-COMPILER
        step("does not duplicate an edge added twice")
        var state = IncrementalState.create()
        state.add_dependency("a.spl", "b.spl")
        state.add_dependency("a.spl", "b.spl")

        expect(state.dependencies["a.spl"].len()).to_equal(1)
        expect(state.dependents["b.spl"].len()).to_equal(1)

    it "cascades dirty marks through the recorded dependents":
        # @req REQ-SSPEC-COMPILER
        step("cascades dirty marks through the recorded dependents")
        var state = IncrementalState.create()
        state.add_dependency("a.spl", "b.spl")
        state.mark_dirty("b.spl")

        expect(state.is_dirty("a.spl")).to_equal(true)
        expect(state.is_dirty("b.spl")).to_equal(true)
