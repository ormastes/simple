use std.io_runtime.{file_read}

use std.spec.step

describe "native module cache cross-revision root":
    it "reaches stable objects only through the complete module witness":
        step("keeps closure fingerprint as comparison metadata, not a directory partition")
        val source = file_read(
            "src/compiler/80.driver/driver_aot_native_output.spl")
        expect(source).to_contain("val cache_scope_root = base_cache_scope_root")
        expect(source.contains(
            "_sffi_path_join(base_cache_scope_root, \"sources-" + "{" +
                "sources_fingerprint}\")")).to_be(false)
        expect(source).to_contain(
            "val cached_outputs = if (source_snapshot_matches and\n                    witness_reason == \"match\"):")
        expect(source).to_contain(
            "decision-authority=per-module-complete-witness")
        expect(source).to_contain(
            "closure-comparison-only=" + "{" + "sources_fingerprint}")
        expect(source).to_contain(
            "provider_identity: if provider_receipt_hash != \"\"")
        expect(source).to_contain(
            "native_external_layout_facts_from_mir_v1(module, true)")
