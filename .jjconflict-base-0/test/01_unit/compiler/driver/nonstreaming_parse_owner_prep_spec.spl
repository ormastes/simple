use std.spec
use std.io_runtime.{file_read}

val SOURCE_PARSING = "src/compiler/80.driver/driver_source_pipeline_parsing.spl"
val BOOTSTRAP_MAIN = "src/app/cli/bootstrap_main.spl"

describe "non-streaming compiler frontend owner preparation":
    it "prepares persistent frontend shells before the first ordinary parse":
        val source = file_read(SOURCE_PARSING)
        val start = source.index_of("me parse_all_impl() -> (CompileContext, bool):")
        val finish = source.index_of("fn parse_source(source: SourceFile)", start)
        val body = source.substring(start, finish)
        val prepare = body.index_of("frontend_prepare_transient_parse_scope()")
        val compilation_reset = body.index_of("facet_static_begin_compilation()")
        val first_parse = body.index_of("parse_full_frontend(")
        expect(start).to_be_greater_than(0)
        expect(finish).to_be_greater_than(start)
        expect(prepare).to_be_greater_than(0)
        expect(compilation_reset).to_be_greater_than(prepare)
        expect(first_parse).to_be_greater_than(compilation_reset)

    it "covers both Stage 2 in-process CLI compile routes":
        val cli = file_read(BOOTSTRAP_MAIN)
        val native_start = cli.index_of("pub fn run_native_build_bootstrap")
        val native_finish = cli.index_of("fn bootstrap_compile_option_takes_value", native_start)
        val native_body = cli.substring(native_start, native_finish)
        val smf_start = cli.index_of("fn run_compile_bootstrap")
        val smf_finish = cli.index_of("fn get_cli_args", smf_start)
        val smf_body = cli.substring(smf_start, smf_finish)
        expect(native_start).to_be_greater_than(0)
        expect(native_body).to_contain("compiler_driver_create(options)")
        expect(smf_start).to_be_greater_than(native_finish)
        expect(smf_body).to_contain("compiler_driver_create(options)")

    it "deduplicates nonstream HIR evidence by canonical dense physical owner":
        val source = file_read(
            "src/compiler/80.driver/driver_hir_pipeline_lowering.spl")
        val start = source.index_of(
            "me lower_and_check_impl() -> (CompileContext, bool):")
        val body = source.substring(start, source.len())
        expect(body).to_contain(
            "var nonstream_hir_by_physical: Dict<i64, HirModule> = {}")
        expect(body).to_contain(
            "nonstream_surface_index_by_path[evidence_path]")
        expect(body).to_contain(
            "nonstream_state_by_physical[evidence_physical_index]")
        expect(body).to_contain(
            "\"hir-file-start\", evidence_physical_index, evidence_path")
