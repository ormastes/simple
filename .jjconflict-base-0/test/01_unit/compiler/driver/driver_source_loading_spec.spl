use std.spec.*
use compiler.driver.driver_source_loading.{_driver_collect_entry_import_source, _driver_collect_sources, _driver_module_aliases, _driver_resolve_entry_import}

extern fn rt_env_get(key: text) -> text
extern fn rt_env_set(key: text, value: text) -> bool
extern fn rt_path_absolute(path: text) -> text

describe "driver source module aliases":
    it "admits only the exact absolute native entry inside an excluded bulk tree":
        val key = "SIMPLE_NATIVE_BUILD_ENTRY"
        val old_entry = rt_env_get(key) ?? ""
        val relative = "test/fixtures/compiler/type_multiline_signature_valid.spl"
        val absolute = rt_path_absolute(relative)

        val _cleared = rt_env_set(key, "")
        val bulk_filtered = _driver_collect_sources(absolute)
        val _mismatched = rt_env_set(key, absolute + ".other.spl")
        val mismatched_filtered = _driver_collect_sources(absolute)
        val _selected = rt_env_set(key, absolute)
        val explicitly_selected = _driver_collect_sources(absolute)
        val _restored = rt_env_set(key, old_entry)

        expect(bulk_filtered.len()).to_equal(0)
        expect(mismatched_filtered.len()).to_equal(0)
        expect(explicitly_selected.len()).to_be_greater_than(0)
        expect(explicitly_selected[0].path).to_equal(absolute)

    it "keeps explicitly imported application doc modules in entry closure":
        val sources = _driver_collect_entry_import_source("src/app/doc/public_check/statistics.spl")
        expect(sources.len()).to_be_greater_than(0)
        expect(sources[0].module_name).to_equal("app.doc.public_check.statistics")

    it "keeps physical lib identity without colliding with std mirrors":
        val aliases = _driver_module_aliases(
            "src/lib/gc_async_mut/gpu/engine2d/simd_native_rows.spl",
            "fn marker(): pass",
            "lib.gc_async_mut.gpu.engine2d.simd_native_rows"
        )

        expect(aliases.len()).to_equal(1)
        expect(aliases[0].module_name).to_equal("lib.gc_async_mut.gpu.engine2d.simd_native_rows")

    it "resolves bare memory-family imports through the canonical lib root":
        expect(_driver_resolve_entry_import("nogc_sync_mut.path", "src/std/nogc_sync_mut")).to_equal(
            "src/lib/nogc_sync_mut/path.spl"
        )
        expect(_driver_resolve_entry_import("nogc_sync_mut.target_ext", "src/std/nogc_sync_mut")).to_equal(
            "src/lib/nogc_sync_mut/target_ext.spl"
        )
        expect(_driver_resolve_entry_import("std.nogc_sync_mut.path", "src/std/nogc_sync_mut")).to_equal(
            "src/std/nogc_sync_mut/path.spl"
        )

    it "keeps the canonical test runner despite test helper filtering":
        val sources = _driver_collect_sources("src/app/cli/test_entry.spl")
        expect(sources.len()).to_equal(1)
        expect(sources[0].path).to_equal("src/app/cli/test_entry.spl")
        expect(sources[0].module_name).to_equal("app.cli.test_entry")

        val cli_sources = _driver_collect_sources("src/app/cli")
        var found = 0
        for source in cli_sources:
            if source.path.ends_with("/src/app/cli/test_entry.spl") or source.path == "src/app/cli/test_entry.spl":
                found = found + 1
        expect(found).to_equal(1)

    it "resolves dotted imports into src/app dot-named directories directly":
        # Regression for the stage-4 native-build collision: without an
        # explicit rewrite, a dotted `use app.ui.web.html.{...}` import used
        # to fall through the trailing-segment-strip fallback all the way to
        # the unrelated src/app/ui/__init__.spl package file, producing a
        # bogus SourceFile alias whose module_name collided with the real
        # src/app/ui.web/html.spl file discovered by bulk source collection.
        # See doc/08_tracking/bug/dot_dir_entry_import_fallback_collision_2026-07-24.md
        expect(_driver_resolve_entry_import("app.ui.web.html", "src/app/ui.tauri")).to_equal(
            "src/app/ui.web/html.spl"
        )
        expect(_driver_resolve_entry_import("app.ui.chromium.acid2", "src/app/ui")).to_equal(
            "src/app/ui.chromium.acid2/__init__.spl"
        )
        expect(_driver_resolve_entry_import("app.package.registry.signing", "src/app/publish")).to_equal(
            "src/app/package.registry/signing.spl"
        )
