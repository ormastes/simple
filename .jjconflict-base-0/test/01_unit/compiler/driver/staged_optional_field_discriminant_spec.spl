"""
# Staged Optional Field Discriminants

Requires targeted HIR-to-MIR receipts for the two optional fields that lose
their type identity during Stage 3 bootstrap.
"""

extern fn rt_file_read_text(path: text) -> text

describe "Staged Optional Field Discriminants":
    it "records actual field discriminants without constructing synthetic optionals":
        val hir_source = rt_file_read_text(
            "src/compiler/20.hir/hir_lowering/_Items/declaration_lowering.spl") ?? ""
        val mir_source = rt_file_read_text(
            "src/compiler/50.mir/_MirLowering/module_lowering.spl") ?? ""
        expect(hir_source).to_contain("[hir-field-type] struct={{struct_name}}")
        expect(hir_source).to_contain("val actual_disc = rt_enum_discriminant(lowered_field.type_.kind)")
        expect(hir_source.contains("HirTypeKind.Optional(lowered_field.type_)")).to_be(false)
        expect(mir_source).to_contain("[mir-field-type] struct={{struct_def.name}}")
        expect(mir_source).to_contain("val actual_disc = rt_enum_discriminant(hir_field.type_.kind)")
        expect(mir_source.contains("HirTypeKind.Optional(hir_field.type_)")).to_be(false)
