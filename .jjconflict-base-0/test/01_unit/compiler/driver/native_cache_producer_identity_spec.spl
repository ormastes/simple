use std.spec
use compiler.driver.driver_build.incremental.{native_build_producer_identity}

describe "native cache producer identity":
    it "binds executable compiler runtime and bundle authorities":
        val baseline = native_build_producer_identity(
            "exe-a", "compiler-a", "runtime-a", "hosted")
        expect(native_build_producer_identity(
            "exe-b", "compiler-a", "runtime-a", "hosted") == baseline).to_equal(false)
        expect(native_build_producer_identity(
            "exe-a", "compiler-b", "runtime-a", "hosted") == baseline).to_equal(false)
        expect(native_build_producer_identity(
            "exe-a", "compiler-a", "runtime-b", "hosted") == baseline).to_equal(false)
        expect(native_build_producer_identity(
            "exe-a", "compiler-a", "runtime-a", "stage4") == baseline).to_equal(false)

    it "is stable when every producer authority is unchanged":
        val first = native_build_producer_identity(
            "exe-a", "compiler-a", "runtime-a", "hosted")
        val second = native_build_producer_identity(
            "exe-a", "compiler-a", "runtime-a", "hosted")
        expect(second).to_equal(first)
