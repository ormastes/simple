use std.spec
use std.nogc_sync_mut.io.file_ops.{file_read}

describe "driver core types split contract":
    it "keeps a small compatibility facade and focused direct owners":
        val facade = file_read("src/compiler/00.common/driver_core_types.spl")
        val fixed = file_read("src/compiler/80.driver/bootstrap_api_fixed.spl")
        val focused = file_read("src/app/cli/bootstrap_focused_native_build.spl")
        expect(facade).to_contain("driver_core_modes")
        expect(facade).to_contain("driver_compile_options")
        expect(facade).to_contain("driver_compile_result")
        expect(facade).to_contain("driver_source_file")
        expect(facade.len()).to_be_less_than(2000)
        expect(fixed).to_contain("compiler.common.driver_compile_options")
        expect(focused).to_contain("compiler.common.driver_compile_result")
