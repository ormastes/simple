use std.spec
use std.nogc_sync_mut.io.file_ops.{file_read}

describe "focused AOT lazy interpreter contract":
    it "keeps interpreter-only driver edges lazy":
        val driver = file_read("src/compiler/80.driver/driver.spl")
        val types = file_read("src/compiler/80.driver/driver_types.spl")
        val lazy_import = "use lazy compiler.backend.backend.interpreter."
        expect(driver).to_contain(lazy_import)
        expect(types).to_contain(lazy_import)
        expect(driver).to_contain("InterpreterBackendImpl")
        expect(types).to_contain("InterpreterBackendImpl")
