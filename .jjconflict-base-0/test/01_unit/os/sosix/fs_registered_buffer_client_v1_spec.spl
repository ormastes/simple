# @cover src/os/sosix/fs/registered_buffer_client_v1.spl 80%
"""SOSIX FS v1 registered-buffer client specification."""

use std.spec.*
use os.sosix.core.operation.SosixOperationId
use os.sosix.core.capability_ref.{SosixCapabilityRef, SosixBufferRef}
use os.sosix.fs.operation_adapter.SOSIX_FS_READ_AT
use os.sosix.fs.registered_buffer_client_v1.*

fn endpoints() -> SosixFsClientEndpointInputV1:
    SosixFsClientEndpointInputV1(
        service_discovered: true, service_endpoint: 70,
        reply_endpoint_created: true, reply_endpoint: 71)

fn receipt(buffer: SosixBufferRef, byte_length: u64, access: u32) -> SosixFsClientRegistrationReceiptV1:
    SosixFsClientRegistrationReceiptV1(
        authenticated: true, owner_process_id: 9, service_endpoint: 70,
        buffer: buffer, service_registration_id: 81,
        byte_length: byte_length, access: access,
        memory_mode: SOSIX_FS_CLIENT_MEMORY_OWNED_COPY_V1)

describe "SOSIX FS v1 registered-buffer client":
    it "owns registrations and advances generation before slot reuse":
        val empty = sosix_fs_client_buffer_table_v1(9)
        val first = sosix_fs_client_register_buffer_v1(
            empty, 9, [1u8, 2u8, 3u8], SOSIX_FS_CLIENT_BUFFER_WRITE_V1)
        expect(first.accepted).to_be(true)
        expect(first.ref_.generation).to_equal(1)
        expect(first.table.entries[0].bytes.len()).to_equal(3)

        val removed = sosix_fs_client_unregister_buffer_v1(first.table, 9, first.ref_)
        expect(removed.accepted).to_be(true)
        expect(removed.table.entries[0].bytes.len()).to_equal(0)
        val second = sosix_fs_client_register_buffer_v1(
            removed.table, 9, [4u8], SOSIX_FS_CLIENT_BUFFER_WRITE_V1)
        expect(second.ref_.slot).to_equal(first.ref_.slot)
        expect(second.ref_.generation).to_equal(2)

    it "rejects stale references and owner substitution":
        val first = sosix_fs_client_register_buffer_v1(
            sosix_fs_client_buffer_table_v1(9), 9, [1u8],
            SOSIX_FS_CLIENT_BUFFER_READ_V1)
        val wrong_owner = sosix_fs_client_unregister_buffer_v1(first.table, 10, first.ref_)
        expect(wrong_owner.accepted).to_be(false)
        expect(wrong_owner.reason).to_equal("buffer-owner-mismatch")
        val removed = sosix_fs_client_unregister_buffer_v1(first.table, 9, first.ref_)
        val stale = sosix_fs_client_unregister_buffer_v1(removed.table, 9, first.ref_)
        expect(stale.accepted).to_be(false)
        expect(stale.reason).to_equal("stale-buffer-ref")

    it "fails closed when a non-canonical public table reaches lifecycle or dispatch":
        val bad_ref = SosixBufferRef(slot: 7, generation: 0)
        val corrupt = SosixFsClientBufferTableV1(
            owner_process_id: 9,
            entries: [SosixFsClientBufferEntryV1(
                active: false, ref_: bad_ref, owner_process_id: 9,
                access: SOSIX_FS_CLIENT_BUFFER_WRITE_V1, bytes: [1u8])])
        val registration = sosix_fs_client_register_buffer_v1(
            corrupt, 9, [2u8], SOSIX_FS_CLIENT_BUFFER_WRITE_V1)
        expect(registration.accepted).to_be(false)
        expect(registration.reason).to_equal("buffer-table-corrupt")
        expect(registration.table.entries[0].ref_.slot).to_equal(7)

        val removal = sosix_fs_client_unregister_buffer_v1(corrupt, 9, bad_ref)
        expect(removal.accepted).to_be(false)
        expect(removal.reason).to_equal("buffer-table-corrupt")

        val plan = sosix_fs_client_plan_owned_submission_v1(
            corrupt, 9, endpoints(), receipt(
                bad_ref, 1, SOSIX_FS_CLIENT_BUFFER_WRITE_V1),
            SosixOperationId(slot: 2, generation: 3), SOSIX_FS_READ_AT,
            SosixCapabilityRef(slot: 5, generation: 6), bad_ref,
            0, 0, 1, 0, 17)
        expect(plan.accepted).to_be(false)
        expect(plan.reason).to_equal("buffer-table-corrupt")
        expect(plan.status).to_equal(-5)

    it "plans a pointer-free owned-copy syscall 132 payload":
        val registered = sosix_fs_client_register_buffer_v1(
            sosix_fs_client_buffer_table_v1(9), 9, [1u8, 2u8, 3u8],
            SOSIX_FS_CLIENT_BUFFER_WRITE_V1)
        val plan = sosix_fs_client_plan_owned_submission_v1(
            registered.table, 9, endpoints(), receipt(
                registered.ref_, 3, SOSIX_FS_CLIENT_BUFFER_WRITE_V1),
            SosixOperationId(slot: 2, generation: 3), SOSIX_FS_READ_AT,
            SosixCapabilityRef(slot: 5, generation: 6), registered.ref_,
            0, 0, 3, 0, 17)
        expect(plan.accepted).to_be(true)
        expect(plan.reason).to_equal("ready")
        expect(plan.service_endpoint).to_equal(70)
        expect(plan.reply_endpoint).to_equal(71)
        expect(plan.payload.len()).to_equal(88)

    it "requires caller-created reply and discovered service endpoints":
        val registered = sosix_fs_client_register_buffer_v1(
            sosix_fs_client_buffer_table_v1(9), 9, [1u8],
            SOSIX_FS_CLIENT_BUFFER_WRITE_V1)
        val missing = SosixFsClientEndpointInputV1(
            service_discovered: false, service_endpoint: 0,
            reply_endpoint_created: false, reply_endpoint: 0)
        val plan = sosix_fs_client_plan_owned_submission_v1(
            registered.table, 9, missing, receipt(
                registered.ref_, 1, SOSIX_FS_CLIENT_BUFFER_WRITE_V1),
            SosixOperationId(slot: 2, generation: 3), SOSIX_FS_READ_AT,
            SosixCapabilityRef(slot: 5, generation: 6), registered.ref_,
            0, 0, 1, 0, 17)
        expect(plan.accepted).to_be(false)
        expect(plan.reason).to_equal("service-not-discovered")

    it "requires authenticated service registration and operation access":
        val registered = sosix_fs_client_register_buffer_v1(
            sosix_fs_client_buffer_table_v1(9), 9, [1u8],
            SOSIX_FS_CLIENT_BUFFER_READ_V1)
        val unconfirmed = SosixFsClientRegistrationReceiptV1(
            authenticated: false, owner_process_id: 9, service_endpoint: 70,
            buffer: registered.ref_, service_registration_id: 81,
            byte_length: 1, access: SOSIX_FS_CLIENT_BUFFER_READ_V1,
            memory_mode: SOSIX_FS_CLIENT_MEMORY_OWNED_COPY_V1)
        val denied_receipt = sosix_fs_client_plan_owned_submission_v1(
            registered.table, 9, endpoints(), unconfirmed,
            SosixOperationId(slot: 2, generation: 3), SOSIX_FS_READ_AT,
            SosixCapabilityRef(slot: 5, generation: 6), registered.ref_,
            0, 0, 1, 0, 17)
        expect(denied_receipt.accepted).to_be(false)
        expect(denied_receipt.reason).to_equal("service-registration-unconfirmed")
        val denied_access = sosix_fs_client_plan_owned_submission_v1(
            registered.table, 9, endpoints(), receipt(
                registered.ref_, 1, SOSIX_FS_CLIENT_BUFFER_READ_V1),
            SosixOperationId(slot: 2, generation: 3), SOSIX_FS_READ_AT,
            SosixCapabilityRef(slot: 5, generation: 6), registered.ref_,
            0, 0, 1, 0, 17)
        expect(denied_access.accepted).to_be(false)
        expect(denied_access.reason).to_equal("buffer-access-denied")

    it "does not report success for a rejected submission plan":
        val rejected = SosixFsClientOwnedSubmissionV1(
            accepted: false, reason: "not-ready", status: -22,
            service_endpoint: 0, reply_endpoint: 0, api_id: 0, payload: [])
        val result = sosix_fs_client_execute_owned_v1(rejected)
        expect(result.accepted).to_be(false)
        expect(result.reason).to_equal("submission-not-ready")

    it "does not dispatch a forged accepted submission plan":
        val forged = SosixFsClientOwnedSubmissionV1(
            accepted: true, reason: "ready", status: 0,
            service_endpoint: 0, reply_endpoint: 71,
            api_id: SOSIX_FS_READ_AT, payload: [1u8])
        val result = sosix_fs_client_execute_owned_v1(forged)
        expect(result.accepted).to_be(false)
        expect(result.reason).to_equal("submission-plan-corrupt")
        expect(result.status).to_equal(-22)
