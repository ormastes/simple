use os.drivers.audio.hda_dma_resources.{
    HDA_DMA_CORB,
    HDA_DMA_RIRB,
    HDA_DMA_BDL,
    HDA_DMA_PCM,
    hda_dma_resource_size,
    hda_dma_resources_create,
    hda_dma_resources_destroy,
    hda_dma_resource_handle,
    hda_dma_resource_virt,
    hda_dma_resource_phys,
    hda_dma_prepare_silent_stream,
}

extern fn rt_hda_dma_probe_reset(fail_call: i64)
extern fn rt_hda_dma_probe_live_count() -> i64
extern fn rt_ptr_read_i64(addr: i64, offset: i64) -> i64

fn main() -> i64:
    rt_hda_dma_probe_reset(0)
    val resources = hda_dma_resources_create()
    if resources == 0 or rt_hda_dma_probe_live_count() != 4:
        return 1
    if (hda_dma_resource_size(HDA_DMA_CORB) != 1024 or
        hda_dma_resource_size(HDA_DMA_RIRB) != 2048 or
        hda_dma_resource_size(HDA_DMA_BDL) != 64 or
        hda_dma_resource_size(HDA_DMA_PCM) != 16384):
        return 2
    var kind: i64 = HDA_DMA_CORB
    while kind <= HDA_DMA_PCM:
        if (hda_dma_resource_handle(resources, kind) < 0 or
            hda_dma_resource_virt(resources, kind) == 0 or
            hda_dma_resource_phys(resources, kind) == 0 or
            (hda_dma_resource_phys(resources, kind) & 127) != 0):
            return 3
        kind = kind + 1
    if (hda_dma_resource_handle(resources, 4) != -1 or
        hda_dma_resource_size(4) != 0):
        return 4
    if not hda_dma_prepare_silent_stream(resources):
        return 7
    val bdl = hda_dma_resource_virt(resources, HDA_DMA_BDL)
    val pcm_phys = hda_dma_resource_phys(resources, HDA_DMA_PCM)
    val ioc_period = (1 << 32) | 4096
    if (rt_ptr_read_i64(bdl, 0) != pcm_phys or
        rt_ptr_read_i64(bdl, 8) != ioc_period or
        rt_ptr_read_i64(bdl, 48) != pcm_phys + 12288):
        return 8
    hda_dma_resources_destroy(resources)
    if rt_hda_dma_probe_live_count() != 0:
        return 5
    rt_hda_dma_probe_reset(3)
    if hda_dma_resources_create() != 0 or
        rt_hda_dma_probe_live_count() != 0:
        return 6
    return 0
