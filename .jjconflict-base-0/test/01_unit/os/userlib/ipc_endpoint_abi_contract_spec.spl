use std.spec.{describe, it, expect}

describe "named IPC user ABI contract":
    it "passes an exact text pointer and length to create/connect syscalls":
        val source = file_read("src/os/userlib/ipc_endpoint.spl")
        expect(source).to_contain("rt_string_data(name) as u64, name.len() as u64")
        expect(source).to_contain("IPC_CREATE_PORT: u64 = 22u64")
        expect(source).to_contain("IPC_CONNECT: u64 = 23u64")

    it "rejects anonymous or oversized names before entering the kernel":
        val source = file_read("src/os/userlib/ipc_endpoint.spl")
        expect(source).to_contain("name.len() > 0 and name.len() <= IPC_ENDPOINT_NAME_MAX_BYTES")

    it "uses the bounded copied-payload ABI rather than legacy metadata IPC":
        val source = file_read("src/os/userlib/ipc_endpoint.spl")
        expect(source).to_contain("IPC_SEND_OWNED_V1: u64 = 132u64")
        expect(source).to_contain("IPC_RECV_OWNED_V1: u64 = 133u64")
        expect(source).to_contain("payload.ptr() as u64")
        expect(source).to_contain("IPC_OWNED_V1_HEADER_BYTES + IPC_OWNED_V1_MAX_PAYLOAD_BYTES")
        expect(source).to_contain("pub fn ipc_recv_owned_v1_into")
