use std.io_runtime.{read_file_text}
use std.spec

describe "DBFS retained staged-tree materializer v1 source contract":
    it "streams each retained file once in bounded positioned chunks":
        val source = read_file_text(
            "src/os/installer/dbfs_staged_tree_materializer_v1.spl")
        expect(source).to_contain(
            "remaining < DBFS_STREAM_INGEST_MAX_CHUNK_BYTES")
        expect(source).to_contain(
            "provider.read_file(provider_lease, offset, count)")
        expect(source).to_contain(
            "driver.stream_ingest_append(")
        expect(source.contains("read_file_text(entry.relative_path)")).to_equal(false)
        expect(source.contains("var payload: [u8]")).to_equal(false)

    it "binds the private DBFS reservation to retained SHA and exact path":
        val source = read_file_text(
            "src/os/installer/dbfs_staged_tree_materializer_v1.spl")
        expect(source).to_contain("val exact_path = \"/\" + entry.relative_path")
        expect(source).to_contain(
            "streamed_sha.unwrap() != entry.provider_digest_sha256")
        expect(source).to_contain("provider.finish_file(")
        expect(source).to_contain("driver.stream_ingest_finish_outcome_v1(")
        expect(source).to_contain(
            "ingest_lease, entry.provider_digest_sha256")

    it "aborts private state on pre-publication failures":
        val source = read_file_text(
            "src/os/installer/dbfs_staged_tree_materializer_v1.spl")
        expect(source).to_contain("driver.stream_ingest_abort(ingest_lease)")
        expect(source).to_contain("provider.abort_file(provider_lease)")
        expect(source).to_contain("published: false")

    it "uses authoritative publication outcomes and never aborts ambiguity":
        val source = read_file_text(
            "src/os/installer/dbfs_staged_tree_materializer_v1.spl")
        val ingest = read_file_text(
            "src/lib/nogc_sync_mut/db/dbfs_driver/streaming_ingest.spl")
        expect(ingest).to_contain("enum DbfsPublicationStateV1")
        expect(ingest).to_contain("NotPublished")
        expect(ingest).to_contain("Published")
        expect(ingest).to_contain("Indeterminate")
        expect(ingest).to_contain("dbfs-stream-published-bookkeeping-failed")
        expect(source).to_contain(
            "if outcome.publication_state() == DbfsPublicationStateV1.NotPublished:")
        expect(source).to_contain(
            "if outcome.publication_state() == DbfsPublicationStateV1.Indeterminate:")

    it "publishes empty directories and parents in admitted plan order":
        val source = read_file_text(
            "src/os/installer/dbfs_staged_tree_materializer_v1.spl")
        expect(source).to_contain(
            "if entry.kind == StagedRootTreeEntryKindV1.Directory:")
        expect(source).to_contain(
            "driver.mkdir_publication_outcome_v1(")
        expect(source).to_contain("val exact_directory = \"/\" + entry.relative_path")
        expect(source).to_contain(
            "directories_published = directories_published + 1")
        expect(source).to_contain(
            "directories_planned: plan.directory_count")
        expect(source).to_contain(
            "directories_published: directories_published")

    it "rejects hosted or unready DBFS before directory namespace mutation":
        val ingest = read_file_text(
            "src/lib/nogc_sync_mut/db/dbfs_driver/streaming_ingest.spl")
        expect(ingest).to_contain("if self.arena_base < 0 or")
        expect(ingest).to_contain(
            "not dbfs_device_v4_namespace_ready_locked(")
        expect(ingest).to_contain(
            "_not_published_v1(\"dbfs-mkdir-device-namespace-unavailable\")")
        expect(ingest).to_contain(
            "_not_published_v1(\"dbfs-mkdir-persist-failed\")")
        expect(ingest).to_contain(
            "_indeterminate_v1(\"dbfs-mkdir-persist-indeterminate\")")
        expect(ingest).to_contain(
            "_not_published_v1(\"dbfs-mkdir-flush-failed\")")
        expect(ingest).to_contain(
            "_indeterminate_v1(\"dbfs-mkdir-flush-indeterminate\")")

    it "does not claim a tree transaction DBFS does not provide":
        val source = read_file_text(
            "src/os/installer/dbfs_staged_tree_materializer_v1.spl")
        expect(source).to_contain("tree_atomic: false")
        expect(source).to_contain(
            "publication_model: \"dbfs-per-entry-atomic-v1\"")
        expect(source).to_contain("files_published: files_published")
        expect(source).to_contain("error_path: receipt.exact_path")

    it "keeps the retained-session consuming entry points package internal":
        val source = read_file_text(
            "src/os/installer/dbfs_staged_tree_materializer_v1.spl")
        expect(source).to_contain(
            "pub(package) fn dbfs_materialize_retained_file_v1(")
        expect(source).to_contain(
            "pub(package) fn image_builder_materialize_retained_tree_to_dbfs_v1(")
