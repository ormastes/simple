use std.spec.*
use os.x86_64_fs_exec_provider_status.{
    X86_64_FS_EXEC_PROVIDER_READY,
    X86_64_FS_EXEC_PROVIDER_AUTH_REQUIRED,
    X86_64_FS_EXEC_PROVIDER_FAILED,
    x86_64_fs_exec_provider_status,
    x86_64_fs_exec_provider_blocked_marker
}

describe "x86_64 filesystem execution provider status":
    it "reports the canonical authenticated-provider blocker":
        expect(x86_64_fs_exec_provider_status(-13)).to_equal(
            X86_64_FS_EXEC_PROVIDER_AUTH_REQUIRED)
        expect(x86_64_fs_exec_provider_blocked_marker(-13)).to_equal(
            "X86_64_FS_EXEC_BLOCKED reason=authenticated-provider-unavailable rc=-13")

    it "does not reinterpret other failures as an authority blocker":
        expect(x86_64_fs_exec_provider_status(-2)).to_equal(
            X86_64_FS_EXEC_PROVIDER_FAILED)
        expect(x86_64_fs_exec_provider_status(37)).to_equal(
            X86_64_FS_EXEC_PROVIDER_READY)
