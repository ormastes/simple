# @cover src/os/services/update/tuf_signing.spl 40%
"""
# TUF Signature Forgery-Detection Calibration

**Category:** Update security
**Status:** Real cryptography (Ed25519), deliberate-red calibrated

## Why this is a separate spec file

`tuf_signing_spec.spl` covers canonicalization, SHA-256 target digests,
pre-crypto rejections, and the accepted-update baseline. It cannot also carry
these forgery calibrations: the test runner gives a spec roughly 60 s wall
(the shared daemon's `session_startup_timeout_ms`, which even
`--no-session-daemon --timeout=N` does not lift), spec compile alone consumes
about 36 s of it, and every Ed25519 operation costs about 2.8 s because the JIT
bails out with `HIR lowering error: Unknown type: u128` and the whole primitive
falls back to the interpreter.

So this file is budgeted deliberately. It exercises the cryptographic boundary
`check_role_signatures` directly — ONE Ed25519 verification per example instead
of the four that a full `verify_update_signed` pipeline pass would cost.

## Absolute oracles

- A genuine signature over the canonical bytes verifies, and yields exactly the
  signing key-id as a proven signer.
- **Deliberate-red calibration 1** — TAMPERED PAYLOAD. One byte of the signed
  content is changed (root's version 5 -> 6) while replaying the original
  signature. Verification must fail with `TUF_BAD_SIGNATURE`.
- **Deliberate-red calibration 2** — WRONG SIGNING KEY. A signature genuinely
  made by key B over the very same payload is presented under key A's key-id.
  Verification must fail with `TUF_BAD_SIGNATURE`.
- Fail-closed: a forged signature rejects the role outright and contributes NO
  verified signer, so it can never be hidden among valid signatures.
"""

use std.spec
use os.crypto.ed25519.{ed25519_keypair_from_seed, ed25519_sign}
use os.services.update.tuf_metadata.{RoleMetadata, CurrentVersions, TUF_ACCEPTED}
use os.services.update.tuf_signing.{
    RoleSignature,
    SignedRole,
    TrustedKey,
    SignerCheck,
    TUF_BAD_SIGNATURE,
    canonical_role_bytes,
    check_role_signatures,
    verify_update_signed
}

# ----------------------------------------------------------------------------
# Fixtures — deterministic seeds; every Ed25519 op here is counted (~2.8 s each)
# ----------------------------------------------------------------------------

fn seed_of(n: u64) -> [u8]:
    var s: [u8] = []
    var i: u64 = 0
    while i < 32:
        s = s.push(((i * 7 + n * 31 + 3) % 251).to_u8())
        i = i + 1
    return s

fn mk_role_full(role: text, ver: u64, deleg: List<text>, rtv: u64) -> RoleMetadata:
    return RoleMetadata(
        role: role,
        version: ver,
        expires_at: 2000,
        threshold: 1,
        signer_key_ids: ["kA"],
        signatures_present: [],
        delegated_key_ids: deleg,
        recorded_targets_version: rtv)

fn mk_role(role: text, ver: u64) -> RoleMetadata:
    return mk_role_full(role, ver, [], 0)

# Snapshot must pin the targets version (11) or the mix-and-match defense fires.
fn mk_role_snap() -> RoleMetadata:
    return mk_role_full("snapshot", 4, [], 11)

fn mk_role_tgt() -> RoleMetadata:
    return mk_role_full("targets", 11, [], 0)

val KP_A: ([u8], [u8]) = ed25519_keypair_from_seed(seed_of(1))
val KP_B: ([u8], [u8]) = ed25519_keypair_from_seed(seed_of(2))
val PUB_A: [u8] = KP_A.1
val PUB_B: [u8] = KP_B.1

# "kA" is the legitimate signer. "kB" is a real key that is NOT authorized here,
# used only to manufacture calibration 2's forgery.
val KEYRING: List<TrustedKey> = [TrustedKey(key_id: "kA", public_key: PUB_A)]
val TRUSTED: List<text> = ["kA"]

val M_ROOT: RoleMetadata = mk_role("root", 5)

# Genuine signature by kA, and a same-payload signature by the WRONG key kB.
val SIG_A: [u8] = ed25519_sign(KP_A.0, PUB_A, canonical_role_bytes(M_ROOT))
val SIG_B: [u8] = ed25519_sign(KP_B.0, PUB_B, canonical_role_bytes(M_ROOT))

fn signed_a(meta: RoleMetadata) -> SignedRole:
    """Sign `meta` with the legitimate key kA and wrap it as a presented role."""
    return SignedRole(
        meta: meta,
        signatures: [RoleSignature(
            key_id: "kA",
            sig: ed25519_sign(KP_A.0, PUB_A, canonical_role_bytes(meta)))])

# ============================================================================

describe "TUF forgery detection (real Ed25519)":
    """One genuine signature, then two deliberate forgeries that must be caught."""

    it "GREEN control: a genuine signature verifies and proves its signer":
        """Calibration baseline — without this the RED cases prove nothing."""
        val touch = SIG_A
        val signed = SignedRole(
            meta: M_ROOT,
            signatures: [RoleSignature(key_id: "kA", sig: touch)])
        val chk: SignerCheck = check_role_signatures(signed, TRUSTED, KEYRING)
        assert_true(chk.ok)
        assert_eq(chk.verified_key_ids.len(), 1)
        assert_eq(chk.verified_key_ids[0], "kA")

    it "RED 1: one tampered payload byte invalidates a replayed signature":
        """Attacker edits root version 5 -> 6 but cannot re-sign: FORGERY CAUGHT."""
        val touch = SIG_A
        val tampered = SignedRole(
            meta: mk_role("root", 6),
            signatures: [RoleSignature(key_id: "kA", sig: touch)])
        val chk: SignerCheck = check_role_signatures(tampered, TRUSTED, KEYRING)
        assert_false(chk.ok)
        assert_eq(chk.reason_code, TUF_BAD_SIGNATURE)
        assert_eq(chk.verified_key_ids.len(), 0)

    it "RED 2: a signature from a different key is rejected as a forgery":
        """kB really signed these exact bytes, but claims to be kA: CAUGHT."""
        val touch = SIG_B
        val forged = SignedRole(
            meta: M_ROOT,
            signatures: [RoleSignature(key_id: "kA", sig: touch)])
        val chk: SignerCheck = check_role_signatures(forged, TRUSTED, KEYRING)
        assert_false(chk.ok)
        assert_eq(chk.reason_code, TUF_BAD_SIGNATURE)
        assert_eq(chk.verified_key_ids.len(), 0)

# The end-to-end "a fully valid four-role update is ACCEPTED" baseline needs
# four signatures plus four verifications (~22 s of Ed25519) and does not fit
# alongside these cases. It lives in tuf_signed_accept_spec.spl.
