"""Typed workload-policy compilation is all-or-nothing and non-authoritative."""

use std.spec.{describe, it, expect}
use os.services.workload.workload_manifest.{
    WorkloadIdentitySpec, ImageSpec, AuthorityRequest, IsolationSpec,
    ResourceBudget, LifecyclePolicy, ObservabilityPolicy, WorkloadManifest,
    compile_workload_manifest
}
use os.kernel.ipc.cspace_spawn.{CapGrant, atten_identity}
use os.kernel.types.capability_types.{CapabilityKind}

fn _manifest() -> WorkloadManifest:
    WorkloadManifest(
        identity: WorkloadIdentitySpec(
            principal_id: "service:vfs", tenant_id: "system",
            image_hash: "blake3:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", signer: "system", parent_principal: "pid1",
            expires_at_ms: 1000u64
        ),
        image: ImageSpec(executable_path: "/system/vfs.smf", content_hash: "blake3:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", signer: "system"),
        authority: AuthorityRequest(grants: [CapGrant(
            label: "fs.read", requested: CapabilityKind.FileRead(path_prefix: "/system"),
            atten: atten_identity()
        )]),
        isolation: IsolationSpec(
            filesystem_view: "/", process_view: "private", ipc_view: "private",
            network_view: "none", syscall_allowlist: [4u64, 13u64]
        ),
        resources: ResourceBudget(
            cpu_weight: 100u64, memory_pages: 32u64, process_limit: 4u64,
            io_weight: 10u64, network_bytes: 0u64, wall_time_ms: 1000u64
        ),
        lifecycle: LifecyclePolicy(restart_policy: "on_failure", max_restarts: 3u64, watchdog_timeout_ms: 100u64),
        observability: ObservabilityPolicy(audit_required: true, log_retention_ms: 1000u64)
    )

describe "workload manifest compilation":
    it "preserves typed grants but does not mint authority":
        val result = compile_workload_manifest(_manifest())
        expect(result.is_ok()).to_equal(true)
        val policy = result.unwrap()
        expect(policy.spawn_spec.image_hash).to_equal("blake3:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
        expect(policy.image.executable_path).to_equal("/system/vfs.smf")
        expect(policy.spawn_spec.grants.len()).to_equal(1)
        expect(policy.resource_spec.process_limit).to_equal(4u64)

    it "rejects identity/image mismatch and malformed policy data":
        var mismatch = _manifest()
        mismatch.image.content_hash = "blake3:other"
        expect(compile_workload_manifest(mismatch).is_err()).to_equal(true)

        var duplicate = _manifest()
        duplicate.isolation.syscall_allowlist = [4u64, 4u64]
        expect(compile_workload_manifest(duplicate).is_err()).to_equal(true)

        var missing_syscalls = _manifest()
        missing_syscalls.isolation.syscall_allowlist = []
        expect(compile_workload_manifest(missing_syscalls).is_err()).to_equal(true)

        var descriptive_view = _manifest()
        descriptive_view.isolation.filesystem_view = "workspace"
        expect(compile_workload_manifest(descriptive_view).is_err()).to_equal(true)

        var zero_limit = _manifest()
        zero_limit.resources.process_limit = 0u64
        expect(compile_workload_manifest(zero_limit).is_err()).to_equal(true)

        var zero_cpu_weight = _manifest()
        zero_cpu_weight.resources.cpu_weight = 0u64
        expect(compile_workload_manifest(zero_cpu_weight).is_err()).to_equal(true)

        var excessive_cpu_weight = _manifest()
        excessive_cpu_weight.resources.cpu_weight = 4097u64
        expect(compile_workload_manifest(excessive_cpu_weight).is_err()).to_equal(true)

        var malformed_hash = _manifest()
        malformed_hash.image.content_hash = "blake3:not-a-digest"
        malformed_hash.identity.image_hash = "blake3:not-a-digest"
        expect(compile_workload_manifest(malformed_hash).is_err()).to_equal(true)
