"""Hierarchical PID admission counts resource-domain descendants."""

use std.spec.{describe, it, expect}
use os.kernel.scheduler.scheduler.{Scheduler}
use os.kernel.scheduler.scheduler_types.{task_security_binding_managed_child}
use os.kernel.types.task_types.{TaskId, TaskPriority}
use os.kernel.types.capability_types.{CapabilitySet}
use os.kernel.memory.task_memory_budget.{task_memory_budget_clear, task_memory_budget_reserve}

describe "resource-domain process budgeting":
    it "counts grandchildren against the ancestor resource-domain budget":
        var scheduler = Scheduler.new()
        val parent = scheduler.create_task(
            0x1000, TaskPriority.Normal, CapabilitySet.empty())
        val child = scheduler.create_task(
            0x2000, TaskPriority.Normal, CapabilitySet.empty())
        expect(scheduler.bind_managed_child_security(
            child, task_security_binding_managed_child(parent.id, parent.id, child)
        )).to_equal(true)

        val grandchild = scheduler.create_task(
            0x3000, TaskPriority.Normal, CapabilitySet.empty())
        expect(scheduler.bind_managed_child_security(
            grandchild, task_security_binding_managed_child(child.id, child.id, grandchild)
        )).to_equal(true)

        expect(scheduler.resource_descendant_count(parent)).to_equal(2u64)
        expect(scheduler.resource_descendant_count(child)).to_equal(1u64)

    it "clamps a nested workload memory ceiling to its parent domain":
        var scheduler = Scheduler.new()
        val parent = scheduler.create_task(
            0x1000, TaskPriority.Normal, CapabilitySet.empty())
        expect(scheduler.bind_managed_child_security(
            parent, task_security_binding_managed_child(0u64, 0u64, parent)
        )).to_equal(true)
        expect(scheduler.bind_managed_child_resource_limits(parent, 8u64, 3u64)).to_equal(true)

        val child = scheduler.create_task(
            0x2000, TaskPriority.Normal, CapabilitySet.empty())
        expect(scheduler.bind_managed_child_security(
            child, task_security_binding_managed_child(parent.id, parent.id, child)
        )).to_equal(true)
        expect(scheduler.bind_managed_child_resource_limits(child, 8u64, 64u64)).to_equal(true)
        val child_tcb = scheduler.get_task(child)
        if child_tcb != nil:
            expect(child_tcb.isolation.max_memory_pages).to_equal(3u64)

    it "charges a child mmap against its parent resource domain budget":
        var scheduler = Scheduler.new()
        val parent = scheduler.create_task(
            0x1000, TaskPriority.Normal, CapabilitySet.empty())
        expect(scheduler.bind_managed_child_security(
            parent, task_security_binding_managed_child(0u64, 0u64, parent)
        )).to_equal(true)
        expect(scheduler.bind_managed_child_resource_limits(parent, 8u64, 3u64)).to_equal(true)

        val child = scheduler.create_task(
            0x2000, TaskPriority.Normal, CapabilitySet.empty())
        expect(scheduler.bind_managed_child_security(
            child, task_security_binding_managed_child(parent.id, parent.id, child)
        )).to_equal(true)
        expect(scheduler.bind_managed_child_resource_limits(child, 8u64, 3u64)).to_equal(true)

        task_memory_budget_clear(parent)
        task_memory_budget_clear(child)
        expect(task_memory_budget_reserve(parent, 3u64, 2u64)).to_equal(true)
        expect(scheduler.resource_memory_admits(child, 2u64)).to_equal(false)
        expect(scheduler.resource_memory_admits(child, 1u64)).to_equal(true)

    it "clamps a nested workload fair-share weight to its parent ceiling":
        var scheduler = Scheduler.new()
        val parent = scheduler.create_task(
            0x1000, TaskPriority.Normal, CapabilitySet.empty())
        expect(scheduler.bind_managed_child_security(
            parent, task_security_binding_managed_child(0u64, 0u64, parent)
        )).to_equal(true)
        expect(scheduler.bind_managed_child_resource_limits(parent, 8u64, 3u64)).to_equal(true)
        expect(scheduler.bind_managed_child_cpu_weight(parent, 7u64)).to_equal(true)

        val child = scheduler.create_task(
            0x2000, TaskPriority.Normal, CapabilitySet.empty())
        expect(scheduler.bind_managed_child_security(
            child, task_security_binding_managed_child(parent.id, parent.id, child)
        )).to_equal(true)
        expect(scheduler.bind_managed_child_resource_limits(child, 8u64, 3u64)).to_equal(true)
        expect(scheduler.bind_managed_child_cpu_weight(child, 64u64)).to_equal(true)
        val child_tcb = scheduler.get_task(child)
        if child_tcb != nil:
            expect(child_tcb.schedule.weight).to_equal(7i64)
