use std.spec.{describe, it, expect}
use os.kernel.loader.combined_toolchain_catalog_media_boot_v1.{
    CombinedToolchainCatalogMediaModeV1,
    combined_toolchain_catalog_media_mode_v1}

describe "Combined toolchain catalog producer-consumer mode parity":
    it "keeps legacy mode only when the producer omitted PTRD":
        expect(combined_toolchain_catalog_media_mode_v1(
            false, false)).to_equal(
                CombinedToolchainCatalogMediaModeV1.Legacy)

    it "selects combined mode for a published and authenticated PTRD":
        expect(combined_toolchain_catalog_media_mode_v1(
            true, true)).to_equal(
                CombinedToolchainCatalogMediaModeV1.Combined)

    it "rejects a published PTRD that the consumer cannot authenticate":
        expect(combined_toolchain_catalog_media_mode_v1(
            true, false)).to_equal(
                CombinedToolchainCatalogMediaModeV1.Reject)
