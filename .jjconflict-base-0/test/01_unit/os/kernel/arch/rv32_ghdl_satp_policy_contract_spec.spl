"""
Pins the branchless Pure Simple expected-SATP receipt used by the RV32 GHDL
Linux acceptance payload. This is structural evidence only: the query returns
the contract value zero and does not claim to read the live satp CSR.
"""
# @manual: primary

use std.spec
use app.io.mod.{file_read_text}

val ENTRY_PATH = "examples/09_embedded/simple_os/arch/riscv32/ghdl_linux_acceptance_entry.spl"
val PROVIDER_PATH = "examples/09_embedded/simple_os/arch/riscv32/boot/baremetal_stubs.c"
val RAW_BASELINE_PATH = "scripts/check/raw_sffi_unsafe_baseline.tsv"
val UNBACKED_PATH = "scripts/check/unbacked_extern_baseline.txt"

describe "RV32 GHDL expected SATP policy ownership":
    it "owns the exact branchless zero receipt in Pure Simple":
        step("Inspect the local expected-state query and its consumer")
        val entry = file_read_text(ENTRY_PATH)
        expect(entry).to_contain("@inline\nfn _read_satp() -> u32:\n    0")
        expect(entry).to_contain("rt_rv32_probe_store_satp(_read_satp())")
        expect(entry).to_contain("expected-state receipt, not a live CSR read")

    it "removes the foreign query and all active inventory debt":
        step("Inspect the entry, former provider, and active policy baselines")
        val entry = file_read_text(ENTRY_PATH)
        val provider = file_read_text(PROVIDER_PATH)
        val raw_baseline = file_read_text(RAW_BASELINE_PATH)
        val unbacked = file_read_text(UNBACKED_PATH)
        expect(entry.contains("rt_rv32_probe_read_satp")).to_be(false)
        expect(provider.contains("rt_rv32_probe_read_satp")).to_be(false)
        expect(raw_baseline.contains("rt_rv32_probe_read_satp")).to_be(false)
        expect(unbacked.contains("rt_rv32_probe_read_satp")).to_be(false)
