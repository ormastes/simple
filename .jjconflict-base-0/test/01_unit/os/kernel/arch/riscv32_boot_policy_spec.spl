# @cover src/os/kernel/arch/riscv32/boot_layout.spl 100%

use std.spec.*
use os.kernel.arch.riscv32.boot_layout.{
    rv32_boot_layout_valid,
    rv32_boot_layout_total_pages,
    rv32_direct_ram_base,
    rv32_direct_ram_size,
    rv32_direct_reserved_end,
    rv32_direct_heap_start,
    rv32_direct_heap_size
}
use os.port.simpleos_multiplatform_build.{simpleos_platform_qemu_lane}

fn _simple_row(ram_base: u64, ram_size: u64, reserved_end: u64, heap_start: u64, heap_size: u64) -> text:
    val valid = rv32_boot_layout_valid(ram_base, ram_size, reserved_end, heap_start, heap_size)
    val prefix = if valid: "1:" else: "0:"
    prefix + rv32_boot_layout_total_pages(ram_base, ram_size, reserved_end, heap_start, heap_size).to_text()

fn _oracle_row(oracle: text, ram_base: u64, ram_size: u64, reserved_end: u64, heap_start: u64, heap_size: u64) -> text:
    val command = oracle + " " + ram_base.to_text() + " " + ram_size.to_text() + " " +
        reserved_end.to_text() + " " + heap_start.to_text() + " " + heap_size.to_text()
    val result = shell(command)
    if result.exit_code != 0:
        fail("RV32 C oracle failed: {result.stdout}{result.stderr}")
    result.stdout.trim()

describe "RV32 direct-M-mode pure-Simple boot policy":
    it "matches an independently compiled C oracle across every layout guard":
        val tmpdir = shell("mktemp -d").stdout.trim()
        if tmpdir == "":
            fail("failed to create RV32 oracle temporary directory")
        val oracle = tmpdir + "/rv32_boot_policy_oracle"
        val build = shell("cc -std=c11 -O2 test/01_unit/os/kernel/arch/riscv32_boot_policy_oracle.c -o '" + oracle + "' 2>&1")
        if build.exit_code != 0:
            fail("failed to compile RV32 C oracle: {build.stdout}{build.stderr}")

        val ram_base = rv32_direct_ram_base()
        val ram_size = rv32_direct_ram_size()
        val reserved_end = rv32_direct_reserved_end()
        val heap_start = rv32_direct_heap_start()
        val heap_size = rv32_direct_heap_size()

        expect(ram_base).to_equal(0x80000000)
        expect(ram_size).to_equal(128 * 1024 * 1024)
        expect(heap_start + heap_size <= ram_base + ram_size).to_equal(true)

        expect(_simple_row(ram_base, ram_size, reserved_end, heap_start, heap_size)).to_equal(
            _oracle_row(oracle, ram_base, ram_size, reserved_end, heap_start, heap_size))
        expect(_simple_row(ram_base, 4096, reserved_end, heap_start, heap_size)).to_equal(
            _oracle_row(oracle, ram_base, 4096, reserved_end, heap_start, heap_size))
        expect(_simple_row(ram_base, ram_size, ram_base, heap_start, heap_size)).to_equal(
            _oracle_row(oracle, ram_base, ram_size, ram_base, heap_start, heap_size))
        expect(_simple_row(ram_base, ram_size, reserved_end, reserved_end, heap_size)).to_equal(
            _oracle_row(oracle, ram_base, ram_size, reserved_end, reserved_end, heap_size))
        expect(_simple_row(ram_base, ram_size, reserved_end, heap_start, 7)).to_equal(
            _oracle_row(oracle, ram_base, ram_size, reserved_end, heap_start, 7))
        expect(_simple_row(0xFFFFFFFFFFFFF000, 8192, reserved_end, heap_start, heap_size)).to_equal(
            _oracle_row(oracle, 0xFFFFFFFFFFFFF000, 8192, reserved_end, heap_start, heap_size))
        expect(_simple_row(ram_base, ram_size, reserved_end, 0xFFFFFFFFFFFFFFF8, 16)).to_equal(
            _oracle_row(oracle, ram_base, ram_size, reserved_end, 0xFFFFFFFFFFFFFFF8, 16))
        expect(_simple_row(ram_base, ram_size, reserved_end, 0x87FFF000, 8192)).to_equal(
            _oracle_row(oracle, ram_base, ram_size, reserved_end, 0x87FFF000, 8192))
        expect(_simple_row(ram_base, ram_size, 0x86FFFFFF, 0x87000000, heap_size)).to_equal(
            _oracle_row(oracle, ram_base, ram_size, 0x86FFFFFF, 0x87000000, heap_size))

        _ = shell("rm -rf '" + tmpdir + "'")

    it "keeps the FPGA stand-in, linker, and shared layout at 128 MiB":
        val lane = simpleos_platform_qemu_lane("riscv32", "riscv32-fpga-mmode")
        if val resolved = lane:
            expect(resolved.qemu_memory).to_equal("128M")
            expect(resolved.linker_script).to_equal("src/os/kernel/arch/riscv32/fpga_linker.ld")
        else:
            fail("missing riscv32 FPGA M-mode lane")

        val linker = file_read("src/os/kernel/arch/riscv32/fpga_linker.ld")
        expect(linker.contains("RAM (rwx) : ORIGIN = 0x80000000, LENGTH = 128M")).to_equal(true)
        expect(rv32_direct_ram_size()).to_equal(128 * 1024 * 1024)

    it "keeps the production bridge acquisition-only and RV64-independent":
        val bridge = file_read("src/os/kernel/arch/riscv32/boot/baremetal_stubs.c")
        expect(bridge.contains("riscv64")).to_equal(false)
        expect(bridge.contains("freestanding_runtime.c")).to_equal(false)
        expect(bridge.contains("rt_riscv_uart_put")).to_equal(true)
        expect(bridge.contains("rt_rv32_smp_online_count")).to_equal(true)
        expect(bridge.contains("rt_alloc")).to_equal(false)
        expect(bridge.contains("rt_riscv_noalloc_pmm")).to_equal(false)

    it "keeps both production entries on the direct M-mode Simple policy":
        val qemu = file_read("src/os/kernel/arch/riscv32/boot.spl")
        val fpga = file_read("src/os/kernel/arch/riscv32/fpga_boot.spl")
        expect(qemu.contains("rv32_direct_boot_initialize")).to_equal(true)
        expect(fpga.contains("rv32_direct_boot_initialize")).to_equal(true)
        expect(qemu.contains("rt_riscv_noalloc_pmm_init_default")).to_equal(false)
        expect(fpga.contains("rt_riscv_noalloc_pmm_init_default")).to_equal(false)
        expect(qemu.contains("OpenSBI")).to_equal(true)
        expect(fpga.contains("no SBI")).to_equal(true)
