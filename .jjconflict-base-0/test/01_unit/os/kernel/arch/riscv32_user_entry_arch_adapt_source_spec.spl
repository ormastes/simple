# @cover src/os/kernel/arch_adapt/riscv32_user_entry.spl 100%
# Exact source-decision coverage for RISC-V 32 loader entry-state routing.

use std.spec.{describe, it, expect, step}
use app.io.mod.{file_read_text, process_run}

val ADAPTER_PATH = "src/os/kernel/arch_adapt/riscv32_user_entry.spl"
val CONSUMER_PATH =
    "src/os/kernel/loader/executable_authority_registry.spl"
val CONCRETE_OWNER = "os.kernel.arch.riscv32.user_entry_v1"
val ADAPTER_OWNER = "os.kernel.arch_adapt.riscv32_user_entry"
val EXACT_ADAPTER_SOURCE = "# Compile-time RISC-V 32 User-Entry Adapter\n" +
    "#\n" +
    "# Loader owners bind to this architecture boundary instead of importing the\n" +
    "# concrete RISC-V 32 tree. Public re-exports preserve existing declarations;\n" +
    "# no runtime dispatch, allocation, copied state, or additional call is added.\n" +
    "\n" +
    "pub use {CONCRETE_OWNER}.{{\n" +
    "    Riscv32UserSretStateV1,\n" +
    "    riscv32_user_sret_state_v1,\n" +
    "}}\n"
val EXACT_CONSUMER_IMPORT = "use {ADAPTER_OWNER}.{{\n" +
    "    Riscv32UserSretStateV1, riscv32_user_sret_state_v1\n" +
    "}}"

describe "RISC-V 32 user-entry compile-time architecture adapter":
    it "is exactly the allocation-free whole-file forwarding contract":
        step("Read the adapter source and pin its exact two-symbol export")
        val source = file_read_text(ADAPTER_PATH)
        expect(source).to_equal(EXACT_ADAPTER_SOURCE)
        expect(source.count("pub use ")).to_equal(1)
        expect(source.count(CONCRETE_OWNER)).to_equal(1)
        expect(source.contains("fn ")).to_equal(false)
        expect(source.contains("var ")).to_equal(false)
        expect(source.contains("extern fn")).to_equal(false)
        expect(source.contains("rt_")).to_equal(false)

    it "routes the sole production consumer through the adapter":
        step("Pin the consumer import and reject its concrete-owner dependency")
        val consumer = file_read_text(CONSUMER_PATH)
        expect(consumer.contains(EXACT_CONSUMER_IMPORT)).to_equal(true)
        expect(consumer.count(ADAPTER_OWNER)).to_equal(1)
        expect(consumer.contains(CONCRETE_OWNER)).to_equal(false)

    it "permits the concrete import only inside the architecture adapter":
        step("Search the complete production source tree for concrete imports")
        val direct_imports = process_run("rg", [
            "-l", "^(pub )?use " + CONCRETE_OWNER, "src", "--glob", "*.spl"
        ])
        expect(direct_imports.2).to_equal(0)
        expect(direct_imports.0).to_equal(ADAPTER_PATH + "\n")
