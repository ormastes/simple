"""Task-exit teardown removes task-keyed authority outside the scheduler TCB."""

use std.spec.{describe, it, expect}
use os.kernel.lifecycle.task_exit_teardown.{teardown_exited_task_authority}
use os.kernel.ipc.ipc.{IpcManager}
use os.kernel.types.task_types.{TaskId}

describe "task exit authority teardown":
    it "removes task-owned endpoints and is idempotent":
        val owner = TaskId(id: 991u64)
        var ipc = IpcManager.new()
        val endpoint = ipc.create_port(owner, "teardown-owner")
        expect(endpoint.id).to_be_greater_than(0u64)

        val cleaned = teardown_exited_task_authority(owner, ipc)
        expect(cleaned.connect("teardown-owner")).to_equal(nil)

        val cleaned_again = teardown_exited_task_authority(owner, cleaned)
        expect(cleaned_again.connect("teardown-owner")).to_equal(nil)
