use os.compositor.wm_action_lifecycle.{
    WM_WORK_AREA_TOP,
    WM_WORK_AREA_BOTTOM,
    apply_wm_action_to_lifecycle_windows,
    wm_action_from_bridge_request,
}
use os.userlib.ipc_protocol.{COMP_CREATE_WINDOW, COMP_MAXIMIZE}

fn main() -> i64:
    val created = apply_wm_action_to_lifecycle_windows(
        [], 1, 640, 480,
        wm_action_from_bridge_request(
            10, COMP_CREATE_WINDOW.to_i64(), 0,
            "Window", 31, 47, 180, 140, "", 99, "/sys/apps/window"
        )
    )
    val maximized = apply_wm_action_to_lifecycle_windows(
        created.windows, created.next_window_id, 640, 480,
        wm_action_from_bridge_request(
            10, COMP_MAXIMIZE.to_i64(), created.window_id,
            "", 0, 0, 0, 0, "", 0, ""
        )
    )
    if not maximized.applied or maximized.windows.len() != 1:
        return 1
    if maximized.windows[0].y != WM_WORK_AREA_TOP:
        return 2
    if maximized.windows[0].h != (
        480 - WM_WORK_AREA_TOP - WM_WORK_AREA_BOTTOM
    ):
        return 3
    0
