# @tag: rendering, engine2d, simpleos, qemu, exact-pixel

use std.spec.{describe, it, expect}
use os.compositor.engine2d_baremetal_core.{create_buffer_engine_core}
use std.common.gpu.engine2d.scalar_oracle.{oracle_src_over}

describe "SimpleOS QEMU DrawIR exact CPU pixel oracle fixture":
    it "matches the canonical scalar oracle for the primitive alpha pixel":
        var core = create_buffer_engine_core(4, 4)
        core.clear(0xFF102030u32)
        core.draw_rect_filled(1, 1, 2, 2, 0x804080C0u32)
        val expected = oracle_src_over(0x804080C0, 0xFF102030) as u32
        expect(core.buf[5]).to_equal(expected)
        expect(core.buf[6]).to_equal(expected)
        expect(core.buf[9]).to_equal(expected)
        expect(core.buf[10]).to_equal(expected)
        expect(core.buf[0]).to_equal(0xFF102030u32)
