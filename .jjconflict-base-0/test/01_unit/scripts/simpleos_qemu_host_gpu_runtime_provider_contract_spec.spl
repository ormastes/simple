"""Linux host-GPU daemon runtime archive admission contract."""

use std.io_runtime.{file_read}
use std.spec.*

val WRAPPER = "scripts/check/check-simpleos-qemu-host-gpu-2d.shs"

describe "SimpleOS QEMU host-GPU runtime provider closure":
    it "requires the retained crypto, clock, and Vulkan providers":
        val source = file_read(WRAPPER)
        expect(source).to_contain("LINUX_DAEMON_RUNTIME_SYMBOLS=")
        expect(source).to_contain("rt_tls13_sha256")
        expect(source).to_contain("rt_sleep_nanos")
        expect(source).to_contain("rt_vulkan_provider_is_available")
        expect(source).to_contain("rt_vulkan_provider_device_count")
        expect(source).to_contain("rt_vulkan_init")
        expect(source).to_contain("rt_vulkan_compile_spirv_raw")
        expect(source).to_contain("rt_vulkan_create_compute_pipeline")

    it "admits archive definitions instead of trusting feature metadata":
        val source = file_read(WRAPPER)
        expect(source).to_contain("nm -g \"$archive\"")
        expect(source).to_contain("linux_runtime_provider_closure_valid \"$runtime_archive\" || return 1")
        expect(source).to_contain("cc \"$fixture/consumer.c\" \"$fixture/libsimple_runtime.a\"")
        expect(source).to_contain("cc \"$fixture/consumer.c\" \"$fixture/incomplete.a\"")
        expect(source).to_contain("if linux_runtime_provider_closure_valid \"$fixture/incomplete.a\"; then")

    it "prepares and revalidates the provider before daemon linking":
        val source = file_read(WRAPPER)
        expect(source).to_contain("if [ \"$host\" = linux ] && ! prepare_linux_runtime; then")
        expect(source).to_contain("SIMPLE_LINK_OBJECTS=\"$runtime_archive\"")
        expect(source).to_contain("run_linux_daemon_native_build \"$@\"")
        expect(source).to_contain("if ! run_daemon_native_build")
        expect(source).to_contain("run_daemon_native_build --provider-self-test")
        expect(source).to_contain("simpleos_qemu_host_gpu_2d_reason=runtime-provider-closure-missing")
        expect(source).to_contain("--self-test-runtime-provider")
