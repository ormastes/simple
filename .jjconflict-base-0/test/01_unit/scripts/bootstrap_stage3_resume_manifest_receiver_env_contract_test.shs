#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
resume="$root/scripts/bootstrap/resume-stage3-from-admitted.sh"
tmp=$(mktemp -d "${TMPDIR:-/tmp}/simple-stage3-resume-manifest-env.XXXXXX")
trap 'rm -rf "$tmp"' EXIT HUP INT TERM

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

# The receipts must be verified before their exact paths are bound and
# exported to manifest writing; ordering prevents an unverified directory from
# being recorded as proof.
smoke_verify_line=$(grep -n -F 'bootstrap_stage3_verify_receiver_smoke_evidence \' \
  "$resume" | sed -n '1s/:.*//p')
llvm_verify_line=$(grep -n -F 'bootstrap_stage3_verify_llvm_receiver_evidence \' \
  "$resume" | sed -n '1s/:.*//p')
smoke_bind_line=$(grep -n -F 'BSTAGE3_STAGE2_RECEIVER_SMOKE=$stage2_receiver_smoke' \
  "$resume" | sed -n '1s/:.*//p')
llvm_bind_line=$(grep -n -F 'BSTAGE3_STAGE2_LLVM_RECEIVER=$stage2_llvm_receiver/receipt.env' \
  "$resume" | sed -n '1s/:.*//p')
write_line=$(grep -n -F 'bootstrap_stage3_write_manifest' "$resume" | \
  tail -n 1 | sed -n 's/:.*//p')
case "$smoke_verify_line:$llvm_verify_line:$smoke_bind_line:$llvm_bind_line:$write_line" in
  *[!0-9:]*|:*|*::*) fail 'receiver verification/binding markers missing' ;;
esac
[ "$smoke_verify_line" -lt "$smoke_bind_line" ] || fail 'smoke receipt bound before verification'
[ "$llvm_verify_line" -lt "$llvm_bind_line" ] || fail 'LLVM receipt bound before verification'
[ "$smoke_bind_line" -lt "$write_line" ] || fail 'smoke receipt bound after manifest write'
[ "$llvm_bind_line" -lt "$write_line" ] || fail 'LLVM receipt bound after manifest write'

# Execute the exact manifest-binding tail from the resume wrapper. The fake
# writer reads both values through a child shell, proving they were exported
# rather than only assigned in the parent shell.
smoke_receipt="$tmp/stage2-struct-receiver-smoke.env"
llvm_dir="$tmp/stage2-llvm-struct-receiver"
llvm_receipt="$llvm_dir/receipt.env"
mkdir -p "$llvm_dir"
printf 'verified smoke receipt\n' >"$smoke_receipt"
printf 'verified LLVM receipt\n' >"$llvm_receipt"

harness="$tmp/manifest-env-harness.sh"
manifest="$tmp/provenance.env"
cat >"$harness" <<EOF
#!/bin/sh
set -eu
root=$tmp/root
manifest=$tmp/provenance.env
platform=fixture-platform
seed=$tmp/seed
stamp=$tmp/stamp
native_all=$tmp/libsimple_native_all.a
backfill=$tmp/libsimple_compiler_backfill.a
runtime_origin_before=$tmp/runtime-origin-before.txt
runtime_origin_after=$tmp/runtime-origin-after.txt
runtime_admitted=$tmp/runtime-admitted.txt
tool_after=$tmp/tool-after.txt
stage2=$tmp/stage2
admitted=$tmp/admitted
candidate=$tmp/stage3
source_before=$tmp/source-before.txt
source_after=$tmp/source-after.txt
stage2_log=$tmp/stage2.log
stage3_log=$tmp/stage3.log
stage2_args=stage2-args
stage3_args=stage3-args
stage2_threads=1
stage2_cache=$tmp/stage2-cache
stage3_cache=$tmp/stage3-cache
runtime=$tmp/runtime
script=$resume
helper=$tmp/helper
helper_sha_before=helper-sha
helper_bundle_before=helper-bundle
script_sha_before=script-sha
seed_fingerprint=seed-fingerprint
git_before=$tmp/git-before.env
git_after=$tmp/git-after.env
stage2_transcript=$tmp/stage2.transcript
stage3_transcript=$tmp/stage3.transcript
stage2_sanity=$tmp/stage2-sanity.env
stage2_receiver_smoke=$smoke_receipt
stage2_llvm_receiver=$llvm_dir
stage3_sanity=$tmp/stage3-sanity.env
lock=$tmp/lock
stage2_receiver_smoke_expected=$smoke_receipt
stage2_llvm_receiver_expected=$llvm_receipt
bootstrap_stage3_write_manifest() {
  [ "\$(sh -c 'printf %s "\$BSTAGE3_STAGE2_RECEIVER_SMOKE"')" = "\$stage2_receiver_smoke_expected" ] || exit 41
  [ "\$(sh -c 'printf %s "\$BSTAGE3_STAGE2_LLVM_RECEIVER"')" = "\$stage2_llvm_receiver_expected" ] || exit 42
  printf 'smoke=%s\\nllvm=%s\\n' "\$BSTAGE3_STAGE2_RECEIVER_SMOKE" "\$BSTAGE3_STAGE2_LLVM_RECEIVER" >"\$BSTAGE3_MANIFEST"
}
bootstrap_stage3_verify_manifest() {
  [ "\$1" = "\$manifest" ] && [ "\$2" = "\$root" ] && [ "\$3" = "\$candidate" ]
}
EOF
sed -n '/^BSTAGE3_ROOT=/,/^bootstrap_stage3_verify_manifest /p' "$resume" >>"$harness"
chmod +x "$harness"
"$harness" || fail 'manifest-binding tail did not execute'

[ "$(sed -n '1s/^smoke=//p' "$manifest")" = "$smoke_receipt" ] || \
  fail 'manifest writer did not receive smoke receipt path'
[ "$(sed -n '2s/^llvm=//p' "$manifest")" = "$llvm_receipt" ] || \
  fail 'manifest writer did not receive LLVM receipt path'

echo 'bootstrap_stage3_resume_manifest_receiver_env_contract_test: PASS'
