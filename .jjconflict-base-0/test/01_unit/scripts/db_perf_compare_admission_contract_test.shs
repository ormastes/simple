#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
HARNESS="$ROOT/scripts/check/check-simple-db-perf-compare.shs"

grep -Fq 'missing_contemporaneous_postgres_metrics' "$HARNESS"
grep -Fq '/^(sqlite|postgres)_.*_us=/' "$HARNESS"
grep -Fq 'sqlite_${key#embedded_}' "$HARNESS"
grep -Fq 'postgres_${key#embedded_}' "$HARNESS"
grep -Fq 'historical reference only' "$HARNESS"
grep -Fq 'server_unavailable' "$HARNESS"
echo "PASS: DB comparison requires contemporaneous PostgreSQL metrics"
