#!/bin/sh
set -eu
t=$(mktemp -d); trap 'rm -rf "$t"' EXIT HUP INT TERM; mkdir "$t/source"
names='packed.events packed.identity composition.bin gui.drawir web.drawir cpu.rgba device.rgba backend.env queue.env frame.rdc replay.log allocation.events queue.events inflight.events overflow.before overflow.after fallback.events drawir.entries transient-owner.env interaction.events perf.samples rss.bytes'
for name in $names; do printf primitive > "$t/source/$name"; done
sh scripts/tool/write-engine2d-rendering-raw-v1.shs "$t/source" "$t/out"
grep -Fqx raw_vocabulary_schema=mci-rendering-raw-v1 "$t/out/schema.env"
rm "$t/source/device.rgba"; if sh scripts/tool/write-engine2d-rendering-raw-v1.shs "$t/source" "$t/missing" >/dev/null 2>&1; then exit 1; fi
printf primitive > "$t/source/device.rgba"; printf 'matches=true\n' > "$t/source/backend.env"; if sh scripts/tool/write-engine2d-rendering-raw-v1.shs "$t/source" "$t/verdict" >/dev/null 2>&1; then exit 1; fi
echo engine2d-rendering-raw-v1-writer-contract:PASS
