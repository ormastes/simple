#!/bin/sh
set -eu
host=src/app/ui_showcase/hosts/host_2d_vulkan.spl
main=src/app/ui_showcase/hosts/main_2d_vulkan.spl
collector=scripts/tool/collect-mci-v2-rendering-live.shs
store=src/lib/common/mission_critical/draw_ir_packed_generation_store_v3.spl
owner=src/lib/gc_async_mut/gpu/engine2d/draw_ir_packed_composition_owner_v3.spl
grep -Fq 'draw_ir_to_sdn(composition)' "$owner"
grep -Fq 'draw_ir_v2_to_v3(composition)' "$host"
grep -Fq 'raster_scene_into(cpu_surface, cpu_scene)' "$host"
grep -Fq 'result.device_submission_generation' "$host"
grep -Fq 'result.device_submit_count' "$host"
grep -Fq 'result.device_fence_count' "$host"
grep -Fq 'time_now_micros() - started' "$host"
grep -Fq 'web_scene_to_html(cpu_scene' "$host"
grep -Fq 'vkq-{result.backend_handle}' "$host"
grep -Fq 'vks-{result.device_submission_generation}' "$host"
grep -Fq 'vkf-{result.device_submission_generation}' "$host"
grep -Fq 'SIMPLE_SHOWCASE_CPU_CAPTURE' "$main"
grep -Fq 'MCI_RENDERING_PROBE_DIR' "$main"
grep -Fq 'packed.events' "$main"
grep -Fq 'perf.samples' "$main"
grep -Fq 'queue.env' "$main"
grep -Fq 'fallback.events' "$main"
grep -Fq '/usr/bin/time -f %M' "$collector"
grep -Fq 'draw_ir_packed_capacity_probe_v3' "$store"
grep -Fq 'store.admit(capacity)' "$store"
grep -Fq 'store.admit(capacity + 1u32)' "$store"
grep -Fq 'draw_ir_packed_owner_preflight_v3' "$store"
grep -Fq 'owned.admit(owned.rows_per_slot + 1u32)' "$store"
grep -Fq 'packed_store: engine2d_packed_v3_store(9001u64)' "$host"
grep -Fq 'self.packed_store, self.last_command_count.to_u32()' "$host"
grep -Fq 'engine2d_packed_v3_prepare_identity' "$host"
grep -Fq 'engine2d_packed_v3_finalize_identity' "$host"
grep -Fq 'handoff.submission.generation_ref.generation' "$host"
grep -Fq 'queue_state=published_taken_completed' "$host"
grep -Fq 'recover_queued(submission.generation_ref)' src/lib/gc_async_mut/gpu/engine2d/draw_ir_packed_composition_owner_v3.spl
grep -Fq 'owned.terminal = true' src/lib/gc_async_mut/gpu/engine2d/draw_ir_packed_composition_owner_v3.spl
grep -Fq 'render_accepted: bool' src/lib/gc_async_mut/gpu/engine2d/draw_ir_packed_composition_owner_v3.spl
grep -Fq 'owned.matches(handoff.submission, handoff.snapshot.rows)' src/lib/gc_async_mut/gpu/engine2d/draw_ir_packed_composition_owner_v3.spl
grep -Fq 'DrawIrPackedIdentitySnapshotV3' src/lib/gc_async_mut/gpu/engine2d/draw_ir_packed_composition_owner_v3.spl
grep -Fq 'engine2d_packed_v3_verify_identity_snapshot' src/lib/gc_async_mut/gpu/engine2d/draw_ir_packed_composition_owner_v3.spl
grep -Fq 'engine2d_packed_v3_identity_artifact' src/lib/gc_async_mut/gpu/engine2d/draw_ir_packed_composition_owner_v3.spl
grep -Fq 'owned.reject_in_flight' src/lib/gc_async_mut/gpu/engine2d/draw_ir_packed_composition_owner_v3.spl
grep -Fq 'render_accepted=true' "$host"
grep -Fq 'plus_one_reason={reason}' "$store"
grep -Fq 'transient-owner.env' "$main"
grep -Fq 'result.font_atlas_upload_count' "$host"
grep -Fq 'write-engine2d-rendering-raw-v1.shs' "$collector"
grep -Fq 'packed.identity' "$collector"
grep -Fq 'cp -- "$cpu_readback" "$work/probe-source/cpu.rgba"' "$collector"
grep -Fq 'cp -- "$readback" "$work/probe-source/device.rgba"' "$collector"
validation_line=$(grep -n 'val render_accepted = _fresh_device_result_accepted' "$host" | cut -d: -f1)
finalize_line=$(grep -n 'val (completed_store, completed) = engine2d_packed_v3_finalize_identity' "$host" | cut -d: -f1)
[ "$validation_line" -lt "$finalize_line" ]
echo engine2d-rendering-probe-source-contract:PASS
