# SSH cipher, KEX, and mpint profiles H/I/M for the canonical suite.

use os.apps.sshd.ssh_packet.{ssh_put_mpint, ssh_get_u32}
use os.apps.sshd.ssh_kex.{SshSessionKeys, ssh_kex_generate_keypair, ssh_kex_compute_shared, ssh_kex_compute_exchange_hash, ssh_derive_keys, ssh_build_kex_ecdh_reply, ssh_parse_kex_ecdh_init, ssh_build_newkeys}
use os.apps.sshd.ssh_cipher.{SshCipher}
use test.system.os_ssh_support.{os_ssh_assert, os_ssh_bytes_equal}

extern fn serial_println(msg: text)

# ============================================================================
# H. SSH Cipher Tests (20)
# ============================================================================

fn _make_test_session_keys() -> SshSessionKeys:
    """Create fixed session keys for cipher testing."""
    # 32-byte encryption keys (fixed pattern for determinism)
    var enc_c2s: [u8] = [
        0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08,
        0x09, 0x0A, 0x0B, 0x0C, 0x0D, 0x0E, 0x0F, 0x10,
        0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17, 0x18,
        0x19, 0x1A, 0x1B, 0x1C, 0x1D, 0x1E, 0x1F, 0x20
    ]
    var enc_s2c: [u8] = [
        0x21, 0x22, 0x23, 0x24, 0x25, 0x26, 0x27, 0x28,
        0x29, 0x2A, 0x2B, 0x2C, 0x2D, 0x2E, 0x2F, 0x30,
        0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37, 0x38,
        0x39, 0x3A, 0x3B, 0x3C, 0x3D, 0x3E, 0x3F, 0x40
    ]
    # 12-byte IVs
    var iv_c2s: [u8] = [0xA1, 0xA2, 0xA3, 0xA4, 0xA5, 0xA6, 0xA7, 0xA8, 0xA9, 0xAA, 0xAB, 0xAC]
    var iv_s2c: [u8] = [0xB1, 0xB2, 0xB3, 0xB4, 0xB5, 0xB6, 0xB7, 0xB8, 0xB9, 0xBA, 0xBB, 0xBC]
    # 32-byte MAC keys
    var mac_c2s: [u8] = [
        0xC1, 0xC2, 0xC3, 0xC4, 0xC5, 0xC6, 0xC7, 0xC8,
        0xC9, 0xCA, 0xCB, 0xCC, 0xCD, 0xCE, 0xCF, 0xD0,
        0xD1, 0xD2, 0xD3, 0xD4, 0xD5, 0xD6, 0xD7, 0xD8,
        0xD9, 0xDA, 0xDB, 0xDC, 0xDD, 0xDE, 0xDF, 0xE0
    ]
    var mac_s2c: [u8] = [
        0xE1, 0xE2, 0xE3, 0xE4, 0xE5, 0xE6, 0xE7, 0xE8,
        0xE9, 0xEA, 0xEB, 0xEC, 0xED, 0xEE, 0xEF, 0xF0,
        0xF1, 0xF2, 0xF3, 0xF4, 0xF5, 0xF6, 0xF7, 0xF8,
        0xF9, 0xFA, 0xFB, 0xFC, 0xFD, 0xFE, 0xFF, 0x00
    ]
    SshSessionKeys(
        iv_c2s: iv_c2s,
        iv_s2c: iv_s2c,
        enc_key_c2s: enc_c2s,
        enc_key_s2c: enc_s2c,
        mac_key_c2s: mac_c2s,
        mac_key_s2c: mac_s2c
    )

pub fn os_ssh_test_cipher():
    serial_println("--- H. Cipher ---")

    # H1: SshCipher.new() not active
    var c1 = SshCipher.new()
    os_ssh_assert(not c1.active, "H1: New cipher not active")

    # H2: Activate sets active=true
    var c2 = SshCipher.new()
    var keys2 = _make_test_session_keys()
    c2.activate(keys2)
    os_ssh_assert(c2.active, "H2: Activate sets active=true")

    # H3: AES-GCM encrypt output > payload
    var c3 = SshCipher.new()
    var keys3 = _make_test_session_keys()
    c3.activate(keys3)
    var h3_payload: [u8] = [0x01, 0x02, 0x03, 0x04, 0x05]
    var h3_encrypted = c3.encrypt_packet(h3_payload)
    os_ssh_assert(h3_encrypted.len() > h3_payload.len(), "H3: AES-GCM encrypted > payload")

    # H4: AES-GCM encrypt then decrypt round-trip
    var c4_enc = SshCipher.new()
    var keys4_enc = _make_test_session_keys()
    c4_enc.activate(keys4_enc)
    var h4_payload: [u8] = [0x10, 0x20, 0x30, 0x40]
    var h4_encrypted = c4_enc.encrypt_packet(h4_payload)
    # For decrypt: cipher uses c2s direction, so we need to set up keys
    # such that encrypt (s2c) and decrypt (c2s) use the same key pair.
    # Use a symmetric key setup: set c2s keys = s2c keys
    var c4_dec = SshCipher.new()
    var keys4_dec = SshSessionKeys(
        iv_c2s: keys4_enc.iv_s2c,
        iv_s2c: keys4_enc.iv_s2c,
        enc_key_c2s: keys4_enc.enc_key_s2c,
        enc_key_s2c: keys4_enc.enc_key_s2c,
        mac_key_c2s: keys4_enc.mac_key_s2c,
        mac_key_s2c: keys4_enc.mac_key_s2c
    )
    c4_dec.activate(keys4_dec)
    var h4_decrypted = c4_dec.decrypt_packet(h4_encrypted)
    if h4_decrypted.is_ok():
        var h4_plain = h4_decrypted.unwrap()
        os_ssh_assert(os_ssh_bytes_equal(h4_plain, h4_payload), "H4: AES-GCM round-trip matches")
    else:
        os_ssh_assert(false, "H4: AES-GCM round-trip (decrypt error)")

    # H5: AES-GCM decrypt tampered data
    var c5_enc = SshCipher.new()
    var keys5_enc = _make_test_session_keys()
    c5_enc.activate(keys5_enc)
    var h5_payload: [u8] = [0xAA, 0xBB, 0xCC]
    var h5_encrypted = c5_enc.encrypt_packet(h5_payload)
    # Tamper with a byte in the ciphertext
    if h5_encrypted.len() > 10:
        h5_encrypted[10] = h5_encrypted[10] ^ 0xFF
    var c5_dec = SshCipher.new()
    var keys5_dec = SshSessionKeys(
        iv_c2s: keys5_enc.iv_s2c,
        iv_s2c: keys5_enc.iv_s2c,
        enc_key_c2s: keys5_enc.enc_key_s2c,
        enc_key_s2c: keys5_enc.enc_key_s2c,
        mac_key_c2s: keys5_enc.mac_key_s2c,
        mac_key_s2c: keys5_enc.mac_key_s2c
    )
    c5_dec.activate(keys5_dec)
    var h5_result = c5_dec.decrypt_packet(h5_encrypted)
    os_ssh_assert(h5_result.is_err(), "H5: AES-GCM tampered data is error")

    # H6: AES-GCM decrypt too-short
    var c6 = SshCipher.new()
    var keys6 = _make_test_session_keys()
    c6.activate(keys6)
    var h6_short: [u8] = [0x00, 0x00, 0x00, 0x01]
    var h6_result = c6.decrypt_packet(h6_short)
    os_ssh_assert(h6_result.is_err(), "H6: AES-GCM too-short is error")

    # H7: AES-GCM seq increments after encrypt
    var c7 = SshCipher.new()
    var keys7 = _make_test_session_keys()
    c7.activate(keys7)
    os_ssh_assert(c7.seq_s2c == 0, "H7a: seq_s2c starts at 0")
    var h7_payload: [u8] = [0x01]
    c7.encrypt_packet(h7_payload)
    os_ssh_assert(c7.seq_s2c == 1, "H7: seq_s2c increments after encrypt")

    # H8: AES-GCM seq increments after decrypt
    var c8_enc = SshCipher.new()
    var keys8_enc = _make_test_session_keys()
    c8_enc.activate(keys8_enc)
    var h8_payload: [u8] = [0x02]
    var h8_encrypted = c8_enc.encrypt_packet(h8_payload)
    var c8_dec = SshCipher.new()
    var keys8_dec = SshSessionKeys(
        iv_c2s: keys8_enc.iv_s2c,
        iv_s2c: keys8_enc.iv_s2c,
        enc_key_c2s: keys8_enc.enc_key_s2c,
        enc_key_s2c: keys8_enc.enc_key_s2c,
        mac_key_c2s: keys8_enc.mac_key_s2c,
        mac_key_s2c: keys8_enc.mac_key_s2c
    )
    c8_dec.activate(keys8_dec)
    os_ssh_assert(c8_dec.seq_c2s == 0, "H8a: seq_c2s starts at 0")
    c8_dec.decrypt_packet(h8_encrypted)
    os_ssh_assert(c8_dec.seq_c2s == 1, "H8: seq_c2s increments after decrypt")

    # H9: ChaCha20 activate sets mode
    var c9 = SshCipher.new()
    var keys9 = _make_test_session_keys()
    c9.activate_chacha20(keys9)
    os_ssh_assert(c9.active, "H9: ChaCha20 activate sets active")

    # H10: ChaCha20 encrypt output > payload
    var c10 = SshCipher.new()
    var keys10 = _make_test_session_keys()
    c10.activate_chacha20(keys10)
    var h10_payload: [u8] = [0x01, 0x02, 0x03, 0x04, 0x05]
    var h10_encrypted = c10.encrypt_packet(h10_payload)
    os_ssh_assert(h10_encrypted.len() > h10_payload.len(), "H10: ChaCha20 encrypted > payload")

    # H11: ChaCha20 encrypt/decrypt round-trip
    var c11_enc = SshCipher.new()
    var keys11_enc = _make_test_session_keys()
    c11_enc.activate_chacha20(keys11_enc)
    var h11_payload: [u8] = [0x10, 0x20, 0x30, 0x40]
    var h11_encrypted = c11_enc.encrypt_packet(h11_payload)
    var c11_dec = SshCipher.new()
    var keys11_dec = SshSessionKeys(
        iv_c2s: keys11_enc.iv_s2c,
        iv_s2c: keys11_enc.iv_s2c,
        enc_key_c2s: keys11_enc.enc_key_s2c,
        enc_key_s2c: keys11_enc.enc_key_s2c,
        mac_key_c2s: keys11_enc.mac_key_s2c,
        mac_key_s2c: keys11_enc.mac_key_s2c
    )
    c11_dec.activate_chacha20(keys11_dec)
    var h11_decrypted = c11_dec.decrypt_packet(h11_encrypted)
    if h11_decrypted.is_ok():
        var h11_plain = h11_decrypted.unwrap()
        os_ssh_assert(os_ssh_bytes_equal(h11_plain, h11_payload), "H11: ChaCha20 round-trip matches")
    else:
        os_ssh_assert(false, "H11: ChaCha20 round-trip (decrypt error)")

    # H12: ChaCha20 decrypt tampered
    var c12_enc = SshCipher.new()
    var keys12_enc = _make_test_session_keys()
    c12_enc.activate_chacha20(keys12_enc)
    var h12_payload: [u8] = [0xAA, 0xBB, 0xCC]
    var h12_encrypted = c12_enc.encrypt_packet(h12_payload)
    if h12_encrypted.len() > 10:
        h12_encrypted[10] = h12_encrypted[10] ^ 0xFF
    var c12_dec = SshCipher.new()
    var keys12_dec = SshSessionKeys(
        iv_c2s: keys12_enc.iv_s2c,
        iv_s2c: keys12_enc.iv_s2c,
        enc_key_c2s: keys12_enc.enc_key_s2c,
        enc_key_s2c: keys12_enc.enc_key_s2c,
        mac_key_c2s: keys12_enc.mac_key_s2c,
        mac_key_s2c: keys12_enc.mac_key_s2c
    )
    c12_dec.activate_chacha20(keys12_dec)
    var h12_result = c12_dec.decrypt_packet(h12_encrypted)
    os_ssh_assert(h12_result.is_err(), "H12: ChaCha20 tampered is error")

    # H13: ChaCha20 decrypt too-short
    var c13 = SshCipher.new()
    var keys13 = _make_test_session_keys()
    c13.activate_chacha20(keys13)
    var h13_short: [u8] = [0x00, 0x00, 0x00, 0x01]
    var h13_result = c13.decrypt_packet(h13_short)
    os_ssh_assert(h13_result.is_err(), "H13: ChaCha20 too-short is error")

    # H14: ChaCha20 seq increments
    var c14 = SshCipher.new()
    var keys14 = _make_test_session_keys()
    c14.activate_chacha20(keys14)
    var h14_payload: [u8] = [0x01]
    c14.encrypt_packet(h14_payload)
    os_ssh_assert(c14.seq_s2c == 1, "H14: ChaCha20 seq increments after encrypt")

    # H15: Two encrypts differ (seq nonce changes)
    var c15 = SshCipher.new()
    var keys15 = _make_test_session_keys()
    c15.activate(keys15)
    var h15_payload: [u8] = [0x42, 0x42, 0x42]
    var h15_enc1 = c15.encrypt_packet(h15_payload)
    var h15_enc2 = c15.encrypt_packet(h15_payload)
    var h15_differ = false
    var h15_i: u64 = 0
    var h15_min: u64 = h15_enc1.len()
    if h15_enc2.len() < h15_min:
        h15_min = h15_enc2.len()
    while h15_i < h15_min:
        if h15_enc1[h15_i] != h15_enc2[h15_i]:
            h15_differ = true
        h15_i = h15_i + 1
    os_ssh_assert(h15_differ, "H15: Two AES-GCM encrypts differ (seq nonce)")

    # H16: Empty payload AES-GCM round-trip
    var c16_enc = SshCipher.new()
    var keys16_enc = _make_test_session_keys()
    c16_enc.activate(keys16_enc)
    var h16_payload: [u8] = []
    var h16_encrypted = c16_enc.encrypt_packet(h16_payload)
    var c16_dec = SshCipher.new()
    var keys16_dec = SshSessionKeys(
        iv_c2s: keys16_enc.iv_s2c,
        iv_s2c: keys16_enc.iv_s2c,
        enc_key_c2s: keys16_enc.enc_key_s2c,
        enc_key_s2c: keys16_enc.enc_key_s2c,
        mac_key_c2s: keys16_enc.mac_key_s2c,
        mac_key_s2c: keys16_enc.mac_key_s2c
    )
    c16_dec.activate(keys16_dec)
    var h16_decrypted = c16_dec.decrypt_packet(h16_encrypted)
    if h16_decrypted.is_ok():
        var h16_plain = h16_decrypted.unwrap()
        os_ssh_assert(h16_plain.len() == 0, "H16: Empty AES-GCM round-trip")
    else:
        os_ssh_assert(false, "H16: Empty AES-GCM round-trip (error)")

    # H17: Empty payload ChaCha20 round-trip
    var c17_enc = SshCipher.new()
    var keys17_enc = _make_test_session_keys()
    c17_enc.activate_chacha20(keys17_enc)
    var h17_payload: [u8] = []
    var h17_encrypted = c17_enc.encrypt_packet(h17_payload)
    var c17_dec = SshCipher.new()
    var keys17_dec = SshSessionKeys(
        iv_c2s: keys17_enc.iv_s2c,
        iv_s2c: keys17_enc.iv_s2c,
        enc_key_c2s: keys17_enc.enc_key_s2c,
        enc_key_s2c: keys17_enc.enc_key_s2c,
        mac_key_c2s: keys17_enc.mac_key_s2c,
        mac_key_s2c: keys17_enc.mac_key_s2c
    )
    c17_dec.activate_chacha20(keys17_dec)
    var h17_decrypted = c17_dec.decrypt_packet(h17_encrypted)
    if h17_decrypted.is_ok():
        var h17_plain = h17_decrypted.unwrap()
        os_ssh_assert(h17_plain.len() == 0, "H17: Empty ChaCha20 round-trip")
    else:
        os_ssh_assert(false, "H17: Empty ChaCha20 round-trip (error)")

    # H18: Large payload (64 bytes) round-trip
    var c18_enc = SshCipher.new()
    var keys18_enc = _make_test_session_keys()
    c18_enc.activate(keys18_enc)
    var h18_payload: [u8] = []
    var h18_i: u64 = 0
    while h18_i < 64:
        h18_payload.push((h18_i & 0xFF).to_u8())
        h18_i = h18_i + 1
    var h18_encrypted = c18_enc.encrypt_packet(h18_payload)
    var c18_dec = SshCipher.new()
    var keys18_dec = SshSessionKeys(
        iv_c2s: keys18_enc.iv_s2c,
        iv_s2c: keys18_enc.iv_s2c,
        enc_key_c2s: keys18_enc.enc_key_s2c,
        enc_key_s2c: keys18_enc.enc_key_s2c,
        mac_key_c2s: keys18_enc.mac_key_s2c,
        mac_key_s2c: keys18_enc.mac_key_s2c
    )
    c18_dec.activate(keys18_dec)
    var h18_decrypted = c18_dec.decrypt_packet(h18_encrypted)
    if h18_decrypted.is_ok():
        var h18_plain = h18_decrypted.unwrap()
        os_ssh_assert(os_ssh_bytes_equal(h18_plain, h18_payload), "H18: 64-byte AES-GCM round-trip")
    else:
        os_ssh_assert(false, "H18: 64-byte AES-GCM round-trip (error)")

    # H19: AES-GCM nonce varies with seq (encrypt twice, check encrypted differs)
    var c19 = SshCipher.new()
    var keys19 = _make_test_session_keys()
    c19.activate(keys19)
    var h19_payload: [u8] = [0xFF]
    var h19_enc1 = c19.encrypt_packet(h19_payload)
    var h19_enc2 = c19.encrypt_packet(h19_payload)
    # At minimum the GCM tag should differ due to different nonces
    var h19_differ = false
    var h19_i: u64 = 4  # skip the 4-byte length header
    var h19_min: u64 = h19_enc1.len()
    if h19_enc2.len() < h19_min:
        h19_min = h19_enc2.len()
    while h19_i < h19_min:
        if h19_enc1[h19_i] != h19_enc2[h19_i]:
            h19_differ = true
        h19_i = h19_i + 1
    os_ssh_assert(h19_differ, "H19: AES-GCM nonce varies with seq")

    # H20: ChaCha20 nonce varies with seq
    var c20 = SshCipher.new()
    var keys20 = _make_test_session_keys()
    c20.activate_chacha20(keys20)
    var h20_payload: [u8] = [0xFF]
    var h20_enc1 = c20.encrypt_packet(h20_payload)
    var h20_enc2 = c20.encrypt_packet(h20_payload)
    var h20_differ = false
    var h20_i: u64 = 4
    var h20_min: u64 = h20_enc1.len()
    if h20_enc2.len() < h20_min:
        h20_min = h20_enc2.len()
    while h20_i < h20_min:
        if h20_enc1[h20_i] != h20_enc2[h20_i]:
            h20_differ = true
        h20_i = h20_i + 1
    os_ssh_assert(h20_differ, "H20: ChaCha20 nonce varies with seq")

    # H21: AES-GCM round-trip works with non-zero initial SSH sequence numbers
    var c21_enc = SshCipher.new()
    var keys21_enc = _make_test_session_keys()
    c21_enc.activate(keys21_enc, 4, 6)
    var h21_payload: [u8] = [0x50, 0x51, 0x52, 0x53]
    var h21_encrypted = c21_enc.encrypt_packet(h21_payload)
    var c21_dec = SshCipher.new()
    var keys21_dec = SshSessionKeys(
        iv_c2s: keys21_enc.iv_s2c,
        iv_s2c: keys21_enc.iv_s2c,
        enc_key_c2s: keys21_enc.enc_key_s2c,
        enc_key_s2c: keys21_enc.enc_key_s2c,
        mac_key_c2s: keys21_enc.mac_key_s2c,
        mac_key_s2c: keys21_enc.mac_key_s2c
    )
    c21_dec.activate(keys21_dec, 6, 6)
    var h21_decrypted = c21_dec.decrypt_packet(h21_encrypted)
    if h21_decrypted.is_ok():
        var h21_plain = h21_decrypted.unwrap()
        os_ssh_assert(os_ssh_bytes_equal(h21_plain, h21_payload), "H21: AES-GCM non-zero seq round-trip")
    else:
        os_ssh_assert(false, "H21: AES-GCM non-zero seq round-trip (error)")

# ============================================================================
# I. SSH KEX Tests (15)
# ============================================================================

pub fn os_ssh_test_kex():
    serial_println("--- I. KEX ---")

    # I1: ssh_kex_generate_keypair sizes
    var kp1 = ssh_kex_generate_keypair()
    os_ssh_assert(kp1.0.len() == 32 and kp1.1.len() == 32, "I1: Keypair sizes 32/32")

    # I2: Two keypairs differ
    var kp2 = ssh_kex_generate_keypair()
    var i2_differ = false
    var i2_i: u64 = 0
    while i2_i < 32:
        if kp1.1[i2_i] != kp2.1[i2_i]:
            i2_differ = true
        i2_i = i2_i + 1
    os_ssh_assert(i2_differ, "I2: Two keypairs have different public keys")

    # I3: ssh_kex_compute_shared 32 bytes
    var i3_shared = ssh_kex_compute_shared(kp1.0, kp2.1)
    os_ssh_assert(i3_shared.len() == 32, "I3: Shared secret is 32 bytes")

    # I4: DH agreement (both sides compute same shared secret)
    var i4_shared_a = ssh_kex_compute_shared(kp1.0, kp2.1)
    var i4_shared_b = ssh_kex_compute_shared(kp2.0, kp1.1)
    os_ssh_assert(os_ssh_bytes_equal(i4_shared_a, i4_shared_b), "I4: DH agreement (both sides same)")

    # I5: Exchange hash is 32 bytes (SHA-256)
    var i5_client_ver = "SSH-2.0-TestClient"
    var i5_server_ver = "SSH-2.0-TestServer"
    var i5_client_kexinit: [u8] = [20, 0x01, 0x02, 0x03]
    var i5_server_kexinit: [u8] = [20, 0x04, 0x05, 0x06]
    var i5_host_key: [u8] = [0x10, 0x20, 0x30]
    var i5_hash = ssh_kex_compute_exchange_hash(
        i5_client_ver, i5_server_ver,
        i5_client_kexinit, i5_server_kexinit,
        i5_host_key, kp1.1, kp2.1, i3_shared
    )
    os_ssh_assert(i5_hash.len() == 32, "I5: Exchange hash is 32 bytes")

    # I6: Exchange hash is deterministic
    var i6_hash = ssh_kex_compute_exchange_hash(
        i5_client_ver, i5_server_ver,
        i5_client_kexinit, i5_server_kexinit,
        i5_host_key, kp1.1, kp2.1, i3_shared
    )
    os_ssh_assert(os_ssh_bytes_equal(i5_hash, i6_hash), "I6: Exchange hash deterministic")

    # I7: Different inputs produce different hash
    var i7_different_host: [u8] = [0xFF, 0xFE, 0xFD]
    var i7_hash = ssh_kex_compute_exchange_hash(
        i5_client_ver, i5_server_ver,
        i5_client_kexinit, i5_server_kexinit,
        i7_different_host, kp1.1, kp2.1, i3_shared
    )
    os_ssh_assert(not os_ssh_bytes_equal(i5_hash, i7_hash), "I7: Different inputs produce different hash")

    # I8: ssh_derive_keys all 6 fields present
    var i8_keys = ssh_derive_keys(i3_shared, i5_hash, i5_hash)
    var i8_has_all = (i8_keys.iv_c2s.len() > 0
        and i8_keys.iv_s2c.len() > 0
        and i8_keys.enc_key_c2s.len() > 0
        and i8_keys.enc_key_s2c.len() > 0
        and i8_keys.mac_key_c2s.len() > 0
        and i8_keys.mac_key_s2c.len() > 0)
    os_ssh_assert(i8_has_all, "I8: Derived keys all 6 fields present")

    # I9: IV is 12 bytes
    os_ssh_assert(i8_keys.iv_c2s.len() == 12 and i8_keys.iv_s2c.len() == 12, "I9: IV is 12 bytes")

    # I10: Enc key is 32 bytes
    os_ssh_assert(i8_keys.enc_key_c2s.len() == 32 and i8_keys.enc_key_s2c.len() == 32, "I10: Enc key is 32 bytes")

    # I11: ssh_build_kex_ecdh_reply valid
    var i11_host_blob: [u8] = [0x01, 0x02, 0x03, 0x04]
    var i11_server_pub: [u8] = [0x05, 0x06, 0x07, 0x08]
    var i11_signature: [u8] = [0x09, 0x0A, 0x0B, 0x0C]
    var i11_reply = ssh_build_kex_ecdh_reply(i11_host_blob, i11_server_pub, i11_signature)
    os_ssh_assert(i11_reply[0] == 31, "I11: KEX_ECDH_REPLY type == 31")

    # I12: ssh_parse_kex_ecdh_init too-short
    var i12_short: [u8] = [30]
    var i12_result = ssh_parse_kex_ecdh_init(i12_short)
    os_ssh_assert(i12_result.is_err(), "I12: KEX_ECDH_INIT too-short is error")

    # I13: ssh_parse_kex_ecdh_init wrong type
    var i13_wrong: [u8] = [99, 0, 0, 0, 4, 0x01, 0x02, 0x03, 0x04]
    var i13_result = ssh_parse_kex_ecdh_init(i13_wrong)
    os_ssh_assert(i13_result.is_err(), "I13: KEX_ECDH_INIT wrong type is error")

    # I14: ssh_build_newkeys is [21]
    var i14_newkeys = ssh_build_newkeys()
    os_ssh_assert(i14_newkeys.len() == 1 and i14_newkeys[0] == 21, "I14: NEWKEYS == [21]")

    # I15: Derive key > 32 bytes works (mac keys are 32 bytes, test enc key derivation works)
    var i15_keys = ssh_derive_keys(i3_shared, i5_hash, i5_hash)
    os_ssh_assert(i15_keys.mac_key_c2s.len() == 32 and i15_keys.mac_key_s2c.len() == 32, "I15: MAC keys are 32 bytes")

# ============================================================================
# M. SSH MPint Tests (5)
# ============================================================================

pub fn os_ssh_test_mpint():
    serial_println("--- M. MPint ---")

    # M1: ssh_put_mpint zero
    var m1_buf: [u8] = []
    var m1_zero: [u8] = [0x00]
    ssh_put_mpint(m1_buf, m1_zero)
    # Zero value encodes as length=0 (4 bytes of 0x00)
    os_ssh_assert(m1_buf.len() == 4, "M1: mpint zero is 4 bytes (length only)")
    var m1_len: u32 = ssh_get_u32(m1_buf, 0)
    os_ssh_assert(m1_len == 0, "M1b: mpint zero length field == 0")

    # M2: ssh_put_mpint small positive (0x42)
    var m2_buf: [u8] = []
    var m2_val: [u8] = [0x42]
    ssh_put_mpint(m2_buf, m2_val)
    # length=1, data=0x42
    var m2_len: u32 = ssh_get_u32(m2_buf, 0)
    os_ssh_assert(m2_len == 1, "M2: mpint 0x42 length == 1")
    os_ssh_assert(m2_buf[4] == 0x42, "M2b: mpint 0x42 data byte")

    # M3: ssh_put_mpint high-bit value (0x80) needs 0x00 prefix
    var m3_buf: [u8] = []
    var m3_val: [u8] = [0x80]
    ssh_put_mpint(m3_buf, m3_val)
    var m3_len: u32 = ssh_get_u32(m3_buf, 0)
    os_ssh_assert(m3_len == 2, "M3: mpint 0x80 length == 2 (0x00 prefix)")
    os_ssh_assert(m3_buf[4] == 0x00 and m3_buf[5] == 0x80, "M3b: mpint 0x80 has 0x00 prefix")

    # M4: ssh_put_mpint leading zeros stripped
    var m4_buf: [u8] = []
    var m4_val: [u8] = [0x00, 0x00, 0x00, 0x42]
    ssh_put_mpint(m4_buf, m4_val)
    var m4_len: u32 = ssh_get_u32(m4_buf, 0)
    os_ssh_assert(m4_len == 1, "M4: mpint leading zeros stripped, length == 1")
    os_ssh_assert(m4_buf[4] == 0x42, "M4b: mpint data == 0x42 after stripping")

    # M5: ssh_put_mpint 32-byte value
    var m5_buf: [u8] = []
    var m5_val: [u8] = [
        0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08,
        0x09, 0x0A, 0x0B, 0x0C, 0x0D, 0x0E, 0x0F, 0x10,
        0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17, 0x18,
        0x19, 0x1A, 0x1B, 0x1C, 0x1D, 0x1E, 0x1F, 0x20
    ]
    ssh_put_mpint(m5_buf, m5_val)
    var m5_len: u32 = ssh_get_u32(m5_buf, 0)
    # First byte 0x01 has high bit clear, so no prefix needed
    os_ssh_assert(m5_len == 32, "M5: mpint 32-byte value length == 32")
    os_ssh_assert(m5_buf[4] == 0x01, "M5b: mpint 32-byte first data byte == 0x01")

export os_ssh_test_cipher, os_ssh_test_kex, os_ssh_test_mpint
