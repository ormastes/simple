# @platform: all
# Reproducing spec for: `?` on a bare `nil` Option.
#
# Before the fix the interpreter's try-operator had no `Value::Nil` arm and
# failed with:
#   semantic: invalid operation: ? operator requires Result or Option type, got nil
# even though `nil` is the interpreter's own representation of Option::None
# (see `try_unwrap_option_or_result` in interpreter/expr.rs).

fn none_via_nil() -> Option<i64>:
    return nil

fn use_try_on_nil() -> Option<i64>:
    val v = none_via_nil()?
    return Some(v + 1)

describe "Try operator on bare nil Option":
    it "propagates nil as None instead of erroring":
        val result = use_try_on_nil()
        val is_none = result.is_none()
        expect(is_none).to_equal(true)
