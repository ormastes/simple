"""GPU MMU operator scenario.

use std.spec
use std.common.compute.placement_contracts.schema.{
    PLACEMENT_SCHEMA_VERSION,
    PLACEMENT_NO_SLOT,
    PLACEMENT_NO_EPOCH,
    PLACEMENT_SCHEMA_ID,
    residency_tier_to_u8,
    residency_tier_from_u8,
    residency_tier_name,
    residency_tier_is_device,
    RESIDENCY_TIER_MAX
}
use std.common.compute.placement_contracts.planner.{PlacementBudget, PlacementRequest}
use std.common.compute.placement_contracts.handles.{ObjectRef}
use std.common.compute.placement_contracts.backend.{PlacementError}
use std.common.compute.placement_contracts.storage.{artifact_id}
use std.common.compute.placement_contracts.semantic.{
    AccessPattern,
    AffinityGroupId,
    AnyObject,
    CostUnit,
    DeviceMask,
    ObjectSetView,
    PersistencePolicy,
    ResidencyTierSet,
    StageEpoch
}
use std.nogc_async_mut.gpu.store.{CasStore, cas_store_recover}
use std.nogc_async_mut.gpu.placement_backends.{
    make_deterministic_plan,
    StagedPlacementBackend,
    DirectPlacementBackend,
    DeviceInitiatedPlacementBackend
}
use std.nogc_async_mut.gpu.placement_backends.staged_backend.{staged_plan}
use std.nogc_async_mut.io.env_ops.{env_get}
use std.nogc_async_mut.gpu.object_vm.descriptor_table.{
    ObjectVmFault,
    object_vm_table_empty,
    object_vm_define,
    object_vm_retire,
    object_vm_acquire_lease,
    object_vm_release_lease,
    object_vm_resolve,
    object_vm_set_pinned,
    object_vm_pin,
    object_vm_object_ref,
    object_vm_resident_view,
    object_vm_handles_stale,
    object_vm_device_bytes,
    object_vm_fault_to_u8
}
# Planner symbols live in residency_model, not descriptor_table; importing them
# from the descriptor_table path left every planner scenario failing with
# "function not found" under the run engine.
use std.nogc_async_mut.gpu.object_vm.residency_model.{
    ObjectVmDecisionKind,
    object_vm_plan_residency,
    object_vm_plan_receipt,
    object_vm_residency_request
}

class RssProbeEvidence:
    status: text
    corpus_count: i64
    runtime_base_bytes: i64
    peak_host_rss_bytes: i64
    staging_high_water: i64
    staging_budget_bytes: i64
    driver_queue_budget_bytes: i64
    manifest_cache_bytes: i64
    elapsed_us: i64
    reason: text

fn _field(record: text, name: text) -> text:
    val prefix = "{name}="
    for part in record.split(" "):
        if part.starts_with(prefix): return part.slice(prefix.len(), part.len())
    ""

fn _rss_evidence(stdout: text) -> RssProbeEvidence:
    var record = ""
    for line in stdout.split("\n"):
        if line.starts_with("gpu-mmu-rss/v1 "): record = line
    RssProbeEvidence(
        status: _field(record, "status"),
        corpus_count: _field(record, "corpus_count").to_i64() ?? 0,
        runtime_base_bytes: _field(record, "runtime_base_bytes").to_i64() ?? 0,
        peak_host_rss_bytes: _field(record, "peak_host_rss_bytes").to_i64() ?? 0,
        staging_high_water: _field(record, "staging_high_water").to_i64() ?? 0,
        staging_budget_bytes: _field(record, "staging_budget_bytes").to_i64() ?? 0,
        driver_queue_budget_bytes: _field(record, "driver_queue_budget_bytes").to_i64() ?? 0,
        manifest_cache_bytes: _field(record, "manifest_cache_bytes").to_i64() ?? 0,
        elapsed_us: _field(record, "elapsed_us").to_i64() ?? 0,
        reason: _field(record, "reason")
    )

fn _run_rss_probe(corpus_count: i64) -> RssProbeEvidence:
    val simple_binary = env_get("SIMPLE_BINARY")
    if simple_binary == "": fail("SIMPLE_BINARY must name an admitted pure-Simple full CLI")
    val result = process_run_timeout(simple_binary, ["run", RSS_PROBE, "{corpus_count}"], 120000)
    expect(result.2).to_equal(0)
    _rss_evidence(result.0)

fn setup_gpu_mmu_fixture() -> DescriptorTable:
    DescriptorTable.create()

fn setup_gpu_mmu_store_fixture(name: text) -> (text, GpuCasStore):
    val root = "/tmp/simple_gpu_mmu_system_{name}"
    dir_remove_all(root)
    val store = match GpuCasStore.create(root):
        case Ok(value): value
        case Err(message): fail(message)
    (root, store)

fn expect_stale_access_fault(vm: DescriptorTable, view: ResidentView<u8>):
    expect(vm.view_status(view)).to_equal("stale-lease")

fn expect_protected_object_resident(vm: DescriptorTable, object: ObjectRef<AnyObject>):
    expect(vm.evict(object).status).to_equal("protected")

fn expect_recovery_result(root: text):
    match GpuCasStore.open(root):
        case Ok(_): fail("corrupt GPU MMU store opened")
        case Err(message): expect(message).to_start_with("gpu_cas:")

fn expect_cas_blob_id(id: CasBlobId, byte_len: i64):
    expect(id.digest.len()).to_equal(64)
    expect(id.byte_len).to_equal(byte_len)

fn expect_stage_receipt(receipt: TransferReceipt, sequence: i64, ring_slot: i64, checksum: text):
    expect(receipt.completed).to_be(true)
    expect(receipt.sequence).to_equal(sequence)
    expect(receipt.ring_slot).to_equal(ring_slot)
    expect(receipt.bytes_transferred).to_equal(4)
    expect(receipt.checksum).to_equal(checksum)

fn _budget() -> PlacementBudget:
    PlacementBudget(
        device_bytes: 8, host_pinned_bytes: 16, host_hot_bytes: 8,
        staging_bytes: 16, driver_queue_bytes: 32, manifest_cache_bytes: 16,
        runtime_base_bytes: 64
    )

fn _placement_request(object_slot: u32, recompute_cost: u64, transfer_cost: u64, reuse_distance: u32) -> PlacementRequest:
    PlacementRequest(
        object: object_ref<AnyObject>(object_slot, 1u32),
        access: AccessPattern.ReadMostly,
        required_tiers: ResidencyTierSet(tiers: []),
        preferred_tiers: [ResidencyTier.DeviceLocal],
        device_mask: DeviceMask(bits: 1u64),
        expected_first_use: StageEpoch(value: 0u64),
        expected_last_use: StageEpoch(value: 10u64),
        expected_reuse_distance: reuse_distance,
        recompute_cost: CostUnit(value: recompute_cost),
        transfer_cost_hint: CostUnit(value: transfer_cost),
        persistence: PersistencePolicy.Recomputable,
        affinity_group: AffinityGroupId(value: 7u64),
        deadline: nil
    )

fn _placement_states() -> [PlacementObjectState]:
    [
        placement_object_state(_placement_request(1u32, 100u64, 10u64, 1u32), 8, false, false),
        placement_object_state(_placement_request(2u32, 5u64, 20u64, 50u32), 8, false, false)
    ]

fn _placement_result() -> PlacementPlanResult:
    placement_plan_states(_placement_states(), _budget())

fn expect_placement_plan(first: PlacementPlanResult, second: PlacementPlanResult):
    expect(first.ok).to_be(true)
    expect(first.operations.reservations.len()).to_equal(1)
    expect(first.operations.reservations[0].object.object_slot).to_equal(1u32)
    expect(first.operations.reservations[0].tier).to_equal(ResidencyTier.DeviceLocal)
    expect(first.operations.reservations[0].bytes).to_equal(8)
    expect(first.operations.transfers.len()).to_equal(1)
    expect(first.operations.transfers[0].receipt_sequence).to_equal(0)
    expect(first.operations.evictions.len()).to_equal(1)
    expect(first.operations.evictions[0].object.object_slot).to_equal(2u32)
    expect(first.operations.prefetches.len()).to_equal(1)
    expect(first.operations.leases.len()).to_equal(1)
    expect(first.plan.estimated_cost.host_to_device_bytes).to_equal(8u64)
    expect(first.plan.estimated_cost.ssd_read_bytes).to_equal(8u64)
    expect(first.plan.estimated_cost.synchronization_points).to_equal(1u32)
    expect(first.plan.estimated_cost.predicted_latency_us).to_equal(15u64)
    expect(first.plan.receipt_seed.value.len()).to_equal(64)
    expect(first.plan.receipt_seed.value).to_equal(second.plan.receipt_seed.value)
    expect(first.plan.estimated_cost.predicted_latency_us).to_equal(second.plan.estimated_cost.predicted_latency_us)

describe "GPU MMU contract surface (system-level)":
    it "stamps a frozen schema and wire-order constants":
        expect(PLACEMENT_SCHEMA_VERSION).to_equal("simple-placement-contracts-v1")
        expect(PLACEMENT_SCHEMA_ID).to_equal(1)
        expect(PLACEMENT_NO_SLOT).to_equal(4294967295)
        expect(PLACEMENT_NO_EPOCH).to_equal(4294967295)
        expect(RESIDENCY_TIER_MAX).to_equal(6)
        expect(residency_tier_to_u8(residency_tier_from_u8(3))).to_equal(3)
        expect(residency_tier_name(5)).to_equal("SsdCas")
        expect(residency_tier_name(7)).to_equal("InvalidTier")
        expect(residency_tier_is_device(TIER_DEVICE_LOCAL)).to_equal(true)
        expect(residency_tier_is_device(TIER_SSD_CAS)).to_equal(false)

    it "keeps object-vm fault enums stable":
        expect(ObjectVmFault.NoFault).to_not_equal(ObjectVmFault.StaleGeneration)
        expect(object_vm_fault_to_u8(ObjectVmFault.NoFault)).to_equal(0)
        expect(object_vm_fault_to_u8(ObjectVmFault.UnknownSlot)).to_equal(1)
        expect(object_vm_fault_to_u8(ObjectVmFault.StaleGeneration)).to_equal(2)
        expect(object_vm_fault_to_u8(ObjectVmFault.StaleLease)).to_equal(3)

describe "GPU MMU explicit residency and placement":
    # @req REQ-001 REQ-002
    it "should resolve an arena and expose bytes only through an active lease":
        step("Create arena handles and acquire a lease")
        var vm = setup_gpu_mmu_fixture()
        val object = vm.create_arena([11u8, 22u8, 33u8], 2, ResidencyTier.DeviceLocal)
        val resolved = vm.resolve(object)
        expect(resolved.status).to_equal("ok")
        expect(resolved.byte_len).to_equal(3)
        expect(resolved.entity_count).to_equal(2)
        val entity = match vm.entity_ref(object, 1):
            case Some(value): value
            case nil: fail("entity handle unavailable")
        expect(vm.resolve_entity(object, entity).status).to_equal("ok")
        val view = match vm.acquire(object):
            case Some(value): value
            case nil: fail("resident lease unavailable")
        expect(view.device_address).to_be_greater_than(0)
        expect(vm.read_byte(view, 1).value).to_equal(22u8)

describe "GPU MMU handles and leases":
    it "resolves a live device arena and rejects stale lease reads":
        val d = object_vm_define(object_vm_table_empty(), TIER_DEVICE_LOCAL, TIER_HOST_COLD, 1024, 5)
        expect(d.ok).to_equal(true)

        val linker_input = LinkerInputPort(
            object_file_count: 1, library_count: 0, output_type: "executable",
            output_path: "build/gpu-mmu-consumer",
            input_residency: ArenaResidency(
                object: object_ref<AnyObject>(103u32, 4u32),
                entity_count: 1u64, byte_len: 128u64
            )
        )
        val linker_output = LinkerOutputPort(
            output_path: "build/gpu-mmu-consumer", output_size_bytes: 256,
            success: true, error_message: "",
            output_residency: ArenaResidency(
                object: object_ref<AnyObject>(104u32, 5u32),
                entity_count: 1u64, byte_len: 256u64
            )
        )
        expect(linker_input.input_residency.object.object_slot).to_equal(103u32)
        expect(linker_output.output_residency.object.generation).to_equal(5u32)
        expect(linker_output.output_residency.byte_len).to_equal(256u64)

        val ok = object_vm_resolve(lease.table, d.slot, d.generation, lease.resolve.lease_epoch)
        expect(ok.ok).to_equal(true)
        expect(ok.device_address > 0).to_be(true)
        expect(ok.length).to_equal(1024)
        expect(ok.slot).to_equal(d.slot)

        val web_result = simple_web_layout_render_html_draw_ir_result(
            "<main>resident</main>", 64, 32
        )
        val resident_web = simple_web_layout_bind_arena_residency(
            web_result,
            ArenaResidency(
                object: object_ref<Style>(106u32, 7u32),
                entity_count: web_result.base_styles.len() as u64,
                byte_len: 1024u64
            ),
            ArenaResidency(
                object: object_ref<LayoutResult>(107u32, 8u32),
                entity_count: web_result.raw_boxes.bx.len() as u64,
                byte_len: 512u64
            )
        )
        match resident_web.style_residency:
            case Some(actual): expect(actual.object.object_slot).to_equal(106u32)
            case nil: fail("style result dropped arena residency")
        match resident_web.layout_residency:
            case Some(actual): expect(actual.object.object_slot).to_equal(107u32)
            case nil: fail("web layout result dropped arena residency")

        val scene_request = draw_ir_v3_empty_request()
        val scene_plan = draw_ir_v3_plan_emission(scene_request)
        val scene_result = draw_ir_v3_emit(
            scene_request, scene_plan, 108u32, 9u32,
            ArenaResidency(
                object: object_ref<DrawIrV3Scene>(108u32, 9u32),
                entity_count: 0u64, byte_len: 0u64
            )
        )
        match scene_result.scene_residency:
            case Some(actual):
                expect(actual.object.object_slot).to_equal(108u32)
                expect(actual.object.generation).to_equal(9u32)
            case nil: fail("WebScene result dropped arena residency")

    it "distinguishes missing and stale-generation handles":
        val d = object_vm_define(object_vm_table_empty(), TIER_DEVICE_LOCAL, TIER_HOST_COLD, 256, 1)
        val missing_slot = object_vm_resolve(d.table, 999, 1, 0)
        expect(missing_slot.ok).to_equal(false)
        expect(missing_slot.fault).to_equal(ObjectVmFault.UnknownSlot)

        val stale = object_vm_resolve(d.table, d.slot, d.generation + 5, 0)
        expect(stale.ok).to_equal(false)
        expect(stale.fault).to_equal(ObjectVmFault.StaleGeneration)

# ----------------------------------------------------------------------------
# 3) Planner decisions and receipts.
# ----------------------------------------------------------------------------

describe "GPU MMU planner":
    it "admits a miss with explicit deterministic receipt and stamps plan metadata":
        val t = object_vm_define(object_vm_table_empty(), TIER_HOST_COLD, TIER_HOST_COLD, 1024, 0)
        val plan = object_vm_plan_residency(t.table, _budget(2048), [object_vm_residency_request(t.slot, t.generation, 7)])

        expect(plan.ok).to_equal(true)
        expect(plan.admit_count).to_equal(1)
        expect(plan.hit_count).to_equal(0)
        expect(plan.reject_count).to_equal(0)
        expect(plan.device_bytes_used).to_equal(1024)
        expect(plan.decisions.len()).to_equal(1)
        expect(_kind(plan.decisions[0].kind)).to_equal(1)
        expect(plan.decisions[0].reason.contains("object_vm_residency_miss")).to_equal(true)
        expect(plan.schema_version).to_equal(PLACEMENT_SCHEMA_VERSION)
        expect(object_vm_plan_receipt(plan).contains("object_vm_residency_miss")).to_be(true)

    it "produces repeatable decisions when replaying the same request list":
        val t = object_vm_define(object_vm_table_empty(), TIER_HOST_COLD, TIER_HOST_COLD, 256, 0)
        val req = [object_vm_residency_request(t.slot, t.generation, 3)]
        val a = object_vm_plan_residency(t.table, _budget(1024), req)
        val b = object_vm_plan_residency(t.table, _budget(1024), req)

        expect(a.ok).to_equal(b.ok)
        expect(a.hit_count).to_equal(b.hit_count)
        expect(a.admit_count).to_equal(b.admit_count)
        expect(a.decisions.len()).to_equal(b.decisions.len())
        expect(a.decisions[0].slot).to_equal(b.decisions[0].slot)
        expect(a.decisions[0].reason).to_equal(b.decisions[0].reason)

    it "fails closed for zero device budget and preserves a machine-readable reason":
        val t = object_vm_define(object_vm_table_empty(), TIER_HOST_COLD, TIER_HOST_COLD, 128, 0)
        val plan = object_vm_plan_residency(t.table, _budget(0), [object_vm_residency_request(t.slot, t.generation, 1)])
        expect(plan.ok).to_equal(false)
        expect(plan.decisions.len()).to_equal(0)
        expect(plan.reason.contains("object_vm_budget_unset")).to_equal(true)
        expect(plan.reason.contains("PlacementBudget.device_bytes")).to_equal(true)
        expect(plan.reason).to_equal(object_vm_plan_receipt(plan))

    it "keeps pinned or leased device tables from eviction candidates":
        val a = object_vm_define(object_vm_table_empty(), TIER_DEVICE_LOCAL, TIER_HOST_COLD, 1024, 1)
        val pinned = object_vm_set_pinned(a.table, a.slot, true)
        expect(pinned.resolve.ok).to_equal(true)
        val b = object_vm_define(pinned.table, TIER_HOST_COLD, TIER_HOST_COLD, 1024, 1)
        val with_pinned = object_vm_plan_residency(b.table, _budget(1024), [object_vm_residency_request(b.slot, b.generation, 1)])
        expect(with_pinned.ok).to_equal(false)
        expect(with_pinned.reject_count).to_equal(1)
        expect(with_pinned.decisions[0].reason.contains("blocked_pinned=1")).to_be(true)
        expect(with_pinned.table.tier[a.slot]).to_equal(TIER_DEVICE_LOCAL)

        val c = object_vm_define(object_vm_table_empty(), TIER_DEVICE_LOCAL, TIER_HOST_COLD, 1024, 1)
        val leased = object_vm_acquire_lease(c.table, c.slot, c.generation)
        expect(leased.resolve.ok).to_equal(true)
        val d = object_vm_define(leased.table, TIER_HOST_COLD, TIER_HOST_COLD, 1024, 1)
        val with_leased = object_vm_plan_residency(d.table, _budget(1024), [object_vm_residency_request(d.slot, d.generation, 1)])
        expect(with_leased.ok).to_equal(false)
        expect(with_leased.reject_count).to_equal(1)
        expect(with_leased.decisions[0].reason.contains("blocked_leased=1")).to_be(true)

# ----------------------------------------------------------------------------
# 4) Typed handle bridge (gpu-mmu lane reconciliation).
# Ported from the lane's class-based DescriptorTable system spec onto the
# reconciled functional object_vm API plus the frozen handle contracts.
# ----------------------------------------------------------------------------

describe "GPU MMU typed handle bridge (system-level)":
    it "mints a typed resident view from a live lease through the frozen handle contracts":
        val d = object_vm_define(object_vm_table_empty(), TIER_DEVICE_LOCAL, TIER_HOST_COLD, 1024, 5)
        expect(d.ok).to_equal(true)
        val lease = object_vm_acquire_lease(d.table, d.slot, d.generation)
        expect(lease.resolve.ok).to_equal(true)
        val view = object_vm_resident_view(lease.resolve)
        val view_slot = view.object_slot as i64
        val view_len = view.length as i64
        val view_epoch = view.lease_epoch as i64
        expect(view_slot).to_equal(d.slot)
        expect(view_len).to_equal(1024)
        expect(view_epoch).to_equal(lease.resolve.lease_epoch)

    it "rejects stale typed handles and refuses retire of pinned or in-flight arenas":
        val d = object_vm_define(object_vm_table_empty(), TIER_DEVICE_LOCAL, TIER_HOST_COLD, 128, 5)
        val pinned = object_vm_pin(d.table, d.slot, d.generation, 1)
        expect(pinned.resolve.ok).to_equal(true)
        val retire_refused = object_vm_retire(pinned.table, d.slot, d.generation)
        expect(retire_refused.resolve.ok).to_equal(false)
        expect(retire_refused.resolve.fault).to_equal(ObjectVmFault.Protected)
        expect(retire_refused.resolve.reason.contains("object_vm_protected")).to_be(true)
        val unpinned = object_vm_pin(pinned.table, d.slot, d.generation, -1)
        expect(unpinned.resolve.ok).to_equal(true)
        val stale = object_vm_acquire_lease(unpinned.table, d.slot, d.generation + 1)
        expect(stale.resolve.ok).to_equal(false)
        expect(stale.resolve.fault).to_equal(ObjectVmFault.StaleGeneration)
        val live_ref = object_vm_object_ref(d.slot, d.generation)
        val stale_ref = object_vm_object_ref(d.slot, d.generation + 1)
        expect(object_vm_handles_stale(live_ref, stale_ref)).to_equal(true)
        expect(object_vm_handles_stale(live_ref, live_ref)).to_equal(false)

# ----------------------------------------------------------------------------
# 5) Staged transfers, CAS store recovery, and gated backends
# (ported from the gpu-mmu lane's system spec; the store and backend modules
# are byte-identical between the lane branch and main).
# ----------------------------------------------------------------------------

describe "GPU MMU staged transfers, store recovery, and gated backends (system-level)":
    it "stages artifacts through the bounded pinned ring":
        val backend = StagedPlacementBackend.with_budget(256, 128)
        val plan = staged_plan(_lane_budget())
        val transfer = backend.prefetch(plan)
        var staged_bytes = -1
        match transfer:
            case Result.Ok(receipt):
                staged_bytes = receipt.bytes_transferred
            case Result.Err(_):
                staged_bytes = -1
        expect(staged_bytes).to_equal(256)

    it "recovers CAS roots and fails closed on a missing checkpoint":
        val store = CasStore.create("/tmp/simple-gpu-mmu-sysspec")
        val object_a = _lane_object_ref(1)
        val object_b = _lane_object_ref(2)
        store.write_object_bytes(object_a, [1, 2, 3], artifact_id(digest: LANE_ARTIFACT_DIGEST, byte_len: 3))
        store.write_object_bytes(object_b, [4, 5, 6, 7], artifact_id(digest: LANE_ARTIFACT_DIGEST, byte_len: 3))
        val checkpoint = store.checkpoint(ObjectSetView(objects: [object_a, object_b]))
        expect(checkpoint.ok).to_equal(true)
        val recovered = cas_store_recover(store, checkpoint.root)
        expect(recovered.ok).to_equal(true)
        val missing_root = cas_store_recover(store, artifact_id(digest: LANE_ARTIFACT_DIGEST, byte_len: 0))
        expect(missing_root.ok).to_equal(false)
        expect(missing_root.error).to_equal("checkpoint-missing")

    it "plans deterministically from permuted request lists":
        val primary = make_deterministic_plan(_lane_requests(), _lane_budget())
        val replay = make_deterministic_plan([_lane_request(3, 5), _lane_request(1, 20), _lane_request(2, 10)], _lane_budget())
        expect(primary.receipt_seed.value).to_equal(replay.receipt_seed.value)
        val primary_latency = primary.estimated_cost.predicted_latency_us as i64
        val replay_latency = replay.estimated_cost.predicted_latency_us as i64
        expect(primary_latency).to_equal(replay_latency)

    it "keeps the direct backend explicit about capability instead of silently passing":
        val plan = staged_plan(_lane_budget())
        val staged = StagedPlacementBackend.with_budget(1024, 2048)
        val staged_receipt = staged.prefetch(plan)
        val direct = DirectPlacementBackend()
        val direct_available = env_get("SIMPLE_MMU_DIRECT_BACKEND") == "1"
        if direct_available:
            var staged_bytes = -1
            match staged_receipt:
                case Result.Ok(staged_value):
                    staged_bytes = staged_value.bytes_transferred
                case Result.Err(_):
                    staged_bytes = -1
            var direct_bytes = -2
            match direct.prefetch(plan):
                case Result.Ok(direct_value):
                    direct_bytes = direct_value.bytes_transferred
                case Result.Err(_):
                    direct_bytes = -2
            expect(direct_bytes).to_equal(staged_bytes)
        else:
            expect(capability.backend.value).to_equal("staged_simulation")
            expect(capability.reason).to_equal("usm-malloc-host-is-heap-backed")
            val first = backend.stage_transfer(artifact, [1u8, 2u8, 3u8, 4u8], 4096)
            val second = backend.stage_transfer(artifact, [5u8, 6u8, 7u8, 8u8], 8192)
            val third = backend.stage_transfer(artifact, [9u8, 10u8, 11u8, 12u8], 12288)
            expect_stage_receipt(first, 0, 0, "4:10:30")
            expect_stage_receipt(second, 1, 1, "4:26:70")
            expect_stage_receipt(third, 2, 0, "4:42:110")
            expect(backend.readback_bytes(third)).to_equal([9u8, 10u8, 11u8, 12u8])

    it "keeps device-initiated placement behind its own explicit gate":
        val device = DeviceInitiatedPlacementBackend()
        expect(device.probe().available).to_equal(
            env_get("SIMPLE_MMU_DEVICE_INITIATED_BACKEND") == "1")
        val plan = staged_plan(_lane_budget())
        var acquire_outcome = ""
        match device.acquire(plan):
            case Result.Ok(_):
                acquire_outcome = "ok"
            case Result.Err(err):
                match err:
                    case PlacementError.Unsupported:
                        acquire_outcome = "unsupported"
                    case _:
                        acquire_outcome = "other-error"
        expect(acquire_outcome).to_equal("unsupported")
        val recovered = device.recover(artifact_id(digest: LANE_ARTIFACT_DIGEST, byte_len: 1))
        expect(recovered.ok).to_equal(false)
        expect(recovered.recovered_objects).to_equal(0)

    it "holds staged peak bytes fixed as request count grows 10x":
        val fixed_one = _staged_peak(1)
        val fixed_ten = _staged_peak(10)
        expect(fixed_ten).to_equal(fixed_one)
        expect(fixed_one).to_equal(256)
