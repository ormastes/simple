# @cover src/compiler/50.mir/__init__.spl 0%
# codex-system-test
# @manual_section RISC-V Gen2 V9 flattened IM plus Zicsr runtime pipeline
"""# RISC-V Gen2 V9 flattened IM plus Zicsr runtime pipeline

Exercises the exact combined IM, Zicsr, and Zifencei product boundary. It
proves the direct topology, tag-two M/tag-three CSR service ABI, and
deterministic lowering. It does not claim clocked or self-hosted qualification.
"""
use std.spec.*
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_lsu_config.{LsuConfig}
use compiler.mir.hwir.riscv_scalar_runtime_pipeline_v9_flat.{strict_riscv_scalar_runtime_pipeline_v9_flat_direct}
use compiler.backend.backend.riscv_scalar_runtime_pipeline_v9_flat_to_vhdl.{compile_strict_riscv_scalar_runtime_pipeline_v9_flat}

fn runtime_v9_im_zicsr_config(xlen: i32) -> CoreConfig:
    CoreConfig(xlen: xlen, physical_address_bits: if xlen == 32: 32 else: 56,
        register_count: 32, profile: "riscv-gen2-runtime-v9-im-zicsr",
        isa_profile: if xlen == 32: "rv32im_zicsr_zifencei" else: "rv64im_zicsr_zifencei",
        compressed_decode_profile: "none")

describe "RISC-V Gen2 V9 flattened IM plus Zicsr runtime pipeline":
    # @req REQ-G2-012 REQ-G2-013 REQ-G2-016
    it "should elaborate exact combined products with the ordered 21-child graph":
        step("Build the exact RV32 and RV64 V9 products")
        val rv32 = strict_riscv_scalar_runtime_pipeline_v9_flat_direct("runtime_v9_system_rv32", runtime_v9_im_zicsr_config(32), LsuConfig.rv32_product_default()).unwrap()
        val rv64 = strict_riscv_scalar_runtime_pipeline_v9_flat_direct("runtime_v9_system_rv64", runtime_v9_im_zicsr_config(64), LsuConfig.rv64_product_default()).unwrap()
        step("Check closed topology and both dynamic providers")
        expect(rv32.diagnostic()).to_equal("")
        expect(rv64.diagnostic()).to_equal("")
        val children = [rv32.decoder.entity_name, rv32.uop_skid.entity_name, rv32.alu.entity_name, rv32.control.entity_name, rv32.system.entity_name, rv32.illegal_provider.entity_name, rv32.router.entity_name, rv32.immediate_adapter.entity_name, rv32.pending.entity_name, rv32.projection.entity_name, rv32.muldiv.entity_name, rv32.csr.entity_name, rv32.lsu.entity_name, rv32.fence.entity_name, rv32.selector.entity_name, rv32.completion_merge.entity_name, rv32.completion_skid.entity_name, rv32.global_fault_gate.entity_name, rv32.fault_owner.entity_name, rv32.defaults.entity_name, rv32.zero_defaults.entity_name]
        expect(children.len()).to_equal(21)
        expect(rv32.muldiv.entity_name).to_equal("runtime_v9_system_rv32_muldiv")
        expect(rv64.csr.entity_name).to_equal("runtime_v9_system_rv64_csr")

    # @req REQ-G2-012 REQ-G2-013
    it "should freeze full-M rows and the tag-two held service ABI":
        step("Build both exact combined decoder plans")
        val rv32 = strict_riscv_scalar_runtime_pipeline_v9_flat_direct("runtime_v9_system_m32", runtime_v9_im_zicsr_config(32), LsuConfig.rv32_product_default()).unwrap()
        val rv64 = strict_riscv_scalar_runtime_pipeline_v9_flat_direct("runtime_v9_system_m64", runtime_v9_im_zicsr_config(64), LsuConfig.rv64_product_default()).unwrap()
        step("Check base M rows, RV64 word rows, and pending-owner handshake")
        for id in ["rv.m.mul", "rv.m.mulh", "rv.m.mulhsu", "rv.m.mulhu", "rv.m.div", "rv.m.divu", "rv.m.rem", "rv.m.remu"]:
            expect(rv32.plan.entries.any(_.id == id)).to_equal(true)
            expect(rv64.plan.entries.any(_.id == id)).to_equal(true)
        for id in ["rv64.m.mulw", "rv64.m.divw", "rv64.m.divuw", "rv64.m.remw", "rv64.m.remuw"]:
            expect(rv64.plan.entries.any(_.id == id)).to_equal(true)
        expect(rv32.plan.entries.any(_.id == "rv64.m.divw")).to_equal(false)
        for edge in [("pending", "muldiv_request_valid", "muldiv", "request_valid", 1), ("pending", "muldiv_request_provider_tag", "muldiv", "request_provider_tag", 3), ("muldiv", "request_accept", "pending", "muldiv_request_accept", 1), ("muldiv", "completion_valid", "pending", "muldiv_completion_valid", 1), ("pending", "muldiv_completion_ready", "muldiv", "completion_ready", 1)]:
            expect(rv64.bindings.any(_.source_owner == edge[0] and _.source_port == edge[1] and _.destination_owner == edge[2] and _.destination_port == edge[3] and _.bit_width == edge[4])).to_equal(true)
        expect(rv64.muldiv.constants.any(_.name == "tag_muldiv" and _.value == 2)).to_equal(true)

    # @req REQ-G2-013 REQ-G2-016
    it "should route class six through tag three and expose the XLEN-aware CSR ABI":
        step("Build RV32 and RV64 products for CSR service inspection")
        for row in [(runtime_v9_im_zicsr_config(32), LsuConfig.rv32_product_default()), (runtime_v9_im_zicsr_config(64), LsuConfig.rv64_product_default())]:
            val pipeline = strict_riscv_scalar_runtime_pipeline_v9_flat_direct("runtime_v9_system_csr_" + row[0].xlen.to_text(), row[0], row[1]).unwrap()
            step("Check frozen lookup and exact-once commit ports")
            for port in [("csr_present", "in", 1), ("csr_read_value", "in", row[0].xlen), ("csr_lookup_valid", "out", 1), ("csr_lookup_address", "out", 12), ("csr_lookup_read_enable", "out", 1), ("csr_commit_valid", "out", 1), ("csr_commit_address", "out", 12), ("csr_commit_value", "out", row[0].xlen)]:
                expect(pipeline.top_ports.any(_.name == port[0] and _.direction == port[1] and _.bit_width == port[2])).to_equal(true)
        val rv64 = strict_riscv_scalar_runtime_pipeline_v9_flat_direct("runtime_v9_system_csr_edges", runtime_v9_im_zicsr_config(64), LsuConfig.rv64_product_default()).unwrap()
        for edge in [("pending", "csr_request_valid", "csr", "request_valid", 1), ("pending", "csr_request_provider_tag", "csr", "request_provider_tag", 3), ("csr", "request_accept", "pending", "csr_request_accept", 1), ("csr", "completion_valid", "pending", "csr_completion_valid", 1), ("pending", "csr_completion_ready", "csr", "completion_ready", 1), ("csr", "provider_protocol_fault", "global_fault_gate", "csr_fault", 1), ("csr", "csr_commit_valid", "global_fault_gate", "raw_csr_commit_valid", 1)]:
            expect(rv64.bindings.any(_.source_owner == edge[0] and _.source_port == edge[1] and _.destination_owner == edge[2] and _.destination_port == edge[3] and _.bit_width == edge[4])).to_equal(true)
        expect(rv64.router.constants.any(_.name == "class6" and _.value == 6)).to_equal(true)
        expect(rv64.router.constants.any(_.name == "tag_csr" and _.value == 3)).to_equal(true)

    # @req REQ-G2-012 REQ-G2-013 REQ-G2-016 NFR-G2-003
    it "should emit deterministic strict VHDL for the combined V9 product":
        step("Compile the same RV32 combined product twice")
        val first = compile_strict_riscv_scalar_runtime_pipeline_v9_flat("runtime_v9_system_vhdl", runtime_v9_im_zicsr_config(32), LsuConfig.rv32_product_default())
        val second = compile_strict_riscv_scalar_runtime_pipeline_v9_flat("runtime_v9_system_vhdl", runtime_v9_im_zicsr_config(32), LsuConfig.rv32_product_default())
        step("Check route graph receipt determinism and dynamic provider instances")
        expect(first.is_success()).to_equal(true)
        expect(second.is_success()).to_equal(true)
        expect(first.route).to_equal("hwir-gen2-scalar-runtime-pipeline-v9-flat-direct")
        expect(first.hwir_graph_sha256).to_equal(second.hwir_graph_sha256)
        expect(first.vhdl).to_equal(second.vhdl)
        expect(first.vhdl).to_contain("simple-hwir v9-flat-route-receipt=")
        expect(first.vhdl).to_contain("muldiv: entity work.runtime_v9_system_vhdl_muldiv")
        expect(first.vhdl).to_contain("csr: entity work.runtime_v9_system_vhdl_csr")

    # @req REQ-G2-012 REQ-G2-013 REQ-G2-016
    it "should reject IM-only Zmmul-only and standalone CSR profiles outside V9":
        step("Attempt construction with earlier isolated product profiles")
        expect(strict_riscv_scalar_runtime_pipeline_v9_flat_direct("runtime_v9_system_im_rejected", CoreConfig.rv32im(), LsuConfig.rv32_product_default()).is_err()).to_equal(true)
        expect(strict_riscv_scalar_runtime_pipeline_v9_flat_direct("runtime_v9_system_zmmul_rejected", CoreConfig.rv32i_zmmul(), LsuConfig.rv32_product_default()).is_err()).to_equal(true)
        expect(strict_riscv_scalar_runtime_pipeline_v9_flat_direct("runtime_v9_system_zicsr_rejected", CoreConfig.rv32_zicsr_zifencei(), LsuConfig.rv32_product_default()).is_err()).to_equal(true)
