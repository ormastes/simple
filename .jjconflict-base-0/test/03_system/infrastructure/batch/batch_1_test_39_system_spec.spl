# @cover src/lib/nogc_sync_mut/spec/mod.spl 60%
# @cover src/compiler/80.driver/pipeline.spl 60%

use std.spec

fn verify(condition: bool):
    expect(condition).to_equal(true)

describe "system test batch execution contract":
    it "recursive factorial computes 5! exactly":
        step("Verify: recursive factorial computes 5! exactly")
        # @req: REQ-SYS-BATCH-016-001
        fn fact(n: i64) -> i64:
            if n <= 1:
                return 1
            n * fact(n - 1)
        expect(fact(5)).to_equal(120) # oracle: 5! = 120
        expect(fact(0)).to_equal(1) # oracle: base case

describe "System Test":
    slow_it "test 1":
        verify(1 + 1 == 2)
    slow_it "test 2":
        verify("a" == "a")
    slow_it "test 3":
        val x = 5
        verify(x > 0)
    slow_it "test 4":
        val arr = [1, 2, 3]
        verify(arr.len() == 3)
    slow_it "test 5":
        for i in 0..10:
            verify(i >= 0)
    slow_it "test 6":
        val opt = Some(42)
        verify(opt.?)
    slow_it "test 7":
        match Some(1):
            Some(x): verify(x == 1)
            nil: verify(false)
    slow_it "test 8":
        if true:
            verify(true)
        else:
            verify(false)
    slow_it "test 9":
        val d = {"k": "v"}
        verify(d["k"] == "v")
    slow_it "test 10":
        var sum = 0
        for i in 0..5:
            sum = sum + i
        verify(sum == 10)
