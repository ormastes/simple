use std.spec.*
use std.io_runtime.{file_read}

describe "Clang 23.1 browser demo migration":
    describe "REQ-001, REQ-002, REQ-007: coherent provider admission":
        it "prefers explicit prefix and rejects non-23.1 versions":
            val resolver = file_read("scripts/check/lib/clang-23-1-toolchain.shs")
            expect(resolver).to_contain("LLVM_23_1_PREFIX")
            expect(resolver).to_contain("observed_version")
            expect(resolver).to_contain("[ \"$observed_version\" = \"23.1\" ]")
            expect(resolver).to_contain("rejected $tool_role")

        it "resolves compiler linker and archiver as one family":
            val resolver = file_read("scripts/check/lib/clang-23-1-toolchain.shs")
            expect(resolver).to_contain("CLANG_23_1")
            expect(resolver).to_contain("LLD_23_1")
            expect(resolver).to_contain("LLVM_AR_23_1")

    describe "REQ-003, REQ-004, REQ-008: browser client build":
        it "uses the admitted compiler for the client and libc":
            val build = file_read("scripts/os/build_browser_demo_client.shs")
            expect(build).to_contain("validate_clang_23_1_toolchain")
            expect(build).to_contain("make CC=\"$CLANG\" AR=\"$AR\"")
            expect(build).to_contain("--target=x86_64-unknown-simpleos")
            expect(build).to_contain("browser-demo ELF has unresolved getpid")

        it "retains tool and output identity evidence":
            val build = file_read("scripts/os/build_browser_demo_client.shs")
            expect(build).to_contain("simpleos-browser-demo-clang-23.1-v1")
            expect(build).to_contain("clang_version=")
            expect(build).to_contain("lld_version=")
            expect(build).to_contain("sha256")

    describe "REQ-009, REQ-010: bootstrap and QEMU evidence":
        it "retains exact browser bytes and interactive rendering evidence":
            val gate = file_read("scripts/check/check-simpleos-wm-fullscreen-evidence.shs")
            expect(gate).to_contain("browser_demo_disk_payload_status")
            expect(gate).to_contain("input_state_marker")
            expect(gate).to_contain("pointer_state_marker")
            expect(gate).to_contain("browser_content_presented_generation_status")
            expect(gate).to_contain("path=software window_id=$remote_browser_window status=engine2d_rendered backend=[^ ]+ fallback=(solid-material|cpu-composited-material)")
            expect(gate).to_contain("path=host-gpu window_id=$remote_browser_window status=engine2d_rendered backend=[^ ]+ fallback=(solid-material|cpu-composited-material|metal-device-composited-material)")
            expect(gate).to_contain("material=[0-9a-f]{64} theme=$EXPECTED_THEME_ID source=$EXPECTED_THEME_SOURCE_MANIFEST_SHA256$")
            expect(gate).to_contain("content-provenance-rejected|backend=native-safe-fallback")
