use std.io.{file_read}
use std.spec.{describe, it, expect}

val PROBE = "test/02_integration/compiler/phase2_low_memory_source_reclaim_probe.spl"
val CHECKER = "scripts/check/check-phase2-low-memory-source-reclaim.shs"
val REPORT = "doc/09_report/phase2_low_memory_focused_gate_2026-07-26.md"

describe "Phase-2 low-memory source-reclaim gate":
    it "scopes contracts to singular exact function bodies":
        val probe = file_read(PROBE)
        expect(probe).to_contain("fn exact_indented_body(source: text, signature: text) -> text:")
        expect(probe).to_contain("if signature_count != 1:")
        expect(probe).to_contain("fn exact_line_position(body: text, statement: text) -> i64:")
        expect(probe).to_contain("if count == 1:")
        expect(probe).to_contain("\"me compile() -> CompileResult:\"")
        expect(probe).to_contain("\"me source_contents_reclaimable() -> bool:\"")
        expect(probe).to_contain("\"pub fn lexer_release_parse_source_globals():\"")
        expect(probe).to_contain("self.options.low_memory and self.options.backend != \\\"vhdl\\\"")
        expect(probe).to_contain("val trace_start_pos = exact_line_position")
        expect(probe).to_contain("phase2:source_reclaim:start low_memory=true")
        expect(probe).to_contain("val trace_done_pos = exact_line_position")
        expect(probe).to_contain("phase2:source_reclaim:done reclaimed={{{{reclaimed_sources}}}}")
        expect(probe).to_contain("val evict_pos = exact_line_position")
        expect(probe).to_contain("trace_done_pos > evict_pos")
        expect(probe).to_contain("hir_pos > trace_done_pos")
        expect(probe).to_contain("fn source_contract_negative_control() -> bool:")
        expect(probe).to_contain("not source_has_complete_lexer_release(false_lexer)")
        expect(probe).to_contain("not source_has_ordered_post_parse_reclaim(false_driver_scope)")
        expect(probe).to_contain("not source_has_ordered_post_parse_reclaim(false_driver_string)")
        expect(probe).to_contain("not source_has_low_memory_non_vhdl_guard(false_guard)")
        expect(probe.contains("lexer.contains(\"current_core_lexer_slot = []\")")).to_equal(false)
        expect(probe.contains("driver.find(\"val (parsed_ctx, parse_ok)")).to_equal(false)

    it "enforces attested bounded execution and exact alias semantics":
        val checker = file_read(CHECKER)
        expect(checker).to_contain("defined(POSIX::setsid())")
        expect(checker).to_contain("kill -0 -- \"-$ACTIVE_GROUP_PID\"")
        expect(checker).to_contain("terminate_active_group TERM")
        expect(checker).to_contain("terminate_active_group KILL")
        expect(checker).to_contain("wait_for_pid_until")
        expect(checker).to_contain("drain_deadline=")
        expect(checker).to_contain("drain_failed=0")
        expect(checker).to_contain("terminate_active_group_bounded \"$grace_secs\"")
        expect(checker).to_contain("terminate_filter_bounded \"$ACTIVE_STDOUT_FILTER_PID\"")
        expect(checker).to_contain("[ \"$drain_failed\" = 0 ] || return 125")
        expect(checker).to_contain("STREAM_HEAD_BYTES=4096")
        expect(checker).to_contain("STREAM_TAIL_BYTES=4096")
        expect(checker).to_contain("STREAM_MAX_BYTES=8256")
        expect(checker).to_contain("rerun-command.sh.txt")
        expect(checker).to_contain("probe-command.sh.txt")
        expect(checker).to_contain("phase2_low_memory_gate_simple_bin_sha256=")
        expect(checker).to_contain("jj log -r @- --no-graph -T 'commit_id'")
        expect(checker).to_contain("pure-simple-binary-rejected-as-seed")
        expect(checker.contains("    set -e\n    ACTIVE_GROUP_PID=\"\"")).to_equal(false)
        expect(checker).to_contain("[ \"$alias_first\" = 1 ] && [ \"$alias_second\" = 0 ]")
        expect(checker).to_contain("alias-free-semantics-not-proven")
        expect(checker).to_contain("phase2_low_memory_gate_stage4=unused")
        expect(checker.contains("candidate_frontend_admission.shs")).to_equal(false)
        expect(checker.contains("bootstrap-stage4")).to_equal(false)

    it "keeps the existing runtime result blocked":
        val report = file_read(REPORT)
        expect(report).to_contain("overall status: **BLOCKED**")
        expect(report).to_contain("both ownership calls returned `0`")
        expect(report).to_contain("must not be cited as a pass")
        expect(report).to_contain("sh scripts/check/check-phase2-low-memory-source-reclaim.shs")
        expect(report).to_contain("rerun-command.sh.txt")
        expect(report).to_contain("probe-command.sh.txt")
