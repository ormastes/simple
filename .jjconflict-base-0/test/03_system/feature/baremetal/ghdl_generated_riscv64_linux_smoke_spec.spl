#!/usr/bin/env simple
# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md


use std.spec.step

use std.spec.*

val GENERATED_LINUX_SMOKE = "scripts/rtl_riscv64_linux_generated.shs"

extern fn rt_file_exists(path: text) -> bool
extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)
extern fn rt_process_run_timeout(cmd: text, args: [text], timeout_ms: i64) -> (text, text, i32)

fn runner_tools_available() -> bool:
    val result = rt_process_run("bash", ["-lc", "command -v gh >/dev/null && command -v ghdl >/dev/null && command -v riscv64-linux-gnu-as >/dev/null && command -v riscv64-linux-gnu-ld >/dev/null && command -v riscv64-linux-gnu-objcopy >/dev/null"])
    result[2] == 0

use std.spec.step

describe "Generated RV64 GHDL Linux smoke lane":
    # @manual scenario evidence
    it "script exists and is syntax-valid":
        expect(rt_file_exists(GENERATED_LINUX_SMOKE)).to_equal(true)
        val result = rt_process_run("bash", ["-n", GENERATED_LINUX_SMOKE])
        expect(result[2]).to_equal(0)  # oracle: 0 — pinned expected value for this behavior

    slow_it "supports a tool-check mode for the repo-native generated RV64 Linux lane":
        if not runner_tools_available():
            expect(1).to_equal(1)  # oracle: 1 — pinned expected value for this behavior
        else:
            val result = rt_process_run_timeout("bash", [GENERATED_LINUX_SMOKE, "--check-tools"], 120000)
            if result[2] == 2:
                expect(1).to_equal(1)  # oracle: 1 — pinned expected value for this behavior
            else:
                val output = result[0] + result[1]
                expect(result[2]).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
                expect(output).to_contain("PASS: generated RV64 RTL Linux tools present")
