# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
# Default Parameter Values

**Feature ID:** #PARSER-001
**Category:** Syntax
**Status:** Active

## Overview

Tests the `default` keyword for function parameter default values using `=`
syntax. Covers basic defaults, typed parameters, methods (instance and static),
collection defaults, edge cases (booleans, negatives, expressions), and
combinations of required and default parameters across functions, classes,
and nested scopes.

## Syntax

```simple
use std.spec.step

fn greet(name = "World"):
return "Hello, {name}"
fn typed_default(count: i32 = 0):
return count
```
"""
describe "Default keyword in function parameters":
    # @manual scenario evidence
    it "parses default parameter value with = syntax":
        # @req REQ-SSPEC-SYSTEM
        step("parses default parameter value with = syntax")
        fn greet(name = "World"):
            return "Hello, {name}"
        expect(greet()).to_equal("Hello, World")
        expect(greet("Alice")).to_equal("Hello, Alice")

    it "parses multiple default parameters":
        # @req REQ-SSPEC-SYSTEM
        step("parses multiple default parameters")
        fn create_range(min = 0, max = 100):
            return [min, max]
        val range = create_range()
        expect(range[0]).to_equal(0)
        expect(range[1]).to_equal(100)

    it "overrides single default parameter":
        # @req REQ-SSPEC-SYSTEM
        step("overrides single default parameter")
        fn with_defaults(x = 1, y = 2):
            return x + y
        expect(with_defaults()).to_equal(3)
        expect(with_defaults(5)).to_equal(7)
        expect(with_defaults(5, 10)).to_equal(15)

    it "parses default with expressions":
        # @req REQ-SSPEC-SYSTEM
        step("parses default with expressions")
        fn with_expr_default(size = 2 ** 10):
            return size
        expect(with_expr_default()).to_equal(1024)

    it "parses default with arithmetic":
        # @req REQ-SSPEC-SYSTEM
        step("parses default with arithmetic")
        fn compute(base = 100, offset = 10 + 5):
            return base + offset
        expect(compute()).to_equal(115)

    it "uses default in nested function":
        # @req REQ-SSPEC-SYSTEM
        step("uses default in nested function")
        fn outer():
            fn inner(value = 42):
                return value
            return inner()
        expect(outer()).to_equal(42)

describe "Default keyword with types":
    it "parses default parameter with type annotation":
        # @req REQ-SSPEC-SYSTEM
        step("parses default parameter with type annotation")
        fn typed_default(count: i32 = 0):
            return count
        expect(typed_default()).to_equal(0)
        expect(typed_default(5)).to_equal(5)

    it "parses default text parameter":
        # @req REQ-SSPEC-SYSTEM
        step("parses default text parameter")
        fn with_text(message: text = "default"):
            return message
        expect(with_text()).to_equal("default")
        expect(with_text("custom")).to_equal("custom")

    it "parses default float parameter":
        # @req REQ-SSPEC-SYSTEM
        step("parses default float parameter")
        fn with_float(value: f64 = 3.14):
            return value
        expect(with_float()).to_be_greater_than(3.0)

describe "Default keyword in methods":
    it "parses default in class method":
        # @req REQ-SSPEC-SYSTEM
        step("parses default in class method")
        class Counter:
            value: i32

            me increment(amount = 1):
                self.value = self.value + amount

        var c = Counter(value: 10)
        c.increment()
        expect(c.value).to_equal(11)

    it "parses default in static method":
        # @req REQ-SSPEC-SYSTEM
        step("parses default in static method")
        class Factory:
            static fn create(size = 10) -> i32:
                return size

        expect(Factory.create()).to_equal(10)
        expect(Factory.create(20)).to_equal(20)

describe "Default keyword with collections":
    it "parses default empty array":
        # @req REQ-SSPEC-SYSTEM
        step("parses default empty array")
        fn with_array(items = []):
            return items.len()
        expect(with_array()).to_equal(0)
        expect(with_array([1, 2, 3])).to_equal(3)

    it "parses default array literal":
        # @req REQ-SSPEC-SYSTEM
        step("parses default array literal")
        fn with_values(data = [1, 2, 3]):
            return data.len()
        expect(with_values()).to_equal(3)

describe "Default keyword edge cases":
    it "parses default with boolean":
        # @req REQ-SSPEC-SYSTEM
        step("parses default with boolean")
        fn with_flag(enabled = true):
            return enabled
        expect(with_flag()).to_equal(true)
        expect(with_flag(false)).to_equal(false)

    it "parses default with negative number":
        # @req REQ-SSPEC-SYSTEM
        step("parses default with negative number")
        fn with_negative(value = -10):
            return value
        expect(with_negative()).to_equal(-10)

    it "parses default with string interpolation":
        # @req REQ-SSPEC-SYSTEM
        step("parses default with string interpolation")
        val default_name = "World"
        fn greet_default(name = default_name):
            return "Hello, {name}"
        expect(greet_default()).to_equal("Hello, World")

describe "Default keyword combinations":
    it "parses mix of required and default parameters":
        # @req REQ-SSPEC-SYSTEM
        step("parses mix of required and default parameters")
        fn mixed(required, optional = 5):
            return required + optional
        expect(mixed(10)).to_equal(15)
        expect(mixed(10, 20)).to_equal(30)

    it "parses multiple functions with defaults":
        # @req REQ-SSPEC-SYSTEM
        step("parses multiple functions with defaults")
        fn first(x = 1):
            return x
        fn second(y = 2):
            return y
        expect(first()).to_equal(1)
        expect(second()).to_equal(2)

    # TODO: Lambda default parameters not yet supported
    # it "parses default in lambda", skip:
    #     val lambda_default = \x = 10: x * 2
    #     expect lambda_default() == 20
    #     expect lambda_default(5) == 10
