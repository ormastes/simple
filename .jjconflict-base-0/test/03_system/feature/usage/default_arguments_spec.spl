"""
# Default Arguments Specification

**Feature ID:** #DEFARG-001
**Category:** Language | Functions
**Status:** Implemented

## Overview

Tests for function default argument values.

## Syntax

```simple
use std.spec.step

fn greet(name, greeting="Hello"):
print "{greeting}, {name}!"

greet("Alice")           # Uses default: "Hello, Alice!"
greet("Bob", "Hi")       # Override: "Hi, Bob!"
```
"""



# ============================================================================
# Default Arguments
# ============================================================================

use std.spec.step

describe "Default Arguments":
    # @manual scenario evidence
    # ## Function Default Parameter Values
    #
    # Tests for default values in function parameters.

    it "uses default argument when not provided":
        fn add(a, b=10):
            return a + b

        expect(add(5)).to_equal(15)

    it "overrides default argument when provided":
        fn add(a, b=10):
            return a + b

        expect(add(5, b=20)).to_equal(25)

    it "uses multiple default arguments":
        fn calc(a, b=2, c=3):
            return a + b * c

        expect(calc(1)).to_equal(7)

    it "overrides some default arguments":
        fn calc(a, b=2, c=3):
            return a + b * c

        expect(calc(1, c=10)).to_equal(21)
