# Cross-engine value-semantics probe P7: array plain assignment (A1) and
# row copy-out (A2). Arrays copy on assignment in every engine — this is an
# expected-AGREE probe that also anchors the harness's agreement direction.
fn main():
    print("PROBE|CONTROL={40 + 2}")
    var a1 = [1, 2, 3]
    var a2 = a1
    a2[0] = 100
    print("PROBE|A1 a1_0={a1[0]} a2_0={a2[0]}")
    var m = [[0, 0], [0, 0]]
    var row = m[0]
    row[1] = 5
    print("PROBE|A2 m01={m[0][1]} row1={row[1]}")

main()
