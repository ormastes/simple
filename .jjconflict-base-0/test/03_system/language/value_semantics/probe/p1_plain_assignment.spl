# Cross-engine value-semantics probe P1: plain struct assignment.
# Each probe is a standalone minimal file — one unsupported operation silently
# demotes a whole program to the interpreter, so probes must not be combined.
struct Flat:
    a: f64
    b: i64

fn main():
    print("PROBE|CONTROL={40 + 2}")
    var f = Flat(a: 1.0, b: 2)
    var f2 = f
    f2.a = 7.0
    print("PROBE|S1 f.a={f.a} f2.a={f2.a}")

main()
