# codex-system-test
"""AC-12 source contract for the planned provenance-bound Bootstrap SDK capsule.

This specification is intentionally a source-contract guard.  It records the
interfaces and existing SHB seams that the future capsule implementation must
extend; it does not claim a capsule can be emitted, loaded, or used to bootstrap
the compiler today.
"""

use std.io.{file_read}
use std.spec.*

val PLAN = "doc/03_plan/design/bootstrap_sdk_capsule.md"
val SHB_TYPES = "src/compiler/80.driver/shb/shb_types.spl"
val SHB_EXTRACTOR = "src/compiler/80.driver/shb/shb_extractor.spl"
val SHB_HASH = "src/compiler/80.driver/shb/shb_hash.spl"
val SHB_READER = "src/compiler/80.driver/shb/shb_reader.spl"
val BOOTSTRAP = "scripts/bootstrap/bootstrap-from-scratch.sh"

describe "AC-12 BootstrapSdk capsule source contract":
    it "keeps the four frozen capsule contracts explicit in the bootstrap plan":
        step("Read the planned BootstrapSdk boundary")
        val plan = file_read(PLAN)
        expect(plan).to_contain("Status: future design; execution is gated on an exact x86_64 Stage 4 candidate")
        expect(plan).to_contain("The implementation keeps these frozen interfaces exactly named:")
        expect(plan).to_contain("BootstrapSdkManifest")
        expect(plan).to_contain("BootstrapSdkModuleInterface")
        expect(plan).to_contain("BootstrapSdkBodyArchive")
        expect(plan).to_contain("BootstrapSdkProvenance")
        expect(plan).to_contain("canonical module id, direct imports, exported declaration signatures")
        expect(plan).to_contain("body hash, archive path/hash, required interface hash")
        expect(plan).to_contain("Stage 3 manifest hash, Stage 4 provenance hash")
        expect(plan).to_contain("or an unrecognized schema field that affects admission.")

    it "binds the future capsule to existing SHB interface and dependency seams":
        step("Inspect the current SHB interface boundary")
        val types = file_read(SHB_TYPES)
        val extractor = file_read(SHB_EXTRACTOR)
        val hash = file_read(SHB_HASH)
        val reader = file_read(SHB_READER)
        expect(types).to_contain("struct ShbModuleInterface:")
        expect(types).to_contain("dependencies: [ShbDependencyEntry]")
        expect(types).to_contain("interface_hash: i64")
        expect(types).to_contain("struct ShbEnumEntry:")
        expect(types).to_contain("variants: [text]")
        expect(extractor).to_contain("fn shb_extract(source: text, filename: text) -> ShbModuleInterface:")
        expect(extractor).to_contain("iface.enums.push(extract_enum(i))")
        expect(extractor).to_contain("variants.push(field_names[vi])")
        expect(extractor).to_contain("interface_hash: 0")
        expect(hash).to_contain("fn shb_interface_hash(iface: ShbModuleInterface) -> i64:")
        expect(hash).to_contain("fn shb_canonical_api_string(iface: ShbModuleInterface) -> text:")
        expect(hash.contains("iface.dependencies")).to_equal(false)
        expect(reader).to_contain("fn read_dependencies() -> [ShbDependencyEntry]:")

    it "retains the planned two-generation and fail-closed bootstrap boundary":
        step("Compare the plan with the current bootstrap entrypoint")
        val plan = file_read(PLAN)
        val bootstrap = file_read(BOOTSTRAP)
        expect(plan).to_contain("reviewed contract only: no capsule, target row, deployment, or release changes")
        expect(plan).to_contain("state to `pass`.")
        expect(plan).to_contain("It never falls back to a stale capsule, raw source, or the")
        expect(plan).to_contain("Rust seed while claiming capsule success;")
        expect(plan).to_contain("AC-12's implementation/spec/manual")
        expect(plan).to_contain("work remains pending until an exact x86 candidate admits capsule execution.")
        expect(bootstrap).to_contain("--fresh-cache")
        expect(bootstrap).to_contain("bootstrap-from-scratch")
