# @cover src/lib/nogc_sync_mut/test_runner/gpu_lane_common.spl 80%
# GPU Lane Common — routing/probing unit + system tests.
# @tag:system
#
# Task A3 of doc/03_plan/agent_tasks/gpu_remote_interpreter_parallel_plan_2026-08-07.md.
# Covers: cuda/vulkan route to the GpuLaneExecutor path, missing-driver
# produces a well-formed `skip:` result, an unresolved rt_* probe symbol
# produces `blocked: <symbol>`, and the GPU_LANE_TIMEOUT_MS / *_LIVE_REQUIRED
# env contract (design §7).

"""
## Purpose and audience
Purpose: routes the cuda backend to the GpuLaneExecutor path (driver present -> not-yet-implemented, not silently skipped)
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-COMPILER-GpuLaneComm-001

use std.test_runner.gpu_lane_common.{
    route_gpu_lane, gpu_lane_timeout_ms, gpu_live_required_env, gpu_live_required,
    gpu_required_symbols, gpu_driver_probe_cmd, GPU_LANE_TIMEOUT_MS_DEFAULT,
    gpu_lane_id_for
}
use std.io_runtime.{env_set}

use std.spec.step
describe "GPU lane routing (design §7-8)":
    it "routes the cuda backend to the GpuLaneExecutor path (driver present -> not-yet-implemented, not silently skipped)":
        step("Verify: routes the cuda backend to the GpuLaneExecutor path (driver present -> not-yet-implemented, not silently skipped)")
        # @req: REQ-COMPILER-GpuLaneComm-001
        val result = route_gpu_lane(file_path: "x.spl", setup_ms: 0, remote_backend: "cuda",
            driver_present: true, missing_symbol: "")
        expect(result.failed).to_equal(1)  # oracle: value fixed by the spec contract
        expect(result.skipped).to_equal(0)  # oracle: value fixed by the spec contract
        expect(result.error).to_contain("cuda lane executor not yet implemented")

    it "routes the vulkan backend to the GpuLaneExecutor path (driver present -> not-yet-implemented, not silently skipped)":
        step("Verify: routes the vulkan backend to the GpuLaneExecutor path (driver present -> not-yet-implemented, not silently skipped)")
        # @req: REQ-COMPILER-GpuLaneComm-001
        val result = route_gpu_lane(file_path: "x.spl", setup_ms: 0, remote_backend: "vulkan",
            driver_present: true, missing_symbol: "")
        expect(result.failed).to_equal(1)  # oracle: value fixed by the spec contract
        expect(result.skipped).to_equal(0)  # oracle: value fixed by the spec contract
        expect(result.error).to_contain("vulkan lane executor not yet implemented")

    it "produces a well-formed skip: line when the cuda driver is absent and CUDA_LIVE_REQUIRED is not set":
        step("Verify: produces a well-formed skip: line when the cuda driver is absent and CUDA_LIVE_REQUIRED is not set")
        # @req: REQ-COMPILER-GpuLaneComm-001
        val result = route_gpu_lane(file_path: "x.spl", setup_ms: 0, remote_backend: "cuda",
            driver_present: false, missing_symbol: "")
        expect(result.skipped).to_equal(1)  # oracle: value fixed by the spec contract
        expect(result.failed).to_equal(0)  # oracle: value fixed by the spec contract
        expect(result.error.starts_with("skip:")).to_equal(true)

    it "produces a well-formed skip: line when the vulkan ICD is absent and VULKAN_LIVE_REQUIRED is not set":
        step("Verify: produces a well-formed skip: line when the vulkan ICD is absent and VULKAN_LIVE_REQUIRED is not set")
        # @req: REQ-COMPILER-GpuLaneComm-001
        val result = route_gpu_lane(file_path: "x.spl", setup_ms: 0, remote_backend: "vulkan",
            driver_present: false, missing_symbol: "")
        expect(result.skipped).to_equal(1)  # oracle: value fixed by the spec contract
        expect(result.failed).to_equal(0)  # oracle: value fixed by the spec contract
        expect(result.error.starts_with("skip:")).to_equal(true)

    it "reports blocked: <symbol> for an unresolved rt_* probe symbol, taking precedence over driver absence":
        step("Verify: reports blocked: <symbol> for an unresolved rt_* probe symbol, taking precedence over driver absence")
        # @req: REQ-COMPILER-GpuLaneComm-001
        val result = route_gpu_lane(file_path: "x.spl", setup_ms: 0, remote_backend: "cuda",
            driver_present: false, missing_symbol: "rt_cuda_init")
        expect(result.skipped).to_equal(0)  # oracle: value fixed by the spec contract
        expect(result.failed).to_equal(1)  # oracle: value fixed by the spec contract
        expect(result.error).to_equal("blocked: rt_cuda_init")

    it "never converts driver-absent to skip once *_LIVE_REQUIRED is set (design §7 FAIL contract)":
        step("Verify: never converts driver-absent to skip once *_LIVE_REQUIRED is set (design §7 FAIL contract)")
        # @req: REQ-COMPILER-GpuLaneComm-001
        env_set("CUDA_LIVE_REQUIRED", "1")
        val result = route_gpu_lane(file_path: "x.spl", setup_ms: 0, remote_backend: "cuda",
            driver_present: false, missing_symbol: "")
        env_set("CUDA_LIVE_REQUIRED", "0")
        expect(result.skipped).to_equal(0)  # oracle: value fixed by the spec contract
        expect(result.failed).to_equal(1)  # oracle: value fixed by the spec contract
        expect(result.error).to_contain("CUDA_LIVE_REQUIRED=1")

describe "GPU lane env contract (design §7)":
    it "defaults GPU_LANE_TIMEOUT_MS to 30000ms":
        step("Verify: defaults GPU_LANE_TIMEOUT_MS to 30000ms")
        # @req: REQ-COMPILER-GpuLaneComm-001
        env_set("GPU_LANE_TIMEOUT_MS", "")
        expect(gpu_lane_timeout_ms()).to_equal(GPU_LANE_TIMEOUT_MS_DEFAULT)

    it "honors an explicit GPU_LANE_TIMEOUT_MS override":
        step("Verify: honors an explicit GPU_LANE_TIMEOUT_MS override")
        # @req: REQ-COMPILER-GpuLaneComm-001
        env_set("GPU_LANE_TIMEOUT_MS", "12345")
        expect(gpu_lane_timeout_ms()).to_equal(12345)  # oracle: value fixed by the spec contract
        env_set("GPU_LANE_TIMEOUT_MS", "")

    it "names CUDA_LIVE_REQUIRED / VULKAN_LIVE_REQUIRED for the right backend":
        step("Verify: names CUDA_LIVE_REQUIRED / VULKAN_LIVE_REQUIRED for the right backend")
        # @req: REQ-COMPILER-GpuLaneComm-001
        expect(gpu_live_required_env("cuda")).to_equal("CUDA_LIVE_REQUIRED")
        expect(gpu_live_required_env("vulkan")).to_equal("VULKAN_LIVE_REQUIRED")

    it "defaults *_LIVE_REQUIRED to false":
        step("Verify: defaults *_LIVE_REQUIRED to false")
        # @req: REQ-COMPILER-GpuLaneComm-001
        env_set("CUDA_LIVE_REQUIRED", "0")
        expect(gpu_live_required("cuda")).to_equal(false)

    it "lists at least one rt_* probe symbol per GPU backend":
        step("Verify: lists at least one rt_* probe symbol per GPU backend")
        # @req: REQ-COMPILER-GpuLaneComm-001
        expect(gpu_required_symbols("cuda").len() > 0).to_equal(true)
        expect(gpu_required_symbols("vulkan").len() > 0).to_equal(true)

    it "has a non-empty driver probe command per GPU backend":
        step("Verify: has a non-empty driver probe command per GPU backend")
        # @req: REQ-COMPILER-GpuLaneComm-001
        expect(gpu_driver_probe_cmd("cuda") != "").to_equal(true)
        expect(gpu_driver_probe_cmd("vulkan") != "").to_equal(true)

    it "keeps blocked: taking precedence over an unset live-required knob (design §7: probe symbols before driver)":
        step("Verify: keeps blocked: taking precedence over an unset live-required knob (design §7: probe symbols before driver)")
        # @req: REQ-COMPILER-GpuLaneComm-001
        val result = route_gpu_lane(file_path: "x.spl", setup_ms: 0, remote_backend: "vulkan",
            driver_present: true, missing_symbol: "rt_vulkan_alloc_buffer")
        expect(result.error).to_equal("blocked: rt_vulkan_alloc_buffer")

describe "gpu_lane_id_for — routing lane-spec strings to the real B2/B3/C2/C3 executors (closes gpu_lane_generic_routing_not_wired_to_real_executors_2026-08-07)":
    """The generic composite-runner dispatch (test_executor_composite.spl's
    run_test_file_gpu_lane_dispatch) uses this pure mapping to pick which
    concrete GpuLaneExecutor (CudaJitLaneExecutor/CudaVmExecutor/
    VulkanJitLaneExecutor/VulkanVmExecutor) drives a `remote(cuda(...))` /
    `remote(vulkan(...))` spec, instead of the old static "not yet
    implemented" FAIL. This spec only asserts the pure routing decision —
    the real construct-and-drive step needs the gc_async_mut-tier executor
    classes, which this module cannot import (circular import — see
    gpu_lane_id_for's docstring), so it lives in test_executor_composite.spl
    and is exercised end-to-end via that module's own dispatch, not here."""

    it "routes jit(remote(cuda(...))) to cuda_jit":
        step("Verify: routes jit(remote(cuda(...))) to cuda_jit")
        # @req: REQ-COMPILER-GpuLaneComm-001
        expect(gpu_lane_id_for("jit", "cuda")).to_equal("cuda_jit")

    it "routes interpreter(remote(cuda(...))) to cuda_vm":
        step("Verify: routes interpreter(remote(cuda(...))) to cuda_vm")
        # @req: REQ-COMPILER-GpuLaneComm-001
        expect(gpu_lane_id_for("interpreter", "cuda")).to_equal("cuda_vm")

    it "routes jit(remote(vulkan(...))) to vulkan_jit":
        step("Verify: routes jit(remote(vulkan(...))) to vulkan_jit")
        # @req: REQ-COMPILER-GpuLaneComm-001
        expect(gpu_lane_id_for("jit", "vulkan")).to_equal("vulkan_jit")

    it "routes interpreter(remote(vulkan(...))) to vulkan_vm":
        step("Verify: routes interpreter(remote(vulkan(...))) to vulkan_vm")
        # @req: REQ-COMPILER-GpuLaneComm-001
        expect(gpu_lane_id_for("interpreter", "vulkan")).to_equal("vulkan_vm")

    it "returns '' for a base_runtime with no concrete executor yet (e.g. cuda_vm_resident's 'resident' submode is carried outside base_runtime, so an unrecognized base still falls through honestly)":
        step("Verify: returns '' for a base_runtime with no concrete executor yet (e.g. cuda_vm_resident's 'resident' submode is carried outside base_runtime, so an unrecognized base still falls through honestly)")
        # @req: REQ-COMPILER-GpuLaneComm-001
        expect(gpu_lane_id_for("unknown_base", "cuda")).to_equal("")
        expect(gpu_lane_id_for("unknown_base", "vulkan")).to_equal("")

    it "returns '' for a backend with no landed executor (e.g. cudagdb)":
        step("Verify: returns '' for a backend with no landed executor (e.g. cudagdb)")
        # @req: REQ-COMPILER-GpuLaneComm-001
        expect(gpu_lane_id_for("jit", "cudagdb")).to_equal("")
        expect(gpu_lane_id_for("interpreter", "cudagdb")).to_equal("")
