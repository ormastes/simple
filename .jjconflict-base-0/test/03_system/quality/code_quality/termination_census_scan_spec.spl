# termination_census_scan_spec
#
# Unit-level proof for the WP-14 termination census scanner
# (src/compiler/90.tools/verify/termination_census_scan.spl): loop-bound
# classification (bounded/unknown) and recursion (self + mutual-pair)
# detection, driven over small synthetic source strings — no disk I/O, no
# dependency on the real repo tree's current state.

use std.spec
use compiler.tools.verify.termination_census_scan.{scan_single_file_loops, scan_sources_recursion, LoopVerdict, SccRecord}

fn find_verdict(verdicts: [LoopVerdict], fn_name: text) -> LoopVerdict:
    for v in verdicts:
        if v.fn_name == fn_name:
            return v
    LoopVerdict(path: "", fn_name: "__not_found__", line: 0, verdict: "__missing__", detail: "")

fn range_bounded_source() -> text:
    """A `for` loop over an integer-literal range: must classify bounded."""
    ("fn sum_first_ten() -> i64:\n"
        + "    var total = 0\n"
        + "    for i in 0..10:\n"
        + "        total = total + i\n"
        + "    total\n")

fn fixed_collection_source() -> text:
    """A `for` loop over a variable declared as a fixed-capacity collection:
    must classify bounded."""
    ("fn sum_slots() -> i64:\n"
        + "    val slots: FixedArray<i64> = FixedArray(cap: 8)\n"
        + "    var total = 0\n"
        + "    for s in slots:\n"
        + "        total = total + s\n"
        + "    total\n")

fn unbounded_while_source() -> text:
    """A `while true:` loop with no static bound: must classify unknown and
    must report this function's own name/path."""
    ("fn poll_forever() -> i64:\n"
        + "    var n = 0\n"
        + "    while true:\n"
        + "        n = n + 1\n"
        + "    n\n")

fn unrecognized_for_source() -> text:
    """A `for` loop over a plain (non-fixed-capacity, non-range) expression:
    must classify unknown, not fabricate a bounded verdict."""
    ("fn sum_list(items: [i64]) -> i64:\n"
        + "    var total = 0\n"
        + "    for x in items:\n"
        + "        total = total + x\n"
        + "    total\n")

fn mutual_recursion_sources() -> Dict<text, text>:
    """Two mutually-recursive functions in one synthetic file: must be
    flagged as one SCC (both members present)."""
    val src = ("fn is_even(n: i64) -> bool:\n"
        + "    if n == 0:\n"
        + "        return true\n"
        + "    is_odd(n - 1)\n"
        + "\n"
        + "fn is_odd(n: i64) -> bool:\n"
        + "    if n == 0:\n"
        + "        return false\n"
        + "    is_even(n - 1)\n")
    var m: Dict<text, text> = {}
    m["fixture/mutual.spl"] = src
    m

fn self_recursion_source() -> text:
    """A single self-recursive function: must be flagged as its own
    self-loop SCC."""
    ("fn countdown(n: i64) -> i64:\n"
        + "    if n <= 0:\n"
        + "        return 0\n"
        + "    countdown(n - 1)\n")

describe "termination census scan — loop bounds":

    it "classifies an integer-literal range for-loop as bounded":
        val verdicts = scan_single_file_loops("fixture/range.spl", range_bounded_source())
        val v = find_verdict(verdicts, "sum_first_ten")
        expect(v.verdict).to_equal("bounded")

    it "classifies a fixed-capacity collection iteration as bounded":
        val verdicts = scan_single_file_loops("fixture/fixed.spl", fixed_collection_source())
        val v = find_verdict(verdicts, "sum_slots")
        expect(v.verdict).to_equal("bounded")

    it "classifies an unbounded while-loop as unknown and names the function":
        val verdicts = scan_single_file_loops("fixture/while.spl", unbounded_while_source())
        val v = find_verdict(verdicts, "poll_forever")
        expect(v.verdict).to_equal("unknown")
        expect(v.fn_name).to_equal("poll_forever")
        expect(v.path).to_equal("fixture/while.spl")
        expect(v.detail).to_contain("while-loop")

    it "classifies a for-loop over an unrecognized iterable as unknown, not bounded":
        val verdicts = scan_single_file_loops("fixture/list.spl", unrecognized_for_source())
        val v = find_verdict(verdicts, "sum_list")
        expect(v.verdict).to_equal("unknown")

describe "termination census scan — recursion":

    it "flags two mutually-recursive functions as one SCC":
        val sccs = scan_sources_recursion(mutual_recursion_sources())
        var found = false
        for s in sccs:
            if s.members.len() == 2:
                val has_even = s.members[0] == "is_even" or s.members[1] == "is_even"
                val has_odd = s.members[0] == "is_odd" or s.members[1] == "is_odd"
                if has_even and has_odd:
                    found = true
        expect(found).to_equal(true)

    it "flags a self-recursive function as its own self-loop SCC":
        var m: Dict<text, text> = {}
        m["fixture/self.spl"] = self_recursion_source()
        val sccs = scan_sources_recursion(m)
        var found = false
        for s in sccs:
            if s.self_loop and s.members.len() == 1 and s.members[0] == "countdown":
                found = true
        expect(found).to_equal(true)
