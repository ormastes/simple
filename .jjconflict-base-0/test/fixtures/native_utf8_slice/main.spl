# Fixture for scripts/check/check-native-utf8-slice.shs
# Bug: doc/08_tracking/bug/native_slice_splits_utf8_three_divergent_policies_2026-08-01.md
#
# Probe string s = "aé€𝄞z" (11 bytes: 61 | c3a9 | e282ac | f09d849e | 7a).
# Slicing at offset 2 lands inside the 2-byte "é" codepoint (bytes 1-2).
# No imports -- an import forces a whole-module interpreter fallback and
# would make the run silently vacuous (see bug doc "Reproduce" section).

fn dump(tag: text, v: text):
    print(tag + "|" + v.len().to_text() + "|" + v)

fn main():
    val s = "aé€𝄞z"
    dump("bracket_ctl", s[0:3])
    dump("bracket_cut", s[0:2])
    dump("slice_cut", s.slice(0, 2))
    dump("substring_cut", s.substring(0, 2))
