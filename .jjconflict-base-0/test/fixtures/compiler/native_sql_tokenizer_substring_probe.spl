"""Native regression probe for SQL token text extraction without text slices."""

use nogc_sync_mut.db.dbfs_engine.sql_parser.{sql_tokenize, SqlTokenKind}

fn main() -> i64:
    val ddl = sql_tokenize("CREATE TABLE messaging_events")
    if ddl.len() != 4:
        print "FAIL ddl_length={ddl.len()}"
        var index: i64 = 0
        while index < ddl.len():
            print "token[{index}]=" + ddl[index].value
            index = index + 1
        return 1
    if ddl[0].kind != SqlTokenKind.Create or ddl[0].value != "CREATE":
        print "FAIL create=" + ddl[0].value
        return 2
    if ddl[1].kind != SqlTokenKind.Table or ddl[1].value != "TABLE":
        print "FAIL table=" + ddl[1].value
        return 3
    if ddl[2].kind != SqlTokenKind.Ident or ddl[2].value != "messaging_events":
        print "FAIL identifier=" + ddl[2].value
        return 4

    val literal = sql_tokenize("'agent''s café'")
    if literal.len() != 2 or literal[0].kind != SqlTokenKind.StringLit:
        print "FAIL literal_shape"
        return 5
    if literal[0].value != "agent's café":
        print "FAIL literal=" + literal[0].value
        return 6

    print "PASS native_sql_tokenizer_substring"
    0
