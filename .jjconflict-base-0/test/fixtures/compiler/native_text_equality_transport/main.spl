struct TransportedName:
    value: text

fn equals_strip(value: text) -> bool:
    value == "strip"

fn equals_empty(value: text) -> bool:
    value == ""

fn main() -> i64:
    val transported = TransportedName(value: "str.strip")
    val custom = TransportedName(value: "CustomOwner.strip")
    val custom_lines = TransportedName(value: "CustomOwner.lines")
    if not equals_strip("strip"):
        return 1
    if not equals_empty(""):
        return 2
    if transported.value != "str.strip":
        return 3
    if custom.value == "str.strip":
        return 4
    if equals_strip("lines"):
        return 5
    if custom_lines.value == "str.lines":
        return 6
    print "native-text-equality-transport: PASS"
    0
