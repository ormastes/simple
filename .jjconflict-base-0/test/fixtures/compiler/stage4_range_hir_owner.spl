fn sum_first_range() -> i64:
    var total: i64 = 0
    for i in range(0, 5):
        total = total + i
    total

fn sum_second_range() -> i64:
    var total: i64 = 0
    for i in range(2, 6):
        total = total + i
    total

fn main() -> i64:
    if sum_first_range() != 10:
        return 41
    if sum_second_range() != 14:
        return 42
    0
