use app.cli.query_lint.{
    _collect_lint_diagnostics_json, _emit_source_lint_diagnostics}
use app.cli.query_rich_common.{query_mcp_diagnostics_wrapper_json}

extern fn rt_cli_get_args() -> [text]
extern fn rt_env_set(key: text, value: text) -> bool
extern fn rt_set_debug_mode(enabled: bool)

val ordinary = rt_cli_get_args().contains("ordinary")
val trace_keys = [
    "SIMPLE_TRACE_AST_RESET", "SIMPLE_COMPILER_TRACE",
    "SIMPLE_TRACE_STMT_TAGS",
    "SIMPLE_TRACE_EXPR_TAGS", "SIMPLE_TRACE_AST_EXPR_CALLS",
    "SIMPLE_TRACE_AST_OOB"
]
for key in trace_keys:
    rt_env_set(key, "1")

rt_set_debug_mode(true)
val source =
    "fn f():\n" +
    "    pass_todo(\"trace contract\")\n" +
    "    print(\"x\")\n"
if ordinary:
    _emit_source_lint_diagnostics(
        "src/query_lint_trace_contract_input.spl", source, "text")
else:
    val result = _collect_lint_diagnostics_json(
        "src/query_lint_trace_contract_input.spl", source)
    print query_mcp_diagnostics_wrapper_json(result.1)
rt_set_debug_mode(false)

for key in trace_keys:
    rt_env_set(key, "")
