"""TOP-LEVEL struct/class pattern refutability matrix.

Companion to `nested_payload_subpattern_depth_matrix.spl`, which pins struct
sub-patterns that sit INSIDE an enum payload / array element / tuple element.
Those already routed through `subpattern_condition` -> `struct_fields_condition`
and were correct. This file pins the shape that did NOT: a struct/class pattern
in TOP-LEVEL `case` position.

The parser cannot tell `Point(0, y)` from an enum variant, so it emits
`Pattern::Enum{name:"_", variant:"Point", payload:Some([...])}`. Both
`lower_pattern_condition` (expression form) and `lower_pattern_condition_stmt`
(statement form -- the one match ARMS take) recognised the class spelling and
returned `Bool(true)` while DISCARDING `payload` entirely. Same shape as the
enum-payload bug: the tag half was handled, the payload half was dropped, so
`case Point(0, y)` matched EVERY Point and swallowed every later arm. The
named-field spelling `Pattern::Struct` was the same unconditional `Bool(true)`.

The NAMED-FIELD spelling `case Point { x: 0, y: b }:` needed two more fixes
before any row could be written for it, and both are pinned by the `d1_named_*`
rows: it did not PARSE (the field-separating `,` was eaten as a comma
or-pattern), and once it parsed it had no BINDER
(`build_pattern_binding_stmts` had no `Pattern::Struct` arm, so names were read
off the zeroed stack -- 0 on the JIT, correct on the interpreter).

Run under BOTH engines and diff -- the tree-walk interpreter recurses correctly
(`interpreter_patterns.rs`) and was always right here, so an interpreter-only
run proves nothing:

    SIMPLE_EXECUTION_MODE=interpreter simple run <this file>
    SIMPLE_EXECUTION_MODE=jit         simple run <this file>

Both must print `BADCOUNT 0`.

Every `*_miss` row is the load-bearing one: a positive-only test CANNOT detect
an irrefutable matcher, because an always-true condition still answers the PASS
case correctly. The `*_hit` rows exist only to prove the fix did not overshoot
into always-false.

`nil3_ctrl` guards the other direction: the nil sentinel is the integer 3, so a
binder that silently reads nil is indistinguishable from a correct 3. Its
correct answer is 3 while the neighbouring rows answer values that are not 3.

Two row families separate the CONDITION half from the BINDER half, and both
halves had to be fixed to make them pass:

* `d2_pos` / `d3_pos` / `d4_pos` crashed outright before the fix
  (`runtime error: field access on nil receiver`, SIGILL) -- a nested struct
  field of a top-level class pattern was extracted with `rt_enum_payload`,
  which answers the nil sentinel for a plain struct pointer.
* `d2_seq_*` selected the RIGHT arm -- element literal test and array length
  discriminator both worked over a struct-field slot -- but bound the wrong
  VALUES (`a` came back as `<value:0x6>` and `b` as `1` for `xs = [6, 8]`).
  Root cause was the binding TYPE, not the addressing: `collect_pattern_bindings`
  resolved payload field types only for real ENUM variants, so the positional
  class spelling `Holder([a, b], (c, d))` -- which the parser hands over as
  `Pattern::Enum` with a STRUCT name -- typed every field ANY, which typed the
  array ELEMENTS ANY, and MIR then picked generic boxing. FIXED, now inside the
  BADCOUNT gate:
  doc/08_tracking/bug/sequence_subpattern_of_struct_field_binds_garbage_2026-08-04.md
"""

struct Point:
    x: i64
    y: i64

struct Wrap2:
    p: Point
    n: i64

struct Deep3:
    w: Wrap2
    t: i64

struct Holder:
    xs: [i64]
    t: (i64, i64)

# --- depth 1: literal field in a top-level positional class pattern ----------
# This is the row the old code got wrong: arm 1 was irrefutable, so
# `Point(3, 4)` took it and answered 4 instead of 107.
fn d1_pos(p: Point) -> i64:
    match p:
        case Point(0, b): b
        case Point(a, b): a + b + 100
        case _: -1

# Both fields literal -- proves the per-field AND, not just the first field.
fn d1_pos_both(p: Point) -> i64:
    match p:
        case Point(1, 2): 12
        case Point(1, b): b + 100
        case Point(a, b): a + b + 200
        case _: -1

# --- depth 1: the NAMED-FIELD spelling `case Point { x: 0, y: b }: ` ---------
# This spelling used to be unreachable: it did not PARSE in `case` position
# (`Unexpected token: expected Comma, found Colon`), because the field
# sub-pattern was parsed with the full `parse_pattern`, which swallowed the
# field-separating `,` as a comma OR-pattern and then choked on the next
# field's `:`. Fixed by `parse_pattern_no_comma_or` (parser_patterns.rs).
#
# Once it parsed, a SECOND defect showed: `build_pattern_binding_stmts` had no
# `Pattern::Struct` arm, so the arm was selected correctly and then every name
# was read off the ZEROED stack -- `d1_named_hit` answered 0 instead of 7 on
# the JIT while the tree-walk interpreter was right, the usual signature of a
# missing binder. Fixed by the `Pattern::Struct` arm there.
#
# `d1_named_miss` is the load-bearing row: it is the one an irrefutable
# `Bool(true)` condition cannot answer. `d1_named_hit`'s 7 is the one a missing
# binder cannot answer (it reads 0). Both directions are needed.
fn d1_named(p: Point) -> i64:
    match p:
        case Point { x: 0, y: b }: b
        case Point { x: a, y: b }: a + b + 100
        case _: -1

# Field-shorthand spelling `{ x, y }` -- binds by field name, no sub-pattern.
fn d1_named_short(p: Point) -> i64:
    match p:
        case Point { x, y }: x + y
        case _: -1

# --- depth 2: struct inside a top-level struct pattern ----------------------
fn d2_pos(w: Wrap2) -> i64:
    match w:
        case Wrap2(Point(0, b), n): b + n
        case Wrap2(Point(a, b), n): a + b + n + 100
        case _: -1

# --- depth 3 -----------------------------------------------------------------
fn d3_pos(d: Deep3) -> i64:
    match d:
        case Deep3(Wrap2(Point(0, b), n), t): b + n + t
        case Deep3(Wrap2(Point(a, b), n), t): a + b + n + t + 100
        case _: -1

# --- depth 4 -----------------------------------------------------------------
# The innermost literal is four levels down; nothing above it is refutable, so
# an implementation that stops recursing at any level answers the wrong arm.
fn d4_pos(d: Deep3) -> i64:
    match d:
        case Deep3(Wrap2(Point(a, 9), n), t): a + n + t
        case Deep3(Wrap2(Point(a, b), n), t): a + b + n + t + 500
        case _: -1

# --- array / tuple sub-patterns under a top-level struct pattern -------------
fn d2_seq(h: Holder) -> i64:
    match h:
        case Holder([0, b], (c, d)): b + c + d
        case Holder([a, b], (c, d)): a + b + c + d + 100
        case _: -1

# Array LENGTH is a runtime property, so the element count must discriminate
# even when every element sub-pattern is an irrefutable binder.
fn d2_seq_len(h: Holder) -> i64:
    match h:
        case Holder([a], (c, d)): a + c + d
        case Holder([a, b], (c, d)): a + b + c + d + 100
        case _: -1

# --- text literal field: takes the rt_string_eq path, not the scalar one -----
struct Named:
    s: text
    k: i64

fn d1_text(n: Named) -> i64:
    match n:
        case Named("hi", k): k
        case Named(_, k): k + 100
        case _: -1

# --- value-3 control ---------------------------------------------------------
# Correct answer is 3, so a silently-nil binder cannot be told from a correct
# read here alone -- but it also cannot satisfy the neighbouring non-3 rows.
fn nil3_ctrl(p: Point) -> i64:
    match p:
        case Point(0, b): b
        case Point(a, b): a + b + 100
        case _: -1

fn check(name: text, got: i64, want: i64) -> i64:
    if got == want:
        print("PASS {name} got={got}")
        return 0
    print("FAIL {name} got={got} want={want}")
    1

# Harness self-test: proves `check` CAN report a mismatch, so a green matrix is
# not vacuous. The single FAIL line it prints is expected.
fn sentinel() -> i64:
    print("-- sentinel: the next FAIL line is EXPECTED --")
    val detected = check("SENTINEL_expected_fail", 1, 999)
    if detected == 1:
        print("PASS sentinel_harness_live")
        return 0
    print("FAIL sentinel_harness_VACUOUS")
    1

fn main() -> i64:
    var bad = 0
    bad = bad + sentinel()

    bad = bad + check("d1_pos_hit", d1_pos(Point(x: 0, y: 7)), 7)
    bad = bad + check("d1_pos_miss", d1_pos(Point(x: 3, y: 4)), 107)

    bad = bad + check("d1_both_hit", d1_pos_both(Point(x: 1, y: 2)), 12)
    bad = bad + check("d1_both_partial", d1_pos_both(Point(x: 1, y: 5)), 105)
    bad = bad + check("d1_both_miss", d1_pos_both(Point(x: 4, y: 5)), 209)

    bad = bad + check("d1_named_hit", d1_named(Point(x: 0, y: 7)), 7)
    bad = bad + check("d1_named_miss", d1_named(Point(x: 3, y: 4)), 107)
    bad = bad + check("d1_named_short", d1_named_short(Point(x: 3, y: 4)), 7)

    bad = bad + check("d2_hit", d2_pos(Wrap2(p: Point(x: 0, y: 7), n: 2)), 9)
    bad = bad + check("d2_miss", d2_pos(Wrap2(p: Point(x: 3, y: 4), n: 2)), 109)

    bad = bad + check("d3_hit", d3_pos(Deep3(w: Wrap2(p: Point(x: 0, y: 7), n: 2), t: 5)), 14)
    bad = bad + check("d3_miss", d3_pos(Deep3(w: Wrap2(p: Point(x: 3, y: 4), n: 2), t: 5)), 114)

    bad = bad + check("d4_hit", d4_pos(Deep3(w: Wrap2(p: Point(x: 1, y: 9), n: 2), t: 5)), 8)
    bad = bad + check("d4_miss", d4_pos(Deep3(w: Wrap2(p: Point(x: 1, y: 4), n: 2), t: 5)), 512)

    # Previously OPEN (the JIT bound `a` as an undecoded `<value:0x6>` and `b`
    # as `1`), now inside the BADCOUNT gate. `open_bad` is kept as a live,
    # always-printed tally so a future regression of this family reappears as a
    # non-zero OPENCOUNT rather than silently vanishing from the file.
    var open_bad = 0
    bad = bad + check("d2_seq_hit", d2_seq(Holder(xs: [0, 7], t: (2, 5))), 14)
    bad = bad + check("d2_seq_miss", d2_seq(Holder(xs: [3, 4], t: (2, 5))), 114)
    bad = bad + check("d2_seq_len1", d2_seq_len(Holder(xs: [6], t: (2, 5))), 13)
    bad = bad + check("d2_seq_len2", d2_seq_len(Holder(xs: [6, 8], t: (2, 5))), 121)

    bad = bad + check("d1_text_hit", d1_text(Named(s: "hi", k: 7)), 7)
    bad = bad + check("d1_text_miss", d1_text(Named(s: "bye", k: 7)), 107)

    bad = bad + check("nil3_ctrl", nil3_ctrl(Point(x: 0, y: 3)), 3)

    print("OPENCOUNT {open_bad}")
    print("BADCOUNT {bad}")
    bad
