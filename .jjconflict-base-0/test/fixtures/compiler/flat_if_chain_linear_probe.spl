use compiler.frontend.flat_ast_bridge.{parse_and_build_module}
use compiler.frontend.parser_types.*

extern fn rt_env_get(key: text) -> text

fn probe_arm_count() -> i64:
    if (rt_env_get("SIMPLE_IF_CHAIN_PROBE_ARMS") ?? "") == "256":
        return 256
    128

fn statement_source(arm_count: i64) -> text:
    var src = "fn statement_chain(n: i64) -> i64:\n"
    var i = 0
    while i < arm_count:
        if i == 0:
            src = src + "    if n == {i}:\n        return {i}\n"
        else:
            src = src + "    elif n == {i}:\n        return {i}\n"
        i = i + 1
    src + "    else:\n        return -1\n"

fn value_source(arm_count: i64) -> text:
    var src = "fn value_chain(n: i64) -> i64:\n    val result = if n == 0:\n        0\n"
    var i = 1
    while i < arm_count:
        src = src + "    elif n == {i}:\n        {i}\n"
        i = i + 1
    src + "    else:\n        -1\n    result\n"

fn statement_depth(src: text) -> i64:
    val module = parse_and_build_module(src, "statement_chain.spl")
    val fn_ = module.functions["statement_chain"] ?? panic("missing statement_chain")
    if fn_.body.stmts.len() != 1:
        return -1
    match fn_.body.stmts[0].kind:
        case StmtKind.Expr(expr):
            match expr.kind:
                case ExprKind.IfChain(arms, else_):
                    if else_ == nil: return -2
                    return arms.len()
                case _: return -3
        case _: return -4

fn value_depth(src: text) -> i64:
    val module = parse_and_build_module(src, "value_chain.spl")
    val fn_ = module.functions["value_chain"] ?? panic("missing value_chain")
    for stmt in fn_.body.stmts:
        match stmt.kind:
            case StmtKind.Val(_, _, init):
                match init.kind:
                    case ExprKind.IfChain(arms, else_):
                        if else_ == nil: return -2
                        return arms.len()
                    case _: pass
            case _: pass
    -1

fn main():
    val wanted = probe_arm_count()
    val statement_actual = statement_depth(statement_source(wanted))
    if statement_actual != wanted:
        panic("statement if-chain depth mismatch")
    val value_actual = value_depth(value_source(wanted))
    if value_actual != wanted:
        panic("value if-chain depth mismatch")
    print "flat-if-chain probe PASS arms={wanted}"
