# Defect-CLASS probe: which CONTAINER kinds corrupt a large i64?
#
# Each `big_*` line stores 2^62 into a different container and reads it back;
# each `ctl_*` line does exactly the same through the same container with the
# small value 7. The `ctl_*` lines are the POSITIVE CONTROL: they exercise the
# identical store/load path, so a container whose control also disagrees is a
# broken probe rather than evidence of the magnitude-dependent defect.

struct Holder:
    v: i64

fn thru_list(v: i64) -> i64:
    val xs: [i64] = [v]
    xs[0]

fn thru_nested(v: i64) -> i64:
    val xs: [[i64]] = [[v]]
    xs[0][0]

fn thru_struct(v: i64) -> i64:
    val h = Holder(v: v)
    h.v

fn thru_tuple(v: i64) -> i64:
    val t = (v, 0)
    val (a, _b) = t
    a

fn thru_scalar(v: i64) -> i64:
    v

fn main() -> i64:
    val big = 4611686018427387904    # 2^62
    val ctl = 7
    print("big_scalar={thru_scalar(big)}")
    print("ctl_scalar={thru_scalar(ctl)}")
    print("big_list={thru_list(big)}")
    print("ctl_list={thru_list(ctl)}")
    print("big_nested={thru_nested(big)}")
    print("ctl_nested={thru_nested(ctl)}")
    print("big_struct={thru_struct(big)}")
    print("ctl_struct={thru_struct(ctl)}")
    print("big_tuple={thru_tuple(big)}")
    print("ctl_tuple={thru_tuple(ctl)}")
    0
