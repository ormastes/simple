class VulkanRetainedHostMirror:
    width: i64
    pixels: [u32]

    static fn create(width: i64, rows: i64) -> VulkanRetainedHostMirror:
        VulkanRetainedHostMirror(width: width, pixels: [0u32; width * rows])

    me copy_packed_rows(x: i64, y: i64, row_width: i64,
                        rows: i64, packed: [u32]):
        var source = 0
        var row = 0
        while row < rows:
            var col = 0
            while col < row_width:
                self.pixels[(y + row) * self.width + x + col] = packed[source]
                source += 1
                col += 1
            row += 1

    fn sample(indices: [i64]) -> [u32]:
        var result: [u32] = []
        for index in indices:
            if index < 0 or index >= self.pixels.len():
                return []
            result.push(self.pixels[index])
        result

fn main():
    val width = 7680
    val rows = 64
    var mirror = VulkanRetainedHostMirror.create(width, rows)
    var packed = [0u32; 64 * 64]
    var frame = 0
    while frame < 210:
        packed[32 * 64 + 32] = if frame % 2 == 0:
            0xffe62846u32
        else:
            0xff1ec86eu32
        mirror.copy_packed_rows(288, 0, 64, 64, packed)
        frame += 1
    val changed = 32 * width + 320
    val samples = mirror.sample([0, changed, width * rows - 1])
    print("JIT_VULKAN_MIRROR first=" + samples[0].to_i64().to_string()
        + " changed=" + samples[1].to_i64().to_string()
        + " last=" + samples[2].to_i64().to_string())

main()
