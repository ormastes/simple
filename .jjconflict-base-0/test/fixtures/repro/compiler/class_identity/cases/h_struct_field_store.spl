# F1 corpus case H — STRUCT written into an already-constructed class field
# (`h.cell = s`). S1 copy-site 3.
# Contract: struct = value semantics, so the field is a SNAPSHOT.
# Prints VAL when the contract holds, ALIAS(n=..) when it is violated.

struct SCellH:
    n: i64

class HolderH:
    cell: SCellH

fn main():
    val h = HolderH(cell: SCellH(n: 0))
    var s = SCellH(n: 20)
    h.cell = s
    s.n = 21
    val got = h.cell.n
    if got == 20:
        print "H struct field store   = VAL"
    else:
        print "H struct field store   = ALIAS(n={got})"
