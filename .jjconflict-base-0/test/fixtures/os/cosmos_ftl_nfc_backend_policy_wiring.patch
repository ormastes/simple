diff --git a/scripts/check/check-cosmos-ftl-nfc-backend-policy-stage4.shs b/scripts/check/check-cosmos-ftl-nfc-backend-policy-stage4.shs
new file mode 100755
--- /dev/null
+++ b/scripts/check/check-cosmos-ftl-nfc-backend-policy-stage4.shs
@@ -0,0 +1,132 @@
+#!/bin/sh
+# Admitted Stage-4 host parity, compiler coverage, ARM closure, and receipt gate.
+set -eu
+
+ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
+SOURCE_DIR=$ROOT/src/os/kernel/arch/arm32/cosmos
+POLICY_REL=src/os/kernel/arch/arm32/cosmos/cosmos_ftl_nfc_backend_policy.spl
+POLICY=$ROOT/$POLICY_REL
+HEADER=$SOURCE_DIR/cosmos_ftl_nfc_backend_policy.h
+BRIDGE=$SOURCE_DIR/cosmos_ftl_nfc_backend.c
+ORACLE_DIR=$ROOT/test/02_integration/os/cosmos
+ORACLE=$ORACLE_DIR/cosmos_ftl_nfc_backend_policy_frozen_oracle.c
+PARITY=$ORACLE_DIR/cosmos_ftl_nfc_backend_policy_parity_test.c
+PROBE=$ROOT/test/fixtures/os/cosmos_ftl_nfc_backend_policy_probe.spl
+PIN=$ROOT/test/fixtures/os/cosmos_ftl_nfc_backend_policy_coverage_pin.env
+SOURCE_CHECK=$ROOT/scripts/check/check-cosmos-ftl-nfc-backend-policy-source-c.shs
+OUT=$ROOT/build/coverage/cosmos-ftl-nfc-backend-policy
+SOURCE_OUT=$OUT/source-c
+CC_BIN=${CC:-clang}
+NM_BIN=${NM:-nm}
+READELF_BIN=${READELF:-readelf}
+
+fail() { echo "FAIL cosmos-ftl-nfc-backend-policy-stage4: $*" >&2; exit 1; }
+blocked() { echo "BLOCKED cosmos-ftl-nfc-backend-policy-stage4: $*" >&2; exit 2; }
+hash_file() { sha256sum "$1" | awk '{print $1}'; }
+pin_value() { sed -n "s/^$1=//p" "$PIN"; }
+
+[ -n "${SIMPLE_STAGE4_BIN:-}" ] && [ -x "$SIMPLE_STAGE4_BIN" ] ||
+    blocked "set SIMPLE_STAGE4_BIN to an admitted Stage-4 compiler"
+BOOTSTRAP_STAGE3_FACADE_PATH=$ROOT/scripts/check/lib/bootstrap-stage3-provenance.shs
+STAGE4_PROVENANCE_HELPER_PATH=$ROOT/scripts/check/lib/stage4-candidate-provenance.shs
+export BOOTSTRAP_STAGE3_FACADE_PATH STAGE4_PROVENANCE_HELPER_PATH
+. "$BOOTSTRAP_STAGE3_FACADE_PATH"
+. "$STAGE4_PROVENANCE_HELPER_PATH"
+SIMPLE=$(bootstrap_stage3_canonical_file "$SIMPLE_STAGE4_BIN") ||
+    blocked "cannot resolve compiler canonically"
+PROVENANCE=${SIMPLE}.provenance.env
+stage4_verify_candidate_provenance "$PROVENANCE" "$SIMPLE" "$ROOT" ||
+    blocked "admitted current-tree Stage-4 provenance required"
+case "$("$SIMPLE" --version 2>&1 || true)" in
+    *"Rust-built Simple binary is a bootstrap seed"*|*"bootstrap seed only"*)
+        blocked "bootstrap seed cannot prove this migration" ;;
+esac
+for tool in "$CC_BIN" "$NM_BIN" "$READELF_BIN" sha256sum awk cmp grep \
+    sed ld.lld; do
+    command -v "$tool" >/dev/null 2>&1 || blocked "missing tool: $tool"
+done
+mkdir -p "$OUT"
+COSMOS_FTL_NFC_BACKEND_POLICY_OUT=$SOURCE_OUT "$SOURCE_CHECK" --produce
+COSMOS_FTL_NFC_BACKEND_POLICY_OUT=$SOURCE_OUT "$SOURCE_CHECK" --verify
+
+SIMPLE_LIB=$ROOT/src "$SIMPLE" native-build --backend llvm \
+    --source "$SOURCE_DIR" --entry "$POLICY" --entry-closure \
+    --target x86_64-unknown-linux-gnu --emit-object --no-mangle \
+    --cache-dir "$OUT/cache-host" -o "$OUT/policy-host.o"
+"$NM_BIN" --defined-only --extern-only --format=posix "$OUT/policy-host.o" |
+    awk '$1 ~ /^cosmos_ftl_nfc_backend_policy_/ {print $1}' |
+    LC_ALL=C sort -u > "$OUT/host-exports.txt"
+cmp "$SOURCE_OUT/header-policy-symbols.txt" "$OUT/host-exports.txt" ||
+    fail host-export-closure
+HOST_UNDEFINED=$("$NM_BIN" --undefined-only --format=posix \
+    "$OUT/policy-host.o" | awk '{print $1}')
+[ -z "$HOST_UNDEFINED" ] || fail "host undefined symbols: $HOST_UNDEFINED"
+"$CC_BIN" -std=c11 -O2 -Wall -Wextra -Werror -Wpedantic -Wshadow \
+    -I"$SOURCE_DIR" -I"$ORACLE_DIR" "$PARITY" "$ORACLE" \
+    "$OUT/policy-host.o" -o "$OUT/host-parity"
+PARITY_OUTPUT=$("$OUT/host-parity")
+[ "$PARITY_OUTPUT" = "COSMOS_FTL_NFC_BACKEND_PARITY_ROWS 125" ] ||
+    fail "host parity: $PARITY_OUTPUT"
+
+SIMPLE_COVERAGE=1 SIMPLE_COVERAGE_OUTPUT="$OUT/simple-coverage.sdn" \
+    "$SIMPLE" run "$PROBE" > "$OUT/simple-probe.out" 2> "$OUT/simple-probe.log" ||
+    fail compiler-coverage-run
+[ -s "$OUT/simple-coverage.sdn" ] || fail compiler-coverage-missing
+awk -F', *' -v owner="/$POLICY_REL" '
+    index($2, owner) == length($2) - length(owner) + 1 {
+        print ($3 + 0) "\t" (($5 + 0) > 0 ? 1 : 0) "\t" (($6 + 0) > 0 ? 1 : 0)
+    }' "$OUT/simple-coverage.sdn" | LC_ALL=C sort -n > "$OUT/owner-coverage.tsv"
+awk -F: '{print ($1 + 0)}' "$SOURCE_OUT/decision-locations.txt" |
+    LC_ALL=C sort -n > "$OUT/required-lines.txt"
+cut -f1 "$OUT/owner-coverage.tsv" > "$OUT/observed-lines.txt"
+cmp "$OUT/required-lines.txt" "$OUT/observed-lines.txt" ||
+    fail compiler-location-closure
+[ "$(wc -l < "$OUT/owner-coverage.tsv" | tr -d ' ')" = 71 ] ||
+    fail compiler-decision-count
+BRANCH_HITS=$(awk -F '\t' '{n += $2 + $3} END {print n + 0}' \
+    "$OUT/owner-coverage.tsv")
+[ "$BRANCH_HITS" = 142 ] || fail "compiler branches: $BRANCH_HITS/142"
+[ "$(pin_value branch_outcomes_total)" = 142 ] || fail branch-pin
+
+SIMPLE_LIB=$ROOT/src "$SIMPLE" native-build --backend llvm \
+    --source "$SOURCE_DIR" --entry "$POLICY" --entry-closure \
+    --target armv7-unknown-none-eabi --emit-object --no-mangle \
+    --cache-dir "$OUT/cache-arm" -o "$OUT/policy-arm.o"
+"$READELF_BIN" -hW "$OUT/policy-arm.o" > "$OUT/policy-arm-header.txt"
+"$READELF_BIN" -AW "$OUT/policy-arm.o" > "$OUT/policy-arm-attributes.txt"
+grep -Eq 'Class:[[:space:]]+ELF32' "$OUT/policy-arm-header.txt" || fail arm-class
+grep -Eq 'Type:[[:space:]]+REL' "$OUT/policy-arm-header.txt" || fail arm-type
+grep -Eq 'Machine:[[:space:]]+ARM' "$OUT/policy-arm-header.txt" || fail arm-machine
+grep -Fq 'Tag_CPU_name: "cortex-a9"' "$OUT/policy-arm-attributes.txt" || fail arm-cpu
+"$NM_BIN" --defined-only --extern-only --format=posix "$OUT/policy-arm.o" |
+    awk '$1 ~ /^cosmos_ftl_nfc_backend_policy_/ {print $1}' |
+    LC_ALL=C sort -u > "$OUT/arm-exports.txt"
+cmp "$SOURCE_OUT/header-policy-symbols.txt" "$OUT/arm-exports.txt" ||
+    fail arm-export-closure
+"$CC_BIN" --target=armv7-none-eabi -mcpu=cortex-a9 -marm -ffreestanding \
+    -nostdlib -fno-builtin -O2 -Wall -Wextra -Werror \
+    -DCOSMOS_FTL_NFC_BACKEND_PURE_POLICY=1 -c "$BRIDGE" \
+    -o "$OUT/bridge-arm.o"
+ld.lld -r "$OUT/bridge-arm.o" "$OUT/policy-arm.o" -o "$OUT/linked-arm.o"
+if "$NM_BIN" -u "$OUT/linked-arm.o" | awk '{print $NF}' |
+        grep '^cosmos_ftl_nfc_backend_policy_' >/dev/null; then
+    fail arm-link-closure
+fi
+stage4_verify_candidate_provenance "$PROVENANCE" "$SIMPLE" "$ROOT" ||
+    fail provenance-changed
+{
+    echo schema=cosmos-ftl-nfc-backend-policy-stage4-evidence/v1
+    echo stage4.claimed=true
+    echo compiler.sha256=$(hash_file "$SIMPLE")
+    echo provenance.sha256=$(hash_file "$PROVENANCE")
+    echo policy.sha256=$(hash_file "$POLICY")
+    echo pin.sha256=$(hash_file "$PIN")
+    echo host_object.sha256=$(hash_file "$OUT/policy-host.o")
+    echo arm_object.sha256=$(hash_file "$OUT/policy-arm.o")
+    echo parity_rows=125
+    echo compiler_decisions=71
+    echo compiler_branch_outcomes=142
+    echo host_abi=pass
+    echo arm_abi=pass
+} > "$OUT/receipt.env"
+echo "PASS cosmos-ftl-nfc-backend-policy-stage4 receipt=$OUT/receipt.env sha256=$(hash_file "$OUT/receipt.env")"
