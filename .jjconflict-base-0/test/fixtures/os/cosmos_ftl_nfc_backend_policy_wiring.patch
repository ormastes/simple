+}
+[ "$(cosmos_sha256_file "$SIMPLE")" = "$SIMPLE_SHA256_ADMITTED" ] &&
+    [ "$(cosmos_sha256_file "$SIMPLE_PROVENANCE")" = \
+        "$SIMPLE_PROVENANCE_SHA256_ADMITTED" ] || {
+    echo "pure-Simple compiler or provenance changed during FTL NFC backend policy emission" >&2
+    exit 1
+}
+FTL_NFC_BACKEND_POLICY_HEADER="$(
+    "$READELF" -hW "$OBJ/cosmos_ftl_nfc_backend_policy_simple.o"
+)"
+printf '%s\n' "$FTL_NFC_BACKEND_POLICY_HEADER" | grep -Eq \
+    'Class:[[:space:]]+ELF32' &&
+    printf '%s\n' "$FTL_NFC_BACKEND_POLICY_HEADER" | grep -Eq \
+        'Type:[[:space:]]+REL' &&
+    printf '%s\n' "$FTL_NFC_BACKEND_POLICY_HEADER" | grep -Eq \
+        'Machine:[[:space:]]+ARM' || {
+    echo "invalid pure-Simple FTL NFC backend policy object: expected ELF32 ARM REL" >&2
+    exit 1
+}
+FTL_NFC_BACKEND_POLICY_ATTRIBUTES="$(
+    "$READELF" -AW "$OBJ/cosmos_ftl_nfc_backend_policy_simple.o"
+)"
+printf '%s\n' "$FTL_NFC_BACKEND_POLICY_ATTRIBUTES" |
+    grep -Fq 'Tag_CPU_arch: v7' &&
+    printf '%s\n' "$FTL_NFC_BACKEND_POLICY_ATTRIBUTES" |
+        grep -Fq 'Tag_CPU_name: "cortex-a9"' &&
+    printf '%s\n' "$FTL_NFC_BACKEND_POLICY_ATTRIBUTES" |
+        grep -Fq 'Tag_CPU_arch_profile: Application' || {
+    echo "invalid pure-Simple FTL NFC backend policy object: Cortex-A9 profile missing" >&2
+    exit 1
+}
+if printf '%s\n' "$FTL_NFC_BACKEND_POLICY_ATTRIBUTES" |
+        grep -Eq 'Tag_FP_arch:|Tag_ABI_VFP_args:.*VFP registers'; then
+    echo "invalid pure-Simple FTL NFC backend policy object: not Cortex-A9 soft-float compatible" >&2
+    exit 1
+fi
+FTL_NFC_BACKEND_POLICY_SYMBOLS="$(
+    "$READELF" -sW "$OBJ/cosmos_ftl_nfc_backend_policy_simple.o"
+)"
+for symbol in \
+    cosmos_ftl_nfc_backend_policy_checkpoint_total_bytes \
+    cosmos_ftl_nfc_backend_policy_header_prefix_status \
+    cosmos_ftl_nfc_backend_policy_payload_length_status \
+    cosmos_ftl_nfc_backend_policy_read_io_state \
+    cosmos_ftl_nfc_backend_policy_read_content_state \
+    cosmos_ftl_nfc_backend_policy_write_faults \
+    cosmos_ftl_nfc_backend_policy_superblock_status \
+    cosmos_ftl_nfc_backend_policy_mounted_status \
+    cosmos_ftl_nfc_backend_policy_checkpoint_candidate_better \
+    cosmos_ftl_nfc_backend_policy_page_blank_status \
+    cosmos_ftl_nfc_backend_policy_recycle_status \
+    cosmos_ftl_nfc_backend_policy_next_journal_index \
+    cosmos_ftl_nfc_backend_policy_first_journal_index \
+    cosmos_ftl_nfc_backend_policy_journal_pages_normalized \
+    cosmos_ftl_nfc_backend_policy_journal_pages_valid \
+    cosmos_ftl_nfc_backend_policy_checkpoint_data_pages \
+    cosmos_ftl_nfc_backend_policy_checkpoint_slot_pages \
+    cosmos_ftl_nfc_backend_policy_journal_start_page \
+    cosmos_ftl_nfc_backend_policy_layout_valid \
+    cosmos_ftl_nfc_backend_policy_journal_page \
+    cosmos_ftl_nfc_backend_policy_journal_append_admit \
+    cosmos_ftl_nfc_backend_policy_journal_append_result \
+    cosmos_ftl_nfc_backend_policy_journal_read_admit \
+    cosmos_ftl_nfc_backend_policy_journal_next_after_read \
+    cosmos_ftl_nfc_backend_policy_journal_record_valid \
+    cosmos_ftl_nfc_backend_policy_journal_block_fully_dead \
+    cosmos_ftl_nfc_backend_policy_journal_trim_status
+do
+    printf '%s\n' "$FTL_NFC_BACKEND_POLICY_SYMBOLS" |
+        awk -v symbol="$symbol" \
+            '$4 == "FUNC" && $5 == "GLOBAL" && $6 == "DEFAULT" &&
+             $7 != "UND" && $8 == symbol { count++ }
+             END { exit count != 1 }' || {
+        echo "invalid pure-Simple FTL NFC backend policy export: $symbol" >&2
+        exit 1
+    }
+done
+FTL_NFC_BACKEND_POLICY_EXPORT_COUNT="$(
+    printf '%s\n' "$FTL_NFC_BACKEND_POLICY_SYMBOLS" |
+        awk '$4 == "FUNC" && $5 == "GLOBAL" && $7 != "UND" &&
+             $8 ~ /^cosmos_ftl_nfc_backend_policy_/ { count++ }
+             END { print count + 0 }'
+)"
+[ "$FTL_NFC_BACKEND_POLICY_EXPORT_COUNT" = 27 ] || {
+    echo "invalid pure-Simple FTL NFC backend policy object: expected 27 exports" >&2
+    exit 1
+}
+printf '%s\n' "$FTL_NFC_BACKEND_POLICY_SYMBOLS" |
+    awk '$7 == "UND" && $8 != "" { bad = 1 }
+         tolower($8) ~ /(malloc|calloc|realloc|alloc_object|gc_alloc)/ { bad = 1 }
+         $7 != "UND" && ($8 == "main" || $8 == "_start" ||
+                         $8 == "__simple_main" || $8 ~ /^rt_/) { bad = 1 }
+         END { exit bad }' || {
+    echo "invalid pure-Simple FTL NFC backend policy object: runtime/allocation/undefined dependency" >&2
+    exit 1
+}
+OBJECTS="$OBJECTS $OBJ/cosmos_ftl_nfc_backend_policy_simple.o"
 SIMPLE_LIB="$ROOT/src" "$SIMPLE" native-build \
     --backend llvm \
     --source "$SCRIPT_DIR" \
