diff --git a/src/os/kernel/arch/arm32/cosmos/build.shs b/src/os/kernel/arch/arm32/cosmos/build.shs
--- a/src/os/kernel/arch/arm32/cosmos/build.shs
+++ b/src/os/kernel/arch/arm32/cosmos/build.shs
@@ -158,6 +158,7 @@ cosmos_write_source_manifest "$SCRIPT_DIR" "$SOURCES_BEFORE" || {
 }
 
 CFLAGS="--target=armv7-none-eabi -mcpu=cortex-a9 -marm -ffreestanding -nostdlib -fno-builtin -Wall -Wextra -Werror"
+CFLAGS="$CFLAGS -DCOSMOS_FTL_NFC_BACKEND_PURE_POLICY=1"
 if [ "$MODE" = silicon ]; then
     CFLAGS="$CFLAGS -DCOSMOS_SILICON -include $PROFILE_HEADER"
 fi
@@ -649,6 +650,117 @@ printf '%s\n' "$ECC_OBJECT_SYMBOLS" |
     exit 1
 }
 OBJECTS="$OBJECTS $OBJ/cosmos_nfc_ecc_simple.o"
+SIMPLE_LIB="$ROOT/src" "$SIMPLE" native-build \
+    --backend llvm \
+    --source "$SCRIPT_DIR" \
+    --entry-closure \
+    --entry "$SCRIPT_DIR/cosmos_ftl_nfc_backend_policy.spl" \
+    --target armv7-unknown-none-eabi \
+    --emit-object \
+    --no-mangle \
+    --cache-dir "$OBJ/simple-ftl-nfc-backend-policy-cache" \
+    -o "$OBJ/cosmos_ftl_nfc_backend_policy_simple.o"
+stage4_verify_candidate_provenance \
+    "$SIMPLE_PROVENANCE" "$SIMPLE" "$ROOT" || {
+    echo "pure-Simple compiler provenance changed during FTL NFC backend policy emission" >&2
