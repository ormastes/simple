extension:
  schema: simple.ide.extension/1
  id: fixture.hello
  display_name: Hello Fixture
  version: 1.0.0
  engine: ">=0.1.0"
  entry: hello_ext.spl
  host: in_process
permissions:
  workspace_read: false
  workspace_write: false
  process_spawn: false
  network_client: false
  secrets: false
  native_ffi: false
activation:
  events: ["onCommand:hello.greet"]
contributes:
  commands: [{id: "hello.greet", title: "Hello: Greet", category: "Fixture"}]
  languages: []
  keybindings: [{command: "hello.greet", key: "ctrl+shift+h", when: "editorFocus"}]
  themes: [{id: "hello-light", label: "Hello Light", ui_theme: "light", path: "themes/light.sdn"}]
