# Fixture extension entry module for the IDE extension-kernel walking
# skeleton (test/03_system/ide/extension_kernel_walking_skeleton_spec.spl).
#
# External-process entrypoint execution (loading and running this module
# from `extension.entry` inside a sandboxed extension host) is future L6
# work -- see src/lib/editor/extensions/host.spl's `_dispatch_runtime_invocation`.
# Today the walking skeleton simulates the extension's own activation code by
# registering this handler programmatically with ExtensionHost after the
# manifest loads.

fn hello_greet(payload: text) -> Result<text, text>:
    Ok("hello:" + payload)
