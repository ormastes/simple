# Divergence class (e): `case Some(x)` over an optional whose payload is
# ITSELF an enum, and a method call THROUGH that binding.
#
# Two JIT defects lived here, both fixed in seed source on 2026-08-24/25 and
# both invisible to `simple test` (different evaluator), so this corpus is the
# only place they can be pinned:
#
#   1. The Some-binding discriminated boxed-vs-raw optionals with
#      `rt_enum_id(subj) >= 0`, which is true for ANY enum -- so a raw `Node?`
#      holding `Node.Map(d)` took the boxed branch and was unwrapped one level
#      too far, binding `d` instead of the Node. Fixed: `== OPTION_ENUM_ID`.
#      (jit_option_of_enum_payload_double_unwrap_2026-08-24.md)
#   2. Enum-BODY methods were never registered in method_return_types, so
#      `n.get(k)` on a known Node answered ANY, the binding degraded to ANY, and
#      `.get` through it was routed to the collection builtin rt_index_get --
#      nil on a user enum. Fixed: Node::Enum arm in the pre-register loop.
#      (same record, "Second defect")
#
# Under either defect the JIT prints MISSING where the interpreter prints
# FOUND. Agreement is the property; no expected value is needed.

enum Node:
    Leaf(i64)
    Map(Dict<text, Node>)

    fn get(self, key: text) -> Node?:
        match self:
            case Map(d):
                if d.contains_key(key):
                    Some(d[key])
                else:
                    None
            case Leaf(_): None

fn kind_of(n: Node) -> text:
    match n:
        case Map(_): "Map"
        case Leaf(v): "Leaf" + v.to_text()

# raw-migration-form producer: a plain fn returning T? where T is an enum
fn raw_opt(n: Node, key: text) -> Node?:
    match n:
        case Map(d):
            if d.contains_key(key): d[key] else: nil
        case Leaf(_): nil

fn main() -> i64:
    var inner: Dict<text, Node> = {}
    inner["abi"] = Node.Leaf(2)
    var outer: Dict<text, Node> = {}
    outer["item"] = Node.Map(inner)
    val root = Node.Map(outer)

    # defect 1: raw optional with enum payload, read the binding's kind
    match raw_opt(root, "item"):
        case Some(iv): print("raw_kind=" + kind_of(iv))
        case None: print("raw_kind=MISSING")

    # defect 2: method call THROUGH the Some binding
    match root.get("item"):
        case Some(iv):
            match iv.get("abi"):
                case Some(leaf): print("through_binding=" + kind_of(leaf))
                case None: print("through_binding=MISSING")
        case None: print("through_binding=NO_ITEM")

    # control: hoisted read, which always worked
    var h = root
    match root.get("item"):
        case Some(iv): h = iv
        case None: h = root
    match h.get("abi"):
        case Some(leaf): print("hoisted=" + kind_of(leaf))
        case None: print("hoisted=MISSING")
    0
