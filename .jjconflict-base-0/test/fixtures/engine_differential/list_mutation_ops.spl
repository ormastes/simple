# Divergence class (c)/(d): in-place list operations and rebinding.
#
# `reverse` MUTATES in place while `rev`/`reversed` return a new list, and
# `sort` writes back -- so these are exactly the operations where a lane that
# gets copy-vs-alias wrong diverges. Native codegen has separately been
# documented to mislower list rebinding and spills.
#
# Every line below is a value that must be identical on all engines.

fn main() -> i64:
    var xs = [3, 1, 2]
    xs.push(4)
    print("after_push={xs[3]} len={xs.len()}")

    var ys = [5, 6, 7]
    ys[1] = 60
    print("after_index_write={ys[1]}")

    var zs = [9, 8, 7]
    var copy = zs
    copy.push(6)
    print("orig_len_after_copy_push={zs.len()}")
    print("copy_len={copy.len()}")

    var acc = 0
    var i = 0
    while i < xs.len():
        acc = acc + xs[i]
        i = i + 1
    print("while_sum={acc}")
    0
