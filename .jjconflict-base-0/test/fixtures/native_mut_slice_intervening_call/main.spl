use native_mut_slice_intervening_call.provider.{
    after_aggregate, after_scalar, leaf
}

fn main() -> i64:
    var leaf_meta: [i64] = [0, 0]
    var leaf_pixels: [u8] = [0u8, 0u8]
    leaf(leaf_meta, leaf_pixels)
    if (leaf_meta[0] != 11 or leaf_meta[1] != 12 or
        leaf_pixels[0] != 13u8 or leaf_pixels[1] != 14u8):
        return 31

    var scalar_meta: [i64] = [0, 0]
    var scalar_pixels: [u8] = [0u8, 0u8]
    after_scalar(scalar_meta, scalar_pixels)
    if (scalar_meta[0] != 21 or scalar_meta[1] != 85 or
        scalar_pixels[0] != 22u8 or scalar_pixels[1] != 85u8):
        return 32

    var aggregate_meta: [i64] = [0, 0]
    var aggregate_pixels: [u8] = [0u8, 0u8]
    val aggregate_status = after_aggregate(aggregate_meta, aggregate_pixels)
    if aggregate_status == 34:
        return 34
    if (aggregate_status != 0 or aggregate_meta[0] != 31 or
        aggregate_meta[1] != 606 or aggregate_pixels[0] != 32u8 or
        aggregate_pixels[1] != 68u8):
        return 33

    print("native_mut_slice_intervening_call_status=pass")
    0
