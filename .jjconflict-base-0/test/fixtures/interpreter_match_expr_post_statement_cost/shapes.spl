fn noop(x: i64) -> i64:
    return x + 1

# Shape under test: `val kind = match ...:` with returning arms, followed by
# ordinary statements in the same frame.
pub fn work_match(k: i64) -> i64:
    val kind = match k:
        case 1: return -1
        case 2: return -2
        case _: k
    var acc = 0
    for i in 0..3:
        acc = acc + noop(i)
    for i in 0..3:
        acc = acc + noop(i)
    for i in 0..3:
        acc = acc + noop(i)
    return acc + kind

# Same logic with the early exits hoisted (the MATCHRET workaround).
pub fn work_hoisted(k: i64) -> i64:
    if k == 1: return -1
    if k == 2: return -2
    val kind = k
    var acc = 0
    for i in 0..3:
        acc = acc + noop(i)
    for i in 0..3:
        acc = acc + noop(i)
    for i in 0..3:
        acc = acc + noop(i)
    return acc + kind
