enum ResolutionProbe:
    Unresolved
    FreeFunction(symbol: i64)
    InstanceMethod(type_id: i64, method_id: i64)
    StaticMethod(type_id: i64, method_id: i64)
    TraitMethod(trait_id: i64, method_id: i64)

val INFERRED_INT = 41
val INFERRED_FLOAT = 2.5
val INFERRED_BOOL = true
val INFERRED_TEXT = "folded"
val INFERRED_BINARY = 6 * 7

struct ProbeError:
    message: text

impl ProbeError:
    static fn type_error(message: text) -> ProbeError:
        ProbeError(message: message)

fn classify(resolution: ResolutionProbe) -> text:
    match resolution:
        case Unresolved: "unresolved"
        case FreeFunction(symbol): "free:" + symbol.to_text()
        case InstanceMethod(type_id, method_id):
            "instance:" + type_id.to_text() + ":" + method_id.to_text()
        case StaticMethod(type_id, method_id):
            "static:" + type_id.to_text() + ":" + method_id.to_text()
        case TraitMethod(trait_id, method_id):
            "trait:" + trait_id.to_text() + ":" + method_id.to_text()

fn main:
    val labels = [
        classify(ResolutionProbe.Unresolved),
        classify(ResolutionProbe.FreeFunction(7)),
        classify(ResolutionProbe.InstanceMethod(11, 13)),
        classify(ResolutionProbe.StaticMethod(17, 19)),
        classify(ResolutionProbe.TraitMethod(23, 29))
    ]
    val error = ProbeError.type_error("typed")
    var pending: [i64] = []
    pending = pending.push(31)
    val actual = labels.join("|") + "|factory:" + error.message +
        "|push:" + pending[0].to_text() +
        "|const:" + INFERRED_INT.to_text() + ":" + INFERRED_FLOAT.to_text() +
        ":" + INFERRED_BOOL.to_text() + ":" + INFERRED_TEXT +
        ":" + INFERRED_BINARY.to_text()
    val expected = "unresolved|free:7|instance:11:13|static:17:19|" +
        "trait:23:29|factory:typed|push:31|const:41:2.5:true:folded:42"
    if actual == expected:
        print("PROBE VERDICT: PASS " + actual)
    else:
        print("PROBE VERDICT: FAIL expected=" + expected + " actual=" + actual)
