struct W3:
    ok: bool
    length: i64
    tag: i64

struct Pair:
    a: i64
    b: i64

struct Nest:
    head: i64
    inner: Pair

fn make_w3(n: i64) -> W3:
    W3(ok: n > 0, length: n, tag: 77)

fn leaf() -> Pair:
    Pair(a: 11, b: 13)

fn forward() -> Pair:
    leaf()

fn nested() -> Nest:
    Nest(head: 17, inner: Pair(a: 19, b: 23))

fn pair_tuple() -> (i64, i64):
    (29, 31)

fn main():
    val w = make_w3(3)
    print(w.length)
    print(w.tag)
    val l = leaf()
    print(l.a)
    print(l.b)
    val f = forward()
    print(f.a)
    print(f.b)
    val n = nested()
    print(n.head)
    print(n.inner.a)
    print(n.inner.b)
    val t = pair_tuple()
    print(t.0)
    print(t.1)
