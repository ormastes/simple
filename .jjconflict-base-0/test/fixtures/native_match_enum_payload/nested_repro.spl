enum Pair:
    Two((i64, i64))
    None_

fn describe(p: Pair) -> text:
    match p:
        case Pair.Two((a, b)):
            return "two:" + a.to_text() + "," + b.to_text()
        case Pair.None_:
            return "none"

fn main() -> i32:
    val x = Pair.Two((3, 40))
    val y = Pair.None_
    val dx = describe(x)
    val dy = describe(y)
    print(dx)
    print(dy)
    if dx == "two:3,40" and dy == "none":
        print("PASS")
        return 0
    else:
        print("FAIL")
        return 1
