enum Result:
    Ok(i64)
    Err(text)

fn classify(r: Result) -> i64:
    match r:
        case Result.Ok(v):
            print("ok:" + v.to_text())
            return v
        case Result.Err(msg):
            print("err:" + msg)
            return -1

fn main() -> i32:
    let a = Result.Ok(42)
    let b = Result.Err("boom")
    let ra = classify(a)
    let rb = classify(b)
    if ra == 42 and rb == -1:
        print("PASS")
        return 0
    else:
        print("FAIL")
        return 1
