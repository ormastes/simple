# Fixture for bug pure_simple_option_i64_ifval_always_some_eqnil_always_false_2026-08-08
# Sweeps if val / == nil / != nil / ?? / .is_none() / .is_some() across
# i64?, bool?, text? for several Some(...) values and real nil.
# NOTE: avoids .to_text() on primitives (unrelated pre-existing native-build
# limitation: "unresolved method call: to_text") -- uses explicit
# int-to-text / bool-to-text conversion instead so the fixture isolates
# ONLY the rt_is_none/rt_is_some fix under test.

fn i2t(n: i64) -> text:
    if n == 0:
        "0"
    elif n == 1:
        "1"
    elif n == 2:
        "2"
    elif n == 3:
        "3"
    elif n == 4:
        "4"
    elif n == -1:
        "-1"
    else:
        "-999"

fn b2t(b: bool) -> text:
    if b:
        "true"
    else:
        "false"

fn check_i64(label: text, opt: i64?):
    var ifval_hit = "no-match"
    if val v = opt:
        ifval_hit = "Some(" + i2t(v) + ")"
    val eq_nil = b2t(opt == nil)
    val neq_nil = b2t(opt != nil)
    val coalesce = i2t(opt ?? -999)
    val is_none = b2t(opt.is_none())
    val is_some = b2t(opt.is_some())
    print(label + ": ifval=" + ifval_hit + " eqnil=" + eq_nil + " neqnil=" + neq_nil + " coalesce=" + coalesce + " is_none=" + is_none + " is_some=" + is_some)

fn check_bool(label: text, opt: bool?):
    var ifval_hit = "no-match"
    if val v = opt:
        ifval_hit = "Some(" + b2t(v) + ")"
    val eq_nil = b2t(opt == nil)
    val neq_nil = b2t(opt != nil)
    val coalesce = b2t(opt ?? false)
    val is_none = b2t(opt.is_none())
    val is_some = b2t(opt.is_some())
    print(label + ": ifval=" + ifval_hit + " eqnil=" + eq_nil + " neqnil=" + neq_nil + " coalesce=" + coalesce + " is_none=" + is_none + " is_some=" + is_some)

fn check_text(label: text, opt: text?):
    var ifval_hit = "no-match"
    if val v = opt:
        ifval_hit = "Some(" + v + ")"
    val eq_nil = b2t(opt == nil)
    val neq_nil = b2t(opt != nil)
    val coalesce = opt ?? "DEFAULT"
    val is_none = b2t(opt.is_none())
    val is_some = b2t(opt.is_some())
    print(label + ": ifval=" + ifval_hit + " eqnil=" + eq_nil + " neqnil=" + neq_nil + " coalesce=" + coalesce + " is_none=" + is_none + " is_some=" + is_some)

fn main():
    print("--- i64? ---")
    check_i64("i64_Some0", Some(0))
    check_i64("i64_Some1", Some(1))
    check_i64("i64_Some2", Some(2))
    check_i64("i64_Some3", Some(3))
    check_i64("i64_Some4", Some(4))
    check_i64("i64_SomeNeg1", Some(-1))
    val i64_none: i64? = nil
    check_i64("i64_Nil", i64_none)

    print("--- bool? ---")
    check_bool("bool_SomeTrue", Some(true))
    check_bool("bool_SomeFalse", Some(false))
    val bool_none: bool? = nil
    check_bool("bool_Nil", bool_none)

    print("--- text? ---")
    check_text("text_SomeA", Some("a"))
    check_text("text_SomeEmpty", Some(""))
    val text_none: text? = nil
    check_text("text_Nil", text_none)
