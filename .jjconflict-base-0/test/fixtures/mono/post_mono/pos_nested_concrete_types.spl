# @expect: clean
# Deeply nested concrete types (dict of optional tuple of array) stay clean.
use compiler.hir.hir.*
use compiler.verify.post_mono_verify.*
use post_mono_fixture_support.*

fn main():
    val inner = fx_type(HirTypeKind.Tuple([fx_type(HirTypeKind.Array(fx_i64(), nil)), fx_type(HirTypeKind.Bool)]))
    val nested = fx_type(HirTypeKind.Dict(fx_type(HirTypeKind.Str), fx_type(HirTypeKind.Optional(inner))))
    val body = fx_block([], fx_typed_expr(HirExprKind.NilLit, nested))
    fx_emit(post_mono_verify(fx_module("pos_nested", [fx_fn(3, "shape", [], [fx_param(30, "v", nested)], nested, body)])))
