# ============================================================================
# test/fixtures/structural/identity_tagmap_golden_v1.spl
#
# GOLDEN VECTORS for the frozen identity + tagmap contract v1.
#
# Every hex string below was derived BY HAND from the frozen layout in
# doc/05_design/platform/structural_compute/identity_tagmap_contract_v1.md,
# not captured from encoder output. That is what makes them an oracle: the spec
# asserts encoder output EQUALS these bytes, so a codec regression cannot
# silently redefine the contract.
#
# GOLDEN-VECTOR CONVENTION (set here for the nine following contract lanes):
#   - Vectors live in test/fixtures/structural/<group>_golden_v<N>.spl as pure
#     data, so a spec imports them with no file I/O and they work identically in
#     every execution mode.
#   - The same vectors are mirrored, byte for byte, in a sibling .sdn file for
#     language-neutral consumers (Rust/C++ bridges, external validators).
#   - Encoding is lowercase unseparated hex.
#   - One vector per record shape, plus zero and all-ones edge cases.
#   - A vector is never edited in place. A contract change adds
#     <group>_golden_v<N+1>.spl and keeps the old file so cross-version
#     compatibility stays testable.
#
# Shared constants used across vectors:
#   ART = ArtifactId(content_hash = Hash128(hi 0x1122334455667788,
#                                           lo 0x99aabbccddeeff00),
#                    schema_version = 7)
#       encodes as  8877665544332211 00ffeeddccbbaa99 07000000
# ============================================================================

# ----------------------------------------------------------------------------
# Identity records. Envelope = magic(4) | version u16 | reserved u16.
# ----------------------------------------------------------------------------

# EntityRef(0, 0) — zero case. "SREF" = 53 52 45 46.
val GOLDEN_ENTITY_REF_ZERO: text = "53524546010000000000000000000000"

# EntityRef(0xFFFFFFFF, 0xFFFFFFFF) — all-ones case.
val GOLDEN_ENTITY_REF_MAX: text = "5352454601000000ffffffffffffffff"

# EntityRef(0x01020304, 0x05060708) — asymmetric, catches byte-order errors.
val GOLDEN_ENTITY_REF_ASYM: text = "53524546010000000403020108070605"

# EntityKey(ART, schema = 3, local_identity = 42). "SKEY" = 53 4b 45 59.
val GOLDEN_ENTITY_KEY_BASIC: text =
    "534b4559010000008877665544332211"
        + "00ffeeddccbbaa9907000000"
        + "030000002a00000000000000"

# SnapshotId(ART, epoch = 9). "SSNP" = 53 53 4e 50.
val GOLDEN_SNAPSHOT_ID_BASIC: text =
    "53534e50010000008877665544332211"
        + "00ffeeddccbbaa9907000000"
        + "0900000000000000"

# SemanticEntityKey(language = 1, qualified_name = 2,
#                   signature_hash = Hash128(0xaaaa, 0xbbbb),
#                   definition_artifact = ART). "SSEM" = 53 53 45 4d.
val GOLDEN_SEMANTIC_KEY_BASIC: text =
    "5353454d01000000"
        + "0100000002000000"
        + "aaaa000000000000bbbb000000000000"
        + "887766554433221100ffeeddccbbaa9907000000"

# SourceAnchor(file = ART, byte_start = 100, byte_end = 200,
#              spelling_context = 5, expansion_context = 6).
# "SANC" = 53 41 4e 43.
val GOLDEN_SOURCE_ANCHOR_BASIC: text =
    "53414e4301000000"
        + "887766554433221100ffeeddccbbaa9907000000"
        + "64000000c80000000500000006000000"

# ----------------------------------------------------------------------------
# TagSchema. "STSC" = 53 54 53 43.
#
# TagSchema(version = 5, keys = [
#   TagKey(namespace = 11, name = 22, Marker, One, Snapshot, Replace, Parser),
#   TagKey(namespace = 33, name = 44, SourceAnchor, Many, Artifact, Union,
#          External)])
#
# Enum discriminants: Marker=0 One=0 Snapshot=0 Replace=0 Parser=0
#                     SourceAnchor=8 Many=2 Artifact=2 Union=1 External=4
# ----------------------------------------------------------------------------

val GOLDEN_TAG_SCHEMA_TWO_KEYS: text =
    "5354534301000000"
        + "0500000002000000"
        + "0b000000160000000000000000"
        + "210000002c0000000802020104"

# TagSchema(version = 0, keys = []) — empty schema is legal and must round-trip.
val GOLDEN_TAG_SCHEMA_EMPTY: text = "53545343010000000000000000000000"

# ----------------------------------------------------------------------------
# TagValue, framed. "STVL" = 53 54 56 4c. Layout: envelope | type u8 | payload.
# ----------------------------------------------------------------------------

val GOLDEN_TV_ENVELOPE: text = "5354564c01000000"

val GOLDEN_TV_MARKER: text = "5354564c0100000000"
val GOLDEN_TV_BOOL_TRUE: text = "5354564c010000000101"
val GOLDEN_TV_BOOL_FALSE: text = "5354564c010000000100"
val GOLDEN_TV_I64: text = "5354564c01000000028877665544332211"
val GOLDEN_TV_U64_MAX: text = "5354564c0100000003ffffffffffffffff"

# F64 payload is the raw IEEE-754 bit pattern of 1.0 = 0x3ff0000000000000.
val GOLDEN_TV_F64_ONE: text = "5354564c0100000004000000000000f03f"

val GOLDEN_TV_STRING_ID: text = "5354564c010000000501efcdab"
val GOLDEN_TV_ENTITY_REF: text = "5354564c01000000060900000008000000"
val GOLDEN_TV_ARTIFACT_ID: text =
    "5354564c0100000007"
        + "887766554433221100ffeeddccbbaa9907000000"
val GOLDEN_TV_SOURCE_ANCHOR: text =
    "5354564c0100000008"
        + "887766554433221100ffeeddccbbaa9907000000"
        + "64000000c80000000500000006000000"

# SmallSet packing offset = 77 (0x4d), count = 3 -> word 0x0000000300000077.
val GOLDEN_TV_SMALL_SET: text = "5354564c01000000094d00000003000000"
