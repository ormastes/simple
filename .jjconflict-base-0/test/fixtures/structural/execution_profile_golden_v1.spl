# ============================================================================
# test/fixtures/structural/execution_profile_golden_v1.spl
#
# GOLDEN VECTORS for the frozen StageExecutionProfile / StageCapabilities
# contract v1 (architecture §21, §21.1, §26 artifact group 9).
#
# Every hex string below was derived BY HAND from the frozen layout in
# doc/05_design/platform/structural_compute/execution_profile_contract_v1.md,
# not captured from encoder output. That is the whole point: the spec asserts
# encoder output EQUALS these bytes, so a codec regression cannot silently
# redefine the contract. Four earlier waves each injected a SYMMETRIC
# encoder+decoder defect that round-tripped 100% green and was caught only
# here.
#
# Convention inherited from waves 0a/0b and the receipt wave: pure data, no
# file I/O, lowercase unseparated hex, one vector per record shape plus edge
# cases, mirrored byte for byte in the sibling .sdn, never edited in place.
#
# Envelope = magic(4 ASCII, LE) | version u16 | reserved u16.
#   "SXEP" = 53 58 45 50   StageExecutionProfile -> 5358455001000000
#   "SXSC" = 53 58 53 43   StageCapabilities     -> 5358534301000000
#
# Discriminants used below, all imported and frozen elsewhere:
#   ExecutionMode        CpuReference 0 | HybridVectorGpu 1 | ResidentGpu 2
#   VerificationPolicy   Off 0 | DeterministicHash 1 | Sampled 2
#                        | Full 3 | OracleCompare 4
#   StageFallbackPolicy  Forbid 0 | AllowHybrid 1 | AllowCpu 2
#
# Device-mask bits: cpu_scalar 1 | cpu_simd 2 | gpu 4 | storage 8
# Mode-mask bits:   cpu_reference 1 | hybrid_vector_gpu 2 | resident_gpu 4
# Storage bits:     staged 1 | direct 2 | device_initiated 4
# ============================================================================

# ----------------------------------------------------------------------------
# StageExecutionProfile — body 48 bytes, no padding:
#   contract_version u32 @0 | mode u8 @4 | deterministic u8 @5
#   | fallback u8 @6 | verification u8 @7
#   | host_memory_budget u64 @8  | device_memory_budget u64 @16
#   | latency_target_us u64 @24  | throughput_target u64 @32
#   | allowed_devices u64 @40
# Total on the wire = 8 envelope + 48 body = 56 bytes.
# ----------------------------------------------------------------------------

# The mode every domain must be able to run (§21.5's CPU column), as produced
# by stage_execution_profile_cpu_reference(): deterministic, no degradation
# permitted because there is nothing below cpu_reference, scalar CPU only.
#   version 1 | mode 0 | det 1 | fallback Forbid 0 | verify DeterministicHash 1
#   | budgets 0,0,0,0 | allowed_devices cpu_scalar = 0x01
val GOLDEN_PROFILE_CPU_REFERENCE: text =
    "5358455001000000"
        + "01000000"
        + "00" + "01" + "00" + "01"
        + "0000000000000000"
        + "0000000000000000"
        + "0000000000000000"
        + "0000000000000000"
        + "0100000000000000"

# Resident GPU with the full degradation ladder permitted, and every numeric
# slot non-zero so a field-order swap cannot hide behind zeros.
#   mode ResidentGpu 2 | det false 0 | fallback AllowCpu 2
#   | verify OracleCompare 4
#   host   1 GiB = 0x40000000        -> 00 00 00 40 00 00 00 00
#   device 2 GiB = 0x80000000        -> 00 00 00 80 00 00 00 00
#   latency     5000 = 0x1388        -> 88 13 00 00 00 00 00 00
#   throughput  1000000 = 0x000f4240 -> 40 42 0f 00 00 00 00 00
#   allowed_devices cpu_scalar|cpu_simd|gpu|storage = 0x0f
val GOLDEN_PROFILE_RESIDENT_ALLOW_CPU: text =
    "5358455001000000"
        + "01000000"
        + "02" + "00" + "02" + "04"
        + "0000004000000000"
        + "0000008000000000"
        + "8813000000000000"
        + "40420f0000000000"
        + "0f00000000000000"

# The middle rung of §20.7's ladder: resident may degrade to hybrid and no
# further. This vector exists because AllowHybrid is the one policy value the
# architecture only implies, so its encoding is pinned explicitly.
#   mode ResidentGpu 2 | det true 1 | fallback AllowHybrid 1 | verify Off 0
#   | allowed_devices cpu_scalar|gpu = 0x05
val GOLDEN_PROFILE_RESIDENT_ALLOW_HYBRID: text =
    "5358455001000000"
        + "01000000"
        + "02" + "01" + "01" + "00"
        + "0000000000000000"
        + "0000000000000000"
        + "0000000000000000"
        + "0000000000000000"
        + "0500000000000000"

# ----------------------------------------------------------------------------
# StageCapabilities — head 16 bytes then the backend text:
#   contract_version u32 @0 | supported_modes u8 @4 | storage_tiers u8 @5
#   | max_verification u8 @6 | deterministic u8 @7 | device_mask u64 @8
#   | backend text @16 (u32 length, then that many ASCII bytes)
# ----------------------------------------------------------------------------

# A fully capable GPU backend: all three modes, staged+direct storage, can act
# as an oracle, deterministic, drives every device channel.
#   supported_modes 0x07 | storage staged|direct 0x03
#   | max_verification OracleCompare 4 | deterministic 1
#   | device_mask 0x0f | backend "gpu" = 67 70 75, length 3
val GOLDEN_CAPABILITIES_GPU: text =
    "5358534301000000"
        + "01000000"
        + "07" + "03" + "04" + "01"
        + "0f00000000000000"
        + "03000000" + "677075"

# The mandatory CPU reference backend: one mode, no storage tier claimed,
# hash-level verification, scalar CPU only.
#   supported_modes 0x01 | storage 0x00
#   | max_verification DeterministicHash 1 | deterministic 1
#   | device_mask 0x01 | backend "cpu" = 63 70 75, length 3
val GOLDEN_CAPABILITIES_CPU: text =
    "5358534301000000"
        + "01000000"
        + "01" + "00" + "01" + "01"
        + "0100000000000000"
        + "03000000" + "637075"

export GOLDEN_PROFILE_CPU_REFERENCE
export GOLDEN_PROFILE_RESIDENT_ALLOW_CPU
export GOLDEN_PROFILE_RESIDENT_ALLOW_HYBRID
export GOLDEN_CAPABILITIES_GPU
export GOLDEN_CAPABILITIES_CPU
