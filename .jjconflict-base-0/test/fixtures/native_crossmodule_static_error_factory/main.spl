use provider.{FactoryError}

fn main():
    val runtime = FactoryError.runtime_error("runtime")
    val typed = FactoryError.type_error("typed")
    val actual = runtime.message + ":" + runtime.code.to_text() + "|" +
        typed.message + ":" + typed.code.to_text()
    if actual == "runtime:17|typed:23":
        print("STATIC FACTORY VERDICT: PASS " + actual)
    else:
        print("STATIC FACTORY VERDICT: FAIL " + actual)
