"""# Test-runner environment ABI

Exercise the environment facade used by test-runner configuration. The write
must preserve both text values; an obsolete two-argument native provider
crashes or corrupts the value instead.
"""

use std.io_runtime.{env_get, env_set}
use std.spec.{describe, it, expect, step}

val ABI_KEY = "SIMPLE_TEST_RUNNER_ENV_ABI_PROBE"

describe "Pure-Simple test-runner environment ABI":
    it "should round-trip the configured test environment value":
        step("Preserve the prior test-runner environment value")
        val previous = env_get(ABI_KEY)
        step("Write a non-pointer-shaped text value through the environment facade")
        expect(env_set(ABI_KEY, "stage4-tools-only")).to_equal(true)
        step("Read the exact value through the same production facade")
        expect(env_get(ABI_KEY)).to_equal("stage4-tools-only")
        step("Restore the prior value")
        expect(env_set(ABI_KEY, previous)).to_equal(true)

