"""Release mutation trusts observed Git/worktree state, not caller session claims."""
# @req: REQ-004, REQ-005
use std.spec.{describe, it, expect, step}
use std.nogc_sync_mut.io.file_ops.{file_hash_sha256, file_exists}
use app.io.mod.{process_run_bounded, dir_create_all, file_atomic_write, time_now_unix_micros, getpid}
use app.release.policy.{ReleaseSession}
use app.release.session_authority.{
    verify_release_session, register_release_session,
    verify_registered_release_session, check_release_session_cleanup,
    close_release_session, begin_release_session_mutation,
    advance_release_session_head, end_release_session_mutation
}

fn run(command: text, arguments: [text]) -> text:
    val (stdout, _stderr, code) = process_run_bounded(command, arguments, 5000, 262144)
    if code != 0:
        return ""
    stdout.trim()

fn git(root: text, arguments: [text]) -> text:
    run("git", ["-C", root] + arguments)

fn main_worktree(root: text) -> text:
    val listing = git(root, ["worktree", "list", "--porcelain"])
    for line in listing.split("\n"):
        if line.starts_with("worktree "):
            return run("realpath", [line[9:].trim()])
    ""

fn actual_session(root: text) -> ReleaseSession:
    val canonical = run("realpath", [root])
    ReleaseSession(
        session_id: "session-authority-spec",
        workspace_path: canonical,
        main_workspace_path: main_worktree(canonical),
        work_branch: git(canonical, ["symbolic-ref", "--quiet", "--short", "HEAD"]),
        target_ref: "main",
        base_sha: git(canonical, ["rev-parse", "--verify", "HEAD"]),
        expected_target_sha: git(canonical, ["rev-parse", "--verify", "refs/remotes/origin/main"]),
        policy_sha256: file_hash_sha256(canonical + "/.spipe/policy/vcs.sdn")
    )

fn fixture_session() -> (text, ReleaseSession):
    val fixture = "/tmp/simple-release-session-authority-" + getpid().to_text() + "-" + time_now_unix_micros().to_text()
    val primary = fixture + "/primary"
    val workspace = fixture + "/release-work"
    val _ = dir_create_all(primary + "/.spipe/policy")
    val _policy_written = file_atomic_write(primary + "/.spipe/policy/vcs.sdn", "policy: fixture\n")
    val _tracked_written = file_atomic_write(primary + "/tracked.txt", "base\n")
    val _init = git(primary, ["init", "-b", "main"])
    val _email = git(primary, ["config", "user.email", "session-authority@example.invalid"])
    val _name = git(primary, ["config", "user.name", "Session Authority Spec"])
    val _add = git(primary, ["add", "."])
    val _commit = git(primary, ["commit", "-m", "fixture base"])
    val base = git(primary, ["rev-parse", "HEAD"])
    val _origin = git(primary, ["update-ref", "refs/remotes/origin/main", base])
    val branch = "work/release/local-20260826-901-session-head-cas"
    val _worktree = git(primary, ["worktree", "add", "-b", branch, workspace, base])
    val canonical = run("realpath", [workspace])
    val session = ReleaseSession(
        session_id: "session-head-cas-" + getpid().to_text(),
        workspace_path: canonical,
        main_workspace_path: run("realpath", [primary]),
        work_branch: branch, target_ref: "main", base_sha: base,
        expected_target_sha: base,
        policy_sha256: file_hash_sha256(canonical + "/.spipe/policy/vcs.sdn")
    )
    (canonical, session)

describe "Release session authority":
    it "admits the current isolated work branch using observed identities":
        step("Resolve canonical Git and worktree identities")
        val session = actual_session(".")
        val verified = verify_release_session(".", session)
        expect(verified.valid).to_be(true)
        expect(verified.canonical_root).to_equal(session.workspace_path)
        expect(verified.current_head).to_equal(session.base_sha)
        expect(verified.target_head).to_equal(session.expected_target_sha)

    it "rejects forged branch head target and policy claims":
        val session = actual_session(".")
        val forged_branch = ReleaseSession(
            session_id: session.session_id, workspace_path: session.workspace_path,
            main_workspace_path: session.main_workspace_path,
            work_branch: "work/release/forged", target_ref: session.target_ref,
            base_sha: session.base_sha, expected_target_sha: session.expected_target_sha,
            policy_sha256: session.policy_sha256
        )
        expect(verify_release_session(".", forged_branch).reason).to_contain("branch claim")

        val forged_head = ReleaseSession(
            session_id: session.session_id, workspace_path: session.workspace_path,
            main_workspace_path: session.main_workspace_path,
            work_branch: session.work_branch, target_ref: session.target_ref,
            base_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            expected_target_sha: session.expected_target_sha,
            policy_sha256: session.policy_sha256
        )
        expect(verify_release_session(".", forged_head).reason).to_contain("base identity")

        val forged_target = ReleaseSession(
            session_id: session.session_id, workspace_path: session.workspace_path,
            main_workspace_path: session.main_workspace_path,
            work_branch: session.work_branch, target_ref: session.target_ref,
            base_sha: session.base_sha,
            expected_target_sha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
            policy_sha256: session.policy_sha256
        )
        expect(verify_release_session(".", forged_target).reason).to_contain("target identity")

        val forged_policy = ReleaseSession(
            session_id: session.session_id, workspace_path: session.workspace_path,
            main_workspace_path: session.main_workspace_path,
            work_branch: session.work_branch, target_ref: session.target_ref,
            base_sha: session.base_sha, expected_target_sha: session.expected_target_sha,
            policy_sha256: "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
        )
        expect(verify_release_session(".", forged_policy).reason).to_contain("policy identity")

    it "rejects subdirectories and symlink aliases masquerading as the repository root":
        val session = actual_session(".")
        expect(verify_release_session("src", session).reason).to_contain("root of its Git repository")
        expect(verify_release_session("/proc/self/cwd", session).reason).to_contain("symlink alias")

    it "atomically registers one owner with private output and cache roots":
        step("Register the observed branch and worktree as one durable owner")
        val (root, session) = fixture_session()
        val registered = register_release_session(root, session)
        expect(registered.valid).to_be(true)
        expect(file_exists(registered.registry_path)).to_be(true)
        expect(registered.output_root).to_contain("/build/session/" + session.session_id + "/output")
        expect(registered.cache_root).to_contain("/build/session/" + session.session_id + "/cache-overlay")
        expect(verify_registered_release_session(root, session).valid).to_be(true)

        step("Repeat registration idempotently without creating a second owner")
        val repeated = register_release_session(root, session)
        expect(repeated.valid).to_be(true)
        expect(repeated.output_root).to_equal(registered.output_root)

    it "rejects another session claiming the registered branch and worktree":
        val (root, owner) = fixture_session()
        expect(register_release_session(root, owner).valid).to_be(true)
        val intruder = ReleaseSession(
            session_id: "session-authority-intruder",
            workspace_path: owner.workspace_path,
            main_workspace_path: owner.main_workspace_path,
            work_branch: owner.work_branch, target_ref: owner.target_ref,
            base_sha: owner.base_sha, expected_target_sha: owner.expected_target_sha,
            policy_sha256: owner.policy_sha256
        )
        expect(register_release_session(root, intruder).reason).to_contain("workspace is already owned")

    it "binds one session id to one immutable ownership tuple":
        val (root, owner) = fixture_session()
        expect(register_release_session(root, owner).valid).to_be(true)
        val rebound_branch = "work/release/local-20260826-902-session-rebind"
        val _switched = git(root, ["switch", "-c", rebound_branch])
        val rebound = ReleaseSession(
            session_id: owner.session_id, workspace_path: owner.workspace_path,
            main_workspace_path: owner.main_workspace_path,
            work_branch: rebound_branch, target_ref: owner.target_ref,
            base_sha: owner.base_sha, expected_target_sha: owner.expected_target_sha,
            policy_sha256: owner.policy_sha256
        )
        expect(register_release_session(root, rebound).reason).to_contain("different immutable owner")

    it "advances the registered head by lease and CAS then closes after a session commit":
        step("Register a clean isolated fixture at its immutable base")
        val (root, session) = fixture_session()
        val registered = register_release_session(root, session)
        expect(registered.valid).to_be(true)

        step("Hold the session mutation lease across the owned commit")
        val lease = begin_release_session_mutation(root, session)
        expect(lease.valid).to_be(true)
        val _changed = file_atomic_write(root + "/tracked.txt", "session mutation\n")
        val _added = git(root, ["add", "tracked.txt"])
        val _committed = git(root, ["commit", "-m", "owned session mutation"])
        val advanced = advance_release_session_head(
            lease, session, registered.registry_sha256, session.base_sha
        )
        expect(advanced.valid).to_be(true)
        expect(end_release_session_mutation(lease)).to_be(true)

        step("Use the mutable registered head while retaining the immutable base")
        expect(verify_release_session(root, session).reason).to_contain("base identity")
        expect(verify_registered_release_session(root, session).valid).to_be(true)
        expect(check_release_session_cleanup(root, session).valid).to_be(true)
        expect(close_release_session(root, session, advanced.registry_sha256).valid).to_be(true)
        expect(verify_registered_release_session(root, session).reason).to_contain("not the active registered owner")

    it "rejects a branch head advanced outside the held session mutation lease":
        val (root, session) = fixture_session()
        expect(register_release_session(root, session).valid).to_be(true)
        val _changed = file_atomic_write(root + "/tracked.txt", "foreign mutation\n")
        val _added = git(root, ["add", "tracked.txt"])
        val _committed = git(root, ["commit", "-m", "foreign mutation"])
        expect(verify_registered_release_session(root, session).reason).to_contain("foreign or stale")
        expect(check_release_session_cleanup(root, session).reason).to_contain("foreign or stale")

    it "never treats a dirty active session as safe to clean automatically":
        val (root, session) = fixture_session()
        expect(register_release_session(root, session).valid).to_be(true)
        val _dirty = file_atomic_write(root + "/tracked.txt", "dirty but uncommitted\n")
        val cleanup = check_release_session_cleanup(root, session)
        expect(cleanup.valid).to_be(false)
        expect(cleanup.reason).to_contain("worktree is dirty")
        val stale_close = close_release_session(
            root, session,
            "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        )
        expect(stale_close.valid).to_be(false)
        expect(stale_close.reason).to_contain("registry changed after cleanup planning")
