# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-INTEGRATION
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec.{describe, it, expect}
use compiler.backend.llvm_support_matrix.{lookup_support, get_support_matrix}
use compiler.backend.backend.backend_types.{BackendKind, CodegenTarget}

describe "i686 closure":
    # @manual scenario evidence
    it "llvm-lib i686 is unsupported":
        # @req REQ-SSPEC-INTEGRATION
        step("llvm-lib i686 is unsupported")
        val level = lookup_support(BackendKind.LlvmLib, CodegenTarget.X86)
        expect(level.to_text()).to_equal("unsupported")

    it "llvm CLI i686 is unsupported":
        # @req REQ-SSPEC-INTEGRATION
        step("llvm CLI i686 is unsupported")
        val level = lookup_support(BackendKind.Llvm, CodegenTarget.X86)
        expect(level.to_text()).to_equal("unsupported")

    it "i686 level is a final state":
        # @req REQ-SSPEC-INTEGRATION
        step("i686 level is a final state")
        val level = lookup_support(BackendKind.LlvmLib, CodegenTarget.X86)
        expect(level.is_final_state()).to_equal(true)

    it "i686 unsupported has clear diagnostic":
        # @req REQ-SSPEC-INTEGRATION
        step("i686 unsupported has clear diagnostic")
        val matrix = get_support_matrix()
        for entry in matrix:
            if entry.target == CodegenTarget.X86:
                expect(entry.known_limits).to_contain("Demoted to unsupported")
