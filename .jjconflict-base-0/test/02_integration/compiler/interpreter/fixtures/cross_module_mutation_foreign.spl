use .cross_module_mutation_owner.{CrossModuleMutationProbe}

fn unrelated_foreign_call(value: i64) -> i64:
    value + 1

fn nested_imported_advance(probe: CrossModuleMutationProbe) -> i64:
    imported_advance(probe)

fn imported_advance(probe: CrossModuleMutationProbe) -> i64:
    probe.advance()
