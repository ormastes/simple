use macos_metal_msl_library_micro_diagnostic.{bounded_error}
use std.spec.{describe, it, expect}

describe "macOS Metal MSL library micro diagnostic helpers":
    it "keeps compiler errors single-line":
        expect(bounded_error("line one\nline two\rline three")).to_equal(
            "line one line two line three"
        )

    it "preserves already-safe compiler errors":
        expect(bounded_error("metal compiler unavailable")).to_equal(
            "metal compiler unavailable"
        )
