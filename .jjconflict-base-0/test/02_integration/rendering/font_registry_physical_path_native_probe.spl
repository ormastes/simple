use std.common.encoding.font_registry.{
    _selected_font_asset_physical_path_from_root,
    selected_font_asset_candidates
}

fn main() -> i64:
    val local_path: text = selected_font_asset_candidates()[9].local_path
    val root = "/tmp/simple-native-font-assets"
    val expected = root + "/" + local_path
    val resolved = _selected_font_asset_physical_path_from_root(local_path, root)
    if resolved != expected:
        print("font_registry_native_path_status=fail")
        print("font_registry_native_path_resolved=" + resolved)
        print("font_registry_native_path_expected=" + expected)
        return 1
    if _selected_font_asset_physical_path_from_root(local_path, "") != local_path:
        print("font_registry_native_path_status=fail-empty-root")
        return 2
    if _selected_font_asset_physical_path_from_root(
        "tmp/unmanaged.ttf", root
    ) != "tmp/unmanaged.ttf":
        print("font_registry_native_path_status=fail-unmanaged")
        return 3
    print("font_registry_native_path_status=pass")
    0
