#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd)
source_dir="$root/src/os/kernel/arch/arm32/cosmos"
test_source="$root/test/02_integration/os/cosmos/cosmos_ftl_nfc_backend_test.c"
build_dir=$(mktemp -d "${TMPDIR:-/tmp}/cosmos-ftl-nfc-wrap.XXXXXX")
trap 'rm -rf "$build_dir"' EXIT HUP INT TERM

common_flags='-std=c11 -O2 -Wall -Wextra -Werror -Wpedantic -Wshadow -Wstrict-prototypes -Wformat=2'
test_flags='-DCOSMOS_FTL_NFC_METADATA_PAGE_LIMIT=1024U -DCOSMOS_FTL_NFC_TEST_SMALL_GEOMETRY=1 -DCOSMOS_FTL_NFC_RECOVERY_WRAP_TEST=1'

cc $common_flags -Wno-int-to-pointer-cast -DCOSMOS_MMIO_TEST=1 \
    $test_flags -no-pie -I"$source_dir" \
    "$test_source" "$source_dir/cosmos_ftl_nfc_backend.c" \
    "$source_dir/cosmos_ftl.c" "$source_dir/cosmos_nfc.c" \
    -o "$build_dir/cosmos_ftl_nfc_recovery_wrap_test"
"$build_dir/cosmos_ftl_nfc_recovery_wrap_test"

clang --target=armv7-none-eabi -mcpu=cortex-a9 -marm \
    -ffreestanding -nostdlib -fno-builtin $common_flags \
    -DCOSMOS_SILICON=1 $test_flags \
    -include "$source_dir/cosmos_profile_openssd2_8ch8way_v300.h" \
    -I"$source_dir" -c "$source_dir/cosmos_ftl_nfc_backend.c" \
    -o "$build_dir/cosmos_ftl_nfc_recovery_wrap.arm.o"

echo "cosmos FTL NFC recovery and wrap ARM compile: PASS"
