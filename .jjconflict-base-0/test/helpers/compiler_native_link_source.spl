# Source-contract compatibility view for the concern-split native linker.

use std.io_runtime.{file_read}

fn compiler_native_link_source() -> text:
    [
        "src/compiler/70.backend/backend/llvm_native_link_stage4_projection.spl",
        "src/compiler/70.backend/backend/llvm_native_link_stage4_archives.spl",
        "src/compiler/70.backend/backend/llvm_native_link_hosted_support.spl",
        "src/compiler/70.backend/backend/llvm_native_link_orchestrator.spl",
        "src/compiler/70.backend/backend/simpleos_native_symbols.spl",
        "src/compiler/70.backend/backend/simpleos_native_trivial_body.spl",
        "src/compiler/70.backend/backend/simpleos_native_guards.spl",
        "src/compiler/70.backend/backend/simpleos_native_linkers.spl"
    ].map(\path: file_read(path)).join("\n")

export compiler_native_link_source
