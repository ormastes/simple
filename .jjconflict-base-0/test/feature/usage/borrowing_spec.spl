# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-FEATURE
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Borrowing, observed through Simple's value semantics: a callee receives a
# copy-on-write view, so callee-side mutation never aliases back into the
# caller, while owner-side mutation is visible to the owner.

use std.spec.step

describe "Borrowing and Reference Capabilities":
    # @manual scenario evidence
    it "multiple readers observe the same value without interference":
        # @req REQ-SSPEC-FEATURE
        step("read through two bindings of one value")
        val xs = [1, 2, 3]
        val a = xs
        val b = xs
        expect(a).to_equal(xs)
        expect(b).to_equal(xs)

    it "a rebound copy mutates independently of the original":
        # @req REQ-SSPEC-FEATURE
        step("bind a second variable and push into it")
        val mine = [1, 2, 3]
        var copy = mine
        copy.push(99)
        expect(mine).to_equal([1, 2, 3])
        expect(copy).to_equal([1, 2, 3, 99])

    it "the single owner mutating in place sees the new state":
        # @req REQ-SSPEC-FEATURE
        step("mutate through the owning variable")
        var owned = [1, 2, 3]
        owned.push(4)
        expect(owned).to_equal([1, 2, 3, 4])
        expect(owned.len()).to_equal(4)
