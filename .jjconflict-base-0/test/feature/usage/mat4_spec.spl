"""
## Purpose and audience

# Mat4 Specification

**Feature IDs:** #MATH-002
**Category:** Stdlib
**Difficulty:** 3/5
**Status:** Implemented

## Overview
Mat4 (f32) and Mat4d (f64) 4x4 transformation matrices with column-major storage.

## Key Concepts
| Concept | Description |
|---------|-------------|
| Row-major | Flat 16-element f64 array, row-major storage order |
| Transform | Translation, rotation, scale factories |
| Projection | Perspective and orthographic projection |

## Behavior
- Row-major storage (see src/lib/common/engine/math3d.spl)
- Factory methods for common transforms
- Matrix multiplication and inverse
- Point and vector transformation
"""

use std.spec.step
use std.common.engine.math3d.{Mat4, Vec3}

# ============================================================================
# Mat4 Identity and Factories
# ============================================================================

describe "Mat4 Identity and Factories":
    # @manual scenario evidence
    it "creates identity matrix", tag: ["skip"]:
        val m = Mat4.identity()
        expect m.data[0] == 1.0
        expect m.data[5] == 1.0
        expect m.data[10] == 1.0
        expect m.data[15] == 1.0
        expect m.data[1] == 0.0

    it "creates translation matrix", tag: ["skip"]:
        # @req REQ-SSPEC-FEATURE
        step("creates translation matrix")
        val m = Mat4.translation(1.0, 2.0, 3.0)
        # Row-major: translation in row 0..2, column 3 (indices 3, 7, 11)
        expect m.data[3] == 1.0
        expect m.data[7] == 2.0
        expect m.data[11] == 3.0

    it "creates scale matrix", tag: ["skip"]:
        # @req REQ-SSPEC-FEATURE
        step("creates scale matrix")
        val m = Mat4.scaling(2.0, 3.0, 4.0)
        expect m.data[0] == 2.0
        expect m.data[5] == 3.0
        expect m.data[10] == 4.0

# ============================================================================
# Mat4 Operations
# ============================================================================

describe "Mat4 Operations":
    it "multiplies identity by identity", tag: ["skip"]:
        # @req REQ-SSPEC-FEATURE
        step("multiplies identity by identity")
        val a = Mat4.identity()
        val b = Mat4.identity()
        val c = a.mul(b)
        expect c.data[0] == 1.0
        expect c.data[5] == 1.0
        expect c.data[10] == 1.0
        expect c.data[15] == 1.0

    it "multiplies translation matrices", tag: ["skip"]:
        # @req REQ-SSPEC-FEATURE
        step("multiplies translation matrices")
        val a = Mat4.translation(1.0, 0.0, 0.0)
        val b = Mat4.translation(0.0, 2.0, 0.0)
        val c = a.mul(b)
        # Combined translation: (1, 2, 0)
        expect c.data[3] == 1.0
        expect c.data[7] == 2.0
        expect c.data[11] == 0.0

    it "transforms a point", tag: ["skip"]:
        # @req REQ-SSPEC-FEATURE
        step("transforms a point")
        val m = Mat4.translation(10.0, 20.0, 30.0)
        val p = Vec3(1.0, 2.0, 3.0)
        val result = m.transform_point(p)
        expect result.x == 11.0
        expect result.y == 22.0
        expect result.z == 33.0

    it "transforms a direction vector (ignores translation)", tag: ["skip"]:
        # @req REQ-SSPEC-FEATURE
        step("transforms a direction vector (ignores translation)")
        val m = Mat4.translation(10.0, 20.0, 30.0)
        val v = Vec3(1.0, 0.0, 0.0)
        val result = m.transform_direction(v)
        expect result.x == 1.0
        expect result.y == 0.0
        expect result.z == 0.0

    it "extracts 3x3 submatrix", tag: ["skip"]:
        # @req REQ-SSPEC-FEATURE
        step("extracts 3x3 submatrix")
        val m = Mat4.scaling(2.0, 3.0, 4.0)
        val m3 = m.to_mat3()
        expect m3.data[0] == 2.0
        expect m3.data[4] == 3.0
        expect m3.data[8] == 4.0

# ============================================================================
# Mat4 Inverse
# ============================================================================

describe "Mat4 Inverse":
    it "inverts identity to identity", tag: ["skip"]:
        # @req REQ-SSPEC-FEATURE
        step("inverts identity to identity")
        val m = Mat4.identity()
        val inv = m.inverse()
        expect inv.data[0] == 1.0
        expect inv.data[5] == 1.0

    it "inverts translation", tag: ["skip"]:
        # @req REQ-SSPEC-FEATURE
        step("inverts translation")
        val m = Mat4.translation(5.0, 10.0, 15.0)
        val inv = m.inverse()
        # Inverse translation should negate
        expect inv.data[3] == -5.0
        expect inv.data[7] == -10.0
        expect inv.data[11] == -15.0
