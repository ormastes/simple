use app.io.mod (process_run)

fn _run_provenance_script(script: text) -> text:
    val (out, err, code) = process_run("/bin/sh", ["-c", script])
    val combined = "{out}{err}\nexit={code}\n"
    # PREVENTION GUARD for the shell-out CLASS (same rationale as
    # scv_parser_wasm_spec): assert the subprocess actually RAN before
    # asserting anything about what it printed, so "did not run" can never
    # masquerade as "ran wrong". `bin/simple` is used deliberately, never the
    # refusing `bin/release/simple` wrapper.
    assert_equal(code, 0)
    assert_false(out == "")
    assert_false(combined.contains("refusing non-production Simple runtime"))
    combined

describe "scv parser provenance and hash family":
    it "labels a fallback parse fallback-line even when the locked grammar is named tree-sitter-wasm":
        # Gap 5 repro: install a grammar literally named `tree-sitter-wasm`
        # with NO wasm runtime available. The line walk runs; the summary must
        # say execution=fallback-line, never a tree-sitter label. A second
        # parse-gate exercises the cached branch, which must stay honest too.
        val script = "set -eu\nREPO=$(pwd)\nTMP=$(mktemp -d /tmp/scv-provenance.XXXXXX)\ncd \"$TMP\"\nprintf '\\000asm\\001\\000\\000\\000' > parser.wasm\nprintf 'alpha\\n' > sample.foo\nSIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/scv/main.spl\" init >/dev/null\nSIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/scv/main.spl\" parser-install foo tree-sitter-wasm 1.0.0 parser.wasm wasm32-tree-sitter >/dev/null\nSIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/scv/main.spl\" langmap-set foo foo tree-sitter-wasm 1.0.0 >/dev/null\nSIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/scv/main.spl\" snapshot >/dev/null\nFIRST=$(SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/scv/main.spl\" parse-gate sample.foo)\nprintf 'first_execution=%s\\n' \"$(printf '%s' \"$FIRST\" | sed -n 's/^execution=\\(.*\\)$/\\1/p' | head -1)\"\nCACHED=$(SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/scv/main.spl\" parse-gate sample.foo)\nprintf 'cached_execution=%s\\n' \"$(printf '%s' \"$CACHED\" | sed -n 's/^execution=\\(.*\\)$/\\1/p' | head -1)\"\nif printf '%s' \"$FIRST\" | grep -q 'syntax_hash:'; then printf 'fallback_syntax_hash_claim=yes\\n'; else printf 'fallback_syntax_hash_claim=no\\n'; fi\n"
        val out = _run_provenance_script(script)
        expect(out).to_contain("first_execution=fallback-line")
        expect(out).to_contain("cached_execution=fallback-line")
        # A fallback parse must not claim a structural syntax_hash.
        expect(out).to_contain("fallback_syntax_hash_claim=no")
        expect(out).to_contain("exit=0")

    it "reports the hash family: raw_hash exact, text_policy_hash stable across trailing-whitespace change":
        # Gap E/8: raw_hash is the exact content id (must equal the legacy
        # raw: field); text_policy_hash is the formatting-normalized value
        # (legacy semantic: field, aliased): stable across a trailing
        # whitespace-only change while raw_hash differs.
        val script = "set -eu\nREPO=$(pwd)\nTMP=$(mktemp -d /tmp/scv-hashfamily.XXXXXX)\ncd \"$TMP\"\nprintf 'alpha\\nbeta\\n' > sample.txt\nSIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/scv/main.spl\" init >/dev/null\nSIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/scv/main.spl\" snapshot >/dev/null\nA=$(SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/scv/main.spl\" parse-gate sample.txt)\nA_RAW=$(printf '%s' \"$A\" | sed -n 's/^raw_hash: //p' | head -1)\nA_LEGACY_RAW=$(printf '%s' \"$A\" | sed -n 's/^raw: //p' | head -1)\nA_POLICY=$(printf '%s' \"$A\" | sed -n 's/^text_policy_hash: //p' | head -1)\nA_LEGACY_SEM=$(printf '%s' \"$A\" | sed -n 's/^semantic: //p' | head -1)\nprintf 'alpha  \\nbeta\\n' > sample.txt\nB=$(SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/scv/main.spl\" parse-gate sample.txt)\nB_RAW=$(printf '%s' \"$B\" | sed -n 's/^raw_hash: //p' | head -1)\nB_POLICY=$(printf '%s' \"$B\" | sed -n 's/^text_policy_hash: //p' | head -1)\ntest -n \"$A_RAW\" && printf 'raw_hash_present=yes\\n'\ntest -n \"$A_POLICY\" && printf 'text_policy_hash_present=yes\\n'\ntest \"$A_RAW\" = \"$A_LEGACY_RAW\" && printf 'raw_alias_exact=yes\\n'\ntest \"$A_POLICY\" = \"$A_LEGACY_SEM\" && printf 'policy_alias_exact=yes\\n'\ntest \"$A_RAW\" != \"$B_RAW\" && printf 'raw_differs=yes\\n'\ntest \"$A_POLICY\" = \"$B_POLICY\" && printf 'policy_stable=yes\\n'\n"
        val out = _run_provenance_script(script)
        expect(out).to_contain("raw_hash_present=yes")
        expect(out).to_contain("text_policy_hash_present=yes")
        expect(out).to_contain("raw_alias_exact=yes")
        expect(out).to_contain("policy_alias_exact=yes")
        expect(out).to_contain("raw_differs=yes")
        expect(out).to_contain("policy_stable=yes")
        expect(out).to_contain("exit=0")
