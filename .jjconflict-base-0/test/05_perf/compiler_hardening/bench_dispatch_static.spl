# A7 §18.1: static closed-enum match dispatch, 8 variants, 1M iterations.
extern fn rt_time_now_nanos() -> i64

enum Op:
    Add(a: i64)
    Sub(a: i64)
    Mul(a: i64)
    Div(a: i64)
    And(a: i64)
    Or(a: i64)
    Xor(a: i64)
    Shl(a: i64)

fn make_op(k: i64, a: i64) -> Op:
    if k == 0: Op.Add(a)
    elif k == 1: Op.Sub(a)
    elif k == 2: Op.Mul(a)
    elif k == 3: Op.Div(a)
    elif k == 4: Op.And(a)
    elif k == 5: Op.Or(a)
    elif k == 6: Op.Xor(a)
    else: Op.Shl(a)

fn eval_static(o: Op, acc: i64) -> i64:
    match o:
        case Op.Add(a): acc + a
        case Op.Sub(a): acc - a
        case Op.Mul(a): acc + a * 2
        case Op.Div(a): acc + a / 2
        case Op.And(a): acc + (a & 7)
        case Op.Or(a): acc + (a | 1)
        case Op.Xor(a): acc + (a ^ 3)
        case Op.Shl(a): acc + (a << 1)

fn main():
    val iters: i64 = 1000000
    var acc: i64 = 0
    val t0 = rt_time_now_nanos()
    var i: i64 = 0
    while i < iters:
        acc = eval_static(make_op(i & 7, i), acc)
        i = i + 1
    val t1 = rt_time_now_nanos()
    print "BENCH dispatch_static_enum_match {(t1 - t0) / iters}"
    if acc == 12345678987654321: print "# sink"

main()
