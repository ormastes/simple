# Measures canonical SDN serialization, the dominant route-key construction step.

use std.spec.{describe, it, expect}
use common.ui.draw_ir.{
    DrawIrCommand,
    DrawIrComposition,
    draw_ir_batch,
    draw_ir_composition,
    draw_ir_embedding_config,
    draw_ir_rect
}
use common.ui.draw_ir_sdn.{draw_ir_to_sdn}
use std.gc_async_mut.io.time_ops.{time_now_micros}

struct DrawIrKeyCost:
    command_count: i32
    encoded_bytes: i64
    median_us: i64
    output_stable: bool
    timings_valid: bool

fn key_fixture(command_count: i32) -> DrawIrComposition:
    var commands: [DrawIrCommand] = []
    var index = 0
    while index < command_count:
        commands.push(draw_ir_rect(
            "rect-{index}", index % 64, index / 64, 8, 8, 0xFF1D4ED8u32))
        index = index + 1
    val embedding = draw_ir_embedding_config(
        "web", "body", 0, 0, 512, 512, 0, 1000, true)
    draw_ir_composition(
        "web-route-key-{command_count}", "generic-web", "gpu", [
            draw_ir_batch("body", "gpu", embedding, commands)
        ])

fn measure_key_cost(command_count: i32) -> DrawIrKeyCost:
    val composition = key_fixture(command_count)
    var warmup = 0
    while warmup < 3:
        val ignored = draw_ir_to_sdn(composition)
        warmup = warmup + 1
    var samples: [i64] = []
    var encoded_bytes: i64 = 0
    var output_stable = true
    var timings_valid = true
    var sample = 0
    while sample < 3:
        val start_us = time_now_micros()
        val encoded = draw_ir_to_sdn(composition)
        val end_us = time_now_micros()
        val current_bytes = encoded.len().to_i64()
        if sample == 0:
            encoded_bytes = current_bytes
        elif current_bytes != encoded_bytes:
            output_stable = false
        val elapsed_us = end_us - start_us
        if elapsed_us <= 0:
            timings_valid = false
        samples.push(elapsed_us)
        sample = sample + 1
    samples.sort()
    DrawIrKeyCost(
        command_count: command_count,
        encoded_bytes: encoded_bytes,
        median_us: samples[1],
        output_stable: output_stable,
        timings_valid: timings_valid)

describe "Primary web Draw IR route-key SDN serialization cost":
    it "records canonical key cost as composition size grows":
        val small = measure_key_cost(64)
        val medium = measure_key_cost(256)
        val large = measure_key_cost(1024)
        expect(small.encoded_bytes).to_be_greater_than(0)
        expect(medium.encoded_bytes).to_be_greater_than(small.encoded_bytes)
        expect(large.encoded_bytes).to_be_greater_than(medium.encoded_bytes)
        expect(small.median_us).to_be_greater_than(0)
        expect(medium.median_us).to_be_greater_than(0)
        expect(large.median_us).to_be_greater_than(0)
        expect(small.output_stable).to_equal(true)
        expect(medium.output_stable).to_equal(true)
        expect(large.output_stable).to_equal(true)
        expect(small.timings_valid).to_equal(true)
        expect(medium.timings_valid).to_equal(true)
        expect(large.timings_valid).to_equal(true)
        print(
            "WEB_DRAW_IR_KEY_SDN_COST small_us={small.median_us} " +
            "medium_us={medium.median_us} large_us={large.median_us} " +
            "small_bytes={small.encoded_bytes} medium_bytes={medium.encoded_bytes} " +
            "large_bytes={large.encoded_bytes}")
