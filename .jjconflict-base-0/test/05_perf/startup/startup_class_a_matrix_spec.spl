# Class A cross-language startup gate.
#
# The shell detector is the single timing oracle. This spec runs schema and
# admission negatives only. A live matrix is forbidden until Stage 4 exists.

use std.spec.*
use std.io_runtime.{process_run}
val CHECK: text = "scripts/check/check-startup-class-a-matrix.shs"

describe "Class A prebuilt cross-language startup matrix":

    it "keeps the v2 evidence schema and recomputation controls biting":
        step("Run one valid synthetic receipt and eighteen invalid controls without measuring a live lane")
        val result = process_run("sh", ["-c", "sh " + CHECK + " --schema-selftest 2>&1"])
        val out: text = result.0
        val code: i64 = result.2

        step("The valid receipt has seven languages, raw N=7 rows, frozen fairness, and balanced ordering")
        expect(out).to_contain("schema_selftest_valid=true")
        expect(out).to_contain("schema_languages=simple_native,c,rust,go,python,bun,java")
        expect(out).to_contain("schema_raw_rows_per_admitted_lane=7")
        expect(out).to_contain("schema_fairness_classes=native-aot-prebuilt-v1,source-runtime-preinstalled-v1,vm-bytecode-prebuilt-v1")
        expect(out).to_contain("schema_startup_class=process-cold-host-cache-warm-v1")
        expect(out).to_contain("schema_order_strategy=seeded-cyclic-position-balanced-v2")

        step("Fallback, sample floor, mutable budgets, missing raw rows, fabricated p50/max RSS, and bad hashes are rejected")
        expect(out).to_contain("schema_selftest_fallback_negative_control=true")
        expect(out).to_contain("schema_selftest_sample_floor_negative_control=true")
        expect(out).to_contain("schema_selftest_budget_policy_negative_control=true")
        expect(out).to_contain("schema_selftest_budget_p50_negative_control=true")
        expect(out).to_contain("schema_selftest_budget_p95_negative_control=true")
        expect(out).to_contain("schema_selftest_budget_rss_negative_control=true")
        expect(out).to_contain("schema_selftest_order_seed_negative_control=true")
        expect(out).to_contain("schema_selftest_order_position_negative_control=true")
        expect(out).to_contain("schema_selftest_missing_raw_negative_control=true")
        expect(out).to_contain("schema_selftest_percentile_negative_control=true")
        expect(out).to_contain("schema_selftest_max_rss_negative_control=true")
        expect(out).to_contain("schema_selftest_hash_negative_control=true")

        step("False Stage 4, wrong warm/cold class, forged ratios, and confused rustup identities are rejected")
        expect(out).to_contain("schema_selftest_selfhost_negative_control=true")
        expect(out).to_contain("schema_selftest_startup_class_negative_control=true")
        expect(out).to_contain("schema_selftest_ratio_negative_control=true")
        expect(out).to_contain("schema_selftest_rustup_identity_negative_control=true")
        expect(out).to_contain("schema_selftest_rust_host_negative_control=true")
        expect(out).to_contain("schema_selftest_tool_version_negative_control=true")
        expect(code).to_equal(0)

    it "classifies the Rust seed as unavailable and never starts the matrix":
        step("Preflight the bootstrap seed explicitly; do not compile or sample any competitor")
        val result = process_run("sh", ["-c", "SIMPLE_CLASS_A_BINARY=bin/simple sh " + CHECK + " --stage4-preflight 2>&1"])
        val out: text = result.0
        val code: i64 = result.2

        step("The seed is unavailable, the verdict is non-PASS, and no report or live sample is produced")
        expect(out).to_contain("class_a_stage4=unavailable")
        expect(out).to_contain("admitted pure-Simple Stage 4 is mandatory")
        expect(out.contains("class_a_report=")).to_equal(false)
        expect(out.contains("PASS — Class A v2 startup matrix:")).to_equal(false)
        expect(code).to_equal(2)
