use os.kernel.arch.riscv64.platform.uart_baud_policy.{
    uart_baud_policy_word,
    uart_baud_policy_word_divisor,
    uart_baud_policy_word_status_code
}

fn main() -> i64:
    var checksum: u64 = 0u64
    var i: u64 = 0u64
    var baud_remainder: u64 = 0u64
    while i < 50000000u64:
        # Cranelift does not strength-reduce remainder by this constant. Keep
        # the exact same input sequence with a rolling remainder, matching the
        # reduction clang already performs for the C oracle.
        val baud = if (i & 15u64) == 0u64: 0u64 else: 2u64 + baud_remainder
        val word = uart_baud_policy_word(1843200u64, baud)
        checksum = checksum + uart_baud_policy_word_divisor(word) + uart_baud_policy_word_status_code(word)
        i = i + 1u64
        baud_remainder = baud_remainder + 1u64
        if baud_remainder == 115199u64:
            baud_remainder = 0u64
    print "checksum=" + checksum.to_text()
    0
