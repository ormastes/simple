# Transition table: MirTerminator -> LLVM text backend (MIR -> .ll emitter)
#
# Boundary: `MirToLlvm.translate_terminator_at`, src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl
# Producer universe: `enum MirTerminator` (7 variants), enumerated from the
# generated registry spec/compiler_schema/registry/compiler.mir.MirTerminator.sdn.
#
# Lane C7 (backend coverage, hardening plan 2026-08-21 sections 11.3-11.6).
# All seven terminators already have dedicated arms and this match carries no
# silent wildcard; the table exists so a NEW terminator variant upstream shows
# up as Missing in the transition gate instead of as a runtime match failure (or,
# for the native selector, as a deleted terminator).
#
# Recorded state verified by source inspection 2026-08-21.

table: mir_terminator_to_llvm
producer: MirTerminator
consumer: MirToLlvm
source: src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl

universe:
  - Abort
  - CallTerminator
  - Goto
  - If
  - Ret
  - Resume
  - Switch
  - Throw
  - Unreachable

transition:
  from: MirTerminator.Abort
  to: MirToLlvm
  state: implemented
  reason: "dedicated arm lowers Abort"
  test: mir_terminator_to_llvm_coverage_spec

transition:
  from: MirTerminator.CallTerminator
  to: MirToLlvm
  state: unsupported
  reason: "textual POSIX ELF lowering is implemented; llvm-lib fails closed on unwind edges with E-BACKEND-LLVM-LIB-TERM-CallTerminator-Unwind"
  test: mir_terminator_to_llvm_coverage_spec

transition:
  from: MirTerminator.Goto
  to: MirToLlvm
  state: implemented
  reason: "dedicated arm lowers Goto"
  test: mir_terminator_to_llvm_coverage_spec

transition:
  from: MirTerminator.If
  to: MirToLlvm
  state: implemented
  reason: "dedicated arm lowers If"
  test: mir_terminator_to_llvm_coverage_spec

transition:
  from: MirTerminator.Ret
  to: MirToLlvm
  state: implemented
  reason: "dedicated arm lowers Ret"
  test: mir_terminator_to_llvm_coverage_spec

transition:
  from: MirTerminator.Resume
  to: MirToLlvm
  state: unsupported
  reason: "textual POSIX ELF lowering is implemented; llvm-lib fails closed with E-BACKEND-LLVM-LIB-TERM-Resume"
  test: mir_terminator_to_llvm_coverage_spec

transition:
  from: MirTerminator.Switch
  to: MirToLlvm
  state: implemented
  reason: "dedicated arm lowers Switch"
  test: mir_terminator_to_llvm_coverage_spec

transition:
  from: MirTerminator.Throw
  to: MirToLlvm
  state: unsupported
  reason: "textual POSIX ELF lowering is implemented; llvm-lib fails closed with E-BACKEND-LLVM-LIB-TERM-Throw"
  test: mir_terminator_to_llvm_coverage_spec

transition:
  from: MirTerminator.Unreachable
  to: MirToLlvm
  state: implemented
  reason: "dedicated arm lowers Unreachable"
  test: mir_terminator_to_llvm_coverage_spec
