# Complete, dynloaded, first-use module (hardening plan §16.4) plus the §13.2
# constructor contract it satisfies. Valid: seals clean in a critical build once
# the module id is listed as verified-and-sealed.
extension:
  owner_enum: compiler.hir.HirExprKind
  constructor: async.Await
  closure: complete
  payload_schema_hash: "2d15aa0f9c31b7e4"
  module_abi_hash: "9b41c07e5da28f16"
  required_core_abi_hash: "core-abi-v1"
  provider_module: "hir_async"
  local_ordinal: 1
  schema_abi_version: 2

  provides:
    verify: async.verify_await
    type_check: async.type_await
    effects: async.effects_await
    visit_children: async.visit_await
    lower_mir: async.lower_await
    print: async.print_await
    hash: async.hash_await
    serialize: async.serialize_await

module:
  id: hir_async
  linkage: dynload
  closure: complete
  activation: first_use

  extends:
    - enum: compiler.hir.HirExprKind
      constructor: async.Await
      schema_abi: 2

  provides:
    - HirVerify
    - HirEffects
    - HirVisit
    - HirLowerMir
    - HirPrint
    - HirSerialize
