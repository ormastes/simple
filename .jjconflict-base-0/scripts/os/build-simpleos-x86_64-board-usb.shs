#!/bin/sh
# build-simpleos-x86_64-board-usb.shs
#
# Build a REPRODUCIBLE, real GPT+FAT32 USB disk image for the SimpleOS
# x86_64 physical-board UEFI boot lane (mini-PC bring-up,
# doc/03_plan/os/simpleos/hw_qemu/clang_board_bringup_x86_64_uefi.md, phase
# P1.1). This closes exactly that phase's missing item: the OVMF harness
# (scripts/os/scp_retrieve_over_ssh_uefi.shs) serves its ESP to QEMU as a
# `fat:rw:<dir>` VIRTUAL FAT (vvfat) — a QEMU-only convenience with no real
# block device behind it, so it cannot be dd'd to a USB stick and booted on
# real firmware. This script produces an actual raw disk image: a GPT
# partition table with one EFI System Partition, formatted FAT32, containing
# a directly entered resident BOOTX64.EFI plus self-contained GRUBX64.EFI
# fallback (grub-mkstandalone, kernel embedded via memdisk), both exercised by
# the OVMF lanes.
#
# ---------------------------------------------------------------------------
# DESIGN — mirrors scripts/os/build-simpleos-aarch64-efi-esp.shs
# ---------------------------------------------------------------------------
# Same shape as the aarch64 ESP builder that closed the equivalent gap for
# that arch: fail loudly on any missing tool or input, produce one artifact,
# verify it structurally before declaring success, print a sha256 for
# provenance. The aarch64 script formats a bare FAT image (no partition
# table) because AAVMF/QEMU there takes the ESP as a raw FAT block device
# directly. x86_64 USB boot on physical mini-PC firmware instead expects a
# real GPT disk with a partition marked ESP (type C12A7328-F81F-11D2-BA4B-
# 00A0C93EC93B) — most board UEFI implementations will not boot a bare FAT
# filesystem with no partition table from a USB stick. That partitioning is
# the one genuinely new piece of work versus the aarch64 script.
#
# ---------------------------------------------------------------------------
# USAGE
# ---------------------------------------------------------------------------
#     sh scripts/os/build-simpleos-x86_64-board-usb.shs
#
# Inputs (env overridable):
#     KERNEL_ELF   path to the x86_64 SimpleOS kernel ELF (multiboot1).
#                  Default: build/os/elfexec/kernel.elf. Building the kernel
#                  from source is a separate lane and is NOT invoked here.
#     OUT_DIR      default build/os/x86_64_board_usb
#     DISK_MB      total USB image size in MiB. Default 256.
#     ESP_MB       ESP partition size in MiB. Default 64.
#
# Exit status: 0 = image built and structurally verified; non-zero = nothing
# usable was produced. There is no partial success.
#
# UNVERIFIED WITHOUT HARDWARE: this script is checked by
# scripts/check/check-simpleos-x86_64-board-usb-image.shs, which validates
# the GPT/FAT structure it produces WITHOUT a board. It does NOT prove the
# image boots real firmware — see doc/07_guide/os/simpleos_board_bringup.md.

set -eu

REPO_ROOT=$(cd "$(dirname "$0")/../.." && pwd)
OUT_DIR=${OUT_DIR:-$REPO_ROOT/build/os/x86_64_board_usb}
KERNEL_ELF=${KERNEL_ELF:-$REPO_ROOT/build/os/elfexec/kernel.elf}
DISK_MB=${DISK_MB:-256}
ESP_MB=${ESP_MB:-64}
SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH:-1704067200}
UP2_DISK_GUID=${UP2_DISK_GUID:-53494d50-4c45-4f53-a550-325545464930}
UP2_ESP_GUID=${UP2_ESP_GUID:-53494d50-4c45-4f53-a550-324553503031}
UP2_FAT_VOLUME_ID=${UP2_FAT_VOLUME_ID:-53494d50}
LOADER_C=$REPO_ROOT/examples/09_embedded/simple_os/arch/x86_64/boot/multiboot2_elf64_loader.c
LOADER_S=$REPO_ROOT/examples/09_embedded/simple_os/arch/x86_64/boot/multiboot2_elf64_loader.S
LOADER_LD=$REPO_ROOT/examples/09_embedded/simple_os/arch/x86_64/boot/multiboot2_elf64_loader.ld

die() { printf 'build-x86_64-board-usb: ERROR — %s\n' "$1" >&2; exit 1; }

case "$SOURCE_DATE_EPOCH" in
    ''|*[!0-9]*) die "SOURCE_DATE_EPOCH must be a nonnegative integer" ;;
esac
export SOURCE_DATE_EPOCH
TZ=UTC
export TZ

command -v grub-mkstandalone >/dev/null 2>&1 || die "grub-mkstandalone missing (install grub2-common/grub-efi-amd64-bin)"
MKFS=$(command -v mkfs.vfat 2>/dev/null || echo /usr/sbin/mkfs.vfat)
[ -x "$MKFS" ] || command -v mkfs.vfat >/dev/null 2>&1 || die "mkfs.vfat not available (install dosfstools)"
command -v sgdisk >/dev/null 2>&1 || die "sgdisk not available (install gdisk)"
command -v grub-file >/dev/null 2>&1 || die "grub-file missing (install grub2-common)"
command -v clang >/dev/null 2>&1 || die "clang missing for the ELF32 loader shim"
command -v ld.lld >/dev/null 2>&1 || die "ld.lld missing for the ELF32 loader shim"
[ -s "$KERNEL_ELF" ] || die "missing kernel ELF $KERNEL_ELF (set KERNEL_ELF=... or build the x86_64 board kernel lane first)"
grub-file --is-x86-multiboot2 "$KERNEL_ELF" || die "kernel is not a valid x86 Multiboot2 image"
[ -s "$LOADER_C" ] && [ -s "$LOADER_S" ] && [ -s "$LOADER_LD" ] || die "ELF32 Multiboot2 loader sources missing"

mkdir -p "$OUT_DIR"
DISK="$OUT_DIR/board-usb.img"
ESP_STAGE="$OUT_DIR/esp-stage"
EFIAPP="$ESP_STAGE/EFI/BOOT/BOOTX64.EFI"
GRUBAPP="$ESP_STAGE/EFI/BOOT/GRUBX64.EFI"
LOADER_OBJ_DIR="$OUT_DIR/multiboot2-loader-objects"
LOADER_ELF="$OUT_DIR/multiboot2-elf64-loader.elf"

echo "[usb] kernel  $KERNEL_ELF ($(wc -c <"$KERNEL_ELF") bytes)"

# GRUB's x86_64-efi direct handoff to this ELF64 kernel does not enter the
# kernel's 32-bit transition stub. Build a minimal ELF32 Multiboot2 payload that
# validates and loads the ELF64 file supplied as a module, then jumps to its
# reviewed _entry32 path.
rm -rf "$LOADER_OBJ_DIR"
mkdir -p "$LOADER_OBJ_DIR"
clang --target=i686-unknown-none-elf -m32 -ffreestanding -fno-builtin \
    -fno-stack-protector -fno-pic -fno-pie -fno-vectorize -fno-slp-vectorize \
    -Os -Wall -Wextra -Werror -c "$LOADER_C" -o "$LOADER_OBJ_DIR/loader.o" \
    || die "could not compile ELF32 loader C"
clang --target=i686-unknown-none-elf -m32 -ffreestanding -fno-pic -fno-pie \
    -c "$LOADER_S" -o "$LOADER_OBJ_DIR/entry.o" \
    || die "could not compile ELF32 loader entry"
ld.lld -m elf_i386 -nostdlib -static -T "$LOADER_LD" \
    "$LOADER_OBJ_DIR/entry.o" "$LOADER_OBJ_DIR/loader.o" -o "$LOADER_ELF" \
    || die "could not link ELF32 Multiboot2 loader"
grub-file --is-x86-multiboot2 "$LOADER_ELF" || die "loader shim is not a valid x86 Multiboot2 image"
file "$LOADER_ELF" | grep -q 'ELF 32-bit.*Intel 80386' || die "loader shim is not ELF32 i386"

# --- 1. Build the self-contained GRUB fallback and resident BOOTX64.EFI -----
rm -rf "$ESP_STAGE"; mkdir -p "$ESP_STAGE/EFI/BOOT"
MEMDISK_DIR=$(mktemp -d)
mkdir -p "$MEMDISK_DIR/boot/grub"
cp "$KERNEL_ELF" "$MEMDISK_DIR/boot/kernel.elf"
cp "$LOADER_ELF" "$MEMDISK_DIR/boot/loader.elf"
cat > "$MEMDISK_DIR/boot/grub/grub.cfg" <<EOF
serial --unit=0 --speed=115200 --word=8 --parity=no --stop=1
terminal_input serial
terminal_output serial
set timeout=0
set gfxpayload=text
echo UP2 loader-ready
multiboot2 /boot/loader.elf
module2 /boot/kernel.elf simpleos-kernel
echo UP2 kernel-admitted
boot
EOF
echo "[usb] building GRUBX64.EFI fallback (embeds kernel via memdisk) ..."
grub-mkstandalone --format=x86_64-efi --output="$GRUBAPP" \
    --directory=/usr/lib/grub/x86_64-efi \
    "/boot/grub/grub.cfg=$MEMDISK_DIR/boot/grub/grub.cfg" \
    "/boot/loader.elf=$MEMDISK_DIR/boot/loader.elf" \
    "/boot/kernel.elf=$MEMDISK_DIR/boot/kernel.elf" \
    2>&1 | sed 's/^/[grub-mkstandalone] /' \
    || die "grub-mkstandalone failed"
[ -s "$GRUBAPP" ] || die "grub-mkstandalone did not produce $GRUBAPP"
UP2_DCI_UEFI_OUTPUT="$EFIAPP" \
UP2_DCI_UEFI_OBJ_DIR="$OUT_DIR/dci-uefi-loader-objects" \
UP2_DCI_SHIM_ELF="$LOADER_ELF" \
    sh "$REPO_ROOT/scripts/os/build-up2-dci-uefi-loader.shs" \
    || die "resident DCI UEFI loader build failed"
[ -s "$EFIAPP" ] || die "resident loader did not produce $EFIAPP"
rm -rf "$MEMDISK_DIR"
STARTUP_NSH="$ESP_STAGE/startup.nsh"
printf 'FS0:\\EFI\\BOOT\\BOOTX64.EFI\r\n' > "$STARTUP_NSH"

# --- 2. Allocate the raw disk, GPT partition it, one ESP partition ---------
rm -f "$DISK"
dd if=/dev/zero of="$DISK" bs=1M count="$DISK_MB" status=none 2>/dev/null \
    || die "could not allocate ${DISK_MB}M disk image"
sgdisk --clear \
    --new=1:2048:+"${ESP_MB}"M --typecode=1:ef00 --change-name=1:"SIMPLEESP" \
    --disk-guid="$UP2_DISK_GUID" --partition-guid=1:"$UP2_ESP_GUID" \
    "$DISK" >/dev/null 2>&1 || die "sgdisk partitioning failed on $DISK"

# --- 3. Format the ESP partition as a standalone FAT32 image, then splice
#        it into the disk at the partition's byte offset ------------------
ESP_OFFSET_SECT=2048
ESP_OFFSET_BYTES=$((ESP_OFFSET_SECT * 512))
ESP_IMG="$OUT_DIR/esp.img"
rm -f "$ESP_IMG"
dd if=/dev/zero of="$ESP_IMG" bs=1M count="$ESP_MB" status=none 2>/dev/null \
    || die "could not allocate ${ESP_MB}M ESP image"
"$MKFS" --invariant -F 32 -i "$UP2_FAT_VOLUME_ID" -n SIMPLEESP \
    "$ESP_IMG" >/dev/null 2>&1 || die "mkfs.vfat failed on $ESP_IMG"

command -v mcopy >/dev/null 2>&1 || die "mcopy not available (install mtools)"
export MTOOLS_SKIP_CHECK=1
mmd -i "$ESP_IMG" "::EFI" "::EFI/BOOT" >/dev/null 2>&1 || die "mmd failed populating ESP"
mcopy -i "$ESP_IMG" "$EFIAPP" "::EFI/BOOT/BOOTX64.EFI" || die "mcopy BOOTX64.EFI failed"
mcopy -i "$ESP_IMG" "$GRUBAPP" "::EFI/BOOT/GRUBX64.EFI" || die "mcopy GRUBX64.EFI failed"
mcopy -i "$ESP_IMG" "$STARTUP_NSH" "::startup.nsh" || die "mcopy startup.nsh failed"

dd if="$ESP_IMG" of="$DISK" bs=512 seek="$ESP_OFFSET_SECT" conv=notrunc status=none \
    || die "splicing ESP image into disk failed"

echo "[usb] built $DISK ($(wc -c <"$DISK") bytes)"
echo "[usb] sha256 $(sha256sum "$DISK" | cut -d' ' -f1)"
echo "[usb] OK — image only; do not write an unverified /dev/sdX target"
echo "[usb] move the stick to the writer host, admit its stable by-id/serial as removable and non-system, then require full image-length readback"
echo "[usb] verify structure WITHOUT a board with: sh scripts/check/check-simpleos-x86_64-board-usb-image.shs"
