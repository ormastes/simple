#!/bin/sh
# SCV-IMPL-D-01 — structural-roots diff completion (REAL P-05 CST roots keyed by revision+ContentId, cst-roots > syntax-roots > text-blocks)
# Verdict is ALWAYS the last stdout line: PASS exit 0 / FAIL exit 1 / ERROR exit 2.
# Committed UNSIGNED.
set -u
LIB="src/lib/scv/structural_match.spl"
SPEC="test/integration/app/scv_structural_roots_diff_spec.spl"
TWIN="$(printf '%s' "$SPEC" | sed 's|test/integration/|test/02_integration/|')"
[ -f "$LIB" ] && [ -f "$SPEC" ] && [ -f "$TWIN" ] || { echo "ERROR — nothing was checked (missing files)"; exit 2; }
checked=0
bad=""
cmp -s "$SPEC" "$TWIN" || bad="$bad twin-diverged"
checked=$((checked + 1))
grep -q "scv_cst_diff_ops_for_file" src/lib/scv/diff.spl || bad="$bad diff(cst-precedence)"
checked=$((checked + 1))
grep -q "structural_source=cst-roots" src/lib/scv/diff.spl || bad="$bad diff(cst-label)"
checked=$((checked + 1))
grep -q "fn scv_cst_root_scan_cap" "$LIB" || bad="$bad bound(scan-cap)"
checked=$((checked + 1))
grep -q "fn scv_cst_ambiguity_margin_milli" "$LIB" || bad="$bad bound(ambiguity-margin)"
checked=$((checked + 1))
grep -q cst-store src/app/scv/main.spl || bad="$bad dispatch(cst-store)"
checked=$((checked + 1))
OUT="${TMPDIR:-/tmp}/SCV-IMPL-D-01.$$.log"
SIMPLE_TIMEOUT_SECONDS=900 bin/simple test "$SPEC" > "$OUT" 2>&1
rc=$?
checked=$((checked + 1))
RESULTS=$(grep 'Results:' "$OUT" | tail -1)
rm -f "$OUT"
[ "$rc" -eq 0 ] || bad="$bad spec-rc($rc)"
case "$RESULTS" in
  *", 0 failed"*) : ;;
  "") bad="$bad spec(no-results-line)" ;;
  *) bad="$bad spec($RESULTS)" ;;
esac
[ "$checked" -gt 0 ] || { echo "ERROR — nothing was checked"; exit 2; }
if [ -z "$bad" ]; then
  echo "PASS — $checked check(s): cst-roots diff wired with bounds, $RESULTS"
  exit 0
fi
echo "FAIL — $checked check(s), unmet:$bad"
exit 1
