#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
owner="$root/src/compiler_rust/lib/std/src/core/math.spl"
provider="$root/src/compiler_rust/runtime/src/value/sffi/math.rs"

declarations=$(grep -c '^[[:space:]]*extern fn rt_math_' "$owner")
if [ "$declarations" -ne 24 ]; then
    echo "bootstrap math extern inventory changed without ABI review" >&2
    exit 1
fi
tagged=$(awk '
    /^@unsafe\(.*capabilities: \[ffi\]\)$/ { previous_is_ffi = 1; next }
    /^[[:space:]]*extern fn rt_math_/ {
        if (previous_is_ffi) tagged++
    }
    { previous_is_ffi = 0 }
    END { print tagged + 0 }
' "$owner")
if [ "$tagged" -ne "$declarations" ]; then
    echo "every bootstrap math declaration must be explicitly unsafe(ffi)" >&2
    exit 1
fi

# Do not let either side drift while the f32/f64 symbol collision is pending.
owner_f32=$(grep -Ec '^extern fn rt_math_.*f32|^extern fn rt_math_(nan|inf)\(\) -> f32' "$owner")
provider_f64=$(grep -Ec '^pub extern "C" fn rt_math_.*f64|^pub extern "C" fn rt_math_(nan|inf)\(\) -> f64' "$provider")
if [ "$owner_f32" -ne 24 ] || [ "$provider_f64" -lt 24 ]; then
    echo "bootstrap math f32/canonical f64 conflict changed; generate typed thunks" >&2
    exit 1
fi

echo "bootstrap math SFFI contract audit: PASS (f32 thunks still required)"
