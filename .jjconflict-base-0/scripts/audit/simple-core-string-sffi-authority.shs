#!/bin/sh
set -eu

# Source-only authority and ABI gate for bootstrap string/Any primitives.
# This does not claim provider signatures are signed or semantically verified.

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
string="$root/src/runtime/simple_core/core_string.spl"
any_ops="$root/src/runtime/simple_core/core_any_ops.spl"
values="$root/src/runtime/simple_core/core_values.spl"
enum="$root/src/runtime/simple_core/core_enum.spl"
registry="$root/src/compiler_rust/compiler/src/codegen/runtime_sffi.rs"
rust_values="$root/src/compiler_rust/runtime/src/value/sffi/value_ops.rs"
runtime_h="$root/src/runtime/runtime.h"

check_owner() {
    module=$1
    expected=$2
    [ "$(grep -c '^extern fn ' "$module")" -eq "$expected" ]
    [ "$(grep -c '^@unsafe(' "$module")" -eq "$expected" ]
    [ "$(grep -c '^@unsafe(reason: .*contract:' "$module")" -eq "$expected" ]
}

check_owner "$string" 35
check_owner "$any_ops" 4
check_owner "$values" 8
check_owner "$enum" 5
[ "$(grep -c '^@always_inline$' "$any_ops")" -eq 4 ]
[ "$(grep -c '^[[:space:]]*unsafe(capabilities: \[ffi\]):$' "$any_ops")" -eq 4 ]
for raw in spl_bits_to_f64 rt_value_int rt_value_as_int rt_value_float; do
    # The only executable raw call is inside its smallest mandatory-inline
    # lexical unsafe thunk. Arithmetic and comparison bodies call the thunk.
    [ "$(grep -Ec "^[[:space:]]+${raw}\\(" "$any_ops")" -eq 1 ]
done
[ "$(grep -Ec '^[[:space:]]+rt_value_float\(' "$string")" -eq 1 ]
grep -q '^fn _sffi_value_float(value: f64) -> i64:$' "$string"
for raw in malloc calloc realloc free memcpy; do
    [ "$(grep -Ec "^[[:space:]]+${raw}\\(" "$string")" -eq 1 ]
    grep -q "^fn _sffi_${raw}(" "$string"
done
for raw in memcmp strtoll strtod strlen write read; do
    [ "$(grep -Ec "^[[:space:]]+${raw}\\(" "$string")" -eq 1 ]
    grep -q "^fn _sffi_${raw}(" "$string"
done
for raw in spl_load_i64 spl_store_i64 spl_load_u8 spl_store_u8; do
    [ "$(grep -Ec "^[[:space:]]+${raw}\\(" "$string")" -eq 1 ]
done
grep -q '^fn _sffi_load_i64(' "$string"
grep -q '^fn _sffi_store_i64(' "$string"
grep -q '^fn _sffi_load_u8(' "$string"
grep -q '^fn _sffi_store_u8(' "$string"
for raw in rt_array_len rt_array_len_safe rt_array_new \
    rt_array_new_with_cap_u64 rt_byte_array_new rt_array_push rt_array_get \
    array_is_valid array_items array_flags rt_dict_len rt_dict_contains \
    rt_value_int rt_value_as_int rt_enum_new rt_enum_discriminant rt_enum_id \
    rt_enum_payload rt_text_slice_audit_note_range; do
    [ "$(grep -Ec "^[[:space:]]+${raw}\\(" "$string")" -eq 1 ]
done
[ "$(grep -c '^@always_inline$' "$string")" -eq 35 ]
[ "$(grep -c '^[[:space:]]*unsafe(capabilities: \[ffi' "$string")" -eq 35 ]

grep -q '^extern fn rt_value_float(value: f64) -> i64$' "$string"
grep -q '^extern fn rt_value_float(value: f64) -> i64$' "$any_ops"
grep -q '^pub fn rt_value_float(value: f64) -> i64:$' "$values"
! grep -q 'rt_value_float(spl_f64_to_bits' "$string" "$any_ops"
grep -q 'RuntimeFuncSpec::new("rt_value_float", &\[F64\], &\[I64\])' "$registry"
grep -q 'pub extern "C" fn rt_value_float(f: f64)' "$rust_values"
grep -q 'int64_t  rt_value_float(double value_f64);' "$runtime_h"

for owner in "$values" "$enum"; do
    for raw in $(sed -n 's/^extern fn \([A-Za-z0-9_]*\).*/\1/p' "$owner"); do
        [ "$(grep -Ec "^[[:space:]]+${raw}\\(" "$owner")" -eq 1 ]
    done
done
[ "$(grep -c '^@always_inline$' "$values")" -eq 8 ]
[ "$(grep -c '^[[:space:]]*unsafe(capabilities: \[ffi' "$values")" -eq 8 ]
[ "$(grep -c '^@always_inline$' "$enum")" -eq 5 ]
[ "$(grep -c '^[[:space:]]*unsafe(capabilities: \[ffi' "$enum")" -eq 5 ]

echo "simple-core SFFI authority: PASS (52 declarations tagged and confined; exact f64 register class)"
