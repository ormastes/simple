#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/os/apps/sshd/ssh_session.spl"

if grep -E '(serial_println|_bytes_to_hex|extern fn rt_push_byte|extern fn rt_bytes_slice)' "$module" >/dev/null; then
    echo "SSH session regained raw diagnostics or per-byte/slice FFI" >&2
    exit 1
fi

grep -q '^@inline$' "$module"
grep -q '^fn rt_push_byte(arr: \[u8\], byte_val: i64) -> \[u8\]:' "$module"
grep -q '_append_byte(arr, byte_val.to_u8())' "$module"

calls=$(awk '
    !/^[[:space:]]*fn rt_push_byte/ {
        line = $0
        while (match(line, /rt_push_byte[(]/)) {
            calls += 1
            line = substr(line, RSTART + RLENGTH)
        }
    }
    END { print calls + 0 }
' "$module")
if [ "$calls" -ne 41 ]; then
    echo "SSH identification byte inventory changed" >&2
    exit 1
fi

grep -q '^extern fn rt_thread_sleep(ms: i64)$' "$module"
if grep -q '^extern fn rt_thread_sleep(ms: i64) ->' "$module"; then
    echo "SSH sleep ABI regained a fabricated return value" >&2
    exit 1
fi

grep -q 'server_version_text.len() == 0' "$module"
grep -q 'client_version_text.len() == 0' "$module"
grep -q 'sent < 0 or sent.to_u64() != data.len()' "$module"
grep -q 'max > 16777216u64' "$module"

unsafe_scopes=$(grep -c 'unsafe(capabilities: \[ffi\]):' "$module")
if [ "$unsafe_scopes" -ne 6 ]; then
    echo "SSH session lexical FFI scope inventory changed" >&2
    exit 1
fi

echo "SSH session boundary audit: PASS (41 byte FFI calls removed; diagnostics absent; void sleep ABI and I/O bounds enforced)"
