#!/bin/sh
# Keep counterpart dlopen/opaque-handle calls explicit and fail-closed.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
owner="$root/src/lib/nogc_sync_mut/sffi/counterpart_abi.spl"

declarations=$(grep -c '^extern fn rt_counterpart_' "$owner")
test "$declarations" -eq 9

tagged=$(awk '
    /^@unsafe\(.*capabilities: \[ffi\]\)$/ { previous = 1; next }
    /^extern fn rt_counterpart_/ { if (previous) tagged += 1 }
    { previous = 0 }
    END { print tagged + 0 }
' "$owner")
test "$tagged" -eq "$declarations"

awk '
    function indent(line, copy) { copy = line; sub(/[^ ].*$/, "", copy); return length(copy) }
    NF && depth >= 0 && $0 !~ /unsafe\(capabilities: \[ffi\]\):$/ && indent($0) <= depth { depth = -1 }
    /unsafe\(capabilities: \[ffi\]\):$/ { depth = indent($0); next }
    !/^[[:space:]]*#/ && !/^[[:space:]]*extern fn / && /rt_counterpart_[A-Za-z0-9_]+[(]/ {
        if (depth < 0 || indent($0) <= depth) { print "unscoped counterpart raw call: " NR > "/dev/stderr"; failed = 1 }
    }
    BEGIN { depth = -1 }
    END { if (failed) exit 1 }
' "$owner"

if grep -Eq 'rt_counterpart_(manifest|response|trace|last_error)_text\([^)]*\) \?\? ""' "$owner"; then
    echo 'counterpart boundary fabricates empty text from a missing foreign value' >&2
    exit 1
fi
if grep -Eq '^[[:space:]]*(sha256|verify_signature|dlsym|registry_lookup|ffi_call)\(' "$owner"; then
    echo 'counterpart hot path gained generic admission work' >&2
    exit 1
fi

echo 'counterpart ABI SFFI authority: PASS (9 scoped raw calls; no nil-to-empty coercion or call-time admission)'
