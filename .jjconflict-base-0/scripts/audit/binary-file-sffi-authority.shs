#!/bin/sh
set -eu

module=src/app/io/binary_file_ops.spl

test "$(rg '^extern fn rt_file_write_bytes' "$module" | wc -l)" -eq 0
test "$(rg 'rt_file_write_bytes\(' "$module" | wc -l)" -eq 0
test "$(rg 'file_write_bytes\(' "$module" | wc -l)" -eq 1
rg -q '^use std\.io_runtime\.\{file_write_bytes\}$' "$module"
