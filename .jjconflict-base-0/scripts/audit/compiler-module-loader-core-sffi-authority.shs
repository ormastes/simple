#!/bin/sh
set -eu

module=src/compiler/10.frontend/core/interpreter/module_loader_core.spl

if rg -q '^extern fn rt_(env_get|file_read_text|path_join)\(' "$module"; then
    echo "core module loader must not own raw env/file/path authority" >&2
    exit 1
fi
rg -q '^use std\.io_runtime\.\{env_get_opt, file_read_result\}$' "$module"
rg -q '^fn load_module_source\(file_path: text\) -> Result<text, text>:$' "$module"
test "$(rg -c 'file_read_result\(' "$module")" -eq 1
test "$(rg -c 'load_module_source\(' "$module")" -eq 4
test "$(rg -c 'env_get_opt\("SIMPLE_COMPILER_TRACE"\)' "$module")" -eq 1
test "$(rg -c 'gc_warning_trace_enabled\(' "$module")" -eq 3
rg -q '^    _gc_warning_trace_state = -1$' "$module"
test "$(rg -c 'case Err\(_\):' "$module")" -ge 3
