#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/os/apps/sshd/ssh_session_auth.spl"

if grep -E '(serial_println|^extern fn |_bytes_to_hex|format_hex_width)' "$module" >/dev/null; then
    echo "SSH authentication regained a raw or secret-formatting boundary" >&2
    exit 1
fi

grep -q 'if a.len() != b.len():' "$module"
grep -q 'while i < a.len():' "$module"
grep -q 'diff = diff | (a\[i\] \^ b\[i\])' "$module"
grep -q 'Password auth is disabled: do not copy the secret field' "$module"
grep -q 'attempts < MAX_AUTH_ATTEMPTS' "$module"
grep -q 'attempts = attempts + 1' "$module"

echo "SSH authentication boundary audit: PASS (Pure Simple auth logic; constant-time compare and bounded attempts retained; raw diagnostics absent)"
