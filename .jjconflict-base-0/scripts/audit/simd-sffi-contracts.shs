#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
owner="$root/src/lib/nogc_sync_mut/simd.spl"

declarations=$(grep -c -E '^[[:space:]]*extern fn (rt_simd_|rt_array_extend_i64)' "$owner")
if [ "$declarations" -ne 49 ]; then
    echo "SIMD declaration inventory changed without contract review" >&2
    exit 1
fi

tagged=$(awk '
    /^@unsafe\(.*capabilities: \[ffi\]\)$/ { previous_is_ffi = 1; next }
    /^[[:space:]]*extern fn (rt_simd_|rt_array_extend_i64)/ {
        if (previous_is_ffi) tagged++
    }
    { previous_is_ffi = 0 }
    END { print tagged + 0 }
' "$owner")
if [ "$tagged" -ne "$declarations" ]; then
    echo "every canonical SIMD declaration must be explicitly unsafe(ffi)" >&2
    exit 1
fi

echo "SIMD SFFI contract audit: PASS"
