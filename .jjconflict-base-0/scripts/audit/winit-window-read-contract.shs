#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
provider="$root/src/runtime/spl_winit/src/lib.rs"
interpreter="$root/src/compiler_rust/compiler/src/interpreter_extern/winit_sffi/winit_sffi_window.rs"
wrapper="$root/src/lib/nogc_sync_mut/io/window_winit.spl"

for symbol in rt_winit_window_inner_width rt_winit_window_inner_height \
    rt_winit_window_scale_factor_milli rt_winit_window_position_x \
    rt_winit_window_position_y; do
    if ! grep -B1 -F "extern fn $symbol" "$wrapper" | grep -Fq 'sentinel'; then
        echo "FAIL: $symbol lacks an exact raw failure contract" >&2
        exit 1
    fi
    if ! grep -Fq "\"$symbol\"" "$interpreter"; then
        echo "FAIL: interpreter does not implement native symbol $symbol" >&2
        exit 1
    fi
    if ! grep -Fq "fn $symbol(" "$provider"; then
        echo "FAIL: Rust provider does not export $symbol" >&2
        exit 1
    fi
done

if grep -Eq 'extern fn rt_winit_window_(get_size|scale_factor)\(' "$wrapper"; then
    echo 'FAIL: wrapper retains interpreter-only tuple/float ABI declarations' >&2
    exit 1
fi

for signature in \
    'fn winit_window_get_size(win: WinitWindow) -> (i64, i64)?' \
    'fn winit_window_scale_factor(win: WinitWindow) -> f64?' \
    'fn winit_window_get_position(win: WinitWindow) -> WinitWindowPosition?'; do
    if ! grep -Fq "$signature" "$wrapper"; then
        echo "FAIL: typed absence missing for $signature" >&2
        exit 1
    fi
done

size_body=$(sed -n '/^fn winit_window_get_size(/,/^$/p' "$wrapper")
scale_body=$(sed -n '/^fn winit_window_scale_factor(/,/^$/p' "$wrapper")
position_body=$(sed -n '/^fn winit_window_get_position(/,/^$/p' "$wrapper")
for item in "size:2:$size_body" "scale:1:$scale_body" "position:2:$position_body"; do
    name=${item%%:*}
    rest=${item#*:}
    expected=${rest%%:*}
    body=${rest#*:}
    calls=$(printf '%s\n' "$body" | grep -c 'rt_winit_' || true)
    if [ "$calls" -ne "$expected" ]; then
        echo "FAIL: $name wrapper changed native read count ($calls != $expected)" >&2
        exit 1
    fi
    if ! printf '%s\n' "$body" | grep -Fq 'unsafe(capabilities: [ffi]):'; then
        echo "FAIL: $name wrapper lacks lexical FFI scope" >&2
        exit 1
    fi
    if printf '%s\n' "$body" | grep -Eq 'alloc|mutex|hash|dlsym|last_error|retry'; then
        echo "FAIL: $name wrapper gained allocation, lookup, lock, hash, error-query, or retry work" >&2
        exit 1
    fi
done

echo 'PASS: Winit reads use the native scalar ABI, typed absence, and unchanged memory/call shape'
