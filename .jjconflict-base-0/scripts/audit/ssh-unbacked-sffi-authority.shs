#!/bin/sh
# Static containment gate for the intentionally unbacked legacy SSH facade.
# It proves only explicit unsafe authority and direct-call shape, not safety.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
source="$root/src/lib/nogc_sync_mut/io/ssh_sffi.spl"

test "$(grep -Ec '^extern fn rt_(ssh|sftp)_' "$source")" -eq 23
test "$(grep -Ec '^@unsafe\(reason: "unbacked (SSH|SFTP)' "$source")" -eq 43

raw_calls=$(awk '
    /unsafe\(capabilities: \[ffi\]\):/ { pending=1; next }
    pending && /^[[:space:]]+rt_(ssh|sftp)_/ { count++; pending=0; next }
    pending { pending=0 }
    END { print count + 0 }
' "$source")
test "$raw_calls" -eq 23

if grep -Eq 'rt_alloc|dlsym|CString|HashMap|mutex' "$source"; then
    echo 'unbacked SSH facade gained explicit allocation, lookup, or lock work' >&2
    exit 1
fi

echo 'Unbacked SSH SFFI authority: PASS raw_declarations=23 lexical_raw_calls=23 public_wrappers=unsafe provider_admission=absent'
