#!/bin/sh
set -eu

module=src/compiler/70.backend/backend/mir_target_context_provider.spl
facade=src/lib/nogc_sync_mut/io_runtime.spl

if rg -q '^extern fn rt_' "$module"; then
    echo "MIR target context must use canonical runtime facades" >&2
    exit 1
fi

rg -q '^use std\.io_runtime\.\{env_get_opt\}$' "$module"
test "$(rg -c 'env_get_opt\("SIMPLE_NATIVE_BUILD_TARGET"\)' "$module")" -eq 2
if rg -q 'unsafe\(capabilities: \[ffi\]\)' "$module"; then
    echo "MIR target context must not regain local FFI authority" >&2
    exit 1
fi
rg -Uq '@always_inline\npub fn env_get_opt\(key: text\) -> text\?:' "$facade"
