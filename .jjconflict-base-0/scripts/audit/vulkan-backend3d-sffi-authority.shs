#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
owner="$root/src/lib/nogc_sync_mut/engine/render/vulkan_backend3d.spl"

if [ "$(grep -c '^[[:space:]]*unsafe(capabilities: \[ffi\]):' "$owner")" -ne 18 ]; then
    echo "VulkanBackend3D lexical authority inventory changed without review" >&2
    exit 1
fi

awk '
    function finish_method() {
        if (method_has_call && !method_has_scope) {
            print "VulkanBackend3D method has raw calls without a leading lexical FFI scope: " method > "/dev/stderr"
            failed = 1
        }
    }
    /^[[:space:]]*(fn|me|static fn) / {
        finish_method()
        method = $0
        method_has_call = 0
        method_has_scope = 0
        in_method = 1
        next
    }
    in_method && /^[[:space:]]*unsafe\(capabilities: \[ffi\]\):/ {
        method_has_scope = 1
    }
    in_method && !/^[[:space:]]*#/ && /rt_vulkan_[A-Za-z0-9_]+\(/ {
        method_has_call = 1
    }
    END {
        finish_method()
        if (failed) exit 1
    }
' "$owner"

calls=$(awk '
    !/^[[:space:]]*#/ {
        line = $0
        while (match(line, /rt_vulkan_[A-Za-z0-9_]+\(/)) {
            calls += 1
            line = substr(line, RSTART + RLENGTH)
        }
    }
    END { print calls + 0 }
' "$owner")
if [ "$calls" -ne 64 ]; then
    echo "VulkanBackend3D raw-call inventory changed without review" >&2
    exit 1
fi

grep -q 'width <= 0 or height <= 0 or width > 8192 or height > 8192' "$owner"
if [ "$(grep -c 'byte_count <= 0 or byte_count > 268435456' "$owner")" -ne 3 ]; then
    echo "VulkanBackend3D buffer allocation bounds changed without review" >&2
    exit 1
fi
grep -q '^impl VulkanRenderBackend3D:' "$owner"

echo "VulkanBackend3D SFFI authority audit: PASS (64 calls in 18 narrow lexical scopes; frame, texture, buffer, and upload preconditions retained)"
