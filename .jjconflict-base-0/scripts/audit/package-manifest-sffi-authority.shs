#!/bin/sh
set -eu

installer=src/app/pkg/install.spl
manifest=src/app/pkg/manifest.spl

test "$(rg '^extern fn rt_file_read_text' "$installer" "$manifest" | wc -l)" -eq 0
test "$(rg 'rt_file_read_text\(' "$installer" "$manifest" | wc -l)" -eq 0
rg -q '^fn parse_manifest_file.*Result<PackageManifest, text>:' "$manifest"
rg -q 'read_file_text_result\(path\)' "$manifest"
rg -q '^fn _read_package_source.*Result<text, text>:' "$installer"

# Manifest parsing and each mutation command use one typed read and no
# existence/read double syscall in their source-loading blocks.
parse_body="$(sed -n '/^fn parse_manifest_file/,/^# Generate package/p' "$manifest")"
test "$(printf '%s\n' "$parse_body" | rg 'read_file_text_result\(' | wc -l)" -eq 1
test "$(printf '%s\n' "$parse_body" | rg 'file_exists\(' | wc -l)" -eq 0
