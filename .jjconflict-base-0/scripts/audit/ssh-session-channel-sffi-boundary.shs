#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/os/apps/sshd/ssh_session_channel.spl"

if grep -E '(serial_println|^extern fn rt_push_byte|^extern fn rt_bytes_|rt_bytes_(concat|slice|u8_at)\()' "$module" >/dev/null; then
    echo "SSH channel regained diagnostics or raw byte-array operations" >&2
    exit 1
fi

externs=$(grep -c '^extern fn ' "$module")
scopes=$(grep -c 'unsafe(capabilities: \[' "$module")
if [ "$externs" -ne 6 ] || [ "$scopes" -ne 6 ]; then
    echo "SSH channel foreign-boundary inventory changed" >&2
    exit 1
fi

grep -q 'data.len() > 0u64 and lifted.len() == 0u64' "$module"
grep -q 'payload.push(94u8)' "$module"
grep -q 'reverse_digits.push' "$module"
grep -q 'out.push(reverse_digits\[digit_index\])' "$module"
grep -q 'path_bytes.slice(start, n)' "$module"
grep -q 'payload.slice(path_start, command_end)' "$module"
grep -q 'buf > 18446744073709551615u64 - fsize.to_u64()' "$module"
grep -q 'n != fsize' "$module"

for provider in simpleos_fat32_stream_open simpleos_fat32_stream_read_at simpleos_fat32_path_read_buffer_addr mmio_read8; do
    grep -q "extern fn $provider" "$module"
done

echo "SSH channel boundary audit: PASS (byte/control paths are Pure Simple; text, FAT, MMIO, and sleep calls are minimally scoped and checked)"
