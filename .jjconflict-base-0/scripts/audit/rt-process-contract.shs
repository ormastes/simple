#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
binding="$root/src/app/io/process_ops.spl"
lib_binding="$root/src/lib/nogc_sync_mut/io/process_ops.spl"
runtime="$root/src/compiler_rust/runtime/src/value/sffi/env_process.rs"
interpreter="$root/src/compiler_rust/compiler/src/interpreter_extern/system.rs"
io_runtime="$root/src/lib/nogc_sync_mut/io_runtime.spl"

symbols='rt_process_run rt_process_run_bounded rt_process_run_inherit rt_process_run_timeout rt_process_spawn_async rt_process_spawn_inherit rt_process_wait rt_process_is_running rt_process_kill'
for symbol in $symbols; do
    grep -B1 -F "extern fn $symbol" "$binding" |
        grep -Eq 'sentinel|status'
done

# io_runtime stays direct because cross-module aliases currently de-JIT this
# hot module. Keep each duplicate declaration explicit and locally confined.
test "$(grep -c '^extern fn rt_process_' "$io_runtime")" -eq 5
test "$(grep -c '^fn _io_runtime_process_.*_raw' "$io_runtime")" -eq 5
test "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$io_runtime")" -eq 5
for symbol in rt_process_run rt_process_spawn_async rt_process_is_running rt_process_kill rt_process_run_timeout; do
    grep -B1 -F "extern fn $symbol" "$io_runtime" | grep -Eq 'sentinel|status|failure'
done
! grep -q '_io_runtime_process_.*_owner' "$io_runtime"

# One lexical scope per raw process contract. The separate checked file-read
# bridge accounts for the tenth FFI scope in this module.
test "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$binding")" -eq 10
test "$(grep -c '^fn _process_.*_raw' "$binding")" -eq 9

lib_symbols='rt_process_run rt_process_run_bounded rt_process_is_running rt_process_spawn_async rt_process_wait rt_process_kill rt_process_spawn_piped rt_process_write_stdin rt_process_write_stdin_some rt_process_read_stdout rt_process_is_alive rt_process_close_piped'
for symbol in $lib_symbols; do
    grep -B1 -F "extern fn $symbol" "$lib_binding" |
        grep -Eq 'sentinel|status'
done

# The library owner confines every raw call to one allocation-free lexical
# wrapper. Live relay reads only newly appended ranges, avoiding quadratic
# whole-file rereads as output grows.
test "$(grep -c '^fn _process_.*_raw' "$lib_binding")" -eq 12
test "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$lib_binding")" -eq 12
grep -q 'file_read_text_at(stdout_file, stdout_relayed, out_size - stdout_relayed)' "$lib_binding"
grep -q 'file_read_text_at(stderr_file, stderr_relayed, err_size - stderr_relayed)' "$lib_binding"
! grep -q 'val current = rt_file_read_text(stdout_file)' "$lib_binding"
! grep -q 'val current_err = rt_file_read_text(stderr_file)' "$lib_binding"

for wrapper in $(grep '^fn _process_.*_raw' "$lib_binding" | sed 's/(.*//; s/^fn //'); do
    body=$(sed -n "/^fn $wrapper(/,/^$/p" "$lib_binding")
    test "$(printf '%s\n' "$body" | grep -c 'unsafe(capabilities: \[ffi\]):')" -eq 1
    ! printf '%s\n' "$body" | grep -Eq 'Array|Dict|sleep\(|\.push\('
done

# Successful publication performs the existing single lock+insert. Failure
# must kill and reap before returning -1; it must never publish an untracked PID.
for source in "$runtime" "$interpreter"; do
    grep -q 'fn publish_spawned_' "$source"
    grep -q 'let _ = child.kill();' "$source"
    grep -q 'let _ = child.wait();' "$source"
done
test "$(grep -c 'publish_spawned_child(&SPAWNED_CHILDREN, child)' "$runtime")" -eq 3
test "$(grep -c 'publish_spawned_process(&SPAWNED_PROCESSES, child)' "$interpreter")" -eq 1
! grep -q 'SPAWNED_CHILDREN.lock().*insert(pid, child)' "$runtime"
! grep -q 'SPAWNED_PROCESSES.lock().unwrap().insert(pid, child)' "$interpreter"

# Malformed arrays fail closed before spawn instead of silently omitting args.
grep -q 'async_spawn_rejects_non_text_arguments' "$runtime"
grep -q 'async_spawn_rejects_non_text_arguments' "$interpreter"
grep -q 'rt_process_spawn_async: every argument must be a string' "$interpreter"

# Keep the publication helper allocation-free and at one registry lock.
for source in "$runtime" "$interpreter"; do
    body=$(sed -n '/^fn publish_spawned_/,/^}/p' "$source")
    test "$(printf '%s\n' "$body" | grep -c '\.lock()')" -eq 1
    ! printf '%s\n' "$body" | grep -Eq 'Box::|Vec::|HashMap::|sleep\('
done

echo 'rt process contract: PASS'
