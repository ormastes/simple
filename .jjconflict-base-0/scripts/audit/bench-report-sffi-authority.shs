#!/bin/sh
# Static raw-file-read elimination guard for benchmark report persistence.
# This checks source shape only; it does not admit, sign, or verify a provider.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/app/test/bench/bench_report.spl"

test "$(grep -c '^extern fn rt_file_read_text' "$module")" -eq 0
test "$(grep -c '^use std.io_runtime.{read_file_text_result}$' "$module")" -eq 1
test "$(grep -c 'read_file_text_result(table_path)' "$module")" -eq 2
test "$(grep -c 'ERROR reading existing metrics' "$module")" -eq 2
test "$(grep -c 'return false' "$module")" -ge 1

echo 'Benchmark report SFFI authority: PASS local_raw_declarations=0 result_lifts=2 history_overwrite_on_read_failure=blocked artifact_admission=absent'
