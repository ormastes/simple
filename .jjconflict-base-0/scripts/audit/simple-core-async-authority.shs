#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/runtime/simple_core/core_async.spl"
array_provider="$root/src/runtime/simple_core/core_array.spl"
cranelift="$root/src/compiler_rust/compiler/src/codegen/instr/calls.rs"
llvm="$root/src/compiler_rust/compiler/src/codegen/llvm/functions/calls.rs"
llvm_attrs="$root/src/compiler_rust/compiler/src/codegen/llvm/backend_core.rs"
selfhost_inline="$root/src/compiler/60.mir_opt/mir_opt/_Inline/policy.spl"

for raw in calloc free spl_load_i64 spl_store_i64 rt_array_new rt_array_len \
    rt_array_get rt_array_push abort; do
    [ "$(grep -Ec "^extern fn ${raw}\\(" "$module")" -eq 1 ]
    [ "$(grep -Ec "^[[:space:]]+${raw}\\(" "$module")" -eq 1 ]
done

[ "$(grep -c '^@unsafe(' "$module")" -eq 9 ]
[ "$(grep -c '^@always_inline$' "$module")" -eq 9 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi, raw_ptr\]):' "$module")" -eq 4 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$module")" -eq 5 ]
for expected in _sffi_calloc:2 _sffi_free:2 _sffi_load_i64:2 \
    _sffi_store_i64:2 _sffi_array_new:2 _sffi_array_len:3 \
    _sffi_array_get:4 _sffi_array_push:2 _sffi_abort:4; do
    owner=${expected%%:*}
    count=${expected##*:}
    [ "$(grep -o "${owner}(" "$module" | wc -l)" -eq "$count" ]
done

grep -A3 'if future < 1:' "$module" | grep -q '_sffi_abort()'
grep -A3 'if results < 1:' "$module" | grep -q '_sffi_abort()'
grep -A2 'if _sffi_array_push' "$module" | grep -q '_sffi_abort()'
for helper in rt_array_new rt_array_len rt_array_get rt_array_push; do
    grep -Eq "^pub fn ${helper}\\(" "$array_provider"
done
for intrinsic in spl_load_i64 spl_store_i64; do
    grep -q "\"$intrinsic\"" "$cranelift"
    grep -q "\"$intrinsic\"" "$llvm"
done
grep -q 'attr == "inline" || attr == "always_inline"' "$llvm_attrs"
grep -q 'func.name.contains("@always_inline")' "$selfhost_inline"

echo "simple-core async authority audit: PASS (raw calls confined; allocation and push failures trap)"
