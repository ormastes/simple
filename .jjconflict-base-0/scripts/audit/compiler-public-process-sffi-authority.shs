#!/bin/sh
set -eu

module=src/compiler/80.driver/driver_public_compile_process.spl

test "$(rg -c '^extern fn rt_(process_run|file_exists|file_read_text)' "$module")" -eq 3
test "$(rg -c '^fn _public_compile_(process|exists|read)_raw' "$module")" -eq 3
test "$(rg -c 'unsafe\(capabilities: \[ffi\]\):' "$module")" -eq 3
rg -q '^extern fn rt_file_read_text\(path: text\) -> text\?$' "$module"

for symbol in rt_process_run rt_file_exists rt_file_read_text; do
    test "$(rg -c "${symbol}\\(" "$module")" -eq 2
done

test "$(rg -c '_public_compile_process_raw\(' "$module")" -eq 5
test "$(rg -c '_public_compile_exists_raw\(' "$module")" -eq 3
test "$(rg -c '_public_compile_read_raw\(' "$module")" -eq 2
