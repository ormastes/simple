#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/compiler/10.frontend/core/_Ast/decl_nodes.spl"
registry="$root/src/compiler_rust/compiler/src/codegen/runtime_sffi.rs"
interpreter="$root/src/compiler_rust/compiler/src/interpreter_extern/mod.rs"
llvm_attrs="$root/src/compiler_rust/compiler/src/codegen/llvm/backend_core.rs"
selfhost_inline="$root/src/compiler/60.mir_opt/mir_opt/_Inline/policy.spl"

for raw in rt_env_get rt_env_get_i64 rt_env_set rt_env_remove; do
    [ "$(grep -Ec "^extern fn ${raw}\\(" "$module")" -eq 1 ]
    [ "$(grep -Ec "^[[:space:]]+(if not )?${raw}\\(" "$module")" -eq 1 ]
    grep -q "RuntimeFuncSpec::new(\"$raw\"" "$registry"
    grep -q "insert_simple!(\"$raw\"" "$interpreter"
done

grep -q '^extern fn rt_env_get(key: text) -> text?$' "$module"
[ "$(grep -c '^@unsafe(' "$module")" -eq 4 ]
[ "$(grep -c '^@always_inline$' "$module")" -eq 4 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$module")" -eq 4 ]
[ "$(grep -o '_sffi_env_get(' "$module" | wc -l)" -eq 10 ]
[ "$(grep -o '_sffi_env_get_i64(' "$module" | wc -l)" -eq 5 ]
[ "$(grep -o '_sffi_env_set_required(' "$module" | wc -l)" -eq 6 ]
[ "$(grep -o '_sffi_env_remove_required(' "$module" | wc -l)" -eq 6 ]

grep -q 'declaration environment mirror write failed' "$module"
grep -q 'declaration environment mirror removal failed' "$module"

# Normal compiled builds use the arena and do not enter the legacy mirror.
# Mandatory-inline mutation checks add only a status branch to an existing
# environment syscall on the bootstrap fallback; no extra scan/allocation is
# added to arena accessors or declaration loops.
grep -q 'var ast_decl_mode_cached: i64 = 1' "$module"
grep -q 'attr == "inline" || attr == "always_inline"' "$llvm_attrs"
grep -q 'func.name.contains("@always_inline")' "$selfhost_inline"

echo "AST declaration-node SFFI authority audit: PASS (4 env ABIs confined; nullable reads truthful; legacy mirror mutations fail closed; arena-preferred hot path unchanged)"
