#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/os/kernel/boot/http_baremetal.spl"
facade="$root/src/os/kernel/net/rt_net_socket_facade.spl"
registry="$root/src/compiler_rust/compiler/src/codegen/runtime_sffi.rs"
interpreter="$root/src/compiler_rust/compiler/src/interpreter_extern/mod.rs"

# HTTP consumes the canonical pure-Simple socket owner. It must not duplicate
# exported socket or logging ABIs locally.
[ "$(grep -c '^extern fn ' "$module")" -eq 1 ]
grep -q '^extern fn rt_string_from_byte_array' "$module"
! grep -q '^extern fn rt_net_' "$module"
! grep -q '^extern fn log_raw_println' "$module"
grep -q '^use os.kernel.log.klog_api.{log_raw_println}' "$module"
grep -q '^use os.kernel.net.rt_net_socket_facade.{' "$module"

# The remaining lift is lexical unsafe and rejects a non-empty-to-empty
# contract failure without copying the input or changing valid text results.
[ "$(grep -c '^@unsafe(reason: "raw runtime byte-array to text lift;' "$module")" -eq 1 ]
grep -B1 -q '^@always_inline$' "$module"
grep -q '^fn _http_text_from_bytes(data: \[u8\]) -> Result<text, text>:' "$module"
[ "$(grep -c '^[[:space:]]*lifted = rt_string_from_byte_array(data)' "$module")" -eq 1 ]
grep -q 'if lifted.len() == 0u64:' "$module"

# Canonical recv bounds remain enforced by the socket owner. HTTP preserves
# its existing bounded loop constants and now observes both exact send results.
grep -q 'if max_len <= 0 or max_len > RT_NET_SOCKET_READ_MAX:' "$facade"
grep -q 'if bytes.len() > max_len.to_u64():' "$facade"
[ "$(grep -c 'val send_rc = rt_net_send_bytes' "$module")" -eq 2 ]
[ "$(grep -c 'if send_rc < 0:' "$module")" -eq 2 ]
[ "$(grep -c 'val _ = rt_net_close(sock_fd)' "$module")" -eq 2 ]
grep -q 'val HTTP_MAX_RECV_ITERATIONS: i64 = 64' "$module"
grep -q 'val HTTP_MAX_KEEPALIVE_REQUESTS: i64 = 32' "$module"

! grep -q 'RuntimeFuncSpec::new("rt_string_from_byte_array"' "$registry"
grep -q 'insert_simple!("rt_string_from_byte_array"' "$interpreter"

echo "Bare-metal HTTP SFFI authority audit: PASS (7 socket/1 logger declarations removed for canonical Pure Simple owners; 1 text lift lexical unsafe/mandatory-inline; 2 exact-send failures checked; 2 listener-failure closes added; recv/keepalive bounds retained; 1 interpreter-only text provider)"
