#!/bin/sh
# Keep Intel Engine2D raw ABI declarations in the canonical no-GC SFFI owner.
# The runtime source is not signed/admitted; this is ownership evidence only.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
owner="$root/src/lib/nogc_sync_mut/gpu/engine2d/sffi_intel.spl"
compat="$root/src/lib/nogc_sync_mut/gpu/engine2d/ffi_intel.spl"
consumer="$root/src/lib/gc_async_mut/gpu/engine2d/backend_intel_kernels.spl"

raw_count=$(grep -c '^extern fn rt_intel_' "$owner")
unsafe_count=$(grep -B1 '^extern fn rt_intel_' "$owner" | grep -c '@unsafe')
test "$raw_count" -eq 21
test "$unsafe_count" -eq "$raw_count"
compat_raw_count=$(grep -c '^extern fn rt_intel_' "$compat")
compat_unsafe_count=$(grep -B1 '^extern fn rt_intel_' "$compat" | grep -c '@unsafe')
test "$compat_raw_count" -eq "$raw_count"
test "$compat_unsafe_count" -eq "$compat_raw_count"
test "$(grep -c '^extern fn rt_intel_' "$consumer" || true)" -eq 0
grep -q 'std.nogc_sync_mut.gpu.engine2d.sffi_intel' "$consumer"

echo 'Intel Engine2D SFFI owner authority: PASS (42 tagged raw declarations; consumer has none)'
