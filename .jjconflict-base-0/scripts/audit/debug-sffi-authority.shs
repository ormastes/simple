#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
facade="$root/src/lib/nogc_sync_mut/sffi/debug.spl"
provider="$root/src/compiler_rust/runtime/src/debug.rs"

if [ "$(grep -c '^extern fn ' "$facade")" -ne 43 ] ||
   [ "$(grep -c '^@unsafe(.*capabilities: \[ffi\])$' "$facade")" -ne 44 ]; then
    echo "debug SFFI declaration/function authority inventory changed" >&2
    exit 1
fi
if [ "$(grep -c 'unsafe(capabilities: \[ffi\]):$' "$facade")" -ne 43 ]; then
    echo "debug SFFI lexical authority inventory changed" >&2
    exit 1
fi

calls=$(awk '
    !/^[[:space:]]*#/ && !/^[[:space:]]*extern fn / {
        line = $0
        while (match(line, /rt_(debug|ptrace|dwarf)_[A-Za-z0-9_]+[(]/)) {
            calls += 1
            line = substr(line, RSTART + RLENGTH)
        }
    }
    END { print calls + 0 }
' "$facade")
if [ "$calls" -ne 43 ]; then
    echo "debug SFFI raw-call inventory changed" >&2
    exit 1
fi

awk '
    /^extern fn / {
        name = $3
        sub(/[(].*$/, "", name)
        declared[name] = 1
    }
    /^export / {
        line = substr($0, 8)
        count = split(line, names, /,[[:space:]]*/)
        for (i = 1; i <= count; i += 1) {
            if (names[i] ~ /^rt_/ && !declared[names[i]]) {
                print "debug facade exports undeclared raw symbol: " names[i] > "/dev/stderr"
                failed = 1
            }
        }
    }
    END { if (failed) exit 1 }
' "$facade"

awk '
    function indent(line, copy) {
        copy = line
        sub(/[^ ].*$/, "", copy)
        return length(copy)
    }
    NF && unsafe_indent >= 0 &&
    $0 !~ /unsafe\(capabilities: \[ffi\]\):$/ && indent($0) <= unsafe_indent {
        unsafe_indent = -1
    }
    /unsafe\(capabilities: \[ffi\]\):$/ {
        unsafe_indent = indent($0)
        next
    }
    !/^[[:space:]]*#/ && !/^[[:space:]]*extern fn / &&
    /rt_(debug|ptrace|dwarf)_[A-Za-z0-9_]+[(]/ {
        if (unsafe_indent < 0 || indent($0) <= unsafe_indent) {
            print "debug raw call lacks lexical FFI authority: " NR ":" $0 > "/dev/stderr"
            failed = 1
        }
    }
    BEGIN { unsafe_indent = -1 }
    END { if (failed) exit 1 }
' "$facade"

grep -q 'extern fn rt_debug_add_breakpoint(file_ptr: i64, file_len: i64, line: i64) -> i64' "$facade"
grep -q 'extern fn rt_debug_remove_breakpoint(file_ptr: i64, file_len: i64, line: i64) -> i64' "$facade"
grep -q 'extern fn rt_debug_remove_all_breakpoints()' "$facade"
grep -q 'extern fn rt_debug_has_breakpoint(file_ptr: i64, file_len: i64, line: i64) -> i64' "$facade"
grep -q 'case _: panic("invalid debugger boolean discriminant")' "$facade"
if grep -q 'rt_debug_.*() != 0' "$facade"; then
    echo "debug boolean wrapper accepts invalid nonzero discriminants" >&2
    exit 1
fi

grep -q 'pub extern "C" fn rt_debug_has_breakpoint' "$provider"
if grep -q 'from_utf8_unchecked' "$provider"; then
    echo "debug provider bypasses UTF-8 validation" >&2
    exit 1
fi
if [ "$(grep -c 'let Ok(file_len) = usize::try_from(file_len)' "$provider")" -ne 3 ]; then
    echo "debug pointer/length providers lack checked extent conversion" >&2
    exit 1
fi

# These 29 declarations have no repository-owned provider. They remain raw,
# unsafe, and link-fail-closed; adding a provider requires ABI review here.
missing='rt_debug_get_step_mode rt_debug_set_step_start_depth rt_debug_get_step_start_depth rt_debug_is_paused rt_debug_wait_for_continue rt_debug_set_current_location rt_debug_current_column rt_debug_should_break rt_debug_push_frame rt_debug_pop_frame rt_debug_set_local rt_debug_set_global rt_debug_globals rt_debug_clear_locals rt_debug_clear_globals rt_ptrace_attach rt_ptrace_detach rt_ptrace_continue rt_ptrace_single_step rt_ptrace_wait_stop rt_ptrace_get_registers rt_ptrace_read_memory rt_ptrace_write_memory rt_dwarf_load rt_dwarf_free rt_dwarf_addr_to_line rt_dwarf_line_to_addr rt_dwarf_function_at rt_dwarf_locals_at'
definitions=$(mktemp)
trap 'rm -f "$definitions"' EXIT INT TERM
alternation=$(printf '%s\n' "$missing" | tr ' ' '|')
rg -n --glob '!**/vendor/**' --glob '!**/sffi/debug.spl' \
    "(^|[[:space:]])(pub[[:space:]]+)?(unsafe[[:space:]]+)?(extern[[:space:]]+\"C\"[[:space:]]+)?fn[[:space:]]+(${alternation})[(]" \
    "$root/src/compiler_rust" "$root/src/runtime" "$root/src/os" >"$definitions" || true
count=0
for symbol in $missing; do
    count=$((count + 1))
    if grep -E "fn[[:space:]]+${symbol}[(]" "$definitions" >/dev/null 2>&1; then
        echo "debug provider appeared without ABI/admission review: $symbol" >&2
        exit 1
    fi
done
if [ "$count" -ne 29 ]; then
    echo "debug missing-provider inventory changed" >&2
    exit 1
fi

if grep -E '^[[:space:]]*(sha256|verify_signature|dlsym|registry_lookup|ffi_call)\(' "$facade" >/dev/null; then
    echo "debug operation gained per-call admission or generic dispatch" >&2
    exit 1
fi

echo "debug SFFI authority audit: PASS (43 declarations/calls; 29 missing providers remain unsafe and link-fail-closed; breakpoint ABI and UTF-8 extents checked; direct dispatch preserved)"
