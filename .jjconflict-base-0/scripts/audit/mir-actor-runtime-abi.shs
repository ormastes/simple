#!/bin/sh
# Keep the MIR interpreter declarations identical to the generated actor ABI.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
bridge="$root/src/compiler/95.interp/mir_interp_runtime.spl"
registry="$root/src/compiler_rust/compiler/src/codegen/runtime_sffi.rs"

grep -q '^extern fn rt_actor_spawn(handler: i64, context: i64) -> i64$' "$bridge"
grep -q '^extern fn rt_actor_recv() -> i64$' "$bridge"
grep -q 'rt_actor_spawn(handler, 0)' "$bridge"
grep -q 'rt_actor_recv()' "$bridge"
grep -q 'RuntimeFuncSpec::new("rt_actor_spawn", &\[I64, I64\], &\[I64\])' "$registry"
grep -q 'RuntimeFuncSpec::new("rt_actor_recv", &\[\], &\[I64\])' "$registry"

echo 'MIR actor runtime ABI: PASS (spawn(handler, context), recv())'
