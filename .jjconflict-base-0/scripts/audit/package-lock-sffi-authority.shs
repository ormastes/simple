#!/bin/sh
set -eu

lock=src/app/pkg/lock.spl
installer=src/app/pkg/install.spl

test "$(rg '^extern fn rt_file_read_text' "$lock" | wc -l)" -eq 0
test "$(rg 'rt_file_read_text\(' "$lock" | wc -l)" -eq 0
rg -q '^fn parse_lock_file.*Result<LockFile\?, text>:' "$lock"
rg -q 'return Ok\(nil\)' "$lock"
rg -q 'Lock file is empty' "$lock"
test "$(rg -c 'match parse_lock_file\(lock_path\):' "$installer")" -eq 2

body="$(sed -n '/^fn parse_lock_file/,/^# Generate lock file/p' "$lock")"
test "$(printf '%s\n' "$body" | rg 'file_exists\(' | wc -l)" -eq 1
test "$(printf '%s\n' "$body" | rg 'read_file_text_result\(' | wc -l)" -eq 1
