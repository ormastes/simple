#!/bin/sh
# Convert a signed raw rendering bundle into the canonical 17-row manifest.
set -eu
LC_ALL=C; export LC_ALL
usage() { echo "usage: $0 --bundle DIR --output DIR --mode live|fixture --collector-public PEM --signing-key PEM --key-id ID --run-id ID --source-hash SHA256 --configuration-hash SHA256 --device ID --captured-at-utc-ns NS --valid-until-utc-ns NS --command-limit N --glyph-limit N --image-limit N --queue-limit N --inflight-limit N --frame-p95-ns N --frame-p99-ns N --frame-deadline-ns N --max-rss-bytes N" >&2; exit 2; }
bundle= out= mode= public= key= key_id= run= source= config= device= captured= valid=
command_limit= glyph_limit= image_limit= queue_limit= inflight_limit= p95_limit= p99_limit= deadline= rss_limit=
while [ "$#" -gt 0 ]; do case "$1" in
 --bundle) bundle=$2;; --output) out=$2;; --mode) mode=$2;; --collector-public) public=$2;; --signing-key) key=$2;; --key-id) key_id=$2;; --run-id) run=$2;; --source-hash) source=$2;; --configuration-hash) config=$2;; --device) device=$2;; --captured-at-utc-ns) captured=$2;; --valid-until-utc-ns) valid=$2;; --command-limit) command_limit=$2;; --glyph-limit) glyph_limit=$2;; --image-limit) image_limit=$2;; --queue-limit) queue_limit=$2;; --inflight-limit) inflight_limit=$2;; --frame-p95-ns) p95_limit=$2;; --frame-p99-ns) p99_limit=$2;; --frame-deadline-ns) deadline=$2;; --max-rss-bytes) rss_limit=$2;; *) usage;; esac; shift 2; done
fail() { echo "BLOCKED: $1" >&2; exit 1; }; regular() { [ -f "$1" ] && [ ! -L "$1" ]; }; hash() { sha256sum "$1"|awk '{print $1}'; }; hash_text() { printf '%s' "$1"|sha256sum|awk '{print $1}'; }; field() { [ "$(grep -c "^$1=" "$2")" -eq 1 ] || return 1; sed -n "s/^$1=//p" "$2"; }; uint() { case "$1" in ''|*[!0-9]*) return 1;; esac; }; token() { [ -n "$1" ] && case "$1" in *[!A-Za-z0-9._:-]*) return 1;; esac; }
[ "$mode" = live ] || [ "$mode" = fixture ] || usage
for n in "$captured" "$valid" "$command_limit" "$glyph_limit" "$image_limit" "$queue_limit" "$inflight_limit" "$p95_limit" "$p99_limit" "$deadline" "$rss_limit"; do uint "$n" || usage; done
for f in "$bundle/collector-manifest.env" "$bundle/collector-manifest.sig" "$public" "$key"; do regular "$f" || usage; done
openssl dgst -sha256 -verify "$public" -signature "$bundle/collector-manifest.sig" "$bundle/collector-manifest.env" >/dev/null 2>&1 || fail 'collector signature invalid'
m=$bundle/collector-manifest.env
[ "$(field manifest_schema "$m")" = mci-rendering-live-collector-v1 ] && [ "$(field artifact_mode "$m")" = "$mode" ] || fail 'collector mode/schema mismatch'
[ "$(field raw_vocabulary_schema "$m")" = mci-rendering-raw-v1 ] || fail 'raw vocabulary mismatch'
for pair in "run_id:$run" "source_hash:$source" "configuration_hash:$config" "device_identity:$device"; do k=${pair%%:*}; v=${pair#*:}; [ "$(field "$k" "$m")" = "$v" ] || fail "binding mismatch: $k"; done
[ "$mode" = fixture ] || [ "$(field release_eligible "$m")" = true ] || fail 'collector bundle is not live'
raw=$bundle/artifacts
names='packed.events packed.identity composition.bin gui.drawir web.drawir cpu.rgba device.rgba backend.env queue.env frame.rdc replay.log allocation.events queue.events inflight.events overflow.before overflow.after fallback.events drawir.entries transient-owner.env interaction.events perf.samples rss.bytes'
for name in $names; do regular "$raw/$name" || fail "missing raw artifact: $name"; declared=$(sed -n "s/^artifact=$name|//p" "$m"); [ -n "$declared" ] && [ "$(hash "$raw/$name")" = "$declared" ] || fail "unbound/tampered raw artifact: $name"; done
[ ! -e "$out" ] || fail 'output must be fresh'; mkdir -p "$out/artifacts" "$out/receipts"
emit_base() { echo evidence_id=$1; echo run_id=$run; echo source_hash=$source; echo configuration_hash=$config; }
count() { grep -c "^$1$" "$raw/packed.events"; }
generation=$(field generation "$raw/backend.env"); uint "$generation" && [ "$generation" -gt 0 ] || fail 'generation invalid'
arena=$(field arena_id "$raw/backend.env"); packed_hash=$(field composition_hash "$raw/backend.env"); token "$arena" && [ "$packed_hash" = "$(hash "$raw/composition.bin")" ] && [ -n "$(field packed_store_hash "$raw/backend.env")" ] && [ "$(field render_accepted "$raw/backend.env")" = true ] && [ "$(field queue_state "$raw/backend.env")" = published_taken_completed ] || fail 'packed frame lifecycle/hash binding invalid'
# The packed identity is a raw producer observation, not a trusted verdict.
# Recompute the composition digest, byte length, and exact store hash from the
# copied rows; a producer cannot make an arbitrary backend.env hash pass.
identity=$raw/packed.identity
[ "$(field packed_identity_schema "$identity")" = draw-ir-packed-identity-v3 ] || fail 'packed identity schema invalid'
identity_arena=$(field arena_id "$identity"); identity_generation=$(field generation "$identity"); identity_slot=$(field slot "$identity"); row_count=$(field row_count "$identity"); identity_bytes=$(field composition_bytes "$identity"); identity_composition=$(field composition_sha256 "$identity"); identity_packed=$(field packed_sha256 "$identity")
uint "$identity_arena" && uint "$identity_generation" && uint "$identity_slot" && uint "$row_count" && uint "$identity_bytes" || fail 'packed identity scalar invalid'
[ "$identity_arena" = "$arena" ] && [ "$identity_generation" = "$generation" ] && [ "$identity_slot" = 0 ] || fail 'packed identity generation binding invalid'
composition=$(hash "$raw/composition.bin"); [ "$identity_bytes" = "$(wc -c < "$raw/composition.bin" | tr -d ' ')" ] || fail 'packed identity byte length mismatch'; [ "$identity_composition" = "$composition" ] || fail 'packed identity composition hash mismatch'; [ "$packed_hash" = "$identity_composition" ] || fail 'backend composition hash mismatch'
row_lines=$(grep -c '^row\.' "$identity" || true); [ "$row_lines" -eq "$row_count" ] || fail 'packed identity row cardinality mismatch'
if grep '^row\.' "$identity" | grep -Ev '^row\.[0-9]+=[0-9]+$' >/dev/null; then fail 'packed identity row syntax invalid'; fi
canonical="draw-ir-packed-v3|arena=$identity_arena|generation=$identity_generation|rows=$row_count|"; row_index=0
while [ "$row_index" -lt "$row_count" ]; do row_value=$(field "row.$row_index" "$identity") || fail 'packed identity row missing'; uint "$row_value" || fail 'packed identity row invalid'; canonical="$canonical$row_value;"; row_index=$((row_index + 1)); done
[ "$identity_packed" = "$(hash_text "$canonical")" ] || fail 'packed identity store hash mismatch'; [ "$identity_packed" = "$(field packed_store_hash "$raw/backend.env")" ] || fail 'backend packed store hash mismatch'
gui_raw=$(hash "$raw/gui.drawir"); [ "$composition" = "$gui_raw" ] || fail 'GUI lowering differs from canonical composition'; grep -Fq 'drawir-unsupported-count=' "$raw/web.drawir" || fail 'Web lowerer receipt missing'; gui=$composition; web=$composition
cpu=$(hash "$raw/cpu.rgba"); dev=$(hash "$raw/device.rgba"); [ "$cpu" = "$dev" ] || fail 'device readback differs from CPU oracle'
commands=$(count command); glyphs=$(count glyph); images=$(count image)
[ "$commands" -le "$command_limit" ] && [ "$glyphs" -le "$glyph_limit" ] && [ "$images" -le "$image_limit" ] || fail 'packed bounds exceeded'
[ "$(dd if="$raw/frame.rdc" bs=4 count=1 2>/dev/null)" = RDOC ] || fail 'invalid RDOC bytes'
grep -Fqx replay_open=pass "$raw/replay.log" && grep -Fqx "generation=$generation" "$raw/replay.log" || fail 'replay correlation failed'
events=$(paste -sd, "$raw/interaction.events"); [ "$events" = focus,key_input,pointer_down,pointer_up,click ] || fail 'interaction sequence mismatch'
samples=$(paste -sd, "$raw/perf.samples"); computed=$(sort -n "$raw/perf.samples"|awk '{a[++n]=$1}END{if(n<2)exit 1;print a[int((95*n+99)/100)]" "a[int((99*n+99)/100)]" "a[n]}') || fail 'perf samples invalid'; set -- $computed; p95=$1; p99=$2; worst=$3; rss=$(cat "$raw/rss.bytes"); uint "$rss"; [ "$p95" -le "$p95_limit" ] && [ "$p99" -le "$p99_limit" ] && [ "$worst" -le "$deadline" ] && [ "$rss" -le "$rss_limit" ] || fail 'performance budget exceeded'
bound_row() { id=$1 file=$2 limit=$3; capacity=$(field capacity "$raw/$file"); admitted=$(field exact_admitted "$raw/$file"); rejected=$(field plus_one "$raw/$file"); reason=$(field plus_one_reason "$raw/$file"); [ "$capacity" = "$limit" ] && [ "$admitted" = 1 ] && [ "$rejected" = "$((limit+1))" ] && [ "$reason" = 1 ] || fail "$id bound/negative control invalid"; a=$out/artifacts/$id.env; { emit_base "$id"; echo used=$capacity; echo limit=$limit; echo negative_used=$rejected; echo negative_rejected=true; } > "$a"; }
write() { id=$1; shift; a=$out/artifacts/$id.env; { emit_base "$id"; printf '%s\n' "$@"; } > "$a"; }
write packed_generation "generation=$generation" "composition_sha256=$composition" state=sealed "command_count=$commands" "glyph_count=$glyphs" "image_count=$images"
write engine2d_owner "generation=$generation" "composition_sha256=$composition" owner=engine2d
write gui_parity "generation=$generation" "drawir_sha256=$gui"; write web_parity "generation=$generation" "drawir_sha256=$web"
write cpu_readback "pixel_sha256=$cpu" oracle=exact; write device_readback "pixel_sha256=$dev" matches_cpu_exact=true
backend=$(field backend "$raw/backend.env"); [ "$backend" = vulkan ] || fail 'backend is not Vulkan'; write backend_device "device_identity=$device" synthetic=false
qid=$(field queue_id "$raw/queue.env"); sid=$(field submit_id "$raw/queue.env"); fid=$(field fence_id "$raw/queue.env"); token "$qid"&&token "$sid"&&token "$fid" || fail 'queue identity invalid'; write queue_submit_fence "generation=$generation" "queue_id=$qid" "submit_id=$sid" "fence_id=$fid" fence_signaled=true
cp "$raw/frame.rdc" "$out/artifacts/frame.rdc"; cp "$raw/replay.log" "$out/artifacts/replay.log"; write renderdoc rdc_path=artifacts/frame.rdc replay_transcript_path=artifacts/replay.log
bound_row allocation_bounds allocation.events "$command_limit"; bound_row queue_bounds queue.events "$queue_limit"; bound_row inflight_bounds inflight.events "$inflight_limit"
before=$(hash "$raw/overflow.before"); after=$(hash "$raw/overflow.after"); [ "$before" = "$after" ] || fail 'overflow changed active state'; write overflow_rejection "active_state_before_sha256=$before" "active_state_after_sha256=$after" publication_count=0
fallbacks=$(grep -c . "$raw/fallback.events" || true); [ "$fallbacks" -eq 0 ] || fail 'fallback observed'; write fallback_absence fallback_count=0
atlas=$(grep -c '^atlas$' "$raw/drawir.entries" || true); cache=$(grep -c '^cache$' "$raw/drawir.entries" || true); [ "$atlas" -eq 0 ] && [ "$cache" -eq 0 ] || fail 'DrawIR contains transient material'; uint "$(field atlas_upload_count "$raw/transient-owner.env")" && uint "$(field font_cache_identity_count "$raw/transient-owner.env")" || fail 'transient owner inventory invalid'; write atlas_absence drawir_atlas_entry_count=0 drawir_cache_entry_count=0
write interaction "generation=$generation" "events=$events" semantic_target_count=5
write latency_rss "sample_ns_csv=$samples" "p95_ns=$p95" "p99_ns=$p99" "max_rss_bytes=$rss" "deadline_negative_ns=$((deadline+1))" deadline_negative_rejected=true
ids='packed_generation engine2d_owner gui_parity web_parity cpu_readback device_readback backend_device queue_submit_fence renderdoc allocation_bounds queue_bounds inflight_bounds overflow_rejection fallback_absence atlas_absence interaction latency_rss'
manifest=$out/manifest.env
{ echo manifest_schema=mci-rendering-collector-manifest-v1; echo artifact_mode=$mode; echo run_id=$run; echo source_hash=$source; echo configuration_hash=$config; echo captured_at_utc_ns=$captured; echo valid_until_utc_ns=$valid; echo collector_key_id=$key_id; echo device_identity=$device; echo rdc_sha256=$(hash "$out/artifacts/frame.rdc"); echo replay_sha256=$(hash "$out/artifacts/replay.log");
 for id in $ids; do command="adapter:derive:$id"; c=$out/receipts/$id.command; { echo evidence_id=$id; echo command_id=mci-rendering-$id-v1; echo run_id=$run; echo source_hash=$source; echo configuration_hash=$config; echo command=$command; echo exit_code=0; } > "$c"; a=$out/artifacts/$id.env; echo "row=$id|pass|receipts/$id.command|$(hash "$c")|artifacts/$id.env|$(hash "$a")|signed_raw_adapter|recomputed|derived_negative"; done; } > "$manifest"
openssl dgst -sha256 -sign "$key" -out "$out/manifest.sig" "$manifest"
openssl pkey -in "$key" -pubout -out "$out/collector.pem" >/dev/null 2>&1
public_hash=$(hash "$out/collector.pem")
trust=$out/trust.env
{ echo policy_schema=mci-rendering-collector-trust-v1; echo scope=$mode; echo collector_key_id=$key_id; echo collector_key_sha256=$public_hash; echo load_profile=nominal-exact; echo frame_p95_ns=$p95_limit; echo frame_p99_ns=$p99_limit; echo frame_deadline_ns=$deadline; echo max_rss_bytes=$rss_limit; echo command_limit=$command_limit; echo glyph_limit=$glyph_limit; echo image_limit=$image_limit; echo queue_limit=$queue_limit; echo inflight_limit=$inflight_limit;
 for id in $ids; do printf 'adapter:derive:%s' "$id" | sha256sum | awk -v id="$id" '{print "command_"id"_sha256="$1}'; done; } > "$trust"
if [ "$mode" = fixture ]; then echo adapter_result=CONTRACT_ONLY; echo release_eligible=false; else echo adapter_result=PASS; echo release_eligible=true; fi
