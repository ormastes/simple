#!/bin/sh
# LLVM/clang toolchain selection for this repo. SOURCE this file, do not run it:
#
#   . scripts/setup/llvm-toolchain-env.shs
#
# Pins the repo's C compiler, C++ compiler and linker to LLVM 23 when it is
# available, falling back to the previously-pinned LLVM 20 and then to whatever
# bare `clang`/`cc` the host provides. Everything downstream keys off `CC`:
#
#   * scripts/check/check-c-runtime-compiles-push.shs   -- detect_cc() reads $CC first
#   * the Rust seed's native-build link driver           -- src/compiler_rust/common/src/
#                                                           platform/cc_detect.rs reads $CC/$CXX
#                                                           before any probing
#   * any CMake/Make under src/runtime/                  -- standard CC/CXX
#
# LLVM 23 is deployed here WITHOUT root as an extracted apt.llvm.org tree (the
# host has no passwordless sudo). SIMPLE_LLVM_ROOT points at that tree; a normal
# root install of the clang-23 packages puts the same binaries on PATH and this
# script finds them there too. Override the whole decision with
# SIMPLE_LLVM_VERSION=20 (or any installed major) before sourcing.
#
# On WINDOWS the release layout differs (no version-suffixed binaries at all);
# see the Windows branch immediately below, which short-circuits the Unix logic.
#
# See doc/07_guide/infra/toolchain/llvm_23_deploy_2026-08-21.md.

# ---------------------------------------------------------------------------
# Windows (MSVC-ABI) branch.  Placed FIRST because it must short-circuit: the
# official LLVM Windows releases ship UNSUFFIXED names only (clang.exe,
# clang++.exe, ld.lld.exe, lld-link.exe, llvm-config.exe).  There is no
# `clang-23` on Windows, so the version-suffixed `command -v clang-N` probe
# further down can never fire there and would fall through to "no versioned
# clang found".  Selection on Windows is therefore by PREFIX DIRECTORY, one per
# installed major, overridable via the SIMPLE_LLVM_WIN_ROOT_<major> vars.
#
# LLVM 23.1.0 lives on D: because C: is at 99% (23G free of 2.3T).  LLVM 18 is
# deliberately KEPT: the Rust seed's `llvm` cargo feature is still pinned to 18
# (inkwell publishes no llvm23-* feature) and
# scripts/setup/windows-msvc-bootstrap-env.shs pins that lane's PATH to the 18
# prefix on purpose -- llvm-sys 180 runs the FIRST llvm-config on PATH.  Do not
# source both files into the same shell expecting 23 to win there.
#
# Cross-platform impact: NONE.  The whole block is guarded on the existence of
# `<prefix>/bin/clang.exe`; on Linux/macOS no such path exists, the loop selects
# nothing, and every line below this block runs byte-identically to before.
: "${SIMPLE_LLVM_WIN_ROOT_23:=/d/llvm-23/clang+llvm-23.1.0-x86_64-pc-windows-msvc}"
: "${SIMPLE_LLVM_WIN_ROOT_21:=/c/dev/install/clang+llvm-21.1.3-x86_64-pc-windows-msvc}"
: "${SIMPLE_LLVM_WIN_ROOT_18:=/c/dev/install/clang+llvm-18.1.8-x86_64-pc-windows-msvc}"

_simple_win_root=""
_simple_win_major=""
# Auto-fallback is 23 then 18 only.  21.1.3 is installed and selectable with
# SIMPLE_LLVM_VERSION=21, but is deliberately NOT in the implicit order: 18 is
# the version this host's bootstrap lane already uses, so an unattended
# fallback must land there, not on a third major nothing is pinned to.
for _v in ${SIMPLE_LLVM_VERSION:-} 23 18; do
  [ -n "${_v}" ] || continue
  eval "_simple_win_try=\${SIMPLE_LLVM_WIN_ROOT_${_v}:-}"
  [ -n "${_simple_win_try}" ] || continue
  if [ -f "${_simple_win_try}/bin/clang.exe" ]; then
    _simple_win_root="${_simple_win_try}"
    _simple_win_major="${_v}"
    break
  fi
done
unset _simple_win_try

if [ -n "${_simple_win_root}" ]; then
  # Prepend the prefix's bin dir.  Load-bearing for the same reason as the
  # unsuffixed dir on Linux: the seed's native link step picks its linker by
  # probing PATH for a bare `ld.lld`
  # (src/compiler_rust/compiler/src/pipeline/native_project/linker.rs,
  # `use_direct_lld`) and never consults $CC/$LD for that decision.  Windows
  # release names are already unsuffixed, so one dir covers both roles.
  case ":${PATH}:" in
    *":${_simple_win_root}/bin:"*) : ;;
    *) PATH="${_simple_win_root}/bin:${PATH}"; export PATH ;;
  esac
  # Emit MIXED-style paths (D:/... ) for the tool variables, not MSYS-style
  # (/d/... ).  $CC is consumed by NATIVE processes -- the Rust seed's
  # src/compiler_rust/common/src/platform/cc_detect.rs returns std::env::var("CC")
  # verbatim and spawns it -- and MSYS2 does not path-convert arbitrary env vars
  # when spawning a native binary, so CreateProcess would be handed a literal
  # "/d/..." it cannot resolve.  Mixed style is understood by BOTH CreateProcess
  # and an MSYS shell.  ($PATH is converted by MSYS automatically, which is why
  # the PATH entry above is left in MSYS style.)
  _simple_win_bin="${_simple_win_root}/bin"
  if command -v cygpath >/dev/null 2>&1; then
    _simple_win_bin="$(cygpath -m "${_simple_win_root}/bin" 2>/dev/null || printf '%s' "${_simple_win_root}/bin")"
  fi
  CC="${_simple_win_bin}/clang.exe"
  CXX="${_simple_win_bin}/clang++.exe"
  export CC CXX
  # LD is the MSVC-ABI linker (lld-link), NOT ld.lld -- ld.lld is the ELF
  # linker and would be wrong for a windows-msvc target.  The bare `ld.lld`
  # the seed probes for is still reachable via the PATH entry above.
  if [ -f "${_simple_win_root}/bin/lld-link.exe" ]; then
    LD="${_simple_win_bin}/lld-link.exe"
    SIMPLE_LLD="${LD}"
    export LD SIMPLE_LLD
  fi
  if [ -f "${_simple_win_root}/bin/llvm-config.exe" ]; then
    LLVM_CONFIG="${_simple_win_bin}/llvm-config.exe"
    export LLVM_CONFIG
    _simple_win_prefix="$("${LLVM_CONFIG}" --prefix 2>/dev/null || true)"
    if [ -n "${_simple_win_prefix}" ]; then
      case "${_simple_win_major}" in
        23) LLVM_SYS_231_PREFIX="${_simple_win_prefix}"; export LLVM_SYS_231_PREFIX ;;
        22) LLVM_SYS_221_PREFIX="${_simple_win_prefix}"; export LLVM_SYS_221_PREFIX ;;
        21) LLVM_SYS_211_PREFIX="${_simple_win_prefix}"; export LLVM_SYS_211_PREFIX ;;
        20) LLVM_SYS_201_PREFIX="${_simple_win_prefix}"; export LLVM_SYS_201_PREFIX ;;
        18) LLVM_SYS_180_PREFIX="${_simple_win_prefix}"; export LLVM_SYS_180_PREFIX ;;
      esac
    fi
    unset _simple_win_prefix
  fi
  SIMPLE_LLVM_MAJOR="${_simple_win_major}"
  SIMPLE_LLVM_ROOT="${_simple_win_root}"
  export SIMPLE_LLVM_MAJOR SIMPLE_LLVM_ROOT
  unset _simple_win_root _simple_win_major _simple_win_bin _v
  # Sourced: stop here so the Unix probe below cannot override the pick or
  # print a spurious "no versioned clang found".  Same idiom as
  # scripts/setup/windows-msvc-bootstrap-env.shs.
  return 0 2>/dev/null || exit 0
fi
unset _simple_win_root _simple_win_major
# ---------------------------------------------------------------------------

# Local (non-root) LLVM 23 prefix, if it was deployed that way.
: "${SIMPLE_LLVM_ROOT:=/mnt/data/toolchains/llvm-23-root}"
if [ -x "${SIMPLE_LLVM_ROOT}/usr/bin/clang-23" ]; then
  # Two directories, both needed:
  #   usr/bin              -- version-suffixed names (clang-23, ld.lld-23, ...)
  #   usr/lib/llvm-23/bin  -- UNSUFFIXED names (clang, ld.lld, llvm-config)
  # The unsuffixed dir is load-bearing, not cosmetic. The seed's native link
  # step picks its linker by probing PATH for a bare `ld.lld`
  # (src/compiler_rust/compiler/src/pipeline/native_project/linker.rs:1972,
  # `use_direct_lld`) and never consults $CC/$LD for that decision. Without
  # this dir on PATH the C compiler is 23 while the actual link still runs the
  # host's bare ld.lld (18 here), which is exactly the split this pin exists to
  # remove. Ordering it ahead of /usr/bin is the no-root equivalent of
  # update-alternatives, and is scoped to shells that source this file rather
  # than changing the whole machine.
  for _d in "${SIMPLE_LLVM_ROOT}/usr/lib/llvm-23/bin" "${SIMPLE_LLVM_ROOT}/usr/bin"; do
    case ":${PATH}:" in
      *":${_d}:"*) : ;;
      *) PATH="${_d}:${PATH}"; export PATH ;;
    esac
  done
  unset _d
fi

# Preference order: explicit request, then 23, then the old 20 pin, then bare.
_simple_llvm_pick=""
for _v in ${SIMPLE_LLVM_VERSION:-} 23 20; do
  [ -n "${_v}" ] || continue
  if command -v "clang-${_v}" >/dev/null 2>&1; then
    _simple_llvm_pick="${_v}"
    break
  fi
done

if [ -n "${_simple_llvm_pick}" ]; then
  CC="clang-${_simple_llvm_pick}"
  CXX="clang++-${_simple_llvm_pick}"
  export CC CXX
  if command -v "ld.lld-${_simple_llvm_pick}" >/dev/null 2>&1; then
    LD="ld.lld-${_simple_llvm_pick}"
    SIMPLE_LLD="ld.lld-${_simple_llvm_pick}"
    export LD SIMPLE_LLD
  fi
  if command -v "llvm-config-${_simple_llvm_pick}" >/dev/null 2>&1; then
    LLVM_CONFIG="llvm-config-${_simple_llvm_pick}"
    export LLVM_CONFIG
    # llvm-sys reads LLVM_SYS_<major><minor>_PREFIX. Export the one matching the
    # picked major so an llvm-sys bump does not also need an env change.
    _simple_llvm_prefix="$("${LLVM_CONFIG}" --prefix 2>/dev/null || true)"
    if [ -n "${_simple_llvm_prefix}" ]; then
      case "${_simple_llvm_pick}" in
        23) LLVM_SYS_231_PREFIX="${_simple_llvm_prefix}"; export LLVM_SYS_231_PREFIX ;;
        22) LLVM_SYS_221_PREFIX="${_simple_llvm_prefix}"; export LLVM_SYS_221_PREFIX ;;
        20) LLVM_SYS_201_PREFIX="${_simple_llvm_prefix}"; export LLVM_SYS_201_PREFIX ;;
        18) LLVM_SYS_180_PREFIX="${_simple_llvm_prefix}"; export LLVM_SYS_180_PREFIX ;;
      esac
    fi
    unset _simple_llvm_prefix
  fi
  SIMPLE_LLVM_MAJOR="${_simple_llvm_pick}"
  export SIMPLE_LLVM_MAJOR
else
  echo "llvm-toolchain-env: no versioned clang found; leaving CC/CXX unset" >&2
fi
unset _simple_llvm_pick _v
