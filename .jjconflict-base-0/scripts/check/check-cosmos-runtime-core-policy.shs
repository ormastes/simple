#!/bin/sh
# Pure-Simple Cosmos runtime-core oracle, instrumentation, and ABI closure gate.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
SOURCE_DIR="$ROOT/src/os/kernel/arch/arm32/cosmos"
CORE_SOURCE="$SOURCE_DIR/cosmos_runtime_core.spl"
RUNTIME_SOURCE="$SOURCE_DIR/cosmos_runtime.c"
TEST_DIR="$ROOT/test/02_integration/os/cosmos"
CONTRACT_SOURCE="$TEST_DIR/cosmos_runtime_contract_test.c"
ORACLE_SOURCE="$TEST_DIR/cosmos_runtime_core_oracle.c"
EVIDENCE_DIR="$ROOT/build/coverage/cosmos-runtime-core"
SCRATCH=$(mktemp -d "${TMPDIR:-/tmp}/cosmos-runtime-core.XXXXXX")
trap 'case ${SCRATCH:-} in /tmp/cosmos-runtime-core.*|${TMPDIR:-/tmp}/cosmos-runtime-core.*) [ ! -d "$SCRATCH" ] || rm -r -- "$SCRATCH" ;; esac' EXIT HUP INT TERM

fail() {
    echo "FAIL cosmos-runtime-core: $*" >&2
    exit 1
}

blocked() {
    echo "BLOCKED cosmos-runtime-core: $*" >&2
    exit 2
}

for path in "$CORE_SOURCE" "$RUNTIME_SOURCE" "$CONTRACT_SOURCE" \
    "$ORACLE_SOURCE"; do
    [ -f "$path" ] || fail "missing input: $path"
done

AUDIT_SITES=$(grep -c '^val D_[A-Z0-9_]*: u32 = ' "$CORE_SOURCE")
[ "$AUDIT_SITES" -eq 13 ] ||
    fail "runtime-core decision audit is not exactly 13 sites"
grep -F 'val COSMOS_RUNTIME_CORE_OUTCOMES_REQUIRED: u64 = 0x03FFFFFFu64' \
    "$CORE_SOURCE" >/dev/null ||
    fail "runtime-core decision audit does not pin all 26 outcomes"
if grep -F '__builtin_clz' "$RUNTIME_SOURCE" >/dev/null; then
    fail "C shim still contains the migrated division implementation"
fi
grep -F 'return cosmos_runtime_core_copy(dst, src, n);' \
    "$RUNTIME_SOURCE" >/dev/null || fail "C memcpy shim bypasses Simple"
grep -F 'return cosmos_runtime_core_fill(dst, value, n);' \
    "$RUNTIME_SOURCE" >/dev/null || fail "C memset shim bypasses Simple"
grep -F '__attribute__((weak)) int __aeabi_idiv0' \
    "$RUNTIME_SOURCE" >/dev/null || fail "weak __aeabi_idiv0 ABI was lost"

# This check intentionally has no seed/static fallback: no admitted Stage 4
# means no executable evidence for the migrated owner.
SIMPLE_BIN=${SIMPLE_BIN:-$ROOT/bin/simple}
[ -x "$SIMPLE_BIN" ] || blocked "missing executable pure-Simple compiler"
BOOTSTRAP_STAGE3_FACADE_PATH="$ROOT/scripts/check/lib/bootstrap-stage3-provenance.shs"
STAGE4_PROVENANCE_HELPER_PATH="$ROOT/scripts/check/lib/stage4-candidate-provenance.shs"
export BOOTSTRAP_STAGE3_FACADE_PATH STAGE4_PROVENANCE_HELPER_PATH
. "$BOOTSTRAP_STAGE3_FACADE_PATH"
. "$STAGE4_PROVENANCE_HELPER_PATH"
SIMPLE_CANONICAL=$(bootstrap_stage3_canonical_file "$SIMPLE_BIN") ||
    blocked "cannot resolve pure-Simple compiler canonically"
SIMPLE_PROVENANCE=${SIMPLE_PROVENANCE:-${SIMPLE_CANONICAL}.provenance.env}
stage4_verify_candidate_provenance \
    "$SIMPLE_PROVENANCE" "$SIMPLE_CANONICAL" "$ROOT" ||
    blocked "admitted Stage-4 provenance is required"
case $($SIMPLE_CANONICAL --version 2>&1 || true) in
    *"Rust-built Simple binary is a bootstrap seed"*)
        blocked "a bootstrap seed cannot prove the pure-Simple runtime core" ;;
esac
SIMPLE_SHA256=$(sha256sum "$SIMPLE_CANONICAL" | awk '{print $1}')
PROVENANCE_SHA256=$(sha256sum "$SIMPLE_PROVENANCE" | awk '{print $1}')

CLANG=${CLANG:-clang}
LLD=${LLD:-ld.lld}
READELF=${READELF:-readelf}
for tool in "$CLANG" "$LLD" "$READELF" awk grep sed sort sha256sum; do
    command -v "$tool" >/dev/null 2>&1 || fail "missing tool: $tool"
done

CORE_EXPORTS='cosmos_runtime_core_copy
cosmos_runtime_core_fill
cosmos_runtime_core_udivmod
cosmos_runtime_core_unsigned_div0_value
cosmos_runtime_core_signed_div0_value
cosmos_runtime_core_coverage_reset
cosmos_runtime_core_coverage_mask
cosmos_runtime_core_coverage_required
cosmos_runtime_core_coverage_decisions'
CORE_DEPENDENCIES='cosmos_runtime_core_copy
cosmos_runtime_core_fill
cosmos_runtime_core_signed_div0_value
cosmos_runtime_core_udivmod
cosmos_runtime_core_unsigned_div0_value'

check_simple_object() {
    object=$1
    class=$2
    machine=$3
    symbols=$($READELF -sW "$object")
    header=$($READELF -hW "$object")

    printf '%s\n' "$header" | grep -Eq "Class:[[:space:]]+$class" ||
        fail "$object has wrong ELF class"
    printf '%s\n' "$header" | grep -Eq 'Type:[[:space:]]+REL' ||
        fail "$object is not relocatable"
    printf '%s\n' "$header" | grep -Eq "Machine:[[:space:]]+$machine" ||
        fail "$object has wrong machine"

    printf '%s\n' "$CORE_EXPORTS" | while IFS= read -r symbol; do
        printf '%s\n' "$symbols" |
            awk -v symbol="$symbol" \
                '$4 == "FUNC" && $5 == "GLOBAL" && $6 == "DEFAULT" &&
                 $7 != "UND" && $8 == symbol { count++ }
                 END { exit count != 1 }' ||
            fail "missing or duplicate Simple export: $symbol"
    done
    undefined=$(printf '%s\n' "$symbols" |
        awk '$7 == "UND" && $8 != "" { print $8 }' | LC_ALL=C sort -u)
    [ -z "$undefined" ] ||
        fail "unexpected Simple object dependency: $undefined"
    printf '%s\n' "$symbols" |
        awk '$7 != "UND" && ($8 == "main" || $8 == "_start" ||
             $8 == "__simple_main" || $8 ~ /^rt_/ || $8 ~ /^__aeabi_/ ||
             $8 ~ /^(memcpy|memmove|memset|memcmp|strlen|strcmp|strncmp|strncpy)$/) { bad = 1 }
             END { exit bad }' ||
        fail "Simple object defines a forbidden entry/libc/EABI symbol"
}

build_simple_object() {
    target=$1
    cache=$2
    output=$3
    SIMPLE_LIB="$ROOT/src" "$SIMPLE_CANONICAL" native-build \
        --backend llvm \
        --source "$SOURCE_DIR" \
        --entry-closure \
        --entry "$CORE_SOURCE" \
        --target "$target" \
        --emit-object \
        --no-mangle \
        --cache-dir "$cache" \
        -o "$output"
    stage4_verify_candidate_provenance \
        "$SIMPLE_PROVENANCE" "$SIMPLE_CANONICAL" "$ROOT" ||
        fail "compiler provenance changed during core emission"
    [ "$(sha256sum "$SIMPLE_CANONICAL" | awk '{print $1}')" = \
        "$SIMPLE_SHA256" ] || fail "compiler changed during core emission"
    [ "$(sha256sum "$SIMPLE_PROVENANCE" | awk '{print $1}')" = \
        "$PROVENANCE_SHA256" ] || fail "provenance changed during core emission"
}

build_simple_object x86_64-unknown-linux-gnu \
    "$SCRATCH/host-cache" "$SCRATCH/cosmos_runtime_core.host.o"
check_simple_object "$SCRATCH/cosmos_runtime_core.host.o" ELF64 'Advanced Micro Devices X86-64'

COMMON_FLAGS='-std=c11 -O2 -Wall -Wextra -Werror -Wpedantic -Wshadow -Wstrict-prototypes -Wformat=2 -fno-builtin -fno-stack-protector -ffunction-sections'
"$CLANG" $COMMON_FLAGS -DCOSMOS_MMIO_TEST=1 \
    -I"$SOURCE_DIR" -I"$TEST_DIR" \
    -c "$RUNTIME_SOURCE" -o "$SCRATCH/cosmos_runtime.host.o"
RUNTIME_SYMBOLS=$($READELF -sW "$SCRATCH/cosmos_runtime.host.o")
RUNTIME_UNDEFINED=$(printf '%s\n' "$RUNTIME_SYMBOLS" |
    awk '$7 == "UND" && $8 != "" { print $8 }' | LC_ALL=C sort -u)
[ "$RUNTIME_UNDEFINED" = "$CORE_DEPENDENCIES" ] ||
    fail "C shim undefined-symbol closure is not the five Simple owners: $RUNTIME_UNDEFINED"

for symbol in memcpy memmove memset memcmp strlen strcmp strncmp strncpy \
    rt_memcpy rt_memmove rt_memset rt_memcmp rt_strlen rt_strcmp rt_strncmp \
    __aeabi_memcpy __aeabi_memcpy4 __aeabi_memcpy8 \
    __aeabi_memmove __aeabi_memmove4 __aeabi_memmove8 \
    __aeabi_memclr __aeabi_memclr4 __aeabi_memclr8 \
    __aeabi_memset __aeabi_memset4 __aeabi_memset8 \
    __aeabi_uidiv __aeabi_uidivmod __aeabi_idiv __aeabi_idivmod \
    __aeabi_unwind_cpp_pr0 __aeabi_unwind_cpp_pr1 \
    cosmos_runtime_init cosmos_runtime_selftest; do
    printf '%s\n' "$RUNTIME_SYMBOLS" |
        awk -v symbol="$symbol" \
            '$4 == "FUNC" && $5 == "GLOBAL" && $6 == "DEFAULT" &&
             $7 != "UND" && $8 == symbol { count++ }
             END { exit count != 1 }' ||
        fail "missing or duplicate retained C ABI wrapper: $symbol"
done
printf '%s\n' "$RUNTIME_SYMBOLS" |
    awk '$4 == "FUNC" && $5 == "WEAK" && $6 == "DEFAULT" &&
         $7 != "UND" && $8 == "__aeabi_idiv0" { count++ }
         END { exit count != 1 }' ||
    fail "retained __aeabi_idiv0 is not one weak C definition"

"$CLANG" $COMMON_FLAGS -DCOSMOS_MMIO_TEST=1 \
    -I"$SOURCE_DIR" -I"$TEST_DIR" \
    "$CONTRACT_SOURCE" "$ORACLE_SOURCE" "$RUNTIME_SOURCE" \
    "$SCRATCH/cosmos_runtime_core.host.o" \
    -Wl,--gc-sections -o "$SCRATCH/cosmos_runtime_core_oracle"
mkdir -p "$EVIDENCE_DIR"
"$SCRATCH/cosmos_runtime_core_oracle" > "$EVIDENCE_DIR/oracle-output.txt"
grep -Fx 'COSMOS_RUNTIME_CORE_ORACLE_CASES 8816' \
    "$EVIDENCE_DIR/oracle-output.txt" >/dev/null ||
    fail "independent C oracle case pin failed"
grep -Fx 'COSMOS_RUNTIME_CORE_SIMPLE_DECISIONS 13/13' \
    "$EVIDENCE_DIR/oracle-output.txt" >/dev/null ||
    fail "13-site Simple decision audit failed"
grep -Fx 'COSMOS_RUNTIME_CORE_SIMPLE_OUTCOMES 26/26' \
    "$EVIDENCE_DIR/oracle-output.txt" >/dev/null ||
    fail "actual-execution Simple outcome coverage failed"

build_simple_object armv7-unknown-none-eabi \
    "$SCRATCH/arm-cache" "$SCRATCH/cosmos_runtime_core.arm.o"
check_simple_object "$SCRATCH/cosmos_runtime_core.arm.o" ELF32 ARM
"$CLANG" --target=armv7-none-eabi -mcpu=cortex-a9 -marm \
    -ffreestanding -nostdlib $COMMON_FLAGS -I"$SOURCE_DIR" \
    -c "$RUNTIME_SOURCE" -o "$SCRATCH/cosmos_runtime.arm.o"
ARM_RUNTIME_SYMBOLS=$($READELF -sW "$SCRATCH/cosmos_runtime.arm.o")
ARM_RUNTIME_UNDEFINED=$(printf '%s\n' "$ARM_RUNTIME_SYMBOLS" |
    awk '$7 == "UND" && $8 != "" { print $8 }' | LC_ALL=C sort -u)
[ "$ARM_RUNTIME_UNDEFINED" = "$CORE_DEPENDENCIES" ] ||
    fail "ARM C shim undefined-symbol closure is not the five Simple owners: $ARM_RUNTIME_UNDEFINED"
"$LLD" -r "$SCRATCH/cosmos_runtime.arm.o" \
    "$SCRATCH/cosmos_runtime_core.arm.o" \
    -o "$SCRATCH/cosmos_runtime_combined.arm.o"
COMBINED_UNDEFINED=$($READELF -sW "$SCRATCH/cosmos_runtime_combined.arm.o" |
    awk '$7 == "UND" && $8 != "" { print $8 }' | LC_ALL=C sort -u)
[ -z "$COMBINED_UNDEFINED" ] ||
    fail "combined ARM runtime core has unresolved symbols: $COMBINED_UNDEFINED"

RECEIPT="$EVIDENCE_DIR/receipt.sdn"
{
    echo 'schema=cosmos-runtime-core-evidence-v1'
    echo 'claim_scope=pure-simple-core-and-retained-c-abi-shims-only'
    echo 'physical_board_evidence=separate-not-included'
    echo 'decision_sites=13'
    echo 'decision_outcomes_hit=26'
    echo 'decision_outcomes_total=26'
    echo 'oracle_cases=8816'
    echo 'c_shim_undefined_closure=5-pure-simple-core-symbols'
    echo 'combined_arm_undefined_closure=empty'
    echo "simple_source_sha256=$(sha256sum "$CORE_SOURCE" | awk '{print $1}')"
    echo "c_shim_sha256=$(sha256sum "$RUNTIME_SOURCE" | awk '{print $1}')"
    echo "c_oracle_sha256=$(sha256sum "$ORACLE_SOURCE" | awk '{print $1}')"
    echo "stage4_compiler_sha256=$SIMPLE_SHA256"
    echo "stage4_provenance_sha256=$PROVENANCE_SHA256"
} > "$RECEIPT"

echo 'cosmos_runtime_core_c_oracle_cases=8816'
echo 'cosmos_runtime_core_simple_decisions=13/13'
echo 'cosmos_runtime_core_simple_outcomes=26/26'
echo 'cosmos_runtime_core_c_abi_owner=retained-wrappers-with-weak-idiv0'
echo 'cosmos_runtime_core_arm_undefined_closure=empty'
echo "cosmos_runtime_core_receipt=$RECEIPT"
echo 'cosmos runtime host/ARM ABI objects: PASS'
echo 'STATUS: PASS cosmos-runtime-core pure-Simple migration'
