#!/bin/sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
OUT_DIR=${1:-/mnt/data/simple-cli-provider-v1-host-check}
CC_NAME=${CC:-cc}
mkdir -p "$OUT_DIR"

"$CC_NAME" -std=gnu11 -O2 -fPIC -shared \
    "$ROOT_DIR/src/runtime/test/cli_provider_v1_fixture.c" \
    -o "$OUT_DIR/cli_provider_v1_fixture.so"
"$CC_NAME" -std=gnu11 -O1 -ffunction-sections -fdata-sections \
    "$ROOT_DIR/src/runtime/test/cli_provider_v1_host_selfcheck.c" \
    "$ROOT_DIR/src/runtime/runtime_native.c" \
    -Wl,--gc-sections -pthread -ldl -lm \
    -o "$OUT_DIR/cli_provider_v1_host_selfcheck"
"$OUT_DIR/cli_provider_v1_host_selfcheck" \
    "$OUT_DIR/cli_provider_v1_fixture.so" \
    >"$OUT_DIR/cli_provider_v1_host_selfcheck.out"
grep -q '^PASS cli_provider_v1_host_selfcheck$' \
    "$OUT_DIR/cli_provider_v1_host_selfcheck.out"
printf '%s\n' 'cli_provider_v1_host_gate=pass'
