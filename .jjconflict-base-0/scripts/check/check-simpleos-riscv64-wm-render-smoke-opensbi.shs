#!/bin/sh
# check-simpleos-riscv64-wm-render-smoke-opensbi.shs
#
# Proves that the SimpleOS riscv64 WINDOW MANAGER path actually brings up a real
# VirtIO-GPU scanout IN-GUEST under real firmware and puts PIXELS on it — and
# that the host can read those exact pixels back out of the guest's scanout.
#
# A PROCESS THAT STARTS AND PRINTS A BANNER IS NOT EVIDENCE, and neither is a
# serial line claiming a frame was presented. Every row below is rung on bytes
# that only a guest which really rendered can produce, carrying a per-run NONCE
# this gate generated itself. The must-FAIL selftest fixtures include a
# banner-only transcript and a blank screendump, so a guest that boots, prints
# its rungs and draws nothing cannot pass.
#
# WHY PIXELS AND NOT A SERIAL LINE (the anti-vacuity mechanism)
# ------------------------------------------------------------
# The sibling rv64 display gate (check-rv64-display-smoke-qmp-evidence.shs)
# establishes serial evidence, but it boots with QEMU `-kernel`, which is the
# pass semantics .claude/rules/board-runnable.md forbids. This gate boots real
# OpenSBI v1.4 as `fw_payload` with the guest Image embedded, handed to QEMU as
# `-bios` ONLY — the same real-firmware chain the riscv64 interpreter lane uses,
# and a real board-shipping configuration (how OpenSBI ships on flash on
# JH7110-class boards): the FIRMWARE performs the S-mode handover to 0x80200000.
# The assembled QEMU argv is self-checked for both forbidden flags before the VM
# is started.
#
# On top of that, evidence is anchored in the SCANOUT, not the console. The
# builder derives three 8-bit channel values from this run's nonce and the guest
# paints a fixed-origin 64x64 rectangle in that colour. The gate recomputes the
# same three channels from the nonce it chose, takes a QMP `screendump` of the
# live scanout, and compares the rectangle's bytes host-side. A stale kernel
# Image carries the PREVIOUS run's colour and therefore fails; a replayed serial
# transcript produces no screendump at all; a guest that presents an empty frame
# produces a rectangle that does not match. The nonce rule lives in exactly two
# places (this gate's rv64_wm_nonce_rgb and the builder's) and the selftest pins
# it on a fixed vector so the two cannot drift apart silently.
#
# FRESH-VOLUME ANCHORING. Before boot the gate asserts that the screendump
# target path does NOT exist and that no prior artifact under the run directory
# carries this run's nonce. Both are re-asserted as preconditions rather than
# assumed, so a leftover file from an earlier run cannot be mistaken for this
# run's output.
#
# WEAK-NIL STUB CHECK (a clean link is not evidence)
# --------------------------------------------------
# boot/baremetal_stubs.c weak-defines handlers, and this tree has seen a
# runtime symbol resolve to a synthesized 8-byte WEAK nil stub despite the file
# deliberately leaving it unresolved to fail closed — a green link, then a fault
# at runtime. Before booting anything this gate `nm`s the kernel ELF and FAILs
# on any runtime symbol that resolved WEAK, and on any remaining UNDEFINED
# runtime symbol. Note for anyone changing the guest: baremetal_stubs.c, NOT
# baremetal_runtime_core.inc.c, is the TU whose rt_* definitions win the link —
# two sessions were burned patching the wrong file. Verify with `nm kernel.elf`
# that a symbol is really in the image before concluding a change did nothing.
#
# THE VULKAN QUESTION, ANSWERED HONESTLY RATHER THAN IMPLIED
# ---------------------------------------------------------
# There is NO in-guest Vulkan on riscv64. The guest's pixels are produced by
# Engine2D CPU/SIMD rasterisation in S-mode and pushed to the display by
# VirtIO-GPU transfer+flush; `src/os/kernel/ipc/host_gpu_ivshmem_map` is a
# HOST-side offload protocol reached over an ivshmem BAR, not a guest Vulkan
# driver, and no ivshmem device is present in this gate's argv. The guest
# therefore prints a machine-readable `backend=` line, this gate PARSES that
# line, and the verdict re-states it verbatim. The word "vulkan" never appears
# in a PASS line as an unearned claim: it appears as `vulkan=absent-in-guest`,
# which is the true state of the riscv64 lane. If a real guest Vulkan backend
# lands later, the guest's backend= line changes and this gate reports the new
# value without needing to be trusted about it.
#
# COMPILER: the RUST SEED. The pure-Simple self-hosted compiler cannot compile
# anything in this tree yet, so this lane's artifacts are seed-built and the
# verdict says so rather than implying self-hosting.
#
# HONEST SCOPE, stated rather than papered over:
#   * The row runs in S-mode (kernel mode), linked into the guest image — not as
#     a U-mode process loaded off the guest's own filesystem. This is the same
#     scope as every other in-guest row in this tree; riscv64's U-mode execution
#     entry rt_riscv_fs_exec_run() deliberately FAILS CLOSED pending an
#     authority token, and routing around a fail-closed security control to
#     manufacture a U-mode row would defeat that control, not produce evidence.
#   * The row proves the scanout is live and host-visible with guest-authored,
#     nonce-anchored pixels. It does NOT drive the full DesktopShell window
#     stack: see the ADVISORY note below and the filed bug record.
#
# ROWS (serial log + scanout). Boot rungs are preconditions; the row needs its
# evidence lines, its nonce, AND its pixels.
#   wm  B "OpenSBI v"                                        real firmware ran
#       B "[wm-rv64] SimpleOS riscv64 WM render smoke"
#       B "[wm-rv64] serial up, bringing up the VirtIO-GPU scanout"
#         "[wm-rv64] scanout-ready width=... height=... stride=..."
#         "[wm-rv64] backend=... vulkan=..."                 backend, re-stated
#         "WM_RENDER_SIMPLEOS_RISCV64_OK nonce=<NONCE> ..."
#         "WM_RENDER_SIMPLEOS_RISCV64 second line ..."       it kept running
#         "[wm-rv64] wm render row exited rc=0"
#       + a QMP screendump whose 64x64 patch at (16,16) is this nonce's colour
#
# Verdict is the LAST line of stdout:
#   PASS  — <n> row(s) checked, ...   exit 0
#   FAIL  — ...                       exit 1
#   ERROR — nothing was checked: ...  exit 2
# 0 rows evaluated is an ERROR, never a PASS. Offline with no cached OpenSBI
# checkout is an ERROR, never a PASS. A boot rung that never appeared is an
# ERROR (nothing was checked), not a FAIL — a guest that never reached the entry
# rendered nothing to evaluate.
#
# `--selftest` (also run, fatally, before every real scan) proves the serial
# evaluator, the PIXEL evaluator, the nonce->colour rule, the nonce anchoring
# and the argv guard on fixtures, including a banner-only must-FAIL and a blank
# screendump must-FAIL.
#
# ADVISORY (landed 2026-09-01, honestly RED — do not promote until green)
# ---------------------------------------------------------------------
# This gate does NOT pass today, and it is landed advisory rather than adjusted
# until it did. Measured 2026-09-01 against origin/main e6fe722eeef with a
# freshly built seed:
#
#   ERROR — nothing was checked: WM kernel build failed: ... failed to parse
#   src/os/kernel/arch/riscv64/cpu.spl at 150:21 during discovery:
#   Unexpected token: expected identifier, found FString([Literal("memory")])
#
# The riscv64 display/compositor/WM dependency closure does not compile.
# cpu.spl writes CSRs with `asm volatile(..., clobber("memory"))`, and the
# parser supports no such clause in that form: parse_asm_parenthesized
# (src/compiler_rust/parser/src/stmt_parsing/asm.rs:153) hardcodes
# `clobbers: vec![]`, while the two functions that DO parse a clobber list both
# spell the keyword `clobbers` (plural) and both call expect_identifier(), which
# a string literal can never satisfy. That file has therefore never compiled.
# The tracked production desktop entry gui_entry_desktop.spl is separately
# broken in the same way (it calls FramebufferDriver.from_scanout_raw, which
# exists nowhere in src/), which is why this lane renders through the display
# module directly rather than through DesktopShell.
#
# Note what the ERROR does NOT mean: it is not a false negative and not an
# environment gap. The boot chain itself is healthy — the riscv64 interpreter
# lane is GREEN on this exact firmware path — and this gate's own --selftest
# passes 30 fixtures. Zero rows evaluated is an ERROR by contract, never a PASS,
# so the lane reports its blocker instead of manufacturing a green.
#
# Blocker and fix options:
# doc/08_tracking/bug/riscv64_wm_closure_unbuildable_asm_clobber_string_2026-09-01.md
# Promote to MANDATORY once that is fixed and this gate goes green.
#
# Env: SIMPLE_BIN (fresh seed), SKIP_KERNEL=1, BOOT_WAIT (420 — a desktop
#      scanout bring-up is heavier than the interpreter row), OPENSBI_SRC,
#      NONCE (override, for reproducing a specific run).
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$ROOT"

OUT=$ROOT/build/os/riscv64_wm
WORK=$OUT/run
BOOT_WAIT=${BOOT_WAIT:-420}
SIMPLE_BIN=${SIMPLE_BIN:-$ROOT/src/compiler_rust/target/release/simple}
OPENSBI_SRC=${OPENSBI_SRC:-$ROOT/build/os/rv64_opensbi_guest/opensbi-src}
OPENSBI_TAG=v1.4
OPENSBI_SHA=a2b255b88918715173942f2c5e1f97ac9e90c877  # v1.4 peeled commit, same pin as the sibling gates

# The patch geometry. These four numbers are a CONTRACT with
# examples/09_embedded/simple_os/arch/riscv64/wm_vulkan_smoke_entry.spl; the
# guest paints exactly this rectangle and this gate reads exactly it back.
PATCH_X=16
PATCH_Y=16
PATCH_W=64
PATCH_H=64

fail()    { printf 'FAIL — %s\n' "$1"; exit 1; }
nothing() { printf 'ERROR — nothing was checked: %s\n' "$1"; exit 2; }

# ---------------------------------------------------------------------------
# rv64_wm_nonce_rgb <nonce> — the nonce->colour rule. MUST stay byte-identical
# to the derivation in scripts/os/build-simpleos-riscv64-wm-kernel.shs; the
# selftest pins it on a fixed vector so a silent drift between the two turns
# every real run RED rather than green. Channels are OR'd with 0x40 so the patch
# can never be pure black, which would be indistinguishable from "nothing was
# drawn" — the exact vacuous green this lane exists to prevent.
# ---------------------------------------------------------------------------
rv64_wm_nonce_rgb() {
    h=$(printf '%s' "$1" | tr -dc '0-9a-fA-F' | cut -c1-6)
    [ "${#h}" -eq 6 ] || return 1
    printf '%s %s %s' \
        "$(( 0x$(printf '%s' "$h" | cut -c1-2) | 0x40 ))" \
        "$(( 0x$(printf '%s' "$h" | cut -c3-4) | 0x40 ))" \
        "$(( 0x$(printf '%s' "$h" | cut -c5-6) | 0x40 ))"
}

# ---------------------------------------------------------------------------
# Serial evaluators. Each takes <log> [<nonce>] and returns 0 only when the
# row's OWN output — not a boot banner — is present with the expected nonce.
# ---------------------------------------------------------------------------
wm_boot_ok() {
    [ -s "$1" ] || return 1
    grep -aqF 'OpenSBI v' "$1" || return 1
    grep -aqF '[wm-rv64] SimpleOS riscv64 WM render smoke' "$1" || return 1
    grep -aqF '[wm-rv64] serial up, bringing up the VirtIO-GPU scanout' "$1" || return 1
    return 0
}

wm_row_ok() {
    sl=$1; nonce=$2
    [ -s "$sl" ] || return 1
    grep -aq '\[wm-rv64\] scanout-ready width=' "$sl" || return 1
    grep -aq '\[wm-rv64\] backend=' "$sl" || return 1
    # The row's OWN output, carrying THIS run's nonce.
    grep -aqF "WM_RENDER_SIMPLEOS_RISCV64_OK nonce=$nonce" "$sl" || return 1
    grep -aqF 'WM_RENDER_SIMPLEOS_RISCV64 second line proves the WM row kept running' "$sl" || return 1
    grep -aqF '[wm-rv64] wm render row exited rc=0' "$sl" || return 1
    return 0
}

# The backend the GUEST reported, echoed into the verdict verbatim. Never
# synthesised here: if the guest did not say, the gate says it did not say.
wm_backend_line() {
    sed -n 's/.*\(\[wm-rv64\] backend=.*\)$/\1/p' "$1" 2>/dev/null | head -1
}

# ---------------------------------------------------------------------------
# PIXEL evaluator. <ppm> <r> <g> <b> — returns 0 only when the whole patch
# rectangle at the contracted origin is exactly that colour. Written in python3
# because a binary PPM cannot be read reliably in POSIX sh; its exit status is
# captured DIRECTLY into a variable, never through a pipe.
# ---------------------------------------------------------------------------
patch_matches() {
    ppm=$1; want_r=$2; want_g=$3; want_b=$4
    PATCH_X="$PATCH_X" PATCH_Y="$PATCH_Y" PATCH_W="$PATCH_W" PATCH_H="$PATCH_H" \
    python3 - "$ppm" "$want_r" "$want_g" "$want_b" <<'PIXCHECK'
import os, sys
path, wr, wg, wb = sys.argv[1], int(sys.argv[2]), int(sys.argv[3]), int(sys.argv[4])
px, py = int(os.environ["PATCH_X"]), int(os.environ["PATCH_Y"])
pw, ph = int(os.environ["PATCH_W"]), int(os.environ["PATCH_H"])
try:
    data = open(path, "rb").read()
except OSError as e:
    sys.exit("screendump unreadable: %s" % e)
if not data:
    sys.exit("screendump is empty")
# Binary PPM (P6): magic, width, height, maxval, then raw RGB triples.
# Header fields are whitespace separated and comments start with '#'.
fields, i = [], 0
while len(fields) < 4:
    while i < len(data) and data[i:i+1].isspace():
        i += 1
    if i < len(data) and data[i:i+1] == b"#":
        while i < len(data) and data[i:i+1] != b"\n":
            i += 1
        continue
    j = i
    while j < len(data) and not data[j:j+1].isspace():
        j += 1
    if j == i:
        sys.exit("truncated PPM header")
    fields.append(data[i:j]); i = j
i += 1  # exactly one whitespace byte follows maxval
if fields[0] != b"P6":
    sys.exit("not a binary PPM (magic %r)" % fields[0])
w, h, maxv = int(fields[1]), int(fields[2]), int(fields[3])
if maxv != 255:
    sys.exit("unsupported PPM maxval %d" % maxv)
if w < px + pw or h < py + ph:
    sys.exit("screendump %dx%d is smaller than the patch at (%d,%d)+%dx%d"
             % (w, h, px, py, pw, ph))
body = data[i:]
if len(body) < w * h * 3:
    sys.exit("truncated PPM body: %d bytes for %dx%d" % (len(body), w, h))
bad = None
for row in range(ph):
    base = ((py + row) * w + px) * 3
    for col in range(pw):
        o = base + col * 3
        r, g, b = body[o], body[o+1], body[o+2]
        if (r, g, b) != (wr, wg, wb):
            if bad is None:
                bad = (px + col, py + row, r, g, b)
if bad is not None:
    sys.exit("patch pixel at (%d,%d) is rgb(%d,%d,%d), expected rgb(%d,%d,%d) "
             "— the guest did not paint this run's nonce colour"
             % (bad[0], bad[1], bad[2], bad[3], bad[4], wr, wg, wb))
PIXCHECK
}

# Build a synthetic P6 PPM for the selftest fixtures: <path> <w> <h> <bg r g b>
# [<patch r g b>]. With no patch colour the whole image is background — that is
# the blank-screendump must-FAIL fixture.
make_ppm() {
    PATCH_X="$PATCH_X" PATCH_Y="$PATCH_Y" PATCH_W="$PATCH_W" PATCH_H="$PATCH_H" \
    python3 - "$@" <<'MKPPM'
import os, sys
a = sys.argv[1:]
path, w, h = a[0], int(a[1]), int(a[2])
bg = tuple(int(x) for x in a[3:6])
patch = tuple(int(x) for x in a[6:9]) if len(a) >= 9 else None
px, py = int(os.environ["PATCH_X"]), int(os.environ["PATCH_Y"])
pw, ph = int(os.environ["PATCH_W"]), int(os.environ["PATCH_H"])
rows = bytearray()
for y in range(h):
    for x in range(w):
        c = patch if (patch and px <= x < px + pw and py <= y < py + ph) else bg
        rows += bytes(c)
with open(path, "wb") as f:
    f.write(b"P6\n%d %d\n255\n" % (w, h))
    f.write(bytes(rows))
MKPPM
}

# argv self-check. Needles are assembled from fragments so this check can
# neither be defeated by, nor accidentally fire on, the surrounding prose.
assert_real_firmware_argv() {
    k_flag="-kern""el"
    d_dev="isa-debug""-exit"
    case " $1 " in
        *" $k_flag "*) echo "argv uses QEMU $k_flag pass semantics"; return 1 ;;
    esac
    case "$1" in
        *"$d_dev"*) echo "argv uses $d_dev"; return 1 ;;
    esac
    case "$1" in
        *"-bios "*) ;;
        *) echo "argv has no -bios firmware"; return 1 ;;
    esac
    # A WM gate with no display device would be measuring nothing.
    case "$1" in
        *"virtio-gpu"*) ;;
        *) echo "argv has no virtio-gpu display device"; return 1 ;;
    esac
    return 0
}

# ---------------------------------------------------------------------------
# WEAK-NIL STUB CHECK. A clean link is not evidence: baremetal_stubs.c
# weak-defines handlers, and a WEAK 8-byte nil stub has previously satisfied a
# link that was meant to fail closed. Returns 0 when the ELF is clean; prints
# the offending symbols and returns 1 otherwise.
# ---------------------------------------------------------------------------
elf_free_of_weak_nil_stubs() {
    elf=$1
    command -v nm >/dev/null 2>&1 || { echo "no nm available"; return 1; }
    tbl=$(nm "$elf" 2>/dev/null) || { echo "nm could not read $elf"; return 1; }
    # nm prints "ADDR TYPE NAME" for defined symbols but "        U NAME" for
    # undefined ones, so the type column is $(NF-1) in BOTH shapes and $1 is NOT.
    undef=$(printf '%s\n' "$tbl" | awk 'NF >= 2 && $(NF-1) == "U" && $NF ~ /^rt_/ { print $NF }' | sort -u | tr '\n' ' ')
    weak=$(printf '%s\n' "$tbl" | awk 'NF >= 2 && ($(NF-1) == "w" || $(NF-1) == "v" || $(NF-1) == "W" || $(NF-1) == "V") && $NF ~ /^rt_/ { print $NF }' | sort -u | tr '\n' ' ')
    if [ -n "$undef" ] || [ -n "$weak" ]; then
        printf '%s' "${undef:+undefined runtime symbols: $undef}${weak:+${undef:+; }weak/nil-stub runtime symbols: $weak}"
        return 1
    fi
    return 0
}

# ---------------------------------------------------------------------------
selftest() {
    st=$(mktemp -d "${TMPDIR:-/tmp}/rv64-wm-selftest.XXXXXX")
    st_fail=0
    n=0
    N=deadbeefcafe0001
    OTHER=0123456789abcdef

    # ---- the nonce->colour rule, pinned on a fixed vector ------------------
    # 'deadbeefcafe0001' -> first six hex digits 'deadbe' -> 0xde,0xad,0xbe,
    # each OR 0x40 -> 222, 237, 254. If either this rule or the builder's
    # changes without the other, this row fails and every real run goes RED
    # rather than silently green.
    n=$((n+1))
    got=$(rv64_wm_nonce_rgb "$N") || { echo "selftest: nonce->rgb refused a valid nonce" >&2; st_fail=1; got=; }
    [ "$got" = "222 237 254" ] \
        || { echo "selftest: nonce->rgb drifted: got '$got', want '222 237 254'" >&2; st_fail=1; }
    n=$((n+1))
    if rv64_wm_nonce_rgb "zz" >/dev/null 2>&1; then
        echo "selftest: nonce->rgb wrongly accepted a nonce with <6 hex digits" >&2; st_fail=1
    fi
    # No derived channel may be 0 — a black patch is indistinguishable from an
    # unpainted scanout.
    n=$((n+1))
    zr=$(rv64_wm_nonce_rgb "000000ff")
    [ "$zr" = "64 64 64" ] \
        || { echo "selftest: all-zero nonce did not floor to 64 64 64 (got '$zr')" >&2; st_fail=1; }

    R=222; G=237; B=254

    # ---- serial fixtures ---------------------------------------------------
    {
        echo 'OpenSBI v1.4'
        echo '[wm-rv64] SimpleOS riscv64 WM render smoke (OpenSBI fw_payload)'
        echo '[wm-rv64] serial up, bringing up the VirtIO-GPU scanout'
        echo '[wm-rv64] scanout-ready width=1280 height=800 stride=5120 bpp=32'
        echo '[wm-rv64] backend=engine2d-cpu-raster present=virtio-gpu-transfer+flush vulkan=absent-in-guest'
        echo "WM_RENDER_SIMPLEOS_RISCV64_OK nonce=$N patch=16,16,64,64 rgb=$R,$G,$B"
        echo 'WM_RENDER_SIMPLEOS_RISCV64 second line proves the WM row kept running'
        echo '[wm-rv64] wm render row exited rc=0'
    } > "$st/wm_good.log"

    n=$((n+1))
    wm_boot_ok "$st/wm_good.log" || { echo "selftest: good boot rungs not seen" >&2; st_fail=1; }
    n=$((n+1))
    wm_row_ok "$st/wm_good.log" "$N" || { echo "selftest: must-PASS serial fixture did not pass" >&2; st_fail=1; }
    n=$((n+1))
    bl=$(wm_backend_line "$st/wm_good.log")
    case "$bl" in
        *'backend=engine2d-cpu-raster'*'vulkan=absent-in-guest'*) ;;
        *) echo "selftest: backend line not extracted (got '$bl')" >&2; st_fail=1 ;;
    esac

    # (must-FAIL) BANNER-ONLY: firmware + kernel banners, nothing rendered. This
    # is the exact vacuous-green this gate exists to prevent.
    {
        echo 'OpenSBI v1.4'
        echo '[wm-rv64] SimpleOS riscv64 WM render smoke (OpenSBI fw_payload)'
        echo '[wm-rv64] serial up, bringing up the VirtIO-GPU scanout'
    } > "$st/wm_banner.log"
    n=$((n+1))
    if wm_row_ok "$st/wm_banner.log" "$N"; then
        echo "selftest: BANNER-ONLY fixture wrongly passed" >&2; st_fail=1
    fi
    # ...and it must still be recognised as having BOOTED, so the caller
    # classifies it as a row FAIL and not as "nothing was checked".
    n=$((n+1))
    wm_boot_ok "$st/wm_banner.log" \
        || { echo "selftest: banner-only fixture should still show boot rungs" >&2; st_fail=1; }

    # (must-FAIL) WRONG NONCE — a stale image or replayed transcript.
    sed "s/$N/$OTHER/" "$st/wm_good.log" > "$st/wm_stale.log"
    n=$((n+1))
    if wm_row_ok "$st/wm_stale.log" "$N"; then
        echo "selftest: stale-nonce fixture wrongly passed" >&2; st_fail=1
    fi

    # (must-FAIL) scanout came up but nothing was rendered.
    grep -av 'WM_RENDER_SIMPLEOS_RISCV64' "$st/wm_good.log" > "$st/wm_silent.log"
    n=$((n+1))
    if wm_row_ok "$st/wm_silent.log" "$N"; then
        echo "selftest: silent-render fixture wrongly passed" >&2; st_fail=1
    fi

    # (must-FAIL) the scanout never came up.
    grep -av 'scanout-ready' "$st/wm_good.log" > "$st/wm_noscanout.log"
    n=$((n+1))
    if wm_row_ok "$st/wm_noscanout.log" "$N"; then
        echo "selftest: no-scanout fixture wrongly passed" >&2; st_fail=1
    fi

    # (must-FAIL) row exited non-zero.
    sed 's/exited rc=0/exited rc=nonzero/' "$st/wm_good.log" > "$st/wm_rc.log"
    n=$((n+1))
    if wm_row_ok "$st/wm_rc.log" "$N"; then
        echo "selftest: non-zero-exit fixture wrongly passed" >&2; st_fail=1
    fi

    # (must-FAIL) empty log.
    : > "$st/empty.log"
    n=$((n+1))
    if wm_row_ok "$st/empty.log" "$N"; then
        echo "selftest: empty fixture wrongly passed" >&2; st_fail=1
    fi
    n=$((n+1))
    if wm_boot_ok "$st/empty.log"; then
        echo "selftest: empty fixture wrongly reported booted" >&2; st_fail=1
    fi

    # (must-FAIL) rendered but NO firmware banner — started some way other than
    # through real firmware.
    grep -av 'OpenSBI v' "$st/wm_good.log" > "$st/wm_nofw.log"
    n=$((n+1))
    if wm_boot_ok "$st/wm_nofw.log"; then
        echo "selftest: firmware-less transcript wrongly passed boot check" >&2; st_fail=1
    fi

    # ---- PIXEL fixtures ----------------------------------------------------
    # (must-PASS) a screendump whose patch really is this nonce's colour.
    make_ppm "$st/good.ppm" 320 240 10 20 30 "$R" "$G" "$B"
    n=$((n+1))
    patch_matches "$st/good.ppm" "$R" "$G" "$B" >/dev/null 2>&1 \
        || { echo "selftest: must-PASS screendump was rejected" >&2; st_fail=1; }

    # (must-FAIL) BLANK screendump — the guest presented an empty frame. This is
    # the pixel half of the banner-only failure and the reason serial evidence
    # alone is not enough.
    make_ppm "$st/blank.ppm" 320 240 0 0 0
    n=$((n+1))
    if patch_matches "$st/blank.ppm" "$R" "$G" "$B" >/dev/null 2>&1; then
        echo "selftest: BLANK screendump wrongly passed" >&2; st_fail=1
    fi

    # (must-FAIL) the patch is painted, but in the PREVIOUS run's colour.
    make_ppm "$st/stale.ppm" 320 240 10 20 30 1 2 3
    n=$((n+1))
    if patch_matches "$st/stale.ppm" "$R" "$G" "$B" >/dev/null 2>&1; then
        echo "selftest: stale-colour screendump wrongly passed" >&2; st_fail=1
    fi

    # (must-FAIL) only PART of the patch is painted — a partial or torn frame.
    make_ppm "$st/good.ppm" 320 240 10 20 30 "$R" "$G" "$B"
    python3 - "$st/good.ppm" "$st/torn.ppm" <<'TEAR'
import sys
d = bytearray(open(sys.argv[1], "rb").read())
# Corrupt one pixel well inside the patch: (16+40, 16+40) in a 320-wide image.
o = len(d) - 320 * 240 * 3 + ((16 + 40) * 320 + (16 + 40)) * 3
d[o:o+3] = b"\x00\x00\x00"
open(sys.argv[2], "wb").write(bytes(d))
TEAR
    n=$((n+1))
    if patch_matches "$st/torn.ppm" "$R" "$G" "$B" >/dev/null 2>&1; then
        echo "selftest: torn-patch screendump wrongly passed" >&2; st_fail=1
    fi

    # (must-FAIL) a screendump too small to contain the patch at all.
    make_ppm "$st/tiny.ppm" 32 32 "$R" "$G" "$B"
    n=$((n+1))
    if patch_matches "$st/tiny.ppm" "$R" "$G" "$B" >/dev/null 2>&1; then
        echo "selftest: undersized screendump wrongly passed" >&2; st_fail=1
    fi

    # (must-FAIL) an empty or missing screendump — no screendump was ever taken.
    : > "$st/empty.ppm"
    n=$((n+1))
    if patch_matches "$st/empty.ppm" "$R" "$G" "$B" >/dev/null 2>&1; then
        echo "selftest: empty screendump wrongly passed" >&2; st_fail=1
    fi
    n=$((n+1))
    if patch_matches "$st/does-not-exist.ppm" "$R" "$G" "$B" >/dev/null 2>&1; then
        echo "selftest: missing screendump wrongly passed" >&2; st_fail=1
    fi

    # ---- argv fixtures -----------------------------------------------------
    n=$((n+1))
    assert_real_firmware_argv "-machine virt -bios fw_payload.bin -device virtio-gpu-pci -serial file:x" >/dev/null \
        || { echo "selftest: clean argv wrongly rejected" >&2; st_fail=1; }
    n=$((n+1))
    if assert_real_firmware_argv "-machine virt -bios fw.bin -device virtio-gpu-pci -kern""el k.Image" >/dev/null 2>&1; then
        echo "selftest: -kernel argv wrongly accepted" >&2; st_fail=1
    fi
    n=$((n+1))
    if assert_real_firmware_argv "-machine virt -bios fw.bin -device virtio-gpu-pci -device isa-debug""-exit" >/dev/null 2>&1; then
        echo "selftest: isa-debug-exit argv wrongly accepted" >&2; st_fail=1
    fi
    n=$((n+1))
    if assert_real_firmware_argv "-machine virt -device virtio-gpu-pci -serial file:x" >/dev/null 2>&1; then
        echo "selftest: firmware-less argv wrongly accepted" >&2; st_fail=1
    fi
    n=$((n+1))
    if assert_real_firmware_argv "-machine virt -bios fw.bin -serial file:x" >/dev/null 2>&1; then
        echo "selftest: display-less argv wrongly accepted" >&2; st_fail=1
    fi

    # ---- weak-nil stub detector fixtures ----------------------------------
    # Built as real object files probed by the real detector, so the check
    # cannot rot into a text comparison against a hand-written nm listing.
    if command -v cc >/dev/null 2>&1 && command -v nm >/dev/null 2>&1; then
        printf 'long rt_clean_symbol(void){return 1;}\n' > "$st/clean.c"
        cc -c "$st/clean.c" -o "$st/clean.o" 2>/dev/null && {
            n=$((n+1))
            elf_free_of_weak_nil_stubs "$st/clean.o" >/dev/null \
                || { echo "selftest: clean object wrongly flagged as stubbed" >&2; st_fail=1; }
        }
        printf '__attribute__((weak)) long rt_weak_nil_stub(void){return 0;}\n' > "$st/weak.c"
        cc -c "$st/weak.c" -o "$st/weak.o" 2>/dev/null && {
            n=$((n+1))
            if elf_free_of_weak_nil_stubs "$st/weak.o" >/dev/null 2>&1; then
                echo "selftest: WEAK runtime symbol wrongly accepted" >&2; st_fail=1
            fi
        }
        printf 'extern long rt_missing_symbol(void);\nlong use(void){return rt_missing_symbol();}\n' > "$st/undef.c"
        cc -c "$st/undef.c" -o "$st/undef.o" 2>/dev/null && {
            n=$((n+1))
            if elf_free_of_weak_nil_stubs "$st/undef.o" >/dev/null 2>&1; then
                echo "selftest: UNDEFINED runtime symbol wrongly accepted" >&2; st_fail=1
            fi
        }
    fi

    rm -rf "$st"
    [ "$st_fail" -eq 0 ] || return 1
    SELFTEST_N=$n
    printf '[rv64-wm] selftest OK (%s fixtures)\n' "$n"
    return 0
}

selftest || nothing "selftest failed — the serial and pixel evaluators cannot be trusted"
if [ "${1:-}" = "--selftest" ]; then
    [ "${SELFTEST_N:-0}" -gt 0 ] || nothing "selftest executed 0 fixtures"
    printf 'PASS — %s selftest fixture(s) checked, serial evaluator, PIXEL evaluator, nonce->colour rule, nonce anchoring, weak-nil-stub detector and argv guard all discriminate (banner-only and blank-screendump fixtures both correctly rejected)\n' "$SELFTEST_N"
    exit 0
fi

# --- the nonce: generated HERE so the gate knows what it must see ------------
if [ -z "${NONCE:-}" ]; then
    NONCE=$( (od -An -N8 -tx1 /dev/urandom 2>/dev/null || date +%s%N) | tr -d ' \n' )
fi
[ -n "$NONCE" ] || nothing "could not generate a nonce"
RGB=$(rv64_wm_nonce_rgb "$NONCE") || nothing "nonce $NONCE has fewer than 6 hex digits"
WANT_R=$(printf '%s' "$RGB" | cut -d' ' -f1)
WANT_G=$(printf '%s' "$RGB" | cut -d' ' -f2)
WANT_B=$(printf '%s' "$RGB" | cut -d' ' -f3)

# --- build the WM kernel (Simple source -> flat Image, by the Rust seed) -----
if [ "${SKIP_KERNEL:-0}" != "1" ]; then
    mkdir -p "$OUT"
    SIMPLE_BIN="$SIMPLE_BIN" NONCE="$NONCE" \
        sh "$ROOT/scripts/os/build-simpleos-riscv64-wm-kernel.shs" >"$OUT/gate-kernel.log" 2>&1 \
        || nothing "WM kernel build failed: $(tail -3 "$OUT/gate-kernel.log" 2>/dev/null | tr '\n' ' ')"
        # The excerpt is flattened with tr: a multi-line diagnostic embedded in
        # the verdict would push the verdict off the LAST line of stdout, which
        # is the one contract every caller of this gate relies on.
fi

command -v qemu-system-riscv64 >/dev/null 2>&1 || nothing "missing qemu-system-riscv64"
command -v python3 >/dev/null 2>&1 || nothing "missing python3 (needed to drive QMP and read the screendump)"
OPENSBI_CROSS=
for c in riscv64-linux-gnu- riscv64-unknown-elf-; do
    command -v "${c}gcc" >/dev/null 2>&1 && { OPENSBI_CROSS=$c; break; }
done
[ -n "$OPENSBI_CROSS" ] || nothing "no riscv64 cross-gcc to build OpenSBI"

mkdir -p "$WORK"

# --- OpenSBI v1.4 checkout: reuse the pinned one, else clone -----------------
if [ -d "$OPENSBI_SRC/.git" ]; then
    have=$(git -C "$OPENSBI_SRC" rev-parse HEAD 2>/dev/null || echo none)
    [ "$have" = "$OPENSBI_SHA" ] \
        || nothing "OpenSBI checkout $OPENSBI_SRC is at $have, not pinned $OPENSBI_SHA — refusing to build unpinned firmware"
else
    git clone --depth 1 --branch "$OPENSBI_TAG" \
        https://github.com/riscv-software-src/opensbi.git "$OPENSBI_SRC" >"$WORK/clone.log" 2>&1 \
        || nothing "no cached OpenSBI checkout and clone failed (offline?) — see $WORK/clone.log"
    have=$(git -C "$OPENSBI_SRC" rev-parse HEAD)
    [ "$have" = "$OPENSBI_SHA" ] || nothing "cloned OpenSBI $OPENSBI_TAG is $have, not pinned $OPENSBI_SHA"
fi

IMG=$OUT/wm/kernel.Image
ELF=$OUT/wm/kernel.elf
ROW_LOG=$WORK/wm-serial.log
PPM=$WORK/wm-scanout.ppm
QMP_SOCK=$WORK/wm-qmp.sock

[ -s "$IMG" ] || nothing "missing flat Image $IMG"
[ -s "$ELF" ] || nothing "missing kernel ELF $ELF"

# A clean link is not evidence — nm the ELF before believing it.
why=$(elf_free_of_weak_nil_stubs "$ELF") \
    || fail "the WM kernel ELF is not safely linked: $why (a clean link is not evidence; see the WEAK-NIL STUB CHECK header)"

# POSITIVE anchoring: the nonce MUST be physically in the image the firmware is
# about to carry. If it is not, the guest cannot possibly paint this run's
# colour and the gate would be measuring some other build.
grep -aqF "$NONCE" "$IMG" \
    || nothing "the flat Image does not contain this run's nonce — the build did not produce the image being booted"

# FRESH-VOLUME anchoring: the screendump target must not exist before boot, and
# no leftover artifact may already carry this run's nonce, so a stale file
# cannot be mistaken for this run's output.
rm -f "$ROW_LOG" "$PPM" "$QMP_SOCK"
[ ! -e "$PPM" ] || nothing "could not clear the screendump target $PPM before boot"
if [ -d "$WORK" ] && grep -rlaF "$NONCE" "$WORK" >/dev/null 2>&1; then
    nothing "a pre-boot artifact under $WORK already carries this run's nonce — refusing to measure a dirty run directory"
fi

# OpenSBI embeds the payload with `.incbin "$(FW_PAYLOAD_PATH)"` and does NOT
# list that path as a prerequisite of fw_payload.o. Its make is incremental, so
# a warm tree silently reuses whatever Image was embedded last time. Deleting
# the firmware objects forces the incbin to be re-read; it is not a full
# `make clean`, so the platform library stays warm and this costs seconds.
rm -rf "$OPENSBI_SRC/build/platform/generic/firmware"

make -C "$OPENSBI_SRC" PLATFORM=generic CROSS_COMPILE="$OPENSBI_CROSS" \
    FW_PAYLOAD=y FW_PAYLOAD_PATH="$IMG" FW_PAYLOAD_OFFSET=0x200000 -j4 \
    >"$WORK/opensbi-build.log" 2>&1 \
    || { tail -20 "$WORK/opensbi-build.log" >&2; nothing "OpenSBI fw_payload build failed"; }
FW=$OPENSBI_SRC/build/platform/generic/firmware/fw_payload.bin
[ -s "$FW" ] || nothing "fw_payload.bin missing after build"

# POSITIVE embed assertion. A firmware that built cleanly is not evidence it
# carries THIS run's payload — the incremental-incbin trap above produced
# exactly that failure on the sibling lane, invisible for as long as nobody
# checked. Requiring the whole flat Image to appear verbatim inside the firmware
# cannot be satisfied by a stale one: the two Images differ.
# `set +e` around the invocation is load-bearing, not sloppiness: under `set -e`
# a failing embed check aborts the whole script AT the python, so the `rc=$?`
# line below never runs and the gate dies with NO verdict line — breaking the
# one contract every caller relies on, in exactly the case this check exists to
# catch. Same discipline as the builder's native-build invocation.
set +e
python3 - "$FW" "$IMG" <<'EMBED_CHECK'
import sys
firmware = open(sys.argv[1], 'rb').read()
image = open(sys.argv[2], 'rb').read()
if not image:
    sys.exit("flat Image is empty")
if image not in firmware:
    sys.exit(
        "fw_payload.bin (%d bytes) does NOT embed its own kernel.Image (%d bytes) "
        "-- the firmware carries some other payload, so booting it would measure "
        "the wrong guest" % (len(firmware), len(image))
    )
EMBED_CHECK
rc=$?
set -e
[ "$rc" -eq 0 ] || nothing "fw_payload does not embed this run's kernel.Image"

cp "$FW" "$WORK/wm-fw_payload.bin"

# Assemble the argv FIRST, self-check it, then boot. The scanout is read back
# over QMP, so the VM gets a QMP unix socket and no interactive monitor.
QA="-no-user-config -machine virt -cpu rv64 -smp 1 -m 1024M"
QA="$QA -bios $WORK/wm-fw_payload.bin"
QA="$QA -device virtio-gpu-pci,disable-modern=on,disable-legacy=off"
QA="$QA -serial file:$ROW_LOG"
QA="$QA -display none -monitor none -net none -no-reboot"
QA="$QA -qmp unix:$QMP_SOCK,server,nowait"

why=$(assert_real_firmware_argv "$QA") \
    || fail "$why (script bug, not an environment gap)"

# The guest parks in crt0.S's wfi loop, so QEMU never exits on its own. The
# driver below connects over QMP, waits for the row's serial evidence, takes a
# screendump of the live scanout, and then quits the VM. Its exit status is read
# DIRECTLY into a variable on the next line, never through a pipe.
# shellcheck disable=SC2086
timeout "$BOOT_WAIT" qemu-system-riscv64 $QA >"$WORK/qemu.stderr.log" 2>&1 &
QEMU_PID=$!

# `set +e` again, for the same reason: the driver exits non-zero when it cannot
# reach QMP, and that must become an evaluated verdict, not a bare death.
set +e
BOOT_WAIT="$BOOT_WAIT" python3 - "$QMP_SOCK" "$ROW_LOG" "$PPM" "$NONCE" >"$WORK/qmp.log" 2>&1 <<'QMP_DRIVE'
import json, os, socket, sys, time
sock_path, serial_path, ppm_path, nonce = sys.argv[1:5]
deadline = time.time() + float(os.environ["BOOT_WAIT"])

s = None
while time.time() < deadline:
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.connect(sock_path)
        break
    except OSError:
        s = None
        time.sleep(0.5)
if s is None:
    sys.exit("could not connect to the QMP socket before the deadline")

f = s.makefile("rwb")

def rd():
    line = f.readline()
    if not line:
        raise SystemExit("QMP closed the connection")
    return json.loads(line)

def cmd(name, **args):
    msg = {"execute": name}
    if args:
        msg["arguments"] = args
    f.write((json.dumps(msg) + "\n").encode()); f.flush()
    while True:
        m = rd()
        if "return" in m or "error" in m:
            return m

rd()                      # the QMP greeting
cmd("qmp_capabilities")

# Wait for the guest to say it finished its render, then capture. Capturing
# before the row completes would photograph a half-drawn scanout and blame the
# guest for the race.
marker = ("WM_RENDER_SIMPLEOS_RISCV64_OK nonce=" + nonce).encode()
seen = False
while time.time() < deadline:
    try:
        if marker in open(serial_path, "rb").read():
            seen = True
            break
    except OSError:
        pass
    time.sleep(0.5)

# Screendump regardless: if the guest never printed its marker we still want the
# scanout on disk as evidence of what it DID draw, and the caller decides.
r = cmd("screendump", filename=os.path.abspath(ppm_path))
if "error" in r:
    print("screendump error:", r["error"], file=sys.stderr)
cmd("quit")
print("marker_seen=%s" % seen)
QMP_DRIVE
QMP_RC=$?
set -e

wait "$QEMU_PID" 2>/dev/null || true

CHECKED=0
OFFENDERS=

wm_boot_ok "$ROW_LOG" \
    || nothing "the WM guest never reached its entry — no boot rungs on serial, so no row was evaluated (log: $ROW_LOG, qemu stderr: $WORK/qemu.stderr.log, qmp: $WORK/qmp.log, qmp driver rc=$QMP_RC)"
CHECKED=$((CHECKED + 1))

BACKEND=$(wm_backend_line "$ROW_LOG")
[ -n "$BACKEND" ] || BACKEND='[wm-rv64] backend=<the guest never reported one>'

wm_row_ok "$ROW_LOG" "$NONCE" \
    || OFFENDERS="${OFFENDERS:+$OFFENDERS; }serial: the WM row did not print its own nonce-carrying render evidence (log: $ROW_LOG)"

# The pixels. This is the half a serial line cannot fake.
if PIXWHY=$(patch_matches "$PPM" "$WANT_R" "$WANT_G" "$WANT_B" 2>&1); then
    :
else
    OFFENDERS="${OFFENDERS:+$OFFENDERS; }scanout: $PIXWHY (screendump: $PPM)"
fi

[ "$CHECKED" -gt 0 ] || nothing "no rows were evaluated"

if [ -n "$OFFENDERS" ]; then
    printf 'FAIL — %s row(s) checked in-guest under real OpenSBI %s firmware via -bios fw_payload (nonce %s, expected patch rgb %s,%s,%s at %s,%s+%sx%s), guest-reported %s, offender(s): %s\n' \
        "$CHECKED" "$OPENSBI_TAG" "$NONCE" "$WANT_R" "$WANT_G" "$WANT_B" \
        "$PATCH_X" "$PATCH_Y" "$PATCH_W" "$PATCH_H" "$BACKEND" "$OFFENDERS"
    exit 1
fi

printf 'PASS — %s row(s) checked: the SimpleOS riscv64 WM brought up a live VirtIO-GPU scanout in-guest and rendered pixels the host read back from that scanout, under real OpenSBI %s firmware via -bios fw_payload (no -kernel, no isa-debug-exit); the 64x64 patch at (%s,%s) is rgb(%s,%s,%s), derived host-side from this run'"'"'s nonce %s and verified byte-for-byte in the screendump, not merely claimed on serial; guest-reported %s (there is NO in-guest Vulkan on riscv64 — pixels are Engine2D CPU/SIMD raster pushed by VirtIO-GPU transfer+flush); kernel seed-built (%s); logs %s\n' \
    "$CHECKED" "$OPENSBI_TAG" "$PATCH_X" "$PATCH_Y" "$WANT_R" "$WANT_G" "$WANT_B" \
    "$NONCE" "$BACKEND" "$SIMPLE_BIN" "$WORK"
