#!/bin/sh
# Executable fence for the radix-literal-suffix lexer fix (b0f5308993 /
# fd3d8c1da3). An adversarial review of those commits concluded "sound by
# construction" because its harness invocation burned >25 minutes with zero
# `SPEC FILE VERDICT` line emitted. Independent re-run on 2026-08-08 found
# the harness DOES emit a verdict when run with --no-session-daemon against
# an isolated tree (388ms, 9 examples, 0 failures, dropped=0) — the earlier
# non-emission was not reproduced and is not a property of this spec. This
# script pins that result so it can be re-checked without re-deriving it.
#
# Exit 0  = PASS — verdict line present, 0 failed, dropped=0.
# Exit 1  = FAIL — verdict present but failures or drops nonzero.
# Exit 2  = ERROR — no SPEC FILE VERDICT line emitted (harness non-emission
#           reproduced); do not treat silence as a pass.

set -eu
cd "$(dirname "$0")/../.." 2>/dev/null || true
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$REPO_ROOT"

SPEC="test/01_unit/compiler/lexer/lexer_radix_literal_suffix_spec.spl"
if [ ! -f "$SPEC" ]; then
  echo "ERROR — nothing was checked: $SPEC not found in working tree" >&2
  exit 2
fi

OUT="$(mktemp)"
trap 'rm -f "$OUT"' EXIT

timeout 120 bin/simple test "$SPEC" --no-session-daemon >"$OUT" 2>&1 || true

VERDICT_LINE="$(grep -E '^SPEC FILE VERDICT:' "$OUT" || true)"
if [ -z "$VERDICT_LINE" ]; then
  echo "ERROR — nothing was checked: no SPEC FILE VERDICT line emitted" >&2
  tail -n 40 "$OUT" >&2
  exit 2
fi

echo "$VERDICT_LINE"

FAILED="$(echo "$VERDICT_LINE" | grep -oE 'failed=[0-9]+' | cut -d= -f2)"
DROPPED="$(echo "$VERDICT_LINE" | grep -oE 'dropped=[0-9]+' | cut -d= -f2)"

if [ "${FAILED:-1}" != "0" ] || [ "${DROPPED:-1}" != "0" ]; then
  echo "FAIL — failed=$FAILED dropped=$DROPPED (nonzero)"
  exit 1
fi

echo "PASS — lexer radix-literal-suffix spec: 0 failed, dropped=0"
exit 0
