#!/usr/bin/env bash
# Diagnostic-only Stage 4 corpus sweep.
#
# Phase A compiles every selected source to a cacheable artifact. Phase B runs
# semantic diagnostics over every successful artifact, then evaluates only
# runnable/spec sources. This tool never deploys or admits an artifact.

set -uo pipefail

SCHEMA_VERSION=1
WORKERS=${SIMPLE_STAGE4_DIAG_WORKERS:-32}
TIMEOUT_SEC=${SIMPLE_STAGE4_DIAG_TIMEOUT_SEC:-600}
CACHE_DIR=${SIMPLE_STAGE4_DIAG_CACHE_DIR:-build/stage4-diagnostic/cache}
RESULT_DIR=${SIMPLE_STAGE4_DIAG_RESULT_DIR:-build/stage4-diagnostic/results}
COMPILE_RUNNER=${SIMPLE_STAGE4_DIAG_COMPILE_RUNNER:-}
SEMANTIC_RUNNER=${SIMPLE_STAGE4_DIAG_SEMANTIC_RUNNER:-}
EVAL_RUNNER=${SIMPLE_STAGE4_DIAG_EVAL_RUNNER:-}
EVAL_POLICY=auto
KEEP_WORK=0
COMPILE_CACHE_HITS=0
SEMANTIC_CACHE_HITS=0
EVAL_CACHE_HITS=0

usage() {
    cat <<'EOF'
Usage: stage4-diagnostic-two-phase.shs [options] <file-or-directory>...

Required runner contract:
  --compile-runner PATH   compile through HIR/MIR/codegen and emit artifacts
  --semantic-runner PATH  check every successful compiled artifact
  --eval-runner PATH      evaluate runnable/spec artifacts (when selected)

Options:
  --workers N             dynamic worker count (default 32)
  --timeout SEC           per-file runner timeout (default 600)
  --cache-dir DIR         source/compiler/artifact-hashed cache
  --result-dir DIR        deterministic result tables and summary
  --eval auto|all         evaluate runnable/spec files or every semantic pass
  --keep-work             retain private scheduler scratch directory

Environment equivalents use SIMPLE_STAGE4_DIAG_{COMPILE,SEMANTIC,EVAL}_RUNNER,
SIMPLE_STAGE4_DIAG_WORKERS, SIMPLE_STAGE4_DIAG_TIMEOUT_SEC,
SIMPLE_STAGE4_DIAG_CACHE_DIR, and SIMPLE_STAGE4_DIAG_RESULT_DIR.
SIMPLE_STAGE4_DIAG_COMPILER_DIGEST may pin a source+compiler build digest when
the compile runner is only a wrapper; otherwise the compile executable is
hashed directly.

Runner input is an immutable TSV manifest:
  id  source_digest  path
Artifact consumers additionally receive --artifact-manifest=PATH with rows:
  id  source_digest  path  artifact_path  artifact_digest
Every live runner must append exactly one start and one result TSV row:
  schema_version event id path source_digest compiler_digest mode status
  exit_code elapsed_ms diagnostic_class artifact_path
EOF
}

die() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 2
}

is_uint() {
    [[ $1 =~ ^[0-9]+$ ]]
}

reject_record_breakers() {
    local value=$1 label=$2
    [[ $value != *$'\t'* ]] || die "$label contains a tab"
    [[ $value != *$'\n'* ]] || die "$label contains a newline"
    [[ -n $value ]] || die "$label is empty"
}

command_digest() {
    local command_path=$1 resolved
    if [[ $command_path == */* ]]; then
        resolved=$command_path
    else
        resolved=$(command -v -- "$command_path" 2>/dev/null || true)
    fi
    [[ -n $resolved && -f $resolved ]] || return 1
    sha256sum -- "$resolved" | awk '{print $1}'
}

TMP_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/stage4-diagnostic-two-phase.XXXXXX") || die "mktemp failed"
TARGET_FILE=$TMP_ROOT/targets
: > "$TARGET_FILE"

cleanup() {
    local rc=$?
    if [[ $KEEP_WORK -eq 0 ]]; then
        rm -rf -- "$TMP_ROOT"
    else
        printf 'stage4 diagnostic work retained: %s\n' "$TMP_ROOT" >&2
    fi
    return "$rc"
}
trap cleanup EXIT

while [[ $# -gt 0 ]]; do
    case $1 in
        --workers) [[ $# -ge 2 ]] || die "--workers needs a value"; WORKERS=$2; shift 2 ;;
        --workers=*) WORKERS=${1#*=}; shift ;;
        --timeout) [[ $# -ge 2 ]] || die "--timeout needs a value"; TIMEOUT_SEC=$2; shift 2 ;;
        --timeout=*) TIMEOUT_SEC=${1#*=}; shift ;;
        --cache-dir) [[ $# -ge 2 ]] || die "--cache-dir needs a value"; CACHE_DIR=$2; shift 2 ;;
        --cache-dir=*) CACHE_DIR=${1#*=}; shift ;;
        --result-dir) [[ $# -ge 2 ]] || die "--result-dir needs a value"; RESULT_DIR=$2; shift 2 ;;
        --result-dir=*) RESULT_DIR=${1#*=}; shift ;;
        --compile-runner) [[ $# -ge 2 ]] || die "--compile-runner needs a value"; COMPILE_RUNNER=$2; shift 2 ;;
        --compile-runner=*) COMPILE_RUNNER=${1#*=}; shift ;;
        --semantic-runner) [[ $# -ge 2 ]] || die "--semantic-runner needs a value"; SEMANTIC_RUNNER=$2; shift 2 ;;
        --semantic-runner=*) SEMANTIC_RUNNER=${1#*=}; shift ;;
        --eval-runner) [[ $# -ge 2 ]] || die "--eval-runner needs a value"; EVAL_RUNNER=$2; shift 2 ;;
        --eval-runner=*) EVAL_RUNNER=${1#*=}; shift ;;
        --eval) [[ $# -ge 2 ]] || die "--eval needs a value"; EVAL_POLICY=$2; shift 2 ;;
        --eval=*) EVAL_POLICY=${1#*=}; shift ;;
        --keep-work) KEEP_WORK=1; shift ;;
        -h|--help) usage; exit 0 ;;
        -*) die "unknown option: $1" ;;
        *) reject_record_breakers "$1" "target"; printf '%s\n' "$1" >> "$TARGET_FILE"; shift ;;
    esac
done

is_uint "$WORKERS" && [[ $WORKERS -gt 0 ]] || die "--workers must be a positive integer"
is_uint "$TIMEOUT_SEC" && [[ $TIMEOUT_SEC -gt 0 ]] || die "--timeout must be a positive integer"
[[ $EVAL_POLICY == auto || $EVAL_POLICY == all ]] || die "--eval must be auto or all"
[[ -s $TARGET_FILE ]] || die "no targets selected"

for runner_spec in "compile:$COMPILE_RUNNER" "semantic:$SEMANTIC_RUNNER"; do
    phase=${runner_spec%%:*}
    runner=${runner_spec#*:}
    [[ -n $runner ]] || die "missing $phase runner; set SIMPLE_STAGE4_DIAG_${phase^^}_RUNNER or --$phase-runner"
    [[ -x $runner ]] || command -v -- "$runner" >/dev/null 2>&1 || die "$phase runner is not executable: $runner"
done
if [[ -n $EVAL_RUNNER ]]; then
    [[ -x $EVAL_RUNNER ]] || command -v -- "$EVAL_RUNNER" >/dev/null 2>&1 || die "eval runner is not executable: $EVAL_RUNNER"
fi

reject_record_breakers "$CACHE_DIR" "cache dir"
reject_record_breakers "$RESULT_DIR" "result dir"
mkdir -p -- "$CACHE_DIR" "$RESULT_DIR" || die "cannot create cache/result directories"

COMPILE_RUNNER_DIGEST=$(command_digest "$COMPILE_RUNNER") || die "cannot hash compile runner: $COMPILE_RUNNER"
COMPILE_DIGEST=${SIMPLE_STAGE4_DIAG_COMPILER_DIGEST:-$COMPILE_RUNNER_DIGEST}
reject_record_breakers "$COMPILE_DIGEST" "compiler digest"
SEMANTIC_RUNNER_DIGEST=$(command_digest "$SEMANTIC_RUNNER") || die "cannot hash semantic runner: $SEMANTIC_RUNNER"
EVAL_RUNNER_DIGEST=-
if [[ -n $EVAL_RUNNER ]]; then
    EVAL_RUNNER_DIGEST=$(command_digest "$EVAL_RUNNER") || die "cannot hash eval runner: $EVAL_RUNNER"
fi

# Build one deterministic, deduplicated NUL-delimited path set. Newline/tab
# paths cannot be represented by the runner protocol and are rejected.
RAW_INPUTS=$TMP_ROOT/inputs.raw0
SORTED_INPUTS=$TMP_ROOT/inputs.sorted0
: > "$RAW_INPUTS"
while IFS= read -r target; do
    if [[ -f $target ]]; then
        [[ $target == *.spl ]] || die "selected file is not .spl: $target"
        printf '%s\0' "$target" >> "$RAW_INPUTS"
    elif [[ -d $target ]]; then
        while IFS= read -r -d '' source_path; do
            printf '%s\0' "$source_path" >> "$RAW_INPUTS"
        done < <(find "$target" -type f -name '*.spl' -print0)
    else
        die "target does not exist: $target"
    fi
done < "$TARGET_FILE"
sort -zu "$RAW_INPUTS" > "$SORTED_INPUTS" || die "input sort failed"

SOURCE_MANIFEST=$RESULT_DIR/inputs.tsv
: > "$SOURCE_MANIFEST"
input_id=0
while IFS= read -r -d '' source_path; do
    reject_record_breakers "$source_path" "source path"
    [[ -f $source_path ]] || die "source disappeared during discovery: $source_path"
    input_id=$((input_id + 1))
    source_digest=$(sha256sum -- "$source_path" | awk '{print $1}') || die "cannot hash $source_path"
    printf '%08d\t%s\t%s\n' "$input_id" "$source_digest" "$source_path" >> "$SOURCE_MANIFEST"
done < "$SORTED_INPUTS"
SELECTED=$input_id
[[ $SELECTED -gt 0 ]] || die "no .spl files found"

allowed_class() {
    local phase=$1 class=$2
    case $phase:$class in
        compile:compile|compile:hir|compile:mir|compile:codegen|compile:compile_hir_mir_codegen) return 0 ;;
        semantic:semantic|semantic:semantic_hir|semantic:semantic_artifact) return 0 ;;
        eval:eval|eval:interpreter|eval:runtime_eval|eval:spec_eval) return 0 ;;
    esac
    return 1
}

synth_result() {
    local output=$1 id=$2 path=$3 source_digest=$4 mode=$5 exit_code=$6 elapsed_ms=$7 class=$8
    printf '%s\tresult\t%s\t%s\t%s\t%s\t%s\tfail\t%s\t%s\t%s\t-\n' \
        "$SCHEMA_VERSION" "$id" "$path" "$source_digest" "$COMPILE_DIGEST" "$mode" \
        "$exit_code" "$elapsed_ms" "$class" > "$output"
}

validate_live_result() {
    local phase=$1 raw=$2 normalized=$3 id=$4 path=$5 source_digest=$6 mode=$7 runner_rc=$8
    local start_count result_count row status class artifact
    start_count=$(awk -F '\t' -v id="$id" '$2=="start" && $3==id {n++} END {print n+0}' "$raw" 2>/dev/null)
    result_count=$(awk -F '\t' -v id="$id" '$2=="result" && $3==id {n++} END {print n+0}' "$raw" 2>/dev/null)
    if [[ $start_count -ne 1 || $result_count -ne 1 ]]; then
        return 1
    fi
    row=$(awk -F '\t' -v id="$id" '$2=="result" && $3==id {print; exit}' "$raw")
    [[ $(awk -F '\t' 'NR==1 {print NF}' <<< "$row") -eq 12 ]] || return 1
    IFS=$'\t' read -r schema event row_id row_path row_source row_compiler row_mode status exit_code elapsed class artifact <<< "$row"
    [[ $schema == "$SCHEMA_VERSION" && $event == result && $row_id == "$id" ]] || return 1
    [[ $row_path == "$path" && $row_source == "$source_digest" && $row_compiler == "$COMPILE_DIGEST" && $row_mode == "$mode" ]] || return 1
    [[ $status == pass || $status == fail ]] || return 1
    [[ $exit_code =~ ^-?[0-9]+$ && $elapsed =~ ^[0-9]+$ ]] || return 1
    if [[ $status == pass ]]; then
        [[ $runner_rc -eq 0 ]] || return 1
        allowed_class "$phase" "$class" || return 1
        if [[ $phase == compile ]]; then
            [[ $artifact != - && -f $artifact ]] || return 1
        fi
    fi
    printf '%s\n' "$row" > "$normalized"
}

rewrite_cached_id() {
    local cached=$1 output=$2 id=$3 path=$4 source_digest=$5 mode=$6
    awk -F '\t' -v OFS='\t' -v id="$id" -v path="$path" -v src="$source_digest" -v comp="$COMPILE_DIGEST" -v mode="$mode" '
        NF==12 && $2=="result" && $5==src && $6==comp && $7==mode {
            $3=id; $4=path; print; ok=1
        }
        END {if (!ok) exit 1}
    ' "$cached" > "$output"
}

phase_worker() {
    local phase=$1 runner=$2 runner_digest=$3 mode=$4 phase_dir=$5 artifact_jobs=$6
    local jobs_dir=$phase_dir/jobs result_jobs=$phase_dir/results counter=$phase_dir/next lock=$phase_dir/next.lock
    local total_jobs=$7 worker_no=$8
    while :; do
        while ! mkdir "$lock" 2>/dev/null; do sleep 0.01; done
        local next
        next=$(<"$counter")
        if [[ $next -ge $total_jobs ]]; then
            rmdir "$lock"
            break
        fi
        printf '%s\n' $((next + 1)) > "$counter"
        rmdir "$lock"

        local suffix job result raw log artifact_job id source_digest path artifact_digest=- cache_key cache_file start_ms end_ms elapsed_ms rc pgid
        printf -v suffix '%08d' "$next"
        job=$jobs_dir/job.$suffix
        result=$result_jobs/job.$suffix.tsv
        raw=$result_jobs/job.$suffix.raw.tsv
        log=$result_jobs/job.$suffix.log
        IFS=$'\t' read -r id source_digest path < "$job"
        artifact_job=-
        if [[ $artifact_jobs != - ]]; then
            artifact_job=$artifact_jobs/job.$suffix
            [[ -f $artifact_job ]] || { synth_result "$result" "$id" "$path" "$source_digest" "$mode" 2 0 harness_missing_artifact_manifest; continue; }
            artifact_digest=$(awk -F '\t' 'NR==1 {print $5}' "$artifact_job")
        fi
        cache_key=$(printf '%s\037%s\037%s\037%s\037%s\037%s' "$phase" "$runner_digest" "$source_digest" "$path" "$artifact_digest" "$mode" | sha256sum | awk '{print $1}')
        cache_file=$CACHE_DIR/$phase/$cache_key.tsv
        mkdir -p -- "$CACHE_DIR/$phase"
        if [[ -f $cache_file ]] && rewrite_cached_id "$cache_file" "$result" "$id" "$path" "$source_digest" "$mode"; then
            printf 'cache\n' > "$result_jobs/job.$suffix.source"
            continue
        fi
        : > "$raw"
        : > "$log"
        start_ms=$(date +%s%3N)
        local runner_args=("--manifest=$job" "--result=$raw" "--compiler-digest=$COMPILE_DIGEST" "--mode=$mode" "--timeout-ms=$((TIMEOUT_SEC * 1000))" "--cache-dir=$CACHE_DIR/runner/$phase")
        if [[ $artifact_job != - ]]; then
            runner_args+=("--artifact-manifest=$artifact_job")
        fi
        setsid timeout --signal=TERM --kill-after=5s "${TIMEOUT_SEC}s" "$runner" "${runner_args[@]}" > "$log" 2>&1 &
        pgid=$!
        wait "$pgid"; rc=$?
        # The timeout process is the session/process-group leader. This final
        # kill is idempotent and prevents escaped descendants after crashes.
        kill -KILL -- "-$pgid" 2>/dev/null || true
        end_ms=$(date +%s%3N)
        elapsed_ms=$((end_ms - start_ms))
        if ! validate_live_result "$phase" "$raw" "$result" "$id" "$path" "$source_digest" "$mode" "$rc"; then
            if [[ $rc -eq 124 || $rc -eq 137 ]]; then
                synth_result "$result" "$id" "$path" "$source_digest" "$mode" "$rc" "$elapsed_ms" timeout
            elif [[ -s $raw ]]; then
                synth_result "$result" "$id" "$path" "$source_digest" "$mode" 2 "$elapsed_ms" coverage_contract
            else
                synth_result "$result" "$id" "$path" "$source_digest" "$mode" "$rc" "$elapsed_ms" runner_crash
            fi
        fi
        if ! awk -F '\t' '$2=="result" && $8=="fail" && ($11=="timeout" || $11=="runner_crash" || $11=="coverage_contract") {bad=1} END {exit bad?0:1}' "$result"; then
            cp -- "$result" "$cache_file"
        fi
        printf 'live\n' > "$result_jobs/job.$suffix.source"
    done
}

run_phase() {
    local phase=$1 runner=$2 runner_digest=$3 mode=$4 manifest=$5 artifact_manifest=$6 output=$7
    local phase_dir=$TMP_ROOT/$phase jobs_dir=$TMP_ROOT/$phase/jobs result_jobs=$TMP_ROOT/$phase/results artifact_jobs=-
    rm -rf -- "$phase_dir"
    mkdir -p -- "$jobs_dir" "$result_jobs"
    split -l 1 -d -a 8 --additional-suffix='' "$manifest" "$jobs_dir/job." || die "$phase manifest split failed"
    local total_jobs
    total_jobs=$(find "$jobs_dir" -maxdepth 1 -type f -name 'job.*' | wc -l)
    if [[ $artifact_manifest != - ]]; then
        artifact_jobs=$phase_dir/artifact-jobs
        mkdir -p -- "$artifact_jobs"
        split -l 1 -d -a 8 --additional-suffix='' "$artifact_manifest" "$artifact_jobs/job." || die "$phase artifact manifest split failed"
        [[ $(find "$artifact_jobs" -maxdepth 1 -type f -name 'job.*' | wc -l) -eq $total_jobs ]] || die "$phase artifact/source manifest count mismatch"
    fi
    : > "$output"
    [[ $total_jobs -gt 0 ]] || return 0
    printf '0\n' > "$phase_dir/next"
    local worker_count=$WORKERS
    [[ $worker_count -le $total_jobs ]] || worker_count=$total_jobs
    local worker_pids=() worker_no
    for ((worker_no=0; worker_no<worker_count; worker_no++)); do
        phase_worker "$phase" "$runner" "$runner_digest" "$mode" "$phase_dir" "$artifact_jobs" "$total_jobs" "$worker_no" &
        worker_pids+=("$!")
    done
    local worker_fail=0 worker_pid
    for worker_pid in "${worker_pids[@]}"; do
        wait "$worker_pid" || worker_fail=1
    done
    [[ $worker_fail -eq 0 ]] || die "$phase scheduler worker failed"
    local suffix
    for ((worker_no=0; worker_no<total_jobs; worker_no++)); do
        printf -v suffix '%08d' "$worker_no"
        [[ -s $result_jobs/job.$suffix.tsv ]] || die "$phase missing terminal row for job $suffix"
        cat "$result_jobs/job.$suffix.tsv" >> "$output"
    done
    local result_count
    result_count=$(awk -F '\t' '$2=="result" {n++} END {print n+0}' "$output")
    [[ $result_count -eq $total_jobs ]] || die "$phase results ($result_count) != inputs ($total_jobs)"
    local cache_hits
    cache_hits=$(grep -l '^cache$' "$result_jobs"/*.source 2>/dev/null | wc -l)
    case $phase in
        compile) COMPILE_CACHE_HITS=$cache_hits ;;
        semantic) SEMANTIC_CACHE_HITS=$cache_hits ;;
        eval) EVAL_CACHE_HITS=$cache_hits ;;
    esac
}

build_artifact_manifest() {
    local results=$1 manifest=$2 artifacts=$3
    : > "$manifest"
    : > "$artifacts"
    while IFS=$'\t' read -r schema event id path source_digest compiler mode status exit_code elapsed class artifact; do
        [[ $event == result && $status == pass ]] || continue
        [[ -f $artifact ]] || die "passing compile result lost artifact: $artifact"
        artifact_digest=$(sha256sum -- "$artifact" | awk '{print $1}') || die "cannot hash artifact $artifact"
        printf '%s\t%s\t%s\n' "$id" "$source_digest" "$path" >> "$manifest"
        printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$source_digest" "$path" "$artifact" "$artifact_digest" >> "$artifacts"
    done < "$results"
}

source_requires_eval() {
    local path=$1
    case $path in
        test/*|*/test/*|examples/*|bench/*|*_spec.spl|*_entry.spl|*/main.spl|*_main.spl) return 0 ;;
    esac
    # Source markers cover named entrypoints, SSpec/SPipe declarations, and
    # explicit entry annotations. False positives only add an eval; they do not
    # suppress diagnostics.
    awk '
        /^[[:space:]]*#/ {next}
        /(^|[[:space:]])fn[[:space:]]+main[[:space:]]*\(/ {found=1}
        /^[[:space:]]*(describe|context|scenario|feature|it|step)[[:space:](\"]/{found=1}
        /^[[:space:]]*@entry([[:space:](]|$)/ {found=1}
        END {exit found?0:1}
    ' "$path"
}

COMPILE_RESULTS=$RESULT_DIR/compile.tsv
run_phase compile "$COMPILE_RUNNER" "$COMPILE_DIGEST" native "$SOURCE_MANIFEST" - "$COMPILE_RESULTS"

SEMANTIC_MANIFEST=$TMP_ROOT/semantic.manifest
SEMANTIC_ARTIFACTS=$TMP_ROOT/semantic.artifacts
build_artifact_manifest "$COMPILE_RESULTS" "$SEMANTIC_MANIFEST" "$SEMANTIC_ARTIFACTS"
SEMANTIC_RESULTS=$RESULT_DIR/semantic.tsv
run_phase semantic "$SEMANTIC_RUNNER" "$SEMANTIC_RUNNER_DIGEST" dynload "$SEMANTIC_MANIFEST" "$SEMANTIC_ARTIFACTS" "$SEMANTIC_RESULTS"

# Only semantic passes are eligible for execution. Compile/semantic failures
# remain failures and are never hidden by a later eval result.
EVAL_MANIFEST=$TMP_ROOT/eval.manifest
EVAL_ARTIFACTS=$TMP_ROOT/eval.artifacts
: > "$EVAL_MANIFEST"
: > "$EVAL_ARTIFACTS"
while IFS=$'\t' read -r schema event id path source_digest compiler mode status exit_code elapsed class artifact; do
    [[ $event == result && $status == pass ]] || continue
    if [[ $EVAL_POLICY == all ]] || source_requires_eval "$path"; then
        artifact_row=$(awk -F '\t' -v id="$id" '$1==id {print; exit}' "$SEMANTIC_ARTIFACTS")
        [[ -n $artifact_row ]] || die "missing eval artifact row for $path"
        printf '%s\t%s\t%s\n' "$id" "$source_digest" "$path" >> "$EVAL_MANIFEST"
        printf '%s\n' "$artifact_row" >> "$EVAL_ARTIFACTS"
    fi
done < "$SEMANTIC_RESULTS"

EVAL_RESULTS=$RESULT_DIR/eval.tsv
: > "$EVAL_RESULTS"
EVAL_REQUIRED=$(wc -l < "$EVAL_MANIFEST")
if [[ $EVAL_REQUIRED -gt 0 ]]; then
    [[ -n $EVAL_RUNNER ]] || die "$EVAL_REQUIRED runnable/spec artifact(s) require eval, but no eval runner is configured"
    run_phase eval "$EVAL_RUNNER" "$EVAL_RUNNER_DIGEST" dynload "$EVAL_MANIFEST" "$EVAL_ARTIFACTS" "$EVAL_RESULTS"
fi

count_status() {
    local file=$1 status=$2
    awk -F '\t' -v status="$status" '$2=="result" && $8==status {n++} END {print n+0}' "$file"
}
count_class() {
    local file=$1 class=$2
    awk -F '\t' -v class="$class" '$2=="result" && $11==class {n++} END {print n+0}' "$file"
}

COMPILE_PASS=$(count_status "$COMPILE_RESULTS" pass)
COMPILE_FAIL=$(count_status "$COMPILE_RESULTS" fail)
SEMANTIC_REQUIRED=$(wc -l < "$SEMANTIC_MANIFEST")
SEMANTIC_PASS=$(count_status "$SEMANTIC_RESULTS" pass)
SEMANTIC_FAIL=$(count_status "$SEMANTIC_RESULTS" fail)
EVAL_PASS=$(count_status "$EVAL_RESULTS" pass)
EVAL_FAIL=$(count_status "$EVAL_RESULTS" fail)
TIMEOUTS=$(( $(count_class "$COMPILE_RESULTS" timeout) + $(count_class "$SEMANTIC_RESULTS" timeout) + $(count_class "$EVAL_RESULTS" timeout) ))
HARNESS_FAILURES=$(( $(count_class "$COMPILE_RESULTS" coverage_contract) + $(count_class "$COMPILE_RESULTS" runner_crash) + $(count_class "$SEMANTIC_RESULTS" coverage_contract) + $(count_class "$SEMANTIC_RESULTS" runner_crash) + $(count_class "$EVAL_RESULTS" coverage_contract) + $(count_class "$EVAL_RESULTS" runner_crash) ))
TOTAL_FAILURES=$((COMPILE_FAIL + SEMANTIC_FAIL + EVAL_FAIL))

FAILURES=$RESULT_DIR/failures.tsv
{
    awk -F '\t' -v OFS='\t' -v phase=compile '$2=="result" && $8=="fail" {print phase,$11,$4,$9,$10}' "$COMPILE_RESULTS"
    awk -F '\t' -v OFS='\t' -v phase=semantic '$2=="result" && $8=="fail" {print phase,$11,$4,$9,$10}' "$SEMANTIC_RESULTS"
    awk -F '\t' -v OFS='\t' -v phase=eval '$2=="result" && $8=="fail" {print phase,$11,$4,$9,$10}' "$EVAL_RESULTS"
} | LC_ALL=C sort -t $'\t' -k2,2 -k3,3 -k1,1 > "$FAILURES"

SUMMARY=$RESULT_DIR/summary.tsv
{
    printf 'schema_version\t%s\n' "$SCHEMA_VERSION"
    printf 'selected\t%s\n' "$SELECTED"
    printf 'compile_pass\t%s\n' "$COMPILE_PASS"
    printf 'compile_fail\t%s\n' "$COMPILE_FAIL"
    printf 'compile_cache_hits\t%s\n' "$COMPILE_CACHE_HITS"
    printf 'semantic_required\t%s\n' "$SEMANTIC_REQUIRED"
    printf 'semantic_pass\t%s\n' "$SEMANTIC_PASS"
    printf 'semantic_fail\t%s\n' "$SEMANTIC_FAIL"
    printf 'semantic_cache_hits\t%s\n' "$SEMANTIC_CACHE_HITS"
    printf 'eval_required\t%s\n' "$EVAL_REQUIRED"
    printf 'eval_pass\t%s\n' "$EVAL_PASS"
    printf 'eval_fail\t%s\n' "$EVAL_FAIL"
    printf 'eval_cache_hits\t%s\n' "$EVAL_CACHE_HITS"
    printf 'timeouts\t%s\n' "$TIMEOUTS"
    printf 'harness_failures\t%s\n' "$HARNESS_FAILURES"
    printf 'total_failures\t%s\n' "$TOTAL_FAILURES"
    printf 'deployed_artifacts\t0\n'
} > "$SUMMARY"

printf 'stage4 diagnostic: selected=%s compile=%s/%s semantic=%s/%s eval=%s/%s failures=%s timeouts=%s\n' \
    "$SELECTED" "$COMPILE_PASS" "$SELECTED" "$SEMANTIC_PASS" "$SEMANTIC_REQUIRED" "$EVAL_PASS" "$EVAL_REQUIRED" "$TOTAL_FAILURES" "$TIMEOUTS"
printf 'results: %s\n' "$RESULT_DIR"

if [[ $HARNESS_FAILURES -gt 0 ]]; then
    printf 'ERROR: diagnostic instrument failed coverage/runner contract for %s file-phase result(s)\n' "$HARNESS_FAILURES" >&2
    exit 2
fi
if [[ $TOTAL_FAILURES -gt 0 ]]; then
    printf 'FAIL: %s file-phase failure(s); deterministic groups: %s\n' "$TOTAL_FAILURES" "$FAILURES" >&2
    exit 1
fi
printf 'PASS: every selected file compiled and passed semantic checks; all required runnable/spec artifacts evaluated\n'
exit 0
