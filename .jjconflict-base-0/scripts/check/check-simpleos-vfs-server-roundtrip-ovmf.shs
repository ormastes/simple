#!/bin/sh
# check-simpleos-vfs-server-roundtrip-ovmf.shs
#
# Proves the SimpleOS VFS FILESYSTEM SERVER is genuinely RUNNING in-guest, by a
# DATA round-trip that is verified through a FILESYSTEM CHECK.
#
# Boot is OVMF pflash -> GRUB-EFI (a real EFI application) -> multiboot1 kernel.
# NEVER QEMU `-kernel`, NEVER isa-debug-exit — the assembled argv is
# self-checked for both forbidden flags before the VM is started, so the same
# artifact could boot on hardware (.claude/rules/board-runnable.md).
#
# COMPILER: the RUST BOOTSTRAP SEED, on purpose and stated in the verdict. The
# pure-Simple self-hosted compiler cannot compile anything in this tree yet.
# `--timeout 1200` is passed to native-build deliberately: the 300s default
# makes modules that compile fine "fail". A timeout is not a compile error.
#
# WHY A BANNER IS NOT ACCEPTED, AND A PATH EXISTING IS NOT ACCEPTED:
# the payload is a PER-RUN NONCE minted into build/os/generated by THIS run.
# The gate greps for that exact nonce, in the serial transcript AND in the raw
# NVMe image on the host. A stale kernel, a stale disk image, or a probe that
# printed a banner without moving data all carry the wrong nonce (or none) and
# FAIL. The NVMe volume is a raw FAT32 SimpleOS SYSTEM volume with no partition
# table. It is NOT blank: vfs_boot_init_production() fails closed on a blank
# disk, and that production check is deliberately NOT relaxed to make this gate
# pass (see step 2 and scripts/os/build_vfsrt_system_volume.shs). What makes the
# read-back honest is the nonce, not emptiness — the freshly minted volume is
# asserted to contain neither the nonce nor a /VFSRT.TXT entry before boot.
#
# REQUIRED RUNGS (serial log) — all must be present:
#   L1  "[grub-uefi] multiboot loading"        OVMF -> GRUB-EFI app ran
#   L2  "[vfsrt] probe begin nonce=<NONCE>"    guest entered, carrying THIS nonce
#   L3  "[vfsrt] vfs_boot_init_production ok=true"  storage stack came up
#   L4  "[vfsrt] fs-server up ready=true"      filesystem service is serving
#   L5  "[vfsrt] server write path=/VFSRT.TXT ok=true"  server ACCEPTED a write
#   L6  "[vfsrt] server read-back=vfsrt-nonce:<NONCE>"  server RETURNED the data
#   L7  "[vfsrt] ROUNDTRIP_OK nonce=<NONCE>"   write and read-back are identical
# REQUIRED HOST-SIDE FILESYSTEM CHECK:
#   L8  the nonce bytes are physically present in the raw NVMe image — an
#       independent check outside the guest that the data reached the disk.
# ADVISORY (never contributes to the PASS count, never turns the lane green):
#   A1  "[vfsrt] ipc-port attempted"           named `vfs` IPC endpoint. In a
#       freestanding multiboot image the `syscall` extern VfsService.init_port()
#       needs has no backing, so this half is expected RED. Reported, not gated.
#
# Verdict is the LAST line of stdout:
#   PASS  — <n> check(s) checked, ...   exit 0
#   FAIL  — ...                         exit 1
#   ERROR — nothing was checked: ...    exit 2
# 0 checks executed is an ERROR, never a PASS. A missing tool, a missing OVMF
# firmware, a missing seed, or no serial transcript is an ERROR, never a PASS.
#
# `--selftest` runs, fatally, before every real scan. Its fixtures include a
# must-FAIL in which the server is NOT running but the path EXISTS and carries
# a STALE nonce — so the gate cannot pass on a stale artifact.
#
# Env: SEED, SKIP_KERNEL=1 (reuse existing kernel), QEMU_MEM (2G), BOOT_WAIT,
#      OVMF_CODE, OVMF_VARS_SRC, VFSRT_NONCE (selftest only).

set -eu
ROOT=$(cd "$(dirname "$0")/../.." && pwd)
cd "$ROOT"

SEED="${SEED:-src/compiler_rust/target/release/simple}"
ENTRY="examples/09_embedded/simple_os/arch/x86_64/vfs_server_roundtrip_entry.spl"
LINKER="examples/09_embedded/simple_os/arch/x86_64/linker_128mb.ld"
OUT="build/os/vfsrt"
KERNEL="build/os/simpleos_vfsrt_uefi.elf"
IMG="$OUT/fat32-vfsrt.img"
SERIAL="$OUT/vfs_server_roundtrip_ovmf.serial.log"
CACHE="$OUT/cache"
BUILD="$OUT/uefi"
ESP="$BUILD/esp"
EFIAPP="$ESP/EFI/BOOT/BOOTX64.EFI"
NONCE_SPL="build/os/generated/vfs_roundtrip_nonce.spl"
OVMF_CODE="${OVMF_CODE:-/usr/share/OVMF/OVMF_CODE_4M.fd}"
OVMF_VARS_SRC="${OVMF_VARS_SRC:-/usr/share/OVMF/OVMF_VARS_4M.fd}"
OVMF_VARS="$BUILD/OVMF_VARS_4M.fd"
QEMU_MEM="${QEMU_MEM:-2G}"
BOOT_WAIT="${BOOT_WAIT:-180}"

fail()    { echo "FAIL — $1"; exit 1; }
nothing() { echo "ERROR — nothing was checked: $1"; exit 2; }

# ---------------------------------------------------------------------------
# scan_serial <log> <nonce> — 0 when every REQUIRED serial rung is present.
# Anchored on the nonce-bearing rungs, deliberately not on line counts and not
# on the firmware banner: a complete boot transcript with the server silent, or
# one carrying a DIFFERENT nonce, must FAIL.
# ---------------------------------------------------------------------------
scan_serial() {
    _log=$1; _n=$2; _miss=""
    grep -qF '[grub-uefi] multiboot loading'                 "$_log" || _miss="$_miss L1"
    grep -qF "[vfsrt] probe begin nonce=$_n"                 "$_log" || _miss="$_miss L2"
    grep -qF '[vfsrt] vfs_boot_init_production ok=true'      "$_log" || _miss="$_miss L3"
    grep -qF '[vfsrt] fs-server up ready=true'               "$_log" || _miss="$_miss L4"
    grep -qF '[vfsrt] server write path=/VFSRT.TXT ok=true'  "$_log" || _miss="$_miss L5"
    grep -qF "[vfsrt] server read-back=vfsrt-nonce:$_n"      "$_log" || _miss="$_miss L6"
    grep -qF "[vfsrt] ROUNDTRIP_OK nonce=$_n"                "$_log" || _miss="$_miss L7"
    SCAN_MISSING=$_miss
    [ -z "$_miss" ]
}

# ---------------------------------------------------------------------------
# scan_image <img> <nonce> — 0 when the nonce bytes are physically in the raw
# NVMe image. THE filesystem check: independent of anything the guest printed.
# ---------------------------------------------------------------------------
scan_image() {
    [ -f "$1" ] || return 1
    grep -qa "vfsrt-nonce:$2" "$1"
}

# ---------------------------------------------------------------------------
# argv self-check. Needles are assembled from fragments so this check can
# neither be defeated by, nor accidentally fire on, the surrounding prose.
# ---------------------------------------------------------------------------
assert_real_firmware_argv() {
    _k="-""kernel"
    _d="isa""-debug-exit"
    for _a in "$@"; do
        case "$_a" in
            "$_k"|*"$_d"*) echo "FAIL — forbidden QEMU flag in argv: $_a"; exit 1 ;;
        esac
    done
    case " $* " in
        *" $_k "*) echo "FAIL — forbidden QEMU flag in argv: $_k"; exit 1 ;;
    esac
}

# ---------------------------------------------------------------------------
# --selftest — fatal, runs before every real scan.
# ---------------------------------------------------------------------------
selftest() {
    _t=$(mktemp -d); _rc=0
    _ok_n="AAAA1111"; _stale_n="BBBB2222"

    # F1 must-PASS: a complete, honest transcript at the current nonce.
    cat > "$_t/ok.log" <<EOF
[grub-uefi] multiboot loading /boot/kernel.elf ...
[vfsrt] probe begin nonce=$_ok_n
[vfsrt] vfs_boot_init_production ok=true
[vfsrt] fs-server up ready=true
[vfsrt] server write path=/VFSRT.TXT ok=true
[vfsrt] server read-back=vfsrt-nonce:$_ok_n
[vfsrt] ROUNDTRIP_OK nonce=$_ok_n
EOF
    scan_serial "$_t/ok.log" "$_ok_n" || { echo "  selftest F1 FAILED (honest transcript rejected)"; _rc=1; }

    # F2 must-FAIL — THE stale-artifact fixture. The server is NOT running:
    # no fs-server rung, no write, no round-trip. But the path EXISTS and the
    # transcript carries a STALE nonce from a previous run. A gate that keyed
    # on "the path is there" or on a fixed marker would pass this.
    cat > "$_t/stale.log" <<EOF
[grub-uefi] multiboot loading /boot/kernel.elf ...
[vfsrt] probe begin nonce=$_stale_n
[vfsrt] vfs_boot_init_production ok=false
[vfsrt] server stat exists=true
[vfsrt] server read-back=vfsrt-nonce:$_stale_n
[vfsrt] ROUNDTRIP_OK nonce=$_stale_n
EOF
    if scan_serial "$_t/stale.log" "$_ok_n"; then
        echo "  selftest F2 FAILED (stale artifact with existing path accepted)"; _rc=1
    fi

    # F3 must-FAIL: firmware booted and the probe entered at the RIGHT nonce,
    # but the server never moved data — a banner is not proof.
    cat > "$_t/banner.log" <<EOF
[grub-uefi] multiboot loading /boot/kernel.elf ...
[vfsrt] probe begin nonce=$_ok_n
[vfsrt] vfs_boot_init_production ok=true
[vfsrt] fs-server up ready=true
EOF
    if scan_serial "$_t/banner.log" "$_ok_n"; then
        echo "  selftest F3 FAILED (banner-only transcript accepted)"; _rc=1
    fi

    # F4 must-FAIL: an empty transcript.
    : > "$_t/empty.log"
    if scan_serial "$_t/empty.log" "$_ok_n"; then
        echo "  selftest F4 FAILED (empty transcript accepted)"; _rc=1
    fi

    # F5 image check must-PASS: nonce bytes physically present.
    printf 'junk\0\0vfsrt-nonce:%s\0\0junk' "$_ok_n" > "$_t/ok.img"
    scan_image "$_t/ok.img" "$_ok_n" || { echo "  selftest F5 FAILED (nonce in image not found)"; _rc=1; }

    # F6 image check must-FAIL: an image carrying only the STALE nonce. This is
    # the disk-side half of the stale-artifact fixture.
    printf 'junk\0\0vfsrt-nonce:%s\0\0junk' "$_stale_n" > "$_t/stale.img"
    if scan_image "$_t/stale.img" "$_ok_n"; then
        echo "  selftest F6 FAILED (stale image accepted)"; _rc=1
    fi

    # F7 image check must-FAIL: a missing image is not a pass.
    if scan_image "$_t/nope.img" "$_ok_n"; then
        echo "  selftest F7 FAILED (missing image accepted)"; _rc=1
    fi

    # F8 argv guard must-FAIL on each forbidden flag, in a subshell so the
    # guard's own exit does not kill the selftest.
    for _bad in "-kernel" "-device isa-debug-exit,iobase=0xf4"; do
        # shellcheck disable=SC2086
        if ( assert_real_firmware_argv qemu-system-x86_64 -m 2G $_bad >/dev/null 2>&1 ); then
            echo "  selftest F8 FAILED (argv guard missed: $_bad)"; _rc=1
        fi
    done

    # F9 argv guard must-PASS on the real, compliant argv.
    if ! ( assert_real_firmware_argv qemu-system-x86_64 -machine q35 \
            -drive "if=pflash,format=raw,file=OVMF_CODE.fd" >/dev/null 2>&1 ); then
        echo "  selftest F9 FAILED (argv guard rejected a compliant argv)"; _rc=1
    fi

    rm -rf "$_t"
    [ "$_rc" -eq 0 ] || { echo "ERROR — nothing was checked: selftest failed"; exit 2; }
    echo "[vfsrt] selftest: 9 fixture(s) OK"
}

selftest
[ "${1:-}" = "--selftest" ] && { echo "PASS — 9 check(s) checked, selftest fixtures only (no VM was booted)"; exit 0; }

# ---------------------------------------------------------------------------
# Preconditions — every one of these is ERROR, never a pass.
# ---------------------------------------------------------------------------
command -v qemu-system-x86_64 >/dev/null 2>&1 || nothing "qemu-system-x86_64 missing"
command -v grub-mkstandalone  >/dev/null 2>&1 || nothing "grub-mkstandalone missing"
command -v cc                >/dev/null 2>&1 || nothing "cc missing (needed to build the FAT32 system-volume writer)"
[ -f "$OVMF_CODE" ]     || nothing "OVMF_CODE missing at $OVMF_CODE"
[ -f "$OVMF_VARS_SRC" ] || nothing "OVMF_VARS missing at $OVMF_VARS_SRC"
[ -f "$SEED" ]          || nothing "seed missing at $SEED (build it: cargo build --release --bin simple)"
mkdir -p "$OUT" build/os/generated

# ---- 1. Mint THIS run's nonce ---------------------------------------------
NONCE="${VFSRT_NONCE:-$(date -u +%Y%m%d%H%M%S)$$}"
printf 'pub fn vfs_roundtrip_nonce() -> text:\n    "%s"\n' "$NONCE" > "$NONCE_SPL"
echo "[vfsrt] nonce=$NONCE -> $NONCE_SPL"

# ---- 2. SimpleOS system FAT32 NVMe volume (raw, no partition table) -------
# Recreated EVERY run: a previous run's file must never satisfy this one.
#
# This volume is NOT blank. `vfs_boot_init_production()` fails closed unless the
# disk carries the system payloads a production SimpleOS boot requires (version
# probe + the BROWSMF/HELLOSMF/CLANGSMF app slots, the first of which must carry
# ELF magic). That refusal is correct and is NOT relaxed to make this gate pass;
# the ARTIFACT was brought up to the production contract instead. See
# scripts/os/build_vfsrt_system_volume.shs for the full justification.
#
# The gate's honesty never rested on emptiness — it rests on the PER-RUN NONCE.
# Both anchors below are asserted on the FRESH volume, before anything boots:
# the nonce must be absent, and /VFSRT.TXT must not already exist. So every
# nonce byte read back afterwards is still a byte this run's guest wrote.
rm -f "$IMG"
sh scripts/os/build_vfsrt_system_volume.shs "$IMG" "${VFSRT_VOLUME_MIB:-512}" \
    || nothing "system volume staging failed for $IMG"
scan_image "$IMG" "$NONCE" && nothing "fresh image already contains the nonce (impossible; refusing)"
grep -qa 'VFSRT   TXT' "$IMG" && nothing "fresh image already carries a /VFSRT.TXT directory entry (refusing)"

# ---- 3. Kernel (RUST SEED; --timeout 1200 deliberate) ----------------------
if [ "${SKIP_KERNEL:-0}" != "1" ] || [ ! -f "$KERNEL" ]; then
    OBJCOPY_PREFIX=""
    for d in /usr/lib/llvm-23/bin /usr/lib/llvm-20/bin /usr/lib/llvm-19/bin /usr/lib/llvm-18/bin; do
        [ -f "$d/llvm-objcopy" ] && OBJCOPY_PREFIX="$d" && break
    done
    rm -rf "$CACHE"; mkdir -p "$CACHE"; rm -f "$KERNEL"
    echo "[vfsrt] building kernel -> $KERNEL (rust seed: $SEED)"
    SIMPLE_BOOTSTRAP=1 SIMPLE_LIB="$ROOT/src" SIMPLE_OS_LOG_MODE=off SIMPLE_ALLOW_FREESTANDING_STUBS=1 \
    PATH="${OBJCOPY_PREFIX:+$OBJCOPY_PREFIX:}$PATH" \
        "$SEED" native-build --source build/os/generated --source src/os --source src/lib \
        --source examples/09_embedded/simple_os --backend cranelift --cpu x86-64-v1 \
        --opt-level=aggressive --log off --entry-closure --cache-dir "$CACHE" \
        --timeout 1200 \
        --entry "$ENTRY" --target x86_64-unknown-none -o "$KERNEL" \
        --linker-script "$LINKER" > "$OUT/kernel-build.log" 2>&1 || true
    if [ ! -f "$KERNEL" ]; then
        # Surface the actual first error, not just "no kernel". A bare
        # "build produced nothing" sent three iterations of this lane chasing
        # the wrong layer; the linker's own words identify the blocker.
        FIRSTERR=$(grep -m1 "symbol not found\|Build failed\|failed to compile" "$OUT/kernel-build.log" 2>/dev/null || true)
        nothing "kernel build produced no $KERNEL: ${FIRSTERR:-see $OUT/kernel-build.log}"
    fi
fi
echo "[vfsrt] kernel=$KERNEL ($(stat -c%s "$KERNEL") bytes)"

# ---- 4. ESP: self-contained BOOTX64.EFI with the kernel in its memdisk -----
rm -rf "$BUILD"; mkdir -p "$ESP/EFI/BOOT"
cp "$OVMF_VARS_SRC" "$OVMF_VARS"
cat > "$BUILD/grub.cfg" <<'CFG'
set timeout=0
set default=0
insmod multiboot
insmod normal
menuentry "SimpleOS VFS server round-trip probe (UEFI/multiboot)" {
    echo "[grub-uefi] multiboot loading /boot/kernel.elf ..."
    multiboot /boot/kernel.elf
    boot
}
CFG
grub-mkstandalone --format=x86_64-efi --output="$EFIAPP" \
    --modules="multiboot normal echo part_gpt fat" \
    "boot/grub/grub.cfg=$BUILD/grub.cfg" "boot/kernel.elf=$KERNEL" \
    >/dev/null 2>&1 || nothing "grub-mkstandalone failed"
[ -f "$EFIAPP" ] || nothing "grub-mkstandalone produced no $EFIAPP"

# ---- 5. Assemble the argv FIRST, self-check it, then boot -----------------
rm -f "$SERIAL"
set -- qemu-system-x86_64 -no-user-config -monitor none -nographic -no-reboot \
    -machine q35 -cpu qemu64 -m "$QEMU_MEM" \
    -drive "if=pflash,format=raw,readonly=on,file=$OVMF_CODE" \
    -drive "if=pflash,format=raw,file=$OVMF_VARS" \
    -drive "file=fat:rw:$ESP,format=raw,id=esp,if=none" \
    -device virtio-blk-pci,drive=esp,bootindex=0 \
    -serial "file:$SERIAL" \
    -drive "file=$IMG,if=none,id=nvm,format=raw" \
    -device nvme,serial=deadbeef,drive=nvm
assert_real_firmware_argv "$@"

"$@" >/dev/null 2>&1 &
QEMU_PID=$!
trap 'kill "$QEMU_PID" 2>/dev/null || true' EXIT

i=0
while [ "$i" -lt "$BOOT_WAIT" ]; do
    if [ -f "$SERIAL" ] && { grep -qF '[vfsrt] probe complete' "$SERIAL" 2>/dev/null \
                          || grep -qF '[vfsrt] PROBE FAILED'  "$SERIAL" 2>/dev/null; }; then
        break
    fi
    sleep 1
    i=$((i + 1))
done
sleep 2
kill "$QEMU_PID" 2>/dev/null || true
wait "$QEMU_PID" 2>/dev/null || true

[ -f "$SERIAL" ] || nothing "no serial transcript was produced"

# ---- 6. Verdict ------------------------------------------------------------
echo "[vfsrt] serial transcript: $SERIAL"
if grep -qF '[vfsrt] ipc-port attempted' "$SERIAL" 2>/dev/null; then
    echo "  [ADVISORY] A1  named vfs IPC endpoint attempted (never gated; see header)"
else
    echo "  [ADVISORY] A1  named vfs IPC endpoint NOT reached (never gated; see header)"
fi

CHECKED=0
MISSING=""

scan_serial "$SERIAL" "$NONCE" || MISSING="$MISSING$SCAN_MISSING"
CHECKED=$((CHECKED + 7))

if scan_image "$IMG" "$NONCE"; then
    echo "  [OK]   L8  nonce bytes found in the raw NVMe image (host-side filesystem check)"
else
    MISSING="$MISSING L8"
fi
CHECKED=$((CHECKED + 1))

[ "$CHECKED" -gt 0 ] || nothing "0 checks executed"

if [ -n "$MISSING" ]; then
    fail "$CHECKED check(s) checked, missing:$MISSING (nonce=$NONCE, transcript: $SERIAL, image: $IMG)"
fi

echo "PASS — $CHECKED check(s) checked, the KERNEL-RESIDENT SimpleOS VFS filesystem service (cooperative; named-port IPC half advisory-RED, see A1) served a write and a read-back of this run's nonce $NONCE in-guest under OVMF real firmware, and the nonce bytes are physically present in the NVMe image (kernel built by the RUST SEED $SEED, not the self-hosted compiler; transcript: $SERIAL)"
