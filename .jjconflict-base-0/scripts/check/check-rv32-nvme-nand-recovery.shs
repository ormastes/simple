#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
. "$ROOT/scripts/check/lib/require-self-hosted.shs"
ENTRY="$ROOT/examples/09_embedded/simpleos_nvme_fw/fw_rv32/entry.spl"
LOGIC="$ROOT/examples/09_embedded/simpleos_nvme_fw/fw_rv32/logic_nand_read_level.spl"
BRAM_LD="$ROOT/examples/09_embedded/fpga_riscv/rtl/nvme_fw_rv32_bram.ld"
QEMU_LD="$ROOT/src/os/kernel/arch/riscv32/linker.ld"
SIMPLE_BINARY=${NVME_RV32_SIMPLE_BIN:-${SIMPLE_BINARY:-"$ROOT/bin/release/simple"}}

fail() {
    echo "STATUS: FAIL rv32-nvme-nand-recovery: $1" >&2
    exit 1
}

check_markers() {
    log=$1
    last_line=0
    for marker in \
        "NAND STARTUP PASS" \
        "NAND ADMINQ PASS" \
        "NAND IOQ PASS" \
        "NAND ERASE PASS" \
        "NAND PROGRAM PASS" \
        "NAND READ PASS" \
        "NAND PREVENT PASS" \
        "NAND EVIDENCE D1 U1 F5 C3 T1 M1 Q3 X2 S1 PASS" \
        "NAND RECOVERY PASS" \
        "ALL RV32 NVME FW CHECKS PASS"
    do
        count=$(grep -Fc "$marker" "$log" || true)
        [ "$count" -eq 1 ] || fail "marker count $count, expected 1: $marker"
        line=$(grep -Fn "$marker" "$log" | cut -d: -f1)
        [ "$line" -gt "$last_line" ] || fail "marker out of order: $marker"
        last_line=$line
    done
}

self_test() {
    for file in "$ENTRY" "$LOGIC" "$BRAM_LD" "$QEMU_LD"; do
        [ -f "$file" ] || fail "missing $file"
    done
    grep -Fq "rv32_nand_sense_data" "$LOGIC" || fail "read-level sensing missing"
    grep -Fq "rv32_nand_retry_reference" "$LOGIC" || fail "retry ladder missing"
    grep -Fq "rv32_nand_ecc_correctable" "$LOGIC" || fail "ECC gate missing"
    grep -Fq "rv32_nand_refresh_allowed" "$LOGIC" || fail "verified refresh gate missing"
    grep -Fq "rv32_nand_disturb_level" "$LOGIC" || fail "block disturb model missing"
    grep -Fq "_nandram_start" "$BRAM_LD" || fail "BRAM NAND region missing"
    grep -Fq "_nandram_start" "$QEMU_LD" || fail "QEMU NAND region missing"

    work=$(mktemp -d)
    trap 'rm -rf "$work"' EXIT INT TERM
    printf '%s\n' \
        "NAND STARTUP PASS" "NAND ADMINQ PASS" "NAND IOQ PASS" \
        "NAND ERASE PASS" "NAND PROGRAM PASS" "NAND READ PASS" \
        "NAND PREVENT PASS" "NAND EVIDENCE D1 U1 F5 C3 T1 M1 Q3 X2 S1 PASS" \
        "NAND RECOVERY PASS" \
        "ALL RV32 NVME FW CHECKS PASS" >"$work/complete.log"
    cp "$work/complete.log" "$work/incomplete.log"
    sed -i '/NAND RECOVERY PASS/d' "$work/incomplete.log"
    cp "$work/complete.log" "$work/duplicate.log"
    printf '%s\n' "NAND STARTUP PASS" >>"$work/duplicate.log"
    if (check_markers "$work/incomplete.log") >/dev/null 2>&1; then
        fail "incomplete transcript accepted"
    fi
    if (check_markers "$work/duplicate.log") >/dev/null 2>&1; then
        fail "duplicate transcript accepted"
    fi
    check_markers "$work/complete.log"
    echo "STATUS: PASS rv32-nvme-nand-recovery self-test"
}

ghdl_run() {
    require_self_hosted "$SIMPLE_BINARY" "rv32-nvme compiler"
    SIMPLE_BINARY="$SELF_HOSTED_BIN"
    cd "$ROOT"
    NVME_RV32_SIMPLE_BIN="$SIMPLE_BINARY" sh examples/09_embedded/simpleos_nvme_fw/fw_rv32/build.shs
    evidence="$ROOT/build/test-artifacts/nvme_rv32_source_matched"
    mkdir -p "$evidence"
    command -v jj >/dev/null 2>&1 || fail "jj is required for source revision binding"
    revision=$(jj log -r @ --no-graph -T 'commit_id') ||
        fail "cannot resolve source revision"
    [ -n "$revision" ] || fail "empty source revision"
    {
        printf 'source_manifest_version=2\n'
        printf 'revision=%s\n' "$revision"
        printf 'compiler=%s\ncompiler_real=%s\n' "$SIMPLE_BINARY" "$SELF_HOSTED_REAL"
        printf '%s\n' "$SELF_HOSTED_VERSION"
        sha256sum "$SELF_HOSTED_REAL" "$ROOT/build/nvme_fw_rv32.elf"
        for source in "$ROOT"/examples/09_embedded/simpleos_nvme_fw/fw_rv32/logic*.spl; do
            [ "$(basename "$source")" = "logic_check.spl" ] || sha256sum "$source"
        done
        sha256sum "$ENTRY" \
            "$ROOT/examples/09_embedded/simpleos_nvme_fw/fw_rv32/build.shs" \
            "$0" \
            "$ROOT/scripts/check/lib/require-self-hosted.shs" \
            "$ROOT/scripts/fpga/ghdl_rv32_nvme_fw.shs" \
            "$ROOT/scripts/fpga/ghdl_rv32_nvme_axi_ram.shs" \
            "$ROOT/scripts/fpga/ghdl_rv32_k26_ddr_boot.shs" \
            "$ROOT/scripts/fpga/ghdl_rv32_nvme_bram_soc.shs"
        find "$ROOT/examples/09_embedded/fpga_riscv/rtl" -maxdepth 1 -type f \
            \( -name '*.vhd' -o -name '*.ld' \) -print |
            LC_ALL=C sort |
            while IFS= read -r source; do sha256sum "$source"; done
    } >"$evidence/manifest.txt"
    if ! FW_ELF="$ROOT/build/nvme_fw_rv32.elf" sh scripts/fpga/ghdl_rv32_nvme_fw.shs >"$evidence/exact-bram.log" 2>&1; then
        cat "$evidence/exact-bram.log"
        fail "exact-BRAM GHDL run failed"
    fi
    cat "$evidence/exact-bram.log"
    FW_ELF="$ROOT/build/nvme_fw_rv32.elf" sh scripts/fpga/ghdl_rv32_nvme_axi_ram.shs
    FW_ELF="$ROOT/build/nvme_fw_rv32.elf" sh scripts/fpga/ghdl_rv32_nvme_bram_soc.shs
    GARBAGE_FILL=1 FW_ELF="$ROOT/build/nvme_fw_rv32.elf" \
        sh scripts/fpga/ghdl_rv32_nvme_bram_soc.shs
    check_markers "$ROOT/build/test-artifacts/nvme_rv32_bram_soc/clean/sim.log"
    check_markers "$ROOT/build/test-artifacts/nvme_rv32_bram_soc/garbage/sim.log"
    sha256sum \
        "$evidence/exact-bram.log" \
        "$ROOT/build/ghdl/rv32_k26_ddr_boot_garbage/sim.log" \
        "$ROOT/build/test-artifacts/nvme_rv32_bram_soc/clean/sim.log" \
        "$ROOT/build/test-artifacts/nvme_rv32_bram_soc/garbage/sim.log" \
        >>"$evidence/manifest.txt"
    echo "STATUS: PASS rv32-nvme-nand-recovery ghdl"
}

fpga_run() {
    ghdl_run
    cd "$ROOT"
    bash scripts/fpga/build_rv32_nvme_bram_bitstream.shs
    bit="$ROOT/build/fpga/k26_rv32_nvme_bram/gateware/rv32_nvme_bram.bit"
    bash scripts/fpga/program_kv260_bitstream.shs "$bit"
    out="$ROOT/build/fpga/rv32_nvme_nand_jtag"
    mkdir -p "$out"
    decoder="$ROOT/build/fpga/jtag_console/jtag_console"
    "$SIMPLE_BINARY" native-build --backend llvm --source src/compiler --source src/app --source src/lib \
        --entry-closure --entry src/app/jtag_console/main.spl --strip -o "$decoder"
    OUT_DIR="$out" JTAG_CONSOLE_BINARY="$decoder" bash scripts/fpga/read_rv32_tiny_bram_obs.shs transcript >"$out/transcript.out"
    check_markers "$out/transcript.out"
    raw_log=$(ls -1t "$out"/tiny_bram_transcript_*.log | head -1)
    fw_elf="$ROOT/build/ghdl/rv32_nvme_fw/nvme_fw_rv32_bram.elf"
    sha256sum "$fw_elf" "$bit" "$decoder" "$raw_log" >"$out/sha256.txt"
    echo "STATUS: PASS rv32-nvme-nand-recovery fpga"
}

case "${1:---self-test}" in
    --self-test) self_test ;;
    --ghdl) ghdl_run ;;
    --fpga) fpga_run ;;
    *) echo "usage: $0 --self-test | --ghdl | --fpga" >&2; exit 2 ;;
esac
