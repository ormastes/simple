#!/bin/sh
# check-seed-not-stale.shs — fail when the Rust seed binary is OLDER than the
# seed sources it was built from.
#
# Why this exists (2026-08-31): the SimpleOS entstore lane defaults to
# SEED=src/compiler_rust/target/release/simple and uses whatever binary is on
# disk. On this host that binary predated parser fixes that were already in the
# source tree, and it manufactured 34 phantom PARSE failures across src/os and
# src/lib — an entire failure class that vanished on rebuild with no source
# change. A stale seed does not announce itself: it reports ordinary-looking
# "Unexpected token" errors that read as stale source.
#
# Verdict is the last line of stdout:
#   PASS  — <n> source file(s) checked, seed newer than all of them
#   FAIL  — seed is older than <n> source file(s): <names>
#   ERROR — nothing was checked (<reason>)
# Non-vacuity is absolute: a missing seed, or a scan that compared 0 files, is
# ERROR, never a pass — absence of evidence is not evidence.
set -u
ROOT=$(cd "$(dirname "$0")/../.." && pwd)
cd "$ROOT"
SEED="${SEED:-src/compiler_rust/target/release/simple}"

if [ "${1:-}" = "--selftest" ]; then
    T=$(mktemp -d); trap 'rm -rf "$T"' EXIT
    mkdir -p "$T/src"; : > "$T/bin"; sleep 1; : > "$T/src/new.rs"
    # bin older than src/new.rs -> must be detected as stale
    if [ "$T/bin" -nt "$T/src/new.rs" ]; then
        echo "ERROR — nothing was checked: selftest fixture did not order mtimes"; exit 2
    fi
    sleep 1; : > "$T/bin"
    if [ ! "$T/bin" -nt "$T/src/new.rs" ]; then
        echo "ERROR — nothing was checked: selftest could not refresh fixture mtime"; exit 2
    fi
    echo "selftest ok (2 fixtures)"
fi

[ -x "$SEED" ] || { echo "ERROR — nothing was checked: seed missing or not executable at $SEED"; exit 2; }

CHECKED=0
STALE=""
NSTALE=0
for f in $(find src/compiler_rust/compiler/src src/compiler_rust/parser/src \
              src/compiler_rust/runtime/src -name '*.rs' 2>/dev/null); do
    CHECKED=$((CHECKED + 1))
    if [ "$f" -nt "$SEED" ]; then
        NSTALE=$((NSTALE + 1))
        [ "$NSTALE" -le 5 ] && STALE="$STALE $f"
    fi
done

if [ "$CHECKED" -eq 0 ]; then
    echo "ERROR — nothing was checked: no seed sources found under src/compiler_rust"; exit 2
fi
if [ "$NSTALE" -gt 0 ]; then
    echo "FAIL — seed $SEED is older than $NSTALE source file(s), e.g.:$STALE"
    echo "       rebuild with: cd src/compiler_rust && cargo build --release --bin simple"
    exit 1
fi
echo "PASS — $CHECKED seed source file(s) checked, $SEED is newer than all of them"
