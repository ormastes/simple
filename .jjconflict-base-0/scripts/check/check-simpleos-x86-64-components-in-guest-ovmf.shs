#!/bin/sh
# check-simpleos-x86-64-components-in-guest-ovmf.shs
#
# Proves that REAL Simple TOOLCHAIN COMPONENT code actually RUNS INSIDE SimpleOS
# on x86_64 and prints ITS OWN output to serial — not merely that a kernel booted.
# The x86_64 sibling of scripts/check/check-simpleos-aarch64-components-in-guest-efi.shs.
#
# Boot is OVMF pflash -> GRUB-EFI (a real EFI application) -> multiboot kernel,
# assembled by scripts/os/build-simpleos-x86-64-efi-esp.shs. NEVER QEMU
# `-kernel`, NEVER isa-debug-exit (.claude/rules/board-runnable.md). The
# assembled argv is self-checked for both before any VM starts.
#
# ONE KERNEL PER COMPONENT. Each row is built by
# scripts/os/build-simpleos-x86-64-components-kernel.shs, packaged into its own
# ESP, and booted in its own VM. A component whose closure will not link cannot
# hold the others hostage, and its literal link bill is reported rather than
# stubbed away.
#
# ROWS (default: devtool only. Pass names or COMPONENTS=... to widen.
#
# NOTE (2026-09-01): a DEFAULT run measures ONE row. Do not compare its
# "1 green" against any 4-row figure — that mismatch has already produced
# wrong status reports. For the real state, run:
#   COMPONENTS="devtool caret testrun mcp" sh scripts/check/check-simpleos-x86-64-components-in-guest-ovmf.shs
# Measured that way on 2026-09-01: PASS — 4 component(s) checked, 4 green.
#
# The former note here — "`mcp` is expected to fail linking on rt_closure_new /
# rt_closure_func_ptr" — is STALE. Those symbols gained real definitions in the
# x86_64 freestanding runtime; mcp links and runs. Kept only as history.
#
# CAVEAT for anyone reading mcp green here as cross-arch evidence: this gate
# rungs mcp on the L4 OK marker, NOT on payload content. riscv64's open
# `.bytes()`/`_bytes_text` truncation would NOT be caught by this row, so a
# green here is not evidence that defect is riscv64-only.)
#
# RUNGS per row (serial log):
#   L1  "[grub-uefi] multiboot loading"   OVMF -> GRUB-EFI application ran
#   L2  "[components] SimpleOS x86_64"    multiboot handoff reached _start
#   L3  "[components] serial up"          the entry's own prologue ran
#   L4  COMPONENT_<NAME>_SIMPLEOS_X86_64_OK   *** THE COMPONENT'S OWN OUTPUT ***
#   L5  "[components] all component rows exited rc=0"
#
# L1-L3 ALONE ARE A BANNER, NOT A PASS. A kernel that boots, prints its banner
# and then does nothing is the exact vacuous-green this gate exists to prevent;
# the selftest carries a banner-only must-FAIL fixture for it.
#
# Verdict is the last line of stdout:
#   PASS  — <n> component(s) checked, ...   exit 0
#   FAIL  — ...                             exit 1
#   ERROR — nothing was checked: <reason>   exit 2   (0 components executed)
#
# Env: SIMPLE_BIN, COMPONENTS, QEMU_MEM (2G), BOOT_WAIT (180), SKIP_KERNEL=1.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$ROOT"

SIMPLE_BIN="${SIMPLE_BIN:-$ROOT/src/compiler_rust/target/release/simple}"
WORK=build/os/x86_64_components/lane
QEMU_MEM="${QEMU_MEM:-2G}"
BOOT_WAIT="${BOOT_WAIT:-180}"
OVMF_CODE="${OVMF_CODE:-/usr/share/OVMF/OVMF_CODE_4M.fd}"

fail()    { echo "FAIL — $1"; exit 1; }
nothing() { echo "ERROR — nothing was checked: $1"; exit 2; }

marker_for() {
    case "$1" in
        devtool) echo 'COMPONENT_DEVTOOL_SIMPLEOS_X86_64_OK' ;;
        caret)   echo 'COMPONENT_CARET_SIMPLEOS_X86_64_OK' ;;
        testrun) echo 'COMPONENT_TESTRUN_SIMPLEOS_X86_64_OK' ;;
        mcp)     echo 'COMPONENT_MCP_SIMPLEOS_X86_64_OK' ;;
        *) return 1 ;;
    esac
}

assert_real_firmware_argv() {
    case " $1 " in
        *" -kernel "*) echo "argv uses QEMU -kernel pass semantics"; return 1 ;;
    esac
    case "$1" in
        *isa-debug-exit*) echo "argv uses isa-debug-exit"; return 1 ;;
    esac
    case "$1" in
        *"if=pflash"*) ;;
        *) echo "argv has no pflash firmware"; return 1 ;;
    esac
    return 0
}

# scan_rungs LOG MARKER -> prints the rung table, returns 0 only when EVERY rung
# is present. Shared by --selftest and the real run so the fixtures exercise the
# production scanner, not a copy of it.
scan_rungs() {
    sr_log=$1
    sr_marker=$2
    sr_missing=''
    sr_checked=0
    sr_check() {
        sr_checked=$((sr_checked + 1))
        if grep -qF "$2" "$sr_log" 2>/dev/null; then
            echo "  [OK]   $1  $2"
        else
            echo "  [MISS] $1  $2"
            sr_missing="$sr_missing $1"
        fi
    }
    sr_check L1 '[grub-uefi] multiboot loading'
    sr_check L2 '[components] SimpleOS x86_64 in-guest toolchain components'
    sr_check L3 '[components] serial up'
    sr_check L4 "$sr_marker"
    sr_check L5 '[components] all component rows exited rc=0'
    RUNGS_CHECKED=$sr_checked
    RUNGS_MISSING=$sr_missing
    [ -z "$sr_missing" ]
}

# ---------------------------------------------------------------------------
# --selftest — fatal, runs before any real work.
# ---------------------------------------------------------------------------
selftest() {
    st_tmp=$(mktemp -d "${TMPDIR:-/tmp}/x86-components-selftest.XXXXXX")
    st_fail=0
    st_m='COMPONENT_DEVTOOL_SIMPLEOS_X86_64_OK'

    # (1) must-PASS: every rung present.
    {
        echo '[grub-uefi] multiboot loading /boot/kernel.elf ...'
        echo ''
        echo '[components] SimpleOS x86_64 in-guest toolchain components (OVMF -> GRUB-EFI)'
        echo '[components] serial up, exercising real product modules'
        echo '[devtool] lint src/os/probe_dirty.spl  (expect a finding)'
        echo "$st_m real lint rule ran in-guest"
        echo '[components] all component rows exited rc=0'
        echo '[components] parking'
    } > "$st_tmp/good.log"
    if scan_rungs "$st_tmp/good.log" "$st_m" >/dev/null 2>&1; then :; else
        echo "selftest: must-PASS fixture did not pass"; st_fail=1
    fi

    # (2) *** BANNER-ONLY MUST-FAIL *** — the kernel booted, GRUB ran, the entry
    #     printed its banner, and then the component never produced output. This
    #     is the vacuous green this whole gate exists to prevent.
    {
        echo '[grub-uefi] multiboot loading /boot/kernel.elf ...'
        echo ''
        echo '[components] SimpleOS x86_64 in-guest toolchain components (OVMF -> GRUB-EFI)'
        echo '[components] serial up, exercising real product modules'
        echo '[components] parking'
    } > "$st_tmp/banner.log"
    if scan_rungs "$st_tmp/banner.log" "$st_m" >/dev/null 2>&1; then
        echo "selftest: BANNER-ONLY fixture wrongly passed"; st_fail=1
    fi

    # (3) must-FAIL: component printed its marker but a row exited non-zero.
    sed 's/all component rows exited rc=0/at least one component row exited rc=nonzero/' \
        "$st_tmp/good.log" > "$st_tmp/rc.log"
    if scan_rungs "$st_tmp/rc.log" "$st_m" >/dev/null 2>&1; then
        echo "selftest: non-zero-row fixture wrongly passed"; st_fail=1
    fi

    # (4) must-FAIL: kernel never booted at all (GRUB rung absent).
    grep -v 'grub-uefi' "$st_tmp/good.log" > "$st_tmp/nogrub.log"
    if scan_rungs "$st_tmp/nogrub.log" "$st_m" >/dev/null 2>&1; then
        echo "selftest: no-GRUB fixture wrongly passed"; st_fail=1
    fi

    # (5) must-FAIL: empty serial log — nothing executed.
    : > "$st_tmp/empty.log"
    if scan_rungs "$st_tmp/empty.log" "$st_m" >/dev/null 2>&1; then
        echo "selftest: empty fixture wrongly passed"; st_fail=1
    fi

    # (6) must-FAIL: a DIFFERENT component's marker must not satisfy this row.
    if scan_rungs "$st_tmp/good.log" 'COMPONENT_MCP_SIMPLEOS_X86_64_OK' >/dev/null 2>&1; then
        echo "selftest: wrong-component marker wrongly accepted"; st_fail=1
    fi

    # (7) argv self-check: must reject -kernel.
    if assert_real_firmware_argv "qemu-system-x86_64 -m 2G -kernel k.elf" >/dev/null 2>&1; then
        echo "selftest: -kernel argv wrongly accepted"; st_fail=1
    fi
    # (8) argv self-check: must reject isa-debug-exit.
    if assert_real_firmware_argv "-drive if=pflash,file=o.fd -device isa-debug-exit,iobase=0xf4" >/dev/null 2>&1; then
        echo "selftest: isa-debug-exit argv wrongly accepted"; st_fail=1
    fi
    # (9) argv self-check: must accept a real pflash argv.
    if assert_real_firmware_argv "-drive if=pflash,format=raw,file=o.fd -serial file:x" >/dev/null 2>&1; then :; else
        echo "selftest: real pflash argv wrongly rejected"; st_fail=1
    fi

    # (10) every known component name must map to a distinct marker; a silent
    #      collision would let one row's evidence satisfy another's.
    st_all=$(for c in devtool caret testrun mcp; do marker_for "$c"; done | sort -u | wc -l)
    [ "$st_all" -eq 4 ] || { echo "selftest: component markers are not distinct ($st_all)"; st_fail=1; }
    # (11) an unknown component must not silently produce a marker.
    if marker_for bogus >/dev/null 2>&1; then
        echo "selftest: unknown component wrongly produced a marker"; st_fail=1
    fi
    # (12) the ESP builder's own selftest must be green — this gate cannot boot
    #      anything if its packaging step is broken, and a skipped dependency
    #      selftest is how a lane loses its boot rule.
    if sh scripts/os/build-simpleos-x86-64-efi-esp.shs --selftest >/dev/null 2>&1; then :; else
        echo "selftest: ESP builder selftest failed"; st_fail=1
    fi

    rm -rf "$st_tmp"
    [ "$st_fail" -eq 0 ] || { echo "ERROR — nothing was checked: selftest failed"; exit 2; }
}

case "${1:-}" in
    --selftest) selftest; echo "selftest OK"; exit 0 ;;
esac
selftest >/dev/null || exit 2

# ---------------------------------------------------------------------------
# Rows to run.
# ---------------------------------------------------------------------------
if [ $# -gt 0 ]; then
    ROWS="$*"
else
    ROWS="${COMPONENTS:-devtool}"
fi
for c in $ROWS; do
    marker_for "$c" >/dev/null 2>&1 || nothing "unknown component '$c'"
done

# ---------------------------------------------------------------------------
# Host prerequisites — absence of a tool is ERROR, never a pass.
# ---------------------------------------------------------------------------
command -v qemu-system-x86_64 >/dev/null 2>&1 || nothing "qemu-system-x86_64 missing"
command -v grub-mkstandalone  >/dev/null 2>&1 || nothing "grub-mkstandalone missing"
command -v readelf            >/dev/null 2>&1 || nothing "readelf missing"
[ -f "$OVMF_CODE" ] || nothing "OVMF_CODE missing at $OVMF_CODE"
[ -x "$SIMPLE_BIN" ] || nothing "no seed at $SIMPLE_BIN (cargo build --release --bin simple in src/compiler_rust)"

mkdir -p "$WORK"

EXECUTED=0
GREEN=0
OFFENDERS=''
BLOCKED=''

for COMP in $ROWS; do
    MARKER=$(marker_for "$COMP")
    CDIR="$WORK/$COMP"
    KERNEL="build/os/x86_64_components/$COMP/kernel.elf"
    SERIAL="$CDIR/serial.log"
    BUILDLOG="$CDIR/build.log"
    mkdir -p "$CDIR"

    echo "=== component: $COMP ==="

    if [ "${SKIP_KERNEL:-0}" != "1" ] || [ ! -s "$KERNEL" ]; then
        set +e
        SIMPLE_BIN="$SIMPLE_BIN" sh scripts/os/build-simpleos-x86-64-components-kernel.shs "$COMP" \
            > "$BUILDLOG" 2>&1
        brc=$?
        set -e
    else
        brc=0
    fi

    if [ "$brc" -ne 0 ] || [ ! -s "$KERNEL" ]; then
        # A component that will not LINK never executed. Report its literal
        # bill; never stub it, never let it look green.
        BILL=$(grep -oE "undefined symbol: [A-Za-z0-9_]+" "$BUILDLOG" 2>/dev/null \
                 | sed 's/undefined symbol: //' | sort -u | tr '\n' ' ')
        [ -n "$BILL" ] || BILL=$(tail -3 "$BUILDLOG" 2>/dev/null | tr '\n' ' ')
        echo "  [BLOCKED] $COMP did not link: $BILL"
        BLOCKED="$BLOCKED $COMP"
        OFFENDERS="$OFFENDERS $COMP(link)"
        continue
    fi
    echo "  kernel=$KERNEL ($(wc -c < "$KERNEL") bytes)"

    # #174: baremetal_stubs.c weak-defines every spl_handle_* as an ERROR STUB,
    # so a green link does not mean the syscalls work — a missing alias links
    # fine and then silently swallows that syscall. Record which shims resolved
    # to the boot error stub so a runtime silence is diagnosable from evidence
    # rather than guessed at.
    readelf -sW "$KERNEL" 2>/dev/null | grep -E 'spl_handle_' > "$CDIR/shims.txt" 2>/dev/null || true
    # Same failure mode one level down, and the one that actually bit this lane:
    # a runtime entry point that resolved to a TINY WEAK definition is a
    # synthesized nil-returning stub, not the real implementation. It links
    # clean and then faults or silently returns nil at run time. `mcp` is the
    # live example: rt_closure_func_ptr resolves GLOBAL (real, rt_extras.c)
    # while rt_closure_new resolves WEAK/8 bytes, so the dispatcher's closure is
    # nil and the guest triple-faults inside _start. baremetal_stubs.c
    # deliberately leaves rt_closure_new unresolved for exactly this reason;
    # something else supplies the weak stub and defeats that. Recorded, not
    # stubbed over — this file is the first thing to read when a row that linked
    # green misbehaves in-guest.
    readelf -sW "$KERNEL" 2>/dev/null \
        | awk '$4=="FUNC" && $5=="WEAK" && $3+0 <= 16 && $8 ~ /^rt_/ {print $3" "$5" "$8}' \
        | sort -u > "$CDIR/weak_rt_stubs.txt" 2>/dev/null || true
    if [ -s "$CDIR/weak_rt_stubs.txt" ]; then
        echo "  [note] runtime entries resolved to tiny WEAK stubs (see $CDIR/weak_rt_stubs.txt): $(awk '{printf "%s ", $3}' "$CDIR/weak_rt_stubs.txt")"
    fi

    # ESP packaging — the boot rule lives in the builder, not here.
    set +e
    sh scripts/os/build-simpleos-x86-64-efi-esp.shs \
        --kernel "$KERNEL" --out-dir "$CDIR" \
        --title "SimpleOS x86_64 in-guest component: $COMP" \
        > "$CDIR/esp.log" 2>&1
    erc=$?
    set -e
    if [ "$erc" -ne 0 ]; then
        echo "  [BLOCKED] ESP packaging failed: $(tail -1 "$CDIR/esp.log")"
        OFFENDERS="$OFFENDERS $COMP(esp)"
        continue
    fi
    ESP_ARGV=$(cat "$CDIR/qemu-argv.txt")

    QEMU_ARGV="qemu-system-x86_64 -no-user-config -monitor none -nographic -no-reboot \
-machine q35 -cpu qemu64 -m $QEMU_MEM $ESP_ARGV -serial file:$SERIAL"
    if ! ARGV_ERR=$(assert_real_firmware_argv "$QEMU_ARGV"); then
        nothing "assembled QEMU argv violates the real-firmware rule: $ARGV_ERR"
    fi

    rm -f "$SERIAL"
    # shellcheck disable=SC2086
    $QEMU_ARGV >/dev/null 2>&1 &
    QEMU_PID=$!
    trap 'kill "$QEMU_PID" 2>/dev/null || true' EXIT
    EXECUTED=$((EXECUTED + 1))

    i=0
    while [ "$i" -lt "$BOOT_WAIT" ]; do
        if [ -f "$SERIAL" ] && grep -qF '[components] parking' "$SERIAL" 2>/dev/null; then
            break
        fi
        sleep 1
        i=$((i + 1))
    done
    sleep 2
    kill "$QEMU_PID" 2>/dev/null || true
    trap - EXIT

    if [ ! -f "$SERIAL" ]; then
        echo "  [MISS] no serial log produced"
        OFFENDERS="$OFFENDERS $COMP(no-serial)"
        continue
    fi
    echo "  serial: $SERIAL"
    RUNGS_CHECKED=0
    RUNGS_MISSING=''
    if scan_rungs "$SERIAL" "$MARKER"; then
        GREEN=$((GREEN + 1))
    else
        OFFENDERS="$OFFENDERS $COMP(missing:$(echo "$RUNGS_MISSING" | tr -d ' '))"
    fi
done

# ---------------------------------------------------------------------------
# Verdict. Zero components EXECUTED is ERROR — a build that never produced a
# bootable kernel means nothing was checked, and that must never read as FAIL
# (which would imply we ran something and it misbehaved) nor as PASS.
# ---------------------------------------------------------------------------
[ "$EXECUTED" -gt 0 ] || nothing "0 component(s) executed in-guest;${BLOCKED:- none} did not link (see build logs under $WORK)"

if [ -n "$OFFENDERS" ]; then
    fail "$EXECUTED component(s) executed in-guest, $GREEN green, offenders:$OFFENDERS (transcripts under $WORK)"
fi
echo "PASS — $EXECUTED component(s) checked, $GREEN green in-guest under real OVMF pflash -> GRUB-EFI -> multiboot, seed-built by $SIMPLE_BIN (transcripts under $WORK)"
