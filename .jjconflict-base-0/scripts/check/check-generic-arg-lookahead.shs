#!/bin/sh
# check-generic-arg-lookahead.shs — fail-closed gate on the SELF-HOSTED parser's
# generic-argument lookahead, `try_skip_ident_generic_args()` in
# src/compiler/10.frontend/core/parser_expr.spl.
#
# WHY THIS GATE EXISTS
# The lookahead speculatively reads `ident <` as the head of a generic-argument
# list. Two opposite failure modes have both shipped to main:
#   * too permissive — `if key_col < 0 or key_col > (max_col - min_col):` was
#     CONFIRMED as generic args and died with "const generic arguments are not
#     supported ... Tensor<i64, 2>" (a canned example string, not the source).
#     doc/08_tracking/bug/parser_comparison_chain_misread_as_generic_args_2026-08-18.md
#   * too strict — arming the separator ratchet ahead of the
#     argument-CONTINUING tokens broke `foo<T*>(x)`, `foo<a::B>(x)` and
#     `foo<Bar.Baz>(x)` back into comparisons.
#     doc/08_tracking/bug/generic_arg_lookahead_separator_ratchet_ordering_2026-08-24.md
# A change that fixes one direction silently reintroduces the other, so both
# directions are pinned here.
#
# WHICH PARSER IS EXERCISED
# `bin/simple` is the RUST SEED; running a .spl through it exercises the Rust
# parser, NOT parser_expr.spl. This gate therefore drives the self-hosted front
# end IN PROCESS via `parse_full_frontend`, which the seed INTERPRETS from
# src/compiler source. That is the only route that tests the file under test
# without a bootstrap; the tracked stage binaries currently SEGV.
#
# VERDICT (always the LAST line of stdout):
#   PASS — <n> case(s) checked, ...      exit 0   (n is always > 0)
#   FAIL — ...                            exit 1
#   ERROR — nothing was checked (...)     exit 2
# A run that checked 0 cases is ERROR, never a pass.
#
# --selftest runs FIRST and is FATAL.

set -u

ROOT=$(cd "$(dirname "$0")/../.." && pwd)
cd "$ROOT" || { echo "ERROR — nothing was checked (cannot cd to repo root)"; exit 2; }

SIMPLE_BIN=${SIMPLE_BIN:-bin/simple}
WORK=$(mktemp -d "${TMPDIR:-/tmp}/genarg-gate.XXXXXX") || {
    echo "ERROR — nothing was checked (cannot create temp dir)"; exit 2; }
trap 'rm -rf "$WORK"' EXIT INT TERM

PROBE="$WORK/genarg_probe.spl"

# ---------------------------------------------------------------- case table
# Each row: NAME|EXPECT|SOURCE  (EXPECT is OK = must parse clean, ERR = must be
# rejected by the parser). \n in SOURCE is expanded by the probe writer.
CASES='
data_ops_shape|OK|fn probe(a: i64, b: i64, c: i64) -> bool:\n    if a < 0 or a > (b - c):\n        return true\n    false\n
ident_only_chain|OK|fn probe(a: i64, b: i64, c: i64) -> bool:\n    a < b or a > (c)\n
and_chain|OK|fn probe(a: i64, b: i64, c: i64, d: i64) -> bool:\n    a < b and c > d\n
qualified_arg|OK|fn probe():\n    val x = foo<std::Bar>(1)\n
pointer_arg|OK|fn probe():\n    val x = foo<T*>(1)\n
bracket_arg|OK|fn probe():\n    val x = foo<[T]>(1)\n
dotted_arg|OK|fn probe():\n    val x = foo<Bar.Baz>(1)\n
nested_shr_close|OK|fn probe():\n    val x = make<Dict<String, Array<i64>>>(1)\n
call_vs_generic|OK|fn probe():\n    val x = a<b>(c)\n
const_generic_rejected|ERR|fn probe():\n    val x = Tensor<i64, 2>(1)\n
'

# Writes the single-case probe program. $1 = destination path.
write_probe() {
    cat > "$1" <<'PROBEEOF'
# Generated by scripts/check/check-generic-arg-lookahead.shs — do not edit.
# One case per PROCESS: parser error state is global to the process, so cases
# must never share a run.
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.core.parser.{parser_has_errors}
use std.io_runtime.{file_read, env_get}

fn main():
    val src_path = env_get("GENARG_SRC")
    val src = file_read(src_path)
    if src == "":
        print("PROBE_NO_SOURCE")
        return
    val parsed = parse_full_frontend(src, "testdata/genarg_probe_case.spl", "genarg_probe_case", Logger(level: 0))
    if parser_has_errors():
        print("ERR")
    else:
        print("OK")
PROBEEOF
}

# Runs one case. $1 = fixture path. Echoes OK / ERR / UNKNOWN.
run_case() {
    _fix=$1
    # timeout, not a bare invocation: a hung `bin/simple run` would otherwise
    # hang the gate forever. A timeout is UNKNOWN (=> ERROR), never a pass.
    _out=$(timeout "${GENARG_CASE_TIMEOUT:-600}" env GENARG_SRC="$_fix" "$SIMPLE_BIN" run "$PROBE" 2>&1)
    _rc=$?
    if [ "$_rc" -ne 0 ]; then
        echo UNKNOWN
        return
    fi
    _verdict=$(printf '%s\n' "$_out" | grep -E '^(OK|ERR|PROBE_NO_SOURCE)$' | tail -1)
    case "$_verdict" in
        OK|ERR) echo "$_verdict" ;;
        *)      echo UNKNOWN ;;
    esac
}

# ------------------------------------------------------------------ selftest
# Proves the harness DISCRIMINATES before any real case is trusted: a source
# the parser must accept and a source it must reject have to come back
# different. A harness that answers the same for both proves nothing, and a
# harness that cannot run at all must abort rather than report a pass.
selftest() {
    write_probe "$PROBE"

    printf 'fn probe():\n    val x = 1\n' > "$WORK/st_clean.spl"
    # A genuinely malformed declaration the parser cannot accept.
    printf 'fn probe(:\n    val x =\n' > "$WORK/st_broken.spl"

    _clean=$(run_case "$WORK/st_clean.spl")
    _broken=$(run_case "$WORK/st_broken.spl")

    if [ "$_clean" = UNKNOWN ]; then
        echo "selftest: probe harness could not run (clean fixture => UNKNOWN)" >&2
        return 1
    fi
    if [ "$_clean" != OK ]; then
        echo "selftest: clean fixture reported '$_clean', expected OK" >&2
        return 1
    fi
    if [ "$_broken" != ERR ]; then
        echo "selftest: broken fixture reported '$_broken', expected ERR" >&2
        return 1
    fi
    # A nonexistent source must NOT be silently reported as a clean parse.
    _missing=$(run_case "$WORK/st_does_not_exist.spl")
    if [ "$_missing" = OK ]; then
        echo "selftest: missing source reported OK — harness fails open" >&2
        return 1
    fi
    return 0
}

selftest
SELFTEST_RC=$?
if [ "$SELFTEST_RC" -ne 0 ]; then
    echo "ERROR — nothing was checked (selftest failed)"
    exit 2
fi

if [ "${1:-}" = "--selftest" ]; then
    echo "PASS — 3 case(s) checked, selftest only (harness discriminates clean vs broken)"
    exit 0
fi

# ---------------------------------------------------------------------- scan
CHECKED=0
FAILED=""
UNKNOWNS=""


OLDIFS=$IFS
IFS='
'
for row in $CASES; do
    [ -n "$row" ] || continue
    name=${row%%|*}
    rest=${row#*|}
    expect=${rest%%|*}
    src=${rest#*|}

    fixture="$WORK/case_$name.spl"
    # shellcheck disable=SC2059
    printf "$src" > "$fixture"

    got=$(run_case "$fixture")
    CHECKED=$((CHECKED + 1))
    if [ "$got" = UNKNOWN ]; then
        UNKNOWNS="$UNKNOWNS $name"
    elif [ "$got" != "$expect" ]; then
        FAILED="$FAILED $name(expected=$expect,got=$got)"
    fi
done
IFS=$OLDIFS

if [ "$CHECKED" -eq 0 ]; then
    echo "ERROR — nothing was checked (case table produced 0 cases)"
    exit 2
fi

if [ -n "$UNKNOWNS" ]; then
    echo "ERROR — nothing was checked (case(s) produced no verdict:$UNKNOWNS)"
    exit 2
fi

if [ -n "$FAILED" ]; then
    echo "FAIL — $CHECKED case(s) checked,$FAILED"
    exit 1
fi

echo "PASS — $CHECKED case(s) checked, 0 mismatches (self-hosted generic-argument lookahead)"
exit 0
