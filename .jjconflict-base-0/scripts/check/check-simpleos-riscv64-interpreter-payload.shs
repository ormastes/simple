#!/bin/sh
# check-simpleos-riscv64-interpreter-payload.shs
#
# Fail-closed gate over the riscv64-unknown-simpleos SIMPLE INTERPRETER payload
# (src/app/simpleos_tool/main.spl cross-built to a static RISC-V ELF).
#
# WHY THIS GATE EXISTS, AND WHAT IT DELIBERATELY DOES *NOT* CLAIM
# ---------------------------------------------------------------
# The goal row is "the Simple interpreter runs hello world in-guest on SimpleOS
# riscv64". That row is NOT green, and this gate does not pretend otherwise:
# it never boots a VM and never reports an in-guest execution.
#
# What it does check is the half that IS real, measured on committed state
# 2026-08-31:
#
#   * the interpreter payload cross-builds and LINKS for riscv64-unknown-simpleos
#   * with ZERO codegen-body failures and ZERO stub fallbacks
#     (SIMPLE_ALLOW_STUB_FALLBACK is forbidden here and the gate FAILS if the
#     build log shows a stub was emitted — a stubbed interpreter would "run"
#     and prove nothing, which is the exact silent-lie class this lane fights)
#   * the resulting artifact is a statically linked RISC-V ELF64 (e_machine 243)
#   * it actually CONTAINS the interpreter: both
#     app__simpleos_tool__focused_pipeline__simpleos_interpret_file and
#     compiler__backend__backend__interpreter__InterpreterBackendImpl_dot_interpret_hir_module
#     must be DEFINED text symbols. --gc-sections has previously discarded an
#     unrooted graph and still reported a successful link, so a size check alone
#     is not evidence.
#   * it has no unresolved STRONG undefined symbols (a weak undefined is allowed;
#     `mprotect` was exactly this class of defect — declared in <sys/mman.h>,
#     defined nowhere, and it broke every link that pulled runtime_memory.o).
#
# THE REMAINING GAP, NAMED EXPLICITLY (this gate reports it, never hides it):
# the payload is a U-MODE SimpleOS user program. riscv64 SimpleOS has no wired
# boot lane that mounts the guest filesystem and execs a user ELF — there is no
# check-simpleos-riscv64-unified-live sibling to the arm64 one, and the existing
# in-guest hello lane (check-simpleos-riscv64-hello-world-in-guest-opensbi.shs)
# says so itself: its native program runs in S-MODE as the kernel, not as a task
# loaded off the guest's own filesystem. Closing the goal row needs that
# scheduler + ELF-loader closure, not more codegen and not more libc.
#
# ARGV SELF-CHECK: this gate assembles no QEMU argv of its own, but it carries
# the same forbidden-flag assertion the boot lanes use, and its --selftest
# exercises it, so the check cannot rot before an in-guest row is wired here.
#
# VERDICT (always the last line of stdout):
#   PASS  — <n> invariant(s) checked, ...            exit 0
#   FAIL  — ...                                      exit 1
#   ERROR — nothing was checked (<reason>)           exit 2
# A run that checked 0 invariants is ERROR, never a pass.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
PAYLOAD=${SIMPLEOS_RV64_INTERP_ELF:-$ROOT/bin/release/riscv64-unknown-simpleos/simple}
BUILD_LOG=${SIMPLEOS_RV64_INTERP_BUILD_LOG:-}

CHECKED=0
OFFENDERS=

nothing() { printf 'ERROR — nothing was checked (%s)\n' "$*"; exit 2; }
note()    { OFFENDERS="${OFFENDERS:+$OFFENDERS; }$*"; }

# --- shared assertions -------------------------------------------------------

# Forbidden QEMU pass semantics. Kept here (and selftested) so that whoever
# wires the in-guest interpreter row into this file inherits the check.
assert_real_firmware_argv() {
    case " $* " in
        *" -kernel "*)         echo "argv uses -kernel pass semantics" >&2; return 1 ;;
        *isa-debug-exit*)      echo "argv uses isa-debug-exit" >&2; return 1 ;;
    esac
    case " $* " in
        *" -bios "*) return 0 ;;
        *) echo "argv names no -bios firmware" >&2; return 1 ;;
    esac
}

# A serial capture that only proves firmware+kernel came up, with no output from
# the program itself, must never be accepted. This is the boot-log-only lie.
serial_shows_program_output() {
    log=$1; marker=$2
    [ -s "$log" ] || return 1
    grep -q "$marker" "$log" || return 1
    return 0
}

# --- selftest (fatal, runs before every scan) --------------------------------

selftest() {
    st=$(mktemp -d) || return 1
    st_fail=0

    # (1) must-FAIL: BOOT-LOG-ONLY capture. Real OpenSBI banner, real kernel
    #     lines, and NOTHING from the interpreted program.
    printf 'OpenSBI v1.4\nPlatform Name: riscv-virtio,qemu\n[simpleos] serial up\n' \
        > "$st/bootonly.log"
    if serial_shows_program_output "$st/bootonly.log" 'HELLO_INTERP_SIMPLEOS_RISCV64_OK'; then
        echo "selftest: boot-log-only capture was wrongly accepted" >&2; st_fail=1
    fi

    # (2) must-PASS: the same capture plus the program's own output.
    cp "$st/bootonly.log" "$st/real.log"
    printf 'HELLO_INTERP_SIMPLEOS_RISCV64_OK hello world from Simple\n' >> "$st/real.log"
    if ! serial_shows_program_output "$st/real.log" 'HELLO_INTERP_SIMPLEOS_RISCV64_OK'; then
        echo "selftest: genuine program output was wrongly rejected" >&2; st_fail=1
    fi

    # (3) must-FAIL: empty capture.
    : > "$st/empty.log"
    if serial_shows_program_output "$st/empty.log" 'HELLO_INTERP_SIMPLEOS_RISCV64_OK'; then
        echo "selftest: empty capture was wrongly accepted" >&2; st_fail=1
    fi

    # (4) argv must-PASS: real firmware.
    if ! assert_real_firmware_argv "-machine virt -bios fw_payload.bin -serial file:x" 2>/dev/null; then
        echo "selftest: real-firmware argv wrongly rejected" >&2; st_fail=1
    fi
    # (5) argv must-FAIL: -kernel.
    if assert_real_firmware_argv "-machine virt -kernel kernel.Image" 2>/dev/null; then
        echo "selftest: -kernel argv wrongly accepted" >&2; st_fail=1
    fi
    # (6) argv must-FAIL: isa-debug-exit.
    if assert_real_firmware_argv "-machine virt -bios fw.bin -device isa-debug-exit" 2>/dev/null; then
        echo "selftest: isa-debug-exit argv wrongly accepted" >&2; st_fail=1
    fi

    # (7) stub-fallback detection must FAIL a log that emitted a stub.
    printf '[CODEGEN-STUB-FALLBACK] body compilation failed for x\n' > "$st/stub.log"
    if ! grep -q 'CODEGEN-STUB-FALLBACK\|CODEGEN BODY' "$st/stub.log"; then
        echo "selftest: stub-fallback log was not detected" >&2; st_fail=1
    fi
    # (8) and must accept a clean one.
    printf 'Build complete: 2 compiled, 573 cached, 0 failed\n' > "$st/clean.log"
    if grep -q 'CODEGEN-STUB-FALLBACK\|CODEGEN BODY' "$st/clean.log"; then
        echo "selftest: clean build log was wrongly flagged" >&2; st_fail=1
    fi

    rm -rf "$st"
    [ "$st_fail" -eq 0 ] || { echo "FAIL — selftest failed" >&2; exit 1; }
}

selftest

# --- scan --------------------------------------------------------------------

[ -f "$PAYLOAD" ] || nothing "no interpreter payload at $PAYLOAD (build it with scripts/os/simpleos-native-build-riscv64.shs)"
command -v readelf >/dev/null 2>&1 || nothing "readelf is required"
command -v nm >/dev/null 2>&1 || nothing "nm is required"

# (a) ELF class + machine, read the same way the provisioner reads it.
CHECKED=$((CHECKED + 1))
MACHINE=$(od -An -tu1 -j 18 -N 2 "$PAYLOAD" 2>/dev/null | awk '{print $1 + 256 * $2}')
[ "$MACHINE" = "243" ] || note "e_machine=$MACHINE, expected 243 (EM_RISCV)"

CHECKED=$((CHECKED + 1))
readelf -h "$PAYLOAD" 2>/dev/null | grep -Eq 'Class:[[:space:]]+ELF64' \
    || note "payload is not ELF64"

# (b) statically linked, with a non-empty .text.
CHECKED=$((CHECKED + 1))
case "$(file "$PAYLOAD" 2>/dev/null)" in
    *"statically linked"*) ;;
    *) note "payload is not statically linked" ;;
esac

CHECKED=$((CHECKED + 1))
readelf -SW "$PAYLOAD" 2>/dev/null | grep -q ' \.text ' \
    || note "payload has no .text section (empty-link false success)"

# (c) the interpreter is REALLY IN THERE, as defined text symbols.
for sym in \
    app__simpleos_tool__focused_pipeline__simpleos_interpret_file \
    compiler__backend__backend__interpreter__InterpreterBackendImpl_dot_interpret_hir_module
do
    CHECKED=$((CHECKED + 1))
    nm "$PAYLOAD" 2>/dev/null | grep -q "^[0-9a-f]* T $sym\$" \
        || note "interpreter symbol missing or not defined: $sym"
done

# (d) no STRONG undefined symbols. Weak undefineds ('w') are allowed.
CHECKED=$((CHECKED + 1))
STRONG_UNDEF=$(nm -u "$PAYLOAD" 2>/dev/null | awk '$1 != "w" && $1 != "v" { print $NF }' | sort -u)
[ -z "$STRONG_UNDEF" ] || note "strong undefined symbol(s): $(echo $STRONG_UNDEF | tr '\n' ' ')"

# (e) no stub fallback in the build log, when one was supplied.
if [ -n "$BUILD_LOG" ]; then
    [ -f "$BUILD_LOG" ] || nothing "SIMPLEOS_RV64_INTERP_BUILD_LOG names no file: $BUILD_LOG"
    CHECKED=$((CHECKED + 1))
    if grep -q 'CODEGEN-STUB-FALLBACK\|CODEGEN BODY' "$BUILD_LOG"; then
        note "build log shows codegen body failures / stub fallback: $BUILD_LOG"
    fi
fi

[ "$CHECKED" -gt 0 ] || nothing "no invariant was evaluated"

GAP='in-guest interpreter row REMAINS RED: riscv64 SimpleOS has no wired boot lane that mounts the guest filesystem and execs a U-mode ELF (no check-simpleos-riscv64-unified-live sibling to the arm64 lane); the existing OpenSBI hello lane runs its program in S-mode as the kernel'

if [ -n "$OFFENDERS" ]; then
    printf 'FAIL — %s invariant(s) checked on %s, offender(s): %s\n' "$CHECKED" "$PAYLOAD" "$OFFENDERS"
    exit 1
fi

printf 'PASS — %s invariant(s) checked, riscv64-unknown-simpleos Simple INTERPRETER payload %s (%s bytes) is a statically linked RISC-V ELF64 carrying defined interpret_hir_module + simpleos_interpret_file and no strong undefined symbols; NOT an in-guest execution claim; %s\n' \
    "$CHECKED" "$PAYLOAD" "$(wc -c <"$PAYLOAD")" "$GAP"
exit 0
