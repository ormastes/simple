#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
out_dir=${SIMPLE_CHANNEL_CHECK_OUT:-/mnt/data/simple-channel-lifecycle}
cc_bin=${CC:-cc}
mkdir -p "$out_dir"

"$cc_bin" -std=c11 -O1 -g -pthread -D_GNU_SOURCE \
    -DSIMPLE_RUNTIME_CHANNEL_TEST_HOOKS -ffunction-sections -fdata-sections \
    -I"$repo_root/src/runtime" \
    "$repo_root/test/01_unit/runtime/runtime_native_channel_lifecycle_test.c" \
    "$repo_root/src/runtime/runtime_native.c" \
    -Wl,--gc-sections -ldl -lm -o "$out_dir/runtime_native_channel_lifecycle_test"
"$out_dir/runtime_native_channel_lifecycle_test" \
    >"$out_dir/runtime_native_channel_lifecycle_test.out"
cat "$out_dir/runtime_native_channel_lifecycle_test.out"

(cd "$repo_root/src/compiler_rust" && cargo test -p simple-compiler \
    interpreter_extern::concurrency::tests::scalar_channel_contract_ \
    --lib -- --nocapture)
(cd "$repo_root/src/compiler_rust" && cargo test -p simple-compiler \
    concurrent_providers::native_impl::channel_contract_tests:: \
    --lib -- --nocapture)
