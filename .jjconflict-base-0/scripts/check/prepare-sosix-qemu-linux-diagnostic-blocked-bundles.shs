#!/bin/sh
# Adapt retained Linux diagnostic receipts into honest collector-schema blockers.
set -eu

usage() {
    echo "usage: prepare-sosix-qemu-linux-diagnostic-blocked-bundles.shs [--source DIR] --output DIR [--owner NAME] [--reviewer NAME]" >&2
    exit 64
}

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
compiler_policy=$repo_root/scripts/check/lib/sosix-qemu-compiler-designation-v1.tsv
storage_root=$("$repo_root/scripts/qemu/simple-big-storage-root.shs" --print |
    awk -F= '$1 == "simple_big_storage_root" { print substr($0, index($0,"=")+1) }')
source=$storage_root/qemu/artifacts/sosix-qemu/linux
output=
owner=linux-diagnostic-evidence-owner
reviewer=sosix-qemu-matrix-reviewer
while [ "$#" -gt 0 ]; do
    case "$1" in
        --source) [ "$#" -ge 2 ] || usage; source=$2; shift 2 ;;
        --output) [ "$#" -ge 2 ] || usage; output=$2; shift 2 ;;
        --owner) [ "$#" -ge 2 ] || usage; owner=$2; shift 2 ;;
        --reviewer) [ "$#" -ge 2 ] || usage; reviewer=$2; shift 2 ;;
        *) usage ;;
    esac
done
[ -d "$source" ] && [ -n "$output" ] && [ -n "$owner" ] && [ -n "$reviewer" ] || usage
case "$source" in /*) ;; *) source=$PWD/$source ;; esac
case "$output" in /*) ;; *) output=$PWD/$output ;; esac

die() { echo "sosix-qemu-linux-diagnostic-adapter: $*" >&2; exit 2; }
field_optional() {
    awk -F= -v k="$1" '$1 == k { print substr($0, index($0,"=")+1); exit }' "$2"
}
hash_file() { sha256sum "$1" | awk '{print $1}'; }
identity() {
    value=$(field_optional "$1" "$2")
    [ -n "$value" ] && printf 'sha256:%s' "$value" || printf 'unrecorded:%s' "$1"
}

for guest in x86_32 x86_64 arm32 arm64 riscv32 riscv64; do
    # Timestamped receipt directories sort chronologically; retain the newest.
    original=$(find "$source/$guest" -mindepth 2 -maxdepth 2 -type f -name evidence.env -print 2>/dev/null |
        LC_ALL=C sort | tail -n 1)
    [ -n "$original" ] || die "missing retained receipt for linux/$guest"
    original_host=$(field_optional host "$original")
    original_guest=$(field_optional guest "$original")
    [ "$original_host" = linux ] && [ "$original_guest" = "$guest" ] || die "$original: host/guest mismatch"
    serial=$(field_optional serial_log "$original")
    [ -f "$serial" ] || die "$original: missing original serial_log"

    compiler_provenance=$(field_optional compiler_provenance "$original")
    [ -n "$compiler_provenance" ] || compiler_provenance=unrecorded
    dirty=$(field_optional source_worktree_dirty "$original")
    [ -n "$dirty" ] || dirty=unrecorded
    reason="compiler-lineage:$compiler_provenance;dirty-source:$dirty;nonce:missing-from-original-transcript"
    original_status=$(field_optional status "$original")
    original_failure=$(field_optional failure "$original")
    [ -z "$original_failure" ] || reason="$reason;diagnostic-failure:$original_failure"
    resume=$(field_optional resume_command "$original")
    [ -n "$resume" ] || resume="rerun-$guest-with-admitted-pure-simple-compiler-clean-source-and-correlated-nonce"

    bundle=$output/linux/$guest/blocked-diagnostic
    [ ! -e "$bundle" ] || die "destination already exists: $bundle"
    mkdir -p "$bundle"
    cp "$original" "$bundle/original-evidence.env"
    cp "$serial" "$bundle/serial.log"
    original_hash=$(hash_file "$bundle/original-evidence.env")
    serial_hash=$(hash_file "$bundle/serial.log")
    nonce="blocked-linux-$guest-${original_hash%????????????????????????????????????????????????}"
    {
        echo "adapter_status=blocked"
        echo "guest=$guest"
        echo "original_status=$original_status"
        echo "reason=$reason"
        echo "run_nonce=$nonce"
        echo "original_evidence_sha256=$original_hash"
        echo "original_serial_sha256=$serial_hash"
    } > "$bundle/blocker.txt"
    blocker_hash=$(hash_file "$bundle/blocker.txt")

    source_revision=$(field_optional source_revision "$original")
    [ -n "$source_revision" ] || source_revision=unrecorded
    compiler_sha=$(field_optional compiler_sha256 "$original")
    [ -n "$compiler_sha" ] || compiler_sha=unrecorded
    qemu_version=$(field_optional qemu_version "$original")
    [ -n "$qemu_version" ] || qemu_version=unrecorded
    qemu_argv=$(field_optional argv "$original")
    [ -n "$qemu_argv" ] || qemu_argv=unrecorded
    accelerator=$(field_optional accelerator "$original")
    [ -n "$accelerator" ] || accelerator=unrecorded
    program_path=$(field_optional program_path "$original")
    [ -n "$program_path" ] || program_path=unrecorded
    {
        echo 'schema_version=1'
        echo 'host=linux'
        echo "guest=$guest"
        echo 'status=blocked'
        echo "reason=$reason"
        echo "owner=$owner"
        echo "reviewer=$reviewer"
        echo "resume_command=$resume"
        echo "source_identity=diagnostic-revision:$source_revision:dirty:$dirty"
        echo "compiler_identity=diagnostic:$compiler_provenance:sha256:$compiler_sha"
        echo 'compiler_identity_scope=source-toolchain'
        echo "compiler_policy_sha256=$(hash_file "$compiler_policy")"
        echo 'compiler_policy_value=false'
        echo "kernel_identity=$(identity kernel_sha256 "$original")"
        echo "image_identity=$(identity image_sha256 "$original")"
        echo "qemu_identity=diagnostic:$qemu_version"
        echo "qemu_argv=$qemu_argv"
        echo "accelerator_identity=$accelerator"
        echo 'firmware_identity=unrecorded'
        echo 'firmware_mode=unrecorded'
        echo 'firmware_path=unrecorded'
        echo 'firmware_version=unrecorded'
        echo 'firmware_sha256=unrecorded'
        echo 'firmware_stage_markers=unrecorded'
        echo 'boot_correlation_marker=unrecorded'
        echo "run_nonce=$nonce"
        echo "transcript_identity=sha256:$blocker_hash"
        echo "program_identity=diagnostic-path:$program_path"
        echo 'compiler_in_filesystem=false'
        echo 'compiler_payload_identity='
        echo 'compiler_image_identity='
        echo 'compiler_alias_identity='
        echo 'compiler_manifest_identity='
        echo 'compiler_designation_scope=live-policy'
        echo 'compiler_version_evidence_path='
        echo 'compiler_hello_evidence_path='
        echo 'compiler_alias_evidence_path='
        echo 'compiler_manifest_evidence_path='
        echo 'artifact_count=3'
        echo 'artifact_1_path=blocker.txt'
        echo "artifact_1_sha256=$blocker_hash"
        echo 'artifact_2_path=original-evidence.env'
        echo "artifact_2_sha256=$original_hash"
        echo 'artifact_3_path=serial.log'
        echo "artifact_3_sha256=$serial_hash"
    } > "$bundle/evidence.env"
done

echo 'sosix_qemu_linux_diagnostic_adapter_status=blocked'
echo 'sosix_qemu_linux_diagnostic_adapter_count=6'
echo "sosix_qemu_linux_diagnostic_adapter_output=$output/linux"
exit 2
