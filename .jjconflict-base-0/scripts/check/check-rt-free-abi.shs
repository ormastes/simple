#!/bin/sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$ROOT_DIR"

bad=$(rg -n '(^|extern |pub extern )fn rt_free\([^\n]*,|rt_free\([^"\n]*,' \
    src test --glob '*.spl' || true)
bad=$(printf '%s\n' "$bad" | grep -v 'simple_runtime.contains("void rt_free(void \*ptr, spl_i64 size)")' || true)
if [ -n "$bad" ]; then
    printf '%s\n' "$bad" >&2
    echo "rt_free ABI check failed: pure-Simple declarations/calls must pass one pointer" >&2
    exit 1
fi

rg -q 'void[[:space:]]+rt_free\(void\*[[:space:]]+ptr\)' src/runtime/runtime_native.c
rg -q 'void[[:space:]]+rt_free\(uint8_t\*[[:space:]]+ptr\)' src/runtime/runtime_memory.c
rg -q 'void rt_free\(void \*ptr\)' src/os/libc/simpleos_simple_runtime.c
rg -q 'RuntimeFuncSpec::new\("rt_free", &\[I64\], &\[\]\)' \
    src/compiler_rust/compiler/src/codegen/runtime_sffi.rs
rg -q 'pub fn rt_free\(ptr: \*mut u8\)' \
    src/compiler_rust/runtime/src/value/sffi/memory.rs

echo "rt_free_abi=pass"
echo "hosted_platforms=linux,macos,windows,bsd"
echo "hosted_cpus=x86_64,aarch64"
echo "simpleos_boundary=one-pointer-libc-or-documented-bump-arena"
