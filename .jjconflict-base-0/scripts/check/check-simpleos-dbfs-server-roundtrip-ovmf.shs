#!/bin/sh
# check-simpleos-dbfs-server-roundtrip-ovmf.shs
#
# Proves the SimpleOS DBFS FILESYSTEM SERVER is genuinely RUNNING in-guest, by
# a DATA round-trip that is verified through a FILESYSTEM CHECK.
#
# The DBFS analogue of check-simpleos-vfs-server-roundtrip-ovmf.shs, and
# deliberately built to that gate's structure and evidence bar. `dbfs` here is
# the FILESYSTEM BACKED BY THE EMBEDDED DB — not the textual SDN database, and
# not the DB server (dbd). The surface exercised is
# src/os/services/dbfs/dbfs_filesystem_ops.spl's `impl Filesystem for
# DbFsDriver`, mounted through the shared VfsManager.mount() surface, which is
# the same adapter boot_fs.spl mounts as root in production.
#
# Boot is OVMF pflash -> GRUB-EFI (a real EFI application) -> multiboot1 kernel.
# NEVER QEMU `-kernel`, NEVER isa-debug-exit — the assembled argv is
# self-checked for both forbidden flags before the VM is started, so the same
# artifact could boot on hardware (.claude/rules/board-runnable.md).
#
# COMPILER: the RUST BOOTSTRAP SEED, on purpose and stated in the verdict. The
# pure-Simple self-hosted compiler cannot compile anything in this tree yet.
# `--timeout 1200` is passed to native-build deliberately: the 300s default
# makes modules that compile fine "fail". A timeout is not a compile error.
#
# WHY A BANNER IS NOT ACCEPTED, WHY A PATH EXISTING IS NOT ACCEPTED, AND WHY A
# PERFECT ROUND-TRIP ON A WIPED VOLUME IS NOT ACCEPTED:
#
#   NONCE  — a per-run value minted into build/os/generated by THIS run. The
#            gate greps for that exact nonce in the serial transcript AND in
#            the raw NVMe image on the host. A stale kernel, a stale disk
#            image, or a probe that printed a banner without moving data all
#            carry the wrong nonce (or none) and FAIL.
#   TOKEN  — a per-run value the HOST seeds into /DBFSRT.TOK when it builds the
#            volume (src/os/port/mkfs_dbfsrt.spl). The guest must read it back
#            THROUGH THE MOUNTED FILESYSTEM BEFORE it writes anything. This
#            rung has no counterpart in the FAT32 lane and it closes a hole the
#            nonce cannot: a guest that silently RE-FORMATTED the volume
#            (dbfs_superblock_format_disk on some failure path) could still
#            write a fresh file and read it back perfectly, and the nonce would
#            look flawless. On a wiped volume the token is gone. The entry
#            never calls format on any path, and this rung is what proves it.
#
# The volume is rebuilt every run and asserted, before boot, to contain the
# TOKEN and to contain NEITHER the nonce NOR any /DBFSRT.TXT entry. So every
# nonce byte read back afterwards is a byte this run's guest wrote, and the
# volume the guest opened is the volume this run staged.
#
# REQUIRED RUNGS (serial log) — all must be present:
#   L1  "[grub-uefi] multiboot loading"          OVMF -> GRUB-EFI app ran
#   L2  "[dbfsrt] probe begin nonce=<NONCE>"     guest entered, carrying THIS nonce
#   L3  "[dbfsrt] nvme adapter ok=true"          pure-Simple NVMe device came up
#   L4  "[dbfsrt] dbfs superblock found=true"    the staged DBFS volume was recognised
#   L5  "[dbfsrt] dbfs-server up ready=true"     DBFS mounted via the Filesystem trait
#   L6  "[dbfsrt] volume token=dbfsrt-token:<TOKEN>"  THIS run's staged volume,
#                                                read back BEFORE any write
#   L7  "[dbfsrt] server write path=/DBFSRT.TXT ok=true"  server ACCEPTED a write
#   L8  "[dbfsrt] server read-back=dbfsrt-nonce:<NONCE>"  server RETURNED the data
#   L9  "[dbfsrt] ROUNDTRIP_OK nonce=<NONCE>"    write and read-back are identical
# REQUIRED HOST-SIDE FILESYSTEM CHECK:
#   L10 the nonce bytes are physically present in the raw NVMe image — an
#       independent check outside the guest that the data reached the disk.
# ADVISORY (never contributes to the PASS count, never turns the lane green):
#   A1  "[dbfsrt] group-commit ok=true"          the explicit post-round-trip
#       flush. Reported because a RED here explains a RED L10, but L10 is the
#       gated fact, not this.
#
# Verdict is the LAST line of stdout:
#   PASS  — <n> check(s) checked, ...   exit 0
#   FAIL  — ...                         exit 1
#   ERROR — nothing was checked: ...    exit 2
# 0 checks executed is an ERROR, never a PASS. A missing tool, a missing OVMF
# firmware, a missing seed, or no serial transcript is an ERROR, never a PASS.
#
# `--selftest` runs, fatally, before every real scan. Its fixtures include a
# banner-only must-FAIL, a stale-nonce must-FAIL, and — unique to this lane — a
# WIPED-VOLUME must-FAIL in which the round-trip is flawless at the current
# nonce but the staged token is missing.
#
# Env: SEED, SKIP_KERNEL=1 (reuse existing kernel), QEMU_MEM (2G), BOOT_WAIT,
#      OVMF_CODE, OVMF_VARS_SRC, DBFSRT_VOLUME_SECTORS,
#      DBFSRT_NONCE / DBFSRT_TOKEN (selftest only).

set -eu
ROOT=$(cd "$(dirname "$0")/../.." && pwd)
cd "$ROOT"

SEED="${SEED:-src/compiler_rust/target/release/simple}"
ENTRY="examples/09_embedded/simple_os/arch/x86_64/dbfs_server_roundtrip_entry.spl"
LINKER="examples/09_embedded/simple_os/arch/x86_64/linker_128mb.ld"
OUT="build/os/dbfsrt"
KERNEL="build/os/simpleos_dbfsrt_uefi.elf"
IMG="$OUT/dbfs-dbfsrt.img"
SERIAL="$OUT/dbfs_server_roundtrip_ovmf.serial.log"
CACHE="$OUT/cache"
BUILD="$OUT/uefi"
ESP="$BUILD/esp"
EFIAPP="$ESP/EFI/BOOT/BOOTX64.EFI"
NONCE_SPL="build/os/generated/dbfs_roundtrip_nonce.spl"
PARAMS_SPL="build/os/generated/dbfsrt_stage_params.spl"
OVMF_CODE="${OVMF_CODE:-/usr/share/OVMF/OVMF_CODE_4M.fd}"
OVMF_VARS_SRC="${OVMF_VARS_SRC:-/usr/share/OVMF/OVMF_VARS_4M.fd}"
OVMF_VARS="$BUILD/OVMF_VARS_4M.fd"
QEMU_MEM="${QEMU_MEM:-2G}"
BOOT_WAIT="${BOOT_WAIT:-180}"

fail()    { echo "FAIL — $1"; exit 1; }
nothing() { echo "ERROR — nothing was checked: $1"; exit 2; }

# ---------------------------------------------------------------------------
# scan_serial <log> <nonce> <token> — 0 when every REQUIRED serial rung is
# present. Anchored on the nonce- and token-bearing rungs, deliberately not on
# line counts and not on the firmware banner: a complete boot transcript with
# the server silent, one carrying a DIFFERENT nonce, or one whose round-trip is
# perfect but whose staged token is missing, must all FAIL.
# ---------------------------------------------------------------------------
scan_serial() {
    _log=$1; _n=$2; _tok=$3; _miss=""
    grep -qF '[grub-uefi] multiboot loading'                    "$_log" || _miss="$_miss L1"
    grep -qF "[dbfsrt] probe begin nonce=$_n"                   "$_log" || _miss="$_miss L2"
    grep -qF '[dbfsrt] nvme adapter ok=true'                    "$_log" || _miss="$_miss L3"
    grep -qF '[dbfsrt] dbfs superblock found=true'              "$_log" || _miss="$_miss L4"
    grep -qF '[dbfsrt] dbfs-server up ready=true'               "$_log" || _miss="$_miss L5"
    grep -qF "[dbfsrt] volume token=dbfsrt-token:$_tok"         "$_log" || _miss="$_miss L6"
    grep -qF '[dbfsrt] server write path=/DBFSRT.TXT ok=true'   "$_log" || _miss="$_miss L7"
    grep -qF "[dbfsrt] server read-back=dbfsrt-nonce:$_n"       "$_log" || _miss="$_miss L8"
    grep -qF "[dbfsrt] ROUNDTRIP_OK nonce=$_n"                  "$_log" || _miss="$_miss L9"
    SCAN_MISSING=$_miss
    [ -z "$_miss" ]
}

# ---------------------------------------------------------------------------
# scan_image <img> <nonce> — 0 when the nonce bytes are physically in the raw
# NVMe image. THE filesystem check: independent of anything the guest printed.
# ---------------------------------------------------------------------------
scan_image() {
    [ -f "$1" ] || return 1
    grep -qa "dbfsrt-nonce:$2" "$1"
}

# ---------------------------------------------------------------------------
# scan_image_token <img> <token> — 0 when the staged token bytes are in the raw
# image. Used on the FRESH volume, before boot, to prove the builder really
# seeded this run's token (so a missing L6 later means the GUEST could not read
# it, not that it was never written).
# ---------------------------------------------------------------------------
scan_image_token() {
    [ -f "$1" ] || return 1
    grep -qa "dbfsrt-token:$2" "$1"
}

# ---------------------------------------------------------------------------
# argv self-check. Needles are assembled from fragments so this check can
# neither be defeated by, nor accidentally fire on, the surrounding prose.
# ---------------------------------------------------------------------------
assert_real_firmware_argv() {
    _k="-""kernel"
    _d="isa""-debug-exit"
    for _a in "$@"; do
        case "$_a" in
            "$_k"|*"$_d"*) echo "FAIL — forbidden QEMU flag in argv: $_a"; exit 1 ;;
        esac
    done
    case " $* " in
        *" $_k "*) echo "FAIL — forbidden QEMU flag in argv: $_k"; exit 1 ;;
    esac
}

# ---------------------------------------------------------------------------
# --selftest — fatal, runs before every real scan.
# ---------------------------------------------------------------------------
selftest() {
    _t=$(mktemp -d); _rc=0
    _ok_n="AAAA1111"; _stale_n="BBBB2222"
    _ok_t="TOK9999";  _stale_t="TOK0000"

    # F1 must-PASS: a complete, honest transcript at the current nonce+token.
    cat > "$_t/ok.log" <<EOF
[grub-uefi] multiboot loading /boot/kernel.elf ...
[dbfsrt] probe begin nonce=$_ok_n
[dbfsrt] nvme adapter ok=true
[dbfsrt] dbfs superblock found=true gen=3
[dbfsrt] dbfs-server up ready=true
[dbfsrt] volume token=dbfsrt-token:$_ok_t
[dbfsrt] server write path=/DBFSRT.TXT ok=true
[dbfsrt] server read-back=dbfsrt-nonce:$_ok_n
[dbfsrt] ROUNDTRIP_OK nonce=$_ok_n
EOF
    scan_serial "$_t/ok.log" "$_ok_n" "$_ok_t" || { echo "  selftest F1 FAILED (honest transcript rejected)"; _rc=1; }

    # F2 must-FAIL — the stale-artifact fixture. The server is NOT running:
    # no mount rung, no write. But the path EXISTS and the transcript carries a
    # STALE nonce from a previous run.
    cat > "$_t/stale.log" <<EOF
[grub-uefi] multiboot loading /boot/kernel.elf ...
[dbfsrt] probe begin nonce=$_stale_n
[dbfsrt] nvme adapter ok=true
[dbfsrt] dbfs superblock found=true gen=1
[dbfsrt] volume token=dbfsrt-token:$_stale_t
[dbfsrt] server read-back=dbfsrt-nonce:$_stale_n
[dbfsrt] ROUNDTRIP_OK nonce=$_stale_n
EOF
    if scan_serial "$_t/stale.log" "$_ok_n" "$_ok_t"; then
        echo "  selftest F2 FAILED (stale artifact accepted)"; _rc=1
    fi

    # F3 must-FAIL — BANNER-ONLY. Firmware booted, the probe entered at the
    # RIGHT nonce, the server even came up, but no data ever moved. A guest
    # that boots and prints nothing useful must not pass.
    cat > "$_t/banner.log" <<EOF
[grub-uefi] multiboot loading /boot/kernel.elf ...
[dbfsrt] probe begin nonce=$_ok_n
[dbfsrt] nvme adapter ok=true
[dbfsrt] dbfs superblock found=true gen=3
[dbfsrt] dbfs-server up ready=true
[dbfsrt] volume token=dbfsrt-token:$_ok_t
EOF
    if scan_serial "$_t/banner.log" "$_ok_n" "$_ok_t"; then
        echo "  selftest F3 FAILED (banner-only transcript accepted)"; _rc=1
    fi

    # F4 must-FAIL — THE WIPED-VOLUME fixture, unique to this lane. The
    # round-trip is FLAWLESS at the current nonce: mounted, wrote, read back,
    # ROUNDTRIP_OK. The only thing wrong is that the staged token is absent,
    # because the guest re-formatted the volume before writing. A gate anchored
    # on the nonce alone passes this; this one must not.
    cat > "$_t/wiped.log" <<EOF
[grub-uefi] multiboot loading /boot/kernel.elf ...
[dbfsrt] probe begin nonce=$_ok_n
[dbfsrt] nvme adapter ok=true
[dbfsrt] dbfs superblock found=true gen=0
[dbfsrt] dbfs-server up ready=true
[dbfsrt] volume token read FAILED: not-found
[dbfsrt] server write path=/DBFSRT.TXT ok=true
[dbfsrt] server read-back=dbfsrt-nonce:$_ok_n
[dbfsrt] ROUNDTRIP_OK nonce=$_ok_n
EOF
    if scan_serial "$_t/wiped.log" "$_ok_n" "$_ok_t"; then
        echo "  selftest F4 FAILED (wiped-volume round-trip accepted)"; _rc=1
    fi

    # F5 must-FAIL: right nonce and right token, but the volume the guest read
    # is a DIFFERENT run's volume (stale token). Guards the token needle
    # independently of the nonce needle.
    sed "s/dbfsrt-token:$_ok_t/dbfsrt-token:$_stale_t/" "$_t/ok.log" > "$_t/wrongtok.log"
    if scan_serial "$_t/wrongtok.log" "$_ok_n" "$_ok_t"; then
        echo "  selftest F5 FAILED (stale volume token accepted)"; _rc=1
    fi

    # F6 must-FAIL: an empty transcript.
    : > "$_t/empty.log"
    if scan_serial "$_t/empty.log" "$_ok_n" "$_ok_t"; then
        echo "  selftest F6 FAILED (empty transcript accepted)"; _rc=1
    fi

    # F7 image check must-PASS: nonce bytes physically present.
    printf 'junk\0\0dbfsrt-nonce:%s\0\0junk' "$_ok_n" > "$_t/ok.img"
    scan_image "$_t/ok.img" "$_ok_n" || { echo "  selftest F7 FAILED (nonce in image not found)"; _rc=1; }

    # F8 image check must-FAIL: an image carrying only the STALE nonce.
    printf 'junk\0\0dbfsrt-nonce:%s\0\0junk' "$_stale_n" > "$_t/stale.img"
    if scan_image "$_t/stale.img" "$_ok_n"; then
        echo "  selftest F8 FAILED (stale image accepted)"; _rc=1
    fi

    # F9 image check must-FAIL: a missing image is not a pass.
    if scan_image "$_t/nope.img" "$_ok_n"; then
        echo "  selftest F9 FAILED (missing image accepted)"; _rc=1
    fi

    # F10 token image check: must-PASS on a seeded volume, must-FAIL on one
    # that carries no token (the pre-boot half of the wiped-volume fixture).
    printf 'junk\0\0dbfsrt-token:%s\0\0junk' "$_ok_t" > "$_t/tok.img"
    scan_image_token "$_t/tok.img" "$_ok_t" || { echo "  selftest F10a FAILED (seeded token not found)"; _rc=1; }
    printf 'junk\0\0nothing here\0\0junk' > "$_t/notok.img"
    if scan_image_token "$_t/notok.img" "$_ok_t"; then
        echo "  selftest F10b FAILED (unseeded volume accepted as tokened)"; _rc=1
    fi

    # F11 argv guard must-FAIL on each forbidden flag, in a subshell so the
    # guard's own exit does not kill the selftest.
    for _bad in "-kernel" "-device isa-debug-exit,iobase=0xf4"; do
        # shellcheck disable=SC2086
        if ( assert_real_firmware_argv qemu-system-x86_64 -m 2G $_bad >/dev/null 2>&1 ); then
            echo "  selftest F11 FAILED (argv guard missed: $_bad)"; _rc=1
        fi
    done

    # F12 argv guard must-PASS on the real, compliant argv.
    if ! ( assert_real_firmware_argv qemu-system-x86_64 -machine q35 \
            -drive "if=pflash,format=raw,file=OVMF_CODE.fd" >/dev/null 2>&1 ); then
        echo "  selftest F12 FAILED (argv guard rejected a compliant argv)"; _rc=1
    fi

    rm -rf "$_t"
    [ "$_rc" -eq 0 ] || { echo "ERROR — nothing was checked: selftest failed"; exit 2; }
    echo "[dbfsrt] selftest: 13 fixture(s) OK"
}

selftest
[ "${1:-}" = "--selftest" ] && { echo "PASS — 13 check(s) checked, selftest fixtures only (no VM was booted)"; exit 0; }

# ---------------------------------------------------------------------------
# Preconditions — every one of these is ERROR, never a pass.
# ---------------------------------------------------------------------------
command -v qemu-system-x86_64 >/dev/null 2>&1 || nothing "qemu-system-x86_64 missing"
command -v grub-mkstandalone  >/dev/null 2>&1 || nothing "grub-mkstandalone missing"
[ -f "$OVMF_CODE" ]     || nothing "OVMF_CODE missing at $OVMF_CODE"
[ -f "$OVMF_VARS_SRC" ] || nothing "OVMF_VARS missing at $OVMF_VARS_SRC"
[ -f "$SEED" ]          || nothing "seed missing at $SEED (build it: cargo build --release --bin simple)"
# A gate that writes logs under a directory must mkdir -p it first.
mkdir -p "$OUT" build/os/generated

# ---- 1. Mint THIS run's nonce and volume token -----------------------------
NONCE="${DBFSRT_NONCE:-$(date -u +%Y%m%d%H%M%S)$$}"
TOKEN="${DBFSRT_TOKEN:-t$(date -u +%H%M%S)$$}"
printf 'pub fn dbfs_roundtrip_nonce() -> text:\n    "%s"\n' "$NONCE" > "$NONCE_SPL"
echo "[dbfsrt] nonce=$NONCE token=$TOKEN -> $NONCE_SPL"

# ---- 2. Per-run DBFS NVMe volume (raw, no partition table) -----------------
# Rebuilt EVERY run: a previous run's file must never satisfy this one. The
# volume is a real DBFS volume — LBA 2 superblock, LBA 4+ arena — produced by
# the same build_dbfs_rootfs_image the production mkfs.dbfs uses, so the
# unmodified in-guest production probe can mount it. Nothing about the
# production contract is relaxed to make this gate pass; the VOLUME is built to
# satisfy it.
rm -f "$IMG"
# Parameters reach the builder through a GENERATED MODULE, not argv. Measured
# 2026-09-01: a `main(args: [text])` entry never receives argv from
# `simple run <file> -- <args>` on the freshly built seed — it dies with
# `error: semantic: function expects argument for parameter 'args', but none
# was provided`. The unmodified src/os/port/mkfs_dbfs.spl fails byte-identically
# at the invocation scripts/os/mkfs-dbfs.shs:11 itself uses, so this is a
# pre-existing repo-wide blocker, not something this lane introduced. Routing
# per-run values through build/os/generated is the same mechanism already used
# for the nonce, so nothing here is hardcoded.
printf 'pub fn dbfsrt_stage_output() -> text:\n    "%s"\n\npub fn dbfsrt_stage_token() -> text:\n    "%s"\n\npub fn dbfsrt_stage_sectors() -> u64:\n    %su64\n' \
    "$IMG" "$TOKEN" "${DBFSRT_VOLUME_SECTORS:-65536}" > "$PARAMS_SPL"

# Exit status is captured DIRECTLY into a variable, never through a pipe — a
# pipeline's $? is the last stage's status and has produced false greens here.
# `|| MKFS_RC=$?` is required because `set -e` would otherwise abort before any
# assignment could run, losing the diagnostic.
MKFS_RC=0
"$SEED" run src/os/port/mkfs_dbfsrt.spl > "$OUT/mkfs.log" 2>&1 || MKFS_RC=$?
[ "$MKFS_RC" -eq 0 ] || nothing "mkfs.dbfsrt failed (rc=$MKFS_RC): $(grep -v 'gc-warning' "$OUT/mkfs.log" 2>/dev/null | tail -3)"
# rc 0 is not sufficient: process.exit is unavailable in this builder (it fails
# codegen), so a build error is reported on stdout and still exits 0. The
# success line is the authority, and a FAILED line is fatal.
grep -qF 'mkfs.dbfsrt: FAILED' "$OUT/mkfs.log" && nothing "mkfs.dbfsrt reported failure: $(grep -F 'mkfs.dbfsrt: FAILED' "$OUT/mkfs.log" | tail -1)"
grep -qF "mkfs.dbfsrt: wrote $IMG" "$OUT/mkfs.log" || nothing "mkfs.dbfsrt did not report writing $IMG (see $OUT/mkfs.log)"
[ -f "$IMG" ] || nothing "mkfs.dbfsrt produced no $IMG"

# Three pre-boot assertions. The first two are what make every nonce byte found
# later a byte THIS guest wrote; the third proves the token rung is testable at
# all, so a later missing L6 means the guest could not read it.
scan_image "$IMG" "$NONCE" && nothing "fresh volume already contains the nonce (impossible; refusing)"
grep -qa 'DBFSRT.TXT' "$IMG" && nothing "fresh volume already carries a /DBFSRT.TXT entry (refusing)"
scan_image_token "$IMG" "$TOKEN" || nothing "fresh volume does not carry this run's token (mkfs.dbfsrt did not seed it)"
echo "[dbfsrt] volume=$IMG ($(stat -c%s "$IMG") bytes), token seeded, nonce absent, /DBFSRT.TXT absent"

# ---- 3. Kernel (RUST SEED; --timeout 1200 deliberate) ----------------------
if [ "${SKIP_KERNEL:-0}" != "1" ] || [ ! -f "$KERNEL" ]; then
    OBJCOPY_PREFIX=""
    for d in /usr/lib/llvm-23/bin /usr/lib/llvm-20/bin /usr/lib/llvm-19/bin /usr/lib/llvm-18/bin; do
        [ -f "$d/llvm-objcopy" ] && OBJCOPY_PREFIX="$d" && break
    done
    rm -rf "$CACHE"; mkdir -p "$CACHE"; rm -f "$KERNEL"
    echo "[dbfsrt] building kernel -> $KERNEL (rust seed: $SEED)"
    # SIMPLE_ALLOW_STUB_FALLBACK is deliberately NOT set: a round-trip "proved"
    # by a silently-stubbed binary is the fabricated evidence this lane rules
    # out. SIMPLE_ALLOW_UNRESOLVED_RUNTIME is likewise never set.
    SIMPLE_BOOTSTRAP=1 SIMPLE_LIB="$ROOT/src" SIMPLE_OS_LOG_MODE=off SIMPLE_ALLOW_FREESTANDING_STUBS=1 \
    PATH="${OBJCOPY_PREFIX:+$OBJCOPY_PREFIX:}$PATH" \
        "$SEED" native-build --source build/os/generated --source src/os --source src/lib \
        --source examples/09_embedded/simple_os --backend cranelift --cpu x86-64-v1 \
        --opt-level=aggressive --log off --entry-closure --cache-dir "$CACHE" \
        --timeout 1200 \
        --entry "$ENTRY" --target x86_64-unknown-none -o "$KERNEL" \
        --linker-script "$LINKER" > "$OUT/kernel-build.log" 2>&1 || true
    if [ ! -f "$KERNEL" ]; then
        # Surface the actual first error, not just "no kernel" — a bare
        # "build produced nothing" identifies no layer.
        FIRSTERR=$(grep -m1 "symbol not found\|Build failed\|failed to compile" "$OUT/kernel-build.log" 2>/dev/null || true)
        nothing "kernel build produced no $KERNEL: ${FIRSTERR:-see $OUT/kernel-build.log}"
    fi
fi
echo "[dbfsrt] kernel=$KERNEL ($(stat -c%s "$KERNEL") bytes)"

# ---- 4. ESP: self-contained BOOTX64.EFI with the kernel in its memdisk -----
rm -rf "$BUILD"; mkdir -p "$ESP/EFI/BOOT"
cp "$OVMF_VARS_SRC" "$OVMF_VARS"
cat > "$BUILD/grub.cfg" <<'CFG'
set timeout=0
set default=0
insmod multiboot
insmod normal
menuentry "SimpleOS DBFS server round-trip probe (UEFI/multiboot)" {
    echo "[grub-uefi] multiboot loading /boot/kernel.elf ..."
    multiboot /boot/kernel.elf
    boot
}
CFG
grub-mkstandalone --format=x86_64-efi --output="$EFIAPP" \
    --modules="multiboot normal echo part_gpt fat" \
    "boot/grub/grub.cfg=$BUILD/grub.cfg" "boot/kernel.elf=$KERNEL" \
    >/dev/null 2>&1 || nothing "grub-mkstandalone failed"
[ -f "$EFIAPP" ] || nothing "grub-mkstandalone produced no $EFIAPP"

# ---- 5. Assemble the argv FIRST, self-check it, then boot -----------------
rm -f "$SERIAL"
set -- qemu-system-x86_64 -no-user-config -monitor none -nographic -no-reboot \
    -machine q35 -cpu qemu64 -m "$QEMU_MEM" \
    -drive "if=pflash,format=raw,readonly=on,file=$OVMF_CODE" \
    -drive "if=pflash,format=raw,file=$OVMF_VARS" \
    -drive "file=fat:rw:$ESP,format=raw,id=esp,if=none" \
    -device virtio-blk-pci,drive=esp,bootindex=0 \
    -serial "file:$SERIAL" \
    -drive "file=$IMG,if=none,id=nvm,format=raw" \
    -device nvme,serial=deadbeef,drive=nvm
assert_real_firmware_argv "$@"

"$@" >/dev/null 2>&1 &
QEMU_PID=$!
trap 'kill "$QEMU_PID" 2>/dev/null || true' EXIT

i=0
while [ "$i" -lt "$BOOT_WAIT" ]; do
    if [ -f "$SERIAL" ] && { grep -qF '[dbfsrt] probe complete' "$SERIAL" 2>/dev/null \
                          || grep -qF '[dbfsrt] PROBE FAILED'  "$SERIAL" 2>/dev/null; }; then
        break
    fi
    sleep 1
    i=$((i + 1))
done
sleep 2
kill "$QEMU_PID" 2>/dev/null || true
wait "$QEMU_PID" 2>/dev/null || true

[ -f "$SERIAL" ] || nothing "no serial transcript was produced"

# ---- 6. Verdict ------------------------------------------------------------
echo "[dbfsrt] serial transcript: $SERIAL"
if grep -qF '[dbfsrt] group-commit ok=true' "$SERIAL" 2>/dev/null; then
    echo "  [ADVISORY] A1  post-round-trip group-commit reported ok (never gated; see header)"
else
    echo "  [ADVISORY] A1  post-round-trip group-commit NOT reported ok (never gated; explains a RED L10)"
fi

CHECKED=0
MISSING=""

scan_serial "$SERIAL" "$NONCE" "$TOKEN" || MISSING="$MISSING$SCAN_MISSING"
CHECKED=$((CHECKED + 9))

if scan_image "$IMG" "$NONCE"; then
    echo "  [OK]   L10 nonce bytes found in the raw NVMe image (host-side filesystem check)"
else
    MISSING="$MISSING L10"
fi
CHECKED=$((CHECKED + 1))

[ "$CHECKED" -gt 0 ] || nothing "0 checks executed"

if [ -n "$MISSING" ]; then
    fail "$CHECKED check(s) checked, missing:$MISSING (nonce=$NONCE, token=$TOKEN, transcript: $SERIAL, image: $IMG)"
fi

echo "PASS — $CHECKED check(s) checked, the SimpleOS DBFS filesystem service (dbfs_filesystem_ops.spl's Filesystem-trait adapter over DbFsDriver, mounted through the shared VfsManager surface on a real NVMe device) served a write and a read-back of this run's nonce $NONCE in-guest under OVMF real firmware on the volume this run staged (token $TOKEN read back before the write), and the nonce bytes are physically present in the DBFS image (kernel built by the RUST SEED $SEED, not the self-hosted compiler; transcript: $SERIAL)"
