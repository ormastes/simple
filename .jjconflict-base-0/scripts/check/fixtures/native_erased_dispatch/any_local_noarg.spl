# Erased receiver, statically recoverable: `val d: Any = Dog()`.
# struct_value_syms should carry "Dog" through the Let alias, so the
# native Unresolved arm can key on the RECEIVER TYPE (never on name
# unanimity). Expected stdout: A=7
class Dog:
    fn speak(self) -> i64:
        return 7

fn main() -> i64:
    val d: Any = Dog()
    print "A={d.speak()}"
    return 0
