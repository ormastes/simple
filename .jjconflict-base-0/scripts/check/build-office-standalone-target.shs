#!/bin/sh
set -eu

# Build the Office product with an already admitted Phase 3 compiler.
# This is deliberately a target-only operation: it never invokes bootstrap.

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)"
STANDALONE_TARGET_ROOT=$ROOT_DIR
export STANDALONE_TARGET_ROOT
BOOTSTRAP_STAGE3_FACADE_PATH="$ROOT_DIR/scripts/check/lib/bootstrap-stage3-provenance.shs"
export BOOTSTRAP_STAGE3_FACADE_PATH
. "$BOOTSTRAP_STAGE3_FACADE_PATH"
. "$ROOT_DIR/scripts/check/lib/standalone-target-phase3.shs"

usage() {
    cat <<'EOF'
Usage: sh scripts/check/build-office-standalone-target.shs [--self-test]

Required environment:
  SIMPLE_TARGET_PHASE3  Absolute, admitted build/.../stage3/<triple>/simple.

Optional environment:
  OFFICE_TARGET_OUTPUT  Product binary (default build/standalone/office/<host>/simple-office)
  OFFICE_TARGET_CACHE   Stable product cache (default build/standalone/cache/office/<host>)

This target-only command never invokes bootstrap and rejects seed, stale, or
unreceipted compiler inputs.  It is not a deploy, test-runner, or release gate.
EOF
}

if [ "${1:-}" = "--self-test" ]; then
    grep -Fq 'never invokes bootstrap' "$0"
    grep -Fq 'bootstrap_stage3_verify_manifest' \
        "$ROOT_DIR/scripts/check/lib/standalone-target-phase3.shs"
    grep -Fq 'SIMPLE_NO_STUB_FALLBACK=1' "$0"
    grep -Fq 'SIMPLE_STRICT_FABRICATED_STUB_RATCHET=1' "$0"
    printf '%s\n' 'build-office-standalone-target: PASS (target-only contract)'
    exit 0
fi
case "${1:-}" in
    '' ) ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
esac

: "${SIMPLE_TARGET_PHASE3:?set SIMPLE_TARGET_PHASE3 to an admitted Phase 3 compiler}"
standalone_target_resolve_phase3 "$SIMPLE_TARGET_PHASE3"
host_platform=$(bootstrap_stage3_host_platform)
output=${OFFICE_TARGET_OUTPUT:-"$ROOT_DIR/build/standalone/office/$host_platform/simple-office"}
cache=${OFFICE_TARGET_CACHE:-"$ROOT_DIR/build/standalone/cache/office/$host_platform"}
case "$output:$cache" in
    /*:/*) ;;
    *) standalone_target_fail "target-output-or-cache-not-absolute"; exit 1 ;;
esac
standalone_target_require_nonbootstrap_path "$output"
standalone_target_require_nonbootstrap_path "$cache"
mkdir -p "$(dirname -- "$output")" "$cache"

env -u SIMPLE_BOOTSTRAP -u SIMPLE_BINARY -u SIMPLE_BIN \
    SIMPLE_LIB="$ROOT_DIR/src" SIMPLE_NO_STUB_FALLBACK=1 \
    SIMPLE_STRICT_FABRICATED_STUB_RATCHET=1 SIMPLE_NATIVE_INCREMENTAL=1 \
    "$STANDALONE_TARGET_COMPILER" native-build \
    --source "$ROOT_DIR/src/lib" --source "$ROOT_DIR/src/app/office" \
    --entry-closure --entry "$ROOT_DIR/src/app/office/mod.spl" \
    --cache-dir "$cache" --output "$output"

printf 'office_target_status=pass\n'
printf 'office_target_compiler=%s\n' "$STANDALONE_TARGET_COMPILER"
printf 'office_target_compiler_sha256=%s\n' "$STANDALONE_TARGET_COMPILER_SHA256"
printf 'office_target_output=%s\n' "$output"
printf 'office_target_cache=%s\n' "$cache"
