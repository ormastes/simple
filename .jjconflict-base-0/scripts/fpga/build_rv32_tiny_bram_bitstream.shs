#!/usr/bin/env bash
# build_rv32_tiny_bram_bitstream.shs — ONE reproducible Vivado build of the
# BRAM-only TINY rv32 SimpleOS bitstream for the Kria KV260 (xck26).
#
# Path A of the silicon campaign: NO DDR, NO block design, NO FSBL. The kernel
# image and the FAT32 ramdisk slice are baked into BRAM INIT at synthesis time;
# the core boots the full marker chain to TEST PASSED the moment the bitstream
# configures. Observation is the BSCANE2 USER4 obs register file
# (read_rv32_tiny_bram_obs.shs), because the PL UART pin (H12/PMOD J2) is not
# routed to any host tty on the KV260 carrier.
#
# MANDATORY before this: the GHDL rehearsal must PASS with the SAME sizes:
#   RAM_WORDS=<n> RDISK_WORDS=<n> sh scripts/fpga/ghdl_rv32_tiny_bram_soc.shs
#
# Env knobs:
#   KERNEL_ELF  (default build/os/simpleos_riscv32_smf_fs_tiny64.elf)
#   FAT32_IMG   (default build/os/fat32-riscv32.img)
#   RAM_WORDS   (default 65536 = 256 KB)   RDISK_WORDS (default 81920 = 320 KB)
#     -> BRAM36 budget on xck26 is 144: RAM 256K = 64, rdisk 320K = 80,
#        uartbuf 8K = 2 -> 146 would NOT fit, so the uartbuf is moved to
#        distributed RAM when BRAM is exhausted; check util_synth.rpt.
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

VIVADO_SETTINGS="${VIVADO_SETTINGS:-$HOME/Xilinx/2025.2/Vivado/settings64.sh}"
BUILD_DIR="build/fpga/k26_rv32_tiny_bram"
OUT_BIT="build/fpga/k26_rv32_tiny_bram/gateware/rv32_tiny_bram.bit"
KERNEL_ELF="${KERNEL_ELF:-build/os/simpleos_riscv32_smf_fs_tiny64.elf}"
FAT32_IMG="${FAT32_IMG:-build/os/fat32-riscv32.img}"
# 51200 words = 200 KB = exactly the tiny64 image footprint (0x80031000),
# split into 32768+16384+2048 power-of-2 BRAM banks (50 BRAM36).
RAM_WORDS="${RAM_WORDS:-51200}"
# 77824 words = 304 KB FAT32 slice, split 65536+8192+4096 (76 BRAM36).
RDISK_WORDS="${RDISK_WORDS:-77824}"
RAM_BYTES=$((RAM_WORDS * 4))
RAMDISK_BYTES=$((RDISK_WORDS * 4))
SYNTH_ONLY="0"
[ "${1:-}" = "--synth-only" ] && SYNTH_ONLY="1"

[ -f "$VIVADO_SETTINGS" ] || { echo "FAIL: vivado settings missing $VIVADO_SETTINGS"; exit 1; }
[ -f "$KERNEL_ELF" ] || { echo "FAIL: kernel ELF missing: $KERNEL_ELF"; exit 1; }
[ -f "$FAT32_IMG" ] || { echo "FAIL: FAT32 image missing: $FAT32_IMG"; exit 1; }
if pgrep -f 'lnx64.o/vivado' >/dev/null 2>&1; then
    echo "FAIL: a Vivado is already running (serialize: exactly one at a time)"; exit 1
fi
# shellcheck disable=SC1090
. "$VIVADO_SETTINGS"

mkdir -p "$BUILD_DIR"

# Static budget gate.
if command -v llvm-nm >/dev/null 2>&1; then
  kend_hex="$(llvm-nm "$KERNEL_ELF" | awk '$3=="_kernel_end"{print $1}')"
  if [ -n "$kend_hex" ]; then
    used=$(( $(printf '%d' "0x$kend_hex") - $(printf '%d' 0x80000000) ))
    echo "Image footprint: $used bytes vs $RAM_BYTES bytes of BRAM RAM"
    [ "$used" -le "$RAM_BYTES" ] || { echo "FAIL: image does not fit RAM_WORDS budget"; exit 1; }
  fi
fi

echo "=== flattening kernel + ramdisk to BRAM INIT .mem ==="
riscv64-unknown-elf-objcopy -O binary "$KERNEL_ELF" "$BUILD_DIR/kernel.bin"
od -An -v -tx4 -w4 "$BUILD_DIR/kernel.bin" | awk 'NF{print $1}' > "$BUILD_DIR/rv32_flat.mem"
head -c "$RAMDISK_BYTES" "$FAT32_IMG" > "$BUILD_DIR/rv32_ramdisk.img"
od -An -v -tx4 -w4 "$BUILD_DIR/rv32_ramdisk.img" | awk 'NF{print $1}' > "$BUILD_DIR/rv32_ramdisk.mem"
echo "  kernel words:  $(wc -l < "$BUILD_DIR/rv32_flat.mem")"
echo "  ramdisk words: $(wc -l < "$BUILD_DIR/rv32_ramdisk.mem")"
RAM_MEM="$ROOT_DIR/$BUILD_DIR/rv32_flat.mem"
RDISK_MEM="$ROOT_DIR/$BUILD_DIR/rv32_ramdisk.mem"

cat > "$BUILD_DIR/k26_tiny_bram.xdc" <<'XDC'
set_property PACKAGE_PIN H12 [get_ports uart_tx]
set_property IOSTANDARD LVCMOS33 [get_ports uart_tx]
create_clock -name cfgmclk -period 20.000 [get_pins u_startup/CFGMCLK]
set_false_path -to [get_ports uart_tx]
XDC

# Synth pre-hook: the BRAM INIT impure functions iterate once per .mem line
# (65536 for RAM, 77824 for the ramdisk), which exceeds Vivado's default
# elaboration loop limit of 65536 -> ERROR [Synth 8-403]. Raise it in the
# synth run's own process (TCL.PRE runs there).
cat > "$BUILD_DIR/synth_pre.tcl" <<'PRE'
set_param synth.elaboration.rodinMoreOptions {rt::set_parameter max_loop_limit 8000000}
PRE

RTL="examples/09_embedded/fpga_riscv/rtl"
cat > "$BUILD_DIR/build_rv32_tiny_bram.tcl" <<TCL
set synth_only $SYNTH_ONLY
create_project k26_rv32_tiny_bram $BUILD_DIR/k26_rv32_tiny_bram -part xck26-sfvc784-2lv-c -force
add_files [list \\
  $RTL/rv32_exec_core_axi.vhd \\
  $RTL/rv32_bram_soc.vhd \\
  $RTL/soc_top_rv32_tiny_bram.vhd ]
set_property FILE_TYPE {VHDL 2008} [get_files *.vhd]
add_files -fileset constrs_1 $BUILD_DIR/k26_tiny_bram.xdc
set_property top soc_top_rv32_tiny_bram [current_fileset]
set_property generic "G_RAM_WORDS=$RAM_WORDS G_RDISK_WORDS=$RDISK_WORDS G_RAM_INIT_FILE=$RAM_MEM G_RDISK_INIT_FILE=$RDISK_MEM" [current_fileset]
update_compile_order -fileset sources_1
set_property STEPS.SYNTH_DESIGN.TCL.PRE [file normalize $BUILD_DIR/synth_pre.tcl] [get_runs synth_1]
launch_runs synth_1 -jobs 8
wait_on_run synth_1
if {[get_property PROGRESS [get_runs synth_1]] != "100%"} { puts "SYNTH_FAILED"; exit 5 }
open_run synth_1
report_utilization -file $BUILD_DIR/util_synth.rpt
report_timing_summary -file $BUILD_DIR/timing_synth.rpt
puts "SYNTH_WNS=[get_property STATS.WNS [get_runs synth_1]]"
if {\$synth_only} { puts "SYNTH_ONLY_DONE"; exit 0 }
launch_runs impl_1 -to_step write_bitstream -jobs 8
wait_on_run impl_1
if {[get_property PROGRESS [get_runs impl_1]] != "100%"} { puts "IMPL_FAILED"; exit 6 }
open_run impl_1
report_timing_summary -file $BUILD_DIR/timing_routed.rpt
report_utilization -file $BUILD_DIR/util_routed.rpt
set wns [get_property STATS.WNS [get_runs impl_1]]
set whs [get_property STATS.WHS [get_runs impl_1]]
puts "IMPL_WNS=\$wns IMPL_WHS=\$whs"
if {\$wns < 0.0 || \$whs < 0.0} { puts "TIMING_NOT_MET"; exit 3 }
file mkdir [file dirname $OUT_BIT]
file copy -force $BUILD_DIR/k26_rv32_tiny_bram/k26_rv32_tiny_bram.runs/impl_1/soc_top_rv32_tiny_bram.bit $OUT_BIT
puts "BITSTREAM_WRITTEN=$OUT_BIT"
TCL

echo "=== running ONE Vivado build (BRAM-only tiny SoC, RAM_WORDS=$RAM_WORDS RDISK_WORDS=$RDISK_WORDS) ==="
vivado -mode batch -source "$BUILD_DIR/build_rv32_tiny_bram.tcl" \
    -journal "$BUILD_DIR/vivado.jou" -log "$BUILD_DIR/vivado.log" 2>&1 | tail -40

if [ "$SYNTH_ONLY" = "1" ]; then
    grep -E 'SYNTH_WNS|SYNTH_ONLY_DONE' "$BUILD_DIR/vivado.log" || true
    exit 0
fi
[ -f "$OUT_BIT" ] && echo "SUCCESS: bitstream at $OUT_BIT" || { echo "FAIL: no bitstream; see $BUILD_DIR/vivado.log"; exit 4; }
