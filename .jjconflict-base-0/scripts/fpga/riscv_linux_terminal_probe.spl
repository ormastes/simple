# Bidirectional RISC-V Linux terminal probe through telnet_serial_bridge.
#
# Usage: bin/simple run scripts/fpga/riscv_linux_terminal_probe.spl HOST PORT TIMEOUT_MS
# Evidence is emitted only in this order after it is observed/sent:
# login:, UART_TX_INPUT=root, simple-riscv# , UART_TX_INPUT=ls /,
# SIMPLE_RISCV_LINUX_LOGIN_LS_PASS.

use std.nogc_sync_mut.io.telnet_serial_bridge.{bridge_filter_client_bytes}
use std.nogc_sync_mut.sffi.cli.{cli_exit, cli_get_args}

extern fn native_tcp_connect(addr: text) -> (i64, text, i64)
extern fn native_tcp_read(handle: i64, max: i64) -> Result<[i64], text>
extern fn native_tcp_write(handle: i64, data: [i64]) -> Result<i64, text>
extern fn native_tcp_set_read_timeout(handle: i64, ms: i64) -> Result<i64, text>
extern fn native_tcp_close(handle: i64) -> i64
extern fn rt_bytes_to_text(data: [i64]) -> text
extern fn rt_text_to_bytes(value: text) -> [i64]
extern fn rt_sleep_ms(ms: i64)
extern fn rt_time_now_unix_micros() -> i64

fn script_user_args(marker: text) -> [text]:
    val raw = cli_get_args()
    var out: [text] = []
    var seen_script = false
    for arg in raw:
        if seen_script:
            out.push(arg)
        elif arg.contains(marker):
            seen_script = true
    if not seen_script:
        var i = 1
        while i < raw.len():
            out.push(raw[i])
            i = i + 1
    out

fn send_terminal_input(stream: i64, command: text) -> bool:
    match native_tcp_write(stream, rt_text_to_bytes(command)):
        Ok(written): written == command.len()
        Err(err): false

fn terminal_ls_complete(response: text) -> bool:
    val fixture = response.find("SIMPLE_RISCV_LINUX_LOGIN_LS_PASS")
    val prompt = response.find("simple-riscv# ")
    fixture >= 0 and prompt > fixture

fn emit_received(chunk: text):
    val timestamp_us = rt_time_now_unix_micros()
    print("UART_RX_BEGIN timestamp_us={timestamp_us}")
    print(chunk)
    print("UART_RX_END timestamp_us={timestamp_us}")

fn fail(stream: i64, reason: text):
    if stream >= 0:
        native_tcp_close(stream)
    print("SIMPLE_RISCV_LINUX_LOGIN_LS_FAIL reason={reason}")
    cli_exit(1)

# NOTE: no module-level main() call; the interpreter invokes it once.
fn main():
    val args = script_user_args("riscv_linux_terminal_probe.spl")
    if args.len() == 1 and args[0] == "--self-test":
        if (terminal_ls_complete("SIMPLE_RISCV_LINUX_LOGIN_LS_PASS\nsimple-riscv# ") and
            not terminal_ls_complete("simple-riscv# ")):
            print("RISCV_LINUX_TERMINAL_PROBE_SELF_TEST: PASS")
            return
        cli_exit(1)
        return
    if args.len() < 3:
        print("usage: riscv_linux_terminal_probe.spl HOST PORT TIMEOUT_MS")
        cli_exit(1)
        return

    val addr = args[0] + ":" + args[1]
    val timeout_ms = args[2].to_int()
    val (stream, local_addr, connect_error) = native_tcp_connect(addr)
    if stream < 0:
        fail(stream, "connect_failed code={connect_error}")
        return
    match native_tcp_set_read_timeout(stream, 200):
        Err(error):
            fail(stream, "read_timeout_configuration_failed")
            return
        Ok(configured): print("UART_READ_TIMEOUT_MS=200")

    val started_us = rt_time_now_unix_micros()
    var received = ""
    var sent_root = false
    var sent_ls = false
    var root_response_start = 0
    var ls_response_start = 0
    while (rt_time_now_unix_micros() - started_us) / 1000 < timeout_ms:
        val read = native_tcp_read(stream, 4096)
        match read:
            Ok(packet):
                if packet[0] == 0:
                    fail(stream, "server_closed")
                    return
                val filtered = bridge_filter_client_bytes(packet[1])
                if filtered.clean.length() > 0:
                    val chunk = rt_bytes_to_text(filtered.clean)
                    emit_received(chunk)
                    received = received + chunk
                    if not sent_root and received.contains("login:"):
                        print("login:")
                        if not send_terminal_input(stream, "root\n"):
                            fail(stream, "root_write_failed")
                            return
                        sent_root = true
                        root_response_start = received.length()
                        print("UART_TX_INPUT=root")
                    if (sent_root and
                        not sent_ls and
                        received.substring(root_response_start).contains("simple-riscv# ")):
                        print("simple-riscv# ")
                        if not send_terminal_input(stream, "ls /\n"):
                            fail(stream, "ls_write_failed")
                            return
                        sent_ls = true
                        ls_response_start = received.length()
                        print("UART_TX_INPUT=ls /")
                    if (sent_ls and
                        terminal_ls_complete(received.substring(ls_response_start))):
                        native_tcp_close(stream)
                        print("RISCV_LINUX_TERMINAL_PROBE_STATUS=PASS")
                        return
            Err(err): rt_sleep_ms(50)
    fail(stream, "timeout")
