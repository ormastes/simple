#!/bin/sh
# Run host-issued admin/I/O commands through the real endpoint and resident RV32 firmware.
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
RTL_DIR="$ROOT_DIR/examples/09_embedded/fpga_riscv/rtl"
WORK_DIR="$ROOT_DIR/build/ghdl/rv32_nvme_fw_in_loop"
FW_ELF="${FW_ELF:-}"
SIMPLE_BINARY="${SIMPLE_BINARY:-$ROOT_DIR/bin/release/simple}"
NM="${NM:-riscv64-unknown-elf-nm}"
OBJCOPY="${OBJCOPY:-riscv64-unknown-elf-objcopy}"

cd "$ROOT_DIR"
command -v ghdl >/dev/null 2>&1 || { echo "ERROR: ghdl not found"; exit 1; }
command -v "$NM" >/dev/null 2>&1 || { echo "ERROR: $NM not found"; exit 1; }
command -v "$OBJCOPY" >/dev/null 2>&1 || { echo "ERROR: $OBJCOPY not found"; exit 1; }

if [ -z "$FW_ELF" ]; then
  [ -x "$SIMPLE_BINARY" ] || { echo "ERROR: pure-Simple runtime missing: $SIMPLE_BINARY"; exit 1; }
  NVME_RV32_SERVICE=1 NVME_RV32_SIMPLE_BIN="$SIMPLE_BINARY" \
    sh examples/09_embedded/simpleos_nvme_fw/fw_rv32/build.shs
  FW_ELF="$ROOT_DIR/build/nvme_fw_rv32_service.elf"
fi
[ -f "$FW_ELF" ] || { echo "ERROR: service firmware ELF missing: $FW_ELF"; exit 1; }

nand_start="$($NM -n "$FW_ELF" | awk '$3 == "_nandram_start" { print $1; exit }')"
nand_end="$($NM -n "$FW_ELF" | awk '$3 == "_nandram_end" { print $1; exit }')"
entry="$($NM -n "$FW_ELF" | awk '$3 == "_rv32_direct_entry" { print $1; exit }')"
[ -n "$nand_start" ] && [ -n "$nand_end" ] || { echo "ERROR: ELF lacks .nandram symbols"; exit 1; }
[ "$entry" = "80000000" ] || { echo "ERROR: service entry is not 0x80000000: $entry"; exit 1; }
nand_word="$(((0x$nand_start - 0x80000000) / 4))"
[ "$((0x$nand_end - 0x$nand_start))" -eq 256 ] || { echo "ERROR: .nandram is not 256 bytes"; exit 1; }

mkdir -p "$WORK_DIR"
sha256sum "$FW_ELF" >"$WORK_DIR/firmware.sha256"
"$OBJCOPY" -O binary "$FW_ELF" "$WORK_DIR/fw.bin"
od -An -v -tx4 -w4 "$WORK_DIR/fw.bin" | awk 'NF { print $1 }' >"$WORK_DIR/rv32_flat.mem"

echo "=== GHDL RV32 NVMe real firmware-in-loop ==="
echo "  firmware=$FW_ELF nandram_word=$nand_word"
out="$(ghdl -a --std=08 --workdir="$WORK_DIR" \
  "$RTL_DIR/rv32_exec_core_axi.vhd" \
  "$RTL_DIR/rv32_axi4_mem_adapter.vhd" \
  "$RTL_DIR/rv32_nvme_axi.vhd" \
  "$RTL_DIR/tb_rv32_nvme_fw_in_loop.vhd" 2>&1)" || { echo "$out" | tail -40; exit 1; }
(cd "$WORK_DIR" && ghdl -e --std=08 --workdir="$WORK_DIR" tb_rv32_nvme_fw_in_loop)
set +e
(cd "$WORK_DIR" && ghdl -r --std=08 --workdir="$WORK_DIR" tb_rv32_nvme_fw_in_loop \
  -gG_NANDRAM_WORD="$nand_word" --stop-time="${STOP_TIME:-55ms}" >sim.log 2>&1)
sim_rc=$?
set -e

grep -E "RV32_NVME_FW_IN_LOOP_(PASS|TIMEOUT)|assertion failure" "$WORK_DIR/sim.log" | tail -10 || true
[ "$sim_rc" -eq 0 ] || {
  echo "STATUS: FAIL rv32-nvme-fw-in-loop simulator-exit=$sim_rc (see $WORK_DIR/sim.log)"; exit 1;
}
grep -Fq "RV32_NVME_FW_IN_LOOP_PASS" "$WORK_DIR/sim.log" || {
  echo "STATUS: FAIL rv32-nvme-fw-in-loop (see $WORK_DIR/sim.log)"; exit 1;
}
! grep -Fq "assertion failure" "$WORK_DIR/sim.log" || {
  echo "STATUS: FAIL rv32-nvme-fw-in-loop assertion"; exit 1;
}
echo "STATUS: PASS rv32-nvme-fw-in-loop firmware=real transport=axi-ram"
