{
  "mcpServers": {
    "llm-caret-messaging": {
      "command": "caret",
      "args": ["messaging", "mcp"],
      "env": {
        "LLM_CARET_MESSAGING_DB": ".simple/state/llm-caret-messaging.db",
        "LLM_CARET_MESSAGING_IDENTITY": "local-agent",
        "LLM_CARET_MESSAGING_WORKSPACE": "default",
        "LLM_CARET_MESSAGING_SCOPES": "room:read,room:write,profile:read,dm:write,agent:control"
      }
    }
  }
}
