mcp:
  schema: simple.mcp.server/v1
  name: llm-caret-messaging
  command: caret
  args: [messaging, mcp]
  transport: stdio
  tools:
    - {name: chat_join, mutation: true, idempotency: binding_and_identity}
    - {name: chat_leave, mutation: true, idempotency: binding_and_identity}
    - {name: chat_send, mutation: true, idempotency: required_key}
    - {name: chat_read, mutation: false}
    - {name: chat_mark_read, mutation: true, evidence: local_cursor_or_native}
    - {name: chat_who, mutation: false}
    - {name: chat_open_private, mutation: true, privacy: canonical_direct_room}
    - {name: chat_notify_all, mutation: true, permission: notify_all}
    - {name: chat_assign, mutation: true, permission: agent_control}
    - {name: chat_task_update, mutation: true, permission: agent_control}
    - {name: chat_publish_artifact, mutation: true, permission: agent_control}
    - {name: chat_get_context, mutation: false, permission: room_read}
  guarantees:
    canonical_ids: true
    acl_before_context: true
    truthful_receipt_evidence: true
    private_room_isolation: true
    agent_update_no_implicit_trigger: true
